# Local development needs none of these after publishing var/public.sqlite.
# Production uses the read-only public projection and source-object origin.
TURSO_DATABASE_URL=libsql://database-name-account.turso.io
TURSO_AUTH_TOKEN=
R2_PUBLIC_BASE_URL=https://sources.example.org
# Set to 1 when this app owns the deployment root. Leave unset for local
# side-by-side development at /apps/concordance.
NEXT_PUBLIC_CONCORDANCE_STANDALONE=0
