ategory": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["Gout"], "contexts": ["inflammatory arthritis", "joint inflammation treated with Loadstone"]}, {"entity_id": "hip-gout", "book_id": "english_physician_1652", "name": "Hip-gout", "category": "DISEASE", "subcategory": "CHRONIC", "count": 5, "variants": ["Hip-gout", "Hip Gout", "Hip-Gout"], "contexts": ["a type of gout affecting the hip", "condition treated by the herb"]}, {"entity_id": "pains_of_the_gout", "book_id": "english_physician_1652", "name": "pains of the Gout", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["pains of the Gout"], "contexts": ["eased by Balm"]}, {"entity_id": "gout", "book_id": "principles_of_psychology_james_1890", "name": "gout", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["gout"], "contexts": ["metabolic disease causing joint inflammation"]}, {"entity_id": "gotta", "book_id": "coloquios_da_orta_1563", "name": "gotta", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["gotta"], "contexts": ["gout"]}, {"entity_id": "gout", "book_id": "polyanthea_medicinal", "name": "Gout", "category": "DISEASE", "subcategory": "CHRONIC", "count": 4, "variants": ["Gout", "gout", "goutta"], "contexts": ["joint inflammation", "disease affecting joints"]}, {"entity_id": "gouty", "book_id": "first_principles_spencer_1862", "name": "gouty", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["gouty"], "contexts": ["condition of suffering from gout"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Gout", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Gout", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Gout", "target_book": "principles_of_psychology_james_1890", "target_name": "gout", "similarity": 0.979}, {"source_book": "english_physician_1652", "source_name": "Gout", "target_book": "coloquios_da_orta_1563", "target_n