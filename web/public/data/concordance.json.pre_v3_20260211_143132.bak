confidence": "high", "type": "place", "description": "A country in Southwestern Europe.", "wikipedia_extract": "Portugal, officially the Portuguese Republic, is a country on the Iberian Peninsula in Southwestern Europe. It is a unitary republic made up by mainland Portugal and two autonomous regions, with Lisbon as both its capital and largest city. The mainland is bordered by Spain to the north and east, with Madeira and the Azores in the Atlantic Ocean. It features the westernmost point in continental Europe. The western Iberian Peninsula has been inhabited since prehistory, with the earliest signs of settlement dating to 5500 BC. Muslims invaded the Iberian Peninsula in the 8th century, but were gradually expelled during the Reconquista."}}, {"canonical_name": "Brésil", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 6, "total_mentions": 138, "members": [{"entity_id": "brésil", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Brésil", "category": "PLACE", "subcategory": "COUNTRY", "count": 104, "variants": ["Brésil", "BRÉSIL", "Brasilien", "Brésil équinoiial", "Brésiliens"], "contexts": ["country in South America", "South American country"]}, {"entity_id": "brazil", "book_id": "origin_of_species_darwin_1859", "name": "Brazil", "category": "PLACE", "subcategory": "COUNTRY", "count": 5, "variants": ["Brazil"], "contexts": ["caves with fossil bones and birds", "country with caves containing fossils"]}, {"entity_id": "brazil", "book_id": "kosmos_humboldt_1845", "name": "Brazil", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Brazil"], "contexts": ["South American country", "country with coast near magnetic equator"]}, {"entity_id": "brazils", "book_id": "kosmos_humboldt_1845", "name": "Brazils", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Brazils"], "contexts": ["country where aërolite fall occurred", "location where comet head was visible"]}, {"entity_id": "brasil", "book_id": "coloquio