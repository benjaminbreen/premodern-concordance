"id": 7, "stable_key": "clu_a99df22ea91362d2", "ground_truth": {"modern_name": "London", "confidence": "high", "type": "place", "description": "Capital city of England, often mentioned as a place of publication.", "wikipedia_extract": "London is the capital and largest city of both England and the United Kingdom, with a population of 9.1 million people in 2024. Its wider metropolitan area is the largest in Western Europe, with a population of 15.1 million. London stands on the River Thames in southeast England, at the head of a 50-mile (80 km) tidal estuary down to the North Sea, and has been a major settlement for nearly 2,000 years. Its ancient core and financial centre, the City of London, was founded by the Romans as Londinium and has retained its medieval boundaries. The City of Westminster, to the west of the City of London, for centuries has been as the site of the national government and parliament. London grew rapidly in the 19th century, becoming the world's largest city at the time."}}, {"canonical_name": "Fish", "category": "ANIMAL", "subcategory": "FISH", "book_count": 10, "total_mentions": 71, "members": [{"entity_id": "fish", "book_id": "origin_of_species_darwin_1859", "name": "Fish", "category": "ANIMAL", "subcategory": "FISH", "count": 15, "variants": ["fish", "Fish"], "contexts": ["aquatic prey of Mustela vison", "aquatic vertebrate with gills"]}, {"entity_id": "fishes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Fishes", "category": "ANIMAL", "subcategory": "FISH", "count": 3, "variants": ["Fishes"], "contexts": ["aquatic animals with fins", "category of aquatic animals"]}, {"entity_id": "fish", "book_id": "english_physician_1652", "name": "Fish", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 2, "variants": ["Fish"], "contexts": ["smells like old rotten fish", "food that is often fatty"]}, {"entity_id": "fishes", "book_id": "origin_of_species_darwin_1859", "name": "fishes", "category": "ANIMAL", "subcategory": "FISH", "coun