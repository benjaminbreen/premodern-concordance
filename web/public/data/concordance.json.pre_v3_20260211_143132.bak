e_name": "experiments", "target_book": "polyanthea_medicinal", "target_name": "experimentey", "similarity": 0.947}, {"source_book": "principles_of_psychology_james_1890", "source_name": "experimental methods", "target_book": "kosmos_humboldt_1845", "target_name": "experimental knowledge", "similarity": 0.839}, {"source_book": "principles_of_psychology_james_1890", "source_name": "experimental methods", "target_book": "kosmos_humboldt_1845", "target_name": "experimental sciences", "similarity": 0.871}, {"source_book": "principles_of_psychology_james_1890", "source_name": "experimental methods", "target_book": "polyanthea_medicinal", "target_name": "experimentey", "similarity": 0.852}, {"source_book": "principles_of_psychology_james_1890", "source_name": "experimenting", "target_book": "kosmos_humboldt_1845", "target_name": "experimental knowledge", "similarity": 0.826}, {"source_book": "principles_of_psychology_james_1890", "source_name": "experimenting", "target_book": "kosmos_humboldt_1845", "target_name": "experimental sciences", "similarity": 0.856}, {"source_book": "principles_of_psychology_james_1890", "source_name": "experimenting", "target_book": "coloquios_da_orta_1563", "target_name": "esperiencia", "similarity": 0.86}, {"source_book": "principles_of_psychology_james_1890", "source_name": "experimenting", "target_book": "polyanthea_medicinal", "target_name": "experimentey", "similarity": 0.962}, {"source_book": "kosmos_humboldt_1845", "source_name": "experimental knowledge", "target_book": "polyanthea_medicinal", "target_name": "experimentey", "similarity": 0.825}, {"source_book": "kosmos_humboldt_1845", "source_name": "experimental sciences", "target_book": "polyanthea_medicinal", "target_name": "experimentey", "similarity": 0.854}, {"source_book": "coloquios_da_orta_1563", "source_name": "esperiencia", "target_book": "polyanthea_medicinal", "target_name": "experimentey", "similarity": 0.867}], "id": 82, "stable_key": "clu_db66a6b5e395cd6e", "ground_truth": {"modern_name": "scientific experiment", "confidence": "high", "type": "concept", "note": "This cluster refers to the general concept and practice of conducting experiments for scientific inquiry.", "wikidata_id": "Q101965", "wikidata_description": "scientific procedure carried out to support, refute, or validate a hypothesis", "wikipedia_url": "https://en.wikipedia.org/wiki/Experiment", "wikipedia_extract": "An experiment is a procedure carried out to support or refute a hypothesis, or determine the efficacy or likelihood of something previously untried. Experiments provide insight into cause-and-effect by demonstrating what outcome occurs when a particular factor is manipulated. Experiments vary greatly in goal and scale but always rely on repeatable procedure and logical analysis of the results. There also exist  natural experimental studies. A child may carry out basic experiments to understand how things fall to the ground, while teams of scientists may take years of systematic investigation to advance their understanding of a phenomenon. Experiments and other types of hands-on activities are very important to student learning in the science classroom."}}, {"canonical_name": "Pologne", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 5, "total_mentions": 13, "members": [{"entity_id": "pologne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pologne", "category": "PLACE", "subcategory": "COUNTRY", "count": 6, "variants": ["Pologne"], "contexts": ["Included in empire area calculation", "included in European Russia"]}, {"entity_id": "royaume_de_pologne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "royaume de Pologne", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["royaume de Pologne"], "contexts": ["Included in Russian European area calculation"]}, {"entity_id": "poland", "book_id": "kosmos_humboldt_1845", "name": "Poland", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants"