iences_somerville_1858", "target_name": "crocodile", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "crocodiles", "target_book": "historia_medicinal_monardes_1574", "target_name": "Crocodilo", "similarity": 0.929}, {"source_book": "kosmos_humboldt_1845", "source_name": "crocodiles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "crocodile", "similarity": 0.988}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Crocodilo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "crocodile", "similarity": 0.935}], "id": 41, "stable_key": "clu_1637c67d669d341b", "ground_truth": {"modern_name": "Crocodile", "confidence": "high", "type": "animal", "description": "Large semi-aquatic reptiles, sometimes referred to as Cayman in specific contexts.", "wikipedia_extract": "A crocodile (family Crocodylidae) or true crocodile is a large, semiaquatic reptile that lives throughout the tropics in Africa, Asia, the Americas and Australia. The term \"crocodile\" is sometimes used more loosely to include all extant members of the order Crocodilia, which includes the alligators and caimans (both members of the family Alligatoridae), the gharial and false gharial (both members of the family Gavialidae) as well as other extinct taxa. This article will use \"crocodile\" or \"true crocodile\" to refer only to the species taxonomically included in the Crocodylidae family, extant or extinct. Crocodile size, morphology, behaviour and ecology differ among species. However, they have many similarities in these areas as well. All crocodiles are semiaquatic and tend to congregate in freshwater habitats such as rivers, lakes, wetlands and sometimes in brackish water and saltwater."}}, {"canonical_name": "arsenicum", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 6, "total_mentions": 27, "members": [{"entity_id": "arsenicum", "book_id": "polyanthea_medicinal", "name": "arsenicum", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 10, "variants": ["arsenicum", "Arfeni", "Arfenico", "Arfenicum", "Arsenicum", "arseni", "arsenico"], "contexts": ["mineral used in medicine", "applied to the heart region"]}, {"entity_id": "arsenic", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Arsenic", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["Arsenic"], "contexts": ["chemical with attractive quality", "chemical attracts but weakly"]}, {"entity_id": "arsenick", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Arsenick", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Arsenick"], "contexts": ["substance in distillations", "mineral poison from the Earth"]}, {"entity_id": "arsenic", "book_id": "principles_of_psychology_james_1890", "name": "arsenic", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["arsenic"], "contexts": ["remedy compared to phosphorus"]}, {"entity_id": "arsenic", "book_id": "kosmos_humboldt_1845", "name": "arsenic", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["arsenic"], "contexts": ["chemical element in meteoric masses", "metal found in volcanic products"]}, {"entity_id": "arsenico", "book_id": "ricettario_fiorentino_1597", "name": "Arsenico", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["Arsenico", "Arfenico"], "contexts": ["Greek name for Orpimento", "arsenic ingredient"]}, {"entity_id": "arsenic", "book_id": "connexion_physical_sciences_somerville_1858", "name": "arsenic", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["arsenic"], "contexts": ["chemical element with specific properties", "body with low diamagnetic power"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "arsenicum", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Arsenic", "similarity": 0.935}, {"source_book": "polyanthea_medicinal"