iences_somerville_1858", "target_name": "Thermometer", "similarity": 0.973}, {"source_book": "principles_of_psychology_james_1890", "source_name": "thermometers", "target_book": "first_principles_spencer_1862", "target_name": "thermometer", "similarity": 0.976}, {"source_book": "kosmos_humboldt_1845", "source_name": "Thermometer", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Thermometer", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Thermometer", "target_book": "first_principles_spencer_1862", "target_name": "thermometer", "similarity": 0.993}, {"source_book": "kosmos_humboldt_1845", "source_name": "thermometers", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Thermometer", "similarity": 0.973}, {"source_book": "kosmos_humboldt_1845", "source_name": "thermometers", "target_book": "first_principles_spencer_1862", "target_name": "thermometer", "similarity": 0.976}, {"source_book": "kosmos_humboldt_1845", "source_name": "thermoscope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Thermometer", "similarity": 0.951}, {"source_book": "kosmos_humboldt_1845", "source_name": "thermoscope", "target_book": "first_principles_spencer_1862", "target_name": "thermometer", "similarity": 0.957}, {"source_book": "kosmos_humboldt_1845", "source_name": "thermometri", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Thermometer", "similarity": 0.984}, {"source_book": "kosmos_humboldt_1845", "source_name": "thermometri", "target_book": "first_principles_spencer_1862", "target_name": "thermometer", "similarity": 0.989}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Thermometer", "target_book": "first_principles_spencer_1862", "target_name": "thermometer", "similarity": 0.993}], "id": 59, "stable_key": "clu_5140fc3d5217fa19", "ground_truth": {"modern_name": "thermometer", "confidence": "high", "type": "OBJECT", "description": "An instrument used to measure temperature.", "wikipedia_extract": "A thermometer is a device that measures temperature (the hotness or coldness of an object) or temperature gradient (the rates of change of temperature in space). A thermometer has two important elements: (1) a temperature sensor (e.g. the bulb of a mercury-in-glass thermometer or the pyrometric sensor in an infrared thermometer) in which some change occurs with a change in temperature; and (2) some means of converting this change into a numerical value (e.g. the visible scale that is marked on a mercury-in-glass thermometer or the digital readout on an infrared model). Thermometers are widely used in technology and industry to monitor processes, in meteorology, in medicine (medical thermometer), and in scientific research. While an individual thermometer is able to measure degrees of hotness, the readings on two thermometers cannot be compared unless they conform to an agreed scale. Today there is an absolute thermodynamic temperature scale. Internationally agreed temperature scales are designed to approximate this closely, based on fixed points and interpolating thermometers."}}, {"canonical_name": "Erysipelas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 5, "total_mentions": 67, "members": [{"entity_id": "erysipelas", "book_id": "polyanthea_medicinal", "name": "Erysipelas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 61, "variants": ["Erysipelas", "AEryfipela", "AErytipela", "Eryfip las", "Eryfipe la", "Eryfipeladas", "Eryfipelate", "Eryfipola", "Erylipela", "Erysipel", "Erysipelamorreo", "Erysipelare", "Erysipelas baſtardas", "Erysipelas interiores", "Erysipelas legitimas", "Erysipelat", "Erysipelata", "Erysipex", "eryfipelata", "erysipelas", "erysipelate", "erysipellam"], "contexts": ["erysipelas, treated by looking at a turtle", "skin infection"]}, {"entity_id": "herisepela", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Herisepela", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Herisepela"], "contexts": ["medical condition related to hair"]}, {"entity_id": "erelypelas", "book_id": "historia_medicinal_monardes_1574", "name": "Erelypelas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["Erelypelas", "Ereſipelas"], "contexts": ["erysipelas treated with herb gum", "erysipelas"]}, {"entity_id": "eſcrophulas", "book_id": "historia_medicinal_monardes_1574", "name": "Eſcrophulas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Eſcrophulas"], "contexts": ["scrofula, a disease"]}, {"entity_id": "eresipuladas", "book_id": "coloquios_da_orta_1563", "name": "eresipuladas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["eresipuladas"], "contexts": ["erysipelas, treated with tamarindos leaves"]}, {"entity_id": "erysipelas", "book_id": "first_principles_spencer_1862", "name": "erysipelas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["erysipelas"], "contexts": ["bacterial skin infection"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Erysipelas", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Herisepela", "similarity": 0.87}, {"source_book": "polyanthea_medicinal", "source_name": "Erysipelas", "target_book": "historia_medicinal_monardes_1574", "target_name": "Erelypelas", "similarity": 0.919}, {"source_book": "polyanthea_medicinal", "source_name": "Erysipelas", "target_book": "historia_medicinal_monardes_1574", "target_name": "Eſcrophulas", "similarity": 0.846}, {"source_book": "polyanthea_medicinal", "source_name": "Erysipelas", "target_book": "coloquios_da_orta_1563", "target_name": "eresipuladas", "similarity": 0.874}, {"source_book": "polyanthea_medicinal", "source_name": "Erysipelas", "target_book": "first_principles_spencer_1862", "target_name": "erysipelas", "similarity": 0.977}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Herisepela", "target_book": "historia_medicinal_monardes_1574", "target_name": "Erelypelas", "similarity": 0.858}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Herisepela", "target_book": "first_principles_spencer_1862", "target_name": "erysipelas", "similarity": 0.844}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Erelypelas", "target_book": "coloquios_da_orta_1563", "target_name": "eresipuladas", "similarity": 0.861}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Erelypelas", "target_book": "first_principles_spencer_1862", "target_name": "erysipelas", "similarity": 0.911}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Eſcrophulas", "target_book": "coloquios_da_orta_1563", "target_name": "eresipuladas", "similarity": 0.852}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Eſcrophulas", "target_book": "first_principles_spencer_1862", "target_name": "erysipelas", "similarity": 0.854}, {"source_book": "coloquios_da_orta_1563", "source_name": "eresipuladas", "target_book": "first_principles_spencer_1862", "target_name": "erysipelas", "similarity": 0.909}], "id": 60, "stable_key": "clu_a06ebbbd7ca23526", "ground_truth": {"modern_name": "Erysipelas", "confidence": "high", "type": "disease", "description": "A bacterial skin infection, often on the face or legs.", "note": "Includes 'Erofulas' which is likely a misspelling or related condition.", "wikipedia_extract": "Erysipelas () is a relatively common bacterial infection of the superficial layer of the skin (upper dermis), extending to the superficial lymphatic vessels within the skin, characterized by a raised, well-defined, tender, bright-red rash, typically on the face or legs, but which can occur anywhere on the skin. It is a form of cellulitis and is potentially serious. Erysipelas is usually caused by the bacterium Streptococcus pyogenes, also known as group A, β-hemolytic streptococci, which enters the body through a break in the skin, such as a scratch or an insect bite. It is more superficial than cellulitis and is typically more raised and demarcated. The term comes from the Greek ἐρυσίπελας (erysípelas), meaning red skin. In animals, erysipelas is a disease caused by infection with the bacterium Erysipelothrix rhusiopathiae."}}, {"canonical_name": "peste", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 5, "total_mentions": 66, "members": [{"entity_id": "peste", "book_id": "polyanthea_medicinal", "name": "peste", "category": "DISEASE", "subcategory": "ACUTE", "count": 41, "variants": ["Peste", "peste"], "contexts": ["plague", "a severe infectious disease"]}, {"entity_id": "plagues", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Plagues", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["Plagues"], "contexts": ["contagious epidemic disease"]}, {"entity_id": "pestilence", "book_id": "english_physician_1652", "name": "Pestilence", "category": "DISEASE", "subcategory": "ACUTE", "count": 16, "variants": ["Pestilence", "Pestilences", "Pestilent Feavers"], "contexts": ["highly infectious disease", "infection that the herb defends against"]}, {"entity_id": "pestilenciales", "book_id": "historia_medicinal_monardes_1574", "name": "pestilenciales", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["pestilenciales"], "contexts": ["pestilential fevers"]}, {"entity_id": "peste", "book_id": "coloquios_da_orta_1563", "name": "peste", "category": "DISEASE", "subcategory": "ACUTE", "count": 7, "variants": ["peste"], "contexts": ["disease mentioned in the text", "contagious disease"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "peste", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Plagues", "similarity": 0.856}, {"source_book": "polyanthea_medicinal", "source_name": "peste", "target_book": "english_physician_1652", "target_name": "Pestilence", "similarity": 0.842}, {"source_book": "polyanthea_medicinal", "source_name": "peste", "target_book": "historia_medicinal_monardes_1574", "target_name": "pestilenciales", "similarity": 0.84}, {"source_book": "polyanthea_medicinal", "source_name": "peste", "target_book": "coloquios_da_orta_1563", "target_name": "peste", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Plagues", "target_book": "english_physician_1652", "target_name": "Pestilence", "similarity": 0.848}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Plagues", "target_book": "historia_medicinal_monardes_1574", "target_name": "pestilenciales", "similarity": 0.853}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Plagues", "target_book": "coloquios_da_orta_1563", "target_name": "peste", "similarity": 0.856}, {"source_book": "english_physician_1652", "source_name": "Pestilence", "target_book": "historia_medicinal_monardes_1574", "target_name": "pestilenciales", "similarity": 0.951}, {"source_book": "english_physician_1652", "source_name": "Pestilence", "target_book": "coloquios_da_orta_1563", "target_name": "peste", "similarity": 0.842}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "pestilenciales", "target_book": "coloquios_da_orta_1563", "target_name": "peste", "similarity": 0.84}], "id": 61, "stable_key": "clu_a50d60775402059c", "ground_truth": {"modern_name": "Plague", "confidence": "high", "type": "disease", "description": "A highly contagious and often fatal infectious disease.", "note": "Covers terms related to the bubonic plague and similar epidemic diseases.", "wikipedia_extract": "Mark Tonderai (born 1974) is a British-Zimbabwean entrepreneur, film director, writer, actor and former disc jockey. He is co-founder of the London-based production company Shona Productions with his wife Zoe Stewart. He directed the crime drama television series The Five which first aired in April 2016 on the Sky 1 channel. Tonderai began his career in the media working as a writer, producer and presenter for radio. From early 1993 until late 1998 Tonderai was heavily involved in radio, and was the writer and producer of The Mark Tonderai Show, hosted on BBC Radio 1, and the Jam. Tonderai was also involved in numerous BBC Radio 4 projects, such as the Worldly Wise, Rainbow Nation and Week Ending, as well as Kiss 100's Rude Awakening, hosted on Kiss 100 London."}}, {"canonical_name": "galanga", "category": "PLANT", "subcategory": "PLANT", "book_count": 5, "total_mentions": 58, "members": [{"entity_id": "galanga", "book_id": "coloquios_da_orta_1563", "name": "galanga", "category": "PLANT", "subcategory": "PLANT", "count": 24, "variants": ["galanga", "GALANGA", "Galanga", "galago", "galamga"], "contexts": ["distinct drug from calamus", "plant discussed in colloquy"]}, {"entity_id": "galanga", "book_id": "english_physician_1652", "name": "Galanga", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Galanga"], "contexts": ["aromatic root used in medicine"]}, {"entity_id": "maranta_galanga", "book_id": "coloquios_da_orta_1563", "name": "Maranta Galanga", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Maranta Galanga", "Mar anta Galanga"], "contexts": ["alternative name for Alpinia Galanga", "plant"]}, {"entity_id": "a,_galanga", "book_id": "coloquios_da_orta_1563", "name": "A, Galanga", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["A, Galanga"], "contexts": ["plant description"]}, {"entity_id": "galbano", "book_id": "polyanthea_medicinal", "name": "galbano", "category": "PLANT", "subcategory": "PLANT", "count": 9, "variants": ["Galbano", "galbano"], "contexts": ["galbanum, used in plaster", "incense for stupor"]}, {"entity_id": "galanga", "book_id": "polyanthea_medicinal", "name": "galanga", "category": "PLANT", "subcategory": "PLANT", "count": 9, "variants": ["Galanga", "galanga"], "contexts": ["ingredient for gargle and wine", "ingredient for decoction"]}, {"entity_id": "galanga", "book_id": "ricettario_fiorentino_1597", "name": "Galanga", "category": "PLANT", "subcategory": "ROOT", "count": 11, "variants": ["GALANGA", "galanga", "Galanga"], "contexts": ["root for comparison of color", "a root with nodes, fragrant and sharp"]}, {"entity_id": "galange", "book_id": "historia_medicinal_monardes_1574", "name": "Galange", "category": "PLANT", "subcategory": "ROOT", "count": 1, "variants": ["Galange"], "contexts": ["plant root with aromatic taste"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "galanga", "target_book": "english_physician_1652", "target_name": "Galanga", "similarity": 0.975}, {"source_book": "coloquios_da_orta_1563", "source_name": "galanga", "target_book": "polyanthea_medicinal", "target_name": "galbano", "similarity": 0.858}, {"source_book": "coloquios_da_orta_1563", "source_name": "galanga", "target_book": "polyanthea_medicinal", "target_name": "galanga", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Galanga", "target_book": "coloquios_da_orta_1563", "target_name": "Maranta Galanga", "similarity": 0.854}, {"source_book": "english_physician_1652", "source_name": "Galanga", "target_book": "coloquios_da_orta_1563", "target_name": "A, Galanga", "similarity": 0.861}, {"source_book": "english_physician_1652", "source_name": "Galanga", "target_book": "polyanthea_medicinal", "target_name": "galbano", "similarity": 0.84}, {"source_book": "english_physician_1652", "source_name": "Galanga", "target_book": "polyanthea_medicinal", "target_name": "galanga", "similarity": 0.975}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Galanga", "target_book": "historia_medicinal_monardes_1574", "target_name": "Galange", "similarity": 0.906}], "id": 62, "stable_key": "clu_6aa02a1b5c0df5dc", "ground_truth": {"modern_name": "Galangal", "confidence": "high", "type": "plant", "linnaean": "Alpinia galanga", "family": "Zingiberaceae", "description": "An aromatic root used medicinally and as a spice.", "note": "Distinct from galbanum.", "wikipedia_extract": "Alpinia galanga, a plant in the ginger family, bears a rhizome used largely as an herb in Unani medicine and as a spice in Southeast Asian cookery. It is one of four plants known as \"galangal\". Its common names include greater galangal, lengkuas, and blue ginger. The name \"galangal\" is probably derived from Persian qulanjan or Arabic khalanjan, which in turn may be an adaptation of Chinese gao liang jiang. Its names in North India are derived from the same root, including kulanja in Sanskrit, kulanjan in Hindi, and kholinjan in Urdu. The name \"lengkuas\", on the other hand, is derived from Malay lengkuas, which is derived from Proto-Western Malayo-Polynesian *laŋkuas, with cognates including Ilokano langkuás; Tagalog, Bikol, Kapampangan, Visayan, and Manobo langkáuas or langkáwas; Aklanon eangkawás; Kadazan Dusun hongkuas; Ida'an lengkuas; Ngaju Dayak langkuas; and Iban engkuas."}}, {"canonical_name": "Australia", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 5, "total_mentions": 46, "members": [{"entity_id": "australia", "book_id": "origin_of_species_darwin_1859", "name": "Australia", "category": "PLACE", "subcategory": "COUNTRY", "count": 33, "variants": ["Australia"], "contexts": ["location of indigenous peoples with dogs", "geographic location with savages"]}, {"entity_id": "australia", "book_id": "kosmos_humboldt_1845", "name": "Australia", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Australia"], "contexts": ["continent where Sound is located", "continent with similar species"]}, {"entity_id": "austrália", "book_id": "coloquios_da_orta_1563", "name": "Austrália", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Austrália"], "contexts": ["mentioned in relation to an abyss", "continent and country"]}, {"entity_id": "australia", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Australia", "category": "PLACE", "subcategory": "COUNTRY", "count": 6, "variants": ["Australia"], "contexts": ["continent with a desert influencing winds", "continent with plant species"]}, {"entity_id": "australia", "book_id": "first_principles_spencer_1862", "name": "Australia", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Australia"], "contexts": ["continent and country", "continent and country with indigenous tribes"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Australia", "target_book": "kosmos_humboldt_1845", "target_name": "Australia", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Australia", "target_book": "coloquios_da_orta_1563", "target_name": "Austrália", "similarity": 0.961}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Australia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Australia", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Australia", "target_book": "first_principles_spencer_1862", "target_name": "Australia", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Australia", "target_book": "coloquios_da_orta_1563", "target_name": "Austrália", "similarity": 0.961}, {"source_book": "kosmos_humboldt_1845", "source_name": "Australia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Australia", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Australia", "target_book": "first_principles_spencer_1862", "target_name": "Australia", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Austrália", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Australia", "similarity": 0.961}, {"source_book": "coloquios_da_orta_1563", "source_name": "Austrália", "target_book": "first_principles_spencer_1862", "target_name": "Australia", "similarity": 0.961}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Australia", "target_book": "first_principles_spencer_1862", "target_name": "Australia", "similarity": 1.0}], "id": 63, "stable_key": "clu_ced83a6f906a6c98", "ground_truth": {"modern_name": "Australia", "confidence": "high", "type": "place", "description": "Continent and country in the Southern Hemisphere, known for unique wildlife.", "wikipedia_extract": "Australia, officially the Commonwealth of Australia, is a country comprising the mainland of the Australian continent, the island of Tasmania and numerous smaller islands. It has a total area of 7,688,287 km2 (2,968,464 sq mi), making it the sixth-largest country in the world and the largest in Oceania. Australia is the world's flattest and driest inhabited continent. It is a megadiverse country, and its size gives it a wide variety of landscapes and climates including deserts in the interior and tropical rainforests along the coast. The ancestors of Aboriginal Australians began arriving from Southeast Asia 50,000 to 65,000 years ago, during the Last Glacial Period. By the time of British settlement, Aboriginal Australians spoke more than 250 distinct languages and had one of the oldest living cultures in the world."}}, {"canonical_name": "theory", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 5, "total_mentions": 36, "members": [{"entity_id": "theory", "book_id": "connexion_physical_sciences_somerville_1858", "name": "theory", "category": "CONCEPT", "subcategory": "THEORY", "count": 17, "variants": ["theory", "Theory"], "contexts": ["scientific explanation or hypothesis", "mathematical explanation of celestial mechanics"]}, {"entity_id": "theoriques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Theoriques", "category": "CONCEPT", "subcategory": "THEORY", "count": 3, "variants": ["Theoriques", "théories"], "contexts": ["based on theoretical suppositions", "theoretical suppositions"]}, {"entity_id": "theory", "book_id": "principles_of_psychology_james_1890", "name": "theory", "category": "CONCEPT", "subcategory": "THEORY", "count": 4, "variants": ["theory"], "contexts": ["explanation of mental life", "abstract explanation or system of ideas"]}, {"entity_id": "theories", "book_id": "principles_of_psychology_james_1890", "name": "theories", "category": "CONCEPT", "subcategory": "THEORY", "count": 3, "variants": ["theories"], "contexts": ["engendered by association of ideas", "explanations of phenomena"]}, {"entity_id": "theory", "book_id": "kosmos_humboldt_1845", "name": "theory", "category": "CONCEPT", "subcategory": "THEORY", "count": 4, "variants": ["theory"], "contexts": ["system of ideas intended to explain something", "Humboldt's explanation of snow-line"]}, {"entity_id": "theory_of", "book_id": "connexion_physical_sciences_somerville_1858", "name": "theory of", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["theory of"], "contexts": ["explaining meteors"]}, {"entity_id": "theory_of_things", "book_id": "first_principles_spencer_1862", "name": "Theory of Things", "category": "CONCEPT", "subcategory": "THEORY", "count": 3, "variants": ["Theory of Things"], "contexts": ["Any Theory of Things which takes no account", "a framework for understanding existence"]}, {"entity_id": "theory", "book_id": "first_principles_spencer_1862", "name": "theory", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["theory"], "contexts": ["proposed explanation for phenomena"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "theory", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Theoriques", "similarity": 0.927}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "theory", "target_book": "principles_of_psychology_james_1890", "target_name": "theo