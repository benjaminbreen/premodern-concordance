ettario_fiorentino_1597", "target_name": "Galeno", "similarity": 0.907}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Galeno", "target_book": "coloquios_da_orta_1563", "target_name": "Galeno", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Galeno", "target_book": "ricettario_fiorentino_1597", "target_name": "Galeno", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Galeno", "target_book": "ricettario_fiorentino_1597", "target_name": "Galeno", "similarity": 1.0}], "id": 10, "stable_key": "clu_a7804b80944c2d45", "ground_truth": {"modern_name": "Galen", "confidence": "high", "type": "person", "description": "Ancient Greek physician and highly influential medical authority.", "note": "Refers to the ancient physician, not the planet or musician.", "wikipedia_extract": "Aelius Galenus or Claudius Galenus (Greek: Κλαύδιος Γαληνός; September 129 – c. 216 CE), often anglicized as Galen () or Galen of Pergamon, was a Roman and Greek physician, surgeon, and philosopher. Considered to be one of the most accomplished of all medical researchers of antiquity, Galen influenced the development of various scientific disciplines, including anatomy, physiology, pathology, pharmacology, and neurology, as well as philosophy and logic. The son of Aelius Nicon, a wealthy Greek architect with scholarly interests, Galen received a comprehensive education that prepared him for a successful career as a physician and philosopher. Born in the ancient city of Pergamon (present-day Bergama, Turkey), Galen traveled extensively, exposing himself to a wide variety of medical theories and discoveries before settling in Rome, where he served prominent members of Roman society and eventually was given the position of personal physician to several emperors. Galen's understanding of anatomy and medicine was principally influenced by the contemporary theory of the four humors: black bile, yellow bile, blood, and phlegm, as first advanced by the author of On the Nature of Man in the Hippocratic corpus. Galen's views dominated and influenced Western medical science for more than 1,300 years."}}, {"canonical_name": "humoral theory", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 8, "total_mentions": 383, "members": [{"entity_id": "humoral_theory", "book_id": "polyanthea_medicinal", "name": "humoral theory", "category": "CONCEPT", "subcategory": "THEORY", "count": 240, "variants": ["humoral theory", "Humoral theory", "humoral", "humorali", "humoralis"], "contexts": ["implied medical framework", "implied medical theory"]}, {"entity_id": "humoral_theory", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "humoral theory", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["humoral theory"], "contexts": ["theory of bodily fluids"]}, {"entity_id": "humors", "book_id": "english_physician_1652", "name": "Humors", "category": "CONCEPT", "subcategory": "THEORY", "count": 77, "variants": ["Humors", "Hu†mors", "humors"], "contexts": ["bodily fluids influencing health", "bodily fluids in humoral theory"]}, {"entity_id": "humoral_theory", "book_id": "english_physician_1652", "name": "humoral theory", "category": "CONCEPT", "subcategory": "THEORY", "count": 3, "variants": ["Humoral theory", "humoral theory"], "contexts": ["theory of bodily fluids", "implied by qualities like cold/moist"]}, {"entity_id": "humors", "book_id": "relation_historique_humboldt_vol3_1825", "name": "humors", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["humors"], "contexts": ["implied by discussion of humidity"]}, {"entity_id": "humoral_theory", "book_id": "kosmos_humboldt_1845", "name": "humoral theory", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["humoral theory"], "contexts": ["theory of bodily fluids"]}, {"entity_id": "humoral_theory", "book_id": "historia_medicinal_monardes_1574", "name": "humoral theory", "categor