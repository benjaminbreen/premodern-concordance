_vol3_1825", "source_name": "alembics", "target_book": "historia_medicinal_monardes_1574", "target_name": "alembic", "similarity": 0.975}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "alembics", "target_book": "coloquios_da_orta_1563", "target_name": "alembic", "similarity": 0.975}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "alembics", "target_book": "coloquios_da_orta_1563", "target_name": "alanbique", "similarity": 0.844}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "alembics", "target_book": "ricettario_fiorentino_1597", "target_name": "alambicco", "similarity": 0.854}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "alembics", "target_book": "ricettario_fiorentino_1597", "target_name": "Alembic", "similarity": 0.906}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "alembic", "target_book": "coloquios_da_orta_1563", "target_name": "alembic", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "alembic", "target_book": "coloquios_da_orta_1563", "target_name": "alanbique", "similarity": 0.867}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "alembic", "target_book": "ricettario_fiorentino_1597", "target_name": "alambicco", "similarity": 0.879}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "alembic", "target_book": "ricettario_fiorentino_1597", "target_name": "Alembic", "similarity": 0.899}, {"source_book": "coloquios_da_orta_1563", "source_name": "alembic", "target_book": "ricettario_fiorentino_1597", "target_name": "alambicco", "similarity": 0.879}, {"source_book": "coloquios_da_orta_1563", "source_name": "alembic", "target_book": "ricettario_fiorentino_1597", "target_name": "Alembic", "similarity": 0.899}, {"source_book": "coloquios_da_orta_1563", "source_name": "alanbique", "target_book": "ricettario_fiorentino_1597", "target_name": "alambicco", "similarity": 0.854}], "id": 39, "stable_key": "clu_9f98981b1cc286e6", "ground_truth": {"modern_name": "Alambic", "confidence": "high", "type": "object", "description": "A type of distillation apparatus used for separating liquids.", "wikipedia_extract": "An alembic (from Arabic: الإنبيق, romanized: al-inbīq, originating from Ancient Greek: ἄμβιξ, romanized: ambix, 'cup, beaker') is an alchemical still consisting of two vessels connected by a tube, used for distillation of liquids. The complete distilling apparatus consists of three parts: the \"cucurbit\" (Arabic: ḳarʿa; Greek: βῖκος, bîkos), the still pot containing the liquid to be distilled, which is heated by a flame the \"head\" or \"cap\" (إِنْبِيق‎, ʾinbīq; Greek ἄμβιξ, ambix) which fits over the mouth of the cucurbit to receive the vapors, with an attached downward-sloping \"tube\" (σωλήν, sōlēn) the \"receiver\" (قَابِلَة, qābila; ἄγγος, angos or φιάλη, phialē) container In the case of another distilling vessel, the retort, the \"cap\" and the \"cucurbit\" have been combined to form a single vessel. The anbik is also called the raʾs (the Arabic word raʾs means \"head\") of the cucurbit. The liquid in the cucurbit is heated or boiled; the vapour rises into the anbik, where it cools by contact with the walls and condenses, running down the spout into the receiver. A modern descendant of the alembic is the pot still, used to produce distilled beverages. Dioscorides's ambix, described in his De materia medica (c. 50 C.E.), is a helmet-shaped lid for gathering condensed mercury."}}, {"canonical_name": "elephantes", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 6, "total_mentions": 39, "members": [{"entity_id": "elephantes", "book_id": "coloquios_da_orta_1563", "name": "elephantes", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 23, "variants": ["elephantes", "Elephante", "Elephantes", "Elephat indicux", "elefanta", "elefantes", "elephante"], "contexts": ["elephants found in the forests", "animal carried by Geruda"]}, {"entity_id": "elephant", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Elephant", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 4, "variants": ["Elephant"], "contexts": ["animal with debated joint structure", "animal with unusual leg joints"]}, {"entity_id": "elephant", "book_id": "origin_of_species_darwin_1859", "name": "Elephant", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 7, "variants": ["elephant", "Elephant"], "contexts": ["slowest breeding animal", "large herbivorous mammal"]}, {"entity_id": "elephant", "book_id": "kosmos_humboldt_1845", "name": "elephant", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["elephant"], "contexts": ["extant animal found as fossil"]}, {"entity_id": "elephante", "book_id": "polyanthea_medicinal", "name": "Elephante", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 2, "variants": ["Elephante", "elefante"], "contexts": ["a large animal", "elephant, fears ants"]}, {"entity_id": "elephant", "book_id": "connexion_physical_sciences_somerville_1858", "name": "elephant", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["elephant"], "contexts": ["large mammal from torrid zone", "animal inhabiting the torrid zone"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "elephantes", "target_book": "polyanthea_medicinal", "target_name": "Elephante", "similarity": 0.928}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Elephant", "target_book": "origin_of_species_darwin_1859", "target_name": "Elephant", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Elephant", "target_book": "kosmos_humboldt_1845", "target_name": "elephant", "similarity": 0.989}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Elephant", "target_book": "polyanthea_medicinal", "target_name": "Elephante", "similarity": 0.824}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Elephant", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "elephant", "similarity": 0.989}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Elephant", "target_book": "kosmos_humboldt_1845", "target_name": "elephant", "similarity": 0.989}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Elephant", "target_book": "polyanthea_medicinal", "target_name": "Elephante", "similarity": 0.824}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Elephant", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "elephant", "similarity": 0.989}, {"source_book": "kosmos_humboldt_1845", "source_name": "elephant", "target_book": "polyanthea_medicinal", "target_name": "Elephante", "similarity": 0.814}, {"source_book": "kosmos_humboldt_1845", "source_name": "elephant", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "elephant", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Elephante", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "elephant", "similarity": 0.814}], "id": 40, "stable_key": "clu_3676de87c334ffdc", "ground_truth": {"modern_name": "Elephants", "confidence": "high", "type": "animal", "description": "Large, herbivorous mammals known for their size and strength.", "wikipedia_extract": "Elephants are the largest living land animals. Three living species are currently recognised: the African bush elephant (Loxodonta africana), the African forest elephant (L. cyclotis), and the Asian elephant (Elephas maximus). They are the only surviving members of the family Elephantidae and the order Proboscidea; extinct relatives include mammoths and mastodons. Distinctive features of elephants include a long proboscis called a trunk, tusks, large ear flaps, pillar-like legs, and tough but sensitive grey skin. The trunk is prehensile, bringing food and water to the mouth and grasping objects. Tusks, which are derived from the incisor teeth, serve both as weapons and as tools for moving objects and digging."}}, {"canonical_name": "crocodiles", "category": "ANIMAL", "subcategory": "REPTILE", "book_count": 6, "total_mentions": 27, "members": [{"entity_id": "crocodiles", "book_id": "relation_historique_humboldt_vol3_1825", "name": "crocodiles", "category": "ANIMAL", "subcategory": "REPTILE", "count": 20, "variants": ["crocodiles", "Crocodilus aciiius", "Crocodilus acutus", "Crocodilus aoutus", "cocodrilo", "crocodile", "crocodile du Nil"], "contexts": ["animal eaten by Caribes", "large and numerous reptiles in Rio Neveri"]}, {"entity_id": "crocodiles", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Crocodiles", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["Crocodiles"], "contexts": ["oviparous quadruped with analogous joints"]}, {"entity_id": "crocodile", "book_id": "origin_of_species_darwin_1859", "name": "crocodile", "category": "ANIMAL", "subcategory": "REPTILE", "count": 2, "variants": ["crocodile"], "contexts": ["existing reptile found with extinct forms", "reptile name"]}, {"entity_id": "crocodiles", "book_id": "kosmos_humboldt_1845", "name": "crocodiles", "category": "ANIMAL", "subcategory": "REPTILE", "count": 2, "variants": ["crocodiles"], "contexts": ["large semi-aquatic reptiles", "large aquatic reptiles"]}, {"entity_id": "crocodilo", "book_id": "historia_medicinal_monardes_1574", "name": "Crocodilo", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["Crocodilo"], "contexts": ["crocodile, referring to Cayman"]}, {"entity_id": "crocodile", "book_id": "connexion_physical_sciences_somerville_1858", "name": "crocodile", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["crocodile"], "contexts": ["large aquatic reptile"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "crocodiles", "target_book": "pseudodoxia_epidemica_