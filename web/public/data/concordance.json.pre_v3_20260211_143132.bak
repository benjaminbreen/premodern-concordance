loquios_da_orta_1563", "source_name": "Paris", "target_book": "polyanthea_medicinal", "target_name": "París", "similarity": 0.982}, {"source_book": "coloquios_da_orta_1563", "source_name": "Paris", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Paris", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "París", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Paris", "similarity": 0.982}], "id": 26, "stable_key": "clu_8bf34c6320b0defb", "ground_truth": {"modern_name": "Paris", "confidence": "high", "type": "place", "description": "The capital city of France.", "wikipedia_extract": "Paris is the capital and largest city of France, with an estimated city population of 2,047,602 in an area of 105.4 km2 (40.7 sq mi), and a metropolitan population of 13,239,090 as of January 2026. Located on the river Seine in the centre of the Île-de-France region, it is the largest metropolitan area and fourth-most populous city in the European Union (EU). Nicknamed the City of Light, partly because of its role in the Age of Enlightenment, Paris has been one of the world's major centres of finance, diplomacy, commerce, culture, fashion, and gastronomy since the 17th century. Administratively, Paris is divided into twenty arrondissements (districts), each having their own cultural identity. Haussmann's renovation of Paris, which created new boulevards, parks, and public works, gave birth to a modern city known as the \"capital of the 19th century\". Paris is a major railway, motorway, and air-transport hub; in 2024 Charles de Gaulle Airport was the EU's busiest airport."}}, {"canonical_name": "Portugal", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 6, "total_mentions": 165, "members": [{"entity_id": "portugal", "book_id": "coloquios_da_orta_1563", "name": "Portugal", "category": "PLACE", "subcategory": "COUNTRY", "count": 123, "variants": ["Portugal", "Portu-gal", "PortugaL", "Portugall"], "contexts": ["country where certain terms are used", "destination for substances"]}, {"entity_id": "portugal", "book_id": "kosmos_humboldt_1845", "name": "Portugal", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Portugal"], "contexts": ["European nation", "country where myrtle blooms"]}, {"entity_id": "portugal", "book_id": "historia_medicinal_monardes_1574", "name": "Portugal", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Portugal"], "contexts": ["Portugal, where these animals are found", "country of origin for travelers"]}, {"entity_id": "portogallo", "book_id": "ricettario_fiorentino_1597", "name": "Portogallo", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Portogallo"], "contexts": ["country from which Lacca is imported"]}, {"entity_id": "portugal", "book_id": "polyanthea_medicinal", "name": "Portugal", "category": "PLACE", "subcategory": "COUNTRY", "count": 35, "variants": ["Portugal", "Portuguez", "Portugueza"], "contexts": ["country where author wished to use remedy advertising", "country ruled by D. Pedro II."]}, {"entity_id": "portugal", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Portugal", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Portugal"], "contexts": ["country whose plants are found in Madeira"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Portugal", "target_book": "kosmos_humboldt_1845", "target_name": "Portugal", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Portugal", "target_book": "historia_medicinal_monardes_1574", "target_name": "Portugal", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Portugal", "target_book": "ricettario_fiorentino_1597", "target_name": "Portogallo", "similarity": 0.92}, {"source_book": "coloquios_da_orta_1563", "source_name": "Portugal", "target_book": "polyanthea_medicinal", "target_name": "Portugal"