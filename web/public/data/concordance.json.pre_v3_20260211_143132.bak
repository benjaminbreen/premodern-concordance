k": "relation_historique_humboldt_vol3_1825", "source_name": "Gates du Malabar", "target_book": "kosmos_humboldt_1845", "target_name": "Malabar", "similarity": 0.863}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Gates du Malabar", "target_book": "ricettario_fiorentino_1597", "target_name": "Malabar", "similarity": 0.863}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Malabar", "target_book": "kosmos_humboldt_1845", "target_name": "Malabar", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Malabar", "target_book": "ricettario_fiorentino_1597", "target_name": "Malabar", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Malabar", "target_book": "ricettario_fiorentino_1597", "target_name": "Malabar", "similarity": 1.0}], "id": 31, "stable_key": "clu_ffdede99a6161387", "ground_truth": {"modern_name": "Malabar Coast", "confidence": "high", "type": "place", "description": "Region in southwestern India.", "wikipedia_extract": "The Malabar Coast (Malayalam: [mɐlɐbaːr]) is the southwestern region of the Indian subcontinent. It generally refers to the western coastline of India stretching from Konkan to Kanyakumari. Geographically, it comprises one of the wettest regions of the subcontinent, which includes the southern tip of Goa, Kanara region of Karnataka, all of Kerala and Kanyakumari region of Tamil Nadu. Kuttanad, which is the point of the lowest elevation in India, lies on the Malabar Coast. Kuttanad, also known as The Rice Bowl of Kerala, is among the few places in the world where cultivation takes place below sea level. The peak of Anamudi, which is also the point of highest elevation in India outside the Himalayas, lies parallel to the Malabar Coast on the Western Ghats."}}, {"canonical_name": "Tabaco", "category": "PLANT", "subcategory": "PLANT", "book_count": 6, "total_mentions": 84, "members": [{"entity_id": "tabaco", "book_id": "polyanthea_medicinal", "name": "Tabaco", "category": "PLANT", "subcategory": "PLANT", "count": 34, "variants": ["Tabaco", "tabaci", "tabaco", "tabaco de fumo", "tabacode fumo", "tabacodefumo"], "contexts": ["used for sieve comparison", "tobacco for fumigation"]}, {"entity_id": "tobacco", "book_id": "english_physician_1652", "name": "Tobacco", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Tobacco"], "contexts": ["plant smoked like rosemary leaves"]}, {"entity_id": "tobacco", "book_id": "origin_of_species_darwin_1859", "name": "Tobacco", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Tobacco", "tobacco"], "contexts": ["plant variety with fertility differences", "crossed varieties"]}, {"entity_id": "tabac", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tabac", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["Tabac", "tabac", "tabac en feuilles", "tabac en rama", "tabac à fumer", "tabaco en rama"], "contexts": ["production from Varinas", "agricultural product"]}, {"entity_id": "tabaco", "book_id": "historia_medicinal_monardes_1574", "name": "Tabaco", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 27, "variants": ["Tabaco", "Taba", "Tabaco verde"], "contexts": ["plant from the Indies", "plant with great virtues"]}, {"entity_id": "tabaxir", "book_id": "coloquios_da_orta_1563", "name": "tabaxir", "category": "PLANT", "subcategory": "PLANT", "count": 6, "variants": ["tabaxir"], "contexts": ["substance from Persia, also called sacarmambum", "substance requested by Moors from Persia, Arabia, Turkey"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Tabaco", "target_book": "english_physician_1652", "target_name": "Tobacco", "similarity": 0.917}, {"source_book": "polyanthea_medicinal", "source_name": "Tabaco", "target_book": "origin_of_species_darwin_1859", "target_name": "Tobacco", "similarity": 0.86}, {"source_book": "polyanthea_medicinal", "source_name": "Tabaco", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Tabac", "similarity": 0.899}, {"source_book": "polyanthea_medicinal", "source_name": "Tabaco", "target_book": "historia_medicinal_monardes_1574", "target_name": "Tabaco", "similarity": 0.909}, {"source_book": "polyanthea_medicinal", "source_name": "Tabaco", "target_book": "coloquios_da_orta_1563", "target_name": "tabaxir", "similarity": 0.847}, {"source_book": "english_physician_1652", "source_name": "Tobacco", "target_book": "origin_of_species_darwin_1859", "target_name": "Tobacco", "similarity": 0.909}, {"source_book": "english_physician_1652", "source_name": "Tobacco", "target_book": "historia_medicinal_monardes_1574", "target_name": "Tabaco", "similarity": 0.828}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Tobacco", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Tabac", "similarity": 0.926}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Tobacco", "target_book": "historia_medicinal_monardes_1574", "target_name": "Tabaco", "similarity": 0.943}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tabac", "target_book": "historia_medicinal_monardes_1574", "target_name": "Tabaco", "similarity": 0.992}], "id": 32, "stable_key": "clu_f7991168a9931628", "ground_truth": {"modern_name": "Tobacco", "confidence": "high", "type": "plant", "linnaean": "Nicotiana tabacum", "family": "Solanaceae", "description": "Plant species of the genus Nicotiana, widely cultivated for its leaves.", "note": "Includes the term 'tabaxir', which refers to a siliceous deposit from bamboo, but contextually relates to the broader discussion of medicinal plant substances.", "wikipedia_extract": "Nicotiana tabacum, or cultivated tobacco, is an annually grown herbaceous plant of the genus Nicotiana. N. tabacum is the most commonly grown species in the genus Nicotiana, as the plant's leaves are commercially harvested to be processed into tobacco for human use. The plant is tropical in origin, is commonly grown throughout the world, and is often found in cultivation. It grows to heights between 1 and 2 metres (3.3 and 6.6 ft). Research is ongoing into its ancestry among wild Nicotiana species, but it is believed to be a hybrid of Nicotiana sylvestris, N. tomentosiformis, and possibly N. otophora. It is an annual plant that grows 1 to 3 metres (3 to 10 feet) high and is sticky haired on all parts."}}, {"canonical_name": "Himalaya", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 6, "total_mentions": 79, "members": [{"entity_id": "himalaya", "book_id": "kosmos_humboldt_1845", "name": "Himalaya", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 29, "variants": ["Himalaya"], "contexts": ["limits of perpetual snow", "northern and southern chains"]}, {"entity_id": "himalaya", "book_id": "origin_of_species_darwin_1859", "name": "Himalaya", "category": "PLACE", "subcategory": "REGION", "count": 7, "variants": ["Himalaya"], "contexts": ["mountain range in India", "mountain range in Asia"]}, {"entity_id": "himalaya", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Himalaya", "category": "PLACE", "subcategory": "REGION", "count": 14, "variants": ["Himalaya"], "contexts": ["mountain chain near a lake", "mountain range distant from the sea"]}, {"entity_id": "himalayas", "book_id": "kosmos_humboldt_1845", "name": "Himalayas", "category": "PLACE", "subcategory": "REGION", "count": 12, "variants": ["Himalayas"], "contexts": ["mountain range in Asia", "mountain range with snow-line"]}, {"entity_id": "himalaya_mountains", "book_id": "kosmos_humboldt_1845", "name": "Himalaya Mountains", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Himalaya Mountains"], "contexts": ["rarity of palms and ferns"]}, {"entity_id": "himalaya", "book_id": "coloquios_da_orta_1563", "name": "Himalaya", "category": "PLACE", "subcategory": "REGION", "count": 9, "variant