os", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["tintoreiros"], "contexts": ["dyers who rejected sândalo"]}, {"entity_id": "tintori", "book_id": "ricettario_fiorentino_1597", "name": "tintori", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["tintori"], "contexts": ["dyers"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "tintoreiros", "target_book": "ricettario_fiorentino_1597", "target_name": "tintori", "similarity": 0.966}], "id": 2079, "stable_key": "clu_84f734d435d0c6ec", "ground_truth": {"modern_name": "Dyers", "confidence": "high", "type": "person", "description": "Artisans involved in dyeing textiles and other materials.", "wikidata_id": "Q6147194", "wikidata_description": "occupation where a person is involved in dyeing", "wikipedia_url": "https://en.wikipedia.org/wiki/Dyer%20%28occupation%29"}}, {"canonical_name": "bola", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bola", "book_id": "coloquios_da_orta_1563", "name": "bola", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["bola"], "contexts": ["Arabic name for mocebar"]}, {"entity_id": "bolas", "book_id": "polyanthea_medicinal", "name": "bolas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["bolas"], "contexts": ["balls found in stomachs"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "bola", "target_book": "polyanthea_medicinal", "target_name": "bolas", "similarity": 0.968}], "id": 2080, "stable_key": "clu_48ebd56ad76b03f7", "ground_truth": {"modern_name": "Bezoar", "confidence": "high", "type": "mineral", "note": "'Bola' is the Arabic word for bezoar, a medicinal concretion found in the stomach of some animals. 'Bolas' in the second source likely refers to the same.", "wikidata_id": "Q897514", "wikidata_description": "subspecies of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Bezoar%20ibex"}}, {"canonical_name": "ruym", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ruym", "book_id": "coloquios_da_orta_1563", "name": "ruym", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["ruym"], "contexts": ["Poor quality"]}, {"entity_id": "ruyvas", "book_id": "polyanthea_medicinal", "name": "ruyvas", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["ruyvas"], "contexts": ["red-haired"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "ruym", "target_book": "polyanthea_medicinal", "target_name": "ruyvas", "similarity": 0.872}], "id": 2081, "stable_key": "clu_b8960b48378acf6d", "ground_truth": {"modern_name": "Poor quality", "confidence": "high", "type": "concept", "note": "The term 'ruym' in Portuguese and its potential relation to 'ruyvas' (red) in other contexts suggests a descriptor for material quality, specifically a negative attribute like 'poor' or 'inferior'.", "wikidata_id": "Q185957", "wikidata_description": "non-inferiority or superiority of something; a perceptual, conditional, and somewhat subjective attribute that may be understood differently by different people", "wikipedia_url": "https://en.wikipedia.org/wiki/Quality_%28business%29"}}, {"canonical_name": "sus", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sus", "book_id": "coloquios_da_orta_1563", "name": "sus", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["sus"], "contexts": ["Arabic name for Glycyrrhiza"]}, {"entity_id": "su-", "book_id": "polyanthea_medicinal", "name": "Su-", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Su-"], "contexts": ["plant part, likely succory"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "sus", "target_book": "polyanthea_medicinal", "target_name": "Su-", "similarity": 0.872}], "id": 2082, "stable_key": "clu_cec0e9066e4f1b88", "ground_truth": {"modern_name": "Licorice", "confidence": "high", "type": "plant", "linnaean": "Glycyrrhiza glabra Linnaeus", "family": "Fabaceae", "note": "The context of 'Glycyrrhiza' strongly suggests licorice. 'Sus' is an Arabic term for licorice.", "wikidata_id": "Q15447514", "wikidata_description": "species of plant"}}, {"canonical_name": "velhice", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "velhice", "book_id": "coloquios_da_orta_1563", "name": "velhice", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["velhice"], "contexts": ["state of being old"]}, {"entity_id": "velhice", "book_id": "polyanthea_medicinal", "name": "velhice", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["velhice"], "contexts": ["stage of life"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "velhice", "target_book": "polyanthea_medicinal", "target_name": "velhice", "similarity": 1.0}], "id": 2083, "stable_key": "clu_a552996f5bdf758f", "ground_truth": {"modern_name": "Old age", "confidence": "high", "type": "concept", "wikidata_id": "Q191089", "wikidata_description": "consists of ages nearing or surpassing the life expectancy of human beings", "wikipedia_url": "https://en.wikipedia.org/wiki/Old_age"}}, {"canonical_name": "corrutivel", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "corrutivel", "book_id": "coloquios_da_orta_1563", "name": "corrutivel", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["corrutivel"], "contexts": ["prone to decay"]}, {"entity_id": "curavel", "book_id": "polyanthea_medicinal", "name": "curavel", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["curavel"], "contexts": ["ability to be cured"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "corrutivel", "target_book": "polyanthea_medicinal", "target_name": "curavel", "similarity": 0.856}], "id": 2084, "stable_key": "clu_a82ffe47da0446e4", "ground_truth": {"modern_name": "Curable", "confidence": "high", "type": "concept", "note": "'Corrutivel' means perishable or corruptible, while 'curavel' means curable. Given the context of medicine, 'curavel' (curable) seems the more likely interpretation, or it could refer to the susceptibility to corruption, which is the opposite of being healthy/curable.", "wikidata_id": "Q34676600", "wikidata_description": "viscous mass of various chemical substances for the production of form-fitting objects"}}, {"canonical_name": "Libéria", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "libéria", "book_id": "coloquios_da_orta_1563", "name": "Libéria", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Libéria"], "contexts": ["geographic region"]}, {"entity_id": "lybiade", "book_id": "polyanthea_medicinal", "name": "Lybiade", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Lybiade"], "contexts": ["Lybia, ruled by King Juba"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Libéria", "target_book": "polyanthea_medicinal", "target_name": "Lybiade", "similarity": 0.873}], "id": 2085, "stable_key": "clu_5ed36161a10d35c0", "ground_truth": {"wikipedia_extract": "Liberia, officially the Republic of Liberia, is a country on the West African coast. It is bordered by Sierra Leone to its northwest, Guinea to its north, Ivory Coast to its east, and the Atlantic Ocean to its south and southwest. It has a population of around 5.5 million and covers an area of 43,000 square miles (111,369 km2). The official language is English. Over 20 indigenous languages are spoken, reflecting the country's ethnic and cultural diversity. The capital and largest city is Monrovia."}}, {"canonical_name": "doçura", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "doçura", "book_id": "coloquios_da_orta_1563", "name": "doçura", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["doçura"], "contexts": ["quality of taste"]}, {"entity_id": "doçura", "book_id": "polyanthea_medicinal", "name": "doçura", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["doçura"], "contexts": ["sweetness"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "doçura", "target_book": "polyanthea_medicinal", "target_name": "doçura", "similarity": 1.0}], "id": 2086, "stable_key": "clu_f93e45e734125675", "ground_truth": {"modern_name": "sweetness", "confidence": "high", "type": "concept", "wikidata_id": "Q22981706", "wikidata_description": "vocal track by Lloyd Cole and the Commotions; 1984 studio recording"}}, {"canonical_name": "Aurundú", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "aurundú", "book_id": "coloquios_da_orta_1563", "name": "Aurundú", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Aurundú"], "contexts": ["Sinhalese name for cinnamon"]}, {"entity_id": "aureo", "book_id": "polyanthea_medicinal", "name": "aureo", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["aureo"], "contexts": ["herb used in medicines"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Aurundú", "target_book": "polyanthea_medicinal", "target_name": "aureo", "similarity": 0.872}], "id": 2087, "stable_key": "clu_8cf1fd1b8cdae95c", "ground_truth": {"modern_name": "Cinnamomum verum", "confidence": "high", "type": "plant", "linnaean": "Cinnamomum verum Burm.f.", "family": "Lauraceae", "note": "The text mentions 'aureo' in Polyanthea Medicinal, which might be a corruption or a less common name associated with golden cinnamon or a specific preparation.", "wikidata_id": "Q28165", "wikidata_description": "spice obtained from the inner bark of several tree species from the genus Cinnamomum", "wikipedia_url": "https://en.wikipedia.org/wiki/Cinnamon"}}, {"canonical_name": "agoa ardente", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "agoa_ardente", "book_id": "coloquios_da_orta_1563", "name": "agoa ardente", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["agoa ardente"], "contexts": ["distilled spirit, like brandy"]}, {"entity_id": "ardent", "book_id": "polyanthea_medicinal", "name": "ardent", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["ardent"], "contexts": ["describes liquid used"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "agoa ardente", "target_book": "polyanthea_medicinal", "target_name": "ardent", "similarity": 0.862}], "id": 2088, "stable_key": "clu_5f4475b4870ba965", "ground_truth": {"modern_name": "brandy", "confidence": "high", "type": "chemical", "note": "Likely refers to distilled spirits like brandy or aguardiente.", "wikidata_id": "Q37264296", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Brandy%20%28surname%29"}}, {"canonical_name": "cosi", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cosi", "book_id": "coloquios_da_orta_1563", "name": "cosi", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["cosi"], "contexts": ["name given by some Arabs"]}, {"entity_id": "coſto", "book_id": "polyanthea_medicinal", "name": "coſto", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["coſto"], "contexts": ["costus root for confection"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "cosi", "target_book": "polyanthea_medicinal", "target_name": "coſto", "similarity": 0.848}], "id": 2089, "stable_key": "clu_f08bbc55bf2822ec", "ground_truth": {"modern_name": "Saussurea costus", "confidence": "high", "type": "plant", "linnaean": "Saussurea costus (Falc.) Lipsch.", "family": "Asteraceae", "wikidata_id": "Q72461560", "wikidata_description": "chemical compound"}}, {"canonical_name": "azimbro", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "azimbro", "book_id": "coloquios_da_orta_1563", "name": "azimbro", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["azimbro"], "contexts": ["tree compared to casto tree"]}, {"entity_id": "zimbro", "book_id": "polyanthea_medicinal", "name": "Zimbro", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Zimbro"], "contexts": ["juniper plant"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "azimbro", "target_book": "polyanthea_medicinal", "target_name": "Zimbro", "similarity": 0.878}], "id": 2090, "stable_key": "clu_4e390f733b711327", "ground_truth": {"modern_name": "Juniperus communis", "confidence": "high", "type": "plant", "linnaean": "Juniperus communis L.", "family": "Cupressaceae"}}, {"canonical_name": "unguento cetrino", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "unguento_cetrino", "book_id": "coloquios_da_orta_1563", "name": "unguento cetrino", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["unguento cetrino"], "contexts": ["ointment for women's ailments"]}, {"entity_id": "unguento_citrino", "book_id": "polyanthea_medicinal", "name": "unguento citrino", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["unguento citrino"], "contexts": ["citrine ointment"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "unguento cetrino", "target_book": "polyanthea_medicinal", "target_name": "unguento citrino", "similarity": 0.928}], "id": 2091, "stable_key": "clu_ed909b4329892024", "ground_truth": {"modern_name": "citrine ointment", "confidence": "high", "type": "object", "note": "The difference between 'cetrino' and 'citrino' is likely a scribal or printing variation."}}, {"canonical_name": "Apúlia", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "apúlia", "book_id": "coloquios_da_orta_1563", "name": "Apúlia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Apúlia"], "contexts": ["coastline infested by Turkish galleys"]}, {"entity_id": "apulia", "book_id": "polyanthea_medicinal", "name": "Apulia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Apulia"], "contexts": ["region where tarantulas are found"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Apúlia", "target_book": "polyanthea_medicinal", "target_name": "Apulia", "similarity": 0.924}], "id": 2092, "stable_key": "clu_82784772fd08c04e", "ground_truth": {"wikipedia_extract": "Apúlia is a town and a former civil parish in the municipality of Esposende, Portugal. In 2013, the parish merged into the new parish Apúlia e Fão. It has a population of 4,323 inhabitants and a total area of 10.51 km2, population density 411.3. It was a town and a municipality until 1834, when it was incorporated into Esposende. Apúlia is known for its dune beaches and Roman-style folk costumes. It may be related to the region of Apulia in Italy, and a possible migration from there during the Roman Empire."}}, {"canonical_name": "apothecas", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "apothecas", "book_id": "coloquios_da_orta_1563", "name": "apothecas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["apothecas"], "contexts": ["apothecaries' shops"]}, {"entity_id": "apoſento", "book_id": "polyanthea_medicinal", "name": "apoſento", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["apoſento"], "contexts": ["room"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "apothecas", "target_book": "polyanthea_medicinal", "target_name": "apoſento", "similarity": 0.901}], "id": 2093, "stable_key": "clu_c20727213f2b07fa", "ground_truth": {"modern_name": "apothecary's shop", "confidence": "high", "type": "place", "country": "Global", "note": "While 'apoſento' can mean room, in the context of apothecaries' shops, it refers to the space where medicines are prepared and sold."}}, {"canonical_name": "carminativas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "carminativas", "book_id": "coloquios_da_orta_1563", "name": "carminativas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["carminativas"], "contexts": ["medicinal property for gas"]}, {"entity_id": "carminativos", "book_id": "polyanthea_medicinal", "name": "Carminativos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Carminativos"], "contexts": ["medicines to dispel windiness"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "carminativas", "target_book": "polyanthea_medicinal", "target_name": "Carminativos", "similarity": 0.962}], "id": 2094, "stable_key": "clu_d7188c6ff1f374c7", "ground_truth": {"modern_name": "carminative", "confidence": "high", "type": "concept", "wikidata_id": "Q1734091", "wikidata_description": "herb or preparation intended to either prevent formation of gas in the gastrointestinal tract or facilitate the expulsion of said gas, thereby combatting flatulence"}}, {"canonical_name": "Ariena", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ariena", "book_id": "coloquios_da_orta_1563", "name": "Ariena", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Ariena"], "contexts": ["name of a fruit"]}, {"entity_id": "arneyra", "book_id": "polyanthea_medicinal", "name": "arneyra", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["arneyra"], "contexts": ["arnica for drying phlegm"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Ariena", "target_book": "polyanthea_medicinal", "target_name": "arneyra", "similarity": 0.859}], "id": 2095, "stable_key": "clu_481e1a46f8d3f69f", "ground_truth": {"modern_name": "Arnica", "confidence": "high", "type": "plant", "note": "The term 'ariena' appears to be a variation or misspelling of 'Arnica', especially given the context of medicinal use for drying phlegm. 'Arneyra' is likely a further phonetic corruption.", "wikidata_id": "Q207848", "wikidata_description": "species of European flowering plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Arnica%20montana"}}, {"canonical_name": "diurético", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "diurético", "book_id": "coloquios_da_orta_1563", "name": "diurético", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["diurético"], "contexts": ["medicinal property of 'folio indo'"]}, {"entity_id": "deuretico", "book_id": "polyanthea_medicinal", "name": "deuretico", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["deuretico"], "contexts": ["diuretic"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "diurético", "target_book": "polyanthea_medicinal", "target_name": "deuretico", "similarity": 0.9}], "id": 2096, "stable_key": "clu_9d408fa1648a9df7", "ground_truth": {"modern_name": "Diuretic", "confidence": "high", "type": "concept", "wikidata_id": "Q433885", "wikidata_description": "therapeutic subgroup of the Anatomical Therapeutic Chemical Classification System: Diuretics", "wikipedia_url": "https://en.wikipedia.org/wiki/ATC%20code%20C03"}}, {"canonical_name": "cominho rústico", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cominho_rústico", "book_id": "coloquios_da_orta_1563", "name": "cominho rústico", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["cominho rústico"], "contexts": ["description of ameos"]}, {"entity_id": "cominhos_rusticos", "book_id": "polyanthea_medicinal", "name": "cominhos rusticos", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["cominhos rusticos"], "contexts": ["ingredient in Papa Benedicto powder"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "cominho rústico", "target_book": "polyanthea_medicinal", "target_name": "cominhos rusticos", "similarity": 0.907}], "id": 2097, "stable_key": "clu_49fd0fc107c93df0", "ground_truth": {"modern_name": "Wild Cumin", "confidence": "medium", "type": "plant", "linnaean": "Cuminum cyminum", "family": "Apiaceae", "note": "The identification of 'cominho rústico' as Wild Cumin is based on the literal translation and context of it being a spice. However, early modern texts sometimes used local names for plants, and further textual analysis might be needed for absolute certainty."}}, {"canonical_name": "agua de ortelãa", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "agua_de_ortelãa", "book_id": "coloquios_da_orta_1563", "name": "agua de ortelãa", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["agua de ortelãa"], "contexts": ["mixture for vomiting and stomach weakness"]}, {"entity_id": "agua_deorjevão", "book_id": "polyanthea_medicinal", "name": "agua deOrjevão", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["agua deOrjevão"], "contexts": ["distilled remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "agua de ortelãa", "target_book": "polyanthea_medicinal", "target_name": "agua deOrjevão", "similarity": 0.892}], "id": 2098, "stable_key": "clu_2db934d8a0b5a704", "ground_truth": {"modern_name": "Mint Water", "confidence": "high", "type": "chemical", "note": "The phrase 'agua de ortelãa' directly translates to mint water. 'Agua de Orjevão' appears to be a corruption or variant spelling, possibly related to oregano or another herb, but 'mint water' is the most direct and plausible referent given the first term."}}, {"canonical_name": "aniurui", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "aniurui", "book_id": "coloquios_da_orta_1563", "name": "aniurui", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["aniurui"], "contexts": ["plant name"]}, {"entity_id": "aniſo", "book_id": "polyanthea_medicinal", "name": "aniſo", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["aniſo"], "contexts": ["herb used in dropsy treatment"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "aniurui", "target_book": "polyanthea_medicinal", "target_name": "aniſo", "similarity": 0.85}], "id": 2099, "stable_key": "clu_173b91c6d5b72a08", "ground_truth": {"modern_name": "Anise", "confidence": "high", "type": "plant", "linnaean": "Pimpinella anisum", "family": "Apiaceae", "note": "The term 'aniurui' is an unusual spelling, but 'aniſo' is a clear corruption of 'anis', meaning anise. The context of being a plant used in dropsy treatment aligns with known medicinal uses of anise.", "wikidata_id": "Q28692", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Anise"}}, {"canonical_name": "alcatifas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "alcatifas", "book_id": "coloquios_da_orta_1563", "name": "alcatifas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["alcatifas"], "contexts": ["items transported with lacre"]}, {"entity_id": "alfinetes", "book_id": "polyanthea_medicinal", "name": "alfinetes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["alfinetes"], "contexts": ["pins, objects that can be vomited"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "alcatifas", "target_book": "polyanthea_medicinal", "target_name": "alfinetes", "similarity": 0.889}], "id": 2100, "stable_key": "clu_46153c1939cfdf90", "ground_truth": {"modern_name": "Carpet", "confidence": "low", "type": "object", "note": "The term 'alcatifas' translates to carpets or rugs. However, the contrasting term 'alfinetes' (pins) suggests the context might be about small, distinct items. It's possible 'alcatifas' is a misreading or refers to something else entirely in this specific context, but a direct translation is carpets."}}, {"canonical_name": "Liliacea", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "liliacea", "book_id": "coloquios_da_orta_1563", "name": "Liliacea", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Liliacea"], "contexts": ["plant family of aloes"]}, {"entity_id": "lilijs", "book_id": "polyanthea_medicinal", "name": "Lilijs", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Lilijs"], "contexts": ["lilies"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Liliacea", "target_book": "polyanthea_medicinal", "target_name": "Lilijs", "similarity": 0.857}], "id": 2101, "stable_key": "clu_afe96127cce1175e", "ground_truth": {"modern_name": "Liliaceae", "confidence": "high", "type": "plant", "family": "Liliaceae", "note": "Liliacea is a direct reference to the plant family Liliaceae. 'Lilijs' is a clear, albeit slightly archaic, reference to lilies, which belong to this family.", "wikidata_id": "Q53480", "wikidata_description": "family of flowering plants in order Liliales, including lilies", "wikipedia_url": "https://en.wikipedia.org/wiki/Liliaceae"}}, {"canonical_name": "Alcobaça", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "alcobaça", "book_id": "coloquios_da_orta_1563", "name": "Alcobaça", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Alcobaça"], "contexts": ["library provenance"]}, {"entity_id": "coutos_de_alcobaça", "book_id": "polyanthea_medicinal", "name": "Coutos de Alcobaça", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Coutos de Alcobaça"], "contexts": ["jurisdiction of Alcobaça"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Alcobaça", "target_book": "polyanthea_medicinal", "target_name": "Coutos de Alcobaça", "similarity": 0.883}], "id": 2102, "stable_key": "clu_aa1850a9beb5ea63", "ground_truth": {"modern_name": "Alcobaça", "confidence": "high", "type": "place", "country": "Portugal", "note": "Alcobaça is a well-known town and municipality in Portugal, famous for its monastery. The reference to 'Coutos de Alcobaça' further solidifies this as a specific historical jurisdiction.", "wikidata_id": "Q4713216", "wikidata_description": "river in Portugal", "wikipedia_url": "https://en.wikipedia.org/wiki/Alcoba%C3%A7a_River_%28Portugal%29"}}, {"canonical_name": "Alfama", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "alfama", "book_id": "coloquios_da_orta_1563", "name": "Alfama", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Alfama"], "contexts": ["neighborhood in Lisbon"]}, {"entity_id": "alfamano", "book_id": "polyanthea_medicinal", "name": "Alfamano", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Alfamano"], "contexts": ["location of a street"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Alfama", "target_book": "polyanthea_medicinal", "target_name": "Alfamano", "similarity": 0.914}], "id": 2103, "stable_key": "clu_576eafe2f27e202e", "ground_truth": {"wikipedia_extract": "The Alfama (Portuguese pronunciation: [alˈfɐmɐ]) is the oldest neighborhood of Lisbon, spreading on the slope between the São Jorge Castle and the Tagus river. The district includes the freguesias (parishes) of São Miguel, Santo Estêvão, São Vicente de Fora and part of the two streets, \"Freguesia da Sé: Rua do Barão\" and \"Rua São João da Praça\". It contains many important historical attractions, as well as an abundance of Fado bars and restaurants. The name Alfama originates from the Arabic al-ḥamma (الحَمّة), meaning \"hot springs\". The Arabic word comes from the root meaning \"to heat\" or \"to become hot\", from which the word hammam (Arabic: حَمَّام, lit. 'bath, bathhouse') also derives. The Rua do Barão is one of the streets of the Freguesia da Sé, which begins at the Rua São João da Praça (where once stood the Door of the Alfama) and ends at Rua Augusto Rosa (at the Cathedral's walls)."}}, {"canonical_name": "concha", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "concha", "book_id": "coloquios_da_orta_1563", "name": "concha", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["concha"], "contexts": ["shell of the Turbinella pyrum"]}, {"entity_id": "conchas", "book_id": "polyanthea_medicinal", "name": "conchas", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["conchas"], "contexts": ["shells, protective coverings of mollusks"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "concha", "target_book": "polyanthea_medicinal", "target_name": "conchas", "similarity": 0.948}], "id": 2104, "stable_key": "clu_4ed066c313add6e7", "ground_truth": {"wikipedia_extract": "A concha (Spanish pronunciation: [ˈkontʃa], 'shell') is a traditional Mexican sweet bread (pan dulce) with similar consistency to a brioche. Conchas get their name from their round shape and their striped, seashell-like appearance. A concha consists of two parts: a sweetened bread roll, and a crunchy topping (composed of flour, butter, and sugar), the most common topping flavors being chocolate, vanilla, and strawberry. Conchas are commonly found throughout Mexico, Guatemala, and their diasporas in panaderias ('bakeries'). They can also be found in grocery stores and bakeries across the United States. The exact origin of the concha is unknown."}}, {"canonical_name": "frangam", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "frangam", "book_id": "coloquios_da_orta_1563", "name": "frangam", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["frangam"], "contexts": ["food made from grain"]}, {"entity_id": "franças", "book_id": "polyanthea_medicinal", "name": "franças", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["franças"], "contexts": ["plant used in decoction"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "frangam", "target_book": "polyanthea_medicinal", "target_name": "franças", "similarity": 0.865}], "id": 2105, "stable_key": "clu_185a61159384646f", "ground_truth": {"modern_name": null, "confidence": "high", "type": "food", "note": "The context 'food made from grain' strongly suggests frumenty, a dish made from boiled cracked wheat, especially when considering the spelling variations and the likely OCR errors in the original text.", "wikidata_id": "Q904018", "wikidata_description": "porridge of boiled grain in medieval Europe", "wikipedia_url": "https://en.wikipedia.org/wiki/Frumenty"}}, {"canonical_name": "fezes", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fezes", "book_id": "coloquios_da_orta_1563", "name": "fezes", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["fezes"], "contexts": ["illness treated by a plant"]}, {"entity_id": "fezes_ardentes", "book_id": "polyanthea_medicinal", "name": "fezes ardentes", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["fezes ardentes"], "contexts": ["burning fevers"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "fezes", "target_book": "polyanthea_medicinal", "target_name": "fezes ardentes", "similarity": 0.854}], "id": 2106, "stable_key": "clu_b2951ca7b1a3b649", "ground_truth": {"wikipedia_extract": "The fez (Turkish: fes, Ottoman Turkish: فس, romanized: fes), also called tarboosh/tarboush (Arabic: طربوش, romanized: ṭarbūš), is a felt headdress in the shape of a short, cylindrical, peakless hat, usually red, typically with a black tassel attached to the top. The name \"fez\" may refer to the Moroccan city of Fez, where the dye to color the hat was extracted from crimson berries. However, its origins are disputed. The modern fez owes much of its popularity to the Ottoman era. It became a symbol of the Ottoman Empire in the early 19th century. In 1827, Mahmud II mandated its use as a modern headdress for his new army, the Asakir-i Mansure-i Muhammediye."}}, {"canonical_name": "terra arménia", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "terra_arménia", "book_id": "coloquios_da_orta_1563", "name": "terra arménia", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["terra arménia"], "contexts": ["argillaceous earth used in medicine"]}, {"entity_id": "terra_armenia", "book_id": "polyanthea_medicinal", "name": "terra Armenia", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["terra Armenia"], "contexts": ["type of medicinal earth"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "terra arménia", "target_book": "polyanthea_medicinal", "target_name": "terra Armenia", "similarity": 0.937}], "id": 2107, "stable_key": "clu_8d1e2bb780282914", "ground_truth": {"modern_name": null, "confidence": "high", "type": "mineral", "wikidata_id": "Q891670", "wikidata_description": "natural mixture of hydrated silicate clays colored with red iron oxide", "wikipedia_url": "https://en.wikipedia.org/wiki/Armenian%20bole"}}, {"canonical_name": "fricção", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fricção", "book_id": "coloquios_da_orta_1563", "name": "fricção", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["fricção"], "contexts": ["action that electrizes diamonds"]}, {"entity_id": "frictiones", "book_id": "polyanthea_medicinal", "name": "frictiones", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["frictiones"], "contexts": ["treatment for Angina"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "fricção", "target_book": "polyanthea_medicinal", "target_name": "frictiones", "similarity": 0.976}], "id": 2108, "stable_key": "clu_9a38059f2e5057df", "ground_truth": {"modern_name": null, "confidence": "high", "type": "concept", "note": "The context 'action that electrizes diamonds' points to physical friction. While 'treatment for Angina' might suggest a therapeutic application of friction (like massage), the primary meaning here is the physical action.", "wikidata_id": "Q82580", "wikidata_description": "force resisting the relative motion of solid surfaces, fluid layers, and material elements sliding against each other", "wikipedia_url": "https://en.wikipedia.org/wiki/Friction"}}, {"canonical_name": "xaqueca velha", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "xaqueca_velha", "book_id": "coloquios_da_orta_1563", "name": "xaqueca velha", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["xaqueca velha"], "contexts": ["chronic migraine"]}, {"entity_id": "xaqueca", "book_id": "polyanthea_medicinal", "name": "xaqueca", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["xaqueca"], "contexts": ["migraine"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "xaqueca velha", "target_book": "polyanthea_medicinal", "target_name": "xaqueca", "similarity": 0.89}], "id": 2109, "stable_key": "clu_eafa2c94b9d46340", "ground_truth": {"modern_name": null, "confidence": "high", "type": "disease", "modern_term": "migraine", "note": "'Xaqueca velha' implies a chronic or established migraine. 'Xaqueca' itself directly translates to migraine.", "wikidata_id": "Q133823", "wikidata_description": "disorder resulting in recurrent moderate-severe headaches", "wikipedia_url": "https://en.wikipedia.org/wiki/Migraine"}}, {"canonical_name": "Rhewn", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "rhewn", "book_id": "coloquios_da_orta_1563", "name": "Rhewn", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Rhewn"], "contexts": ["plant species"]}, {"entity_id": "rheados", "book_id": "polyanthea_medicinal", "name": "Rheados", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Rheados"], "contexts": ["poppy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Rhewn", "target_book": "polyanthea_medicinal", "target_name": "Rheados", "similarity": 0.861}], "id": 2110, "stable_key": "clu_203b4bf8db3c839a", "ground_truth": {"modern_name": null, "confidence": "high", "type": "plant", "linnaean": "Papaver rhoeas Linnaeus", "family": "Papaveraceae", "note": "Both 'Rhewn' and 'Rheados' are variations pointing to the poppy genus. 'Papaver rhoeas' (Common Poppy) is a likely candidate for the specific species, given the context of medicinal use."}}, {"canonical_name": "ervas medicinaes", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ervas_medicinaes", "book_id": "coloquios_da_orta_1563", "name": "ervas medicinaes", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["ervas medicinaes"], "contexts": ["medicinal plants"]}, {"entity_id": "ervamedicinal", "book_id": "polyanthea_medicinal", "name": "ervamedicinal", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["ervamedicinal"], "contexts": ["ingredient for consolidants"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "ervas medicinaes", "target_book": "polyanthea_medicinal", "target_name": "ervamedicinal", "similarity": 0.905}], "id": 2111, "stable_key": "clu_de69eb29980d6052", "ground_truth": {"modern_name": null, "confidence": "high", "type": "plant", "note": "A direct translation of the terms provided.", "wikidata_id": "Q188840", "wikidata_description": "plants or derivatives used to treat medical conditions in humans or animals"}}, {"canonical_name": "infíisam", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "infíisam", "book_id": "coloquios_da_orta_1563", "name": "infíisam", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["infíisam"], "contexts": ["infusion of tamarindos"]}, {"entity_id": "inuftionem", "book_id": "polyanthea_medicinal", "name": "Inuftionem", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Inuftionem"], "contexts": ["medical procedure mentioned"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "infíisam", "target_book": "polyanthea_medicinal", "target_name": "Inuftionem", "similarity": 0.843}], "id": 2112, "stable_key": "clu_3aaba62e20a72ac5", "ground_truth": {"modern_name": null, "confidence": "high", "type": "concept", "note": "The terms refer to the process of steeping a substance (like tamarindos) in liquid to extract its properties. 'Inuftionem' is likely an OCR error for 'infusionem'.", "wikidata_id": "Q61951", "wikidata_description": "process of extracting chemical compounds or flavors from plant material in a solvent", "wikipedia_url": "https://en.wikipedia.org/wiki/Infusion"}}, {"canonical_name": "gomoso", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "gomoso", "book_id": "coloquios_da_orta_1563", "name": "gomoso", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["gomoso"], "contexts": ["quality of the turbith"]}, {"entity_id": "grumoſo", "book_id": "polyanthea_medicinal", "name": "grumoſo", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["grumoſo"], "contexts": ["grumous, thick, a quality of blood"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "gomoso", "target_book": "polyanthea_medicinal", "target_name": "grumoſo", "similarity": 0.852}], "id": 2113, "stable_key": "clu_154602b6b08f085f", "ground_truth": {"modern_name": null, "confidence": "high", "type": "concept", "note": "The context 'quality of the turbith' and 'grumous, thick, a quality of blood' points to the medical description of blood or other bodily fluids as being thick, clotted, or lumpy."}}, {"canonical_name": "campos", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "campos", "book_id": "coloquios_da_orta_1563", "name": "campos", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["campos"], "contexts": ["fields"]}, {"entity_id": "campo", "book_id": "polyanthea_medicinal", "name": "campo", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["campo"], "contexts": ["countryside"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "campos", "target_book": "polyanthea_medicinal", "target_name": "campo", "similarity": 0.954}], "id": 2114, "stable_key": "clu_6c3175d749eaee2e", "ground_truth": {"modern_name": "countryside", "confidence": "high", "type": "place", "country": "Portugal", "wikidata_id": "Q578447", "wikidata_description": "city in Cook County, Illinois, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Countryside%2C%20Illinois"}}, {"canonical_name": "Pico Mirandolano", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pico_mirandolano", "book_id": "coloquios_da_orta_1563", "name": "Pico Mirandolano", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Pico Mirandolano"], "contexts": ["author of Apologia, discussed Caidéa language"]}, {"entity_id": "picus_mirandulan_", "book_id": "polyanthea_medicinal", "name": "Picus Mirandulan.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Picus Mirandulan."], "contexts": ["early modern scholar cited for quote"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Pico Mirandolano", "target_book": "polyanthea_medicinal", "target_name": "Picus Mirandulan.", "similarity": 0.853}], "id": 2115, "stable_key": "clu_489e4f6c1e3a1c6c", "ground_truth": {"modern_name": "Pico della Mirandola", "confidence": "high", "type": "person", "birth_year": 1463, "death_year": 1494, "description": "Italian Renaissance philosopher and humanist, cited in early modern texts.", "wikidata_id": "Q182128", "wikidata_description": "Italian Renaissance philosopher (1463–1494)", "wikipedia_url": "https://en.wikipedia.org/wiki/Giovanni%20Pico%20della%20Mirandola"}}, {"canonical_name": "befoar", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "befoar", "book_id": "coloquios_da_orta_1563", "name": "befoar", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["befoar"], "contexts": ["intestinal calculus"]}, {"entity_id": "befoardic", "book_id": "polyanthea_medicinal", "name": "Befoardic", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Befoardic"], "contexts": ["a type of medicinal preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "befoar", "target_book": "polyanthea_medicinal", "target_name": "Befoardic", "similarity": 0.879}], "id": 2116, "stable_key": "clu_4c6f21546747f288", "ground_truth": {"modern_name": "intestinal calculus", "confidence": "medium", "type": "mineral", "note": "The term 'befoar' or 'bezoar' historically referred to a concretion found in the stomach of animals, often used medicinally. In this context, it is likely referring to intestinal calculus as a component or type of preparation."}}, {"canonical_name": "indigestam", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "indigestam", "book_id": "coloquios_da_orta_1563", "name": "indigestam", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["indigestam"], "contexts": ["difficulty digesting food"]}, {"entity_id": "inedia", "book_id": "polyanthea_medicinal", "name": "inedia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["inedia"], "contexts": ["lack of food, starvation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "indigestam", "target_book": "polyanthea_medicinal", "target_name": "inedia", "similarity": 0.848}], "id": 2117, "stable_key": "clu_7277ee1de9e431af", "ground_truth": {"modern_name": "indigestion", "confidence": "high", "type": "disease", "modern_term": "indigestion", "wikidata_id": "Q653971", "wikidata_description": "human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Indigestion"}}, {"canonical_name": "dragma", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dragma", "book_id": "coloquios_da_orta_1563", "name": "dragma", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["dragma"], "contexts": ["ingredient mixed with Raiz da china"]}, {"entity_id": "dragmas", "book_id": "polyanthea_medicinal", "name": "dragmas", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["dragmas"], "contexts": ["unit of measurement for substance"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "dragma", "target_book": "polyanthea_medicinal", "target_name": "dragmas", "similarity": 0.932}], "id": 2118, "stable_key": "clu_35e27cb8be451d5c", "ground_truth": {"modern_name": "drachma (unit of weight)", "confidence": "high", "type": "concept"}}, {"canonical_name": "A. Suma", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "a__suma", "book_id": "coloquios_da_orta_1563", "name": "A. Suma", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["A. Suma"], "contexts": ["plant mentioned in index"]}, {"entity_id": "suma", "book_id": "polyanthea_medicinal", "name": "suma", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["suma"], "contexts": ["plant material for treatment"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "A. Suma", "target_book": "polyanthea_medicinal", "target_name": "suma", "similarity": 0.871}], "id": 2119, "stable_key": "clu_1002c63c3b65ed3a", "ground_truth": {"modern_name": "Sumac", "confidence": "medium", "type": "plant", "note": "The specific species of 'Suma' is not clear from the context. 'A. Suma' might refer to a specific preparation or preparation type. Without further context, a precise Linnaean identification is not possible.", "wikidata_id": "Q157649", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Sumac", "wikipedia_extract": "Sumac or sumach ( S(H)OO-mak, UK also )—not to be confused with poison sumac—is any of the roughly 35 species of flowering plants in the genus Rhus (and related genera) of the cashew and mango tree family, Anacardiaceae. However, it is Rhus coriaria that is most commonly used for culinary purposes. Sumac is prized as a spice—especially in Iranian cuisine, and other Eastern cuisines—and used as a dye and holistic remedy. The plants grow in subtropical and temperate regions, on nearly every continent except Antarctica and South America. It holds cultural significance as a symbolic item on the Haft-sin table during Nowruz, the Persian New Year. Sumacs are dioecious shrubs and small trees that can reach a height of one to ten metres (3–33 ft)."}}, {"canonical_name": "pecegos", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pecegos", "book_id": "coloquios_da_orta_1563", "name": "pecegos", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["pecegos"], "contexts": ["peaches"]}, {"entity_id": "pecego", "book_id": "polyanthea_medicinal", "name": "pecego", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["pecego"], "contexts": ["type of fruit to avoid"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "pecegos", "target_book": "polyanthea_medicinal", "target_name": "pecego", "similarity": 0.966}], "id": 2120, "stable_key": "clu_a911a8066ec2cf02", "ground_truth": {"modern_name": "Peach", "confidence": "high", "type": "plant", "linnaean": "Prunus persica", "family": "Rosaceae", "wikidata_id": "Q13189", "wikidata_description": "species of fruit tree (for the fruit use Q13202263)", "wikipedia_url": "https://en.wikipedia.org/wiki/Peach", "wikipedia_extract": "The peach (Prunus persica) is a deciduous tree that bears edible juicy fruits with various characteristics. Most are simply called peaches, while the glossy-skinned, non-fuzzy varieties are called nectarines. Though from the same species, they are regarded commercially as different fruits. The tree is regarded as handsome and is planted in gardens for its springtime blooms in addition to fruit production. It is relatively short lived, usually not exceeding twenty years of age. Peaches were first domesticated and cultivated in China during the Neolithic period."}}, {"canonical_name": "abundância", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "abundância", "book_id": "coloquios_da_orta_1563", "name": "abundância", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["abundância"], "contexts": ["state of having plenty"]}, {"entity_id": "abundance", "book_id": "first_principles_spencer_1862", "name": "abundance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["abundance"], "contexts": ["large quantity"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "abundância", "target_book": "first_principles_spencer_1862", "target_name": "abundance", "similarity": 0.967}], "id": 2121, "stable_key": "clu_2220e5c797f23980", "ground_truth": {"modern_name": "abundance", "confidence": "high", "type": "concept", "wikidata_id": "Q336019", "wikidata_description": "ecological quantity", "wikipedia_url": "https://en.wikipedia.org/wiki/Abundance_%28ecology%29"}}, {"canonical_name": "Liguria", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "liguria", "book_id": "ricettario_fiorentino_1597", "name": "Liguria", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Liguria"], "contexts": ["region in Italy with noble herbs"]}, {"entity_id": "liguria", "book_id": "polyanthea_medicinal", "name": "Liguria", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Liguria"], "contexts": ["region in Italy"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Liguria", "target_book": "polyanthea_medicinal", "target_name": "Liguria", "similarity": 1.0}], "id": 2122, "stable_key": "clu_5efef44a79ce5fad", "ground_truth": {"wikipedia_extract": "Liguria ( lig-YOOR-ee-ə, Italian: [liˈɡuːrja]; Ligurian: Ligûria [liˈɡyːɾja]) is a region of north-western Italy; its capital is Genoa. Its territory is crossed by the Alps and the Apennines mountain range and is roughly coextensive with the former territory of the Republic of Genoa. Liguria is bordered by France (Provence-Alpes-Côte d'Azur) to the west, Piedmont to the north, and Emilia-Romagna and Tuscany to the east. It rests on the Ligurian Sea, and has a population of 1,509,908 as of 2025. The region is part of the Alps–Mediterranean Euroregion. The name Liguria predates Latin and is of obscure origin."}}, {"canonical_name": "chiara d'huouo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "chiara_d'huouo", "book_id": "ricettario_fiorentino_1597", "name": "chiara d'huouo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["chiara d'huouo"], "contexts": ["ingredient in sweetened alum"]}, {"entity_id": "ourinahe_crùa", "book_id": "polyanthea_medicinal", "name": "ourinahe crùa", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["ourinahe crùa"], "contexts": ["raw urine"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "chiara d'huouo", "target_book": "polyanthea_medicinal", "target_name": "ourinahe crùa", "similarity": 0.861}], "id": 2123, "stable_key": "clu_0aff4270e20be250", "ground_truth": {"modern_name": "Urine", "confidence": "high", "type": "chemical", "note": "The context 'ourinahe crùa' and 'raw urine' strongly suggests urine. 'Chiara d'huouo' is likely a less common or corrupted spelling, with 'chiara' potentially referring to clarity, and 'huouo' possibly related to 'ouo' (egg) or a misreading. However, the presence of urine as a medicinal substance in early modern texts is well-documented, especially for its supposed therapeutic properties.", "wikidata_id": "Q40924", "wikidata_description": "liquid by-product of metabolism in the bodies of many animals, produced by the kidneys", "wikipedia_url": "https://en.wikipedia.org/wiki/Urine"}}, {"canonical_name": "Libano", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "libano", "book_id": "ricettario_fiorentino_1597", "name": "Libano", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Libano"], "contexts": ["mountain where manna is generated"]}, {"entity_id": "lybia", "book_id": "polyanthea_medicinal", "name": "Lybia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Lybia"], "contexts": ["region in Africa"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Libano", "target_book": "polyanthea_medicinal", "target_name": "Lybia", "similarity": 0.899}], "id": 2124, "stable_key": "clu_aa3bfd90868d6d2e", "ground_truth": {"wikipedia_extract": "Líbano is a town and municipality in the Tolima department of Colombia. The population of the municipality was estimated at 36,231 as of 2020. Along with Honda, Líbano is the seat of the Roman Catholic Diocese of Líbano–Honda. Before the arrival of Europeans, the Panches, Pantagoras, Bledos, and Marquetones lived in the region. They were among the tribes most feared by the Muisca. Their society was an aristocratic hierarchy headed by a chief."}}, {"canonical_name": "nefpoie", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "nefpoie", "book_id": "ricettario_fiorentino_1597", "name": "nefpoie", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["nefpoie"], "contexts": ["medlar fruits"]}, {"entity_id": "nefperas", "book_id": "polyanthea_medicinal", "name": "nefperas", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["nefperas"], "contexts": ["fruit used in remedies"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "nefpoie", "target_book": "polyanthea_medicinal", "target_name": "nefperas", "similarity": 0.843}], "id": 2125, "stable_key": "clu_6e136c64c1d9eee2", "ground_truth": {"modern_name": "Medlar", "confidence": "high", "type": "plant", "linnaean": "Mespilus germanica Linnaeus", "family": "Rosaceae", "note": "'Nefpoie' and 'nefperas' are consistent with historical variations of the word for medlar, a fruit used medicinally. The context 'medlar fruits' solidifies this identification.", "wikidata_id": "Q2088434", "wikidata_description": "species of flowering plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Mimusops%20elengi"}}, {"canonical_name": "vernucolo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "vernucolo", "book_id": "ricettario_fiorentino_1597", "name": "vernucolo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["vernucolo"], "contexts": ["vermilion, a red pigment"]}, {"entity_id": "vernenos", "book_id": "polyanthea_medicinal", "name": "vernenos", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["vernenos"], "contexts": ["poisons"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "vernucolo", "target_book": "polyanthea_medicinal", "target_name": "vernenos", "similarity": 0.866}], "id": 2126, "stable_key": "clu_2ceafe575f487d99", "ground_truth": {"modern_name": "Vermilion", "confidence": "high", "type": "chemical", "note": "'Vernucolo' is a recognizable variant for vermilion, a red pigment (cinnabar, mercury sulfide) often used in early modern medicine and art. The context 'vermilion, a red pigment' and the association with poisons (as cinnabar can be toxic) fit well.", "wikidata_id": "Q37442765", "wikidata_description": "family name"}}, {"canonical_name": "faccheta", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "faccheta", "book_id": "ricettario_fiorentino_1597", "name": "faccheta", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["faccheta"], "contexts": ["sachets, a type of compound medicine"]}, {"entity_id": "faccharum_faturni", "book_id": "polyanthea_medicinal", "name": "faccharum faturni", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["faccharum faturni"], "contexts": ["ointment ingredient for hardness of spleen"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "faccheta", "target_book": "polyanthea_medicinal", "target_name": "faccharum faturni", "similarity": 0.852}], "id": 2127, "stable_key": "clu_a7fbdd7a1024e33b", "ground_truth": {"modern_name": "Sachet", "confidence": "high", "type": "object", "note": "'Faccheta' and 'faccharum faturni' are likely related to 'sachet' or 'sacchetto,' meaning a small bag or pouch, often containing medicinal herbs or compounds. The context 'sachets, a type of compound medicine' and 'ointment ingredient for hardness of spleen' (implying a topical preparation often in a sachet or poultice) support this.", "wikidata_id": "Q25114295", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Sachet%20%28surname%29"}}, {"canonical_name": "acetofa", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "acetofa", "book_id": "ricettario_fiorentino_1597", "name": "acetofa", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["acetofa"], "contexts": ["sour flavor"]}, {"entity_id": "aceſa", "book_id": "polyanthea_medicinal", "name": "aceſa", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["aceſa"], "contexts": ["acid"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "acetofa", "target_book": "polyanthea_medicinal", "target_name": "aceſa", "similarity": 0.856}], "id": 2128, "stable_key": "clu_fa8449203afeeeda", "ground_truth": {"modern_name": "Sourness", "confidence": "high", "type": "concept", "note": "'Acetofa' and 'aceſa' strongly suggest 'acid' or 'sourness,' derived from 'acetum' (vinegar). The context 'sour flavor | acid' directly points to this meaning.", "wikidata_id": "Q2795949", "wikidata_description": "one of ca 5 basic tastes", "wikipedia_url": "https://en.wikipedia.org/wiki/Sourness"}}, {"canonical_name": "montano", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "montano", "book_id": "ricettario_fiorentino_1597", "name": "montano", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["montano"], "contexts": ["herb, likely mountain calamint"]}, {"entity_id": "monte", "book_id": "polyanthea_medicinal", "name": "monte", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["monte"], "contexts": ["plant used in a powder for pleurisy"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "montano", "target_book": "polyanthea_medicinal", "target_name": "monte", "similarity": 0.843}], "id": 2129, "stable_key": "clu_378a7cdb3e1d770e", "ground_truth": {"wikipedia_extract": "Montano in Italian, both Montano and Montaño in Spanish, is a surname. Aldo Montano (fencer born 1910), Italian fencer Aldo Montano (fencer born 1978), Italian fencer and grandson of the above fencer Alicia Gómez Montano (1955–2020), Spanish journalist Mario Aldo Montano, Italian fencer and son of the fencer born in 1910 Cesar Montano, multi-awarded Filipino actor and film director Justiniano Montano (1905–2005), Filipino politician Linda Montano, American contemporary feminist performance artist Machel Montano (born 1974), Trinidad and Tobago soca singer, record producer and songwriter Mark Montano, American interior designer, artist, writer and TV personality Severino Montano (1915–1980), Filipino playwright, writer, director and actor Benito Arias Montano (1527–1598) (not Montaño), Spanish orientalist Also a governor and a soldier of the same name and same period es:Montano (desambiguación) rarer Spanish surnames as Montano, no ñ."}}, {"canonical_name": "Falattouaroc", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "falattouaroc", "book_id": "ricettario_fiorentino_1597", "name": "Falattouaroc", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Falattouaroc"], "contexts": ["preparation used in compound medicine"]}, {"entity_id": "faldotartaro", "book_id": "polyanthea_medicinal", "name": "faldotartaro", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["faldotartaro"], "contexts": ["tartar dissolved in wine"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Falattouaroc", "target_book": "polyanthea_medicinal", "target_name": "faldotartaro", "similarity": 0.873}], "id": 2130, "stable_key": "clu_3f552a2d44bac73b", "ground_truth": {"modern_name": "Tartar preparation", "confidence": "high", "type": "chemical", "note": "'Falattouaroc' and 'faldotartaro' are clearly related to tartar, a deposit formed in wine casks. The context 'preparation used in compound medicine | tartar dissolved in wine' confirms this. The exact nature of the preparation might vary, but 'tartar' is the core ingredient.", "wikidata_id": "Q2268790", "wikidata_description": "city in Tartar, Azerbaijan. District center", "wikipedia_url": "https://en.wikipedia.org/wiki/Tartar_%28city%29"}}, {"canonical_name": "Gentile da Fultgno", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "gentile_da_fultgno", "book_id": "ricettario_fiorentino_1597", "name": "Gentile da Fultgno", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Gentile da Fultgno"], "contexts": ["author cited for preparation"]}, {"entity_id": "gentilis_de_fulginat", "book_id": "polyanthea_medicinal", "name": "Gentilis de Fulginat", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Gentilis de Fulginat"], "contexts": ["author of medical consultations"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Gentile da Fultgno", "target_book": "polyanthea_medicinal", "target_name": "Gentilis de Fulginat", "similarity": 0.906}], "id": 2131, "stable_key": "clu_bf262b7d233f237e", "ground_truth": {"modern_name": "Gentile da Foligno", "confidence": "high", "type": "person", "birth_year": 1280, "death_year": 1348, "description": "Italian physician and medical writer, influential in scholastic medicine."}}, {"canonical_name": "Urna boccia", "category": "OBJECT", "subcategory": "VESSEL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "urna_boccia", "book_id": "ricettario_fiorentino_1597", "name": "Urna boccia", "category": "OBJECT", "subcategory": "VESSEL", "count": 1, "variants": ["Urna boccia"], "contexts": ["container for preparations"]}, {"entity_id": "urnas", "book_id": "polyanthea_medicinal", "name": "urnas", "category": "OBJECT", "subcategory": "VESSEL", "count": 1, "variants": ["urnas"], "contexts": ["containers for ashes"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Urna boccia", "target_book": "polyanthea_medicinal", "target_name": "urnas", "similarity": 0.866}], "id": 2132, "stable_key": "clu_b81c27d2f29e7f99", "ground_truth": {"modern_name": "Jar", "confidence": "high", "type": "object", "note": "'Urna boccia' and 'urnas' both refer to containers. 'Urna' implies an urn or jar, and 'boccia' can mean bottle or pot. The context 'container for preparations | containers for ashes' reinforces this, suggesting vessels used for storing or preparing substances.", "wikidata_id": "Q999961", "wikidata_description": "town in Náchod District, Hradec Králové Region, Czech Republic", "wikipedia_url": "https://en.wikipedia.org/wiki/Jarom%C4%9B%C5%99"}}, {"canonical_name": "fufione", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fufione", "book_id": "ricettario_fiorentino_1597", "name": "fufione", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["fufione"], "contexts": ["infusion process"]}, {"entity_id": "fufpende", "book_id": "polyanthea_medicinal", "name": "fufpende", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["fufpende"], "contexts": ["suspending property"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "fufione", "target_book": "polyanthea_medicinal", "target_name": "fufpende", "similarity": 0.894}], "id": 2133, "stable_key": "clu_d95e4e80d08a15c0", "ground_truth": {"modern_name": "infusion", "confidence": "high", "type": "concept", "note": "The early modern terms suggest a process of steeping or soaking, consistent with the modern concept of infusion.", "wikidata_id": "Q61951", "wikidata_description": "process of extracting chemical compounds or flavors from plant material in a solvent", "wikipedia_url": "https://en.wikipedia.org/wiki/Infusion"}}, {"canonical_name": "Elifsire", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "elifsire", "book_id": "ricettario_fiorentino_1597", "name": "Elifsire", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Elifsire"], "contexts": ["distilled substance"]}, {"entity_id": "eflibio", "book_id": "polyanthea_medicinal", "name": "Eflibio", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Eflibio"], "contexts": ["excellent remedy"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Elifsire", "target_book": "polyanthea_medicinal", "target_name": "Eflibio", "similarity": 0.842}], "id": 2134, "stable_key": "clu_1bd6c1c11acb6111", "ground_truth": {"modern_name": "distilled spirit", "confidence": "high", "type": "chemical", "note": "The context of 'distilled substance' strongly points to a distilled spirit or essence.", "wikidata_id": "Q56139", "wikidata_description": "alcoholic drink obtained by distillation", "wikipedia_url": "https://en.wikipedia.org/wiki/Liquor"}}, {"canonical_name": "Impiaftro di formento", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "impiaftro_di_formento", "book_id": "ricettario_fiorentino_1597", "name": "Impiaftro di formento", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Impiaftro di formento"], "contexts": ["medicinal preparation"]}, {"entity_id": "formento", "book_id": "polyanthea_medicinal", "name": "formento", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["formento"], "contexts": ["ingredient in a suspensory"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Impiaftro di formento", "target_book": "polyanthea_medicinal", "target_name": "formento", "similarity": 0.85}], "id": 2135, "stable_key": "clu_520fc81cb7a1ba21", "ground_truth": {"modern_name": "poultice", "confidence": "high", "type": "concept", "note": "The term 'Impiaftro di formento' (plaster of wheat) and its use as an ingredient in a 'suspensory' (likely a plaster or bandage) aligns with the concept of a poultice.", "wikidata_id": "Q58775464", "wikidata_description": "February 1887 scholarly article in The Hospital"}}, {"canonical_name": "Orlo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "orlo", "book_id": "ricettario_fiorentino_1597", "name": "Orlo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Orlo"], "contexts": ["mentioned with come fi purghi"]}, {"entity_id": "orvalho", "book_id": "polyanthea_medicinal", "name": "orvalho", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["orvalho"], "contexts": ["dew"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Orlo", "target_book": "polyanthea_medicinal", "target_name": "orvalho", "similarity": 0.875}], "id": 2136, "stable_key": "clu_2ceba69bba3b58f7", "ground_truth": {"wikipedia_extract": "The Jackson Automobile Company was an American Brass Era automobile manufacturer located in and named for Jackson, Michigan. The company produced the Jackson from 1903 to 1923, the 1903 Jaxon steam car and the 1904 Orlo. Byron J. Carter operated a steam driven press and was a rubber stamp manufacturer. In 1894 Carter went into a partnership with his father selling bicycles. By 1899 he built his first gasoline automobile but focused on steam cars."}}, {"canonical_name": "Anatricela", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "anatricela", "book_id": "ricettario_fiorentino_1597", "name": "Anatricela", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Anatricela"], "contexts": ["register or roll"]}, {"entity_id": "anatron", "book_id": "polyanthea_medicinal", "name": "Anatron", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Anatron"], "contexts": ["name given by Nicolao Lemero"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Anatricela", "target_book": "polyanthea_medicinal", "target_name": "Anatron", "similarity": 0.857}], "id": 2137, "stable_key": "clu_d2471b2254af8301", "ground_truth": {"modern_name": "scroll", "confidence": "medium", "type": "object", "note": "The descriptions 'register or roll' and a name given by 'Nicolao Lemero' suggest a scroll or a similar rolled document. 'Anatricela' and 'Anatron' are not standard terms, indicating potential dialectal or early orthographic variation.", "wikidata_id": "Q181319", "wikidata_description": "process of sliding text or images across a display (in any direction)", "wikipedia_url": "https://en.wikipedia.org/wiki/Scrolling"}}, {"canonical_name": "aurinetra", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "aurinetra", "book_id": "ricettario_fiorentino_1597", "name": "aurinetra", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["aurinetra"], "contexts": ["a tool for grinding seeds"]}, {"entity_id": "auriol", "book_id": "connexion_physical_sciences_somerville_1858", "name": "auriol", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["auriol"], "contexts": ["ring of light around an image"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "aurinetra", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "auriol", "similarity": 0.89}], "id": 2138, "stable_key": "clu_f6b4be9d484b0a07", "ground_truth": {"modern_name": "mortar and pestle", "confidence": "medium", "type": "object", "note": "While 'aurinetra' and 'auriol' are obscure, the context of 'a tool for grinding seeds' points to a mortar and pestle. The 'ring of light' connection is likely a metaphorical or extended use of the term in a different context."}}, {"canonical_name": "Templo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "templo", "book_id": "polyanthea_medicinal", "name": "Templo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Templo"], "contexts": ["place of worship"]}, {"entity_id": "the_temple", "book_id": "first_principles_spencer_1862", "name": "the Temple", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["the Temple"], "contexts": ["area with lawyers"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Templo", "target_book": "first_principles_spencer_1862", "target_name": "the Temple", "similarity": 0.944}], "id": 2139, "