source_book": "relation_historique_humboldt_vol3_1825", "source_name": "humors", "target_book": "kosmos_humboldt_1845", "target_name": "humoral theory", "similarity": 0.969}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "humors", "target_book": "historia_medicinal_monardes_1574", "target_name": "humoral theory", "similarity": 0.969}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "humors", "target_book": "coloquios_da_orta_1563", "target_name": "humoral theory", "similarity": 0.969}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "humors", "target_book": "ricettario_fiorentino_1597", "target_name": "Humoral theory", "similarity": 0.94}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "humors", "target_book": "ricettario_fiorentino_1597", "target_name": "humorc", "similarity": 0.942}, {"source_book": "kosmos_humboldt_1845", "source_name": "humoral theory", "target_book": "historia_medicinal_monardes_1574", "target_name": "humoral theory", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "humoral theory", "target_book": "coloquios_da_orta_1563", "target_name": "humoral theory", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "humoral theory", "target_book": "ricettario_fiorentino_1597", "target_name": "Humoral theory", "similarity": 0.972}, {"source_book": "kosmos_humboldt_1845", "source_name": "humoral theory", "target_book": "ricettario_fiorentino_1597", "target_name": "humorc", "similarity": 0.946}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "humoral theory", "target_book": "coloquios_da_orta_1563", "target_name": "humoral theory", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "humoral theory", "target_book": "ricettario_fiorentino_1597", "target_name": "Humoral theory", "similarity": 0.972}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "humoral theory", "target_book": "ricettario_fiorentino_1597", "target_name": "humorc", "similarity": 0.946}, {"source_book": "coloquios_da_orta_1563", "source_name": "humoral theory", "target_book": "ricettario_fiorentino_1597", "target_name": "Humoral theory", "similarity": 0.972}, {"source_book": "coloquios_da_orta_1563", "source_name": "humoral theory", "target_book": "ricettario_fiorentino_1597", "target_name": "humorc", "similarity": 0.946}], "id": 11, "stable_key": "clu_cb377b0c332a9945", "ground_truth": {"modern_name": "humoral theory", "confidence": "high", "type": "concept", "description": "A medical theory explaining health based on bodily fluids (humors).", "wikipedia_extract": "Humorism, the humoral theory, or humoralism, was a system of medicine detailing a supposed makeup and workings of the human body, adopted by Ancient Greek and Roman physicians and philosophers. Humorism began to fall out of favor in the 17th century and it was definitively disproved with the discovery of microbes. The concept of \"humors\" may have origins in Ancient Egyptian medicine, or Mesopotamia, though it was not systemized until ancient Greek thinkers. The word humor is a translation of Greek χυμός, chymos (literally 'juice' or 'sap', metaphorically 'flavor'). Early texts on Indian Ayurveda medicine presented a theory of three or four humors (doṣas), which they sometimes linked with the five elements (pañca-bhūta): earth, water, fire, air, and space. The concept of \"humors\" (chemical systems regulating human behaviour) became more prominent from the writing of medical theorist Alcmaeon of Croton (c. 540–500 BC)."}}, {"canonical_name": "Roma", "category": "PLACE", "subcategory": "CITY", "book_count": 8, "total_mentions": 57, "members": [{"entity_id": "roma", "book_id": "coloquios_da_orta_1563", "name": "Roma", "category": "PLACE", "subcategory": "CITY", "count": 10, "variants": ["Roma"], "contexts": ["city, left to the Pope", "city where Mascarenhas was ambassador"]}, {"entity_id": "rome", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Rome", "category": "PLACE", "subcategory": "CITY", "count": 8, "variants": ["Rome"], "contexts": ["city with a secret name", "ancient city"]}, {"entity_id": "rome", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rome", "category": "PLACE", "subcategory": "CITY", "count": 9, "variants": ["Rome"], "contexts": ["city on the Mohawk river", "city with latitude and temperature data"]}, {"entity_id": "romano", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Romano", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Romano"], "contexts": ["cay adjacent to Cuba"]}, {"entity_id": "rome", "book_id": "kosmos_humboldt_1845", "name": "Rome", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Rome"], "contexts": ["location where Vico saw satellites", "city where Chigi Library is located"]}, {"entity_id": "roma", "book_id": "historia_medicinal_monardes_1574", "name": "Roma", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Roma"], "contexts": ["city where the resin was first brought", "city where water chilling is customary"]}, {"entity_id": "impero_romano", "book_id": "ricettario_fiorentino_1597", "name": "Impero Romano", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Impero Romano"], "contexts": ["Roman Empire"]}, {"entity_id": "roma", "book_id": "ricettario_fiorentino_1597", "name": "Roma", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Roma"], "contexts": ["city with good river water"]}, {"entity_id": "roma", "book_id": "polyanthea_medicinal", "name": "Roma", "category": "PLACE", "subcategory": "CITY", "count": 9, "variants": ["Roma", "Roſma", "roma"], "contexts": ["ancient empire and center of power", "city in Italy"]}, {"entity_id": "romaa", "book_id": "polyanthea_medicinal", "name": "Romaa", "category": "PLACE", "subcategory": "OTHER_PLACE",