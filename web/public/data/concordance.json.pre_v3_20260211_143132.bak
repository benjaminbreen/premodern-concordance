source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Serapis", "target_book": "ricettario_fiorentino_1597", "target_name": "Serapione", "similarity": 0.893}, {"source_book": "english_physician_1652", "source_name": "Serapio", "target_book": "historia_medicinal_monardes_1574", "target_name": "Serafio", "similarity": 0.843}, {"source_book": "english_physician_1652", "source_name": "Serapio", "target_book": "ricettario_fiorentino_1597", "target_name": "Serapione", "similarity": 0.939}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Serafio", "target_book": "ricettario_fiorentino_1597", "target_name": "Serapione", "similarity": 0.832}], "id": 56, "stable_key": "clu_3f0a2c029ecd8e64", "ground_truth": {"modern_name": "Serapion of Alexandria", "confidence": "high", "type": "person", "description": "Ancient physician and pharmacologist.", "note": "Refers to Serapion the Younger, a medical writer.", "wikipedia_extract": "Serapion of Alexandria (Ancient Greek: Σεραπίων ὁ Ἀλεξανδρεύς) was a physician who lived in the 3rd century BC. He belonged to the Empiric school, and so much extended and improved the system of Philinus of Cos, that the creation of the school is attributed to him by some ancient writers. Serapion wrote against Hippocrates with much vehemence, but neither this, nor any of his other works, have survived. He is several times mentioned by Celsus, Galen, Caelius Aurelianus, Aëtius, Paulus Aegineta, and Nicolaus Myrepsus. This article incorporates text from a publication now in the public domain: Smith, William, ed. (1870). Dictionary of Greek and Roman Biography and Mythology."}}, {"canonical_name": "Swellings", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 5, "total_mentions": 96, "members": [{"entity_id": "swellings", "book_id": "english_physician_1652", "name": "Swellings", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 69, "variants": ["Swellings", "Swelings", "Swelling", "Swellings of the Spleen", "Swel∣lings", "Swounings", "Swou∣nings", "sweatings", "swelling", "swellings", "swellings of the Spleen", "swel∣lings", "swounings"], "contexts": ["condition treated by Alder-Tree leaves", "condition treated by Angelica"]}, {"entity_id": "swelling", "book_id": "principles_of_psychology_james_1890", "name": "swelling", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["swelling"], "contexts": ["enlargement of body part"]}, {"entity_id": "swelling", "book_id": "coloquios_da_orta_1563", "name": "swelling", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["swelling"], "contexts": ["abnormal enlargement of body part"]}, {"entity_id": "swelling", "book_id": "ricettario_fiorentino_1597", "name": "Swelling", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["Swelling"], "contexts": ["enlargement of body part"]}, {"entity_id": "swelling", "book_id": "polyanthea_medicinal", "name": "swelling", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 24, "variants": ["swelling", "Swelling"], "contexts": ["a common symptom", "enlargement of a body part"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Swellings", "target_book": "principles_of_psychology_james_1890", "target_name": "swelling", "similarity": 0.937}, {"source_book": "english_physician_1652", "source_name": "Swellings", "target_book": "coloquios_da_orta_1563", "target_name": "swelling", "similarity": 0.937}, {"source_book": "english_physician_1652", "source_name": "Swellings", "target_book": "ricettario_fiorentino_1597", "target_name": "Swelling", "similarity": 0.97}, {"source_book": "english_physician_1652", "source_name": "Swellings", "target_book": "polyanthea_medicinal", "target_name": "swelling", "similarity": 0.937}, {"source_book": "principles_of_psychology_james_1890", "source_name": "swelling", "target_book": "coloquios_da_orta_1563", "target_name": "swelling", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "swelling", "target_book": "ricettario_fiorentino_1597", "target_name": "Swelling", "similarity": 0.95}, {"source_book": "principles_of_psychology_james_1890", "source_name": "swelling", "target_book": "polyanthea_medicinal", "target_name": "swelling", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "swelling", "target_book": "ricettario_fiorentino_1597", "target_name": "Swelling", "similarity": 0.95}, {"source_book": "coloquios_da_orta_1563", "source_name": "swelling", "target_book": "polyanthea_medicinal", "target_name": "swelling", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Swelling", "target_book": "polyanthea_medicinal", "target_name": "swelling", "similarity": 0.95}], "id": 57, "stable_key": "clu_8bdd4412517edf49", "ground_truth": {"modern_name": "Swelling", "confidence": "high", "type": "disease", "description": "Abnormal enlargement or puffiness of a body part.", "note": "A common symptom of various conditions.", "wikipedia_extract": "Edema (American English), also spelled oedema (Commonwealth English), and also known as fluid retention, swelling, dropsy and hydropsy, is the build-up of fluid in the body's tissue. Most commonly, the legs or arms are affected. Symptoms may include skin that feels tight, the area feeling heavy, and joint stiffness. Other symptoms depend on the underlying cause. Causes may include venous insufficiency, heart failure, kidney problems, low protein levels, liver problems, deep vein thrombosis, infections, kwashiorkor, angioedema, certain medications, and lymphedema. It may also occur in immobile patients (stroke, spinal cord injury, aging), or with temporary immobility such as prolonged sitting or standing, and during menstruation or pregnancy."}}, {"canonical_name": "Mississipi", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 5, "total_mentions": 89, "members": [{"entity_id": "mississipi", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mississipi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 81, "variants": ["Mississipi", "Bas-Mississipi", "Misjijsippi", "Misjijslpi", "Mississiïi", "Misslssipi", "Missouri", "Mitsissipi"], "contexts": ["western boundary of the United States", "river for territory limits"]}, {"entity_id": "mississippi", "book_id": "origin_of_species_darwin_1859", "name": "Mississippi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Mississippi"], "contexts": ["river mouth where sediment accumulates", "rate of deposition at mouth"]}, {"entity_id": "territoire_du_mississipi", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Territoire du Mississipi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Territoire du Mississipi"], "contexts": ["historical territory in the United States"]}, {"entity_id": "mississippi", "book_id": "principles_of_psychology_james_1890", "name": "Mississippi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Mississippi"], "contexts": ["river used in an analogy for urine measurement"]}, {"entity_id": "mississippi", "book_id": "kosmos_humboldt_1845", "name": "Mississippi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Mississippi"], "contexts": ["river valley", "river mouth with drift-wood"]}, {"entity_id": "mississippi", "book_id": "first_principles_spencer_1862", "name": "Mississippi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Mississippi"], "contexts": ["great river with trees held by current", "river mouth with sinking strata"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mississipi", "target_book": "origin_of_species_darwin_1859", "target_name": "Mississippi", "similarity": 0.925}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mississipi", "target_book": "princi