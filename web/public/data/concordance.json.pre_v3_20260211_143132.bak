_spencer_1862", "target_name": "storm", "similarity": 0.888}, {"source_book": "kosmos_humboldt_1845", "source_name": "storm", "target_book": "polyanthea_medicinal", "target_name": "tormenta", "similarity": 0.923}, {"source_book": "kosmos_humboldt_1845", "source_name": "storm", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "storm", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "storm", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "thunderstorms", "similarity": 0.915}, {"source_book": "kosmos_humboldt_1845", "source_name": "storm", "target_book": "first_principles_spencer_1862", "target_name": "storm", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "electric storms", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "storm", "similarity": 0.865}, {"source_book": "kosmos_humboldt_1845", "source_name": "electric storms", "target_book": "first_principles_spencer_1862", "target_name": "storm", "similarity": 0.865}, {"source_book": "kosmos_humboldt_1845", "source_name": "Storms, magnetic", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "storm", "similarity": 0.852}, {"source_book": "kosmos_humboldt_1845", "source_name": "Storms, magnetic", "target_book": "first_principles_spencer_1862", "target_name": "storm", "similarity": 0.852}, {"source_book": "polyanthea_medicinal", "source_name": "tormenta", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "storm", "similarity": 0.923}, {"source_book": "polyanthea_medicinal", "source_name": "tormenta", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "thunderstorms", "similarity": 0.89}, {"source_book": "polyanthea_medicinal", "source_name": "tormenta", "target_book": "first_principles_spencer_1862", "target_name": "storm", "similarity": 0.923}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "storm", "target_book": "first_principles_spencer_1862", "target_name": "storm", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "thunderstorms", "target_book": "first_principles_spencer_1862", "target_name": "storm", "similarity": 0.915}], "id": 81, "stable_key": "clu_e31a21fb7de0a559", "ground_truth": {"modern_name": "weather events", "confidence": "high", "type": "concept", "note": "The term 'storms' in early modern texts, especially in contexts like Humboldt's 'Kosmos', refers to natural meteorological phenomena rather than diseases. 'Magnetic storms' refers to geomagnetic disturbances.", "wikidata_id": "Q130240049", "wikidata_description": "", "wikipedia_url": "https://en.wikipedia.org/wiki/Weather%20events%20during%20wars", "wikipedia_extract": "A storm is any disturbed state of the natural environment or the atmosphere of an astronomical body. It may be marked by significant disruptions to normal conditions such as strong wind, tornadoes, hail, thunder and lightning (a thunderstorm), heavy precipitation (snowstorm, rainstorm), heavy freezing rain (ice storm), strong winds (tropical cyclone, windstorm), wind transporting some substance through the atmosphere such as in a dust storm, among other forms of severe weather. Storms have the potential to harm lives and property via storm surge, heavy rain or snow causing flooding or road impassibility, lightning, wildfires, and vertical and horizontal wind shear. Systems with significant rainfall and duration help alleviate drought in places they move through. Heavy snowfall can allow special recreational activities to take place which would not be possible otherwise, such as skiing and snowmobiling. The English word comes from Proto-Germanic sturmaz meaning \"noise, tumult\"; a synonym is tempest, of French origin."}}, {"canonical_name": "experiment", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 5, "total_mentions": 14, "members":