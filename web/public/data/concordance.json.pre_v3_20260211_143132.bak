8}, {"source_book": "english_physician_1652", "source_name": "pains of the Gout", "target_book": "polyanthea_medicinal", "target_name": "Gout", "similarity": 0.851}, {"source_book": "principles_of_psychology_james_1890", "source_name": "gout", "target_book": "coloquios_da_orta_1563", "target_name": "gotta", "similarity": 0.905}, {"source_book": "principles_of_psychology_james_1890", "source_name": "gout", "target_book": "polyanthea_medicinal", "target_name": "Gout", "similarity": 0.979}, {"source_book": "principles_of_psychology_james_1890", "source_name": "gout", "target_book": "first_principles_spencer_1862", "target_name": "gouty", "similarity": 0.851}, {"source_book": "coloquios_da_orta_1563", "source_name": "gotta", "target_book": "polyanthea_medicinal", "target_name": "Gout", "similarity": 0.909}, {"source_book": "coloquios_da_orta_1563", "source_name": "gotta", "target_book": "first_principles_spencer_1862", "target_name": "gouty", "similarity": 0.851}, {"source_book": "polyanthea_medicinal", "source_name": "Gout", "target_book": "first_principles_spencer_1862", "target_name": "gouty", "similarity": 0.869}], "id": 34, "stable_key": "clu_342c16b447494be0", "ground_truth": {"modern_name": "Gout", "confidence": "high", "type": "disease", "description": "A metabolic disease causing joint inflammation.", "note": "Encompasses common and hip-related gout in historical texts.", "wikipedia_extract": "Gout ( GOWT) is a form of inflammatory arthritis characterized by recurrent attacks of pain in a red, tender, hot, and swollen joint, caused by the deposition of needle-shaped crystals of the monosodium salt of uric acid. Pain typically comes on rapidly, reaching maximal intensity in less than 12 hours. In about half of cases, the joint at the base of the big toe is affected (Podagra). It may also result in tophi, kidney stones, or kidney damage. Gout is due to persistently elevated levels of uric acid (urate) in the blood (hyperuricemia). This occurs from a combination of diet, other health problems, and genetic factors."}}, {"canonical_name": "Paralyticos", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 6, "total_mentions": 61, "members": [{"entity_id": "paralyticos", "book_id": "polyanthea_medicinal", "name": "Paralyticos", "category": "DISEASE", "subcategory": "CHRONIC", "count": 47, "variants": ["Paralyticos", "Paralas.", "Paralefia", "Paralexie", "Paralisias", "Paralyfim", "Paralyfimagnas", "Paralyfipodicis", "Paralymuyto", "Paralysi podicis", "Paralysias", "Paralysies", "Paralyſi", "Paralyſi fpur", "nervos paralyticos", "paralefia", "paralisias", "paralyfes", "paralyfi", "paralyfim", "paralyses", "paralysia", "paralysim", "paralytica", "paralyticarem", "paralyticas", "paralytico", "paralyticos", "partes paralyticas"], "contexts": ["paralysis treated by stibium", "paralyzed limbs"]}, {"entity_id": "paralisis", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Paralisis", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["Paralisis"], "contexts": ["medical condition involving loss of function"]}, {"entity_id": "paralysis", "book_id": "principles_of_psychology_james_1890", "name": "paralysis", "category": "DISEASE", "subcategory": "CHRONIC", "count": 6, "variants": ["paralysis"], "contexts": ["loss of muscle function", "inability to move body parts"]}, {"entity_id": "paralytic_dementia", "book_id": "principles_of_psychology_james_1890", "name": "paralytic dementia", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["paralytic dementia"], "contexts": ["cognitive decline with paralysis"]}, {"entity_id": "paraliticos", "book_id": "historia_medicinal_monardes_1574", "name": "paraliticos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["paraliticos"], "contexts": ["condition caused by coldness"]}, {"entity_id": "paraliticos", "book_id": "coloquios_da_orta_1563", "name": "paraliticos", "category": "DISEASE", "subcategory": "OTHER_DI