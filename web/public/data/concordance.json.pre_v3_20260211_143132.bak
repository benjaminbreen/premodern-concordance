milarity": 0.877}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "royaume de Pologne", "target_book": "polyanthea_medicinal", "target_name": "Polonia", "similarity": 0.856}, {"source_book": "kosmos_humboldt_1845", "source_name": "Poland", "target_book": "coloquios_da_orta_1563", "target_name": "Polónia", "similarity": 0.941}, {"source_book": "kosmos_humboldt_1845", "source_name": "Poland", "target_book": "polyanthea_medicinal", "target_name": "Polonia", "similarity": 0.976}, {"source_book": "coloquios_da_orta_1563", "source_name": "Polónia", "target_book": "polyanthea_medicinal", "target_name": "Polonia", "similarity": 0.931}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bologne", "target_book": "kosmos_humboldt_1845", "target_name": "Bologna", "similarity": 0.916}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bologne", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bologna", "similarity": 0.916}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bologna", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bologna", "similarity": 1.0}], "id": 83, "stable_key": "clu_f0e3fd005dd9b7d9", "ground_truth": {"modern_name": "Poland", "confidence": "high", "type": "place", "description": "European country, historical kingdom and later part of Russian Empire.", "wikipedia_extract": "Poland, officially the Republic of Poland, is a country in Central Europe. It extends from the Baltic Sea in the north to the Sudetes and Carpathian Mountains in the south. Poland borders Kaliningrad Oblast and Lithuania to the north; Belarus and Ukraine to the east; Slovakia and the Czech Republic to the south; and Germany to the west. The territory has a varied landscape, diverse ecosystems, and a temperate climate. Poland is composed of sixteen voivodeships and is the fifth most populous member state of the European Union (EU), with over 38 million people, and the fifth largest EU country by land area, covering 312,696 km2 (120,733 sq mi). The capital and largest city is Warsaw; other major cities include Kraków, Wrocław, Łódź, Poznań, and Gdańsk."}}, {"canonical_name": "Elba", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 5, "total_mentions": 11, "members": [{"entity_id": "elba", "book_id": "kosmos_humboldt_1845", "name": "Elba", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Elba"], "contexts": ["island location of Monte Serrato", "island where Monte Serrato is located"]}, {"entity_id": "elba", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Elba", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Elba"], "contexts": ["modern name for Ilua"]}, {"entity_id": "elbe", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Elbe", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Elbe"], "contexts": ["river in Europe", "river from which Bohemians did not come"]}, {"entity_id": "elba", "book_id": "principles_of_psychology_james_1890", "name": "Elba", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Elba"], "contexts": ["island associated with Napoleon"]}, {"entity_id": "elba", "book_id": "ricettario_fiorentino_1597", "name": "Elba", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Elba"], "contexts": ["island where white earth is found", "place associated with refined bolo"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Elba", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Elba", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Elba", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Elbe", "similarity": 0.953}, {"source_book": "kosmos_humboldt_1845", "source_name": "Elba", "target_book": "principles_of_psychology_james_1890", "target_name": "Elba", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Elba", "target_book": "ricettario_fiorentino_1597", "target_name": "Elba", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Elba", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Elbe", "similarity": 0.953}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Elba", "target_book": "principles_of_psychology_james_1890", "target_name": "Elba", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Elba", "target_book": "ricettario_fiorentino_1597", "target_name": "Elba", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Elbe", "target_book": "principles_of_psychology_james_1890", "target_name": "Elba", "similarity": 0.953}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Elbe", "target_book": "ricettario_fiorentino_1597", "target_name": "Elba", "similarity": 0.953}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Elba", "target_book": "ricettario_fiorentino_1597", "target_name": "Elba", "similarity": 1.0}], "id": 84, "stable_key": "clu_dadc57bc4494980f", "ground_truth": {"modern_name": "Elba", "confidence": "high", "type": "place", "description": "Island in Italy and a river in Europe.", "note": "Contexts differentiate between the island and the river.", "wikipedia_extract": "Elba (Italian: isola d'Elba, pronounced [ˈiːzola ˈdelba]; Latin: Ilva) is a Mediterranean island in Tuscany, Italy, 10 km (6.2 mi) from the coastal town of Piombino on the Italian mainland, and the largest island of the Tuscan Archipelago. It is also part of the Arcipelago Toscano National Park, and the third largest island in Italy, after Sicily and Sardinia. It is located in the Tyrrhenian Sea about 50 km (30 mi) east of the French island of Corsica. The island is part of the province of Livorno and is divided into seven municipalities, with a total population of about 30,000 inhabitants which increases considerably during the summer. The municipalities are Portoferraio (which is also the island's principal town), Campo nell'Elba, Capoliveri, Marciana, Marciana Marina, Porto Azzurro, and Rio. It is famous for being the site of Napoleon's first exile, from 1814 to 1815."}}, {"canonical_name": "experiment", "category": "PRACTICE", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 10, "members": [{"entity_id": "experiment", "book_id": "principles_of_psychology_james_1890", "name": "experiment", "category": "PRACTICE", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Experiment", "experiment"], "contexts": ["scientific procedure to test hypothesis", "scientific procedure to test a hypothesis"]}, {"entity_id": "experiments", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "experiments", "category": "PRACTICE", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["experiments"], "contexts": ["scientific tests for discovery"]}, {"entity_id": "experimentation", "book_id": "principles_of_psychology_james_1890", "name": "experimentation", "category": "PRACTICE", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["experimentation"], "contexts": ["scientific method of testing hypotheses", "scientific method of testing"]}, {"entity_id": "chemical_experiments", "book_id": "kosmos_humboldt_1845", "name": "chemical experiments", "category": "PRACTICE", "subcategory": "OTHER_PRACTICE", "count": 1, "variants": ["chemical experiments"], "contexts": ["used to study rock transformation"]}, {"entity_id": "experimental_research", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Experimental research", "category": "PRACTICE", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Experimental research"], "contexts": ["method proving conservation of force"]}, {"entity_id": "experiment", "book_id": "first_principles_spencer_1862", "name"