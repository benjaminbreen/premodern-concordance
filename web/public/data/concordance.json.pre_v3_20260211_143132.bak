 {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "fever", "target_book": "ricettario_fiorentino_1597", "target_name": "Fever", "similarity": 0.992}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "fever", "target_book": "polyanthea_medicinal", "target_name": "arida eftuantequefebre", "similarity": 0.842}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fever", "target_book": "historia_medicinal_monardes_1574", "target_name": "fiebres", "similarity": 0.965}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fever", "target_book": "coloquios_da_orta_1563", "target_name": "febre", "similarity": 0.972}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fever", "target_book": "ricettario_fiorentino_1597", "target_name": "Fever", "similarity": 0.992}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fever", "target_book": "polyanthea_medicinal", "target_name": "arida eftuantequefebre", "similarity": 0.842}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fevers", "target_book": "historia_medicinal_monardes_1574", "target_name": "fiebres", "similarity": 0.98}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fevers", "target_book": "coloquios_da_orta_1563", "target_name": "febre", "similarity": 0.964}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fevers", "target_book": "ricettario_fiorentino_1597", "target_name": "Fever", "similarity": 0.98}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "fiebres", "target_book": "coloquios_da_orta_1563", "target_name": "febre", "similarity": 0.96}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "fiebres", "target_book": "ricettario_fiorentino_1597", "target_name": "Fever", "similarity": 0.959}, {"source_book": "coloquios_da_orta_1563", "source_name": "febre", "target_book": "ricettario_fiorentino_1597", "target_name": "Fever", "similarity": 0.966}, {"source_book": "coloquios_da_orta_1563", "source_name": "febre", "target_book": "polyanthea_medicinal", "target_name": "febre lenta", "similarity": 0.82}], "id": 15, "stable_key": "clu_39013ff5aca96875", "ground_truth": {"modern_name": "fever", "confidence": "high", "type": "disease", "description": "An acute illness characterized by elevated body temperature and potential delirium.", "wikipedia_extract": "Fever or pyrexia in humans is a symptom of an anti-infection defense mechanism that appears with body temperature exceeding the normal range caused by an increase in the body's temperature set point in the hypothalamus. There is no single agreed-upon upper limit for normal temperature: sources use values ranging between 37.2 and 38.3 °C (99.0 and 100.9 °F) in humans. The increase in set point triggers increased muscle contractions and causes a feeling of cold or chills. This results in greater heat production and efforts to conserve heat. When the set point temperature returns to normal, a person feels hot, becomes flushed, and may begin to sweat. Rarely a fever may trigger a febrile seizure, with this being more common in young children."}}, {"canonical_name": "Dioscorides", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 7, "total_mentions": 332, "members": [{"entity_id": "dioscorides", "book_id": "coloquios_da_orta_1563", "name": "Dioscorides", "category": "PERSON", "subcategory": "AUTHORITY", "count": 135, "variants": ["Dioscorides", "Diascorídes", "Diosc", "Diosc.", "DioscondQs", "Dioscor", "Dioscorid.", "Dioscorídes", "Dioseorides", "Díoscorides"], "contexts": ["ancient author on materia medica", "ancient authority"]}, {"entity_id": "dioscorides", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Dioscorides", "category": "PERSON", "subcategory": "AUTHORITY", "count": 14, "variants": ["Dioscorides"], "contexts": ["source for Plinie's borrowings", "ancient medical writer"]}, {"e