ource_book": "principles_of_psychology_james_1890", "source_name": "experimentation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Experimental research", "similarity": 0.922}, {"source_book": "principles_of_psychology_james_1890", "source_name": "experimentation", "target_book": "first_principles_spencer_1862", "target_name": "experiment", "similarity": 0.974}, {"source_book": "kosmos_humboldt_1845", "source_name": "chemical experiments", "target_book": "first_principles_spencer_1862", "target_name": "chemical experiment", "similarity": 0.893}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Experimental research", "target_book": "first_principles_spencer_1862", "target_name": "experiment", "similarity": 0.91}], "id": 85, "stable_key": "clu_e0ba231cf4f07db2", "ground_truth": {"modern_name": "scientific experimentation", "confidence": "high", "type": "concept", "note": "This cluster focuses on the act and process of performing scientific experiments, overlapping with cluster 82 but with a slightly stronger emphasis on the practice.", "wikidata_id": "Q84476177", "wikidata_description": "scientific article published on 01 January 2001", "wikipedia_extract": "An experiment is a procedure carried out to support or refute a hypothesis, or determine the efficacy or likelihood of something previously untried. Experiments provide insight into cause-and-effect by demonstrating what outcome occurs when a particular factor is manipulated. Experiments vary greatly in goal and scale but always rely on repeatable procedure and logical analysis of the results. There also exist  natural experimental studies. A child may carry out basic experiments to understand how things fall to the ground, while teams of scientists may take years of systematic investigation to advance their understanding of a phenomenon. Experiments and other types of hands-on activities are very important to student learning in the science classroom."}}, {"canonical_name": "poetry", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 10, "members": [{"entity_id": "poetry", "book_id": "first_principles_spencer_1862", "name": "poetry", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Poetry", "poetry"], "contexts": ["art form originating from rhythm in speech", "art form"]}, {"entity_id": "poetical", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Poetical", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Poetical"], "contexts": ["origin of a conceit about lifespan"]}, {"entity_id": "poetry", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Poetry", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Poetry"], "contexts": ["literary form often using exaggeration"]}, {"entity_id": "poetry", "book_id": "kosmos_humboldt_1845", "name": "poetry", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["poetry"], "contexts": ["art form appealing to imagination", "literary art form"]}, {"entity_id": "poefia", "book_id": "polyanthea_medicinal", "name": "Poefia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Poefia"], "contexts": ["art not necessary for healing"]}, {"entity_id": "poetry", "book_id": "connexion_physical_sciences_somerville_1858", "name": "poetry", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["poetry"], "contexts": ["literary art form"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "poetry", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Poetical", "similarity": 0.938}, {"source_book": "first_principles_spencer_1862", "source_name": "poetry", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Poetry", "similarity": 0.97}, {"source_book": "first_principles_spencer_1862", "source_name": "poetry", "target_book": "kosmos_humboldt_1845", "target_name": "poetry", "similarity": 1.0}, {"source_book": "first_principles_spencer_1862", "source_name": "poetry", "target_book": "polyanthea_medicinal", "target_name": "Poefia", "similarity": 0.911}, {"source_book": "first_principles_spencer_1862", "source_name": "poetry", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "poetry", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Poetical", "target_book": "kosmos_humboldt_1845", "target_name": "poetry", "similarity": 0.938}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Poetical", "target_book": "polyanthea_medicinal", "target_name": "Poefia", "similarity": 0.911}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Poetical", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "poetry", "similarity": 0.938}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Poetry", "target_book": "kosmos_humboldt_1845", "target_name": "poetry", "similarity": 0.97}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Poetry", "target_book": "polyanthea_medicinal", "target_name": "Poefia", "similarity": 0.893}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Poetry", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "poetry", "similarity": 0.97}, {"source_book": "kosmos_humboldt_1845", "source_name": "poetry", "target_book": "polyanthea_medicinal", "target_name": "Poefia", "similarity": 0.911}, {"source_book": "kosmos_humboldt_1845", "source_name": "poetry", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "poetry", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Poefia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "poetry", "similarity": 0.911}], "id": 86, "stable_key": "clu_3e2c416cd36bc008", "ground_truth": {"modern_name": "poetry", "confidence": "high", "type": "concept", "note": "While one term is in Italian ('Poefia'), the context strongly indicates the literary art form of poetry.", "wikidata_id": "Q12106333", "wikidata_description": "collection of poems by a single author published together. See also poetry anthology (Q19357149)", "wikipedia_url": "https://en.wikipedia.org/wiki/Poetry%20collection", "wikipedia_extract": "Poetry (from the Greek word poiesis, \"making\") is a form of literary art that uses aesthetic and often rhythmic qualities of language to evoke meanings in addition to, or in place of, literal or surface-level meanings. Any particular instance of poetry is called a poem and is written by a poet. Poets use a variety of techniques called poetic devices, such as assonance, alliteration, consonance, euphony and cacophony, onomatopoeia, rhythm (via metre), rhyme schemes (patterns in the type and placement of a phoneme group) and sound symbolism, to produce musical or other artistic effects. They also frequently organize these devices into poetic structures, which may be strict or loose, conventional or invented by the poet. Poetic structures vary dramatically by language and cultural convention, but they often rely on rhythmic metre: patterns of syllable stress or syllable (or mora) weight. They may also use repeating patterns of phonemes, phoneme groups, tones, words, or entire phrases."}}, {"canonical_name": "Oxe", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 5, "total_mentions": 9, "members": [{"entity_id": "oxe", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Oxe", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["Oxe"], "contexts": ["bovine animal", "domesticated bovine"]}, {"entity_id": "oxen", "book_id": "origin_of_species_darwin_1859", "name": "oxen", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["oxen"], "contexts": ["domesticated cattle for breeding"]}, {"entity_id": "ox", "book_id": "origin_of_species_darwin_1859", "name": "ox", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["ox"], "contexts": ["animal with leg bone homologies"]}, {"entity_id": "oxen", "book_id": "principles_of_psychology_james_1890", "name": "oxen", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["oxen"], "contexts": ["domesticated bovine animals"]}, {"entity_id": "ox", "book_id": "kosmos_humboldt_1845", "name": "ox", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["ox"], "contexts": ["extant animal found as fossil"]}, {"entity_id": "ox", "book_id": "first_principles_spencer_1862", "name": "ox", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["ox"], "contexts": ["domesticated bovine animal", "animal with fused bone cylinders"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Oxe", "target_book": "origin_of_species_darwin_1859", "target_name": "oxen", "similarity": 0.951}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Oxe", "target_book": "origin_of_species_darwin_1859", "target_name": "ox", "similarity": 0.951}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Oxe", "target_book": "principles_of_psychology_james_1890", "target_name": "oxen", "similarity": 0.951}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Oxe", "target_book": "kosmos_humboldt_1845", "target_name": "ox", "similarity": 0.951}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Oxe", "target_book": "first_principles_spencer_1862", "target_name": "ox", "similarity": 0.951}, {"source_book": "origin_of_species_darwin_1859", "source_name": "oxen", "target_book": "principles_of_psychology_james_1890", "target_name": "oxen", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "oxen", "target_book": "kosmos_humboldt_1845", "target_name": "ox", "similarity": 0.933}, {"source_book": "origin_of_species_darwin_1859", "source_name": "oxen", "target_book": "first_principles_spencer_1862", "target_name": "ox", "similarity": 0.933}, {"source_book": "origin_of_species_darwin_1859", "source_name": "ox", "target_book": "principles_of_psychology_james_1890", "target_name": "oxen", "similarity": 0.933}, {"source_book": "origin_of_species_darwin_1859", "source_name": "ox", "target_book": "kosmos_humboldt_1845", "target_name": "ox", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "ox", "target_book": "first_principles_spencer_1862", "target_name": "ox", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "oxen", "target_book": "kosmos_humboldt_1845", "target_name": "ox", "similarity": 0.933}, {"source_book": "principles_of_psychology_james_1890", "source_name": "oxen", "target_book": "first_principles_spencer_1862", "target_name": "ox", "similarity": 0.933}, {"source_book": "kosmos_humboldt_1845", "source_name": "ox", "target_book": "first_principles_spencer_1862", "target_name": "ox", "similarity": 1.0}], "id": 87, "stable_key": "clu_984aaf62c47a10da", "ground_truth": {"wikipedia_extract": "An ox (pl.: oxen), also known as a bullock (in British, Australian, and Indian English), is a large bovine, trained and used as a draft animal. Oxen are commonly castrated adult male cattle, because castration inhibits testosterone and aggression, which makes the males docile and safer to work with. Cows (intact females) or bulls (intact males) may also be used in some areas. Oxen are used for ploughing, for transport (pulling carts, hauling wagons and even riding), for threshing grain by trampling, and for powering machines that grind grain or supply irrigation among other purposes. Oxen may be also used to skid logs in forests, particularly in low-impact, select-cut logging. Oxen are usually yoked in pairs."}}, {"canonical_name": "spiders", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 5, "total_mentions": 8, "members": [{"entity_id": "spiders", "book_id": "origin_of_species_darwin_1859", "name": "spiders", "category": "ANIMAL", "subcategory": "INSECT", "count": 3, "variants": ["spiders"], "contexts": ["animals with no metamorphosis", "example of animal development rule"]}, {"entity_id": "spider", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Spider", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Spider"], "contexts": ["arachnid creature", "venemous creature signifying pestilence"]}, {"entity_id": "spiders", "book_id": "kosmos_humboldt_1845", "name": "spiders", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["spiders"], "contexts": ["arachnids found in amber"]}, {"entity_id": "spider", "book_id": "polyanthea_medicinal", "name": "spider", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["spider"], "contexts": ["venomous creature"]}, {"entity_id": "spiders", "book_id": "first_principles_spencer_1862", "name": "spiders", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["spiders"], "contexts": ["higher division of Annulosa with reduced segments"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "spiders", "target_book": "kosmos_humboldt_1845", "target_name": "spiders", "similarity": 0.862}, {"source_book": "origin_of_species_darwin_1859", "source_name": "spiders", "target_book": "polyanthea_medicinal", "target_name": "spider", "similarity": 0.879}, {"source_book": "origin_of_species_darwin_1859", "source_name": "spiders", "target_book": "first_principles_spencer_1862", "target_name": "spiders", "similarity": 0.862}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Spider", "target_book": "kosmos_humboldt_1845", "target_name": "spiders", "similarity": 0.938}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Spider", "target_book": "polyanthea_medicinal", "target_name": "spider", "similarity": 0.878}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Spider", "target_book": "first_principles_spencer_1862", "target_name": "spiders", "similarity": 0.938}, {"source_book": "kosmos_humboldt_1845", "source_name": "spiders", "target_book": "polyanthea_medicinal", "target_name": "spider", "similarity": 0.915}, {"source_book": "kosmos_humboldt_1845", "source_name": "spiders", "target_book": "first_principles_spencer_1862", "target_name": "spiders", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "spider", "target_book": "first_principles_spencer_1862", "target_name": "spiders", "similarity": 0.915}], "id": 88, "stable_key": "clu_5f00f67bc5e475b3", "ground_truth": {"wikipedia_extract": "Spiders (order Araneae) are air-breathing arthropods that have eight limbs, chelicerae with fangs generally able to inject venom, and spinnerets that extrude silk. They are the largest order of arachnids and rank seventh in total species diversity among all orders of organisms. Spiders are found worldwide on every continent except Antarctica, and have become established in nearly every land habitat. As of January 2026, 53,680 spider species in 139 families have been recorded by taxonomists. However, there has been debate among scientists about how families should be classified, with over 20 different classifications proposed since 1900. Anatomically, spiders (as with all arachnids) differ from other arthropods in that the usual body segments are fused into two tagmata, the cephalothorax or prosoma, and the opisthosoma, or abdomen, and joined by a small, cylindrical pedicel."}}, {"canonical_name": "consciousness", "category": "CONCEPT", "subcategory": "MENTAL_FACULTY", "book_count": 4, "total_mentions": 525, "members": [{"entity_id": "consciousness", "book_id": "principles_of_psychology_james_1890", "name": "consciousness", "category": "CONCEPT", "subcategory": "MENTAL_FACULTY", "count": 314, "variants": ["Consciousness", "CONSCIOUSNESS", "consciousness"], "contexts": ["awareness of mental states", "personal form, constant change"]}, {"entity_id": "conscious", "book_id": "principles_of_psychology_james_1890", "name": "conscious", "category": "CONCEPT", "subcategory": "MENTAL_FACULTY", "count": 13, "variants": ["conscious"], "contexts": ["having awareness", "mental states of awareness"]}, {"entity_id": "self-consciousness", "book_id": "principles_of_psychology_james_1890", "name": "self-consciousness", "category": "CONCEPT", "subcategory": "MENTAL_FACULTY", "count": 11, "variants": ["Self-consciousness", "self-consciousness"], "contexts": ["awareness of oneself", "awareness of one's own existence"]}, {"entity_id": "personal_consciousness", "book_id": "principles_of_psychology_james_1890", "name": "personal consciousness", "category": "CONCEPT", "subcategory": "MENTAL_FACULTY", "count": 7, "variants": ["personal consciousness"], "contexts": ["individual awareness of mental states", "individual awareness"]}, {"entity_id": "sub-consciousness", "book_id": "principles_of_psychology_james_1890", "name": "sub-consciousness", "category": "CONCEPT", "subcategory": "MENTAL_FACULTY", "count": 4, "variants": ["sub-consciousness"], "contexts": ["state of awareness below full consciousness", "state of awareness coexisting with motion"]}, {"entity_id": "unity_of_consciousness", "book_id": "principles_of_psychology_james_1890", "name": "unity of consciousness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Unity of Consciousness", "unity of consciousness"], "contexts": ["concept of unified awareness", "coherence of subjective experience"]}, {"entity_id": "states_of_consciousness", "book_id": "principles_of_psychology_james_1890", "name": "states of consciousness", "category": "CONCEPT", "subcategory": "MENTAL_FACULTY", "count": 3, "variants": ["states of consciousness"], "contexts": ["momentary awareness", "mental conditions corresponding to processes"]}, {"entity_id": "consciousnesses", "book_id": "principles_of_psychology_james_1890", "name": "consciousnesses", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["consciousnesses"], "contexts": ["plurality of awareness states", "states of awareness"]}, {"entity_id": "state_of_consciousness", "book_id": "principles_of_psychology_james_1890", "name": "state of consciousness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["state of consciousness"], "contexts": ["cumbrous term for mental states", "momentary mental condition"]}, {"entity_id": "secondary_consciousness", "book_id": "principles_of_psychology_james_1890", "name": "secondary consciousness", "category": "CONCEPT", "subcategory": "MENTAL_FACULTY", "count": 2, "variants": ["secondary consciousness"], "contexts": ["alternate awareness", "a consciousness separate from the primary one"]}, {"entity_id": "subjective_consciousness", "book_id": "principles_of_psychology_james_1890", "name": "subjective consciousness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["subjective consciousness"], "contexts": ["awareness of internal mental states", "Individual awareness and mental life"]}, {"entity_id": "consciousness_of_self", "book_id": "principles_of_psychology_james_1890", "name": "consciousness of Self", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["consciousness of self", "consciousness of Self"], "contexts": ["awareness of one's own identity"]}, {"entity_id": "animals'_consciousness", "book_id": "principles_of_psychology_james_1890", "name": "animals' consciousness", "category": "CONCEPT", "subcategory": "MENTAL_FACULTY", "count": 1, "variants": ["animals' consciousness"], "contexts": ["awareness in animals"]}, {"entity_id": "muscular_consciousness", "book_id": "principles_of_psychology_james_1890", "name": "muscular consciousness", "categ