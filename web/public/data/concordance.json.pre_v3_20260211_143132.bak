ico", "similarity": 0.986}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Arsenick", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "arsenic", "similarity": 0.928}, {"source_book": "principles_of_psychology_james_1890", "source_name": "arsenic", "target_book": "kosmos_humboldt_1845", "target_name": "arsenic", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "arsenic", "target_book": "ricettario_fiorentino_1597", "target_name": "Arsenico", "similarity": 0.934}, {"source_book": "principles_of_psychology_james_1890", "source_name": "arsenic", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "arsenic", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "arsenic", "target_book": "ricettario_fiorentino_1597", "target_name": "Arsenico", "similarity": 0.934}, {"source_book": "kosmos_humboldt_1845", "source_name": "arsenic", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "arsenic", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Arsenico", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "arsenic", "similarity": 0.934}], "id": 42, "stable_key": "clu_acfd9a3bf9f1e319", "ground_truth": {"modern_name": "arsenic", "confidence": "high", "type": "mineral", "description": "A toxic metalloid element used historically in medicine and alchemy.", "wikipedia_extract": "Arsenic is a chemical element; it has the symbol As and atomic number 33. It is a metalloid and one of the pnictogens, and therefore shares many properties with its group 15 neighbors phosphorus and antimony. Arsenic is notoriously toxic. It occurs naturally in many minerals, usually in combination with sulfur and metals, but also as a pure elemental crystal. It has various allotropes, but only the grey form, which has a metallic appearance, is important to industry. The primary use of arsenic is in alloys of lead (for example, in car batteries and ammunition)."}}, {"canonical_name": "porcelana", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 6, "total_mentions": 16, "members": [{"entity_id": "porcelana", "book_id": "coloquios_da_orta_1563", "name": "porcelana", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 7, "variants": ["porcelana", "porcellana"], "contexts": ["merchandise from China", "ceramic material traded"]}, {"entity_id": "porcellane", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Porcellane", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Porcellane"], "contexts": ["type of dish"]}, {"entity_id": "porcelaines", "book_id": "relation_historique_humboldt_vol3_1825", "name": "porcelaines", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["porcelaines", "porcelaine"], "contexts": ["ceramic goods from China", "porcelain"]}, {"entity_id": "porcelanas", "book_id": "historia_medicinal_monardes_1574", "name": "porcelanas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["porcelanas"], "contexts": ["porcelain fragments"]}, {"entity_id": "porcellana", "book_id": "ricettario_fiorentino_1597", "name": "Porcellana", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["porcellana", "Porcellana"], "contexts": ["herb with viscous juice", "herb that is viscous with humidity"]}, {"entity_id": "porcelain", "book_id": "first_principles_spencer_1862", "name": "porcelain", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["porcelain"], "contexts": ["ceramic material for manufacture"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "porcelana", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Porcellane", "similarity": 0.878}, {"source_book": "coloquios_da_orta_1563", "source_name": "porcelana", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "porcelaines", "similarity": 0.884}, {"source_book": "coloquios_da_orta_1563", "source_name": "porcelana", "target_book": "historia_medicinal_monardes_1574", "target_name": "porcelanas", "similarity": 0.99}, {"source_book": "coloquios_da_orta_1563", "source_name": "porcelana", "target_book": "ricettario_fiorentino_1597", "target_name": "Porcellana", "similarity": 0.876}, {"source_book": "coloquios_da_orta_1563", "source_name": "porcelana", "target_book": "first_principles_spencer_1862", "target_name": "porcelain", "similarity": 0.9}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Porcellane", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "porcelaines", "similarity": 0.954}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Porcellane", "target_book": "historia_medicinal_monardes_1574", "target_name": "porcelanas", "similarity": 0.879}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Porcellane", "target_book": "ricettario_fiorentino_1597", "target_name": "Porcellana", "similarity": 0.996}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Porcellane", "target_book": "first_principles_spencer_1862", "target_name": "porcelain", "similarity": 0.968}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "porcelaines", "target_book": "historia_medicinal_monardes_1574", "target_name": "porcelanas", "similarity": 0.898}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "porcelaines", "target_book": "ricettario_fiorentino_1597", "target_name": "Porcellana", "similarity": 0.95}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "porcelaines", "target_book": "first_principles_spencer_1862", "target_name": "porcelain", "similarity": 0.983}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "porcelanas", "target_book": "ricettario_fiorentino_1597", "target_name": "Porcellana", "similarity": 0.879}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "porcelanas", "target_book": "first_principles_spencer_1862", "target_name": "porcelain", "similarity": 0.895}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Porcellana", "target_book": "first_principles_spencer_1862", "target_name": "porcelain", "similarity": 0.961}], "id": 43, "stable_key": "clu_2e16bf65067c0939", "ground_truth": {"modern_name": "Porcelain", "confidence": "high", "type": "object", "description": "A hard, white, ceramic material, often decorated, originating from China.", "note": "Also refers to a plant with a viscous juice.", "wikipedia_extract": "Porcelain (), also called china, is a ceramic material made by heating raw materials, generally including kaolinite, in a kiln to temperatures between 1,200 and 1,400 °C (2,200 and 2,600 °F). The greater strength and translucence of porcelain, relative to other types of pottery, arise mainly from vitrification and the formation of the mineral mullite within the body at these high temperatures. End applications include tableware, decorative ware such as figurines, and products in technology and industry such as electrical insulators and laboratory ware. The manufacturing process used for porcelain is similar to that used for earthenware and stoneware, the two other main types of pottery, although it can be more challenging to produce. It has usually been regarded as the most prestigious type of pottery due to its delicacy, strength, and high degree of whiteness. It is frequently both glazed and decorated."}}, {"canonical_name": "microscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 6, "total_mentions": 11, "members": [{"entity_id": "microscope", "book_id": "kosmos_humboldt_1845", "name": "microscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["microscope"], "contexts": ["instrument for viewing small objects", "instrument for observing small life"]}, {"entity_id": "microscopes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Microscopes", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["Microscopes"], "contexts": ["instruments for viewing microscopic objects"]}, {"entity_id": "microscope", "book_id": "principles_of_psychology_james_1890", "name": "microscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["microscope"], "contexts": ["Instrument for viewing small objects"]}, {"entity_id": "microscopes", "book_id": "principles_of_psychology_james_1890", "name": "microscopes", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["microscopes"], "contexts": ["instruments for viewing small objects"]}, {"entity_id": "microscopio", "book_id": "polyanthea_medicinal", "name": "microscopio", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["microscopio"], "contexts": ["instrument for viewing small objects"]}, {"entity_id": "microscope", "book_id": "connexion_physical_sciences_somerville_1858", "name": "microscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["microscope"], "contexts": ["reveals new beauties in depicted objects"]}, {"entity_id": "micrometer", "book_id": "connexion_physical_sciences_somerville_1858", "name": "micrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["micrometer"], "contexts": ["instrument for measuring small distances"]}, {"entity_id": "microscope", "book_id": "first_principles_spencer_1862", "name": "microscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["microscope"], "contexts": ["instrument for viewing small objects", "instrument for viewing minute forms"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "microscope", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Microsc