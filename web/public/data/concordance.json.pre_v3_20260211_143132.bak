_humboldt_1845", "source_name": "Jupiter's satellites", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Jupiter’s satellites", "similarity": 0.998}, {"source_book": "kosmos_humboldt_1845", "source_name": "Jupiter's satellites", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Jupiter and Saturn", "similarity": 0.813}, {"source_book": "kosmos_humboldt_1845", "source_name": "Jupiter's satellites", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Jupiter's satellites", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Jupiter's satellites", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Jupiter’s satellite", "similarity": 0.98}, {"source_book": "kosmos_humboldt_1845", "source_name": "Jupiter's satellites", "target_book": "first_principles_spencer_1862", "target_name": "Jupiter", "similarity": 0.868}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Jupiter’s satellites", "target_book": "first_principles_spencer_1862", "target_name": "Jupiter", "similarity": 0.868}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Jupiter and Saturn", "target_book": "first_principles_spencer_1862", "target_name": "Jupiter", "similarity": 0.863}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Jupiter's satellites", "target_book": "first_principles_spencer_1862", "target_name": "Jupiter", "similarity": 0.868}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Jupiter’s satellite", "target_book": "first_principles_spencer_1862", "target_name": "Jupiter", "similarity": 0.886}], "id": 103, "stable_key": "clu_1d445c23dccce1bf", "ground_truth": {"modern_name": "Jupiter", "confidence": "high", "type": "object", "note": "Although 'animal' is listed as a subcategory, in this context 'Jupiter' refers to the planet.", "wikidata_id": "Q37530492", "wikidata_description": "family name", "wikipedia_extract": "Jupiter is the fifth planet from the Sun, and the largest in the Solar System. It is a gas giant with a mass nearly 2.5 times that of all the other planets in the Solar System combined and slightly less than one-thousandth the mass of the Sun. Its diameter is 11 times that of Earth and a tenth that of the Sun. Jupiter orbits the Sun at a distance of 5.20 AU (778.5 Gm), with an orbital period of 11.86 years. It is the third-brightest natural object in the Earth's night sky, after the Moon and Venus, and has been observed since prehistoric times. Its name derives from that of Jupiter, the chief deity of ancient Roman religion."}}, {"canonical_name": "Trinidad", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 96, "members": [{"entity_id": "trinidad", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Trinidad", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 87, "variants": ["Trinidad", "Trinidad de Cuba", "Trinidad de Culja", "Trinité", "Villa de la Trinidad", "la Trinidad"], "contexts": ["island in a map title", "island name"]}, {"entity_id": "rio_trinidad", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rio Trinidad", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Rio Trinidad"], "contexts": ["river name"]}, {"entity_id": "tueblo_de_la_trinidad", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tueblo de la Trinidad", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Tueblo de la Trinidad"], "contexts": ["town for longitude difference"]}, {"entity_id": "trinidad", "book_id": "coloquios_da_orta_1563", "name": "Trinidad", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Trinidad"], "contexts": ["island where guaiacam grows"]}, {"entity_id": "trindade", "book_id": "polyanthea_medicinal", "name": "Trindade", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Trindade"], "contexts": ["location of convent", "religious order of Frey Thomè do Sacramento"]}, {"entity_id": "trinity_bay", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Trinity Bay", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Trinity Bay"], "contexts": ["location in Newfoundland"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Trinidad", "target_book": "coloquios_da_orta_1563", "target_name": "Trinidad", "similarity": 0.847}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Trinidad", "target_book": "polyanthea_medicinal", "target_name": "Trindade", "similarity": 0.941}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Trinidad", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Trinity Bay", "similarity": 0.841}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rio Trinidad", "target_book": "polyanthea_medicinal", "target_name": "Trindade", "similarity": 0.858}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rio Trinidad", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Trinity Bay", "similarity": 0.879}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tueblo de la Trinidad", "target_book": "polyanthea_medicinal", "target_name": "Trindade", "similarity": 0.863}, {"source_book": "coloquios_da_orta_1563", "source_name": "Trinidad", "target_book": "polyanthea_medicinal", "target_name": "Trindade", "similarity": 0.815}, {"source_book": "polyanthea_medicinal", "source_name": "Trindade", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Trinity Bay", "similarity": 0.848}], "id": 104, "stable_key": "clu_38edd9266f3616ee", "ground_truth": {"modern_name": "Trinidad", "confidence": "high", "type": "place", "description": "An island nation in the southern Caribbean Sea.", "note": "Also refers to the island itself. 'Trindade' is a Portuguese spelling for a place name.", "wikipedia_extract": "Trinidad is the largest and most populous island of the Republic of Trinidad and Tobago. The island lies 11 km (6.8 mi) off the northeastern coast of Venezuela and sits on the continental shelf of South America. It is the southernmost island in the Caribbean. With an area of 4,768 km2 (1,841 sq mi), it is also the fifth-largest in the Caribbean. The original name for the island in the Arawakan languages was Iëre which meant \"Land of the Hummingbird\". Christopher Columbus renamed it La Isla de la Trinidad ('The Island of the Trinity'), fulfilling a vow he had made before setting out on his third voyage."}}, {"canonical_name": "Body", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 89, "members": [{"entity_id": "body", "book_id": "english_physician_1652", "name": "Body", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 50, "variants": ["Body", "Body of Man", "Body of man"], "contexts": ["human physical form", "human physical structure"]}, {"entity_id": "corpo", "book_id": "coloquios_da_orta_1563", "name": "corpo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["corpo"], "contexts": ["examined for illness"]}, {"entity_id": "corpo", "book_id": "ricettario_fiorentino_1597", "name": "Corpo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Corpo"], "contexts": ["body"]}, {"entity_id": "corpo", "book_id": "polyanthea_medicinal", "name": "corpo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 36, "variants": ["corpo", "Corpo"], "contexts": ["The physical body", "body"]}, {"entity_id": "body_parts", "book_id": "polyanthea_medicinal", "name": "body parts", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["body parts"], "contexts": ["components of the human body"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Body", "target_book": "coloquios_da_orta_1563", "target_name": "corpo", "similarity": 0.974}, {"source_book": "english_physician_1652", "source_name": "Body", "target_book": "ricettario_fiorentino_1597", "target_name": "Corpo", "similarity": 0.977}, {"source_book": "english_physician_1652", "source_name": "Body", "target_book": "polyanthea_medicinal", "target_name": "corpo", "similarity": 0.974}, {"source_book": "english_physician_1652", "source_name": "Body", "target_book": "polyanthea_medicinal", "target_name": "body parts", "similarity": 0.937}, {"source_book": "coloquios_da_orta_1563", "source_name": "corpo", "target_book": "ricettario_fiorentino_1597", "target_name": "Corpo", "similarity": 0.988}, {"source_book": "coloquios_da_orta_1563", "source_name": "corpo", "target_book": "polyanthea_medicinal", "target_name": "corpo", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "corpo", "target_book": "polyanthea_medicinal", "target_name": "body parts", "similarity": 0.92}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Corpo", "target_book": "polyanthea_medicinal", "target_name": "corpo", "similarity": 0.988}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Corpo", "target_book": "polyanthea_medicinal", "target_name": "body parts", "similarity": 0.922}], "id": 105, "stable_key": "clu_d6fc48c8f15b7709", "ground_truth": {"modern_name": "Body", "confidence": "high", "type": "anatomy", "description": "The physical structure of a person or animal.", "wikipedia_extract": "The human body is the entire structure of a human being. It is composed of many different types of cells that together create tissues and subsequently organs and then organ systems. The external human body consists of a head, hair, neck, torso (which includes the thorax and abdomen), genitals, arms, hands, legs, and feet. The internal human body includes organs, teeth, bones, muscle, tendons, ligaments, blood vessels and blood, lymphatic vessels and lymph. The study of the human body includes anatomy, physiology, histology and embryology. The body varies anatomically in known ways."}}, {"canonical_name": "Yellow Jaundice", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 4, "total_mentions": 83, "members": [{"entity_id": "yellow_jaundice", "book_id": "english_physician_1652", "name": "Yellow Jaundice", "category": "DISEASE", "subcategory": "CHRONIC", "count": 78, "variants": ["Yellow Jaundice", "Black Jaundice", "Jaun", "Jaundice", "Jaun∣dice", "Yelloow Jaundice", "black Jaundice", "yel-low Jaundice", "yellow Jaundice", "yellow Jaun∣dice", "yellow-Jaundice", "yel­low Jaundice", "yel∣low Jaundice"], "contexts": ["disease affecting the gall", "disease caused by choller"]}, {"entity_id": "jaundice", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Jaundice", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["Jaundice"], "contexts": ["yellowing of skin due to bile issues", "condition with white excrements"]}, {"entity_id": "yellow_jaundice", "book_id": "ricettario_fiorentino_1597", "name": "Yellow Jaundice", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["Yellow Jaundice"], "contexts": ["disease of liver obstruction"]}, {"entity_id": "yellow_jaundice", "book_id": "polyanthea_medicinal", "name": "yellow Jaundice", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["yellow Jaundice"], "contexts": ["disease of liver obstruction"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Yellow Jaundice", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Jaundice", "similarity": 0.938}, {"source_book": "english_physician_1652", "source_name": "Yellow Jaundice", "target_book": "ricettario_fiorentino_1597", "target_name": "Yellow Jaundice", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Yellow Jaundice", "target_book": "polyanthea_medicinal", "target_name": "yellow Jaundice", "similarity": 0.973}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Jaundice", "target_book": "ricettario_fiorentino_1597", "target_name": "Yellow Jaundice", "similarity": 0.938}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Jaundice", "target_book": "polyanthea_medicinal", "target_name": "yellow Jaundice", "similarity": 0.94}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Yellow Jaundice", "target_book": "polyanthea_medicinal", "target_name": "yellow Jaundice", "similarity": 0.973}], "id": 106, "stable_key": "clu_20814577204fcef1", "ground_truth": {"modern_name": "jaundice", "confidence": "high", "type": "disease", "description": "Yellowing of skin and eyes due to liver problems.", "note": "Specifically 'Yellow Jaundice' refers to the condition.", "wikipedia_extract": "Jaundice, also known as icterus, is a yellowish or, less frequently, greenish pigmentation of the skin and sclera due to high bilirubin levels. Jaundice in adults typically indicates the presence of underlying diseases involving abnormal heme metabolism, liver dysfunction, or biliary-tract obstruction. The prevalence of jaundice in adults is rare, while jaundice in babies is common, with an estimated 80% affected during their first week of life. The most commonly associated symptoms of jaundice are itchiness, pale feces, and dark urine. Normal levels of bilirubin in blood are below 1.0 mg/dl (17 μmol/L), while levels over 2–3 mg/dl (34–51 μmol/L) typically result in jaundice. High blood bilirubin is divided into two types: unconjugated and conjugated bilirubin."}}, {"canonical_name": "Chymica", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 4, "total_mentions": 78, "members": [{"entity_id": "chymica", "book_id": "polyanthea_medicinal", "name": "Chymica", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 61, "variants": ["Chymica", "CHYMICAS", "Chymiaper", "Chymicas"], "contexts": ["alchemy", "art of preparing medicines"]}, {"entity_id": "chymical_preparations", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Chymical Preparations", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["Chymical Preparations"], "contexts": ["substances made by alchemy", "processes of chemical transformation"]}, {"entity_id": "chimi∣cally", "book_id": "english_physician_1652", "name": "Chimi∣cally", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Chimi∣cally"], "contexts": ["method of drawing spirit from herb"]}, {"entity_id": "chimica", "book_id": "ricettario_fiorentino_1597", "name": "chimica", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["chimica"], "contexts": ["chemical art or practice"]}, {"entity_id": "arte_chymica", "book_id": "polyanthea_medicinal", "name": "Arte Chymica", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 13, "variants": ["Arte Chymica", "ArteChymica"], "contexts": ["alchemical art", "chemical art"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Chymica", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Chymical Preparations", "similarity": 0.866}, {"source_book": "polyanthea_medicinal", "source_name": "Chymica", "target_book": "english_physician_1652", "target_name": "Chimi∣cally", "similarity": 0.902}, {"source_book": "polyanthea_medicinal", "source_name": "Chymica", "target_book": "ricettario_fiorentino_1597", "target_name": "chimica", "similarity": 0.956}, {"source_book": "english_physician_1652", "source_name": "Chimi∣cally", "target_book": "ricettario_fiorentino_1597", "target_name": "chimica", "similarity": 0.895}], "id": 107, "stable_key": "clu_ff0c48a438052ae3", "ground_truth": {"modern_name": "alchemy", "confidence": "high", "type": "concept", "description": "Ancient practice involving chemical transformation and medicine.", "note": "Also encompasses the chemical art and practice.", "wikipedia_extract": "Alchemy (from the Arabic word al-kīmīā, الكیمیاء) is an ancient branch of natural philosophy, a philosophical and protoscientific tradition that was historically practised in China, India, the Muslim world, and Europe. In its Western form, alchemy is first attested in a number of pseudepigraphical texts written in Greco-Roman Egypt during the first few centuries AD. Greek-speaking alchemists often referred to their craft as \"the Art\" (τέχνη) or \"Knowledge\" (ἐπιστήμη), and it was often characterised as mystic (μυστική), sacred (ἱɛρά), or divine (θɛíα). Alchemists attempted to purify, mature, and perfect certain materials. Common aims were chrysopoeia, the transmutation of \"base metals\" (e.g., lead) into \"noble metals\" (particularly gold); the creation of an elixir of immortality; and the creation of panaceas able to cure any disease. The perfection of the human body and soul was thought to result from the alchemical magnum opus (\"Great Work\")."}}, {"canonical_name": "Agarico", "category": "PLANT", "subcategory": "PLANT", "book_count": 4, "total_mentions": 78, "members": [{"entity_id": "agarico", "book_id": "polyanthea_medicinal", "name": "Agarico", "category": "PLANT", "subcategory": "PLANT", "count": 51, "variants": ["Agarico", "Agarici", "Agarico trocifcado", "Agarico trociscado", "agaric", "agarico", "agarico trocifcado", "agarico trociſcado", "agaricotro", "agaricotrocifcado"], "contexts": ["purgative remedy for headaches", "agaric for pills"]}, {"entity_id": "agarico", "book_id": "historia_medicinal_monardes_1574", "name": "Agarico", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Agarico"], "contexts": ["plant mixed with the root", "agaric, a strong emetic"]}, {"entity_id": "agar", "book_id": "coloquios_da_orta_1563", "name": "agar", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["agar", "agarico"], "contexts": ["Hindi name for fragrant wood", "name for aloes in Hindi"]}, {"entity_id": "agarico", "book_id": "ricettario_fiorentino_1597", "name": "Agarico", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 21, "variants": ["Agarico", "Agarico buono", "Agarico trocifca", "agarico"], "contexts": ["purgative medicine", "herb used in trochisci for purging"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Agarico", "target_book": "historia_medicinal_monardes_1574", "target_name": "Agarico", "similarity": 0.916}, {"source_book": "polyanthea_medicinal", "source_name": "Agarico", "target_book": "coloquios_da_orta_1563", "target_name": "agar", "similarity": 0.855}, {"source_book": "polyanthea_medicinal", "source_name": "Agarico", "target_book": "ricettario_fiorentino_1597", "target_name": "Agarico", "similarity": 0.916}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Agarico", "target_book": "ricettario_fiorentino_1597", "target_name": "Agarico", "similarity": 1.0}], "id": 108, "stable_key": "clu_a5ba863c1af679a8", "ground_truth": {"modern_name": "Agaric fungus", "confidence": "high", "type": "plant", "family": "Agaricaceae", "description": "A purgative fungus used in historical medicine.", "note": "Refers to the medicinal properties of various fungi, particularly from the genus Fomes.", "wikipedia_extract": "Laricifomes officinalis, also known as agarikon, eburiko, or the quinine conk, is a wood-decay fungus that grows in large conks on the trunks of trees. It causes brown heart rot on conifers in Eurasia, Morocco, and North America. This fungus is the only member of the genus Laricifomes. There has been a history of human use of the fungus, from textiles, to ritualistic masks, and medicinal use; the name \"quinine conk\" refers to its bitter taste. There is recent scientific evidence of it having potency against several viruses. This mushroom is also known as Fomitopsis officinalis."}}, {"canonical_name": "Lisboa", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 75, "members": [{"entity_id": "lisboa", "book_id": "polyanthea_medicinal", "name": "Lisboa", "category": "PLACE", "subcategory": "CITY", "count": 55, "variants": ["Lisboa", "LISBOA", "Lisboade", "Lisbonenſe"], "contexts": ["city of the Archbishop", "Lisboa"]}, {"entity_id": "lisbonne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Lisbonne", "category": "PLACE", "subcategory": "CITY", "count": 7, "variants": ["Lisbonne"], "contexts": ["city where Adrien Balbi resided", "city where maps were traced"]}, {"entity_id": "lisboa", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Lisboa", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Lisboa"], "contexts": ["city where academy is located", "location of 'Mem. de Lisboa'"]}, {"entity_id": "lisbon", "book_id": "kosmos_humboldt_1845", "name": "Lisbon", "category": "PLACE", "subcategory": "CITY", "count": 7, "variants": ["Lisbon"], "contexts": ["city destroyed by earthquake", "city affected by great earthquake"]}, {"entity_id": "lisbona", "book_id": "historia_medicinal_monardes_1574", "name": "Lisbona", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Lisbona", "Lisboa"], "contexts": ["city from which stone was brought", "city from which a stone was brought"]}, {"entity_id": "caſtello_de_lisboa", "book_id": "polyanthea_medicinal", "name": "Caſtello de Lisboa", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Caſtello de Lisboa"], "contexts": ["location of Antonio Francisco"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Lisboa", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Lisbonne", "similarity": 0.932}, {"source_book": "polyanthea_medicinal", "source_name": "Lisboa", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Lisboa", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Lisboa", "target_book": "kosmos_humboldt_1845", "target_name": "Lisbon", "similarity": 0.959}, {"source_book": "polyanthea_medicinal", "source_name": "Lisboa", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lisbona", "similarity": 0.952}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lisbonne", "target_book": "kosmos_humboldt_1845", "target_name": "Lisbon", "similarity": 0.976}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lisbonne", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lisbona", "similarity": 0.981}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lisboa", "target_book": "kosmos_humboldt_1845", "target_name": "Lisbon", "similarity": 0.959}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lisboa", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lisbona", "similarity": 0.952}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lisboa", "target_book": "polyanthea_medicinal", "target_name": "Caſtello de Lisboa", "similarity": 0.842}, {"source_book": "kosmos_humboldt_1845", "source_name": "Lisbon", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lisbona", "similarity": 0.985}], "id": 109, "stable_key": "clu_e9993506f7d56d9d", "ground_truth": {"modern_name": "Lisbon", "confidence": "high", "type": "place", "description": "Capital and largest city of Portugal.", "wikipedia_extract": "Lisbon, officially the Very Noble and Ever Loyal City of Lisbon, is the capital and most populous municipality of Portugal, with an estimated population of 575,739, as of 2024, within its administrative limits and 3,028,000 within the metropolis, as of 2025. Lisbon is mainland Europe's westernmost capital city (second overall after Reykjavík), and the only one along the Atlantic coast, the others (Reykjavík and Dublin) being on islands. The city lies in the western portion of the Iberian Peninsula, on the northern shore of the River Tagus. The western portion of its metro area, the Portuguese Riviera, hosts the westernmost point of Continental Europe, culminating at Cabo da Roca. Lisbon is one of the oldest cities in the world and the second-oldest European capital city (after Athens), predating other modern European capitals by centuries. Settled by pre-Celtic tribes and later founded and civilized by the Phoenicians, Julius Caesar made it a municipium called Felicitas Julia, adding the term to the name Olissipo."}}, {"canonical_name": "lepra", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 4, "total_mentions": 74, "members": [{"entity_id": "lepra", "book_id": "polyanthea_medicinal", "name": "lepra", "category": "DISEASE", "subcategory": "CHRONIC", "count": 53, "variants": ["lepra", "Lepra", "lepra Græcorum", "lepra branca", "lepram", "lepras", "lepras rebeldes", "leprous"], "contexts": ["skin disease", "leprosy"]}, {"entity_id": "lepry", "book_id": "english_physician_1652", "name": "Lepry", "category": "DISEASE", "subcategory": "CHRONIC", "count": 9, "variants": ["Lepry"], "contexts": ["skin disease cured by Elm-Tree", "skin disease"]}, {"entity_id": "leprous", "book_id": "english_physician_1652", "name": "Leprous", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["Leprous"], "contexts": ["heads cured by ly"]}, {"entity_id": "lepra", "book_id": "historia_medicinal_monardes_1574", "name": "Lepra", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["Lepra"], "contexts": ["disease name, possibly referring to leprosy", "skin disease"]}, {"entity_id": "lepra", "book_id": "coloquios_da_orta_1563", "name": "lepra", "category": "DISEASE", "subcategory": "CHRONIC", "count": 5, "variants": ["lepra"], "contexts": ["disease caused by milk and fish", "leprosy, treated with the stone"]}, {"entity_id": "alepra", "book_id": "polyanthea_medicinal", "name": "alepra", "category": "DISEASE", "subcategory": "CHRONIC", "count": 3, "variants": ["alepra"], "contexts": ["skin disease treated by snake broths", "contagious disease"]}, {"entity_id": "belepra", "book_id": "polyanthea_medicinal", "name": "belepra", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["belepra"], "contexts": ["leprosy, a chronic infectious disease"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "lepra", "target_book": "english_physician_1652", "target_name": "Lepry", "similarity": 0.85}, {"source_book": "polyanthea_medicinal", "source_name": "lepra", "target_book": "english_physician_1652", "target_name": "Leprous", "similarity": 0.905}, {"source_book": "polyanthea_medicinal", "source_name": "lepra", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lepra", "similarity": 0.99}, {"source_book": "polyanthea_medicinal", "source_name": "lepra", "target_book": "coloquios_da_orta_1563", "target_name": "lepra", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Lepry", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lepra", "similarity": 0.851}, {"source_book": "english_physician_1652", "source_name": "Lepry", "target_book": "coloquios_da_orta_1563", "target_name": "lepra", "similarity": 0.85}, {"source_book": "english_physician_1652", "source_name": "Leprous", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lepra", "similarity": 0.913}, {"source_book": "english_physician_1652", "source_name": "Leprous", "target_book": "coloquios_da_orta_1563", "target_name": "lepra", "similarity": 0.905}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Lepra", "target_book": "coloquios_da_orta_1563", "target_name": "lepra", "similarity": 0.99}, {"source_book": "coloquios_da_orta_1563", "source_name": "lepra", "target_book": "polyanthea_medicinal", "target_name": "alepra", "similarity": 0.848}, {"source_book": "coloquios_da_orta_1563", "source_name": "lepra", "target_book": "polyanthea_medicinal", "target_name": "belepra", "similarity": 0.842}], "id": 110, "stable_key": "clu_a5b72a6abc431417", "ground_truth": {"modern_name": "Leprosy", "confidence": "high", "type": "disease", "description": "A chronic infectious disease affecting skin and nerves.", "note": "Covers historical understanding and terminology for leprosy.", "wikipedia_extract": "Leprosy, also known as Hansen's disease (HD), is a long-term infection by the bacteria Mycobacterium leprae or Mycobacterium lepromatosis. Infection can lead to damage of the nerves, respiratory tract, skin, and eyes. This nerve damage may result in the loss of nociception, which can lead to the loss of parts of a person's extremities from repeated injuries or infection through unnoticed wounds. An infected person may also experience muscle weakness and loss of eyesight. Leprosy symptoms may begin within one year or take 20 years or more. Leprosy is spread between people, although extensive contact is necessary."}}, {"canonical_name": "Honey", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 71, "members": [{"entity_id": "honey", "book_id": "english_physician_1652", "name": "Honey", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 65, "variants": ["Honey"], "contexts": ["ingredient added to decoction", "honey if it be to clens the womb"]}, {"entity_id": "honey", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Honey", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Honey"], "contexts": ["used in various remedies", "sweet substance used as vehicle"]}, {"entity_id": "honey", "book_id": "kosmos_humboldt_1845", "name": "honey", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["honey"], "contexts": ["substance with specific density"]}, {"entity_id": "honey", "book_id": "polyanthea_medicinal", "name": "honey", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["honey"], "contexts": ["doubled quantity mixed with remedy"]}, {"entity_id": "honey_of_r••es", "book_id": "english_physician_1652", "name": "Honey of R••es", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Honey of R••es"], "contexts": ["medicinal preparation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Honey", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Honey", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Honey", "target_book": "kosmos_humboldt_1845", "target_name": "honey", "similarity": 0.98}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Honey", "target_book": "kosmos_humboldt_1845", "target_name": "honey", "similarity": 0.98}, {"source_book": "polyanthea_medicinal", "source_name": "honey", "target_book": "english_physician_1652", "target_name": "Honey of R••es", "similarity": 0.813}], "id": 111, "stable_key": "clu_898a2e190a1d99c4", "ground_truth": {"wikipedia_extract": "Honey is a sweet and viscous substance made by several species of bees, the best-known of which are honey bees. Honey is made and stored to nourish bee colonies. Bees produce honey by gathering and then refining the sugary secretions of plants (primarily floral nectar) or the secretions of other insects, like the honeydew of aphids. This refinement takes place both within individual bees, through regurgitation and enzymatic activity, and during storage in the hive, through water evaporation that concentrates the honey's sugars until it is thick and viscous. Honey bees stockpile honey in the hive. Within the hive is a structure made from wax called honeycomb."}}, {"canonical_name": "freneticos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 4, "total_mentions": 69, "members": [{"entity_id": "freneticos", "book_id": "polyanthea_medicinal", "name": "freneticos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 66, "variants": ["freneticos", "Frenefi", "Frenefis", "Frenet", "Freneticos", "Freneſi", "frene", "frenefis", "frenei", "frenesi", "frenesis", "frenesí", "frenetica", "frenetico", "frenetis", "freneſi", "freneſis", "fresneſi", "phrenitis"], "contexts": ["frenetic individuals", "patients suffering from frenzy"]}, {"entity_id": "frenetick", "book_id": "english_physician_1652", "name": "Frenetick", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Frenetick"], "contexts": ["condition treated by Vervain"]}, {"entity_id": "frenezia", "book_id": "historia_medicinal_monardes_1574", "name": "frenezia", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["frenezia"], "contexts": ["frenzy, a mortal sign"]}, {"entity_id": "frenética", "book_id": "coloquios_da_orta_1563", "name": "frenética", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["frenética"], "contexts": ["state of being frenzied"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "freneticos", "target_book": "english_physician_1652", "target_name": "Frenetick", "similarity": 0.892}, {"source_book": "polyanthea_medicinal", "source_name": "freneticos", "target_book": "historia_medicinal_monardes_1574", "target_name": "frenezia", "similarity": 0.843}, {"source_book": "polyanthea_medicinal", "source_name": "freneticos", "target_book": "coloquios_da_orta_1563", "target_name": "frenética", "similarity": 0.969}, {"source_book": "english_physician_1652", "source_name": "Frenetick", "target_book": "coloquios_da_orta_1563", "target_name": "frenética", "similarity": 0.867}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "frenezia", "target_book": "coloquios_da_orta_1563", "target_name": "frenética", "similarity": 0.859}], "id": 112, "stable_key": "clu_63e267ebc442cbcc", "ground_truth": {"modern_name": "Frenzy", "confidence": "high", "type": "disease", "description": "A state of wild excitement or uncontrolled behavior.", "note": "Refers to historical medical concepts of mental agitation.", "wikipedia_extract": "Frenzy is a 1972 British neo-noir thriller film directed by Alfred Hitchcock in the penultimate feature film of his extensive career. The screenplay by Anthony Shaffer is based on the 1966 novel Goodbye Piccadilly, Farewell Leicester Square by Arthur La Bern. The film stars Jon Finch, Alec McCowen and Barry Foster and features Billie Whitelaw, Anna Massey, Barbara Leigh-Hunt, Bernard Cribbins and Vivien Merchant. The original music score was composed by Ron Goodwin. The plot centres on a serial killer in contemporary London and the ex-RAF serviceman he implicates. In a very early scene there is dialogue that mentions two actual London serial murder cases: the Christie murders in the 1940s–1950s and the Jack the Ripper murders in 1888."}}, {"canonical_name": "Tamarindos", "category": "PLANT", "subcategory": "PLANT", "book_count": 4, "total_mentions": 64, "members": [{"entity_id": "tamarindos", "book_id": "coloquios_da_orta_1563", "name": "Tamarindos", "category": "PLANT", "subcategory": "PLANT", "count": 33, "variants": ["Tamarindos", "Tamarindo", "Tamarindus indica", "Tamarix", "tamar", "tamar-hindi", "tamargueira", "tamargueiras", "tamarindi", "tamarindo", "tamarindos", "tamarinho", "tamarinhos", "tamarisco"], "contexts": ["medicinal and pleasant tasting fruit", "variant spelling of tamarind"]}, {"entity_id": "tamarins", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tamarins", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Tamarins"], "contexts": ["plant that likes dry, open places"]}, {"entity_id": "tamarindi", "book_id": "ricettario_fiorentino_1597", "name": "Tamarindi", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["Tamarindi", "Tamarindi frefchi", "tamarindi"], "contexts": ["tamarind fruit", "tamarinds passed through sieve"]}, {"entity_id": "tamarindos", "book_id": "polyanthea_medicinal", "name": "Tamarindos", "category": "PLANT", "subcategory": "PLANT", "count": 21, "variants": ["Tamarindos", "Tamarindis", "tamaragran", "tamargueyra", "tamarindi", "tamarindos"], "contexts": ["fruit used in preparations", "fruit used in medicine"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Tamarindos", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Tamarins", "similarity": 0.844}, {"source_book": "coloquios_da_orta_1563", "source_name": "Tamarindos", "target_book": "ricettario_fiorentino_1597", "target_name": "Tamarindi", "similarity": 0.857}, {"source_book": "coloquios_da_orta_1563", "source_name": "Tamarindos", "target_book": "polyanthea_medicinal", "target_name": "Tamarindos", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tamarins", "target_book": "ricettario_fiorentino_1597", "target_name": "Tamarindi", "similarity": 0.918}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tamarins", "target_book": "polyanthea_medicinal", "target_name": "Tamarindos", "similarity": 0.844}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Tamarindi", "target_book": "polyanthea_medicinal", "target_name": "Tamarindos", "similarity": 0.857}], "id": 113, "stable_key": "clu_4c8adcce3c8af344", "ground_truth": {"modern_name": "Tamarind", "confidence": "high", "type": "plant", "linnaean": "Tamarindus indica", "family": "Fabaceae", "description": "A tropical tree valued for its edible fruit.", "note": "Refers to the fruit and tree of the Tamarindus indica.", "wikipedia_extract": "Tamarind (Tamarindus indica) is a leguminous tree bearing edible fruit that is indigenous to tropical Africa and naturalized in Asia. The genus Tamarindus is monotypic, meaning that it contains only this species. It belongs to the family Fabaceae. The tamarind tree produces brown, pod-like fruits that contain a sweet, tangy pulp, which is used in cuisines around the world. The pulp is also used in traditional medicine and as a dye. The wood can be used for woodworking, and tamarind seed oil can be extracted from the seeds."}}, {"canonical_name": "Java", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 50, "members": [{"entity_id": "java", "book_id": "coloquios_da_orta_1563", "name": "Java", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 22, "variants": ["Java"], "contexts": ["island mentioned in Varthema's account", "island name"]}, {"entity_id": "java", "book_id": "origin_of_species_darwin_1859", "name": "Java", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Java"], "contexts": ["island in Indonesia", "location of plants"]}, {"entity_id": "java", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Java", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 10, "variants": ["Java"], "contexts": ["island in Indonesia", "island with population data"]}, {"entity_id": "javary", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Javary", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["Javary", "Jamary", "Javari", "Jayary"], "contexts": ["river in Brazil", "river in South America"]}, {"entity_id": "java", "book_id": "kosmos_humboldt_1845", "name": "Java", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Java"], "contexts": ["island in Indonesia", "location of experiments"]}, {"entity_id": "javanez", "book_id": "coloquios_da_orta_1563", "name": "javanez", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["javanez"], "contexts": ["language origin"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Java", "target_book": "origin_of_species_darwin_1859", "target_name": "Java", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Java", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Java", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Java", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Javary", "similarity": 0.826}, {"source_book": "coloquios_da_orta_1563", "source_name": "Java", "target_book": "kosmos_humboldt_1845", "target_name": "Java", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Java", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Java", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Java", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Javary", "similarity": 0.826}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Java", "target_book": "kosmos_humboldt_1845", "target_name": "Java", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Java", "target_book": "kosmos_humboldt_1845", "target_name": "Java", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Javary", "target_book": "kosmos_humboldt_1845", "target_name": "Java", "similarity": 0.826}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Javary", "target_book": "coloquios_da_orta_1563", "target_name": "javanez", "similarity": 0.823}], "id": 114, "stable_key": "clu_f21e26190787d827", "ground_truth": {"modern_name": "Java", "confidence": "high", "type": "place", "description": "A major island in Indonesia, historically significant for trade and exploration.", "note": "Distinguished from the Javary river in Brazil.", "wikipedia_extract": "Java is one of the Greater Sunda Islands in the South East Asian country of Indonesia. It is bordered by the Indian Ocean to the south and the Java Sea (a part of Pacific Ocean) to the north. With a population of 156.9 million people (including Madura) in mid 2024, projected to have risen to 158 million by mid-2025, Java is the world's most populous island, home to approximately 56% of the Indonesian population while constituting only 7% of its land area. Indonesia's capital city, Jakarta, is on Java's northwestern coast. Many of the best known events in Indonesian history took place on Java. It was the centre of powerful Hindu-Buddhist empires, the Islamic sultanates, and the core of the colonial Dutch East Indies."}}, {"canonical_name": "Barcelone", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 49, "members": [{"entity_id": "barcelone", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Barcelone", "category": "PLACE", "subcategory": "CITY", "count": 43, "variants": ["Barcelone", "Barcelona", "Barceloneta", "Barcelonetta"], "contexts": ["city in Venezuela", "city occupied today"]}, {"entity_id": "barcelona", "book_id": "kosmos_humboldt_1845", "name": "Barcelona", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Barcelona"], "contexts": ["location for hemisphere comparison"]}, {"entity_id": "barcelona", "book_id": "coloquios_da_orta_1563", "name": "Barcelona", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Barcelona"], "contexts": ["commercial city with spice tariffs", "city of the pharmacopoeia"]}, {"entity_id": "barcelona", "book_id": "polyanthea_medicinal", "name": "Barcelona", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Barcelona"], "contexts": ["city that experienced plague"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Barcelone", "target_book": "kosmos_humboldt_1845", "target_name": "Barcelona", "similarity": 0.96}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Barcelone", "target_book": "coloquios_da_orta_1563", "target_name": "Barcelona", "similarity": 0.96}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Barcelone", "target_book": "polyanthea_medicinal", "target_name": "Barcelona", "similarity": 0.96}, {"source_book": "kosmos_humboldt_1845", "source_name": "Barcelona", "target_book": "coloquios_da_orta_1563", "target_name": "Barcelona", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Barcelona", "target_book": "polyanthea_medicinal", "target_name": "Barcelona", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Barcelona", "target_book": "polyanthea_medicinal", "target_name": "Barcelona", "similarity": 1.0}], "id": 115, "stable_key": "clu_ef17545ed386751c", "ground_truth": {"modern_name": "Barcelona", "confidence": "high", "type": "place", "description": "A major commercial and historical city, sometimes confused with a Venezuelan city.", "note": "Primary reference is the city in Spain, but also a city in Venezuela is mentioned.", "wikipedia_extract": "Barcelona is a city on the northeastern coast of Spain. It is the capital and largest city of the autonomous community of Catalonia, as well as the second-most populous municipality of Spain. With a population of 1.7 million within city limits, its urban area extends to numerous neighbouring municipalities within the province of Barcelona and is home to around 5.7 million people, making it the fifth most populous urban area of the European Union after Paris, the Ruhr area, Madrid and Milan. It is one of the largest metropolises on the Mediterranean Sea, located on the coast between the mouths of the rivers Llobregat and Besòs, bounded to the west by the Serra de Collserola mountain range. According to tradition, Barcelona was founded by either the Phoenicians or the Carthaginians, who had trading posts along the Catalonian coast. In the Middle Ages, Barcelona became the capital of the County of Barcelona."}}, {"canonical_name": "quartas", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 4, "total_mentions": 45, "members": [{"entity_id": "quartas", "book_id": "polyanthea_medicinal", "name": "quartas", "category": "DISEASE", "subcategory": "ACUTE", "count": 27, "variants": ["quartas", "Quartaa", "Quartana", "Quartanam", "Quartas", "quartana", "quartanas", "quartans", "quartãs", "quartās"], "contexts": ["quartan fevers", "Quartan fever"]}, {"entity_id": "quartan_agues", "book_id": "english_physician_1652", "name": "Quartan Agues", "category": "DISEASE", "subcategory": "ACUTE", "count": 13, "variants": ["Quartan Agues", "Quartan", "Quartan Ague", "Quartane Agues", "Quar∣tanes"], "contexts": ["fever cured by sympathy to Saturn", "ague removed by the herb"]}, {"entity_id": "quartana", "book_id": "historia_medicinal_monardes_1574", "name": "quartana", "category": "DISEASE", "subcategory": "ACUTE", "count": 3, "variants": ["quartana", "Quartanas"], "contexts": ["fever with daily chills", "fever, treated with balm before onset"]}, {"entity_id": "quartans", "book_id": "coloquios_da_orta_1563", "name": "quartans", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["quartans", "quartfias"], "contexts": ["quartan fevers, potentially treated by the stone", "fevers, likely quartan fevers"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "quartas", "target_book": "english_physician_1652", "target_name": "Quartan Agues", "similarity": 0.884}, {"source_book": "polyanthea_medicinal", "source_name": "quartas", "target_book": "historia_medicinal_monardes_1574", "target_name": "quartana", "similarity": 0.967}, {"source_book": "polyanthea_medicinal", "source_name": "quartas", "target_book": "coloquios_da_orta_1563", "target_name": "quartans", "similarity": 0.979}, {"source_book": "english_physician_1652", "source_name": "Quartan Agues", "target_book": "historia_medicinal_monardes_1574", "target_name": "quartana", "similarity": 0.878}, {"source_book": "english_physician_1652", "source_name": "Quartan Agues", "target_book": "coloquios_da_orta_1563", "target_name": "quartans", "similarity": 0.891}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "quartana", "target_book": "coloquios_da_orta_1563", "target_name": "quartans", "similarity": 0.976}], "id": 116, "stable_key": "clu_b3bafc6ad0a2cb5f", "ground_truth": {"modern_name": "Quartan fever", "confidence": "high", "type": "disease", "description": "A type of malaria characterized by fevers occurring every fourth day.", "wikipedia_extract": "Quartan fever is one of the four types of malaria which can be contracted by humans. It is specifically caused by the Plasmodium malariae species, one of the six species of the protozoan genus Plasmodium. Quartan fever is a form of malaria where an onset of fever occurs in an interval of three to four days, hence the name \"quartan\". It is transmitted by bites of infected female mosquitoes of the genus Anopheles. Symptoms include fevers which range from approximately 40–41 °C (104–106 °F) and occur periodically in 72 hour intervals. Although cases of malaria have occurred throughout the world, quartan fever typically occurs in the subtropics."}}, {"canonical_name": "Cairo", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 41, "members": [{"entity_id": "cairo", "book_id": "coloquios_da_orta_1563", "name": "Cairo", "category": "PLACE", "subcategory": "CITY", "count": 28, "variants": ["Cairo", "cairo"], "contexts": ["city where substance is transported overland", "city on the Nile"]}, {"entity_id": "caire", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Caire", "category": "PLACE", "subcategory": "CITY", "count": 11, "variants": ["Caire", "Cairi", "Kaire"], "contexts": ["location of subsidiary canals", "city with low barometric variations"]}, {"entity_id": "cairo", "book_id": "kosmos_humboldt_1845", "name": "Cairo", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Cairo"], "contexts": ["capital city of Egypt"]}, {"entity_id": "cairo", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cairo", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Cairo"], "contexts": ["location of Ibn Junis' observations"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Cairo", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Caire", "similarity": 0.986}, {"source_book": "coloquios_da_orta_1563", "source_name": "Cairo", "target_book": "kosmos_humboldt_1845", "target_name": "Cairo", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Cairo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cairo", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Caire", "target_book": "kosmos_humboldt_1845", "target_name": "Cairo", "similarity": 0.986}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Caire", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cairo", "similarity": 0.986}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cairo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cairo", "similarity": 1.0}], "id": 117, "stable_key": "clu_a7e67c564f671201", "ground_truth": {"modern_name": "Cairo", "confidence": "high", "type": "place", "description": "Capital city of Egypt, located on the Nile River.", "wikipedia_extract": "Cairo is the capital and largest city of Egypt and the Cairo Governorate. It is home to more than 10.5 million people. It is also part of the largest urban agglomeration in Africa, the Arab world, and the Middle East. The Greater Cairo metropolitan area is one of the largest in the world by population with over 22 million people. Areas of what would become Cairo were inhabited from pre-dynastic and early-dynastic ancient Egypt c. 6000 years ago, as the Giza pyramid complex and the ancient cities of Memphis and Heliopolis are today within the city. Located near the Nile Delta, the predecessor city was Fustat following Babylon."}}, {"canonical_name": "Berlin", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 40, "members": [{"entity_id": "berlin", "book_id": "kosmos_humboldt_1845", "name": "Berlin", "category": "PLACE", "subcategory": "CITY", "count": 18, "variants": ["Berlin"], "contexts": ["city where lectures were delivered", "location of lectures and assembly"]}, {"entity_id": "berlin", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Berlin", "category": "PLACE", "subcategory": "CITY", "count": 14, "variants": ["Berlin"], "contexts": ["capital of Germany", "city for barometric leveling"]}, {"entity_id": "berlin", "book_id": "principles_of_psychology_james_1890", "name": "Berlin", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Berlin"], "contexts": ["location of publication"]}, {"entity_id": "berlin", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Berlin", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Berlin"], "contexts": ["location for parallax observation", "city where Neptune was found"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Berlin", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Berlin", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Berlin", "target_book": "principles_of_psychology_james_1890", "target_name": "Berlin", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Berlin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Berlin", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Berlin", "target_book": "principles_of_psychology_james_1890", "target_name": "Berlin", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Berlin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Berlin", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Berlin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Berlin", "similarity": 1.0}], "id": 118, "stable_key": "clu_0850f731ddc2008b", "ground_truth": {"modern_name": "Berlin", "confidence": "high", "type": "place", "description": "Capital city of Germany, a location of scientific and cultural significance.", "wikipedia_extract": "Berlin is the capital of Germany, as well as its largest city by both area and population. With 3.7 million inhabitants, it has the highest population within its city limits of any city in the European Union. The city is also one of the states of Germany, being the third-smallest state in the country by area. Berlin is surrounded by the state of Brandenburg, and Brandenburg's capital Potsdam is nearby. The urban area of Berlin has a population of over 4.6 million, making it the most populous in Germany. The Berlin-Brandenburg capital region has around 6.2 million inhabitants and is Germany's second-largest metropolitan region after the Rhine-Ruhr region, as well as the fifth-biggest metropolitan region by GDP in the European Union."}}, {"canonical_name": "pendulum", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 4, "total_mentions": 40, "members": [{"entity_id": "pendulum", "book_id": "connexion_physical_sciences_somerville_1858", "name": "pendulum", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 24, "variants": ["Pendulum", "pendulum"], "contexts": ["device for measuring time/gravity", "used to determine Earth's figure"]}, {"entity_id": "pendule", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pendule", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["pendule"], "contexts": ["used for observations", "instrument for measuring oscillations"]}, {"entity_id": "pendulum", "book_id": "principles_of_psychology_james_1890", "name": "pendulum", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["pendulum"], "contexts": ["device for time measurement", "object that swings back and forth"]}, {"entity_id": "pendulum", "book_id": "kosmos_humboldt_1845", "name": "Pendulum", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 11, "variants": ["Pendulum", "pendulum"], "contexts": ["instrument for measuring density and geological constitution", "instrument for measuring time/gravity"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "pendulum", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "pendule", "similarity": 0.959}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "pendulum", "target_book": "principles_of_psychology_james_1890", "target_name": "pendulum", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "pendulum", "target_book": "kosmos_humboldt_1845", "target_name": "Pendulum", "similarity": 0.957}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pendule", "target_book": "principles_of_psychology_james_1890", "target_name": "pendulum", "similarity": 0.959}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pendule", "target_book": "kosmos_humboldt_1845", "target_name": "Pendulum", "similarity": 0.91}, {"source_book": "principles_of_psychology_james_1890", "source_name": "pendulum", "target_book": "kosmos_humboldt_1845", "target_name": "Pendulum", "similarity": 0.957}], "id": 119, "stable_key": "clu_e30be5c468851a6d", "ground_truth": {"modern_name": "Pendulum", "confidence": "high", "type": "OBJECT", "description": "A weight suspended from a fixed point, swinging freely.", "wikipedia_extract": "A pendulum is a device made of a weight suspended from a pivot so that it can swing freely. When a pendulum is displaced sideways from its resting, equilibrium position, it is subject to a restoring force due to gravity that will accelerate it back toward the equilibrium position. When released, the restoring force acting on the pendulum's mass causes it to oscillate about the equilibrium position, swinging back and forth. The time for one complete cycle, a left swing and a right swing, is called the period. The period depends on the length of the pendulum and also to a slight degree on the amplitude, the width of the pendulum's swing. The SI unit of the period of a pendulum is the second (s)."}}, {"canonical_name": "bees", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 4, "total_mentions": 39, "members": [{"entity_id": "bees", "book_id": "origin_of_species_darwin_1859", "name": "bees", "category": "ANIMAL", "subcategory": "INSECT", "count": 18, "variants": ["Bees", "bees"], "contexts": ["flying insects that pollinate", "beneficial to clover fertilization"]}, {"entity_id": "bees", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Bees", "category": "ANIMAL", "subcategory": "INSECT", "count": 2, "variants": ["Bees"], "contexts": ["social flying insects", "emerge from corrupt Oxe"]}, {"entity_id": "beetles", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Beetles", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["Beetles"], "contexts": ["worshipped insects"]}, {"entity_id": "bee", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Bee", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["Bee"], "contexts": ["insect found in amber"]}, {"entity_id": "bees", "book_id": "english_physician_1652", "name": "Bees", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 9, "variants": ["Bees"], "contexts": ["insect with sting", "insects that gather nectar"]}, {"entity_id": "bee", "book_id": "origin_of_species_darwin_1859", "name": "Bee", "category": "ANIMAL", "subcategory": "INSECT", "count": 6, "variants": ["bee", "Bee"], "contexts": ["social insect that makes honey", "insect with a stinging tail"]}, {"entity_id": "parasitic_bees", "book_id": "origin_of_species_darwin_1859", "name": "parasitic bees", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["parasitic bees"], "contexts": ["bees with natural instincts"]}, {"entity_id": "bees", "book_id": "principles_of_psychology_james_1890", "name": "bees", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["bees"], "contexts": ["insects studied for reasoning"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "bees", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Bees", "similarity": 0.99}, {"source_book": "origin_of_species_darwin_1859", "source_name": "bees", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Beetles", "similarity": 0.866}, {"source_book": "origin_of_species_darwin_1859", "source_name": "bees", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Bee", "similarity": 0.93}, {"source_book": "origin_of_species_darwin_1859", "source_name": "bees", "target_book": "english_physician_1652", "target_name": "Bees", "similarity": 0.857}, {"source_book": "origin_of_species_darwin_1859", "source_name": "bees", "target_book": "principles_of_psychology_james_1890", "target_name": "bees", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bees", "target_book": "english_physician_1652", "target_name": "Bees", "similarity": 0.877}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bees", "target_book": "origin_of_species_darwin_1859", "target_name": "Bee", "similarity": 0.93}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bees", "target_book": "origin_of_species_darwin_1859", "target_name": "parasitic bees", "similarity": 0.86}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bees", "target_book": "principles_of_psychology_james_1890", "target_name": "bees", "similarity": 0.99}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Beetles", "target_book": "origin_of_species_darwin_1859", "target_name": "Bee", "similarity": 0.832}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Beetles", "target_book": "principles_of_psychology_james_1890", "target_name": "bees", "similarity": 0.866}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bee", "target_book": "english_physician_1652", "target_name": "Bees", "similarity": 0.833}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bee", "target_book": "origin_of_species_darwin_1859", "target_name": "Bee", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bee", "target_book": "principles_of_psychology_james_1890", "target_name": "bees", "similarity": 0.93}, {"source_book": "english_physician_1652", "source_name": "Bees", "target_book": "origin_of_species_darwin_1859", "target_name": "Bee", "similarity": 0.833}, {"source_book": "english_physician_1652", "source_name": "Bees", "target_book": "principles_of_psychology_james_1890", "target_name": "bees", "similarity": 0.857}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Bee", "target_book": "principles_of_psychology_james_1890", "target_name": "bees", "similarity": 0.93}, {"source_book": "origin_of_species_darwin_1859", "source_name": "parasitic bees", "target_book": "principles_of_psychology_james_1890", "target_name": "bees", "similarity": 0.873}], "id": 120, "stable_key": "clu_8958e56043dd1909", "ground_truth": {"modern_name": "Bees", "confidence": "high", "type": "animal", "description": "Social insects known for honey production and pollination.", "wikipedia_extract": "Bees are winged insects that form a monophyletic clade Anthophila within the superfamily Apoidea of the order Hymenoptera, with over 20,000 known species in seven recognized families. Some species – including honey bees, bumblebees, and stingless bees – are social insects living in highly hierarchical colonies, while over 90% of bee species – including mason bees, carpenter bees, leafcutter bees, and sweat bees – are solitary. Members of the most well-known bee genus, Apis (i.e. honey bees), are known to construct hexagonally celled waxy nests called hives. Unlike the closely related wasps and ants, who are carnivorous/omnivorous, bees are herbivores that specifically feed on nectar (nectarivory) and pollen (palynivory), the former primarily as a carbohydrate source for metabolic energy, and the latter primarily for protein and other nutrients for their larvae. They are found on every continent except Antarctica, and in every habitat on the planet that contains insect-pollinated flowering plants. The most common bees in the Northern Hemisphere are the Halictidae, or sweat bees, but they are small and often mistaken for wasps or flies."}}, {"canonical_name": "Siberia", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 4, "total_mentions": 34, "members": [{"entity_id": "siberia", "book_id": "kosmos_humboldt_1845", "name": "Siberia", "category": "PLACE", "subcategory": "COUNTRY", "count": 13, "variants": ["Siberia"], "contexts": ["destination of scientific journey", "region of barren steppes"]}, {"entity_id": "siberia", "book_id": "origin_of_species_darwin_1859", "name": "Siberia", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Siberia"], "contexts": ["region with arctic plants", "vast geographical region of Russia"]}, {"entity_id": "sibérie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sibérie", "category": "PLACE", "subcategory": "REGION", "count": 8, "variants": ["Sibérie"], "contexts": ["region in Russian Empire", "region with sugar consumption"]}, {"entity_id": "new_siberia", "book_id": "kosmos_humboldt_1845", "name": "New Siberia", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["New Siberia"], "contexts": ["island with wood-hills", "location of 'Wood Hills'"]}, {"entity_id": "siberian_alti", "book_id": "kosmos_humboldt_1845", "name": "Siberian Alti", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Siberian Alti"], "contexts": ["mountain range"]}, {"entity_id": "siberian_coast", "book_id": "kosmos_humboldt_1845", "name": "Siberian coast", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Siberian coast"], "contexts": ["coast of the Polar Sea"]}, {"entity_id": "siberian_journey", "book_id": "kosmos_humboldt_1845", "name": "Siberian journey", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Siberian journey"], "contexts": ["geographical expedition undertaken"]}, {"entity_id": "siberia", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Siberia", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Siberia"], "contexts": ["adjacent continent to Ochotzk Sea", "region with chilly winds affecting Asia and America"]}, {"entity_id": "siberia,_eastern", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Siberia, Eastern", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Siberia, Eastern"], "contexts": ["depression of barometer observed in"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Siberia", "target_book": "origin_of_species_darwin_1859", "target_name": "Siberia", "similarity": 0.87}, {"source_book": "kosmos_humboldt_1845", "source_name": "Siberia", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Sibérie", "similarity": 0.842}, {"source_book": "kosmos_humboldt_1845", "source_name": "Siberia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Siberia", "similarity": 0.87}, {"source_book": "kosmos_humboldt_1845", "source_name": "Siberia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Siberia, Eastern", "similarity": 0.821}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Siberia", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Sibérie", "similarity": 0.967}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Siberia", "target_book": "kosmos_humboldt_1845", "target_name": "New Siberia", "similarity": 0.899}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Siberia", "target_book": "kosmos_humboldt_1845", "target_name": "Siberian Alti", "similarity": 0.877}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Siberia", "target_book": "kosmos_humboldt_1845", "target_name": "Siberian coast", "similarity": 0.858}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Siberia", "target_book": "kosmos_humboldt_1845", "target_name": "Siberian journey", "similarity": 0.847}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Siberia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Siberia", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Siberia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Siberia, Eastern", "similarity": 0.919}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sibérie", "target_book": "kosmos_humboldt_1845", "target_name": "New Siberia", "similarity": 0.864}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sibérie", "target_book": "kosmos_humboldt_1845", "target_name": "Siberian Alti", "similarity": 0.864}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sibérie", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Siberia", "similarity": 0.967}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sibérie", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Siberia, Eastern", "similarity": 0.893}, {"source_book": "kosmos_humboldt_1845", "source_name": "New Siberia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Siberia", "similarity": 0.899}, {"source_book": "kosmos_humboldt_1845", "source_name": "New Siberia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Siberia, Eastern", "similarity": 0.842}, {"source_book": "kosmos_humboldt_1845", "source_name": "Siberian Alti", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Siberia", "similarity": 0.877}, {"source_book": "kosmos_humboldt_1845", "source_name": "Siberian Alti", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Siberia, Eastern", "similarity": 0.844}, {"source_book": "kosmos_humboldt_1845", "source_name": "Siberian coast", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Siberia", "similarity": 0.858}, {"source_book": "kosmos_humboldt_1845", "source_name": "Siberian journey", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Siberia", "similarity": 0.847}], "id": 121, "stable_key": "clu_6c43ab07c899f7ff", "ground_truth": {"modern_name": "Siberia", "confidence": "high", "type": "place", "description": "A vast geographical region within the Russian Empire.", "wikipedia_extract": "Siberia ( sy-BEER-ee-ə; Russian: Сибирь, romanized: Sibir', IPA: [sʲɪˈbʲirʲ] ), also known as Asian Russia, is an extensive geographical region comprising all of North Asia, from the Ural Mountains in the west (with the Ural River usually forming the southernmost portion of its western boundary) to the Pacific Ocean in the east. It has formed a part of the sovereign territory of Russia and its predecessor states since the lengthy conquest of Siberia, which began with the fall of the Khanate of Sibir in 1582 and concluded with the annexation of Chukotka in 1778. Siberia is vast and sparsely populated, covering an area of over 13.1 million square kilometres (5,100,000 mi2) – about three-quarters of Russia's total area, but home to roughly a quarter of Russia's population. Novosibirsk, Krasnoyarsk, and Omsk are the largest cities in the area. Because Siberia is a geographic and historic concept and not a political entity, there is no single precise definition of its territorial borders. It is further defined as stretching from the territories within the Arctic Circle in the north to the northern borders of Kazakhstan, Mongolia, and China in the south, although the hills of north-central Kazakhstan are also commonly included."}}, {"canonical_name": "heart", "category": "ANATOMY", "subcategory": "ORGAN", "book_count": 4, "total_mentions": 33, "members": [{"entity_id": "heart", "book_id": "first_principles_spencer_1862", "name": "heart", "category": "ANATOMY", "subcategory": "ORGAN", "count": 14, "variants": ["heart"], "contexts": ["initially aggregation of cells forming cavity and walls", "pulsating blood-vessel in embryo"]}, {"entity_id": "heart", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "heart", "category": "ANATOMY", "subcategory": "ORGAN", "count": 6, "variants": ["heart"], "contexts": ["central organ of circulation", "organ associated with irascible passions"]}, {"entity_id": "heart", "book_id": "principles_of_psychology_james_1890", "name": "heart", "category": "ANATOMY", "subcategory": "ORGAN", "count": 11, "variants": ["heart"], "contexts": ["organ that pumps blood", "organ that stops and palpitates"]}, {"entity_id": "heart", "book_id": "kosmos_humboldt_1845", "name": "heart", "category": "ANATOMY", "subcategory": "ORGAN", "count": 2, "variants": ["heart"], "contexts": ["softened by nature when shaken", "organ shaken by sorrow"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "heart", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "heart", "similarity": 1.0}, {"source_book": "first_principles_spencer_1862", "source_name": "heart", "target_book": "principles_of_psychology_james_1890", "target_name": "heart", "similarity": 1.0}, {"source_book": "first_principles_spencer_1862", "source_name": "heart", "target_book": "kosmos_humboldt_1845", "target_name": "heart", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "heart", "target_book": "principles_of_psychology_james_1890", "target_name": "heart", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "heart", "target_book": "kosmos_humboldt_1845", "target_name": "heart", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "heart", "target_book": "kosmos_humboldt_1845", "target_name": "heart", "similarity": 1.0}], "id": 122, "stable_key": "clu_30aee58a6a377b99", "ground_truth": {"modern_name": "heart", "confidence": "high", "type": "concept", "wikidata_id": "Q1072", "wikidata_description": "inner organ for the circulation of blood", "wikipedia_url": "https://en.wikipedia.org/wiki/Heart", "wikipedia_extract": "The heart is a muscular organ found in humans and other animals. This organ pumps blood through the blood vessels. The heart and blood vessels together make up the circulatory system. The pumped blood carries oxygen and nutrients to the tissue, while carrying metabolic waste such as carbon dioxide to the lungs. In humans, the heart is approximately the size of a closed fist and is located between the lungs, in the middle compartment of the chest, called the mediastinum. In humans, the heart is divided into four chambers: upper left and right atria and lower left and right ventricles."}}, {"canonical_name": "Rosewater", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 4, "total_mentions": 33, "members": [{"entity_id": "rosewater", "book_id": "english_physician_1652", "name": "Rosewater", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 9, "variants": ["Rosewater", "Red Rose Water", "Red Rose-water", "Rose Water"], "contexts": ["added to Cawdle", "fragrant liquid made from roses"]}, {"entity_id": "agua_rosada", "book_id": "historia_medicinal_monardes_1574", "name": "agua rosada", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 5, "variants": ["agua rosada"], "contexts": ["preparation mixed with soliman water", "rose water mixed with balsam"]}, {"entity_id": "agua_rosada", "book_id": "coloquios_da_orta_1563", "name": "agua rosada", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 7, "variants": ["agua rosada"], "contexts": ["used for mixing", "scented water"]}, {"entity_id": "rosada", "book_id": "coloquios_da_orta_1563", "name": "rosada", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["rosada"], "contexts": ["rose water, an ingredient", "rose water"]}, {"entity_id": "agua_rosada", "book_id": "polyanthea_medicinal", "name": "agua rosada", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 7, "variants": ["agua rosada", "agua Rosada"], "contexts": ["rose water", "rose water for lotion"]}, {"entity_id": "rosado", "book_id": "polyanthea_medicinal", "name": "Rosado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["Rosado", "rosado"], "contexts": ["rose-flavored ingredient in an electuary", "aromatic powder for stomach fomentation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Rosewater", "target_book": "historia_medicinal_monardes_1574", "target_name": "agua rosada", "similarity": 0.914}, {"source_book": "english_physician_1652", "source_name": "Rosewater", "target_book": "coloquios_da_orta_1563", "target_name": "agua rosada", "similarity": 0.914}, {"source_book": "english_physician_1652", "source_name": "Rosewater", "target_book": "coloquios_da_orta_1563", "target_name": "rosada", "similarity": 0.868}, {"source_book": "english_physician_1652", "source_name": "Rosewater", "target_book": "polyanthea_medicinal", "target_name": "agua rosada", "similarity": 0.914}, {"source_book": "english_physician_1652", "source_name": "Rosewater", "target_book": "polyanthea_medicinal", "target_name": "Rosado", "similarity": 0.849}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "agua rosada", "target_book": "coloquios_da_orta_1563", "target_name": "agua rosada", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "agua rosada", "target_book": "coloquios_da_orta_1563", "target_name": "rosada", "similarity": 0.854}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "agua rosada", "target_book": "polyanthea_medicinal", "target_name": "agua rosada", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "agua rosada", "target_book": "polyanthea_medicinal", "target_name": "agua rosada", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "rosada", "target_book": "polyanthea_medicinal", "target_name": "agua rosada", "similarity": 0.854}, {"source_book": "coloquios_da_orta_1563", "source_name": "rosada", "target_book": "polyanthea_medicinal", "target_name": "Rosado", "similarity": 0.938}], "id": 123, "stable_key": "clu_4db5e28563a879f2", "ground_truth": {"modern_name": "Rosewater", "confidence": "high", "type": "chemical", "description": "Fragrant liquid distilled from roses, used in medicine and cosmetics.", "wikipedia_extract": "Rose water or rosewater is a flavoured water created by steeping rose petals in water. It is typically made as a by-product during the distillation of rose petals to create rose oil for perfumes. Rose water is widely utilized to flavour culinary dishes and enhance cosmetic products, and it is significant in religious rituals throughout Eurasia. Iran is a major producer, supplying around 90% of the world's rose water demand. Central Iran is home to the annual Golabgiri festival each spring. Thousands of tourists visit the area to celebrate the rose harvest for the production of rosewater."}}, {"canonical_name": "ventosidades", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 4, "total_mentions": 33, "members": [{"entity_id": "ventosidades", "book_id": "historia_medicinal_monardes_1574", "name": "ventosidades", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 12, "variants": ["ventosidades", "ventofedad", "ventofedades", "ventoledades", "ventos", "ventosidad", "ventoſedades"], "contexts": ["condition resolved by preparation", "intestinal gas"]}, {"entity_id": "windiness", "book_id": "english_physician_1652", "name": "Windiness", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 8, "variants": ["Windiness", "windiness", "windiness in the Body", "windiness in the Spleen"], "contexts": ["condition discussed by Angelica", "condition of the mother treated with dill decoction"]}, {"entity_id": "ventosidades", "book_id": "coloquios_da_orta_1563", "name": "ventosidades", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["ventosidades"], "contexts": ["condition resolved by galamga"]}, {"entity_id": "vento", "book_id": "polyanthea_medicinal", "name": "vento", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["vento", "vento sidades"], "contexts": ["wind or gas, humor", "cause of hiccups"]}, {"entity_id": "ventoſidades", "book_id": "polyanthea_medicinal", "name": "ventoſidades", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 7, "variants": ["ventoſidades", "ventosidades"], "contexts": ["flatulence", "Condition caused by drinking wine too soon"]}, {"entity_id": "ventosidades_grossas", "book_id": "coloquios_da_orta_1563", "name": "ventosidades grossas", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["ventosidades grossas"], "contexts": ["thick flatulence"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "ventosidades", "target_book": "english_physician_1652", "target_name": "Windiness", "similarity": 0.905}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "ventosidades", "target_book": "coloquios_da_orta_1563", "target_name": "ventosidades", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "ventosidades", "target_book": "polyanthea_medicinal", "target_name": "vento", "similarity": 0.894}, {"source_book": "english_physician_1652", "source_name": "Windiness", "target_book": "coloquios_da_orta_1563", "target_name": "ventosidades", "similarity": 0.905}, {"source_book": "english_physician_1652", "source_name": "Windiness", "target_book": "polyanthea_medicinal", "target_name": "vento", "similarity": 0.89}, {"source_book": "coloquios_da_orta_1563", "source_name": "ventosidades", "target_book": "polyanthea_medicinal", "target_name": "vento", "similarity": 0.894}, {"source_book": "polyanthea_medicinal", "source_name": "ventoſidades", "target_book": "coloquios_da_orta_1563", "target_name": "ventosidades grossas", "similarity": 0.86}], "id": 124, "stable_key": "clu_79892e6f67f603a1", "ground_truth": {"modern_name": "Flatulence", "confidence": "high", "type": "disease", "description": "Accumulation of gas in the digestive tract; intestinal wind.", "note": "Includes terms for intestinal gas, windiness, and flatulence.", "wikipedia_extract": "Flatulence is the expulsion of gas from the intestines via the anus, commonly referred to as farting. \"Flatus\" is the medical word for gas generated in the stomach or bowels. A proportion of intestinal gas may be swallowed environmental air; hence, flatus is not entirely generated in the stomach or bowels. The scientific study of this area of medicine is termed flatology. Passing gas is a normal bodily process. Flatus is brought to the rectum and pressurized by muscles in the intestines. It is normal to pass flatus (\"to fart\"), though volume and frequency vary greatly among individuals."}}, {"canonical_name": "Oximel", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 4, "total_mentions": 32, "members": [{"entity_id": "oximel", "book_id": "polyanthea_medicinal", "name": "Oximel", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 23, "variants": ["Oximel", "oximel", "oximel esquilitico"], "contexts": ["simple oxymel mixture", "mixture of honey and vinegar"]}, {"entity_id": "oximel", "book_id": "english_physician_1652", "name": "Oximel", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Oximel"], "contexts": ["mixture of honey and vinegar"]}, {"entity_id": "oximel", "book_id": "coloquios_da_orta_1563", "name": "oximel", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["oximel"], "contexts": ["preparation with seeds"]}, {"entity_id": "oximelfe", "book_id": "ricettario_fiorentino_1597", "name": "oximelfe", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["oximelfe", "Oximele"], "contexts": ["sweet and sour mixture for pills", "oxymel, a preparation of honey and vinegar"]}, {"entity_id": "oxymcl", "book_id": "ricettario_fiorentino_1597", "name": "Oxymcl", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Oxymcl"], "contexts": ["Oxymel, preparation with honey and vinegar"]}, {"entity_id": "oximel_simplez", "book_id": "polyanthea_medicinal", "name": "oximel simplez", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["oximel simplez", "oxymel simplez"], "contexts": ["compound medicine", "medicinal preparation"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Oximel", "target_book": "english_physician_1652", "target_name": "Oximel", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Oximel", "target_book": "coloquios_da_orta_1563", "target_name": "oximel", "similarity": 0.981}, {"source_book": "polyanthea_medicinal", "source_name": "Oximel", "target_book": "ricettario_fiorentino_1597", "target_name": "oximelfe", "similarity": 0.91}, {"source_book": "polyanthea_medicinal", "source_name": "Oximel", "target_book": "ricettario_fiorentino_1597", "target_name": "Oxymcl", "similarity": 0.876}, {"source_book": "english_physician_1652", "source_name": "Oximel", "target_book": "coloquios_da_orta_1563", "target_name": "oximel", "similarity": 0.981}, {"source_book": "english_physician_1652", "source_name": "Oximel", "target_book": "ricettario_fiorentino_1597", "target_name": "oximelfe", "similarity": 0.91}, {"source_book": "english_physician_1652", "source_name": "Oximel", "target_book": "ricettario_fiorentino_1597", "target_name": "Oxymcl", "similarity": 0.876}, {"source_book": "english_physician_1652", "source_name": "Oximel", "target_book": "polyanthea_medicinal", "target_name": "oximel simplez", "similarity": 0.813}, {"source_book": "coloquios_da_orta_1563", "source_name": "oximel", "target_book": "ricettario_fiorentino_1597", "target_name": "oximelfe", "similarity": 0.926}, {"source_book": "coloquios_da_orta_1563", "source_name": "oximel", "target_book": "ricettario_fiorentino_1597", "target_name": "Oxymcl", "similarity": 0.877}, {"source_book": "coloquios_da_orta_1563", "source_name": "oximel", "target_book": "polyanthea_medicinal", "target_name": "oximel simplez", "similarity": 0.841}], "id": 125, "stable_key": "clu_86bf3f9df149500f", "ground_truth": {"modern_name": "Oxymel", "confidence": "high", "type": "chemical", "description": "A medicinal preparation of honey and vinegar.", "wikipedia_extract": "Oxymel (from Latin 'acid and honey', from Ancient Greek  ὀξύς 'acid' and  μέλι 'honey') is a mixture of honey and vinegar, historically used as a medicine. Its name is often found in Renaissance (and later) pharmacopoeiae in Late Latin form as either a countable or uncountable noun. As a countable noun, it is spelled variously as (singular) oxymellus and oxymellis, and Oxymelli. Fit vinum ex aceto & melle quod oxymel vocaverunt voce Graecanica. Nam oξ(?) dicitur Graecis acetu & μίλ mel. Fit autem oxymel hoc modo."}}, {"canonical_name": "Man", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 4, "total_mentions": 30, "members": [{"entity_id": "man", "book_id": "origin_of_species_darwin_1859", "name": "Man", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 15, "variants": ["Man", "man"], "contexts": ["human agent in selection processes", "human agent in domestication and selection"]}, {"entity_id": "manatee", "book_id": "origin_of_species_darwin_1859", "name": "Manatee", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["manatee", "Manatee"], "contexts": ["aquatic marine mammal", "animal with rudimentary nails on fin"]}, {"entity_id": "manaiis", "book_id": "relation_historique_humboldt_vol3_1825", "name": "manaiis", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["manaiis"], "contexts": ["alternative name for manatees"]}, {"entity_id": "human_race", "book_id": "kosmos_humboldt_1845", "name": "human race", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 6, "variants": ["human race"], "contexts": ["species with physical gradations", "all of humanity as a species"]}, {"entity_id": "man", "book_id": "kosmos_humboldt_1845", "name": "Man", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 4, "variants": ["man", "Man"], "contexts": ["human species", "human being"]}, {"entity_id": "human", "book_id": "first_principles_spencer_1862", "name": "human", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["human"], "contexts": ["species with a single uterus body"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Man", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "manaiis", "similarity": 0.813}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Man", "target_book": "kosmos_humboldt_1845", "target_name": "Man", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Man", "target_book": "first_principles_spencer_1862", "target_name": "human", "similarity": 0.888}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Manatee", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "manaiis", "similarity": 0.88}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "manaiis", "target_book": "kosmos_humboldt_1845", "target_name": "Man", "similarity": 0.813}, {"source_book": "kosmos_humboldt_1845", "source_name": "human race", "target_book": "first_principles_spencer_1862", "target_name": "human", "similarity": 0.858}, {"source_book": "kosmos_humboldt_1845", "source_name": "Man", "target_book": "first_principles_spencer_1862", "target_name": "human", "similarity": 0.888}], "id": 126, "stable_key": "clu_b8a6091a78a2fc92", "ground_truth": {"modern_name": "Manatee", "confidence": "high", "type": "animal", "linnaean": "Trichechus manatus", "family": "Trichechidae", "description": "Large, aquatic marine mammal with paddle-like flippers.", "note": "The cluster includes references to 'Manatee', 'manaiis', and 'Man', where 'Man' in the context of 'origin_of_species' likely refers to human agency in selection, not the animal itself. However, 'Manatee' and 'manaiis' are direct references to the animal.", "wikipedia_extract": "The West Indian manatee (Trichechus manatus), also known as the North American manatee, is a large, aquatic mammal native to warm coastal areas of the Caribbean, from the Eastern United States to northern Brazil. Living alone or in herds, it feeds on underwater plants and uses its whiskers to navigate. It is divided into two subspecies, the Florida manatee (T. m. latirostris) in the United States and the Antillean manatee (T. m. manatus) in the Caribbean, both of which are endangered and face pressure from habitat loss, pollution, and other human activity. The West Indian manatee is the largest living member of the sirenians (order Sirenia), a group of large aquatic mammals that includes the dugong, other manatees, and the extinct Steller's sea cow. Manatees are herbivores, have developed vocal communication abilities, and are covered in highly sensitive whiskers (called vibrissae) that are used for feeding and navigation. In breeding season, several males form mating herds around an individual female; on average, one calf is born to a female manatee every two to three years."}}, {"canonical_name": "Turquia", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 4, "total_mentions": 30, "members": [{"entity_id": "turquia", "book_id": "coloquios_da_orta_1563", "name": "Turquia", "category": "PLACE", "subcategory": "COUNTRY", "count": 26, "variants": ["Turquia"], "contexts": ["origin of physicians", "Country where medicine is used"]}, {"entity_id": "turquie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Turquie", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Turquie"], "contexts": ["country with sugar consumption", "country consuming sugar"]}, {"entity_id": "turchia", "book_id": "ricettario_fiorentino_1597", "name": "Turchia", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Turchia"], "contexts": ["Turkey, origin of rhubarb"]}, {"entity_id": "turkey", "book_id": "first_principles_spencer_1862", "name": "Turkey", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Turkey"], "contexts": ["origin in example phrase"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Turquia", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Turquie", "similarity": 0.995}, {"source_book": "coloquios_da_orta_1563", "source_name": "Turquia", "target_book": "ricettario_fiorentino_1597", "target_name": "Turchia", "similarity": 0.994}, {"source_book": "coloquios_da_orta_1563", "source_name": "Turquia", "target_book": "first_principles_spencer_1862", "target_name": "Turkey", "similarity": 0.967}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Turquie", "target_book": "ricettario_fiorentino_1597", "target_name": "Turchia", "similarity": 0.991}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Turquie", "target_book": "first_principles_spencer_1862", "target_name": "Turkey", "similarity": 0.961}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Turchia", "target_book": "first_principles_spencer_1862", "target_name": "Turkey", "similarity": 0.966}], "id": 127, "stable_key": "clu_8c567fc9476d7911", "ground_truth": {"modern_name": "Turkey", "confidence": "high", "type": "place", "description": "Country of origin for physicians and rhubarb; also associated with sugar consumption.", "wikipedia_extract": "Turkey, officially the Republic of Türkiye, is a country mainly located in Anatolia in West Asia, with a relatively small part called East Thrace in Southeast Europe. It borders the Black Sea to the north; Georgia, Armenia, Azerbaijan, and Iran to the east; Iraq, Syria, and the Mediterranean Sea to the south; and the Aegean Sea, Greece, and Bulgaria to the west. Turkey is home to over 86 million people; most are ethnic Turks, while Kurds are the largest ethnic minority. Officially a secular state, Turkey has a Muslim-majority population. Ankara is Turkey's capital and second-largest city. Istanbul is its largest city and economic center."}}, {"canonical_name": "Strabo", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 4, "total_mentions": 29, "members": [{"entity_id": "strabo", "book_id": "kosmos_humboldt_1845", "name": "Strabo", "category": "PERSON", "subcategory": "AUTHORITY", "count": 20, "variants": ["Strabo"], "contexts": ["ancient geographer", "ancient Greek geographer"]}, {"entity_id": "strabo", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Strabo", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Strabo"], "contexts": ["ancient geographer and historian", "ancient geographer, cited as source"]}, {"entity_id": "strabo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Strabo", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Strabo", "Strabon"], "contexts": ["ancient geographer"]}, {"entity_id": "strabão", "book_id": "coloquios_da_orta_1563", "name": "Strabão", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Strabão"], "contexts": ["version of Megasthenes' Indica", "ancient geographer"]}, {"entity_id": "estrabo", "book_id": "coloquios_da_orta_1563", "name": "Estrabo", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Estrabo"], "contexts": ["ancient geographer cited", "ancient author cited"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Strabo", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Strabo", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Strabo", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Strabo", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Strabo", "target_book": "coloquios_da_orta_1563", "target_name": "Strabão", "similarity": 0.928}, {"source_book": "kosmos_humboldt_1845", "source_name": "Strabo", "target_book": "coloquios_da_orta_1563", "target_name": "Estrabo", "similarity": 0.846}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Strabo", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Strabo", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Strabo", "target_book": "coloquios_da_orta_1563", "target_name": "Strabão", "similarity": 0.928}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Strabo", "target_book": "coloquios_da_orta_1563", "target_name": "Estrabo", "similarity": 0.846}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Strabo", "target_book": "coloquios_da_orta_1563", "target_name": "Strabão", "similarity": 0.928}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Strabo", "target_book": "coloquios_da_orta_1563", "target_name": "Estrabo", "similarity": 0.846}], "id": 128, "stable_key": "clu_2ee450a4c7e4e042", "ground_truth": {"modern_name": "Strabo", "confidence": "high", "type": "person", "description": "Ancient Greek geographer, historian, and philosopher.", "wikipedia_extract": "Strabo (; Greek: Στράβων, romanized: Strábōn; 64 or 63 BC – c. 24 AD) was an ancient Greek geographer who lived in Asia Minor during the transitional period of the Roman Republic into the Roman Empire. He is best known for his work Geographica, which presented a descriptive history of people and places from different regions of the world known during his lifetime. Additionally, Strabo authored historical works, but only fragments and quotations of these survive in the writings of other authors. Strabo was born to an affluent family from Amaseia in Pontus in around 64 BC. His family had been involved in politics since at least the reign of Mithridates V. Strabo was related to Dorylaeus on his mother's side."}}, {"canonical_name": "Suisse", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 4, "total_mentions": 28, "members": [{"entity_id": "suisse", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Suisse", "category": "PLACE", "subcategory": "COUNTRY", "count": 15, "variants": ["Suisse"], "contexts": ["country in Europe", "country with Alps"]}, {"entity_id": "switzerland", "book_id": "origin_of_species_darwin_1859", "name": "Switzerland", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Switzerland"], "contexts": ["location of ant observations", "location where slaves and masters work together"]}, {"entity_id": "switzerland", "book_id": "kosmos_humboldt_1845", "name": "Switzerland", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Switzerland"], "contexts": ["country visited"]}, {"entity_id": "switzerland", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Switzerland", "category": "PLACE", "subcategory": "COUNTRY", "count": 8, "variants": ["Switzerland"], "contexts": ["country with lofty mountain peaks", "country where bise wind is found"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Suisse", "target_book": "origin_of_species_darwin_1859", "target_name": "Switzerland", "similarity": 0.976}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Suisse", "target_book": "kosmos_humboldt_1845", "target_name": "Switzerland", "similarity": 0.976}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Suisse", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Switzerland", "similarity": 0.976}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Switzerland", "target_book": "kosmos_humboldt_1845", "target_name": "Switzerland", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Switzerland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Switzerland", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Switzerland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Switzerland", "similarity": 1.0}], "id": 129, "stable_key": "clu_988c30ace4f586da", "ground_truth": {"modern_name": "Switzerland", "confidence": "high", "type": "place", "description": "European country known for the Alps.", "wikipedia_extract": "Switzerland, officially the Swiss Confederation, is a landlocked country located at the intersection of Central, Western, and Southern Europe. It is bordered by Germany to the north, France to the west, Austria and Liechtenstein to the east, and Italy to the south. Switzerland is geographically divided among the Swiss Alps, the Swiss Plateau, and the Jura mountains; the Alps cover most of the country's territory, whereas the majority of its 9 million people are concentrated on the plateau, which hosts many of the largest cities and economic centres, including Zurich, Geneva, Basel, Bern, Lausanne, Winterthur, and Lucerne. Switzerland is a federal republic composed of 26 cantons, with Bern serving as the federal city and the seat of the national government. The country encompasses four principal linguistic and cultural regions—German, French, Italian, and Romansh—reflecting a long-standing tradition of multilingualism and cultural pluralism. Swiss national identity nonetheless remains fairly cohesive, rooted in a shared historical background, common values such as federalism and direct democracy, and Alpine symbolism."}}, {"canonical_name": "ear", "category": "ANATOMY", "subcategory": "BODY_PART", "book_count": 4, "total_mentions": 26, "members": [{"entity_id": "ear", "book_id": "principles_of_psychology_james_1890", "name": "ear", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 16, "variants": ["ear"], "contexts": ["organ of hearing", "organ of hearing, receives results of piano key action"]}, {"entity_id": "ears", "book_id": "origin_of_species_darwin_1859", "name": "ears", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["ears"], "contexts": ["drooping due to disuse of muscles"]}, {"entity_id": "ears", "book_id": "principles_of_psychology_james_1890", "name": "ears", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 2, "variants": ["ears"], "contexts": ["sensory organ for hearing", "organs of hearing"]}, {"entity_id": "ear", "book_id": "connexion_physical_sciences_somerville_1858", "name": "ear", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 6, "variants": ["ear"], "contexts": ["astonishing acuteness and delicacy of the ear", "organ of hearing"]}, {"entity_id": "ears", "book_id": "first_principles_spencer_1862", "name": "ears", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["ears"], "contexts": ["organ of hearing"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "ear", "target_book": "origin_of_species_darwin_1859", "target_name": "ears", "similarity": 0.982}, {"source_book": "principles_of_psychology_james_1890", "source_name": "ear", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ear", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "ear", "target_book": "first_principles_spencer_1862", "target_name": "ears", "similarity": 0.982}, {"source_book": "origin_of_species_darwin_1859", "source_name": "ears", "target_book": "principles_of_psychology_james_1890", "target_name": "ears", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "ears", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ear", "similarity": 0.982}, {"source_book": "origin_of_species_darwin_1859", "source_name": "ears", "target_book": "first_principles_spencer_1862", "target_name": "ears", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "ears", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ear", "similarity": 0.982}, {"source_book": "principles_of_psychology_james_1890", "source_name": "ears", "target_book": "first_principles_spencer_1862", "target_name": "ears", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "ear", "target_book": "first_principles_spencer_1862", "target_name": "ears", "similarity": 0.982}], "id": 130, "stable_key": "clu_37f544dbe8ec16e5", "ground_truth": {"modern_name": "ear", "confidence": "high", "type": "anatomy", "description": "Organ responsible for hearing.", "wikipedia_extract": "In vertebrates, an ear is the organ that enables hearing and (in mammals) body balance using the vestibular system. In humans, the ear is described as having three parts:  the outer ear, the middle ear and the inner ear. The outer ear consists of the auricle, the visible outer part, and the ear canal. The middle ear includes the tympanic cavity and the three ossicles. The inner ear sits in the bony labyrinth, and contains structures which are key to several senses: the semicircular canals, which enable balance and eye tracking when moving; the utricle and saccule, which enable balance when stationary; and the cochlea, which enables hearing. The ear canal is cleaned via earwax, which naturally migrates to the auricle."}}, {"canonical_name": "Cornelius Celfus", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 4, "total_mentions": 26, "members": [{"entity_id": "cornelius_celfus", "book_id": "polyanthea_medicinal", "name": "Cornelius Celfus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 21, "variants": ["Cornelius Celfus", "Cornel. Celf", "Cornel. Celf.", "Cornel. Cell.", "Cornel. Cels.", "Cornel.Cell.", "Cornelio Cello", "Cornelio Celso", "Cornelio Celſo"], "contexts": ["ancient author of de Re Medica", "author of 'deLienofis morbis'"]}, {"entity_id": "cornelius_tacitus", "book_id": "kosmos_humboldt_1845", "name": "Cornelius Tacitus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Cornelius Tacitus"], "contexts": ["recipient of Pliny's letter"]}, {"entity_id": "cornelio_celso", "book_id": "historia_medicinal_monardes_1574", "name": "Cornelio Celso", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Cornelio Celso"], "contexts": ["ancient authority on medicine"]}, {"entity_id": "cornelio_celso", "book_id": "coloquios_da_orta_1563", "name": "Cornelio Celso", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Cornelio Celso", "Comelio Celso"], "contexts": ["ancient authority who calls calamus alexandrino", "ancient medical writer"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Cornelius Celfus", "target_book": "kosmos_humboldt_1845", "target_name": "Cornelius Tacitus", "similarity": 0.853}, {"source_book": "polyanthea_medicinal", "source_name": "Cornelius Celfus", "target_book": "historia_medicinal_monardes_1574", "target_name": "Cornelio Celso", "similarity": 0.904}, {"source_book": "polyanthea_medicinal", "source_name": "Cornelius Celfus", "target_book": "coloquios_da_orta_1563", "target_name": "Cornelio Celso", "similarity": 0.904}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cornelius Tacitus", "target_book": "historia_medicinal_monardes_1574", "target_name": "Cornelio Celso", "similarity": 0.802}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cornelius Tacitus", "target_book": "coloquios_da_orta_1563", "target_name": "Cornelio Celso", "similarity": 0.802}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Cornelio Celso", "target_book": "coloquios_da_orta_1563", "target_name": "Cornelio Celso", "similarity": 1.0}], "id": 131, "stable_key": "clu_d46da080623bf5f1", "ground_truth": {"modern_name": "Aulus Cornelius Celsus", "confidence": "high", "type": "person", "description": "Roman encyclopedist and medical writer, author of De Medicina.", "wikipedia_extract": "Aulus Cornelius Celsus (c. 25 BC – c. 50 AD) was a Roman encyclopedist, known for his extant medical work, De Medicina, which is believed to be the only surviving section of a much larger encyclopedia. The De Medicina is a primary source on diet, pharmacy, surgery and related fields, and it is one of the best sources concerning medical knowledge in the Roman world. The lost portions of his encyclopedia likely included volumes on agriculture, law, rhetoric, and military arts. He made contributions to the classification of human skin disorders in  dermatology, such as myrmecia, and his name is often found in medical terminology regarding the skin, e.g., kerion celsi and area celsi. He is also the namesake of Paracelsus (lit. Above Celsus), a great Swiss alchemist and physician prevalent in the Medical Renaissance."}}, {"canonical_name": "Greenland", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 4, "total_mentions": 24, "members": [{"entity_id": "greenland", "book_id": "kosmos_humboldt_1845", "name": "Greenland", "category": "PLACE", "subcategory": "COUNTRY", "count": 10, "variants": ["Greenland"], "contexts": ["northernmost observation point", "location of observation"]}, {"entity_id": "greenland", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Greenland", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Greenland"], "contexts": ["geographic location"]}, {"entity_id": "groenland", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Groenland", "category": "PLACE", "subcategory": "COUNTRY", "count": 6, "variants": ["Groenland", "Grônland"], "contexts": ["Greenland", "location mentioned in reference"]}, {"entity_id": "west_greenland", "book_id": "kosmos_humboldt_1845", "name": "West Greenland", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["West Greenland"], "contexts": ["geographic region mentioned in passage", "region in Greenland"]}, {"entity_id": "greenland", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Greenland", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Greenland"], "contexts": ["northern coast where tidal wave was seen", "northern coast with extreme cold"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Greenland", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Greenland", "similarity": 0.849}, {"source_book": "kosmos_humboldt_1845", "source_name": "Greenland", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Groenland", "similarity": 0.908}, {"source_book": "kosmos_humboldt_1845", "source_name": "Greenland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Greenland", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Greenland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Greenland", "similarity": 0.849}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Groenland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Greenland", "similarity": 0.908}, {"source_book": "kosmos_humboldt_1845", "source_name": "West Greenland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Greenland", "similarity": 0.882}], "id": 132, "stable_key": "clu_6235cec379b1e3f2", "ground_truth": {"modern_name": "Greenland", "confidence": "high", "type": "place", "country": "Greenland", "wikidata_id": "Q223", "wikidata_description": "autonomous territory of the Kingdom of Denmark and world's largest island", "wikipedia_url": "https://en.wikipedia.org/wiki/Greenland", "wikipedia_extract": "Greenland is an autonomous territory of the Kingdom of Denmark and is the largest of the kingdom's three constituent parts by land area, the others being Denmark proper and the Faroe Islands. Citizens of Greenland are citizens of Denmark. They are thus citizens of the European Union (EU), although Greenland is not part of the EU. It is the world's largest island and lies between the Arctic and Atlantic oceans, east of the Canadian Arctic Archipelago. It shares a small 1.2-kilometre (0.75 mi) border with Canada on Hans Island. The capital and largest city is Nuuk."}}, {"canonical_name": "ber", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 4, "total_mentions": 24, "members": [{"entity_id": "ber", "book_id": "coloquios_da_orta_1563", "name": "ber", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 14, "variants": ["ber", "Ber"], "contexts": ["Fruit name in Decam", "location mentioned in passage"]}, {"entity_id": "beryls", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Beryls", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["Beryls"], "contexts": ["gemstone", "stones subject to fusion in fire"]}, {"entity_id": "berils", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Berils", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Berils"], "contexts": ["gem similar to Crystal", "generation of berils"]}, {"entity_id": "beril", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Beril", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Beril"], "contexts": ["mineral with attractive quality"]}, {"entity_id": "beryl", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Beryl", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Beryl"], "contexts": ["gem"]}, {"entity_id": "beryls", "book_id": "kosmos_humboldt_1845", "name": "beryls", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["beryls"], "contexts": ["magnificent crystals"]}, {"entity_id": "beryl", "book_id": "connexion_physical_sciences_somerville_1858", "name": "beryl", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["beryl"], "contexts": ["negative crystal with two optic axes", "crystal with optical properties"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "ber", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Beryls", "similarity": 0.902}, {"source_book": "coloquios_da_orta_1563", "source_name": "ber", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Berils", "similarity": 0.92}, {"source_book": "coloquios_da_orta_1563", "source_name": "ber", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Beril", "similarity": 0.915}, {"source_book": "coloquios_da_orta_1563", "source_name": "ber", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Beryl", "similarity": 0.882}, {"source_book": "coloquios_da_orta_1563", "source_name": "ber", "target_book": "kosmos_humboldt_1845", "target_name": "beryls", "similarity": 0.917}, {"source_book": "coloquios_da_orta_15