kipedia_extract": "Beryl ( BERR-əl) is a mineral composed of beryllium aluminium silicate with the chemical formula Be3Al2(SiO3)6. Well-known varieties of beryl include emerald and aquamarine. Naturally occurring  hexagonal crystals of beryl can be up to several meters in size, but terminated crystals are relatively rare. Pure beryl is colorless, but it is frequently tinted by impurities; possible colors are green, blue, yellow, pink, and red (the rarest). It is an ore source of beryllium. The word beryl – Middle English: beril – is borrowed, via Old French: beryl and Latin: beryllus, from Ancient Greek βήρυλλος bḗryllos, which referred to various blue-green stones, from Prakrit veruḷiya, veḷuriya 'beryl' which is ultimately of Dravidian origin, maybe from the name of Belur or Velur, a town in Karnataka, southern India."}}, {"canonical_name": "agrimonia", "category": "PLANT", "subcategory": "PLANT", "book_count": 4, "total_mentions": 24, "members": [{"entity_id": "agrimonia", "book_id": "polyanthea_medicinal", "name": "agrimonia", "category": "PLANT", "subcategory": "PLANT", "count": 14, "variants": ["agrimonia"], "contexts": ["herb used in a medicinal preparation", "ingredient in a medicinal preparation"]}, {"entity_id": "agrimony", "book_id": "english_physician_1652", "name": "Agrimony", "category": "PLANT", "subcategory": "PLANT", "count": 7, "variants": ["Agrimony", "Agrimòny"], "contexts": ["herb with dented leaves and yellow flowers", "herb that strengthens the liver"]}, {"entity_id": "agrimoma", "book_id": "coloquios_da_orta_1563", "name": "Agrimoma", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Agrimoma"], "contexts": ["plant name", "herb"]}, {"entity_id": "agrimonia", "book_id": "ricettario_fiorentino_1597", "name": "Agrimonia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Agrimonia"], "contexts": ["plant commonly called Agrimonia"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "agrimonia", "target_book": "english_physician_1652", "target_name": "Agrimony", "similarity": 0.866}, {"source_book": "polyanthea_medicinal", "source_name": "agrimonia", "target_book": "coloquios_da_orta_1563", "target_name": "Agrimoma", "similarity": 0.851}, {"source_book": "polyanthea_medicinal", "source_name": "agrimonia", "target_book": "ricettario_fiorentino_1597", "target_name": "Agrimonia", "similarity": 0.848}, {"source_book": "english_physician_1652", "source_name": "Agrimony", "target_book": "coloquios_da_orta_1563", "target_name": "Agrimoma", "similarity": 0.875}, {"source_book": "english_physician_1652", "source_name": "Agrimony", "target_book": "ricettario_fiorentino_1597", "target_name": "Agrimonia", "similarity": 0.843}], "id": 134, "stable_key": "clu_fb0065676d3d83ac", "ground_truth": {"modern_name": "Agrimony", "confidence": "high", "type": "plant", "linnaean": "Agrimonia eupatoria", "family": "Rosaceae", "description": "An herb with yellow flowers, historically used in medicine.", "wikipedia_extract": "Agrimonia eupatoria is a species of agrimony that is often referred to as common agrimony, church steeples or sticklewort. The whole plant is dark green with numerous soft hairs. The soft hairs aid in the plant's seed pods sticking to any animal or person coming in contact with the plant. The flower spikes have a spicy odor like apricots. In the language of flowers, agrimony means thankfulness or gratitude. Agrimonia eupatoria is a foodplant for the caterpillars of the snout moth Endotricha flammealis."}}, {"canonical_name": "New-York", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 24, "members": [{"entity_id": "new-york", "book_id": "relation_historique_humboldt_vol3_1825", "name": "New-York", "category": "PLACE", "subcategory": "CITY", "count": 10, "variants": ["New-York", "New York"], "contexts": ["state for comparison", "state with small relative population"]}, {"entity_id": "new_york", "book_id": "principles_of_psychology_james_1890", "name": "New York", "category": "PLACE", "subcategory": "CITY", "count": 7, "variants": ["NEW YORK", "New York"], "contexts": ["city of publication", "city where translation was published"]}, {"entity_id": "newark", "book_id": "principles_of_psychology_james_1890", "name": "Newark", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Newark"], "contexts": ["city visited by the subject"]}, {"entity_id": "new_york", "book_id": "kosmos_humboldt_1845", "name": "New York", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["New York"], "contexts": ["location for hemisphere comparison", "location with magnetic intensity"]}, {"entity_id": "new_york", "book_id": "connexion_physical_sciences_somerville_1858", "name": "New York", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["New York"], "contexts": ["location of Professor Draper"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "New-York", "target_book": "principles_of_psychology_james_1890", "target_name": "New York", "similarity": 0.984}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "New-York", "target_book": "principles_of_psychology_james_1890", "target_name": "Newark", "similarity": 0.862}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "New-York", "target_book": "kosmos_humboldt_1845", "target_name": "New York", "similarity": 0.984}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "New-York", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "New York", "similarity": 0.984}, {"source_book": "principles_of_psychology_james_1890", "source_name": "New York", "target_book": "kosmos_humboldt_1845", "target_name": "New York", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "New York", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "New York", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Newark", "target_book": "kosmos_humboldt_1845", "target_name": "New York", "similarity": 0.857}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Newark", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "New York", "similarity": 0.857}, {"source_book": "kosmos_humboldt_1845", "source_name": "New York", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "New York", "similarity": 1.0}], "id": 135, "stable_key": "clu_495337c25e2318cf", "ground_truth": {"modern_name": "New York", "confidence": "high", "type": "place", "description": "A major city and state in the United States.", "note": "Includes references to both the city and the state, as well as a nearby city (Newark).", "wikipedia_extract": "The geography of New York City is characterized by its coastal position at the meeting of the Hudson River and the Atlantic Ocean in a naturally sheltered harbor. The city's geography, with its scarce availability of land, is a contributing factor in making New York the most densely populated major city in the United States. Environmental issues are chiefly concerned with managing this density, which also explains why New York is among the most energy-efficient and least automobile-dependent cities in the United States. The city's climate is temperate. New York City is located on the coast of the Northeastern United States at the mouth of the Hudson River in southeastern New York state. It is located in the New York–New Jersey Harbor Estuary, the centerpiece of which is the New York Harbor, whose deep waters and sheltered bays helped the city grow in significance as a trading city."}}, {"canonical_name": "E. Forbes", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 23, "members": [{"entity_id": "e__forbes", "book_id": "origin_of_species_darwin_1859", "name": "E. Forbes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["E. Forbes"], "contexts": ["speaks confidently about shell coloration", "researches on marine life and depths"]}, {"entity_id": "forbes", "book_id": "origin_of_species_darwin_1859", "name": "Forbes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Forbes"], "contexts": ["naturalist and geologist", "E. Forbes independently arrived at a similar conclusion"]}, {"entity_id": "j__forbes", "book_id": "kosmos_humboldt_1845", "name": "J. Forbes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["J. Forbes"], "contexts": ["invented seismometer", "Professor who invented a self-registering apparatus"]}, {"entity_id": "professor_e__forbes", "book_id": "kosmos_humboldt_1845", "name": "Professor E. Forbes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Professor E. Forbes"], "contexts": ["co-author of 'Travels in Lycia'"]}, {"entity_id": "e__forbes", "book_id": "kosmos_humboldt_1845", "name": "E. Forbes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["E. Forbes"], "contexts": ["professor providing account of Santorino"]}, {"entity_id": "edward_forbes", "book_id": "kosmos_humboldt_1845", "name": "Edward Forbes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Edward Forbes"], "contexts": ["Professor discussing origin and diffusion of flora"]}, {"entity_id": "forbes,_professor_e_", "book_id": "kosmos_humboldt_1845", "name": "Forbes, Professor E.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Forbes, Professor E."], "contexts": ["researcher on travels and islands"]}, {"entity_id": "forbes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Forbes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Forbes"], "contexts": ["ascertained boiling point variation with height", "professor proving moon's light effect on thermometer"]}, {"entity_id": "edward_forbes", "book_id": "first_principles_spencer_1862", "name": "Edward Forbes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Edward Forbes"], "contexts": ["described naturalists examining animals as skins"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "E. Forbes", "target_book": "kosmos_humboldt_1845", "target_name": "J. Forbes", "similarity": 0.919}, {"source_book": "origin_of_species_darwin_1859", "source_name": "E. Forbes", "target_book": "kosmos_humboldt_1845", "target_name": "Professor E. Forbes", "similarity": 0.918}, {"source_book": "origin_of_species_darwin_1859", "source_name": "E. Forbes", "target_book": "kosmos_humboldt_1845", "target_name": "E. Forbes", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "E. Forbes", "target_book": "kosmos_humboldt_1845", "target_name": "Edward Forbes", "similarity": 0.901}, {"source_book": "origin_of_species_darwin_1859", "source_name": "E. Forbes", "target_book": "kosmos_humboldt_1845", "target_name": "Forbes, Professor E.", "similarity": 0.907}, {"source_book": "origin_of_species_darwin_1859", "source_name": "E. Forbes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Forbes", "similarity": 0.865}, {"source_book": "origin_of_species_darwin_1859", "source_name": "E. Forbes", "target_book": "first_principles_spencer_1862", "target_name": "Edward Forbes", "similarity": 0.901}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Forbes", "target_book": "kosmos_humboldt_1845", "target_name": "J. Forbes", "similarity": 0.85}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Forbes", "target_book": "kosmos_humboldt_1845", "target_name": "E. Forbes", "similarity": 0.865}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Forbes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Forbes", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "J. Forbes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Forbes", "similarity": 0.85}, {"source_book": "kosmos_humboldt_1845", "source_name": "J. Forbes", "target_book": "first_principles_spencer_1862", "target_name": "Edward Forbes", "similarity": 0.861}, {"source_book": "kosmos_humboldt_1845", "source_name": "Professor E. Forbes", "target_book": "first_principles_spencer_1862", "target_name": "Edward Forbes", "similarity": 0.836}, {"source_book": "kosmos_humboldt_1845", "source_name": "E. Forbes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Forbes", "similarity": 0.865}, {"source_book": "kosmos_humboldt_1845", "source_name": "E. Forbes", "target_book": "first_principles_spencer_1862", "target_name": "Edward Forbes", "similarity": 0.901}, {"source_book": "kosmos_humboldt_1845", "source_name": "Edward Forbes", "target_book": "first_principles_spencer_1862", "target_name": "Edward Forbes", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Forbes, Professor E.", "target_book": "first_principles_spencer_1862", "target_name": "Edward Forbes", "similarity": 0.808}], "id": 136, "stable_key": "clu_7faf6163b71499cd", "ground_truth": {"modern_name": "Edward Forbes", "confidence": "high", "type": "person", "description": "A naturalist and geologist, known for his conclusions on biogeography.", "note": "Distinguished from Forbes Winslow, a different author.", "wikipedia_extract": "Edward Forbes FRS, FGS (12 February 1815 – 18 November 1854) was a Manx naturalist. In 1846, he proposed that the distributions of montane plants and animals had been compressed downslope, and some oceanic islands connected to the mainland, during the recent ice age. This mechanism, which was the first natural explanation to explain the distributions of the same species on now-isolated islands and mountain tops, was discovered independently by Charles Darwin, who credited Forbes with the idea. He also incorrectly deduced the so-called azoic hypothesis, that life under the sea would decline to the point that no life forms could exist below a certain depth. Forbes was born at Douglas in the Isle of Man. His father was a well-to-do banker."}}, {"canonical_name": "Cordova", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 23, "members": [{"entity_id": "cordova", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cordova", "category": "PLACE", "subcategory": "CITY", "count": 17, "variants": ["Cordova", "Cordoba"], "contexts": ["location south of Pampas", "province in Buenos Aires"]}, {"entity_id": "cordova_del_tucuman", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cordova del Tucuman", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Cordova del Tucuman"], "contexts": ["division within a vice-royalty"]}, {"entity_id": "cordoua", "book_id": "historia_medicinal_monardes_1574", "name": "Cordoua", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Cordoua"], "contexts": ["city where a healer is from"]}, {"entity_id": "córdova", "book_id": "coloquios_da_orta_1563", "name": "Córdova", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Córdova"], "contexts": ["city in Spain"]}, {"entity_id": "cordova", "book_id": "polyanthea_medicinal", "name": "Cordova", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Cordova", "cordova"], "contexts": ["cordovan water for moistening vapors", "city known for its waters"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cordova", "target_book": "historia_medicinal_monardes_1574", "target_name": "Cordoua", "similarity": 0.843}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cordova", "target_book": "coloquios_da_orta_1563", "target_name": "Córdova", "similarity": 0.939}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cordova", "target_book": "polyanthea_medicinal", "target_name": "Cordova", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cordova del Tucuman", "target_book": "polyanthea_medicinal", "target_name": "Cordova", "similarity": 0.83}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Cordoua", "target_book": "polyanthea_medicinal", "target_name": "Cordova", "similarity": 0.843}, {"source_book": "coloquios_da_orta_1563", "source_name": "Córdova", "target_book": "polyanthea_medicinal", "target_name": "Cordova", "similarity": 0.939}], "id": 137, "stable_key": "clu_dafb7b0d2fcd24a6", "ground_truth": {"modern_name": "Córdoba", "confidence": "high", "type": "place", "description": "City in Spain, also a province in Argentina.", "wikipedia_extract": "Córdoba ( KOR-də-bə; Spanish: [ˈkoɾðoβa] ), or sometimes Cordova ( KOR-də-və), is a city in Andalusia, Spain, and the capital of the province of Córdoba. With a population of 324,902 as of 2024, it is the 12th-largest city in Spain and the 3rd-largest in Andalusia. The city primarily lies on the right bank of the Guadalquivir in the south of the Iberian Peninsula. Once a Roman colony, it was taken over by the Visigothic Kingdom in the sixth century and then conquered by the Muslims in the eighth century. Córdoba became the capital of the Emirate and then Caliphate of Córdoba, from which the Umayyad dynasty ruled al-Andalus. Under Umayyad rule, Córdoba was transformed into a centre of education and learning, and by the 10th century it had grown to be the second-largest city in Europe."}}, {"canonical_name": "wax", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 22, "members": [{"entity_id": "wax", "book_id": "origin_of_species_darwin_1859", "name": "wax", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 11, "variants": ["wax"], "contexts": ["material used by bees for comb construction", "material used for making cells"]}, {"entity_id": "wax", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Wax", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 8, "variants": ["wax", "Wax"], "contexts": ["waxy material", "soft, pliable substance"]}, {"entity_id": "wax", "book_id": "principles_of_psychology_james_1890", "name": "wax", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["wax"], "contexts": ["material easily impressed"]}, {"entity_id": "wax_candles", "book_id": "connexion_physical_sciences_somerville_1858", "name": "wax candles", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["wax candles"], "contexts": ["source of light for comparison"]}, {"entity_id": "wax_candle", "book_id": "connexion_physical_sciences_somerville_1858", "name": "wax candle", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["wax candle"], "contexts": ["light source for comparison"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "wax", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Wax", "similarity": 0.963}, {"source_book": "origin_of_species_darwin_1859", "source_name": "wax", "target_book": "principles_of_psychology_james_1890", "target_name": "wax", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "wax", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "wax candles", "similarity": 0.813}, {"source_book": "origin_of_species_darwin_1859", "source_name": "wax", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "wax candle", "similarity": 0.814}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Wax", "target_book": "principles_of_psychology_james_1890", "target_name": "wax", "similarity": 0.963}, {"source_book": "principles_of_psychology_james_1890", "source_name": "wax", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "wax candles", "similarity": 0.813}, {"source_book": "principles_of_psychology_james_1890", "source_name": "wax", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "wax candle", "similarity": 0.814}], "id": 138, "stable_key": "clu_8fa98b5e9b9adc5e", "ground_truth": {"modern_name": "wax", "confidence": "high", "type": "substance", "description": "A malleable, sticky substance secreted by bees to build their honeycomb.", "wikipedia_extract": "Waxes are a diverse class of organic compounds that are lipophilic solids that are  malleable near ambient temperatures. They include higher alkanes and lipids, typically with melting points above about 40 °C (104 °F), melting to give low viscosity liquids. Waxes are insoluble in water but soluble in nonpolar organic solvents such as hexane, benzene and chloroform. Natural waxes of various types are produced by plants and animals and occur in petroleum. Waxes are organic compounds that characteristically consist of long aliphatic alkyl chains, although aromatic compounds may also be present. Natural waxes may contain unsaturated bonds and include various functional groups such as fatty acids, primary and secondary alcohols, ketones, aldehydes and fatty acid esters."}}, {"canonical_name": "digestion", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 4, "total_mentions": 21, "members": [{"entity_id": "digestion", "book_id": "english_physician_1652", "name": "digestion", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 8, "variants": ["digestion", "Digestion", "digesting"], "contexts": ["process of breaking down food", "aided by Balm"]}, {"entity_id": "digestivo", "book_id": "coloquios_da_orta_1563", "name": "digestivo", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["digestivo"], "contexts": ["aiding digestion"]}, {"entity_id": "digestion", "book_id": "polyanthea_medicinal", "name": "digestion", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 8, "variants": ["digestion", "digesta", "digestione", "digestão", "digetao"], "contexts": ["process affected by eating habits", "process of breaking down food"]}, {"entity_id": "digerir", "book_id": "polyanthea_medicinal", "name": "Digerir", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 3, "variants": ["Digerir", "digere", "digerir"], "contexts": ["chemical process of preparing medicines", "to digest"]}, {"entity_id": "digestion", "book_id": "first_principles_spencer_1862", "name": "digestion", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["digestion"], "contexts": ["process of breaking down food"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "digestion", "target_book": "coloquios_da_orta_1563", "target_name": "digestivo", "similarity": 0.893}, {"source_book": "english_physician_1652", "source_name": "digestion", "target_book": "polyanthea_medicinal", "target_name": "digestion", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "digestion", "target_book": "polyanthea_medicinal", "target_name": "Digerir", "similarity": 0.888}, {"source_book": "english_physician_1652", "source_name": "digestion", "target_book": "first_principles_spencer_1862", "target_name": "digestion", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "digestivo", "target_book": "polyanthea_medicinal", "target_name": "digestion", "similarity": 0.893}, {"source_book": "coloquios_da_orta_1563", "source_name": "digestivo", "target_book": "polyanthea_medicinal", "target_name": "Digerir", "similarity": 0.844}, {"source_book": "coloquios_da_orta_1563", "source_name": "digestivo", "target_book": "first_principles_spencer_1862", "target_name": "digestion", "similarity": 0.893}, {"source_book": "polyanthea_medicinal", "source_name": "digestion", "target_book": "first_principles_spencer_1862", "target_name": "digestion", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Digerir", "target_book": "first_principles_spencer_1862", "target_name": "digestion", "similarity": 0.888}], "id": 139, "stable_key": "clu_5f286c5131455b1b", "ground_truth": {"modern_name": "Digestion", "confidence": "high", "type": "concept", "description": "The process of breaking down food for absorption by the body.", "note": "Can refer to the physiological process or a chemical preparation.", "wikipedia_extract": "Digestion is the breakdown of large insoluble food compounds into small water-soluble components so that they can be absorbed into the blood plasma. In certain organisms, these smaller substances are absorbed through the small intestine into the blood stream. Digestion is a form of catabolism that is often divided into two processes based on how food is broken down: mechanical and chemical digestion. The term mechanical digestion refers to the physical breakdown of large pieces of food into smaller pieces which can subsequently be accessed by digestive enzymes. Mechanical digestion takes place in the mouth through mastication and in the small intestine through segmentation contractions. In chemical digestion, enzymes break down food into the small compounds that the body can use."}}, {"canonical_name": "scale", "category": "OBJECT", "subcategory": "TOOL", "book_count": 4, "total_mentions": 21, "members": [{"entity_id": "scale", "book_id": "polyanthea_medicinal", "name": "scale", "category": "OBJECT", "subcategory": "TOOL", "count": 16, "variants": ["scale", "Scale", "scales"], "contexts": ["an instrument for weighing", "instrument for weighing"]}, {"entity_id": "scale", "book_id": "english_physician_1652", "name": "Scale", "category": "OBJECT", "subcategory": "TOOL", "count": 1, "variants": ["Scale"], "contexts": ["measuring instrument"]}, {"entity_id": "scale", "book_id": "ricettario_fiorentino_1597", "name": "Scale", "category": "OBJECT", "subcategory": "TOOL", "count": 1, "variants": ["Scale"], "contexts": ["measuring instrument"]}, {"entity_id": "scales", "book_id": "first_principles_spencer_1862", "name": "scales", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["scales"], "contexts": ["instruments for weighing", "device for weighing"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "scale", "target_book": "english_physician_1652", "target_name": "Scale", "similarity": 0.974}, {"source_book": "polyanthea_medicinal", "source_name": "scale", "target_book": "ricettario_fiorentino_1597", "target_name": "Scale", "similarity": 0.974}, {"source_book": "polyanthea_medicinal", "source_name": "scale", "target_book": "first_principles_spencer_1862", "target_name": "scales", "similarity": 0.849}, {"source_book": "english_physician_1652", "source_name": "Scale", "target_book": "ricettario_fiorentino_1597", "target_name": "Scale", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Scale", "target_book": "first_principles_spencer_1862", "target_name": "scales", "similarity": 0.84}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Scale", "target_book": "first_principles_spencer_1862", "target_name": "scales", "similarity": 0.84}], "id": 140, "stable_key": "clu_a21f70e026048f79", "ground_truth": {"modern_name": "Scale (weighing)", "confidence": "high", "type": "object", "description": "Instrument used for measuring weight.", "note": "Refers to a weighing instrument, not a biological scale.", "wikipedia_extract": "A scale or balance is a device used to measure weight or mass. These are also known as mass scales, weight scales, mass balances, massometers, and weight balances. The traditional scale consists of two plates or bowls suspended at equal distances from a fulcrum. One plate holds an object of unknown mass (or weight), while objects of known mass or weight, called weights, are added to the other plate until mechanical equilibrium is achieved and the plates level off, which happens when the masses on the two plates are equal. The perfect scale rests at neutral. A spring scale will make use of a spring of known stiffness to determine mass (or weight)."}}, {"canonical_name": "observation", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 4, "total_mentions": 20, "members": [{"entity_id": "observation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "observation", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 11, "variants": ["observation"], "contexts": ["act of watching or noting phenomena", "gathering information through senses"]}, {"entity_id": "observations", "book_id": "relation_historique_humboldt_vol3_1825", "name": "observations", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 5, "variants": ["observations", "d'observation.", "observation"], "contexts": ["scientific data collection", "recorded findings from study"]}, {"entity_id": "physiological_observation", "book_id": "principles_of_psychology_james_1890", "name": "physiological observation", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["physiological observation"], "contexts": ["observing bodily functions"]}, {"entity_id": "comparative_observations", "book_id": "principles_of_psychology_james_1890", "name": "Comparative observations", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Comparative observations"], "contexts": ["observations made for comparison"]}, {"entity_id": "observations", "book_id": "connexion_physical_sciences_somerville_1858", "name": "observations", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["observations"], "contexts": ["recordings of scientific data"]}, {"entity_id": "personal_observation", "book_id": "first_principles_spencer_1862", "name": "personal observation", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["personal observation"], "contexts": ["gathering information through senses"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "observation", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "observations", "similarity": 0.973}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "observation", "target_book": "principles_of_psychology_james_1890", "target_name": "physiological observation", "similarity": 0.843}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "observation", "target_book": "first_principles_spencer_1862", "target_name": "personal observation", "similarity": 0.875}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "observations", "target_book": "principles_of_psychology_james_1890", "target_name": "Comparative observations", "similarity": 0.854}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "observations", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "observations", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "observations", "target_book": "first_principles_spencer_1862", "target_name": "personal observation", "similarity": 0.869}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Comparative observations", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "observations", "similarity": 0.854}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "observations", "target_book": "first_principles_spencer_1862", "target_name": "personal observation", "similarity": 0.869}], "id": 141, "stable_key": "clu_4b342954c3d77988", "ground_truth": {"modern_name": "Observations", "confidence": "high", "type": "concept", "description": "Systematic recording of data or phenomena in scientific study.", "note": "Refers to the practice of scientific observation and data collection.", "wikipedia_extract": "Observation in the natural sciences refers to the active acquisition of information from a primary source. It involves the act of noticing or perceiving phenomena and gathering data based on direct engagement with the subject of study. In living organisms, observation typically occurs through the senses. In science, it often extends beyond unaided perception, involving the use of scientific instruments to detect, measure, and record data. This enables the observation of phenomena not accessible to human senses alone. Observations in science are typically categorized as either qualitative or quantitative: Qualitative observations describe characteristics that are not expressed numerically, such as color, texture, or behavior."}}, {"canonical_name": "bolo armenio", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 4, "total_mentions": 19, "members": [{"entity_id": "bolo_armenio", "book_id": "polyanthea_medicinal", "name": "bolo armenio", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 9, "variants": ["bolo armenio", "bollo armenio", "bolo Armenio", "bolus armenius"], "contexts": ["ingredient in a repercussive plaster", "ingredient in wound powder"]}, {"entity_id": "bolo_armenico", "book_id": "historia_medicinal_monardes_1574", "name": "Bolo armenico", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Bolo armenico", "Bolo armeno"], "contexts": ["Armenian bole, a medicinal earth"]}, {"entity_id": "bolo_arménio", "book_id": "coloquios_da_orta_1563", "name": "bolo arménio", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["bolo arménio"], "contexts": ["argillaceous earth used in medicine"]}, {"entity_id": "bolo_armeno", "book_id": "ricettario_fiorentino_1597", "name": "Bolo armeno", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["Bolo armeno", "Bolo Armen", "Bolo Armeno", "bolo armeno", "bolo armeno orientale"], "contexts": ["another name for Sinopia", "Armenian bole earth"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "bolo armenio", "target_book": "historia_medicinal_monardes_1574", "target_name": "Bolo armenico", "similarity": 0.944}, {"source_book": "polyanthea_medicinal", "source_name": "bolo armenio", "target_book": "coloquios_da_orta_1563", "target_name": "bolo arménio", "similarity": 0.962}, {"source_book": "polyanthea_medicinal", "source_name": "bolo armenio", "target_book": "ricettario_fiorentino_1597", "target_name": "Bolo armeno", "similarity": 0.977}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Bolo armenico", "target_book": "coloquios_da_orta_1563", "target_name": "bolo arménio", "similarity": 0.93}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Bolo armenico", "target_book": "ricettario_fiorentino_1597", "target_name": "Bolo armeno", "similarity": 0.965}, {"source_book": "coloquios_da_orta_1563", "source_name": "bolo arménio", "target_book": "ricettario_fiorentino_1597", "target_name": "Bolo armeno", "similarity": 0.939}], "id": 142, "stable_key": "clu_6a3f3c2ba39ed199", "ground_truth": {"modern_name": "Armenian bole", "confidence": "high", "type": "mineral", "description": "A reddish-yellow medicinal clay from Armenia.", "wikipedia_extract": "Armenian bole, also known as bolus armenus or bole armoniac, is an earthy clay, usually red, native to Armenia but also found in other places. The term Armenian was later referred to a specific quality of the clay. Originally used in medication, it has also been used as a pigment, as a poliment or base for gilding, and for other uses. It is red due to the presence of iron oxide; the clay also contains hydrous silicates of aluminum and possibly magnesium. Historically, the term bolu or bolus was used only for medicinal earths and Armenian bole was used as an astringent, prescribed against diarrhea, dysentery, and bleeding. References to Armenian bole were made by Theophrastus, Dioscorides (c. 41–90 AD) and Pliny the Elder (23–79 AD)."}}, {"canonical_name": "pulmonum", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 19, "members": [{"entity_id": "pulmonum", "book_id": "polyanthea_medicinal", "name": "pulmonum", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 14, "variants": ["pulmonum", "Pulmo", "Pulmonis", "polmone", "pulmo", "pulmon.", "pulmonem", "pulmones", "pulmonis"], "contexts": ["lungs", "lung"]}, {"entity_id": "pulmon", "book_id": "historia_medicinal_monardes_1574", "name": "Pulmon", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Pulmon", "pulmon"], "contexts": ["lung", "lung, an organ"]}, {"entity_id": "pulmão", "book_id": "coloquios_da_orta_1563", "name": "pulmão", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["pulmão"], "contexts": ["body part"]}, {"entity_id": "polmone", "book_id": "ricettario_fiorentino_1597", "name": "polmone", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["polmone"], "contexts": ["lung, part of the body", "lung, organ for preparation"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "pulmonum", "target_book": "historia_medicinal_monardes_1574", "target_name": "Pulmon", "similarity": 0.973}, {"source_book": "polyanthea_medicinal", "source_name": "pulmonum", "target_book": "coloquios_da_orta_1563", "target_name": "pulmão", "similarity": 0.973}, {"source_book": "polyanthea_medicinal", "source_name": "pulmonum", "target_book": "ricettario_fiorentino_1597", "target_name": "polmone", "similarity": 0.914}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Pulmon", "target_book": "coloquios_da_orta_1563", "target_name": "pulmão", "similarity": 0.972}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Pulmon", "target_book": "ricettario_fiorentino_1597", "target_name": "polmone", "similarity": 0.927}, {"source_book": "coloquios_da_orta_1563", "source_name": "pulmão", "target_book": "ricettario_fiorentino_1597", "target_name": "polmone", "similarity": 0.911}], "id": 143, "stable_key": "clu_5dd6d2dd8df17f0c", "ground_truth": {"modern_name": "lung", "confidence": "high", "type": "anatomy", "description": "The respiratory organ in the chest of humans and animals.", "wikipedia_extract": "The lungs are the primary organs of the respiratory system in many animals, including humans. In mammals and most other tetrapods, two lungs are located near the backbone on either side of the heart. Their function in the respiratory system is to extract oxygen from the atmosphere and transfer it into the bloodstream, and to release carbon dioxide from the bloodstream into the atmosphere, in a process of gas exchange. Respiration is driven by different muscular systems in different species. Mammals, reptiles and birds use their musculoskeletal systems to support and foster breathing. In early tetrapods, air was driven into the lungs by the pharyngeal muscles via buccal pumping, a mechanism still seen in amphibians."}}, {"canonical_name": "Cambridge", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 17, "members": [{"entity_id": "cambridge", "book_id": "kosmos_humboldt_1845", "name": "Cambridge", "category": "PLACE", "subcategory": "CITY", "count": 8, "variants": ["Cambridge"], "contexts": ["location of Elzevir edition publication", "location of an edition of Varenius's work"]}, {"entity_id": "cambridge", "book_id": "origin_of_species_darwin_1859", "name": "Cambridge", "category": "PLACE", "subcategory": "COUNTY", "count": 2, "variants": ["Cambridge"], "contexts": ["location of Professor Miller", "uniform county with many plants"]}, {"entity_id": "cambridge", "book_id": "principles_of_psychology_james_1890", "name": "Cambridge", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Cambridge"], "contexts": ["city mentioned in distance example"]}, {"entity_id": "cambridge", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cambridge", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Cambridge"], "contexts": ["location of Mr. Willis", "location of Professor Challis"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Cambridge", "target_book": "origin_of_species_darwin_1859", "target_name": "Cambridge", "similarity": 0.869}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cambridge", "target_book": "principles_of_psychology_james_1890", "target_name": "Cambridge", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cambridge", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cambridge", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Cambridge", "target_book": "principles_of_psychology_james_1890", "target_name": "Cambridge", "similarity": 0.869}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Cambridge", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cambridge", "similarity": 0.869}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Cambridge", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cambridge", "similarity": 1.0}], "id": 144, "stable_key": "clu_71e61914ce24c548", "ground_truth": {"wikipedia_extract": "Cambridge (  KAYM-brij) is a city and non-metropolitan district in the county of Cambridgeshire, England. It is the county town of Cambridgeshire and is located on the River Cam, 55 miles (89 km) north of London. As of the 2021 United Kingdom census, the population of the City of Cambridge was 145,700; the population of the wider built-up area (which extends outside the city council area) was 181,137. There is archaeological evidence of settlement in the area as early as the Bronze Age, and Cambridge became an important trading centre during the Roman and Viking eras. The first town charters were granted in the 12th century, although modern city status was not officially conferred until 1951. The city is well known as the home of the University of Cambridge, which was founded in 1209 and consistently ranks among the best universities in the world."}}, {"canonical_name": "mitridato", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 4, "total_mentions": 16, "members": [{"entity_id": "mitridato", "book_id": "polyanthea_medicinal", "name": "mitridato", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 7, "variants": ["mitridato", "Mitridates", "Mitridato", "Mitridatos", "mithridatis", "mitridatis"], "contexts": ["ingredient in a preparation", "added to chicken broth remedy"]}, {"entity_id": "methridate", "book_id": "english_physician_1652", "name": "Methridate", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 6, "variants": ["Methridate", "Methridatum"], "contexts": ["complex medicinal compound", "historical figure associated with an antidote"]}, {"entity_id": "metridato", "book_id": "historia_medicinal_monardes_1574", "name": "Metridato", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Metridato"], "contexts": ["preparation with virtue against poison"]}, {"entity_id": "mitridato", "book_id": "coloquios_da_orta_1563", "name": "mitridato", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["mitridato", "mithridatos"], "contexts": ["composition including amomum", "compound medicines"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "mitridato", "target_book": "english_physician_1652", "target_name": "Methridate", "similarity": 0.851}, {"source_book": "polyanthea_medicinal", "source_name": "mitridato", "target_book": "historia_medicinal_monardes_1574", "target_name": "Metridato", "similarity": 0.891}, {"source_book": "polyanthea_medicinal", "source_name": "mitridato", "target_book": "coloquios_da_orta_1563", "target_name": "mitridato", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Methridate", "target_book": "historia_medicinal_monardes_1574", "target_name": "Metridato", "similarity": 0.841}, {"source_book": "english_physician_1652", "source_name": "Methridate", "target_book": "coloquios_da_orta_1563", "target_name": "mitridato", "similarity": 0.851}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Metridato", "target_book": "coloquios_da_orta_1563", "target_name": "mitridato", "similarity": 0.891}], "id": 145, "stable_key": "clu_938640bc8677e5c3", "ground_truth": {"modern_name": "Methridate", "confidence": "high", "type": "preparation", "description": "A complex historical antidote or medicinal compound."}}, {"canonical_name": "Boston", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 16, "members": [{"entity_id": "boston", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Boston", "category": "PLACE", "subcategory": "CITY", "count": 9, "variants": ["Boston"], "contexts": ["city in Massachusetts, USA", "city for sea voyages"]}, {"entity_id": "boston", "book_id": "principles_of_psychology_james_1890", "name": "Boston", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Boston"], "contexts": ["city where a volume was published", "city visited by the subject"]}, {"entity_id": "boston", "book_id": "kosmos_humboldt_1845", "name": "Boston", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Boston"], "contexts": ["location where meteors were observed", "city where book was published"]}, {"entity_id": "boston", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Boston", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Boston"], "contexts": ["city on isothermal line of 50° Fahrenheit"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Boston", "target_book": "principles_of_psychology_james_1890", "target_name": "Boston", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Boston", "target_book": "kosmos_humboldt_1845", "target_name": "Boston", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Boston", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Boston", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Boston", "target_book": "kosmos_humboldt_1845", "target_name": "Boston", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Boston", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Boston", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Boston", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Boston", "similarity": 1.0}], "id": 146, "stable_key": "clu_ba8dacdbe096573b", "ground_truth": {"modern_name": "Boston", "confidence": "high", "type": "place", "description": "A major city in Massachusetts, USA, a significant port and publication center.", "wikipedia_extract": "Boston is the capital and most populous city of the U.S. state of Massachusetts. It serves as the cultural and financial center of New England, a region of the Northeastern United States. Boston has an area of 48.4 sq mi (125 km2) and a population of 675,647 as of the 2020 census, making it the third-most populous city in the Northeastern United States after New York City and Philadelphia. The larger Greater Boston metropolitan statistical area had a population of 4.9 million in 2023, making it the largest metropolitan area in New England and the eleventh-largest in the United States. Boston was founded on Shawmut Peninsula in 1630 by English Puritan settlers, who named the city after the market town of Boston, Lincolnshire in England. During the American Revolution and Revolutionary War, Boston was home to several seminal events, including the Boston Massacre (1770), the Boston Tea Party (1773), Paul Revere's midnight ride (1775), the Battle of Bunker Hill (1775), and the Siege of Boston (1775–1776)."}}, {"canonical_name": "pez", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 16, "members": [{"entity_id": "pez", "book_id": "polyanthea_medicinal", "name": "pez", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 9, "variants": ["pez"], "contexts": ["substance used for treatment", "pitch"]}, {"entity_id": "pez", "book_id": "historia_medicinal_monardes_1574", "name": "pez", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["pez"], "contexts": ["pitch"]}, {"entity_id": "pé", "book_id": "coloquios_da_orta_1563", "name": "pé", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["pé"], "contexts": ["lowest grade of camphor"]}, {"entity_id": "pezze", "book_id": "ricettario_fiorentino_1597", "name": "pezze", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["pezze"], "contexts": ["material for applying plasters"]}, {"entity_id": "pez_liquido", "book_id": "polyanthea_medicinal", "name": "pez liquido", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["pez liquido"], "contexts": ["sticky substance used in remedies", "substance for baths"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "pez", "target_book": "historia_medicinal_monardes_1574", "target_name": "pez", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "pez", "target_book": "coloquios_da_orta_1563", "target_name": "pé", "similarity": 0.866}, {"source_book": "polyanthea_medicinal", "source_name": "pez", "target_book": "ricettario_fiorentino_1597", "target_name": "pezze", "similarity": 0.902}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "pez", "target_book": "coloquios_da_orta_1563", "target_name": "pé", "similarity": 0.866}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "pez", "target_book": "ricettario_fiorentino_1597", "target_name": "pezze", "similarity": 0.902}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "pez", "target_book": "polyanthea_medicinal", "target_name": "pez liquido", "similarity": 0.823}], "id": 147, "stable_key": "clu_635a9a90699c1a5e", "ground_truth": {"modern_name": "pitch", "confidence": "high", "type": "substance", "description": "A thick, sticky, dark substance obtained from resin.", "note": "'pezze' context might refer to pieces of cloth or material.", "wikipedia_extract": "Pez (English: , German: [peːts]; stylised as PEZ, officially Pfefferminz, German for peppermint) is the brand name of an Austrian candy and associated manual candy dispensers. The candy is a pressed, dry, straight-edged, curved-corner block 15 mm (5⁄8 inch) long, 8 mm (5⁄16 inch) wide and 5 mm (3⁄16 inch) high, with each Pez dispenser holding 12 candy pieces. Pez was invented in Austria and later exported worldwide. The all-uppercase spelling of the logo echoes the trademark's style on the packaging and the dispensers, with the logo drawn in perspective and giving the appearance that the letters are built out of 44 brick-like Pez mints (14 bricks in the P and 15 in each of the E and Z). Despite the widespread recognition and popularity of the Pez dispenser, the company considers itself to be primarily a candy company, stating that \"[t]oday, billions of PEZ candies are consumed annually in the U.S.A. alone\". Pez dispensers are a part of popular culture in many nations, an example being \"Soul Candy\" in the Japanese manga series Bleach."}}, {"canonical_name": "molluscs", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 4, "total_mentions": 15, "members": [{"entity_id": "molluscs", "book_id": "origin_of_species_darwin_1859", "name": "molluscs", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 7, "variants": ["Molluscs", "molluscs"], "contexts": ["extinct Silurian molluscs that changed greatly", "animal class"]}, {"entity_id": "mollusques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "mollusques", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["mollusques"], "contexts": ["possible source of filaments", "soft-bodied marine invertebrates"]}, {"entity_id": "mollusca", "book_id": "kosmos_humboldt_1845", "name": "mollusca", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["mollusca"], "contexts": ["main division of muscle shells", "aquatic invertebrates"]}, {"entity_id": "mollusks", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mollusks", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Mollusks"], "contexts": ["animals of shells", "distinct species of"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "molluscs", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "mollusques", "similarity": 0.993}, {"source_book": "origin_of_species_darwin_1859", "source_name": "molluscs", "target_book": "kosmos_humboldt_1845", "target_name": "mollusca", "similarity": 0.986}, {"source_book": "origin_of_species_darwin_1859", "source_name": "molluscs", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mollusks", "similarity": 0.943}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mollusques", "target_book": "kosmos_humboldt_1845", "target_name": "mollusca", "similarity": 0.989}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mollusques", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mollusks", "similarity": 0.934}, {"source_book": "kosmos_humboldt_1845", "source_name": "mollusca", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mollusks", "similarity": 0.938}], "id": 148, "stable_key": "clu_883976b5a02f1807", "ground_truth": {"modern_name": "Mollusks", "confidence": "high", "type": "animal", "description": "Invertebrate animals with soft bodies, often protected by a shell.", "wikipedia_extract": "Mollusca is a phylum of protostomic invertebrate animals, whose members are known as molluscs or mollusks (). 86,600 extant species of molluscs are recognized, making it the second-largest animal phylum after Arthropoda. The number of additional fossil species is estimated between 60,000 and 100,000, and the proportion of undescribed species is very high. Many taxa remain poorly studied. Molluscs are the largest marine phylum, comprising about 23% of all the named marine organisms. They are highly diverse, not just in size and anatomical structure, but also in behavior and habitat, as numerous groups are freshwater and even terrestrial species. The phylum is typically divided into 7 or 8 taxonomic classes, of which two are entirely extinct."}}, {"canonical_name": "moisture", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 15, "members": [{"entity_id": "moisture", "book_id": "english_physician_1652", "name": "moisture", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 8, "variants": ["moisture", "moist humors", "moisture thereof"], "contexts": ["quality causing joint issues", "malignant quality of ulcers dried by fern"]}, {"entity_id": "humidades", "book_id": "historia_medicinal_monardes_1574", "name": "humidades", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["humidades"], "contexts": ["bodily fluids"]}, {"entity_id": "moisture", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Moisture", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["moisture", "Moisture"], "contexts": ["water in the air", "water vapor in the air"]}, {"entity_id": "moisture", "book_id": "origin_of_species_darwin_1859", "name": "moisture", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["moisture"], "contexts": ["environmental condition affecting variation", "water in the atmosphere or soil"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "moisture", "target_book": "historia_medicinal_monardes_1574", "target_name": "humidades", "similarity": 0.924}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Moisture", "target_book": "origin_of_species_darwin_1859", "target_name": "moisture", "similarity": 0.988}], "id": 149, "stable_key": "clu_23d8facfd6757e9a", "ground_truth": {"modern_name": "Bodily fluid", "confidence": "high", "type": "substance", "description": "Liquid substances within the body, essential for its functions.", "note": "Includes concepts like humors or other bodily liquids.", "wikipedia_extract": "Body fluids, bodily fluids, or biofluids, sometimes body liquids, are liquids within the body of an organism. In lean healthy adult men, the total body water is about 60% (60–67%) of the total body weight; it is usually slightly lower in women (52–55%). The exact percentage of fluid relative to body weight is inversely proportional to the percentage of body fat. A lean 70 kg (150 lb) man, for example, has about 42 (42–47) liters of water in his body. The total body of water is divided into fluid compartments, between the intracellular fluid compartment (also called space, or volume) and the extracellular fluid (ECF) compartment (space, volume) in a two-to-one ratio: 28 (28–32) liters are inside cells and 14 (14–15) liters are outside cells. The ECF compartment is divided into the interstitial fluid volume – the fluid outside both the cells and the blood vessels – and the intravascular volume (also called the vascular volume and blood plasma volume) – the fluid inside the blood vessels – in a three-to-one ratio: the interstitial fluid volume is about 12 liters; the vascular volume is about 4 liters."}}, {"canonical_name": "cholera", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 4, "total_mentions": 14, "members": [{"entity_id": "cholera", "book_id": "coloquios_da_orta_1563", "name": "cholera", "category": "DISEASE", "subcategory": "ACUTE", "count": 11, "variants": ["cholera"], "contexts": ["disease described by Garcia da Orta", "suspected illness"]}, {"entity_id": "cholerica_passio", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "cholerica passio", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["cholerica passio"], "contexts": ["sudden purging of bile"]}, {"entity_id": "cholera", "book_id": "principles_of_psychology_james_1890", "name": "cholera", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["cholera"], "contexts": ["infectious disease causing severe diarrhea"]}, {"entity_id": "cholera_aduſta", "book_id": "polyanthea_medicinal", "name": "cholera aduſta", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["cholera aduſta"], "contexts": ["burnt cholera"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "cholera", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "cholerica passio", "similarity": 0.857}, {"source_book": "coloquios_da_orta_1563", "source_name": "cholera", "target_book": "principles_of_psychology_james_1890", "target_name": "cholera", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "cholera", "target_book": "polyanthea_medicinal", "target_name": "cholera aduſta", "similarity": 0.838}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "cholerica passio", "target_book": "principles_of_psychology_james_1890", "target_name": "cholera", "similarity": 0.857}, {"source_book": "principles_of_psychology_james_1890", "source_name": "cholera", "target_book": "polyanthea_medicinal", "target_name": "cholera aduſta", "similarity": 0.838}], "id": 150, "stable_key": "clu_1bdcd42900462c78", "ground_truth": {"modern_name": "Cholera", "confidence": "high", "type": "disease", "description": "Severe infectious disease causing diarrhea and dehydration.", "wikipedia_extract": "Cholera () is an infection of the small intestine by some strains of the bacterium Vibrio cholerae. Symptoms may range from none, to mild, to severe. The classic symptom is large amounts of watery diarrhea lasting a few days. Vomiting and muscle cramps may also occur. Diarrhea can be so severe that it leads within hours to severe dehydration and electrolyte imbalance. This can in turn result in sunken eyes, cold or cyanotic skin, decreased skin elasticity, wrinkling of the hands and feet, and, in severe cases, death."}}, {"canonical_name": "Thymo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 14, "members": [{"entity_id": "thymo", "book_id": "ricettario_fiorentino_1597", "name": "Thymo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 11, "variants": ["Thymo", "THYMO", "thymo", "thymos", "thym©"], "contexts": ["plant Epithymo wraps around", "wild Hyssop, also called Thymo"]}, {"entity_id": "thymelæa", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Thymelæa", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Thymelæa"], "contexts": ["plant mentioned by Hippocrates"]}, {"entity_id": "tomat", "book_id": "historia_medicinal_monardes_1574", "name": "tomat", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["tomat"], "contexts": ["used for old and dirty wounds"]}, {"entity_id": "thymus", "book_id": "polyanthea_medicinal", "name": "Thymus", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Thymus"], "contexts": ["plant mentioned in text"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Thymo", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Thymelæa", "similarity": 0.873}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Thymo", "target_book": "historia_medicinal_monardes_1574", "target_name": "tomat", "similarity": 0.843}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Thymo", "target_book": "polyanthea_medicinal", "target_name": "Thymus", "similarity": 0.854}], "id": 151, "stable_key": "clu_118ea1b9540f4f9b", "ground_truth": {"modern_name": "Thyme", "confidence": "high", "type": "plant", "linnaean": "Thymus vulgaris", "family": "Lamiaceae", "description": "An aromatic herb with culinary and medicinal uses.", "note": "Likely refers to the genus Thymus, with Thyme vulgaris as the most common species.", "wikipedia_extract": "Thymus vulgaris (common thyme, German thyme, garden thyme or just thyme) is a species of flowering plant in the mint family Lamiaceae, native to southern Europe from the western Mediterranean to southern Italy. Growing to 15–30 cm (6–12 in) tall by 40 cm (16 in) wide, it is a bushy, woody-based evergreen subshrub with small, highly aromatic, grey-green leaves and clusters of purple or pink flowers in early summer. It is useful in the garden as groundcover, where it can be short-lived, but is easily propagated from cuttings. It is also the main source of thyme as an ingredient in cooking and as a herbal medicine. It is slightly spicier than oregano and sweeter than sage. The Latin specific epithet vulgaris means “common” in the sense of “widespread”."}}, {"canonical_name": "Scotland", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 4, "total_mentions": 14, "members": [{"entity_id": "scotland", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Scotland", "category": "PLACE", "subcategory": "COUNTRY", "count": 6, "variants": ["Scotland"], "contexts": ["location of trigonometrical survey", "country around which wave goes"]}, {"entity_id": "scotland", "book_id": "english_physician_1652", "name": "Scotland", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Scotland"], "contexts": ["location where the plant grows", "country where Winter-Green grows"]}, {"entity_id": "scotland", "book_id": "origin_of_species_darwin_1859", "name": "Scotland", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Scotland"], "contexts": ["country with scored mountains from ice", "mountains with scored flanks and polished surfaces"]}, {"entity_id": "scotland", "book_id": "kosmos_humboldt_1845", "name": "Scotland", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Scotland"], "contexts": ["country with coal beds", "Northern hemisphere location"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Scotland", "target_book": "english_physician_1652", "target_name": "Scotland", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Scotland", "target_book": "origin_of_species_darwin_1859", "target_name": "Scotland", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Scotland", "target_book": "kosmos_humboldt_1845", "target_name": "Scotland", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Scotland", "target_book": "origin_of_species_darwin_1859", "target_name": "Scotland", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Scotland", "target_book": "kosmos_humboldt_1845", "target_name": "Scotland", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Scotland", "target_book": "kosmos_humboldt_1845", "target_name": "Scotland", "similarity": 1.0}], "id": 152, "stable_key": "clu_3a6b1c1fdf6bb9b1", "ground_truth": {"wikipedia_extract": "Scotland is a country that is part of the United Kingdom. It contains nearly one-third of the United Kingdom's land area, consisting of the northern part of the island of Great Britain and more than 790 adjacent islands, principally in the archipelagos of the Hebrides and the Northern Isles. In 2022, the country's population was about 5.4 million. Its capital city is Edinburgh, whilst Glasgow is the largest city and the most populous of the cities of Scotland. To the south-east, Scotland has its only land border with England; otherwise it is surrounded by the Atlantic Ocean to the north and west, the North Sea to the north-east and east, and the Irish Sea to the south. The legislature, the Scottish Parliament, elects 129 members to represent 73 constituencies."}}, {"canonical_name": "Kœnigsberg", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 14, "members": [{"entity_id": "kœnigsberg", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Kœnigsberg", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Kœnigsberg", "Kienigsberg", "Kânigsberg"], "contexts": ["location for barometric observations", "city with barometric observations"]}, {"entity_id": "königsberg", "book_id": "principles_of_psychology_james_1890", "name": "Königsberg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Königsberg"], "contexts": ["academicism of Kant's existence"]}, {"entity_id": "konigsberg", "book_id": "kosmos_humboldt_1845", "name": "Konigsberg", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Konigsberg"], "contexts": ["city where Kant published his essay", "city where essay was published"]}, {"entity_id": "königsberg", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Königsberg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Königsberg"], "contexts": ["location of Professor Moser's work"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Kœnigsberg", "target_book": "principles_of_psychology_james_1890", "target_name": "Königsberg", "similarity": 0.866}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Kœnigsberg", "target_book": "kosmos_humboldt_1845", "target_name": "Konigsberg", "similarity": 0.91}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Kœnigsberg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Königsberg", "similarity": 0.866}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Königsberg", "target_book": "kosmos_humboldt_1845", "target_name": "Konigsberg", "similarity": 0.908}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Königsberg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Königsberg", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Konigsberg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Königsberg", "similarity": 0.908}], "id": 153, "stable_key": "clu_7995762c9b4e9b9f", "ground_truth": {"modern_name": "Königsberg", "confidence": "high", "type": "place", "description": "A major city known for its academic importance and barometric observations.", "wikipedia_extract": "Königsberg (, German: [ˈkøːnɪçsbɛʁk]  or [ˈkøːnɪksbɛʁk] ) was the historic German name of the city that is now modern-day Kaliningrad, Russia. The city was founded in 1255 on the site of the small Old Prussian settlement Twangste by the Teutonic Knights during the Baltic Crusades. It was named in honour of King Ottokar II of Bohemia, who led a campaign against the pagan Old Prussians, a Baltic tribe that was native to the area. A Baltic port city, it successively became the capital of the Królewiec Voivodeship, State of the Teutonic Order, the Duchy of Prussia and the provinces of East Prussia and Prussia. Königsberg remained the coronation city of the Prussian monarchy from 1701 onwards, though the capital was Berlin. From the thirteenth century, it was inhabited by Germans and Old Prussians, then also by Poles, Lithuanians and French from the 14th, 15th and 17th centuries, respectively."}}, {"canonical_name": "compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 4, "total_mentions": 13, "members": [{"entity_id": "compass", "book_id": "kosmos_humboldt_1845", "name": "compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["compass"], "contexts": ["navigational instrument using magnetic field", "navigational tool"]}, {"entity_id": "compass", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["compass", "Compass"], "contexts": ["navigational instrument", "instrument for direction"]}, {"entity_id": "compass-points", "book_id": "principles_of_psychology_james_1890", "name": "compass-points", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["compass-points"], "contexts": ["instrument to measure touch sensitivity", "instrument for tactile discrimination experiments"]}, {"entity_id": "needle_of_the_inclination-compass", "book_id": "kosmos_humboldt_1845", "name": "needle of the inclination-compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["needle of the inclination-compass"], "contexts": ["instrument for measuring magnetic inclination"]}, {"entity_id": "compass_needle", "book_id": "connexion_physical_sciences_somerville_1858", "name": "compass needle", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["compass needle"], "contexts": ["deflected by electric current", "device indicating direction using magnetism"]}, {"entity_id": "compass", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["Compass", "compass"], "contexts": ["navigational instrument showing direction", "navigational instrument"]}, {"entity_id": "compasses", "book_id": "connexion_physical_sciences_somerville_1858", "name": "compasses", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["compasses"], "contexts": ["tool for measuring length"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "compass", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "compass", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "compass", "target_book": "principles_of_psychology_james_1890", "target_name": "compass-points", "similarity": 0.891}, {"source_book": "kosmos_humboldt_1845", "source_name": "compass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "compass needle", "similarity": 0.853}, {"source_book": "kosmos_humboldt_1845", "source_name": "compass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Compass", "similarity": 0.987}, {"source_book": "kosmos_humboldt_1845", "source_name": "compass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "compasses", "similarity": 0.823}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "compass", "target_book": "principles_of_psychology_james_1890", "target_name": "compass-points", "similarity": 0.891}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "compass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "compass needle", "similarity": 0.853}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "compass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Compass", "similarity": 0.987}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "compass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "compasses", "similarity": 0.823}, {"source_book": "principles_of_psychology_james_1890", "source_name": "compass-points", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "compass needle", "similarity": 0.822}, {"source_book": "principles_of_psychology_james_1890", "source_name": "compass-points", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Compass", "similarity": 0.878}, {"source_book": "kosmos_humboldt_1845", "source_name": "needle of the inclination-compass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "compass needle", "similarity": 0.897}], "id": 154, "stable_key": "clu_c99e69fe406c85ac", "ground_truth": {"modern_name": "compass", "confidence": "high", "type": "object", "wikidata_id": "Q2476036", "wikidata_description": "American independent record label based in Nashville, Tennessee", "wikipedia_url": "https://en.wikipedia.org/wiki/Compass%20Records", "wikipedia_extract": "A compass is a device that shows the cardinal directions used for navigation and geographic orientation. It typically consists of a magnetized needle or another element, such as a compass card or compass rose, that pivots to align itself with magnetic north. Other methods may be used, including gyroscopes, magnetometers, and GPS receivers. Compasses often show angles in degrees: north corresponds to 0°, and the angles increase clockwise, so east is 90°, south is 180°, and west is 270°. These numbers allow the compass to show azimuths or bearings which are commonly stated in degrees. If local variation between magnetic north and true north is known, then direction of magnetic north also gives direction of true north."}}, {"canonical_name": "crystallization", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 13, "members": [{"entity_id": "crystallization", "book_id": "connexion_physical_sciences_somerville_1858", "name": "crystallization", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Crystallization", "crystallization"], "contexts": ["process of forming crystals", "influence on transmissive power of bodies"]}, {"entity_id": "crystallus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Crystallus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Crystallus"], "contexts": ["Greek name for ice and crystal"]}, {"entity_id": "crystalline_structure", "book_id": "kosmos_humboldt_1845", "name": "crystalline structure", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["crystalline structure"], "contexts": ["arrangement of atoms in a crystal"]}, {"entity_id": "crystalline_state", "book_id": "kosmos_humboldt_1845", "name": "crystalline state", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["crystalline state"], "contexts": ["state of matter with ordered atomic structure"]}, {"entity_id": "tessular_system_of_crystallization", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Tessular system of crystallization", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Tessular system of crystallization"], "contexts": ["classification of crystal structures"]}, {"entity_id": "crystallization", "book_id": "first_principles_spencer_1862", "name": "crystallization", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["crystallization"], "contexts": ["process of forming crystals", "formation of crystals"]}, {"entity_id": "crystalline_forms", "book_id": "first_principles_spencer_1862", "name": "crystalline forms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["crystalline forms"], "contexts": ["shape of salt crystals"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "crystallization", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Crystallus", "similarity": 0.84}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "crystallization", "target_book": "kosmos_humboldt_1845", "target_name": "crystalline structure", "similarity": 0.874}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "crystallization", "target_book": "kosmos_humboldt_1845", "target_name": "crystalline state", "similarity": 0.876}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "crystallization", "target_book": "first_principles_spencer_1862", "target_name": "crystallization", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "crystallization", "target_book": "first_principles_spencer_1862", "target_name": "crystalline forms", "similarity": 0.872}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Crystallus", "target_book": "kosmos_humboldt_1845", "target_name": "crystalline structure", "similarity": 0.874}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Crystallus", "target_book": "kosmos_humboldt_1845", "target_name": "crystalline state", "similarity": 0.85}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Crystallus", "target_book": "first_principles_spencer_1862", "target_name": "crystallization", "similarity": 0.84}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Crystallus", "target_book": "first_principles_spencer_1862", "target_name": "crystalline forms", "similarity": 0.867}, {"source_book": "kosmos_humboldt_1845", "source_name": "crystalline structure", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Tessular system of crystallization", "similarity": 0.862}, {"source_book": "kosmos_humboldt_1845", "source_name": "crystalline structure", "target_book": "first_principles_spencer_1862", "target_name": "crystallization", "similarity": 0.874}, {"source_book": "kosmos_humboldt_1845", "source_name": "crystalline structure", "target_book": "first_principles_spencer_1862", "target_name": "crystalline forms", "similarity": 0.944}, {"source_book": "kosmos_humboldt_1845", "source_name": "crystalline state", "target_book": "first_principles_spencer_1862", "target_name": "crystallization", "similarity": 0.876}, {"source_book": "kosmos_humboldt_1845", "source_name": "crystalline state", "target_book": "first_principles_spencer_1862", "target_name": "crystalline forms", "similarity": 0.912}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Tessular system of crystallization", "target_book": "first_principles_spencer_1862", "target_name": "crystallization", "similarity": 0.872}], "id": 155, "stable_key": "clu_b9096518445ed4be", "ground_truth": {"modern_name": "crystallization", "confidence": "high", "type": "concept", "wikidata_id": "Q284256", "wikidata_description": "process by which a solid with a highly organised atomic or molecular structure forms", "wikipedia_url": "https://en.wikipedia.org/wiki/Crystallization", "wikipedia_extract": "Crystallization is a process that leads to solids with a uniform pattern of atoms or molecules, i.e. a crystal. The uniform nature of a crystalline solid can be contrasted with amorphous solids in which atoms or molecules lack regular organization. Crystallization can occur by various routes including precipitation from solution, freezing of a liquid, or deposition from a gas. Attributes of the resulting crystal can depend largely on factors such as temperature, air pressure, cooling rate, or solute concentration. Crystallization occurs in two main phases. The first is nucleation, the appearance of a crystalline phase from either a supercooled liquid or a supersaturated solvent."}}, {"canonical_name": "Agricola", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 13, "members": [{"entity_id": "agricola", "book_id": "polyanthea_medicinal", "name": "Agricola", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Agricola", "Agricol"], "contexts": ["early modern author", "author of 'Comment. in Popp.tract.deAntimonio'"]}, {"entity_id": "agricola", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Agricola", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Agricola"], "contexts": ["author of 'de natura fossilium'", "ancient Roman author"]}, {"entity_id": "loánes_agricola", "book_id": "historia_medicinal_monardes_1574", "name": "loánes Agricola", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["loánes Agricola"], "contexts": ["author on simple medicines"]}, {"entity_id": "agrícola", "book_id": "coloquios_da_orta_1563", "name": "Agrícola", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Agrícola"], "contexts": ["physician praising bezoars", "early modern scholar"]}, {"entity_id": "joao_agricola", "book_id": "polyanthea_medicinal", "name": "Joao Agricola", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Joao Agricola", "Jorge Agricola"], "contexts": ["cited for commentary on silver", "author of a book on plague"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Agricola", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Agricola", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Agricola", "target_book": "historia_medicinal_monardes_1574", "target_name": "loánes Agricola", "similarity": 0.82}, {"source_book": "polyanthea_medicinal", "source_name": "Agricola", "target_book": "coloquios_da_orta_1563", "target_name": "Agrícola", "similarity": 0.97}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Agricola", "target_book": "historia_medicinal_monardes_1574", "target_name": "loánes Agricola", "similarity": 0.82}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Agricola", "target_book": "coloquios_da_orta_1563", "target_name": "Agrícola", "similarity": 0.97}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Agricola", "target_book": "polyanthea_medicinal", "target_name": "Joao Agricola", "similarity": 0.82}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "loánes Agricola", "target_book": "coloquios_da_orta_1563", "target_name": "Agrícola", "similarity": 0.824}], "id": 156, "stable_key": "clu_98c950fe8f81c073", "ground_truth": {"modern_name": "Georgius Agricola", "confidence": "high", "type": "person", "description": "Early modern German scholar, physician, and author.", "note": "Refers to Georgius Agricola, a prominent figure in early modern natural knowledge.", "wikipedia_extract": "Georgius Agricola (; born Georg Bauer; 24 March 1494 – 21 November 1555) was a German Humanist scholar, mineralogist and metallurgist. Born in the small town of Glauchau, in the Electorate of Saxony of the Holy Roman Empire, he was broadly educated, but took a particular interest in the mining and refining of metals. He was the first to drop the Arabic definite article al-, exclusively writing chymia and chymista in describing activity that we today would characterize as chemical or alchemical, giving chemistry its modern name. For his groundbreaking work De Natura Fossilium published in 1546, he is generally referred to as the father of mineralogy and the founder of geology as a scientific discipline. He is well known for his pioneering work De re metallica libri XII, that was published in 1556, one year after his death. This 12-chapter work is a comprehensive and systematic study, classification and methodical guide on all available factual and practical aspects that are of concern for mining, the mining sciences and metallurgy, investigated and researched in its natural environment by means of direct observation."}}, {"canonical_name": "zedoaria", "category": "PLANT", "subcategory": "PLANT", "book_count": 4, "total_mentions": 13, "members": [{"entity_id": "zedoaria", "book_id": "polyanthea_medicinal", "name": "zedoaria", "category": "PLANT", "subcategory": "PLANT", "count": 7, "variants": ["zedoaria"], "contexts": ["root used in a purgative", "zedoary"]}, {"entity_id": "zedoàry", "book_id": "english_physician_1652", "name": "Zedoàry", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Zedoàry"], "contexts": ["herb used with butter-bur root"]}, {"entity_id": "zedoaria", "book_id": "coloquios_da_orta_1563", "name": "zedoaria", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["zedoaria", "ZEDOARIA", "Zedoría", "zedoaría"], "contexts": ["subject of colloquy", "plant with debated identity"]}, {"entity_id": "zedosria", "book_id": "ricettario_fiorentino_1597", "name": "Zedosria", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Zedosria"], "contexts": ["ingredient in a preparation"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "zedoaria", "target_book": "english_physician_1652", "target_name": "Zedoàry", "similarity": 0.903}, {"source_book": "polyanthea_medicinal", "source_name": "zedoaria", "target_book": "coloquios_da_orta_1563", "target_name": "zedoaria", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "zedoaria", "target_book": "ricettario_fiorentino_1597", "target_name": "Zedosria", "similarity": 0.854}, {"source_book": "english_physician_1652", "source_name": "Zedoàry", "target_book": "coloquios_da_orta_1563", "target_name": "zedoaria", "similarity": 0.903}, {"source_book": "english_physician_1652", "source_name": "Zedoàry", "target_book": "ricettario_fiorentino_1597", "target_name": "Zedosria", "similarity": 0.827}, {"source_book": "coloquios_da_orta_1563", "source_name": "zedoaria", "target_book": "ricettario_fiorentino_1597", "target_name": "Zedosria", "similarity": 0.854}], "id": 157, "stable_key": "clu_1110f0ea0c920d23", "ground_truth": {"modern_name": "Zedoary", "confidence": "high", "type": "plant", "linnaean": "Curcuma zedoaria", "family": "Zingiberaceae", "description": "A rhizomatous herbaceous perennial plant in the ginger family.", "wikipedia_extract": "Curcuma zedoaria (zedoary /ˈzɛdəʊərɪ/, white turmeric, or temu putih) is a perennial herb and member of the genus Curcuma, family Zingiberaceae. The plant is native to South Asia and Southeast Asia but is now naturalized in other places including the US state of Florida. Zedoary was one of the ancient food plants of the Austronesian peoples. They were spread during prehistoric times to the Pacific Islands and Madagascar during the Austronesian expansion (c. 3000 BCE). Its use as a spice in the West today is extremely rare, having been replaced by ginger, and to a lesser extent, yellow turmeric. The name zedoary derives from Persian via Arabic and Latin."}}, {"canonical_name": "Marseille", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 13, "members": [{"entity_id": "marseille", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Marseille", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Marseille"], "contexts": ["market for Crimean flour", "city in France"]}, {"entity_id": "marseilles", "book_id": "kosmos_humboldt_1845", "name": "Marseilles", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Marseilles"], "contexts": ["coast mentioned", "city on the Mediterranean coast"]}, {"entity_id": "marselha", "book_id": "coloquios_da_orta_1563", "name": "Marselha", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Marselha"], "contexts": ["port where the ship carrying the rhinoceros touched", "commercial city with spice tariffs"]}, {"entity_id": "marseilles", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Marseilles", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Marseilles"], "contexts": ["location of comet sighting", "location of comet observation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Marseille", "target_book": "kosmos_humboldt_1845", "target_name": "Marseilles", "similarity": 0.99}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Marseille", "target_book": "coloquios_da_orta_1563", "target_name": "Marselha", "similarity": 0.858}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Marseille", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Marseilles", "similarity": 0.99}, {"source_book": "kosmos_humboldt_1845", "source_name": "Marseilles", "target_book": "coloquios_da_orta_1563", "target_name": "Marselha", "similarity": 0.862}, {"source_book": "kosmos_humboldt_1845", "source_name": "Marseilles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Marseilles", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Marselha", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Marseilles", "similarity": 0.862}], "id": 158, "stable_key": "clu_663fbe58727823c6", "ground_truth": {"modern_name": "Marseille", "confidence": "high", "type": "place", "description": "Major port city in southern France.", "wikipedia_extract": "Marseille (Provençal Occitan: Marselha; see below) is a city in southern France, the prefecture of the department of Bouches-du-Rhône and of the Provence-Alpes-Côte d'Azur region. Situated in the Provence region, it is located on the coast of the Mediterranean Sea, near the mouth of the Rhône river. Marseille is the second-most populous city proper in France, after Paris, with 877,215 inhabitants in 2022 (Jan. census) over a municipal territory of 241 km2 (93 sq mi). Together with its suburbs and exurbs, the Marseille metropolitan area, which extends over 3,972 km2 (1,534 sq mi), had a population of 1,900,957 at the Jan. 2022 census. The cities of Marseille, Aix-en-Provence, and 90 suburban municipalities have formed since 2016 the Aix-Marseille-Provence Metropolis, an indirectly elected metropolitan authority now in charge of wider metropolitan issues, with a population of 1,922,626 at the Jan. 2022 census. Founded c. 600 BC by Greek settlers from Phocaea, Marseille is the oldest city in France, as well as one of Europe's oldest continuously inhabited settlements."}}, {"canonical_name": "Thermal springs", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 13, "members": [{"entity_id": "thermal_springs", "book_id": "kosmos_humboldt_1845", "name": "Thermal springs", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["thermal springs", "Thermal springs"], "contexts": ["hot water springs", "springs with uniform temperature"]}, {"entity_id": "aguas_calientes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "aguas calientes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["aguas calientes"], "contexts": ["name for hot springs location"]}, {"entity_id": "sources_thermales", "book_id": "relation_historique_humboldt_vol3_1825", "name": "sources thermales", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["sources thermales"], "contexts": ["geological feature"]}, {"entity_id": "thermas", "book_id": "polyanthea_medicinal", "name": "thermas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["thermas", "thermae"], "contexts": ["location for baths"]}, {"entity_id": "balneis_thermalibus", "book_id": "polyanthea_medicinal", "name": "balneis thermalibus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["balneis thermalibus"], "contexts": ["thermal baths"]}, {"entity_id": "hot_springs", "book_id": "connexion_physical_sciences_somerville_1858", "name": "hot springs", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["hot springs"], "contexts": ["geothermal features with high temperature", "geothermal features emitting hot water"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Thermal springs", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "aguas calientes", "similarity": 0.842}, {"source_book": "kosmos_humboldt_1845", "source_name": "Thermal springs", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "sources thermales", "similarity": 0.94}, {"source_book": "kosmos_humboldt_1845", "source_name": "Thermal springs", "target_book": "polyanthea_medicinal", "target_name": "thermas", "similarity": 0.921}, {"source_book": "kosmos_humboldt_1845", "source_name": "Thermal springs", "target_book": "polyanthea_medicinal", "target_name": "balneis thermalibus", "similarity": 0.862}, {"source_book": "kosmos_humboldt_1845", "source_name": "Thermal springs", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "hot springs", "similarity": 0.925}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "aguas calientes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "hot springs", "similarity": 0.88}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "sources thermales", "target_book": "polyanthea_medicinal", "target_name": "thermas", "similarity": 0.918}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "sources thermales", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "hot springs", "similarity": 0.855}, {"source_book": "polyanthea_medicinal", "source_name": "thermas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "hot springs", "similarity": 0.863}], "id": 159, "stable_key": "clu_34ba0afd5686a786", "ground_truth": {"modern_name": "thermal springs", "confidence": "high", "type": "place", "wikidata_id": "Q97726587", "wikidata_description": "scholarly article", "wikipedia_extract": "A hot spring, thermal spring, hydrothermal spring, or geothermal spring is a spring produced by the emergence of geothermally heated groundwater onto the surface of the Earth. The groundwater is heated either by shallow bodies of magma (molten rock) or by circulation through faults to hot rock deep in the Earth's crust. Hot spring water often contains large amounts of dissolved minerals. The chemistry of hot springs ranges from acid sulfate springs with a pH as low as 0.8, to alkaline chloride springs saturated with silica, to bicarbonate springs saturated with carbon dioxide and carbonate minerals. Some springs also contain abundant dissolved iron. The minerals brought to the surface in hot springs often feed communities of extremophiles, microorganisms adapted to extreme conditions, and it is possible that life on Earth had its origin in hot springs."}}, {"canonical_name": "Canará", "category": "PLACE", "subcategory": "REGION", "book_count": 4, "total_mentions": 13, "members": [{"entity_id": "canará", "book_id": "coloquios_da_orta_1563", "name": "Canará", "category": "PLACE", "subcategory": "REGION", "count": 7, "variants": ["Canará", "Canara"], "contexts": ["coastline ruled by Melik Kálur", "geographic region"]}, {"entity_id": "canar__inseln", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Canar. Inseln", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Canar. Inseln"], "contexts": ["location in book title"]}, {"entity_id": "canaverales", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Canaverales", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Canaverales"], "contexts": ["sugar cane plantations near Turbaco"]}, {"entity_id": "canary_islands", "book_id": "kosmos_humboldt_1845", "name": "Canary Islands", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Canary Islands"], "contexts": ["archipelago where Lancerote is", "islands with luxuriant fruit"]}, {"entity_id": "canaià", "book_id": "ricettario_fiorentino_1597", "name": "Canaià", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Canaià"], "contexts": ["region where cinnamon grows"]}, {"entity_id": "isole_canarie", "book_id": "ricettario_fiorentino_1597", "name": "Isole Canarie", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Isole Canarie"], "contexts": ["islands where Sangue di Drago tree grows"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Canará", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Canar. Inseln", "similarity": 0.848}, {"source_book": "coloquios_da_orta_1563", "source_name": "Canará", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Canaverales", "similarity": 0.848}, {"source_book": "coloquios_da_orta_1563", "source_name": "Canará", "target_book": "kosmos_humboldt_1845", "target_name": "Canary Islands", "similarity": 0.882}, {"source_book": "coloquios_da_orta_1563", "source_name": "Canará", "target_book": "ricettario_fiorentino_1597", "target_name": "Canaià", "similarity": 0.889}, {"source_book": "coloquios_da_orta_1563", "source_name": "Canará", "target_book": "ricettario_fiorentino_1597", "target_name": "Isole Canarie", "similarity": 0.923}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Canar. Inseln", "target_book": "kosmos_humboldt_1845", "target_name": "Canary Islands", "similarity": 0.925}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Canar. Inseln", "target_book": "ricettario_fiorentino_1597", "target_name": "Isole Canarie", "similarity": 0.907}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Canaverales", "target_book": "ricettario_fiorentino_1597", "target_name": "Canaià", "similarity": 0.839}, {"source_book": "kosmos_humboldt_1845", "source_name": "Canary Islands", "target_book": "ricettario_fiorentino_1597", "target_name": "Isole Canarie", "similarity": 0.935}], "id": 160, "stable_key": "clu_50b0cae27db5c062", "ground_truth": {"modern_name": "Canary Islands", "confidence": "high", "type": "place", "description": "Archipelago off the coast of northwestern Africa.", "note": "Includes references to regions, islands, and plantations that are geographically related or historically associated.", "wikipedia_extract": "The Canary Islands ( ; Spanish: Canarias [kaˈnaɾjas] ) or Canaries are an archipelago in the Atlantic Ocean and the southernmost autonomous community of Spain, located about 100 kilometres (60 mi) off the northwest coast of Africa. The archipelago has a population of approximately 2.27 million inhabitants, making it the most populous overseas special territory of the European Union. The seven main islands, listed from largest to smallest by area, are Tenerife, Fuerteventura, Gran Canaria, Lanzarote, La Palma, La Gomera, and El Hierro. The only other inhabited island is La Graciosa, which is administratively dependent on Lanzarote. The archipelago also includes numerous smaller islands and islets, such as Alegranza, Isla de Lobos, Montaña Clara, Roque del Oeste, and Roque del Este, as well as various rocks, including Garachico and Anaga. Historically, the island chain was referred to as \"the Fortunate Isles\"."}}, {"canonical_name": "astronomical observations", "category": "PRACTICE", "subcategory": "OTHER_PRACTICE", "book_count": 4, "total_mentions": 12, "members": [{"entity_id": "astronomical_observations", "book_id": "connexion_physical_sciences_somerville_1858", "name": "astronomical observations", "category": "PRACTICE", "subcategory": "OTHER_PRACTICE", "count": 3, "variants": ["astronomical observations"], "contexts": ["determining positions using celestial bodies", "observations of celestial bodies"]}, {"entity_id": "observation", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "observation", "category": "PRACTICE", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["observation"], "contexts": ["act of watching carefully"]}, {"entity_id": "astronomical_observations", "book_id": "kosmos_humboldt_1845", "name": "astronomical observations", "category": "PRACTICE", "subcategory": "OTHER_PRACTICE", "count": 2, "variants": ["astronomical observations"], "contexts": ["proofs for attraction determined by matter", "methods used in astronomy"]}, {"entity_id": "observations", "book_id": "kosmos_humboldt_1845", "name": "observations", "category": "PRACTICE", "subcategory": "OTHER_PRACTICE", "count": 2, "variants": ["observations"], "contexts": ["act of watching and recording", "act of watching carefully"]}, {"entity_id": "astronomical_observation", "book_id": "kosmos_humboldt_1845", "name": "astronomical observation", "category": "PRACTICE", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["astronomical observation"], "contexts": ["observing celestial bodies"]}, {"entity_id": "astronomical_observation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "astronomical observation", "category": "PRACTICE", "subcategory": "PRACTICE", "count": 2, "variants": ["astronomical observation"], "contexts": ["observing celestial bodies", "of Eudoxus"]}, {"entity_id": "observation", "book_id": "first_principles_spencer_1862", "name": "observation", "category": "PRACTICE", "subcategory": "PRACTICE", "count": 1, "variants": ["observation"], "contexts": ["act of watching or noticing"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "astronomical observations", "target_book": "kosmos_humboldt_1845", "target_name": "astronomical observations", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "astronomical observations", "target_book": "kosmos_humboldt_1845", "target_name": "observations", "similarity": 0.868}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "astronomical observations", "target_book": "kosmos_humboldt_1845", "target_name": "astronomical observation", "similarity": 0.883}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "observation", "target_book": "kosmos_humboldt_1845", "target_name": "observations", "similarity": 0.841}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "observation", "target_book": "kosmos_humboldt_1845", "target_name": "astronomical observation", "similarity": 0.88}, {"source_book": "kosmos_humboldt_1845", "source_name": "astronomical observations", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "astronomical observation", "similarity": 0.914}, {"source_book": "kosmos_humboldt_1845", "source_name": "observations", "target_book": "first_principles_spencer_1862", "target_name": "observation", "similarity": 0.879}, {"source_book": "kosmos_humboldt_1845", "source_name": "astronomical observation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "astronomical observation", "similarity": 0.811}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "astronomical observation", "target_book": "first_principles_spencer_1862", "target_name": "observation", "similarity": 0.848}], "id": 161, "stable_key": "clu_c870c05a19fbd361", "ground_truth": {"modern_name": "astronomical observation", "confidence": "high", "type": "concept", "wikidata_id": "Q11273602", "wikidata_description": "observation of the movements and changes of celestial bodies", "wikipedia_extract": "Observational astronomy is a division of astronomy that is concerned with recording data about the observable universe, the practice and study of observing celestial objects with the use of telescopes and other astronomical instruments. As a science, the study of astronomy does not rely on direct experiments with the objects in a distant universe. Rather astronomers have a vast number of visible examples of stellar phenomena that can be examined. This allows for observational data to be plotted on graphs, and general trends recorded. Nearby examples of specific phenomena, such as variable stars, can then be used to infer the behavior of more distant representatives. Those distant yardsticks can then be employed to measure other phenomena in that neighborhood, including the distance to a galaxy."}}, {"canonical_name": "fonte", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 12, "members": [{"entity_id": "fonte", "book_id": "polyanthea_medicinal", "name": "fonte", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["fonte", "da fonte"], "contexts": ["opening a vein for evacuation", "medical procedure"]}, {"entity_id": "fuentes", "book_id": "historia_medicinal_monardes_1574", "name": "fuentes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["fuentes"], "contexts": ["fountains created with artifice", "springs, sources of water"]}, {"entity_id": "fonti", "book_id": "ricettario_fiorentino_1597", "name": "fonti", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["fonti"], "contexts": ["water from springs", "source of water"]}, {"entity_id": "sources", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sources", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["sources"], "contexts": ["origin points of rivers"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "fonte", "target_book": "historia_medicinal_monardes_1574", "target_name": "fuentes", "similarity": 0.957}, {"source_book": "polyanthea_medicinal", "source_name": "fonte", "target_book": "ricettario_fiorentino_1597", "target_name": "fonti", "similarity": 0.904}, {"source_book": "polyanthea_medicinal", "source_name": "fonte", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sources", "similarity": 0.943}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "fuentes", "target_book": "ricettario_fiorentino_1597", "target_name": "fonti", "similarity": 0.886}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "fuentes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sources", "similarity": 0.971}], "id": 162, "stable_key": "clu_ded853f50da531aa", "ground_truth": {"modern_name": "Spring", "confidence": "high", "type": "place", "description": "A source of water, often from underground.", "note": "Encompasses natural water sources and the concept of a source.", "wikipedia_extract": "Geography (from Ancient Greek γεωγραφία geōgraphía; combining gê 'Earth' and gráphō 'write', literally 'Earth writing') is the study of the lands, features, inhabitants, and phenomena of Earth. Geography is an all-encompassing discipline that seeks an understanding of Earth and its human and natural complexities—not merely where objects are, but also how they have changed and come to be. While geography is specific to Earth, many concepts can be applied more broadly to other celestial bodies in the field of planetary science. Geography has been called \"a bridge between natural science and social science disciplines.\" The history of geography as a discipline spans cultures and millennia, being independently developed by multiple groups, and cross-pollinated by trade between these groups. Geography as a discipline dates back to the earliest attempts to understand the world spatially, with the earliest example of an attempted world map dating to the 9th century BC in ancient Babylon. Origins of many of the concepts in geography can be traced to Greek Eratosthenes of Cyrene, who may have coined the term \"geographia\" (c. 276 BC – c. 195/194 BC)."}}, {"canonical_name": "Hawks", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "hawks", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hawks", "category": "ANIMAL", "subcategory": "BIRD", "count": 4, "variants": ["Hawks"], "contexts": ["animal whose talons were tested for electricity", "have peculiar vermine"]}, {"entity_id": "hawk", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hawk", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Hawk"], "contexts": ["predator causing birds to be silent"]}, {"entity_id": "hawks", "book_id": "origin_of_species_darwin_1859", "name": "hawks", "category": "ANIMAL", "subcategory": "BIRD", "count": 3, "variants": ["hawks"], "contexts": ["predatory birds that hunt by sight", "birds of prey that hunt other birds"]}, {"entity_id": "hawks", "book_id": "principles_of_psychology_james_1890", "name": "hawks", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["hawks"], "contexts": ["raptorial birds"]}, {"entity_id": "hawk", "book_id": "first_principles_spencer_1862", "name": "hawk", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["hawk"], "contexts": ["bird of prey", "bird of prey whose appearance causes destruction"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hawks", "target_book": "origin_of_species_darwin_1859", "target_name": "hawks", "similarity": 0.964}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hawks", "target_book": "principles_of_psychology_james_1890", "target_name": "hawks", "similarity": 0.964}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hawks", "target_book": "first_principles_spencer_1862", "target_name": "hawk", "similarity": 0.947}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hawk", "target_book": "origin_of_species_darwin_1859", "target_name": "hawks", "similarity": 0.939}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hawk", "target_book": "principles_of_psychology_james_1890", "target_name": "hawks", "similarity": 0.939}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hawk", "target_book": "first_principles_spencer_1862", "target_name": "hawk", "similarity": 0.97}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hawks", "target_book": "principles_of_psychology_james_1890", "target_name": "hawks", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hawks", "target_book": "first_principles_spencer_1862", "target_name": "hawk", "similarity": 0.975}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hawks", "target_book": "first_principles_spencer_1862", "target_name": "hawk", "similarity": 0.975}], "id": 163, "stable_key": "clu_faba8ad364c6cdd2", "ground_truth": {"wikipedia_extract": "Hawks are birds of prey of the family Accipitridae. They are very widely distributed and are found on all continents, except Antarctica. The subfamily Accipitrinae includes goshawks, sparrowhawks, sharp-shinned hawks, and others. This subfamily are mainly woodland birds with short broad wings, long tails, and high visual acuity. They hunt by dashing suddenly from a concealed perch. In the United States, members of the Buteo group are also called hawks, though birds of this group are called buzzards in other parts of the world."}}, {"canonical_name": "paraíso terreal", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "paraíso_terreal", "book_id": "coloquios_da_orta_1563", "name": "paraíso terreal", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["paraíso terreal", "Parayzo terreal", "Paraíso terrestre", "paraizo terreal"], "contexts": ["place from which a substance is said to come", "mythical location"]}, {"entity_id": "paradise", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Paradise", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Paradise"], "contexts": ["biblical garden of Eden", "ideal place of knowledge"]}, {"entity_id": "paradise", "book_id": "kosmos_humboldt_1845", "name": "Paradise", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Paradise"], "contexts": ["biblical garden"]}, {"entity_id": "paraiſo_terreal", "book_id": "polyanthea_medicinal", "name": "Paraiſo terreal", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Paraiſo terreal"], "contexts": ["earthly paradise", "Earthly Paradise, location of the Tree of Life"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "paraíso terreal", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Paradise", "similarity": 0.907}, {"source_book": "coloquios_da_orta_1563", "source_name": "paraíso terreal", "target_book": "kosmos_humboldt_1845", "target_name": "Paradise", "similarity": 0.907}, {"source_book": "coloquios_da_orta_1563", "source_name": "paraíso terreal", "target_book": "polyanthea_medicinal", "target_name": "Paraiſo terreal", "similarity": 0.94}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Paradise", "target_book": "kosmos_humboldt_1845", "target_name": "Paradise", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Paradise", "target_book": "polyanthea_medicinal", "target_name": "Paraiſo terreal", "similarity": 0.884}, {"source_book": "kosmos_humboldt_1845", "source_name": "Paradise", "target_book": "polyanthea_medicinal", "target_name": "Paraiſo terreal", "similarity": 0.884}], "id": 164, "stable_key": "clu_a470ce0f759c4d99", "ground_truth": {"modern_name": "Earthly Paradise", "confidence": "high", "type": "place", "description": "A mythical location, often associated with the Garden of Eden.", "wikipedia_extract": "In Abrahamic mythology, the Garden of Eden (Biblical Hebrew: גַּן־עֵדֶן‎, romanized: gan-ʿĒḏen; Greek: Εδέμ; Latin: Paradisus) or Garden of God (גַּן־יְהֹוֶה‎, gan-YHWH and גַן־אֱלֹהִים‎, gan-Elohim), also called the Terrestrial Paradise, is the biblical paradise described in Genesis 2–3 and Ezekiel 28 and 31. The location of Eden is described in the Book of Genesis as the source of four tributaries. Various suggestions have been made for its location: at the head of the Persian Gulf, in southern Mesopotamia where the Tigris and Euphrates rivers run into the sea; and in Armenia. Others theorize that Eden was the entire Fertile Crescent or a region substantial in size in Mesopotamia, where its native inhabitants still exist in cities such as Telassar. Like the Genesis flood narrative, the Genesis creation narrative and the account of the Tower of Babel, the story of Eden echoes the Mesopotamian myth of a king, as a primordial man, who is placed in a divine garden to guard the tree of life. Scholars note that the Eden narrative shows parallels with aspects of Solomon's Temple and Jerusalem, attesting to its nature as a sacred place."}}, {"canonical_name": "Ovidio", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "ovidio", "book_id": "coloquios_da_orta_1563", "name": "Ovidio", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["Ovidio", "Ovídio"], "contexts": ["classical author of metamorphoses", "classical Greek and Latin mythology comparison"]}, {"entity_id": "ovid", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ovid", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Ovid"], "contexts": ["Roman poet", "ancient writer"]}, {"entity_id": "ovid", "book_id": "kosmos_humboldt_1845", "name": "Ovid", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Ovid"], "contexts": ["Roman poet who described natural phenomenon", "ancient poet describing eruption"]}, {"entity_id": "ovidio", "book_id": "polyanthea_medicinal", "name": "Ovidio", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Ovidio"], "contexts": ["cited for a quote about monuments and writing"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Ovidio", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Ovid", "similarity": 0.788}, {"source_book": "coloquios_da_orta_1563", "source_name": "Ovidio", "target_book": "kosmos_humboldt_1845", "target_name": "Ovid", "similarity": 0.788}, {"source_book": "coloquios_da_orta_1563", "source_name": "Ovidio", "target_book": "polyanthea_medicinal", "target_name": "Ovidio", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ovid", "target_book": "kosmos_humboldt_1845", "target_name": "Ovid", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ovid", "target_book": "polyanthea_medicinal", "target_name": "Ovidio", "similarity": 0.788}, {"source_book": "kosmos_humboldt_1845", "source_name": "Ovid", "target_book": "polyanthea_medicinal", "target_name": "Ovidio", "similarity": 0.788}], "id": 165, "stable_key": "clu_0d6da417cb9a92c9", "ground_truth": {"modern_name": "Ovid", "confidence": "high", "type": "person", "description": "Roman poet, author of 'Metamorphoses' and known for classical mythology.", "wikipedia_extract": "Publius Ovidius Naso (Latin: [ˈpuːbliʊs ɔˈwɪdiʊs ˈnaːsoː]; 20 March 43 BC – AD 17/18), known in English as Ovid ( OV-id), was a Roman poet who lived during the reign of Augustus. He was a younger contemporary of Virgil and Horace, with whom he is often ranked as one of the three canonical poets of Latin literature. The Imperial scholar Quintilian considered him the last of the Latin love elegists. Although Ovid enjoyed enormous popularity during his lifetime, the emperor Augustus exiled him to Tomis, the capital of the newly organised province of Moesia, on the Black Sea, where he remained for the last nine or ten years of his life. Ovid himself attributed his banishment to a carmen et error (\"poem and a mistake\"), but his reluctance to disclose specifics has resulted in much speculation among scholars. Ovid is most famous for the Metamorphoses, a continuous mythological narrative in fifteen books written in dactylic hexameters."}}, {"canonical_name": "Labrador", "category": "PLACE", "subcategory": "REGION", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "labrador", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Labrador", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Labrador"], "contexts": ["wild country", "territory in Canada"]}, {"entity_id": "labrador", "book_id": "origin_of_species_darwin_1859", "name": "Labrador", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Labrador"], "contexts": ["region with similar plants to White Mountains", "region with arctic plants"]}, {"entity_id": "labrador", "book_id": "kosmos_humboldt_1845", "name": "Labrador", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Labrador"], "contexts": ["peninsula in northeastern Canada", "coastal area in Eastern America"]}, {"entity_id": "labrador", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Labrador", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Labrador"], "contexts": ["coast with Table Bay on freezing point line", "region in Canada"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Labrador", "target_book": "origin_of_species_darwin_1859", "target_name": "Labrador", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Labrador", "target_book": "kosmos_humboldt_1845", "target_name": "Labrador", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Labrador", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Labrador", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Labrador", "target_book": "kosmos_humboldt_1845", "target_name": "Labrador", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Labrador", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Labrador", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Labrador", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Labrador", "similarity": 1.0}], "id": 166, "stable_key": "clu_210aaea351081370", "ground_truth": {"modern_name": "Labrador", "confidence": "high", "type": "place", "description": "A large geographical region in northeastern Canada.", "note": "Refers to the geographical region of Labrador, known for its arctic flora and wild terrain.", "wikipedia_extract": "Labrador () is a geographic and cultural region within the Canadian province of Newfoundland and Labrador. It is the primarily continental portion of the province and constitutes 71% of the province's area but is home to only 6% of its population. It is separated from the island of Newfoundland by the Strait of Belle Isle. It is the largest and northernmost geographical region in the four Atlantic provinces. Labrador occupies most of the eastern part of the Labrador Peninsula. It is bordered to the west and south by the province of Quebec."}}, {"canonical_name": "death", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 10, "members": [{"entity_id": "death", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "death", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["death", "Death"], "contexts": ["consequence of transgression", "cessation of life"]}, {"entity_id": "death", "book_id": "english_physician_1652", "name": "Death", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Death"], "contexts": ["final end for man", "state of being cold"]}, {"entity_id": "death", "book_id": "origin_of_species_darwin_1859", "name": "death", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["death"], "contexts": ["cessation of life"]}, {"entity_id": "décès", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Décès", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Décès", "DÉCÈS"], "contexts": ["death concept", "vital statistic"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "death", "target_book": "english_physician_1652", "target_name": "Death", "similarity": 0.993}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "death", "target_book": "origin_of_species_darwin_1859", "target_name": "death", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "death", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Décès", "similarity": 0.949}, {"source_book": "english_physician_1652", "source_name": "Death", "target_book": "origin_of_species_darwin_1859", "target_name": "death", "similarity": 0.993}, {"source_book": "english_physician_1652", "source_name": "Death", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Décès", "similarity": 0.95}, {"source_book": "origin_of_species_darwin_1859", "source_name": "death", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Décès", "similarity": 0.949}], "id": 167, "stable_key": "clu_e6de5df08f94374e", "ground_truth": {"modern_name": "death", "confidence": "high", "type": "concept", "description": "The irreversible cessation of all biological functions that sustain a living organism.", "wikipedia_extract": "Death is the end of life; it is the irreversible cessation of biological functions that sustain a living organism. Death is thought to eventually and inevitably occur in all organisms; though some organisms, such as the immortal jellyfish, are biologically immortal, they can however still die from means other than the effects of aging. Something that is not considered an organism may be said \"to die\" in a figurative sense when it reaches an inactive state, such as when a star runs out of fuel. As of the early 21st century, 56 million people die per year. As of 2022, an estimated total of almost 110 billion humans have died, or roughly 94% of all humans to have ever lived. The cause of death is usually considered important, and an autopsy can be done to determine it."}}, {"canonical_name": "Oxford", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 10, "members": [{"entity_id": "oxford", "book_id": "kosmos_humboldt_1845", "name": "Oxford", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Oxford"], "contexts": ["place where Holberg studied", "location of British Association meeting"]}, {"entity_id": "oxford", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Oxford", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Oxford"], "contexts": ["location of Geometry Professor"]}, {"entity_id": "oxford", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Oxford", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Oxford"], "contexts": ["city in New York"]}, {"entity_id": "oxford", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Oxford", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Oxford"], "contexts": ["location of Professor Powell", "university associated with Professor Powell"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Oxford", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Oxford", "similarity": 0.848}, {"source_book": "kosmos_humboldt_1845", "source_name": "Oxford", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Oxford", "similarity": 0.848}, {"source_book": "kosmos_humboldt_1845", "source_name": "Oxford", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Oxford", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Oxford", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Oxford", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Oxford", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Oxford", "similarity": 0.848}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oxford", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Oxford", "similarity": 0.848}], "id": 168, "stable_key": "clu_23fd66d5dfb2348d", "ground_truth": {"modern_name": "Oxford", "confidence": "high", "type": "place", "country": "United Kingdom", "note": "While Oxford is primarily known as a city in the UK, the context mentions \"city in New York,\" suggesting a potential reference to Oxford, New York. However, the overwhelming majority of references are to the UK university city, which is a significant early modern intellectual hub.", "wikidata_id": "Q34217", "wikidata_description": "city in Oxfordshire, England", "wikipedia_url": "https://en.wikipedia.org/wiki/Oxford", "wikipedia_extract": "Oxford ( ) is a cathedral city and non-metropolitan district in Oxfordshire, England, of which it is the county town. The city is home to the University of Oxford, the oldest university in the English-speaking world; it has buildings in every style of English architecture since late Anglo-Saxon. Oxford's industries include motor manufacturing, education, publishing, science, and information technologies. Founded in the 8th century, it was granted city status in 1542. The city is located at the confluence of the rivers Thames (locally known as the Isis) and Cherwell. It had a population of 166,034 in 2024."}}, {"canonical_name": "Asparagus", "category": "PLANT", "subcategory": "PLANT", "book_count": 4, "total_mentions": 10, "members": [{"entity_id": "asparagus", "book_id": "english_physician_1652", "name": "Asparagus", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Asparagus"], "contexts": ["a plant with edible shoots", "shoots compared to those of Butchers-Broom"]}, {"entity_id": "garden_asparagus", "book_id": "english_physician_1652", "name": "Garden Asparagus", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Garden Asparagus"], "contexts": ["nourishes more than wild asparagus"]}, {"entity_id": "asparagus_roots", "book_id": "english_physician_1652", "name": "Asparagus Roots", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Asparagus Roots"], "contexts": ["in Decoction"]}, {"entity_id": "asparagus_plant", "book_id": "origin_of_species_darwin_1859", "name": "asparagus plant", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["asparagus plant"], "contexts": ["a type of plant"]}, {"entity_id": "asparagus", "book_id": "origin_of_species_darwin_1859", "name": "Asparagus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Asparagus"], "contexts": ["mentioned in text"]}, {"entity_id": "asparagorum", "book_id": "relation_historique_humboldt_vol3_1825", "name": "asparagorum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["asparagorum"], "contexts": ["plant juice used for intoxication"]}, {"entity_id": "asparagus", "book_id": "coloquios_da_orta_1563", "name": "Asparagus", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Asparagus", "AsparaguSf"], "contexts": ["plant species Orta might have seen", "plant species"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Asparagus", "target_book": "origin_of_species_darwin_1859", "target_name": "asparagus plant", "similarity": 0.842}, {"source_book": "english_physician_1652", "source_name": "Asparagus", "target_book": "origin_of_species_darwin_1859", "target_name": "Asparagus", "similarity": 0.902}, {"source_book": "english_physician_1652", "source_name": "Asparagus", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "asparagorum", "similarity": 0.851}, {"source_book": "english_physician_1652", "source_name": "Asparagus", "target_book": "coloquios_da_orta_1563", "target_name": "Asparagus", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Garden Asparagus", "target_book": "coloquios_da_orta_1563", "target_name": "Asparagus", "similarity": 0.89}, {"source_book": "english_physician_1652", "source_name": "Asparagus Roots", "target_book": "coloquios_da_orta_1563", "target_name": "Asparagus", "similarity": 0.829}, {"source_book": "origin_of_species_darwin_1859", "source_name": "asparagus plant", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "asparagorum", "similarity": 0.95}, {"source_book": "origin_of_species_darwin_1859", "source_name": "asparagus plant", "target_book": "coloquios_da_orta_1563", "target_name": "Asparagus", "similarity": 0.842}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Asparagus", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "asparagorum", "similarity": 0.959}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Asparagus", "target_book": "coloquios_da_orta_1563", "target_name": "Asparagus", "similarity": 0.902}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "asparagorum", "target_book": "coloquios_da_orta_1563", "target_name": "Asparagus", "similarity": 0.851}], "id": 169, "stable_key": "clu_26a2838513b2904a", "ground_truth": {"modern_name": "Asparagus", "confidence": "high", "type": "plant", "linnaean": "Asparagus officinalis", "family": "Asparagaceae", "description": "Edible shoots of a perennial plant, also known as garden asparagus.", "wikipedia_extract": "Asparagus (Asparagus officinalis) or garden asparagus is a perennial flowering plant species in the genus Asparagus native to Eurasia. Widely cultivated as a vegetable crop, its young shoots are used as a spring vegetable. Asparagus is an herbaceous, perennial plant growing typically to 100–150 centimetres (3–5 feet) tall, with stout stems with much-branched, feathery foliage. It has been known to grow as long as 3.5 metres (11 ft). The 'leaves' are needle-like cladodes (modified stems) in the axils of scale leaves; they are 6–32 millimetres (1⁄4–1+1⁄4 inches) long and 1 mm (1⁄32 in) broad, and clustered in fours, up to 15, together, in a rose-like shape. The root system, often referred to as a 'crown', is adventitious; the root type is fasciculated."}}, {"canonical_name": "Rhine", "category": "PLACE", "subcategory": "REGION", "book_count": 4, "total_mentions": 10, "members": [{"entity_id": "rhine", "book_id": "kosmos_humboldt_1845", "name": "Rhine", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Rhine"], "contexts": ["river valley in Germany", "river forming fissures"]}, {"entity_id": "rhine", "book_id": "english_physician_1652", "name": "Rhine", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Rhine"], "contexts": ["region of Count Frederick"]}, {"entity_id": "rhine", "book_id": "origin_of_species_darwin_1859", "name": "Rhine", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Rhine"], "contexts": ["river with evidence of land level changes", "river with geological changes"]}, {"entity_id": "rhin", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rhin", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Rhin"], "contexts": ["river level used for canal measurement", "river where Reboul studied strata"]}, {"entity_id": "lower_rhine", "book_id": "kosmos_humboldt_1845", "name": "Lower Rhine", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Lower Rhine"], "contexts": ["region with lignite deposits"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Rhine", "target_book": "english_physician_1652", "target_name": "Rhine", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Rhine", "target_book": "origin_of_species_darwin_1859", "target_name": "Rhine", "similarity": 0.817}, {"source_book": "english_physician_1652", "source_name": "Rhine", "target_book": "origin_of_species_darwin_1859", "target_name": "Rhine", "similarity": 0.817}, {"source_book": "english_physician_1652", "source_name": "Rhine", "target_book": "kosmos_humboldt_1845", "target_name": "Lower Rhine", "similarity": 0.867}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Rhine", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Rhin", "similarity": 0.972}], "id": 170, "stable_key": "clu_43d112a61a116f0f", "ground_truth": {"modern_name": "Rhine River", "confidence": "high", "type": "place", "description": "Major European river, important for trade, geography, and geology.", "wikipedia_extract": "The Rhine ( RYNE) is one of the major rivers of Europe. The river begins in the Swiss canton of Graubünden in the southeastern Swiss Alps. It forms part of the Swiss-Liechtenstein border, then part of the Swiss-Austrian border. From Lake Constance downstream, it forms part of the Swiss-German border. After that the Rhine defines much of the Franco-German border. It then flows in a mostly northerly direction through the German Rhineland."}}, {"canonical_name": "St. Helena", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 10, "members": [{"entity_id": "st__helena", "book_id": "connexion_physical_sciences_somerville_1858", "name": "St. Helena", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["St. Helena"], "contexts": ["island in the Atlantic Ocean", "location for magnetic observations"]}, {"entity_id": "st__helena", "book_id": "origin_of_species_darwin_1859", "name": "St. Helena", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["St. Helena"], "contexts": ["island where naturalised plants/animals exterminated natives", "oceanic island with native productions exterminated"]}, {"entity_id": "saint_helena", "book_id": "principles_of_psychology_james_1890", "name": "Saint Helena", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Saint Helena"], "contexts": ["island associated with Napoleon's exile"]}, {"entity_id": "st__helena", "book_id": "kosmos_humboldt_1845", "name": "St. Helena", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["St. Helena"], "contexts": ["volcanic island with augmented gravitation", "island in magnetic zone"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "St. Helena", "target_book": "origin_of_species_darwin_1859", "target_name": "St. Helena", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "St. Helena", "target_book": "principles_of_psychology_james_1890", "target_name": "Saint Helena", "similarity": 0.972}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "St. Helena", "target_book": "kosmos_humboldt_1845", "target_name": "St. Helena", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "St. Helena", "target_book": "principles_of_psychology_james_1890", "target_name": "Saint Helena", "similarity": 0.972}, {"source_book": "origin_of_species_darwin_1859", "source_name": "St. Helena", "target_book": "kosmos_humboldt_1845", "target_name": "St. Helena", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Saint Helena", "target_book": "kosmos_humboldt_1845", "target_name": "St. Helena", "similarity": 0.972}], "id": 171, "stable_key": "clu_33c6e9f0b1f0d5db", "ground_truth": {"wikipedia_extract": "Saint Helena (, US: ; US:  ) is a volcanic and tropical island, located in the South Atlantic Ocean, some 1,874 km (1,165 miles) west of the mainland of the continent of Africa, with the Southern African nations of Angola and Namibia on its southeastern coast being the closest nations geographically. The island is around 1,950 km (1,210 mi) west of the coast of southwestern Angola, and 4,000 km (2,500 mi) east of the major seaport city of Rio de Janeiro, Brazil in South America. It is one of the three constituent parts of Saint Helena, Ascension and Tristan da Cunha, a British overseas territory. Saint Helena measures about 16 by 8 km (10 by 5 mi) and had a population of 4,439 in the 2021 census. It was named after Saint Helena (c. AD 246/248–330), the mother of the Roman emperor Constantine I (AD 272–337, reigned 306–337), also known as Constantine the Great."}}, {"canonical_name": "Suez", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 10, "members": [{"entity_id": "suez", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Suez", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Suez"], "contexts": ["location of another isthmus", "canal project"]}, {"entity_id": "suez", "book_id": "kosmos_humboldt_1845", "name": "Suez", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Suez"], "contexts": ["location of bitter lakes"]}, {"entity_id": "isthmus_of_suez", "book_id": "kosmos_humboldt_1845", "name": "Isthmus of Suez", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Isthmus of Suez"], "contexts": ["location with different water levels"]}, {"entity_id": "suez", "book_id": "coloquios_da_orta_1563", "name": "Suez", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Suez"], "contexts": ["port city", "destination from Red Sea"]}, {"entity_id": "suez", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Suez", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Suez"], "contexts": ["location with different marine plants"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Suez", "target_book": "kosmos_humboldt_1845", "target_name": "Suez", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Suez", "target_book": "kosmos_humboldt_1845", "target_name": "Isthmus of Suez", "similarity": 0.915}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Suez", "target_book": "coloquios_da_orta_1563", "target_name": "Suez", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Suez", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Suez", "similarity": 0.838}, {"source_book": "kosmos_humboldt_1845", "source_name": "Suez", "target_book": "coloquios_da_orta_1563", "target_name": "Suez", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Suez", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Suez", "similarity": 0.838}, {"source_book": "kosmos_humboldt_1845", "source_name": "Isthmus of Suez", "target_book": "coloquios_da_orta_1563", "target_name": "Suez", "similarity": 0.915}, {"source_book": "coloquios_da_orta_1563", "source_name": "Suez", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Suez", "similarity": 0.838}], "id": 172, "stable_key": "clu_8a33d0dab68a2b4a", "ground_truth": {"modern_name": "Suez", "confidence": "high", "type": "place", "description": "Port city and location of an isthmus and canal project.", "wikipedia_extract": "Suez is a seaport city in north-eastern Egypt, located on the north coast of the Gulf of Suez on the Red Sea, near the southern terminus of the Suez Canal. The city is the capital and largest city of the Suez Governorate. The modern city of Suez is a successor of the ancient Egyptian city of Clysma, a major Red Sea port and a center of monasticism. Railway lines and highways connect the city with Cairo, Port Said, and Ismailia. Suez has a petrochemical plant, and its oil refineries have pipelines carrying the finished product to Cairo. These are represented in the flag of the governorate: the blue background refers to the sea, the gear refers to Suez's status as an industrial governorate, and the flame refers to the petroleum firms of Suez."}}, {"canonical_name": "fuligens", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 10, "members": [{"entity_id": "fuligens", "book_id": "polyanthea_medicinal", "name": "fuligens", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 7, "variants": ["fuligens"], "contexts": ["soot", "bodily effluvia"]}, {"entity_id": "fulmen", "book_id": "kosmos_humboldt_1845", "name": "fulmen", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["fulmen"], "contexts": ["Latin for lightning"]}, {"entity_id": "faujil", "book_id": "coloquios_da_orta_1563", "name": "faujil", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["faujil"], "contexts": ["substance used as a substitute"]}, {"entity_id": "filiggine", "book_id": "ricettario_fiorentino_1597", "name": "filiggine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["filiggine"], "contexts": ["soot collected from burning"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "fuligens", "target_book": "kosmos_humboldt_1845", "target_name": "fulmen", "similarity": 0.851}, {"source_book": "polyanthea_medicinal", "source_name": "fuligens", "target_book": "coloquios_da_orta_1563", "target_name": "faujil", "similarity": 0.85}, {"source_book": "polyanthea_medicinal", "source_name": "fuligens", "target_book": "ricettario_fiorentino_1597", "target_name": "filiggine", "similarity": 0.851}], "id": 173, "stable_key": "clu_0a5e97ab2469c8b2", "ground_truth": {"modern_name": "Soot", "confidence": "high", "type": "substance", "description": "Fine black powder produced by the incomplete burning of organic matter.", "note": "Also refers to bodily effluvia.", "wikipedia_extract": "Soot ( suut) is a mass of impure carbon particles resulting from the incomplete combustion of hydrocarbons. Soot is considered a hazardous substance with carcinogenic properties. Most broadly, the term includes all the particulate matter produced by this process, including black carbon and residual pyrolysed fuel particles such as coal, cenospheres, charred wood, and petroleum coke classified as cokes or char. It can include polycyclic aromatic hydrocarbons and heavy metals like mercury. Soot causes various types of cancer and lung disease. Among scientists, exact definitions for soot vary, depending partly on their field."}}, {"canonical_name": "fusion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 10, "members": [{"entity_id": "fusion", "book_id": "principles_of_psychology_james_1890", "name": "fusion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["fusion"], "contexts": ["concept of merging into one", "process of combining elements"]}, {"entity_id": "fusion_point", "book_id": "kosmos_humboldt_1845", "name": "fusion point", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fusion point"], "contexts": ["property studied in chemical experiments"]}, {"entity_id": "fusion", "book_id": "kosmos_humboldt_1845", "name": "fusion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fusion"], "contexts": ["process of melting"]}, {"entity_id": "fusion", "book_id": "connexion_physical_sciences_somerville_1858", "name": "fusion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["fusion"], "contexts": ["transition from solid to liquid", "process of melting"]}, {"entity_id": "fusion", "book_id": "first_principles_spencer_1862", "name": "fusion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fusion"], "contexts": ["transition from solid to liquid state"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "fusion", "target_book": "kosmos_humboldt_1845", "target_name": "fusion point", "similarity": 0.906}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fusion", "target_book": "kosmos_humboldt_1845", "target_name": "fusion", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fusion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fusion", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fusion", "target_book": "first_principles_spencer_1862", "target_name": "fusion", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "fusion point", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fusion", "similarity": 0.906}, {"source_book": "kosmos_humboldt_1845", "source_name": "fusion point", "target_book": "first_principles_spencer_1862", "target_name": "fusion", "similarity": 0.906}, {"source_book": "kosmos_humboldt_1845", "source_name": "fusion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fusion", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "fusion", "target_book": "first_principles_spencer_1862", "target_name": "fusion", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "fusion", "target_book": "first_principles_spencer_1862", "target_name": "fusion", "similarity": 1.0}], "id": 174, "stable_key": "clu_20248b48f32abb97", "ground_truth": {"modern_name": "Melting point", "confidence": "high", "type": "concept", "note": "The contexts 'fusion point' and 'process of melting' clearly point to the physical phenomenon of phase transition.", "wikidata_id": "Q465149", "wikidata_description": "process in which adding a solute to a solvent decreases the freezing point of the solvent", "wikipedia_url": "https://en.wikipedia.org/wiki/Freezing-point%20depression", "wikipedia_extract": "The melting point (or, rarely, liquefaction point) of a substance is the temperature at which it changes state from solid to liquid. At the melting point the solid and liquid phase exist in equilibrium. The melting point of a substance depends on pressure and is usually specified at a standard pressure such as 1 atmosphere or 100 kPa. When considered as the temperature of the reverse change from liquid to solid, it is referred to as the freezing point or crystallization point. Because of the ability of substances to supercool, the freezing point can easily appear to be below its actual value. When the \"characteristic freezing point\" of a substance is determined, in fact, the actual methodology is almost always \"the principle of observing the disappearance rather than the formation of ice, that is, the melting point.\" For most substances, melting and freezing points are approximately equal."}}, {"canonical_name": "Amsterdam", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 10, "members": [{"entity_id": "amsterdam", "book_id": "coloquios_da_orta_1563", "name": "Amsterdam", "category": "PLACE", "subcategory": "CITY", "count": 7, "variants": ["Amsterdam", "Amstelo-dami", "Amstelodami", "Amstelsedami"], "contexts": ["publication location", "publication location of Niebuhr's book"]}, {"entity_id": "amsterdam", "book_id": "principles_of_psychology_james_1890", "name": "Amsterdam", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Amsterdam"], "contexts": ["location of publication"]}, {"entity_id": "amsterdam", "book_id": "kosmos_humboldt_1845", "name": "Amsterdam", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Amsterdam"], "contexts": ["city Varenius sought refuge in"]}, {"entity_id": "amsterdaó", "book_id": "polyanthea_medicinal", "name": "Amsterdaó", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Amsterdaó"], "contexts": ["city"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Amsterdam", "target_book": "principles_of_psychology_james_1890", "target_name": "Amsterdam", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Amsterdam", "target_book": "kosmos_humboldt_1845", "target_name": "Amsterdam", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Amsterdam", "target_book": "polyanthea_medicinal", "target_name": "Amsterdaó", "similarity": 0.906}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Amsterdam", "target_book": "kosmos_humboldt_1845", "target_name": "Amsterdam", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Amsterdam", "target_book": "polyanthea_medicinal", "target_name": "Amsterdaó", "similarity": 0.906}, {"source_book": "kosmos_humboldt_1845", "source_name": "Amsterdam", "target_book": "polyanthea_medicinal", "target_name": "Amsterdaó", "similarity": 0.906}], "id": 175, "stable_key": "clu_fc53f079d20e0c64", "ground_truth": {"modern_name": "Amsterdam", "confidence": "high", "type": "place", "description": "Major city in the Netherlands, a hub for trade and publication.", "wikipedia_extract": "Amsterdam (Dutch: [ˌɑmstərˈdɑm] ; lit. 'Dam in the Amstel') is the capital and largest city of the Netherlands. It has a population of 933,680 in June 2024 within the city proper, 1,457,018 in the urban area and 2,480,394 in the metropolitan area. Located in the Dutch province of North Holland, Amsterdam is colloquially referred to as the \"Venice of the North\", for its large number of canals, now a UNESCO World Heritage Site. Amsterdam was founded at the mouth of the Amstel River, which was dammed to control flooding. Originally a small fishing village in the 12th century, Amsterdam became a major world port during the Dutch Golden Age of the 17th century, when the Netherlands was an economic powerhouse. Amsterdam was the leading centre for finance and trade, as well as a hub of secular art production."}}, {"canonical_name": "Damasco", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "damasco", "book_id": "coloquios_da_orta_1563", "name": "Damasco", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Damasco"], "contexts": ["route to Mediterranean ports", "trading city"]}, {"entity_id": "damascus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Damascus", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Damascus"], "contexts": ["city with waters"]}, {"entity_id": "damascus", "book_id": "english_physician_1652", "name": "Damascus", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Damascus"], "contexts": ["King of Damascus"]}, {"entity_id": "damaſco", "book_id": "polyanthea_medicinal", "name": "Damaſco", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Damaſco"], "contexts": ["City ruled by King Hermes"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Damasco", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Damascus", "similarity": 0.99}, {"source_book": "coloquios_da_orta_1563", "source_name": "Damasco", "target_book": "english_physician_1652", "target_name": "Damascus", "similarity": 0.99}, {"source_book": "coloquios_da_orta_1563", "source_name": "Damasco", "target_book": "polyanthea_medicinal", "target_name": "Damaſco", "similarity": 0.844}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Damascus", "target_book": "english_physician_1652", "target_name": "Damascus", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Damascus", "target_book": "polyanthea_medicinal", "target_name": "Damaſco", "similarity": 0.834}, {"source_book": "english_physician_1652", "source_name": "Damascus", "target_book": "polyanthea_medicinal", "target_name": "Damaſco", "similarity": 0.834}], "id": 176, "stable_key": "clu_149bf5e9ccb48d31", "ground_truth": {"modern_name": "Damascus", "confidence": "high", "type": "place", "description": "Ancient city in Syria, significant as a trade route and political center.", "note": "Also referred to as Damasco.", "wikipedia_extract": "Damascus is the capital and largest city of Syria. It is the oldest capital city in the world. Known colloquially in Syria as aš-Šām and dubbed, poetically, the \"City of Jasmine\" (مَدِيْنَةُ الْيَاسْمِينِ Madīnat al-Yāsmīn), Damascus is a major cultural center of the Levant and the Arab world. Situated in southwestern Syria, Damascus is the center of a large metropolitan area. Nestled among the eastern foothills of the Anti-Lebanon mountain range 80 kilometres (50 mi) inland from the eastern shore of the Mediterranean on a plateau 680 metres (2,230 ft) above sea level, Damascus experiences an arid climate because of the rain shadow effect. The Barada River flows through Damascus."}}, {"canonical_name": "San Miguel", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "san_miguel", "book_id": "relation_historique_humboldt_vol3_1825", "name": "San Miguel", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["San Miguel", "San Miguel de Unala"], "contexts": ["gulf", "gulf name"]}, {"entity_id": "saint_michael", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Saint Michael", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Saint Michael"], "contexts": ["island with middle situation"]}, {"entity_id": "st__michael", "book_id": "kosmos_humboldt_1845", "name": "St. Michael", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["St. Michael"], "contexts": ["island in the Azores"]}, {"entity_id": "sam_miguel", "book_id": "coloquios_da_orta_1563", "name": "Sam Miguel", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Sam Miguel"], "contexts": ["name of a church"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "San Miguel", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Saint Michael", "similarity": 0.858}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "San Miguel", "target_book": "kosmos_humboldt_1845", "target_name": "St. Michael", "similarity": 0.849}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "San Miguel", "target_book": "coloquios_da_orta_1563", "target_name": "Sam Miguel", "similarity": 0.886}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Saint Michael", "target_book": "kosmos_humboldt_1845", "target_name": "St. Michael", "similarity": 0.985}], "id": 177, "stable_key": "clu_1605e4d52f50b6a9", "ground_truth": {"modern_name": "San Miguel", "confidence": "high", "type": "place", "description": "Gulf and church name, likely referring to a specific geographical location.", "wikipedia_extract": "Saint Junípero Serra Ferrer  (; Spanish: [xuˈnipeɾo ˈsera]; November 24, 1713 – August 28, 1784), popularly known simply as Junipero Serra, was a Spanish Catholic priest and missionary of the Franciscan Order. He is credited with establishing the Franciscan Missions in the Sierra Gorda, a UNESCO World Heritage Site. He founded a mission in Baja California and established eight of the 21 Spanish missions in California from San Diego to San Francisco, in what was then Spanish-occupied Alta California in the Province of Las Californias of New Spain. Serra was beatified by Pope John Paul II on 25 September 1988 in Vatican City. Amid denunciations from Native American tribes who accused Serra of presiding over a brutal colonial subjugation, Pope Francis canonized Serra on 23 September 2015 at the Basilica of the National Shrine of the Immaculate Conception in Washington, D.C., during his visit to the United States. Serra's missionary efforts earned him the title of \"Apostle of California\"."}}, {"canonical_name": "cephalopods", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "cephalopods", "book_id": "origin_of_species_darwin_1859", "name": "cephalopods", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["cephalopods", "Cephalopods"], "contexts": ["ancient animal group", "older class of marine animals"]}, {"entity_id": "cephalopodes", "book_id": "kosmos_humboldt_1845", "name": "Cephalopodes", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Cephalopodes"], "contexts": ["animal substance preserved in Oxford clay", "marine mollusks"]}, {"entity_id": "cephalopoda", "book_id": "kosmos_humboldt_1845", "name": "Cephalopoda", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Cephalopoda"], "contexts": ["marine mollusc group"]}, {"entity_id": "cephalaspides", "book_id": "kosmos_humboldt_1845", "name": "Cephalaspides", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Cephalaspides"], "contexts": ["family of fossil fish"]}, {"entity_id": "cephalopodes", "book_id": "coloquios_da_orta_1563", "name": "Cephalopodes", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["Cephalopodes"], "contexts": ["animals with horny maxillae"]}, {"entity_id": "cephalopods", "book_id": "first_principles_spencer_1862", "name": "Cephalopods", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Cephalopods"], "contexts": ["shelled marine invertebrates"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "cephalopods", "target_book": "kosmos_humboldt_1845", "target_name": "Cephalopodes", "similarity": 0.912}, {"source_book": "origin_of_species_darwin_1859", "source_name": "cephalopods", "target_book": "kosmos_humboldt_1845", "target_name": "Cephalopoda", "similarity": 0.906}, {"source_book": "origin_of_species_darwin_1859", "source_name": "cephalopods", "target_book": "kosmos_humboldt_1845", "target_name": "Cephalaspides", "similarity": 0.877}, {"source_book": "origin_of_species_darwin_1859", "source_name": "cephalopods", "target_book": "coloquios_da_orta_1563", "target_name": "Cephalopodes", "similarity": 0.845}, {"source_book": "origin_of_species_darwin_1859", "source_name": "cephalopods", "target_book": "first_principles_spencer_1862", "target_name": "Cephalopods", "similarity": 0.916}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cephalopodes", "target_book": "coloquios_da_orta_1563", "target_name": "Cephalopodes", "similarity": 0.953}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cephalopodes", "target_book": "first_principles_spencer_1862", "target_name": "Cephalopods", "similarity": 0.961}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cephalopoda", "target_book": "coloquios_da_orta_1563", "target_name": "Cephalopodes", "similarity": 0.944}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cephalopoda", "target_book": "first_principles_spencer_1862", "target_name": "Cephalopods", "similarity": 0.962}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cephalaspides", "target_book": "coloquios_da_orta_1563", "target_name": "Cephalopodes", "similarity": 0.888}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cephalaspides", "target_book": "first_principles_spencer_1862", "target_name": "Cephalopods", "similarity": 0.948}, {"source_book": "coloquios_da_orta_1563", "source_name": "Cephalopodes", "target_book": "first_principles_spencer_1862", "target_name": "Cephalopods", "similarity": 0.901}], "id": 178, "stable_key": "clu_43bac36bad346c8a", "ground_truth": {"wikipedia_extract": "A cephalopod  is any member of the molluscan class Cephalopoda  (Greek plural κεφαλόποδες, kephalópodes; \"head-feet\") such as a squid, octopus, cuttlefish, or nautilus. These exclusively marine animals are characterized by bilateral body symmetry, a prominent head, and a set of arms or tentacles (muscular hydrostats) modified from the primitive molluscan foot. Fisherman sometimes call cephalopods \"inkfish\", referring to their common ability to squirt ink. The study of cephalopods is a branch of malacology known as teuthology. Cephalopods became dominant during the Ordovician period, represented by primitive nautiloids. The class now contains two, only distantly related, extant subclasses: Coleoidea, which includes octopuses, squid, and cuttlefish; and Nautiloidea, represented by Nautilus and Allonautilus."}}, {"canonical_name": "Nectar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "nectar", "book_id": "origin_of_species_darwin_1859", "name": "Nectar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["nectar", "Nectar"], "contexts": ["sweet juice sought by insects", "sugary liquid produced by flowers"]}, {"entity_id": "néctar", "book_id": "coloquios_da_orta_1563", "name": "néctar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["néctar"], "contexts": ["mythical drink of gods", "food of the gods"]}, {"entity_id": "nect'dalla", "book_id": "ricettario_fiorentino_1597", "name": "nect'dalla", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nect'dalla"], "contexts": ["substance name"]}, {"entity_id": "nectar_purpureo", "book_id": "polyanthea_medicinal", "name": "nectar purpureo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nectar purpureo"], "contexts": ["purple nectar"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Nectar", "target_book": "coloquios_da_orta_1563", "target_name": "néctar", "similarity": 0.862}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Nectar", "target_book": "ricettario_fiorentino_1597", "target_name": "nect'dalla", "similarity": 0.844}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Nectar", "target_book": "polyanthea_medicinal", "target_name": "nectar purpureo", "similarity": 0.858}], "id": 179, "stable_key": "clu_1ce7864805492927", "ground_truth": {"modern_name": "Nectar", "confidence": "high", "type": "substance", "description": "Sweet liquid produced by flowers, food of the gods in mythology.", "wikipedia_extract": "Nectar is a viscous, sugar-rich liquid produced by plants in glands called nectaries, either within the flowers with which it attracts pollinating animals, or by extrafloral nectaries, which provide a nutrient source to animal mutualists, which in turn provide herbivore protection. Common nectar-consuming pollinators include mosquitoes, hoverflies, wasps, bees, butterflies and moths, hummingbirds, honeyeaters and bats. Nectar is an economically important substance as it is the sugar source for honey. Nectar is also useful in agriculture and horticulture because the adult stages of some predatory insects feed on nectar. For example, a number of predacious or parasitoid wasps (e.g., the social wasp species Apoica flavissima) rely on nectar as a primary food source. In turn, these wasps then hunt agricultural pest insects as food for their young."}}, {"canonical_name": "Danemark", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "danemark", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Danemark", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Danemark", "Danemarck"], "contexts": ["country with sugar consumption", "maritime power"]}, {"entity_id": "danish", "book_id": "kosmos_humboldt_1845", "name": "Danish", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Danish"], "contexts": ["language and origin of 'gaard'"]}, {"entity_id": "dinamarca", "book_id": "polyanthea_medicinal", "name": "Dinamarca", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Dinamarca"], "contexts": ["country mentioned with hair entanglement"]}, {"entity_id": "denmark", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Denmark", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Denmark"], "contexts": ["country with opposite coasts", "European country mentioned in relation to tides"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Danemark", "target_book": "kosmos_humboldt_1845", "target_name": "Danish", "similarity": 0.946}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Danemark", "target_book": "polyanthea_medicinal", "target_name": "Dinamarca", "similarity": 0.933}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Danemark", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Denmark", "similarity": 0.947}, {"source_book": "kosmos_humboldt_1845", "source_name": "Danish", "target_book": "polyanthea_medicinal", "target_name": "Dinamarca", "similarity": 0.893}, {"source_book": "kosmos_humboldt_1845", "source_name": "Danish", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Denmark", "similarity": 0.977}, {"source_book": "polyanthea_medicinal", "source_name": "Dinamarca", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Denmark", "similarity": 0.903}], "id": 180, "stable_key": "clu_580026bfe334a8f4", "ground_truth": {"modern_name": "Denmark", "confidence": "high", "type": "place", "description": "A Scandinavian country, known for maritime activity and sugar consumption.", "wikipedia_extract": "Denmark is a Nordic country in Northern Europe. It is the metropole and most populous constituent of the Kingdom of Denmark, also known as the Danish Realm, a constitutionally unitary state that includes the autonomous territories of the Faroe Islands and Greenland in the north Atlantic Ocean. Metropolitan Denmark, also called \"continental Denmark\" or \"Denmark proper\", consists of the northern Jutland peninsula and an archipelago of 406 islands. It is the southernmost of the Scandinavian countries, lying southwest of Sweden, south of Norway, and north of Germany, with which it shares a short border. Denmark proper is situated between the North Sea to the west and the Baltic Sea to the east. The Kingdom of Denmark, including the Faroe Islands and Greenland, has roughly 1,400 islands greater than 100 square metres (1,100 sq ft) in area; 443 have been named and 78 are inhabited."}}, {"canonical_name": "Prusse", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "prusse", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Prusse", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Prusse"], "contexts": ["country with ports", "country mentioned with population data"]}, {"entity_id": "prussia", "book_id": "kosmos_humboldt_1845", "name": "Prussia", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Prussia"], "contexts": ["region of observation", "nation where Minden is located"]}, {"entity_id": "prufsia", "book_id": "ricettario_fiorentino_1597", "name": "Prufsia", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Prufsia"], "contexts": ["coast where amber is found"]}, {"entity_id": "prussia", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Prussia", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Prussia"], "contexts": ["location mentioned for a phenomenon"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Prusse", "target_book": "kosmos_humboldt_1845", "target_name": "Prussia", "similarity": 0.968}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Prusse", "target_book": "ricettario_fiorentino_1597", "target_name": "Prufsia", "similarity": 0.86}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Prusse", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Prussia", "similarity": 0.968}, {"source_book": "kosmos_humboldt_1845", "source_name": "Prussia", "target_book": "ricettario_fiorentino_1597", "target_name": "Prufsia", "similarity": 0.851}, {"source_book": "kosmos_humboldt_1845", "source_name": "Prussia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Prussia", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Prufsia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Prussia", "similarity": 0.851}], "id": 181, "stable_key": "clu_b9e413f82b87c5eb", "ground_truth": {"modern_name": "Prussia", "confidence": "high", "type": "place", "description": "Historical region and former German state, known for its coast.", "wikipedia_extract": "Prussia (; German: Preußen [ˈpʁɔʏsn̩] ; Old Prussian: Prūsija) was a German state centred on the North European Plain that originated from the 1525 secularization act of the Prussian part of the State of the Teutonic Order. For centuries, the House of Hohenzollern ruled Prussia, expanding its size with the Prussian Army. Prussia, with its capital at Königsberg and then, when it became the Kingdom of Prussia in 1701, Berlin, decisively shaped the history of Germany. Prussia formed the German Empire when it united the German states in 1871. It was de facto dissolved by an emergency decree transferring powers of the Prussian government to German Chancellor Franz von Papen in 1932 and de jure by an Allied decree in 1947. The name Prussia derives from the Old Prussians who were conquered by the Teutonic Knights – an organized Catholic medieval military order of German crusaders –  in the 13th century."}}, {"canonical_name": "Toulouse", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "toulouse", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Toulouse", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Toulouse"], "contexts": ["city where observations were made", "city with barometric observations"]}, {"entity_id": "tolosa", "book_id": "kosmos_humboldt_1845", "name": "Tolosa", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Tolosa"], "contexts": ["location between cities"]}, {"entity_id": "tolosa", "book_id": "coloquios_da_orta_1563", "name": "Tolosa", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Tolosa"], "contexts": ["city of printing", "publication location of De proprietatibus rerum"]}, {"entity_id": "toulouse", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Toulouse", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Toulouse"], "contexts": ["location of observatory"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Toulouse", "target_book": "kosmos_humboldt_1845", "target_name": "Tolosa", "similarity": 0.899}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Toulouse", "target_book": "coloquios_da_orta_1563", "target_name": "Tolosa", "similarity": 0.899}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Toulouse", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Toulouse", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Tolosa", "target_book": "coloquios_da_orta_1563", "target_name": "Tolosa", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Tolosa", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Toulouse", "similarity": 0.899}, {"source_book": "coloquios_da_orta_1563", "source_name": "Tolosa", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Toulouse", "similarity": 0.899}], "id": 182, "stable_key": "clu_37cc03b2fd258453", "ground_truth": {"modern_name": "Toulouse", "confidence": "high", "type": "place", "description": "A city in southern France, historically significant for its printing and scientific observations.", "wikipedia_extract": "Toulouse (, too-LOOZ, French: [tuluz] ; Occitan: Tolosa [tuˈluzɔ] ) is a city in Southern France, the prefecture of the Haute-Garonne department and of the Occitania region. The city is on the banks of the River Garonne, 150 kilometres (93 miles) from the Mediterranean Sea, 230 km (143 mi) from the Atlantic Ocean and 680 km (420 mi) from Paris. It is the fourth-largest city in France after Paris, Marseille, and Lyon, with 511,684 inhabitants within its municipal boundaries (2022); its metropolitan area has a population of 1,513,396 inhabitants (2022). Toulouse is the central city of one of the 22 metropolitan councils of France. Between the 2014 and 2020 censuses, its metropolitan area was the third fastest growing among metropolitan areas larger than 500,000 inhabitants in France. Toulouse is the centre of the European aerospace industry, with the headquarters of Airbus, the SPOT satellite system, ATR and the Aerospace Valley."}}, {"canonical_name": "electrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "electrometer", "book_id": "kosmos_humboldt_1845", "name": "electrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["electrometer"], "contexts": ["device for measuring electric charge", "instrument for measuring electric charge"]}, {"entity_id": "électromètre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "électromètre", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["électromètre", "électromètre de Volta"], "contexts": ["instrument for measuring electricity", "instrument used to measure atmospheric electricity"]}, {"entity_id": "electrodes", "book_id": "principles_of_psychology_james_1890", "name": "electrodes", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["electrodes"], "contexts": ["conductors for electrical current", "devices for applying electrical stimulation"]}, {"entity_id": "electrometers", "book_id": "kosmos_humboldt_1845", "name": "electrometers", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["electrometers"], "contexts": ["instrument for measuring electricity"]}, {"entity_id": "electrometer", "book_id": "first_principles_spencer_1862", "name": "electrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["electrometer"], "contexts": ["instrument for measuring electric potential"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "electrometer", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "électromètre", "similarity": 0.978}, {"source_book": "kosmos_humboldt_1845", "source_name": "electrometer", "target_book": "principles_of_psychology_james_1890", "target_name": "electrodes", "similarity": 0.841}, {"source_book": "kosmos_humboldt_1845", "source_name": "electrometer", "target_book": "first_principles_spencer_1862", "target_name": "electrometer", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "électromètre", "target_book": "kosmos_humboldt_1845", "target_name": "electrometers", "similarity": 0.962}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "électromètre", "target_book": "first_principles_spencer_1862", "target_name": "electrometer", "similarity": 0.978}, {"source_book": "principles_of_psychology_james_1890", "source_name": "electrodes", "target_book": "kosmos_humboldt_1845", "target_name": "electrometers", "similarity": 0.852}, {"source_book": "principles_of_psychology_james_1890", "source_name": "electrodes", "target_book": "first_principles_spencer_1862", "target_name": "electrometer", "similarity": 0.841}, {"source_book": "kosmos_humboldt_1845", "source_name": "electrometers", "target_book": "first_principles_spencer_1862", "target_name": "electrometer", "similarity": 0.982}], "id": 183, "stable_key": "clu_ed8ca594b446273d", "ground_truth": {"modern_name": "Electrometer", "confidence": "high", "type": "object", "note": "The presence of 'électromètre' and the description 'device for measuring electric charge' confirm this identification. 'Electrodes' are related but distinct; however, the dominant term is electrometer.", "wikidata_id": "Q1982706", "wikidata_description": "instrument for measuring electric charge", "wikipedia_url": "https://en.wikipedia.org/wiki/Electrometer", "wikipedia_extract": "An electrometer is an electrical instrument for measuring electric charge or electrical potential difference. There are many different types, ranging from historical handmade mechanical instruments to high-precision electronic devices. Modern electrometers based on vacuum tube or solid-state technology can be used to make voltage and charge measurements with very low leakage currents, down to 1 femtoampere. A simpler but related instrument, the electroscope, works on similar principles but only indicates the relative magnitudes of voltages or charges. The gold-leaf electroscope was one of the instruments used to indicate electric charge. It is still used for science demonstrations but has been superseded in most applications by electronic measuring instruments."}}, {"canonical_name": "breathing", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "breathing", "book_id": "principles_of_psychology_james_1890", "name": "breathing", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 4, "variants": ["breathing"], "contexts": ["process of inhaling and exhaling", "process of respiration"]}, {"entity_id": "breath", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "breath", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["breath"], "contexts": ["air exhaled from lungs"]}, {"entity_id": "breathing_organ", "book_id": "origin_of_species_darwin_1859", "name": "breathing organ", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["breathing organ"], "contexts": ["nascent breathing organ"]}, {"entity_id": "respiration", "book_id": "first_principles_spencer_1862", "name": "respiration", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 2, "variants": ["respiration"], "contexts": ["process of breathing"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "breathing", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "breath", "similarity": 0.973}, {"source_book": "principles_of_psychology_james_1890", "source_name": "breathing", "target_book": "origin_of_species_darwin_1859", "target_name": "breathing organ", "similarity": 0.937}, {"source_book": "principles_of_psychology_james_1890", "source_name": "breathing", "target_book": "first_principles_spencer_1862", "target_name": "respiration", "similarity": 0.96}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "breath", "target_book": "origin_of_species_darwin_1859", "target_name": "breathing organ", "similarity": 0.914}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "breath", "target_book": "first_principles_spencer_1862", "target_name": "respiration", "similarity": 0.931}, {"source_book": "origin_of_species_darwin_1859", "source_name": "breathing organ", "target_book": "first_principles_spencer_1862", "target_name": "respiration", "similarity": 0.898}], "id": 184, "stable_key": "clu_e2dd63b403386059", "ground_truth": {"modern_name": "respiration", "confidence": "high", "type": "anatomy", "description": "The process of breathing and gas exchange.", "note": "While 'breathing' is a direct synonym, 'respiration' encompasses the physiological process more broadly as implied by 'nascent breathing organ'.", "wikipedia_extract": "Breathing (respiration or ventilation) is the rhythmic process of moving air into (inhalation) and out of (exhalation) the lungs to enable gas exchange with the internal environment, primarily to remove carbon dioxide and take in oxygen. All aerobic organisms require oxygen for cellular respiration, which extracts energy from food and produces carbon dioxide as a waste product. External respiration (breathing) brings air to the alveoli where gases move by diffusion; the circulatory system then transports oxygen and carbon dioxide between the lungs and the tissues. In vertebrates with lungs, breathing consists of repeated cycles of inhalation and exhalation through a branched system of airways that conduct air from the nose or mouth to the alveoli. The number of respiratory cycles per minute — the respiratory or breathing rate — is a primary vital sign. Under normal conditions, depth and rate of breathing are controlled unconsciously by homeostatic mechanisms that maintain arterial partial pressures of carbon dioxide and oxygen."}}, {"canonical_name": "Marine plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "marine_plants", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Marine plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Marine Plants", "Marine plants"], "contexts": ["plants growing in the sea", "plants distributed in the sea"]}, {"entity_id": "marine_productions", "book_id": "origin_of_species_darwin_1859", "name": "marine productions", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["marine productions"], "contexts": ["organisms living in the sea"]}, {"entity_id": "balis_maritima", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Balis maritima", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Balis maritima"], "contexts": ["plant collected by explorers"]}, {"entity_id": "cellular_marine_plants", "book_id": "kosmos_humboldt_1845", "name": "cellular marine plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cellular marine plants"], "contexts": ["simple aquatic plants"]}, {"entity_id": "marine_plants", "book_id": "kosmos_humboldt_1845", "name": "marine plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["marine plants"], "contexts": ["plants found in chalk strata"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Marine plants", "target_book": "origin_of_species_darwin_1859", "target_name": "marine productions", "similarity": 0.874}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Marine plants", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Balis maritima", "similarity": 0.86}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Marine plants", "target_book": "kosmos_humboldt_1845", "target_name": "cellular marine plants", "similarity": 0.91}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Marine plants", "target_book": "kosmos_humboldt_1845", "target_name": "marine plants", "similarity": 0.987}, {"source_book": "origin_of_species_darwin_1859", "source_name": "marine productions", "target_book": "kosmos_humboldt_1845", "target_name": "marine plants", "similarity": 0.874}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Balis maritima", "target_book": "kosmos_humboldt_1845", "target_name": "marine plants", "similarity": 0.865}], "id": 185, "stable_key": "clu_5b85ac0dda65b3cf", "ground_truth": {"modern_name": "Marine flora", "confidence": "medium", "type": "plant", "note": "While 'Marine plants' is the most direct, 'marine productions' and 'cellular marine plants' suggest a broader inclusion. 'Balis maritima' could be a specific species, but the cluster is broad.", "wikidata_id": "Q111240775", "wikidata_description": "plants that live in marine habitats", "wikipedia_url": "https://en.wikipedia.org/wiki/Marine%20plant", "wikipedia_extract": "Marine primary production is the chemical synthesis in the ocean of organic compounds from atmospheric or dissolved carbon dioxide. It principally occurs through the process of photosynthesis, which uses light as its source of energy, but it also occurs through chemosynthesis, which uses the oxidation or reduction of inorganic chemical compounds as its source of energy. Almost all life on Earth relies directly or indirectly on primary production. The organisms responsible for primary production are called primary producers or autotrophs. Most marine primary production is generated by a diverse collection of marine microorganisms called algae and cyanobacteria. Together these form the principal primary producers at the base of the ocean food chain and produce half of the world's oxygen."}}, {"canonical_name": "mule", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "mule", "book_id": "origin_of_species_darwin_1859", "name": "mule", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["mule"], "contexts": ["hybrid of ass and horse", "example of a healthy and long-lived hybrid"]}, {"entity_id": "mule", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mule", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Mule"], "contexts": ["Animal whose skin is used in a recipe", "animal with a long lifespan"]}, {"entity_id": "mulas", "book_id": "coloquios_da_orta_1563", "name": "mulas", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["mulas"], "contexts": ["animals that eat the plant"]}, {"entity_id": "mula", "book_id": "polyanthea_medicinal", "name": "mula", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["mula"], "contexts": ["animal involved in illness transfer"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "mule", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Mule", "similarity": 0.94}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mule", "target_book": "coloquios_da_orta_1563", "target_name": "mulas", "similarity": 0.863}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mule", "target_book": "polyanthea_medicinal", "target_name": "mula", "similarity": 0.876}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mule", "target_book": "coloquios_da_orta_1563", "target_name": "mulas", "similarity": 0.835}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mule", "target_book": "polyanthea_medicinal", "target_name": "mula", "similarity": 0.865}, {"source_book": "coloquios_da_orta_1563", "source_name": "mulas", "target_book": "polyanthea_medicinal", "target_name": "mula", "similarity": 0.95}], "id": 186, "stable_key": "clu_a1293101b7e3cafa", "ground_truth": {"modern_name": "mule", "confidence": "high", "type": "animal", "description": "Hybrid offspring of a male donkey and a female horse.", "wikipedia_extract": "The mule is a domestic equine hybrid between a donkey and a horse. It is the offspring of a male donkey (a jack) and a female horse (a mare). The horse and the donkey are different species, with different numbers of chromosomes; of the two possible first-generation hybrids between them, the mule is easier to obtain and more common than the hinny, which is the offspring of a male horse (a stallion) and a female donkey (a jenny). Mules vary widely in size, and may be of any color seen in horses or donkeys. They are more patient, hardier and longer-lived than horses, and are perceived as less obstinate and more intelligent than donkeys. A female mule is called a molly, a Molly mule, or more formally mare mule."}}, {"canonical_name": "kidneys", "category": "ANATOMY", "subcategory": "ORGAN", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "kidneys", "book_id": "principles_of_psychology_james_1890", "name": "kidneys", "category": "ANATOMY", "subcategory": "ORGAN", "count": 2, "variants": ["kidneys"], "contexts": ["organ that secretes urine", "assigned seat of the soul"]}, {"entity_id": "kidney", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Kidney", "category": "ANATOMY", "subcategory": "ORGAN", "count": 1, "variants": ["Kidney"], "contexts": ["organ where stones can form"]}, {"entity_id": "kidneys", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Kidneys", "category": "ANATOMY", "subcategory": "ORGAN", "count": 1, "variants": ["Kidneys"], "contexts": ["organ where stones can form"]}, {"entity_id": "kidneys", "book_id": "origin_of_species_darwin_1859", "name": "kidneys", "category": "ANATOMY", "subcategory": "ORGAN", "count": 1, "variants": ["kidneys"], "contexts": ["organs whose shape varies with pelvis"]}, {"entity_id": "kidney", "book_id": "principles_of_psychology_james_1890", "name": "kidney", "category": "ANATOMY", "subcategory": "ORGAN", "count": 1, "variants": ["kidney"], "contexts": ["organ involved in activity"]}, {"entity_id": "kidneys", "book_id": "first_principles_spencer_1862", "name": "kidneys", "category": "ANATOMY", "subcategory": "ORGAN", "count": 1, "variants": ["kidneys"], "contexts": ["organs that filter blood"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "kidneys", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Kidney", "similarity": 0.917}, {"source_book": "principles_of_psychology_james_1890", "source_name": "kidneys", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Kidneys", "similarity": 0.933}, {"source_book": "principles_of_psychology_james_1890", "source_name": "kidneys", "target_book": "origin_of_species_darwin_1859", "target_name": "kidneys", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "kidneys", "target_book": "first_principles_spencer_1862", "target_name": "kidneys", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Kidney", "target_book": "origin_of_species_darwin_1859", "target_name": "kidneys", "similarity": 0.917}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Kidney", "target_book": "principles_of_psychology_james_1890", "target_name": "kidney", "similarity": 0.929}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Kidney", "target_book": "first_principles_spencer_1862", "target_name": "kidneys", "similarity": 0.917}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Kidneys", "target_book": "origin_of_species_darwin_1859", "target_name": "kidneys", "similarity": 0.933}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Kidneys", "target_book": "principles_of_psychology_james_1890", "target_name": "kidney", "similarity": 0.907}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Kidneys", "target_book": "first_principles_spencer_1862", "target_name": "kidneys", "similarity": 0.933}, {"source_book": "origin_of_species_darwin_1859", "source_name": "kidneys", "target_book": "principles_of_psychology_james_1890", "target_name": "kidney", "similarity": 0.98}, {"source_book": "origin_of_species_darwin_1859", "source_name": "kidneys", "target_book": "first_principles_spencer_1862", "target_name": "kidneys", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "kidney", "target_book": "first_principles_spencer_1862", "target_name": "kidneys", "similarity": 0.98}], "id": 187, "stable_key": "clu_7c5264feae0a6dd4", "ground_truth": {"wikipedia_extract": "In humans, the kidneys are two reddish-brown bean-shaped blood-filtering organs that are a multilobar, multipapillary form of mammalian kidneys, usually without signs of external lobulation. They are located on the left and right in the retroperitoneal space, and in adult humans are about 12 centimetres (4+1⁄2 inches) in length. They receive blood from the paired renal arteries; blood exits into the paired renal veins. Each kidney is attached to a ureter, a tube that carries excreted urine to the bladder. The kidney participates in the control of the volume of various body fluids, fluid osmolality, acid–base balance, various electrolyte concentrations, and removal of toxins. Filtration occurs in the glomerulus: one-fifth of the blood volume that enters the kidneys is filtered."}}, {"canonical_name": "Liege", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "liege", "book_id": "kosmos_humboldt_1845", "name": "Liege", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Liege"], "contexts": ["city in Belgium", "location of a coal basin"]}, {"entity_id": "liege", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Liege", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Liege"], "contexts": ["city where Mandevil died"]}, {"entity_id": "liège", "book_id": "principles_of_psychology_james_1890", "name": "Liège", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Liège"], "contexts": ["city in Belgium"]}, {"entity_id": "lieja", "book_id": "historia_medicinal_monardes_1574", "name": "Lieja", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Lieja"], "contexts": ["city with a medicinal spring"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Liege", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Liege", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Liege", "target_book": "principles_of_psychology_james_1890", "target_name": "Liège", "similarity": 0.931}, {"source_book": "kosmos_humboldt_1845", "source_name": "Liege", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lieja", "similarity": 0.902}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Liege", "target_book": "principles_of_psychology_james_1890", "target_name": "Liège", "similarity": 0.931}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Liege", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lieja", "similarity": 0.902}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Liège", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lieja", "similarity": 0.849}], "id": 188, "stable_key": "clu_45114c789bd9f4e5", "ground_truth": {"wikipedia_extract": "Liège ( lee-EZH, lee-AYZH; French: [ljɛʒ] ; Walloon: Lîdje [liːtʃ]; Dutch: Luik [lœyk] ; German: Lüttich [ˈlʏtɪç] ) is a city and municipality in the Belgian region of Wallonia, and the capital of the eponymous province. The city is situated in the valley of the Meuse, in the east of Belgium, not far from borders with the Netherlands (Maastricht is about 33 km (20.5 mi) to the north) and with Germany (Aachen is about 53 km (32.9 mi) north-east). In Liège, the Meuse meets the river Ourthe. The city is part of the sillon industriel, the former industrial backbone of Wallonia. It is still the principal economic and cultural centre of the region. The municipality consists of the following sections (sub-municipalities): Liège proper, Angleur, Bressoux, Chênée, Glain, Grivegnée, Jupille-sur-Meuse, Rocourt, and Wandre."}}, {"canonical_name": "method", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "method", "book_id": "polyanthea_medicinal", "name": "method", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 4, "variants": ["method", "Method", "Methodica"], "contexts": ["medical treatise", "a medical treatise by Galen"]}, {"entity_id": "methodical_practice", "book_id": "origin_of_species_darwin_1859", "name": "methodical practice", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["methodical practice"], "contexts": ["systematic application of selection"]}, {"entity_id": "methods", "book_id": "principles_of_psychology_james_1890", "name": "methods", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["methods"], "contexts": ["systematic ways of inquiry"]}, {"entity_id": "methods", "book_id": "kosmos_humboldt_1845", "name": "methods", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["methods"], "contexts": ["procedures for scientific investigation"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "method", "target_book": "origin_of_species_darwin_1859", "target_name": "methodical practice", "similarity": 0.91}, {"source_book": "polyanthea_medicinal", "source_name": "method", "target_book": "principles_of_psychology_james_1890", "target_name": "methods", "similarity": 0.975}, {"source_book": "polyanthea_medicinal", "source_name": "method", "target_book": "kosmos_humboldt_1845", "target_name": "methods", "similarity": 0.975}, {"source_book": "origin_of_species_darwin_1859", "source_name": "methodical practice", "target_book": "principles_of_psychology_james_1890", "target_name": "methods", "similarity": 0.901}, {"source_book": "origin_of_species_darwin_1859", "source_name": "methodical practice", "target_book": "kosmos_humboldt_1845", "target_name": "methods", "similarity": 0.901}, {"source_book": "principles_of_psychology_james_1890", "source_name": "methods", "target_book": "kosmos_humboldt_1845", "target_name": "methods", "similarity": 1.0}], "id": 189, "stable_key": "clu_9f0aa83aced229ae", "ground_truth": {"modern_name": "Method", "confidence": "high", "type": "concept", "description": "Systematic approach or procedure for inquiry or practice.", "wikipedia_extract": "A proof of concept (POC or PoC), also known as proof of principle, is an inchoate realization of a certain idea or method in order to demonstrate its feasibility or viability. A proof of concept is usually small and may or may not be complete, but aims to demonstrate in principle that the concept has practical potential without needing to fully develop it. A proof of value (PoV) is sometimes used along proof of concept, and differs by focusing more on demonstrating the potential customer use case and value, and is usually less in-depth than a proof of concept. The term has been in use since 1967. In a 1969 hearing of the Committee on Science and Astronautics, Subcommittee on Advanced Research and Technology, proof of concept was defined as following: The Board defined proof of concept as a phase in development in which experimental hardware is constructed and tested to explore and demonstrate the feasibility of a new concept. One definition of the term \"proof of concept\" was by Bruce Carsten in the context of a \"proof-of-concept prototype\" in his magazine column \"Carsten's Corner\" (1989): Proof-of-Concept Prototype is a term that (I believe) I coined in 1984."}}, {"canonical_name": "viscera", "category": "ANATOMY", "subcategory": "ORGAN", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "viscera", "book_id": "principles_of_psychology_james_1890", "name": "viscera", "category": "ANATOMY", "subcategory": "ORGAN", "count": 3, "variants": ["viscera"], "contexts": ["internal organs of the body"]}, {"entity_id": "viscera", "book_id": "origin_of_species_darwin_1859", "name": "viscera", "category": "ANATOMY", "subcategory": "ORGAN", "count": 1, "variants": ["viscera"], "contexts": ["internal organs whose position is determined"]}, {"entity_id": "viscera", "book_id": "kosmos_humboldt_1845", "name": "viscera", "category": "ANATOMY", "subcategory": "ORGAN", "count": 1, "variants": ["viscera"], "contexts": ["internal organs of the earth"]}, {"entity_id": "viscera", "book_id": "first_principles_spencer_1862", "name": "viscera", "category": "ANATOMY", "subcategory": "ORGAN", "count": 2, "variants": ["viscera"], "contexts": ["internal organs with automatic movements", "internal organs of the body"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "viscera", "target_book": "origin_of_species_darwin_1859", "target_name": "viscera", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "viscera", "target_book": "kosmos_humboldt_1845", "target_name": "viscera", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "viscera", "target_book": "first_principles_spencer_1862", "target_name": "viscera", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "viscera", "target_book": "kosmos_humboldt_1845", "target_name": "viscera", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "viscera", "target_book": "first_principles_spencer_1862", "target_name": "viscera", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "viscera", "target_book": "first_principles_spencer_1862", "target_name": "viscera", "similarity": 1.0}], "id": 190, "stable_key": "clu_b6b3a704d6c5b581", "ground_truth": {"wikipedia_extract": "In a multicellular organism, an organ is a collection of tissues joined in a structural unit to serve a common function. In the hierarchy of life, an organ lies between tissue and an organ system. Tissues are formed from same type cells to act together in a function. Tissues of different types combine to form an organ which has a specific function. The intestinal wall for example is formed by epithelial tissue and smooth muscle tissue. Two or more organs working together in the execution of a specific body function form an organ system, also called a biological system or body system."}}, {"canonical_name": "Sumbawa", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "sumbawa", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Sumbawa", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Sumbawa"], "contexts": ["island of a major eruption", "location of a previous volcanic eruption"]}, {"entity_id": "sumatra", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sumatra", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Sumatra"], "contexts": ["island where Malayes are indigenous"]}, {"entity_id": "sumbava", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sumbava", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Sumbava"], "contexts": ["island in Indonesia"]}, {"entity_id": "sumba", "book_id": "coloquios_da_orta_1563", "name": "Sumba", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Sumba"], "contexts": ["island"]}, {"entity_id": "sumatra", "book_id": "first_principles_spencer_1862", "name": "Sumatra", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Sumatra"], "contexts": ["island in Southeast Asia"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Sumbawa", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Sumatra", "similarity": 0.867}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Sumbawa", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Sumbava", "similarity": 0.881}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Sumbawa", "target_book": "coloquios_da_orta_1563", "target_name": "Sumba", "similarity": 0.863}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Sumbawa", "target_book": "first_principles_spencer_1862", "target_name": "Sumatra", "similarity": 0.867}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sumatra", "target_book": "first_principles_spencer_1862", "target_name": "Sumatra", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sumbava", "target_book": "coloquios_da_orta_1563", "target_name": "Sumba", "similarity": 0.818}], "id": 191, "stable_key": "clu_c3ebdd99faf40296", "ground_truth": {"modern_name": "Sumbawa", "confidence": "high", "type": "place", "country": "Indonesia", "note": "Sumbawa and Sumbava are likely spelling variations of the same Indonesian island. Sumatra is a nearby, larger island, but Sumbawa is strongly suggested by frequency and context of eruptions.", "wikidata_id": "Q186367", "wikidata_description": "island in West Nusa Tenggara Province, Indonesia", "wikipedia_url": "https://en.wikipedia.org/wiki/Sumbawa", "wikipedia_extract": "Sumbawa, is an Indonesian island, located in the middle of the Lesser Sunda Islands chain, with Lombok to the west, Flores to the east, and Sumba further to the southeast. Along with Lombok, it forms the province of West Nusa Tenggara, but there have been plans (currently held in abeyance) by the Indonesian government to split the island off into a separate province. Traditionally, the island is known as the source of sappanwood, as well as honey and sandalwood. Its savanna-like climate and vast grasslands are used to breed horses and cattle, as well as to hunt deer. Sumbawa has an area of 15,448 square kilometres or 5,965 square miles (three times the size of Lombok) with a population (at the 2020 Census) of 1,561,461; the official estimate as at mid-2024 was 1,669,787. It marks the boundary between the islands to the west, which were influenced by religion and culture spreading from India, and the region to the east which was less influenced."}}, {"canonical_name": "mercadores", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "mercadores", "book_id": "coloquios_da_orta_1563", "name": "mercadores", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["mercadores", "hum mercador"], "contexts": ["merchants consulted about camphor water", "friend who lost money on sândalo"]}, {"entity_id": "mercadorcs", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mercadorcs", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Mercadorcs"], "contexts": ["merchants"]}, {"entity_id": "commerson", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Commerson", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Commerson"], "contexts": ["naturalist"]}, {"entity_id": "mercati", "book_id": "ricettario_fiorentino_1597", "name": "Mercati", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Mercati"], "contexts": ["merchants"]}, {"entity_id": "mercador", "book_id": "polyanthea_medicinal", "name": "mercador", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["mercador"], "contexts": ["merchant who suffered from itching"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "mercadores", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Mercadorcs", "similarity": 0.944}, {"source_book": "coloquios_da_orta_1563", "source_name": "mercadores", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Commerson", "similarity": 0.854}, {"source_book": "coloquios_da_orta_1563", "source_name": "mercadores", "target_book": "ricettario_fiorentino_1597", "target_name": "Mercati", "similarity": 0.869}, {"source_book": "coloquios_da_orta_1563", "source_name": "mercadores", "target_book": "polyanthea_medicinal", "target_name": "mercador", "similarity": 0.985}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mercadorcs", "target_book": "ricettario_fiorentino_1597", "target_name": "Mercati", "similarity": 0.908}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mercadorcs", "target_book": "polyanthea_medicinal", "target_name": "mercador", "similarity": 0.94}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Commerson", "target_book": "polyanthea_medicinal", "target_name": "mercador", "similarity": 0.86}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Mercati", "target_book": "polyanthea_medicinal", "target_name": "mercador", "similarity": 0.886}], "id": 192, "stable_key": "clu_5d4b74f59e820d52", "ground_truth": {"modern_name": "Merchants", "confidence": "high", "type": "person", "description": "Individuals involved in trade and commerce, often consulted on goods.", "wikipedia_extract": "A merchant is a person or company engaged in trade, conducting sales through stores or online platforms, particularly one that engages in international import and export activities. Merchants have been known for as long as humans have engaged in trade and commerce. Merchants and merchant networks operated in ancient Babylonia, Assyria, China, Egypt, Greece, India, Persia, Phoenicia and Rome. During the European medieval period, a rapid expansion in trade and commerce led to the rise of a wealthy and powerful merchant class. The European Age of Discovery opened up new trading routes and gave European consumers access to a much broader range of goods. By the 18th century, a new type of manufacturer-merchant had started to emerge and modernize for the purpose of generating profit, cash flow, sales, and revenue using a combination of human, financial, intellectual and physical capital with a view to fueling economic development and growth."}}, {"canonical_name": "Aqua vitæ", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "aqua_vitæ", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Aqua vitæ", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Aqua vitæ"], "contexts": ["liquid in which ice floats", "liquid coagulated by volatile salt"]}, {"entity_id": "aqua_vitae", "book_id": "english_physician_1652", "name": "Aqua vitae", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Aqua vitae"], "contexts": ["used in a drink"]}, {"entity_id": "acqua_vite", "book_id": "ricettario_fiorentino_1597", "name": "acqua vite", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["acqua vite"], "contexts": ["aqua vitae (alcohol)", "distilled spirit used in preparation"]}, {"entity_id": "aqua_vite", "book_id": "polyanthea_medicinal", "name": "aqua vite", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["aqua vite"], "contexts": ["distilled spirit, possibly alcohol"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Aqua vitæ", "target_book": "english_physician_1652", "target_name": "Aqua vitae", "similarity": 0.9}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Aqua vitæ", "target_book": "ricettario_fiorentino_1597", "target_name": "acqua vite", "similarity": 0.861}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Aqua vitæ", "target_book": "polyanthea_medicinal", "target_name": "aqua vite", "similarity": 0.896}, {"source_book": "english_physician_1652", "source_name": "Aqua vitae", "target_book": "ricettario_fiorentino_1597", "target_name": "acqua vite", "similarity": 0.825}, {"source_book": "english_physician_1652", "source_name": "Aqua vitae", "target_book": "polyanthea_medicinal", "target_name": "aqua vite", "similarity": 0.886}, {"source_book": "ricettario_fiorentino_1597", "source_name": "acqua vite", "target_book": "polyanthea_medicinal", "target_name": "aqua vite", "similarity": 0.953}], "id": 193, "stable_key": "clu_12e81134287822ce", "ground_truth": {"modern_name": "Ethanol", "confidence": "high", "type": "chemical", "note": "Aqua vitae (Latin for 'water of life') is an archaic term for distilled spirits, most commonly referring to ethanol.", "wikidata_id": "Q153", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Ethanol", "wikipedia_extract": "Ethanol (also called ethyl alcohol, grain alcohol, drinking alcohol, or simply alcohol) is an organic compound with the chemical formula CH3CH2OH. It is an alcohol, with its formula also written as C2H5OH, C2H6O or EtOH, where Et is the pseudoelement symbol for ethyl. Ethanol is a volatile, flammable, colorless liquid with a pungent taste. As a psychoactive depressant, it is the active ingredient in alcoholic beverages, and the second most consumed drug globally behind caffeine. Ethanol is naturally produced by the fermentation process of sugars by yeasts or via petrochemical processes such as ethylene hydration. Historically it was used as a general anesthetic, and has modern medical applications as an antiseptic, disinfectant, solvent for some medications, and antidote for methanol poisoning and ethylene glycol poisoning."}}, {"canonical_name": "bórax", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "bórax", "book_id": "coloquios_da_orta_1563", "name": "bórax", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["bórax"], "contexts": ["substance used for gold and metals", "substance"]}, {"entity_id": "borax", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Borax", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Borax"], "contexts": ["mineral used in gunpowder formulations"]}, {"entity_id": "borax", "book_id": "english_physician_1652", "name": "Borax", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Borax"], "contexts": ["powder mixed with juice for cleansing"]}, {"entity_id": "borrace", "book_id": "ricettario_fiorentino_1597", "name": "borrace", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Borrace", "borrace"], "contexts": ["natural substance, a type of fossilized saltpeter", "substance used as a substitute for lapis Armeno"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "bórax", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Borax", "similarity": 0.874}, {"source_book": "coloquios_da_orta_1563", "source_name": "bórax", "target_book": "english_physician_1652", "target_name": "Borax", "similarity": 0.874}, {"source_book": "coloquios_da_orta_1563", "source_name": "bórax", "target_book": "ricettario_fiorentino_1597", "target_name": "borrace", "similarity": 0.849}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Borax", "target_book": "english_physician_1652", "target_name": "Borax", "similarity": 1.0}], "id": 194, "stable_key": "clu_97d8ba8748867f9d", "ground_truth": {"modern_name": "borax", "confidence": "high", "type": "mineral", "description": "Soft white crystalline mineral, a salt of boric acid.", "wikipedia_extract": "Borax (also referred to as sodium borate, tincal  and tincar ) is a salt (ionic compound) normally encountered as a hydrated borate of sodium, with the chemical formula Na2H20B4O17. Borax mineral is a crystalline borate mineral that occurs in only a few places worldwide in quantities that enable it to be mined economically. Borax can be dehydrated by heating into other forms with less water of hydration. The anhydrous form of borax can also be obtained from the decahydrate or other hydrates by heating and then grinding the resulting glasslike solid into a powder. It is a white crystalline solid that dissolves in water to make a basic solution due to the tetraborate anion. Borax is commonly available in powder or granular form and has many industrial and household uses, including as a pesticide, as a metal soldering flux, as a component of glass, enamel, and pottery glazes, for tanning of skins and hides, for artificial aging of wood, as a preservative against wood fungus, as a food additive, and as a pharmaceutic alkalizer."}}, {"canonical_name": "Stomach", "category": "ANATOMY", "subcategory": "ORGAN", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "stomach", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Stomach", "category": "ANATOMY", "subcategory": "ORGAN", "count": 2, "variants": ["Stomach", "stomach"], "contexts": ["organ where sponge swells", "digestive organ"]}, {"entity_id": "stomach", "book_id": "origin_of_species_darwin_1859", "name": "stomach", "category": "ANATOMY", "subcategory": "ORGAN", "count": 2, "variants": ["stomach"], "contexts": ["organ for digesting food", "organ for digestion"]}, {"entity_id": "stomach", "book_id": "principles_of_psychology_james_1890", "name": "stomach", "category": "ANATOMY", "subcategory": "ORGAN", "count": 1, "variants": ["stomach"], "contexts": ["digestive organ"]}, {"entity_id": "stomach", "book_id": "first_principles_spencer_1862", "name": "stomach", "category": "ANATOMY", "subcategory": "ORGAN", "count": 1, "variants": ["stomach"], "contexts": ["organ for digesting food"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Stomach", "target_book": "origin_of_species_darwin_1859", "target_name": "stomach", "similarity": 0.9}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Stomach", "target_book": "principles_of_psychology_james_1890", "target_name": "stomach", "similarity": 0.9}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Stomach", "target_book": "first_principles_spencer_1862", "target_name": "stomach", "similarity": 0.9}, {"source_book": "origin_of_species_darwin_1859", "source_name": "stomach", "target_book": "principles_of_psychology_james_1890", "target_name": "stomach", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "stomach", "target_book": "first_principles_spencer_1862", "target_name": "stomach", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "stomach", "target_book": "first_principles_spencer_1862", "target_name": "stomach", "similarity": 1.0}], "id": 195, "stable_key": "clu_16fb2e6faad91c0b", "ground_truth": {"wikipedia_extract": "The stomach is a muscular, hollow organ in the upper gastrointestinal tract of humans and many other animals, including several invertebrates. The Ancient Greek name for the stomach is gaster which is used as gastric in medical terms related to the stomach. The stomach has a dilated structure and functions as a vital organ in the digestive system. The stomach is involved in the gastric phase of digestion, following the cephalic phase in which the sight and smell of food and the act of chewing are stimuli. In the stomach a chemical breakdown of food takes place by means of secreted  digestive enzymes and gastric acid. It also plays a role in regulating gut microbiota, influencing digestion and overall health."}}, {"canonical_name": "Wolga", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "wolga", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Wolga", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Wolga"], "contexts": ["river in Russia", "river mouth for barometric measurements"]}, {"entity_id": "volga", "book_id": "kosmos_humboldt_1845", "name": "Volga", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Volga"], "contexts": ["river mouth in Eastern Russia"]}, {"entity_id": "volga", "book_id": "coloquios_da_orta_1563", "name": "Volga", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Volga"], "contexts": ["ancient name for river", "river name"]}, {"entity_id": "volga", "book_id": "ricettario_fiorentino_1597", "name": "Volga", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Volga"], "contexts": ["river, also called Rha"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Wolga", "target_book": "kosmos_humboldt_1845", "target_name": "Volga", "similarity": 0.861}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Wolga", "target_book": "coloquios_da_orta_1563", "target_name": "Volga", "similarity": 0.861}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Wolga", "target_book": "ricettario_fiorentino_1597", "target_name": "Volga", "similarity": 0.861}, {"source_book": "kosmos_humboldt_1845", "source_name": "Volga", "target_book": "coloquios_da_orta_1563", "target_name": "Volga", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Volga", "target_book": "ricettario_fiorentino_1597", "target_name": "Volga", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Volga", "target_book": "ricettario_fiorentino_1597", "target_name": "Volga", "similarity": 1.0}], "id": 196, "stable_key": "clu_0ea6c3a07411aabd", "ground_truth": {"modern_name": "Volga River", "confidence": "high", "type": "place", "description": "A major river in Russia, historically known as Rha.", "wikipedia_extract": "The Volga (Russian: Волга, pronounced [ˈvolɡə] ) is the longest river in Europe and the longest endorheic basin river in the world. Situated in Russia, it flows through Central Russia to Southern Russia and into the Caspian Sea. The Volga has a length of 3,531 km (2,194 mi), and a catchment area of 1,360,000 km2 (530,000 sq mi). It is also Europe's largest river in terms of average discharge at delta – between 8,000 m3/s (280,000 cu ft/s) and 8,500 m3/s (300,000 cu ft/s) – and of drainage basin. It is widely regarded as the national river of Russia. The hypothetical old Russian state, the Rus' Khaganate, arose along the Volga c. 830 AD."}}, {"canonical_name": "swallow", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "swallow", "book_id": "principles_of_psychology_james_1890", "name": "swallow", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["swallow"], "contexts": ["process of moving food down the throat", "bird species"]}, {"entity_id": "swallows", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Swallows", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Swallows"], "contexts": ["birds whose presence in houses has symbolic meaning"]}, {"entity_id": "swallow", "book_id": "english_physician_1652", "name": "Swallow", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["Swallow"], "contexts": ["animal associated with the herb's name"]}, {"entity_id": "swallow", "book_id": "origin_of_species_darwin_1859", "name": "swallow", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["swallow"], "contexts": ["bird species"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "swallow", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Swallows", "similarity": 0.94}, {"source_book": "principles_of_psychology_james_1890", "source_name": "swallow", "target_book": "english_physician_1652", "target_name": "Swallow", "similarity": 0.857}, {"source_book": "principles_of_psychology_james_1890", "source_name": "swallow", "target_book": "origin_of_species_darwin_1859", "target_name": "swallow", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Swallows", "target_book": "english_physician_1652", "target_name": "Swallow", "similarity": 0.851}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Swallows", "target_book": "origin_of_species_darwin_1859", "target_name": "swallow", "similarity": 0.94}, {"source_book": "english_physician_1652", "source_name": "Swallow", "target_book": "origin_of_species_darwin_1859", "target_name": "swallow", "similarity": 0.857}], "id": 197, "stable_key": "clu_a78aa1285b9c8daa", "ground_truth": {"wikipedia_extract": "The swallows, martins, and saw-wings, or Hirundinidae, are a family of passerine songbirds found around the world on all continents, including occasionally in Antarctica. Highly adapted to aerial feeding, they have a distinctive appearance. The term \"swallow\" is used as the common name for Hirundo rustica in the United Kingdom and Ireland. Around 90 species of Hirundinidae are known, divided into 21 genera, with the greatest diversity found in Africa, which is also thought to be where they evolved as hole-nesters. They also occur on a number of oceanic islands. A number of European and North American species are long-distance migrants; by contrast, the West and South African swallows are nonmigratory."}}, {"canonical_name": "dreams", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "dreams", "book_id": "principles_of_psychology_james_1890", "name": "dreams", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["dreams"], "contexts": ["mental experiences during sleep"]}, {"entity_id": "dreams", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Dreams", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Dreams"], "contexts": ["mental experiences during sleep"]}, {"entity_id": "dreams", "book_id": "english_physician_1652", "name": "Dreams", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Dreams"], "contexts": ["sequences of images, ideas, emotions"]}, {"entity_id": "sonho", "book_id": "polyanthea_medicinal", "name": "sonho", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sonho"], "contexts": ["dream"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "dreams", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Dreams", "similarity": 0.99}, {"source_book": "principles_of_psychology_james_1890", "source_name": "dreams", "target_book": "english_physician_1652", "target_name": "Dreams", "similarity": 0.99}, {"source_book": "principles_of_psychology_james_1890", "source_name": "dreams", "target_book": "polyanthea_medicinal", "target_name": "sonho", "similarity": 0.932}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Dreams", "target_book": "english_physician_1652", "target_name": "Dreams", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Dreams", "target_book": "polyanthea_medicinal", "target_name": "sonho", "similarity": 0.922}, {"source_book": "english_physician_1652", "source_name": "Dreams", "target_book": "polyanthea_medicinal", "target_name": "sonho", "similarity": 0.922}], "id": 198, "stable_key": "clu_891f4ba763ba6f95", "ground_truth": {"wikipedia_extract": "A dream is a succession of images, dynamic scenes and situations, ideas, emotions, and sensations that usually occur involuntarily in the mind during certain stages of sleep. Humans spend more than two hours dreaming per night, and each dream lasts around 5–20 minutes. The content and function of dreams have been topics of scientific, philosophical and religious interest throughout recorded history. Dream interpretation, practiced by the Babylonians in the third millennium BCE and even earlier by the ancient Sumerians, figures prominently in religious texts in several traditions, and has played a lead role in psychotherapy. Dreamwork is similar, but does not seek to conclude with definite meaning. The scientific study of dreams is called oneirology."}}, {"canonical_name": "Retentive", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "retentive", "book_id": "english_physician_1652", "name": "Retentive", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Retentive", "Retentive Faculty"], "contexts": ["bodily virtue", "bodily function of retention"]}, {"entity_id": "retentissement", "book_id": "principles_of_psychology_james_1890", "name": "retentissement", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["retentissement"], "contexts": ["French term for after-image or reverberation"]}, {"entity_id": "retentiva", "book_id": "historia_medicinal_monardes_1574", "name": "Retentiva", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Retentiva"], "contexts": ["retentive virtue"]}, {"entity_id": "retentrix", "book_id": "polyanthea_medicinal", "name": "retentrix", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["retentrix"], "contexts": ["power of retention"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Retentive", "target_book": "principles_of_psychology_james_1890", "target_name": "retentissement", "similarity": 0.866}, {"source_book": "english_physician_1652", "source_name": "Retentive", "target_book": "historia_medicinal_monardes_1574", "target_name": "Retentiva", "similarity": 0.986}, {"source_book": "english_physician_1652", "source_name": "Retentive", "target_book": "polyanthea_medicinal", "target_name": "retentrix", "similarity": 0.882}, {"source_book": "principles_of_psychology_james_1890", "source_name": "retentissement", "target_book": "historia_medicinal_monardes_1574", "target_name": "Retentiva", "similarity": 0.868}, {"source_book": "principles_of_psychology_james_1890", "source_name": "retentissement", "target_book": "polyanthea_medicinal", "target_name": "retentrix", "similarity": 0.854}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Retentiva", "target_book": "polyanthea_medicinal", "target_name": "retentrix", "similarity": 0.877}], "id": 199, "stable_key": "clu_424f58d4142689e2", "ground_truth": {"modern_name": "Retentive", "confidence": "high", "type": "concept", "description": "A bodily virtue or function related to the power of retention.", "wikipedia_extract": "Anal retentiveness is a personality trait that is characterized by excessive concern with details. The concept originated in Freudian psychoanalytic theory, where one aspect of the anal stage of psychosexual development is pleasure in the retention of feces. Fixation in this stage can potentially result in a personality marked by frugality, obstinacy and orderliness. Despite its psychoanalytic roots and the literal meaning of the words, in common usage the term generally refers merely to certain kinds of obsessive behaviour. In Freudian psychology, the anal stage is said to follow the oral stage of infant or early-childhood development, and occurs from around the age of eighteen months to three years old. The infant's attention moves from oral stimulation to anal stimulation, usually synchronous with learning to control its excretory functions.", "wikipedia_url": "https://en.wikipedia.org/wiki/Anal_retentiveness"}}, {"canonical_name": "sparrow", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "sparrow", "book_id": "first_principles_spencer_1862", "name": "sparrow", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["sparrow"], "contexts": ["small to medium-sized bird", "bird whose changing relations of position are noted"]}, {"entity_id": "sparrow", "book_id": "principles_of_psychology_james_1890", "name": "sparrow", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["sparrow"], "contexts": ["animal used as example"]}, {"entity_id": "spteryx", "book_id": "kosmos_humboldt_1845", "name": "spteryx", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["spteryx"], "contexts": ["bird allied to dinornis"]}, {"entity_id": "sparrow", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sparrow", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["sparrow"], "contexts": ["common, has a wide range"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "sparrow", "target_book": "principles_of_psychology_james_1890", "target_name": "sparrow", "similarity": 1.0}, {"source_book": "first_principles_spencer_1862", "source_name": "sparrow", "target_book": "kosmos_humboldt_1845", "target_name": "spteryx", "similarity": 0.858}, {"source_book": "first_principles_spencer_1862", "source_name": "sparrow", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sparrow", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sparrow", "target_book": "kosmos_humboldt_1845", "target_name": "spteryx", "similarity": 0.858}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sparrow", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sparrow", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "spteryx", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sparrow", "similarity": 0.858}], "id": 200, "stable_key": "clu_a0d3d50f0f2cf300", "ground_truth": {"modern_name": "Sparrow", "confidence": "high", "type": "animal", "note": "While 'spteryx' is unusual, in the context of 'sparrow' and 'bird', it is likely a misspelling or variant. 'Dinornis' refers to extinct moa, but 'sparrow' is the clear primary referent.", "wikidata_id": "Q16883649", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Sparrow%20%28surname%29"}}, {"canonical_name": "Bruxelles", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "bruxelles", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bruxelles", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Bruxelles"], "contexts": ["abandoned city", "city near the Gulf of Nicoya"]}, {"entity_id": "brussels", "book_id": "principles_of_psychology_james_1890", "name": "Brussels", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Brussels"], "contexts": ["location of research publication"]}, {"entity_id": "bruxelles", "book_id": "kosmos_humboldt_1845", "name": "Bruxelles", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bruxelles"], "contexts": ["location of Duprez's publication"]}, {"entity_id": "brussels", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Brussels", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Brussels"], "contexts": ["location of Plateau's experiments"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bruxelles", "target_book": "principles_of_psychology_james_1890", "target_name": "Brussels", "similarity": 0.968}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bruxelles", "target_book": "kosmos_humboldt_1845", "target_name": "Bruxelles", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bruxelles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Brussels", "similarity": 0.968}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Brussels", "target_book": "kosmos_humboldt_1845", "target_name": "Bruxelles", "similarity": 0.968}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Brussels", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Brussels", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bruxelles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Brussels", "similarity": 0.968}], "id": 201, "stable_key": "clu_c55abfd8c9e7cb27", "ground_truth": {"wikipedia_extract": "Brussels, officially the Brussels-Capital Region, is a region of Belgium comprising 19 municipalities, including the City of Brussels, which is the capital of Belgium. The Brussels-Capital Region is located in the central portion of the country. It is a part of both the French Community of Belgium and the Flemish Community, and is separate from the Flemish Region (Flanders), within which it forms an enclave, and the Walloon Region (Wallonia), located less than 4 kilometres (2.5 mi) to the south. Brussels grew from a small rural settlement on the river Senne to become an important city-region in Europe. Since the end of the Second World War, it has been a major centre for international politics and home to numerous international organisations, politicians, diplomats and civil servants. Brussels is the de facto capital of the European Union, as it hosts a number of principal EU institutions, including its administrative-legislative, executive-political, and legislative branches (though the judicial branch is located in Luxembourg, and the European Parliament meets for a minority of the year in Strasbourg)."}}, {"canonical_name": "Creta", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "creta", "book_id": "historia_medicinal_monardes_1574", "name": "Creta", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Creta"], "contexts": ["island where Dictamo grows", "island, Crete"]}, {"entity_id": "cretan", "book_id": "kosmos_humboldt_1845", "name": "Cretan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cretan"], "contexts": ["from the island of Crete"]}, {"entity_id": "creta", "book_id": "coloquios_da_orta_1563", "name": "Creta", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Creta"], "contexts": ["location of açaroro according to Pliny"]}, {"entity_id": "creta", "book_id": "polyanthea_medicinal", "name": "Creta", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Creta"], "contexts": ["location of a plague"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Creta", "target_book": "kosmos_humboldt_1845", "target_name": "Cretan", "similarity": 0.982}, {"source_book": "coloquios_da_orta_1563", "source_name": "Creta", "target_book": "polyanthea_medicinal", "target_name": "Creta", "similarity": 1.0}], "id": 202, "stable_key": "clu_41ed4ce9c1a1b25c", "ground_truth": {"wikipedia_extract": "Crete ( KREET; Greek: Κρήτη, Modern: Kríti [ˈkriti], Ancient: Krḗtē [krɛ̌ːtεː]) is the largest and most populous of the Greek islands, the 90th largest island in the world, and the fifth largest island in the Mediterranean Sea, after Sicily, Sardinia, Cyprus, and Corsica. Crete is located approximately 100 km (62 mi) south of the Peloponnese, and about 300 km (190 mi) southwest of Anatolia. Crete has an area of 8,450 km2 (3,260 mi2) and a coastline of 1,046 km (650 mi). It bounds the southern border of the Aegean Sea, with the Sea of Crete (or North Cretan Sea) to the north and the Libyan Sea (or South Cretan Sea) to the south. Crete covers 260 km from west to east but is narrow from north to south, spanning three degrees of longitude but only half a degree of latitude. Crete and its surrounding islands and islets form the Region of Crete (Greek: Περιφέρεια Κρήτης), which is the southernmost of the 13 top-level administrative units of Greece, and the fifth most populous of Greece's regions."}}, {"canonical_name": "epidemics", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 4, "total_mentions": 4, "members": [{"entity_id": "epidemics", "book_id": "origin_of_species_darwin_1859", "name": "epidemics", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["epidemics"], "contexts": ["widespread occurrence of an infectious disease"]}, {"entity_id": "epidemics", "book_id": "kosmos_humboldt_1845", "name": "epidemics", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["epidemics"], "contexts": ["widespread outbreaks of disease"]}, {"entity_id": "epidemia", "book_id": "coloquios_da_orta_1563", "name": "epidemia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["epidemia"], "contexts": ["widespread occurrence of disease"]}, {"entity_id": "epidemia", "book_id": "polyanthea_medicinal", "name": "epidemia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["epidemia"], "contexts": ["medical text reference"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "epidemics", "target_book": "kosmos_humboldt_1845", "target_name": "epidemics", "similarity": 0.813}, {"source_book": "origin_of_species_darwin_1859", "source_name": "epidemics", "target_book": "coloquios_da_orta_1563", "target_name": "epidemia", "similarity": 0.974}, {"source_book": "origin_of_species_darwin_1859", "source_name": "epidemics", "target_book": "polyanthea_medicinal", "target_name": "epidemia", "similarity": 0.974}, {"source_book": "coloquios_da_orta_1563", "source_name": "epidemia", "target_book": "polyanthea_medicinal", "target_name": "epidemia", "similarity": 1.0}], "id": 203, "stable_key": "clu_32ac3b9125283b41", "ground_truth": {"wikipedia_extract": "An epidemic (from Greek ἐπί epi \"upon or above\" and δῆμος demos \"people\") is the rapid spread of disease to a large number of hosts in a given population within a short period of time. For example, in meningococcal infections, an attack rate in excess of 15 cases per 100,000 people for two consecutive weeks is considered an epidemic. Epidemics of infectious disease are generally caused by several factors including a change in the ecology of the host population (e.g., increased stress or increase in the density of a vector species), a genetic change in the pathogen reservoir or the introduction of an emerging pathogen to a host population (by movement of pathogen or host). Generally, an epidemic occurs when host immunity to either an established pathogen or newly emerging novel pathogen is suddenly reduced below that found in the endemic equilibrium and the transmission threshold is exceeded. An epidemic may be restricted to one location; however, if it spreads to other countries or continents and affects a substantial number of people, it may be termed as a pandemic. The declaration of an epidemic usually requires a good understanding of a baseline rate of incidence; epidemics for certain diseases, such as influenza, are defined as reaching some defined increase in incidence above this baseline."}}, {"canonical_name": "matin", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 4, "members": [{"entity_id": "matin", "book_id": "relation_historique_humboldt_vol3_1825", "name": "matin", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["matin"], "contexts": ["time of day"]}, {"entity_id": "morning", "book_id": "principles_of_psychology_james_1890", "name": "morning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["morning"], "contexts": ["part of the day"]}, {"entity_id": "mañana", "book_id": "historia_medicinal_monardes_1574", "name": "mañana", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mañana"], "contexts": ["time of day for drinking"]}, {"entity_id": "manhã", "book_id": "polyanthea_medicinal", "name": "manhã", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["manhã"], "contexts": ["morning"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "matin", "target_book": "principles_of_psychology_james_1890", "target_name": "morning", "similarity": 0.935}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "matin", "target_book": "historia_medicinal_monardes_1574", "target_name": "mañana", "similarity": 0.931}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "matin", "target_book": "polyanthea_medicinal", "target_name": "manhã", "similarity": 0.95}, {"source_book": "principles_of_psychology_james_1890", "source_name": "morning", "target_book": "historia_medicinal_monardes_1574", "target_name": "mañana", "similarity": 0.947}, {"source_book": "principles_of_psychology_james_1890", "source_name": "morning", "target_book": "polyanthea_medicinal", "target_name": "manhã", "similarity": 0.95}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "mañana", "target_book": "polyanthea_medicinal", "target_name": "manhã", "similarity": 0.951}], "id": 204, "stable_key": "clu_cbf3c54ef726504d", "ground_truth": {"modern_name": "Morning", "confidence": "high", "type": "concept", "note": "The terms 'matin' (French), 'morning' (English), 'mañana' (Spanish), and 'manhã' (Portuguese) all refer to the early part of the day.", "wikidata_id": "Q37572163", "wikidata_description": "family name", "wikipedia_extract": "Morning is either the period from sunrise to noon, or the period from midnight to noon. In the first definition it is preceded by the twilight period of dawn, and there are no exact times for when morning begins (also true of evening and night) because it can vary according to one's latitude, and the hours of daylight at each time of year. However, morning strictly ends at noon, when afternoon starts. Morning precedes afternoon, evening, and night in the sequence of a day. Originally, the term referred to sunrise. The Modern English words \"morning\" and \"tomorrow\" began in Middle English as morwening, developing into morwen, then morwe, and eventually morrow."}}, {"canonical_name": "veas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 278, "members": [{"entity_id": "veas", "book_id": "polyanthea_medicinal", "name": "veas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 259, "variants": ["veas", "Nas veas", "Veas Jugulares", "Venam", "tunica das veas", "vasa", "veade", "veas Caroticas", "veas Jugulares", "veas Lacteas", "veas Leonicas", "veas Meseraicas", "veas Meſeraicas", "veas Moferaicas", "veas Paraſtatas", "veas Pneumonicas", "veas Ureteras", "veas altas", "veas bayxas", "veas capilares", "veas capillares", "veas da teſta", "veas exteriores", "veas grandes", "veas hemorrhoidaes", "veas hemorroidaes", "veas inferiores", "veas interiores", "veas jugulares", "veas lacteas", "veas lumbares", "veas mayores", "veas meleraicas", "veas menores", "veas meſeraicas", "veas pequenas", "veas ureteras", "veas uterinas", "veasEſpermaticas", "veasMeferaicas", "vena", "venam", "vene", "venä", "ves"], "contexts": ["veins", "blood vessels"]}, {"entity_id": "vein", "book_id": "english_physician_1652", "name": "Vein", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 11, "variants": ["Vein", "Veins"], "contexts": ["blood vessel where bleeding is stopped", "blood vessel"]}, {"entity_id": "veas", "book_id": "coloquios_da_orta_1563", "name": "veas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["veas"], "contexts": ["veins"]}, {"entity_id": "vea_do_artelho", "book_id": "coloquios_da_orta_1563", "name": "vea do artelho", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["vea do artelho"], "contexts": ["vein in the ankle"]}, {"entity_id": "veas_subclaveas", "book_id": "polyanthea_medicinal", "name": "veas subclaveas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["veas subclaveas", "veas Subclaveas", "veas Subclavias"], "contexts": ["subclavian veins", "veins near the collarbone"]}, {"entity_id": "veas_guides", "book_id": "polyanthea_medicinal", "name": "Veas Guides", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Veas Guides"], "contexts": ["veins in the neck"]}, {"entity_id": "veas_que_estaó_detraz_dasorelhas", "book_id": "polyanthea_medicinal", "name": "veas que estaó detraz dasorelhas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["veas que estaó detraz dasorelhas"], "contexts": ["veins behind the ears"]}, {"entity_id": "veas_emul__gentes", "book_id": "polyanthea_medicinal", "name": "veas Emul. gentes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["veas Emul. gentes"], "contexts": ["emulgent veins (renal veins)"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "veas", "target_book": "english_physician_1652", "target_name": "Vein", "similarity": 0.879}, {"source_book": "polyanthea_medicinal", "source_name": "veas", "target_book": "coloquios_da_orta_1563", "target_name": "veas", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "veas", "target_book": "coloquios_da_orta_1563", "target_name": "vea do artelho", "similarity": 0.869}, {"source_book": "english_physician_1652", "source_name": "Vein", "target_book": "coloquios_da_orta_1563", "target_name": "veas", "similarity": 0.879}, {"source_book": "coloquios_da_orta_1563", "source_name": "veas", "target_book": "polyanthea_medicinal", "target_name": "veas subclaveas", "similarity": 0.82}, {"source_book": "coloquios_da_orta_1563", "source_name": "veas", "target_book": "polyanthea_medicinal", "target_name": "Veas Guides", "similarity": 0.824}, {"source_book": "coloquios_da_orta_1563", "source_name": "veas", "target_book": "polyanthea_medicinal", "target_name": "veas que estaó detraz dasorelhas", "similarity": 0.816}, {"source_book": "coloquios_da_orta_1563", "source_name": "veas", "target_book": "polyanthea_medicinal", "target_name": "veas Emul. gentes", "similarity": 0.81}], "id": 205, "stable_key": "clu_99a653965c1fb9ab", "ground_truth": {"modern_name": "Veins", "confidence": "high", "type": "anatomy", "description": "Blood vessels that carry blood towards the heart.", "wikipedia_extract": "A vein () is a blood vessel in the circulatory system of humans and most other animals that carries blood towards the heart. Most veins carry deoxygenated blood from the tissues back to the heart; exceptions are those of the pulmonary and fetal circulations which carry oxygenated blood to the heart. In the systemic circulation, arteries carry oxygenated blood away from the heart, and veins return deoxygenated blood to the heart, in the deep veins. There are three sizes of veins: large, medium, and small. Smaller veins are called venules, and the smallest the post-capillary venules are microscopic that make up the veins of the microcirculation. Veins are often closer to the skin than arteries."}}, {"canonical_name": "sangrias", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 276, "members": [{"entity_id": "sangrias", "book_id": "polyanthea_medicinal", "name": "sangrias", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 258, "variants": ["sangrias", "Sangria", "Sangrias", "Sangriasbaixas", "sangra", "sangrada", "sangrado", "sangraf", "sangraflem", "sangralla", "sangrallas", "sangrallo", "sangrando", "sangrar", "sangrarem", "sangraremos", "sangrarmos", "sangrem", "sangremos", "sangria", "sangriada", "sangrias altas", "sangrias arteriosas", "sangrias bayxas", "sangrias copiosas", "sangrias dos braços", "sangrias dos pès", "sangrou"], "contexts": ["bloodletting, a medical procedure", "bloodletting"]}, {"entity_id": "sangrar", "book_id": "historia_medicinal_monardes_1574", "name": "sangrar", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 4, "variants": ["sangrar", "sangría", "sangrías"], "contexts": ["bloodletting", "medical practice for illness"]}, {"entity_id": "sangria", "book_id": "coloquios_da_orta_1563", "name": "sangria", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 14, "variants": ["sangria", "sangrar", "sangrarme", "sangreio", "sangrese", "sangria no artelho"], "contexts": ["bloodletting practice", "implied medical practice"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "sangrias", "target_book": "historia_medicinal_monardes_1574", "target_name": "sangrar", "similarity": 0.956}, {"source_book": "polyanthea_medicinal", "source_name": "sangrias", "target_book": "coloquios_da_orta_1563", "target_name": "sangria", "similarity": 0.976}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "sangrar", "target_book": "coloquios_da_orta_1563", "target_name": "sangria", "similarity": 0.973}], "id": 206, "stable_key": "clu_787232392859187f", "ground_truth": {"modern_name": "Bloodletting", "confidence": "high", "type": "practice", "description": "A medical procedure involving the withdrawal of blood.", "wikipedia_extract": "Bloodletting (or blood-letting) is the deliberate withdrawal of blood from a patient to prevent or cure illness and disease. Bloodletting, whether by a physician or by leeches, was based on an ancient system of medicine in which blood and other bodily fluids were regarded as \"humors\" that had to remain in proper balance to maintain health. It was the most common medical practice performed by surgeons from antiquity until the late 19th century, a span of over 2,000 years. In Europe, the practice continued to be relatively common until the end of the 19th century. The practice has been abandoned by modern-style medicine for all except a few very specific medical conditions. In the beginning of the 19th century, studies had begun to show the harmful effects of bloodletting."}}, {"canonical_name": "Havane", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 246, "members": [{"entity_id": "havane", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Havane", "category": "PLACE", "subcategory": "CITY", "count": 240, "variants": ["Havane", "HAVANE", "Habana", "Havana", "La Havane", "U Havane", "la Havane"], "contexts": ["capital of Cuba", "destination city for ships"]}, {"entity_id": "obs__de_la_havane", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Obs. de la Havane", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Obs. de la Havane"], "contexts": ["observations location"]}, {"entity_id": "havana", "book_id": "kosmos_humboldt_1845", "name": "Havana", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Havana"], "contexts": ["location for magnetic observations", "capital city of Cuba"]}, {"entity_id": "havana", "book_id": "historia_medicinal_monardes_1574", "name": "Havana", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Havana"], "contexts": ["port city where a ship captain arrived"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Havane", "target_book": "kosmos_humboldt_1845", "target_name": "Havana", "similarity": 0.983}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Havane", "target_book": "historia_medicinal_monardes_1574", "target_name": "Havana", "similarity": 0.983}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Obs. de la Havane", "target_book": "kosmos_humboldt_1845", "target_name": "Havana", "similarity": 0.855}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Obs. de la Havane", "target_book": "historia_medicinal_monardes_1574", "target_name": "Havana", "similarity": 0.855}, {"source_book": "kosmos_humboldt_1845", "source_name": "Havana", "target_book": "historia_medicinal_monardes_1574", "target_name": "Havana", "similarity": 1.0}], "id": 207, "stable_key": "clu_fd290810de5c02d1", "ground_truth": {"modern_name": "Havana", "confidence": "high", "type": "place", "description": "Capital city and major port of Cuba, a historical center.", "wikipedia_extract": "Havana (, US also ; Spanish: La Habana [la‿aˈβana] ) is the capital and largest city of Cuba. The heart of La Habana Province, Havana is the country's main port and commercial center. It is the most populous city, the largest by area, and the second-largest metropolitan area in the Caribbean region. The population in 2021 was 2,142,939 inhabitants, and its area is 728.26 km2 (281.18 sq mi) for the capital city and 8,475.57 km2 for the metropolitan zone. Its official population was 1,749,964 inhabitants in 2024. Founded in 1519 on its current location on Havana Bay under initiative of the Spanish Empire, it had already taken an edge over Santiago by the mid 16th century due to the geo-strategic advantages of its harbor, becoming the capital of the island in 1552."}}, {"canonical_name": "Apoplexia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 199, "members": [{"entity_id": "apoplexia", "book_id": "polyanthea_medicinal", "name": "Apoplexia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 193, "variants": ["Apoplexia", "Apople-xias", "ApopleVeiga", "Apopleticis", "Apopleticos", "Apoplex", "Apoplexi", "Apoplexia adelapſu", "Apoplexia cognofcenda", "Apoplexia exfanguine", "Apoplexia fimulata", "Apoplexia forti", "Apoplexia fortis", "Apoplexia lethalis", "Apoplexia mor", "Apoplexia pituitosa", "Apoplexias", "Apoplexie", "Apoplexy", "Apopleça", "apofteana", "apoftema", "apopleticos", "apoplexi", "apoplexia", "apoplexias", "apoplexies", "apoplexy", "apostema", "apostemada", "apostemata", "aposterma", "apoſtema", "poplexias"], "contexts": ["chapter title about apoplexy", "stroke"]}, {"entity_id": "apoplexie", "book_id": "english_physician_1652", "name": "Apoplexie", "category": "DISEASE", "subcategory": "ACUTE", "count": 5, "variants": ["Apoplexie", "Apoplexy"], "contexts": ["prevented by distilled water", "condition helped by mistletoe"]}, {"entity_id": "apoplexy", "book_id": "principles_of_psychology_james_1890", "name": "apoplexy", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["apoplexy"], "contexts": ["stroke"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Apoplexia", "target_book": "english_physician_1652", "target_name": "Apoplexie", "similarity": 0.867}, {"source_book": "polyanthea_medicinal", "source_name": "Apoplexia", "target_book": "principles_of_psychology_james_1890", "target_name": "apoplexy", "similarity": 0.982}, {"source_book": "english_physician_1652", "source_name": "Apoplexie", "target_book": "principles_of_psychology_james_1890", "target_name": "apoplexy", "similarity": 0.871}], "id": 208, "stable_key": "clu_47c633cbe0bacb85", "ground_truth": {"modern_name": "Apoplexy", "confidence": "high", "type": "disease", "description": "A medical condition, often referring to a stroke.", "wikipedia_extract": "Apoplexy (from Ancient Greek  ἀποπληξία (apoplexia) 'a striking away') refers to the rupture of an internal organ and the associated symptoms. Informally or metaphorically, the term apoplexy is associated with being furious, especially as \"apoplectic\". Historically, it described what is now known as a hemorrhagic stroke, typically involving a ruptured blood vessel in the brain; modern medicine typically specifies the anatomical location of the bleeding, such as cerebral apoplexy, ovarian apoplexy, or pituitary apoplexy. From the late 14th to the late 19th century, the diagnosis apoplexy referred to any sudden death that began with abrupt loss of consciousness, especially when the victim died within seconds after losing consciousness. The word apoplexy was sometimes used to refer to the symptom of sudden loss of consciousness immediately preceding death. Strokes, ruptured aortic aneurysms, and even heart attacks were referred to as apoplexy in the past, because before the advent of biomedical science, the ability to differentiate abnormal conditions and diseased states was limited."}}, {"canonical_name": "natural selection", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 3, "total_mentions": 198, "members": [{"entity_id": "natural_selection", "book_id": "origin_of_species_darwin_1859", "name": "natural selection", "category": "CONCEPT", "subcategory": "THEORY", "count": 188, "variants": ["NATURAL SELECTION", "natural selection", "Natural selection", "Natural Selection"], "contexts": ["mechanism for evolution", "mechanism of evolution by differential survival"]}, {"entity_id": "theory_of_natural_selection", "book_id": "origin_of_species_darwin_1859", "name": "theory of natural selection", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["theory of natural selection"], "contexts": ["evolutionary mechanism"]}, {"entity_id": "natural_selection", "book_id": "principles_of_psychology_james_1890", "name": "natural selection", "category": "CONCEPT", "subcategory": "THEORY", "count": 3, "variants": ["natural selection"], "contexts": ["evolutionary mechanism", "mechanism of evolution"]}, {"entity_id": "natural_selection", "book_id": "first_principles_spencer_1862", "name": "natural selection", "category": "CONCEPT", "subcategory": "THEORY", "count": 6, "variants": ["natural selection"], "contexts": ["mechanism of evolution", "evolution of Life along lines of least resistance"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "natural selection", "target_book": "principles_of_psychology_james_1890", "target_name": "natural selection", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "natural selection", "target_book": "first_principles_spencer_1862", "target_name": "natural selection", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "theory of natural selection", "target_book": "principles_of_psychology_james_1890", "target_name": "natural selection", "similarity": 0.961}, {"source_book": "origin_of_species_darwin_1859", "source_name": "theory of natural selection", "target_book": "first_principles_spencer_1862", "target_name": "natural selection", "similarity": 0.961}, {"source_book": "principles_of_psychology_james_1890", "source_name": "natural selection", "target_book": "first_principles_spencer_1862", "target_name": "natural selection", "similarity": 1.0}], "id": 209, "stable_key": "clu_8476039c2bcf04df", "ground_truth": {"modern_name": "natural selection", "confidence": "high", "type": "concept", "description": "Mechanism of evolution by differential survival and reproduction.", "wikipedia_extract": "Natural selection is the differential survival and reproduction of individuals due to differences in the relative fitness endowed on them by their own particular complement of observable characteristics. It is a key law or mechanism of evolution which changes the heritable traits characteristic of a population or species over generations. Charles Darwin popularised the term \"natural selection\", contrasting it with artificial selection, which is intentional, whereas natural selection is not. For Darwin natural selection was a law or principle which resulted from three different kinds of process: inheritance, including the transmission of heritable material from parent to offspring and its development (ontogeny) in the offspring; variation, which partly resulted from an organism's own agency (see phenotype; Baldwin effect); and the struggle for existence, which included both competition between organisms and cooperation or 'mutual aid' (particularly in 'social' plants and social animals). Variation of traits, both genotypic and phenotypic, exists within all populations of organisms. However, some traits are more likely to facilitate survival and reproductive success."}}, {"canonical_name": "camaras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 153, "members": [{"entity_id": "camaras", "book_id": "polyanthea_medicinal", "name": "camaras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 136, "variants": ["camaras", "Camaras", "Camaras Dysentericas", "Camaras antigas", "Camarasnegras", "camaras Celiacas", "camaras Chylolas", "camaras Lientericas", "camaras antigas", "camaras colericas", "camaras de fangue", "camaras de langue", "camaras de sangue", "camaras de ſangue", "camaras entericas", "camaras epaticas", "camaras fanguinolentas", "camaras hepaticas", "camaras mortaes", "camarasde", "camarasde sangue", "camarasde ſangue"], "contexts": ["condition treated by remedy", "medical condition"]}, {"entity_id": "camaras", "book_id": "historia_medicinal_monardes_1574", "name": "camaras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 11, "variants": ["camaras", "camara"], "contexts": ["medical condition involving discharge", "illness with purging"]}, {"entity_id": "camaras_cholericas", "book_id": "historia_medicinal_monardes_1574", "name": "Camaras cholericas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Camaras cholericas"], "contexts": ["choleric stomach conditions"]}, {"entity_id": "camará", "book_id": "coloquios_da_orta_1563", "name": "camará", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["camará", "camarás coléricas"], "contexts": ["result of enema", "condition related to indigestion"]}, {"entity_id": "ogenerode_camaras", "book_id": "polyanthea_medicinal", "name": "ogenerode camaras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["ogenerode camaras"], "contexts": ["condition related to chambers"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "camaras", "target_book": "historia_medicinal_monardes_1574", "target_name": "camaras", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "camaras", "target_book": "historia_medicinal_monardes_1574", "target_name": "Camaras cholericas", "similarity": 0.819}, {"source_book": "polyanthea_medicinal", "source_name": "camaras", "target_book": "coloquios_da_orta_1563", "target_name": "camará", "similarity": 0.872}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "camaras", "target_book": "coloquios_da_orta_1563", "target_name": "camará", "similarity": 0.872}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "camaras", "target_book": "polyanthea_medicinal", "target_name": "ogenerode camaras", "similarity": 0.842}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Camaras cholericas", "target_book": "coloquios_da_orta_1563", "target_name": "camará", "similarity": 0.829}], "id": 210, "stable_key": "clu_1a94ccbdd2624101", "ground_truth": {"modern_name": "Cholericas", "confidence": "low", "type": "disease", "description": "A condition associated with humors, particularly bile.", "note": "The term 'camaras' is likely a misspelling or archaic form related to 'cholericas' (choleric) or conditions affecting the stomach/bowels.", "wikipedia_extract": "Camaraou noir is a red French wine grape variety that was historically grown in South West France but is now more widely planted in the Spanish wine region of Galicia where it is known as Espadeiro. However, despite its Spanish synonym Camaraou noir has no relationship to the Portuguese wine grape Espadeiro that is used to make red Vinho Verde. The grape may have some relation to the Jurançon and Béarn wine grape Camaralet de Lasseube which is also known as Camaraou blanc but DNA analysis has shown that the two varieties are distinct and not color mutations of one or the other. Ampelographers believe that the name Camaraou derives from the Béarnese word camarau which may have, in turn, be derived itself from the Gascon word cama that means \"leg, trunk\" and could be a reference to viticultural practice of growing grapevines up trees as trellising. Another possibility is that the name has some connection to the commune of Camalès located in the Hautes-Pyrénées department of southwestern France. A late 18th century document shows that a Camarau grape was growing in the Pyrénées-Atlantiques department, French Basque Country and in the País Vasco region of northern Spain, however the description of this grapes seems to indicate that it was more likely the white Camaraou blanc (Camaralet de Lasseube) grape."}}, {"canonical_name": "ovo", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 3, "total_mentions": 149, "members": [{"entity_id": "ovo", "book_id": "polyanthea_medicinal", "name": "ovo", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 77, "variants": ["ovo", "ova", "oves"], "contexts": ["egg, used in a remedy", "egg used in a remedy"]}, {"entity_id": "clara_de_ovo", "book_id": "coloquios_da_orta_1563", "name": "clara de ovo", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["clara de ovo"], "contexts": ["mixed with falcon plaster ingredients"]}, {"entity_id": "gemas_de_ovos", "book_id": "coloquios_da_orta_1563", "name": "gemas de ovos", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["gemas de ovos"], "contexts": ["egg yolks, considered corruptible"]}, {"entity_id": "ovo_de_galinha", "book_id": "coloquios_da_orta_1563", "name": "ovo de galinha", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["ovo de galinha"], "contexts": ["egg used for size comparison"]}, {"entity_id": "ovo_de_pata", "book_id": "coloquios_da_orta_1563", "name": "ovo de pata", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["ovo de pata"], "contexts": ["animal product, comparison for size"]}, {"entity_id": "ovelhas", "book_id": "coloquios_da_orta_1563", "name": "ovelhas", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["ovelhas"], "contexts": ["animals that eat the plant"]}, {"entity_id": "gemas_de_ovos", "book_id": "polyanthea_medicinal", "name": "gemas de ovos", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 60, "variants": ["gemas de ovos", "Agema do ovo", "clara de ovo", "clarade ovo", "claras de ovo", "claras de ovos", "claras deovo", "claras dos ovos", "gema de ovo", "gema de ovo cru", "gema de ovo crua", "gema de ovo frefco", "gema de ovo molle", "gema de ovo muyto dura", "gema deovocrua", "gemas de ovo", "gemas de ovos frescos", "gemasde ovos", "gemasde ovos cruas", "gemasdeovos freicos"], "contexts": ["food for the sick", "Egg yolks, used as a nutritive aid"]}, {"entity_id": "clara_de_ovobatida", "book_id": "polyanthea_medicinal", "name": "clara de ovobatida", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 2, "variants": ["clara de ovobatida", "claras de ovos batidas"], "contexts": ["used in patches", "beaten egg whites"]}, {"entity_id": "ovos_degallinha", "book_id": "polyanthea_medicinal", "name": "ovos degallinha", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["ovos degallinha"], "contexts": ["size comparison for bladder stones"]}, {"entity_id": "ovum", "book_id": "first_principles_spencer_1862", "name": "ovum", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["ovum"], "contexts": ["development into an animal", "egg cell of a mammal"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "ovo", "target_book": "coloquios_da_orta_1563", "target_name": "ovo de galinha", "similarity": 0.838}, {"source_book": "polyanthea_medicinal", "source_name": "ovo", "target_book": "coloquios_da_orta_1563", "target_name": "ovo de pata", "similarity": 0.84}, {"source_book": "polyanthea_medicinal", "source_name": "ovo", "target_book": "coloquios_da_orta_1563", "target_name": "ovelhas", "similarity": 0.858}, {"source_book": "polyanthea_medicinal", "source_name": "ovo", "target_book": "first_principles_spencer_1862", "target_name": "ovum", "similarity": 0.842}, {"source_book": "coloquios_da_orta_1563", "source_name": "clara de ovo", "target_book": "polyanthea_medicinal", "target_name": "gemas de ovos", "similarity": 0.86}, {"source_book": "coloquios_da_orta_1563", "source_name": "clara de ovo", "target_book": "polyanthea_medicinal", "target_name": "clara de ovobatida", "similarity": 0.942}, {"source_book": "coloquios_da_orta_1563", "source_name": "gemas de ovos", "target_book": "polyanthea_medicinal", "target_name": "gemas de ovos", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "ovo de galinha", "target_book": "polyanthea_medicinal", "target_name": "ovos degallinha", "similarity": 0.883}], "id": 211, "stable_key": "clu_575ab3aea731bbfa", "ground_truth": {"modern_name": "egg", "confidence": "high", "type": "animal", "description": "Reproductive body laid by female birds, reptiles, amphibians, fish, and insects.", "note": "The context for 'ovelhas' (sheep) is anomalous; it appears to refer to animals that eat a plant, not the egg itself.", "wikipedia_extract": "An egg is an organic vessel grown by an animal to carry a possibly fertilized egg cell – a zygote. Within the vessel, an embryo is incubated until it has become an animal fetus that can survive on its own, at which point the animal hatches. Reproductive structures similar to the egg in other kingdoms are termed \"spores\", or in spermatophytes \"seeds\", or in gametophytes \"egg cells\". Most arthropods, vertebrates (excluding live-bearing mammals), and mollusks lay eggs, although some, such as scorpions, do not. Reptile eggs, bird eggs, and monotreme eggs are laid out of water and are surrounded by a protective shell, either flexible or inflexible. Eggs laid on land or in nests are usually kept within a warm and favorable temperature range while the embryo grows."}}, {"canonical_name": "Vomitorios", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 141, "members": [{"entity_id": "vomitorios", "book_id": "polyanthea_medicinal", "name": "Vomitorios", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 131, "variants": ["Vomitorios", "Vomitoria", "vomi", "vomitando", "vomition", "vomito", "vomitoria", "vomitorijs", "vomitorio", "vomitorio brando", "vomitorio efficaz", "vomitorios", "vomitorios do Quintilio", "vomitou", "vomitu"], "contexts": ["medicines for purging", "Objects used for inducing vomiting"]}, {"entity_id": "vomit", "book_id": "english_physician_1652", "name": "Vomit", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 4, "variants": ["Vomit", "Vomits"], "contexts": ["expulsion of stomach contents", "action to expel poison"]}, {"entity_id": "vomito", "book_id": "historia_medicinal_monardes_1574", "name": "vomito", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 6, "variants": ["vomito"], "contexts": ["vomiting symptom", "act of expelling stomach contents"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Vomitorios", "target_book": "english_physician_1652", "target_name": "Vomit", "similarity": 0.915}, {"source_book": "polyanthea_medicinal", "source_name": "Vomitorios", "target_book": "historia_medicinal_monardes_1574", "target_name": "vomito", "similarity": 0.887}, {"source_book": "english_physician_1652", "source_name": "Vomit", "target_book": "historia_medicinal_monardes_1574", "target_name": "vomito", "similarity": 0.957}], "id": 212, "stable_key": "clu_87ada1d52596e2e2", "ground_truth": {"modern_name": "Emetics", "confidence": "high", "type": "concept", "description": "Substances or practices used to induce vomiting.", "note": "Refers to the concept of inducing vomiting, not the act itself.", "wikipedia_extract": "Vomiting (scientifically known as emesis, and otherwise known as puking, and throwing up) is the forceful expulsion of the contents of one's stomach through the mouth and sometimes the nose. The substance so produced (the erstwhile contents of the stomach, now expelled) is also known as vomit or vomitus. Vomiting can be the result of ailments like food poisoning, gastroenteritis, pregnancy, motion sickness, or hangover; or it can be an after effect of diseases such as brain tumors, elevated intracranial pressure, or overexposure to ionizing radiation. The feeling that one is about to vomit is called nausea; it often precedes, but does not always lead to vomiting. Impairment due to alcohol or anesthesia can cause inhalation of vomit. In severe cases, where dehydration develops, intravenous fluid may be required."}}, {"canonical_name": "Evolution", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 3, "total_mentions": 133, "members": [{"entity_id": "evolution", "book_id": "first_principles_spencer_1862", "name": "Evolution", "category": "CONCEPT", "subcategory": "THEORY", "count": 114, "variants": ["evolution", "EVOLUTION", "Evolution"], "contexts": ["law of evolution in scientific thought", "theory of biological development"]}, {"entity_id": "evolution", "book_id": "principles_of_psychology_james_1890", "name": "evolution", "category": "CONCEPT", "subcategory": "THEORY", "count": 6, "variants": ["evolution"], "contexts": ["process of biological change over time", "theory of gradual development of life"]}, {"entity_id": "zoological_evolution", "book_id": "principles_of_psychology_james_1890", "name": "zoological evolution", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["zoological evolution"], "contexts": ["process of development across animal species", "theory of species development"]}, {"entity_id": "evolutionary", "book_id": "principles_of_psychology_james_1890", "name": "evolutionary", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["evolutionary"], "contexts": ["theory of gradual development and change", "theory of biological change over time"]}, {"entity_id": "evolutive_changes", "book_id": "principles_of_psychology_james_1890", "name": "evolutive changes", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["evolutive changes"], "contexts": ["changes related to evolution"]}, {"entity_id": "evolutionary_philosophy", "book_id": "principles_of_psychology_james_1890", "name": "evolutionary philosophy", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["evolutionary philosophy"], "contexts": ["philosophical framework of evolution"]}, {"entity_id": "zoological_evolutionism", "book_id": "principles_of_psychology_james_1890", "name": "Zoological evolutionism", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["Zoological evolutionism"], "contexts": ["theory of emotional arousal"]}, {"entity_id": "evolved", "book_id": "principles_of_psychology_james_1890", "name": "evolved", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["evolved"], "contexts": ["developed through evolutionary processes"]}, {"entity_id": "evolution", "book_id": "kosmos_humboldt_1845", "name": "evolution", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["evolution"], "contexts": ["doctrine of organic development"]}, {"entity_id": "genetic_evolution", "book_id": "kosmos_humboldt_1845", "name": "genetic evolution", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["genetic evolution"], "contexts": ["theory of development and change"]}, {"entity_id": "geologic_evolution", "book_id": "first_principles_spencer_1862", "name": "Geologic evolution", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["Geologic evolution"], "contexts": ["theory of Earth's development over time"]}, {"entity_id": "theory_of_evolution", "book_id": "first_principles_spencer_1862", "name": "theory of Evolution", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["theory of Evolution"], "contexts": ["pre-supposes adequate pre-existing forces"]}, {"entity_id": "evolutions", "book_id": "first_principles_spencer_1862", "name": "Evolutions", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["Evolutions"], "contexts": ["successive stages of development"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "Evolution", "target_book": "principles_of_psychology_james_1890", "target_name": "evolution", "similarity": 0.966}, {"source_book": "first_principles_spencer_1862", "source_name": "Evolution", "target_book": "principles_of_psychology_james_1890", "target_name": "zoological evolution", "similarity": 0.876}, {"source_book": "first_principles_spencer_1862", "source_name": "Evolution", "target_book": "principles_of_psychology_james_1890", "target_name": "evolutionary", "similarity": 0.943}, {"source_book": "first_principles_spencer_1862", "source_name": "Evolution", "target_book": "principles_of_psychology_james_1890", "target_name": "evolutive changes", "similarity": 0.896}, {"source_book": "first_principles_spencer_1862", "source_name": "Evolution", "target_book": "principles_of_psychology_james_1890", "target_name": "evolutionary philosophy", "similarity": 0.836}, {"source_book": "first_principles_spencer_1862", "source_name": "Evolution", "target_book": "principles_of_psychology_james_1890", "target_name": "Zoological evolutionism", "similarity": 0.841}, {"source_book": "first_principles_spencer_1862", "source_name": "Evolution", "target_book": "principles_of_psychology_james_1890", "target_name": "evolved", "similarity": 0.866}, {"source_book": "first_principles_spencer_1862", "source_name": "Evolution", "target_book": "kosmos_humboldt_1845", "target_name": "evolution", "similarity": 0.966}, {"source_book": "first_principles_spencer_1862", "source_name": "Evolution", "target_book": "kosmos_humboldt_1845", "target_name": "genetic evolution", "similarity": 0.849}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolution", "target_book": "kosmos_humboldt_1845", "target_name": "evolution", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolution", "target_book": "kosmos_humboldt_1845", "target_name": "genetic evolution", "similarity": 0.86}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolution", "target_book": "first_principles_spencer_1862", "target_name": "Geologic evolution", "similarity": 0.846}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolution", "target_book": "first_principles_spencer_1862", "target_name": "theory of Evolution", "similarity": 0.927}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolution", "target_book": "first_principles_spencer_1862", "target_name": "Evolutions", "similarity": 0.946}, {"source_book": "principles_of_psychology_james_1890", "source_name": "zoological evolution", "target_book": "kosmos_humboldt_1845", "target_name": "evolution", "similarity": 0.875}, {"source_book": "principles_of_psychology_james_1890", "source_name": "zoological evolution", "target_book": "first_principles_spencer_1862", "target_name": "theory of Evolution", "similarity": 0.858}, {"source_book": "principles_of_psychology_james_1890", "source_name": "zoological evolution", "target_book": "first_principles_spencer_1862", "target_name": "Evolutions", "similarity": 0.863}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolutionary", "target_book": "kosmos_humboldt_1845", "target_name": "evolution", "similarity": 0.964}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolutionary", "target_book": "kosmos_humboldt_1845", "target_name": "genetic evolution", "similarity": 0.858}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolutionary", "target_book": "first_principles_spencer_1862", "target_name": "theory of Evolution", "similarity": 0.918}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolutionary", "target_book": "first_principles_spencer_1862", "target_name": "Evolutions", "similarity": 0.934}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolutive changes", "target_book": "kosmos_humboldt_1845", "target_name": "evolution", "similarity": 0.911}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolutive changes", "target_book": "first_principles_spencer_1862", "target_name": "theory of Evolution", "similarity": 0.859}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolutive changes", "target_book": "first_principles_spencer_1862", "target_name": "Evolutions", "similarity": 0.917}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolutionary philosophy", "target_book": "kosmos_humboldt_1845", "target_name": "evolution", "similarity": 0.863}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolutionary philosophy", "target_book": "first_principles_spencer_1862", "target_name": "Evolutions", "similarity": 0.816}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolved", "target_book": "kosmos_humboldt_1845", "target_name": "evolution", "similarity": 0.893}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolved", "target_book": "first_principles_spencer_1862", "target_name": "Evolutions", "similarity": 0.851}, {"source_book": "kosmos_humboldt_1845", "source_name": "evolution", "target_book": "first_principles_spencer_1862", "target_name": "Geologic evolution", "similarity": 0.846}, {"source_book": "kosmos_humboldt_1845", "source_name": "evolution", "target_book": "first_principles_spencer_1862", "target_name": "theory of Evolution", "similarity": 0.927}, {"source_book": "kosmos_humboldt_1845", "source_name": "evolution", "target_book": "first_principles_spencer_1862", "target_name": "Evolutions", "similarity": 0.946}], "id": 213, "stable_key": "clu_884b3c7a947664a6", "ground_truth": {"modern_name": "Evolution", "confidence": "high", "type": "concept", "note": "The overwhelming frequency of 'Evolution' in Spencer's and James's works, along with the contexts 'biological change' and 'development across animal species,' clearly points to the scientific concept of evolution.", "wikidata_id": "Q4038411", "wikidata_description": "monthly scientific journal", "wikipedia_url": "https://en.wikipedia.org/wiki/Evolution%20%28journal%29", "wikipedia_extract": "Evolution is the change in the heritable characteristics of biological populations over successive generations. It occurs when evolutionary processes such as genetic drift and natural selection act on genetic variation, resulting in certain characteristics becoming more or less common within a population over successive generations. The process of evolution has given rise to biodiversity at every level of biological organisation. The scientific theory of evolution by natural selection was conceived independently by two British naturalists, Charles Darwin and Alfred Russel Wallace, in the mid-19th century as an explanation for why organisms are adapted to their physical and biological environments. The theory was first set out in detail in Darwin's book On the Origin of Species. Evolution by natural selection is established by observable facts about living organisms: (1) more offspring are often produced than can possibly survive; (2) traits vary among individuals with respect to their morphology, physiology, and behaviour; (3) different traits confer different rates of survival and reproduction (differential fitness); and (4) traits can be passed from generation to generation (heritability of fitness)."}}, {"canonical_name": "rins", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 123, "members": [{"entity_id": "rins", "book_id": "polyanthea_medicinal", "name": "rins", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 109, "variants": ["rins", "Rins", "os rins", "rins dehum homem", "rinsas"], "contexts": ["organ of the urinary system", "kidneys"]}, {"entity_id": "riñones", "book_id": "historia_medicinal_monardes_1574", "name": "riñones", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 6, "variants": ["riñones", "Riñones", "rinones"], "contexts": ["body part for which Cañafistola is good", "ailments of the kidneys"]}, {"entity_id": "rins", "book_id": "coloquios_da_orta_1563", "name": "rins", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 7, "variants": ["rins", "rijs"], "contexts": ["body part", "kidneys, body organs"]}, {"entity_id": "regiaó_dos_rins", "book_id": "polyanthea_medicinal", "name": "regiaó dos rins", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["regiaó dos rins"], "contexts": ["region of the kidneys"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "rins", "target_book": "historia_medicinal_monardes_1574", "target_name": "riñones", "similarity": 0.862}, {"source_book": "polyanthea_medicinal", "source_name": "rins", "target_book": "coloquios_da_orta_1563", "target_name": "rins", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "riñones", "target_book": "coloquios_da_orta_1563", "target_name": "rins", "similarity": 0.862}, {"source_book": "coloquios_da_orta_1563", "source_name": "rins", "target_book": "polyanthea_medicinal", "target_name": "regiaó dos rins", "similarity": 0.856}], "id": 214, "stable_key": "clu_0510e2737fca32bb", "ground_truth": {"modern_name": "Kidneys", "confidence": "high", "type": "substance", "description": "Organs of the urinary system responsible for filtering blood.", "wikipedia_extract": "In humans, the kidneys are two reddish-brown bean-shaped blood-filtering organs that are a multilobar, multipapillary form of mammalian kidneys, usually without signs of external lobulation. They are located on the left and right in the retroperitoneal space, and in adult humans are about 12 centimetres (4+1⁄2 inches) in length. They receive blood from the paired renal arteries; blood exits into the paired renal veins. Each kidney is attached to a ureter, a tube that carries excreted urine to the bladder. The kidney participates in the control of the volume of various body fluids, fluid osmolality, acid–base balance, various electrolyte concentrations, and removal of toxins. Filtration occurs in the glomerulus: one-fifth of the blood volume that enters the kidneys is filtered."}}, {"canonical_name": "bexiga", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 118, "members": [{"entity_id": "bexiga", "book_id": "polyanthea_medicinal", "name": "bexiga", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 108, "variants": ["bexiga", "Bexiga", "Nabexiga", "abexiga", "abexiga do fel", "abexiga dofel", "bexiga do fei", "bexiga do fel", "beſexiga", "nabexiga", "nabexigadofel"], "contexts": ["body part", "bladder"]}, {"entity_id": "bexiga", "book_id": "historia_medicinal_monardes_1574", "name": "bexiga", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["Bexiga", "bexiga"], "contexts": ["bladder, organ of the body", "bladder, where stones can cause burning"]}, {"entity_id": "bexiga", "book_id": "coloquios_da_orta_1563", "name": "bexiga", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["bexiga"], "contexts": ["Bladder, affected by sores", "body part treated with aloes"]}, {"entity_id": "bexiga_resfriada", "book_id": "polyanthea_medicinal", "name": "bexiga resfriada", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bexiga resfriada"], "contexts": ["cooled bladder"]}, {"entity_id": "bexiga_paralytica", "book_id": "polyanthea_medicinal", "name": "bexiga paralytica", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bexiga paralytica"], "contexts": ["paralytic bladder"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "bexiga", "target_book": "historia_medicinal_monardes_1574", "target_name": "bexiga", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "bexiga", "target_book": "coloquios_da_orta_1563", "target_name": "bexiga", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "bexiga", "target_book": "coloquios_da_orta_1563", "target_name": "bexiga", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "bexiga", "target_book": "polyanthea_medicinal", "target_name": "bexiga resfriada", "similarity": 0.818}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "bexiga", "target_book": "polyanthea_medicinal", "target_name": "bexiga paralytica", "similarity": 0.812}, {"source_book": "coloquios_da_orta_1563", "source_name": "bexiga", "target_book": "polyanthea_medicinal", "target_name": "bexiga resfriada", "similarity": 0.818}, {"source_book": "coloquios_da_orta_1563", "source_name": "bexiga", "target_book": "polyanthea_medicinal", "target_name": "bexiga paralytica", "similarity": 0.812}], "id": 215, "stable_key": "clu_7220dcde56a2c2ef", "ground_truth": {"modern_name": "Bladder", "confidence": "high", "type": "substance", "description": "An organ that stores urine.", "wikipedia_extract": "The bladder (from Old English  blædre 'bladder, blister, pimple') is a hollow organ in humans and other vertebrates that stores urine from the kidneys. In placental mammals, urine enters the bladder via the ureters and exits via the urethra during urination. In humans, the bladder is a distensible organ that sits on the pelvic floor. The typical adult human bladder will hold between 300 and 500 ml (10 and 17 fl oz) before the urge to empty occurs, but can hold considerably more. The Latin phrase for \"urinary bladder\" is vesica urinaria, and the term vesical or prefix vesico- appear in connection with associated structures such as vesical veins. The modern Latin word for \"bladder\" – cystis – appears in associated terms such as cystitis (inflammation of the bladder)."}}, {"canonical_name": "Wine", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 114, "members": [{"entity_id": "wine", "book_id": "english_physician_1652", "name": "Wine", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 101, "variants": ["Wine", "wine"], "contexts": ["used in decoction for serpent bites", "liquid used with seeds"]}, {"entity_id": "red_wine", "book_id": "english_physician_1652", "name": "red Wine", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 9, "variants": ["red Wine", "Red Wine", "red-Wine"], "contexts": ["liquid used for decoction", "liquid used with husks"]}, {"entity_id": "wine_lees", "book_id": "english_physician_1652", "name": "Wine Lees", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Wine Lees"], "contexts": ["substance added to birdlime mixture"]}, {"entity_id": "vino", "book_id": "coloquios_da_orta_1563", "name": "vino", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["vino"], "contexts": ["drink to take root with in winter"]}, {"entity_id": "wine", "book_id": "polyanthea_medicinal", "name": "wine", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["wine"], "contexts": ["generous, mixed with pepper"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Wine", "target_book": "coloquios_da_orta_1563", "target_name": "vino", "similarity": 0.967}, {"source_book": "english_physician_1652", "source_name": "Wine", "target_book": "polyanthea_medicinal", "target_name": "wine", "similarity": 0.993}, {"source_book": "english_physician_1652", "source_name": "red Wine", "target_book": "polyanthea_medicinal", "target_name": "wine", "similarity": 0.858}, {"source_book": "english_physician_1652", "source_name": "Wine Lees", "target_book": "polyanthea_medicinal", "target_name": "wine", "similarity": 0.812}, {"source_book": "coloquios_da_orta_1563", "source_name": "vino", "target_book": "polyanthea_medicinal", "target_name": "wine", "similarity": 0.977}], "id": 216, "stable_key": "clu_5503b86649ed71b2", "ground_truth": {"modern_name": "Wine", "confidence": "high", "type": "substance", "description": "An alcoholic beverage made from fermented grapes.", "note": "Includes different types of wine and by-products like wine lees.", "wikipedia_extract": "Wine is an alcoholic drink made from fermented grape juice. It is produced and consumed in many regions around the world, in a wide variety of styles which are influenced by different varieties of grapes, growing environments, viticulture methods, and production techniques. Wine has been produced for thousands of years, the earliest evidence dating from c. 6000 BCE in present-day Georgia. Its popularity spread around the Mediterranean during Classical antiquity, and was sustained in Western Europe by winemaking monks and a secular trade for general drinking. New World wine was established by settler colonies from the 16th century onwards, and the wine trade increased dramatically up to the latter half of the 19th century, when European vineyards were largely destroyed by the invasive pest phylloxera. After the Second World War, the wine market improved dramatically as winemakers focused on quality and marketing to cater for a more discerning audience, and wine remains a popular drink in much of the world."}}, {"canonical_name": "espiritos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 105, "members": [{"entity_id": "espiritos", "book_id": "polyanthea_medicinal", "name": "espiritos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 88, "variants": ["espiritos", "espirito", "espirito animaes", "espiritos animues", "espiritos azedos", "espiritos dos gãos lenfitivos", "espiritos flatuosos", "espiritos naturaes", "espiritos vitaes", "espiritos vitais", "espiritos volateis", "espiritosanimaes", "espíritos", "eſpiritos", "fpiritus", "spirits"], "contexts": ["spirits", "vital forces, affected by disease"]}, {"entity_id": "spirits", "book_id": "english_physician_1652", "name": "Spirits", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 16, "variants": ["spirits", "Spirits"], "contexts": ["bodily essence comforted by Angelica", "quickened by the herb"]}, {"entity_id": "espiritus", "book_id": "historia_medicinal_monardes_1574", "name": "espiritus", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["espiritus"], "contexts": ["bodily essence Ambar can improve"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "espiritos", "target_book": "english_physician_1652", "target_name": "Spirits", "similarity": 0.956}, {"source_book": "polyanthea_medicinal", "source_name": "espiritos", "target_book": "historia_medicinal_monardes_1574", "target_name": "espiritus", "similarity": 0.966}, {"source_book": "english_physician_1652", "source_name": "Spirits", "target_book": "historia_medicinal_monardes_1574", "target_name": "espiritus", "similarity": 0.964}], "id": 217, "stable_key": "clu_4e2fd8a5d49d1eb3", "ground_truth": {"modern_name": "Vital spirits", "confidence": "high", "type": "concept", "description": "In humoral theory, the animating essence of the body, responsible for life and function.", "note": "This refers to the ancient and medieval concept of vital spirits, a fundamental part of humoral medicine, distinct from modern understanding of biological processes.", "wikipedia_extract": "Vitalism is an idea that living organisms are differentiated from the non-living by the presence of forces, properties or powers including those which may not be physical  or chemical. Varied forms of vitalist theories were held in former times and they are now considered pseudoscientific concepts. Where vitalism explicitly invokes a vital principle, that element is often referred to as the \"vital spark\", \"energy\", \"élan vital\" (coined by vitalist Henri Bergson), \"vital force\", or \"vis vitalis\", which some equate with the soul. In the 18th and 19th centuries, vitalism was discussed among biologists, between those belonging to the mechanistic school who felt that the known mechanics of physics would eventually explain the difference between life and non-life and vitalists who argued that the processes of life could not be reduced to a mechanistic process. Vitalist biologists such as Johannes Reinke proposed testable hypotheses meant to show inadequacies with mechanistic explanations, but their experiments failed to provide support for vitalism. Biologists now consider vitalism in this sense to have been refuted by empirical evidence, and hence regard it either as a superseded scientific theory, or as a pseudoscience since the mid-20th century."}}, {"canonical_name": "Eyes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 104, "members": [{"entity_id": "eyes", "book_id": "english_physician_1652", "name": "Eyes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 69, "variants": ["Eyes", "Eyelids", "Eyesight", "eyes"], "contexts": ["organ helped by Angelica juice/water", "organ affected by defluxions"]}, {"entity_id": "olhos", "book_id": "coloquios_da_orta_1563", "name": "olhos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["olhos"], "contexts": ["broken in illness"]}, {"entity_id": "olhos", "book_id": "polyanthea_medicinal", "name": "olhos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 34, "variants": ["olhos", "Olhos", "olho"], "contexts": ["eyes", "body part affected by fluxion"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Eyes", "target_book": "coloquios_da_orta_1563", "target_name": "olhos", "similarity": 0.96}, {"source_book": "english_physician_1652", "source_name": "Eyes", "target_book": "polyanthea_medicinal", "target_name": "olhos", "similarity": 0.96}, {"source_book": "coloquios_da_orta_1563", "source_name": "olhos", "target_book": "polyanthea_medicinal", "target_name": "olhos", "similarity": 1.0}], "id": 218, "stable_key": "clu_3885853a7791c596", "ground_truth": {"modern_name": "Eyes", "confidence": "high", "type": "object", "description": "The organs of sight in humans and animals.", "wikipedia_extract": "An eye is a sensory organ that allows an organism to perceive visual information. It detects light and converts it into electro-chemical impulses in neurons (neurones). It is part of an organism's visual system. In higher organisms, the eye is a complex optical system that collects light from the surrounding environment, regulates its intensity through a diaphragm, focuses it through an adjustable assembly of lenses to form an image, converts this image into a set of electrical signals, and transmits these signals to the brain through neural pathways that connect the eye via the optic nerve to the visual cortex and other areas of the brain. Eyes with resolving power have come in ten fundamentally different forms, classified into compound eyes and non-compound eyes. Compound eyes are made up of multiple small visual units, and are common on insects and crustaceans."}}, {"canonical_name": "colica", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 3, "total_mentions": 104, "members": [{"entity_id": "colica", "book_id": "polyanthea_medicinal", "name": "colica", "category": "DISEASE", "subcategory": "CHRONIC", "count": 100, "variants": ["colica", "Colic", "Colica", "Colica Nephritica", "Colica biliofa", "Colicas", "colica Nephritica", "colica Pictonica", "colica flatulenta", "colica fleymatica", "colica nephritica", "colicas", "colicas Ictericas", "colicas Nephriticas", "colicas Nepo", "colicas biliofas", "colicas flatuotas", "colicas nephriticas", "colicasNephriticas", "colicis"], "contexts": ["disease dependent on stomach", "colic"]}, {"entity_id": "colica", "book_id": "historia_medicinal_monardes_1574", "name": "Colica", "category": "DISEASE", "subcategory": "CHRONIC", "count": 3, "variants": ["colica", "Colica"], "contexts": ["colic, a type of abdominal pain", "colic, a type of illness"]}, {"entity_id": "cólica", "book_id": "coloquios_da_orta_1563", "name": "cólica", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["cólica"], "contexts": ["colic, treated with coconut"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "colica", "target_book": "historia_medicinal_monardes_1574", "target_name": "Colica", "similarity": 0.99}, {"source_book": "polyanthea_medicinal", "source_name": "colica", "target_book": "coloquios_da_orta_1563", "target_name": "cólica", "similarity": 0.855}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Colica", "target_book": "coloquios_da_orta_1563", "target_name": "cólica", "similarity": 0.875}], "id": 219, "stable_key": "clu_5c630d01b3e36ba4", "ground_truth": {"modern_name": "Colic", "confidence": "high", "type": "disease", "description": "Severe abdominal pain, often associated with the digestive system.", "wikipedia_extract": "Colic or cholic () is a form of pain that starts and stops abruptly. Colic pain is usually caused by the obstruction of a smooth muscle passageway in the body (e.g. the small or large intestine, bile duct, or ureter). The obstruction triggers muscular contractions (peristalsis) to force the blockage out of the organ, resulting in episodic pain that fluctuates with the contractions. Although the term primarily refers to pain caused by this mechanism, any pain which occurs in episodes or fluctuates in intensity may be termed colic or colicky pain. Colic episodes can cause extreme pain, nausea, sweating, and vomiting. The blockage of important passageways in the body can lead to severe and potentially fatal complications if not cleared, such as cholecystitis in the case of biliary colic, or in kidney stone disease."}}, {"canonical_name": "Asthma", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 3, "total_mentions": 97, "members": [{"entity_id": "asthma", "book_id": "polyanthea_medicinal", "name": "Asthma", "category": "DISEASE", "subcategory": "CHRONIC", "count": 90, "variants": ["Asthma", "Afma", "Afthma", "Afthmas", "Afthmaticos", "Asma", "Asthimas", "Asthm.", "Asthmas", "Asthmati", "afma", "asma", "asmas", "asthma", "asthmas", "aſthmas"], "contexts": ["condition treated by bloodletting", "respiratory condition causing difficulty breathing"]}, {"entity_id": "astmatick", "book_id": "english_physician_1652", "name": "Astmatick", "category": "DISEASE", "subcategory": "CHRONIC", "count": 6, "variants": ["Astmatick"], "contexts": ["suffering from asthma", "condition of shortness of breath"]}, {"entity_id": "asma", "book_id": "coloquios_da_orta_1563", "name": "asma", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["asma"], "contexts": ["respiratory illness treated with anacardo"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Asthma", "target_book": "english_physician_1652", "target_name": "Astmatick", "similarity": 0.94}, {"source_book": "polyanthea_medicinal", "source_name": "Asthma", "target_book": "coloquios_da_orta_1563", "target_name": "asma", "similarity": 0.952}, {"source_book": "english_physician_1652", "source_name": "Astmatick", "target_book": "coloquios_da_orta_1563", "target_name": "asma", "similarity": 0.912}], "id": 220, "stable_key": "clu_1a5775e66a84b8a8", "ground_truth": {"modern_name": "Asthma", "confidence": "high", "type": "disease", "description": "A chronic respiratory condition causing difficulty in breathing.", "wikipedia_extract": "Asthma is a common long-term inflammatory disease of the airways. It is characterized by variable and recurring symptoms and reduced lung function. Symptoms include episodes of wheezing, coughing, chest tightness, and shortness of breath. A sudden worsening of asthma symptoms sometimes called an 'asthma attack' or an 'asthma exacerbation' can occur when allergens, pollen, dust, or other particles, are inhaled into the lungs, causing the bronchioles to constrict and produce mucus, which then restricts oxygen flow to the alveoli. These may occur a few times a day or a few times per week. Depending on the person, asthma symptoms may become worse at night or with exercise."}}, {"canonical_name": "Carthagène", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 94, "members": [{"entity_id": "carthagène", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Carthagène", "category": "PLACE", "subcategory": "CITY", "count": 90, "variants": ["Carthagène", "Carlbagène", "Carlhagène", "Carlhogène", "Cartagena", "Carthagene", "Carthago", "Carthagène des", "Carthagène des Indes", "Carthagène des Iodes", "Carthagènes", "Carthagènes des Indes", "Carthagéne", "Cartliagcne", "Cartliagène", "Garthagène"], "contexts": ["city", "city mentioned with province of Quito"]}, {"entity_id": "carthage", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Carthage", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Carthage"], "contexts": ["city whose gates were battered"]}, {"entity_id": "carthage", "book_id": "kosmos_humboldt_1845", "name": "Carthage", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Carthage"], "contexts": ["location of hot springs phenomenon", "location of hot springs"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Carthagène", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Carthage", "similarity": 0.869}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Carthagène", "target_book": "kosmos_humboldt_1845", "target_name": "Carthage", "similarity": 0.869}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Carthage", "target_book": "kosmos_humboldt_1845", "target_name": "Carthage", "similarity": 1.0}], "id": 221, "stable_key": "clu_3f73f7eef3e0b314", "ground_truth": {"modern_name": "Carthage", "confidence": "high", "type": "place", "country": "Tunisia", "note": "The spelling 'Carthagène' is an archaic French rendering of Carthage.", "wikidata_id": "Q976381", "wikidata_description": "city in and county seat of Panola County, Texas, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Carthage%2C%20Texas", "wikipedia_extract": "Carthage (Arabic: قرطاج, ) was an ancient city in Northern Africa, on the eastern side of the Lake of Tunis in what is now Tunisia. Carthage was one of the most important trading hubs of the Ancient Mediterranean and one of the most affluent cities of the classical world. It became the capital city of the civilization of Ancient Carthage and later Roman Carthage. The city developed from a Phoenician colony into the capital of a Punic empire which dominated large parts of the Southwest Mediterranean during the first millennium BC. The legendary Queen Elissa, Alyssa or Dido, originally from Tyre, is regarded as the founder of the city, though her historicity has been questioned. In the myth, Dido asked for land from a local tribe, which told her that she could get as much land as an oxhide could cover."}}, {"canonical_name": "Manias", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 3, "total_mentions": 93, "members": [{"entity_id": "manias", "book_id": "polyanthea_medicinal", "name": "Manias", "category": "DISEASE", "subcategory": "CHRONIC", "count": 59, "variants": ["Manias", "Maniacos", "Maniamultos", "Manía", "Manías", "maniacos", "manias"], "contexts": ["chapter title about manias", "mania"]}, {"entity_id": "madness", "book_id": "english_physician_1652", "name": "Madness", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["Madness"], "contexts": ["dwels where Reason does not", "disease listed with numbers"]}, {"entity_id": "mania", "book_id": "principles_of_psychology_james_1890", "name": "mania", "category": "DISEASE", "subcategory": "PSYCHOLOGICAL", "count": 2, "variants": ["mania"], "contexts": ["state of elevated mood and energy", "mental disorder characterized by excitement"]}, {"entity_id": "mania", "book_id": "polyanthea_medicinal", "name": "Mania", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 30, "variants": ["Mania", "Maniacap", "Maniaco", "Manian", "Manicas", "Maníacos", "Manîas", "mania", "maniaco"], "contexts": ["mental illness", "a mental illness"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Manias", "target_book": "english_physician_1652", "target_name": "Madness", "similarity": 0.907}, {"source_book": "principles_of_psychology_james_1890", "source_name": "mania", "target_book": "polyanthea_medicinal", "target_name": "Mania", "similarity": 0.862}], "id": 222, "stable_key": "clu_a9ee0f691914a87c", "ground_truth": {"modern_name": "Mania", "confidence": "high", "type": "disease", "description": "A mental disorder characterized by elevated mood, energy, and excitement.", "note": "Includes broader historical concepts of madness and mental derangement.", "wikipedia_extract": "Mania ( MAIN-ee-yah; also known as manic syndrome) is a psychiatric behavioral syndrome defined as a state of abnormally elevated arousal, affect, and energy level. During a manic episode, an individual will experience rapidly changing emotions and moods, highly influenced by surrounding stimuli. Although mania is often conceived of as a \"mirror image\" to depression, the heightened mood can be dysphoric as well as euphoric. As the mania intensifies, irritability can be more pronounced and result in anxiety or anger. The symptoms of mania include elevated mood (either euphoric or irritable), flight of ideas, pressure of speech, increased energy, decreased \"need\" and desire for sleep, and hyperactivity. They are most plainly evident in fully developed hypomanic states, however, in full-blown mania, these symptoms become progressively exacerbated."}}, {"canonical_name": "Amazone", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 84, "members": [{"entity_id": "amazone", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Amazone", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 72, "variants": ["Amazone", "AMAZONES", "Amazones", "l'Amazone"], "contexts": ["river in South America", "river basin reached by Caribes"]}, {"entity_id": "rivière_des_amazones", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rivière des Amazones", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["Rivière des Amazones", "RIVIÈRE DES AMAZONES", "Riviere des Amazones", "rivière de Hudson", "rivière de l'Amazone", "rivière des Amazones", "rivière des Illinois"], "contexts": ["River explored by Pinson", "river in South America"]}, {"entity_id": "amazon", "book_id": "kosmos_humboldt_1845", "name": "Amazon", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Amazon"], "contexts": ["river in South America"]}, {"entity_id": "river_amazons", "book_id": "connexion_physical_sciences_somerville_1858", "name": "river Amazons", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["river Amazons"], "contexts": ["river with woody regions"]}, {"entity_id": "amazons", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Amazons", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Amazons"], "contexts": ["river with perceptible tides and forests"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Amazone", "target_book": "kosmos_humboldt_1845", "target_name": "Amazon", "similarity": 0.919}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Amazone", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "river Amazons", "similarity": 0.914}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Amazone", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Amazons", "similarity": 0.972}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rivière des Amazones", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "river Amazons", "similarity": 0.927}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rivière des Amazones", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Amazons", "similarity": 0.889}, {"source_book": "kosmos_humboldt_1845", "source_name": "Amazon", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Amazons", "similarity": 0.923}], "id": 223, "stable_key": "clu_0d600c7b60e13ab2", "ground_truth": {"modern_name": "Amazon River", "confidence": "high", "type": "place", "country": "Brazil", "note": "The French 'Amazone' and 'Rivière des Amazones' directly translate to Amazon and River of the Amazons.", "wikidata_id": "Q205329", "wikidata_description": "species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Amazon%20river%20dolphin", "wikipedia_extract": "The Amazon River (UK: , US: ; Portuguese: rio Amazonas, Spanish: río Amazonas) in South America is the largest river by discharge volume of water in the world, and the longest or second-longest river system in the world, a title which is disputed with the Nile. The headwaters of the Apurímac River on Nevado Mismi had been considered, for nearly a century, the Amazon basin's most distant source until a 2014 study found it to be the headwaters of the Mantaro River on the Cordillera Rumi Cruz in Peru. The Mantaro and Apurímac rivers join, and with other tributaries form the Ucayali River, which in turn meets the Marañón River upstream of Iquitos, Peru, forming what countries other than Brazil consider to be the main stem of the Amazon. Brazilians call this section the Solimões River above its confluence with the Rio Negro forming what Brazilians call the Amazon at the Meeting of Waters (Portuguese: Encontro das Águas) at Manaus, the largest city on the river. The Amazon River has an average discharge of about 215,000–230,000 m3/s (7,600,000–8,100,000 cu ft/s)—approximately 6,591–7,570 km3 (1,581–1,816 cu mi) per year, greater than the next seven largest independent rivers combined. Two of the top ten rivers by discharge are tributaries of the Amazon river."}}, {"canonical_name": "tumor", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 82, "members": [{"entity_id": "tumor", "book_id": "polyanthea_medicinal", "name": "tumor", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 59, "variants": ["tumor", "Tumor", "Tumoreflatuoso", "otumor", "tumor dos olhos", "tumor dosolhos", "tumorde", "tumordo cerebro", "tumordos olhos", "tumore", "tumorem", "tumores", "tumores capitis puerorum", "tumores dos lagrimaes", "tumores duros", "tumores preternaturaes", "tumores ſcirrhofos", "tumoresduros", "tumorespeſtilentes", "tumorofa", "tumorſplenis"], "contexts": ["tumor, a growth", "swelling"]}, {"entity_id": "tumors", "book_id": "english_physician_1652", "name": "Tumors", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 22, "variants": ["Tumors", "tumors"], "contexts": ["dissolved by the yellow Archangel", "condition helped by fried herb"]}, {"entity_id": "tumor", "book_id": "principles_of_psychology_james_1890", "name": "tumor", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["tumor"], "contexts": ["abnormal growth in tissue"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "tumor", "target_book": "english_physician_1652", "target_name": "Tumors", "similarity": 0.963}, {"source_book": "polyanthea_medicinal", "source_name": "tumor", "target_book": "principles_of_psychology_james_1890", "target_name": "tumor", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Tumors", "target_book": "principles_of_psychology_james_1890", "target_name": "tumor", "similarity": 0.963}], "id": 224, "stable_key": "clu_d25d692b25d2d5b8", "ground_truth": {"modern_name": "tumor", "confidence": "high", "type": "disease", "description": "An abnormal growth or swelling of tissue in the body.", "wikipedia_extract": "A neoplasm () is a type of abnormal and excessive growth of tissue. The process that occurs to form or produce a neoplasm is called neoplasia. The growth of a neoplasm is uncoordinated with that of the normal surrounding tissue, and persists in growing abnormally, even if the original trigger is removed. This abnormal growth usually forms a mass, which may be called a tumour or tumor. ICD-10 classifies neoplasms into four main groups: benign neoplasms, in situ neoplasms, malignant neoplasms, and neoplasms of uncertain or unknown behavior. Malignant neoplasms are also simply known as cancers and are the focus of oncology."}}, {"canonical_name": "coraçao", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 78, "members": [{"entity_id": "coraçao", "book_id": "polyanthea_medicinal", "name": "coraçao", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 72, "variants": ["coraçao", "coracao", "coraçaó", "coraçaõ", "coraçaō", "coração"], "contexts": ["body part", "heart"]}, {"entity_id": "corazon", "book_id": "historia_medicinal_monardes_1574", "name": "corazon", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["corazon", "corazón"], "contexts": ["organ of the body", "heart"]}, {"entity_id": "coração", "book_id": "coloquios_da_orta_1563", "name": "coração", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["coração"], "contexts": ["body part that amber benefits"]}, {"entity_id": "coraçam", "book_id": "coloquios_da_orta_1563", "name": "coraçam", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["coraçam"], "contexts": ["body part to be cooled"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "coraçao", "target_book": "historia_medicinal_monardes_1574", "target_name": "corazon", "similarity": 0.921}, {"source_book": "polyanthea_medicinal", "source_name": "coraçao", "target_book": "coloquios_da_orta_1563", "target_name": "coração", "similarity": 0.921}, {"source_book": "polyanthea_medicinal", "source_name": "coraçao", "target_book": "coloquios_da_orta_1563", "target_name": "coraçam", "similarity": 0.938}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "corazon", "target_book": "coloquios_da_orta_1563", "target_name": "coração", "similarity": 0.925}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "corazon", "target_book": "coloquios_da_orta_1563", "target_name": "coraçam", "similarity": 0.862}], "id": 225, "stable_key": "clu_0c20f31a5aae2b4e", "ground_truth": {"modern_name": "heart", "confidence": "high", "type": "anatomy", "description": "The central organ of the circulatory system.", "note": "The term 'coraçao' is Portuguese for heart.", "wikipedia_extract": "The heart is a muscular organ found in humans and other animals. This organ pumps blood through the blood vessels. The heart and blood vessels together make up the circulatory system. The pumped blood carries oxygen and nutrients to the tissue, while carrying metabolic waste such as carbon dioxide to the lungs. In humans, the heart is approximately the size of a closed fist and is located between the lungs, in the middle compartment of the chest, called the mediastinum. In humans, the heart is divided into four chambers: upper left and right atria and lower left and right ventricles."}}, {"canonical_name": "unguento", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 75, "members": [{"entity_id": "unguento", "book_id": "polyanthea_medicinal", "name": "unguento", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 69, "variants": ["unguento", "Unguento acquirido", "Unguento fingular", "UnguentoArmario", "Unguentoda Condeça", "Unguentos", "migalha de unguento Aureo", "unguento Alabastrino", "unguento Aureo", "unguento Roſado", "unguento Sandalino", "unguento branco", "unguento confortativo", "unguento da Condeça", "unguento daCondeça", "unguento de Althea", "unguento de Aragão", "unguento de chumbo", "unguento de chumbode almofariz", "unguento de ras", "unguento deAlsa", "unguento dedialthea", "unguento do baço", "unguento peytoral", "unguento populcaó", "unguento populeao", "unguento populeo", "unguento refrigerante", "unguento refumptivo", "unguento reſumptivo", "unguento rofado", "unguento rosado", "unguento roſado", "unguento sandolino", "unguentoApoftolorum", "unguentoArmario", "unguentoRotadoduas", "unguentoalvo canforado", "unguentoda Condeça", "unguentodaCondeça", "unguentode Althea", "unguentode chumbo", "unguentopopuleaō", "unguentos"], "contexts": ["an ointment remedy", "ointment for sores"]}, {"entity_id": "unguentos", "book_id": "historia_medicinal_monardes_1574", "name": "unguentos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["unguentos", "unguento"], "contexts": ["ointments for treating ailments", "preparations in apothecaries"]}, {"entity_id": "unguenti", "book_id": "ricettario_fiorentino_1597", "name": "unguenti", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["unguenti"], "contexts": ["ointments, a type of compound medicine", "ointments"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "unguento", "target_book": "historia_medicinal_monardes_1574", "target_name": "unguentos", "similarity": 0.905}, {"source_book": "polyanthea_medicinal", "source_name": "unguento", "target_book": "ricettario_fiorentino_1597", "target_name": "unguenti", "similarity": 0.981}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "unguentos", "target_book": "ricettario_fiorentino_1597", "target_name": "unguenti", "similarity": 0.9}], "id": 226, "stable_key": "clu_66b4713e3a62a735", "ground_truth": {"modern_name": "ointment", "confidence": "high", "type": "preparation", "description": "A semi-solid medicinal preparation for external application.", "note": "The term 'unguento' is Italian for ointment.", "wikipedia_extract": "A topical medication is a medication that is applied to a particular place on or in the body. Most often topical medication means application to body surfaces such as the skin or mucous membranes to treat ailments via a large range of classes including creams, foams, gels, lotions, and ointments. Many topical medications are epicutaneous, meaning that they are applied directly to the skin. Topical medications may also be inhalational, such as asthma medications, or applied to the surface of tissues other than the skin, such as eye drops applied to the conjunctiva, or ear drops placed in the ear, or medications applied to the surface of a tooth. The word topical derives from Greek τοπικός topikos, \"of a place\". Topical drug delivery is a route of administering drugs via the skin to provide topical therapeutic effects."}}, {"canonical_name": "lombrigas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 72, "members": [{"entity_id": "lombrigas", "book_id": "polyanthea_medicinal", "name": "lombrigas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 56, "variants": ["lombrigas", "Lombrigas", "as lombricas", "lombri-", "lombrias", "lombricagas", "lombriga", "lombrigas Afcaridas", "lonmbrigas"], "contexts": ["condition treated by remedy", "worms"]}, {"entity_id": "llagas", "book_id": "historia_medicinal_monardes_1574", "name": "llagas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 7, "variants": ["llagas", "llaga", "llagas podridas", "llagas viejas"], "contexts": ["old sores", "sores that Ceuadilla cleans"]}, {"entity_id": "lombrigas", "book_id": "coloquios_da_orta_1563", "name": "lombrigas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["lombrigas"], "contexts": ["Worms, treated with medicine", "treated with anacardo"]}, {"entity_id": "lumbrígas", "book_id": "coloquios_da_orta_1563", "name": "lumbrígas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["lumbrígas", "lumbrí-gas"], "contexts": ["ailment treated by pao da cobra", "ailment treated by a plant"]}, {"entity_id": "lombrigas_torradas_como_carvão", "book_id": "polyanthea_medicinal", "name": "lombrigas torradas como carvão", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["lombrigas torradas como carvão"], "contexts": ["worms expelled by patient"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "lombrigas", "target_book": "historia_medicinal_monardes_1574", "target_name": "llagas", "similarity": 0.87}, {"source_book": "polyanthea_medicinal", "source_name": "lombrigas", "target_book": "coloquios_da_orta_1563", "target_name": "lombrigas", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "lombrigas", "target_book": "coloquios_da_orta_1563", "target_name": "lumbrígas", "similarity": 0.868}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "llagas", "target_book": "coloquios_da_orta_1563", "target_name": "lombrigas", "similarity": 0.87}, {"source_book": "coloquios_da_orta_1563", "source_name": "lombrigas", "target_book": "polyanthea_medicinal", "target_name": "lombrigas torradas como carvão", "similarity": 0.817}], "id": 227, "stable_key": "clu_20bf3ab40c523722", "ground_truth": {"modern_name": "worms", "confidence": "high", "type": "disease", "description": "Intestinal parasites causing ailments.", "note": "The terms 'lombrigas' and 'lumbrígas' are Portuguese for worms.", "wikipedia_extract": "Parasitic worms, also known as helminths, are a polyphyletic group of large macroparasites; adults can generally be seen with the naked eye. Many are intestinal worms that are soil-transmitted and infect the gastrointestinal tract. Other parasitic worms such as  schistosomes reside in blood vessels. Some parasitic worms, including leeches and monogeneans, are ectoparasites –  thus, they are not classified as helminths, which are endoparasites. Parasitic worms live in and feed in living hosts. They receive nourishment and protection while disrupting their hosts' ability to absorb nutrients."}}, {"canonical_name": "Panama", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 68, "members": [{"entity_id": "panama", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Panama", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 54, "variants": ["Panama"], "contexts": ["province in South America", "city with population 50,000"]}, {"entity_id": "panama", "book_id": "origin_of_species_darwin_1859", "name": "Panama", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Panama"], "contexts": ["impassable isthmus separating faunas"]}, {"entity_id": "isthme_de_panama", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Isthme de Panama", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 10, "variants": ["Isthme de Panama", "isthme de Panama"], "contexts": ["isthmus parallel to the Antilles", "geographic landform"]}, {"entity_id": "pemba", "book_id": "coloquios_da_orta_1563", "name": "Pemba", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Pemba"], "contexts": ["African island with cloves", "island on the African coast"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Panama", "target_book": "origin_of_species_darwin_1859", "target_name": "Panama", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Panama", "target_book": "coloquios_da_orta_1563", "target_name": "Pemba", "similarity": 0.845}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Panama", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Isthme de Panama", "similarity": 0.852}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Panama", "target_book": "coloquios_da_orta_1563", "target_name": "Pemba", "similarity": 0.845}], "id": 228, "stable_key": "clu_3023bc3f0a2d1276", "ground_truth": {"modern_name": "Panama", "confidence": "high", "type": "place", "description": "Isthmus and province in Central America.", "note": "Includes both the geographical isthmus and the historical region/city.", "wikipedia_extract": "Panama, officially the Republic of Panama, is a country located at the southern end of Central America, bordering South America. It is bordered by Costa Rica to the west, Colombia to the southeast, the Caribbean Sea to the north, and the Pacific Ocean to the south. Its capital and largest city is Panama City, whose metropolitan area is home to nearly half of the country's over 4 million inhabitants. Before the arrival of Spanish colonists in the 16th century, Panama was inhabited by a number of different indigenous tribes. It broke away from Spain in 1821 and joined the Republic of Gran Colombia, a union of Nueva Granada, Ecuador, and Venezuela. After Gran Colombia dissolved in 1831, Panama and Nueva Granada eventually became the Republic of Colombia."}}, {"canonical_name": "piastres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 67, "members": [{"entity_id": "piastres", "book_id": "relation_historique_humboldt_vol3_1825", "name": "piastres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 65, "variants": ["piastres", "piast", "piast.", "piastre", "piastre forte", "piastres fortes"], "contexts": ["monetary unit for indigo value", "monetary unit"]}, {"entity_id": "plaster", "book_id": "principles_of_psychology_james_1890", "name": "plaster", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["plaster"], "contexts": ["material that can set"]}, {"entity_id": "piasters", "book_id": "kosmos_humboldt_1845", "name": "piasters", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["piasters"], "contexts": ["currency unit"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "piastres", "target_book": "principles_of_psychology_james_1890", "target_name": "plaster", "similarity": 0.873}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "piastres", "target_book": "kosmos_humboldt_1845", "target_name": "piasters", "similarity": 0.979}, {"source_book": "principles_of_psychology_james_1890", "source_name": "plaster", "target_book": "kosmos_humboldt_1845", "target_name": "piasters", "similarity": 0.857}], "id": 229, "stable_key": "clu_bdd1982d539d349b", "ground_truth": {"modern_name": "piastre", "confidence": "low", "type": "object", "description": "A monetary unit, historically used in various regions.", "note": "While 'piastres' is a monetary unit, 'plaster' is a material. The contexts are disparate.", "wikipedia_extract": "The piastre or piaster (English:  ) is any of a number of units of currency. The term originates from the Italian for \"thin metal plate\". The name was applied to Spanish and Hispanic American pieces of eight, or pesos, by Venetian traders in the Levant in the 16th century. These pesos, minted continually for centuries, were readily accepted by traders in many parts of the world. After the countries of Latin America had gained independence, pesos of Mexico began flowing in through the trade routes, and became prolific in the Far East, taking the place of the Spanish pieces of eight which had been introduced by the Spanish at Manila, and by the Portuguese at Malacca. When the French colonised Indochina, they began issuing the new French Indochinese piastre (piastre de commerce), which was equal in value to the familiar Spanish and Mexican pesos."}}, {"canonical_name": "August", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 63, "members": [{"entity_id": "august", "book_id": "english_physician_1652", "name": "August", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 50, "variants": ["August"], "contexts": ["month for flowering", "month of the year"]}, {"entity_id": "agosto", "book_id": "polyanthea_medicinal", "name": "Agosto", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 12, "variants": ["Agosto"], "contexts": ["herb used in remedies", "month for harvesting jarro root"]}, {"entity_id": "august", "book_id": "connexion_physical_sciences_somerville_1858", "name": "August", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["August"], "contexts": ["month of observation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "August", "target_book": "polyanthea_medicinal", "target_name": "Agosto", "similarity": 0.97}, {"source_book": "english_physician_1652", "source_name": "August", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "August", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Agosto", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "August", "similarity": 0.97}], "id": 230, "stable_key": "clu_4d14b9ee89ebd428", "ground_truth": {"modern_name": "August", "confidence": "high", "type": "concept", "description": "The eighth month of the Gregorian calendar, associated with agricultural cycles.", "note": "Both terms refer to the month of August, with contexts related to agricultural and medicinal practices.", "wikipedia_extract": "August is the eighth month of the year in the Julian and Gregorian calendars. Its length is 31 days. In the Southern Hemisphere, August is the seasonal equivalent of February in the Northern Hemisphere. In the Northern Hemisphere, August falls in summer. In the Southern Hemisphere, the month falls during winter. In many European countries, August is the holiday month for most workers."}}, {"canonical_name": "1822", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 62, "members": [{"entity_id": "1822", "book_id": "relation_historique_humboldt_vol3_1825", "name": "1822", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 57, "variants": ["1822", "1682", "1782", "1792", "1800", "1801", "1806", "1807", "1809", "1810", "1811", "1813", "1815", "1817", "1818", "1820", "1821", "1826", "1827", "1829"], "contexts": ["year of observation", "year"]}, {"entity_id": "march,_1822", "book_id": "kosmos_humboldt_1845", "name": "March, 1822", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["March, 1822"], "contexts": ["start date of noise on Meleda"]}, {"entity_id": "1832", "book_id": "connexion_physical_sciences_somerville_1858", "name": "1832", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["1832"], "contexts": ["year a comet caused alarm", "year of a meteoric shower"]}, {"entity_id": "1842", "book_id": "connexion_physical_sciences_somerville_1858", "name": "1842", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["1842"], "contexts": ["year of book publication"]}, {"entity_id": "1833", "book_id": "connexion_physical_sciences_somerville_1858", "name": "1833", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["1833"], "contexts": ["year of a spectacular meteoric shower"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "1822", "target_book": "kosmos_humboldt_1845", "target_name": "March, 1822", "similarity": 0.867}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "1822", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "1832", "similarity": 0.881}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "1822", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "1842", "similarity": 0.87}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "1822", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "1833", "similarity": 0.841}], "id": 231, "stable_key": "clu_6b80b98c545ec3db", "ground_truth": {"modern_name": "1822", "confidence": "high", "type": "concept", "note": "The majority of mentions refer to the year 1822, with a few outliers (1832, 1842, 1833) likely being separate observations or data points.", "wikidata_id": "Q105777612", "wikidata_description": "set of Public Acts of Parliament of the United Kingdom passed in 1822", "wikipedia_extract": "1822 (MDCCCXXII) was a common year starting on Tuesday of the Gregorian calendar and a common year starting on Sunday of the Julian calendar, the 1822nd year of the Common Era (CE) and Anno Domini (AD) designations, the 822nd  year of the 2nd millennium, the 22nd  year of the 19th century, and the  3rd   year of the 1820s decade. As of the start of 1822, the Gregorian calendar was 12 days ahead of the Julian calendar, which remained in localized use until 1923. January 1 – The Greek Constitution of 1822 is adopted by the First National Assembly at Epidaurus. January 3 – The famous French explorer, Aimé Bonpland, is imprisoned in Paraguay on charges of espionage. January 7 – The first freed slaves from the United States arrive on the west coast of Africa, founding Monrovia on April 25. January 9 – The Portuguese prince Pedro I of Brazil decides to stay in Brazil against the orders of the Portugal's King João VI, beginning the Brazilian independence process."}}, {"canonical_name": "Floride", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 56, "members": [{"entity_id": "floride", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Floride", "category": "PLACE", "subcategory": "COUNTRY", "count": 42, "variants": ["Floride", "Floride occidentale", "Florides"], "contexts": ["geographical region", "northern extremity connected to South America"]}, {"entity_id": "florida", "book_id": "historia_medicinal_monardes_1574", "name": "Florida", "category": "PLACE", "subcategory": "COUNTRY", "count": 12, "variants": ["Florida"], "contexts": ["land in the Western Indies", "region where Saissasfras tree is found"]}, {"entity_id": "florida", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Florida", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Florida"], "contexts": ["region mentioned in relation to Gulf-stream"]}, {"entity_id": "florida", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Florida", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Florida"], "contexts": ["region affected by storm curve"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Floride", "target_book": "historia_medicinal_monardes_1574", "target_name": "Florida", "similarity": 0.942}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Florida", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Florida", "similarity": 1.0}], "id": 232, "stable_key": "clu_e069c91ac1a0251b", "ground_truth": {"modern_name": "Florida", "confidence": "high", "type": "place", "description": "A region in the southeastern United States, historically explored.", "note": "The spelling 'Floride' is a historical variant.", "wikipedia_extract": "Florida (  FLORR-ih-də; Spanish: [floˈɾiða] ) is a state in the Southeastern and South Atlantic regions of the United States. It borders the Gulf of Mexico to the west, Alabama to the northwest, Georgia to the north, the Atlantic Ocean to the east, the Straits of Florida to the south, and The Bahamas to the southeast. About two-thirds of Florida occupies a peninsula between the Gulf of Mexico and the Atlantic Ocean. It has the longest coastline in the contiguous United States, spanning approximately 1,350 miles (2,170 km), not including its many barrier islands. It is the only state that borders both the Gulf of Mexico and the Atlantic Ocean. With a population of over 23 million, it is the third-most populous state in the United States and ranks seventh in population density as of 2020."}}, {"canonical_name": "Madrid", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 54, "members": [{"entity_id": "madrid", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Madrid", "category": "PLACE", "subcategory": "CITY", "count": 45, "variants": ["Madrid"], "contexts": ["city where Portulano was published", "city name"]}, {"entity_id": "new-madrid", "book_id": "relation_historique_humboldt_vol3_1825", "name": "New-Madrid", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["New-Madrid"], "contexts": ["location of mounds"]}, {"entity_id": "new_madrid", "book_id": "kosmos_humboldt_1845", "name": "New Madrid", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["New Madrid"], "contexts": ["location in Missouri, USA", "location of hot steam ejection"]}, {"entity_id": "madrid", "book_id": "kosmos_humboldt_1845", "name": "Madrid", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Madrid"], "contexts": ["court of Madrid"]}, {"entity_id": "madrid", "book_id": "coloquios_da_orta_1563", "name": "Madrid", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Madrid"], "contexts": ["city where book was published", "city of publication"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Madrid", "target_book": "kosmos_humboldt_1845", "target_name": "New Madrid", "similarity": 0.863}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Madrid", "target_book": "kosmos_humboldt_1845", "target_name": "Madrid", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Madrid", "target_book": "coloquios_da_orta_1563", "target_name": "Madrid", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "New-Madrid", "target_book": "kosmos_humboldt_1845", "target_name": "New Madrid", "similarity": 0.949}, {"source_book": "kosmos_humboldt_1845", "source_name": "New Madrid", "target_book": "coloquios_da_orta_1563", "target_name": "Madrid", "similarity": 0.863}, {"source_book": "kosmos_humboldt_1845", "source_name": "Madrid", "target_book": "coloquios_da_orta_1563", "target_name": "Madrid", "similarity": 1.0}], "id": 233, "stable_key": "clu_873aed685508f355", "ground_truth": {"modern_name": "Madrid", "confidence": "high", "type": "PLACE", "description": "Capital city of Spain, a significant location in historical texts.", "wikipedia_extract": "Madrid is the capital and most populous city of Spain. It had a population of over 3.4 million in the city proper in 2025, and a metropolitan area population of approximately 6.8 million. Madrid is the second-largest city in the European Union (EU), after Berlin, and its metropolitan area is the second-largest in the EU, after Paris. The municipality covers an area of 605.77 km2 (233.89 sq mi). Madrid lies on the River Manzanares in the central part of the Iberian Peninsula at about 660 m (2,170 ft) above mean sea level. The capital city of both Spain and the surrounding autonomous community of Madrid, it is the political, economic and cultural centre of the country."}}, {"canonical_name": "Bengala", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 53, "members": [{"entity_id": "bengala", "book_id": "coloquios_da_orta_1563", "name": "Bengala", "category": "PLACE", "subcategory": "REGION", "count": 47, "variants": ["Bengala", "Bengal", "Bengalla", "Bengallas", "bengala"], "contexts": ["region where herva-babosa is abundant", "place of origin for substances"]}, {"entity_id": "bengal", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bengal", "category": "PLACE", "subcategory": "COUNTRY", "count": 5, "variants": ["Bengal", "Bengale"], "contexts": ["presidency", "region in India"]}, {"entity_id": "bengal", "book_id": "kosmos_humboldt_1845", "name": "Bengal", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Bengal"], "contexts": ["service of Mr. Batten"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Bengala", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Bengal", "similarity": 0.87}, {"source_book": "coloquios_da_orta_1563", "source_name": "Bengala", "target_book": "kosmos_humboldt_1845", "target_name": "Bengal", "similarity": 0.984}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bengal", "target_book": "kosmos_humboldt_1845", "target_name": "Bengal", "similarity": 0.882}], "id": 234, "stable_key": "clu_b195188043ebba8a", "ground_truth": {"modern_name": "Bengal", "confidence": "high", "type": "place", "description": "A region in the eastern part of the Indian subcontinent.", "wikipedia_extract": "Bengal ( ben-GAWL) is a geographical, ethnolinguistic, historically geopolitical region in South Asia, located north of the Bay of Bengal. Today, it is politically divided between the sovereign state of Bangladesh, the Indian state of West Bengal, and Karimganj district in the Indian state of Assam. The ancient Vanga Kingdom is widely regarded as the namesake of the Bengal region. The Bengali calendar dates back to the reign of Shashanka in the 7th century CE. The Pala Empire was founded in Bengal during the 8th century. The Sena dynasty and Deva dynasty ruled between the 11th and 13th centuries."}}, {"canonical_name": "Santiago de Cuba", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 53, "members": [{"entity_id": "santiago_de_cuba", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Santiago de Cuba", "category": "PLACE", "subcategory": "CITY", "count": 49, "variants": ["Santiago de Cuba", "La ciudad de Santiago de Cuba", "Sa>tiago DE Cuba", "Sanliagu de Cuba", "Santiago", "Santiago = de Cuba", "Santiago de Chili", "Santiago de CiU^a", "Santiago de Cul)a", "Santiago de Culîa", "Santiago de d'uba"], "contexts": ["city in Cuba", "city on Cuba"]}, {"entity_id": "santiago", "book_id": "historia_medicinal_monardes_1574", "name": "Santiago", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Santiago"], "contexts": ["city where events were witnessed"]}, {"entity_id": "santiago_de_guayasquil", "book_id": "historia_medicinal_monardes_1574", "name": "Santiago de Guayasquil", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Santiago de Guayasquil"], "contexts": ["city name"]}, {"entity_id": "cuba", "book_id": "coloquios_da_orta_1563", "name": "Cuba", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Cuba"], "contexts": ["island where guaiacam grows", "offered gold and incense"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Santiago de Cuba", "target_book": "historia_medicinal_monardes_1574", "target_name": "Santiago", "similarity": 0.876}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Santiago de Cuba", "target_book": "historia_medicinal_monardes_1574", "target_name": "Santiago de Guayasquil", "similarity": 0.853}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Santiago de Cuba", "target_book": "coloquios_da_orta_1563", "target_name": "Cuba", "similarity": 0.863}], "id": 235, "stable_key": "clu_dc7b4d8938f1b165", "ground_truth": {"modern_name": "Santiago de Cuba", "confidence": "high", "type": "place", "description": "A city and municipality in southeastern Cuba.", "note": "Includes 'Cuba' in contexts where it refers to the city or its vicinity, and also 'Santiago de Guayasquil' as a distinct city name.", "wikipedia_extract": "Santiago de Cuba (Spanish pronunciation: [sanˈtjaɣo ðe ˈkuβa]) is the second-largest city in Cuba and the capital city of Santiago de Cuba Province. It lies in the southeastern area of the island, some 870 km (540 mi) southeast of the Cuban capital of Havana. The municipality extends over 1,023.8 km2 (395.3 sq mi), and contains the communities of Antonio Maceo, Bravo, Castillo Duany, Daiquirí, El Caney, El Cobre, El Cristo, Guilera, Leyte Vidal, Moncada and Siboney. Historically Santiago de Cuba has been the second-most important city on the island after Havana, and remains the second-largest. It lies on a bay connected to the Caribbean Sea and is an important sea port. In 2022, the city of Santiago de Cuba recorded a population of 507,167 people."}}, {"canonical_name": "Loadstone", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 50, "members": [{"entity_id": "loadstone", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Loadstone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 42, "variants": ["Loadstone"], "contexts": ["mineral with magnetic properties", "magnetic stone"]}, {"entity_id": "loadstones", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Loadstones", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["Loadstones"], "contexts": ["magnetic stones affecting needles", "laid long time in Quicksilver"]}, {"entity_id": "loadstone", "book_id": "kosmos_humboldt_1845", "name": "loadstone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["loadstone"], "contexts": ["naturally magnetic rock", "naturally magnetized iron ore"]}, {"entity_id": "loadstones", "book_id": "kosmos_humboldt_1845", "name": "loadstones", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["loadstones"], "contexts": ["natural magnets"]}, {"entity_id": "loadstone", "book_id": "connexion_physical_sciences_somerville_1858", "name": "loadstone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["loadstone"], "contexts": ["naturally paramagnetic iron ore"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Loadstone", "target_book": "kosmos_humboldt_1845", "target_name": "loadstone", "similarity": 0.971}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Loadstone", "target_book": "kosmos_humboldt_1845", "target_name": "loadstones", "similarity": 0.965}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Loadstone", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "loadstone", "similarity": 0.971}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Loadstones", "target_book": "kosmos_humboldt_1845", "target_name": "loadstone", "similarity": 0.951}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Loadstones", "target_book": "kosmos_humboldt_1845", "target_name": "loadstones", "similarity": 0.976}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Loadstones", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "loadstone", "similarity": 0.951}, {"source_book": "kosmos_humboldt_1845", "source_name": "loadstone", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "loadstone", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "loadstones", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "loadstone", "similarity": 0.982}], "id": 236, "stable_key": "clu_addd4bb36496acf9", "ground_truth": {"modern_name": "Lodestone", "confidence": "high", "type": "mineral", "wikidata_id": "Q3480938", "wikidata_description": "naturally magnetized mineral, magnetite variety", "wikipedia_url": "https://en.wikipedia.org/wiki/Lodestone", "wikipedia_extract": "Lodestones are naturally magnetized pieces of the mineral magnetite. They are naturally occurring magnets, which can attract iron. The property of magnetism was first discovered in antiquity through lodestones. Pieces of lodestone, suspended so they could turn, were the first magnetic compasses, and their importance to early navigation is indicated by the name lodestone, which in Middle English means \"course stone\" or \"leading stone\", from the now-obsolete meaning of lode as \"journey, way\". Lodestone is one of only a very few minerals that is found naturally magnetized. Magnetite is black or brownish-black with a black streak, with a metallic luster and a Mohs hardness of 5.5–6.5."}}, {"canonical_name": "terças", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 3, "total_mentions": 47, "members": [{"entity_id": "terças", "book_id": "polyanthea_medicinal", "name": "terças", "category": "DISEASE", "subcategory": "ACUTE", "count": 29, "variants": ["terças", "Terçás", "terça", "terça Nota", "terçans", "terças continuas", "terças dobles", "terçás", "terçãs"], "contexts": ["fever affecting a child", "fevers occurring every third day"]}, {"entity_id": "tertian_agues", "book_id": "english_physician_1652", "name": "Tertian Agues", "category": "DISEASE", "subcategory": "ACUTE", "count": 12, "variants": ["Tertian Agues", "Tertian", "Tertian Ague", "Tertians"], "contexts": ["ague removed by the herb", "fever cured by the herb"]}, {"entity_id": "tercianas", "book_id": "historia_medicinal_monardes_1574", "name": "Tercianas", "category": "DISEASE", "subcategory": "ACUTE", "count": 6, "variants": ["Tercianas", "Teracianas", "Tercianas nothas", "terciana"], "contexts": ["tertian fevers", "fevers that were importunate"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "terças", "target_book": "english_physician_1652", "target_name": "Tertian Agues", "similarity": 0.846}, {"source_book": "polyanthea_medicinal", "source_name": "terças", "target_book": "historia_medicinal_monardes_1574", "target_name": "Tercianas", "similarity": 0.895}, {"source_book": "english_physician_1652", "source_name": "Tertian Agues", "target_book": "historia_medicinal_monardes_1574", "target_name": "Tercianas", "similarity": 0.932}], "id": 237, "stable_key": "clu_44ae045b76c9e581", "ground_truth": {"modern_name": "Tertian Fever", "confidence": "high", "type": "disease", "description": "A fever characterized by recurring chills and heats every third day.", "note": "Specifically refers to fevers with a 48-hour cycle, often malaria.", "wikipedia_extract": "The history of malaria extends from its prehistoric origin as a zoonotic disease in the primates of Africa through to the 21st century. A widespread and potentially lethal human infectious disease, at its peak malaria infested every continent except Antarctica. Its prevention and treatment have been targeted in science and medicine for hundreds of years. Since the discovery of the Plasmodium parasites which cause it, research attention has focused on their biology as well as that of the mosquitoes which transmit the parasites. References to its unique, periodic fevers are found throughout recorded history, beginning in the first millennium BC in Greece and China. For thousands of years, traditional herbal remedies have been used to treat malaria."}}, {"canonical_name": "Sierra Nevada de Merida", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 47, "members": [{"entity_id": "sierra_nevada_de_merida", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sierra Nevada de Merida", "category": "PLACE", "subcategory": "REGION", "count": 36, "variants": ["Sierra Nevada de Merida", "SIERRA NEVADA DE MERIDA", "Sierra NevacLa de Mérida", "Sierra Nevada de Cochabamba", "Sierra Nevada de Santa Maria", "Sierra Nevada deSanla Maria", "Sierra de Merida", "Sierra de Santa Marta", "Sierra de Santa-Marta", "Sierra nevada de Merida", "Sierra nevada de Santa Maria"], "contexts": ["mountain range bordering the Llanos", "mountain range in Llanos basin"]}, {"entity_id": "sierra_nevada", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sierra Nevada", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Sierra Nevada", "SIERRA NEVADA", "Sierru Nevada"], "contexts": ["mountain range in South America", "mountain range"]}, {"entity_id": "sierra", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sierra", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Sierra"], "contexts": ["mountainous region", "mountainous part of Cuba"]}, {"entity_id": "sierra_nevada_de_santa_maria", "book_id": "kosmos_humboldt_1845", "name": "Sierra Nevada de Santa Maria", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Sierra Nevada de Santa Maria"], "contexts": ["mountain in which River Gaira originates", "mountain range in South America"]}, {"entity_id": "sierra", "book_id": "kosmos_humboldt_1845", "name": "Sierra", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Sierra"], "contexts": ["mountainous region in Mexico"]}, {"entity_id": "sierra_ne", "book_id": "historia_medicinal_monardes_1574", "name": "Sierra Ne", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Sierra Ne"], "contexts": ["mountain region where snow is found"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sierra Nevada de Merida", "target_book": "kosmos_humboldt_1845", "target_name": "Sierra Nevada de Santa Maria", "similarity": 0.891}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sierra Nevada", "target_book": "kosmos_humboldt_1845", "target_name": "Sierra Nevada de Santa Maria", "similarity": 0.828}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sierra Nevada", "target_book": "kosmos_humboldt_1845", "target_name": "Sierra", "similarity": 0.811}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sierra Nevada", "target_book": "historia_medicinal_monardes_1574", "target_name": "Sierra Ne", "similarity": 0.863}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sierra", "target_book": "kosmos_humboldt_1845", "target_name": "Sierra", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sierra", "target_book": "historia_medicinal_monardes_1574", "target_name": "Sierra Ne", "similarity": 0.833}, {"source_book": "kosmos_humboldt_1845", "source_name": "Sierra", "target_book": "historia_medicinal_monardes_1574", "target_name": "Sierra Ne", "similarity": 0.833}], "id": 238, "stable_key": "clu_89bfe44f4c856193", "ground_truth": {"modern_name": "Sierra Nevada", "confidence": "high", "type": "place", "description": "Mountain range, often associated with snow.", "note": "Refers to a mountain range, particularly the one in South America, or generally mountainous regions.", "wikipedia_extract": "The Sierra Nevada ( see-ERR-ə nih-VA(H)D-ə) is a mountain range in the Western United States, between the Central Valley of California and the Great Basin. The vast majority of the range lies in the state of California, although the Carson Range spur lies primarily in Nevada. The Sierra Nevada is part of the American Cordillera, an almost continuous chain of mountain ranges that forms the western \"backbone\" of the Americas. The Sierra runs 400 mi (640 km) north-south, and its width ranges from 50 mi (80 km) to 80 mi (130 km) across east–west. Notable features include the General Sherman Tree, the largest tree in the world by volume; Lake Tahoe, the largest alpine lake in North America; Mount Whitney at 14,505 ft (4,421 m), the highest point in the contiguous United States; and Yosemite Valley sculpted by glaciers from one-hundred-million-year-old granite, containing high waterfalls. The Sierra is home to three national parks, twenty-six wilderness areas, ten national forests, and two national monuments."}}, {"canonical_name": "Elleboro negro", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 46, "members": [{"entity_id": "elleboro_negro", "book_id": "polyanthea_medicinal", "name": "Elleboro negro", "category": "PLANT", "subcategory": "PLANT", "count": 39, "variants": ["Elleboro negro", "Elleboro", "Elleboro branco", "Elleborum", "elleborismo", "elleboro", "elleboro branco", "elleboro negro", "elleborobranco", "raiz de elleboro negro", "raizes de elleboro negro", "raizesde Elleboro negro"], "contexts": ["root used in a preparation", "black hellebore root for tobacco remedy"]}, {"entity_id": "eleboro_negro", "book_id": "historia_medicinal_monardes_1574", "name": "Eleboro negro", "category": "PLANT", "subcategory": "ROOT", "count": 1, "variants": ["Eleboro negro"], "contexts": ["black hellebore root"]}, {"entity_id": "elleboro_nero", "book_id": "ricettario_fiorentino_1597", "name": "Elleboro nero", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["Elleboro nero", "ELLEBORO NERO", "Elleboro", "ellebori", "elleboro"], "contexts": ["black hellebore", "black hellebore, a medicinal herb"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Elleboro negro", "target_book": "historia_medicinal_monardes_1574", "target_name": "Eleboro negro", "similarity": 0.868}, {"source_book": "polyanthea_medicinal", "source_name": "Elleboro negro", "target_book": "ricettario_fiorentino_1597", "target_name": "Elleboro nero", "similarity": 0.894}], "id": 239, "stable_key": "clu_fc40a8f82c935fb8", "ground_truth": {"modern_name": "Black Hellebore", "confidence": "high", "type": "plant", "description": "A poisonous plant (Helleborus niger) with medicinal uses, especially its root.", "note": "Commonly referred to as 'Elleboro negro' or 'Eleboro negro'.", "wikipedia_extract": "Veratrum nigrum, the black false hellebore, is a widespread Eurasian species of perennial flowering plant in the family Melanthiaceae. Despite its common name, V. nigrum is not closely related to the true hellebores, nor does it resemble them. The plant was widely known even in ancient times. For example, Lucretius (ca. 99 BCE – ca. 55 BCE) and Pliny the Elder (23 AD – August 25, 79) both knew of its medicinal emetic as well as deadly toxic properties. Veratrum nigrum is native to Eurasia from France to Korea including Germany, Poland, Russia, China, and Mongolia. The plant can exist in hardiness zones 4 through 7."}}, {"canonical_name": "Lima", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 45, "members": [{"entity_id": "lima", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Lima", "category": "PLACE", "subcategory": "CITY", "count": 33, "variants": ["Lima"], "contexts": ["city in Peru", "capital of Peru"]}, {"entity_id": "lima", "book_id": "kosmos_humboldt_1845", "name": "Lima", "category": "PLACE", "subcategory": "CITY", "count": 9, "variants": ["Lima"], "contexts": ["capital of Peru", "city near magnetic equator intersection"]}, {"entity_id": "lima", "book_id": "historia_medicinal_monardes_1574", "name": "Lima", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Lima"], "contexts": ["city where the letter was written", "city in Peru"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lima", "target_book": "kosmos_humboldt_1845", "target_name": "Lima", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lima", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lima", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Lima", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lima", "similarity": 1.0}], "id": 240, "stable_key": "clu_233ef58496bf7dbe", "ground_truth": {"modern_name": "Lima", "confidence": "high", "type": "place", "description": "Capital city of Peru, located on the Pacific coast.", "wikipedia_extract": "Lima is the capital and largest city of Peru. It is located in the valleys of the Chillón, Rímac and Lurín Rivers, in the desert zone of the central coastal part of the country, overlooking the Pacific Ocean. The city is considered the political, cultural, financial and commercial center of Peru. Due to its geostrategic importance, the Globalization and World Cities Research Network has categorized it as a \"beta\" tier city. Jurisdictionally, the metropolis extends mainly within the province of Lima and in a smaller portion, to the west, within the Constitutional Province of Callao, where the seaport and the Jorge Chávez Airport are located. Both provinces have had regional autonomy since 2002."}}, {"canonical_name": "calamo aromático", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 43, "members": [{"entity_id": "calamo_aromático", "book_id": "coloquios_da_orta_1563", "name": "calamo aromático", "category": "PLANT", "subcategory": "PLANT", "count": 19, "variants": ["Calamo aromático", "calamo aromático", "CALAMO AROMÁTICO"], "contexts": ["plant with strong smell", "aromatic reed"]}, {"entity_id": "calamo", "book_id": "coloquios_da_orta_1563", "name": "calamo", "category": "PLANT", "subcategory": "PLANT", "count": 5, "variants": ["calamo", "Calamus"], "contexts": ["plant name", "aromatic reed, main subject of discussion"]}, {"entity_id": "calamo_aromatico", "book_id": "ricettario_fiorentino_1597", "name": "calamo aromatico", "category": "PLANT", "subcategory": "ROOT", "count": 17, "variants": ["calamo aromatico", "CaUmo aromatico", "Calamo aromat", "Calamo aromati", "Calamo aromatico", "Calamo aroo", "Calamo odorato", "Calamoaromat"], "contexts": ["aromatic reed similar to Acoro", "aromatic reed of spices"]}, {"entity_id": "calamo_aromatico", "book_id": "polyanthea_medicinal", "name": "calamo aromatico", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["calamo aromatico"], "contexts": ["spice used in a syrup", "used in confection"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "calamo aromático", "target_book": "ricettario_fiorentino_1597", "target_name": "calamo aromatico", "similarity": 0.882}, {"source_book": "coloquios_da_orta_1563", "source_name": "calamo aromático", "target_book": "polyanthea_medicinal", "target_name": "calamo aromatico", "similarity": 0.979}, {"source_book": "coloquios_da_orta_1563", "source_name": "calamo", "target_book": "polyanthea_medicinal", "target_name": "calamo aromatico", "similarity": 0.813}, {"source_book": "ricettario_fiorentino_1597", "source_name": "calamo aromatico", "target_book": "polyanthea_medicinal", "target_name": "calamo aromatico", "similarity": 0.889}], "id": 241, "stable_key": "clu_fbd25dc3e074c601", "ground_truth": {"modern_name": "Sweet Flag", "confidence": "high", "type": "plant", "description": "An aromatic reed plant (Acorus calamus) used as a spice and in medicine.", "note": "Known for its aromatic properties and medicinal applications.", "wikipedia_extract": "Acorus calamus (also called sweet flag, sway or muskrat root, among many other common names) is a species of flowering plant with psychoactive chemicals. It is a tall wetland monocot of the family Acoraceae, in the genus Acorus. Although used in traditional medicine over centuries to treat digestive disorders and pain, it has no clinical evidence of safety or efficacy and may be toxic if ingested, and so has been commercially banned for use in food in the United States. Sweet flag is a herbaceous perennial, 2 m (79 in) tall. Its leaves resemble those of the iris family. Sweet flag consists of tufts of basal leaves that rise from a spreading rhizome."}}, {"canonical_name": "Cassiquiare", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 42, "members": [{"entity_id": "cassiquiare", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cassiquiare", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 32, "variants": ["Cassiquiare", "Cassi-quiare", "Cassiqiiiare", "Casslquiare"], "contexts": ["geographic location", "forests mentioned as a starting point"]}, {"entity_id": "fuerle_de_cassiquiare", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Fuerle de Cassiquiare", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Fuerle de Cassiquiare"], "contexts": ["fort on the Cassiquiare"]}, {"entity_id": "cassiopeia", "book_id": "kosmos_humboldt_1845", "name": "Cassiopeia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Cassiopeia"], "contexts": ["constellation with a star", "constellation region in the Milky Way"]}, {"entity_id": "cassiquiare", "book_id": "kosmos_humboldt_1845", "name": "Cassiquiare", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Cassiquiare"], "contexts": ["river branch in South America", "dreary banks where natives use terms"]}, {"entity_id": "cassiopeia", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cassiopeia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Cassiopeia"], "contexts": ["constellation where a star appeared", "astronomical constellation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cassiquiare", "target_book": "kosmos_humboldt_1845", "target_name": "Cassiopeia", "similarity": 0.843}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cassiquiare", "target_book": "kosmos_humboldt_1845", "target_name": "Cassiquiare", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cassiquiare", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cassiopeia", "similarity": 0.843}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Fuerle de Cassiquiare", "target_book": "kosmos_humboldt_1845", "target_name": "Cassiquiare", "similarity": 0.852}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cassiopeia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cassiopeia", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cassiquiare", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cassiopeia", "similarity": 0.843}], "id": 242, "stable_key": "clu_318aa765ecbffa51", "ground_truth": {"modern_name": "Cassiquiare River", "confidence": "medium", "type": "place", "country": "Venezuela", "note": "Most mentions refer to the Cassiquiare River, but 'Cassiopeia' is a constellation, suggesting a mix of entities or OCR errors.", "wikipedia_extract": "The Casiquiare river or canal (Spanish pronunciation: [kasiˈkjaɾe]) is a natural distributary of the upper Orinoco flowing southward into the Rio Negro in Venezuela. As such, it forms a unique natural canal between the Orinoco and Amazon river systems. It is the world's largest river of the kind that links two major river systems, a so-called bifurcation. The area forms a water divide, more dramatically at regional flood stage. The name Casiquiare, first used in that form by Manuel Román, likely derives from the Ye'kuana language name of the river, Kashishiwadi. The first European to describe it was Spanish Jesuit missionary and explorer Cristóbal Diatristán de Acuña in 1639.", "wikipedia_url": "https://en.wikipedia.org/wiki/Casiquiare_canal"}}, {"canonical_name": "Decoction", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 39, "members": [{"entity_id": "decoction", "book_id": "english_physician_1652", "name": "Decoction", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 36, "variants": ["Decoction", "Decoctions", "De∣coction", "decoction"], "contexts": ["preparation made from Alder-Tree leaves", "liquid made by boiling"]}, {"entity_id": "deconzioni", "book_id": "ricettario_fiorentino_1597", "name": "deconzioni", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["deconzioni"], "contexts": ["decoctions prepared for medicine"]}, {"entity_id": "decotti", "book_id": "ricettario_fiorentino_1597", "name": "decotti", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["decotti"], "contexts": ["decoctions, a type of compound medicine"]}, {"entity_id": "decocoufas", "book_id": "polyanthea_medicinal", "name": "Decocoufas", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Decocoufas"], "contexts": ["decoction preparation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Decoction", "target_book": "ricettario_fiorentino_1597", "target_name": "deconzioni", "similarity": 0.868}, {"source_book": "english_physician_1652", "source_name": "Decoction", "target_book": "ricettario_fiorentino_1597", "target_name": "decotti", "similarity": 0.866}, {"source_book": "english_physician_1652", "source_name": "Decoction", "target_book": "polyanthea_medicinal", "target_name": "Decocoufas", "similarity": 0.855}], "id": 243, "stable_key": "clu_b90099611b20cd45", "ground_truth": {"modern_name": "Decoction", "confidence": "high", "type": "substance", "description": "Liquid preparation made by boiling plant or other materials.", "note": "Refers to medicinal preparations made by boiling.", "wikipedia_extract": "Decoction is a method of extraction by boiling herbal or plant material (which may include stems, roots, bark and rhizomes) to dissolve the chemicals of the material. It is the most common preparation method in various herbal medicine systems. Decoction involves first drying the plant material; then mashing, slicing, or cutting the material to allow for maximum dissolution; and finally boiling in water to extract oils, volatile organic compounds and other various chemical substances. Occasionally, aqueous ethanol or glycerol may be used instead of water. Decoction can be used to make tisanes, tinctures and similar solutions. Decoctions and infusions may produce liquids with differing chemical properties, as the temperature or preparation difference may result in more oil-soluble chemicals in decoctions versus infusions."}}, {"canonical_name": "epithimo", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 38, "members": [{"entity_id": "epithimo", "book_id": "polyanthea_medicinal", "name": "epithimo", "category": "PLANT", "subcategory": "PLANT", "count": 17, "variants": ["epithimo", "Epitimo", "Epitome", "epitimo", "epitome"], "contexts": ["herb used in a syrup", "dodder, a parasitic plant used medicinally"]}, {"entity_id": "epithimum", "book_id": "english_physician_1652", "name": "Epithimum", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Epithimum"], "contexts": ["true dodder of time", "herb praised by physicians"]}, {"entity_id": "epithymo", "book_id": "ricettario_fiorentino_1597", "name": "Epithymo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 10, "variants": ["Epithymo", "EPITHYMO", "Epahymo", "Epithymio", "Epithynio", "Epitnymo"], "contexts": ["herb mentioned", "plant similar to Cuscuta"]}, {"entity_id": "epitimo", "book_id": "ricettario_fiorentino_1597", "name": "epitimo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["epitimo", "Epichymo", "Epirnymo", "Epitbymo", "Epithimo", "Epithymoi", "Epitymo", "epithym-"], "contexts": ["herb used in purgatives", "herb"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "epithimo", "target_book": "english_physician_1652", "target_name": "Epithimum", "similarity": 0.935}, {"source_book": "polyanthea_medicinal", "source_name": "epithimo", "target_book": "ricettario_fiorentino_1597", "target_name": "Epithymo", "similarity": 0.886}, {"source_book": "polyanthea_medicinal", "source_name": "epithimo", "target_book": "ricettario_fiorentino_1597", "target_name": "epitimo", "similarity": 0.85}, {"source_book": "english_physician_1652", "source_name": "Epithimum", "target_book": "ricettario_fiorentino_1597", "target_name": "Epithymo", "similarity": 0.883}], "id": 244, "stable_key": "clu_b383b5424609e434", "ground_truth": {"modern_name": "Cuscuta epithymum", "confidence": "high", "type": "plant", "linnaean": "Cuscuta epithymum", "family": "Convolvulaceae", "description": "A parasitic herb, also known as dodder, used medicinally.", "note": "Commonly referred to as 'dodder'.", "wikipedia_extract": "Cuscuta epithymum (dodder, lesser dodder, hellweed, strangle-tare) is a parasitic plant assigned to the family Cuscutaceae or Convolvulaceae, depending on the taxonomy. It is red-pigmented, not being photosynthetically active. It has a filiform habit, like a group of yarns. Its leaves are very small, like flakes. Its flowers, disposed in little glomerules, have a white corolla, with the androecium welded to the corolla. In Eurasia, this species of dodder would often attach itself to the Conehead thyme (Thymus capitatus), taking on the plant's pungency."}}, {"canonical_name": "acrimonia", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 38, "members": [{"entity_id": "acrimonia", "book_id": "polyanthea_medicinal", "name": "acrimonia", "category": "CONCEPT", "subcategory": "QUALITY", "count": 36, "variants": ["acrimonia", "acrimoniada", "acrimoniado", "acrimoniado sangue", "acrimoniaurine"], "contexts": ["sharpness or bitterness", "acridity"]}, {"entity_id": "acrimonia", "book_id": "historia_medicinal_monardes_1574", "name": "acrimonia", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["acrimonia"], "contexts": ["quality of the Saissasfras bark"]}, {"entity_id": "acrimonia", "book_id": "coloquios_da_orta_1563", "name": "acrimonia", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["acrimonia"], "contexts": ["quality of sharpness"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "acrimonia", "target_book": "historia_medicinal_monardes_1574", "target_name": "acrimonia", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "acrimonia", "target_book": "coloquios_da_orta_1563", "target_name": "acrimonia", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "acrimonia", "target_book": "coloquios_da_orta_1563", "target_name": "acrimonia", "similarity": 1.0}], "id": 245, "stable_key": "clu_5be36632f508b90d", "ground_truth": {"modern_name": "acridity", "confidence": "high", "type": "concept", "description": "A sharp, biting, or acrid taste or smell; pungency.", "note": "Refers to a sensory quality of sharpness or bitterness.", "wikipedia_extract": "Humorism, the humoral theory, or humoralism, was a system of medicine detailing a supposed makeup and workings of the human body, adopted by Ancient Greek and Roman physicians and philosophers. Humorism began to fall out of favor in the 17th century and it was definitively disproved with the discovery of microbes. The concept of \"humors\" may have origins in Ancient Egyptian medicine, or Mesopotamia, though it was not systemized until ancient Greek thinkers. The word humor is a translation of Greek χυμός, chymos (literally 'juice' or 'sap', metaphorically 'flavor'). Early texts on Indian Ayurveda medicine presented a theory of three or four humors (doṣas), which they sometimes linked with the five elements (pañca-bhūta): earth, water, fire, air, and space. The concept of \"humors\" (chemical systems regulating human behaviour) became more prominent from the writing of medical theorist Alcmaeon of Croton (c. 540–500 BC)."}}, {"canonical_name": "Bombaim", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 37, "members": [{"entity_id": "bombaim", "book_id": "coloquios_da_orta_1563", "name": "Bombaim", "category": "PLACE", "subcategory": "CITY", "count": 27, "variants": ["Bombaim", "Bombay", "Bombaym"], "contexts": ["location of bazaars", "city name"]}, {"entity_id": "bombay", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bombay", "category": "PLACE", "subcategory": "CITY", "count": 7, "variants": ["Bombay"], "contexts": ["city with high rainfall", "city in torrid zone"]}, {"entity_id": "mombaim", "book_id": "coloquios_da_orta_1563", "name": "Mombaim", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Mombaim", "Mombaça"], "contexts": ["city and island with better areca", "city on African coast with Baneanes"]}, {"entity_id": "mombaça", "book_id": "polyanthea_medicinal", "name": "Mombaça", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Mombaça"], "contexts": ["origin of snake stone"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Bombaim", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Bombay", "similarity": 0.97}, {"source_book": "coloquios_da_orta_1563", "source_name": "Mombaim", "target_book": "polyanthea_medicinal", "target_name": "Mombaça", "similarity": 0.894}], "id": 246, "stable_key": "clu_822c08ceb124f125", "ground_truth": {"modern_name": "Bombay", "confidence": "high", "type": "place", "description": "A major port city in India, historically a center of trade.", "note": "Includes historical spellings like 'Bombaim' and a potential confusion with Mombasa.", "wikipedia_extract": "Mumbai ( muum-BY; Marathi: Mumbaī, pronounced [ˈmumbəi] ), also known as Bombay ( bom-BAY; its official name until 1995), is the capital city of the Indian state of Maharashtra. Mumbai is the financial capital and the most populous city proper of India, with an estimated population of 12.5 million (1.25 crore). Mumbai is the centre of the Mumbai Metropolitan Region, which is among the most populous metropolitan areas in the world with a population of over 23 million (2.3 crore). Mumbai lies on the Konkan coast on the west coast of India and has a deep natural harbour. In 2008, Mumbai was named a alpha world city. Mumbai has the highest number of billionaires out of any city in Asia."}}, {"canonical_name": "melancholicos", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 37, "members": [{"entity_id": "melancholicos", "book_id": "polyanthea_medicinal", "name": "melancholicos", "category": "CONCEPT", "subcategory": "QUALITY", "count": 19, "variants": ["melancholicos", "Melancholicos", "melancholico", "melancolico"], "contexts": ["people with melancholy", "afflictions of melancholic nature"]}, {"entity_id": "melancólicos", "book_id": "coloquios_da_orta_1563", "name": "melancólicos", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["melancólicos"], "contexts": ["temperament of elephants"]}, {"entity_id": "melancolicos", "book_id": "polyanthea_medicinal", "name": "Melancolicos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 15, "variants": ["Melancolicos", "melancolicos"], "contexts": ["melancholic humors", "disease of melancholy"]}, {"entity_id": "melancholico", "book_id": "historia_medicinal_monardes_1574", "name": "Melancholico", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Melancholico"], "contexts": ["humoral quality, melancholic"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "melancholicos", "target_book": "coloquios_da_orta_1563", "target_name": "melancólicos", "similarity": 0.951}, {"source_book": "polyanthea_medicinal", "source_name": "Melancolicos", "target_book": "historia_medicinal_monardes_1574", "target_name": "Melancholico", "similarity": 0.943}], "id": 247, "stable_key": "clu_937b6b7595d18aa4", "ground_truth": {"modern_name": "melancholic", "confidence": "high", "type": "concept", "description": "Relating to or characterized by melancholy; a humoral imbalance.", "note": "Refers to both a temperament and a humoral state.", "wikipedia_extract": "Melancholia or melancholy (Ancient Greek: μελαγχολία, romanized: melancholía; from μέλαινα χολή, mélaina cholḗ, 'black bile') is a concept found throughout ancient, medieval, and premodern medicine in Europe that describes a condition characterized by markedly depressed mood, bodily complaints, and sometimes hallucinations and delusions. Besides a pathological condition, melancholy could also refer to a mood or temperament and at times it was even used as a description of the human condition in general. Melancholy (or more precisely the 'black bile', from which melancholy derives its name) was regarded as one of the four temperaments matching the four humours. Until the 18th century, doctors and other scholars classified melancholic conditions as such by their perceived common cause – an excess of a notional fluid known as \"black bile\", which was commonly linked to the spleen. Hippocrates and other ancient physicians described melancholia as a distinct disease with mental and physical symptoms, including persistent fears and despondencies, poor appetite, abulia, sleeplessness, irritability, and agitation. Later, fixed delusions were added by Galen and other physicians to the list of symptoms."}}, {"canonical_name": "scamonea", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 36, "members": [{"entity_id": "scamonea", "book_id": "ricettario_fiorentino_1597", "name": "scamonea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 32, "variants": ["scamonea", "Scammonio", "Scamonea", "Scamonea antiochena"], "contexts": ["a plant resin used as a purgative", "plant for medicine"]}, {"entity_id": "scammony", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Scammony", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Scammony"], "contexts": ["laxative plant product", "plant with purging virtues"]}, {"entity_id": "escamonea", "book_id": "coloquios_da_orta_1563", "name": "escamonea", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["escamonea"], "contexts": ["herb used as purgative", "plant used for purging"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "scamonea", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Scammony", "similarity": 0.901}], "id": 248, "stable_key": "clu_2ef90a29d2c08d6f", "ground_truth": {"modern_name": "Scammony", "confidence": "high", "type": "plant", "linnaean": "Convolvulus scammonia", "family": "Convolvulaceae", "description": "Resinous purgative obtained from the root of a bindweed plant.", "wikipedia_extract": "Convolvulus scammonia, commonly known as scammony, is a bindweed native to the countries of the eastern part of the Mediterranean basin; it grows in bushy waste places, from Syria in the south to Crimea in the north, its range extending westward to the Greek islands, but not to northern Africa or Italy. It is a twining perennial, bearing flowers like those of Convolvulus arvensis, and having irregularly arrow-shaped leaves and a thick fleshy root. A cathartic resinous tincture known as scammoniae resina, which is obtained from the dried root by digestion with ethanol has been used as a traditional medicine. Upon consumption, the resin is inert until it has passed from the stomach into the duodenum, where it meets the bile. A chemical reaction occurs between it and taurocholate and glycocholate in the bile, whereby it is converted into a powerful purgative which in high doses becomes a violent gastrointestinal irritant. Scammony kills both roundworm and tapeworm, especially the former, and it was therefore used as an anthelmintic."}}, {"canonical_name": "α Centauri", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 36, "members": [{"entity_id": "α_centauri", "book_id": "connexion_physical_sciences_somerville_1858", "name": "α Centauri", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 25, "variants": ["α Centauri"], "contexts": ["nearest known star", "bright star in the heavens"]}, {"entity_id": "a__du_centaure", "book_id": "relation_historique_humboldt_vol3_1825", "name": "a. du Centaure", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["a. du Centaure"], "contexts": ["celestial object used for latitude determination"]}, {"entity_id": "centuria", "book_id": "polyanthea_medicinal", "name": "Centuria", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 10, "variants": ["Centuria", "Cent", "Cent. 3.", "Centur. 1", "centuria", "centuria 1. Obfervationum"], "contexts": ["title of a work", "Section of a book"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "α Centauri", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "a. du Centaure", "similarity": 0.927}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "α Centauri", "target_book": "polyanthea_medicinal", "target_name": "Centuria", "similarity": 0.889}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "a. du Centaure", "target_book": "polyanthea_medicinal", "target_name": "Centuria", "similarity": 0.882}], "id": 249, "stable_key": "clu_b6360709f80ab7fd", "ground_truth": {"modern_name": "Alpha Centauri", "confidence": "high", "type": "object", "note": "While 'Centuria' could refer to a century, in the context of astronomical observation and proximity to 'α Centauri' and 'a. du Centaure', it's highly likely a garbled reference to Alpha Centauri.", "wikidata_id": "Q12176", "wikidata_description": "triple star system in the constellation Centaurus, where one of the three stars, Proxima Centauri, being the closest star to the Earth", "wikipedia_url": "https://en.wikipedia.org/wiki/Alpha%20Centauri", "wikipedia_extract": "Alpha Centauri (α Centauri, α Cen, or Alpha Cen) is a star system in the southern constellation of Centaurus. It consists of three stars: Rigil Kentaurus (α Centauri A), Toliman (α Centauri B), and Proxima Centauri (α Centauri C). Proxima Centauri is the closest star to the Sun at 4.2465 light-years (ly), which is 1.3020 parsecs (pc), while Alpha Centauri A and B are the nearest stars visible to the naked eye. Rigil Kentaurus and Toliman are Sun-like stars (class G and K, respectively) that together form the binary star system α Centauri AB. To the naked eye, these two main components appear to be a single star with an apparent magnitude of −0.27. It is the brightest star in the constellation and the third-brightest in the night sky, outshone by only Sirius and Canopus. α Centauri AB are the nearest binary stars to the Sun at a distance of 4.344 ly (1.33 pc)."}}, {"canonical_name": "Guayaquil", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 35, "members": [{"entity_id": "guayaquil", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Guayaquil", "category": "PLACE", "subcategory": "CITY", "count": 28, "variants": ["Guayaquil", "Guayuaquil"], "contexts": ["port city in Ecuador", "port on the Pacific coast"]}, {"entity_id": "guayaquil", "book_id": "kosmos_humboldt_1845", "name": "Guayaquil", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Guayaquil"], "contexts": ["city in Ecuador", "station in the tropics"]}, {"entity_id": "guayaquil", "book_id": "historia_medicinal_monardes_1574", "name": "Guayaquil", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Guayaquil"], "contexts": ["a city in Peru", "a river name"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Guayaquil", "target_book": "kosmos_humboldt_1845", "target_name": "Guayaquil", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Guayaquil", "target_book": "historia_medicinal_monardes_1574", "target_name": "Guayaquil", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Guayaquil", "target_book": "historia_medicinal_monardes_1574", "target_name": "Guayaquil", "similarity": 1.0}], "id": 250, "stable_key": "clu_67d123bd3a195d24", "ground_truth": {"modern_name": "Guayaquil", "confidence": "high", "type": "place", "description": "Major port city in Ecuador on the Pacific coast.", "wikipedia_extract": "Guayaquil (Spanish pronunciation: [ɡwaʝaˈkil] ), officially Santiago de Guayaquil, is the largest city in Ecuador and also the nation's economic capital and main port. The city is the capital of Guayas Province and the seat of Guayaquil Canton. The city is located on the west bank of the Guayas River, which flows into the Pacific Ocean at the Gulf of Guayaquil. With a population of 2,746,403 inhabitants, it is the most populous city in the country, and the fifth largest in the Andean Community. However, its urban fabric extends beyond its official urban parishes, encompassing nearby cities and parishes; thus, the Guayaquil metropolitan area reaches a population of 3,618,450, making it the most populous urban agglomeration in the nation, and also the fifth in the Andean Community. As the largest city, it is one of the two main development poles of the country—alongside Quito, the national capital—hosting Ecuador’s main business, financial, cultural, and sports institutions."}}, {"canonical_name": "banho", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 34, "members": [{"entity_id": "banho", "book_id": "polyanthea_medicinal", "name": "banho", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 24, "variants": ["banho", "banho de agua", "banho de agua morna", "banho de aguadoce", "banhode agua fervente", "banhos de agua doce", "banhos de agua fria", "banhos de agua morna", "banhos de agua tibia", "banhos de aguadoce", "banhos de aguamuyto quente", "banhos de leite", "banhos deagua doce"], "contexts": ["therapeutic bath with herbs", "therapeutic bath"]}, {"entity_id": "bath", "book_id": "english_physician_1652", "name": "bath", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 3, "variants": ["bath", "Bath", "Bathing"], "contexts": ["outward application of St. Johns-wort", "method of treating skin conditions"]}, {"entity_id": "banhos", "book_id": "coloquios_da_orta_1563", "name": "banhos", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["banhos"], "contexts": ["used to treat beribéri"]}, {"entity_id": "banhos_das_caldas", "book_id": "polyanthea_medicinal", "name": "Banhos das Caldas", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 5, "variants": ["banhos das Caldas", "Banhos das Caldas"], "contexts": ["treatment using hot springs", "remedy for cold/moist paralysis"]}, {"entity_id": "banhos_de_ervas", "book_id": "polyanthea_medicinal", "name": "Banhos de ervas", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Banhos de ervas"], "contexts": ["herb baths"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "banho", "target_book": "english_physician_1652", "target_name": "bath", "similarity": 0.962}, {"source_book": "polyanthea_medicinal", "source_name": "banho", "target_book": "coloquios_da_orta_1563", "target_name": "banhos", "similarity": 0.968}, {"source_book": "english_physician_1652", "source_name": "bath", "target_book": "coloquios_da_orta_1563", "target_name": "banhos", "similarity": 0.934}, {"source_book": "coloquios_da_orta_1563", "source_name": "banhos", "target_book": "polyanthea_medicinal", "target_name": "Banhos das Caldas", "similarity": 0.834}, {"source_book": "coloquios_da_orta_1563", "source_name": "banhos", "target_book": "polyanthea_medicinal", "target_name": "Banhos de ervas", "similarity": 0.821}], "id": 251, "stable_key": "clu_3c945bb1444f2448", "ground_truth": {"modern_name": "Baths", "confidence": "high", "type": "concept", "description": "Therapeutic practice involving immersion in water or herbal preparations.", "wikipedia_extract": "Balneotherapy (Latin: balneum \"bath\") is a pseudoscientific method of treating diseases by bathing, a traditional medicine technique usually practiced at spas. Since ancient times, humans have used hot springs, public baths and thermal medicine for therapeutic effects. While it is considered distinct from hydrotherapy, there are some overlaps in practice and in underlying principles. Balneotherapy may involve hot or cold water, massage through moving water, relaxation, or stimulation. Many mineral waters at spas are rich in particular minerals such as silica, sulfur, selenium, and radium. Medicinal clays are also widely used, a practice known as 'fangotherapy'. \"Balneotherapy\" is the practice of immersing a subject in mineral water or mineral-laden mud; it is part of the traditional medicine of many cultures and originated in hot springs, cold water springs, or other sources of such water, like the Dead Sea."}}, {"canonical_name": "De Candolle", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 34, "members": [{"entity_id": "de_candolle", "book_id": "coloquios_da_orta_1563", "name": "De Candolle", "category": "PERSON", "subcategory": "SCHOLAR", "count": 15, "variants": ["De Candolle", "A. De Candolle", "De CandoUe"], "contexts": ["author on origin of cultivated plants", "author of Orig. des plantes cultivées"]}, {"entity_id": "alph__de_candolle", "book_id": "origin_of_species_darwin_1859", "name": "Alph. de Candolle", "category": "PERSON", "subcategory": "SCHOLAR", "count": 14, "variants": ["Alph. de Candolle", "Alph. De Candolle"], "contexts": ["botanist who studied plant varieties", "remarked on floras gaining by naturalisation"]}, {"entity_id": "de_candolle", "book_id": "origin_of_species_darwin_1859", "name": "De Candolle", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["De Candolle"], "contexts": ["philosophically shown organic beings compete", "founded divisions of Umbelliferæ on seed differences"]}, {"entity_id": "de_candolle", "book_id": "kosmos_humboldt_1845", "name": "De Candolle", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["De Candolle"], "contexts": ["proposed nomenclature"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "De Candolle", "target_book": "origin_of_species_darwin_1859", "target_name": "Alph. de Candolle", "similarity": 0.895}, {"source_book": "coloquios_da_orta_1563", "source_name": "De Candolle", "target_book": "origin_of_species_darwin_1859", "target_name": "De Candolle", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "De Candolle", "target_book": "kosmos_humboldt_1845", "target_name": "De Candolle", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Alph. de Candolle", "target_book": "kosmos_humboldt_1845", "target_name": "De Candolle", "similarity": 0.895}, {"source_book": "origin_of_species_darwin_1859", "source_name": "De Candolle", "target_book": "kosmos_humboldt_1845", "target_name": "De Candolle", "similarity": 1.0}], "id": 252, "stable_key": "clu_7ad15409f070cd19", "ground_truth": {"modern_name": "Augustin Pyramus de Candolle", "confidence": "high", "type": "person", "description": "Swiss botanist influential in the classification of plants.", "note": "Also refers to his son, Alphonse Pyramus de Candolle.", "wikipedia_extract": "Augustin Pyramus (or Pyrame) de Candolle (UK: , US: , French: [kɑ̃dɔl]; 4 February 1778 – 9 September 1841) was a Swiss botanist. René Louiche Desfontaines launched de Candolle's botanical career by recommending him at a herbarium. Within a couple of years de Candolle had established a new genus, and he went on to document hundreds of plant families and create a new natural plant classification system. Although de Candolle's main focus was botany, he also contributed to related fields such as phytogeography, agronomy, paleontology, medical botany, and economic botany. De Candolle originated the idea of \"Nature's war\", which influenced Charles Darwin and the principle of natural selection. De Candolle recognized that multiple species may develop similar characteristics that did not appear in a common evolutionary ancestor; a phenomenon now known as convergent evolution."}}, {"canonical_name": "cozimento", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 33, "members": [{"entity_id": "cozimento", "book_id": "polyanthea_medicinal", "name": "cozimento", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 30, "variants": ["cozimento"], "contexts": ["digestion process", "decoction preparation"]}, {"entity_id": "cozinha", "book_id": "coloquios_da_orta_1563", "name": "cozinha", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["cozinha"], "contexts": ["cooking", "use of plant in cooking"]}, {"entity_id": "cottura", "book_id": "ricettario_fiorentino_1597", "name": "cottura", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["cottura"], "contexts": ["cooking process"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "cozimento", "target_book": "coloquios_da_orta_1563", "target_name": "cozinha", "similarity": 0.845}, {"source_book": "polyanthea_medicinal", "source_name": "cozimento", "target_book": "ricettario_fiorentino_1597", "target_name": "cottura", "similarity": 0.9}, {"source_book": "coloquios_da_orta_1563", "source_name": "cozinha", "target_book": "ricettario_fiorentino_1597", "target_name": "cottura", "similarity": 0.885}], "id": 253, "stable_key": "clu_7e21839fe0b6ada7", "ground_truth": {"modern_name": "Cooking", "confidence": "high", "type": "concept", "description": "Process of preparing food by applying heat.", "note": "Includes both the act of cooking and methods of preparing medicinal decoctions.", "wikipedia_extract": "Cooking, also known as cookery, is the art, science and craft of using heat to make food more palatable, digestible, nutritious, or safe. Cooking techniques and ingredients vary widely, from grilling food over an open fire, to using electric stoves, to baking in various types of ovens, to boiling  and blanching in water, reflecting local conditions, techniques and traditions. Cooking is an aspect of all human societies and a cultural universal. Types of cooking also depend on the skill levels and training of the cooks. Cooking is done both by people in their own dwellings and by professional cooks and chefs in restaurants and other food establishments. The term \"culinary arts\" usually refers to cooking that is primarily focused on the aesthetic beauty of the presentation and taste of the food."}}, {"canonical_name": "mel rosado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 33, "members": [{"entity_id": "mel_rosado", "book_id": "polyanthea_medicinal", "name": "mel rosado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 29, "variants": ["mel rosado", "Mel rofado", "mel Rosado", "mel Roſado", "mel rofado", "mel rosadocoado", "mel roſado", "melRoſado"], "contexts": ["rose-flavored honey used to make electuary", "medicinal preparation"]}, {"entity_id": "mel_rosado", "book_id": "coloquios_da_orta_1563", "name": "mel rosado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["mel rosado"], "contexts": ["rose honey, an ingredient", "rose-infused honey"]}, {"entity_id": "mele_rosato_so-", "book_id": "ricettario_fiorentino_1597", "name": "MELE ROSATO SO-", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["MELE ROSATO SO-", "MELE ROSATO ZVC-"], "contexts": ["rosated honey preparation"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "mel rosado", "target_book": "coloquios_da_orta_1563", "target_name": "mel rosado", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "mel rosado", "target_book": "ricettario_fiorentino_1597", "target_name": "MELE ROSATO SO-", "similarity": 0.846}, {"source_book": "coloquios_da_orta_1563", "source_name": "mel rosado", "target_book": "ricettario_fiorentino_1597", "target_name": "MELE ROSATO SO-", "similarity": 0.846}], "id": 254, "stable_key": "clu_9cb5175ef2c6b92e", "ground_truth": {"modern_name": "Rose Honey", "confidence": "high", "type": "substance", "description": "Honey infused with roses, used medicinally.", "wikipedia_extract": "Honey is a sweet and viscous substance made by several species of bees, the best-known of which are honey bees. Honey is made and stored to nourish bee colonies. Bees produce honey by gathering and then refining the sugary secretions of plants (primarily floral nectar) or the secretions of other insects, like the honeydew of aphids. This refinement takes place both within individual bees, through regurgitation and enzymatic activity, and during storage in the hive, through water evaporation that concentrates the honey's sugars until it is thick and viscous. Honey bees stockpile honey in the hive. Within the hive is a structure made from wax called honeycomb."}}, {"canonical_name": "alimentos", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 32, "members": [{"entity_id": "alimentos", "book_id": "polyanthea_medicinal", "name": "alimentos", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 29, "variants": ["alimentos", "alimento exterior", "alimento interior", "alimentos acres", "alimentos liquidos", "alimentos mordazes", "alimentos muyto aduba", "alimentos muyto adubados", "alimentos muyto humidos", "alimentos máos", "alimentos solidos", "alimentos ſeccos", "alimentum"], "contexts": ["food", "nourishment"]}, {"entity_id": "comestibles", "book_id": "relation_historique_humboldt_vol3_1825", "name": "comestibles", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["comestibles"], "contexts": ["edibles", "foodstuffs, imported goods"]}, {"entity_id": "comida", "book_id": "historia_medicinal_monardes_1574", "name": "comida", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["comida"], "contexts": ["food"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "alimentos", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "comestibles", "similarity": 0.903}, {"source_book": "polyanthea_medicinal", "source_name": "alimentos", "target_book": "historia_medicinal_monardes_1574", "target_name": "comida", "similarity": 0.966}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "comestibles", "target_book": "historia_medicinal_monardes_1574", "target_name": "comida", "similarity": 0.893}], "id": 255, "stable_key": "clu_267533c63e8dbd62", "ground_truth": {"modern_name": "food", "confidence": "high", "type": "concept", "description": "Substances providing nourishment and sustenance.", "wikipedia_extract": "Food is any substance consumed by an organism for nutritional support. Food usually consists of plant, animal, or fungal origin and contains essential nutrients such as carbohydrates, fats, proteins, vitamins, or minerals. The substance is ingested by an organism and assimilated by the organism's cells to provide energy, maintain life, or support growth. Different species of animals have different feeding behaviours that satisfy the needs of their metabolisms and have evolved to fill specific ecological niches within specific geographical contexts. Omnivorous humans are highly adaptable and have adapted to obtaining food in many different ecosystems. Humans generally use cooking to prepare food for consumption."}}, {"canonical_name": "telescope", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 32, "members": [{"entity_id": "telescope", "book_id": "connexion_physical_sciences_somerville_1858", "name": "telescope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 10, "variants": ["telescope"], "contexts": ["instrument for astronomical observation", "instrument for viewing distant objects"]}, {"entity_id": "telescope", "book_id": "origin_of_species_darwin_1859", "name": "telescope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["telescope"], "contexts": ["optical instrument for viewing distant objects"]}, {"entity_id": "telescopes", "book_id": "kosmos_humboldt_1845", "name": "telescopes", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 4, "variants": ["telescopes"], "contexts": ["instruments for astronomical observation", "instruments for viewing distant objects"]}, {"entity_id": "telescopic_vision", "book_id": "kosmos_humboldt_1845", "name": "telescopic vision", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["telescopic vision"], "contexts": ["vision enhanced by a telescope", "instrument for observing distant objects"]}, {"entity_id": "telescope", "book_id": "kosmos_humboldt_1845", "name": "telescope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["telescope"], "contexts": ["instrument for viewing distant objects"]}, {"entity_id": "magnetic_telescope", "book_id": "kosmos_humboldt_1845", "name": "magnetic telescope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["magnetic telescope"], "contexts": ["instrument for magnetic measurements"]}, {"entity_id": "achromatic_telescope", "book_id": "connexion_physical_sciences_somerville_1858", "name": "achromatic telescope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 7, "variants": ["Achromatic Telescope", "achromatic telescope"], "contexts": ["instrument for viewing light", "optical instrument for viewing distant objects"]}, {"entity_id": "telescopes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "telescopes", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["telescopes"], "contexts": ["instruments for observing distant objects", "instruments for viewing distant objects"]}, {"entity_id": "telescope,_the_achromatic", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Telescope, the achromatic", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["Telescope, the achromatic"], "contexts": ["optical instrument for observation"]}, {"entity_id": "telescope,_the_differential", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Telescope, the differential", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["Telescope, the differential"], "contexts": ["optical instrument for illumination differences"]}, {"entity_id": "telescope,_lord_rosse’s", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Telescope, Lord Rosse’s", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["Telescope, Lord Rosse’s"], "contexts": ["telescope used to resolve nebulæ"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "telescope", "target_book": "origin_of_species_darwin_1859", "target_name": "telescope", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "telescope", "target_book": "kosmos_humboldt_1845", "target_name": "telescopes", "similarity": 0.979}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "telescope", "target_book": "kosmos_humboldt_1845", "target_name": "telescopic vision", "similarity": 0.892}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "telescope", "target_book": "kosmos_humboldt_1845", "target_name": "telescope", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "telescope", "target_book": "kosmos_humboldt_1845", "target_name": "magnetic telescope", "similarity": 0.846}, {"source_book": "origin_of_species_darwin_1859", "source_name": "telescope", "target_book": "kosmos_humboldt_1845", "target_name": "telescopes", "similarity": 0.979}, {"source_book": "origin_of_species_darwin_1859", "source_name": "telescope", "target_book": "kosmos_humboldt_1845", "target_name": "telescopic vision", "similarity": 0.892}, {"source_book": "origin_of_species_darwin_1859", "source_name": "telescope", "target_book": "kosmos_humboldt_1845", "target_name": "telescope", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "telescope", "target_book": "kosmos_humboldt_1845", "target_name": "magnetic telescope", "similarity": 0.846}, {"source_book": "origin_of_species_darwin_1859", "source_name": "telescope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "achromatic telescope", "similarity": 0.841}, {"source_book": "origin_of_species_darwin_1859", "source_name": "telescope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "telescopes", "similarity": 0.979}, {"source_book": "origin_of_species_darwin_1859", "source_name": "telescope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Telescope, the achromatic", "similarity": 0.864}, {"source_book": "origin_of_species_darwin_1859", "source_name": "telescope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Telescope, the differential", "similarity": 0.848}, {"source_book": "origin_of_species_darwin_1859", "source_name": "telescope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Telescope, Lord Rosse’s", "similarity": 0.826}, {"source_book": "kosmos_humboldt_1845", "source_name": "telescopes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "telescopes", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "telescopes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Telescope, the achromatic", "similarity": 0.858}, {"source_book": "kosmos_humboldt_1845", "source_name": "telescopes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Telescope, the differential", "similarity": 0.841}, {"source_book": "kosmos_humboldt_1845", "source_name": "telescopes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Telescope, Lord Rosse’s", "similarity": 0.828}, {"source_book": "kosmos_humboldt_1845", "source_name": "telescopic vision", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "telescopes", "similarity": 0.879}, {"source_book": "kosmos_humboldt_1845", "source_name": "telescope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "achromatic telescope", "similarity": 0.841}, {"source_book": "kosmos_humboldt_1845", "source_name": "telescope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "telescopes", "similarity": 0.979}, {"source_book": "kosmos_humboldt_1845", "source_name": "telescope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Telescope, the achromatic", "similarity": 0.864}, {"source_book": "kosmos_humboldt_1845", "source_name": "telescope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Telescope, the differential", "similarity": 0.848}, {"source_book": "kosmos_humboldt_1845", "source_name": "telescope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Telescope, Lord Rosse’s", "similarity": 0.826}], "id": 256, "stable_key": "clu_d4351f70f3f48980", "ground_truth": {"modern_name": "Telescope", "confidence": "high", "type": "object", "wikidata_id": "Q4213", "wikidata_description": "instrument that aids in the observation of remote objects", "wikipedia_url": "https://en.wikipedia.org/wiki/Telescope", "wikipedia_extract": "A telescope is a device used to observe distant objects by their emission, absorption, or reflection of electromagnetic radiation. Originally, it was an optical instrument using lenses, curved mirrors, or a combination of both to observe distant objects – an optical telescope. Nowadays, the word \"telescope\" is defined as a wide range of instruments capable of detecting different regions of the electromagnetic spectrum, and in some cases other types of detectors. The first known practical telescopes were refracting telescopes with glass lenses and were invented in the Netherlands at the beginning of the 17th century. They were used for both terrestrial applications and astronomy. The reflecting telescope, which uses mirrors to collect and focus light, was invented within a few decades of the first refracting telescope."}}, {"canonical_name": "euforbio", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 31, "members": [{"entity_id": "euforbio", "book_id": "polyanthea_medicinal", "name": "euforbio", "category": "PLANT", "subcategory": "PLANT", "count": 22, "variants": ["euforbio", "Euforbio", "Euphorbio", "euphorbio"], "contexts": ["euphorbium, a plant substance", "benign purge"]}, {"entity_id": "euphorbium", "book_id": "english_physician_1652", "name": "Euphorbium", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Euphorbium"], "contexts": ["plant resin", "plant used in a medicinal preparation"]}, {"entity_id": "euphorbio", "book_id": "ricettario_fiorentino_1597", "name": "Euphorbio", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["Euphorbio", "Euforbie", "Euphoibio", "Euphorbie", "Euphorbio frefco"], "contexts": ["euphorbium, used in pills", "euphorbia plant"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "euforbio", "target_book": "english_physician_1652", "target_name": "Euphorbium", "similarity": 0.871}, {"source_book": "polyanthea_medicinal", "source_name": "euforbio", "target_book": "ricettario_fiorentino_1597", "target_name": "Euphorbio", "similarity": 0.863}, {"source_book": "english_physician_1652", "source_name": "Euphorbium", "target_book": "ricettario_fiorentino_1597", "target_name": "Euphorbio", "similarity": 0.884}], "id": 257, "stable_key": "clu_86a34ab7c56b8de0", "ground_truth": {"modern_name": "euphorbium", "confidence": "high", "type": "plant", "linnaean": "Euphorbia", "family": "Euphorbiaceae", "description": "A plant and its medicinal resin, used as a purge.", "note": "Refers to both the plant genus and the medicinal resin derived from it.", "wikipedia_extract": "Euphorbia is a large and diverse genus of flowering plants, commonly called spurge, in the family Euphorbiaceae. Euphorbias range from tiny annual plants to large and long-lived trees, with perhaps the tallest being Euphorbia ampliphylla at 30 m (98 ft) or more. The genus has roughly 2,000 members, making it one of the largest genera of flowering plants. It also has one of the largest ranges of chromosome counts, along with Rumex and Senecio. Euphorbia antiquorum is the type species for the genus Euphorbia. It was first described by Carl Linnaeus in 1753 in Species Plantarum."}}, {"canonical_name": "entranhas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 30, "members": [{"entity_id": "entranhas", "book_id": "polyanthea_medicinal", "name": "entranhas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 26, "variants": ["entranhas", "entrails", "entranhas damáy", "entranhas naturaes"], "contexts": ["entrails", "internal organs"]}, {"entity_id": "entrails", "book_id": "english_physician_1652", "name": "Entrails", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Entrails", "Intrails"], "contexts": ["internal organs of digestion"]}, {"entity_id": "entrías", "book_id": "historia_medicinal_monardes_1574", "name": "entrías", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["entrías", "entrañas"], "contexts": ["misspelling of entrails", "body part, intestines"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "entranhas", "target_book": "english_physician_1652", "target_name": "Entrails", "similarity": 0.923}, {"source_book": "polyanthea_medicinal", "source_name": "entranhas", "target_book": "historia_medicinal_monardes_1574", "target_name": "entrías", "similarity": 0.911}, {"source_book": "english_physician_1652", "source_name": "Entrails", "target_book": "historia_medicinal_monardes_1574", "target_name": "entrías", "similarity": 0.878}], "id": 258, "stable_key": "clu_87dbf005603f2b82", "ground_truth": {"modern_name": "entrails", "confidence": "high", "type": "substance", "description": "The internal organs, especially of digestion.", "wikipedia_extract": "The gastrointestinal tract (also called the GI tract, digestive tract, and the alimentary canal) is the tract or passageway of the digestive system that leads from the mouth to the anus. The tract is one of the largest of the body's systems. The GI tract contains all the major organs of the digestive system, in humans and other animals, including the esophagus, stomach, and intestines. Food taken in through the mouth is digested to extract nutrients and absorb energy, and the waste expelled at the anus as feces. Gastrointestinal is an adjective meaning of or pertaining to the stomach and intestines. Most animals have a \"through-gut\" or complete digestive tract."}}, {"canonical_name": "blood", "category": "ANATOMY", "subcategory": "FLUID", "book_count": 3, "total_mentions": 30, "members": [{"entity_id": "blood", "book_id": "first_principles_spencer_1862", "name": "blood", "category": "ANATOMY", "subcategory": "FLUID", "count": 12, "variants": ["blood"], "contexts": ["fluid found on feathers", "circulating bodily fluid"]}, {"entity_id": "blood", "book_id": "origin_of_species_darwin_1859", "name": "blood", "category": "ANATOMY", "subcategory": "FLUID", "count": 4, "variants": ["blood"], "contexts": ["metaphorical term for ancestral influence", "fluid for propulsion"]}, {"entity_id": "blood", "book_id": "principles_of_psychology_james_1890", "name": "blood", "category": "ANATOMY", "subcategory": "FLUID", "count": 11, "variants": ["blood"], "contexts": ["fluid whose subtraction can affect consciousness", "circulating fluid in the body"]}, {"entity_id": "blood-supply", "book_id": "principles_of_psychology_james_1890", "name": "blood-supply", "category": "ANATOMY", "subcategory": "FLUID", "count": 3, "variants": ["blood-supply"], "contexts": ["circulation of blood", "circulation of blood to tissues"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "blood", "target_book": "origin_of_species_darwin_1859", "target_name": "blood", "similarity": 1.0}, {"source_book": "first_principles_spencer_1862", "source_name": "blood", "target_book": "principles_of_psychology_james_1890", "target_name": "blood", "similarity": 1.0}, {"source_book": "first_principles_spencer_1862", "source_name": "blood", "target_book": "principles_of_psychology_james_1890", "target_name": "blood-supply", "similarity": 0.852}, {"source_book": "origin_of_species_darwin_1859", "source_name": "blood", "target_book": "principles_of_psychology_james_1890", "target_name": "blood", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "blood", "target_book": "principles_of_psychology_james_1890", "target_name": "blood-supply", "similarity": 0.852}], "id": 259, "stable_key": "clu_38f6f316413eacc2", "ground_truth": {"modern_name": "blood", "confidence": "high", "type": "anatomy", "description": "The red fluid circulating in the body, carrying oxygen and nutrients.", "wikipedia_extract": "Blood is a body fluid in the circulatory system of humans and other vertebrates that delivers necessary substances such as nutrients and oxygen to the cells, and transports metabolic waste products away from those same cells. Blood is composed of blood cells suspended in plasma. Plasma, which constitutes 55% of blood fluid, is mostly water (92% by volume), and contains proteins, glucose, mineral ions, and hormones. The blood cells are mainly red blood cells (erythrocytes), white blood cells (leukocytes), and (in mammals) platelets (thrombocytes). The most abundant cells are red blood cells. These contain hemoglobin, which facilitates oxygen transport by reversibly binding to it, increasing its solubility."}}, {"canonical_name": "Azedos", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 30, "members": [{"entity_id": "azedos", "book_id": "polyanthea_medicinal", "name": "Azedos", "category": "CONCEPT", "subcategory": "QUALITY", "count": 24, "variants": ["Azedos", "azcdos", "azeda", "azedar", "azedo", "azedos", "azeedo"], "contexts": ["sour substances used for treatment", "sour quality of substances"]}, {"entity_id": "azedo", "book_id": "coloquios_da_orta_1563", "name": "azedo", "category": "CONCEPT", "subcategory": "QUALITY", "count": 3, "variants": ["azedo"], "contexts": ["sour flavor", "Taste quality"]}, {"entity_id": "azedas", "book_id": "coloquios_da_orta_1563", "name": "azedas", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["azedas"], "contexts": ["taste of the fruit", "taste quality of the fruits"]}, {"entity_id": "acetofo", "book_id": "ricettario_fiorentino_1597", "name": "acetofo", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["acetofo"], "contexts": ["quality of vinegar"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Azedos", "target_book": "coloquios_da_orta_1563", "target_name": "azedo", "similarity": 0.898}, {"source_book": "polyanthea_medicinal", "source_name": "Azedos", "target_book": "coloquios_da_orta_1563", "target_name": "azedas", "similarity": 0.955}, {"source_book": "polyanthea_medicinal", "source_name": "Azedos", "target_book": "ricettario_fiorentino_1597", "target_name": "acetofo", "similarity": 0.843}], "id": 260, "stable_key": "clu_413cbfe353639f4b", "ground_truth": {"modern_name": "sour", "confidence": "high", "type": "concept", "description": "Having a sharp, acidic taste or quality.", "note": "Refers to a taste quality.", "wikipedia_extract": "Sourness, also known as sour, is a basic taste sensation perceived through hydrogen ions from acidic compounds interacting with taste bud receptors, and it can also refer to an unpleasant or acidic quality in taste, disposition, or tone. It is a warning sign for potentially spoiled food, though it is balanced in some food products by sweetness, and it is associated with a low pH. The most common foods with natural sourness are fruits, such as lemon, lime, grape, orange, tamarind, and bitter melon. Fermented foods, such as wine, sour cream, vinegar or yogurt, may have sour taste. Children show a greater enjoyment of sour flavors than adults, and sour candy containing citric acid or malic acid is common."}}, {"canonical_name": "Mathiolus", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 29, "members": [{"entity_id": "mathiolus", "book_id": "english_physician_1652", "name": "Mathiolus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 18, "variants": ["Mathiolus", "Mathioli", "Mathi•lus"], "contexts": ["wrote comment on Dioscorides", "Renaissance physician and botanist"]}, {"entity_id": "matthioli", "book_id": "coloquios_da_orta_1563", "name": "Matthioli", "category": "PERSON", "subcategory": "AUTHORITY", "count": 5, "variants": ["Matthioli"], "contexts": ["celebrated figure who exhorted Portuguese physicians", "erudite scholar"]}, {"entity_id": "mathiolo", "book_id": "polyanthea_medicinal", "name": "Mathiolo", "category": "PERSON", "subcategory": "AUTHORITY", "count": 6, "variants": ["Mathiolo", "Mathioli"], "contexts": ["doctor who prescribed repeated purges", "early modern medical author"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Mathiolus", "target_book": "coloquios_da_orta_1563", "target_name": "Matthioli", "similarity": 0.918}, {"source_book": "english_physician_1652", "source_name": "Mathiolus", "target_book": "polyanthea_medicinal", "target_name": "Mathiolo", "similarity": 0.942}, {"source_book": "coloquios_da_orta_1563", "source_name": "Matthioli", "target_book": "polyanthea_medicinal", "target_name": "Mathiolo", "similarity": 0.94}], "id": 261, "stable_key": "clu_a52107fa66920a23", "ground_truth": {"modern_name": "Mattioli", "confidence": "high", "type": "person", "description": "An influential early modern physician and botanist.", "note": "Corrected spelling from 'Mathiolus'/'Matthioli'/'Mathiolo'.", "wikipedia_extract": "Mattioli is an Italian surname. Notable people with the surname include: Alessandro Mattioli (born 1998), Italian footballer Carlo Mattioli (born 1954), Italian race walker Denise Mattioli (born 1952), Brazilian volleyball player Ercole Antonio Mattioli (1640–1694), Italian minister Gaspare Mattioli (1806–1843), Italian painter Gianni Francesco Mattioli (born 1940), Italian politician and university professor Girolamo Mattioli (fl."}}, {"canonical_name": "lethargo", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 3, "total_mentions": 29, "members": [{"entity_id": "lethargo", "book_id": "polyanthea_medicinal", "name": "lethargo", "category": "DISEASE", "subcategory": "CHRONIC", "count": 18, "variants": ["lethargo", "Letargo", "Letargos", "Letharg.", "Lethargo", "Lethargos", "letargo", "lethargicos", "lethargum", "lethargy"], "contexts": ["a condition of excessive sleepiness", "a somnolent condition"]}, {"entity_id": "lithargia", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Lithargia", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["Lithargia"], "contexts": ["medical condition related to oblivion"]}, {"entity_id": "lethargy", "book_id": "english_physician_1652", "name": "Lethargy", "category": "DISEASE", "subcategory": "CHRONIC", "count": 10, "variants": ["Lethargy", "Lethargie"], "contexts": ["condition treated with Brooklime mixture", "state of abnormal drowsiness"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "lethargo", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Lithargia", "similarity": 0.892}, {"source_book": "polyanthea_medicinal", "source_name": "lethargo", "target_book": "english_physician_1652", "target_name": "Lethargy", "similarity": 0.98}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lithargia", "target_book": "english_physician_1652", "target_name": "Lethargy", "similarity": 0.926}], "id": 262, "stable_key": "clu_2d17ea8958d0dc02", "ground_truth": {"modern_name": "Lethargy", "confidence": "high", "type": "disease", "description": "A medical condition characterized by abnormal drowsiness or sleepiness.", "wikipedia_extract": "Lethargy is a state of tiredness, sleepiness, weariness, fatigue, sluggishness, or lack of energy. It can be accompanied by depression, decreased motivation, or apathy. Lethargy can be a normal response to inadequate sleep, overexertion, overworking, stress, lack of exercise, improper nutrition, drug abuse, boredom, or a symptom of an underlying illness or disorder. It may also be a side effect of medication or caused by an interaction between medications and alcohol. It may also be an altered level of consciousness. When part of a normal response, lethargy often resolves with rest, adequate sleep, decreased stress, physical exercise, and good nutrition."}}, {"canonical_name": "latinos", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 29, "members": [{"entity_id": "latinos", "book_id": "coloquios_da_orta_1563", "name": "latinos", "category": "PERSON", "subcategory": "AUTHORITY", "count": 21, "variants": ["Latinos", "latinos"], "contexts": ["group of people", "Latins"]}, {"entity_id": "latins", "book_id": "english_physician_1652", "name": "Latins", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Latins"], "contexts": ["called Linctus", "called pultisses Cataplasmata"]}, {"entity_id": "latin_authors", "book_id": "english_physician_1652", "name": "Latin Authors", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Latin Authors"], "contexts": ["named the herb"]}, {"entity_id": "latini", "book_id": "ricettario_fiorentino_1597", "name": "Latini", "category": "PERSON", "subcategory": "AUTHORITY", "count": 5, "variants": ["Latini", "latini"], "contexts": ["ancient Latin term for amphibians", "called amber succinum"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "latinos", "target_book": "english_physician_1652", "target_name": "Latins", "similarity": 0.942}, {"source_book": "coloquios_da_orta_1563", "source_name": "latinos", "target_book": "english_physician_1652", "target_name": "Latin Authors", "similarity": 0.847}, {"source_book": "coloquios_da_orta_1563", "source_name": "latinos", "target_book": "ricettario_fiorentino_1597", "target_name": "Latini", "similarity": 0.949}, {"source_book": "english_physician_1652", "source_name": "Latins", "target_book": "ricettario_fiorentino_1597", "target_name": "Latini", "similarity": 0.978}, {"source_book": "english_physician_1652", "source_name": "Latin Authors", "target_book": "ricettario_fiorentino_1597", "target_name": "Latini", "similarity": 0.884}], "id": 263, "stable_key": "clu_677f9e392a3ce23a", "ground_truth": {"modern_name": "Latins", "confidence": "high", "type": "person", "description": "People associated with Latin language, culture, or ancient Rome.", "note": "Can refer to people, authors, or languages.", "wikipedia_extract": "The term Latin has been used to describe several groups of people throughout history, first referring to the inhabitants of the ancient Latium region, then to Catholic Christians of the Latin rite, and most recently to Romance-speaking peoples. The Latins were an ancient Italic people of the Latium region in central Italy (Latium Vetus, \"Old Latium\"), in the 1st millennium BC. Although they lived in independent city-states, they spoke Latin as a common language, held common religious beliefs, and extended common rights of residence and trade to one another. Collectively, these Latin states were known as the Latin League. A rupture between Rome, one of the Latin states, and the rest of the Latin League emerged as a result of the former's territorial ambitions. The Latin League fought against Rome in the Latin War (340–338 BC), which ended in a Roman victory."}}, {"canonical_name": "Cadix", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 29, "members": [{"entity_id": "cadix", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cadix", "category": "PLACE", "subcategory": "CITY", "count": 25, "variants": ["Cadix", "Cadiz"], "contexts": ["city in Spain", "city mentioned with merchants"]}, {"entity_id": "cadiz", "book_id": "kosmos_humboldt_1845", "name": "Cadiz", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Cadiz"], "contexts": ["entering Africa from Cadiz", "Spanish city affected by sea rise"]}, {"entity_id": "cadix", "book_id": "coloquios_da_orta_1563", "name": "Cadix", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Cadix"], "contexts": ["city where Tâmara was professor", "city where Francisco Tâmara was professor"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cadix", "target_book": "kosmos_humboldt_1845", "target_name": "Cadiz", "similarity": 0.911}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cadix", "target_book": "coloquios_da_orta_1563", "target_name": "Cadix", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cadiz", "target_book": "coloquios_da_orta_1563", "target_name": "Cadix", "similarity": 0.911}], "id": 264, "stable_key": "clu_9360ea2b0ed84ee9", "ground_truth": {"modern_name": "Cádiz", "confidence": "high", "type": "place", "description": "A port city in Andalusia, Spain.", "wikipedia_extract": "Cádiz ( kə-DIZ, US also  KAY-diz, KA(H)D-iz, Spanish: [ˈkaðiθ]) is a city in Spain and the capital of the province of Cádiz in the autonomous community of Andalusia. It is located in the southwest of the Iberian Peninsula off the Atlantic Ocean separated from neighbouring San Fernando by a narrow isthmus. One of the oldest continuously inhabited cities in Western Europe, Cádiz was founded by the Phoenicians as a trading post. In the 18th century, the port in the Bay of Cádiz consolidated itself as the main harbour of mainland Spain, enjoying the virtual monopoly of trade with the Americas until 1778. It is also the site of the University of Cádiz. Situated on a narrow slice of land surrounded by the sea‚ Cádiz is, in most respects, a typical Andalusian city with well-preserved historical landmarks."}}, {"canonical_name": "suffocação", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 27, "members": [{"entity_id": "suffocação", "book_id": "polyanthea_medicinal", "name": "suffocação", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 25, "variants": ["suffocação", "Suffocaçao", "fuffocativa", "fuffocaçao", "fuffocaçaó", "fuffocaçaõ", "suffocar", "suffocatio", "suffocation", "suffocatione", "suffocationes"], "contexts": ["symptom of suffocation", "suffocation"]}, {"entity_id": "suffocation_of_the_mother", "book_id": "english_physician_1652", "name": "suffocation of the Mother", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["suffocation of the Mother"], "contexts": ["hysteria or uterine issues"]}, {"entity_id": "suffocation", "book_id": "principles_of_psychology_james_1890", "name": "suffocation", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["suffocation"], "contexts": ["lack of air"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "suffocação", "target_book": "english_physician_1652", "target_name": "suffocation of the Mother", "similarity": 0.867}, {"source_book": "polyanthea_medicinal", "source_name": "suffocação", "target_book": "principles_of_psychology_james_1890", "target_name": "suffocation", "similarity": 0.981}, {"source_book": "english_physician_1652", "source_name": "suffocation of the Mother", "target_book": "principles_of_psychology_james_1890", "target_name": "suffocation", "similarity": 0.869}], "id": 265, "stable_key": "clu_44b88f86f167e2f4", "ground_truth": {"modern_name": "Suffocation", "confidence": "high", "type": "disease", "description": "A symptom or condition characterized by a lack of air; can be related to hysteria.", "wikipedia_extract": "Asphyxia or asphyxiation is a condition of deficient supply of oxygen to the body which arises from abnormal breathing. Asphyxia causes generalized hypoxia, which affects all the tissues and organs, some more rapidly than others. There are many circumstances that can induce asphyxia, all of which are characterized by the inability of a person to acquire sufficient oxygen through breathing for an extended period of time. Asphyxia can cause coma or death. In 2015, about 9.8 million cases of unintentional suffocation occurred which resulted in 35,600 deaths. The word asphyxia is from Ancient Greek α- \"without\" and σφύξις sphyxis, \"squeeze\" (throb of heart)."}}, {"canonical_name": "Gonorrheas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 27, "members": [{"entity_id": "gonorrheas", "book_id": "polyanthea_medicinal", "name": "Gonorrheas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 18, "variants": ["Gonorrheas", "Gonerreas", "Gonorrh.", "Gonorshea", "gangrenas", "gangrenoſas", "gonorrhea", "gorrhea"], "contexts": ["sexually transmitted infection", "condition involving purgings through the urinary tract"]}, {"entity_id": "gonorrhea", "book_id": "english_physician_1652", "name": "Gonorrhea", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 6, "variants": ["Gonorrhea", "Gonorrea"], "contexts": ["condition treated by plantain externally", "running of the reins"]}, {"entity_id": "gonorrhoea", "book_id": "coloquios_da_orta_1563", "name": "gonorrhoea", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["gonorrhoea", "gonorrhceas"], "contexts": ["disease treated with cubebs", "disease treated with application"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Gonorrheas", "target_book": "english_physician_1652", "target_name": "Gonorrhea", "similarity": 0.99}, {"source_book": "polyanthea_medicinal", "source_name": "Gonorrheas", "target_book": "coloquios_da_orta_1563", "target_name": "gonorrhoea", "similarity": 0.986}, {"source_book": "english_physician_1652", "source_name": "Gonorrhea", "target_book": "coloquios_da_orta_1563", "target_name": "gonorrhoea", "similarity": 0.98}], "id": 266, "stable_key": "clu_b88a15a8688e7449", "ground_truth": {"modern_name": "Gonorrhea", "confidence": "high", "type": "disease", "description": "A sexually transmitted infection involving purulent discharge from the urinary tract.", "wikipedia_extract": "Gonorrhea or gonorrhoea, colloquially known as the clap, is a sexually transmitted infection (STI) caused by the bacterium Neisseria gonorrhoeae. Infection may involve the genitals, mouth, or rectum. Gonorrhea is spread through sexual contact with an infected person, or from a mother to a child during birth. Infected males may experience pain or burning with urination, discharge from the penis, or testicular pain. Infected females may experience burning with urination, vaginal discharge, vaginal bleeding between periods, or pelvic pain. Complications in females include pelvic inflammatory disease and in males include inflammation of the epididymis."}}, {"canonical_name": "Polipodio", "category": "PLANT", "subcategory": "ROOT", "book_count": 3, "total_mentions": 26, "members": [{"entity_id": "polipodio", "book_id": "ricettario_fiorentino_1597", "name": "Polipodio", "category": "PLANT", "subcategory": "ROOT", "count": 14, "variants": ["Polipodio", "Polipodio quercino", "Polpodio", "Polypodio", "polipodio"], "contexts": ["fern used in purgatives", "herb used in a syrup"]}, {"entity_id": "polipodio", "book_id": "coloquios_da_orta_1563", "name": "polipodio", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["polipodio"], "contexts": ["herb mentioned as food", "plant with leaves similar to a sensitive herb"]}, {"entity_id": "polipodio", "book_id": "polyanthea_medicinal", "name": "polipodio", "category": "PLANT", "subcategory": "PLANT", "count": 10, "variants": ["polipodio", "Polipodiode Carvalho", "polipodio deCarvalho", "polipodio decarvalho", "polipodiode carvalho", "polypodio"], "contexts": ["herb used in decoctions", "herb used in purgative apozemas"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Polipodio", "target_book": "coloquios_da_orta_1563", "target_name": "polipodio", "similarity": 0.86}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Polipodio", "target_book": "polyanthea_medicinal", "target_name": "polipodio", "similarity": 0.86}, {"source_book": "coloquios_da_orta_1563", "source_name": "polipodio", "target_book": "polyanthea_medicinal", "target_name": "polipodio", "similarity": 1.0}], "id": 267, "stable_key": "clu_203fbbe1398daf62", "ground_truth": {"modern_name": "Polypody", "confidence": "high", "type": "plant", "description": "A fern with purgative properties, used in various medicinal preparations.", "note": "Likely referring to species in the genus Polypodium.", "wikipedia_extract": "Polypodium is a genus of ferns in the family Polypodiaceae, subfamily Polypodioideae, according to the Pteridophyte Phylogeny Group classification of 2016 (PPG I). The genus is widely distributed throughout the world, with the highest species diversity in the tropics. The name is derived from Ancient Greek poly (\"many\") + podion (\"little foot\"), on account of the foot-like appearance of the rhizome and its branches. They are commonly called polypodies or rockcap ferns, but for many species unique vernacular names exist. They are terrestrial or epiphytic ferns, with a creeping, densely hairy or scaly rhizome bearing fronds at intervals along its length. The species differ in size and general appearance and in the character of the fronds, which are evergreen, persisting for 1–2 years, pinnate or pinnatifid (rarely simple entire), and from 10 to 80 cm or more long."}}, {"canonical_name": "Senne", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 26, "members": [{"entity_id": "senne", "book_id": "polyanthea_medicinal", "name": "Senne", "category": "PLANT", "subcategory": "PLANT", "count": 23, "variants": ["Senne", "Sena", "Sene", "sene", "senn", "senne", "senné"], "contexts": ["used in purgative pills", "herb used as a purgative"]}, {"entity_id": "senna", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Senna", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Senna"], "contexts": ["herb for medicinal use", "plant with purging virtues"]}, {"entity_id": "senna", "book_id": "english_physician_1652", "name": "Senna", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Senna"], "contexts": ["herb used in learned receipts"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Senne", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Senna", "similarity": 0.84}, {"source_book": "polyanthea_medicinal", "source_name": "Senne", "target_book": "english_physician_1652", "target_name": "Senna", "similarity": 0.916}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Senna", "target_book": "english_physician_1652", "target_name": "Senna", "similarity": 0.916}], "id": 268, "stable_key": "clu_60821cd85c0ca13c", "ground_truth": {"modern_name": "senna", "confidence": "high", "type": "plant", "linnaean": "Senna alexandrina", "family": "Fabaceae", "description": "A plant whose leaves and pods are used as a laxative.", "wikipedia_extract": "Senna alexandrina (Alexandrian senna, in Arabic عشرج or عشرق or سنامكي and see below) is an ornamental plant in the genus Senna. It is used in herbalism. It grows natively in upper Egypt, especially in the Nubian region, and near Khartoum (Sudan), where it is cultivated commercially. It is also grown elsewhere, notably in India and Somalia. Not native to the USSR, it was farmed in southern Kazakhstan for medicine. Alexandrian Senna is a shrubby plant that reaches 0.5–1 metres (20\" to 40\"), rarely two metres (6') in height with a branched, pale-green erect stem and long spreading branches bearing four or five pairs of leaves."}}, {"canonical_name": "Kent", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 25, "members": [{"entity_id": "kent", "book_id": "english_physician_1652", "name": "Kent", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 23, "variants": ["Kent", "Kentish", "Kentish Shoares"], "contexts": ["county where Lidd is located", "county where Crosswort grows"]}, {"entity_id": "kent", "book_id": "origin_of_species_darwin_1859", "name": "Kent", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Kent"], "contexts": ["county in England"]}, {"entity_id": "kentuchy", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Kentuchy", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Kentuchy"], "contexts": ["region in North America"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Kent", "target_book": "origin_of_species_darwin_1859", "target_name": "Kent", "similarity": 0.815}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Kent", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Kentuchy", "similarity": 0.827}], "id": 269, "stable_key": "clu_8faa3ba4d01b51a1", "ground_truth": {"modern_name": "Kent", "confidence": "high", "type": "place", "description": "A county in England where certain plants grow; also refers to a region in North America.", "note": "Distinguish from 'Kentuchy' (Kentucky).", "wikipedia_extract": "Kent is a ceremonial county in South East England. It is bordered by Essex across the Thames Estuary to the north, the Strait of Dover to the south-east, East Sussex to the south-west, Surrey to the west, and Greater London to the north-west. The county has an area of 3,544 square kilometres (1,368 sq mi) and had population of 1,931,684 in 2024. The north-west of Kent is densely populated, with Dartford and Gravesend belonging to the Greater London conurbation and Chatham, Gillingham and Rochester forming a second conurbation around the River Medway; the town of Maidstone is located to their south. The remainder of the county is more rural, and its principal settlements include the city of Canterbury in the north-east, the seaside resort of Margate on the north-east coast, and the ports of Dover and Folkestone on the east coast. For local government purposes Kent consists of a non-metropolitan county, with twelve districts, and the unitary authority area of Medway."}}, {"canonical_name": "Cauca", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 24, "members": [{"entity_id": "cauca", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cauca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 16, "variants": ["Cauca"], "contexts": ["city with population 193,200", "river name"]}, {"entity_id": "caucasus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Caucasus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Caucasus"], "contexts": ["mythological location of punishment"]}, {"entity_id": "caucase", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Caucase", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Caucase"], "contexts": ["mountain range", "region of observations"]}, {"entity_id": "caucasus", "book_id": "kosmos_humboldt_1845", "name": "Caucasus", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Caucasus"], "contexts": ["geographic location", "mountain range and region"]}, {"entity_id": "cauca", "book_id": "kosmos_humboldt_1845", "name": "Cauca", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Cauca"], "contexts": ["valley with subterranean detonations"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cauca", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Caucasus", "similarity": 0.957}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Caucasus", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Caucase", "similarity": 0.816}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Caucasus", "target_book": "kosmos_humboldt_1845", "target_name": "Caucasus", "similarity": 0.826}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Caucase", "target_book": "kosmos_humboldt_1845", "target_name": "Caucasus", "similarity": 0.97}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Caucase", "target_book": "kosmos_humboldt_1845", "target_name": "Cauca", "similarity": 0.946}], "id": 270, "stable_key": "clu_1814533acca33408", "ground_truth": {"modern_name": "Caucasus", "confidence": "high", "type": "place", "description": "Mountain range and region of observations.", "wikipedia_extract": "The Caucasus ( KAW-kə-səs) or Caucasia ( kaw-KAY-zhə) is a region spanning Eastern Europe and Western Asia. It is situated between the Black Sea and the Caspian Sea, comprising parts of Southern Russia, Georgia, Armenia, and Azerbaijan. The Caucasus Mountains, including the Greater Caucasus range, have conventionally been considered as a natural barrier between Europe and Asia, bisecting the Eurasian landmass. Mount Elbrus, Europe's highest mountain, is situated in the Western Caucasus area of Russia. On the southern side, the Lesser Caucasus includes the Javakheti Plateau and the Armenian highlands. The Caucasus is divided into the North Caucasus and South Caucasus, although the Western Caucasus also exists as a distinct geographic space within the North Caucasus."}}, {"canonical_name": "Conserve", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 24, "members": [{"entity_id": "conserve", "book_id": "english_physician_1652", "name": "Conserve", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 17, "variants": ["Conserve", "Conserv"], "contexts": ["preserved plant preparation", "preparation of Betony"]}, {"entity_id": "conserva", "book_id": "coloquios_da_orta_1563", "name": "conserva", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 6, "variants": ["conserva", "conservas"], "contexts": ["preserved violets", "Method of preparation"]}, {"entity_id": "conserva", "book_id": "ricettario_fiorentino_1597", "name": "conserva", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["conserva"], "contexts": ["conserves, a type of compound medicine"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Conserve", "target_book": "coloquios_da_orta_1563", "target_name": "conserva", "similarity": 0.934}, {"source_book": "english_physician_1652", "source_name": "Conserve", "target_book": "ricettario_fiorentino_1597", "target_name": "conserva", "similarity": 0.934}, {"source_book": "coloquios_da_orta_1563", "source_name": "conserva", "target_book": "ricettario_fiorentino_1597", "target_name": "conserva", "similarity": 1.0}], "id": 271, "stable_key": "clu_b600864a96cc4e7c", "ground_truth": {"modern_name": "Conserve", "confidence": "high", "type": "substance", "description": "A pharmaceutical preparation, typically of fruits or herbs preserved with sugar.", "note": "Refers to a preserved preparation, often medicinal.", "wikipedia_extract": "Shellac () is a resin secreted by the female lac bug on trees in the forests of India and Thailand. Chemically, it is mainly composed of aleuritic acid, jalaric acid, shellolic acid, and other natural waxes. It is processed and sold as dry flakes and dissolved in alcohol to make liquid shellac, which is used as a brush-on colorant, food glaze and wood finish. Shellac functions as a tough natural primer, sanding sealant, tannin-blocker, odor-blocker, stain, and high-gloss varnish. Shellac was once used in electrical applications as it is a good insulator and seals out moisture. Phonograph and 78 rpm gramophone records were made of shellac until it was replaced by vinyl.", "wikipedia_url": "https://en.wikipedia.org/wiki/Shellac"}}, {"canonical_name": "Alps", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 24, "members": [{"entity_id": "alps", "book_id": "kosmos_humboldt_1845", "name": "Alps", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 15, "variants": ["Alps"], "contexts": ["mountain range", "mountain range for height comparison"]}, {"entity_id": "alpes_maritimes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Alpes maritimes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Alpes maritimes"], "contexts": ["region where wheat and rye disappear", "mountains in California"]}, {"entity_id": "altai", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Altai", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Altai"], "contexts": ["mountain range name"]}, {"entity_id": "maritime_alps", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Maritime Alps", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Maritime Alps"], "contexts": ["mountains becoming storm centers"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Alps", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Alpes maritimes", "similarity": 0.862}, {"source_book": "kosmos_humboldt_1845", "source_name": "Alps", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Altai", "similarity": 0.862}, {"source_book": "kosmos_humboldt_1845", "source_name": "Alps", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Maritime Alps", "similarity": 0.85}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Alpes maritimes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Maritime Alps", "similarity": 0.924}], "id": 272, "stable_key": "clu_72a20f23ecc3105e", "ground_truth": {"modern_name": "Alps", "confidence": "high", "type": "place", "country": "Switzerland", "note": "'Alpes maritimes' is a specific part of the Alps. 'Altai' is a different mountain range, but 'Alps' is the dominant term.", "wikidata_id": "Q1151300", "wikidata_description": "Human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Autoimmune%20lymphoproliferative%20syndrome", "wikipedia_extract": "The Alps () are some of the highest and most extensive mountain ranges in Europe, stretching approximately 1,200 km (750 mi) across eight Alpine countries (from west to east): Monaco, France, Switzerland, Italy, Liechtenstein, Germany, Austria, Slovenia, and Hungary. The Alpine arch extends from Nice on the western Mediterranean to Trieste on the Adriatic and Vienna at the beginning of the Pannonian Basin. The mountains were formed over tens of millions of years as the African and Eurasian tectonic plates collided. Extreme shortening  caused by the event resulted in marine sedimentary rocks rising by thrusting and folding into high mountain peaks such as Mont Blanc and the Matterhorn. Mont Blanc spans the French-Italian border, and at 4,809 m (15,778 ft) is the highest mountain in the Alps. The Alpine region area contains 82 peaks higher than 4,000 m (13,000 ft)."}}, {"canonical_name": "Thibet", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 24, "members": [{"entity_id": "thibet", "book_id": "coloquios_da_orta_1563", "name": "Thibet", "category": "PLACE", "subcategory": "REGION", "count": 11, "variants": ["Thibet"], "contexts": ["region musk arrived through", "region in Asia"]}, {"entity_id": "taïti", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Taïti", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Taïti"], "contexts": ["island with hourly variations", "island with attributed population"]}, {"entity_id": "tibet", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tibet", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Tibet"], "contexts": ["region excluded from Tartary"]}, {"entity_id": "thibet", "book_id": "kosmos_humboldt_1845", "name": "Thibet", "category": "PLACE", "subcategory": "COUNTRY", "count": 7, "variants": ["Thibet"], "contexts": ["influence of elevated plateau", "elevated plateaux"]}, {"entity_id": "thibetian_plateau", "book_id": "kosmos_humboldt_1845", "name": "Thibetian plateau", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Thibetian plateau"], "contexts": ["high-altitude region with distinct vegetation"]}, {"entity_id": "thibetian_highlands", "book_id": "kosmos_humboldt_1845", "name": "thibetian highlands", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["thibetian highlands"], "contexts": ["highland region with altitude"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Thibet", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Taïti", "similarity": 0.859}, {"source_book": "coloquios_da_orta_1563", "source_name": "Thibet", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Tibet", "similarity": 0.9}, {"source_book": "coloquios_da_orta_1563", "source_name": "Thibet", "target_book": "kosmos_humboldt_1845", "target_name": "Thibet", "similarity": 0.849}, {"source_book": "coloquios_da_orta_1563", "source_name": "Thibet", "target_book": "kosmos_humboldt_1845", "target_name": "Thibetian plateau", "similarity": 0.876}, {"source_book": "coloquios_da_orta_1563", "source_name": "Thibet", "target_book": "kosmos_humboldt_1845", "target_name": "thibetian highlands", "similarity": 0.844}], "id": 273, "stable_key": "clu_d1485e52c9082060", "ground_truth": {"modern_name": "Tibet", "confidence": "high", "type": "place", "description": "A region in Asia, also including an island.", "note": "Includes references to Tibet and Tahiti.", "wikipedia_extract": "Tibet ( ) is a region in the western part of East Asia, covering much of the Tibetan Plateau. It is the homeland of the Tibetans. Other ethnic groups also reside on the plateau, including Mongols, the Lhoba, Monpa, Qiang, Sherpa, and since the 20th century, Han and Hui peoples. Tibet is the highest region on Earth, with an average elevation of 4,380 m (14,000 ft). Lying within the Himalayas, the highest point in Tibet is Mount Everest – the highest peak on Earth, standing 8,848 m (29,000 ft) above sea level. In the 7th century, the Yarlung dynasty expanded into surrounding areas such as Amdo."}}, {"canonical_name": "Kepler", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 23, "members": [{"entity_id": "kepler", "book_id": "kosmos_humboldt_1845", "name": "Kepler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 12, "variants": ["Kepler"], "contexts": ["author of 'Epitome Astronomiae Copernicanae'", "astronomer on planetary density and volume"]}, {"entity_id": "kepler", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Kepler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["Kepler"], "contexts": ["discovered laws of planetary motion", "astronomer known for planetary laws"]}, {"entity_id": "kepler", "book_id": "first_principles_spencer_1862", "name": "Kepler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Kepler"], "contexts": ["discovered planetary motion laws", "generalizations of Kepler expressing planet motions"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Kepler", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kepler", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Kepler", "target_book": "first_principles_spencer_1862", "target_name": "Kepler", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Kepler", "target_book": "first_principles_spencer_1862", "target_name": "Kepler", "similarity": 1.0}], "id": 274, "stable_key": "clu_28851b8e21ef4f3f", "ground_truth": {"modern_name": "Johannes Kepler", "confidence": "high", "type": "person", "birth_year": 1571, "death_year": 1630, "description": "Astronomer and mathematician, known for laws of planetary motion.", "wikidata_id": "Q8963", "wikidata_description": "German mathematician and astronomer (1571–1630)", "wikipedia_url": "https://en.wikipedia.org/wiki/Johannes%20Kepler", "wikipedia_extract": "Johannes Kepler (27 December 1571 – 15 November 1630) was a German astronomer, mathematician, astrologer, natural philosopher and music theorist. He is a key figure in the 17th-century Scientific Revolution, best known for his laws of planetary motion, and his books Astronomia nova, Harmonice Mundi, and Epitome Astronomiae Copernicanae. The variety and impact of his work made Kepler one of the founders and fathers of modern astronomy, the scientific method, natural science, and modern science. He has been described as the \"father of science fiction\" for his novel Somnium. Kepler was a mathematics teacher at a seminary school in Graz, where he became an associate of Prince Hans Ulrich von Eggenberg. Later he became an assistant to the astronomer Tycho Brahe in Prague, and eventually the imperial mathematician to Emperor Rudolf II and his two successors Matthias and Ferdinand II."}}, {"canonical_name": "Face", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "face", "book_id": "english_physician_1652", "name": "Face", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 20, "variants": ["Face", "Faces", "face"], "contexts": ["body part, can have ulcers", "body part, can have redness"]}, {"entity_id": "face", "book_id": "coloquios_da_orta_1563", "name": "face", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["face"], "contexts": ["body part that swelled"]}, {"entity_id": "facies", "book_id": "polyanthea_medicinal", "name": "facies", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["facies"], "contexts": ["face that can swell in dropsy"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Face", "target_book": "coloquios_da_orta_1563", "target_name": "face", "similarity": 0.993}, {"source_book": "english_physician_1652", "source_name": "Face", "target_book": "polyanthea_medicinal", "target_name": "facies", "similarity": 0.958}, {"source_book": "coloquios_da_orta_1563", "source_name": "face", "target_book": "polyanthea_medicinal", "target_name": "facies", "similarity": 0.964}], "id": 275, "stable_key": "clu_fb8dddd55d15df42", "ground_truth": {"modern_name": "Face", "confidence": "high", "type": "substance", "description": "The front part of a person's head, from the forehead to the chin.", "wikipedia_extract": "The face is the front of the head in humans and many other animals that features most of the sense organs including the eyes, nose and mouth. Many animals may express emotions through their face. Sense organs in the faces of different animals are varied such as the snout, and the proboscis. Many animals are flat-faced (brachycephalic) such as the pug dog. The human face is crucial for identity, and damage such as scarring or developmental deformities may adversely affect the psyche. The front of the human head is called the face."}}, {"canonical_name": "Arnaldus de Villa Nova", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "arnaldus_de_villa_nova", "book_id": "polyanthea_medicinal", "name": "Arnaldus de Villa Nova", "category": "PERSON", "subcategory": "AUTHORITY", "count": 19, "variants": ["Arnaldus de Villa Nova", "Arnald. de Vil.", "Arnaldode Villa-Nova", "Arnaldus", "Arnaldus Villa Nova", "Arnaldus de Villa-Nova", "Arnaldus de Villanov.", "aldus deVilla-Nova"], "contexts": ["author of deMorb.cur.", "author of Breviarium"]}, {"entity_id": "ar-noldus_de_villa_nova", "book_id": "english_physician_1652", "name": "Ar-noldus de villa nova", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Ar-noldus de villa nova", "Arnoldus de villa nova"], "contexts": ["medieval physician and alchemist", "commends Golden Rod"]}, {"entity_id": "arnaldo_de_villanova", "book_id": "historia_medicinal_monardes_1574", "name": "Arnaldo de Villanova", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Arnaldo de Villanova"], "contexts": ["authority on metal generation"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Arnaldus de Villa Nova", "target_book": "english_physician_1652", "target_name": "Ar-noldus de villa nova", "similarity": 0.906}, {"source_book": "polyanthea_medicinal", "source_name": "Arnaldus de Villa Nova", "target_book": "historia_medicinal_monardes_1574", "target_name": "Arnaldo de Villanova", "similarity": 0.907}, {"source_book": "english_physician_1652", "source_name": "Ar-noldus de villa nova", "target_book": "historia_medicinal_monardes_1574", "target_name": "Arnaldo de Villanova", "similarity": 0.811}], "id": 276, "stable_key": "clu_abaf844928145b9f", "ground_truth": {"modern_name": "Arnaldus de Villanova", "confidence": "high", "type": "person", "description": "Medieval Catalan physician, alchemist, and influential medical writer.", "wikipedia_extract": "Arnaldus de Villa Nova (also called Arnau de Vilanova, Arnaldus Villanovanus, Arnaud de Ville-Neuve or Arnaldo de Villanueva, c. 1240–1311) was a physician and a religious reformer. He is credited with translating a number of medical texts from Arabic, including works by Ibn Sina Avicenna, Abu-l-Salt, and Galen. Arnaldus' place and date of birth are debated: some historians believe he was born in Villeneuve-lès-Maguelone, a village near Montpellier; others are doubtful, because there are also towns of the same name in Aragon such as Villanueva de Jiloca, in the Kingdom of Valencia, in Catalonia, in Languedoc, or in the Provence. Regardless, he is known in Catalonia, Valencia, and Balearic Islands by the name \"Arnau de Vilanova,\" and it is certain that he wrote most of his works in Catalan (Confessió de Barcelona, Raonament d'Avinyó). Whatever the reality, Arnaldus had a great reputation as a doctor, theologian and alchemist. He studied medicine in Montpellier until 1260."}}, {"canonical_name": "espicanardo", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "espicanardo", "book_id": "polyanthea_medicinal", "name": "espicanardo", "category": "PLANT", "subcategory": "PLANT", "count": 11, "variants": ["espicanardo", "Eſpicanardo", "efpicanardo", "eſpicanardo"], "contexts": ["spikenard used in decoction", "spice used in a syrup"]}, {"entity_id": "spicknard", "book_id": "english_physician_1652", "name": "Spicknard", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Spicknard"], "contexts": ["herb used to strengthen medicine", "herb used with medicines"]}, {"entity_id": "espiquenardo", "book_id": "coloquios_da_orta_1563", "name": "espiquenardo", "category": "PLANT", "subcategory": "PLANT", "count": 8, "variants": ["espiquenardo", "ESPIQUENARDO", "Espiquernardo"], "contexts": ["plant with a strong smell", "plant with a strong scent, likely spikenard"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "espicanardo", "target_book": "english_physician_1652", "target_name": "Spicknard", "similarity": 0.842}, {"source_book": "polyanthea_medicinal", "source_name": "espicanardo", "target_book": "coloquios_da_orta_1563", "target_name": "espiquenardo", "similarity": 0.932}, {"source_book": "english_physician_1652", "source_name": "Spicknard", "target_book": "coloquios_da_orta_1563", "target_name": "espiquenardo", "similarity": 0.868}], "id": 277, "stable_key": "clu_b6009061b5f708f8", "ground_truth": {"modern_name": "Spikenard", "confidence": "high", "type": "plant", "description": "An aromatic herb or shrub, used in perfumery and medicine.", "wikipedia_extract": "Spikenard, also called nard, nardin, and muskroot, is a class of aromatic amber-colored essential oil derived from Nardostachys jatamansi, a flowering plant in the honeysuckle family which grows in the Himalayas of Nepal, China, and India. The oil has been used over centuries as a perfume, a traditional medicine, or in religious ceremonies across a wide territory from India to Europe. Historically, the name nard has also referred to essential oils derived from other species including the closely related valerian genus, as well as Spanish lavender; these cheaper, more common plants have been used in perfume-making, and sometimes to adulterate true spikenard. The name nard is derived from Latin nardus, from Ancient Greek νάρδος (nárdos), from  Hebrew: נֵרְדְּ (nērd). This word may ultimately derive either from Sanskrit नलद (nálada 'Indian spikenard'), or from Naarda, an ancient Assyrian city (possibly the modern town of Dohuk, Iraq). The \"spike\" in the English name refers to the inflorescence or flowering stem of the plant."}}, {"canonical_name": "Erman", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "erman", "book_id": "kosmos_humboldt_1845", "name": "Erman", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Erman"], "contexts": ["cited for magnetic declination data", "author of Physikal. Beob."]}, {"entity_id": "m__adolphe_erman", "book_id": "relation_historique_humboldt_vol3_1825", "name": "M. Adolphe Erman", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["M. Adolphe Erman", "Adolphe Erman", "Adolphe Krman"], "contexts": ["scholar who traveled in Siberia", "scholar who determined magnetic equator"]}, {"entity_id": "erman", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Erman", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Erman"], "contexts": ["M. Adolphe Erman observed", "collaborator in magnetic inclination measurement"]}, {"entity_id": "m_m__hansteen_et_erman", "book_id": "relation_historique_humboldt_vol3_1825", "name": "M M. Hansteen et Erman", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["M M. Hansteen et Erman"], "contexts": ["scholars undertaking land expeditions"]}, {"entity_id": "adolph_erman", "book_id": "kosmos_humboldt_1845", "name": "Adolph Erman", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Adolph Erman"], "contexts": ["person with meteor observations", "investigated meteoric phenomena and their connections"]}, {"entity_id": "compart_erman", "book_id": "kosmos_humboldt_1845", "name": "Compart Erman", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Compart Erman"], "contexts": ["author of 'Archiv für wissenschaftliche Kunde von Russland'"]}, {"entity_id": "adolphus_erman", "book_id": "kosmos_humboldt_1845", "name": "Adolphus Erman", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Adolphus Erman"], "contexts": ["observer of declination lines in Northern Asia"]}, {"entity_id": "erman,_adolph", "book_id": "kosmos_humboldt_1845", "name": "Erman, Adolph", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Erman, Adolph"], "contexts": ["researcher on magnetic declination"]}, {"entity_id": "erman", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Erman", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Erman"], "contexts": ["observed barometer depression in Ochotzk Sea"]}, {"entity_id": "erman,_m_", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Erman, M.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Erman, M."], "contexts": ["observed barometer depression"]}], "edges": [{"source_book": "kosmos_humb