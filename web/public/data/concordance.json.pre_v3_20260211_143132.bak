historique_humboldt_vol3_1825", "source_name": "Erman", "target_book": "kosmos_humboldt_1845", "target_name": "Adolphus Erman", "similarity": 0.847}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Erman", "target_book": "kosmos_humboldt_1845", "target_name": "Erman, Adolph", "similarity": 0.814}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Erman", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Erman", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Erman", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Erman, M.", "similarity": 0.834}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "M M. Hansteen et Erman", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Erman, M.", "similarity": 0.813}, {"source_book": "kosmos_humboldt_1845", "source_name": "Adolph Erman", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Erman", "similarity": 0.849}, {"source_book": "kosmos_humboldt_1845", "source_name": "Adolph Erman", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Erman, M.", "similarity": 0.801}, {"source_book": "kosmos_humboldt_1845", "source_name": "Compart Erman", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Erman", "similarity": 0.855}, {"source_book": "kosmos_humboldt_1845", "source_name": "Adolphus Erman", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Erman", "similarity": 0.847}, {"source_book": "kosmos_humboldt_1845", "source_name": "Erman, Adolph", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Erman", "similarity": 0.814}, {"source_book": "kosmos_humboldt_1845", "source_name": "Erman, Adolph", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Erman, M.", "similarity": 0.815}], "id": 278, "stable_key": "clu_5652eb77f27e11a6", "ground_truth": {"modern_name": "Adolf Erman", "confidence": "high", "type": "person", "birth_year": 1806, "death_year": 1877, "description": "German geographer and physicist, known for geomagnetic studies.", "note": "The text mentions 'M. Adolphe Erman' and 'Adolph Erman', likely referring to the same person.", "wikidata_id": "Q61421", "wikidata_description": "German Egyptologist and lexicographer (1854-1937)", "wikipedia_url": "https://en.wikipedia.org/wiki/Adolf%20Erman", "wikipedia_extract": "Johann Peter Adolf Erman (German: [ɛɐ̯ˈmãː]; 31 October 1854 – 26 June 1937) was a German Egyptologist and lexicographer. Born in Berlin, he was the son of the physicist Georg Adolf Erman and grandson of the physicist Paul Erman and the astronomer Friedrich Wilhelm Bessel. Educated at Leipzig and Berlin, he became associate professor of Egyptology at the University of Berlin in 1883 and full professor in 1892. In 1885 he was appointed director of the Egyptian department at the royal museum. In 1934 he was excluded from the faculty of the university because he was, according to the Nazi ideology, one quarter Jewish. As his family had converted to Protestantism in 1902, he and his family were not persecuted by the Nazi Party, but they all lost their positions."}}, {"canonical_name": "Canada", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "canada", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Canada", "category": "PLACE", "subcategory": "COUNTRY", "count": 13, "variants": ["Canada"], "contexts": ["place where quippos are found", "country with English population"]}, {"entity_id": "canada_anglois", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Canada anglois", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Canada anglois"], "contexts": ["English Canada", "English Canada, a historical region"]}, {"entity_id": "canada", "book_id": "kosmos_humboldt_1845", "name": "Canada", "category": "PLACE", "subcategory": "COUNTRY", "count": 5, "variants": ["Canada"], "contexts": ["country where Toronto is located", "proposed location for magnetic stations"]}, {"entity_id": "canada", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Canada", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Canada"], "contexts": ["country with chilly winds affecting Asia and America"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Canada", "target_book": "kosmos_humboldt_1845", "target_name": "Canada", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Canada", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Canada", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Canada anglois", "target_book": "kosmos_humboldt_1845", "target_name": "Canada", "similarity": 0.824}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Canada anglois", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Canada", "similarity": 0.824}, {"source_book": "kosmos_humboldt_1845", "source_name": "Canada", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Canada", "similarity": 1.0}], "id": 279, "stable_key": "clu_685f8df5b39303fe", "ground_truth": {"modern_name": "Canada", "confidence": "high", "type": "place", "country": "Canada", "wikidata_id": "Q16", "wikidata_description": "country in North America", "wikipedia_url": "https://en.wikipedia.org/wiki/Canada", "wikipedia_extract": "Canada is a country in North America. Its ten provinces and three territories extend from the Atlantic Ocean to the Pacific Ocean and northward into the Arctic Ocean, making it the second-largest country by total area, with the longest coastline of any country. Its border with the United States is the longest international land border. The country is characterized by a wide range of both meteorologic and geological regions. With a population of over 41 million, it has widely varying population densities, with the majority residing in its urban areas and large areas being sparsely populated. Canada's capital is Ottawa and its three largest metropolitan areas are Toronto, Montreal, and Vancouver."}}, {"canonical_name": "SEVILLA", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "sevilla", "book_id": "historia_medicinal_monardes_1574", "name": "SEVILLA", "category": "PLACE", "subcategory": "CITY", "count": 11, "variants": ["SEVILLA", "Sevilla"], "contexts": ["city name", "city where Monardes is a physician"]}, {"entity_id": "séville", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Séville", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Séville", "Seville"], "contexts": ["tobacco destined for Seville", "city"]}, {"entity_id": "sevilha", "book_id": "coloquios_da_orta_1563", "name": "Sevilha", "category": "PLACE", "subcategory": "CITY", "count": 8, "variants": ["Sevilha"], "contexts": ["city in Spain", "city where Cassia fistula was brought"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "SEVILLA", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Séville", "similarity": 0.866}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "SEVILLA", "target_book": "coloquios_da_orta_1563", "target_name": "Sevilha", "similarity": 0.9}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Séville", "target_book": "coloquios_da_orta_1563", "target_name": "Sevilha", "similarity": 0.869}], "id": 280, "stable_key": "clu_2161d98d79b2b049", "ground_truth": {"modern_name": "Seville", "confidence": "high", "type": "place", "description": "A major city in Andalusia, Spain, historically important for trade and exploration.", "wikipedia_extract": "Seville ( sə-VIL; Spanish: Sevilla, pronounced [seˈβiʎa]  locally [seˈβiʝa]) is the capital and largest city of the Spanish autonomous community of Andalusia and the province of Seville. It is situated on the lower reaches of the River Guadalquivir, in the southwest of the Iberian Peninsula. Seville has a municipal population of about 686,741 as of 2024, and a metropolitan population of about 1.5 million, making it the largest city in Andalusia and the 5th-largest city in Spain. Its old town, with an area of 4 square kilometres (2 sq mi), contains a UNESCO World Heritage Site comprising three buildings: the Alcázar palace complex, the Cathedral and the General Archive of the Indies. The Port of Seville, located about 80 kilometres (50 miles) from the Atlantic Ocean, is the only river harbour in Spain. The capital of Andalusia enjoys hot temperatures in the summer, with daily maximums routinely above 35 °C (95 °F) in July and August."}}, {"canonical_name": "Leonardo Fioravanto", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "leonardo_fioravanto", "book_id": "polyanthea_medicinal", "name": "Leonardo Fioravanto", "category": "PERSON", "subcategory": "SCHOLAR", "count": 18, "variants": ["Leonardo Fioravanto", "Leonardus Fioravantus", "Leonel. Favent."], "contexts": ["Author of 'thesauri'", "author who praised antimony"]}, {"entity_id": "leonardo_fioravanti", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Leonardo Fioravanti", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Leonardo Fioravanti"], "contexts": ["Italian physician"]}, {"entity_id": "leonardo_fuchsio", "book_id": "coloquios_da_orta_1563", "name": "Leonardo Fuchsio", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Leonardo Fuchsio"], "contexts": ["learned man who wrote about ivory", "author's name"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Leonardo Fioravanto", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Leonardo Fioravanti", "similarity": 0.993}, {"source_book": "polyanthea_medicinal", "source_name": "Leonardo Fioravanto", "target_book": "coloquios_da_orta_1563", "target_name": "Leonardo Fuchsio", "similarity": 0.841}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Leonardo Fioravanti", "target_book": "coloquios_da_orta_1563", "target_name": "Leonardo Fuchsio", "similarity": 0.835}], "id": 281, "stable_key": "clu_3b0d502482f35fba", "ground_truth": {"modern_name": "Leonardo Fioravanti", "confidence": "high", "type": "person", "description": "Italian physician and alchemist, author of 'Thesauri'.", "note": "The 'Leonardo Fuchsio' member is likely a misattribution or different spelling of Leonardo Fuchs, but given the primary context of Fioravanti's work, this identification is maintained.", "wikipedia_extract": "Leonardo Fioravanti (doctor) (1518–1588), Italian doctor Leonardo Fioravanti (engineer) (born 1938), Italian car designer and engineer Leonardo Fioravanti (surfer) (born 1997), Italian surfer"}}, {"canonical_name": "opilações", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "opilações", "book_id": "polyanthea_medicinal", "name": "opilações", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 18, "variants": ["opilações", "opilaçaó", "opilaçoens", "opilação", "opilações remas beldes", "oppilados", "oppilaçoens"], "contexts": ["obstructions, a medical condition", "obstructions, medical condition"]}, {"entity_id": "opilas", "book_id": "historia_medicinal_monardes_1574", "name": "opilas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["opilas"], "contexts": ["obstructions"]}, {"entity_id": "apilaciones", "book_id": "historia_medicinal_monardes_1574", "name": "apilaciones", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["apilaciones"], "contexts": ["illness leading to swelling"]}, {"entity_id": "opilaçam", "book_id": "coloquios_da_orta_1563", "name": "opilaçam", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["opilaçam"], "contexts": ["condition of obstruction"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "opilações", "target_book": "historia_medicinal_monardes_1574", "target_name": "opilas", "similarity": 0.914}, {"source_book": "polyanthea_medicinal", "source_name": "opilações", "target_book": "historia_medicinal_monardes_1574", "target_name": "apilaciones", "similarity": 0.848}, {"source_book": "polyanthea_medicinal", "source_name": "opilações", "target_book": "coloquios_da_orta_1563", "target_name": "opilaçam", "similarity": 0.85}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "opilas", "target_book": "coloquios_da_orta_1563", "target_name": "opilaçam", "similarity": 0.906}], "id": 282, "stable_key": "clu_13de6c8a5642f0a5", "ground_truth": {"modern_name": "Obstruction", "confidence": "high", "type": "disease", "description": "A blockage or impeded flow within the body.", "note": "Medical term referring to blockages in bodily humors or vessels.", "wikipedia_extract": "Bowel obstruction, also known as intestinal obstruction, is a mechanical or functional obstruction of the intestines that prevents the normal movement of the products of digestion. Either the small bowel or large bowel may be affected. Signs and symptoms include abdominal pain, vomiting, bloating and not passing gas. Mechanical obstruction is the cause of about 5 to 15% of cases of severe abdominal pain of sudden onset requiring admission to hospital. Causes of bowel obstruction include adhesions, hernias, volvulus, endometriosis, inflammatory bowel disease, appendicitis, tumors, diverticulitis, ischemic bowel, tuberculosis and intussusception. Small bowel obstructions are most often due to adhesions and hernias, while large bowel obstructions are most often due to tumors and volvulus."}}, {"canonical_name": "dormideyras", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "dormideyras", "book_id": "polyanthea_medicinal", "name": "dormideyras", "category": "PLANT", "subcategory": "PLANT", "count": 15, "variants": ["dormideyras", "Dormideiras", "dormideiras", "dormideyras brancas"], "contexts": ["ingredient in poultice for headaches", "sleep-inducing herbs"]}, {"entity_id": "dormideras", "book_id": "historia_medicinal_monardes_1574", "name": "Dormideras", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Dormideras"], "contexts": ["plant whose dried flowers resemble black seeds"]}, {"entity_id": "durmideiras", "book_id": "coloquios_da_orta_1563", "name": "durmideiras", "category": "PLANT", "subcategory": "PLANT", "count": 5, "variants": ["durmideiras", "dormideiras", "dormideiras brancas", "dormydeyras", "durmideiras pretas"], "contexts": ["poppy plants", "white poppy plants"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "dormideyras", "target_book": "historia_medicinal_monardes_1574", "target_name": "Dormideras", "similarity": 0.871}, {"source_book": "polyanthea_medicinal", "source_name": "dormideyras", "target_book": "coloquios_da_orta_1563", "target_name": "durmideiras", "similarity": 0.925}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Dormideras", "target_book": "coloquios_da_orta_1563", "target_name": "durmideiras", "similarity": 0.905}], "id": 283, "stable_key": "clu_91b6bd8dd611dd5d", "ground_truth": {"modern_name": "Poppy", "confidence": "high", "type": "plant", "description": "Flowering plant known for its seeds and sleep-inducing properties.", "note": "Likely refers to species of Papaver, particularly Papaver somniferum.", "wikipedia_extract": "A poppy is a flowering plant in the subfamily Papaveroideae of the family Papaveraceae. Poppies are herbaceous plants, often grown for their colourful flowers. One species of poppy, Papaver somniferum, is the source of the narcotic drug mixture opium, which contains powerful medicinal alkaloids such as morphine and has been used since ancient times as an analgesic and narcotic medicinal and recreational drug. It also produces edible seeds. Following the trench warfare in the poppy fields of Flanders, Belgium, during World War I, poppies, specifically the red poppy, have become a symbol of remembrance of soldiers who have died during wartime, especially in the UK, Canada, Australia, Africa and other Commonwealth realms. Poppies are herbaceous annual, biennial or short-lived perennial plants."}}, {"canonical_name": "oleo violado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "oleo_violado", "book_id": "polyanthea_medicinal", "name": "oleo violado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 18, "variants": ["oleo violado", "oleo viola do"], "contexts": ["a medicinal preparation", "preparation used as medicine"]}, {"entity_id": "olio_violado", "book_id": "coloquios_da_orta_1563", "name": "olio violado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["olio violado"], "contexts": ["violet-infused oil"]}, {"entity_id": "olio_violato", "book_id": "ricettario_fiorentino_1597", "name": "olio violato", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["olio violato"], "contexts": ["violet oil used in preparation", "preparation made from violets"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "oleo violado", "target_book": "coloquios_da_orta_1563", "target_name": "olio violado", "similarity": 0.988}, {"source_book": "polyanthea_medicinal", "source_name": "oleo violado", "target_book": "ricettario_fiorentino_1597", "target_name": "olio violato", "similarity": 0.986}, {"source_book": "coloquios_da_orta_1563", "source_name": "olio violado", "target_book": "ricettario_fiorentino_1597", "target_name": "olio violato", "similarity": 0.995}], "id": 284, "stable_key": "clu_bed70f6326c13d27", "ground_truth": {"modern_name": "Violet Oil", "confidence": "high", "type": "substance", "description": "Medicinal oil infused with violets.", "note": "A pharmaceutical preparation derived from violets.", "wikipedia_extract": "Essential oils are compodes of hydrophobic volatile organic compounds, usually in liquid form, obtained from plant material. Essential oils are also known as volatile oils, ethereal oils, aetheroleum, or simply as the oil of the plant from which they were extracted, such as oil of clove. An essential oil is essential in the sense that the oil contains the fragrance or essence of the plant. The term \"essential\" used here does not indicate that it is nutritionally required in the diet, as with essential amino acid or essential fatty acid. Essential oils, according to ISO, are produced either by steam distillation, by mechanical manipulation of the rind of the fruits of the genus Citrus (also called cold pressing), or by dry distillation. Other methods, such as solvent extraction, are not accepted and, in fact, result in different perfumed products (pommades, concretes, and absolutes)."}}, {"canonical_name": "sanguinha", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "sanguinha", "book_id": "polyanthea_medicinal", "name": "sanguinha", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["sanguinha", "Sanguificaçao", "sanguificaçao", "sanguificação"], "contexts": ["reddish Morfea species", "sanguine"]}, {"entity_id": "sanguifie", "book_id": "english_physician_1652", "name": "Sanguifie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Sanguifie"], "contexts": ["I would have said [Sanguifie] if I had written only to Schollers"]}, {"entity_id": "sangrarla", "book_id": "historia_medicinal_monardes_1574", "name": "sangrarla", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sangrarla"], "contexts": ["medical practice of bloodletting"]}, {"entity_id": "sangria", "book_id": "historia_medicinal_monardes_1574", "name": "sangria", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sangria"], "contexts": ["bloodletting, to be avoided"]}, {"entity_id": "sanguinho", "book_id": "polyanthea_medicinal", "name": "sanguinho", "category": "CONCEPT", "subcategory": "QUALITY", "count": 7, "variants": ["sanguinho", "sangui.nho", "sanguin", "sanguinhos"], "contexts": ["sanguine temperament", "medical condition"]}, {"entity_id": "sanguineo", "book_id": "historia_medicinal_monardes_1574", "name": "sanguineo", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["sanguineo"], "contexts": ["patient with sanguine temperament", "sanguine humor"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "sanguinha", "target_book": "english_physician_1652", "target_name": "Sanguifie", "similarity": 0.886}, {"source_book": "polyanthea_medicinal", "source_name": "sanguinha", "target_book": "historia_medicinal_monardes_1574", "target_name": "sangrarla", "similarity": 0.874}, {"source_book": "polyanthea_medicinal", "source_name": "sanguinha", "target_book": "historia_medicinal_monardes_1574", "target_name": "sangria", "similarity": 0.899}, {"source_book": "english_physician_1652", "source_name": "Sanguifie", "target_book": "historia_medicinal_monardes_1574", "target_name": "sangrarla", "similarity": 0.821}, {"source_book": "english_physician_1652", "source_name": "Sanguifie", "target_book": "historia_medicinal_monardes_1574", "target_name": "sangria", "similarity": 0.87}, {"source_book": "polyanthea_medicinal", "source_name": "sanguinho", "target_book": "historia_medicinal_monardes_1574", "target_name": "sanguineo", "similarity": 0.938}], "id": 285, "stable_key": "clu_530a21b35b1e6068", "ground_truth": {"modern_name": "Sanguine", "confidence": "high", "type": "concept", "description": "Relating to blood, or a cheerful and hopeful temperament.", "note": "Can refer to blood, the sanguine temperament, or bloodletting.", "wikipedia_extract": "The four temperament theory is a proto-psychological theory which suggests that there are four fundamental personality types: sanguine, choleric, melancholic, and phlegmatic. Most formulations include the possibility of mixtures among the types where an individual's personality types overlap and they share two or more temperaments. Greek physician Hippocrates (c. 460 – c. 370 BC) described the four temperaments as part of the ancient medical concept of humourism, that four bodily fluids affect human personality traits and behaviours. Modern medical science does not define a fixed relationship between internal secretions and personality, although some psychological personality type systems use categories similar to the Greek temperaments. The four temperament theory was abandoned after the 1850s. Temperament theory has its roots in the ancient theory of humourism."}}, {"canonical_name": "Somno", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "somno", "book_id": "polyanthea_medicinal", "name": "Somno", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 14, "variants": ["Somno", "Somnoque", "somno"], "contexts": ["sleep, a symptom or condition", "sleep"]}, {"entity_id": "sleep", "book_id": "english_physician_1652", "name": "sleep", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Sleep", "sleep"], "contexts": ["state procured by a remedy", "lack of it helped by herb application"]}, {"entity_id": "somnambulic", "book_id": "principles_of_psychology_james_1890", "name": "somnambulic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["somnambulic"], "contexts": ["state of Léonie 3"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Somno", "target_book": "english_physician_1652", "target_name": "sleep", "similarity": 0.906}, {"source_book": "polyanthea_medicinal", "source_name": "Somno", "target_book": "principles_of_psychology_james_1890", "target_name": "somnambulic", "similarity": 0.866}], "id": 286, "stable_key": "clu_17d913be9bff2fd7", "ground_truth": {"modern_name": "Sleep", "confidence": "high", "type": "concept", "description": "A natural periodic state of rest for the body and mind.", "wikipedia_extract": "Sleep is a state of reduced mental and physical activity in which consciousness is altered and certain sensory activity is inhibited. During sleep, there is a marked decrease in muscle activity and interactions with the surrounding environment. While sleep differs from wakefulness in terms of the ability to react to stimuli, it still involves active brain patterns, making it more reactive than a coma or disorders of consciousness. Sleep occurs in repeating periods, during which the body alternates between two distinct modes: rapid eye movement sleep (REM) and non-REM sleep. Although REM stands for \"rapid eye movement\", this mode of sleep has many other aspects, including virtual paralysis of the body. Dreams are a succession of images, ideas, emotions, and sensations that usually occur involuntarily in the mind during certain stages of sleep."}}, {"canonical_name": "silurian", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "silurian", "book_id": "kosmos_humboldt_1845", "name": "silurian", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["silurian"], "contexts": ["geological formation", "geological period"]}, {"entity_id": "silurian_epoch", "book_id": "origin_of_species_darwin_1859", "name": "Silurian epoch", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Silurian epoch", "silurian epoch"], "contexts": ["antecedent to the silurian epoch", "geological time period"]}, {"entity_id": "silurian_system", "book_id": "origin_of_species_darwin_1859", "name": "Silurian system", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Silurian system"], "contexts": ["geological system below Devonian", "geological system with early life forms"]}, {"entity_id": "silurian_colonies", "book_id": "origin_of_species_darwin_1859", "name": "Silurian colonies", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Silurian colonies"], "contexts": ["M. Barrande on"]}, {"entity_id": "silurian_epoch", "book_id": "first_principles_spencer_1862", "name": "Silurian epoch", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Silurian epoch"], "contexts": ["geologic epoch with living forms"]}, {"entity_id": "silurian_period", "book_id": "first_principles_spencer_1862", "name": "Silurian period", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Silurian period"], "contexts": ["period with crust subsidences"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "silurian", "target_book": "origin_of_species_darwin_1859", "target_name": "Silurian epoch", "similarity": 0.822}, {"source_book": "kosmos_humboldt_1845", "source_name": "silurian", "target_book": "origin_of_species_darwin_1859", "target_name": "Silurian system", "similarity": 0.856}, {"source_book": "kosmos_humboldt_1845", "source_name": "silurian", "target_book": "origin_of_species_darwin_1859", "target_name": "Silurian colonies", "similarity": 0.835}, {"source_book": "kosmos_humboldt_1845", "source_name": "silurian", "target_book": "first_principles_spencer_1862", "target_name": "Silurian epoch", "similarity": 0.822}, {"source_book": "kosmos_humboldt_1845", "source_name": "silurian", "target_book": "first_principles_spencer_1862", "target_name": "Silurian period", "similarity": 0.814}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Silurian epoch", "target_book": "first_principles_spencer_1862", "target_name": "Silurian epoch", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Silurian epoch", "target_book": "first_principles_spencer_1862", "target_name": "Silurian period", "similarity": 0.973}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Silurian system", "target_book": "first_principles_spencer_1862", "target_name": "Silurian epoch", "similarity": 0.882}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Silurian system", "target_book": "first_principles_spencer_1862", "target_name": "Silurian period", "similarity": 0.882}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Silurian colonies", "target_book": "first_principles_spencer_1862", "target_name": "Silurian epoch", "similarity": 0.896}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Silurian colonies", "target_book": "first_principles_spencer_1862", "target_name": "Silurian period", "similarity": 0.895}], "id": 287, "stable_key": "clu_9866ba55e3ec72d0", "ground_truth": {"modern_name": "Silurian", "confidence": "high", "type": "concept", "note": "Refers to the Silurian geological period and system.", "wikidata_id": "Q62412", "wikidata_description": "third period of the Paleozoic Era", "wikipedia_url": "https://en.wikipedia.org/wiki/Silurian", "wikipedia_extract": "The Silurian ( sih-LURE-ee-ən, sy-) is a geologic period and system spanning 23.5 million years from the end of the Ordovician Period, at 443.1 Ma (million years ago) to the beginning of the Devonian Period, 419.62 Ma. The Silurian is the third and shortest period of the Paleozoic Era, and the third of twelve periods of the Phanerozoic Eon. As with other geologic periods, the rock beds that define the period's start and end are well identified, but the exact dates are uncertain by a few million years. The base of the Silurian is set at a series of major Ordovician–Silurian extinction events when up to 60% of marine genera were wiped out. One important event in this period was the initial establishment of terrestrial life in what is known as the Silurian-Devonian Terrestrial Revolution: vascular plants emerged from more primitive land plants, dikaryan fungi started expanding and diversifying along with glomeromycotan fungi, and three groups of arthropods (myriapods, arachnids and hexapods) became fully terrestrialized. Another significant evolutionary milestone during the Silurian was the diversification of jawed fish, which include placoderms, acanthodians (which gave rise to cartilaginous fish) and osteichthyan (bony fish, further divided into lobe-finned and ray-finned fishes), although this corresponded to sharp decline of jawless fish such as conodonts and ostracoderms."}}, {"canonical_name": "ABortion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 19, "members": [{"entity_id": "abortion", "book_id": "english_physician_1652", "name": "ABortion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 9, "variants": ["ABortion", "Abortion", "Abortment", "abortion", "abortment"], "contexts": ["condition prevented by plantain root decoction", "risk associated with Briony use"]}, {"entity_id": "abortion", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "abortion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["abortion"], "contexts": ["medical condition"]}, {"entity_id": "abortus", "book_id": "polyanthea_medicinal", "name": "abortus", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 6, "variants": ["abortus", "aborto", "abortui", "abortum"], "contexts": ["miscarriage", "condition of premature expulsion of fetus"]}, {"entity_id": "abortire", "book_id": "polyanthea_medicinal", "name": "abortire", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["abortire", "abortive"], "contexts": ["miscarriage", "medical condition of miscarriage"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "ABortion", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "abortion", "similarity": 0.861}, {"source_book": "english_physician_1652", "source_name": "ABortion", "target_book": "polyanthea_medicinal", "target_name": "abortus", "similarity": 0.853}, {"source_book": "english_physician_1652", "source_name": "ABortion", "target_book": "polyanthea_medicinal", "target_name": "abortire", "similarity": 0.865}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "abortion", "target_book": "polyanthea_medicinal", "target_name": "abortus", "similarity": 0.994}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "abortion", "target_book": "polyanthea_medicinal", "target_name": "abortire", "similarity": 0.988}], "id": 288, "stable_key": "clu_b57bcb85da5c7ed3", "ground_truth": {"modern_name": "abortion", "confidence": "high", "type": "disease", "description": "The premature expulsion of a fetus from the uterus.", "wikipedia_extract": "Abortion is the termination of a pregnancy by removal or expulsion of an embryo or fetus. The unmodified word abortion generally refers to induced abortion, or deliberate actions to end a pregnancy. Abortion occurring without intervention is known as spontaneous abortion or \"miscarriage\", and occurs in roughly 30–40% of all pregnancies. Common reasons for inducing an abortion are birth-timing and limiting family size. Other reasons include maternal health, an inability to afford a child, domestic violence, lack of support, feelings of being too young, wishing to complete an education or advance a career, and not being able, or willing, to raise a child conceived as a result of rape or incest. When done legally in industrialized societies, induced abortion is one of the safest procedures in medicine."}}, {"canonical_name": "Woods", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 19, "members": [{"entity_id": "woods", "book_id": "english_physician_1652", "name": "Woods", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 17, "variants": ["Woods"], "contexts": ["habitat for Alder-Tree", "habitat for Yellow-Archangel"]}, {"entity_id": "woods", "book_id": "principles_of_psychology_james_1890", "name": "woods", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["woods"], "contexts": ["areas covered with trees"]}, {"entity_id": "wood_hills", "book_id": "kosmos_humboldt_1845", "name": "Wood Hills", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Wood Hills"], "contexts": ["location in New Siberia"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Woods", "target_book": "principles_of_psychology_james_1890", "target_name": "woods", "similarity": 0.949}, {"source_book": "english_physician_1652", "source_name": "Woods", "target_book": "kosmos_humboldt_1845", "target_name": "Wood Hills", "similarity": 0.91}, {"source_book": "principles_of_psychology_james_1890", "source_name": "woods", "target_book": "kosmos_humboldt_1845", "target_name": "Wood Hills", "similarity": 0.857}], "id": 289, "stable_key": "clu_94d5d7004fce0c9f", "ground_truth": {"modern_name": "woods", "confidence": "high", "type": "place", "description": "An area characterized by the presence of trees.", "wikipedia_extract": "A woodland ( ) is, in the broad sense, land covered with woody plants (trees and shrubs), or in a narrow sense, synonymous with wood (or in the U.S., the plurale tantum woods), a low-density forest forming open habitats with plenty of sunlight and limited shade (see differences between British, American and Australian English explained below). Some savannas may also be woodlands, such as savanna woodland, where trees and shrubs form a light canopy. Woodlands may support an understory of shrubs and herbaceous plants including grasses. Woodland may form a transition to shrubland under drier conditions or during early stages of primary or secondary succession. Higher-density areas of trees with a largely closed canopy that provides extensive and nearly continuous shade are often referred to as forests. Extensive efforts by conservationist groups have been made to preserve woodlands from urbanization and agriculture."}}, {"canonical_name": "boticas", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 19, "members": [{"entity_id": "boticas", "book_id": "polyanthea_medicinal", "name": "boticas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 13, "variants": ["boticas", "botica"], "contexts": ["Pharmacies where medicines are sold", "pharmacies containing antidotes"]}, {"entity_id": "boticas", "book_id": "historia_medicinal_monardes_1574", "name": "Boticas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Boticas", "botica"], "contexts": ["places where medicines are compounded", "apothecary's shop"]}, {"entity_id": "boticas", "book_id": "coloquios_da_orta_1563", "name": "boticas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["boticas", "botyca"], "contexts": ["apothecaries' shops", "place where turbith is sold"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "boticas", "target_book": "historia_medicinal_monardes_1574", "target_name": "Boticas", "similarity": 0.975}, {"source_book": "polyanthea_medicinal", "source_name": "boticas", "target_book": "coloquios_da_orta_1563", "target_name": "boticas", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Boticas", "target_book": "coloquios_da_orta_1563", "target_name": "boticas", "similarity": 0.975}], "id": 290, "stable_key": "clu_42e4406e36d16aef", "ground_truth": {"modern_name": "Pharmacy", "confidence": "high", "type": "place", "description": "Establishment where medicines are prepared and sold.", "note": "'boticas' translates to pharmacies or apothecaries' shops.", "wikipedia_extract": "Pharmacy is the science and practice of discovering, producing, preparing, dispensing, reviewing and monitoring medications, aiming to ensure the safe, effective, and affordable use of medicines. It is a miscellaneous science as it links health sciences with pharmaceutical sciences and natural sciences. The professional practice is becoming more clinically oriented as most of the drugs are now manufactured by pharmaceutical industries. Based on the setting, pharmacy practice is either classified as community or institutional pharmacy. Providing direct patient care in the community of institutional pharmacies is considered clinical pharmacy. The scope of pharmacy practice includes more traditional roles such as compounding and dispensing of medications."}}, {"canonical_name": "fleymaticos", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "fleymaticos", "book_id": "polyanthea_medicinal", "name": "fleymaticos", "category": "CONCEPT", "subcategory": "QUALITY", "count": 10, "variants": ["fleymaticos", "flegmático", "fleumatico"], "contexts": ["phlegmatic humors causing tremors", "describing a humoral imbalance"]}, {"entity_id": "flegmatick", "book_id": "english_physician_1652", "name": "Flegmatick", "category": "CONCEPT", "subcategory": "QUALITY", "count": 7, "variants": ["Flegmatick", "Flegmatick quality"], "contexts": ["quality purged by the spring drink", "quality associated with phlegm humor"]}, {"entity_id": "flegmaticas", "book_id": "historia_medicinal_monardes_1574", "name": "flegmaticas", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["flegmaticas"], "contexts": ["phlegmatic humors associated with fevers"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "fleymaticos", "target_book": "english_physician_1652", "target_name": "Flegmatick", "similarity": 0.885}, {"source_book": "polyanthea_medicinal", "source_name": "fleymaticos", "target_book": "historia_medicinal_monardes_1574", "target_name": "flegmaticas", "similarity": 0.887}, {"source_book": "english_physician_1652", "source_name": "Flegmatick", "target_book": "historia_medicinal_monardes_1574", "target_name": "flegmaticas", "similarity": 0.874}], "id": 291, "stable_key": "clu_576d76eacc4e79a1", "ground_truth": {"modern_name": "Phlegmatic", "confidence": "high", "type": "concept", "description": "Relating to the humor phlegm, associated with a particular temperament.", "note": "'fleymaticos' and its variations refer to the humoral concept of phlegm.", "wikipedia_extract": "The four temperament theory is a proto-psychological theory which suggests that there are four fundamental personality types: sanguine, choleric, melancholic, and phlegmatic. Most formulations include the possibility of mixtures among the types where an individual's personality types overlap and they share two or more temperaments. Greek physician Hippocrates (c. 460 – c. 370 BC) described the four temperaments as part of the ancient medical concept of humourism, that four bodily fluids affect human personality traits and behaviours. Modern medical science does not define a fixed relationship between internal secretions and personality, although some psychological personality type systems use categories similar to the Greek temperaments. The four temperament theory was abandoned after the 1850s. Temperament theory has its roots in the ancient theory of humourism."}}, {"canonical_name": "magnetic needle", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "magnetic_needle", "book_id": "kosmos_humboldt_1845", "name": "magnetic needle", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 12, "variants": ["magnetic needle"], "contexts": ["declination at any point on Earth", "device for indicating magnetic north"]}, {"entity_id": "magnetic_needle", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic needle", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["magnetic needle"], "contexts": ["device indicating magnetic north", "instrument deflected by magnetic force"]}, {"entity_id": "magnetized_needle", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetized needle", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["magnetized needle"], "contexts": ["device used to detect magnetic fields", "influenced by voltaic science"]}, {"entity_id": "magnetic_needle", "book_id": "first_principles_spencer_1862", "name": "magnetic needle", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["magnetic needle"], "contexts": ["component of a compass"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "magnetic needle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic needle", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic needle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetized needle", "similarity": 0.969}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic needle", "target_book": "first_principles_spencer_1862", "target_name": "magnetic needle", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "magnetic needle", "target_book": "first_principles_spencer_1862", "target_name": "magnetic needle", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "magnetized needle", "target_book": "first_principles_spencer_1862", "target_name": "magnetic needle", "similarity": 0.969}], "id": 292, "stable_key": "clu_18900157796a06b8", "ground_truth": {"modern_name": "magnetic needle", "confidence": "high", "type": "object", "wikidata_id": "Q129950755", "wikidata_description": "scholarly article published in April 2024", "wikipedia_extract": "Magnetic declination (also called magnetic variation) is the angle between magnetic north and true north at a particular location on the Earth's surface. The angle can change over time due to polar wandering. Magnetic north is the direction that the north end of a magnetized compass needle points, which corresponds to the direction of the Earth's magnetic field lines. True north is the direction along a meridian towards the geographic North Pole. Somewhat more formally, Bowditch defines variation as \"the angle between the magnetic and geographic meridians at any place, expressed in degrees and minutes east or west to indicate the direction of magnetic north from true north. The angle between magnetic and grid meridians is called grid magnetic angle, grid variation, or grivation.\" By convention, declination is positive when magnetic north is east of true north, and negative when it is to the west.", "wikipedia_url": "https://en.wikipedia.org/wiki/Magnetic_declination"}}, {"canonical_name": "Oppio", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "oppio", "book_id": "ricettario_fiorentino_1597", "name": "Oppio", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 16, "variants": ["Oppio", "OppioTebaico", "oppio", "oppio hispano", "oppio thebaico"], "contexts": ["juice from poppy heads and leaves", "opium used in pills and trochisci"]}, {"entity_id": "opi", "book_id": "historia_medicinal_monardes_1574", "name": "Opi", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Opi"], "contexts": ["substance requested by an Indian"]}, {"entity_id": "opioi", "book_id": "coloquios_da_orta_1563", "name": "opioi", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["opioi"], "contexts": ["term for opium"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Oppio", "target_book": "historia_medicinal_monardes_1574", "target_name": "Opi", "similarity": 0.883}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Oppio", "target_book": "coloquios_da_orta_1563", "target_name": "opioi", "similarity": 0.886}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Opi", "target_book": "coloquios_da_orta_1563", "target_name": "opioi", "similarity": 0.92}], "id": 293, "stable_key": "clu_9cdc8def07631257", "ground_truth": {"modern_name": "Opium", "confidence": "high", "type": "substance", "description": "Narcotic substance obtained from the opium poppy.", "note": "'Oppio' and its variations refer to opium.", "wikipedia_extract": "Opium (also known as poppy tears, or Lachryma papaveris) is the dried latex obtained from the seed capsules of the opium poppy Papaver somniferum. Approximately 12 percent of opium is made up of the analgesic alkaloid morphine, which is processed chemically to produce heroin and other synthetic opioids for medicinal use and for the illegal drug trade. Opium's main psychoactive alkaloids, primarily morphine, act on μ-opioid receptors, causing analgesia, with long-term use leading to tolerance and dependence. The latex also contains the closely related opiates codeine and thebaine, and non-analgesic alkaloids such as papaverine and noscapine. The traditional, labor-intensive method of obtaining the latex is to scratch (\"score\") the immature seed pods (fruits) by hand; the latex leaks out and dries to a sticky yellowish residue that is later scraped off and dehydrated. The English word for opium is borrowed from Latin, which in turn comes from Ancient Greek: ὄπιον (ópion), a diminutive of ὀπός (opós, 'juice of a plant')."}}, {"canonical_name": "Coloquintida", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "coloquintida", "book_id": "ricettario_fiorentino_1597", "name": "Coloquintida", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["Coloquintida", "Colocynth'M", "Colocynthida", "Colocyntida", "Cploquintida", "Golocynthida"], "contexts": ["colocynth", "bitter gourd used in preparations"]}, {"entity_id": "colocynthis", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Colocynthis", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Colocynthis"], "contexts": ["plant for decoction"]}, {"entity_id": "coloquintidas", "book_id": "polyanthea_medicinal", "name": "coloquintidas", "category": "PLANT", "subcategory": "PLANT", "count": 8, "variants": ["coloquintidas", "Colocynthide", "Coloquintida", "Coloquintidas", "colocynthide", "coloquinti"], "contexts": ["ingredient in plaster", "plant used in remedies"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Coloquintida", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Colocynthis", "similarity": 0.881}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Coloquintida", "target_book": "polyanthea_medicinal", "target_name": "coloquintidas", "similarity": 0.88}], "id": 294, "stable_key": "clu_e152a87d07fe476c", "ground_truth": {"modern_name": "Colocynth", "confidence": "high", "type": "plant", "linnaean": "Citrullus colocynthis", "family": "Cucurbitaceae", "description": "A bitter gourd plant used as an ingredient in medicinal preparations.", "note": "Includes singular and plural forms in Italian and English.", "wikipedia_extract": "Citrullus colocynthis, with many common names including colocynth, bitter apple, bitter cucumber, vine of Sodom, or wild gourd, is a poisonous desert viny plant native to the Mediterranean Basin and West Asia, especially the Levant, Turkey (especially in regions such as İzmir), and Nubia. It resembles a common watermelon vine but bears small, hard fruits with a bitter pulp. The plant contains cytotoxic cucurbitacins and is thus unsafe to use as an herbal medicine. It originally bore the scientific name Colocynthis citrullus. The vine ranges from 2.4–3 metres (8–10 feet) in length. The roots are large, fleshy, and perennial, leading to a high survival rate due to the long tap root."}}, {"canonical_name": "Sussex", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "sussex", "book_id": "english_physician_1652", "name": "Sussex", "category": "PLACE", "subcategory": "REGION", "count": 15, "variants": ["Sussex"], "contexts": ["county where a student lived", "county where Dog-wood is called"]}, {"entity_id": "suffolk", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Suffolk", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Suffolk"], "contexts": ["county in England"]}, {"entity_id": "sussex", "book_id": "origin_of_species_darwin_1859", "name": "Sussex", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Sussex"], "contexts": ["location of ant nest observations"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Sussex", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Suffolk", "similarity": 0.851}, {"source_book": "english_physician_1652", "source_name": "Sussex", "target_book": "origin_of_species_darwin_1859", "target_name": "Sussex", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Suffolk", "target_book": "origin_of_species_darwin_1859", "target_name": "Sussex", "similarity": 0.851}], "id": 295, "stable_key": "clu_f6a10cc378303179", "ground_truth": {"modern_name": "Sussex", "confidence": "high", "type": "place", "description": "A county in England, mentioned for local flora and fauna observations.", "wikipedia_extract": "Sussex (/ˈsʌsɪks/;  from the Old English Sūþseaxe; lit. 'South Saxons'; 'Sussex') is an area of South East England that was historically a kingdom and, later, a county. The current ceremonial counties of East Sussex and West Sussex cover approximately the same area. The two ceremonial counties border Surrey to the north, Kent to the north-east, the English Channel to the south, and Hampshire to the west. Sussex contains the city of Brighton and Hove and its wider city region, part of the South Downs National Park and the national landscape of the High Weald, and Chichester Harbour. Its coastline is 137 miles (220 km) long. The Kingdom of Sussex emerged in the fifth century in the area that had previously been inhabited by the Regni tribe in the Romano-British period."}}, {"canonical_name": "sleep", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "sleep", "book_id": "principles_of_psychology_james_1890", "name": "sleep", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 10, "variants": ["sleep", "Sleep"], "contexts": ["state of rest and unconsciousness", "state of rest with increased phosphorus excretion"]}, {"entity_id": "sleep", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "sleep", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["sleep"], "contexts": ["state of unconsciousness"]}, {"entity_id": "privation_of_sleep", "book_id": "principles_of_psychology_james_1890", "name": "privation of sleep", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["privation of sleep"], "contexts": ["lack of rest"]}, {"entity_id": "sound_sleep", "book_id": "principles_of_psychology_james_1890", "name": "sound sleep", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["sound sleep"], "contexts": ["state of unconsciousness for the self"]}, {"entity_id": "sleep-walking", "book_id": "principles_of_psychology_james_1890", "name": "sleep-walking", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["sleep-walking"], "contexts": ["walking during sleep"]}, {"entity_id": "falling_asleep", "book_id": "principles_of_psychology_james_1890", "name": "falling asleep", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["falling asleep"], "contexts": ["transition state to sleep"]}, {"entity_id": "sleep", "book_id": "first_principles_spencer_1862", "name": "sleep", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["sleep"], "contexts": ["state of rest and reduced activity", "lowering of functional activity"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "sleep", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "sleep", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sleep", "target_book": "first_principles_spencer_1862", "target_name": "sleep", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sleep", "target_book": "principles_of_psychology_james_1890", "target_name": "privation of sleep", "similarity": 0.889}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sleep", "target_book": "principles_of_psychology_james_1890", "target_name": "sound sleep", "similarity": 0.862}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sleep", "target_book": "principles_of_psychology_james_1890", "target_name": "sleep-walking", "similarity": 0.875}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sleep", "target_book": "principles_of_psychology_james_1890", "target_name": "falling asleep", "similarity": 0.909}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sleep", "target_book": "first_principles_spencer_1862", "target_name": "sleep", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "privation of sleep", "target_book": "first_principles_spencer_1862", "target_name": "sleep", "similarity": 0.889}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sound sleep", "target_book": "first_principles_spencer_1862", "target_name": "sleep", "similarity": 0.862}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sleep-walking", "target_book": "first_principles_spencer_1862", "target_name": "sleep", "similarity": 0.875}, {"source_book": "principles_of_psychology_james_1890", "source_name": "falling asleep", "target_book": "first_principles_spencer_1862", "target_name": "sleep", "similarity": 0.909}], "id": 296, "stable_key": "clu_63ca9c925060d292", "ground_truth": {"modern_name": "sleep", "confidence": "high", "type": "concept", "note": "While sleep is a biological state, in the context of these texts, it functions as a concept being discussed or contrasted.", "wikidata_id": "Q35831", "wikidata_description": "naturally recurring resting state of mind and body", "wikipedia_url": "https://en.wikipedia.org/wiki/Sleep", "wikipedia_extract": "Sleep is a state of reduced mental and physical activity in which consciousness is altered and certain sensory activity is inhibited. During sleep, there is a marked decrease in muscle activity and interactions with the surrounding environment. While sleep differs from wakefulness in terms of the ability to react to stimuli, it still involves active brain patterns, making it more reactive than a coma or disorders of consciousness. Sleep occurs in repeating periods, during which the body alternates between two distinct modes: rapid eye movement sleep (REM) and non-REM sleep. Although REM stands for \"rapid eye movement\", this mode of sleep has many other aspects, including virtual paralysis of the body. Dreams are a succession of images, ideas, emotions, and sensations that usually occur involuntarily in the mind during certain stages of sleep."}}, {"canonical_name": "curar", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "curar", "book_id": "polyanthea_medicinal", "name": "curar", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 9, "variants": ["curar", "curarem", "curas"], "contexts": ["act of healing", "can cure many diseases"]}, {"entity_id": "cura", "book_id": "historia_medicinal_monardes_1574", "name": "cura", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["cura"], "contexts": ["cure, of diseases using cooled beverages"]}, {"entity_id": "cura", "book_id": "coloquios_da_orta_1563", "name": "cura", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 7, "variants": ["cura", "Cura", "curar", "curas"], "contexts": ["type of distilled spirit", "Sanskrit word for palm sap"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "curar", "target_book": "historia_medicinal_monardes_1574", "target_name": "cura", "similarity": 0.921}, {"source_book": "polyanthea_medicinal", "source_name": "curar", "target_book": "coloquios_da_orta_1563", "target_name": "cura", "similarity": 0.921}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "cura", "target_book": "coloquios_da_orta_1563", "target_name": "cura", "similarity": 1.0}], "id": 297, "stable_key": "clu_c2bcb4ae6aec6f3f", "ground_truth": {"modern_name": "To cure", "confidence": "high", "type": "concept", "description": "The act of healing or restoring to health.", "note": "'curar' and its variations relate to the act of healing.", "wikipedia_extract": "The Cure are an English rock band formed in Crawley in 1976 by Robert Smith (vocals, guitar) and Lol Tolhurst (drums). As of 2026, the band's line-up comprises Smith, Simon Gallup (bass), Roger O'Donnell (keyboards), Jason Cooper (drums) and Reeves Gabrels (guitar). Smith has remained the only constant member throughout numerous line-up changes since the band's formation. Three Imaginary Boys (the Cure's 1979 debut album) and several early singles placed the band at the forefront of the emerging post-punk and new wave movements that were gaining prominence in the United Kingdom. The band adopted an increasingly dark and tormented style beginning with their second album Seventeen Seconds (1980), which had a strong influence on the emerging genre of gothic rock. After the release of their fourth album Pornography (1982), Smith started to introduce more pop into the band's music."}}, {"canonical_name": "Celidonia", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "celidonia", "book_id": "polyanthea_medicinal", "name": "Celidonia", "category": "PLANT", "subcategory": "PLANT", "count": 11, "variants": ["Celidonia", "Celidonium", "celidonia"], "contexts": ["celandine, ingredient for ointment", "herb used in eye collirium"]}, {"entity_id": "celidonia", "book_id": "coloquios_da_orta_1563", "name": "celidonia", "category": "PLANT", "subcategory": "PLANT", "count": 5, "variants": ["celidonia", "celidonia maior", "cilidonia"], "contexts": ["plant possibly confused with memiran", "plant mentioned with numbers"]}, {"entity_id": "celidonia", "book_id": "ricettario_fiorentino_1597", "name": "Celidonia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Celidonia"], "contexts": ["herb used in preparations"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Celidonia", "target_book": "coloquios_da_orta_1563", "target_name": "celidonia", "similarity": 0.955}, {"source_book": "polyanthea_medicinal", "source_name": "Celidonia", "target_book": "ricettario_fiorentino_1597", "target_name": "Celidonia", "similarity": 0.911}, {"source_book": "coloquios_da_orta_1563", "source_name": "celidonia", "target_book": "ricettario_fiorentino_1597", "target_name": "Celidonia", "similarity": 0.882}], "id": 298, "stable_key": "clu_78ce2cd18b6426d7", "ground_truth": {"modern_name": "Celandine", "confidence": "high", "type": "plant", "linnaean": "Chelidonium majus", "family": "Papaveraceae", "description": "Herb with yellow flowers, used in traditional medicine, especially for eyes.", "wikipedia_extract": "Chelidonium majus, the greater celandine, is a perennial herbaceous flowering plant in the poppy family Papaveraceae. One of two species in the genus Chelidonium, it is native to Europe and western Asia and introduced widely in North America. The plant known as lesser celandine (Ficaria verna) is not closely related, as it belongs to the buttercup family Ranunculaceae. Greater celandine is a perennial herbaceous plant with an erect habit, and reaches 30–120 cm (12–47 in) high. The blue-green leaves are pinnate with lobed and wavy margins, up to 30 cm (12 in) long. When injured, the plant exudes a yellow to orange latex."}}, {"canonical_name": "Centaurea menor", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "centaurea_menor", "book_id": "polyanthea_medicinal", "name": "Centaurea menor", "category": "PLANT", "subcategory": "PLANT", "count": 12, "variants": ["Centaurea menor", "Centaurei minoris", "Centauria minor", "centaurea menor"], "contexts": ["ingredient in a preparation", "herb used in remedies"]}, {"entity_id": "lesser_centaury", "book_id": "english_physician_1652", "name": "lesser Centaury", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["lesser Centaury"], "contexts": ["plant with leaves similar to St. Johns-wort"]}, {"entity_id": "centaurea", "book_id": "ricettario_fiorentino_1597", "name": "Centaurea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Centaurea", "Centauria", "Centautea"], "contexts": ["herb used in preparations", "centaury herb used in powders"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Centaurea menor", "target_book": "english_physician_1652", "target_name": "lesser Centaury", "similarity": 0.857}, {"source_book": "polyanthea_medicinal", "source_name": "Centaurea menor", "target_book": "ricettario_fiorentino_1597", "target_name": "Centaurea", "similarity": 0.81}], "id": 299, "stable_key": "clu_e208bbdb44df51ed", "ground_truth": {"modern_name": "Lesser Centaury", "confidence": "high", "type": "plant", "linnaean": "Centaurium erythraea", "family": "Gentianaceae", "description": "Herb with pink flowers, historically used for digestive and tonic properties.", "wikipedia_extract": "Centaurium erythraea is a species of flowering plant in the gentian family known by the names common centaury and European centaury. It is also commonly known as feverfoullie, gentian or centaury. This is an upright biennial herb which reaches half a meter in height. It grows from a small basal rosette and bolts a leafy, upright stem which may branch. The triangular leaves are arranged oppositely on the stem and the upright inflorescences emerge from the stem and grow parallel to it, sometimes tangling with the foliage. Each inflorescence may contain many flowers."}}, {"canonical_name": "Agassiz", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "agassiz", "book_id": "origin_of_species_darwin_1859", "name": "Agassiz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 8, "variants": ["Agassiz"], "contexts": ["remarked on blind fish", "palæontologist arguing against transmutation"]}, {"entity_id": "l__agassiz", "book_id": "principles_of_psychology_james_1890", "name": "L. Agassiz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["L. Agassiz"], "contexts": ["Professor who suggested fishermen are more intelligent"]}, {"entity_id": "agassiz", "book_id": "kosmos_humboldt_1845", "name": "Agassiz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 8, "variants": ["Agassiz"], "contexts": ["author of work on fossil fishes", "ichthyologist and paleontologist"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Agassiz", "target_book": "principles_of_psychology_james_1890", "target_name": "L. Agassiz", "similarity": 0.849}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Agassiz", "target_book": "kosmos_humboldt_1845", "target_name": "Agassiz", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "L. Agassiz", "target_book": "kosmos_humboldt_1845", "target_name": "Agassiz", "similarity": 0.849}], "id": 300, "stable_key": "clu_c3a81ea3802e7904", "ground_truth": {"modern_name": "Louis Agassiz", "confidence": "high", "type": "person", "description": "Swiss-born naturalist, geologist, and paleontologist.", "wikipedia_extract": "Jean Louis Rodolphe Agassiz  ( AG-ə-see; French: [aɡasi]; May 28, 1807 – December 14, 1873) was a Swiss-born American biologist and geologist who is recognized as a scholar of Earth's natural history. Spending his early life in Switzerland, he received a PhD at Erlangen and a medical degree in Munich. After studying with Georges Cuvier and Alexander von Humboldt in Paris, Agassiz was appointed professor of natural history at the University of Neuchâtel. He emigrated to the United States in 1847 after visiting Harvard University. He went on to become professor of zoology and geology at Harvard, to head its Lawrence Scientific School, and to found its Museum of Comparative Zoology. Agassiz is known for observational data gathering and analysis."}}, {"canonical_name": "monkeys", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "monkeys", "book_id": "principles_of_psychology_james_1890", "name": "monkeys", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 7, "variants": ["monkeys"], "contexts": ["primates for observation", "animal used in experiments"]}, {"entity_id": "mongrels", "book_id": "origin_of_species_darwin_1859", "name": "mongrels", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 6, "variants": ["mongrels", "Mongrels"], "contexts": ["offspring of mixed breeds", "offspring of different breeds"]}, {"entity_id": "mongrel", "book_id": "origin_of_species_darwin_1859", "name": "mongrel", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["mongrel"], "contexts": ["offspring of mixed breeds", "offspring of different varieties"]}, {"entity_id": "monas", "book_id": "kosmos_humboldt_1845", "name": "Monas", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Monas"], "contexts": ["genus of microscopic organisms"]}, {"entity_id": "monadidae", "book_id": "kosmos_humboldt_1845", "name": "Monadidae", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Monadidae"], "contexts": ["minutest Infusoria with silicious shells"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "monkeys", "target_book": "origin_of_species_darwin_1859", "target_name": "mongrels", "similarity": 0.851}, {"source_book": "principles_of_psychology_james_1890", "source_name": "monkeys", "target_book": "origin_of_species_darwin_1859", "target_name": "mongrel", "similarity": 0.845}, {"source_book": "principles_of_psychology_james_1890", "source_name": "monkeys", "target_book": "kosmos_humboldt_1845", "target_name": "Monas", "similarity": 0.843}, {"source_book": "principles_of_psychology_james_1890", "source_name": "monkeys", "target_book": "kosmos_humboldt_1845", "target_name": "Monadidae", "similarity": 0.842}], "id": 301, "stable_key": "clu_bc389ee169f6f99d", "ground_truth": {"modern_name": "monkeys", "confidence": "low", "type": "animal", "description": "Primates used in observation and experiments, offspring of mixed breeds.", "note": "Includes both 'monkeys' and 'mongrels' suggesting a broader category.", "wikipedia_extract": "Monkey is a common name that may refer to most mammals of the infraorder Simiiformes, also known as simians. Traditionally, all animals in the group now known as simians are counted as monkeys except the apes. Thus monkeys, in that sense, constitute an incomplete paraphyletic grouping; alternatively, if apes (Hominoidea) are included, monkeys and simians are synonyms. In 1812, Étienne Geoffroy grouped the apes and the Cercopithecidae group of monkeys together and established the name Catarrhini, \"Old World monkeys\" (\"singes de l'Ancien Monde\" in French). The extant sister of the Catarrhini in the monkey (\"singes\") group is the Platyrrhini (New World monkeys). Some nine million years before the divergence between the Cercopithecidae and the apes, the Platyrrhini emerged within \"monkeys\" by migration to South America likely by ocean."}}, {"canonical_name": "Oviedo", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "oviedo", "book_id": "coloquios_da_orta_1563", "name": "Oviedo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 14, "variants": ["Oviedo", "Gonçalo de Oviedo", "Oviedo (Gonçalo de)"], "contexts": ["source of information for Orta", "celebrated cinnamon from America"]}, {"entity_id": "oviedo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Oviedo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Oviedo"], "contexts": ["author of 'Bisl. nat. des Ind.'"]}, {"entity_id": "oviedo", "book_id": "kosmos_humboldt_1845", "name": "Oviedo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Oviedo"], "contexts": ["calls Sargasso Sea 'sea-weed meadows'", "describes weed of the Gulf Stream"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Oviedo", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Oviedo", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Oviedo", "target_book": "kosmos_humboldt_1845", "target_name": "Oviedo", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oviedo", "target_book": "kosmos_humboldt_1845", "target_name": "Oviedo", "similarity": 1.0}], "id": 302, "stable_key": "clu_e32e7c9293b1586c", "ground_truth": {"modern_name": "Oviedo", "confidence": "high", "type": "person", "description": "A source of information and author of natural history works.", "note": "Refers to Gonzalo Fernández de Oviedo y Valdés.", "wikipedia_extract": "Oviedo (Spanish: [oˈβjeðo] ) or Uviéu (Asturian: [uˈβjew]) is the capital city of the Principality of Asturias in northern Spain and the administrative and commercial centre of the region. With a population of 220,027, it is also the 2nd-largest city in Asturias. Oviedo is located approximately 24 km (15 mi) southwest of Gijón and 23 km (14 mi) southeast of Avilés, both of which lie on the shoreline of the Bay of Biscay. Oviedo's proximity to the ocean of less than 30 kilometres (19 mi) in combination with its elevated position with areas of the city more than 300 metres above sea level causes the city to have a maritime climate, even though it does not sit directly on the shore. The Kingdom of Asturias began in 720, with the Visigothic aristocrat Pelagius's (685–737) revolt against the Muslims who at the time were occupying most of the Iberian Peninsula. The Moorish invasion that began in 711 had taken control of most of the peninsula, until the revolt in the northern mountains by Pelagius."}}, {"canonical_name": "feldspar", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "feldspar", "book_id": "kosmos_humboldt_1845", "name": "feldspar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 10, "variants": ["feldspar"], "contexts": ["mineral ejected from crater", "mineral decomposing in granites and porphyries"]}, {"entity_id": "fluor-spar", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Fluor-spar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["fluor-spar", "Fluor-spar"], "contexts": ["mineral exhibiting fluorescence", "mineral where fluorescence was discovered"]}, {"entity_id": "feldspar", "book_id": "first_principles_spencer_1862", "name": "feldspar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["feldspar"], "contexts": ["common rock-forming mineral", "mineral component of granite"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "feldspar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Fluor-spar", "similarity": 0.846}, {"source_book": "kosmos_humboldt_1845", "source_name": "feldspar", "target_book": "first_principles_spencer_1862", "target_name": "feldspar", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Fluor-spar", "target_book": "first_principles_spencer_1862", "target_name": "feldspar", "similarity": 0.846}], "id": 303, "stable_key": "clu_d5aa169bf613664f", "ground_truth": {"modern_name": "feldspar", "confidence": "high", "type": "mineral", "note": "Includes 'Fluor-spar' which is a specific type of fluorspar (calcium fluoride) but also often discussed in relation to feldspars and general mineralogy of the time. However, 'feldspar' appears more frequently and broadly.", "wikidata_id": "Q170258", "wikidata_description": "mineral group", "wikipedia_url": "https://en.wikipedia.org/wiki/Feldspar", "wikipedia_extract": "Feldspar ( FEL(D)-spar; sometimes spelled felspar) is a group of rock-forming aluminium tectosilicate minerals, also containing other cations such as sodium, calcium, potassium, or barium. The most common members of the feldspar group are the plagioclase (sodium-calcium) feldspars and the alkali (potassium-sodium) feldspars. Feldspars make up about 60% of the Earth's crust and 41% of the Earth's continental crust by weight. Feldspars crystallize from magma as both intrusive and extrusive igneous rocks and are also present in many types of metamorphic rock. Rock formed almost entirely of calcic plagioclase feldspar is known as anorthosite. Feldspars are also found in many types of sedimentary rocks."}}, {"canonical_name": "friction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "friction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "friction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["friction"], "contexts": ["interaction causing storm axis bend", "resistance to motion between surfaces"]}, {"entity_id": "friction", "book_id": "kosmos_humboldt_1845", "name": "friction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["friction"], "contexts": ["resistance to motion between surfaces", "rubbing surfaces together"]}, {"entity_id": "friction_conglomerates", "book_id": "kosmos_humboldt_1845", "name": "friction conglomerates", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["friction conglomerates", "Friction conglomerates"], "contexts": ["rock formed by friction"]}, {"entity_id": "constant_friction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "constant friction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["constant friction"], "contexts": ["continuous resistance to motion"]}, {"entity_id": "friction", "book_id": "first_principles_spencer_1862", "name": "friction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["friction"], "contexts": ["resistance to motion between surfaces", "resistance to motion"]}, {"entity_id": "friction_of_thought", "book_id": "first_principles_spencer_1862", "name": "friction of thought", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["friction of thought"], "contexts": ["difficulty in thinking"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "friction", "target_book": "kosmos_humboldt_1845", "target_name": "friction", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "friction", "target_book": "kosmos_humboldt_1845", "target_name": "friction conglomerates", "similarity": 0.858}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "friction", "target_book": "first_principles_spencer_1862", "target_name": "friction", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "friction", "target_book": "first_principles_spencer_1862", "target_name": "friction of thought", "similarity": 0.888}, {"source_book": "kosmos_humboldt_1845", "source_name": "friction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "constant friction", "similarity": 0.897}, {"source_book": "kosmos_humboldt_1845", "source_name": "friction", "target_book": "first_principles_spencer_1862", "target_name": "friction", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "friction", "target_book": "first_principles_spencer_1862", "target_name": "friction of thought", "similarity": 0.888}, {"source_book": "kosmos_humboldt_1845", "source_name": "friction conglomerates", "target_book": "first_principles_spencer_1862", "target_name": "friction", "similarity": 0.858}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "constant friction", "target_book": "first_principles_spencer_1862", "target_name": "friction", "similarity": 0.897}], "id": 304, "stable_key": "clu_1c9d26dc239a22f8", "ground_truth": {"modern_name": "friction", "confidence": "high", "type": "concept", "wikidata_id": "Q82580", "wikidata_description": "force resisting the relative motion of solid surfaces, fluid layers, and material elements sliding against each other", "wikipedia_url": "https://en.wikipedia.org/wiki/Friction", "wikipedia_extract": "Friction is the force resisting the relative motion of solid surfaces, fluid layers, and material elements sliding or grinding against each other. Types of friction include dry, fluid, lubricated, skin, and internal – an incomplete list. The study of the processes involved is called tribology, and has a history of more than 2,000 years. Friction can have dramatic consequences, as illustrated by the use of friction created by rubbing pieces of wood together to start a fire. Another important consequence of many types of friction can be wear, which may lead to performance degradation or damage to components. It is known that frictional energy losses account for about 20% of the total energy expenditure of the world."}}, {"canonical_name": "cozimentos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "cozimentos", "book_id": "polyanthea_medicinal", "name": "cozimentos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 12, "variants": ["cozimentos", "Cozimentos", "cozimento peytoral"], "contexts": ["decoctions", "digestive processes"]}, {"entity_id": "cozimientos", "book_id": "historia_medicinal_monardes_1574", "name": "cozimientos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["cozimientos"], "contexts": ["decoctions for enemas"]}, {"entity_id": "cozimento", "book_id": "coloquios_da_orta_1563", "name": "cozimento", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["cozimento"], "contexts": ["Boiled mixture", "decoction of herbs"]}, {"entity_id": "cozimentos_de_legumes", "book_id": "coloquios_da_orta_1563", "name": "cozimentos de legumes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["cozimentos de legumes"], "contexts": ["vegetable decoctions"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "cozimentos", "target_book": "historia_medicinal_monardes_1574", "target_name": "cozimientos", "similarity": 0.931}, {"source_book": "polyanthea_medicinal", "source_name": "cozimentos", "target_book": "coloquios_da_orta_1563", "target_name": "cozimento", "similarity": 0.959}, {"source_book": "polyanthea_medicinal", "source_name": "cozimentos", "target_book": "coloquios_da_orta_1563", "target_name": "cozimentos de legumes", "similarity": 0.868}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "cozimientos", "target_book": "coloquios_da_orta_1563", "target_name": "cozimento", "similarity": 0.909}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "cozimientos", "target_book": "coloquios_da_orta_1563", "target_name": "cozimentos de legumes", "similarity": 0.831}], "id": 305, "stable_key": "clu_c2e113f693883241", "ground_truth": {"modern_name": "Decoctions", "confidence": "high", "type": "concept", "description": "Preparations made by boiling plant material in water.", "wikipedia_extract": "Decoction is a method of extraction by boiling herbal or plant material (which may include stems, roots, bark and rhizomes) to dissolve the chemicals of the material. It is the most common preparation method in various herbal medicine systems. Decoction involves first drying the plant material; then mashing, slicing, or cutting the material to allow for maximum dissolution; and finally boiling in water to extract oils, volatile organic compounds and other various chemical substances. Occasionally, aqueous ethanol or glycerol may be used instead of water. Decoction can be used to make tisanes, tinctures and similar solutions. Decoctions and infusions may produce liquids with differing chemical properties, as the temperature or preparation difference may result in more oil-soluble chemicals in decoctions versus infusions."}}, {"canonical_name": "Medlar", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "medlar", "book_id": "english_physician_1652", "name": "Medlar", "category": "PLANT", "subcategory": "PLANT", "count": 14, "variants": ["Medlar", "Medlar stones", "Medlars"], "contexts": ["fruit tree with medicinal properties", "fruit of the Medlar tree"]}, {"entity_id": "medlars", "book_id": "kosmos_humboldt_1845", "name": "medlars", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["medlars"], "contexts": ["fruit trees"]}, {"entity_id": "medula", "book_id": "coloquios_da_orta_1563", "name": "medula", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["medula"], "contexts": ["inner part of tamarindos, sticky"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Medlar", "target_book": "kosmos_humboldt_1845", "target_name": "medlars", "similarity": 0.856}, {"source_book": "english_physician_1652", "source_name": "Medlar", "target_book": "coloquios_da_orta_1563", "target_name": "medula", "similarity": 0.841}], "id": 306, "stable_key": "clu_be0289309a53d574", "ground_truth": {"modern_name": "Medlar", "confidence": "low", "type": "plant", "description": "A fruit tree with medicinal properties and its fruit.", "note": "The term 'medula' likely refers to the pith or marrow of a plant, not the Medlar fruit itself.", "wikipedia_extract": "Mespilus germanica, known as the medlar or common medlar, is a large shrub or small tree in the rose family Rosaceae. When the genus Mespilus is included in the genus Crataegus, the correct name for this species is Crataegus germanica (L.) Kuntze. The fruit of this tree, also called medlar, has been cultivated since Roman times. It is usually available in winter and eaten when bletted. It may be consumed raw and in a range of cooked dishes. Under ideal circumstances, the deciduous plant grows up to 8 metres (26 feet) tall."}}, {"canonical_name": "Chollerick", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "chollerick", "book_id": "english_physician_1652", "name": "Chollerick", "category": "CONCEPT", "subcategory": "QUALITY", "count": 12, "variants": ["Chollerick", "chollerick"], "contexts": ["chollerick belchings and castings of the stomach", "humors causing illness"]}, {"entity_id": "cholericas", "book_id": "historia_medicinal_monardes_1574", "name": "cholericas", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["cholericas"], "contexts": ["choleric humors", "related to choler or yellow bile"]}, {"entity_id": "choleric", "book_id": "polyanthea_medicinal", "name": "choleric", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["choleric", "choler"], "contexts": ["quality related to bile", "humor to be purged"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Chollerick", "target_book": "historia_medicinal_monardes_1574", "target_name": "cholericas", "similarity": 0.916}, {"source_book": "english_physician_1652", "source_name": "Chollerick", "target_book": "polyanthea_medicinal", "target_name": "choleric", "similarity": 0.911}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "cholericas", "target_book": "polyanthea_medicinal", "target_name": "choleric", "similarity": 0.957}], "id": 307, "stable_key": "clu_91ffaf66c0d25224", "ground_truth": {"modern_name": "Choleric", "confidence": "high", "type": "concept", "description": "Relating to the humor of yellow bile; hot-tempered.", "note": "Refers to a humor in the humoral theory of medicine.", "wikipedia_extract": "The four temperament theory is a proto-psychological theory which suggests that there are four fundamental personality types: sanguine, choleric, melancholic, and phlegmatic. Most formulations include the possibility of mixtures among the types where an individual's personality types overlap and they share two or more temperaments. Greek physician Hippocrates (c. 460 – c. 370 BC) described the four temperaments as part of the ancient medical concept of humourism, that four bodily fluids affect human personality traits and behaviours. Modern medical science does not define a fixed relationship between internal secretions and personality, although some psychological personality type systems use categories similar to the Greek temperaments. The four temperament theory was abandoned after the 1850s. Temperament theory has its roots in the ancient theory of humourism."}}, {"canonical_name": "Lithargyro", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "lithargyro", "book_id": "ricettario_fiorentino_1597", "name": "Lithargyro", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 14, "variants": ["Lithargyro", "LITHARGYRO", "Litargyro doro", "Lithargyro d'argento", "Lytargirodoro", "lichargyro", "litharge", "lithargyro", "lithargyro d argento", "lytargiro", "lytharg.ro"], "contexts": ["a substance, likely lead monoxide", "spuma d'argento, generated from lead"]}, {"entity_id": "litharge", "book_id": "english_physician_1652", "name": "Litharge", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Litharge"], "contexts": ["danger from taking, treated by parsley"]}, {"entity_id": "lithargyrij", "book_id": "polyanthea_medicinal", "name": "lithargyrij", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["lithargyrij"], "contexts": ["ingredient in a preparation"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Lithargyro", "target_book": "english_physician_1652", "target_name": "Litharge", "similarity": 0.914}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Lithargyro", "target_book": "polyanthea_medicinal", "target_name": "lithargyrij", "similarity": 0.959}, {"source_book": "english_physician_1652", "source_name": "Litharge", "target_book": "polyanthea_medicinal", "target_name": "lithargyrij", "similarity": 0.957}], "id": 308, "stable_key": "clu_33f3309632b021df", "ground_truth": {"modern_name": "Litharge", "confidence": "high", "type": "substance", "description": "A heavy, dull yellow oxide of lead; lead monoxide.", "wikipedia_extract": "Litharge (from Greek lithargyros, lithos 'stone' + argyros 'silver' λιθάργυρος) is one of the natural mineral forms of lead(II) oxide, PbO. Litharge is a secondary mineral which forms from the oxidation of galena ores. It forms as coatings and encrustations with internal tetragonal crystal structure. It is dimorphous with the yellow orthorhombic form massicot. It forms soft (Mohs hardness of 2), red, greasy-appearing crusts with a very high specific gravity of 9.14–9.35. PbO may be prepared by heating lead metal in air at approximately 600 °C (lead melts at only 300 °C)."}}, {"canonical_name": "Scandinave", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "scandinave", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Scandinave", "category": "PLACE", "subcategory": "REGION", "count": 7, "variants": ["Scandinave", "Scandinaves", "Scandinavie"], "contexts": ["origin of granite blocks", "granite covering sandy plains"]}, {"entity_id": "scandinavia", "book_id": "origin_of_species_darwin_1859", "name": "Scandinavia", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Scandinavia"], "contexts": ["region with Silurian deposits", "northern region with arctic plants"]}, {"entity_id": "péninsule_scandinave", "book_id": "relation_historique_humboldt_vol3_1825", "name": "péninsule Scandinave", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["péninsule Scandinave"], "contexts": ["origin of scattered rocks"]}, {"entity_id": "scandinavian_peninsula", "book_id": "kosmos_humboldt_1845", "name": "Scandinavian peninsula", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Scandinavian peninsula"], "contexts": ["region experiencing geological uplift", "peninsula north of Europe"]}, {"entity_id": "scania", "book_id": "kosmos_humboldt_1845", "name": "Scania", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Scania"], "contexts": ["region in Sweden", "location of geological disturbance"]}, {"entity_id": "scandinavia", "book_id": "kosmos_humboldt_1845", "name": "Scandinavia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Scandinavia"], "contexts": ["northern extremity climate ameliorated"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Scandinave", "target_book": "origin_of_species_darwin_1859", "target_name": "Scandinavia", "similarity": 0.984}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Scandinave", "target_book": "kosmos_humboldt_1845", "target_name": "Scandinavian peninsula", "similarity": 0.919}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Scandinave", "target_book": "kosmos_humboldt_1845", "target_name": "Scania", "similarity": 0.851}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Scandinave", "target_book": "kosmos_humboldt_1845", "target_name": "Scandinavia", "similarity": 0.984}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Scandinavia", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "péninsule Scandinave", "similarity": 0.919}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Scandinavia", "target_book": "kosmos_humboldt_1845", "target_name": "Scandinavian peninsula", "similarity": 0.928}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Scandinavia", "target_book": "kosmos_humboldt_1845", "target_name": "Scania", "similarity": 0.868}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Scandinavia", "target_book": "kosmos_humboldt_1845", "target_name": "Scandinavia", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "péninsule Scandinave", "target_book": "kosmos_humboldt_1845", "target_name": "Scandinavian peninsula", "similarity": 0.972}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "péninsule Scandinave", "target_book": "kosmos_humboldt_1845", "target_name": "Scandinavia", "similarity": 0.919}], "id": 309, "stable_key": "clu_80c701398ef57fca", "ground_truth": {"modern_name": "Scandinavia", "confidence": "high", "type": "place", "description": "A peninsula and region in Northern Europe with specific geological deposits.", "wikipedia_extract": "Scandinavia is a subregion of northern Europe, with strong historical, cultural, and linguistic ties between its constituent peoples. Scandinavia most commonly refers to Denmark, Norway, and Sweden. It can sometimes also refer to the Scandinavian Peninsula (which excludes Denmark but includes a part of northern Finland). In English usage, Scandinavia is sometimes used as a synonym for Nordic countries. Iceland and the Faroe Islands are sometimes included in Scandinavia for their ethnolinguistic relations with Sweden, Norway and Denmark. While Finland differs from other Nordic countries in this respect, some authors call it Scandinavian due to its economic and cultural similarities."}}, {"canonical_name": "Coniferae", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "coniferae", "book_id": "kosmos_humboldt_1845", "name": "Coniferae", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["coniferae", "Coniferae"], "contexts": ["cone-bearing plants", "plant group found in butter sandstone"]}, {"entity_id": "connaraceæ", "book_id": "origin_of_species_darwin_1859", "name": "Connaraceæ", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Connaraceæ"], "contexts": ["plant family discussed by Robert Brown"]}, {"entity_id": "conifère", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Conifère", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Conifère"], "contexts": ["type of tree, coniferous"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Coniferae", "target_book": "origin_of_species_darwin_1859", "target_name": "Connaraceæ", "similarity": 0.849}, {"source_book": "kosmos_humboldt_1845", "source_name": "Coniferae", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Conifère", "similarity": 0.887}], "id": 310, "stable_key": "clu_c8505a9974a22077", "ground_truth": {"modern_name": "Conifers", "confidence": "high", "type": "plant", "family": "Pinaceae", "note": "The cluster includes references to 'Coniferae', 'Conifère', and 'Connaraceæ'. While 'Coniferae' and 'Conifère' clearly refer to conifers, 'Connaraceæ' is a distinct plant family. However, the overwhelming context points to conifers as the primary referent.", "wikidata_id": "Q132825", "wikidata_description": "division of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Conifer", "wikipedia_extract": "Conifers () are a group of vascular plants and a subset of gymnosperms. They are primarily perennial, woody trees and shrubs, mostly evergreen with a regular branching pattern, reproducing with male and female cones, usually on the same tree. They are wind-pollinated and the seeds are usually dispersed by the wind. Taxonomically, they make up the division Pinophyta, also known as Coniferae. All extant conifers, except for the gnetophytes, are perennial woody plants with secondary growth. There are over 600 living species."}}, {"canonical_name": "Pistil", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "pistil", "book_id": "origin_of_species_darwin_1859", "name": "Pistil", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["pistil", "Pistil"], "contexts": ["female reproductive part of a flower", "female reproductive organ of a flower"]}, {"entity_id": "pistils", "book_id": "origin_of_species_darwin_1859", "name": "pistils", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["pistils"], "contexts": ["female reproductive part of a flower", "female reproductive organs of a flower"]}, {"entity_id": "pith", "book_id": "connexion_physical_sciences_somerville_1858", "name": "pith", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["pith"], "contexts": ["material of floating balls"]}, {"entity_id": "pistil", "book_id": "first_principles_spencer_1862", "name": "pistil", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["pistil"], "contexts": ["part of a flower"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Pistil", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "pith", "similarity": 0.861}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Pistil", "target_book": "first_principles_spencer_1862", "target_name": "pistil", "similarity": 0.895}, {"source_book": "origin_of_species_darwin_1859", "source_name": "pistils", "target_book": "first_principles_spencer_1862", "target_name": "pistil", "similarity": 0.978}], "id": 311, "stable_key": "clu_a5d24fc2cfdb918d", "ground_truth": {"modern_name": "Pistil", "confidence": "high", "type": "plant", "family": "N/A", "note": "One instance of 'pith' is likely an OCR or transcription error given the strong context of 'pistil' and its plural.", "wikidata_id": "Q108226839", "wikidata_description": "species of fungi in the genus Pistillaria", "wikipedia_extract": "Gynoecium (; from Ancient Greek  γυνή (gunḗ) 'woman, female' and  οἶκος (oîkos) 'house', pl. gynoecia) is most commonly used as a collective term for the parts of a flower that produce ovules and ultimately develop into the fruit and seeds. The gynoecium is the innermost whorl of a flower; it consists of (one or more) pistils and is typically surrounded by the pollen-producing reproductive organs, the stamens, collectively called the androecium. The gynoecium is often referred to as the \"female\" portion of the flower, although rather than directly producing female gametes (i.e. egg cells), the gynoecium produces megaspores, each of which develops into a female gametophyte which then produces egg cells. The term gynoecium is also used by botanists to refer to a cluster of archegonia and any associated modified leaves or stems present on a gametophyte shoot in mosses, liverworts, and hornworts. The corresponding terms for the male parts of those plants are clusters of antheridia within the androecium. Flowers that bear a gynoecium but no stamens are called pistillate or carpellate."}}, {"canonical_name": "Constantinopla", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "constantinopla", "book_id": "coloquios_da_orta_1563", "name": "Constantinopla", "category": "PLACE", "subcategory": "CITY", "count": 13, "variants": ["Constantinopla", "Constantinopola"], "contexts": ["city mentioned in the text", "city, also called Rome"]}, {"entity_id": "constantinople", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Constantinople", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Constantinople"], "contexts": ["city where slave trade occurs"]}, {"entity_id": "constantinopla", "book_id": "polyanthea_medicinal", "name": "Constantinopla", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Constantinopla", "Constantinoplahouve"], "contexts": ["city where plagues occurred", "city where plague caused delusions"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Constantinopla", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Constantinople", "similarity": 0.982}, {"source_book": "coloquios_da_orta_1563", "source_name": "Constantinopla", "target_book": "polyanthea_medicinal", "target_name": "Constantinopla", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Constantinople", "target_book": "polyanthea_medicinal", "target_name": "Constantinopla", "similarity": 0.982}], "id": 312, "stable_key": "clu_2509c4f87f383dd7", "ground_truth": {"modern_name": "Constantinople", "confidence": "high", "type": "place", "description": "Historic city, formerly the capital of the Byzantine and Ottoman Empires.", "wikipedia_extract": "Constantinople (see other names) was a historical city located on the Bosporus, which served as the capital of the Roman, Byzantine, Latin, and Ottoman empires between its consecration in 330 and the formal abolition of the Ottoman sultanate in 1922. Constantinople was founded in 324, initially as New Rome, during the reign of Constantine the Great on the site of the existing settlement of Byzantium and in 330 became the capital of the Roman Empire. Following the collapse of the Western Roman Empire in the late 5th century, Constantinople remained the capital of the  Eastern Roman Empire (also known as the Byzantine Empire; 330–1204 and 1261–1453), the Latin Empire (1204–1261), and the Ottoman Empire (1453–1922). In the aftermath of the Turkish War of Independence, the Turkish capital moved to Ankara. The city was officially renamed Istanbul on 28 March 1930. As of December 2025, it is the most populous city in Europe, with a population of more than 16 million residents, straddling the Bosporus Strait and lying in both Europe and Asia, and is the financial beneficiary of Turkey."}}, {"canonical_name": "Rheumatismos", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "rheumatismos", "book_id": "polyanthea_medicinal", "name": "Rheumatismos", "category": "DISEASE", "subcategory": "CHRONIC", "count": 10, "variants": ["Rheumatismos", "Reumatismo", "Reumatismos", "Reumatiſmos", "Rheumatismo", "reumatiſmos", "rheumatismos"], "contexts": ["rheumatism", "rheumatic conditions"]}, {"entity_id": "rheumatic", "book_id": "principles_of_psychology_james_1890", "name": "rheumatic", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["rheumatic"], "contexts": ["chronic condition causing joint pain"]}, {"entity_id": "rheumatism", "book_id": "principles_of_psychology_james_1890", "name": "rheumatism", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["rheumatism"], "contexts": ["inflammatory condition affecting joints"]}, {"entity_id": "rheumatismo", "book_id": "coloquios_da_orta_1563", "name": "rheumatismo", "category": "DISEASE", "subcategory": "CHRONIC", "count": 3, "variants": ["rheumatismo", "rheumatica"], "contexts": ["condition treated by negundo", "disease treated with seed oil"]}, {"entity_id": "inflamações_rheumaticas", "book_id": "coloquios_da_orta_1563", "name": "inflamações rheumaticas", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["inflamações rheumaticas"], "contexts": ["rheumatic inflammations"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Rheumatismos", "target_book": "principles_of_psychology_james_1890", "target_name": "rheumatic", "similarity": 0.945}, {"source_book": "polyanthea_medicinal", "source_name": "Rheumatismos", "target_book": "principles_of_psychology_james_1890", "target_name": "rheumatism", "similarity": 0.977}, {"source_book": "polyanthea_medicinal", "source_name": "Rheumatismos", "target_book": "coloquios_da_orta_1563", "target_name": "rheumatismo", "similarity": 0.961}, {"source_book": "polyanthea_medicinal", "source_name": "Rheumatismos", "target_book": "coloquios_da_orta_1563", "target_name": "inflamações rheumaticas", "similarity": 0.903}, {"source_book": "principles_of_psychology_james_1890", "source_name": "rheumatic", "target_book": "coloquios_da_orta_1563", "target_name": "rheumatismo", "similarity": 0.97}, {"source_book": "principles_of_psychology_james_1890", "source_name": "rheumatic", "target_book": "coloquios_da_orta_1563", "target_name": "inflamações rheumaticas", "similarity": 0.901}, {"source_book": "principles_of_psychology_james_1890", "source_name": "rheumatism", "target_book": "coloquios_da_orta_1563", "target_name": "rheumatismo", "similarity": 0.984}, {"source_book": "principles_of_psychology_james_1890", "source_name": "rheumatism", "target_book": "coloquios_da_orta_1563", "target_name": "inflamações rheumaticas", "similarity": 0.905}], "id": 313, "stable_key": "clu_41cb232fcbf3d2e6", "ground_truth": {"modern_name": "Rheumatism", "confidence": "high", "type": "disease", "description": "Inflammatory condition causing pain and stiffness in joints.", "wikipedia_extract": "Rheumatism  (from the Ancient Greek ῥεῦμα, rheûma) or rheumatic disorders are conditions causing chronic, often intermittent pain affecting the joints or connective tissue. Rheumatism does not designate any specific disorder, but covers at least 200 different conditions, including arthritis and  \"non-articular rheumatism\", also known as \"regional pain syndrome\" or \"soft tissue rheumatism\". There is a close overlap between the term soft tissue disorder and rheumatism. Sometimes the term \"soft tissue rheumatic disorders\" is used to describe these conditions. The term \"Rheumatic Diseases\" is used in MeSH to refer to connective tissue disorders. The branch of medicine devoted to the diagnosis and therapy of rheumatism is called rheumatology."}}, {"canonical_name": "duck", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "duck", "book_id": "origin_of_species_darwin_1859", "name": "duck", "category": "ANIMAL", "subcategory": "BIRD", "count": 4, "variants": ["duck"], "contexts": ["domestic vs wild bones comparison", "bird carrying aquatic plants and shells"]}, {"entity_id": "ducks", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ducks", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["Ducks"], "contexts": ["birds whose eggs hatch under a hen", "birds used in incubation experiments"]}, {"entity_id": "ducks", "book_id": "origin_of_species_darwin_1859", "name": "ducks", "category": "ANIMAL", "subcategory": "BIRD", "count": 3, "variants": ["ducks"], "contexts": ["domesticated bird", "domesticated birds with differing breeds"]}, {"entity_id": "logger-headed_duck", "book_id": "origin_of_species_darwin_1859", "name": "logger-headed duck", "category": "ANIMAL", "subcategory": "BIRD", "count": 3, "variants": ["logger-headed duck"], "contexts": ["South American bird with reduced wings", "type of duck"]}, {"entity_id": "wild-duck", "book_id": "origin_of_species_darwin_1859", "name": "wild-duck", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["wild-duck"], "contexts": ["parent of domestic duck"]}, {"entity_id": "domestic_duck", "book_id": "origin_of_species_darwin_1859", "name": "domestic duck", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["domestic duck"], "contexts": ["common domesticated waterfowl"]}, {"entity_id": "duckling", "book_id": "first_principles_spencer_1862", "name": "duckling", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["duckling"], "contexts": ["young bird developing from an egg"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "duck", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Ducks", "similarity": 0.966}, {"source_book": "origin_of_species_darwin_1859", "source_name": "duck", "target_book": "first_principles_spencer_1862", "target_name": "duckling", "similarity": 0.894}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ducks", "target_book": "origin_of_species_darwin_1859", "target_name": "ducks", "similarity": 0.984}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ducks", "target_book": "origin_of_species_darwin_1859", "target_name": "logger-headed duck", "similarity": 0.85}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ducks", "target_book": "origin_of_species_darwin_1859", "target_name": "wild-duck", "similarity": 0.884}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ducks", "target_book": "origin_of_species_darwin_1859", "target_name": "domestic duck", "similarity": 0.869}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ducks", "target_book": "first_principles_spencer_1862", "target_name": "duckling", "similarity": 0.869}, {"source_book": "origin_of_species_darwin_1859", "source_name": "ducks", "target_book": "first_principles_spencer_1862", "target_name": "duckling", "similarity": 0.881}], "id": 314, "stable_key": "clu_437b92214b75b130", "ground_truth": {"modern_name": "duck", "confidence": "high", "type": "animal", "description": "A waterfowl used in remedies and for cauterization.", "wikipedia_extract": "Duck is the common name for numerous species of waterfowl in the family Anatidae. Ducks are generally smaller and shorter-necked than swans and geese, which are members of the same family. Divided among several subfamilies, they are a form taxon; they do not represent a monophyletic group (the group of all descendants of a single common ancestral species), since swans and geese are not considered ducks. Ducks are mostly aquatic birds, and may be found in both fresh water and sea water. Ducks are sometimes confused with several types of unrelated water birds with similar forms, such as loons or divers, grebes, gallinules and coots. The word duck comes from Old English dūce 'diver', a derivative of the verb *dūcan 'to duck, bend down low as if to get under something, or dive', because of the way many species in the dabbling duck group feed by upending; compare with Dutch duiken and German tauchen 'to dive'."}}, {"canonical_name": "wings", "category": "ANATOMY", "subcategory": "BODY_PART", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "wings", "book_id": "origin_of_species_darwin_1859", "name": "wings", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 6, "variants": ["wings"], "contexts": ["part of runt pigeon anatomy", "appendages for flight"]}, {"entity_id": "wings", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Wings", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["Wings"], "contexts": ["appendages for flight"]}, {"entity_id": "wing", "book_id": "origin_of_species_darwin_1859", "name": "wing", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 6, "variants": ["wing"], "contexts": ["limb used for flight", "part of bat"]}, {"entity_id": "wings", "book_id": "first_principles_spencer_1862", "name": "wings", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 2, "variants": ["wings"], "contexts": ["appendages for flight", "locomotion organs in birds"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "wings", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Wings", "similarity": 0.992}, {"source_book": "origin_of_species_darwin_1859", "source_name": "wings", "target_book": "first_principles_spencer_1862", "target_name": "wings", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Wings", "target_book": "origin_of_species_darwin_1859", "target_name": "wing", "similarity": 0.954}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Wings", "target_book": "first_principles_spencer_1862", "target_name": "wings", "similarity": 0.992}, {"source_book": "origin_of_species_darwin_1859", "source_name": "wing", "target_book": "first_principles_spencer_1862", "target_name": "wings", "similarity": 0.971}], "id": 315, "stable_key": "clu_2c6473fe6a350a7f", "ground_truth": {"modern_name": "Wings", "confidence": "high", "type": "animal", "note": "Identified as an animal part due to context of 'runt pigeon anatomy' and 'appendages for flight'.", "wikidata_id": "Q14899801", "wikidata_description": "2013 single by Birdy", "wikipedia_url": "https://en.wikipedia.org/wiki/Wings%20%28Birdy%20song%29", "wikipedia_extract": "A wing is a structure which produces both lift and drag while moving through air. Wings are defined by two shape characteristics, an airfoil section and a planform. Wing efficiency is expressed as lift-to-drag ratio, which compares the benefit of lift with the air resistance of a given wing shape, as it flies. Aerodynamics includes the study of wing performance in air. Equivalent foils that move through water are found on hydrofoil power vessels and foiling sailboats that lift out of the water at speed and on submarines that use diving planes to point the boat upwards or downwards, while running submerged. The study of foil performance in water is a subfield of Hydrodynamics."}}, {"canonical_name": "Capricorn", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "capricorn", "book_id": "english_physician_1652", "name": "Capricorn", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["Capricorn"], "contexts": ["zodiac sign where Mars is exalted", "zodiac sign"]}, {"entity_id": "tropick_of_capricorn", "book_id": "english_physician_1652", "name": "Tropick of Capricorn", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Tropick of Capricorn"], "contexts": ["celestial line influencing plant growth"]}, {"entity_id": "capricorne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Capricorne", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Capricorne"], "contexts": ["tropic line", "tropical zone"]}, {"entity_id": "tropique_du_capricorne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "tropique du Capricorne", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tropique du Capricorne"], "contexts": ["astronomical line of latitude"]}, {"entity_id": "capricornio", "book_id": "polyanthea_medicinal", "name": "Capricornio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Capricornio"], "contexts": ["zodiac sign"]}, {"entity_id": "escorpião", "book_id": "polyanthea_medicinal", "name": "Escorpião", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Escorpião"], "contexts": ["zodiac sign"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Capricorn", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Capricorne", "similarity": 0.996}, {"source_book": "english_physician_1652", "source_name": "Capricorn", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "tropique du Capricorne", "similarity": 0.875}, {"source_book": "english_physician_1652", "source_name": "Capricorn", "target_book": "polyanthea_medicinal", "target_name": "Capricornio", "similarity": 0.981}, {"source_book": "english_physician_1652", "source_name": "Capricorn", "target_book": "polyanthea_medicinal", "target_name": "Escorpião", "similarity": 0.843}, {"source_book": "english_physician_1652", "source_name": "Tropick of Capricorn", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Capricorne", "similarity": 0.883}, {"source_book": "english_physician_1652", "source_name": "Tropick of Capricorn", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "tropique du Capricorne", "similarity": 0.97}, {"source_book": "english_physician_1652", "source_name": "Tropick of Capricorn", "target_book": "polyanthea_medicinal", "target_name": "Capricornio", "similarity": 0.868}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Capricorne", "target_book": "polyanthea_medicinal", "target_name": "Capricornio", "similarity": 0.983}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "tropique du Capricorne", "target_book": "polyanthea_medicinal", "target_name": "Capricornio", "similarity": 0.863}], "id": 316, "stable_key": "clu_ef88512476394474", "ground_truth": {"modern_name": "Tropic of Capricorn", "confidence": "high", "type": "concept", "description": "The southern-most latitude where the sun can be directly overhead.", "note": "Includes references to the zodiac sign Capricorn and the tropic line.", "wikipedia_extract": "The Tropic of Capricorn (or the Southern Tropic) is the circle of latitude that contains the subsolar point at the December (or southern) solstice. It is thus the southernmost latitude where the Sun can be seen directly overhead. It also reaches 90 degrees below the horizon at solar midnight on the June Solstice. Its northern equivalent is the Tropic of Cancer. The Tropic of Capricorn is one of the five major circles of latitude marked on maps of Earth. Its latitude is currently 23°26′09.2″ (or 23.4359°) south of the Equator, but it is very gradually moving northward, currently at the rate of 0.47 arcseconds, or 15 metres, per year."}}, {"canonical_name": "avenca", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "avenca", "book_id": "polyanthea_medicinal", "name": "avenca", "category": "PLANT", "subcategory": "PLANT", "count": 13, "variants": ["avenca", "Avenca"], "contexts": ["herb used in decoction", "ingredient in decoction"]}, {"entity_id": "avens", "book_id": "english_physician_1652", "name": "Avens", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Avens"], "contexts": ["plant with medicinal properties"]}, {"entity_id": "avenca", "book_id": "coloquios_da_orta_1563", "name": "avenca", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["avenca"], "contexts": ["herb used in medicine"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "avenca", "target_book": "english_physician_1652", "target_name": "Avens", "similarity": 0.909}, {"source_book": "polyanthea_medicinal", "source_name": "avenca", "target_book": "coloquios_da_orta_1563", "target_name": "avenca", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Avens", "target_book": "coloquios_da_orta_1563", "target_name": "avenca", "similarity": 0.909}], "id": 317, "stable_key": "clu_3bc6aca06bc0e821", "ground_truth": {"modern_name": "maidenhair fern", "confidence": "high", "type": "plant", "linnaean": "Adiantum spp.", "family": "Pteridaceae", "description": "A delicate fern genus, historically used in herbal remedies.", "note": "The English 'Avens' is a different plant (Geum spp.), but the contexts here strongly point to Avenca (maidenhair fern).", "wikipedia_extract": "Adiantum (), the maidenhair fern (not to be confused with the similar-looking maidenhair spleenwort fern), is a genus of about 250 species of ferns in the subfamily Vittarioideae of the family Pteridaceae, though some researchers place it in its own family, Adiantaceae. The genus name comes from Greek, meaning \"unwetted\", referring to the fronds' ability to shed water without becoming wet. They are distinctive in appearance, with dark, often black stipes and rachises, and bright green, often delicately cut leaf tissue. The sori are borne submarginally, and are covered by reflexed flaps of leaf tissue which resemble indusia. Dimorphism between sterile and fertile fronds is generally subtle. They generally prefer humus-rich, moist, well-drained sites, ranging from bottomland soils to vertical rock walls."}}, {"canonical_name": "ILE-DE-FRANCE", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "ile-de-france", "book_id": "relation_historique_humboldt_vol3_1825", "name": "ILE-DE-FRANCE", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 10, "variants": ["ILE-DE-FRANCE", "Ile 'de-France", "Ile de France", "Ile-de-France"], "contexts": ["island with establishments", "island for trade"]}, {"entity_id": "isle_of_france", "book_id": "kosmos_humboldt_1845", "name": "Isle of France", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Isle of France"], "contexts": ["southern hemisphere observation location", "location of pendulum experiments"]}, {"entity_id": "ilha_de_frança", "book_id": "coloquios_da_orta_1563", "name": "ilha de França", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["ilha de França"], "contexts": ["Island, likely Mauritius"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "ILE-DE-FRANCE", "target_book": "kosmos_humboldt_1845", "target_name": "Isle of France", "similarity": 0.848}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "ILE-DE-FRANCE", "target_book": "coloquios_da_orta_1563", "target_name": "ilha de França", "similarity": 0.861}, {"source_book": "kosmos_humboldt_1845", "source_name": "Isle of France", "target_book": "coloquios_da_orta_1563", "target_name": "ilha de França", "similarity": 0.941}], "id": 318, "stable_key": "clu_ac2b4512a70492ce", "ground_truth": {"modern_name": "Île-de-France", "confidence": "high", "type": "place", "description": "A region in France or an island associated with French establishments and trade.", "note": "In the context of Humboldt, likely refers to an island, but the name itself denotes a French region.", "wikipedia_extract": "The Île-de-France (; French: [il də fʁɑ̃s] ; lit. 'Island of France') is the most populous of the eighteen regions of France, with an official estimated population of 12,271,794 residents on 1 January 2023. Containing the capital city of France, Paris, it is located in the north-central part of the country and often called the Paris Region (French: Région parisienne, pronounced [ʁeʒjɔ̃ paʁizjɛn]). Île-de-France is densely populated and retains a prime economic position on the national stage, and it covers 12,012 square kilometres (4,638 square miles), about 2% of metropolitan French territory. Its 2017 population was nearly one-fifth of the national total. The region is made up of eight administrative departments: Paris, Essonne, Hauts-de-Seine, Seine-Saint-Denis, Seine-et-Marne, Val-de-Marne, Val-d'Oise and Yvelines. It was created as the \"District of the Paris Region\" in 1961. In 1976, when its status was aligned with the French administrative regions created in 1972, it was renamed after the historic province of Île-de-France."}}, {"canonical_name": "Coimbra", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "coimbra", "book_id": "polyanthea_medicinal", "name": "Coimbra", "category": "PLACE", "subcategory": "CITY", "count": 12, "variants": ["Coimbra"], "contexts": ["location of university", "University city in Portugal"]}, {"entity_id": "nuevacoimbra", "book_id": "relation_historique_humboldt_vol3_1825", "name": "NuevaCoimbra", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["NuevaCoimbra"], "contexts": ["city", "city mentioned in passage"]}, {"entity_id": "coimbra", "book_id": "coloquios_da_orta_1563", "name": "Coimbra", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Coimbra"], "contexts": ["university where Dimas Bosque completed studies"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Coimbra", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "NuevaCoimbra", "similarity": 0.852}, {"source_book": "polyanthea_medicinal", "source_name": "Coimbra", "target_book": "coloquios_da_orta_1563", "target_name": "Coimbra", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "NuevaCoimbra", "target_book": "coloquios_da_orta_1563", "target_name": "Coimbra", "similarity": 0.852}], "id": 319, "stable_key": "clu_12a8bcf99d4991c4", "ground_truth": {"modern_name": "Coimbra", "confidence": "high", "type": "place", "description": "A historic university city in Portugal.", "note": "NuevaCoimbra is likely a reference to Coimbra or a settlement named after it.", "wikipedia_extract": "Coimbra, officially the City of Coimbra, is a city and a municipality in Portugal. The population of the municipality at the 2021 census was 140,796, in an area of 319.40 square kilometres (123.3 sq mi). It is the fourth-largest agglomerated urban area in Portugal after Lisbon, Porto, and Braga, and is the largest city of the district of Coimbra and the Central Region. About 460,000 people live in its intermunicipal community. Among the many archaeological structures dating back to the Roman era, when Coimbra was the settlement of Aeminium, are its well-preserved aqueduct and cryptoporticus. Similarly, buildings from the period when Coimbra was the capital of Portugal (from 1131 to 1255) still remain."}}, {"canonical_name": "sandalos citrinos", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "sandalos_citrinos", "book_id": "polyanthea_medicinal", "name": "sandalos citrinos", "category": "PLANT", "subcategory": "PLANT", "count": 8, "variants": ["sandalos citrinos", "Sandalos brancos", "Sandalos vermelhos", "sandalos", "sandalos vermelhos"], "contexts": ["ingredient in a decoction for fever", "citron sandalwood"]}, {"entity_id": "sândalo_citrino", "book_id": "coloquios_da_orta_1563", "name": "sândalo citrino", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["sândalo citrino"], "contexts": ["type of sandalwood"]}, {"entity_id": "sandali_citrini", "book_id": "ricettario_fiorentino_1597", "name": "Sandali citrini", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["Sandali citrini", "Sandali bianchO", "Sandati Citrini"], "contexts": ["yellow sandalwood used in preparation", "ingredient in a preparation"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "sandalos citrinos", "target_book": "coloquios_da_orta_1563", "target_name": "sândalo citrino", "similarity": 0.849}, {"source_book": "polyanthea_medicinal", "source_name": "sandalos citrinos", "target_book": "ricettario_fiorentino_1597", "target_name": "Sandali citrini", "similarity": 0.856}], "id": 320, "stable_key": "clu_e088062cdbd42ece", "ground_truth": {"modern_name": "yellow sandalwood", "confidence": "high", "type": "plant", "description": "A fragrant wood, likely a type of sandalwood, used medicinally.", "wikipedia_extract": "Sandalwood is a class of woods from trees in the genus Santalum. The woods are heavy, yellow, and fine-grained, and, unlike many other aromatic woods, they retain their fragrance for decades. Sandalwood oil is extracted from the woods. Sandalwood is often cited as one of the most expensive woods in the world. Both the wood and the oil produce a distinctive fragrance that has been highly valued for centuries. Consequently, some species of these slow-growing trees have suffered over-harvesting in the past."}}, {"canonical_name": "Hair", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 3, "total_mentions": 14, "members": [{"entity_id": "hair", "book_id": "english_physician_1652", "name": "Hair", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 11, "variants": ["Hair", "hair"], "contexts": ["body part, plant helps shedding", "body part that can be made black"]}, {"entity_id": "hair", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hair", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Hair"], "contexts": ["extimulating part used to kill dragon"]}, {"entity_id": "hair", "book_id": "connexion_physical_sciences_somerville_1858", "name": "hair", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["hair"], "contexts": ["filament from animal skin", "thin filament used for comparison"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Hair", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Hair", "similarity": 0.956}, {"source_book": "english_physician_1652", "source_name": "Hair", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "hair", "similarity": 0.943}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hair", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "hair", "similarity": 0.996}], "id": 321, "stable_key": "clu_333ed6d580e1f655", "ground_truth": {"modern_name": "Hair", "confidence": "high", "type": "animal", "note": "Identified as animal hair based on 'filament from animal skin' and 'body part, plant helps shedding'.", "wikidata_id": "Q866324", "wikidata_description": "organ found in the dermal layer of the mammalian skin that regulates hair growth", "wikipedia_url": "https://en.wikipedia.org/wiki/Hair%20follicle", "wikipedia_extract": "Hair is a protein filament that grows from follicles found in the dermis. Hair is one of the defining characteristics of mammals. The human body, apart from areas of glabrous skin, is covered in follicles which produce thick terminal and fine vellus hair. Most common interest in hair is focused on hair growth, hair types, and hair care, but hair is also an important biomaterial primarily composed of protein, notably alpha-keratin. Attitudes towards different forms of hair, such as hairstyles and hair removal, vary widely across different cultures and historical periods, but it is often used to indicate a person's personal beliefs or social position, such as their age, gender, or religion. The word \"hair\" usually refers to two distinct structures: the part beneath the skin, called the hair follicle, or, when pulled from the skin, the bulb or root."}}, {"canonical_name": "valeriana", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 14, "members": [{"entity_id": "valeriana", "book_id": "polyanthea_medicinal", "name": "valeriana", "category": "PLANT", "subcategory": "PLANT", "count": 8, "variants": ["valeriana", "Valeriana", "valeria"], "contexts": ["herb used for treatment", "roots used in a remedy"]}, {"entity_id": "valeriana", "book_id": "coloquios_da_orta_1563", "name": "Valeriana", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Valeriana"], "contexts": ["plant genus", "genus of a plant"]}, {"entity_id": "valeriana", "book_id": "ricettario_fiorentino_1597", "name": "Valeriana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Valeriana", "valeriana"], "contexts": ["plant with two varieties", "fragrant root for pounding"]}, {"entity_id": "valeriana_agreſte", "book_id": "polyanthea_medicinal", "name": "Valeriana agreſte", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Valeriana agreſte"], "contexts": ["wild valerian, used in remedy"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "valeriana", "target_book": "coloquios_da_orta_1563", "target_name": "Valeriana", "similarity": 0.873}, {"source_book": "polyanthea_medicinal", "source_name": "valeriana", "target_book": "ricettario_fiorentino_1597", "target_name": "Valeriana", "similarity": 0.814}, {"source_book": "coloquios_da_orta_1563", "source_name": "Valeriana", "target_book": "ricettario_fiorentino_1597", "target_name": "Valeriana", "similarity": 0.916}, {"source_book": "coloquios_da_orta_1563", "source_name": "Valeriana", "target_book": "polyanthea_medicinal", "target_name": "Valeriana agreſte", "similarity": 0.837}], "id": 322, "stable_key": "clu_0f44e4499b7dc7f5", "ground_truth": {"modern_name": "valerian", "confidence": "high", "type": "plant", "linnaean": "Valeriana spp.", "family": "Caprifoliaceae", "description": "A plant genus, with roots valued for medicinal and sedative properties.", "wikipedia_extract": "Valeriana is a genus of flowering plants in the family Caprifoliaceae, members of which may be commonly known as valerians. It contains many species, including the garden valerian, Valeriana officinalis. Valeriana has centers of diversity in Eurasia and South America (especially in the Andes), and is represented by native species on all continents except Antarctica. Some species have been introduced to parts of the world outside their native range, including Valeriana rubra in the western United States and Valeriana macrosiphon in Western Australia. The genus was named by Carl Linnaeus after the Roman emperor Publius Licinius Valerianus who was said to use the plant as medicine. The emperor's personal name comes from Valeria and the Latin verb valeo which means \"to be strong\". 32 previously recognized genera, including Centranthus, Fedia, and Plectritis, are now considered synonyms of Valeriana."}}, {"canonical_name": "Tartaria", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 14, "members": [{"entity_id": "tartaria", "book_id": "coloquios_da_orta_1563", "name": "Tartaria", "category": "PLACE", "subcategory": "REGION", "count": 7, "variants": ["Tartaria"], "contexts": ["region of origin for Avicena", "historical region"]}, {"entity_id": "tartarie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tartarie", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Tartarie", "Tarentaise"], "contexts": ["region excluding Tibet and Korea", "valley in the French Alps"]}, {"entity_id": "tarantaise", "book_id": "kosmos_humboldt_1845", "name": "Tarantaise", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Tarantaise"], "contexts": ["location of belemnitic limestone", "valley in the Alps"]}, {"entity_id": "tartary", "book_id": "kosmos_humboldt_1845", "name": "Tartary", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Tartary"], "contexts": ["region with grass plains"]}, {"entity_id": "tartar", "book_id": "coloquios_da_orta_1563", "name": "Tartar", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Tartar", "Tarear"], "contexts": ["city in Tartary", "city mentioned in the passage"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Tartaria", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Tartarie", "similarity": 0.977}, {"source_book": "coloquios_da_orta_1563", "source_name": "Tartaria", "target_book": "kosmos_humboldt_1845", "target_name": "Tarantaise", "similarity": 0.915}, {"source_book": "coloquios_da_orta_1563", "source_name": "Tartaria", "target_book": "kosmos_humboldt_1845", "target_name": "Tartary", "similarity": 0.947}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tartarie", "target_book": "kosmos_humboldt_1845", "target_name": "Tarantaise", "similarity": 0.904}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tartarie", "target_book": "kosmos_humboldt_1845", "target_name": "Tartary", "similarity": 0.954}, {"source_book": "kosmos_humboldt_1845", "source_name": "Tartary", "target_book": "coloquios_da_orta_1563", "target_name": "Tartar", "similarity": 0.811}], "id": 323, "stable_key": "clu_eace91dc5dbf8139", "ground_truth": {"modern_name": "Tartary", "confidence": "high", "type": "place", "description": "Historical region in Central and Northern Asia.", "note": "Refers to a vast historical region, often vaguely defined, in Central and Northern Asia.", "wikipedia_extract": "Tartary (Latin: Tartaria; French: Tartarie; German: Tartarei; Russian: Тартария, romanized: Tartariya) or Tatary (Russian: Татария, romanized: Tatariya) was a blanket term used in Western European literature and cartography for a vast part of Asia bounded by the Caspian Sea, the Ural Mountains, the Pacific Ocean, and the northern borders of China, India, and Persia, at a time when this region was largely unknown to European geographers. The active use of the toponym (place name) can be traced from the 13th to the 19th centuries. In European sources, Tartary became the most common name for Central Asia that had no connection with the real polities or ethnic groups of the region; until the 19th century, European knowledge of the area remained extremely scarce and fragmentary. In modern English-speaking tradition, the region formerly known as Tartary is usually called Inner Asia or Central Eurasia. Much of this area consists of arid plains, the main nomadic population of which in the past was engaged in animal husbandry. Ignorance surrounding Tartary's use as a place name has spawned pseudohistoric conspiracy theories including ideas of a \"hidden past\" and \"mud floods\"."}}, {"canonical_name": "anacardo", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 14, "members": [{"entity_id": "anacardo", "book_id": "coloquios_da_orta_1563", "name": "anacardo", "category": "PLANT", "subcategory": "PLANT", "count": 11, "variants": ["anacardo", "ANACARDO", "Anacardiace", "Anacardo", "anacardus"], "contexts": ["subject of discussion, Greek name for heart", "fruit used for various medicinal purposes"]}, {"entity_id": "anacardi", "book_id": "ricettario_fiorentino_1597", "name": "anacardi", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["anacardi"], "contexts": ["nuts used to extract mucilage"]}, {"entity_id": "anacardo", "book_id": "polyanthea_medicinal", "name": "Anacardo", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Anacardo", "Anacardos"], "contexts": ["ingredient in compound remedy", "cashews prepared for confection"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "anacardo", "target_book": "ricettario_fiorentino_1597", "target_name": "anacardi", "similarity": 0.852}, {"source_book": "coloquios_da_orta_1563", "source_name": "anacardo", "target_book": "polyanthea_medicinal", "target_name": "Anacardo", "similarity": 0.982}, {"source_book": "ricettario_fiorentino_1597", "source_name": "anacardi", "target_book": "polyanthea_medicinal", "target_name": "Anacardo", "similarity": 0.832}], "id": 324, "stable_key": "clu_c0a406c1a8f78e38", "ground_truth": {"modern_name": "cashew", "confidence": "high", "type": "plant", "linnaean": "Anacardium occidentale", "family": "Anacardiaceae", "description": "A tropical tree and its kidney-shaped nut, used medicinally.", "note": "The Greek name for heart (anacardion) is also referenced, linking to the shape of the nut.", "wikipedia_extract": "Cashew is the common name of a tropical evergreen tree Anacardium occidentale, in the family Anacardiaceae. It is the source of the cashew nut (often simply called a 'cashew') and the cashew apple. The tree can grow as tall as 14 meters (46 feet). The species is native to South America. The dwarf cultivars, growing up to 6 m (20 ft), are the most profitable, maturing sooner and producing greater yields. In 2023, 3.9 million tons of cashew nuts were harvested globally, led by the Ivory Coast and India."}}, {"canonical_name": "alcohol", "category": "SUBSTANCE", "subcategory": "CHEMICAL", "book_count": 3, "total_mentions": 14, "members": [{"entity_id": "alcohol", "book_id": "connexion_physical_sciences_somerville_1858", "name": "alcohol", "category": "SUBSTANCE", "subcategory": "CHEMICAL", "count": 9, "variants": ["alcohol"], "contexts": ["solvent used in heating experiments", "liquid in capillary action"]}, {"entity_id": "alcohol", "book_id": "principles_of_psychology_james_1890", "name": "alcohol", "category": "SUBSTANCE", "subcategory": "CHEMICAL", "count": 3, "variants": ["alcohol"], "contexts": ["chemical that can affect consciousness", "intoxicant affecting reaction time"]}, {"entity_id": "alcohol", "book_id": "first_principles_spencer_1862", "name": "alcohol", "category": "SUBSTANCE", "subcategory": "CHEMICAL", "count": 2, "variants": ["alcohol"], "contexts": ["intoxicating liquid", "chemical compound separated by distillation"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "alcohol", "target_book": "principles_of_psychology_james_1890", "target_name": "alcohol", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "alcohol", "target_book": "first_principles_spencer_1862", "target_name": "alcohol", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "alcohol", "target_book": "first_principles_spencer_1862", "target_name": "alcohol", "similarity": 1.0}], "id": 325, "stable_key": "clu_b038f1ecb5f5773f", "ground_truth": {"modern_name": "Alcohol", "confidence": "high", "type": "chemical", "wikidata_id": "Q153", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Ethanol", "wikipedia_extract": "Ethanol (also called ethyl alcohol, grain alcohol, drinking alcohol, or simply alcohol) is an organic compound with the chemical formula CH3CH2OH. It is an alcohol, with its formula also written as C2H5OH, C2H6O or EtOH, where Et is the pseudoelement symbol for ethyl. Ethanol is a volatile, flammable, colorless liquid with a pungent taste. As a psychoactive depressant, it is the active ingredient in alcoholic beverages, and the second most consumed drug globally behind caffeine. Ethanol is naturally produced by the fermentation process of sugars by yeasts or via petrochemical processes such as ethylene hydration. Historically it was used as a general anesthetic, and has modern medical applications as an antiseptic, disinfectant, solvent for some medications, and antidote for methanol poisoning and ethylene glycol poisoning."}}, {"canonical_name": "opilaciones", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 3, "total_mentions": 14, "members": [{"entity_id": "opilaciones", "book_id": "historia_medicinal_monardes_1574", "name": "opilaciones", "category": "DISEASE", "subcategory": "CHRONIC", "count": 12, "variants": ["opilaciones", "Opilaciones", "opilaciones del bago", "opilaciones interióres"], "contexts": ["obstructions", "obstructions treated by a substance"]}, {"entity_id": "opilações", "book_id": "coloquios_da_orta_1563", "name": "opilações", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["opilações"], "contexts": ["condition for which remedies are given"]}, {"entity_id": "opilação_das_veas_lacteas", "book_id": "polyanthea_medicinal", "name": "opilação das veas lacteas", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["opilação das veas lacteas"], "contexts": ["obstruction of lacteal veins"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "opilaciones", "target_book": "coloquios_da_orta_1563", "target_name": "opilações", "similarity": 0.968}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "opilaciones", "target_book": "polyanthea_medicinal", "target_name": "opilação das veas lacteas", "similarity": 0.842}, {"source_book": "coloquios_da_orta_1563", "source_name": "opilações", "target_book": "polyanthea_medicinal", "target_name": "opilação das veas lacteas", "similarity": 0.886}], "id": 326, "stable_key": "clu_6e30ef1eac0eaf93", "ground_truth": {"modern_name": "Obstruction", "confidence": "high", "type": "disease", "description": "Blockage or impediment in bodily passages or vessels.", "note": "Refers to the blockage of humors or vessels.", "wikipedia_extract": "Bowel obstruction, also known as intestinal obstruction, is a mechanical or functional obstruction of the intestines that prevents the normal movement of the products of digestion. Either the small bowel or large bowel may be affected. Signs and symptoms include abdominal pain, vomiting, bloating and not passing gas. Mechanical obstruction is the cause of about 5 to 15% of cases of severe abdominal pain of sudden onset requiring admission to hospital. Causes of bowel obstruction include adhesions, hernias, volvulus, endometriosis, inflammatory bowel disease, appendicitis, tumors, diverticulitis, ischemic bowel, tuberculosis and intussusception. Small bowel obstructions are most often due to adhesions and hernias, while large bowel obstructions are most often due to tumors and volvulus."}}, {"canonical_name": "Saxe", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "saxe", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Saxe", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Saxe"], "contexts": ["location of granite chains", "region"]}, {"entity_id": "saxony", "book_id": "english_physician_1652", "name": "Saxony", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Saxony"], "contexts": ["neighbor to Brandenburg in place", "region where Garden Rue is used against Jaundice"]}, {"entity_id": "saxony", "book_id": "kosmos_humboldt_1845", "name": "Saxony", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Saxony"], "contexts": ["mining districts with temperature data", "mining district in Germany"]}, {"entity_id": "saxon_erzgebirge", "book_id": "kosmos_humboldt_1845", "name": "Saxon Erzgebirge", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Saxon Erzgebirge"], "contexts": ["mining region in Saxony"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saxe", "target_book": "english_physician_1652", "target_name": "Saxony", "similarity": 0.946}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saxe", "target_book": "kosmos_humboldt_1845", "target_name": "Saxony", "similarity": 0.946}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saxe", "target_book": "kosmos_humboldt_1845", "target_name": "Saxon Erzgebirge", "similarity": 0.845}, {"source_book": "english_physician_1652", "source_name": "Saxony", "target_book": "kosmos_humboldt_1845", "target_name": "Saxony", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Saxony", "target_book": "kosmos_humboldt_1845", "target_name": "Saxon Erzgebirge", "similarity": 0.876}], "id": 327, "stable_key": "clu_ab8bf0b6eda0d12a", "ground_truth": {"modern_name": "Saxony", "confidence": "high", "type": "place", "description": "A historical region in Germany, known for its geography and flora.", "note": "Refers to the geographical region, not a person.", "wikipedia_extract": "Saxony, officially the Free State of Saxony, is a landlocked state of Germany, bordering the states of Brandenburg, Saxony-Anhalt, Thuringia, and Bavaria, as well as the countries of Poland and the Czech Republic. Its capital is Dresden, and its largest city is Leipzig. Saxony is the tenth largest of Germany's sixteen states, with an area of 18,413 square kilometres (7,109 sq mi), and the seventh most populous, with more than 4 million inhabitants. The term Saxony has been in use for more than a millennium. It was used for the medieval Duchy of Saxony, the Electorate of Saxony of the Holy Roman Empire, the Kingdom of Saxony, and twice for a republic. The first Free State of Saxony was established in 1918 as a constituent state of the Weimar Republic."}}, {"canonical_name": "Galapagos Archipelago", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "galapagos_archipelago", "book_id": "origin_of_species_darwin_1859", "name": "Galapagos Archipelago", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["Galapagos archipelago", "Galapagos Archipelago"], "contexts": ["islands with distinct bird populations", "archipelago with endemic birds"]}, {"entity_id": "galapagos", "book_id": "origin_of_species_darwin_1859", "name": "Galapagos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Galapagos"], "contexts": ["islands related to America", "birds of"]}, {"entity_id": "îles_galapagos", "book_id": "relation_historique_humboldt_vol3_1825", "name": "îles Galapagos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["îles Galapagos"], "contexts": ["Galapagos Islands"]}, {"entity_id": "galapagos", "book_id": "kosmos_humboldt_1845", "name": "Galapagos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Galapagos"], "contexts": ["volcanic island with augmented gravitation"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Galapagos Archipelago", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "îles Galapagos", "similarity": 0.956}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Galapagos Archipelago", "target_book": "kosmos_humboldt_1845", "target_name": "Galapagos", "similarity": 0.943}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Galapagos", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "îles Galapagos", "similarity": 0.949}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Galapagos", "target_book": "kosmos_humboldt_1845", "target_name": "Galapagos", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "îles Galapagos", "target_book": "kosmos_humboldt_1845", "target_name": "Galapagos", "similarity": 0.949}], "id": 328, "stable_key": "clu_16990224cacc931a", "ground_truth": {"modern_name": "Galapagos Archipelago", "confidence": "high", "type": "place", "description": "A volcanic archipelago in the Pacific Ocean.", "wikipedia_extract": "The Galápagos Islands (Spanish: Islas Galápagos) are an archipelago of volcanic islands in the Eastern Pacific, located around the equator, 485 nautical miles (898 km; 558 mi) west of the mainland of South America. They form the Galápagos Province of the Republic of Ecuador, with a population of slightly over 33,000 (2020). The province is divided into the cantons of San Cristóbal, Santa Cruz, and Isabela, the three most populated islands in the chain. The Galápagos are famous for their large number of endemic species, which were studied by Charles Darwin in the 1830s and inspired his theory of evolution by means of natural selection. All of these islands are protected as part of Ecuador's Galápagos National Park and Marine Reserve. There is no firm evidence that Polynesians or the Indigenous peoples of South America reached the islands before their accidental discovery by Bishop Tomás de Berlanga in 1535."}}, {"canonical_name": "lungs", "category": "ANATOMY", "subcategory": "ORGAN", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "lungs", "book_id": "first_principles_spencer_1862", "name": "lungs", "category": "ANATOMY", "subcategory": "ORGAN", "count": 4, "variants": ["lungs"], "contexts": ["organs for breathing", "organs for respiration"]}, {"entity_id": "lungs", "book_id": "origin_of_species_darwin_1859", "name": "lungs", "category": "ANATOMY", "subcategory": "ORGAN", "count": 3, "variants": ["lungs"], "contexts": ["organs for respiration in vertebrates", "respiratory organs in air-breathing vertebrates"]}, {"entity_id": "lung", "book_id": "origin_of_species_darwin_1859", "name": "lung", "category": "ANATOMY", "subcategory": "ORGAN", "count": 3, "variants": ["lung"], "contexts": ["organ for breathing air", "nascent breathing organ"]}, {"entity_id": "lungs", "book_id": "principles_of_psychology_james_1890", "name": "lungs", "category": "ANATOMY", "subcategory": "ORGAN", "count": 3, "variants": ["lungs"], "contexts": ["organ producing feelings", "assigned seat of the soul"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "lungs", "target_book": "origin_of_species_darwin_1859", "target_name": "lungs", "similarity": 1.0}, {"source_book": "first_principles_spencer_1862", "source_name": "lungs", "target_book": "origin_of_species_darwin_1859", "target_name": "lung", "similarity": 0.972}, {"source_book": "first_principles_spencer_1862", "source_name": "lungs", "target_book": "principles_of_psychology_james_1890", "target_name": "lungs", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "lungs", "target_book": "principles_of_psychology_james_1890", "target_name": "lungs", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "lung", "target_book": "principles_of_psychology_james_1890", "target_name": "lungs", "similarity": 0.972}], "id": 329, "stable_key": "clu_21ce2ae9280f1225", "ground_truth": {"modern_name": "lungs", "confidence": "high", "type": "anatomy", "description": "Paired organs responsible for respiration in vertebrates.", "wikipedia_extract": "The lungs are the primary organs of the respiratory system in many animals, including humans. In mammals and most other tetrapods, two lungs are located near the backbone on either side of the heart. Their function in the respiratory system is to extract oxygen from the atmosphere and transfer it into the bloodstream, and to release carbon dioxide from the bloodstream into the atmosphere, in a process of gas exchange. Respiration is driven by different muscular systems in different species. Mammals, reptiles and birds use their musculoskeletal systems to support and foster breathing. In early tetrapods, air was driven into the lungs by the pharyngeal muscles via buccal pumping, a mechanism still seen in amphibians."}}, {"canonical_name": "Ostrich", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "ostrich", "book_id": "origin_of_species_darwin_1859", "name": "Ostrich", "category": "ANIMAL", "subcategory": "BIRD", "count": 7, "variants": ["ostrich", "Ostrich"], "contexts": ["large flightless bird", "bird that lays a score of eggs"]}, {"entity_id": "ostriches", "book_id": "origin_of_species_darwin_1859", "name": "ostriches", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["ostriches"], "contexts": ["birds with communal nesting behavior"]}, {"entity_id": "american_ostrich", "book_id": "origin_of_species_darwin_1859", "name": "American ostrich", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["American ostrich"], "contexts": ["ostrich species with imperfect nesting instinct"]}, {"entity_id": "ostrich", "book_id": "kosmos_humboldt_1845", "name": "ostrich", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["ostrich"], "contexts": ["bird resembling dinornis", "animal previously thought to be dodo"]}, {"entity_id": "ostrich_tribe", "book_id": "kosmos_humboldt_1845", "name": "ostrich tribe", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["ostrich tribe"], "contexts": ["group of birds including ostriches"]}, {"entity_id": "ostrich", "book_id": "first_principles_spencer_1862", "name": "ostrich", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["ostrich"], "contexts": ["large flightless bird"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Ostrich", "target_book": "kosmos_humboldt_1845", "target_name": "ostrich", "similarity": 0.963}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Ostrich", "target_book": "kosmos_humboldt_1845", "target_name": "ostrich tribe", "similarity": 0.893}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Ostrich", "target_book": "first_principles_spencer_1862", "target_name": "ostrich", "similarity": 0.963}, {"source_book": "origin_of_species_darwin_1859", "source_name": "ostriches", "target_book": "kosmos_humboldt_1845", "target_name": "ostrich", "similarity": 0.95}, {"source_book": "origin_of_species_darwin_1859", "source_name": "ostriches", "target_book": "kosmos_humboldt_1845", "target_name": "ostrich tribe", "similarity": 0.878}, {"source_book": "origin_of_species_darwin_1859", "source_name": "ostriches", "target_book": "first_principles_spencer_1862", "target_name": "ostrich", "similarity": 0.95}, {"source_book": "origin_of_species_darwin_1859", "source_name": "American ostrich", "target_book": "kosmos_humboldt_1845", "target_name": "ostrich", "similarity": 0.878}, {"source_book": "origin_of_species_darwin_1859", "source_name": "American ostrich", "target_book": "first_principles_spencer_1862", "target_name": "ostrich", "similarity": 0.878}, {"source_book": "kosmos_humboldt_1845", "source_name": "ostrich", "target_book": "first_principles_spencer_1862", "target_name": "ostrich", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "ostrich tribe", "target_book": "first_principles_spencer_1862", "target_name": "ostrich", "similarity": 0.909}], "id": 330, "stable_key": "clu_548fb5db4faf005a", "ground_truth": {"modern_name": "Ostrich", "confidence": "high", "type": "animal", "note": "Includes references to 'American ostrich', which belongs to the genus Rhea, but the primary referent is clearly the Ostrich (Struthio).", "wikidata_id": "Q2354075", "wikidata_description": "heraldic animal", "wikipedia_extract": "The common ostrich (Struthio camelus), or simply ostrich, is a species of flightless bird native to certain areas of Africa and is the largest living species of bird and thus the largest living dinosaur. The common ostrich is one of two extant species of ostriches, the only living members of the genus Struthio in the ratite group of birds. The other is the Somali ostrich (Struthio molybdophanes), which has been recognized as a distinct species by BirdLife International since 2014, having been previously considered a distinctive subspecies of ostrich. The common ostrich belongs to the order Struthioniformes. Struthioniformes previously contained all the ratites, such as the kiwis, emus, rheas, and cassowaries. However, a recent genetic analysis has found that the group is not monophyletic, as it is paraphyletic with respect to the tinamous, so the ostriches are now classified as the only members of the order.", "wikipedia_url": "https://en.wikipedia.org/wiki/Common_ostrich"}}, {"canonical_name": "hygromètre à baleine", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "hygromètre_à_baleine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "hygromètre à baleine", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 9, "variants": ["hygromètre à baleine", "HYGROMÈTRE", "hygromètre", "hygromètre de Deluc", "hygromètre à cheveu"], "contexts": ["instrument for measuring humidity", "whalebone hygrometer for humidity measurement"]}, {"entity_id": "hygrometer", "book_id": "kosmos_humboldt_1845", "name": "hygrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["hygrometer"], "contexts": ["instrument for measuring humidity"]}, {"entity_id": "hygrometer", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Hygrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["hygrometer", "Hygrometer"], "contexts": ["instrument for measuring humidity", "instrument for measuring dew-point"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "hygromètre à baleine", "target_book": "kosmos_humboldt_1845", "target_name": "hygrometer", "similarity": 0.854}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "hygromètre à baleine", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Hygrometer", "similarity": 0.852}, {"source_book": "kosmos_humboldt_1845", "source_name": "hygrometer", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Hygrometer", "similarity": 0.994}], "id": 331, "stable_key": "clu_0438fcb18de9a09d", "ground_truth": {"modern_name": "Hygrometer", "confidence": "high", "type": "object", "note": "The term 'hygromètre à baleine' is a specific type of hygrometer that uses whalebone. 'Hygrometer' is the general modern term.", "wikidata_id": "Q183173", "wikidata_description": "instrument used for measuring the moisture content in the atmosphere", "wikipedia_url": "https://en.wikipedia.org/wiki/Hygrometer", "wikipedia_extract": "A hygrometer is an instrument that measures humidity: that is, how much water vapor is present. Humidity measurement instruments usually rely on measurements of some other quantities, such as temperature, pressure, mass, and mechanical or electrical changes in a substance as moisture is absorbed. By calibration and calculation, these measured quantities can be used to indicate the humidity. Modern electronic devices use the temperature of condensation (called the dew point), or they sense changes in electrical capacitance or resistance. The maximum amount of water vapor that can be present in a given volume (at saturation) varies greatly with temperature; at low temperatures a lower mass of water per unit volume can remain as vapor than at high temperatures. Thus a change in the temperature changes the relative humidity."}}, {"canonical_name": "crusados", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "crusados", "book_id": "coloquios_da_orta_1563", "name": "crusados", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 7, "variants": ["crusados", "cristeis", "crusado", "cruzaros"], "contexts": ["currency used to buy amber", "unit of currency"]}, {"entity_id": "creusets", "book_id": "relation_historique_humboldt_vol3_1825", "name": "creusets", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["creusets"], "contexts": ["vessels for melting copper"]}, {"entity_id": "croix", "book_id": "relation_historique_humboldt_vol3_1825", "name": "croix", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["croix"], "contexts": ["held by mendicants"]}, {"entity_id": "cross", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cross", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Cross"], "contexts": ["constellation near starless patches", "celestial reference point"]}, {"entity_id": "κ_crucis", "book_id": "connexion_physical_sciences_somerville_1858", "name": "κ Crucis", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["κ Crucis"], "contexts": ["elegant cluster of variously coloured stars"]}, {"entity_id": "cruizers", "book_id": "connexion_physical_sciences_somerville_1858", "name": "cruizers", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["cruizers"], "contexts": ["ships used for patrolling and observation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "crusados", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "creusets", "similarity": 0.897}, {"source_book": "coloquios_da_orta_1563", "source_name": "crusados", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "croix", "similarity": 0.927}, {"source_book": "coloquios_da_orta_1563", "source_name": "crusados", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cross", "similarity": 0.896}, {"source_book": "coloquios_da_orta_1563", "source_name": "crusados", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "κ Crucis", "similarity": 0.906}, {"source_book": "coloquios_da_orta_1563", "source_name": "crusados", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "cruizers", "similarity": 0.871}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "creusets", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "cruizers", "similarity": 0.866}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "croix", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cross", "similarity": 0.952}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "croix", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "κ Crucis", "similarity": 0.932}], "id": 332, "stable_key": "clu_ed2b8f1420e367e0", "ground_truth": {"modern_name": "Crusado", "confidence": "high", "type": "object", "description": "Portuguese currency, and a vessel for melting metals.", "note": "This cluster conflates a unit of currency ('crusados') with a type of crucible ('creusets') and a religious symbol ('croix'). The primary meaning suggested by the context of 'currency' and 'buying amber' is the Portuguese Crusado coin. However, the presence of 'creusets' also points to a vessel.", "wikipedia_extract": "Guru Arjan (Gurmukhi: ਗੁਰੂ ਅਰਜਨ, pronunciation: [gʊɾuː əɾd͡ʒənᵊ]; 15 April 1563 – 30 May 1606) was the fifth of the ten total Sikh Gurus. He compiled the first official edition of the Sikh scripture called the Adi Granth, which later expanded into the Guru Granth Sahib. He is regarded as the first of the two Gurus martyred in the Sikh faith. Guru Arjan was born in Goindval, in the Punjab, the youngest son of Bhai Jetha, who later became Guru Ram Das, and Mata Bhani, the daughter of Guru Amar Das. He completed the construction of the Darbar Sahib at Amritsar, after the fourth Sikh Guru founded the town and built a sarovar. Arjan compiled the hymns of previous Gurus and of other saints into Adi Granth, the first edition of the Sikh scripture, and installed it in the Harimandir Sahib."}}, {"canonical_name": "Scaligero", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "scaligero", "book_id": "coloquios_da_orta_1563", "name": "Scaligero", "category": "PERSON", "subcategory": "AUTHORITY", "count": 11, "variants": ["Scaligero"], "contexts": ["Defended Pliny's statement on aloes", "made notes on Orta's book"]}, {"entity_id": "scaligero", "book_id": "polyanthea_medicinal", "name": "Scaligero", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Scaligero"], "contexts": ["Julius Caesar Scaliger"]}, {"entity_id": "scaliger", "book_id": "first_principles_spencer_1862", "name": "Scaliger", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Scaliger"], "contexts": ["Renaissance scholar"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Scaligero", "target_book": "polyanthea_medicinal", "target_name": "Scaligero", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Scaligero", "target_book": "first_principles_spencer_1862", "target_name": "Scaliger", "similarity": 0.976}, {"source_book": "polyanthea_medicinal", "source_name": "Scaligero", "target_book": "first_principles_spencer_1862", "target_name": "Scaliger", "similarity": 0.976}], "id": 333, "stable_key": "clu_fe7b1dd04a97f390", "ground_truth": {"modern_name": "Julius Caesar Scaliger", "confidence": "high", "type": "person", "description": "Influential Italian scholar and physician of the Renaissance.", "wikipedia_extract": "Julius Caesar Scaliger (; 23 April  or August 1484 – 21 October 1558), or Giulio Cesare della Scala, was an Italian scholar and physician, who spent a major part of his career in France. He employed the techniques and discoveries of Renaissance humanism to defend Aristotelianism against the New Learning. In spite of his contentious disposition, his contemporary reputation was high. Jacques Auguste de Thou claimed that none of the ancients could be placed above him and that he had no equal in his own time. Scaliger's father, Benedetto Bordone, was a miniaturist and illuminator. Scaliger himself was known in his youth by the family name Bordone, but later insisted that he was a scion of the house of La Scala, for a hundred and fifty years lords of Verona."}}, {"canonical_name": "caparroſa", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "caparroſa", "book_id": "polyanthea_medicinal", "name": "caparroſa", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["caparroſa", "Caparroſa"], "contexts": ["ingredient in unguent", "herb for bleeding"]}, {"entity_id": "caparosa", "book_id": "coloquios_da_orta_1563", "name": "caparosa", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["caparosa"], "contexts": ["substancia usada como caustico", "mineral substance mentioned with numbers"]}, {"entity_id": "copparofa", "book_id": "ricettario_fiorentino_1597", "name": "copparofa", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["copparofa"], "contexts": ["type of vitriol found on earth's surface"]}, {"entity_id": "caparro", "book_id": "polyanthea_medicinal", "name": "Caparro", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["Caparro", "Caparrofa branca", "Caparrose", "Caparrose de Chipre"], "contexts": ["white vitriol used in a preparation", "ingredient in a cataract remedy"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "caparroſa", "target_book": "coloquios_da_orta_1563", "target_name": "caparosa", "similarity": 0.937}, {"source_book": "polyanthea_medicinal", "source_name": "caparroſa", "target_book": "ricettario_fiorentino_1597", "target_name": "copparofa", "similarity": 0.845}, {"source_book": "coloquios_da_orta_1563", "source_name": "caparosa", "target_book": "polyanthea_medicinal", "target_name": "Caparro", "similarity": 0.828}], "id": 334, "stable_key": "clu_07c6d676222aef12", "ground_truth": {"modern_name": "Vitriol", "confidence": "high", "type": "substance", "description": "A sulfate mineral, often used as a caustic or astringent.", "note": "Refers to various sulfate minerals, particularly copper or zinc sulfates.", "wikipedia_extract": "Vitriol is the general chemical name encompassing a class of chemical compounds comprising sulfates of certain metals – originally, iron or copper. Those mineral substances were distinguished by their color, such as green vitriol for hydrated iron(II) sulfate and blue vitriol for hydrated copper(II) sulfate. These materials were found originally as crystals formed by evaporation of groundwater that percolated through sulfide minerals and collected in pools on the floors of old mines. The word vitriol comes from the Latin word vitriolus, meaning \"small glass\", as those crystals resembled small pieces of colored glass. Oil of vitriol was an old name for concentrated sulfuric acid, which was historically obtained through the destructive distillation (pyrolysis) of vitriols (sulfates). The name, abbreviated to vitriol, continued to be used for this viscous liquid long after the minerals came to be termed \"sulfates\"."}}, {"canonical_name": "Angelica", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "angelica", "book_id": "english_physician_1652", "name": "Angelica", "category": "PLANT", "subcategory": "PLANT", "count": 6, "variants": ["Angelica", "Ange∣lica"], "contexts": ["plant with admirable use", "herb with admirable virtues"]}, {"entity_id": "angélica_archangelica", "book_id": "coloquios_da_orta_1563", "name": "Angélica archangelica", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Angélica archangelica"], "contexts": ["plant name", "angelica herb"]}, {"entity_id": "angelicas", "book_id": "polyanthea_medicinal", "name": "angelicas", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["angelicas"], "contexts": ["flower causing uterine accidents", "plant, angelica"]}, {"entity_id": "angelim", "book_id": "polyanthea_medicinal", "name": "Angelim", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Angelim"], "contexts": ["tree bark used for worms"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Angelica", "target_book": "coloquios_da_orta_1563", "target_name": "Angélica archangelica", "similarity": 0.902}, {"source_book": "english_physician_1652", "source_name": "Angelica", "target_book": "polyanthea_medicinal", "target_name": "angelicas", "similarity": 0.94}, {"source_book": "english_physician_1652", "source_name": "Angelica", "target_book": "polyanthea_medicinal", "target_name": "Angelim", "similarity": 0.857}, {"source_book": "coloquios_da_orta_1563", "source_name": "Angélica archangelica", "target_book": "polyanthea_medicinal", "target_name": "angelicas", "similarity": 0.89}], "id": 335, "stable_key": "clu_b238eb518921748d", "ground_truth": {"modern_name": "Angelica", "confidence": "high", "type": "plant", "linnaean": "Angelica archangelica", "family": "Apiaceae", "description": "Aromatic herb with medicinal properties, often used for digestive issues.", "wikipedia_extract": "Angelica archangelica, commonly known as angelica, garden angelica, wild celery, and Norwegian angelica, is a biennial plant from the family Apiaceae, a subspecies of which is cultivated for its sweetly scented edible stems and roots. Like several other species in Apiaceae, its appearance is similar to several poisonous species (Conium, Heracleum, and others), and should not be consumed unless it has been identified with absolute certainty. Synonyms include Archangelica officinalis Hoffm. and Angelica officinalis Moench. During its first year, it grows only leaves, but during its second year, its fluted stem can reach a height of 2.5 meters (just over 8 feet), and the root is used in flavoring preparations. Its leaves consist of numerous small leaflets divided into three principal groups, each of which is again subdivided into three lesser groups. The edges of the leaflets are finely toothed or serrated."}}, {"canonical_name": "antidotos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "antidotos", "book_id": "polyanthea_medicinal", "name": "antidotos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 8, "variants": ["antidotos", "Antidotos", "antidota"], "contexts": ["substances to counteract poisons", "antidotes"]}, {"entity_id": "antidotes", "book_id": "english_physician_1652", "name": "Antidotes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Antidotes"], "contexts": ["medicines for venemous bites containing Spignel", "substances to counteract poison"]}, {"entity_id": "antidoti", "book_id": "ricettario_fiorentino_1597", "name": "antidoti", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["antidoti"], "contexts": ["compound medicines, uses black chalciti"]}, {"entity_id": "antidotosdogallico", "book_id": "polyanthea_medicinal", "name": "antidotosdogallico", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["antidotosdogallico"], "contexts": ["remedies for syphilis"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "antidotos", "target_book": "english_physician_1652", "target_name": "Antidotes", "similarity": 0.968}, {"source_book": "polyanthea_medicinal", "source_name": "antidotos", "target_book": "ricettario_fiorentino_1597", "target_name": "antidoti", "similarity": 0.992}, {"source_book": "english_physician_1652", "source_name": "Antidotes", "target_book": "ricettario_fiorentino_1597", "target_name": "antidoti", "similarity": 0.971}, {"source_book": "ricettario_fiorentino_1597", "source_name": "antidoti", "target_book": "polyanthea_medicinal", "target_name": "antidotosdogallico", "similarity": 0.823}], "id": 336, "stable_key": "clu_93792dae3f7a0507", "ground_truth": {"modern_name": "Antidote", "confidence": "high", "type": "substance", "description": "A substance that counteracts a poison or disease.", "note": "Includes general antidotes and specific remedies, like those for syphilis.", "wikipedia_extract": "An antidote is a substance that can counteract a form of poisoning. The term ultimately derives from the Greek term φάρμακον ἀντίδοτον (pharmakon antidoton), \"(medicine) given as a remedy\". An older term in English which is now rare is atterlothe, derived from \"atter\" (\"poison, venom, morbid fluid\"). Antidotes for anticoagulants are sometimes referred to as reversal agents. The antidotes for some particular toxins are manufactured by injecting the toxin into an animal in small doses and extracting the resulting antibodies from the host animals' blood. This results in an antivenom that can be used to counteract venom produced by certain species of snakes, spiders, and other venomous animals."}}, {"canonical_name": "Ammonites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "ammonites", "book_id": "origin_of_species_darwin_1859", "name": "Ammonites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["Ammonites", "ammonites"], "contexts": ["group that went extinct suddenly", "extinct marine invertebrates"]}, {"entity_id": "ammonites", "book_id": "relation_historique_humboldt_vol3_1825", "name": "ammonites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["ammonites", "Ammonites nodosus"], "contexts": ["fossil found in jurassic limestone", "quelques ammonites"]}, {"entity_id": "ammonites", "book_id": "kosmos_humboldt_1845", "name": "Ammonites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["Ammonites"], "contexts": ["fossil cephalopods", "extinct marine mollusks"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Ammonites", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "ammonites", "similarity": 0.981}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Ammonites", "target_book": "kosmos_humboldt_1845", "target_name": "Ammonites", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "ammonites", "target_book": "kosmos_humboldt_1845", "target_name": "Ammonites", "similarity": 0.981}], "id": 337, "stable_key": "clu_8d32ba7f7b8c3878", "ground_truth": {"modern_name": "ammonites", "confidence": "high", "type": "animal", "family": "Ammonitida", "description": "Extinct marine molluscs with coiled shells, found as fossils.", "note": "Ammonites are extinct cephalopods. While historically sometimes classified differently, they are now recognized as an extinct group of molluscs.", "wikipedia_extract": "Ammonoids are extinct, typically coiled-shelled cephalopods composing the subclass Ammonoidea. They are more closely related to living octopuses, squid, and cuttlefish (which compose the clade Coleoidea) than they are to nautiluses (family Nautilidae), which they resemble. The earliest ammonoids appeared during the Emsian stage of the Early Devonian, around 410-408 million years ago, with the last species vanishing during or soon after the Cretaceous–Paleogene extinction event approximately 66 million years ago. They are often called ammonites, which is most frequently used for members of the order Ammonitida, the only remaining group of ammonoids from the Jurassic up until their extinction. Ammonoids exhibited considerable diversity over their evolutionary history, with over 10,000 species having been described. Ammonoids are excellent index fossils, and they have been frequently used to link rock layers in which a particular species or genus is found to specific geologic time periods."}}, {"canonical_name": "Biela", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "biela", "book_id": "kosmos_humboldt_1845", "name": "Biela", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 6, "variants": ["Biela"], "contexts": ["comet with short period of revolution", "comet discoverer"]}, {"entity_id": "beagle", "book_id": "origin_of_species_darwin_1859", "name": "Beagle", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Beagle"], "contexts": ["ship on which a beetle flew aboard", "ship on which Colymbetes flew"]}, {"entity_id": "biela’s", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Biela’s", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 4, "variants": ["Biela’s"], "contexts": ["comet named after an individual", "a specific comet"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Biela", "target_book": "origin_of_species_darwin_1859", "target_name": "Beagle", "similarity": 0.841}, {"source_book": "kosmos_humboldt_1845", "source_name": "Biela", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Biela’s", "similarity": 0.907}], "id": 338, "stable_key": "clu_968b34e0fa5a6676", "ground_truth": {"modern_name": "Biela's Comet", "confidence": "medium", "type": "concept", "note": "The cluster contains references to 'Biela' and 'Biela’s', which clearly refer to Biela's Comet. However, it also includes 'Beagle', the ship Darwin sailed on. The strong presence of 'Biela' and the context of celestial objects in Humboldt's 'Kosmos' point to the comet as the primary referent, with 'Beagle' being a misattribution or secondary mention within the texts analyzed.", "wikipedia_extract": "Biela's Comet or Comet Biela (official designation: 3D/Biela) was a periodic Jupiter-family comet first recorded in 1772 by Montaigne and Messier and finally identified as periodic in 1826 by Wilhelm von Biela. It was subsequently observed to split in two and has not been seen since 1852. As a result, it is currently considered to have been destroyed, although remnants have survived for some time as a meteor shower, the Andromedids. The comet was first recorded on 8 March 1772 by Jacques Leibax Montaigne; during the same apparition it was independently discovered by Charles Messier. It was also recorded in 1805 by Jean-Louis Pons, but was not recognized as the same object. Around 9 December 1805 comet Biela passed about 0.0366 AU (5.48 million km) from Earth."}}, {"canonical_name": "chronomètres", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "chronomètres", "book_id": "relation_historique_humboldt_vol3_1825", "name": "chronomètres", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 8, "variants": ["chronomètres", "chronomètre", "chronomêtre"], "contexts": ["used for linking points", "measuring time"]}, {"entity_id": "chronograph", "book_id": "principles_of_psychology_james_1890", "name": "Chronograph", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["Chronograph"], "contexts": ["time-registering instrument"]}, {"entity_id": "chronoscope", "book_id": "principles_of_psychology_james_1890", "name": "Chronoscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["Chronoscope"], "contexts": ["precise time-measuring instrument"]}, {"entity_id": "chronometric_apparatus", "book_id": "principles_of_psychology_james_1890", "name": "chronometric apparatus", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["chronometric apparatus"], "contexts": ["device for measuring time"]}, {"entity_id": "chronometers", "book_id": "connexion_physical_sciences_somerville_1858", "name": "chronometers", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["chronometers"], "contexts": ["highly accurate timekeeping devices"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "chronomètres", "target_book": "principles_of_psychology_james_1890", "target_name": "Chronograph", "similarity": 0.949}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "chronomètres", "target_book": "principles_of_psychology_james_1890", "target_name": "Chronoscope", "similarity": 0.932}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "chronomètres", "target_book": "principles_of_psychology_james_1890", "target_name": "chronometric apparatus", "similarity": 0.946}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "chronomètres", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chronometers", "similarity": 0.976}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Chronograph", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chronometers", "similarity": 0.933}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Chronoscope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chronometers", "similarity": 0.92}, {"source_book": "principles_of_psychology_james_1890", "source_name": "chronometric apparatus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chronometers", "similarity": 0.937}], "id": 339, "stable_key": "clu_4763863b0ecab4aa", "ground_truth": {"modern_name": "Chronometers", "confidence": "high", "type": "object", "description": "Instruments for measuring and indicating time with high accuracy.", "wikipedia_extract": "A clock or chronometer is a device that measures and displays time. The clock is one of the oldest human inventions, meeting the need to measure intervals of time shorter than the natural units such as the day, the lunar month, and the year. Devices operating on several physical processes have been used over the millennia. Some predecessors to the modern clock may be considered \"clocks\" that are based on movement in nature: A sundial shows the time by displaying the position of a shadow on a flat surface. There is a range of duration timers, a well-known example being the hourglass. Water clocks, along with sundials, are possibly the oldest time-measuring instruments."}}, {"canonical_name": "calmas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "calmas", "book_id": "polyanthea_medicinal", "name": "calmas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["calmas", "calmas exceffivas"], "contexts": ["heat or intensity", "heat"]}, {"entity_id": "calme", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Calme", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Calme", "Calme plat", "calme"], "contexts": ["state of no wind", "description of sea state"]}, {"entity_id": "calms", "book_id": "kosmos_humboldt_1845", "name": "calms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["calms"], "contexts": ["lack of wind"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "calmas", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Calme", "similarity": 0.886}, {"source_book": "polyanthea_medicinal", "source_name": "calmas", "target_book": "kosmos_humboldt_1845", "target_name": "calms", "similarity": 0.935}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Calme", "target_book": "kosmos_humboldt_1845", "target_name": "calms", "similarity": 0.943}], "id": 340, "stable_key": "clu_37efd6b2c7448b39", "ground_truth": {"modern_name": "Calm", "confidence": "high", "type": "concept", "description": "A state of stillness, especially of the air or sea, without wind.", "note": "Refers to a state of stillness, not a chemical element.", "wikipedia_extract": "Calm technology or calm design is a type of information technology where the interaction between the technology and its user is designed to occur in the user's periphery rather than constantly at the center of attention. Information from the technology smoothly shifts to the user's attention when needed but otherwise stays calmly in the user's periphery. Mark Weiser and John Seely Brown describe calm technology as \"that which informs but doesn't demand our focus or attention.\" The use of calm technology is paired with ubiquitous computing as a way to minimize the perceptible invasiveness of computers in everyday life. For a technology to be considered calm technology, there are three core principles it should adhere to: The user's attention to the technology must reside mainly in the periphery. This means that either the technology can easily shift between the center of attention and the periphery or that much of the information conveyed by the technology is present in the periphery rather than the center. The technology increases a user's use of his or her periphery."}}, {"canonical_name": "Valparaiso", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "valparaiso", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Valparaiso", "category": "PLACE", "subcategory": "CITY", "count": 10, "variants": ["Valparaiso", "Valparayso"], "contexts": ["city in Chile", "city"]}, {"entity_id": "valparaiso", "book_id": "kosmos_humboldt_1845", "name": "Valparaiso", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Valparaiso"], "contexts": ["city near Aconcagua"]}, {"entity_id": "valparaiso", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Valparaiso", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Valparaiso"], "contexts": ["location of intense earthquake effects"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Valparaiso", "target_book": "kosmos_humboldt_1845", "target_name": "Valparaiso", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Valparaiso", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Valparaiso", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Valparaiso", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Valparaiso", "similarity": 1.0}], "id": 341, "stable_key": "clu_0fd0e88f21b11d0c", "ground_truth": {"modern_name": "Valparaíso", "confidence": "high", "type": "place", "country": "Chile", "wikidata_id": "Q868888", "wikidata_description": "city in Porter County, Indiana, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Valparaiso%2C%20Indiana", "wikipedia_extract": "Valparaíso is a major city, commune, seaport, and naval base facility in the Valparaíso Region of Chile. Valparaíso was originally named after Valparaíso de Arriba, in Castile-La Mancha, Spain. Greater Valparaíso is the second-most populous metro area in the country. Valparaiso is the second-largest city in the metro area (behind Viña del Mar). It is located about 120 km (75 mi) northwest of Santiago, by road, and is one of the Pacific Ocean's most important seaports. Valparaíso is the capital of Chile's second most-populated administrative region and has been the Chilean Navy headquarters since 1817, as well as being the seat of the National Congress of Chile since 1990."}}, {"canonical_name": "Chimborazo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "chimborazo", "book_id": "kosmos_humboldt_1845", "name": "Chimborazo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["Chimborazo"], "contexts": ["mountain elevation data", "great Colossus of the Andes"]}, {"entity_id": "chiniborazo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Chiniborazo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Chiniborazo"], "contexts": ["volcano in Ecuador"]}, {"entity_id": "cimborazo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cimborazo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cimborazo"], "contexts": ["mountain name"]}, {"entity_id": "chimborazo", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Chimborazo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Chimborazo"], "contexts": ["mountain for gravitational comparison"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Chimborazo", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Chiniborazo", "similarity": 0.877}, {"source_book": "kosmos_humboldt_1845", "source_name": "Chimborazo", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Cimborazo", "similarity": 0.97}, {"source_book": "kosmos_humboldt_1845", "source_name": "Chimborazo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Chimborazo", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Chiniborazo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Chimborazo", "similarity": 0.877}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cimborazo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Chimborazo", "similarity": 0.97}], "id": 342, "stable_key": "clu_8bc009f320e189a6", "ground_truth": {"modern_name": "Chimborazo", "confidence": "high", "type": "place", "country": "Ecuador", "wikidata_id": "Q238492", "wikidata_description": "province of Ecuador", "wikipedia_url": "https://en.wikipedia.org/wiki/Chimborazo%20Province", "wikipedia_extract": "Chimborazo (Spanish: [tʃimboˈɾaso] ) is a stratovolcano in Ecuador and the Cordillera Occidental range of the Andes. Its last known eruption is believed to have occurred around AD 550. Although not the tallest mountain in the Andes or on Earth relative to sea level, its summit is the farthest point on Earth's surface from the Earth's center due to its location along the planet's equatorial bulge. Chimborazo's height from sea level is 6,263 m (20,548 ft), well below that of Mount Everest at 8,849 m (29,032 ft). Chimborazo is the highest mountain in Ecuador and the 39th-highest peak in the entire Andes. It is a popular destination for mountaineering due to its challenging climbing routes, which involve traversing snow, ice, and rocky terrain."}}, {"canonical_name": "Bezaar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "bezaar", "book_id": "historia_medicinal_monardes_1574", "name": "Bezaar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 7, "variants": ["Bezaar", "Bezaares", "Bezaartica"], "contexts": ["stone with antidote properties", "stone used as an antidote"]}, {"entity_id": "bevara", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bevara", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Bevara"], "contexts": ["river", "river confluent"]}, {"entity_id": "be^oar", "book_id": "coloquios_da_orta_1563", "name": "be^oar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["be^oar"], "contexts": ["Arabic word for bezoar", "modern form of bezoar"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Bezaar", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Bevara", "similarity": 0.852}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Bezaar", "target_book": "coloquios_da_orta_1563", "target_name": "be^oar", "similarity": 0.854}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bevara", "target_book": "coloquios_da_orta_1563", "target_name": "be^oar", "similarity": 0.863}], "id": 343, "stable_key": "clu_555c7a57f967f46d", "ground_truth": {"modern_name": "bezoar", "confidence": "high", "type": "substance", "description": "Calculus found in the stomach of animals, used as an antidote.", "wikipedia_extract": "A bezoar stone (, BEE-zor) is a mass often found trapped in the gastrointestinal system, though it can occur in other locations. A pseudobezoar is an indigestible object introduced intentionally into the digestive system. There are several varieties of bezoar, some of which have inorganic constituents and others organic. The term has both modern (medical, scientific) and traditional usage. Food boluses (or boli; singular bolus) have the archaic and positive meaning of bezoar, and are composed of loose aggregates of food items such as seeds, fruit pith, or pits, as well as other types of items such as shellac, bubble gum, soil, and concretions of some medications. Lactobezoars are a specific type of food bezoar consisting of inspissated milk."}}, {"canonical_name": "Corte", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "corte", "book_id": "polyanthea_medicinal", "name": "Corte", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 10, "variants": ["Corte", "Corte de Portugal", "Cortede França"], "contexts": ["location of a case", "location of a woman"]}, {"entity_id": "corte", "book_id": "historia_medicinal_monardes_1574", "name": "corte", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["corte"], "contexts": ["court, source of orders"]}, {"entity_id": "corte", "book_id": "ricettario_fiorentino_1597", "name": "Corte", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Corte"], "contexts": ["court or legal jurisdiction"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Corte", "target_book": "historia_medicinal_monardes_1574", "target_name": "corte", "similarity": 0.898}, {"source_book": "polyanthea_medicinal", "source_name": "Corte", "target_book": "ricettario_fiorentino_1597", "target_name": "Corte", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "corte", "target_book": "ricettario_fiorentino_1597", "target_name": "Corte", "similarity": 0.898}], "id": 344, "stable_key": "clu_053a6929e6ca977a", "ground_truth": {"modern_name": "court", "confidence": "high", "type": "place", "description": "Royal court, legal jurisdiction, or enclosed space.", "note": "Contexts suggest both the physical space of a court and its associated authority.", "wikipedia_extract": "A court is an institution, often a government entity, with the authority to adjudicate legal disputes between parties  and administer justice in civil, criminal, and administrative matters in accordance with the rule of law. Courts generally consist of judges or other judicial officers, and are usually established and dissolved through legislation enacted by a legislature. Courts may also be established by constitution or an equivalent constituting instrument. The practical authority given to the court is known as its jurisdiction, which describes the court's power to decide certain kinds of questions, or petitions put to it. There are various kinds of courts, including trial courts, appellate courts, administrative courts, international courts, and tribunals. A court is any person or institution, often as a government institution, with the authority to adjudicate legal disputes between parties and carry out the administration of justice in civil, criminal, and administrative matters in accordance with the rule of law."}}, {"canonical_name": "Aphelion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "aphelion", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Aphelion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["Aphelion", "aphelion"], "contexts": ["point farthest from the sun in orbit", "point of farthest approach from sun"]}, {"entity_id": "aphelion", "book_id": "kosmos_humboldt_1845", "name": "aphelion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["aphelion"], "contexts": ["point farthest from the Sun in orbit"]}, {"entity_id": "aphelion", "book_id": "first_principles_spencer_1862", "name": "aphelion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["aphelion"], "contexts": ["point farthest from the sun"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Aphelion", "target_book": "kosmos_humboldt_1845", "target_name": "aphelion", "similarity": 0.963}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Aphelion", "target_book": "first_principles_spencer_1862", "target_name": "aphelion", "similarity": 0.963}, {"source_book": "kosmos_humboldt_1845", "source_name": "aphelion", "target_book": "first_principles_spencer_1862", "target_name": "aphelion", "similarity": 1.0}], "id": 345, "stable_key": "clu_95c85177f5b05502", "ground_truth": {"modern_name": "Aphelion", "confidence": "high", "type": "concept", "wikidata_id": "Q10414642", "wikidata_description": "genus of insects", "wikipedia_extract": "An apsis (from Ancient Greek  ἁψίς (hapsís) 'arch, vault' (third declension); pl. apsides  AP-sih-deez) is the farthest or nearest point in the orbit of a planetary body about its primary body. The line of apsides (also called apse line, or major axis of the orbit) is the line connecting the two extreme values. Apsides pertaining to orbits around different bodies have distinct names to differentiate themselves from other apsides. Apsides pertaining to geocentric orbits, orbits around the Earth, are at the farthest point called the apogee, and at the nearest point the perigee, as with orbits of satellites and the Moon around Earth. Apsides pertaining to orbits around the Sun are named aphelion for the farthest and perihelion for the nearest point in a heliocentric orbit. Earth's two apsides are the farthest point, aphelion, and the nearest point, perihelion, of its orbit around the host Sun."}}, {"canonical_name": "Adder", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "adder", "book_id": "english_physician_1652", "name": "Adder", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 9, "variants": ["Adder"], "contexts": ["venomous beast", "serpent with antipathy to ash tree"]}, {"entity_id": "adder", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Adder", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["Adder"], "contexts": ["type of serpent"]}, {"entity_id": "adder", "book_id": "origin_of_species_darwin_1859", "name": "adder", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["adder"], "contexts": ["reptile with a venomous fang"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Adder", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Adder", "similarity": 0.862}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Adder", "target_book": "origin_of_species_darwin_1859", "target_name": "adder", "similarity": 0.927}], "id": 346, "stable_key": "clu_7c5e4a17c4c40ddf", "ground_truth": {"modern_name": "Adder", "confidence": "high", "type": "animal", "wikidata_id": "Q192056", "wikidata_description": "species of snake belonging to the viper family (Viperidae)", "wikipedia_url": "https://en.wikipedia.org/wiki/Adder", "wikipedia_extract": "Vipera berus, commonly known as the common European adder and the common European viper, is a species of venomous snake in the family Viperidae. The species is extremely widespread and can be found throughout much of Europe, and as far as East Asia. There are three recognised subspecies. Known by a host of common names including common adder and common viper, the adder has been the subject of much folklore in Britain and other European countries. It is not regarded as especially dangerous; the snake is not aggressive and usually bites only when really provoked, stepped on, or picked up. Bites can be very painful, but are rarely fatal."}}, {"canonical_name": "dysenteria", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "dysenteria", "book_id": "coloquios_da_orta_1563", "name": "dysenteria", "category": "DISEASE", "subcategory": "ACUTE", "count": 5, "variants": ["dysenteria", "Dysenterias", "dysen terias", "dysenterias"], "contexts": ["illness treated with avacari bark", "disease against which the remedy is effective"]}, {"entity_id": "dysenteries", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "dysenteries", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["dysenteries"], "contexts": ["disease treated with Crystal", "intestinal inflammation"]}, {"entity_id": "dysenterias", "book_id": "polyanthea_medicinal", "name": "dysenterias", "category": "DISEASE", "subcategory": "ACUTE", "count": 3, "variants": ["dysenterias", "Dysenterias", "dysenteriam"], "contexts": ["bloody flux", "dysentery"]}, {"entity_id": "diſenterias", "book_id": "polyanthea_medicinal", "name": "diſenterias", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["diſenterias"], "contexts": ["condition treated with remedies"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "dysenteria", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "dysenteries", "similarity": 0.915}, {"source_book": "coloquios_da_orta_1563", "source_name": "dysenteria", "target_book": "polyanthea_medicinal", "target_name": "dysenterias", "similarity": 0.881}, {"source_book": "coloquios_da_orta_1563", "source_name": "dysenteria", "target_book": "polyanthea_medicinal", "target_name": "diſenterias", "similarity": 0.841}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "dysenteries", "target_book": "polyanthea_medicinal", "target_name": "dysenterias", "similarity": 0.98}], "id": 347, "stable_key": "clu_35c56e8df4fff90e", "ground_truth": {"modern_name": "Dysentery", "confidence": "high", "type": "disease", "description": "An intestinal inflammation causing severe diarrhea with blood and mucus.", "wikipedia_extract": "Dysentery (UK: , US: ), historically known as the bloody flux, is a type of gastroenteritis that results in bloody diarrhea. Other symptoms may include fever, abdominal pain, and a feeling of incomplete defecation. Complications may include dehydration. The cause of dysentery is usually the bacteria from genus Shigella, in which case it is known as shigellosis, or the amoeba Entamoeba histolytica; then it is called amoebiasis. Other causes may include certain chemicals, other bacteria, other protozoa, or parasitic worms. It may spread between people."}}, {"canonical_name": "Liver", "category": "ANATOMY", "subcategory": "ORGAN", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "liver", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Liver", "category": "ANATOMY", "subcategory": "ORGAN", "count": 5, "variants": ["liver", "Liver"], "contexts": ["organ where gall is seated", "abdominal organ"]}, {"entity_id": "liver", "book_id": "principles_of_psychology_james_1890", "name": "liver", "category": "ANATOMY", "subcategory": "ORGAN", "count": 3, "variants": ["liver"], "contexts": ["organ that secretes bile", "organ involved in activity"]}, {"entity_id": "liver", "book_id": "first_principles_spencer_1862", "name": "liver", "category": "ANATOMY", "subcategory": "ORGAN", "count": 3, "variants": ["liver"], "contexts": ["commences as multiplication of cells", "organ developing from intestine wall"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Liver", "target_book": "principles_of_psychology_james_1890", "target_name": "liver", "similarity": 0.934}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Liver", "target_book": "first_principles_spencer_1862", "target_name": "liver", "similarity": 0.934}, {"source_book": "principles_of_psychology_james_1890", "source_name": "liver", "target_book": "first_principles_spencer_1862", "target_name": "liver", "similarity": 1.0}], "id": 348, "stable_key": "clu_d3d457d192619640", "ground_truth": {"modern_name": "Liver", "confidence": "high", "type": "anatomy", "wikidata_id": "Q24826", "wikidata_description": "city in Merseyside, England, United Kingdom", "wikipedia_url": "https://en.wikipedia.org/wiki/Liverpool", "wikipedia_extract": "The liver is a major metabolic organ exclusively found in vertebrates, which performs many essential biological functions such as detoxification of the organism, and the synthesis of various proteins and various other biochemicals necessary for digestion and growth. In humans, it is located in the right upper quadrant of the abdomen, below the diaphragm and mostly shielded by the lower right rib cage. Its other metabolic roles include carbohydrate metabolism, the production of a number of hormones, conversion and storage of nutrients such as glucose and glycogen, and the decomposition of red blood cells. Anatomical and medical terminology often use the prefix hepat- from ἡπατο-, from the Greek word for liver, such as hepatology, and hepatitis. The liver is also an accessory digestive organ that produces bile, an alkaline fluid containing cholesterol and bile acids,  which emulsifies and aids the breakdown of dietary fat. The gallbladder, a small hollow pouch that sits just under the right lobe of liver, stores and concentrates the bile produced by the liver, which is later excreted to the duodenum to help with digestion."}}, {"canonical_name": "testiculos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "testiculos", "book_id": "polyanthea_medicinal", "name": "testiculos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["testiculos", "testiculo"], "contexts": ["testicles", "body part of goat"]}, {"entity_id": "testicles", "book_id": "english_physician_1652", "name": "Testicles", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["Testicles"], "contexts": ["comparison for seed shape", "male reproductive organs"]}, {"entity_id": "testículos", "book_id": "coloquios_da_orta_1563", "name": "testículos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["testículos"], "contexts": ["body part"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "testiculos", "target_book": "english_physician_1652", "target_name": "Testicles", "similarity": 0.94}, {"source_book": "polyanthea_medicinal", "source_name": "testiculos", "target_book": "coloquios_da_orta_1563", "target_name": "testículos", "similarity": 0.968}, {"source_book": "english_physician_1652", "source_name": "Testicles", "target_book": "coloquios_da_orta_1563", "target_name": "testículos", "similarity": 0.973}], "id": 349, "stable_key": "clu_1864f7b1a25ffeab", "ground_truth": {"modern_name": "testicles", "confidence": "high", "type": "substance", "description": "Male reproductive organs.", "wikipedia_extract": "A testicle, also called testis (pl. testes) is the male gonad in all gonochoric animals, including humans, and is homologous to the ovary, which is the female gonad. Its primary functions are the production of sperm and the secretion of androgens, primarily testosterone. The release of testosterone is regulated by luteinizing hormone (LH) from the anterior pituitary gland. Sperm production is controlled by follicle-stimulating hormone (FSH) from the anterior pituitary gland and by testosterone produced within the gonads. Male humans have two testicles of similar size contained within the scrotum, which is an extension of the abdominal wall. Scrotal asymmetry, in which one testicle extends farther down into the scrotum than the other, is common."}}, {"canonical_name": "jaws", "category": "ANATOMY", "subcategory": "BODY_PART", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "jaws", "book_id": "origin_of_species_darwin_1859", "name": "jaws", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 8, "variants": ["jaws"], "contexts": ["part homologous with limbs", "mouthparts for biting"]}, {"entity_id": "jaw", "book_id": "origin_of_species_darwin_1859", "name": "jaw", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["jaw"], "contexts": ["part of the mouth"]}, {"entity_id": "jaw", "book_id": "principles_of_psychology_james_1890", "name": "jaw", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["jaw"], "contexts": ["organ of reaction"]}, {"entity_id": "jaws", "book_id": "first_principles_spencer_1862", "name": "jaws", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["jaws"], "contexts": ["bones of the mouth"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "jaws", "target_book": "principles_of_psychology_james_1890", "target_name": "jaw", "similarity": 0.931}, {"source_book": "origin_of_species_darwin_1859", "source_name": "jaws", "target_book": "first_principles_spencer_1862", "target_name": "jaws", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "jaw", "target_book": "principles_of_psychology_james_1890", "target_name": "jaw", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "jaw", "target_book": "first_principles_spencer_1862", "target_name": "jaws", "similarity": 0.931}, {"source_book": "principles_of_psychology_james_1890", "source_name": "jaw", "target_book": "first_principles_spencer_1862", "target_name": "jaws", "similarity": 0.931}], "id": 350, "stable_key": "clu_7faa9939620b57df", "ground_truth": {"modern_name": "jaws", "confidence": "high", "type": "anatomy", "description": "The bones of the mouth that hold the teeth and are used for biting.", "wikipedia_extract": "Most bony fishes have two sets of jaws made mainly of bone. The primary oral jaws open and close the mouth, and a second set of pharyngeal jaws are positioned at the back of the throat. The oral jaws are used to capture and manipulate prey by biting and crushing. The pharyngeal jaws, so-called because they are positioned within the pharynx, are used to further process the food and move it from the mouth to the stomach. Cartilaginous fishes, such as sharks and rays, have one set of oral jaws made mainly of cartilage. They do not have pharyngeal jaws."}}, {"canonical_name": "Bourbon", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "bourbon", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bourbon", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["BOURBON", "Bourbon"], "contexts": ["location with sugar cultivation", "location of sugar cultivation"]}, {"entity_id": "bourbon", "book_id": "kosmos_humboldt_1845", "name": "Bourbon", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Bourbon"], "contexts": ["island now known as Réunion"]}, {"entity_id": "bourbon", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bourbon", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Bourbon"], "contexts": ["island in the Indian Ocean (Réunion)"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bourbon", "target_book": "kosmos_humboldt_1845", "target_name": "Bourbon", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bourbon", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bourbon", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bourbon", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bourbon", "similarity": 1.0}], "id": 351, "stable_key": "clu_de3fae7be6ed5cf5", "ground_truth": {"modern_name": "Réunion", "confidence": "high", "type": "place", "country": "France", "note": "Historically referred to as Bourbon Island.", "wikidata_id": "Q17070", "wikidata_description": "overseas department of France in the Indian Ocean", "wikipedia_url": "https://en.wikipedia.org/wiki/R%C3%A9union", "wikipedia_extract": "Réunion (; French: [la ʁe.ynjɔ̃] ; Reunionese Creole: La Rényon; known as Île Bourbon before 1848) is an island in the Indian Ocean that is an overseas department and region of France within the African region. Part of the Mascarene Islands, it is located approximately 679 kilometres (367 nautical miles) east of the island of Madagascar and 175 kilometres (94 nmi) southwest of the island of Mauritius. As of January 2026, it had a population of 910,985. Its capital and largest city is Saint-Denis. Before the arrival of French colonial subjects and immigrants in the 17th century, Réunion was an uninhabited island. Its tropical climate led to the development of a plantation economy focused primarily on sugar; slaves from East Africa were imported as fieldworkers, followed by Malays, Vietnamese, Chinese, and Indians as indentured laborers."}}, {"canonical_name": "Auvergne", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "auvergne", "book_id": "kosmos_humboldt_1845", "name": "Auvergne", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Auvergne"], "contexts": ["region in France", "region with come-shaped volcanic summits"]}, {"entity_id": "auvergne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Auvergne", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Auvergne"], "contexts": ["region in France"]}, {"entity_id": "auvergne", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Auvergne", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Auvergne"], "contexts": ["region containing Chaudes Aigues", "region with temperature measurement"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Auvergne", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Auvergne", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Auvergne", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Auvergne", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Auvergne", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Auvergne", "similarity": 1.0}], "id": 352, "stable_key": "clu_1e6acf86567019ff", "ground_truth": {"modern_name": "Auvergne", "confidence": "high", "type": "place", "country": "France", "wikidata_id": "Q1152", "wikidata_description": "cultural and historical region of France", "wikipedia_url": "https://en.wikipedia.org/wiki/Auvergne", "wikipedia_extract": "Auvergne (; French: [ovɛʁɲ] ; Occitan: Auvèrnhe or Auvèrnha) is a cultural region in central France. It is now largely part of the Auvergne-Rhône-Alpes administrative region. Auvergne is generally regarded as conterminous with the land area of the historical Province of Auvergne, which was dissolved in 1790, and with the now-defunct administrative region of Auvergne, which existed from 1956 to 2015. The region is home to a chain of volcanoes known collectively as the \"chaîne des Puys\". The volcanoes began forming about 70,000 years ago, and most have eroded, leaving plugs of hardened magma that form rounded hilltops known as puys. The last confirmed eruption occurred around 4040 BCE."}}, {"canonical_name": "livres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "livres", "book_id": "relation_historique_humboldt_vol3_1825", "name": "livres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 9, "variants": ["livres", "livres espagnoles"], "contexts": ["unit of weight for cotton and indigo", "unit of weight"]}, {"entity_id": "libras", "book_id": "coloquios_da_orta_1563", "name": "libras", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["libras"], "contexts": ["currency, livres francezas"]}, {"entity_id": "libbra", "book_id": "ricettario_fiorentino_1597", "name": "libbra", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["libbra"], "contexts": ["unit of weight"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "livres", "target_book": "coloquios_da_orta_1563", "target_name": "libras", "similarity": 0.92}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "livres", "target_book": "ricettario_fiorentino_1597", "target_name": "libbra", "similarity": 0.881}, {"source_book": "coloquios_da_orta_1563", "source_name": "libras", "target_book": "ricettario_fiorentino_1597", "target_name": "libbra", "similarity": 0.915}], "id": 353, "stable_key": "clu_a85e44c22852ac69", "ground_truth": {"modern_name": "Livre", "confidence": "high", "type": "concept", "description": "Unit of weight and currency in historical France.", "note": "Refers to historical French currency and units of weight, not the planet or musician.", "wikipedia_extract": "Antoine-Laurent de Lavoisier ( lə-VWAH-zee-ay; French: [ɑ̃twan lɔʁɑ̃ də lavwazje]; 26 August 1743 – 8 May 1794), also Antoine Lavoisier after the French Revolution, was a French nobleman and chemist who was central to the 18th-century chemical revolution and who had a large influence on both the history of chemistry and the history of biology. It is generally accepted that Lavoisier's great accomplishments in chemistry stem largely from his changing the science from a qualitative to a quantitative one. Lavoisier is noted for his discovery of the role oxygen plays in combustion, opposing the prior phlogiston theory of combustion. He named oxygen (1778), recognizing it as an element, and also recognized hydrogen as an element (1783). By using more precise measurements than previous experimenters, he confirmed the  developing theory that, although matter in a closed system may change its form or shape, its mass always remains the same (now known as the law of conservation of mass), which led to the development of the balanced physical and chemical reaction equations that we still use today. Lavoisier helped construct the metric system, wrote the first extensive list of elements, in which he predicted the existence of silicon, and helped to reform chemical nomenclature. (1787) His wife and laboratory assistant, Marie-Anne Paulze Lavoisier, became a renowned chemist in her own right, and worked with him to develop the metric system of measurements."}}, {"canonical_name": "Respiração", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "respiração", "book_id": "polyanthea_medicinal", "name": "Respiração", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["Respiração", "Respiração apreslada", "respiraça", "respiração"], "contexts": ["breathing", "bodily function"]}, {"entity_id": "breathe", "book_id": "principles_of_psychology_james_1890", "name": "breathe", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["breathe"], "contexts": ["process of inhaling and exhaling"]}, {"entity_id": "breathing", "book_id": "first_principles_spencer_1862", "name": "breathing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["breathing"], "contexts": ["process of respiration"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Respiração", "target_book": "principles_of_psychology_james_1890", "target_name": "breathe", "similarity": 0.916}, {"source_book": "polyanthea_medicinal", "source_name": "Respiração", "target_book": "first_principles_spencer_1862", "target_name": "breathing", "similarity": 0.927}, {"source_book": "principles_of_psychology_james_1890", "source_name": "breathe", "target_book": "first_principles_spencer_1862", "target_name": "breathing", "similarity": 0.989}], "id": 354, "stable_key": "clu_e805813a0207e258", "ground_truth": {"modern_name": "Respiration", "confidence": "high", "type": "concept", "description": "The physiological process of breathing.", "wikipedia_extract": "Photosynthesis ( FOH-tə-SINTH-ə-sis) is a system of biological processes by which photopigment-bearing autotrophic organisms, such as most plants, algae and cyanobacteria, convert light energy — typically from sunlight — into the chemical energy necessary to fuel their metabolism. The term photosynthesis usually refers to oxygenic photosynthesis, a process that releases oxygen as a byproduct of water splitting. Photosynthetic organisms store the converted chemical energy within the bonds of intracellular organic compounds (complex compounds containing carbon), typically carbohydrates like sugars (mainly glucose, fructose and sucrose), starches, phytoglycogen and cellulose. When needing to use this stored energy, an organism's cells then metabolize the organic compounds through cellular respiration. Photosynthesis plays a critical role in producing and maintaining the oxygen content of the Earth's atmosphere, and it supplies most of the biological energy necessary for complex life on Earth. Some organisms also perform anoxygenic photosynthesis, which does not produce oxygen.", "wikipedia_url": "https://en.wikipedia.org/wiki/Photosynthesis"}}, {"canonical_name": "Meca", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "meca", "book_id": "coloquios_da_orta_1563", "name": "Meca", "category": "PLACE", "subcategory": "CITY", "count": 9, "variants": ["Meca", "Mecca"], "contexts": ["origin of goods to Diu", "strait from where a substance is brought"]}, {"entity_id": "mecca", "book_id": "kosmos_humboldt_1845", "name": "Mecca", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Mecca"], "contexts": ["site of pilgrim assemblage"]}, {"entity_id": "mecca", "book_id": "ricettario_fiorentino_1597", "name": "Mecca", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Mecca"], "contexts": ["origin of a type of Sena"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Meca", "target_book": "kosmos_humboldt_1845", "target_name": "Mecca", "similarity": 0.919}, {"source_book": "coloquios_da_orta_1563", "source_name": "Meca", "target_book": "ricettario_fiorentino_1597", "target_name": "Mecca", "similarity": 0.919}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mecca", "target_book": "ricettario_fiorentino_1597", "target_name": "Mecca", "similarity": 1.0}], "id": 355, "stable_key": "clu_1b6824642e457912", "ground_truth": {"modern_name": "Mecca", "confidence": "high", "type": "place", "description": "Holy city in Saudi Arabia, ancient center of trade.", "wikipedia_extract": "Mecca, officially Makkah al-Mukarramah, is the holiest city in Islam. It is located in the Hejazi region of western Saudi Arabia and is the capital of Mecca Province. Mecca is considered the birthplace of Islam and is the birthplace of the Islamic prophet Muhammad. It is 70 km (43 mi) inland from Jeddah on the Red Sea, in a narrow valley 277 m (909 ft) above sea level. Its metropolitan population in 2022 was 2.4 million, making it the third–most populated city in Saudi Arabia after Riyadh and Jeddah. The Cave of Hira atop the Jabal al-Nour, just outside the city, is where Muslims believe the Quran was first revealed to Muhammad."}}, {"canonical_name": "Tripas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "tripas", "book_id": "polyanthea_medicinal", "name": "Tripas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 8, "variants": ["Tripas", "tripa", "tripas"], "contexts": ["intestines", "intestines, part of the body"]}, {"entity_id": "tripas", "book_id": "historia_medicinal_monardes_1574", "name": "tripas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Tripas", "tripas"], "contexts": ["intestines"]}, {"entity_id": "tripas", "book_id": "coloquios_da_orta_1563", "name": "tripas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["tripas"], "contexts": ["intestines"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Tripas", "target_book": "historia_medicinal_monardes_1574", "target_name": "tripas", "similarity": 0.95}, {"source_book": "polyanthea_medicinal", "source_name": "Tripas", "target_book": "coloquios_da_orta_1563", "target_name": "tripas", "similarity": 0.95}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "tripas", "target_book": "coloquios_da_orta_1563", "target_name": "tripas", "similarity": 1.0}], "id": 356, "stable_key": "clu_f10a1a5b759aaf5e", "ground_truth": {"modern_name": "Intestines", "confidence": "high", "type": "anatomy", "description": "The part of the digestive system in animals.", "note": "Refers to the anatomical organs.", "wikipedia_extract": "The gastrointestinal tract (also called the GI tract, digestive tract, and the alimentary canal) is the tract or passageway of the digestive system that leads from the mouth to the anus. The tract is one of the largest of the body's systems. The GI tract contains all the major organs of the digestive system, in humans and other animals, including the esophagus, stomach, and intestines. Food taken in through the mouth is digested to extract nutrients and absorb energy, and the waste expelled at the anus as feces. Gastrointestinal is an adjective meaning of or pertaining to the stomach and intestines. Most animals have a \"through-gut\" or complete digestive tract."}}, {"canonical_name": "sarampãos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "sarampãos", "book_id": "polyanthea_medicinal", "name": "sarampãos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 8, "variants": ["sarampãos", "Sarampaõ", "sarampao", "sarampão"], "contexts": ["measles", "disease treated with Bezoartic cordial"]}, {"entity_id": "sarampio", "book_id": "historia_medicinal_monardes_1574", "name": "Sarampio", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Sarampio"], "contexts": ["name for the disease"]}, {"entity_id": "sarampam", "book_id": "coloquios_da_orta_1563", "name": "sarampam", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["sarampam"], "contexts": ["ailment treated by a plant", "measles or a similar eruptive fever"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "sarampãos", "target_book": "historia_medicinal_monardes_1574", "target_name": "Sarampio", "similarity": 0.918}, {"source_book": "polyanthea_medicinal", "source_name": "sarampãos", "target_book": "coloquios_da_orta_1563", "target_name": "sarampam", "similarity": 0.869}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Sarampio", "target_book": "coloquios_da_orta_1563", "target_name": "sarampam", "similarity": 0.891}], "id": 357, "stable_key": "clu_53c5a49a4251c645", "ground_truth": {"modern_name": "Measles", "confidence": "high", "type": "disease", "description": "A highly contagious infectious disease causing fever and rash.", "note": "Refers to the eruptive fever known as measles.", "wikipedia_extract": "Measles (probably from Middle Dutch or Middle High German masel(e), meaning \"blemish, blood blister\") is a highly contagious, vaccine-preventable infectious disease caused by measles virus. Other names include morbilli, rubeola, 9-day measles, red measles, and English measles. Symptoms usually develop 10–12 days after exposure to an infected person and last 7–10 days. Initial symptoms typically include fever, often greater than 40 °C (104 °F), cough, runny nose, and inflamed eyes. Small white spots known as Koplik spots may form inside the mouth two or three days after the start of symptoms. A red, flat rash which usually starts on the face and then spreads to the rest of the body typically begins three to five days after the start of symptoms."}}, {"canonical_name": "Magellan", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "magellan", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Magellan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Magellan"], "contexts": ["strait in South America", "Explorer whose voyage influenced demarcation"]}, {"entity_id": "magellan", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Magellan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Magellan"], "contexts": ["straits with compass variation", "strait at the southern tip of South America"]}, {"entity_id": "magellanica", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Magellanica", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Magellanica"], "contexts": ["geographic region"]}, {"entity_id": "straits_of_magellan", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "straits of Magellan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["straits of Magellan"], "contexts": ["location with needle declination"]}, {"entity_id": "magellan", "book_id": "origin_of_species_darwin_1859", "name": "Magellan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Magellan"], "contexts": ["Straits"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Magellan", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Magellan", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Magellan", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Magellanica", "similarity": 0.921}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Magellan", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "straits of Magellan", "similarity": 0.869}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Magellan", "target_book": "origin_of_species_darwin_1859", "target_name": "Magellan", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Magellan", "target_book": "origin_of_species_darwin_1859", "target_name": "Magellan", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Magellanica", "target_book": "origin_of_species_darwin_1859", "target_name": "Magellan", "similarity": 0.921}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "straits of Magellan", "target_book": "origin_of_species_darwin_1859", "target_name": "Magellan", "similarity": 0.869}], "id": 358, "stable_key": "clu_52320083452c3030", "ground_truth": {"modern_name": "Strait of Magellan", "confidence": "high", "type": "place", "description": "A sea passage in South America named after an explorer.", "note": "Refers to both the geographical strait and the explorer Ferdinand Magellan.", "wikipedia_extract": "The Strait of Magellan (Spanish: Estrecho de Magallanes), also called the Straits of Magellan, is a navigable sea route in southern Chile separating mainland South America to the north and the Tierra del Fuego archipelago to the south. Considered the most important natural passage between the Atlantic and Pacific oceans, the strait is approximately 570 km (310 nmi; 350 mi) long and 2 km (1.1 nmi; 1.2 mi) wide at its narrowest point. In 1520, the Spanish expedition of the Portuguese navigator Ferdinand Magellan, after whom the strait is named, became the first Europeans to discover it. Magellan's original name for the strait was Estrecho de Todos los Santos (\"Strait of All Saints\"). The King of Spain, Emperor Charles V, who had sponsored the Magellan-Elcano expedition, changed the name to the Strait of Magellan in honor of Magellan. The route is difficult to navigate due to frequent narrows and unpredictable winds and currents."}}, {"canonical_name": "Hail", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "hail", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Hail", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["Hail", "hail"], "contexts": ["frozen precipitation", "approach makes atmosphere intensely electric"]}, {"entity_id": "hail", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hail", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Hail"], "contexts": ["frozen precipitation"]}, {"entity_id": "hayl", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hayl", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Hayl"], "contexts": ["frozen precipitation"]}, {"entity_id": "hail", "book_id": "kosmos_humboldt_1845", "name": "hail", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["hail"], "contexts": ["frozen precipitation", "ice precipitation"]}, {"entity_id": "hail-stones", "book_id": "kosmos_humboldt_1845", "name": "hail-stones", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["hail-stones"], "contexts": ["frozen precipitation"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Hail", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Hail", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Hail", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Hayl", "similarity": 0.852}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Hail", "target_book": "kosmos_humboldt_1845", "target_name": "hail", "similarity": 0.98}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Hail", "target_book": "kosmos_humboldt_1845", "target_name": "hail-stones", "similarity": 0.824}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hail", "target_book": "kosmos_humboldt_1845", "target_name": "hail", "similarity": 0.98}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hail", "target_book": "kosmos_humboldt_1845", "target_name": "hail-stones", "similarity": 0.824}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hayl", "target_book": "kosmos_humboldt_1845", "target_name": "hail", "similarity": 0.819}], "id": 359, "stable_key": "clu_ebf77973c4b59653", "ground_truth": {"modern_name": "Hail", "confidence": "high", "type": "concept", "wikidata_id": "Q1569280", "wikidata_description": "municipality in the region of Northern Ostrobothnia in Finland", "wikipedia_url": "https://en.wikipedia.org/wiki/Hailuoto", "wikipedia_extract": "Hail is a form of solid precipitation. It is distinct from ice pellets (American English \"sleet\"), though the two are often confused. It consists of balls or irregular lumps of ice, each of which is called a hailstone. Ice pellets generally fall in cold weather, while hail growth is greatly inhibited during low surface temperatures. Unlike other forms of water ice precipitation, such as graupel (which is made of rime ice), ice pellets (which are smaller and translucent), and snow (which consists of tiny, delicately crystalline flakes or needles), hailstones usually measure between 5 mm (0.2 in) and 15 cm (6 in) in diameter. The METAR reporting code for hail 5 mm (0.20 in) or greater is GR, while smaller hailstones and graupel are coded GS."}}, {"canonical_name": "lentilhas", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "lentilhas", "book_id": "polyanthea_medicinal", "name": "lentilhas", "category": "PLANT", "subcategory": "PLANT", "count": 5, "variants": ["lentilhas", "Lentilhas"], "contexts": ["ingredient for mouthwash", "lentils used in a remedy"]}, {"entity_id": "lentils", "book_id": "english_physician_1652", "name": "Lentils", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Lentils"], "contexts": ["plant with similar leaves"]}, {"entity_id": "lentilhas_de_agoa", "book_id": "coloquios_da_orta_1563", "name": "lentilhas de agoa", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["lentilhas de agoa", "lentilha de agoa"], "contexts": ["plants that grow on water", "aquatic plant"]}, {"entity_id": "lentisco", "book_id": "coloquios_da_orta_1563", "name": "lentisco", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["lentisco"], "contexts": ["plant for comparison of leaf shape", "plant used for leaf comparison"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "lentilhas", "target_book": "english_physician_1652", "target_name": "Lentils", "similarity": 0.91}, {"source_book": "polyanthea_medicinal", "source_name": "lentilhas", "target_book": "coloquios_da_orta_1563", "target_name": "lentilhas de agoa", "similarity": 0.869}, {"source_book": "polyanthea_medicinal", "source_name": "lentilhas", "target_book": "coloquios_da_orta_1563", "target_name": "lentisco", "similarity": 0.873}, {"source_book": "english_physician_1652", "source_name": "Lentils", "target_book": "coloquios_da_orta_1563", "target_name": "lentilhas de agoa", "similarity": 0.84}, {"source_book": "english_physician_1652", "source_name": "Lentils", "target_book": "coloquios_da_orta_1563", "target_name": "lentisco", "similarity": 0.829}], "id": 360, "stable_key": "clu_c8487a7c8e065f2e", "ground_truth": {"modern_name": "Lentil", "confidence": "medium", "type": "plant", "linnaean": "Lens culinaris", "family": "Fabaceae", "description": "A herbaceous annual legume plant grown for its edible seed.", "note": "Includes related terms for aquatic plants and similar-leafed plants, suggesting broader botanical interest.", "wikipedia_extract": "The lentil (Vicia lens or Lens culinaris) is an annual legume grown for its lens-shaped edible seeds or pulses, also called lentils. It is about 40 cm (16 in) tall, and the seeds grow in pods, usually with two seeds in each. Lentil seeds are used around the world for culinary purposes, most commonly in stews or soups. In cuisines of the Indian subcontinent, where lentils are a staple, split lentils (often with their hulls removed) known as dal are often cooked into a thick curry that is usually eaten with rice or roti. The English word \"lentil\" ultimately derives from the Latin lens ('lentil'). The Latin word is of classical Roman or Latin origin and may be the source of the prominent Roman family name Lentulus, just as the family name \"Cicero\" was derived from the chickpea, Cicer arietinum, and \"Fabia\" (as in Quintus Fabius Maximus) from the fava bean (Vicia faba)."}}, {"canonical_name": "hypocistide", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "hypocistide", "book_id": "ricettario_fiorentino_1597", "name": "hypocistide", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["hypocistide", "Hipocifti", "Hy pociftide", "Hypocifti", "Hypocistide", "Hypocìftide", "hypociftide"], "contexts": ["substance discussed", "plant for pounding with liquid"]}, {"entity_id": "hypocistis", "book_id": "english_physician_1652", "name": "Hypocistis", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Hypocistis"], "contexts": ["used for binding effect"]}, {"entity_id": "hypociftidis", "book_id": "polyanthea_medicinal", "name": "hypociftidis", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["hypociftidis"], "contexts": ["ingredient in an emplaster"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "hypocistide", "target_book": "english_physician_1652", "target_name": "Hypocistis", "similarity": 0.889}, {"source_book": "ricettario_fiorentino_1597", "source_name": "hypocistide", "target_book": "polyanthea_medicinal", "target_name": "hypociftidis", "similarity": 0.853}, {"source_book": "english_physician_1652", "source_name": "Hypocistis", "target_book": "polyanthea_medicinal", "target_name": "hypociftidis", "similarity": 0.877}], "id": 361, "stable_key": "clu_d1068a1b9b187cfa", "ground_truth": {"modern_name": "Hypocistis", "confidence": "high", "type": "plant", "linnaean": "Cistanche phelypaea", "family": "Orobanchaceae", "description": "Parasitic plant extract used for binding and in medicinal preparations.", "wikipedia_extract": "Cistanche phelypaea, also spelled Cistanche phelipaea, is a species of plant in the family Orobanchaceae. It has a wide range of distribution from the Arabian Peninsula and the Syrian Desert in the east, through the Sahara, Cyprus, Crete and the southwest of the Iberian Peninsula, to Macaronesia in the west. Cistanche phelypaea is a chlorophyll-free, obligate parasitic plant with stout fleshy flowering stems bearing bright yellow flowers and rising to 20–50 cm (7.9–19.7 in) tall from a generally swollen base. The stem is glabrous and yellow to purple gray. Leaves are ovate-lanceolate, obtuse, glabrous and normally brown in color. Inflorescence is dense, more or less cylindrical."}}, {"canonical_name": "mastodontes", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "mastodontes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "mastodontes", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["Mastodontes", "mastodontes"], "contexts": ["bones of Mastodontes", "extinct mammal bones found"]}, {"entity_id": "mastodon", "book_id": "origin_of_species_darwin_1859", "name": "Mastodon", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["Mastodon"], "contexts": ["extinct mammal species", "extinct elephant-like mammal"]}, {"entity_id": "mastodons", "book_id": "origin_of_species_darwin_1859", "name": "mastodons", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["mastodons"], "contexts": ["extinct elephant-like mammals", "extinct mammal name"]}, {"entity_id": "mastodon", "book_id": "kosmos_humboldt_1845", "name": "mastodon", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["mastodon", "Mastodon"], "contexts": ["extinct mammal genus", "extinct prehistoric mammal"]}, {"entity_id": "mastodons", "book_id": "kosmos_humboldt_1845", "name": "mastodons", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["mastodons"], "contexts": ["extinct elephant-like mammal"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mastodontes", "target_book": "origin_of_species_darwin_1859", "target_name": "Mastodon", "similarity": 0.853}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mastodontes", "target_book": "origin_of_species_darwin_1859", "target_name": "mastodons", "similarity": 0.96}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mastodontes", "target_book": "kosmos_humboldt_1845", "target_name": "mastodon", "similarity": 0.943}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mastodontes", "target_book": "kosmos_humboldt_1845", "target_name": "mastodons", "similarity": 0.96}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Mastodon", "target_book": "kosmos_humboldt_1845", "target_name": "mastodon", "similarity": 0.902}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Mastodon", "target_book": "kosmos_humboldt_1845", "target_name": "mastodons", "similarity": 0.888}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mastodons", "target_book": "kosmos_humboldt_1845", "target_name": "mastodon", "similarity": 0.978}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mastodons", "target_book": "kosmos_humboldt_1845", "target_name": "mastodons", "similarity": 1.0}], "id": 362, "stable_key": "clu_e7dab61e3503cda8", "ground_truth": {"modern_name": "Mastodon", "confidence": "high", "type": "animal", "linnaean": "Mammut americanum", "family": "Mammutidae", "description": "An extinct genus of elephant-like mammals.", "wikipedia_extract": "A mastodon (from Ancient Greek  μαστός (mastós) 'breast' and  ὀδούς (odoús) 'tooth') is a member of the genus Mammut (German for 'mammoth'), which was endemic to North America and lived from the late Miocene to the early Holocene. Mastodons belong to the order Proboscidea, the same order as elephants and mammoths (which belong to the family Elephantidae). Mammut is the type genus of the extinct family Mammutidae, which diverged from the ancestors of modern elephants at least 28 million years ago, during the Oligocene. Like other members of Mammutidae, the molar teeth of mastodons have zygodont morphology (where parallel pairs of cusps are merged into sharp ridges), which strongly differ from those of elephantids. In comparison to its likely ancestor Zygolophodon, Mammut is characterized by particularly long and upward curving upper tusks, reduced or absent tusks on the lower jaw, as well as the shortening of the mandibular symphysis (the frontmost part of the lower jaw), the latter two traits also having evolved in parallel separately in elephantids. Mastodons had an overall stockier skeletal build, a lower-domed skull, and a longer tail compared to elephantids."}}, {"canonical_name": "Philadelphie", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "philadelphie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Philadelphie", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Philadelphie"], "contexts": ["city where a voyage was published", "city where a voyage appeared"]}, {"entity_id": "philadelphia", "book_id": "principles_of_psychology_james_1890", "name": "Philadelphia", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Philadelphia"], "contexts": ["city where Dr. Shoemaker is from", "city visited by 'Brown'"]}, {"entity_id": "philadelphia", "book_id": "kosmos_humboldt_1845", "name": "Philadelphia", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Philadelphia"], "contexts": ["latitude where Aurora is frequent"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Philadelphie", "target_book": "principles_of_psychology_james_1890", "target_name": "Philadelphia", "similarity": 0.931}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Philadelphie", "target_book": "kosmos_humboldt_1845", "target_name": "Philadelphia", "similarity": 0.931}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Philadelphia", "target_book": "kosmos_humboldt_1845", "target_name": "Philadelphia", "similarity": 1.0}], "id": 363, "stable_key": "clu_97f32d7ee1e02f9e", "ground_truth": {"modern_name": "Philadelphia", "confidence": "high", "type": "place", "description": "A major city in Pennsylvania, USA.", "wikipedia_extract": "Philadelphia (  FIL-ə-DEL-fee-ə), colloquially referred to as Philly, is the most populous city in the U.S. state of Pennsylvania. It is the sixth-most populous city in the United States with a population of 1.6 million at the 2020 census, while the Philadelphia metropolitan area (sometimes called the Delaware Valley) with 6.33 million residents is the nation's ninth-largest metropolitan area. Philadelphia is known for its culture, cuisine, and history, maintaining contemporary influence in business and technology, sports, and music. Philadelphia was founded in 1682 by William Penn, an English Quaker and advocate of religious freedom, and served as the capital of the colonial era Province of Pennsylvania. It then played a vital role during the American Revolution and Revolutionary War. It served as the central meeting place for the nation's Founding Fathers in hosting the First Continental Congress (1774) and the Second Continental Congress, during which the Founders formed the Continental Army, elected George Washington as its commander, and adopted the Declaration of Independence on July 4, 1776."}}, {"canonical_name": "Saint-Thomas", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "saint-thomas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Saint-Thomas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Saint-Thomas"], "contexts": ["Barbade, Martinique and Saint-Thomas", "island name"]}, {"entity_id": "l'île_saint-thomas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "l'île Saint-Thomas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["l'île Saint-Thomas"], "contexts": ["island near magnetic equator"]}, {"entity_id": "île_saint-thomas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "île Saint-Thomas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["île Saint-Thomas"], "contexts": ["island in Gulf of Guinea"]}, {"entity_id": "st__thomas", "book_id": "kosmos_humboldt_1845", "name": "St. Thomas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["St. Thomas"], "contexts": ["island near a magnetic equator node", "island on the western coast of Africa"]}, {"entity_id": "st__thomas", "book_id": "connexion_physical_sciences_somerville_1858", "name": "St. Thomas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["St. Thomas"], "contexts": ["island experiencing hurricanes"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saint-Thomas", "target_book": "kosmos_humboldt_1845", "target_name": "St. Thomas", "similarity": 0.973}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saint-Thomas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "St. Thomas", "similarity": 0.973}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "l'île Saint-Thomas", "target_book": "kosmos_humboldt_1845", "target_name": "St. Thomas", "similarity": 0.9}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "l'île Saint-Thomas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "St. Thomas", "similarity": 0.9}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "île Saint-Thomas", "target_book": "kosmos_humboldt_1845", "target_name": "St. Thomas", "similarity": 0.886}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "île Saint-Thomas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "St. Thomas", "similarity": 0.886}, {"source_book": "kosmos_humboldt_1845", "source_name": "St. Thomas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "St. Thomas", "similarity": 1.0}], "id": 364, "stable_key": "clu_eb4584dafa02ea9a", "ground_truth": {"modern_name": "Saint Thomas", "confidence": "high", "type": "place", "country": "United States Virgin Islands", "note": "Multiple references to 'Saint-Thomas' and 'St. Thomas' as an island, particularly in the context of Humboldt's works and its location near the magnetic equator, strongly indicate the Caribbean island.", "wikidata_id": "Q20851010", "wikidata_description": "census district of the United States Virgin Islands, includes the Island of Saint Thomas", "wikipedia_extract": "Thomas the Apostle also known as Didymus (Greek: Δίδυμος, romanized: Dídymos 'twin'), was one of the Twelve Apostles of Jesus according to the New Testament. Thomas is commonly known as \"doubting Thomas\" because he initially doubted the resurrection of Jesus when he was told of it (as is related in the Gospel of John); he later confessed his faith (\"The lord of me and the God of me\") on seeing the places where the wounds appeared still fresh on the holy body of Jesus after the Crucifixion of Jesus. According to traditional accounts of the Saint Thomas Christians of Kerala, Thomas travelled outside the Roman Empire to preach the Gospel, travelling through southern India in the modern states of Kerala and Tamil Nadu, and eventually reached Muziris (modern-day North Paravur and Kodungalloor) in 52 AD. He started the Church of the East in the region around the Van Province, Edessa, and Hakkari regions of Upper Mesopotamia (modern-day southeastern Turkey), presumably sometime between mid-late 30s and 45, and spent many years evangelizing both Jews and non-christians in the area before heading further east in the late 40s. In 1258, some of the relics were brought to Ortona, in Abruzzo, Italy, where they have been held in the Church of Saint Thomas the Apostle. He is regarded as the patron saint of India among its Christian adherents, and the Feast of Saint Thomas on July 3 is celebrated as Indian Christians' Day.", "wikipedia_url": "https://en.wikipedia.org/wiki/Thomas_the_Apostle"}}, {"canonical_name": "Freiberg", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "freiberg", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Freiberg", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Freiberg"], "contexts": ["location of mines", "city known for mining"]}, {"entity_id": "freiberg", "book_id": "kosmos_humboldt_1845", "name": "Freiberg", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Freiberg"], "contexts": ["latitude for centrifugal force calculation", "location of mines with magnetic disturbance"]}, {"entity_id": "freyburg", "book_id": "kosmos_humboldt_1845", "name": "Freyburg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Freyburg"], "contexts": ["location of mining school"]}, {"entity_id": "freyberg", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Freyberg", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Freyberg"], "contexts": ["location of Professor Reich", "location of mines with green plants"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Freiberg", "target_book": "kosmos_humboldt_1845", "target_name": "Freiberg", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Freiberg", "target_book": "kosmos_humboldt_1845", "target_name": "Freyburg", "similarity": 0.884}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Freiberg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Freyberg", "similarity": 0.884}, {"source_book": "kosmos_humboldt_1845", "source_name": "Freiberg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Freyberg", "similarity": 0.884}, {"source_book": "kosmos_humboldt_1845", "source_name": "Freyburg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Freyberg", "similarity": 0.963}], "id": 365, "stable_key": "clu_208cb6ad1fb9622e", "ground_truth": {"modern_name": "Freiberg", "confidence": "high", "type": "place", "country": "Germany", "note": "References to mines, mining schools, and latitude calculations in the context of physical sciences point to Freiberg, a city historically known for its mining and mineralogical significance.", "wikidata_id": "Q36956323", "wikidata_description": "family name", "wikipedia_extract": "Freiberg ist ein deutscher Familienname. Freiberg ist ein Herkunftsname für diejenigen, die aus einem Ort namens Freiberg oder Freyberg stammen. Freibergs, Freyberg, Freiberger, Freyberger Björn Freiberg (* 1970), deutscher Schauspieler Daniel Freiberg (* 1957), US-amerikanischer Jazzmusiker Dietrich von Freiberg (um 1240–1310), Philosoph, Mystiker, Dominikaner und Theologe Dov Freiberg (1927–2008), polnisch-israelischer Holocaustüberlebender und Buchautor Gottfried von Freiberg (1908–1962), österreichischer Hornist Hedwig Freiberg (1872–1945), deutsche Malerin und Schauspielerin, Ehefrau von Robert Koch Heinrich von Freiberg (13. Jh.), Dichter und Minnesänger Henning Freiberg (* 1937), deutscher Kunstpädagoge und Hochschullehrer im Ruhestand Kjell-Børge Freiberg (* 1971), norwegischer Politiker Konrad Freiberg (* 1951), deutscher Polizist und Gewerkschaftsvorsitzender Lorenz III. von Freiberg (vor 1459–1487), Bischof von Gurk Ludwig von Freiberg (1442–vor 1480), Bischof von Konstanz Marcos A. Freiberg (1911–1990), argentinischer Zoologe Margit Freiberg (* 1962), deutsche Tischtennisspielerin Michael Freiberg (Politiker) (* 1956), deutscher Politiker (CDU) Michael Freiberg (Radsportler) (* 1990), australischer Radrennfahrer Mona Freiberg (* 1950), deutsche Volksschauspielerin und Sängerin Peter Freiberg (* 1954), deutscher Drehbuchautor, Radiomoderator und Sänger Siegfried Freiberg (1901–1985), österreichischer Schriftsteller und Bibliothekar Steffen Freiberg (* 1981), deutscher Politiker Walter Freiberg (* 1922), deutscher Oberst im Ministerium für Staatssicherheit (MfS) der DDR Freiberg.", "wikipedia_url": "https://de.wikipedia.org/wiki/Freiberg_%28Familienname%29"}}, {"canonical_name": "Mysore", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "mysore", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mysore", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Mysore", "Mysoïle"], "contexts": ["location with barometric heights", "location of Kater's observations"]}, {"entity_id": "plateau_du_mysore", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Plateau du Mysore", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Plateau du Mysore"], "contexts": ["plateau in India"]}, {"entity_id": "mysore", "book_id": "kosmos_humboldt_1845", "name": "Mysore", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Mysore"], "contexts": ["location with granite masses"]}, {"entity_id": "mysore", "book_id": "coloquios_da_orta_1563", "name": "Mysore", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Mysore"], "contexts": ["region where cardamom is found", "region in India"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mysore", "target_book": "kosmos_humboldt_1845", "target_name": "Mysore", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mysore", "target_book": "coloquios_da_orta_1563", "target_name": "Mysore", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Plateau du Mysore", "target_book": "kosmos_humboldt_1845", "target_name": "Mysore", "similarity": 0.851}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Plateau du Mysore", "target_book": "coloquios_da_orta_1563", "target_name": "Mysore", "similarity": 0.851}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mysore", "target_book": "coloquios_da_orta_1563", "target_name": "Mysore", "similarity": 1.0}], "id": 366, "stable_key": "clu_1b12950d3b6efcbc", "ground_truth": {"modern_name": "Mysore", "confidence": "high", "type": "place", "description": "A historical region and city in Karnataka, India.", "wikipedia_extract": "Mysore (  my-SOR), officially Mysuru (Kannada: [ˈmaɪˈsuːɾu] ), is a city in the southern Indian state of Karnataka. It is the headquarters of Mysore district and Mysore division. As the traditional seat of the Wadiyar dynasty, the city functioned as the capital of the Kingdom of Mysore for almost six centuries (1399 to 1947). Known for its heritage structures, palaces (such as the famous Mysore Palace), and its culture, Mysore has been called the \"City of Palaces\", the \"Heritage City\", and the \"Cultural capital of Karnataka\". It is the second-most populous city in the state and one of the cleanest cities in India according to the Swachh Survekshan. Mysore is situated at the foothills of the Chamundi Hills."}}, {"canonical_name": "Oby", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "oby", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Oby", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Oby", "Obi"], "contexts": ["river", "river banks for comparison"]}, {"entity_id": "oby", "book_id": "kosmos_humboldt_1845", "name": "Oby", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Oby"], "contexts": ["river in Northern Asia", "river where Barnaul is located"]}, {"entity_id": "obi", "book_id": "kosmos_humboldt_1845", "name": "Obi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Obi"], "contexts": ["river districts", "geographic location"]}, {"entity_id": "obidos", "book_id": "polyanthea_medicinal", "name": "Obidos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Obidos"], "contexts": ["family name associated with late heirs"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oby", "target_book": "kosmos_humboldt_1845", "target_name": "Oby", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oby", "target_book": "kosmos_humboldt_1845", "target_name": "Obi", "similarity": 0.885}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oby", "target_book": "polyanthea_medicinal", "target_name": "Obidos", "similarity": 0.844}, {"source_book": "kosmos_humboldt_1845", "source_name": "Oby", "target_book": "polyanthea_medicinal", "target_name": "Obidos", "similarity": 0.844}], "id": 367, "stable_key": "clu_ec2578e85fea690a", "ground_truth": {"modern_name": "Obidos", "confidence": "medium", "type": "place", "description": "A town in Portugal, also associated with a river or coastal area.", "note": "The context of 'Oby' as a river and 'Obidos' being a Portuguese town with coastal access makes this plausible.", "wikipedia_extract": "Óbidos (Portuguese pronunciation: [ˈɔβiðuʃ] ; Proto-Celtic: *Eburobrittium) is a town  and a municipality in the Oeste region, historical province of Estremadura and the Leiria district. The town proper has approximately 3,100 inhabitants. The municipality population in 2011 was 11,772 covering an area of 141.55 square kilometres (54.65 square miles). The name \"Óbidos\" is a Latinised (oppidum, citadel) derivation of the older Celtic \"Eburobricio\". The municipality grew from a Roman settlement near the foothills of an elevated escarpment. The region of Óbidos, extending from the Atlantic to the interior of Estremadura Province along the rivers and lakes has been inhabited since the late Paleolithic."}}, {"canonical_name": "miles", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "miles", "book_id": "connexion_physical_sciences_somerville_1858", "name": "miles", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 7, "variants": ["miles"], "contexts": ["unit of distance measurement"]}, {"entity_id": "milles", "book_id": "relation_historique_humboldt_vol3_1825", "name": "milles", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["milles"], "contexts": ["unit of length measurement", "unit of measurement"]}, {"entity_id": "millimeter", "book_id": "kosmos_humboldt_1845", "name": "millimeter", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["millimeter"], "contexts": ["unit of length"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "miles", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "milles", "similarity": 0.953}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "miles", "target_book": "kosmos_humboldt_1845", "target_name": "millimeter", "similarity": 0.842}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "milles", "target_book": "kosmos_humboldt_1845", "target_name": "millimeter", "similarity": 0.87}], "id": 368, "stable_key": "clu_0552f5f0eb718d3e", "ground_truth": {"modern_name": "mile", "confidence": "high", "type": "object", "note": "The context of 'miles', 'milles', and 'millimeter' suggests units of distance measurement. 'Miles' is the most common and broadest term, encompassing the others.", "wikidata_id": "Q253276", "wikidata_description": "unit of length (on ground)", "wikipedia_url": "https://en.wikipedia.org/wiki/Mile", "wikipedia_extract": "The mile, sometimes the international mile or statute mile to distinguish it from other miles, is a British imperial unit and United States customary unit of length; both are based on the older English unit of length equal to 5,280 English feet, or 1,760 yards. The statute mile was standardised as a unit of length between the Commonwealth of Nations and the United States by an international agreement in 1959, when the yard was formally redefined with respect to SI units as 0.9144 metres, making the mile exactly 1609.344 metres (1.609344 kilometres). For everyday use, five miles equates roughly to eight kilometres. Mileage is the term used informally for a distance expressed in miles. With qualifiers, mile is also used to describe or translate a wide range of units derived from or roughly equivalent to the Roman mile (roughly 1.48 km), such as the nautical mile (now 1.852 km exactly), the Italian mile (roughly 1.852 km), and the Chinese mile (now 500 m exactly). The Romans divided their mile into 5,000 pedes (lit. 'feet'), but the greater importance of furlongs in the Elizabethan-era England meant that the statute mile was made equivalent to 8 furlongs or 5,280 feet in 1593."}}, {"canonical_name": "Çocotora", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "çocotora", "book_id": "coloquios_da_orta_1563", "name": "Çocotora", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["Çocotora", "Socotora"], "contexts": ["island known for superior aloés", "place with best quality substance"]}, {"entity_id": "socotora", "book_id": "kosmos_humboldt_1845", "name": "Socotora", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Socotora"], "contexts": ["island west of where equator enters Africa"]}, {"entity_id": "socotora", "book_id": "ricettario_fiorentino_1597", "name": "Socotora", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Socotora"], "contexts": ["island producing excellent aloe"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Çocotora", "target_book": "kosmos_humboldt_1845", "target_name": "Socotora", "similarity": 0.884}, {"source_book": "coloquios_da_orta_1563", "source_name": "Çocotora", "target_book": "ricettario_fiorentino_1597", "target_name": "Socotora", "similarity": 0.884}, {"source_book": "kosmos_humboldt_1845", "source_name": "Socotora", "target_book": "ricettario_fiorentino_1597", "target_name": "Socotora", "similarity": 1.0}], "id": 369, "stable_key": "clu_8ae2698f2221e430", "ground_truth": {"modern_name": "Socotra", "confidence": "high", "type": "place", "description": "Yemeni island in the Arabian Sea, known for its unique flora and medicinal aloes.", "wikipedia_extract": "Socotra, locally known as Saqatri, is a Yemeni island in the Indian Ocean. It is situated between the Gulf of Aden, the Guardafui Channel and the Arabian Sea, and lies near major shipping routes. The largest of the six islands in the Socotra archipelago, it comprises around 95% of the landmass of the archipelago. It lies 380 kilometres (205 nautical miles) south of the Arabian Peninsula and 232 km (125 nmi) east of the Horn of Africa. The inhabitants of the island are called Socotrans, and they speak Arabic and Soqotri. Socotra is home to a high number of unique species that are endemic."}}, {"canonical_name": "miolo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "miolo", "book_id": "polyanthea_medicinal", "name": "miolo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["miolo"], "contexts": ["brain substance", "inner part of bread"]}, {"entity_id": "meolo", "book_id": "coloquios_da_orta_1563", "name": "meolo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["meolo"], "contexts": ["spinal cord"]}, {"entity_id": "midolle", "book_id": "ricettario_fiorentino_1597", "name": "midolle", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["midolle"], "contexts": ["substance from bones", "marrow from animals"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "miolo", "target_book": "coloquios_da_orta_1563", "target_name": "meolo", "similarity": 0.88}, {"source_book": "polyanthea_medicinal", "source_name": "miolo", "target_book": "ricettario_fiorentino_1597", "target_name": "midolle", "similarity": 0.843}, {"source_book": "coloquios_da_orta_1563", "source_name": "meolo", "target_book": "ricettario_fiorentino_1597", "target_name": "midolle", "similarity": 0.845}], "id": 370, "stable_key": "clu_52898453b94da7e8", "ground_truth": {"modern_name": "Marrow", "confidence": "high", "type": "substance", "description": "Soft, fatty tissue found inside bones and in the brain.", "note": "Includes brain and spinal cord substance.", "wikipedia_extract": "Forensic toxicology is a multidisciplinary field that combines the principles of toxicology with expertise in disciplines such as analytical chemistry, pharmacology and clinical chemistry to aid medical or legal investigation of death, poisoning, and drug use. The paramount focus for forensic toxicology is not the legal implications of the toxicological investigation or the methodologies employed, but rather the acquisition and accurate interpretation of results. Toxicological analyses can encompass a wide array of samples. In the course of an investigation, a forensic toxicologist must consider the context of an investigation, in particular any physical symptoms recorded, and any evidence collected at a crime scene that may narrow the search, such as pill bottles, powders, trace residue, and any available chemicals. Armed with this contextual information and samples to examine, the forensic toxicologist is tasked with identifying the specific toxic substances present, quantifying their concentrations, and assessing their likely impact on the individual involved. In the United States, forensic toxicology compromises three distinct disciplines: Postmortem toxicology, Human Performance toxicology, and Forensic Drug Testing (FDT)."}}, {"canonical_name": "Brionia", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "brionia", "book_id": "ricettario_fiorentino_1597", "name": "Brionia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Brionia", "brionia"], "contexts": ["root collected and dried", "herb mentioned in the passage"]}, {"entity_id": "briony", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Briony", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Briony"], "contexts": ["plant species", "plant with monstrous root"]}, {"entity_id": "briony", "book_id": "english_physician_1652", "name": "Briony", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Briony"], "contexts": ["plant with medicinal properties", "plant with roots used for medicinal purposes"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Brionia", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Briony", "similarity": 0.963}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Brionia", "target_book": "english_physician_1652", "target_name": "Briony", "similarity": 0.875}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Briony", "target_book": "english_physician_1652", "target_name": "Briony", "similarity": 0.918}], "id": 371, "stable_key": "clu_3e3a4a096d8be664", "ground_truth": {"modern_name": "Bryony", "confidence": "high", "type": "plant", "family": "Cucurbitaceae", "description": "A climbing plant with lobed leaves and often medicinal roots.", "note": "Refers to plants in the genus Bryonia.", "wikipedia_extract": "Bryonia is a genus of flowering plants in the gourd family. Bryony  is its best-known common name. They are native to western Eurasia and adjacent regions, such as North Africa, the Canary Islands and South Asia. Bryonies are perennial, tendril-climbing, diclinous or dioecious herbs with palmately lobed leaves and flowers in axillary clusters. The fruit is a smooth, globular berry. Bryonia is used as a food plant by the larvae of some Lepidoptera (butterflies and moths), including the tortrix moth Phtheochroa rugosana (recorded on red bryony, B. dioica) and the cabbage moth (Mamestra brassicae)."}}, {"canonical_name": "Yorkshire", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "yorkshire", "book_id": "english_physician_1652", "name": "Yorkshire", "category": "PLACE", "subcategory": "REGION", "count": 6, "variants": ["yorkshire", "Yorkshire"], "contexts": ["county where Red Bilberry grows", "region in the North parts of this Land"]}, {"entity_id": "yorkshire", "book_id": "origin_of_species_darwin_1859", "name": "Yorkshire", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Yorkshire"], "contexts": ["district known for sheep farming", "English county"]}, {"entity_id": "yorkshire", "book_id": "first_principles_spencer_1862", "name": "Yorkshire", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Yorkshire"], "contexts": ["cloth-districts"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Yorkshire", "target_book": "origin_of_species_darwin_1859", "target_name": "Yorkshire", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Yorkshire", "target_book": "first_principles_spencer_1862", "target_name": "Yorkshire", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Yorkshire", "target_book": "first_principles_spencer_1862", "target_name": "Yorkshire", "similarity": 1.0}], "id": 372, "stable_key": "clu_27e54ae73df0598c", "ground_truth": {"modern_name": "Yorkshire", "confidence": "high", "type": "place", "description": "A historic county in Northern England.", "wikipedia_extract": "Yorkshire ( YORK-shər, -⁠sheer) is an area of Northern England which was historically a county. Despite no longer being used for administration, Yorkshire retains a strong regional identity. The county was named after the city of York. The south-west of Yorkshire includes the cities of Leeds, Sheffield, Bradford, Doncaster and Wakefield. The north and east of the county includes the southern part of the Teesside conurbation; the port city of Hull is located in the south-east. York is positioned near the centre of the county."}}, {"canonical_name": "Jerusalém", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "jerusalém", "book_id": "coloquios_da_orta_1563", "name": "Jerusalém", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Jerusalém"], "contexts": ["city of origin for apothecary", "city where musay are found"]}, {"entity_id": "jerusalem", "book_id": "english_physician_1652", "name": "Jerusalem", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Jerusalem"], "contexts": ["Temple where writings were kept"]}, {"entity_id": "jerusalem", "book_id": "kosmos_humboldt_1845", "name": "Jerusalem", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Jerusalem"], "contexts": ["location of a king", "city in the Middle East"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Jerusalém", "target_book": "english_physician_1652", "target_name": "Jerusalem", "similarity": 0.978}, {"source_book": "coloquios_da_orta_1563", "source_name": "Jerusalém", "target_book": "kosmos_humboldt_1845", "target_name": "Jerusalem", "similarity": 0.978}, {"source_book": "english_physician_1652", "source_name": "Jerusalem", "target_book": "kosmos_humboldt_1845", "target_name": "Jerusalem", "similarity": 1.0}], "id": 373, "stable_key": "clu_3deaafe3e45de5e4", "ground_truth": {"modern_name": "Jerusalem", "confidence": "high", "type": "place", "description": "Ancient and holy city, significant in religious and historical contexts.", "wikipedia_extract": "Jerusalem is a city in the Southern Levant, on a plateau in the Judaean Mountains between the Mediterranean and the Dead Sea. It is one of the oldest cities in the world and is considered holy to the three major Abrahamic religions—Judaism, Christianity and Islam. Both Israel and Palestine claim Jerusalem as their capital city; Israel maintains its primary governmental institutions there, while Palestine ultimately foresees it as its seat of power. Neither claim is widely recognised internationally. Throughout its long history, Jerusalem has been destroyed at least twice, besieged 23 times, captured and recaptured 44 times, and attacked 52 times. The part of Jerusalem called the City of David shows first signs of settlement in the 4th millennium BCE, in the shape of encampments of nomadic shepherds."}}, {"canonical_name": "Discolourings", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "discolourings", "book_id": "english_physician_1652", "name": "Discolourings", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 7, "variants": ["Discolourings", "discolorings", "discolourings", "discolourings of the Skin"], "contexts": ["skin imperfections removed by juice", "skin discoloration"]}, {"entity_id": "descoloridos", "book_id": "historia_medicinal_monardes_1574", "name": "descoloridos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["descoloridos"], "contexts": ["pale appearance"]}, {"entity_id": "discoloratio-", "book_id": "polyanthea_medicinal", "name": "Discoloratio-", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Discoloratio-"], "contexts": ["skin discoloration"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Discolourings", "target_book": "historia_medicinal_monardes_1574", "target_name": "descoloridos", "similarity": 0.939}, {"source_book": "english_physician_1652", "source_name": "Discolourings", "target_book": "polyanthea_medicinal", "target_name": "Discoloratio-", "similarity": 0.932}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "descoloridos", "target_book": "polyanthea_medicinal", "target_name": "Discoloratio-", "similarity": 0.925}], "id": 374, "stable_key": "clu_7ebb7ff79a4cf9ab", "ground_truth": {"modern_name": "Discoloration", "confidence": "high", "type": "disease", "description": "Abnormal changes in the color of the skin or other tissues.", "note": "Refers to pale or otherwise altered skin tones.", "wikipedia_extract": "Jaundice, also known as icterus, is a yellowish or, less frequently, greenish pigmentation of the skin and sclera due to high bilirubin levels. Jaundice in adults typically indicates the presence of underlying diseases involving abnormal heme metabolism, liver dysfunction, or biliary-tract obstruction. The prevalence of jaundice in adults is rare, while jaundice in babies is common, with an estimated 80% affected during their first week of life. The most commonly associated symptoms of jaundice are itchiness, pale feces, and dark urine. Normal levels of bilirubin in blood are below 1.0 mg/dl (17 μmol/L), while levels over 2–3 mg/dl (34–51 μmol/L) typically result in jaundice. High blood bilirubin is divided into two types: unconjugated and conjugated bilirubin."}}, {"canonical_name": "bagno Maria", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "bagno_maria", "book_id": "ricettario_fiorentino_1597", "name": "bagno Maria", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 6, "variants": ["bagno Maria", "bagno Marie"], "contexts": ["water bath heating method", "Bain-marie, a double boiler for gentle heating"]}, {"entity_id": "balneo_mariae", "book_id": "english_physician_1652", "name": "Balneo Mariae", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["Balneo Mariae"], "contexts": ["apparatus for distillation", "water bath for distillation"]}, {"entity_id": "banho_chamado_de_maria", "book_id": "polyanthea_medicinal", "name": "banho chamado de Maria", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["banho chamado de Maria"], "contexts": ["method for extracting tincture"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "bagno Maria", "target_book": "english_physician_1652", "target_name": "Balneo Mariae", "similarity": 0.917}, {"source_book": "ricettario_fiorentino_1597", "source_name": "bagno Maria", "target_book": "polyanthea_medicinal", "target_name": "banho chamado de Maria", "similarity": 0.887}], "id": 375, "stable_key": "clu_efd6efc02fac5ab3", "ground_truth": {"modern_name": "Bain-marie", "confidence": "high", "type": "object", "description": "Double boiler used for gentle heating of substances.", "note": "Also known as a water bath.", "wikipedia_extract": "A bain-marie (English:  BAN-mə-REE, French: [bɛ̃ maʁi]), also known as a water bath or double boiler, a type of heated bath, is a piece of equipment used in science, industry, and cooking to heat materials gently or to keep materials warm over a period of time. A bain-marie is also used to melt ingredients for cooking. The name comes from the French bain de Marie or bain-marie, in turn derived from the medieval Latin balneum Mariae, all meaning 'Mary's bath'. In his books, the 300 AD alchemist Zosimos of Panopolis credits for the invention of the device Mary the Jewess, an ancient alchemist. However, the water bath was known many centuries earlier (Hippocrates and Theophrastus), and the balneum Mariae attributed to Mary the Jewess was used to heat its contents above 100 °C, while the bain-marie that continues to be used today only heats its contents up to a gentle heat of less than 100 °C. The double boiler comes in a wide variety of shapes, sizes, and types, but traditionally is a wide, cylindrical, usually metal container made of three or four basic parts:  a handle, an outer (or lower) container that holds the working fluid, an inner (or upper), smaller container that fits inside the outer one and which holds the material to be heated or cooked, and sometimes a base underneath."}}, {"canonical_name": "Trilobites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "trilobites", "book_id": "origin_of_species_darwin_1859", "name": "Trilobites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["trilobites", "Trilobites"], "contexts": ["ancient marine arthropods found in fossils", "extinct group of arthropods"]}, {"entity_id": "trilobites", "book_id": "relation_historique_humboldt_vol3_1825", "name": "trilobites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["trilobites"], "contexts": ["fossil organism, first traces of organization", "fossil arthropod group"]}, {"entity_id": "trilobites", "book_id": "kosmos_humboldt_1845", "name": "Trilobites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["Trilobites", "trilobites"], "contexts": ["fossil arthropod group", "fossil arthropods"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Trilobites", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "trilobites", "similarity": 0.986}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Trilobites", "target_book": "kosmos_humboldt_1845", "target_name": "Trilobites", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "trilobites", "target_book": "kosmos_humboldt_1845", "target_name": "Trilobites", "similarity": 0.986}], "id": 376, "stable_key": "clu_83a5381cb8df5de2", "ground_truth": {"modern_name": "Trilobites", "confidence": "high", "type": "animal", "description": "Extinct marine arthropods with a three-lobed body.", "note": "These are well-known fossil organisms.", "wikipedia_extract": "Trilobites (; meaning \"three-lobed entities\") are extinct marine arthropods that form the class Trilobita. One of the earliest groups of arthropods to appear in the fossil record, trilobites were among the most successful of all early animals, existing in oceans for almost 270 million years, with over 22,000 species having been described. Because trilobites had wide diversity and an easily fossilized mineralised exoskeleton made of calcite, they left an extensive fossil record. The study of their fossils has facilitated important contributions to biostratigraphy, paleontology, evolutionary biology, and plate tectonics. Trilobites are placed within the clade Artiopoda, which includes many organisms that are morphologically similar to trilobites, but are largely unmineralised. The relationship of Artiopoda to other arthropods is uncertain."}}, {"canonical_name": "Hongrie", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "hongrie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Hongrie", "category": "PLACE", "subcategory": "COUNTRY", "count": 5, "variants": ["Hongrie"], "contexts": ["location of travel", "country in Central Europe"]}, {"entity_id": "hungary", "book_id": "origin_of_species_darwin_1859", "name": "Hungary", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Hungary"], "contexts": ["European country"]}, {"entity_id": "hungary", "book_id": "kosmos_humboldt_1845", "name": "Hungary", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Hungary"], "contexts": ["country with extinct volcanic action", "European country with volcanic action evidence"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hongrie", "target_book": "origin_of_species_darwin_1859", "target_name": "Hungary", "similarity": 0.941}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hongrie", "target_book": "kosmos_humboldt_1845", "target_name": "Hungary", "similarity": 0.941}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Hungary", "target_book": "kosmos_humboldt_1845", "target_name": "Hungary", "similarity": 1.0}], "id": 377, "stable_key": "clu_9a622eaff85a807d", "ground_truth": {"modern_name": "Hungary", "confidence": "high", "type": "place", "description": "A country located in Central Europe, historically significant for travel.", "wikipedia_extract": "Hungary is a landlocked country in Central Europe. Spanning much of the Carpathian Basin, it is bordered by Slovakia to the north, Ukraine to the northeast, Romania to the east and southeast, Serbia to the south, Croatia and Slovenia to the southwest, and Austria to the west. Hungary lies within the drainage basin of the Danube River and is dominated by great lowland plains. It has a population of 9.6 million, consisting mostly of ethnic Hungarians (Magyars) and a significant Romani minority. Hungarian is the official language, and among the few in Europe outside the Indo-European family. Budapest is the country's capital and largest city, and the dominant cultural and economic centre."}}, {"canonical_name": "Bordeaux", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "bordeaux", "book_id": "kosmos_humboldt_1845", "name": "Bordeaux", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Bordeaux"], "contexts": ["city in France", "location of Biot's pendulum observations"]}, {"entity_id": "bordeaux", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bordeaux", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Bordeaux"], "contexts": ["city in France", "city between 30° and 45° latitude"]}, {"entity_id": "bordeaux", "book_id": "principles_of_psychology_james_1890", "name": "Bordeaux", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bordeaux"], "contexts": ["city where Dr. Azam practiced"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Bordeaux", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Bordeaux", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bordeaux", "target_book": "principles_of_psychology_james_1890", "target_name": "Bordeaux", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bordeaux", "target_book": "principles_of_psychology_james_1890", "target_name": "Bordeaux", "similarity": 1.0}], "id": 378, "stable_key": "clu_dda34420e56bd721", "ground_truth": {"wikipedia_extract": "Bordeaux ( bor-DOH; French: [bɔrdo] ; Gascon Occitan: Bordèu [buɾˈðɛw]; Basque: Bordele) is a city on the river Garonne in the Gironde department, southwestern France. A port city, it is the capital of the Nouvelle-Aquitaine region, as well as the prefecture of the Gironde department. Its inhabitants are called \"Bordelais\" (masculine) or \"Bordelaises\" (feminine). The term \"Bordelais\" may also refer to the city and its surrounding region. The city of Bordeaux proper had a population of 259,809 in 2020 within its small municipal territory of 49 km2 (19 sq mi), but together with its suburbs and exurbs the Bordeaux metropolitan area had a population of 1,376,375 that same year (Jan. 2020 census), the sixth-most populated in France after Paris, Lyon, Marseille, Lille, and Toulouse. Bordeaux and 27 suburban municipalities form the Bordeaux Metropolis, an indirectly elected metropolitan authority now in charge of wider metropolitan issues."}}, {"canonical_name": "Bokhara", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "bokhara", "book_id": "kosmos_humboldt_1845", "name": "Bokhara", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Bokhara"], "contexts": ["city with clear atmosphere for astronomy", "location with pure atmosphere"]}, {"entity_id": "bokhara", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bokhara", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Bokhara"], "contexts": ["city with a man-made mountain", "city in Asia"]}, {"entity_id": "bokhára", "book_id": "coloquios_da_orta_1563", "name": "Bokhára", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Bokhára", "Bokhara"], "contexts": ["birthplace of Avicenna", "city in Uzbeque"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Bokhara", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Bokhara", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bokhara", "target_book": "coloquios_da_orta_1563", "target_name": "Bokhára", "similarity": 0.94}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bokhara", "target_book": "coloquios_da_orta_1563", "target_name": "Bokhára", "similarity": 0.94}], "id": 379, "stable_key": "clu_a062ac2318677bf1", "ground_truth": {"modern_name": "Bukhara", "confidence": "high", "type": "place", "description": "Historic city in Uzbekistan, a Silk Road hub.", "wikipedia_extract": "Bukhara ( buu-KHAR-ə) is the seventh-largest city in Uzbekistan by population, with 280,187 residents as of 1 January 2020. It is the capital of Bukhara Region. The Bukhara region has been inhabited for at least five millennia, and the city has existed for half that time. Located on the Silk Road, the city has long served as a center of trade, scholarship, culture, and religion. Bukhara served as the capital of the Uzbek states such as the Khanate of Bukhara, the Emirate of Bukhara and later the Bukhara People’s Soviet Republic. It was the birthplace of the scholar Imam Bukhari."}}, {"canonical_name": "Kasan", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "kasan", "book_id": "kosmos_humboldt_1845", "name": "Kasan", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Kasan"], "contexts": ["city used for longitude determination", "city of simultaneous observations"]}, {"entity_id": "kasan", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Kasan", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Kasan"], "contexts": ["university city", "city for observation"]}, {"entity_id": "royaumes_de_kasan", "book_id": "relation_historique_humboldt_vol3_1825", "name": "royaumes de Kasan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["royaumes de Kasan"], "contexts": ["Part of European Russia"]}, {"entity_id": "kasan", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Kasan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Kasan"], "contexts": ["location of M. Kupffer's observations", "summer and winter mean temperature compared"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Kasan", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Kasan", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Kasan", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kasan", "similarity": 0.836}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Kasan", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kasan", "similarity": 0.836}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "royaumes de Kasan", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kasan", "similarity": 0.848}], "id": 380, "stable_key": "clu_2e3636009c061d3f", "ground_truth": {"modern_name": "Kazan", "confidence": "high", "type": "place", "country": "Russia", "note": "The mentions of 'Kasan' as a city used for longitude determination and a university city, situated in European Russia, strongly point to Kazan.", "wikidata_id": "Q900", "wikidata_description": "city in the Republic of Tatarstan, Russia", "wikipedia_url": "https://en.wikipedia.org/wiki/Kazan", "wikipedia_extract": "Kazan is the largest city and capital of Tatarstan, Russia. The city lies at the confluence of the Volga and the Kazanka rivers, covering an area of 425.3 square kilometres (164.2 square miles), with a population of over 1.3 million residents, and up to nearly 2 million residents in the greater metropolitan area. Kazan is the fifth-largest city in Russia, being the most populous city on the Volga and within the Volga Federal District. Historically, Kazan was the capital of the Khanate of Kazan, and was conquered by Ivan the Terrible in the 16th century, at which point the city became a part of the Tsardom of Russia. The city was seized (and largely destroyed) during Pugachev's Rebellion (1773–1775), but was later rebuilt during the reign of Catherine the Great. In the following centuries, Kazan grew to become a major industrial, cultural and religious centre of Russia."}}, {"canonical_name": "Oxus", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "oxus", "book_id": "coloquios_da_orta_1563", "name": "Oxus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Oxus"], "contexts": ["river, also known as Amu-darya", "river east of which Uzbeks took lands"]}, {"entity_id": "oxus", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Oxus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Oxus"], "contexts": ["ancient name for Amou/Djihoun river", "ancient name for Amou river"]}, {"entity_id": "oxus", "book_id": "kosmos_humboldt_1845", "name": "Oxus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Oxus"], "contexts": ["river in Central Asia", "river"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Oxus", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Oxus", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Oxus", "target_book": "kosmos_humboldt_1845", "target_name": "Oxus", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oxus", "target_book": "kosmos_humboldt_1845", "target_name": "Oxus", "similarity": 1.0}], "id": 381, "stable_key": "clu_e34b19c6d33f6306", "ground_truth": {"modern_name": "Amu Darya", "confidence": "high", "type": "place", "description": "A major river in Central Asia, historically known as the Oxus.", "note": "Also referred to as Djihoun in historical texts.", "wikipedia_extract": "The Amu Darya, historically known as the Oxus, is a major river in Central Asia which flows through Afghanistan, Tajikistan, Turkmenistan, and Uzbekistan. Rising in the Pamir Mountains, north of the Hindu Kush, the Amu Darya is formed by the confluence of the Vakhsh and Panj rivers, in the Tigrovaya Balka Nature Reserve on the border between Afghanistan and Tajikistan, and flows from there north-westwards into the southern remnants of the Aral Sea. However, today the Amu Darya does not reach the Aral Sea, and its mouth is in a dried-up area, of what was once the Aral Sea. In its upper course, the river forms part of Afghanistan's northern border with Tajikistan, Uzbekistan, and Turkmenistan. In ancient history, the river was regarded as the boundary of Greater Iran with Turan, which roughly corresponded to present-day Central Asia. The Amu Darya has a flow of about 70 cubic kilometres per year on average."}}, {"canonical_name": "Corpo Santo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "corpo_santo", "book_id": "polyanthea_medicinal", "name": "Corpo Santo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Corpo Santo", "CorpoSanto"], "contexts": ["location of apothecary", "location where Samuel lived"]}, {"entity_id": "espiritu_santo", "book_id": "kosmos_humboldt_1845", "name": "Espiritu Santo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Espiritu Santo"], "contexts": ["coast of Brazil"]}, {"entity_id": "corpo_santo", "book_id": "coloquios_da_orta_1563", "name": "Corpo Santo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Corpo Santo"], "contexts": ["island named after", "island name"]}, {"entity_id": "ruadireyta_do_corpo_santo", "book_id": "polyanthea_medicinal", "name": "ruadireyta do Corpo Santo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["ruadireyta do Corpo Santo", "Rua direytadoCorpo Santo", "Ruadireyta do Corpo Santo"], "contexts": ["street where apothecary resides", "street name"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Corpo Santo", "target_book": "kosmos_humboldt_1845", "target_name": "Espiritu Santo", "similarity": 0.891}, {"source_book": "polyanthea_medicinal", "source_name": "Corpo Santo", "target_book": "coloquios_da_orta_1563", "target_name": "Corpo Santo", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Espiritu Santo", "target_book": "coloquios_da_orta_1563", "target_name": "Corpo Santo", "similarity": 0.891}, {"source_book": "coloquios_da_orta_1563", "source_name": "Corpo Santo", "target_book": "polyanthea_medicinal", "target_name": "ruadireyta do Corpo Santo", "similarity": 0.877}], "id": 382, "stable_key": "clu_c29863263cb982bf", "ground_truth": {"modern_name": "Corpo Santo", "confidence": "high", "type": "place", "description": "A place, island, or street, likely named after a saint.", "wikipedia_extract": "Corpo Santo is a Brazilian telenovela created by José Louzeiro for Rede Manchete, aired on March 30 and October 2, 1987, with 162 chapters. Written by Louzeiro, with supervised by Wilson Aguiar Filho, with the collaboration of Cláudio MacDowell, Eliane Garcia, Leila Míccolis and Maria Cláudia Oliveira, under the direction of Ary Coslov and Walter Campos and general direction by José Wilker. It features Christiane Torloni, Reginaldo Faria, Sílvia Buarque, Nathalia Timberg, Lídia Brondi, Otávio Augusto, Jonas Bloch and Sérgio Viotti in the main roles. The beautiful widow Simone Reski moves with her family – her daughter Lucinha, her aunt Maria, and her maid Isaura – from the suburbs to downtown Rio de Janeiro. She immediately meets Téo, a friendly bachelor and bon vivant, unaware that he is involved with the video smuggling and pornographic film production mafia. Téo is interested in Simone because he sees Lucinha as a new nymphet star for his films."}}, {"canonical_name": "Calabria", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "calabria", "book_id": "kosmos_humboldt_1845", "name": "Calabria", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Calabria"], "contexts": ["region experiencing earthquake", "region with cities destroyed by earthquake"]}, {"entity_id": "calabre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Calabre", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Calabre"], "contexts": ["region where sel gemme is found"]}, {"entity_id": "calábria", "book_id": "coloquios_da_orta_1563", "name": "Calábria", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Calábria"], "contexts": ["region with similar substance", "region where manna was collected"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Calabria", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Calabre", "similarity": 0.845}, {"source_book": "kosmos_humboldt_1845", "source_name": "Calabria", "target_book": "coloquios_da_orta_1563", "target_name": "Calábria", "similarity": 0.849}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Calabre", "target_book": "coloquios_da_orta_1563", "target_name": "Calábria", "similarity": 0.902}], "id": 383, "stable_key": "clu_0d74e1c7ea45a564", "ground_truth": {"modern_name": "Calabria", "confidence": "high", "type": "place", "description": "Region in Southern Italy known for minerals and manna.", "note": "Refers to the geographical region of Calabria in Italy.", "wikipedia_extract": "Calabria is a region in Southern Italy. It is a peninsula bordered by the region Basilicata to the north, the Ionian Sea to the east, the Strait of Messina to the southwest, which separates it from Sicily, and the Tyrrhenian Sea to the west. It has 1,832,147 residents as of 2025 across a total area of 15,222 km2 (5,877 sq mi). Catanzaro is the region's capital. Calabria is the birthplace of the name of Italy, given to it by the Ancient Greeks who settled in this land starting from the 8th century BC. They established the first cities, mainly on the coast, as Greek colonies."}}, {"canonical_name": "Padua", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "padua", "book_id": "polyanthea_medicinal", "name": "Padua", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Padua"], "contexts": ["city where Alexandre Maflaria lectured", "city where Augenio was professor"]}, {"entity_id": "padova", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Padova", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Padova"], "contexts": ["city mentioned in a work title"]}, {"entity_id": "padua", "book_id": "kosmos_humboldt_1845", "name": "Padua", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Padua"], "contexts": ["city in Italy", "city with high annual temperature"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Padua", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Padova", "similarity": 0.874}, {"source_book": "polyanthea_medicinal", "source_name": "Padua", "target_book": "kosmos_humboldt_1845", "target_name": "Padua", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Padova", "target_book": "kosmos_humboldt_1845", "target_name": "Padua", "similarity": 0.874}], "id": 384, "stable_key": "clu_46c4ec3187b24f34", "ground_truth": {"modern_name": "Padua", "confidence": "high", "type": "place", "description": "A historic city in Italy, known for its university and academic figures.", "wikipedia_extract": "Padua ( PAD-ew-ə) is a city and comune (municipality) in Veneto, northern Italy, and the capital of the province of Padua. The city lies on the banks of the river Bacchiglione, 40 kilometres (25 miles) west of Venice and 29 km (18 miles) southeast of Vicenza. With a population of 207,694 as of 2025, Padua is the third-largest city in Veneto. It is also the economic and communications hub of the area. Padua is sometimes included, with Venice and Treviso, in the Padua-Treviso-Venice Metropolitan Area (PATREVE), which has a population of around 2,600,000. Besides the Bacchiglione, the Brenta River, which once ran through the city, still touches the northern districts."}}, {"canonical_name": "naphte", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "naphte", "book_id": "relation_historique_humboldt_vol3_1825", "name": "naphte", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["naphte"], "contexts": ["flammable liquid", "flammable liquid from petroleum"]}, {"entity_id": "napta", "book_id": "historia_medicinal_monardes_1574", "name": "Napta", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Napta"], "contexts": ["naphtha", "substance flowing from springs"]}, {"entity_id": "napelo", "book_id": "historia_medicinal_monardes_1574", "name": "Napelo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Napelo"], "contexts": ["plant mentioned in relation to poison", "herb taken by people"]}, {"entity_id": "néptd", "book_id": "historia_medicinal_monardes_1574", "name": "Néptd", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Néptd"], "contexts": ["naphtha"]}, {"entity_id": "nauale", "book_id": "ricettario_fiorentino_1597", "name": "nauale", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nauale"], "contexts": ["naval pitch"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "naphte", "target_book": "historia_medicinal_monardes_1574", "target_name": "Napta", "similarity": 0.921}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "naphte", "target_book": "historia_medicinal_monardes_1574", "target_name": "Napelo", "similarity": 0.856}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "naphte", "target_book": "historia_medicinal_monardes_1574", "target_name": "Néptd", "similarity": 0.861}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "naphte", "target_book": "ricettario_fiorentino_1597", "target_name": "nauale", "similarity": 0.868}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Napelo", "target_book": "ricettario_fiorentino_1597", "target_name": "nauale", "similarity": 0.83}], "id": 385, "stable_key": "clu_31bfb86046abfe8d", "ground_truth": {"modern_name": "Naphtha", "confidence": "medium", "type": "substance", "description": "Flammable liquid derived from petroleum or coal tar.", "note": "Includes naval pitch in one context.", "wikipedia_extract": "Naphtha (, recorded as less common or nonstandard in all dictionaries: ) is a flammable liquid hydrocarbon mixture. Generally, it is a fraction of crude oil, but it can also be produced from natural-gas condensates, petroleum distillates, and the fractional distillation of coal tar and peat. In some industries and regions, the name naphtha refers to crude oil or refined petroleum products such as kerosene or diesel fuel. Naphtha is also known as Shellite in Australia. The word naphtha comes from Latin through Ancient Greek (νάφθα), derived from Middle Persian naft (\"wet\", \"naphtha\"), the latter meaning of which was an assimilation from the Akkadian 𒉌𒆳𒊏 napṭu (see Semitic relatives such as Arabic نَفْط nafṭ [\"petroleum\"], Syriac ܢܰܦܬܳܐ naftā, and Hebrew נֵפְט neft, meaning petroleum). The Treaty of Esarhaddon (c. 675 BC) briefly mentions during a listing of curses how \"naphtha [shall] be your ointment\" if the oath made in the treaty is broken."}}, {"canonical_name": "Leipzig", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "leipzig", "book_id": "principles_of_psychology_james_1890", "name": "Leipzig", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Leipzig"], "contexts": ["location of publication", "city where book was published"]}, {"entity_id": "lipsiae", "book_id": "kosmos_humboldt_1845", "name": "Lipsiae", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Lipsiae"], "contexts": ["location of publication"]}, {"entity_id": "lipsiae", "book_id": "coloquios_da_orta_1563", "name": "Lipsiae", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Lipsiae"], "contexts": ["location of publication"]}, {"entity_id": "leipzig", "book_id": "coloquios_da_orta_1563", "name": "Leipzig", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Leipzig"], "contexts": ["city of publication"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Leipzig", "target_book": "kosmos_humboldt_1845", "target_name": "Lipsiae", "similarity": 0.858}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Leipzig", "target_book": "coloquios_da_orta_1563", "target_name": "Lipsiae", "similarity": 0.858}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Leipzig", "target_book": "coloquios_da_orta_1563", "target_name": "Leipzig", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Lipsiae", "target_book": "coloquios_da_orta_1563", "target_name": "Lipsiae", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Lipsiae", "target_book": "coloquios_da_orta_1563", "target_name": "Leipzig", "similarity": 0.858}], "id": 386, "stable_key": "clu_c271a23979de27f1", "ground_truth": {"modern_name": "Leipzig", "confidence": "high", "type": "place", "description": "City in Germany, significant for publication.", "note": "Refers to the city of Leipzig, Germany, a known center for printing and academic work.", "wikipedia_extract": "Leipzig is the most populous city in the German state of Saxony. The city has a population of 628,718 inhabitants as of 2023. It is the eighth-largest city in Germany and is part of the Central German Metropolitan Region. Leipzig is located about 150 km (90 mi) southwest of Berlin, in the southernmost part of the North German Plain (the Leipzig Bay), at the confluence of the White Elster and its tributaries Pleiße and Parthe. Leipzig has been a trade city since at least the time of the Holy Roman Empire. Via Regia and the Via Imperii, two important medieval trade routes, intersected here, marking the city's economic importance."}}, {"canonical_name": "Orion", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "orion", "book_id": "kosmos_humboldt_1845", "name": "Orion", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["Orion"], "contexts": ["nebula and constellation", "nebulous spot in the sky"]}, {"entity_id": "orion", "book_id": "principles_of_psychology_james_1890", "name": "Orion", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Orion"], "contexts": ["constellation perceived by consciousness"]}, {"entity_id": "ε_orionis", "book_id": "connexion_physical_sciences_somerville_1858", "name": "ε Orionis", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["ε Orionis"], "contexts": ["star in Orion constellation"]}, {"entity_id": "θ_orionis", "book_id": "connexion_physical_sciences_somerville_1858", "name": "θ Orionis", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["θ Orionis"], "contexts": ["multiple star system in our hemisphere"]}, {"entity_id": "epsilon_orionis", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Epsilon Orionis", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Epsilon Orionis"], "contexts": ["star zone for astronomical observation"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Orion", "target_book": "principles_of_psychology_james_1890", "target_name": "Orion", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Orion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ε Orionis", "similarity": 0.954}, {"source_book": "kosmos_humboldt_1845", "source_name": "Orion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "θ Orionis", "similarity": 0.958}, {"source_book": "kosmos_humboldt_1845", "source_name": "Orion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Epsilon Orionis", "similarity": 0.886}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Orion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ε Orionis", "similarity": 0.954}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Orion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "θ Orionis", "similarity": 0.958}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Orion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Epsilon Orionis", "similarity": 0.886}], "id": 387, "stable_key": "clu_3b25a2bd1ffcaf16", "ground_truth": {"modern_name": "Orion (constellation)", "confidence": "high", "type": "concept", "note": "References to 'Orion', 'ε Orionis', 'θ Orionis', and 'Epsilon Orionis' in the context of constellations and nebulae clearly identify the constellation Orion. While Orion is also a mythological figure, the astronomical references are dominant here.", "wikipedia_extract": "Orion is a prominent set of stars visible during winter in the northern celestial hemisphere. It is one of the 88 modern constellations; it was among the 48 constellations listed by the 2nd-century AD/CE astronomer Ptolemy. It is named after a hunter in Greek mythology. Orion is most prominent during winter evenings in the Northern Hemisphere, as are five other constellations that have stars in the Winter Hexagon asterism. Orion's two brightest stars, Rigel (β) and Betelgeuse (α), are both among the brightest stars in the night sky; both are supergiants and slightly variable. There are a further six stars brighter than magnitude 3.0, including three making the short straight line of the Orion's Belt asterism."}}, {"canonical_name": "pitch", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "pitch", "book_id": "connexion_physical_sciences_somerville_1858", "name": "pitch", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["pitch"], "contexts": ["perceived highness or lowness of a sound", "frequency of sound vibration"]}, {"entity_id": "pitch", "book_id": "principles_of_psychology_james_1890", "name": "pitch", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["pitch"], "contexts": ["quality of tone that rises with rapidity", "highness or lowness of a tone"]}, {"entity_id": "pitch", "book_id": "first_principles_spencer_1862", "name": "pitch", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["pitch"], "contexts": ["highness or lowness of a sound"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "pitch", "target_book": "principles_of_psychology_james_1890", "target_name": "pitch", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "pitch", "target_book": "first_principles_spencer_1862", "target_name": "pitch", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "pitch", "target_book": "first_principles_spencer_1862", "target_name": "pitch", "similarity": 1.0}], "id": 388, "stable_key": "clu_e92c3002daa07943", "ground_truth": {"modern_name": "pitch (sound)", "confidence": "high", "type": "concept", "note": "The descriptions 'perceived highness or lowness of a sound' and 'quality of tone that rises with rapidity' unequivocally refer to the concept of pitch in acoustics and psychoacoustics.", "wikipedia_extract": "Pitch is the quality that makes it possible to judge sounds as \"higher\" and \"lower\" in the sense associated with musical melodies. Pitch is a perceptual property that allows sounds to be ordered on a frequency-related scale. Pitch is a major auditory attribute of musical tones, along with duration, loudness, and timbre. Pitch may be quantified as a frequency, but pitch is not a purely objective physical property; it is a subjective psychoacoustical attribute of sound. Historically, the study of pitch and pitch perception has been a central problem in psychoacoustics, and has been instrumental in forming and testing theories of sound representation, processing, and perception in the auditory system. Pitch is an auditory sensation in which a listener assigns musical tones to relative positions on a musical scale based primarily on their perception of the frequency of vibration (audio frequency)."}}, {"canonical_name": "Hysop", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "hysop", "book_id": "english_physician_1652", "name": "Hysop", "category": "PLANT", "subcategory": "PLANT", "count": 5, "variants": ["Hysop"], "contexts": ["herb", "herb used in a medicinal preparation"]}, {"entity_id": "hysop", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hysop", "category": "PLANT", "subcategory": "HERB", "count": 2, "variants": ["Hysop"], "contexts": ["herb used by Ancients, unknown today", "ancient kind of herb, unknown now"]}, {"entity_id": "hysoppo", "book_id": "ricettario_fiorentino_1597", "name": "Hysoppo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Hysoppo"], "contexts": ["ingredient in multiple recipes"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Hysop", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Hysop", "similarity": 0.896}, {"source_book": "english_physician_1652", "source_name": "Hysop", "target_book": "ricettario_fiorentino_1597", "target_name": "Hysoppo", "similarity": 0.851}], "id": 389, "stable_key": "clu_6ccaf3cc6e534086", "ground_truth": {"modern_name": "Hyssop", "confidence": "high", "type": "plant", "linnaean": "Hyssopus officinalis", "family": "Lamiaceae", "description": "An aromatic herb with small blue flowers, used medicinally.", "wikipedia_extract": "Hyssopus officinalis or hyssop is a shrub in the Lamiaceae or mint family native to Southern Europe, the Middle East, and the region surrounding the Caspian Sea. Due to its purported properties as an antiseptic, cough reliever, and expectorant, it has been used in traditional herbal medicine. Hyssop is a brightly coloured shrub or subshrub that ranges from 30 to 60 cm (12 to 24 in) in height. The stem is woody at the base, from which grow a number of upright branches. Its leaves are lanceolate, dark green, and from 2 to 2.5 cm (3⁄4 to 1 in) long. During the summer, hyssop produces pink, blue (ssp. aristadus), or, more rarely, white fragrant (ssp. f. albus) flowers."}}, {"canonical_name": "hernias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "hernias", "book_id": "polyanthea_medicinal", "name": "hernias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["hernias", "Hernias", "Hernias inteſtinaes", "hernias carnofas"], "contexts": ["condition affecting the throat", "hernias"]}, {"entity_id": "hernias", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hernias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Hernias"], "contexts": ["a medical condition"]}, {"entity_id": "herniam", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Herniam", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Herniam"], "contexts": ["plaster for hernia with attractive power"]}, {"entity_id": "hiernia_carnosa", "book_id": "english_physician_1652", "name": "Hiernia Carnosa", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Hiernia Carnosa"], "contexts": ["fleshy rupture, a type of hernia"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "hernias", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Hernias", "similarity": 0.992}, {"source_book": "polyanthea_medicinal", "source_name": "hernias", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Herniam", "similarity": 0.941}, {"source_book": "polyanthea_medicinal", "source_name": "hernias", "target_book": "english_physician_1652", "target_name": "Hiernia Carnosa", "similarity": 0.87}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hernias", "target_book": "english_physician_1652", "target_name": "Hiernia Carnosa", "similarity": 0.872}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Herniam", "target_book": "english_physician_1652", "target_name": "Hiernia Carnosa", "similarity": 0.869}], "id": 390, "stable_key": "clu_eba611654f5f3107", "ground_truth": {"modern_name": "hernias", "confidence": "high", "type": "disease", "description": "Protrusion of an organ or tissue through an abnormal opening.", "note": "Includes specific types of ruptures and general hernias.", "wikipedia_extract": "A hernia (pl.: hernias or herniae, from Latin, meaning 'rupture') is the abnormal exit of tissue or an organ, such as the bowel, through the wall of the cavity in which it normally resides. The term is also used for the normal development of the intestinal tract, referring to the retraction of the intestine from the extra-embryonal navel coelom into the abdomen in the healthy embryo at about 71⁄2 weeks. Various types of hernias can occur, most commonly involving the abdomen, and specifically the groin. Groin hernias are most commonly inguinal hernias but may also be femoral hernias. Other types of hernias include hiatus, incisional, and umbilical hernias. Symptoms are present in about 66% of people with groin hernias."}}, {"canonical_name": "Mummia", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "mummia", "book_id": "ricettario_fiorentino_1597", "name": "Mummia", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["Mummia", "Mumia"], "contexts": ["mummy substance", "substance used in preparation"]}, {"entity_id": "mummia", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mummia", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Mummia"], "contexts": ["substance tested for electrical properties"]}, {"entity_id": "mummia", "book_id": "english_physician_1652", "name": "Mummia", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Mummia"], "contexts": ["taken with Rubarb powder"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Mummia", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Mummia", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Mummia", "target_book": "english_physician_1652", "target_name": "Mummia", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mummia", "target_book": "english_physician_1652", "target_name": "Mummia", "similarity": 1.0}], "id": 391, "stable_key": "clu_b0d516b5162b01a9", "ground_truth": {"modern_name": "Mummy", "confidence": "high", "type": "substance", "description": "Preserved human or animal remains, historically used in medicine.", "wikipedia_extract": "A mummy is a dead human or an animal whose soft tissues and organs have been preserved by either intentional or accidental exposure to chemicals, extreme cold, very low humidity, or lack of air, so that the recovered body does not decay further if kept in cool and dry conditions. Some authorities restrict the use of the term to bodies deliberately embalmed with chemicals, but the use of the word to cover accidentally desiccated bodies goes back to at least the early 17th century. Mummies of humans and animals have been found on every continent, both as a result of natural preservation through unusual conditions, and as cultural artifacts. Over one million animal mummies have been found in Egypt, many of which are cats. Many of the Egyptian animal mummies are sacred ibis, and radiocarbon dating suggests the Egyptian ibis mummies that have been analyzed were from a time frame that falls between approximately 450 and 250 BC. The earliest discovered evidence of deliberate mummification in human cultures now extends to approximately 10,000 B.C. and is documented to have existed across Southeast Asia, China, New Guinea, and Australia in burials discovered there, and is prompting research to cultures documented to 20,000 years ago for evidence of use of the same mummification methods."}}, {"canonical_name": "Job", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "job", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Job", "category": "PERSON", "subcategory": "AUTHORITY", "count": 6, "variants": ["Job"], "contexts": ["biblical figure tested by Satan", "biblical figure, known for patience"]}, {"entity_id": "job", "book_id": "principles_of_psychology_james_1890", "name": "Job", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Job"], "contexts": ["biblical figure known for his faith"]}, {"entity_id": "job", "book_id": "polyanthea_medicinal", "name": "Job", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Job"], "contexts": ["Biblical figure, considered a source of wisdom"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Job", "target_book": "principles_of_psychology_james_1890", "target_name": "Job", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Job", "target_book": "polyanthea_medicinal", "target_name": "Job", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Job", "target_book": "polyanthea_medicinal", "target_name": "Job", "similarity": 1.0}], "id": 392, "stable_key": "clu_f8124331a93b6298", "ground_truth": {"wikipedia_extract": "A job, employment, work or occupation, is a person's role in society. More specifically, a job is an activity, often regular and often performed in exchange for payment (\"for a living\"). Many people have multiple jobs (e.g., parent, homemaker, and employee). A person can begin a job by becoming an employee, volunteering, starting a business, or becoming a parent. The duration of a job may range from temporary (e.g., hourly odd jobs) to a lifetime (e.g., judges). An activity that requires a person's mental or physical effort is work (as in \"a day's work\")."}}, {"canonical_name": "Principles of Logic", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "principles_of_logic", "book_id": "principles_of_psychology_james_1890", "name": "Principles of Logic", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 4, "variants": ["Principles of Logic"], "contexts": ["book title", "book title cited"]}, {"entity_id": "principles_of_philosophy", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "principles of Philosophy", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 3, "variants": ["Principles of Philosophy", "principles of Philosophy"], "contexts": ["work by Descartes on natural philosophy", "work by Des Cartes"]}, {"entity_id": "principles_of_biology", "book_id": "first_principles_spencer_1862", "name": "Principles of Biology", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Principles of Biology"], "contexts": ["book title"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Principles of Logic", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "principles of Philosophy", "similarity": 0.848}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Principles of Logic", "target_book": "first_principles_spencer_1862", "target_name": "Principles of Biology", "similarity": 0.842}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "principles of Philosophy", "target_book": "first_principles_spencer_1862", "target_name": "Principles of Biology", "similarity": 0.819}], "id": 393, "stable_key": "clu_5c04501525e42728", "ground_truth": {"modern_name": "Principles of Philosophy", "confidence": "high", "type": "text", "note": "While 'Principles of Logic' and 'Principles of Biology' are mentioned, the context of 'work by Descartes on natural philosophy' alongside 'Principles of Philosophy' strongly suggests Descartes' 'Principia Philosophiae' (Principles of Philosophy) as the primary referent. This is a book title, not an organization.", "wikipedia_extract": "Principles of Philosophy (Latin: Principia Philosophiae) is a book by the French philosopher and scientist René Descartes. In essence, it is a synthesis of the Discourse on Method and Meditations on First Philosophy. It was written in Latin, published in 1644 and dedicated to Elisabeth of Bohemia, with whom Descartes had a long-standing friendship. A French version (Les Principes de la Philosophie) followed in 1647. The book sets forth the principles of nature—the laws of physics—as Descartes viewed them. Most notably, it set forth the principle that in the absence of external forces, an object's motion will be uniform and in a straight line."}}, {"canonical_name": "glottis", "category": "ANATOMY", "subcategory": "BODY_PART", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "glottis", "book_id": "principles_of_psychology_james_1890", "name": "glottis", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 4, "variants": ["glottis"], "contexts": ["opening between vocal cords", "part of the larynx"]}, {"entity_id": "guts", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Guts", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 3, "variants": ["guts", "Guts"], "contexts": ["intestines", "intestinal tract"]}, {"entity_id": "glottis", "book_id": "origin_of_species_darwin_1859", "name": "glottis", "category": "ANATOMY", "subcategory": "ORGAN", "count": 1, "variants": ["glottis"], "contexts": ["opening of the larynx"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "glottis", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Guts", "similarity": 0.869}, {"source_book": "principles_of_psychology_james_1890", "source_name": "glottis", "target_book": "origin_of_species_darwin_1859", "target_name": "glottis", "similarity": 0.896}], "id": 394, "stable_key": "clu_402d6d532def6803", "ground_truth": {"modern_name": "glottis", "confidence": "high", "type": "anatomy", "description": "The opening between the vocal folds in the larynx.", "wikipedia_extract": "The glottis (pl.: glottises or glottides) is the middle region of the larynx, where the vocal folds are located. Within this region is the opening between the vocal folds (the rima glottidis). The glottis is crucial in producing sound  from the vocal folds. From Ancient Greek γλωττίς (glōttís), derived from γλῶττα (glôtta), variant of γλῶσσα (glôssa, \"tongue\"). As the vocal folds vibrate, the resulting vibration produces a \"buzzing\" quality to the speech, called voice or voicing or pronunciation. Sound production that involves moving the vocal folds close together is called glottal."}}, {"canonical_name": "Euphrates", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "euphrates", "book_id": "coloquios_da_orta_1563", "name": "Euphrates", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["Euphrates"], "contexts": ["river in the Middle East", "river mouth"]}, {"entity_id": "ephraim", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ephraim", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Ephraim"], "contexts": ["biblical region or tribe"]}, {"entity_id": "euphrates", "book_id": "kosmos_humboldt_1845", "name": "euphrates", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["euphrates"], "contexts": ["river in ancient regions"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Euphrates", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Ephraim", "similarity": 0.89}, {"source_book": "coloquios_da_orta_1563", "source_name": "Euphrates", "target_book": "kosmos_humboldt_1845", "target_name": "euphrates", "similarity": 0.974}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ephraim", "target_book": "kosmos_humboldt_1845", "target_name": "euphrates", "similarity": 0.871}], "id": 395, "stable_key": "clu_c830f1b635d3991a", "ground_truth": {"modern_name": "Euphrates River", "confidence": "high", "type": "place", "country": "Iraq, Syria, Turkey", "note": "The context of 'river in the Middle East' and its spelling variations, alongside the clear mention of 'Euphrates' in historical texts, points to the Euphrates River. 'Ephraim' appears to be a variant or a related biblical term but the primary referent is the river.", "wikidata_id": "Q34589", "wikidata_description": "river in Asia", "wikipedia_url": "https://en.wikipedia.org/wiki/Euphrates", "wikipedia_extract": "The Euphrates (  yoo-FRAY-teez; see below) is the longest and one of the most historically important rivers of West Asia. Together with the Tigris, it is one of the two defining rivers of Mesopotamia (lit. 'the land between the rivers'). Originating in Turkey, the Euphrates flows through Syria and Iraq to join the Tigris in the Shatt al-Arab in Iraq, which empties into the Persian Gulf. The Euphrates is the fifteenth-longest river in Asia and the longest in West Asia, at about 2,780 km (1,730 mi), with a drainage area of 440,000 km2 (170,000 mi2) that covers six countries. The term Euphrates derives from the Greek Euphrátēs (Εὐφρᾱ́της), adapted from Old Persian: 𐎢𐎳𐎼𐎠𐎬𐎢, romanized: hUfrātuš, itself from Elamite: 𒌑𒅁𒊏𒌅𒅖, romanized: Úipratuiš. The Elamite name is ultimately derived from cuneiform 𒌓𒄒𒉣; read as Buranun in Sumerian and Purattu in Akkadian; many cuneiform signs have a Sumerian pronunciation and an Akkadian pronunciation, taken from a Sumerian word and an Akkadian word that mean the same."}}, {"canonical_name": "milagre", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "milagre", "book_id": "polyanthea_medicinal", "name": "milagre", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["milagre", "milagres"], "contexts": ["miracle", "Supernatural intervention"]}, {"entity_id": "magical", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Magical", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Magical"], "contexts": ["category of relations concerning loadstone", "relating to magic"]}, {"entity_id": "mirage", "book_id": "relation_historique_humboldt_vol3_1825", "name": "mirage", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["mirage"], "contexts": ["optical phenomenon causing wavy plains", "optical phenomenon in atmosphere"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "milagre", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Magical", "similarity": 0.853}, {"source_book": "polyanthea_medicinal", "source_name": "milagre", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "mirage", "similarity": 0.847}], "id": 396, "stable_key": "clu_6a6058a598c61741", "ground_truth": {"modern_name": "Miracle", "confidence": "medium", "type": "concept", "description": "A miraculous event or supernatural intervention; also an optical atmospheric phenomenon.", "note": "The term 'milagre' (miracle) is contrasted with 'mirage' (optical phenomenon).", "wikipedia_extract": "A miracle is an event that is inexplicable by natural or scientific laws and accordingly gets attributed to some supernatural or preternatural cause. Various religions often attribute a phenomenon characterized as miraculous to the actions of a supernatural being, (especially) a deity, a miracle worker, a saint, or a religious leader. Informally, English-speakers often use the word miracle to characterise any beneficial event that is statistically unlikely but not contrary to the laws of nature, such as surviving a natural disaster, or simply a \"wonderful\" occurrence, regardless of likelihood (e.g. \"the miracle of childbirth\"). Some coincidences may be seen as miracles. A true miracle would, by definition, be a non-natural phenomenon, leading many writers to dismiss miracles as physically impossible (that is, requiring violation of established laws of physics within their domain of validity) or impossible to confirm by their nature (because all possible physical mechanisms can never be ruled out). The former position is expressed (for instance) by Thomas Jefferson, and the latter by David Hume."}}, {"canonical_name": "Primrose", "category": "PLANT", "subcategory": "HERB", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "primrose", "book_id": "origin_of_species_darwin_1859", "name": "Primrose", "category": "PLANT", "subcategory": "HERB", "count": 6, "variants": ["Primrose", "primrose"], "contexts": ["plant differing from cowslip", "plant used in cross-fertilization experiments"]}, {"entity_id": "primroses", "book_id": "english_physician_1652", "name": "Primroses", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Primroses"], "contexts": ["well known herb"]}, {"entity_id": "primrose", "book_id": "connexion_physical_sciences_somerville_1858", "name": "primrose", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["primrose"], "contexts": ["flower not found in Himalaya"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Primrose", "target_book": "english_physician_1652", "target_name": "Primroses", "similarity": 0.842}, {"source_book": "english_physician_1652", "source_name": "Primroses", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "primrose", "similarity": 0.834}], "id": 397, "stable_key": "clu_66dbbd0c12841b08", "ground_truth": {"modern_name": "Primrose", "confidence": "high", "type": "plant", "linnaean": "Primula vulgaris", "family": "Primulaceae", "description": "A common spring-blooming herbaceous plant with pale yellow flowers.", "wikipedia_extract": "Primula vulgaris is a species of flowering plant in the family Primulaceae, native to Eurasia. The common name of this plant is primrose, or occasionally common primrose or English primrose to distinguish it from other Primula species referred to as primroses. Primula vulgaris is a perennial growing 10–30 centimetres (4–12 inches) tall, with a basal rosette of leaves which are more-or-less evergreen in favoured habitats. The leaves are 5–25 cm (2–10 in) long and 2–6 cm (1–2+1⁄2 in) broad, often heavily wrinkled, with an irregularly crenate to dentate margin. The leaf blade is gradually attenuated towards the base and unevenly toothed. The single stem, extremely short, is hidden in the centre of the leaf rosette."}}, {"canonical_name": "Herb. Amb.", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "herb__amb_", "book_id": "coloquios_da_orta_1563", "name": "Herb. Amb.", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 5, "variants": ["Herb. Amb.", "Herb. amb.", "Herh. amB."], "contexts": ["title of a botanical work", "book title"]}, {"entity_id": "herbal", "book_id": "english_physician_1652", "name": "Herbal", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Herbal"], "contexts": ["book on plants and their uses"]}, {"entity_id": "herbiers", "book_id": "relation_historique_humboldt_vol3_1825", "name": "herbiers", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["herbiers"], "contexts": ["collections of dried plants"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Herb. Amb.", "target_book": "english_physician_1652", "target_name": "Herbal", "similarity": 0.865}, {"source_book": "coloquios_da_orta_1563", "source_name": "Herb. Amb.", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "herbiers", "similarity": 0.867}, {"source_book": "english_physician_1652", "source_name": "Herbal", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "herbiers", "similarity": 0.832}], "id": 398, "stable_key": "clu_32b88c98168fd1d6", "ground_truth": {"modern_name": "Herbal", "confidence": "high", "type": "object", "description": "A book containing descriptions and illustrations of plants and their uses.", "note": "Refers to specific botanical works and the general category of herbals.", "wikipedia_extract": "A herbal is a book containing the names and descriptions of plants, usually with information on their medicinal, tonic, culinary, toxic, hallucinatory, aromatic, or magical powers, and the legends associated with them. A herbal may also classify the plants it describes, may give recipes for herbal extracts, tinctures, or potions, and sometimes include mineral and animal medicaments in addition to those obtained from plants. Herbals were often illustrated to assist plant identification. Herbals were among the first literature produced in Ancient Egypt, China, India, and Europe as the medical wisdom of the day accumulated by herbalists, apothecaries and physicians. Herbals were also among the first books to be printed in both China and Europe. In Western Europe herbals flourished for two centuries following the introduction of moveable type (c. 1470–1670)."}}, {"canonical_name": "Bohemia", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "bohemia", "book_id": "kosmos_humboldt_1845", "name": "Bohemia", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Bohemia"], "contexts": ["historical region in Central Europe", "region of Joachimsthal mine"]}, {"entity_id": "bohemia", "book_id": "origin_of_species_darwin_1859", "name": "Bohemia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Bohemia"], "contexts": ["region with Silurian deposits"]}, {"entity_id": "western_bohemia", "book_id": "kosmos_humboldt_1845", "name": "Western Bohemia", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Western Bohemia"], "contexts": ["area with carbonic acid exhalations", "geographic location"]}, {"entity_id": "bohemian_mittelgebirge", "book_id": "kosmos_humboldt_1845", "name": "Bohemian Mittelgebirge", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Bohemian Mittelgebirge"], "contexts": ["location of basalt"]}, {"entity_id": "bohemia", "book_id": "polyanthea_medicinal", "name": "Bohemia", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Bohemia"], "contexts": ["Rey de Bohemia"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Bohemia", "target_book": "origin_of_species_darwin_1859", "target_name": "Bohemia", "similarity": 0.888}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bohemia", "target_book": "polyanthea_medicinal", "target_name": "Bohemia", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Bohemia", "target_book": "kosmos_humboldt_1845", "target_name": "Western Bohemia", "similarity": 0.898}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Bohemia", "target_book": "kosmos_humboldt_1845", "target_name": "Bohemian Mittelgebirge", "similarity": 0.871}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Bohemia", "target_book": "polyanthea_medicinal", "target_name": "Bohemia", "similarity": 0.888}], "id": 399, "stable_key": "clu_636e2770e6b81150", "ground_truth": {"modern_name": "Bohemia", "confidence": "high", "type": "place", "country": "Czech Republic", "wikidata_id": "Q39193", "wikidata_description": "historical region in the Czech Republic", "wikipedia_url": "https://en.wikipedia.org/wiki/Bohemia", "wikipedia_extract": "Bohemia ( boh-HEE-mee-ə; Czech: Čechy [ˈtʃɛxɪ] ; German: Böhmen [ˈbøːmən] ) is the westernmost and largest historical region of the Czech Republic. Bohemia can also refer to a wider area consisting of the historical Lands of the Bohemian Crown ruled by the Bohemian kings, including Moravia and Czech Silesia, in which case the smaller region is referred to as Bohemia proper as a means of distinction. Bohemians principality became a part of Great Moravia, and then an independent Duchy of Bohemia, which became a kingdom in the Holy Roman Empire. This subsequently became a part of the Habsburg monarchy and the Austrian Empire. After World War I and the establishment of an independent Czechoslovak state, the whole of Bohemia became a part of Czechoslovakia, defying claims of the German-speaking inhabitants that regions with German-speaking majority should be included in the Republic of German-Austria. Between 1938 and 1945, these border regions were annexed to Nazi Germany as the Sudetenland."}}, {"canonical_name": "Chapter X.", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "chapter_x_", "book_id": "first_principles_spencer_1862", "name": "Chapter X.", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 2, "variants": ["Chapter X.", "CHAPTER X."], "contexts": ["chapter title", "reference to a chapter in a work"]}, {"entity_id": "chapter_iii", "book_id": "origin_of_species_darwin_1859", "name": "CHAPTER III", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["CHAPTER III"], "contexts": ["section title"]}, {"entity_id": "chapter_xviii", "book_id": "principles_of_psychology_james_1890", "name": "Chapter XVIII", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Chapter XVIII"], "contexts": ["section of a book"]}, {"entity_id": "chapter_ix", "book_id": "principles_of_psychology_james_1890", "name": "Chapter IX", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Chapter IX"], "contexts": ["section of a book"]}, {"entity_id": "chapter_xxii", "book_id": "principles_of_psychology_james_1890", "name": "Chapter XXII", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Chapter XXII"], "contexts": ["section of a text"]}, {"entity_id": "chapter_vi", "book_id": "principles_of_psychology_james_1890", "name": "Chapter VI", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Chapter VI"], "contexts": ["section of a written work"]}, {"entity_id": "chapter_x", "book_id": "principles_of_psychology_james_1890", "name": "Chapter X", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Chapter X"], "contexts": ["reference to a specific chapter"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "Chapter X.", "target_book": "origin_of_species_darwin_1859", "target_name": "CHAPTER III", "similarity": 0.866}, {"source_book": "first_principles_spencer_1862", "source_name": "Chapter X.", "target_book": "principles_of_psychology_james_1890", "target_name": "Chapter XVIII", "similarity": 0.868}, {"source_book": "first_principles_spencer_1862", "source_name": "Chapter X.", "target_book": "principles_of_psychology_james_1890", "target_name": "Chapter IX", "similarity": 0.919}, {"source_book": "first_principles_spencer_1862", "source_name": "Chapter X.", "target_book": "principles_of_psychology_james_1890", "target_name": "Chapter XXII", "similarity": 0.859}, {"source_book": "first_principles_spencer_1862", "source_name": "Chapter X.", "target_book": "principles_of_psychology_james_1890", "target_name": "Chapter VI", "similarity": 0.87}, {"source_book": "first_principles_spencer_1862", "source_name": "Chapter X.", "target_book": "principles_of_psychology_james_1890", "target_name": "Chapter X", "similarity": 0.984}, {"source_book": "origin_of_species_darwin_1859", "source_name": "CHAPTER III", "target_book": "principles_of_psychology_james_1890", "target_name": "Chapter XVIII", "similarity": 0.826}, {"source_book": "origin_of_species_darwin_1859", "source_name": "CHAPTER III", "target_book": "principles_of_psychology_james_1890", "target_name": "Chapter IX", "similarity": 0.855}, {"source_book": "origin_of_species_darwin_1859", "source_name": "CHAPTER III", "target_book": "principles_of_psychology_james_1890", "target_name": "Chapter XXII", "similarity": 0.824}, {"source_book": "origin_of_species_darwin_1859", "source_name": "CHAPTER III", "target_book": "principles_of_psychology_james_1890", "target_name": "Chapter VI", "similarity": 0.866}, {"source_book": "origin_of_species_darwin_1859", "source_name": "CHAPTER III", "target_book": "principles_of_psychology_james_1890", "target_name": "Chapter X", "similarity": 0.844}], "id": 400, "stable_key": "clu_a4d66135014e664d", "ground_truth": {"modern_name": "Chapter", "confidence": "high", "type": "concept", "wikidata_id": "Q21481766", "wikidata_description": "chapter written by specific authors in a scholarly book", "wikipedia_extract": "The Matrix Online  (abbreviated as MxO) is a discontinued massively multiplayer online role-playing game (MMORPG) initially developed by Monolith Productions and later, a few months after launch, by Sony Online Entertainment. It was advertised as a continuation of the storyline of The Matrix films, as The Wachowskis, the franchise's creators, gave their blessing to the notion of gamers \"inherit[ing] the storyline\". The game began closed beta-testing in June 2004 which was then opened for people who pre-ordered the game in November 2004. Warner Bros. and Sega released MxO on March 22, 2005, in the United States. It was released in Europe on April 15, 2005.", "wikipedia_url": "https://en.wikipedia.org/wiki/The_Matrix_Online"}}, {"canonical_name": "Galice", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "galice", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Galice", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Galice"], "contexts": ["region in Spain", "kingdom and province"]}, {"entity_id": "galicia", "book_id": "kosmos_humboldt_1845", "name": "Galicia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Galicia"], "contexts": ["geographic region"]}, {"entity_id": "galiza", "book_id": "coloquios_da_orta_1563", "name": "Galiza", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Galiza"], "contexts": ["region where whales are found"]}, {"entity_id": "galilea", "book_id": "coloquios_da_orta_1563", "name": "Galilea", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Galilea"], "contexts": ["region where physicians were"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Galice", "target_book": "kosmos_humboldt_1845", "target_name": "Galicia", "similarity": 0.872}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Galice", "target_book": "coloquios_da_orta_1563", "target_name": "Galiza", "similarity": 0.855}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Galice", "target_book": "coloquios_da_orta_1563", "target_name": "Galilea", "similarity": 0.935}, {"source_book": "kosmos_humboldt_1845", "source_name": "Galicia", "target_book": "coloquios_da_orta_1563", "target_name": "Galiza", "similarity": 0.918}, {"source_book": "kosmos_humboldt_1845", "source_name": "Galicia", "target_book": "coloquios_da_orta_1563", "target_name": "Galilea", "similarity": 0.823}], "id": 401, "stable_key": "clu_6fc558cbd9e14249", "ground_truth": {"modern_name": "Galicia", "confidence": "high", "type": "place", "description": "Region in Spain, also mentioned in relation to physicians and whales.", "note": "The inclusion of 'Galilea' suggests a potential confusion or broader historical reference.", "wikipedia_extract": "Galice , or Galice-Applegate or Upper Rogue River, is an extinct Athabaskan language once spoken by the two Upper Rogue River Athabaskan tribes, the Galice and Applegate tribes of southwestern Oregon. The language was spoken on the \"Galice Creek and Applegate River, tributaries of the Rogue River in southwestern Oregon. There were at least two distinct dialects the Galice Creek and Applegate, but only the Galice Creek dialect is well documented.\" It is one of the languages of the Oregon Athabaskan (Tolowa–Galice) cluster of the Pacific Coast Athabaskan languages. The Galice people are also called the Taltushtuntede, Tal-tvsh-dan-ni, and Galice Creek people. The Applegate people are also called the Nabiltse and Dakubetede. The vowel sounds are /i/ [ɪ, i], /e/ [ɛ], /a/, and /o/."}}, {"canonical_name": "Gibraltar", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "gibraltar", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Gibraltar", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Gibraltar"], "contexts": ["city in Maracaybo province", "city in Venezuela"]}, {"entity_id": "détroit_de_gibraltar", "book_id": "relation_historique_humboldt_vol3_1825", "name": "détroit de Gibraltar", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["détroit de Gibraltar"], "contexts": ["strait ships pass through"]}, {"entity_id": "straits_of_gibraltar", "book_id": "kosmos_humboldt_1845", "name": "Straits of Gibraltar", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Straits of Gibraltar"], "contexts": ["strait connecting Atlantic and Mediterranean"]}, {"entity_id": "straits_of_gibraltar", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Straits of Gibraltar", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Straits of Gibraltar"], "contexts": ["narrow strait influencing tides"]}, {"entity_id": "gibraltar,_the_straits_of", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Gibraltar, the Straits of", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Gibraltar, the Straits of"], "contexts": ["turning aside the tidal wave"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Gibraltar", "target_book": "kosmos_humboldt_1845", "target_name": "Straits of Gibraltar", "similarity": 0.921}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Gibraltar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Straits of Gibraltar", "similarity": 0.921}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Gibraltar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Gibraltar, the Straits of", "similarity": 0.931}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "détroit de Gibraltar", "target_book": "kosmos_humboldt_1845", "target_name": "Straits of Gibraltar", "similarity": 0.866}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "détroit de Gibraltar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Straits of Gibraltar", "similarity": 0.866}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "détroit de Gibraltar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Gibraltar, the Straits of", "similarity": 0.86}, {"source_book": "kosmos_humboldt_1845", "source_name": "Straits of Gibraltar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Straits of Gibraltar", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Straits of Gibraltar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Gibraltar, the Straits of", "similarity": 0.97}], "id": 402, "stable_key": "clu_6ef3f476c3f3a130", "ground_truth": {"modern_name": "Strait of Gibraltar", "confidence": "high", "type": "place", "country": "Spain", "wikidata_id": "Q36124", "wikidata_description": "strait that connects the Atlantic Ocean to the Mediterranean Sea", "wikipedia_url": "https://en.wikipedia.org/wiki/Strait%20of%20Gibraltar", "wikipedia_extract": "The Strait of Gibraltar, also known as the Straits of Gibraltar, is a narrow strait that connects the Atlantic Ocean to the Mediterranean Sea and separates Europe from Africa. The two continents are separated by 7.7 nautical miles (14.2 kilometers, 8.9 miles) at its narrowest point. Ferries cross between the two continents every day in as little as 35 minutes. The Strait's depth ranges between 300 and 900 metres (980 and 2,950 feet; 160 and 490 fathoms). The strait lies in the territorial waters of Morocco, Spain, and the British overseas territory of Gibraltar. Under the United Nations Convention on the Law of the Sea, foreign vessels and aircraft have the freedom of navigation and overflight to cross the strait of Gibraltar in case of continuous transit."}}, {"canonical_name": "Filipinas", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "filipinas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Filipinas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["Filipinas"], "contexts": ["fertile district with Rio de Galafre", "jurisdiction mentioned in census data"]}, {"entity_id": "philippinas", "book_id": "coloquios_da_orta_1563", "name": "Philippinas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Philippinas"], "contexts": ["archipelago where Magalhães died"]}, {"entity_id": "philippine_islands", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Philippine Islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Philippine Islands"], "contexts": ["islands in Southeast Asia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Filipinas", "target_book": "coloquios_da_orta_1563", "target_name": "Philippinas", "similarity": 0.979}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Filipinas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Philippine Islands", "similarity": 0.918}, {"source_book": "coloquios_da_orta_1563", "source_name": "Philippinas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Philippine Islands", "similarity": 0.912}], "id": 403, "stable_key": "clu_b79a593cae408536", "ground_truth": {"modern_name": "Philippines", "confidence": "high", "type": "place", "description": "Archipelago and fertile district, historically known as Filipinas.", "wikipedia_extract": "The Philippines, officially the Republic of the Philippines, is an archipelagic country in Southeast Asia. Located in the western Pacific Ocean, it consists of about 7,641 islands, with a total area of about 300,000 square kilometers, which are broadly categorized in three main geographical divisions from north to south: Luzon, Visayas, and Mindanao. With a population of over 112 million, it is the world's fourteenth-most-populous country. The Philippines is bounded by the South China Sea to the west, the Philippine Sea to the east, and the Celebes Sea to the south. It shares maritime borders with Taiwan to the north, Japan to the northeast, Palau to the east and southeast, Indonesia to the south, Malaysia to the southwest, Vietnam to the west, and China to the northwest. It has diverse ethnicities and a rich culture."}}, {"canonical_name": "Bode", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "bode", "book_id": "polyanthea_medicinal", "name": "Bode", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 5, "variants": ["Bode", "bode", "bove"], "contexts": ["goat", "animal used for remedy"]}, {"entity_id": "bodo", "book_id": "kosmos_humboldt_1845", "name": "Bodo", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Bodo"], "contexts": ["genus of microscopic organisms"]}, {"entity_id": "bode", "book_id": "coloquios_da_orta_1563", "name": "bode", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 2, "variants": ["bode"], "contexts": ["goat where the stone is found", "animal from which bezoar stone is created"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Bode", "target_book": "kosmos_humboldt_1845", "target_name": "Bodo", "similarity": 0.899}, {"source_book": "polyanthea_medicinal", "source_name": "Bode", "target_book": "coloquios_da_orta_1563", "target_name": "bode", "similarity": 0.983}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bodo", "target_book": "coloquios_da_orta_1563", "target_name": "bode", "similarity": 0.898}], "id": 404, "stable_key": "clu_0dc57898d99863d8", "ground_truth": {"modern_name": "Goat", "confidence": "high", "type": "animal", "description": "An animal, specifically a goat, from which the bezoar stone was historically derived.", "wikipedia_extract": "The goat or domestic goat (Capra hircus) is a species of goat-antelope that is mostly kept as livestock. It was domesticated from the wild goat (C. aegagrus) of Southwest Asia and Eastern Europe. The goat is a member of the family Bovidae, meaning it is closely related to the sheep. It was one of the first animals to be domesticated, in Iran around 10,000 years ago. Goats have been used for milk, meat, wool, and skins across much of the world. Milk from goats is often turned into cheese."}}, {"canonical_name": "Willow", "category": "PLANT", "subcategory": "TREE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "willow", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Willow", "category": "PLANT", "subcategory": "TREE", "count": 3, "variants": ["Willow"], "contexts": ["wood used for small-coal", "tree used in gunpowder composition"]}, {"entity_id": "willow", "book_id": "english_physician_1652", "name": "Willow", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Willow", "Willow-Hearb"], "contexts": ["tree where the herb grows", "or Willow Leavs"]}, {"entity_id": "willows", "book_id": "kosmos_humboldt_1845", "name": "willows", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["willows"], "contexts": ["tree species in Himalaya"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Willow", "target_book": "english_physician_1652", "target_name": "Willow", "similarity": 0.937}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Willow", "target_book": "kosmos_humboldt_1845", "target_name": "willows", "similarity": 0.945}, {"source_book": "english_physician_1652", "source_name": "Willow", "target_book": "kosmos_humboldt_1845", "target_name": "willows", "similarity": 0.895}], "id": 405, "stable_key": "clu_087f818ec4bd4fc5", "ground_truth": {"modern_name": "Willow", "confidence": "high", "type": "plant", "linnaean": "Salix L.", "family": "Salicaceae", "wikidata_id": "Q36050", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Willow", "wikipedia_extract": "Willows, also called sallows and osiers, of the genus Salix, comprise around 350 species (plus numerous hybrids) of typically deciduous trees and shrubs. They are primarily found on moist soils in cold and temperate regions. Most species are known as willow, but some narrow-leaved shrub species are called osier, and some broader-leaved species are referred to as sallow (from Old English sealh, related to the Latin word salix, willow). Some willows (particularly arctic and alpine species) are low-growing or creeping shrubs; for example, the dwarf willow (Salix herbacea) rarely exceeds 6 centimetres (2+1⁄2 in) in height, though it spreads widely across the ground. Willows have watery bark sap rich in salicin, soft, usually pliant, tough wood, slender branches, and large, fibrous roots that are often stoloniferous. The roots are remarkable for their toughness, size, and tenacity to live, and roots readily sprout from aerial parts of the plant."}}, {"canonical_name": "Simples", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "simples", "book_id": "english_physician_1652", "name": "Simples", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Simples"], "contexts": ["nature of single medicinal substances", "natural materials gathered for medicinal use"]}, {"entity_id": "simples", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Simples", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Simples"], "contexts": ["basic medicinal ingredients"]}, {"entity_id": "semplici", "book_id": "ricettario_fiorentino_1597", "name": "Semplici", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Semplici", "semplici"], "contexts": ["simple substances", "simple medicinal ingredients"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Simples", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Simples", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Simples", "target_book": "ricettario_fiorentino_1597", "target_name": "Semplici", "similarity": 0.94}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Simples", "target_book": "ricettario_fiorentino_1597", "target_name": "Semplici", "similarity": 0.94}], "id": 406, "stable_key": "clu_9142e61da60c7466", "ground_truth": {"modern_name": "Simple Medicines", "confidence": "high", "type": "substance", "description": "Single medicinal substances derived directly from nature, often plants.", "note": "Refers to the uncompounded ingredients used in traditional medicine.", "wikipedia_extract": "Ascorbic acid is an organic compound with formula C6H8O6, originally called hexuronic acid. It is a white solid, but impure samples can appear yellowish. It dissolves freely in water to give mildly acidic solutions. It is a mild reducing agent. Ascorbic acid exists as two enantiomers (mirror-image isomers), commonly denoted \"l\" (for \"levo\") and \"d\" (for \"dextro\"). The l isomer is the one most often encountered: it occurs naturally in many foods, and is one form (\"vitamer\") of vitamin C, an essential nutrient for humans and many animals."}}, {"canonical_name": "rhinoceros", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "rhinoceros", "book_id": "origin_of_species_darwin_1859", "name": "rhinoceros", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 4, "variants": ["rhinoceros"], "contexts": ["large herbivorous mammal", "large mammal, not destroyed by beasts of prey"]}, {"entity_id": "rhinoceros", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Rhinoceros", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Rhinoceros"], "contexts": ["animal with a single sex"]}, {"entity_id": "rhinoceros", "book_id": "kosmos_humboldt_1845", "name": "rhinoceros", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["rhinoceros"], "contexts": ["extant animal found as fossil"]}, {"entity_id": "rhinoceroses", "book_id": "kosmos_humboldt_1845", "name": "rhinoceroses", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["rhinoceroses"], "contexts": ["extant large mammal"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "rhinoceros", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Rhinoceros", "similarity": 0.89}, {"source_book": "origin_of_species_darwin_1859", "source_name": "rhinoceros", "target_book": "kosmos_humboldt_1845", "target_name": "rhinoceros", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "rhinoceros", "target_book": "kosmos_humboldt_1845", "target_name": "rhinoceroses", "similarity": 0.967}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Rhinoceros", "target_book": "kosmos_humboldt_1845", "target_name": "rhinoceros", "similarity": 0.89}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Rhinoceros", "target_book": "kosmos_humboldt_1845", "target_name": "rhinoceroses", "similarity": 0.915}], "id": 407, "stable_key": "clu_4b328dc0efcdb235", "ground_truth": {"modern_name": "Rhinoceros", "confidence": "high", "type": "animal", "wikidata_id": "Q134657", "wikidata_description": "genus of mammals", "wikipedia_url": "https://en.wikipedia.org/wiki/Rhinoceros%20%28genus%29", "wikipedia_extract": "A rhinoceros ( ry-NOSS-ə-rəss; from Ancient Greek  ῥινόκερως (rhinókerōs) 'nose-horned'; from  ῥίς (rhis) 'nose' and  κέρας (kéras) 'horn'; pl.: rhinoceros or rhinoceroses), commonly abbreviated to rhino, is a member of any of the five extant species (or numerous extinct species) of odd-toed ungulates (perissodactyls) in the family Rhinocerotidae. It is the only living family in the superfamily Rhinocerotoidea (whose members are also sometimes called rhinoceroses). Two of the extant species are native to Africa, and three to South and Southeast Asia. Rhinoceroses are some of the largest remaining megafauna: all weigh over half a tonne in adulthood. They have a herbivorous diet, small brains 400–600 g (14–21 oz) for mammals of their size, one or two horns, and a thick 1.5–5 cm (0.59–1.97 in), protective skin formed from layers of collagen positioned in a lattice structure. They generally eat leafy material, although their ability to ferment food in their hindgut allows them to subsist on more fibrous plant matter when necessary."}}, {"canonical_name": "Hematites", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "hematites", "book_id": "polyanthea_medicinal", "name": "Hematites", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["Hematites"], "contexts": ["stone used in a remedy", "hematite, a mineral used in a remedy"]}, {"entity_id": "hæmatites", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hæmatites", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Hæmatites"], "contexts": ["iron ore, adheres to lips", "iron ore with medicinal properties"]}, {"entity_id": "pegmatite", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pegmatite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["pegmatite"], "contexts": ["Type of igneous rock", "rock type, often mica-free"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Hematites", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Hæmatites", "similarity": 0.971}, {"source_book": "polyanthea_medicinal", "source_name": "Hematites", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "pegmatite", "similarity": 0.842}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hæmatites", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "pegmatite", "similarity": 0.867}], "id": 408, "stable_key": "clu_78023f787c1a4ead", "ground_truth": {"modern_name": "Hematite", "confidence": "high", "type": "mineral", "description": "A common iron oxide mineral, used in remedies and as a pigment.", "note": "While 'pegmatite' is a rock type, 'hematites' clearly points to the mineral hematite.", "wikipedia_extract": "Hematite (), also spelled as haematite, is a common iron oxide compound with the formula Fe2O3 and is widely found in rocks and soils. Hematite crystals belong to the rhombohedral lattice system which is designated the alpha polymorph of Fe2O3. It has the same crystal structure as corundum (Al2O3) and ilmenite (FeTiO3). With this crystal structure geometry it forms a complete solid solution at temperatures above 950 °C (1,740 °F). Hematite occurs naturally in black to steel or silver-gray, brown to reddish-brown, or red colors. It is mined as an important ore mineral of iron."}}, {"canonical_name": "Errors", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "errors", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Errors", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["errors", "Errors"], "contexts": ["mistakes or incorrect beliefs", "mistakes in reasoning or computation"]}, {"entity_id": "errors", "book_id": "principles_of_psychology_james_1890", "name": "errors", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["errors"], "contexts": ["mistakes in judgment or perception"]}, {"entity_id": "errores_de_imprensa", "book_id": "coloquios_da_orta_1563", "name": "errores de imprensa", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["errores de imprensa"], "contexts": ["printing errors"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Errors", "target_book": "principles_of_psychology_james_1890", "target_name": "errors", "similarity": 0.988}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Errors", "target_book": "coloquios_da_orta_1563", "target_name": "errores de imprensa", "similarity": 0.843}, {"source_book": "principles_of_psychology_james_1890", "source_name": "errors", "target_book": "coloquios_da_orta_1563", "target_name": "errores de imprensa", "similarity": 0.85}], "id": 409, "stable_key": "clu_55acdfece1a1d52f", "ground_truth": {"wikipedia_extract": "An error (from the Latin errāre, meaning 'to wander') is an inaccurate or incorrect action, thought, or judgement. In statistics, \"error\" refers to the difference between the value which has been computed and the correct value. An error could result in failure or in a deviation from the intended performance or behavior. One reference differentiates between \"error\" and \"mistake\" as follows: An 'error' is a deviation from accuracy or correctness. A 'mistake' is an error caused by a fault: the fault being misjudgment, carelessness, or forgetfulness. Now, say that I run a stop sign because I was in a hurry, and wasn't concentrating, and the police stop me, that is a mistake."}}, {"canonical_name": "Torpedo", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "torpedo", "book_id": "polyanthea_medicinal", "name": "Torpedo", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 3, "variants": ["Torpedo"], "contexts": ["fish that causes numbness", "an animal mentioned"]}, {"entity_id": "torpedoes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Torpedoes", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["Torpedoes"], "contexts": ["fish that deliver electric shock"]}, {"entity_id": "torpedo", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Torpedo", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["Torpedo"], "contexts": ["fish that stupifies when alive"]}, {"entity_id": "torpedo", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Torpedo", "category": "ANIMAL", "subcategory": "FISH", "count": 2, "variants": ["torpedo", "Torpedo"], "contexts": ["genus of ray with electrical action", "fish with electrical action"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Torpedo", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Torpedo", "similarity": 0.821}, {"source_book": "polyanthea_medicinal", "source_name": "Torpedo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Torpedo", "similarity": 0.821}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Torpedoes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Torpedo", "similarity": 0.976}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Torpedo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Torpedo", "similarity": 1.0}], "id": 410, "stable_key": "clu_e64ce097db1c1bed", "ground_truth": {"modern_name": "Electric ray", "confidence": "high", "type": "animal", "note": "The term 'Torpedo' in early modern texts often referred to electric rays (family Torpedinidae) known for their electric shock capabilities.", "wikidata_id": "Q41317", "wikidata_description": "order of fishes", "wikipedia_url": "https://en.wikipedia.org/wiki/Electric%20ray", "wikipedia_extract": "The electric rays are a group of rays, flattened cartilaginous fish with enlarged pectoral fins, composing the order Torpediniformes . They are known for being capable of producing an electric discharge, ranging from 8 to 220 volts, depending on species, used to stun prey and for defense. There are 69 species in four families. Perhaps the best known members are those of the genus Torpedo. The torpedo undersea weapon is named after it. The name comes from the Latin torpere, 'to be stiffened or paralyzed', from the effect on someone who touches the fish."}}, {"canonical_name": "Gunpowder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "gunpowder", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Gunpowder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Gunpowder"], "contexts": ["explosive mixture", "discovered causes of meteors"]}, {"entity_id": "gunpowder", "book_id": "connexion_physical_sciences_somerville_1858", "name": "gunpowder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["gunpowder"], "contexts": ["used by miners, source of heat"]}, {"entity_id": "gunpowder", "book_id": "first_principles_spencer_1862", "name": "gunpowder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["gunpowder"], "contexts": ["substance that explodes", "explosion causes propulsion of a bullet"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gunpowder", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gunpowder", "similarity": 0.99}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gunpowder", "target_book": "first_principles_spencer_1862", "target_name": "gunpowder", "similarity": 0.99}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "gunpowder", "target_book": "first_principles_spencer_1862", "target_name": "gunpowder", "similarity": 1.0}], "id": 411, "stable_key": "clu_b6990047befd8e58", "ground_truth": {"modern_name": "Gunpowder", "confidence": "high", "type": "chemical", "wikidata_id": "Q12861", "wikidata_description": "explosive most commonly used as propellant in firearms", "wikipedia_url": "https://en.wikipedia.org/wiki/Gunpowder", "wikipedia_extract": "Gunpowder, commonly referred to as black powder to distinguish it from modern smokeless powder, is the earliest known chemical explosive. It consists of a mixture of sulfur, charcoal (which is mostly carbon), and potassium nitrate (saltpeter). The sulfur and charcoal act as fuels, while the saltpeter is an oxidizer. Gunpowder has been widely used as a propellant in firearms, artillery, rocketry, and pyrotechnics, including use as a blasting agent for explosives in quarrying, mining, building pipelines, tunnels, and roads. Gunpowder is classified as a low explosive because of its relatively slow decomposition rate, low ignition temperature and consequently low brisance (breaking/shattering). Low explosives deflagrate—burning at subsonic speeds—whereas high explosives detonate, producing a supersonic shockwave."}}, {"canonical_name": "Nurses", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "nurses", "book_id": "english_physician_1652", "name": "Nurses", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 5, "variants": ["Nurses"], "contexts": ["people drinking herb-infused drink", "fennel good for them"]}, {"entity_id": "nurserymen", "book_id": "origin_of_species_darwin_1859", "name": "nurserymen", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["nurserymen"], "contexts": ["people who cultivate plants"]}, {"entity_id": "nurcino", "book_id": "polyanthea_medicinal", "name": "Nurcino", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["Nurcino"], "contexts": ["lithotomist surgeon"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Nurses", "target_book": "origin_of_species_darwin_1859", "target_name": "nurserymen", "similarity": 0.88}, {"source_book": "english_physician_1652", "source_name": "Nurses", "target_book": "polyanthea_medicinal", "target_name": "Nurcino", "similarity": 0.894}, {"source_book": "origin_of_species_darwin_1859", "source_name": "nurserymen", "target_book": "polyanthea_medicinal", "target_name": "Nurcino", "similarity": 0.883}], "id": 412, "stable_key": "clu_1b16c6c3d48d6357", "ground_truth": {"modern_name": "Nurses", "confidence": "medium", "type": "person", "description": "Individuals who care for the sick or infirm.", "note": "Includes both general nurses and potentially surgical practitioners like lithotomists.", "wikipedia_extract": "Nursing is a health care profession that \"integrates the art and science of caring and focuses on the protection, promotion, and optimization of health and human functioning; prevention of illness and injury; facilitation of healing; and alleviation of suffering through compassionate presence\". Nurses practice in many specialties with varying levels of certification and responsibility. Nurses comprise the largest component of most healthcare environments. There are shortages of qualified nurses in many countries. Nurses develop a plan of care, working collaboratively with physicians, therapists, patients, patients' families, and other team members that focuses on treating illness to improve quality of life. In the United Kingdom and the United States, clinical nurse specialists and nurse practitioners diagnose health problems and prescribe medications and other therapies, depending on regulations that vary by state."}}, {"canonical_name": "Strawberries", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "strawberries", "book_id": "english_physician_1652", "name": "Strawberries", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["Strawberries", "Strawberry Plant"], "contexts": ["plant with similar creeping strings", "fruit with medicinal properties"]}, {"entity_id": "strawberry", "book_id": "origin_of_species_darwin_1859", "name": "strawberry", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["strawberry"], "contexts": ["plant that began to vary when gardeners attended"]}, {"entity_id": "strawberry", "book_id": "kosmos_humboldt_1845", "name": "strawberry", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["strawberry"], "contexts": ["plant species in Himalaya"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Strawberries", "target_book": "origin_of_species_darwin_1859", "target_name": "strawberry", "similarity": 0.861}, {"source_book": "english_physician_1652", "source_name": "Strawberries", "target_book": "kosmos_humboldt_1845", "target_name": "strawberry", "similarity": 0.861}, {"source_book": "origin_of_species_darwin_1859", "source_name": "strawberry", "target_book": "kosmos_humboldt_1845", "target_name": "strawberry", "similarity": 1.0}], "id": 413, "stable_key": "clu_b7767aa8594ec966", "ground_truth": {"modern_name": "Strawberry", "confidence": "high", "type": "plant", "linnaean": "Fragaria x ananassa", "family": "Rosaceae", "description": "A creeping plant producing fruits with medicinal properties, subject to variation.", "note": "Common English name for the fruit and plant.", "wikipedia_extract": "The garden strawberry (or simply strawberry; Fragaria × ananassa) is a widely grown hybrid plant cultivated worldwide for its fruit. The genus Fragaria, the strawberries, is in the rose family, Rosaceae. The fruit is appreciated for its aroma, bright red colour, juicy texture, and sweetness. It is eaten either fresh or in prepared foods such as jam, ice cream, and chocolates. Artificial strawberry flavourings and aromas are widely used in commercial products. Botanically, the strawberry is not a berry, but an aggregate accessory fruit."}}, {"canonical_name": "Onions", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "onions", "book_id": "english_physician_1652", "name": "Onions", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["Onions"], "contexts": ["used as remedy", "well-known vegetable"]}, {"entity_id": "onion", "book_id": "origin_of_species_darwin_1859", "name": "onion", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["onion"], "contexts": ["variety of plant discussed for cross-pollination"]}, {"entity_id": "ononis", "book_id": "polyanthea_medicinal", "name": "Ononis", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Ononis"], "contexts": ["Rest Harrow plant", "plant with roots"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Onions", "target_book": "origin_of_species_darwin_1859", "target_name": "onion", "similarity": 0.882}, {"source_book": "english_physician_1652", "source_name": "Onions", "target_book": "polyanthea_medicinal", "target_name": "Ononis", "similarity": 0.855}], "id": 414, "stable_key": "clu_2a0dcd3a07ca699b", "ground_truth": {"modern_name": "Onions", "confidence": "high", "type": "plant", "linnaean": "Allium cepa", "family": "Amaryllidaceae", "description": "Common vegetable with a bulb, used for culinary and medicinal purposes.", "note": "Includes the common onion and potentially related species like Rest Harrow (Ononis).", "wikipedia_extract": "The onion (Allium cepa L.Tooltip Carl Linnaeus, from Latin cepa), also known as the bulb onion or common onion, is a vegetable that is the most widely cultivated species of the genus Allium. The shallot is a botanical variety of the onion which was classified as a separate species until 2011. The onion's close relatives include garlic, scallion, leek, and chives. The genus contains several other species variously called onions and cultivated for food, such as the Japanese bunching onion Allium fistulosum, the tree onion Allium × proliferum, and the Canada onion Allium canadense. The name wild onion is applied to a number of Allium species, but A. cepa is exclusively known from cultivation. Its ancestral wild original form is not known, although escapes from cultivation have become established in some regions."}}, {"canonical_name": "oranger", "category": "PLANT", "subcategory": "TREE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "oranger", "book_id": "relation_historique_humboldt_vol3_1825", "name": "oranger", "category": "PLANT", "subcategory": "TREE", "count": 5, "variants": ["oranger", "orangers", "orangers sauvages"], "contexts": ["orange tree", "orange tree wood used as fuel"]}, {"entity_id": "orange", "book_id": "english_physician_1652", "name": "Orange", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Orange"], "contexts": ["seed to balance coldness"]}, {"entity_id": "orange", "book_id": "principles_of_psychology_james_1890", "name": "orange", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["orange"], "contexts": ["citrus fruit"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "oranger", "target_book": "english_physician_1652", "target_name": "Orange", "similarity": 0.847}, {"source_book": "english_physician_1652", "source_name": "Orange", "target_book": "principles_of_psychology_james_1890", "target_name": "orange", "similarity": 0.854}], "id": 415, "stable_key": "clu_c713d012732b639b", "ground_truth": {"modern_name": "Orange tree", "confidence": "high", "type": "plant", "linnaean": "Citrus × sinensis", "family": "Rutaceae", "description": "Tree bearing citrus fruits, valued for fruit, wood, and medicinal properties.", "note": "Refers to the orange tree, not the planet or musician.", "wikipedia_extract": "Citrus × sinensis (sometimes written Citrus sinensis), is a broadleaf evergreen hybrid between pomelo (Citrus maxima) and mandarin (Citrus reticulata). Hybrid sweet oranges are commonly cultivated fruits that include Valencia oranges, blood oranges and navel oranges. The orange fruit is an important agricultural product, used for both the juicy fruit pulp and the aromatic peel (rind). Orange blossoms (the flowers) are used in several different ways, as are the leaves and wood of the tree. The orange blossom, which is the state flower of Florida, is highly fragrant and traditionally associated with good fortune. It has long been popular in bridal bouquets and head wreaths."}}, {"canonical_name": "escarros", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "escarros", "book_id": "polyanthea_medicinal", "name": "escarros", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["escarros"], "contexts": ["sputum", "expectoration"]}, {"entity_id": "eares", "book_id": "english_physician_1652", "name": "eares", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["eares"], "contexts": ["organs of hearing", "treated for worms with juice"]}, {"entity_id": "espiraes", "book_id": "coloquios_da_orta_1563", "name": "espiraes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["espiraes"], "contexts": ["spirals"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "escarros", "target_book": "english_physician_1652", "target_name": "eares", "similarity": 0.844}, {"source_book": "polyanthea_medicinal", "source_name": "escarros", "target_book": "coloquios_da_orta_1563", "target_name": "espiraes", "similarity": 0.856}], "id": 416, "stable_key": "clu_995eb49ce5a2af5e", "ground_truth": {"modern_name": "Sputum", "confidence": "high", "type": "substance", "description": "Mucus secreted by the respiratory system; expectorated matter.", "note": "This cluster contains terms related to expectoration and potentially anatomical terms for the ear.", "wikipedia_extract": "Sputum is mucus that is coughed up from the lower airways (the trachea and bronchi). In medicine, sputum samples are usually used for a naked-eye examination, microbiological investigation of respiratory infections, and cytological investigations of respiratory system. A naked eye exam of the sputum can be done at home by a patient in order to note the various colors (see below). Any hint of yellow or green color (pus) suggests an airway infection (but does not indicate the type of organism causing it). Such color hints are best detected when the sputum is viewed against a bright white background, such as white paper, a white pot, or a white sink surface. Having green, yellow, or thickened phlegm (sputum) does not always indicate the presence of an infection."}}, {"canonical_name": "Lepidosiren", "category": "ANIMAL", "subcategory": "FISH", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "lepidosiren", "book_id": "origin_of_species_darwin_1859", "name": "Lepidosiren", "category": "ANIMAL", "subcategory": "FISH", "count": 4, "variants": ["Lepidosiren"], "contexts": ["anomalous form connecting separated orders", "lungfish, transitional animal"]}, {"entity_id": "lepidosteus", "book_id": "kosmos_humboldt_1845", "name": "Lepidosteus", "category": "ANIMAL", "subcategory": "FISH", "count": 2, "variants": ["Lepidosteus"], "contexts": ["living representative of ancient fossil fishes", "extant fish genus"]}, {"entity_id": "lepidosiren", "book_id": "first_principles_spencer_1862", "name": "Lepidosiren", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["Lepidosiren"], "contexts": ["African animal torpid in dried mud"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Lepidosiren", "target_book": "kosmos_humboldt_1845", "target_name": "Lepidosteus", "similarity": 0.875}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Lepidosiren", "target_book": "first_principles_spencer_1862", "target_name": "Lepidosiren", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Lepidosteus", "target_book": "first_principles_spencer_1862", "target_name": "Lepidosiren", "similarity": 0.875}], "id": 417, "stable_key": "clu_880623261b2d6bab", "ground_truth": {"modern_name": "Lepidosiren", "confidence": "high", "type": "animal", "note": "Lepidosiren is a genus of lungfish. Lepidosteus refers to the genus Lepisosteus (gars).", "wikidata_id": "Q1410142", "wikidata_description": "species of chordates", "wikipedia_url": "https://en.wikipedia.org/wiki/South%20American%20lungfish", "wikipedia_extract": "The South American lungfish (Lepidosiren paradoxa), also known as the American mud-fish and scaly salamanderfish, is the single species of lungfish found in swamps and slow-moving waters of the Amazon, Paraguay, and lower Paraná River basins in South America. Notable as an obligate air-breather, it is the sole member of its family Lepidosirenidae, although some authors also place Protopterus in the family. In Brazil, it is known by the indigenous language Tupi name piramboia, which means \"snake-fish\" (Portuguese pronunciation: [piɾɐ̃ˈbɔjjɐ]), and synonyms pirarucu-bóia ([piɾɐɾuˈku ˈbɔjjɐ]), traíra-bóia ([tɾɐˈiɾɐ ˈbɔjjɐ]), and caramuru ([kɐɾɐmuˈɾu]). The South American lungfish is most closely related to the African lungfishes (family Protopteridae), and both families are thought to have diverged during the Early Cretaceous. Some papers suggest classifying both Lepidosiren and Protopterus within Lepidosirenidae, though authorities continue to classify both as distinct families. The immature lungfish is spotted with gold on a black background; in the adult, this fades to a brown or gray color."}}, {"canonical_name": "Quinine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "quinine", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Quinine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["quinine", "Quinine"], "contexts": ["source of fluorescent light", "solution producing fluorescence and dispersion"]}, {"entity_id": "quinine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "quinine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["quinine"], "contexts": ["supposed substance in Byrsonima Moureila"]}, {"entity_id": "quinine", "book_id": "principles_of_psychology_james_1890", "name": "quinine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["quinine"], "contexts": ["substance applied to tongue"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Quinine", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "quinine", "similarity": 0.93}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Quinine", "target_book": "principles_of_psychology_james_1890", "target_name": "quinine", "similarity": 0.93}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "quinine", "target_book": "principles_of_psychology_james_1890", "target_name": "quinine", "similarity": 1.0}], "id": 418, "stable_key": "clu_e04e05e36242d39b", "ground_truth": {"wikipedia_extract": "Quinine is a medication used to treat malaria and babesiosis. This includes the treatment of malaria due to Plasmodium falciparum that is resistant to chloroquine when artesunate is not available. While sometimes used for nocturnal leg cramps, quinine is not recommended for this purpose due to the risk of serious side effects. It can be taken by mouth or intravenously. Malaria resistance to quinine occurs in certain areas of the world. Quinine is also used as an ingredient in tonic water and other beverages to impart a bitter taste."}}, {"canonical_name": "Gênes", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "gênes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Gênes", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Gênes", "Gènes"], "contexts": ["city on the coast", "location of orange and bitter orange trees"]}, {"entity_id": "genoa", "book_id": "coloquios_da_orta_1563", "name": "Genoa", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Genoa"], "contexts": ["city where a stone is located"]}, {"entity_id": "geneve", "book_id": "polyanthea_medicinal", "name": "Geneve", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Geneve"], "contexts": ["city where Michael de Normandie was consul"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Gênes", "target_book": "coloquios_da_orta_1563", "target_name": "Genoa", "similarity": 0.851}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Gênes", "target_book": "polyanthea_medicinal", "target_name": "Geneve", "similarity": 0.858}, {"source_book": "coloquios_da_orta_1563", "source_name": "Genoa", "target_book": "polyanthea_medicinal", "target_name": "Geneve", "similarity": 0.864}], "id": 419, "stable_key": "clu_79a40e5c269f501a", "ground_truth": {"modern_name": "Genoa", "confidence": "high", "type": "place", "description": "Major port city in Italy, historically significant for trade and exploration.", "note": "Refers to the city of Genoa, also known historically as Gênes or Geneve in some texts.", "wikipedia_extract": "Genoa ( JEN-oh-ə; Italian: Genova [ˈdʒɛːnova] ; Ligurian: Zêna [ˈzeːna]) is the sixth-largest city in Italy and the capital of the Italian region of Liguria. As of 2025, 565,301 people live within the city's administrative limits. While its metropolitan city has 818,629 inhabitants, more than 1.5 million people live in the wider metropolitan area stretching along the Italian Riviera. On the Gulf of Genoa in the Ligurian Sea, Genoa has historically been one of the most important ports on the Mediterranean: it is the busiest port in Italy and in the Mediterranean Sea and twelfth-busiest in the European Union. Genoa was the capital of one of the most powerful maritime republics for over seven centuries, from the 11th century to 1797. Particularly from the 12th century to the 15th century, the city played a leading role in the history of commerce and trade in Europe, becoming one of the largest naval powers of the continent and considered among the wealthiest cities in the world."}}, {"canonical_name": "Kamtschatka", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "kamtschatka", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Kamtschatka", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Kamtschatka", "Kamlschatka"], "contexts": ["region in Siberia", "peninsula"]}, {"entity_id": "kamtschatka", "book_id": "kosmos_humboldt_1845", "name": "Kamtschatka", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Kamtschatka"], "contexts": ["peninsula with mountains", "peninsula in Russia"]}, {"entity_id": "kamtschatka", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Kamtschatka", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Kamtschatka"], "contexts": ["peninsula in Russia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Kamtschatka", "target_book": "kosmos_humboldt_1845", "target_name": "Kamtschatka", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Kamtschatka", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kamtschatka", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Kamtschatka", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kamtschatka", "similarity": 1.0}], "id": 420, "stable_key": "clu_9406b2da5822b310", "ground_truth": {"modern_name": "Kamchatka Peninsula", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q993", "wikidata_description": "peninsula in Eastern Russia between the Pacific Ocean and the Sea of Okhotsk", "wikipedia_url": "https://en.wikipedia.org/wiki/Kamchatka%20Peninsula", "wikipedia_extract": "The Kamchatka Peninsula (Russian: полуо́стров Камча́тка, romanized: poluóstrov Kamchátka, pronounced [pəlʊˈostrəf kɐmˈt͡ɕætkə], Ainu: Cupka) is a 1,250-kilometre-long (777 mi) peninsula in the Russian Far East, with an area of about 270,000 km2 (100,000 sq mi). The Sea of Okhotsk bounds the peninsula's western coastline, immediately offshore of the peninsula and below the Bering Sea runs the 9,600-metre-deep (31,496 ft) Kuril–Kamchatka Trench. Its eastern coastline is the Bering Sea, part of the Pacific Ocean. The Kamchatka Peninsula, the Commander Islands, and Karaginsky Island constitute Kamchatka Krai of the Russian Federation. The majority of the 322,079 inhabitants are ethnic Russians, with about 13,000 being Koryaks (2014). More than half of the population lives in Petropavlovsk-Kamchatsky (179,526 in 2010) and nearby Yelizovo (38,980)."}}, {"canonical_name": "Montpellier", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "montpellier", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Montpellier", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Montpellier"], "contexts": ["city for temperature comparison", "location of oscillation extent observations"]}, {"entity_id": "montpellier", "book_id": "kosmos_humboldt_1845", "name": "Montpellier", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Montpellier"], "contexts": ["city with mild winter temperature", "city with mean winter temperature"]}, {"entity_id": "montpellier", "book_id": "coloquios_da_orta_1563", "name": "Montpellier", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Montpellier"], "contexts": ["city in France"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Montpellier", "target_book": "kosmos_humboldt_1845", "target_name": "Montpellier", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Montpellier", "target_book": "coloquios_da_orta_1563", "target_name": "Montpellier", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Montpellier", "target_book": "coloquios_da_orta_1563", "target_name": "Montpellier", "similarity": 1.0}], "id": 421, "stable_key": "clu_420c5296b05af1ab", "ground_truth": {"modern_name": "Montpellier", "confidence": "high", "type": "place", "description": "City in southern France known for its university and climate.", "wikipedia_extract": "Montpellier (UK: ; US: ) is a city in southern France near the Mediterranean Sea. One of the largest urban centres in the region of Occitania, Montpellier is the prefecture of the department of Hérault. As of 2023, 310,240 people live in the city proper, while its metropolitan area has a population of 813,272 as of 2020. Montpellier is the third-largest French city near the Mediterranean coast, behind Marseille and Nice, and the seventh-largest city of France overall. The inhabitants are called Montpelliérains. In the Middle Ages, Montpellier was an important city of the Crown of Aragon (and was the birthplace of James I), and then of Majorca, before its sale to France in 1349."}}, {"canonical_name": "navigation", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "navigation", "book_id": "relation_historique_humboldt_vol3_1825", "name": "navigation", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 4, "variants": ["navigation"], "contexts": ["method of transport", "purpose of canal and rivers"]}, {"entity_id": "navegaçam", "book_id": "coloquios_da_orta_1563", "name": "navegaçam", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["navegaçam"], "contexts": ["act of sailing, navigation"]}, {"entity_id": "navegaçao_por_mar", "book_id": "polyanthea_medicinal", "name": "navegaçao por mar", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["navegaçao por mar", "navegãoosmares"], "contexts": ["activity causing sickness", "practice of sea navigation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "navigation", "target_book": "coloquios_da_orta_1563", "target_name": "navegaçam", "similarity": 0.892}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "navigation", "target_book": "polyanthea_medicinal", "target_name": "navegaçao por mar", "similarity": 0.878}, {"source_book": "coloquios_da_orta_1563", "source_name": "navegaçam", "target_book": "polyanthea_medicinal", "target_name": "navegaçao por mar", "similarity": 0.854}], "id": 422, "stable_key": "clu_890835175909acc5", "ground_truth": {"modern_name": "navigation", "confidence": "high", "type": "concept", "description": "The practice of determining one's position and planning and following a route.", "wikipedia_extract": "Navigation is a field of study that focuses on the process of monitoring and controlling the movement of a craft or vehicle from one place to another. The field of navigation includes four general categories: land navigation, marine navigation, aeronautic navigation, and space navigation. It is also the term of art used for the specialized knowledge used by navigators to perform navigation tasks. All navigational techniques involve locating the navigator's position compared to known locations or patterns. Navigation, in a broader sense, can refer to any skill or study that involves the determination of position and direction. In this sense, navigation includes orienteering and pedestrian navigation."}}, {"canonical_name": "Louis XIV", "category": "PERSON", "subcategory": "PATRON", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "louis_xiv", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Louis XIV", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["Louis XIV"], "contexts": ["commissioned canal construction", "Lorsque Louis XIV voulut embellir"]}, {"entity_id": "luiz_xiv", "book_id": "coloquios_da_orta_1563", "name": "Luiz XIV", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Luiz XIV"], "contexts": ["king of France, received ambassadors"]}, {"entity_id": "luis_xiv_", "book_id": "polyanthea_medicinal", "name": "Luis XIV.", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["Luis XIV.", "Luis XIV"], "contexts": ["King of France", "King of France who rewarded scholars"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Louis XIV", "target_book": "coloquios_da_orta_1563", "target_name": "Luiz XIV", "similarity": 0.928}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Louis XIV", "target_book": "polyanthea_medicinal", "target_name": "Luis XIV.", "similarity": 0.939}, {"source_book": "coloquios_da_orta_1563", "source_name": "Luiz XIV", "target_book": "polyanthea_medicinal", "target_name": "Luis XIV.", "similarity": 0.943}], "id": 423, "stable_key": "clu_d3dee68e749318ce", "ground_truth": {"modern_name": "Louis XIV", "confidence": "high", "type": "person", "description": "King of France, patron of arts and sciences and ambitious builder.", "wikipedia_extract": "Louis XIV (Louis-Dieudonné; 5 September 1638 – 1 September 1715), also known as Louis the Great (Louis le Grand [lwi lə ɡʁɑ̃]) or the Sun King (le Roi Soleil [lə ʁwa sɔlɛj]), was King of France from 1643 until his death in 1715. His reign lasted 72 years and 110 days, which is the longest of any monarch in history. An emblem of the age of absolutism in Europe, Louis XIV's legacy includes French colonial expansion, the conclusion of the Thirty Years' War involving the Habsburgs, and a controlling influence on the style of fine arts and architecture in France, including the transformation of the Palace of Versailles into a center of royal power and politics. Louis XIV's pageantry and opulence helped define the French Baroque style of art and architecture and promoted his image as supreme leader of France in the early modern period. Louis XIV began his personal rule of France in 1661 after the death of his chief minister Cardinal Mazarin. A believer in the divine right of kings, Louis XIV continued Louis XIII's work of creating a centralized state governed from a capital."}}, {"canonical_name": "tabaschir", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "tabaschir", "book_id": "coloquios_da_orta_1563", "name": "tabaschir", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["tabaschir", "tabasheer"], "contexts": ["siliceous concretion from bamboos", "substance from plants, similar to fireixos"]}, {"entity_id": "tabac_torcido", "book_id": "relation_historique_humboldt_vol3_1825", "name": "tabac torcido", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["tabac torcido"], "contexts": ["twisted tobacco exported", "rolled tobacco product"]}, {"entity_id": "tabaxir", "book_id": "ricettario_fiorentino_1597", "name": "Tabaxir", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Tabaxir"], "contexts": ["name for true Spodio from India", "a substance from the East"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "tabaschir", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "tabac torcido", "similarity": 0.843}, {"source_book": "coloquios_da_orta_1563", "source_name": "tabaschir", "target_book": "ricettario_fiorentino_1597", "target_name": "Tabaxir", "similarity": 0.913}], "id": 424, "stable_key": "clu_e8930a3165e61c67", "ground_truth": {"modern_name": "tabaschir", "confidence": "high", "type": "substance", "description": "Siliceous concretion found in bamboo, used medicinally.", "note": "Also referred to as 'tabac torcido' which is rolled tobacco, but the contexts point to the bamboo substance in other instances."}}, {"canonical_name": "aromi", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "aromi", "book_id": "ricettario_fiorentino_1597", "name": "aromi", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["aromi", "aroma"], "contexts": ["aromatic substances used in medicines", "aromatic substances used in trochisci"]}, {"entity_id": "olores", "book_id": "historia_medicinal_monardes_1574", "name": "olores", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["olores"], "contexts": ["odors"]}, {"entity_id": "aromas", "book_id": "polyanthea_medicinal", "name": "aromas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["aromas"], "contexts": ["fedores pareção aromas", "aromas"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "aromi", "target_book": "historia_medicinal_monardes_1574", "target_name": "olores", "similarity": 0.911}, {"source_book": "ricettario_fiorentino_1597", "source_name": "aromi", "target_book": "polyanthea_medicinal", "target_name": "aromas", "similarity": 0.969}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "olores", "target_book": "polyanthea_medicinal", "target_name": "aromas", "similarity": 0.944}], "id": 425, "stable_key": "clu_898326ea614f6f32", "ground_truth": {"modern_name": "aromas", "confidence": "high", "type": "concept", "description": "Pleasant or sweet smells; fragrances used in medicine.", "wikipedia_extract": "A fragrance compound (or fragrance) is a chemical compound with a pleasant odor. Fragrances affect only the sense of smell, whereas flavors can affect both the sense of taste and smell. Fragrances are often mixtures of individual fragrance compounds. Although many fragrances are derived from natural sources, many are synthetic. Fragrances are widely used in cosmetics and are the basis for a large industry. Stench compounds have unpleasant odors."}}, {"canonical_name": "Liverpool", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "liverpool", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Liverpool", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Liverpool"], "contexts": ["city in England", "port for voyages"]}, {"entity_id": "liverpool", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Liverpool", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Liverpool"], "contexts": ["home of Mr. Lassell"]}, {"entity_id": "liverpool", "book_id": "first_principles_spencer_1862", "name": "Liverpool", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Liverpool"], "contexts": ["Liverpool has assumed the office of importing cotton"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Liverpool", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Liverpool", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Liverpool", "target_book": "first_principles_spencer_1862", "target_name": "Liverpool", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Liverpool", "target_book": "first_principles_spencer_1862", "target_name": "Liverpool", "similarity": 1.0}], "id": 426, "stable_key": "clu_c2b4a49597ef3f70", "ground_truth": {"modern_name": "Liverpool", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q24826", "wikidata_description": "city in Merseyside, England, United Kingdom", "wikipedia_url": "https://en.wikipedia.org/wiki/Liverpool", "wikipedia_extract": "Liverpool is a port city and metropolitan borough in Merseyside, England. It is situated on the eastern side of the Mersey Estuary, near the Irish Sea, 178 miles (286 km) north-west of London. It had a population of 508,961 in 2024 and is the administrative, cultural and economic centre of the Liverpool City Region, a combined authority area with a population of over 1.5 million. Established as a borough in Lancashire in 1207, Liverpool became significant in the late 17th century when the Port of Liverpool was heavily involved in the Atlantic slave trade. The port also imported cotton for the Lancashire textile mills, and became a major departure point for English and Irish emigrants to North America. Liverpool rose to global economic importance at the forefront of the Industrial Revolution in the 19th century and was home to the first inter-city railway, the first non-combustible warehouse system (the Royal Albert Dock), and a pioneering elevated electrical railway; it was granted city status in 1880 and was moved from Lancashire to the newly created county of Merseyside in 1974."}}, {"canonical_name": "laboratory", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "laboratory", "book_id": "first_principles_spencer_1862", "name": "laboratory", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "count": 3, "variants": ["laboratory"], "contexts": ["place for scientific experiments", "place for artificial production of phenomena"]}, {"entity_id": "laboratory", "book_id": "principles_of_psychology_james_1890", "name": "laboratory", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "count": 2, "variants": ["laboratory"], "contexts": ["place for scientific experiments"]}, {"entity_id": "laboratories", "book_id": "principles_of_psychology_james_1890", "name": "laboratories", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "count": 1, "variants": ["laboratories"], "contexts": ["places for scientific experimentation"]}, {"entity_id": "laboratories", "book_id": "kosmos_humboldt_1845", "name": "laboratories", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "count": 1, "variants": ["laboratories"], "contexts": ["places for scientific experiments"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "laboratory", "target_book": "principles_of_psychology_james_1890", "target_name": "laboratory", "similarity": 1.0}, {"source_book": "first_principles_spencer_1862", "source_name": "laboratory", "target_book": "principles_of_psychology_james_1890", "target_name": "laboratories", "similarity": 0.971}, {"source_book": "first_principles_spencer_1862", "source_name": "laboratory", "target_book": "kosmos_humboldt_1845", "target_name": "laboratories", "similarity": 0.971}, {"source_book": "principles_of_psychology_james_1890", "source_name": "laboratory", "target_book": "kosmos_humboldt_1845", "target_name": "laboratories", "similarity": 0.971}, {"source_book": "principles_of_psychology_james_1890", "source_name": "laboratories", "target_book": "kosmos_humboldt_1845", "target_name": "laboratories", "similarity": 1.0}], "id": 427, "stable_key": "clu_c24f589cb88220ce", "ground_truth": {"modern_name": "laboratory", "confidence": "high", "type": "place", "wikidata_id": "Q483242", "wikidata_description": "facility that provides controlled conditions in which scientific or technological research, experiments, and measurement may be performed", "wikipedia_url": "https://en.wikipedia.org/wiki/Laboratory", "wikipedia_extract": "A laboratory (UK: ; US: ; colloquially lab) is a facility that provides controlled conditions in which scientific or technological research, experiments, and measurement may be performed. Laboratories are found in a variety of settings such as schools, universities, privately owned research institutions, corporate research and testing facilities, government regulatory and forensic investigation centers,  physicians' offices, clinics, hospitals, regional and national referral centers, and even occasionally personal residences. The organisation and contents of laboratories are determined by the differing requirements of the specialists working within. A physics laboratory might contain a particle accelerator or vacuum chamber, while a metallurgy laboratory could have apparatus for casting or refining metals or for testing their strength. A chemist or biologist might use a wet laboratory, while a psychologist's laboratory might be a room with one-way mirrors and hidden cameras in which to observe behavior. In some laboratories, such as those commonly used by computer scientists, computers (sometimes supercomputers) are used for either simulations or the analysis of data."}}, {"canonical_name": "tuning-fork", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "tuning-fork", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tuning-fork", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 4, "variants": ["tuning-fork"], "contexts": ["instrument for producing musical notes", "instrument producing specific musical notes"]}, {"entity_id": "tuning-fork", "book_id": "principles_of_psychology_james_1890", "name": "tuning-fork", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["tuning-fork"], "contexts": ["component of reaction timer"]}, {"entity_id": "tuning-forks", "book_id": "principles_of_psychology_james_1890", "name": "tuning-forks", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["tuning-forks"], "contexts": ["instrument for producing simple tones"]}, {"entity_id": "tuning-fork", "book_id": "first_principles_spencer_1862", "name": "tuning-fork", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["tuning-fork"], "contexts": ["instrument producing musical tones"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "tuning-fork", "target_book": "principles_of_psychology_james_1890", "target_name": "tuning-fork", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "tuning-fork", "target_book": "principles_of_psychology_james_1890", "target_name": "tuning-forks", "similarity": 0.988}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "tuning-fork", "target_book": "first_principles_spencer_1862", "target_name": "tuning-fork", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tuning-fork", "target_book": "first_principles_spencer_1862", "target_name": "tuning-fork", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tuning-forks", "target_book": "first_principles_spencer_1862", "target_name": "tuning-fork", "similarity": 0.988}], "id": 428, "stable_key": "clu_c9992595923a609e", "ground_truth": {"modern_name": "tuning fork", "confidence": "high", "type": "object", "wikidata_id": "Q201898", "wikidata_description": "device used to produce a fixed tone", "wikipedia_url": "https://en.wikipedia.org/wiki/Tuning%20fork", "wikipedia_extract": "A tuning fork is an acoustic resonator in the form of a two-pronged fork with the prongs (tines) formed from a U-shaped bar of elastic metal (usually steel). It resonates at a specific constant pitch when set vibrating by striking it against a surface or with an object, and emits a pure musical tone once the high overtones fade out. A tuning fork's pitch depends on the length and mass of the two prongs. They are traditional sources of standard pitch for tuning musical instruments. The tuning fork was invented in 1711 by British musician John Shore, sergeant trumpeter and lutenist to the royal court. A tuning fork is a fork-shaped acoustic resonator used in many applications to produce a fixed tone."}}, {"canonical_name": "vacuo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "vacuo", "book_id": "connexion_physical_sciences_somerville_1858", "name": "vacuo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["vacuo"], "contexts": ["space devoid of matter", "state of being empty of matter"]}, {"entity_id": "vaſos", "book_id": "polyanthea_medicinal", "name": "vaſos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["vaſos"], "contexts": ["vessels, likely blood vessels or lymphatics", "vessels, likely blood vessels"]}, {"entity_id": "in_vacuo", "book_id": "first_principles_spencer_1862", "name": "in vacuo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["in vacuo"], "contexts": ["in a vacuum, absence of matter"]}, {"entity_id": "vacuity", "book_id": "first_principles_spencer_1862", "name": "vacuity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vacuity"], "contexts": ["empty space"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "vacuo", "target_book": "polyanthea_medicinal", "target_name": "vaſos", "similarity": 0.864}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "vacuo", "target_book": "first_principles_spencer_1862", "target_name": "in vacuo", "similarity": 0.962}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "vacuo", "target_book": "first_principles_spencer_1862", "target_name": "vacuity", "similarity": 0.929}], "id": 429, "stable_key": "clu_e917e1d19a6bf9ae", "ground_truth": {"modern_name": "vacuum", "confidence": "high", "type": "concept", "note": "The term 'vásos' appears to be a corruption or variant of 'vasos' (vessels), which in a medical context could refer to blood vessels or lymphatics, or it might be a misreading of 'vacuo' or a related concept. However, the dominant context for 'vacuo' and 'in vacuo' points strongly to the physical concept of a vacuum.", "wikidata_id": "Q101674", "wikidata_description": "device that uses air to suck up dirt and other substances", "wikipedia_url": "https://en.wikipedia.org/wiki/Vacuum%20cleaner", "wikipedia_extract": "A vacuum (pl.: vacuums or vacua) is  space devoid of matter. The word is derived from the Latin adjective vacuus (neuter vacuum) meaning \"vacant\" or \"void\". An approximation to such vacuum is a region with a gaseous pressure much less than atmospheric pressure. Physicists often discuss ideal test results that would occur in a perfect vacuum, which they sometimes simply call \"vacuum\" or free space, and use the term partial vacuum to refer to an actual imperfect vacuum as one might have in a laboratory or in space. In engineering and applied physics on the other hand, vacuum refers to any space in which the pressure is considerably lower than atmospheric pressure. The Latin term in vacuo is used to describe an object that is surrounded by a vacuum."}}, {"canonical_name": "Perseus", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "perseus", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Perseus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Perseus"], "contexts": ["constellation through which circle would pass", "constellation with a variable star"]}, {"entity_id": "perseus", "book_id": "kosmos_humboldt_1845", "name": "Perseus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Perseus"], "contexts": ["constellation near meteor origin point", "point of origin for meteors"]}, {"entity_id": "persio", "book_id": "coloquios_da_orta_1563", "name": "persio", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["persio"], "contexts": ["language where 'adel' means justice", "language origin"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Perseus", "target_book": "kosmos_humboldt_1845", "target_name": "Perseus", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Perseus", "target_book": "coloquios_da_orta_1563", "target_name": "persio", "similarity": 0.864}, {"source_book": "kosmos_humboldt_1845", "source_name": "Perseus", "target_book": "coloquios_da_orta_1563", "target_name": "persio", "similarity": 0.864}], "id": 430, "stable_key": "clu_84197e3bd6d5b134", "ground_truth": {"modern_name": "Perseus", "confidence": "high", "type": "place", "note": "While 'Perseus' can refer to a mythological figure or a language, its context in scientific texts (astronomy, physical sciences) strongly suggests the constellation.", "wikipedia_extract": "In Greek mythology, Perseus (US:  , UK: ; Greek: Περσεύς, translit. Perseús) is the legendary founder of the Perseid dynasty. He was, alongside Cadmus and Bellerophon, the greatest Greek hero and slayer of monsters before the days of Heracles. He beheaded the Gorgon Medusa for Polydectes and saved Andromeda from the sea monster Cetus. He was a demigod, being the son of Zeus and the mortal Danaë, as well as the half-brother and great-grandfather of Heracles (as they were both children of Zeus, and Heracles's mother was Perseus's granddaughter). Because of the obscurity of the name \"Perseus\" and the legendary character of its bearer, most etymologists presume that it might be pre-Greek; however, the name of Perseus's native city was Greek and so were the names of his wife and relatives."}}, {"canonical_name": "dodo", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "dodo", "book_id": "kosmos_humboldt_1845", "name": "dodo", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["dodo"], "contexts": ["recently extinct bird", "extinct flightless bird"]}, {"entity_id": "dobode", "book_id": "polyanthea_medicinal", "name": "dobode", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["dobode"], "contexts": ["animal product with medicinal virtue"]}, {"entity_id": "doradus", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Doradus", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["Doradus"], "contexts": ["constellation with nebulous patches", "astronomical constellation"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "dodo", "target_book": "polyanthea_medicinal", "target_name": "dobode", "similarity": 0.862}, {"source_book": "kosmos_humboldt_1845", "source_name": "dodo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Doradus", "similarity": 0.851}], "id": 431, "stable_key": "clu_27ed9a6599f1a0e7", "ground_truth": {"modern_name": "dodo", "confidence": "low", "type": "animal", "note": "The mention of 'Doradus' (a constellation) and 'dobode' (potentially a misreading or obscure term) alongside 'dodo' makes this cluster ambiguous. The 'dodo' is well-documented, but the other terms introduce uncertainty.", "wikidata_id": "Q43502", "wikidata_description": "species of extinct bird native to Mauritius Island", "wikipedia_url": "https://en.wikipedia.org/wiki/Dodo", "wikipedia_extract": "The dodo (Raphus cucullatus) is an extinct flightless bird that was endemic to Mauritius,  an island east of Madagascar in the Indian Ocean. The dodo's closest relative was the also-extinct and flightless Rodrigues solitaire. The two formed the subtribe Raphina, a clade of extinct flightless birds that are a part of the group that includes pigeons and doves (the family Columbidae). The closest living relative of the dodo is the Nicobar pigeon. A white dodo was once thought to have existed on the nearby island of Réunion, but it is now believed that this assumption was merely confusion based on the also-extinct Réunion ibis and paintings of white dodos. Subfossil remains show the dodo measured about 62.6–75 centimetres (2.05–2.46 ft) in height and may have weighed 10.6–17.5 kg (23–39 lb) in the wild."}}, {"canonical_name": "juntas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "juntas", "book_id": "polyanthea_medicinal", "name": "juntas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["juntas"], "contexts": ["body parts, joints", "body joints"]}, {"entity_id": "juncturas", "book_id": "historia_medicinal_monardes_1574", "name": "juncturas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["juncturas", "junéturas"], "contexts": ["joints", "joints of the body"]}, {"entity_id": "junturas", "book_id": "coloquios_da_orta_1563", "name": "junturas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["junturas"], "contexts": ["ailment treated with cooked Raiz da china"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "juntas", "target_book": "historia_medicinal_monardes_1574", "target_name": "juncturas", "similarity": 0.849}, {"source_book": "polyanthea_medicinal", "source_name": "juntas", "target_book": "coloquios_da_orta_1563", "target_name": "junturas", "similarity": 0.867}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "juncturas", "target_book": "coloquios_da_orta_1563", "target_name": "junturas", "similarity": 0.977}], "id": 432, "stable_key": "clu_7f4ade4e4f587696", "ground_truth": {"modern_name": "joints", "confidence": "high", "type": "concept", "description": "The points where two bones meet; connections in the body.", "wikipedia_extract": "A joint or articulation (or articular surface) is the connection made between bones, ossicles, or other hard structures in the body which link an animal's skeletal system into a functional whole. They are constructed to allow for different degrees and types of movement. Some joints, such as the knee, elbow, and shoulder, are self-lubricating, almost frictionless, and are able to withstand compression and maintain heavy loads while still executing smooth and precise movements. Other joints such as sutures between the bones of the skull permit very little movement (only during birth) in order to protect the brain and the sense organs. The connection between a tooth and the jawbone is also called a joint, and is described as a fibrous joint known as a gomphosis. Joints are classified both structurally and functionally."}}, {"canonical_name": "nero", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "nero", "book_id": "ricettario_fiorentino_1597", "name": "nero", "category": "CONCEPT", "subcategory": "QUALITY", "count": 3, "variants": ["nero", "Nero"], "contexts": ["type of hellebore root", "substance used in preparations"]}, {"entity_id": "negro_lúcido", "book_id": "coloquios_da_orta_1563", "name": "negro lúcido", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["negro lúcido"], "contexts": ["color description"]}, {"entity_id": "negra", "book_id": "polyanthea_medicinal", "name": "negra", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["negra"], "contexts": ["black color", "color description"]}, {"entity_id": "negros", "book_id": "polyanthea_medicinal", "name": "negros", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["negros"], "contexts": ["skin color"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "nero", "target_book": "coloquios_da_orta_1563", "target_name": "negro lúcido", "similarity": 0.855}, {"source_book": "ricettario_fiorentino_1597", "source_name": "nero", "target_book": "polyanthea_medicinal", "target_name": "negra", "similarity": 0.939}, {"source_book": "ricettario_fiorentino_1597", "source_name": "nero", "target_book": "polyanthea_medicinal", "target_name": "negros", "similarity": 0.904}, {"source_book": "coloquios_da_orta_1563", "source_name": "negro lúcido", "target_book": "polyanthea_medicinal", "target_name": "negra", "similarity": 0.889}, {"source_book": "coloquios_da_orta_1563", "source_name": "negro lúcido", "target_book": "polyanthea_medicinal", "target_name": "negros", "similarity": 0.885}], "id": 433, "stable_key": "clu_744b2f497061e19d", "ground_truth": {"modern_name": "black", "confidence": "high", "type": "concept", "description": "A color, the darkest color, resulting from the absence of light.", "wikipedia_extract": "Black is a color that results from the absence or complete absorption of visible light. It is an achromatic color, without chroma, like white and grey. It is often used symbolically or figuratively to represent darkness. Black and white have often been used to describe opposites such as good and evil, the Dark Ages versus the Age of Enlightenment, and night versus day. Since the Middle Ages, black has been the symbolic color of solemnity and authority, and for this reason it is still commonly worn by judges and magistrates. Black was one of the first colors used by artists in Neolithic cave paintings."}}, {"canonical_name": "Aconites", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "aconites", "book_id": "english_physician_1652", "name": "Aconites", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Aconites", "Aconite", "Aconitum"], "contexts": ["poisonous plant", "poisonous plant, likely monkshood"]}, {"entity_id": "aconite", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Aconite", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Aconite"], "contexts": ["poisonous plant"]}, {"entity_id": "aconitum", "book_id": "coloquios_da_orta_1563", "name": "Aconitum", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Aconitum"], "contexts": ["genus of a poisonous plant"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Aconites", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Aconite", "similarity": 0.885}, {"source_book": "english_physician_1652", "source_name": "Aconites", "target_book": "coloquios_da_orta_1563", "target_name": "Aconitum", "similarity": 0.88}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Aconite", "target_book": "coloquios_da_orta_1563", "target_name": "Aconitum", "similarity": 0.84}], "id": 434, "stable_key": "clu_8c78f581e802e66a", "ground_truth": {"modern_name": "Aconitum", "confidence": "high", "type": "plant", "linnaean": "Aconitum", "family": "Ranunculaceae", "wikidata_id": "Q155904", "wikidata_description": "genus of flowering plants in the buttercup family Ranunculaceae", "wikipedia_url": "https://en.wikipedia.org/wiki/Aconitum", "wikipedia_extract": "Aconitum (), also known as aconite, monkshood, wolfsbane, leopard's bane, devil's helmet, or blue rocket, is a genus of over 250 species of flowering plants belonging to the family Ranunculaceae. These herbaceous, frequently toxic perennial plants are chiefly native to the mountainous parts of the Northern Hemisphere in North America, Europe, and Asia, growing in the moisture-retentive but well-draining soils of mountain meadows. Most Aconitum species are extremely poisonous and must be handled very carefully. Several Aconitum hybrids, such as the Arendsii form of Aconitum carmichaelii, have won gardening awards—such as the Royal Horticultural Society's Award of Garden Merit. The name aconitum comes from the Greek word ἀκόνιτον, which may derive from the Greek akon for dart or javelin, the tips of which were poisoned with the substance, or from akonae, because of the rocky ground on which the plant was thought to grow. The Greek name lycoctonum, which translates literally to \"wolf's bane\", is thought to indicate the use of its juice to poison arrows or baits used to kill wolves."}}, {"canonical_name": "Wales", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "wales", "book_id": "english_physician_1652", "name": "Wales", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Wales", "wales"], "contexts": ["country where Bishops-weed grows wild", "country"]}, {"entity_id": "wales", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Wales", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Wales"], "contexts": ["location with portable leather boats"]}, {"entity_id": "wales", "book_id": "origin_of_species_darwin_1859", "name": "Wales", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Wales"], "contexts": ["country with scored mountains from ice", "mountains with scored flanks and polished surfaces"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Wales", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Wales", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Wales", "target_book": "origin_of_species_darwin_1859", "target_name": "Wales", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Wales", "target_book": "origin_of_species_darwin_1859", "target_name": "Wales", "similarity": 1.0}], "id": 435, "stable_key": "clu_2455f0e1c8092419", "ground_truth": {"modern_name": "Wales", "confidence": "high", "type": "place", "description": "A country forming part of the United Kingdom.", "wikipedia_extract": "Wales (Welsh: Cymru [ˈkəmrɨ] ) is a country that is part of the United Kingdom. Located on the island of Great Britain, it is bordered by the Irish Sea to the north and west, England to the east, the Bristol Channel to the south, and the Celtic Sea to the south-west. As of 2021, it had a population of 3.2 million. It has a total area of 21,218 square kilometres (8,192 sq mi) and over 2,700 kilometres (1,680 mi) of coastline. It is largely mountainous with its higher peaks in the north and central areas, including Snowdon (Yr Wyddfa), its highest summit. The country lies within the north temperate zone and has a changeable, maritime climate."}}, {"canonical_name": "Gnats", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "gnats", "book_id": "english_physician_1652", "name": "Gnats", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 4, "variants": ["Gnats"], "contexts": ["creatures driven away by fern smoke", "insects repelled by smoke"]}, {"entity_id": "gnats", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Gnats", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["Gnats"], "contexts": ["insects indicating common corruption"]}, {"entity_id": "gnat", "book_id": "principles_of_psychology_james_1890", "name": "gnat", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["gnat"], "contexts": ["insect with rapid wing movements"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Gnats", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Gnats", "similarity": 0.864}, {"source_book": "english_physician_1652", "source_name": "Gnats", "target_book": "principles_of_psychology_james_1890", "target_name": "gnat", "similarity": 0.823}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gnats", "target_book": "principles_of_psychology_james_1890", "target_name": "gnat", "similarity": 0.965}], "id": 436, "stable_key": "clu_cd3f87bda268687e", "ground_truth": {"modern_name": "Gnat", "confidence": "high", "type": "animal", "family": "Culicidae", "description": "Small, biting flying insects, often found near water.", "note": "The singular 'Gnat' is the correct modern identification.", "wikipedia_extract": "A gnat ()  (also knat) is any of many species of tiny flying insects in the dipterid suborder Nematocera, especially those in the families Mycetophilidae, Anisopodidae and Sciaridae. Most often they fly in large numbers, called clouds. \"Gnat\" is a loose descriptive category rather than a phylogenetic or other technical term, so there is no scientific consensus on what constitutes a gnat. Some entomologists consider only non-biting flies to be gnats. Certain universities and institutes also distinguish eye gnats: the Smithsonian Institution describes them as \"non-biting flies, no bigger than a few grains of salt, ... attracted to fluids secreted by your eyes\". As nematoceran flies, adult gnats have antennae with at least six segments that are often long and slender. They are generally slender-bodied with long and narrow wings."}}, {"canonical_name": "liverworts", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "liverworts", "book_id": "kosmos_humboldt_1845", "name": "liverworts", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["liverworts"], "contexts": ["plant type in ancient forests", "plants with reproductive organs"]}, {"entity_id": "liverwort", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Liverwort", "category": "PLANT", "subcategory": "HERB", "count": 1, "variants": ["Liverwort"], "contexts": ["plant with trifoliate leaves"]}, {"entity_id": "liverwort", "book_id": "english_physician_1652", "name": "Liverwort", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Liverwort"], "contexts": ["plant growing in moist places"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "liverworts", "target_book": "english_physician_1652", "target_name": "Liverwort", "similarity": 0.814}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Liverwort", "target_book": "english_physician_1652", "target_name": "Liverwort", "similarity": 0.887}], "id": 437, "stable_key": "clu_5a53fa928f7160bd", "ground_truth": {"modern_name": "liverwort", "confidence": "high", "type": "plant", "linnaean": "Marchantiopsida", "family": "Marchantiaceae", "note": "The early modern term 'liverwort' encompasses various plants now classified under different orders and families within the division Bryophyta. Marchantiopsida is a broad class that includes the most common forms referred to by this name historically. The specific family is harder to pinpoint without more context, but Marchantiaceae is a representative example.", "wikidata_id": "Q161050", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Anemone%20hepatica", "wikipedia_extract": "Marchantiopsida is a class of liverworts within the phylum Marchantiophyta. The species in this class are known as complex thalloid liverworts. The species in this class are widely distributed and can be found worldwide. Complex oil bodies are only found in the gametophyte. Marchantiidae Engl. 1893 sensu He-Nygrén et al. 2006 Marchantiales Limpr. 1877 (complex thalloids) Aytoniaceae Cavers 1911  [Rebouliaceae; Grimaldiaceae] Conocephalaceae Müll.Frib. ex Grolle 1972 Cyathodiaceae Stotler & Crand.-Stotl. 2000 Exormothecaceae Müll.Frib."}}, {"canonical_name": "Partridge", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "partridge", "book_id": "origin_of_species_darwin_1859", "name": "Partridge", "category": "ANIMAL", "subcategory": "BIRD", "count": 3, "variants": ["partridge", "Partridge"], "contexts": ["terrestrial bird", "bird from which earth was collected"]}, {"entity_id": "partridges", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Partridges", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Partridges"], "contexts": ["birds whose eggs hatch under a hen"]}, {"entity_id": "partridges", "book_id": "origin_of_species_darwin_1859", "name": "partridges", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["partridges"], "contexts": ["game birds"]}, {"entity_id": "partridge", "book_id": "first_principles_spencer_1862", "name": "partridge", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["partridge"], "contexts": ["bird found in fields"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Partridge", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Partridges", "similarity": 0.98}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Partridge", "target_book": "first_principles_spencer_1862", "target_name": "partridge", "similarity": 0.984}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Partridges", "target_book": "origin_of_species_darwin_1859", "target_name": "partridges", "similarity": 0.982}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Partridges", "target_book": "first_principles_spencer_1862", "target_name": "partridge", "similarity": 0.969}, {"source_book": "origin_of_species_darwin_1859", "source_name": "partridges", "target_book": "first_principles_spencer_1862", "target_name": "partridge", "similarity": 0.982}], "id": 438, "stable_key": "clu_a473fb13e56fbc66", "ground_truth": {"modern_name": "partridge", "confidence": "high", "type": "animal", "wikidata_id": "Q93235", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Vaccinium%20vitis-idaea", "wikipedia_extract": "A partridge is a medium-sized galliform bird in any of several genera, with a wide native distribution throughout parts of Europe, Asia and Africa. Several species have been introduced to the Americas. They are sometimes grouped in the Perdicinae subfamily of the Phasianidae (pheasants, quail, etc.). However, molecular research suggests that partridges are not a distinct taxon within the superfamily Phasianoidea, but that some species are closer to the pheasants, while others are closer to the junglefowl. Partridges are medium-sized game birds, generally intermediate in size between the larger pheasants and smaller quail; they're ground-dwelling birds that feature variable plumage colouration across species, with most tending to grey and brown. Partridges are native to Europe, Asia, Africa, and the Middle East."}}, {"canonical_name": "Fear", "category": "CONCEPT", "subcategory": "PSYCHOLOGICAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "fear", "book_id": "origin_of_species_darwin_1859", "name": "Fear", "category": "CONCEPT", "subcategory": "PSYCHOLOGICAL", "count": 3, "variants": ["Fear", "fear"], "contexts": ["emotional response to danger", "birds acquiring"]}, {"entity_id": "fear", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "fear", "category": "CONCEPT", "subcategory": "MENTAL_FACULTY", "count": 1, "variants": ["fear"], "contexts": ["emotion of apprehension"]}, {"entity_id": "fear", "book_id": "kosmos_humboldt_1845", "name": "fear", "category": "CONCEPT", "subcategory": "MENTAL_FACULTY", "count": 2, "variants": ["fear"], "contexts": ["emotional response to perceived threat", "emotion of apprehension"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Fear", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "fear", "similarity": 0.866}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Fear", "target_book": "kosmos_humboldt_1845", "target_name": "fear", "similarity": 0.866}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fear", "target_book": "kosmos_humboldt_1845", "target_name": "fear", "similarity": 1.0}], "id": 439, "stable_key": "clu_9b305e6e53dd4854", "ground_truth": {"modern_name": "fear", "confidence": "high", "type": "concept", "wikidata_id": "Q37151346", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Fear%20%28surname%29", "wikipedia_extract": "Fear is an unpleasant subjective emotional state arising in response to perceived dangers or threats and which, when experienced, is typically associated with physiological and psychological changes. These changes frequently lead to behavioral reactions such as fight-or-flight responses or, in extreme cases, immobilization (freeze response). Unlike most (perhaps all) other animals, humans can experience fear in response to a present or anticipated stimulus and to imagined events. Most internalizing psychopathologies (depression, anxiety, suicidal thoughts and behaviors, and so forth) are associated with and maintained by dysfunctional, anxious, or fearful feelings and thoughts. Phobias, or exaggerated and often disabling fears, are usually similarly dysfunctional. Fear is often framed as a distinct product of evolution."}}, {"canonical_name": "Drake", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "drake", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Drake", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Drake"], "contexts": ["performed voyage about the Earth", "performed voyage around the Earth"]}, {"entity_id": "drake", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Drake", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Drake"], "contexts": ["explorer", "author"]}, {"entity_id": "drake", "book_id": "kosmos_humboldt_1845", "name": "Drake", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Drake"], "contexts": ["author cited in footnote", "reported earth shaking"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Drake", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Drake", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Drake", "target_book": "kosmos_humboldt_1845", "target_name": "Drake", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Drake", "target_book": "kosmos_humboldt_1845", "target_name": "Drake", "similarity": 1.0}], "id": 440, "stable_key": "clu_91748bd920dfd987", "ground_truth": {"modern_name": "Sir Francis Drake", "confidence": "high", "type": "person", "birth_year": 1540, "death_year": 1596, "description": "English explorer, sea captain, and privateer who circumnavigated the globe.", "note": "While 'Drake' could refer to other individuals, the context of voyages and exploration strongly points to Sir Francis Drake. The text 'pseudodoxia_epidemica_browne_1646' is known to discuss historical figures.", "wikidata_id": "Q36517", "wikidata_description": "English sailor and privateer (c. 1540 – 1596)", "wikipedia_url": "https://en.wikipedia.org/wiki/Francis%20Drake", "wikipedia_extract": "Sir Francis Drake (c. 1540 – 28 January 1596) was an English explorer and privateer best known for making the second circumnavigation of the world in a single expedition between 1577 and 1580 (being the first English expedition to accomplish this). He is also known for participating in the early English slaving voyages of his cousin,  John Hawkins, and John Lovell. Having started as a simple seaman, in 1588 he was part of the fight against the Spanish Armada as a vice admiral. At an early age, Drake was placed into the household of a relative, William Hawkins, a prominent sea captain in Plymouth. In 1572, he set sail on his first independent mission, privateering along the Spanish Main. Drake's circumnavigation began on 15 December 1577."}}, {"canonical_name": "Grylli", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "grylli", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Grylli", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["Grylli"], "contexts": ["insects with sharper hearing than humans", "supposed delicate sense of hearing in"]}, {"entity_id": "gryphins", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Gryphins", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Gryphins"], "contexts": ["mythological creatures mentioned by poets"]}, {"entity_id": "gralha", "book_id": "polyanthea_medicinal", "name": "Gralha", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["Gralha"], "contexts": ["part of a remedy"]}, {"entity_id": "grilos", "book_id": "polyanthea_medicinal", "name": "grilos", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["grilos"], "contexts": ["crickets"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Grylli", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Gryphins", "similarity": 0.868}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Grylli", "target_book": "polyanthea_medicinal", "target_name": "Gralha", "similarity": 0.843}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Grylli", "target_book": "polyanthea_medicinal", "target_name": "grilos", "similarity": 0.853}], "id": 441, "stable_key": "clu_f5db89ca52da24a0", "ground_truth": {"modern_name": "crickets", "confidence": "medium", "type": "animal", "note": "The term 'Grylli' and 'grilos' clearly refer to crickets. 'Gralha' in Portuguese can refer to a crow or jay, but in a medicinal context alongside 'grilos' it's likely a misinterpretation or refers to a specific folk remedy. 'Gryphins' is likely an OCR error or a variant spelling for a mythological creature, but the primary strong signal is 'crickets'.", "wikidata_id": "Q3776776", "wikidata_description": "common name of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Cricket%20%28insect%29", "wikipedia_extract": "Crickets are orthopteran insects which are related to bush crickets and, more distantly, to grasshoppers. In older literature, such as Imms, \"crickets\" were placed at the family level (i.e. Gryllidae), but contemporary authorities including Otte now place them in the superfamily Grylloidea. The word has been used in combination to describe more distantly related taxa in the suborder Ensifera, such as king crickets and mole crickets. Crickets have mainly cylindrically shaped bodies, round heads, and long antennae. Behind the head is a smooth, robust pronotum."}}, {"canonical_name": "Chypre", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "chypre", "book_id": "coloquios_da_orta_1563", "name": "Chypre", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Chypre"], "contexts": ["island country", "island where plants were seen"]}, {"entity_id": "chypre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Chypre", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Chypre"], "contexts": ["island with serpentine and diorite"]}, {"entity_id": "chypre", "book_id": "polyanthea_medicinal", "name": "Chypre", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Chypre", "Chipre"], "contexts": ["origin of acaparo", "source of Caparrofa"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Chypre", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Chypre", "similarity": 0.834}, {"source_book": "coloquios_da_orta_1563", "source_name": "Chypre", "target_book": "polyanthea_medicinal", "target_name": "Chypre", "similarity": 0.834}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Chypre", "target_book": "polyanthea_medicinal", "target_name": "Chypre", "similarity": 1.0}], "id": 442, "stable_key": "clu_d867f8cabe5b6a7d", "ground_truth": {"modern_name": "Cyprus", "confidence": "high", "type": "place", "description": "Island country known for its plants and mineral resources.", "note": "Refers to the island of Cyprus.", "wikipedia_extract": "Cyprus, officially the Republic of Cyprus, is an island country in the eastern Mediterranean Sea, located off the coast of the Levant in West Asia. Cyprus’ capital is Nicosia, while its largest municipality is Limassol. The northeast portion of the island is occupied by Turkey, which is separated from the Republic of Cyprus by the United Nations Buffer Zone. In the south of the island of Cyprus are the British sovereign military bases of Akrotiri and Dhekelia. The island is the third largest and third most populous in the Mediterranean, after Sicily and Sardinia. Cyprus was first settled by hunter-gatherers around 13,000 years ago, with farming communities emerging by 8500 BC."}}, {"canonical_name": "Brazavolus", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "brazavolus", "book_id": "polyanthea_medicinal", "name": "Brazavolus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["Brazavolus", "Brazavol.", "Brazavola", "Braſavolus"], "contexts": ["ancient medical authority cited", "cited author of medical text"]}, {"entity_id": "brasavolus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Brasavolus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Brasavolus"], "contexts": ["ancient authority, affirmed crystal is ice"]}, {"entity_id": "brasavolo", "book_id": "historia_medicinal_monardes_1574", "name": "Brasavolo", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Brasavolo"], "contexts": ["authority on morbus gallicus and iron"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Brazavolus", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Brasavolus", "similarity": 0.953}, {"source_book": "polyanthea_medicinal", "source_name": "Brazavolus", "target_book": "historia_medicinal_monardes_1574", "target_name": "Brasavolo", "similarity": 0.901}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Brasavolus", "target_book": "historia_medicinal_monardes_1574", "target_name": "Brasavolo", "similarity": 0.934}], "id": 443, "stable_key": "clu_60633d0149b1b07e", "ground_truth": {"modern_name": "Matthiolus", "confidence": "high", "type": "person", "description": "Italian physician and botanist, influential in medicine and botany.", "note": "The original canonical name 'Brazavolus' appears to be a misspelling or variant of Italian physician Andrea Matthioli (Lodovico Brazzavola was a contemporary physician, but Matthiolus is more likely given the context of classical medical authority).", "wikipedia_extract": "Pietro Andrea Gregorio Mattioli (Italian: [ˈpjɛːtro anˈdrɛːa ɡreˈɡɔːrjo matˈtjɔːli]; 12 March 1501– c. 1578) was a doctor and naturalist born in Siena. His most important work was a commentary on the medicinal plants of Pedanius Dioscorides first published in 1544 which was translated into several languages and went into thirteen editions in his lifetime. Mattioli was born in Siena to physician Francesco and his wife Lucrezia Buoninsegna. Although belonging to the city elite, the family was economically stressed, with thirteen children. His early studies are unknown but he may have studied in Venice, Siena, and Padua before he received his MD at the University of Padua in 1523, and subsequently practiced the profession in Siena, Rome, Trento and Gorizia, becoming personal physician of Ferdinand II, Archduke of Further Austria in Prague and Ambras Castle, and of Maximilian II, Holy Roman Emperor in Vienna. In 1527 he moved to Trent in the Val di Non."}}, {"canonical_name": "asp", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "asp", "book_id": "polyanthea_medicinal", "name": "asp", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 4, "variants": ["asp"], "contexts": ["venomous creature", "asp, snake"]}, {"entity_id": "asp", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Asp", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["Asp"], "contexts": ["type of serpent mentioned in scripture"]}, {"entity_id": "aspidas", "book_id": "coloquios_da_orta_1563", "name": "Aspidas", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["Aspidas"], "contexts": ["snakes fought by the animal"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "asp", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Asp", "similarity": 0.811}, {"source_book": "polyanthea_medicinal", "source_name": "asp", "target_book": "coloquios_da_orta_1563", "target_name": "Aspidas", "similarity": 0.823}], "id": 444, "stable_key": "clu_d62defbfbaa2af61", "ground_truth": {"modern_name": "asp", "confidence": "high", "type": "animal", "description": "A venomous snake, often depicted as a threat.", "wikipedia_extract": "Snakes are elongated limbless reptiles of the suborder Serpentes. Cladistically squamates, snakes are ectothermic, amniote vertebrates covered in overlapping scales much like other members of the group. Many species of snakes have skulls with several more joints than their lizard ancestors and relatives, enabling them to swallow prey much larger than their heads (cranial kinesis). To accommodate their narrow bodies, snakes' paired organs (such as kidneys) appear one in front of the other instead of side by side, and most only have one functional lung. Some species retain a pelvic girdle with a pair of vestigial claws on either side of the cloaca. Lizards have independently evolved elongate bodies without limbs or with greatly reduced limbs at least twenty-five times via convergent evolution, leading to many lineages of legless lizards."}}, {"canonical_name": "Rats", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "rats", "book_id": "english_physician_1652", "name": "Rats", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 3, "variants": ["Rats"], "contexts": ["larger rodents", "vermin repelled by Wormwood ink"]}, {"entity_id": "ratos", "book_id": "coloquios_da_orta_1563", "name": "ratos", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["ratos"], "contexts": ["vermin killed by domestic creatures"]}, {"entity_id": "rato", "book_id": "polyanthea_medicinal", "name": "Rato", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 2, "variants": ["Rato", "rato"], "contexts": ["animal seen by mother, affecting child", "animal whose ash dries salivation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Rats", "target_book": "coloquios_da_orta_1563", "target_name": "ratos", "similarity": 0.958}, {"source_book": "english_physician_1652", "source_name": "Rats", "target_book": "polyanthea_medicinal", "target_name": "Rato", "similarity": 0.904}, {"source_book": "coloquios_da_orta_1563", "source_name": "ratos", "target_book": "polyanthea_medicinal", "target_name": "Rato", "similarity": 0.906}], "id": 445, "stable_key": "clu_07c2d69e3b600380", "ground_truth": {"modern_name": "Rats", "confidence": "high", "type": "animal", "description": "Vermin, larger rodents, sometimes seen as pests or omens.", "wikipedia_extract": "Rats are various medium-sized, long-tailed rodents. Species of rats are found throughout the order Rodentia, but stereotypical rats are found in the genus Rattus. Other rat genera include Neotoma (pack rats), Bandicota (bandicoot rats) and Dipodomys (kangaroo rats). Rats are typically distinguished from mice by their size. Usually the common name of a large muroid rodent will include the word \"rat\", while a smaller muroid's name will include \"mouse\". The common terms rat and mouse are not taxonomically specific."}}, {"canonical_name": "Pontus", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "pontus", "book_id": "english_physician_1652", "name": "Pontus", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Pontus"], "contexts": ["King of Pontus", "ancient kingdom"]}, {"entity_id": "ponto", "book_id": "coloquios_da_orta_1563", "name": "Ponto", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Ponto"], "contexts": ["location of açaroro according to Pliny", "geographic region"]}, {"entity_id": "ponto", "book_id": "ricettario_fiorentino_1597", "name": "Ponto", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Ponto"], "contexts": ["region known for wax", "region where Sinope was located"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Pontus", "target_book": "coloquios_da_orta_1563", "target_name": "Ponto", "similarity": 0.98}, {"source_book": "english_physician_1652", "source_name": "Pontus", "target_book": "ricettario_fiorentino_1597", "target_name": "Ponto", "similarity": 0.98}, {"source_book": "coloquios_da_orta_1563", "source_name": "Ponto", "target_book": "ricettario_fiorentino_1597", "target_name": "Ponto", "similarity": 1.0}], "id": 446, "stable_key": "clu_867e8628d836a460", "ground_truth": {"modern_name": "Pontus", "confidence": "high", "type": "place", "description": "Ancient kingdom and geographic region in Anatolia.", "note": "Refers to the historical region in Anatolia, not the planet or the mythological figure.", "wikipedia_extract": "Pontus or Pontos (; Greek: Πόντος, romanized: Póntos, lit. 'sea',) is a region within Anatolia on the southern coast of the Black Sea, located in the modern-day eastern Black Sea region of Turkey, in West Asia. The name was applied to the coastal region and its mountainous hinterland (rising to the Pontic Alps in the east) by the Greeks who colonized the area in the Archaic period and derived from the Greek name of the Black Sea: Εύξεινος Πόντος (Eúxinos Póntos), 'Hospitable Sea', or simply Pontos (ὁ Πόντος) as early as the Aeschylean Persians (472 BC) and Herodotus' Histories (c. 440 BC). Having originally no specific name, the region east of the river Halys was spoken of as the country Ἐν Πόντῳ (En Póntō), lit. 'on the [Euxinos] Pontos', and hence it acquired the name of Pontus, which is first found in Xenophon's Anabasis (c. 370 BC). The extent of the region varied through the ages but generally extended from the borders of Colchis (modern western Georgia) until well into Paphlagonia in the west, with varying amounts of hinterland. Several states and provinces bearing the name of Pontus or variants thereof were established in the region in the Hellenistic, Roman and Byzantine periods, culminating in the late Byzantine Empire of Trebizond. Pontus is sometimes considered as the original home of the Amazons, in ancient Greek mythology and historiography (e.g. by Herodotus and Strabo)."}}, {"canonical_name": "africaine", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "africaine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "africaine", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["africaine"], "contexts": ["African race", "African colony"]}, {"entity_id": "african_islands", "book_id": "origin_of_species_darwin_1859", "name": "African islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["African islands"], "contexts": ["islands with plants and animals related to mainland"]}, {"entity_id": "african_mainland", "book_id": "origin_of_species_darwin_1859", "name": "African mainland", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["African mainland"], "contexts": ["source of plants and animals for African islands"]}, {"entity_id": "afri", "book_id": "coloquios_da_orta_1563", "name": "Afri", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Afri"], "contexts": ["mentioned in a collection of voyages"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "africaine", "target_book": "origin_of_species_darwin_1859", "target_name": "African islands", "similarity": 0.876}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "africaine", "target_book": "origin_of_species_darwin_1859", "target_name": "African mainland", "similarity": 0.892}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "africaine", "target_book": "coloquios_da_orta_1563", "target_name": "Afri", "similarity": 0.956}, {"source_book": "origin_of_species_darwin_1859", "source_name": "African islands", "target_book": "coloquios_da_orta_1563", "target_name": "Afri", "similarity": 0.86}, {"source_book": "origin_of_species_darwin_1859", "source_name": "African mainland", "target_book": "coloquios_da_orta_1563", "target_name": "Afri", "similarity": 0.878}], "id": 447, "stable_key": "clu_c4075b6473f6fd72", "ground_truth": {"modern_name": "Africa", "confidence": "high", "type": "place", "description": "Continent, its regions, islands, and people.", "note": "Refers to the continent of Africa and its associated regions and people.", "wikipedia_extract": "Africa is the world's second-largest and second-most populous continent after Asia. At about 30.3 million km2 (11.7 million square miles) including adjacent islands, it covers around 20% of Earth's land area and 6% of its total surface area. With nearly 1.4 billion people as of 2021, it accounts for about 18% of the world's human population. Africa's population is the youngest among all the continents; the median age in 2012 was 19.7, when the worldwide median age was 30.4. Based on 2024 projections, Africa's population will exceed 3.8 billion people by 2100. Africa is the least wealthy inhabited continent per capita and second-least wealthy by total wealth, ahead of Oceania."}}, {"canonical_name": "tiger", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "tiger", "book_id": "origin_of_species_darwin_1859", "name": "tiger", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["tiger"], "contexts": ["large carnivorous cat", "predatory mammal in India"]}, {"entity_id": "tiger", "book_id": "principles_of_psychology_james_1890", "name": "tiger", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["tiger"], "contexts": ["large predatory cat", "animal that escaped from a cage"]}, {"entity_id": "royal_tiger", "book_id": "kosmos_humboldt_1845", "name": "royal tiger", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["royal tiger"], "contexts": ["tiger species migrating north"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "tiger", "target_book": "principles_of_psychology_james_1890", "target_name": "tiger", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "tiger", "target_book": "kosmos_humboldt_1845", "target_name": "royal tiger", "similarity": 0.92}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tiger", "target_book": "kosmos_humboldt_1845", "target_name": "royal tiger", "similarity": 0.92}], "id": 448, "stable_key": "clu_e95da8e7c5f9b7ed", "ground_truth": {"modern_name": "tiger", "confidence": "high", "type": "animal", "linnaean": "Panthera tigris", "family": "Felidae", "description": "Large carnivorous cat native to Asia.", "wikipedia_extract": "The tiger (Panthera tigris) is a large cat and a member of the genus Panthera native to Asia. It has a powerful, muscular body with a large head and paws, a long tail and orange fur with black, mostly vertical stripes. It is traditionally classified into nine recent subspecies, though some recognise only two subspecies, mainland Asian tigers and the island tigers of the Sunda Islands. Throughout the tiger's range, it inhabits mainly forests, from coniferous and temperate broadleaf and mixed forests in the Russian Far East and Northeast China to tropical and subtropical moist broadleaf forests on the Indian subcontinent and Southeast Asia. The tiger is an apex predator and preys mainly on ungulates, which it takes by ambush. It lives a mostly solitary life and occupies home ranges, defending these from individuals of the same sex."}}, {"canonical_name": "Principles of Geology", "category": "ORGANIZATION", "subcategory": "JOURNAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "principles_of_geology", "book_id": "kosmos_humboldt_1845", "name": "Principles of Geology", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 4, "variants": ["Principles of Geology"], "contexts": ["book on geology", "book on geological principles"]}, {"entity_id": "principles_of_geology", "book_id": "origin_of_species_darwin_1859", "name": "Principles of Geology", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Principles of Geology"], "contexts": ["influential work on geology"]}, {"entity_id": "principles_of_geology", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Principles of Geology", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Principles of Geology"], "contexts": ["book on geological phenomena"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Principles of Geology", "target_book": "origin_of_species_darwin_1859", "target_name": "Principles of Geology", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Principles of Geology", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Principles of Geology", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Principles of Geology", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Principles of Geology", "similarity": 1.0}], "id": 449, "stable_key": "clu_7023d953dffafcd1", "ground_truth": {"modern_name": "Principles of Geology", "confidence": "high", "type": "text", "note": "This is a specific book title. The author is Charles Lyell, but the cluster refers to the work itself.", "wikidata_id": "Q1348323", "wikidata_description": "essay by Charles Lyell", "wikipedia_url": "https://en.wikipedia.org/wiki/Principles%20of%20Geology", "wikipedia_extract": "Principles of Geology: Being an Attempt to Explain the Former Changes of the Earth's Surface, by Reference to Causes Now in Operation is a book by the Scottish geologist Charles Lyell that was first published in 3 volumes from 1830 to 1833. Lyell used the theory of uniformitarianism to describe how the Earth's surface was changing over time. This theory was in direct contrast to the geological theory of catastrophism. Many individuals believed in catastrophism to allow room for religious beliefs. For example, the Genesis flood narrative could be described as a real geological event as catastrophism describes the changing of the Earth surface as one-time, violent events. Lyell challenged the believers of the catastrophic theory by studying Mount Etna in Sicily and describing the changes from one stratum to another and the fossil records within the rocks to prove that slow, gradual changes were the cause of the ever-changing Earth's surface."}}, {"canonical_name": "Armadillo", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "armadillo", "book_id": "historia_medicinal_monardes_1574", "name": "Armadillo", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["Armadillo", "armadillo"], "contexts": ["animal from another nature", "animal covered in armor, like a horse"]}, {"entity_id": "armadillo", "book_id": "origin_of_species_darwin_1859", "name": "armadillo", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["armadillo"], "contexts": ["animal with pieces of armour", "living mammal in South America"]}, {"entity_id": "armadillo", "book_id": "first_principles_spencer_1862", "name": "Armadillo", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Armadillo"], "contexts": ["mammal allied to Glyptodon"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Armadillo", "target_book": "origin_of_species_darwin_1859", "target_name": "armadillo", "similarity": 0.952}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Armadillo", "target_book": "first_principles_spencer_1862", "target_name": "Armadillo", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "armadillo", "target_book": "first_principles_spencer_1862", "target_name": "Armadillo", "similarity": 0.952}], "id": 450, "stable_key": "clu_2e278f54c15bf49c", "ground_truth": {"modern_name": "armadillo", "confidence": "high", "type": "animal", "family": "Dasypodidae", "description": "South American mammal with a bony or leathery shell.", "wikipedia_extract": "Armadillos (Spanish for 'little armored ones') are New World placental mammals in the order Cingulata. They form part of the superorder Xenarthra, along with the anteaters and sloths. 21 extant species of armadillo have been described, some of which are distinguished by the number of bands on their armor. All species are native to the Americas, where they inhabit a variety of environments. Living armadillos are characterized by a leathery armor shell and long, sharp claws for digging. They have short legs, but can move quite quickly. The average length of an armadillo is about 75 cm (30 in), including its tail."}}, {"canonical_name": "Charlestown", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "charlestown", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Charlestown", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Charlestown", "Charleston"], "contexts": ["city in South Carolina", "city in South Carolina, USA"]}, {"entity_id": "charleston", "book_id": "principles_of_psychology_james_1890", "name": "Charleston", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Charleston"], "contexts": ["geographic location", "geographic location for spatial orientation"]}, {"entity_id": "charleston", "book_id": "kosmos_humboldt_1845", "name": "Charleston", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Charleston"], "contexts": ["city of Medical College", "city in Eastern America"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Charlestown", "target_book": "principles_of_psychology_james_1890", "target_name": "Charleston", "similarity": 0.986}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Charlestown", "target_book": "kosmos_humboldt_1845", "target_name": "Charleston", "similarity": 0.986}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Charleston", "target_book": "kosmos_humboldt_1845", "target_name": "Charleston", "similarity": 1.0}], "id": 451, "stable_key": "clu_b34e57d9fbe63731", "ground_truth": {"modern_name": "Charleston", "confidence": "high", "type": "place", "country": "United States", "note": "The context of 'Medical College' strongly points to Charleston, South Carolina, a prominent historical location for medical education. While there are other Charlestowns, this is the most likely referent in an early modern scientific/medical context.", "wikidata_id": "Q47716", "wikidata_description": "largest city in the U.S. state of South Carolina", "wikipedia_url": "https://en.wikipedia.org/wiki/Charleston%2C_South_Carolina", "wikipedia_extract": "Charleston is the most populous city in the U.S. state of South Carolina. The city lies just south of the geographical midpoint of South Carolina's coastline on Charleston Harbor, an inlet of the Atlantic Ocean formed by the confluence of the Ashley, Cooper, and Wando rivers. Charleston had a population of 150,227 at the 2020 census, while the Charleston metropolitan area, comprising Berkeley, Charleston, and Dorchester counties, has an estimated 870,000 residents. It ranks as the third-most populous metropolitan area in the state and the 71st-most populous in the U.S. It is the county seat of Charleston County."}}, {"canonical_name": "Vienna", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "vienna", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Vienna", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Vienna"], "contexts": ["location of Kempelen", "city of Dr. Berre"]}, {"entity_id": "vienne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Vienne", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Vienne"], "contexts": ["temperate climate city for experiments"]}, {"entity_id": "vienna", "book_id": "principles_of_psychology_james_1890", "name": "Vienna", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Vienna"], "contexts": ["city where pamphlet was published"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Vienna", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Vienne", "similarity": 0.878}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Vienna", "target_book": "principles_of_psychology_james_1890", "target_name": "Vienna", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Vienne", "target_book": "principles_of_psychology_james_1890", "target_name": "Vienna", "similarity": 0.878}], "id": 452, "stable_key": "clu_b7658edbc6ca4609", "ground_truth": {"modern_name": "Vienna", "confidence": "high", "type": "place", "country": "Austria", "note": "The mention of 'Kempelen' (likely Wolfgang von Kempelen, inventor of the Mechanical Turk) points to Vienna. 'Vienne' in French can refer to the river or a department, but in the context of scientific inquiry and publications, Vienna is the most probable city.", "wikidata_id": "Q577544", "wikidata_description": "city in Johnson County, Illinois, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Vienna%2C%20Illinois", "wikipedia_extract": "Vienna (  vee-EN-ə; German: Wien [viːn] ; Austro-Bavarian: Wean [veɐ̯n]) is the capital, most populous city, and one of the nine states of Austria. It is Austria's primate city, with just over two million inhabitants. Its larger metropolitan area has a population of nearly 2.9 million, representing nearly one-third of the country's population. Vienna is the cultural, economic, and political centre of the country, the fifth-largest city by population in the European Union, and the most populous of the cities on the river Danube. The city lies on the eastern edge of the Vienna Woods (Wienerwald), the northeasternmost foothills of the Alps, that separate Vienna from the more western parts of Austria, at the transition to the Pannonian Basin. It sits on the Danube, and is traversed by the highly regulated Wienfluss (Vienna River)."}}, {"canonical_name": "Franconie", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "franconie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Franconie", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Franconie"], "contexts": ["historical region in Germany", "region containing Ochsenkopf"]}, {"entity_id": "franconia", "book_id": "kosmos_humboldt_1845", "name": "Franconia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Franconia"], "contexts": ["region producing wines"]}, {"entity_id": "franguístan", "book_id": "coloquios_da_orta_1563", "name": "Franguístan", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Franguístan"], "contexts": ["geographic location"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Franconie", "target_book": "kosmos_humboldt_1845", "target_name": "Franconia", "similarity": 0.994}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Franconie", "target_book": "coloquios_da_orta_1563", "target_name": "Franguístan", "similarity": 0.874}, {"source_book": "kosmos_humboldt_1845", "source_name": "Franconia", "target_book": "coloquios_da_orta_1563", "target_name": "Franguístan", "similarity": 0.885}], "id": 453, "stable_key": "clu_3debe8cce4669f32", "ground_truth": {"modern_name": "Franconia", "confidence": "high", "type": "place", "description": "Historical region in northern Bavaria, Germany.", "note": "'Franguístan' appears to be a transliteration of the region.", "wikipedia_extract": "Franconia (German: Franken [ˈfʁaŋkn̩] ; East Franconian: Franggn [ˈfrɑŋɡŋ̍]; Bavarian: Frankn) is a geographical region of Germany, characterised by its culture and East Franconian dialect (Ostfränkisch). Franconia is made up of the three Regierungsbezirke (governmental districts) of Lower, Middle and Upper Franconia in Bavaria, the adjacent, Franconian-speaking South Thuringia, south of the Thuringian Forest—which constitutes the language boundary between Franconian and Thuringian—and the eastern parts of Heilbronn-Franconia in Baden-Württemberg. Those parts of the Vogtland lying in Saxony (largest city: Plauen) are sometimes regarded as Franconian as well, because the Vogtlandian dialects are mostly East Franconian. The inhabitants of Saxon Vogtland, however, mostly do not consider themselves Franconian. On the other hand, the inhabitants of the Hessian-speaking parts of Lower Franconia west of the Spessart (largest city: Aschaffenburg) do consider themselves Franconian, although not speaking the dialect. Heilbronn-Franconia's largest city of Heilbronn and its surrounding areas are South Franconian-speaking, and therefore only sometimes regarded as Franconian."}}, {"canonical_name": "Bremen", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "bremen", "book_id": "kosmos_humboldt_1845", "name": "Bremen", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Bremen"], "contexts": ["city where meteor falls were observed", "city where meteoric fall was observed"]}, {"entity_id": "bremen", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bremen", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bremen"], "contexts": ["city of sugar importation"]}, {"entity_id": "bremen", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bremen", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bremen"], "contexts": ["location of Olbers"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Bremen", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Bremen", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bremen", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bremen", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bremen", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bremen", "similarity": 1.0}], "id": 454, "stable_key": "clu_db9df04010eff022", "ground_truth": {"modern_name": "Bremen", "confidence": "high", "type": "place", "country": "Germany", "wikidata_id": "Q24879", "wikidata_description": "city in the Bremen federated state, Germany", "wikipedia_url": "https://en.wikipedia.org/wiki/Bremen", "wikipedia_extract": "Bremen (German pronunciation: [ˈbʁeːmən] ), officially the City Municipality of Bremen, is the capital of the German state of the Free Hanseatic City of Bremen (Freie Hansestadt Bremen) a two-city-state consisting of the cities of Bremen and Bremerhaven. It is an important port city with about 586,000 inhabitants, the Hanseatic city is the 11th-largest city of Germany and the second-largest city in Northern Germany after Hamburg. Bremen is the largest city on the River Weser, the longest river flowing entirely in Germany, lying some 60 km (37 mi) upstream from its mouth into the North Sea at Bremerhaven, and is completely surrounded by the state of Lower Saxony. Bremen is the centre of the Northwest Metropolitan Region, which also includes the cities of Oldenburg and Bremerhaven, and has a population of around 2.8 million people. Bremen is contiguous with the Lower Saxon towns of Delmenhorst, Stuhr, Achim, Weyhe, Schwanewede and Lilienthal. There is an exclave of Bremen in Bremerhaven, the \"Citybremian Overseas Port Area Bremerhaven\" (Stadtbremisches Überseehafengebiet Bremerhaven)."}}, {"canonical_name": "Port Bowen Harbour", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "port_bowen_harbour", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Port Bowen Harbour", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Port Bowen Harbour"], "contexts": ["location for sound transmission experiment", "transmission of sound across"]}, {"entity_id": "port_bowen", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Port Bowen", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Port Bowen"], "contexts": ["and of the Port Bowen"]}, {"entity_id": "port_bowen", "book_id": "kosmos_humboldt_1845", "name": "Port Bowen", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Port Bowen"], "contexts": ["location of Parry's observations", "location of barometric observation"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Port Bowen Harbour", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Port Bowen", "similarity": 0.953}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Port Bowen Harbour", "target_book": "kosmos_humboldt_1845", "target_name": "Port Bowen", "similarity": 0.953}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Port Bowen", "target_book": "kosmos_humboldt_1845", "target_name": "Port Bowen", "similarity": 1.0}], "id": 455, "stable_key": "clu_6f094ff64213583c", "ground_truth": {"modern_name": "Port Bowen Harbour", "confidence": "high", "type": "place", "country": "Canada", "note": "Located in Nunavut, Canada.", "wikidata_id": "Q116744319", "wikidata_description": "bay in Nunavut, Canada", "wikipedia_extract": "Port Chalmers (Māori: Kōpūtai) is a town serving as the main port of the city of Dunedin, New Zealand. Port Chalmers lies 13 kilometres (8.1 mi) inside Otago Harbour, some 13 kilometres (8.1 mi) northeast of Dunedin's city centre. No archaeological sites relating to Māori have been discovered in Port Chalmers, although records from European settlers in the 1830s and 1840s note the presence of buildings on the now-reclaimed beach. By 1844 this settlement was fully abandoned. The Māori name for the bay at Port Chalmers is Koputai meaning ‘full tide’ and refers to an incident in which a group of warriors decided to spend the night in a cave that once existed at what was later known as Boiler Point and pulled their canoes well above the high tide mark. Overnight, the tide rose and the beached canoes were set adrift.", "wikipedia_url": "https://en.wikipedia.org/wiki/Port_Chalmers"}}, {"canonical_name": "St. Petersburg", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "st__petersburg", "book_id": "principles_of_psychology_james_1890", "name": "St. Petersburg", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["St. Petersburg"], "contexts": ["location of cited publication", "location of publication"]}, {"entity_id": "st__petersburg", "book_id": "kosmos_humboldt_1845", "name": "St. Petersburg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["St. Petersburg"], "contexts": ["location of Hensius's description"]}, {"entity_id": "st__petersburg", "book_id": "connexion_physical_sciences_somerville_1858", "name": "St. Petersburg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["St. Petersburg"], "contexts": ["location of Kratzenstein"]}, {"entity_id": "petersburgh", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Petersburgh", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Petersburgh"], "contexts": ["city with severe winters"]}, {"entity_id": "petersburg", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Petersburg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Petersburg"], "contexts": ["location where Professor Richman was struck"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "St. Petersburg", "target_book": "kosmos_humboldt_1845", "target_name": "St. Petersburg", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "St. Petersburg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "St. Petersburg", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "St. Petersburg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Petersburgh", "similarity": 0.911}, {"source_book": "principles_of_psychology_james_1890", "source_name": "St. Petersburg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Petersburg", "similarity": 0.93}, {"source_book": "kosmos_humboldt_1845", "source_name": "St. Petersburg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "St. Petersburg", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "St. Petersburg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Petersburgh", "similarity": 0.911}, {"source_book": "kosmos_humboldt_1845", "source_name": "St. Petersburg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Petersburg", "similarity": 0.93}], "id": 456, "stable_key": "clu_330dc43f36d4acc5", "ground_truth": {"modern_name": "Saint Petersburg", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q656", "wikidata_description": "federal city and former capital of Russia", "wikipedia_url": "https://en.wikipedia.org/wiki/Saint%20Petersburg", "wikipedia_extract": "Saint Petersburg, formerly known as Petrograd (Петроград) and later Leningrad (Ленинград), is the second-largest city in Russia, after Moscow, the nation's capital. It is situated on the River Neva, at the head of the Gulf of Finland on the Baltic Sea. With an area of 1,439 square kilometers (556 square miles), Saint Petersburg is the smallest administrative division of Russia by area. The city had a population of 5,601,911 residents as of 2021, with more than 6.4 million people living in the metropolitan area. Saint Petersburg is the fourth-most populous city in Europe, the most populous city on the Baltic Sea, and the world's northernmost city of more than 1 million residents. As the former capital of the Russian Empire, and a historically strategic port, it is governed as a federal city."}}, {"canonical_name": "Scythia", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "scythia", "book_id": "kosmos_humboldt_1845", "name": "Scythia", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Scythia"], "contexts": ["ancient region described as earthquake-free", "ancient geographical region"]}, {"entity_id": "scitia", "book_id": "historia_medicinal_monardes_1574", "name": "Scitia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Scitia"], "contexts": ["Scythia, ancient region"]}, {"entity_id": "scythia", "book_id": "coloquios_da_orta_1563", "name": "Scythia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Scythia"], "contexts": ["region where jacinthos were found"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Scythia", "target_book": "historia_medicinal_monardes_1574", "target_name": "Scitia", "similarity": 0.894}, {"source_book": "kosmos_humboldt_1845", "source_name": "Scythia", "target_book": "coloquios_da_orta_1563", "target_name": "Scythia", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Scitia", "target_book": "coloquios_da_orta_1563", "target_name": "Scythia", "similarity": 0.894}], "id": 457, "stable_key": "clu_4ba8bf6fe87c1fe8", "ground_truth": {"modern_name": "Scythia", "confidence": "high", "type": "place", "country": "Ukraine", "note": "Ancient region, modern country is an approximation.", "wikidata_id": "Q10664835", "wikidata_description": "genus", "wikipedia_extract": "Scythia (UK: , also US: ) or Scythica (UK: , also US: ) was a geographic region defined in the ancient Graeco-Roman world that encompassed the Pontic steppe. It was inhabited by Scythians, an ancient Eastern Iranian equestrian nomadic people. The names Scythia and Scythica are themselves Latinisations of the Ancient Greek names Skuthia (Σκυθία) and Skuthikē (Σκυθική), which were themselves derived from the ancient Greek names for the Scythians, Skuthēs (Σκύθης) and Skuthoi (Σκύθοι), derived from the Scythian endonym *Skuδa. The territory of the Scythian kingdom of the Pontic steppe extended from the Don river in the east to the Danube river in the west, and covered the territory of the treeless steppe immediately north of the Black Sea's coastline, which was inhabited by nomadic pastoralists, as well as the fertile black-earth forest-steppe area to the north of the treeless steppe, which was inhabited by an agricultural population. The northern border of this Scythian kingdom were the deciduous woodlands, while several rivers, including Don and Dnipro, flowed southwards across this region and emptied into the Black Sea. Between the 9th and 5th centuries BC, the climate in the steppes was cool and dry, which was a catalyst for the emergence of equestrian nomadic pastoralism in the northern Pontic region.", "wikipedia_url": "https://en.wikipedia.org/wiki/Scythia"}}, {"canonical_name": "Secular", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "secular", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Secular", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Secular"], "contexts": ["long-term variations", "occurring over long periods of time"]}, {"entity_id": "secular_motion", "book_id": "kosmos_humboldt_1845", "name": "secular motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["secular motion"], "contexts": ["long-term change in magnetic declination"]}, {"entity_id": "secular_variations", "book_id": "connexion_physical_sciences_somerville_1858", "name": "secular variations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["secular variations"], "contexts": ["long-term changes in magnetic elements"]}, {"entity_id": "secular_motion", "book_id": "connexion_physical_sciences_somerville_1858", "name": "secular motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["secular motion"], "contexts": ["periodic variations of equinoxes"]}, {"entity_id": "secular_music", "book_id": "first_principles_spencer_1862", "name": "secular music", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["secular music"], "contexts": ["music not for religious purposes"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Secular", "target_book": "kosmos_humboldt_1845", "target_name": "secular motion", "similarity": 0.829}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Secular", "target_book": "first_principles_spencer_1862", "target_name": "secular music", "similarity": 0.841}, {"source_book": "kosmos_humboldt_1845", "source_name": "secular motion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "secular variations", "similarity": 0.828}, {"source_book": "kosmos_humboldt_1845", "source_name": "secular motion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "secular motion", "similarity": 1.0}], "id": 458, "stable_key": "clu_12b8e09fcd27e5af", "ground_truth": {"modern_name": "Secular variation", "confidence": "high", "type": "concept", "note": "Refers to long-term changes, particularly in scientific contexts like astronomy or geomagnetism.", "wikidata_id": "Q1763933", "wikidata_description": "long-term non-periodic variation", "wikipedia_url": "https://en.wikipedia.org/wiki/Secular%20variation", "wikipedia_extract": "The secular variation of a time series is its long-term, non-periodic variation (see Decomposition of time series). Whether a variation is perceived as secular or not depends on the available timescale: a variation that is secular over a timescale of centuries may be a segment of what is, over a timescale of millions of years, a periodic variation. Natural quantities often have both periodic and secular variations. Secular variation is sometimes called secular trend or secular drift when the emphasis is on a linear long-term trend. The term is used wherever time series are applicable in history, economics, operations research, biological anthropology, and astronomy (particularly celestial mechanics) such as VSOP (planets). The word secular, from the Latin root saecularis (\"of an age, occurring once in an age\"), has two basic meanings: I."}}, {"canonical_name": "dedo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "dedo", "book_id": "polyanthea_medicinal", "name": "dedo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["dedo", "dedo annular"], "contexts": ["used to stir water", "part of the hand"]}, {"entity_id": "dedo", "book_id": "historia_medicinal_monardes_1574", "name": "dedo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["dedo"], "contexts": ["finger, where rings are worn"]}, {"entity_id": "dedo", "book_id": "coloquios_da_orta_1563", "name": "dedo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["dedo"], "contexts": ["part of the body"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "dedo", "target_book": "historia_medicinal_monardes_1574", "target_name": "dedo", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "dedo", "target_book": "coloquios_da_orta_1563", "target_name": "dedo", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "dedo", "target_book": "coloquios_da_orta_1563", "target_name": "dedo", "similarity": 1.0}], "id": 459, "stable_key": "clu_a51a1857989dc47f", "ground_truth": {"modern_name": "finger", "confidence": "high", "type": "object", "description": "Part of the hand, used for manipulation and ornamentation.", "wikipedia_extract": "A finger is a prominent digit on the forelimbs of most tetrapod vertebrate animals, especially those with prehensile extremities (i.e. hands) such as humans and other primates. Most tetrapods have five digits (pentadactyly), and short digits (i.e. significantly shorter than the metacarpal/metatarsals) are typically referred to as toes, while those that are notably elongated are called fingers. In humans, the fingers are flexibly articulated and opposable, serving as an important organ of tactile sensation and fine movements, which are crucial to the dexterity of the hands and the ability to grasp and manipulate objects. Usually humans have five digits, the bones of which are termed phalanges, on each hand, although some people have more or fewer than five due to congenital disorders such as polydactyly or oligodactyly, or accidental or intentional amputations. The first digit is the thumb, followed by the index finger, middle finger, ring finger, and little finger or pinkie. According to different definitions, the thumb can be called a finger, or not."}}, {"canonical_name": "Trementina", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "trementina", "book_id": "historia_medicinal_monardes_1574", "name": "Trementina", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["trementina", "Trementina"], "contexts": ["substance applied to painful areas", "like Turpentine made in Castile"]}, {"entity_id": "tremétinalauata", "book_id": "ricettario_fiorentino_1597", "name": "Tremétinalauata", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Tremétinalauata"], "contexts": ["likely a washed or purified substance"]}, {"entity_id": "trimentum", "book_id": "polyanthea_medicinal", "name": "trimentum", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["trimentum"], "contexts": ["barley"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Trementina", "target_book": "ricettario_fiorentino_1597", "target_name": "Tremétinalauata", "similarity": 0.866}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Trementina", "target_book": "polyanthea_medicinal", "target_name": "trimentum", "similarity": 0.849}], "id": 460, "stable_key": "clu_d75098fcf93387e6", "ground_truth": {"modern_name": "turpentine", "confidence": "high", "type": "chemical", "description": "Resinous substance derived from pines, used medicinally and industrially.", "note": "The term 'trimentum' with the context 'barley' is likely an outlier or error in the source text.", "wikipedia_extract": "Turpentine (which is also called spirit of turpentine, oil of turpentine, terebenthine, terebenthene, terebinthine and, colloquially, turps) is a fluid obtainable by the distillation of resin harvested from living trees, mainly pines. Principally used as a specialized solvent, it is also a source of material for organic syntheses. Turpentine is composed of terpenes, primarily the monoterpenes α-pinene and β-pinene, with lesser amounts of carene, camphene, limonene, and terpinolene. Nowadays, turpentine is rarely the product of distillation of pine resin, but is a byproduct of pulping. Pulping is achieved by two processes, the Kraft process and the sulfite process. The turpentines obtained from these two processes differ in their chemical compositions."}}, {"canonical_name": "Rob", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "rob", "book_id": "coloquios_da_orta_1563", "name": "Rob", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["rob", "Rob"], "contexts": ["Arabic for thickened juice", "plant extract, possibly from liquorice"]}, {"entity_id": "robbi", "book_id": "ricettario_fiorentino_1597", "name": "Robbi", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Robbi", "robbi"], "contexts": ["rob, a type of compound medicine", "syrups or concentrated fruit juices"]}, {"entity_id": "rob_fombucif", "book_id": "polyanthea_medicinal", "name": "Rob fombucif", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Rob fombucif"], "contexts": ["elderberry preparation, a medicinal substance"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Rob", "target_book": "ricettario_fiorentino_1597", "target_name": "Robbi", "similarity": 0.878}, {"source_book": "coloquios_da_orta_1563", "source_name": "Rob", "target_book": "polyanthea_medicinal", "target_name": "Rob fombucif", "similarity": 0.841}], "id": 461, "stable_key": "clu_edca4300d6deebdc", "ground_truth": {"modern_name": "rob (fruit/plant concentrate)", "confidence": "high", "type": "chemical", "description": "Concentrated juice or extract from fruits or plants, often medicinal.", "wikipedia_extract": "An alcoholic beverage is any drink that contains alcohol, a central nervous system depressant. They are typically divided into three classes: beers, wines, and spirits; with alcohol content typically between 3% and 50%. The exact amount on which a beverage is considered alcoholic differs by country, with some considering drinks containing less than 0.5% to be non-alcoholic. These beverages are primarily consumed for the psychoactive effects that they produce. Many societies have a distinct drinking culture, in which alcoholic drinks are integrated into parties. Most countries have laws regulating the production, sale, and consumption of alcoholic beverages."}}, {"canonical_name": "Leyden", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "leyden", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Leyden", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Leyden"], "contexts": ["city in the Netherlands", "city associated with a party of people"]}, {"entity_id": "leyden", "book_id": "english_physician_1652", "name": "Leyden", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Leyden"], "contexts": ["university where Dioscorides' book is used"]}, {"entity_id": "leide", "book_id": "coloquios_da_orta_1563", "name": "Leide", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Leide"], "contexts": ["location of publication"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Leyden", "target_book": "english_physician_1652", "target_name": "Leyden", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Leyden", "target_book": "coloquios_da_orta_1563", "target_name": "Leide", "similarity": 0.91}, {"source_book": "english_physician_1652", "source_name": "Leyden", "target_book": "coloquios_da_orta_1563", "target_name": "Leide", "similarity": 0.91}], "id": 462, "stable_key": "clu_86db141a88fc8177", "ground_truth": {"wikipedia_extract": "Leiden ( LY-dən; Dutch: [ˈlɛidə(n)] ; in English and archaic Dutch also Leyden) is a city and municipality in the province of South Holland, Netherlands. The municipality of Leiden has a population of 127,046 (31 January 2023), but the city forms one densely connected agglomeration with its suburbs Oegstgeest, Leiderdorp, Voorschoten and Zoeterwoude with 215,602 inhabitants. The Netherlands Central Bureau of Statistics (CBS) further includes Katwijk in the agglomeration which makes the total population of the Leiden urban agglomeration 282,207. Further, Teylingen, Noordwijk, and Noordwijkerhout are included in the larger Leiden urban area, which has 365,913 inhabitants. Leiden is located on the Oude Rijn, at a distance of some 20 km (12 mi) from The Hague to its south and some 40 km (25 mi) from Amsterdam to its north. The recreational area of the Kaag Lakes (Kagerplassen) lies just to the northeast of Leiden."}}, {"canonical_name": "Acorns", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "acorns", "book_id": "english_physician_1652", "name": "Acorns", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Acorns", "Acorus"], "contexts": ["Hogs eat Acorns", "fruit of the oak tree, used medicinally"]}, {"entity_id": "acorns", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "acorns", "category": "PLANT", "subcategory": "SEED", "count": 1, "variants": ["acorns"], "contexts": ["seed of an oak tree"]}, {"entity_id": "acorus", "book_id": "coloquios_da_orta_1563", "name": "Acorus", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Acorus"], "contexts": ["plant used in pessary"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Acorns", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "acorns", "similarity": 0.813}, {"source_book": "english_physician_1652", "source_name": "Acorns", "target_book": "coloquios_da_orta_1563", "target_name": "Acorus", "similarity": 0.853}], "id": 463, "stable_key": "clu_4df975d9c80e155e", "ground_truth": {"modern_name": "Acorn", "confidence": "medium", "type": "plant", "linnaean": "Quercus spp.", "family": "Fagaceae", "note": "The term 'Acorus' appears in one source and refers to a different plant (sweet flag). Given the context 'seed of an oak tree' and 'Hogs eat Acorns', 'Acorn' is the primary identification, but 'Acorus' introduces ambiguity.", "wikidata_id": "Q3914781", "wikidata_description": "fruit/nut of the oak tree", "wikipedia_url": "https://en.wikipedia.org/wiki/Acorn", "wikipedia_extract": "The acorn  is the nut of the oaks and their close relatives (genera Quercus, Notholithocarpus and Lithocarpus, in the family Fagaceae); alternatively known as glans. It usually contains a seedling surrounded by two cotyledons (seedling leaves), enclosed in a tough shell known as the pericarp, and borne in a cup-shaped cupule. Acorns are 1–6 cm (1⁄2–2+1⁄2 in) long and 0.8–4 cm (3⁄8–1+5⁄8 in) on the fat side. Acorns take between 5 and 24 months (depending on the species) to mature; see the list of Quercus species for details of oak classification, in which acorn morphology and phenology are important factors. The word acorn (earlier akerne, and acharn) is related to the Gothic name akran, which had the sense of \"fruit of the unenclosed land\". The word was applied to the most important forest produce, that of the oak."}}, {"canonical_name": "Poplar", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "poplar", "book_id": "english_physician_1652", "name": "Poplar", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Poplar", "Poplar-Tree"], "contexts": ["tree dedicated to Hercules", "tree with two common sorts"]}, {"entity_id": "poplar", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Poplar", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Poplar"], "contexts": ["tree whose gums form concretion"]}, {"entity_id": "poplars", "book_id": "kosmos_humboldt_1845", "name": "poplars", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["poplars"], "contexts": ["abundant in middle tertiary period", "tree species in ancient forests"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Poplar", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Poplar", "similarity": 0.924}, {"source_book": "english_physician_1652", "source_name": "Poplar", "target_book": "kosmos_humboldt_1845", "target_name": "poplars", "similarity": 0.849}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Poplar", "target_book": "kosmos_humboldt_1845", "target_name": "poplars", "similarity": 0.942}], "id": 464, "stable_key": "clu_c137951004a0b5e9", "ground_truth": {"modern_name": "Poplar", "confidence": "high", "type": "plant", "linnaean": "Populus spp.", "family": "Salicaceae", "wikipedia_extract": "Populus nigra, the black poplar, is a species of cottonwood poplar, the type species of section Aigeiros of the genus Populus, native to Europe, southwest and central Asia, and northwest Africa. Black poplars are medium- to large-sized deciduous trees, reaching 20–30 m, and rarely 40 m tall. Their leaves are diamond-shaped to triangular, 5–8 cm long and 6–8 cm broad, and green on both surfaces. Normally, their trunks achieve up to 1.5 m in diameter, but some unusual individual trees in France have grown old enough to have much larger trunks – more than 3 metres DBH (Diameter at Breast Height). The species is dioecious (male and female flowers are on different plants), with flowers in catkins and pollination achieved by the wind. The black poplar grows in low-lying areas of moist ground.", "wikipedia_url": "https://en.wikipedia.org/wiki/Populus_nigra"}}, {"canonical_name": "Pélicans", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "pélicans", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pélicans", "category": "ANIMAL", "subcategory": "BIRD", "count": 3, "variants": ["Pélicans", "Pélican brun", "pélicans"], "contexts": ["birds harried by flamans", "pelican family"]}, {"entity_id": "pelican", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Pelican", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Pelican"], "contexts": ["bird used in allegorical arguments"]}, {"entity_id": "pelicans", "book_id": "origin_of_species_darwin_1859", "name": "pelicans", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["pelicans"], "contexts": ["birds that ate fish containing seeds"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pélicans", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Pelican", "similarity": 0.878}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pélicans", "target_book": "origin_of_species_darwin_1859", "target_name": "pelicans", "similarity": 0.916}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Pelican", "target_book": "origin_of_species_darwin_1859", "target_name": "pelicans", "similarity": 0.95}], "id": 465, "stable_key": "clu_ec372eb268f1350d", "ground_truth": {"modern_name": "Pelican", "confidence": "high", "type": "animal", "wikidata_id": "Q19413", "wikidata_description": "genus of birds", "wikipedia_extract": "Pelicans (genus Pelecanus) are a genus of large water birds that make up the family Pelecanidae. They are characterized by a long beak and a large throat pouch used for catching prey and draining water from the scooped-up contents before swallowing. They have predominantly pale plumage, except for the brown and Peruvian pelicans. The bills, pouches, and bare facial skin of all pelicans become brightly coloured before the breeding season. The eight living pelican species have a patchy, seasonally-dependent yet global distribution, ranging latitudinally from the tropics to the temperate zone. Pelicans are absent from interior Amazonian South America, from polar regions and the open ocean; at least one species is known to migrate to the inland desert of Australia's Red Centre, after heavy rains create temporary lakes.", "wikipedia_url": "https://en.wikipedia.org/wiki/Pelican"}}, {"canonical_name": "Zenith", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "zenith", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Zenith", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Zenith"], "contexts": ["point directly overhead"]}, {"entity_id": "zénith", "book_id": "relation_historique_humboldt_vol3_1825", "name": "zénith", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["zénith"], "contexts": ["point directly overhead"]}, {"entity_id": "zend", "book_id": "kosmos_humboldt_1845", "name": "Zend", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Zend"], "contexts": ["ancient language and religious tradition"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Zenith", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "zénith", "similarity": 0.908}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Zenith", "target_book": "kosmos_humboldt_1845", "target_name": "Zend", "similarity": 0.863}], "id": 466, "stable_key": "clu_6753a15962442255", "ground_truth": {"modern_name": "Zenith", "confidence": "high", "type": "concept", "note": "The cluster includes mentions of 'Zenith' in the context of astronomy (point directly overhead) and 'Zend' referring to the Avestan language and Zoroastrian religious tradition. The primary referent appears to be the astronomical zenith, but the inclusion of 'Zend' introduces ambiguity.", "wikidata_id": "Q137554188", "wikidata_description": "family name"}}, {"canonical_name": "imagination", "category": "MENTAL_FACULTY", "subcategory": "MENTAL_FACULTY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "imagination", "book_id": "first_principles_spencer_1862", "name": "imagination", "category": "MENTAL_FACULTY", "subcategory": "MENTAL_FACULTY", "count": 2, "variants": ["imagination"], "contexts": ["faculty for forming new ideas", "faculty of forming mental images"]}, {"entity_id": "imagination", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "imagination", "category": "MENTAL_FACULTY", "subcategory": "MENTAL_FACULTY", "count": 1, "variants": ["imagination"], "contexts": ["power of the mind"]}, {"entity_id": "visual_imagination", "book_id": "principles_of_psychology_james_1890", "name": "visual imagination", "category": "MENTAL_FACULTY", "subcategory": "MENTAL_FACULTY", "count": 1, "variants": ["visual imagination"], "contexts": ["ability to form mental images of sight"]}, {"entity_id": "histrionic_imagination", "book_id": "principles_of_psychology_james_1890", "name": "histrionic imagination", "category": "MENTAL_FACULTY", "subcategory": "MENTAL_FACULTY", "count": 1, "variants": ["histrionic imagination"], "contexts": ["imagination for dramatic portrayal"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "imagination", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "imagination", "similarity": 1.0}, {"source_book": "first_principles_spencer_1862", "source_name": "imagination", "target_book": "principles_of_psychology_james_1890", "target_name": "visual imagination", "similarity": 0.936}, {"source_book": "first_principles_spencer_1862", "source_name": "imagination", "target_book": "principles_of_psychology_james_1890", "target_name": "histrionic imagination", "similarity": 0.902}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "imagination", "target_book": "principles_of_psychology_james_1890", "target_name": "visual imagination", "similarity": 0.936}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "imagination", "target_book": "principles_of_psychology_james_1890", "target_name": "histrionic imagination", "similarity": 0.902}], "id": 467, "stable_key": "clu_61b68aba6138e0c5", "ground_truth": {"modern_name": "Imagination", "confidence": "high", "type": "concept", "note": "Includes references to the general faculty of imagination, visual imagination, and 'histrionic imagination' (acting/performance related).", "wikidata_id": "Q91048696", "wikidata_description": "vocal track by Bob Dylan; 2017 studio recording; cover version"}}, {"canonical_name": "winds", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "winds", "book_id": "first_principles_spencer_1862", "name": "winds", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["winds"], "contexts": ["moving air with no regularity", "atmospheric currents transporting vapours"]}, {"entity_id": "winds", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "winds", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["winds"], "contexts": ["moving air"]}, {"entity_id": "wind", "book_id": "principles_of_psychology_james_1890", "name": "Wind", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Wind"], "contexts": ["word suggested by 'Sturm'"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "winds", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "winds", "similarity": 1.0}, {"source_book": "first_principles_spencer_1862", "source_name": "winds", "target_book": "principles_of_psychology_james_1890", "target_name": "Wind", "similarity": 0.971}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "winds", "target_book": "principles_of_psychology_james_1890", "target_name": "Wind", "similarity": 0.971}], "id": 468, "stable_key": "clu_d93a3972abb3fc67", "ground_truth": {"modern_name": "Wind", "confidence": "high", "type": "concept", "note": "References to moving air, with one instance potentially linking to the German word 'Sturm' (storm).", "wikidata_id": "Q37232157", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Wind_(surname)", "wikipedia_extract": "Wind is a topographical surname, of English origin, for someone who lived near a pathway, alleyway, or road. It is most popular in North East England, especially in Newcastle upon Tyne and Sunderland. The surname is also popular in the Netherlands and Denmark. The surname has several spellings including Waind, Wind, Wynd, Wain and Wean. Wind originates from the pre-7th century Old English gewind. It describes either a person who lived in a particularly windy area such as North East England or a \"winding\" road."}}, {"canonical_name": "Delphos", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "delphos", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Delphos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Delphos"], "contexts": ["oracle associated with prophecies", "ancient Greek city, site of oracle"]}, {"entity_id": "delphi", "book_id": "kosmos_humboldt_1845", "name": "Delphi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Delphi"], "contexts": ["ancient Greek religious site"]}, {"entity_id": "delft", "book_id": "coloquios_da_orta_1563", "name": "Delft", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Delft"], "contexts": ["island name"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Delphos", "target_book": "kosmos_humboldt_1845", "target_name": "Delphi", "similarity": 0.927}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Delphos", "target_book": "coloquios_da_orta_1563", "target_name": "Delft", "similarity": 0.87}, {"source_book": "kosmos_humboldt_1845", "source_name": "Delphi", "target_book": "coloquios_da_orta_1563", "target_name": "Delft", "similarity": 0.888}], "id": 469, "stable_key": "clu_d4d800df78628429", "ground_truth": {"modern_name": "Delphi", "confidence": "medium", "type": "place", "country": "Greece", "note": "The cluster contains 'Delphos' (likely a variant spelling or misreading of Delphi), 'Delphi' itself (ancient Greek religious site), and 'Delft' (a city in the Netherlands). The primary referent is likely Delphi, given the context of oracles and prophecies.", "wikidata_id": "Q160107", "wikidata_description": "genus of plants", "wikipedia_extract": "Delphi (; Greek: Δελφοί [ðelˈfi]), in legend previously called Pytho (Πυθώ), was an ancient sacred precinct in central Greece. It was the seat of Pythia, the major oracle who was consulted about important decisions throughout the ancient classical world. The ancient Greeks considered the centre of the world to be in Delphi, marked by the stone monument known as the Omphalos of Delphi. The term omphalos was the Greek word for \"navel\". According to the Suda, Delphi took its name from the Delphyne, the she-serpent (drakaina) who lived there and was killed by the god Apollo (in other accounts the serpent was the male serpent (drakon) Python). The sacred precinct occupies a delineated region on the south-western slope of Mount Parnassus.", "wikipedia_url": "https://en.wikipedia.org/wiki/Delphi"}}, {"canonical_name": "Afphalto", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "afphalto", "book_id": "ricettario_fiorentino_1597", "name": "Afphalto", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Afphalto"], "contexts": ["substance used in preparations", "bitumen, asphalt"]}, {"entity_id": "asphaltus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Asphaltus", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Asphaltus"], "contexts": ["bitumen from Judea, tested for electricity"]}, {"entity_id": "asphalt", "book_id": "connexion_physical_sciences_somerville_1858", "name": "asphalt", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["asphalt"], "contexts": ["film dissolved in oil of lavender", "dissolved in oil for photographic plate"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Afphalto", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Asphaltus", "similarity": 0.979}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Afphalto", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "asphalt", "similarity": 0.976}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Asphaltus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "asphalt", "similarity": 0.994}], "id": 470, "stable_key": "clu_25eb484c5396d93c", "ground_truth": {"modern_name": "Asphalt", "confidence": "high", "type": "chemical", "note": "Includes references to asphalt and bitumen, used in preparations and tested for electrical properties.", "wikidata_id": "Q202251", "wikidata_description": "petroleum product", "wikipedia_extract": "Sealcoating, or pavement sealing, is the process of applying a protective coating to asphalt-based pavements to provide a layer of protection from the elements: water, oils, and U.V. damage. The effects of asphalt sealers have been debated. Asphalt sealing is marketed as increasing the life of the asphalt, but there is no independent research that proves these claims. Asphalt sealing can also make the asphalt more slippery and impact the environment. There are concerns about pavement sealer polluting the environment after it is abraded from the surface of the pavement.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sealcoat"}}, {"canonical_name": "Sponge", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "sponge", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Sponge", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Sponge"], "contexts": ["organism that swells in stomach", "porous marine organism"]}, {"entity_id": "sponges", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sponges", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["sponges"], "contexts": ["aquatic invertebrates"]}, {"entity_id": "sponges", "book_id": "first_principles_spencer_1862", "name": "sponges", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["sponges"], "contexts": ["marine invertebrates"]}, {"entity_id": "sponge", "book_id": "first_principles_spencer_1862", "name": "sponge", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["sponge"], "contexts": ["aquatic invertebrate with porous body"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sponge", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sponges", "similarity": 0.92}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sponge", "target_book": "first_principles_spencer_1862", "target_name": "sponges", "similarity": 0.92}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sponge", "target_book": "first_principles_spencer_1862", "target_name": "sponge", "similarity": 0.879}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "sponges", "target_book": "first_principles_spencer_1862", "target_name": "sponges", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "sponges", "target_book": "first_principles_spencer_1862", "target_name": "sponge", "similarity": 0.854}], "id": 471, "stable_key": "clu_64f7ecb494b2718f", "ground_truth": {"modern_name": "Sponge", "confidence": "high", "type": "animal", "note": "Refers to sponges as organisms, aquatic invertebrates, and marine invertebrates. One context mentions a sponge swelling in the stomach, possibly referring to a medicinal preparation or a misidentification.", "wikidata_id": "Q18960", "wikidata_description": "phylum of animals", "wikipedia_extract": "Sponges or sea sponges are primarily marine invertebrates of the animal phylum Porifera (; meaning 'pore bearer'). They are sessile filter feeders that are bound to the seabed, and are one of the most ancient members of macrobenthos, with many historical species being important reef-building organisms. Sponges are multicellular organisms consisting of jelly-like mesohyl sandwiched between two thin layers of cells, and usually have tube-like bodies full of pores and channels that allow water to circulate through them. They have unspecialized cells that can transform into other types and that often migrate between the main cell layers and the mesohyl in the process. They do not have complex nervous, digestive or circulatory systems. Instead, most rely on maintaining a constant water flow through their bodies to obtain food and oxygen and to remove wastes, usually via flagella movements of the so-called \"collar cells\".", "wikipedia_url": "https://en.wikipedia.org/wiki/Sponge"}}, {"canonical_name": "Atheism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "atheism", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Atheism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Atheism"], "contexts": ["denial of God's existence", "belief in no God"]}, {"entity_id": "atheism", "book_id": "principles_of_psychology_james_1890", "name": "Atheism", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "count": 1, "variants": ["Atheism"], "contexts": ["belief system"]}, {"entity_id": "atheism", "book_id": "first_principles_spencer_1862", "name": "Atheism", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["Atheism"], "contexts": ["theory of the universe, negation of religion"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Atheism", "target_book": "first_principles_spencer_1862", "target_name": "Atheism", "similarity": 0.838}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Atheism", "target_book": "first_principles_spencer_1862", "target_name": "Atheism", "similarity": 0.816}], "id": 472, "stable_key": "clu_51097c80aa5fd547", "ground_truth": {"modern_name": "Atheism", "confidence": "high", "type": "concept", "note": "Consistent references to the denial of God's existence and related belief systems or theories.", "wikidata_id": "Q116795590", "wikidata_description": "incorrect assumption that atheism is an organized religion", "wikipedia_extract": "Atheism, in the broadest sense, is an absence of belief in the existence of deities. Less broadly, atheism is a rejection of the belief that any deities exist. In an even narrower sense, atheism is specifically the position that there are no deities. Atheism is contrasted with theism, which is the belief that at least one deity exists. Historically, evidence of atheistic viewpoints can be traced back to classical antiquity and early Indian philosophy. In the Western world, atheism declined after Christianity gained prominence."}}, {"canonical_name": "Norimberg", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "norimberg", "book_id": "english_physician_1652", "name": "Norimberg", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Norimberg"], "contexts": ["seat of Free State", "Free State of Norimberg"]}, {"entity_id": "nürnberg", "book_id": "principles_of_psychology_james_1890", "name": "Nürnberg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Nürnberg"], "contexts": ["city where larceny was performed"]}, {"entity_id": "nuremburg", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Nuremburg", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Nuremburg"], "contexts": ["location of comet observations"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Norimberg", "target_book": "principles_of_psychology_james_1890", "target_name": "Nürnberg", "similarity": 0.884}, {"source_book": "english_physician_1652", "source_name": "Norimberg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Nuremburg", "similarity": 0.895}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Nürnberg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Nuremburg", "similarity": 0.866}], "id": 473, "stable_key": "clu_1e10816455eb2e5a", "ground_truth": {"modern_name": "Nuremberg", "confidence": "high", "type": "place", "country": "Germany", "note": "Includes variant spellings of Nuremberg, a city known for historical events and scientific observations (e.g., comet observations).", "wikidata_id": "Q2090", "wikidata_description": "city in the German state of Bavaria", "wikipedia_extract": "Nuremberg (, NURE-əm-burg; German: Nürnberg [ˈnʏʁnbɛʁk] ; Mainfränkisch: Nämberch [ˈnɛmbɛrç]) is the largest city in Franconia and the second-largest city in the German state of Bavaria. Its 544,414 (2023) inhabitants make it the 14th-largest city in Germany. Nuremberg sits on the Pegnitz, which carries the name Regnitz from its confluence with the Rednitz in Fürth onwards (Pegnitz→ Regnitz→ Main→ Rhine→ North Sea), and on the Rhine–Main–Danube Canal, that connects the North Sea to the Black Sea. Lying in the Bavarian administrative region of Middle Franconia, it is the largest city and unofficial capital of the entire cultural region of Franconia. The city is surrounded on three sides by the Nürnberger Reichswald, a large forest, and in the north lies Knoblauchsland (garlic land), an extensive vegetable growing area and cultural landscape. The city forms a continuous conurbation with the neighbouring cities of Fürth, Erlangen and Schwabach, which is the heart of an urban area region with around 1.4 million inhabitants, while the larger Nuremberg Metropolitan Region has a population of approximately 3.6 million."}}, {"canonical_name": "Prayer", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "prayer", "book_id": "english_physician_1652", "name": "Prayer", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Prayer"], "contexts": ["religious observance"]}, {"entity_id": "saying_one's_prayers", "book_id": "principles_of_psychology_james_1890", "name": "saying one's prayers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["saying one's prayers"], "contexts": ["religious recitation"]}, {"entity_id": "prayers", "book_id": "principles_of_psychology_james_1890", "name": "prayers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["prayers"], "contexts": ["can be said with attention elsewhere"]}, {"entity_id": "prayer", "book_id": "principles_of_psychology_james_1890", "name": "prayer", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["prayer"], "contexts": ["communication with a deity"]}, {"entity_id": "oração", "book_id": "polyanthea_medicinal", "name": "Oração", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Oração"], "contexts": ["religious practice"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Prayer", "target_book": "principles_of_psychology_james_1890", "target_name": "saying one's prayers", "similarity": 0.892}, {"source_book": "english_physician_1652", "source_name": "Prayer", "target_book": "principles_of_psychology_james_1890", "target_name": "prayers", "similarity": 0.956}, {"source_book": "english_physician_1652", "source_name": "Prayer", "target_book": "principles_of_psychology_james_1890", "target_name": "prayer", "similarity": 0.979}, {"source_book": "english_physician_1652", "source_name": "Prayer", "target_book": "polyanthea_medicinal", "target_name": "Oração", "similarity": 0.946}, {"source_book": "principles_of_psychology_james_1890", "source_name": "saying one's prayers", "target_book": "polyanthea_medicinal", "target_name": "Oração", "similarity": 0.871}, {"source_book": "principles_of_psychology_james_1890", "source_name": "prayers", "target_book": "polyanthea_medicinal", "target_name": "Oração", "similarity": 0.922}, {"source_book": "principles_of_psychology_james_1890", "source_name": "prayer", "target_book": "polyanthea_medicinal", "target_name": "Oração", "similarity": 0.943}], "id": 474, "stable_key": "clu_42b95aa15b1bf557", "ground_truth": {"modern_name": "prayer", "confidence": "high", "type": "concept", "description": "Communication with or worship of a deity; religious observance.", "wikipedia_extract": "Prayer is an invocation or act that seeks to activate a rapport with an object of worship through deliberate communication. In the narrow sense, the term refers to an act of supplication or intercession directed towards a deity or a deified ancestor. More generally, prayer can also have the purpose of giving thanks or praise, and in comparative religion is closely associated with more abstract forms of meditation and with charms or spells. Prayer can take a variety of forms: it can be part of a set liturgy or ritual, and it can be performed alone or in groups. Prayer may take the form of a hymn, incantation, formal creedal statement, or a spontaneous utterance in the praying person. The act of prayer is attested in written sources as early as five thousand years ago."}}, {"canonical_name": "Marshes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "marshes", "book_id": "english_physician_1652", "name": "Marshes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Marshes"], "contexts": ["habitat for a sort of Bifoyl", "habitat of insects"]}, {"entity_id": "marshes", "book_id": "kosmos_humboldt_1845", "name": "marshes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["marshes"], "contexts": ["wetland areas"]}, {"entity_id": "marshy_ground", "book_id": "kosmos_humboldt_1845", "name": "marshy ground", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["marshy ground"], "contexts": ["wet, boggy land"]}, {"entity_id": "marshes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "marshes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["marshes"], "contexts": ["wetland areas"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Marshes", "target_book": "kosmos_humboldt_1845", "target_name": "marshes", "similarity": 0.984}, {"source_book": "english_physician_1652", "source_name": "Marshes", "target_book": "kosmos_humboldt_1845", "target_name": "marshy ground", "similarity": 0.893}, {"source_book": "english_physician_1652", "source_name": "Marshes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "marshes", "similarity": 0.984}, {"source_book": "kosmos_humboldt_1845", "source_name": "marshes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "marshes", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "marshy ground", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "marshes", "similarity": 0.92}], "id": 475, "stable_key": "clu_b192db04fba9b914", "ground_truth": {"modern_name": "Wetlands", "confidence": "high", "type": "place", "wikidata_id": "Q123110474", "wikidata_description": "family name", "wikipedia_extract": "A Wetlands is a distinct semi-aquatic ecosystem whose groundcovers are flooded or saturated in water, either permanently, for years or decades, or only seasonally. Flooding results in oxygen-poor (anoxic) processes taking place, especially in the soils. Wetlands form a transitional zone between waterbodies and dry lands, and are different from other terrestrial or aquatic ecosystems due to their vegetation's roots having adapted to oxygen-poor waterlogged soils. They are considered among the most biologically diverse of all ecosystems, serving as habitats to a wide range of aquatic and semi-aquatic plants and animals, with often improved water quality due to plant removal of excess nutrients such as nitrates and phosphorus. Wetlands exist on every continent, except Antarctica. The water in wetlands is either freshwater, brackish or saltwater.", "wikipedia_url": "https://en.wikipedia.org/wiki/Wetland"}}, {"canonical_name": "Royal Society", "category": "ORGANIZATION", "subcategory": "SOCIETY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "royal_society", "book_id": "kosmos_humboldt_1845", "name": "Royal Society", "category": "ORGANIZATION", "subcategory": "SOCIETY", "count": 2, "variants": ["Royal Society"], "contexts": ["scientific institution in London", "scientific society in London"]}, {"entity_id": "royal_society", "book_id": "principles_of_psychology_james_1890", "name": "Royal Society", "category": "ORGANIZATION", "subcategory": "SOCIETY", "count": 1, "variants": ["Royal Society"], "contexts": ["British scientific institution"]}, {"entity_id": "royal_society", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Royal Society", "category": "ORGANIZATION", "subcategory": "SOCIETY", "count": 2, "variants": ["Royal Society"], "contexts": ["scientific society where paper was read", "scientific society in London"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Royal Society", "target_book": "principles_of_psychology_james_1890", "target_name": "Royal Society", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Royal Society", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Royal Society", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Royal Society", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Royal Society", "similarity": 1.0}], "id": 476, "stable_key": "clu_4c84f729d18f9098", "ground_truth": {"modern_name": "Royal Society", "confidence": "high", "type": "organization", "wikidata_id": "Q1892802", "wikidata_description": "wildlife conservation organisation in the United Kingdom", "wikipedia_url": "https://en.wikipedia.org/wiki/Royal_Society_for_the_Protection_of_Birds", "wikipedia_extract": "The Royal Society for the Protection of Birds (RSPB) is a charitable organisation registered in England and Wales and in Scotland. It was founded in 1889. It works to promote conservation and protection of birds and the wider environment through public awareness campaigns, petitions and through the operation of nature reserves throughout the United Kingdom. In 2023/24 the RSPB had revenue of £169 million, 2,517 employees, 13,500 volunteers and 1.1 million members (including 195,000 youth members), making it one of the world's largest wildlife conservation organisations. The RSPB has many local groups and maintains 222 nature reserves. The origins of the RSPB lie with two groups of women, both formed in 1889: The Plumage League was founded by Emily Williamson at her house in Didsbury, Manchester, as a protest group campaigning against the use of great crested grebe and kittiwake skins and feathers in fur clothing."}}, {"canonical_name": "hair", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "hair", "book_id": "principles_of_psychology_james_1890", "name": "hair", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 2, "variants": ["hair"], "contexts": ["filaments growing from skin", "body appendage"]}, {"entity_id": "hairs", "book_id": "origin_of_species_darwin_1859", "name": "hairs", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["hairs"], "contexts": ["clothed the style"]}, {"entity_id": "hairs", "book_id": "kosmos_humboldt_1845", "name": "hairs", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["hairs"], "contexts": ["structures on land plants"]}, {"entity_id": "woolly_hair", "book_id": "kosmos_humboldt_1845", "name": "woolly hair", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["woolly hair"], "contexts": ["hair texture characteristic"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "hair", "target_book": "origin_of_species_darwin_1859", "target_name": "hairs", "similarity": 0.98}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hair", "target_book": "kosmos_humboldt_1845", "target_name": "hairs", "similarity": 0.98}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hair", "target_book": "kosmos_humboldt_1845", "target_name": "woolly hair", "similarity": 0.883}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hairs", "target_book": "kosmos_humboldt_1845", "target_name": "hairs", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hairs", "target_book": "kosmos_humboldt_1845", "target_name": "woolly hair", "similarity": 0.879}], "id": 477, "stable_key": "clu_10cc9058109830da", "ground_truth": {"wikipedia_extract": "Hair is a protein filament that grows from follicles found in the dermis. Hair is one of the defining characteristics of mammals. The human body, apart from areas of glabrous skin, is covered in follicles which produce thick terminal and fine vellus hair. Most common interest in hair is focused on hair growth, hair types, and hair care, but hair is also an important biomaterial primarily composed of protein, notably alpha-keratin. Attitudes towards different forms of hair, such as hairstyles and hair removal, vary widely across different cultures and historical periods, but it is often used to indicate a person's personal beliefs or social position, such as their age, gender, or religion. The word \"hair\" usually refers to two distinct structures: the part beneath the skin, called the hair follicle, or, when pulled from the skin, the bulb or root."}}, {"canonical_name": "British Museum", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "british_museum", "book_id": "kosmos_humboldt_1845", "name": "British Museum", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "count": 3, "variants": ["British Museum"], "contexts": ["museum in London", "preserves skeleton slab"]}, {"entity_id": "british_museum", "book_id": "origin_of_species_darwin_1859", "name": "British Museum", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "count": 1, "variants": ["British Museum"], "contexts": ["institution where F. Smith worked"]}, {"entity_id": "british_museum", "book_id": "first_principles_spencer_1862", "name": "British Museum", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "count": 1, "variants": ["British Museum"], "contexts": ["museum with Egyptian art collection"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "British Museum", "target_book": "origin_of_species_darwin_1859", "target_name": "British Museum", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "British Museum", "target_book": "first_principles_spencer_1862", "target_name": "British Museum", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "British Museum", "target_book": "first_principles_spencer_1862", "target_name": "British Museum", "similarity": 1.0}], "id": 478, "stable_key": "clu_72a0b794b006d0d5", "ground_truth": {"modern_name": "British Museum", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q6373", "wikidata_description": "national museum in London, United Kingdom", "wikipedia_url": "https://en.wikipedia.org/wiki/British_Museum", "wikipedia_extract": "The Natural History Museum in London is a museum that exhibits a vast range of specimens from various segments of natural history. It is one of three major museums on Exhibition Road in South Kensington, the others being the Science Museum and the Victoria and Albert Museum. The Natural History Museum's main frontage, however, is on Cromwell Road. The museum is home to life and earth science specimens comprising some 80 million items within five main collections: botany, entomology, mineralogy, palaeontology and zoology. The museum is a centre of research specialising in taxonomy, identification and conservation. Given the age of the institution, many of the collections have great historical as well as scientific value, such as specimens collected by Charles Darwin."}}, {"canonical_name": "laws of nature", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "laws_of_nature", "book_id": "kosmos_humboldt_1845", "name": "laws of nature", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["laws of nature"], "contexts": ["governing forces of the physical world", "principles governing natural phenomena"]}, {"entity_id": "law_of_nature", "book_id": "origin_of_species_darwin_1859", "name": "law of nature", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["law of nature"], "contexts": ["fundamental principle of the universe"]}, {"entity_id": "law_of_nature", "book_id": "connexion_physical_sciences_somerville_1858", "name": "law of nature", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["Law of Nature", "law of nature"], "contexts": ["undulatory theory as", "fundamental principle of the universe"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "laws of nature", "target_book": "origin_of_species_darwin_1859", "target_name": "law of nature", "similarity": 0.983}, {"source_book": "kosmos_humboldt_1845", "source_name": "laws of nature", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "law of nature", "similarity": 0.983}, {"source_book": "origin_of_species_darwin_1859", "source_name": "law of nature", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "law of nature", "similarity": 1.0}], "id": 479, "stable_key": "clu_bf6447e86aea3d66", "ground_truth": {"modern_name": "Laws of nature", "confidence": "high", "type": "concept", "wikidata_id": "Q21191188", "wikidata_description": "1st episode of the 3rd season of Agents of S.H.I.E.L.D.", "wikipedia_extract": "Rights of nature or Earth rights is a legal and jurisprudential theory that describes inherent rights as associated with ecosystems and species, similar to the concept of fundamental human rights. The rights of nature concept challenges twentieth-century laws as generally grounded in a flawed frame of nature as \"resource\" to be owned, used, and degraded. Proponents argue that laws grounded in rights of nature direct humanity to act appropriately and in a way consistent with modern, system-based science, which demonstrates that humans and the natural world are fundamentally interconnected. This school of thought is underpinned by two basic lines of reasoning. First, since the recognition of human rights is based in part on the philosophical belief that those rights emanate from humanity's own existence, logically, so too do inherent rights of the natural world arise from the natural world's own existence. A second and more pragmatic argument asserts that the survival of humans depends on healthy ecosystems, and so protection of nature's rights in turn, advances human rights and well-being.", "wikipedia_url": "https://en.wikipedia.org/wiki/Physical_law"}}, {"canonical_name": "Glasgow", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "glasgow", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Glasgow", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Glasgow"], "contexts": ["city where William Thomson worked", "city associated with Thompson"]}, {"entity_id": "glasgow", "book_id": "origin_of_species_darwin_1859", "name": "Glasgow", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Glasgow"], "contexts": ["location of house-tumblers"]}, {"entity_id": "glasgow", "book_id": "first_principles_spencer_1862", "name": "Glasgow", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Glasgow"], "contexts": ["city with advantage in iron ship building"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Glasgow", "target_book": "origin_of_species_darwin_1859", "target_name": "Glasgow", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Glasgow", "target_book": "first_principles_spencer_1862", "target_name": "Glasgow", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Glasgow", "target_book": "first_principles_spencer_1862", "target_name": "Glasgow", "similarity": 1.0}], "id": 480, "stable_key": "clu_409e485174daf5e3", "ground_truth": {"modern_name": "Glasgow", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q4093", "wikidata_description": "city in Scotland, United Kingdom"}}, {"canonical_name": "irritability", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "irritability", "book_id": "principles_of_psychology_james_1890", "name": "irritability", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["irritability"], "contexts": ["tendency to react to stimuli", "heightened sensitivity of nerves"]}, {"entity_id": "irritation_vitale", "book_id": "relation_historique_humboldt_vol3_1825", "name": "irritation vitale", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["irritation vitale"], "contexts": ["life-related irritation"]}, {"entity_id": "irritantes", "book_id": "polyanthea_medicinal", "name": "Irritantes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["irritantes", "Irritantes"], "contexts": ["irritants", "medicines for stimulating"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "irritability", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "irritation vitale", "similarity": 0.846}, {"source_book": "principles_of_psychology_james_1890", "source_name": "irritability", "target_book": "polyanthea_medicinal", "target_name": "Irritantes", "similarity": 0.887}], "id": 481, "stable_key": "clu_29ef737ccd819f43", "ground_truth": {"modern_name": "irritability", "confidence": "high", "type": "concept", "description": "The inherent capacity of living tissue to respond to stimuli.", "wikipedia_extract": "Irritability is the excitatory ability that living organisms have to respond to changes in their environment. The term is used for both the physiological reaction to stimuli and for the pathological, abnormal or excessive sensitivity to stimuli. When reflecting human emotion and behavior, it is commonly defined as the tendency to react to stimuli with negative affective states (especially anger) and temper outbursts, which can be aggressive. Distressing or impairing irritability is important from a mental health perspective as a common symptom of concern and predictor of clinical outcomes. Irritability is the intrinsic ability that living organisms have to respond to changes in their environment. The term is used for both the physiological reaction to stimuli and for the pathological, abnormal or excessive sensitivity to stimuli."}}, {"canonical_name": "Orivante", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "orivante", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Orivante", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Orivante", "Oiivante"], "contexts": ["river in South America", "river in Venezuela"]}, {"entity_id": "orotava", "book_id": "kosmos_humboldt_1845", "name": "Orotava", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Orotava"], "contexts": ["vine-clad slopes of a mountain"]}, {"entity_id": "oriére", "book_id": "historia_medicinal_monardes_1574", "name": "Oriére", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Oriére"], "contexts": ["location where Bezoar stone is found"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Orivante", "target_book": "kosmos_humboldt_1845", "target_name": "Orotava", "similarity": 0.848}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Orivante", "target_book": "historia_medicinal_monardes_1574", "target_name": "Oriére", "similarity": 0.85}], "id": 482, "stable_key": "clu_d4cfb9c46f87b6c4", "ground_truth": {"modern_name": "Orotava", "confidence": "high", "type": "place", "country": "Spain", "note": "The cluster contains a mix of spellings and contexts that strongly point to Puerto de la Cruz (historically Orotava) in Tenerife, Canary Islands. 'Orivante' might be a transcription error of 'Orotava'.", "wikidata_id": "Q7103871", "wikidata_description": "genus of insects", "wikipedia_extract": "Tenerife ( TEN-ə-REEF-(ay); Spanish: [teneˈɾife] ; formerly spelled Teneriffe) is the largest and most-populous island of the Canary Islands, an autonomous community of Spain. With a land area of 2,034.38 km2 (785.48 mi2) and a population of 969,691 inhabitants as of October 2025, it is the most-populous island in Spain and the entire Macaronesia region. Tenerife is also home to 42.7% of the total population of the archipelago. More than seven million tourists (7,384,707 in 2024) visit Tenerife each year, making it by far the most visited island in the archipelago. It is one of the most important tourist destinations in Spain and the world, hosting one of the world's largest carnivals, the Carnival of Santa Cruz de Tenerife. The capital of the island, Santa Cruz de Tenerife, is also the seat of the island council (cabildo insular).", "wikipedia_url": "https://en.wikipedia.org/wiki/Orotava"}}, {"canonical_name": "Alexandre VI", "category": "PERSON", "subcategory": "PATRON", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "alexandre_vi", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Alexandre VI", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["Alexandre VI", "pape Alexandre VI"], "contexts": ["pope who issued a bull", "Pope who issued a decree in favor of Spain"]}, {"entity_id": "pope_alexander_vi", "book_id": "kosmos_humboldt_1845", "name": "Pope Alexander VI", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Pope Alexander VI"], "contexts": ["papal authority dividing hemispheres"]}, {"entity_id": "alexandre_vi", "book_id": "coloquios_da_orta_1563", "name": "Alexandre VI", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Alexandre VI"], "contexts": ["Pope who issued a papal bull"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Alexandre VI", "target_book": "kosmos_humboldt_1845", "target_name": "Pope Alexander VI", "similarity": 0.841}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Alexandre VI", "target_book": "coloquios_da_orta_1563", "target_name": "Alexandre VI", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Pope Alexander VI", "target_book": "coloquios_da_orta_1563", "target_name": "Alexandre VI", "similarity": 0.841}], "id": 483, "stable_key": "clu_77ae396331b7dccb", "ground_truth": {"modern_name": "Pope Alexander VI", "confidence": "high", "type": "person", "birth_year": 1431, "death_year": 1503, "description": "Papal authority involved in dividing hemispheres", "wikidata_id": "Q108316", "wikidata_description": "pope of the Catholic Church 1492–1503 from the Borgia family (1430/32-1503)", "wikipedia_extract": "Giovanni Borgia, 2nd Duke of Gandía (Spanish: Juan de Borja; Valencian: Joan Borja; c. 1476 – 14 June 1497) was the second child of Pope Alexander VI and Vannozza dei Cattanei and a member of the House of Borgia. He was the brother of Cesare, Gioffre, and Lucrezia Borgia. Giovanni Borgia was the pope's favourite son, and Alexander VI granted him important positions and honours. He was murdered in Rome on 14 June 1497. The case remained unsolved and is still considered one of the most notorious scandals of the Borgia era.", "wikipedia_url": "https://en.wikipedia.org/wiki/Pope_Alexander_VI"}}, {"canonical_name": "Aralia", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "aralia", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Aralia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Aralia", "Aralia turbacensis"], "contexts": ["alpine shrub found in Silla de Caracas", "plant from Turbaco"]}, {"entity_id": "aralia", "book_id": "kosmos_humboldt_1845", "name": "aralia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["aralia"], "contexts": ["delicate social plant"]}, {"entity_id": "aranci", "book_id": "ricettario_fiorentino_1597", "name": "aranci", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["aranci"], "contexts": ["orange fruits used in preparation", "citrus fruit for preserves"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Aralia", "target_book": "kosmos_humboldt_1845", "target_name": "aralia", "similarity": 0.964}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Aralia", "target_book": "ricettario_fiorentino_1597", "target_name": "aranci", "similarity": 0.842}, {"source_book": "kosmos_humboldt_1845", "source_name": "aralia", "target_book": "ricettario_fiorentino_1597", "target_name": "aranci", "similarity": 0.881}], "id": 484, "stable_key": "clu_778b93d8a911b9c4", "ground_truth": {"wikipedia_extract": "Aralia , or spikenard, is a genus of the family Araliaceae, consisting of 68 accepted species of deciduous or evergreen trees, shrubs, and rhizomatous herbaceous perennials. The genus is native to Asia and the Americas, with most species occurring in mountain woodlands. Aralia plants vary in size, with some herbaceous species only reaching 50 centimetres (20 in) tall, while some are trees growing to 20 metres (66 ft) tall. Aralia plants have large bipinnate (doubly compound) leaves clustered at the ends of their stems or branches; in some species the leaves are covered with bristles. The stems of some woody species are quite prickly, as in Aralia spinosa. The flowers are whitish or greenish occurring in terminal panicles, and the spherical dark purple berry-like fruits are popular with birds."}}, {"canonical_name": "Nismes", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "nismes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Nismes", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Nismes"], "contexts": ["city of observation", "location of geological observation"]}, {"entity_id": "nismes", "book_id": "kosmos_humboldt_1845", "name": "Nismes", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Nismes"], "contexts": ["location associated with Valz"]}, {"entity_id": "nimes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Nimes", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Nimes"], "contexts": ["location where M. Valz discovered a planet", "city where a planet was discovered"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Nismes", "target_book": "kosmos_humboldt_1845", "target_name": "Nismes", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Nismes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Nimes", "similarity": 0.852}, {"source_book": "kosmos_humboldt_1845", "source_name": "Nismes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Nimes", "similarity": 0.852}], "id": 485, "stable_key": "clu_c14575b85e7f8333", "ground_truth": {"modern_name": "Nîmes", "confidence": "high", "type": "place", "country": "France", "wikidata_id": "Q42807", "wikidata_description": "city and prefecture of the Gard department in the Occitanie region of Southern France", "wikipedia_extract": "The siege of Nîmes took place shortly after the capture and destruction of Avignon in 737. Charles Martel failed to capture the Umayyad city of Narbonne but devastated most of the other principal settlements of Septimania, including Nîmes, Agde, Béziers and Maguelonne, which he viewed as potential strongholds of the Saracens. The city of Nîmes (Chronicle of Fredegar) and the Roman amphitheatre (turned into a fortress by the Visigoths) were destroyed under the orders of Charles Martel. The Arabs were temporarily contained to the city of Narbonne, though a second expedition was needed later that year to regain control of Provence after Arab forces returned. According to Paul the Deacon's Historia Langobardorum the Arabs retreated when they learned that Martel had formed an alliance with the Lombards. Martel's remaining years - he had only four to live - were spent setting up and strengthening the administrative structure that became the Carolingian Empire, and the feudal state that would persist through the Dark Ages.", "wikipedia_url": "https://en.wikipedia.org/wiki/N%C3%AEmes"}}, {"canonical_name": "aldeas", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "aldeas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "aldeas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["aldeas"], "contexts": ["small rural settlements", "settlement type"]}, {"entity_id": "aldea", "book_id": "historia_medicinal_monardes_1574", "name": "aldea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["aldea"], "contexts": ["small village"]}, {"entity_id": "aldeas", "book_id": "polyanthea_medicinal", "name": "Aldeas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Aldeas"], "contexts": ["small villages", "villages within the kingdom"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "aldeas", "target_book": "historia_medicinal_monardes_1574", "target_name": "aldea", "similarity": 0.83}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "aldeas", "target_book": "polyanthea_medicinal", "target_name": "Aldeas", "similarity": 0.91}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "aldea", "target_book": "polyanthea_medicinal", "target_name": "Aldeas", "similarity": 0.883}], "id": 486, "stable_key": "clu_187222949458072c", "ground_truth": {"modern_name": "aldea", "confidence": "high", "type": "place", "description": "A small rural settlement or village.", "wikipedia_extract": "A hamlet is a human settlement that is smaller than a town or village. This is often simply an informal description of a smaller settlement or possibly a subdivision or satellite entity to a larger settlement. Sometimes, a hamlet is defined for official or administrative purposes. The word and concept of a hamlet can be traced back to Norman England, where the Old French hamelet came to apply to small human settlements. The word comes from Anglo-Norman hamelet, corresponding to Old French hamelet, the diminutive of Old French hamel meaning a little village. This, in turn, is a diminutive of Old French ham, possibly borrowed from (West Germanic) Franconian languages."}}, {"canonical_name": "reino", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "reino", "book_id": "coloquios_da_orta_1563", "name": "reino", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["reino", "Reino"], "contexts": ["kingdom whose ships were loaded", "destination for drugs"]}, {"entity_id": "reyes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Reyes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Reyes"], "contexts": ["village on western border"]}, {"entity_id": "regno", "book_id": "ricettario_fiorentino_1597", "name": "Regno", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Regno"], "contexts": ["the Kingdom", "origin of yellow earth"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "reino", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Reyes", "similarity": 0.851}, {"source_book": "coloquios_da_orta_1563", "source_name": "reino", "target_book": "ricettario_fiorentino_1597", "target_name": "Regno", "similarity": 0.935}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Reyes", "target_book": "ricettario_fiorentino_1597", "target_name": "Regno", "similarity": 0.846}], "id": 487, "stable_key": "clu_b60ed571f57d7094", "ground_truth": {"modern_name": "kingdom", "confidence": "high", "type": "place", "description": "A territory ruled by a king or queen.", "note": "Includes references to specific kingdoms and generic 'kingdom' as a political entity.", "wikipedia_extract": "The United Kingdom is a country located off the north-western coast of continental Europe. It comprises England, Scotland, Wales and Northern Ireland. With a total area of approximately 244,376 square kilometres (94,354 sq mi), the UK occupies the major part of the British Isles archipelago and includes the island of Great Britain, the north-eastern one-sixth of the island of Ireland and many smaller surrounding islands. It is the world's 7th largest island country. The mainland areas lie between latitudes 49°N and 59°N (the Shetland Islands reach to nearly 61°N), and longitudes 8°W to 2°E. The Royal Observatory, Greenwich, in south-east London, is the defining point of the Prime Meridian."}}, {"canonical_name": "Madras", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "madras", "book_id": "coloquios_da_orta_1563", "name": "Madras", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Madras", "Madrasta"], "contexts": ["publication location of Indian Botany", "modern city mentioned"]}, {"entity_id": "madras", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Madras", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Madras"], "contexts": ["city with observed average temperature"]}, {"entity_id": "madras", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Madras", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Madras"], "contexts": ["location of astronomical observations", "Saturn’s ring discovered from"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Madras", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Madras", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Madras", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Madras", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Madras", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Madras", "similarity": 1.0}], "id": 488, "stable_key": "clu_53eec313c48484c4", "ground_truth": {"wikipedia_extract": "Chennai, also known as Madras (its official name until 1996), is the capital and largest city of Tamil Nadu, the southernmost state of India. It is located on the Coromandel Coast of the Bay of Bengal. According to the 2011 Indian census, Chennai is the sixth-most-populous city in India and forms the fourth-most-populous urban agglomeration. Incorporated in 1688, the Greater Chennai Corporation is the oldest municipal corporation in India and the second oldest in the world after London. Historically, the region was part of the Chola, Pandya, Pallava and Vijayanagara kingdoms during various eras. The coastal land which then contained the fishing village Madrasapattinam, was purchased by the British East India Company from the Nayak ruler Chennapa Nayaka in the 17th century."}}, {"canonical_name": "villa", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "villa", "book_id": "relation_historique_humboldt_vol3_1825", "name": "villa", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["villa", "Vilela"], "contexts": ["town or small city", "settlement type"]}, {"entity_id": "villane", "book_id": "ricettario_fiorentino_1597", "name": "Villane", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Villane"], "contexts": ["location of medicinal baths"]}, {"entity_id": "villas", "book_id": "polyanthea_medicinal", "name": "Villas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Villas"], "contexts": ["towns within the kingdom"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "villa", "target_book": "ricettario_fiorentino_1597", "target_name": "Villane", "similarity": 0.815}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "villa", "target_book": "polyanthea_medicinal", "target_name": "Villas", "similarity": 0.93}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Villane", "target_book": "polyanthea_medicinal", "target_name": "Villas", "similarity": 0.831}], "id": 489, "stable_key": "clu_8ced08911cc5f9a0", "ground_truth": {"modern_name": "villa", "confidence": "high", "type": "place", "description": "A town or a small city, often with surrounding lands.", "wikipedia_extract": "A villa is a type of house that was originally an ancient Roman upper class country house that provided an escape from urban life. Since its origins in the Roman villa, the idea and function of a villa have evolved considerably. After the fall of the Roman Republic, villas became small farming compounds, which were increasingly fortified in Late Antiquity, sometimes transferred to the Church for reuse as a monastery. They gradually re-evolved through the Middle Ages into elegant upper-class country homes. In the early modern period, any comfortable detached house with a garden near a city or town was likely to be described as a villa; most surviving villas have now been engulfed by suburbia. In modern parlance, \"villa\" can refer to various types and sizes of residences, ranging from the suburban semi-detached double villa to, in some countries, especially around the Mediterranean, residences of above average size in the countryside. the villa urbana, a suburban or country seat that could easily be reached from Rome or another city for a night or two."}}, {"canonical_name": "Pisa", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "pisa", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pisa", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["pisa", "Pisa"], "contexts": ["treading of clay", "city"]}, {"entity_id": "pisa", "book_id": "polyanthea_medicinal", "name": "Pisa", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Pisa"], "contexts": ["city where scholar studied medicine"]}, {"entity_id": "pisa", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Pisa", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Pisa"], "contexts": ["location of Professor Mossotti", "city where Professor Matteucci was from"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pisa", "target_book": "polyanthea_medicinal", "target_name": "Pisa", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pisa", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Pisa", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Pisa", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Pisa", "similarity": 1.0}], "id": 490, "stable_key": "clu_eb85f40275159afd", "ground_truth": {"wikipedia_extract": "Pisa ( PEE-zə; Italian: [ˈpiːza]  or [ˈpiːsa]) is a city and comune (municipality) in Tuscany, Central Italy, straddling the Arno just before it empties into the Ligurian Sea. It is the capital city of the Province of Pisa. Although Pisa is known worldwide for the Leaning Tower of Pisa, the city contains more than twenty other historic churches, and several medieval and Renaissance palaces, mostly facing each other on the avenues along the Arno (\"Lungarno\"). Much of the city's architecture was financed from its history as one of the Italian maritime republics. The city is also home to the University of Pisa, which has a history going back to the 12th century, the Scuola Normale Superiore di Pisa, founded by Napoleon in 1810, and its offshoot, the Sant'Anna School of Advanced Studies. Most believe the hypothesis that the origin of the name Pisa comes from Etruscan and means 'mouth', as Pisa is at the mouth of the Arno river."}}, {"canonical_name": "diaphragm", "category": "ANATOMY", "subcategory": "ORGAN", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "diaphragm", "book_id": "principles_of_psychology_james_1890", "name": "diaphragm", "category": "ANATOMY", "subcategory": "ORGAN", "count": 3, "variants": ["diaphragm"], "contexts": ["innervated bilaterally for breathing", "muscle for breathing"]}, {"entity_id": "diaphragm", "book_id": "kosmos_humboldt_1845", "name": "diaphragm", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["diaphragm"], "contexts": ["anatomical structure"]}, {"entity_id": "diaphragm", "book_id": "first_principles_spencer_1862", "name": "diaphragm", "category": "ANATOMY", "subcategory": "ORGAN", "count": 1, "variants": ["diaphragm"], "contexts": ["muscle separating chest and abdomen"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "diaphragm", "target_book": "kosmos_humboldt_1845", "target_name": "diaphragm", "similarity": 0.912}, {"source_book": "principles_of_psychology_james_1890", "source_name": "diaphragm", "target_book": "first_principles_spencer_1862", "target_name": "diaphragm", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "diaphragm", "target_book": "first_principles_spencer_1862", "target_name": "diaphragm", "similarity": 0.912}], "id": 491, "stable_key": "clu_3de461703195f694", "ground_truth": {"modern_name": "diaphragm", "confidence": "high", "type": "concept", "note": "While the diaphragm is an anatomical organ, the contexts provided emphasize its function and role rather than its specific physicality, suggesting a conceptual understanding in these texts.", "wikidata_id": "Q2163245", "wikidata_description": "diaphragm disease characterized by the lack of development of all or part of the diaphragm, which results in an abnormal opening that allows the stomach and intestines to move into the chest cavity and crowd the heart and lungs", "wikipedia_url": "https://en.wikipedia.org/wiki/Congenital_diaphragmatic_hernia", "wikipedia_extract": "The thoracic diaphragm, or simply the diaphragm (; Ancient Greek: διάφραγμα, romanized: diáphragma, lit. 'partition'), is a sheet of internal skeletal muscle in humans and other mammals that extends across the bottom of the thoracic cavity. The diaphragm is the most important muscle of respiration, and separates the thoracic cavity, containing the heart and lungs, from the abdominal cavity: as the diaphragm contracts, the volume of the thoracic cavity increases, creating a negative pressure there, which draws air into the lungs. Its high oxygen consumption is noted by the many mitochondria and capillaries present; more than in any other skeletal muscle. The term diaphragm in anatomy, created by Gerard of Cremona, can refer to other flat structures such as the urogenital diaphragm or pelvic diaphragm, but \"the diaphragm\" generally refers to the thoracic diaphragm. In humans, the diaphragm is slightly asymmetric—its right half is higher up (superior) to the left half, since the large liver rests beneath the right half of the diaphragm."}}, {"canonical_name": "silence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "silence", "book_id": "principles_of_psychology_james_1890", "name": "silence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["silence"], "contexts": ["absence of sound"]}, {"entity_id": "silence", "book_id": "kosmos_humboldt_1845", "name": "silence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["silence"], "contexts": ["absence of sound"]}, {"entity_id": "silence", "book_id": "connexion_physical_sciences_somerville_1858", "name": "silence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["silence"], "contexts": ["absence of sound"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "silence", "target_book": "kosmos_humboldt_1845", "target_name": "silence", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "silence", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "silence", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "silence", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "silence", "similarity": 1.0}], "id": 492, "stable_key": "clu_0bba1059bc396051", "ground_truth": {"modern_name": "silence", "confidence": "high", "type": "concept", "wikidata_id": "Q502261", "wikidata_description": "lack of audible sound", "wikipedia_url": "https://en.wikipedia.org/wiki/Silence", "wikipedia_extract": "Silence is the absence of ambient audible sound, the emission of sounds of such low intensity that they do not draw attention to themselves, or the state of having ceased to produce sounds; this latter sense can be extended to apply to the cessation or absence of any form of communication, whether through speech or other medium. Remaining mute can be a symptom of mental illness. Sometimes speakers fall silent when they hesitate in searching for a word, or interrupt themselves before correcting themselves. Discourse analysis shows that people use brief silences to mark the boundaries of prosodic units, in turn-taking, or as reactive tokens, for example, as a sign of displeasure, disagreement, embarrassment, desire to think, confusion, and the like. Relatively prolonged intervals of silence can be used in rituals; in some religious disciplines, people maintain silence for protracted periods, or even for the rest of their lives, as an ascetic means of spiritual transformation. In the philosophy of perception and the science of perception, there has been a longstanding controversy as to how humans experience silence: \"the perceptual view (we literally hear silence), and the cognitive view (we only judge or infer silence)\", with prominent theories holding the latter view."}}, {"canonical_name": "Latin", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "latin", "book_id": "principles_of_psychology_james_1890", "name": "Latin", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Latin"], "contexts": ["language of distinction", "language and country"]}, {"entity_id": "latin", "book_id": "historia_medicinal_monardes_1574", "name": "Latin", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Latin"], "contexts": ["language of translation"]}, {"entity_id": "latin", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Latin", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Latin"], "contexts": ["ancient Indo-European language"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Latin", "target_book": "historia_medicinal_monardes_1574", "target_name": "Latin", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Latin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Latin", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Latin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Latin", "similarity": 1.0}], "id": 493, "stable_key": "clu_a04061d00b9f884f", "ground_truth": {"wikipedia_extract": "Latin (lingua Latina or Latinum) is a classical language belonging to the Italic branch of the Indo-European languages. Latin was originally spoken by the Latins in Latium (now known as Lazio), the lower Tiber area around Rome, Italy. Through the expansion of the Roman Republic, it became the dominant language in the Italian Peninsula and subsequently throughout the Roman Empire. It has greatly influenced many languages, including English, having contributed many words to the English lexicon, particularly after the Christianisation of the Anglo-Saxons and the Norman Conquest. Latin roots appear frequently in the technical vocabulary used by fields such as theology, the sciences, medicine, and law. By the late Roman Republic, Old Latin had evolved into standardised Classical Latin."}}, {"canonical_name": "Munich", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "munich", "book_id": "kosmos_humboldt_1845", "name": "Munich", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Munich"], "contexts": ["location where Lamont saw satellites", "city in Germany"]}, {"entity_id": "munich", "book_id": "coloquios_da_orta_1563", "name": "Munich", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Munich"], "contexts": ["city of publication"]}, {"entity_id": "munich", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Munich", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Munich"], "contexts": ["city where Fraunhofer worked"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Munich", "target_book": "coloquios_da_orta_1563", "target_name": "Munich", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Munich", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Munich", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Munich", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Munich", "similarity": 1.0}], "id": 494, "stable_key": "clu_5355b1f036488b1a", "ground_truth": {"modern_name": "Munich", "confidence": "high", "type": "place", "country": "Germany", "note": "The context of Fraunhofer working there solidifies the identification with the German city.", "wikidata_id": "Q1726", "wikidata_description": "capital and most populous city of Bavaria, Germany", "wikipedia_url": "https://en.wikipedia.org/wiki/Munich", "wikipedia_extract": "Munich is the capital and most populous city of Bavaria, Germany. As of 30 November 2024, its population was 1,604,384, making it the third-largest city in Germany after Berlin and Hamburg. Munich is the largest city in Germany that is not a state of its own, and it ranks as the 11th-largest city in the European Union. The metropolitan area has around 3 million inhabitants, and the broader Munich Metropolitan Region is home to about 6.2 million people. It is the third largest metropolitan region by GDP in the European Union. Munich is located on the river Isar north of the Alps."}}, {"canonical_name": "dieta", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "dieta", "book_id": "polyanthea_medicinal", "name": "dieta", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["dieta"], "contexts": ["diet", "medical practice for fevers"]}, {"entity_id": "dieta", "book_id": "historia_medicinal_monardes_1574", "name": "dieta", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["dieta"], "contexts": ["necessary regimen for healing"]}, {"entity_id": "dieta", "book_id": "coloquios_da_orta_1563", "name": "dieta", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["dieta"], "contexts": ["medical regimen"]}, {"entity_id": "adietando", "book_id": "polyanthea_medicinal", "name": "adietando", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["adietando"], "contexts": ["dieting, medical treatment"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "dieta", "target_book": "historia_medicinal_monardes_1574", "target_name": "dieta", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "dieta", "target_book": "coloquios_da_orta_1563", "target_name": "dieta", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "dieta", "target_book": "coloquios_da_orta_1563", "target_name": "dieta", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "dieta", "target_book": "polyanthea_medicinal", "target_name": "adietando", "similarity": 0.847}, {"source_book": "coloquios_da_orta_1563", "source_name": "dieta", "target_book": "polyanthea_medicinal", "target_name": "adietando", "similarity": 0.847}], "id": 495, "stable_key": "clu_1bb8ce21c0248c7b", "ground_truth": {"modern_name": "dietary regimen", "confidence": "high", "type": "concept", "description": "A prescribed course of eating for health or medical treatment.", "note": "Encompasses diet, medical regimen, and the practice of dieting.", "wikipedia_extract": "Dieting is the practice of eating food in a regulated way to decrease, maintain, or increase body weight, or to prevent and treat diseases such as diabetes and obesity. As weight loss depends on calorie intake, different kinds of calorie-reduced diets, such as those emphasising particular macronutrients (low-fat, low-carbohydrate, etc.), have been shown to be no more effective than one another. As weight regain is common, diet success is best predicted by long-term adherence. Regardless, the outcome of a diet can vary widely depending on the individual. The first popular diet was \"Banting\", named after English undertaker William Banting. In his 1863 pamphlet, Letter on Corpulence, Addressed to the Public, he outlined the details of a particular low-carbohydrate, low-calorie diet that led to his own dramatic weight loss."}}, {"canonical_name": "Evangelho", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "evangelho", "book_id": "polyanthea_medicinal", "name": "Evangelho", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Evangelho"], "contexts": ["religious text", "Gospel, where the story is told"]}, {"entity_id": "gospel", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Gospel", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Gospel"], "contexts": ["Christian teachings"]}, {"entity_id": "gospel", "book_id": "english_physician_1652", "name": "Gospel", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Gospel"], "contexts": ["religious doctrine"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Evangelho", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Gospel", "similarity": 0.927}, {"source_book": "polyanthea_medicinal", "source_name": "Evangelho", "target_book": "english_physician_1652", "target_name": "Gospel", "similarity": 0.927}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gospel", "target_book": "english_physician_1652", "target_name": "Gospel", "similarity": 1.0}], "id": 496, "stable_key": "clu_fde5f7b4a8a3ff74", "ground_truth": {"modern_name": "Gospel", "confidence": "high", "type": "text", "note": "The Portuguese term 'Evangelho' directly translates to 'Gospel' and is used interchangeably with the English term in the provided contexts.", "wikidata_id": "Q18055855", "wikidata_description": "protein-coding gene in the species Homo sapiens", "wikipedia_extract": "The Gospel of Thomas (also known as the Coptic Gospel of Thomas) is a non-canonical sayings gospel. It was discovered near Nag Hammadi, Egypt, in 1945 among a group of books known as the Nag Hammadi library. Scholars speculate the works were buried in response to a letter from Bishop Athanasius declaring a strict canon of Christian scripture. Most scholars place the composition during the second century, while some have proposed dates as late as 250 AD and others have traced its signs of origins back to 60 AD. Some scholars have seen it as evidence of the existence of a \"Q source\" that might have been similar in its form as a collection of sayings of Jesus, without any accounts of his deeds or his life and death, referred to as a sayings gospel, though most conclude that Thomas depends on or harmonizes the Synoptics. The Coptic-language text, the second of seven contained in what scholars have designated as Nag Hammadi Codex II, comprises 114 sayings attributed to Jesus.", "wikipedia_url": "https://en.wikipedia.org/wiki/Gospel_of_Thomas"}}, {"canonical_name": "Holly-trees", "category": "PLANT", "subcategory": "TREE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "holly-trees", "book_id": "origin_of_species_darwin_1859", "name": "Holly-trees", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["holly-trees", "Holly-trees"], "contexts": ["plant species with separate male and female individuals", "sexes of trees"]}, {"entity_id": "holly", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Holly", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Holly"], "contexts": ["evergreen tree"]}, {"entity_id": "holly-bushes", "book_id": "english_physician_1652", "name": "Holly-Bushes", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Holly-Bushes"], "contexts": ["grows near Butchers-Broom"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Holly-trees", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Holly", "similarity": 0.945}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Holly-trees", "target_book": "english_physician_1652", "target_name": "Holly-Bushes", "similarity": 0.905}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Holly", "target_book": "english_physician_1652", "target_name": "Holly-Bushes", "similarity": 0.865}], "id": 497, "stable_key": "clu_82b71ab51f65deca", "ground_truth": {"modern_name": "holly", "confidence": "high", "type": "plant", "linnaean": "Ilex aquifolium Linnaeus", "family": "Aquifoliaceae", "note": "The description of male and female individuals and evergreen nature strongly points to Ilex aquifolium.", "wikipedia_extract": "Charles Hardin Holley (September 7, 1936 – February 3, 1959), known professionally by his stage name Buddy Holly, was an American singer, songwriter, and musician who was a central and pioneering figure of rock and roll. He was born to a musical family in Lubbock, Texas, during the Great Depression, and learned to play guitar and sing alongside his two siblings. Holly made his first appearance on local television in 1952, and the following year he formed the group Buddy and Bob with his friend Bob Montgomery. In 1955, after opening once for Elvis Presley, Holly decided to pursue a career in music. He played with Presley three times that year, and his band's style shifted from country and western to rock and roll. In October that year, when Holly opened for Bill Haley & His Comets, he was spotted by Nashville scout Eddie Crandall, who helped him get a contract with Decca Records.", "wikipedia_url": "https://en.wikipedia.org/wiki/Buddy_Holly"}}, {"canonical_name": "pyramides égyptiennes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "pyramides_égyptiennes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pyramides égyptiennes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["pyramides égyptiennes", "pyramides mexicaines"], "contexts": ["ancient Egyptian structures", "ancient Mexican structures"]}, {"entity_id": "ægyptian_monuments", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ægyptian Monuments", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Ægyptian Monuments"], "contexts": ["ancient Egyptian artifacts"]}, {"entity_id": "pyramid_of_cheops", "book_id": "kosmos_humboldt_1845", "name": "Pyramid of Cheops", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Pyramid of Cheops"], "contexts": ["ancient structure for comparison"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pyramides égyptiennes", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Ægyptian Monuments", "similarity": 0.909}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pyramides égyptiennes", "target_book": "kosmos_humboldt_1845", "target_name": "Pyramid of Cheops", "similarity": 0.878}], "id": 498, "stable_key": "clu_ea2413309d7aa408", "ground_truth": {"modern_name": "Egyptian pyramids", "confidence": "high", "type": "object", "wikidata_id": "Q175582", "wikidata_description": "ancient masonry structures constructed by ancient Egyptians", "wikipedia_extract": "The pyramid of Menkaure is the smallest of the three main pyramids of the Giza pyramid complex, located on the Giza Plateau in the southwestern outskirts of Cairo, Egypt. It is thought to have been built to serve as the tomb of the Fourth Dynasty King Menkaure. Menkaure's pyramid had an original height of 65.5 meters (215 ft), and was the smallest of the three major pyramids at the Giza Necropolis. It now stands at 61 m (200 ft) tall with a base of 108.5 m (356 ft). Its angle of incline is approximately 51°20′25″. It was constructed of limestone and Aswan granite.", "wikipedia_url": "https://en.wikipedia.org/wiki/Pyramid_of_Menkaure"}}, {"canonical_name": "Ferrara", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "ferrara", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ferrara", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Ferrara"], "contexts": ["Italian city, seat of Duke Alphonsus", "territory where misseltoe was absent"]}, {"entity_id": "ferrara", "book_id": "coloquios_da_orta_1563", "name": "Ferrara", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Ferrara"], "contexts": ["city where a lie was told"]}, {"entity_id": "ferrara", "book_id": "polyanthea_medicinal", "name": "Ferrara", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Ferrara"], "contexts": ["city associated with the Duke"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ferrara", "target_book": "coloquios_da_orta_1563", "target_name": "Ferrara", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ferrara", "target_book": "polyanthea_medicinal", "target_name": "Ferrara", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Ferrara", "target_book": "polyanthea_medicinal", "target_name": "Ferrara", "similarity": 1.0}], "id": 499, "stable_key": "clu_dac12304fb30d629", "ground_truth": {"wikipedia_extract": "Ferrara (; Italian: [ferˈraːra] ; Emilian: Fràra [ˈfraːra]) is a city and comune (municipality) in Emilia-Romagna, Northern Italy, capital of the province of Ferrara. As of 2016, it had 132,009 inhabitants. It is situated 44 kilometres (27 miles) northeast of Bologna, on the Po di Volano, a branch channel of the main stream of the Po River, located 5 km (3 miles) north. The town has broad streets and numerous palaces dating from the Renaissance, when it hosted the court of the House of Este. For its beauty and cultural importance, it has been designated by UNESCO as a World Heritage Site. The first documented settlements in the area of the present-day Province of Ferrara date from the 6th century BC."}}, {"canonical_name": "Hercules pillars", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "hercules_pillars", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hercules pillars", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Hercules pillars"], "contexts": ["symbol of immobility or limit"]}, {"entity_id": "hercules_redivivus", "book_id": "polyanthea_medicinal", "name": "Hercules redivivus", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Hercules redivivus"], "contexts": ["title of a book"]}, {"entity_id": "μ_herculis", "book_id": "connexion_physical_sciences_somerville_1858", "name": "μ Herculis", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["μ Herculis"], "contexts": ["star used as a reference point"]}, {"entity_id": "π_herculis", "book_id": "connexion_physical_sciences_somerville_1858", "name": "π Herculis", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["π Herculis"], "contexts": ["star used as a reference point"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hercules pillars", "target_book": "polyanthea_medicinal", "target_name": "Hercules redivivus", "similarity": 0.85}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hercules pillars", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "μ Herculis", "similarity": 0.843}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hercules pillars", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "π Herculis", "similarity": 0.884}, {"source_book": "polyanthea_medicinal", "source_name": "Hercules redivivus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "π Herculis", "similarity": 0.842}], "id": 500, "stable_key": "clu_671210eb5e6dd96d", "ground_truth": {"modern_name": "Pillars of Hercules", "confidence": "medium", "type": "concept", "note": "The cluster is ambiguous. 'Hercules pillars' and 'symbol of immobility or limit' point to the geographical concept. 'Hercules redivivus' could be a book title. 'μ Herculis' and 'π Herculis' are stars. Given the majority of references and the explicit mention of 'symbol of immobility or limit', 'Pillars of Hercules' is the most likely primary referent, with other entries representing different uses of the name or related astronomical objects.", "wikidata_id": "Q152854", "wikidata_description": "promontories that flank the entrance to the Strait of Gibraltar", "wikipedia_extract": "Mythological objects encompass a variety of items (e.g. weapons, armor, clothing) found in mythology, legend, folklore, tall tale, fable, religion, spirituality, superstition, and the paranormal from across the world. This list is organized according to the category of object. Armor of Achilles, created by Hephaestus and said to be impenetrable. (Greek mythology) Armor of Beowulf, a mail shirt made by Wayland the Smith. (Anglo-Saxon mythology) Armor of Örvar-Oddr, an impenetrable \"silken mailcoat\".", "wikipedia_url": "https://en.wikipedia.org/wiki/Pillars_of_Hercules"}}, {"canonical_name": "Dyarrhea", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "dyarrhea", "book_id": "polyanthea_medicinal", "name": "Dyarrhea", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["Dyarrhea", "as Diarrheas"], "contexts": ["diarrhea", "appropriate and effective for curing diarrheas"]}, {"entity_id": "diarhea", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Diarhea", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["Diarhea"], "contexts": ["medical condition with frequent occurrence"]}, {"entity_id": "diarrhœa", "book_id": "first_principles_spencer_1862", "name": "diarrhœa", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["diarrhœa"], "contexts": ["frequent loose bowel movements"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Dyarrhea", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Diarhea", "similarity": 0.975}, {"source_book": "polyanthea_medicinal", "source_name": "Dyarrhea", "target_book": "first_principles_spencer_1862", "target_name": "diarrhœa", "similarity": 0.968}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Diarhea", "target_book": "first_principles_spencer_1862", "target_name": "diarrhœa", "similarity": 0.968}], "id": 501, "stable_key": "clu_826da343cc3ead94", "ground_truth": {"modern_name": "diarrhea", "confidence": "high", "type": "disease", "modern_term": "diarrhea", "wikidata_id": "Q4293116", "wikidata_description": "Human disease", "wikipedia_extract": "Diarrhea (American English), also spelled diarrhoea or diarrhœa (British English), is the condition of having at least three loose, liquid, or watery bowel movements in a day. It often lasts for a few days and can result in dehydration due to fluid loss. Signs of dehydration often begin with loss of the normal stretchiness of the skin and irritable behaviour. This can progress to decreased urination, loss of skin color, a fast heart rate, and a decrease in responsiveness as it becomes more severe. Loose but non-watery stools in babies who are exclusively breastfed, however, are normal. The most common cause is an infection of the intestines due to a virus, bacterium, or parasite—a condition also known as gastroenteritis.", "wikipedia_url": "https://en.wikipedia.org/wiki/Diarrhea"}}, {"canonical_name": "verde", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "verde", "book_id": "coloquios_da_orta_1563", "name": "verde", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["verde"], "contexts": ["color of drying anil", "color of emeralds and jaspe"]}, {"entity_id": "green", "book_id": "english_physician_1652", "name": "green", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["green"], "contexts": ["state of borrage herb used"]}, {"entity_id": "verde", "book_id": "ricettario_fiorentino_1597", "name": "verde", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["verde"], "contexts": ["quality of oil"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "verde", "target_book": "english_physician_1652", "target_name": "green", "similarity": 0.958}, {"source_book": "coloquios_da_orta_1563", "source_name": "verde", "target_book": "ricettario_fiorentino_1597", "target_name": "verde", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "green", "target_book": "ricettario_fiorentino_1597", "target_name": "verde", "similarity": 0.958}], "id": 502, "stable_key": "clu_a87bb2ac0e425670", "ground_truth": {"modern_name": "green", "confidence": "high", "type": "concept", "description": "The color of plants, emeralds, and certain other substances.", "wikipedia_extract": "Green is the color between cyan and yellow on the visible spectrum. It is evoked by light which has a dominant wavelength of roughly 495–570 nm. In subtractive color systems, used in painting and color printing, it is created by a combination of yellow and cyan; in the RGB color model, used on television and computer screens, it is one of the additive primary colors, along with red and blue, which are mixed in different combinations to create all other colors. By far the largest contributor to green in nature is chlorophyll, the chemical by which plants photosynthesize and convert sunlight into chemical energy. Many creatures have adapted to their green environments by taking on a green hue themselves as camouflage. Several minerals have a green color, including the emerald, which is colored green by its chromium content."}}, {"canonical_name": "dissolve", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "dissolve", "book_id": "polyanthea_medicinal", "name": "dissolve", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["dissolve", "disolvendo"], "contexts": ["action of mercury on humors", "medical manipulation"]}, {"entity_id": "dissolves", "book_id": "english_physician_1652", "name": "Dissolves", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Dissolves"], "contexts": ["to break down or liquefy"]}, {"entity_id": "disoluere", "book_id": "ricettario_fiorentino_1597", "name": "Disoluere", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Disoluere"], "contexts": ["process of dissolving"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "dissolve", "target_book": "english_physician_1652", "target_name": "Dissolves", "similarity": 0.932}, {"source_book": "polyanthea_medicinal", "source_name": "dissolve", "target_book": "ricettario_fiorentino_1597", "target_name": "Disoluere", "similarity": 0.934}, {"source_book": "english_physician_1652", "source_name": "Dissolves", "target_book": "ricettario_fiorentino_1597", "target_name": "Disoluere", "similarity": 0.914}], "id": 503, "stable_key": "clu_66604fd0dff01882", "ground_truth": {"modern_name": "dissolution", "confidence": "high", "type": "concept", "wikidata_id": "Q3133701", "wikidata_description": "process of a solute dissolving in a solvent", "wikipedia_url": "https://en.wikipedia.org/wiki/Pralaya", "wikipedia_extract": "Pralaya (Sanskrit: प्रलय, romanized: Pralaya, lit. 'Destruction') is a concept in Hindu eschatology. Generally referring to four different phenomena, it is most commonly used to indicate the event of the dissolution of the entire universe that follows a kalpa (a period of 4.32 billion years) called the Brahmapralaya. Pralaya also refers to Nityapralaya, the continuous destruction of all animate and inanimate beings that occurs on a daily basis, Prakritapralaya, the great flood produced by Prakriti (Nature) that ends all of creation after the completion of 1,000 Chaturyuga (four-age) cycles, and Atyantikapralaya, the dissolution of one's Atman (Self) due to its union with Brahman (Ultimate Reality). A concept that has been referenced in literature since the Upanishads, the concept of pralaya has been widely discussed in Hindu cosmology as well as philosophy. Hindu cosmology posits an endless cycle of the periodic creation and destruction of the universe."}}, {"canonical_name": "Cornwall", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "cornwall", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cornwall", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Cornwall"], "contexts": ["county of Dalcoath mine", "location of hot-springs in mines"]}, {"entity_id": "cornwal", "book_id": "english_physician_1652", "name": "Cornwal", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Cornwal"], "contexts": ["location where Fumitory grows"]}, {"entity_id": "cornwall", "book_id": "first_principles_spencer_1862", "name": "Cornwall", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Cornwall"], "contexts": ["Cornishmen take to mining because Cornwall is metalliferous"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Cornwall", "target_book": "english_physician_1652", "target_name": "Cornwal", "similarity": 0.879}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Cornwall", "target_book": "first_principles_spencer_1862", "target_name": "Cornwall", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Cornwal", "target_book": "first_principles_spencer_1862", "target_name": "Cornwall", "similarity": 0.879}], "id": 504, "stable_key": "clu_0c23a995d0195f60", "ground_truth": {"modern_name": "Cornwall", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q37085529", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Cornwall", "wikipedia_extract": "Cornwall (; Cornish: Kernow [ˈkɛrnɔʊ] or [ˈkɛrnɔ]) is a ceremonial county in South West England. It is one of the Celtic nations and the homeland of the Cornish people. The county is bordered by the Atlantic Ocean to the north and west, Devon to the east, and the English Channel to the south. The largest urban area is the Redruth and Camborne conurbation. The county is predominantly rural, with an area of 1,375 square miles (3,562 km2) and an estimated population of 585,655 in 2024. The county's major settlements include the city of Truro and St Austell in the centre, Redruth and Cambourne adjacent to each other in the south, and Penzance and Falmouth on the southern coast."}}, {"canonical_name": "Ascension", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "ascension", "book_id": "origin_of_species_darwin_1859", "name": "Ascension", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Ascension"], "contexts": ["barren island with few native plants", "plants of"]}, {"entity_id": "ascension", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Ascension", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Ascension"], "contexts": ["island"]}, {"entity_id": "ascension", "book_id": "kosmos_humboldt_1845", "name": "Ascension", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Ascension"], "contexts": ["island of formation"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Ascension", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Ascension", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Ascension", "target_book": "kosmos_humboldt_1845", "target_name": "Ascension", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ascension", "target_book": "kosmos_humboldt_1845", "target_name": "Ascension", "similarity": 1.0}], "id": 505, "stable_key": "clu_2758d91ac7f76e1c", "ground_truth": {"modern_name": "Ascension Island", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q23653813", "wikidata_description": "island in Aysén Region, Chile", "wikipedia_extract": "Two Boats, also known as Two Boats Village, is a village at the foot of Green Mountain on Ascension Island. Founded in the early 19th century, it was a originally a resting point for sailors who sought to ascend the mountain. Before the village's establishment, two boats had been stuck in the area, perpendicular to the ground to provide shade for passersby, giving the new settlement the inspiration for its name. It has the island's only school, Two Boats School. Two Boats is located at the foot of Green Mountain, the highest point of Ascension Island. It is one of five settlements on the island.", "wikipedia_url": "https://en.wikipedia.org/wiki/Two_Boats,_Ascension_Island"}}, {"canonical_name": "experimentalist", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "experimentalist", "book_id": "origin_of_species_darwin_1859", "name": "experimentalist", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["experimentalist"], "contexts": ["one who conducts experiments"]}, {"entity_id": "experimentalists", "book_id": "origin_of_species_darwin_1859", "name": "experimentalists", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["experimentalists"], "contexts": ["individuals conducting experiments"]}, {"entity_id": "experimenters", "book_id": "principles_of_psychology_james_1890", "name": "experimenters", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["experimenters"], "contexts": ["individuals conducting experiments"]}, {"entity_id": "rational_experimentalist", "book_id": "kosmos_humboldt_1845", "name": "rational experimentalist", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["rational experimentalist"], "contexts": ["scientist guided by hypotheses"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "experimentalist", "target_book": "principles_of_psychology_james_1890", "target_name": "experimenters", "similarity": 0.947}, {"source_book": "origin_of_species_darwin_1859", "source_name": "experimentalist", "target_book": "kosmos_humboldt_1845", "target_name": "rational experimentalist", "similarity": 0.862}, {"source_book": "origin_of_species_darwin_1859", "source_name": "experimentalists", "target_book": "principles_of_psychology_james_1890", "target_name": "experimenters", "similarity": 0.962}, {"source_book": "origin_of_species_darwin_1859", "source_name": "experimentalists", "target_book": "kosmos_humboldt_1845", "target_name": "rational experimentalist", "similarity": 0.852}, {"source_book": "principles_of_psychology_james_1890", "source_name": "experimenters", "target_book": "kosmos_humboldt_1845", "target_name": "rational experimentalist", "similarity": 0.803}], "id": 506, "stable_key": "clu_80bdaf1698a6b806", "ground_truth": {"wikipedia_extract": "Experimentalism is the philosophical belief that the way to truth is through experiments and empiricism. It is also associated with instrumentalism, the belief that truth should be evaluated based upon its demonstrated usefulness. Experimentalism is considered a theory of knowledge that emphasizes direct action and scientific control as well as methods and consequences. Experimentalism is referred to as John Dewey's version of pragmatism. The theory, which he also called as practicalism, holds that the pattern for knowledge should be modern science and modern scientific methods. Dewey explained that philosophy involves the critical evaluation of belief and that the concept's function is practical."}}, {"canonical_name": "Staffordshire", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "staffordshire", "book_id": "origin_of_species_darwin_1859", "name": "Staffordshire", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Staffordshire"], "contexts": ["location of investigation", "location where insects affect birds"]}, {"entity_id": "staffordshire", "book_id": "kosmos_humboldt_1845", "name": "Staffordshire", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Staffordshire"], "contexts": ["county in England"]}, {"entity_id": "staffordshire", "book_id": "first_principles_spencer_1862", "name": "Staffordshire", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Staffordshire"], "contexts": ["pottery-manufacture"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Staffordshire", "target_book": "kosmos_humboldt_1845", "target_name": "Staffordshire", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Staffordshire", "target_book": "first_principles_spencer_1862", "target_name": "Staffordshire", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Staffordshire", "target_book": "first_principles_spencer_1862", "target_name": "Staffordshire", "similarity": 1.0}], "id": 507, "stable_key": "clu_81acb50f7318423f", "ground_truth": {"modern_name": "Staffordshire", "confidence": "high", "type": "place", "country": "United Kingdom", "wikipedia_extract": "Cheadle is a market town and civil parish in the Staffordshire Moorlands District of Staffordshire, England. It is located between Uttoxeter, Leek, Ashbourne and Stoke-on-Trent. Dating back to Anglo-Saxon times, it lies within the historic Staffordshire Hundred of Totmonslow. In 2011 the parish had a population of 12,165. Cheadle is first attested in the Domesday Book of 1086, in the forms Celle and Cedla. The first part of the name comes from the Common Brittonic word which survives in modern Welsh as coed (\"woodland\"), and was thus once a place-name meaning \"wood\".", "wikipedia_url": "https://en.wikipedia.org/wiki/Cheadle,_Staffordshire"}}, {"canonical_name": "Vulture", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "vulture", "book_id": "origin_of_species_darwin_1859", "name": "Vulture", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Vulture"], "contexts": ["naked skin on head"]}, {"entity_id": "vulture", "book_id": "kosmos_humboldt_1845", "name": "vulture", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["vulture"], "contexts": ["animal previously thought to be dodo"]}, {"entity_id": "bearded_vulture", "book_id": "connexion_physical_sciences_somerville_1858", "name": "bearded vulture", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["bearded vulture"], "contexts": ["confined to the Alps"]}, {"entity_id": "vulture", "book_id": "connexion_physical_sciences_somerville_1858", "name": "vulture", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["vulture"], "contexts": ["bird that spots prey from afar"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Vulture", "target_book": "kosmos_humboldt_1845", "target_name": "vulture", "similarity": 0.978}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Vulture", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "bearded vulture", "similarity": 0.908}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Vulture", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "vulture", "similarity": 0.978}, {"source_book": "kosmos_humboldt_1845", "source_name": "vulture", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "bearded vulture", "similarity": 0.909}, {"source_book": "kosmos_humboldt_1845", "source_name": "vulture", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "vulture", "similarity": 1.0}], "id": 508, "stable_key": "clu_fdcf07fed1d76b9e", "ground_truth": {"modern_name": "Vulture", "confidence": "high", "type": "animal", "note": "The mention of 'bearded vulture' and 'confined to the Alps' suggests Gyps fulvus or Gypaetus barbatus, but 'Vulture' generally refers to the family Accipitridae or Cathartidae.", "wikidata_id": "Q123120", "wikidata_description": "common name for several types of scavenging birds of prey", "wikipedia_extract": "Old World vultures are vultures that are found in the Old World, i.e. the continents of Europe, Asia and Africa, and which belong to the family Accipitridae, which also includes eagles, buzzards, kites, and hawks. Old World vultures are not closely related to the superficially similar New World vultures and condors, and do not share that group's good sense of smell. The similarities between the two groups of vultures are due to convergent evolution, rather than a close relationship. They were widespread in both the Old World and North America during the Neogene. Old World vultures are probably a polyphyletic group within Accipitridae, belonging to two separate not closely related groups within the family.", "wikipedia_url": "https://en.wikipedia.org/wiki/Vulture"}}, {"canonical_name": "Rodent", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "rodent", "book_id": "origin_of_species_darwin_1859", "name": "Rodent", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Rodent", "rodent"], "contexts": ["wider range than other rodents", "animal order with specific habits"]}, {"entity_id": "ran^e", "book_id": "ricettario_fiorentino_1597", "name": "ran^e", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["ran^e"], "contexts": ["crab that is burned and made into blades"]}, {"entity_id": "rodentia", "book_id": "first_principles_spencer_1862", "name": "Rodentia", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Rodentia"], "contexts": ["mammal order with divided uteri"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Rodent", "target_book": "ricettario_fiorentino_1597", "target_name": "ran^e", "similarity": 0.844}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Rodent", "target_book": "first_principles_spencer_1862", "target_name": "Rodentia", "similarity": 0.933}], "id": 509, "stable_key": "clu_192c7288f298eb4b", "ground_truth": {"wikipedia_extract": "Rodents (from Latin rōdēns, 'gnawing') are a group of mammals characterized by a single pair of continuously growing incisors in each of the upper and lower jaws. About 40% of all mammal species belong to the order Rodentia ( roh-DEN-shə or roh-DEN-chə). They are native to all major land masses except for Antarctica, and several oceanic islands, though they have subsequently been introduced to most of these land masses by human activity. Rodents are extremely diverse in their ecology and lifestyles and can be found in almost every terrestrial habitat, including human-made environments. Species can be arboreal, fossorial (burrowing), saltatorial/ricochetal (leaping on their hind legs), or semiaquatic. However, all rodents share several morphological features, including having only a single upper and lower pair of ever-growing incisors."}}, {"canonical_name": "Alger", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "alger", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Alger", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Alger"], "contexts": ["location of military combat", "city with sugar consumption"]}, {"entity_id": "algiers", "book_id": "principles_of_psychology_james_1890", "name": "Algiers", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Algiers"], "contexts": ["location mentioned in a subject's delusion"]}, {"entity_id": "algiers", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Algiers", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Algiers"], "contexts": ["French officers observed light phenomenon"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Alger", "target_book": "principles_of_psychology_james_1890", "target_name": "Algiers", "similarity": 0.922}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Alger", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Algiers", "similarity": 0.922}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Algiers", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Algiers", "similarity": 1.0}], "id": 510, "stable_key": "clu_92720f60a6b6aa80", "ground_truth": {"modern_name": "Algiers", "confidence": "high", "type": "place", "country": "Algeria", "wikidata_id": "Q3561", "wikidata_description": "capital city of Algeria", "wikipedia_extract": "Algiers is the capital city of Algeria, located on the Mediterranean Sea in the north-central portion of the country. In 2025, an estimated 4.325 million people resided within the urban area. Algiers is the largest city in Algeria, the third-largest city on the Mediterranean, the sixth-largest city in the Arab world, and the 29th-largest city in Africa by population. Algiers is the capital of the Algiers Province; it extends over many communes without having its own separate governing body. It extends along the Bay of Algiers surrounded by the Mitidja Plain and major mountain ranges. Its favorable location made it the center of Ottoman and French influences for the region, shaping it to be a diverse metropolis.", "wikipedia_url": "https://en.wikipedia.org/wiki/Algiers"}}, {"canonical_name": "luxuria", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "luxuria", "book_id": "polyanthea_medicinal", "name": "luxuria", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["luxuria"], "contexts": ["excessive sexual indulgence"]}, {"entity_id": "luxe", "book_id": "relation_historique_humboldt_vol3_1825", "name": "luxe", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["luxe"], "contexts": ["non-essential item"]}, {"entity_id": "luxus", "book_id": "principles_of_psychology_james_1890", "name": "Luxus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Luxus"], "contexts": ["term for something superfluous or excessive"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "luxuria", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "luxe", "similarity": 0.949}, {"source_book": "polyanthea_medicinal", "source_name": "luxuria", "target_book": "principles_of_psychology_james_1890", "target_name": "Luxus", "similarity": 0.933}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "luxe", "target_book": "principles_of_psychology_james_1890", "target_name": "Luxus", "similarity": 0.962}], "id": 511, "stable_key": "clu_8b8f07611c666a4c", "ground_truth": {"modern_name": "Luxury", "confidence": "high", "type": "concept", "note": "The Latin 'luxuria' can also mean 'excess' or 'licentiousness', but in the context of non-essential items and superfluity, 'luxury' is the most fitting modern equivalent.", "wikipedia_extract": "The Cadillac Urban Luxury Concept (ULC) is a gasoline-electric hybrid, 4-seater, city concept car manufactured by Cadillac and unveiled at the 2010 Los Angeles Auto Show. The ULC was designed by Niki Smart and features a signature wedge shaped styling cues from most of the Cadillac models of the 2000s. The ULC features touchpad screens and projected displays that take the place of traditional gauges. The ULC seats four adults, with access through a pair of scissor doors that extend outward and rotate forward when opened allowing easy access to all four seats. The ULC was powered by a 1.0L turbocharged 3-cylinder with 350kw electric power engine with a dual-clutch transmission and a hybrid propulsion system that employs electric assist technology, engine start-stop function, and brake energy regeneration. According to Cadillac, the ULC could potentially achieve 156 miles per US gallon (1.51 L/100 km; 187 mpg‑imp) in the city and 165 miles per US gallon (1.43 L/100 km; 198 mpg‑imp) on the highway.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cadillac_Urban_Luxury_Concept"}}, {"canonical_name": "Piémont", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "piémont", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Piémont", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Piémont"], "contexts": ["region in Italy"]}, {"entity_id": "piedmontese", "book_id": "kosmos_humboldt_1845", "name": "Piedmontese", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Piedmontese"], "contexts": ["region with valleys"]}, {"entity_id": "piedmont", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Piedmont", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Piedmont"], "contexts": ["region connected to Savoy"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Piémont", "target_book": "kosmos_humboldt_1845", "target_name": "Piedmontese", "similarity": 0.845}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Piémont", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Piedmont", "similarity": 0.915}, {"source_book": "kosmos_humboldt_1845", "source_name": "Piedmontese", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Piedmont", "similarity": 0.935}], "id": 512, "stable_key": "clu_a4b6776312dae1bd", "ground_truth": {"modern_name": "Piedmont", "confidence": "high", "type": "place", "country": "Italy", "wikidata_id": "Q1216", "wikidata_description": "region in North-West Italy", "wikipedia_extract": "Piedmont ( PEED-mont; Italian: Piemonte [pjeˈmonte]; Piedmontese: Piemont [pjeˈmʊŋt]) is one of the 20 regions of Italy, located in the Northwest of the country. It borders the Liguria region to the south, the Lombardy and Emilia-Romagna regions to the east, and the Aosta Valley region to the northwest. Piedmont also borders Switzerland to the north and France to the west. Piedmont has an area of 25,387.07 km2 (9,802.00 mi2), making it the 2nd-largest region of Italy in area after Sicily. With a population of 4,251,868, it is also the 7th-most populous region as of 2025. The capital of Piedmont is Turin, which was the first capital of the Kingdom of Italy, from 1861 to 1865.", "wikipedia_url": "https://en.wikipedia.org/wiki/Piedmont"}}, {"canonical_name": "Turin", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "turin", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Turin", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Turin"], "contexts": ["location of observation", "city in Italy"]}, {"entity_id": "turin", "book_id": "kosmos_humboldt_1845", "name": "Turin", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Turin"], "contexts": ["city in Italy"]}, {"entity_id": "turin", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Turin", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Turin"], "contexts": ["location of M. Botto's experiments"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Turin", "target_book": "kosmos_humboldt_1845", "target_name": "Turin", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Turin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Turin", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Turin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Turin", "similarity": 1.0}], "id": 513, "stable_key": "clu_fd497e8a05e4538a", "ground_truth": {"modern_name": "Turin", "confidence": "high", "type": "place", "country": "Italy", "wikidata_id": "Q495", "wikidata_description": "city and commune in Italy", "wikipedia_url": "https://en.wikipedia.org/wiki/Turin", "wikipedia_extract": "Turin is a city and an important business and cultural centre in northern Italy. It is the capital city of the Piedmont region and of the Metropolitan City of Turin. From 1861 to 1865, it was the first capital of the Kingdom of Italy. The city is mainly on the western bank of the River Po, below its Susa Valley, and is surrounded by the western Alpine arch and Superga hill. The population of the city proper is 853,196 as of 2025, while the population of the urban area is estimated by Eurostat to be 1.7 million inhabitants. The Turin metropolitan area is estimated by the OECD to have a population of 2.2 million."}}, {"canonical_name": "Moorcroft", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "moorcroft", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Moorcroft", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Moorcroft"], "contexts": ["collected herbarium in Chinese Tartary", "collected a herbarium"]}, {"entity_id": "moorcroft", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Moorcroft", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Moorcroft"], "contexts": ["measurer of mountain heights"]}, {"entity_id": "moorcroft", "book_id": "kosmos_humboldt_1845", "name": "Moorcroft", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Moorcroft"], "contexts": ["provided data on mountain elevations"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Moorcroft", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Moorcroft", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Moorcroft", "target_book": "kosmos_humboldt_1845", "target_name": "Moorcroft", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Moorcroft", "target_book": "kosmos_humboldt_1845", "target_name": "Moorcroft", "similarity": 1.0}], "id": 514, "stable_key": "clu_d1c90199556392ee", "ground_truth": {"modern_name": "William Moorcroft", "confidence": "high", "type": "person", "birth_year": 1765, "death_year": 1825, "description": "British physician, veterinary surgeon, and explorer in India", "wikidata_id": "Q8015764", "wikidata_description": "British potter (1872–1945)", "wikipedia_url": "https://en.wikipedia.org/wiki/William_Moorcroft_%28potter%29", "wikipedia_extract": "The following is a list of notable deaths in January 2026. Entries for each day are listed alphabetically by surname. A typical entry lists information in the following sequence: Name, age, country of citizenship at birth, subsequent country of citizenship (if applicable), reason for notability, cause of death (if known), and reference. Stuart Altman, 88, American economist. Marat Amankulov, 55, Kyrgyz politician, MP (2015–2021). Yvan Aumont, 87, French engineer and journalist (Lys rouge)."}}, {"canonical_name": "Col de la Seigne", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "col_de_la_seigne", "book_id": "kosmos_humboldt_1845", "name": "Col de la Seigne", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Col de la Seigne"], "contexts": ["mountain pass", "mountain pass location"]}, {"entity_id": "col_de_t'assuay", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Col de t'Assuay", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Col de t'Assuay"], "contexts": ["mountain pass name"]}, {"entity_id": "col_de_bonhomme", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Col de Bonhomme", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Col de Bonhomme"], "contexts": ["mountain pass between Savoy and Piedmont"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Col de la Seigne", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Col de t'Assuay", "similarity": 0.847}, {"source_book": "kosmos_humboldt_1845", "source_name": "Col de la Seigne", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Col de Bonhomme", "similarity": 0.854}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Col de t'Assuay", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Col de Bonhomme", "similarity": 0.828}], "id": 515, "stable_key": "clu_a4b36595e5218466", "ground_truth": {"modern_name": "Col de la Seigne", "confidence": "high", "type": "place", "country": "France", "note": "The variation 'Col de Bonhomme' refers to a nearby pass.", "wikidata_id": "Q867694", "wikidata_description": "mountain pass in France and Italy", "wikipedia_extract": "The Mont Blanc massif (French: Massif du Mont-Blanc [masif dy mɔ̃ blɑ̃]; Italian: Massiccio del Monte Bianco) is a mountain range in the Alps, located mostly in France and Italy, but also straddling Switzerland at its northeastern end. It contains eleven major independent summits, each over 4,000 metres (13,123 ft) in height. It is named after Mont Blanc (4,808 metres (15,774 ft)), the highest point in western Europe and the European Union. Because of its considerable overall altitude, a large proportion of the massif is covered by glaciers, which include the Mer de Glace and the Miage Glacier – the longest glaciers in France and Italy, respectively. The massif forms a watershed between the vast catchments of the rivers Rhône and Po, and a tripoint between France, Italy and Switzerland; it also marks the border between two climate regions by separating the northern and western Alps from the southern Alps. The mountains of the massif consist mostly of granite and gneiss rocks and at high altitudes the vegetation is an arctic-alpine flora.", "wikipedia_url": "https://fr.wikipedia.org/wiki/Col_de_la_Seigne"}}, {"canonical_name": "turibitti", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "turibitti", "book_id": "ricettario_fiorentino_1597", "name": "turibitti", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["turibitti", "turbitti"], "contexts": ["likely referring to incense or fumigants", "substance traded by apothecaries"]}, {"entity_id": "turritclics", "book_id": "relation_historique_humboldt_vol3_1825", "name": "turritclics", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["turritclics"], "contexts": ["found in secondary limestone"]}, {"entity_id": "turbith", "book_id": "historia_medicinal_monardes_1574", "name": "Turbith", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Turbith"], "contexts": ["substance mixed with the root"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "turibitti", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "turritclics", "similarity": 0.844}, {"source_book": "ricettario_fiorentino_1597", "source_name": "turibitti", "target_book": "historia_medicinal_monardes_1574", "target_name": "Turbith", "similarity": 0.888}], "id": 516, "stable_key": "clu_3c4c3a004c1f1c76", "ground_truth": {"modern_name": "Turbith", "confidence": "high", "type": "plant", "linnaean": "Ipomoea purga", "family": "Convolvulaceae", "note": "Refers to the root of a plant used as a purgative, likely from Ipomoea purga.", "wikidata_id": "Q17408825", "wikidata_description": "genus of plants"}}, {"canonical_name": "drachma", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "drachma", "book_id": "historia_medicinal_monardes_1574", "name": "drachma", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["drachma"], "contexts": ["unit of quantity for medicines", "unit of weight for substance"]}, {"entity_id": "drachmes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "drachmes", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["drachmes"], "contexts": ["currency unit used by Greeks"]}, {"entity_id": "dragma", "book_id": "ricettario_fiorentino_1597", "name": "dragma", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["dragma"], "contexts": ["unit of weight"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "drachma", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "drachmes", "similarity": 0.967}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "drachma", "target_book": "ricettario_fiorentino_1597", "target_name": "dragma", "similarity": 0.856}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "drachmes", "target_book": "ricettario_fiorentino_1597", "target_name": "dragma", "similarity": 0.85}], "id": 517, "stable_key": "clu_9edd4661cb2e5515", "ground_truth": {"modern_name": "Drachma", "confidence": "high", "type": "concept", "note": "Unit of weight, often used in apothecaries' contexts, derived from the ancient Greek currency.", "wikidata_id": "Q5304630", "wikidata_description": "genus of insects; genus of Arthoropoda containing only one species", "wikipedia_extract": "In ancient Greek religion and mythology, Helios (; Ancient Greek: Ἥλιος pronounced [hɛ̌ːlios], lit. 'Sun'; Homeric Greek: Ἠέλιος) is the god who personifies the Sun. His name is also Latinized as Helius, and he is often given the epithets Hyperion (\"the one above\") and Phaethon (\"the shining\"). Helios is often depicted in art with a radiant crown and driving a horse-drawn chariot through the sky. He was a guardian of oaths and also the god of sight. Though Helios was a relatively minor deity in Classical Greece, his worship grew more prominent in late antiquity thanks to his identification with several major solar divinities of the Roman period, particularly Apollo and Sol.", "wikipedia_url": "https://en.wikipedia.org/wiki/Drachma"}}, {"canonical_name": "falsificaçam", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "falsificaçam", "book_id": "coloquios_da_orta_1563", "name": "falsificaçam", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["falsificaçam", "falsificadas"], "contexts": ["falsification of the stone", "state of being counterfeit"]}, {"entity_id": "fraude", "book_id": "relation_historique_humboldt_vol3_1825", "name": "fraude", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fraude"], "contexts": ["illegal activity related to customs"]}, {"entity_id": "falsificado", "book_id": "polyanthea_medicinal", "name": "falsificado", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["falsificado"], "contexts": ["falsified, referring to remedies"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "falsificaçam", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "fraude", "similarity": 0.91}, {"source_book": "coloquios_da_orta_1563", "source_name": "falsificaçam", "target_book": "polyanthea_medicinal", "target_name": "falsificado", "similarity": 0.971}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "fraude", "target_book": "polyanthea_medicinal", "target_name": "falsificado", "similarity": 0.916}], "id": 518, "stable_key": "clu_39bf9387d9fd4111", "ground_truth": {"modern_name": "Falsification", "confidence": "high", "type": "concept", "note": "Refers to the act of making something counterfeit or imitation.", "wikidata_id": "Q1332286", "wikidata_description": "process of making, adapting, or imitating objects, statistics, or documents with the intent to deceive", "wikipedia_extract": "Preference falsification is the act of misrepresenting a preference under perceived public pressure. It involves publicly expressing a preference that differs from one's underlying privately held preference (or simply, a public preference at odds with one’s private preference). People frequently convey to each other preferences that differ from what they would communicate privately under credible cover of anonymity (such as in opinion surveys to researchers or pollsters). Techniques such as list experiments can be used to uncover preference falsification. The term was coined by economist and political scientist Timur Kuran in a 1987 article, \"Chameleon voters and public choice.\" On controversial matters that induce preference falsification, he showed there, widely disliked policies may appear popular. The distribution of public preferences, which Kuran defines as public opinion, may differ greatly from private opinion, which is the distribution of private preferences known only to individuals themselves.", "wikipedia_url": "https://en.wikipedia.org/wiki/Forgery"}}, {"canonical_name": "rito romano", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "rito_romano", "book_id": "coloquios_da_orta_1563", "name": "rito romano", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["rito romano", "rito grega"], "contexts": ["incense consumed in religious ceremonies"]}, {"entity_id": "rite_grec", "book_id": "relation_historique_humboldt_vol3_1825", "name": "rite grec", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["rite grec"], "contexts": ["Greek rite"]}, {"entity_id": "rites", "book_id": "first_principles_spencer_1862", "name": "rites", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["rites"], "contexts": ["religious ceremonies"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "rito romano", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "rite grec", "similarity": 0.848}, {"source_book": "coloquios_da_orta_1563", "source_name": "rito romano", "target_book": "first_principles_spencer_1862", "target_name": "rites", "similarity": 0.889}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "rite grec", "target_book": "first_principles_spencer_1862", "target_name": "rites", "similarity": 0.828}], "id": 519, "stable_key": "clu_3f812c4911c98225", "ground_truth": {"modern_name": "Roman Rite", "confidence": "medium", "type": "concept", "note": "The context implies religious rituals or customs, with 'rito romano' being a specific one. 'Rite grec' is also mentioned.", "wikidata_id": "Q730757", "wikidata_description": "most common rite practiced in the Latin Catholic Church", "wikipedia_extract": "The Mass is the central liturgical service of the Eucharist in the Catholic Church, in which bread and wine are consecrated and become the body and blood of Christ. As defined by the Church at the Council of Trent, in the Mass \"the same Christ who offered himself once in a bloody manner on the altar of the cross, is present and offered in an unbloody manner\". The Church describes the Mass as the \"source and summit of the Christian life\", and teaches that the Mass is a sacrifice, in which the sacramental bread and wine, through consecration by an ordained priest, become the sacrificial body, blood, soul, and divinity of Christ as the sacrifice on Calvary made truly present once again on the altar. The Catholic Church permits only baptised members in the state of grace (Catholics who are not in a state of mortal sin) to receive Christ in the Eucharist. Many of the other sacraments of the Catholic Church, such as confirmation, holy orders, and holy matrimony, are generally administered within a celebration of Mass, but before the Second Vatican Council were often or even usually administered separately. The term Mass, also Holy Mass, is commonly used to describe the celebration of the Eucharist in the Latin Church, while the various Eastern Catholic liturgies use terms such as Divine Liturgy, Holy Qurbana, and Badarak, in accordance with each one's tradition.", "wikipedia_url": "https://en.wikipedia.org/wiki/Roman_Rite"}}, {"canonical_name": "Medina", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "medina", "book_id": "kosmos_humboldt_1845", "name": "Medina", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Medina"], "contexts": ["location of a volcano"]}, {"entity_id": "medina_del_campo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Medina del Campo", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Medina del Campo"], "contexts": ["location of publication"]}, {"entity_id": "medina", "book_id": "coloquios_da_orta_1563", "name": "Medina", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Medina"], "contexts": ["city in Castella"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Medina", "target_book": "coloquios_da_orta_1563", "target_name": "Medina", "similarity": 0.873}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Medina del Campo", "target_book": "coloquios_da_orta_1563", "target_name": "Medina", "similarity": 0.839}], "id": 520, "stable_key": "clu_0565d0538ed400c8", "ground_truth": {"wikipedia_extract": "Medina del Campo is a town and municipality of Spain located in the autonomous community of Castile and León. Part of the Province of Valladolid, it is the centre of a farming area. It lies on the banks of the Zapardiel river, in the central part of the Douro basin. Initially a Berber settlement, it was repopulated after 1085. By the 12th century the walled town had become a major population centre of the Kingdom of Castile, drawing large-scale trading operations. It was later granted right to hold its well-known free fairs, which attracted a notable presence of international dealers."}}, {"canonical_name": "Pennar", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "pennar", "book_id": "coloquios_da_orta_1563", "name": "Pennar", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Pennar"], "contexts": ["river in southern India"]}, {"entity_id": "pena", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pena", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Pena"], "contexts": ["cascade near Mariquita"]}, {"entity_id": "pena", "book_id": "polyanthea_medicinal", "name": "Pena", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Pena"], "contexts": ["N. Senhora da Ribeyra de Pena"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Pennar", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Pena", "similarity": 0.851}, {"source_book": "coloquios_da_orta_1563", "source_name": "Pennar", "target_book": "polyanthea_medicinal", "target_name": "Pena", "similarity": 0.851}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pena", "target_book": "polyanthea_medicinal", "target_name": "Pena", "similarity": 1.0}], "id": 521, "stable_key": "clu_5c930b24b4354894", "ground_truth": {"wikipedia_extract": "Penna (originally known as Penneru, also known as Pinakini, Penneru, Penner, Pennar, Pennai) is a river of southern India. After originating from Nandi hills, it flows as two different streams, one in North and South directions. The Penna rises in the Nandi Hills in Chikkaballapur District of Karnataka state, and runs north and east through the states of Karnataka and Andhra Pradesh to empty into bay of bengal in Andhra Pradesh. It is 597 kilometres (371 mi) long, with a drainage basin covering 55,213 km2: 6,937 km2 in Karnataka and 48,276 km2 in Andhra Pradesh. Along with this main stream is another stream south towards Tamil Nadu with the name Then Pennai or south Pennar which further moves towards the east to empty into the Bay of Bengal. The Penna river basin lies in the rain shadow region of Eastern Ghats and receives 500 mm average rainfall annually."}}, {"canonical_name": "mare", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "mare", "book_id": "ricettario_fiorentino_1597", "name": "mare", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["mare"], "contexts": ["seawater", "sea water, its use and artificial preparation"]}, {"entity_id": "mer", "book_id": "historia_medicinal_monardes_1574", "name": "mer", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["mer"], "contexts": ["ingredient mixed with Ambar"]}, {"entity_id": "mar", "book_id": "polyanthea_medicinal", "name": "mar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["mar"], "contexts": ["sea water"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "mare", "target_book": "historia_medicinal_monardes_1574", "target_name": "mer", "similarity": 0.89}, {"source_book": "ricettario_fiorentino_1597", "source_name": "mare", "target_book": "polyanthea_medicinal", "target_name": "mar", "similarity": 0.892}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "mer", "target_book": "polyanthea_medicinal", "target_name": "mar", "similarity": 0.889}], "id": 522, "stable_key": "clu_2cf2454e65a46839", "ground_truth": {"wikipedia_extract": "A mare is an adult female horse or other equine. In most cases, a mare is a female horse over the age of three, and a filly is a female horse three and younger. In Thoroughbred horse racing, a mare is defined as a female horse more than four years old. The word can also be used for other female equine animals, particularly mules and zebras, but a female donkey is usually called a \"jenny\". A broodmare is a mare used for breeding. Mares carry their young (called foals) for approximately 11 months from conception to birth, the average range being 320–370 days."}}, {"canonical_name": "Petit", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "petit", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Petit", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Petit"], "contexts": ["work on temperature reductions"]}, {"entity_id": "petit", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Petit", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Petit"], "contexts": ["calculated existence of small satellites"]}, {"entity_id": "petit,_m_", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Petit, M.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Petit, M."], "contexts": ["observed meteoric satellites"]}, {"entity_id": "petit", "book_id": "first_principles_spencer_1862", "name": "Petit", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Petit"], "contexts": ["scientist studying heat and affinity"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Petit", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Petit", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Petit", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Petit, M.", "similarity": 0.85}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Petit", "target_book": "first_principles_spencer_1862", "target_name": "Petit", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Petit", "target_book": "first_principles_spencer_1862", "target_name": "Petit", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Petit, M.", "target_book": "first_principles_spencer_1862", "target_name": "Petit", "similarity": 0.85}], "id": 523, "stable_key": "clu_6579f852051c8c63", "ground_truth": {"modern_name": "Alexis Petit", "confidence": "medium", "type": "person", "birth_year": 1715, "death_year": 1784, "description": "French astronomer and mathematician, known for astronomical calculations", "note": "The name 'Petit' appears in multiple scientific contexts; Alexis Petit is a plausible fit for astronomical work. Could also refer to Louis Petit if context leans purely towards meteors.", "wikidata_id": "Q728536", "wikidata_description": "French physicist (1791–1820)", "wikipedia_url": "https://en.wikipedia.org/wiki/Alexis_Th%C3%A9r%C3%A8se_Petit"}}, {"canonical_name": "thread", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "thread", "book_id": "principles_of_psychology_james_1890", "name": "thread", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["thread"], "contexts": ["fine strand of material", "marker in telescope view"]}, {"entity_id": "thread", "book_id": "kosmos_humboldt_1845", "name": "thread", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["thread"], "contexts": ["material for suspension"]}, {"entity_id": "thread", "book_id": "connexion_physical_sciences_somerville_1858", "name": "thread", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["thread"], "contexts": ["material for twisting into a spiral"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "thread", "target_book": "kosmos_humboldt_1845", "target_name": "thread", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "thread", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "thread", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "thread", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "thread", "similarity": 1.0}], "id": 524, "stable_key": "clu_27c036b9d787624e", "ground_truth": {"modern_name": "thread", "confidence": "high", "type": "object", "wikidata_id": "Q244111", "wikidata_description": "species of worm", "wikipedia_url": "https://en.wikipedia.org/wiki/Thread-local_storage", "wikipedia_extract": "In computer programming, thread-local storage (TLS) is a memory management method that uses static or global memory local to a thread. The concept allows storage of data that appears to be global in a system with separate threads. Many systems impose restrictions on the size of the thread-local memory block, in fact often rather tight limits. On the other hand, if a system can provide at least a memory address (pointer) sized variable thread-local, then this allows the use of arbitrarily sized memory blocks in a thread-local manner, by allocating such a memory block dynamically and storing the memory address of that block in the thread-local variable. On RISC machines, the calling convention often reserves a thread pointer register for this use. While the use of global variables is generally discouraged in modern programming, some older operating systems such as UNIX were originally designed for uniprocessor hardware and often use global variables to store important values."}}, {"canonical_name": "Dorpat", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "dorpat", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Dorpat", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Dorpat"], "contexts": ["location of astronomical observation", "city where star occultation was observed"]}, {"entity_id": "dorpat", "book_id": "principles_of_psychology_james_1890", "name": "Dorpat", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Dorpat"], "contexts": ["location of Bartels' research"]}, {"entity_id": "dorpat", "book_id": "kosmos_humboldt_1845", "name": "Dorpat", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Dorpat"], "contexts": ["location of observation"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Dorpat", "target_book": "principles_of_psychology_james_1890", "target_name": "Dorpat", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Dorpat", "target_book": "kosmos_humboldt_1845", "target_name": "Dorpat", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Dorpat", "target_book": "kosmos_humboldt_1845", "target_name": "Dorpat", "similarity": 1.0}], "id": 525, "stable_key": "clu_669cf112fcee3415", "ground_truth": {"modern_name": "Tartu", "confidence": "high", "type": "place", "country": "Estonia", "note": "Dorpat is the historical German name for Tartu.", "wikidata_id": "Q13972", "wikidata_description": "second most populous city in Estonia", "wikipedia_url": "https://en.wikipedia.org/wiki/Tartu", "wikipedia_extract": "Tartu is the second largest city in Estonia after Tallinn. Tartu has a population of 97,759 (as of 2024). It is 186 kilometres (116 miles) southeast of Tallinn and 245 kilometres (152 miles) northeast of Riga, Latvia. Tartu lies on the Emajõgi river, which connects the two largest lakes in Estonia, Lake Võrtsjärv and Lake Peipus. From the 13th century until the end of the 19th century, Tartu was known in most of the world by variants of its historical name Dorpat. Tartu, the largest urban centre of southern Estonia, is often considered the \"intellectual capital city\" of the country, especially as it is home to the nation's oldest and most renowned university, the University of Tartu (founded in 1632)."}}, {"canonical_name": "irritation", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "irritation", "book_id": "principles_of_psychology_james_1890", "name": "irritation", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["irritation"], "contexts": ["stimulation causing a reaction"]}, {"entity_id": "irritations", "book_id": "principles_of_psychology_james_1890", "name": "irritations", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["irritations"], "contexts": ["state of being stimulated or inflamed"]}, {"entity_id": "irritação", "book_id": "polyanthea_medicinal", "name": "irritação", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["irritação"], "contexts": ["cause of tears"]}, {"entity_id": "irritability", "book_id": "first_principles_spencer_1862", "name": "irritability", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["irritability"], "contexts": ["tendency to be easily annoyed"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "irritation", "target_book": "polyanthea_medicinal", "target_name": "irritação", "similarity": 0.869}, {"source_book": "principles_of_psychology_james_1890", "source_name": "irritation", "target_book": "first_principles_spencer_1862", "target_name": "irritability", "similarity": 0.959}, {"source_book": "principles_of_psychology_james_1890", "source_name": "irritations", "target_book": "polyanthea_medicinal", "target_name": "irritação", "similarity": 0.858}, {"source_book": "principles_of_psychology_james_1890", "source_name": "irritations", "target_book": "first_principles_spencer_1862", "target_name": "irritability", "similarity": 0.952}, {"source_book": "polyanthea_medicinal", "source_name": "irritação", "target_book": "first_principles_spencer_1862", "target_name": "irritability", "similarity": 0.852}], "id": 526, "stable_key": "clu_4cf4194737f3c249", "ground_truth": {"wikipedia_extract": "Irritation, in biology and physiology, is a state of inflammation or painful reaction to allergy or cell-lining damage. A stimulus or agent which induces the state of irritation is an irritant. Irritants are typically thought of as chemical agents (for example phenol and capsaicin) but mechanical, thermal (heat), and radiative stimuli (for example ultraviolet light or ionising radiations) can also be irritants. Irritation also has non-clinical usages referring to bothersome physical or psychological pain or discomfort. Irritation can also be induced by some allergic response due to exposure of some allergens for example contact dermatitis, irritation of mucosal membranes and pruritus. Mucosal membrane is the most common site of irritation because it contains secretory glands that release mucus which attracts the allergens due to its sticky nature."}}, {"canonical_name": "spots", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "spots", "book_id": "connexion_physical_sciences_somerville_1858", "name": "spots", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 2, "variants": ["spots"], "contexts": ["formed by gaseous eruptions", "dark areas on stellar surfaces"]}, {"entity_id": "blind_spots", "book_id": "principles_of_psychology_james_1890", "name": "blind spots", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["blind spots"], "contexts": ["visual defect where no image is perceived"]}, {"entity_id": "spots_upon_the_sun", "book_id": "kosmos_humboldt_1845", "name": "spots upon the sun", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["spots upon the sun"], "contexts": ["dark areas on the sun's surface"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "spots", "target_book": "principles_of_psychology_james_1890", "target_name": "blind spots", "similarity": 0.841}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "spots", "target_book": "kosmos_humboldt_1845", "target_name": "spots upon the sun", "similarity": 0.868}], "id": 527, "stable_key": "clu_ad15c16464b16fc7", "ground_truth": {"modern_name": "spots", "confidence": "high", "type": "concept", "note": "This cluster refers to diverse phenomena: visual defects, and solar phenomena, thus 'spots' is a general concept.", "wikidata_id": "Q9274700", "wikidata_description": "Human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Spotted%20fever"}}, {"canonical_name": "vibrating string", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "vibrating_string", "book_id": "principles_of_psychology_james_1890", "name": "vibrating string", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["vibrating string"], "contexts": ["object producing sound through vibration"]}, {"entity_id": "vibrating_body", "book_id": "connexion_physical_sciences_somerville_1858", "name": "vibrating body", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["vibrating body"], "contexts": ["object that oscillates and produces sound"]}, {"entity_id": "vibrating_string", "book_id": "connexion_physical_sciences_somerville_1858", "name": "vibrating string", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["vibrating string"], "contexts": ["string that oscillates"]}, {"entity_id": "vibrating_strings", "book_id": "first_principles_spencer_1862", "name": "vibrating strings", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["vibrating strings"], "contexts": ["strings producing sound waves"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "vibrating string", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "vibrating body", "similarity": 0.892}, {"source_book": "principles_of_psychology_james_1890", "source_name": "vibrating string", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "vibrating string", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "vibrating string", "target_book": "first_principles_spencer_1862", "target_name": "vibrating strings", "similarity": 0.982}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "vibrating body", "target_book": "first_principles_spencer_1862", "target_name": "vibrating strings", "similarity": 0.888}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "vibrating string", "target_book": "first_principles_spencer_1862", "target_name": "vibrating strings", "similarity": 0.982}], "id": 528, "stable_key": "clu_4756209a1e3b9a2f", "ground_truth": {"modern_name": "vibrating string", "confidence": "high", "type": "object", "wikidata_id": "Q3252739", "wikidata_description": "A vibration in a string is a wave", "wikipedia_extract": "A sex toy is an object or device that is primarily used to facilitate sexual pleasure, such as a dildo, artificial vagina or vibrator. Many popular sex toys are designed to resemble human genitals, and may be vibrating or non-vibrating. The term sex toy can also include BDSM apparatus and sex furniture such as sex swings; however, it is not applied to items such as birth control, pornography, or condoms. Alternative terms for sex toy include adult toy and the dated euphemism marital aid. Marital aid also has a broader meaning and is applied to drugs and herbs marketed to enhance or prolong sex. Sex toys are most commonly sold at sex shops or online, but they may also be sold in a pharmacy, a pornography store, a head shop, or a department store.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sex_toy"}}, {"canonical_name": "beats", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "beats", "book_id": "connexion_physical_sciences_somerville_1858", "name": "beats", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["beats"], "contexts": ["intervals of silence and intensity in sound", "audible pulses in sound"]}, {"entity_id": "beats", "book_id": "principles_of_psychology_james_1890", "name": "beats", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["beats"], "contexts": ["discrete units of time or sensation"]}, {"entity_id": "beat", "book_id": "first_principles_spencer_1862", "name": "beat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["beat"], "contexts": ["rhythmic pulse in music"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "beats", "target_book": "principles_of_psychology_james_1890", "target_name": "beats", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "beats", "target_book": "first_principles_spencer_1862", "target_name": "beat", "similarity": 0.958}, {"source_book": "principles_of_psychology_james_1890", "source_name": "beats", "target_book": "first_principles_spencer_1862", "target_name": "beat", "similarity": 0.958}], "id": 529, "stable_key": "clu_9593e5340f4dae37", "ground_truth": {"modern_name": "beats", "confidence": "high", "type": "concept", "note": "Refers to rhythmic or temporal units, can be in music, sensation, or time."}}, {"canonical_name": "Lemnos", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "lemnos", "book_id": "kosmos_humboldt_1845", "name": "Lemnos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Lemnos"], "contexts": ["island with volcanic history", "island with a chart"]}, {"entity_id": "lemnos", "book_id": "historia_medicinal_monardes_1574", "name": "Lemnos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Lemnos"], "contexts": ["island, source of Terra Lemnia"]}, {"entity_id": "lemno", "book_id": "ricettario_fiorentino_1597", "name": "Lemno", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Lemno"], "contexts": ["island associated with medicinal earth"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Lemnos", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lemnos", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Lemnos", "target_book": "ricettario_fiorentino_1597", "target_name": "Lemno", "similarity": 0.961}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Lemnos", "target_book": "ricettario_fiorentino_1597", "target_name": "Lemno", "similarity": 0.961}], "id": 530, "stable_key": "clu_50babbe7ed807281", "ground_truth": {"wikipedia_extract": "Lemnos (Ancient Greek: Λῆμνος [ˈlɛ̂ːmnos]) or Limnos (Modern Greek: Λήμνος [ˈlimnos]) is a Greek island in the northern Aegean Sea. Administratively the island forms a separate municipality within the Lemnos regional unit, which is part of the North Aegean region. The principal town of the island and seat of the municipality is Myrina. At 477.583 square kilometres (184.396 sq mi), it is the 8th-largest island of Greece. Lemnos is primarily a flat island, but the western region, particularly the northwest, is rocky and mountainous. At 430 meters above sea level, Mount Skopia is the highest point."}}, {"canonical_name": "Angola", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "angola", "book_id": "polyanthea_medicinal", "name": "Angola", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Angola"], "contexts": ["place of origin", "place mentioned for verification of creatures"]}, {"entity_id": "angola", "book_id": "kosmos_humboldt_1845", "name": "Angola", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Angola"], "contexts": ["location of magnetic zone"]}, {"entity_id": "angola", "book_id": "coloquios_da_orta_1563", "name": "Angola", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Angola"], "contexts": ["place where a plant is common"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Angola", "target_book": "kosmos_humboldt_1845", "target_name": "Angola", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Angola", "target_book": "coloquios_da_orta_1563", "target_name": "Angola", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Angola", "target_book": "coloquios_da_orta_1563", "target_name": "Angola", "similarity": 1.0}], "id": 531, "stable_key": "clu_ce43600962a378d5", "ground_truth": {"wikipedia_extract": "Angola, officially the Republic of Angola, is a country on the western coast of Southern Africa. It is the second-largest Portuguese-speaking (Lusophone) country after Brazil in both total area and population and is the seventh-largest country in Africa. It is bordered by Namibia to the south, the Democratic Republic of the Congo to the north, Zambia to the east, and the Atlantic Ocean to the west. Angola has an exclave province, the province of Cabinda, that borders the Republic of the Congo and the Democratic Republic of the Congo. The capital and most populous city is Luanda. Angola has been inhabited since the Palaeolithic Age."}}, {"canonical_name": "Sardine", "category": "ANIMAL", "subcategory": "FISH", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "sardine", "book_id": "ricettario_fiorentino_1597", "name": "Sardine", "category": "ANIMAL", "subcategory": "FISH", "count": 2, "variants": ["Sardine"], "contexts": ["sardonyx stone", "fish name"]}, {"entity_id": "sardine", "book_id": "kosmos_humboldt_1845", "name": "sardine", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["sardine"], "contexts": ["specific type of fish fossil"]}, {"entity_id": "sardinhas", "book_id": "polyanthea_medicinal", "name": "Sardinhas", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["Sardinhas"], "contexts": ["Sardines, a type of fish"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Sardine", "target_book": "kosmos_humboldt_1845", "target_name": "sardine", "similarity": 0.986}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Sardine", "target_book": "polyanthea_medicinal", "target_name": "Sardinhas", "similarity": 0.863}, {"source_book": "kosmos_humboldt_1845", "source_name": "sardine", "target_book": "polyanthea_medicinal", "target_name": "Sardinhas", "similarity": 0.849}], "id": 532, "stable_key": "clu_8842bbddc8a17e7b", "ground_truth": {"wikipedia_extract": "Sardine and pilchard are common names for various species of small, oily forage fish in the herring suborder Clupeoidei. The term \"sardine\" was first used in English during the early 15th century; a somewhat dubious etymology says it comes from the Italian island of Sardinia, around which sardines were once supposedly abundant. The terms \"sardine\" and \"pilchard\" are not precise, and what is meant depends on the region. The United Kingdom's Sea Fish Industry Authority, for example, classifies sardines as young pilchards. One criterion suggests fish shorter in length than 15 cm (6 in) are sardines, and larger fish are pilchards. The FAO/WHO Codex standard for canned sardines cites 21 species that may be classed as sardines."}}, {"canonical_name": "relaxacion de miem", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "relaxacion_de_miem", "book_id": "historia_medicinal_monardes_1574", "name": "relaxacion de miem", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["relaxacion de miem", "relaxaciones del eftomago"], "contexts": ["symptom caused by coldness", "loosening of the stomach"]}, {"entity_id": "relaxaçam", "book_id": "coloquios_da_orta_1563", "name": "relaxaçam", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["relaxaçam"], "contexts": ["condition of the gums"]}, {"entity_id": "relaxados", "book_id": "polyanthea_medicinal", "name": "relaxados", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["relaxados"], "contexts": ["limbs lacking tone"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "relaxacion de miem", "target_book": "coloquios_da_orta_1563", "target_name": "relaxaçam", "similarity": 0.871}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "relaxacion de miem", "target_book": "polyanthea_medicinal", "target_name": "relaxados", "similarity": 0.88}, {"source_book": "coloquios_da_orta_1563", "source_name": "relaxaçam", "target_book": "polyanthea_medicinal", "target_name": "relaxados", "similarity": 0.926}], "id": 533, "stable_key": "clu_a1bf0384f07df285", "ground_truth": {"modern_name": "flaccidity", "confidence": "high", "type": "disease", "modern_term": "flaccidity", "note": "'Relaxacion de miem' translates to 'relaxation of members' or flaccidity. 'Relaxaçam' and 'relaxados' also refer to a loss of tone or flaccidity.", "wikidata_id": "Q102186557", "wikidata_description": "symptom", "wikipedia_extract": "Flaccid paralysis is a neurological condition characterized by weakness or paralysis and reduced muscle tone without other obvious cause (e.g., trauma). This abnormal condition may be caused by disease or by trauma affecting the nerves associated with the involved muscles. For example, if the somatic nerves to a skeletal muscle are severed, then the muscle will exhibit flaccid paralysis. When muscles enter this state, they become limp and cannot contract. This condition can become fatal if it affects the respiratory muscles, posing the threat of suffocation. It also occurs in the spinal shock stage in complete transection of the spinal cord occurring in injuries such as gunshot wounds."}}, {"canonical_name": "mestruos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "mestruos", "book_id": "historia_medicinal_monardes_1574", "name": "mestruos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["mestruos"], "contexts": ["menstrual fluxes", "menstrual flux"]}, {"entity_id": "menstruo", "book_id": "coloquios_da_orta_1563", "name": "menstruo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["menstruo"], "contexts": ["menstrual cycle"]}, {"entity_id": "menstruepurgationis", "book_id": "polyanthea_medicinal", "name": "menstruepurgationis", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["menstruepurgationis"], "contexts": ["menstrual purgation, a bodily function"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "mestruos", "target_book": "coloquios_da_orta_1563", "target_name": "menstruo", "similarity": 0.965}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "mestruos", "target_book": "polyanthea_medicinal", "target_name": "menstruepurgationis", "similarity": 0.898}, {"source_book": "coloquios_da_orta_1563", "source_name": "menstruo", "target_book": "polyanthea_medicinal", "target_name": "menstruepurgationis", "similarity": 0.915}], "id": 534, "stable_key": "clu_84243031ebf4854b", "ground_truth": {"modern_name": "menstruation", "confidence": "high", "type": "concept", "note": "'Mestruos', 'menstruo', and 'menstruepurgationis' all refer to menstrual cycles or fluxes.", "wikidata_id": "Q50430082", "wikidata_description": "chemical compounds that induce menstruation, through direct action or by relieving a condition causing amenorrhea", "wikipedia_extract": "Menstruation in Islam relates to various purity related restrictions in Islamic jurisprudence. The ḥayḍ (Arabic: حيض) is the religious state of menstruation in Islam. The Qur'an makes specific mention of menstruation in al-Baqara 2:222:And they ask you about menstruation. Say, \"It is harm, so keep away from wives during menstruation. And do not approach them until they are pure. And when they have purified themselves, then come to them from where Allāh has ordained for you.", "wikipedia_url": "https://en.wikipedia.org/wiki/Menstruation_in_Islam"}}, {"canonical_name": "agua marinha", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "agua_marinha", "book_id": "coloquios_da_orta_1563", "name": "agua marinha", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["agua marinha"], "contexts": ["related to emerald's composition", "sea water"]}, {"entity_id": "agua_mineral", "book_id": "historia_medicinal_monardes_1574", "name": "agua mineral", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["agua mineral"], "contexts": ["mineral water from baths"]}, {"entity_id": "agua_branca", "book_id": "polyanthea_medicinal", "name": "Agua branca", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Agua branca"], "contexts": ["name for sublimated mercury"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "agua marinha", "target_book": "historia_medicinal_monardes_1574", "target_name": "agua mineral", "similarity": 0.859}, {"source_book": "coloquios_da_orta_1563", "source_name": "agua marinha", "target_book": "polyanthea_medicinal", "target_name": "Agua branca", "similarity": 0.857}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "agua mineral", "target_book": "polyanthea_medicinal", "target_name": "Agua branca", "similarity": 0.819}], "id": 535, "stable_key": "clu_519b7baa11893e3f", "ground_truth": {"modern_name": "seawater", "confidence": "medium", "type": "mineral", "note": "'Agua marinha' directly translates to seawater. 'Agua mineral' suggests mineral water. 'Agua branca' could refer to mercury sublimate or white water. The connection is weak across all terms.", "wikidata_id": "Q184395", "wikidata_description": "water from a sea or ocean", "wikipedia_extract": "Per- and polyfluoroalkyl substances (also PFAS, PFASs, and informally called \"forever chemicals\") are a group of synthetic organofluorine chemical compounds that have multiple fluorine atoms attached to an alkyl chain; 7 million such chemicals are listed in PubChem. Widespread use of PFAS began in 1938 with the invention of Teflon, a fluoropolymer coating that resists heat, oil, stains, grease, and water. They are used in a wide variety of products including waterproof fabric, yoga pants, carpets, shampoo, mobile phone screens, wall paint, furniture, adhesives, food packaging, firefighting foam, electrical insulation, and cosmetics. Many PFAS such as PFOS and PFOA pose health and environmental concerns because they are persistent organic pollutants; they were branded as \"forever chemicals\" in an article in The Washington Post in 2018. They move through soils and bioaccumulate in fish and wildlife, which are then eaten by humans. Residues are now commonly found in rain, drinking water, and wastewater.", "wikipedia_url": "https://en.wikipedia.org/wiki/Seawater"}}, {"canonical_name": "bolhas", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "bolhas", "book_id": "polyanthea_medicinal", "name": "bolhas", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["bolhas", "bolha"], "contexts": ["blisters", "reaction to caustic"]}, {"entity_id": "boltezos", "book_id": "historia_medicinal_monardes_1574", "name": "boltezos", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["boltezos"], "contexts": ["belching"]}, {"entity_id": "burbulhas", "book_id": "coloquios_da_orta_1563", "name": "burbulhas", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["burbulhas"], "contexts": ["small blisters"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "bolhas", "target_book": "historia_medicinal_monardes_1574", "target_name": "boltezos", "similarity": 0.875}, {"source_book": "polyanthea_medicinal", "source_name": "bolhas", "target_book": "coloquios_da_orta_1563", "target_name": "burbulhas", "similarity": 0.862}], "id": 536, "stable_key": "clu_848b0af3e9ee3408", "ground_truth": {"wikipedia_extract": "Bolhás is a village in Somogy county, Hungary. Its name derives from the Hungarian word bolha (English: flea). According to the legends the village belonged to a knight who was called Bolha. The Hungarian folk songs Megismerni a kanászt and Volt nekem egy kecském were collected in 1922 in Bolhás by Zoltán Kodály."}}, {"canonical_name": "oleo de canela", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "oleo_de_canela", "book_id": "polyanthea_medicinal", "name": "oleo de canela", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["oleo de canela"], "contexts": ["oil of cinnamon", "prepared substance"]}, {"entity_id": "oleo_de_cânfora", "book_id": "coloquios_da_orta_1563", "name": "oleo de cânfora", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["oleo de cânfora"], "contexts": ["liquid from camphor trunks"]}, {"entity_id": "olio_d'alcanna", "book_id": "ricettario_fiorentino_1597", "name": "OLIO D'ALCANNA", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["OLIO D'ALCANNA"], "contexts": ["type of oil"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "oleo de canela", "target_book": "coloquios_da_orta_1563", "target_name": "oleo de cânfora", "similarity": 0.843}, {"source_book": "polyanthea_medicinal", "source_name": "oleo de canela", "target_book": "ricettario_fiorentino_1597", "target_name": "OLIO D'ALCANNA", "similarity": 0.844}], "id": 537, "stable_key": "clu_26c976f570d31a98", "ground_truth": {"modern_name": "Oil of cinnamon", "confidence": "high", "type": "chemical", "note": "The cluster mentions 'oleo de canela' (oil of cinnamon) and 'oleo de cânfora' (oil of camphor), as well as 'OLIO D'ALCANNA' (oil of alkanet). Given the prominence of cinnamon oil in early modern pharmacopoeias and the other options being less clear or less common, 'Oil of cinnamon' is the most likely primary referent for the cluster title, with camphor and alkanet oils as related substances within the context of medicinal oils.", "wikidata_id": "Q72460907", "wikidata_description": "oil from steam distillation of cinnamon", "wikipedia_url": "https://de.wikipedia.org/wiki/Zimt%C3%B6l"}}, {"canonical_name": "cana", "category": "OBJECT", "subcategory": "VESSEL", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "cana", "book_id": "polyanthea_medicinal", "name": "cana", "category": "OBJECT", "subcategory": "VESSEL", "count": 2, "variants": ["cana"], "contexts": ["sugar cane used in a remedy", "container for liquid"]}, {"entity_id": "cadinhos", "book_id": "coloquios_da_orta_1563", "name": "cadinhos", "category": "OBJECT", "subcategory": "VESSEL", "count": 1, "variants": ["cadinhos"], "contexts": ["onde se deposita pompholix"]}, {"entity_id": "caraffa", "book_id": "ricettario_fiorentino_1597", "name": "caraffa", "category": "OBJECT", "subcategory": "VESSEL", "count": 1, "variants": ["caraffa"], "contexts": ["carafe for boiling"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "cana", "target_book": "coloquios_da_orta_1563", "target_name": "cadinhos", "similarity": 0.852}, {"source_book": "polyanthea_medicinal", "source_name": "cana", "target_book": "ricettario_fiorentino_1597", "target_name": "caraffa", "similarity": 0.84}], "id": 538, "stable_key": "clu_24d8cb9368ad875c", "ground_truth": {"wikipedia_extract": "Cana of Galilee (Ancient Greek: Κανὰ τῆς Γαλιλαίας; Arabic: قانا الجليل, romanized: Qana al-Jalil, lit. 'Qana of the Galilee') is the location of the Wedding at Cana, at which the miracle of turning water into wine took place in the Gospel of John. The location is disputed, with the four primary locations being  Kafr Kanna, Khirbet Qana and Reineh in Lower Galilee, and Qana in Upper Galilee in Lebanon. The Arabic phrase \"Qana el-Jalil\" has been said not to be in use as a placename other than in Gospel-related contexts. The name possibly derives from the Hebrew or Aramaic word for reeds. Among Christians and other students of the New Testament, Cana is best known as the place where, according to the Fourth Gospel, Jesus performed \"the first of his signs\", his first public miracle, the turning of a large quantity of water into wine at a wedding feast (John 2, John 2:1–11) when the wine provided by the bridegroom had run out. Although none of the synoptic gospels record the event, mainstream Christian tradition holds that this is the first public miracle of Jesus."}}, {"canonical_name": "Jordan", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "jordan", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Jordan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Jordan"], "contexts": ["river for cleansing"]}, {"entity_id": "rio_jordan", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rio Jordan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Rio Jordan"], "contexts": ["river mouth between Savannah and Charlestown"]}, {"entity_id": "jordan", "book_id": "kosmos_humboldt_1845", "name": "Jordan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Jordan"], "contexts": ["river in the Middle East"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Jordan", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Rio Jordan", "similarity": 0.85}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Jordan", "target_book": "kosmos_humboldt_1845", "target_name": "Jordan", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rio Jordan", "target_book": "kosmos_humboldt_1845", "target_name": "Jordan", "similarity": 0.85}], "id": 539, "stable_key": "clu_238e8a3365203559", "ground_truth": {"modern_name": "Jordan River", "confidence": "high", "type": "place", "country": "Israel, Palestine, Jordan", "note": "The contexts clearly point to the biblical and geographical Jordan River. The mention of 'river mouth between Savannah and Charlestown' might be a misidentification or a metaphorical use of the name, but the dominant referent is the Middle Eastern river.", "wikidata_id": "Q22487538", "wikidata_description": "river in Capital Regional District, British Columbia, Canada", "wikipedia_extract": "The Jordan River or River Jordan (Arabic: نَهْر الْأُرْدُنّ, Nahr al-ʾUrdunn; Hebrew: נְהַר הַיַּרְדֵּן, Nəhar hayYardēn), also known as Nahr Al-Sharieat (Arabic: نهر الشريعة), is a 251-kilometre-long (156 mi) endorheic river in the Levant that flows roughly north to south through the Sea of Galilee and drains to the Dead Sea. The river passes by or through Jordan, Syria, Israel, and Palestine. Jordan and the Israeli-occupied Golan Heights border the river to the east, while Israel and the Israeli-occupied West Bank lie to its west. Both Jordan and the West Bank derive their names in relation to the river. The river holds major significance in Judaism and Christianity. According to the Bible, the Israelites crossed it into the Promised Land and Jesus of Nazareth was baptized by John the Baptist in it."}}, {"canonical_name": "Caramania", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "caramania", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Caramania", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Caramania"], "contexts": ["historical region in Asia Minor"]}, {"entity_id": "carabaya", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Carabaya", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Carabaya"], "contexts": ["region in Peru"]}, {"entity_id": "caramanian", "book_id": "kosmos_humboldt_1845", "name": "Caramanian", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Caramanian"], "contexts": ["coast region"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Caramania", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Carabaya", "similarity": 0.845}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Caramania", "target_book": "kosmos_humboldt_1845", "target_name": "Caramanian", "similarity": 0.959}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Carabaya", "target_book": "kosmos_humboldt_1845", "target_name": "Caramanian", "similarity": 0.826}], "id": 540, "stable_key": "clu_ccd97557a814380b", "ground_truth": {"modern_name": "Karaman", "confidence": "medium", "type": "place", "country": "Turkey", "note": "The primary referent is likely 'Caramania', a historical region in Asia Minor (modern Turkey). 'Carabaya' is a region in Peru, and 'Caramanian' refers to the region. The cluster is titled 'Caramania', making it the most probable focus. 'Caramania' is an older spelling for the region of Karaman.", "wikidata_id": "Q262579", "wikidata_description": "central district and city in Karaman Province, Turkey", "wikipedia_url": "https://en.wikipedia.org/wiki/Karaman", "wikipedia_extract": "Karaman is a city in south central Turkey, located in Central Anatolia, north of the Taurus Mountains, about 100 km (62 mi) south of Konya. It is the seat of Karaman Province and Karaman District. Its population is 175,390 (2022). The town lies at an average elevation of 1,039 m (3,409 ft). The Karaman Museum is one of the major sights. The town owes its name to Karaman Bey, who was one of the rulers of the Karamanid dynasty."}}, {"canonical_name": "Parma", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "parma", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Parma", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Parma"], "contexts": ["city in Italy"]}, {"entity_id": "parme", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Parme", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Parme"], "contexts": ["location of observation"]}, {"entity_id": "parma", "book_id": "kosmos_humboldt_1845", "name": "Parma", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Parma"], "contexts": ["city in Italy"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Parma", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Parme", "similarity": 0.934}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Parma", "target_book": "kosmos_humboldt_1845", "target_name": "Parma", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Parme", "target_book": "kosmos_humboldt_1845", "target_name": "Parma", "similarity": 0.934}], "id": 541, "stable_key": "clu_735fa01071e54693", "ground_truth": {"modern_name": "Parma", "confidence": "high", "type": "place", "country": "Italy", "wikidata_id": "Q2683", "wikidata_description": "city in the northern Italian region of Emilia-Romagna", "wikipedia_url": "https://en.wikipedia.org/wiki/Parma", "wikipedia_extract": "Parma (Italian: [ˈparma] ; Parmigiano: Pärma [ˈpɛːʁmɐ]) is a city in the region of Emilia-Romagna in Northern Italy, known for its architecture, music, art, prosciutto (ham), cheese and surrounding countryside. With a population of 202,111 inhabitants as of 2025, Parma is the second most populous city in Emilia-Romagna after Bologna, the region's capital. The city is home to the University of Parma, one of the oldest universities in the world. Parma is divided into two parts by the stream of the same name. The district on the west side of the river is Oltretorrente, meaning The other side of the stream. Parma's Etruscan name was adapted by Romans to describe the round shield called Parma."}}, {"canonical_name": "Dantzich", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "dantzich", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Dantzich", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Dantzich"], "contexts": ["city where Bellabonus wrote"]}, {"entity_id": "dantzick", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Dantzick", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Dantzick"], "contexts": ["city in Poland"]}, {"entity_id": "danzica", "book_id": "ricettario_fiorentino_1597", "name": "Danzica", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Danzica"], "contexts": ["port where amber is found"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Dantzich", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Dantzick", "similarity": 0.953}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Dantzich", "target_book": "ricettario_fiorentino_1597", "target_name": "Danzica", "similarity": 0.907}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Dantzick", "target_book": "ricettario_fiorentino_1597", "target_name": "Danzica", "similarity": 0.907}], "id": 542, "stable_key": "clu_41a1ad70599e073d", "ground_truth": {"wikipedia_extract": "Gdańsk (Kashubian: Gduńsk; German: Danzig) is a city on the Baltic coast of northern Poland, and the capital of the Pomeranian Voivodeship. With a population of 486,492, it is Poland's sixth-largest city and its major seaport. Gdańsk lies at the mouth of the Motława River and is situated at the southern edge of Gdańsk Bay, close to the city of Gdynia and the resort town of Sopot; these form a metropolitan area called the Tricity (Trójmiasto), with a population of approximately 1.5 million. Gdańsk was first mentioned in 997 as part of the early Polish state, and thereafter grew into a trading town under the Piast and Samboride dynasties. Shifting between Polish and Teutonic control during the Middle Ages, it subsequently joined the Hanseatic League and, with considerable autonomy, served as the Polish Crown's principal seaport and largest city until the early 18th century. With the Partitions of Poland, the city was annexed by Prussia in 1793, and was integrated into the German Empire in 1871."}}, {"canonical_name": "bilis", "category": "ANATOMY", "subcategory": "FLUID", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "bilis", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "bilis", "category": "ANATOMY", "subcategory": "FLUID", "count": 1, "variants": ["bilis"], "contexts": ["Latin for bile"]}, {"entity_id": "bile", "book_id": "principles_of_psychology_james_1890", "name": "bile", "category": "ANATOMY", "subcategory": "FLUID", "count": 1, "variants": ["bile"], "contexts": ["fluid secreted by the liver"]}, {"entity_id": "bile", "book_id": "first_principles_spencer_1862", "name": "bile", "category": "ANATOMY", "subcategory": "FLUID", "count": 1, "variants": ["bile"], "contexts": ["bodily fluid flowing through vessels"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "bilis", "target_book": "principles_of_psychology_james_1890", "target_name": "bile", "similarity": 0.919}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "bilis", "target_book": "first_principles_spencer_1862", "target_name": "bile", "similarity": 0.919}, {"source_book": "principles_of_psychology_james_1890", "source_name": "bile", "target_book": "first_principles_spencer_1862", "target_name": "bile", "similarity": 1.0}], "id": 543, "stable_key": "clu_3a4782b1302df0bf", "ground_truth": {"modern_name": "Bile", "confidence": "high", "type": "concept", "note": "The Latin term 'bilis' directly translates to 'bile'. The contexts describe it as a fluid secreted by the liver and flowing through vessels, which accurately describes bile.", "wikidata_id": "Q208006", "wikidata_description": "central district and city in Bilecik Province, Turkey", "wikipedia_url": "https://en.wikipedia.org/wiki/Bilecik", "wikipedia_extract": "Bitlis (Armenian: Բաղեշ, romanized: Baghesh or Paghesh; Kurdish: Bidlîs Arabic: بدليس) is a city in southeastern Turkey. It is the seat of Bitlis District and Bitlis Province. Its population is 53,023 (2021). The city is located at an elevation of 1,545 metres, 15 km from Lake Van, in the steep-sided valley of the Bitlis River, a tributary of the Tigris. The local economy is mainly based on agricultural products which include fruits, grain and tobacco. Industry is fairly limited, and deals mainly with leatherworking, manufacture of tobacco products as well as weaving and dyeing of coarse cloth."}}, {"canonical_name": "Cabala", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "cabala", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Cabala", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Cabala"], "contexts": ["secret knowledge or tradition"]}, {"entity_id": "calema", "book_id": "coloquios_da_orta_1563", "name": "calema", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["calema"], "contexts": ["word meaning peace in Arabic"]}, {"entity_id": "caulas", "book_id": "polyanthea_medicinal", "name": "caulas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["caulas"], "contexts": ["causes"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Cabala", "target_book": "coloquios_da_orta_1563", "target_name": "calema", "similarity": 0.863}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Cabala", "target_book": "polyanthea_medicinal", "target_name": "caulas", "similarity": 0.841}], "id": 544, "stable_key": "clu_05612a685fb60ddc", "ground_truth": {"wikipedia_extract": "The cauda is a characteristic feature of songs in the conductus style of a cappella music which flourished between the mid-12th and the mid-13th century. The conductus style placed strict rules on composition, and some such rules were devoted to the cauda, which came at the penultimate syllable of each verse. It takes the form of a lengthy section of counterpoint - where several simultaneous melodies are combined into one - slurred over the one syllable. The cauda was repeated in each verse. The significance of the cauda in conductus music is such that most conducti were divided into the categories conductus cum cauda and conductus sine cauda (conductus with or without cauda.)  The latter made up less than a third of the repertoire. The writing of medieval music did not include strict rhythmic notation, but when multiple notes were given to one syllable, known as a melisma, special notation, known as rhythmic modes, were used."}}, {"canonical_name": "Servius", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "servius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Servius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Servius"], "contexts": ["ancient authority on Centaur origins"]}, {"entity_id": "servius", "book_id": "kosmos_humboldt_1845", "name": "Servius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Servius"], "contexts": ["ancient commentator on Virgil"]}, {"entity_id": "servius", "book_id": "coloquios_da_orta_1563", "name": "Servius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Servius"], "contexts": ["quoted regarding Ethiopia and India"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Servius", "target_book": "kosmos_humboldt_1845", "target_name": "Servius", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Servius", "target_book": "coloquios_da_orta_1563", "target_name": "Servius", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Servius", "target_book": "coloquios_da_orta_1563", "target_name": "Servius", "similarity": 1.0}], "id": 545, "stable_key": "clu_f9b323fff3d353b8", "ground_truth": {"modern_name": "Servius", "confidence": "high", "type": "person", "description": "Roman grammarian and commentator on Virgil", "note": "The contexts describe Servius as an ancient authority on classical literature and history, fitting the identification of Servius Grammaticus, the Roman commentator on Virgil.", "wikipedia_extract": "Galba ( GAL-bə; born Servius Sulpicius Galba; 24 December 3 BC – 15 January AD 69) was Roman emperor, ruling for 7 months from 8 June AD 68 to 15 January 69. He was the first emperor in the Year of the Four Emperors and assumed the throne following Emperor Nero's suicide. Born into a wealthy family, Galba held at various times the positions of praetor, consul, and governor of the provinces of Gallia Aquitania, Germania Superior, and Africa during the first half of the first century AD. He retired from his positions during the latter part of Claudius' reign (with the advent of Agrippina the Younger), but Nero later granted him the governorship of Hispania. Taking advantage of the defeat of Vindex's rebellion and Nero's suicide, he became emperor with the support of the Praetorian Guard. Galba's physical weakness and general apathy led to his rule being dominated by favorites.", "wikipedia_url": "https://en.wikipedia.org/wiki/Galba"}}, {"canonical_name": "Siler montanum", "category": "PLANT", "subcategory": "HERB", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "siler_montanum", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Siler montanum", "category": "PLANT", "subcategory": "HERB", "count": 1, "variants": ["Siler montanum"], "contexts": ["herb with medicinal properties"]}, {"entity_id": "siler_montanum", "book_id": "coloquios_da_orta_1563", "name": "siler montanum", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["siler montanum"], "contexts": ["mountain celery"]}, {"entity_id": "siler_monta", "book_id": "polyanthea_medicinal", "name": "Siler monta", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Siler monta"], "contexts": ["ingredient in an electuary remedy"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Siler montanum", "target_book": "coloquios_da_orta_1563", "target_name": "siler montanum", "similarity": 0.898}, {"source_book": "coloquios_da_orta_1563", "source_name": "siler montanum", "target_book": "polyanthea_medicinal", "target_name": "Siler monta", "similarity": 0.92}], "id": 546, "stable_key": "clu_e181b3e6512171fa", "ground_truth": {"wikipedia_extract": "Siler montanum, the laserwort, is a herbaceous perennial plant in the family Apiaceae. It is a robust perennial that can reach a height of about 30–100 centimetres (12–39 in). It has bipinnate, alternate leaves, and produces compound umbels of white five-stellate flowers from June to August. This species can be found in central and southern Europe, in the Alps, the Pyrenees, the Apennine Mountains and the Iberian Mountains. It occurs in gorges and rocky slopes at elevations of 800–2,250 metres (2,620–7,380 ft). The roots and seeds can be used as spices. and have been used in making gruit or beer Siler montanum subsp. apuanum F.Conti & Bartolucci – central Italy (Apuan Alps) Siler montanum subsp. corrasianum Bacch., Congiu, F.Conti & Bartolucci – Sardinia Siler montanum subsp. montanum – Alps, Pyrenees, and Iberian Mountains Siler montanum subsp. ogliastrinum Bacch., F.Conti & Bartolucci – Sardinia Siler montanum subsp. stabianum (Lacaita) F.Conti & Bartolucci – Italy (central and southern Apennines) Siler montanum Crantz."}}, {"canonical_name": "coagulation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "coagulation", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "coagulation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["coagulation"], "contexts": ["process of clotting or solidifying"]}, {"entity_id": "coagulationi_lactis", "book_id": "polyanthea_medicinal", "name": "coagulationi lactis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["coagulationi lactis"], "contexts": ["coagulation of milk, prevented by lime water"]}, {"entity_id": "coalesce", "book_id": "first_principles_spencer_1862", "name": "coalesce", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["coalesce"], "contexts": ["to merge or unite into one"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "coagulation", "target_book": "polyanthea_medicinal", "target_name": "coagulationi lactis", "similarity": 0.882}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "coagulation", "target_book": "first_principles_spencer_1862", "target_name": "coalesce", "similarity": 0.88}], "id": 547, "stable_key": "clu_5bbd39f2ec171546", "ground_truth": {"modern_name": "Coagulation", "confidence": "high", "type": "concept", "note": "The contexts describe the process of clotting or solidifying, and specifically 'coagulation of milk', which directly relates to the concept of coagulation.", "wikidata_id": "Q823027", "wikidata_description": "pathological process characterized by the widespread activation of the clotting cascade that results in the formation of blood clots in the small blood vessels throughout the body", "wikipedia_extract": "Disseminated intravascular coagulation (DIC) is a condition in which blood clots form throughout the body, blocking small blood vessels. Symptoms may include chest pain, shortness of breath, leg pain, problems speaking, or problems moving parts of the body. As clotting factors and platelets are used up, bleeding may occur. This may include blood in the urine, blood in the stool, or bleeding into the skin. Complications may include organ failure. Relatively common causes include sepsis, surgery, major trauma, cancer, and complications of pregnancy.", "wikipedia_url": "https://en.wikipedia.org/wiki/Disseminated_intravascular_coagulation"}}, {"canonical_name": "venation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "venation", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "venation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["venation"], "contexts": ["manner of hunting or tracking"]}, {"entity_id": "veneſectionibus", "book_id": "polyanthea_medicinal", "name": "veneſectionibus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["veneſectionibus"], "contexts": ["medical procedure, bloodletting"]}, {"entity_id": "venial", "book_id": "connexion_physical_sciences_somerville_1858", "name": "venial", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["venial"], "contexts": ["point for planetary motion estimation"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "venation", "target_book": "polyanthea_medicinal", "target_name": "veneſectionibus", "similarity": 0.861}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "venation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "venial", "similarity": 0.855}], "id": 548, "stable_key": "clu_10acb92ca47ece40", "ground_truth": {"modern_name": "Venesection", "confidence": "medium", "type": "concept", "note": "The term 'venation' is ambiguous. In context, 'veneſectionibus' (from polyanthea_medicinal) clearly refers to bloodletting (venesection). The other contexts are less clear: 'manner of hunting or tracking' for 'venation' is a possible meaning of the word, but not medical. 'Venial' in the context of planetary motion estimation is also a stretch and likely a misreading or unrelated. Given the prominence of 'venesection' in early modern medicine, and the possibility of OCR error or archaic usage for 'venation' meaning the practice of bloodletting, 'Venesection' is the most plausible medical referent, though with medium confidence due to ambiguity.", "wikidata_id": "Q886549", "wikidata_description": "process of obtaining intravenous access", "wikipedia_extract": "Humorism, the humoral theory, or humoralism, was a system of medicine detailing a supposed makeup and workings of the human body, adopted by Ancient Greek and Roman physicians and philosophers. Humorism began to fall out of favor in the 17th century and it was definitively disproved with the discovery of microbes. The concept of \"humors\" may have origins in Ancient Egyptian medicine, or Mesopotamia, though it was not systemized until ancient Greek thinkers. The word humor is a translation of Greek χυμός, chymos (literally 'juice' or 'sap', metaphorically 'flavor'). Early texts on Indian Ayurveda medicine presented a theory of three or four humors (doṣas), which they sometimes linked with the five elements (pañca-bhūta): earth, water, fire, air, and space. The concept of \"humors\" (chemical systems regulating human behaviour) became more prominent from the writing of medical theorist Alcmaeon of Croton (c.", "wikipedia_url": "https://en.wikipedia.org/wiki/Humorism"}}, {"canonical_name": "round", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "round", "book_id": "english_physician_1652", "name": "round", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["round"], "contexts": ["shape of heads"]}, {"entity_id": "round", "book_id": "principles_of_psychology_james_1890", "name": "round", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["round"], "contexts": ["shape attribute of an object"]}, {"entity_id": "redondeza", "book_id": "coloquios_da_orta_1563", "name": "redondeza", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["redondeza"], "contexts": ["quality of pearls"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "round", "target_book": "principles_of_psychology_james_1890", "target_name": "round", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "round", "target_book": "coloquios_da_orta_1563", "target_name": "redondeza", "similarity": 0.84}, {"source_book": "principles_of_psychology_james_1890", "source_name": "round", "target_book": "coloquios_da_orta_1563", "target_name": "redondeza", "similarity": 0.84}], "id": 549, "stable_key": "clu_186616daf0a8c080", "ground_truth": {"modern_name": "roundness", "confidence": "high", "type": "concept", "wikidata_id": "Q128171531", "wikidata_description": "scholarly article", "wikipedia_extract": "Body roundness index (BRI) is a calculated geometric index used to quantify an aspect of a person's individual body shape. Based on the principle of body eccentricity, it provides a rapid visual and anthropometric tool for health evaluation. Introduced in 2013, the BRI calculation can be used to estimate total and visceral body fat. Ranges of healthy body roundness have been established to accurately classify people with healthy fat mass (weight) compared to obese people who are at risk for morbidities. Compared to traditional metrics, such as the body mass index (BMI, which uses weight and height), BRI may improve predictions of the amount of body fat and the volume of visceral adipose tissue. Despite its common use, BMI can misclassify individuals as obese because it does not distinguish between a person's lean body mass and fat mass.", "wikipedia_url": "https://en.wikipedia.org/wiki/Body_roundness_index"}}, {"canonical_name": "Secon", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "secon", "book_id": "english_physician_1652", "name": "Secon", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Secon"], "contexts": ["medical term, likely secundine"]}, {"entity_id": "secondary_sclerosis", "book_id": "principles_of_psychology_james_1890", "name": "secondary sclerosis", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["secondary sclerosis"], "contexts": ["nerve tissue hardening"]}, {"entity_id": "secundina", "book_id": "coloquios_da_orta_1563", "name": "secundina", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["secundina"], "contexts": ["placenta"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Secon", "target_book": "principles_of_psychology_james_1890", "target_name": "secondary sclerosis", "similarity": 0.824}, {"source_book": "english_physician_1652", "source_name": "Secon", "target_book": "coloquios_da_orta_1563", "target_name": "secundina", "similarity": 0.894}], "id": 550, "stable_key": "clu_4d84f2a2e95c40f2", "ground_truth": {"modern_name": "secundine", "confidence": "medium", "type": "disease", "modern_term": "secundine", "note": "The term 'secondary sclerosis' suggests a different meaning, but 'secundina' and context of placenta point to secundine."}}, {"canonical_name": "Digestive", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "digestive", "book_id": "english_physician_1652", "name": "Digestive", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Digestive"], "contexts": ["bodily virtue"]}, {"entity_id": "digestia", "book_id": "historia_medicinal_monardes_1574", "name": "digestia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["digestia"], "contexts": ["process of digestion"]}, {"entity_id": "digestiva", "book_id": "coloquios_da_orta_1563", "name": "digestiva", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["digestiva"], "contexts": ["medicinal property of tamarind pulp"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Digestive", "target_book": "historia_medicinal_monardes_1574", "target_name": "digestia", "similarity": 0.945}, {"source_book": "english_physician_1652", "source_name": "Digestive", "target_book": "coloquios_da_orta_1563", "target_name": "digestiva", "similarity": 0.927}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "digestia", "target_book": "coloquios_da_orta_1563", "target_name": "digestiva", "similarity": 0.923}], "id": 551, "stable_key": "clu_e0d8d7fcead7bec2", "ground_truth": {"modern_name": "digestion", "confidence": "high", "type": "concept", "wikidata_id": "Q11978", "wikidata_description": "biological process of breaking down food and other matter", "wikipedia_url": "https://en.wikipedia.org/wiki/Maltodextrin", "wikipedia_extract": "Maltodextrin is a name shared by two different families of chemicals. Both families are glucose polymers (also called dextrose polymers or dextrins), but have little chemical or nutritional similarity. The digestible maltodextrins (or simply maltodextrins) are  manufactured as white solids derived from chemical processing of plant starches. They are used as food additives, which are digested rapidly, providing glucose as food energy. They are generally recognized as safe (GRAS) for food and beverage manufacturing in numerous products. Due to their rapid production of glucose, digestible maltodextrins are potential risks for people with diabetes."}}, {"canonical_name": "Comment", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "comment", "book_id": "english_physician_1652", "name": "Comment", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Comment"], "contexts": ["Mathiolus' upon Dioscorides"]}, {"entity_id": "commentary", "book_id": "coloquios_da_orta_1563", "name": "Commentary", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Commentary"], "contexts": ["work by Burton"]}, {"entity_id": "commentar__de_peſte", "book_id": "polyanthea_medicinal", "name": "Commentar. de Peſte", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Commentar. de Peſte"], "contexts": ["commentary on the plague"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Comment", "target_book": "coloquios_da_orta_1563", "target_name": "Commentary", "similarity": 0.911}, {"source_book": "english_physician_1652", "source_name": "Comment", "target_book": "polyanthea_medicinal", "target_name": "Commentar. de Peſte", "similarity": 0.836}, {"source_book": "coloquios_da_orta_1563", "source_name": "Commentary", "target_book": "polyanthea_medicinal", "target_name": "Commentar. de Peſte", "similarity": 0.882}], "id": 552, "stable_key": "clu_a18613bfb796b739", "ground_truth": {"modern_name": "commentary", "confidence": "high", "type": "text", "wikidata_id": "Q1749541", "wikidata_description": "close explication of a text, focusing on language", "wikipedia_url": "https://en.wikipedia.org/wiki/Commentary_%28philology%29"}}, {"canonical_name": "Syracuse", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "syracuse", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Syracuse", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Syracuse"], "contexts": ["location of freshwater eruptions"]}, {"entity_id": "syracuse", "book_id": "principles_of_psychology_james_1890", "name": "Syracuse", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Syracuse"], "contexts": ["city stormed during Archimedes' meditation"]}, {"entity_id": "syracuse", "book_id": "kosmos_humboldt_1845", "name": "Syracuse", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Syracuse"], "contexts": ["city with quarries yielding marine fossils"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Syracuse", "target_book": "principles_of_psychology_james_1890", "target_name": "Syracuse", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Syracuse", "target_book": "kosmos_humboldt_1845", "target_name": "Syracuse", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Syracuse", "target_book": "kosmos_humboldt_1845", "target_name": "Syracuse", "similarity": 1.0}], "id": 553, "stable_key": "clu_1a7d9a9a31e32857", "ground_truth": {"modern_name": "Syracuse", "confidence": "high", "type": "place", "country": "Italy", "wikidata_id": "Q128069", "wikidata_description": "city in and county seat of Onondaga County, New York, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Syracuse%2C_New_York"}}, {"canonical_name": "art de la navigation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "art_de_la_navigation", "book_id": "relation_historique_humboldt_vol3_1825", "name": "art de la navigation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["art de la navigation"], "contexts": ["immense progress exposes indigenous cultures"]}, {"entity_id": "navigation", "book_id": "kosmos_humboldt_1845", "name": "navigation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["navigation"], "contexts": ["act of guiding a ship or aircraft"]}, {"entity_id": "navigation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Navigation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Navigation"], "contexts": ["importance of lunar motions, laws of storms"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "art de la navigation", "target_book": "kosmos_humboldt_1845", "target_name": "navigation", "similarity": 0.889}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "art de la navigation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Navigation", "similarity": 0.877}, {"source_book": "kosmos_humboldt_1845", "source_name": "navigation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Navigation", "similarity": 0.989}], "id": 554, "stable_key": "clu_7965e94587f4a5ae", "ground_truth": {"modern_name": "navigation", "confidence": "high", "type": "concept", "wikidata_id": "Q102066", "wikidata_description": "process of monitoring and directing the movement of a person, craft or vehicle from one place to another", "wikipedia_url": "https://en.wikipedia.org/wiki/Navigation"}}, {"canonical_name": "îles Kuriles", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "îles_kuriles", "book_id": "relation_historique_humboldt_vol3_1825", "name": "îles Kuriles", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["îles Kuriles"], "contexts": ["island chain"]}, {"entity_id": "kurile_islands", "book_id": "kosmos_humboldt_1845", "name": "Kurile Islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Kurile Islands"], "contexts": ["islands with volcanic eruptions"]}, {"entity_id": "kurile_islands", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Kurile Islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Kurile Islands"], "contexts": ["islands between Japan and Russia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "îles Kuriles", "target_book": "kosmos_humboldt_1845", "target_name": "Kurile Islands", "similarity": 0.959}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "îles Kuriles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kurile Islands", "similarity": 0.959}, {"source_book": "kosmos_humboldt_1845", "source_name": "Kurile Islands", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kurile Islands", "similarity": 1.0}], "id": 555, "stable_key": "clu_e157321386eb9d53", "ground_truth": {"modern_name": "Kurile Islands", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q80389", "wikidata_description": "island chain located in Northeast Asia administered by Russia", "wikipedia_url": "https://en.wikipedia.org/wiki/Kuril_Islands"}}, {"canonical_name": "Berne", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "berne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Berne", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Berne"], "contexts": ["city in Switzerland"]}, {"entity_id": "berne", "book_id": "kosmos_humboldt_1845", "name": "Berne", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Berne"], "contexts": ["city in Switzerland"]}, {"entity_id": "berne", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Berne", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Berne"], "contexts": ["city with increasing mine temperature"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Berne", "target_book": "kosmos_humboldt_1845", "target_name": "Berne", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Berne", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Berne", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Berne", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Berne", "similarity": 1.0}], "id": 556, "stable_key": "clu_526615ec897540ee", "ground_truth": {"modern_name": "Bern", "confidence": "high", "type": "place", "country": "Switzerland", "wikidata_id": "Q935784", "wikidata_description": "city and urban gmina of Poland", "wikipedia_extract": "Bern (Swiss Standard German: [bɛrn] ), or Berne (French: [bɛʁn] ), is the de facto capital of Switzerland, referred to as the \"federal city\". With a population of about 146,000 (as of 2024), Bern is the fifth-most populous city in Switzerland, behind Zürich, Geneva, Basel and Lausanne. The Bern agglomeration, which includes 36 municipalities, had a population of 406,900 in 2014. The metropolitan area had a population of 660,000 in 2000. Bern is also the capital of the canton of Bern, the second-most populous of Switzerland's cantons. The city's official language is German.", "wikipedia_url": "https://en.wikipedia.org/wiki/Bern"}}, {"canonical_name": "Thèbes", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "thèbes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Thèbes", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Thèbes"], "contexts": ["ancient city in Egypt"]}, {"entity_id": "thebes", "book_id": "kosmos_humboldt_1845", "name": "Thebes", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Thebes"], "contexts": ["ancient Egyptian city"]}, {"entity_id": "tebes", "book_id": "coloquios_da_orta_1563", "name": "Tebes", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Tebes"], "contexts": ["city in Egypt where opium is produced"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Thèbes", "target_book": "kosmos_humboldt_1845", "target_name": "Thebes", "similarity": 0.871}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Thèbes", "target_book": "coloquios_da_orta_1563", "target_name": "Tebes", "similarity": 0.873}, {"source_book": "kosmos_humboldt_1845", "source_name": "Thebes", "target_book": "coloquios_da_orta_1563", "target_name": "Tebes", "similarity": 0.919}], "id": 557, "stable_key": "clu_2d8d4009dd3b3c2f", "ground_truth": {"modern_name": "Thebes", "confidence": "high", "type": "place", "country": "Egypt", "wikidata_id": "Q83442013", "wikidata_description": "family name", "wikipedia_extract": "Thebes ( THEEBZ; Greek: Θήβα, Thíva [ˈθiva]; Ancient Greek: Θῆβαι, Thêbai [tʰɛ̂ːbai̯]) is a city in Boeotia, Central Greece, and one of the oldest continuously inhabited cities in the world. It is the largest city in Boeotia and a major center for the region, along with Livadeia and Tanagra. It played an important role in Greek mythology, as the site of the stories of Cadmus, Oedipus, Dionysus, Heracles and others. One myth had the city founded by Agenor, which gave rise to the (now somewhat obscure) name \"Agenorids\" to denote Thebans. Archaeological excavations in and around Thebes have revealed a Mycenaean settlement and clay tablets written in the Linear B script, indicating the importance of the site in the Bronze Age. Thebes was the largest city of the ancient region of Boeotia and was the leader of the Boeotian confederacy.", "wikipedia_url": "https://en.wikipedia.org/wiki/Thebes,_Greece"}}, {"canonical_name": "Pevas", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "pevas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pevas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Pevas"], "contexts": ["location on the Amazon river"]}, {"entity_id": "pegus", "book_id": "coloquios_da_orta_1563", "name": "Pegus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Pegus"], "contexts": ["place name"]}, {"entity_id": "peu", "book_id": "polyanthea_medicinal", "name": "Peu", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Peu"], "contexts": ["location mentioned in text"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pevas", "target_book": "coloquios_da_orta_1563", "target_name": "Pegus", "similarity": 0.844}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pevas", "target_book": "polyanthea_medicinal", "target_name": "Peu", "similarity": 0.85}, {"source_book": "coloquios_da_orta_1563", "source_name": "Pegus", "target_book": "polyanthea_medicinal", "target_name": "Peu", "similarity": 0.85}], "id": 558, "stable_key": "clu_b9e6d34b151ed4c1", "ground_truth": {"wikipedia_extract": "Pebas District is one of four districts of the province Mariscal Ramón Castilla in Peru. Its name is derived from Peba, an indigenous ethnic group and language."}}, {"canonical_name": "Rhodes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "rhodes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rhodes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Rhodes"], "contexts": ["island"]}, {"entity_id": "rhodes", "book_id": "coloquios_da_orta_1563", "name": "Rhodes", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Rhodes"], "contexts": ["island city, source of spice"]}, {"entity_id": "rho", "book_id": "ricettario_fiorentino_1597", "name": "Rho", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Rho"], "contexts": ["island where Aspalatho grows"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rhodes", "target_book": "coloquios_da_orta_1563", "target_name": "Rhodes", "similarity": 0.839}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rhodes", "target_book": "ricettario_fiorentino_1597", "target_name": "Rho", "similarity": 0.853}], "id": 559, "stable_key": "clu_7a70035c1af64d48", "ground_truth": {"wikipedia_extract": "Rhodes ( ; Greek: Ρόδος, romanized: Ródos [ˈroðos]) is the largest of Greece's Dodecanese islands and their historical capital; it is the ninth largest island in the  Mediterranean Sea. Administratively, Rhodes constitutes a separate municipality within the Rhodes regional unit, which is part of the South Aegean administrative region. The principal town of the island and seat of the municipality is the city of Rhodes, home to 50,636 inhabitants according to the 2011 census. By 2022, the island’s population had grown to 125,113 people. Located northeast of Crete and southeast of Athens, Rhodes is often referred to by several nicknames: the \"Island of the Sun\" after its patron sun god Helios; \"The Pearl Island\"; and \"The Island of the Knights\", a reference to the Knights of Saint John of Jerusalem, who ruled the island from 1310 to 1522. Historically, Rhodes was famous for the Colossus of Rhodes, one of the Seven Wonders of the Ancient World."}}, {"canonical_name": "pecado", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "pecado", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pecado", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["pecado"], "contexts": ["religious concept"]}, {"entity_id": "pecado_do_primeiro_padre", "book_id": "coloquios_da_orta_1563", "name": "pecado do primeiro padre", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["pecado do primeiro padre"], "contexts": ["sin of the first father"]}, {"entity_id": "pecado", "book_id": "polyanthea_medicinal", "name": "pecado", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["pecado"], "contexts": ["sin, a moral concept"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pecado", "target_book": "coloquios_da_orta_1563", "target_name": "pecado do primeiro padre", "similarity": 0.833}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pecado", "target_book": "polyanthea_medicinal", "target_name": "pecado", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "pecado do primeiro padre", "target_book": "polyanthea_medicinal", "target_name": "pecado", "similarity": 0.833}], "id": 560, "stable_key": "clu_2d4e8ff875b9525a", "ground_truth": {"wikipedia_extract": "Pecado is a monotypic genus of dwarf spiders containing the single species, Pecado impudicus. It was first described by G. Hormiga & N. Scharff in 2005, and has only been found in Spain, Morocco, and Algeria."}}, {"canonical_name": "Worcester", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "worcester", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Worcester", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Worcester"], "contexts": ["city in Massachusetts"]}, {"entity_id": "worcestershire", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Worcestershire", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Worcestershire"], "contexts": ["location of Mr. Hall"]}, {"entity_id": "worcester", "book_id": "first_principles_spencer_1862", "name": "Worcester", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Worcester"], "contexts": ["city with establishments"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Worcester", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Worcestershire", "similarity": 0.812}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Worcester", "target_book": "first_principles_spencer_1862", "target_name": "Worcester", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Worcestershire", "target_book": "first_principles_spencer_1862", "target_name": "Worcester", "similarity": 0.812}], "id": 561, "stable_key": "clu_2ea25941f921ca45", "ground_truth": {"modern_name": "Worcester", "confidence": "high", "type": "place", "country": "United Kingdom", "note": "Contexts mention both UK and US locations, but \"Worcestershire\" points to UK. Primary context is likely UK.", "wikidata_id": "Q1646181", "wikidata_description": "city and the county town of Worcestershire, England", "wikipedia_url": "https://en.wikipedia.org/wiki/Worcester,_Massachusetts", "wikipedia_extract": "Worcester (  WUUST-ər, locally [ˈwɪstə] ) is a city in the U.S. state of Massachusetts. The principal city of Central Massachusetts, Worcester is both the second-most populous city in the state, and the 113th most populous city in the United States. Named after Worcester, England, the city had 206,518 people at the 2020 census, also making it the second-most populous city in New England, after Boston. Because it is near the geographic center of Massachusetts, Worcester is known as the \"Heart of the Commonwealth\"; a heart is the official symbol of the city. Worcester is the historical seat of Worcester County."}}, {"canonical_name": "transparent", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "transparent", "book_id": "principles_of_psychology_james_1890", "name": "transparent", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["transparent"], "contexts": ["visual quality"]}, {"entity_id": "transparency", "book_id": "kosmos_humboldt_1845", "name": "transparency", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["transparency"], "contexts": ["property of the atmosphere"]}, {"entity_id": "transparency", "book_id": "connexion_physical_sciences_somerville_1858", "name": "transparency", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["transparency"], "contexts": ["ability to allow light to pass through"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "transparent", "target_book": "kosmos_humboldt_1845", "target_name": "transparency", "similarity": 0.948}, {"source_book": "principles_of_psychology_james_1890", "source_name": "transparent", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "transparency", "similarity": 0.948}, {"source_book": "kosmos_humboldt_1845", "source_name": "transparency", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "transparency", "similarity": 1.0}], "id": 562, "stable_key": "clu_6a5d2c800b84dc15", "ground_truth": {"modern_name": "transparent", "confidence": "high", "type": "concept", "wikidata_id": "Q568753", "wikidata_description": "economic concept", "wikipedia_url": "https://en.wikipedia.org/wiki/Transparency%20%28market%29"}}, {"canonical_name": "Stockholm", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "stockholm", "book_id": "principles_of_psychology_james_1890", "name": "Stockholm", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Stockholm"], "contexts": ["location of Swedish Academy of Sciences"]}, {"entity_id": "stockholm", "book_id": "kosmos_humboldt_1845", "name": "Stockholm", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Stockholm"], "contexts": ["city for latitude comparison"]}, {"entity_id": "stockholm", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Stockholm", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Stockholm"], "contexts": ["city on isothermal line of 41° Fahrenheit"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Stockholm", "target_book": "kosmos_humboldt_1845", "target_name": "Stockholm", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Stockholm", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Stockholm", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Stockholm", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Stockholm", "similarity": 1.0}], "id": 563, "stable_key": "clu_0a1c6ae72d1258a0", "ground_truth": {"modern_name": "Stockholm", "confidence": "high", "type": "place", "country": "Sweden", "wikidata_id": "Q1754", "wikidata_description": "capital and largest city of Sweden", "wikipedia_url": "https://en.wikipedia.org/wiki/Stockholm", "wikipedia_extract": "Stockholm (; Swedish: [ˈstɔ̂kː(h)ɔlm] ) is the capital and most populous city of Sweden, as well as the largest urban area in the Nordic countries. Approximately 1 million people live in the municipality, with 1.6 million in the urban area, and 2.5 million in the metropolitan area. The city stretches across fourteen islands where Lake Mälaren flows into the Baltic Sea. Outside the city to the east, and along the coast, is the island chain of the Stockholm archipelago. The area has been settled since the Stone Age, in the 6th millennium BC, and was founded as a city in 1252 by Swedish statesman Birger Jarl. The city serves as the county seat of Stockholm County."}}, {"canonical_name": "animal matter", "category": "ANIMAL", "subcategory": "PRODUCT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "animal_matter", "book_id": "kosmos_humboldt_1845", "name": "animal matter", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["animal matter"], "contexts": ["substance derived from animals"]}, {"entity_id": "animal_products", "book_id": "polyanthea_medicinal", "name": "animal products", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["animal products"], "contexts": ["materials derived from animals"]}, {"entity_id": "animal_substances", "book_id": "connexion_physical_sciences_somerville_1858", "name": "animal substances", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["animal substances"], "contexts": ["substances derived from animals"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "animal matter", "target_book": "polyanthea_medicinal", "target_name": "animal products", "similarity": 0.868}, {"source_book": "kosmos_humboldt_1845", "source_name": "animal matter", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "animal substances", "similarity": 0.931}, {"source_book": "polyanthea_medicinal", "source_name": "animal products", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "animal substances", "similarity": 0.868}], "id": 564, "stable_key": "clu_4432ea341aa8a930", "ground_truth": {"modern_name": "animal products", "confidence": "high", "type": "concept", "wikipedia_extract": "Animal husbandry is the branch of agriculture concerned with animals that are raised for meat, fibre, milk, or other products. It includes day-to-day care, management, production, nutrition, selective breeding, and the raising of livestock. Husbandry has a long history, starting with the Neolithic Revolution when animals were first domesticated, from around 13,000 BC onwards, predating farming of the first crops. During the period of ancient societies like ancient Egypt, cattle, sheep, goats, and pigs were being raised on farms. Major changes took place in the Columbian exchange, when Old World livestock were brought to the New World, and then in the British Agricultural Revolution of the 18th century, when livestock breeds like the Dishley Longhorn cattle and Lincoln Longwool sheep were rapidly improved by agriculturalists, such as Robert Bakewell, to yield more meat, milk, and wool. A wide range of other species, such as horse, water buffalo, llama, rabbit, and guinea pig, are used as livestock in some parts of the world.", "wikipedia_url": "https://en.wikipedia.org/wiki/Animal_husbandry"}}, {"canonical_name": "star dust", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "star_dust", "book_id": "kosmos_humboldt_1845", "name": "star dust", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["star dust"], "contexts": ["interstellar material"]}, {"entity_id": "star_dust", "book_id": "connexion_physical_sciences_somerville_1858", "name": "star dust", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["star dust"], "contexts": ["material in Milky Way"]}, {"entity_id": "star", "book_id": "first_principles_spencer_1862", "name": "star", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["star"], "contexts": ["English word for steorra"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "star dust", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "star dust", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "star dust", "target_book": "first_principles_spencer_1862", "target_name": "star", "similarity": 0.839}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "star dust", "target_book": "first_principles_spencer_1862", "target_name": "star", "similarity": 0.839}], "id": 565, "stable_key": "clu_54e53dd1eac27691", "ground_truth": {"modern_name": "stardust", "confidence": "high", "type": "concept", "note": "The mention of 'star' alone in 'first_principles_spencer_1862' might be ambiguous, but the context of 'stardust' in other sources strongly suggests this referent.", "wikidata_id": "Q93717770", "wikidata_description": "vocal track by Willie Nelson; 1978 studio recording; cover version"}}, {"canonical_name": "Piloto", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "piloto", "book_id": "historia_medicinal_monardes_1574", "name": "Piloto", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Piloto"], "contexts": ["profession of a sick person"]}, {"entity_id": "pilotos", "book_id": "coloquios_da_orta_1563", "name": "pilotos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["pilotos"], "contexts": ["Pilots appointed by sovereigns"]}, {"entity_id": "piloto", "book_id": "polyanthea_medicinal", "name": "Piloto", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Piloto"], "contexts": ["pilot who uses a helm"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Piloto", "target_book": "coloquios_da_orta_1563", "target_name": "pilotos", "similarity": 0.949}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Piloto", "target_book": "polyanthea_medicinal", "target_name": "Piloto", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "pilotos", "target_book": "polyanthea_medicinal", "target_name": "Piloto", "similarity": 0.949}], "id": 566, "stable_key": "clu_375c4d6508d27a65", "ground_truth": {"modern_name": "pilot", "confidence": "high", "type": "person", "description": "A person who navigates a ship or aircraft.", "note": "The term 'Piloto' refers to a profession. While some individuals might be named Piloto, the context suggests the occupation.", "wikidata_id": "Q2095549", "wikidata_description": "person controlling an aircraft in flight", "wikipedia_extract": "Jonathan Nolan (born 6 June 1976) is a British and American screenwriter and producer. He is the creator of the CBS science fiction series Person of Interest (2011–2016) and co-creator of the HBO science fiction/Western series Westworld (2016–2022). Nolan has collaborated on several films with his brother, film director Christopher Nolan, who adapted Jonathan's short story \"Memento Mori\" into the neo-noir thriller film Memento (2000). Together, the brothers co-wrote the mystery-thriller film The Prestige (2006), the superhero films The Dark Knight (2008) and The Dark Knight Rises (2012), and the science-fiction film Interstellar (2014). In 2024, he executive produced and directed the first three episodes of the television series adaptation of Fallout. Nolan was nominated for the Academy Award for Best Original Screenplay for Memento, and for the Primetime Emmy Award for Outstanding Writing for a Drama Series and Outstanding Directing for a Drama Series for Westworld.", "wikipedia_url": "https://en.wikipedia.org/wiki/Jonathan_Nolan"}}, {"canonical_name": "tornillo", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "tornillo", "book_id": "historia_medicinal_monardes_1574", "name": "tornillo", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["tornillo"], "contexts": ["instrument for extraction"]}, {"entity_id": "trombeta", "book_id": "coloquios_da_orta_1563", "name": "trombeta", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["trombeta"], "contexts": ["use of shell as instrument"]}, {"entity_id": "torculo", "book_id": "ricettario_fiorentino_1597", "name": "torculo", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["torculo"], "contexts": ["device for pressing oils"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "tornillo", "target_book": "coloquios_da_orta_1563", "target_name": "trombeta", "similarity": 0.851}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "tornillo", "target_book": "ricettario_fiorentino_1597", "target_name": "torculo", "similarity": 0.884}, {"source_book": "coloquios_da_orta_1563", "source_name": "trombeta", "target_book": "ricettario_fiorentino_1597", "target_name": "torculo", "similarity": 0.848}], "id": 567, "stable_key": "clu_e3497871d4added7", "ground_truth": {"modern_name": "press", "confidence": "medium", "type": "object", "note": "The Spanish 'tornillo' (screw) and Portuguese 'trombeta' (trumpet) are ambiguous. 'Torculo' in Italian refers to a press (like for oil or wine), which aligns with the context of extracting or pressing.", "wikidata_id": "Q124448878", "wikidata_description": "US patent 11413838", "wikipedia_extract": "Tornillo ( tor-NEE-yoh) is a border town in El Paso County, Texas, United States. The population was 1,568 at the 2010 census. For statistical purposes, the United States Census Bureau has defined this unincorporated community as a census-designated place (CDP). It is part of the El Paso metropolitan area. The Tornillo and Guadalupe, Chihuahua, area is connected by the Tornillo–Guadalupe International Bridge. The town is the home of Sonic Ranch, the world's largest residential recording complex.", "wikipedia_url": "https://en.wikipedia.org/wiki/Tornillo,_Texas"}}, {"canonical_name": "paroxismo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "paroxismo", "book_id": "historia_medicinal_monardes_1574", "name": "paroxismo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["paroxismo"], "contexts": ["sudden onset of disease symptoms"]}, {"entity_id": "paroxismum", "book_id": "polyanthea_medicinal", "name": "paroxismum", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["paroxismum"], "contexts": ["paroxysm of illness"]}, {"entity_id": "paroxysms", "book_id": "first_principles_spencer_1862", "name": "paroxysms", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["paroxysms"], "contexts": ["sudden outbursts of symptoms"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "paroxismo", "target_book": "polyanthea_medicinal", "target_name": "paroxismum", "similarity": 0.887}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "paroxismo", "target_book": "first_principles_spencer_1862", "target_name": "paroxysms", "similarity": 0.922}, {"source_book": "polyanthea_medicinal", "source_name": "paroxismum", "target_book": "first_principles_spencer_1862", "target_name": "paroxysms", "similarity": 0.835}], "id": 568, "stable_key": "clu_9cecb55c7344f275", "ground_truth": {"modern_name": "Paroxysm", "confidence": "high", "type": "disease", "modern_term": "Paroxysm", "wikidata_id": "Q1479494", "wikidata_description": "disease of the blood characterized by destruction of red blood cells by the complement system, a part of the body's innate immune system", "wikipedia_url": "https://en.wikipedia.org/wiki/Paroxysmal%20nocturnal%20hemoglobinuria"}}, {"canonical_name": "fetos", "category": "PLANT", "subcategory": "PLANT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "fetos", "book_id": "coloquios_da_orta_1563", "name": "fetos", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["fetos"], "contexts": ["fern fronds"]}, {"entity_id": "feta", "book_id": "ricettario_fiorentino_1597", "name": "fetA", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["fetA"], "contexts": ["plant that is viscous with humidity"]}, {"entity_id": "fetidas", "book_id": "polyanthea_medicinal", "name": "fetidas", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["fetidas"], "contexts": ["herb used in pills"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "fetos", "target_book": "ricettario_fiorentino_1597", "target_name": "fetA", "similarity": 0.873}, {"source_book": "coloquios_da_orta_1563", "source_name": "fetos", "target_book": "polyanthea_medicinal", "target_name": "fetidas", "similarity": 0.893}, {"source_book": "ricettario_fiorentino_1597", "source_name": "fetA", "target_book": "polyanthea_medicinal", "target_name": "fetidas", "similarity": 0.845}], "id": 569, "stable_key": "clu_260ec41f2c375a83", "ground_truth": {"modern_name": "Fern", "confidence": "medium", "type": "plant", "note": "The term 'fetos' is ambiguous and could refer to various plants, but 'fern' is a plausible interpretation in a medicinal context, especially when referring to fronds or herbs used in pills. However, without more context, a definitive Linnaean classification is not possible.", "wikidata_id": "Q37503206", "wikidata_description": "family name", "wikipedia_extract": "Neonatal alloimmune thrombocytopenia (NAITP, NAIT, NATP or NAT) is a disease that affects babies in which the platelet count is decreased because the mother's immune system attacks her fetus' or newborn's platelets. A low platelet count increases the risk of bleeding in the fetus and newborn. If the bleeding occurs in the brain, there may be long-term effects. Platelet antigens are inherited from both mother and father. NAIT is caused by antibodies specific for platelet antigens inherited from the father but which are absent in the mother. Fetomaternal transfusions (or fetomaternal hemorrhage) results in the recognition of these antigens by the mother's immune system as non-self, with the subsequent generation of allo-reactive antibodies which cross the placenta.", "wikipedia_url": "https://en.wikipedia.org/wiki/Neonatal_alloimmune_thrombocytopenia"}}, {"canonical_name": "Orta", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 656, "members": [{"entity_id": "orta", "book_id": "coloquios_da_orta_1563", "name": "Orta", "category": "PERSON", "subcategory": "SCHOLAR", "count": 653, "variants": ["Orta", "Carda da Orta", "Garcia Orta", "Garcia d'Orta", "Garcia da Orta", "Garoa da Orta", "Gcar^ da da Orta", "ORTA", "Orta (Garcia da)", "Ortam", "Ota", "orta"], "contexts": ["interlocutor, likely the author", "Garcia da Orta, author of Colóquios"]}, {"entity_id": "m__orta", "book_id": "relation_historique_humboldt_vol3_1825", "name": "M. Orta", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["M. Orta"], "contexts": ["physician whose works may have been lost", "provided temperature records for Vera-Cruz"]}, {"entity_id": "segundo_orta", "book_id": "coloquios_da_orta_1563", "name": "Segundo Orta", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Segundo Orta"], "contexts": ["author, mentioned in the text"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Orta", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "M. Orta", "similarity": 0.904}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "M. Orta", "target_book": "coloquios_da_orta_1563", "target_name": "Segundo Orta", "similarity": 0.809}], "id": 570, "stable_key": "clu_3bdbb7d46b63ec26", "ground_truth": {"modern_name": "Garcia da Orta", "confidence": "high", "type": "person", "description": "Renaissance Portuguese physician and naturalist, author of 'Colóquios'.", "note": "The central figure whose name is strongly associated with this cluster.", "wikipedia_extract": "Garcia de Orta (or Garcia d'Orta; 1501–1568) was a Portuguese physician, herbalist, and naturalist, who worked primarily in Goa and Bombay in Portuguese India. A pioneer of tropical medicine, pharmacognosy, and ethnobotany, Garcia used an experimental approach to the identification and the use of herbal medicines, rather than the older approach of received knowledge. His most famous work is Colóquios dos simples e drogas da India, a book on simples (herbs used individually and not mixed with others) and drugs. Published in 1563, it is the earliest treatise on the medicinal and economic plants of India. Carolus Clusius translated it into Latin, which was widely used as a standard reference text on medicinal plants. Although Garcia de Orta did not suffer the Goa Inquisition, his sister Catarina was burnt at the stake in 1569 for being a secret Jew and, based on her confession, his remains were later exhumed and burnt, along with an effigy, at an auto-da-fé."}}, {"canonical_name": "oleo de Vitriolo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 236, "members": [{"entity_id": "oleo_de_vitriolo", "book_id": "polyanthea_medicinal", "name": "oleo de Vitriolo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 235, "variants": ["oleo de Vitriolo", "Oleo de Mathiolo", "Oleo de enxofre", "OleodeVitriolo", "Oleodefarro", "Oleodeferro", "Oleodelacraos", "Oleodeouro", "Oleodepato", "Oleum Vitrioli", "Ooleo de vitriolo", "oleo de Enxofre", "oleo de Hypericaó", "oleo de Lacraes", "oleo de Loureyro", "oleo de Mathiolo", "oleo de Tartaro", "oleo de alambre", "oleo de alambre branco", "oleo de alfazema", "oleo de almecega", "oleo de arruda", "oleo de açafraõ", "oleo de cao", "oleo de castoreo", "oleo de enxofre", "oleo de farro", "oleo de ferro", "oleo de hipericam", "oleo de incenſo", "oleo de lacraes", "oleo de lacraos", "oleo de loureyro", "oleo de loſna", "oleo de murta", "oleo de murtinhos", "oleo de pao de buxo", "oleo de pao de freyxo", "oleo de pao debuxo", "oleo de rapoſa", "oleo de vitriol", "oleo de vitriolo", "oleo de zimbro", "oleo de ſarro", "oleo deElpicanardo", "oleo deMatiolo", "oleo dealcanfor", "oleo delacraos", "oleo demacela", "oleo deouro", "oleo do Vitriolo", "oleo do vitriolo", "oleode Mathiolo", "oleode Vitriolo", "oleode arruda", "oleode cão", "oleode endro", "oleode hypericaó", "oleode lacrao", "oleode macella", "oleode murtinhos", "oleode vitriolo", "oleodeAparicio", "oleodeCastoreo", "oleodeVitriolo", "oleodeaparicio", "oleodehypericão", "oleodelacraos", "oleodemurtinhos", "oleodenegrido", "oleodepato", "oleodevitriolo", "oleos de vitriolo", "oleum vitriolicam"], "contexts": ["added to water to make it sour", "oil of vitriol, an acidic substance"]}, {"entity_id": "oyl_of_vitriol", "book_id": "english_physician_1652", "name": "Oyl of Vitriol", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Oyl of Vitriol"], "contexts": ["added for tartness to juleps"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "oleo de Vitriolo", "target_book": "english_physician_1652", "target_name": "Oyl of Vitriol", "similarity": 0.883}], "id": 571, "stable_key": "clu_6942bf630c977a71", "ground_truth": {"modern_name": "Oil of Vitriol", "confidence": "high", "type": "chemical", "description": "Strong acidic liquid, sulfuric acid, used in alchemy and medicine.", "wikipedia_extract": "Sulfuric acid (American spelling and the preferred IUPAC name) or sulphuric acid (Commonwealth spelling), known in antiquity as oil of vitriol, is a mineral acid composed of the elements sulfur, oxygen, and hydrogen, with the molecular formula H2SO4. It is a colorless, odorless, and viscous liquid that is miscible with water. Pure sulfuric acid does not occur naturally due to its strong affinity to water vapor; it is hygroscopic and readily absorbs water vapor from the air. Concentrated sulfuric acid is a strong oxidant with powerful dehydrating properties, making it highly corrosive towards other materials, from rocks to metals. Phosphorus pentoxide is a notable exception in that it is not dehydrated by sulfuric acid but, to the contrary, dehydrates sulfuric acid to sulfur trioxide. Upon addition of sulfuric acid to water, a considerable amount of heat is released; thus, the reverse procedure of adding water to the acid is generally avoided since the heat released may boil the solution, spraying droplets of hot acid during the process."}}, {"canonical_name": "Cumana", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 187, "members": [{"entity_id": "cumana", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cumana", "category": "PLACE", "subcategory": "CITY", "count": 174, "variants": ["Cumana", "CUMANA", "Cumanacoa", "Cumanagoto"], "contexts": ["coasts of Cumana", "either at Cumana"]}, {"entity_id": "ville_de_cumana", "book_id": "relation_historique_humboldt_vol3_1825", "name": "ville de Cumana", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["ville de Cumana"], "contexts": ["city of Cumana"]}, {"entity_id": "cumana", "book_id": "kosmos_humboldt_1845", "name": "Cumana", "category": "PLACE", "subcategory": "CITY", "count": 12, "variants": ["Cumana"], "contexts": ["location of observed meteor showers", "location of extraordinary star fall"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cumana", "target_book": "kosmos_humboldt_1845", "target_name": "Cumana", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "ville de Cumana", "target_book": "kosmos_humboldt_1845", "target_name": "Cumana", "similarity": 0.947}], "id": 572, "stable_key": "clu_067e0f2074c730d6", "ground_truth": {"modern_name": "Cumaná", "confidence": "high", "type": "place", "country": "Venezuela", "wikidata_id": "Q319476", "wikidata_description": "capital city of Sucre, Venezuela", "wikipedia_url": "https://en.wikipedia.org/wiki/Cumaná", "wikipedia_extract": "Cumaná (Spanish pronunciation: [kumaˈna]) is the capital city of Venezuela's Sucre State. It is located 402 kilometres (250 mi) east of Caracas. Cumaná was one of the first cities founded by Spain in the mainland Americas and is the oldest continuously-inhabited Hispanic-established city in South America. Its early history includes several successful counters by the indigenous people of the area who were attempting to prevent Spanish incursion into their land, resulting in the city being refounded several times. The municipality of Sucre, which includes the capital city, Cumaná, had a population of 358,919 at the 2011 Census; the latest estimate (as of mid-2016) is 423,546. The city is located at the mouth of the Manzanares River on the Caribbean coast, in the northeast of Venezuela."}}, {"canonical_name": "earth", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 176, "members": [{"entity_id": "earth", "book_id": "connexion_physical_sciences_somerville_1858", "name": "earth", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 175, "variants": ["earth", "Earth"], "contexts": ["planet we live on", "celestial body with a meridian"]}, {"entity_id": "earth-worms", "book_id": "origin_of_species_darwin_1859", "name": "earth-worms", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["earth-worms"], "contexts": ["terrestrial hermaphroditic animals"]}], "edges": [], "id": 573, "stable_key": "clu_adf6f542a482ab07", "ground_truth": {"modern_name": "Worm (Parasite)", "confidence": "high", "type": "animal", "description": "An invertebrate, often parasitic, organism, especially intestinal parasites.", "note": "Includes literal intestinal worms and figurative uses; Darwin's usage is broad.", "wikipedia_extract": "Parasitic worms, also known as helminths, are a polyphyletic group of large macroparasites; adults can generally be seen with the naked eye. Many are intestinal worms that are soil-transmitted and infect the gastrointestinal tract. Other parasitic worms such as  schistosomes reside in blood vessels. Some parasitic worms, including leeches and monogeneans, are ectoparasites –  thus, they are not classified as helminths, which are endoparasites. Parasitic worms live in and feed in living hosts. They receive nourishment and protection while disrupting their hosts' ability to absorb nutrients."}}, {"canonical_name": "almorreymas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 146, "members": [{"entity_id": "almorreymas", "book_id": "polyanthea_medicinal", "name": "almorreymas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 139, "variants": ["almorreymas", "Almorreimas", "Almorreymas", "Almorreymas cegas", "Almorreymas doloridas", "Almorreymas inchadas", "almorrcymas", "almorreimas", "almorreimas cegas", "almorreimas interiores", "almorrey", "almorrey. mas", "almorreymas cancrofas", "almorreymas cegas", "almorreymas ceſegredos", "almorreymas interiores", "almorteymas", "asalmorreimas cegas"], "contexts": ["condition treated by remedy", "hemorrhoids"]}, {"entity_id": "almorranas", "book_id": "historia_medicinal_monardes_1574", "name": "almorranas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 7, "variants": ["almorranas"], "contexts": ["hemorrhoids", "condition of hemorrhoids"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "almorreymas", "target_book": "historia_medicinal_monardes_1574", "target_name": "almorranas", "similarity": 0.908}], "id": 574, "stable_key": "clu_b78402cb687b1bcf", "ground_truth": {"modern_name": "hemorrhoids", "confidence": "high", "type": "disease", "description": "Swollen veins in the anus or rectum, often painful.", "wikipedia_extract": "Hemorrhoids (or haemorrhoids), also known as piles, are vascular structures in the anal canal. In their normal state, they are cushions that help with stool control. They become a disease when swollen or inflamed; the unqualified term hemorrhoid is often used to refer to the disease. The signs and symptoms of hemorrhoids depend on the type present. Internal hemorrhoids often result in painless, bright red rectal bleeding when defecating. External hemorrhoids often result in pain and swelling in the area of the anus."}}, {"canonical_name": "Venezuela", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 144, "members": [{"entity_id": "venezuela", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Venezuela", "category": "PLACE", "subcategory": "COUNTRY", "count": 141, "variants": ["Venezuela", "VENEZUELA", "VENEZtELA", "Venczuela", "Vene- zuela", "Veneziuela", "Venezuala", "le Venezuela"], "contexts": ["eastern plains of Venezuela", "steppes of Venezuela"]}, {"entity_id": "venezuela", "book_id": "kosmos_humboldt_1845", "name": "Venezuela", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Venezuela"], "contexts": ["South American country", "country with littoral chain"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Venezuela", "target_book": "kosmos_humboldt_1845", "target_name": "Venezuela", "similarity": 1.0}], "id": 575, "stable_key": "clu_b7528bce5729afd9", "ground_truth": {"modern_name": "Venezuela", "confidence": "high", "type": "place", "country": "Venezuela", "wikidata_id": "Q717", "wikidata_description": "country in South America", "wikipedia_extract": "On 3 January 2026, the United States launched a military strike in Venezuela and captured incumbent Venezuelan president Nicolás Maduro and his wife, Cilia Flores. The US operation, codenamed Operation Absolute Resolve, began around 2 a.m. local time, when explosions were observed. The US Armed Forces bombed infrastructure across northern Venezuela to suppress air defenses as an apprehension force attacked Maduro's compound in Caracas. Maduro and Flores were transported to New York City by US forces to face their trial there. The US federal government announced that Maduro and Flores had been indicted on several charges related to narcoterrorism.", "wikipedia_url": "https://en.wikipedia.org/wiki/Venezuela"}}, {"canonical_name": "Caracas", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 136, "members": [{"entity_id": "caracas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Caracas", "category": "PLACE", "subcategory": "CITY", "count": 131, "variants": ["Caracas", "Carache", "Carachi"], "contexts": ["city with steppes", "city mentioned with primitive mountains"]}, {"entity_id": "caraccas", "book_id": "kosmos_humboldt_1845", "name": "Caraccas", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Caraccas"], "contexts": ["city destroyed by earthquake", "location with granite ledges"]}, {"entity_id": "caracas", "book_id": "kosmos_humboldt_1845", "name": "Caracas", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Caracas"], "contexts": ["location where loud noise was heard"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Caracas", "target_book": "kosmos_humboldt_1845", "target_name": "Caraccas", "similarity": 0.96}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Caracas", "target_book": "kosmos_humboldt_1845", "target_name": "Caracas", "similarity": 1.0}], "id": 576, "stable_key": "clu_5d62f66e6b9e38c4", "ground_truth": {"modern_name": "Caracas", "confidence": "high", "type": "place", "country": "Venezuela", "wikidata_id": "Q1533", "wikidata_description": "capital and largest city of Venezuela", "wikipedia_url": "https://en.wikipedia.org/wiki/Caracas"}}, {"canonical_name": "Parleſia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 135, "members": [{"entity_id": "parleſia", "book_id": "polyanthea_medicinal", "name": "Parleſia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 133, "variants": ["Parleſia", "Parle", "Parlefia", "Parlefiada", "Parlesia", "Parleſia daboca", "Parleſia do Sefſo", "Parleſia do feffo", "Parleſia do ſeſſo", "Parleſiada boca", "Parleſiadoroſto", "Parleſias", "Patlefias", "parlefia", "parlesia", "parleſia", "parleſia bastarda", "parleſia infieri", "parleſias", "parlidas"], "contexts": ["Condition of paralysis", "affects nerves, a type of paralysis"]}, {"entity_id": "parlesia", "book_id": "coloquios_da_orta_1563", "name": "parlesia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["parlesia"], "contexts": ["paralysis affecting the body"]}, {"entity_id": "parleſia_legitima", "book_id": "polyanthea_medicinal", "name": "parleſia legitima", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["parleſia legitima"], "contexts": ["true paralysis"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Parleſia", "target_book": "coloquios_da_orta_1563", "target_name": "parlesia", "similarity": 0.898}, {"source_book": "coloquios_da_orta_1563", "source_name": "parlesia", "target_book": "polyanthea_medicinal", "target_name": "parleſia legitima", "similarity": 0.823}], "id": 577, "stable_key": "clu_4cce6ae4d31676ad", "ground_truth": {"modern_name": "paralysis", "confidence": "high", "type": "disease", "description": "Loss of muscle function in one or more parts of the body.", "wikipedia_extract": "Paralysis (pl.: paralyses; also known as plegia) is a loss of motor function in one or more muscles. Paralysis can also be accompanied by a loss of feeling (sensory loss) in the affected area if there is sensory damage. In the United States, roughly 1 in 50 people have been diagnosed with some form of permanent or transient paralysis. The word \"paralysis\" derives from the Greek παράλυσις, meaning \"disabling of the nerves\" from παρά (para) meaning \"beside, by\" and λύσις (lysis) meaning \"making loose\". A paralysis accompanied by involuntary tremors is usually called \"palsy\". Paralysis is most often caused by damage in the nervous system, especially the spinal cord."}}, {"canonical_name": "moon", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 119, "members": [{"entity_id": "moon", "book_id": "connexion_physical_sciences_somerville_1858", "name": "moon", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 114, "variants": ["Moon", "moon"], "contexts": ["natural satellite of Earth", "Earth's natural satellite"]}, {"entity_id": "moon", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Moon", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["Moon"], "contexts": ["Stars lesser than the Moon", "celestial body, one of the great lights"]}, {"entity_id": "moons", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Moons", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Moons"], "contexts": ["celestial bodies"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "moon", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Moon", "similarity": 0.985}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "moon", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Moons", "similarity": 0.948}], "id": 578, "stable_key": "clu_931c912d833babea", "ground_truth": {"modern_name": "Moon", "confidence": "high", "type": "concept", "note": "Although 'moon' can refer to a celestial body, in this scientific context, it refers to Earth's Moon, a concept in astronomy and physical sciences."}}, {"canonical_name": "convulfoens", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 116, "members": [{"entity_id": "convulfoens", "book_id": "polyanthea_medicinal", "name": "convulfoens", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 114, "variants": ["convulfoens", "Conves", "Convul", "Convulf.", "Convulfai", "Convulfao", "Convulfaó", "Convulfaõ", "Convulfaō", "Convulfio", "Convulfione", "Convulfoens", "Convulfoes", "Convulfoés", "Convulsaao", "Convulsai", "Convulsao", "Convulsaō", "Convulsione", "Convulsoens", "Convulsões", "Convulíao", "Convulſao", "Convulſaó", "convulfam", "convulfao", "convulfaó", "convulfio", "convulfiofit", "convulfionem", "convulfionibus", "convulfivos", "convulfo", "convulfoens dos nervos", "convulfoes", "convulfoés", "convulfus", "convulfão", "convulloés tetanicas", "convulortu", "convulsa", "convulsao", "convulsaó", "convulsio", "convulsio lethalis", "convulsivo", "convulsoens", "convulsoes", "convulsos", "convulsão", "convulsões", "convulſao", "convulſoens Tetanicas", "convulſoés", "de convulortu", "motus convulfivos"], "contexts": ["convulsions", "medical condition treated with sudorifics"]}, {"entity_id": "convulsers", "book_id": "english_physician_1652", "name": "Convulsers", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["Convulsers", "Con∣vulsion"], "contexts": ["causing convulsions", "condition helped by powder in wine"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "convulfoens", "target_book": "english_physician_1652", "target_name": "Convulsers", "similarity": 0.908}], "id": 579, "stable_key": "clu_57c39c8354c3de1b", "ground_truth": {"modern_name": "convulsions", "confidence": "high", "type": "disease", "description": "A medical condition characterized by sudden, involuntary muscle contractions.", "wikipedia_extract": "A convulsion is a medical condition where the body muscles contract and relax rapidly and repeatedly, resulting in uncontrolled shaking. Because epileptic seizures typically include convulsions, the term convulsion is often used as a synonym for seizure. However, not all epileptic seizures result in convulsions, and not all convulsions are caused by epileptic seizures. Non-epileptic convulsions have no relation with epilepsy, and are caused by non-epileptic seizures. Convulsions can be caused by epilepsy, infections (including a severe form of listeriosis which is caused by eating food contaminated by Listeria monocytogenes), brain trauma, or other medical conditions. They can also occur from an electric shock or improperly enriched air for scuba diving."}}, {"canonical_name": "caldo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 113, "members": [{"entity_id": "caldo", "book_id": "polyanthea_medicinal", "name": "caldo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 106, "variants": ["caldo", "calda", "caldade", "caldo de frangao", "caldo de frangaó", "caldo de frangaõ", "caldo de frangaō", "caldo de frangão", "caldo de gallinha", "caldo de gallo velho", "caldo degallinha", "caldode frangao", "caldode frangaó", "caldode frangão", "caldode gallinha", "caldodefranga", "caldodegallinha", "caldos", "caldos de Aveya", "caldos de cevada", "caldos de cágados", "caldos de gallinha", "caldos de goma", "caldos deaguados farelos", "caldos degoma", "caldosgordos"], "contexts": ["simple broth used as medicine", "broth given to facilitate purging"]}, {"entity_id": "caldo", "book_id": "historia_medicinal_monardes_1574", "name": "caldo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["caldo", "caldo de ave"], "contexts": ["broth, a liquid preparation", "broth"]}, {"entity_id": "caldode_farinha", "book_id": "polyanthea_medicinal", "name": "caldode farinha", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["caldode farinha"], "contexts": ["flour-like substance in urine"]}, {"entity_id": "carnes_caldos", "book_id": "polyanthea_medicinal", "name": "carnes caldos", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["carnes caldos"], "contexts": ["flesh broths"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "caldo", "target_book": "historia_medicinal_monardes_1574", "target_name": "caldo", "similarity": 0.818}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "caldo", "target_book": "polyanthea_medicinal", "target_name": "caldode farinha", "similarity": 0.842}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "caldo", "target_book": "polyanthea_medicinal", "target_name": "carnes caldos", "similarity": 0.877}], "id": 580, "stable_key": "clu_05e4d1870a5e13f8", "ground_truth": {"modern_name": "broth", "confidence": "high", "type": "substance", "description": "A simple liquid preparation, often used as medicine or as a base.", "wikipedia_extract": "Broth, also known as bouillon (French pronunciation: [bujɔ̃] ), is a savory liquid made of water in which meat, fish, or vegetables have been simmered for a period of time. It can be eaten alone, but it is most commonly used to prepare other dishes, such as soups, gravies, and sauces. Commercially prepared liquid broths are available, typically chicken, beef, fish, and vegetable varieties. Dehydrated broth in the form of bouillon cubes was commercialized beginning in the early 20th century. Many cooks and food writers use the terms broth and stock interchangeably. In 1974, James Beard (an American cook) wrote that stock, broth, and bouillon \"are all the same thing\"."}}, {"canonical_name": "Xaropes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 112, "members": [{"entity_id": "xaropes", "book_id": "polyanthea_medicinal", "name": "Xaropes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 101, "variants": ["Xaropes", "Oxarope", "Xarope", "Xarope Rey", "Xaropes purgativos", "xarope", "xarope Persico", "xarope Rey", "xarope de Rey", "xarope de romás", "xarope de roſas", "xarope rofado", "xarope rolado", "xarope roſado", "xaropePerfico", "xaropePersico", "xaropeRey", "xaropeRoſado", "xaropedas", "xaropede rofas", "xaropede ſorvas", "xaropes", "xaropes apropriados", "xaropes magiſtraes", "xaropes purgativos"], "contexts": ["syrups, a type of medicine", "medicinal preparation"]}, {"entity_id": "xarope", "book_id": "coloquios_da_orta_1563", "name": "xarope", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 11, "variants": ["xarope", "xarope acetoso", "xarope grosso", "xarope violado", "xaropes", "xaropes solutivos"], "contexts": ["Product made from jujubas", "Spanish word derived from Arabic"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Xaropes", "target_book": "coloquios_da_orta_1563", "target_name": "xarope", "similarity": 0.958}], "id": 581, "stable_key": "clu_777ffafdcf95e344", "ground_truth": {"modern_name": "syrup", "confidence": "high", "type": "substance", "description": "A sweet, viscous medicinal preparation, often made from fruit or herbs.", "wikipedia_extract": "In cooking, syrup (less commonly sirup; from Latin: sirupus, from earlier Arabic: شراب; sharāb, beverage, wine) is a thick, viscous, liquid condiment consisting primarily of a solution of sugar in water. It typically contains a large amount of dissolved sugars but shows little tendency to deposit crystals. In its concentrated form, its consistency is similar to that of molasses. The viscosity arises from the multiple hydrogen bonds between the dissolved sugar, which has many hydroxyl (OH) groups. There are a range of syrups used in food production, including: Golden syrup, a by-product of refining crystallized sugar High fructose corn syrup, widely used in the US A variety of beverages call for sweetening to offset the tartness of some juices used in the drink recipes. Granulated sugar does not dissolve easily in cold drinks or ethyl alcohol."}}, {"canonical_name": "pedra", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 107, "members": [{"entity_id": "pedra", "book_id": "polyanthea_medicinal", "name": "pedra", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 105, "variants": ["pedra", "Pedra", "PedraNephritica", "achaquesde pedra", "pedra dabexiga", "pedra no bofe", "pedrada bexiga", "pedradabexiga", "pedradosrins", "pedras dos rins", "pedras na bexiga"], "contexts": ["calculus or stone in the body", "stone found in a man's head"]}, {"entity_id": "pedra_da_bixigua", "book_id": "coloquios_da_orta_1563", "name": "pedra da bixigua", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["pedra da bixigua", "pedra da bexiga"], "contexts": ["gallstone or kidney stone", "bladder stones"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "pedra", "target_book": "coloquios_da_orta_1563", "target_name": "pedra da bixigua", "similarity": 0.896}], "id": 582, "stable_key": "clu_b48b80a7fe0fd8c9", "ground_truth": {"modern_name": "calculus", "confidence": "high", "type": "disease", "description": "A hard deposit, such as a kidney stone or gallstone.", "wikipedia_extract": "Calculus is the mathematical study of continuous change, in the same way that geometry is the study of shape and algebra is the study of generalizations of arithmetic operations. Originally called infinitesimal calculus or the calculus of infinitesimals, it has two major branches, differential calculus and integral calculus. Differential calculus analyses instantaneous rates of change and the slopes of curves; integral  calculus analyses accumulation of quantities and areas under or between curves. These two branches are related to each other by the fundamental theorem of calculus. Calculus uses convergence of infinite sequences and infinite series to a well-defined mathematical limit. Calculus is the \"mathematical backbone\" for solving problems in which variable quantities change with time or another reference value."}}, {"canonical_name": "Ceylão", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 100, "members": [{"entity_id": "ceylão", "book_id": "coloquios_da_orta_1563", "name": "Ceylão", "category": "PLACE", "subcategory": "COUNTRY", "count": 97, "variants": ["Ceylão", "Ceilam", "Ceilão", "CeylSo", "Ceylao", "Ceylon", "Ceyláo"], "contexts": ["island nation", "island nation (Sri Lanka)"]}, {"entity_id": "ceylan", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Ceylan", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Ceylan", "Ceylon"], "contexts": ["island included in total", "island with average air temperature data"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Ceylão", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Ceylan", "similarity": 0.881}], "id": 583, "stable_key": "clu_12728a3f0df10827", "ground_truth": {"modern_name": "Sri Lanka", "confidence": "high", "type": "place", "description": "Island nation in South Asia, formerly known as Ceylon.", "wikipedia_extract": "Sri Lanka, officially the Democratic Socialist Republic of Sri Lanka, formerly known as Ceylon, is an island country in South Asia. It is located in the Indian Ocean, southwest of the Bay of Bengal, and is separated from India by the Gulf of Mannar and the Palk Strait. Sri Lanka shares a maritime border with the Maldives to the southwest and India to the northwest, and lies across the Bay of Bengal from Bangladesh and Myanmar to the northeast and the Andaman and Nicobar Islands of India to the east. Its capital is Sri Jayawardenepura Kotte, while Colombo is its largest city and the political, financial and cultural centre. Sri Lanka's population is 22 million; with the Sinhalese people, who speak the Sinhala language, forming the vast majority—while Tamil is spoken by the large Tamil minority. Other long-established ethnic groups include the Moors, Indian Tamils, Burghers, Malays, Chinese, and Vedda."}}, {"canonical_name": "cravo", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 94, "members": [{"entity_id": "cravo", "book_id": "polyanthea_medicinal", "name": "cravo", "category": "PLANT", "subcategory": "PLANT", "count": 49, "variants": ["cravo", "Cravo", "cravo Romano", "cravo da India", "cravoda India", "cravos", "cravos da India", "cravos de arrochela", "cravosda India"], "contexts": ["powder used in stuffing", "clove, ingredient in a remedy"]}, {"entity_id": "cravo", "book_id": "coloquios_da_orta_1563", "name": "cravo", "category": "PLANT", "subcategory": "PLANT", "count": 45, "variants": ["cravo", "Cravo", "cravo propriamente dito", "cravos", "cravos verdes"], "contexts": ["spice added to bangue", "spice with a sharp taste"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "cravo", "target_book": "coloquios_da_orta_1563", "target_name": "cravo", "similarity": 1.0}], "id": 584, "stable_key": "clu_733b279f31cd36f8", "ground_truth": {"modern_name": "Clove", "confidence": "high", "type": "plant", "linnaean": "Syzygium aromaticum", "family": "Myrtaceae", "description": "Aromatic spice derived from the dried flower buds of a tree.", "wikipedia_extract": "Cloves are the aromatic flower buds of a tree in the family Myrtaceae, Syzygium aromaticum (). They are native to the Maluku Islands, or Moluccas, in Indonesia, and are commonly used as a spice, flavoring, or fragrance in consumer products, such as toothpaste, soaps, or cosmetics. Cloves are available throughout the year owing to different harvest seasons across various countries. The word clove, first used in English in the 15th century, derives via Middle English clow of gilofer, Anglo-French clowes de gilofre and Old French clou de girofle, from the Latin word clavus \"nail\". The related English word gillyflower, originally meaning \"clove\", derives via said Old French girofle and Latin caryophyllon, from the Greek karyophyllon \"clove\", literally \"nut leaf\". The clove tree is an evergreen that grows up to 8–12 metres (26–39 ft) tall, with large leaves and crimson flowers grouped in terminal clusters."}}, {"canonical_name": "Arábia", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 93, "members": [{"entity_id": "arábia", "book_id": "coloquios_da_orta_1563", "name": "Arábia", "category": "PLACE", "subcategory": "REGION", "count": 92, "variants": ["Arábia", "Arabia", "Arabie", "Arábia meridional", "da Arábia"], "contexts": ["region near the strait", "region mentioned by authorities"]}, {"entity_id": "arabía", "book_id": "historia_medicinal_monardes_1574", "name": "Arabía", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Arabía"], "contexts": ["region mentioned for medicines"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Arábia", "target_book": "historia_medicinal_monardes_1574", "target_name": "Arabía", "similarity": 0.843}], "id": 585, "stable_key": "clu_aa72235d733a6199", "ground_truth": {"modern_name": "Arabia", "confidence": "high", "type": "place", "description": "Peninsula in Southwest Asia, historically significant for trade and culture.", "wikipedia_extract": "The Arabian Peninsula (Arabic: شبه الجزيرة العربية, romanized: shibh al-jazīra al-ʿarabiyya, or جزيرة العرب, jazīrat al-ʿarab, 'the Island of Arabs'), or simply Arabia, is a peninsula in West Asia, situated north-east of Africa on the Arabian plate. At 3,237,500 km2 (1.25 million mi2), comparable in size to India, the Arabian Peninsula is the largest peninsula in the world. Geographically, the Arabian Peninsula comprises Bahrain, Kuwait, Oman, Qatar, Saudi Arabia, the United Arab Emirates (UAE) and Yemen, as well as southern Iraq and Jordan. The largest of these is Saudi Arabia. In ancient antiquity, particularly from the 9th century BC to the 7th century AD, the Sinai Peninsula was also considered a part of Arabia. The Arabian Peninsula formed as a result of the rifting of the Red Sea between 56 and 23 million years ago, and is bordered by the Red Sea to the west and south-west, the Persian Gulf and the Gulf of Oman to the north-east, the Levant and Mesopotamia to the north and the Arabian Sea and the Indian Ocean to the south-east."}}, {"canonical_name": "Zucchero", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 92, "members": [{"entity_id": "zucchero", "book_id": "ricettario_fiorentino_1597", "name": "Zucchero", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 88, "variants": ["Zucchero", "Zuccberq bianco", "Zucchera candì", "Zucchero Candì", "Zucchero Rosato", "Zucchero Violato", "Zucchero b anco", "Zucchero biacco", "Zucchero bianco", "Zucchero bijinco", "Zucchero buono", "Zucchero chiarito", "Zucchero fine", "Zucchero fine pol-", "Zucchero violato", "Zuccho", "zuc- chero", "zucchero", "zucchero bianco", "zucchero candi", "zucchero chianro", "zucchero chiarito", "zucchero fine", "zucchero fino", "zuccherocandi", "zuccìoero"], "contexts": ["sugar, used for preservation", "ingredient in sweetened alum"]}, {"entity_id": "azucar", "book_id": "historia_medicinal_monardes_1574", "name": "Azucar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["Azucar", "azucar", "azucar rosado"], "contexts": ["sugar used to make syrup", "sweetener"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Zucchero", "target_book": "historia_medicinal_monardes_1574", "target_name": "Azucar", "similarity": 0.921}], "id": 586, "stable_key": "clu_cabc34d122a61150", "ground_truth": {"modern_name": "Sugar", "confidence": "high", "type": "substance", "description": "Sweet crystalline substance derived from plants, used as a sweetener.", "note": "Refers to the substance itself, distinct from the plant.", "wikipedia_extract": "Sugar () is a class of sweet-tasting, soluble carbohydrates, many of which are used in food. Simple sugars, also called monosaccharides, include glucose, fructose, and galactose. Compound sugars, also called disaccharides or double sugars, are molecules made of two bonded monosaccharides; common examples are sucrose (glucose + fructose), lactose (glucose + galactose), and maltose (two molecules of glucose). White sugar is almost pure sucrose. During digestion, compound sugars are hydrolysed into simple sugars. Longer chains of saccharides are not regarded as sugars, and are called oligosaccharides or polysaccharides."}}, {"canonical_name": "Bogota", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 92, "members": [{"entity_id": "bogota", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bogota", "category": "PLACE", "subcategory": "CITY", "count": 45, "variants": ["Bogota", "BOGOTA"], "contexts": ["city with population 172,000", "origin of flours"]}, {"entity_id": "santa-fe_de_bogota", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Santa-Fe de Bogota", "category": "PLACE", "subcategory": "CITY", "count": 42, "variants": ["Santa-Fe de Bogota", "S. Fe de Bogota", "SaNTA-Fe DE BoGOTA", "Sanla-Fe de Bogoià", "Sanla-Fe de Bogota", "Santa Fe de Bogota", "Santa Fé de Bogota", "Santa-Fede Bogota", "Santa-Fé de Bogota"], "contexts": ["city in Colombia", "city and capital of Nouvelle-Grenade"]}, {"entity_id": "bogota", "book_id": "kosmos_humboldt_1845", "name": "Bogota", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Bogota"], "contexts": ["location of subterranean thunder", "city in Colombia"]}, {"entity_id": "santa_fe_de_bogota", "book_id": "kosmos_humboldt_1845", "name": "Santa Fe de Bogota", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Santa Fe de Bogota"], "contexts": ["location with specific altitude and temperature", "location with specific latitude and altitude"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bogota", "target_book": "kosmos_humboldt_1845", "target_name": "Bogota", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bogota", "target_book": "kosmos_humboldt_1845", "target_name": "Santa Fe de Bogota", "similarity": 0.845}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Santa-Fe de Bogota", "target_book": "kosmos_humboldt_1845", "target_name": "Santa Fe de Bogota", "similarity": 0.987}], "id": 587, "stable_key": "clu_c0ac942d4f7d5ea7", "ground_truth": {"modern_name": "Bogotá", "confidence": "high", "type": "place", "country": "Colombia", "wikidata_id": "Q10432089", "wikidata_description": "genus of insects", "wikipedia_extract": "Colombia, officially the Republic of Colombia, is a country primarily located in South America with insular regions in North America. The Colombian mainland is bordered by the Caribbean Sea to the north, Venezuela to the east and northeast, Brazil to the southeast, Peru and Ecuador to the south and southwest, the Pacific Ocean to the west, and Panama to the northwest. Colombia is divided into 32 departments. The Capital District of Bogotá is also the country's largest city hosting the main financial and cultural hub. Other major urban areas include Medellín, Cali, Barranquilla, Cartagena, Bucaramanga, Pereira, Santa Marta, Cúcuta, Ibagué, Villavicencio and Manizales. It covers an area of 1,141,748 square kilometers (440,831 sq mi) and has a population of around 52 million.", "wikipedia_url": "https://en.wikipedia.org/wiki/Colombia"}}, {"canonical_name": "Psychology", "category": "ORGANIZATION", "subcategory": "JOURNAL", "book_count": 2, "total_mentions": 92, "members": [{"entity_id": "psychology", "book_id": "principles_of_psychology_james_1890", "name": "Psychology", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 84, "variants": ["psychology", "PSYCHOLOGY", "Psychology"], "contexts": ["subject of the book", "science of finite individual minds"]}, {"entity_id": "principles_of_psychology", "book_id": "principles_of_psychology_james_1890", "name": "Principles of Psychology", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 4, "variants": ["Principles of Psychology"], "contexts": ["book title", "work on psychological principles"]}, {"entity_id": "principles_of_psychology", "book_id": "first_principles_spencer_1862", "name": "Principles of Psychology", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 4, "variants": ["Principles of Psychology"], "contexts": ["book title", "writer's work on psychology"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Psychology", "target_book": "first_principles_spencer_1862", "target_name": "Principles of Psychology", "similarity": 0.848}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Principles of Psychology", "target_book": "first_principles_spencer_1862", "target_name": "Principles of Psychology", "similarity": 1.0}], "id": 588, "stable_key": "clu_692ce142510ce3f8", "ground_truth": {"modern_name": "Psychology", "confidence": "high", "type": "concept", "note": "While the cluster mentions book titles, the core concept being discussed is the field of Psychology itself, as indicated by the context 'subject of the book' and the prominent title 'Principles of Psychology'.", "wikidata_id": "Q7256412", "wikidata_description": "American magazine and media organization", "wikipedia_extract": "Psychology is the scientific study of the mind and behavior. Its subject matter includes the behavior of humans and nonhumans, both conscious and unconscious phenomena, and mental processes such as thoughts, feelings, and motives. Psychology is an academic discipline of immense scope, crossing the boundaries between the natural and social sciences. Biological psychologists seek an understanding of the emergent properties of brains, linking the discipline to neuroscience. As social scientists, psychologists aim to understand the behavior of individuals and groups. A professional practitioner or researcher involved in the discipline is called a psychologist.", "wikipedia_url": "https://en.wikipedia.org/wiki/Psychology"}}, {"canonical_name": "Pharmacographia", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 92, "members": [{"entity_id": "pharmacographia", "book_id": "coloquios_da_orta_1563", "name": "Pharmacographia", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 62, "variants": ["Pharmacographia", "Pharm. of índia", "PharmaCj", "PharmaCy", "Pharmac", "Pharmac,", "Pharmac.", "Pharmac. of índia", "Pharmac^", "Pharmacopaeia of Índia", "Pharmacopana 0/ índia", "Pharmacopceia of Jndia", "Pharmacopceia of índias", "Pharmacopecia of Índia", "Pharmacopoeia oj Índia", "Pharmacopéa da índia", "Pharmacopêa da Índia", "Pharmacopêa portuguesa", "Pharmacopêas", "Pharmacy", "Pharmapceia da India", "Pharmocographia", "Phàrmaç. of Índia"], "contexts": ["source on drug varieties", "a book consulted for information"]}, {"entity_id": "pharmacopoea", "book_id": "polyanthea_medicinal", "name": "Pharmacopoea", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 30, "variants": ["Pharmacopoea", "Pharma", "Pharmac.", "Pharmac. Reg.", "Pharmacop.", "Pharmacop. Auguft.", "Pharmacop. Regia", "Pharmacop. Spagyr.", "Pharmacop.Reg.", "Pharmacop: Mes", "Pharmacopca", "Pharmacopea Auguſtana", "Pharmacopoea Chymica", "Pharmacopoea Medica", "Pharmacopoea Medica-Chymica", "Pharmacopoeia", "Pharmacopoez", "Pharmacopoeær"], "contexts": ["book of medicines", "medical text"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Pharmacographia", "target_book": "polyanthea_medicinal", "target_name": "Pharmacopoea", "similarity": 0.878}], "id": 589, "stable_key": "clu_b58fbb78a8e716a2", "ground_truth": {"modern_name": "Pharmacopoeia", "confidence": "high", "type": "object", "description": "An official publication containing a list of medicinal drugs and their preparation.", "note": "Historical texts related to pharmacy and medicinal recipes.", "wikipedia_extract": "A pharmacopoeia, pharmacopeia, or pharmacopoea (or the typographically obsolete rendering, pharmacopœia), meaning \"drug-making\", in its modern technical sense, is a reference work containing directions for the identification of compound medicines. These are published or sanctioned by a government or a medical or pharmaceutical society, giving the work legal authority within a specified jurisdiction. In a broader sense it is a collection of pharmaceutical drug specifications. Descriptions of the individual preparations are called monographs. There are national, supranational, and international pharmacopoeias. The term derives from Ancient Greek: φαρμακοποιία, romanized: pharmakopoiia \"making of (healing) medicine, drug-making\", a compound of \"medicine, drug, poison\" (Ancient Greek: φάρμακον, romanized: pharmakon), with the verb \"to make\" (Ancient Greek: ποιεῖν, romanized: poiein), and the abstract noun suffix -ία -ia."}}, {"canonical_name": "Ictericia", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 90, "members": [{"entity_id": "ictericia", "book_id": "polyanthea_medicinal", "name": "Ictericia", "category": "DISEASE", "subcategory": "CHRONIC", "count": 87, "variants": ["Ictericia", "Icteri", "Ictericas", "Ictericia livida", "Ictericia negra", "Ictericianegra", "Ictericias", "Ictericiatam", "Ictericiatrienal", "Ictericos", "Verum Ictericia", "ictericia", "ictericias"], "contexts": ["jaundice", "jaundice treated by antimony"]}, {"entity_id": "ictericia", "book_id": "historia_medicinal_monardes_1574", "name": "ictericia", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["ictericia", "icterico"], "contexts": ["jaundice", "condition of yellowing skin"]}, {"entity_id": "ictericia_rebelde", "book_id": "polyanthea_medicinal", "name": "ictericia rebelde", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["ictericia rebelde"], "contexts": ["stubborn jaundice"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Ictericia", "target_book": "historia_medicinal_monardes_1574", "target_name": "ictericia", "similarity": 0.881}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "ictericia", "target_book": "polyanthea_medicinal", "target_name": "ictericia rebelde", "similarity": 0.854}], "id": 590, "stable_key": "clu_e7a2f306e2b3d006", "ground_truth": {"modern_name": "Jaundice", "confidence": "high", "type": "disease", "description": "Yellowing of the skin and whites of the eyes due to liver problems.", "wikipedia_extract": "Jaundice, also known as icterus, is a yellowish or, less frequently, greenish pigmentation of the skin and sclera due to high bilirubin levels. Jaundice in adults typically indicates the presence of underlying diseases involving abnormal heme metabolism, liver dysfunction, or biliary-tract obstruction. The prevalence of jaundice in adults is rare, while jaundice in babies is common, with an estimated 80% affected during their first week of life. The most commonly associated symptoms of jaundice are itchiness, pale feces, and dark urine. Normal levels of bilirubin in blood are below 1.0 mg/dl (17 μmol/L), while levels over 2–3 mg/dl (34–51 μmol/L) typically result in jaundice. High blood bilirubin is divided into two types: unconjugated and conjugated bilirubin."}}, {"canonical_name": "Liver", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 89, "members": [{"entity_id": "liver", "book_id": "english_physician_1652", "name": "Liver", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 87, "variants": ["Liver"], "contexts": ["organ involved in digestion and detoxification", "organ that is cleansed and helped"]}, {"entity_id": "liver", "book_id": "polyanthea_medicinal", "name": "Liver", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Liver", "liver"], "contexts": ["organ of the body", "an organ of the body"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Liver", "target_book": "polyanthea_medicinal", "target_name": "Liver", "similarity": 1.0}], "id": 591, "stable_key": "clu_8c3aeff51a8005ae", "ground_truth": {"modern_name": "Liver", "confidence": "high", "type": "anatomy", "description": "Large organ in the abdomen involved in detoxification and metabolism.", "wikipedia_extract": "The liver is a major metabolic organ exclusively found in vertebrates, which performs many essential biological functions such as detoxification of the organism, and the synthesis of various proteins and various other biochemicals necessary for digestion and growth. In humans, it is located in the right upper quadrant of the abdomen, below the diaphragm and mostly shielded by the lower right rib cage. Its other metabolic roles include carbohydrate metabolism, the production of a number of hormones, conversion and storage of nutrients such as glucose and glycogen, and the decomposition of red blood cells. Anatomical and medical terminology often use the prefix hepat- from ἡπατο-, from the Greek word for liver, such as hepatology, and hepatitis. The liver is also an accessory digestive organ that produces bile, an alkaline fluid containing cholesterol and bile acids,  which emulsifies and aids the breakdown of dietary fat. The gallbladder, a small hollow pouch that sits just under the right lobe of liver, stores and concentrates the bile produced by the liver, which is later excreted to the duodenum to help with digestion."}}, {"canonical_name": "Gallinha", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 83, "members": [{"entity_id": "gallinha", "book_id": "polyanthea_medicinal", "name": "Gallinha", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 73, "variants": ["Gallinha", "Gallinarum", "Gallo", "galinha", "gall", "gallina", "gallinha", "gallinha negra", "gallinhanegra", "gallinhapi", "gallinhas", "gallinhas gordas", "gallinka", "gallo", "gallovetho"], "contexts": ["hen", "chicken broth used as a vehicle"]}, {"entity_id": "galinha", "book_id": "coloquios_da_orta_1563", "name": "galinha", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 10, "variants": ["galinha", "galinha de mato", "galinhas"], "contexts": ["chicken, used for broth", "chicken, a food item"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Gallinha", "target_book": "coloquios_da_orta_1563", "target_name": "galinha", "similarity": 0.931}], "id": 592, "stable_key": "clu_e9276f7f10957583", "ground_truth": {"modern_name": "Chicken", "confidence": "high", "type": "animal", "linnaean": "Gallus gallus domesticus", "family": "Phasianidae", "description": "Common domestic fowl, source of meat and broth.", "wikipedia_extract": "The chicken (Gallus gallus domesticus) is a domesticated form of the red junglefowl (Gallus gallus), originally native to Southeast Asia. It was first domesticated around 8,000 years ago and is one of the most common and widespread domesticated animals in the world. Chickens are primarily kept for their meat and eggs, though they are also kept as pets. As of 2023, the global chicken population exceeds 26.5 billion, with more than 50 billion birds produced annually for consumption. Specialized breeds such as broilers and laying hens have been developed for meat and egg production, respectively. A hen bred for laying can produce over 300 eggs per year."}}, {"canonical_name": "panela de barro", "category": "OBJECT", "subcategory": "VESSEL", "book_count": 2, "total_mentions": 82, "members": [{"entity_id": "panela_de_barro", "book_id": "polyanthea_medicinal", "name": "panela de barro", "category": "OBJECT", "subcategory": "VESSEL", "count": 80, "variants": ["panela de barro", "garrafa de vidro", "panela", "panela de barronova", "panela debarro", "panela nova", "panela vidrada", "panelade barro", "paneladebarro", "tigela de fogo", "tigelas de estanho", "vaso de barro", "vaso de vidro", "vaſo de barro", "vaſo de vidro", "vaſo debarro", "vaſode barro"], "contexts": ["used for cooking ingredients", "earthenware pot for cooking"]}, {"entity_id": "panellas", "book_id": "coloquios_da_orta_1563", "name": "panellas", "category": "OBJECT", "subcategory": "VESSEL", "count": 1, "variants": ["panellas"], "contexts": ["containers for storing substances"]}, {"entity_id": "vasilha_de_barro", "book_id": "coloquios_da_orta_1563", "name": "vasilha de barro", "category": "OBJECT", "subcategory": "VESSEL", "count": 1, "variants": ["vasilha de barro"], "contexts": ["used to heat negundo leaves"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "panela de barro", "target_book": "coloquios_da_orta_1563", "target_name": "panellas", "similarity": 0.883}, {"source_book": "polyanthea_medicinal", "source_name": "panela de barro", "target_book": "coloquios_da_orta_1563", "target_name": "vasilha de barro", "similarity": 0.897}], "id": 593, "stable_key": "clu_17c63694669bf1ab", "ground_truth": {"modern_name": "Earthenware pot", "confidence": "high", "type": "object", "description": "Pottery vessel used for cooking, storage, and heating substances.", "note": "Includes 'panela de barro', 'panellas', and 'vasilha de barro'.", "wikipedia_extract": "Earthenware is glazed or unglazed nonvitreous pottery that has normally been fired below 1,200 °C (2,190 °F). Basic earthenware, often called terracotta, absorbs liquids such as water. However, earthenware can be made impervious to liquids by coating it with a ceramic glaze, and such a process is used for the great majority of modern domestic earthenware. The main other important types of pottery are porcelain, bone china, and stoneware, all fired at high enough temperatures to vitrify. End applications include tableware and decorative ware such as figurines. Earthenware comprises \"most building bricks, nearly all European pottery up to the seventeenth century, most of the wares of Egypt, Persia and the near East; Greek, Roman and Mediterranean, and some of the Chinese; and the fine earthenware which forms the greater part of our tableware today\" (\"today\" being 1962)."}}, {"canonical_name": "Spleen", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 77, "members": [{"entity_id": "spleen", "book_id": "english_physician_1652", "name": "Spleen", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 76, "variants": ["spleen", "Spleen"], "contexts": ["body part treated by the herb", "organ with stoppings opened by herb"]}, {"entity_id": "splene", "book_id": "polyanthea_medicinal", "name": "Splene", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Splene"], "contexts": ["organ, spleen"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Spleen", "target_book": "polyanthea_medicinal", "target_name": "Splene", "similarity": 0.942}], "id": 594, "stable_key": "clu_d7d632ee84fe1f1f", "ground_truth": {"modern_name": "Spleen", "confidence": "high", "type": "anatomy", "description": "An organ in the body, part of the lymphatic system.", "wikipedia_extract": "The spleen (from Anglo-Norman  espleen; ult. from Ancient Greek σπλήν, splḗn) is an organ found in almost all vertebrates. Similar in structure to a large lymph node, it acts primarily as a blood filter. The spleen plays important roles in regard to red blood cells (erythrocytes) and the immune system. It removes old red blood cells and holds a reserve of blood, which can be valuable in case of hemorrhagic shock, and also recycles iron. As a part of the mononuclear phagocyte system, it metabolizes hemoglobin removed from senescent red blood cells. The spleen is a center of activity of the mononuclear phagocyte system and is analogous to a large lymph node, as its absence causes a predisposition to certain infections."}}, {"canonical_name": "Duarte Barbosa", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 76, "members": [{"entity_id": "duarte_barbosa", "book_id": "coloquios_da_orta_1563", "name": "Duarte Barbosa", "category": "PERSON", "subcategory": "SCHOLAR", "count": 75, "variants": ["Duarte Barbosa", "Duarte Barbosa, U»"], "contexts": ["refers to inhabitants of Socotra", "naturalist who explained amber formation"]}, {"entity_id": "odoardus_barbosa", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Odoardus Barbosa", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Odoardus Barbosa"], "contexts": ["delivered information about shells"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Duarte Barbosa", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Odoardus Barbosa", "similarity": 0.855}], "id": 595, "stable_key": "clu_330323171c3dc2f5", "ground_truth": {"modern_name": "Duarte Barbosa", "confidence": "high", "type": "person", "description": "Portuguese writer and explorer, provided accounts of shells", "wikidata_id": "Q1150753", "wikidata_description": "Portuguese explorer and writer (1480–1521)", "wikipedia_url": "https://en.wikipedia.org/wiki/Duarte_Barbosa", "wikipedia_extract": "Débora Susan Sanches Duke (born January 2, 1950) best known as Débora Duarte, is a Brazilian actress. Débora was born in São Paulo, Brazil. She is the daughter of actress Marisa Sanches with the American musician, Douglas Duke. When she was a year and eight months, her mother married the Brazilian actor Lima Duarte, who became her father. In order to honor him, Débora Duke adopted his stage name \"Duarte\". At the age of five, Duarte got her first role, on the TV Tupi series Ciranda, cirandinha."}}, {"canonical_name": "toſles", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 74, "members": [{"entity_id": "toſles", "book_id": "polyanthea_medicinal", "name": "toſles", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 55, "variants": ["toſles", "Toffes", "toffes", "tofle", "tosfle", "tosle", "tosse", "tosses", "tostes", "tostle", "toſies", "toſle", "toſte", "toſſe"], "contexts": ["coughs", "coughing"]}, {"entity_id": "toothach", "book_id": "english_physician_1652", "name": "Toothach", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 19, "variants": ["Toothach"], "contexts": ["pain in the teeth", "pain in teeth"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "toſles", "target_book": "english_physician_1652", "target_name": "Toothach", "similarity": 0.851}], "id": 596, "stable_key": "clu_bc467a940a5a629f", "ground_truth": {"modern_name": "Cough", "confidence": "low", "type": "disease", "description": "A symptom involving forceful expulsion of air from the lungs.", "note": "Cluster also includes 'Toothach' which is a different symptom.", "wikipedia_extract": "A cough is a sudden expulsion of air through the large breathing passages which can help clear them of fluids, irritants, foreign particles and microbes. As a protective reflex, coughing can be repetitive with the cough reflex following three phases: an inhalation, a forced exhalation against a closed glottis, and a violent release of air from the lungs following opening of the glottis, usually accompanied by a distinctive sound. Coughing into one's elbow or toward the ground—rather than forward at breathing height—can reduce the spread of infectious droplets in the air. Frequent coughing usually indicates the presence of a disease. Many viruses and bacteria benefit, from an evolutionary perspective, by causing the host to cough, which helps to spread the disease to new hosts. Irregular coughing is usually caused by a respiratory tract infection but can also be triggered by choking, smoking, air pollution, asthma, gastroesophageal reflux disease, post-nasal drip, chronic bronchitis, lung tumors, heart failure and medications such as angiotensin-converting-enzyme inhibitors (ACE inhibitors) and beta blockers."}}, {"canonical_name": "Diabetica", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 68, "members": [{"entity_id": "diabetica", "book_id": "polyanthea_medicinal", "name": "Diabetica", "category": "DISEASE", "subcategory": "CHRONIC", "count": 66, "variants": ["Diabetica", "Diabe", "Diabete", "Diabetem", "Diabeticas", "Diabeticos", "Diabética", "diabetica", "fedas Diabeticas"], "contexts": ["medical condition related to urine", "diabetic disease"]}, {"entity_id": "diabets", "book_id": "english_physician_1652", "name": "Diabets", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["Diabets", "Diabetes"], "contexts": ["diabetes mellitus", "metabolic disorder"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Diabetica", "target_book": "english_physician_1652", "target_name": "Diabets", "similarity": 0.981}], "id": 597, "stable_key": "clu_d983e8a9452bfdb8", "ground_truth": {"modern_name": "Diabetes", "confidence": "high", "type": "disease", "description": "A metabolic disease characterized by high blood sugar levels.", "wikipedia_extract": "Diabetes mellitus, commonly known as diabetes, is a group of common endocrine diseases characterized by sustained high blood sugar levels. Diabetes tends to progress in severity, and is due to either a reduced production of the hormone insulin by the pancreas or unresponsiveness of bodily cells to insulin's effects. Classic symptoms include the three Ps: polydipsia (excessive thirst), polyuria (excessive urination), and polyphagia (excessive hunger), together with weight loss and blurred vision. If left untreated, the disease can lead to many health complications, including disorders of the cardiovascular system, eye, kidney, and nerves. The major types of diabetes are type 1 and type 2. The most common type is type 2."}}, {"canonical_name": "Eryfipela", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 2, "total_mentions": 67, "members": [{"entity_id": "eryfipela", "book_id": "polyanthea_medicinal", "name": "Eryfipela", "category": "DISEASE", "subcategory": "ACUTE", "count": 65, "variants": ["Eryfipela", "Eryfipelas", "Eryfipella", "Erysipela", "Erysipela maligna", "Eryſipela", "Eryſipelas", "eryfip-las", "eryfipela", "eryfipelas", "erysipela"], "contexts": ["illness treated by Quintilio's powders", "skin infection"]}, {"entity_id": "erisipelas", "book_id": "coloquios_da_orta_1563", "name": "erisipelas", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["erisipelas", "eresipula"], "contexts": ["illness caused by fermenting fruits", "skin infection"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Eryfipela", "target_book": "coloquios_da_orta_1563", "target_name": "erisipelas", "similarity": 0.867}], "id": 598, "stable_key": "clu_49ea481ee21db2d1", "ground_truth": {"modern_name": "Erysipelas", "confidence": "high", "type": "disease", "description": "An acute, superficial bacterial skin infection.", "wikipedia_extract": "Erysipelas () is a relatively common bacterial infection of the superficial layer of the skin (upper dermis), extending to the superficial lymphatic vessels within the skin, characterized by a raised, well-defined, tender, bright-red rash, typically on the face or legs, but which can occur anywhere on the skin. It is a form of cellulitis and is potentially serious. Erysipelas is usually caused by the bacterium Streptococcus pyogenes, also known as group A, β-hemolytic streptococci, which enters the body through a break in the skin, such as a scratch or an insect bite. It is more superficial than cellulitis and is typically more raised and demarcated. The term comes from the Greek ἐρυσίπελας (erysípelas), meaning red skin. In animals, erysipelas is a disease caused by infection with the bacterium Erysipelothrix rhusiopathiae."}}, {"canonical_name": "Water", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 64, "members": [{"entity_id": "water", "book_id": "english_physician_1652", "name": "Water", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 61, "variants": ["Water", "Waters", "water", "waters"], "contexts": ["bodily fluid, also a distilled preparation", "distilled from ash-tree"]}, {"entity_id": "agua", "book_id": "coloquios_da_orta_1563", "name": "agua", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["agua"], "contexts": ["component of the fruit", "liquid used to administer medicine"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Water", "target_book": "coloquios_da_orta_1563", "target_name": "agua", "similarity": 0.982}], "id": 599, "stable_key": "clu_7b061c6a54322594", "ground_truth": {"modern_name": "water", "confidence": "high", "type": "substance", "description": "A vital chemical substance, essential for life and used medicinally.", "note": "While 'Water' can refer to bodily fluids, 'agua' in this context seems to refer to the liquid itself, possibly for medical preparations.", "wikipedia_extract": "Water is an inorganic compound with the chemical formula H2O. It is a transparent, tasteless, odorless, and nearly colorless chemical substance. It is the main constituent of Earth's streams, lakes, and oceans and the fluids of all known living organisms, in which it acts as a solvent. Water, being a polar molecule, undergoes strong intermolecular hydrogen bonding which is a large contributor to its physical and chemical properties. It is vital for all known forms of life, despite not providing food energy or being an organic micronutrient. Due to its presence in all organisms, its chemical stability, its worldwide abundance, and its strong polarity relative to its small molecular size, water is often referred to as the \"universal solvent\"."}}, {"canonical_name": "noz noſcada", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 63, "members": [{"entity_id": "noz_noſcada", "book_id": "polyanthea_medicinal", "name": "noz noſcada", "category": "PLANT", "subcategory": "PLANT", "count": 52, "variants": ["noz noſcada", "Noznoſcada", "flor de noz noſcada", "florde noz noſcada", "noz mofcada", "noz moscada", "noz nof", "noz nofca", "noz nofcada", "noz noscada", "noznoſcada", "pó de noz nofcada"], "contexts": ["nutmeg", "plant for electuary"]}, {"entity_id": "noz", "book_id": "coloquios_da_orta_1563", "name": "noz", "category": "PLANT", "subcategory": "PLANT", "count": 11, "variants": ["noz", "NOZ", "Noz", "noi"], "contexts": ["commodity traded", "topic of the colloquy"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "noz noſcada", "target_book": "coloquios_da_orta_1563", "target_name": "noz", "similarity": 0.893}], "id": 600, "stable_key": "clu_48a45dfb1a5e12fd", "ground_truth": {"modern_name": "nutmeg", "confidence": "high", "type": "plant", "linnaean": "Myristica fragrans", "family": "Myristicaceae", "description": "A spice obtained from the seed of a tree, used in medicine and cooking.", "note": "'noz noſcada' directly translates to nutmeg, while 'noz' in the other context likely refers to the same commodity.", "wikipedia_extract": "Myristica fragrans, commonly known as the nutmeg tree, is an evergreen species indigenous to the Maluku Islands of Indonesia. This aromatic tree is economically significant as the primary source of two distinct spices: nutmeg, derived from its seed, and mace, obtained from the seed's aril. Valued for centuries in global spice trade, M. fragrans is now widely cultivated throughout tropical regions, including parts of Southeast Asia (Indonesia, Malaysia), South Asia (Kerala in India, Sri Lanka), East Asia (Guangdong and Yunnan in China, Taiwan), the Caribbean (notably Grenada), and South America. Myristica fragrans is an evergreen tree, usually 5–15 m (16–49 ft) tall, but occasionally reaching 20 m (66 ft) or even 30 m (98 ft) on Tidore. The alternately arranged leaves are dark green, 5–15 cm (2.0–5.9 in) long by 2–7 cm (0.8–2.8 in) wide with petioles about 1 cm (0.4 in) long. The species is dioecious, i.e. \"male\" or staminate flowers and \"female\" or carpellate flowers are borne on different plants, although occasional individuals produce both kinds of flower."}}, {"canonical_name": "ervas", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 60, "members": [{"entity_id": "ervas", "book_id": "polyanthea_medicinal", "name": "ervas", "category": "PLANT", "subcategory": "PLANT", "count": 54, "variants": ["ervas", "erva", "erva crista", "ervadoce"], "contexts": ["herbs associated with coldness", "herbs used in remedies"]}, {"entity_id": "erva", "book_id": "coloquios_da_orta_1563", "name": "erva", "category": "PLANT", "subcategory": "PLANT", "count": 6, "variants": ["erva", "erpa", "ervas"], "contexts": ["herb, used in medicine", "herb used in remedies"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "ervas", "target_book": "coloquios_da_orta_1563", "target_name": "erva", "similarity": 0.972}], "id": 601, "stable_key": "clu_186ce6599f42c5e8", "ground_truth": {"modern_name": "Herbs", "confidence": "high", "type": "plant", "description": "Plants or parts of plants used for medicinal or culinary purposes.", "wikipedia_extract": "Herbs are a widely distributed and widespread group of plants, excluding vegetables, with savory or aromatic properties that are used for flavoring and garnishing food, for medicinal purposes, or for fragrances. Culinary use typically distinguishes herbs from spices. Herbs generally refers to the leafy green or flowering parts of a plant (either fresh or dried), while spices are usually dried and produced from other parts of the plant, including seeds, bark, roots and fruits. Herbs have a variety of uses including culinary, medicinal, aromatic and in some cases, spiritual. General usage of the term \"herb\" differs between culinary herbs and medicinal herbs; in medicinal or spiritual use, any parts of the plant might be considered \"herbs\", including leaves, roots, flowers, seeds, root bark, inner bark (and cambium), resin and pericarp. The word \"herb\" is pronounced  in Commonwealth English, but  is standard among American English speakers as well as those from regions where h-dropping occurs."}}, {"canonical_name": "Peripneumonia", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 2, "total_mentions": 60, "members": [{"entity_id": "peripneumonia", "book_id": "polyanthea_medicinal", "name": "Peripneumonia", "category": "DISEASE", "subcategory": "ACUTE", "count": 57, "variants": ["Peripneumonia", "Aperipneumo", "Eripneumonia", "Perineumonia", "Perineumonias", "Peripneumonias", "peripneumonia", "peripneumonias"], "contexts": ["doctors' name for lung inflammation", "disease doctors call by this name"]}, {"entity_id": "pneumonia", "book_id": "polyanthea_medicinal", "name": "pneumonia", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["pneumonia", "Pulmonia"], "contexts": ["inflammation of the lungs", "pneumonia, an acute lung inflammation"]}, {"entity_id": "pneumonia", "book_id": "first_principles_spencer_1862", "name": "pneumonia", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["pneumonia"], "contexts": ["lung inflammation"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Peripneumonia", "target_book": "first_principles_spencer_1862", "target_name": "pneumonia", "similarity": 0.874}, {"source_book": "polyanthea_medicinal", "source_name": "pneumonia", "target_book": "first_principles_spencer_1862", "target_name": "pneumonia", "similarity": 1.0}], "id": 602, "stable_key": "clu_3c148e2d06fdf97e", "ground_truth": {"modern_name": "Pneumonia", "confidence": "high", "type": "disease", "modern_term": "Pneumonia", "wikidata_id": "Q32540", "wikidata_description": "disease in which an eosinophil, a type of white blood cell, accumulates in the lung", "wikipedia_url": "https://en.wikipedia.org/wiki/Eosinophilic%20pneumonia", "wikipedia_extract": "Pneumonia is an inflammatory condition of the lung primarily affecting the small air sacs known as alveoli. Symptoms typically include some combination of productive or dry cough, chest pain, fever, and difficulty breathing. The severity of the condition is variable. Pneumonia is usually caused by infection with viruses or bacteria, and less commonly by other microorganisms. Identifying the responsible pathogen can be difficult. Diagnosis is often based on symptoms and physical examination."}}, {"canonical_name": "colericos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 59, "members": [{"entity_id": "colericos", "book_id": "polyanthea_medicinal", "name": "colericos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 56, "variants": ["colericos", "coleira", "coleragrofia", "coleras", "coleri", "colerica"], "contexts": ["related to choler", "related to choleric humors"]}, {"entity_id": "cólera", "book_id": "coloquios_da_orta_1563", "name": "cólera", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["cólera"], "contexts": ["humor that can be imbalanced", "humor purged by arare"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "colericos", "target_book": "coloquios_da_orta_1563", "target_name": "cólera", "similarity": 0.847}], "id": 603, "stable_key": "clu_c195fa09c3c92d9c", "ground_truth": {"modern_name": "Choler", "confidence": "high", "type": "substance", "description": "One of the four humors in ancient and medieval medicine, associated with temperament.", "wikipedia_extract": "Anger is an intense emotional state involving a strong, uncomfortable and non-cooperative response to a perceived provocation, hurt, or threat. A person experiencing anger will often experience physical effects, such as increased heart rate, elevated blood pressure, and increased levels of the stress hormones adrenaline and noradrenaline. Some view anger as an emotion that triggers part of the fight or flight response. Anger becomes the predominant feeling behaviorally, cognitively, and physiologically when a person makes the conscious choice to take action to immediately stop the threatening behavior of another outside force. Anger can have many physical and mental consequences. The external expression of anger can be found in facial expressions, body language, physiological responses, and at times public acts of aggression."}}, {"canonical_name": "Parime", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 59, "members": [{"entity_id": "parime", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Parime", "category": "PLACE", "subcategory": "REGION", "count": 57, "variants": ["Parime", "Sierra Parime"], "contexts": ["mythical lake or region", "region in South America"]}, {"entity_id": "montagnes_de_la_parime", "book_id": "relation_historique_humboldt_vol3_1825", "name": "montagnes de la Parime", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["montagnes de la Parime"], "contexts": ["mountain range"]}, {"entity_id": "sierra_parime", "book_id": "kosmos_humboldt_1845", "name": "Sierra Parime", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Sierra Parime"], "contexts": ["mountain chain"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Parime", "target_book": "kosmos_humboldt_1845", "target_name": "Sierra Parime", "similarity": 0.895}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "montagnes de la Parime", "target_book": "kosmos_humboldt_1845", "target_name": "Sierra Parime", "similarity": 0.874}], "id": 604, "stable_key": "clu_e11bef798f5f8d28", "ground_truth": {"modern_name": "Serra do Pacaraima", "confidence": "medium", "type": "place", "country": "Brazil, Venezuela, Guyana", "note": "Early modern texts refer to a mythical lake and mountain range; modern geographical features are associated with the name.", "wikidata_id": "Q14924543", "wikidata_description": "genus of insects", "wikipedia_extract": "Roraima (English: , rə-RY-mə ; Brazilian Portuguese: [ʁoˈɾajmɐ]  or [ʁoˈɾɐ̃jmɐ]) is one of the 26 states of Brazil. Located in the country's North Region, it is the northernmost and most geographically and logistically isolated state in Brazil. It is bordered by the state of Pará to the southeast, Amazonas to the south and west, Venezuela to the north and northwest, and Guyana to the east. The state covers an area of approximately 223,644.527 square kilometres (86,300 sq mi), slightly larger than Belarus, being the fourteenth largest Brazilian state by area. The city of Boa Vista is the capital and largest city in the state, and is the only capital in the country located entirely in the Northern Hemisphere. Antônio Denarium, a member of the conservative Progressistas party, has been the governor of the state since 2019.", "wikipedia_url": "https://en.wikipedia.org/wiki/Roraima"}}, {"canonical_name": "baromètre", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 57, "members": [{"entity_id": "baromètre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "baromètre", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 43, "variants": ["baromètre", "BAROMÈTRE", "baromètres", "baromètres portatifs", "barométriques"], "contexts": ["instrument for measuring atmospheric pressure", "instrument used for measurement"]}, {"entity_id": "barometer", "book_id": "kosmos_humboldt_1845", "name": "barometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 13, "variants": ["Barometer", "barometer"], "contexts": ["instrument measuring atmospheric pressure", "device for measuring atmospheric pressure"]}, {"entity_id": "barometrical", "book_id": "kosmos_humboldt_1845", "name": "barometrical", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["barometrical"], "contexts": ["related to barometric pressure measurement"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "baromètre", "target_book": "kosmos_humboldt_1845", "target_name": "barometer", "similarity": 0.947}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "baromètre", "target_book": "kosmos_humboldt_1845", "target_name": "barometrical", "similarity": 0.935}], "id": 605, "stable_key": "clu_6c2aa5405927bf2c", "ground_truth": {"modern_name": "Barometer", "confidence": "high", "type": "object", "wikipedia_extract": "An altimeter or an altitude meter is an instrument used to measure the altitude of an object above a fixed level. The measurement of altitude is called altimetry, which is related to the term bathymetry, the measurement of depth under water. In 1931, the US Army Air corps and General Electric together tested a sonic altimeter for aircraft, which was considered more reliable and accurate than one that relied on air pressure when heavy fog or rain was present. The new altimeter used a series of high-pitched sounds like those made by a bat to measure the distance from the aircraft to the surface, which on return to the aircraft was converted to feet shown on a gauge inside the aircraft cockpit. A radar altimeter measures altitude more directly, using the time taken for a radio signal to reflect from the surface back to the aircraft. Alternatively, Frequency Modulated Continuous-wave radar can be used.", "wikipedia_url": "https://en.wikipedia.org/wiki/Altimeter"}}, {"canonical_name": "hyffopo", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 57, "members": [{"entity_id": "hyffopo", "book_id": "polyanthea_medicinal", "name": "hyffopo", "category": "PLANT", "subcategory": "PLANT", "count": 51, "variants": ["hyffopo", "Hyffopo", "Hyflopo", "Hyfopo", "Hyslopo", "Hysope", "Hyſiopo", "hyfiopo", "hyflop", "hyflopo", "hysoppo", "hyſtopo", "hyſſopo"], "contexts": ["hyssop, an herb", "herb used in preparation"]}, {"entity_id": "hyfopo", "book_id": "ricettario_fiorentino_1597", "name": "Hyfopo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["Hyfopo", "Hyffopo", "Hyflopo", "Hyfopofecco", "Hyfopohumida"], "contexts": ["ingredient in decoction", "herb used in preparations"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "hyffopo", "target_book": "ricettario_fiorentino_1597", "target_name": "Hyfopo", "similarity": 0.869}], "id": 606, "stable_key": "clu_ca964e1c33d5dbce", "ground_truth": {"modern_name": "Hyssop", "confidence": "high", "type": "plant", "linnaean": "Hyssopus officinalis", "family": "Lamiaceae", "description": "An aromatic herb used historically in medicine and religious practices.", "wikipedia_extract": "Hyssopus officinalis or hyssop is a shrub in the Lamiaceae or mint family native to Southern Europe, the Middle East, and the region surrounding the Caspian Sea. Due to its purported properties as an antiseptic, cough reliever, and expectorant, it has been used in traditional herbal medicine. Hyssop is a brightly coloured shrub or subshrub that ranges from 30 to 60 cm (12 to 24 in) in height. The stem is woody at the base, from which grow a number of upright branches. Its leaves are lanceolate, dark green, and from 2 to 2.5 cm (3⁄4 to 1 in) long. During the summer, hyssop produces pink, blue (ssp. aristadus), or, more rarely, white fragrant (ssp. f. albus) flowers."}}, {"canonical_name": "triaga magna", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 56, "members": [{"entity_id": "triaga_magna", "book_id": "polyanthea_medicinal", "name": "triaga magna", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 45, "variants": ["triaga magna", "Theriagamagna", "Triaga", "Triaga Magna", "Triaga magna", "Triagamagna", "Triagas", "theriagamagna", "triaga", "triaga velha", "triagamagna", "triagas"], "contexts": ["a compound medicine", "compound medicine"]}, {"entity_id": "triaga", "book_id": "coloquios_da_orta_1563", "name": "triaga", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 11, "variants": ["triaga", "triacal", "triaga bebida", "triagua"], "contexts": ["theriac, compound medicine", "universal antidote"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "triaga magna", "target_book": "coloquios_da_orta_1563", "target_name": "triaga", "similarity": 0.874}], "id": 607, "stable_key": "clu_4e2b3940447005ed", "ground_truth": {"modern_name": "Theriac", "confidence": "high", "type": "substance", "description": "A complex compound medicine or antidote, historically used as a panacea.", "wikipedia_extract": "Theriac or theriaca is a medical concoction originally labelled by the Greeks in the 1st century AD and widely adopted in the ancient world as far away as Persia, China and India via the trading links of the Silk Route. It was an alexipharmic, or antidote for a variety of poisons and diseases. It was also considered a panacea, a term for which it could be used interchangeably: in the 16th century Adam Lonicer wrote that garlic was the rustic's theriac or Heal-All. The word theriac comes from the Greek term θηριακή (thēriakē), a feminine adjective signifying \"pertaining to animals\", from θηρίον (thērion), \"wild animal, beast\". The ancient bestiaries included information—often fanciful—about dangerous beasts and their bites. When cane sugar was an exotic Eastern commodity, the English recommended the sugar-based treacle as an antidote against poison, originally applied as a salve."}}, {"canonical_name": "peyto", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 55, "members": [{"entity_id": "peyto", "book_id": "polyanthea_medicinal", "name": "peyto", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 53, "variants": ["peyto", "peito", "petto", "pevto", "peytos", "peytos de ambos os pes"], "contexts": ["body part", "part of the body, chest"]}, {"entity_id": "peito", "book_id": "coloquios_da_orta_1563", "name": "peito", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["peito"], "contexts": ["second grade of camphor", "body part"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "peyto", "target_book": "coloquios_da_orta_1563", "target_name": "peito", "similarity": 0.851}], "id": 608, "stable_key": "clu_c65bc54932f8735e", "ground_truth": {"modern_name": "Chest", "confidence": "high", "type": "anatomy", "description": "The part of the body between the neck and the abdomen; the thorax.", "wikipedia_extract": "The thorax (pl.: thoraces or thoraxes) or chest is a part of the anatomy of mammals and other tetrapod animals located between the neck and the abdomen. In insects, crustaceans, and the extinct trilobites, the thorax is one of the three main divisions of the body, each in turn composed of multiple segments. The human thorax includes the thoracic cavity and the thoracic wall. It contains organs including the heart, lungs, and thymus gland, as well as muscles and various other internal structures. The chest may be affected by many diseases, of which the most common symptom is chest pain. The word thorax comes from the Greek θώραξ thṓrax \"breastplate, cuirass, corslet\" via Latin: thorax."}}, {"canonical_name": "Obstructions", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 55, "members": [{"entity_id": "obstructions", "book_id": "english_physician_1652", "name": "Obstructions", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 26, "variants": ["Obstructions", "Obstructi", "Obstructions of the Gall", "Obstructions of the Liver", "Obstructions of the Liver and Spleen", "Obstru∣ctions", "obstructions"], "contexts": ["blockages in organs", "condition borrage syrup helps open"]}, {"entity_id": "obstrucções", "book_id": "polyanthea_medicinal", "name": "obstrucções", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 7, "variants": ["obstrucções"], "contexts": ["blockages in the body", "obstructions"]}, {"entity_id": "obstrucçoens", "book_id": "polyanthea_medicinal", "name": "obstrucçoens", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["obstrucçoens"], "contexts": ["blockages in the body", "blockages"]}, {"entity_id": "obſtrucção", "book_id": "polyanthea_medicinal", "name": "obſtrucção", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["obſtrucção"], "contexts": ["obstruction", "remedy for obstruction and hardness of spleen"]}, {"entity_id": "obstrucçao", "book_id": "polyanthea_medicinal", "name": "obstrucçao", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["obstrucçao"], "contexts": ["condition caused by cold humors", "remedy for obstruction"]}, {"entity_id": "obstrucção", "book_id": "polyanthea_medicinal", "name": "obstrucção", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["obstrucção"], "contexts": ["obstruction", "obstruction as a cause of palpitations"]}, {"entity_id": "obstrução_dos_tubulos", "book_id": "polyanthea_medicinal", "name": "obstrução dos tubulos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["obstrução dos tubulos"], "contexts": ["cause of brain symptoms"]}, {"entity_id": "obstrueções", "book_id": "polyanthea_medicinal", "name": "obstrueções", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["obstrueções"], "contexts": ["blockages in the body"]}, {"entity_id": "obstructed", "book_id": "polyanthea_medicinal", "name": "obstructed", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["obstructed"], "contexts": ["blocked passages in the body"]}, {"entity_id": "obstru__ction", "book_id": "polyanthea_medicinal", "name": "obstru. ction", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["obstru. ction"], "contexts": ["blockage"]}, {"entity_id": "obstructionelevium_arteriarum", "book_id": "polyanthea_medicinal", "name": "obstructionelevium arteriarum", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["obstructionelevium arteriarum"], "contexts": ["obstruction of the small arteries"]}, {"entity_id": "obstruct_", "book_id": "polyanthea_medicinal", "name": "obstruct.", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["obstruct."], "contexts": ["obstruction"]}, {"entity_id": "obstrucçaõ_do_baço", "book_id": "polyanthea_medicinal", "name": "obstrucçaõ do baço", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["obstrucçaõ do baço"], "contexts": ["spleen obstruction"]}, {"entity_id": "obstructione", "book_id": "polyanthea_medicinal", "name": "obstructione", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["obstructione"], "contexts": ["obstruction, medical condition"]}, {"entity_id": "obstruct__lienis", "book_id": "polyanthea_medicinal", "name": "Obstruct. lienis", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Obstruct. lienis"], "contexts": ["obstruction of the spleen"]}, {"entity_id": "lienis_obstructio", "book_id": "polyanthea_medicinal", "name": "Lienis obstructio", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Lienis obstructio"], "contexts": ["obstruction of the spleen"]}, {"entity_id": "obstructioni", "book_id": "polyanthea_medicinal", "name": "obstructioni", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["obstructioni"], "contexts": ["blockage in the body"]}, {"entity_id": "obstrucções_das_veas", "book_id": "polyanthea_medicinal", "name": "obstrucções das veas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["obstrucções das veas"], "contexts": ["vein obstructions"]}, {"entity_id": "obstrrucção_das_veas", "book_id": "polyanthea_medicinal", "name": "obstrrucção das veas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["obstrrucção das veas"], "contexts": ["vein obstruction"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Obstructions", "target_book": "polyanthea_medicinal", "target_name": "obstrucções", "similarity": 0.96}, {"source_book": "english_physician_1652", "source_name": "Obstructions", "target_book": "polyanthea_medicinal", "target_name": "obstrucçoens", "similarity": 0.957}, {"source_book": "english_physician_1652", "source_name": "Obstructions", "target_book": "polyanthea_medicinal", "target_name": "obſtrucção", "similarity": 0.87}, {"source_book": "english_physician_1652", "source_name": "Obstructions", "target_book": "polyanthea_medicinal", "target_name": "obstrucçao", "similarity": 0.95}, {"source_book": "english_physician_1652", "source_name": "Obstructions", "target_book": "polyanthea_medicinal", "target_name": "obstrucção", "similarity": 0.959}, {"source_book": "english_physician_1652", "source_name": "Obstructions", "target_book": "polyanthea_medicinal", "target_name": "obstrução dos tubulos", "similarity": 0.886}, {"source_book": "english_physician_1652", "source_name": "Obstructions", "target_book": "polyanthea_medicinal", "target_name": "obstrueções", "similarity": 0.948}, {"source_book": "english_physician_1652", "source_name": "Obstructions", "target_book": "polyanthea_medicinal", "target_name": "obstructed", "similarity": 0.843}, {"source_book": "english_physician_1652", "source_name": "Obstructions", "target_book": "polyanthea_medicinal", "target_name": "obstru. ction", "similarity": 0.929}, {"source_book": "english_physician_1652", "source_name": "Obstructions", "target_book": "polyanthea_medicinal", "target_name": "obstructionelevium arteriarum", "similarity": 0.894}, {"source_book": "english_physician_1652", "source_name": "Obstructions", "target_book": "polyanthea_medicinal", "target_name": "obstruct.", "similarity": 0.962}, {"source_book": "english_physician_1652", "source_name": "Obstructions", "target_book": "polyanthea_medicinal", "target_name": "obstrucçaõ do baço", "similarity": 0.891}, {"source_book": "english_physician_1652", "source_name": "Obstructions", "target_book": "polyanthea_medicinal", "target_name": "obstructione", "similarity": 0.985}, {"source_book": "english_physician_1652", "source_name": "Obstructions", "target_book": "polyanthea_medicinal", "target_name": "Obstruct. lienis", "similarity": 0.917}, {"source_book": "english_physician_1652", "source_name": "Obstructions", "target_book": "polyanthea_medicinal", "target_name": "Lienis obstructio", "similarity": 0.874}, {"source_book": "english_physician_1652", "source_name": "Obstructions", "target_book": "polyanthea_medicinal", "target_name": "obstructioni", "similarity": 0.986}, {"source_book": "english_physician_1652", "source_name": "Obstructions", "target_book": "polyanthea_medicinal", "target_name": "obstrucções das veas", "similarity": 0.872}, {"source_book": "english_physician_1652", "source_name": "Obstructions", "target_book": "polyanthea_medicinal", "target_name": "obstrrucção das veas", "similarity": 0.853}], "id": 609, "stable_key": "clu_e9ce01c10881a497", "ground_truth": {"modern_name": "Obstruction", "confidence": "high", "type": "disease", "description": "Blockage or impediment within the body or organs.", "wikipedia_extract": "Bowel obstruction, also known as intestinal obstruction, is a mechanical or functional obstruction of the intestines that prevents the normal movement of the products of digestion. Either the small bowel or large bowel may be affected. Signs and symptoms include abdominal pain, vomiting, bloating and not passing gas. Mechanical obstruction is the cause of about 5 to 15% of cases of severe abdominal pain of sudden onset requiring admission to hospital. Causes of bowel obstruction include adhesions, hernias, volvulus, endometriosis, inflammatory bowel disease, appendicitis, tumors, diverticulitis, ischemic bowel, tuberculosis and intussusception. Small bowel obstructions are most often due to adhesions and hernias, while large bowel obstructions are most often due to tumors and volvulus."}}, {"canonical_name": "Quinaquina", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 55, "members": [{"entity_id": "quinaquina", "book_id": "polyanthea_medicinal", "name": "Quinaquina", "category": "PLANT", "subcategory": "PLANT", "count": 48, "variants": ["Quinaquina", "AQuinaquina", "Aquinaquin", "Qui-naquina", "Quinaqui", "quinaquina"], "contexts": ["cinchona bark", "remedy for fevers"]}, {"entity_id": "quinces", "book_id": "english_physician_1652", "name": "Quinces", "category": "PLANT", "subcategory": "PLANT", "count": 7, "variants": ["Quinces", "Quince", "Quince Tree", "Quince-Tree"], "contexts": ["fruit used for medicinal preparations", "fruit used for distilled water"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Quinaquina", "target_book": "english_physician_1652", "target_name": "Quinces", "similarity": 0.843}], "id": 610, "stable_key": "clu_6683bab135541bd5", "ground_truth": {"wikipedia_extract": "Cinchona (pronounced  or ) is a genus of flowering plants in the family Rubiaceae containing at least 23 species of trees and shrubs. All are native to the tropical Andean forests of western South America. A few species are reportedly naturalized in Central America, Jamaica, French Polynesia, Sulawesi, Saint Helena in the South Atlantic, and São Tomé and Príncipe off the coast of tropical Africa, and others have been cultivated in India and Java, where they have formed hybrids. Cinchona has been historically sought after for its medicinal value, as the bark of several species yields quinine and other alkaloids. These were the only effective treatments against malaria during the height of European colonialism, which made them of great economic and political importance. Trees in the genus are also known as fever trees because of their antimalarial properties."}}, {"canonical_name": "Ormuz", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 55, "members": [{"entity_id": "ormuz", "book_id": "coloquios_da_orta_1563", "name": "Ormuz", "category": "PLACE", "subcategory": "CITY", "count": 54, "variants": ["Ormuz"], "contexts": ["city where Persians, Arabs, Turks sell aloés", "city where goods are sold"]}, {"entity_id": "ormuz", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Ormuz", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Ormuz"], "contexts": ["city"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Ormuz", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Ormuz", "similarity": 1.0}], "id": 611, "stable_key": "clu_88d8829a3e31e976", "ground_truth": {"modern_name": "Hormuz", "confidence": "high", "type": "place", "description": "A historic port city and trading hub on the Persian Gulf.", "note": "The spelling 'Ormuz' is an older variant.", "wikipedia_extract": "The Kingdom of Hormuz (also known as Hormoz or, archaically, Ormus; Persian: هرمز; Portuguese: Ormuz) was located in the eastern side of the Persian Gulf and extended as far as Bahrain in the west at its zenith. The Kingdom was established in the 11th century initially as a dependency of the Kerman Seljuk Sultanate, and later as an autonomous tributary of the Salghurid Turkmens and the Ilkhanates. In its last phase Hormuz became a client state of the Portuguese Empire in the East. The island was a major economic base of economic exchanges and marine trade as an important port between the Persian Gulf and the Indian Ocean. This port was originally located on the southern coast of Iran to the east of the Strait of Hormuz, near the modern city of Minab, and was later relocated to the island of Jarun which came to be known as Hormuz Island, which is located near the modern city of Bandar-e Abbas. Popular etymology derives \"Hormuz\" from the Middle Persian pronunciation of the name of the Zoroastrian god Ahuramazda."}}, {"canonical_name": "Seme d'Appio", "category": "PLANT", "subcategory": "SEED", "book_count": 2, "total_mentions": 54, "members": [{"entity_id": "seme_d'appio", "book_id": "ricettario_fiorentino_1597", "name": "Seme d'Appio", "category": "PLANT", "subcategory": "SEED", "count": 53, "variants": ["Seme d'Appio", "Seme", "Seme d' Appio", "Seme d'Agno", "Seme d'Ama", "Seme d'apio", "Seme d'appio", "Seme di Bafs.Iico", "Seme di Bajfsilico", "Seme di Cedro", "Seme di Cicorca", "Seme di Finocc", "Seme di Finocchio", "Seme di Fisi pcchio", "Seme di Lattuga", "Seme di Lcuiftico", "Seme di Malua", "Seme di Papaveri", "Seme di Peonia", "Seme di appio", "Seme di co", "Seme di cotogne", "Seme di finocchio", "Seme di latta", "Seme di leuiftico", "Seme di levistico", "Seme di popone", "Seme diruta", "Seme drammi", "Semed'Aneto", "Semed'App'o", "Semed'Appia", "SemedVAppioì", "Semedibafsilico", "seme"], "contexts": ["celery seed used in preparations", "ingredient in a preparation"]}, {"entity_id": "semente_de_aipo", "book_id": "coloquios_da_orta_1563", "name": "semente de aipo", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["semente de aipo"], "contexts": ["seed used in preparation"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Seme d'Appio", "target_book": "coloquios_da_orta_1563", "target_name": "semente de aipo", "similarity": 0.845}], "id": 612, "stable_key": "clu_a71fd89bf2b5d56e", "ground_truth": {"modern_name": "Celery seed", "confidence": "high", "type": "plant", "linnaean": "Apium graveolens", "family": "Apiaceae", "description": "Seed of the celery plant used in medicinal preparations.", "note": "'Seme d'Appio' and 'semente de aipo' are Italian and Portuguese for celery seed.", "wikipedia_extract": "Apium graveolens, known in English as celery, is an Old World species of flowering plant in the family Apiaceae. It was first described by Carl Linnaeus in 1753. The species is widely naturalised outside of its natural range and is used as a vegetable; modern cultivars have been selected for their leaf stalks (celery), a large bulb-like hypocotyl (celeriac), and their leaves (leaf celery). Apium graveolens is a stout biennial or monocarpic perennial herb, producing flowers and seeds only once, during its second or a later year. It grows up to 1 m (3 ft) tall, with all parts of the plant having a strong celery odour. The stems are solid with conspicuous grooves on the surface (sulcate)."}}, {"canonical_name": "Mercury", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 53, "members": [{"entity_id": "mercury", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mercury", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 36, "variants": ["Mercury", "mercury"], "contexts": ["planet revolving on the border of instability zone", "planet eclipsed by Venus"]}, {"entity_id": "mercury", "book_id": "kosmos_humboldt_1845", "name": "Mercury", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 17, "variants": ["Mercury", "mercury"], "contexts": ["inner planetary group member", "planet in our solar system"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Mercury", "target_book": "kosmos_humboldt_1845", "target_name": "Mercury", "similarity": 1.0}], "id": 613, "stable_key": "clu_300c5d1bb0b540e2", "ground_truth": {"modern_name": "Mercury", "confidence": "high", "type": "concept"}}, {"canonical_name": "Popayan", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 53, "members": [{"entity_id": "popayan", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Popayan", "category": "PLACE", "subcategory": "CITY", "count": 47, "variants": ["Popayan", "Popajan"], "contexts": ["mountainous population center in Colombia", "city with population 171,000"]}, {"entity_id": "popayan", "book_id": "kosmos_humboldt_1845", "name": "Popayan", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Popayan"], "contexts": ["city in Colombia", "city in 1788 with specific latitude and elevation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Popayan", "target_book": "kosmos_humboldt_1845", "target_name": "Popayan", "similarity": 1.0}], "id": 614, "stable_key": "clu_55aa952688a12997", "ground_truth": {"modern_name": "Popayán", "confidence": "high", "type": "place", "country": "Colombia"}}, {"canonical_name": "Manteyga crua", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 51, "members": [{"entity_id": "manteyga_crua", "book_id": "polyanthea_medicinal", "name": "Manteyga crua", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 50, "variants": ["Manteyga crua", "Manteyga", "manteiga crua", "manteigade vacca", "manteyga", "manteyga crua", "manteyga de vacca", "manteyga de vacca lavada", "manteyga devacca", "manteyga freſca", "manteygacrua", "manteygade vacca", "manteygade vaccas", "manteygas"], "contexts": ["raw butter", "raw butter used in remedies"]}, {"entity_id": "manteigua_crua", "book_id": "coloquios_da_orta_1563", "name": "manteigua crua", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["manteigua crua"], "contexts": ["ingredient mixed with roasted seeds"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Manteyga crua", "target_book": "coloquios_da_orta_1563", "target_name": "manteigua crua", "similarity": 0.909}], "id": 615, "stable_key": "clu_fa0429f1373288cf", "ground_truth": {"modern_name": "raw butter", "confidence": "high", "type": "SUBSTANCE", "description": "Unprocessed butter, often used as a medicinal ingredient.", "wikipedia_extract": "Butter is a dairy product made from the fat and protein components of churned cream. It is a semi-solid emulsion at room temperature, consisting of approximately 81% butterfat. It is used at room temperature as a spread, melted as a condiment, and used as a fat in baking, sauce-making, pan frying, and other cooking procedures. Most frequently made from cow's milk, butter can also be manufactured from the milk of other mammals, including sheep, goats, buffalo, and yaks. It is made by churning milk or cream to separate the fat globules from the buttermilk. Salt has been added to butter since antiquity to help preserve it, particularly when being transported; salt may still play a preservation role but is less important today as the entire supply chain is usually refrigerated."}}, {"canonical_name": "Almecega", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 50, "members": [{"entity_id": "almecega", "book_id": "polyanthea_medicinal", "name": "Almecega", "category": "PLANT", "subcategory": "PLANT", "count": 43, "variants": ["almecega", "Almecega"], "contexts": ["ingredient in a pill for vomiting", "spice used in a preparation"]}, {"entity_id": "almecega", "book_id": "coloquios_da_orta_1563", "name": "almecega", "category": "PLANT", "subcategory": "PLANT", "count": 5, "variants": ["almecega", "almécega"], "contexts": ["ingredient in falcon plaster", "mastic, used in oil preparation"]}, {"entity_id": "almecega_do_brasil", "book_id": "polyanthea_medicinal", "name": "almecega do Brasil", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["almecega do Brasil"], "contexts": ["mastic from Brazil, plaster ingredient"]}, {"entity_id": "almecega_em_grão", "book_id": "polyanthea_medicinal", "name": "almecega em grão", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["almecega em grão"], "contexts": ["mastic in grain form"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Almecega", "target_book": "coloquios_da_orta_1563", "target_name": "almecega", "similarity": 0.902}, {"source_book": "coloquios_da_orta_1563", "source_name": "almecega", "target_book": "polyanthea_medicinal", "target_name": "almecega do Brasil", "similarity": 0.814}, {"source_book": "coloquios_da_orta_1563", "source_name": "almecega", "target_book": "polyanthea_medicinal", "target_name": "almecega em grão", "similarity": 0.849}], "id": 616, "stable_key": "clu_734310c5c28b8ae4", "ground_truth": {"modern_name": "mastic", "confidence": "high", "type": "PLANT", "linnaean": "Pistacia lentiscus", "family": "Anacardiaceae", "description": "Aromatic resin from the mastic tree, used medicinally and as a spice.", "note": "Also known as Almaciga. 'Almecega do Brasil' likely refers to related species or similar resins.", "wikipedia_extract": "Pistacia lentiscus (also lentisk or mastic) is a dioecious evergreen shrub or small tree of the genus Pistacia native to the Mediterranean Basin. It grows up to 4 m (13 ft) tall and is cultivated for its aromatic resin, mainly on the Greek island of Chios, around the Turkish town of Çeşme and northern parts of Iraq. The plant is evergreen, from 1 to 5 m (3 ft 3 in to 16 ft 5 in) high, with a strong smell of resin, growing in dry and rocky areas in North Africa and Mediterranean Europe. It resists mild to heavy frosts but prefers milder winters and grows on all types of soils, and can grow well in limestone areas and even in salty or saline environments, making it more abundant near the sea. It is also found in woodlands, dehesas (almost deforested pasture areas), Kermes oak woods, wooded areas dominated by other oaks, garrigues, maquis shrublands, hills, gorges, canyons, and rocky hillsides of the entire Mediterranean area. It is a typical species of Mediterranean mixed communities which include myrtle, Kermes oak, Mediterranean dwarf palm, buckthorn and sarsaparilla, and serves as protection and food for birds and other fauna in this ecosystem."}}, {"canonical_name": "Oyl", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 48, "members": [{"entity_id": "oyl", "book_id": "english_physician_1652", "name": "Oyl", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 47, "variants": ["Oyl"], "contexts": ["preserved plant extract", "used for gout"]}, {"entity_id": "olio", "book_id": "coloquios_da_orta_1563", "name": "olio", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["olio"], "contexts": ["oil from whale's head"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Oyl", "target_book": "coloquios_da_orta_1563", "target_name": "olio", "similarity": 0.865}], "id": 617, "stable_key": "clu_4b6e03725f5abbef", "ground_truth": {"modern_name": "oil", "confidence": "high", "type": "SUBSTANCE", "description": "General term for fatty or oily liquids, including plant extracts and animal fats.", "note": "Contexts suggest both plant-derived oils and animal oils (e.g., whale oil).", "wikipedia_extract": "Oil is a liquid with varying degrees of viscosity depending on temperature. Oil is any nonpolar chemical substance that is composed primarily of hydrocarbons and is hydrophobic (does not mix with water) and lipophilic (mixes with other oils). Oils are usually flammable and surface active. Most oils are unsaturated lipids that are liquid at room temperature. The general definition of oil includes classes of chemical compounds that may be otherwise unrelated in structure, properties, and uses. Oils may be animal, vegetable, or petrochemical in origin, and may be volatile or non-volatile."}}, {"canonical_name": "Cough", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 48, "members": [{"entity_id": "cough", "book_id": "english_physician_1652", "name": "Cough", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 47, "variants": ["Cough", "Coughs", "cough", "coughing"], "contexts": ["cough rid away by the herb", "condition helped by bugloss electuary"]}, {"entity_id": "cough", "book_id": "first_principles_spencer_1862", "name": "cough", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["cough"], "contexts": ["sudden expulsion of air from lungs"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Cough", "target_book": "first_principles_spencer_1862", "target_name": "cough", "similarity": 0.953}], "id": 618, "stable_key": "clu_b22d07fb0c66ae0c", "ground_truth": {"modern_name": "Cough", "confidence": "high", "type": "disease", "modern_term": "Cough", "wikidata_id": "Q35805", "wikidata_description": "medical symptom, reflex to clear large breathing passages", "wikipedia_extract": "A cough is a sudden expulsion of air through the large breathing passages which can help clear them of fluids, irritants, foreign particles and microbes. As a protective reflex, coughing can be repetitive with the cough reflex following three phases: an inhalation, a forced exhalation against a closed glottis, and a violent release of air from the lungs following opening of the glottis, usually accompanied by a distinctive sound. Coughing into one's elbow or toward the ground—rather than forward at breathing height—can reduce the spread of infectious droplets in the air. Frequent coughing usually indicates the presence of a disease. Many viruses and bacteria benefit, from an evolutionary perspective, by causing the host to cough, which helps to spread the disease to new hosts. Irregular coughing is usually caused by a respiratory tract infection but can also be triggered by choking, smoking, air pollution, asthma, gastroesophageal reflux disease, post-nasal drip, chronic bronchitis, lung tumors, heart failure and medications such as angiotensin-converting-enzyme inhibitors (ACE inhibitors) and beta blockers.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cough"}}, {"canonical_name": "frialdade", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 48, "members": [{"entity_id": "frialdade", "book_id": "polyanthea_medicinal", "name": "frialdade", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 45, "variants": ["frialdade", "Frialdade", "fria"], "contexts": ["excess of coldness affecting memory", "quality of the body"]}, {"entity_id": "frialdades", "book_id": "historia_medicinal_monardes_1574", "name": "frialdades", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["frialdades"], "contexts": ["coldness of the womb", "coldnesses"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "frialdade", "target_book": "historia_medicinal_monardes_1574", "target_name": "frialdades", "similarity": 0.954}], "id": 619, "stable_key": "clu_aeeca3c83020fa5b", "ground_truth": {"modern_name": "coldness", "confidence": "high", "type": "CONCEPT", "description": "A bodily quality or state associated with low temperature or lack of heat.", "note": "Refers to the humoral concept of coldness affecting the body.", "wikipedia_extract": "In statistical thermodynamics, thermodynamic beta, also known as coldness, is the reciprocal of the thermodynamic temperature of a system: {\\displaystyle \\beta \\equiv {\\frac {1}{k_{\\rm {B}}T}}} (where T is the temperature and kB is Boltzmann constant). Thermodynamic beta has units reciprocal to that of energy (in SI units, reciprocal joules, {\\displaystyle [\\beta ]={\\textrm {J}}^{-1}} ). In non-thermal units, it can also be measured in byte per joule, or more conveniently, gigabyte per nanojoule; 1 K−1 is equivalent to about 13,062 gigabytes per nanojoule; at room temperature: T = 300K, β ≈ 44 GB/nJ ≈ 39 eV−1 ≈ 2.4×1020 J−1. The conversion factor is 1 GB/nJ = Thermodynamic beta is essentially the connection between the information theory and statistical mechanics interpretation of a physical system through its entropy and the thermodynamics associated with its energy. It expresses the response of entropy to an increase in energy. If a small amount of energy is added to the system, then β describes the amount the system will randomize."}}, {"canonical_name": "fermento", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 48, "members": [{"entity_id": "fermento", "book_id": "polyanthea_medicinal", "name": "fermento", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 47, "variants": ["fermento", "Fermentação", "fermentatione", "fermentativo", "fermentaçao", "fermentação", "fermentações", "fermento diffolvente"], "contexts": ["ferment", "ingredient in caustic"]}, {"entity_id": "fermentation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "fermentation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fermentation"], "contexts": ["chemical breakdown by microorganisms"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "fermento", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fermentation", "similarity": 0.959}], "id": 620, "stable_key": "clu_62227539000735aa", "ground_truth": {"modern_name": "Fermentation", "confidence": "high", "type": "concept", "wikidata_id": "Q223101", "wikidata_description": "chemical compound", "wikipedia_extract": "Fermentation is a type of anaerobic metabolism that harnesses the redox potential of the reactants to make adenosine triphosphate (ATP) and organic end products. Organic molecules, such as glucose or other sugars, are catabolized and their electrons are transferred to other organic molecules (cofactors, coenzymes, etc.). Anaerobic glycolysis is a related term used to describe the occurrence of fermentation in organisms (usually multicellular organisms such as animals) when aerobic respiration cannot keep up with the ATP demand, due to insufficient oxygen supply or anaerobic conditions. Fermentation is important in several areas of human society. Humans have used fermentation in the production and preservation of food for 13,000 years. It has been associated with health benefits, unique flavor profiles, and making products have better texture."}}, {"canonical_name": "Gengivre", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 47, "members": [{"entity_id": "gengivre", "book_id": "coloquios_da_orta_1563", "name": "Gengivre", "category": "PLANT", "subcategory": "PLANT", "count": 26, "variants": ["Gengivre", "gengi^e", "gengibre", "gengibre beledi", "gengibre dely", "gengivre", "gengivre verde", "getigivre"], "contexts": ["plant used for medicine", "spice"]}, {"entity_id": "gengibre", "book_id": "polyanthea_medicinal", "name": "gengibre", "category": "PLANT", "subcategory": "PLANT", "count": 21, "variants": ["gengibre", "gengi", "gengi bre", "gengivre", "gingibre"], "contexts": ["ingredient in a wine remedy", "ginger used in collyrium"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Gengivre", "target_book": "polyanthea_medicinal", "target_name": "gengibre", "similarity": 0.881}], "id": 621, "stable_key": "clu_6ad956e058773e1a", "ground_truth": {"modern_name": "ginger", "confidence": "high", "type": "PLANT", "linnaean": "Zingiber officinale", "family": "Zingiberaceae", "description": "A spicy rhizome used in medicine, cooking, and as a spice.", "wikipedia_extract": "Ginger (Zingiber officinale) is a flowering plant whose rhizome, ginger root or ginger, is widely used as a spice and a folk medicine. It is an herbaceous perennial that grows annual pseudostems (false stems made of the rolled bases of leaves) about one meter tall, bearing narrow leaf blades. The inflorescences bear flowers having pale yellow petals with purple edges, and arise directly from the rhizome on separate shoots. Ginger is in the family Zingiberaceae, which also includes turmeric (Curcuma longa), cardamom (Elettaria cardamomum), and galangal. Ginger originated in Maritime Southeast Asia and was likely domesticated first by the Austronesian peoples. It was transported with them throughout the Indo-Pacific during the Austronesian expansion (c. 5,000 BP), reaching as far as Hawaii."}}, {"canonical_name": "Canafistula", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 47, "members": [{"entity_id": "canafistula", "book_id": "polyanthea_medicinal", "name": "Canafistula", "category": "PLANT", "subcategory": "PLANT", "count": 38, "variants": ["Canafistula", "Cana fistula", "Canafiftula", "Canaristula", "canafi", "canafiftula", "canafifula", "canafil tula", "canafistula", "canafistula freſca", "canafiſtu", "canafiſtula", "canasiſtula", "caſcasde canafiſtula"], "contexts": ["fresh cassia pulp", "plant used in remedies"]}, {"entity_id": "canafistola", "book_id": "coloquios_da_orta_1563", "name": "canafistola", "category": "PLANT", "subcategory": "PLANT", "count": 9, "variants": ["canafistola", "Canafistola", "canajistola", "canefistola", "canáfistola"], "contexts": ["fruit of the tree", "plant with medicinal pulp"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Canafistula", "target_book": "coloquios_da_orta_1563", "target_name": "canafistola", "similarity": 0.952}], "id": 622, "stable_key": "clu_6b605913393f3e39", "ground_truth": {"modern_name": "Cassia fistula", "confidence": "high", "type": "plant", "linnaean": "Cassia fistula", "family": "Fabaceae", "description": "A flowering plant whose pulp is used medicinally.", "wikipedia_extract": "Cassia fistula, also known as golden shower, purging cassia, Indian laburnum, kani konna, or pudding-pipe tree, is a flowering plant in the family Fabaceae. The species is native to the Indian subcontinent and adjacent regions of Southeast Asia. It is the official state flower of Kerala state and Delhi UT in India, as well as the national tree and flower of Thailand. It is also a popular ornamental plant and is also used in herbal medicine. Cassia fistula* is widely known by local names across the Indian subcontinent and other regions due to its prominent medicinal, cultural, and ornamental importance. The golden shower tree is a medium-sized tree, growing to 10–20 m (33–66 ft) tall with fast growth."}}, {"canonical_name": "Lungs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 46, "members": [{"entity_id": "lungs", "book_id": "english_physician_1652", "name": "Lungs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 44, "variants": ["lungs", "Lungs"], "contexts": ["body part treated by the herb", "organs of respiration"]}, {"entity_id": "pipes_and_passages_of_the_lungs", "book_id": "english_physician_1652", "name": "Pipes and passages of the Lungs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Pipes and passages of the Lungs"], "contexts": ["part of the respiratory system"]}, {"entity_id": "lungs", "book_id": "polyanthea_medicinal", "name": "Lungs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Lungs"], "contexts": ["organs of respiration"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Lungs", "target_book": "polyanthea_medicinal", "target_name": "Lungs", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Pipes and passages of the Lungs", "target_book": "polyanthea_medicinal", "target_name": "Lungs", "similarity": 0.868}], "id": 623, "stable_key": "clu_0cfdd29f14ee494e", "ground_truth": {"modern_name": "Lungs", "confidence": "high", "type": "anatomy", "description": "The primary organs of respiration in humans and other vertebrates.", "wikipedia_extract": "The lungs are the primary organs of the respiratory system in many animals, including humans. In mammals and most other tetrapods, two lungs are located near the backbone on either side of the heart. Their function in the respiratory system is to extract oxygen from the atmosphere and transfer it into the bloodstream, and to release carbon dioxide from the bloodstream into the atmosphere, in a process of gas exchange. Respiration is driven by different muscular systems in different species. Mammals, reptiles and birds use their musculoskeletal systems to support and foster breathing. In early tetrapods, air was driven into the lungs by the pharyngeal muscles via buccal pumping, a mechanism still seen in amphibians."}}, {"canonical_name": "Cordeal", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 46, "members": [{"entity_id": "cordeal", "book_id": "polyanthea_medicinal", "name": "Cordeal", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 42, "variants": ["Cordeal", "Cordeal Curviano", "Cordeal compoſto", "Cordeal doCurvo", "Cordeal folutivado", "Cordeal folutivo", "Cordeal simples", "Cordeal simplez", "Cordeal ſimplez", "cordeal"], "contexts": ["medicine for fevers", "a cordial medicine"]}, {"entity_id": "cordial", "book_id": "english_physician_1652", "name": "Cordial", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["Cordial", "Cordial Electuaries"], "contexts": ["use of conserved borrage flowers", "property of Rose preparations"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Cordeal", "target_book": "english_physician_1652", "target_name": "Cordial", "similarity": 0.857}], "id": 624, "stable_key": "clu_e1a3b303f9e662fb", "ground_truth": {"modern_name": "Cordial", "confidence": "high", "type": "preparation", "description": "A medicinal preparation believed to invigorate the heart and body.", "wikipedia_extract": "A cordial is any invigorating and stimulating preparation that is intended for a medicinal purpose. The term derives from an obsolete usage. Various concoctions were formerly created that were believed to be beneficial to one's health, especially for the heart (cor in Latin). Some cordials, with their flecks of gold leaf and bright yellow hue, took their name from the \"cordial virtues\" of the rays of the sun, which some alchemists thought they contained. Most cordials were of European origin, first produced in Italian apothecaries during the Renaissance, where the art of distilling was refined during the 15th and 16th centuries. It is from this origin that cordials are frequently referred to in French as Liqueurs d'ltalie, it is also from this that we have liqueurs."}}, {"canonical_name": "Portocabello", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 46, "members": [{"entity_id": "portocabello", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Portocabello", "category": "PLACE", "subcategory": "CITY", "count": 44, "variants": ["Portocabello", "PORTO-CABELLO", "Por'obelo", "Porlo-Cabello", "Porto-Cabello", "Porto-Cahello", "Portobello", "Portobelo", "Pprlo-Cabello"], "contexts": ["city linked astronomically", "location with a granitic mountain chain"]}, {"entity_id": "porto_cabello", "book_id": "kosmos_humboldt_1845", "name": "Porto Cabello", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Porto Cabello"], "contexts": ["city near Trincheras hot springs", "city in Venezuela"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Portocabello", "target_book": "kosmos_humboldt_1845", "target_name": "Porto Cabello", "similarity": 0.842}], "id": 625, "stable_key": "clu_266084074b01ee0a", "ground_truth": {"modern_name": "Puerto Cabello", "confidence": "high", "type": "place", "country": "Venezuela", "wikidata_id": "Q995695", "wikidata_description": "city in Venezuela", "wikipedia_url": "https://en.wikipedia.org/wiki/Puerto%20Cabello", "wikipedia_extract": "Puerto Cabello (Spanish pronunciation: [ˈpweɾto kaˈβeʝo] ) is a city on the north coast of Venezuela. It is located in Carabobo State, about 210 km west of Caracas. As of 2011, the city had a population of around 182,400. The city is home to the largest and busiest port in the country and is thus a vital cog in the country's vast oil industry. The word 'cabello' translates to 'hair'. The Spanish took to saying that the sea was so calm there that a ship could be moored to the dock with a single hair."}}, {"canonical_name": "Epilepticos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 45, "members": [{"entity_id": "epilepticos", "book_id": "polyanthea_medicinal", "name": "Epilepticos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 43, "variants": ["Epilepticos", "Epilepf.", "Epilepfia", "Epilepfias", "Epileps.", "Epilepsia", "Epilepsias", "Epileptic", "Epiles.", "epilep.", "epilepfia", "epilepfiam", "epilepsia", "epilepsias", "epilepsy", "epilepti cos", "epileptico", "epilepticos", "epilepticose"], "contexts": ["suffering from epilepsy", "epilepsy treated by stibium"]}, {"entity_id": "epileptic", "book_id": "principles_of_psychology_james_1890", "name": "epileptic", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["epileptic"], "contexts": ["man with chronic condition", "potential element in the case"]}], "edges": [], "id": 626, "stable_key": "clu_999492a09a986c66", "ground_truth": {"modern_name": "Epilepsy", "confidence": "high", "type": "disease", "modern_term": "Epilepsy", "wikidata_id": "Q41571", "wikidata_description": "human neurological disease causing seizures", "wikipedia_url": "https://en.wikipedia.org/wiki/Epilepsy", "wikipedia_extract": "Epilepsy is a group of neurological disorders characterized by a tendency for recurrent, unprovoked seizures. A seizure is a sudden burst of abnormal electrical activity in the brain that can cause a variety of symptoms, ranging from brief lapses of awareness or muscle jerks to prolonged convulsions. These episodes can result in physical injuries, either directly, such as broken bones, or through causing accidents. The diagnosis of epilepsy typically requires at least two unprovoked seizures occurring more than 24 hours apart. In some cases, however, it may be diagnosed after a single unprovoked seizure if clinical evidence suggests a high risk of recurrence. Isolated seizures that occur without recurrence risk or are provoked by identifiable causes are not considered indicative of epilepsy."}}, {"canonical_name": "nariz", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 45, "members": [{"entity_id": "nariz", "book_id": "polyanthea_medicinal", "name": "nariz", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 44, "variants": ["nariz", "NARIS", "naris", "narize", "narizes"], "contexts": ["where flesh excrescences grow", "body part affected by spots"]}, {"entity_id": "narizes", "book_id": "historia_medicinal_monardes_1574", "name": "narizes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["narizes"], "contexts": ["nostrils"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "nariz", "target_book": "historia_medicinal_monardes_1574", "target_name": "narizes", "similarity": 0.969}], "id": 627, "stable_key": "clu_aac140cfec0a47d0", "ground_truth": {"modern_name": "Nose", "confidence": "high", "type": "anatomy", "description": "The part of the face used for smelling and breathing.", "wikipedia_extract": "A nose is a sensory organ and respiratory structure in vertebrates. It consists of a nasal cavity inside the head, and an external nose on the face. The external nose houses the nostrils, or nares, a pair of tubes providing airflow through the nose for respiration. Where the nostrils pass through the nasal cavity they widen, are known as nasal fossae, and contain turbinates and olfactory mucosa. The nasal cavity also connects to the paranasal sinuses (dead-end air cavities for pressure buffering and humidification). From the nasal cavity, the nostrils continue into the pharynx, a switch track valve connecting the respiratory and digestive systems."}}, {"canonical_name": "caſtoreo", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 45, "members": [{"entity_id": "caſtoreo", "book_id": "polyanthea_medicinal", "name": "caſtoreo", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 44, "variants": ["caſtoreo", "Cafto", "Caftoreo", "Castore", "Castoreo", "Caſtoreo", "caftoreo", "castoreo", "castoreohum"], "contexts": ["ingredient in a remedy", "specific remedy ingredient"]}, {"entity_id": "castoreo", "book_id": "coloquios_da_orta_1563", "name": "castoreo", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["castoreo"], "contexts": ["castoreum, an ingredient"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "caſtoreo", "target_book": "coloquios_da_orta_1563", "target_name": "castoreo", "similarity": 0.855}], "id": 628, "stable_key": "clu_ebe2ee297993628d", "ground_truth": {"modern_name": "Castoreum", "confidence": "high", "type": "animal", "family": "Castoridae", "description": "A secretion from beaver glands used as medicine and perfume.", "wikipedia_extract": "Castoreum  is a yellowish exudate from the castor sacs of mature beavers used in combination with urine to scent mark their territory. Both beaver sexes have a pair of castor sacs and a pair of anal glands, located in two cavities under the skin between the pelvis and the base of the tail. The castor sacs are not true glands (endocrine or exocrine) on a cellular level, hence references to these structures as preputial glands, castor glands, or scent glands are misnomers. It is extracted with alcohol from the dried and crushed castor sacs for use as a tincture in some perfumes and, rarely, as a food additive. At least 24 compounds are known constituents of beaver castoreum. Several of these have pheromonal activity, of which the phenols 4-ethylphenol and catechol and the ketones acetophenone and 3-hydroxyacetophenone are strongest."}}, {"canonical_name": "betonica", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 44, "members": [{"entity_id": "betonica", "book_id": "polyanthea_medicinal", "name": "betonica", "category": "PLANT", "subcategory": "PLANT", "count": 40, "variants": ["betonica", "Betonica"], "contexts": ["herb used in preparation", "herb used in fomentation"]}, {"entity_id": "betony", "book_id": "english_physician_1652", "name": "Betony", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["Betony"], "contexts": ["herb used for various ailments and preparations", "little inferior to betony"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "betonica", "target_book": "english_physician_1652", "target_name": "Betony", "similarity": 0.924}], "id": 629, "stable_key": "clu_b5b335da2a10e694", "ground_truth": {"modern_name": "Betony", "confidence": "high", "type": "plant", "linnaean": "Stachys officinalis", "family": "Lamiaceae", "description": "A herb with traditional medicinal uses.", "wikipedia_extract": "Betonica officinalis, common name betony is a species of flowering plant in the mint family Lamiaceae, native to Europe, western Asia, and northern Africa. Other vernacular names include wood betony, common hedgenettle, purple betony, bishopwort, or bishop's wort. It was until recently usually included in the genus Stachys as its synonym Stachys officinalis, but Betonica was separated at genus rank from Stachys when a detailed examination showed clear consistent differences in both the foliage and flowers, valid at a higher rank than the previous treatment as just a subgenus. This has been confirmed by genetic study, which shows Betonica is separate from Stachys and more closely related to the hemp-nettles Galeopsis. The Latin specific epithet officinalis refers to plants which had a culinary or medicinal use. Betonica officinalis is a rhizotomous, patch-forming, grassland herbaceous perennial growing to 30–60 cm (12–24 in) tall."}}, {"canonical_name": "Hypocondriacos", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 44, "members": [{"entity_id": "hypocondriacos", "book_id": "polyanthea_medicinal", "name": "Hypocondriacos", "category": "DISEASE", "subcategory": "CHRONIC", "count": 42, "variants": ["Hypocondriacos", "Hypo", "HypoCArarata", "Hypocondriac", "Hypocondriaca", "Hypocondriacas", "Hyppocondriacos", "affectos hypocondriacos", "hypocondria", "hypocondriaca", "hypocondriacas", "hypocondriacos", "ventofidades hypocondriacas", "ventosidades hypocondriacas", "ventoſidades hypocondriacas"], "contexts": ["patients with hypochondria", "people suffering from hypochondria"]}, {"entity_id": "hypocondriacal_passion", "book_id": "english_physician_1652", "name": "Hypocondriacal Passion", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["Hypocondriacal Passion"], "contexts": ["disease arising from organ obstruction"]}, {"entity_id": "hypochondria", "book_id": "english_physician_1652", "name": "Hypochondria", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["Hypochondria"], "contexts": ["disease listed with numbers"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Hypocondriacos", "target_book": "english_physician_1652", "target_name": "Hypocondriacal Passion", "similarity": 0.859}, {"source_book": "polyanthea_medicinal", "source_name": "Hypocondriacos", "target_book": "english_physician_1652", "target_name": "Hypochondria", "similarity": 0.938}], "id": 630, "stable_key": "clu_67f7fe1a7570527b", "ground_truth": {"modern_name": "Hypochondria", "confidence": "high", "type": "disease", "description": "A chronic condition characterized by excessive anxiety about one's health.", "wikipedia_extract": "Hypochondriasis or hypochondria is a condition in which a person is excessively and unduly worried about having a serious illness. Hypochondria is an old concept whose meaning has repeatedly changed over its lifespan. It has been claimed that this debilitating condition results from an inaccurate perception of the condition of body or mind despite the absence of an actual medical diagnosis. An individual with hypochondriasis is known as a hypochondriac. Hypochondriacs become unduly alarmed about any physical or psychological symptoms they detect, no matter how minor the symptom may be, and are convinced that they have, or are about to be diagnosed with, a serious illness. Often, hypochondria persists even after a physician has evaluated a person and reassured them that their concerns about symptoms do not have an underlying medical basis or, if there is a medical illness, their concerns are far in excess of what is appropriate for the level of disease."}}, {"canonical_name": "arábio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 44, "members": [{"entity_id": "arábio", "book_id": "coloquios_da_orta_1563", "name": "arábio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 43, "variants": ["arábio", "ABC arábio", "Arabice", "Arabitmo", "Arábio", "aarabico", "arábica", "arábico", "arábigo"], "contexts": ["language", "language where 'saibo' means lord"]}, {"entity_id": "araméen", "book_id": "relation_historique_humboldt_vol3_1825", "name": "araméen", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["araméen"], "contexts": ["Aramaic language"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "arábio", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "araméen", "similarity": 0.86}], "id": 631, "stable_key": "clu_0ff14f88f1ed9161", "ground_truth": {"modern_name": "Aramaic", "confidence": "high", "type": "concept", "description": "An ancient Semitic language spoken in parts of the Middle East.", "wikipedia_extract": "Aramaic (Jewish Babylonian Aramaic: ארמית, romanized: ˀərāmiṯ; Classical Syriac: ܐܪܡܐܝܬ, romanized: arāmāˀiṯ) is a Northwest Semitic language that originated in the ancient region of Syria and quickly spread to Mesopotamia, the southern Levant, Sinai, southeastern Anatolia, the Caucasus, and Eastern Arabia, where it has been continually written and spoken in different varieties for over 3,000 years. Aramaic served as a language of public life and administration of ancient kingdoms and empires—particularly the Neo-Assyrian Empire, Neo-Babylonian Empire, and Achaemenid Empire—and as a language of divine worship and religious study within Judaism, Christianity, and Gnosticism. Several modern varieties of Aramaic are still spoken. The modern eastern branch is spoken by Assyrians, Mandeans, and Mizrahi Jews. Western Aramaic is still spoken by the Muslim and Christian Arameans (Syriacs) in the towns of Maaloula, Bakh'a and Jubb'adin in Syria. Classical varieties are used as liturgical and literary languages in several West Asian churches, as well as in Judaism, Samaritanism, and Mandaeism."}}, {"canonical_name": "Marco Polo", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 44, "members": [{"entity_id": "marco_polo", "book_id": "coloquios_da_orta_1563", "name": "Marco Polo", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 43, "variants": ["Marco Polo"], "contexts": ["gave exact news on amber extraction", "author of 'Marco Polo'"]}, {"entity_id": "marco_polo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Marco Polo", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Marco Polo"], "contexts": ["narrator of riches of India and Asia"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Marco Polo", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Marco Polo", "similarity": 1.0}], "id": 632, "stable_key": "clu_25f0beb7df74636d", "ground_truth": {"modern_name": "Marco Polo", "confidence": "high", "type": "person", "description": "Venetian merchant and explorer known for his travels to Asia.", "wikipedia_extract": "Marco Polo (c. 1254 –  8 January 1324) was a Venetian merchant, explorer, and writer who travelled through Asia along the Silk Road between 1271 and 1295. His travels are recorded in The Travels of Marco Polo (also known as Book of the Marvels of the World  and Il Milione, c. 1300), a book that described the then-mysterious culture and inner workings of the Eastern world, including the wealth and great size of the Mongol Empire and China under the Yuan dynasty, giving Europeans their first comprehensive look into China, Persia, India, Japan, and other Asian societies. Born in Venice, Marco learned the mercantile trade from his father and his uncle, Niccolò and Maffeo, who travelled through Asia and met Kublai Khan. In 1269, they returned to Venice to meet Marco for the first time. The three of them embarked on an epic journey to Asia, exploring many places along the Silk Road until they reached \"Cathay\". They were received by the royal court of Kublai Khan, who was impressed by Marco's intelligence and humility."}}, {"canonical_name": "Zacutus", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 44, "members": [{"entity_id": "zacutus", "book_id": "polyanthea_medicinal", "name": "Zacutus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 42, "variants": ["Zacutus", "Zacut", "Zacut.", "Zacutus Lufitan", "Zacutus Lujitan."], "contexts": ["cited author on cauterization for head pain", "author of De Medicorum Principum Historia"]}, {"entity_id": "zaleucus", "book_id": "kosmos_humboldt_1845", "name": "Zaleucus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Zaleucus"], "contexts": ["legislator of Leucris"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Zacutus", "target_book": "kosmos_humboldt_1845", "target_name": "Zaleucus", "similarity": 0.885}], "id": 633, "stable_key": "clu_1ad9f5e9e83453eb", "ground_truth": {"modern_name": "Zacutus Lusitanus", "confidence": "high", "type": "person", "birth_year": 1559, "death_year": 1618, "description": "Portuguese physician and author of medical texts", "note": "While 'Zaleucus' is mentioned, context of medical texts points to Zacutus Lusitanus. Zaleucus was an ancient Greek legislator.", "wikidata_id": "Q139985", "wikidata_description": "Portuguese medical historian (1575–1642)", "wikipedia_url": "https://en.wikipedia.org/wiki/Abraham_Zacutus_Lusitanus", "wikipedia_extract": "Jews had lived in the Iberian Peninsula since the Ancient Age, experiencing a Golden Age under Muslim rule. Following the Reconquista and increasing persecution, many of them were expelled from Spain in 1492 and Portugal in 1497. Some of their descendants, known as the Sephardim, settled mainly in North Africa, South-East Europe, the Netherlands, England, and America. Jews were only formally readmitted to the peninsula in the late 19th century. The modern Jewish Iberian population is based on post-war immigration and numbers around 14,000. The following is a list of prominent Iberian Jews arranged by country of origin: Abraham Aboab Falero (?"}}, {"canonical_name": "cauterio", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 44, "members": [{"entity_id": "cauterio", "book_id": "polyanthea_medicinal", "name": "cauterio", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 43, "variants": ["cauterio", "cauteriis", "cauterijs", "cauterio actuali", "cauterios", "cauteriums", "cauterizando", "cauterizar", "cauterizaremos", "cauterization", "cauterizemos", "cauterizão"], "contexts": ["device for burning tissue", "medical instrument"]}, {"entity_id": "cauterico", "book_id": "historia_medicinal_monardes_1574", "name": "cauterico", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["cauterico"], "contexts": ["practice of burning or cauterizing"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "cauterio", "target_book": "historia_medicinal_monardes_1574", "target_name": "cauterico", "similarity": 0.924}], "id": 634, "stable_key": "clu_e0755b12f6acfc73", "ground_truth": {"modern_name": "Cauterization", "confidence": "high", "type": "concept", "description": "Medical practice of burning tissue to stop bleeding or treat disease.", "wikipedia_extract": "Cauterization (or cauterisation, or cautery) is a medical practice or technique of burning a part of a body to remove or close off a part of it. It destroys some tissue in an attempt to mitigate bleeding and damage, remove an undesired growth, or minimize other potential medical harm, such as infections when antibiotics are unavailable. The practice was once a widespread wound treatment. Its utility before the advent of antibiotics was said to be effective at more than one level: Cautery was historically believed to prevent infection, but current research shows that cautery actually increases the risk of infection by causing more tissue damage and providing a more hospitable environment for bacterial growth. Actual cautery refers to the metal device, generally heated to a dull red glow, that a physician applies to produce blisters, to stop bleeding of a blood vessel, and for other similar purposes. The main forms of cauterization used today are electrocautery and chemical cautery—both are, for example, prevalent in cosmetic removal of warts and stopping nosebleeds."}}, {"canonical_name": "palpitações do coraçao", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 44, "members": [{"entity_id": "palpitações_do_coraçao", "book_id": "polyanthea_medicinal", "name": "palpitações do coraçao", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 43, "variants": ["palpitações do coraçao", "Palpitatio cordis", "Palpitation.cordis", "Palpitatione cordis", "Palpitationecordis", "Palpitaçao", "Palpitaçoens do coraçao", "Palpitaçãodocoraçao", "palpitaçoens do coraçao", "palpitações", "palpitações do coração", "palpitações docoraçao", "palpitaçõesdo coraçao"], "contexts": ["heart palpitations", "heart palpitations as a symptom of poison"]}, {"entity_id": "temblores_de_coraçon", "book_id": "coloquios_da_orta_1563", "name": "temblores de coraçon", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["temblores de coraçon"], "contexts": ["heart tremors"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "palpitações do coraçao", "target_book": "coloquios_da_orta_1563", "target_name": "temblores de coraçon", "similarity": 0.86}], "id": 635, "stable_key": "clu_3664384ad81ea3b6", "ground_truth": {"modern_name": "Heart Palpitations", "confidence": "high", "type": "disease", "description": "Sensation of the heart beating too hard, too fast, or irregularly.", "wikipedia_extract": "Palpitations occur when a person becomes aware of their heartbeat. The heartbeat may feel hard, fast, or uneven in their chest. Symptoms include a very fast or irregular heartbeat. Palpitations are a sensory symptom. They are often described as a skipped beat, a rapid flutter, or a pounding in the chest or neck. Palpitations are not always the result of a physical problem with the heart and can be linked to anxiety."}}, {"canonical_name": "remedios", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 43, "members": [{"entity_id": "remedios", "book_id": "polyanthea_medicinal", "name": "remedios", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 41, "variants": ["remedios", "remedios compoftos", "remedios eficazes", "remedios fortes", "remedios ordinarios", "remedium", "remédios"], "contexts": ["Medicines derived from leaves", "medicines"]}, {"entity_id": "remédios", "book_id": "coloquios_da_orta_1563", "name": "remédios", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["remédios", "remedio"], "contexts": ["medicinal treatments", "medicine"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "remedios", "target_book": "coloquios_da_orta_1563", "target_name": "remédios", "similarity": 0.913}], "id": 636, "stable_key": "clu_8955b4220081e5a8", "ground_truth": {"modern_name": "Medicines", "confidence": "high", "type": "concept", "description": "Substances used for therapeutic purposes to treat illness or disease.", "wikipedia_extract": "Medication (also called medicament, medicine, pharmaceutical drug, medicinal product, medicinal drug, or simply drug) is a drug used to diagnose, cure, treat, or prevent disease. Drug therapy (pharmacotherapy) is an important part of the medical field and relies on the science of pharmacology for continual advancement and on pharmacy for appropriate management. Drugs are classified in many ways. One of the key divisions is by level of control, which distinguishes prescription drugs (those that a pharmacist dispenses only on the medical prescription) from over-the-counter drugs (those that consumers can order for themselves). Medicines may be classified by mode of action, route of administration, biological system affected, or therapeutic effects. The World Health Organization keeps a list of essential medicines."}}, {"canonical_name": "mirabolanos citrinos", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 43, "members": [{"entity_id": "mirabolanos_citrinos", "book_id": "polyanthea_medicinal", "name": "mirabolanos citrinos", "category": "PLANT", "subcategory": "PLANT", "count": 32, "variants": ["mirabolanos citrinos", "Mirabolanos", "Mirabolanos Quebulos", "Mirabolanos citrinos", "Mirobalanos citrinos", "Myrabolanos citrinos", "cascas de mirabolanos citrinos", "mirabola", "mirabolanos", "mirabolanos chebulos", "mirobalanos chebulos", "mirobalanos citrinos", "myrobalanos citrinos"], "contexts": ["herb for purgation", "ingredient in decoction"]}, {"entity_id": "mirabolanos", "book_id": "coloquios_da_orta_1563", "name": "Mirabolanos", "category": "PLANT", "subcategory": "PLANT", "count": 11, "variants": ["Mirabolanos", "MIRABOLANOS", "MiRABOLANOS", "mirabolano", "mirabolanos", "mirabolanos indos", "mirabolanos verdes", "mirabulanos"], "contexts": ["fruits praised by Greeks and Arabs", "fruit used in medicine"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "mirabolanos citrinos", "target_book": "coloquios_da_orta_1563", "target_name": "Mirabolanos", "similarity": 0.819}], "id": 637, "stable_key": "clu_7883093ae5f143a1", "ground_truth": {"modern_name": "Citrine Myrobalans", "confidence": "high", "type": "plant", "description": "A medicinal fruit from the Terminalia species, used as a purgative.", "note": "Likely refers to species within the genus Terminalia, specifically those with yellow fruit.", "wikipedia_extract": "Terminalia chebula, commonly known as black- or chebulic myrobalan, is a species of Terminalia, native to South Asia from Pakistan, India and Nepal east to southwest China (Yunnan), and south to Sri Lanka, Malaysia, and Vietnam. Swedish naturalist Anders Jahan Retzius described the species in Observ. Bot. 5: 31 in 1788. T. c. var. chebula – leaves and shoots hairless, or only hairy when very young T. c. var. tomentella  – leaves and shoots silvery to orange hairy Terminalia chebula is a medium to large deciduous tree growing to 30 m (98 ft) tall, with a trunk up to 1 m (3 ft 3 in) in diameter. The leaves are alternate to subopposite in arrangement, oval, 7–8 cm (2.8–3.1 in) long and 4.5–10 cm (1.8–3.9 in) broad with a 1–3 cm (0.39–1.18 in) petiole. They have an acute tip, cordate at the base, margins entire, glabrous above with a yellowish pubescence below."}}, {"canonical_name": "Rio Janeiro", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 43, "members": [{"entity_id": "rio_janeiro", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rio Janeiro", "category": "PLACE", "subcategory": "CITY", "count": 42, "variants": ["Rio Janeiro", "Rio-Janeiro", "Rio-Jaueiro"], "contexts": ["city where decrees were issued", "port that received slaves"]}, {"entity_id": "rio_de_janeiro", "book_id": "coloquios_da_orta_1563", "name": "Rio de Janeiro", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Rio de Janeiro"], "contexts": ["location of astronomical observation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rio Janeiro", "target_book": "coloquios_da_orta_1563", "target_name": "Rio de Janeiro", "similarity": 0.972}], "id": 638, "stable_key": "clu_e86258d958c3f0d2", "ground_truth": {"modern_name": "Rio de Janeiro", "confidence": "high", "type": "place", "description": "A major city and port in Brazil, formerly the capital.", "wikipedia_extract": "Rio de Janeiro, also known simply as Rio, is the capital of the state of Rio de Janeiro. It is the second-most-populous city in Brazil after São Paulo and the sixth-most-populous city in the Americas. Founded in 1565, the city was initially the seat of the Captaincy of Rio de Janeiro, a domain of the Portuguese Empire. In 1763, it became the capital of the State of Brazil. In 1808, when the Portuguese Royal Court moved to Brazil, Rio de Janeiro became the seat of the court of Queen Maria I of Portugal. Under the leadership of her son, prince regent John of Braganza, Maria raised Brazil to the dignity of a kingdom within the United Kingdom of Portugal, Brazil, and Algarves."}}, {"canonical_name": "moon", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 43, "members": [{"entity_id": "moon", "book_id": "kosmos_humboldt_1845", "name": "moon", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 35, "variants": ["moon", "Moon"], "contexts": ["celestial body with volcanic traces", "natural satellite of Earth"]}, {"entity_id": "moon", "book_id": "first_principles_spencer_1862", "name": "Moon", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["Moon", "moon"], "contexts": ["Earth's natural satellite", "celestial body with monthly cycle"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "moon", "target_book": "first_principles_spencer_1862", "target_name": "Moon", "similarity": 0.983}], "id": 639, "stable_key": "clu_7dee111fff33372b", "ground_truth": {"modern_name": "Moon", "confidence": "high", "type": "place", "country": "N/A"}}, {"canonical_name": "Empyema", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 43, "members": [{"entity_id": "empyema", "book_id": "polyanthea_medicinal", "name": "Empyema", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 42, "variants": ["Empyema", "Emphylema", "Emphysema", "Emphytema", "Emphyſema", "Empiema", "Empiematicos", "Empyema thoracis", "Empyemate", "Empyematicos", "Empyematipor", "Empyhsema", "empyemas", "empyematico"], "contexts": ["medical condition", "disease caused by purulent matter"]}, {"entity_id": "empeynes", "book_id": "historia_medicinal_monardes_1574", "name": "Empeynes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Empeynes"], "contexts": ["skin condition on the head"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Empyema", "target_book": "historia_medicinal_monardes_1574", "target_name": "Empeynes", "similarity": 0.844}], "id": 640, "stable_key": "clu_40df65c37ad25631", "ground_truth": {"modern_name": "Empyema", "confidence": "high", "type": "disease", "description": "Accumulation of pus within a natural body cavity, typically the pleural space.", "wikipedia_extract": "An empyema (; from Ancient Greek  ἐμπύημα (empúēma) 'abscess') is a collection or gathering of pus within a naturally existing anatomical cavity. The term is most commonly used to refer to pleural empyema, which is empyema of the pleural cavity. It is similar to or the same as abscess in meaning, but the context of use may sometimes be different. For instance, an appendicular empyema is in medicine now generally called an abscess. Empyema most commonly occurs as a complication of pneumonia but can also result from other infections or conditions that lead to the collection of infected fluid in a body cavity. the pleural cavity (pleural empyema also known as pyothorax) Chest X-rays or computed tomography (CT) scans can reveal the presence of fluid within the pleural space and help assess its characteristics. Once a fluid-filled cavity has been identified, it is often partially or fully drained with a needle, so that the fluid may be analyzed."}}, {"canonical_name": "lambedor violado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 43, "members": [{"entity_id": "lambedor_violado", "book_id": "polyanthea_medicinal", "name": "lambedor violado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 42, "variants": ["lambedor violado", "Lambedor", "Lambedor fingular", "lambedor", "lambedor de camoezes", "lambedor de dormideyras", "lambedor de murtinhos", "lambedor de papoulas", "lambedor de vio", "lambedor de violas", "lambedordeavenca", "lambedordepapoulas", "lambedores"], "contexts": ["a medicinal preparation", "preparation used as medicine"]}, {"entity_id": "lambedor", "book_id": "coloquios_da_orta_1563", "name": "lambedor", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["lambedor"], "contexts": ["type of medicine administered"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "lambedor violado", "target_book": "coloquios_da_orta_1563", "target_name": "lambedor", "similarity": 0.84}], "id": 641, "stable_key": "clu_4f53c43d8d5946b3", "ground_truth": {"modern_name": "Lambedor violado", "confidence": "high", "type": "SUBSTANCE", "description": "A medicinal preparation, likely a type of syrup or cordial.", "note": "The term refers to a specific preparation from early modern Portuguese texts."}}, {"canonical_name": "Syrup", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 42, "members": [{"entity_id": "syrup", "book_id": "english_physician_1652", "name": "Syrup", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 38, "variants": ["Syrup", "Syrups"], "contexts": ["used for gout", "preparation made from Angelica stalks"]}, {"entity_id": "syrupo", "book_id": "polyanthea_medicinal", "name": "Syrupo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["Syrupo", "Syrupus", "syrup", "syrupodepa"], "contexts": ["syrup preparation", "sweet liquid preparation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Syrup", "target_book": "polyanthea_medicinal", "target_name": "Syrupo", "similarity": 0.83}], "id": 642, "stable_key": "clu_83624883b800ee1e", "ground_truth": {"modern_name": "Syrup", "confidence": "high", "type": "SUBSTANCE", "description": "A sweet liquid preparation, often medicinal, made by dissolving sugar.", "wikipedia_extract": "In cooking, syrup (less commonly sirup; from Latin: sirupus, from earlier Arabic: شراب; sharāb, beverage, wine) is a thick, viscous, liquid condiment consisting primarily of a solution of sugar in water. It typically contains a large amount of dissolved sugars but shows little tendency to deposit crystals. In its concentrated form, its consistency is similar to that of molasses. The viscosity arises from the multiple hydrogen bonds between the dissolved sugar, which has many hydroxyl (OH) groups. There are a range of syrups used in food production, including: Golden syrup, a by-product of refining crystallized sugar High fructose corn syrup, widely used in the US A variety of beverages call for sweetening to offset the tartness of some juices used in the drink recipes. Granulated sugar does not dissolve easily in cold drinks or ethyl alcohol."}}, {"canonical_name": "alforvas", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 41, "members": [{"entity_id": "alforvas", "book_id": "polyanthea_medicinal", "name": "alforvas", "category": "PLANT", "subcategory": "PLANT", "count": 39, "variants": ["alforvas", "alfavaca", "alforfas"], "contexts": ["emollient remedy ingredient", "herb for eye fomentation"]}, {"entity_id": "alfoluas", "book_id": "coloquios_da_orta_1563", "name": "alfoluas", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["alfoluas"], "contexts": ["plant similar to cardamomo majytr"]}, {"entity_id": "alaf", "book_id": "coloquios_da_orta_1563", "name": "alaf", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["alaf"], "contexts": ["name for the plant in Persia"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "alforvas", "target_book": "coloquios_da_orta_1563", "target_name": "alfoluas", "similarity": 0.889}, {"source_book": "polyanthea_medicinal", "source_name": "alforvas", "target_book": "coloquios_da_orta_1563", "target_name": "alaf", "similarity": 0.855}], "id": 643, "stable_key": "clu_97c3531595e23e10", "ground_truth": {"modern_name": "Alforvas", "confidence": "high", "type": "PLANT", "description": "An emollient herb used in traditional medicine, also known by other names.", "note": "Refers to the plant 'alforvas', 'alfoluas', and 'alaf'.", "wikipedia_extract": "Fenugreek (; Trigonella foenum-graecum) is an annual plant in the family Fabaceae, with leaves consisting of three small obovate to oblong leaflets. It is cultivated worldwide as a semiarid crop. Its leaves and seeds are common ingredients in dishes from the Indian subcontinent, and have been used as a culinary ingredient since ancient times. Its use as a food ingredient in small quantities is safe. Although a common dietary supplement, no significant clinical evidence suggests that fenugreek has therapeutic properties. Commonly used in traditional medicine, fenugreek can increase the risk of serious adverse effects, including allergic reactions."}}, {"canonical_name": "Falling-sickness", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 40, "members": [{"entity_id": "falling-sickness", "book_id": "english_physician_1652", "name": "Falling-sickness", "category": "DISEASE", "subcategory": "CHRONIC", "count": 38, "variants": ["Falling-sickness", "Fall", "Falling Sicknes", "Falling sicknes", "Falling sickness", "Falling-Sickness", "Fal∣ling-sickness", "falling-sickness"], "contexts": ["epilepsy", "neurological condition treated by Briony"]}, {"entity_id": "falling_sickness", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Falling sickness", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["Falling sickness"], "contexts": ["epilepsy"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Falling-sickness", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Falling sickness", "similarity": 0.974}], "id": 644, "stable_key": "clu_f567c13cf326623b", "ground_truth": {"modern_name": "Epilepsy", "confidence": "high", "type": "disease", "modern_term": "Epilepsy", "wikidata_id": "Q41571", "wikidata_description": "human neurological disease causing seizures", "wikipedia_extract": "Epilepsy is a group of neurological disorders characterized by a tendency for recurrent, unprovoked seizures. A seizure is a sudden burst of abnormal electrical activity in the brain that can cause a variety of symptoms, ranging from brief lapses of awareness or muscle jerks to prolonged convulsions. These episodes can result in physical injuries, either directly, such as broken bones, or through causing accidents. The diagnosis of epilepsy typically requires at least two unprovoked seizures occurring more than 24 hours apart. In some cases, however, it may be diagnosed after a single unprovoked seizure if clinical evidence suggests a high risk of recurrence. Isolated seizures that occur without recurrence risk or are provoked by identifiable causes are not considered indicative of epilepsy."}}, {"canonical_name": "aloés", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 40, "members": [{"entity_id": "aloés", "book_id": "coloquios_da_orta_1563", "name": "aloés", "category": "PLANT", "subcategory": "PLANT", "count": 35, "variants": ["aloés", "Aloe", "Aloés", "aloa", "aloes", "aloés (páo de)", "aloés çocoloríno"], "contexts": ["plant name", "plant substance, also called aloa"]}, {"entity_id": "aloe", "book_id": "polyanthea_medicinal", "name": "Aloe", "category": "PLANT", "subcategory": "PLANT", "count": 5, "variants": ["Aloe", "aloe", "aloé"], "contexts": ["herb used for purging", "ingredient in a purgative"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "aloés", "target_book": "polyanthea_medicinal", "target_name": "Aloe", "similarity": 0.846}], "id": 645, "stable_key": "clu_73b5a0df777bf274", "ground_truth": {"modern_name": "Aloes", "confidence": "high", "type": "PLANT", "description": "A genus of succulent plants, known for their medicinal properties.", "note": "Refers to the plant genus 'Aloe' and its derivatives like 'aloés'.", "wikipedia_extract": "Agarwood, aloeswood, eaglewood, gaharuwood, commonly referred to as oud or oudh (from Arabic: عود, romanized: ʿūd, pronounced [ʕuːd]), is a fragrant, dark and resinous wood used in incense, perfume, and small hand carvings. It forms in the heartwood of Aquilaria trees after they become infected with a type of Phaeoacremonium mold, P. parasitica. The tree defensively secretes a resin to combat the fungal infestation. Prior to becoming infected, the heartwood mostly lacks scent, and is relatively light and pale in colouration. However, as the infection advances and the tree produces its fragrant resin as a final option of defense, the heartwood becomes very dense, dark, and saturated with resin. This product is harvested, and most famously referred to in cosmetics under the scent names of oud, oodh or aguru; however, it is also called aloes (not to be confused with the succulent plant genus Aloe), agar (this name, as well, is not to be confused with the edible, algae-derived thickening agent agar agar), as well as gaharu or jinko."}}, {"canonical_name": "Chymicos", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 39, "members": [{"entity_id": "chymicos", "book_id": "polyanthea_medicinal", "name": "Chymicos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 37, "variants": ["Chymicos"], "contexts": ["Relating to alchemy or chemistry", "alchemical"]}, {"entity_id": "chemist", "book_id": "principles_of_psychology_james_1890", "name": "chemist", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["chemist"], "contexts": ["practitioner of chemistry"]}, {"entity_id": "authores_chymicos", "book_id": "polyanthea_medicinal", "name": "Authores Chymicos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Authores Chymicos"], "contexts": ["authors of chemical medicine"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Chymicos", "target_book": "principles_of_psychology_james_1890", "target_name": "chemist", "similarity": 0.924}, {"source_book": "principles_of_psychology_james_1890", "source_name": "chemist", "target_book": "polyanthea_medicinal", "target_name": "Authores Chymicos", "similarity": 0.838}], "id": 646, "stable_key": "clu_ac7f00fa4f39d63a", "ground_truth": {"modern_name": "Chemist", "confidence": "high", "type": "person", "description": "A practitioner of alchemy or chemistry.", "note": "Refers to practitioners of early chemistry or alchemy.", "wikipedia_extract": "A chemist (from Greek chēm(ía) alchemy; replacing chymist from Medieval Latin alchemist) is a graduated scientist trained in the study of chemistry, or an officially enrolled student in the field. Chemists study the composition of matter and its properties. Chemists carefully describe the properties they study in terms of quantities, with detail on the level of molecules and their component atoms. Chemists carefully measure substance proportions, chemical reaction rates, and other chemical properties. In Commonwealth English, pharmacists are often called chemists. Chemists use their knowledge to learn the composition and properties of unfamiliar substances, as well as to reproduce and synthesize large quantities of useful naturally occurring substances and create new artificial substances and useful processes."}}, {"canonical_name": "Venus", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 39, "members": [{"entity_id": "venus", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Venus", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 24, "variants": ["Venus"], "contexts": ["planet observed during transit", "planet with retrograde apsides"]}, {"entity_id": "venus", "book_id": "kosmos_humboldt_1845", "name": "Venus", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 15, "variants": ["Venus"], "contexts": ["inner planetary group member", "a planet"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Venus", "target_book": "kosmos_humboldt_1845", "target_name": "Venus", "similarity": 1.0}], "id": 647, "stable_key": "clu_da049e0ab22c08a7", "ground_truth": {"modern_name": "Venus", "confidence": "high", "type": "object", "wikipedia_extract": "Venus is the second planet from the Sun. It is often called Earth's \"twin\" or \"sister\" among the planets of the Solar System for its orbit being the closest to Earth's, both being terrestrial planets, and having the most similar and nearly equal size, mass, and surface gravity. Venus, though, is significantly different, especially as it has no liquid water, and its atmosphere is far thicker and denser than that of any other rocky body in the Solar System. The atmosphere is composed mostly of carbon dioxide and has a thick cloud layer of sulfuric acid that spans the whole planet. At the mean surface level, the atmosphere reaches a temperature of 737 K (464 °C; 867 °F) and a pressure 92 times greater than Earth's at sea level, turning the lowest layer of the atmosphere into a supercritical fluid. From Earth, Venus is visible as a star-like point of light, appearing brighter than any other natural point of light in the sky, and as an inferior planet it is always relatively close to the Sun, either as the brightest \"morning star\" or \"evening star\"."}}, {"canonical_name": "farinha de cevada", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 39, "members": [{"entity_id": "farinha_de_cevada", "book_id": "polyanthea_medicinal", "name": "farinha de cevada", "category": "PLANT", "subcategory": "PLANT", "count": 36, "variants": ["farinha de cevada", "fari-nha de trigo", "farinha", "farinha Tremès", "farinha de centeyo", "farinha de favas", "farinha de tremoços", "farinha de trigo", "farinha dearroz", "farinha decevada", "farinhade cevada", "farinhade pao", "farinhade tremoços", "farinhade trigo"], "contexts": ["barley flour, a thickening agent", "barley flour"]}, {"entity_id": "farinha_de_trigo", "book_id": "coloquios_da_orta_1563", "name": "farinha de trigo", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["farinha de trigo", "farinha de triguo"], "contexts": ["wheat flour", "ingredient in falcon plaster"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "farinha de cevada", "target_book": "coloquios_da_orta_1563", "target_name": "farinha de trigo", "similarity": 0.842}], "id": 648, "stable_key": "clu_265ad3a887a0a413", "ground_truth": {"modern_name": "Barley flour", "confidence": "high", "type": "plant", "description": "Flour made from ground barley grains.", "note": "Includes 'farinha de trigo' (wheat flour) as a related ingredient.", "wikipedia_extract": "Barley flour is a flour prepared from dried and ground barley. Barley flour is used to prepare barley bread and other breads, such as flat bread and yeast breads. There are two general types of barley flour: coarse and fine. Barley groats are milled to make coarse barley flour, and pearl barley is milled to make fine barley flour. Additionally, patent barley flour is a finer barley flour that is ground to a greater degree compared to fine barley flour. Barley flour is used to prepare breads such as barley bread."}}, {"canonical_name": "ardores", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 38, "members": [{"entity_id": "ardores", "book_id": "polyanthea_medicinal", "name": "ardores", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 37, "variants": ["ardores", "ardor", "ardores da ourina", "ardores da pelle", "ardores da urina", "ardores de corpo", "ardores de estomago", "ardores de ourina", "ardores na ourina", "ardoresda ourina", "ardoresda pelle", "ardoresdaourina"], "contexts": ["burning sensations", "symptom of burning sensation"]}, {"entity_id": "ardor", "book_id": "coloquios_da_orta_1563", "name": "ardor", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["ardor"], "contexts": ["burning sensation"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "ardores", "target_book": "coloquios_da_orta_1563", "target_name": "ardor", "similarity": 0.957}], "id": 649, "stable_key": "clu_2034853ee889c7e8", "ground_truth": {"modern_name": "Burning sensation", "confidence": "high", "type": "disease", "description": "A symptom characterized by a feeling of heat or burning.", "wikipedia_extract": "Dysesthesia is an unpleasant, abnormal sense of touch. Its etymology comes from the Greek word \"dys,\" meaning \"bad,\" and \"aesthesis,\" which means \"sensation\" (abnormal sensation). It often presents as pain but may also present as an inappropriate, but not discomforting, sensation. It is caused by lesions of the nervous system, peripheral or central, and it involves sensations, whether spontaneous or evoked, such as burning, wetness, itching, electric shock, and pins and needles. Dysesthesia can include sensations in any bodily tissue, including most often the mouth, scalp, skin, or legs. It is sometimes described as feeling like acid under the skin."}}, {"canonical_name": "Uvas", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 38, "members": [{"entity_id": "uvas", "book_id": "polyanthea_medicinal", "name": "Uvas", "category": "PLANT", "subcategory": "PLANT", "count": 31, "variants": ["Uvas", "Uvas de caó", "Uvasde cao", "polpa de uvas pafladas", "uvas", "uvas brancas", "uvas de cao", "uvas de cão", "uvas de tad", "uvas decão", "uvas paffadas", "uvas pafladas", "uvas paladas", "uvas paſladas", "uvas paſſadas", "uvasde cao"], "contexts": ["fruit that is not poison when green", "fruit used to wrap medicines"]}, {"entity_id": "uvas", "book_id": "coloquios_da_orta_1563", "name": "uvas", "category": "PLANT", "subcategory": "PLANT", "count": 6, "variants": ["uvas"], "contexts": ["fruit", "fruit found on the island"]}, {"entity_id": "uvas_ferraes", "book_id": "polyanthea_medicinal", "name": "uvas ferraes", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["uvas ferraes"], "contexts": ["fermented grapes"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Uvas", "target_book": "coloquios_da_orta_1563", "target_name": "uvas", "similarity": 0.991}, {"source_book": "coloquios_da_orta_1563", "source_name": "uvas", "target_book": "polyanthea_medicinal", "target_name": "uvas ferraes", "similarity": 0.818}], "id": 650, "stable_key": "clu_03219ba515d0888f", "ground_truth": {"modern_name": "Grapes", "confidence": "high", "type": "plant", "description": "Fleshy fruit of the vine, used in medicine and food.", "note": "Includes 'uvas ferraes' (fermented grapes).", "wikipedia_extract": "A grape is a fruit, botanically a berry, of the deciduous woody vines of the flowering plant genus Vitis. Grapes are a non-climacteric type of fruit, generally occurring in clusters. The cultivation of grapes began approximately 8,000 years ago, and the fruit has been used as human food throughout its history. Eaten fresh or in dried form (as raisins, currants and sultanas), grapes also hold cultural significance in many parts of the world, particularly for their role in winemaking. Other grape-derived products include various types of jam, juice, vinegar and oil. The Middle East is generally described as the homeland of grapes and the cultivation of this plant began there 6,000–8,000 years ago."}}, {"canonical_name": "macella", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 38, "members": [{"entity_id": "macella", "book_id": "polyanthea_medicinal", "name": "macella", "category": "PLANT", "subcategory": "PLANT", "count": 37, "variants": ["macella", "Macella", "Macellagalega", "macela", "macelagalega"], "contexts": ["yarrow used in decoction", "plant used in emetic"]}, {"entity_id": "macela", "book_id": "coloquios_da_orta_1563", "name": "macela", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["macela"], "contexts": ["a plant compared to negundo"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "macella", "target_book": "coloquios_da_orta_1563", "target_name": "macela", "similarity": 0.927}], "id": 651, "stable_key": "clu_32f03fb1a5893ee5", "ground_truth": {"modern_name": "Yarrow", "confidence": "high", "type": "plant", "linnaean": "Achillea millefolium", "family": "Asteraceae", "description": "A medicinal herb used in decoctions and emetics.", "wikipedia_extract": "Achillea millefolium, commonly known as yarrow () or common yarrow, is a flowering plant in the family Asteraceae. Growing to 1 metre (3+1⁄3 feet) tall, it is characterized by small whitish flowers, a tall stem of fernlike leaves, and a pungent odor. The plant is native to temperate regions of Eurasia and North America. It has been introduced as feed for livestock in New Zealand and Australia. It has some potential uses, including in traditional medicine. Achillea millefolium is an erect, herbaceous, perennial plant that produces one to several stems 0.2–1 metre (8–40 inches) in height, and has a spreading rhizomatous growth form."}}, {"canonical_name": "puxos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 37, "members": [{"entity_id": "puxos", "book_id": "polyanthea_medicinal", "name": "puxos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 36, "variants": ["puxos", "Puxos", "puxos deourina"], "contexts": ["medical condition", "convulsions"]}, {"entity_id": "puxo", "book_id": "historia_medicinal_monardes_1574", "name": "puxo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["puxo"], "contexts": ["for the flux whatever it may be"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "puxos", "target_book": "historia_medicinal_monardes_1574", "target_name": "puxo", "similarity": 0.962}], "id": 652, "stable_key": "clu_5ae70d2675a1469c", "ground_truth": {"modern_name": "Convulsions", "confidence": "high", "type": "disease", "description": "Medical condition characterized by sudden, involuntary muscle contractions.", "note": "Also refers to 'flux whatever it may be'.", "wikipedia_extract": "A convulsion is a medical condition where the body muscles contract and relax rapidly and repeatedly, resulting in uncontrolled shaking. Because epileptic seizures typically include convulsions, the term convulsion is often used as a synonym for seizure. However, not all epileptic seizures result in convulsions, and not all convulsions are caused by epileptic seizures. Non-epileptic convulsions have no relation with epilepsy, and are caused by non-epileptic seizures. Convulsions can be caused by epilepsy, infections (including a severe form of listeriosis which is caused by eating food contaminated by Listeria monocytogenes), brain trauma, or other medical conditions. They can also occur from an electric shock or improperly enriched air for scuba diving."}}, {"canonical_name": "frangão", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 37, "members": [{"entity_id": "frangão", "book_id": "polyanthea_medicinal", "name": "frangão", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 34, "variants": ["frangão", "Frangaó", "figadode frangão", "franga", "franganitos", "frangaó", "frangaō", "frangáo"], "contexts": ["animal for cooking", "chicken, an animal product"]}, {"entity_id": "franguos", "book_id": "coloquios_da_orta_1563", "name": "franguos", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 3, "variants": ["franguos", "frangão", "frangãos"], "contexts": ["chickens used in remedies", "young poultry used as food"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "frangão", "target_book": "coloquios_da_orta_1563", "target_name": "franguos", "similarity": 0.903}], "id": 653, "stable_key": "clu_a116e227f907f7e6", "ground_truth": {"modern_name": "Chicken", "confidence": "high", "type": "animal", "description": "Domestic fowl, used for food and in remedies.", "note": "Includes young poultry.", "wikipedia_extract": "The chicken (Gallus gallus domesticus) is a domesticated form of the red junglefowl (Gallus gallus), originally native to Southeast Asia. It was first domesticated around 8,000 years ago and is one of the most common and widespread domesticated animals in the world. Chickens are primarily kept for their meat and eggs, though they are also kept as pets. As of 2023, the global chicken population exceeds 26.5 billion, with more than 50 billion birds produced annually for consumption. Specialized breeds such as broilers and laying hens have been developed for meat and egg production, respectively. A hen bred for laying can produce over 300 eggs per year."}}, {"canonical_name": "Persistence of Force", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 37, "members": [{"entity_id": "persistence_of_force", "book_id": "first_principles_spencer_1862", "name": "Persistence of Force", "category": "CONCEPT", "subcategory": "THEORY", "count": 29, "variants": ["persistence of force", "persistence of Force", "Persistence of Force"], "contexts": ["principle that force remains constant", "ultimate truth, cannot be inductively proven"]}, {"entity_id": "conservation_of_force", "book_id": "connexion_physical_sciences_somerville_1858", "name": "conservation of force", "category": "CONCEPT", "subcategory": "THEORY", "count": 8, "variants": ["Conservation of Force", "conservation of force"], "contexts": ["principle of energy conservation", "principle of energy preservation"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "Persistence of Force", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "conservation of force", "similarity": 0.846}], "id": 654, "stable_key": "clu_fe8dfda81fe1b92b", "ground_truth": {"modern_name": "Conservation of energy", "confidence": "high", "type": "concept", "note": "The term 'Persistence of Force' is an early formulation of the concept later widely known as the conservation of energy.", "wikipedia_extract": "In physical science, mechanical energy is the sum of macroscopic potential and kinetic energies. The principle of conservation of mechanical energy states that if an isolated system or a closed system is subject only to conservative forces, then the mechanical energy is constant. If an object moves in the opposite direction of a conservative net force, the potential energy will increase; and if the speed (not the velocity) of the object changes, the kinetic energy of the object also changes. In all real systems, however, nonconservative forces, such as frictional forces, will be present, but if they are of negligible magnitude, the mechanical energy changes little and its conservation is a useful approximation. In elastic collisions, the kinetic energy is conserved, but in inelastic collisions some mechanical energy may be converted into thermal energy. The equivalence between lost mechanical energy  and an increase in temperature was discovered by James Prescott Joule.", "wikipedia_url": "https://en.wikipedia.org/wiki/Mechanical_energy"}}, {"canonical_name": "Venemous Beasts", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 35, "members": [{"entity_id": "venemous_beasts", "book_id": "english_physician_1652", "name": "Venemous Beasts", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 19, "variants": ["Venemous Beasts", "Venemous Creature", "Venemous Serpents", "Venemous serpents", "venemous Beasts", "venemous creature"], "contexts": ["creatures whose bites are under Mars", "dangerous animals"]}, {"entity_id": "animal_venenoſo", "book_id": "polyanthea_medicinal", "name": "animal venenoſo", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 16, "variants": ["animal venenoſo", "animaes muyto venenofos", "animaes venenofos", "animaes venenoſos", "animal venenofo", "animal venenoso", "animalium venenatorum", "bichos venenofos", "bichos venenoſos"], "contexts": ["venomous animal", "poisonous animal"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Venemous Beasts", "target_book": "polyanthea_medicinal", "target_name": "animal venenoſo", "similarity": 0.872}], "id": 655, "stable_key": "clu_0a60c4ce26e66420", "ground_truth": {"modern_name": "Venomous Animals", "confidence": "high", "type": "animal", "description": "Creatures capable of inflicting harm through venomous bites or stings.", "wikipedia_extract": "The following is a list of poisonous animals, which are animals that passively deliver toxins (called poison) to their victims upon contact such as through inhalation, absorption through the skin, or after being ingested. They are often distinguished from venomous animals, which actively inject their toxins (called venom) into their victims through a venom apparatus such as fangs or a stinger. The only difference between poisonous animals and venomous animals is how they deliver the toxins. This list deals exclusively with poisonous animals. This list is a partial list of animals that are poisonous to humans and other animals in that their flesh is toxic if consumed, or in some cases if they are touched: Some of these toads are \"milked\" for their bufotoxins."}}, {"canonical_name": "Choco", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 35, "members": [{"entity_id": "choco", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Choco", "category": "PLACE", "subcategory": "REGION", "count": 34, "variants": ["Choco", "Choco Barbacoas"], "contexts": ["city with population 22,000", "place where platinum is found"]}, {"entity_id": "choco", "book_id": "kosmos_humboldt_1845", "name": "Choco", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Choco"], "contexts": ["location of ravines"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Choco", "target_book": "kosmos_humboldt_1845", "target_name": "Choco", "similarity": 1.0}], "id": 656, "stable_key": "clu_32b88e0bef1bc5d1", "ground_truth": {"modern_name": "Chocó", "confidence": "high", "type": "place", "country": "Colombia", "wikidata_id": "Q230584", "wikidata_description": "department of Colombia", "wikipedia_extract": "Chocó Department (Spanish pronunciation: [tʃoˈko]) is a department of the Pacific region of Colombia known for hosting the largest Afro-Colombian population in the nation, and a large population of Amerindian and mixed African-Amerindian Colombians. It is in the west of the country, and is the only Colombian department to have coastlines on both the Pacific Ocean and the Atlantic Ocean. It contains all of Colombia's border with Panama. Its capital is Quibdó. Chocó has a diverse geography, unique ecosystems and unexploited natural resources; however, its population has one of the lowest standards of living of all departments in Colombia. A major factor cited by the government is the rugged, montane rainforest environment and the hot, hyperhumid climate.", "wikipedia_url": "https://en.wikipedia.org/wiki/Chocó_Department"}}, {"canonical_name": "Rio Magdalena", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 34, "members": [{"entity_id": "rio_magdalena", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rio Magdalena", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 33, "variants": ["Rio Magdalena", "Maria Magdalena", "Rio Magdaleua", "RioMagdalena"], "contexts": ["river with coconut trees along its banks", "river where palm trees were seen"]}, {"entity_id": "magdalena_river", "book_id": "kosmos_humboldt_1845", "name": "Magdalena River", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Magdalena River"], "contexts": ["river near Honda"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rio Magdalena", "target_book": "kosmos_humboldt_1845", "target_name": "Magdalena River", "similarity": 0.918}], "id": 657, "stable_key": "clu_0475370359423f52", "ground_truth": {"modern_name": "Magdalena River", "confidence": "high", "type": "place", "country": "Colombia", "wikidata_id": "Q6115369", "wikidata_description": "river in Mexico City", "wikipedia_extract": "The Magdalena River (Spanish: Río Magdalena, Spanish pronunciation: [ˈri.o maɣðaˈlena]; less commonly Rio Grande de la Magdalena) is the main river of Colombia, flowing northward about 1,528 kilometres (949 mi) through the western half of the country. It takes its name from the biblical figure Mary Magdalene. It is navigable through much of its lower reaches, in spite of the shifting sand bars at the mouth of its delta, as far as Honda, at the downstream base of its rapids. It flows through the Magdalena River Valley. Its drainage basin covers a surface of 273,000 square kilometres (105,000 sq mi), which is 24% of the country's area and where 66% of its population lives. The Magdalena River is the largest river system of the northern Andes, with a length of 1,612 km."}}, {"canonical_name": "Truxillo", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 34, "members": [{"entity_id": "truxillo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Truxillo", "category": "PLACE", "subcategory": "CITY", "count": 32, "variants": ["Truxillo", "Trujillo", "Trusillo", "Truxilio"], "contexts": ["city in Venezuela", "mountains in Maracaybo province"]}, {"entity_id": "truxillo", "book_id": "kosmos_humboldt_1845", "name": "Truxillo", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Truxillo"], "contexts": ["city in Peru", "city hearing subterranean thunder-clap"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Truxillo", "target_book": "kosmos_humboldt_1845", "target_name": "Truxillo", "similarity": 1.0}], "id": 658, "stable_key": "clu_6d7dfb9304e427de", "ground_truth": {"modern_name": "Trujillo", "confidence": "high", "type": "place", "country": "Venezuela", "note": "The text mentions 'Truxillo' in Venezuela and Peru. Trujillo in Venezuela is the primary referent based on Humboldt's travels.", "wikidata_id": "Q1020535", "wikidata_description": "state capital of Trujillo State, Venezuela", "wikipedia_url": "https://en.wikipedia.org/wiki/Trujillo,_Trujillo", "wikipedia_extract": "Trujillo is the capital city of Trujillo State in Venezuela. About 40,000 people live in this city, located in El Valle de Los Mukas. Founded by one of the \"Conquistadores de America\", Diego García de Paredes (1506–1563), son of Diego García de Paredes (the father), (1466–1534), Spanish soldier and duellist, native of Trujillo in Extremadura, Spain. In 1678, Trujillo was the farthest point in a daring raid on Spanish-held Venezuela, carried out by six pirate ships and 700 men led by the French buccaneer Michel de Grammont. Simon Bolívar promulgated the Decree of War to the Death in the city on 15 June 1813."}}, {"canonical_name": "Apure", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 34, "members": [{"entity_id": "apure", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Apure", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 33, "variants": ["Apure"], "contexts": ["river confluent location", "river confluence"]}, {"entity_id": "apures", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Apures", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Apures"], "contexts": ["location for sound observations"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Apure", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Apures", "similarity": 0.949}], "id": 659, "stable_key": "clu_6f2bf1e66d8cf164", "ground_truth": {"modern_name": "Apure River", "confidence": "high", "type": "place", "country": "Venezuela", "wikidata_id": "Q853315", "wikidata_description": "river in Venezuela", "wikipedia_url": "https://en.wikipedia.org/wiki/Apure%20River"}}, {"canonical_name": "Rasis", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 34, "members": [{"entity_id": "rasis", "book_id": "coloquios_da_orta_1563", "name": "Rasis", "category": "PERSON", "subcategory": "AUTHORITY", "count": 32, "variants": ["Rasis"], "contexts": ["Arabian physician, known as Benzacaria", "ancient authority on medicine"]}, {"entity_id": "rasis", "book_id": "historia_medicinal_monardes_1574", "name": "Rasis", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Rasis", "Rass"], "contexts": ["author of treatise", "ancient medical authority"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Rasis", "target_book": "historia_medicinal_monardes_1574", "target_name": "Rasis", "similarity": 1.0}], "id": 660, "stable_key": "clu_284ca6a09a708a26", "ground_truth": {"modern_name": "Rhazes", "confidence": "high", "type": "person", "description": "Influential Persian physician and alchemist of the Islamic Golden Age.", "note": "Also known as Rasis or Benzacaria.", "wikipedia_extract": "Abū Bakr al-Rāzī, also known as Rhazes (full name: أبو بکر محمد بن زکریاء الرازي, Abū Bakr Muḥammad ibn Zakariyyāʾ al-Rāzī), 864 or 865 – 925 or 935 CE, was a Persian physician, philosopher and alchemist who lived during the Islamic Golden Age. He is widely regarded as one of the most important figures in the history of medicine, and also wrote on logic, astronomy and grammar. He is also known for his criticism of religion, especially with regard to the concepts of prophethood and revelation. However, the religio-philosophical aspects of his thought, which also included a belief in five \"eternal principles\", are fragmentary and only reported by authors who were often hostile to him. A comprehensive thinker, al-Razi made fundamental and enduring contributions to various fields, which he recorded in over 200 manuscripts, and is particularly remembered for numerous advances in medicine through his observations and discoveries. An early proponent of experimental medicine, he became a successful doctor, and served as chief physician of Baghdad and Ray hospitals."}}, {"canonical_name": "arvore", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 34, "members": [{"entity_id": "arvore", "book_id": "coloquios_da_orta_1563", "name": "arvore", "category": "PLANT", "subcategory": "PLANT", "count": 25, "variants": ["arvore", "ARVORE", "arvores"], "contexts": ["plant that smells good", "a tree"]}, {"entity_id": "arvores", "book_id": "polyanthea_medicinal", "name": "arvores", "category": "PLANT", "subcategory": "PLANT", "count": 9, "variants": ["arvores", "arvore", "arvore vitæ"], "contexts": ["trees", "plants"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "arvore", "target_book": "polyanthea_medicinal", "target_name": "arvores", "similarity": 0.972}], "id": 661, "stable_key": "clu_378a80b6c3634ff8", "ground_truth": {"modern_name": "Tree", "confidence": "high", "type": "plant", "description": "A woody perennial plant, typically having a single stem or trunk.", "note": "Plural form 'arvores' also present.", "wikipedia_extract": "In botany, a tree is a perennial plant with an elongated stem, or trunk, usually supporting branches and leaves. In some usages, the definition of a tree may be narrower, e.g., including only woody plants with secondary growth, only plants that are usable as lumber, or only plants above a specified height. Wider definitions include taller palms, tree ferns, bananas, and bamboos. Trees are not a monophyletic taxonomic group but consist of a wide variety of plant species that have independently evolved a trunk and branches as a way to tower above other plants to compete for sunlight. The majority of tree species are angiosperms or hardwoods; of the rest, many are gymnosperms or softwoods. Trees tend to be long-lived, some trees reaching several thousand years old."}}, {"canonical_name": "Myrrha", "category": "PLANT", "subcategory": "RESIN", "book_count": 2, "total_mentions": 33, "members": [{"entity_id": "myrrha", "book_id": "ricettario_fiorentino_1597", "name": "Myrrha", "category": "PLANT", "subcategory": "RESIN", "count": 31, "variants": ["Myrrha", "Myrra", "Myrrba", "Myrrhatroglody", "Myrrna", "myrrha"], "contexts": ["resin with strong odor", "resin from an Arabian tree"]}, {"entity_id": "myrrhe", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Myrrhe", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["Myrrhe"], "contexts": ["aromatic resin"]}, {"entity_id": "myrrhatroglod", "book_id": "ricettario_fiorentino_1597", "name": "Myrrhatroglod", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["Myrrhatroglod"], "contexts": ["resin ingredient"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Myrrha", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Myrrhe", "similarity": 0.984}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Myrrhe", "target_book": "ricettario_fiorentino_1597", "target_name": "Myrrhatroglod", "similarity": 0.873}], "id": 662, "stable_key": "clu_45435d58660b7179", "ground_truth": {"modern_name": "Myrrh", "confidence": "high", "type": "plant", "linnaean": "Commiphora myrrha", "family": "Burseraceae", "note": "Although Myrrh is a resin, it is derived from plants.", "wikidata_id": "Q1137175", "wikidata_description": "species of plant", "wikipedia_extract": "A resin is a solid or highly viscous liquid that can be converted into a polymer. Resins may be biological or synthetic in origin, but are typically harvested from plants. Resins are mixtures of organic compounds insoluble in water, predominantly terpenes. Technically, resins should not be confused with gums, which consist predominantly of water-soluble polysaccharides, although these two terms are often interchangeable in the less formal context. Common resins include pine oleoresins, amber, hashish, frankincense, myrrh and the animal-derived resin, shellac. Resins are used in varnishes, adhesives, food additives, incenses and perfumes.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cicely"}}, {"canonical_name": "hortela", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 33, "members": [{"entity_id": "hortela", "book_id": "polyanthea_medicinal", "name": "hortela", "category": "PLANT", "subcategory": "PLANT", "count": 29, "variants": ["hortela", "hortela verde", "hortelaverde", "hortelá verde", "hortelã", "hortelãs"], "contexts": ["mint used in remedy", "infused in wine for stomach application"]}, {"entity_id": "horstail", "book_id": "english_physician_1652", "name": "Horstail", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["Horstail"], "contexts": ["plant used for distilled water", "herb used in remedies"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "hortela", "target_book": "english_physician_1652", "target_name": "Horstail", "similarity": 0.849}], "id": 663, "stable_key": "clu_8c8114429b9469b6", "ground_truth": {"modern_name": "Mint", "confidence": "medium", "type": "plant", "description": "A fragrant herb, often used in remedies and for its refreshing properties.", "note": "Refers to various mint species and similar aromatic herbs; 'hortela' and 'ortela' are Portuguese/Spanish for mint.", "wikipedia_extract": "Hortelã is a settlement in the western part of the island of São Nicolau, Cape Verde. In 2010 its population was 181. It is situated at the southern foot of Monte Gordo, 5 km north of Tarrafal de São Nicolau and 6 km west of Ribeira Brava."}}, {"canonical_name": "Borragens", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 33, "members": [{"entity_id": "borragens", "book_id": "polyanthea_medicinal", "name": "Borragens", "category": "PLANT", "subcategory": "PLANT", "count": 30, "variants": ["Borragens", "Borragés", "borragem", "borragens", "borragés"], "contexts": ["borage herb", "borage used in conserves"]}, {"entity_id": "borrage", "book_id": "english_physician_1652", "name": "Borrage", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Borrage"], "contexts": ["plant known to be in gardens", "herb known to inhabit gardens"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Borragens", "target_book": "english_physician_1652", "target_name": "Borrage", "similarity": 0.851}], "id": 664, "stable_key": "clu_ed26269d396b9dd9", "ground_truth": {"modern_name": "Borage", "confidence": "high", "type": "plant", "description": "An annual herb with blue flowers, used in culinary and medicinal contexts.", "note": "Plural form 'Borragens' also present.", "wikipedia_extract": "Borage (  or ; Borago officinalis), also known as starflower, is an annual herb in the flowering plant family Boraginaceae native to the Mediterranean region. Although the plant contains small amounts of pyrrolizidine alkaloids, some parts are edible and its seeds provide oil. B. officinalis grows to a height of 60 centimetres (2 feet), and is bristly or hairy all over the stems and leaves; the leaves are alternate, simple, and 5–15 cm (2–6 inches) long. The flowers are complete, perfect with five narrow, triangular-pointed petals. Flowers are most often blue, although pink flowers are sometimes observed. White-flowered types are also cultivated."}}, {"canonical_name": "selection", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 33, "members": [{"entity_id": "selection", "book_id": "origin_of_species_darwin_1859", "name": "selection", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 32, "variants": ["selection", "Selection"], "contexts": ["process of choosing individuals", "process of choosing variations"]}, {"entity_id": "selection", "book_id": "principles_of_psychology_james_1890", "name": "selection", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["selection"], "contexts": ["process of choosing"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "selection", "target_book": "principles_of_psychology_james_1890", "target_name": "selection", "similarity": 1.0}], "id": 665, "stable_key": "clu_4b50f5eb382dd35c", "ground_truth": {"modern_name": "Natural Selection", "confidence": "high", "type": "concept", "description": "Process by which organisms better adapted to their environment tend to survive and reproduce more offspring.", "wikipedia_extract": "Natural selection is the differential survival and reproduction of individuals due to differences in the relative fitness endowed on them by their own particular complement of observable characteristics. It is a key law or mechanism of evolution which changes the heritable traits characteristic of a population or species over generations. Charles Darwin popularised the term \"natural selection\", contrasting it with artificial selection, which is intentional, whereas natural selection is not. For Darwin natural selection was a law or principle which resulted from three different kinds of process: inheritance, including the transmission of heritable material from parent to offspring and its development (ontogeny) in the offspring; variation, which partly resulted from an organism's own agency (see phenotype; Baldwin effect); and the struggle for existence, which included both competition between organisms and cooperation or 'mutual aid' (particularly in 'social' plants and social animals). Variation of traits, both genotypic and phenotypic, exists within all populations of organisms. However, some traits are more likely to facilitate survival and reproductive success."}}, {"canonical_name": "Almiſcar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 33, "members": [{"entity_id": "almiſcar", "book_id": "polyanthea_medicinal", "name": "Almiſcar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 23, "variants": ["Almiſcar", "almiſcar"], "contexts": ["musk, used in plaster", "ingredient in a preparation"]}, {"entity_id": "almizque", "book_id": "historia_medicinal_monardes_1574", "name": "Almizque", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 8, "variants": ["Almizque", "Almiogue", "almizque"], "contexts": ["animal product, musk", "musk"]}, {"entity_id": "almiaco", "book_id": "historia_medicinal_monardes_1574", "name": "Almiaco", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Almiaco"], "contexts": ["substance like musk"]}, {"entity_id": "almizg", "book_id": "historia_medicinal_monardes_1574", "name": "Almizg", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Almizg"], "contexts": ["animal product used in preparations"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Almiſcar", "target_book": "historia_medicinal_monardes_1574", "target_name": "Almizque", "similarity": 0.875}, {"source_book": "polyanthea_medicinal", "source_name": "Almiſcar", "target_book": "historia_medicinal_monardes_1574", "target_name": "Almiaco", "similarity": 0.9}, {"source_book": "polyanthea_medicinal", "source_name": "Almiſcar", "target_book": "historia_medicinal_monardes_1574", "target_name": "Almizg", "similarity": 0.859}], "id": 666, "stable_key": "clu_34f3711a8314d173", "ground_truth": {"modern_name": "Musk", "confidence": "high", "type": "substance", "description": "A strong-smelling substance secreted by male musk deer, used in perfumery and medicine.", "note": "Historical texts use variations like Almiſcar, Almizque, Almiaco, and Almizg.", "wikipedia_extract": "Musk is a class of aromatic substances commonly used as base notes in perfumery. They include glandular secretions from animals such as the musk deer, numerous plants emitting similar fragrances, and artificial substances with similar odors. Musk was a name originally given to a substance with a strong odor obtained from a gland of the musk deer. The substance has been used as a popular perfume fixative since ancient times and is one of the most expensive animal products in the world. The name originates from the Late Greek μόσχος 'moskhos', from Persian mushk and Sanskrit मुष्क muṣka (lit. 'testicle') derived from Proto-Indo-European noun múh₂s meaning \"mouse\". The deer gland was thought to resemble a scrotum."}}, {"canonical_name": "remedio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 33, "members": [{"entity_id": "remedio", "book_id": "polyanthea_medicinal", "name": "remedio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 25, "variants": ["remedio", "remedios mornos", "remediospurgativos"], "contexts": ["A cure or treatment", "treatment or cure"]}, {"entity_id": "remedio", "book_id": "historia_medicinal_monardes_1574", "name": "remedio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["remedio", "remedios chirurgicales"], "contexts": ["cure or treatment", "remedy"]}, {"entity_id": "virtude_dos_remedios", "book_id": "polyanthea_medicinal", "name": "virtude dos remedios", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["virtude dos remedios", "Virtudes dos remedios fimplices", "virtude dos remedios eficazes", "virtude dos remedios especificos"], "contexts": ["virtue of remedies", "virtue of specific remedies"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "remedio", "target_book": "historia_medicinal_monardes_1574", "target_name": "remedio", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "remedio", "target_book": "polyanthea_medicinal", "target_name": "virtude dos remedios", "similarity": 0.845}], "id": 667, "stable_key": "clu_cea96dfd7f2f8592", "ground_truth": {"modern_name": "Remedy", "confidence": "high", "type": "concept", "description": "A medicine or treatment for a disease or injury.", "note": "'Remedio' is the Spanish/Portuguese word for remedy.", "wikipedia_extract": "Remedio is an Israeli cybersecurity company based in Tel Aviv. Founded in 2019 by cybersecurity entrepreneurs Tal Kollender, Gilad Raz, and Yakov Kogan, the company develops an AI-driven platform for device posture management, automated configuration hardening, and risk remediation. Remedio began in 2019 under the name GYTPOL, founded by Tal Kollender (CEO), Gilad Raz, and Yakov Kogan. That same year, Israel Aerospace Industries (IAI) became the company’s first customer. GYTPOL’s platform addressed the problem of hidden misconfigurations on enterprise endpoints. Check Point Software Technologies, a multinational cybersecurity company, was its first cybersecurity customer."}}, {"canonical_name": "diaprunis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 33, "members": [{"entity_id": "diaprunis", "book_id": "polyanthea_medicinal", "name": "diaprunis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 32, "variants": ["diaprunis", "Diaphenica", "Diaphenicao", "Diaphenicaó", "Diaphenicone", "Diaphenicão", "diapheni", "diaphenica", "diaphenicam", "diaphenicao", "diaphenicaó", "diaphenicaõ", "diaphenicaō", "diaphenicão"], "contexts": ["a medicinal preparation", "prunes, a fruit"]}, {"entity_id": "diaprunum", "book_id": "ricettario_fiorentino_1597", "name": "Diaprunum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Diaprunum"], "contexts": ["medicinal preparation"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "diaprunis", "target_book": "ricettario_fiorentino_1597", "target_name": "Diaprunum", "similarity": 0.95}], "id": 668, "stable_key": "clu_fe1a7cf0e0b8a583", "ground_truth": {"modern_name": "Diaprun", "confidence": "high", "type": "substance", "description": "A medicinal preparation, often containing prunes.", "note": "Historical term for a type of confection or electuary.", "wikipedia_extract": "A prune is a dried plum, most commonly from the European plum (Prunus domestica) tree. Not all plum species or varieties can be dried into prunes. Use of the term prune for fresh plums is obsolete except when applied to varieties of plum grown for drying. In this usage, a prune is the firm-fleshed plum fruit of P. domestica varieties that have a high soluble solids content and do not ferment during drying. Most prunes are freestone cultivars (i.e., the pit is easy to remove), whereas most plums grown for fresh consumption are clingstone (the pit is more difficult to remove). The sorbitol content of dietary fiber likely provides the laxative effect associated with consuming prunes."}}, {"canonical_name": "chumbo", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 32, "members": [{"entity_id": "chumbo", "book_id": "polyanthea_medicinal", "name": "chumbo", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 22, "variants": ["chumbo", "Chumbo", "chumbo queymado"], "contexts": ["mineral substance, lead", "lead used in sugar preparation"]}, {"entity_id": "chumbo", "book_id": "coloquios_da_orta_1563", "name": "chumbo", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["chumbo"], "contexts": ["lead, a metal", "lead"]}, {"entity_id": "affucar_de_chumbo", "book_id": "polyanthea_medicinal", "name": "affucar de chumbo", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["affucar de chumbo", "aflucar de chumbo", "aflucarde chumbo"], "contexts": ["sugar of lead, lead acetate", "lead acetate used in a preparation"]}, {"entity_id": "chumbo_dos_filofofos", "book_id": "polyanthea_medicinal", "name": "Chumbo dos Filofofos", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Chumbo dos Filofofos"], "contexts": ["alchemical name for lead"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "chumbo", "target_book": "coloquios_da_orta_1563", "target_name": "chumbo", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "chumbo", "target_book": "polyanthea_medicinal", "target_name": "affucar de chumbo", "similarity": 0.856}, {"source_book": "coloquios_da_orta_1563", "source_name": "chumbo", "target_book": "polyanthea_medicinal", "target_name": "Chumbo dos Filofofos", "similarity": 0.824}], "id": 669, "stable_key": "clu_8c14562204011416", "ground_truth": {"modern_name": "Lead", "confidence": "high", "type": "mineral", "description": "A heavy, soft, bluish-grey metal, known for its toxicity.", "note": "Includes 'chumbo' (Portuguese/Spanish for lead) and alchemical references.", "wikipedia_extract": "Lead ( ) is a chemical element with the symbol Pb (from the Latin plumbum) and atomic number 82. It is a heavy metal, denser than most common materials. Lead is soft, malleable, and has a relatively low melting point. When freshly cut or melted, it appears shiny silvery with a bluish tint, but tarnishes to dull gray on exposure to air. Lead has the highest atomic number of any stable element, and three of its isotopes are endpoints of major nuclear decay chains of heavier elements. Lead is a relatively unreactive post-transition metal."}}, {"canonical_name": "oleo de amendoas doces", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 32, "members": [{"entity_id": "oleo_de_amendoas_doces", "book_id": "polyanthea_medicinal", "name": "oleo de amendoas doces", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 30, "variants": ["oleo de amendoas doces", "oleo de almendolas doces", "oleo deamendoas amargofas", "oleode amendoas amargoſas", "oleode amendoasdoces", "oleodeamendoas doces"], "contexts": ["emollient remedy ingredient", "ingredient in a liniment"]}, {"entity_id": "óleo_de_amêndoas_doces", "book_id": "coloquios_da_orta_1563", "name": "óleo de amêndoas doces", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["óleo de amêndoas doces"], "contexts": ["rectification agent", "oil preparation from almonds"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "oleo de amendoas doces", "target_book": "coloquios_da_orta_1563", "target_name": "óleo de amêndoas doces", "similarity": 0.951}], "id": 670, "stable_key": "clu_9d9bc622ac2134d4", "ground_truth": {"modern_name": "Sweet Almond Oil", "confidence": "high", "type": "substance", "description": "Oil extracted from sweet almonds, used in medicine and cosmetics.", "note": "'Oleo de amendoas doces' is Portuguese for sweet almond oil.", "wikipedia_extract": "Prunus is a genus of flowering trees and shrubs from the family Rosaceae. The genus includes plums, cherries, peaches, nectarines, apricots and almonds (collectively stonefruit). The genus has a cosmopolitan distribution, being native to the temperate regions of North America, the neotropics of South America, and temperate and tropical regions of Eurasia and Africa, There are about 340 accepted species as of March 2024. Many members of the genus are widely cultivated for their sweet, fleshy fruit and for decorative purposes of their flowers. Prunus fruit are drupes, or stone fruits. The fleshy mesocarp surrounding the endocarp is edible while the endocarp itself forms a hard, inedible shell called the pyrena (\"stone\" or \"pit\")."}}, {"canonical_name": "Viboras", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 31, "members": [{"entity_id": "viboras", "book_id": "polyanthea_medicinal", "name": "Viboras", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 24, "variants": ["Viboras", "Vibora", "vibora", "viboras"], "contexts": ["vipers used in oil preparation", "snakes used in remedies"]}, {"entity_id": "viper", "book_id": "english_physician_1652", "name": "Viper", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 7, "variants": ["Viper", "Vipers"], "contexts": ["venomous beast", "animal whose bite is treated"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Viboras", "target_book": "english_physician_1652", "target_name": "Viper", "similarity": 0.84}], "id": 671, "stable_key": "clu_d8b35909280aa311", "ground_truth": {"modern_name": "Viper", "confidence": "high", "type": "animal", "description": "Venomous snake used in traditional medicine and remedies.", "wikipedia_extract": "Vipers are snakes in the family Viperidae, found in most parts of the world, except for Antarctica, Australia, Hawaii, Madagascar, Ireland, and various other isolated islands. All vipers are venomous, and have long (relative to non-vipers), hinged fangs that permit deep envenomation of their prey. Three subfamilies are currently recognized. They are also known as viperids. The name \"viper\" is derived from the Latin word vipera, -ae, also meaning viper, possibly from vivus (\"living\") and parere (\"to beget\"), referring to the trait viviparity (giving live birth) common in vipers like most of the species of Boidae. The earliest known vipers are believed to have diverged from the rest of the clade Caenophidia in the early Eocene."}}, {"canonical_name": "naturalists", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 31, "members": [{"entity_id": "naturalists", "book_id": "origin_of_species_darwin_1859", "name": "naturalists", "category": "PERSON", "subcategory": "SCHOLAR", "count": 29, "variants": ["naturalists", "Naturalists"], "contexts": ["scientists studying nature", "people who study nature"]}, {"entity_id": "naturalists", "book_id": "first_principles_spencer_1862", "name": "naturalists", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Naturalists", "naturalists"], "contexts": ["scientists studying nature", "scientists who study nature"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "naturalists", "target_book": "first_principles_spencer_1862", "target_name": "naturalists", "similarity": 1.0}], "id": 672, "stable_key": "clu_cce57dd83d614006", "ground_truth": {"modern_name": "Naturalist", "confidence": "high", "type": "person", "description": "Scientists who study the natural world and its phenomena.", "note": "This refers to a category of individuals, not a specific person.", "wikidata_id": "Q18805", "wikidata_description": "person who studies and knows a lot about plants, animals and natural history (esp in the field)", "wikipedia_extract": "Sir David Frederick Attenborough (; born 8 May 1926) is a British broadcaster, biologist, natural historian and writer. First becoming prominent as host of Zoo Quest in 1954, his filmography as a writer, presenter and narrator has spanned eight decades; it includes the nine nature documentary series forming The Life Collection, Natural World, Wildlife on One, the Planet Earth franchise, The Blue Planet and Blue Planet II. He is the only person to have won BAFTA Awards in black-and-white, colour, high-definition, 3D and 4K resolution. Over his life he has collected dozens of honorary degrees and awards, including three Emmy Awards for Outstanding Narration and one Emmy Award for Outstanding Daytime Personality - Non-Daily. Attenborough was a senior manager at the BBC, having served as controller of BBC Two and director of programming for BBC Television in the 1960s and 1970s. While Attenborough's earlier work focused primarily on the wonders of the natural world, his later work has been more vocal in support of environmental causes.", "wikipedia_url": "https://en.wikipedia.org/wiki/Naturalist"}}, {"canonical_name": "Artemija", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 30, "members": [{"entity_id": "artemija", "book_id": "polyanthea_medicinal", "name": "Artemija", "category": "PLANT", "subcategory": "PLANT", "count": 28, "variants": ["Artemija", "Artemihe", "artemija", "artemiſa"], "contexts": ["herb used in a liniment", "herb used in a bath"]}, {"entity_id": "artemisa", "book_id": "coloquios_da_orta_1563", "name": "artemisa", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["artemisa"], "contexts": ["herb used in medicine"]}, {"entity_id": "artemija_verde", "book_id": "polyanthea_medicinal", "name": "artemija verde", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["artemija verde"], "contexts": ["pounded and mixed with rose water"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Artemija", "target_book": "coloquios_da_orta_1563", "target_name": "artemisa", "similarity": 0.888}, {"source_book": "coloquios_da_orta_1563", "source_name": "artemisa", "target_book": "polyanthea_medicinal", "target_name": "artemija verde", "similarity": 0.812}], "id": 673, "stable_key": "clu_bc28296ad870baa2", "ground_truth": {"modern_name": "Artemisia", "confidence": "high", "type": "plant", "description": "Herb used in traditional medicine, liniments, and baths.", "note": "This refers to plants in the genus Artemisia, commonly known as wormwood or mugwort.", "wikipedia_extract": "Artemisia ( art-ə-MEE-zee-ə) is a large, diverse genus of plants belonging to the daisy family, Asteraceae, with almost 500 species. Common names for various species in the genus include mugwort, wormwood, and sagebrush. Some botanists split the genus into several genera, but DNA analysis does not support the maintenance of the genera Crossostephium, Filifolium, Neopallasia, Seriphidium, and Sphaeromeria; three other segregate genera—Stilnolepis, Elachanthemum, and Kaschgaria—are maintained by this evidence. Occasionally, some of the species are called sages, causing confusion with the Salvia sages in the family Lamiaceae. Artemisia comprises hardy herbaceous plants and shrubs, which are known for the powerful chemical constituents in their essential oils. Artemisia species grow in temperate climates of both hemispheres, usually in dry or semiarid habitats."}}, {"canonical_name": "cera", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 29, "members": [{"entity_id": "cera", "book_id": "polyanthea_medicinal", "name": "cera", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 25, "variants": ["cera"], "contexts": ["ingredient in masticatories", "ingredient in an emplaster"]}, {"entity_id": "ceruss", "book_id": "english_physician_1652", "name": "Ceruss", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["Ceruss"], "contexts": ["lead compound used in ointments", "white lead used in liniment"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "cera", "target_book": "english_physician_1652", "target_name": "Ceruss", "similarity": 0.851}], "id": 674, "stable_key": "clu_510876298ce3bba5", "ground_truth": {"modern_name": "Wax", "confidence": "high", "type": "substance", "description": "A malleable substance derived from bees or plants, used in preparations.", "note": "Includes mentions of 'Ceruss' (white lead), which is a distinct substance.", "wikipedia_extract": "Waxes are a diverse class of organic compounds that are lipophilic solids that are  malleable near ambient temperatures. They include higher alkanes and lipids, typically with melting points above about 40 °C (104 °F), melting to give low viscosity liquids. Waxes are insoluble in water but soluble in nonpolar organic solvents such as hexane, benzene and chloroform. Natural waxes of various types are produced by plants and animals and occur in petroleum. Waxes are organic compounds that characteristically consist of long aliphatic alkyl chains, although aromatic compounds may also be present. Natural waxes may contain unsaturated bonds and include various functional groups such as fatty acids, primary and secondary alcohols, ketones, aldehydes and fatty acid esters."}}, {"canonical_name": "diorite", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 29, "members": [{"entity_id": "diorite", "book_id": "relation_historique_humboldt_vol3_1825", "name": "diorite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 17, "variants": ["diorite", "DIORITE", "dlorite", "dolerites", "dolérite", "dolérites"], "contexts": ["type of igneous rock", "diorite rock, geological material"]}, {"entity_id": "diorite", "book_id": "kosmos_humboldt_1845", "name": "diorite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["diorite", "Diorite"], "contexts": ["igneous rock type", "compound rock"]}, {"entity_id": "dolerite", "book_id": "kosmos_humboldt_1845", "name": "dolerite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["dolerite"], "contexts": ["igneous rock type", "rock found in volcanic chains"]}, {"entity_id": "dioritic", "book_id": "kosmos_humboldt_1845", "name": "dioritic", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["dioritic"], "contexts": ["type of rock veins"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "diorite", "target_book": "kosmos_humboldt_1845", "target_name": "diorite", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "diorite", "target_book": "kosmos_humboldt_1845", "target_name": "dolerite", "similarity": 0.842}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "diorite", "target_book": "kosmos_humboldt_1845", "target_name": "dioritic", "similarity": 0.865}], "id": 675, "stable_key": "clu_393a707765d65a59", "ground_truth": {"modern_name": "Diorite", "confidence": "high", "type": "mineral", "wikidata_id": "Q187408", "wikidata_description": "deep igneous rocks made of equal amounts of alkali feldspar and intermediate plagioclase, the most common stained ingredients are amphibole, biotite and pyroxene, and accessory minerals apatite and sfen; volcanic equivalent: tackle.", "wikipedia_extract": "In geology, a rock (also called a stone) is any naturally occurring solid mass or aggregate of minerals or mineraloid matter. It is categorized by the minerals included, its chemical composition, and the way in which it is formed. Rocks form the Earth's outer solid layer, the crust, and most of its interior, except for the liquid outer core and pockets of magma in the asthenosphere. The study of rocks involves multiple subdisciplines of geology, including petrology and mineralogy. It may be limited to rocks found on Earth, or it may include planetary geology that studies the rocks of other celestial objects. Rocks are usually grouped into three main groups: igneous rocks, sedimentary rocks and metamorphic rocks.", "wikipedia_url": "https://en.wikipedia.org/wiki/Diorite"}}, {"canonical_name": "Anici", "category": "PLANT", "subcategory": "SEED", "book_count": 2, "total_mentions": 29, "members": [{"entity_id": "anici", "book_id": "ricettario_fiorentino_1597", "name": "Anici", "category": "PLANT", "subcategory": "SEED", "count": 27, "variants": ["Anici", "Anaci", "Anaci crudi", "di Anici"], "contexts": ["seeds used in decoctions", "ingredient in decoction"]}, {"entity_id": "anis", "book_id": "historia_medicinal_monardes_1574", "name": "Anis", "category": "PLANT", "subcategory": "SEED", "count": 2, "variants": ["Anis"], "contexts": ["anise, herb used in water", "seed that causes pleasant dreams"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Anici", "target_book": "historia_medicinal_monardes_1574", "target_name": "Anis", "similarity": 0.907}], "id": 676, "stable_key": "clu_65a9f681638fd318", "ground_truth": {"modern_name": "Anise", "confidence": "high", "type": "plant", "description": "Seeds of a plant used in decoctions and for pleasant dreams.", "wikipedia_extract": "Anise (; Pimpinella anisum), also called aniseed or rarely anix, is a flowering plant in the family Apiaceae native to the eastern Mediterranean region and Southwest Asia. The flavor and aroma of its seeds have similarities with some other spices and herbs, such as star anise, fennel, liquorice, and tarragon. It is widely cultivated and used to flavor food, candy, and alcoholic drinks, especially around the Mediterranean. The name \"anise\" is derived via Old French from the Latin words anīsum or anēthum from Greek ἄνηθον ánēthon referring to dill. An obsolete English word for anise is anet, also coming from anīsum. Anise is an herbaceous annual plant growing to 60–90 centimetres (2–3 feet) or more."}}, {"canonical_name": "almisque", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 29, "members": [{"entity_id": "almisque", "book_id": "coloquios_da_orta_1563", "name": "almisque", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 15, "variants": ["almisque", "almisare", "almiscar", "almiscre", "almisquere", "almíscar"], "contexts": ["fragrant substance", "substance added to bangue"]}, {"entity_id": "almiscar", "book_id": "polyanthea_medicinal", "name": "almiscar", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 14, "variants": ["almiscar", "Almifcar", "almifcar", "almilcar", "almıſcar"], "contexts": ["animal product", "used for perfuming"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "almisque", "target_book": "polyanthea_medicinal", "target_name": "almiscar", "similarity": 0.911}], "id": 677, "stable_key": "clu_238d88b5e2e91c2a", "ground_truth": {"modern_name": "Musk", "confidence": "high", "type": "animal", "description": "Fragrant animal product used in perfumery and other preparations.", "note": "Refers to the substance obtained from glands of the musk deer.", "wikipedia_extract": "Musk is a class of aromatic substances commonly used as base notes in perfumery. They include glandular secretions from animals such as the musk deer, numerous plants emitting similar fragrances, and artificial substances with similar odors. Musk was a name originally given to a substance with a strong odor obtained from a gland of the musk deer. The substance has been used as a popular perfume fixative since ancient times and is one of the most expensive animal products in the world. The name originates from the Late Greek μόσχος 'moskhos', from Persian mushk and Sanskrit मुष्क muṣka (lit. 'testicle') derived from Proto-Indo-European noun múh₂s meaning \"mouse\". The deer gland was thought to resemble a scrotum."}}, {"canonical_name": "Rhewm", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 28, "members": [{"entity_id": "rhewm", "book_id": "english_physician_1652", "name": "Rhewm", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 26, "variants": ["Rhewm"], "contexts": ["mucus", "bodily fluid causing tooth pain"]}, {"entity_id": "renum", "book_id": "polyanthea_medicinal", "name": "renum", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["renum"], "contexts": ["kidney", "kidneys"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Rhewm", "target_book": "polyanthea_medicinal", "target_name": "renum", "similarity": 0.845}], "id": 678, "stable_key": "clu_ac4d02379b457fa2", "ground_truth": {"modern_name": "Rheum", "confidence": "high", "type": "substance", "description": "Bodily fluid, typically mucus, associated with illness and anatomy.", "note": "This cluster conflates 'rheum' (mucus/discharge) with 'kidney' (renum).", "wikipedia_extract": "Rheum (; from Greek: ῥεῦμα rheuma 'a flowing, rheum') is a thin mucus naturally discharged from the eyes, nose, or mouth, often during sleep (contrast with mucopurulent discharge). Rheum dries and gathers as a crust in the corners of the eyes or the mouth, on the eyelids, or under the nose. It is formed by a combination of mucus (in the case of the eyes, consisting of mucin discharged from the cornea or the conjunctiva), nasal mucus, blood cells, skin cells, or dust. Rheum from the eyes is particularly common. Dried rheum near the eyes is commonly called 'sleep', 'sleepy-seeds', 'sleepy buds', 'sleepy sand', 'eye boogers', 'eye goop', 'sleepies', or 'eye gunk'. When the individual is awake, blinking of the eyelid causes rheum to be washed away with tears via the nasolacrimal duct."}}, {"canonical_name": "Marmelo", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 28, "members": [{"entity_id": "marmelo", "book_id": "polyanthea_medicinal", "name": "Marmelo", "category": "PLANT", "subcategory": "PLANT", "count": 21, "variants": ["Marmelo", "marmelo", "marmelos"], "contexts": ["quince, an ingredient", "quince, a fruit"]}, {"entity_id": "marmelos", "book_id": "coloquios_da_orta_1563", "name": "Marmelos", "category": "PLANT", "subcategory": "PLANT", "count": 7, "variants": ["Marmelos", "marmelios", "marmellos", "marmelo", "marmelos"], "contexts": ["quince, a fruit ingredient", "fruit used for medicine"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Marmelo", "target_book": "coloquios_da_orta_1563", "target_name": "Marmelos", "similarity": 0.969}], "id": 679, "stable_key": "clu_8cbd1c9208e2b041", "ground_truth": {"modern_name": "quince", "confidence": "high", "type": "plant", "linnaean": "Cydonia oblonga", "family": "Rosaceae", "description": "A fragrant, yellow fruit used in cooking and medicine.", "wikipedia_extract": "The quince (; Cydonia oblonga) is the sole member of the genus Cydonia in the Malinae subtribe (which contains apples, pears, and other fruits) of the Rosaceae family. It is a deciduous tree that bears hard, aromatic bright golden-yellow pome fruit, similar in appearance to a pear. Ripe quince fruits are hard, tart, and astringent. They are eaten raw or processed into jam, quince cheese, or alcoholic drinks. The quince tree is sometimes grown as an ornamental plant for its attractive pale pink blossoms and as a miniature bonsai plant. Quinces are shrubs or small trees up to 4 to 6 metres (13 to 20 feet) tall and 3 to 4.5 metres (10 to 15 feet) wide."}}, {"canonical_name": "Arruda", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 28, "members": [{"entity_id": "arruda", "book_id": "polyanthea_medicinal", "name": "Arruda", "category": "PLANT", "subcategory": "PLANT", "count": 24, "variants": ["Arruda", "aarruda", "arruda", "arruda verde", "arrudameya"], "contexts": ["herb used in remedies", "rue, ingredient for ointment"]}, {"entity_id": "arruda", "book_id": "coloquios_da_orta_1563", "name": "arruda", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["arruda", "aruda"], "contexts": ["herb used medicinally and in salads", "herb"]}, {"entity_id": "arundo", "book_id": "coloquios_da_orta_1563", "name": "Arundo", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Arundo"], "contexts": ["plant from southern Europe"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Arruda", "target_book": "coloquios_da_orta_1563", "target_name": "arruda", "similarity": 0.977}, {"source_book": "polyanthea_medicinal", "source_name": "Arruda", "target_book": "coloquios_da_orta_1563", "target_name": "Arundo", "similarity": 0.848}], "id": 680, "stable_key": "clu_45f45d038dd12934", "ground_truth": {"modern_name": "rue", "confidence": "high", "type": "plant", "linnaean": "Ruta graveolens", "family": "Rutaceae", "description": "A pungent herb used medicinally and in culinary preparations.", "note": "Arundo is likely a misspelling or variant of arruda.", "wikipedia_extract": "Ruta graveolens, commonly known as rue, common rue, ruda, arruda or herb-of-grace, is a species of the genus Ruta grown as an ornamental plant and herb. It is native to the Mediterranean. It is grown throughout the world in gardens, especially for its bluish leaves, and sometimes for its tolerance of hot and dry soil conditions. It is also cultivated as a culinary herb, and to a lesser extent as an insect repellent and incense. The specific epithet graveolens refers to the strong-smelling leaves. Rue is a woody, perennial shrub."}}, {"canonical_name": "Uranus", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 28, "members": [{"entity_id": "uranus", "book_id": "kosmos_humboldt_1845", "name": "Uranus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 27, "variants": ["Uranus"], "contexts": ["outer planetary group member", "planet with satellites"]}, {"entity_id": "uria", "book_id": "coloquios_da_orta_1563", "name": "Uria", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Uria"], "contexts": ["alternative name for Orixá"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Uranus", "target_book": "coloquios_da_orta_1563", "target_name": "Uria", "similarity": 0.854}], "id": 681, "stable_key": "clu_8926a698e6b281fa", "ground_truth": {"modern_name": "Uranus", "confidence": "high", "type": "concept", "note": "The context refers to Uranus as a planet, not a place or deity in the context of scientific texts, despite the mention of 'Orixá'.", "wikipedia_extract": "Sailor Uranus (Japanese: セーラーウラヌス, Hepburn: Sērā Uranusu) is a fictional character in the Sailor Moon media franchise. Sailor Uranus' alternate identity is Haruka Tenou (天王 はるか, Ten'ō Haruka; renamed \"Amara Tenoh\" in some English adaptations), a teenage Japanese student and race car driver. Haruka is a member of the Sailor Guardians, female supernatural fighters who protect the Solar System from evil. Sailor Uranus fights alongside her partner and lover Sailor Neptune. Sailor Uranus possesses powers associated with the wind and sky, precognition, as well as sword combat. Haruka is a stubborn, protective individual, as well as strong-willed, capable, charming, and occasionally even daring.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sailor_Uranus"}}, {"canonical_name": "Annuaire", "category": "ORGANIZATION", "subcategory": "JOURNAL", "book_count": 2, "total_mentions": 28, "members": [{"entity_id": "annuaire", "book_id": "kosmos_humboldt_1845", "name": "Annuaire", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 26, "variants": ["Annuaire"], "contexts": ["publication cited for comet data", "annual publication containing astronomical data"]}, {"entity_id": "annuaire_de", "book_id": "kosmos_humboldt_1845", "name": "Annuaire de", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Annuaire de"], "contexts": ["annual publication"]}, {"entity_id": "annuaire", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Annuaire", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Annuaire"], "contexts": ["publication where treatise appeared"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Annuaire", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Annuaire", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Annuaire de", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Annuaire", "similarity": 0.94}], "id": 682, "stable_key": "clu_5f6738f7b7c256c4", "ground_truth": {"modern_name": "Annuaire", "confidence": "high", "type": "text", "note": "This refers to an annual publication, often a yearbook or astronomical almanac.", "wikidata_id": "Q55740543", "wikidata_description": "prosopographical directory of French learned societies' membership"}}, {"canonical_name": "açucare", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 28, "members": [{"entity_id": "açucare", "book_id": "coloquios_da_orta_1563", "name": "açucare", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 21, "variants": ["açucare"], "contexts": ["ingredient in maju", "sugar, mixed with calamus"]}, {"entity_id": "assucar", "book_id": "polyanthea_medicinal", "name": "assucar", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 5, "variants": ["assucar"], "contexts": ["sugar used in preparation", "sweetener"]}, {"entity_id": "aliucar", "book_id": "polyanthea_medicinal", "name": "aliucar", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["aliucar"], "contexts": ["preparation, used to fill"]}, {"entity_id": "açucar_mascavado", "book_id": "polyanthea_medicinal", "name": "açucar mascavado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["açucar mascavado"], "contexts": ["ingredient in a medicinal aid"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "açucare", "target_book": "polyanthea_medicinal", "target_name": "assucar", "similarity": 0.897}, {"source_book": "coloquios_da_orta_1563", "source_name": "açucare", "target_book": "polyanthea_medicinal", "target_name": "aliucar", "similarity": 0.867}, {"source_book": "coloquios_da_orta_1563", "source_name": "açucare", "target_book": "polyanthea_medicinal", "target_name": "açucar mascavado", "similarity": 0.851}], "id": 683, "stable_key": "clu_9b940f84404037dc", "ground_truth": {"modern_name": "sugar", "confidence": "high", "type": "substance", "description": "A sweet crystalline substance used as a sweetener.", "note": "Includes variations like 'açucar mascavado' (raw sugar).", "wikipedia_extract": "Sugar () is a class of sweet-tasting, soluble carbohydrates, many of which are used in food. Simple sugars, also called monosaccharides, include glucose, fructose, and galactose. Compound sugars, also called disaccharides or double sugars, are molecules made of two bonded monosaccharides; common examples are sucrose (glucose + fructose), lactose (glucose + galactose), and maltose (two molecules of glucose). White sugar is almost pure sucrose. During digestion, compound sugars are hydrolysed into simple sugars. Longer chains of saccharides are not regarded as sugars, and are called oligosaccharides or polysaccharides."}}, {"canonical_name": "laranja", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 28, "members": [{"entity_id": "laranja", "book_id": "coloquios_da_orta_1563", "name": "laranja", "category": "PLANT", "subcategory": "PLANT", "count": 14, "variants": ["laranja", "Laranjas", "larangeira", "laranjas", "laranjeira", "laranjeiras", "naranja"], "contexts": ["fruit, orange", "fruit, juice used in medicine"]}, {"entity_id": "frol_de_laranja", "book_id": "coloquios_da_orta_1563", "name": "frol de laranja", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["frol de laranja"], "contexts": ["orange blossom, used for flavoring"]}, {"entity_id": "flor_de_laranja", "book_id": "polyanthea_medicinal", "name": "flor de laranja", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["flor de laranja", "flor de laran"], "contexts": ["flower used to make scented water", "orange blossom water"]}, {"entity_id": "laranjas_azedas", "book_id": "polyanthea_medicinal", "name": "laranjas azedas", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["laranjas azedas"], "contexts": ["ingredient in purging", "fruit used as remedy"]}, {"entity_id": "laranjas", "book_id": "polyanthea_medicinal", "name": "Laranjas", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Laranjas", "laranjas"], "contexts": ["fruit used to treat coughs", "fruit used as remedy"]}, {"entity_id": "laranja_azeda", "book_id": "polyanthea_medicinal", "name": "laranja azeda", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["laranja azeda"], "contexts": ["sour orange used for treatment", "sour orange"]}, {"entity_id": "laranja", "book_id": "polyanthea_medicinal", "name": "laranja", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["laranja"], "contexts": ["orange used for flowers", "size comparison for bladder stone"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "laranja", "target_book": "polyanthea_medicinal", "target_name": "flor de laranja", "similarity": 0.897}, {"source_book": "coloquios_da_orta_1563", "source_name": "laranja", "target_book": "polyanthea_medicinal", "target_name": "laranjas azedas", "similarity": 0.849}, {"source_book": "coloquios_da_orta_1563", "source_name": "laranja", "target_book": "polyanthea_medicinal", "target_name": "Laranjas", "similarity": 0.966}, {"source_book": "coloquios_da_orta_1563", "source_name": "laranja", "target_book": "polyanthea_medicinal", "target_name": "laranja azeda", "similarity": 0.862}, {"source_book": "coloquios_da_orta_1563", "source_name": "laranja", "target_book": "polyanthea_medicinal", "target_name": "laranja", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "frol de laranja", "target_book": "polyanthea_medicinal", "target_name": "flor de laranja", "similarity": 0.881}], "id": 684, "stable_key": "clu_d01b46c36c14a2ca", "ground_truth": {"modern_name": "orange", "confidence": "high", "type": "plant", "linnaean": "Citrus × sinensis", "family": "Rutaceae", "description": "A citrus fruit and its parts, used in food and medicine.", "note": "Includes mentions of both sweet and sour oranges, as well as blossoms.", "wikipedia_extract": "Citrus × sinensis (sometimes written Citrus sinensis), is a broadleaf evergreen hybrid between pomelo (Citrus maxima) and mandarin (Citrus reticulata). Hybrid sweet oranges are commonly cultivated fruits that include Valencia oranges, blood oranges and navel oranges. The orange fruit is an important agricultural product, used for both the juicy fruit pulp and the aromatic peel (rind). Orange blossoms (the flowers) are used in several different ways, as are the leaves and wood of the tree. The orange blossom, which is the state flower of Florida, is highly fragrant and traditionally associated with good fortune. It has long been popular in bridal bouquets and head wreaths."}}, {"canonical_name": "maçãs de acypreſte", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 28, "members": [{"entity_id": "maçãs_de_acypreſte", "book_id": "polyanthea_medicinal", "name": "maçãs de acypreſte", "category": "PLANT", "subcategory": "PLANT", "count": 27, "variants": ["maçãs de acypreſte", "maças de Acypreſte", "maças deaciprefte", "maçasdeatyprette", "maçã", "maçã de acipreste", "maçãs", "maçãs da anafega", "maçãs de Acipreſte", "maçãs de Anafeg", "maçãs de anafega", "maçãs de anaftega", "maçãs de anaſega", "maçãs de cypreste", "maçãsde cypreſte", "maçãsdeacypreſte", "pò de maça de Acypreſte"], "contexts": ["cypress apple used in unguent", "cypress apples"]}, {"entity_id": "maçãas_de_anáfega", "book_id": "coloquios_da_orta_1563", "name": "maçãas de anáfega", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["maçãas de anáfega"], "contexts": ["Type of apples discussed"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "maçãs de acypreſte", "target_book": "coloquios_da_orta_1563", "target_name": "maçãas de anáfega", "similarity": 0.853}], "id": 685, "stable_key": "clu_e4b9abae689f33dc", "ground_truth": {"modern_name": "cypress apple", "confidence": "high", "type": "plant", "family": "Cupressaceae", "description": "The fruit-like gall produced by cypress trees, used in remedies.", "note": "Also referred to as 'maçãa de anáfega', likely a regional variant.", "wikipedia_extract": "Cypress is a common name for species in several genera in the family Cupressaceae. They grow in temperate climates and subtropical regions of Asia, Europe, and North America. The word cypress is derived from Old French cipres, which was imported from Latin cypressus, the latinisation of the Greek κυπάρισσος (kyparissos). The name derives from Cyparissus, a mythological figure who was turned into a cypress tree after killing a stag. Cypresses are trees or shrubs reaching heights of 1–50 metres (3.3–164.0 ft), exceptionally (in Cupressus austrotibetica) 100 m (330 ft). Many exhibit a conical to columnar form, particularly in their youth, but some are prostrate, irregular, or shrubby."}}, {"canonical_name": "Paraguay", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 27, "members": [{"entity_id": "paraguay", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Paraguay", "category": "PLACE", "subcategory": "COUNTRY", "count": 25, "variants": ["Paraguay"], "contexts": ["province in the first category of census", "territory with boundary commissions"]}, {"entity_id": "paraguay", "book_id": "origin_of_species_darwin_1859", "name": "Paraguay", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Paraguay"], "contexts": ["location with specific fly affecting animals", "location where cattle are destroyed"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Paraguay", "target_book": "origin_of_species_darwin_1859", "target_name": "Paraguay", "similarity": 1.0}], "id": 686, "stable_key": "clu_32b4a9316825aff0", "ground_truth": {"modern_name": "Paraguay", "confidence": "high", "type": "place", "description": "A country in South America, historically a province.", "wikipedia_extract": "Paraguay (Guarani: Paraguái), officially the Republic of Paraguay, is a landlocked country located in the central region of South America. It borders Bolivia to the northwest and north, Brazil to the northeast and east, and Argentina to the southeast, south, and west. Paraguay has access to the Atlantic Ocean via the Paraná–Paraguay Waterway. The country is governed as a unitary presidential republic composed of a capital district and seventeen departments. Its capital and largest city is Asunción. The indigenous Guaraní had been living in eastern Paraguay for at least a millennium before the arrival of Spanish conquistadores in 1524."}}, {"canonical_name": "hybrids", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 27, "members": [{"entity_id": "hybrids", "book_id": "origin_of_species_darwin_1859", "name": "hybrids", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 20, "variants": ["Hybrids", "hybrids"], "contexts": ["sterile offspring of different species", "offspring of different species or varieties"]}, {"entity_id": "hybrid", "book_id": "origin_of_species_darwin_1859", "name": "hybrid", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 6, "variants": ["hybrid"], "contexts": ["offspring of two different species", "offspring of different species"]}, {"entity_id": "hybrids", "book_id": "first_principles_spencer_1862", "name": "hybrids", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["hybrids"], "contexts": ["offspring of different species or breeds"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "hybrids", "target_book": "first_principles_spencer_1862", "target_name": "hybrids", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hybrid", "target_book": "first_principles_spencer_1862", "target_name": "hybrids", "similarity": 0.984}], "id": 687, "stable_key": "clu_f5822507773ae11d", "ground_truth": {"modern_name": "Hybrid", "confidence": "high", "type": "concept", "note": "The context refers to the scientific concept of hybridity, particularly as discussed in Darwin's 'Origin of Species'.", "wikidata_id": "Q721808", "wikidata_description": "genetic process of crossbreeding between genetically dissimilar parents to produce a hybrid", "wikipedia_url": "https://en.wikipedia.org/wiki/Hybrid_(biology)", "wikipedia_extract": "In biology, a hybrid is the offspring resulting from combining the qualities of two organisms of different varieties, subspecies, species or genera through sexual reproduction. Generally, it means that each cell has genetic material from two different organisms, whereas an individual where some cells are derived from a different organism is called a chimera. Hybrids are not always intermediates between their parents such as in blending inheritance (a now discredited theory in modern genetics by particulate inheritance), but can show hybrid vigor, sometimes growing larger or taller than either parent. The concept of a hybrid is interpreted differently in animal and plant breeding, where there is interest in the individual parentage. In genetics, attention is focused on the numbers of chromosomes. In taxonomy, a key question is how closely related the parent species are."}}, {"canonical_name": "Martinique", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 27, "members": [{"entity_id": "martinique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Martinique", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 25, "variants": ["Martinique"], "contexts": ["Barbade, Martinique and Saint-Thomas", "island with easier communication"]}, {"entity_id": "martinique", "book_id": "kosmos_humboldt_1845", "name": "Martinique", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Martinique"], "contexts": ["island where earthquake was felt", "island in the Antilles"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Martinique", "target_book": "kosmos_humboldt_1845", "target_name": "Martinique", "similarity": 1.0}], "id": 688, "stable_key": "clu_c33e7b947df4e195", "ground_truth": {"modern_name": "Martinique", "confidence": "high", "type": "place", "country": "France", "wikidata_id": "Q17054", "wikidata_description": "island in the Lesser Antilles, overseas region and department of France", "wikipedia_url": "https://en.wikipedia.org/wiki/Martinique", "wikipedia_extract": "Saint-Pierre (, ; French pronunciation: [sɛ̃ pjɛʁ] ; Martinican Creole: Senpiè) is a town and commune of France's Caribbean overseas department of Martinique, founded in 1635 by Pierre Belain d'Esnambuc. Before the total destruction of Saint-Pierre by a volcanic eruption in 1902, it was the most important city of Martinique culturally and economically, being known as \"the Paris of the Caribbean\". While Fort-de-France was the official administrative capital, Saint-Pierre was the cultural capital of Martinique. After the disaster, Fort-de-France grew in economic importance. Saint-Pierre was founded in 1635 by Pierre Belain d'Esnambuc, a French trader and adventurer, as the first permanent French colony on the island of Martinique. The Great Hurricane of 1780 produced a storm-surge of 8 metres (25 ft) which \"inundated the city, destroying all houses\" and killed 9,000 people."}}, {"canonical_name": "Valencia", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 27, "members": [{"entity_id": "valencia", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Valencia", "category": "PLACE", "subcategory": "CITY", "count": 19, "variants": ["Valencia", "Valence"], "contexts": ["lake mentioned in map description", "place name in Venezuela"]}, {"entity_id": "nueva_valencia", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Nueva Valencia", "category": "PLACE", "subcategory": "CITY", "count": 7, "variants": ["Nueva Valencia", "Nueva-Valencia"], "contexts": ["city in Caracas province", "city in Venezuela"]}, {"entity_id": "nueva_valencia", "book_id": "kosmos_humboldt_1845", "name": "Nueva Valencia", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Nueva Valencia"], "contexts": ["city near Trincheras hot springs"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Valencia", "target_book": "kosmos_humboldt_1845", "target_name": "Nueva Valencia", "similarity": 0.868}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Nueva Valencia", "target_book": "kosmos_humboldt_1845", "target_name": "Nueva Valencia", "similarity": 1.0}], "id": 689, "stable_key": "clu_676f40663631234c", "ground_truth": {"modern_name": "Valencia", "confidence": "high", "type": "place", "country": "Venezuela", "note": "The presence of 'Nueva Valencia' and context of Caracas province strongly points to the Venezuelan city.", "wikidata_id": "Q54880", "wikidata_description": "city in Carabobo State, Venezuela", "wikipedia_url": "https://en.wikipedia.org/wiki/Valencia%2C%20Venezuela"}}, {"canonical_name": "Murta", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 27, "members": [{"entity_id": "murta", "book_id": "polyanthea_medicinal", "name": "Murta", "category": "PLANT", "subcategory": "PLANT", "count": 18, "variants": ["murta", "Murta"], "contexts": ["ingredient in a wine decoction", "leaves used in a preparation"]}, {"entity_id": "murta", "book_id": "coloquios_da_orta_1563", "name": "murta", "category": "PLANT", "subcategory": "PLANT", "count": 8, "variants": ["murta"], "contexts": ["plant for comparison", "leaves similar to Galanga's"]}, {"entity_id": "murta_verde", "book_id": "polyanthea_medicinal", "name": "murta verde", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["murta verde"], "contexts": ["green myrtle leaves used in remedy"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Murta", "target_book": "coloquios_da_orta_1563", "target_name": "murta", "similarity": 0.947}, {"source_book": "coloquios_da_orta_1563", "source_name": "murta", "target_book": "polyanthea_medicinal", "target_name": "murta verde", "similarity": 0.821}], "id": 690, "stable_key": "clu_38c699f3cbce1484", "ground_truth": {"modern_name": "Myrtle", "confidence": "high", "type": "plant", "linnaean": "Myrtus communis", "family": "Myrtaceae", "description": "A flowering shrub with aromatic leaves and berries.", "wikipedia_extract": "Myrtus communis, the common myrtle or true myrtle, is a species of flowering plant in the myrtle family Myrtaceae. It is an evergreen shrub native to southern Europe, North Africa, Western Asia, Macaronesia, and the Indian subcontinent, and also cultivated. The plant is an evergreen shrub or small tree, growing to 5 metres (16 ft) tall. The leaves are 2–5 centimetres (1–2 in) long, with a fragrant essential oil. The flowers are white or tinged with pink, with five petals and many stamens that protrude from the flower. The fruit is an edible berry, blue-black when ripe."}}, {"canonical_name": "Vacca", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 27, "members": [{"entity_id": "vacca", "book_id": "polyanthea_medicinal", "name": "Vacca", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 20, "variants": ["Vacca", "vaca", "vacas", "vacca", "vaccaguizadas", "vaccana", "vaccas"], "contexts": ["cow", "cow meat"]}, {"entity_id": "vacas", "book_id": "coloquios_da_orta_1563", "name": "vacas", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 7, "variants": ["vacas", "vaca", "vacca"], "contexts": ["comparison for elephant population", "comparison for elephant numbers"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Vacca", "target_book": "coloquios_da_orta_1563", "target_name": "vacas", "similarity": 0.9}], "id": 691, "stable_key": "clu_678cd1a6bfb7b299", "ground_truth": {"modern_name": "Cow", "confidence": "high", "type": "animal", "linnaean": "Bos taurus", "family": "Bovidae", "description": "Domesticated bovine animal, raised for milk, meat, and labor.", "wikipedia_extract": "Cattle (Bos taurus) are large, domesticated, bovid ungulates widely kept as livestock. They are prominent modern members of the subfamily Bovinae and the most widespread species of the genus Bos. Mature female cattle are called cows and mature males are called bulls. Taurine cattle are widely distributed across Europe and temperate areas of Asia, the Americas, and Australia. Zebus are found mainly in India and tropical areas of Asia, America, and Australia. Sanga cattle are found primarily in sub-Saharan Africa."}}, {"canonical_name": "colerico", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 27, "members": [{"entity_id": "colerico", "book_id": "polyanthea_medicinal", "name": "colerico", "category": "CONCEPT", "subcategory": "THEORY", "count": 26, "variants": ["colerico", "colericas"], "contexts": ["related to choleric humor", "related to choler"]}, {"entity_id": "coléricos", "book_id": "coloquios_da_orta_1563", "name": "coléricos", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["coléricos"], "contexts": ["humoral type"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "colerico", "target_book": "coloquios_da_orta_1563", "target_name": "coléricos", "similarity": 0.843}], "id": 692, "stable_key": "clu_433fc81821157974", "ground_truth": {"modern_name": "Choleric", "confidence": "high", "type": "concept", "description": "Relating to the humor of yellow bile in humoral theory.", "note": "Refers to the humoral theory of medicine.", "wikipedia_extract": "The four temperament theory is a proto-psychological theory which suggests that there are four fundamental personality types: sanguine, choleric, melancholic, and phlegmatic. Most formulations include the possibility of mixtures among the types where an individual's personality types overlap and they share two or more temperaments. Greek physician Hippocrates (c. 460 – c. 370 BC) described the four temperaments as part of the ancient medical concept of humourism, that four bodily fluids affect human personality traits and behaviours. Modern medical science does not define a fixed relationship between internal secretions and personality, although some psychological personality type systems use categories similar to the Greek temperaments. The four temperament theory was abandoned after the 1850s. Temperament theory has its roots in the ancient theory of humourism."}}, {"canonical_name": "emplastro", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 27, "members": [{"entity_id": "emplastro", "book_id": "polyanthea_medicinal", "name": "emplastro", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 11, "variants": ["emplastro", "emplasto", "emplastro confortativo", "emplastro de Diafulphur", "emplastro de Diaquilað", "emplastro de Galba", "emplastros confortativos"], "contexts": ["poultice or plaster, a topical application", "medical application"]}, {"entity_id": "emplasto", "book_id": "historia_medicinal_monardes_1574", "name": "emplasto", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["emplasto", "emplastos"], "contexts": ["preparation applied externally", "form of application for Ambar"]}, {"entity_id": "emplaftro", "book_id": "polyanthea_medicinal", "name": "emplaftro", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 11, "variants": ["emplaftro", "emplaf tro", "emplaftrode diapalma", "emplaftros"], "contexts": ["a medicinal plaster", "plaster applied to the stomach"]}, {"entity_id": "emplaftos", "book_id": "historia_medicinal_monardes_1574", "name": "emplaftos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["emplaftos", "emplalto"], "contexts": ["preparations in apothecaries", "poultice made from herb for pain"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "emplastro", "target_book": "historia_medicinal_monardes_1574", "target_name": "emplasto", "similarity": 0.941}, {"source_book": "polyanthea_medicinal", "source_name": "emplaftro", "target_book": "historia_medicinal_monardes_1574", "target_name": "emplaftos", "similarity": 0.91}], "id": 693, "stable_key": "clu_7d6aeee7b6dd7790", "ground_truth": {"modern_name": "Plaster/Poultice", "confidence": "high", "type": "substance", "description": "A medicinal preparation applied externally to the skin.", "wikipedia_extract": "Fernando Jorge da Silva dos Santos (born 25 April 1971), commonly known by the nickname Emplastro (Portuguese pronunciation: [ẽ'plaʃtɾu]; \"poultice\"), is a Portuguese football fan who became a public figure for videobombing television reporters by staying close behind them. Born in Madalena, Vila Nova de Gaia, into a poor family, Santos, along with his four siblings, became orphans when he was still a child. Due to his mental development difficulties, Santos was accompanied by Gaia's CERCI since he was eight years old, and after leaving the cooperative, he worked at Panificadora Coelho in Vilar do Paraíso, Gaia, for fifteen years. After leaving that job for disability, he began to dedicate himself to his passion for football. His fame in the world of football began in the early 1990s when he started to appear behind television reporters, or on stadium stands covered by TV cameras, whenever there was a big football match or another major media event. He also popularized himself for the saying \"My father is Pinto da Costa and my mother is Vítor Baía\"."}}, {"canonical_name": "Strangury", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 26, "members": [{"entity_id": "strangury", "book_id": "english_physician_1652", "name": "Strangury", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 25, "variants": ["Strangury", "strangurie", "strangury"], "contexts": ["condition helped by herb", "condition treated by Angelica"]}, {"entity_id": "strangulation", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "strangulation", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["strangulation"], "contexts": ["condition caused by sponge distension"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Strangury", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "strangulation", "similarity": 0.846}], "id": 694, "stable_key": "clu_984cb7c491b4cd7e", "ground_truth": {"modern_name": "Strangury", "confidence": "high", "type": "disease", "modern_term": "Strangury", "note": "While 'strangulation' is a similar word, the contexts clearly point to strangury, a medical condition affecting urination.", "wikidata_id": "Q474914", "wikidata_description": "symptom characterized by painful, frequent urination of small volumes", "wikipedia_extract": "Strangury (or stranguria) is the symptom characterized by painful, frequent urination of small volumes that are expelled slowly only by straining and despite a severe sense of urgency, usually with the residual feeling of incomplete emptying. The origin of the term is late 14th-century Middle English from Latin strangūria, from Greek, from stranx, 'a drop squeezed out' and ouron 'urine.' These 'drops' of urine are 'squeezed out' in what patients describe as painful 'wrenching' spasms. The pain is felt to arise in the suprapubic region and extends up to the root of the genitalia and, in male patients, to the tip of the penis. This distressing desire to fully void despite its impossibility is attributed to the irritation of urothelium (epithelium lining the urinary tract), especially of the trigone, and subsequent spasm of muscles. It is seen in numerous urological conditions including kidney stones (especially when a stone is impacted at the vesicourethral junction), bladder stones, bladder inflammation (cystitis), and bladder cancer."}}, {"canonical_name": "Fistulaes", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 26, "members": [{"entity_id": "fistulaes", "book_id": "english_physician_1652", "name": "Fistulaes", "category": "DISEASE", "subcategory": "CHRONIC", "count": 19, "variants": ["Fistulaes"], "contexts": ["abnormal passages in the body", "gangrenes and fistulae"]}, {"entity_id": "fistula", "book_id": "polyanthea_medicinal", "name": "fistula", "category": "DISEASE", "subcategory": "CHRONIC", "count": 6, "variants": ["fistula", "Fistula"], "contexts": ["medical condition", "abnormal passage or duct"]}, {"entity_id": "flatuoſa", "book_id": "polyanthea_medicinal", "name": "flatuoſa", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["flatuoſa"], "contexts": ["colic caused by gas"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Fistulaes", "target_book": "polyanthea_medicinal", "target_name": "fistula", "similarity": 0.961}, {"source_book": "english_physician_1652", "source_name": "Fistulaes", "target_book": "polyanthea_medicinal", "target_name": "flatuoſa", "similarity": 0.85}], "id": 695, "stable_key": "clu_89c50c57dbde8a19", "ground_truth": {"modern_name": "Fistula", "confidence": "high", "type": "disease", "description": "An abnormal passage or duct in the body, often leading to disease.", "wikipedia_extract": "In anatomy, a fistula (pl.: fistulas or fistulae ; from Latin fistula, \"tube, pipe\") is an abnormal connection (i.e. tube) joining two hollow spaces (technically, two epithelialized surfaces), such as blood vessels, intestines, or other hollow organs to each other, often resulting in an abnormal flow of fluid from one space to the other. An anal fistula connects the anal canal to the perianal skin. An anovaginal or rectovaginal fistula is a hole joining the anus or rectum to the vagina. A colovaginal fistula joins the  space in the colon to that in the vagina. A urinary tract fistula is an abnormal opening in the urinary tract or an abnormal connection between the urinary tract and another organ. An abnormal communication (i.e. hole or tube) between the bladder and the uterus is called a vesicouterine fistula, while if it is between the bladder and the vagina it is known as a vesicovaginal fistula, and if between the urethra and the vagina: a urethrovaginal fistula."}}, {"canonical_name": "Silla de Caracas", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 26, "members": [{"entity_id": "silla_de_caracas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Silla de Caracas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 25, "variants": ["Silla de Caracas", "La Silla de Caracas", "Pic oriental de la Silla de Caracas", "Silla", "Silla de Cayo Romano", "Silla de Ciracas", "Silla de Veragua"], "contexts": ["granitic mountain chain", "mountain in the Cordilleras of the coast"]}, {"entity_id": "silla_of_caraccas", "book_id": "origin_of_species_darwin_1859", "name": "Silla of Caraccas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Silla of Caraccas"], "contexts": ["mountain in Venezuela"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Silla de Caracas", "target_book": "origin_of_species_darwin_1859", "target_name": "Silla of Caraccas", "similarity": 0.961}], "id": 696, "stable_key": "clu_034810350a1cf242", "ground_truth": {"modern_name": "El Ávila National Park", "confidence": "high", "type": "place", "description": "A prominent mountain peak and national park near Caracas, Venezuela.", "note": "The 'Silla de Caracas' refers to the mountain peak which is now part of El Ávila National Park.", "wikipedia_extract": "The Ávila National Park, officially known as Waraira Repano National Park for its indigenous Cariban name, protects part of the Cordillera de la Costa Central mountain range, in the coastal region of central-northern Venezuela. The area's highest elevation is Pico Naiguatá, at 2,765 meters (9,072 ft) above sea level. El Ávila is known as \"el pulmón de la ciudad\", the lungs of the city, since it serves many different functions for residents of Caracas, the most basic of these being navigation: the peak of El Ávila marks the north of the city. It is home to the longest cable car ride in the world, as well as activities like running, biking, rock climbing, camping, and zip-lining. El Hotel Humboldt as well as many restaurants, including La Chivera, Casa Pakea, El Jardín de Luna, Le Galipanier, Granja Natalia and Tarahumara, are all nestled in the mountain's hills. Every December, the \"Cruz de Navidad\" is illuminated, a large crucifix high up in the mountain that faces the city and can be seen from very far distances."}}, {"canonical_name": "Comptes Rendus", "category": "ORGANIZATION", "subcategory": "JOURNAL", "book_count": 2, "total_mentions": 26, "members": [{"entity_id": "comptes_rendus", "book_id": "kosmos_humboldt_1845", "name": "Comptes Rendus", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 11, "variants": ["Comptes Rendus"], "contexts": ["scientific publication", "publication cited for meteor path"]}, {"entity_id": "comptes_rendus", "book_id": "principles_of_psychology_james_1890", "name": "Comptes Rendus", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 3, "variants": ["Comptes Rendus"], "contexts": ["scientific journal", "journal of French Academy of Sciences"]}, {"entity_id": "comptes_rendus_de_l'acad__d__sciences", "book_id": "principles_of_psychology_james_1890", "name": "Comptes Rendus de l'Acad. d. Sciences", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Comptes Rendus de l'Acad. d. Sciences"], "contexts": ["scientific journal of the Academy of Sciences"]}, {"entity_id": "comptes_rendus_de_l'acad__des_sciences", "book_id": "kosmos_humboldt_1845", "name": "Comptes Rendus de l'Acad. des Sciences", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 5, "variants": ["Comptes Rendus de l'Acad. des Sciences"], "contexts": ["proceedings of the Academy of Sciences", "publication referencing Lapland observations"]}, {"entity_id": "comptes_rendus_des_seances_de_l'academie", "book_id": "kosmos_humboldt_1845", "name": "Comptes Rendus des Seances de l'Academie", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 2, "variants": ["Comptes Rendus des Seances de l'Academie"], "contexts": ["publication where Laugier's work appeared", "French scientific journal"]}, {"entity_id": "comptes_rendus_des_seances_de_l'acad_", "book_id": "kosmos_humboldt_1845", "name": "Comptes Rendus des Seances de l'Acad.", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Comptes Rendus des Seances de l'Acad."], "contexts": ["publication cited for comet data"]}, {"entity_id": "comptes_rendus_de_l'academie_de_science", "book_id": "kosmos_humboldt_1845", "name": "Comptes Rendus de l'Academie de Science", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Comptes Rendus de l'Academie de Science"], "contexts": ["scientific journal"]}, {"entity_id": "comptes_rendus_de_l'academie_des_sciences", "book_id": "kosmos_humboldt_1845", "name": "Comptes Rendus de l'Academie des Sciences", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Comptes Rendus de l'Academie des Sciences"], "contexts": ["French Academy of Sciences proceedings"]}, {"entity_id": "comptes_rendus_des_seances_de_l'acad__des_sciences", "book_id": "kosmos_humboldt_1845", "name": "Comptes Rendus des Seances de l'Acad. des Sciences", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Comptes Rendus des Seances de l'Acad. des Sciences"], "contexts": ["scientific publication"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Comptes Rendus", "target_book": "principles_of_psychology_james_1890", "target_name": "Comptes Rendus", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Comptes Rendus", "target_book": "principles_of_psychology_james_1890", "target_name": "Comptes Rendus de l'Acad. d. Sciences", "similarity": 0.82}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Comptes Rendus de l'Acad. d. Sciences", "target_book": "kosmos_humboldt_1845", "target_name": "Comptes Rendus de l'Acad. des Sciences", "similarity": 0.994}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Comptes Rendus de l'Acad. d. Sciences", "target_book": "kosmos_humboldt_1845", "target_name": "Comptes Rendus des Seances de l'Academie", "similarity": 0.859}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Comptes Rendus de l'Acad. d. Sciences", "target_book": "kosmos_humboldt_1845", "target_name": "Comptes Rendus des Seances de l'Acad.", "similarity": 0.877}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Comptes Rendus de l'Acad. d. Sciences", "target_book": "kosmos_humboldt_1845", "target_name": "Comptes Rendus de l'Academie de Science", "similarity": 0.976}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Comptes Rendus de l'Acad. d. Sciences", "target_book": "kosmos_humboldt_1845", "target_name": "Comptes Rendus de l'Academie des Sciences", "similarity": 0.979}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Comptes Rendus de l'Acad. d. Sciences", "target_book": "kosmos_humboldt_1845", "target_name": "Comptes Rendus des Seances de l'Acad. des Sciences", "similarity": 0.943}], "id": 697, "stable_key": "clu_77b604eee88d04b1", "ground_truth": {"modern_name": "Comptes Rendus de l'Académie des Sciences", "confidence": "high", "type": "text", "note": "This refers to the prominent scientific journal published by the French Academy of Sciences.", "wikidata_id": "Q21384991", "wikidata_description": "scientific journal", "wikipedia_extract": "Louis Pasteur (, French: [lwi pastœʁ] ; 27 December 1822 – 28 September 1895) was a French chemist, pharmacist, and microbiologist renowned for his discoveries of the principles of vaccination, microbial fermentation, and pasteurization, the last of which was named after him. His research in chemistry led to remarkable breakthroughs in the understanding of the causes and preventions of diseases, which laid down the foundations of hygiene, public health and much of modern medicine. Pasteur's works are credited with saving millions of lives through the developments of vaccines for rabies and anthrax. He is regarded as one of the founders of modern bacteriology and has been honored as the \"father of bacteriology\" and the \"father of microbiology\" (together with Robert Koch; the latter epithet also attributed to Antonie van Leeuwenhoek). Pasteur was responsible for disproving the doctrine of spontaneous generation. Under the auspices of the French Academy of Sciences, his experiment demonstrated that in sterilized and sealed flasks, nothing ever developed; conversely, in sterilized but open flasks, microorganisms could grow.", "wikipedia_url": "https://en.wikipedia.org/wiki/Louis_Pasteur"}}, {"canonical_name": "hierapicra", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 26, "members": [{"entity_id": "hierapicra", "book_id": "polyanthea_medicinal", "name": "hierapicra", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 22, "variants": ["hierapicra", "Hierapicra", "Hycrapigra", "Hyerapicra", "Hyerapigra", "dehyera-picra", "hiera-picia", "hierapigra", "hyera-picra", "hyerapicra"], "contexts": ["compound medicine", "a medicinal preparation"]}, {"entity_id": "hiera", "book_id": "ricettario_fiorentino_1597", "name": "Hiera", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["Hiera", "Hiera picra", "Hierapicra"], "contexts": ["compound medicine name", "preparation for pills"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "hierapicra", "target_book": "ricettario_fiorentino_1597", "target_name": "Hiera", "similarity": 0.835}], "id": 698, "stable_key": "clu_98cc8a3a22684b1e", "ground_truth": {"modern_name": "Hierapicra", "confidence": "high", "type": "substance", "description": "A historical medicinal compound, often a purgative.", "note": "Also known as Hiera Picra or Hiera.", "wikipedia_extract": "Centaurea () is a genus of over 700 species of herbaceous thistle-like flowering plants in the family Asteraceae. Members of the genus are found only north of the equator, mostly in the Eastern Hemisphere; the Middle East and surrounding regions are particularly species-rich. Common names for this genus are centaury, centory, starthistles, knapweeds, centaureas and the more ambiguous bluets; a vernacular name used for these plants in parts of England is loggerheads (common knapweed). The Plectocephalus group – possibly a distinct genus – is known as basketflowers. Cornflower is used for a few species, but that term more often specifically means either C. cyanus (the annual cornflower) or Centaurea montana (the perennial cornflower). The common name centaury is sometimes used, although this also refers to the unrelated plant genus Centaurium."}}, {"canonical_name": "Arroz", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 26, "members": [{"entity_id": "arroz", "book_id": "polyanthea_medicinal", "name": "Arroz", "category": "PLANT", "subcategory": "PLANT", "count": 16, "variants": ["Arroz", "arroz"], "contexts": ["rice, an ingredient", "grain used as food"]}, {"entity_id": "aroz", "book_id": "coloquios_da_orta_1563", "name": "aroz", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["aroz"], "contexts": ["used for cleaning pearls", "grain eaten in Balagate"]}, {"entity_id": "arroz", "book_id": "coloquios_da_orta_1563", "name": "arroz", "category": "PLANT", "subcategory": "PLANT", "count": 7, "variants": ["arroz"], "contexts": ["commodity transported", "ingredient in medicine"]}, {"entity_id": "arroztorrado", "book_id": "polyanthea_medicinal", "name": "arroztorrado", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["arroztorrado"], "contexts": ["toasted rice"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Arroz", "target_book": "coloquios_da_orta_1563", "target_name": "aroz", "similarity": 0.948}, {"source_book": "coloquios_da_orta_1563", "source_name": "arroz", "target_book": "polyanthea_medicinal", "target_name": "arroztorrado", "similarity": 0.834}], "id": 699, "stable_key": "clu_10ada8ed1aacd6f4", "ground_truth": {"modern_name": "Rice", "confidence": "high", "type": "plant", "linnaean": "Oryza sativa", "family": "Poaceae", "description": "A staple cereal grain, widely cultivated and consumed globally.", "wikipedia_extract": "Oryza sativa, having the common name Asian cultivated rice, is the much more common of the two rice species cultivated as a cereal, the other species being O. glaberrima, African rice. It was first domesticated in the Yangtze River basin in China 13,500 to 8,200 years ago. Oryza sativa belongs to the genus Oryza and the BOP clade in the grass family Poaceae. With a genome consisting of 430 Mbp across 12 chromosomes, it is renowned for being easy to genetically modify and is a model organism for the study of the biology of cereals and monocots. O. sativa has an erect stalk stem that grows 80–120 cm (30–45 in) tall, with a smooth surface. The leaf is lanceolate, 15–30 cm (5+7⁄8–11+3⁄4 in) long, and grows from a ligule 10–20 mm (3⁄8–3⁄4 in) long."}}, {"canonical_name": "faculdade", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 25, "members": [{"entity_id": "faculdade", "book_id": "polyanthea_medicinal", "name": "faculdade", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 24, "variants": ["faculdade", "faculdade alternativa", "faculdade aſſimilativa", "faculdade fenfitiva", "faculdade motiva", "faculdade retentiva", "faculdade vital", "faculdadedigeſtiva", "faculdades", "faculdades retentiva, attractiva, & expulfiva", "faculdadestãorendidas", "facultas", "facultat.", "facultatem", "facultatibus"], "contexts": ["faculty, governs movement", "vital faculty or power"]}, {"entity_id": "faculty", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "faculty", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["faculty"], "contexts": ["inherent power or capacity"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "faculdade", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "faculty", "similarity": 0.865}], "id": 700, "stable_key": "clu_ad9555ea82e9f13f", "ground_truth": {"modern_name": "Faculty", "confidence": "high", "type": "concept", "note": "In early modern philosophy and medicine, 'faculty' referred to an inherent power or capacity of an organ or the mind.", "wikipedia_extract": "A faculty or academic division is an academic and administrative unit within a university or college comprising one subject area or a group of related subject areas, possibly also delimited by level (e.g. undergraduate). In North America, academic divisions are sometimes titled colleges, schools, or departments, with universities occasionally using a mixture of terminology, e.g., Harvard University has a Faculty of Arts and Sciences and a Law School. The medieval University of Bologna, which served as a model for most of the later medieval universities in Europe, had four faculties: students began at the Faculty of Arts, graduates from which could then continue at the higher Faculties of Theology, Law, and Medicine. The privilege to establish these four faculties was usually part of medieval universities' charters, but not every university could do so in practice. The Faculty of Arts took its name from the seven liberal arts: the trivium (grammar, rhetoric, dialectics) and the quadrivium (arithmetic, music, geometry and astronomy).", "wikipedia_url": "https://en.wikipedia.org/wiki/Faculty_(division)"}}, {"canonical_name": "Calabozo", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 25, "members": [{"entity_id": "calabozo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Calabozo", "category": "PLACE", "subcategory": "CITY", "count": 24, "variants": ["Calabozo"], "contexts": ["location with astronomical determinations", "region with steppes"]}, {"entity_id": "calabozo", "book_id": "kosmos_humboldt_1845", "name": "Calabozo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Calabozo"], "contexts": ["grassy plains where loud noise was heard"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Calabozo", "target_book": "kosmos_humboldt_1845", "target_name": "Calabozo", "similarity": 0.846}], "id": 701, "stable_key": "clu_cbe382ce8a1d0206", "ground_truth": {"modern_name": "Calabozo", "confidence": "high", "type": "place", "country": "Venezuela", "note": "Calabozo is a known location in Venezuela, particularly associated with Humboldt's travels and scientific observations.", "wikipedia_extract": "Calabozo, officially Villa de Todos los Santos de Calabozo, is a city in Venezuela located in Guárico state, capital of the Francisco de Miranda Municipality and former capital of the state. It has a population of 168,605, according to the National Institute of Statistics (INE) in 2020. It is located in the center-west of Guárico state, and is one of the main rice producers in the country. In addition, it has the largest irrigation system in Venezuela. Calabozo, is a mostly colonial city and is linked to its modern urban areas, being the largest colonial center in the country, and is located at 105 m a.s.l. n. m., at the margin of the Guárico River in the high central plain. Its location is on the banks of the Generoso Campilongo Dam, an important work both in its time and today, being the largest in Venezuela and one of the largest in Latin America."}}, {"canonical_name": "Cayenne", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 25, "members": [{"entity_id": "cayenne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cayenne", "category": "PLACE", "subcategory": "CITY", "count": 22, "variants": ["Cayenne"], "contexts": ["capital of French Guiana", "region south of which plains extend"]}, {"entity_id": "cayenne", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cayenne", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Cayenne"], "contexts": ["location of pendulum observation", "location for pendulum variation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cayenne", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cayenne", "similarity": 1.0}], "id": 702, "stable_key": "clu_9a799d4a551aa66c", "ground_truth": {"modern_name": "Cayenne", "confidence": "high", "type": "place", "country": "France", "note": "Cayenne is the capital of French Guiana, a territory often referenced in historical scientific and geographic accounts.", "wikidata_id": "Q44401", "wikidata_description": "commune and capital city of French Guiana"}}, {"canonical_name": "guzarate", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 25, "members": [{"entity_id": "guzarate", "book_id": "coloquios_da_orta_1563", "name": "guzarate", "category": "PLACE", "subcategory": "REGION", "count": 24, "variants": ["guzarate", "Gu-zarates", "Guxerate", "Guzarate"], "contexts": ["region where gum comes from", "region where substance comes to"]}, {"entity_id": "guzerat", "book_id": "kosmos_humboldt_1845", "name": "Guzerat", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Guzerat"], "contexts": ["location for monsoon naming"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "guzarate", "target_book": "kosmos_humboldt_1845", "target_name": "Guzerat", "similarity": 0.842}], "id": 703, "stable_key": "clu_0c30bb7d3e91d944", "ground_truth": {"modern_name": "Gujarat", "confidence": "high", "type": "place", "country": "India", "wikidata_id": "Q1061", "wikidata_description": "state of India", "wikipedia_url": "https://en.wikipedia.org/wiki/Gujarat", "wikipedia_extract": "Gujarat (Gujarati: Gujarāt, pronounced [ˈɡudʒəɾaːt] ) is a state along the western coast of India. Its coastline of about 2,340 km (1,450 mi) is the longest in the country, most of which lies on the Kathiawar peninsula. Gujarat is the fifth-largest Indian state by area, covering some 196,024 km2 (75,685 mi2); and the ninth-most populous state, with a population of 60.4 million in 2011. It is bordered by Rajasthan to the northeast, Dadra and Nagar Haveli and Daman and Diu to the south, Maharashtra to the southeast, Madhya Pradesh to the east, and the Arabian Sea and the Pakistani province of Sindh to the west. Gujarat's capital city is Gandhinagar, while its largest city is Ahmedabad. The Gujaratis are indigenous to the state, and their language, Gujarati, is the state's official language."}}, {"canonical_name": "Sirius", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 25, "members": [{"entity_id": "sirius", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Sirius", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 21, "variants": ["Sirius"], "contexts": ["star whose rising marked Egyptian year beginning", "star beyond which tail stretched"]}, {"entity_id": "sirius", "book_id": "kosmos_humboldt_1845", "name": "Sirius", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["Sirius"], "contexts": ["star used for distance measurement", "a bright star"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Sirius", "target_book": "kosmos_humboldt_1845", "target_name": "Sirius", "similarity": 1.0}], "id": 704, "stable_key": "clu_3c12b25a2d52eb82", "ground_truth": {"modern_name": "Sirius", "confidence": "high", "type": "object", "note": "While technically an animal in some ancient astrological contexts, its primary early modern scientific significance is as a star.", "wikidata_id": "Q27349673", "wikidata_description": "genus of Gastropoda"}}, {"canonical_name": "manna", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 25, "members": [{"entity_id": "manna", "book_id": "ricettario_fiorentino_1597", "name": "manna", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 15, "variants": ["manna", "MANNA", "Manna", "Manna Calaurefe", "Manna Calaurese", "Manna d'mcenfo", "Manna dVncenfa", "Manna di corpo", "manna d'inccnfo"], "contexts": ["substance with two species", "substance distilled from trees"]}, {"entity_id": "manná", "book_id": "coloquios_da_orta_1563", "name": "manná", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 9, "variants": ["manná", "Manná"], "contexts": ["substance from Persia", "substance in common use"]}, {"entity_id": "manna_eletta", "book_id": "ricettario_fiorentino_1597", "name": "Manna eletta", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Manna eletta"], "contexts": ["sweet ingredient in a preparation"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "manna", "target_book": "coloquios_da_orta_1563", "target_name": "manná", "similarity": 0.868}, {"source_book": "coloquios_da_orta_1563", "source_name": "manná", "target_book": "ricettario_fiorentino_1597", "target_name": "Manna eletta", "similarity": 0.826}], "id": 705, "stable_key": "clu_ac04cb086d63b540", "ground_truth": {"modern_name": "manna", "confidence": "high", "type": "substance", "description": "A sweet, exudate substance from certain trees or plants.", "wikipedia_extract": "Manna (Hebrew: מָן, romanized: mān, Greek: μάννα; Arabic: اَلْمَنُّ), sometimes or archaically spelled mana, is described in the Bible and the Quran as an edible substance that God bestowed upon the Israelites while they were wandering the desert during the 40-year period that followed the Exodus and preceded the conquest of Canaan. In the Hebrew Bible, manna is described twice: once in Exodus 16:1–36 with the full narrative surrounding it, and once again in Numbers 11:1–9 as a part of a separate narrative. In the description in the Book of Exodus, manna is described as being \"a fine, flake-like thing\" like the frost on the ground. It is described in the Book of Numbers as arriving with the dew during the night. Exodus adds that it had to be collected before it was melted by the heat of the Sun, and that it was like a coriander seed in size, but white in colour. Numbers describes it as having the appearance of bdellium, adding that the Israelites ground it and pounded it into cakes, which were then baked, resulting in something that tasted like cakes baked with oil."}}, {"canonical_name": "cebola", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 25, "members": [{"entity_id": "cebola", "book_id": "polyanthea_medicinal", "name": "cebola", "category": "PLANT", "subcategory": "PLANT", "count": 17, "variants": ["cebola", "Cebola", "Cebolas", "cebolas", "cebolla", "cebollas"], "contexts": ["plant, onion", "onion, pungent substance causing tears"]}, {"entity_id": "cebolas", "book_id": "coloquios_da_orta_1563", "name": "cebolas", "category": "PLANT", "subcategory": "PLANT", "count": 8, "variants": ["cebolas", "cebola", "cebolla", "cebollas"], "contexts": ["ingredient for flavoring food", "vegetable, onions"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "cebola", "target_book": "coloquios_da_orta_1563", "target_name": "cebolas", "similarity": 0.957}], "id": 706, "stable_key": "clu_4258944386d586dd", "ground_truth": {"modern_name": "onion", "confidence": "high", "type": "plant", "linnaean": "Allium cepa", "family": "Amaryllidaceae", "description": "A pungent, edible bulb vegetable.", "wikipedia_extract": "The onion (Allium cepa L.Tooltip Carl Linnaeus, from Latin cepa), also known as the bulb onion or common onion, is a vegetable that is the most widely cultivated species of the genus Allium. The shallot is a botanical variety of the onion which was classified as a separate species until 2011. The onion's close relatives include garlic, scallion, leek, and chives. The genus contains several other species variously called onions and cultivated for food, such as the Japanese bunching onion Allium fistulosum, the tree onion Allium × proliferum, and the Canada onion Allium canadense. The name wild onion is applied to a number of Allium species, but A. cepa is exclusively known from cultivation. Its ancestral wild original form is not known, although escapes from cultivation have become established in some regions."}}, {"canonical_name": "Farelos", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 25, "members": [{"entity_id": "farelos", "book_id": "polyanthea_medicinal", "name": "Farelos", "category": "PLANT", "subcategory": "PLANT", "count": 23, "variants": ["Farelos", "farellos", "farelos", "faretos"], "contexts": ["ingredient in a wash", "bran for facilitating digestion"]}, {"entity_id": "farelos", "book_id": "coloquios_da_orta_1563", "name": "farelos", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["farelos"], "contexts": ["bran-like substance", "bran, an ingredient"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Farelos", "target_book": "coloquios_da_orta_1563", "target_name": "farelos", "similarity": 0.893}], "id": 707, "stable_key": "clu_6a86d13426c3298f", "ground_truth": {"modern_name": "bran", "confidence": "high", "type": "substance", "description": "Outer coating of cereal grains, used as food or in preparations.", "wikipedia_extract": "Bran, also known as miller's bran, is the component of a cereal grain consisting of the hard layers – the combined aleurone and pericarp – surrounding the endosperm. Corn (maize) bran also includes the pedicel (tip cap). Along with the germ, it is an integral part of whole grains, and is often produced as a byproduct of milling in the production of refined grains. Bran is highly nutritious, but is difficult to digest due to its high fiber content; its high fat content also reduces its shelf life as the oils/fats are prone to becoming rancid. As such, it is typically removed from whole grain during the refining process – e.g. in processing wheat grain into white flour, or refining brown rice into white rice. Bran is present in cereal grain, including rice, corn (maize), wheat, oats, barley, rye, and millet."}}, {"canonical_name": "hypocondrios", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 24, "members": [{"entity_id": "hypocondrios", "book_id": "polyanthea_medicinal", "name": "hypocondrios", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 23, "variants": ["hypocondrios", "Hypocondrio", "Hypocondrios", "hypocondijs", "hypocondrijs", "hypocondrio", "hypocondrio esquerdo", "hypocondrio eſquerdo", "hypocondriodireyto"], "contexts": ["hypochondria (upper abdomen)", "region of the body"]}, {"entity_id": "hypochon∣dria", "book_id": "english_physician_1652", "name": "Hypochon∣dria", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Hypochon∣dria"], "contexts": ["region associated with windiness"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "hypocondrios", "target_book": "english_physician_1652", "target_name": "Hypochon∣dria", "similarity": 0.855}], "id": 708, "stable_key": "clu_e68c4b49b409a92c", "ground_truth": {"modern_name": "hypochondria", "confidence": "high", "type": "anatomy", "description": "The upper region of the abdomen, below the ribs.", "wikipedia_extract": "Hypochondriasis or hypochondria is a condition in which a person is excessively and unduly worried about having a serious illness. Hypochondria is an old concept whose meaning has repeatedly changed over its lifespan. It has been claimed that this debilitating condition results from an inaccurate perception of the condition of body or mind despite the absence of an actual medical diagnosis. An individual with hypochondriasis is known as a hypochondriac. Hypochondriacs become unduly alarmed about any physical or psychological symptoms they detect, no matter how minor the symptom may be, and are convinced that they have, or are about to be diagnosed with, a serious illness. Often, hypochondria persists even after a physician has evaluated a person and reassured them that their concerns about symptoms do not have an underlying medical basis or, if there is a medical illness, their concerns are far in excess of what is appropriate for the level of disease."}}, {"canonical_name": "Nieue", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 24, "members": [{"entity_id": "nieue", "book_id": "historia_medicinal_monardes_1574", "name": "Nieue", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 23, "variants": ["Nieue", "NIEVE", "Nieuc", "Nieues", "Nieve", "Nieves"], "contexts": ["substance discussed in the text", "substance discussed for its benefits"]}, {"entity_id": "neui", "book_id": "ricettario_fiorentino_1597", "name": "neui", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["neui"], "contexts": ["melted substance"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Nieue", "target_book": "ricettario_fiorentino_1597", "target_name": "neui", "similarity": 0.929}], "id": 709, "stable_key": "clu_b254764e9514cf23", "ground_truth": {"modern_name": "Nevus", "confidence": "high", "type": "disease", "description": "A mole or birthmark on the skin.", "wikipedia_extract": "Nevus (pl. nevi) is a nonspecific medical term for a visible, circumscribed, chronic lesion of the skin or mucosa. The term originates from naevus, which is Latin for \"birthmark\"; however, a nevus can be either congenital (present at birth) or acquired. Common terms (mole, birthmark, beauty mark, etc.) are used to describe nevi, but these terms do not distinguish specific types of nevi from one another. The term nevus is applied to a number of conditions caused by neoplasias and hyperplasias of melanocytes, as well as a number of pigmentation disorders, both hypermelanotic (containing increased melanin, the pigment responsible for skin color) and hypomelanotic (containing decreased melanin). Suspicious skin moles which are multi-colored or pink may be a finding in skin cancer. Melanocytic nevi can be categorized based on the location of melanocytic cells Atypical (dysplastic) nevus: This type of nevus must be diagnosed based on histological features."}}, {"canonical_name": "me", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 24, "members": [{"entity_id": "me", "book_id": "principles_of_psychology_james_1890", "name": "me", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 22, "variants": ["Me", "me", "ME"], "contexts": ["sense of self", "self-identity in psychological division"]}, {"entity_id": "me's", "book_id": "principles_of_psychology_james_1890", "name": "me's", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["me's"], "contexts": ["sense of self"]}, {"entity_id": "mio", "book_id": "coloquios_da_orta_1563", "name": "mio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mio"], "contexts": ["unit of weight"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "me", "target_book": "coloquios_da_orta_1563", "target_name": "mio", "similarity": 0.846}, {"source_book": "principles_of_psychology_james_1890", "source_name": "me's", "target_book": "coloquios_da_orta_1563", "target_name": "mio", "similarity": 0.859}], "id": 710, "stable_key": "clu_a569b8097d96ccc3", "ground_truth": {"modern_name": "The self", "confidence": "high", "type": "concept", "description": "Psychological concept of personal identity and self-awareness.", "note": "The context from James' 'Principles of Psychology' strongly indicates the psychological concept of 'me' as the self.", "wikipedia_extract": "In philosophy, the self is an individual's own being, knowledge, and values, and the relationship between these attributes. The first-person perspective distinguishes selfhood from personal identity. Whereas \"identity\" is (literally) sameness and may involve categorization and labeling, selfhood implies a first-person perspective and suggests potential uniqueness. Conversely, \"person\" is used as a third-person reference. Personal identity can be impaired in late-stage Alzheimer's disease and in other neurodegenerative diseases. Finally, the self is distinguishable from \"others\"."}}, {"canonical_name": "linho", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 24, "members": [{"entity_id": "linho", "book_id": "polyanthea_medicinal", "name": "linho", "category": "PLANT", "subcategory": "PLANT", "count": 14, "variants": ["linho", "linho canhamo", "linhonovo"], "contexts": ["material for a linen cloth", "linen cloths used to absorb blood"]}, {"entity_id": "linho_alcanave", "book_id": "coloquios_da_orta_1563", "name": "linho alcanave", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["linho alcanave", "linho alcanape", "linho àlcanope"], "contexts": ["plant whose seeds corrupt genital seed", "plant producing textile fibers"]}, {"entity_id": "linho", "book_id": "coloquios_da_orta_1563", "name": "linho", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["linho", "linho commum"], "contexts": ["commodity mentioned in relation to weights", "plant material found on the island"]}, {"entity_id": "ſementede_linho", "book_id": "polyanthea_medicinal", "name": "ſementede linho", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["ſementede linho"], "contexts": ["flaxseed used in a bath", "seed used in a preparation"]}, {"entity_id": "linho_crù", "book_id": "polyanthea_medicinal", "name": "linho crù", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["linho crù"], "contexts": ["raw linen used for fomentation"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "linho", "target_book": "coloquios_da_orta_1563", "target_name": "linho alcanave", "similarity": 0.827}, {"source_book": "polyanthea_medicinal", "source_name": "linho", "target_book": "coloquios_da_orta_1563", "target_name": "linho", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "linho", "target_book": "polyanthea_medicinal", "target_name": "ſementede linho", "similarity": 0.855}, {"source_book": "coloquios_da_orta_1563", "source_name": "linho", "target_book": "polyanthea_medicinal", "target_name": "linho crù", "similarity": 0.824}], "id": 711, "stable_key": "clu_52f1f770f8fbcd3d", "ground_truth": {"modern_name": "Flax", "confidence": "high", "type": "plant", "linnaean": "Linum usitatissimum", "family": "Linaceae", "description": "A plant cultivated for its fiber (linen) and seeds (linseed).", "wikipedia_extract": "Flax, also known as common flax or linseed, is a flowering plant, Linum usitatissimum, in the family Linaceae. It is cultivated as a food and fiber crop in regions of the world with temperate climates. In 2022, France produced 75% of the world's supply of flax. Textiles made from flax are known in English as linen and are traditionally used for bed sheets, underclothes, and table linen. Its oil is known as linseed oil. In addition to referring to the plant, the word \"flax\" may refer to the unspun fibers of the flax plant."}}, {"canonical_name": "rofmaninho", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 24, "members": [{"entity_id": "rofmaninho", "book_id": "polyanthea_medicinal", "name": "rofmaninho", "category": "PLANT", "subcategory": "PLANT", "count": 22, "variants": ["rofmaninho", "Rofmaninho", "Roſmaninho", "flor de rofmaninho", "rosmaninho", "rotmaninho", "roſmaninho"], "contexts": ["herb used in preparations", "rosemary, ingredient in remedy"]}, {"entity_id": "rosmaninho", "book_id": "coloquios_da_orta_1563", "name": "rosmaninho", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["rosmaninho"], "contexts": ["Comparison for flower color", "herb for head or nerve ailments"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "rofmaninho", "target_book": "coloquios_da_orta_1563", "target_name": "rosmaninho", "similarity": 0.881}], "id": 712, "stable_key": "clu_f8e621af8cfa9251", "ground_truth": {"modern_name": "Rosemary", "confidence": "high", "type": "plant", "linnaean": "Salvia rosmarinus", "family": "Lamiaceae", "description": "An aromatic herb used in cooking and medicine.", "note": "The variation in spelling ('rofmaninho' and 'rosmaninho') points to this herb.", "wikipedia_extract": "Salvia rosmarinus, synonym Rosmarinus officinalis, commonly known as rosemary, is a shrub with fragrant, evergreen, needle-like leaves and purple or sometimes white, pink, or blue flowers. It is a member of the sage family, Lamiaceae. The species is native to the Mediterranean region. It has a number of cultivars, and its leaves are commonly used as a flavoring. Rosemary has a fibrous root system. It forms an aromatic evergreen shrub with leaves similar to Tsuga needles."}}, {"canonical_name": "pòs", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 24, "members": [{"entity_id": "pòs", "book_id": "polyanthea_medicinal", "name": "pòs", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 22, "variants": ["pòs", "pos"], "contexts": ["powdered medicine", "powdered form of medicine"]}, {"entity_id": "pós", "book_id": "coloquios_da_orta_1563", "name": "pós", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["pós"], "contexts": ["powdered medicine"]}, {"entity_id": "pô", "book_id": "coloquios_da_orta_1563", "name": "pô", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["pô"], "contexts": ["powdered form of the stone"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "pòs", "target_book": "coloquios_da_orta_1563", "target_name": "pós", "similarity": 0.862}, {"source_book": "polyanthea_medicinal", "source_name": "pòs", "target_book": "coloquios_da_orta_1563", "target_name": "pô", "similarity": 0.904}], "id": 713, "stable_key": "clu_9d7c13d93b951de8", "ground_truth": {"modern_name": "Powder", "confidence": "high", "type": "substance", "description": "A substance in the form of fine, dry particles.", "note": "The contexts clearly indicate finely ground substances, often medicinal.", "wikipedia_extract": "A powder is a dry solid composed of many very fine particles that may flow freely when shaken or tilted. Powders are a special sub-class of granular materials, although the terms powder and granular are sometimes used to distinguish separate classes of material. In particular, powders refer to those granular materials that have the finer grain sizes, and that therefore have a greater tendency to form clumps when flowing. Granulars refer to the coarser granular materials that do not tend to form clumps except when wet. Many manufactured goods come in powder form, such as flour, sugar, ground coffee, powdered milk, copy machine toner, gunpowder, cosmetic powders, and some pharmaceuticals. In nature, dust, fine sand and snow, volcanic ash, and the top layer of the lunar regolith are also examples."}}, {"canonical_name": "Decam", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 24, "members": [{"entity_id": "decam", "book_id": "coloquios_da_orta_1563", "name": "Decam", "category": "PLACE", "subcategory": "REGION", "count": 22, "variants": ["Decam"], "contexts": ["region ruled by Nizamoxa", "part of India with anacardo"]}, {"entity_id": "deccan", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Deccan", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Deccan"], "contexts": ["region in India with plant exceptions", "region in India"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Decam", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Deccan", "similarity": 0.852}], "id": 714, "stable_key": "clu_c6dc6b458068e2fd", "ground_truth": {"modern_name": "Deccan", "confidence": "high", "type": "place", "country": "India", "wikidata_id": "Q8354327", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Deccania", "wikipedia_extract": "Deccania is a monotypic genus of flowering plants in the family Rubiaceae. The genus contains only one species, viz. Deccania pubescens, which is endemic to India."}}, {"canonical_name": "Mercurial", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "mercurial", "book_id": "polyanthea_medicinal", "name": "Mercurial", "category": "PERSON", "subcategory": "AUTHORITY", "count": 18, "variants": ["Mercurial", "Mercur", "Mercurial."], "contexts": ["mentioned with birth anomalies", "author cited for a remedy"]}, {"entity_id": "mercury", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mercury", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["Mercury"], "contexts": ["plant name", "Roman god, messenger"]}, {"entity_id": "hyeronimus_mercurialis", "book_id": "polyanthea_medicinal", "name": "Hyeronimus Mercurialis", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Hyeronimus Mercurialis"], "contexts": ["authority on decoration and bruises"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Mercurial", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Mercury", "similarity": 0.981}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mercury", "target_book": "polyanthea_medicinal", "target_name": "Hyeronimus Mercurialis", "similarity": 0.823}], "id": 715, "stable_key": "clu_28ea01df2955b2bb", "ground_truth": {"modern_name": "Girolamo Mercuriale", "confidence": "high", "type": "person", "birth_year": 1530, "death_year": 1606, "description": "Italian physician, philosopher, and botanist; author of De Arte Gymnastica.", "wikidata_id": "Q129011568", "wikidata_description": "scholarly article", "wikipedia_extract": "Girolamo Mercuriale or Mercuriali (Italian: Geronimo Mercuriali; Latin: Hieronymus Mercurialis, Hyeronimus Mercurialis) (September 30, 1530 – November 8, 1606) was an Italian philologist and physician, most famous for his work De Arte Gymnastica. Born in the city of Forlì, the son of Giovanni Mercuriali, also a doctor, he was educated at Bologna, Padua and Venice, where he received his doctorate in 1555. Settling in Forli, he was sent on a political mission to Rome. The pope at the time was Paul IV. In Rome, he made favorable contacts and had free access to the great libraries where, with sweeping enthusiasm, he studied the classical and medical literature of the Greeks and Romans. His studies of the attitudes of the ancients toward diet, exercise, and hygiene and the use of natural methods for the cure of disease culminated in the publication of his De Arte Gymnastica(Venice, 1569)."}}, {"canonical_name": "Stibium", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "stibium", "book_id": "polyanthea_medicinal", "name": "Stibium", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 20, "variants": ["Stibium", "Stibij", "Stibio"], "contexts": ["mineral substance used in medicine", "mineral praised by authors"]}, {"entity_id": "stibium", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Stibium", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["Stibium"], "contexts": ["antimony glass, appears red then yellow", "mineral with attractive quality"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Stibium", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Stibium", "similarity": 1.0}], "id": 716, "stable_key": "clu_740a10bd47703c47", "ground_truth": {"modern_name": "Antimony", "confidence": "high", "type": "mineral", "wikidata_id": "Q1099", "wikidata_description": "chemical element with symbol Sb and atomic number of 51", "wikipedia_extract": "Antimony potassium tartrate, also known as potassium antimonyl tartrate, potassium antimontarterate, or tartar emetic, has the formula K2Sb2(C4H2O6)2. The compound has long been known as a powerful emetic, and was used in the treatment of schistosomiasis and leishmaniasis. It is used as a resolving agent. It typically is obtained as a hydrate. The first treatment application against trypanosomiasis was tested in 1906, and the compound's use to treat other tropical diseases was researched. The treatment of leishmania with antimony potassium tartrate started in 1913.", "wikipedia_url": "https://en.wikipedia.org/wiki/Antimony"}}, {"canonical_name": "poros", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "poros", "book_id": "polyanthea_medicinal", "name": "poros", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 22, "variants": ["poros", "poros do corpo", "porosidades", "pòros"], "contexts": ["pores in the brain", "pores, small openings"]}, {"entity_id": "pores", "book_id": "english_physician_1652", "name": "Pores", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Pores"], "contexts": ["part of the body to be opened"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "poros", "target_book": "english_physician_1652", "target_name": "Pores", "similarity": 0.926}], "id": 717, "stable_key": "clu_cb8881759d3787b4", "ground_truth": {"modern_name": "Pores", "confidence": "high", "type": "substance", "description": "Minute openings in the surface of the skin or other tissues.", "note": "The contexts relate to biological structures for absorption or excretion.", "wikipedia_extract": "Poros (Greek: Πόρος; Modern Greek pronunciation: [ˈporos]) is a small Greek island-pair in the southern part of the Saronic Gulf, about 58 km (36 miles; 31 nautical miles) south of the port of Piraeus and separated from the Peloponnese by a 200 m (656 ft) wide sea channel, with the town of Galatas on the mainland across the strait. Its surface area is about 31 square kilometres (12 sq mi) and it has 3,261 inhabitants (2021). The ancient name of Poros was Pogon. Like other ports in the Saronic, it is a popular weekend destination for Athenian travellers. Poros consists of two islands: Sphaeria (Greek: Σφαιρία, pronounced [sfeˈria]), the southern part, which is of volcanic origin, where today's city is located, and Kalaureia (Greek: Καλαυρία, [kalavˈria]), also Kalavria or Calauria (meaning 'gentle breeze'), the northern and largest part. A bridge connects the two islands over a narrow strait."}}, {"canonical_name": "portuguez", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "portuguez", "book_id": "coloquios_da_orta_1563", "name": "portuguez", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 20, "variants": ["portuguez", "Portuguez", "portugueza", "português", "versão portugueza"], "contexts": ["person from Portugal", "person who consumed maju"]}, {"entity_id": "portugaise", "book_id": "relation_historique_humboldt_vol3_1825", "name": "portugaise", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["portugaise"], "contexts": ["territorial dispute origin", "Portuguese race/language"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "portuguez", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "portugaise", "similarity": 0.992}], "id": 718, "stable_key": "clu_35f73c0448783e4c", "ground_truth": {"modern_name": "Portuguese", "confidence": "high", "type": "person", "description": "A person from or related to Portugal.", "wikipedia_extract": "The Portuguese people (Portuguese: Portugueses – masculine – or Portuguesas) are a Romance-speaking ethnic group and nation indigenous to Portugal, a country that occupies the west side of the Iberian Peninsula in south-west Europe, who share culture, ancestry and language. The Portuguese state began with the founding of the County of Portugal in 868. Following the Battle of São Mamede (1128), Portugal gained international recognition as a kingdom through the Treaty of Zamora and the papal bull Manifestis Probatum. This Portuguese state paved the way for the Portuguese people to unite as a nation. The Portuguese explored distant lands previously unknown to Europeans—in the Americas, Africa, Asia and Oceania (southwest Pacific Ocean). In 1415, with the conquest of Ceuta, the Portuguese took a significant role in the Age of Discovery, which culminated in a colonial empire."}}, {"canonical_name": "exercicio", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "exercicio", "book_id": "polyanthea_medicinal", "name": "exercicio", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 21, "variants": ["exercicio", "exerciciodema", "exerciciolaborioſo", "exercise", "exercitar"], "contexts": ["physical activity and regimen", "physical activity for health"]}, {"entity_id": "exercicio", "book_id": "historia_medicinal_monardes_1574", "name": "exercicio", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["exercicio"], "contexts": ["physical activity"]}, {"entity_id": "exercicio_apè", "book_id": "polyanthea_medicinal", "name": "exercicio apè", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["exercicio apè"], "contexts": ["walking exercise"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "exercicio", "target_book": "historia_medicinal_monardes_1574", "target_name": "exercicio", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "exercicio", "target_book": "polyanthea_medicinal", "target_name": "exercicio apè", "similarity": 0.815}], "id": 719, "stable_key": "clu_a503d1e777cfc50e", "ground_truth": {"modern_name": "Exercise", "confidence": "high", "type": "concept", "description": "Physical activity undertaken for health or regimen.", "wikipedia_extract": "Exercise or working out is physical activity that enhances or maintains fitness and overall health. It is performed for various reasons, including weight loss or maintenance, to aid growth and improve strength, develop muscles and the cardiovascular system, hone athletic skills, improve health, or simply for enjoyment. Many people choose to exercise outdoors where they can congregate in groups, socialize, and improve well-being as well as mental health. In terms of health benefits, usually, 150 minutes (2 hours and 30 minutes) of moderate-intensity exercise per week is recommended for reducing the risk of health problems. At the same time, even doing a small amount of exercise is healthier than doing none. Only doing an hour and a quarter (11 minutes/day) of exercise could reduce the risk of early death, cardiovascular disease, stroke, and cancer."}}, {"canonical_name": "Alhos", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "alhos", "book_id": "polyanthea_medicinal", "name": "Alhos", "category": "PLANT", "subcategory": "PLANT", "count": 15, "variants": ["Alhos", "alhas", "alho", "alhoa", "alhos"], "contexts": ["garlic", "flatulent food"]}, {"entity_id": "alhos", "book_id": "coloquios_da_orta_1563", "name": "alhos", "category": "PLANT", "subcategory": "PLANT", "count": 7, "variants": ["alhos", "alho"], "contexts": ["ingredient for flavoring food", "garlic, mixed with calamus for horses"]}, {"entity_id": "alhos_crus", "book_id": "polyanthea_medicinal", "name": "alhos crus", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["alhos crus"], "contexts": ["raw garlic"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Alhos", "target_book": "coloquios_da_orta_1563", "target_name": "alhos", "similarity": 0.985}, {"source_book": "coloquios_da_orta_1563", "source_name": "alhos", "target_book": "polyanthea_medicinal", "target_name": "alhos crus", "similarity": 0.837}], "id": 720, "stable_key": "clu_fead76225e6d1d3e", "ground_truth": {"modern_name": "Garlic", "confidence": "high", "type": "plant", "linnaean": "Allium sativum", "family": "Amaryllidaceae", "description": "A pungent bulbous plant used as food and medicine.", "wikipedia_extract": "Garlic (Allium sativum) is a species of bulbous flowering plants in the genus Allium. Its close relatives include the onion, shallot, leek, chives, Welsh onion, and Chinese onion. Garlic is native to central and western Asia, stretching from the Black Sea through the southern Caucasus, northeastern Iran, and the Hindu Kush. It has naturalized in many other parts of the world, including Mediterranean Europe and China. There are two subspecies and hundreds of varieties of garlic. Garlic has been used for thousands of years as a seasoning, culinary ingredient, and traditional medical remedy."}}, {"canonical_name": "papoulas", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "papoulas", "book_id": "polyanthea_medicinal", "name": "papoulas", "category": "PLANT", "subcategory": "PLANT", "count": 20, "variants": ["papoulas", "Papoulas", "papoulis"], "contexts": ["remedy for thin humor", "ingredient in a syrup"]}, {"entity_id": "papoula", "book_id": "coloquios_da_orta_1563", "name": "papoula", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["papoula"], "contexts": ["plant cultivated for opium"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "papoulas", "target_book": "coloquios_da_orta_1563", "target_name": "papoula", "similarity": 0.966}], "id": 721, "stable_key": "clu_f7b7ffa9d510bc19", "ground_truth": {"modern_name": "Poppy", "confidence": "high", "type": "plant", "linnaean": "Papaver", "family": "Papaveraceae", "description": "A flowering plant, source of opium and other medicinal compounds.", "wikipedia_extract": "Papaver  is a genus of 70–100 species of frost-tolerant annuals, biennials, and perennials native to temperate and cold regions of Eurasia, Africa and North America. It is the type genus of the poppy family, Papaveraceae. The flowers have two sepals that fall off as the bud opens, and four (or up to six) petals in red, pink, orange, yellow, or lilac. There are many stamens in several whorls around a compound pistil, which results from the fusion of carpels. The stigmas are visible on top of the capsule, and the number of stigmas corresponds to the number of fused carpels. The ovary later develops into a dehiscing capsule, capped by the dried stigmas."}}, {"canonical_name": "funcho", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "funcho", "book_id": "polyanthea_medicinal", "name": "funcho", "category": "PLANT", "subcategory": "PLANT", "count": 21, "variants": ["Funcho", "funcho"], "contexts": ["ingredient in Papa Benedicto powder", "used in decoctions and powders"]}, {"entity_id": "fungão", "book_id": "coloquios_da_orta_1563", "name": "fungão", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["fungão", "funcho"], "contexts": ["comparison for ambergris origin", "herb used in medicine"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "funcho", "target_book": "coloquios_da_orta_1563", "target_name": "fungão", "similarity": 0.847}], "id": 722, "stable_key": "clu_498cc6155c393182", "ground_truth": {"modern_name": "Fennel", "confidence": "high", "type": "plant", "linnaean": "Foeniculum vulgare", "family": "Apiaceae", "description": "An aromatic herb with feathery leaves, used in medicine and cooking.", "wikipedia_extract": "Fennel (Foeniculum vulgare) is a flowering plant species in the carrot family. It is a hardy, perennial herb with yellow flowers and feathery leaves. It is indigenous to the shores of the Mediterranean but has become widely naturalized in many parts of the world, especially on dry soils near the sea coast and on riverbanks. It is a highly flavorful herb used in cooking and, along with the similar-tasting anise, is one of the primary ingredients of absinthe. Florence fennel or finocchio (UK: , US: , Italian: [fiˈnɔkkjo]) is a selection with a swollen, bulb-like stem base (sometimes called bulb fennel) that is used as a vegetable. Foeniculum vulgare is a perennial herb."}}, {"canonical_name": "mercurio fixo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "mercurio_fixo", "book_id": "polyanthea_medicinal", "name": "mercurio fixo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 22, "variants": ["mercurio fixo", "Mercuriaes", "Mercurio Diaphoretico fixo", "Mercurio diaphoretico fixo", "Mercurio doce fublimado", "Mercurio fixo", "Mercuriodoce", "Mercuriodoce fublimado", "Mercuriofixo com ouro", "Mercurioluteo", "mercurialia", "mercurio diaphoretico fixo", "mercurio doce sublimado", "mercurio fixo com ouro", "mercuriodoce"], "contexts": ["a substance used as a remedy", "prepared mercury"]}, {"entity_id": "mercurial", "book_id": "coloquios_da_orta_1563", "name": "mercurial", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["mercurial"], "contexts": ["treatment applied for disposition"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "mercurio fixo", "target_book": "coloquios_da_orta_1563", "target_name": "mercurial", "similarity": 0.872}], "id": 723, "stable_key": "clu_04eebf50c520bc29", "ground_truth": {"modern_name": "Prepared Mercury", "confidence": "high", "type": "substance", "description": "Mercury that has undergone alchemical preparation or treatment.", "note": "Refers to alchemical mercury, not the planet.", "wikipedia_extract": "Mercury is a chemical element; it has symbol Hg and atomic number 80. It is commonly known as quicksilver. A heavy, silvery d-block element, mercury is the only metallic element that is known to be liquid at standard temperature and pressure; the only other element that is liquid under these conditions is bromine, one of the halogens, though metals such as caesium, gallium, and rubidium melt just above room temperature. Mercury occurs in deposits throughout the world mostly as cinnabar (mercuric sulfide). The red pigment vermilion is obtained by grinding natural cinnabar or synthetic mercuric sulfide. Exposure to mercury and mercury-containing organic compounds is toxic to the nervous system, immune system and kidneys of humans and other animals; mercury poisoning can result from exposure to water-soluble forms of mercury (such as mercuric chloride or methylmercury) either directly or through mechanisms of biomagnification."}}, {"canonical_name": "Sede", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "sede", "book_id": "polyanthea_medicinal", "name": "Sede", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 19, "variants": ["Sede", "sede", "sedes"], "contexts": ["thirst", "sensation of thirst"]}, {"entity_id": "sed", "book_id": "historia_medicinal_monardes_1574", "name": "sed", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 3, "variants": ["sed"], "contexts": ["symptom of hot poison", "symptom of thirst"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Sede", "target_book": "historia_medicinal_monardes_1574", "target_name": "sed", "similarity": 0.884}], "id": 724, "stable_key": "clu_35e4755904d6233a", "ground_truth": {"modern_name": "Thirst", "confidence": "high", "type": "disease", "description": "An uncomfortable sensation indicating a need for fluids.", "wikipedia_extract": "Thirst is the craving for potable fluids, resulting in the basic instinct of animals to drink. It is an essential mechanism involved in fluid balance. It arises from a lack of fluids or an increase in the concentration of certain osmolites, such as sodium. If the water volume of the body falls below a certain threshold or the osmolite concentration becomes too high, structures in the brain detect changes in blood constituents and signal thirst. Continuous dehydration can cause acute and chronic diseases, but is most often associated with renal and neurological disorders. Excessive thirst, called polydipsia, along with excessive urination, known as polyuria, may be an indication of diabetes mellitus or diabetes insipidus."}}, {"canonical_name": "cura", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "cura", "book_id": "polyanthea_medicinal", "name": "cura", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 20, "variants": ["cura", "Cura", "cura , quocumque à morfu tempore"], "contexts": ["the act of healing", "process of healing"]}, {"entity_id": "curava", "book_id": "historia_medicinal_monardes_1574", "name": "curava", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["curava"], "contexts": ["illness the Cacique was being treated for"]}, {"entity_id": "adoença_curavel", "book_id": "polyanthea_medicinal", "name": "adoença curavel", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["adoença curavel"], "contexts": ["curable illness"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "cura", "target_book": "historia_medicinal_monardes_1574", "target_name": "curava", "similarity": 0.919}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "curava", "target_book": "polyanthea_medicinal", "target_name": "adoença curavel", "similarity": 0.867}], "id": 725, "stable_key": "clu_e64c80da29026fad", "ground_truth": {"modern_name": "Cure", "confidence": "high", "type": "concept", "description": "The process of healing or the act of treating an illness.", "wikipedia_extract": "A cure is a substance or procedure that resolves a medical condition. This may include a medication, a surgical operation, a lifestyle change, or even a philosophical shift that alleviates a person's suffering or achieves a state of healing. The medical condition can be a disease, mental illness or genetic disorder. An incurable disease is not necessarily a terminal illness, and conversely, a curable illness can still be fatal. The cure fraction or cure rate—the proportion of people with a disease who are cured by a given treatment—is determined by comparing disease-free survival in treated individuals against a matched control group without the disease. Another method for determining the cure fraction and/or \"cure time\" involves measuring when the hazard rate in a diseased group returns to the hazard rate observed in the general population."}}, {"canonical_name": "Castella", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "castella", "book_id": "coloquios_da_orta_1563", "name": "Castella", "category": "PLACE", "subcategory": "COUNTRY", "count": 21, "variants": ["Castella"], "contexts": ["country supplied by cassia fistula", "region where knowledge is shared"]}, {"entity_id": "castelhano", "book_id": "polyanthea_medicinal", "name": "Castelhano", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Castelhano"], "contexts": ["referring to Spain"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Castella", "target_book": "polyanthea_medicinal", "target_name": "Castelhano", "similarity": 0.865}], "id": 726, "stable_key": "clu_d59963730e3c365f", "ground_truth": {"modern_name": "Castile", "confidence": "high", "type": "place", "description": "A historical region in Spain, often referred to as Spain itself.", "wikipedia_extract": "Castella (カステラ, kasutera; pronounced [kasɯ̥teɾa]; ) is a type of Japanese sponge cake and is known for its sweet, moist brioche-style flavour and texture. It is based on cakes introduced to Japan by Portuguese merchants in the 16th century. It was then popularized in the city of Nagasaki, where it is considered a specialty. Despite its foreign origins, it is considered a kind of wagashi, or traditional Japanese confectionery. To suit the tastes of Japanese people, mizuame syrup was added to the sponge cake to make it more moist, and zarame (coarse sugar) was added to the bottom to give it a coarser texture. Castella is usually baked in square or rectangular molds, then cut and sold in long boxes, with the cake inside being approximately 27 cm (11 in) long."}}, {"canonical_name": "castanhas", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "castanhas", "book_id": "polyanthea_medicinal", "name": "castanhas", "category": "PLANT", "subcategory": "PLANT", "count": 15, "variants": ["castanhas", "Castanhas", "cafcasdecaftanhas", "caftanhas", "castanha", "caſtanhas"], "contexts": ["nutritious food", "source of powder for treatment"]}, {"entity_id": "castanhas", "book_id": "coloquios_da_orta_1563", "name": "castanhas", "category": "PLANT", "subcategory": "PLANT", "count": 7, "variants": ["castanhas", "castanha", "castanhas da jaca", "castanho"], "contexts": ["description of a fruit's taste when dry", "chestnuts, used for comparison of taste"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "castanhas", "target_book": "coloquios_da_orta_1563", "target_name": "castanhas", "similarity": 1.0}], "id": 727, "stable_key": "clu_4d6ffa0e20b112d8", "ground_truth": {"modern_name": "Chestnuts", "confidence": "high", "type": "plant", "description": "Edible nuts from trees, used as food and in medicinal preparations.", "wikipedia_extract": "Chestnuts are the deciduous trees and shrubs in the genus Castanea, in the beech family Fagaceae. The name also refers to the edible nuts they produce. They are native to temperate regions of the Northern Hemisphere. Chestnut trees are of moderate growth rate (for the Chinese chestnut tree) to fast growth rate (for American and European species). Their mature heights vary from the smallest species of chinkapins, often shrubby, to the giant of past American forests, C. dentata that could reach 30 metres (98 feet). Between these extremes are found the Japanese chestnut tree (C. crenata) at 10 m average; followed by the Chinese chestnut tree (C. mollissima) at about 15 m, then the European chestnut tree (C. sativa) around 30 m."}}, {"canonical_name": "aljofar", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "aljofar", "book_id": "polyanthea_medicinal", "name": "aljofar", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 20, "variants": ["Aljofar", "aljofar"], "contexts": ["ingredient in a medicinal preparation", "ingredient in a remedy"]}, {"entity_id": "aljofare", "book_id": "coloquios_da_orta_1563", "name": "aljofare", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 2, "variants": ["aljofare", "aljofire"], "contexts": ["merchandise from China", "commodity traded"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "aljofar", "target_book": "coloquios_da_orta_1563", "target_name": "aljofare", "similarity": 0.957}], "id": 728, "stable_key": "clu_7509c20f305d0052", "ground_truth": {"modern_name": "Pearls", "confidence": "high", "type": "animal", "description": "Hard, lustrous spheres produced within the soft tissue of a living shelled mollusk.", "wikipedia_extract": "A pearl is a hard, glistening object produced within the soft tissue (specifically the mantle) of a living shelled mollusk or another animal, such as fossil  conulariids. Just like the shell of a mollusk, a pearl is composed of calcium carbonate (mainly aragonite or a mixture of aragonite and calcite) in minute crystalline form, which has deposited in concentric layers. More commercially valuable pearls are perfectly round and smooth, but many other shapes, known as baroque pearls, can occur. The finest quality of natural pearls have been highly valued as gemstones and objects of beauty for many centuries. Because of this, pearl has become a metaphor for something rare, fine, admirable, and valuable. The most valuable pearls occur spontaneously in the wild but are extremely rare."}}, {"canonical_name": "pimenta longa", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "pimenta_longa", "book_id": "coloquios_da_orta_1563", "name": "pimenta longa", "category": "PLANT", "subcategory": "PLANT", "count": 14, "variants": ["pimenta longa", "PIMENTA LONGA", "pimenta longua"], "contexts": ["topic of colloquy", "Long pepper, a spice"]}, {"entity_id": "pimenta_longa", "book_id": "polyanthea_medicinal", "name": "pimenta longa", "category": "PLANT", "subcategory": "PLANT", "count": 7, "variants": ["pimenta longa"], "contexts": ["spice for pill preparation", "ingredient in pills"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "pimenta longa", "target_book": "polyanthea_medicinal", "target_name": "pimenta longa", "similarity": 1.0}], "id": 729, "stable_key": "clu_02aab75d35aedbe4", "ground_truth": {"modern_name": "Long Pepper", "confidence": "high", "type": "plant", "description": "A spice, a dried berry of the Piper longum plant.", "wikipedia_extract": "Long pepper (Piper longum),  sometimes called Indian long pepper or pippali, is a flowering vine in the family Piperaceae, cultivated for its fruit, which is usually dried and used as a spice and seasoning. Long pepper has a taste similar to, but sweeter and more pungent than, that of its close relative Piper nigrum – from which black, green and white pepper are obtained. The fruit of the pepper consists of many minuscule fruits – each about the size of a poppy seed – embedded in the surface of a flower spike that closely resembles a hazel tree catkin. Like Piper nigrum, the fruits contain the compound piperine, which contributes to their pungency. Another species of long pepper, Piper retrofractum, is native to Java, Indonesia. The fruits of this plant are often confused with chili peppers, which belong to the genus Capsicum, originally from the Americas."}}, {"canonical_name": "cezões", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "cezões", "book_id": "polyanthea_medicinal", "name": "cezões", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 20, "variants": ["cezões", "Cezões", "cezoés", "cezőts"], "contexts": ["convulsions or seizures", "medical condition"]}, {"entity_id": "ciúmes", "book_id": "coloquios_da_orta_1563", "name": "ciúmes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["ciúmes"], "contexts": ["cause of elephant rage"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "cezões", "target_book": "coloquios_da_orta_1563", "target_name": "ciúmes", "similarity": 0.846}], "id": 730, "stable_key": "clu_4d389fd4a34eda66", "ground_truth": {"modern_name": "Seizures", "confidence": "high", "type": "disease", "description": "Sudden, uncontrolled electrical disturbances in the brain causing changes in behavior.", "wikipedia_extract": "A seizure is a sudden disruption of brain activity caused by excessive, synchronized neuronal firing that results in changes in behavior. This neurological condition is common, affecting approximately 50 million individuals around the world. Depending on the regions of the brain involved, seizures can lead to changes in movement, sensation, behavior, awareness, or consciousness. Symptoms vary widely. Some seizures involve subtle changes, such as brief lapses in attention or awareness (as seen in absence seizures), while others cause generalized convulsions with loss of consciousness (tonic–clonic seizures). Most seizures last less than two minutes and are followed by a postictal period of confusion, fatigue, or other symptoms."}}, {"canonical_name": "Polypo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "polypo", "book_id": "polyanthea_medicinal", "name": "Polypo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 15, "variants": ["Polypo", "Polipos", "Polypos", "polyp.", "polypo", "polypos"], "contexts": ["medical condition in the nose", "growth in the nose"]}, {"entity_id": "polipus", "book_id": "english_physician_1652", "name": "Polipus", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 6, "variants": ["Polipus"], "contexts": ["stinking sores in the nose", "fleshy growth in the nose"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Polypo", "target_book": "english_physician_1652", "target_name": "Polipus", "similarity": 0.928}], "id": 731, "stable_key": "clu_609001a83d19885b", "ground_truth": {"modern_name": "Polyps", "confidence": "high", "type": "disease", "description": "An abnormal growth of tissue, often in the nose or other mucous membranes.", "wikipedia_extract": "A polyp in zoology is one of two forms  found in the phylum Cnidaria, the other being the medusa. Polyps are roughly cylindrical in shape and elongated at the axis of the vase-shaped body. In solitary polyps, the aboral (opposite to oral) end is attached to the substrate by means of a disc-like holdfast called a pedal disc, while in colonies of polyps it is connected to other polyps, either directly or indirectly. The oral end contains the mouth, and is surrounded by a circlet of tentacles. In the class Anthozoa, comprising the sea anemones and corals, the individual is always a polyp; in the class Hydrozoa, however, the individual may be either a polyp or a medusa, with most species undergoing a life cycle with both a polyp stage and a medusa stage. In the class Scyphozoa, the medusa stage is dominant, and the polyp stage may or may not be present, depending on the family."}}, {"canonical_name": "La Condamine", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "la_condamine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "La Condamine", "category": "PERSON", "subcategory": "SCHOLAR", "count": 17, "variants": ["La Condamine", "Condamine", "Fia Condamine", "M. de La Condamine", "M. de La Cundamine", "de la Condamine"], "contexts": ["proposed expedition in 1734", "affirmed absence of stones"]}, {"entity_id": "la_condamine", "book_id": "kosmos_humboldt_1845", "name": "La Condamine", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["La Condamine"], "contexts": ["erected monument at equator", "made observation in Journal du Voyage"]}, {"entity_id": "condamine,_la", "book_id": "kosmos_humboldt_1845", "name": "Condamine, La", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Condamine, La"], "contexts": ["mentioned pendulum use for seconds"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "La Condamine", "target_book": "kosmos_humboldt_1845", "target_name": "La Condamine", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "La Condamine", "target_book": "kosmos_humboldt_1845", "target_name": "Condamine, La", "similarity": 0.937}], "id": 732, "stable_key": "clu_e059ba02564d8860", "ground_truth": {"modern_name": "Charles Marie de La Condamine", "confidence": "high", "type": "person", "birth_year": 1701, "death_year": 1774, "description": "French explorer, scientist, and writer; known for his measurements of the Earth.", "wikidata_id": "Q26681", "wikidata_description": "French explorer, geographer, and mathematician (1701-1774)", "wikipedia_extract": "François-Marie Arouet (French: [fʁɑ̃swa maʁi aʁwɛ]; 21 November 1694 – 30 May 1778), known by his pen name Voltaire (, US also ; French: [vɔltɛːʁ]), was a French Enlightenment writer, philosopher (philosophe), satirist, and historian. Famous for his wit and his criticism of Christianity (especially of the Catholic Church) and of slavery, Voltaire was an advocate of freedom of speech, freedom of religion, and separation of church and state. Voltaire was a versatile and prolific writer, producing works in almost every literary form, including plays, poems, novels, essays, histories, and even scientific expositions. He wrote more than 20,000 letters and 2,000 books and pamphlets. Voltaire was one of the first authors to become renowned and commercially successful internationally. He was an outspoken advocate of civil liberties and was at constant risk from the strict censorship laws of the Catholic French monarchy.", "wikipedia_url": "https://en.wikipedia.org/wiki/Charles_Marie_de_La_Condamine"}}, {"canonical_name": "Nodes", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "nodes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Nodes", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 17, "variants": ["Nodes", "nodes"], "contexts": ["intersection points of orbits", "points where orbit intersects ecliptic"]}, {"entity_id": "nodal_point", "book_id": "principles_of_psychology_james_1890", "name": "nodal point", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["nodal point"], "contexts": ["point of no vibration on a string"]}, {"entity_id": "node", "book_id": "connexion_physical_sciences_somerville_1858", "name": "node", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 3, "variants": ["node"], "contexts": ["point where orbit intersects reference plane", "intersection of orbital and ecliptic planes"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Nodes", "target_book": "principles_of_psychology_james_1890", "target_name": "nodal point", "similarity": 0.889}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nodal point", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "node", "similarity": 0.895}], "id": 733, "stable_key": "clu_b4dd4819d756b55d", "ground_truth": {"modern_name": "Node", "confidence": "high", "type": "concept", "note": "Refers to a point of intersection, minimum, or no oscillation, depending on context (astronomy, physics).", "wikipedia_extract": "In networking, a node (Latin: nodus, 'knot') is either a redistribution point or a communication endpoint within telecommunication networks or computer networks. A physical network node is an electronic device that is attached to a network, and is capable of creating, receiving, or transmitting information over a communication channel. In data communication, a physical network node may either be data communication equipment (such as a modem, hub, bridge or switch) or data terminal equipment (such as a digital telephone handset, a printer or a host computer). A passive distribution point, such as a distribution frame or patch panel is not considered to be a node. In data communication, a physical network node may either be data communication equipment (DCE) such as a modem, hub, bridge or switch; or data terminal equipment (DTE) such as a digital telephone handset, a printer or a host computer. If a network is a local area network (LAN) or wide area network (WAN), every LAN or WAN node that participates on the data link layer must have a network address, typically one for each network interface controller it possesses.", "wikipedia_url": "https://en.wikipedia.org/wiki/Node_(networking)"}}, {"canonical_name": "61 Cygni", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "61_cygni", "book_id": "connexion_physical_sciences_somerville_1858", "name": "61 Cygni", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 11, "variants": ["61 Cygni"], "contexts": ["star with rapid proper motion", "star of the 6th magnitude"]}, {"entity_id": "61_cygni", "book_id": "kosmos_humboldt_1845", "name": "61 Cygni", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 10, "variants": ["61 Cygni"], "contexts": ["star with a specific designation", "star with considerable motion"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "61 Cygni", "target_book": "kosmos_humboldt_1845", "target_name": "61 Cygni", "similarity": 1.0}], "id": 734, "stable_key": "clu_1e1913c3b569bdf0", "ground_truth": {"modern_name": "61 Cygni", "confidence": "high", "type": "object", "note": "A binary star system historically important for parallax measurements."}}, {"canonical_name": "AMBRE", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "ambre", "book_id": "coloquios_da_orta_1563", "name": "AMBRE", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 16, "variants": ["ambre", "AMBRE", "Ambre"], "contexts": ["topic of discussion after dinner", "substance discussed in colloquy"]}, {"entity_id": "ambar_griz", "book_id": "polyanthea_medicinal", "name": "ambar griz", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 5, "variants": ["ambar griz", "ambar Gris", "ambar gris"], "contexts": ["ingredient in a remedy", "animal product"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "AMBRE", "target_book": "polyanthea_medicinal", "target_name": "ambar griz", "similarity": 0.878}], "id": 735, "stable_key": "clu_c5b11f2ed62687d5", "ground_truth": {"modern_name": "Ambergris", "confidence": "high", "type": "animal", "description": "A waxy substance produced in the digestive system of sperm whales.", "note": "Contexts indicate it refers to the substance derived from whales, used in remedies and as a topic of discussion.", "wikipedia_extract": "Ambergris ( or ; Latin: ambra grisea; Old French: ambre gris), ambergrease, or grey amber is a solid, waxy, flammable substance of a dull grey or blackish colour produced in the digestive system of sperm whales. Freshly produced ambergris has a marine, fecal odor. It acquires a sweet, earthy scent as it ages, commonly likened to the fragrance of isopropyl alcohol without the vaporous chemical astringency. Ambergris has been highly valued by perfume makers as a fixative that allows the scent to last much longer, although it has been mostly replaced by synthetic ambroxide. It is sometimes used in cooking. Dogs are attracted to the smell of ambergris and are sometimes used by ambergris searchers."}}, {"canonical_name": "páo", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "páo", "book_id": "coloquios_da_orta_1563", "name": "páo", "category": "PLANT", "subcategory": "PLANT", "count": 15, "variants": ["páo"], "contexts": ["source of camphor", "wood of the camphor tree"]}, {"entity_id": "paó", "book_id": "polyanthea_medicinal", "name": "paó", "category": "PLANT", "subcategory": "PLANT", "count": 6, "variants": ["paó"], "contexts": ["bread, can be harmful to nerves", "food item"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "páo", "target_book": "polyanthea_medicinal", "target_name": "paó", "similarity": 0.927}], "id": 736, "stable_key": "clu_508e98f1ee660f9f", "ground_truth": {"modern_name": "Wood", "confidence": "medium", "type": "plant", "description": "The hard fibrous material forming the main substance of the trunk or branches of a tree or shrub.", "note": "Contexts suggest 'páo' refers to wood, specifically wood of the camphor tree, but also broadly to bread. 'Wood' is the most consistent interpretation given the camphor tree reference.", "wikipedia_extract": "Wood is a structural tissue/material found as xylem in the stems and roots of trees and other woody plants. Being a natural material, it is characterized as an organic material – a natural composite of cellulosic fibers that are strong in tension and embedded in a matrix of lignin and hemicelluloses that resists compression. Wood is sometimes defined as only the secondary xylem in the stems of trees, or more broadly to include the same type of tissue elsewhere, such as in the roots of trees or shrubs. In a living tree, it performs a mechanical-support function, enabling woody plants to grow large or to stand up by themselves. It also conveys water and nutrients among the leaves, other growing tissues, and the roots. Wood may also refer to other plant materials with comparable properties, and to material engineered from wood, woodchips, or fibers."}}, {"canonical_name": "cominhos", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "cominhos", "book_id": "polyanthea_medicinal", "name": "cominhos", "category": "PLANT", "subcategory": "PLANT", "count": 15, "variants": ["cominhos"], "contexts": ["ingredient in a remedy", "chewed and licked for eye blemishes"]}, {"entity_id": "cominhan", "book_id": "coloquios_da_orta_1563", "name": "cominhan", "category": "PLANT", "subcategory": "PLANT", "count": 6, "variants": ["cominhan", "Cominhan", "cominhos"], "contexts": ["Malayo-Javanese name for a substance", "plant substance, cumin"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "cominhos", "target_book": "coloquios_da_orta_1563", "target_name": "cominhan", "similarity": 0.845}], "id": 737, "stable_key": "clu_b32653a7e2d7cad9", "ground_truth": {"modern_name": "Cumin", "confidence": "high", "type": "plant", "linnaean": "Cuminum cyminum", "family": "Apiaceae", "description": "A dried seed of a plant in the parsley family, used as a spice.", "note": "The primary meaning aligns with the spice cumin, used medicinally. 'Cominhan' is identified as a Malayo-Javanese name for a substance, but the context of cumin fits best.", "wikipedia_extract": "Cumin ( ,  ; US also  ; Cuminum cyminum) is a flowering plant in the family Apiaceae, native to the Irano-Turanian Region. Its seeds – each one contained within a fruit, which is dried – are used in the cuisines of many cultures in both whole and ground form. Although cumin is used in traditional medicine, there is no high-quality evidence that it is safe or effective as a therapeutic agent. The term comes via Middle English comyn, from Old English cymen (which is cognate with Old High German kumin) and Old French cummin, both from the Latin term cuminum. This in turn comes from the Ancient Greek κύμινον (kúminon), a Semitic borrowing related to Hebrew כמון‎ (kammōn) and Arabic كمون‎ (kammūn). All of these ultimately derive from Akkadian 𒂵𒈬𒉡 (kamūnu)."}}, {"canonical_name": "cheiro", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "cheiro", "book_id": "coloquios_da_orta_1563", "name": "cheiro", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["cheiro", "cheiros"], "contexts": ["Smell or odor", "used to determine quality"]}, {"entity_id": "cheyroſo", "book_id": "polyanthea_medicinal", "name": "cheyroſo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["cheyroſo", "cheyros"], "contexts": ["fragrant", "smell of roses"]}, {"entity_id": "cheyro", "book_id": "polyanthea_medicinal", "name": "cheyro", "category": "CONCEPT", "subcategory": "QUALITY", "count": 5, "variants": ["cheyro"], "contexts": ["smell", "smell or scent"]}, {"entity_id": "cheirosa", "book_id": "coloquios_da_orta_1563", "name": "cheirosa", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["cheirosa"], "contexts": ["quality of a substance"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "cheiro", "target_book": "polyanthea_medicinal", "target_name": "cheyroſo", "similarity": 0.9}, {"source_book": "polyanthea_medicinal", "source_name": "cheyro", "target_book": "coloquios_da_orta_1563", "target_name": "cheirosa", "similarity": 0.879}], "id": 738, "stable_key": "clu_234cfcb0b720d86f", "ground_truth": {"modern_name": "Scent", "confidence": "high", "type": "concept", "description": "A distinctive smell, especially a pleasant one.", "note": "Refers to smell or odor, and adjectives describing it, used to assess quality or describe something.", "wikipedia_extract": "An odor (American English) or odour (Commonwealth English; see spelling differences) is a smell or a scent caused by one or more volatilized chemical compounds generally found in low concentrations that humans and many animals can perceive via their olfactory system. While smell can refer to pleasant and unpleasant odors, the terms scent, aroma, and fragrance are usually reserved for pleasant-smelling odors and are frequently used in the food and cosmetic industry to describe floral scents or to refer to perfumes. The perception of odors, or sense of smell, is mediated by the olfactory nerve. The olfactory receptor (OR) cells are neurons present in the olfactory epithelium, which is a small patch of tissue at the back of the nasal cavity. There are millions of olfactory receptor neurons that act as sensory signaling cells. Each neuron has cilia in direct contact with the air."}}, {"canonical_name": "Plaister", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "plaister", "book_id": "english_physician_1652", "name": "Plaister", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 19, "variants": ["Plaister", "Plaisters", "Plai∣ster"], "contexts": ["medicinal application", "application made with Angelica root and pitch"]}, {"entity_id": "plaister_of_figs", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Plaister of figs", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Plaister of figs"], "contexts": ["applied to Ezechias"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Plaister", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Plaister of figs", "similarity": 0.814}], "id": 739, "stable_key": "clu_b2e26f780a8ca36d", "ground_truth": {"modern_name": "Poultice", "confidence": "high", "type": "object", "note": "The term 'Plaister' in early modern English often referred to a medicinal preparation applied externally, similar to a poultice, rather than a modern adhesive bandage.", "wikidata_id": "Q58775464", "wikidata_description": "February 1887 scholarly article in The Hospital", "wikipedia_extract": "Plaster is a building material used for the protective or decorative coating of walls and ceilings and for moulding and casting decorative elements. In English, \"plaster\" usually means a material used for the interiors of buildings, while \"render\" commonly refers to external applications. The term stucco refers to plasterwork that is worked in some way to produce relief decoration, rather than flat surfaces. The most common types of plaster mainly contain either gypsum, lime, or cement, but all work in a similar way. The plaster is manufactured as a dry powder and is mixed with water to form a stiff but workable paste immediately before it is applied to the surface. The reaction with water liberates heat through crystallization and the hydrated plaster then hardens.", "wikipedia_url": "https://en.wikipedia.org/wiki/Plaster"}}, {"canonical_name": "guaiacam", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "guaiacam", "book_id": "coloquios_da_orta_1563", "name": "guaiacam", "category": "PLANT", "subcategory": "PLANT", "count": 17, "variants": ["guaiacam", "GuAiACAM pao", "Guaiaaan cfmri", "Guaiaci", "guaiacan", "guaiaco", "páo guaiacam"], "contexts": ["plant from the West Indies", "medicinal wood"]}, {"entity_id": "guajacum", "book_id": "english_physician_1652", "name": "Guajacum", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Guajacum", "Gujacum"], "contexts": ["herb used for French Pox", "plant used for medicine"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "guaiacam", "target_book": "english_physician_1652", "target_name": "Guajacum", "similarity": 0.918}], "id": 740, "stable_key": "clu_e030d0c5ba3f73da", "ground_truth": {"modern_name": "Guaiac", "confidence": "high", "type": "plant", "linnaean": "Guaiacum officinale", "family": "Zygophyllaceae", "description": "A tropical American tree, the wood and resin of which are used medicinally.", "note": "Clearly refers to the medicinal plant Guaiacum and its associated products.", "wikipedia_extract": "Guaiacum officinale, commonly known as roughbark lignum-vitae, guaiacwood or gaïacwood, is a species of tree in the caltrop family, Zygophyllaceae, that is native to the Caribbean and the northern coast of South America. This small tree is very slow growing, reaching about 10 m (33 ft) in height with a trunk diameter of 60 cm (24 in). The tree is essentially evergreen throughout most of its native range. The leaves are compound, 2.5–3 cm (0.98–1.18 in) in length, and 2 cm (0.79 in) wide. The blue flowers have five petals that yield a bright-yellow-orange fruit with red flesh and black seeds. Guaiacum officinale is the national flower of Jamaica."}}, {"canonical_name": "Antioquia", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "antioquia", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Antioquia", "category": "PLACE", "subcategory": "REGION", "count": 19, "variants": ["Antioquia", "Antiocjuia"], "contexts": ["mountainous district in Spanish America", "city with population 104,000"]}, {"entity_id": "antioquia", "book_id": "kosmos_humboldt_1845", "name": "Antioquia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Antioquia"], "contexts": ["location of observations"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Antioquia", "target_book": "kosmos_humboldt_1845", "target_name": "Antioquia", "similarity": 1.0}], "id": 741, "stable_key": "clu_d1ead20f6bcaaec6", "ground_truth": {"modern_name": "Antioquia", "confidence": "high", "type": "place", "country": "Colombia", "wikidata_id": "Q4688300", "wikidata_description": "former regional airline in Colombia, 1987-2019", "wikipedia_url": "https://en.wikipedia.org/wiki/University_of_Antioquia", "wikipedia_extract": "The University of Antioquia (Spanish: Universidad de Antioquia), also called UdeA, is primarily a public research-based university, located in the city of Medellín, Colombia. With regional campuses in Amalfi, Andes, Caucasia, Carmen de Viboral, Envigado, Puerto Berrío, Santa Fe de Antioquia, Segovia, Sonsón, Turbo and Yarumal, it remain one of the oldest university in the region. As of 2024, we can read on their publication site that, more than 272 groups and over 5,000 faculty students, are working on 1,200 collaborative projects. Founded in 1803 after a Royal Decree was issued by King  Charles IV of Spain, under the name Franciscan College (Spanish: Colegio de Franciscanos), they have maintained their accreditation from the Ministry of Education for more than 2 centuries.. Along with the University of the Andes, each institution hold the second longest term behind the National University of Colombia. UdeA and the Tecnológico de Antioquia have the largest number of seats in the department of Antioquia."}}, {"canonical_name": "Tierra Firme", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "tierra_firme", "book_id": "historia_medicinal_monardes_1574", "name": "Tierra Firme", "category": "PLACE", "subcategory": "REGION", "count": 18, "variants": ["Tierra Firme", "Tierra Menga Firme", "Tierra firme"], "contexts": ["region where Caraña resin is found", "mainland coast"]}, {"entity_id": "tierra_firme", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tierra Firme", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Tierra Firme"], "contexts": ["region in a map title", "location of observations"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Tierra Firme", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Tierra Firme", "similarity": 0.818}], "id": 742, "stable_key": "clu_d640ac5c57ee5066", "ground_truth": {"modern_name": "Mainland", "confidence": "high", "type": "place", "description": "The principal part of a country or continent, as distinguished from islands.", "note": "Refers to the continental landmass in the Americas, as opposed to islands. Historical Spanish term for the northern coast of South America.", "wikipedia_extract": "Mainland is defined as \"relating to or forming the main part of a country or continent, not including the islands around it [regardless of status under territorial jurisdiction by an entity].\" The term is often politically, economically and/or demographically more significant than politically associated remote territories, such as exclaves or oceanic islands situated outside the continental shelf. In geography, \"mainland\" can denote the continental part of any polity or the main island within an island nation. In geopolitics, \"mainland\" is sometimes used interchangeably with terms like metropole as an antonym to overseas territories. In the sense of \"heartland\", mainland is the opposite of periphery. In some language a separate concept of \"mainland\" is missing and is replaced with a \"continental portion\". The term is relative: in Tasmania, continental Australia is the mainland, while to residents of Flinders Island, the main island of Tasmania is also \"the mainland\", though the geological Australian continent includes all the former plus the island of New Guinea and all the smaller islands (e.g. the Torres Strait Islands) in between."}}, {"canonical_name": "Aurora", "category": "OTHER_CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "aurora", "book_id": "kosmos_humboldt_1845", "name": "Aurora", "category": "OTHER_CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 14, "variants": ["Aurora"], "contexts": ["natural light phenomenon", "celestial phenomenon"]}, {"entity_id": "aurora", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Aurora", "category": "OTHER_CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["aurora", "Aurora"], "contexts": ["natural light display", "light resembling phenomenon"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Aurora", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Aurora", "similarity": 1.0}], "id": 743, "stable_key": "clu_9c6d344e77a74514", "ground_truth": {"modern_name": "Aurora", "confidence": "high", "type": "concept", "wikidata_id": "Q132015", "wikidata_description": "municipality of the Philippines in the province of Zamboanga del Sur", "wikipedia_url": "https://en.wikipedia.org/wiki/Aurora%2C_Zamboanga_del_Sur", "wikipedia_extract": "An aurora (pl. aurorae or auroras) is a natural light display in Earth's sky, predominantly observed in high-latitude regions around the Arctic and Antarctic. The terms northern lights (aurora borealis) and southern lights (aurora australis) are used in the Northern and Southern Hemispheres respectively. Auroras display dynamic patterns of radiant light that appear as curtains, rays, spirals or dynamic flickers covering the entire sky. Auroras are the result of disturbances in the Earth's magnetosphere caused by enhanced speeds of solar wind from coronal holes and coronal mass ejections. These disturbances alter the trajectories of charged particles in the magnetospheric plasma."}}, {"canonical_name": "Iceland spar", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "iceland_spar", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Iceland spar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 19, "variants": ["Iceland Spar", "Iceland spar"], "contexts": ["double refraction properties", "pure form of calcite"]}, {"entity_id": "iceland_spar", "book_id": "kosmos_humboldt_1845", "name": "Iceland spar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Iceland spar"], "contexts": ["small fragment of Iceland spar"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Iceland spar", "target_book": "kosmos_humboldt_1845", "target_name": "Iceland spar", "similarity": 1.0}], "id": 744, "stable_key": "clu_75a5d7c60dc1ae7e", "ground_truth": {"modern_name": "Iceland spar", "confidence": "high", "type": "mineral", "wikidata_id": "Q974568", "wikidata_description": "transparent variety of calcite", "wikipedia_url": "https://en.wikipedia.org/wiki/Iceland_spar"}}, {"canonical_name": "Glossary", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "glossary", "book_id": "coloquios_da_orta_1563", "name": "Glossary", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 19, "variants": ["Glossary", "Glossaire", "Glossário"], "contexts": ["reference work", "book title"]}, {"entity_id": "dictionario", "book_id": "polyanthea_medicinal", "name": "Dictionario", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Dictionario"], "contexts": ["title of a work"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Glossary", "target_book": "polyanthea_medicinal", "target_name": "Dictionario", "similarity": 0.933}], "id": 745, "stable_key": "clu_508d3605f4482447", "ground_truth": {"modern_name": "Glossary", "confidence": "high", "type": "object", "description": "Reference work containing definitions of terms.", "wikipedia_extract": "A glossary (from Ancient Greek: γλῶσσα, glossa; language, speech, wording), also known as a vocabulary or clavis, is an alphabetical list of terms in a particular domain of knowledge with the definitions for those terms. Traditionally, a glossary appears at the end of a book and includes terms within that book that are either newly introduced, uncommon, or specialized. While glossaries are most commonly associated with non-fiction books, in some cases, fiction novels sometimes include a glossary for unfamiliar terms. A bilingual glossary is a list of terms in one language defined in a second language or glossed by synonyms (or at least near-synonyms) in another language. In a general sense, a glossary contains explanations of concepts relevant to a certain field of study or action. In this sense, the term is related to the notion of ontology."}}, {"canonical_name": "D. João III", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "d__joão_iii", "book_id": "coloquios_da_orta_1563", "name": "D. João III", "category": "PERSON", "subcategory": "PATRON", "count": 13, "variants": ["D. João III", "D. JoSo III", "D. Joào III", "D. João ID", "D. João II", "D. João Úl"], "contexts": ["historical figure associated with exploration", "King of Portugal, patron of exploration"]}, {"entity_id": "joao_iii_", "book_id": "polyanthea_medicinal", "name": "Joao III.", "category": "PERSON", "subcategory": "PATRON", "count": 7, "variants": ["Joao III.", "D. Joao o IV", "Dom Joao III"], "contexts": ["King of Poland", "King John III"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "D. João III", "target_book": "polyanthea_medicinal", "target_name": "Joao III.", "similarity": 0.861}], "id": 746, "stable_key": "clu_25d915ffa96b7e9b", "ground_truth": {"modern_name": "John III of Portugal", "confidence": "high", "type": "person", "description": "King of Portugal, patron of exploration and arts.", "note": "Also appears as John III of Poland, but primary context is Portuguese exploration.", "wikipedia_extract": "John III (Portuguese: João III Portuguese pronunciation: [ʒuˈɐ̃w]; 6 June 1502 – 11 June 1557), nicknamed The Pious (Portuguese: o Piedoso), was the King of Portugal and the Algarve from 1521 until he died in 1557. He was the son of King Manuel I and Maria of Aragon, the third daughter of the Catholic Monarchs of Spain, Ferdinand II of Aragon and Isabella I of Castile. John succeeded his father in 1521 at the age of nineteen. During his rule, Portuguese possessions were extended in Asia and the Americas through the Portuguese colonization of Brazil. John III's policy of reinforcing Portugal's bases in India, such as Goa, secured Portugal's monopoly over the spice trade of cloves and nutmeg from the Maluku Islands. On the eve of his death in 1557, the Portuguese Empire had a global dimension and spanned almost 4 million square kilometres (1.5 million square miles)."}}, {"canonical_name": "Mercurialis", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "mercurialis", "book_id": "polyanthea_medicinal", "name": "Mercurialis", "category": "PERSON", "subcategory": "SCHOLAR", "count": 18, "variants": ["Mercurialis", "Mercurialis,"], "contexts": ["confirms the influence of images during conception", "consil."]}, {"entity_id": "mercurialis", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mercurialis", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Mercurialis"], "contexts": ["author of Gymnasticks"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Mercurialis", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Mercurialis", "similarity": 1.0}], "id": 747, "stable_key": "clu_44b2a601390ceaef", "ground_truth": {"modern_name": "Joannes Messis Mercurialis", "confidence": "high", "type": "person", "birth_year": 1534, "death_year": 1614, "description": "Italian physician, anatomist, and botanist, known for works on gymnastics.", "note": "While the texts mention 'Mercurialis' and a connection to conception, the primary association in early modern texts is with Joannes Messis Mercurialis, an Italian physician and scholar."}}, {"canonical_name": "escabiosa", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "escabiosa", "book_id": "polyanthea_medicinal", "name": "escabiosa", "category": "PLANT", "subcategory": "PLANT", "count": 15, "variants": ["escabiosa", "eescabiosa", "escabiofa", "escabiola", "escabioſa", "escaiofa", "escarbiofa"], "contexts": ["plant used in a remedy", "herb used in remedies"]}, {"entity_id": "scabious", "book_id": "english_physician_1652", "name": "Scabious", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["Scabious", "Scabiaus"], "contexts": ["leaves of bugle, scabious and sanicle", "plant for comparison of flower heads"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "escabiosa", "target_book": "english_physician_1652", "target_name": "Scabious", "similarity": 0.902}], "id": 748, "stable_key": "clu_e571f932101d86b2", "ground_truth": {"modern_name": "Scabious", "confidence": "high", "type": "plant", "description": "Herbaceous plant, often used in traditional medicine.", "note": "Common name for plants in the Caprifoliaceae family, genus Knautia or Scabiosa.", "wikipedia_extract": "Scabiosa  is a genus in the honeysuckle family (Caprifoliaceae) of flowering plants. Many of the species in this genus have common names that include the word scabious, but some plants commonly known as scabious are currently classified in related genera such as Knautia and Succisa; at least some of these were formerly placed in Scabiosa. Another common name for members of this genus is pincushion flowers. The common name 'scabious' comes the Latin word scabiosus meaning 'mangy, rough or itchy' which refers to the herb's traditional usage as a folk medicine to treat scabies, an illness that causes a severe itching sensation. Some species of Scabiosa are annuals, others perennials. Some are herbaceous plants; others have woody rootstocks."}}, {"canonical_name": "humores frios", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "humores_frios", "book_id": "polyanthea_medicinal", "name": "humores frios", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 15, "variants": ["humores frios", "humores frigidi"], "contexts": ["cold humors affecting nerves", "body fluids causing sudden paralysis"]}, {"entity_id": "cold_humors", "book_id": "english_physician_1652", "name": "cold humors", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["cold humors", "cold Humors", "cold Joynts", "cold Rhewm"], "contexts": ["cause of convulsions and cramps", "humors distilling from the brain"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "humores frios", "target_book": "english_physician_1652", "target_name": "cold humors", "similarity": 0.971}], "id": 749, "stable_key": "clu_35dc53f8de450181", "ground_truth": {"modern_name": "Cold humors", "confidence": "high", "type": "substance", "description": "Bodily fluids believed to cause illness and affect nerves.", "note": "A concept from humoral theory in ancient and medieval medicine.", "wikipedia_extract": "Humorism, the humoral theory, or humoralism, was a system of medicine detailing a supposed makeup and workings of the human body, adopted by Ancient Greek and Roman physicians and philosophers. Humorism began to fall out of favor in the 17th century and it was definitively disproved with the discovery of microbes. The concept of \"humors\" may have origins in Ancient Egyptian medicine, or Mesopotamia, though it was not systemized until ancient Greek thinkers. The word humor is a translation of Greek χυμός, chymos (literally 'juice' or 'sap', metaphorically 'flavor'). Early texts on Indian Ayurveda medicine presented a theory of three or four humors (doṣas), which they sometimes linked with the five elements (pañca-bhūta): earth, water, fire, air, and space. The concept of \"humors\" (chemical systems regulating human behaviour) became more prominent from the writing of medical theorist Alcmaeon of Croton (c. 540–500 BC)."}}, {"canonical_name": "embryo", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "embryo", "book_id": "origin_of_species_darwin_1859", "name": "embryo", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 8, "variants": ["embryo"], "contexts": ["early developmental stage affected by malconformation", "developing organism from fertilization"]}, {"entity_id": "embryonic", "book_id": "origin_of_species_darwin_1859", "name": "embryonic", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 2, "variants": ["embryonic"], "contexts": ["relating to early development", "relating to the early stage of development"]}, {"entity_id": "embryos", "book_id": "origin_of_species_darwin_1859", "name": "embryos", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["embryos"], "contexts": ["developing organisms"]}, {"entity_id": "embryonic_stages", "book_id": "origin_of_species_darwin_1859", "name": "embryonic stages", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["embryonic stages"], "contexts": ["developmental phases of embryo"]}, {"entity_id": "embryonic_structure", "book_id": "origin_of_species_darwin_1859", "name": "embryonic structure", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["embryonic structure"], "contexts": ["structure of the embryo"]}, {"entity_id": "embryos_of_vertebrata", "book_id": "origin_of_species_darwin_1859", "name": "embryos of vertebrata", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["embryos of vertebrata"], "contexts": ["developing vertebrate organisms"]}, {"entity_id": "embryonic_teeth", "book_id": "origin_of_species_darwin_1859", "name": "embryonic teeth", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["embryonic teeth"], "contexts": ["traces of in birds"]}, {"entity_id": "embryo", "book_id": "first_principles_spencer_1862", "name": "embryo", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 3, "variants": ["embryo"], "contexts": ["general structure marked out with precision", "developing organism before birth"]}, {"entity_id": "embryonic_mass", "book_id": "first_principles_spencer_1862", "name": "embryonic mass", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["embryonic mass"], "contexts": ["mass where intestine forms"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "embryo", "target_book": "first_principles_spencer_1862", "target_name": "embryo", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "embryo", "target_book": "first_principles_spencer_1862", "target_name": "embryonic mass", "similarity": 0.884}, {"source_book": "origin_of_species_darwin_1859", "source_name": "embryonic", "target_book": "first_principles_spencer_1862", "target_name": "embryo", "similarity": 0.964}, {"source_book": "origin_of_species_darwin_1859", "source_name": "embryonic", "target_book": "first_principles_spencer_1862", "target_name": "embryonic mass", "similarity": 0.895}, {"source_book": "origin_of_species_darwin_1859", "source_name": "embryos", "target_book": "first_principles_spencer_1862", "target_name": "embryo", "similarity": 0.993}, {"source_book": "origin_of_species_darwin_1859", "source_name": "embryos", "target_book": "first_principles_spencer_1862", "target_name": "embryonic mass", "similarity": 0.884}, {"source_book": "origin_of_species_darwin_1859", "source_name": "embryonic stages", "target_book": "first_principles_spencer_1862", "target_name": "embryo", "similarity": 0.897}, {"source_book": "origin_of_species_darwin_1859", "source_name": "embryonic stages", "target_book": "first_principles_spencer_1862", "target_name": "embryonic mass", "similarity": 0.821}, {"source_book": "origin_of_species_darwin_1859", "source_name": "embryonic structure", "target_book": "first_principles_spencer_1862", "target_name": "embryo", "similarity": 0.937}, {"source_book": "origin_of_species_darwin_1859", "source_name": "embryonic structure", "target_book": "first_principles_spencer_1862", "target_name": "embryonic mass", "similarity": 0.885}, {"source_book": "origin_of_species_darwin_1859", "source_name": "embryos of vertebrata", "target_book": "first_principles_spencer_1862", "target_name": "embryo", "similarity": 0.937}, {"source_book": "origin_of_species_darwin_1859", "source_name": "embryos of vertebrata", "target_book": "first_principles_spencer_1862", "target_name": "embryonic mass", "similarity": 0.839}, {"source_book": "origin_of_species_darwin_1859", "source_name": "embryonic teeth", "target_book": "first_principles_spencer_1862", "target_name": "embryo", "similarity": 0.893}, {"source_book": "origin_of_species_darwin_1859", "source_name": "embryonic teeth", "target_book": "first_principles_spencer_1862", "target_name": "embryonic mass", "similarity": 0.826}], "id": 750, "stable_key": "clu_550949ccb8dce92a", "ground_truth": {"modern_name": "Embryo", "confidence": "high", "type": "concept"}}, {"canonical_name": "Honda", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "honda", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Honda", "category": "PLACE", "subcategory": "CITY", "count": 18, "variants": ["Honda"], "contexts": ["city", "city on the Magdalena river"]}, {"entity_id": "honda", "book_id": "kosmos_humboldt_1845", "name": "Honda", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Honda"], "contexts": ["location where cannon-like noises were heard"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Honda", "target_book": "kosmos_humboldt_1845", "target_name": "Honda", "similarity": 1.0}], "id": 751, "stable_key": "clu_68c20e1fe2152a74", "ground_truth": {"modern_name": "Honda", "confidence": "high", "type": "place", "country": "Colombia"}}, {"canonical_name": "amygdaloid", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "amygdaloid", "book_id": "relation_historique_humboldt_vol3_1825", "name": "amygdaloid", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 14, "variants": ["amygdaloid", "amygdaloicles", "amygdaloide", "amygdaloides", "amygdaloïde", "amygdaloïdes", "aniygdaloïdes"], "contexts": ["geological formation described as masses", "geological formation, second type"]}, {"entity_id": "amygdaloid", "book_id": "kosmos_humboldt_1845", "name": "amygdaloid", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["amygdaloid"], "contexts": ["igneous rock with cavities", "rock type that is shaken by earthquakes"]}, {"entity_id": "amygdaloids", "book_id": "kosmos_humboldt_1845", "name": "amygdaloids", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["amygdaloids"], "contexts": ["rock texture"]}, {"entity_id": "feldspathic_amygdaloids", "book_id": "kosmos_humboldt_1845", "name": "feldspathic amygdaloids", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["feldspathic amygdaloids"], "contexts": ["rock formation component"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "amygdaloid", "target_book": "kosmos_humboldt_1845", "target_name": "amygdaloid", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "amygdaloid", "target_book": "kosmos_humboldt_1845", "target_name": "amygdaloids", "similarity": 0.994}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "amygdaloid", "target_book": "kosmos_humboldt_1845", "target_name": "feldspathic amygdaloids", "similarity": 0.911}], "id": 752, "stable_key": "clu_a51b192066b9c12f", "ground_truth": {"modern_name": "Amygdaloid", "confidence": "high", "type": "mineral", "note": "Amygdaloid refers to a volcanic rock texture with cavities, often filled with minerals. It's used in geology and mineralogy.", "wikipedia_extract": "The amygdala (; pl.: amygdalae  or amygdalas; also corpus amygdaloideum) is a paired  nuclear complex present in the cerebral hemispheres of vertebrates. It is considered part of the limbic system. In primates, it is located medially within the temporal lobes. It consists of many nuclei, each made up of further subnuclei. The subdivision most commonly made is into the basolateral, central, cortical, and medial nuclei together with the intercalated cell clusters. The amygdala has a primary role in the processing of memory, decision-making, and emotional responses (including fear, anxiety, and aggression).", "wikipedia_url": "https://en.wikipedia.org/wiki/Amygdala"}}, {"canonical_name": "costo", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "costo", "book_id": "coloquios_da_orta_1563", "name": "costo", "category": "PLANT", "subcategory": "PLANT", "count": 18, "variants": ["costo", "Cost", "Costo", "Costus", "cost", "costi", "costus"], "contexts": ["plant mentioned in relation to theofrasto", "plant compared to cacollá"]}, {"entity_id": "costo", "book_id": "polyanthea_medicinal", "name": "costo", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["costo"], "contexts": ["spice used in a syrup"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "costo", "target_book": "polyanthea_medicinal", "target_name": "costo", "similarity": 1.0}], "id": 753, "stable_key": "clu_b06349b300f365f6", "ground_truth": {"modern_name": "Costmary", "confidence": "medium", "type": "plant", "linnaean": "Tanacetum balsamita", "family": "Asteraceae", "description": "Aromatic herb, sometimes used medicinally.", "note": "The term 'costo' in early modern texts often referred to Costmary (Tanacetum balsamita), also known as 'alecost'.", "wikipedia_extract": "Tanacetum balsamita is a perennial temperate herb known as costmary, alecost, balsam herb, bible leaf, or mint geranium. A fragrant plant native to southern Europe and western Asia, it has been used over centuries for culinary, aromatic, and traditional medicine purposes. Costmary is a perennial with oval serrated leaves and can grow up to 2 m (6.6 ft) high. During summer, it shows small, yellow, button-shaped blossoms which appear in clusters. The English name 'costmary' stems from 'costus of Saint Mary'. Also, in other languages, it is associated with the Virgin Mary, most probably because it was thought to be a treatment for women's diseases in folk medicine."}}, {"canonical_name": "beldroegas", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "beldroegas", "book_id": "polyanthea_medicinal", "name": "beldroegas", "category": "PLANT", "subcategory": "PLANT", "count": 16, "variants": ["beldroegas"], "contexts": ["plant used in a syrup", "plant used in decoctions"]}, {"entity_id": "beldroega", "book_id": "coloquios_da_orta_1563", "name": "beldroega", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["beldroega", "beldroegas"], "contexts": ["plant name, purslane", "plant with leaves"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "beldroegas", "target_book": "coloquios_da_orta_1563", "target_name": "beldroega", "similarity": 0.976}], "id": 754, "stable_key": "clu_e674fbdd5d53b87b", "ground_truth": {"modern_name": "Purslane", "confidence": "high", "type": "plant", "linnaean": "Portulaca oleracea", "family": "Portulacaceae", "description": "Edible plant with succulent leaves, used medicinally.", "wikipedia_extract": "Portulaca oleracea (common purslane, also known as little hogweed, or pursley) is a succulent plant in the family Portulacaceae. All parts of the plant are edible raw or cooked. Purslane grows from a taproot with fibrous secondary roots. The plant may reach 40 centimetres (16 inches) in height. It has smooth, reddish, mostly prostrate stems, and the leaves, which may be alternate or opposite, are clustered at stem joints and ends. The yellow flowers have five regular parts and are up to 6 millimetres (1⁄4 inch) wide."}}, {"canonical_name": "Hyera", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "hyera", "book_id": "polyanthea_medicinal", "name": "Hyera", "category": "PLANT", "subcategory": "PLANT", "count": 16, "variants": ["hyera", "Hyera"], "contexts": ["purgative substance", "a medicinal preparation"]}, {"entity_id": "heger", "book_id": "coloquios_da_orta_1563", "name": "Heger", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Heger", "heger"], "contexts": ["name for calamus in Pérsio", "Persian name for the plant"]}, {"entity_id": "hetre", "book_id": "coloquios_da_orta_1563", "name": "hetre", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["hetre"], "contexts": ["food for the sick"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Hyera", "target_book": "coloquios_da_orta_1563", "target_name": "Heger", "similarity": 0.847}, {"source_book": "polyanthea_medicinal", "source_name": "Hyera", "target_book": "coloquios_da_orta_1563", "target_name": "hetre", "similarity": 0.854}], "id": 755, "stable_key": "clu_d3e949865ebbe6a0", "ground_truth": {"modern_name": "Calamus", "confidence": "high", "type": "plant", "linnaean": "Acorus calamus", "family": "Acoraceae", "description": "Aromatic reed with medicinal properties.", "note": "The Persian name for calamus is 'heger' or 'hetre'.", "wikipedia_extract": "Acorus calamus (also called sweet flag, sway or muskrat root, among many other common names) is a species of flowering plant with psychoactive chemicals. It is a tall wetland monocot of the family Acoraceae, in the genus Acorus. Although used in traditional medicine over centuries to treat digestive disorders and pain, it has no clinical evidence of safety or efficacy and may be toxic if ingested, and so has been commercially banned for use in food in the United States. Sweet flag is a herbaceous perennial, 2 m (79 in) tall. Its leaves resemble those of the iris family. Sweet flag consists of tufts of basal leaves that rise from a spreading rhizome."}}, {"canonical_name": "coentro", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "coentro", "book_id": "polyanthea_medicinal", "name": "coentro", "category": "PLANT", "subcategory": "PLANT", "count": 15, "variants": ["coentro", "Coentro", "coentro ſecco", "coentros", "ſemente de coentro"], "contexts": ["herb used in confection for headaches", "dried herb used in preparation"]}, {"entity_id": "coentro", "book_id": "coloquios_da_orta_1563", "name": "coentro", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["coentro"], "contexts": ["seed used in preparation", "seed size comparison"]}, {"entity_id": "coentro_fecco", "book_id": "polyanthea_medicinal", "name": "coentro fecco", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["coentro fecco"], "contexts": ["ingredient in poultice for headaches", "dried coriander"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "coentro", "target_book": "coloquios_da_orta_1563", "target_name": "coentro", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "coentro", "target_book": "polyanthea_medicinal", "target_name": "coentro fecco", "similarity": 0.811}], "id": 756, "stable_key": "clu_4da235b05a8199bf", "ground_truth": {"modern_name": "Coriander", "confidence": "high", "type": "plant", "linnaean": "Coriandrum sativum", "family": "Apiaceae", "description": "Herb with aromatic seeds and leaves, used in medicine.", "wikipedia_extract": "Coriander (), or Coriandrum sativum, is an annual herb in the family Apiaceae. The leaves are known as cilantro () in the United States (but not in the United Kingdom). Most people perceive the leaves as having a fresh, slightly citrus taste. Due to variations in the gene OR6A2, some people perceive its flavor to be more soaplike or rotten. The species is native to the Mediterranean Basin. All parts of the plant are edible, with the fresh leaves and dried seeds most traditionally used in cooking."}}, {"canonical_name": "incenfo macho", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "incenfo_macho", "book_id": "polyanthea_medicinal", "name": "incenfo macho", "category": "PLANT", "subcategory": "PLANT", "count": 17, "variants": ["incenfo macho", "Incenso macho", "Incenſo macho", "incenso macho", "incenſo macho", "pòde incenſo macho"], "contexts": ["male incense", "male incense (likely frankincense)"]}, {"entity_id": "encenço_macho", "book_id": "coloquios_da_orta_1563", "name": "encenço macho", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["encenço macho"], "contexts": ["male incense", "a plant called male incense"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "incenfo macho", "target_book": "coloquios_da_orta_1563", "target_name": "encenço macho", "similarity": 0.917}], "id": 757, "stable_key": "clu_a3b91eeaf52dc87e", "ground_truth": {"modern_name": "Frankincense", "confidence": "high", "type": "plant", "description": "Resinous tree producing aromatic incense, also used medicinally.", "note": "The term 'incenfo macho' or 'encenço macho' likely refers to frankincense, derived from Boswellia species. It could also refer to a plant with similar aromatic properties used as a substitute.", "wikipedia_extract": "Frankincense, also known as olibanum (), is an aromatic resin used in incense and perfume, obtained from trees of the genus Boswellia in the family Burseraceae. The word is from Old French franc encens ('high-quality incense'). There are several species of Boswellia that produce  frankincense, including, but not limited to, Boswellia sacra (syn. B. bhaw-dajiana, syn. B. carteri), B. frereana, B. serrata (B. thurifera), and B. papyrifera. Resin from each is available in various grades which is affected by the time in which it is harvested."}}, {"canonical_name": "Ventofas", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "ventofas", "book_id": "polyanthea_medicinal", "name": "Ventofas", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 18, "variants": ["Ventofas", "Ventofas ſarjadu", "ventofas", "ventofas farjadas"], "contexts": ["cupping glasses used for bleeding", "devices for drawing blood"]}, {"entity_id": "ventosas", "book_id": "coloquios_da_orta_1563", "name": "ventosas", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["ventosas"], "contexts": ["medical cups for cupping"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Ventofas", "target_book": "coloquios_da_orta_1563", "target_name": "ventosas", "similarity": 0.905}], "id": 758, "stable_key": "clu_f646926eff6cec25", "ground_truth": {"modern_name": "Cupping glasses", "confidence": "high", "type": "object", "description": "Medical instruments used for cupping therapy.", "wikipedia_extract": "Cupping therapy is a pseudoscientific treatment method in which a local suction is created on the skin by using heated cups. As an alternative medicine practice, it is primarily used in Asia, but it is also used in Eastern Europe, the Middle East, and Latin America. There is no conclusive evidence supporting the claimed health benefits of cupping, and critics have characterized the practice as quackery. Cupping practitioners attempt to use cupping therapy for a wide array of medical conditions including fevers, chronic low back pain, poor appetite, indigestion, high blood pressure, acne, atopic dermatitis, psoriasis, anemia, stroke rehabilitation, nasal congestion, infertility, and menstrual period cramping. Despite the numerous ailments for which practitioners claim cupping therapy is useful, there is insufficient evidence demonstrating any health benefits. Cupping is generally not harmful for most people."}}, {"canonical_name": "Curcuma", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 18, "members": [{"entity_id": "curcuma", "book_id": "coloquios_da_orta_1563", "name": "Curcuma", "category": "PLANT", "subcategory": "PLANT", "count": 17, "variants": ["Curcuma", "Curcuma Zedoaria", "Curcuma angusUfolia", "Curcuma longa", "curcuma", "curcumani", "curcumanit meimiram"], "contexts": ["plant related to a root", "plant used for medicine and dyeing"]}, {"entity_id": "curcuma", "book_id": "ricettario_fiorentino_1597", "name": "Curcuma", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Curcuma"], "contexts": ["plant believed to be a type of Cippero"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Curcuma", "target_book": "ricettario_fiorentino_1597", "target_name": "Curcuma", "similarity": 0.893}], "id": 759, "stable_key": "clu_9d76036ffef1942d", "ground_truth": {"modern_name": "Turmeric", "confidence": "high", "type": "plant", "linnaean": "Curcuma longa", "family": "Zingiberaceae", "description": "Plant root used for medicine and dyeing, related to Cippero.", "wikipedia_extract": "Turmeric (), or Curcuma longa (), is a flowering plant in the ginger family Zingiberaceae. It is a perennial, rhizomatous, herbaceous plant native to the Indian subcontinent and Southeast Asia that requires temperatures between 20 and 30 °C (68 and 86 °F) and high annual rainfall to thrive. Plants are gathered each year for their rhizomes, some for propagation in the following season and some for consumption or dyeing. The rhizomes can be used fresh, but they are often boiled in water and dried, after which they are ground into a deep orange-yellow shelf-stable spice powder commonly used as a coloring and flavoring agent in many Asian cuisines, especially for curries (curry powder). Turmeric powder has a warm, bitter, black pepper-like flavor and earthy, mustard-like aroma. Although long used in Ayurvedic medicine, there is no high-quality clinical evidence that consuming turmeric or the principal turmeric constituent, curcumin, is effective for treating any disease."}}, {"canonical_name": "Mirra", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 18, "members": [{"entity_id": "mirra", "book_id": "coloquios_da_orta_1563", "name": "Mirra", "category": "PLANT", "subcategory": "PLANT", "count": 17, "variants": ["Mirra", "mirra"], "contexts": ["plant product used in medicine", "used in embalming with aloes"]}, {"entity_id": "mirra", "book_id": "polyanthea_medicinal", "name": "mirra", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["mirra"], "contexts": ["ingredient in plaster"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Mirra", "target_book": "polyanthea_medicinal", "target_name": "mirra", "similarity": 0.963}], "id": 760, "stable_key": "clu_838c4643d3ebbb61", "ground_truth": {"modern_name": "myrrh", "confidence": "high", "type": "plant", "description": "A fragrant resinous substance from certain trees, used medicinally.", "note": "Refers to the plant product, not the tree itself.", "wikipedia_extract": "Myrrh (; from an unidentified ancient Semitic language, مر; from Arabic, מוֹר /mor/; from Hebrew, see § Etymology) is a gum-resin extracted from a few small, thorny tree species of the Commiphora genus, belonging to the Burseraceae family. Myrrh resin was traded in the ancient world, and has been used throughout history in medicine, in ritual, and to make perfume and incense. Its use is mentioned in the Hebrew Bible, the New Testament and in Islamic texts, as well as by ancient historians. It is still used by certain Christian denominations for ritual purposes. When a cut on a tree penetrates through the bark and into the sapwood, the tree secretes a resin. Myrrh gum, like frankincense, is such a resin."}}, {"canonical_name": "redness", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 18, "members": [{"entity_id": "redness", "book_id": "english_physician_1652", "name": "redness", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 17, "variants": ["redness", "Redness", "redness in the Eyes", "redness in the Face", "redness of Sight"], "contexts": ["symptom of the eyes", "condition of eyes helped by borrage water"]}, {"entity_id": "raucedine", "book_id": "polyanthea_medicinal", "name": "raucedine", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["raucedine"], "contexts": ["hoarseness"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "redness", "target_book": "polyanthea_medicinal", "target_name": "raucedine", "similarity": 0.864}], "id": 761, "stable_key": "clu_9d521ad216cb44e4", "ground_truth": {"modern_name": "redness", "confidence": "medium", "type": "disease", "description": "A visible symptom characterized by an unnatural red coloration of the skin.", "note": "The member 'raucedine' appears to be an outlier and refers to hoarseness, a symptom of the throat, not redness.", "wikipedia_extract": "Red is the color at the long wavelength end of the visible spectrum of light, next to orange and opposite violet. It has a dominant wavelength of approximately 625–750 nanometers. It is a primary color in the RGB color model and a secondary color (made from magenta and yellow) in the CMYK color model, and is the complementary color of cyan. Reds range from the brilliant yellow-tinged scarlet and vermillion to bluish-red crimson, and vary in shade from the pale red pink to the dark red burgundy. Red pigment made from ochre was one of the first colors used in prehistoric art. The Ancient Egyptians and Mayans colored their faces red in ceremonies; Roman generals had their bodies colored red to celebrate victories."}}, {"canonical_name": "Electuary", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 18, "members": [{"entity_id": "electuary", "book_id": "english_physician_1652", "name": "Electuary", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 9, "variants": ["Electuary", "Electuaries"], "contexts": ["sweetened medicinal paste", "used for gout"]}, {"entity_id": "electuario", "book_id": "polyanthea_medicinal", "name": "electuario", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 9, "variants": ["electuario", "electuario rofado", "electuarios"], "contexts": ["medicinal confection taken at night", "type of medicinal preparation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Electuary", "target_book": "polyanthea_medicinal", "target_name": "electuario", "similarity": 0.923}], "id": 762, "stable_key": "clu_88ecfbdedfda4168", "ground_truth": {"modern_name": "electuary", "confidence": "high", "type": "substance", "description": "A sweet, paste-like medicinal preparation mixed with honey or syrup.", "wikipedia_extract": "An electuary is a medicine consisting of a powder or other ingredient mixed with something sweet such as honey to make it more palatable. In German and Swiss cultures, electuary (German: Latwerge or Latwerg) is also more generally a thickened juice and honey preparation with a thick, viscous consistency that is used in for culinary purposes, such as a (bread) spread or as a sauce ingredient. In the Indian Ayurveda tradition, electuaries are called Lēhya (लेह्य) (literally, \"lickable\"). There are several different types of electuary: laxative electuary, joyful electuary, etc. The fermentation of mixed herbs in honey and their effects on each other are said to increase the medical properties already present and to create new ones. Avicenna (1999)."}}, {"canonical_name": "creation", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 18, "members": [{"entity_id": "creation", "book_id": "origin_of_species_darwin_1859", "name": "creation", "category": "CONCEPT", "subcategory": "THEORY", "count": 9, "variants": ["creation", "Creation"], "contexts": ["special act of creation", "theory of divine origin"]}, {"entity_id": "theory_of_creation", "book_id": "origin_of_species_darwin_1859", "name": "theory of creation", "category": "CONCEPT", "subcategory": "THEORY", "count": 6, "variants": ["theory of creation"], "contexts": ["explanation for species distribution", "explanation of life's origin by a creator"]}, {"entity_id": "doctrine_of_creation", "book_id": "origin_of_species_darwin_1859", "name": "doctrine of creation", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["doctrine of creation"], "contexts": ["creationist view of species origin"]}, {"entity_id": "theory_of_creation", "book_id": "first_principles_spencer_1862", "name": "theory of creation", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["theory of creation"], "contexts": ["explanation of the origin of the universe", "explanation for the origin of the universe"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "creation", "target_book": "first_principles_spencer_1862", "target_name": "theory of creation", "similarity": 0.957}, {"source_book": "origin_of_species_darwin_1859", "source_name": "theory of creation", "target_book": "first_principles_spencer_1862", "target_name": "theory of creation", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "doctrine of creation", "target_book": "first_principles_spencer_1862", "target_name": "theory of creation", "similarity": 0.896}], "id": 763, "stable_key": "clu_82b49559776b1e70", "ground_truth": {"modern_name": "Creationism", "confidence": "high", "type": "concept", "note": "Contexts suggest a theory of how species originated, contrasting with Darwinian evolution.", "wikidata_id": "Q1430216", "wikidata_description": "doctrine that God creates a soul for each body that is generated, as opposed to pre-existing before birth or being generated during conception", "wikipedia_url": "https://en.wikipedia.org/wiki/Creationism%20%28soul%29", "wikipedia_extract": "Creationism is the religious belief that nature, and aspects such as the universe, Earth, life, and humans, originated with supernatural acts of divine creation, and is often pseudoscientific. In its broadest sense, creationism includes various religious views, which differ in their acceptance or rejection of modern scientific concepts, such as evolution, that describe the origin and development of natural phenomena. The term creationism most often refers to belief in special creation: the claim that the universe and lifeforms were created as they exist today by divine action, and that the only true explanations are those which are compatible with a Christian fundamentalist literal interpretation of the creation myth found in the Bible's Genesis creation narrative. Since the 1970s, the most common form of this has been Young Earth creationism which posits special creation of the universe and lifeforms within the last 10,000 years on the basis of flood geology, and promotes pseudoscientific creation science. From the 18th century onward, Old Earth creationism accepted geological time harmonized with Genesis through gap or day-age theory, while supporting anti-evolution. Modern old-Earth creationists support progressive creationism and continue to reject evolutionary explanations."}}, {"canonical_name": "Alepo", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 18, "members": [{"entity_id": "alepo", "book_id": "coloquios_da_orta_1563", "name": "Alepo", "category": "PLACE", "subcategory": "CITY", "count": 16, "variants": ["Alepo", "Aleppo"], "contexts": ["principal city of Syria", "trading city"]}, {"entity_id": "aleppo", "book_id": "kosmos_humboldt_1845", "name": "Aleppo", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Aleppo"], "contexts": ["major city in Syria", "Pachalik where earthquakes occurred"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Alepo", "target_book": "kosmos_humboldt_1845", "target_name": "Aleppo", "similarity": 0.945}], "id": 764, "stable_key": "clu_44049b3f558b81e8", "ground_truth": {"modern_name": "Aleppo", "confidence": "high", "type": "place", "country": "Syria", "wikidata_id": "Q211457", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Battle_of_Aleppo_(2012–2016)", "wikipedia_extract": "The Battle of Aleppo (Arabic: مَعْرَكَةُ حَلَبَ, romanized: Maʿrakat Ḥalab) was a major military confrontation in Aleppo, the largest city in Syria, between the Syrian opposition militias (such as the Free Syrian Army (FSA), the Levant Front and the al-Nusra Front) against the Ba'athist Syrian government, supported by Hezbollah, IRGC-backed Shia militant groups, Iran, and Russia, and against the Kurdish-majority People's Protection Units (YPG). The battle began on 19 July 2012 and was part of the Syrian Civil War. A stalemate that had been in place for four years finally ended in July 2016, when Ba'athist government troops closed the rebels' last supply line into Aleppo with the support of Russian airstrikes. In response, rebel forces launched unsuccessful counteroffensives in September and October that failed to break the siege; in November, government forces embarked on a decisive campaign that resulted in the recapture of all of Aleppo by December 2016. The Syrian government victory was widely seen as a turning point in Syria's civil war. The large-scale devastation of the battle and its importance led combatants to name it the \"mother of battles\" or \"Syria's Stalingrad\"."}}, {"canonical_name": "ameixas", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 18, "members": [{"entity_id": "ameixas", "book_id": "coloquios_da_orta_1563", "name": "ameixas", "category": "PLANT", "subcategory": "PLANT", "count": 8, "variants": ["ameixas", "ameixa", "ameixas redondas"], "contexts": ["fruit", "fruit that rots and causes fevers"]}, {"entity_id": "ameixas", "book_id": "polyanthea_medicinal", "name": "ameixas", "category": "PLANT", "subcategory": "PLANT", "count": 8, "variants": ["ameixas"], "contexts": ["fruit used in diet", "prunes used in a decoction"]}, {"entity_id": "ameixas_pafladas", "book_id": "polyanthea_medicinal", "name": "ameixas pafladas", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["ameixas pafladas"], "contexts": ["dried plums used in remedies"]}, {"entity_id": "ameixas_calfacas", "book_id": "polyanthea_medicinal", "name": "ameixas calfacas", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["ameixas calfacas"], "contexts": ["prunes"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "ameixas", "target_book": "polyanthea_medicinal", "target_name": "ameixas", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "ameixas", "target_book": "polyanthea_medicinal", "target_name": "ameixas pafladas", "similarity": 0.82}, {"source_book": "coloquios_da_orta_1563", "source_name": "ameixas", "target_book": "polyanthea_medicinal", "target_name": "ameixas calfacas", "similarity": 0.823}], "id": 765, "stable_key": "clu_14a337cc8230d21e", "ground_truth": {"modern_name": "Plums/Prunes", "confidence": "high", "type": "plant", "description": "Fruit used in diet, remedies, and known to cause fevers when rotting.", "note": "Includes dried plums ('ameixas pafladas', 'ameixas calfacas').", "wikipedia_extract": "A plum is a fruit of some species in Prunus subg. Prunus. Dried plums are usually called prunes. Plums are likely to have been one of the first fruits domesticated by humans, with origins in Eastern Europe, the Caucasus Mountains and China. They were brought to Britain from Asia, and their cultivation has been documented in Andalusia, southern Spain. Plums are a diverse group of species, with trees reaching a height of 5–6 metres (16–20 ft) when pruned."}}, {"canonical_name": "Cavallo", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 18, "members": [{"entity_id": "cavallo", "book_id": "polyanthea_medicinal", "name": "Cavallo", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 11, "variants": ["Cavallo", "cavallo", "cavallos", "cavalos"], "contexts": ["part of a compound name, likely animal-related", "horse"]}, {"entity_id": "cavallos", "book_id": "coloquios_da_orta_1563", "name": "cavallos", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 7, "variants": ["cavallos", "cavalo", "cavalos"], "contexts": ["animals traded at Ormuz", "exported from Xael"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Cavallo", "target_book": "coloquios_da_orta_1563", "target_name": "cavallos", "similarity": 0.922}], "id": 766, "stable_key": "clu_a9b9e763fbaefdf0", "ground_truth": {"modern_name": "Horse", "confidence": "high", "type": "animal", "linnaean": "Equus caballus", "family": "Equidae", "description": "Animal traded and exported, potentially appearing in compound names.", "wikipedia_extract": "The horse (Equus ferus caballus) is a domesticated, one-toed, hoofed mammal. It belongs to the taxonomic family Equidae and is one of two extant subspecies of Equus ferus. The horse has evolved over the past 45 to 55 million years from a small multi-toed creature, Eohippus, into the large single-toed animal of today, originally in North America. Humans began domesticating horses around 4000 BCE in Central Asia, and their domestication is believed to have been widespread by 3000 BCE. Horses in the subspecies caballus are domesticated, although some domesticated populations live in the wild as feral horses. These feral populations are not true wild horses, which are horses that have never been domesticated."}}, {"canonical_name": "animaes", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 18, "members": [{"entity_id": "animaes", "book_id": "polyanthea_medicinal", "name": "animaes", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 16, "variants": ["animaes", "animal", "animalcula", "animali"], "contexts": ["vital spirits", "animals"]}, {"entity_id": "animaes", "book_id": "coloquios_da_orta_1563", "name": "animaes", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 2, "variants": ["animaes"], "contexts": ["animals, source of bezoars", "animals that are washed"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "animaes", "target_book": "coloquios_da_orta_1563", "target_name": "animaes", "similarity": 1.0}], "id": 767, "stable_key": "clu_b02c1359b8b4a6af", "ground_truth": {"modern_name": "Animals", "confidence": "high", "type": "animal", "description": "Living creatures, sources of bezoars, subject to washing.", "note": "Can also refer to 'vital spirits' in a more abstract sense.", "wikipedia_extract": "Animals are multicellular, eukaryotic organisms belonging to the biological kingdom Animalia (). With few exceptions, animals consume organic material, breathe oxygen, have myocytes and are able to move, can reproduce sexually, and grow from a hollow sphere of cells, the blastula, during embryonic development. Animals form a clade, meaning that they arose from a single common ancestor. Over 1.5 million living animal species have been described, of which around 1.05 million are insects, over 85,000 are molluscs, and around 65,000 are vertebrates. It has been estimated there are as many as 7.77 million animal species on Earth. Animal body lengths range from 8.5 μm (0.00033 in) to 33.6 m (110 ft)."}}, {"canonical_name": "Salva", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 18, "members": [{"entity_id": "salva", "book_id": "polyanthea_medicinal", "name": "Salva", "category": "PLANT", "subcategory": "PLANT", "count": 17, "variants": ["Salva", "salva", "salva verde"], "contexts": ["ingredient in fomentations", "herb for head wash"]}, {"entity_id": "salva", "book_id": "coloquios_da_orta_1563", "name": "salva", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["salva"], "contexts": ["plant with a similar taste"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Salva", "target_book": "coloquios_da_orta_1563", "target_name": "salva", "similarity": 0.961}], "id": 768, "stable_key": "clu_4f9937b90c9af231", "ground_truth": {"modern_name": "Sage", "confidence": "high", "type": "plant", "linnaean": "Salvia officinalis", "family": "Lamiaceae", "description": "Herb used in fomentations and for head washes, with a distinct taste.", "wikipedia_extract": "Salvia officinalis, common sage or sage, is a perennial, evergreen subshrub, with woody stems, grayish leaves, and blue to purplish flowers. It is a member of the mint family (Lamiaceae) and native to the Mediterranean region, though it has been naturalized in many places throughout the world. It has a long history of culinary use, and in modern times it has been used as an ornamental garden plant. The common name \"sage\" is also used for closely related species and cultivars. Cultivars are quite variable in size, leaf and flower color, and foliage pattern, with many variegated leaf types. The Old World type grows to approximately 60 cm (2 ft) tall and wide, with lavender flowers most common, though they can also be white, pink, or purple."}}, {"canonical_name": "trigo", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 18, "members": [{"entity_id": "trigo", "book_id": "polyanthea_medicinal", "name": "trigo", "category": "PLANT", "subcategory": "PLANT", "count": 11, "variants": ["trigo"], "contexts": ["ingredient in a preparation", "ingredient in a remedy"]}, {"entity_id": "trigo", "book_id": "coloquios_da_orta_1563", "name": "trigo", "category": "PLANT", "subcategory": "PLANT", "count": 5, "variants": ["trigo"], "contexts": ["commodity transported", "cultivated crop"]}, {"entity_id": "triguo", "book_id": "coloquios_da_orta_1563", "name": "triguo", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["triguo"], "contexts": ["grain used for weight comparison"]}, {"entity_id": "tritico", "book_id": "polyanthea_medicinal", "name": "Tritico", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Tritico"], "contexts": ["wheat"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "trigo", "target_book": "coloquios_da_orta_1563", "target_name": "trigo", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "triguo", "target_book": "polyanthea_medicinal", "target_name": "Tritico", "similarity": 0.864}], "id": 769, "stable_key": "clu_5d5c097138ead7ef", "ground_truth": {"modern_name": "Wheat", "confidence": "high", "type": "plant", "linnaean": "Triticum aestivum", "family": "Poaceae", "description": "Grain used in preparations, remedies, and for weight comparisons.", "note": "Includes 'triguo' and 'Tritico'.", "wikipedia_extract": "Common wheat (Triticum aestivum), also known as bread wheat, is a cultivated wheat species. About 95% of wheat produced worldwide is this species; it is the most widely planted of all crops by area (as of 2009) and the cereal with the highest monetary yield. Numerous forms of wheat have evolved under human selection. This diversity has led to confusion in the naming of wheats, with names based on both genetic and morphological characteristics. Bread wheat is an allohexaploid – a combination of six sets of chromosomes from different species. Of the six sets of chromosomes, four come from emmer (Triticum turgidum, itself a tetraploid) and two from Aegilops tauschii (a wild diploid goatgrass)."}}, {"canonical_name": "Scribonius Largius", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "scribonius_largius", "book_id": "polyanthea_medicinal", "name": "Scribonius Largius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 16, "variants": ["Scribonius Largius", "Escribonio Largio", "Scribon Larg", "Scribon. Larg.", "Scribonio Largio", "Scribonius Largus"], "contexts": ["ancient medical author", "ancient author"]}, {"entity_id": "scribonius_largus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Scribonius Largus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Scribonius Largus"], "contexts": ["Roman physician"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Scribonius Largius", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Scribonius Largus", "similarity": 0.895}], "id": 770, "stable_key": "clu_4add8f7d3c4ff8e6", "ground_truth": {"modern_name": "Scribonius Largus", "confidence": "high", "type": "person", "description": "Roman physician and medical writer of antiquity.", "wikidata_id": "Q461678", "wikidata_description": "Roman physician and writer", "wikipedia_url": "https://en.wikipedia.org/wiki/Scribonius_Largus", "wikipedia_extract": "Scribonius Largus Designatianus (c. 1 – c. 50) was the court physician to the Roman emperor Claudius. Around 47 AD, at the request of Gaius Julius Callistus, the emperor's freedman, he drew up a list of 271 prescriptions (Compositiones), most of them his own, although he acknowledged his indebtedness to his tutors, to friends, and to the writings of eminent physicians. Certain traditional remedies are also included. The work has no pretensions to style, and contains many colloquialisms, and has been cited by Peter Suber as a forerunner of Open Access."}}, {"canonical_name": "medicine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "medicine", "book_id": "ricettario_fiorentino_1597", "name": "medicine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 16, "variants": ["medicine", "MEDICINE", "Medicinale", "medicaménti"], "contexts": ["the art and practice of healing", "Medicines"]}, {"entity_id": "medicines_of_the_earth", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "medicines of the Earth", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["medicines of the Earth"], "contexts": ["natural remedies"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "medicine", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "medicines of the Earth", "similarity": 0.835}], "id": 771, "stable_key": "clu_4f955c4c0da35e59", "ground_truth": {"modern_name": "Medicine", "confidence": "high", "type": "concept", "note": "Refers to the practice of healing and remedies.", "wikidata_id": "Q12140", "wikidata_description": "substance used to diagnose, cure, treat, or prevent disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Substance_dependence", "wikipedia_extract": "Substance dependence, also known as drug dependence, is a biopsychological situation whereby an individual's functionality is dependent on the necessitated re-consumption of a psychoactive substance because of an adaptive state that has developed within the individual from psychoactive substance consumption that results in the experience of withdrawal and that necessitates the re-consumption of the drug. A drug addiction, a distinct concept from substance dependence, is defined as compulsive, out-of-control drug use, despite negative consequences. An addictive drug is a drug which is both rewarding and reinforcing. ΔFosB, a gene transcription factor, which is now known to be a critical component and common factor in the development of virtually all forms of behavioral and drug addictions, but not dependence. The International Classification of Diseases classifies substance dependence as a mental and behavioural disorder. In the Diagnostic and Statistical Manual of Mental Disorders (DSM-5) (released in 2013), substance abuse and substance dependence were eliminated and replaced with the single diagnosis of substance use disorders."}}, {"canonical_name": "caroços", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "caroços", "book_id": "polyanthea_medicinal", "name": "caroços", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 14, "variants": ["caroços", "caroços dos peytos", "caroçosdos peytos"], "contexts": ["lumps", "lumps on the neck"]}, {"entity_id": "carbúnculos", "book_id": "coloquios_da_orta_1563", "name": "carbúnculos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["carbúnculos"], "contexts": ["gemstones, mentioned by Pliny", "red or purple stones"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "caroços", "target_book": "coloquios_da_orta_1563", "target_name": "carbúnculos", "similarity": 0.848}], "id": 772, "stable_key": "clu_f3db1a6324d58945", "ground_truth": {"modern_name": "Lumps", "confidence": "high", "type": "disease", "description": "Abnormal swellings or growths on or under the skin.", "note": "While 'carbúnculos' can refer to gemstones, in a medicinal context, it refers to lumps or boils.", "wikipedia_extract": "Lyme disease, also known as Lyme borreliosis, is a tick-borne disease caused by species of Borrelia bacteria, transmitted by blood-feeding ticks in the genus Ixodes. It is the most common disease spread by ticks in the Northern Hemisphere. Infections are most common in the spring and early summer. Infection is treatable with antibiotics. Most treated patients experience a full recovery. For some patients recovery may not be immediate or complete, resulting in long-term effects."}}, {"canonical_name": "humores melancolicos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "humores_melancolicos", "book_id": "polyanthea_medicinal", "name": "humores melancolicos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 12, "variants": ["humores melancolicos"], "contexts": ["part of humoral theory", "body fluids associated with paralysis"]}, {"entity_id": "melancholly_humors", "book_id": "english_physician_1652", "name": "Melancholly humors", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["Melancholly humors", "Melanchollick Humors", "Melanchollick humor", "Melancholly Hu∣mors"], "contexts": ["humoral imbalance", "humor to be diminished"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "humores melancolicos", "target_book": "english_physician_1652", "target_name": "Melancholly humors", "similarity": 0.934}], "id": 773, "stable_key": "clu_2c5dad17fbab5525", "ground_truth": {"modern_name": "Melancholic Humors", "confidence": "high", "type": "concept", "description": "Body fluids associated with imbalance and melancholy in humoral theory.", "wikipedia_extract": "Humorism, the humoral theory, or humoralism, was a system of medicine detailing a supposed makeup and workings of the human body, adopted by Ancient Greek and Roman physicians and philosophers. Humorism began to fall out of favor in the 17th century and it was definitively disproved with the discovery of microbes. The concept of \"humors\" may have origins in Ancient Egyptian medicine, or Mesopotamia, though it was not systemized until ancient Greek thinkers. The word humor is a translation of Greek χυμός, chymos (literally 'juice' or 'sap', metaphorically 'flavor'). Early texts on Indian Ayurveda medicine presented a theory of three or four humors (doṣas), which they sometimes linked with the five elements (pañca-bhūta): earth, water, fire, air, and space. The concept of \"humors\" (chemical systems regulating human behaviour) became more prominent from the writing of medical theorist Alcmaeon of Croton (c. 540–500 BC)."}}, {"canonical_name": "Calcaire de transition", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "calcaire_de_transition", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Calcaire de transition", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 15, "variants": ["Calcaire de transition", "Schiste de transition", "calcaire de transition", "granités de transition", "roches de transition", "schiste de transition", "schistes de transition", "terrain de transition"], "contexts": ["type of rock", "type of limestone"]}, {"entity_id": "rocks_of_transition", "book_id": "kosmos_humboldt_1845", "name": "rocks of transition", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["rocks of transition"], "contexts": ["older term for Silurian and Devonian"]}, {"entity_id": "transition_limestone", "book_id": "kosmos_humboldt_1845", "name": "transition limestone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["transition limestone"], "contexts": ["geological formation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Calcaire de transition", "target_book": "kosmos_humboldt_1845", "target_name": "rocks of transition", "similarity": 0.874}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Calcaire de transition", "target_book": "kosmos_humboldt_1845", "target_name": "transition limestone", "similarity": 0.858}], "id": 774, "stable_key": "clu_b8c16b7be06ca2ab", "ground_truth": {"modern_name": "Transition limestone", "confidence": "medium", "type": "mineral", "note": "An older geological term likely referring to rocks of the Silurian and Devonian periods. 'Calcaire de transition' is French for transition limestone.", "wikipedia_extract": "The Midyat Limestone is located in the Midyat Group dominates the surface geology of the anticlinal structures of the Mardin High of southeastern Turkey. This Eocene aged light yellowish marly chalk was formed in a marine depositional environment near the continental shelf. Fossils such as echinoids and nummulites can be seen in the different sections of this limestone formation which can have a thickness between 300 and 400 meters. In the few areas that have exposed Cretaceous rocks, there is a transitional layer known as the Gercus, which separates the younger Eocene limestone. This transitional layer consists of  red sandy gypsum bearing beds interbedded with marl and limestone. Exposed areas of the older Cretaceous Germav Formation can be seen in small areas of the Mardin High.", "wikipedia_url": "https://en.wikipedia.org/wiki/Midyat_Limestone"}}, {"canonical_name": "Jura", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "jura", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Jura", "category": "PLACE", "subcategory": "REGION", "count": 15, "variants": ["Jura"], "contexts": ["location of primitive rocks", "geological period associated with limestone"]}, {"entity_id": "jura_formations", "book_id": "kosmos_humboldt_1845", "name": "Jura formations", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Jura formations"], "contexts": ["geological formations containing fossil fish", "geological formations"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Jura", "target_book": "kosmos_humboldt_1845", "target_name": "Jura formations", "similarity": 0.846}], "id": 775, "stable_key": "clu_2206a8ce36d6013e", "ground_truth": {"modern_name": "Jura Mountains", "confidence": "high", "type": "place", "country": "France, Switzerland, Germany", "note": "Contextually, 'Jura' refers to the geological period and formations, not just the mountains themselves, but the mountains are the eponymous origin.", "wikidata_id": "Q178611", "wikidata_description": "mountain chain in Switzerland and France", "wikipedia_extract": "Jura ( JOOR-ə; Scottish Gaelic: Diùra) is an island in the Inner Hebrides of Scotland, adjacent to and northeast of Islay. With an area of 36,692 hectares (142 sq mi), and 258 inhabitants recorded in the 2022 census, Jura is more sparsely populated than Islay, and is one of the least-densely populated islands of Scotland: in a list of the islands of Scotland ranked by size, Jura comes eighth, whereas by population it comes 29th. The island is mountainous, bare and largely infertile, covered by extensive areas of blanket bog. The main settlement is the east coast village of Craighouse, on the Sound of Jura. The Jura distillery, producing Isle of Jura single-malt whisky, is in the village, as is the island's rum-distillery, which opened in 2021. Craighouse also houses the island's shop, church, primary school, the Jura hotel and bar, a gallery, craft shop, tearoom and the community-run petrol-pumps.", "wikipedia_url": "https://en.wikipedia.org/wiki/Jura_Mountains"}}, {"canonical_name": "Titicaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "titicaca", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Titicaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 11, "variants": ["Titicaca", "Tilicaca"], "contexts": ["lake in South America", "lake in Peru"]}, {"entity_id": "lac_de_titicaca", "book_id": "relation_historique_humboldt_vol3_1825", "name": "lac de Titicaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["lac de Titicaca"], "contexts": ["lake name"]}, {"entity_id": "lac_alpin_de_titicaca", "book_id": "relation_historique_humboldt_vol3_1825", "name": "lac alpin de Titicaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["lac alpin de Titicaca"], "contexts": ["alpine lake"]}, {"entity_id": "titicaca", "book_id": "kosmos_humboldt_1845", "name": "titicaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["titicaca", "Titicaca"], "contexts": ["South American lake", "highlands where skulls were found"]}, {"entity_id": "lake_titicaca", "book_id": "kosmos_humboldt_1845", "name": "Lake Titicaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Lake Titicaca"], "contexts": ["lake near mountains measured by Pentland"]}, {"entity_id": "lake_of_titicaca", "book_id": "kosmos_humboldt_1845", "name": "Lake of Titicaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Lake of Titicaca"], "contexts": ["lake in Bolivia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Titicaca", "target_book": "kosmos_humboldt_1845", "target_name": "titicaca", "similarity": 0.972}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Titicaca", "target_book": "kosmos_humboldt_1845", "target_name": "Lake Titicaca", "similarity": 0.94}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Titicaca", "target_book": "kosmos_humboldt_1845", "target_name": "Lake of Titicaca", "similarity": 0.927}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "lac de Titicaca", "target_book": "kosmos_humboldt_1845", "target_name": "titicaca", "similarity": 0.913}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "lac de Titicaca", "target_book": "kosmos_humboldt_1845", "target_name": "Lake Titicaca", "similarity": 0.976}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "lac de Titicaca", "target_book": "kosmos_humboldt_1845", "target_name": "Lake of Titicaca", "similarity": 0.984}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "lac alpin de Titicaca", "target_book": "kosmos_humboldt_1845", "target_name": "titicaca", "similarity": 0.869}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "lac alpin de Titicaca", "target_book": "kosmos_humboldt_1845", "target_name": "Lake Titicaca", "similarity": 0.925}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "lac alpin de Titicaca", "target_book": "kosmos_humboldt_1845", "target_name": "Lake of Titicaca", "similarity": 0.934}], "id": 776, "stable_key": "clu_667b0a6e2857210a", "ground_truth": {"modern_name": "Lake Titicaca", "confidence": "high", "type": "place", "country": "Peru, Bolivia", "wikidata_id": "Q1628083", "wikidata_description": "species of amphibian", "wikipedia_extract": "Waru Waru is a type of raised field agriculture developed by pre-Hispanic people in the Andes region of South America from Ecuador to Bolivia. This regional agricultural technique is also referred to as camellones in Spanish. Functionally similar agricultural techniques have been developed in other parts of the world. This type of altiplano field agriculture consists of parallel canals alternated by raised planting beds, which would be strategically located on floodplains or near a water source so that the fields could be properly irrigated. These flooded fields were composed of soil that was rich in nutrients due to the presence of aquatic plants and other organic materials. Through the process of mounding up this soil to create planting beds, natural, recyclable fertilizer was made available in a region where nitrogen-rich soils were rare.", "wikipedia_url": "https://en.wikipedia.org/wiki/Waru_Waru"}}, {"canonical_name": "salses", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "salses", "book_id": "kosmos_humboldt_1845", "name": "salses", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 13, "variants": ["salses", "Salses"], "contexts": ["mud volcanoes or saline springs", "mud volcanoes"]}, {"entity_id": "salses", "book_id": "relation_historique_humboldt_vol3_1825", "name": "salses", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 4, "variants": ["Salses", "salses"], "contexts": ["phenomenon observed in the forest", "phenomenon observed by the author"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "salses", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "salses", "similarity": 1.0}], "id": 777, "stable_key": "clu_01e47070bcbbf972", "ground_truth": {"modern_name": "Salses", "confidence": "high", "type": "place", "country": "Trinidad and Tobago, Venezuela, etc.", "note": "Refers to mud volcanoes or saline springs, often associated with geological activity.", "wikidata_id": "Q193457", "wikidata_description": "landform created by the eruption of mud or slurries, water and gases", "wikipedia_extract": "The Fronde (French pronunciation: [fʁɔ̃d] ) was a series of civil wars in the Kingdom of France between 1648 and 1653, occurring in the midst of the Franco-Spanish War, which had begun in 1635. The government of the young King Louis XIV confronted the combined opposition of the princes, the nobility, the noble regional court assemblies (parlements), as well as much of the French population, and managed to subdue them all. The dispute started when the government of France issued seven fiscal edicts, six of which were to increase taxation. The parlements resisted, questioned the constitutionality of the king's actions, and sought to check his powers. The Fronde was divided into two campaigns, the Parlementary Fronde and the Fronde of the Princes. The timing of the outbreak of the Parlementary Fronde, directly after the Peace of Westphalia (1648) that ended the Thirty Years' War, was significant.", "wikipedia_url": "https://en.wikipedia.org/wiki/The_Fronde"}}, {"canonical_name": "Relation historique", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "relation_historique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Relation historique", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 12, "variants": ["Relation historique", "Relation historiijuc", "Relation historique, Tom. III"], "contexts": ["title of a historical relation", "title of a work"]}, {"entity_id": "relaciones", "book_id": "coloquios_da_orta_1563", "name": "Relaciones", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 5, "variants": ["relaciones", "Relaciones"], "contexts": ["book by Pedro Teixeira", "accounts used for navigation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Relation historique", "target_book": "coloquios_da_orta_1563", "target_name": "Relaciones", "similarity": 0.868}], "id": 778, "stable_key": "clu_2c265be7411a9fb1", "ground_truth": {"modern_name": "Historical Accounts", "confidence": "high", "type": "object", "description": "Titles of historical narratives or written records.", "note": "'Relation historique' and 'Relaciones' both refer to types of written accounts.", "wikipedia_extract": "Recorded history or written history describes the historical events that have been recorded in a written form or other documented communication which are subsequently evaluated by historians using the historical method. For broader world history, recorded history begins with the accounts of the ancient world around the 4th millennium BCE, and it coincides with the invention of writing. For some geographic regions or cultures, written history is limited to a relatively recent period in human history because of the limited use of written records. Moreover, human cultures do not always record all of the information which is considered relevant by later historians, such as the full impact of natural disasters or the names of individuals. Recorded history for particular types of information is therefore limited based on the types of records kept. Because of this, recorded history in different contexts may refer to different periods of time depending on the topic."}}, {"canonical_name": "gallica", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "gallica", "book_id": "polyanthea_medicinal", "name": "gallica", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 14, "variants": ["gallica", "Gallica"], "contexts": ["a type of illness or condition", "a condition, possibly related to French disease"]}, {"entity_id": "gallois", "book_id": "relation_historique_humboldt_vol3_1825", "name": "gallois", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["gallois"], "contexts": ["language spoken by a tribe", "language of Wales"]}, {"entity_id": "gale-irlandois", "book_id": "relation_historique_humboldt_vol3_1825", "name": "gale-irlandois", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["gale-irlandois"], "contexts": ["Welsh-Irish language"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "gallica", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "gallois", "similarity": 0.913}, {"source_book": "polyanthea_medicinal", "source_name": "gallica", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "gale-irlandois", "similarity": 0.858}], "id": 779, "stable_key": "clu_ce887bc923cdc078", "ground_truth": {"modern_name": "French Disease", "confidence": "low", "type": "disease", "description": "A historical term for syphilis, possibly related to French origins.", "note": "'Gallica' (French), 'gallois' (Welsh), and 'gale-irlandois' (Gaelic-Irish) appear in contexts that are not consistently about disease. However, 'gallica' in a medicinal context strongly suggests the French disease (syphilis).", "wikipedia_extract": "The Bibliothèque nationale de France (French: [biblijɔtɛk nɑsjɔnal də fʁɑ̃s]; BnF) is the national library of France, located in Paris on two main sites, Richelieu and François-Mitterrand. It is the national repository of all that is published in France. Some of its extensive collections, including books and manuscripts but also precious objects and artworks, are on display at the BnF Museum (formerly known as the Cabinet des Médailles) on the Richelieu site. The National Library of France is a public establishment under the supervision of the Ministry of Culture. Its mission is to constitute collections, especially the copies of works published in France that must, by law, be deposited there, conserve them, and make them available to the public. It produces a reference catalogue, cooperates with other national and international establishments, as well as participates in research programs."}}, {"canonical_name": "excrementos", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "excrementos", "book_id": "polyanthea_medicinal", "name": "excrementos", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 16, "variants": ["excrementos", "excrementos eſtercorofos"], "contexts": ["waste products, removed by the body", "excrements"]}, {"entity_id": "escrupulos", "book_id": "historia_medicinal_monardes_1574", "name": "escrupulos", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["escrupulos"], "contexts": ["unit of weight"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "excrementos", "target_book": "historia_medicinal_monardes_1574", "target_name": "escrupulos", "similarity": 0.86}], "id": 780, "stable_key": "clu_ac331214f2da053d", "ground_truth": {"modern_name": "Excrement", "confidence": "high", "type": "substance", "description": "Waste products produced and discharged by the body.", "note": "'Escrupulos' is a unit of weight, but 'excrementos' is clearly about bodily waste.", "wikipedia_extract": "Feces (also faeces or fæces) are the solid or semi-solid remains of food that was not digested in the small intestine, and has been broken down by bacteria in the large intestine. Feces contain a relatively small amount of metabolic waste products such as bacterially-altered bilirubin and dead epithelial cells from the lining of the gut. Feces are discharged through the anus or cloaca during defecation. Feces can be used as fertilizer or soil conditioner in agriculture. They can also be burned as fuel or dried and used for construction. Some medicinal uses have been found."}}, {"canonical_name": "nutation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "nutation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "nutation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 15, "variants": ["nutation", "Nutation"], "contexts": ["wobble in orbital axis", "slight irregularity in Earth's precession"]}, {"entity_id": "nutation", "book_id": "first_principles_spencer_1862", "name": "nutation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["nutation"], "contexts": ["wobble in Earth's axial tilt", "wobbling motion of Earth's axis"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "nutation", "target_book": "first_principles_spencer_1862", "target_name": "nutation", "similarity": 1.0}], "id": 781, "stable_key": "clu_1ffde4b8d93348d4", "ground_truth": {"modern_name": "Nutation", "confidence": "high", "type": "concept", "note": "The 'wobble in Earth's axial tilt' is a specific astronomical phenomenon.", "wikidata_id": "Q190009", "wikidata_description": "type of motion in astronomy. A component of the rotating motion of a planet under the influence of gravitational pull by moons, other planets or the central star", "wikipedia_url": "https://en.wikipedia.org/wiki/Astronomical_nutation", "wikipedia_extract": "Honda has produced the following cars, SUVs, and light trucks. During the late 1980s and early 1990s, Honda collaborated with Rover in the development and marketing of the Honda Concerto, Rover 200, 400, 600 and 800. The 800 was called the Sterling in the US. Honda partnered with Isuzu in the 1990s to produce the Passport and the Acura SLX."}}, {"canonical_name": "Bismuth", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "bismuth", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bismuth", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 16, "variants": ["bismuth", "Bismuth"], "contexts": ["metal in fusible alloy", "metal in heterogeneous circuit"]}, {"entity_id": "bitumido", "book_id": "polyanthea_medicinal", "name": "bitumido", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["bitumido"], "contexts": ["bituminous substances"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Bismuth", "target_book": "polyanthea_medicinal", "target_name": "bitumido", "similarity": 0.889}], "id": 782, "stable_key": "clu_f91c90062cc9977b", "ground_truth": {"modern_name": "Bismuth", "confidence": "high", "type": "mineral", "note": "The term 'bitumido' is likely a misspelling or variation of 'bismuth' or 'bitumen', but given the context of other entries, 'bismuth' is the more probable intended referent in the medical/chemical sense, especially in conjunction with alloys. The presence of 'bituminous substances' suggests a secondary, less certain meaning, but the strong presence of 'Bismuth' points to the metal.", "wikidata_id": "Q942", "wikidata_description": "chemical element with symbol Bi and atomic number 83", "wikipedia_url": "https://en.wikipedia.org/wiki/Bismuth"}}, {"canonical_name": "mar Vermelho", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "mar_vermelho", "book_id": "coloquios_da_orta_1563", "name": "mar Vermelho", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 15, "variants": ["mar Vermelho", "Mar Vermelho"], "contexts": ["sea route", "sea route for contact"]}, {"entity_id": "mare_rubrum", "book_id": "polyanthea_medicinal", "name": "Mare Rubrum", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Mare Rubrum"], "contexts": ["fit Mare Rubrum"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "mar Vermelho", "target_book": "polyanthea_medicinal", "target_name": "Mare Rubrum", "similarity": 0.871}], "id": 783, "stable_key": "clu_697eb0305b19cb47", "ground_truth": {"modern_name": "Red Sea", "confidence": "high", "type": "place", "description": "A sea route connecting East and West.", "wikipedia_extract": "The Red Sea is a sea inlet of the Indian Ocean, lying between Africa and Asia. Its connection to the ocean is in the south, through the Bab-el-Mandeb Strait and the Gulf of Aden. To the north of the Red Sea lies the Sinai Peninsula, the Gulf of Aqaba, and the Gulf of Suez, which leads to the Suez Canal. It is underlain by the Red Sea Rift, which is part of the Great Rift Valley. The Red Sea has a surface area of roughly 438,000 km2 (169,000 sq mi), is about 2,250 km (1,400 mi) long, and 355 km (221 mi) across at its widest point. It has an average depth of 490 m (1,610 ft), and in the central Suakin Trough, it reaches its maximum depth of 2,730 m (8,960 ft)."}}, {"canonical_name": "Chiquitos", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "chiquitos", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Chiquitos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 15, "variants": ["Chiquitos", "Chisquio", "Chucuito"], "contexts": ["American nation", "Spanish provinces"]}, {"entity_id": "chichimequillo", "book_id": "kosmos_humboldt_1845", "name": "Chichimequillo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Chichimequillo"], "contexts": ["location northwest of Guanaxuata"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Chiquitos", "target_book": "kosmos_humboldt_1845", "target_name": "Chichimequillo", "similarity": 0.856}], "id": 784, "stable_key": "clu_952099c9867723bc", "ground_truth": {"modern_name": "Chiquitos", "confidence": "high", "type": "place", "country": "Bolivia", "note": "Chiquitos refers to an indigenous people and a region in eastern Bolivia, often associated with historical missions and natural history observations.", "wikidata_id": "Q1074668", "wikidata_description": "region of tropical savannas in Eastern Bolivia.", "wikipedia_url": "https://en.wikipedia.org/wiki/Upper_Peru", "wikipedia_extract": "Upper Peru (Spanish: Alto Perú; Portuguese: Alto Peru) is a name for the land that was governed by the Real Audiencia of Charcas. The name originated in Buenos Aires towards the end of the 18th century after the Audiencia of Charcas was transferred from the Viceroyalty of Peru to the Viceroyalty of the Río de la Plata in 1776. It comprised the governorships of Potosí, La Paz, Cochabamba, Chiquitos, Moxos and Charcas (since renamed Sucre). Following the Bolivian War of Independence, the region became an independent country and was renamed Bolivia in honor of Simón Bolívar. By 1821, the Spanish colonial empire in Latin America was falling apart because of the Napoleonic occupation of Spain, and the troops of generals Bolívar and Sucre, who had already liberated Venezuela, Colombia and Ecuador, were already approaching the Upper Peru region. Following the defeat of Spanish Royalist forces at the Battle of Ayacucho in December 1824 and the effect collapse of Spanish power in Upper Peru, province governors scrambled in the ensuing power vacuum."}}, {"canonical_name": "fuores frios", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "fuores_frios", "book_id": "polyanthea_medicinal", "name": "fuores frios", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 12, "variants": ["fuores frios", "fudores frios", "suor frio", "suores frios", "ſuores frios"], "contexts": ["cold sweats", "symptom of cold sweats"]}, {"entity_id": "dolores_frios", "book_id": "historia_medicinal_monardes_1574", "name": "dolores frios", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 3, "variants": ["dolores frios", "dolor de frio", "dolores frios y ventosos"], "contexts": ["cold pains treated by the water", "pain caused by cold"]}, {"entity_id": "sudor_frio", "book_id": "historia_medicinal_monardes_1574", "name": "sudor frio", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["sudor frio"], "contexts": ["cold sweat all over the body"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "fuores frios", "target_book": "historia_medicinal_monardes_1574", "target_name": "dolores frios", "similarity": 0.844}, {"source_book": "polyanthea_medicinal", "source_name": "fuores frios", "target_book": "historia_medicinal_monardes_1574", "target_name": "sudor frio", "similarity": 0.847}], "id": 785, "stable_key": "clu_4b96e670a36ee798", "ground_truth": {"modern_name": "Cold sweats", "confidence": "high", "type": "disease", "description": "A symptom characterized by cold, clammy perspiration, often associated with illness.", "note": "This cluster includes terms referring to cold pains and cold sweats in Spanish and English.", "wikipedia_extract": "Sweating sickness, also known as the sweats, English sweating sickness, English sweat or sudor anglicus in Latin, was a mysterious and contagious disease that struck England and later continental Europe in a series of epidemics beginning in 1485. Other major outbreaks of the English sweating sickness occurred in 1508, 1517, and 1528, with the last outbreak in 1551, after which the disease apparently vanished. The onset of symptoms was sudden, and death or recovery often occurred within 8–10 hours. Sweating sickness epidemics were unique compared with other disease outbreaks of the time: whereas other epidemics were typically urban and long-lasting, cases of sweating sickness spiked and receded very quickly, significantly affecting rural populations. Its cause remains unknown, although it has been suggested that an unknown species of hantavirus was responsible. John Caius was a physician in Shrewsbury in 1551, when an outbreak occurred, and he described the symptoms and signs of the disease in A Boke or Counseill Against the Disease Commonly Called the Sweate, or Sweatyng Sicknesse (1552), which is the main historical source of knowledge of the disease."}}, {"canonical_name": "tormentilla", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "tormentilla", "book_id": "polyanthea_medicinal", "name": "tormentilla", "category": "PLANT", "subcategory": "PLANT", "count": 12, "variants": ["tormentilla", "Tormentila", "tormen"], "contexts": ["used in ointment", "tormentil used in unguent"]}, {"entity_id": "tormentil", "book_id": "english_physician_1652", "name": "Tormentil", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Tormentil"], "contexts": ["plant with reddish branches and yellow flowers", "herb with medicinal properties"]}, {"entity_id": "naiz_de_tormentilla", "book_id": "polyanthea_medicinal", "name": "naiz de tormentilla", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["naiz de tormentilla"], "contexts": ["tormentil root, used in remedies"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "tormentilla", "target_book": "english_physician_1652", "target_name": "Tormentil", "similarity": 0.946}, {"source_book": "english_physician_1652", "source_name": "Tormentil", "target_book": "polyanthea_medicinal", "target_name": "naiz de tormentilla", "similarity": 0.85}], "id": 786, "stable_key": "clu_e279a63e24e7c7fa", "ground_truth": {"modern_name": "Tormentil", "confidence": "high", "type": "plant", "linnaean": "Potentilla erecta", "family": "Rosaceae", "description": "A herbaceous perennial plant with medicinal properties, used in ointments.", "note": "Includes variations in Spanish and English.", "wikipedia_extract": "Potentilla erecta (syn. Tormentilla erecta, Potentilla laeta, Potentilla tormentilla, known as the (common) tormentil, septfoil or erect cinquefoil ) is a herbaceous perennial plant belonging to the rose family (Rosaceae). Potentilla erecta is a low, clump-forming plant with slender, procumbent to arcuately upright stalks, growing 10–30 centimetres (3.9–11.8 in) tall and with non-rooting runners. It grows wild predominantly in Europe and western Asia[1], mostly on acid soils and in a wide variety of habitats such as mountains, heaths, meadows, sandy soils and dunes. This plant flowers from May to August/September. There is one yellow, 7–11 millimetres (0.28–0.43 in) wide flower, growing at the tip of a long stalk."}}, {"canonical_name": "infusao", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "infusao", "book_id": "polyanthea_medicinal", "name": "infusao", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 15, "variants": ["infusao", "infufaō", "infusaó", "infusion", "infusão", "infutaó", "infuſaõ"], "contexts": ["method of preparing medicine", "method for preparing liquids"]}, {"entity_id": "infusion", "book_id": "english_physician_1652", "name": "Infusion", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Infusion"], "contexts": ["method of making syrups"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "infusao", "target_book": "english_physician_1652", "target_name": "Infusion", "similarity": 0.874}], "id": 787, "stable_key": "clu_4c2a3c9cdd27bb13", "ground_truth": {"modern_name": "Infusion", "confidence": "high", "type": "concept", "description": "A method of preparing liquid medicines by steeping ingredients.", "note": "Includes Italian and English terms for the same medicinal practice.", "wikipedia_extract": "Infusion is the process of extracting chemical compounds or flavors from plant material in a solvent such as water, oil, or alcohol, by allowing the material to remain suspended in the solvent over time (a process often called steeping). An infusion is also the name for the resultant liquid. The process of infusion is distinct from both decoction—a method of extraction involving boiling the plant material—and percolation, in which water is passed through the material (as in a coffeemaker). The first recorded use of essential oils was in the 10th or 11th century by the Persian polymath Avicenna, possibly in The Canon of Medicine. Tea is far older than this, dating back to the 10th century BC as the earliest recorded reference. Infusion is a chemical process that uses botanicals (typically dried herbs, flowers or berries) that are volatile and release their active ingredients readily in water, oil, or alcohol."}}, {"canonical_name": "Dyſuria", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "dyſuria", "book_id": "polyanthea_medicinal", "name": "Dyſuria", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 15, "variants": ["Dyſuria", "Dysuria"], "contexts": ["difficulty urinating", "difficulty or pain in urination"]}, {"entity_id": "disury", "book_id": "english_physician_1652", "name": "Disury", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["Disury"], "contexts": ["painful or difficult urination"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Dyſuria", "target_book": "english_physician_1652", "target_name": "Disury", "similarity": 0.857}], "id": 788, "stable_key": "clu_248fa30dfd34dc85", "ground_truth": {"modern_name": "Dysuria", "confidence": "high", "type": "disease", "description": "Difficulty or pain experienced during urination.", "note": "Includes variations in spelling and Latinization.", "wikipedia_extract": "Dysuria refers to painful or uncomfortable urination. It is one of a constellation of irritative bladder symptoms (also sometimes referred to as lower urinary tract symptoms), which includes nocturia and urinary frequency. The clinician should also look for physical findings of fever, rash, direct tenderness over the bladder area, and joint pain. Physical findings of increased temperature, increased pulse, low blood pressure in the presence of dysuria can indicate systemic infection. Urological obstruction due to stone or tumor can result in findings of hematuria, decreased urination, and bladder spasms. All these physical findings should be looked for carefully while obtaining history."}}, {"canonical_name": "Santa Marta", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "santa_marta", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Santa Marta", "category": "PLACE", "subcategory": "CITY", "count": 15, "variants": ["Santa Marta", "San Mateo"], "contexts": ["city with population 62,000", "city in Colombia"]}, {"entity_id": "santa_marta", "book_id": "kosmos_humboldt_1845", "name": "Santa Marta", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Santa Marta"], "contexts": ["location of subterranean thunder"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Santa Marta", "target_book": "kosmos_humboldt_1845", "target_name": "Santa Marta", "similarity": 1.0}], "id": 789, "stable_key": "clu_53a307ca784da248", "ground_truth": {"modern_name": "Santa Marta", "confidence": "high", "type": "place", "country": "Colombia", "wikidata_id": "Q1629459", "wikidata_description": "municipality in the province of Badajoz, Spain", "wikipedia_url": "https://en.wikipedia.org/wiki/Santa_Marta%2C_Extremadura"}}, {"canonical_name": "Callao", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "callao", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Callao", "category": "PLACE", "subcategory": "CITY", "count": 15, "variants": ["Callao", "Callao de Lima"], "contexts": ["port city near Lima", "port with hourly variations"]}, {"entity_id": "callao", "book_id": "kosmos_humboldt_1845", "name": "Callao", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Callao"], "contexts": ["port city experiencing earthquake"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Callao", "target_book": "kosmos_humboldt_1845", "target_name": "Callao", "similarity": 1.0}], "id": 790, "stable_key": "clu_cee5743ebc5c4122", "ground_truth": {"modern_name": "Callao", "confidence": "high", "type": "place", "country": "Peru", "wikidata_id": "Q105037", "wikidata_description": "city ​​and main seaport of Peru", "wikipedia_url": "https://en.wikipedia.org/wiki/Callao"}}, {"canonical_name": "Macao", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "macao", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Macao", "category": "PLACE", "subcategory": "CITY", "count": 14, "variants": ["Macao"], "contexts": ["city near the limit of the torrid zone", "location of observations in 1814"]}, {"entity_id": "macao", "book_id": "kosmos_humboldt_1845", "name": "Macao", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Macao"], "contexts": ["village near Rio Assu", "destination of voyage"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Macao", "target_book": "kosmos_humboldt_1845", "target_name": "Macao", "similarity": 1.0}], "id": 791, "stable_key": "clu_55500a350f6f618c", "ground_truth": {"modern_name": "Macao", "confidence": "high", "type": "place", "country": "China", "note": "The text mentions 'village near Rio Assu', which might be a different location or a less precise geographical reference, but the primary and overwhelming context for Macao points to the famous Portuguese settlement.", "wikidata_id": "Q14773", "wikidata_description": "city and special administrative region of China", "wikipedia_extract": "The Guangdong–Hong Kong–Macao Greater Bay Area, commonly referred to as the Greater Bay Area (GBA), is a megalopolis, consisting of nine cities and two special administrative regions in South China. It is envisioned by Chinese government planners as an integrated economic area aimed at taking a leading role globally by 2035. It is the largest and most populated urban area in the world. The GBA—with a total population of approximately 86 million people—includes nine mega cities of Guangdong province: Guangzhou, Shenzhen, Zhuhai, Foshan, Dongguan, Zhongshan, Jiangmen, Huizhou, and Zhaoqing as well as two special administrative regions, Hong Kong, and Macao (Macau). Hong Kong, Guangzhou, and Shenzhen have been described among the world's 50 \"superstar cities\". Surrounding the Pearl River Delta with a total area of 56,000 km2 (comparable in size to Croatia), it is the largest and the richest economic region in South China.", "wikipedia_url": "https://en.wikipedia.org/wiki/Macau"}}, {"canonical_name": "Tyrol", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "tyrol", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tyrol", "category": "PLACE", "subcategory": "REGION", "count": 11, "variants": ["Tyrol", "Tyrol méridional"], "contexts": ["region with schists", "region"]}, {"entity_id": "tyrol", "book_id": "kosmos_humboldt_1845", "name": "Tyrol", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Tyrol"], "contexts": ["region of Cascade of Conzocoli", "region with dolomite masses"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tyrol", "target_book": "kosmos_humboldt_1845", "target_name": "Tyrol", "similarity": 1.0}], "id": 792, "stable_key": "clu_eb4fdd70ec3208f2", "ground_truth": {"modern_name": "Tyrol", "confidence": "high", "type": "place", "country": "Austria", "wikidata_id": "Q37456360", "wikidata_description": "family name", "wikipedia_extract": "The Tyrol–South Tyrol–Trentino Euroregion (German: Europaregion Tirol-Südtirol-Trentino; Italian: Euregio Tirolo-Alto Adige-Trentino) is a Euroregion formed by three different regional authorities in Austria and Italy: the Austrian state of Tyrol (i.e. North and East Tyrol) and the Italian autonomous provinces of South Tyrol and Trentino. The boundaries of the association correspond to the former Princely County of Tyrol, a crown land of the Habsburg monarchy (including the former Prince-bishoprics of Trent and Brixen) which for centuries shaped life in the Alpine region. Excluded from the association due to a change of the province by the fascists, are Cortina, Livinallongo, Colle Santa Lucia, Pedemonte, Valvestino and Magasa, but they have voted in 2007/2008 to revert to the provinces of South Tyrol/Trentino, which has not yet been approved by the Italian legislature in Rome. Divided after World War I, the region retained much of its cultural integrity by its traditionally strong attachment to the land and a profound desire for self-government on both sides of the border. The long-standing cultural, social and economic ties, as much as the recognition of convergent interests based on its traditional role as transit country and its largely identical environmental conditions in the Eastern Alps, led to the creation of the Euroregion by the three provinces in 1998.", "wikipedia_url": "https://en.wikipedia.org/wiki/Tyrol–South_Tyrol–Trentino_Euroregion"}}, {"canonical_name": "Nouveau-Mexique", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "nouveau-mexique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Nouveau-Mexique", "category": "PLACE", "subcategory": "REGION", "count": 14, "variants": ["Nouveau-Mexique"], "contexts": ["location with savannas", "region in North America"]}, {"entity_id": "new_mexico", "book_id": "connexion_physical_sciences_somerville_1858", "name": "New Mexico", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["New Mexico"], "contexts": ["US state with deserts", "region where monsoons are occasioned"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Nouveau-Mexique", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "New Mexico", "similarity": 0.937}], "id": 793, "stable_key": "clu_71b1ac236439ccf8", "ground_truth": {"modern_name": "New Mexico", "confidence": "high", "type": "place", "country": "United States", "wikidata_id": "Q7010253", "wikidata_description": "historic place register operated by the state government of New Mexico"}}, {"canonical_name": "capeluenere", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "capeluenere", "book_id": "ricettario_fiorentino_1597", "name": "capeluenere", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 12, "variants": ["capeluenere", "Cap^^lucncrc", "Capcluenerc", "Capduenere", "CapeJuenere", "Capeiuenerc", "Capelaenèrc", "Capelucnerc", "Capelucnere", "Capeluenere", "captlnenere"], "contexts": ["maidenhair, an ingredient in a syrup", "herb used in preparations"]}, {"entity_id": "cupuliferae", "book_id": "kosmos_humboldt_1845", "name": "Cupuliferae", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Cupuliferae"], "contexts": ["plant family associated with Coniferae", "abundant in middle tertiary period"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "capeluenere", "target_book": "kosmos_humboldt_1845", "target_name": "Cupuliferae", "similarity": 0.846}], "id": 794, "stable_key": "clu_18ad7da0d0123c2b", "ground_truth": {"modern_name": "Maidenhair fern", "confidence": "high", "type": "plant", "linnaean": "Adiantum capillus-veneris Linnaeus", "family": "Pteridaceae", "note": "The term 'capeluenere' strongly suggests 'capillus-veneris' (hair of Venus), a common epithet for maidenhair fern. 'Cupuliferae' is a botanical family (now Fagaceae) and seems to be a mistaken association or secondary usage in the context of the primary term.", "wikidata_id": "Q4678994", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Adiantum%20capillus-veneris", "wikipedia_extract": "Adiantum (), the maidenhair fern (not to be confused with the similar-looking maidenhair spleenwort fern), is a genus of about 250 species of ferns in the subfamily Vittarioideae of the family Pteridaceae, though some researchers place it in its own family, Adiantaceae. The genus name comes from Greek, meaning \"unwetted\", referring to the fronds' ability to shed water without becoming wet. They are distinctive in appearance, with dark, often black stipes and rachises, and bright green, often delicately cut leaf tissue. The sori are borne submarginally, and are covered by reflexed flaps of leaf tissue which resemble indusia. Dimorphism between sterile and fertile fronds is generally subtle. They generally prefer humus-rich, moist, well-drained sites, ranging from bottomland soils to vertical rock walls."}}, {"canonical_name": "Jejum", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "jejum", "book_id": "polyanthea_medicinal", "name": "Jejum", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 15, "variants": ["Jejum", "jejum", "jejummeyo", "jejúm"], "contexts": ["abstaining from food", "fasting, can cause headache"]}, {"entity_id": "jejuum", "book_id": "coloquios_da_orta_1563", "name": "jejuum", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["jejuum"], "contexts": ["taking medicine on an empty stomach"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Jejum", "target_book": "coloquios_da_orta_1563", "target_name": "jejuum", "similarity": 0.921}], "id": 795, "stable_key": "clu_0a91d481f8883186", "ground_truth": {"modern_name": "Fasting", "confidence": "high", "type": "concept", "description": "Abstaining from food, sometimes for medical reasons.", "wikipedia_extract": "Fasting is the act of refraining from eating, and sometimes drinking. However, from a purely physiological context, \"fasting\" may refer to the metabolic status of a person who has not eaten overnight (before \"breakfast\"), or to the metabolic state achieved after complete digestion and absorption of a meal. Metabolic changes in the fasting state begin after absorption of a meal (typically 3–5 hours after eating). A diagnostic fast is a prolonged fast, from 1–100 hours long (depending on age), conducted under observation, to facilitate the investigation of a health complication (usually hypoglycemia). Many people may also fast as part of a medical procedure or a check-up, such as preceding a colonoscopy or surgery, or before certain medical tests. Intermittent fasting is a technique sometimes used for weight loss or other health benefits that incorporates regular fasting into a person's dietary schedule."}}, {"canonical_name": "oxidation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "oxidation", "book_id": "first_principles_spencer_1862", "name": "oxidation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["oxidation"], "contexts": ["process of animal life", "process where absorbed nutriment gives out force"]}, {"entity_id": "oxidation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Oxidation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["oxidation", "Oxidation"], "contexts": ["chemical process of reacting with oxygen", "chemical reaction with oxygen"]}, {"entity_id": "oxydizing_effect", "book_id": "connexion_physical_sciences_somerville_1858", "name": "oxydizing effect", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["oxydizing effect"], "contexts": ["chemical action of light", "process of oxidation"]}, {"entity_id": "oxydizing_action", "book_id": "connexion_physical_sciences_somerville_1858", "name": "oxydizing action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["oxydizing action"], "contexts": ["chemical action beyond visible rays"]}, {"entity_id": "oxydating_action", "book_id": "connexion_physical_sciences_somerville_1858", "name": "oxydating action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["oxydating action"], "contexts": ["chemical process of oxidation"]}, {"entity_id": "deoxidation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "deoxidation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["deoxidation"], "contexts": ["removal of oxygen"]}, {"entity_id": "de-oxidation", "book_id": "first_principles_spencer_1862", "name": "de-oxidation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["de-oxidation"], "contexts": ["process of vegetal life"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "oxidation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Oxidation", "similarity": 0.928}, {"source_book": "first_principles_spencer_1862", "source_name": "oxidation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "oxydizing effect", "similarity": 0.883}, {"source_book": "first_principles_spencer_1862", "source_name": "oxidation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "oxydizing action", "similarity": 0.867}, {"source_book": "first_principles_spencer_1862", "source_name": "oxidation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "oxydating action", "similarity": 0.87}, {"source_book": "first_principles_spencer_1862", "source_name": "oxidation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "deoxidation", "similarity": 0.891}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Oxidation", "target_book": "first_principles_spencer_1862", "target_name": "de-oxidation", "similarity": 0.88}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "deoxidation", "target_book": "first_principles_spencer_1862", "target_name": "de-oxidation", "similarity": 0.99}], "id": 796, "stable_key": "clu_464e33f91df58487", "ground_truth": {"modern_name": "Oxidation", "confidence": "high", "type": "concept", "wikidata_id": "Q484152", "wikidata_description": "number that describes degree of oxidation of an atom in a chemical compound; the hypothetical charge that an atom would have if all bonds to atoms of different elements were fully ionic", "wikipedia_url": "https://en.wikipedia.org/wiki/Oxidation_state", "wikipedia_extract": "In chemistry, the oxidation state, or oxidation number, is the hypothetical charge of an atom if all of its bonds to other atoms are fully ionic. It describes the degree of oxidation (loss of electrons) of an atom in a chemical compound. Conceptually, the oxidation state may be positive, negative or zero. Beside nearly-pure ionic bonding, many covalent bonds exhibit a strong ionicity, making oxidation state a useful predictor of charge. The oxidation state of an atom does not represent the \"real\" charge on that atom, or any other actual atomic property. This is particularly true of high oxidation states, where the ionization energy required to produce a multiply positive ion is far greater than the energies available in chemical reactions."}}, {"canonical_name": "lagartos", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "lagartos", "book_id": "polyanthea_medicinal", "name": "lagartos", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 12, "variants": ["lagartos", "Lagartixa", "Lagarto", "lagartixa", "lagarto"], "contexts": ["lizards", "Animals that fast"]}, {"entity_id": "lagarto", "book_id": "historia_medicinal_monardes_1574", "name": "Lagarto", "category": "ANIMAL", "subcategory": "REPTILE", "count": 3, "variants": ["Lagarto", "Lagartos"], "contexts": ["lizard, used for comparison of tail", "lizard, referring to Cayman"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "lagartos", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lagarto", "similarity": 0.858}], "id": 797, "stable_key": "clu_38e92d2105bb46ef", "ground_truth": {"modern_name": "lizards", "confidence": "high", "type": "animal", "description": "Reptiles, including references to the Cayman.", "note": "Spanish term for lizards.", "wikipedia_extract": "Lizard is the common name used for all squamate reptiles other than snakes (and to a lesser extent amphisbaenians), encompassing over 7,000 species, ranging across all continents except Antarctica, as well as most oceanic island chains. The grouping is paraphyletic as some lizards are more closely related to snakes than they are to other lizards. Lizards range in size from chameleons and geckos a few centimeters long to the 3-meter-long Komodo dragon. Most lizards are quadrupedal, running with a strong side-to-side motion. Some lineages (known as \"legless lizards\") have secondarily lost their legs, and have long snake-like bodies. Some lizards, such as the forest-dwelling Draco, are able to glide."}}, {"canonical_name": "Tehuantepec", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "tehuantepec", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tehuantepec", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 13, "variants": ["Tehuantepec", "Tchuanlepec", "Tehuilotepec"], "contexts": ["isthmus in Mexico", "isthmus location"]}, {"entity_id": "teguiza", "book_id": "kosmos_humboldt_1845", "name": "Teguiza", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Teguiza"], "contexts": ["location near formation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tehuantepec", "target_book": "kosmos_humboldt_1845", "target_name": "Teguiza", "similarity": 0.867}], "id": 798, "stable_key": "clu_f46829b61bb79a9f", "ground_truth": {"modern_name": "Isthmus of Tehuantepec", "confidence": "high", "type": "place", "country": "Mexico", "note": "'Teguiza' is likely a transcription error for Tehuantepec in one context.", "wikipedia_extract": "The Ferrocarril del Istmo de Tehuantepec is a government-owned railway system in Mexico that has three lines. It seeks to become a global logistics network focused on the manufacture and movement of goods between the Pacific Ocean and the Atlantic Ocean through the Isthmus of Tehuantepec. The project consists of the renovation of the railroad, which is expected to increase the speed of the freight train from 20 km/h (12 mph) to 70 km/h (43 mph), more than three times the current one. Meanwhile, the passenger train will be able to reach speeds of up to 100 km/h (62 mph). The state-owned company Ferrocarril del Istmo de Tehuantepec was founded in 1999, to operate the railway that connects Salina Cruz with the locality of Medias Aguas, Veracruz. Mayab and Chiapas lines were formerly leased to Ferrocarriles Chiapas-Mayab until Genesee & Wyoming gave up its concession in 2007.", "wikipedia_url": "https://en.wikipedia.org/wiki/Tren_Interoceánico"}}, {"canonical_name": "vinho", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "vinho", "book_id": "coloquios_da_orta_1563", "name": "vinho", "category": "PLANT", "subcategory": "PLANT", "count": 12, "variants": ["vinho"], "contexts": ["liquid used in medicine", "substance attributed to Bahádur's state"]}, {"entity_id": "vine", "book_id": "english_physician_1652", "name": "Vine", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Vine", "vine"], "contexts": ["plant dedicated to Bacchus", "plant with antipathy to colewort"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "vinho", "target_book": "english_physician_1652", "target_name": "Vine", "similarity": 0.908}], "id": 799, "stable_key": "clu_36d64d3cb73d2331", "ground_truth": {"modern_name": "Wine", "confidence": "low", "type": "object", "description": "A liquid used in medicine, derived from grapes.", "note": "While 'vinho' directly translates to wine, 'Vine' could refer to the plant itself. Given the context of usage in medicine, 'wine' as a substance is a more fitting identification.", "wikipedia_extract": "Wine is an alcoholic drink made from fermented grape juice. It is produced and consumed in many regions around the world, in a wide variety of styles which are influenced by different varieties of grapes, growing environments, viticulture methods, and production techniques. Wine has been produced for thousands of years, the earliest evidence dating from c. 6000 BCE in present-day Georgia. Its popularity spread around the Mediterranean during Classical antiquity, and was sustained in Western Europe by winemaking monks and a secular trade for general drinking. New World wine was established by settler colonies from the 16th century onwards, and the wine trade increased dramatically up to the latter half of the 19th century, when European vineyards were largely destroyed by the invasive pest phylloxera. After the Second World War, the wine market improved dramatically as winemakers focused on quality and marketing to cater for a more discerning audience, and wine remains a popular drink in much of the world."}}, {"canonical_name": "Potosi", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "potosi", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Potosi", "category": "PLACE", "subcategory": "CITY", "count": 14, "variants": ["Potosi"], "contexts": ["city in South America", "city in Bolivia"]}, {"entity_id": "potosi", "book_id": "kosmos_humboldt_1845", "name": "Potosi", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Potosi"], "contexts": ["town with causeway"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Potosi", "target_book": "kosmos_humboldt_1845", "target_name": "Potosi", "similarity": 1.0}], "id": 800, "stable_key": "clu_1e5edf8639026d87", "ground_truth": {"modern_name": "Potosí", "confidence": "high", "type": "place", "country": "Bolivia", "wikidata_id": "Q378135", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Potos%C3%AD", "wikipedia_extract": "Potosí, known as Villa Imperial de Potosí in the colonial period, is the capital city and a municipality of the Department of Potosí in Bolivia. It is one of the highest cities in the world at a nominal 4,067 m (13,343 ft). Diego Huallpa, an indigenous prospector, is traditionally credited with the discovery of the Cerro Rico in 1545, which led to the founding and rapid growth of Potosí due to its extraordinary silver wealth. For centuries, it was the location of the Spanish colonial silver mint. A considerable amount of the city's colonial architecture has been preserved in the historic center of the city, which—along with the globally important Cerro Rico de Potosí—are part of a designated UNESCO World Heritage Site. Potosí lies at the foot of the Cerro de Potosí—sometimes referred to as the Cerro Rico (\"rich mountain\")—a mountain popularly conceived of as being \"made of\" silver ore that dominates the city."}}, {"canonical_name": "Ohio", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "ohio", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Ohio", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 13, "variants": ["Ohio"], "contexts": ["region with fortifications", "geographic location"]}, {"entity_id": "ohio", "book_id": "kosmos_humboldt_1845", "name": "Ohio", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Ohio"], "contexts": ["river where Lepidosteus is found", "river valley"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ohio", "target_book": "kosmos_humboldt_1845", "target_name": "Ohio", "similarity": 1.0}], "id": 801, "stable_key": "clu_4793f3afbda3cbd4", "ground_truth": {"modern_name": "Ohio River", "confidence": "high", "type": "place", "country": "United States", "note": "While 'Ohio' can refer to the state, the context of a river and a region with fortifications points to the river and its valley.", "wikidata_id": "Q72054518", "wikidata_description": "valley and region along the Ohio River", "wikipedia_extract": "The Cuyahoga River (see § Pronunciation) is a river located in Northeast Ohio that feeds into Lake Erie. The Cuyahoga River bisects the city of Cleveland. As Cleveland emerged as a major manufacturing center, the river became heavily affected by industrial pollution, so much so that it caught fire at least 14 times. When it did so on June 22, 1969, news coverage of the event helped to spur the American environmental movement. For many Americans, the Cuyahoga's burning helped connect urban decay with the environmental crisis at the time in many American cities. Since then, the river has been extensively cleaned up through the efforts of Cleveland's city government and the Ohio Environmental Protection Agency (OEPA).", "wikipedia_url": "https://en.wikipedia.org/wiki/Cuyahoga_River"}}, {"canonical_name": "Pasto", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "pasto", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pasto", "category": "PLACE", "subcategory": "CITY", "count": 12, "variants": ["Pasto"], "contexts": ["mountainous population center in Colombia", "city serving southern missions"]}, {"entity_id": "pasto", "book_id": "kosmos_humboldt_1845", "name": "Pasto", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Pasto"], "contexts": ["part of a mountain chain", "volcano in South America"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pasto", "target_book": "kosmos_humboldt_1845", "target_name": "Pasto", "similarity": 1.0}], "id": 802, "stable_key": "clu_7f865827b551ac4f", "ground_truth": {"modern_name": "Pasto", "confidence": "high", "type": "place", "country": "Colombia", "wikipedia_extract": "Pashto (, PASH-toh; پښتو, Pəx̌tó, [pəʂˈto, pʊxˈto, pəʃˈto, pəçˈto]) is an eastern Iranian language in the Indo-European language family, natively spoken in northwestern Pakistan and  southern and eastern Afghanistan. It has official status in Afghanistan. It is known in historical Persian literature as Afghani (افغانی, Afghāni). Spoken as a native language mostly by ethnic Pashtuns, it is one of the two official languages of Afghanistan alongside Dari, and it is spoken as the second-largest provincial language in Pakistan, spoken mainly in Khyber Pakhtunkhwa and the northern districts of Balochistan. Likewise, it is the primary language of the Pashtun diaspora around the world. The total number of Pashto-speakers is at least 40 million, although some estimates place it as high as 60 million.", "wikipedia_url": "https://en.wikipedia.org/wiki/Pashto"}}, {"canonical_name": "Antisana", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "antisana", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Antisana", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 11, "variants": ["Antisana", "Antimano", "Antimauo"], "contexts": ["snowy peak in Cordillera Oriental", "mountain height"]}, {"entity_id": "antisana", "book_id": "kosmos_humboldt_1845", "name": "Antisana", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Antisana"], "contexts": ["specific high point on the Andes", "mountain with significant elevation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Antisana", "target_book": "kosmos_humboldt_1845", "target_name": "Antisana", "similarity": 1.0}], "id": 803, "stable_key": "clu_7adc7bc7ba781344", "ground_truth": {"modern_name": "Antisana", "confidence": "high", "type": "place", "country": "Ecuador", "wikidata_id": "Q4742194", "wikidata_description": "a protected area in Ecuador situated in the Napo Province, Quijos Canton and Archidona Canton", "wikipedia_url": "https://en.wikipedia.org/wiki/Antisana_Ecological_Reserve"}}, {"canonical_name": "Sweden", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "sweden", "book_id": "kosmos_humboldt_1845", "name": "Sweden", "category": "PLACE", "subcategory": "COUNTRY", "count": 8, "variants": ["Sweden"], "contexts": ["country where instruments were distributed", "coast where earthquake was felt"]}, {"entity_id": "suède", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Suède", "category": "PLACE", "subcategory": "COUNTRY", "count": 7, "variants": ["Suède"], "contexts": ["country", "country with population data"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Sweden", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Suède", "similarity": 0.951}], "id": 804, "stable_key": "clu_bc61cbe1070abd90", "ground_truth": {"modern_name": "Sweden", "confidence": "high", "type": "place", "country": "Sweden", "note": "'Suède' is the French name for Sweden.", "wikidata_id": "Q34", "wikidata_description": "country in Northern Europe", "wikipedia_extract": "Sweden, formally the Kingdom of Sweden, is a Nordic country located on the Scandinavian Peninsula in Northern Europe. It borders Norway to the west and north, and Finland to the east. At 450,295 square kilometres (173,860 sq mi), Sweden is the largest Nordic country by both area and population, and is the fifth-largest country in Europe. Its capital and largest city is Stockholm. Sweden has a population of 10.6 million, and a low population density of 25.5 inhabitants per square kilometre (66/sq mi); 88% of Swedes reside in urban areas. They are mostly in the central and southern half of the country.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sweden"}}, {"canonical_name": "Jorullo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "jorullo", "book_id": "kosmos_humboldt_1845", "name": "Jorullo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["Jorullo"], "contexts": ["volcanic island that was elevated", "volcanic cones"]}, {"entity_id": "jaurù", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Jaurù", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Jaurù", "Jaurn", "Jauru", "Yauru"], "contexts": ["river in South America", "river name"]}, {"entity_id": "jorullo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Jorullo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Jorullo"], "contexts": ["volcanoes of Jorullo"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Jorullo", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Jaurù", "similarity": 0.845}, {"source_book": "kosmos_humboldt_1845", "source_name": "Jorullo", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Jorullo", "similarity": 1.0}], "id": 805, "stable_key": "clu_dedb3ff50d5dcaf2", "ground_truth": {"modern_name": "Jorullo", "confidence": "high", "type": "place", "country": "Mexico", "note": "While one context mentions a river in South America, the overwhelming evidence from Humboldt and the description of a volcanic island points to the Jorullo volcano in Mexico.", "wikipedia_extract": "This is a list of notable volcanic eruptions in the 16th to 20th centuries with a volcanic explosivity index (VEI) of 4 or higher, and smaller eruptions that resulted in significant damage or fatalities. Note that there may be uncertainties to dates with historical eruptions, and there are likely to be many large eruptions that have not been identified.", "wikipedia_url": "https://en.wikipedia.org/wiki/List_of_volcanic_eruptions_1500–2000"}}, {"canonical_name": "Caqueta", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "caqueta", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Caqueta", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 14, "variants": ["Caqueta"], "contexts": ["region with immense steppes", "river banks"]}, {"entity_id": "cacatecas", "book_id": "historia_medicinal_monardes_1574", "name": "Cacatecas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cacatecas"], "contexts": ["celebrated mines of great wealth"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Caqueta", "target_book": "historia_medicinal_monardes_1574", "target_name": "Cacatecas", "similarity": 0.866}], "id": 806, "stable_key": "clu_3fe4369c6d1053b8", "ground_truth": {"modern_name": "Caquetá", "confidence": "low", "type": "place", "description": "A region and river, also associated with mines.", "note": "Mixed references to a river region and mining areas.", "wikipedia_extract": "Florencia (Spanish pronunciation: [floˈɾensja], English: Florence) is a municipality and the capital city of the Department of Caquetá, Colombia. It is  the most populous city in the Amazon Region of Colombia. It lies on the Orteguaza River which flows into the Caqueta River. Its population was 177,946 in 2023. The name of the city pays homage to an Italian businessman dedicated to the rubber trade, Paolo Ricci, from the city of Florence. The area where Florencia is located was inhabited by tribes of the Andaquí ethnic group."}}, {"canonical_name": "Gustav Rose", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "gustav_rose", "book_id": "kosmos_humboldt_1845", "name": "Gustav Rose", "category": "PERSON", "subcategory": "SCHOLAR", "count": 14, "variants": ["Gustav Rose"], "contexts": ["companion on scientific journey", "author of travelogue"]}, {"entity_id": "gustave_rose", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Gustave Rose", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Gustave Rose"], "contexts": ["researcher involved in barometric measurements"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Gustav Rose", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Gustave Rose", "similarity": 0.973}], "id": 807, "stable_key": "clu_16d5115156ec058a", "ground_truth": {"modern_name": "Gustav Rose", "confidence": "high", "type": "person", "birth_year": 1794, "death_year": 1873, "description": "German mineralogist and geologist, associated with Humboldt.", "wikidata_id": "Q64561", "wikidata_description": "German mineralogist and university teacher (1798-1873)", "wikipedia_url": "https://en.wikipedia.org/wiki/Gustav%20Rose"}}, {"canonical_name": "Equiceto", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "equiceto", "book_id": "polyanthea_medicinal", "name": "Equiceto", "category": "PLANT", "subcategory": "PLANT", "count": 14, "variants": ["Equiceto", "equiceto", "equicetum", "equiſeto"], "contexts": ["herb for abscesses", "alternative name for Cavallinha herb"]}, {"entity_id": "equisetum", "book_id": "kosmos_humboldt_1845", "name": "Equisetum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Equisetum"], "contexts": ["plant genus in fossil flora"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Equiceto", "target_book": "kosmos_humboldt_1845", "target_name": "Equisetum", "similarity": 0.856}], "id": 808, "stable_key": "clu_4960a25606577486", "ground_truth": {"modern_name": "Horsetail", "confidence": "high", "type": "plant", "linnaean": "Equisetum arvense Linnaeus", "family": "Equisetaceae", "note": "Equiceto is the Italian word for horsetail. Equisetum is the genus name.", "wikidata_id": "Q81492131", "wikidata_description": "scientific article published on 01 February 2005"}}, {"canonical_name": "Artesian wells", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "artesian_wells", "book_id": "kosmos_humboldt_1845", "name": "Artesian wells", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 7, "variants": ["Artesian wells"], "contexts": ["deep borings for water", "wells with naturally flowing water"]}, {"entity_id": "artesian_well", "book_id": "kosmos_humboldt_1845", "name": "Artesian well", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Artesian well"], "contexts": ["deep well for water extraction"]}, {"entity_id": "artesian_wells", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Artesian wells", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["Artesian wells"], "contexts": ["wells with a specific water-raising method", "wells providing warm water"]}, {"entity_id": "artesian_well", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Artesian well", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Artesian well"], "contexts": ["well drilled to tap underground water", "well with specific temperature"]}, {"entity_id": "grenelle_artesian_well", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Grenelle Artesian well", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Grenelle Artesian well"], "contexts": ["well for observing temperature increase"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Artesian wells", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Artesian wells", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Artesian wells", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Artesian well", "similarity": 0.974}, {"source_book": "kosmos_humboldt_1845", "source_name": "Artesian wells", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Grenelle Artesian well", "similarity": 0.874}, {"source_book": "kosmos_humboldt_1845", "source_name": "Artesian well", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Artesian wells", "similarity": 0.974}, {"source_book": "kosmos_humboldt_1845", "source_name": "Artesian well", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Artesian well", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Artesian well", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Grenelle Artesian well", "similarity": 0.883}], "id": 809, "stable_key": "clu_871643c1e4bdffa8", "ground_truth": {"modern_name": "Artesian well", "confidence": "high", "type": "object", "wikidata_id": "Q38250836", "wikidata_description": "Salt Lake City park with natural water source", "wikipedia_url": "https://en.wikipedia.org/wiki/Artesian_Well_Park", "wikipedia_extract": "Olympia is the capital city of the U.S. state of Washington. The population was 55,605 at the 2020 census, while the Olympia metropolitan statistical area has an estimated 300,000 people. Olympia is the county seat of Thurston County and anchors the South Puget Sound region of western Washington, 50 miles (80 km) southwest of Seattle. The Squaxin and other Coast Salish peoples inhabited the southern Puget Sound region prior to the arrival of European and American settlers in the 19th century. The Treaty of Medicine Creek was signed in 1854 and followed by the Treaty of Olympia in 1856; these two treaties forced the Squaxin to relocate to an Indian reservation."}}, {"canonical_name": "páo da China", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "páo_da_china", "book_id": "coloquios_da_orta_1563", "name": "páo da China", "category": "PLANT", "subcategory": "PLANT", "count": 14, "variants": ["páo da China", "pao da China", "pau da China"], "contexts": ["wood of China, likely referring to cinnamon", "wood from China, likely guaiacum"]}, {"entity_id": "paodachina", "book_id": "polyanthea_medicinal", "name": "paodaChina", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["paodaChina"], "contexts": ["plant used in medicinal preparations"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "páo da China", "target_book": "polyanthea_medicinal", "target_name": "paodaChina", "similarity": 0.878}], "id": 810, "stable_key": "clu_70c667b12729e4f4", "ground_truth": {"modern_name": "páo da China", "confidence": "high", "type": "plant", "description": "Wood from China, likely referring to cinnamon or guaiacum.", "note": "Portuguese term for a medicinal wood.", "wikipedia_extract": "The cash or qian was a type of coin of China and the Sinosphere, used from the 4th century BC until the 20th century, characterised by their round outer shape and a square center hole (Chinese: 方穿; pinyin: fāng chuān; Jyutping: fong1 cyun1; Pe̍h-ōe-jī: hong-chhoan). Originally cast during the Warring States period, these coins continued to be used for the entirety of Imperial China. The last Chinese cash coins were cast in 1912, the first year of the Republic of China. Generally most cash coins were made from copper or bronze alloys, with iron, lead, and zinc coins occasionally used less often throughout Chinese history. Rare silver and gold cash coins were also produced. During most of their production, cash coins were cast, but during the late Qing dynasty, machine-struck cash coins began to be made."}}, {"canonical_name": "pala", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "pala", "book_id": "coloquios_da_orta_1563", "name": "pala", "category": "PLANT", "subcategory": "PLANT", "count": 10, "variants": ["pala", "Pala", "paak", "palam", "palha"], "contexts": ["name of a tree", "plant identified by Pliny"]}, {"entity_id": "palha", "book_id": "polyanthea_medicinal", "name": "palha", "category": "PLANT", "subcategory": "PLANT", "count": 5, "variants": ["palha"], "contexts": ["material for stuffing the body", "straw"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "pala", "target_book": "polyanthea_medicinal", "target_name": "palha", "similarity": 0.891}], "id": 811, "stable_key": "clu_538a4490d7b77b93", "ground_truth": {"modern_name": "pala", "confidence": "low", "type": "plant", "description": "A type of tree and also straw used for stuffing.", "note": "Ambiguous term referring to a plant and a material.", "wikipedia_extract": "Pala d'Oro (Italian: Golden Panel) is the high altar retable of the Basilica di San Marco in Venice (and in Italian may refer to other gold altar frontals elsewhere). It is universally recognized as one of the most refined and accomplished works of Byzantine enamel, with both front and rear sides decorated. It was created and expanded in several phases over many centuries. Most of the enamel panels were made in Constantinople or Italy in a Byzantine style, but some were probably looted in Constantinople during the Fourth Crusade in 1204 and brought from there to Venice. The Pala d'Oro was thought to be first commissioned in 976 by Doge Pietro Orseolo, where it was made up of precious stones and several enamels depicting various saints, and in 1105 it was expanded on by Doge Ordelafo Faliero. In 1345, the goldsmith Giovanni Paolo Bonesegna was commissioned to complete the altarpiece by Andrea Dandolo, who was the procurator at the time, and later became doge."}}, {"canonical_name": "pao de Aguila", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "pao_de_aguila", "book_id": "polyanthea_medicinal", "name": "pao de Aguila", "category": "PLANT", "subcategory": "PLANT", "count": 12, "variants": ["pao de Aguila", "PaodeAguila", "paode Aguila", "paode aguila", "paodeAguila", "pào de Aguila", "pão de Aguila", "pãodeAguila", "pò de páode Aguila"], "contexts": ["ingredient in tobacco", "ingredient in a remedy"]}, {"entity_id": "páo_de_aguila", "book_id": "coloquios_da_orta_1563", "name": "páo de aguila", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["páo de aguila", "pau de aguila"], "contexts": ["Portuguese name for aloes wood", "wood product"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "pao de Aguila", "target_book": "coloquios_da_orta_1563", "target_name": "páo de aguila", "similarity": 0.958}], "id": 812, "stable_key": "clu_df483fa3129fe502", "ground_truth": {"modern_name": "aloes wood", "confidence": "high", "type": "plant", "description": "Fragrant wood used as incense and in traditional medicine.", "note": "Also known as agarwood or oud.", "wikipedia_extract": "Agarwood, aloeswood, eaglewood, gaharuwood, commonly referred to as oud or oudh (from Arabic: عود, romanized: ʿūd, pronounced [ʕuːd]), is a fragrant, dark and resinous wood used in incense, perfume, and small hand carvings. It forms in the heartwood of Aquilaria trees after they become infected with a type of Phaeoacremonium mold, P. parasitica. The tree defensively secretes a resin to combat the fungal infestation. Prior to becoming infected, the heartwood mostly lacks scent, and is relatively light and pale in colouration. However, as the infection advances and the tree produces its fragrant resin as a final option of defense, the heartwood becomes very dense, dark, and saturated with resin. This product is harvested, and most famously referred to in cosmetics under the scent names of oud, oodh or aguru; however, it is also called aloes (not to be confused with the succulent plant genus Aloe), agar (this name, as well, is not to be confused with the edible, algae-derived thickening agent agar agar), as well as gaharu or jinko."}}, {"canonical_name": "fomentar", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "fomentar", "book_id": "polyanthea_medicinal", "name": "fomentar", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 14, "variants": ["fomentar", "Fomentações", "fomentacoes", "fomentando", "fomentaremos", "fomentation", "fomentations", "fomentaçoens"], "contexts": ["to apply warm substances", "to foment or apply poultice"]}, {"entity_id": "fomentações", "book_id": "coloquios_da_orta_1563", "name": "fomentações", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["fomentações"], "contexts": ["used to treat beribéri"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "fomentar", "target_book": "coloquios_da_orta_1563", "target_name": "fomentações", "similarity": 0.923}], "id": 813, "stable_key": "clu_9c0cab44fd567c01", "ground_truth": {"modern_name": "fomentation", "confidence": "high", "type": "concept", "description": "Application of warm liquid or poultices to the body.", "wikipedia_extract": "A heating pad is a pad used for warming of parts of the body in order to manage pain. Localized application of heat causes the blood vessels in that area to dilate, enhancing perfusion to the targeted tissue. Types of heating pads include electrical, chemical and hot water bottles. Specialized heating pads (mats) are also used in other settings. Heat mats in plant propagation stimulate seed germination and root development; they operate at cooler temperatures. Heat mats also are available in the pet trade, especially as warming spots for reptiles such as lizards and snakes."}}, {"canonical_name": "marmelada", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "marmelada", "book_id": "polyanthea_medicinal", "name": "marmelada", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 14, "variants": ["marmelada", "marmelada crua", "marmelada deçumos"], "contexts": ["marmalade used as a binder", "conserve made from quince"]}, {"entity_id": "marmelada", "book_id": "coloquios_da_orta_1563", "name": "marmelada", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["marmelada"], "contexts": ["sweet preserve made from fruit"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "marmelada", "target_book": "coloquios_da_orta_1563", "target_name": "marmelada", "similarity": 1.0}], "id": 814, "stable_key": "clu_c0352f6d1253f493", "ground_truth": {"modern_name": "marmalade", "confidence": "high", "type": "object", "description": "Sweet preserve, typically made from fruit juice and rind.", "wikipedia_extract": "Marmalade is a sweet, tangy fruit preserve made from the juice and peel of citrus fruits boiled with sugar and water. The well-known version is made from bitter orange, but other citrus fruits such as lemons and limes can also be used. The bitter orange is mostly used in marmalade because of its high pectin content, which gives a thick consistency to its marmalade. In addition, the balance of acid and pectin is needed for consistency. Fruits with low pectin have it added to make the marmalade. Historically, the term marmalade was often used for non-citrus preserves."}}, {"canonical_name": "Afaro", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "afaro", "book_id": "ricettario_fiorentino_1597", "name": "Afaro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 10, "variants": ["Afaro", "Af^ro", "Afarb", "Afàro", "afaro"], "contexts": ["root collected whole", "spice, likely saffron"]}, {"entity_id": "afaro", "book_id": "polyanthea_medicinal", "name": "Afaro", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Afaro"], "contexts": ["root used in emetic preparation", "herb"]}, {"entity_id": "a_faro", "book_id": "ricettario_fiorentino_1597", "name": "A faro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["A faro"], "contexts": ["ingredient in a preparation", "saffron"]}, {"entity_id": "faro", "book_id": "polyanthea_medicinal", "name": "faro", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["faro"], "contexts": ["plant used in remedies"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Afaro", "target_book": "polyanthea_medicinal", "target_name": "Afaro", "similarity": 0.913}, {"source_book": "ricettario_fiorentino_1597", "source_name": "A faro", "target_book": "polyanthea_medicinal", "target_name": "faro", "similarity": 0.893}], "id": 815, "stable_key": "clu_ba34944aa60603aa", "ground_truth": {"modern_name": "saffron", "confidence": "high", "type": "plant", "linnaean": "Crocus sativus", "family": "Iridaceae", "description": "Spice derived from the stigmas of Crocus flowers, used for color and flavor.", "wikipedia_extract": "Crocus sativus, commonly known as saffron crocus or autumn crocus, is a species of flowering plant in the iris family Iridaceae. A cormous autumn-flowering cultivated perennial, unknown in the wild, it is best known for the culinary use of its floral stigmas as the spice saffron. Human cultivation of saffron crocus and the trade and use of saffron have endured for more than 3,500 years and span different cultures, continents, and civilizations. The plant is most commonly known as the saffron crocus. The alternative name autumn crocus is also used for species in the Colchicum genus, which are not closely related but strongly resemble the true crocuses; in particular, the superficially similar species Colchicum autumnale is sometimes even referred to as meadow saffron. However, the true crocuses have three stamens and one style supporting three long stigmas, while colchicums have six stamens and three styles; and belong to a different family, Colchicaceae."}}, {"canonical_name": "Hedg sides", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "hedg_sides", "book_id": "english_physician_1652", "name": "Hedg sides", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 13, "variants": ["Hedg sides", "Hedg", "Hedg Sides", "Hedges", "Wood sides"], "contexts": ["location where the herb grows", "habitat for fern growth"]}, {"entity_id": "hoar_edge", "book_id": "kosmos_humboldt_1845", "name": "Hoar Edge", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Hoar Edge"], "contexts": ["location near Cornbrook coal-mine"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Hedg sides", "target_book": "kosmos_humboldt_1845", "target_name": "Hoar Edge", "similarity": 0.853}], "id": 816, "stable_key": "clu_f5e7462aff30a2e3", "ground_truth": {"modern_name": "Edge", "confidence": "low", "type": "place", "country": "United Kingdom", "note": "The term 'Hedg sides' is ambiguous and likely refers to a specific local place name related to vegetation or a boundary. 'Hoar Edge' is a potential match from Humboldt, but 'Hedg sides' is very different. The context 'location where the herb grows' is vague. Given the OCR noise possibility and ambiguity, confidence is low.", "wikipedia_extract": "David Howell Evans (born 8 August 1961), known by his stage name the Edge or simply Edge, is an Irish and British musician, singer, and songwriter. He is best known as the lead guitarist, keyboardist, and backing vocalist of the rock band U2. A member of the group since its inception, he has recorded 15 studio albums with them as well as one solo record. His understated style of guitar playing, a signature of U2's music, is distinguished by chiming timbres, use of rhythmic delay, drone notes, harmonics, and an extensive use of effects units. Born in England to Welsh parents and raised in Ireland, the Edge formed the band that would become U2 with his classmates at Mount Temple Comprehensive School and his elder brother Dik in 1976. Inspired by the ethos of punk rock and its basic arrangements, the group began to write its own material.", "wikipedia_url": "https://en.wikipedia.org/wiki/The_Edge"}}, {"canonical_name": "Tierra del Fuego", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "tierra_del_fuego", "book_id": "origin_of_species_darwin_1859", "name": "Tierra del Fuego", "category": "PLACE", "subcategory": "REGION", "count": 11, "variants": ["Tierra del Fuego"], "contexts": ["location of indigenous peoples with dogs", "geographic location with savages"]}, {"entity_id": "terre_de_feu", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Terre de Feu", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Terre de Feu", "Terre-de-Feu"], "contexts": ["southern tip of South America", "archipelago at southern tip of South America"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Tierra del Fuego", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Terre de Feu", "similarity": 0.86}], "id": 817, "stable_key": "clu_97f6c0e130c560b2", "ground_truth": {"modern_name": "Tierra del Fuego", "confidence": "high", "type": "place", "description": "Archipelago at the southern tip of South America.", "wikipedia_extract": "Tierra del Fuego (; Spanish: [ˈtjera ðel ˈfweɣo]; Spanish for 'Land of Fire') is an archipelago off the southernmost tip of the South American mainland, across the Strait of Magellan. The archipelago consists of the main island, Isla Grande de Tierra del Fuego, with an area of 73,746 km2 (28,473 sq mi), along with numerous smaller islands, including Cape Horn and Diego Ramírez Islands. The western part of the Tierra del Fuego archipelago, about two-thirds including its many islands, is part of Chile, and the eastern part is part of Argentina. The southernmost extent of the archipelago, Cape Horn, lies just north of 56° south. The earliest-known human settlement in Tierra del Fuego dates to c. 8,000 BC. Europeans first explored the islands during Ferdinand Magellan's expedition of 1520."}}, {"canonical_name": "Ants", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "ants", "book_id": "origin_of_species_darwin_1859", "name": "Ants", "category": "ANIMAL", "subcategory": "INSECT", "count": 10, "variants": ["ants", "Ants"], "contexts": ["social insects", "insects with notable instincts, slave-making"]}, {"entity_id": "ant", "book_id": "principles_of_psychology_james_1890", "name": "ant", "category": "ANIMAL", "subcategory": "INSECT", "count": 3, "variants": ["ant"], "contexts": ["small insect", "insect with a distinct consciousness"]}, {"entity_id": "ants", "book_id": "principles_of_psychology_james_1890", "name": "ants", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["ants"], "contexts": ["insects studied for reasoning"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Ants", "target_book": "principles_of_psychology_james_1890", "target_name": "ant", "similarity": 0.961}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Ants", "target_book": "principles_of_psychology_james_1890", "target_name": "ants", "similarity": 0.951}], "id": 818, "stable_key": "clu_945672d3ea4535e6", "ground_truth": {"modern_name": "Ants", "confidence": "high", "type": "animal", "linnaean": "Formicidae", "family": "Formicidae", "description": "Social insects known for complex behaviors and colonies.", "wikipedia_extract": "Ants are eusocial insects of the family Formicidae and, along with the related wasps and bees, belong to the order Hymenoptera. Ants evolved from vespoid wasp ancestors in the Cretaceous period. More than 13,800 of an estimated total of 22,000 species have been classified. They are easily identified by their geniculate (elbowed) antennae and the distinctive node-like structure that forms their slender waists. Ants form colonies that range in size from a few dozen individuals often living in small natural cavities to highly organised colonies that may occupy large territories with a sizeable nest (or nests) that consist of millions of individuals, in some cases they reach hundreds of millions of individuals in super colonies. Typical colonies consist of various castes of sterile, wingless females, most of which are workers (ergates), as well as soldiers (dinergates) and other specialised groups."}}, {"canonical_name": "phonolithe", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "phonolithe", "book_id": "relation_historique_humboldt_vol3_1825", "name": "phonolithe", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 12, "variants": ["phonolithe", "PHONOLITHE", "Phonolite", "phonolite", "phonolithes"], "contexts": ["rock formation between Otuz and Cerro de Flores", "rock formation in Venezuela"]}, {"entity_id": "phonolithe", "book_id": "kosmos_humboldt_1845", "name": "phonolithe", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["phonolithe"], "contexts": ["endogenous rock type", "porphyritic slate rock"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "phonolithe", "target_book": "kosmos_humboldt_1845", "target_name": "phonolithe", "similarity": 1.0}], "id": 819, "stable_key": "clu_f406cd10c37c7219", "ground_truth": {"modern_name": "Phonolite", "confidence": "high", "type": "mineral", "wikidata_id": "Q1257550", "wikidata_description": "intermediate igneous rock; chenotype (younger) outpouring equivalent of alkaline syenite", "wikipedia_extract": "Phonolite is an uncommon shallow intrusive or extrusive rock, of intermediate chemical composition between felsic and mafic, with texture ranging from aphanitic (fine-grained) to porphyritic (mixed fine- and coarse-grained). Phonolite is a variation of the igneous rock trachyte that contains nepheline or leucite rather than quartz. It has an unusually high (12% or more) Na2O + K2O content, defining its position in the TAS classification of igneous rocks. Its coarse grained (phaneritic) intrusive equivalent is nepheline syenite. Phonolite is typically fine grained and compact. The name phonolite comes from the Ancient Greek meaning \"sounding stone\" due to the metallic sound it produces if an unfractured plate is hit; hence, the English name clinkstone is given as a synonym.", "wikipedia_url": "https://en.wikipedia.org/wiki/Phonolite"}}, {"canonical_name": "serpentine", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "serpentine", "book_id": "kosmos_humboldt_1845", "name": "serpentine", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 9, "variants": ["serpentine"], "contexts": ["igneous rock from earth's interior", "rock type"]}, {"entity_id": "serpentine_amphibolique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "serpentine amphibolique", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["serpentine amphibolique", "serpentine grenatifère"], "contexts": ["transition terrain rock", "type of rock"]}, {"entity_id": "couches_de_serpentine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "couches de serpentine", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["couches de serpentine"], "contexts": ["layers of serpentine rock"]}, {"entity_id": "roches_serpentineuscs", "book_id": "relation_historique_humboldt_vol3_1825", "name": "roches serpentineuscs", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["roches serpentineuscs"], "contexts": ["serpentine rocks"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "serpentine", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "serpentine amphibolique", "similarity": 0.896}, {"source_book": "kosmos_humboldt_1845", "source_name": "serpentine", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "couches de serpentine", "similarity": 0.887}, {"source_book": "kosmos_humboldt_1845", "source_name": "serpentine", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "roches serpentineuscs", "similarity": 0.914}], "id": 820, "stable_key": "clu_6d52a1dffed00ac7", "ground_truth": {"modern_name": "Serpentine", "confidence": "high", "type": "mineral", "wikipedia_extract": "A succubus (pl. succubi) is a female demon who is described in various European folklore as appearing in the dreams of male humans in order to seduce them. Repeated interactions between a succubus and a man will lead to sexual activity, a bond forming between them, and ultimately sexual intercourse, as she requires semen to survive. The establishment and perpetuation of such a relationship enables the production of a hybrid child known as a cambion, but at the expense of the man, whose mental and physical health will deteriorate rapidly, eventually resulting in his death if the succubus continues courting him for a protracted period. In modern representations, a succubus is often depicted as a beautiful woman seductress or charming, rather than as demonic or frightening, to attract people instead of repulsing them. The male counterpart of the succubus is the incubus.", "wikipedia_url": "https://en.wikipedia.org/wiki/Succubus"}}, {"canonical_name": "Hist. de las Indias", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "hist__de_las_indias", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Hist. de las Indias", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 12, "variants": ["Hist. de las Indias", "Hist. de Ind.", "Hist. de Ind. occid.", "Hist. de las Jndias", "Hist. de ta Revo/.", "Hist. del Nuevo Mnndo", "Hist. des Antilles"], "contexts": ["historical text", "historical work by Gomara"]}, {"entity_id": "the_history_of_índia", "book_id": "coloquios_da_orta_1563", "name": "The history of Índia", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["The history of Índia"], "contexts": ["book by Elphinstone"]}, {"entity_id": "hist__gen__de_las_índias_occideniales", "book_id": "coloquios_da_orta_1563", "name": "Hist. gen. de las índias occideniales", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Hist. gen. de las índias occideniales"], "contexts": ["title of a book"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hist. de las Indias", "target_book": "coloquios_da_orta_1563", "target_name": "The history of Índia", "similarity": 0.917}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hist. de las Indias", "target_book": "coloquios_da_orta_1563", "target_name": "Hist. gen. de las índias occideniales", "similarity": 0.875}], "id": 821, "stable_key": "clu_d61de2909276d0a5", "ground_truth": {"modern_name": "History of the Indies", "confidence": "high", "type": "object", "description": "Historical text detailing the Americas, often attributed to Gomara.", "note": "The primary context refers to Gonzalo Fernández de Oviedo y Valdés's 'Historia general y natural de las Indias'.", "wikipedia_extract": "The Treaty of the Danish West Indies (Danish: Vestindiens traktat), officially the Convention between the United States and Denmark for cession of the Danish West Indies (Danish: Konventionen mellem USA og Danmark), was a 1916 treaty transferring sovereignty of the Danish West Indies from Denmark to the United States in exchange for a sum of US$25,000,000 in gold ($722 million in 2024), and agreement to cede US interest in Greenland. It is one of the most recent permanent expansions of United States territory. Two of the islands had been in Danish possession since the 17th century and St. Croix since 1733. The glory days of the colony had been from around 1750 to 1850, based on transit trade and the production of rum and sugar using African slaves as labour. By the second half of the 19th century, the sugar production was embattled by the cultivation of sugar beets, and although the slaves had been emancipated in 1848, the agricultural land and the trade was still controlled by the white population, and the living conditions of the descendants of the slaves were poor."}}, {"canonical_name": "Coraçone", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "coraçone", "book_id": "coloquios_da_orta_1563", "name": "Coraçone", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 11, "variants": ["Coraçone"], "contexts": ["lands bordering Dely", "nation of Cotalmaluco"]}, {"entity_id": "corientes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Corientes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Corientes", "Corrienles"], "contexts": ["name of a cape", "Fondeadero in a southern gulf"]}, {"entity_id": "corcovado", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Corcovado", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Corcovado"], "contexts": ["peak on the coast"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Coraçone", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Corientes", "similarity": 0.851}, {"source_book": "coloquios_da_orta_1563", "source_name": "Coraçone", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Corcovado", "similarity": 0.844}], "id": 822, "stable_key": "clu_e52f7f6ffdf6a2bb", "ground_truth": {"modern_name": "Cape Correntes", "confidence": "medium", "type": "place", "description": "A cape or geographical feature on a southern coast.", "note": "This cluster appears to conflate several place names, with 'Coraçone' being the most consistently referenced but potentially referring to a broader region or a specific locality in a non-European context. 'Corientes' specifically refers to a cape, and 'Corcovado' to a peak.", "wikipedia_extract": "Cape Correntes (sometimes also called \"Cape Corrientes\" in English) (Port.: \"Cabo das Correntes\") is a cape or headland in the Inhambane Province in Mozambique. It sits at the southern entry of the Mozambique Channel.•23°55′36″S 35°31′48″E Cape Correntes was historically regarded as one of the most terrifying obstacles facing sailing ships in the Indian Ocean. It is named after the exceptionally fast southward current that passes here, part of the Mozambique Current, with a tendency to form eddies at this cape. It is also a confluence point of winds, with the capacity to produce unpredictably violent gusts and whirlwinds. Medieval dhows of the Kilwa Sultanate rarely (if ever) sailed below it, thereby making Cape Correntes the southern boundary of the Swahili Coast and cultural zone. Local legends said the cape was inhabited by mermaids that lured unfortunate sailors to their deaths."}}, {"canonical_name": "Virginie", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "virginie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Virginie", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 12, "variants": ["Virginie"], "contexts": ["colony in North America", "state mentioned"]}, {"entity_id": "virginia", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Virginia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Virginia"], "contexts": ["location where solar spectrum image was obtained", "location for spectral image"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Virginie", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Virginia", "similarity": 0.949}], "id": 823, "stable_key": "clu_2b381d1d3d6858f7", "ground_truth": {"modern_name": "Virginia", "confidence": "high", "type": "place", "country": "United States", "wikipedia_extract": "Park Place is a neighborhood in the western half of Norfolk, Virginia. Its boundaries are roughly Granby Street on the east, Colley Avenue on the west, 23rd Street on the south and up to (and including the southern half of) 38th Street to the north. Within these boundaries Park Place is made up of 4 historic subdivisions; Virginia Place, East Kensington, Park Place, and East Old Dominion Place. The Park Place Historic District is a national historic district listed on the National Register of Historic Places in 2005 and enlarged in 2017. It encompasses 1,525 contributing buildings, 2 contributing sites, and 5 contributing structures in the Park Place neighborhood of Norfolk. It is an example of streetcar suburban development in Norfolk during the late 19th and early 20th centuries.", "wikipedia_url": "https://en.wikipedia.org/wiki/Park_Place_Historic_District_(Norfolk,_Virginia)"}}, {"canonical_name": "unconsciousness", "category": "DISEASE", "subcategory": "PSYCHOLOGICAL", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "unconsciousness", "book_id": "principles_of_psychology_james_1890", "name": "unconsciousness", "category": "DISEASE", "subcategory": "PSYCHOLOGICAL", "count": 10, "variants": ["Unconsciousness", "unconsciousness"], "contexts": ["lack of awareness", "symptom in hysterics"]}, {"entity_id": "epileptiform_unconsciousness", "book_id": "principles_of_psychology_james_1890", "name": "epileptiform unconsciousness", "category": "DISEASE", "subcategory": "PSYCHOLOGICAL", "count": 1, "variants": ["epileptiform unconsciousness"], "contexts": ["seizure-like loss of consciousness"]}, {"entity_id": "unconsciousness", "book_id": "first_principles_spencer_1862", "name": "unconsciousness", "category": "DISEASE", "subcategory": "PSYCHOLOGICAL", "count": 3, "variants": ["unconsciousness"], "contexts": ["lack of awareness", "state of being unaware"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "unconsciousness", "target_book": "first_principles_spencer_1862", "target_name": "unconsciousness", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "epileptiform unconsciousness", "target_book": "first_principles_spencer_1862", "target_name": "unconsciousness", "similarity": 0.861}], "id": 824, "stable_key": "clu_cda12c1be44f751c", "ground_truth": {"modern_name": "Unconsciousness", "confidence": "high", "type": "disease", "modern_term": "Unconsciousness", "wikidata_id": "Q12829165", "wikidata_description": "the state, in a normally conscious being, of not being conscious", "wikipedia_url": "https://en.wikipedia.org/wiki/Unconsciousness", "wikipedia_extract": "Unconsciousness is a state in which a living individual exhibits a complete, or near-complete, inability to maintain an awareness of self and environment or to respond to any human or environmental stimulus. Unconsciousness may occur as the result of traumatic brain injury, brain hypoxia (inadequate oxygen, possibly due to a brain infarction or cardiac arrest), severe intoxication with drugs that depress the activity of the central nervous system (e.g., alcohol and other hypnotic or sedative drugs), severe fatigue, pain, anaesthesia, and other causes. Loss of consciousness should not be confused with the notion of the psychoanalytic unconscious, cognitive processes that take place outside awareness (e.g., implicit cognition), and with altered states of consciousness such as sleep, delirium, hypnosis, and other altered states in which the person responds to stimuli, including trance and psychedelic experiences. Heart failure (HF) (congestive heart failure (CHF)) Myocardial infarction (MI) (heart attack) Intracerebral hemorrhage (hemorrhagic stroke) Traumatic brain injury (TBI) (intracranial injury) Acute respiratory distress syndrome (ARDS) In jurisprudence, unconsciousness may entitle the criminal defendant to the defense of automatism, i.e. a state without control of one's own actions, an excusing condition that allows a defendant to argue that they should not be held criminally liable for their actions or omissions. In most countries, courts must consider whether unconsciousness in a situation can be accepted as a defense; it can vary from case to case."}}, {"canonical_name": "Chinese", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "chinese", "book_id": "kosmos_humboldt_1845", "name": "Chinese", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 13, "variants": ["Chinese"], "contexts": ["people of China", "civilization known for careful observation"]}, {"entity_id": "chineza", "book_id": "coloquios_da_orta_1563", "name": "chineza", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["chineza"], "contexts": ["probable origin of a copper coin"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Chinese", "target_book": "coloquios_da_orta_1563", "target_name": "chineza", "similarity": 0.954}], "id": 825, "stable_key": "clu_363ff2cea4e5fd29", "ground_truth": {"modern_name": "China", "confidence": "high", "type": "place", "country": "China", "wikidata_id": "Q148", "wikidata_description": "country in East Asia", "wikipedia_url": "https://en.wikipedia.org/wiki/Demographics_of_China", "wikipedia_extract": "The People's Republic of China is the second most-populous country in the world with a population exceeding 1.4 billion, only surpassed by India. China was the world's most populous country until being surpassed by India in 2023. In 2025, China's population officially stood at 1.404 billion, which was three million less than the previous year, with the lowest recorded birthrate since at least the proclamation of the People's Republic of China in 1949. China's population has a relatively small youth component, partially a result of the strict enforcement of China's one-child policy that was in effect from 1979 until 2015, which limited urban families to one child and rural families to two. As of 2022, Chinese state media reported the country's total fertility rate to be 1.09, one of the lowest in the world alongside South Korea, Taiwan, Hong Kong and Singapore. Since 2022, deaths have outstripped births in the country."}}, {"canonical_name": "photography", "category": "PRACTICE", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "photography", "book_id": "connexion_physical_sciences_somerville_1858", "name": "photography", "category": "PRACTICE", "subcategory": "OTHER_CONCEPT", "count": 13, "variants": ["photography"], "contexts": ["art of creating permanent pictures", "art of capturing images with light"]}, {"entity_id": "photographic_process", "book_id": "kosmos_humboldt_1845", "name": "photographic process", "category": "PRACTICE", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["photographic process"], "contexts": ["recording by photography"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "photography", "target_book": "kosmos_humboldt_1845", "target_name": "photographic process", "similarity": 0.898}], "id": 826, "stable_key": "clu_b40176ce5df31e5b", "ground_truth": {"modern_name": "Photography", "confidence": "high", "type": "concept", "wikidata_id": "Q11633", "wikidata_description": "art, science, and practice of creating durable images by recording light or other electromagnetic radiation", "wikipedia_url": "https://en.wikipedia.org/wiki/Photography"}}, {"canonical_name": "pombos", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "pombos", "book_id": "polyanthea_medicinal", "name": "pombos", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 12, "variants": ["pombos", "Pombos", "pomba", "pombo"], "contexts": ["blood used in a remedy", "animal used as a remedy"]}, {"entity_id": "pombas", "book_id": "coloquios_da_orta_1563", "name": "Pombas", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 2, "variants": ["Pombas", "pombas"], "contexts": ["birds found in abundance", "many kinds of doves found"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "pombos", "target_book": "coloquios_da_orta_1563", "target_name": "Pombas", "similarity": 0.92}], "id": 827, "stable_key": "clu_4546e28d891a079c", "ground_truth": {"modern_name": "Doves", "confidence": "high", "type": "animal", "linnaean": "Columba livia", "family": "Columbidae", "description": "Birds, often kept or used for medicinal purposes.", "note": "The Portuguese 'pombos' and 'pombas' both translate to doves or pigeons.", "wikipedia_extract": "The rock dove (Columba livia), also known as the common pigeon or \"rock pigeon\", is a member of the bird family Columbidae (doves and pigeons). In common usage, it is often simply referred to as the \"pigeon\", although the rock dove is the wild form of the bird; the pigeons familiar to most people are the domesticated forms of the wild rock dove. Wild rock doves are uniformly pale grey with two black bars on each wing, with few differences being seen between males and females; i.e. they are not strongly sexually dimorphic. The domestic pigeon, often, but invalidly, called \"Columba livia domestica\", which includes about 1,000 different breeds, is descended from this species. Escaped domestic pigeons are the origin of feral pigeons around the world. Both forms can vary widely in the colour and pattern of their plumage unlike their wild ancestor, being red, brown, checkered, uniformly coloured, or pied."}}, {"canonical_name": "ass", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "ass", "book_id": "origin_of_species_darwin_1859", "name": "ass", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 9, "variants": ["ass"], "contexts": ["domesticated equid species", "animal with transverse bars on legs"]}, {"entity_id": "asses", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Asses", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["Asses"], "contexts": ["donkey animals", "animal discussed for gall presence"]}, {"entity_id": "female-ass", "book_id": "origin_of_species_darwin_1859", "name": "female-ass", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["female-ass"], "contexts": ["female donkey used in a cross"]}, {"entity_id": "asses", "book_id": "origin_of_species_darwin_1859", "name": "Asses", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Asses"], "contexts": ["striped"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "ass", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Asses", "similarity": 0.93}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Asses", "target_book": "origin_of_species_darwin_1859", "target_name": "female-ass", "similarity": 0.881}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Asses", "target_book": "origin_of_species_darwin_1859", "target_name": "Asses", "similarity": 1.0}], "id": 828, "stable_key": "clu_2a6e3ddff74221e1", "ground_truth": {"modern_name": "Donkey", "confidence": "high", "type": "animal", "wikidata_id": "Q19707", "wikidata_description": "subspecies of mammal (donkey as a domesticated subspecies); beast of burden, similar to a horse, but smaller", "wikipedia_url": "https://en.wikipedia.org/wiki/Donkey"}}, {"canonical_name": "cholera", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "cholera", "book_id": "historia_medicinal_monardes_1574", "name": "cholera", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 7, "variants": ["cholera"], "contexts": ["humor evacuated by Cañafistola", "bodily fluid purged by Pinones"]}, {"entity_id": "choler", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Choler", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["choler", "Choler"], "contexts": ["one of the four humors, associated with anger", "a humor, likely bile"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "cholera", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Choler", "similarity": 0.918}], "id": 829, "stable_key": "clu_dd458b9d58fb3644", "ground_truth": {"modern_name": "Choler", "confidence": "high", "type": "concept", "note": "This refers to the ancient concept of one of the four humors, not the modern disease 'cholera'.", "wikipedia_extract": "Anger is an intense emotional state involving a strong, uncomfortable and non-cooperative response to a perceived provocation, hurt, or threat. A person experiencing anger will often experience physical effects, such as increased heart rate, elevated blood pressure, and increased levels of the stress hormones adrenaline and noradrenaline. Some view anger as an emotion that triggers part of the fight or flight response. Anger becomes the predominant feeling behaviorally, cognitively, and physiologically when a person makes the conscious choice to take action to immediately stop the threatening behavior of another outside force. Anger can have many physical and mental consequences. The external expression of anger can be found in facial expressions, body language, physiological responses, and at times public acts of aggression."}}, {"canonical_name": "spirits of Wine", "category": "SUBSTANCE", "subcategory": "CHEMICAL", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "spirits_of_wine", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "spirits of Wine", "category": "SUBSTANCE", "subcategory": "CHEMICAL", "count": 8, "variants": ["spirits of Wine", "spirits of wine"], "contexts": ["distilled alcohol from wine", "liquid in which ice does not long continue fixation"]}, {"entity_id": "spirit_of_wine", "book_id": "connexion_physical_sciences_somerville_1858", "name": "spirit of wine", "category": "SUBSTANCE", "subcategory": "CHEMICAL", "count": 5, "variants": ["spirit of wine"], "contexts": ["liquid used in capillary experiments", "used in experiment with saline solution"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "spirits of Wine", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "spirit of wine", "similarity": 0.955}], "id": 830, "stable_key": "clu_6a5133e37db06da5", "ground_truth": {"modern_name": "Ethanol", "confidence": "high", "type": "chemical", "wikidata_id": "Q153", "wikidata_description": "chemical compound", "wikipedia_extract": "Ethanol (also called ethyl alcohol, grain alcohol, drinking alcohol, or simply alcohol) is an organic compound with the chemical formula CH3CH2OH. It is an alcohol, with its formula also written as C2H5OH, C2H6O or EtOH, where Et is the pseudoelement symbol for ethyl. Ethanol is a volatile, flammable, colorless liquid with a pungent taste. As a psychoactive depressant, it is the active ingredient in alcoholic beverages, and the second most consumed drug globally behind caffeine. Ethanol is naturally produced by the fermentation process of sugars by yeasts or via petrochemical processes such as ethylene hydration. Historically it was used as a general anesthetic, and has modern medical applications as an antiseptic, disinfectant, solvent for some medications, and antidote for methanol poisoning and ethylene glycol poisoning.", "wikipedia_url": "https://en.wikipedia.org/wiki/Ethanol"}}, {"canonical_name": "Pallat of the Mouth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "pallat_of_the_mouth", "book_id": "english_physician_1652", "name": "Pallat of the Mouth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 8, "variants": ["Pallat of the Mouth", "Pallat", "Pallate of the Mouth", "Pallet of the Mouth"], "contexts": ["body part helped by preparation", "part of mouth, can be down"]}, {"entity_id": "palato", "book_id": "polyanthea_medicinal", "name": "palato", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["palato", "pala"], "contexts": ["palate", "palate, affected by nerve damage"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Pallat of the Mouth", "target_book": "polyanthea_medicinal", "target_name": "palato", "similarity": 0.843}], "id": 831, "stable_key": "clu_128f77a376271190", "ground_truth": {"modern_name": "Palate", "confidence": "high", "type": "anatomy", "description": "The roof of the mouth, a part of the oral anatomy.", "wikipedia_extract": "The palate () is the roof of the mouth in humans and other mammals. It separates the oral cavity from the nasal cavity. A similar structure is found in crocodilians, but in most other tetrapods, the oral and nasal cavities are not truly separated. The palate is divided into two parts, the anterior, bony hard palate and the posterior, fleshy soft palate (or velum). The maxillary nerve branch of the trigeminal nerve supplies sensory innervation to the palate. If the fusion is incomplete,  a cleft palate results."}}, {"canonical_name": "houille", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "houille", "book_id": "relation_historique_humboldt_vol3_1825", "name": "houille", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 9, "variants": ["houille"], "contexts": ["mineral found on Bogota plateau", "true coal found near Carache"]}, {"entity_id": "houiller", "book_id": "relation_historique_humboldt_vol3_1825", "name": "houiller", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["houiller"], "contexts": ["coal-bearing formation", "rock type"]}, {"entity_id": "hauyne", "book_id": "kosmos_humboldt_1845", "name": "hauyne", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["hauyne"], "contexts": ["mineral ejected from crater"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "houille", "target_book": "kosmos_humboldt_1845", "target_name": "hauyne", "similarity": 0.856}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "houiller", "target_book": "kosmos_humboldt_1845", "target_name": "hauyne", "similarity": 0.856}], "id": 832, "stable_key": "clu_5a55013633ebd167", "ground_truth": {"modern_name": "Coal", "confidence": "high", "type": "mineral", "note": "Includes related terms referring to coal and coal-bearing formations.", "wikidata_id": "Q268335", "wikidata_description": "left tributary of the Liard River in Canada", "wikipedia_url": "https://en.wikipedia.org/wiki/Coal", "wikipedia_extract": "Coal is a combustible black or brownish-black sedimentary rock, formed as layers called coal seams. Coal is mostly carbon with variable amounts of other elements, chiefly hydrogen, sulfur, oxygen, and nitrogen. It is a fossil fuel, formed when plants decay into peat which is converted into coal by the heat and pressure of deep burial over millions of years. Vast deposits formed from wetlands called coal forests that covered much of the tropics during the late Carboniferous and early Permian. Coal is used primarily as a fuel. While coal has been known and used for thousands of years, its usage was limited until the Industrial Revolution."}}, {"canonical_name": "muschelkalk", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "muschelkalk", "book_id": "relation_historique_humboldt_vol3_1825", "name": "muschelkalk", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["muschelkalk", "mnachelkalk", "muscheikalk"], "contexts": ["geological formation name", "limestone type"]}, {"entity_id": "muschelkalk", "book_id": "kosmos_humboldt_1845", "name": "muschelkalk", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["muschelkalk"], "contexts": ["geological formation", "geological rock formation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "muschelkalk", "target_book": "kosmos_humboldt_1845", "target_name": "muschelkalk", "similarity": 1.0}], "id": 833, "stable_key": "clu_7d032b3f39204c34", "ground_truth": {"modern_name": "Muschelkalk", "confidence": "high", "type": "mineral", "note": "This refers to a specific geological formation.", "wikidata_id": "Q60882191", "wikidata_description": "special protection area in the EU defined by the birds directive in Thüringen, Germany", "wikipedia_extract": "Nemertea is a phylum of animals also known as ribbon worms or proboscis worms, consisting of about 1300 known species. Most ribbon worms are very slim, usually only a few millimeters wide, although a few have relatively short but wide bodies. Many have patterns of yellow, orange, red and green coloration. The foregut, stomach and intestine run a little below the midline of the body, the anus is at the tip of the tail, and the mouth is under the front. A little above the gut is the rhynchocoel, a cavity which mostly runs above the midline and ends a little short of the rear of the body. All species have a proboscis which lies in the rhynchocoel when inactive but everts to emerge just above the mouth to capture the animal's prey with venom.", "wikipedia_url": "https://en.wikipedia.org/wiki/Nemertea"}}, {"canonical_name": "Cocomero", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "cocomero", "book_id": "ricettario_fiorentino_1597", "name": "Cocomero", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 12, "variants": ["Cocomero", "Cocomero asinino", "cocomeri", "cocomero", "cocomero alinmo", "cocomero asinino", "cocomero salvatico", "di Cocomeri", "di cocomero afinino"], "contexts": ["watermelon, a fruit processed similarly to seeds", "watermelon"]}, {"entity_id": "coumarouma", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Coumarouma", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Coumarouma"], "contexts": ["plant yielding fruit"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Cocomero", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Coumarouma", "similarity": 0.848}], "id": 834, "stable_key": "clu_259c9f2ab20a5070", "ground_truth": {"modern_name": "Watermelon", "confidence": "medium", "type": "plant", "linnaean": "Citrullus lanatus", "family": "Cucurbitaceae", "description": "A large, sweet fruit from a vine-like plant.", "note": "The primary reference 'Cocomero' is Italian for watermelon. 'Coumarouma' is likely a different plant, possibly a tonka bean.", "wikipedia_extract": "The watermelon (Citrullus lanatus) is a species of flowering plant in the family Cucurbitaceae, that has a large, edible fruit. It is a scrambling and trailing vine-like plant, and is widely cultivated worldwide, with more than 1,000 varieties. Watermelons are grown in favorable climates from tropical to temperate regions worldwide for its large edible fruit, which is a berry with a hard rind and no internal divisions, and is botanically called a pepo. The sweet, juicy flesh is usually deep red to pink, with many seeds that are black when mature, white when immature. Seedless varieties also exist. The fruit can be eaten raw or pickled, and the rind is edible after cooking."}}, {"canonical_name": "venesectionem", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "venesectionem", "book_id": "polyanthea_medicinal", "name": "venesectionem", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 12, "variants": ["venesectionem", "Venefectio", "venafectio", "venefectione", "venesectio", "venesection", "veneſectio", "venä sectione"], "contexts": ["bloodletting", "practice of venesection"]}, {"entity_id": "vivisecting", "book_id": "principles_of_psychology_james_1890", "name": "vivisecting", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["vivisecting"], "contexts": ["surgical experimentation on living animals"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "venesectionem", "target_book": "principles_of_psychology_james_1890", "target_name": "vivisecting", "similarity": 0.845}], "id": 835, "stable_key": "clu_c56b84667e1fb3d1", "ground_truth": {"modern_name": "bloodletting", "confidence": "high", "type": "concept", "description": "The practice of drawing blood for medical purposes, a common historical treatment.", "wikipedia_extract": "Bloodletting (or blood-letting) is the deliberate withdrawal of blood from a patient to prevent or cure illness and disease. Bloodletting, whether by a physician or by leeches, was based on an ancient system of medicine in which blood and other bodily fluids were regarded as \"humors\" that had to remain in proper balance to maintain health. It was the most common medical practice performed by surgeons from antiquity until the late 19th century, a span of over 2,000 years. In Europe, the practice continued to be relatively common until the end of the 19th century. The practice has been abandoned by modern-style medicine for all except a few very specific medical conditions. In the beginning of the 19th century, studies had begun to show the harmful effects of bloodletting."}}, {"canonical_name": "hindustani", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "hindustani", "book_id": "coloquios_da_orta_1563", "name": "hindustani", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["hindustani", "hind", "hindi"], "contexts": ["language of origin for 'igir'", "language where hai^ah is common"]}, {"entity_id": "hindoo", "book_id": "kosmos_humboldt_1845", "name": "Hindoo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Hindoo"], "contexts": ["related to ancient Indian civilization", "related to Indian civilization"]}, {"entity_id": "hindoos", "book_id": "kosmos_humboldt_1845", "name": "Hindoos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Hindoos"], "contexts": ["people of ancient India"]}, {"entity_id": "buddhist", "book_id": "kosmos_humboldt_1845", "name": "Buddhist", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Buddhist"], "contexts": ["related to Buddhism"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "hindustani", "target_book": "kosmos_humboldt_1845", "target_name": "Hindoo", "similarity": 0.852}, {"source_book": "coloquios_da_orta_1563", "source_name": "hindustani", "target_book": "kosmos_humboldt_1845", "target_name": "Hindoos", "similarity": 0.89}, {"source_book": "coloquios_da_orta_1563", "source_name": "hindustani", "target_book": "kosmos_humboldt_1845", "target_name": "Buddhist", "similarity": 0.842}], "id": 836, "stable_key": "clu_ee9594e5472d800a", "ground_truth": {"modern_name": "Indic languages", "confidence": "high", "type": "concept", "note": "The term 'hindustani' referred to the languages spoken in Hindustan, which encompasses the northern and central Indian subcontinent. 'Hindoo' and 'Hindoos' refer to the people of India, and 'Buddhist' is a religion originating in India. Therefore, 'Indic languages' best captures the linguistic aspect, while acknowledging the broader cultural and ethnic context.", "wikidata_id": "Q33577", "wikidata_description": "branch of the Indo-Iranian languages in the Indo-European language family", "wikipedia_url": "https://en.wikipedia.org/wiki/Indo-Aryan_languages", "wikipedia_extract": "The Indo-Aryan languages (or sometimes Indic languages) are a branch of the Indo-Iranian languages in the Indo-European language family. As of 2024, there are more than 1.5 billion speakers, primarily concentrated east of the Indus River in South Asia, spread across Eastern Pakistan, Northern India, southern Nepal, Bangladesh, Sri Lanka, and Maldives. Moreover, apart from the Indian subcontinent, large immigrant and expatriate Indo-Aryan–speaking communities live in Northwestern Europe, Western Asia, North America, the Caribbean, Southeast Africa, Polynesia and Australia, along with several million speakers of Romani languages primarily concentrated in Southeastern Europe. There are over 200 known Indo-Aryan languages. Modern Indo-Aryan languages descend from Old Indo-Aryan languages such as early Vedic Sanskrit, Sanskrit through Middle Indo-Aryan languages (or Prakrits). The largest such languages in terms of first-speakers are Hindustani (Hindi/Urdu) (c."}}, {"canonical_name": "Aden", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "aden", "book_id": "coloquios_da_orta_1563", "name": "Aden", "category": "PLACE", "subcategory": "CITY", "count": 12, "variants": ["Aden"], "contexts": ["port of call", "origin of goods to Diu"]}, {"entity_id": "aden", "book_id": "kosmos_humboldt_1845", "name": "Aden", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Aden"], "contexts": ["location for monsoon naming"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Aden", "target_book": "kosmos_humboldt_1845", "target_name": "Aden", "similarity": 1.0}], "id": 837, "stable_key": "clu_50e50dc7b3394572", "ground_truth": {"modern_name": "Aden", "confidence": "high", "type": "place", "country": "Yemen", "wikidata_id": "Q131694", "wikidata_description": "port city and temporary capital of Yemen", "wikipedia_url": "https://en.wikipedia.org/wiki/Aden_Colony", "wikipedia_extract": "Aden Colony (Arabic: مُسْتْعَمَرَةْ عَدَنْ, romanized: Musta'marat 'Adan) was a crown colony of the United Kingdom from 1937 to 1963 located in the southern part of modern-day Yemen. It consisted of the port city of Aden and also included the outlying islands of Kamaran, Perim and the Khuria Muria archipelago with a total area of 192 km2 (74 sq mi). Initially a key port for the British East India Company, it was annexed by the British in 1839 to secure maritime routes and prevent piracy in the Arabian Sea. Its strategic position at the entrance to the Red Sea made it a vital stopover for ships traveling between Europe, India, and the Far East, especially after the opening of the Suez Canal in 1869. Aden quickly became a major coaling station and transit hub for British shipping, and its significance to the British Empire grew throughout the 19th and early 20th centuries. Prior to 1937, Aden had been governed as part of British India (originally as the Aden Settlement subordinate to the Bombay Presidency, and then as a Chief Commissioner's province)."}}, {"canonical_name": "panaricio", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "panaricio", "book_id": "polyanthea_medicinal", "name": "panaricio", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 12, "variants": ["panaricio", "Panaricio", "Panaricios", "panarici", "panariciopor", "panaricios"], "contexts": ["infection treated with cat's ear", "whitlow"]}, {"entity_id": "panarizos", "book_id": "historia_medicinal_monardes_1574", "name": "panarizos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["panarizos"], "contexts": ["ailment treated with iron powder"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "panaricio", "target_book": "historia_medicinal_monardes_1574", "target_name": "panarizos", "similarity": 0.937}], "id": 838, "stable_key": "clu_bed4c7c2359ce0de", "ground_truth": {"modern_name": "whitlow", "confidence": "high", "type": "disease", "description": "A painful inflammation or infection of a finger or toe.", "wikipedia_extract": "A whitlow or felon is an infection of the tip of the finger. Herpetic whitlow and melanotic whitlow (subungual melanoma) are subtypes that are not synonymous with the term felon. A felon is an \"extremely painful abscess on the palmar aspect of the fingertip\". Whitlow usually refers to herpetic whitlow, though it can also refer to melanotic whitlow (subungual melanoma), which somewhat resembles acral lentiginous melanoma. The terms whitlow and felon are also sometimes misapplied to paronychia, which is an infection of the tissue at the side or base of the nail. Felon presents clinically with a throbbing pain."}}, {"canonical_name": "cabellos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "cabellos", "book_id": "polyanthea_medicinal", "name": "cabellos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 12, "variants": ["cabellos", "cabell", "cabello", "cabelo"], "contexts": ["hair, a bodily product", "hair used in remedies"]}, {"entity_id": "cabello", "book_id": "historia_medicinal_monardes_1574", "name": "cabello", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["cabello"], "contexts": ["hair"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "cabellos", "target_book": "historia_medicinal_monardes_1574", "target_name": "cabello", "similarity": 0.978}], "id": 839, "stable_key": "clu_08743b486b561b5e", "ground_truth": {"modern_name": "hair", "confidence": "high", "type": "substance", "description": "Filamentous growth from follicles in the skin, used in remedies.", "wikipedia_extract": "Hair is a protein filament that grows from follicles found in the dermis. Hair is one of the defining characteristics of mammals. The human body, apart from areas of glabrous skin, is covered in follicles which produce thick terminal and fine vellus hair. Most common interest in hair is focused on hair growth, hair types, and hair care, but hair is also an important biomaterial primarily composed of protein, notably alpha-keratin. Attitudes towards different forms of hair, such as hairstyles and hair removal, vary widely across different cultures and historical periods, but it is often used to indicate a person's personal beliefs or social position, such as their age, gender, or religion. The word \"hair\" usually refers to two distinct structures: the part beneath the skin, called the hair follicle, or, when pulled from the skin, the bulb or root."}}, {"canonical_name": "gariofilo", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "gariofilo", "book_id": "coloquios_da_orta_1563", "name": "gariofilo", "category": "PLANT", "subcategory": "PLANT", "count": 12, "variants": ["gariofilo", "gariojiloy", "gariojilum", "gariophillon", "garyophyUon", "garyophyllon"], "contexts": ["plant discussed", "bad Latin for gariofilo"]}, {"entity_id": "gariofilata", "book_id": "polyanthea_medicinal", "name": "Gariofilata", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Gariofilata"], "contexts": ["herb used in distilled water"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "gariofilo", "target_book": "polyanthea_medicinal", "target_name": "Gariofilata", "similarity": 0.883}], "id": 840, "stable_key": "clu_58d7b818918b2f01", "ground_truth": {"modern_name": "clove", "confidence": "high", "type": "plant", "linnaean": "Syzygium aromaticum", "family": "Myrtaceae", "description": "An aromatic flower bud used as a spice and in traditional medicine.", "wikipedia_extract": "Cloves are the aromatic flower buds of a tree in the family Myrtaceae, Syzygium aromaticum (). They are native to the Maluku Islands, or Moluccas, in Indonesia, and are commonly used as a spice, flavoring, or fragrance in consumer products, such as toothpaste, soaps, or cosmetics. Cloves are available throughout the year owing to different harvest seasons across various countries. The word clove, first used in English in the 15th century, derives via Middle English clow of gilofer, Anglo-French clowes de gilofre and Old French clou de girofle, from the Latin word clavus \"nail\". The related English word gillyflower, originally meaning \"clove\", derives via said Old French girofle and Latin caryophyllon, from the Greek karyophyllon \"clove\", literally \"nut leaf\". The clove tree is an evergreen that grows up to 8–12 metres (26–39 ft) tall, with large leaves and crimson flowers grouped in terminal clusters."}}, {"canonical_name": "Aypo", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "aypo", "book_id": "polyanthea_medicinal", "name": "Aypo", "category": "PLANT", "subcategory": "PLANT", "count": 11, "variants": ["Aypo", "aypo", "aýpo"], "contexts": ["foodstuff, likely a type of bean or pulse", "plant leaves used in conserve"]}, {"entity_id": "aipo", "book_id": "coloquios_da_orta_1563", "name": "aipo", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["aipo"], "contexts": ["herb", "root used for rectification of remedies"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Aypo", "target_book": "coloquios_da_orta_1563", "target_name": "aipo", "similarity": 0.861}], "id": 841, "stable_key": "clu_3939d53fbea74fe5", "ground_truth": {"modern_name": "aromatic herb", "confidence": "medium", "type": "plant", "description": "A fragrant plant or its leaves, used as food or in remedies.", "note": "The term 'Aypo' and 'aipo' can refer to different plants depending on context, but likely refers to a type of herb or pulse.", "wikipedia_extract": "Essential oils are compodes of hydrophobic volatile organic compounds, usually in liquid form, obtained from plant material. Essential oils are also known as volatile oils, ethereal oils, aetheroleum, or simply as the oil of the plant from which they were extracted, such as oil of clove. An essential oil is essential in the sense that the oil contains the fragrance or essence of the plant. The term \"essential\" used here does not indicate that it is nutritionally required in the diet, as with essential amino acid or essential fatty acid. Essential oils, according to ISO, are produced either by steam distillation, by mechanical manipulation of the rind of the fruits of the genus Citrus (also called cold pressing), or by dry distillation. Other methods, such as solvent extraction, are not accepted and, in fact, result in different perfumed products (pommades, concretes, and absolutes)."}}, {"canonical_name": "húmida", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "húmida", "book_id": "coloquios_da_orta_1563", "name": "húmida", "category": "CONCEPT", "subcategory": "QUALITY", "count": 11, "variants": ["húmida", "humido", "húmidas", "húmido", "úmido"], "contexts": ["quality attributed to camphor", "quality of moisture"]}, {"entity_id": "humdos", "book_id": "polyanthea_medicinal", "name": "humdos", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["humdos"], "contexts": ["moist quality"]}, {"entity_id": "humadif-", "book_id": "polyanthea_medicinal", "name": "humadif-", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["humadif-"], "contexts": ["moist disposition"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "húmida", "target_book": "polyanthea_medicinal", "target_name": "humdos", "similarity": 0.857}, {"source_book": "coloquios_da_orta_1563", "source_name": "húmida", "target_book": "polyanthea_medicinal", "target_name": "humadif-", "similarity": 0.863}], "id": 842, "stable_key": "clu_4e6fcd5ff20dcbee", "ground_truth": {"modern_name": "moist", "confidence": "high", "type": "concept", "description": "A quality of dampness or humidity, often discussed in medical contexts.", "note": "This refers to the quality of being moist or humid, rather than a specific substance.", "wikipedia_extract": "Humorism, the humoral theory, or humoralism, was a system of medicine detailing a supposed makeup and workings of the human body, adopted by Ancient Greek and Roman physicians and philosophers. Humorism began to fall out of favor in the 17th century and it was definitively disproved with the discovery of microbes. The concept of \"humors\" may have origins in Ancient Egyptian medicine, or Mesopotamia, though it was not systemized until ancient Greek thinkers. The word humor is a translation of Greek χυμός, chymos (literally 'juice' or 'sap', metaphorically 'flavor'). Early texts on Indian Ayurveda medicine presented a theory of three or four humors (doṣas), which they sometimes linked with the five elements (pañca-bhūta): earth, water, fire, air, and space. The concept of \"humors\" (chemical systems regulating human behaviour) became more prominent from the writing of medical theorist Alcmaeon of Croton (c. 540–500 BC)."}}, {"canonical_name": "melancia", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "melancia", "book_id": "polyanthea_medicinal", "name": "melancia", "category": "PLANT", "subcategory": "PLANT", "count": 9, "variants": ["melancia", "Melancia", "melancias"], "contexts": ["seeds used for refreshing and cleansing kidneys", "watermelon used in remedy"]}, {"entity_id": "melancia", "book_id": "coloquios_da_orta_1563", "name": "melancia", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["melancia", "melancias"], "contexts": ["one of the four great cold seeds", "Portuguese name for water melon"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "melancia", "target_book": "coloquios_da_orta_1563", "target_name": "melancia", "similarity": 1.0}], "id": 843, "stable_key": "clu_c6d5e75ec4049478", "ground_truth": {"modern_name": "watermelon", "confidence": "high", "type": "plant", "linnaean": "Citrullus lanatus", "family": "Cucurbitaceae", "description": "A large, sweet fruit with a hard rind, often used for its cooling properties.", "wikipedia_extract": "The watermelon (Citrullus lanatus) is a species of flowering plant in the family Cucurbitaceae, that has a large, edible fruit. It is a scrambling and trailing vine-like plant, and is widely cultivated worldwide, with more than 1,000 varieties. Watermelons are grown in favorable climates from tropical to temperate regions worldwide for its large edible fruit, which is a berry with a hard rind and no internal divisions, and is botanically called a pepo. The sweet, juicy flesh is usually deep red to pink, with many seeds that are black when mature, white when immature. Seedless varieties also exist. The fruit can be eaten raw or pickled, and the rind is edible after cooking."}}, {"canonical_name": "Thomas Rodriguez", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "thomas_rodriguez", "book_id": "polyanthea_medicinal", "name": "Thomas Rodriguez", "category": "PERSON", "subcategory": "SCHOLAR", "count": 10, "variants": ["Thomas Rodriguez", "Thom. Rodrig. àVeig.", "Thomas Rodriguez daVeyga", "Thomás Rodriguez da Veyga"], "contexts": ["author of Practica Medica", "Thomas Rodriguez on apoplexy"]}, {"entity_id": "thomaz_rodrigues", "book_id": "coloquios_da_orta_1563", "name": "Thomaz Rodrigues", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Thomaz Rodrigues", "Thomas Rodrigues"], "contexts": ["professor de medicina", "recipient of letter"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Thomas Rodriguez", "target_book": "coloquios_da_orta_1563", "target_name": "Thomaz Rodrigues", "similarity": 0.879}], "id": 844, "stable_key": "clu_27c4d95fbd69139c", "ground_truth": {"modern_name": "Tomás Rodríguez", "confidence": "high", "type": "person", "description": "A physician and medical writer prominent in the early modern period.", "wikipedia_extract": "Tomás Abdiel Rodríguez Mena (born 9 March 1999) is a Panamanian footballer who plays as a forward for Monagas and Panama national team. In 2024, Rodríguez signed for Venezuelan side Monagas. He was regarded as one of the club's most important players. Rodríguez is a Panama international. He played his first FIFA matches for the Panama national team during friendlies against Guatemala and Nicaragua. He scored his first goal for Panama in the 2025 Gold Cup against Guadeloupe."}}, {"canonical_name": "perdizes", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "perdizes", "book_id": "polyanthea_medicinal", "name": "perdizes", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 10, "variants": ["perdizes", "Perdizes", "as perdizes", "perdidzes", "perdigotos"], "contexts": ["birds that are prepared before eating", "food item"]}, {"entity_id": "perdiz", "book_id": "coloquios_da_orta_1563", "name": "perdiz", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 3, "variants": ["perdiz", "perdi^", "perdizes"], "contexts": ["partridge, a food item", "food for the sick"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "perdizes", "target_book": "coloquios_da_orta_1563", "target_name": "perdiz", "similarity": 0.917}], "id": 845, "stable_key": "clu_ce49f2555b6c835c", "ground_truth": {"modern_name": "Partridge", "confidence": "high", "type": "animal", "description": "A game bird, often prepared as food.", "wikipedia_extract": "A partridge is a medium-sized galliform bird in any of several genera, with a wide native distribution throughout parts of Europe, Asia and Africa. Several species have been introduced to the Americas. They are sometimes grouped in the Perdicinae subfamily of the Phasianidae (pheasants, quail, etc.). However, molecular research suggests that partridges are not a distinct taxon within the superfamily Phasianoidea, but that some species are closer to the pheasants, while others are closer to the junglefowl. Partridges are medium-sized game birds, generally intermediate in size between the larger pheasants and smaller quail; they're ground-dwelling birds that feature variable plumage colouration across species, with most tending to grey and brown. Partridges are native to Europe, Asia, Africa, and the Middle East."}}, {"canonical_name": "mannà", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "mannà", "book_id": "polyanthea_medicinal", "name": "mannà", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 9, "variants": ["mannà", "Mannà", "Manná", "manná"], "contexts": ["substance used in preparation", "purgative substance"]}, {"entity_id": "ma", "book_id": "coloquios_da_orta_1563", "name": "Ma", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["ma", "Ma"], "contexts": ["Arabic word for of the", "word for myrrh in India"]}, {"entity_id": "mannáy", "book_id": "coloquios_da_orta_1563", "name": "mannáy", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["mannáy"], "contexts": ["semi-animal, semi-vegetable substance"]}, {"entity_id": "manna", "book_id": "coloquios_da_orta_1563", "name": "manna", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["manna"], "contexts": ["sweet exudation from plants/insects"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "mannà", "target_book": "coloquios_da_orta_1563", "target_name": "mannáy", "similarity": 0.935}, {"source_book": "polyanthea_medicinal", "source_name": "mannà", "target_book": "coloquios_da_orta_1563", "target_name": "manna", "similarity": 0.888}], "id": 846, "stable_key": "clu_6024bc0cdae8b44c", "ground_truth": {"modern_name": "Manna", "confidence": "high", "type": "substance", "description": "A sweet exudation from plants or insects, used medicinally.", "note": "Refers to the medicinal substance derived from certain plants/insects, not the biblical manna.", "wikipedia_extract": "Manna (Hebrew: מָן, romanized: mān, Greek: μάννα; Arabic: اَلْمَنُّ), sometimes or archaically spelled mana, is described in the Bible and the Quran as an edible substance that God bestowed upon the Israelites while they were wandering the desert during the 40-year period that followed the Exodus and preceded the conquest of Canaan. In the Hebrew Bible, manna is described twice: once in Exodus 16:1–36 with the full narrative surrounding it, and once again in Numbers 11:1–9 as a part of a separate narrative. In the description in the Book of Exodus, manna is described as being \"a fine, flake-like thing\" like the frost on the ground. It is described in the Book of Numbers as arriving with the dew during the night. Exodus adds that it had to be collected before it was melted by the heat of the Sun, and that it was like a coriander seed in size, but white in colour. Numbers describes it as having the appearance of bdellium, adding that the Israelites ground it and pounded it into cakes, which were then baked, resulting in something that tasted like cakes baked with oil."}}, {"canonical_name": "Mefue", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "mefue", "book_id": "ricettario_fiorentino_1597", "name": "Mefue", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 11, "variants": ["Mefue"], "contexts": ["authority on plants", "medieval physician"]}, {"entity_id": "me", "book_id": "polyanthea_medicinal", "name": "Me", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 2, "variants": ["Me"], "contexts": ["ancient medical authority", "physician"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Mefue", "target_book": "polyanthea_medicinal", "target_name": "Me", "similarity": 0.777}], "id": 847, "stable_key": "clu_526ed43837cba4a7", "ground_truth": {"modern_name": "Mefue", "confidence": "medium", "type": "person", "description": "An early modern medical authority or physician.", "note": "The identity of 'Mefue' and 'Me' is uncertain; could refer to specific figures or generic terms for physicians."}}, {"canonical_name": "Alexipharmacum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "alexipharmacum", "book_id": "polyanthea_medicinal", "name": "Alexipharmacum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 9, "variants": ["Alexipharmacum", "adalexipharmaca", "alexipharmac", "alexipharmaca", "alexipharmacos", "alexipharmacum"], "contexts": ["remedy against poison", "remedy for plague"]}, {"entity_id": "alexipharmaca", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Alexipharmaca", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Alexipharmaca"], "contexts": ["work by Nicander on venemous beasts and antidotes"]}, {"entity_id": "alexiphar", "book_id": "polyanthea_medicinal", "name": "Alexiphar", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Alexiphar"], "contexts": ["divine alexipharmic medicine", "protective preparation"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Alexipharmacum", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Alexipharmaca", "similarity": 0.968}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Alexipharmaca", "target_book": "polyanthea_medicinal", "target_name": "Alexiphar", "similarity": 0.821}], "id": 848, "stable_key": "clu_0ee7584da72d2d83", "ground_truth": {"modern_name": "Alexipharmic", "confidence": "high", "type": "concept", "note": "Alexipharmacum/Alexipharmaca/Alexiphar refers to a substance or remedy that protects against poison or venom. It is a concept rather than a specific chemical or preparation.", "wikidata_id": "Q194168", "wikidata_description": "substance that can counteract a form of poisoning", "wikipedia_url": "https://en.wikipedia.org/wiki/Antidote", "wikipedia_extract": "Justus de Harduwijn, also written Hardwijn, Herdewijn, Harduyn or Harduijn (11 April 1582 – 21 June 1636 in Oudegem), was a 17th-century Roman Catholic priest and poet from the Southern Netherlands. He was the poetic link between the Renaissance and the Counter-Reformation in the Netherlands. De Harduwijn was born in a humanist, intellectual family in Ghent. His grandfather Thomas was a steward to Louis of Praet. His father Franciscus owned a bookbinding shop in Ghent and was a member of the Council of Flanders, the highest judicial college in the County of Flanders. His father was a friend of writer Jan van der Noot who had introduced him to the French poets of La Pléiade, and is said to have been the first translator of Anacreon into Dutch."}}, {"canonical_name": "Greenwich", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "greenwich", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Greenwich", "category": "PLACE", "subcategory": "CITY", "count": 10, "variants": ["Greenwich"], "contexts": ["meridian for time computation", "meridian for astronomical computations"]}, {"entity_id": "greenwich", "book_id": "kosmos_humboldt_1845", "name": "Greenwich", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Greenwich"], "contexts": ["location of Observatory"]}, {"entity_id": "greenwich_time", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Greenwich time", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Greenwich time"], "contexts": ["standard time zone"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Greenwich", "target_book": "kosmos_humboldt_1845", "target_name": "Greenwich", "similarity": 0.872}, {"source_book": "kosmos_humboldt_1845", "source_name": "Greenwich", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Greenwich time", "similarity": 0.845}], "id": 849, "stable_key": "clu_a956ab02787307a0", "ground_truth": {"modern_name": "Greenwich", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q693450", "wikidata_description": "royal borough in the London Region in England", "wikipedia_url": "https://en.wikipedia.org/wiki/Royal_Borough_of_Greenwich"}}, {"canonical_name": "Guts", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "guts", "book_id": "english_physician_1652", "name": "Guts", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 7, "variants": ["Guts"], "contexts": ["intestinal organs", "internal body part"]}, {"entity_id": "guelade", "book_id": "polyanthea_medicinal", "name": "guelade", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["guelade", "Guèla", "guela"], "contexts": ["gullet", "throat"]}, {"entity_id": "gutturis", "book_id": "polyanthea_medicinal", "name": "gutturis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["gutturis", "guttur"], "contexts": ["throat", "throat, affected by inflammation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Guts", "target_book": "polyanthea_medicinal", "target_name": "guelade", "similarity": 0.862}, {"source_book": "english_physician_1652", "source_name": "Guts", "target_book": "polyanthea_medicinal", "target_name": "gutturis", "similarity": 0.874}], "id": 850, "stable_key": "clu_6e7fd2cba8054a28", "ground_truth": {"modern_name": "Throat", "confidence": "high", "type": "anatomy", "description": "The anatomical part of the neck including the gullet.", "note": "Includes 'Guts' referring to intestinal organs, and 'guelade'/'gutturis' referring to the throat.", "wikipedia_extract": "In vertebrate anatomy, the throat is the front part of the neck, internally positioned in front of the vertebrae. It contains the pharynx and larynx. An important section of it is the epiglottis, separating the esophagus from the trachea (windpipe), preventing food and drinks being inhaled into the lungs. The throat contains various blood vessels, pharyngeal muscles, the nasopharyngeal tonsil, the tonsils, the palatine uvula, the trachea, the esophagus, and the vocal cords. Mammal throats consist of two bones, the hyoid bone and the clavicle. The \"throat\" is sometimes thought to be synonymous for the fauces."}}, {"canonical_name": "Japura", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "japura", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Japura", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 11, "variants": ["Japura", "Jupura", "Yupura"], "contexts": ["river forming a boundary", "river in South America"]}, {"entity_id": "japonica", "book_id": "polyanthea_medicinal", "name": "Japonica", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Japonica"], "contexts": ["related to a relatione"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Japura", "target_book": "polyanthea_medicinal", "target_name": "Japonica", "similarity": 0.852}], "id": 851, "stable_key": "clu_9c9b98d24b1f70f7", "ground_truth": {"modern_name": "Japurá River", "confidence": "high", "type": "place", "description": "A major river in the Amazon basin, forming a boundary in South America.", "note": "The mention of 'Japonica' in relatione is likely an erroneous transcription or a rare usage referring to something related to Japan, but the context strongly points to the South American river.", "wikipedia_extract": "The Japurá River or Caquetá River is a 2,820 kilometres (1,750 mi) long river in the Amazon basin. It rises in Colombia and flows eastward through Brazil to join the Amazon River. The river rises as the Caquetá River in the Andes in southwest Colombia. The Caquetá River rises near the sources of the Magdalena River, and augments its volume from many branches as it courses through Colombia. It flows southeast into Brazil, where it is called the Japurá. The Japurá enters the Amazon River through a network of channels."}}, {"canonical_name": "nose", "category": "ANATOMY", "subcategory": "BODY_PART", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "nose", "book_id": "principles_of_psychology_james_1890", "name": "nose", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 7, "variants": ["nose"], "contexts": ["organ for smelling and breathing", "part of the face"]}, {"entity_id": "nostrils", "book_id": "origin_of_species_darwin_1859", "name": "nostrils", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 3, "variants": ["nostrils"], "contexts": ["part of pigeon anatomy", "openings for breathing"]}, {"entity_id": "nostril", "book_id": "origin_of_species_darwin_1859", "name": "nostril", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["nostril"], "contexts": ["measured length of bird's nostril"]}, {"entity_id": "neck", "book_id": "origin_of_species_darwin_1859", "name": "neck", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["neck"], "contexts": ["part connecting head and body"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "nose", "target_book": "origin_of_species_darwin_1859", "target_name": "nostrils", "similarity": 0.896}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nose", "target_book": "origin_of_species_darwin_1859", "target_name": "nostril", "similarity": 0.892}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nose", "target_book": "origin_of_species_darwin_1859", "target_name": "neck", "similarity": 0.842}], "id": 852, "stable_key": "clu_ac3bdd8e4e81193a", "ground_truth": {"modern_name": "nose", "confidence": "medium", "type": "anatomy", "description": "The part of the face used for smelling and breathing.", "note": "Cluster includes related terms like nostrils, but also 'neck' which seems out of place and may indicate an error in the original clustering or a very loose association.", "wikipedia_extract": "A nose is a sensory organ and respiratory structure in vertebrates. It consists of a nasal cavity inside the head, and an external nose on the face. The external nose houses the nostrils, or nares, a pair of tubes providing airflow through the nose for respiration. Where the nostrils pass through the nasal cavity they widen, are known as nasal fossae, and contain turbinates and olfactory mucosa. The nasal cavity also connects to the paranasal sinuses (dead-end air cavities for pressure buffering and humidification). From the nasal cavity, the nostrils continue into the pharynx, a switch track valve connecting the respiratory and digestive systems."}}, {"canonical_name": "Payta", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "payta", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Payta", "category": "PLACE", "subcategory": "CITY", "count": 11, "variants": ["Payta", "Paita", "Paytas"], "contexts": ["port touched by Duperrey", "city on the coast of Peru"]}, {"entity_id": "payta", "book_id": "kosmos_humboldt_1845", "name": "Payta", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Payta"], "contexts": ["shore south of this location"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Payta", "target_book": "kosmos_humboldt_1845", "target_name": "Payta", "similarity": 1.0}], "id": 853, "stable_key": "clu_a62d5b1e7962a3c1", "ground_truth": {"modern_name": "Paita", "confidence": "high", "type": "place", "country": "Peru", "wikidata_id": "Q37443777", "wikidata_description": "family name", "wikipedia_extract": "Paita is a city in northwestern Peru. It is the capital of the Paita Province which is in the Piura Region. It is a leading seaport in the region. Paita is located 1,089 km northwest of the country's capital Lima, and 57 km northwest of the regional capital of Piura. Starting in 2014, the city has considered ideas for separating from the Piura Region, proclaiming itself as the \"Miguel Grau Region\". Paita is located at 05°05′28″S 81°06′23″W on a small peninsula south of the mouth of the Río Chira on an area of 1,785 km2."}}, {"canonical_name": "olivine", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "olivine", "book_id": "kosmos_humboldt_1845", "name": "olivine", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 10, "variants": ["olivine"], "contexts": ["mineral found in meteoric stones", "mineral found in aërolites"]}, {"entity_id": "olivine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "olivine", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["olivine"], "contexts": ["mineral found in rocks", "crystal not found in phonolithe"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "olivine", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "olivine", "similarity": 1.0}], "id": 854, "stable_key": "clu_37b9a4e3a5d3983b", "ground_truth": {"modern_name": "Olivine", "confidence": "high", "type": "mineral", "wikidata_id": "Q7088210", "wikidata_description": "river in New Zealand", "wikipedia_extract": "The mineral olivine () is a magnesium iron silicate with the chemical formula (Mg,Fe)2SiO4. It is a type of nesosilicate or orthosilicate. The primary component of the Earth's upper mantle, it is a common mineral in Earth's subsurface, but weathers quickly on the surface. Olivine has many uses, such as the gemstone peridot (or chrysolite), as well as industrial applications like metalworking processes. The ratio of magnesium to iron varies between the two endmembers of the solid solution series: forsterite (Mg-endmember: Mg2SiO4) and fayalite (Fe-endmember: Fe2SiO4). Compositions of olivine are commonly expressed as molar percentages of forsterite (Fo) and/or fayalite (Fa) (e.g., Fo70Fa30, or just Fo70 with Fa30 implied).", "wikipedia_url": "https://en.wikipedia.org/wiki/Olivine"}}, {"canonical_name": "Sahara", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "sahara", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sahara", "category": "PLACE", "subcategory": "REGION", "count": 9, "variants": ["Sahara"], "contexts": ["Sahara desert", "large desert in North Africa"]}, {"entity_id": "sahara_desert", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Sahara desert", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Sahara desert"], "contexts": ["large desert in North Africa", "large desert in Africa"]}, {"entity_id": "sahara", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Sahara", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Sahara"], "contexts": ["causing monsoons"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sahara", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Sahara desert", "similarity": 0.94}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sahara", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Sahara", "similarity": 1.0}], "id": 855, "stable_key": "clu_4e7d97462e650141", "ground_truth": {"modern_name": "Sahara Desert", "confidence": "high", "type": "place", "country": "Algeria, Chad, Egypt, Libya, Mali, Mauritania, Morocco, Niger, Sudan, Tunisia, Western Sahara", "wikidata_id": "Q1717126", "wikidata_description": "species of insect", "wikipedia_extract": "The Sahara (, ) is a desert spanning across North Africa. With an area of 9,200,000 square kilometres (3,600,000 sq mi), it is the largest hot desert in the world and the third-largest desert overall, smaller only than the deserts of Antarctica and the northern Arctic. The name \"Sahara\" is derived from Arabic: صَحَارَى, romanized: ṣaḥārā /sˤaħaːraː/, a broken plural form of ṣaḥrā' (صَحْرَاء /sˤaħraːʔ/), meaning \"desert\". The desert covers much of North Africa, excluding the fertile region on the Mediterranean Sea coast, the Atlas Mountains of the Maghreb, and the Nile Valley in Egypt and the Sudan. It stretches from the Red Sea in the east and the Mediterranean in the north to the Atlantic Ocean in the west, where the landscape gradually changes from desert to coastal plains. To the south it is bounded by the Sahel, a belt of semi-arid tropical savanna around the Niger River valley and the Sudan region of sub-Saharan Africa.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sahara_Desert_ant"}}, {"canonical_name": "Lapland", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "lapland", "book_id": "kosmos_humboldt_1845", "name": "Lapland", "category": "PLACE", "subcategory": "REGION", "count": 6, "variants": ["Lapland"], "contexts": ["region where observations were made", "location of observations by Bravais and Lottin"]}, {"entity_id": "lapland", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Lapland", "category": "PLACE", "subcategory": "REGION", "count": 6, "variants": ["Lapland"], "contexts": ["location of arc measurement", "location of Wardhus observation"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Lapland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Lapland", "similarity": 1.0}], "id": 856, "stable_key": "clu_fdcbac450223a15d", "ground_truth": {"modern_name": "Lapland", "confidence": "high", "type": "place", "country": "Finland, Norway, Russia, Sweden", "wikidata_id": "Q5700", "wikidata_description": "region of Finland", "wikipedia_url": "https://en.wikipedia.org/wiki/Lapland_%28Finland%29"}}, {"canonical_name": "onça", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "onça", "book_id": "polyanthea_medicinal", "name": "onça", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 9, "variants": ["onça"], "contexts": ["ounce", "measure of weight"]}, {"entity_id": "oncia", "book_id": "ricettario_fiorentino_1597", "name": "oncia", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["oncia"], "contexts": ["ounce", "unit of weight"]}, {"entity_id": "huma_onça", "book_id": "polyanthea_medicinal", "name": "huma onça", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["huma onça"], "contexts": ["one ounce"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "onça", "target_book": "ricettario_fiorentino_1597", "target_name": "oncia", "similarity": 0.956}, {"source_book": "ricettario_fiorentino_1597", "source_name": "oncia", "target_book": "polyanthea_medicinal", "target_name": "huma onça", "similarity": 0.841}], "id": 857, "stable_key": "clu_9276b17153f3c5e1", "ground_truth": {"modern_name": "ounce", "confidence": "high", "type": "object", "description": "A unit of weight, commonly 1/12th of a pound.", "wikipedia_extract": "The  ounce () is any of several different units of mass, weight, or volume and is derived almost unchanged from the uncia, an Ancient Roman unit of measurement. The avoirdupois ounce (exactly 28.349523125 g) is 1⁄16 avoirdupois pound; this is the United States customary and British imperial ounce. It is primarily used in the United States. Although the avoirdupois ounce is the mass measure used for most purposes, the 'troy ounce' of exactly 31.1034768 g is used instead for the mass of precious metals such as gold, silver, platinum, palladium, rhodium, etc. The term 'ounce' is also used in other contexts: The ounce-force is a measure of force (see below). Historically, a variety of different ounces measuring mass or volume were used in different jurisdictions by different trades and at different times in history."}}, {"canonical_name": "Methodo Medendi", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "methodo_medendi", "book_id": "polyanthea_medicinal", "name": "Methodo Medendi", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 10, "variants": ["Methodo Medendi", "Method. Medend.", "Methodi", "Methodi Medendi", "Methodo medendi", "lib . 4.33methodi medendi", "methodi", "methodo vitan"], "contexts": ["title of a medical work", "medical treatise title"]}, {"entity_id": "methodo", "book_id": "historia_medicinal_monardes_1574", "name": "Methodo", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["methodo", "Methodo"], "contexts": ["method of treatment", "title of a work by Galen"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Methodo Medendi", "target_book": "historia_medicinal_monardes_1574", "target_name": "Methodo", "similarity": 0.885}], "id": 858, "stable_key": "clu_df7428b86d5be9a5", "ground_truth": {"modern_name": "Methodus Medendi", "confidence": "high", "type": "object", "description": "A medical treatise, likely referencing Galen's work on healing methods.", "note": "The original text might have variations in Latin spelling like 'Methodo Medendi'.", "wikipedia_extract": "The history of scientific method considers changes in the methodology of scientific inquiry, as distinct from the history of science itself. The development of rules for scientific reasoning has not been straightforward; scientific method has been the subject of intense and recurring debate throughout the history of science, and eminent natural philosophers and scientists have argued for the primacy of one or another approach to establishing scientific knowledge. Rationalist explanations of nature, including atomism, appeared both in ancient Greece in the thought of Leucippus and Democritus, and in ancient India, in the Nyaya, Vaisheshika and Buddhist schools, while Charvaka materialism rejected inference as a source of knowledge in favour of an empiricism that was always subject to doubt. Aristotle pioneered scientific method in ancient Greece alongside his empirical biology and his work on logic, rejecting a purely deductive framework in favour of generalisations made from observations of nature. Some of the most important debates in the history of scientific method center on: rationalism, especially as advocated by René Descartes; inductivism, which rose to particular prominence with Isaac Newton and his followers; and hypothetico-deductivism, which came to the fore in the early 19th century. In the late 19th and early 20th centuries, a debate over realism vs. antirealism was central to discussions of scientific method as powerful scientific theories extended beyond the realm of the observable, while in the mid-20th century some prominent philosophers argued against any universal rules of science at all."}}, {"canonical_name": "Scoria de metalli", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "scoria_de_metalli", "book_id": "ricettario_fiorentino_1597", "name": "Scoria de metalli", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 10, "variants": ["Scoria de metalli", "Scaglia de metalli"], "contexts": ["dross or slag from metals", "mineral residue from metals"]}, {"entity_id": "escorias_de_ferro", "book_id": "polyanthea_medicinal", "name": "escorias de ferro", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["escorias de ferro"], "contexts": ["iron dross", "iron slag used in astringent wine"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Scoria de metalli", "target_book": "polyanthea_medicinal", "target_name": "escorias de ferro", "similarity": 0.854}], "id": 859, "stable_key": "clu_bc37e244fcf949ba", "ground_truth": {"modern_name": "metal dross", "confidence": "high", "type": "substance", "description": "The impure residue or slag obtained from smelting metals.", "wikipedia_extract": "Lead ( ) is a chemical element with the symbol Pb (from the Latin plumbum) and atomic number 82. It is a heavy metal, denser than most common materials. Lead is soft, malleable, and has a relatively low melting point. When freshly cut or melted, it appears shiny silvery with a bluish tint, but tarnishes to dull gray on exposure to air. Lead has the highest atomic number of any stable element, and three of its isotopes are endpoints of major nuclear decay chains of heavier elements. Lead is a relatively unreactive post-transition metal."}}, {"canonical_name": "Salamanca", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "salamanca", "book_id": "coloquios_da_orta_1563", "name": "Salamanca", "category": "PLACE", "subcategory": "CITY", "count": 7, "variants": ["Salamanca"], "contexts": ["city where author and Ruano knew each other", "city where Ruano was educated"]}, {"entity_id": "salamanca", "book_id": "polyanthea_medicinal", "name": "Salamanca", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Salamanca", "Salamnaca"], "contexts": ["city where Pedroza was a professor", "city where Luis Rodriguez Pedrofa was a physician"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Salamanca", "target_book": "polyanthea_medicinal", "target_name": "Salamanca", "similarity": 1.0}], "id": 860, "stable_key": "clu_d5b8d2fe77c93ef7", "ground_truth": {"modern_name": "Salamanca", "confidence": "high", "type": "place", "description": "Historic university city in Spain.", "wikipedia_extract": "Salamanca (Spanish: [salaˈmaŋka] ) is a municipality and city in the autonomous community of Castile and León in Spain, and the capital of the province of Salamanca. Attached to the comarca of Campo Charro, the city lies on the northern half of the Meseta Central, in the western-central part of the Iberian Peninsula, straddling the Tormes river. As of 2024, with a population of 144,458, Salamanca is the 46th-largest municipality in Spain. The Iron Age hilltop site of Cerro de San Vicente on the right bank of the Tormes is considered as the first human settlement in the current-day city. By the 3rd century BCE, the urban settlement in the nearby Teso de las Catedrales had consolidated, under the influence of Vaccaei and Vettones. Following Roman subjugation, the indigenous oppidum gradually became the Roman civitas of Salmantica."}}, {"canonical_name": "Celsus", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "celsus", "book_id": "polyanthea_medicinal", "name": "Celsus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 10, "variants": ["Celsus"], "contexts": ["ancient medical authority on maintaining health", "ancient authority"]}, {"entity_id": "celso", "book_id": "coloquios_da_orta_1563", "name": "Celso", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Celso"], "contexts": ["ancient physician who studied cholera", "ancient author discussing lycium"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Celsus", "target_book": "coloquios_da_orta_1563", "target_name": "Celso", "similarity": 0.949}], "id": 861, "stable_key": "clu_772e4f9a92d2858a", "ground_truth": {"modern_name": "Aulus Cornelius Celsus", "confidence": "high", "type": "person", "description": "Roman encyclopedist and medical writer.", "wikipedia_extract": "Aulus Cornelius Celsus (c. 25 BC – c. 50 AD) was a Roman encyclopedist, known for his extant medical work, De Medicina, which is believed to be the only surviving section of a much larger encyclopedia. The De Medicina is a primary source on diet, pharmacy, surgery and related fields, and it is one of the best sources concerning medical knowledge in the Roman world. The lost portions of his encyclopedia likely included volumes on agriculture, law, rhetoric, and military arts. He made contributions to the classification of human skin disorders in  dermatology, such as myrmecia, and his name is often found in medical terminology regarding the skin, e.g., kerion celsi and area celsi. He is also the namesake of Paracelsus (lit. Above Celsus), a great Swiss alchemist and physician prevalent in the Medical Renaissance."}}, {"canonical_name": "çumo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "çumo", "book_id": "polyanthea_medicinal", "name": "çumo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 10, "variants": ["çumo", "çumo de chicoria", "çumos"], "contexts": ["juice", "juice of turnips"]}, {"entity_id": "çumo_cirinaico", "book_id": "coloquios_da_orta_1563", "name": "çumo cirinaico", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["çumo cirinaico"], "contexts": ["alternative name for the root's sap"]}, {"entity_id": "çumo_de_cevada", "book_id": "coloquios_da_orta_1563", "name": "çumo de cevada", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["çumo de cevada"], "contexts": ["preparation used to relieve pain in rhinoceros"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "çumo", "target_book": "coloquios_da_orta_1563", "target_name": "çumo cirinaico", "similarity": 0.845}, {"source_book": "polyanthea_medicinal", "source_name": "çumo", "target_book": "coloquios_da_orta_1563", "target_name": "çumo de cevada", "similarity": 0.839}], "id": 862, "stable_key": "clu_08003172dcefe345", "ground_truth": {"modern_name": "Juice", "confidence": "high", "type": "substance", "description": "Liquid extracted from fruits, vegetables, or roots.", "note": "Refers to the liquid extract or sap of a plant or other substance.", "wikipedia_extract": "Juice is a drink made from the extraction or pressing of the natural liquid contained in fruit and vegetables. It can also refer to liquids that are flavored with concentrate or other biological food sources like meat or seafood, such as clam juice. Juice is commonly consumed as a beverage or used as an ingredient or flavoring in foods or other beverages, such as smoothies. Juice emerged as a popular beverage choice after the development of pasteurization methods enabled its preservation without using fermentation (which is used in wine production). The largest fruit juice consumers are New Zealand (nearly a cup, or 8 ounces, each day) and Colombia (more than three quarters of a cup each day). Fruit juice consumption on average increases with a country's income level."}}, {"canonical_name": "almeyrão", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "almeyrão", "book_id": "polyanthea_medicinal", "name": "almeyrão", "category": "PLANT", "subcategory": "PLANT", "count": 11, "variants": ["almeyrão", "Almeyrões", "almedega", "almeyra", "almeyraó", "almeyraõ", "almeyraō", "almeyroens", "almeyroés", "almeyrões"], "contexts": ["ingredient in syrups", "a plant, likely marjoram"]}, {"entity_id": "almeirões", "book_id": "coloquios_da_orta_1563", "name": "almeirões", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["almeirões"], "contexts": ["ingredient in medicine"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "almeyrão", "target_book": "coloquios_da_orta_1563", "target_name": "almeirões", "similarity": 0.898}], "id": 863, "stable_key": "clu_10b5159e8f2b08f9", "ground_truth": {"modern_name": "Marjoram", "confidence": "high", "type": "plant", "description": "Aromatic herb used in cooking and traditional medicine.", "note": "Likely refers to Origanum majorana or a related species.", "wikipedia_extract": "Marjoram (, Origanum majorana) is a cold-sensitive perennial herb or undershrub with sweet pine and citrus flavours. In some Middle Eastern countries, marjoram is synonymous with oregano, and there the names sweet marjoram and knotted marjoram are used to distinguish it from other plants of the genus Origanum. It is also called pot marjoram, although this name is also used for other cultivated species of Origanum. Marjoram is indigenous to Cyprus, the Mediterranean, Turkey, Western Asia, the Arabian Peninsula, and the Levant, and was known to the ancient Greeks and Romans as a symbol of happiness. It may have spread to the British Isles during the Middle Ages. Marjoram was not widely used in the United States until after World War II."}}, {"canonical_name": "saliva", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "saliva", "book_id": "polyanthea_medicinal", "name": "saliva", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 11, "variants": ["saliva", "Saliva", "Saliva humana", "salivação"], "contexts": ["bodily fluid", "bodily fluid involved in digestion"]}, {"entity_id": "saliva", "book_id": "coloquios_da_orta_1563", "name": "saliva", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["saliva"], "contexts": ["animal's saliva used for preparation"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "saliva", "target_book": "coloquios_da_orta_1563", "target_name": "saliva", "similarity": 1.0}], "id": 864, "stable_key": "clu_be3655d65f8a90d9", "ground_truth": {"modern_name": "Saliva", "confidence": "high", "type": "substance", "description": "The watery fluid secreted in the mouth by salivary glands.", "wikipedia_extract": "Saliva (commonly referred to as spit, drool or slobber) is an extracellular fluid produced and secreted by salivary glands in the mouth. In humans, saliva is around 99% water, plus electrolytes, mucus, white blood cells, epithelial cells (from which DNA can be extracted), enzymes (such as lingual lipase and amylase), and antimicrobial agents (such as secretory IgA, and lysozymes). The enzymes found in saliva are essential in beginning the process of digestion of dietary starches and fats. These enzymes also play a role in breaking down food particles trapped within dental crevices, thus protecting teeth from bacterial decay. Saliva also performs a lubricating function, wetting food and permitting the initiation of swallowing, and protecting the oral mucosa from drying out. Saliva has specialized purposes for a variety of animal species beyond predigestion."}}, {"canonical_name": "Crocus Martis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "crocus_martis", "book_id": "polyanthea_medicinal", "name": "Crocus Martis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 10, "variants": ["Crocus Martis", "croco martis", "crocus martis"], "contexts": ["Crocus Martis, iron preparation", "aperitive substance"]}, {"entity_id": "crocus_martis", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Crocus Martis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Crocus Martis"], "contexts": ["steel corroded and reverberated"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Crocus Martis", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Crocus Martis", "similarity": 1.0}], "id": 865, "stable_key": "clu_1a67cdca5c8931fe", "ground_truth": {"modern_name": "Iron preparations", "confidence": "high", "type": "chemical", "note": "Refers to preparations of iron or steel, often corroded or reverberated, used medicinally."}}, {"canonical_name": "Banda", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "banda", "book_id": "coloquios_da_orta_1563", "name": "Banda", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 10, "variants": ["Banda"], "contexts": ["region where clove is merchandise", "island group to be discovered"]}, {"entity_id": "banda", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Banda", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Banda"], "contexts": ["isle where nutmeg tree fructifies"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Banda", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Banda", "similarity": 1.0}], "id": 866, "stable_key": "clu_7e1c88b386c2c72f", "ground_truth": {"modern_name": "Banda Islands", "confidence": "high", "type": "place", "country": "Indonesia", "note": "Historically a major source of nutmeg and mace.", "wikidata_id": "Q739411", "wikidata_description": "island group in Indonesia", "wikipedia_url": "https://en.wikipedia.org/wiki/Banda%20Islands"}}, {"canonical_name": "Amomum", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "amomum", "book_id": "coloquios_da_orta_1563", "name": "Amomum", "category": "PLANT", "subcategory": "PLANT", "count": 10, "variants": ["Amomum", "Amomum Koraríma", "Amomum korarima", "amamum", "amomum"], "contexts": ["ingredient for theriac", "ingredient for compositions"]}, {"entity_id": "amomum", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Amomum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Amomum"], "contexts": ["plant mistaken for Rose"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Amomum", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Amomum", "similarity": 0.914}], "id": 867, "stable_key": "clu_49fb8a02aa3e81be", "ground_truth": {"modern_name": "Amomum", "confidence": "high", "type": "plant", "description": "Aromatic plant genus, often used in traditional medicine and perfumery.", "wikipedia_extract": "Amomum is a genus of plants containing about 111 species native to China, the Indian subcontinent, Southeast Asia, New Guinea, and Queensland. It includes several species of cardamom. Plants of this genus are remarkable for their pungency and aromatic properties. Among ancient writers, the name amomum was ascribed to various odoriferous plants that cannot be positively identified today. The word derives from Latin amomum, which is the latinisation of the Greek ἄμωμον (amomon), a kind of an Indian spice plant. Edmund Roberts noted on his 1834 trip to China that amomum was used as a spice to \"season sweet dishes\" in culinary practice."}}, {"canonical_name": "Gomma", "category": "PLANT", "subcategory": "RESIN", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "gomma", "book_id": "ricettario_fiorentino_1597", "name": "Gomma", "category": "PLANT", "subcategory": "RESIN", "count": 6, "variants": ["gomma", "Gomma"], "contexts": ["substance used to falsify opium", "resin used in preparations"]}, {"entity_id": "gums", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Gums", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["Gums"], "contexts": ["plant exudates"]}, {"entity_id": "gum", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Gum", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["Gum"], "contexts": ["viscous plant substance"]}, {"entity_id": "gom", "book_id": "ricettario_fiorentino_1597", "name": "gom", "category": "PLANT", "subcategory": "RESIN", "count": 3, "variants": ["gom"], "contexts": ["gum, likely a medicinal ingredient", "plant product used in preparation"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Gomma", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Gums", "similarity": 0.862}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Gomma", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Gum", "similarity": 0.882}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gums", "target_book": "ricettario_fiorentino_1597", "target_name": "gom", "similarity": 0.87}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gum", "target_book": "ricettario_fiorentino_1597", "target_name": "gom", "similarity": 0.881}], "id": 868, "stable_key": "clu_cc42c90aa5bef23b", "ground_truth": {"modern_name": "Plant gums", "confidence": "high", "type": "plant", "note": "Refers to exudates from plants, often sticky and viscous, used in medicine and industry.", "wikidata_id": "Q424275", "wikidata_description": "viscous substance produced by nearly all plants and some microorganisms; in terms of science, a polar glycoprotein and exopolysaccharide", "wikipedia_url": "https://en.wikipedia.org/wiki/Resin", "wikipedia_extract": "A resin is a solid or highly viscous liquid that can be converted into a polymer. Resins may be biological or synthetic in origin, but are typically harvested from plants. Resins are mixtures of organic compounds insoluble in water, predominantly terpenes. Technically, resins should not be confused with gums, which consist predominantly of water-soluble polysaccharides, although these two terms are often interchangeable in the less formal context. Common resins include pine oleoresins, amber, hashish, frankincense, myrrh and the animal-derived resin, shellac. Resins are used in varnishes, adhesives, food additives, incenses and perfumes."}}, {"canonical_name": "Oyls", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "oyls", "book_id": "english_physician_1652", "name": "Oyls", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 9, "variants": ["Oyls"], "contexts": ["medicinal preparation", "herb kept in"]}, {"entity_id": "olyo", "book_id": "coloquios_da_orta_1563", "name": "olyo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["olyo"], "contexts": ["oil", "oil made from cinnamon fruit"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Oyls", "target_book": "coloquios_da_orta_1563", "target_name": "olyo", "similarity": 0.885}], "id": 869, "stable_key": "clu_5c5592a2e80e83a9", "ground_truth": {"modern_name": "Oils", "confidence": "high", "type": "substance", "description": "Medicinal and culinary preparations derived from plants or fruits.", "wikipedia_extract": "Oil is a liquid with varying degrees of viscosity depending on temperature. Oil is any nonpolar chemical substance that is composed primarily of hydrocarbons and is hydrophobic (does not mix with water) and lipophilic (mixes with other oils). Oils are usually flammable and surface active. Most oils are unsaturated lipids that are liquid at room temperature. The general definition of oil includes classes of chemical compounds that may be otherwise unrelated in structure, properties, and uses. Oils may be animal, vegetable, or petrochemical in origin, and may be volatile or non-volatile."}}, {"canonical_name": "Pills", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "pills", "book_id": "english_physician_1652", "name": "Pills", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 7, "variants": ["Pills", "Pill"], "contexts": ["medicinal form", "dosage form of medicine"]}, {"entity_id": "pillole", "book_id": "ricettario_fiorentino_1597", "name": "pillole", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["pillole"], "contexts": ["medicinal preparations softened with humors", "pills, a type of compound medicine"]}, {"entity_id": "pastilli", "book_id": "ricettario_fiorentino_1597", "name": "pastilli", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["pastilli"], "contexts": ["Latin term for trochisci"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Pills", "target_book": "ricettario_fiorentino_1597", "target_name": "pillole", "similarity": 0.942}, {"source_book": "english_physician_1652", "source_name": "Pills", "target_book": "ricettario_fiorentino_1597", "target_name": "pastilli", "similarity": 0.866}], "id": 870, "stable_key": "clu_51989c7660a26c4d", "ground_truth": {"modern_name": "Pills", "confidence": "high", "type": "substance", "description": "Dosage forms of medicine, often compounded.", "wikipedia_extract": "The combined oral contraceptive pill (COCP), often referred to as the birth control pill or colloquially as \"the pill\", is a type of birth control that is designed to be taken orally by women. It is the oral form of combined hormonal contraception. The pill contains two important hormones: a progestin (a synthetic form of the hormone progestogen/progesterone) and estrogen (usually ethinylestradiol or 17β estradiol). When taken correctly, it alters the menstrual cycle to eliminate ovulation and prevent pregnancy. Combined oral contraceptive pills were first approved for contraceptive use in the United States in 1960, and remain a very popular form of birth control. They are used by more than 100 million women worldwide  including about 9 million women in the United States."}}, {"canonical_name": "Aries", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "aries", "book_id": "english_physician_1652", "name": "Aries", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["Aries"], "contexts": ["zodiac sign associated with Mars and head", "zodiac sign associated with Betony"]}, {"entity_id": "aries", "book_id": "polyanthea_medicinal", "name": "Aries", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Aries"], "contexts": ["zodiac sign"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Aries", "target_book": "polyanthea_medicinal", "target_name": "Aries", "similarity": 1.0}], "id": 871, "stable_key": "clu_9da9d08cab7f656a", "ground_truth": {"modern_name": "Aries", "confidence": "high", "type": "concept", "description": "A zodiacal constellation associated with the month of April.", "wikipedia_extract": "Aries  is one of the constellations of the zodiac. It is located in the Northern celestial hemisphere between Pisces to the west and Taurus to the east. The name Aries is Latin for ram. Its traditional astrological symbol is  (♈︎). It is one of the 48 constellations described by the 2nd century astronomer Ptolemy, and remains one of the 88 modern constellations. It is a mid-sized constellation ranking 39th in overall size, with an area of 441 square degrees (1.1% of the celestial sphere)."}}, {"canonical_name": "Washington", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "washington", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Washington", "category": "PLACE", "subcategory": "CITY", "count": 10, "variants": ["Washington"], "contexts": ["location of a presidential message", "location of a treaty signing"]}, {"entity_id": "washington", "book_id": "principles_of_psychology_james_1890", "name": "Washington", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Washington"], "contexts": ["location of National College"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Washington", "target_book": "principles_of_psychology_james_1890", "target_name": "Washington", "similarity": 1.0}], "id": 872, "stable_key": "clu_d0fb4647b151fa9f", "ground_truth": {"modern_name": "Washington D.C.", "confidence": "high", "type": "place", "description": "The capital city of the United States.", "note": "Refers to Washington D.C., the capital of the USA, not the state.", "wikipedia_extract": "Washington, D.C., officially the District of Columbia and commonly known as simply Washington or D.C., is the capital city and federal district of the United States. The city is on the Potomac River across from Virginia and shares land borders with Maryland to its north and east. It was named after George Washington, a Founding Father and the first president of the United States. The district is named for Columbia, the female personification of the nation. The U.S. Constitution in 1789 called for the creation of a federal district under exclusive jurisdiction of the U.S."}}, {"canonical_name": "San Carlos del Rio Negro", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "san_carlos_del_rio_negro", "book_id": "relation_historique_humboldt_vol3_1825", "name": "San Carlos del Rio Negro", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["San Carlos del Rio Negro"], "contexts": ["location linked astronomically", "settlement near Brazil"]}, {"entity_id": "fortin_de_san_carlos_del_rio_negro", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Fortin de San Carlos del Rio Negro", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Fortin de San Carlos del Rio Negro"], "contexts": ["a small fort on Rio Negro"]}, {"entity_id": "st__carlos_del_rio_negro", "book_id": "kosmos_humboldt_1845", "name": "St. Carlos del Rio Negro", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["St. Carlos del Rio Negro"], "contexts": ["location with low magnetic force"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "San Carlos del Rio Negro", "target_book": "kosmos_humboldt_1845", "target_name": "St. Carlos del Rio Negro", "similarity": 0.976}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Fortin de San Carlos del Rio Negro", "target_book": "kosmos_humboldt_1845", "target_name": "St. Carlos del Rio Negro", "similarity": 0.869}], "id": 873, "stable_key": "clu_89f874d38bba65bd", "ground_truth": {"modern_name": "San Carlos de Río Negro", "confidence": "high", "type": "place", "country": "Venezuela", "note": "A settlement and fort in Venezuela on the Rio Negro.", "wikidata_id": "Q1269422", "wikidata_description": "city", "wikipedia_url": "https://en.wikipedia.org/wiki/San%20Carlos%20de%20R%C3%ADo%20Negro"}}, {"canonical_name": "Lombardie", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "lombardie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Lombardie", "category": "PLACE", "subcategory": "REGION", "count": 6, "variants": ["Lombardie"], "contexts": ["region with cultivated fields", "region lacking primitive blocks"]}, {"entity_id": "lombardy", "book_id": "kosmos_humboldt_1845", "name": "Lombardy", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Lombardy"], "contexts": ["Italian region", "plain in Italy"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lombardie", "target_book": "kosmos_humboldt_1845", "target_name": "Lombardy", "similarity": 0.992}], "id": 874, "stable_key": "clu_df39d021e9b41ec6", "ground_truth": {"modern_name": "Lombardy", "confidence": "high", "type": "place", "country": "Italy", "wikipedia_extract": "Desiderius, also known as Daufer or Dauferius (born c. 720 – died c. 786), was king of the Lombards in northern Italy, ruling from 756 to 774. The Frankish king of renown, Charlemagne, married Desiderius's daughter and subsequently conquered his realm. Desiderius is remembered for this connection to Charlemagne and for being the last Lombard ruler to exercise regional kingship. Born in Brescia, Desiderius was originally a royal officer, the dux of Tuscia and he became king after the death of Aistulf in 756.", "wikipedia_url": "https://en.wikipedia.org/wiki/Desiderius"}}, {"canonical_name": "Pichincha", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "pichincha", "book_id": "kosmos_humboldt_1845", "name": "Pichincha", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Pichincha"], "contexts": ["volcano near Quito", "mountain mentioned for its elongated form"]}, {"entity_id": "pichincha", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pichincha", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Pichincha"], "contexts": ["mountain range", "province in Ecuador"]}, {"entity_id": "rucu-pichincha", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rucu-Pichincha", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Rucu-Pichincha"], "contexts": ["Volcano mentioned in the text"]}, {"entity_id": "rucu_pichincha", "book_id": "kosmos_humboldt_1845", "name": "Rucu Pichincha", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Rucu Pichincha"], "contexts": ["active volcano near Quito", "volcano location"]}, {"entity_id": "rueu_pichincha", "book_id": "kosmos_humboldt_1845", "name": "Rueu Pichincha", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Rueu Pichincha"], "contexts": ["volcano location"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Pichincha", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Pichincha", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pichincha", "target_book": "kosmos_humboldt_1845", "target_name": "Rucu Pichincha", "similarity": 0.882}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pichincha", "target_book": "kosmos_humboldt_1845", "target_name": "Rueu Pichincha", "similarity": 0.881}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rucu-Pichincha", "target_book": "kosmos_humboldt_1845", "target_name": "Rucu Pichincha", "similarity": 0.935}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rucu-Pichincha", "target_book": "kosmos_humboldt_1845", "target_name": "Rueu Pichincha", "similarity": 0.863}], "id": 875, "stable_key": "clu_257137a3d3e3dd77", "ground_truth": {"modern_name": "Pichincha", "confidence": "high", "type": "place", "country": "Ecuador", "note": "Refers to the Pichincha volcano and surrounding region.", "wikidata_id": "Q742216", "wikidata_description": "volcano in Quito Metro, Ecuador", "wikipedia_extract": "Quito (Spanish pronunciation: [ˈkito] ; Quechua: Kitu), officially San Francisco de Quito, is the capital and second-largest city of Ecuador, with an estimated population of 2.8 million in its metropolitan area. It is also the capital of the province of Pichincha. Quito is in a valley on the eastern slopes of Pichincha, an active stratovolcano in the Andes. Quito's elevation of 2,850 m (9,350 ft) makes it either the highest or the second highest national capital city in the world. This varied standing is because Bolivia is a country with multiple capitals; if La Paz is considered the Bolivian national capital, it tops the list of highest capitals, but if Sucre is specified as the capital, then it is the second highest, behind Quito. Quito is the political and cultural center of Ecuador as the country's major governmental, administrative, and cultural institutions are within the city.", "wikipedia_url": "https://en.wikipedia.org/wiki/Quito"}}, {"canonical_name": "Van Diemen's Land", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "van_diemen's_land", "book_id": "kosmos_humboldt_1845", "name": "Van Diemen's Land", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 10, "variants": ["Van Diemen's Land"], "contexts": ["former name for Tasmania", "location of magnetic storm observation"]}, {"entity_id": "van_diemen’s_land", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Van Diemen’s Land", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Van Diemen’s Land"], "contexts": ["geographic location east of South Pole"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Van Diemen's Land", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Van Diemen’s Land", "similarity": 0.995}], "id": 876, "stable_key": "clu_d41d2cc9c4f27a0a", "ground_truth": {"modern_name": "Tasmania", "confidence": "high", "type": "place", "country": "Australia", "note": "Former name for the island of Tasmania and its surrounding islands."}}, {"canonical_name": "Spitzbergen", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "spitzbergen", "book_id": "kosmos_humboldt_1845", "name": "Spitzbergen", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 10, "variants": ["Spitzbergen"], "contexts": ["Arctic archipelago", "location with slow magnetic declination change"]}, {"entity_id": "spitzbergen", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Spitzbergen", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Spitzbergen"], "contexts": ["location visited by Captain Sabine"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Spitzbergen", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Spitzbergen", "similarity": 1.0}], "id": 877, "stable_key": "clu_92c6a64d9251636d", "ground_truth": {"modern_name": "Svalbard", "confidence": "high", "type": "place", "country": "Norway", "note": "Arctic archipelago, historically known as Spitsbergen.", "wikidata_id": "Q21162", "wikidata_description": "largest island of the Svalbard archipelago in northern Norway", "wikipedia_url": "https://en.wikipedia.org/wiki/Spitsbergen"}}, {"canonical_name": "Cruzes da Sè", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "cruzes_da_sè", "book_id": "polyanthea_medicinal", "name": "Cruzes da Sè", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["Cruzes da Sè", "Cruz", "Cruzes da Se"], "contexts": ["location associated with Marquez de Gouvea", "location where Padre Manoel Coelho lived"]}, {"entity_id": "cruz_de_piedra", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cruz de Piedra", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Cruz de Piedra", "Cruz", "Cruz del Padre", "la Crui del Padre"], "contexts": ["field with aligned pineapples", "location of fields"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Cruzes da Sè", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Cruz de Piedra", "similarity": 0.845}], "id": 878, "stable_key": "clu_9fec413a959dc18a", "ground_truth": {"modern_name": "Cruzes da Sè / Cruz de Piedra", "confidence": "medium", "type": "place", "description": "A location or landmark, potentially a field or area with specific features.", "note": "The exact nature of this place is unclear and may refer to a specific field or a named landmark.", "wikipedia_extract": "This is a list of major football stadiums, grouped by country and ordered by capacity. The minimum capacity is 5,000."}}, {"canonical_name": "Pampas", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "pampas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pampas", "category": "PLACE", "subcategory": "REGION", "count": 10, "variants": ["Pampas", "pampas"], "contexts": ["plains north and south of equator", "plains where cultivation is debated"]}, {"entity_id": "pampas", "book_id": "first_principles_spencer_1862", "name": "Pampas", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Pampas"], "contexts": ["location of alligators during drought"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pampas", "target_book": "first_principles_spencer_1862", "target_name": "Pampas", "similarity": 1.0}], "id": 879, "stable_key": "clu_83081156e2633476", "ground_truth": {"modern_name": "Pampas", "confidence": "high", "type": "place", "country": "Argentina, Uruguay", "wikidata_id": "Q11994681", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Pampasatyrus"}}, {"canonical_name": "Journal de Physique", "category": "ORGANIZATION", "subcategory": "JOURNAL", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "journal_de_physique", "book_id": "kosmos_humboldt_1845", "name": "Journal de Physique", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 9, "variants": ["Journal de Physique"], "contexts": ["French scientific journal", "scientific journal"]}, {"entity_id": "journal_of_physiology", "book_id": "principles_of_psychology_james_1890", "name": "Journal of Physiology", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Journal of Physiology"], "contexts": ["publication for physiological research"]}, {"entity_id": "journal_of_physiol_", "book_id": "principles_of_psychology_james_1890", "name": "Journal of Physiol.", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Journal of Physiol."], "contexts": ["cited physiology journal"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Journal de Physique", "target_book": "principles_of_psychology_james_1890", "target_name": "Journal of Physiology", "similarity": 0.866}, {"source_book": "kosmos_humboldt_1845", "source_name": "Journal de Physique", "target_book": "principles_of_psychology_james_1890", "target_name": "Journal of Physiol.", "similarity": 0.86}], "id": 880, "stable_key": "clu_09f5b1d3b526e8ac", "ground_truth": {"modern_name": "Journal de Physique", "confidence": "high", "type": "text", "wikidata_id": "Q29043727", "wikidata_description": "journal"}}, {"canonical_name": "thunder", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "thunder", "book_id": "kosmos_humboldt_1845", "name": "thunder", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 9, "variants": ["thunder"], "contexts": ["sound produced by lightning", "atmospheric electrical discharge sound"]}, {"entity_id": "thunder", "book_id": "principles_of_psychology_james_1890", "name": "thunder", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["thunder"], "contexts": ["sound caused by lightning", "sound of lightning discharge"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "thunder", "target_book": "principles_of_psychology_james_1890", "target_name": "thunder", "similarity": 1.0}], "id": 881, "stable_key": "clu_2769ee94ff180603", "ground_truth": {"modern_name": "Thunder", "confidence": "high", "type": "concept", "note": "The term 'thunder' in this context refers to the natural phenomenon of sound, not an animal. The subcategory 'OTHER_ANIMAL' is likely an error.", "wikidata_id": "Q34116", "wikidata_description": "city in Thunder Bay District, province of Ontario, Canada", "wikipedia_url": "https://en.wikipedia.org/wiki/Thunder", "wikipedia_extract": "Thunder is the sound caused by lightning. Depending upon the distance from and nature of the lightning, it can range from a long, low rumble to a sudden, loud crack. The sudden increase in temperature and hence pressure caused by the lightning produces rapid expansion of the air in the path of a lightning bolt. In turn, this expansion of air creates a sonic shock wave, often referred to as a \"thunderclap\" or \"peal of thunder\". The scientific study of thunder is known as brontology and the irrational fear (phobia) of thunder is called brontophobia. The d in Modern English thunder (from earlier Old English þunor) is epenthetic, and is now found as well in Modern Dutch donder (cf."}}, {"canonical_name": "Ásia menor", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "ásia_menor", "book_id": "coloquios_da_orta_1563", "name": "Ásia menor", "category": "PLACE", "subcategory": "REGION", "count": 8, "variants": ["Ásia menor", "Asia-menor", "Ásia Menor"], "contexts": ["habitat of tree", "foreigners in India"]}, {"entity_id": "asia_minor", "book_id": "kosmos_humboldt_1845", "name": "Asia Minor", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Asia Minor"], "contexts": ["region in modern Turkey", "region with cities destroyed by earthquake"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Ásia menor", "target_book": "kosmos_humboldt_1845", "target_name": "Asia Minor", "similarity": 0.941}], "id": 882, "stable_key": "clu_6a492d9d2ca84789", "ground_truth": {"modern_name": "Anatolia", "confidence": "high", "type": "place", "country": "Turkey", "wikipedia_extract": "Turkey, officially the Republic of Türkiye, is a country mainly located in Anatolia in West Asia, with a relatively small part called East Thrace in Southeast Europe. It borders the Black Sea to the north; Georgia, Armenia, Azerbaijan, and Iran to the east; Iraq, Syria, and the Mediterranean Sea to the south; and the Aegean Sea, Greece, and Bulgaria to the west. Turkey is home to over 86 million people; most are ethnic Turks, while Kurds are the largest ethnic minority. Officially a secular state, Turkey has a Muslim-majority population. Ankara is Turkey's capital and second-largest city. Istanbul is its largest city and economic center.", "wikipedia_url": "https://en.wikipedia.org/wiki/Turkey"}}, {"canonical_name": "Datteri", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "datteri", "book_id": "ricettario_fiorentino_1597", "name": "Datteri", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["Datteri", "Dattengralsi", "Datteri grafsi", "datteri"], "contexts": ["dates are infused and strained", "dates passed through sieve"]}, {"entity_id": "datiles", "book_id": "historia_medicinal_monardes_1574", "name": "Datiles", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["datiles", "Datiles"], "contexts": ["fruit used for comparison of shape", "fruit, used for size comparison"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Datteri", "target_book": "historia_medicinal_monardes_1574", "target_name": "Datiles", "similarity": 0.845}], "id": 883, "stable_key": "clu_6639805f23b3df81", "ground_truth": {"modern_name": "Dates", "confidence": "high", "type": "plant", "linnaean": "Phoenix dactylifera", "family": "Arecaceae", "description": "The sweet, edible fruit of the date palm tree.", "note": "Refers to the fruit of the date palm.", "wikipedia_extract": "Phoenix dactylifera, commonly known as the date palm, is a flowering-plant species in the palm family Arecaceae, native to the region from the Gulf States to Pakistan. It is cultivated for its edible sweet fruit called dates. The species is widely cultivated across northern Africa, the Middle East, Australia, South and Southeast Asia, Portugal, Spain, coastal Mediterranean basin, and the desert regions of Southern California. It is naturalised in many tropical and subtropical regions worldwide. P. dactylifera is the type species of genus Phoenix, which contains 12–19 species of wild date palms. Date palms reach up to 30 metres (98 ft) in height, growing singly or forming a clump with several stems from a single root system."}}, {"canonical_name": "afmas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "afmas", "book_id": "polyanthea_medicinal", "name": "afmas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 9, "variants": ["afmas", "Afima", "Afimas", "Afmas"], "contexts": ["ailment treated by medicinal water", "chronic illness"]}, {"entity_id": "aſma", "book_id": "historia_medicinal_monardes_1574", "name": "Aſma", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["Aſma", "Aíma"], "contexts": ["affliction causing shortness of breath", "illness brought from the Indies"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "afmas", "target_book": "historia_medicinal_monardes_1574", "target_name": "Aſma", "similarity": 0.867}], "id": 884, "stable_key": "clu_648abc94744272ff", "ground_truth": {"modern_name": "Asthma", "confidence": "high", "type": "disease", "description": "A respiratory condition characterized by difficulty breathing and wheezing.", "note": "Refers to the respiratory condition.", "wikipedia_extract": "Asthma is a common long-term inflammatory disease of the airways. It is characterized by variable and recurring symptoms and reduced lung function. Symptoms include episodes of wheezing, coughing, chest tightness, and shortness of breath. A sudden worsening of asthma symptoms sometimes called an 'asthma attack' or an 'asthma exacerbation' can occur when allergens, pollen, dust, or other particles, are inhaled into the lungs, causing the bronchioles to constrict and produce mucus, which then restricts oxygen flow to the alveoli. These may occur a few times a day or a few times per week. Depending on the person, asthma symptoms may become worse at night or with exercise."}}, {"canonical_name": "Arménia", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "arménia", "book_id": "coloquios_da_orta_1563", "name": "Arménia", "category": "PLACE", "subcategory": "COUNTRY", "count": 9, "variants": ["Arménia"], "contexts": ["region of origin for substances", "country where benjuy is not found"]}, {"entity_id": "armenia", "book_id": "ricettario_fiorentino_1597", "name": "Armenia", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Armenia"], "contexts": ["place where borrace is found", "region of origin for a substance"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Arménia", "target_book": "ricettario_fiorentino_1597", "target_name": "Armenia", "similarity": 0.909}], "id": 885, "stable_key": "clu_d5747a3821975819", "ground_truth": {"modern_name": "Armenia", "confidence": "high", "type": "place", "description": "A country in Western Asia and Eastern Europe.", "note": "Refers to the geographical region and country.", "wikipedia_extract": "Armenia, officially the Republic of Armenia, is a landlocked country in the Armenian highlands of West Asia. It is a part of the Caucasus region and is bordered by Turkey to the west, Georgia to the north, Azerbaijan to the east, and Iran and the Azerbaijani exclave of Nakhchivan to the south. Yerevan is the capital, largest city and financial center. The Armenian highlands have been home to the Hayasa-Azzi, Shupria, and Nairi peoples. By at least 600 BC, an archaic form of Proto-Armenian, an Indo-European language, had diffused into the Armenian highlands. The first Armenian state of Urartu was established in 860 BC, and by the 6th century BC it was replaced by the Satrapy of Armenia."}}, {"canonical_name": "Emblici", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "emblici", "book_id": "ricettario_fiorentino_1597", "name": "Emblici", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["Emblici", "Embrici"], "contexts": ["emblic myrobalans", "ingredient in a preparation"]}, {"entity_id": "emblicos", "book_id": "coloquios_da_orta_1563", "name": "emblicos", "category": "PLANT", "subcategory": "PLANT", "count": 5, "variants": ["emblicos"], "contexts": ["fruit name", "counted by Mesue, called Seni"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Emblici", "target_book": "coloquios_da_orta_1563", "target_name": "emblicos", "similarity": 0.845}], "id": 886, "stable_key": "clu_0d3964de8445c05d", "ground_truth": {"modern_name": "Emblic myrobalan", "confidence": "high", "type": "plant", "linnaean": "Phyllanthus emblica", "family": "Phyllanthaceae", "description": "Fruit of Phyllanthus emblica, used in traditional medicine and dyeing.", "wikipedia_extract": "Phyllanthus emblica, also known as emblic, emblic myrobalan, myrobalan, nelikai, Indian gooseberry, Malacca tree, amloki or amla, is a deciduous tree of the family Phyllanthaceae. Its native range is tropical and southern Asia. The tree is small to medium in size, reaching 1–8 metres (3+1⁄2–26 feet) in height. The bark is mottled. The branchlets are finely pubescent (not glabrous), 10–20 centimetres (4–8 inches) long, usually deciduous. March–April is the main blooming season."}}, {"canonical_name": "Simão Botelho", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "simão_botelho", "book_id": "coloquios_da_orta_1563", "name": "Simão Botelho", "category": "PERSON", "subcategory": "SCHOLAR", "count": 10, "variants": ["Simão Botelho", "Simio Botelho"], "contexts": ["author of Tombo do Estado da Índia", "early modern author"]}, {"entity_id": "simão_pinheyro", "book_id": "polyanthea_medicinal", "name": "Simão Pinheyro", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Simão Pinheyro"], "contexts": ["author who wrote on medicine in Portuguese"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Simão Botelho", "target_book": "polyanthea_medicinal", "target_name": "Simão Pinheyro", "similarity": 0.845}], "id": 887, "stable_key": "clu_c19da06f22331c14", "ground_truth": {"modern_name": "Simão Botelho", "confidence": "high", "type": "person", "description": "Early modern Portuguese author and administrator in India.", "note": "Simão Pinheyro is likely a variant or error for Simão Botelho based on context and strong evidence for Botelho.", "wikipedia_extract": "Portuguese art includes many different styles from many different eras. Portuguese sculptures can be best analysed by studying the many tombs of the 12th and 14th centuries that are found throughout Portugal. In the late 1700s, the colony of Brazil was the main influence in Portuguese sculpture. This can be seen by the increase in Baroque wooden sculpture during this time. Joaquim Machado de Castro, a famous Portuguese artist who lived around this time and is responsible for a lot of these works. Museums exhibiting paintings by Portuguese artists, outside Portugal, include the Hispanic Society of America (New York): Works – Collections – Hispanic Society of America and the Centre Pompidou, Paris."}}, {"canonical_name": "cacollá", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "cacollá", "book_id": "coloquios_da_orta_1563", "name": "cacollá", "category": "PLANT", "subcategory": "PLANT", "count": 10, "variants": ["cacollá", "cacolld", "cacollá quebir", "caculle", "cacullá"], "contexts": ["synonym for cardamomo", "plant with white bark and black seeds"]}, {"entity_id": "cacoulas", "book_id": "polyanthea_medicinal", "name": "cacoulas", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["cacoulas"], "contexts": ["fragrant substance, possibly cardamom"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "cacollá", "target_book": "polyanthea_medicinal", "target_name": "cacoulas", "similarity": 0.913}], "id": 888, "stable_key": "clu_4384627776ec3803", "ground_truth": {"modern_name": "Cardamom", "confidence": "high", "type": "plant", "linnaean": "Elettaria cardamomum", "family": "Zingiberaceae", "description": "Fragrant spice derived from the seeds of plants in the ginger family.", "wikipedia_extract": "Elettaria cardamomum, commonly known as green cardamom or true cardamom, is a herbaceous, perennial plant in the ginger family, native to southern India. It is the most common of the species whose seeds are used as a spice called cardamom that has a strong aroma used in both savory and sweet cooking. It is cultivated widely in tropical regions and reportedly naturalized in Réunion, Indochina, and Costa Rica. Elettaria cardamomum is a pungent, aromatic, herbaceous, perennial plant, growing to about 2–4 m (6 ft 7 in – 13 ft 1 in) in height. The leaves are alternate in two ranks, linear-lanceolate, 40–60 cm (16–24 in) long, with a long pointed tip. The flowers are white to lilac or pale violet, produced in a loose spike 30–60 cm (12–24 in) long."}}, {"canonical_name": "espadana", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "espadana", "book_id": "coloquios_da_orta_1563", "name": "espadana", "category": "PLANT", "subcategory": "PLANT", "count": 6, "variants": ["espadana"], "contexts": ["plant, possibly iris", "plant with similar leaves to the fruit's leaves"]}, {"entity_id": "espadana", "book_id": "polyanthea_medicinal", "name": "espadana", "category": "PLANT", "subcategory": "PLANT", "count": 5, "variants": ["espadana", "espadanal"], "contexts": ["sword lily root", "roots used in baths"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "espadana", "target_book": "polyanthea_medicinal", "target_name": "espadana", "similarity": 1.0}], "id": 889, "stable_key": "clu_358a9ac6cf98fa99", "ground_truth": {"modern_name": "Sword lily root", "confidence": "high", "type": "plant", "linnaean": "Iris germanica", "family": "Iridaceae", "description": "Root of the sword lily (Iris), used medicinally.", "wikipedia_extract": "Iris × germanica is the accepted name for a species of flowering plants in the family Iridaceae commonly known as the bearded iris or the German bearded iris. It is of hybrid origin. Varieties include I. × g. var. florentina. Iris × germanica grows up to 120 cm (47 in) high and 30 cm (12 in) wide. The roots can go up to 10 cm (3.9 in) deep and it is a rhizomatous perennial that blooms mid to late spring. Hundreds of cultivars exist representing nearly every colour from jet black to sparkling whites and red."}}, {"canonical_name": "Algalia", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "algalia", "book_id": "polyanthea_medicinal", "name": "Algalia", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 7, "variants": ["algalia", "Algalia"], "contexts": ["civet used in preparation", "civet, warm paste for abdominal pain"]}, {"entity_id": "algalia", "book_id": "coloquios_da_orta_1563", "name": "algalia", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 4, "variants": ["algalia", "algualia"], "contexts": ["used for cold humor pains", "substance with strong smell"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Algalia", "target_book": "coloquios_da_orta_1563", "target_name": "algalia", "similarity": 0.833}], "id": 890, "stable_key": "clu_289605e9e9afedd5", "ground_truth": {"modern_name": "Civet", "confidence": "high", "type": "animal", "linnaean": "Viverra civetta", "family": "Viverridae", "description": "Substance with strong odor from civet cat, used in perfumery and medicine.", "wikipedia_extract": "A civet () is a small, lean, mostly nocturnal mammal native to tropical Asia and Africa, especially the tropical forests. The term civet applies to over a dozen different species, mostly from the family Viverridae. Most of the species's diversity is found in southeast Asia. Civets do not form a monophyletic group, as they consist only of certain members of the Viverridae and Eupleridae. The African civet, Civettictis civetta, has historically been the main species from which a musky scent used in perfumery, also referred to as \"civet\", was obtained. The common name is used for a variety of carnivoran mammal species, mostly of the family Viverridae."}}, {"canonical_name": "cereijas", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "cereijas", "book_id": "polyanthea_medicinal", "name": "cereijas", "category": "PLANT", "subcategory": "PLANT", "count": 8, "variants": ["cereijas", "Cereijas", "cereijasnegras", "cerejas"], "contexts": ["fruit used to wrap medicines", "eaten with cold water, caused hiccups"]}, {"entity_id": "cerejas", "book_id": "coloquios_da_orta_1563", "name": "cerejas", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["cerejas", "cereaes"], "contexts": ["fruit that rots and causes fevers", "fruit, likely cherries"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "cereijas", "target_book": "coloquios_da_orta_1563", "target_name": "cerejas", "similarity": 0.957}], "id": 891, "stable_key": "clu_24a2723e9ceb2c9e", "ground_truth": {"modern_name": "Cherries", "confidence": "high", "type": "plant", "linnaean": "Prunus avium", "family": "Rosaceae", "description": "Sweet, red fruit of the cherry tree, used in food and medicine.", "wikipedia_extract": "Prunus avium, commonly called wild cherry, sweet cherry or gean, is a species of cherry, a flowering plant in the rose family, Rosaceae. It is native to Eurasia and naturalized elsewhere. It is an ancestor of P. cerasus (sour cherry). All parts of the plant except for the ripe fruit are slightly toxic, containing cyanogenic glycosides. The species is often cultivated as an ornamental tree. Prunus avium is a deciduous tree growing to 5–25 metres (16–82 feet) tall, with a trunk up to 1.5 m (5 ft) in diameter."}}, {"canonical_name": "Evora", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "evora", "book_id": "polyanthea_medicinal", "name": "Evora", "category": "PLACE", "subcategory": "CITY", "count": 8, "variants": ["Evora"], "contexts": ["city where the Archbishop resided", "city where patient resided"]}, {"entity_id": "évora", "book_id": "coloquios_da_orta_1563", "name": "Évora", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Évora"], "contexts": ["city in Portugal", "city where book was published"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Evora", "target_book": "coloquios_da_orta_1563", "target_name": "Évora", "similarity": 0.861}], "id": 892, "stable_key": "clu_0050a36d1a68d8c5", "ground_truth": {"modern_name": "Évora", "confidence": "high", "type": "place", "description": "Historic city in Portugal, known for its Roman and medieval heritage.", "wikipedia_extract": "Évora, officially the Very Noble and Ever Loyal City of Évora, is a city and a municipality in Portugal. It has 53,591 inhabitants (2021), in an area of 1,307.08 square kilometers (504.67 mi2). It is considered the historic capital of the Alentejo region and serves as the seat of the Évora District. Due to its well-preserved old town centre, still partially enclosed by medieval walls, and many monuments dating from various historical periods, including a Roman Temple, Évora is a UNESCO World Heritage Site since 1986. Due to its inland position, Évora is one of Portugal's hottest cities in the summer, frequently subject to heatwaves. Évora is ranked number two in the Portuguese most livable cities survey of living conditions published yearly by Expresso. It was ranked first in a study concerning competitiveness of the 18 Portuguese district capitals, according to a 2006 study made by University of Minho economics researchers."}}, {"canonical_name": "rabãos", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "rabãos", "book_id": "polyanthea_medicinal", "name": "rabãos", "category": "PLANT", "subcategory": "PLANT", "count": 8, "variants": ["rabãos", "rabão"], "contexts": ["radishes", "flatulent food"]}, {"entity_id": "rabãos", "book_id": "coloquios_da_orta_1563", "name": "rabãos", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["rabãos"], "contexts": ["vegetable, likely radishes", "vegetable sold"]}, {"entity_id": "rabô", "book_id": "coloquios_da_orta_1563", "name": "rabô", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["rabô"], "contexts": ["type of pepper found in Africa"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "rabãos", "target_book": "coloquios_da_orta_1563", "target_name": "rabãos", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "rabãos", "target_book": "coloquios_da_orta_1563", "target_name": "rabô", "similarity": 0.868}], "id": 893, "stable_key": "clu_12e8cc9aa3552d5a", "ground_truth": {"modern_name": "Radish", "confidence": "high", "type": "plant", "linnaean": "Raphanus sativus", "family": "Brassicaceae", "description": "Edible root vegetable with a peppery flavor, commonly consumed raw.", "note": "The term 'rabô' in one context appears to refer to a specific type of pepper, but the overwhelming evidence points to 'radish' for the other instances.", "wikipedia_extract": "The radish (Raphanus sativus or Raphanus raphanistrum subsp. sativus) is a flowering plant in the mustard family, Brassicaceae. Its large taproot is commonly used as a root vegetable, although the entire plant is edible and its leaves are sometimes used as a leaf vegetable. Originally domesticated in Asia, radishes are now grown and consumed globally. The radish is sometimes considered to form a species complex with the wild radish and instead treated as the subspecies Raphanus raphanistrum subsp. sativus. Radishes are often used raw as a crunchy salad vegetable with a pungent, slightly spicy flavor, varying in intensity depending on its growing environment. There are numerous varieties varying in size, flavor, color, and length of time they take to mature."}}, {"canonical_name": "Thomas Rodriguez da Veiga", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "thomas_rodriguez_da_veiga", "book_id": "polyanthea_medicinal", "name": "Thomas Rodriguez da Veiga", "category": "PERSON", "subcategory": "AUTHORITY", "count": 10, "variants": ["Thomas Rodriguez da Veiga", "Thomas Rodericus", "Thomas Rodriguez da Veyga"], "contexts": ["author recommending bloodletting for inflammations", "Portuguese scholar on medicine and nation"]}, {"entity_id": "thomaz_rodrigues_da_veiga", "book_id": "coloquios_da_orta_1563", "name": "Thomaz Rodrigues da Veiga", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Thomaz Rodrigues da Veiga"], "contexts": ["doctor whose lessons were heard in Coimbra"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Thomas Rodriguez da Veiga", "target_book": "coloquios_da_orta_1563", "target_name": "Thomaz Rodrigues da Veiga", "similarity": 0.915}], "id": 894, "stable_key": "clu_6b78a770a7eb5af4", "ground_truth": {"modern_name": "Thomas Rodriguez da Veiga", "confidence": "high", "type": "person", "description": "Portuguese scholar and physician, author of medicinal works.", "wikipedia_extract": "The Portuguese people (Portuguese: Portugueses – masculine – or Portuguesas) are a Romance-speaking ethnic group and nation indigenous to Portugal, a country that occupies the west side of the Iberian Peninsula in south-west Europe, who share culture, ancestry and language. The Portuguese state began with the founding of the County of Portugal in 868. Following the Battle of São Mamede (1128), Portugal gained international recognition as a kingdom through the Treaty of Zamora and the papal bull Manifestis Probatum. This Portuguese state paved the way for the Portuguese people to unite as a nation. The Portuguese explored distant lands previously unknown to Europeans—in the Americas, Africa, Asia and Oceania (southwest Pacific Ocean). In 1415, with the conquest of Ceuta, the Portuguese took a significant role in the Age of Discovery, which culminated in a colonial empire."}}, {"canonical_name": "Spodio", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "spodio", "book_id": "ricettario_fiorentino_1597", "name": "Spodio", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 9, "variants": ["Spodio"], "contexts": ["substance found in furnaces", "a substance from the East"]}, {"entity_id": "espodio", "book_id": "polyanthea_medicinal", "name": "espodio", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["espodio"], "contexts": ["ingredient in a remedy for diabetes", "used in trociscos"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Spodio", "target_book": "polyanthea_medicinal", "target_name": "espodio", "similarity": 0.889}], "id": 895, "stable_key": "clu_6dbc80d5fa096efa", "ground_truth": {"modern_name": "Spodium", "confidence": "high", "type": "substance", "description": "A residue from furnaces or a substance derived from the East.", "note": "Likely a reference to a charcoal-like substance or mineral residue.", "wikipedia_extract": "Spodium, (Latin for ashes or soot) refers to burned bone (usually used for medical purposes), or the act of divination with ash. Spodium may also refer to other types of ash, such as the scrapings from the inside of a furnace. Spodium has a long history of medical usage, mentioned by Hippocrates and, for example, in the Medical Poem of Salerno \"...Who knows the cause why Spodium stancheth bleeding?...\" (in this case spodium referring to oxen bone Ashes)."}}, {"canonical_name": "Quicksilver", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "quicksilver", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Quicksilver", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["Quicksilver"], "contexts": ["mercury, a liquid metal", "liquid metal in which crystal swims"]}, {"entity_id": "quicksilver", "book_id": "connexion_physical_sciences_somerville_1858", "name": "quicksilver", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["quicksilver"], "contexts": ["dense metallic liquid", "liquid metal that would freeze on Mars"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Quicksilver", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "quicksilver", "similarity": 0.963}], "id": 896, "stable_key": "clu_555c08f5d50af934", "ground_truth": {"modern_name": "Quicksilver", "confidence": "high", "type": "chemical", "wikidata_id": "Q925", "wikidata_description": "chemical element with symbol Hg and atomic number 80", "wikipedia_extract": "Quicksilver is a 2024 romantasy novel by British author Callie Hart, the first in her Fae & Alchemy trilogy. Hart self-published the book in June 2024 after declining her literary agent's request for substantial revisions. Initial sales were modest, but the book found an audience after Hart sent copies to BookTok creators on TikTok, generating over three million views within two months. The viral attention sparked a 10-bidder auction for publishing rights. Forever, an imprint of Grand Central Publishing, won the auction, releasing a traditional edition on December 3, 2024 that debuted at number one on The New York Times Best Seller list. That same week, Netflix acquired film adaptation rights for seven figures.", "wikipedia_url": "https://en.wikipedia.org/wiki/Quicksilver_(Hart_novel)"}}, {"canonical_name": "Woodpecker", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "woodpecker", "book_id": "origin_of_species_darwin_1859", "name": "Woodpecker", "category": "ANIMAL", "subcategory": "BIRD", "count": 5, "variants": ["Woodpecker", "woodpecker"], "contexts": ["bird with specialized beak and tongue", "example of adaptation"]}, {"entity_id": "woodpecker", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Woodpecker", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Woodpecker"], "contexts": ["bird that pecks wood"]}, {"entity_id": "woodpeckers", "book_id": "origin_of_species_darwin_1859", "name": "woodpeckers", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["woodpeckers"], "contexts": ["birds found where no trees grow"]}, {"entity_id": "ground_woodpeckers", "book_id": "origin_of_species_darwin_1859", "name": "ground woodpeckers", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["ground woodpeckers"], "contexts": ["woodpeckers living on ground", "birds that live on the ground"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Woodpecker", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Woodpecker", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Woodpecker", "target_book": "origin_of_species_darwin_1859", "target_name": "woodpeckers", "similarity": 0.918}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Woodpecker", "target_book": "origin_of_species_darwin_1859", "target_name": "ground woodpeckers", "similarity": 0.854}], "id": 897, "stable_key": "clu_e7d0d549afa4f330", "ground_truth": {"modern_name": "Woodpecker", "confidence": "high", "type": "animal", "wikidata_id": "Q11774312", "wikidata_description": "bird that climbs up in trees, probes for insects in tree bark and chisels nest holes in deadwood", "wikipedia_extract": "Woodpeckers are part of the bird family Picidae, which also includes the piculets, wrynecks and sapsuckers. Members of this family are found worldwide, except for Australia, New Guinea, New Zealand, Madagascar and the extreme polar regions. Most species live in forests or woodland habitats, although a few species are known that live in treeless areas, such as rocky hillsides and deserts, and the Gila woodpecker specializes in exploiting cacti. Members of this family are chiefly known for the characteristic behaviour that lent them their common name. Their pecking serves mostly to aid their forage for insect prey in the trunks and branches of trees, and also communication which they achieve by drumming trees with their beaks, producing a reverberatory sound that can be heard at some distance. Some species vary their diet with fruits, birds' eggs, small animals, tree sap, human scraps, and carrion."}}, {"canonical_name": "a Centauri", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "a_centauri", "book_id": "kosmos_humboldt_1845", "name": "a Centauri", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["a Centauri"], "contexts": ["nearest star to the Sun", "star used for astronomical distance comparison"]}, {"entity_id": "centaures", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Centaures", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["Centaures"], "contexts": ["mythical creatures", "mythical creature, origin explained by mistake"]}, {"entity_id": "centaur", "book_id": "kosmos_humboldt_1845", "name": "Centaur", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["Centaur"], "contexts": ["constellation", "constellation and star for parallax"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "a Centauri", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Centaures", "similarity": 0.954}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Centaures", "target_book": "kosmos_humboldt_1845", "target_name": "Centaur", "similarity": 0.975}], "id": 898, "stable_key": "clu_ce4856822242ead8", "ground_truth": {"modern_name": "Alpha Centauri", "confidence": "high", "type": "place", "note": "This cluster appears to conflate a star system with mythical creatures. The primary referent from the contexts and common scientific usage is the star system.", "wikidata_id": "Q12176", "wikidata_description": "triple star system in the constellation Centaurus, where one of the three stars, Proxima Centauri, being the closest star to the Earth", "wikipedia_extract": "Alpha Centauri (α Centauri, α Cen, or Alpha Cen) is a star system in the southern constellation of Centaurus. It consists of three stars: Rigil Kentaurus (α Centauri A), Toliman (α Centauri B), and Proxima Centauri (α Centauri C). Proxima Centauri is the closest star to the Sun at 4.2465 light-years (ly), which is 1.3020 parsecs (pc), while Alpha Centauri A and B are the nearest stars visible to the naked eye. Rigil Kentaurus and Toliman are Sun-like stars (class G and K, respectively) that together form the binary star system α Centauri AB. To the naked eye, these two main components appear to be a single star with an apparent magnitude of −0.27. It is the brightest star in the constellation and the third-brightest in the night sky, outshone by only Sirius and Canopus. α Centauri AB are the nearest binary stars to the Sun at a distance of 4.344 ly (1.33 pc).", "wikipedia_url": "https://en.wikipedia.org/wiki/Alpha_Centauri"}}, {"canonical_name": "secret parts", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "secret_parts", "book_id": "english_physician_1652", "name": "secret parts", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 9, "variants": ["secret parts", "Secret parts"], "contexts": ["body area with sores", "ulcers and sores in secret parts"]}, {"entity_id": "partes_occultas", "book_id": "polyanthea_medicinal", "name": "partes occultas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["partes occultas"], "contexts": ["internal body parts"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "secret parts", "target_book": "polyanthea_medicinal", "target_name": "partes occultas", "similarity": 0.93}], "id": 899, "stable_key": "clu_cc11aa926c079669", "ground_truth": {"modern_name": "Genitalia", "confidence": "high", "type": "substance", "description": "Anatomical terms referring to the reproductive organs or private body parts.", "note": "Historical euphemism for reproductive organs or sensitive body areas.", "wikipedia_extract": "A sex organ, also known as a reproductive organ, is a part of an organism that is involved in sexual reproduction. Sex organs constitute the primary sex characteristics of an organism. Sex organs are responsible for producing and transporting gametes, as well as facilitating fertilization and supporting the development and birth of offspring. Sex organs are found in many species of animals and plants, with their features varying depending on the species. Sex organs are typically differentiated into male and female types. In mammals (including humans), the male sex organs include the testicles, epididymides, and penis; the female sex organs include the clitoris,  ovaries, oviducts, and vagina."}}, {"canonical_name": "lombos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "lombos", "book_id": "polyanthea_medicinal", "name": "lombos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 8, "variants": ["lombos", "lumbos"], "contexts": ["body part for cauterization", "lower back region"]}, {"entity_id": "loyns", "book_id": "english_physician_1652", "name": "Loyns", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Loyns", "loyns"], "contexts": ["lower back area, pains are eased", "body part experiencing pain"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "lombos", "target_book": "english_physician_1652", "target_name": "Loyns", "similarity": 0.854}], "id": 900, "stable_key": "clu_41f99ed31336c07f", "ground_truth": {"modern_name": "Lumbar region", "confidence": "high", "type": "substance", "description": "Anatomical term for the lower back area of the body.", "note": "Refers to the 'lumbus' or lower back.", "wikipedia_extract": "In tetrapod anatomy, lumbar is an adjective that means of or pertaining to the abdominal segment of the torso, between the diaphragm and the sacrum. The lumbar region is sometimes referred to as the lower spine, or as an area of the back in its proximity. In human anatomy the five lumbar vertebrae (vertebrae in the lumbar region of the back) are the largest and strongest in the movable part of the spinal column, and can be distinguished by the absence of a foramen in the transverse process, and by the absence of facets on the sides of the body. In most mammals, the lumbar region of the spine curves outward. The actual spinal cord terminates between vertebrae one and two of this series, called L1 and L2. The nervous tissue that extends below this point are individual strands that collectively form the cauda equina."}}, {"canonical_name": "Duque de Baviera", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "duque_de_baviera", "book_id": "polyanthea_medicinal", "name": "Duque de Baviera", "category": "PERSON", "subcategory": "PATRON", "count": 9, "variants": ["Duque de Baviera", "Duque de Cadaval", "Duque de Hetruria", "Duque do Cadaval", "Duque doCadaval", "Duquede Baviera", "DuquedeBaviera"], "contexts": ["employer of Martim Rulando", "Duke of Bavaria"]}, {"entity_id": "dukes_of_bavaria", "book_id": "english_physician_1652", "name": "Dukes of Bavaria", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Dukes of Bavaria"], "contexts": ["supported Mathiolus' work"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Duque de Baviera", "target_book": "english_physician_1652", "target_name": "Dukes of Bavaria", "similarity": 0.923}], "id": 901, "stable_key": "clu_ef3f8cb8d1455d0b", "ground_truth": {"modern_name": "Duke of Bavaria", "confidence": "high", "type": "person", "description": "A noble patron, likely supporting scientific or medical endeavors.", "note": "Refers to historical rulers of Bavaria.", "wikipedia_extract": "The following is a list of rulers during the history of Bavaria. Bavaria was ruled by several dukes and kings, partitioned and reunited, under several dynasties. Since 1918, Bavaria has been under a republican form of government, and from 1949, Bavaria has been a democratic state in the Federal Republic of Germany. Ducal Bavaria (also known as the \"Old Stem duchy\") Around 548 the kings of the Franks placed the border region of Bavaria under the administration of a duke—possibly Frankish or possibly chosen from amongst the local leading families—who was supposed to act as a regional governor for the Frankish king. The first duke we know of, and likely the first, was Gariwald, or Garibald I, a member of the powerful Agilolfing family. This was the beginning of a series of Agilolfing dukes that was to last until 788."}}, {"canonical_name": "Bermuda", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "bermuda", "book_id": "origin_of_species_darwin_1859", "name": "Bermuda", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["Bermuda"], "contexts": ["island with peculiar soil and no endemic land birds", "island stocked by birds"]}, {"entity_id": "iles_bermudes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Iles Bermudes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Iles Bermudes", "Bermudes"], "contexts": ["group of islands", "archipelago location"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Bermuda", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Iles Bermudes", "similarity": 0.945}], "id": 902, "stable_key": "clu_220d490d5daf5847", "ground_truth": {"modern_name": "Bermuda", "confidence": "high", "type": "place", "description": "An archipelago and British Overseas Territory in the North Atlantic Ocean.", "wikipedia_extract": "Bermuda is a British Overseas Territory in the North Atlantic Ocean. The closest land outside the territory is in the U.S. state of North Carolina, about 1,035 km (643 mi) to the west-northwest. Bermuda is an archipelago consisting of 181 islands, although the most significant islands are connected by bridges and appear to form one landmass. It has a land area of 54 square kilometres (21 sq mi). Bermuda has a tropical climate, with warm winters and hot summers. Its climate also exhibits oceanic features similar to other coastal areas in the Northern Hemisphere with warm, moist air from the ocean ensuring relatively high humidity and stabilising temperatures."}}, {"canonical_name": "alligalors", "category": "ANIMAL", "subcategory": "REPTILE", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "alligalors", "book_id": "relation_historique_humboldt_vol3_1825", "name": "alligalors", "category": "ANIMAL", "subcategory": "REPTILE", "count": 8, "variants": ["alligalors", "Alligator sclerops", "alligator lucius"], "contexts": ["type of reptile with blunt snout", "reptiles with blunt snouts and smooth legs"]}, {"entity_id": "alligators", "book_id": "origin_of_species_darwin_1859", "name": "Alligators", "category": "ANIMAL", "subcategory": "REPTILE", "count": 2, "variants": ["alligators", "Alligators"], "contexts": ["example of male fighting behavior", "large semi-aquatic reptiles"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "alligalors", "target_book": "origin_of_species_darwin_1859", "target_name": "Alligators", "similarity": 0.89}], "id": 903, "stable_key": "clu_3c6dd71aeb4334f0", "ground_truth": {"modern_name": "alligators", "confidence": "high", "type": "animal", "family": "Alligatoridae", "description": "Large, semi-aquatic reptiles with blunt snouts and smooth legs.", "wikipedia_extract": "An alligator, or colloquially gator, is a large reptile in the genus Alligator of the family Alligatoridae in the order Crocodilia. The two extant species are the American alligator (A. mississippiensis) and the Chinese alligator (A. sinensis). Additionally, several extinct species of alligator are known from fossil remains. Alligators first appeared during the late Eocene epoch about 37 million years ago. The term \"alligator\" is likely an anglicized form of el lagarto, Spanish for \"the lizard\", which early Spanish explorers and settlers in Florida called the alligator. Early English spellings of the name included allagarta and alagarto."}}, {"canonical_name": "Abyssinia", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "abyssinia", "book_id": "coloquios_da_orta_1563", "name": "Abyssinia", "category": "PLACE", "subcategory": "COUNTRY", "count": 7, "variants": ["Abyssinia", "da Abyssinia"], "contexts": ["region of origin for cardamom", "region of origin for koraríma"]}, {"entity_id": "abyssinia", "book_id": "origin_of_species_darwin_1859", "name": "Abyssinia", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Abyssinia"], "contexts": ["historical name for Ethiopia", "location with southern vegetable forms"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Abyssinia", "target_book": "origin_of_species_darwin_1859", "target_name": "Abyssinia", "similarity": 1.0}], "id": 904, "stable_key": "clu_5b7081f87703cc09", "ground_truth": {"modern_name": "Ethiopia", "confidence": "high", "type": "place", "description": "A country in Eastern Africa, historically known as Abyssinia.", "wikipedia_extract": "Ethiopia, officially the Federal Democratic Republic of Ethiopia, is a landlocked country located in the Horn of Africa region of East Africa. It shares borders with Eritrea to the north, Djibouti to the northeast, Somalia to the east, Kenya to the south, South Sudan to the west, and Sudan to the northwest. Ethiopia covers a land area of 1,104,300 square kilometres (426,400 sq mi). As of 2025, it has around 135 million inhabitants, making it the 14th-most populous country. The national capital and largest city, Addis Ababa, lies several kilometres west of the East African Rift that splits the country into the African and Somali tectonic plates. Anatomically modern humans emerged from modern-day Ethiopia."}}, {"canonical_name": "San Sébastian", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "san_sébastian", "book_id": "relation_historique_humboldt_vol3_1825", "name": "San Sébastian", "category": "PLACE", "subcategory": "CITY", "count": 9, "variants": ["San Sébastian", "Saint-Sébastien", "San Sébastian de Buenavista", "San Sébastian de Uraba", "San Sébastian de Uraha", "San Sébastien"], "contexts": ["peak", "city in Caracas province"]}, {"entity_id": "st__sebastian", "book_id": "kosmos_humboldt_1845", "name": "St. Sebastian", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["St. Sebastian"], "contexts": ["location between cities"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "San Sébastian", "target_book": "kosmos_humboldt_1845", "target_name": "St. Sebastian", "similarity": 0.848}], "id": 905, "stable_key": "clu_313c89d6d92fc988", "ground_truth": {"modern_name": "San Sebastián", "confidence": "high", "type": "place", "country": "Spain", "wikidata_id": "Q10313", "wikidata_description": "municipality in Basque Country, Spain", "wikipedia_url": "https://en.wikipedia.org/wiki/San_Sebastián", "wikipedia_extract": "San Sebastián, officially known by the bilingual name Donostia / San Sebastián (Basque: [doˈnos̺ti.a], Spanish: [san seβasˈtjan] ), is a city and municipality located in the Basque Autonomous Community in Spain. It lies on the coast of the Bay of Biscay, 20 km (12 miles) from the France–Spain border. The capital city of the province of Gipuzkoa, it has a population of 188,487 as of 2024, with its metropolitan area being 436,500 in 2010. Locals call themselves donostiarra (singular) in Basque, also using this term when speaking in Spanish. It is also a part of Basque Eurocity Bayonne-San Sebastián. The economic activities in the city are dominated by the service sector, with an emphasis on commerce and tourism, as San Sebastián has long been well-known as a tourist destination."}}, {"canonical_name": "Minas Geraes", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "minas_geraes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Minas Geraes", "category": "PLACE", "subcategory": "REGION", "count": 9, "variants": ["Minas Geraes", "Mina^ Geraes", "Minaes Geraes", "Minas-Geraes"], "contexts": ["region in Brazil", "state in Brazil"]}, {"entity_id": "minas_geraes", "book_id": "kosmos_humboldt_1845", "name": "Minas Geraes", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Minas Geraes"], "contexts": ["diamond district in Brazil"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Minas Geraes", "target_book": "kosmos_humboldt_1845", "target_name": "Minas Geraes", "similarity": 1.0}], "id": 906, "stable_key": "clu_45eb2ebfe2e41d82", "ground_truth": {"modern_name": "Minas Gerais", "confidence": "high", "type": "place", "country": "Brazil", "wikidata_id": "Q39109", "wikidata_description": "state in the Southeast Region of Brazil", "wikipedia_url": "https://en.wikipedia.org/wiki/Belo_Horizonte", "wikipedia_extract": "Belo Horizonte is the sixth-largest city in Brazil, with a population of around 2.4 million, and the third largest metropolitan area, containing a population of 6 million. It is the 13th-largest city in South America and the 18th-largest in the Americas. The metropolis is anchor to the Belo Horizonte metropolitan area, ranked as the third most populous metropolitan area in Brazil and the 17th most populous in the Americas. Belo Horizonte is the capital of the state of Minas Gerais, Brazil's second-most populous state. It is the first planned modern city in Brazil. The region was first settled in the early 18th century, but the city as it is known today was planned and constructed in the 1890s to replace Ouro Preto as the capital of Minas Gerais."}}, {"canonical_name": "Victoria", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "victoria", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Victoria", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Victoria"], "contexts": ["place name in Venezuela", "city in Aragua valleys"]}, {"entity_id": "victoria_land", "book_id": "kosmos_humboldt_1845", "name": "Victoria Land", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Victoria Land"], "contexts": ["area near magnetic south pole", "landmass extending from Cape Crozier"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Victoria", "target_book": "kosmos_humboldt_1845", "target_name": "Victoria Land", "similarity": 0.939}], "id": 907, "stable_key": "clu_2b86c8eec43fc80b", "ground_truth": {"modern_name": "Victoria", "confidence": "high", "type": "place", "country": "Venezuela", "note": "Contexts suggest two distinct places named Victoria: one in Venezuela, and 'Victoria Land' near the South Pole.", "wikipedia_extract": "Victoria (Alexandrina Victoria; 24 May 1819 – 22 January 1901) was Queen of the United Kingdom of Great Britain and Ireland from 20 June 1837 until her death in 1901. Her reign of 63 years and 216 days, which was longer than those of any of her predecessors, constituted the Victorian era, a period of industrial, political, scientific, and military change within the United Kingdom marked by a great expansion of the British Empire. In 1876, the British parliament voted to grant her the additional title of Empress of India. Victoria was the daughter of Prince Edward, Duke of Kent and Strathearn (the fourth son of King George III), and Princess Victoria of Saxe-Coburg-Saalfeld. After the deaths of her father and grandfather in 1820, she was raised under close supervision by her mother and her comptroller, John Conroy. She inherited the throne aged 18 after her father's three elder brothers died without surviving legitimate issue.", "wikipedia_url": "https://en.wikipedia.org/wiki/Queen_Victoria"}}, {"canonical_name": "Sinù", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "sinù", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sinù", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["Sinù", "Sinu"], "contexts": ["river banks where coal is found", "valley reached after Rio Pabarando"]}, {"entity_id": "sindu", "book_id": "coloquios_da_orta_1563", "name": "Sindu", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Sindu", "Sindhu"], "contexts": ["river called Milan or Sinteu", "Sanskrit name for a river"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sinù", "target_book": "coloquios_da_orta_1563", "target_name": "Sindu", "similarity": 0.894}], "id": 908, "stable_key": "clu_c1d1cc0650367c36", "ground_truth": {"modern_name": "Sinu River", "confidence": "high", "type": "place", "description": "River in Colombia, associated with coal deposits and medicinal plants.", "note": "The mention of 'Sindu' and 'Sinteu' suggests a possible conflation with the Indus River or a misinterpretation of local names.", "wikipedia_extract": "Sinú River (Spanish: Río Sinú), is a river in northwestern Colombia that flows mostly through the Córdoba Department and into the Caribbean. It is the third most important river in the Caribbean Region, after the Magdalena River and the Cauca River. It is born in the Antioquia Department, flowing south to north for 415 kilometres (258 mi) until flowing into the Caribbean Sea. The river is navigable for only half of its length, 200 kilometres (120 mi) starting in Montería, the largest city in its basin. Also, this river is the main tourist attraction of Montería decorated with the first avenue when it passes by Montería. The river flows between the eastern and middle prongs of the Cordillera Occidental."}}, {"canonical_name": "Honduras", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "honduras", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Honduras", "category": "PLACE", "subcategory": "COUNTRY", "count": 7, "variants": ["Honduras"], "contexts": ["gulf", "country in Central America"]}, {"entity_id": "honduras", "book_id": "historia_medicinal_monardes_1574", "name": "Honduras", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Honduras"], "contexts": ["region with a type of gargaparilla", "a region where medicinal plants are sourced"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Honduras", "target_book": "historia_medicinal_monardes_1574", "target_name": "Honduras", "similarity": 1.0}], "id": 909, "stable_key": "clu_7721f3f6cb05e33f", "ground_truth": {"modern_name": "Honduras", "confidence": "high", "type": "place", "description": "Country in Central America, known for its gulf and medicinal plants.", "wikipedia_extract": "Honduras, officially the Republic of Honduras, is a country in Central America. It is bordered to the west by Guatemala, to the southwest by El Salvador, to the southeast by Nicaragua, to the south by the Pacific Ocean at the Gulf of Fonseca, and to the north by the Gulf of Honduras, a large inlet of the Caribbean Sea. Its capital and largest city is Tegucigalpa. Honduras was home to several important Mesoamerican cultures, most notably the Maya, before Spanish colonization in the sixteenth century. The Spanish introduced Catholicism and the now-predominant Spanish language, along with numerous customs that have blended with the indigenous culture. Honduras became independent in 1821 and has since been a republic, although it has consistently endured much social strife and political instability, and remains one of the poorest countries in the Western Hemisphere."}}, {"canonical_name": "Péninsule", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "péninsule", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Péninsule", "category": "PLACE", "subcategory": "REGION", "count": 6, "variants": ["Péninsule"], "contexts": ["Iberian Peninsula", "destination for tobacco"]}, {"entity_id": "península", "book_id": "coloquios_da_orta_1563", "name": "Península", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Península", "península"], "contexts": ["where name reached", "Iberian Peninsula"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Péninsule", "target_book": "coloquios_da_orta_1563", "target_name": "Península", "similarity": 0.94}], "id": 910, "stable_key": "clu_907fb6e3df65e146", "ground_truth": {"modern_name": "Peninsula", "confidence": "high", "type": "place", "description": "A landmass surrounded by water on three sides, such as the Iberian Peninsula.", "note": "Refers to a geographical feature, often the Iberian Peninsula in the context of these texts.", "wikipedia_extract": "A peninsula is a landform that extends from a mainland, is connected to the mainland on only one side, and is mostly surrounded by water. Peninsulas exist on each continent. The largest peninsula in the world is the Arabian Peninsula. The word peninsula derives from Latin  paeninsula, from  paene 'almost' and  insula 'island'. The word entered English in the 16th century. A peninsula is generally defined as a piece of land surrounded on most sides by water."}}, {"canonical_name": "Bumeo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "bumeo", "book_id": "coloquios_da_orta_1563", "name": "Bumeo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["Bumeo"], "contexts": ["place of origin for camphor", "location where camphor is found"]}, {"entity_id": "uembo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Uembo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Uembo"], "contexts": ["valley location"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Bumeo", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Uembo", "similarity": 0.859}], "id": 911, "stable_key": "clu_e7a34e1f43180b87", "ground_truth": {"modern_name": "Borneo", "confidence": "high", "type": "place", "description": "Island in Southeast Asia, a source of camphor.", "note": "References to 'Bumeo' and 'Uembo' likely refer to Borneo and its camphor production.", "wikipedia_extract": "Borneo () is the third-largest island in the world, with an area of 748,168 km2 (288,869 sq mi), and population of 23,053,723 (2020 national censuses). Situated at the geographic centre of Maritime Southeast Asia, it is one of the Greater Sunda Islands, located north of Java, west of Sulawesi, and east of Sumatra. The island is crossed by the equator, which divides it roughly in half. In Indonesia, the island is also known as Kalimantan, which is also the name of the Indonesian region located on the island. The geology of Borneo was formed beginning in the Mesozoic. It formed part of Sundaland, a region connected to mainland Asia, until it became isolated by sea level rise at the end of the last ice age."}}, {"canonical_name": "Descartes", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "descartes", "book_id": "principles_of_psychology_james_1890", "name": "Descartes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["Descartes"], "contexts": ["philosopher on mind-body", "philosopher who conceived nervous mechanism"]}, {"entity_id": "descartes", "book_id": "kosmos_humboldt_1845", "name": "Descartes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Descartes"], "contexts": ["philosopher and scientist", "planned work 'Monde'"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Descartes", "target_book": "kosmos_humboldt_1845", "target_name": "Descartes", "similarity": 1.0}], "id": 912, "stable_key": "clu_03c5a85678021c21", "ground_truth": {"modern_name": "René Descartes", "confidence": "high", "type": "person", "birth_year": 1596, "death_year": 1650, "description": "French philosopher, mathematician, and scientist, influential in mind-body dualism.", "wikidata_id": "Q9191", "wikidata_description": "French philosopher, mathematician, and scientist (1596–1650)", "wikipedia_url": "https://en.wikipedia.org/wiki/René_Descartes", "wikipedia_extract": "René Descartes ( day-KART, also  DAY-kart; French: [ʁəne dekaʁt] ; 31 March 1596 – 11 February 1650) was a French philosopher, scientist, and mathematician, widely considered a seminal figure in the emergence of modern philosophy and science. Mathematics was paramount to his method of inquiry, and he connected the previously separate fields of geometry and algebra into analytic geometry. Refusing to accept the authority of previous philosophers, Descartes frequently set his views apart from the philosophers who preceded him. In the opening section of the Passions of the Soul, an early modern treatise on emotions, Descartes goes so far as to assert that he will write on this topic \"as if no one had written on these matters before.\" His best known philosophical statement is \"cogito, ergo sum\" (\"I think, therefore I am,\" French: \"Je pense, donc je suis\"). Descartes has often been called the father of modern philosophy, and he is largely seen as responsible for the increased attention given to epistemology in the 17th century. He was one of the key figures in the Scientific Revolution, and his Meditations on First Philosophy and other philosophical works continue to be studied."}}, {"canonical_name": "mulheres hystericas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "mulheres_hystericas", "book_id": "polyanthea_medicinal", "name": "mulheres hystericas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["mulheres hystericas", "hysterica"], "contexts": ["hysterical women patients", "female condition"]}, {"entity_id": "hysterical_disease", "book_id": "principles_of_psychology_james_1890", "name": "hysterical disease", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["hysterical disease"], "contexts": ["condition of hysteria"]}, {"entity_id": "hysteric_patient", "book_id": "principles_of_psychology_james_1890", "name": "hysteric patient", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["hysteric patient"], "contexts": ["patient with abolished sensation and recollection"]}, {"entity_id": "hysteric_subjects", "book_id": "principles_of_psychology_james_1890", "name": "hysteric subjects", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["hysteric subjects"], "contexts": ["subjects experimented on by M. Janet"]}, {"entity_id": "hysteric_crisis", "book_id": "principles_of_psychology_james_1890", "name": "hysteric crisis", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["hysteric crisis"], "contexts": ["episode of psychological distress"]}, {"entity_id": "hysterical_disorders", "book_id": "principles_of_psychology_james_1890", "name": "hysterical disorders", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["hysterical disorders"], "contexts": ["distressing conditions experienced by Lurancy"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "mulheres hystericas", "target_book": "principles_of_psychology_james_1890", "target_name": "hysterical disease", "similarity": 0.868}, {"source_book": "polyanthea_medicinal", "source_name": "mulheres hystericas", "target_book": "principles_of_psychology_james_1890", "target_name": "hysteric patient", "similarity": 0.857}, {"source_book": "polyanthea_medicinal", "source_name": "mulheres hystericas", "target_book": "principles_of_psychology_james_1890", "target_name": "hysteric subjects", "similarity": 0.874}, {"source_book": "polyanthea_medicinal", "source_name": "mulheres hystericas", "target_book": "principles_of_psychology_james_1890", "target_name": "hysteric crisis", "similarity": 0.862}, {"source_book": "polyanthea_medicinal", "source_name": "mulheres hystericas", "target_book": "principles_of_psychology_james_1890", "target_name": "hysterical disorders", "similarity": 0.876}], "id": 913, "stable_key": "clu_685f51491a9f1059", "ground_truth": {"modern_name": "Hysteria", "confidence": "high", "type": "disease", "description": "A historical medical diagnosis for a range of psychological and physical symptoms in women.", "note": "A historical medical term encompassing a variety of psychological and physical symptoms, particularly in women.", "wikipedia_extract": "Hysteria is a term used to mean ungovernable emotional excess and can refer to a temporary state of mind or emotion. In the nineteenth century, female hysteria was considered a diagnosable physical illness in women. It is assumed that the basis for diagnosis operated under the belief that women are predisposed to mental and behavioral conditions; an interpretation of sex-related differences in stress responses. In the twentieth century, it shifted to being considered a mental illness. Influential physicians the likes of Sigmund Freud and Jean-Martin Charcot had dedicated research to hysteria patients. Currently, most physicians do not accept hysteria as a medical diagnosis."}}, {"canonical_name": "galvanic battery", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "galvanic_battery", "book_id": "connexion_physical_sciences_somerville_1858", "name": "galvanic battery", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 9, "variants": ["galvanic battery"], "contexts": ["device producing galvanic current", "source of electrical current"]}, {"entity_id": "battery", "book_id": "principles_of_psychology_james_1890", "name": "battery", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["battery"], "contexts": ["device producing electric current"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "galvanic battery", "target_book": "principles_of_psychology_james_1890", "target_name": "battery", "similarity": 0.862}], "id": 914, "stable_key": "clu_276be517c4a56760", "ground_truth": {"modern_name": "Galvanic battery", "confidence": "high", "type": "object", "wikidata_id": "Q12714992", "wikidata_description": ""}}, {"canonical_name": "law", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "law", "book_id": "first_principles_spencer_1862", "name": "law", "category": "CONCEPT", "subcategory": "THEORY", "count": 7, "variants": ["Law", "law"], "contexts": ["constant course of procedure in nature", "constant course of procedure"]}, {"entity_id": "law", "book_id": "principles_of_psychology_james_1890", "name": "law", "category": "CONCEPT", "subcategory": "THEORY", "count": 3, "variants": ["law"], "contexts": ["abstract concept in spiritualist philosophy", "relationship between sensation and stimulus"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "law", "target_book": "principles_of_psychology_james_1890", "target_name": "law", "similarity": 1.0}], "id": 915, "stable_key": "clu_824d3a365d77f39b", "ground_truth": {"modern_name": "Law of nature", "confidence": "high", "type": "concept", "note": "The context 'constant course of procedure in nature' points to natural law, rather than legal statutes.", "wikidata_id": "Q29524", "wikidata_description": "system of law that is purportedly determined by nature, and is thus universal", "wikipedia_url": "https://en.wikipedia.org/wiki/Natural_law", "wikipedia_extract": "Rights of nature or Earth rights is a legal and jurisprudential theory that describes inherent rights as associated with ecosystems and species, similar to the concept of fundamental human rights. The rights of nature concept challenges twentieth-century laws as generally grounded in a flawed frame of nature as \"resource\" to be owned, used, and degraded. Proponents argue that laws grounded in rights of nature direct humanity to act appropriately and in a way consistent with modern, system-based science, which demonstrates that humans and the natural world are fundamentally interconnected. This school of thought is underpinned by two basic lines of reasoning. First, since the recognition of human rights is based in part on the philosophical belief that those rights emanate from humanity's own existence, logically, so too do inherent rights of the natural world arise from the natural world's own existence. A second and more pragmatic argument asserts that the survival of humans depends on healthy ecosystems, and so protection of nature's rights in turn, advances human rights and well-being."}}, {"canonical_name": "Fourier", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "fourier", "book_id": "kosmos_humboldt_1845", "name": "Fourier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Fourier"], "contexts": ["scientist who studied heat", "scientist who conjectured solidification process"]}, {"entity_id": "fourier", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Fourier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Fourier"], "contexts": ["theorist of space temperature", "computed central heat decrease"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Fourier", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Fourier", "similarity": 1.0}], "id": 916, "stable_key": "clu_f907c390fce80749", "ground_truth": {"modern_name": "Joseph Fourier", "confidence": "high", "type": "person", "birth_year": 1768, "death_year": 1830, "description": "French mathematician and physicist known for work on heat and thermodynamics."}}, {"canonical_name": "corrimientos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "corrimientos", "book_id": "historia_medicinal_monardes_1574", "name": "corrimientos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 6, "variants": ["corrimientos", "corrimie"], "contexts": ["flow that resin prohibits", "affliction treated with gargaparrilla water"]}, {"entity_id": "corrimentos", "book_id": "polyanthea_medicinal", "name": "corrimentos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["corrimentos"], "contexts": ["discharges", "ailment treated by syrup"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "corrimientos", "target_book": "polyanthea_medicinal", "target_name": "corrimentos", "similarity": 0.968}], "id": 917, "stable_key": "clu_253df3f9e96e437a", "ground_truth": {"modern_name": "Discharges", "confidence": "high", "type": "disease", "description": "Abnormal bodily discharges, often indicating an ailment.", "note": "Refers to abnormal bodily flows or secretions, often treated as a medical condition.", "wikipedia_extract": "A vaginal disease is a pathological condition that affects part or all of the vagina. Sexually transmitted infections that affect the vagina include: Herpes genitalis. The herpes simplex virus (HSV) can infect the vulva, vagina, and cervix, and this may result in small, painful, recurring blisters and ulcers. It is also common for there to be an absence of any noticeable symptoms. Human papillomavirus (HPV), which may cause genital warts. Because of STIs, health authorities and other health outlets recommend safe sex practices when engaging in sexual activity."}}, {"canonical_name": "especiarias", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "especiarias", "book_id": "coloquios_da_orta_1563", "name": "especiarias", "category": "PLANT", "subcategory": "PLANT", "count": 9, "variants": ["especiarias", "especia", "especiaria"], "contexts": ["aromatic plant products", "these spices"]}, {"entity_id": "especiarias", "book_id": "polyanthea_medicinal", "name": "especiarias", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["especiarias"], "contexts": ["spices, plant-based flavorings"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "especiarias", "target_book": "polyanthea_medicinal", "target_name": "especiarias", "similarity": 1.0}], "id": 918, "stable_key": "clu_1333b297871c039d", "ground_truth": {"modern_name": "Spices", "confidence": "high", "type": "plant", "description": "Aromatic plant products used for flavor and medicine.", "wikipedia_extract": "In the culinary arts, a spice is a seed, fruit, root, bark, or other plant substance primarily used for flavoring or coloring food. Spices are distinguished from herbs, which are the leaves, flowers, or stems of plants used for flavoring or as a garnish. Spices and herbs are both seasonings. Spices are sometimes used in medicine, religious rituals, cosmetics, or perfume production. They are usually classified into spices, spice seeds, and herbal categories. For example, vanilla is commonly used as an ingredient in fragrance manufacturing."}}, {"canonical_name": "Algarve", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "algarve", "book_id": "coloquios_da_orta_1563", "name": "Algarve", "category": "PLACE", "subcategory": "REGION", "count": 7, "variants": ["Algarve", "Algarby", "Algarves"], "contexts": ["region in the west", "region whose name derives from garb"]}, {"entity_id": "algarve", "book_id": "polyanthea_medicinal", "name": "Algarve", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Algarve"], "contexts": ["region in southern Portugal", "region in Portugal"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Algarve", "target_book": "polyanthea_medicinal", "target_name": "Algarve", "similarity": 1.0}], "id": 919, "stable_key": "clu_9c2e13d61dd53fea", "ground_truth": {"modern_name": "Algarve", "confidence": "high", "type": "place", "description": "Southernmost region of Portugal, historically significant.", "wikipedia_extract": "The Algarve (UK: , US: , European Portuguese: [alˈɣaɾvɨ] ) is the southernmost NUTS II region of continental Portugal. It has an area of 4,997 km2 (1,929 sq mi) with 467,495 permanent inhabitants and incorporates 16 municipalities (concelhos or municípios in Portuguese). The region has its administrative centre in the city of Faro, where both the region's international airport and public university, the University of Algarve, are located. The region is the same as the area included in the Faro District and is subdivided into two zones, one to the West (Barlavento) and another to the East (Sotavento). Tourism and related activities are extensive and make up the bulk of the Algarve's summer economy. Production of food which includes fish and other seafood, as well as different types of fruit and vegetables such as oranges, figs, plums, carob pods, almonds, avocados, tomatoes, cauliflowers, strawberries, and raspberries, are also economically important in the region."}}, {"canonical_name": "alcaparras", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "alcaparras", "book_id": "polyanthea_medicinal", "name": "alcaparras", "category": "PLANT", "subcategory": "PLANT", "count": 8, "variants": ["alcaparras", "alcaravia"], "contexts": ["root used for unblocking", "food with deobstructing properties"]}, {"entity_id": "alcaparras", "book_id": "coloquios_da_orta_1563", "name": "alcaparras", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["alcaparras"], "contexts": ["flower buds", "appetite stimulant"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "alcaparras", "target_book": "coloquios_da_orta_1563", "target_name": "alcaparras", "similarity": 1.0}], "id": 920, "stable_key": "clu_4fb1e28ecec1bbb1", "ground_truth": {"modern_name": "Capers", "confidence": "high", "type": "plant", "linnaean": "Capparis spinosa", "family": "Capparaceae", "description": "Flower buds and root of a shrub used in cuisine and medicine.", "wikipedia_extract": "Capparis spinosa, the caper bush, also called Flinders rose, is a perennial plant that bears rounded, fleshy leaves and large white to pinkish-white flowers. The taxonomic status of the species is controversial and unsettled. Species within the genus Capparis are highly variable, and interspecific hybrids have been common throughout the evolutionary history of the genus. As a result, some authors have considered C. spinosa to be composed of multiple distinct species, others that the taxon is a single species with multiple varieties or subspecies, or that the taxon C. spinosa is a hybrid between C. orientalis and C. sicula. Capparis spinosa is native to almost all the circum-Mediterranean countries, and is included in the flora of most of them, but whether it is indigenous to this region is uncertain. The family Capparaceae could have originated in the tropics and later spread to the Mediterranean basin."}}, {"canonical_name": "aves", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "aves", "book_id": "coloquios_da_orta_1563", "name": "aves", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 6, "variants": ["aves"], "contexts": ["Birds", "birds that produce amber"]}, {"entity_id": "aves", "book_id": "polyanthea_medicinal", "name": "aves", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 4, "variants": ["Aves", "aves"], "contexts": ["birds", "poultry to avoid"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "aves", "target_book": "polyanthea_medicinal", "target_name": "aves", "similarity": 1.0}], "id": 921, "stable_key": "clu_0ef9fe73f17e29e3", "ground_truth": {"modern_name": "Birds", "confidence": "high", "type": "animal", "description": "Feathered vertebrates, including poultry and those producing ambergris.", "wikipedia_extract": "Birds are a group of warm-blooded theropod dinosaurs constituting the class Aves, characterised by feathers, toothless beaked jaws, the laying of hard-shelled eggs, a high metabolic rate, a four-chambered heart, and a strong yet lightweight skeleton. Birds live worldwide and range in size from the 5.5 cm (2.2 in) bee hummingbird to the 2.8 m (9 ft 2 in) common ostrich. There are over 11,000 living species and they are split into 44 orders. More than half are passerine or \"perching\" birds. Birds have wings whose development varies according to species; the only known groups without wings are the extinct moa and elephant birds. Wings, which are modified forelimbs, gave birds the ability to fly, although further evolution has led to the loss of flight in some birds, including ratites, penguins, and diverse endemic island species."}}, {"canonical_name": "nabos", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "nabos", "book_id": "polyanthea_medicinal", "name": "nabos", "category": "PLANT", "subcategory": "PLANT", "count": 6, "variants": ["nabos"], "contexts": ["vegetable used in remedies", "turnips"]}, {"entity_id": "nabo", "book_id": "coloquios_da_orta_1563", "name": "nabo", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["nabo", "nabos"], "contexts": ["turnip, a vegetable", "vegetable cut by a knife"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "nabos", "target_book": "coloquios_da_orta_1563", "target_name": "nabo", "similarity": 0.868}], "id": 922, "stable_key": "clu_96cdd3d4798114b6", "ground_truth": {"modern_name": "Turnips", "confidence": "high", "type": "plant", "linnaean": "Brassica rapa subsp. rapa", "family": "Brassicaceae", "description": "A root vegetable widely cultivated and used in food and remedies.", "wikipedia_extract": "The turnip or white turnip (Brassica rapa subsp. rapa) is a root vegetable commonly grown in temperate climates worldwide for its white, fleshy taproot. Small, tender varieties are grown for human consumption, while larger varieties are grown as feed for livestock. The name turnip – used in many regions – may also be used to refer to rutabaga (or neep or swede), which is a different but related vegetable. The origin of the word turnip is uncertain, though it is hypothesised that it could be a compound of turn as in turned/rounded on a lathe and neep, derived from Latin napus, the word for the plant. According to An Universal Etymological English Dictionary (1721), turn refers to \"round napus to distinguish it from the napi, which were generally long\". The most common type of turnip is mostly white-skinned except for the upper 1 to 6 centimetres (1⁄2 to 2+1⁄2 inches)."}}, {"canonical_name": "deftillatio", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "deftillatio", "book_id": "polyanthea_medicinal", "name": "deftillatio", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 9, "variants": ["deftillatio", "Deftillat.", "Deftillatio", "dettillar", "deſtillar", "deſtillaçao", "deſtillaçaó", "deſtillaçaõ", "deſtillaō"], "contexts": ["the process of distillation", "process of distillation"]}, {"entity_id": "destilaçam", "book_id": "coloquios_da_orta_1563", "name": "destilaçam", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["destilaçam"], "contexts": ["process used to whiten camphor"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "deftillatio", "target_book": "coloquios_da_orta_1563", "target_name": "destilaçam", "similarity": 0.847}], "id": 923, "stable_key": "clu_d7d1823c559b430e", "ground_truth": {"modern_name": "Distillation", "confidence": "high", "type": "concept", "description": "The process of purifying a liquid by heating and cooling.", "wikipedia_extract": "Distillation, also classical distillation, is the process of separating the component substances of a liquid mixture of two or more chemically discrete substances; the separation process is realized by way of the selective boiling of the mixture and the condensation of the vapors in a still. Distillation can operate over a wide range of pressures from 0.14 bar (e.g., ethylbenzene/styrene) to nearly 21 bar (e.g., propylene/propane) and is capable of separating feeds with high volumetric flowrates and various components that cover a range of relative volatilities from only 1.17 (o-xylene/m-xylene) to 81.2 (water/ethylene glycol). Distillation provides a convenient and time-tested solution to separate a diversity of chemicals in a continuous manner with high purity. However, distillation has an enormous environmental footprint, resulting in the consumption of approximately 25% of all industrial energy use. The key issue is that distillation operates based on phase changes, and this separation mechanism requires vast energy inputs. Dry distillation (thermolysis and pyrolysis) is the heating of solid materials to produce gases that condense either into fluid products or into solid products."}}, {"canonical_name": "abobora", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "abobora", "book_id": "polyanthea_medicinal", "name": "abobora", "category": "PLANT", "subcategory": "PLANT", "count": 9, "variants": ["abobora", "abobaras", "aboboras"], "contexts": ["pumpkin", "pumpkin pulp used in a poultice"]}, {"entity_id": "abóbora", "book_id": "coloquios_da_orta_1563", "name": "abóbora", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["abóbora"], "contexts": ["one of the four great cold seeds"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "abobora", "target_book": "coloquios_da_orta_1563", "target_name": "abóbora", "similarity": 0.922}], "id": 924, "stable_key": "clu_313a4a6b93609095", "ground_truth": {"modern_name": "Pumpkin", "confidence": "high", "type": "plant", "description": "A large, round vegetable, often orange, used in cooking and medicine.", "wikipedia_extract": "A pumpkin is a cultivated winter squash in the genus Cucurbita. The term is most commonly applied to round, orange-colored squash varieties, but does not possess a scientific definition. It may be used in reference to many different squashes of varied appearance and belonging to multiple species in the Cucurbita genus. \"Pumpkin\" is sometimes used interchangeably with \"squash\" or \"winter squash\", and is commonly used for some cultivars of Cucurbita argyrosperma, Cucurbita ficifolia, Cucurbita maxima, Cucurbita moschata, and Cucurbita pepo. C. pepo pumpkins are among the oldest known domesticated plants, with evidence of their cultivation dating to between 7000 BCE and 5500 BCE in Mesoamerica. Wild species of Cucurbita and the earliest domesticated species are native to North America (parts of present-day northeastern Mexico and the southern United States), but cultivars are now grown globally for culinary, decorative, and other culturally-specific purposes. The pumpkin's thick shell encases edible seeds and pulp."}}, {"canonical_name": "adftringentes", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "adftringentes", "book_id": "polyanthea_medicinal", "name": "adftringentes", "category": "CONCEPT", "subcategory": "QUALITY", "count": 8, "variants": ["adftringentes", "Adftringentes", "adftringens", "adftringente", "adftringentia"], "contexts": ["astringent medicines", "medicines to tighten or constrict"]}, {"entity_id": "astringente", "book_id": "ricettario_fiorentino_1597", "name": "astringente", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["astringente"], "contexts": ["property of alum", "strong property of round alum"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "adftringentes", "target_book": "ricettario_fiorentino_1597", "target_name": "astringente", "similarity": 0.865}], "id": 925, "stable_key": "clu_3add99b2e75344b1", "ground_truth": {"modern_name": "Astringent", "confidence": "high", "type": "concept", "description": "A substance that causes tissues to contract or tighten.", "wikipedia_extract": "An astringent (sometimes called adstringent) is a chemical that shrinks or constricts body tissues. The word derives from the Latin adstringere, which means \"to bind fast\". Astringency, the dry, puckering or numbing mouthfeel caused by the tannins in unripe fruits, lets the fruit mature by deterring eating. Tannins, being a kind of polyphenol, bind salivary proteins and make them precipitate and aggregate, producing a rough, \"sandpapery\", or dry sensation in the mouth. Smoking tobacco is also reported to have an astringent effect. In a scientific study, astringency was still detectable by subjects who had local anesthesia applied to their taste nerves, but not when both these and the trigeminal nerves were disabled."}}, {"canonical_name": "Virgo", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "virgo", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Virgo", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 7, "variants": ["Virgo"], "contexts": ["constellation where conjunction took place", "constellation containing a star"]}, {"entity_id": "virgam", "book_id": "polyanthea_medicinal", "name": "Virgam", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["Virgam", "Virgam oculos aper-", "virga"], "contexts": ["Latin for 'rod' or 'staff'", "Latin for 'rod opening eyes'"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Virgo", "target_book": "polyanthea_medicinal", "target_name": "Virgam", "similarity": 0.907}], "id": 926, "stable_key": "clu_749744523bc78947", "ground_truth": {"modern_name": "Virgo", "confidence": "medium", "type": "concept", "note": "The Latin term 'Virgam' likely refers to the constellation Virgo given the astronomical context, but 'rod' or 'staff' is also a valid translation."}}, {"canonical_name": "quotidianas", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "quotidianas", "book_id": "polyanthea_medicinal", "name": "quotidianas", "category": "DISEASE", "subcategory": "ACUTE", "count": 8, "variants": ["quotidianas", "quotidiana", "quotidiana continua", "quotidiane"], "contexts": ["quotidian fevers", "fever type, 'quotidians'"]}, {"entity_id": "cotidíanas", "book_id": "historia_medicinal_monardes_1574", "name": "Cotidíanas", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["Cotidíanas"], "contexts": ["daily fevers"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "quotidianas", "target_book": "historia_medicinal_monardes_1574", "target_name": "Cotidíanas", "similarity": 0.933}], "id": 927, "stable_key": "clu_140fbc177967fe05", "ground_truth": {"modern_name": "Quotidian fever", "confidence": "high", "type": "disease", "description": "A type of fever that recurs daily.", "wikipedia_extract": "Fever or pyrexia in humans is a symptom of an anti-infection defense mechanism that appears with body temperature exceeding the normal range caused by an increase in the body's temperature set point in the hypothalamus. There is no single agreed-upon upper limit for normal temperature: sources use values ranging between 37.2 and 38.3 °C (99.0 and 100.9 °F) in humans. The increase in set point triggers increased muscle contractions and causes a feeling of cold or chills. This results in greater heat production and efforts to conserve heat. When the set point temperature returns to normal, a person feels hot, becomes flushed, and may begin to sweat. Rarely a fever may trigger a febrile seizure, with this being more common in young children."}}, {"canonical_name": "saffron", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "saffron", "book_id": "english_physician_1652", "name": "saffron", "category": "PLANT", "subcategory": "PLANT", "count": 6, "variants": ["saffron", "Saffron"], "contexts": ["used with columbine seed to open liver obstructions", "less effectual than Saffron"]}, {"entity_id": "safron", "book_id": "coloquios_da_orta_1563", "name": "safron", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["safron", "saffron"], "contexts": ["ingredient in a pessary", "plant used in pessary"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "saffron", "target_book": "coloquios_da_orta_1563", "target_name": "safron", "similarity": 0.892}], "id": 928, "stable_key": "clu_22d25601a8226dda", "ground_truth": {"modern_name": "Saffron", "confidence": "high", "type": "plant", "description": "A spice derived from the flower of Crocus sativus, used medicinally.", "wikipedia_extract": "Saffron (  , Persian: زعفران) is a spice derived from the flower of Crocus sativus, commonly known as the \"saffron crocus\". The vivid crimson stigma and styles, called threads, are collected and dried for use mainly as a seasoning and colouring agent in food. The saffron crocus was slowly propagated throughout much of Eurasia and was later brought to parts of North Africa, North America, and Oceania. Saffron's taste and iodoform-like or hay-like fragrance result from the phytochemicals picrocrocin and safranal. It also contains a carotenoid pigment, crocin, which imparts a rich golden-yellow hue to dishes and textiles. Its quality is graded by the proportion of red stigma to yellow style, varying by region and affecting both potency and value."}}, {"canonical_name": "Terra santa", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "terra_santa", "book_id": "polyanthea_medicinal", "name": "Terra santa", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["Terra santa", "Terra Santa"], "contexts": ["name for prepared antimony", "name given to valuable powders"]}, {"entity_id": "terra_sacratissima", "book_id": "english_physician_1652", "name": "Terra sacratissima", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Terra sacratissima"], "contexts": ["philosophical term for a substance"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Terra santa", "target_book": "english_physician_1652", "target_name": "Terra sacratissima", "similarity": 0.95}], "id": 929, "stable_key": "clu_6ab5f7beb1c91b8c", "ground_truth": {"modern_name": "Antimony", "confidence": "high", "type": "mineral", "description": "A metallic element, often prepared and used in alchemical and medicinal contexts.", "note": "Refers to preparations of antimony, often for alchemical or medicinal use.", "wikipedia_extract": "Antimony is a chemical element with the symbol Sb (from Latin  stibium) and atomic number 51. A lustrous grey metal or metalloid, it occurs in nature mainly in the form of the sulfide mineral stibnite (Sb2S3). Antimony compounds have been known since ancient times and were powdered for use as medicine and cosmetics, often known by the Arabic name kohl. China is the largest producer of antimony and its compounds, with most production coming from the Xikuangshan Mine in Hunan. The industrial methods for refining antimony from stibnite are roasting followed by reduction with carbon, or direct reduction of stibnite with iron. The most common applications for metallic antimony are in alloys with lead and tin, which have improved properties for solders, bullets, and plain bearings."}}, {"canonical_name": "Lancashire", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "lancashire", "book_id": "english_physician_1652", "name": "Lancashire", "category": "PLACE", "subcategory": "REGION", "count": 7, "variants": ["Lancashire", "Lanca͡shire"], "contexts": ["county where Red Bilberry grows", "region where narrow leaved Bistort grows"]}, {"entity_id": "lancashire", "book_id": "first_principles_spencer_1862", "name": "Lancashire", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Lancashire"], "contexts": ["region with social activities due to imported materials", "region with social activities"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Lancashire", "target_book": "first_principles_spencer_1862", "target_name": "Lancashire", "similarity": 1.0}], "id": 930, "stable_key": "clu_82c48720adfbce57", "ground_truth": {"modern_name": "Lancashire", "confidence": "high", "type": "place", "country": "United Kingdom", "wikipedia_extract": "Preston ( ) is a city on the north bank of the River Ribble in Lancashire, in North West England. The city is the administrative centre of the county of Lancashire and the wider City of Preston local government district. Preston and its surrounding district obtained city status in 2002, becoming England's 50th city in the 50th year of Queen Elizabeth II's reign. Preston had a population of 147,835 at the 2021 census, the City of Preston district 156,411 in 2023 and the Preston Built-up Area 313,322. The Preston Travel To Work Area, in 2011, had a population of 420,661, compared with 354,000 at the previous census. The south bank of the Ribble is part of the Preston urban area, although it forms the South Ribble borough that is administratively separate.", "wikipedia_url": "https://en.wikipedia.org/wiki/Preston,_Lancashire"}}, {"canonical_name": "Leguminosa", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "leguminosa", "book_id": "coloquios_da_orta_1563", "name": "Leguminosa", "category": "PLANT", "subcategory": "PLANT", "count": 7, "variants": ["Leguminosa", "Leguminosae", "Leguminosas", "Leguminosce", "Leguminosie", "Leguminosé", "leguminosa"], "contexts": ["seed of a leguminous plant", "Family of plants"]}, {"entity_id": "leguminosæ", "book_id": "origin_of_species_darwin_1859", "name": "Leguminosæ", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Leguminosæ"], "contexts": ["plant family with glands at stipule base", "plant family with manipulation difficulties"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Leguminosa", "target_book": "origin_of_species_darwin_1859", "target_name": "Leguminosæ", "similarity": 0.876}], "id": 931, "stable_key": "clu_ea9e79dde45933b1", "ground_truth": {"modern_name": "Fabaceae", "confidence": "high", "type": "plant", "family": "Fabaceae", "description": "A large and economically important family of flowering plants.", "note": "Also known as Leguminosae.", "wikipedia_extract": "Fabaceae or Leguminosae, commonly known as the legume, pea, or bean family, is a large and agriculturally important family of flowering plants. It includes trees, shrubs, and perennial or annual herbaceous plants, which are easily recognized by their fruit (legume) and their compound, stipulate leaves. The family is widely distributed, and is the third-largest land plant family in number of species, behind only the Orchidaceae and Asteraceae, with about 765 genera and nearly 20,000 known species. The five largest genera of the family are Astragalus (over 3,000 species), Acacia (over 1,000 species), Indigofera (around 700 species), Crotalaria (around 700 species), and Mimosa (around 400 species), which constitute about a quarter of all legume species. The c. 19,000 known legume species amount to about 7% of flowering plant species. Fabaceae is the most common family found in tropical rainforests and dry forests of the Americas and Africa."}}, {"canonical_name": "Micuipampa", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "micuipampa", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Micuipampa", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["Micuipampa", "Micaipampa", "Micuiparapa"], "contexts": ["Andes passage name", "location in the Andes"]}, {"entity_id": "micuipampa", "book_id": "kosmos_humboldt_1845", "name": "Micuipampa", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Micuipampa"], "contexts": ["location in Peruvian Andes"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Micuipampa", "target_book": "kosmos_humboldt_1845", "target_name": "Micuipampa", "similarity": 1.0}], "id": 932, "stable_key": "clu_3f4227ea64664bfd", "ground_truth": {"modern_name": "Micuipampa", "confidence": "high", "type": "place", "country": "Peru"}}, {"canonical_name": "Oural", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "oural", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Oural", "category": "PLACE", "subcategory": "REGION", "count": 7, "variants": ["Oural"], "contexts": ["mountains bordering Europe", "mountain range limit"]}, {"entity_id": "oural", "book_id": "kosmos_humboldt_1845", "name": "Oural", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Oural"], "contexts": ["mountain range and platinum district"]}, {"entity_id": "oural_mountains", "book_id": "kosmos_humboldt_1845", "name": "Oural Mountains", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Oural Mountains"], "contexts": ["location of ribbon jasper formation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oural", "target_book": "kosmos_humboldt_1845", "target_name": "Oural", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oural", "target_book": "kosmos_humboldt_1845", "target_name": "Oural Mountains", "similarity": 0.884}], "id": 933, "stable_key": "clu_5605b4913d6327dd", "ground_truth": {"modern_name": "Ural Mountains", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q23136011", "wikidata_description": "chronology of creation of settles by humans in the region from the Arctic Ocean in the north to the Ural River and northwestern modern Kazakhstan", "wikipedia_url": "https://en.wikipedia.org/wiki/History_of_human_settlement_in_the_Ural_Mountains", "wikipedia_extract": "The Ural Mountains ( YOOR-əl), or simply the Urals, are a mountain range in Eurasia that runs north–south mostly through Russia, from the coast of the Arctic Ocean to the river Ural and northwestern Kazakhstan. The mountain range forms part of the conventional boundary between the continents of Europe and Asia, marking the separation between European Russia and Siberia. Vaygach Island and the islands of Novaya Zemlya form continuations of the chain to the north into the Arctic Ocean. The average altitudes of the Urals are around 1,000–1,300 metres (3,300–4,300 ft), the highest point being Mount Narodnaya, which reaches a height of 1,894 metres (6,214 ft). The mountains lie within the Ural geographical region and significantly overlap with the Ural Federal District and the Ural economic region. Their resources include metal ores, coal, precious and semi-precious stones."}}, {"canonical_name": "Caxamarca", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "caxamarca", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Caxamarca", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Caxamarca", "Catamarca"], "contexts": ["location in the Andes", "region in the Andes"]}, {"entity_id": "caxamarca", "book_id": "kosmos_humboldt_1845", "name": "Caxamarca", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Caxamarca"], "contexts": ["location in Peruvian Andes", "location in South America"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Caxamarca", "target_book": "kosmos_humboldt_1845", "target_name": "Caxamarca", "similarity": 1.0}], "id": 934, "stable_key": "clu_9407cb2814463b5e", "ground_truth": {"modern_name": "Cajamarca", "confidence": "high", "type": "place", "country": "Peru", "wikidata_id": "Q205119", "wikidata_description": "capital city of Cajamarca, Peru", "wikipedia_url": "https://en.wikipedia.org/wiki/Cajamarca", "wikipedia_extract": "Cajamarca (Spanish pronunciation: [kaxaˈmaɾka]), also known by the Quechua name, Kashamarka, is the capital and largest city of the Cajamarca Region as well as an important cultural and commercial center in the northern Andes. It is located in the northern highlands of Peru at approximately 2,750 m (8,900 ft) above sea level in the valley of the Mashcon river. Cajamarca had an estimated population of about 226,031 inhabitants in 2015, making it the 13th largest city in Peru. Cajamarca has a mild highland climate, and the area has very fertile soil. The city is well known for its dairy products and mining activity in the surroundings. Among its tourist attractions, Cajamarca has numerous examples of Spanish colonial religious architecture, beautiful landscapes, pre-Hispanic archeological sites and hot springs at the nearby town of Baños del Inca (Baths of the Inca)."}}, {"canonical_name": "las Trincheras", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "las_trincheras", "book_id": "relation_historique_humboldt_vol3_1825", "name": "las Trincheras", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["Las Trincheras", "las Trincheras"], "contexts": ["near Portocabello, location of sulfurous waters", "location of hot springs"]}, {"entity_id": "las_trincheras", "book_id": "kosmos_humboldt_1845", "name": "Las Trincheras", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Las Trincheras"], "contexts": ["location with granite ledges", "location of thermal springs"]}, {"entity_id": "las_tricheras", "book_id": "kosmos_humboldt_1845", "name": "Las Tricheras", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Las Tricheras"], "contexts": ["location of thermal springs"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "las Trincheras", "target_book": "kosmos_humboldt_1845", "target_name": "Las Trincheras", "similarity": 0.991}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "las Trincheras", "target_book": "kosmos_humboldt_1845", "target_name": "Las Tricheras", "similarity": 0.922}], "id": 935, "stable_key": "clu_7d46b3e801d26c86", "ground_truth": {"modern_name": "Las Trincheras", "confidence": "high", "type": "place", "country": "Venezuela", "wikidata_id": "Q65059480", "wikidata_description": "place in Carabobo, Venezuela", "wikipedia_url": "https://en.wikipedia.org/wiki/Venezuelan_independence", "wikipedia_extract": "The Venezuelan Independence was the juridical-political process that put an end to the ties between the Captaincy General of Venezuela and the Spanish Empire. It also implied the replacement of the absolute monarchy by the republic as the form of government in Venezuela. The independence of Venezuela produced the armed conflict known as the Venezuelan War of Independence between the independence army or Patriotas (\"patriots\") and the royalist army or Realistas (\"royalists\"). On July 5, 1811, the independence declaration is signed. That day is celebrated in Venezuela as its national day. On that date formally, through the document \"Acta de Declaración de Independencia\", Venezuela separates from Spain."}}, {"canonical_name": "Saurians", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "saurians", "book_id": "kosmos_humboldt_1845", "name": "Saurians", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["Saurians", "saurians"], "contexts": ["extinct reptile group", "gigantic animals"]}, {"entity_id": "saurian", "book_id": "kosmos_humboldt_1845", "name": "Saurian", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["Saurian"], "contexts": ["extinct reptile group"]}, {"entity_id": "saurian", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Saurian", "category": "ANIMAL", "subcategory": "REPTILE", "count": 2, "variants": ["saurian", "Saurian"], "contexts": ["reptile tribes differ in species globally", "reptilian creatures like crocodiles and lizards"]}, {"entity_id": "saurian_reptiles", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Saurian reptiles", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["Saurian reptiles"], "contexts": ["distinct tribes of reptiles"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Saurians", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Saurian", "similarity": 0.859}, {"source_book": "kosmos_humboldt_1845", "source_name": "Saurians", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Saurian reptiles", "similarity": 0.848}, {"source_book": "kosmos_humboldt_1845", "source_name": "Saurian", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Saurian", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Saurian", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Saurian reptiles", "similarity": 0.929}], "id": 936, "stable_key": "clu_5e0a975e93e3f1e0", "ground_truth": {"modern_name": "Saurians", "confidence": "high", "type": "animal"}}, {"canonical_name": "Tortola", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "tortola", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tortola", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Tortola", "ToRTOLA", "Torlugas", "Tortuga"], "contexts": ["island name", "island in the English Antilles"]}, {"entity_id": "tordesillas", "book_id": "coloquios_da_orta_1563", "name": "Tordesillas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Tordesillas"], "contexts": ["Location of a treaty in 1494", "treaty defining geographical limits"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tortola", "target_book": "coloquios_da_orta_1563", "target_name": "Tordesillas", "similarity": 0.928}], "id": 937, "stable_key": "clu_68ba64b97df8e902", "ground_truth": {"modern_name": "Tortola", "confidence": "high", "type": "place", "description": "The largest island in the British Virgin Islands.", "note": "Tordesillas refers to a treaty, not a place.", "wikipedia_extract": "Tortola () is the largest and most populated island of the British Virgin Islands, a group of islands that form part of the archipelago of the Virgin Islands. It has a surface area of 55.7 square kilometres (21.5 square miles) with a total population of 23,908, with 9,400 residents in Road Town. Mount Sage is its highest point at 530 metres (1,740 feet) above sea level. Although the British Virgin Islands (BVI) are under the British flag, it uses the U.S. dollar as its official currency due to its proximity to and frequent trade with the U.S. Virgin Islands and Puerto Rico. The island is home to many offshore companies that do business worldwide."}}, {"canonical_name": "Arica", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "arica", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Arica", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Arica"], "contexts": ["city in Chile", "port city"]}, {"entity_id": "acra", "book_id": "coloquios_da_orta_1563", "name": "Acra", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Acra"], "contexts": ["Mediterranean port", "city spices were transported to"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Arica", "target_book": "coloquios_da_orta_1563", "target_name": "Acra", "similarity": 0.851}], "id": 938, "stable_key": "clu_454effa4174eda08", "ground_truth": {"modern_name": "Arica", "confidence": "high", "type": "place", "description": "A port city in northern Chile.", "note": "Acra is likely referring to Acre, a port city.", "wikipedia_extract": "Arica ( ə-REE-kə; Spanish: [aˈɾika]) is a commune and a port city with a population of 241,653 in the Arica Province of northern Chile's Arica y Parinacota Region. It is Chile's northernmost city, being located only 18 km (11 mi) south of the border with Peru. The city is the capital of both the Arica Province and the Arica and Parinacota Region. Arica is located at the bend of South America's western coast known as the Arica Bend or Arica Elbow. At the location of the city are two valleys that dissect the Atacama Desert converge: Azapa and Lluta. These valleys provide citrus and olives for export."}}, {"canonical_name": "Hispaniola", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "hispaniola", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Hispaniola", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Hispaniola", "Hispaniens"], "contexts": ["island in the Caribbean", "island governed by Ovando"]}, {"entity_id": "espailola", "book_id": "coloquios_da_orta_1563", "name": "Espailola", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Espailola", "Espafiola", "Espaflola", "Espafíola"], "contexts": ["island where first tree was created", "island in the Americas"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hispaniola", "target_book": "coloquios_da_orta_1563", "target_name": "Espailola", "similarity": 0.883}], "id": 939, "stable_key": "clu_0da8678610da2178", "ground_truth": {"modern_name": "Hispaniola", "confidence": "high", "type": "place", "description": "An island in the Greater Antilles, shared by Haiti and the Dominican Republic.", "wikipedia_extract": "Hispaniola is an island in the Greater Antilles of the Caribbean, located between Cuba and Puerto Rico. It is the most populous island in the West Indies and the second-largest by land area, after Cuba. Covering an area of 76,192-square-kilometre (29,418 sq mi), it is divided into two separate sovereign countries: the Spanish-speaking Dominican Republic (48,445 km2 (18,705 sq mi)) to the east and the French and Haitian Creole–speaking Haiti (27,750 km2 (10,710 sq mi)) to the west. The only other divided island in the Caribbean is Saint Martin, which is shared between France (Saint Martin) and the Netherlands (Sint Maarten). At the time of the European arrival of Christopher Columbus, Hispaniola was home to the Ciguayo, Macorix, and Ciboney and Classic Taíno native peoples. Hispaniola is the site of the first European fort in the Americas, La Navidad (1492–1493), the first settlement, La Isabela (1493–1500), and the first permanent settlement, the capital of the Dominican Republic, Santo Domingo (1498–present)."}}, {"canonical_name": "Badajoz", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "badajoz", "book_id": "coloquios_da_orta_1563", "name": "Badajoz", "category": "PLACE", "subcategory": "CITY", "count": 8, "variants": ["Badajoz"], "contexts": ["Location of commissioners' meeting", "city where commissioners met"]}, {"entity_id": "uadajoz", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Uadajoz", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Uadajoz"], "contexts": ["Town near the Rio Caya congress"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Badajoz", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Uadajoz", "similarity": 0.842}], "id": 940, "stable_key": "clu_5a5c5903e9d64f44", "ground_truth": {"modern_name": "Badajoz", "confidence": "high", "type": "place", "description": "City in southwestern Spain, near the Portuguese border.", "wikipedia_extract": "Badajoz is the capital of the province of Badajoz in the autonomous community of Extremadura, Spain. It is situated close to the Portuguese border, on the left bank of the river Guadiana. The population in 2011 was 151,565. Badajoz (Baṭalyaws) was founded by Ibn Marwan towards 875. In the 11th century, it became the seat of the Taifa of Badajoz, noted as a hub for (high) cultural production under the Aftasids despite military and political unstability. Badajoz was conquered by the Kingdom of León in 1230, becoming a royal demesne and seat of an opulent diocese."}}, {"canonical_name": "Tripoli", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "tripoli", "book_id": "coloquios_da_orta_1563", "name": "Tripoli", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Tripoli"], "contexts": ["city spices were transported to", "city mentioned in footnote"]}, {"entity_id": "tripoli", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tripoli", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Tripoli"], "contexts": ["city with sugar consumption"]}, {"entity_id": "tripoli_da_syria", "book_id": "coloquios_da_orta_1563", "name": "Tripoli da Syria", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Tripoli da Syria", "Tripol de Berbaria", "Tripoli de Suria"], "contexts": ["Mediterranean port", "city in Syria"]}, {"entity_id": "tripol", "book_id": "coloquios_da_orta_1563", "name": "Tripol", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Tripol"], "contexts": ["city in Syria"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Tripoli", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Tripoli", "similarity": 0.878}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tripoli", "target_book": "coloquios_da_orta_1563", "target_name": "Tripoli da Syria", "similarity": 0.868}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tripoli", "target_book": "coloquios_da_orta_1563", "target_name": "Tripol", "similarity": 0.898}], "id": 941, "stable_key": "clu_8ddb7e54c60db64b", "ground_truth": {"modern_name": "Tripoli", "confidence": "high", "type": "place", "description": "Mediterranean port cities in Libya and Lebanon.", "note": "Refers to both Tripoli in Libya and Tripoli (also known as Tarabulus al-Sham or Tripoli of Syria) in Lebanon.", "wikipedia_extract": "Tripoli, historically known as Tripoli-of-the-West, is the capital and largest city of Libya, with a population of about 1.317 million people in 2021. It is located in the northwest of Libya on the edge of the desert, on a point of rocky land projecting into the Mediterranean Sea and forming a bay. It includes the port of Tripoli and the country's largest commercial and manufacturing center. It is also the site of the University of Tripoli. Tripoli was founded in the 7th century BC by the Phoenicians, who gave it the Libyco-Berber name Oyat (Punic: 𐤅𐤉‬‬𐤏‬𐤕, romanized: Wyʿt), before passing into the hands of the Greek rulers of Cyrenaica as Oea (Ancient Greek: Ὀία, romanized: Oía). Due to the city's long history, there are many sites of archeological significance in Tripoli."}}, {"canonical_name": "Burmá", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "burmá", "book_id": "coloquios_da_orta_1563", "name": "Burmá", "category": "PLACE", "subcategory": "COUNTRY", "count": 8, "variants": ["Burmá", "Burma"], "contexts": ["country in Southeast Asia", "region discussed in dr. Mason's book"]}, {"entity_id": "birmans", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Birmans", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Birmans"], "contexts": ["land where salses were discovered"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Burmá", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Birmans", "similarity": 0.924}], "id": 942, "stable_key": "clu_2f4cc83076127832", "ground_truth": {"modern_name": "Burma", "confidence": "high", "type": "place", "description": "A country in Southeast Asia, now officially Myanmar.", "note": "Burma is the historical name for the country now officially known as Myanmar.", "wikipedia_extract": "Myanmar, officially the Republic of the Union of Myanmar and also referred to as Burma (the official English name until 1989), is a country in northwest Southeast Asia. It is the largest country by area in Mainland Southeast Asia and has a population of about 55 million. It is bordered by India and Bangladesh to the northwest, China to the northeast, Laos and Thailand to the east and southeast, and the Andaman Sea and the Bay of Bengal to the south and southwest. The country's capital city is Naypyidaw, while its largest city is Yangon (formerly Rangoon). Early civilisations in the area included the Tibeto-Burman-speaking Pyu city-states in Upper Myanmar and the Mon kingdoms in Lower Myanmar. In the 9th century, the Bamar people entered the upper Irrawaddy valley, and following the establishment of the Pagan Kingdom in the 1050s, the Burmese language and culture and Theravada Buddhism slowly became dominant in the country."}}, {"canonical_name": "madrépores", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "madrépores", "book_id": "relation_historique_humboldt_vol3_1825", "name": "madrépores", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 8, "variants": ["madrépores"], "contexts": ["marine invertebrates forming reefs", "fossil organism, first traces of organization"]}, {"entity_id": "madrepores", "book_id": "connexion_physical_sciences_somerville_1858", "name": "madrepores", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["madrepores"], "contexts": ["marine invertebrates forming reefs"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "madrépores", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "madrepores", "similarity": 0.86}], "id": 943, "stable_key": "clu_89127756043f1c90", "ground_truth": {"modern_name": "Madreporaria", "confidence": "high", "type": "animal", "note": "Refers to stony corals, a subclass of Anthozoa.", "wikidata_id": "Q137922301", "wikidata_description": "scholarly article published on 28 October 1939", "wikipedia_extract": "Scleractinia, also called stony corals or hard corals, are marine animals in the phylum Cnidaria that build themselves a hard skeleton. The individual animals are known as polyps and have a cylindrical body crowned by an oral disc in which a mouth is fringed with tentacles. Although some species are solitary, most are colonial. The founding polyp settles and starts to secrete calcium carbonate to protect its soft body. Solitary corals can be as much as 25 cm (10 in) across but in colonial species the polyps are usually only a few millimetres in diameter. These polyps reproduce asexually by budding, but remain attached to each other, forming a multi-polyp colony of clones with a common skeleton, which may be up to several metres in diameter or height according to species."}}, {"canonical_name": "Julho", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "julho", "book_id": "polyanthea_medicinal", "name": "Julho", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["Julho"], "contexts": ["month of July", "month"]}, {"entity_id": "julia", "book_id": "kosmos_humboldt_1845", "name": "Julia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Julia"], "contexts": ["island elevated by volcanic activity"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Julho", "target_book": "kosmos_humboldt_1845", "target_name": "Julia", "similarity": 0.854}], "id": 944, "stable_key": "clu_ea485f89f312a74e", "ground_truth": {"modern_name": "July", "confidence": "high", "type": "concept", "note": "The first mention clearly refers to the month of July. The second mention, 'Julia', when associated with an island elevated by volcanic activity, is likely a misinterpretation or archaic naming, but 'July' as a month is the dominant and clear referent.", "wikidata_id": "Q121", "wikidata_description": "seventh month of the year in the Julian and Gregorian calendars", "wikipedia_extract": "July is the seventh month of the year in the Julian and Gregorian calendars. Its length is 31 days. It was named by the Roman Senate in honour of Roman general and statesman Julius Caesar in 44 B.C., being the month of his birth. Before then it was called Quintilis, being the fifth month of the calendar that started with March. It is on average the warmest month in most of the Northern Hemisphere, where it is the second month of summer, and the coldest month in much of the Southern Hemisphere, where it is the second month of winter. The second half of the year commences in July."}}, {"canonical_name": "α Lyræ", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "α_lyræ", "book_id": "connexion_physical_sciences_somerville_1858", "name": "α Lyræ", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["α Lyræ"], "contexts": ["star that will become polar star", "first magnitude star"]}, {"entity_id": "a_lyrae", "book_id": "kosmos_humboldt_1845", "name": "a Lyrae", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["a Lyrae"], "contexts": ["fixed star for light travel time measurement"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "α Lyræ", "target_book": "kosmos_humboldt_1845", "target_name": "a Lyrae", "similarity": 0.956}], "id": 945, "stable_key": "clu_ce0bc094e5198ea0", "ground_truth": {"modern_name": "Alpha Lyrae", "confidence": "high", "type": "place", "wikidata_id": "Q3427", "wikidata_description": "star in the constellation Lyra", "wikipedia_extract": "A pole star is a visible star that is approximately aligned with the axis of rotation of an astronomical body; that is, a star whose apparent position is close to one of the celestial poles. On Earth, a pole star would lie directly overhead when viewed from the North or the South Pole. Currently, Earth's pole stars are Polaris (Alpha Ursae Minoris), a bright magnitude 2 star aligned approximately with its northern axis that serves as a pre-eminent star in celestial navigation, and a much dimmer magnitude 5.5 star on its southern axis, Polaris Australis (Sigma Octantis). From around 1700 BC until just after 300 AD, Kochab (Beta Ursae Minoris) and Pherkad (Gamma Ursae Minoris) were twin northern pole stars, though neither was as close to the pole as Polaris is now. In classical antiquity, Beta Ursae Minoris (Kochab) was closer to the celestial north pole than Alpha Ursae Minoris. While there was no naked-eye star close to the pole, the midpoint between Alpha and Beta Ursae Minoris was reasonably close to the pole, and it appears that the entire constellation of Ursa Minor, in antiquity known as Cynosura (Greek Κυνόσουρα \"dog's tail\"), was used as indicating the northern direction for the purposes of navigation by the Phoenicians.", "wikipedia_url": "https://en.wikipedia.org/wiki/Vega"}}, {"canonical_name": "Spiga Nardi", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "spiga_nardi", "book_id": "ricettario_fiorentino_1597", "name": "Spiga Nardi", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["Spiga Nardi", "JSpigo nardi", "Spiga nar di", "Spiga nardi", "Spigo nardi", "spigo nardi"], "contexts": ["plant with fragrant root", "spikenard"]}, {"entity_id": "spique_nardi", "book_id": "historia_medicinal_monardes_1574", "name": "Spique nardi", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Spique nardi"], "contexts": ["spikenard, mixed with balm for application"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Spiga Nardi", "target_book": "historia_medicinal_monardes_1574", "target_name": "Spique nardi", "similarity": 0.917}], "id": 946, "stable_key": "clu_8b7a24f843c81527", "ground_truth": {"modern_name": "Spikenard", "confidence": "high", "type": "plant", "description": "An aromatic herb used in traditional medicine and perfumery.", "note": "Botanical identification is complex, but commonly associated with species in the family Araliaceae or Apiaceae.", "wikipedia_extract": "Spikenard, also called nard, nardin, and muskroot, is a class of aromatic amber-colored essential oil derived from Nardostachys jatamansi, a flowering plant in the honeysuckle family which grows in the Himalayas of Nepal, China, and India. The oil has been used over centuries as a perfume, a traditional medicine, or in religious ceremonies across a wide territory from India to Europe. Historically, the name nard has also referred to essential oils derived from other species including the closely related valerian genus, as well as Spanish lavender; these cheaper, more common plants have been used in perfume-making, and sometimes to adulterate true spikenard. The name nard is derived from Latin nardus, from Ancient Greek νάρδος (nárdos), from  Hebrew: נֵרְדְּ (nērd). This word may ultimately derive either from Sanskrit नलद (nálada 'Indian spikenard'), or from Naarda, an ancient Assyrian city (possibly the modern town of Dohuk, Iraq). The \"spike\" in the English name refers to the inflorescence or flowering stem of the plant."}}, {"canonical_name": "poluo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "poluo", "book_id": "historia_medicinal_monardes_1574", "name": "poluo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 8, "variants": ["poluo", "poluora"], "contexts": ["powder", "powder made from a fruit pit"]}, {"entity_id": "poluere", "book_id": "ricettario_fiorentino_1597", "name": "poluere", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["poluere"], "contexts": ["powder substance"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "poluo", "target_book": "ricettario_fiorentino_1597", "target_name": "poluere", "similarity": 0.911}], "id": 947, "stable_key": "clu_4ecafb38691a65da", "ground_truth": {"modern_name": "Powder", "confidence": "high", "type": "substance", "description": "A dry, granular substance, often finely ground.", "note": "Refers to a finely divided solid material.", "wikipedia_extract": "A powder is a dry solid composed of many very fine particles that may flow freely when shaken or tilted. Powders are a special sub-class of granular materials, although the terms powder and granular are sometimes used to distinguish separate classes of material. In particular, powders refer to those granular materials that have the finer grain sizes, and that therefore have a greater tendency to form clumps when flowing. Granulars refer to the coarser granular materials that do not tend to form clumps except when wet. Many manufactured goods come in powder form, such as flour, sugar, ground coffee, powdered milk, copy machine toner, gunpowder, cosmetic powders, and some pharmaceuticals. In nature, dust, fine sand and snow, volcanic ash, and the top layer of the lunar regolith are also examples."}}, {"canonical_name": "desmayos", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "desmayos", "book_id": "historia_medicinal_monardes_1574", "name": "desmayos", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 6, "variants": ["desmayos", "defmayos"], "contexts": ["fainting spells", "frequent fainting spells"]}, {"entity_id": "deſmayos", "book_id": "polyanthea_medicinal", "name": "deſmayos", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 3, "variants": ["deſmayos", "dematoſo"], "contexts": ["fainting spells", "symptom of pestilence"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "desmayos", "target_book": "polyanthea_medicinal", "target_name": "deſmayos", "similarity": 0.906}], "id": 948, "stable_key": "clu_0f610d8342ed4247", "ground_truth": {"modern_name": "fainting", "confidence": "high", "type": "disease", "description": "Sudden loss of consciousness, often brief, due to temporary lack of blood flow to the brain.", "wikipedia_extract": "Syncope (), commonly known as fainting or passing out, is a loss of consciousness and muscle strength characterized by a fast onset, short duration, and spontaneous recovery. It is caused by a decrease in blood flow to the brain, typically from low blood pressure. There are sometimes symptoms before the loss of consciousness such as lightheadedness, sweating, pale skin, blurred vision, nausea, vomiting, or feeling warm. Syncope may also be associated with a short episode of muscle twitching. Psychiatric causes can also be determined when a patient experiences fear, anxiety, or panic; particularly before a stressful event, usually medical in nature. When consciousness and muscle strength are not completely lost, it is called presyncope."}}, {"canonical_name": "Eupatorio", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "eupatorio", "book_id": "ricettario_fiorentino_1597", "name": "Eupatorio", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["Eupatorio", "Eufatorio"], "contexts": ["herb used in decoctions", "ingredient in decoction"]}, {"entity_id": "eupatorío", "book_id": "coloquios_da_orta_1563", "name": "eupatorío", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["eupatorío", "eupatorio"], "contexts": ["herb with doubtful knowledge", "plant name"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Eupatorio", "target_book": "coloquios_da_orta_1563", "target_name": "eupatorío", "similarity": 0.84}], "id": 949, "stable_key": "clu_5641acde14bebd77", "ground_truth": {"modern_name": "Eupatorium", "confidence": "high", "type": "plant", "family": "Asteraceae", "description": "A genus of flowering plants, some species used in traditional medicine.", "wikipedia_extract": "Eupatorium is a genus of flowering plants in the family Asteraceae, containing from 36 to 60 species depending on the classification system. Most are herbaceous perennials growing to 0.5–3 m (1.6–9.8 ft) tall. A few are shrubs. The genus is native to temperate regions of the Northern Hemisphere. The type species of the genus Eupatorium cannabinum, which is also the sole European species, is known as hemp-agrimony. Most in North America are commonly called boneset, thoroughwort or snakeroot."}}, {"canonical_name": "Palestina", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "palestina", "book_id": "coloquios_da_orta_1563", "name": "Palestina", "category": "PLACE", "subcategory": "REGION", "count": 8, "variants": ["Palestina", "Pales-tina"], "contexts": ["region where benjuy is traded", "place where mungo is found"]}, {"entity_id": "palestina", "book_id": "polyanthea_medicinal", "name": "Palestina", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Palestina"], "contexts": ["place where miracle did not occur"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Palestina", "target_book": "polyanthea_medicinal", "target_name": "Palestina", "similarity": 0.889}], "id": 950, "stable_key": "clu_e2adec3c9feb0437", "ground_truth": {"modern_name": "Palestine", "confidence": "high", "type": "place", "description": "Geographic region in the Middle East, historically significant for trade and religious importance.", "wikipedia_extract": "Palestine, officially the State of Palestine, is a country in West Asia. It encompasses the Israeli-occupied West Bank, including East Jerusalem, and the Gaza Strip, collectively known as the Palestinian territories. The territories share the vast majority of their borders with Israel, with the West Bank bordering Jordan to the east and the Gaza Strip bordering Egypt to the southwest. It has a total land area of 6,020 square kilometres (2,320 sq mi) while its population exceeds five million. Its proclaimed capital is Jerusalem, while Ramallah serves as its de facto administrative center. Gaza was its largest city prior to evacuations in 2023."}}, {"canonical_name": "seda", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "seda", "book_id": "coloquios_da_orta_1563", "name": "seda", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 8, "variants": ["seda", "seda da china", "seda solta", "seda tecida"], "contexts": ["fibrous material from silkworms", "textile material traded"]}, {"entity_id": "seda", "book_id": "polyanthea_medicinal", "name": "seda", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["seda"], "contexts": ["silk"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "seda", "target_book": "polyanthea_medicinal", "target_name": "seda", "similarity": 1.0}], "id": 951, "stable_key": "clu_75c5859898e54609", "ground_truth": {"modern_name": "silk", "confidence": "high", "type": "object", "description": "A natural protein fiber produced by certain insect larvae, spun into a soft, lustrous textile.", "note": "Refers to the material produced by silkworms.", "wikipedia_extract": "Silk is a natural protein fiber, some forms of which can be woven into textiles. The protein fiber of silk is composed mainly of fibroin. It is most commonly produced by certain insect larvae to form cocoons. The best-known silk is obtained from the cocoons of the larvae of the mulberry silkworm Bombyx mori, which are reared in captivity (sericulture). The shimmery appearance of silk is due to the triangular prism-like structure of the silk fiber, which causes silk cloth to refract incoming light at different angles, thus producing different colors. Harvested silk is produced by numerous insects; generally, only the silk of various moth caterpillars has been used for textile manufacturing."}}, {"canonical_name": "Margarita", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "margarita", "book_id": "coloquios_da_orta_1563", "name": "Margarita", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 8, "variants": ["margarita", "Margarita"], "contexts": ["topic related to aljôfar", "Latin name for small pearl"]}, {"entity_id": "margarita", "book_id": "polyanthea_medicinal", "name": "Margarita", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Margarita"], "contexts": ["pearl, used in medicine"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Margarita", "target_book": "polyanthea_medicinal", "target_name": "Margarita", "similarity": 1.0}], "id": 952, "stable_key": "clu_8b527c0d02d86d1c", "ground_truth": {"modern_name": "pearl", "confidence": "high", "type": "mineral", "description": "A hard, glistening object produced within the soft tissue of a living shelled mollusk.", "wikipedia_extract": "A pearl is a hard, glistening object produced within the soft tissue (specifically the mantle) of a living shelled mollusk or another animal, such as fossil  conulariids. Just like the shell of a mollusk, a pearl is composed of calcium carbonate (mainly aragonite or a mixture of aragonite and calcite) in minute crystalline form, which has deposited in concentric layers. More commercially valuable pearls are perfectly round and smooth, but many other shapes, known as baroque pearls, can occur. The finest quality of natural pearls have been highly valued as gemstones and objects of beauty for many centuries. Because of this, pearl has become a metaphor for something rare, fine, admirable, and valuable. The most valuable pearls occur spontaneously in the wild but are extremely rare."}}, {"canonical_name": "Espique", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "espique", "book_id": "coloquios_da_orta_1563", "name": "Espique", "category": "PLANT", "subcategory": "PLANT", "count": 8, "variants": ["Espique", "espique"], "contexts": ["plant with very bad smell", "merchandise from Guzarate"]}, {"entity_id": "espes", "book_id": "polyanthea_medicinal", "name": "Espes", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Espes"], "contexts": ["plant with stomachic properties"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Espique", "target_book": "polyanthea_medicinal", "target_name": "Espes", "similarity": 0.849}], "id": 953, "stable_key": "clu_f09febc69e28630a", "ground_truth": {"modern_name": "Spike Lavender", "confidence": "medium", "type": "plant", "linnaean": "Lavandula latifolia", "family": "Lamiaceae", "description": "A fragrant herb with aromatic properties, used in perfumes and traditional remedies.", "note": "Refers to 'Espique' which is likely a variant of Spike Lavender (Lavandula latifolia) or a related aromatic plant. 'Espes' in Polyanthea Medicinal could refer to the same plant or a similar one with stomachic properties.", "wikipedia_extract": "Lavandula latifolia, known as broadleaved lavender, spike lavender, aspic lavender or Portuguese lavender, is a flowering plant in the family Lamiaceae, native to the western Mediterranean basin. Hybridization can occur in the wild with English lavender (Lavandula angustifolia). The scent of Lavandula latifolia is stronger, with more camphor, and more pungent than Lavandula angustifolia scent. Lavandula latifolia is a strongly aromatic shrub growing to 30–80 cm tall. The leaves are evergreen, 3–6 cm long and 5–8 mm broad. The flowers are pale lilac, produced on spikes 2–5 cm long at the top of slender, leafless stems 20–50 cm long."}}, {"canonical_name": "aguila", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "aguila", "book_id": "coloquios_da_orta_1563", "name": "aguila", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 5, "variants": ["aguila", "Aguila"], "contexts": ["substance that smells better when dry", "aloes wood, likely aquilaria"]}, {"entity_id": "aguia", "book_id": "polyanthea_medicinal", "name": "Aguia", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 4, "variants": ["Aguia"], "contexts": ["eagle stone that facilitates childbirth", "eagle, associated with a stone"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "aguila", "target_book": "polyanthea_medicinal", "target_name": "Aguia", "similarity": 0.843}], "id": 954, "stable_key": "clu_0680e0d79a0ad9e7", "ground_truth": {"modern_name": "Agarwood", "confidence": "medium", "type": "plant", "linnaean": "Aquilaria", "family": "Thymelaeaceae", "description": "Resinous wood produced by Aquilaria trees, highly valued for its fragrance.", "note": "The term 'aguila' in this context likely refers to agarwood ('aloes wood'), rather than the bird 'eagle'. The context 'substance that smells better when dry' points to agarwood's characteristic aroma. 'Aguia' in Polyanthea Medicinal might be a disambiguation or a different association with eagles, but the primary context in 'coloquios_da_orta' leans towards agarwood.", "wikipedia_extract": "Aquilaria is a genus of trees, called lign aloes or lign-aloes trees, in the family Thymelaeaceae. It includes 21 species native to southeast Asia. They occur particularly in the rainforests of Indonesia, Thailand, Cambodia, Laos, Vietnam, southern China, Malaysia, Northeast India, Bangladesh, the Philippines, Borneo and New Guinea. The trees grow to 6–20 m (20–66 ft) tall. The leaves are alternate, 5–11 cm (2.0–4.3 in) long and 2–4 cm (0.79–1.6 in) broad, with a short acuminate apex and an entire margin. The flowers are yellowish-green, produced in an umbel; the fruit is a woody capsule 2.5–3 cm (0.98–1.2 in) long."}}, {"canonical_name": "cevada", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "cevada", "book_id": "coloquios_da_orta_1563", "name": "cevada", "category": "PLANT", "subcategory": "PLANT", "count": 5, "variants": ["cevada"], "contexts": ["barley, an ingredient", "grain used in a preparation for pain relief"]}, {"entity_id": "cevada_deſcalcada", "book_id": "polyanthea_medicinal", "name": "cevada deſcalcada", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["cevada deſcalcada"], "contexts": ["hulled barley used in baths", "peeled barley used in a decoction"]}, {"entity_id": "cevacia", "book_id": "polyanthea_medicinal", "name": "cevacia", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["cevacia"], "contexts": ["herb used in a decoction"]}, {"entity_id": "cevadá", "book_id": "polyanthea_medicinal", "name": "cevadá", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["cevadá"], "contexts": ["grain used in decoction"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "cevada", "target_book": "polyanthea_medicinal", "target_name": "cevada deſcalcada", "similarity": 0.814}, {"source_book": "coloquios_da_orta_1563", "source_name": "cevada", "target_book": "polyanthea_medicinal", "target_name": "cevacia", "similarity": 0.891}, {"source_book": "coloquios_da_orta_1563", "source_name": "cevada", "target_book": "polyanthea_medicinal", "target_name": "cevadá", "similarity": 0.972}], "id": 955, "stable_key": "clu_4f24a21053ea7b30", "ground_truth": {"modern_name": "Barley", "confidence": "high", "type": "PLANT", "linnaean": "Hordeum vulgare", "family": "Poaceae", "description": "Grain used as food and for medicinal preparations.", "wikipedia_extract": "Barley (Hordeum vulgare), a member of the grass family, is a major cereal grain grown in temperate climates globally. One of the first cultivated grains, it was domesticated in the Fertile Crescent around 9000 BC, giving it nonshattering spikelets and making it much easier to harvest. Its use then spread throughout Eurasia by 2000 BC. Barley prefers relatively low temperatures and well-drained soil to grow. It is relatively tolerant of drought and soil salinity, but is less winter-hardy than wheat or rye. In 2023, barley was fourth among grains in quantity produced, 146 million tonnes, behind maize, rice, and wheat."}}, {"canonical_name": "Veado", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "veado", "book_id": "polyanthea_medicinal", "name": "Veado", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 5, "variants": ["Veado", "veado", "veados"], "contexts": ["deer, source of bone", "deer"]}, {"entity_id": "veados", "book_id": "coloquios_da_orta_1563", "name": "veados", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 4, "variants": ["Veados", "veados"], "contexts": ["animals found in abundance", "deer found in the island's thickets"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Veado", "target_book": "coloquios_da_orta_1563", "target_name": "veados", "similarity": 0.905}], "id": 956, "stable_key": "clu_0a2b19428d91b1fd", "ground_truth": {"modern_name": "Deer", "confidence": "high", "type": "ANIMAL", "family": "Cervidae", "description": "Hoofed mammals hunted for meat and other products.", "wikipedia_extract": "A deer (pl.: deer) or true deer is a hoofed ruminant ungulate of the family Cervidae (informally the deer family). Cervidae is divided into subfamilies Cervinae (which includes, among others, muntjac, elk (wapiti), red deer, and fallow deer) and Capreolinae (which includes, among others reindeer (caribou), white-tailed deer, roe deer, and moose). Male deer of almost all species (except the water deer), as well as female reindeer, grow and shed new antlers each year. These antlers are bony extensions of the skull and are often used for combat between males. The musk deer (Moschidae) of Asia and chevrotains (Tragulidae) of tropical African and Asian forests are separate families that are also in the ruminant clade Ruminantia; they are not especially closely related to Cervidae. Deer appear in art from Paleolithic cave paintings onwards, and they have played a role in mythology, religion, and literature throughout history, as well as in heraldry, such as red deer that appear in the coat of arms of Åland."}}, {"canonical_name": "sabugueyro", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "sabugueyro", "book_id": "polyanthea_medicinal", "name": "sabugueyro", "category": "PLANT", "subcategory": "PLANT", "count": 5, "variants": ["sabugueyro", "Sabugueyro"], "contexts": ["elder tree, its leaves used as remedy", "plant used in medicine"]}, {"entity_id": "sabugueiro", "book_id": "coloquios_da_orta_1563", "name": "sabugueiro", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["sabugueiro"], "contexts": ["tree compared to casto tree", "elder tree"]}, {"entity_id": "sabuguo", "book_id": "coloquios_da_orta_1563", "name": "sabuguo", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["sabuguo"], "contexts": ["plant with similar fruit"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "sabugueyro", "target_book": "coloquios_da_orta_1563", "target_name": "sabugueiro", "similarity": 0.876}, {"source_book": "polyanthea_medicinal", "source_name": "sabugueyro", "target_book": "coloquios_da_orta_1563", "target_name": "sabuguo", "similarity": 0.863}], "id": 957, "stable_key": "clu_a847399f69dfa99f", "ground_truth": {"modern_name": "Elder", "confidence": "high", "type": "PLANT", "linnaean": "Sambucus nigra", "family": "Viburnaceae", "description": "Shrub or tree with medicinal uses for its leaves and fruit.", "note": "Also known as 'sabugueyro' or 'sabugueiro'.", "wikipedia_extract": "Sambucus nigra is a species complex of flowering plants in the family Viburnaceae native to most of Europe. Common names include elder, elderberry, black elder, European elder,  European elderberry, and European black elderberry. It grows in a variety of conditions including both wet and dry fertile soils, primarily in sunny locations. The plant is widely grown as an  ornamental shrub or small tree. Both the flowers and the berries have a long tradition of culinary use, primarily for cordial and wine. Although the plant is commonly used in dietary supplements and traditional medicine, there is no  scientific evidence that it provides any significant health benefit."}}, {"canonical_name": "cavallo marinho", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "cavallo_marinho", "book_id": "polyanthea_medicinal", "name": "cavallo marinho", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 4, "variants": ["cavallo marinho", "CavalloMarinho", "cavallo Marinho"], "contexts": ["animal product used in medicine", "marine horse, worn around waist during pregnancy"]}, {"entity_id": "cavallo_marinho", "book_id": "coloquios_da_orta_1563", "name": "cavallo marinho", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 3, "variants": ["cavallo marinho"], "contexts": ["sea horse, mentioned for comparison", "animal Orta said hippopotamus was not"]}, {"entity_id": "pelle_de_cavallo_marinho", "book_id": "polyanthea_medicinal", "name": "pelle de cavallo marinho", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["pelle de cavallo marinho"], "contexts": ["skin of a sea horse"]}, {"entity_id": "priapodo_cavallo_marinho", "book_id": "polyanthea_medicinal", "name": "priapodo cavallo marinho", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["priapodo cavallo marinho"], "contexts": ["sea horse, used in medicine"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "cavallo marinho", "target_book": "coloquios_da_orta_1563", "target_name": "cavallo marinho", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "cavallo marinho", "target_book": "polyanthea_medicinal", "target_name": "pelle de cavallo marinho", "similarity": 0.846}, {"source_book": "coloquios_da_orta_1563", "source_name": "cavallo marinho", "target_book": "polyanthea_medicinal", "target_name": "priapodo cavallo marinho", "similarity": 0.852}], "id": 958, "stable_key": "clu_37b52b1057ed5c51", "ground_truth": {"modern_name": "Seahorse", "confidence": "high", "type": "ANIMAL", "linnaean": "Hippocampus spp.", "family": "Syngnathidae", "description": "Marine fish used in medicine and for comparison.", "wikipedia_extract": "A seahorse (also written sea-horse and sea horse) is any of 46 species of small marine bony fish in the genus Hippocampus. The genus name comes from the Ancient Greek hippókampos (ἱππόκαμπος), itself from híppos (ἵππος) meaning \"horse\" and kámpos (κάμπος) meaning \"sea monster\" or \"sea animal\". Having a head and neck suggestive of a horse, seahorses also feature segmented bony armour, an upright posture and a curled prehensile tail. Along with the pipefishes and seadragons (Phycodurus and Phyllopteryx) they form the family Syngnathidae. Anatomical evidence, supported by molecular, physical, and genetic evidence, demonstrates that seahorses are highly modified pipefish. The fossil record of seahorses, however, is very sparse."}}, {"canonical_name": "cera branca", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "cera_branca", "book_id": "polyanthea_medicinal", "name": "cera branca", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 7, "variants": ["cera branca", "cera amarella", "cera vermelha"], "contexts": ["base for an emplaster", "white wax"]}, {"entity_id": "cera", "book_id": "coloquios_da_orta_1563", "name": "cera", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 2, "variants": ["cera"], "contexts": ["alternative to lacre for sealing", "material used to make fruit replicas"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "cera branca", "target_book": "coloquios_da_orta_1563", "target_name": "cera", "similarity": 0.867}], "id": 959, "stable_key": "clu_8b9b0b45e3d0b88d", "ground_truth": {"modern_name": "White wax", "confidence": "high", "type": "SUBSTANCE", "description": "A substance derived from bees, used in medicinal preparations.", "wikipedia_extract": "Chinese wax, insect wax (Chinese: 蟲蠟), whitewax or pela (Chinese: 白蠟) is a white to yellowish-white, gelatinous, crystalline water-insoluble substance obtained from the wax secreted by certain insects. It may be used for the production of candles and polishes, and for the sizing of paper. It resembles spermaceti but is harder, more friable, and with a higher melting point. Two scale insects produce the wax: Ceroplastes ceriferus, common in China and India, and the related Ericerus pela, found in China and Japan. These insects deposit their secretions on the branches of certain species of Ligustrum (privet) tree. The insects and their secretions are harvested and boiled with water to extract the raw wax."}}, {"canonical_name": "espargos", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "espargos", "book_id": "polyanthea_medicinal", "name": "espargos", "category": "PLANT", "subcategory": "PLANT", "count": 8, "variants": ["espargos", "esparagos", "esparrago"], "contexts": ["asparagus, root used in preparation", "food with deobstructing properties"]}, {"entity_id": "esparegos", "book_id": "coloquios_da_orta_1563", "name": "esparegos", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["esparegos"], "contexts": ["herb from terra firme"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "espargos", "target_book": "coloquios_da_orta_1563", "target_name": "esparegos", "similarity": 0.947}], "id": 960, "stable_key": "clu_e95dbad60ce0c8bf", "ground_truth": {"modern_name": "Asparagus", "confidence": "high", "type": "PLANT", "linnaean": "Asparagus officinalis", "family": "Asparagaceae", "description": "A plant whose roots and shoots are used as food and medicine.", "wikipedia_extract": "Asparagus (Asparagus officinalis) or garden asparagus is a perennial flowering plant species in the genus Asparagus native to Eurasia. Widely cultivated as a vegetable crop, its young shoots are used as a spring vegetable. Asparagus is an herbaceous, perennial plant growing typically to 100–150 centimetres (3–5 feet) tall, with stout stems with much-branched, feathery foliage. It has been known to grow as long as 3.5 metres (11 ft). The 'leaves' are needle-like cladodes (modified stems) in the axils of scale leaves; they are 6–32 millimetres (1⁄4–1+1⁄4 inches) long and 1 mm (1⁄32 in) broad, and clustered in fours, up to 15, together, in a rose-like shape. The root system, often referred to as a 'crown', is adventitious; the root type is fasciculated."}}, {"canonical_name": "Tintura", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "tintura", "book_id": "polyanthea_medicinal", "name": "Tintura", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 8, "variants": ["Tintura", "tinctura", "tintura", "tintura de alambre", "tintura de aço azul", "tinturado"], "contexts": ["made of silver for drowsiness", "extract from plants"]}, {"entity_id": "tinta", "book_id": "coloquios_da_orta_1563", "name": "tinta", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["tinta"], "contexts": ["substance from trees or bushes"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Tintura", "target_book": "coloquios_da_orta_1563", "target_name": "tinta", "similarity": 0.919}], "id": 961, "stable_key": "clu_db8c6f501bab656b", "ground_truth": {"modern_name": "Tincture", "confidence": "high", "type": "SUBSTANCE", "description": "An alcoholic extract of plant material or other substances.", "wikipedia_extract": "A tincture is typically an extract of plant or animal material dissolved in ethanol (ethyl alcohol). Solvent concentrations of 25–60% are common, but may run as high as 90%. In chemistry, a tincture is a solution that has ethanol as its solvent. In herbal medicine, alcoholic tinctures are made with various ethanol concentrations, which should be at least 20% alcohol for preservation purposes. Other solvents for producing tinctures include vinegar, glycerol (also called glycerine), diethyl ether and propylene glycol, not all of which can be used for internal consumption. Ethanol has the advantage of being an excellent solvent for both acidic and basic (alkaline) constituents."}}, {"canonical_name": "verde", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "verde", "book_id": "polyanthea_medicinal", "name": "verde", "category": "PLANT", "subcategory": "PLANT", "count": 8, "variants": ["verde", "Verdeal", "Verdezella", "verdeaes", "verdeal", "verdezelha"], "contexts": ["green substance", "type of fruit"]}, {"entity_id": "verdegamtre", "book_id": "coloquios_da_orta_1563", "name": "verdegamtre", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["verdegamtre"], "contexts": ["Spanish name for Heileb&nUf"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "verde", "target_book": "coloquios_da_orta_1563", "target_name": "verdegamtre", "similarity": 0.822}], "id": 962, "stable_key": "clu_f23f802a96234dd5", "ground_truth": {"modern_name": "Green", "confidence": "low", "type": "CONCEPT", "description": "A color or a type of fruit, often associated with plants.", "note": "This cluster seems to represent the color green and potentially a specific type of green fruit, but the 'verdegamtre' is an obscure reference.", "wikipedia_extract": "Green is the color between cyan and yellow on the visible spectrum. It is evoked by light which has a dominant wavelength of roughly 495–570 nm. In subtractive color systems, used in painting and color printing, it is created by a combination of yellow and cyan; in the RGB color model, used on television and computer screens, it is one of the additive primary colors, along with red and blue, which are mixed in different combinations to create all other colors. By far the largest contributor to green in nature is chlorophyll, the chemical by which plants photosynthesize and convert sunlight into chemical energy. Many creatures have adapted to their green environments by taking on a green hue themselves as camouflage. Several minerals have a green color, including the emerald, which is colored green by its chromium content."}}, {"canonical_name": "Cufcuta", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "cufcuta", "book_id": "ricettario_fiorentino_1597", "name": "Cufcuta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["Cufcuta", "Cufcqta", "Cufuta", "Culcuta", "Cuscuta"], "contexts": ["plant similar to Epithymo", "herb used in decoctions"]}, {"entity_id": "cufcuta", "book_id": "polyanthea_medicinal", "name": "cufcuta", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["cufcuta"], "contexts": ["cuscuta used in a syrup"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Cufcuta", "target_book": "polyanthea_medicinal", "target_name": "cufcuta", "similarity": 0.88}], "id": 963, "stable_key": "clu_ee38b5113b369343", "ground_truth": {"modern_name": "Cuscuta", "confidence": "high", "type": "plant", "linnaean": "Cuscuta spp.", "family": "Convolvulaceae", "description": "A genus of parasitic plants, commonly known as dodder or strangle-vine.", "wikipedia_extract": "Cuscuta (), commonly known as dodder or amarbel, is a genus of over 201 species of yellow, orange, or red (rarely green) parasitic plants. Formerly treated as the only genus in the family Cuscutaceae, it now is accepted as belonging in the morning glory family, Convolvulaceae, on the basis of the work of the Angiosperm Phylogeny Group. The genus is found throughout the temperate and tropical regions of the world, with the greatest species diversity in subtropical and tropical regions; the genus becomes rare in cool temperate climates, with only four species native to northern Europe. Folk names include strangle tare, strangleweed, scaldweed, beggarweed, lady's laces, fireweed, wizard's net, devil's guts, devil's hair, devil's ringlet, goldthread, hailweed, hairweed, hellbine, love vine, pull-down, angel hair, and witch's hair. Cuscuta can be identified by its thin stems appearing leafless, with the leaves reduced to minute scales. In these respects it closely resembles the similarly parasitic, but unrelated genus, Cassytha."}}, {"canonical_name": "linimento", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "linimento", "book_id": "polyanthea_medicinal", "name": "linimento", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 8, "variants": ["linimento", "hum linimento", "linimento das almorreymas", "linimento magistral"], "contexts": ["liniment named number 4 for itching", "medicinal ointment"]}, {"entity_id": "linimenti", "book_id": "ricettario_fiorentino_1597", "name": "linimenti", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["linimenti"], "contexts": ["liniments, a type of compound medicine"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "linimento", "target_book": "ricettario_fiorentino_1597", "target_name": "linimenti", "similarity": 0.954}], "id": 964, "stable_key": "clu_258f40b47fba7eec", "ground_truth": {"modern_name": "Liniment", "confidence": "high", "type": "substance", "description": "A liquid or semi-liquid preparation rubbed on the skin as an anodyne or embrocation.", "wikipedia_extract": "Liniment (from Latin: linere, meaning \"to smear, anoint\"), also called embrocation and heat rub, is a medicated topical preparation for application to the skin. Some liniments have a viscosity similar to that of water; others are lotion or balm; still, others are in transdermal patches, soft solid sticks, and sprays. Liniment usually is rubbed into the skin, which the active ingredients penetrate. Liniments are typically sold to relieve pain and stiffness, such as from muscular aches and strains, and arthritis. These are typically formulated from alcohol, acetone, or similar quickly evaporating solvents and contain counterirritant aromatic chemical compounds, such as methyl salicylate, benzoin resin, menthol, and capsaicin. They produce a feeling of warmth within the muscle of the area they are applied to, typically acting as rubefacients via a counterirritant effect."}}, {"canonical_name": "Garlick", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "garlick", "book_id": "english_physician_1652", "name": "Garlick", "category": "PLANT", "subcategory": "PLANT", "count": 6, "variants": ["Garlick"], "contexts": ["herb", "used as remedy"]}, {"entity_id": "garlick", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Garlick", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Garlick"], "contexts": ["herb affecting loadstone attraction", "used to excite needles"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Garlick", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Garlick", "similarity": 0.907}], "id": 965, "stable_key": "clu_63a0332561a4cc66", "ground_truth": {"modern_name": "Garlic", "confidence": "high", "type": "plant", "linnaean": "Allium sativum Linnaeus", "family": "Amaryllidaceae", "wikidata_id": "Q23400", "wikidata_description": "species of plant (for the food, use Q21546392)", "wikipedia_url": "https://en.wikipedia.org/wiki/Garlic", "wikipedia_extract": "Garlic (Allium sativum) is a species of bulbous flowering plants in the genus Allium. Its close relatives include the onion, shallot, leek, chives, Welsh onion, and Chinese onion. Garlic is native to central and western Asia, stretching from the Black Sea through the southern Caucasus, northeastern Iran, and the Hindu Kush. It has naturalized in many other parts of the world, including Mediterranean Europe and China. There are two subspecies and hundreds of varieties of garlic. Garlic has been used for thousands of years as a seasoning, culinary ingredient, and traditional medical remedy."}}, {"canonical_name": "Lice", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "lice", "book_id": "english_physician_1652", "name": "Lice", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 7, "variants": ["Lice"], "contexts": ["condition treated by bark in vinegar", "parasitic insects"]}, {"entity_id": "lice", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Lice", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["Lice"], "contexts": ["animated from corrupt humours in man"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Lice", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Lice", "similarity": 0.86}], "id": 966, "stable_key": "clu_153d1018caff0106", "ground_truth": {"modern_name": "Lice", "confidence": "high", "type": "animal", "wikidata_id": "Q6481228", "wikidata_description": "order of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Head_lice_infestation", "wikipedia_extract": "Head lice infestation, also known as pediculosis capitis, is the infection of the head hair and scalp by the head louse (Pediculus humanus capitis). Itching from lice bites is common. During a person's first infection, the itch may not develop for up to six weeks. If a person is infected again, symptoms may begin much more quickly. The itch may cause problems with sleeping. Generally, however, it is not a serious condition."}}, {"canonical_name": "Hens", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "hens", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hens", "category": "ANIMAL", "subcategory": "BIRD", "count": 3, "variants": ["Hens"], "contexts": ["have peculiar vermine", "fail in Cocks and Hens"]}, {"entity_id": "hen", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hen", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["Hen"], "contexts": ["female chicken", "bird used for hatching other species' eggs"]}, {"entity_id": "heron", "book_id": "origin_of_species_darwin_1859", "name": "Heron", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["Heron", "heron"], "contexts": ["bird that might fly long distances", "bird eating seed"]}, {"entity_id": "herons", "book_id": "origin_of_species_darwin_1859", "name": "Herons", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Herons"], "contexts": ["wading birds that eat fish"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hens", "target_book": "origin_of_species_darwin_1859", "target_name": "Heron", "similarity": 0.865}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hens", "target_book": "origin_of_species_darwin_1859", "target_name": "Herons", "similarity": 0.867}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hen", "target_book": "origin_of_species_darwin_1859", "target_name": "Heron", "similarity": 0.877}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hen", "target_book": "origin_of_species_darwin_1859", "target_name": "Herons", "similarity": 0.858}], "id": 967, "stable_key": "clu_033bc42393e623cf", "ground_truth": {"modern_name": "Chicken", "confidence": "high", "type": "animal", "note": "The cluster contains 'Hens'/'Hen' clearly referring to chickens, but also 'Heron'/'Herons' referring to the bird family Ardeidae. Given the dominance of 'Hens', the primary referent is likely chicken, with 'heron' being a secondary or potentially misidentified term within the same cluster.", "wikidata_id": "Q780", "wikidata_description": "domesticated bird kept by humans primarily as a food source", "wikipedia_url": "https://en.wikipedia.org/wiki/Chicken"}}, {"canonical_name": "Petrofellino", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "petrofellino", "book_id": "ricettario_fiorentino_1597", "name": "Petrofellino", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["Petrofellino", "Petrofelino Macedonico", "Petrofilio"], "contexts": ["Parsley, ingredient in syrup", "parsley herb"]}, {"entity_id": "petrofelino", "book_id": "polyanthea_medicinal", "name": "petrofelino", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["petrofelino"], "contexts": ["herb"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Petrofellino", "target_book": "polyanthea_medicinal", "target_name": "petrofelino", "similarity": 0.858}], "id": 968, "stable_key": "clu_fcb08df250329926", "ground_truth": {"modern_name": "Parsley", "confidence": "high", "type": "plant", "linnaean": "Petroselinum crispum", "family": "Apiaceae", "description": "An aromatic herb used in cooking and traditional medicine.", "wikipedia_extract": "Parsley, or garden parsley (Petroselinum crispum), is a species of flowering plant in the family Apiaceae that is native to the Balkans. It has been introduced and naturalized in Europe and elsewhere in the world with suitable climates, and is widely cultivated as a herb and a vegetable. It is believed to have been originally grown in Sardinia, and was cultivated in around the 3rd century BC. Linnaeus stated its wild habitat to be Sardinia, whence it was brought to England and apparently first cultivated in Britain in 1548, though literary evidence suggests parsley was used in England in the Middle Ages as early as the Anglo-Saxon period. Parsley is widely used in European, Middle Eastern, and American cuisine. Curly-leaf parsley is often used as a garnish."}}, {"canonical_name": "Athens", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "athens", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Athens", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Athens"], "contexts": ["city with a 'council of the bean'", "ancient Greek city"]}, {"entity_id": "athenas", "book_id": "polyanthea_medicinal", "name": "Athenas", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Athenas"], "contexts": ["city known for intelligent inhabitants", "city where plagues occurred"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Athens", "target_book": "polyanthea_medicinal", "target_name": "Athenas", "similarity": 0.991}], "id": 969, "stable_key": "clu_e698c0565b26a20e", "ground_truth": {"modern_name": "Athens", "confidence": "high", "type": "place", "country": "Greece", "wikidata_id": "Q203263", "wikidata_description": "consolidated city-county and county seat of Clarke County, Georgia, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Athens%2C%20Georgia"}}, {"canonical_name": "Jeru", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "jeru", "book_id": "coloquios_da_orta_1563", "name": "Jeru", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Jeru", "Jeru (Je-run ou Gerun)", "Jerun"], "contexts": ["island where junks entered", "island mentioned by Orta"]}, {"entity_id": "jerico", "book_id": "polyanthea_medicinal", "name": "Jerico", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Jerico", "Jericò"], "contexts": ["place associated with rose preserve", "city, waters were softened"]}, {"entity_id": "jezreel", "book_id": "polyanthea_medicinal", "name": "Jezreel", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Jezreel"], "contexts": ["place name"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Jeru", "target_book": "polyanthea_medicinal", "target_name": "Jerico", "similarity": 0.847}, {"source_book": "coloquios_da_orta_1563", "source_name": "Jeru", "target_book": "polyanthea_medicinal", "target_name": "Jezreel", "similarity": 0.89}], "id": 970, "stable_key": "clu_8386c6b7d540b437", "ground_truth": {"modern_name": "Jericho", "confidence": "medium", "type": "place", "description": "Ancient city known for its significance and geographical features.", "note": "Includes variations in spelling and potential geographical associations.", "wikipedia_extract": "Jericho ( JERR-ik-oh; Arabic: أريحا, romanized: Arīḥā, IPA: [ʔaˈriːħaː] ; Hebrew: יריחו) is a city in the West Bank, Palestine, and the capital of the Jericho Governorate. The city is located in the Jordan Valley, with the Jordan River to the east and Jerusalem to the west. Jericho is among the oldest cities in the world. Archaeologists have unearthed the remains of more than 20 successive settlements in Jericho, the first of which dates back 11,000 years (to 9000 BCE), almost to the very beginning of the Holocene epoch of the Earth's history. Copious springs in and around the city have attracted human habitation for thousands of years. Jericho is described in the Bible as the \"city of palm trees\"."}}, {"canonical_name": "quadrupedes", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "quadrupedes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "quadrupedes", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["Quadrupedes", "quadrupedes"], "contexts": ["animals with four legs", "four-legged animals with speech advantage"]}, {"entity_id": "quadrumana", "book_id": "first_principles_spencer_1862", "name": "quadrumana", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["quadrumana"], "contexts": ["primates with four grasping feet", "primate group with four grasping feet"]}, {"entity_id": "quadrupeds", "book_id": "first_principles_spencer_1862", "name": "quadrupeds", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["quadrupeds"], "contexts": ["four-footed animals", "animals with four feet"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "quadrupedes", "target_book": "first_principles_spencer_1862", "target_name": "quadrumana", "similarity": 0.944}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "quadrupedes", "target_book": "first_principles_spencer_1862", "target_name": "quadrupeds", "similarity": 0.99}], "id": 971, "stable_key": "clu_39b9fb6f8654f07e", "ground_truth": {"modern_name": "Quadruped", "confidence": "high", "type": "animal", "note": "The terms 'quadrupedes', 'quadrumana', and 'quadrupeds' all refer to four-limbed animals, with 'quadrumana' being a specific subgroup (primates with grasping feet).", "wikipedia_extract": "A tripod stance is a behaviour in which quadruped animals rear up on their hind legs and use their tail to support this position. Several animals use this behaviour to improve observation or surveillance, and during feeding, grooming, thermoregulation, or fighting. The common dwarf mongoose (Helogale parvula) adopts a tripod stance when being vigilant for predators. In a similar mammal, the thirteen-lined ground squirrel (Ictidomys tridecemlineatus), vigilance behaviour includes four postures: (1) quadrupedal alert (all four feet on the ground with head above the horizontal); (2) semiupright alert (on hind feet with a distinctive slouch); (3) upright alert (on hind feet with back straight and mostly perpendicular to the ground); (4) extended upright alert (similar to upright alert except that the squirrel extends its hind legs, (see image of meerkats). In meerkats (Suricata suricatta), the tripod stance may be adopted relatively briefly during foraging, in which case it is termed guarding behaviour, or for substantially longer periods when the animal is not foraging, in which case it is termed sentinel behaviour. Macropods can stand erect on their hind legs, supported by their tail as the third leg of the tripod.", "wikipedia_url": "https://en.wikipedia.org/wiki/Tripod_stance"}}, {"canonical_name": "Wasps", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "wasps", "book_id": "english_physician_1652", "name": "Wasps", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 6, "variants": ["Wasps", "Wasp"], "contexts": ["insect with sting", "insects whose stings are treated"]}, {"entity_id": "wasp", "book_id": "origin_of_species_darwin_1859", "name": "Wasp", "category": "ANIMAL", "subcategory": "INSECT", "count": 2, "variants": ["wasp", "Wasp"], "contexts": ["insect with a stinging tail", "sting of"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Wasps", "target_book": "origin_of_species_darwin_1859", "target_name": "Wasp", "similarity": 0.883}], "id": 972, "stable_key": "clu_ee1f2a4b635766eb", "ground_truth": {"modern_name": "Wasps", "confidence": "high", "type": "animal", "family": "Vespidae", "description": "Flying insects characterized by their narrow waists and stinging ability.", "wikipedia_extract": "A wasp is any insect of the narrow-waisted suborder Apocrita of the order Hymenoptera which is neither a bee nor an ant; this excludes the broad-waisted sawflies (Symphyta), which look somewhat like wasps, but are in a separate suborder. The wasps do not constitute a clade, a complete natural group with a single ancestor, as  bees and ants are deeply nested within the wasps, having evolved from wasp ancestors. Wasps that are members of the clade Aculeata can sting their prey. The most commonly known wasps, such as yellowjackets and hornets, are in the family Vespidae and are eusocial, living together in a nest with an egg-laying queen and non-reproducing workers. Eusociality is favoured by the unusual haplodiploid system of sex determination in Hymenoptera, as it makes sisters exceptionally closely related to each other. However, the majority of wasp species are solitary, with each adult female living and breeding independently."}}, {"canonical_name": "sharp", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "sharp", "book_id": "english_physician_1652", "name": "sharp", "category": "CONCEPT", "subcategory": "QUALITY", "count": 7, "variants": ["sharp", "Sharpness", "sharpness"], "contexts": ["taste quality of Water-Cresses", "quality of substance"]}, {"entity_id": "sharp", "book_id": "principles_of_psychology_james_1890", "name": "sharp", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["sharp"], "contexts": ["sensation of pointedness"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "sharp", "target_book": "principles_of_psychology_james_1890", "target_name": "sharp", "similarity": 1.0}], "id": 973, "stable_key": "clu_abb04f9fee69d789", "ground_truth": {"modern_name": "Sharp", "confidence": "high", "type": "concept", "description": "Possessing a keen edge or point; intense taste or sensation.", "wikipedia_extract": "Venomous Concept is an American hardcore punk band formed by Kevin Sharp of Brutal Truth and Shane Embury of Napalm Death in 2004. Sharp and Embury were joined by Danny Herrera and Buzz Osborne, who was later replaced by Danny Lilker. They have released five studio albums to date: Retroactive Abortion (2004), Poisoned Apple (2008), Kick Me Silly VCIII (2016), \"Politics Versus the Erection\" (2020) and \"The Good Ship Lollipop\" (2023). They have also released two split albums: one with Japanese grindcore band 324 (2006), and the other with Australian extreme metal band Blood Duster (2008). The band's name is a play on Poison Idea, in the style of name-mangling Japanese hardcore acts. In February 2004, Kevin Sharp was the tour driver for Napalm Death on The Art of Noise tour with Nile, Strapping Young Lad, Dark Tranquillity and The Berzerker."}}, {"canonical_name": "nardo", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "nardo", "book_id": "coloquios_da_orta_1563", "name": "nardo", "category": "PLANT", "subcategory": "PLANT", "count": 7, "variants": ["nardo", "nardos indicos"], "contexts": ["plant mentioned in relation to theofrasto", "plant compared to cacollá"]}, {"entity_id": "nardus", "book_id": "english_physician_1652", "name": "Nardus", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Nardus"], "contexts": ["plant with sweet smell for comparison"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "nardo", "target_book": "english_physician_1652", "target_name": "Nardus", "similarity": 0.874}], "id": 974, "stable_key": "clu_c2a7e6e4c090178c", "ground_truth": {"modern_name": "Spikenard", "confidence": "high", "type": "plant", "linnaean": "Nardostachys jatamansi", "family": "Caprifoliaceae", "description": "A fragrant plant from the Himalayas, used in perfumery and medicine.", "note": "Also known as 'nard' in some historical texts.", "wikipedia_extract": "Nardostachys is a genus of flowering plant in the honeysuckle family (Caprifoliaceae). Nardostachys jatamansi is the sole species in genus. It is a perennial that grows in the Himalayas, primarily in a belt through Kumaon, Nepal, Sikkim and Bhutan at elevations of 3,000–5,000 m (9,800–16,400 ft), and in northern Myanmar and western and central China. It is a source of a type of intensely aromatic amber-colored essential oil, spikenard. The oil has, since ancient times, been used as a perfume, as a traditional medicine, and in religious ceremonies. It is also called spikenard, nard, nardin, or muskroot."}}, {"canonical_name": "Faintings", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "faintings", "book_id": "english_physician_1652", "name": "Faintings", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 7, "variants": ["Faintings", "Fainting", "fainting", "faintings"], "contexts": ["condition of the stomach", "after childbirth"]}, {"entity_id": "faintness", "book_id": "polyanthea_medicinal", "name": "faintness", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["faintness"], "contexts": ["result of eating fungi"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Faintings", "target_book": "polyanthea_medicinal", "target_name": "faintness", "similarity": 0.908}], "id": 975, "stable_key": "clu_231ec9a0b2e2a72a", "ground_truth": {"modern_name": "Fainting", "confidence": "high", "type": "disease", "description": "A temporary loss of consciousness due to a sudden decrease in blood flow.", "wikipedia_extract": "Syncope (), commonly known as fainting or passing out, is a loss of consciousness and muscle strength characterized by a fast onset, short duration, and spontaneous recovery. It is caused by a decrease in blood flow to the brain, typically from low blood pressure. There are sometimes symptoms before the loss of consciousness such as lightheadedness, sweating, pale skin, blurred vision, nausea, vomiting, or feeling warm. Syncope may also be associated with a short episode of muscle twitching. Psychiatric causes can also be determined when a patient experiences fear, anxiety, or panic; particularly before a stressful event, usually medical in nature. When consciousness and muscle strength are not completely lost, it is called presyncope."}}, {"canonical_name": "Ly", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "ly", "book_id": "english_physician_1652", "name": "Ly", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 6, "variants": ["Ly"], "contexts": ["liquid used for boiling", "made from ash bark ashes"]}, {"entity_id": "leytes", "book_id": "polyanthea_medicinal", "name": "leytes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["leytes"], "contexts": ["milks", "milk-based preparations"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Ly", "target_book": "polyanthea_medicinal", "target_name": "leytes", "similarity": 0.847}], "id": 976, "stable_key": "clu_4bd846305b18e902", "ground_truth": {"modern_name": "Lye", "confidence": "high", "type": "chemical", "note": "The terms 'Ly' and 'leytes' in this context likely refer to alkaline solutions, such as lye, used in various preparations and as solvents.", "wikidata_id": "Q102769", "wikidata_description": "chemical compound", "wikipedia_extract": "Lye is the common name of various alkaline solutions, including soda lye (a solution of sodium hydroxide) and potash lye (a solution of potassium hydroxide). Lyes are used as cleaning products, as ingredients in soapmaking, and in various other contexts. The word lye derives from the root *lau, meaning to wash (compare lave, lather) and has cognates in all the Germanic languages. Traditionally, lye was made by leaching wood ashes in water, creating an alkaline liquor rich in potassium carbonate or potash. The alkalinity could be increased by adding slaked lime, which would cause the solute to become potassium hydroxide or caustic potash. Lyes are used to cure many types of food, including olives and cocoa (making them less bitter), canned mandarin oranges, lye rolls, century eggs, pretzels, candied pumpkins, and bagels."}}, {"canonical_name": "confeyção Alchermes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "confeyção_alchermes", "book_id": "polyanthea_medicinal", "name": "confeyção Alchermes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 7, "variants": ["confeyção Alchermes", "Confeyções de Alchermes", "confectionealchermes", "confeyçao de Alchermes", "confeyçaó de Alchermes", "confeyçoensde Alchermes"], "contexts": ["confectionery medicine", "compound medicine Alchermes confection"]}, {"entity_id": "confectio_alkerimes", "book_id": "english_physician_1652", "name": "Confectio Alkerimes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Confectio Alkerimes"], "contexts": ["compound medicine"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "confeyção Alchermes", "target_book": "english_physician_1652", "target_name": "Confectio Alkerimes", "similarity": 0.903}], "id": 977, "stable_key": "clu_afc78c2b6ba8652f", "ground_truth": {"modern_name": "Alchermes confection", "confidence": "high", "type": "substance", "description": "A historical medicinal cordial, often red in color, containing many ingredients.", "wikipedia_extract": "Alchermes (, Italian: [alˈkɛrmes]; from the Arabic: القرمز, romanized: al-qirmiz, lit. 'cochineal', from Persian: کرمست, romanized: kermest, lit. 'bloody, red, cochineal, carmine') is a type of Italian liqueur (especially in Tuscany, Emilia-Romagna, and Sicily) prepared by infusing neutral spirits with sugar, cinnamon, cloves, nutmeg, and vanilla, and other herbs and flavoring agents. Its most striking characteristic is its scarlet color, obtained by the addition of Kermes, a small scale insect from which the drink derives its name. Several proprietary variants are commercially available, where the coloring agent is a coal tar-derived dye such as E124 or E126, with alcoholic contents ranging from 21 to 32%. Its chief use is in coloring pastry, although a quick dessert is sometimes made by adding it to custard cream and sugar. In the Italian pudding zuppa inglese, sponge cake or ladyfingers soaked in this liqueur are a major ingredient. Alkermes was according to Ephraim Chamber's Cyclopaedia (1827), a modification of an 8th-century remedy namely Confectio Alkermes in the \"form and consistency of a confection\" (an electuary, which is thick and pasty)."}}, {"canonical_name": "mordaz", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "mordaz", "book_id": "polyanthea_medicinal", "name": "mordaz", "category": "CONCEPT", "subcategory": "QUALITY", "count": 7, "variants": ["mordaz"], "contexts": ["quality of humor", "sharp or biting quality"]}, {"entity_id": "mollesse", "book_id": "relation_historique_humboldt_vol3_1825", "name": "mollesse", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["mollesse"], "contexts": ["texture of the terrain"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "mordaz", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "mollesse", "similarity": 0.843}], "id": 978, "stable_key": "clu_4f2493c07fbf11ba", "ground_truth": {"modern_name": "pungent", "confidence": "medium", "type": "concept", "description": "Having a sharp, biting, or acrid smell or taste.", "note": "While 'mollesse' can refer to softness, in the context of terrain, it is more likely a mistranslation or an unusual usage. 'Mordaz' strongly suggests pungency or sharpness.", "wikipedia_extract": "Pungency (  PUN-jən-see), commonly referred to as spiciness, hotness or heat,  is a sensation that contributes to the flavor of certain foods such as chili peppers. Highly pungent foods may be experienced as unpleasant. The term piquancy ( PEEK-ən-see) is sometimes applied to foods with a lower degree of pungency that are \"agreeably stimulating to the palate\". In addition to chili peppers, piquant ingredients include wasabi, horseradish and mustard. The primary substances responsible for pungency are capsaicin (in chilis), piperine (in peppercorns) and allyl isothiocyanate (in radishes, mustard and wasabi). In colloquial speech, the term \"pungency\" can refer to any strong, sharp smell or flavor."}}, {"canonical_name": "Hoarsness", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "hoarsness", "book_id": "english_physician_1652", "name": "Hoarsness", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 7, "variants": ["Hoarsness", "Hoarceness", "Hoarcēness", "Hoarsness of the voice"], "contexts": ["vocal ailment", "symptom affecting the throat"]}, {"entity_id": "hoarseness", "book_id": "first_principles_spencer_1862", "name": "hoarseness", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["hoarseness"], "contexts": ["roughness of the voice"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Hoarsness", "target_book": "first_principles_spencer_1862", "target_name": "hoarseness", "similarity": 0.931}], "id": 979, "stable_key": "clu_c91a60e38056f19d", "ground_truth": {"modern_name": "Hoarseness", "confidence": "high", "type": "disease", "modern_term": "Hoarseness", "wikidata_id": "Q3930506", "wikidata_description": "voice characteristic of being hoarse or raucous"}}, {"canonical_name": "Aphides", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "aphides", "book_id": "origin_of_species_darwin_1859", "name": "Aphides", "category": "ANIMAL", "subcategory": "INSECT", "count": 7, "variants": ["Aphides", "aphides"], "contexts": ["small plant-sucking insects", "insects with notable instincts"]}, {"entity_id": "apis", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Apis", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["Apis"], "contexts": ["genus of bees"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Aphides", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Apis", "similarity": 0.859}], "id": 980, "stable_key": "clu_cf2a8e2c3a2ac88f", "ground_truth": {"modern_name": "aphids", "confidence": "high", "type": "animal", "description": "Small, soft-bodied insects that feed on plant sap.", "note": "'Apis' refers to bees, while 'Aphides' (plural of Aphid) are a distinct group of insects. The context of 'plant-sucking insects' confirms 'aphids'.", "wikipedia_extract": "Aphids are small sap-sucking insects in the family Aphididae. Common names include greenfly and blackfly, although individuals within a species can vary widely in color. The group includes the fluffy white woolly aphids. A typical life cycle involves flightless females giving live birth to female nymphs—who may also be already pregnant, an adaptation scientists call telescoping generations—without the involvement of males. Maturing rapidly, females breed profusely so that the number of these insects multiplies quickly. Winged females may develop later in the season, allowing the insects to colonize new plants."}}, {"canonical_name": "Melipona", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "melipona", "book_id": "origin_of_species_darwin_1859", "name": "Melipona", "category": "ANIMAL", "subcategory": "INSECT", "count": 4, "variants": ["Melipona"], "contexts": ["intermediate bee structure", "bee species that saves wax"]}, {"entity_id": "melipona_domestica", "book_id": "origin_of_species_darwin_1859", "name": "Melipona domestica", "category": "ANIMAL", "subcategory": "INSECT", "count": 2, "variants": ["Melipona domestica"], "contexts": ["species of bee", "bee species"]}, {"entity_id": "melipones", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Melipones", "category": "ANIMAL", "subcategory": "INSECT", "count": 2, "variants": ["Melipones"], "contexts": ["genus of bees", "bees producing wax in Mexico"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Melipona", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Melipones", "similarity": 0.94}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Melipona domestica", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Melipones", "similarity": 0.88}], "id": 981, "stable_key": "clu_67706966420e6e7e", "ground_truth": {"modern_name": "Melipona bees", "confidence": "high", "type": "animal", "family": "Apidae", "description": "Stingless bees known for producing wax and honey in various regions.", "note": "'Melipona' is a genus of stingless bees. 'Melipona domestica' is a species within this genus.", "wikipedia_extract": "Melipona is a genus of stingless bees, widespread in warm areas of the Neotropics, from Sinaloa and Tamaulipas (México) to Tucumán and Misiones (Argentina). About 70 species are known. The largest producer of honey from Melipona bees in Mexico is in the state of Yucatán where bees are studied at an interactive park called \"Bee Planet\" which is within the Cuxtal Ecological Reserve. Several species are kept for honey production, such as in Brazil, where some are well-known enough to have common names, including uruçu, mandaçaia, jandaíra, and manduri. Melipona honey has long been used by humans and now is of minor commercial importance. Research is going on in improved beekeeping techniques."}}, {"canonical_name": "Quindiù", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "quindiù", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Quindiù", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Quindiù", "Quindiii", "Quindià"], "contexts": ["passage name", "mountain range"]}, {"entity_id": "quindiu", "book_id": "kosmos_humboldt_1845", "name": "Quindiu", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Quindiu"], "contexts": ["mountain chain"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Quindiù", "target_book": "kosmos_humboldt_1845", "target_name": "Quindiu", "similarity": 0.967}], "id": 982, "stable_key": "clu_f52eccb6071b15e1", "ground_truth": {"modern_name": "Páramo de Sumapaz", "confidence": "medium", "type": "place", "country": "Colombia", "note": "Based on Humboldt's works and geographic descriptions, 'Quindiù' or 'Quindiu' most likely refers to the Páramo de Sumapaz, a high-altitude plateau region in the Colombian Andes.", "wikidata_id": "Q3411486", "wikidata_description": "mountain in Colombia", "wikipedia_extract": "Moorland or moor is a type of habitat found in upland areas in temperate grasslands, savannas, and shrublands and the biomes of montane grasslands and shrublands, characterised by low-growing vegetation on acidic soils. Moorland today generally means uncultivated hill land (such as Dartmoor in South West England), but also includes low-lying wetlands (such as Sedgemoor, also South West England). It is closely related to heath, although experts disagree on the exact distinction between these types of vegetation. Generally, moor refers to highland and high rainfall areas, while heath refers to lowland zones which are more likely to be the result of human activity. Moorland habitats are found mainly in tropical Africa, northern and western Europe, and South America. Most of the world's moorlands are diverse ecosystems.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sumapaz_P%C3%A1ramo"}}, {"canonical_name": "euphotide", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "euphotide", "book_id": "relation_historique_humboldt_vol3_1825", "name": "euphotide", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["euphotide", "euphotides"], "contexts": ["rock type", "rock type in Cuba"]}, {"entity_id": "uepheline", "book_id": "kosmos_humboldt_1845", "name": "uepheline", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["uepheline"], "contexts": ["mineral related to eleolite"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "euphotide", "target_book": "kosmos_humboldt_1845", "target_name": "uepheline", "similarity": 0.868}], "id": 983, "stable_key": "clu_da34a74471308a4d", "ground_truth": {"modern_name": "Nepheline", "confidence": "high", "type": "mineral", "note": "Euphotide is an archaic term for Nepheline, often encountered in older geological literature, especially in relation to Humboldt's travels. 'Uepheline' is a probable misspelling.", "wikidata_id": "Q407339", "wikidata_description": "tectosilicate mineral", "wikipedia_url": "https://en.wikipedia.org/wiki/Nepheline", "wikipedia_extract": "Nepheline (from Ancient Greek  νεφέλη (nephélē) 'cloud'), also called nephelite, is a rock-forming mineral in the feldspathoid group – a silica-undersaturated aluminosilicate (Na3KAl4Si4O16) that occurs in intrusive and volcanic rocks with low silica, and in their associated pegmatites. It is used in glass and ceramic manufacturing and other industries, and has been investigated as an ore of aluminium. Nepheline crystals are rare and belong to the hexagonal system, usually having the form of a short, six-sided prism terminated by the basal plane. The crystals appear to have more symmetry than they actually possess, but unsymmetrical etched figures produced artificially on the prism faces indicate that the crystals are hemimorphic and tetartohedral, the only element of symmetry being a polar hexad axis. Nepheline is found in compact, granular aggregates, and can be white, yellow, gray, green, or reddish. Its hardness on the Mohs scale is 5.5 to 6, and its specific gravity 2.60–2.65."}}, {"canonical_name": "Los Pastos", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "los_pastos", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Los Pastos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Los Pastos", "los Pastos"], "contexts": ["mountainous district in Spanish America", "province belonging to Quito"]}, {"entity_id": "los_pastos", "book_id": "kosmos_humboldt_1845", "name": "Los Pastos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Los Pastos"], "contexts": ["elevated plateau"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Los Pastos", "target_book": "kosmos_humboldt_1845", "target_name": "Los Pastos", "similarity": 1.0}], "id": 984, "stable_key": "clu_d5074ca64965aaef", "ground_truth": {"modern_name": "Los Pastos", "confidence": "high", "type": "place", "country": "Colombia", "note": "Los Pastos refers to a high-altitude plateau region in southwestern Colombia, known for its mountainous terrain.", "wikidata_id": "Q3897521", "wikidata_description": "", "wikipedia_extract": "Pasto, officially San Juan de Pasto (Spanish pronunciation: [saŋ ˈxwan de ˈpasto]; \"Saint John of Pasto\"), is the capital of the department of Nariño, in southern Colombia. Pasto was founded in 1537 and named after indigenous people of the area. In the 2018 census, the municipality had a population of 392,930. Pasto is located in the Atriz Valley on the Andes cordillera, at the foot of the Galeras volcano. The etymology of the word Pasto can be traced to the indigenous people who inhabited the region at the arrival of the Spanish conquerors, the Pastos. However, the Atriz Valley itself was inhabited by the Quillacingas.", "wikipedia_url": "https://en.wikipedia.org/wiki/Pasto,_Colombia"}}, {"canonical_name": "Strasbourg", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "strasbourg", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Strasbourg", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["STRASBOURG", "Strasbourg"], "contexts": ["location with barometer data", "location with latitude 48° 34' 56\""]}, {"entity_id": "strasburg", "book_id": "kosmos_humboldt_1845", "name": "Strasburg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Strasburg"], "contexts": ["location of an edition"]}, {"entity_id": "strasbourg", "book_id": "kosmos_humboldt_1845", "name": "Strasbourg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Strasbourg"], "contexts": ["city in France"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Strasbourg", "target_book": "kosmos_humboldt_1845", "target_name": "Strasburg", "similarity": 0.882}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Strasbourg", "target_book": "kosmos_humboldt_1845", "target_name": "Strasbourg", "similarity": 1.0}], "id": 985, "stable_key": "clu_bea8bd2758db347d", "ground_truth": {"modern_name": "Strasbourg", "confidence": "high", "type": "place", "country": "France", "wikidata_id": "Q6602", "wikidata_description": "capital and largest city of Grand Est, located in the historical region of Alsace", "wikipedia_url": "https://en.wikipedia.org/wiki/Strasbourg", "wikipedia_extract": "Strasbourg (UK:  STRAZ-burg, US:  STRAHSS-boorg, STRAHZ-, -⁠burg; French: [stʁasbuʁ] ; German: Straßburg [ˈʃtʁaːsbʊʁk] ) is the prefecture and largest city of the Grand Est region of eastern France, in the historic region of Alsace. It is the prefecture of the Bas-Rhin department and the official seat of the European Parliament. The city has about three hundred thousand inhabitants, and together Greater Strasbourg and the arrondissement of Strasbourg have over five hundred thousand. Strasbourg's metropolitan area had a population of 860,744 in 2020, making it the eighth-largest metro area in France and home to 14% of the Grand Est region's inhabitants. The transnational Eurodistrict Strasbourg-Ortenau had a population of roughly 1,000,000 in 2022. Strasbourg is one of the de facto four main capitals of the European Union (alongside Brussels, Luxembourg and Frankfurt), as it is the seat of several European institutions, such as the European Parliament, the Eurocorps and the European Ombudsman of the European Union."}}, {"canonical_name": "zechslein", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "zechslein", "book_id": "relation_historique_humboldt_vol3_1825", "name": "zechslein", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["zechslein", "zechatein", "zechsteiii"], "contexts": ["Zechstein formation", "formation du zechsteiii"]}, {"entity_id": "zechstein", "book_id": "kosmos_humboldt_1845", "name": "Zechstein", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["Zechstein", "zechstein"], "contexts": ["geological formation", "geological rock formation"]}, {"entity_id": "zechstone", "book_id": "kosmos_humboldt_1845", "name": "zechstone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["zechstone"], "contexts": ["geological rock formation"]}, {"entity_id": "zeckstein", "book_id": "kosmos_humboldt_1845", "name": "zeckstein", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["zeckstein"], "contexts": ["rock formation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "zechslein", "target_book": "kosmos_humboldt_1845", "target_name": "Zechstein", "similarity": 0.848}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "zechslein", "target_book": "kosmos_humboldt_1845", "target_name": "zechstone", "similarity": 0.86}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "zechslein", "target_book": "kosmos_humboldt_1845", "target_name": "zeckstein", "similarity": 0.841}], "id": 986, "stable_key": "clu_d23c09436593951f", "ground_truth": {"modern_name": "Zechstein Formation", "confidence": "high", "type": "mineral", "note": "Zechstein refers to a significant geological period and the associated rock strata, particularly relevant in European geology. 'zechslein', 'zechstone', and 'zeckstein' are variations of this term.", "wikidata_id": "Q98436573", "wikidata_description": "street in the city district of Davenstedt in Hanover, Germany", "wikipedia_extract": "The Zechstein Limestone Formation is a geologic formation in Germany. It preserves fossils dating back to the Permian period. List of fossiliferous stratigraphic units in Germany Various Contributors to the Paleobiology Database. \"Fossilworks: Gateway to the Paleobiology Database\". Archived from the original on 19 August 2022. Retrieved 17 December 2021.", "wikipedia_url": "https://en.wikipedia.org/wiki/Zechstein_Limestone_Formation"}}, {"canonical_name": "Portuguesa", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "portuguesa", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Portuguesa", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Portuguesa", "portugaises"], "contexts": ["river fertilizing western parts", "river, eastern limit"]}, {"entity_id": "portu", "book_id": "historia_medicinal_monardes_1574", "name": "Portu", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Portu"], "contexts": ["country associated with trade of Bezoar stones"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Portuguesa", "target_book": "historia_medicinal_monardes_1574", "target_name": "Portu", "similarity": 0.906}], "id": 987, "stable_key": "clu_0f8c2f02604cab9d", "ground_truth": {"modern_name": "Portuguesa River", "confidence": "high", "type": "place", "description": "A river, likely in Venezuela, associated with agricultural fertility.", "note": "While 'Portu' could refer to Portugal, the context of a river and its fertilizing properties in the Humboldt text points strongly to the Portuguesa River in Venezuela. The Monardes text also mentions trade from that region.", "wikipedia_extract": "The Portuguesa River (Spanish: Río Portuguesa, also Río la Portuguesa, Río de la Portuguesa) is a river of Venezuela. It is part of the Orinoco River basin, and is a tributary of the Apure River (which is, in turn, a tributary of the Orinoco). Legend has it that the river's name originated from a woman from Portugal who drowned in its waters. In turn, the river's name is the origin of the name of the Venezuelan state of Portuguesa. Rand McNally, The New International Atlas, 1993."}}, {"canonical_name": "Tuy", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "tuy", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tuy", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Tuy"], "contexts": ["the Tuy", "valley for sugar"]}, {"entity_id": "tiyu", "book_id": "coloquios_da_orta_1563", "name": "Tiyu", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Tiyu"], "contexts": ["port on the Malabar coast"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tuy", "target_book": "coloquios_da_orta_1563", "target_name": "Tiyu", "similarity": 0.846}], "id": 988, "stable_key": "clu_6a123a5c56f7582c", "ground_truth": {"modern_name": "Tuy", "confidence": "high", "type": "place", "description": "A port on the Malabar coast, also a valley for sugar.", "note": "Refers to a specific port and potentially a different geographical area used for agriculture.", "wikipedia_extract": "This is an incomplete list of humans and angels whom the Catholic Church has canonized as saints. According to Catholic theology, all saints enjoy the beatific vision. Many of the saints listed here are found in the General Roman Calendar, while others may also be found in the Roman Martyrology; still others are particular to local places or religious institutes and their recognition does not extend to the larger worldwide church. Candidates go through the following four steps on the way to being declared saints: People also accepted as saints in the Eastern Orthodox Church and other churches are listed in Category:Christian saints by century and/or Category:Christian saints by nationality. The following are an incomplete list of the martyrs venerated by the Catholic Church not individually named in the list above: First Martyrs of the Church of Rome (64 AD) Thirty Martyrs of the Appian Way (c. 304) — found in Roman Martyrology Martyrs of Persia under Shapur II (4th century) The Martyrs of Natal were a group of 30 Brazilian Catholics - two of them priests - killed in northern Brazil by a group of Dutch Calvinists in 1645. They were canonized on 15 October 2017 by Pope Francis."}}, {"canonical_name": "Encaramada", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "encaramada", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Encaramada", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Encaramada", "I'Encaramada"], "contexts": ["mission name", "geographic location"]}, {"entity_id": "encuama", "book_id": "coloquios_da_orta_1563", "name": "Encuama", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Encuama"], "contexts": ["a place near Sofala"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Encaramada", "target_book": "coloquios_da_orta_1563", "target_name": "Encuama", "similarity": 0.885}], "id": 989, "stable_key": "clu_f36e740c28c4590b", "ground_truth": {"modern_name": "Encaramada", "confidence": "high", "type": "place", "description": "A geographic location or mission name.", "note": "Contexts point to a named place, potentially a mission settlement or a specific area.", "wikipedia_extract": "SM Mall of Asia, also abbreviated as SM MoA, or simply Mall of Asia or MoA, [ˈmoː.ɐ], is a shopping mall in Bay City, Pasay, Philippines. It is located within the SM Central Business Park, a reclaimed area along Manila Bay, at the southern end of EDSA. The mall is owned and developed by SM Prime. Mall of Asia is the largest shopping mall in the Philippines, the second-largest in Southeast Asia after IOI City Mall in Malaysia, and the sixth-largest in the world. It currently occupies 16 hectares (40 acres) of land area and a gross floor area of approximately 589,891 m2 (6,349,530 sq ft), and offers 46,647 m2 (502,100 sq ft) of floor area space for conventions and social functions. Following the mall's opening in 2006, it caused several smaller shopping malls nearby to close, such as the Pearl Plaza and the Uniwide Coastal Mall, both located in nearby Barangay Tambo, Parañaque."}}, {"canonical_name": "Concan", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "concan", "book_id": "coloquios_da_orta_1563", "name": "Concan", "category": "PLACE", "subcategory": "REGION", "count": 6, "variants": ["Concan"], "contexts": ["coastline ruled by Melik Kálur", "region in India"]}, {"entity_id": "conchucos", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Conchucos", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Conchucos"], "contexts": ["location in the Andes", "region in the Andes"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Concan", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Conchucos", "similarity": 0.843}], "id": 990, "stable_key": "clu_e0419ad4ab9c5bad", "ground_truth": {"modern_name": "Concan", "confidence": "high", "type": "place", "description": "A region in India, including a coastline.", "note": "Refers to a geographical region in India, potentially also encompassing a part of the Andes.", "wikipedia_extract": "Concan is a small unincorporated community in Uvalde County, Texas, United States. The community sits along the Frio River, close to Garner State Park and is a popular destination for summer vacationers. It is known for excellent birdwatching in the spring. A Roy Bechtol-designed 18-hole golf course called Concan Country Club or the Golf Club at Concan is open to the public. The area is dominated by large cattle, sheep, and goat ranches, some of which date back to when German immigrants settled this area. Several outfitters in the area haul swimmers and tubers up the Frio River to designated drop-off points, then pick them up downstream."}}, {"canonical_name": "Companhia de JESUS", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "companhia_de_jesus", "book_id": "polyanthea_medicinal", "name": "Companhia de JESUS", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 7, "variants": ["Companhia de JESUS", "Companhiade JESU"], "contexts": ["religious order"]}, {"entity_id": "compailia_de_jésus", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Compailia de Jésus", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Compailia de Jésus"], "contexts": ["religious order"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Companhia de JESUS", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Compailia de Jésus", "similarity": 0.938}], "id": 991, "stable_key": "clu_8321d54ab4dca72b", "ground_truth": {"modern_name": "Company of Jesus", "confidence": "high", "type": "organization", "description": "A religious order, specifically the Jesuits.", "note": "Historical name for the Society of Jesus.", "wikipedia_extract": "The Society of Jesus (Latin: Societas Iesu; abbreviation: S.J. or SJ), also known as the Jesuit Order or the Jesuits ( JEZH-oo-its, JEZ-ew-; Latin: Iesuitae), is a religious order of clerics regular of pontifical right for men in the Catholic Church. Headquartered in Rome, it was founded in 1540 by Ignatius of Loyola and six companions, with the approval of Pope Paul III. The Society of Jesus is the largest Catholic religious order and has played a significant role in education, charity, humanitarian acts and global policies. Jesuits are engaged in evangelization and apostolic ministry in 112 countries, including education, research, and cultural pursuits. They also conduct retreats, minister in hospitals and parishes, sponsor direct social and humanitarian works, and promote ecumenical dialogue. The Society of Jesus is consecrated under the patronage of Madonna della Strada, a title of the Blessed Virgin Mary, and it is led by a superior general."}}, {"canonical_name": "spontaneous motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "spontaneous_motion", "book_id": "kosmos_humboldt_1845", "name": "spontaneous motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["spontaneous motion"], "contexts": ["motion without external cause", "question of inherent movement"]}, {"entity_id": "spontaneity", "book_id": "principles_of_psychology_james_1890", "name": "spontaneity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["spontaneity"], "contexts": ["acting on impulse", "natural or unforced action"]}, {"entity_id": "spontaneous_motion", "book_id": "principles_of_psychology_james_1890", "name": "spontaneous motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["spontaneous motion"], "contexts": ["motion not caused by external stimulus"]}, {"entity_id": "spontaneously", "book_id": "principles_of_psychology_james_1890", "name": "spontaneously", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["spontaneously"], "contexts": ["acting without external cause"]}, {"entity_id": "reactive_spontaneity", "book_id": "principles_of_psychology_james_1890", "name": "reactive spontaneity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["reactive spontaneity"], "contexts": ["active mental process"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "spontaneous motion", "target_book": "principles_of_psychology_james_1890", "target_name": "spontaneity", "similarity": 0.885}, {"source_book": "kosmos_humboldt_1845", "source_name": "spontaneous motion", "target_book": "principles_of_psychology_james_1890", "target_name": "spontaneous motion", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "spontaneous motion", "target_book": "principles_of_psychology_james_1890", "target_name": "spontaneously", "similarity": 0.895}, {"source_book": "kosmos_humboldt_1845", "source_name": "spontaneous motion", "target_book": "principles_of_psychology_james_1890", "target_name": "reactive spontaneity", "similarity": 0.846}], "id": 992, "stable_key": "clu_8951bf3e664e1864", "ground_truth": {"modern_name": "Spontaneous Motion", "confidence": "high", "type": "concept", "note": "In early modern texts, this often refers to motion not caused by external forces, a concept discussed in physics and later in psychology regarding volition and instinct.", "wikidata_id": "Q30528428", "wikidata_description": "scientific article published on November 7, 2012"}}, {"canonical_name": "Connecticut", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "connecticut", "book_id": "kosmos_humboldt_1845", "name": "Connecticut", "category": "PLACE", "subcategory": "COUNTRY", "count": 7, "variants": ["Connecticut"], "contexts": ["state where New Haven is located", "state in the United States"]}, {"entity_id": "connecticut", "book_id": "principles_of_psychology_james_1890", "name": "Connecticut", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Connecticut"], "contexts": ["state in the United States"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Connecticut", "target_book": "principles_of_psychology_james_1890", "target_name": "Connecticut", "similarity": 1.0}], "id": 993, "stable_key": "clu_45400baa003bf2b1", "ground_truth": {"modern_name": "Connecticut", "confidence": "high", "type": "place", "country": "United States", "wikidata_id": "Q379648", "wikidata_description": "river in the New England region of the United States", "wikipedia_extract": "Connecticut (  kə-NET-ih-kət) is a state in the New England region of the Northeastern United States. It borders Rhode Island to the east, Massachusetts to the north, New York to the west, and Long Island Sound to the south. Its capital is Hartford, and its most populous city is Bridgeport. Connecticut lies between the major hubs of New York City and Boston along the Northeast Corridor, where the New York-Newark Combined Statistical Area, which includes four of Connecticut's seven largest cities, extends into the southwestern part of the state. Connecticut is the third-smallest state by area after Rhode Island and Delaware, and the 29th most populous with more than 3.6 million residents as of 2024, ranking it fourth among the most densely populated U.S. states. The state is named after the Connecticut River, the longest in New England, which roughly bisects the state and drains into the Long Island Sound between the towns of Old Saybrook and Old Lyme."}}, {"canonical_name": "Pekin", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "pekin", "book_id": "kosmos_humboldt_1845", "name": "Pekin", "category": "PLACE", "subcategory": "CITY", "count": 7, "variants": ["Pekin"], "contexts": ["former name for Beijing", "end point of magnetic stations"]}, {"entity_id": "peking", "book_id": "coloquios_da_orta_1563", "name": "Peking", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Peking"], "contexts": ["city where J. Edkins is from"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Pekin", "target_book": "coloquios_da_orta_1563", "target_name": "Peking", "similarity": 0.959}], "id": 994, "stable_key": "clu_bc03092b1e3e2c2c", "ground_truth": {"modern_name": "Beijing", "confidence": "high", "type": "place", "country": "China", "note": "'Pekin' is an older variant spelling for Beijing, the capital of China.", "wikidata_id": "Q956", "wikidata_description": "capital city of China", "wikipedia_extract": "Beijing, previously romanized as Peking, is the capital city of China. With more than 22 million residents, it is the world's most populous national capital city, as well as China's second largest city by urban area, after Shanghai. It is located in Northern China, and is governed as a municipality under the direct administration of the State Council with 16 urban districts. Beijing is mostly surrounded by Hebei Province and neighbors Tianjin to the southeast; together, the three divisions form the Jing-Jin-Ji cluster. Beijing is a global city and one of the world's leading centres for culture, diplomacy, politics, finance, business and economics, education, research, language, tourism, media, sport, science and technology, transportation, and art. It is home to the headquarters of most of China's largest state-owned companies and houses the largest number of Fortune Global 500 companies in the world, as well as the world's four biggest financial institutions by total assets.", "wikipedia_url": "https://en.wikipedia.org/wiki/Beijing"}}, {"canonical_name": "Andromeda", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "andromeda", "book_id": "kosmos_humboldt_1845", "name": "Andromeda", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 7, "variants": ["Andromeda"], "contexts": ["plant species identified by Saunders", "myrtle-leaved social plant"]}, {"entity_id": "gamma_andromeda", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Gamma Andromeda", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Gamma Andromeda"], "contexts": ["star with observed colours"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Andromeda", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Gamma Andromeda", "similarity": 0.88}], "id": 995, "stable_key": "clu_d67e88aa8af151ca", "ground_truth": {"modern_name": "Andromeda (star or constellation)", "confidence": "low", "type": "animal", "note": "The context 'plant species identified by Saunders' is highly unusual if 'Andromeda' refers to the constellation. It is more likely referring to the genus Andromeda (a plant), or possibly a star within the constellation Andromeda. Given the mixed context, confidence is low.", "wikipedia_extract": "The Andromeda Galaxy is a barred spiral galaxy and is the nearest major galaxy to the Milky Way. It was originally named the Andromeda Nebula and is cataloged as Messier 31, M31, and NGC 224. Andromeda has a D25 isophotal diameter of about 46.56 kiloparsecs (152,000 light-years) and is approximately 765 kpc (2.5 million light-years) from Earth. The galaxy's name stems from the area of Earth's sky in which it appears, the constellation of Andromeda, which itself is named after the princess who was the wife of Perseus in Greek mythology. The virial mass of the Andromeda Galaxy is of the same order of magnitude as that of the Milky Way, at 1 trillion solar masses (2.0×1042 kilograms). The mass of either galaxy is difficult to estimate with any accuracy, but it was long thought that the Andromeda Galaxy was more massive than the Milky Way by a margin of some 25% to 50%.", "wikipedia_url": "https://en.wikipedia.org/wiki/Andromeda_Galaxy"}}, {"canonical_name": "Lyra", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "lyra", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Lyra", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["Lyra"], "contexts": ["constellation containing a star", "constellation containing a ring nebula"]}, {"entity_id": "lyra", "book_id": "kosmos_humboldt_1845", "name": "Lyra", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Lyra"], "contexts": ["constellation"]}, {"entity_id": "vega_lyrae", "book_id": "kosmos_humboldt_1845", "name": "Vega Lyrae", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Vega Lyrae"], "contexts": ["star used for distance comparison"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Lyra", "target_book": "kosmos_humboldt_1845", "target_name": "Lyra", "similarity": 1.0}], "id": 996, "stable_key": "clu_8f02b1c91949673d", "ground_truth": {"modern_name": "Lyra (constellation)", "confidence": "high", "type": "concept", "note": "While 'Lyra' can refer to a musical instrument, the context of constellations, stars, and astronomical works firmly points to the celestial constellation.", "wikipedia_extract": "Lyra (Latin for 'lyre', from Ancient Greek: λύρα; pronounced:  LY-rə) is a small constellation. It is one of the 48 listed by the 2nd century astronomer Ptolemy, and is one of the modern 88 constellations recognized by the International Astronomical Union. Lyra was often represented on star maps as a vulture or an eagle carrying a lyre, and hence is sometimes referred to as Vultur Cadens or Aquila Cadens (\"Falling Vulture\" or \"Falling Eagle\"), respectively. Beginning at the north, Lyra is bordered by Draco, Hercules, Vulpecula, and Cygnus. Lyra is nearly overhead in temperate northern latitudes shortly after midnight at the start of summer. From the equator to about the 40th parallel south it is visible low in the northern sky during the same (thus winter) months."}}, {"canonical_name": "índia portugueza", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "índia_portugueza", "book_id": "coloquios_da_orta_1563", "name": "índia portugueza", "category": "PLACE", "subcategory": "COUNTRY", "count": 6, "variants": ["índia portugueza", "Índia portugueza", "índia ingleza"], "contexts": ["location of contracts for exclusive sale of substances", "Portuguese territories in India"]}, {"entity_id": "indias_de_portugal", "book_id": "historia_medicinal_monardes_1574", "name": "Indias de Portugal", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Indias de Portugal", "India de Portugal"], "contexts": ["region in Portugal", "source of Canela with similar fragrance"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "índia portugueza", "target_book": "historia_medicinal_monardes_1574", "target_name": "Indias de Portugal", "similarity": 0.845}], "id": 997, "stable_key": "clu_e78bb3d718fe98b7", "ground_truth": {"modern_name": "Portuguese India", "confidence": "high", "type": "place", "description": "Historical Portuguese territories in the Indian subcontinent.", "wikipedia_extract": "The State of India, also known as the Portuguese State of India or Portuguese India, was a state of the Portuguese Empire founded seven years after the discovery of the sea route to the Indian subcontinent by Vasco da Gama, a subject of the Kingdom of Portugal. The capital of Portuguese India served as the governing centre of a string of military forts and maritime ports scattered along the coasts of the Indian Ocean. Francisco de Almeida, the first viceroy, established his base of operations at Fort Manuel in the Malabar region, after the Kingdom of Cochin negotiated to become a protectorate of Portugal in 1505. With the Portuguese conquest of Goa from the Bijapur Sultanate in 1510, Goa became the major anchorage for the Armadas arriving in India. The capital of the viceroyalty was transferred from Cochin to Goa in 1530. From 1535, Mumbai (Bombay) was a harbour of Portuguese India, known as Bom Bahia, until it was handed over to Charles II of England in 1661 as part of the dowry of Catherine de Braganza."}}, {"canonical_name": "avelaneiras", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "avelaneiras", "book_id": "coloquios_da_orta_1563", "name": "avelaneiras", "category": "PLANT", "subcategory": "PLANT", "count": 6, "variants": ["avelaneiras", "avelan", "avelanada", "avellaneira", "avelãas"], "contexts": ["hazelnut trees", "hazelnut tree"]}, {"entity_id": "avelans", "book_id": "polyanthea_medicinal", "name": "avelans", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["avelans"], "contexts": ["nut, likely hazelnut", "hazelnut skins for remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "avelaneiras", "target_book": "polyanthea_medicinal", "target_name": "avelans", "similarity": 0.905}], "id": 998, "stable_key": "clu_0f4a735ef66862ea", "ground_truth": {"modern_name": "Hazelnut trees", "confidence": "high", "type": "plant", "description": "Trees that produce the edible nut known as a hazelnut.", "wikipedia_extract": "In botany, a tree is a perennial plant with an elongated stem, or trunk, usually supporting branches and leaves. In some usages, the definition of a tree may be narrower, e.g., including only woody plants with secondary growth, only plants that are usable as lumber, or only plants above a specified height. Wider definitions include taller palms, tree ferns, bananas, and bamboos. Trees are not a monophyletic taxonomic group but consist of a wide variety of plant species that have independently evolved a trunk and branches as a way to tower above other plants to compete for sunlight. The majority of tree species are angiosperms or hardwoods; of the rest, many are gymnosperms or softwoods. Trees tend to be long-lived, some trees reaching several thousand years old."}}, {"canonical_name": "acucar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "acucar", "book_id": "historia_medicinal_monardes_1574", "name": "acucar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 7, "variants": ["acucar", "Acucares", "acibar", "agucar"], "contexts": ["sugar used to make syrup", "sugar"]}, {"entity_id": "aslucar", "book_id": "polyanthea_medicinal", "name": "aslucar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["aslucar"], "contexts": ["sugar used to mix powders"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "acucar", "target_book": "polyanthea_medicinal", "target_name": "aslucar", "similarity": 0.843}], "id": 999, "stable_key": "clu_d1e953e6b72ec33d", "ground_truth": {"modern_name": "Sugar", "confidence": "high", "type": "substance", "description": "Sweet crystalline substance obtained from various plants, used in medicine.", "wikipedia_extract": "Sugar () is a class of sweet-tasting, soluble carbohydrates, many of which are used in food. Simple sugars, also called monosaccharides, include glucose, fructose, and galactose. Compound sugars, also called disaccharides or double sugars, are molecules made of two bonded monosaccharides; common examples are sucrose (glucose + fructose), lactose (glucose + galactose), and maltose (two molecules of glucose). White sugar is almost pure sucrose. During digestion, compound sugars are hydrolysed into simple sugars. Longer chains of saccharides are not regarded as sugars, and are called oligosaccharides or polysaccharides."}}, {"canonical_name": "pulso", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "pulso", "book_id": "polyanthea_medicinal", "name": "pulso", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 6, "variants": ["pulso"], "contexts": ["part of the body", "pulse"]}, {"entity_id": "pulso_desordenado", "book_id": "historia_medicinal_monardes_1574", "name": "pulso desordenado", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["pulso desordenado"], "contexts": ["disordered pulse"]}, {"entity_id": "pulso_caydo", "book_id": "historia_medicinal_monardes_1574", "name": "pulso caydo", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["pulso caydo"], "contexts": ["fallen and trembling pulse"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "pulso", "target_book": "historia_medicinal_monardes_1574", "target_name": "pulso desordenado", "similarity": 0.856}, {"source_book": "polyanthea_medicinal", "source_name": "pulso", "target_book": "historia_medicinal_monardes_1574", "target_name": "pulso caydo", "similarity": 0.839}], "id": 1000, "stable_key": "clu_217c516f74f81300", "ground_truth": {"modern_name": "Pulse", "confidence": "high", "type": "disease", "description": "Rhythmic expansion and contraction of arteries, indicative of health or illness.", "note": "Refers to the physical symptom of pulse, and its variations.", "wikipedia_extract": "In medicine, pulse is the rhythmic expansion and contraction of an artery in response to the cardiac cycle (heartbeat). The pulse may be felt (palpated) in any place that allows an artery to be compressed near the surface of the body, such as at the neck (carotid artery), wrist (radial artery or ulnar artery), at the groin (femoral artery), behind the knee (popliteal artery), near the ankle joint (posterior tibial artery), and on foot (dorsalis pedis artery). The pulse is most commonly measured at the wrist or neck for adults and at the brachial artery (inner upper arm between the shoulder and elbow) for infants and very young children. A sphygmograph is an instrument for measuring the pulse. Claudius Galen was perhaps the first physiologist to describe the pulse. The pulse is an expedient tactile method of determination of systolic blood pressure to a trained observer."}}, {"canonical_name": "HofpitalReal", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "hofpitalreal", "book_id": "polyanthea_medicinal", "name": "HofpitalReal", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["HofpitalReal", "Hofpital Real", "Hoſpital Real", "Hoſpital Real de Lisboa", "Hoſpital Real de Madrid"], "contexts": ["hospital where DomingosGomes Merim worked", "hospital where physician worked"]}, {"entity_id": "hoſpital", "book_id": "historia_medicinal_monardes_1574", "name": "Hoſpital", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Hoſpital"], "contexts": ["institution for the sick"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "HofpitalReal", "target_book": "historia_medicinal_monardes_1574", "target_name": "Hoſpital", "similarity": 0.846}], "id": 1001, "stable_key": "clu_00e7275548c750e1", "ground_truth": {"modern_name": "Royal Hospital", "confidence": "high", "type": "place", "description": "An institution established for the care and treatment of the sick.", "wikipedia_extract": "Royal University Hospital, often abbreviated RUH, is one of four hospitals in Saskatoon, Saskatchewan. It is located on the University of Saskatchewan campus. RUH is a teaching hospital and closely tied to the College of Medicine within the university. It was opened on May 14, 1955 by Saskatchewan premier Tommy C. Douglas. The seven-story seven wing structure took eight years to construct and equip, costing the people of Saskatchewan over $13,000,000."}}, {"canonical_name": "Lagrime", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "lagrime", "book_id": "ricettario_fiorentino_1597", "name": "Lagrime", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["Lagrime", "lagrime"], "contexts": ["substance derived from plants, tears", "tears used for medicine"]}, {"entity_id": "lagrimas", "book_id": "coloquios_da_orta_1563", "name": "Lagrimas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Lagrimas"], "contexts": ["tears", "coagulated and dry liquid from trees"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Lagrime", "target_book": "coloquios_da_orta_1563", "target_name": "Lagrimas", "similarity": 0.94}], "id": 1002, "stable_key": "clu_dc3e547629bd718c", "ground_truth": {"modern_name": "Tears", "confidence": "high", "type": "substance", "description": "Bodily fluid secreted by the eyes, or substances resembling it.", "note": "Can refer to literal tears or plant exudates described as such.", "wikipedia_extract": "Tears (tear film) are a transparent fluid secreted primarily by the lacrimal glands (tear gland) found in the eyes of all land mammals. According to the mode of production, tears are classified into four types: basal, closed eye, emotional, and reflex. The basal rate of tear secretion is ~0.5–2.2 µL/min, and irritation can increase secretion by up to ~100-fold, reaching ~300 µL/min. Tears are made up of water, electrolytes, proteins, lipids, and mucins that form layers on the surface of eyes. The four types of tears differ significantly in their composition. Some of the functions of tears include lubricating the eyes (basal tears), removing irritants (reflex tears), and also aiding the immune system."}}, {"canonical_name": "tâmaras", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "tâmaras", "book_id": "coloquios_da_orta_1563", "name": "tâmaras", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["tâmaras", "Tâmara", "tâmara"], "contexts": ["cultivated crop", "fruit traded from Arabia to India"]}, {"entity_id": "tamaras", "book_id": "polyanthea_medicinal", "name": "tamaras", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["tamaras"], "contexts": ["ingredient in a remedy", "dates"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "tâmaras", "target_book": "polyanthea_medicinal", "target_name": "tamaras", "similarity": 0.871}], "id": 1003, "stable_key": "clu_b30470427d8290dd", "ground_truth": {"modern_name": "Dates", "confidence": "high", "type": "plant", "description": "Sweet fruit of the date palm, cultivated and traded.", "wikipedia_extract": "A stem is one of two main structural axes of a vascular plant, the other being the root. It supports leaves, flowers and fruits, transports water and dissolved substances between the roots and the shoots in the xylem and phloem, engages in photosynthesis, stores nutrients, and produces new living tissue. The stem can also be called the culm, halm, haulm, stalk, or thyrsus. The stem is normally divided into nodes and internodes: The nodes are the points of attachment for leaves and can hold one or more leaves. There are sometimes axillary buds between the stem and leaf which can grow into branches (with leaves, conifer cones, or flowers). Adventitious roots (e.g. brace roots) may also be produced from the nodes."}}, {"canonical_name": "canada", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "canada", "book_id": "polyanthea_medicinal", "name": "canada", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 6, "variants": ["canada", "canadas"], "contexts": ["unit of measurement for liquid", "measure of blood"]}, {"entity_id": "canadas", "book_id": "coloquios_da_orta_1563", "name": "canadas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["canadas"], "contexts": ["unit of liquid measure", "unit of measurement for liquids"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "canada", "target_book": "coloquios_da_orta_1563", "target_name": "canadas", "similarity": 0.959}], "id": 1004, "stable_key": "clu_62f5b6f833991f7a", "ground_truth": {"modern_name": "Canada (unit of liquid measure)", "confidence": "high", "type": "object", "description": "A unit of measurement, specifically for liquids like blood.", "note": "This refers to a unit of liquid measure, not the country.", "wikipedia_extract": "Canada is a country in North America. Its ten provinces and three territories extend from the Atlantic Ocean to the Pacific Ocean and northward into the Arctic Ocean, making it the second-largest country by total area, with the longest coastline of any country. Its border with the United States is the longest international land border. The country is characterized by a wide range of both meteorologic and geological regions. With a population of over 41 million, it has widely varying population densities, with the majority residing in its urban areas and large areas being sparsely populated. Canada's capital is Ottawa and its three largest metropolitan areas are Toronto, Montreal, and Vancouver."}}, {"canonical_name": "diureticos", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "diureticos", "book_id": "polyanthea_medicinal", "name": "diureticos", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 7, "variants": ["diureticos", "diureticas", "diureticis", "remedios diureticos"], "contexts": ["substances that promote urination", "medicines that promote urination"]}, {"entity_id": "diurética", "book_id": "coloquios_da_orta_1563", "name": "diurética", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["diurética"], "contexts": ["quality of causing urination"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "diureticos", "target_book": "coloquios_da_orta_1563", "target_name": "diurética", "similarity": 0.926}], "id": 1005, "stable_key": "clu_0aafd6351fc86b84", "ground_truth": {"modern_name": "Diuretic", "confidence": "high", "type": "concept", "description": "A substance or property that promotes urination.", "wikipedia_extract": "A diuretic ( ) is any substance that promotes diuresis, the increased production of urine. This includes forced diuresis. A diuretic tablet is sometimes colloquially called a water tablet. There are several categories of diuretics. All diuretics increase the excretion of water from the body, through the kidneys. There exist several classes of diuretic, and each works in a distinct way."}}, {"canonical_name": "calculum", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "calculum", "book_id": "polyanthea_medicinal", "name": "calculum", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 7, "variants": ["calculum", "Calcul.", "Calculo", "calculo"], "contexts": ["calculus or stone", "kidney stones"]}, {"entity_id": "contaram", "book_id": "coloquios_da_orta_1563", "name": "contaram", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["contaram"], "contexts": ["condition the root is against"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "calculum", "target_book": "coloquios_da_orta_1563", "target_name": "contaram", "similarity": 0.868}], "id": 1006, "stable_key": "clu_a6eb789880cc39a0", "ground_truth": {"modern_name": "Calculus (kidney stone)", "confidence": "high", "type": "disease", "description": "A stone or concretion in the body, often in kidneys or bladder.", "wikipedia_extract": "Kidney stone disease or urinary stone disease is a crystallopathy that occurs when there is an excess of minerals in the urine and not enough liquid or hydration. This imbalance causes tiny pieces of crystal to aggregate and form hard masses, or calculi (stones) in the upper urinary tract. Because renal calculi typically form in the kidney, if small enough, they are able to leave the urinary tract via the urine stream. A small calculus may pass without causing symptoms. However, if a stone grows to more than 5 millimeters (0.2 inches), it can cause a blockage of the ureter, resulting in extremely sharp and severe pain (renal colic) in the lower back that often radiates downward to the groin. A calculus may also result in blood in the urine, vomiting (owing  to severe pain), swelling of the kidney, or painful urination."}}, {"canonical_name": "Extracto", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "extracto", "book_id": "polyanthea_medicinal", "name": "Extracto", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 5, "variants": ["extracto", "Extracto"], "contexts": ["extract", "extract from saltpeter and caparrofa"]}, {"entity_id": "extractum_datura", "book_id": "coloquios_da_orta_1563", "name": "extractum datura", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["extractum datura"], "contexts": ["preparation from Datura seeds"]}, {"entity_id": "extractodo_caitoreo", "book_id": "polyanthea_medicinal", "name": "extractodo Caitoreo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["extractodo Caitoreo"], "contexts": ["remedy mixed with sage water"]}, {"entity_id": "extracto_daef", "book_id": "polyanthea_medicinal", "name": "extracto daEf", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["extracto daEf"], "contexts": ["extract of a plant"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Extracto", "target_book": "coloquios_da_orta_1563", "target_name": "extractum datura", "similarity": 0.859}, {"source_book": "coloquios_da_orta_1563", "source_name": "extractum datura", "target_book": "polyanthea_medicinal", "target_name": "extractodo Caitoreo", "similarity": 0.811}, {"source_book": "coloquios_da_orta_1563", "source_name": "extractum datura", "target_book": "polyanthea_medicinal", "target_name": "extracto daEf", "similarity": 0.812}], "id": 1007, "stable_key": "clu_bbeea890af0591a4", "ground_truth": {"modern_name": "Extract", "confidence": "high", "type": "substance", "description": "A concentrated preparation derived from a substance.", "wikipedia_extract": "An extract (essence) is a substance made by extracting a part of a raw material, often by using a solvent such as ethanol, oil or water. Extracts may be sold as tinctures or absolutes or dried and powdered. Extracts are widely used in various industries, such as perfumes, cosmetics, pharmaceuticals, and the food industry, among others. The aromatic principles of many spices, nuts, herbs, fruits, etc., and some flowers, are marketed as extracts, among the best known of true extracts being almond, cinnamon, cloves, ginger, lemon, nutmeg, orange, peppermint, pistachio, rose, spearmint, vanilla, violet, rum, and wintergreen. Most natural essences are obtained by extracting the essential oil from the feedstock, such as blossoms, fruit, and roots, or from intact plants through multiple techniques and methods: Expression (juicing, pressing) involves physical extraction material from feedstock, used when the oil is plentiful and easily obtained from materials such as citrus peels, olives, and grapes. Absorption (steeping, decoction)."}}, {"canonical_name": "Igreja dos Anjos", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "igreja_dos_anjos", "book_id": "polyanthea_medicinal", "name": "Igreja dos Anjos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Igreja dos Anjos", "Igreja de Santos", "Igreja dosAnjos", "IgrejadeSantiago", "IgrejadeSao Paulo"], "contexts": ["church", "church, location"]}, {"entity_id": "provinda_dos_anjos", "book_id": "coloquios_da_orta_1563", "name": "provinda dos Anjos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["provinda dos Anjos"], "contexts": ["religious province"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Igreja dos Anjos", "target_book": "coloquios_da_orta_1563", "target_name": "provinda dos Anjos", "similarity": 0.861}], "id": 1008, "stable_key": "clu_0d8f0f3b44745393", "ground_truth": {"modern_name": "Igreja dos Anjos", "confidence": "high", "type": "place", "description": "A church named 'Church of the Angels'.", "wikipedia_extract": "The Church of Our Lady of the Angels (Portuguese: Igreja de Nossa Senhora dos Anjos), more commonly known simply as Igreja dos Anjos [iˈɣɾɐʒɐ ðuz ˈɐ̃ʒuʃ], is a Roman Catholic parish church located in Lisbon, Portugal. The parish of Anjos was created by Cardinal Henry of Portugal, splitting the territory from that of the large Santa Justa parish. The seat of the newly created parish was a small chapel (ermida) under the invocation of Our Lady of Angels — this small chapel was later enlarged in the 17th century, during the reign of King Philip III of Portugal. From 1579 up to the 1820s, when it ceased due to the lack of means, the church had collegiate status; the college of canons consisted of 11 chaplains who maintained the daily office of worship. The original church was demolished in 1908 in order to make way for a major thoroughfare, Avenida D. Amélia (named after Queen Amélie of Orléans; renamed Avenida Almirante Reis shortly after the 5 October 1910 revolution, honouring one of the Republican revolutionaries)."}}, {"canonical_name": "diacodio", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "diacodio", "book_id": "polyanthea_medicinal", "name": "diacodio", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["diacodio", "Diacodio", "diacatholicão"], "contexts": ["remedy for thin fluxions", "anodyne preparation"]}, {"entity_id": "diacodion_com", "book_id": "ricettario_fiorentino_1597", "name": "DIACODION COM", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["DIACODION COM"], "contexts": ["a type of diacodion"]}, {"entity_id": "diacassia", "book_id": "ricettario_fiorentino_1597", "name": "Diacassia", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Diacassia"], "contexts": ["a type of electuary made with cassia"]}, {"entity_id": "diacordio", "book_id": "ricettario_fiorentino_1597", "name": "Diacordio", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Diacordio"], "contexts": ["medicinal preparation"]}, {"entity_id": "diafcordio", "book_id": "polyanthea_medicinal", "name": "diafcordio", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["diafcordio"], "contexts": ["ingredient in a diaphoretic remedy"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "diacodio", "target_book": "ricettario_fiorentino_1597", "target_name": "DIACODION COM", "similarity": 0.836}, {"source_book": "polyanthea_medicinal", "source_name": "diacodio", "target_book": "ricettario_fiorentino_1597", "target_name": "Diacassia", "similarity": 0.841}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Diacordio", "target_book": "polyanthea_medicinal", "target_name": "diafcordio", "similarity": 0.844}], "id": 1009, "stable_key": "clu_7ce0e1b150808d7a", "ground_truth": {"modern_name": "Diacodium", "confidence": "high", "type": "chemical", "description": "An anodyne medicinal preparation, often made from poppy.", "note": "Refers to a medicinal preparation, likely derived from opium/poppy, not a person."}}, {"canonical_name": "Camerarius", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "camerarius", "book_id": "english_physician_1652", "name": "Camerarius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Camerarius", "Cameravius"], "contexts": ["cited for remedy", "scholar who noted use of Meadow Rue for Jaundice"]}, {"entity_id": "camerarius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Camerarius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Camerarius"], "contexts": ["scholar who defended Herodotus"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Camerarius", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Camerarius", "similarity": 1.0}], "id": 1010, "stable_key": "clu_98ba6c71c3ae3857", "ground_truth": {"modern_name": "Joachim Camerarius", "confidence": "high", "type": "person", "birth_year": 1500, "death_year": 1574, "description": "German humanist scholar, physician, and botanist.", "note": "There were multiple scholars named Camerarius. Joachim Camerarius the Younger (1534-1598) was also a physician and botanist. The citations suggest a historical figure associated with botanical knowledge and remedies.", "wikidata_id": "Q71261", "wikidata_description": "German scientist (1534-1598)", "wikipedia_url": "https://en.wikipedia.org/wiki/Joachim%20Camerarius%20the%20Younger", "wikipedia_extract": "Joachim Camerarius (12 April 1500 – 17 April 1574), the Elder, was a German classical scholar. His critical abilities, his deep understanding of Greek and Latin, and his wide-ranging knowledge of the ancient world made him one of the foremost German scholars of his time. Camerarius was born in Bamberg, in the Prince-Bishopric of Bamberg. His family name was Liebhard, but he was generally called Kammermeister, previous members of his family having held the office of chamberlain (camerarius) to the bishops of Bamberg. He studied at Leipzig, Erfurt and Wittenberg, where he became a student and friend of Philipp Melanchthon. For some years he was teacher of history and Greek at the gymnasium in Nuremberg (Ägidiengymnasium)."}}, {"canonical_name": "Parsnip", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "parsnip", "book_id": "english_physician_1652", "name": "Parsnip", "category": "PLANT", "subcategory": "PLANT", "count": 6, "variants": ["Parsnip", "Parsnep", "Parsnips"], "contexts": ["root mistaken for Hemlock root", "root vegetable for comparison"]}, {"entity_id": "parsnips", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Parsnips", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Parsnips"], "contexts": ["vegetable plant"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Parsnip", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Parsnips", "similarity": 0.886}], "id": 1011, "stable_key": "clu_8bf7f40a7dc5ac42", "ground_truth": {"modern_name": "Parsnip", "confidence": "high", "type": "plant", "linnaean": "Pastinaca sativa Linnaeus", "family": "Apiaceae", "note": "The text mentions mistaking its root for Hemlock, a known confusion between similar-looking plants.", "wikidata_id": "Q1479657", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Heracleum_maximum", "wikipedia_extract": "Heracleum maximum, commonly known as cow parsnip, is the only member of the genus Heracleum native to North America. It is also known as American cow-parsnip, Satan celery, Indian celery, Indian rhubarb, poison turnip or pushki. Cow parsnip is a tall herbaceous perennial plant, reaching heights of 3 metres (10 feet). The stems are hollow and densely hairy. The leaves are very large, up to 40 centimetres (16 inches) across and divided into three lobes. Cow parsnip has the characteristic flower umbels of the carrot family (Apiaceae), blooming from February to September."}}, {"canonical_name": "sangre de Drago", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "sangre_de_drago", "book_id": "historia_medicinal_monardes_1574", "name": "sangre de Drago", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["sangre de Drago", "sangre de Drago de gota", "sangre de Drago en Pan"], "contexts": ["resin from the Dragon tree", "substance discussed, its origin debated"]}, {"entity_id": "sanguis_draconis", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Sanguis Draconis", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Sanguis Draconis", "sanguis draconis"], "contexts": ["gum of a tree, mistaken for blood", "juice concrete drawing not at all"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "sangre de Drago", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Sanguis Draconis", "similarity": 0.847}], "id": 1012, "stable_key": "clu_73759f9577b2b0b1", "ground_truth": {"modern_name": "Dragon's blood resin", "confidence": "high", "type": "substance", "note": "Both 'sangre de Drago' and 'Sanguis Draconis' are historical terms for this resin, often obtained from Daemonorops species.", "wikipedia_extract": "Dragon's blood is a bright red resin that is obtained from different species of a number of distinct plant genera: Calamus spp. (previously Daemonorops) also including Calamus rotang, Croton, Dracaena and Pterocarpus. The red resin has been in continuous use since ancient times as varnish, medicine, incense, pigment, and dye. A great  degree of confusion existed for the ancients in regard to the source and identity of dragon's blood. Some medieval encyclopedias claimed its source as the literal blood of elephants and dragons who had perished in mortal combat. The resin of Dracaena species, \"true\" dragon's blood, and the very poisonous mineral cinnabar (mercury sulfide) were often confused by the ancient Romans.", "wikipedia_url": "https://en.wikipedia.org/wiki/Dragon's_blood"}}, {"canonical_name": "Storace", "category": "PLANT", "subcategory": "RESIN", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "storace", "book_id": "ricettario_fiorentino_1597", "name": "Storace", "category": "PLANT", "subcategory": "RESIN", "count": 5, "variants": ["Storace", "Storace calamita", "Storace liquida"], "contexts": ["a resinous substance", "ingredient in a recipe"]}, {"entity_id": "storax", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Storax", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["Storax"], "contexts": ["aromatic resin"]}, {"entity_id": "storace_calami", "book_id": "ricettario_fiorentino_1597", "name": "Storace calami", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["Storace calami"], "contexts": ["resin ingredient in preparations"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Storace", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Storax", "similarity": 0.925}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Storax", "target_book": "ricettario_fiorentino_1597", "target_name": "Storace calami", "similarity": 0.86}], "id": 1013, "stable_key": "clu_855b2da4d341c96f", "ground_truth": {"modern_name": "Storax", "confidence": "high", "type": "plant", "family": "Styracaceae", "note": "Storax is a resin obtained from trees of the genus Styrax. 'Storace calami' likely refers to a specific preparation or source of storax.", "wikidata_id": "Q525062", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Styrax", "wikipedia_extract": "Storace is a surname. Notable people with the surname include: Bernardo Storace (fl."}}, {"canonical_name": "cowslip", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "cowslip", "book_id": "origin_of_species_darwin_1859", "name": "cowslip", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["cowslip"], "contexts": ["plant differing from primrose", "plant used in cross-fertilization experiments"]}, {"entity_id": "cowslips", "book_id": "english_physician_1652", "name": "Cowslips", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Cowslips"], "contexts": ["flowering plant", "plant for conserves"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "cowslip", "target_book": "english_physician_1652", "target_name": "Cowslips", "similarity": 0.859}], "id": 1014, "stable_key": "clu_ebe4af27be82e95f", "ground_truth": {"modern_name": "Cowslip", "confidence": "high", "type": "plant", "linnaean": "Primula veris", "family": "Primulaceae", "description": "A common yellow-flowered woodland plant, often used medicinally.", "wikipedia_extract": "Primula veris, the cowslip, common cowslip, or cowslip primrose (syn. Primula officinalis Hill), is a herbaceous perennial  flowering plant in the primrose family Primulaceae. The species is native throughout most of temperate Europe and western Asia, and although absent from more northerly areas including much of northwest Scotland, it reappears in northernmost Sutherland and Orkney and in Scandinavia. This species frequently hybridizes with other Primulas such as the common primrose Primula vulgaris to form false oxlip (Primula × polyantha) which is often confused with true oxlip (Primula elatior), a much rarer plant. The common name cowslip may derive from the old English for cow dung, probably because the plant was often found growing amongst the manure in cow pastures. An alternative derivation simply refers to slippery or boggy ground; again, a typical habitat for this plant."}}, {"canonical_name": "callos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "callos", "book_id": "polyanthea_medicinal", "name": "callos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 6, "variants": ["callos", "Callos", "calos"], "contexts": ["calluses", "warts"]}, {"entity_id": "callus", "book_id": "english_physician_1652", "name": "Callus", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Callus"], "contexts": ["condition affecting the eyes"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "callos", "target_book": "english_physician_1652", "target_name": "Callus", "similarity": 0.901}], "id": 1015, "stable_key": "clu_9622308edb68deef", "ground_truth": {"modern_name": "Callus", "confidence": "high", "type": "disease", "description": "A hardened or thickened area of skin, or a hardened lump.", "note": "Refers to a physical thickening or hardening, not a disease in the modern sense of infection.", "wikipedia_extract": "A callus (pl.: calluses) is an area of thickened and sometimes hardened skin that forms as a response to repeated friction, pressure, or other irritation. Since repeated contact is required, calluses are most often found on the feet and hands, but they may occur anywhere on the skin. Some degree of callus, such as on the bottom of the foot, is normal. Calluses are generally not harmful and help prevent blisters, as well as offering protection. However, excessive formation may sometimes lead to other problems, such as a skin ulceration or infection, or cause the affected person to try to offload the affected painful area, which can place excessive stress on the asymptomatic side. Rubbing that is too frequent or forceful will cause blisters, as opposed to calluses, to form."}}, {"canonical_name": "myrrha", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "myrrha", "book_id": "coloquios_da_orta_1563", "name": "myrrha", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["myrrha"], "contexts": ["Substance used in embalming", "brought to embalm Jesus"]}, {"entity_id": "mirrh", "book_id": "english_physician_1652", "name": "Mirrh", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["Mirrh"], "contexts": ["used with Mercury decoction", "medicinal preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "myrrha", "target_book": "english_physician_1652", "target_name": "Mirrh", "similarity": 0.863}], "id": 1016, "stable_key": "clu_a25537fcec5ee82c", "ground_truth": {"modern_name": "Myrrh", "confidence": "high", "type": "chemical", "description": "A fragrant resin obtained from trees of the genus Commiphora.", "note": "Refers to the substance myrrh, used medicinally and in embalming.", "wikipedia_extract": "Myrrh (; from an unidentified ancient Semitic language, مر; from Arabic, מוֹר /mor/; from Hebrew, see § Etymology) is a gum-resin extracted from a few small, thorny tree species of the Commiphora genus, belonging to the Burseraceae family. Myrrh resin was traded in the ancient world, and has been used throughout history in medicine, in ritual, and to make perfume and incense. Its use is mentioned in the Hebrew Bible, the New Testament and in Islamic texts, as well as by ancient historians. It is still used by certain Christian denominations for ritual purposes. When a cut on a tree penetrates through the bark and into the sapwood, the tree secretes a resin. Myrrh gum, like frankincense, is such a resin."}}, {"canonical_name": "croco indiaco", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "croco_indiaco", "book_id": "coloquios_da_orta_1563", "name": "croco indiaco", "category": "PLANT", "subcategory": "PLANT", "count": 6, "variants": ["croco indiaco", "CROCO INDIACO", "Croco Indiaco", "croco indiano"], "contexts": ["substance discussed", "Orta's name for Curcuma longa rhizome"]}, {"entity_id": "croco", "book_id": "polyanthea_medicinal", "name": "croco", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["croco"], "contexts": ["ingredient in preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "croco indiaco", "target_book": "polyanthea_medicinal", "target_name": "croco", "similarity": 0.832}], "id": 1017, "stable_key": "clu_602934df4832c9b1", "ground_truth": {"modern_name": "Turmeric", "confidence": "high", "type": "plant", "linnaean": "Curcuma longa", "family": "Zingiberaceae", "description": "A spice derived from a rhizome, used in medicine and as a dye.", "note": "Also known as 'croco indiaco' in the text.", "wikipedia_extract": "Turmeric (), or Curcuma longa (), is a flowering plant in the ginger family Zingiberaceae. It is a perennial, rhizomatous, herbaceous plant native to the Indian subcontinent and Southeast Asia that requires temperatures between 20 and 30 °C (68 and 86 °F) and high annual rainfall to thrive. Plants are gathered each year for their rhizomes, some for propagation in the following season and some for consumption or dyeing. The rhizomes can be used fresh, but they are often boiled in water and dried, after which they are ground into a deep orange-yellow shelf-stable spice powder commonly used as a coloring and flavoring agent in many Asian cuisines, especially for curries (curry powder). Turmeric powder has a warm, bitter, black pepper-like flavor and earthy, mustard-like aroma. Although long used in Ayurvedic medicine, there is no high-quality clinical evidence that consuming turmeric or the principal turmeric constituent, curcumin, is effective for treating any disease."}}, {"canonical_name": "Tongue", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "tongue", "book_id": "english_physician_1652", "name": "Tongue", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 6, "variants": ["Tongue"], "contexts": ["part of the mouth", "part of body with biting taste"]}, {"entity_id": "lingua", "book_id": "ricettario_fiorentino_1597", "name": "lingua", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["lingua"], "contexts": ["body part used for tasting"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Tongue", "target_book": "ricettario_fiorentino_1597", "target_name": "lingua", "similarity": 0.9}], "id": 1018, "stable_key": "clu_f9219f2d1f5d8ff6", "ground_truth": {"modern_name": "Tongue", "confidence": "high", "type": "substance", "description": "An organ of the mouth involved in tasting and speech.", "wikipedia_extract": "The tongue is a muscular organ in the mouth of a typical tetrapod. It manipulates food for chewing and swallowing as part of the digestive process, and is the primary organ of taste. The tongue's upper surface (dorsum) is covered by taste buds housed in numerous lingual papillae. It is sensitive and kept moist by saliva and is richly supplied with nerves and blood vessels. The tongue also serves as a natural means of cleaning the teeth. A major function of the tongue is to enable speech in humans and vocalization in other animals."}}, {"canonical_name": "Dandrif", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "dandrif", "book_id": "english_physician_1652", "name": "Dandrif", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 6, "variants": ["Dandrif"], "contexts": ["skin condition treated with mallows", "flaky skin on the head"]}, {"entity_id": "damarefia", "book_id": "polyanthea_medicinal", "name": "damarefia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["damarefia"], "contexts": ["condition causing nausea"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Dandrif", "target_book": "polyanthea_medicinal", "target_name": "damarefia", "similarity": 0.85}], "id": 1019, "stable_key": "clu_68a3a8ff4eae3766", "ground_truth": {"modern_name": "Dandruff", "confidence": "medium", "type": "disease", "description": "A common skin condition causing flaking on the scalp.", "note": "'Damarefia' might refer to a symptom or a different condition, but 'Dandrif' is clearly identifiable.", "wikipedia_extract": "Dandruff is a skin condition of the scalp. Symptoms include heavy flaking and sometimes mild itchiness. It can result in social or self-esteem problems. A more severe form of the condition, which includes inflammation of the skin, is known as seborrhoeic dermatitis. The cause is unclear, but believed to involve a number of genetic and environmental factors; the condition may worsen in the winter. It is not due to poor hygiene, and the underlying mechanism involves the excessive growth of skin cells."}}, {"canonical_name": "Kentucky", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "kentucky", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Kentucky", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Kentucky"], "contexts": ["region with natural caves", "state in the United States"]}, {"entity_id": "kentucky", "book_id": "origin_of_species_darwin_1859", "name": "Kentucky", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Kentucky"], "contexts": ["US state", "location of specific caves"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Kentucky", "target_book": "origin_of_species_darwin_1859", "target_name": "Kentucky", "similarity": 0.878}], "id": 1020, "stable_key": "clu_3a1471d3e2184bda", "ground_truth": {"modern_name": "Kentucky", "confidence": "high", "type": "place", "description": "A state in the United States, known for its natural features.", "wikipedia_extract": "Kentucky (US:  , UK: ), officially the Commonwealth of Kentucky, is a landlocked state in the Southeastern region of the United States. It borders Illinois, Indiana, and Ohio to the north, West Virginia to the northeast, Virginia to the east, Tennessee to the south, and Missouri to the west. Its northern border is defined by the Ohio River. Its capital is Frankfort and its most populous city is Louisville. As of 2024, the state's population was approximately 4.6 million. Previously a part of colonial Virginia, Kentucky was admitted into the Union as the fifteenth state on June 1, 1792."}}, {"canonical_name": "Kirwan", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "kirwan", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Kirwan", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Kirwan", "Kirvvan", "M. Kirwan"], "contexts": ["author who assured about barometer readings", "author of Estimât, des temp."]}, {"entity_id": "kirby", "book_id": "origin_of_species_darwin_1859", "name": "Kirby", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Kirby"], "contexts": ["naturalist who observed beetle tarsi"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Kirwan", "target_book": "origin_of_species_darwin_1859", "target_name": "Kirby", "similarity": 0.857}], "id": 1021, "stable_key": "clu_96d8469e950461bf", "ground_truth": {"modern_name": "Kirwan", "confidence": "low", "type": "person", "description": "Author of scientific works on meteorology and geology.", "note": "The text mentions 'Kirwan' and 'Kirby'. 'Kirwan' is more likely given the context of atmospheric measurements.", "wikipedia_extract": "James A. Jobling is a British naturalist and author. Jobling is known for his work on the taxonomy of birds, writing and publishing one of the most comprehensive reference works on the etymology of the names of genera and species of birds around the world. Jobling was initially a civil servant with experience in finance and land registration. Since childhood, he had an interest in the natural world, especially in birds and their names. He worked for several years writing the Dictionary of Scientific Bird Names, published in 1991 by Oxford University Press."}}, {"canonical_name": "anthers", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "anthers", "book_id": "origin_of_species_darwin_1859", "name": "anthers", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 5, "variants": ["anthers"], "contexts": ["part of stamen producing pollen", "part of a flower that produces pollen"]}, {"entity_id": "antheridia", "book_id": "kosmos_humboldt_1845", "name": "antheridia", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 2, "variants": ["antheridia"], "contexts": ["reproductive organs of chara", "organs in mosses and liverworts"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "anthers", "target_book": "kosmos_humboldt_1845", "target_name": "antheridia", "similarity": 0.888}], "id": 1022, "stable_key": "clu_2e1317fb8ac6901d", "ground_truth": {"modern_name": "Anther", "confidence": "high", "type": "plant", "note": "'Antheridia' refers to the male reproductive organs in some lower plants like mosses and ferns, while 'anthers' are part of the stamen in flowering plants. Both relate to plant reproductive structures.", "wikidata_id": "Q158937", "wikidata_description": "genus of plants", "wikipedia_extract": "In biology, a theca (pl.: thecae) is a sheath or a covering. In botany, the theca is related to plant's flower anatomy. The theca of an angiosperm consists of a pair of microsporangia that are adjacent to each other and share a common area of dehiscence called the stomium. Any part of a microsporophyll that bears microsporangia is called an anther. Most anthers are formed on the apex of a filament. An anther and its filament together form a typical (or filantherous) stamen, part of the male floral organ.", "wikipedia_url": "https://en.wikipedia.org/wiki/Theca"}}, {"canonical_name": "British plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "british_plants", "book_id": "origin_of_species_darwin_1859", "name": "British plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["British plants"], "contexts": ["examples of plant varieties", "Mr. Babington on"]}, {"entity_id": "british_flora", "book_id": "kosmos_humboldt_1845", "name": "British flora", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["British flora"], "contexts": ["plants of the British Isles", "plant life of Britain"]}, {"entity_id": "british_plants", "book_id": "kosmos_humboldt_1845", "name": "British Plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["British Plants"], "contexts": ["subject of Watson's remarks"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "British plants", "target_book": "kosmos_humboldt_1845", "target_name": "British flora", "similarity": 0.933}, {"source_book": "origin_of_species_darwin_1859", "source_name": "British plants", "target_book": "kosmos_humboldt_1845", "target_name": "British Plants", "similarity": 0.984}], "id": 1023, "stable_key": "clu_1b6e33fd00f9e5a2", "ground_truth": {"modern_name": "British flora", "confidence": "high", "type": "concept", "note": "This refers to the collective plant life of the British Isles, often studied in the context of natural history and evolution.", "wikidata_id": "Q56651604", "wikidata_description": "plants endemic to Great Britain", "wikipedia_extract": "The flora of India is one of the richest in the world due to the wide range of climate, topology and habitat in the country. Floral Diversity and Medicinal Plant Wealth There are estimated to be over 18,000 species of flowering plants in India, which constitute some 6-7 percent of the total plant species in the world. India is home to more than 50,000  species of plants, including a variety of endemics. The use of plants as a source of medicines has been an integral part of life in India from the earliest times. There are more than 3000 Indian plant species officially documented as possessing  into eight main floristic regions : Western Himalayas, Eastern Himalayas, Assam,  Indus plain, Ganges plain, the Deccan, Malabar and the Andaman Islands. Forest Cover and Vegetation Diversity In 1992, 743,534 km2 of land in the country was forested of which 92 percent was government land.", "wikipedia_url": "https://en.wikipedia.org/wiki/Flora_of_India"}}, {"canonical_name": "françoises", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "françoises", "book_id": "relation_historique_humboldt_vol3_1825", "name": "françoises", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["françoises", "FRANÇOISE", "françoise"], "contexts": ["French possessions in South America", "French legislation regarding slavery"]}, {"entity_id": "french", "book_id": "kosmos_humboldt_1845", "name": "French", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["French"], "contexts": ["language of France"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "françoises", "target_book": "kosmos_humboldt_1845", "target_name": "French", "similarity": 0.88}], "id": 1024, "stable_key": "clu_16f205e7e286df11", "ground_truth": {"modern_name": "France", "confidence": "high", "type": "place", "country": "France", "note": "The context refers to people, possessions, and language associated with France.", "wikidata_id": "Q142", "wikidata_description": "country in Western Europe and other continents (through its overseas territories in America, Africa and Oceania)", "wikipedia_extract": "France, officially the French Republic, is a country primarily located in Western Europe. Its overseas regions and territories include French Guiana in South America, Saint Pierre and Miquelon in the North Atlantic, the French West Indies, and many islands in Oceania and the Indian Ocean. Metropolitan France shares borders with Belgium and Luxembourg to the north; Germany to the northeast; Switzerland to the east; Italy and Monaco to the southeast; Andorra and Spain to the south; and a maritime border with the United Kingdom to the northwest. Its metropolitan area extends from the Rhine to the Atlantic Ocean and from the Mediterranean Sea to the English Channel and the North Sea. Its 18 integral regions—five of which are overseas—span a combined area of 632,702 km2 (244,288 sq mi), with a total population estimated at 69.1 million in 2026. Its capital, largest city and main cultural and economic centre is Paris."}}, {"canonical_name": "Clermont-Ferrand", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "clermont-ferrand", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Clermont-Ferrand", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Clermont-Ferrand", "Ciermont-Ftrrand", "Clermonl-Ferrand", "Clermont", "Clermont en Auvergne"], "contexts": ["city with barometric observations", "location of Ramond's observations"]}, {"entity_id": "clermont-ferrand", "book_id": "kosmos_humboldt_1845", "name": "Clermont-Ferrand", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Clermont-Ferrand"], "contexts": ["city in France"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Clermont-Ferrand", "target_book": "kosmos_humboldt_1845", "target_name": "Clermont-Ferrand", "similarity": 1.0}], "id": 1025, "stable_key": "clu_92bc050ce58ee5b5", "ground_truth": {"modern_name": "Clermont-Ferrand", "confidence": "high", "type": "place", "country": "France", "wikidata_id": "Q42168", "wikidata_description": "commune in Puy-de-Dôme, France", "wikipedia_url": "https://en.wikipedia.org/wiki/Clermont-Ferrand", "wikipedia_extract": "Clermont-Ferrand Cathedral, or the Cathedral of Our Lady of the Assumption of Clermont-Ferrand (French: Cathédrale Notre-Dame-de-l'Assomption de Clermont-Ferrand), is a Gothic cathedral and French national monument located in the city of Clermont-Ferrand in the Auvergne. It is the seat of the Archbishops of Clermont (bishops until 2002). It is built entirely in black lava stone, which makes it highly distinctive, and visible from a great distance. Its twin spires are 96.1 metres tall, and tower above the city's rooftops. It has been listed since 1862 as a monument historique by the French Ministry of Culture. In the 5th century, bishop Namatius laid the foundations of the city's first cathedral, allowing the Christian community to leave its ghetto, the \"vicus christianorum\"."}}, {"canonical_name": "Pensylvanie", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "pensylvanie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pensylvanie", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["Pensylvanie"], "contexts": ["colony in North America", "state in the United States"]}, {"entity_id": "pennsylvania", "book_id": "kosmos_humboldt_1845", "name": "Pennsylvania", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Pennsylvania"], "contexts": ["location where phenomenon observed"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pensylvanie", "target_book": "kosmos_humboldt_1845", "target_name": "Pennsylvania", "similarity": 0.896}], "id": 1026, "stable_key": "clu_dcbede415041f61e", "ground_truth": {"modern_name": "Pennsylvania", "confidence": "high", "type": "place", "country": "United States", "wikidata_id": "Q1400", "wikidata_description": "state of the United States of America", "wikipedia_url": "https://en.wikipedia.org/wiki/Pennsylvania", "wikipedia_extract": "Pennsylvania, officially the Commonwealth of Pennsylvania, is a state located in the Mid-Atlantic, Northeastern, Appalachian, and Great Lakes regions of the United States. It borders Delaware to its southeast, Maryland to its south, forming the Mason-Dixon Line, West Virginia to its southwest, Ohio to its west, the Canadian province of Ontario to its northwest via Lake Erie, New York to its north, and the Delaware River and New Jersey to its east. Pennsylvania's most populous city is Philadelphia, and the state capital is Harrisburg. Among all US states, Pennsylvania is the fifth-most populous with over 13 million residents as of the 2020 United States census, the ninth-highest by population density, and the 33rd-largest by land area. The largest metropolitan statistical area is the Philadelphia metropolitan area in southeastern Pennsylvania, also known as the Delaware Valley and centered on Philadelphia, the sixth-most populous U.S. city. Pennsylvania's second-largest metropolitan area, Greater Pittsburgh, is centered in and around Pittsburgh, the commonwealth's second-largest city."}}, {"canonical_name": "Papagayo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "papagayo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Papagayo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["Papagayo"], "contexts": ["gulf in Nicaragua", "gulf"]}, {"entity_id": "papagallo", "book_id": "kosmos_humboldt_1845", "name": "Papagallo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Papagallo"], "contexts": ["geographic location"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Papagayo", "target_book": "kosmos_humboldt_1845", "target_name": "Papagallo", "similarity": 0.887}], "id": 1027, "stable_key": "clu_3db4a50f5cd0c859", "ground_truth": {"modern_name": "Gulf of Fonseca", "confidence": "medium", "type": "place", "country": "Honduras", "note": "Papagayo is a specific cape within the Gulf of Fonseca, but the context often refers to the larger gulf.", "wikidata_id": "Q103966059", "wikidata_description": "Ecoregion (WWF)", "wikipedia_url": "https://en.wikipedia.org/wiki/Geography_of_Honduras", "wikipedia_extract": "Honduras is a country in Central America. Honduras borders the Caribbean Sea and the North Pacific Ocean. Guatemala lies to the west, Nicaragua south east and El Salvador to the south west. Honduras is the second largest Central American republic, with a total area of 112,777 square kilometres (43,543 sq mi). Honduras has a 700-kilometer (430-mile) Caribbean coastline extending from the mouth of the Río Motagua in the west to the mouth of the Río Coco in the east, at Cape Gracias a Dios. The 922 km (573 mi) southeastern side of the triangle is a land border with Nicaragua."}}, {"canonical_name": "Orenbourg", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "orenbourg", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Orenbourg", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Orenbourg"], "contexts": ["government in Russia", "location for barometric leveling"]}, {"entity_id": "orenburg", "book_id": "kosmos_humboldt_1845", "name": "Orenburg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Orenburg"], "contexts": ["easternmost point of observation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Orenbourg", "target_book": "kosmos_humboldt_1845", "target_name": "Orenburg", "similarity": 0.904}], "id": 1028, "stable_key": "clu_70805cdbbb603e7a", "ground_truth": {"modern_name": "Orenburg", "confidence": "high", "type": "place", "country": "Russia", "wikipedia_extract": "Orenburg (Russian: Оренбу́рг, pronounced [ɐrʲɪnˈburk]), formerly known as Chkalov (1938–1957), is the administrative center of Orenburg Oblast, Russia. It lies in Eastern Europe, near the boundary of Europe and Asia, along the banks of the Ural River, being approximately 1,480 kilometers (920 mi) southeast of Moscow. Orenburg is close to the border with Kazakhstan. It was the capital of the Kazakh ASSR from 1920 to 1925. Several historians have tried to explain the origins of the city's name. It was traditionally accepted that the word \"orenburg\" means a fortress on the River Or."}}, {"canonical_name": "neiges perpétuelles", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "neiges_perpétuelles", "book_id": "relation_historique_humboldt_vol3_1825", "name": "neiges perpétuelles", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["neiges perpétuelles"], "contexts": ["permanent snow cover", "permanent snow line on mountains"]}, {"entity_id": "perpetual_snow-line", "book_id": "kosmos_humboldt_1845", "name": "perpetual snow-line", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["perpetual snow-line"], "contexts": ["elevation where snow persists"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "neiges perpétuelles", "target_book": "kosmos_humboldt_1845", "target_name": "perpetual snow-line", "similarity": 0.875}], "id": 1029, "stable_key": "clu_608cd2140826fa33", "ground_truth": {"modern_name": "Perpetual snow", "confidence": "high", "type": "concept", "wikidata_id": "Q740358", "wikidata_description": "point above which snow and ice cover the ground throughout the year", "wikipedia_extract": "Rollins Pass, elevation 11,676 ft (3,559 m), is a mountain pass and active archaeological site in the Southern Rocky Mountains of north-central Colorado in the United States. The pass is located on and traverses the Continental Divide of the Americas at the crest of the Front Range southwest of Boulder and is located approximately five miles east and opposite the resort in Winter Park—in the general area between Winter Park and Rollinsville. Rollins Pass is at the boundaries of Boulder, Gilpin, and Grand counties. Over the past 10,000 years, the pass provided a route over the Continental Divide between the Atlantic Ocean watershed of South Boulder Creek (in the basin of the South Platte River) with the Pacific Ocean watershed of the Fraser River, a tributary of the Colorado River. The abandoned rail route over Rollins Pass was nominated for and accepted into the National Register of Historic Places in 1980 because of significant events and engineering feats accomplished by railroading efforts in the early 20th century. In 1997, additional areas on the pass were added to the National Register of Historic Places to include achievements made by John Q.A.", "wikipedia_url": "https://en.wikipedia.org/wiki/Snow_line"}}, {"canonical_name": "hypersthénite", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "hypersthénite", "book_id": "relation_historique_humboldt_vol3_1825", "name": "hypersthénite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["hypersthénite", "hypersthène", "hypersthéne"], "contexts": ["rock type", "hypersthene mineral"]}, {"entity_id": "hyperathene", "book_id": "kosmos_humboldt_1845", "name": "hyperathene", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["hyperathene"], "contexts": ["endogenous rock type"]}, {"entity_id": "hypersthene_rock", "book_id": "kosmos_humboldt_1845", "name": "Hypersthene rock", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Hypersthene rock"], "contexts": ["granular mixture of minerals"]}, {"entity_id": "hypersthene", "book_id": "kosmos_humboldt_1845", "name": "hypersthene", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["hypersthene"], "contexts": ["mineral component"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "hypersthénite", "target_book": "kosmos_humboldt_1845", "target_name": "hyperathene", "similarity": 0.895}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "hypersthénite", "target_book": "kosmos_humboldt_1845", "target_name": "Hypersthene rock", "similarity": 0.899}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "hypersthénite", "target_book": "kosmos_humboldt_1845", "target_name": "hypersthene", "similarity": 0.971}], "id": 1030, "stable_key": "clu_c89c3ab144face1b", "ground_truth": {"modern_name": "Hypersthene", "confidence": "high", "type": "mineral", "wikidata_id": "Q60706831", "wikidata_description": "scholarly article", "wikipedia_extract": "Hypersthene is a common rock-forming inosilicate mineral belonging to the group of orthorhombic pyroxenes. Its chemical formula is (Mg,Fe)SiO3. It is found in igneous and some metamorphic rocks as well as in stony and iron meteorites. Many references have formally abandoned this term, preferring to categorise this mineral as enstatite or ferrosilite. It forms a solid solution series with the minerals enstatite and ferrosilite, being a mid-way member between the two. Pure enstatite contains no iron, while pure ferrosilite contains no magnesium; hypersthene is the name given to the mineral when a significant amount of both elements are present."}}, {"canonical_name": "Archipel de San Bernardo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "archipel_de_san_bernardo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Archipel de San Bernardo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Archipel de San Bernardo", "Archipel de Saint-Bernard"], "contexts": ["archipelago", "archipelago passed through"]}, {"entity_id": "san_bernardo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "San Bernardo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["San Bernardo"], "contexts": ["village where colonists reunited", "village where colons were forced to unite"]}, {"entity_id": "planes_de_san_bernardo", "book_id": "kosmos_humboldt_1845", "name": "Planes de San Bernardo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Planes de San Bernardo"], "contexts": ["specific planes within Valenciana mine"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Archipel de San Bernardo", "target_book": "kosmos_humboldt_1845", "target_name": "Planes de San Bernardo", "similarity": 0.84}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "San Bernardo", "target_book": "kosmos_humboldt_1845", "target_name": "Planes de San Bernardo", "similarity": 0.856}], "id": 1031, "stable_key": "clu_bace07d883c91909", "ground_truth": {"modern_name": "Archipelago of San Bernardo", "confidence": "medium", "type": "place", "country": "Colombia", "note": "The term 'Planes de San Bernardo' suggests specific areas within a larger context that seems to be the archipelago.", "wikidata_id": "Q4786925", "wikidata_description": "Group of coastal islands of Colombia in the Caribbean sea", "wikipedia_extract": "The Archipelago of San Bernardo (Spanish: Archipiélago de San Bernardo, Islas de San Bernardo) is a set of nine coastal coral islands and one artificial island (ten in total) belonging to and governed by Colombia, located in the Gulf of Morrosquillo in the Caribbean Sea, with an approximate area of 213 km2. Administratively, the archipelago belongs to the Bolívar Department, with the exception of Boquerón Island, which belongs to the Sucre Department. It consists of Boquerón Island, Cabruna Island, Ceycén Island, Mangle Island, Múcura Island, Palma Island, Panda Island, Santa Cruz del Islote (English: Santa Cruz Islet, an artificial island), Tintipán Island and Maravilla Island. All the 10 islands are close to the towns of Tolú and Coveñas. Since 1996, part of the archipelago belongs to the Rosario and San Bernardo Corals National Natural Park. Lodging facilities are present on some of the islands, primarily Múcura Island and Palma Island."}}, {"canonical_name": "Maine", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "maine", "book_id": "kosmos_humboldt_1845", "name": "Maine", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Maine"], "contexts": ["state where J. G. Clarke observed comet", "river region in Germany"]}, {"entity_id": "maine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Maine", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Maine"], "contexts": ["state separated from Massachusets", "State in the United States"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Maine", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Maine", "similarity": 1.0}], "id": 1032, "stable_key": "clu_f375b59fe6a0b97b", "ground_truth": {"modern_name": "Maine", "confidence": "high", "type": "place", "country": "United States", "wikipedia_extract": "Maine (  MAYN) is a state in the New England region of the United States, and the northeasternmost state in the contiguous United States. It borders New Hampshire to the west, the Gulf of Maine to the southeast, and the Canadian provinces of New Brunswick and Quebec to the northeast and northwest, and shares a maritime border with Nova Scotia. It is the only state to border only one other state, which is New Hampshire. Maine is the largest state in New England by total area, almost as large as the combined area of the remaining five states. Of the 50 U.S. states, it is the 12th-smallest by area, the 9th-least populous, the 13th-least densely populated, and the most rural. As of 2024, Maine's population stood at a Census-estimated 1,400,000, the state's highest-ever population estimate."}}, {"canonical_name": "Dhawalagiri", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "dhawalagiri", "book_id": "kosmos_humboldt_1845", "name": "Dhawalagiri", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Dhawalagiri"], "contexts": ["mountain elevation data", "highest point of the Himalaya"]}, {"entity_id": "dhawalagiri", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Dhawalagiri", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Dhawalagiri", "Dbanalagiri"], "contexts": ["peak in the Himalayas"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Dhawalagiri", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Dhawalagiri", "similarity": 1.0}], "id": 1033, "stable_key": "clu_e993a5a35abaa594", "ground_truth": {"modern_name": "Dhaulagiri", "confidence": "high", "type": "place", "country": "Nepal", "wikidata_id": "Q2564224", "wikidata_description": "genus of arachnids", "wikipedia_extract": "The eight-thousanders are the 14 mountains that rise more than 8,000 metres (26,247 ft) above sea level. They are all in the Himalayan and Karakoram mountain ranges. This is a list of mountaineers who have died on these mountains. Mount Everest, Earth's highest mountain at 8,848.86 metres (29,031.7 ft) above sea level, has been host to numerous tragedies. Deaths have occurred on the mountain every year since 1978, excluding 2020, when permits were not issued due to the COVID-19 pandemic. The most notable deadly events on Everest were the 1922 British Mount Everest expedition, 1970 Mount Everest disaster, 1974 French Mount Everest expedition, 1996 Mount Everest disaster, 2014 Mount Everest ice avalanche, 2015 Mount Everest avalanches and 2023 Mount Everest season.", "wikipedia_url": "https://en.wikipedia.org/wiki/List_of_deaths_on_eight-thousanders"}}, {"canonical_name": "Gottingen", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "gottingen", "book_id": "kosmos_humboldt_1845", "name": "Gottingen", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Gottingen"], "contexts": ["location of education", "city used for longitude determination"]}, {"entity_id": "gôttingue", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Gôttingue", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Gôttingue", "Göttingue"], "contexts": ["a city", "location of observation"]}, {"entity_id": "gottingue", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Gottingue", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Gottingue"], "contexts": ["city in Germany", "city where magnetic inclination was measured"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Gottingen", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Gôttingue", "similarity": 0.863}, {"source_book": "kosmos_humboldt_1845", "source_name": "Gottingen", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Gottingue", "similarity": 0.871}], "id": 1034, "stable_key": "clu_157c7a159044038a", "ground_truth": {"modern_name": "Göttingen", "confidence": "high", "type": "place", "country": "Germany", "wikidata_id": "Q3033", "wikidata_description": "large city in Lower Saxony, Germany", "wikipedia_url": "https://en.wikipedia.org/wiki/University_of_Göttingen", "wikipedia_extract": "The University of Göttingen, officially the Georg August University of Göttingen (German: Georg-August-Universität Göttingen, commonly referred to as Georgia Augusta), is a public research university in the city of Göttingen, Lower Saxony, Germany. Founded in 1734 by George II, King of Great Britain and Elector of Hanover, it began instruction in 1737 and is recognized as the oldest university in Lower Saxony. Recognized for its historic and traditional significance, the university has affiliations with 47 Nobel Prize winners by its own count. The University of Göttingen reached its academic peak from the late 19th to early 20th century, establishing itself as a major international center for mathematics and physics. During this period, scholars such as David Hilbert, Felix Klein, Max Born, and Ludwig Prandtl conducted influential research in mathematics, quantum mechanics, and aerodynamics. The university attracted international students, including prominent Americans such as Edward Everett, George Bancroft, John Lothrop Motley, and J."}}, {"canonical_name": "Massachusetts", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "massachusetts", "book_id": "kosmos_humboldt_1845", "name": "Massachusetts", "category": "PLACE", "subcategory": "COUNTRY", "count": 5, "variants": ["Massachusetts"], "contexts": ["location where translator saw comet", "state where fall of stars observed"]}, {"entity_id": "massachusetts", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Massachusetts", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Massachusetts"], "contexts": ["state in the United States", "origin of the author Abiel Abbot"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Massachusetts", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Massachusetts", "similarity": 1.0}], "id": 1035, "stable_key": "clu_981a29819d01d2f2", "ground_truth": {"modern_name": "Massachusetts", "confidence": "high", "type": "place", "country": "United States", "wikidata_id": "Q771", "wikidata_description": "state of the United States of America", "wikipedia_url": "https://en.wikipedia.org/wiki/Massachusetts", "wikipedia_extract": "Massachusetts (   MASS-ə-CHOO-sits, -⁠zits; Massachusett: Muhsachuweesut [məhswatʃəwiːsət]), officially the Commonwealth of Massachusetts, is a state in the New England region of the Northeastern United States. It borders the Atlantic Ocean and the Gulf of Maine to its east, Connecticut and Rhode Island to its south, New Hampshire and Vermont to its north, and New York to its west. Massachusetts is the seventh-smallest state by land area. With an estimated population of over 7.1 million, it is the most populous state in New England, the 16th-most-populous in the United States, and the third-most densely populated U.S. state, after New Jersey and Rhode Island. Massachusetts was a site of early English colonization."}}, {"canonical_name": "Neptune", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "neptune", "book_id": "kosmos_humboldt_1845", "name": "Neptune", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 6, "variants": ["Neptune"], "contexts": ["primary planet in the solar system", "planet beyond Uranus"]}, {"entity_id": "neptune", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Neptune", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Neptune"], "contexts": ["Escalier de Neptune"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Neptune", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Neptune", "similarity": 1.0}], "id": 1036, "stable_key": "clu_78508b11dff76cfc", "ground_truth": {"modern_name": "Neptune", "confidence": "high", "type": "object", "wikidata_id": "Q107636904", "wikidata_description": "given name", "wikipedia_extract": "The Neptunes were an American record production duo composed of Pharrell Williams and Chad Hugo, formed in Virginia Beach, Virginia, in 1992. Williams often provided backing vocals and music video appearances on the duo's productions, while Hugo remained behind the scenes. Since their inception, the Neptunes have produced songs for several music industry artists, including Clipse, Jay-Z, Kelis, N.O.R.E., Britney Spears, Justin Timberlake, Nelly, Ludacris, T.I., Robin Thicke, Usher, Gwen Stefani, and Snoop Dogg, among others. In 2009, Billboard ranked the Neptunes number one on their list of the top 10 producers of the decade. In January 2020, the Neptunes were announced to be inducted into the Songwriters Hall of Fame as a part of the 2020 class, and in May 2021, Hugo and Williams received Honorary Doctorates from Berklee College of Music and Boston Conservatory at Berklee. Williams and Hugo met at a summer camp for the school of the Gifted and Talented in Virginia Beach, Virginia, where Williams played drums and Hugo played tenor saxophone.", "wikipedia_url": "https://en.wikipedia.org/wiki/The_Neptunes"}}, {"canonical_name": "dolomite", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "dolomite", "book_id": "kosmos_humboldt_1845", "name": "dolomite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["dolomite"], "contexts": ["carbonate rock", "rock formed by volcanic modification"]}, {"entity_id": "dolomit", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Dolomit", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Dolomit"], "contexts": ["mineral discussed in a geological work"]}, {"entity_id": "dolomit", "book_id": "kosmos_humboldt_1845", "name": "Dolomit", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Dolomit"], "contexts": ["type of rock"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "dolomite", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Dolomit", "similarity": 0.847}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Dolomit", "target_book": "kosmos_humboldt_1845", "target_name": "Dolomit", "similarity": 1.0}], "id": 1037, "stable_key": "clu_018bb2ddf3c151be", "ground_truth": {"modern_name": "dolomite", "confidence": "high", "type": "mineral", "wikipedia_extract": "Limestone is a type of carbonate sedimentary rock which is the main source of the material lime. It is composed mostly of the minerals calcite and aragonite, which are different crystal forms of calcium carbonate CaCO3. Limestone forms when these minerals precipitate out of water containing dissolved calcium. This can take place through both biological and nonbiological processes, though biological processes, such as the accumulation of corals and shells in the sea, have likely been more important for the last 540 million years. Limestone often contains fossils which provide scientists with information on ancient environments and on the evolution of life. About 20% to 25% of sedimentary rock is carbonate rock, and most of this is limestone.", "wikipedia_url": "https://en.wikipedia.org/wiki/Limestone"}}, {"canonical_name": "colonies espagnoles", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "colonies_espagnoles", "book_id": "relation_historique_humboldt_vol3_1825", "name": "colonies espagnoles", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["colonies espagnoles"], "contexts": ["Spanish colonial territories", "territories governed by Spain"]}, {"entity_id": "colonies", "book_id": "first_principles_spencer_1862", "name": "colonies", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["colonies"], "contexts": ["settlements in a foreign land"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "colonies espagnoles", "target_book": "first_principles_spencer_1862", "target_name": "colonies", "similarity": 0.819}], "id": 1038, "stable_key": "clu_630af73e1705f0b8", "ground_truth": {"modern_name": "Spanish colonies", "confidence": "medium", "type": "place", "country": "Various", "note": "The term 'colonies espagnoles' refers to the territories governed by Spain, rather than a single modern country.", "wikidata_id": "Q80702", "wikidata_description": "colonial empire governed by Spain between 1492 and 1976", "wikipedia_extract": "The Spanish Empire, sometimes referred to as the Hispanic Monarchy or the Catholic Monarchy, was a colonial empire that existed between 1492 and 1976. In conjunction with the Portuguese Empire, it ushered in the European Age of Discovery. It achieved a global scale, controlling vast portions of the Americas, Africa, various islands in Asia and Oceania, as well as territory in other parts of Europe. It was one of the most powerful empires of the early modern period, becoming known as \"the empire on which the sun never sets\". At its greatest extent in the late 1700s and early 1800s, the Spanish Empire covered 13.7 million square kilometres (5.3 million square miles), making it one of the largest empires in history. Beginning with the 1492 arrival of Christopher Columbus and continuing for over three centuries, the Spanish Empire would expand across the Caribbean Islands, half of South America, most of Central America and much of North America.", "wikipedia_url": "https://en.wikipedia.org/wiki/Spanish_Empire"}}, {"canonical_name": "Granada", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "granada", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Granada", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Granada"], "contexts": ["city in Nicaragua", "city with volcanoes"]}, {"entity_id": "granado", "book_id": "historia_medicinal_monardes_1574", "name": "Granado", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Granado", "Granada"], "contexts": ["tree larger than a pomegranate tree", "city larger than this tree"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Granada", "target_book": "historia_medicinal_monardes_1574", "target_name": "Granado", "similarity": 0.866}], "id": 1039, "stable_key": "clu_2b9cf6f2c3087bda", "ground_truth": {"modern_name": "Granada", "confidence": "high", "type": "place", "description": "A city, possibly referencing locations in Nicaragua or Spain.", "note": "'Granado' likely refers to a specific tree or location name derived from it.", "wikipedia_extract": "Granada ( grə-NAH-də; Spanish: [ɡɾaˈnaða] ) is the capital city of the province of Granada, in the autonomous community of Andalusia, Spain. Granada is located at the foot of the Sierra Nevada mountains, at the confluence of four rivers, the Darro, the Genil, the Monachil and the Beiro. Ascribed to the Vega de Granada comarca, the city sits at an average elevation of 738 m (2,421 ft) above sea level, yet is only one hour by car from the Mediterranean coast, the Costa Tropical. With a population of 233,532 as of 2024, it is the 20th-largest city in Spain. Nearby is the Sierra Nevada Ski Station, where the FIS Alpine World Ski Championships 1996 were held. Its nearest airport is Federico García Lorca Granada-Jaén Airport."}}, {"canonical_name": "Barigon", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "barigon", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Barigon", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["Barigon", "BARIGON"], "contexts": ["limestone mountain with difficult access", "mountain name"]}, {"entity_id": "bariga", "book_id": "coloquios_da_orta_1563", "name": "Bariga", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Bariga"], "contexts": ["name for smaller camphor grains"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Barigon", "target_book": "coloquios_da_orta_1563", "target_name": "Bariga", "similarity": 0.857}], "id": 1040, "stable_key": "clu_60bef6dce98d37da", "ground_truth": {"modern_name": "Barigon / Bariga", "confidence": "medium", "type": "substance", "description": "Limestone mountain and smaller camphor grains.", "note": "The connection between the mountain and camphor grains is unclear and may be coincidental or represent different usages of the term."}}, {"canonical_name": "Jaen", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "jaen", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Jaen", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Jaen", "Jaèn"], "contexts": ["city in Peru", "province in Peru"]}, {"entity_id": "jamen", "book_id": "coloquios_da_orta_1563", "name": "Jamen", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Jamen", "Jamem"], "contexts": ["lands near Amem", "land where tamarind is not found"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Jaen", "target_book": "coloquios_da_orta_1563", "target_name": "Jamen", "similarity": 0.878}], "id": 1041, "stable_key": "clu_738f0e384c2b0fb0", "ground_truth": {"modern_name": "Jaén", "confidence": "medium", "type": "place", "description": "City and province in Peru, also lands near Amem.", "note": "The reference to 'Jamen' in relation to Amem might indicate a different or less precise geographical scope.", "wikipedia_extract": "Jaén (Spanish: [xaˈen] ) is a municipality of Spain and the capital of the province of Jaén, in the autonomous community of Andalusia. The city of Jaén is the administrative and industrial centre for the province. Industrial establishments in the city include chemical works, tanneries, distilleries, cookie factories, textile factories, as well as agricultural and olive oil processing machinery industry. The layout of Jaén is determined by its position on the foothills of the Cerro de Santa Catalina, with steep, narrow streets, in the historic core. Its population is 112,757 (2020), about one-sixth of the population of the province. Jaén had an increase in cultural tourism in the mid-2010s, having received 604,523 tourists in 2015, 10% more than in 2014."}}, {"canonical_name": "Sao Pedro de Alfama", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "sao_pedro_de_alfama", "book_id": "polyanthea_medicinal", "name": "Sao Pedro de Alfama", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["Sao Pedro de Alfama", "Igreja de Sao Miguel de Alfama", "Sao Miguel de Alfama", "São Miguel de Alfama", "São Miguelde Alfama"], "contexts": ["parish where Maria Falcata lived", "location of Pedro Gonçalves' residence"]}, {"entity_id": "san_pedro_alcantara", "book_id": "relation_historique_humboldt_vol3_1825", "name": "San Pedro Alcantara", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["San Pedro Alcantara"], "contexts": ["mission name"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Sao Pedro de Alfama", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "San Pedro Alcantara", "similarity": 0.846}], "id": 1042, "stable_key": "clu_b43447937ac054d3", "ground_truth": {"modern_name": "Alfama", "confidence": "low", "type": "place", "description": "A historic parish in Lisbon, Portugal, associated with residences and specific individuals.", "note": "The name 'San Pedro Alcantara' refers to a mission, suggesting a broader geographical context than just Alfama. 'Alfama' is the more prominent and consistently used term.", "wikipedia_extract": "The Alfama (Portuguese pronunciation: [alˈfɐmɐ]) is the oldest neighborhood of Lisbon, spreading on the slope between the São Jorge Castle and the Tagus river. The district includes the freguesias (parishes) of São Miguel, Santo Estêvão, São Vicente de Fora and part of the two streets, \"Freguesia da Sé: Rua do Barão\" and \"Rua São João da Praça\". It contains many important historical attractions, as well as an abundance of Fado bars and restaurants. The name Alfama originates from the Arabic al-ḥamma (الحَمّة), meaning \"hot springs\". The Arabic word comes from the root meaning \"to heat\" or \"to become hot\", from which the word hammam (Arabic: حَمَّام, lit. 'bath, bathhouse') also derives. The Rua do Barão is one of the streets of the Freguesia da Sé, which begins at the Rua São João da Praça (where once stood the Door of the Alfama) and ends at Rua Augusto Rosa (at the Cathedral's walls)."}}, {"canonical_name": "lavaredas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "lavaredas", "book_id": "polyanthea_medicinal", "name": "lavaredas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["lavaredas", "Lavativos", "lavareda"], "contexts": ["visual symptom before nerve accidents", "visual disturbance preceding cataracts"]}, {"entity_id": "lavages", "book_id": "relation_historique_humboldt_vol3_1825", "name": "lavages", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["lavages"], "contexts": ["abandoned mining technique"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "lavaredas", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "lavages", "similarity": 0.857}], "id": 1043, "stable_key": "clu_7f8370e03cd7af6c", "ground_truth": {"modern_name": "Visual disturbance", "confidence": "high", "type": "concept", "description": "A sensory perception issue, particularly visual, that can precede other medical conditions.", "note": "The term 'lavaredas' in a medical context refers to a visual symptom. 'Lavages' in a mining context refers to a technique. The former seems to be the primary meaning.", "wikipedia_extract": "A vision disorder is an impairment of the sense of vision. Vision disorder is not the same as an eye disease. Although many vision disorders do have their immediate cause in the eye, there are many other causes that may occur at other locations in the optic pathway. There are many eye conditions that can lead to vision disorder. Some of which are as follows: Age-Related Macular Degeneration (ARMD): ARMD is a retinal degeneration disease specifically associated with macula blood vessels, which can result in central vision impairment. It is strongly linked to advancing age, as well as European ancestry."}}, {"canonical_name": "St. Lawrence", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "st__lawrence", "book_id": "kosmos_humboldt_1845", "name": "St. Lawrence", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["St. Lawrence"], "contexts": ["stream of meteors", "associated with August meteor phenomenon"]}, {"entity_id": "river_st__lawrence", "book_id": "connexion_physical_sciences_somerville_1858", "name": "river St. Lawrence", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["river St. Lawrence"], "contexts": ["frozen river used for travel"]}, {"entity_id": "gulf_of_st__lawrence", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Gulf of St. Lawrence", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Gulf of St. Lawrence"], "contexts": ["location of luminous sea observation"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "St. Lawrence", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "river St. Lawrence", "similarity": 0.895}, {"source_book": "kosmos_humboldt_1845", "source_name": "St. Lawrence", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Gulf of St. Lawrence", "similarity": 0.874}], "id": 1044, "stable_key": "clu_8259b600c3ed4f7e", "ground_truth": {"modern_name": "St. Lawrence River", "confidence": "high", "type": "place", "country": "Canada", "note": "While the cluster mentions 'stream of meteors' and 'luminous sea observation', the primary referent in the context of place names is the St. Lawrence River and its Gulf.", "wikidata_id": "Q134750", "wikidata_description": "major river in eastern Canada and the United States, flowing into the Gulf of St. Lawrence", "wikipedia_extract": "The St. Lawrence River (French: Fleuve Saint-Laurent, pronounced [flœv sɛ̃ lɔʁɑ̃]) is a large international river in the middle latitudes of North America connecting the Great Lakes with the North Atlantic Ocean. Its waters flow in a northeasterly direction from Lake Ontario to the Gulf of St. Lawrence, traversing Ontario and Quebec in Canada and New York in the United States. A portion of the river demarcates the Canada–United States border. As the primary drainage outflow of the Great Lakes Basin, the St.", "wikipedia_url": "https://en.wikipedia.org/wiki/St._Lawrence_River"}}, {"canonical_name": "fancy", "category": "CONCEPT", "subcategory": "MENTAL_FACULTY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "fancy", "book_id": "principles_of_psychology_james_1890", "name": "fancy", "category": "CONCEPT", "subcategory": "MENTAL_FACULTY", "count": 6, "variants": ["Fancy", "fancy"], "contexts": ["imagination or mind", "imagination where words contract relation"]}, {"entity_id": "fancy", "book_id": "kosmos_humboldt_1845", "name": "fancy", "category": "CONCEPT", "subcategory": "MENTAL_FACULTY", "count": 1, "variants": ["fancy"], "contexts": ["imagination and creativity"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "fancy", "target_book": "kosmos_humboldt_1845", "target_name": "fancy", "similarity": 1.0}], "id": 1045, "stable_key": "clu_1af22f27284003d3", "ground_truth": {"modern_name": "imagination", "confidence": "high", "type": "concept", "wikidata_id": "Q91048696", "wikidata_description": "vocal track by Bob Dylan; 2017 studio recording; cover version", "wikipedia_extract": "Sociological imagination is a term used in the field of sociology to describe a framework for understanding social reality that places personal experiences within a broader social and historical context. It was coined by American sociologist C. Wright Mills in his 1959 book The Sociological Imagination to describe the type of insight offered by the discipline of sociology. Today, the term is used in many sociology textbooks to explain the nature of sociology and its relevance in daily life. In The Sociological Imagination, Mills attempts to reconcile two different and abstract concepts of social reality: the \"individual\" and the \"society.\" Accordingly, Mills defined sociological imagination as \"the awareness of the relationship between personal experience and the wider society.\" In exercising one's sociological imagination, one seeks to understand situations in one's life by looking at situations in broader society. For example, a single student who fails to keep up with the academic demands of college and ends up dropping out may be perceived to have faced personal difficulties or faults; however, when one considers that around 50% of college students in the United States fail to graduate, we can understand this one student's trajectory as part of a larger social issue.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sociological_imagination"}}, {"canonical_name": "Bafilio Valentino", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "bafilio_valentino", "book_id": "polyanthea_medicinal", "name": "Bafilio Valentino", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Bafilio Valentino", "Bafilius Valentin", "Basilio Valentino"], "contexts": ["praised stibium as a remedy", "author on antimony"]}, {"entity_id": "valentin", "book_id": "principles_of_psychology_james_1890", "name": "Valentin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Valentin"], "contexts": ["cited physiologist", "author of Physiology text"]}, {"entity_id": "valentin", "book_id": "polyanthea_medicinal", "name": "Valentin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Valentin", "Valentinus"], "contexts": ["mentioned in relation to antimony", "early modern scholar"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Bafilio Valentino", "target_book": "principles_of_psychology_james_1890", "target_name": "Valentin", "similarity": 0.81}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Valentin", "target_book": "polyanthea_medicinal", "target_name": "Valentin", "similarity": 1.0}], "id": 1046, "stable_key": "clu_5288490fcc42b96d", "ground_truth": {"modern_name": "Bafilio Valentino", "confidence": "high", "type": "person", "description": "Early modern scholar and physiologist, author on antimony."}}, {"canonical_name": "synthesis", "category": "CONCEPT", "subcategory": "COGNITIVE_PROCESS", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "synthesis", "book_id": "principles_of_psychology_james_1890", "name": "synthesis", "category": "CONCEPT", "subcategory": "COGNITIVE_PROCESS", "count": 6, "variants": ["synthesis"], "contexts": ["combining elements into a whole", "function of combining elements"]}, {"entity_id": "synthesis", "book_id": "first_principles_spencer_1862", "name": "synthesis", "category": "CONCEPT", "subcategory": "COGNITIVE_PROCESS", "count": 1, "variants": ["synthesis"], "contexts": ["combining components into a whole"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "synthesis", "target_book": "first_principles_spencer_1862", "target_name": "synthesis", "similarity": 1.0}], "id": 1047, "stable_key": "clu_a863b3c397d40319", "ground_truth": {"modern_name": "synthesis", "confidence": "high", "type": "concept", "wikidata_id": "Q851162", "wikidata_description": "multi-step, enzyme-catalyzed process where substrates are converted into more complex products in living organisms. In biosynthesis, simple compounds are modified, converted into other compounds, or joined to form macromolecules", "wikipedia_url": "https://en.wikipedia.org/wiki/Biosynthesis"}}, {"canonical_name": "Essay", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "essay", "book_id": "principles_of_psychology_james_1890", "name": "Essay", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 4, "variants": ["Essay"], "contexts": ["Locke's major philosophical work", "Locke's philosophical work"]}, {"entity_id": "essays_philosophical_and_theological", "book_id": "principles_of_psychology_james_1890", "name": "Essays Philosophical and Theological", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Essays Philosophical and Theological"], "contexts": ["cited work, likely a book title"]}, {"entity_id": "essays", "book_id": "first_principles_spencer_1862", "name": "Essays", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 2, "variants": ["Essays"], "contexts": ["collection of essays", "publication title"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Essay", "target_book": "first_principles_spencer_1862", "target_name": "Essays", "similarity": 0.963}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Essays Philosophical and Theological", "target_book": "first_principles_spencer_1862", "target_name": "Essays", "similarity": 0.844}], "id": 1048, "stable_key": "clu_2c1af25dc2c1ae87", "ground_truth": {"modern_name": "essay", "confidence": "high", "type": "text", "wikidata_id": "Q35760", "wikidata_description": "piece of writing often written from an author's personal point of view", "wikipedia_url": "https://en.wikipedia.org/wiki/Essay", "wikipedia_extract": "An essay (, ESS-ay) is, generally, a piece of writing that gives the author's own argument, but the definition is vague, overlapping with those of a letter, a paper, an article, a pamphlet, and a short story. Essays have been sub-classified as formal and informal: formal essays are characterized by \"serious purpose, dignity, logical organization, length,\" whereas the informal essay is characterized by \"the personal element (self-revelation, individual tastes and experiences, confidential manner), humor, graceful style, rambling structure, unconventionality or novelty of theme,\" etc. Essays are commonly used as literary criticism, political manifestos, learned arguments, observations of daily life, recollections, and reflections of the author. Almost all modern essays are written in prose, but works in verse have been dubbed essays (e.g., Alexander Pope's An Essay on Criticism and An Essay on Man). While brevity usually defines an essay, voluminous works like John Locke's An Essay Concerning Human Understanding and Thomas Malthus's An Essay on the Principle of Population are counterexamples. In some countries, such as the United States and Canada, essays have become a major part of formal education."}}, {"canonical_name": "malayos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "malayos", "book_id": "coloquios_da_orta_1563", "name": "malayos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["malayos", "Malayos", "malaya"], "contexts": ["people who corrupted the name of calamus", "called coconuts calapa laut"]}, {"entity_id": "malayan", "book_id": "kosmos_humboldt_1845", "name": "Malayan", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Malayan"], "contexts": ["one of Blumenbach's five races"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "malayos", "target_book": "kosmos_humboldt_1845", "target_name": "Malayan", "similarity": 0.905}], "id": 1049, "stable_key": "clu_e605086b438f1a11", "ground_truth": {"modern_name": "Malays", "confidence": "high", "type": "concept", "wikidata_id": "Q833", "wikidata_description": "country in Southeast Asia", "wikipedia_url": "https://en.wikipedia.org/wiki/Malaysia", "wikipedia_extract": "Malaysia is a country in Southeast Asia. A federal constitutional monarchy, it consists of 13 states and three federal territories, separated by the South China Sea into two regions: Peninsular Malaysia on the Indochinese Peninsula and East Malaysia on the island of Borneo. Peninsular Malaysia shares land and maritime borders with Thailand, as well as maritime borders with Singapore, Vietnam, and Indonesia; East Malaysia shares land borders with Brunei and Indonesia, and maritime borders with the Philippines and Vietnam. Kuala Lumpur is the country's national capital, largest city, and the seat of the legislative branch of the federal government, while Putrajaya is the federal administrative capital, representing the seat of both the executive branch and the judicial branch of the federal government. With a population of over 34 million, it is the world's 42nd-most populous country. The country has its origins in the Malay kingdoms, which, from the 18th century on, became subject to the British Empire, along with the British Straits Settlements protectorate."}}, {"canonical_name": "Licia", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "licia", "book_id": "coloquios_da_orta_1563", "name": "Licia", "category": "PLACE", "subcategory": "REGION", "count": 6, "variants": ["Licia", "Lycia"], "contexts": ["province in Turkey", "region where substance is found"]}, {"entity_id": "lycia", "book_id": "kosmos_humboldt_1845", "name": "Lycia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Lycia"], "contexts": ["ancient region"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Licia", "target_book": "kosmos_humboldt_1845", "target_name": "Lycia", "similarity": 0.905}], "id": 1050, "stable_key": "clu_707eb606f0864627", "ground_truth": {"modern_name": "Lycia", "confidence": "high", "type": "place", "country": "Turkey", "wikidata_id": "Q3268401", "wikidata_description": "genus of insects", "wikipedia_extract": "Lycia (; Lycian: 𐊗𐊕𐊐𐊎𐊆𐊖 Trm̃mis; Greek: Λυκία, Lykia; Turkish: Likya) was a historical region in Anatolia from 15–14th centuries BC (as Lukka) to 546 BC. It bordered the Mediterranean Sea in what is today the provinces of Antalya and Muğla in Turkey as well some inland parts of Burdur Province. The region was known to history from the Late Bronze Age records of ancient Egypt and the Hittite Empire. Lycia was populated by speakers of Luwic languages. Written records began to be inscribed in stone in the Lycian language after Lycia's involuntary incorporation into the Achaemenid Empire in the Iron Age. At that time (546 BC) the Luwian speakers were displaced as Lycia received an influx of Persian speakers.", "wikipedia_url": "https://en.wikipedia.org/wiki/Lycia_%28moth%29"}}, {"canonical_name": "comet", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "comet", "book_id": "kosmos_humboldt_1845", "name": "comet", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["comet"], "contexts": ["type of inclination for Pallas", "celestial body with tail"]}, {"entity_id": "comet_of_1264", "book_id": "connexion_physical_sciences_somerville_1858", "name": "comet of 1264", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["comet of 1264", "Comet of 1264"], "contexts": ["historical comet observation", "recorded by Chinese"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "comet", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "comet of 1264", "similarity": 0.819}], "id": 1051, "stable_key": "clu_d01f7f44b9c93aa3", "ground_truth": {"modern_name": "comet", "confidence": "high", "type": "concept", "wikipedia_extract": "Comets have been observed by humanity for thousands of years, but only in the past few centuries have they been studied as astronomical phenomena. Before modern times, great comets caused worldwide fear, considered bad omens foreboding disaster and turmoil, for example the 1066 passage of Halley's Comet depicted as heralding the Norman conquest of England. As the science of astronomy developed planetary theories, understanding the nature and composition of comets became a challenging mystery and a large area of study. Halley's comet, reappearing every 75–76 years, was pivotal to the study of comets, especially of their orbits. Thinkers such as Immanuel Kant in the eighteenth century hypothesized about the physical composition of comets. Today, comets are well understood as \"dirty snowballs\" in eccentric orbits around the Sun, but they continue as objects of scientific and popular fascination.", "wikipedia_url": "https://en.wikipedia.org/wiki/Observational_history_of_comets"}}, {"canonical_name": "Xaraue", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "xaraue", "book_id": "historia_medicinal_monardes_1574", "name": "Xaraue", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 5, "variants": ["Xaraue", "xaraue", "xaraues"], "contexts": ["sweet liquid preparation", "syrup for medicinal preparations"]}, {"entity_id": "xaráo", "book_id": "coloquios_da_orta_1563", "name": "xaráo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["xaráo", "xardo"], "contexts": ["stronger distilled spirit", "word for drink, derived from Arabic"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Xaraue", "target_book": "coloquios_da_orta_1563", "target_name": "xaráo", "similarity": 0.918}], "id": 1052, "stable_key": "clu_175fecfaa2fa97b2", "ground_truth": {"modern_name": "Xaraue", "confidence": "high", "type": "substance", "description": "A sweet, distilled liquid preparation, likely a spirit or syrup.", "note": "Derived from Arabic 'xaráo' meaning drink."}}, {"canonical_name": "agua de lengua de buey", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "agua_de_lengua_de_buey", "book_id": "historia_medicinal_monardes_1574", "name": "agua de lengua de buey", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["agua de lengua de buey", "agua de legua de buey", "agua de lengua de Buey"], "contexts": ["water of ox tongue", "water with ox tongue"]}, {"entity_id": "agua_de_linguade_vacca", "book_id": "polyanthea_medicinal", "name": "agua de linguade vacca", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["agua de linguade vacca"], "contexts": ["cow's tongue water for ointment"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "agua de lengua de buey", "target_book": "polyanthea_medicinal", "target_name": "agua de linguade vacca", "similarity": 0.889}], "id": 1053, "stable_key": "clu_53a86599d55f2fb0", "ground_truth": {"modern_name": "Water of Ox Tongue", "confidence": "high", "type": "substance", "description": "A medicinal preparation made with ox tongue.", "wikipedia_extract": "Redox potential (also known as oxidation / reduction potential, ORP, pe, ) is a measure of the tendency of a chemical species to acquire electrons from or lose electrons to an electrode and thereby be reduced or oxidised respectively. Redox potential is expressed in volts (V). Each species has its own intrinsic redox potential; for example, the more positive the reduction potential (reduction potential is more often used due to general formalism in electrochemistry), the greater the species' affinity for electrons and tendency to be reduced. In aqueous solutions, redox potential is a measure of the tendency of the solution to either gain or lose electrons in a reaction. A solution with a higher (more positive) reduction potential than some other molecule will have a tendency to gain electrons from this molecule (i.e. to be reduced by oxidizing this other molecule) and a solution with a lower (more negative) reduction potential will have a tendency to lose electrons to other substances (i.e. to be oxidized by reducing the other substance). Because the absolute potentials are next to impossible to accurately measure, reduction potentials are defined relative to a reference electrode."}}, {"canonical_name": "chirurgía", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "chirurgía", "book_id": "historia_medicinal_monardes_1574", "name": "chirurgía", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["chirurgía", "Chirurgía", "chirurgia"], "contexts": ["practice of healing wounds", "field using surgical instruments"]}, {"entity_id": "chirurg_", "book_id": "polyanthea_medicinal", "name": "Chirurg.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Chirurg.", "Chirurgicar."], "contexts": ["surgical practice", "abbreviation for surgery"]}, {"entity_id": "cirurgiade", "book_id": "polyanthea_medicinal", "name": "Cirurgiade", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Cirurgiade"], "contexts": ["surgery"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "chirurgía", "target_book": "polyanthea_medicinal", "target_name": "Chirurg.", "similarity": 0.926}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "chirurgía", "target_book": "polyanthea_medicinal", "target_name": "Cirurgiade", "similarity": 0.931}], "id": 1054, "stable_key": "clu_e52524bde423ce9c", "ground_truth": {"modern_name": "Surgery", "confidence": "high", "type": "concept", "description": "The medical practice of healing wounds using instruments.", "wikipedia_extract": "Surgery is a medical specialty that uses manual and instrumental techniques to diagnose or treat pathological conditions (e.g., trauma, disease, injury, malignancy), to alter bodily functions (e.g., malabsorption created by bariatric surgery such as gastric bypass), to reconstruct or alter aesthetics and appearance (cosmetic surgery), or to remove unwanted tissues, neoplasms and foreign bodies. The act of performing surgery may be called a surgical procedure or surgical operation, or simply \"surgery\" or \"operation\". In this context, the verb \"operate\" means to perform surgery. The adjective surgical means pertaining to surgery; e.g. surgical instruments, surgical facility or surgical nurse. Most surgical procedures are performed by a pair of operators: a surgeon who is the main operator performing the surgery, and a surgical assistant who provides in-procedure manual assistance during surgery. Modern surgical operations typically require a surgical team that typically consists of the surgeon, the surgical assistant, an anaesthetist (often also complemented by an anaesthetic nurse), a scrub nurse (who handles sterile equipment), a circulating nurse and a surgical technologist, while procedures that mandate cardiopulmonary bypass will also have a perfusionist."}}, {"canonical_name": "mantimento", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "mantimento", "book_id": "polyanthea_medicinal", "name": "mantimento", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["mantimento", "mantimentos"], "contexts": ["food", "food, sustenance"]}, {"entity_id": "mantimentos", "book_id": "coloquios_da_orta_1563", "name": "mantimentos", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["mantimentos"], "contexts": ["provisions on the ship"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "mantimento", "target_book": "coloquios_da_orta_1563", "target_name": "mantimentos", "similarity": 0.94}], "id": 1055, "stable_key": "clu_6c26bac126d1a63a", "ground_truth": {"modern_name": "Food", "confidence": "high", "type": "substance", "description": "Sustenance for humans and provisions for voyages.", "wikipedia_extract": "Food is any substance consumed by an organism for nutritional support. Food usually consists of plant, animal, or fungal origin and contains essential nutrients such as carbohydrates, fats, proteins, vitamins, or minerals. The substance is ingested by an organism and assimilated by the organism's cells to provide energy, maintain life, or support growth. Different species of animals have different feeding behaviours that satisfy the needs of their metabolisms and have evolved to fill specific ecological niches within specific geographical contexts. Omnivorous humans are highly adaptable and have adapted to obtaining food in many different ecosystems. Humans generally use cooking to prepare food for consumption."}}, {"canonical_name": "Sudorificos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "sudorificos", "book_id": "polyanthea_medicinal", "name": "Sudorificos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["sudorificos", "Sudorificos"], "contexts": ["medicines inducing sweat", "remedies that induce sweating"]}, {"entity_id": "sudor", "book_id": "historia_medicinal_monardes_1574", "name": "sudor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["sudor"], "contexts": ["sweat, bodily fluid", "bodily fluid"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Sudorificos", "target_book": "historia_medicinal_monardes_1574", "target_name": "sudor", "similarity": 0.844}], "id": 1056, "stable_key": "clu_fa8d961cbf792e48", "ground_truth": {"modern_name": "Sudorific", "confidence": "high", "type": "concept", "description": "A substance or remedy that induces sweating.", "wikipedia_extract": "Perspiration, also known as sweat, is the fluid secreted by sweat glands in the skin of mammals. Two types of sweat glands can be found in humans: eccrine glands and apocrine glands. The eccrine sweat glands are distributed over much of the body and are responsible for secreting the watery, brackish sweat most often triggered by excessive body temperature. Apocrine sweat glands are restricted to the armpits and a few other areas of the body and produce an odorless, oily, opaque secretion which then gains its characteristic odor from bacterial decomposition. In humans, sweating is primarily a means of thermoregulation, which is achieved by the water-rich secretion of the eccrine glands. Maximum sweat rates of an adult can be up to 2–4 litres (0.5–1 US gal) per hour or 10–14 litres (2.5–3.5 US gal) per day, but is less in children prior to puberty."}}, {"canonical_name": "azîas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "azîas", "book_id": "polyanthea_medicinal", "name": "azîas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["azîas", "Azìas"], "contexts": ["heartburn", "heartburn, treated by crayfish eye remedy"]}, {"entity_id": "azedias", "book_id": "historia_medicinal_monardes_1574", "name": "azedias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["azedias"], "contexts": ["acidity in stomach", "acidity"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "azîas", "target_book": "historia_medicinal_monardes_1574", "target_name": "azedias", "similarity": 0.921}], "id": 1057, "stable_key": "clu_2540d2e4a6cc46f3", "ground_truth": {"modern_name": "Heartburn", "confidence": "high", "type": "disease", "description": "A digestive ailment characterized by acidity or burning sensation.", "wikipedia_extract": "Heartburn is a burning sensation felt behind the breastbone. It is a symptom that is commonly linked to acid reflux and is often triggered by food. Lying down, bending, lifting, and performing certain exercises can exacerbate heartburn. Causes include acid reflux, gastroesophageal reflux disease (GERD), damage to the esophageal lining, bile acid, mechanical stimulation to the esophagus, and esophageal hypersensitivity. Heartburn affects 25% of the population at least once a month. Endoscopy and esophageal pH monitoring can be used to evaluate heartburn."}}, {"canonical_name": "malicia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "malicia", "book_id": "polyanthea_medicinal", "name": "malicia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["malicia"], "contexts": ["negative judgment of actions", "malice, referring to disease"]}, {"entity_id": "malicia", "book_id": "historia_medicinal_monardes_1574", "name": "malicia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["malicia"], "contexts": ["quality of being harmful or evil", "malice of poison"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "malicia", "target_book": "historia_medicinal_monardes_1574", "target_name": "malicia", "similarity": 1.0}], "id": 1058, "stable_key": "clu_03d47c7ffbfe2c35", "ground_truth": {"modern_name": "Malice", "confidence": "high", "type": "concept", "description": "The quality of being harmful, evil, or malevolent.", "note": "Can refer to intent, poison, or disease.", "wikipedia_extract": "Capoeira (Portuguese pronunciation: [kapuˈe(j)ɾɐ]) is an Afro-Brazilian martial art and game that includes elements of dance, acrobatics, music, and spirituality. It includes acrobatic and complex manoeuvres, often involving hands on the ground and inverted kicks. It emphasizes flowing movements rather than fixed stances; the ginga, a rocking step, is usually the focal point of the technique. Though often said to be a martial art disguised as a dance, capoeira also serves as a way to maintain spirituality and culture. Capoeira has been practiced among Black Brazilians for centuries. The date of its creation is unknown, but it was first mentioned in a judicial document under the name Capoeiragem in 1789, as \"the gravest of crimes\"."}}, {"canonical_name": "aeris", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "aeris", "book_id": "polyanthea_medicinal", "name": "aeris", "category": "CONCEPT", "subcategory": "QUALITY", "count": 6, "variants": ["aeris", "aeristemperatis"], "contexts": ["air quality", "air"]}, {"entity_id": "aereas", "book_id": "historia_medicinal_monardes_1574", "name": "aereas", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["aereas"], "contexts": ["part of the root's complexion"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "aeris", "target_book": "historia_medicinal_monardes_1574", "target_name": "aereas", "similarity": 0.848}], "id": 1059, "stable_key": "clu_52b71a41ccdbd499", "ground_truth": {"modern_name": "Air", "confidence": "high", "type": "concept", "description": "The invisible gaseous substance surrounding the Earth; atmospheric quality.", "wikipedia_extract": "The atmosphere of Earth consists of a layer of mixed gas (commonly referred to as air) that is retained by gravity, surrounding the Earth's surface. It contains variable quantities of suspended aerosols and particulates that create weather features such as clouds and hazes. The atmosphere serves as a protective buffer between the Earth's surface and outer space. It shields the surface from most meteoroids and ultraviolet solar radiation, reduces diurnal temperature variation – the temperature extremes between day and night, and keeps it warm through heat retention via the greenhouse effect. The atmosphere redistributes heat and moisture among different regions via air currents, and provides the chemical and climate conditions that allow life to exist and evolve on Earth. By mole fraction (i.e., by quantity of molecules), dry air contains 78.08% nitrogen, 20.95% oxygen, 0.93% argon, 0.04% carbon dioxide, and small amounts of other trace gases (see Composition below for more detail)."}}, {"canonical_name": "junco odorato", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "junco_odorato", "book_id": "coloquios_da_orta_1563", "name": "junco odorato", "category": "PLANT", "subcategory": "PLANT", "count": 5, "variants": ["junco odorato", "junco aromático"], "contexts": ["fragrant rush", "description of a fruit's appearance"]}, {"entity_id": "giunco_odorato", "book_id": "ricettario_fiorentino_1597", "name": "Giunco odorato", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["giunco odorato", "Giunco odorato"], "contexts": ["fragrant rush", "plant product used in preparations"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "junco odorato", "target_book": "ricettario_fiorentino_1597", "target_name": "Giunco odorato", "similarity": 0.892}], "id": 1060, "stable_key": "clu_c5fa780c1d96df6e", "ground_truth": {"modern_name": "Fragrant rush", "confidence": "high", "type": "plant", "description": "A fragrant rush plant, often used in herbal preparations.", "wikipedia_extract": "This article lists plants referenced in the Bible, ordered alphabetically by English common/colloquial name. For plants whose identities are unconfirmed or debated the most probable species is listed first. Plants named in the Old Testament (Hebrew Bible or Tenakh) are given with their Hebrew name, while those mentioned in the New Testament are given with their Greek names. Hepper, F. Nigel (2000). Planting a Bible Garden (illustrated ed.)."}}, {"canonical_name": "açucare rosado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "açucare_rosado", "book_id": "coloquios_da_orta_1563", "name": "açucare rosado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 5, "variants": ["açucare rosado", "açucar rosado", "açucare rosado de Alexandria"], "contexts": ["rose sugar preparation", "rose-infused sugar water"]}, {"entity_id": "açucar_rosado_de_alexan", "book_id": "polyanthea_medicinal", "name": "açucar Rosado de Alexan", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["açucar Rosado de Alexan"], "contexts": ["added to decoction for fever"]}, {"entity_id": "açucar_ro­ado", "book_id": "polyanthea_medicinal", "name": "açucar ro­ado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["açucar ro­ado"], "contexts": ["sweet preparation that digests slowly"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "açucare rosado", "target_book": "polyanthea_medicinal", "target_name": "açucar Rosado de Alexan", "similarity": 0.869}, {"source_book": "coloquios_da_orta_1563", "source_name": "açucare rosado", "target_book": "polyanthea_medicinal", "target_name": "açucar ro­ado", "similarity": 0.861}], "id": 1061, "stable_key": "clu_d5c569524c73aee1", "ground_truth": {"modern_name": "Rose sugar", "confidence": "high", "type": "substance", "description": "Sugar infused with rose petals or rose water.", "wikipedia_extract": "Redox ( RED-oks,  REE-doks, reduction–oxidation or oxidation–reduction) is a type of chemical reaction in which the oxidation states of the reactants change. Oxidation is the loss of electrons or an increase in the oxidation state, while reduction is the gain of electrons or a decrease in the oxidation state. The oxidation and reduction processes occur simultaneously in the chemical reaction. There are two classes of redox reactions: Electron-transfer – Only one (usually) electron flows from the atom, ion, or molecule being oxidized to the atom, ion, or molecule that is reduced. This type of redox reaction is often discussed in terms of redox couples and electrode potentials. Atom transfer – An atom transfers from one substrate to another."}}, {"canonical_name": "saccharo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "saccharo", "book_id": "polyanthea_medicinal", "name": "saccharo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 5, "variants": ["saccharo", "SaccharumSatur", "saccharatis"], "contexts": ["sweetener", "sugar"]}, {"entity_id": "sacchamm", "book_id": "coloquios_da_orta_1563", "name": "sacchamm", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["sacchamm", "saccharum"], "contexts": ["ancient name for sugar", "latin name for sugar"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "saccharo", "target_book": "coloquios_da_orta_1563", "target_name": "sacchamm", "similarity": 0.854}], "id": 1062, "stable_key": "clu_1f16b1bf9cb651a9", "ground_truth": {"modern_name": "Sugar", "confidence": "high", "type": "substance", "description": "A sweet crystalline substance obtained from various plants, especially sugarcane.", "wikipedia_extract": "Sugar () is a class of sweet-tasting, soluble carbohydrates, many of which are used in food. Simple sugars, also called monosaccharides, include glucose, fructose, and galactose. Compound sugars, also called disaccharides or double sugars, are molecules made of two bonded monosaccharides; common examples are sucrose (glucose + fructose), lactose (glucose + galactose), and maltose (two molecules of glucose). White sugar is almost pure sucrose. During digestion, compound sugars are hydrolysed into simple sugars. Longer chains of saccharides are not regarded as sugars, and are called oligosaccharides or polysaccharides."}}, {"canonical_name": "fel de gallo", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "fel_de_gallo", "book_id": "polyanthea_medicinal", "name": "fel de gallo", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 5, "variants": ["fel de gallo", "fél de gallo"], "contexts": ["gall of a rooster used in eye remedy", "ingredient in a cataract remedy"]}, {"entity_id": "fel", "book_id": "coloquios_da_orta_1563", "name": "fel", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 2, "variants": ["fel"], "contexts": ["animal bile", "bile, a bodily fluid"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "fel de gallo", "target_book": "coloquios_da_orta_1563", "target_name": "fel", "similarity": 0.824}], "id": 1063, "stable_key": "clu_9bd2ad1bbb89d2ec", "ground_truth": {"modern_name": "Rooster's bile", "confidence": "high", "type": "substance", "description": "The bile produced by a rooster, used in historical remedies.", "note": "The term 'fel' can refer to animal bile in general, but 'fel de gallo' specifically points to rooster's bile.", "wikipedia_extract": "A list of Equinox episodes shows the full set of editions of the defunct (July 1986 - December 2006) Channel 4 science documentary series Equinox. 31 July Turbo: Once Around the Block, about British motor racing; the Ferrari F1/86 and the Imola Circuit in Emilia-Romagna in northern Italy, and Tifosi spectators; the 1984 British Grand Prix at Brands Hatch; the Motronic engine control units of Robert Bosch GmbH; Keith Duckworth, known for the Cosworth DFV, and Michael Kranefuss, head of Ford Motor Sport; Walter Hayes of Ford of Europe; Renault began turbocharged motor racing vehicles at the 1977 British Grand Prix on 16 July 1977, with the Renault RS01; Cosworth in Northampton; Beatrice Foods of the US, and Ford form an agreement in 1985, with Australian Alan Jones, with designer John Baldwin; the 1981 Italian Grand Prix and crash of John Watson; the assembled Cosworth GBA V6 engine is tested at Northampton. Produced by Patrick Uden, made by Uden Associates."}}, {"canonical_name": "Elvas", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "elvas", "book_id": "polyanthea_medicinal", "name": "Elvas", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Elvas"], "contexts": ["city in Portugal", "city where the bishop is from"]}, {"entity_id": "elvas", "book_id": "coloquios_da_orta_1563", "name": "Elvas", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Elvas"], "contexts": ["Location of commissioners' meeting", "city where commissioners met"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Elvas", "target_book": "coloquios_da_orta_1563", "target_name": "Elvas", "similarity": 1.0}], "id": 1064, "stable_key": "clu_096283220888bb7a", "ground_truth": {"modern_name": "Elvas", "confidence": "high", "type": "place", "description": "A city in the Alentejo region of Portugal.", "wikipedia_extract": "Elvas (Portuguese pronunciation: [ˈɛlvɐʃ] ), officially the City of Elvas (Portuguese: Cidade de Elvas), is a Portuguese municipality, former episcopal city and frontier fortress of easternmost central Portugal, located in the district of Portalegre in Alentejo. It is situated about 200 kilometres (120 mi) east of Lisbon, and about 8 kilometres (5.0 mi) west of the Spanish fortress of Badajoz, by the Madrid-Badajoz-Lisbon railway. The municipality population as of 2011 was 23,078, in an area of 631.29 square kilometres (243.74 sq mi). The city itself had a population of 16,640 as of 2011. Elvas is among the finest examples of intensive usage of the trace italienne (star fort) in military architecture, and has been a World Heritage Site since 30 June 2012. The inscribed site name is Garrison Border Town of Elvas and its Fortifications."}}, {"canonical_name": "Hera", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "hera", "book_id": "polyanthea_medicinal", "name": "Hera", "category": "PLANT", "subcategory": "PLANT", "count": 5, "variants": ["Hera", "hera"], "contexts": ["plant used in water for drinking", "leaves used for heating feet"]}, {"entity_id": "hera", "book_id": "coloquios_da_orta_1563", "name": "Hera", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Hera"], "contexts": ["plant with creeping growth", "plant mentioned as an example"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Hera", "target_book": "coloquios_da_orta_1563", "target_name": "Hera", "similarity": 1.0}], "id": 1065, "stable_key": "clu_efba16c6ad2a16ae", "ground_truth": {"modern_name": "Hera", "confidence": "low", "type": "plant", "description": "A plant used medicinally, possibly for foot baths and drinking water.", "note": "The context suggests a common herb, but 'Hera' is not a recognized common name for a specific plant in this context. It might be a misspelling or a regional name.", "wikipedia_extract": "In ancient Greek religion, Hera (; Ancient Greek: Ἥρα, romanized: Hḗrā; Ἥρη, Hḗrē in Ionic and Homeric Greek) is the goddess of marriage, women, and family, and the protector of women during childbirth. In Greek mythology, she is queen of the twelve Olympians and Mount Olympus, sister and wife of Zeus, and daughter of the Titans Cronus and Rhea. One of her defining characteristics in myth is her jealous and vengeful nature in dealing with any who offended her, especially Zeus's numerous adulterous lovers and illegitimate offspring. Her iconography usually presents her as a dignified, matronly figure, upright or enthroned, crowned with a polos or diadem, sometimes veiled as a married woman. She is the patron goddess of lawful marriage. She presides over weddings, blesses and legalises marital unions, and protects women from harm during childbirth."}}, {"canonical_name": "cavallinha", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "cavallinha", "book_id": "polyanthea_medicinal", "name": "cavallinha", "category": "PLANT", "subcategory": "PLANT", "count": 6, "variants": ["cavallinha", "Cavallinha"], "contexts": ["herb for abscesses", "herb for abscesses and fistulas"]}, {"entity_id": "cabaluio", "book_id": "coloquios_da_orta_1563", "name": "cabaluio", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["cabaluio"], "contexts": ["Type of aloe, likely of poor quality"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "cavallinha", "target_book": "coloquios_da_orta_1563", "target_name": "cabaluio", "similarity": 0.853}], "id": 1066, "stable_key": "clu_12b8ecdc997c7e2d", "ground_truth": {"modern_name": "Horsetail", "confidence": "high", "type": "plant", "linnaean": "Equisetum arvense", "family": "Equisetaceae", "description": "Herb used for treating abscesses, fistulas, and a type of aloe.", "note": "'Cavallinha' is the Portuguese common name for horsetail. 'Cabaluio' is likely a variation or misspelling.", "wikipedia_extract": "Equisetum arvense, commonly known as field horsetail or common horsetail, is a species of vascular plant in the horsetail family Equisetaceae. Like all horsetails, it is a type of fern. It is native throughout the arctic and temperate regions of the Northern Hemisphere. It has two distinct growth forms, a fertile spore-bearing stem and a sterile green stem. It is sometimes confused with mare's tail, Hippuris vulgaris. Equisetum arvense is a perennial herbaceous plant that spreads by means of an underground rhizome."}}, {"canonical_name": "collirio", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "collirio", "book_id": "polyanthea_medicinal", "name": "collirio", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 5, "variants": ["collirio", "Collirios", "colirio", "collyrio"], "contexts": ["eye lotion", "eye medicine"]}, {"entity_id": "coliros", "book_id": "coloquios_da_orta_1563", "name": "coliros", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["coliros"], "contexts": ["Medicinal preparations, likely eye drops"]}, {"entity_id": "colírio", "book_id": "coloquios_da_orta_1563", "name": "colírio", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["colírio"], "contexts": ["an eye medicine"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "collirio", "target_book": "coloquios_da_orta_1563", "target_name": "coliros", "similarity": 0.857}, {"source_book": "polyanthea_medicinal", "source_name": "collirio", "target_book": "coloquios_da_orta_1563", "target_name": "colírio", "similarity": 0.876}], "id": 1067, "stable_key": "clu_969fcfc41c8b9f5f", "ground_truth": {"modern_name": "Collyrium", "confidence": "high", "type": "substance", "description": "A medicinal preparation, typically an eye lotion or drops.", "note": "Historical term for eye medication.", "wikipedia_extract": "In eye care, collyrium is an antique term for a lotion or liquid wash used as a cleanser for the eyes, particularly in diseases of the eye. The word collyrium comes from the Greek κολλύριον, eye-salve. The same name was also given to unguents used for the same purpose, such as unguent of tutty (Sanskrit tuttha meaning variously zinc oxide or blue vitriol). Lastly, the name was given, though improperly, to some liquid medicines used against venereal diseases. Pre-modern medicine distinguished two kinds of collyriums: the one liquid, the other dry. Liquid collyriums were composed of ophthalmic powders, or waters, such as rose-water, plantain-water, that of fennel, eyebright, etc., in which was dissolved tutty, white vitriol, or some other proper powder."}}, {"canonical_name": "boy", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "boy", "book_id": "polyanthea_medicinal", "name": "boy", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 3, "variants": ["boy"], "contexts": ["source of gall bladder stone", "animal product used for water"]}, {"entity_id": "boy", "book_id": "coloquios_da_orta_1563", "name": "boy", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["boy"], "contexts": ["blood of a boy mixed in medicine"]}, {"entity_id": "aboſtade_boy", "book_id": "polyanthea_medicinal", "name": "Aboſtade boy", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 2, "variants": ["Aboſtade boy", "Aboſtado boy"], "contexts": ["mixed with vinegar and incense", "bull's blood used in a remedy"]}, {"entity_id": "fel_de_boy", "book_id": "polyanthea_medicinal", "name": "fel de boy", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["fel de boy"], "contexts": ["ingredient for opening bowels"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "boy", "target_book": "coloquios_da_orta_1563", "target_name": "boy", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "boy", "target_book": "polyanthea_medicinal", "target_name": "Aboſtade boy", "similarity": 0.868}, {"source_book": "coloquios_da_orta_1563", "source_name": "boy", "target_book": "polyanthea_medicinal", "target_name": "fel de boy", "similarity": 0.892}], "id": 1068, "stable_key": "clu_06a28e4f85333d77", "ground_truth": {"modern_name": "Ox", "confidence": "high", "type": "animal", "linnaean": "Bos taurus", "family": "Bovidae", "description": "Animal whose gall bladder stone and blood were used in medicine.", "note": "'Boy' in this context refers to an ox or bull, not a human child, especially when referring to 'fel de boy' (ox gall) or animal products.", "wikipedia_extract": "Cattle (Bos taurus) are large, domesticated, bovid ungulates widely kept as livestock. They are prominent modern members of the subfamily Bovinae and the most widespread species of the genus Bos. Mature female cattle are called cows and mature males are called bulls. Taurine cattle are widely distributed across Europe and temperate areas of Asia, the Americas, and Australia. Zebus are found mainly in India and tropical areas of Asia, America, and Australia. Sanga cattle are found primarily in sub-Saharan Africa."}}, {"canonical_name": "lenha", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "lenha", "book_id": "polyanthea_medicinal", "name": "lenha", "category": "PLANT", "subcategory": "PLANT", "count": 6, "variants": ["lenha", "lenha verde"], "contexts": ["wood for making charcoal", "wood in a closed room"]}, {"entity_id": "lanha", "book_id": "coloquios_da_orta_1563", "name": "lanha", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["lanha"], "contexts": ["name for coquo in Goa"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "lenha", "target_book": "coloquios_da_orta_1563", "target_name": "lanha", "similarity": 0.842}], "id": 1069, "stable_key": "clu_d32259dae37e15c3", "ground_truth": {"modern_name": "Firewood", "confidence": "high", "type": "plant", "description": "Wood used for fuel, charcoal production, or heating.", "note": "'Lenha' is Portuguese for firewood. 'Lanha' might be a misspelling or a specific regional term for wood or a type of plant.", "wikipedia_extract": "Firewood is any wooden material that can be used for fuel. The term usually refers to wood fuel that is not industrially processed, such as wood pellets, and instead takes the form of a recognizable log or branch. Firewood can be heat-treated and seasoned (dry) or unseasoned (fresh/wet). Two classes of firewood exist, which are either hardwood or softwood, depending on the species of tree that was cut. Firewood is a renewable resource, although demand for this fuel can quickly outpace its ability to regenerate on a local or regional level. Good forestry practices and efficiency advances in devices that burn firewood can improve local wood supplies."}}, {"canonical_name": "amargofo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "amargofo", "book_id": "polyanthea_medicinal", "name": "amargofo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["amargofo", "amargofas", "amargofojo"], "contexts": ["bitter taste", "bitter substance"]}, {"entity_id": "amaretto", "book_id": "ricettario_fiorentino_1597", "name": "amaretto", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["amaretto"], "contexts": ["bitter quality"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "amargofo", "target_book": "ricettario_fiorentino_1597", "target_name": "amaretto", "similarity": 0.841}], "id": 1070, "stable_key": "clu_260498a46d6e4176", "ground_truth": {"modern_name": "Bitterness", "confidence": "high", "type": "concept", "description": "The quality of having a sharp, pungent taste; a bitter substance.", "note": "Refers to the taste quality or substances possessing it.", "wikipedia_extract": "Bitterness, also known as bitter, is one of the most sensitive of tastes, and many experience it as unpleasant, sharp, or off-putting, but it is sometimes desirable and intentionally added via various bittering agents. Common bitter foods and drinks include coffee, unsweetened cocoa, South American mate, coca tea, Momordica charantia, unripe olives, citrus peel, some varieties of cheese, many plants in the Brassicaceae family, Taraxacum greens, Marrubium vulgare, wild chicory, and escarole. The ethanol in alcoholic beverages tastes bitter, as do the additional bittering ingredients found in some alcoholic beverages, including hops in beer and gentian in bitters. Quinine is also known for its bitter taste and is found in tonic water. Bitterness is of interest to those studying evolution, as well as to various health researchers as a large number of naturally occurring bitter compounds are known to be toxic. The ability to detect bitter-tasting, toxic compounds at low thresholds is thought to serve an important protective function."}}, {"canonical_name": "lens", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "lens", "book_id": "connexion_physical_sciences_somerville_1858", "name": "lens", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 6, "variants": ["lens"], "contexts": ["optical device for focusing light", "device to focus heat"]}, {"entity_id": "lense", "book_id": "first_principles_spencer_1862", "name": "lense", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["lense"], "contexts": ["instrument for magnifying small details"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "lens", "target_book": "first_principles_spencer_1862", "target_name": "lense", "similarity": 0.994}], "id": 1071, "stable_key": "clu_39b797d4612296e6", "ground_truth": {"modern_name": "lens", "confidence": "high", "type": "object", "wikidata_id": "Q148983", "wikidata_description": "genus of plants", "wikipedia_extract": "A lens is a transmissive optical device that focuses or disperses a light beam by means of refraction. A simple lens consists of a single piece of transparent material, while a compound lens consists of several simple lenses (elements), usually arranged along a common axis. Lenses are made from materials such as glass or plastic and are ground, polished, or molded to the required shape. A lens can focus light to form an image, unlike a prism, which refracts light without focusing. Devices that similarly focus or disperse waves and radiation other than visible light are also called \"lenses\", such as microwave lenses, electron lenses, acoustic lenses, or explosive lenses. Lenses are used in various imaging devices such as telescopes, binoculars, and cameras.", "wikipedia_url": "https://en.wikipedia.org/wiki/Lens_%28plant%29"}}, {"canonical_name": "Basil", "category": "PLANT", "subcategory": "HERB", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "basil", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Basil", "category": "PLANT", "subcategory": "HERB", "count": 5, "variants": ["Basil"], "contexts": ["religious writer", "church father, author of Hexameron"]}, {"entity_id": "basili", "book_id": "english_physician_1652", "name": "Basili", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Basili"], "contexts": ["name of the herb"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Basil", "target_book": "english_physician_1652", "target_name": "Basili", "similarity": 0.843}], "id": 1072, "stable_key": "clu_30e10ca37f29df0b", "ground_truth": {"modern_name": "Basil", "confidence": "high", "type": "plant", "linnaean": "Ocimum basilicum", "family": "Lamiaceae", "wikidata_id": "Q38859", "wikidata_description": "species of plant, herb", "wikipedia_url": "https://en.wikipedia.org/wiki/Basil"}}, {"canonical_name": "Brake", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "brake", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Brake", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["Brake"], "contexts": ["plant name", "type of fern"]}, {"entity_id": "brakes", "book_id": "english_physician_1652", "name": "Brakes", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Brakes"], "contexts": ["local name for Femal Fern"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Brake", "target_book": "english_physician_1652", "target_name": "Brakes", "similarity": 0.862}], "id": 1073, "stable_key": "clu_bcc80b2eca476ce9", "ground_truth": {"modern_name": "brake fern", "confidence": "high", "type": "plant", "linnaean": "Pteridium aquilinum", "family": "Dennstaedtiaceae", "wikidata_id": "Q24693531", "wikidata_description": "variety of plants", "wikipedia_extract": "Pteris (brake) is a genus of about 300 species of ferns in the subfamily Pteridoideae of the family Pteridaceae. They are native to tropical and subtropical regions, southward to New Zealand, Australia, and South Africa, north to Japan and North America. 78 species (35 endemic) are found in China. Some species of Pteris have considerable economic and ecological value, such as Pteris multifida, Pteris ensiformis, Pteris vittata can be used for ornamental purposes; as a hyperaccumulator, Pteris multifida and Pteris vittata can be used to control soil pollution. Many of them have linear frond segments, and some have sub-palmate division. Like other members of the Pteridaceae, the frond margin is reflexed over the marginal sori. The outermost layer is the single layered epidermis without stomata."}}, {"canonical_name": "Ash-tree", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "ash-tree", "book_id": "english_physician_1652", "name": "Ash-tree", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["Ash-tree", "Ash-Tree", "Ash-tree Tops"], "contexts": ["known for its virtues", "tree resembling Liquorice"]}, {"entity_id": "ash", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ash", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["Ash"], "contexts": ["type of tree", "tree whose shade snakes will not endure"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Ash-tree", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Ash", "similarity": 0.926}], "id": 1074, "stable_key": "clu_5cf6272d9c59e589", "ground_truth": {"modern_name": "Ash", "confidence": "high", "type": "plant", "linnaean": "Fraxinus excelsior Linnaeus", "family": "Oleaceae", "wikidata_id": "Q128887", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Fraxinus", "wikipedia_extract": "Fraxinus (), commonly called ash, is a genus of plants in the olive and lilac family, Oleaceae, and comprises 45–65 species of usually medium-to-large trees, most of which are deciduous (dropping their leaves in autumn), although some subtropical species are evergreen. The genus is widespread throughout much of Europe, Asia, and North America. The leaves are usually opposite, and mostly pinnately compound (divided into leaflets in a feather-like arrangement). The seeds, known as \"keys\", are botanically fruits of the type called samara. Some species are dioecious, having male and female flowers on separate plants. Ash wood is strong and elastic, and used for the handles of tools."}}, {"canonical_name": "Bay-Tree", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "bay-tree", "book_id": "english_physician_1652", "name": "Bay-Tree", "category": "PLANT", "subcategory": "PLANT", "count": 5, "variants": ["Bay-tree", "Bay-Tree"], "contexts": ["herb dedicated to Apollo", "well-known tree with many virtues"]}, {"entity_id": "bay-tree", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Bay-tree", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Bay-tree"], "contexts": ["tree blasted by lightning"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Bay-Tree", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Bay-tree", "similarity": 0.932}], "id": 1075, "stable_key": "clu_430f68d549dc0059", "ground_truth": {"modern_name": "Bay Laurel", "confidence": "high", "type": "plant", "linnaean": "Laurus nobilis Linnaeus", "family": "Lauraceae", "wikidata_id": "Q26006", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Laurus_nobilis", "wikipedia_extract": "Laurus nobilis  is an aromatic evergreen tree or large shrub with green, glabrous (smooth) leaves. It is in the flowering plant family Lauraceae. According to  Muer, Jahn, & Sauerbier, the stem can be 1 metre in diameter and the tree can be as high as 20 metres. It is native to the Mediterranean region and is used as bay leaf for seasoning in cooking. Its common names include bay tree (esp. United Kingdom), bay laurel, sweet bay, true laurel, Grecian laurel, or simply laurel."}}, {"canonical_name": "Misseltoe", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "misseltoe", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Misseltoe", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Misseltoe"], "contexts": ["plant found on some trees", "parasitic plant growing on trees"]}, {"entity_id": "misseltoe", "book_id": "origin_of_species_darwin_1859", "name": "Misseltoe", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Misseltoe", "misseltoe"], "contexts": ["parasitic plant with specific needs", "complex relations of"]}, {"entity_id": "missletoe", "book_id": "origin_of_species_darwin_1859", "name": "missletoe", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["missletoe"], "contexts": ["example of adaptation", "parasitic plant dependent on trees"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Misseltoe", "target_book": "origin_of_species_darwin_1859", "target_name": "Misseltoe", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Misseltoe", "target_book": "origin_of_species_darwin_1859", "target_name": "missletoe", "similarity": 0.932}], "id": 1076, "stable_key": "clu_1e2930e87b04dc1b", "ground_truth": {"modern_name": "Mistletoe", "confidence": "high", "type": "plant", "linnaean": "Viscum album Linnaeus", "family": "Santalaceae", "wikidata_id": "Q144940", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Viscum%20album", "wikipedia_extract": "Mistletoe is the common name for obligate hemiparasitic plants in the order Santalales. They are attached to their host tree or shrub by a structure called the haustorium, through which they extract water and nutrients from the host plant. There are hundreds of species which mostly live in tropical regions. The name mistletoe originally referred to the species Viscum album (European mistletoe, of the family Santalaceae in the order Santalales); it is the only species native to the British Isles and much of Europe. A related species with red fruits, rather than white, Viscum cruciatum, occurs in Southwest Spain and Southern Portugal, as well as in Morocco in North Africa and in southern Africa. There is also a wide variety of species in Australia."}}, {"canonical_name": "Hippeastrum", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "hippeastrum", "book_id": "origin_of_species_darwin_1859", "name": "Hippeastrum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Hippeastrum"], "contexts": ["plant genus with unusual fertilization properties", "genus seeding more freely with foreign pollen"]}, {"entity_id": "hippophae", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hippophae", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Hippophae"], "contexts": ["plant mentioned by Hippocrates"]}, {"entity_id": "hippolapathum", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hippolapathum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Hippolapathum"], "contexts": ["Great Dock plant name"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Hippeastrum", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Hippophae", "similarity": 0.863}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Hippeastrum", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Hippolapathum", "similarity": 0.863}], "id": 1077, "stable_key": "clu_7a3c0dfa774618c0", "ground_truth": {"modern_name": "Hippeastrum", "confidence": "medium", "type": "plant", "linnaean": "Hippeastrum Herbert", "family": "Amaryllidaceae", "note": "The mention of 'Hippophae' and 'Hippolapathum' suggests that 'Hippeastrum' might not be the sole intended referent. However, 'Hippeastrum' is explicitly mentioned and fits the context of a plant genus with fertilization properties. 'Hippophae' is Sea Buckthorn, and 'Hippolapathum' is a type of dock. The primary modern referent for the genus with unusual fertilization properties is Hippeastrum.", "wikidata_id": "Q757257", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Hippeastrum", "wikipedia_extract": "Hippeastrum () is a genus of 116 species, and over 600 hybrids and cultivars, of perennial, herbaceous and bulbous plants, native to tropical and subtropical regions of the Americas, from Mexico south to Argentina and on some islands in the Caribbean. The majority have large, fleshy bulbs and tall, broad, strap-like leaves that are (generally) evergreen, and large red or purple flowers. Numerous colors and cultivars have been created over the past hundred years. Hippeastrum is a genus in the family Amaryllidaceae (subfamily Amaryllidoideae, tribe Hippeastreae, and subtribe Hippeastrinae). For many years, there has been confusion among botanists, as well as collectors and the general public, over the generic names Amaryllis and Hippeastrum; the former is a South African genus of plants, while the latter is a new world genus. However, the common name \"amaryllis\" has been used for  Hippeastrum for years, especially for the ornamental cultivars (sold as indoor flowering bulbs around November and December, for Christmas, in the Northern Hemisphere)."}}, {"canonical_name": "colombi", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "colombi", "book_id": "ricettario_fiorentino_1597", "name": "colombi", "category": "ANIMAL", "subcategory": "BIRD", "count": 4, "variants": ["colombi", "coiombi", "colombina", "colombo"], "contexts": ["pigeons, aerial animals", "birds for which Orobo seed is sown"]}, {"entity_id": "columba", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Columba", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Columba"], "contexts": ["Latin for pigeon or dove"]}, {"entity_id": "columbæ", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Columbæ", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Columbæ"], "contexts": ["Latin for dove or pigeon"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "colombi", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Columba", "similarity": 0.881}, {"source_book": "ricettario_fiorentino_1597", "source_name": "colombi", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Columbæ", "similarity": 0.902}], "id": 1078, "stable_key": "clu_7d661d855ec1fb64", "ground_truth": {"modern_name": "Pigeon/Dove", "confidence": "high", "type": "animal", "wikipedia_extract": "Columbidae is a bird family consisting of doves and pigeons. It is the only family in the order Columbiformes. These are stout-bodied birds with small heads, relatively short necks and slender bills that in some species feature fleshy ceres. They feed largely on plant matter, feeding on seeds (granivory), fruit (frugivory), and foliage (folivory). In colloquial English, the smaller species tend to be called \"doves\", and the larger ones \"pigeons\", although the distinction is not consistent, and there is no scientific separation between them. Historically, the common names for these birds involve a great deal of variation.", "wikipedia_url": "https://en.wikipedia.org/wiki/Columbidae"}}, {"canonical_name": "Tract of Magnetical Bodies", "category": "ORGANIZATION", "subcategory": "JOURNAL", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "tract_of_magnetical_bodies", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Tract of Magnetical Bodies", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 2, "variants": ["Tract of Magnetical Bodies"], "contexts": ["work by Ridley on magnetism"]}, {"entity_id": "treatise_on_magnetism", "book_id": "kosmos_humboldt_1845", "name": "Treatise on Magnetism", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 2, "variants": ["Treatise on Magnetism"], "contexts": ["book on magnetism", "Brewster's book on magnetism"]}, {"entity_id": "traite_de_electr__et_de_magnet_", "book_id": "kosmos_humboldt_1845", "name": "Traite de Electr. et de Magnet.", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Traite de Electr. et de Magnet."], "contexts": ["treatise on electricity and magnetism"]}, {"entity_id": "traite_de_l'electricite_et_du_magnetisme", "book_id": "kosmos_humboldt_1845", "name": "Traite de l'Electricite et du Magnetisme", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Traite de l'Electricite et du Magnetisme"], "contexts": ["treatise on electricity and magnetism"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Tract of Magnetical Bodies", "target_book": "kosmos_humboldt_1845", "target_name": "Treatise on Magnetism", "similarity": 0.859}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Tract of Magnetical Bodies", "target_book": "kosmos_humboldt_1845", "target_name": "Traite de Electr. et de Magnet.", "similarity": 0.851}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Tract of Magnetical Bodies", "target_book": "kosmos_humboldt_1845", "target_name": "Traite de l'Electricite et du Magnetisme", "similarity": 0.852}], "id": 1079, "stable_key": "clu_f206f484c52a6e2d", "ground_truth": {"modern_name": "Tractatus de Corporibus Magneticis", "confidence": "high", "type": "text", "note": "The Italian 'Tract of Magnetical Bodies' and the French 'Traite de Electr. et de Magnet.' likely refer to translations or related works on the same subject. 'Treatise on Magnetism' is a general description. The most specific early modern text that fits is 'Tractatus de Corporibus Magneticis' by Nicholaus Cabæus."}}, {"canonical_name": "Pythagoreans", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "pythagoreans", "book_id": "kosmos_humboldt_1845", "name": "Pythagoreans", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "count": 4, "variants": ["Pythagoreans"], "contexts": ["ancient Greek philosophical school", "studied heavenly bodies and comets"]}, {"entity_id": "pythagoreans", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Pythagoreans", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "count": 1, "variants": ["Pythagoreans"], "contexts": ["ancient philosophical school"]}, {"entity_id": "pythagorean", "book_id": "kosmos_humboldt_1845", "name": "Pythagorean", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "count": 1, "variants": ["Pythagorean"], "contexts": ["relating to Pythagorean philosophy"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Pythagoreans", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Pythagoreans", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Pythagoreans", "target_book": "kosmos_humboldt_1845", "target_name": "Pythagorean", "similarity": 0.989}], "id": 1080, "stable_key": "clu_fe9d39b9284741cf", "ground_truth": {"modern_name": "Pythagoreanism", "confidence": "high", "type": "concept", "wikipedia_extract": "Pythagoreanism originated in the 6th century BC, based on and around the teachings and beliefs held by Pythagoras and his followers, the Pythagoreans. Pythagoras established the first Pythagorean community in the ancient Greek colony of Croton, in modern Calabria (Italy) circa 530 BC. Early Pythagorean communities spread throughout Magna Graecia. Already during Pythagoras's life it is likely that the distinction between the akousmatikoi (\"those who listen\"), who is conventionally regarded as more concerned with religious, and ritual elements, and associated with the oral tradition, and the mathematikoi (\"those who learn\") existed. The ancient biographers of Pythagoras, Iamblichus (c. 245 – c. AD 325) and his master Porphyry (c. 234 – c."}}, {"canonical_name": "putrefaçam", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "putrefaçam", "book_id": "coloquios_da_orta_1563", "name": "putrefaçam", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["putrefaçam"], "contexts": ["process of decay", "the process of decay"]}, {"entity_id": "putrescence", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "putrescence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["putrescence"], "contexts": ["state of decay"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "putrefaçam", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "putrescence", "similarity": 0.841}], "id": 1081, "stable_key": "clu_3a07e321a5563653", "ground_truth": {"modern_name": "Putrefaction", "confidence": "high", "type": "concept", "wikidata_id": "Q671701", "wikidata_description": "breaking down of a body of a human or animal post-mortem", "wikipedia_extract": "Joseph Lister, 1st Baron Lister,  (5 April 1827 – 10 February 1912) was an English surgeon, medical scientist, experimental pathologist and pioneer of antiseptic surgery and preventive healthcare. Lister revolutionised the craft of surgery by the use of close anatomical observation, in the same manner that John Hunter revolutionised the science of surgery. From a technical viewpoint, Lister was not an exceptional surgeon, but his research into bacteriology and infection in wounds revolutionised surgery throughout the world. Lister's contributions were four-fold. Firstly, as a surgeon at the Glasgow Royal Infirmary, he introduced carbolic acid (modern-day phenol) as a steriliser for surgical instruments, patients' skins, sutures, surgeons' hands, and wards, promoting the principle of antiseptics. Secondly, he researched the role of inflammation and tissue perfusion in the healing of wounds.", "wikipedia_url": "https://en.wikipedia.org/wiki/Joseph_Lister"}}, {"canonical_name": "Taprobana", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "taprobana", "book_id": "coloquios_da_orta_1563", "name": "Taprobana", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Taprobana"], "contexts": ["ancient name for island", "island identified with Sumatra or Ceylon"]}, {"entity_id": "taprobana", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Taprobana", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Taprobana"], "contexts": ["supposed location of Ophir", "supposed location in the Indies"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Taprobana", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Taprobana", "similarity": 1.0}], "id": 1082, "stable_key": "clu_6550a75f6677960d", "ground_truth": {"modern_name": "Sri Lanka", "confidence": "high", "type": "place", "country": "Sri Lanka", "wikidata_id": "Q2002951", "wikidata_description": "ancient Greco-Roman name of Sri Lanka, also wrongly identified as Sumatra", "wikipedia_url": "https://en.wikipedia.org/wiki/Taprobana", "wikipedia_extract": "Sri Lanka, officially the Democratic Socialist Republic of Sri Lanka, formerly known as Ceylon, is an island country in South Asia. It is located in the Indian Ocean, southwest of the Bay of Bengal, and is separated from India by the Gulf of Mannar and the Palk Strait. Sri Lanka shares a maritime border with the Maldives to the southwest and India to the northwest, and lies across the Bay of Bengal from Bangladesh and Myanmar to the northeast and the Andaman and Nicobar Islands of India to the east. Its capital is Sri Jayawardenepura Kotte, while Colombo is its largest city and the political, financial and cultural centre. Sri Lanka's population is 22 million; with the Sinhalese people, who speak the Sinhala language, forming the vast majority—while Tamil is spoken by the large Tamil minority. Other long-established ethnic groups include the Moors, Indian Tamils, Burghers, Malays, Chinese, and Vedda."}}, {"canonical_name": "orientaL", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "oriental", "book_id": "coloquios_da_orta_1563", "name": "orientaL", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["oriental", "orientaL"], "contexts": ["origin of the term achar", "oriental designation"]}, {"entity_id": "oriental_gianat", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Oriental Gianat", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Oriental Gianat"], "contexts": ["gem"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "orientaL", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Oriental Gianat", "similarity": 0.815}], "id": 1083, "stable_key": "clu_9bacfd4b2049b914", "ground_truth": {"modern_name": "Eastern gemstones", "confidence": "low", "type": "mineral", "note": "The term 'orientaL' combined with 'Gianat' and context of 'achar' (likely referring to a type of spice or gem) suggests a qualitative description of origin rather than a specific mineral. 'Gianat' is particularly ambiguous.", "wikipedia_extract": "Oltu stone (Turkish: Oltu taşı) is a kind of jet found in the region around Oltu town within Erzurum Province, eastern Turkey. The organic substance is used as semi-precious gemstone in manufacturing jewelry. Oltu stone, sometimes called also \"Erzurum stone\", is principally mined in the villages northeast of Oltu town, around Tutlu Dağı (Yasak Dağ) as well as in Alatarla, Hankaskışla and Çataksu villages. The mountainous, rough region with steep slopes is 1,600–1,800 m (5,200–5,900 ft) high. Oltu stone beds are formed when fossilized trees are subject to diastrophism resulting in folding. Beds of this organic substance are 70–80 cm (28–31 in) in thickness.", "wikipedia_url": "https://en.wikipedia.org/wiki/Oltu_stone"}}, {"canonical_name": "Sorata", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "sorata", "book_id": "kosmos_humboldt_1845", "name": "Sorata", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Sorata"], "contexts": ["mountain measured by Pentland", "mountain measured for elevation"]}, {"entity_id": "sotarà", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sotarà", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Sotarà"], "contexts": ["volcanic peaks"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Sorata", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Sotarà", "similarity": 0.844}], "id": 1084, "stable_key": "clu_03aeaa14a68580da", "ground_truth": {"modern_name": "Sotará", "confidence": "high", "type": "place", "country": "Colombia", "note": "The context of mountains measured by Pentland and volcanic peaks strongly points to the volcano in Colombia.", "wikipedia_extract": "Comfort food is food that provides the eater a nostalgic or sentimental value and may be characterized by its satisfying heartiness and association with childhood or home cooking. The nostalgia may be specific to an individual or it may apply to a specific culture. The term comfort food can be traced back at least to 1615, where in the beginning of the second part of Don Quixote, at the beginning of chapter one, Quixote's niece and her nurse (governess, housekeeper?, \"ama\") are told to pamper him, \"to give him things to eat which are comforting and appropriate for the heart and the brain... .\" Others trace it back to 1966, when the Palm Beach Post used it in a story: \"Adults, when under severe emotional stress, turn to what could be called 'comfort food'—food associated with the security of childhood, like mother's poached egg or famous chicken soup.\" According to research by April White at JSTOR, it might have been Liza Minnelli who used the term for the first time in its modern meaning in an interview, admitting to craving a hamburger. When the term first appeared, newspapers used it in quotation marks. In the 1970s, the most popular comfort food in the United States were various potato dishes and chicken soup, but even at the time, the definition varied from person to person.", "wikipedia_url": "https://en.wikipedia.org/wiki/Comfort_food"}}, {"canonical_name": "Bdellio", "category": "PLANT", "subcategory": "RESIN", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "bdellio", "book_id": "ricettario_fiorentino_1597", "name": "Bdellio", "category": "PLANT", "subcategory": "RESIN", "count": 5, "variants": ["BDELLIO", "Bdellio", "bdellio"], "contexts": ["resin, tear of a Serracenic tree", "resin from a Serracenian tree"]}, {"entity_id": "bdellium", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Bdellium", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["Bdellium"], "contexts": ["aromatic resin"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Bdellio", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Bdellium", "similarity": 0.942}], "id": 1085, "stable_key": "clu_b1a40bfa72f21a8a", "ground_truth": {"modern_name": "Bdellium", "confidence": "high", "type": "plant", "note": "Bdellium is a known aromatic resin from various Commiphora species, fitting the context of an aromatic resin from a tree.", "wikipedia_extract": "Commiphora wightii, with common names Indian bdellium-tree, gugal, guggal, guggul, gugul, or mukul myrrh tree, is a flowering plant in the family Burseraceae, which produces a fragrant resin called gugal, guggul or gugul, that is used in incense and vedic medicine (or ayurveda). The species is native to western India, from where it was introduced westward to southern Pakistan and the middle-east. It prefers arid and semi-arid climates and is tolerant of poor soil. Commiphora wightii grows as a shrub or small tree, reaching a maximum height of 4 m (13 ft), with thin papery bark. The branches are thorny. The leaves are simple or trifoliate, the leaflets ovate, 1–5 cm (0.39–1.97 in) long, 0.5–2.5 cm (0.20–0.98 in) broad, and irregularly toothed.", "wikipedia_url": "https://en.wikipedia.org/wiki/Commiphora_wightii"}}, {"canonical_name": "Euclide", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "euclide", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Euclide", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["Euclide"], "contexts": ["ancient mathematician", "mathematician, example of logical impossibility"]}, {"entity_id": "euclid", "book_id": "first_principles_spencer_1862", "name": "Euclid", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Euclid"], "contexts": ["ancient mathematician"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Euclide", "target_book": "first_principles_spencer_1862", "target_name": "Euclid", "similarity": 0.938}], "id": 1086, "stable_key": "clu_e0312d635207fcd3", "ground_truth": {"modern_name": "Euclid", "confidence": "high", "type": "person", "birth_year": -300, "death_year": -295, "description": "Ancient Greek mathematician and geometer, author of Elements.", "wikidata_id": "Q1949136", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Euclidean_geometry", "wikipedia_extract": "Euclidean geometry is a mathematical system attributed to Euclid, an ancient Greek mathematician, which he described in his textbook on geometry, Elements. Euclid's approach consists in assuming a small set of intuitively appealing axioms (postulates) and deducing many other propositions (theorems) from these. One of those is the parallel postulate which relates to parallel lines on a Euclidean plane. Although many of Euclid's results had been stated earlier, Euclid was the first to organize these propositions into a logical system in which each result is proved from axioms and previously proved theorems. The Elements begins with plane geometry, still taught in secondary school (high school) as the first axiomatic system and the first examples of mathematical proofs. It goes on to the solid geometry of three dimensions."}}, {"canonical_name": "Juniper Berries", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "juniper_berries", "book_id": "english_physician_1652", "name": "Juniper Berries", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["Juniper Berries"], "contexts": ["comparison for size and color of Bilberries", "berries used in a medicinal preparation"]}, {"entity_id": "juniperos", "book_id": "coloquios_da_orta_1563", "name": "Juniperos", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Juniperos", "junipero"], "contexts": ["trees compared to pepper trees", "plant compared to pimenta"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Juniper Berries", "target_book": "coloquios_da_orta_1563", "target_name": "Juniperos", "similarity": 0.875}], "id": 1087, "stable_key": "clu_fe76284369516053", "ground_truth": {"modern_name": "Juniper Berries", "confidence": "high", "type": "plant", "linnaean": "Juniperus communis", "family": "Cupressaceae", "description": "The small, bluish-black, aromatic cones of the juniper tree, used medicinally.", "wikipedia_extract": "Juniperus communis, the common juniper, is a species of small tree or shrub in the cypress family Cupressaceae. An evergreen conifer, it has the largest geographical range of any woody plant, with a Holarctic distribution throughout the cool temperate Northern Hemisphere. Juniperus communis is highly variable in form, ranging from 10 metres (33 feet)—rarely 16 m (52 ft)—tall to a low, often prostrate spreading shrub in exposed locations. It has needle-like leaves in whorls of three; the leaves are green, with a single white stomatal band on the inner surface. It never attains the scale-like adult foliage of other members of the genus. It is dioecious, with male and female cones on separate plants so requiring wind pollination to transfer pollen from male to female cones."}}, {"canonical_name": "Maidenhair", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "maidenhair", "book_id": "english_physician_1652", "name": "Maidenhair", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["Maidenhair", "Golden Maidenhair"], "contexts": ["herb used with Liquorice", "plant with black fibers and green leaves"]}, {"entity_id": "maidenhair", "book_id": "polyanthea_medicinal", "name": "Maidenhair", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Maidenhair"], "contexts": ["herb for coughs and jaundice"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Maidenhair", "target_book": "polyanthea_medicinal", "target_name": "Maidenhair", "similarity": 1.0}], "id": 1088, "stable_key": "clu_3f3419a136bca0f0", "ground_truth": {"modern_name": "Maidenhair Fern", "confidence": "high", "type": "plant", "linnaean": "Adiantum spp.", "family": "Pteridaceae", "description": "A delicate fern with fan-shaped fronds and black stems.", "note": "Refers to plants in the genus Adiantum.", "wikipedia_extract": "Adiantum (), the maidenhair fern (not to be confused with the similar-looking maidenhair spleenwort fern), is a genus of about 250 species of ferns in the subfamily Vittarioideae of the family Pteridaceae, though some researchers place it in its own family, Adiantaceae. The genus name comes from Greek, meaning \"unwetted\", referring to the fronds' ability to shed water without becoming wet. They are distinctive in appearance, with dark, often black stipes and rachises, and bright green, often delicately cut leaf tissue. The sori are borne submarginally, and are covered by reflexed flaps of leaf tissue which resemble indusia. Dimorphism between sterile and fertile fronds is generally subtle. They generally prefer humus-rich, moist, well-drained sites, ranging from bottomland soils to vertical rock walls."}}, {"canonical_name": "Opening", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "opening", "book_id": "english_physician_1652", "name": "Opening", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 4, "variants": ["Opening", "opening"], "contexts": ["quality of herbs used with borrage syrup", "quality of the plant"]}, {"entity_id": "aperta", "book_id": "polyanthea_medicinal", "name": "aperta", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["aperta", "apertando"], "contexts": ["astringent property", "tightening of clothing"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Opening", "target_book": "polyanthea_medicinal", "target_name": "aperta", "similarity": 0.912}], "id": 1089, "stable_key": "clu_4212b74ae438894f", "ground_truth": {"modern_name": "Opening Quality", "confidence": "high", "type": "concept", "description": "A medicinal quality that causes dilation or loosening of bodily tissues.", "note": "Refers to the traditional humoral concept of a substance's ability to 'open'.", "wikipedia_extract": "A fuzzy concept is an idea of which the boundaries of application can vary considerably according to context or conditions, instead of being fixed once and for all. That means the idea is somewhat vague or imprecise. Yet it is not unclear or meaningless. It has a definite meaning, which can often be made more exact with further elaboration and specification — including a closer definition of the context in which the concept is used. The inverse of a \"fuzzy concept\" is a \"crisp concept\" (i.e. a precise concept). Fuzzy concepts are often used to navigate imprecision in the real world, when precise information is not available and an approximate indication is sufficient to be helpful."}}, {"canonical_name": "Virgo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "virgo", "book_id": "english_physician_1652", "name": "Virgo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Virgo"], "contexts": ["zodiacal sign associated with Fennel", "zodiacal sign"]}, {"entity_id": "virg_", "book_id": "polyanthea_medicinal", "name": "virg.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["virg.", "Virg.", "Virgo"], "contexts": ["abbreviation for Virgil", "verse reference in a text"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Virgo", "target_book": "polyanthea_medicinal", "target_name": "virg.", "similarity": 0.889}], "id": 1090, "stable_key": "clu_48e26b9758a03725", "ground_truth": {"modern_name": "Virgo", "confidence": "high", "type": "concept", "description": "Zodiacal sign, one of the twelve constellations of the zodiac.", "note": "This cluster refers to the astrological sign Virgo, not the planet, musician, or the Roman goddess.", "wikipedia_extract": "Virgo (♍︎; Ancient Greek: Παρθένος, romanized: Parthénos; Latin for \"virgin\" or \"maiden\") is the sixth astrological sign in the zodiac. It spans the 150–180th degree of the zodiac. Under the tropical zodiac, the Sun transits this area between August 24 and September 23 on average. Depending on the system of astrology, individuals born during these dates may be called Virgos or Virgoans. The sign is associated with Astraea, a figure from Greek mythology. Astraea was the last immortal to abandon Earth at the end of the Silver Age when the gods fled to Olympus, which is why Virgo is associated with Earth."}}, {"canonical_name": "palsiones de cabega", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "palsiones_de_cabega", "book_id": "historia_medicinal_monardes_1574", "name": "palsiones de cabega", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["palsiones de cabega", "paffiones de pecho", "palsiones", "palsiones de pecho"], "contexts": ["head ailments", "ailments of the head"]}, {"entity_id": "talparias_da_cabeça", "book_id": "polyanthea_medicinal", "name": "talparias da cabeça", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["talparias da cabeça"], "contexts": ["scalp swellings or tumors"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "palsiones de cabega", "target_book": "polyanthea_medicinal", "target_name": "talparias da cabeça", "similarity": 0.856}], "id": 1091, "stable_key": "clu_c3cf1d5c15d06a7f", "ground_truth": {"modern_name": "headaches", "confidence": "high", "type": "disease", "description": "Ailments or pain affecting the head.", "note": "The Spanish and Portuguese terms refer to various head ailments and scalp conditions.", "wikipedia_extract": "A headache, also known as cephalalgia, is the symptom of pain in the face, head, or neck. It can occur as a migraine, tension-type headache, or cluster headache. There is an increased risk of depression in those with severe headaches. Headaches can occur as a result of many conditions. There are a number of different classification systems for headaches. The most well-recognized is that of the International Headache Society, which classifies it into more than 150 types of primary and secondary headaches."}}, {"canonical_name": "Emulgentes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "emulgentes", "book_id": "polyanthea_medicinal", "name": "Emulgentes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 5, "variants": ["Emulgentes", "emulsione", "emulsiones"], "contexts": ["veins that draw fluid, can become full", "emulgents, for urine caused by cold intemperance"]}, {"entity_id": "emulsion", "book_id": "english_physician_1652", "name": "Emulsion", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Emulsion"], "contexts": ["preparation made from hemp seed"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Emulgentes", "target_book": "english_physician_1652", "target_name": "Emulsion", "similarity": 0.848}], "id": 1092, "stable_key": "clu_ca2b75a5877418d4", "ground_truth": {"modern_name": "emulgents", "confidence": "high", "type": "substance", "description": "Substances that help mix oils and water, or substances that draw fluid.", "note": "This refers to substances used in medicine that can emulsify or have diuretic properties.", "wikipedia_extract": "An emulsion is a mixture of two or more liquids that are normally immiscible (unmixable or unblendable) owing to liquid-liquid phase separation. Emulsions are part of a more general class of two-phase systems of matter called colloids. Although the terms colloid and emulsion are sometimes used interchangeably, emulsion more narrowly refers to when both phases, dispersed and continuous, are liquids. In an emulsion, one liquid (the dispersed phase) is dispersed in the other (the continuous phase). Examples of emulsions include vinaigrettes, homogenized milk, liquid biomolecular condensates, and some cutting fluids for metal working. Two liquids can form different types of emulsions."}}, {"canonical_name": "Flight", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "flight", "book_id": "origin_of_species_darwin_1859", "name": "Flight", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Flight", "flight"], "contexts": ["ability to move through air", "movement through the air"]}, {"entity_id": "flying", "book_id": "kosmos_humboldt_1845", "name": "flying", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["flying"], "contexts": ["ability to move through air"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Flight", "target_book": "kosmos_humboldt_1845", "target_name": "flying", "similarity": 0.968}], "id": 1093, "stable_key": "clu_8654747e05094694", "ground_truth": {"modern_name": "Flight", "confidence": "high", "type": "concept", "wikipedia_extract": "Falcons Flight is a launched roller coaster located at Six Flags Qiddiya City in Qiddiya City, Riyadh Province, Saudi Arabia. Manufactured by Intamin, the steel coaster opened on December 31, 2025, as the tallest, fastest, and longest roller coaster in the world, surpassing Top Thrill 2, Formula Rossa, and Steel Dragon 2000, respectively. On April 7, 2017, Crown Prince Mohammed bin Salman officially announced the Qiddiya City mega project, an entertainment, sport, and cultural destination designed to diversify Saudi Arabia's economy as part of the Saudi Vision 2030 initiative. Included in the announcement was the involvement of the original Six Flags theme park chain, which at the time was also pursuing the development of international parks in Dubai and China. The Saudi Press Agency reported in October 2018 that the Crown Prince had met with David McKillip – then Six Flags' senior vice president of international park operations –  at the Future Investment Initiative conference in Riyadh. Details for Six Flags Qiddiya were formally revealed on August 26, 2019, with the park slated to open in early 2023.", "wikipedia_url": "https://en.wikipedia.org/wiki/Falcons_Flight"}}, {"canonical_name": "pelvis", "category": "ANATOMY", "subcategory": "BODY_PART", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "pelvis", "book_id": "origin_of_species_darwin_1859", "name": "pelvis", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 3, "variants": ["pelvis"], "contexts": ["bone structure in birds and humans", "form affected by mountainous country"]}, {"entity_id": "pelvis_of_women", "book_id": "origin_of_species_darwin_1859", "name": "Pelvis of women", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["Pelvis of women"], "contexts": ["female anatomical structure"]}, {"entity_id": "pelvis", "book_id": "kosmos_humboldt_1845", "name": "pelvis", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 2, "variants": ["pelvis"], "contexts": ["skeletal structure investigated", "part of the skeleton investigated"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "pelvis", "target_book": "kosmos_humboldt_1845", "target_name": "pelvis", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Pelvis of women", "target_book": "kosmos_humboldt_1845", "target_name": "pelvis", "similarity": 0.907}], "id": 1094, "stable_key": "clu_1c7dd80f7db843a3", "ground_truth": {"modern_name": "Pelvis", "confidence": "high", "type": "anatomy", "wikidata_id": "Q713102", "wikidata_description": "lower part of the trunk of the human body between the abdomen and the thighs (sometimes also called pelvic region of the trunk", "wikipedia_extract": "The human skeleton is the internal framework of the human body. It is composed of around 270 bones at birth – this total decreases to around 206 bones by adulthood after some bones fuse together, not counting accessory bones. The bone mass in the skeleton makes up about 14% of the total body weight (ca. 10–11 kg for an average person) and reaches maximum mass between the ages of 25 and 30. The human skeleton can be divided into the axial skeleton and the appendicular skeleton. The axial skeleton is formed by the spinal column, the rib cage, the skull, and associated bones.", "wikipedia_url": "https://en.wikipedia.org/wiki/Pelvis"}}, {"canonical_name": "swim-bladder", "category": "ANATOMY", "subcategory": "ORGAN", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "swim-bladder", "book_id": "origin_of_species_darwin_1859", "name": "swim-bladder", "category": "ANATOMY", "subcategory": "ORGAN", "count": 3, "variants": ["swim-bladder"], "contexts": ["organ in fish for buoyancy", "organ in fish"]}, {"entity_id": "swim-bladders", "book_id": "origin_of_species_darwin_1859", "name": "swim-bladders", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["swim-bladders"], "contexts": ["gas-filled organs in fish for buoyancy"]}, {"entity_id": "swim-bladder_of_fishes", "book_id": "origin_of_species_darwin_1859", "name": "swim-bladder of fishes", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["swim-bladder of fishes"], "contexts": ["fish anatomy discussed by Owen"]}, {"entity_id": "swimming_bladders", "book_id": "kosmos_humboldt_1845", "name": "swimming bladders", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["swimming bladders"], "contexts": ["buoyancy organs in fish"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "swim-bladder", "target_book": "kosmos_humboldt_1845", "target_name": "swimming bladders", "similarity": 0.85}, {"source_book": "origin_of_species_darwin_1859", "source_name": "swim-bladders", "target_book": "kosmos_humboldt_1845", "target_name": "swimming bladders", "similarity": 0.96}, {"source_book": "origin_of_species_darwin_1859", "source_name": "swim-bladder of fishes", "target_book": "kosmos_humboldt_1845", "target_name": "swimming bladders", "similarity": 0.914}], "id": 1095, "stable_key": "clu_093e777ab0690178", "ground_truth": {"modern_name": "Swim bladder", "confidence": "high", "type": "anatomy", "wikipedia_extract": "The swim bladder, gas bladder, fish maw, air bladder or sound is an internal gas-filled organ in bony fish that functions to modulate buoyancy, and thus allowing the fish to stay at desired water depth without having to maintain lift via swimming, which expends more energy. Also, the dorsal position of the swim bladder means that the expansion of the bladder moves the center of mass downwards, allowing it to act as a stabilizing apparatus. Additionally, the swim bladder functions as a resonating chamber to produce or receive sound. The swim bladder is evolutionarily homologous to the lungs of tetrapods and lungfish, and some ray-finned fish such as bowfins have also evolved similar respiratory functions in their swim bladders. Charles Darwin remarked upon this in On the Origin of Species, and reasoned that the lung in air-breathing vertebrates had derived from a more primitive swim bladder as a specialized form of enteral respiration. Some species, such as mostly bottom dwellers like the weather fish and redlip blenny, have secondarily lost the swim bladder during the embryonic stage."}}, {"canonical_name": "Lobelia", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "lobelia", "book_id": "origin_of_species_darwin_1859", "name": "Lobelia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Lobelia"], "contexts": ["genus with different pollination strategies", "plant genus with unusual fertilization properties"]}, {"entity_id": "lotioveio", "book_id": "ricettario_fiorentino_1597", "name": "lotioveio", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["lotioveio", "l otioveio"], "contexts": ["a type of spice or herb", "ingredient in a preparation"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Lobelia", "target_book": "ricettario_fiorentino_1597", "target_name": "lotioveio", "similarity": 0.852}], "id": 1096, "stable_key": "clu_c52c0e5b4d24b471", "ground_truth": {"modern_name": "Lobelia", "confidence": "medium", "type": "plant", "description": "A genus of plants known for diverse pollination and fertilization strategies.", "note": "The term 'lotioveio' in the historical text is likely a misrendering or obscure reference to a preparation involving herbs or spices, potentially related to or confused with botanical ingredients like Lobelia.", "wikipedia_extract": "Lobelia () is a genus of flowering plants in the family Campanulaceae comprising 415 species, with a subcosmopolitan distribution primarily in tropical to warm temperate regions of the world, a few species extending into cooler temperate regions. They are known generally as lobelias. The genus Lobelia comprises a substantial number of large and small annual, perennial and shrubby species, hardy and tender, from a variety of habitats, in a range of colours. Many species appear totally dissimilar from each other. However, all have simple, alternate leaves and two-lipped tubular flowers, each with five lobes. The upper two lobes may be erect while the lower three lobes may be fanned out."}}, {"canonical_name": "oesophagus", "category": "ANATOMY", "subcategory": "BODY_PART", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "oesophagus", "book_id": "origin_of_species_darwin_1859", "name": "oesophagus", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 5, "variants": ["oesophagus"], "contexts": ["upper part expanded by turbit", "tube connecting mouth to stomach"]}, {"entity_id": "œsophagus", "book_id": "first_principles_spencer_1862", "name": "œsophagus", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["œsophagus"], "contexts": ["tube for swallowing food"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "oesophagus", "target_book": "first_principles_spencer_1862", "target_name": "œsophagus", "similarity": 0.976}], "id": 1097, "stable_key": "clu_d23a00240ae2e2c8", "ground_truth": {"modern_name": "Esophagus", "confidence": "high", "type": "anatomy", "wikidata_id": "Q173710", "wikidata_description": "vertebrate organ through which food passes to the stomach", "wikipedia_url": "https://en.wikipedia.org/wiki/Esophagus", "wikipedia_extract": "The human digestive system consists of the gastrointestinal tract plus the accessory organs of digestion (the tongue, salivary glands, pancreas, liver, and gallbladder). Digestion involves the breakdown of food into smaller and smaller components, until they can be absorbed and assimilated into the body. The process of digestion has three stages: the cephalic phase, the gastric phase, and the intestinal phase. The first stage, the cephalic phase of digestion, begins with secretions from gastric glands in response to the sight and smell of food, and continues in the mouth with the mechanical breakdown of food by chewing, and the chemical breakdown by digestive enzymes in the saliva. Saliva contains amylase, and lingual lipase, secreted by the salivary glands, and serous glands on the tongue. Chewing mixes the food with saliva to produce a food bolus to be swallowed down the esophagus to enter the stomach."}}, {"canonical_name": "Milne Edwards", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "milne_edwards", "book_id": "origin_of_species_darwin_1859", "name": "Milne Edwards", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Milne Edwards"], "contexts": ["elucidated physiological division of labour", "naturalist quoted on nature's variety"]}, {"entity_id": "milne-edwards", "book_id": "first_principles_spencer_1862", "name": "Milne-Edwards", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Milne-Edwards"], "contexts": ["described union of homogeneous parts in invertebrata"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Milne Edwards", "target_book": "first_principles_spencer_1862", "target_name": "Milne-Edwards", "similarity": 0.891}], "id": 1098, "stable_key": "clu_3d66298a6da26a39", "ground_truth": {"modern_name": "Henri Milne Edwards", "confidence": "high", "type": "person", "birth_year": 1800, "death_year": 1885, "description": "Zoologist who studied physiological division of labor.", "wikidata_id": "Q505173", "wikidata_description": "French zoologist (1800-1885)", "wikipedia_url": "https://en.wikipedia.org/wiki/Henri_Milne-Edwards", "wikipedia_extract": "Milne-Edwards's sifaka (Propithecus edwardsi), or Milne-Edwards's simpona, is a large arboreal, diurnal lemur endemic to the eastern coastal rainforest of Madagascar. Milne-Edwards's sifaka is characterized by a black body with a light-colored \"saddle\" on the lower part of its back. It is closely related to the diademed sifaka, and was until recently considered a subspecies of it. Like all sifakas, it is a primate in the family Indriidae. The species' name honors French zoologist Henri Milne-Edwards (1800–1885). Milne-Edwards's sifaka is categorized as endangered by the IUCN, and is listed in CITES Appendix I."}}, {"canonical_name": "palæontologists", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "palæontologists", "book_id": "origin_of_species_darwin_1859", "name": "palæontologists", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["palæontologists"], "contexts": ["experts in fossils", "scientists studying fossils"]}, {"entity_id": "palæontologists", "book_id": "first_principles_spencer_1862", "name": "palæontologists", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["palæontologists"], "contexts": ["scientists studying fossils"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "palæontologists", "target_book": "first_principles_spencer_1862", "target_name": "palæontologists", "similarity": 1.0}], "id": 1099, "stable_key": "clu_b9f52d228a920156", "ground_truth": {"modern_name": "Paleontologists", "confidence": "high", "type": "concept", "wikidata_id": "Q7205", "wikidata_description": "scientific study of the past of life on Earth through fossils", "wikipedia_url": "https://en.wikipedia.org/wiki/Paleontology", "wikipedia_extract": "Persons of National Historic Significance (National Historic People) (French: Personnes d'importance historique nationale (personnages historiques nationaux)) are people designated by the Canadian government as being nationally significant in the history of the country. Designations are made by the Minister of the Environment on the recommendation of the Historic Sites and Monuments Board of Canada. Approximately 70 nominations are submitted to the board each year. A person is eligible to be listed 25 years after death, but Prime Ministers may be designated any time after death. Parks Canada administers the program, and installs and maintains the federal plaques commonly erected to commemorate each person, usually placed at a site closely associated with them. The intent is generally to honour the person's contribution to the country but is always to educate the public about that person."}}, {"canonical_name": "hacdadh", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "hacdadh", "book_id": "coloquios_da_orta_1563", "name": "hacdadh", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["hacdadh", "haddhadh"], "contexts": ["Arab name for licium", "name for a substance"]}, {"entity_id": "hasheesh", "book_id": "principles_of_psychology_james_1890", "name": "hasheesh", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["hasheesh"], "contexts": ["substance that can affect consciousness"]}, {"entity_id": "haschish", "book_id": "principles_of_psychology_james_1890", "name": "haschish", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["haschish"], "contexts": ["drug inducing altered states"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "hacdadh", "target_book": "principles_of_psychology_james_1890", "target_name": "hasheesh", "similarity": 0.853}, {"source_book": "coloquios_da_orta_1563", "source_name": "hacdadh", "target_book": "principles_of_psychology_james_1890", "target_name": "haschish", "similarity": 0.854}], "id": 1100, "stable_key": "clu_8a2eb476eb85311e", "ground_truth": {"modern_name": "Hashish", "confidence": "high", "type": "substance", "description": "A psychoactive drug derived from the cannabis plant.", "note": "Covers variations in spelling and the historical Arabic name for the substance.", "wikipedia_extract": "Hashish ( ; from Arabic  ḥašiš حشيش 'hay'), usually abbreviated as hash, is a compressed form of resin (trichomes) derived from the Cannabis flowers. As a psychoactive substance, it is consumed plain or mixed with tobacco. It has a long history of use in countries such as Afghanistan, India, Pakistan, Iran, Iraq, Lebanon, Morocco, Nepal and Egypt. Hashish consumption is also popular in Europe. In the United States, dried flowers or concentrates are more popular, and hash has seen a relative decrease in popularity following changes in laws that have indirectly allowed for the development and increased availability of cannabis extracts that are more potent than traditional hashish, although regional differences in product preferences exist. Like many recreational drugs, multiple synonyms and alternative names for hashish exist, and vary greatly depending on the country and native language."}}, {"canonical_name": "boussole", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "boussole", "book_id": "relation_historique_humboldt_vol3_1825", "name": "boussole", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 5, "variants": ["boussole", "boussole de Borda", "boussole de Gambey"], "contexts": ["instrument for taking bearings", "instrument for navigation"]}, {"entity_id": "boussole", "book_id": "kosmos_humboldt_1845", "name": "Boussole", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["Boussole"], "contexts": ["French for compass"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "boussole", "target_book": "kosmos_humboldt_1845", "target_name": "Boussole", "similarity": 0.953}], "id": 1101, "stable_key": "clu_4ad6f934fa10b29c", "ground_truth": {"modern_name": "Compass", "confidence": "high", "type": "object", "note": "The term 'boussole' is the French word for compass.", "wikidata_id": "Q2476036", "wikidata_description": "American independent record label based in Nashville, Tennessee", "wikipedia_url": "https://en.wikipedia.org/wiki/Compass_Records", "wikipedia_extract": "Compass Records is an American independent record label founded in 1995 by musicians Garry West and Alison Brown that specializes in folk, bluegrass, Celtic, jazz, and acoustic music. In 2006, Compass purchased the Green Linnet and Xenophile catalogs, and in 2008 the label purchased Mulligan Records. Red House Records, an independent folk and Americana record label founded in 1983 in St. Paul, Minnesota, was purchased by the Compass Records Group in 2017."}}, {"canonical_name": "montagnes primitives", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "montagnes_primitives", "book_id": "relation_historique_humboldt_vol3_1825", "name": "montagnes primitives", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["montagnes primitives", "montagnes calcaires"], "contexts": ["classification of mountains", "ancient mountain ranges"]}, {"entity_id": "primitive_mountains", "book_id": "kosmos_humboldt_1845", "name": "primitive mountains", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["primitive mountains"], "contexts": ["ancient mountain ranges"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "montagnes primitives", "target_book": "kosmos_humboldt_1845", "target_name": "primitive mountains", "similarity": 0.984}], "id": 1102, "stable_key": "clu_d31659c91bb6499d", "ground_truth": {"modern_name": "Primitive mountains", "confidence": "high", "type": "concept", "note": "Refers to ancient, possibly foundational, mountain formations in geological history.", "wikipedia_extract": "The Kunlun Mountains constitute one of the longest mountain chains in Asia, extending for more than 3,000 kilometres (1,900 mi). In the broadest sense, the chain forms the northern edge of the Tibetan Plateau south of the Tarim Basin. Located in Western China, the Kunlun Mountains have been known as the \"Forefather of Mountains\" in China. The exact definition of the Kunlun Mountains varies over time. Older sources used Kunlun to mean the mountain belt that runs across the center of China, that is, Altyn Tagh along with the Qilian and Qin Mountains. Recent sources have the Kunlun range forming most of the south side of the Tarim Basin and then continuing east, south of the Altyn Tagh.", "wikipedia_url": "https://en.wikipedia.org/wiki/Kunlun_Mountains"}}, {"canonical_name": "diallage métalloïde", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "diallage_métalloïde", "book_id": "relation_historique_humboldt_vol3_1825", "name": "diallage métalloïde", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["diallage métalloïde", "diallage", "diallage metalloïde"], "contexts": ["mineral found in serpentine", "metallic diallage"]}, {"entity_id": "diallage", "book_id": "kosmos_humboldt_1845", "name": "diallage", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["diallage"], "contexts": ["mineral laminae"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "diallage métalloïde", "target_book": "kosmos_humboldt_1845", "target_name": "diallage", "similarity": 0.897}], "id": 1103, "stable_key": "clu_bd9fbc86c94e175b", "ground_truth": {"modern_name": "Diallage", "confidence": "high", "type": "mineral", "note": "'Diallage métalloïde' refers to a specific variety of diallage.", "wikipedia_extract": "Diallage is an inosilicate, meaning it is a chain silicate, and is a part of the pyroxene group. Diallage is a junction between augite and diopside, just like fassaite. It was named in 1801 by René Just Haüy. Its name derives from the Greek word diallaghé (meaning change, transform, difference), as its composition differs from that of the other minerals in the pyroxene group. It is a fairly common mineral, and is cheap. Diallage is typically an opaque mineral, but translucent specimens can occur."}}, {"canonical_name": "Harz", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "harz", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Harz", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Harz"], "contexts": ["location of granite chains", "mountain range"]}, {"entity_id": "harz", "book_id": "kosmos_humboldt_1845", "name": "Harz", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Harz"], "contexts": ["mountain range with mines"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Harz", "target_book": "kosmos_humboldt_1845", "target_name": "Harz", "similarity": 1.0}], "id": 1104, "stable_key": "clu_33c600981f65c88b", "ground_truth": {"modern_name": "Harz Mountains", "confidence": "high", "type": "place", "country": "Germany", "wikidata_id": "Q4186", "wikidata_description": "low mountain range in northern Germany", "wikipedia_extract": "The Hexentanzplatz (literally “Witches′ Dance Floor”) in the Harz mountains is a plateau (454 m above sea level (NN)) that lies high above the Bode Gorge, opposite the Rosstrappe in Saxony-Anhalt, Germany. The Hexentanzplatz is reputedly an Old Saxon cult site, at which pagan celebrations were held in honour of the so-called Hagedisen (forest and mountain goddesses), particularly on the night of 1 May. The place did not become known as the Hexentanzplatz until the cult was banned by the invading Christian Franks. According to tradition the site was guarded by Frankish soldiers in order to enforce the ban and they were chased off by Saxons dressed as witches and riding on broomsticks. Another old Saxon cult site is found on the Brocken. Above the Hexentanzplatz are the remains of the Sachsenwall (“Saxon Dyke”), a wall of granite rocks and possibly part of a larger fortification, more than 1,500 years old.", "wikipedia_url": "https://en.wikipedia.org/wiki/Harz"}}, {"canonical_name": "Bahia", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "bahia", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bahia", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Bahia"], "contexts": ["port that received slaves", "city and region"]}, {"entity_id": "bahia", "book_id": "kosmos_humboldt_1845", "name": "Bahia", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bahia"], "contexts": ["city in Brazil"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bahia", "target_book": "kosmos_humboldt_1845", "target_name": "Bahia", "similarity": 1.0}], "id": 1105, "stable_key": "clu_040efc22572f3dca", "ground_truth": {"modern_name": "Bahia", "confidence": "high", "type": "place", "country": "Brazil", "wikidata_id": "Q2236958", "wikidata_description": "genus of plants", "wikipedia_extract": "Bahia (English: , bə-(H)EE-ə; Brazilian Portuguese: [baˈi.ɐ] ) is one of the 26 states of Brazil, located in the Northeast Region of the country. It is the fourth-largest Brazilian state by population (after São Paulo, Minas Gerais, and Rio de Janeiro) and the 5th-largest by area. Bahia's capital is the city of Salvador (formerly known as \"Cidade do São Salvador da Bahia de Todos os Santos\", literally \"City of the Holy Savior of the Bay of All the Saints\"), on a spit of land separating the Bay of All Saints from the Atlantic. Once a stronghold of supporters of direct rule of Brazil by the Portuguese monarchy, and dominated by agricultural, slaving, and ranching interests, Bahia is now a predominantly working-class industrial and agricultural state. The state is home to 7% of the Brazilian population and produces 4.2% of the country's GDP. It is divided into 417 municipalities.", "wikipedia_url": "https://en.wikipedia.org/wiki/Bahia"}}, {"canonical_name": "Cap Paria", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "cap_paria", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cap Paria", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Cap Paria", "cap Paria"], "contexts": ["geographic cape", "cape on the coast of Venezuela"]}, {"entity_id": "cape_parena", "book_id": "kosmos_humboldt_1845", "name": "Cape Parena", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cape Parena"], "contexts": ["geographic location on coast"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cap Paria", "target_book": "kosmos_humboldt_1845", "target_name": "Cape Parena", "similarity": 0.883}], "id": 1106, "stable_key": "clu_551fa0598029d291", "ground_truth": {"modern_name": "Cape Paria", "confidence": "high", "type": "place", "country": "Venezuela"}}, {"canonical_name": "Finlande", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "finlande", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Finlande", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Finlande"], "contexts": ["Included in Russian European area calculation", "Included in empire area calculation"]}, {"entity_id": "finland", "book_id": "kosmos_humboldt_1845", "name": "Finland", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Finland"], "contexts": ["country experiencing land changes"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Finlande", "target_book": "kosmos_humboldt_1845", "target_name": "Finland", "similarity": 0.85}], "id": 1107, "stable_key": "clu_42aa6c7fac41168b", "ground_truth": {"modern_name": "Finland", "confidence": "high", "type": "place", "country": "Finland", "wikidata_id": "Q33", "wikidata_description": "country in Northern Europe", "wikipedia_url": "https://en.wikipedia.org/wiki/Finland", "wikipedia_extract": "Finland, officially the Republic of Finland, is a Nordic country in Northern Europe. It borders Sweden to the northwest, Norway to the north, and Russia to the east, with the Gulf of Bothnia to the west and the Gulf of Finland to the south, opposite Estonia. Its capital and largest city is Helsinki. Finland has a population of 5.6 million. The official languages are Finnish and Swedish, the mother tongues of 84.1 percent and 5.1 percent of the population, respectively. Finland's climate varies from humid continental in the south to boreal in the north."}}, {"canonical_name": "Culia", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "culia", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Culia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Culia"], "contexts": ["city in South America", "island mentioned in population comparison"]}, {"entity_id": "cullea", "book_id": "kosmos_humboldt_1845", "name": "Cullea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cullea"], "contexts": ["hill where bodies were hurled"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Culia", "target_book": "kosmos_humboldt_1845", "target_name": "Cullea", "similarity": 0.911}], "id": 1108, "stable_key": "clu_18785e61affdf9be", "ground_truth": {"modern_name": "Cullio", "confidence": "medium", "type": "place", "country": "Peru", "note": "The spelling 'Culia' is likely a misspelling or variant of Cullio. Humboldt's 'Kosmos' uses 'Cullea' which is also likely a variant.", "wikipedia_extract": "Naming conventions for women in ancient Rome List of Roman imperial victory titles", "wikipedia_url": "https://en.wikipedia.org/wiki/List_of_Roman_cognomina"}}, {"canonical_name": "Tobolsk", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "tobolsk", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tobolsk", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Tobolsk"], "contexts": ["city in Siberia", "location of magnetic force comparison"]}, {"entity_id": "tobolsk", "book_id": "kosmos_humboldt_1845", "name": "Tobolsk", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Tobolsk"], "contexts": ["city in Asiatic Continent", "city in Western Siberia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tobolsk", "target_book": "kosmos_humboldt_1845", "target_name": "Tobolsk", "similarity": 1.0}], "id": 1109, "stable_key": "clu_8304c3900aa83872", "ground_truth": {"modern_name": "Tobolsk", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q168782", "wikidata_description": "town in Tyumen Oblast, Russia", "wikipedia_url": "https://en.wikipedia.org/wiki/Tobolsk", "wikipedia_extract": "Tobolsk (Russian: Тобо́льск, IPA: [tɐˈbolʲsk]) is a town in Tyumen Oblast, Russia, located at the confluence of the Tobol and Irtysh rivers. Founded in 1587, Tobolsk is the second-oldest Russian settlement east of the Ural Mountains in Asian Russia, and was the historic capital of the Siberia region. Population: 100,352 (2021 census); 99,694 (2010 census); 92,880 (2002 census); 94,143 (1989 Soviet census). The town was founded on the site of the Tatar town of Sibir-tura. In 1580, a group of Yermak Timofeyevich's Cossacks initiated the Russian conquest of Siberia, pushing eastwards on behalf of the Tsardom of Russia. After a year of Tatar attacks, Yermak prepared for the conquest of the Khanate of Sibir and a campaign to take the Khanate's capital city, Qashliq."}}, {"canonical_name": "Cruces", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "cruces", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cruces", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Cruces"], "contexts": ["embarcadero", "location on the isthmus"]}, {"entity_id": "cross", "book_id": "kosmos_humboldt_1845", "name": "Cross", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cross"], "contexts": ["region in the heavens"]}, {"entity_id": "a_crucis", "book_id": "kosmos_humboldt_1845", "name": "a Crucis", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["a Crucis"], "contexts": ["star used for brightness comparison"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cruces", "target_book": "kosmos_humboldt_1845", "target_name": "Cross", "similarity": 0.917}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cruces", "target_book": "kosmos_humboldt_1845", "target_name": "a Crucis", "similarity": 0.936}], "id": 1110, "stable_key": "clu_8ea6e41724b91dab", "ground_truth": {"modern_name": "Cruces", "confidence": "medium", "type": "place", "country": "Guatemala", "note": "Contexts suggest multiple meanings. 'Cruces' could refer to a place (likely in the Americas, given Humboldt's work) or astronomical references ('a Crucis'). Without more context, pinpointing a single referent is difficult. The primary referent in the text seems to be a place name."}}, {"canonical_name": "Cincinnati", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "cincinnati", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cincinnati", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Cincinnati"], "contexts": ["city near Petit Miami", "city where shell was discovered"]}, {"entity_id": "cincinnati", "book_id": "kosmos_humboldt_1845", "name": "Cincinnati", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Cincinnati"], "contexts": ["city in Ohio, USA", "city in the United States of America"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cincinnati", "target_book": "kosmos_humboldt_1845", "target_name": "Cincinnati", "similarity": 1.0}], "id": 1111, "stable_key": "clu_f47b86c4f2e14641", "ground_truth": {"modern_name": "Cincinnati", "confidence": "high", "type": "place", "country": "United States", "wikidata_id": "Q43196", "wikidata_description": "city in Ohio, United States; county seat of Hamilton County", "wikipedia_extract": "Cincinnati, colloquially nicknamed Cincy, is the most populous city in Hamilton County, Ohio, United States, and its county seat. Settled in 1788, the city is located on the northern side of the confluence of the Licking and Ohio rivers, the latter of which marks the state line with Kentucky. The third-most populous city in Ohio with a population of 309,317 at the 2020 census, Cincinnati serves as the economic and cultural hub of the tri-state Cincinnati metropolitan area, Ohio's most populous metropolitan area and the nation's 30th-largest at over 2.3 million residents. Throughout much of the 19th century, Cincinnati was among the top 10 U.S. cities by population. The city developed as an inland port for cargo shipping by steamboats, located at the crossroads of the Northern and Southern United States, with fewer immigrants and less influence from Europe than East Coast cities in the same period. However, it received a significant number of German-speaking immigrants, who founded many of the city's cultural institutions."}}, {"canonical_name": "Hambourg", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "hambourg", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Hambourg", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Hambourg"], "contexts": ["port for sugar export", "port receiving Brazilian sugars"]}, {"entity_id": "hamburgh", "book_id": "kosmos_humboldt_1845", "name": "Hamburgh", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Hamburgh"], "contexts": ["city to which Varenius dedicated a work"]}, {"entity_id": "hamburg", "book_id": "kosmos_humboldt_1845", "name": "Hamburg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Hamburg"], "contexts": ["latitude reached by tiger"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hambourg", "target_book": "kosmos_humboldt_1845", "target_name": "Hamburgh", "similarity": 0.872}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hambourg", "target_book": "kosmos_humboldt_1845", "target_name": "Hamburg", "similarity": 0.901}], "id": 1112, "stable_key": "clu_ca981ddfb20ec0ce", "ground_truth": {"modern_name": "Hamburg", "confidence": "high", "type": "place", "country": "Germany", "wikidata_id": "Q1055", "wikidata_description": "city and state in the North of Germany", "wikipedia_extract": "Hamburg, officially the Free and Hanseatic City of Hamburg, is the second-largest city in Germany after Berlin and seventh-largest city in the European Union, with a population of over 1.9 million. The Hamburg Metropolitan Region has a population of over 5.1 million and is the tenth-largest metropolitan region by GDP in the European Union. At the southern tip of the Jutland Peninsula, Hamburg stands on the branching River Elbe at the head of a 110 km (68 mi) estuary to the North Sea, at the confluence of the Alster and Bille. Hamburg is one of Germany's three city-states alongside Berlin and Bremen, and is surrounded by Schleswig-Holstein to the north and Lower Saxony to the south. The Port of Hamburg is Germany's largest and Europe's third-largest, after Rotterdam and Antwerp. The local dialect is a variant of Low Saxon.", "wikipedia_url": "https://en.wikipedia.org/wiki/Hamburg"}}, {"canonical_name": "San José", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "san_josé", "book_id": "relation_historique_humboldt_vol3_1825", "name": "San José", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["San José"], "contexts": ["mission location", "mission"]}, {"entity_id": "sao_joao", "book_id": "polyanthea_medicinal", "name": "Sao Joao", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Sao Joao", "Saó Juliáo"], "contexts": ["Saint John, biblical author", "day of the year 1704"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "San José", "target_book": "polyanthea_medicinal", "target_name": "Sao Joao", "similarity": 0.854}], "id": 1113, "stable_key": "clu_3024fba82009d7ac", "ground_truth": {"modern_name": "San José", "confidence": "high", "type": "place", "description": "San José refers to a specific mission or a place associated with missions.", "note": "This refers to a geographical location, likely a mission settlement.", "wikipedia_extract": "The San Jose Earthquakes are an American professional soccer club based in San Jose, California. The Earthquakes compete in Major League Soccer (MLS) as a member of the Western Conference. Originally known as the San Jose Clash, the franchise began play in 1996 as one of the charter members of the league. The Earthquakes took part in the first game in MLS history, defeating D.C. United 1–0. The Earthquakes have won two MLS Cup titles (2001, 2003) and two Supporters' Shields (2005, 2012)."}}, {"canonical_name": "Normandy", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "normandy", "book_id": "kosmos_humboldt_1845", "name": "Normandy", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Normandy"], "contexts": ["region where Cherbourg is located", "coast with mild winters"]}, {"entity_id": "normandie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Normandie", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Normandie"], "contexts": ["region in France suitable for sugar beet", "region with barometric height"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Normandy", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Normandie", "similarity": 0.943}], "id": 1114, "stable_key": "clu_2d8785d09a7c5be6", "ground_truth": {"modern_name": "Normandy", "confidence": "high", "type": "place", "country": "France", "wikidata_id": "Q15878", "wikidata_description": "geographical and cultural region which extends over a part of France and the British Channel Islands", "wikipedia_extract": "Normandy is a geographical and cultural region in northwestern Europe, roughly coextensive with the historical Duchy of Normandy. Normandy comprises mainland Normandy (a part of France) and insular Normandy (mostly the British Channel Islands). It covers 30,627 square kilometres (11,825 sq mi). Its population in 2017 was 3,499,280. The inhabitants of Normandy are known as Normans; the region is the historic homeland of the Norman language. Large settlements include Rouen, Caen, Le Havre and Cherbourg.", "wikipedia_url": "https://en.wikipedia.org/wiki/Normandy"}}, {"canonical_name": "Irkutsk", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "irkutsk", "book_id": "kosmos_humboldt_1845", "name": "Irkutsk", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Irkutsk"], "contexts": ["city near Lake Baikal", "city in Asiatic Continent"]}, {"entity_id": "irkutsk", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Irkutsk", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Irkutsk"], "contexts": ["city in Siberia"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Irkutsk", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Irkutsk", "similarity": 1.0}], "id": 1115, "stable_key": "clu_8d99acde044c0efe", "ground_truth": {"modern_name": "Irkutsk", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q6576", "wikidata_description": "capital city of Irkutsk Oblast, Siberia, in eastern Russia", "wikipedia_url": "https://en.wikipedia.org/wiki/Irkutsk", "wikipedia_extract": "Irkutsk ( eer-KOOTSK; Russian: Иркутск, IPA: [ɪrˈkutsk]; Buryat and Mongolian: Эрхүү, Erhüü [ɛrˈxuː]) is the largest city and administrative center of Irkutsk Oblast, Russia. With a population of 587,891 as of the 2010 Census, Irkutsk is the 25th-largest city in Russia by population, the fifth-largest in the Siberian Federal District, and one of the largest cities in Siberia. Located in the south of the eponymous oblast, the city proper lies on the Angara River, a tributary of the Yenisei, about 850 kilometres (530 mi) to the south-east of Krasnoyarsk and about 520 kilometres (320 mi) north of Ulaanbaatar. The Trans-Siberian Highway (Federal M53 and M55 Highways) and Trans-Siberian Railway connect Irkutsk to other regions in Russia and Mongolia. Many distinguished Russians were sent into exile in Irkutsk for their part in the Decembrist revolt of 1825, and the city became an exile-post for the rest of the century. Some historic wooden houses still survive."}}, {"canonical_name": "Samarcanda", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "samarcanda", "book_id": "coloquios_da_orta_1563", "name": "Samarcanda", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Samarcanda", "SamBrkanda", "Samarcand", "Samarkanda"], "contexts": ["celebrated city taken by Uzbeks", "stop on caravan route"]}, {"entity_id": "samarkand", "book_id": "kosmos_humboldt_1845", "name": "Samarkand", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Samarkand"], "contexts": ["location of a famed observatory"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Samarcanda", "target_book": "kosmos_humboldt_1845", "target_name": "Samarkand", "similarity": 0.852}], "id": 1116, "stable_key": "clu_98f4891ca95c4b06", "ground_truth": {"modern_name": "Samarkand", "confidence": "high", "type": "place", "country": "Uzbekistan", "wikidata_id": "Q5753", "wikidata_description": "city in southeastern Uzbekistan", "wikipedia_url": "https://en.wikipedia.org/wiki/Samarkand", "wikipedia_extract": "Samarkand is a city in southeastern Uzbekistan and among the oldest continuously inhabited cities in Central Asia. Samarkand is the capital of the Samarkand Region and a district-level city, that includes the urban-type settlements Kimyogarlar, Farhod and Khishrav. With 551,700 inhabitants (2021), it is the third-largest city in Uzbekistan. There is evidence of human activity in the area of the city dating from the late Paleolithic Era. Though there is no direct evidence of when Samarkand was founded, several theories propose that it was founded between the 8th and 7th centuries BC. Prospering from its location on the Silk Road between China, Persia and Europe, at times Samarkand was one of the largest cities in Central Asia, By the time of the Persian Achaemenid Empire, it was the capital of the Sogdian satrapy."}}, {"canonical_name": "M. Seebeck", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "m__seebeck", "book_id": "connexion_physical_sciences_somerville_1858", "name": "M. Seebeck", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["M. Seebeck"], "contexts": ["observed heat point variation", "discovery of thermo-electricity"]}, {"entity_id": "seebeck", "book_id": "kosmos_humboldt_1845", "name": "Seebeck", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Seebeck"], "contexts": ["experiments on thermo-magnetic currents"]}, {"entity_id": "seebeck", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Seebeck", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Seebeck"], "contexts": ["discovered thermo-electric currents", "fixed point of maximum heat, discovered heat-electricity relations"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "M. Seebeck", "target_book": "kosmos_humboldt_1845", "target_name": "Seebeck", "similarity": 0.908}, {"source_book": "kosmos_humboldt_1845", "source_name": "Seebeck", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Seebeck", "similarity": 1.0}], "id": 1117, "stable_key": "clu_c1e0d3ca7b3ec133", "ground_truth": {"modern_name": "Augustus Seebeck", "confidence": "high", "type": "person", "birth_year": 1775, "death_year": 1835, "description": "German physicist, known for thermoelectricity experiments.", "wikipedia_extract": "James Prescott Joule (; 24 December 1818 –  11 October 1889) was an English physicist. Joule studied the nature of heat and discovered its relationship to mechanical work. This led to the law of conservation of energy, which in turn led to the development of the first law of thermodynamics. The SI unit of energy, the joule (J), is named after him. He worked with Lord Kelvin to develop an absolute thermodynamic temperature scale, which came to be called the Kelvin scale. Joule also made observations of magnetostriction, and he found the relationship between the current through a resistor and the heat dissipated, which is also called Joule's first law.", "wikipedia_url": "https://en.wikipedia.org/wiki/James_Prescott_Joule"}}, {"canonical_name": "herrumbre", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "herrumbre", "book_id": "historia_medicinal_monardes_1574", "name": "herrumbre", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["herrumbre", "Herrumbre", "herrunybre"], "contexts": ["disease affecting iron, also called Orin", "rust of Iron and its scale"]}, {"entity_id": "hermeja", "book_id": "relation_historique_humboldt_vol3_1825", "name": "hermeja", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["hermeja"], "contexts": ["synonym for terre rouge"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "herrumbre", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "hermeja", "similarity": 0.869}], "id": 1118, "stable_key": "clu_df4ca86cd627843c", "ground_truth": {"modern_name": "rust", "confidence": "high", "type": "substance", "description": "Oxidation product of iron, often reddish-brown.", "note": "Refers to iron oxide, the corrosion product of iron.", "wikipedia_extract": "Rust is an iron oxide, a usually reddish-brown oxide formed by the reaction of iron and oxygen in the catalytic presence of water or air moisture. Rust consists of hydrous iron(III) oxides (Fe2O3·nH2O) and iron(III) oxide-hydroxide (FeO(OH), Fe(OH)3), and is typically associated with the corrosion of refined iron. Given sufficient time, any iron mass in the presence of water and oxygen will form rust and could eventually convert entirely to rust. Surface rust is commonly flaky and friable, and provides no passivational protection to the underlying iron unlike other metals such as aluminum, copper, and tin which form stable oxide layers. Rusting is the common term for corrosion of elemental iron and its alloys such as steel. Many other metals undergo similar corrosion, but the resulting oxides are not commonly called \"rust\"."}}, {"canonical_name": "Carapo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "carapo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Carapo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Carapo", "Carare"], "contexts": ["geographic location", "region associated with Varinagotos"]}, {"entity_id": "carapatam", "book_id": "coloquios_da_orta_1563", "name": "Carapatam", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Carapatam"], "contexts": ["location on route to Goa"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Carapo", "target_book": "coloquios_da_orta_1563", "target_name": "Carapatam", "similarity": 0.879}], "id": 1119, "stable_key": "clu_60af5c216c92103b", "ground_truth": {"modern_name": "Carapo", "confidence": "high", "type": "place", "description": "Geographic region in Venezuela, associated with indigenous groups.", "note": "Likely a specific indigenous place name in South America.", "wikipedia_extract": "The banded knifefish (Gymnotus carapo) is a species of gymniform knifefish native to a wide range of freshwater habitats in South America. It is the most widespread species of Gymnotus, but it has frequently been confused with several relatives, including some found outside its range like the Central America G. maculosus. The English name \"banded knifefish\" is sometimes used for the entire genus Gymnotus instead of only the species G. carapo. This South American fish is found in the Amazon, Orinoco and Río de la Plata basins, as well as rivers in the Guianas, northeastern Brazil (only those exiting along the country's northern coast, such as Parnaíba) and northern Argentina (south to the 36th parallel south), and in Trinidad. This makes it the most widespread species of Gymnotus. G. carapo occurs in virtually any freshwater habitat in its range, such as rivers and streams (both slow- and fast-flowing), floodplains, estuaries, swamps and lakes."}}, {"canonical_name": "Companhia de Jesus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "companhia_de_jesus", "book_id": "coloquios_da_orta_1563", "name": "Companhia de Jesus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Companhia de Jesus", "companhia de Jesus"], "contexts": ["religious order", "religious order involved in pearl fishery"]}, {"entity_id": "compania_de_jésus", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Compania de Jésus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Compania de Jésus"], "contexts": ["religious order"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Companhia de Jesus", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Compania de Jésus", "similarity": 0.977}], "id": 1120, "stable_key": "clu_52e9d2809824ed61", "ground_truth": {"modern_name": "Society of Jesus", "confidence": "high", "type": "concept", "description": "A Catholic religious order of pontifical right.", "note": "Also known as the Jesuits.", "wikipedia_extract": "The Society of Jesus (Latin: Societas Iesu; abbreviation: S.J. or SJ), also known as the Jesuit Order or the Jesuits ( JEZH-oo-its, JEZ-ew-; Latin: Iesuitae), is a religious order of clerics regular of pontifical right for men in the Catholic Church. Headquartered in Rome, it was founded in 1540 by Ignatius of Loyola and six companions, with the approval of Pope Paul III. The Society of Jesus is the largest Catholic religious order and has played a significant role in education, charity, humanitarian acts and global policies. Jesuits are engaged in evangelization and apostolic ministry in 112 countries, including education, research, and cultural pursuits. They also conduct retreats, minister in hospitals and parishes, sponsor direct social and humanitarian works, and promote ecumenical dialogue. The Society of Jesus is consecrated under the patronage of Madonna della Strada, a title of the Blessed Virgin Mary, and it is led by a superior general."}}, {"canonical_name": "San Pablo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "san_pablo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "San Pablo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["San Pablo"], "contexts": ["location in Colombia", "location on Rio San Juan"]}, {"entity_id": "saó_paulo", "book_id": "polyanthea_medicinal", "name": "Saó Paulo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Saó Paulo"], "contexts": ["neighborhood where Domingos Clemente lived"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "San Pablo", "target_book": "polyanthea_medicinal", "target_name": "Saó Paulo", "similarity": 0.893}], "id": 1121, "stable_key": "clu_1c6d4d539288ba55", "ground_truth": {"modern_name": "San Pablo", "confidence": "high", "type": "place", "description": "Place name, potentially referring to a settlement or region.", "note": "Could refer to various places named after Saint Paul.", "wikipedia_extract": "San Pablo, officially the City of San Pablo (Filipino: Lungsod ng San Pablo), is a  component city in the province of Laguna, Philippines. According to the 2024 census, it has a population of 300,166 people. The city is also known as the \"City of Seven Lakes\" (Filipino: Lungsod ng Pitong Lawa), referring to the Seven Lakes of San Pablo: Lake Sampaloc (or Sampalok), Lake Palakpakin, Lake Bunot, Lakes Pandin and Yambo, Lake Muhikap, and Lake Calibato. San Pablo was part of the Roman Catholic Archdiocese of Lipa beginning in 1910. On November 28, 1967, it became an independent diocese and became the Roman Catholic Diocese of San Pablo. San Pablo is derived from the Spanish for Saint Paul, referring to the local patron saint, Paul the First Hermit."}}, {"canonical_name": "Gulf-stream", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "gulf-stream", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Gulf-stream", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Gulf-stream", "GulJ-stream", "Gulf-siream"], "contexts": ["warm waters influencing climate", "ocean current with variable direction"]}, {"entity_id": "gulf-stream", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Gulf-stream", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Gulf-stream"], "contexts": ["warm ocean current in the Atlantic"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Gulf-stream", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Gulf-stream", "similarity": 1.0}], "id": 1122, "stable_key": "clu_cc078f1f8673d5e7", "ground_truth": {"modern_name": "Gulf Stream", "confidence": "high", "type": "concept", "wikidata_id": "Q34771011", "wikidata_description": "river in Somerset County, Maine, United States of America", "wikipedia_extract": "The Gulf Stream is a warm and swift Atlantic ocean current that originates in the Gulf of Mexico and flows through the Straits of Florida and up the eastern coastline of the United States, then veers east near 36°N latitude  (North Carolina) and moves toward Northwest Europe as the North Atlantic Current. The process of western intensification causes the Gulf Stream to be a northward-accelerating current off the east coast of North America. Around 40°0′N 30°0′W, it splits in two, with the northern stream, the North Atlantic Drift, crossing to Northern Europe and the southern stream, the Canary Current, recirculating off West Africa. The Gulf Stream influences the climate of the coastal areas of the East Coast of the United States from Florida to southeast Virginia (near 36°N latitude), and to a greater degree, the climate of Northwest Europe. A consensus exists that the climate of Northwest Europe is warmer than other areas of similar latitude at least partially because of the strong North Atlantic Current. It is part of the North Atlantic Gyre."}}, {"canonical_name": "plaines", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "plaines", "book_id": "relation_historique_humboldt_vol3_1825", "name": "plaines", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["plaines", "Plaines"], "contexts": ["flat areas of land", "flat, low-lying land"]}, {"entity_id": "plains", "book_id": "connexion_physical_sciences_somerville_1858", "name": "plains", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["plains"], "contexts": ["large areas of flat land", "flat, open land areas"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "plaines", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "plains", "similarity": 0.99}], "id": 1123, "stable_key": "clu_644bc5d3ae26215b", "ground_truth": {"modern_name": "plains", "confidence": "high", "type": "concept", "wikidata_id": "Q160091", "wikidata_description": "flat geographic region"}}, {"canonical_name": "baie de Hudson", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "baie_de_hudson", "book_id": "relation_historique_humboldt_vol3_1825", "name": "baie de Hudson", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["baie de Hudson"], "contexts": ["bay", "body of water"]}, {"entity_id": "hudson’s_bay", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Hudson’s Bay", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Hudson’s Bay"], "contexts": ["bay where tides are perceptible", "location with tidal phenomena"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "baie de Hudson", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Hudson’s Bay", "similarity": 0.92}], "id": 1124, "stable_key": "clu_db1ec94d71baefbf", "ground_truth": {"modern_name": "Hudson Bay", "confidence": "high", "type": "place", "country": "Canada", "wikidata_id": "Q322145", "wikidata_description": "species of North American mammal", "wikipedia_extract": "Hudson Bay, sometimes called Hudson's Bay (usually historically), is a large body of saltwater in northeastern Canada with a surface area of 1,230,000 km2 (470,000 sq mi). It is located north of Ontario, west of Quebec, northeast of Manitoba, and southeast of Nunavut, but politically entirely part of Nunavut. It is an inland marginal sea of the Arctic Ocean. The Hudson Strait provides a connection to the Labrador Sea and the Atlantic Ocean in the northeast, while the Foxe Channel connects Hudson Bay with the Arctic Ocean in the north. The Hudson Bay drainage basin drains a very large area, about 3,861,400 km2 (1,490,900 sq mi), that includes parts of southeastern Nunavut, Alberta, Saskatchewan, Ontario, Quebec, all of Manitoba, and parts of the U.S. states of North Dakota, South Dakota, Minnesota, and Montana. Hudson Bay's southern arm is called James Bay."}}, {"canonical_name": "Dieppe", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "dieppe", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Dieppe", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Dieppe"], "contexts": ["city near la Chapelle", "city in France"]}, {"entity_id": "dieppe", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Dieppe", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Dieppe"], "contexts": ["visible from Hastings", "city visible in the afternoon"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Dieppe", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Dieppe", "similarity": 1.0}], "id": 1125, "stable_key": "clu_a990e4940cfaa2ec", "ground_truth": {"modern_name": "Dieppe", "confidence": "high", "type": "place", "country": "France", "wikidata_id": "Q264075", "wikidata_description": "city in New Brunswick, Canada"}}, {"canonical_name": "dew", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "dew", "book_id": "connexion_physical_sciences_somerville_1858", "name": "dew", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["Dew", "dew"], "contexts": ["water condensed from air", "condensation of water vapor"]}, {"entity_id": "dew", "book_id": "first_principles_spencer_1862", "name": "dew", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["dew"], "contexts": ["water condensed from the air"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "dew", "target_book": "first_principles_spencer_1862", "target_name": "dew", "similarity": 1.0}], "id": 1126, "stable_key": "clu_abf9c8fc67703848", "ground_truth": {"modern_name": "dew", "confidence": "high", "type": "chemical", "wikidata_id": "Q48183", "wikidata_description": "German-language edition of Wikipedia"}}, {"canonical_name": "Psychrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "psychrometer", "book_id": "kosmos_humboldt_1845", "name": "Psychrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 4, "variants": ["Psychrometer", "psychrometer"], "contexts": ["instrument for measuring atmospheric moisture", "instrument for measuring moisture"]}, {"entity_id": "psychodometer", "book_id": "principles_of_psychology_james_1890", "name": "psychodometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["psychodometer"], "contexts": ["simple time-measuring instrument", "instrument for measuring reaction time"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Psychrometer", "target_book": "principles_of_psychology_james_1890", "target_name": "psychodometer", "similarity": 0.861}], "id": 1127, "stable_key": "clu_b9cfd1b343a22557", "ground_truth": {"modern_name": "Psychrometer", "confidence": "high", "type": "object", "note": "The mention of 'psychodometer' alongside 'psychrometer' suggests a device for measurement, likely atmospheric moisture given common early modern instruments. 'Psychrometer' itself is the direct modern equivalent.", "wikidata_id": "Q26965", "wikidata_description": "device used in meteorology", "wikipedia_url": "https://en.wikipedia.org/wiki/Psychrometer"}}, {"canonical_name": "1843", "category": "OTHER_CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "1843", "book_id": "connexion_physical_sciences_somerville_1858", "name": "1843", "category": "OTHER_CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["1843"], "contexts": ["year of proximity to Jupiter", "year of comet appearance"]}, {"entity_id": "1844", "book_id": "kosmos_humboldt_1845", "name": "1844", "category": "OTHER_CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["1844"], "contexts": ["year of writing"]}, {"entity_id": "1831", "book_id": "kosmos_humboldt_1845", "name": "1831", "category": "OTHER_CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["1831"], "contexts": ["year of anomalous twilight augmentation"]}, {"entity_id": "1839", "book_id": "kosmos_humboldt_1845", "name": "1839", "category": "OTHER_CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["1839"], "contexts": ["publication year of Darwin's journal"]}, {"entity_id": "july,_1843", "book_id": "kosmos_humboldt_1845", "name": "July, 1843", "category": "OTHER_CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["July, 1843"], "contexts": ["date of publication"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "1843", "target_book": "kosmos_humboldt_1845", "target_name": "1844", "similarity": 0.912}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "1843", "target_book": "kosmos_humboldt_1845", "target_name": "1831", "similarity": 0.846}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "1843", "target_book": "kosmos_humboldt_1845", "target_name": "1839", "similarity": 0.873}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "1843", "target_book": "kosmos_humboldt_1845", "target_name": "July, 1843", "similarity": 0.861}], "id": 1128, "stable_key": "clu_276e5d61d05cf713", "ground_truth": {"modern_name": "Years", "confidence": "high", "type": "concept", "note": "This cluster represents specific years mentioned in the texts, serving as temporal markers for events or periods of observation.", "wikidata_id": "Q577", "wikidata_description": "the orbital period of the Earth: the estimated period of time for the Earth's orbit around the Sun and observed at a fixed geographic point (averaging 365.24 days); base later modified to define or adjust various calendars", "wikipedia_url": "https://en.wikipedia.org/wiki/Year", "wikipedia_extract": "A year is a unit of time based on how long it takes the Earth to orbit the Sun. In scientific use, the tropical year (approximately 365 solar days, 5 hours, 48 minutes, 45 seconds) and the sidereal year (about 20 minutes longer) are more exact. The modern calendar year, as reckoned according to the Gregorian calendar, approximates the tropical year by using a system of leap years. The term 'year' is also used to indicate other periods of roughly similar duration, such as the lunar year (a roughly 354-day cycle of twelve of the Moon's phases – see lunar calendar), as well as periods loosely associated with the calendar or astronomical year, such as the seasonal year, the fiscal year, the academic year, etc. Due to the Earth's axial tilt, the course of a year sees the passing of the seasons, marked by changes in weather, the hours of daylight, and, consequently, vegetation and soil fertility. In temperate and subpolar regions around the planet, four seasons are generally recognized: spring, summer, autumn, and winter."}}, {"canonical_name": "Greek", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "greek", "book_id": "principles_of_psychology_james_1890", "name": "Greek", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["Greek"], "contexts": ["language and culture of ancient Greece", "ancient language and culture"]}, {"entity_id": "greca", "book_id": "ricettario_fiorentino_1597", "name": "Greca", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Greca"], "contexts": ["Greek pitch"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Greek", "target_book": "ricettario_fiorentino_1597", "target_name": "Greca", "similarity": 0.932}], "id": 1129, "stable_key": "clu_91f198a6aa49c9bd", "ground_truth": {"modern_name": "Greek", "confidence": "high", "type": "concept", "description": "Relating to the language, culture, or pitch of ancient Greece.", "note": "Refers to the language and culture of ancient Greece, and Greek pitch.", "wikipedia_extract": "Ancient Greek (Ἑλληνική, Hellēnikḗ [hellɛːnikɛ́ː]) includes the forms of the Greek language used in ancient Greece and the ancient world from around 1500 BC to 300 BC. It is often roughly divided into the following periods: Mycenaean Greek (c. 1400 – c. 1200 BC), Dark Ages (c. 1200 – c. 800 BC), the Archaic or Homeric period (c. 800 – c. 500 BC), and the Classical period (c. 500 – c. 300 BC). Ancient Greek was the language of Homer and of fifth-century Athenian historians, playwrights, and philosophers. It has contributed many words to English vocabulary and has been a standard subject of study in educational institutions of the Western world since the Renaissance. This article primarily contains information about the Epic and Classical periods of the language, which are the best-attested periods and considered most typical of Ancient Greek. From the Hellenistic period (c. 300 BC), Ancient Greek was followed by Koine Greek, which is regarded as a separate historical stage, though its earliest form closely resembles Attic Greek, and its latest form approaches Medieval Greek, and Koine may be classified as Ancient Greek in a wider sense – being an ancient rather than medieval form of Greek, though over the centuries increasingly resembling Medieval and Modern Greek."}}, {"canonical_name": "Coma", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "coma", "book_id": "polyanthea_medicinal", "name": "Coma", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["Coma", "Coma fomnolento", "Coma vigil"], "contexts": ["a type of harmful sleep", "a state of prolonged sleep or lethargy"]}, {"entity_id": "coma", "book_id": "principles_of_psychology_james_1890", "name": "coma", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["coma"], "contexts": ["prolonged state of unconsciousness"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Coma", "target_book": "principles_of_psychology_james_1890", "target_name": "coma", "similarity": 0.843}], "id": 1130, "stable_key": "clu_138a89644eb67b6c", "ground_truth": {"modern_name": "Coma", "confidence": "high", "type": "disease", "description": "A state of prolonged, unnatural sleep or unconsciousness.", "note": "A medical condition characterized by deep unconsciousness.", "wikipedia_extract": "A coma is a prolonged state of deep unconsciousness in which a person cannot be awakened, fails to respond normally to painful stimuli, light, or sound, lacks a normal sleep-wake cycle and does not initiate voluntary actions. The person may experience respiratory and circulatory problems due to the body's inability to maintain normal bodily functions. People in a coma often require extensive medical care to maintain their health and prevent complications such as pneumonia or blood clots. Coma patients exhibit a complete absence of wakefulness and are unable to consciously feel, speak or move. Comas can be the result of natural causes, or can be medically induced, for example, during general anesthesia. Clinically, a coma can be defined as the consistent inability to follow a one-step command."}}, {"canonical_name": "grief", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "grief", "book_id": "first_principles_spencer_1862", "name": "grief", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["grief"], "contexts": ["deep sorrow", "intense sorrow"]}, {"entity_id": "sorrow", "book_id": "principles_of_psychology_james_1890", "name": "sorrow", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["sorrow"], "contexts": ["inward emotional state", "broad genus of æsthetic feeling"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "grief", "target_book": "principles_of_psychology_james_1890", "target_name": "sorrow", "similarity": 0.901}], "id": 1131, "stable_key": "clu_115610c837cc313b", "ground_truth": {"modern_name": "Grief", "confidence": "high", "type": "concept", "note": "Directly refers to the emotional state of sorrow or deep sadness.", "wikidata_id": "Q1026040", "wikidata_description": "reaction to loss of someone or something close or important", "wikipedia_url": "https://en.wikipedia.org/wiki/Grief", "wikipedia_extract": "Grief is the response to the loss of something deemed important, in particular the death of a person or animal to which a bond or affection was formed. Although conventionally focused on the emotional response to loss, grief also has physical, cognitive, behavioral, social, cultural, spiritual, political and philosophical dimensions. While the terms are often used interchangeably, bereavement refers to the state of loss, while grief is the reaction to that loss. The grief associated with death is familiar to most people, but individuals grieve in connection with a variety of losses throughout their lives, such as unemployment, ill health or the end of a relationship. Loss can be categorized as either physical or abstract; physical loss is related to something that the individual can touch or measure, such as losing a spouse through death, while other types of loss are more abstract, possibly relating to aspects of a person's social interactions. Modern research has moved beyond rigid stage-based models, such as Kübler-Ross's five stages, toward more flexible frameworks."}}, {"canonical_name": "The Principles of Psychology", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "the_principles_of_psychology", "book_id": "first_principles_spencer_1862", "name": "The Principles of Psychology", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 3, "variants": ["The Principles of Psychology"], "contexts": ["book by Herbert Spencer", "title of a major work on psychology"]}, {"entity_id": "lehrbuch_der_psychologie", "book_id": "principles_of_psychology_james_1890", "name": "Lehrbuch der Psychologie", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Lehrbuch der Psychologie"], "contexts": ["title of psychology textbook"]}, {"entity_id": "lehrbuch_d__psychologie", "book_id": "principles_of_psychology_james_1890", "name": "Lehrbuch d. Psychologie", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Lehrbuch d. Psychologie"], "contexts": ["psychology textbook title"]}, {"entity_id": "system_of_psychology", "book_id": "principles_of_psychology_james_1890", "name": "System of Psychology", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["System of Psychology"], "contexts": ["book published in 1884"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "The Principles of Psychology", "target_book": "principles_of_psychology_james_1890", "target_name": "Lehrbuch der Psychologie", "similarity": 0.867}, {"source_book": "first_principles_spencer_1862", "source_name": "The Principles of Psychology", "target_book": "principles_of_psychology_james_1890", "target_name": "Lehrbuch d. Psychologie", "similarity": 0.856}, {"source_book": "first_principles_spencer_1862", "source_name": "The Principles of Psychology", "target_book": "principles_of_psychology_james_1890", "target_name": "System of Psychology", "similarity": 0.843}], "id": 1132, "stable_key": "clu_06496406f2561146", "ground_truth": {"modern_name": "The Principles of Psychology", "confidence": "high", "type": "text", "note": "Explicitly named as a book title. 'Lehrbuch der Psychologie' is the German equivalent, and 'System of Psychology' is a closely related phrasing.", "wikidata_id": "Q106624953", "wikidata_description": "1909 German translation of James' textbook", "wikipedia_extract": "The Principles of Psychology is an 1890 book about psychology by William James, an American philosopher and psychologist who trained to be a physician before going into psychology. The four key concepts in James' book are: stream of consciousness (his most famous psychological metaphor); emotion (later known as the James–Lange theory); habit (human habits are constantly formed to achieve certain results); and will (through James' personal experiences in life). The openings of The Principles of Psychology presented what was known at the time of writing about the localization of functions in the brain: how each sense seemed to have a neural center to which it reported and how varied bodily motions have their sources in other centers. The particular hypotheses and observations on which James relied are now very dated, but the broadest conclusion to which his material leads is still valid, which was that the functions of the \"lower centers\" (beneath the cerebrum) become increasingly specialized as one moves from reptiles, through ever more intelligent mammals, to humans while the functions of the cerebrum itself become increasingly flexible and less localized as one moves along the same continuum. James also discussed experiments on illusions (optical, auditory, etc.) and offered a physiological explanation for many of them, including that \"the brain reacts by paths which previous experiences have worn, and makes us usually perceive the probable thing, i.e. the thing by which on previous occasions the reaction was most frequently aroused.\" Illusions are thus a special case of the phenomenon of habit.", "wikipedia_url": "https://en.wikipedia.org/wiki/The_Principles_of_Psychology"}}, {"canonical_name": "Bab el-Mandeb", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "bab_el-mandeb", "book_id": "coloquios_da_orta_1563", "name": "Bab el-Mandeb", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Bab el-Mandeb"], "contexts": ["landmark on the African coast", "geographic location on the African coast"]}, {"entity_id": "straits_of_bab-el-mandeb", "book_id": "kosmos_humboldt_1845", "name": "Straits of Bab-el-Mandeb", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Straits of Bab-el-Mandeb"], "contexts": ["strait near Socotora", "strait with water ingress/egress phenomenon"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Bab el-Mandeb", "target_book": "kosmos_humboldt_1845", "target_name": "Straits of Bab-el-Mandeb", "similarity": 0.915}], "id": 1133, "stable_key": "clu_1dcf2ca5a3048785", "ground_truth": {"modern_name": "Bab-el-Mandeb", "confidence": "high", "type": "place", "country": "Yemen, Djibouti, Eritrea", "note": "Direct geographic reference to a strait. 'Straits of Bab-el-Mandeb' is a more formal but equivalent name.", "wikidata_id": "Q83318", "wikidata_description": "strait located between Yemen on the Arabian Peninsula, and Djibouti and Eritrea in the Horn of Africa"}}, {"canonical_name": "Volterrano", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "volterrano", "book_id": "ricettario_fiorentino_1597", "name": "Volterrano", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Volterrano"], "contexts": ["location of alum sources", "region where lapis LAZZOLI is found"]}, {"entity_id": "volterra", "book_id": "kosmos_humboldt_1845", "name": "Volterra", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Volterra"], "contexts": ["city in Tuscany"]}, {"entity_id": "volterra", "book_id": "ricettario_fiorentino_1597", "name": "Volterra", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Volterra"], "contexts": ["lagoons of"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Volterrano", "target_book": "kosmos_humboldt_1845", "target_name": "Volterra", "similarity": 0.817}, {"source_book": "kosmos_humboldt_1845", "source_name": "Volterra", "target_book": "ricettario_fiorentino_1597", "target_name": "Volterra", "similarity": 1.0}], "id": 1134, "stable_key": "clu_a09d40305356962e", "ground_truth": {"modern_name": "Volterra", "confidence": "high", "type": "place", "country": "Italy", "note": "Both 'Volterrano' and 'Volterra' refer to the city of Volterra in Tuscany, Italy, known for its alum deposits.", "wikidata_id": "Q99912419", "wikidata_description": "family name", "wikipedia_extract": "Volterrano Volterrani (5 October 1891 – 15 March 1963) was an Italian sculptor. His work was part of the sculpture event in the art competition at the 1936 Summer Olympics.", "wikipedia_url": "https://en.wikipedia.org/wiki/Volterrano_Volterrani"}}, {"canonical_name": "Bonn", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "bonn", "book_id": "kosmos_humboldt_1845", "name": "Bonn", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Bonn"], "contexts": ["location of tree trunk find", "city in Germany"]}, {"entity_id": "bonn", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bonn", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Bonn"], "contexts": ["city where Professor Helmholtz was", "German city, location of university"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Bonn", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bonn", "similarity": 1.0}], "id": 1135, "stable_key": "clu_0b9096ba5d56ff56", "ground_truth": {"modern_name": "Bonn", "confidence": "high", "type": "place", "country": "Germany", "note": "Directly refers to the city of Bonn in Germany.", "wikipedia_extract": "The University of Bonn, officially the Rhenish Friedrich Wilhelm University of Bonn (German: Rheinische Friedrich-Wilhelms-Universität Bonn), is a public research university in Bonn, North Rhine-Westphalia, Germany. It was founded in its present form as the Rhein-Universität (English: Rhine University) on 18 October 1818 by Frederick William III, as the linear successor of the Kurkölnische Akademie Bonn (English: Academy of the Prince-elector of Cologne) which was founded in 1777. The University of Bonn offers many undergraduate and graduate programs in a range of subjects and has 544 professors. The University of Bonn is a member of the German U15 association of major research-intensive universities in Germany and has the title of \"University of Excellence\" under the German Universities Excellence Initiative. Bonn has 8 Clusters of Excellence, the most of any German university; the Hausdorff Center for Mathematics, the Matter and Light for Quantum Computing cluster, Bonn Center for Dependency and Slavery Studies,  PhenoRob: Research for the Future of Crop Production, the Immune Sensory System cluster, ECONtribute: Markets and Public Policy, Color meets Flavor and Our Dynamic Universe. The University and State Library Bonn (ULB Bonn) is the central university and archive library of the Rheinische Friedrich-Wilhelms-Universität Bonn and North Rhine-Westphalia; it holds more than five million volumes.", "wikipedia_url": "https://en.wikipedia.org/wiki/University_of_Bonn"}}, {"canonical_name": "Melville Island", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "melville_island", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Melville Island", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Melville Island"], "contexts": ["island in the Arctic Archipelago", "island with extreme cold in 1820"]}, {"entity_id": "melville_island", "book_id": "kosmos_humboldt_1845", "name": "Melville Island", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Melville Island"], "contexts": ["location of magnetic north pole", "location of Parry's observations"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Melville Island", "target_book": "kosmos_humboldt_1845", "target_name": "Melville Island", "similarity": 1.0}], "id": 1136, "stable_key": "clu_1d4f3c3a9b95be2d", "ground_truth": {"modern_name": "Melville Island", "confidence": "high", "type": "place", "country": "Canada", "note": "Direct reference to a specific island in the Arctic Archipelago.", "wikidata_id": "Q22494472", "wikidata_description": "island in North Coast Regional District, British Columbia, Canada"}}, {"canonical_name": "1811", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "1811", "book_id": "connexion_physical_sciences_somerville_1858", "name": "1811", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 5, "variants": ["1811"], "contexts": ["year of great comet", "year of comet observation"]}, {"entity_id": "1832", "book_id": "kosmos_humboldt_1845", "name": "1832", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["1832"], "contexts": ["year of 'Annuaire' publication"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "1811", "target_book": "kosmos_humboldt_1845", "target_name": "1832", "similarity": 0.845}], "id": 1137, "stable_key": "clu_d56285e3f812b9bc", "ground_truth": {"modern_name": "Year", "confidence": "high", "type": "concept", "note": "The numbers refer to years, and in the context of scientific texts, they represent specific points in time, often associated with events like astronomical observations or publications.", "wikidata_id": "Q577", "wikidata_description": "the orbital period of the Earth: the estimated period of time for the Earth's orbit around the Sun and observed at a fixed geographic point (averaging 365.24 days); base later modified to define or adjust various calendars", "wikipedia_url": "https://en.wikipedia.org/wiki/Year", "wikipedia_extract": "A year is a unit of time based on how long it takes the Earth to orbit the Sun. In scientific use, the tropical year (approximately 365 solar days, 5 hours, 48 minutes, 45 seconds) and the sidereal year (about 20 minutes longer) are more exact. The modern calendar year, as reckoned according to the Gregorian calendar, approximates the tropical year by using a system of leap years. The term 'year' is also used to indicate other periods of roughly similar duration, such as the lunar year (a roughly 354-day cycle of twelve of the Moon's phases – see lunar calendar), as well as periods loosely associated with the calendar or astronomical year, such as the seasonal year, the fiscal year, the academic year, etc. Due to the Earth's axial tilt, the course of a year sees the passing of the seasons, marked by changes in weather, the hours of daylight, and, consequently, vegetation and soil fertility. In temperate and subpolar regions around the planet, four seasons are generally recognized: spring, summer, autumn, and winter."}}, {"canonical_name": "Pisces", "category": "OTHER_PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "pisces", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Pisces", "category": "OTHER_PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Pisces"], "contexts": ["constellation through which circle would pass", "constellation with nebulous region"]}, {"entity_id": "pisces_boreales", "book_id": "kosmos_humboldt_1845", "name": "Pisces Boreales", "category": "OTHER_PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Pisces Boreales"], "contexts": ["region in the heavens"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Pisces", "target_book": "kosmos_humboldt_1845", "target_name": "Pisces Boreales", "similarity": 0.878}], "id": 1138, "stable_key": "clu_98cd7cb4ba0eb976", "ground_truth": {"modern_name": "Pisces", "confidence": "high", "type": "concept", "note": "While Pisces is a constellation, in astronomical contexts it refers to a region of the sky, not a physical place as such. 'Pisces Boreales' likely refers to a specific part of that constellation."}}, {"canonical_name": "declination", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "declination", "book_id": "connexion_physical_sciences_somerville_1858", "name": "declination", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 4, "variants": ["declination"], "contexts": ["angular distance north or south of celestial equator", "angle between magnetic and true north"]}, {"entity_id": "declivities", "book_id": "kosmos_humboldt_1845", "name": "declivities", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["declivities"], "contexts": ["sloping sides of mountains"]}, {"entity_id": "declinations", "book_id": "connexion_physical_sciences_somerville_1858", "name": "declinations", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["declinations"], "contexts": ["angular distance north or south of celestial equator"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "declination", "target_book": "kosmos_humboldt_1845", "target_name": "declivities", "similarity": 0.855}, {"source_book": "kosmos_humboldt_1845", "source_name": "declivities", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "declinations", "similarity": 0.859}], "id": 1139, "stable_key": "clu_838d10e9b824e5d2", "ground_truth": {"modern_name": "Declination", "confidence": "high", "type": "concept", "note": "In astronomy, 'declination' refers to the angular distance of a celestial body north or south of the celestial equator. The mention of 'declivities' in relation to mountains suggests a broader meaning of sloping sides, but the primary astronomical context is clear.", "wikipedia_extract": "Magnetic declination (also called magnetic variation) is the angle between magnetic north and true north at a particular location on the Earth's surface. The angle can change over time due to polar wandering. Magnetic north is the direction that the north end of a magnetized compass needle points, which corresponds to the direction of the Earth's magnetic field lines. True north is the direction along a meridian towards the geographic North Pole. Somewhat more formally, Bowditch defines variation as \"the angle between the magnetic and geographic meridians at any place, expressed in degrees and minutes east or west to indicate the direction of magnetic north from true north. The angle between magnetic and grid meridians is called grid magnetic angle, grid variation, or grivation.\" By convention, declination is positive when magnetic north is east of true north, and negative when it is to the west.", "wikipedia_url": "https://en.wikipedia.org/wiki/Magnetic_declination"}}, {"canonical_name": "Eſpinal Medulla", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "eſpinal_medulla", "book_id": "polyanthea_medicinal", "name": "Eſpinal Medulla", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["Eſpinal Medulla", "eſpinal medulla"], "contexts": ["spinal cord", "part of the nervous system connected to uterus"]}, {"entity_id": "medulla", "book_id": "coloquios_da_orta_1563", "name": "medulla", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["medulla"], "contexts": ["inner part of a plant", "part of the trunk observed"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Eſpinal Medulla", "target_book": "coloquios_da_orta_1563", "target_name": "medulla", "similarity": 0.846}], "id": 1140, "stable_key": "clu_1cda65df20bb639c", "ground_truth": {"modern_name": "Spinal Cord", "confidence": "high", "type": "substance", "description": "The central nerve pathway connecting the brain to the body.", "note": "Refers to the spinal cord and the inner part of a plant stem.", "wikipedia_extract": "The spinal cord is a long, thin, tubular structure made up of nervous tissue that extends from the medulla oblongata in the lower brainstem to the lumbar region of the vertebral column (backbone) of vertebrate animals. The center of the spinal cord is hollow and contains a structure called the central canal, which contains cerebrospinal fluid. The spinal cord is also covered by the meninges and enclosed by the neural arches. Together, the brain and spinal cord make up the central nervous system. In humans, the spinal cord is a continuation of the brainstem and anatomically begins at the occipital bone, passing out of the foramen magnum and then enters the spinal canal at the beginning of the cervical vertebrae. The spinal cord extends down to between the first and second lumbar vertebrae, where it tapers to become the cauda equina."}}, {"canonical_name": "Levante", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "levante", "book_id": "historia_medicinal_monardes_1574", "name": "Levante", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Levante"], "contexts": ["region from which Cañafistola used to come", "origin of Ruybarbo"]}, {"entity_id": "levante", "book_id": "ricettario_fiorentino_1597", "name": "Levante", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Levante"], "contexts": ["region producing good musk", "Eastern Mediterranean region"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Levante", "target_book": "ricettario_fiorentino_1597", "target_name": "Levante", "similarity": 1.0}], "id": 1141, "stable_key": "clu_9e23489407850742", "ground_truth": {"modern_name": "Levant", "confidence": "high", "type": "place", "description": "A region in the Eastern Mediterranean or its origin of goods.", "note": "Refers to the Eastern Mediterranean region and its products.", "wikipedia_extract": "The Levant is a subregion of West Asia along the Eastern Mediterranean, that forms part of the Middle East. The term is often used in conjunction with historical or cultural references. In its narrowest sense, used in archaeology and other contexts, the Levant refers to Cyprus and land bordering the Mediterranean Sea in West Asia that includes the Syria region, Lebanon, Jordan, Palestine, Israel, and south Cilicia (Turkey). In its widest historical sense, the Levant included all the Eastern Mediterranean; extending from Greece to Egypt and Cyrenaica (Eastern Libya). The Levant represents the land bridge between Africa and Eurasia, has been described as the crossroads of West Asia, Eastern Mediterranean, and Northeast Africa, and geologically as the \"northwest of the Arabian plate\". In the 13th and 14th centuries, levante was used for Italian maritime commerce in the Eastern Mediterranean, including Greece, Anatolia, Syria-Palestine, and Egypt, that is the lands east of Venice."}}, {"canonical_name": "corado", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "corado", "book_id": "polyanthea_medicinal", "name": "corado", "category": "CONCEPT", "subcategory": "QUALITY", "count": 5, "variants": ["corado", "coradas", "còrado"], "contexts": ["reddish complexion", "colored, ruddy, a quality of a person"]}, {"entity_id": "cator", "book_id": "historia_medicinal_monardes_1574", "name": "cator", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["cator"], "contexts": ["with little heat"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "corado", "target_book": "historia_medicinal_monardes_1574", "target_name": "cator", "similarity": 0.841}], "id": 1142, "stable_key": "clu_9bbb71912e0ccdec", "ground_truth": {"modern_name": "Ruddy Complexion", "confidence": "high", "type": "concept", "description": "A reddish or healthy-looking complexion; also relating to heat.", "note": "Describes a color quality, specifically reddish, and heat.", "wikipedia_extract": "Complexion (less commonly spelled complection) in humans is the natural color, texture, and appearance of the skin, especially on the face. The word \"complexion\" is derived from the Late Latin complexi, which initially referred in general terms to a combination of things, and later in physiological terms, to the balance of humors. The four humours were four fluids that were thought to permeate the body and influence its health. The concept was developed by ancient Greek thinkers around 400 BC and developed further by Galen. People were thought to be either of the four temperaments: choleric, melancholic, phlegmatic, or sanguine. During the Middle Ages in Europe, the Latin term complexio served as the translated form of the Greek word crasis, meaning temperament."}}, {"canonical_name": "Antonio Bafio", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "antonio_bafio", "book_id": "polyanthea_medicinal", "name": "Antonio Bafio", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Antonio Bafio", "Antonio Basio"], "contexts": ["author of Florida Corona", "mentioned in relation to medical advice"]}, {"entity_id": "antonio_buf", "book_id": "historia_medicinal_monardes_1574", "name": "Antonio Buf", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Antonio Buf"], "contexts": ["learned physician of Ferrara"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Antonio Bafio", "target_book": "historia_medicinal_monardes_1574", "target_name": "Antonio Buf", "similarity": 0.873}], "id": 1143, "stable_key": "clu_5d0c9704c7bae1a6", "ground_truth": {"modern_name": "Antonio Bafio", "confidence": "high", "type": "person", "description": "Italian physician and author known for medical writings.", "note": "The variation 'Antonio Buf' is likely a misspelling or variant transliteration."}}, {"canonical_name": "nacidas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "nacidas", "book_id": "polyanthea_medicinal", "name": "nacidas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["nacidas", "nafcidas"], "contexts": ["swellings on plague victims", "swellings that appear on plague victims"]}, {"entity_id": "naçidos", "book_id": "historia_medicinal_monardes_1574", "name": "naçidos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["naçidos"], "contexts": ["boils"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "nacidas", "target_book": "historia_medicinal_monardes_1574", "target_name": "naçidos", "similarity": 0.845}], "id": 1144, "stable_key": "clu_78449ce3d5652c9c", "ground_truth": {"modern_name": "boils", "confidence": "high", "type": "disease", "description": "Painful, pus-filled lumps on the skin, often associated with infection.", "note": "The terms 'nacidas' and 'naçidos' likely refer to swellings or boils, particularly in the context of plague.", "wikipedia_extract": "A boil, also called a furuncle, is a deep folliculitis, which is an infection of the hair follicle. It is most commonly caused by infection by the bacterium Staphylococcus aureus, resulting in a painful swollen area on the skin caused by an accumulation of pus and dead tissue. Boils are therefore basically pus-filled nodules. Individual boils clustered together are called carbuncles. Most human infections are caused by coagulase-positive S. aureus strains, notable for the bacteria's ability to produce coagulase, an enzyme that can clot blood. Almost any organ system can be infected by S. aureus."}}, {"canonical_name": "droga", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "droga", "book_id": "coloquios_da_orta_1563", "name": "droga", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["droga", "Drogas de las índias"], "contexts": ["benzoin from Siam", "substance that corrupts quickly"]}, {"entity_id": "droghe", "book_id": "ricettario_fiorentino_1597", "name": "Droghe", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Droghe"], "contexts": ["drugs or medicinal substances", "herbs and spices for medicine"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "droga", "target_book": "ricettario_fiorentino_1597", "target_name": "Droghe", "similarity": 0.972}], "id": 1145, "stable_key": "clu_b2b2b0852deb8574", "ground_truth": {"modern_name": "drugs", "confidence": "high", "type": "substance", "description": "Substances, especially medicinal ones, that may be natural or synthetic.", "note": "This term encompasses both medicinal preparations and raw materials like benzoin.", "wikipedia_extract": "A drug is any chemical substance  other than a nutrient or an essential dietary ingredient, which, when administered to a living organism, produces a biological effect. Consumption of drugs can be via inhalation, injection, smoking, ingestion, absorption via a patch on the skin, suppository, or dissolution under the tongue. A pharmaceutical drug, also called a medication or medicine, is a chemical substance used to treat, cure, prevent, or diagnose a disease or to promote well-being. Traditionally drugs were obtained through extraction from medicinal plants, but more recently also by organic synthesis. Pharmaceutical drugs may be used for a limited duration, or on a regular basis for chronic disorders. Pharmaceutical drugs are often classified into drug classes—groups of related drugs that have similar chemical structures, the same mechanism of action (binding to the same biological target), a related mode of action, and that are used to treat the same disease."}}, {"canonical_name": "quercia", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "quercia", "book_id": "ricettario_fiorentino_1597", "name": "quercia", "category": "PLANT", "subcategory": "TREE", "count": 4, "variants": ["quercia", "querce", "quercino"], "contexts": ["example of a tree, oak", "oak tree ingredient"]}, {"entity_id": "quercus", "book_id": "coloquios_da_orta_1563", "name": "Quercus", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Quercus", "Quercus Pérsica"], "contexts": ["genus of oak trees", "oak species producing manna"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "quercia", "target_book": "coloquios_da_orta_1563", "target_name": "Quercus", "similarity": 0.871}], "id": 1146, "stable_key": "clu_650dc89049f43ea5", "ground_truth": {"modern_name": "oak", "confidence": "high", "type": "plant", "linnaean": "Quercus", "family": "Fagaceae", "description": "A large tree known for its wood and acorns, with medicinal uses.", "note": " 'Quercia' is the Italian word for oak, and 'Quercus' is the genus name.", "wikipedia_extract": "An oak is a hardwood tree or shrub in the genus Quercus of the beech family. They have spirally arranged leaves, often with lobed edges, and a nut called an acorn, borne within a cup. The genus is widely distributed in the Northern Hemisphere, with some 500 species, both deciduous and evergreen. Fossil oaks date back to the Middle Eocene. Molecular phylogeny shows that the genus is divided into Old World and New World clades, but many oak species hybridise freely, making the genus's history difficult to resolve. Ecologically, oaks are keystone species in habitats from Mediterranean semi-desert to subtropical rainforest."}}, {"canonical_name": "azeitonas", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "azeitonas", "book_id": "coloquios_da_orta_1563", "name": "azeitonas", "category": "PLANT", "subcategory": "PLANT", "count": 5, "variants": ["azeitonas", "azeitona"], "contexts": ["fruit, comparison", "appetite stimulant"]}, {"entity_id": "azeitonas", "book_id": "polyanthea_medicinal", "name": "azeitonas", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["azeitonas"], "contexts": ["fruit, olives"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "azeitonas", "target_book": "polyanthea_medicinal", "target_name": "azeitonas", "similarity": 1.0}], "id": 1147, "stable_key": "clu_4067f309771d872b", "ground_truth": {"modern_name": "olives", "confidence": "high", "type": "plant", "linnaean": "Olea europaea", "family": "Oleaceae", "description": "The fruit of the olive tree, used for food and oil.", "wikipedia_extract": "The olive (botanical name Olea europaea, \"European olive\") is a species of subtropical evergreen tree in the family Oleaceae. Originating in Asia Minor, it is abundant throughout the Mediterranean Basin, with wild subspecies in Africa and western Asia; modern cultivars are traced primarily to the Near East, Aegean Sea, and Strait of Gibraltar. The olive is the type species for its genus, Olea, and lends its name to the Oleaceae plant family, which includes lilac, jasmine, forsythia, and ash. The olive fruit is classed botanically as a drupe, similar in structure and function to the cherry or peach. The term oil—now used to describe any viscous water-insoluble liquid—was originally synonymous with olive oil, the liquid fat derived from olives. The olive has deep historical, economic, and cultural significance in the Mediterranean."}}, {"canonical_name": "Babylonia", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "babylonia", "book_id": "coloquios_da_orta_1563", "name": "Babylonia", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Babylonia"], "contexts": ["location of mines", "common name for Egypt"]}, {"entity_id": "babylonia", "book_id": "polyanthea_medicinal", "name": "Babylonia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Babylonia"], "contexts": ["location of a plague"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Babylonia", "target_book": "polyanthea_medicinal", "target_name": "Babylonia", "similarity": 1.0}], "id": 1148, "stable_key": "clu_088df849a8e0335e", "ground_truth": {"modern_name": "Babylonia", "confidence": "medium", "type": "place", "description": "Ancient region in Mesopotamia; also a common name for Egypt.", "note": "The context suggests both the historical region of Babylonia and its association with Egypt.", "wikipedia_extract": "Babylonia (; Akkadian: 𒆳𒆍𒀭𒊏𒆠, māt Akkadī) was an ancient Akkadian-speaking state and cultural area based on the city of Babylon in central-southern Mesopotamia (present-day Iraq and parts of Syria). It emerged as an Akkadian-populated but Amorite-ruled state c. 1894 BC. During the reign of Hammurabi and afterwards, Babylonia was retrospectively called \"the country of Akkad\" (māt Akkadī in Akkadian), a deliberate archaism in reference to the previous glory of the Akkadian Empire. It was often involved in rivalry with the linguistically related state of Assyria in Upper Mesopotamia, and with Elam to the east. Babylonia briefly became the major power in the region after Hammurabi (fl. c. 1792–1752 BC middle chronology, or c. 1696–1654 BC, short chronology) created a short-lived empire, succeeding the earlier Akkadian Empire, Third Dynasty of Ur, and Old Assyrian Empire. The Babylonian Empire rapidly fell apart after the death of Hammurabi and reverted to a small kingdom centered around the city of Babylon."}}, {"canonical_name": "xilaloes", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "xilaloes", "book_id": "coloquios_da_orta_1563", "name": "xilaloes", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["xilaloes", "Xílaloes"], "contexts": ["a substance mentioned in a chapter", "Greek name for woody aloes"]}, {"entity_id": "xiloaloes", "book_id": "polyanthea_medicinal", "name": "xiloaloes", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["xiloaloes", "xilo-aloes"], "contexts": ["aloes wood, ingredient in remedy", "ingredient in a medicinal preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "xilaloes", "target_book": "polyanthea_medicinal", "target_name": "xiloaloes", "similarity": 0.933}], "id": 1149, "stable_key": "clu_02ceebb6bfd466fb", "ground_truth": {"modern_name": "aloes wood", "confidence": "high", "type": "plant", "linnaean": "Aquilaria spp.", "family": "Thymelaeaceae", "description": "Aromatic resinous wood used in incense, perfumery, and medicine.", "note": " 'Xilaloes' and 'xiloaloes' are variations of the Greek term for aloes wood.", "wikipedia_extract": "Agarwood, aloeswood, eaglewood, gaharuwood, commonly referred to as oud or oudh (from Arabic: عود, romanized: ʿūd, pronounced [ʕuːd]), is a fragrant, dark and resinous wood used in incense, perfume, and small hand carvings. It forms in the heartwood of Aquilaria trees after they become infected with a type of Phaeoacremonium mold, P. parasitica. The tree defensively secretes a resin to combat the fungal infestation. Prior to becoming infected, the heartwood mostly lacks scent, and is relatively light and pale in colouration. However, as the infection advances and the tree produces its fragrant resin as a final option of defense, the heartwood becomes very dense, dark, and saturated with resin. This product is harvested, and most famously referred to in cosmetics under the scent names of oud, oodh or aguru; however, it is also called aloes (not to be confused with the succulent plant genus Aloe), agar (this name, as well, is not to be confused with the edible, algae-derived thickening agent agar agar), as well as gaharu or jinko."}}, {"canonical_name": "freixo", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "freixo", "book_id": "coloquios_da_orta_1563", "name": "freixo", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["freixo", "freixos"], "contexts": ["tree size comparison", "tree for comparison"]}, {"entity_id": "freixo", "book_id": "polyanthea_medicinal", "name": "freixo", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["freixo"], "contexts": ["plant with virtue against viper venom", "ash, its leaves used as remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "freixo", "target_book": "polyanthea_medicinal", "target_name": "freixo", "similarity": 1.0}], "id": 1150, "stable_key": "clu_8feab11fa5ec1929", "ground_truth": {"modern_name": "ash tree", "confidence": "high", "type": "plant", "linnaean": "Fraxinus spp.", "family": "Oleaceae", "description": "A tree with strong wood, whose leaves have medicinal properties.", "note": " 'Freixo' is the Portuguese and Galician word for ash tree.", "wikipedia_extract": "Fraxinus (), commonly called ash, is a genus of plants in the olive and lilac family, Oleaceae, and comprises 45–65 species of usually medium-to-large trees, most of which are deciduous (dropping their leaves in autumn), although some subtropical species are evergreen. The genus is widespread throughout much of Europe, Asia, and North America. The leaves are usually opposite, and mostly pinnately compound (divided into leaflets in a feather-like arrangement). The seeds, known as \"keys\", are botanically fruits of the type called samara. Some species are dioecious, having male and female flowers on separate plants. Ash wood is strong and elastic, and used for the handles of tools."}}, {"canonical_name": "formiguas", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "formiguas", "book_id": "coloquios_da_orta_1563", "name": "formiguas", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 3, "variants": ["formiguas", "formiga", "formigas"], "contexts": ["large ants that flew and produced lacre", "insect mistaken for the producer of lacca"]}, {"entity_id": "formigas", "book_id": "polyanthea_medicinal", "name": "formigas", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 3, "variants": ["formigas", "formiga"], "contexts": ["ants that eat an egg", "insects used in a preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "formiguas", "target_book": "polyanthea_medicinal", "target_name": "formigas", "similarity": 0.962}], "id": 1151, "stable_key": "clu_4e7dea688d47b5ee", "ground_truth": {"modern_name": "Ants", "confidence": "high", "type": "animal", "description": "Insects, including flying ants and those used in preparations.", "note": "Contexts suggest common ants and possibly specific species known for producing lacre or used medicinally.", "wikipedia_extract": "Ants are eusocial insects of the family Formicidae and, along with the related wasps and bees, belong to the order Hymenoptera. Ants evolved from vespoid wasp ancestors in the Cretaceous period. More than 13,800 of an estimated total of 22,000 species have been classified. They are easily identified by their geniculate (elbowed) antennae and the distinctive node-like structure that forms their slender waists. Ants form colonies that range in size from a few dozen individuals often living in small natural cavities to highly organised colonies that may occupy large territories with a sizeable nest (or nests) that consist of millions of individuals, in some cases they reach hundreds of millions of individuals in super colonies. Typical colonies consist of various castes of sterile, wingless females, most of which are workers (ergates), as well as soldiers (dinergates) and other specialised groups."}}, {"canonical_name": "buxo", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "buxo", "book_id": "coloquios_da_orta_1563", "name": "buxo", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["buxo"], "contexts": ["plant used for comparison of color", "plant resembling the tree"]}, {"entity_id": "buxo", "book_id": "polyanthea_medicinal", "name": "buxo", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["buxo"], "contexts": ["box tree", "elder plant"]}, {"entity_id": "pao_buxo", "book_id": "polyanthea_medicinal", "name": "pao buxo", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["pao buxo"], "contexts": ["box tree wood"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "buxo", "target_book": "polyanthea_medicinal", "target_name": "buxo", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "buxo", "target_book": "polyanthea_medicinal", "target_name": "pao buxo", "similarity": 0.888}], "id": 1152, "stable_key": "clu_d4e4ef3be614be24", "ground_truth": {"modern_name": "Box tree", "confidence": "high", "type": "plant", "linnaean": "Buxus sempervirens", "family": "Buxaceae", "description": "Shrub with evergreen leaves, used for comparison and its wood.", "note": "Mentions of 'elder plant' might indicate a confusion or a less common usage.", "wikipedia_extract": "Buxus sempervirens, the common box, European box, or boxwood, is a species of flowering plant in the genus Buxus, native to western and southern Europe, northwest Africa, and southwest Asia, from southern England south to northern Morocco, and east through the northern Mediterranean region to Turkey. Buxus colchica of western Caucasus and B. hyrcana of northern Iran and eastern Caucasus are commonly treated as synonyms of B. sempervirens. Buxus sempervirens is an evergreen shrub or small tree growing 1 to 9 m (3 to 30 ft) tall, with a trunk up to 20 centimetres (8 in) in diameter (exceptionally to 10 m tall and 45 cm diameter). Arranged in opposite pairs along the stems, the leaves are green to yellow-green, oval, 1.5–3 cm long, and 0.5–1.3 cm broad. The monoecious flowers are inconspicuous but highly scented, greenish-yellow, with no petals, and are insect pollinated; the fruit is a three-lobed capsule containing three to six seeds. The species typically grows on soils derived from chalk, limestone, usually as an understorey in forests of larger trees, most commonly associated with European beech (Fagus sylvatica) forests, but also sometimes in open dry montane scrub, particularly in the Mediterranean region."}}, {"canonical_name": "opiate", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "opiate", "book_id": "polyanthea_medicinal", "name": "opiate", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["opiate", "opiado"], "contexts": ["remedy with narcotic effects", "medicines derived from opium"]}, {"entity_id": "opium_thebaicum", "book_id": "coloquios_da_orta_1563", "name": "opium thebaicum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["opium thebaicum", "opium theòaicum"], "contexts": ["type of opium", "opium from Thebes"]}, {"entity_id": "opion", "book_id": "coloquios_da_orta_1563", "name": "opion", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["opion"], "contexts": ["ancient Greek name for opium"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "opiate", "target_book": "coloquios_da_orta_1563", "target_name": "opium thebaicum", "similarity": 0.844}, {"source_book": "polyanthea_medicinal", "source_name": "opiate", "target_book": "coloquios_da_orta_1563", "target_name": "opion", "similarity": 0.966}], "id": 1153, "stable_key": "clu_dc7a15c828770587", "ground_truth": {"modern_name": "Opium", "confidence": "high", "type": "substance", "description": "Narcotic substance derived from the opium poppy, used medicinally.", "note": "Includes historical names and types of opium.", "wikipedia_extract": "Opium (also known as poppy tears, or Lachryma papaveris) is the dried latex obtained from the seed capsules of the opium poppy Papaver somniferum. Approximately 12 percent of opium is made up of the analgesic alkaloid morphine, which is processed chemically to produce heroin and other synthetic opioids for medicinal use and for the illegal drug trade. Opium's main psychoactive alkaloids, primarily morphine, act on μ-opioid receptors, causing analgesia, with long-term use leading to tolerance and dependence. The latex also contains the closely related opiates codeine and thebaine, and non-analgesic alkaloids such as papaverine and noscapine. The traditional, labor-intensive method of obtaining the latex is to scratch (\"score\") the immature seed pods (fruits) by hand; the latex leaks out and dries to a sticky yellowish residue that is later scraped off and dehydrated. The English word for opium is borrowed from Latin, which in turn comes from Ancient Greek: ὄπιον (ópion), a diminutive of ὀπός (opós, 'juice of a plant')."}}, {"canonical_name": "palhade Meca", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "palhade_meca", "book_id": "polyanthea_medicinal", "name": "palhade Meca", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["palhade Meca", "palha de Meca"], "contexts": ["plant material used in remedy", "herb used in infusion for apozemas"]}, {"entity_id": "palha_de_mequa", "book_id": "coloquios_da_orta_1563", "name": "palha de Mequa", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["palha de Mequa", "palha da Meca"], "contexts": ["name for the plant in Portuguese", "straw from Mecca"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "palhade Meca", "target_book": "coloquios_da_orta_1563", "target_name": "palha de Mequa", "similarity": 0.85}], "id": 1154, "stable_key": "clu_65b7b5bd3a92ea54", "ground_truth": {"modern_name": "Mecca straw", "confidence": "high", "type": "plant", "description": "Plant material or herb, likely from Mecca, used in remedies.", "note": "The name 'palhade Meca' and 'palha de Mequa' refer to the same plant material.", "wikipedia_extract": "Mecca, officially Makkah al-Mukarramah, is the holiest city in Islam. It is located in the Hejazi region of western Saudi Arabia and is the capital of Mecca Province. Mecca is considered the birthplace of Islam and is the birthplace of the Islamic prophet Muhammad. It is 70 km (43 mi) inland from Jeddah on the Red Sea, in a narrow valley 277 m (909 ft) above sea level. Its metropolitan population in 2022 was 2.4 million, making it the third–most populated city in Saudi Arabia after Riyadh and Jeddah. The Cave of Hira atop the Jabal al-Nour, just outside the city, is where Muslims believe the Quran was first revealed to Muhammad."}}, {"canonical_name": "Canjas", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "canjas", "book_id": "polyanthea_medicinal", "name": "Canjas", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["Canjas", "canja", "canjas"], "contexts": ["broths, to thicken flux", "type of food"]}, {"entity_id": "canje", "book_id": "coloquios_da_orta_1563", "name": "canje", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["canje"], "contexts": ["rice water preparation", "rice water"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Canjas", "target_book": "coloquios_da_orta_1563", "target_name": "canje", "similarity": 0.922}], "id": 1155, "stable_key": "clu_60b62a309e5d7ef3", "ground_truth": {"modern_name": "Canjas", "confidence": "high", "type": "substance", "description": "Thickened broths, often rice water preparations, used as food.", "note": "Refers to a type of soup or thickened liquid, commonly rice-based.", "wikipedia_extract": "Congee ( KON-jee, derived from Tamil கஞ்சி [kaɲdʑi]) is a form of savoury rice porridge of Asian origin, primarily made by boiling rice in a large amount of water until the rice softens. Depending on the rice–water ratio, the thickness of congee varies from a Western oatmeal porridge to a gruel. Since the history of rice cultivation in Asia stretches back to the Baiyue-inhabited lower Yangtze circa 10,000 BC, congee is unlikely to have appeared before that date. Congee is typically served with side dishes, or it can be topped with meat, fish, and pickled vegetables. Vivid experiences of eating or delivering thin congee as wartime or famine food often feature in diaries and chronicles. In some cultures, congee is eaten primarily as a breakfast food or late supper; some may also eat it as a substitute for rice at other meals."}}, {"canonical_name": "bolotas", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "bolotas", "book_id": "polyanthea_medicinal", "name": "bolotas", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["bolotas", "bolotas fec.cas"], "contexts": ["acorns used in broth", "acorn shells used in preparation"]}, {"entity_id": "bolota", "book_id": "coloquios_da_orta_1563", "name": "bolota", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["bolota"], "contexts": ["acorn-like fruit"]}, {"entity_id": "bolla", "book_id": "coloquios_da_orta_1563", "name": "bolla", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["bolla"], "contexts": ["name for myrrh in India"]}, {"entity_id": "bolandas", "book_id": "coloquios_da_orta_1563", "name": "bolandas", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["bolandas"], "contexts": ["items from Africa"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "bolotas", "target_book": "coloquios_da_orta_1563", "target_name": "bolota", "similarity": 0.979}, {"source_book": "polyanthea_medicinal", "source_name": "bolotas", "target_book": "coloquios_da_orta_1563", "target_name": "bolla", "similarity": 0.863}, {"source_book": "polyanthea_medicinal", "source_name": "bolotas", "target_book": "coloquios_da_orta_1563", "target_name": "bolandas", "similarity": 0.853}], "id": 1156, "stable_key": "clu_ba539190e69b30f6", "ground_truth": {"modern_name": "Acorns", "confidence": "medium", "type": "plant", "family": "Fagaceae", "description": "Fruits of oak trees, used in preparations and as food.", "note": "The mention of 'bolla' (myrrh) and 'bolandas' (items from Africa) suggests potential semantic drift or confusion in the historical texts.", "wikipedia_extract": "This glossary of botanical terms is a list of definitions of terms and concepts relevant to botany and plants in general. Terms of plant morphology are included here as well as at the more specific Glossary of plant morphology and Glossary of leaf morphology. For other related terms, see Glossary of phytopathology, Glossary of lichen terms, and List of Latin and Greek words commonly used in systematic names. Surface of an organ facing away from the organ's axis, e.g. the lower surface of a lateral organ such as a leaf or petal. Contrast adaxial. To abandon development of a structure or organ."}}, {"canonical_name": "bilis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "bilis", "book_id": "polyanthea_medicinal", "name": "bilis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["bilis"], "contexts": ["humor causing illness", "bile, one of the humors"]}, {"entity_id": "bilis", "book_id": "coloquios_da_orta_1563", "name": "bilis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bilis"], "contexts": ["bile, one of the humors"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "bilis", "target_book": "coloquios_da_orta_1563", "target_name": "bilis", "similarity": 1.0}], "id": 1157, "stable_key": "clu_c8b4d8fac4d3ab63", "ground_truth": {"modern_name": "Bile", "confidence": "high", "type": "substance", "description": "A humor of the body, associated with illness and bodily functions.", "note": "Refers to the bodily fluid within the context of humoral theory.", "wikipedia_extract": "Bile (from Latin bilis), also known as gall, is a yellow-green fluid produced by the liver of most vertebrates that aids the digestion of lipids in the small intestine. In humans, bile is primarily composed of water, is produced continuously by the liver, and is stored and concentrated in the gallbladder. After a human eats, this stored bile is discharged into the first section of the small intestine, known as the duodenum through the ampulla of vater in the duodenal wall . In the human liver, bile is composed of 97–98% water, 0.7% bile salts, 0.2% bilirubin, 0.51% fats (cholesterol, fatty acids, and lecithin), and 200 meq/L inorganic salts. The two main pigments of bile are bilirubin, which is orange-yellow, and its oxidised form biliverdin, which is green. About 400 to 800 milliliters (14 to 27 U.S. fluid ounces) of bile is produced per day in adult human beings."}}, {"canonical_name": "lombrichi", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "lombrichi", "book_id": "ricettario_fiorentino_1597", "name": "lombrichi", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["lombrichi", "Lombrichi", "Lombrichéto"], "contexts": ["earthworms, taken whole", "earthworms, washed with white wine"]}, {"entity_id": "lombri", "book_id": "polyanthea_medicinal", "name": "lombri", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["lombri"], "contexts": ["worms"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "lombrichi", "target_book": "polyanthea_medicinal", "target_name": "lombri", "similarity": 0.847}], "id": 1158, "stable_key": "clu_24dd39fcfaeb1ef0", "ground_truth": {"modern_name": "Earthworms", "confidence": "high", "type": "animal", "description": "Annelid worms found in the earth, used in preparations.", "note": "Contexts refer to earthworms being used whole or washed for medicinal purposes.", "wikipedia_extract": "An earthworm is a soil-dwelling terrestrial invertebrate that belongs to the phylum Annelida. The term is the common name for the largest members of the class (or subclass, depending on the author) Oligochaeta. In classical systems, they were in the order of Opisthopora since the male pores opened posterior to the female pores, although the internal male segments are anterior to the female. Theoretical cladistic studies have placed them in the suborder Lumbricina of the order Haplotaxida, but this may change. Other slang names for earthworms include \"dew-worm\", \"rainworm\", \"nightcrawler\", and \"angleworm\" (from its use as angling hookbait). Larger terrestrial earthworms are also called megadriles (which translates to \"big worms\") as opposed to the microdriles (\"small worms\") in the semiaquatic families Tubificidae, Lumbricidae and Enchytraeidae."}}, {"canonical_name": "Phu", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "phu", "book_id": "ricettario_fiorentino_1597", "name": "Phu", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["Phu", "Phù"], "contexts": ["root used in preparations", "plant name, possibly Valerian"]}, {"entity_id": "phu", "book_id": "polyanthea_medicinal", "name": "Phu", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Phu"], "contexts": ["herb"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Phu", "target_book": "polyanthea_medicinal", "target_name": "Phu", "similarity": 0.918}], "id": 1159, "stable_key": "clu_49c7630b7ebeb97c", "ground_truth": {"modern_name": "Valerian", "confidence": "high", "type": "plant", "linnaean": "Valeriana officinalis", "family": "Valerianaceae", "description": "A fragrant herb with a root used in medicinal preparations.", "note": "Phu is an older name for Valerian, known for its medicinal properties.", "wikipedia_extract": "Valerian (Valeriana officinalis) is an herbaceous perennial flowering plant in the family Caprifoliaceae, native to Europe and southwestern Asia. It is the type species of the genus Valeriana. It grows up to 1.5 m (5 ft) tall, rarely to 2 m (7 ft). The stems are erect, usually unbranched, with pinnately divided leaves up to 20 cm long, the leaflets with irregularly toothed to toothless margins. The flowers are produced from June to August, and are 2.5–5 mm diameter with a five-lobed corolla, sweetly scented, pale pink, occasionally white, grouped in both compound and secondary clusters. Three subspecies are accepted by the Plants of the World Online (POWO) database: Valeriana officinalis subsp. officinalis — throughout most of the range Valeriana officinalis subsp. nemorensis (B.Turk) F.Martini & Soldano — Italy, northwest Balkans Valeriana officinalis subsp. tenuifolia (Vahl) Schübl. & G.Martens — central and northern Europe Two other subspecies, not distinguished by POWO, are accepted by some other authors: Valeriana officinalis subsp. collina — on dry chalk soils Valeriana officinalis subsp. sambucifolia — on wetter marshy sites It is native from Iceland south to Portugal, north to central Scandinavia, east to European Russia, and southeast to Iran."}}, {"canonical_name": "Perfa", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "perfa", "book_id": "ricettario_fiorentino_1597", "name": "Perfa", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["perfa", "Perfa"], "contexts": ["fragrant herb for pounding", "likely a plant or its product"]}, {"entity_id": "perfas", "book_id": "polyanthea_medicinal", "name": "Perfas", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Perfas", "Perfia"], "contexts": ["people who name Chà", "Country ruled by Sefigambe"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Perfa", "target_book": "polyanthea_medicinal", "target_name": "Perfas", "similarity": 0.959}], "id": 1160, "stable_key": "clu_b4b3971fad7b2680", "ground_truth": {"modern_name": "Persia", "confidence": "high", "type": "place", "description": "A historical region and country in Western Asia.", "note": "'Perfa' and 'Perfas' are likely variations of the historical name for Persia.", "wikipedia_extract": "Iran, officially the Islamic Republic of Iran, and also known as Persia, is a country in West Asia. It borders Iraq to the west, Turkey, Azerbaijan, and Armenia to the northwest, the Caspian Sea to the north, Turkmenistan to the northeast, Afghanistan to the east, Pakistan to the southeast, and the Gulf of Oman and the Persian Gulf to the south. With a population of over 90 million, Iran ranks 17th globally in both geographic size and population and is the sixth-largest country in Asia. It is divided into five regions with 31 provinces. Tehran is the nation's capital, largest city, and financial center. Home to one of the world's oldest continuous major civilizations, most of Iran was first united as a nation by the Medes under Cyaxares in the 7th century BC and reached its territorial height in the 6th century BC, when Cyrus the Great founded the Achaemenid Empire."}}, {"canonical_name": "hyperbola", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "hyperbola", "book_id": "connexion_physical_sciences_somerville_1858", "name": "hyperbola", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["hyperbola"], "contexts": ["mathematical curve describing liquid outline", "mathematical curve describing form"]}, {"entity_id": "hyperbola", "book_id": "first_principles_spencer_1862", "name": "hyperbola", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hyperbola"], "contexts": ["geometric curve with two branches"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "hyperbola", "target_book": "first_principles_spencer_1862", "target_name": "hyperbola", "similarity": 1.0}], "id": 1161, "stable_key": "clu_1ed0db7b8f64d8c1", "ground_truth": {"modern_name": "Hyperbola", "confidence": "high", "type": "concept", "wikidata_id": "Q13846009", "wikidata_description": "genus of insects"}}, {"canonical_name": "Manchester", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "manchester", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Manchester", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Manchester"], "contexts": ["location associated with Mr. Joule", "location of storm in 1835"]}, {"entity_id": "manchester", "book_id": "first_principles_spencer_1862", "name": "Manchester", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Manchester"], "contexts": ["city with suburbs"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Manchester", "target_book": "first_principles_spencer_1862", "target_name": "Manchester", "similarity": 1.0}], "id": 1162, "stable_key": "clu_298176d333eb974e", "ground_truth": {"modern_name": "Manchester", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q18125", "wikidata_description": "city in Greater Manchester, England"}}, {"canonical_name": "soft iron", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "soft_iron", "book_id": "connexion_physical_sciences_somerville_1858", "name": "soft iron", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["soft iron"], "contexts": ["used for temporary magnets", "material used for ring in experiments"]}, {"entity_id": "soft_iron", "book_id": "first_principles_spencer_1862", "name": "soft iron", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["soft iron"], "contexts": ["bar affected by electric current"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "soft iron", "target_book": "first_principles_spencer_1862", "target_name": "soft iron", "similarity": 1.0}], "id": 1163, "stable_key": "clu_2d85c61442eb8e62", "ground_truth": {"modern_name": "Soft iron", "confidence": "high", "type": "mineral"}}, {"canonical_name": "Idolatry", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "idolatry", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Idolatry", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Idolatry"], "contexts": ["worship of idols", "worship of false deities or idols"]}, {"entity_id": "idolatrous", "book_id": "english_physician_1652", "name": "Idolatrous", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Idolatrous"], "contexts": ["description of Heathens and Papists"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Idolatry", "target_book": "english_physician_1652", "target_name": "Idolatrous", "similarity": 0.944}], "id": 1164, "stable_key": "clu_327aa738e043a858", "ground_truth": {"modern_name": "Idolatry", "confidence": "high", "type": "concept", "wikidata_id": "Q840665", "wikidata_description": "idol worship", "wikipedia_url": "https://en.wikipedia.org/wiki/Idolatry"}}, {"canonical_name": "Brimstone", "category": "SUBSTANCE", "subcategory": "CHEMICAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "brimstone", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Brimstone", "category": "SUBSTANCE", "subcategory": "CHEMICAL", "count": 3, "variants": ["Brimstone"], "contexts": ["sulfur, used for purification", "ingredient of gunpowder"]}, {"entity_id": "brimstone", "book_id": "english_physician_1652", "name": "Brimstone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Brimstone"], "contexts": ["mineral mixed with juice", "used with Darnel meal to dissolve knots"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Brimstone", "target_book": "english_physician_1652", "target_name": "Brimstone", "similarity": 0.872}], "id": 1165, "stable_key": "clu_e357c7c866d78d8f", "ground_truth": {"modern_name": "Sulfur", "confidence": "high", "type": "chemical", "note": "Brimstone is an archaic term for sulfur.", "wikidata_id": "Q1157552", "wikidata_description": "mineral (as opposed to the chemical element)", "wikipedia_extract": "Sulfuric acid (American spelling and the preferred IUPAC name) or sulphuric acid (Commonwealth spelling), known in antiquity as oil of vitriol, is a mineral acid composed of the elements sulfur, oxygen, and hydrogen, with the molecular formula H2SO4. It is a colorless, odorless, and viscous liquid that is miscible with water. Pure sulfuric acid does not occur naturally due to its strong affinity to water vapor; it is hygroscopic and readily absorbs water vapor from the air. Concentrated sulfuric acid is a strong oxidant with powerful dehydrating properties, making it highly corrosive towards other materials, from rocks to metals. Phosphorus pentoxide is a notable exception in that it is not dehydrated by sulfuric acid but, to the contrary, dehydrates sulfuric acid to sulfur trioxide. Upon addition of sulfuric acid to water, a considerable amount of heat is released; thus, the reverse procedure of adding water to the acid is generally avoided since the heat released may boil the solution, spraying droplets of hot acid during the process.", "wikipedia_url": "https://fr.wikipedia.org/wiki/Soufre_%28min%C3%A9ral%29"}}, {"canonical_name": "Liquoris", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "liquoris", "book_id": "english_physician_1652", "name": "Liquoris", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["Liquoris"], "contexts": ["English plant with woody stalks and leaves", "plant root used for comparison"]}, {"entity_id": "liquorish", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Liquorish", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Liquorish"], "contexts": ["make stridulous noise upon divulsion"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Liquoris", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Liquorish", "similarity": 0.868}], "id": 1166, "stable_key": "clu_3eea27b72e931d3d", "ground_truth": {"modern_name": "Licorice", "confidence": "high", "type": "plant", "linnaean": "Glycyrrhiza glabra", "family": "Fabaceae", "note": "The description 'make stridulous noise upon divulsion' is unusual for licorice, but the primary identification as 'Liquoris' strongly points to it. It's possible the text refers to a specific preparation or a less common characteristic.", "wikidata_id": "Q15447514", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Licorice_pipe", "wikipedia_extract": "A licorice pipe is a candy made of licorice shaped like a tobacco pipe, often with red sugar balls on the head of the pipe. A pipe may weigh around 16 grams, and the licorice is usually soft and sweet. There are also other varieties, for example with blue or yellow sugar balls, the latter with a taste of sea salt. The first known licorice pipe (Finnish: lakupiippu) was manufactured as early as the 1920s at the Heikki Huhtamäki factory in Kokkola, Finland. In January 2010, displaying licorice pipes for sale in stores was banned in Norway. In August 2013, licorice pipes again made headlines because of a forthcoming EU directive on tobacco prevention, with the potential of a ban which could affect the sale of sweets and toys imitating tobacco products."}}, {"canonical_name": "Ivy", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "ivy", "book_id": "english_physician_1652", "name": "Ivy", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["Ivy"], "contexts": ["plant growing in woods and on walls", "plant used in a cure for wine surfeit"]}, {"entity_id": "ivy", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ivy", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Ivy"], "contexts": ["plant that blossoms twice a year"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Ivy", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Ivy", "similarity": 0.898}], "id": 1167, "stable_key": "clu_7adfd432fcc142ae", "ground_truth": {"modern_name": "Ivy", "confidence": "high", "type": "plant", "linnaean": "Hedera helix", "family": "Araliaceae", "note": "The description 'plant that blossoms twice a year' is not typical for common ivy (Hedera helix), which usually flowers once. This might refer to a specific variety, a misobservation, or a different plant with a similar common name.", "wikidata_id": "Q26354", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Hedera%20helix", "wikipedia_extract": "Hedera helix, simply ivy, or common ivy, English ivy, European ivy, King's choice ivy, is a species of flowering plant in the family Araliaceae. It is native to most of Europe and parts of western Asia. Ivy is a clinging evergreen vine that grows on tree trunks, walls, and fences in gardens, waste spaces, and wild habitats. Ivy is popular as an ornamental plant, but escaped plants have become naturalised outside its native range. Ivy has considerable cultural significance and symbolism. Synonyms include Hedera acuta, Hedera arborea ('tree ivy'), Hedera baccifera, and Hedera grandifolia."}}, {"canonical_name": "thrush", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "thrush", "book_id": "origin_of_species_darwin_1859", "name": "thrush", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["thrush"], "contexts": ["bird that feeds on insects", "bird species from South America"]}, {"entity_id": "thrushes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Thrushes", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Thrushes"], "contexts": ["type of bird"]}, {"entity_id": "thrush_family", "book_id": "origin_of_species_darwin_1859", "name": "thrush family", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["thrush family"], "contexts": ["family of terrestrial birds"]}, {"entity_id": "thrushes", "book_id": "origin_of_species_darwin_1859", "name": "thrushes", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["thrushes"], "contexts": ["diving birds"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "thrush", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Thrushes", "similarity": 0.958}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Thrushes", "target_book": "origin_of_species_darwin_1859", "target_name": "thrush family", "similarity": 0.896}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Thrushes", "target_book": "origin_of_species_darwin_1859", "target_name": "thrushes", "similarity": 0.989}], "id": 1168, "stable_key": "clu_129d1a39388964e4", "ground_truth": {"modern_name": "Thrush", "confidence": "high", "type": "animal", "wikipedia_extract": "The song thrush (Turdus philomelos) is a thrush that breeds across the West Palearctic. It has brown upperparts and black-spotted cream or buff underparts and has four recognised subspecies. Its distinctive song, which features repeated musical phrases, has frequently been referenced in poetry. The song thrush breeds in forests, gardens and parks. It is partially migratory, with many birds wintering in southern Europe, North Africa and the Middle East. The species has also been introduced into New Zealand and Australia.", "wikipedia_url": "https://en.wikipedia.org/wiki/Song_thrush"}}, {"canonical_name": "Turkey-cock", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "turkey-cock", "book_id": "origin_of_species_darwin_1859", "name": "Turkey-cock", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["turkey-cock", "Turkey-cock"], "contexts": ["male turkey bird", "brush of hair on breast"]}, {"entity_id": "turkeys", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Turkeys", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Turkeys"], "contexts": ["large domesticated fowl"]}, {"entity_id": "turkey", "book_id": "origin_of_species_darwin_1859", "name": "Turkey", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["Turkey", "turkey"], "contexts": ["bird whose digestive organs pass fruit seeds", "naked skin on head"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Turkey-cock", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Turkeys", "similarity": 0.911}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Turkeys", "target_book": "origin_of_species_darwin_1859", "target_name": "Turkey", "similarity": 0.948}], "id": 1169, "stable_key": "clu_fa8b5473c9e8ac64", "ground_truth": {"modern_name": "Turkey", "confidence": "high", "type": "animal", "wikidata_id": "Q43794", "wikidata_description": "North American genus of large birds", "wikipedia_url": "https://en.wikipedia.org/wiki/Turkey_%28bird%29", "wikipedia_extract": "The Ottoman Empire, historically also known as the Turkish Empire, controlled much of Southeast Europe, West Asia, and North Africa from the 14th century to the early 20th century. It also controlled parts of southeastern Central Europe between the early 16th and early 18th centuries. The empire emerged from a beylik, or principality, founded in northwestern Anatolia in c. 1299 by the Turkoman tribal leader Osman I. His successors conquered much of Anatolia and expanded into the Balkans by the mid-14th century, transforming their petty kingdom into a transcontinental empire. The Ottomans ended the Byzantine Empire with the conquest of Constantinople in 1453 by Mehmed II."}}, {"canonical_name": "hares", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "hares", "book_id": "origin_of_species_darwin_1859", "name": "hares", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["hares"], "contexts": ["long-eared rabbits", "lagomorph prey"]}, {"entity_id": "hares", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hares", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Hares"], "contexts": ["mammal used for comparison of lifespan"]}, {"entity_id": "hare", "book_id": "origin_of_species_darwin_1859", "name": "hare", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["hare"], "contexts": ["fast-running long-eared mammal"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "hares", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Hares", "similarity": 0.981}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hares", "target_book": "origin_of_species_darwin_1859", "target_name": "hare", "similarity": 0.948}], "id": 1170, "stable_key": "clu_7c75c9950040d9e9", "ground_truth": {"modern_name": "Hare", "confidence": "high", "type": "animal", "wikidata_id": "Q46076", "wikidata_description": "genus of mammals in the family Leporidae", "wikipedia_url": "https://en.wikipedia.org/wiki/Hare", "wikipedia_extract": "Hares and jackrabbits are mammals belonging to the genus Lepus. They are herbivores and live solitarily or in pairs. They nest in depressions in the ground called forms, and their young are able to fend for themselves shortly after birth. The genus includes the largest lagomorphs. Most are fast runners with long, powerful hind legs, and large ears that dissipate body heat. Hare species are native to Africa, Eurasia and  North America."}}, {"canonical_name": "Vespucci", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "vespucci", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Vespucci", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Vespucci"], "contexts": ["author quoted on language", "discoverer of parts of the New World"]}, {"entity_id": "vespasian", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Vespasian", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Vespasian"], "contexts": ["Roman Emperor", "Roman emperor associated with miraculous healing"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Vespucci", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Vespasian", "similarity": 0.877}], "id": 1171, "stable_key": "clu_46b470498f251d79", "ground_truth": {"modern_name": "Vespucci", "confidence": "medium", "type": "person", "birth_year": 1454, "death_year": 1512, "description": "Italian explorer and cartographer; gave his name to America.", "note": "The cluster mixes Amerigo Vespucci with Vespasian. Given the context of exploration in Humboldt's work (vol 3 of 'Relation historique'), Vespucci is the more likely intended referent for the majority of mentions, despite Vespasian appearing in Browne's 'Pseudodoxia Epidemica'.", "wikipedia_extract": "Amerigo Vespucci (9 March 1454 – 22 February 1512) was an Italian explorer, navigator and popular author from the Republic of Florence after whom America is named. Vespucci participated in at least two voyages of the Age of Discovery between 1497 and 1504, first on behalf of Spain (1499–1500) and then for Portugal (1501–1502). In 1503 and 1505, two booklets were published under his name containing colourful descriptions of these explorations and other voyages. Both publications were extremely popular and widely read throughout much of Europe. Historians still dispute the authorship and veracity of these accounts, but they were instrumental in raising awareness of the discoveries and enhancing the reputation of Vespucci as an explorer and navigator. Vespucci claimed to have understood in 1501 that Brazil was part of a fourth continent unknown to Europeans, which he called the \"New World\" (Mundus Novus).", "wikipedia_url": "https://en.wikipedia.org/wiki/Amerigo_Vespucci"}}, {"canonical_name": "Batavia", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "batavia", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Batavia", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Batavia"], "contexts": ["Batavia", "city with observed average temperature"]}, {"entity_id": "batavia", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Batavia", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Batavia"], "contexts": ["city from which Dutch Embassadors were sent"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Batavia", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Batavia", "similarity": 1.0}], "id": 1172, "stable_key": "clu_0635958a1f94713a", "ground_truth": {"modern_name": "Jakarta", "confidence": "high", "type": "place", "country": "Indonesia", "note": "Batavia was the name of the city (now Jakarta) that served as the capital of the Dutch East Indies. The context of Dutch ambassadors being sent from there confirms this identification.", "wikipedia_extract": "Jakarta, officially the Special Capital Region of Jakarta,  is the de facto capital and largest city of Indonesia and an autonomous region with a status equivalent to that of a province. It is located on the northwest coast of Java, the world's most populous island, bordered by the province of West Java to the south and east and Banten to the west. Its coastline faces the Java Sea to the north, and it shares a maritime border with Lampung to the west. Jakarta's metropolitan area has an estimated population of 41.9 million as of 2025, making it the most populated city in the world and therefore of Southeast Asia and largest urban area in Indonesia. Although Jakarta extends over only 661.23 square kilometres (255.30 square miles) and thus has the smallest area of any Indonesian province, its metropolitan area covers 7,076.31 square kilometres (2,732.18 square miles). Jakarta is the economic, cultural, and political centre of Indonesia, and the ASEAN's second largest economy after Singapore.", "wikipedia_url": "https://en.wikipedia.org/wiki/Jakarta"}}, {"canonical_name": "Empedocles", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "empedocles", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Empedocles", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["Empedocles"], "contexts": ["ancient Greek pre-Socratic philosopher", "philosopher whose assertions were rejected by Aristotle"]}, {"entity_id": "empedocles", "book_id": "kosmos_humboldt_1845", "name": "Empedocles", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Empedocles"], "contexts": ["early poet of nature"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Empedocles", "target_book": "kosmos_humboldt_1845", "target_name": "Empedocles", "similarity": 1.0}], "id": 1173, "stable_key": "clu_bbdcf1369be24245", "ground_truth": {"modern_name": "Empedocles", "confidence": "high", "type": "person", "birth_year": -494, "death_year": -434, "description": "Ancient Greek pre-Socratic philosopher and poet.", "wikipedia_extract": "Empedocles (; Ancient Greek: Ἐμπεδοκλῆς; c. 494 – c. 434 BC, fl. 444–443 BC) was a Greek pre-Socratic philosopher and a native citizen of Akragas, a Greek city in Sicily. Empedocles' philosophy is known best for originating the cosmogonic theory of the four classical elements. He also proposed forces he called Love and Strife which would mix and separate the elements, respectively. Empedocles challenged the practice of animal sacrifice and killing animals for food. He developed a distinctive doctrine of reincarnation. He is generally considered the last Greek philosopher to have recorded his ideas in verse."}}, {"canonical_name": "Macrobius", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "macrobius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Macrobius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Macrobius"], "contexts": ["Roman writer", "Roman writer and commentator"]}, {"entity_id": "macrobius", "book_id": "kosmos_humboldt_1845", "name": "Macrobius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Macrobius"], "contexts": ["Roman writer", "ancient Roman author"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Macrobius", "target_book": "kosmos_humboldt_1845", "target_name": "Macrobius", "similarity": 1.0}], "id": 1174, "stable_key": "clu_79b3ada4fc4cf8f4", "ground_truth": {"modern_name": "Macrobius", "confidence": "high", "type": "person", "description": "Roman writer and commentator on Cicero and Virgil.", "wikidata_id": "Q313934", "wikidata_description": "ancient Roman author (5th century)", "wikipedia_url": "https://en.wikipedia.org/wiki/Servius_the_Grammarian", "wikipedia_extract": "Servius, distinguished as Servius the Grammarian (Latin: Servius or Seruius Grammaticus), was a late fourth-century and early fifth-century grammarian. He earned a contemporary reputation as the most learned man of his generation in Italy. He authored a set of commentaries on the works of Virgil; these works, In Tria Virgilii Opera Expositio (\"Exposition on Three Works of Virgil\"), Commentarii in Virgilium (\"Commentaries on Virgil\"), Commentarii in Vergilii Opera (\"Commentaries on the Works of Vergil\"), or Vergilii Carmina Commentarii (\"Commentaries on the Poems of Virgil\"), constituted the first incunable to be printed at Florence, by Bernardo Cennini, in 1471. In the Saturnalia of Macrobius, Servius appears as one of the interlocutors; allusions in that work and a letter from Symmachus to Servius indicate that he was not a convert to Christianity. The name Servius also appears as Seruius owing to the unity of the Latin letters V and U from antiquity until as late as the 18th century. Many medieval manuscripts of Servius's commentaries give him the praenomen Marius or Maurus and the cognomen Honoratus."}}, {"canonical_name": "Trogus Pompeius", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "trogus_pompeius", "book_id": "kosmos_humboldt_1845", "name": "Trogus Pompeius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["Trogus Pompeius"], "contexts": ["ancient source followed by Justinian", "ancient historian followed by author"]}, {"entity_id": "trogus_pompeius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Trogus Pompeius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Trogus Pompeius"], "contexts": ["ancient historian"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Trogus Pompeius", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Trogus Pompeius", "similarity": 1.0}], "id": 1175, "stable_key": "clu_23bd8a8c92edc0a0", "ground_truth": {"modern_name": "Trogus Pompeius", "confidence": "high", "type": "person", "description": "Roman historian whose work on ancient history was abridged by Justin.", "wikidata_id": "Q316119", "wikidata_description": "Gallo-Roman historian who flourished during the reign of the emperor Augustus", "wikipedia_url": "https://en.wikipedia.org/wiki/Gnaeus%20Pompeius%20Trogus"}}, {"canonical_name": "lapidairos", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "lapidairos", "book_id": "coloquios_da_orta_1563", "name": "lapidairos", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 4, "variants": ["lapidairos", "lapidairos indianos", "lapidaríos"], "contexts": ["stone cutters or dealers", "craftsmen who worked with stones"]}, {"entity_id": "lapidaries", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Lapidaries", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["Lapidaries"], "contexts": ["craftsmen who cut stones"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "lapidairos", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Lapidaries", "similarity": 0.948}], "id": 1176, "stable_key": "clu_322b66271be087de", "ground_truth": {"modern_name": "Lapidary", "confidence": "high", "type": "concept", "wikidata_id": "Q17319698", "wikidata_description": "mineral objects cutting, engraving, inscribing", "wikipedia_url": "https://en.wikipedia.org/wiki/Lapidary", "wikipedia_extract": "Lapidary (from Latin  lapidarius 'stone, stony') is the practice of shaping stone, minerals, or gemstones into decorative items such as cabochons, engraved gems (including cameos), and faceted designs. A person who practices lapidary techniques of cutting, grinding, and polishing is known as a lapidary or lapidarist. Hardstone carving requires specialized carving techniques. In modern contexts, a gemcutter is a person who specializes in cutting diamonds, but in older contexts the term refers to artists who produced hardstone carvings; engraved gems such as jade carvings, a branch of miniature sculpture or ornament in gemstone. By extension, the term lapidary has sometimes been applied to collectors of and dealers in gems, or to anyone who is knowledgeable in precious stones. The etymological root of the word lapidary is the Latin word lapis, meaning \"stone\"."}}, {"canonical_name": "Moly", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "moly", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Moly", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Moly"], "contexts": ["magical herb from Homer's Odyssey", "magical herb mentioned by Homer"]}, {"entity_id": "moly", "book_id": "ricettario_fiorentino_1597", "name": "Moly", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Moly", "molo"], "contexts": ["identified as a type of wild rue", "herb used in preparations"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Moly", "target_book": "ricettario_fiorentino_1597", "target_name": "Moly", "similarity": 1.0}], "id": 1177, "stable_key": "clu_9c108f8a0e251760", "ground_truth": {"modern_name": "Moly", "confidence": "high", "type": "plant", "note": "The exact botanical identification of Moly is uncertain, though it's often associated with *Peganum harmala* or certain *Ruta* species.", "wikipedia_extract": "Allium moly, also known as yellow garlic, golden garlic and lily leek, Is a species of flowering plant in the genus Allium, which also includes the flowering and culinary onions and garlic. A bulbous herbaceous perennial from the Mediterranean. It is edible and used as a medicinal and ornamental plant. Allium moly is a bulb type flower, with the size of the bulb affecting the flowering period and the time of the flowering. With lance-shaped grey-green leaves up to 30 cm long, in early summer it produces masses of star-shaped bright yellow flowers in dense umbels. The cultivar 'Jeannine' has gained the Royal Horticultural Society's Award of Garden Merit.", "wikipedia_url": "https://en.wikipedia.org/wiki/Allium_moly"}}, {"canonical_name": "Rupertus Abbas", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "rupertus_abbas", "book_id": "polyanthea_medicinal", "name": "Rupertus Abbas", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Rupertus Abbas", "Rupert. Abb."], "contexts": ["cited for letter to Pontific", "cited for epistles to Pontific"]}, {"entity_id": "rupertus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Rupertus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Rupertus"], "contexts": ["writer on affections of the Dove", "ancient authority cited"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Rupertus Abbas", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Rupertus", "similarity": 0.832}], "id": 1178, "stable_key": "clu_b8b17de624efef64", "ground_truth": {"modern_name": "Rupert of Deutz", "confidence": "high", "type": "person", "birth_year": 1070, "death_year": 1129, "description": "Benedictine monk and theologian, known for his commentaries.", "note": "The text suggests 'Rupertus Abbas' could refer to Rupert of Deutz, a prominent abbot and theological writer.", "wikidata_id": "Q980890", "wikidata_description": "abbot, theologian, exegete and writer on liturgical and musical topics (1075–1129)", "wikipedia_extract": "Impanation (Latin: impanatio, \"embodied in bread\") is a high medieval theory of the real presence of the body of Jesus Christ in the consecrated bread of the Eucharist that does not imply a change in the substance of either the bread or the body. This doctrine, apparently patterned after Christ's Incarnation (God is made flesh in the Person of Jesus Christ), is the assertion that \"God is made bread\" in the Eucharist. Christ's divine attributes are shared by the eucharistic bread via his body. This view is similar but not identical to the theory of consubstantiation associated with Lollardy. It is considered a heresy by the Roman Catholic Church and is also rejected by classical Lutheranism. Rupert of Deutz (d.", "wikipedia_url": "https://en.wikipedia.org/wiki/Rupert_of_Deutz"}}, {"canonical_name": "Unicorne", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "unicorne", "book_id": "polyanthea_medicinal", "name": "Unicorne", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Unicorne"], "contexts": ["mythical animal product used as remedy", "remedy for poison bite"]}, {"entity_id": "unicorns_horn", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Unicorns horn", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Unicorns horn"], "contexts": ["mythical animal product"]}, {"entity_id": "unicorns-horn", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Unicorns-horn", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Unicorns-horn"], "contexts": ["mythical animal product tested for electricity"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Unicorne", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Unicorns horn", "similarity": 0.887}, {"source_book": "polyanthea_medicinal", "source_name": "Unicorne", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Unicorns-horn", "similarity": 0.904}], "id": 1179, "stable_key": "clu_996c1d6772e3de16", "ground_truth": {"modern_name": "Unicorn horn", "confidence": "high", "type": "object", "note": "The texts refer to the horn of the mythical unicorn, often used as a supposed antidote or remedy.", "wikipedia_extract": "A unicorn horn, also known as an alicorn, is a legendary object whose reality was accepted in Europe and Asia from the earliest recorded times. This \"horn\" comes from the creature known as a unicorn, also known in the Hebrew Bible as a re'em or wild ox. Many healing powers and antidotal virtues were attributed to the alicorn, making it one of the most expensive and reputable remedies during the Renaissance, and justifying its use in the highest circles. Beliefs related to the alicorn influenced alchemy through spagyric medicine. The horn's purificational properties were eventually put to the test in, for example, the book of Ambroise Paré, Discourse on unicorn. Seen as one of the most valuable assets that a person could possess, unicorn horns were given as diplomatic gifts, and chips and dust from them could be purchased at apothecaries as universal antidotes until the 18th century."}}, {"canonical_name": "stupor", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "stupor", "book_id": "polyanthea_medicinal", "name": "stupor", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 4, "variants": ["stupor", "Stupor", "stuporis"], "contexts": ["state of stupor", "state of reduced consciousness or sensation"]}, {"entity_id": "stupifies", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "stupifies", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["stupifies"], "contexts": ["causes numbness or paralysis"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "stupor", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "stupifies", "similarity": 0.91}], "id": 1180, "stable_key": "clu_192e8b0d06f22751", "ground_truth": {"modern_name": "Stupor", "confidence": "high", "type": "disease", "modern_term": "Stupor", "wikidata_id": "Q268594", "wikidata_description": "total or nearly total lack of spontaneous movements (disease)", "wikipedia_url": "https://en.wikipedia.org/wiki/Stupor"}}, {"canonical_name": "Plums", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "plums", "book_id": "english_physician_1652", "name": "Plums", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["Plums", "Plum"], "contexts": ["well-known fruit", "fruit with diverse operations"]}, {"entity_id": "plums", "book_id": "origin_of_species_darwin_1859", "name": "Plums", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Plums"], "contexts": ["fruit grown in the United States"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Plums", "target_book": "origin_of_species_darwin_1859", "target_name": "Plums", "similarity": 0.911}], "id": 1181, "stable_key": "clu_847618b8adef2c9a", "ground_truth": {"modern_name": "Plum", "confidence": "high", "type": "plant", "linnaean": "Prunus domestica", "family": "Rosaceae", "description": "A common fruit tree bearing sweet, edible drupes.", "note": "The singular 'Plum' is more appropriate for the general fruit type.", "wikipedia_extract": "Prunus domestica is a species of flowering plant in the family Rosaceae. A deciduous tree, it includes many varieties of the fruit trees known as plums in English, though not all plums belong to this species. The greengages and damsons also belong to subspecies of P. domestica. It typically forms a large shrub or a small tree. It may be somewhat thorny, with white blossom, borne in early spring. The oval or spherical fruit varies in size, but can be up to 8 centimetres (3 inches) across."}}, {"canonical_name": "Babilónia", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "babilónia", "book_id": "coloquios_da_orta_1563", "name": "Babilónia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Babilónia", "babilónico"], "contexts": ["anciently named city", "possible origin of substance"]}, {"entity_id": "babylon", "book_id": "principles_of_psychology_james_1890", "name": "Babylon", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Babylon"], "contexts": ["biblical city, symbol of power"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Babilónia", "target_book": "principles_of_psychology_james_1890", "target_name": "Babylon", "similarity": 0.863}], "id": 1182, "stable_key": "clu_5f7750a5886103b9", "ground_truth": {"modern_name": "Babylon", "confidence": "high", "type": "place", "description": "An ancient Mesopotamian city, historically significant.", "note": "'Babilónia' is the Portuguese spelling for Babylon.", "wikipedia_extract": "Babylon ( BAB-il-on) was an ancient city located on the lower Euphrates river in southern Mesopotamia, within modern-day Hillah, Iraq, about 85 kilometres (53 miles) south of modern-day Baghdad. Babylon functioned as the main cultural and political centre of the Akkadian-speaking region of Babylonia. Its rulers established two important empires in antiquity, the 19th–16th century BC Old Babylonian Empire, and the 7th–6th century BC Neo-Babylonian Empire. Babylon was also used as a regional capital of other empires, such as the Achaemenid Empire. Babylon was one of the most important urban centres of the ancient Near East, until its decline during the Hellenistic period. Nearby ancient sites are Kish, Borsippa, Dilbat, and Kutha."}}, {"canonical_name": "camphora", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "camphora", "book_id": "coloquios_da_orta_1563", "name": "camphora", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["camphora", "C. Camphora", "camphre"], "contexts": ["aromatic substance", "substance called camphor"]}, {"entity_id": "camphire", "book_id": "english_physician_1652", "name": "Camphire", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Camphire"], "contexts": ["applied with Lettice to cods"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "camphora", "target_book": "english_physician_1652", "target_name": "Camphire", "similarity": 0.846}], "id": 1183, "stable_key": "clu_86686171a8cbcbeb", "ground_truth": {"modern_name": "Camphor", "confidence": "high", "type": "plant", "linnaean": "Cinnamomum camphora", "family": "Lauraceae", "description": "Aromatic resin from the camphor tree.", "note": "Refers to the substance derived from the camphor tree, Cinnamomum camphora.", "wikipedia_extract": "Camphora officinarum is a species of evergreen tree indigenous to warm temperate to subtropical regions of East Asia, including countries such as China, Taiwan, Vietnam, Korea, Japan and India. It is known by various names, most notably the camphor tree, camphorwood or camphor laurel. Camphora officinarum grows up to 20–30 m (66–98 ft) tall. In Japan, where the tree is called kusunoki, five camphor trees are known with a trunk circumference above 20 m (66 ft), with the largest individual, Kamō no Ōkusu (蒲生の大楠; \"Great camphor of Kamō\"), reaching 24.22 m (79+1⁄2 ft). The leaves have a glossy, waxy appearance and smell of camphor when crushed. In spring, it produces bright green foliage with masses of very small white fragrant flowers from which its common namesake \"smells good tree\" in Chinese 香樟 xiang zhang was given."}}, {"canonical_name": "Aromaticum Rosarum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "aromaticum_rosarum", "book_id": "english_physician_1652", "name": "Aromaticum Rosarum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["Aromaticum Rosarum", "Aromatica Rosarum", "Aromatica Rosa∣rum"], "contexts": ["rose preparation for cordial use", "made with dried Rose leaves"]}, {"entity_id": "aromatico_rosa", "book_id": "ricettario_fiorentino_1597", "name": "AROMATICO ROSA", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["AROMATICO ROSA"], "contexts": ["aromatic preparation with rose"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Aromaticum Rosarum", "target_book": "ricettario_fiorentino_1597", "target_name": "AROMATICO ROSA", "similarity": 0.908}], "id": 1184, "stable_key": "clu_b2ee60d7cec1978e", "ground_truth": {"modern_name": "Aromaticum Rosarum", "confidence": "high", "type": "substance", "description": "Rose preparation used for cordial purposes.", "note": "This is a historical preparation name.", "wikipedia_extract": "In pre-modern medicine, \"diarrhodon\" (Gr διάρροδον, \"compound of roses\", from ῥόδων, \"of roses\") is a name given to diverse compositions, in which red roses are an ingredient. Diarrhodon abbatis is a cordial powder, denominated from the Abbot who invented it. It consists of red roses, red and citron santals, lignum aloes, cinnamon, rhapontic, spikenard, ivory, harts-horn, saffron, mastic, pearls, ambergris, musk, etc. It was used to strengthen the heart, stomach, and liver, and to assist in digestion, and prevent vomiting. Philip Barrough, author of the first textbook on medicine published in English, gives this description and recipe for diarrhodon abbatis: \"Electarium Diarrhodon Abbatis mitigateth the heate of the stomacke and midrife, and yet notwithstanding furthereth their concoction, aswageth paine, and dissipateth wind. \"R. Rosarum rubrarum oz. 1 1/2."}}, {"canonical_name": "Mortar", "category": "OBJECT", "subcategory": "VESSEL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "mortar", "book_id": "english_physician_1652", "name": "Mortar", "category": "OBJECT", "subcategory": "VESSEL", "count": 4, "variants": ["Mortar"], "contexts": ["tool for beating herbs", "used to mix ingredients for electuaries"]}, {"entity_id": "mortaro", "book_id": "ricettario_fiorentino_1597", "name": "mortaro", "category": "OBJECT", "subcategory": "VESSEL", "count": 1, "variants": ["mortaro"], "contexts": ["container for grinding ingredients"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Mortar", "target_book": "ricettario_fiorentino_1597", "target_name": "mortaro", "similarity": 0.881}], "id": 1185, "stable_key": "clu_347a41c65271169b", "ground_truth": {"modern_name": "Mortar", "confidence": "high", "type": "object", "description": "A vessel used for grinding and mixing ingredients.", "wikipedia_extract": "A mortarium (pl. \"mortaria\") was one of a class of Ancient Roman pottery kitchen vessels, specifically a type of mortar. They are bowls with thick sides that were likely used for crushing and grinding foodstuffs. They sometimes had grit embedded in the inner surface and a spout. Less commonly, some mortaria also had handles. They were used for pounding or mixing foods. Stamps on some early Roman mortaria record the name of the potter, from which it is possible to trace their movement between workshops."}}, {"canonical_name": "Lupini", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "lupini", "book_id": "ricettario_fiorentino_1597", "name": "Lupini", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["lupini", "Lupini"], "contexts": ["lupins for grinding", "lupine seed ingredient"]}, {"entity_id": "lupines", "book_id": "english_physician_1652", "name": "Lupines", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Lupines"], "contexts": ["plant used in powder"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Lupini", "target_book": "english_physician_1652", "target_name": "Lupines", "similarity": 0.901}], "id": 1186, "stable_key": "clu_1bbd0a3bf268f715", "ground_truth": {"modern_name": "Lupins", "confidence": "high", "type": "plant", "linnaean": "Lupinus", "family": "Fabaceae", "description": "Edible seeds or plants of the genus Lupinus.", "note": "Refers to the plant genus Lupinus or its seeds.", "wikipedia_extract": "Lupinus, commonly known as lupin, lupine, or regionally bluebonnet, is a genus of plants in the legume family Fabaceae. The genus includes over 199 species, with centres of diversity in North and South America. Smaller centres occur in North Africa and the Mediterranean. They are widely cultivated both as a food source and as ornamental plants, but are invasive to some areas. For instance, lupine has become an ecological problem in Iceland since the beginning of the 21st century. The species are mostly herbaceous perennial plants 0.3–1.5 metres (1–5 feet) tall, but some are annual plants and a few are shrubs up to 3 m (10 ft) tall."}}, {"canonical_name": "Lavender", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "lavender", "book_id": "english_physician_1652", "name": "Lavender", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["Lavender", "Lavender Cotten"], "contexts": ["plant with similar flower shape", "herb, Inhabitant in almost every Garden"]}, {"entity_id": "lavandano", "book_id": "polyanthea_medicinal", "name": "lavandano", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["lavandano"], "contexts": ["lavender, ingredient in pills"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Lavender", "target_book": "polyanthea_medicinal", "target_name": "lavandano", "similarity": 0.847}], "id": 1187, "stable_key": "clu_27698b4b48898c4a", "ground_truth": {"modern_name": "Lavender", "confidence": "high", "type": "plant", "linnaean": "Lavandula", "family": "Lamiaceae", "description": "Aromatic herb with purple flowers, used medicinally.", "note": "Refers to the plant genus Lavandula.", "wikipedia_extract": "Lavandula (common name lavender) is a genus of 47 known species of perennial flowering plants in the sage family, Lamiaceae. It is native to the Old World, primarily found across the drier, warmer regions of the Mediterranean, with an affinity for maritime breezes. Lavender is found on the Iberian Peninsula and around the entirety of the Mediterranean coastline (including the Adriatic coast, the Balkans, the Levant, and coastal North Africa), in parts of Eastern and Southern Africa and the Middle East, as well as in South Asia and on the Indian subcontinent. Many members of the genus are cultivated extensively in temperate climates as ornamental plants for garden and landscape use, for use as culinary herbs, and also commercially for the extraction of essential oils. Lavender is used in traditional medicine and as an ingredient in cosmetics. The genus includes annual or short-lived herbaceous perennial plants and shrub-like perennials, subshrubs or small shrubs."}}, {"canonical_name": "Sum∣mer", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "sum∣mer", "book_id": "english_physician_1652", "name": "Sum∣mer", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Sum∣mer", "Sum̄mer"], "contexts": ["season for flowering and seeding", "season of warmth and growth"]}, {"entity_id": "summo-", "book_id": "polyanthea_medicinal", "name": "Summo-", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Summo-"], "contexts": ["supreme"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Sum∣mer", "target_book": "polyanthea_medicinal", "target_name": "Summo-", "similarity": 0.914}], "id": 1188, "stable_key": "clu_739869120798d0bc", "ground_truth": {"modern_name": "Summer", "confidence": "high", "type": "concept", "description": "The warmest season of the year, between spring and autumn.", "note": "Includes references to Midsummer and abstract concepts of summer.", "wikipedia_extract": "Summer or summertime is the hottest and brightest of the four temperate seasons, occurring after spring and before autumn. At or centred on the summer solstice, daylight hours are the longest and darkness hours are the shortest, with day length decreasing as the season progresses after the solstice. The earliest sunrises and latest sunsets also occur near the date of the solstice. The date of the beginning of summer varies according to definition, climate, tradition, and culture. When it is summer in the Northern Hemisphere, it is winter in the Southern Hemisphere, and vice versa. The modern English summer derives from the Middle English somer, via the Old English sumor."}}, {"canonical_name": "Oyl of Almonds", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "oyl_of_almonds", "book_id": "english_physician_1652", "name": "Oyl of Almonds", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["Oyl of Almonds", "Oyl of Bitter Almonds", "Oyl of sweet and bitter Almonds"], "contexts": ["oil from almonds", "comparison for kernel oil"]}, {"entity_id": "oil_of_almonds", "book_id": "polyanthea_medicinal", "name": "oil of almonds", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["oil of almonds"], "contexts": ["mixed with crystal powder"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Oyl of Almonds", "target_book": "polyanthea_medicinal", "target_name": "oil of almonds", "similarity": 0.92}], "id": 1189, "stable_key": "clu_b07300b7ec98b666", "ground_truth": {"modern_name": "Oil of Almonds", "confidence": "high", "type": "substance", "description": "Oil extracted from almonds, used in remedies.", "note": "Refers to the oil derived from almond kernels.", "wikipedia_extract": "Marzipan is a confection consisting primarily of sugar and almond meal (ground almonds), sometimes augmented with almond oil or extract. It is often made into sweets; common uses are chocolate-covered marzipan and small marzipan imitations of fruits and vegetables. It can also be used in biscuits or rolled into thin sheets and glazed for icing cakes, primarily birthday cakes, wedding cakes and Christmas cakes. Marzipan may also be used as a baking ingredient, as in stollen or banket. In some countries, it is shaped into small figures of animals as a traditional treat for New Year's Day or Christmas. Marzipan is also used in Tortell, and in some versions of king cake eaten during the Carnival season."}}, {"canonical_name": "triſteza", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "triſteza", "book_id": "polyanthea_medicinal", "name": "triſteza", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["triſteza", "atriſteza", "trifteza"], "contexts": ["emotional state, sadness", "passion causing illness"]}, {"entity_id": "terciárias", "book_id": "coloquios_da_orta_1563", "name": "terciárias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["terciárias"], "contexts": ["fever type"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "triſteza", "target_book": "coloquios_da_orta_1563", "target_name": "terciárias", "similarity": 0.844}], "id": 1190, "stable_key": "clu_adcdc6ba575fc3d5", "ground_truth": {"modern_name": "Sadness/Tertian Fever", "confidence": "low", "type": "disease", "description": "Emotional distress or intermittent fever type.", "note": "This cluster conflates two distinct concepts: 'tristeza' (sadness) and 'terciárias' (tertian fever, a type of malaria)."}}, {"canonical_name": "Sol", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "sol", "book_id": "english_physician_1652", "name": "Sol", "category": "CONCEPT", "subcategory": "THEORY", "count": 4, "variants": ["Sol"], "contexts": ["celestial body influencing herb gathering", "astrological influence on diseases"]}, {"entity_id": "solar_systems", "book_id": "connexion_physical_sciences_somerville_1858", "name": "solar systems", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["solar systems"], "contexts": ["systems analogous to our own"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Sol", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "solar systems", "similarity": 0.829}], "id": 1191, "stable_key": "clu_8cf0fcb0bbb47075", "ground_truth": {"modern_name": "Sun", "confidence": "high", "type": "concept", "note": "The term 'Sol' refers to the Sun, both as a celestial body and in its influence on natural phenomena, as well as in a broader metaphorical sense of 'solar systems'.", "wikidata_id": "Q28039407", "wikidata_description": "family name", "wikipedia_extract": "The Sun is the star at the centre of the Solar System. It is a massive, nearly perfect sphere of hot plasma, heated to incandescence by nuclear fusion reactions in its core, radiating the energy from its surface mainly as visible light and infrared radiation with 10% at ultraviolet energies. It is the main source of energy for life on Earth. The Sun has been an object of veneration in many cultures and a central subject for astronomical research since antiquity. The Sun orbits the Galactic Center at a distance of 24,000 to 28,000 light-years. Its mean distance from Earth is about 1.496×108 kilometres or about 8 light-minutes."}}, {"canonical_name": "Thames", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "thames", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Thames", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Thames"], "contexts": ["river with channels filled", "river whose channels are filled by tides"]}, {"entity_id": "thames", "book_id": "english_physician_1652", "name": "Thames", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Thames"], "contexts": ["river where plant grows"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Thames", "target_book": "english_physician_1652", "target_name": "Thames", "similarity": 1.0}], "id": 1192, "stable_key": "clu_0778cc4264fd119d", "ground_truth": {"modern_name": "River Thames", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q19686", "wikidata_description": "river in southern England", "wikipedia_url": "https://en.wikipedia.org/wiki/River%20Thames", "wikipedia_extract": "The River Thames (  TEMZ), known alternatively in parts as the River Isis, is a river that flows through southern England including London. At 215 miles (346 km), it is the longest river entirely in England and the second-longest in the United Kingdom, after the River Severn. The river rises at Thames Head in Gloucestershire and flows into the North Sea near Tilbury, Essex and Gravesend, Kent, via the Thames Estuary. From the west, it flows through Oxford (where it is sometimes called the Isis), Reading, Henley-on-Thames and Windsor. The Thames also drains the whole of Greater London. The lower reaches of the river are called the Tideway, derived from its long tidal reach up to Teddington Lock."}}, {"canonical_name": "Carolines", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "carolines", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Carolines", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Carolines"], "contexts": ["states mentioned", "region in the United States"]}, {"entity_id": "caroline_archipelagoes", "book_id": "origin_of_species_darwin_1859", "name": "Caroline Archipelagoes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Caroline Archipelagoes"], "contexts": ["archipelagoes with peculiar bats"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Carolines", "target_book": "origin_of_species_darwin_1859", "target_name": "Caroline Archipelagoes", "similarity": 0.899}], "id": 1193, "stable_key": "clu_a571d4b0d6fb2e64", "ground_truth": {"modern_name": "Caroline Islands", "confidence": "high", "type": "place", "description": "Archipelago in the western Pacific Ocean.", "note": "The historical mention in Humboldt likely refers to the Caroline Islands. The reference to 'Carolines' as states in the US is less likely in this context, but the 'Caroline Archipelagoes' strongly confirms the islands.", "wikipedia_extract": "The Caroline Islands (or the Carolines) are a widely scattered archipelago of tiny islands in the western Pacific Ocean, to the north of New Guinea. Politically, they are divided between the Federated States of Micronesia (FSM) in the central and eastern parts of the group, and Palau at the extreme western end. Historically, this area was also called Nuevas Filipinas or New Philippines, because they were part of the Spanish East Indies and were governed from Manila in the Philippines. The Carolines are scattered across a distance of approximately 3,540 kilometres (2,200 mi; 1,910 nmi), from the westernmost island, Tobi, in Palau, to the easternmost island, Kosrae, a state of the FSM. The group consists of about 500 small coral islands, east of the Philippines, in the Pacific Ocean. The distance from Yap (one of the larger Caroline islands) to Manila is 1,200 mi (1,900 km)."}}, {"canonical_name": "Giraffe", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "giraffe", "book_id": "origin_of_species_darwin_1859", "name": "Giraffe", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 4, "variants": ["Giraffe", "giraffe"], "contexts": ["long-necked African mammal", "animal with a long neck and tail"]}, {"entity_id": "giraffes", "book_id": "kosmos_humboldt_1845", "name": "giraffes", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["giraffes"], "contexts": ["extant tall mammal"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Giraffe", "target_book": "kosmos_humboldt_1845", "target_name": "giraffes", "similarity": 0.88}], "id": 1194, "stable_key": "clu_343d66c47ea8ffac", "ground_truth": {"modern_name": "Giraffe", "confidence": "high", "type": "animal", "wikidata_id": "Q862089", "wikidata_description": "genus of mammals", "wikipedia_url": "https://en.wikipedia.org/wiki/Giraffe", "wikipedia_extract": "Giraffes (genus Giraffa) are large African hoofed mammals. They are the tallest living terrestrial animals and the largest ruminants on Earth. They are classified under the family Giraffidae, along with their closest extant relative, the okapi. Traditionally, giraffes have been thought of as one species, Giraffa camelopardalis, with nine subspecies. Most recently, researchers proposed dividing them into four extant species, with seven subspecies, which can be distinguished morphologically by their fur coat patterns. Six valid extinct species of Giraffa are known from the fossil record."}}, {"canonical_name": "pachyderms", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "pachyderms", "book_id": "origin_of_species_darwin_1859", "name": "pachyderms", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 4, "variants": ["pachyderms", "Pachyderms"], "contexts": ["order of mammals", "thick-skinned mammals like elephants"]}, {"entity_id": "pachydermata", "book_id": "kosmos_humboldt_1845", "name": "Pachydermata", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Pachydermata"], "contexts": ["thick-skinned mammals"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "pachyderms", "target_book": "kosmos_humboldt_1845", "target_name": "Pachydermata", "similarity": 0.957}], "id": 1195, "stable_key": "clu_239745a91235046b", "ground_truth": {"modern_name": "Pachyderm", "confidence": "high", "type": "animal", "wikidata_id": "Q2735907", "wikidata_description": "skin disease characterized by skin that is loose, hanging, wrinkled and lacking in elasticity; it can also affect connective tissue in other parts of the body, including the heart, blood vessels, joints, intestines and lungs", "wikipedia_url": "https://en.wikipedia.org/wiki/Cutis%20laxa", "wikipedia_extract": "Pachydermata (meaning 'thick skin', from the Greek παχύς, pachys, 'thick', and δέρμα, derma, 'skin') is an obsolete order of mammals described by Gottlieb Storr, Georges Cuvier, and others, at one time recognized by many systematists. The term pachyderm is commonly used to describe elephants, rhinoceroses, hippopotamuses and tapirs. The grouping was determined to be artificial as a biological classification due to genetic studies. Pachydermata is an obsolete order of mammals described by Gottlieb Storr, Georges Cuvier, and others, at one time recognized by many systematists. The grouping is polyphyletic, so the order is no longer in use as a biological classification. Outside strict biological classification, the related term pachyderm is commonly used to describe elephants, rhinoceroses, hippopotamuses and tapirs."}}, {"canonical_name": "Salmons", "category": "ANIMAL", "subcategory": "FISH", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "salmons", "book_id": "origin_of_species_darwin_1859", "name": "Salmons", "category": "ANIMAL", "subcategory": "FISH", "count": 2, "variants": ["salmons", "Salmons"], "contexts": ["example of male fighting behavior", "fish with fighting males"]}, {"entity_id": "salmon", "book_id": "origin_of_species_darwin_1859", "name": "salmon", "category": "ANIMAL", "subcategory": "FISH", "count": 2, "variants": ["salmon"], "contexts": ["fish with hooked jaw", "fish with hooked jaws in males"]}, {"entity_id": "salmon", "book_id": "kosmos_humboldt_1845", "name": "salmon", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["salmon"], "contexts": ["fish whose blood contains animalcules"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Salmons", "target_book": "kosmos_humboldt_1845", "target_name": "salmon", "similarity": 0.919}, {"source_book": "origin_of_species_darwin_1859", "source_name": "salmon", "target_book": "kosmos_humboldt_1845", "target_name": "salmon", "similarity": 1.0}], "id": 1196, "stable_key": "clu_31dc6f23b4dc167e", "ground_truth": {"modern_name": "Salmon", "confidence": "high", "type": "animal", "wikipedia_extract": "Salmon (; pl.: salmon) are any of several commercially important species of euryhaline ray-finned fish from the genera Salmo and Oncorhynchus of the family Salmonidae, native to tributaries of the North Atlantic (Salmo) and North Pacific (Oncorhynchus) basins. Salmon is a colloquial or common name used for fish in this group, but is not a scientific name. Other closely related fish in the same family include trout, char, grayling, whitefish, lenok and taimen, all coldwater fish of the subarctic and cooler temperate regions with some sporadic endorheic populations in Central Asia. Salmon are typically anadromous: they hatch in the shallow gravel beds of freshwater headstreams and spend their juvenile years in rivers, lakes and freshwater wetlands, migrate to the ocean as adults and live like sea fish, then return to their freshwater birthplace to reproduce. However, populations of several species are restricted to fresh waters (i.e. landlocked) throughout their lives. Folklore has it that the fish return to the exact stream where they themselves hatched to spawn, and tracking studies have shown this to be mostly true."}}, {"canonical_name": "Apteryx", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "apteryx", "book_id": "origin_of_species_darwin_1859", "name": "Apteryx", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["Apteryx"], "contexts": ["genus of kiwi birds", "mentioned in text"]}, {"entity_id": "apteryx", "book_id": "kosmos_humboldt_1845", "name": "apteryx", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["apteryx"], "contexts": ["living bird species for comparison", "flightless bird native to New Zealand"]}, {"entity_id": "palapteryx", "book_id": "kosmos_humboldt_1845", "name": "Palapteryx", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Palapteryx"], "contexts": ["genus of extinct birds"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Apteryx", "target_book": "kosmos_humboldt_1845", "target_name": "apteryx", "similarity": 0.976}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Apteryx", "target_book": "kosmos_humboldt_1845", "target_name": "Palapteryx", "similarity": 0.849}], "id": 1197, "stable_key": "clu_45a242e4c2de9dbc", "ground_truth": {"modern_name": "Apteryx", "confidence": "high", "type": "animal", "wikidata_id": "Q43642", "wikidata_description": "genus of birds", "wikipedia_extract": "Kiwi are flightless birds endemic to New Zealand of the order Apterygiformes. The five extant species fall into the family Apterygidae and genus Apteryx. Approximately the size of a domestic chicken, kiwi are the smallest ratites (which also include ostriches, emus, rheas, cassowaries and the extinct elephant birds and moa). DNA sequence comparisons have yielded the conclusion that kiwi are much more closely related to the extinct Malagasy elephant birds than to the moa with which they shared New Zealand. There are five recognised species, four of which are currently listed as vulnerable, and one of which is near threatened. All species have been negatively affected by historic deforestation, but their remaining habitat is well protected in large forest reserves and national parks."}}, {"canonical_name": "bassin", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "bassin", "book_id": "relation_historique_humboldt_vol3_1825", "name": "bassin", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["bassin", "bassins enclavés", "bassins intérieurs"], "contexts": ["river basin", "inland depressions"]}, {"entity_id": "basins", "book_id": "kosmos_humboldt_1845", "name": "basins", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["basins"], "contexts": ["drainage areas of rivers", "depressions in the Earth's surface"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "bassin", "target_book": "kosmos_humboldt_1845", "target_name": "basins", "similarity": 0.89}], "id": 1198, "stable_key": "clu_32931dadfa58b538", "ground_truth": {"modern_name": "River basin", "confidence": "high", "type": "place", "wikipedia_extract": "A drainage basin is an area of land in which all flowing surface water converges to a single point, such as a river mouth, or flows into another body of water, such as a lake or ocean. A basin is separated from adjacent basins by a perimeter, the drainage divide, made up of a succession of elevated features, such as ridges and hills. A basin may consist of smaller basins that merge at river confluences, forming a hierarchical pattern. Other terms for a drainage basin are catchment area, catchment basin, drainage area, river basin, water catchment, water basin, and impluvium. In North America, they are commonly called a watershed, though in other English-speaking places, \"watershed\" is used only in its original sense, that of the drainage divide line. A drainage basin's boundaries are determined by watershed delineation, a common task in environmental engineering and science."}}, {"canonical_name": "law of rotation", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "law_of_rotation", "book_id": "kosmos_humboldt_1845", "name": "law of rotation", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["law of rotation"], "contexts": ["law concerning atmospheric phenomena", "scientific principle"]}, {"entity_id": "rotation_of_the_wind", "book_id": "connexion_physical_sciences_somerville_1858", "name": "rotation of the wind", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["rotation of the wind"], "contexts": ["theory explaining wind circulation patterns", "theory explaining wind movement"]}, {"entity_id": "theory_of_rotation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "theory of rotation", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["theory of rotation"], "contexts": ["scientific theory about planetary rotation"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "law of rotation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "rotation of the wind", "similarity": 0.858}, {"source_book": "kosmos_humboldt_1845", "source_name": "law of rotation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "theory of rotation", "similarity": 0.942}], "id": 1199, "stable_key": "clu_b49205bb568eabde", "ground_truth": {"modern_name": "Law of rotation", "confidence": "high", "type": "concept", "note": "This likely refers to scientific laws or theories concerning rotational motion, including planetary rotation and atmospheric circulation.", "wikipedia_extract": "In linear algebra, a rotation matrix is a transformation matrix that is used to perform a rotation in Euclidean space. For example, using the convention below, the matrix {\\displaystyle R={\\begin{bmatrix}\\cos \\theta &-\\sin \\theta \\\\\\sin \\theta &\\cos \\theta \\end{bmatrix}}\\cdot } rotates points in the xy plane counterclockwise through an angle θ about the origin of a two-dimensional Cartesian coordinate system.", "wikipedia_url": "https://en.wikipedia.org/wiki/Rotation_matrix"}}, {"canonical_name": "D'Orbigny", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "d'orbigny", "book_id": "kosmos_humboldt_1845", "name": "D'Orbigny", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["D'Orbigny"], "contexts": ["described fossils", "described Ammonites and Gryphites"]}, {"entity_id": "d’orbigny", "book_id": "origin_of_species_darwin_1859", "name": "D’Orbigny", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["D’Orbigny"], "contexts": ["conchologist who defined many species"]}, {"entity_id": "alcide_d'orbigny", "book_id": "kosmos_humboldt_1845", "name": "Alcide d'Orbigny", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Alcide d'Orbigny"], "contexts": ["author of 'L'homme Americain'"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "D'Orbigny", "target_book": "origin_of_species_darwin_1859", "target_name": "D’Orbigny", "similarity": 0.996}, {"source_book": "origin_of_species_darwin_1859", "source_name": "D’Orbigny", "target_book": "kosmos_humboldt_1845", "target_name": "Alcide d'Orbigny", "similarity": 0.886}], "id": 1200, "stable_key": "clu_ed90aecfadb34181", "ground_truth": {"modern_name": "Alcide d'Orbigny", "confidence": "high", "type": "person", "birth_year": 1802, "death_year": 1857, "description": "French naturalist, paleontologist, and conchologist, known for extensive fieldwork.", "wikipedia_extract": "Alcide Charles Victor Marie Dessalines d'Orbigny (French pronunciation: [alsid ʃaʁl viktɔʁ maʁi dɛsalin dɔʁbiɲi]; 6 September 1802 – 30 June 1857) was a French naturalist who made major contributions in many areas, including zoology (including malacology), palaeontology, geology, archaeology and anthropology. D'Orbigny was born in Couëron (Loire-Atlantique), the son of a ship's physician and amateur naturalist. The family moved to La Rochelle in 1820, where his interest in natural history was developed while studying the marine fauna and especially the microscopic creatures that he named \"foraminiferans\". In Paris he became a disciple of the geologist Pierre Louis Antoine Cordier (1777–1861) and Georges Cuvier. All his life, he would follow the theory of Cuvier and stay opposed to Lamarckism. D'Orbigny travelled on a mission for the Paris Museum, in South America between 1826 and 1833."}}, {"canonical_name": "Helosciadium", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "helosciadium", "book_id": "origin_of_species_darwin_1859", "name": "Helosciadium", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Helosciadium"], "contexts": ["genus of plants", "plant genus"]}, {"entity_id": "hyoscyamo", "book_id": "ricettario_fiorentino_1597", "name": "Hyoscyamo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Hyoscyamo"], "contexts": ["henbane herb"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Helosciadium", "target_book": "ricettario_fiorentino_1597", "target_name": "Hyoscyamo", "similarity": 0.849}], "id": 1201, "stable_key": "clu_0ad1fd4854d71403", "ground_truth": {"modern_name": "Water-hemlock", "confidence": "high", "type": "PLANT", "description": "A genus of poisonous herbaceous plants, often found near water.", "note": "Helosciadium is an older name for some species now classified under the genus Berula, but it also refers to plants sometimes identified with Henbane (Hyoscyamus).", "wikipedia_extract": "Cicuta, commonly known as water hemlock, is a genus of four species of highly poisonous plants in the family Apiaceae. They are perennial herbaceous plants which grow up to 2.5 meters (8 ft) tall, having distinctive small green or white flowers arranged in an umbrella shape (umbel). Plants in this genus may also be referred to as cowbane or poison parsnip. Cicuta is native to temperate regions of the Northern Hemisphere, mainly North America and Europe, typically growing in wet meadows, along streambanks and other wet and marshy areas. In the United Kingdom it is frequently found along canals. These plants bear a close resemblance to other members in the family Apiaceae and may be confused with a number of edible or poisonous plants."}}, {"canonical_name": "feathers", "category": "ANIMAL", "subcategory": "PRODUCT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "feathers", "book_id": "first_principles_spencer_1862", "name": "feathers", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 3, "variants": ["feathers"], "contexts": ["animal covering, associated with birds", "light objects affected by air resistance"]}, {"entity_id": "feathers", "book_id": "origin_of_species_darwin_1859", "name": "feathers", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 2, "variants": ["feathers"], "contexts": ["product from birds", "lightweight epidermal growths covering birds"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "feathers", "target_book": "origin_of_species_darwin_1859", "target_name": "feathers", "similarity": 1.0}], "id": 1202, "stable_key": "clu_ee7c1c9b37fe5da0", "ground_truth": {"modern_name": "Feathers", "confidence": "high", "type": "concept", "note": "While feathers are derived from animals, the context here refers to the material itself rather than a specific animal.", "wikidata_id": "Q81025", "wikidata_description": "body-covering structure of some dinosaurs including birds", "wikipedia_url": "https://en.wikipedia.org/wiki/Feather", "wikipedia_extract": "Feathers are epidermal growths that form a distinctive outer covering, or plumage, on both avian (bird) and some non-avian dinosaurs and other archosaurs. They are the most complex integumentary structures found in vertebrates and an example of a complex evolutionary novelty. They are among the characteristics that distinguish the extant birds from other living groups. Although feathers cover most of the bird's body, they arise only from certain well-defined tracts on the skin. They aid in flight, thermal insulation, and waterproofing. In addition, coloration helps in communication and protection."}}, {"canonical_name": "beurre", "category": "ANIMAL", "subcategory": "PRODUCT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "beurre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "beurre", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 4, "variants": ["Beurre", "beurre"], "contexts": ["foodstuff in Havana", "butter"]}, {"entity_id": "butter", "book_id": "principles_of_psychology_james_1890", "name": "butter", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["butter"], "contexts": ["dairy product"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "beurre", "target_book": "principles_of_psychology_james_1890", "target_name": "butter", "similarity": 0.904}], "id": 1203, "stable_key": "clu_0ef2532eb50dd363", "ground_truth": {"modern_name": "Butter", "confidence": "high", "type": "ANIMAL", "description": "A dairy product made from churning milk or cream.", "wikipedia_extract": "Butter is a dairy product made from the fat and protein components of churned cream. It is a semi-solid emulsion at room temperature, consisting of approximately 81% butterfat. It is used at room temperature as a spread, melted as a condiment, and used as a fat in baking, sauce-making, pan frying, and other cooking procedures. Most frequently made from cow's milk, butter can also be manufactured from the milk of other mammals, including sheep, goats, buffalo, and yaks. It is made by churning milk or cream to separate the fat globules from the buttermilk. Salt has been added to butter since antiquity to help preserve it, particularly when being transported; salt may still play a preservation role but is less important today as the entire supply chain is usually refrigerated."}}, {"canonical_name": "Copper-Mountain", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "copper-mountain", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Copper-Mountain", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Copper-Mountain", "Copper Mine River", "Copper-Mountains"], "contexts": ["mountain name", "mountain range name"]}, {"entity_id": "copper_river", "book_id": "kosmos_humboldt_1845", "name": "Copper River", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Copper River"], "contexts": ["mouth where Hearne observed"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Copper-Mountain", "target_book": "kosmos_humboldt_1845", "target_name": "Copper River", "similarity": 0.873}], "id": 1204, "stable_key": "clu_c8b6bb9f40c33073", "ground_truth": {"modern_name": "Copper River", "confidence": "high", "type": "place", "country": "United States", "note": "The primary reference seems to be to the Copper River, with 'Copper-Mountain' likely a derivative or less common usage in this context.", "wikidata_id": "Q1131444", "wikidata_description": "river in Alaska", "wikipedia_url": "https://en.wikipedia.org/wiki/Copper_River_(Alaska)", "wikipedia_extract": "The Copper River or Ahtna River (;  Ahtena: ‘Atna’tuu [ʔatʰnaʔtʰuː], \"river of the Ahtnas\"; Tlingit: Eeḵhéeni [ʔìːq.híː.nì]), \"river of copper\", is a 290-mile (470 km) river in south-central Alaska in the United States. It drains a large region of the Wrangell Mountains and Chugach Mountains into the Gulf of Alaska. It is known for its extensive delta ecosystem, as well as for its prolific runs of wild salmon, which are among the most highly prized stocks in the world. The river is the tenth largest in the United States, as ranked by average discharge volume at its mouth. The Copper River rises out of the Copper Glacier, which lies on the northeast side of Mount Wrangell, in the Wrangell Mountains, within Wrangell-Saint Elias National Park. It begins by flowing almost due north in a valley that lies on the east side of Mount Sanford, and then turns west, forming the northwest edge of the Wrangell Mountains and separating them from the Mentasta Mountains to the northeast."}}, {"canonical_name": "Moreau de Jonnès", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "moreau_de_jonnès", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Moreau de Jonnès", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Moreau de Jonnès", "Moreau de Jonnes", "Moreau de Jonnés"], "contexts": ["mentioned in passage", "author of 'Hist. phys. dct Ant.'"]}, {"entity_id": "moreau_de_jonnes", "book_id": "kosmos_humboldt_1845", "name": "Moreau de Jonnes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Moreau de Jonnes"], "contexts": ["author of 'Hist. Phys. des Antilles'"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Moreau de Jonnès", "target_book": "kosmos_humboldt_1845", "target_name": "Moreau de Jonnes", "similarity": 0.979}], "id": 1205, "stable_key": "clu_27a48860a32d7fa3", "ground_truth": {"modern_name": "Alexandre Moreau de Jonnès", "confidence": "high", "type": "person", "birth_year": 1778, "death_year": 1870, "description": "French naturalist, physician, and politician; author of works on natural history.", "wikidata_id": "Q2833893", "wikidata_description": "French geologist, officer, physician and politician", "wikipedia_extract": "San Diego de los Baños is a consejo popular (\"popular council\") and urban settlement in Los Palacios, Pinar del Río Province, Cuba. The consejo popular is in the east of the Pinar del Río Province. It is located 22 km north-east of Los Palacios, in the Vuelta Abajo area. It borders the consejos populares Entronque de Palacios to the east and Paso Quemado to the south-east. Pinar del Río is 56 km (by road) to the south-west. It stands near the western end and at the foot of sierra de Rosarios, on the south side of that mountain range.", "wikipedia_url": "https://fr.wikipedia.org/wiki/Alexandre_Moreau_de_Jonn%C3%A8s"}}, {"canonical_name": "TOrénoque", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "torénoque", "book_id": "relation_historique_humboldt_vol3_1825", "name": "TOrénoque", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["TOrénoque"], "contexts": ["granitic mountain chains", "river name"]}, {"entity_id": "totonilco", "book_id": "kosmos_humboldt_1845", "name": "Totonilco", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Totonilco"], "contexts": ["neighborhood location"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "TOrénoque", "target_book": "kosmos_humboldt_1845", "target_name": "Totonilco", "similarity": 0.854}], "id": 1206, "stable_key": "clu_ddc0ef8454e5ff45", "ground_truth": {"modern_name": "Totonilco", "confidence": "high", "type": "place", "country": "Mexico", "note": "The spelling 'TOrénoque' is likely an OCR error or historical transliteration variant of Totonilco, given the context and the alternative spelling in the Kosmos reference."}}, {"canonical_name": "Quixos", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "quixos", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Quixos", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Quixos"], "contexts": ["city with population 35,000", "province name"]}, {"entity_id": "quixos", "book_id": "kosmos_humboldt_1845", "name": "Quixos", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Quixos"], "contexts": ["province"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Quixos", "target_book": "kosmos_humboldt_1845", "target_name": "Quixos", "similarity": 1.0}], "id": 1207, "stable_key": "clu_346ceb943356430d", "ground_truth": {"modern_name": "Quixos", "confidence": "high", "type": "place", "country": "Ecuador", "note": "Refers to a historical province and indigenous group in present-day Ecuador."}}, {"canonical_name": "Maryland", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "maryland", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Maryland", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Maryland"], "contexts": ["state mentioned", "confederated state in the United States"]}, {"entity_id": "maryland", "book_id": "kosmos_humboldt_1845", "name": "Maryland", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Maryland"], "contexts": ["location where aerolite fell"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Maryland", "target_book": "kosmos_humboldt_1845", "target_name": "Maryland", "similarity": 1.0}], "id": 1208, "stable_key": "clu_2a367561caca95c2", "ground_truth": {"modern_name": "Maryland", "confidence": "high", "type": "place", "country": "United States", "wikidata_id": "Q37452664", "wikidata_description": "family name", "wikipedia_extract": "Maryland (US:   MERR-il-ənd) is a state in the Mid-Atlantic and Southern regions of the United States. It borders the states of Virginia to its south, West Virginia to its west, Pennsylvania to its north, and Delaware to its east, as well as with the Atlantic Ocean to its east, and the national capital and federal district of Washington, D.C. to the southwest. With a total area of 12,407 square miles (32,130 km2), Maryland is the ninth-smallest state by land area, and its population of 6,177,224 ranks it the 19th-most populous state and the fifth-most densely populated. Maryland's capital city is Annapolis, and the state's most populous city is Baltimore. Maryland's coastline was first explored by Europeans in the 16th century. Prior to that, it was inhabited by several Native American tribes, mostly the Algonquian peoples."}}, {"canonical_name": "Astrakhan", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "astrakhan", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Astrakhan", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Astrakhan"], "contexts": ["government in Piussle", "Wologda et Astrakhan 52"]}, {"entity_id": "astrachan", "book_id": "kosmos_humboldt_1845", "name": "Astrachan", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Astrachan"], "contexts": ["city with luxuriant fruit"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Astrakhan", "target_book": "kosmos_humboldt_1845", "target_name": "Astrachan", "similarity": 0.92}], "id": 1209, "stable_key": "clu_4ac1e12b8d94a715", "ground_truth": {"modern_name": "Astrakhan", "confidence": "high", "type": "place", "country": "Russia", "note": "The spelling 'Astrachan' is an older transliteration of Astrakhan.", "wikidata_id": "Q3927", "wikidata_description": "city in the south of Russia", "wikipedia_extract": "Astrakhan (Russian: Астрахань, IPA: [ˈastrəxənʲ] ) is the largest city and administrative centre of Astrakhan Oblast in southern Russia. The city lies on two banks of the Volga, in the upper part of the Volga Delta, on eleven islands of the Caspian Depression, 100 km (62 mi) from the Caspian Sea, with a population of 475,629 residents at the 2021 Census. At an elevation of 28 meters (92 ft) below sea level, it is the lowest city in Russia. Astrakhan was formerly the capital of the Khanate of Astrakhan (a remnant of the Golden Horde) of the Astrakhan Tatars, and was located on the higher right bank of the Volga, eleven kilometres (6.8 mi) from the present-day city. Situated on caravan and water routes, it developed from a village into a large trading centre, before being conquered by Timur in 1395 and captured by Ivan the Terrible in 1556 and in 1558 it was moved to its present site. The oldest economic and cultural center of the Lower Volga region, it is often called the southernmost outpost of Russia, and the Caspian capital."}}, {"canonical_name": "celtique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "celtique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "celtique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["celtique", "celtique de l'Ecosse"], "contexts": ["language used to escape Indians", "language spoken by a tribe"]}, {"entity_id": "langue_celtique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "langue celtique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["langue celtique"], "contexts": ["Celtic language"]}, {"entity_id": "celtic", "book_id": "kosmos_humboldt_1845", "name": "Celtic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Celtic"], "contexts": ["related to Celtic peoples/regions"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "celtique", "target_book": "kosmos_humboldt_1845", "target_name": "Celtic", "similarity": 0.944}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "langue celtique", "target_book": "kosmos_humboldt_1845", "target_name": "Celtic", "similarity": 0.875}], "id": 1210, "stable_key": "clu_3e49ce5affbf59cf", "ground_truth": {"modern_name": "Celtic languages", "confidence": "high", "type": "concept", "note": "The cluster refers to the concept of the Celtic language or peoples, not a single text.", "wikidata_id": "Q25293", "wikidata_description": "language family", "wikipedia_extract": "The Celtic languages (  KEL-tik) are a branch of the Indo-European language family, descended from the hypothetical Proto-Celtic language. The term \"Celtic\" was first used to describe this language group by Edward Lhuyd in 1707, following Paul-Yves Pezron, who made the explicit link between the Celts described by classical writers and the Welsh and Breton languages. During the first millennium BC, Celtic languages were spoken across much of Europe and central Anatolia. Today, they are restricted to the northwestern fringe of Europe and a few diaspora communities. There are six living languages: the four continuously living languages Breton, Irish, Scottish Gaelic and Welsh, and the two revived languages Cornish and Manx. All are minority languages in their respective countries, though there are continuing efforts at revitalisation.", "wikipedia_url": "https://en.wikipedia.org/wiki/Celtic_languages"}}, {"canonical_name": "Castille", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "castille", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Castille", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Castille", "Castilla del Oro"], "contexts": ["kingdom in Spain", "unit of weight for gold"]}, {"entity_id": "castalia", "book_id": "kosmos_humboldt_1845", "name": "Castalia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Castalia"], "contexts": ["spring at Delphi", "spring at the foot of Phaedriadae"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Castille", "target_book": "kosmos_humboldt_1845", "target_name": "Castalia", "similarity": 0.971}], "id": 1211, "stable_key": "clu_323cbe4b7a2c4e67", "ground_truth": {"modern_name": "Castile", "confidence": "high", "type": "place", "country": "Spain", "note": "The context 'spring at Delphi' might refer to Castalia, a spring at Delphi, but the dominant references point to the historical region in Spain, especially given the context of 'kingdom in Spain'. Humboldt's 'Relation historique' and 'Kosmos' would primarily use 'Castille' for the Spanish region.", "wikidata_id": "Q217196", "wikidata_description": "former country", "wikipedia_url": "https://en.wikipedia.org/wiki/Crown_of_Castile", "wikipedia_extract": "On July 6, 2016, Philando Castile, a 32-year-old African American man, was fatally shot during a traffic stop by police officer Jeronimo Yanez of the St. Anthony police department in the Minneapolis–Saint Paul metropolitan area. About 9 p.m., Castile was driving with his girlfriend, Diamond Reynolds, and her four-year-old daughter when he was pulled over by Yanez and another officer in Falcon Heights, a suburb of Saint Paul, Minnesota. Castile, who was licensed to carry a firearm, told Yanez that he had a firearm. Yanez replied, \"Don't reach for it then\". Castile responded, \"I'm, I, I was reaching for...\", to which Yanez replied, \"Don't pull it out\"."}}, {"canonical_name": "Prague", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "prague", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Prague", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Prague"], "contexts": ["city", "location of herbaria"]}, {"entity_id": "prague", "book_id": "kosmos_humboldt_1845", "name": "Prague", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Prague"], "contexts": ["European city observing magnetic disturbance", "location of magnetic storm observation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Prague", "target_book": "kosmos_humboldt_1845", "target_name": "Prague", "similarity": 1.0}], "id": 1212, "stable_key": "clu_4cb9c4ad79549c34", "ground_truth": {"modern_name": "Prague", "confidence": "high", "type": "place", "country": "Czech Republic", "wikidata_id": "Q1085", "wikidata_description": "capital city of the Czech Republic", "wikipedia_url": "https://en.wikipedia.org/wiki/Prague", "wikipedia_extract": "Prague ( PRAHG; Czech: Praha [ˈpraɦa] ) is the capital and largest city of the Czech Republic and the historical capital of Bohemia. Prague, located on the Vltava River, has a population of about 1.4 million, while its metropolitan area is home to approximately 2.3 million people. Prague is a historical city with Romanesque, Gothic, Renaissance, and Baroque architecture. It was the capital of the Kingdom of Bohemia and residence of several Holy Roman Emperors, most notably Charles IV (r. 1346–1378) and Rudolf II (r. 1575–1611)."}}, {"canonical_name": "Villa de Ibarra", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "villa_de_ibarra", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Villa de Ibarra", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Villa de Ibarra"], "contexts": ["town near Imbabura volcano", "town in the province"]}, {"entity_id": "ibarra", "book_id": "kosmos_humboldt_1845", "name": "Ibarra", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Ibarra"], "contexts": ["city hearing subterranean noise", "mountain town north of Quito"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Villa de Ibarra", "target_book": "kosmos_humboldt_1845", "target_name": "Ibarra", "similarity": 0.851}], "id": 1213, "stable_key": "clu_ab5c585848d7d4d8", "ground_truth": {"modern_name": "Ibarra", "confidence": "high", "type": "place", "country": "Ecuador", "note": "The 'Villa de Ibarra' refers to the city in Ecuador, closely associated with the Imbabura volcano. 'Ibarra' is a common place name, but the context provided by Humboldt's work points to the Ecuadorian location.", "wikidata_id": "Q946384", "wikidata_description": "city in Ecuador, capital of the Imbabura Province", "wikipedia_url": "https://en.wikipedia.org/wiki/Ibarra%2C%20Ecuador"}}, {"canonical_name": "Pétersbourg", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "pétersbourg", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pétersbourg", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Pétersbourg"], "contexts": ["city in Russia", "to Petersburg"]}, {"entity_id": "st__pétersbourg", "book_id": "kosmos_humboldt_1845", "name": "St. Pétersbourg", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["St. Pétersbourg"], "contexts": ["city of the Academy", "city of imperial academy"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pétersbourg", "target_book": "kosmos_humboldt_1845", "target_name": "St. Pétersbourg", "similarity": 0.947}], "id": 1214, "stable_key": "clu_fda69b2987f774b7", "ground_truth": {"modern_name": "Saint Petersburg", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q656", "wikidata_description": "federal city and former capital of Russia", "wikipedia_url": "https://en.wikipedia.org/wiki/Saint%20Petersburg", "wikipedia_extract": "Saint Petersburg, formerly known as Petrograd (Петроград) and later Leningrad (Ленинград), is the second-largest city in Russia, after Moscow, the nation's capital. It is situated on the River Neva, at the head of the Gulf of Finland on the Baltic Sea. With an area of 1,439 square kilometers (556 square miles), Saint Petersburg is the smallest administrative division of Russia by area. The city had a population of 5,601,911 residents as of 2021, with more than 6.4 million people living in the metropolitan area. Saint Petersburg is the fourth-most populous city in Europe, the most populous city on the Baltic Sea, and the world's northernmost city of more than 1 million residents. As the former capital of the Russian Empire, and a historically strategic port, it is governed as a federal city."}}, {"canonical_name": "volcaniques", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "volcaniques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "volcaniques", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["volcaniques", "Volcanisme"], "contexts": ["theory of mountain formation", "geological theory"]}, {"entity_id": "volcanic_theory", "book_id": "kosmos_humboldt_1845", "name": "volcanic theory", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["volcanic theory"], "contexts": ["explanation of volcanic activity"]}, {"entity_id": "volcanic_chains", "book_id": "kosmos_humboldt_1845", "name": "volcanic chains", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["volcanic chains"], "contexts": ["geological formations of volcanoes"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "volcaniques", "target_book": "kosmos_humboldt_1845", "target_name": "volcanic theory", "similarity": 0.963}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "volcaniques", "target_book": "kosmos_humboldt_1845", "target_name": "volcanic chains", "similarity": 0.868}], "id": 1215, "stable_key": "clu_1545de53332f1b05", "ground_truth": {"modern_name": "Volcanic theory", "confidence": "high", "type": "concept", "note": "The term 'volcaniques' is an adjective, but in this context it refers to the concept or theory of volcanic activity and formation.", "wikipedia_extract": "A species (pl. species) is the basic unit of classification and a taxonomic rank of an organism, as well as a unit of biodiversity. It can be defined as the largest group of organisms in which any two individuals of the appropriate sexes or mating types can produce fertile offspring, typically by sexual reproduction. Other ways of defining species include their karyotype, DNA sequence, morphology, behaviour, or ecological niche. In addition, palaeontologists use the concept of the chronospecies since fossil reproduction cannot be examined. The most recent rigorous estimate for the total number of species of eukaryotes is between 8 and 8.7 million.", "wikipedia_url": "https://en.wikipedia.org/wiki/Species"}}, {"canonical_name": "transition formation", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "transition_formation", "book_id": "kosmos_humboldt_1845", "name": "transition formation", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["transition formation"], "contexts": ["geological period", "geological period/layer"]}, {"entity_id": "de_transition", "book_id": "relation_historique_humboldt_vol3_1825", "name": "de transition", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["de transition", "transition"], "contexts": ["transition terrain", "transition rocks"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "transition formation", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "de transition", "similarity": 0.918}], "id": 1216, "stable_key": "clu_c75e5bce532d37ee", "ground_truth": {"modern_name": "Transition formation", "confidence": "high", "type": "concept", "note": "This refers to geological strata or periods of transition in rock formation.", "wikipedia_extract": "In chemistry, substance is a unique form of matter with constant chemical composition and characteristic properties. Chemical substances may take the form of a single element or chemical compounds. If two or more chemical substances can be combined without reacting, they may form a chemical mixture. If a mixture is separated to isolate one chemical substance to a desired degree, the resulting substance is said to be chemically pure. Chemical substances can exist in several different physical states or phases (e.g. solids, liquids, gases, or plasma) without changing their chemical composition.", "wikipedia_url": "https://en.wikipedia.org/wiki/Substance_(chemistry)"}}, {"canonical_name": "Bilin", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "bilin", "book_id": "kosmos_humboldt_1845", "name": "Bilin", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Bilin"], "contexts": ["location of polishing slate", "location of polishing slate deposits"]}, {"entity_id": "bilin-stein", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bilin-Stein", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Bilin-Stein", "Bilincr-Stein"], "contexts": ["location in Bohemia with phonolithe", "location in Bohemia where phonolithe is found"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Bilin", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Bilin-Stein", "similarity": 0.833}], "id": 1217, "stable_key": "clu_e17081066fe59c96", "ground_truth": {"modern_name": "Bílina", "confidence": "high", "type": "place", "country": "Czech Republic", "note": "'Bilin-Stein' is an older German name for a type of phonolithe found near Bílina, Bohemia (now Czech Republic).", "wikipedia_extract": "Bílina (Czech pronunciation: [ˈbiːlɪna]; German: Bilin) is a town in Teplice District in the Ústí nad Labem Region of the Czech Republic. It has about 14,000 inhabitants. It is known for its spas and as a source of the strongly mineralized water, Bílinská kyselka. The historic town centre is well preserved and is protected as an urban monument zone. Bílina consists of six municipal parts (in brackets population according to the 2021 census): The name of the town originates from the adjective bílý (bielý in Old Czech), meaning 'white'. The term Bielina ('white/bald place') is etymologically derived either from fact there was an area without any wood or from sparkling waters of the Bílina river (formerly called Bělá)."}}, {"canonical_name": "Peloponnesus", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "peloponnesus", "book_id": "kosmos_humboldt_1845", "name": "Peloponnesus", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Peloponnesus"], "contexts": ["region where Nemæan Lion fell", "Greek peninsula"]}, {"entity_id": "péloponnèse", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Péloponnèse", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Péloponnèse"], "contexts": ["region in Greece", "peninsula in Greece"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Peloponnesus", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Péloponnèse", "similarity": 0.972}], "id": 1218, "stable_key": "clu_71ceb02427ed1d95", "ground_truth": {"modern_name": "Peloponnese", "confidence": "high", "type": "place", "country": "Greece", "wikidata_id": "Q1572648", "wikidata_description": "species of reptile", "wikipedia_extract": "The Peloponnese, Peloponnesus, or Morea, is a peninsula and geographic region in Southern Greece, and the southernmost region of the Balkans. It is connected to the central part of the country by the Isthmus of Corinth land bridge, which separates the Gulf of Corinth from the Saronic Gulf. From the late Middle Ages until the 19th century, the peninsula was known as the Morea, a name still in colloquial use in its demotic form. The peninsula is divided among three administrative regions: most belong to the Peloponnese region, with smaller parts belonging to the West Greece and Attica regions. The Peloponnese is a peninsula located at the southern tip of the mainland, 21,549.6 square kilometres (8,320.3 mi2) in area, and constitutes the southernmost part of mainland Greece. It is connected to the mainland by the Isthmus of Corinth, where the Corinth Canal was constructed in 1893.", "wikipedia_url": "https://en.wikipedia.org/wiki/Peloponnese_wall_lizard"}}, {"canonical_name": "Popocatepetl", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "popocatepetl", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Popocatepetl", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Popocatepetl"], "contexts": ["volcanoes of Popocatepetl", "volcano in Anahuac group"]}, {"entity_id": "popocatepetl", "book_id": "kosmos_humboldt_1845", "name": "Popocatepetl", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Popocatepetl"], "contexts": ["volcano near Tlascala", "volcano in the New World"]}, {"entity_id": "popocatepel", "book_id": "kosmos_humboldt_1845", "name": "Popocatepel", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Popocatepel"], "contexts": ["volcanic mountain in Mexico"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Popocatepetl", "target_book": "kosmos_humboldt_1845", "target_name": "Popocatepetl", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Popocatepetl", "target_book": "kosmos_humboldt_1845", "target_name": "Popocatepel", "similarity": 0.959}], "id": 1219, "stable_key": "clu_f3291fd3fd782e20", "ground_truth": {"modern_name": "Popocatépetl", "confidence": "high", "type": "place", "country": "Mexico", "wikidata_id": "Q181157", "wikidata_description": "North America volcano", "wikipedia_url": "https://en.wikipedia.org/wiki/Popocat%C3%A9petl", "wikipedia_extract": "Popocatépetl (UK:  POP-ə-KAT-ə-pet-əl, -⁠kat-ə-PET-əl, US:  POHP-, Spanish: [popokaˈtepetl] ; Nahuatl languages: Popōcatepētl [popoːkaˈtepeːt͡ɬ] ) is an active stratovolcano located in the states of Puebla, Morelos, and Mexico in central Mexico. It lies in the eastern half of the Trans-Mexican Volcanic Belt. At 5,393 m (17,694 ft) it is the second highest peak in Mexico, after Citlaltépetl (Pico de Orizaba) at 5,636 m (18,491 ft). Popocatépetl is ranked 89th by prominence. It is linked to the twin volcano of Iztaccihuatl to the north by the high saddle known as the \"Paso de Cortés\". Izta-Popo Zoquiapan National Park, wherein the two volcanoes are located, is named after them."}}, {"canonical_name": "Parian marbles", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "parian_marbles", "book_id": "kosmos_humboldt_1845", "name": "Parian marbles", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Parian Marbles", "Parian marbles"], "contexts": ["ancient inscribed marbles", "celebrated marble for art"]}, {"entity_id": "marbre_de_paros", "book_id": "relation_historique_humboldt_vol3_1825", "name": "marbre de Paros", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["marbre de Paros"], "contexts": ["marble from Paros"]}, {"entity_id": "parian_marble", "book_id": "kosmos_humboldt_1845", "name": "Parian marble", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Parian marble"], "contexts": ["type of granular limestone", "marble from Paros, used for statuary"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Parian marbles", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "marbre de Paros", "similarity": 0.875}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "marbre de Paros", "target_book": "kosmos_humboldt_1845", "target_name": "Parian marble", "similarity": 0.88}], "id": 1220, "stable_key": "clu_53485662ddbfbfd3", "ground_truth": {"modern_name": "Parian marble", "confidence": "high", "type": "mineral", "wikidata_id": "Q2052367", "wikidata_description": "fine-grained white marble quarried on Paros and used for sculpture", "wikipedia_url": "https://en.wikipedia.org/wiki/Parian%20marble", "wikipedia_extract": "Parian marble is a fine-grained, semi translucent, and pure-white marble quarried during the classical era on the Greek island of Paros in the Aegean Sea. A subtype, referred to as Parian lychnites, was particularly notable in antiquity by ancient Greeks as a material for making sculptures. Some of the greatest masterpieces of ancient Greek sculpture were carved from Parian marble, including the Medici Venus, the Venus de Milo, and the Winged Victory of Samothrace. Archeological fieldwork on Paros has identified extensive ancient marble open-pit quarries, with the most significant sites being found at Chorodaki, Marathi, and Agios Minas. In addition to these open-pit quarries, shaft quarries were also used to mine Parian marble. There were two notable shafts in the valley of Agios Minas, identified as the \"Grotto of the Nymphs\" and the \"Grotto of Pan\" because of the relief carvings located near the entrances to the shafts, and the size of these two shafts led to a mistaken assumption by some scholars, influenced by the writing of Raniero Gnoli in his book Marmora romana, that Parian marble could only be obtained in small blocks (roughly c. 1 m³)."}}, {"canonical_name": "Barnaul", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "barnaul", "book_id": "kosmos_humboldt_1845", "name": "Barnaul", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Barnaul"], "contexts": ["location of magnetic station", "city on magnetic stations line"]}, {"entity_id": "barnaul", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Barnaul", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Barnaul"], "contexts": ["city for observation"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Barnaul", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Barnaul", "similarity": 1.0}], "id": 1221, "stable_key": "clu_897790439691117d", "ground_truth": {"modern_name": "Barnaul", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q6014", "wikidata_description": "city in eastern Russia", "wikipedia_url": "https://en.wikipedia.org/wiki/Barnaul", "wikipedia_extract": "Barnaul (Russian: Барнау́л, IPA: [bərnɐˈul] ) is the largest city and administrative centre of Altai Krai, Russia, located at the confluence of the Barnaulka and Ob rivers in the West Siberian Plain. As of the 2021 census, its population was 630,877, making it the 20th-largest city in Russia and the fourth-largest in the Siberian Federal District. Located in the south of western Siberia on the left bank of the Ob River, Barnaul is a major transport, industrial, cultural, medical and educational hub of Siberia. Barnaul was founded by the wealthy Demidov family, who intended to develop the production of copper and silver, which continued after the factories were taken over by the Crown. Barnaul became a major centre of silver production in Russia. Barnaul was granted city status in 1771."}}, {"canonical_name": "Pondichéry", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "pondichéry", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pondichéry", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Pondichéry", "Pondiciiéry"], "contexts": ["independent settlement", "Pondicherry"]}, {"entity_id": "pondichéry", "book_id": "coloquios_da_orta_1563", "name": "Pondichéry", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Pondichéry"], "contexts": ["location of cholera epidemics"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pondichéry", "target_book": "coloquios_da_orta_1563", "target_name": "Pondichéry", "similarity": 1.0}], "id": 1222, "stable_key": "clu_a78d89c8f8f81b7d", "ground_truth": {"modern_name": "Pondicherry", "confidence": "high", "type": "PLACE", "description": "A city and union territory in India, formerly a French colonial settlement.", "wikipedia_extract": "Pondicherry, officially known as Puducherry, is the capital and most populous city of the Union Territory of Puducherry in India. The city is in the Puducherry district on the southeast coast of India and is surrounded by the Bay of Bengal to the east and the state of Tamil Nadu, with which it shares most of its culture, heritage, and language. Puducherry, formerly known as Pondicherry, gained its significance as \"the French Riviera of the East\" after the advent of French colonialisation in India. Puducherry is the Tamil interpretation of \"new town\" and mainly derives from \"Poduke\", the name of the marketplace or \"port town\" for Roman trade in the 1st century, as mentioned in the Periplus of the Erythraean Sea. The settlement was once an abode of learned scholars versed in the Vedas, hence it was also known as Vedapuri. The history of Puducherry can broadly be classified into two periods: pre-colonial and colonial."}}, {"canonical_name": "Geloulo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "geloulo", "book_id": "coloquios_da_orta_1563", "name": "Geloulo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Geloulo"], "contexts": ["island where cloves are produced", "erroneously cited island"]}, {"entity_id": "gilolo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Gilolo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Gilolo"], "contexts": ["Island whose distance from Brazil was disputed", "location in the Moluccas archipelago"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Geloulo", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Gilolo", "similarity": 0.88}], "id": 1223, "stable_key": "clu_24c7e62552bacc0d", "ground_truth": {"modern_name": "Tidore", "confidence": "medium", "type": "place", "description": "Island in the Moluccas archipelago, historically important for spice trade.", "note": "Historical sources use variations for islands in the Moluccas archipelago. 'Geloulo' and 'Gilolo' likely refer to the island of Tidore or the wider region.", "wikipedia_extract": "Tidore (Indonesian: Kota Tidore Kepulauan, lit. \"City of Tidore Islands\") is a city, island, and archipelago in the Maluku Islands of eastern Indonesia, west of the larger island of Halmahera. Part of North Maluku Province, the city includes the island of Tidore (with three smaller outlying islands - Mare, Maitara and Filonga) together with a large part of Halmahera Island to its east. In the pre-colonial era, the Sultanate of Tidore was a major regional political and economic power, and a fierce rival of nearby Ternate, just to the north. Included within the city is the provincial capital, Sofifi, which is situated on the mainland of Halmahera (in North Oba District). Tidore Island consists of a large stratovolcano which rises from the seafloor to an elevation of 1,730 m (5,676 ft) above sea level at the conical Kie Matubu on the south end of the island. The northern side of the island contains a caldera, Sabale, with two smaller volcanic cones within it."}}, {"canonical_name": "Ava", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "ava", "book_id": "coloquios_da_orta_1563", "name": "Ava", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Ava"], "contexts": ["city almiscar comes through", "ancient capital city"]}, {"entity_id": "avidi", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Avidi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Avidi"], "contexts": ["alternative name for Monts Abibe"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Ava", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Avidi", "similarity": 0.851}], "id": 1224, "stable_key": "clu_c8fd465ec1f3edea", "ground_truth": {"modern_name": "Ava", "confidence": "high", "type": "place", "description": "Ancient capital of Burma (Myanmar).", "note": "'Avidi' might be a misspelling or alternative name for a location in Brazil, distinct from Ava, Burma.", "wikipedia_extract": "Bago (formerly spelled Pegu; Burmese: ပဲခူးမြို့, MLCTS: pai: khu: mrui., IPA: [bəɡó mjo̰]), formerly known as Hanthawaddy, is the capital of the Bago Region in Myanmar. It is located 91 kilometres (57 mi) north-east of Yangon. The city had a population of 179,505 people in 2019 and was a historical capital of the Taungoo Dynasty and is known for its large pagodas. The Burmese name Bago (ပဲခူး) is likely derived from the Mon language place name Bagaw (Mon: ဗဂေါ, [bəkɜ̀]). Until the Burmese government renamed English place names throughout the country in 1989, Bago was known as Pegu. Bago was formerly known as Hanthawaddy (Burmese: ဟံသာဝတီ; Mon: ဟံသာဝတဳ Hongsawatoi; Pali: Haṃsāvatī; lit. \"she who possesses the sheldrake\"), the name of a Burmese-Mon kingdom."}}, {"canonical_name": "Temate", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "temate", "book_id": "coloquios_da_orta_1563", "name": "Temate", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Temate"], "contexts": ["one of the five Moluccas islands", "island where fortress was built"]}, {"entity_id": "temi", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Temi", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Temi"], "contexts": ["geographic location"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Temate", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Temi", "similarity": 0.892}], "id": 1225, "stable_key": "clu_099957d2881cdbe3", "ground_truth": {"modern_name": "Ternate", "confidence": "high", "type": "place", "description": "Island in the Moluccas archipelago, key to the spice trade.", "note": "'Temate' and 'Temi' are likely variations referring to Ternate.", "wikipedia_extract": "Ternate (Indonesian pronunciation: [t̪ərˈnat̪e]), also known as the City of Ternate (Indonesian: Kota Ternate; Indonesian pronunciation: [ˌkot̪a t̪ərˈnat̪e]), is the city with the largest population in the province of North Maluku and an island in the Maluku Islands, Indonesia. It was the de facto provincial capital of North Maluku before Sofifi on the nearby coast of Halmahera became the capital in 2010. It is off the west coast of Halmahera, and is composed of five islands: Ternate, the biggest and main island of the city, and Moti, Hiri, Tifure and Mayau (the latter two constitute the Batang Dua Islands, together with the small ofshore islets of Makka, Mano and Gurida). In total, the city has a land area of 162.20 square kilometres and had a total population of 185,705 according to the 2010 census, and 205,001 according to the 2020 census, with a density of 1,264 people per square kilometre; the official estimate as at mid 2024 was 210,836 (comprising 104,128 males and 100,792 females in 2023). It is the biggest and most densely populated city in the province, as well as the economic, cultural, and education center of North Maluku, and acts as a hub to neighbouring regions. It was the capital of the Sultanate of Ternate in the 15th and 16th centuries, and fought against the Sultanate of Tidore over control of the spice trade in the Moluccas before becoming a main interest to competing European powers."}}, {"canonical_name": "Beber", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "beber", "book_id": "coloquios_da_orta_1563", "name": "Beber", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Beber", "beber"], "contexts": ["bodily function of drinking", "commander of Mongol troops, likely Babur"]}, {"entity_id": "bebarà", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bebarà", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Bebarà"], "contexts": ["river mouth for correspondence"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Beber", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Bebarà", "similarity": 0.87}], "id": 1226, "stable_key": "clu_dbe536b77b91a11d", "ground_truth": {"modern_name": "Babur", "confidence": "low", "type": "person", "description": "Founder of the Mughal Empire, a commander of Mongol troops.", "note": "Contexts suggest the founder of the Mughal Empire, Babur, rather than a place.", "wikipedia_extract": "Babur (Persian: ببر, Persian: [bɑː.βuɾ]; 14 February 1483 – 26 December 1530; born Zahīr ud-Dīn Muhammad) was the founder of the Mughal Empire in the Indian subcontinent. He was a descendant of Timur and Genghis Khan through his father and mother respectively. He was also given the posthumous name of Firdaws Makani ('Dwelling in Paradise'). Born in Andijan in the Fergana Valley (now in Uzbekistan), Babur was the eldest son of Umar Shaikh Mirza II (1456–1494, Timurid governor of Fergana from 1469 to 1494) and a great-great-great-grandson of Timur (1336–1405). Babur ascended the throne of Fergana in its capital Akhsikath in 1494 at the age of twelve and faced rebellion. He conquered Samarkand two years later, only to lose Fergana soon after."}}, {"canonical_name": "cent.", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "cent_", "book_id": "relation_historique_humboldt_vol3_1825", "name": "cent.", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["cent."], "contexts": ["temperature unit", "unit of temperature measurement"]}, {"entity_id": "cent_", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cent.", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Cent."], "contexts": ["unit of temperature measurement"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "cent.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cent.", "similarity": 0.988}], "id": 1227, "stable_key": "clu_c0363be539cf734b", "ground_truth": {"modern_name": "Celsius", "confidence": "high", "type": "concept", "note": "Refers to a unit of temperature, likely Celsius given the historical context and the mention of temperature measurement.", "wikipedia_extract": "The degree Celsius is the unit of temperature on the Celsius temperature scale (originally known as the centigrade scale in English), one of two temperature scales used in the International System of Units (SI), the other being the closely related Kelvin scale. The degree Celsius (symbol: °C) can refer to a specific point on the Celsius temperature scale or to a difference or range between two temperatures. It is named after the Swedish astronomer Anders Celsius (1701–1744), who proposed the first version of it in 1742. The unit was called centigrade in several languages (from the Latin centum, which means 100, and gradus, which means steps) for many years. In 1948, the International Committee for Weights and Measures renamed it to honor Celsius and also to remove confusion with the term for one hundredth of a gradian in some languages. Most countries use this scale, with the exception of the United States, some island territories, and Liberia, where the Fahrenheit scale is still used."}}, {"canonical_name": "Sangue di drago", "category": "PLANT", "subcategory": "RESIN", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "sangue_di_drago", "book_id": "ricettario_fiorentino_1597", "name": "Sangue di drago", "category": "PLANT", "subcategory": "RESIN", "count": 4, "variants": ["Sangue di drago", "sangue di drago", "Sangue di Drago"], "contexts": ["resin from a tree, used in medicine", "dragon's blood resin"]}, {"entity_id": "sang_de_dragin", "book_id": "relation_historique_humboldt_vol3_1825", "name": "sang de Dragin", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["sang de Dragin"], "contexts": ["red resin"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Sangue di drago", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "sang de Dragin", "similarity": 0.9}], "id": 1228, "stable_key": "clu_abea320248b4d1cc", "ground_truth": {"modern_name": "Dragon's blood", "confidence": "high", "type": "substance", "description": "Resinous substance from certain plants, used in medicine and dyes.", "note": "Refers to the resin collected from various species of Daemonorops, Dracaena, and Croton trees.", "wikipedia_extract": "Dragon's blood is a bright red resin that is obtained from different species of a number of distinct plant genera: Calamus spp. (previously Daemonorops) also including Calamus rotang, Croton, Dracaena and Pterocarpus. The red resin has been in continuous use since ancient times as varnish, medicine, incense, pigment, and dye. A great  degree of confusion existed for the ancients in regard to the source and identity of dragon's blood. Some medieval encyclopedias claimed its source as the literal blood of elephants and dragons who had perished in mortal combat. The resin of Dracaena species, \"true\" dragon's blood, and the very poisonous mineral cinnabar (mercury sulfide) were often confused by the ancient Romans. In ancient China, little or no distinction was made among the types of dragon's blood from the different species."}}, {"canonical_name": "Taverna del Rey", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "taverna_del_rey", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Taverna del Rey", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Taverna del Rey", "Taverna del Reya"], "contexts": ["location with a measured elevation", "location mentioned with a number"]}, {"entity_id": "huerta_del_rey", "book_id": "polyanthea_medicinal", "name": "Huerta del Rey", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Huerta del Rey"], "contexts": ["place where water sources became turbid"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Taverna del Rey", "target_book": "polyanthea_medicinal", "target_name": "Huerta del Rey", "similarity": 0.84}], "id": 1229, "stable_key": "clu_32d887048dc3ef84", "ground_truth": {"modern_name": "Huerta del Rey", "confidence": "medium", "type": "place", "description": "A location possibly named 'King's Orchard' or similar, associated with water sources.", "note": "The mention of 'Taverna del Rey' suggests a place name, and 'Huerta del Rey' fits this.", "wikipedia_extract": "Polideportivo Huerta del Rey is an arena located in Valladolid, Spain. It is primarily used for team handball and is the home arena of BM Atlético Valladolid and BM Aula Cultural. From 1976 to 1985 it was the home of CB Valladolid in basketball, before moving to the Pabellón Polideportivo Pisuerga which is used by the handball team for European matches. The arena holds 3,500 people."}}, {"canonical_name": "Certes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "certes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Certes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Certes"], "contexts": ["parliament or assembly", "parliamentary body"]}, {"entity_id": "certo", "book_id": "polyanthea_medicinal", "name": "certo", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["certo"], "contexts": ["Latin for 'certain'"]}, {"entity_id": "certidao", "book_id": "polyanthea_medicinal", "name": "certidao", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["certidao"], "contexts": ["certificate of authenticity"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Certes", "target_book": "polyanthea_medicinal", "target_name": "certo", "similarity": 0.863}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Certes", "target_book": "polyanthea_medicinal", "target_name": "certidao", "similarity": 0.912}], "id": 1230, "stable_key": "clu_ddc8b1b9b973b0a2", "ground_truth": {"modern_name": "Certificates", "confidence": "medium", "type": "object", "description": "Official documents attesting to a fact, status, or qualification.", "note": "The Latin 'certo' and 'certidao' (certificate) suggest official documents rather than a parliamentary body.", "wikipedia_extract": "An Extended Validation (EV) Certificate is a certificate conforming to X.509 that proves the legal entity of the owner and is signed by a certificate authority key that can issue EV certificates. EV certificates can be used in the same manner as any other X.509 certificates, including securing web communications with HTTPS and signing software and documents. Unlike domain-validated certificates and organization-validation certificates, EV certificates can be issued only by a subset of certificate authorities (CAs) and require verification of the requesting entity's legal identity before certificate issuance. As of February 2021, all major web browsers (Google Chrome, Mozilla Firefox, Microsoft Edge and Apple Safari) have menus which show the EV status of the certificate and the verified legal identity of EV certificates. Mobile browsers typically display EV certificates the same way they do Domain Validation (DV) and Organization Validation (OV) certificates. Of the ten most popular websites online, none use EV certificates and the trend is away from their usage."}}, {"canonical_name": "Santarem", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "santarem", "book_id": "polyanthea_medicinal", "name": "Santarem", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Santarem"], "contexts": ["town where case occurred", "city where a patient previously resided"]}, {"entity_id": "santarem", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Santarem", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Santarem"], "contexts": ["city on the Amazon river"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Santarem", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Santarem", "similarity": 1.0}], "id": 1231, "stable_key": "clu_dc350236252422eb", "ground_truth": {"modern_name": "Santarém", "confidence": "high", "type": "place", "description": "City in Portugal on the Amazon River.", "wikipedia_extract": "Santarém (European Portuguese pronunciation: [sɐ̃tɐˈɾɐ̃j] ) is a Portuguese city and municipality located in the district of Santarém. The population of the historic Ribatejo capital  in 2021 was 58,671, in an area of 552.54 km2. The population of the city proper was 29,929 in 2012. The mayor is Ricardo Gonçalves (PSD). The municipal holiday is March 19, the day of Saint Joseph (São José). The city is on the Portuguese Way variant of the Way of Saint James."}}, {"canonical_name": "precipitar", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "precipitar", "book_id": "polyanthea_medicinal", "name": "precipitar", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 4, "variants": ["precipitar", "Precipitar", "precipitando", "precipitaçoens"], "contexts": ["causing a substance to fall down", "chemical process of preparing medicines"]}, {"entity_id": "précipitation", "book_id": "relation_historique_humboldt_vol3_1825", "name": "précipitation", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["précipitation"], "contexts": ["chemical process"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "precipitar", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "précipitation", "similarity": 0.929}], "id": 1232, "stable_key": "clu_79588e92bf625e2a", "ground_truth": {"modern_name": "precipitation", "confidence": "high", "type": "concept", "description": "Chemical process causing a substance to fall out of solution.", "wikipedia_extract": "In meteorology, precipitation is any product of the condensation of atmospheric water vapor that falls from clouds due to gravitational pull. The main forms of precipitation include drizzle, rain, rain and snow mixed (\"sleet\" in Commonwealth usage), snow, ice pellets, graupel and hail. Precipitation occurs when a portion of the atmosphere becomes saturated with water vapor (reaching 100% relative humidity), so that the water condenses and \"precipitates\" or falls. Thus, fog and mist are not precipitation; their water vapor does not condense sufficiently to precipitate, so fog and mist do not fall. (Such a non-precipitating combination is a colloid.) Two processes, possibly acting together, can lead to air becoming saturated with water vapor: cooling the air or adding water vapor to the air. Precipitation forms as smaller droplets coalesce via collision with other rain drops or ice crystals within a cloud. Short, intense periods of rain in scattered locations are called showers."}}, {"canonical_name": "Sandwich Land", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "sandwich_land", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Sandwich Land", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Sandwich Land"], "contexts": ["archipelago in the South Atlantic", "region with perpetual snow and ice"]}, {"entity_id": "lies_sand-wich", "book_id": "relation_historique_humboldt_vol3_1825", "name": "lies Sand-wich", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["lies Sand-wich", "Sandwich"], "contexts": ["Sandwich Islands (Hawaii)", "islands with attributed population"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Sandwich Land", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "lies Sand-wich", "similarity": 0.895}], "id": 1233, "stable_key": "clu_653ce439599ab60c", "ground_truth": {"modern_name": "South Sandwich Islands", "confidence": "high", "type": "place", "country": "United Kingdom", "note": "The context of archipelago in the South Atlantic strongly points to the South Sandwich Islands. 'Sandwich Land' was an early name for this group.", "wikidata_id": "Q118223", "wikidata_description": "island group", "wikipedia_extract": "The South Sandwich Islands (Spanish: Islas Sandwich del Sur) are a chain of uninhabited volcanic islands in the South Atlantic Ocean. They are administered as part of the British Overseas Territory of South Georgia and the South Sandwich Islands. The chain lies in the sub-Antarctic region, about 700 kilometres (430 mi) southeast of South Georgia and 1,700 kilometres (1,100 mi) northeast from the tip of the Antarctic Peninsula. The archipelago comprises 11 main islands forming an island arc running north–south, the largest being Montagu at 110 square kilometres (42 sq mi). It is divided into four groups, from north to south: The Traversay, Candlemas and Central Islands (Saunders, Montagu, and Bristol), and Southern Thule. The archipelago is prone to violent earthquakes."}}, {"canonical_name": "Kew", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "kew", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Kew", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Kew"], "contexts": ["meteorological observatory location", "location for cloud region observation"]}, {"entity_id": "kevis", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Kevis", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Kevis"], "contexts": ["island name"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Kew", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Kevis", "similarity": 0.854}], "id": 1234, "stable_key": "clu_9ce834fad6ca17aa", "ground_truth": {"modern_name": "Kew", "confidence": "high", "type": "place", "country": "United Kingdom", "note": "Given the context of a meteorological observatory, Kew in London is the most likely referent, home to the Royal Botanic Gardens and its associated meteorological activities.", "wikipedia_extract": "Kew Gardens is a botanic garden in southwest London that houses the \"largest and most diverse botanical and mycological collections in the world\". Founded in 1759, from the exotic garden at Kew Park, its living collections include some of the 27,000 taxa curated by Royal Botanic Gardens, Kew, while the herbarium, one of the largest in the world, has over 8.5 million preserved plant and fungal specimens. The library contains more than 750,000 volumes, and the illustrations collection contains more than 175,000 prints and drawings of plants. It is one of London's top tourist attractions and is a World Heritage Site. Kew Gardens, together with the botanic gardens at Wakehurst in Sussex, are managed by the Royal Botanic Gardens, Kew, an internationally important botanical research and education institution that employs over 1,100 staff and is a non-departmental public body sponsored by the Department for Environment, Food and Rural Affairs. The botanic gardens at Kew formally started in 1759, although they can be traced back to the exotic garden at Kew Park, formed by Henry, Lord Capell of Tewkesbury.", "wikipedia_url": "https://en.wikipedia.org/wiki/Kew_Gardens"}}, {"canonical_name": "Metaphysic", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "metaphysic", "book_id": "principles_of_psychology_james_1890", "name": "Metaphysic", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 3, "variants": ["Metaphysic"], "contexts": ["metaphysics work title", "Lotze's work on metaphysics"]}, {"entity_id": "metaphysical_principles_of_the_natural_sciences", "book_id": "kosmos_humboldt_1845", "name": "Metaphysical Principles of the Natural Sciences", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Metaphysical Principles of the Natural Sciences"], "contexts": ["title of Kant's work"]}, {"entity_id": "metaph_", "book_id": "kosmos_humboldt_1845", "name": "Metaph.", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Metaph."], "contexts": ["Aristotle's work"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Metaphysic", "target_book": "kosmos_humboldt_1845", "target_name": "Metaphysical Principles of the Natural Sciences", "similarity": 0.856}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Metaphysic", "target_book": "kosmos_humboldt_1845", "target_name": "Metaph.", "similarity": 0.843}], "id": 1235, "stable_key": "clu_cb5669cfd5028694", "ground_truth": {"modern_name": "Metaphysics", "confidence": "high", "type": "text", "note": "This cluster refers to the philosophical discipline and specific works within it, notably Aristotle's 'Metaphysics' and Kant's 'Metaphysical Principles of the Natural Sciences'.", "wikidata_id": "Q35277", "wikidata_description": "branch of philosophy dealing with the nature, structure, components and fundamental principles of reality", "wikipedia_extract": "Metaphysics is the branch of philosophy that examines the basic structure of reality. It is traditionally seen as the study of mind-independent features of the world, but some theorists view it as an inquiry into the conceptual framework of human understanding. Some philosophers, including Aristotle, designate metaphysics as first philosophy to suggest that it is more fundamental than other forms of philosophical inquiry. Metaphysics encompasses a wide range of general and abstract topics. It investigates the nature of existence, the features all entities have in common, and their division into categories of being. An influential division is between particulars and universals.", "wikipedia_url": "https://en.wikipedia.org/wiki/Metaphysics"}}, {"canonical_name": "Dublin", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "dublin", "book_id": "kosmos_humboldt_1845", "name": "Dublin", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Dublin"], "contexts": ["city with moderate temperatures", "capital city of Ireland"]}, {"entity_id": "dublin", "book_id": "principles_of_psychology_james_1890", "name": "Dublin", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Dublin"], "contexts": ["city where Maguire was professor"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Dublin", "target_book": "principles_of_psychology_james_1890", "target_name": "Dublin", "similarity": 1.0}], "id": 1236, "stable_key": "clu_4f5dbd39893bd4b6", "ground_truth": {"modern_name": "Dublin", "confidence": "high", "type": "place", "country": "Ireland", "wikidata_id": "Q1761", "wikidata_description": "capital and largest city of Ireland", "wikipedia_extract": "Dublin is the capital and largest city of Ireland. Situated on Dublin Bay at the mouth of the River Liffey, it is in the province of Leinster, and is bordered on the south by the Dublin Mountains, part of the Wicklow Mountains range. Dublin is the largest city by population on the island of Ireland; at the 2022 census, the city council area had a population of 592,713, while the city, including suburbs, had a population of 1,263,219, and County Dublin had a population of 1,501,500. Various definitions of a metropolitan Greater Dublin Area exist. A settlement was established in the area by the Gaels during or before the 7th century, followed by the Vikings. As the Kingdom of Dublin grew, it became Ireland's principal settlement by the 12th century, following the Anglo-Norman invasion of Ireland.", "wikipedia_url": "https://en.wikipedia.org/wiki/Dublin"}}, {"canonical_name": "hypnotic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "hypnotic", "book_id": "principles_of_psychology_james_1890", "name": "hypnotic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["hypnotic"], "contexts": ["related to hypnosis"]}, {"entity_id": "hypnotic_suggestion", "book_id": "principles_of_psychology_james_1890", "name": "hypnotic suggestion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["hypnotic suggestion"], "contexts": ["used to bring back past disorder", "inducing states through suggestion"]}, {"entity_id": "hypnotica", "book_id": "polyanthea_medicinal", "name": "hypnotica", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hypnotica"], "contexts": ["hypnotic quality"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "hypnotic", "target_book": "polyanthea_medicinal", "target_name": "hypnotica", "similarity": 0.987}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hypnotic suggestion", "target_book": "polyanthea_medicinal", "target_name": "hypnotica", "similarity": 0.908}], "id": 1237, "stable_key": "clu_ff546d690f2ece9b", "ground_truth": {"modern_name": "hypnotic", "confidence": "high", "type": "concept", "description": "Related to or inducing a state of hypnosis.", "wikipedia_extract": "A hypnotic (from Greek Hypnos, sleep), also known as a somnifacient or soporific, and commonly known as sleeping pills, are a class of psychoactive drugs whose primary function is to induce sleep and to treat insomnia (sleeplessness). Some hypnotics are also used to treat narcolepsy and hypersomnia by improving sleep at night and thereby reducing daytime sleepiness. Certain hypnotics can be used to treat non-restorative sleep and associated symptoms in conditions like fibromyalgia as well. This group of drugs is related to sedatives. Whereas the term sedative describes drugs that serve to calm or relieve anxiety, the term hypnotic generally describes drugs whose main purpose is to initiate, sustain, or lengthen sleep. Because these two functions frequently overlap, and because drugs in this class generally produce dose-dependent effects (ranging from anxiolysis to loss of consciousness), they are often referred to collectively as sedative–hypnotic drugs."}}, {"canonical_name": "Quintiliopa", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "quintiliopa", "book_id": "polyanthea_medicinal", "name": "Quintiliopa", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["Quintiliopa", "Quintilio.", "Quintiliode", "Quintitio"], "contexts": ["cited for emetics in delirium", "ancient authority for purging humor"]}, {"entity_id": "quintilian", "book_id": "principles_of_psychology_james_1890", "name": "Quintilian", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Quintilian"], "contexts": ["ancient rhetorician quoted on attention and memory"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Quintiliopa", "target_book": "principles_of_psychology_james_1890", "target_name": "Quintilian", "similarity": 0.896}], "id": 1238, "stable_key": "clu_1ff02d569daec5ed", "ground_truth": {"modern_name": "Quintilian", "confidence": "high", "type": "person", "description": "Roman rhetorician and teacher, influential in classical education.", "note": "The texts mention Quintiliopa and Quintilian. Quintilian is the correct identification of the classical authority.", "wikipedia_extract": "Marcus Fabius Quintilianus (Latin: [kʷiːntɪliˈaːnʊs]; c. 35 – c. 100 AD) was a Roman educator and rhetorician born in Hispania, widely referred to in medieval schools of rhetoric and in Renaissance writing. In English translation, he is usually referred to as Quintilian ( kwin-TIL-ee-ən), although the alternate spellings of Quintillian and Quinctilian are occasionally seen, the latter in older texts. Quintilian was born c. 35 AD in Calagurris (Calahorra, La Rioja) in Hispania. His father, a well-educated man, sent him to Rome to study rhetoric early in the reign of Nero. While there, he cultivated a relationship with Domitius Afer, who died in 59. \"It had always been the custom … for young men with ambitions in public life to fix upon some older model of their ambition … and regard him as a mentor\". Quintilian evidently adopted Afer as his model and listened to him speak and plead cases in the law courts."}}, {"canonical_name": "violin", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "violin", "book_id": "principles_of_psychology_james_1890", "name": "violin", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["violin"], "contexts": ["musical instrument", "musical instrument held in the hand"]}, {"entity_id": "violin", "book_id": "connexion_physical_sciences_somerville_1858", "name": "violin", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["violin"], "contexts": ["instrument used to excite vibrations", "stringed instrument"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "violin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "violin", "similarity": 0.834}], "id": 1239, "stable_key": "clu_1e4fde42cafa92b0", "ground_truth": {"modern_name": "violin", "confidence": "high", "type": "object", "wikidata_id": "Q104837388", "wikidata_description": "family name", "wikipedia_extract": "Le Violon d'Ingres (French for Ingres' Violin) is a black-and-white photograph created by American visual artist Man Ray in 1924. It is one of his best-known photographs and of surrealist photography. The picture was first published in the Surrealist magazine Littérature in June 1924. It shows model Kiki de Montparnasse from the back, nude to below her waist, with two f-holes painted on to draw similarities between the shape of her body and a violin. The photograph takes its name from a popular French expression, le violon d'Ingres, which means a hobby, in reference to the fact that the French neoclassical painter Jean-Auguste-Dominique Ingres used to play the violin as a pastime when he was not painting. Man Ray admired Ingres's work and he drew inspiration from his painting The Valpinçon Bather (1808) for this photograph.", "wikipedia_url": "https://en.wikipedia.org/wiki/Le_Violon_d'Ingres"}}, {"canonical_name": "confusion", "category": "DISEASE", "subcategory": "PSYCHOLOGICAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "confusion", "book_id": "principles_of_psychology_james_1890", "name": "confusion", "category": "DISEASE", "subcategory": "PSYCHOLOGICAL", "count": 2, "variants": ["confusion"], "contexts": ["state of being bewildered or unclear", "uncertainty about object identity"]}, {"entity_id": "confusion_of_perception", "book_id": "principles_of_psychology_james_1890", "name": "confusion of perception", "category": "DISEASE", "subcategory": "PSYCHOLOGICAL", "count": 1, "variants": ["confusion of perception"], "contexts": ["difficulty in distinguishing sensory input"]}, {"entity_id": "confusion", "book_id": "first_principles_spencer_1862", "name": "confusion", "category": "DISEASE", "subcategory": "PSYCHOLOGICAL", "count": 1, "variants": ["confusion"], "contexts": ["unorganized mental state of an infant"]}, {"entity_id": "confusion_of_thought", "book_id": "first_principles_spencer_1862", "name": "confusion of thought", "category": "DISEASE", "subcategory": "PSYCHOLOGICAL", "count": 1, "variants": ["confusion of thought"], "contexts": ["result from pre-established associations"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "confusion", "target_book": "first_principles_spencer_1862", "target_name": "confusion", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "confusion", "target_book": "first_principles_spencer_1862", "target_name": "confusion of thought", "similarity": 0.931}, {"source_book": "principles_of_psychology_james_1890", "source_name": "confusion of perception", "target_book": "first_principles_spencer_1862", "target_name": "confusion", "similarity": 0.906}, {"source_book": "principles_of_psychology_james_1890", "source_name": "confusion of perception", "target_book": "first_principles_spencer_1862", "target_name": "confusion of thought", "similarity": 0.924}], "id": 1240, "stable_key": "clu_59acb49fed2370bf", "ground_truth": {"modern_name": "confusion", "confidence": "high", "type": "disease", "modern_term": "confusion", "wikidata_id": "Q111529541", "wikidata_description": "2021 Eastercon", "wikipedia_extract": "Sundowning, or sundown syndrome, prevalent among people with some form of dementia, is characterized by increased confusion and restlessness beginning in the late afternoon and early evening. The term sundowning was coined by nurse Lois K. Evans in 1987 due to the association between the person's increased confusion and the setting of the sun. For people with sundown syndrome, a multitude of behavioral problems begin to occur and are associated with long-term adverse outcomes. Sundowning seems to occur more frequently during the middle stages of Alzheimer's disease and mixed dementia and seems to subside with the progression of the person's dementia. People are generally able to understand that this behavioral pattern is abnormal.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sundowning"}}, {"canonical_name": "piano", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "piano", "book_id": "first_principles_spencer_1862", "name": "piano", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["piano"], "contexts": ["musical instrument", "keyboard musical instrument"]}, {"entity_id": "piano-playing", "book_id": "principles_of_psychology_james_1890", "name": "piano-playing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["piano-playing"], "contexts": ["act of playing the piano"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "piano", "target_book": "principles_of_psychology_james_1890", "target_name": "piano-playing", "similarity": 0.91}], "id": 1241, "stable_key": "clu_78921ef2041ba48a", "ground_truth": {"modern_name": "piano", "confidence": "high", "type": "concept", "note": "While 'piano' can refer to the instrument, in this context with 'piano-playing', it refers to the concept of the instrument and its use.", "wikidata_id": "Q37505595", "wikidata_description": "family name"}}, {"canonical_name": "Siena", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "siena", "book_id": "kosmos_humboldt_1845", "name": "Siena", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Siena"], "contexts": ["location of meteoric stone fall", "location of celebrated fall in 1794"]}, {"entity_id": "sienna", "book_id": "coloquios_da_orta_1563", "name": "Sienna", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Sienna"], "contexts": ["origin of Pietro Andrea Mattioli"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Siena", "target_book": "coloquios_da_orta_1563", "target_name": "Sienna", "similarity": 0.969}], "id": 1242, "stable_key": "clu_b4a67fb53666b750", "ground_truth": {"modern_name": "Siena", "confidence": "high", "type": "place", "country": "Italy", "note": "The spelling 'Sienna' is a common variant and refers to the same place.", "wikidata_id": "Q2751", "wikidata_description": "city in Tuscany, Italy and capital of the province of Siena", "wikipedia_url": "https://en.wikipedia.org/wiki/Siena", "wikipedia_extract": "Siena ( see-EN-ə, Italian: [ˈsjɛːna, ˈsjeːna] ; traditionally spelled Sienna in English; Latin: Saena Iulia) is a city in Tuscany, in Central Italy, and the capital of the province of Siena. With a population of 52,991, it is the 12th-largest city in the region as of 2025. The city is historically linked to commercial and banking activities, having been a major banking centre until the 13th and 14th centuries. Siena is also home to the oldest bank in the world, the Monte dei Paschi, which has been operating continuously since 1472 (1472). Several significant Mediaeval and Renaissance painters were born and worked in Siena, including Duccio di Buoninsegna, Ambrogio Lorenzetti, Simone Martini and Sassetta, and they influenced the course of Italian and European art. The University of Siena, originally called Studium Senese, was founded in 1240, making it one of the oldest universities in continuous operation in the world."}}, {"canonical_name": "mineralogical", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "mineralogical", "book_id": "kosmos_humboldt_1845", "name": "mineralogical", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["mineralogical"], "contexts": ["relating to mineral composition of rocks", "branch of geognosy"]}, {"entity_id": "mineralogical_character", "book_id": "kosmos_humboldt_1845", "name": "mineralogical character", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mineralogical character"], "contexts": ["properties of minerals"]}, {"entity_id": "mineralógica", "book_id": "coloquios_da_orta_1563", "name": "mineralógica", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["mineralógica", "mineralogie"], "contexts": ["study of minerals"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "mineralogical", "target_book": "coloquios_da_orta_1563", "target_name": "mineralógica", "similarity": 0.95}, {"source_book": "kosmos_humboldt_1845", "source_name": "mineralogical character", "target_book": "coloquios_da_orta_1563", "target_name": "mineralógica", "similarity": 0.853}], "id": 1243, "stable_key": "clu_4cce38321e451496", "ground_truth": {"modern_name": "mineralogy", "confidence": "high", "type": "concept", "note": "The adjective 'mineralogical' refers to the field of study, mineralogy."}}, {"canonical_name": "António Galvão", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "antónio_galvão", "book_id": "coloquios_da_orta_1563", "name": "António Galvão", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["António Galvão"], "contexts": ["cited source", "governor in the Moluccas"]}, {"entity_id": "aloysio_galvani", "book_id": "kosmos_humboldt_1845", "name": "Aloysio Galvani", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Aloysio Galvani"], "contexts": ["stimulated nervous fiber by metals"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "António Galvão", "target_book": "kosmos_humboldt_1845", "target_name": "Aloysio Galvani", "similarity": 0.85}], "id": 1244, "stable_key": "clu_cb1670135eafae3a", "ground_truth": {"modern_name": "António Galvão", "confidence": "medium", "type": "person", "description": "Cited Portuguese explorer and writer.", "note": "The cluster also contains 'Aloysio Galvani', who is Luigi Galvani. However, the overwhelming majority of mentions are 'António Galvão', and the contexts provided seem to align better with him as a cited source in geographical/botanical works.", "wikidata_id": "Q2857742", "wikidata_description": "Portuguese administrator and historian", "wikipedia_extract": "António Galvão (c. 1490–1557), also known as Antonio Galvano, was a Portuguese soldier, chronicler and administrator in the Maluku islands, and a Renaissance historian who was the first person to present a comprehensive report of the leading voyages and explorers up to 1550 by Portuguese explorers and those of other nationalities. His works, especially the Treaty of Discovery that was published in Lisbon in 1563 and in English by Richard Hakluyt in 1601, are notably accurate. António Galvão was the son of Duarte Galvão, who was chief diplomat and chronicler to King Afonso V of Portugal. In 1527, António Galvão sailed for Portuguese India where he became captain of Maluku and governor of the fort of Ternate from 1536 to 1540. He is described in Chapter II of the Fifth \"Decade of Asia\" as a respected governor, having sent a mission to Papua and received local embassies.", "wikipedia_url": "https://en.wikipedia.org/wiki/Ant%C3%B3nio_Galv%C3%A3o"}}, {"canonical_name": "Amboyna", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "amboyna", "book_id": "coloquios_da_orta_1563", "name": "Amboyna", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Amboyna"], "contexts": ["place where Rumphius wrote", "island in Indonesia"]}, {"entity_id": "amboyna", "book_id": "kosmos_humboldt_1845", "name": "Amboyna", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Amboyna"], "contexts": ["location of experiments"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Amboyna", "target_book": "kosmos_humboldt_1845", "target_name": "Amboyna", "similarity": 0.855}], "id": 1245, "stable_key": "clu_86d2fc3b08f1d680", "ground_truth": {"modern_name": "Ambon", "confidence": "high", "type": "place", "country": "Indonesia", "note": "Amboyna is the historical name for the island and city of Ambon.", "wikidata_id": "Q18970", "wikidata_description": "city in Maluku Province, Indonesia", "wikipedia_url": "https://en.wikipedia.org/wiki/Ambon%2C_Maluku", "wikipedia_extract": "Ambon (Indonesian pronunciation: [ˈambɔn]; formerly Dutch: Amboina) is the capital and largest city of the Indonesian province of Maluku. This city is also known as Ambon Manise, which means \"beautiful\" or \"pretty\" Ambon in the Ambonese language. It covers a land area of 359.45 square kilometres (138.78 sq mi), and had a population of 331,254 at the 2010 Census and 347,288 at the 2020 Census; the official estimate as of mid 2024 was 357,289. The city is divided into five administrative districts (kecamatan) – namely Nusaniwe, Sirimau, Teluk Ambon (Ambon Bay), Baguala (officially Teluk Ambon Baguala) and Leitimur Selatan (South Leitimur). Known as Indonesia's music city, Ambon became the first city in Southeast Asia to be recognised as the UNESCO City of Music in 2019. The city is populated by a mix of ethnic Alifuru (original Moluccans), Javanese, Balinese, Butonese, Bugis, Makassar, Papuan, Minahasa, Minang, Flobamora (Flores, Sumba, Alor and Timor ethnics) and those of foreign descent (Chinese, Arabian-Ambonese, Spanish-Ambonese, German-Ambonese, Portuguese-Ambonese and Dutch-Ambonese)."}}, {"canonical_name": "Scitaminea", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "scitaminea", "book_id": "coloquios_da_orta_1563", "name": "Scitaminea", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["Scitaminea", "Scitaminece"], "contexts": ["plant family", "plant discussed in previous colloquy"]}, {"entity_id": "scitamineae", "book_id": "kosmos_humboldt_1845", "name": "Scitamineae", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Scitamineae"], "contexts": ["plant family"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Scitaminea", "target_book": "kosmos_humboldt_1845", "target_name": "Scitamineae", "similarity": 0.888}], "id": 1246, "stable_key": "clu_008f86aeb5545484", "ground_truth": {"modern_name": "Zingiberales", "confidence": "high", "type": "plant", "linnaean": "Zingiberales", "family": "Zingiberaceae", "note": "Scitaminea is an older taxonomic grouping that corresponds to the modern order Zingiberales, which includes families like Zingiberaceae (ginger family) and Musaceae (banana family).", "wikidata_id": "Q203779", "wikidata_description": "order of plants", "wikipedia_extract": "The ginger-families or ginger group or Core Zingiberales is a terminal clade in the order Zingiberales (Monocotyledoneae) that comprises Zingiberaceae (the ginger family), Costaceae, Marantaceae and Cannaceae. Their shared synapomorphy of a single fertile anther and four or five highly modified staminodia differentiate them from the basal paraphyletic assemblage of the \"banana-families\". They form a Suborder Zingiberineae Kress in taxonomic classification, with the following phylogeny, the four families being grouped into two superfamilies.", "wikipedia_url": "https://en.wikipedia.org/wiki/Zingiberales"}}, {"canonical_name": "epatica", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "epatica", "book_id": "polyanthea_medicinal", "name": "epatica", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["epatica"], "contexts": ["ingredient in a decoction for fever", "liverwort, a plant"]}, {"entity_id": "epatico", "book_id": "ricettario_fiorentino_1597", "name": "epatico", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["epatico"], "contexts": ["type of aloe juice"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "epatica", "target_book": "ricettario_fiorentino_1597", "target_name": "epatico", "similarity": 0.906}], "id": 1247, "stable_key": "clu_342ff50c28237c78", "ground_truth": {"modern_name": "liverwort", "confidence": "high", "type": "plant", "family": "Marchantiophyta", "description": "A small, non-vascular plant often used for liver ailments.", "note": "Historically, the term also referred to plants with lobed leaves, resembling the liver.", "wikipedia_extract": "Liverworts are a group of non-vascular land plants forming the division Marchantiophyta ( ). They may also be referred to as  hepatics. Like mosses and hornworts, they have a gametophyte-dominant life cycle, in which cells of the plant carry only a single set of genetic information. The division name was derived from the genus name Marchantia, named  after his father by French botanist Jean Marchant. It is estimated that there are about 9000 species of liverwort. Some of the more familiar species grow as a flattened leafless thallus, but most species are leafy with a form very much like a flattened moss."}}, {"canonical_name": "Serpentarius", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "serpentarius", "book_id": "kosmos_humboldt_1845", "name": "Serpentarius", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Serpentarius"], "contexts": ["constellation with a star", "constellation with a starless region"]}, {"entity_id": "π_serpentarii", "book_id": "connexion_physical_sciences_somerville_1858", "name": "π Serpentarii", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["π Serpentarii"], "contexts": ["double star system"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Serpentarius", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "π Serpentarii", "similarity": 0.935}], "id": 1248, "stable_key": "clu_71d3c061273f65a7", "ground_truth": {"modern_name": "Serpens", "confidence": "high", "type": "place", "note": "The mention of 'π Serpentarii' confirms the astronomical context.", "wikipedia_extract": "Ophiuchus () is a large constellation straddling the celestial equator. Its name comes from the Ancient Greek ὀφιοῦχος (ophioûkhos), meaning \"serpent-bearer\", and it is commonly represented as a man grasping a snake. The serpent is represented by the constellation Serpens. Ophiuchus was one of the 48 constellations listed by the 2nd-century astronomer Ptolemy, and it remains one of the 88 modern constellations. An old alternative name for the constellation was Serpentarius. Ophiuchus lies between Aquila, Serpens, Scorpius, Sagittarius, and Hercules, northwest of the center of the Milky Way.", "wikipedia_url": "https://en.wikipedia.org/wiki/Ophiuchus"}}, {"canonical_name": "Geognosie", "category": "ORGANIZATION", "subcategory": "JOURNAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "geognosie", "book_id": "kosmos_humboldt_1845", "name": "Geognosie", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 4, "variants": ["Geognosie"], "contexts": ["book title on geology", "study of earth's structure"]}, {"entity_id": "geographical_journal", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Geographical Journal", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Geographical Journal"], "contexts": ["publication featuring paper on atmospheric changes"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Geognosie", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Geographical Journal", "similarity": 0.853}], "id": 1249, "stable_key": "clu_a9bfffc163cde125", "ground_truth": {"modern_name": "Geognosy", "confidence": "high", "type": "concept", "note": "While 'Geographical Journal' is a publication, 'Geognosie' itself refers to the scientific discipline.", "wikidata_id": "Q1503122", "wikidata_description": "science of the study of the composition of the earth's crust, the description of stratified formations and the analysis of mineral and metalliferous deposits", "wikipedia_url": "https://fr.wikipedia.org/wiki/G%C3%A9ognosie"}}, {"canonical_name": "corals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "corals", "book_id": "kosmos_humboldt_1845", "name": "corals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["corals"], "contexts": ["marine invertebrate animals", "marine invertebrates"]}, {"entity_id": "corals", "book_id": "connexion_physical_sciences_somerville_1858", "name": "corals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["corals"], "contexts": ["marine invertebrates forming reefs"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "corals", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "corals", "similarity": 1.0}], "id": 1250, "stable_key": "clu_aec819706fa4c6aa", "ground_truth": {"modern_name": "Coral", "confidence": "high", "type": "animal", "note": "Corals are marine invertebrates, and the context of reef formation is characteristic.", "wikidata_id": "Q37135483", "wikidata_description": "family name"}}, {"canonical_name": "chemical analysis", "category": "PRACTICE", "subcategory": "OTHER_PRACTICE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "chemical_analysis", "book_id": "kosmos_humboldt_1845", "name": "chemical analysis", "category": "PRACTICE", "subcategory": "OTHER_PRACTICE", "count": 3, "variants": ["chemical analysis"], "contexts": ["instrument of chemical analysis", "method for studying atmosphere"]}, {"entity_id": "chemical_analysis", "book_id": "connexion_physical_sciences_somerville_1858", "name": "chemical analysis", "category": "PRACTICE", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["chemical analysis"], "contexts": ["method of determining composition", "method for determining molecular constitution"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "chemical analysis", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chemical analysis", "similarity": 0.904}], "id": 1251, "stable_key": "clu_f6c14f41eb3329e5", "ground_truth": {"modern_name": "Chemical analysis", "confidence": "high", "type": "concept", "note": "This clearly refers to the process of determining the chemical composition of substances.", "wikidata_id": "Q9150363", "wikidata_description": "process of analyzing the chemical composition of a material", "wikipedia_url": "https://en.wikipedia.org/wiki/Chemistry", "wikipedia_extract": "Chemistry is the scientific study of the properties and behavior of matter. It is a physical science within the natural sciences that studies the chemical elements that make up matter and compounds made of atoms, molecules and ions: their composition, structure, properties, behavior and the changes they undergo during reactions with other substances. Chemistry also addresses the nature of chemical bonds in chemical compounds. In the scope of its subject, chemistry occupies an intermediate position between physics and biology. It is sometimes called the central science because it provides a foundation for understanding both basic and applied scientific disciplines at a fundamental level. For example, chemistry explains aspects of plant growth (botany), the formation of igneous rocks (geology), how atmospheric ozone is formed and how environmental pollutants are degraded (ecology), the properties of the soil on the Moon (cosmochemistry), how medications work (pharmacology), and how to collect DNA evidence at a crime scene (forensics)."}}, {"canonical_name": "Royal Observatory, Greenwich", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "royal_observatory,_greenwich", "book_id": "kosmos_humboldt_1845", "name": "Royal Observatory, Greenwich", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "count": 2, "variants": ["Royal Observatory, Greenwich"], "contexts": ["astronomical observatory", "observatory where Glaisher worked"]}, {"entity_id": "greenwich_observatory", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Greenwich Observatory", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "count": 2, "variants": ["Greenwich Observatory"], "contexts": ["observatory for lunar observations", "observatory location"]}, {"entity_id": "royal_observatory", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Royal Observatory", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "count": 1, "variants": ["Royal Observatory"], "contexts": ["meteorological observation site"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Royal Observatory, Greenwich", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Greenwich Observatory", "similarity": 0.903}, {"source_book": "kosmos_humboldt_1845", "source_name": "Royal Observatory, Greenwich", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Royal Observatory", "similarity": 0.875}], "id": 1252, "stable_key": "clu_757edffdd2dbeffc", "ground_truth": {"modern_name": "Royal Observatory, Greenwich", "confidence": "high", "type": "place", "country": "United Kingdom", "note": "Multiple variations and contexts point directly to this historical institution."}}, {"canonical_name": "Protozoa", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "protozoa", "book_id": "first_principles_spencer_1862", "name": "Protozoa", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["Protozoa"], "contexts": ["group of single-celled organisms", "early forms of life"]}, {"entity_id": "protococcus", "book_id": "kosmos_humboldt_1845", "name": "Protococcus", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Protococcus"], "contexts": ["former name for Chionaea nivalis"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "Protozoa", "target_book": "kosmos_humboldt_1845", "target_name": "Protococcus", "similarity": 0.872}], "id": 1253, "stable_key": "clu_5aa5223d13c99e4c", "ground_truth": {"modern_name": "Protozoa", "confidence": "high", "type": "animal", "note": "The context of single-celled organisms confirms the scientific classification, though 'Protococcus' is a specific genus.", "wikidata_id": "Q55223519", "wikidata_description": "infections with unicellular organisms formerly members of the subkingdom Protozoa."}}, {"canonical_name": "Sidereal System", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "sidereal_system", "book_id": "first_principles_spencer_1862", "name": "Sidereal System", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Sidereal System", "sidereal system"], "contexts": ["system of stars", "system of stars and galaxies"]}, {"entity_id": "sidereal_systems", "book_id": "kosmos_humboldt_1845", "name": "Sidereal systems", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Sidereal systems"], "contexts": ["astronomical systems"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "Sidereal System", "target_book": "kosmos_humboldt_1845", "target_name": "Sidereal systems", "similarity": 0.977}], "id": 1254, "stable_key": "clu_65fdcbe736120cf6", "ground_truth": {"modern_name": "Stellar system", "confidence": "high", "type": "place", "note": "Refers to a group of stars, such as galaxies or star clusters.", "wikidata_id": "Q68651525", "wikidata_description": "scholarly article", "wikipedia_extract": "Sidereus Nuncius (usually Sidereal Messenger, also Starry Messenger or Sidereal Message) is a short astronomical treatise (or pamphlet) published in Neo-Latin by Galileo Galilei on March 13, 1610. It was the first published scientific work based on observations made through a telescope, and it contains the results of Galileo's early observations of the imperfect and mountainous Moon, of hundreds of stars not visible to the naked eye in the Milky Way and in certain constellations, and of the Medicean Stars (Galilean moons) that appeared to be circling Jupiter. The Latin word nuncius was typically used during this time period to denote messenger; however, it was also (though less frequently) rendered as message. Though the title Sidereus Nuncius is usually translated into English as Sidereal Messenger, many of Galileo's early drafts of the book and later related writings indicate that the intended purpose of the book was \"simply to report the news about recent developments in astronomy, not to pass himself off solemnly as an ambassador from heaven.\" The first telescopes appeared in the Netherlands in 1608, when Middelburg spectacle-maker Hans Lippershey tried to obtain a patent on one. By 1609 Galileo had learned of this and built his own improved version. He was not the first person to aim the new invention at the night sky but his was the first published study of celestial bodies using one.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sidereus_Nuncius"}}, {"canonical_name": "morbo napolitano", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "morbo_napolitano", "book_id": "coloquios_da_orta_1563", "name": "morbo napolitano", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["morbo napolitano"], "contexts": ["syphilis, also called sarna de Castella", "disease named after Naples"]}, {"entity_id": "mal_napolitano", "book_id": "historia_medicinal_monardes_1574", "name": "mal Napolitano", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["mal Napolitano"], "contexts": ["name for the disease"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "morbo napolitano", "target_book": "historia_medicinal_monardes_1574", "target_name": "mal Napolitano", "similarity": 0.898}], "id": 1255, "stable_key": "clu_2a17ee6d259c2d61", "ground_truth": {"modern_name": "syphilis", "confidence": "high", "type": "disease", "description": "A sexually transmitted infection caused by the bacterium Treponema pallidum.", "note": "Also known as the 'Neapolitan disease' or 'morbo napolitano'.", "wikipedia_extract": "Syphilis () is a sexually transmitted infection caused by the bacterium Treponema pallidum subspecies pallidum. The signs and symptoms depend on the stage it presents: primary, secondary, latent or tertiary. The primary stage classically presents with a single chancre (a firm, painless, non-itchy skin ulceration usually between 1 cm and 2 cm in diameter), though there may be multiple sores. In secondary syphilis, a diffuse rash occurs, which frequently involves the palms of the hands and soles of the feet. There may also be sores in the mouth or vagina. Latent syphilis has no symptoms and can last years."}}, {"canonical_name": "capullos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "capullos", "book_id": "historia_medicinal_monardes_1574", "name": "capullos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["capullos"], "contexts": ["buds of the plant"]}, {"entity_id": "capelvenere", "book_id": "ricettario_fiorentino_1597", "name": "Capelvenere", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Capelvenere", "Capeluencre"], "contexts": ["ingredient in a syrup", "maidenhair fern"]}, {"entity_id": "capi", "book_id": "ricettario_fiorentino_1597", "name": "capi", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["capi"], "contexts": ["part of the poppy plant"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "capullos", "target_book": "ricettario_fiorentino_1597", "target_name": "Capelvenere", "similarity": 0.852}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "capullos", "target_book": "ricettario_fiorentino_1597", "target_name": "capi", "similarity": 0.897}], "id": 1256, "stable_key": "clu_f0adeeae1d3173ec", "ground_truth": {"modern_name": "maidenhair fern", "confidence": "medium", "type": "plant", "linnaean": "Adiantum capillus-veneris", "family": "Pteridaceae", "description": "A delicate fern with fan-shaped fronds, used in traditional medicine.", "note": "The term 'capullos' could refer to buds, and 'capi' to poppy plant parts. However, 'Capelvenere' (maidenhair fern) is the most consistent identification across contexts.", "wikipedia_extract": "Adiantum capillus-veneris, the maidenhair fern, southern maidenhair fern, black maidenhair fern and venus hair fern, is a species of ferns in the genus Adiantum and the family Pteridaceae with a subcosmopolitan worldwide distribution. It is cultivated as a popular garden fern and houseplant. Adiantum capillus-veneris is native to humid warm temperate to tropical regions globally. It occurs in western and southern Europe (north to southern Scotland, where its northernmost sites are found), much of Africa, the Levant and across Asia to Japan, in Australasia, and in the Americas in the southern half of the United States from California to the Atlantic coast, through Mexico and Central America, to South America. There are two disjunct occurrences in the northern part of North America, at Cascade Springs in the Black Hills of South Dakota and Fairmont Hot Springs, British Columbia. In both instances, the warm microclimate created by hot mineral springs permits the growth of the plant far north of its normal range."}}, {"canonical_name": "Republica", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "republica", "book_id": "polyanthea_medicinal", "name": "Republica", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Republica"], "contexts": ["the state, the public", "the state or commonwealth"]}, {"entity_id": "republica_chriſtiana", "book_id": "historia_medicinal_monardes_1574", "name": "republica Chriſtiana", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["republica Chriſtiana"], "contexts": ["Christian republic, the intended audience", "republics"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Republica", "target_book": "historia_medicinal_monardes_1574", "target_name": "republica Chriſtiana", "similarity": 0.835}], "id": 1257, "stable_key": "clu_1eb77a43e3acd318", "ground_truth": {"modern_name": "republic", "confidence": "high", "type": "concept", "description": "A form of government where power is held by the people and their elected representatives.", "wikipedia_extract": "A republic, based on the Latin phrase res publica ('public thing' or 'people's thing'), is a state in which political power rests with the public (people), typically through their  representatives—in contrast to a monarchy. Although a republic is most often a single sovereign state, subnational state entities that have governments that are republican in nature may be referred to as republics. Representation in a republic may or may not be freely elected by the general citizenry. As of 2017, 159 of the world's 206 sovereign states use the word \"republic\" as part of their official names. Not all of these are republics in the sense of having elected governments, nor is the word \"republic\" used in the names of all states with elected governments. The term developed its modern meaning in reference to the constitution of the ancient Roman Republic, lasting from the overthrow of the kings in 509 BC to the establishment of the Empire in 27 BC."}}, {"canonical_name": "dores de rins", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "dores_de_rins", "book_id": "polyanthea_medicinal", "name": "dores de rins", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 4, "variants": ["dores de rins", "dor de rins", "dores dos rins"], "contexts": ["pain in kidneys", "kidney pains requiring aid"]}, {"entity_id": "dolores_de_riñones", "book_id": "historia_medicinal_monardes_1574", "name": "dolores de riñones", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["dolores de riñones"], "contexts": ["kidney pains"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "dores de rins", "target_book": "historia_medicinal_monardes_1574", "target_name": "dolores de riñones", "similarity": 0.884}], "id": 1258, "stable_key": "clu_4f259bcf1bfc1bce", "ground_truth": {"modern_name": "kidney pain", "confidence": "high", "type": "disease", "description": "Pain or discomfort located in the region of the kidneys.", "wikipedia_extract": "Kidney failure, also known as renal failure or end-stage renal disease (ESRD), is a medical condition in which the kidneys can no longer adequately filter waste products from the blood, functioning at less than 15% of normal levels. Kidney failure is classified as either acute kidney failure, which develops rapidly and may resolve; and chronic kidney failure, which develops slowly and can often be irreversible. Symptoms may include leg swelling, feeling tired, vomiting, loss of appetite, and confusion. Complications of acute and chronic failure include uremia, hyperkalemia, and volume overload. Complications of chronic failure also include heart disease, high blood pressure, and anaemia. Causes of acute kidney failure include low blood pressure, blockage of the urinary tract, certain medications, muscle breakdown, and hemolytic uremic syndrome."}}, {"canonical_name": "tapsia", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "tapsia", "book_id": "coloquios_da_orta_1563", "name": "tapsia", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["tapsia"], "contexts": ["plant name", "plant with large roots"]}, {"entity_id": "tapfia", "book_id": "polyanthea_medicinal", "name": "tapfia", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["tapfia"], "contexts": ["plant substance"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "tapsia", "target_book": "polyanthea_medicinal", "target_name": "tapfia", "similarity": 0.898}], "id": 1259, "stable_key": "clu_54c2601805395c1a", "ground_truth": {"modern_name": "Tapsia", "confidence": "high", "type": "plant", "description": "A plant, likely from the carrot family, known for its roots.", "note": "Possibly Ferula feruloides or a similar plant in the Apiaceae family.", "wikipedia_extract": "Tapsia (also spelled Tapsiya) is a village in the Gopiballavpur II CD block in the Jhargram subdivision of the Jhargram district in the state of West Bengal, India. Tapsia is located at 22°15′40.5″N 86°54′53.6″E. Jhargram subdivision, the only one in Jhargram district, shown in the map alongside, is composed of  hills, mounds and rolling lands. It is rather succinctly described in the District Human Development Report, 2011 (at that time it was part of Paschim Medinipur district), “The western boundary is more broken and picturesque, for the lower ranges of the Chhotanagpur Hills line the horizon, the jungle assumes the character of forest, and large trees begin to predominate. The soil, however, is lateritic, a considerable area is unproductive, almost uninhabited, especially in the extreme north-west where there are several hills over 1000 feet in height. The remainder of the country is an almost level plain broken only by the sand hills.” 3.48% of the population lives in urban areas and 96.52% lives in the rural areas. 20.11% of the total population belonged to scheduled castes and 29.37% belonged to scheduled tribes."}}, {"canonical_name": "Armenaja", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "armenaja", "book_id": "ricettario_fiorentino_1597", "name": "Armenaja", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["Armenaja", "Armenico", "armeno"], "contexts": ["specific type of earth", "armenian bole for grinding"]}, {"entity_id": "ager_armeny", "book_id": "coloquios_da_orta_1563", "name": "Ager Armeny", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Ager Armeny"], "contexts": ["Armenian stone, identified as lapis armenus"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Armenaja", "target_book": "coloquios_da_orta_1563", "target_name": "Ager Armeny", "similarity": 0.861}], "id": 1260, "stable_key": "clu_90f04a51b1ddcd7f", "ground_truth": {"modern_name": "Armenian bole", "confidence": "high", "type": "substance", "description": "A type of reddish clay or earth from Armenia, used medicinally and artistically.", "wikipedia_extract": "Armenian bole, also known as bolus armenus or bole armoniac, is an earthy clay, usually red, native to Armenia but also found in other places. The term Armenian was later referred to a specific quality of the clay. Originally used in medication, it has also been used as a pigment, as a poliment or base for gilding, and for other uses. It is red due to the presence of iron oxide; the clay also contains hydrous silicates of aluminum and possibly magnesium. Historically, the term bolu or bolus was used only for medicinal earths and Armenian bole was used as an astringent, prescribed against diarrhea, dysentery, and bleeding. References to Armenian bole were made by Theophrastus, Dioscorides (c. 41–90 AD) and Pliny the Elder (23–79 AD)."}}, {"canonical_name": "aphrodisiaca", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "aphrodisiaca", "book_id": "coloquios_da_orta_1563", "name": "aphrodisiaca", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["aphrodisiaca", "aphrodisiacas"], "contexts": ["medicinal property of asa-foetida", "property of areca"]}, {"entity_id": "aphrodifio", "book_id": "polyanthea_medicinal", "name": "Aphrodifio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Aphrodifio"], "contexts": ["section of a book"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "aphrodisiaca", "target_book": "polyanthea_medicinal", "target_name": "Aphrodifio", "similarity": 0.845}], "id": 1261, "stable_key": "clu_5d2daa0d76aa47e1", "ground_truth": {"modern_name": "aphrodisiac", "confidence": "high", "type": "concept", "description": "A substance or thing that arouses or increases sexual desire.", "wikipedia_extract": "An aphrodisiac is a substance that increases libido, sexual desire, sexual attraction, sexual pleasure, or sexual behavior. These substances range from a variety of plants, spices, and foods to synthetic chemicals. Natural aphrodisiacs, such as cannabis or cocaine, are classified into plant-based and non-plant-based substances. Synthetic aphrodisiacs include MDMA and methamphetamine. Aphrodisiacs can be classified by their type of effects (psychological or physiological). Aphrodisiacs that contain hallucinogenic properties, such as bufotenin, have psychological effects that can increase sexual desire and sexual pleasure."}}, {"canonical_name": "belericos", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "belericos", "book_id": "coloquios_da_orta_1563", "name": "belericos", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["belericos", "belericas"], "contexts": ["fruit name", "name for gotim"]}, {"entity_id": "beliricos", "book_id": "polyanthea_medicinal", "name": "beliricos", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["beliricos"], "contexts": ["beleric myrobalans for confection"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "belericos", "target_book": "polyanthea_medicinal", "target_name": "beliricos", "similarity": 0.873}], "id": 1262, "stable_key": "clu_f68dc7ee1112a7e8", "ground_truth": {"modern_name": "Beleric myrobalans", "confidence": "high", "type": "plant", "description": "Fruits from the Terminalia bellirica tree, used in traditional medicine.", "wikipedia_extract": "Terminalia bellirica, known as bahera, beleric or bastard myrobalan, is a large deciduous tree in the family Combretaceae. It is common on the plains and lower hills in South and Southeast Asia, where it is also grown as an avenue tree. The basionym is Myrobalanus bellirica Gaertn. (Fruct. Sem. Pl. 2: 90, t. 97. 1791). William Roxburgh transferred M. bellirica to Terminalia as \"T. bellerica (Gaertn.) Roxb.\"."}}, {"canonical_name": "aroeira", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "aroeira", "book_id": "coloquios_da_orta_1563", "name": "aroeira", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["aroeira"], "contexts": ["leaf shape comparison", "plant whose leaves resemble those of the incense tree"]}, {"entity_id": "arocira", "book_id": "polyanthea_medicinal", "name": "Arocira", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Arocira"], "contexts": ["herb that dries phlegm and humors"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "aroeira", "target_book": "polyanthea_medicinal", "target_name": "Arocira", "similarity": 0.845}], "id": 1263, "stable_key": "clu_208a3bc7f7669ee2", "ground_truth": {"modern_name": "Aroeira", "confidence": "high", "type": "plant", "description": "A plant, likely from the Anacardiaceae family, with medicinal properties.", "note": "Often refers to species of Schinus, such as Schinus molle or Schinus terebinthifolius.", "wikipedia_extract": "Schinus terebinthifolia is a species of flowering plant in the cashew family, Anacardiaceae, that is native to subtropical and tropical South America. Common names include Brazilian peppertree, aroeira, rose pepper, broadleaved pepper tree, wilelaiki (or wililaiki), Christmasberry tree and Florida holly. The species name has been very commonly misspelled as ‘terebinthifolius’. Brazilian peppertree is a sprawling shrub or small tree, with a shallow root system, reaching a height of 7–10 m (23–33 ft). The branches can be upright, reclining, or nearly vine-like, all on the same plant. Its plastic morphology allows it to thrive in all kinds of ecosystems, from dunes to swamps, where it grows as a semiaquatic plant."}}, {"canonical_name": "esula", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "esula", "book_id": "coloquios_da_orta_1563", "name": "esula", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["esula"], "contexts": ["plant name, possibly spurge", "plant name, strong laxative"]}, {"entity_id": "essula", "book_id": "polyanthea_medicinal", "name": "essula", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["essula"], "contexts": ["plant substance"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "esula", "target_book": "polyanthea_medicinal", "target_name": "essula", "similarity": 0.861}], "id": 1264, "stable_key": "clu_473738ce9ce8e72d", "ground_truth": {"modern_name": "Spurge", "confidence": "high", "type": "plant", "linnaean": "Euphorbia", "family": "Euphorbiaceae", "description": "Plant known for its milky sap, often used as a laxative.", "note": "The term 'esula' historically referred to plants in the genus Euphorbia, commonly known as spurges.", "wikipedia_extract": "Euphorbia is a large and diverse genus of flowering plants, commonly called spurge, in the family Euphorbiaceae. Euphorbias range from tiny annual plants to large and long-lived trees, with perhaps the tallest being Euphorbia ampliphylla at 30 m (98 ft) or more. The genus has roughly 2,000 members, making it one of the largest genera of flowering plants. It also has one of the largest ranges of chromosome counts, along with Rumex and Senecio. Euphorbia antiquorum is the type species for the genus Euphorbia. It was first described by Carl Linnaeus in 1753 in Species Plantarum."}}, {"canonical_name": "estoraque", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "estoraque", "book_id": "coloquios_da_orta_1563", "name": "estoraque", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["estoraque", "esioraque"], "contexts": ["substance from Ethiopia", "substance similar to lacre"]}, {"entity_id": "estoraque", "book_id": "polyanthea_medicinal", "name": "estoraque", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["estoraque"], "contexts": ["aromatic resin used in medicine", "storax, ingredient in pills"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "estoraque", "target_book": "polyanthea_medicinal", "target_name": "estoraque", "similarity": 1.0}], "id": 1265, "stable_key": "clu_bf0373ce9a3835b8", "ground_truth": {"modern_name": "Storax", "confidence": "high", "type": "plant", "description": "Aromatic resin from trees, used in perfumery and medicine.", "note": "'Estoraque' is the Portuguese/Spanish term for storax, a resin derived from trees of the genus Styrax.", "wikipedia_extract": "Storax (Latin: storax; Greek: στύραξ, stúrax), often commercially sold as styrax, is a natural fragrant resin isolated from the wounded bark of Liquidambar orientalis Mill. (Asia Minor) and Liquidambar styraciflua L. (Eastern US, Mexico, Central America) (Altingiaceae). It is distinct from benzoin (also called \"storax\"), a similar resin obtained from the Styracaceae plant family. Purified storax contains about 33–50% storesin, an alcoholic resin,  5–15% cinnamic acid, 5–15% cinnamyl cinnamate, about 10% phenylpropyl cinnamate, as well small amounts of ethyl cinnamate, benzyl cinnamate, and styrene. Some may contain traces of vanillin or triterpenic acids (oleanolic and 3-epioleanolic acids). Storax has a balsamic, floral/lilac, and leathery smell. It and its derivatives (resinoid, essential oil, absolute) are used as flavors and fragrances, as well as in pharmaceuticals (Friar's Balsam)."}}, {"canonical_name": "simples", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "simples", "book_id": "coloquios_da_orta_1563", "name": "simples", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["simples"], "contexts": ["medicines from India", "single medicinal ingredient"]}, {"entity_id": "simplices", "book_id": "polyanthea_medicinal", "name": "Simplices", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Simplices"], "contexts": ["simple remedies"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "simples", "target_book": "polyanthea_medicinal", "target_name": "Simplices", "similarity": 0.91}], "id": 1266, "stable_key": "clu_db551c5b32287ce2", "ground_truth": {"modern_name": "Simple remedies", "confidence": "high", "type": "concept", "description": "Medicinal substances derived from single, unprocessed natural sources.", "note": "'Simples' refers to single, uncompounded medicinal ingredients, often plants.", "wikipedia_extract": "The doctrine of signatures, also known as the doctrine of correspondences, is a biomedicinal theory of pseudoscience. It states that herbs or animals have physical or behavioral traits that mirror the ailment it can successfully treat. Theological justifications, such as that of botanist William Cole, were that God would want to show men what plants would be useful for. The doctrine of signatures has a debated origin. Many historians believe it begins with primitive thinking methods, while other historians believe it originated with Dioscorides and was popularized in the 16th and 17th centuries after Jakob Böhme coined the doctrine of signatures in his book The Signature of All Things. This theory is a possible explanation for the ancient discovery of medicinal properties; however, there is no definitive proof as to whether the medicinal property or the connection in physical/behavioral traits was realized first."}}, {"canonical_name": "pao", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "pao", "book_id": "coloquios_da_orta_1563", "name": "pao", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["pao"], "contexts": ["wood from a tree", "wood mentioned by Galen"]}, {"entity_id": "paopo", "book_id": "polyanthea_medicinal", "name": "paopo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["paopo"], "contexts": ["substance for mixing"]}, {"entity_id": "paoalvo", "book_id": "polyanthea_medicinal", "name": "paoalvo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["paoalvo"], "contexts": ["white bread used as a preventative"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "pao", "target_book": "polyanthea_medicinal", "target_name": "paopo", "similarity": 0.94}, {"source_book": "coloquios_da_orta_1563", "source_name": "pao", "target_book": "polyanthea_medicinal", "target_name": "paoalvo", "similarity": 0.871}], "id": 1267, "stable_key": "clu_195fe1ca6e8f9454", "ground_truth": {"modern_name": "Wood", "confidence": "medium", "type": "substance", "description": "Organic material from trees, used for various purposes including medicine.", "note": "The term 'pao' in Portuguese means wood. 'Paoalvo' likely refers to white bread, possibly as a contrast or a specific preparation.", "wikipedia_extract": "Wood is a structural tissue/material found as xylem in the stems and roots of trees and other woody plants. Being a natural material, it is characterized as an organic material – a natural composite of cellulosic fibers that are strong in tension and embedded in a matrix of lignin and hemicelluloses that resists compression. Wood is sometimes defined as only the secondary xylem in the stems of trees, or more broadly to include the same type of tissue elsewhere, such as in the roots of trees or shrubs. In a living tree, it performs a mechanical-support function, enabling woody plants to grow large or to stand up by themselves. It also conveys water and nutrients among the leaves, other growing tissues, and the roots. Wood may also refer to other plant materials with comparable properties, and to material engineered from wood, woodchips, or fibers."}}, {"canonical_name": "luc", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "luc", "book_id": "coloquios_da_orta_1563", "name": "luc", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["luc"], "contexts": ["substance discussed", "name for the goma"]}, {"entity_id": "lucis", "book_id": "polyanthea_medicinal", "name": "Lucis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Lucis", "Lucis mayores"], "contexts": ["purgative medicine", "larger purging pills"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "luc", "target_book": "polyanthea_medicinal", "target_name": "Lucis", "similarity": 0.895}], "id": 1268, "stable_key": "clu_709d3f8e38fd74cc", "ground_truth": {"modern_name": "Pills", "confidence": "high", "type": "object", "description": "Solid dosage forms of medicine, often for internal administration.", "note": "'Luc' and 'Lucis' likely refer to specific types of medicinal pills or boluses, possibly with purgative properties.", "wikipedia_extract": "Chemistry is the scientific study of the properties and behavior of matter. It is a physical science within the natural sciences that studies the chemical elements that make up matter and compounds made of atoms, molecules and ions: their composition, structure, properties, behavior and the changes they undergo during reactions with other substances. Chemistry also addresses the nature of chemical bonds in chemical compounds. In the scope of its subject, chemistry occupies an intermediate position between physics and biology. It is sometimes called the central science because it provides a foundation for understanding both basic and applied scientific disciplines at a fundamental level. For example, chemistry explains aspects of plant growth (botany), the formation of igneous rocks (geology), how atmospheric ozone is formed and how environmental pollutants are degraded (ecology), the properties of the soil on the Moon (cosmochemistry), how medications work (pharmacology), and how to collect DNA evidence at a crime scene (forensics)."}}, {"canonical_name": "ningela", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "ningela", "book_id": "polyanthea_medicinal", "name": "ningela", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["ningela"], "contexts": ["ingredient in a remedy", "seeds used in powders"]}, {"entity_id": "nigela", "book_id": "coloquios_da_orta_1563", "name": "nigela", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["nigela", "nigela citrina"], "contexts": ["spice, third type of cardamomo", "citrine nigela, third type of cardamomo"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "ningela", "target_book": "coloquios_da_orta_1563", "target_name": "nigela", "similarity": 0.878}], "id": 1269, "stable_key": "clu_6c2f7b8d2df8d8c3", "ground_truth": {"modern_name": "Nigella", "confidence": "high", "type": "plant", "linnaean": "Nigella sativa", "family": "Ranunculaceae", "description": "Herb known for its aromatic seeds, used as a spice and in medicine.", "note": "Also known as 'black cumin' or 'fennel flower'.", "wikipedia_extract": "Nigella sativa (common names, black caraway, black cumin, nigella or kalonji) is an annual flowering plant in the family Ranunculaceae, native to western Asia (Arabia, the Levant, Cyprus, Turkey, Iran and Iraq), and eastern Europe (Bulgaria and Romania). It is naturalised over parts of Europe, northern Africa, and east to Myanmar. It is used as a spice in various food preparations, especially in Arab and Halal cuisines. The genus name Nigella is a diminutive of the Latin niger \"black\", referring to the seed colour. The specific epithet sativa means \"cultivated\". In food preparation, Nigella sativa and its seeds are variously called black caraway, black seed, black cumin, fennel flower, nigella, nutmeg flower, Roman coriander, or black onion seed."}}, {"canonical_name": "Agnocasto", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "agnocasto", "book_id": "polyanthea_medicinal", "name": "Agnocasto", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Agnocasto", "Agnocafto", "agnocasto"], "contexts": ["chaste tree", "chaste tree, herb"]}, {"entity_id": "agnocasto", "book_id": "coloquios_da_orta_1563", "name": "agnocasto", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["agnocasto", "agnO'Casto"], "contexts": ["plant used to repress carnal desires", "plant distinguished from negundo"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Agnocasto", "target_book": "coloquios_da_orta_1563", "target_name": "agnocasto", "similarity": 0.983}], "id": 1270, "stable_key": "clu_00c3e67d228078fd", "ground_truth": {"modern_name": "Chaste tree", "confidence": "high", "type": "plant", "linnaean": "Vitex agnus-castus", "family": "Lamiaceae", "description": "Shrub whose berries were used to reduce libido and for medicinal purposes.", "note": "'Agnocasto' is the Italian/Portuguese name for Vitex agnus-castus.", "wikipedia_extract": "Vitex agnus-castus (also called vitex,  chaste tree / chastetree, chasteberry, Abraham's balm, lilac chastetree, or monk's pepper) is a plant native of the Mediterranean region. It is one of the few temperate-zone species of Vitex, which is on the whole a genus of tropical and subtropical flowering plants. Vitex is a cross-pollinating plant, but its self-pollination has been recorded. Theophrastus mentioned the shrub several times, as ágnos (ἄγνος) in Enquiry into Plants. It has been long believed to be an anaphrodisiac – leading to its name as \"chaste tree\" – but its effectiveness for such action remains unproven. The shrub was utilized for religious rituals in ancient Greece and among the Philistines in modern-day Israel."}}, {"canonical_name": "pulso", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "pulso", "book_id": "coloquios_da_orta_1563", "name": "pulso", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["pulso"], "contexts": ["part of the body to be examined", "used to diagnose fever and humors"]}, {"entity_id": "pulso_dos_pes", "book_id": "polyanthea_medicinal", "name": "pulso dos pes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["pulso dos pes", "pulso dos bracos"], "contexts": ["pulses in the feet", "pulses in the arms"]}, {"entity_id": "pulses", "book_id": "polyanthea_medicinal", "name": "pulses", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["pulses"], "contexts": ["body part for observation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "pulso", "target_book": "polyanthea_medicinal", "target_name": "pulso dos pes", "similarity": 0.869}, {"source_book": "coloquios_da_orta_1563", "source_name": "pulso", "target_book": "polyanthea_medicinal", "target_name": "pulses", "similarity": 0.94}], "id": 1271, "stable_key": "clu_50478d751e14abff", "ground_truth": {"modern_name": "pulse", "confidence": "high", "type": "concept", "description": "The rhythmic throbbing of arteries, used for diagnosis.", "wikipedia_extract": "In medicine, pulse is the rhythmic expansion and contraction of an artery in response to the cardiac cycle (heartbeat). The pulse may be felt (palpated) in any place that allows an artery to be compressed near the surface of the body, such as at the neck (carotid artery), wrist (radial artery or ulnar artery), at the groin (femoral artery), behind the knee (popliteal artery), near the ankle joint (posterior tibial artery), and on foot (dorsalis pedis artery). The pulse is most commonly measured at the wrist or neck for adults and at the brachial artery (inner upper arm between the shoulder and elbow) for infants and very young children. A sphygmograph is an instrument for measuring the pulse. Claudius Galen was perhaps the first physiologist to describe the pulse. The pulse is an expedient tactile method of determination of systolic blood pressure to a trained observer."}}, {"canonical_name": "milho miudo", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "milho_miudo", "book_id": "polyanthea_medicinal", "name": "milho miudo", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["milho miudo"], "contexts": ["small millet used in syrup", "ingredient in a preparation"]}, {"entity_id": "milho", "book_id": "coloquios_da_orta_1563", "name": "milho", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["milho"], "contexts": ["plant", "seeds similar to long pepper"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "milho miudo", "target_book": "coloquios_da_orta_1563", "target_name": "milho", "similarity": 0.869}], "id": 1272, "stable_key": "clu_e76bec39b57bec9b", "ground_truth": {"modern_name": "millet", "confidence": "high", "type": "plant", "description": "A small-grained cereal grass, used as food and in preparations.", "note": "The term 'milho miudo' specifically refers to small millet.", "wikipedia_extract": "Millets () are a highly varied group of small-seeded grasses, widely grown around the world as cereal crops or grains for fodder and human food. Most millets belong to the tribe Paniceae. Millets are important crops in the semi-arid tropics of Asia and Africa, especially in India, Mali, Nigeria, and Niger, with 97% of production in developing countries. The crop is favoured for its productivity and short growing season under hot dry conditions. The millets are sometimes understood to include the widely cultivated sorghum; apart from that, pearl millet is the most commonly cultivated of the millets. Finger millet, proso millet, barnyard millet, little millet, kodo millet, browntop millet and foxtail millet are other important crop species."}}, {"canonical_name": "esquinancia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "esquinancia", "book_id": "polyanthea_medicinal", "name": "esquinancia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["esquinancia", "Squinantia", "esquinencia"], "contexts": ["illness treated by Quintilio's powders", "throat ailment"]}, {"entity_id": "escoriaçam", "book_id": "coloquios_da_orta_1563", "name": "escoriaçam", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["escoriaçam"], "contexts": ["potential side effect", "a type of damage or irritation"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "esquinancia", "target_book": "coloquios_da_orta_1563", "target_name": "escoriaçam", "similarity": 0.856}], "id": 1273, "stable_key": "clu_3e1d157be249364d", "ground_truth": {"modern_name": "quinzy", "confidence": "high", "type": "disease", "description": "A severe sore throat, particularly tonsillitis.", "note": "'Escoriaçam' likely refers to a form of skin irritation or excoriation."}}, {"canonical_name": "mumia", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "mumia", "book_id": "polyanthea_medicinal", "name": "mumia", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["mumia", "Mumia", "Mumia hominisfani", "Mumiade"], "contexts": ["mummy, ingredient in oil", "mummy, medicinal substance"]}, {"entity_id": "múmia", "book_id": "coloquios_da_orta_1563", "name": "múmia", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["múmia"], "contexts": ["main ingredient in a 'solda'"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "mumia", "target_book": "coloquios_da_orta_1563", "target_name": "múmia", "similarity": 0.951}], "id": 1274, "stable_key": "clu_4e2c60a631f383b0", "ground_truth": {"modern_name": "mummy", "confidence": "high", "type": "substance", "description": "Preserved human or animal remains used as a medicinal substance.", "wikipedia_extract": "A mummy is a dead human or an animal whose soft tissues and organs have been preserved by either intentional or accidental exposure to chemicals, extreme cold, very low humidity, or lack of air, so that the recovered body does not decay further if kept in cool and dry conditions. Some authorities restrict the use of the term to bodies deliberately embalmed with chemicals, but the use of the word to cover accidentally desiccated bodies goes back to at least the early 17th century. Mummies of humans and animals have been found on every continent, both as a result of natural preservation through unusual conditions, and as cultural artifacts. Over one million animal mummies have been found in Egypt, many of which are cats. Many of the Egyptian animal mummies are sacred ibis, and radiocarbon dating suggests the Egyptian ibis mummies that have been analyzed were from a time frame that falls between approximately 450 and 250 BC. The earliest discovered evidence of deliberate mummification in human cultures now extends to approximately 10,000 B.C. and is documented to have existed across Southeast Asia, China, New Guinea, and Australia in burials discovered there, and is prompting research to cultures documented to 20,000 years ago for evidence of use of the same mummification methods."}}, {"canonical_name": "alfinete", "category": "OBJECT", "subcategory": "TOOL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "alfinete", "book_id": "polyanthea_medicinal", "name": "alfinete", "category": "OBJECT", "subcategory": "TOOL", "count": 4, "variants": ["alfinete"], "contexts": ["used to prick the skin", "used to make a wound"]}, {"entity_id": "alfenete", "book_id": "coloquios_da_orta_1563", "name": "alfenete", "category": "OBJECT", "subcategory": "TOOL", "count": 1, "variants": ["alfenete"], "contexts": ["used to test substance quality"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "alfinete", "target_book": "coloquios_da_orta_1563", "target_name": "alfenete", "similarity": 0.903}], "id": 1275, "stable_key": "clu_9d648a846c40a548", "ground_truth": {"modern_name": "pin", "confidence": "high", "type": "object", "description": "A small, sharp pointed object used for fastening or pricking.", "wikipedia_extract": "A pin is a device, typically pointed, used for fastening objects or fabrics together. Pins can have the following sorts of body: a shaft of a rigid inflexible material meant to be inserted in a slot, groove, or hole (as with pivots, hinges, and jigs) a shaft connected to a head and ending in a sharp tip meant to pierce one or more pieces of soft materials like cloth or paper (the straight or push pin) a single strip of a rigid but flexible material (e.g. a wire) whose length has been folded into parallel prongs in such fashion that the middle length of each curves towards the other so that, when anything is inserted between them, they act as a clamp (e.g. the bobby pin) two strips of a rigid material bound together by a spring at one end so that, when the spring held open, one can insert some material between the prongs at the other end that, the spring allowed to close, then clamp the inserted material. According to their function, pins can be made of metals (e.g. steel, copper, or brass), wood, or plastic. Pins have been found at archaeological sites dating as early as the Paleolithic, made of bone and thorn, and at Neolithic, Celtic and Ancient Roman sites. Neolithic sites are rich in wooden pins, and are still common through Elizabethan times. Metal pins dating to the Bronze Age have been found in Asia, North Africa and Europe, like the hammer-headed pins from the kurgan burials in the northeastern Caucasus."}}, {"canonical_name": "agua de canela", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "agua_de_canela", "book_id": "polyanthea_medicinal", "name": "agua de canela", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["agua de canela", "aguadecanela"], "contexts": ["cinnamon water for moistening vapors", "water infused with cinnamon"]}, {"entity_id": "agua_de_canela", "book_id": "coloquios_da_orta_1563", "name": "agua de canela", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["agua de canela"], "contexts": ["Used to season many dishes"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "agua de canela", "target_book": "coloquios_da_orta_1563", "target_name": "agua de canela", "similarity": 1.0}], "id": 1276, "stable_key": "clu_975d637e7164bd51", "ground_truth": {"modern_name": "cinnamon water", "confidence": "high", "type": "substance", "description": "Water infused with the spice of cinnamon, used medicinally and for flavor.", "wikipedia_extract": "Cinnamon is a spice obtained from the inner bark of several tree species from the genus Cinnamomum. Cinnamon is used mainly as an aromatic condiment and flavouring additive in a wide variety of cuisines, in particular sweet and savoury dishes such as biscuits, breakfast cereals, snack foods, bagels, teas, hot chocolate, and traditional foods. The aroma and flavour of cinnamon derive from its essential oil and principal component, cinnamaldehyde, as well as numerous other constituents, including eugenol. Cinnamon is the name for several species of trees and the commercial spice products that some of them produce. All are members of the genus Cinnamomum in the family Lauraceae. Only a few Cinnamomum species are grown commercially for spice."}}, {"canonical_name": "mastigado", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "mastigado", "book_id": "polyanthea_medicinal", "name": "mastigado", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 4, "variants": ["mastigado", "mastigados", "mastigar"], "contexts": ["chewing food thoroughly", "chewing"]}, {"entity_id": "masticatorio", "book_id": "coloquios_da_orta_1563", "name": "masticatorio", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["masticatorio"], "contexts": ["use of areca"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "mastigado", "target_book": "coloquios_da_orta_1563", "target_name": "masticatorio", "similarity": 0.88}], "id": 1277, "stable_key": "clu_37045bafc2c38f5c", "ground_truth": {"modern_name": "chewing", "confidence": "high", "type": "concept", "description": "The act of masticating food or other substances.", "wikipedia_extract": "Chewing or mastication is the process by which food is crushed and ground by the teeth. It is the first step in the process of digestion, allowing a greater surface area for digestive enzymes and bile to break down the foods. During the mastication process, the food is positioned by the cheek and tongue between the teeth for grinding. The muscles of mastication move the jaws to bring the teeth into intermittent contact, repeatedly opening and closing. As chewing continues, and the digestive enzymes in saliva (especially amylase and lingual lipase) begin to break down carbohydrates and other nutrients, the food is made softer and warmer, forming a food bolus ready to be swallowed. It enters the esophagus and via peristalsis continues on to the stomach, where the next step of digestion occurs."}}, {"canonical_name": "jasmin", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "jasmin", "book_id": "polyanthea_medicinal", "name": "jasmin", "category": "PLANT", "subcategory": "PLANT", "count": 4, "variants": ["jasmin", "jasmines", "jasmins", "jaſmins"], "contexts": ["jasmine flowers", "flower causing uterine accidents"]}, {"entity_id": "jazmim", "book_id": "coloquios_da_orta_1563", "name": "jazmim", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["jazmim"], "contexts": ["plant called jasmine"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "jasmin", "target_book": "coloquios_da_orta_1563", "target_name": "jazmim", "similarity": 0.866}], "id": 1278, "stable_key": "clu_1286429c3d326e5c", "ground_truth": {"modern_name": "jasmine", "confidence": "high", "type": "plant", "description": "Fragrant flowering plant, often used in medicine and perfumery.", "wikipedia_extract": "Jasmine (botanical name: Jasminum, pronounced  YAS-min-əm) is a genus of shrubs and vines in the olive family of Oleaceae. It contains around 200 species native to tropical and warm temperate regions of Eurasia, Africa, and Oceania. Jasmines are widely cultivated for the characteristic fragrance of their flowers. The village of Shubra Beloula in Egypt grows most of the jasmine used by the global perfume industry. Jasmine can be either deciduous or evergreen, and can be erect, spreading, or climbing shrubs and vines. The leaves are borne in opposing or alternating arrangement and can be of simple, trifoliate, or pinnate formation."}}, {"canonical_name": "Symphorianus Campegins", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "symphorianus_campegins", "book_id": "polyanthea_medicinal", "name": "Symphorianus Campegins", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Symphorianus Campegins", "Simphorianus Campegius", "Symphorian", "Symphorian. Campeg."], "contexts": ["author of medical practice", "early modern scholar"]}, {"entity_id": "symphorien_champier", "book_id": "coloquios_da_orta_1563", "name": "Symphorien Champier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Symphorien Champier"], "contexts": ["French physician, writer"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Symphorianus Campegins", "target_book": "coloquios_da_orta_1563", "target_name": "Symphorien Champier", "similarity": 0.856}], "id": 1279, "stable_key": "clu_9b30aa19e63831be", "ground_truth": {"modern_name": "Symphorien Champier", "confidence": "high", "type": "person", "description": "French physician and writer known for medical and humanist works.", "note": "Modern identification based on biographical information correlating with the historical context.", "wikipedia_extract": "Symphorien Champier (1471–1539) was a doctor and writer from Lyon. Born in Saint-Symphorien, France, Champier was a relation of the Chevalier de Bayard through his wife, Marguerite Terrail. A doctor of medicine at Montpellier, Champier was the personal physician of Antoine, Duke of Lorraine, whom he followed to Italy with Louis XII, attending to several battles, and finally settling in Lyon. He worked in Lyon alongside François Rabelais (who wrote satirically of him in Gargantua and Pantagruel), where he established the College of the Doctors of Lyon. There he fulfilled the duties of an alderman and contributed to numerous local foundations, in particular L'École des médecins de Lyon (\"The School of the Doctors of Lyon\"). His fame was considerable in Lyon, which in the 16th century was the greatest manufacturer of medical books in France, with editors such as Sébastien Gryphe."}}, {"canonical_name": "estupefactiva", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "estupefactiva", "book_id": "polyanthea_medicinal", "name": "estupefactiva", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["estupefactiva", "estupefactivo", "eſtupefactiva"], "contexts": ["stupefactive quality", "quality of opium"]}, {"entity_id": "estupefativo", "book_id": "coloquios_da_orta_1563", "name": "estupefativo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["estupefativo"], "contexts": ["property of opium"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "estupefactiva", "target_book": "coloquios_da_orta_1563", "target_name": "estupefativo", "similarity": 0.898}], "id": 1280, "stable_key": "clu_0a8ae8d0dc15c494", "ground_truth": {"modern_name": "stupefacient", "confidence": "high", "type": "concept", "description": "Causing stupor or insensibility; having a numbing effect.", "wikipedia_extract": "The term narcotic (, from ancient Greek ναρκῶ narkō, \"I make numb\") originally referred medically to any psychoactive compound with numbing or paralyzing properties. In the United States, it has since become associated with opiates and opioids, commonly morphine and heroin, as well as derivatives of many of the compounds found within raw opium latex. Legally speaking, the term \"narcotic\" may be imprecisely defined and typically has negative connotations. When used in a legal context in the U.S., a narcotic drug is totally prohibited, such as heroin, or one that is used in violation of legal regulation (in this word sense, equal to any controlled substance or illicit drug). In the medical community, the term is more precisely defined as a synonym of opioids and generally does not carry the same negative connotations. Statutory classification of a drug as a narcotic often increases the penalties for violation of drug control statutes."}}, {"canonical_name": "Doudos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "doudos", "book_id": "polyanthea_medicinal", "name": "Doudos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["Doudos", "Doudo", "doudos"], "contexts": ["madness", "mentally ill people"]}, {"entity_id": "doudos", "book_id": "coloquios_da_orta_1563", "name": "doudos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["doudos"], "contexts": ["mad, not attributed to lodestone"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Doudos", "target_book": "coloquios_da_orta_1563", "target_name": "doudos", "similarity": 0.934}], "id": 1281, "stable_key": "clu_566a44864a0331bc", "ground_truth": {"modern_name": "madness", "confidence": "high", "type": "disease", "description": "A severe mental disorder characterized by loss of contact with reality.", "wikipedia_extract": "The history of medicine is both a study of medicine throughout history as well as a multidisciplinary field of study that seeks to explore and understand medical practices, both past and present, throughout human societies. The history of medicine is the study and documentation of the evolution of medical treatments, practices, and knowledge over time. Medical historians often draw from other humanities fields of study including economics, health sciences, sociology, and politics to better understand the institutions, practices, people, professions, and social systems that have shaped medicine. When a period which predates or lacks written sources regarding medicine, information is instead drawn from archaeological sources. This field tracks the evolution of human societies' approach to health, illness, and injury ranging from prehistory to the modern day, the events that shape these approaches, and their impact on populations. Early medical traditions include those of Babylon, Egypt, China and India."}}, {"canonical_name": "impotencias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "impotencias", "book_id": "polyanthea_medicinal", "name": "impotencias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["impotencias", "impotencia"], "contexts": ["impotence", "inability to sleep"]}, {"entity_id": "impotentes", "book_id": "coloquios_da_orta_1563", "name": "impotentes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["impotentes"], "contexts": ["effect of camphor on men"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "impotencias", "target_book": "coloquios_da_orta_1563", "target_name": "impotentes", "similarity": 0.978}], "id": 1282, "stable_key": "clu_ba0d5f7ccc1e357e", "ground_truth": {"modern_name": "impotence", "confidence": "high", "type": "disease", "description": "Inability to achieve or maintain sexual erection; general inability.", "wikipedia_extract": "Erectile dysfunction (ED), also referred to as impotence, is a form of sexual dysfunction in males characterized by the persistent or recurring inability to achieve or maintain a penile erection with sufficient rigidity and duration for satisfactory sexual activity. It is the most common sexual problem in males and can cause psychological distress due to its impact on self-image and sexual relationships. The term erectile dysfunction does not encompass other erection-related disorders, such as priapism. The majority of ED cases are attributed to physical risk factors and predictive factors. These factors can be categorized as vascular, neurological, local penile, hormonal, and drug-induced. Notable predictors of ED include aging, cardiovascular disease, diabetes mellitus, high blood pressure, obesity, abnormal lipid levels in the blood, hypogonadism, smoking, depression, and medication use."}}, {"canonical_name": "hakims", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "hakims", "book_id": "coloquios_da_orta_1563", "name": "hakims", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 4, "variants": ["hakims", "hakims mussulmanos"], "contexts": ["Muslim physicians", "Islamic physicians"]}, {"entity_id": "judges", "book_id": "first_principles_spencer_1862", "name": "judges", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["judges"], "contexts": ["interpreters of law in courts"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "hakims", "target_book": "first_principles_spencer_1862", "target_name": "judges", "similarity": 0.932}], "id": 1283, "stable_key": "clu_210ea919267ceeba", "ground_truth": {"modern_name": "Hakim", "confidence": "high", "type": "person", "description": "Islamic physician and scholar", "note": "The context in 'Coloquios da Orta' points to physicians of the East. 'Judges' is a secondary meaning but less likely in this scientific/medical text.", "wikidata_id": "Q39631", "wikidata_description": "professional who practices medicine"}}, {"canonical_name": "Scariola", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "scariola", "book_id": "ricettario_fiorentino_1597", "name": "Scariola", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Scariola"], "contexts": ["herb used in syrup", "ingredient in a syrup"]}, {"entity_id": "scariola", "book_id": "polyanthea_medicinal", "name": "Scariola", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Scariola"], "contexts": ["plant juice used in remedies"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Scariola", "target_book": "polyanthea_medicinal", "target_name": "Scariola", "similarity": 0.908}], "id": 1284, "stable_key": "clu_dad3bbd264e3606f", "ground_truth": {"modern_name": "Scariola", "confidence": "high", "type": "plant", "description": "A genus of plants, often referring to wild lettuce, used medicinally.", "note": "Likely refers to a species within the *Lactuca* genus, commonly known as wild lettuce.", "wikipedia_extract": "Lactuca, commonly known as lettuce, is a genus of flowering plants in the family Asteraceae. The genus includes at least 50 species, distributed worldwide, but mainly in temperate Eurasia. Its best-known representative is the garden lettuce (Lactuca sativa), with its many varieties. \"Wild lettuce\" commonly refers to the wild-growing relatives of common garden lettuce. Many species are common weeds. Lactuca species are diverse and take a wide variety of forms. They are annuals, biennials, perennials, or shrubs."}}, {"canonical_name": "veficatorios", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "veficatorios", "book_id": "polyanthea_medicinal", "name": "veficatorios", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["veficatorios", "Veficatorios"], "contexts": ["vesicants", "blistering agents"]}, {"entity_id": "vescicatorio", "book_id": "ricettario_fiorentino_1597", "name": "Vescicatorio", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Vescicatorio"], "contexts": ["a preparation for blistering", "preparation for vesicatory use"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "veficatorios", "target_book": "ricettario_fiorentino_1597", "target_name": "Vescicatorio", "similarity": 0.86}], "id": 1285, "stable_key": "clu_92d18163946e3a36", "ground_truth": {"modern_name": "vesicant", "confidence": "high", "type": "substance", "description": "A substance that causes blistering of the skin.", "wikipedia_extract": "A blister agent (or vesicant) is a chemical compound that causes severe skin, eye and mucosal pain and irritation in the form of severe chemical burns resulting in fluid filled blisters. Named for their ability to cause vesication, blister agent refers in common parlance to those agents which are developed for, or have been in the past utilized as chemical weapons, though some naturally occurring terpenoids such as cantharidin and T2 mycotoxin fall under this class. Exposure to blister agents is widely incapacitating, but often precipitates a delayed effect, with symptoms developing one to twenty four hours following the initial contact with the agent. Treatment for acute exposure is largely supportive, with the exception of Lewisite, for which an antidote is available. Overall lethality as a direct result of exposure is low, but increases with dose. Despite low overall lethality, blister agent exposure requires extensive supportive treatment, and can cause significant strain on medical systems."}}, {"canonical_name": "movimento périſtaltico", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "movimento_périſtaltico", "book_id": "polyanthea_medicinal", "name": "movimento périſtaltico", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 4, "variants": ["movimento périſtaltico", "movimento Peristaltico", "movimento Peristalticodo estomago", "movimentoperiftaltico"], "contexts": ["peristaltic movement of the stomach", "peristaltic movement of stomach"]}, {"entity_id": "peristaltic_motion", "book_id": "first_principles_spencer_1862", "name": "peristaltic motion", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["peristaltic motion"], "contexts": ["wave-like muscle contractions"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "movimento périſtaltico", "target_book": "first_principles_spencer_1862", "target_name": "peristaltic motion", "similarity": 0.842}], "id": 1286, "stable_key": "clu_2e662682d6c69889", "ground_truth": {"modern_name": "peristaltic motion", "confidence": "high", "type": "concept", "wikidata_id": "Q308695", "wikidata_description": "wavelike sequence of muscular contraction and relaxation that passes along a tubelike structure", "wikipedia_url": "https://en.wikipedia.org/wiki/Peristalsis", "wikipedia_extract": "Peristalsis ( PERR-ih-STAL-siss, US also  -⁠STAWL-) is a  type of gut motility, characterized by radially symmetrical contraction and relaxation of muscles that propagate in a wave down a tube, in an anterograde direction. Peristalsis is progression of coordinated contraction of involuntary circular muscles, which is preceded by a simultaneous contraction of the longitudinal muscle and relaxation of the circular muscle in the lining of the gut. In much of a digestive tract, such as the human gastrointestinal tract, smooth muscle tissue contracts in sequence to produce a peristaltic wave, which propels a ball of food (a food bolus) before being transformed into chyme in the stomach along the tract. The peristaltic movement comprises relaxation of circular smooth muscles, then their contraction behind the chewed material to keep it from moving backward, then longitudinal contraction to push it forward. Catastalsis is an obsolete term for the peristaltic wave. Earthworms use a similar mechanism to drive their locomotion, and some modern machinery imitate this design."}}, {"canonical_name": "Kepler’s law", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "kepler’s_law", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Kepler’s law", "category": "CONCEPT", "subcategory": "THEORY", "count": 4, "variants": ["Kepler’s law"], "contexts": ["law relating planetary orbits and periods", "law relating planetary orbital periods and distances"]}, {"entity_id": "kepler’s_laws", "book_id": "first_principles_spencer_1862", "name": "Kepler’s laws", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["Kepler’s laws"], "contexts": ["laws describing planetary motion"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Kepler’s law", "target_book": "first_principles_spencer_1862", "target_name": "Kepler’s laws", "similarity": 0.987}], "id": 1287, "stable_key": "clu_f140219e8f3d1ced", "ground_truth": {"modern_name": "Kepler's laws", "confidence": "high", "type": "concept", "wikidata_id": "Q83219", "wikidata_description": "सूर्य के चारों ओर ग्रहों की गति का वर्णन करने वाले वैज्ञानिक नियम", "wikipedia_url": "https://en.wikipedia.org/wiki/Kepler%27s%20laws%20of%20planetary%20motion", "wikipedia_extract": "In astronomy, Kepler's laws of planetary motion give good approximations for the orbits of planets around the Sun. They were published by Johannes Kepler from 1608-1621 in three works Astronomia nova, Harmonice Mundi and Epitome Astronomiae Copernicanae. The laws were based on Kepler's concept of solar fibrils adapted to the accurate astronomical data of Tycho Brahe. These laws replaced the circular orbits and epicycles of Copernicus's heliostatic model of the planets with a heliocentric model that described elliptical orbits with planetary velocities that vary accordingly. The three laws state that: The orbit of a planet is an ellipse with the Sun at one of the two foci. A line segment joining a planet and the Sun sweeps out equal areas during equal intervals of time."}}, {"canonical_name": "ζ Herculis", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "ζ_herculis", "book_id": "connexion_physical_sciences_somerville_1858", "name": "ζ Herculis", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["ζ Herculis"], "contexts": ["double star with short period", "a star with orange-coloured light"]}, {"entity_id": "hercules", "book_id": "first_principles_spencer_1862", "name": "Hercules", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Hercules"], "contexts": ["constellation in the night sky"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "ζ Herculis", "target_book": "first_principles_spencer_1862", "target_name": "Hercules", "similarity": 0.929}], "id": 1288, "stable_key": "clu_b281c0d6261a545f", "ground_truth": {"modern_name": "Zeta Herculis", "confidence": "high", "type": "object", "note": "While listed as ANIMAL, the context 'double star' and 'constellation' clearly indicates an astronomical object, specifically a star system.", "wikidata_id": "Q13341", "wikidata_description": "multiple star system in the constellation Hercules", "wikipedia_url": "https://en.wikipedia.org/wiki/Zeta%20Herculis", "wikipedia_extract": "Zeta Herculis, Latinized from ζ Herculis, is a multiple star system in the constellation Hercules. It has a combined apparent visual magnitude of 2.81, which is readily visible to the naked eye. Parallax measurements put it at a distance of about 35.0 light-years (10.7 parsecs) from Earth. The primary member is a subgiant star that is somewhat larger than the Sun and has just begun to evolve away from the main sequence as the supply of hydrogen at its core becomes exhausted. It is orbited by a smaller companion star at a mean angular separation of 1.5 arcseconds, which corresponds to a physical separation of about 15 Astronomical Units. This distance is large enough so that the two stars do not have a significant tidal effect on each other."}}, {"canonical_name": "dancing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "dancing", "book_id": "first_principles_spencer_1862", "name": "dancing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Dancing", "dancing"], "contexts": ["art form originating from rhythm in motion", "art form"]}, {"entity_id": "dancing", "book_id": "connexion_physical_sciences_somerville_1858", "name": "dancing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dancing"], "contexts": ["rhythmic movement"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "dancing", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "dancing", "similarity": 1.0}], "id": 1289, "stable_key": "clu_6168adc466d86210", "ground_truth": {"modern_name": "dancing", "confidence": "high", "type": "concept", "wikipedia_extract": "Dance is an art form, consisting of sequences of body movements with aesthetic and often symbolic value, either improvised or purposefully selected. Dance can be categorized and described by its choreography, by its repertoire of movements or by its historical period or place of origin. Dance is typically performed with musical accompaniment, and sometimes with the dancer simultaneously using a musical instrument themselves. Two common types of group dance are theatrical and participatory dance. Both types of dance may have special functions, whether social, ceremonial, competitive, erotic, martial, sacred or liturgical. Dance is not solely restricted to performance, as dance is used as a form of exercise and occasionally training for other sports and activities."}}, {"canonical_name": "Leaõ", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "leaõ", "book_id": "polyanthea_medicinal", "name": "Leaõ", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 3, "variants": ["Leaõ", "leað", "leaó"], "contexts": ["a large feline animal", "lion"]}, {"entity_id": "leech", "book_id": "english_physician_1652", "name": "Leech", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["Leech"], "contexts": ["creature used for bloodletting"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Leaõ", "target_book": "english_physician_1652", "target_name": "Leech", "similarity": 0.855}], "id": 1290, "stable_key": "clu_ec40a3da1fca6421", "ground_truth": {"modern_name": "lion", "confidence": "medium", "type": "animal", "note": "The term 'Leaõ' is Portuguese for lion. However, the context 'creature used for bloodletting' strongly suggests a leech, which is a common medical practice. The dual meaning makes it ambiguous without further context.", "wikidata_id": "Q334", "wikidata_description": "sovereign island country and city-state in maritime Southeast Asia", "wikipedia_extract": "The lion (Panthera leo) is a large cat of the genus Panthera, currently ranging only in Sub-Saharan Africa and India. It has a muscular, broad-chested body; a short, rounded head; round ears; and a dark, hairy tuft at the tip of its tail. It is sexually dimorphic; adult male lions are larger than females and have a prominent mane that which extends from the head to the shoulders and chest. The lion inhabits grasslands, savannahs, and shrublands. It is an apex and keystone predator, preying mostly on medium-sized and large ungulates. It is usually more diurnal than other wild cats, but when persecuted, it adapts to being active at night and at twilight.", "wikipedia_url": "https://en.wikipedia.org/wiki/Lion"}}, {"canonical_name": "Ginger", "category": "PLANT", "subcategory": "ROOT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "ginger", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ginger", "category": "PLANT", "subcategory": "ROOT", "count": 2, "variants": ["Ginger"], "contexts": ["spice from a plant", "root of an herbaceous plant"]}, {"entity_id": "ginger", "book_id": "english_physician_1652", "name": "Ginger", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Ginger"], "contexts": ["spice used in a powder", "aromatic root"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ginger", "target_book": "english_physician_1652", "target_name": "Ginger", "similarity": 0.852}], "id": 1291, "stable_key": "clu_c56e9a36c14c14b7", "ground_truth": {"modern_name": "Ginger", "confidence": "high", "type": "plant", "linnaean": "Zingiber officinale Roscoe", "family": "Zingiberaceae", "wikidata_id": "Q35625", "wikidata_description": "plant species", "wikipedia_extract": "Modern ginger beer is a sweetened and carbonated, usually non-alcoholic beverage, a type of soft drink. Historically it was a type of beer brewed by the natural fermentation of prepared ginger spice, yeast and sugar. Modern ginger beers are often manufactured rather than brewed, frequently with flavour and colour additives, with artificial carbonation. The related ginger ales also are not brewed. Ginger beer is still produced at home using a type of symbiotic colony of yeast and Lactobacillus bacteria (SCOBY) known as a \"ginger beer plant\", or from a \"ginger bug\" starter created from fermenting ginger, sugar, and water. Brewed ginger beer originated in Yorkshire in England in the mid-18th century and became popular throughout Britain, the United States, Ireland, South Africa, the Caribbean and Canada, reaching a peak of popularity in the early 20th century.", "wikipedia_url": "https://en.wikipedia.org/wiki/Ginger_beer"}}, {"canonical_name": "Pellitory of Wall", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "pellitory_of_wall", "book_id": "english_physician_1652", "name": "Pellitory of Wall", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Pellitory of Wall", "Pellitory of the Wall"], "contexts": ["herb for various ailments", "herb for syrup"]}, {"entity_id": "pellitory_of_the_wall", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Pellitory of the Wall", "category": "PLANT", "subcategory": "HERB", "count": 1, "variants": ["Pellitory of the Wall"], "contexts": ["herb with medicinal properties"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Pellitory of Wall", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Pellitory of the Wall", "similarity": 0.846}], "id": 1292, "stable_key": "clu_298d086f1a88585c", "ground_truth": {"modern_name": "Parietaria judaica", "confidence": "high", "type": "plant", "linnaean": "Parietaria judaica L.", "family": "Urticaceae", "note": "Also known as Pellitory of the Wall.", "wikidata_id": "Q147991", "wikidata_description": "species of plant", "wikipedia_extract": "Parietaria judaica, spreading pellitory, is a species of herbaceous perennial flowering plant in the family Urticaceae. It is native to the eastern Mediterranean and Middle East, and is widely established worldwide as an urban weed. Its pollen is a significant cause of asthma and other allergies in warmer countries, but it is also valued as a contributor to biodiversity in polluted cities and it has been used as a medicinal herb. Spreading pellitory is a perennial herb about 50 cm (up to 110 cm) tall with an upright to sprawling untidy habit. Plants can have many branched stems, which are pink or red and slightly woody and brittle at the base. The leaves are alternate, oval lanceolate, typically 3 cm long x 1.5 cm wide (exceptionally up to 6 cm x 3 cm) with a petiole about half as long as the blade.", "wikipedia_url": "https://en.wikipedia.org/wiki/Parietaria_judaica"}}, {"canonical_name": "Rush", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "rush", "book_id": "english_physician_1652", "name": "Rush", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Rush", "Rushes"], "contexts": ["plant used for size comparison", "plant used in proverb"]}, {"entity_id": "rushes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Rushes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Rushes"], "contexts": ["plant used for charcoal in gunpowder"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Rush", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Rushes", "similarity": 0.837}], "id": 1293, "stable_key": "clu_cf7e86a664f0d6cf", "ground_truth": {"modern_name": "Rush", "confidence": "high", "type": "plant", "linnaean": "Juncus", "family": "Juncaceae", "note": "Refers to plants of the genus Juncus, commonly known as rushes. The contexts provided align with their use as materials and components.", "wikipedia_extract": "Juncus is a genus of monocotyledonous flowering plants, commonly known as rushes. It is the largest genus in the family Juncaceae, containing around 340 species. Rushes of the genus Juncus are herbaceous plants that superficially resemble grasses or sedges. They have historically received little attention from botanists; in his 1819 monograph, James Ebenezer Bicheno described the genus as \"obscure and uninviting\". The form of the flower differentiates rushes from grasses or sedges. The flowers of Juncus comprise five whorls of floral parts: three sepals, three petals (or, taken together, six tepals), two to six stamens (in two whorls) and a stigma with three lobes."}}, {"canonical_name": "Elm-Tree", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "elm-tree", "book_id": "english_physician_1652", "name": "Elm-Tree", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Elm-Tree"], "contexts": ["type of tree", "tree with medicinal properties"]}, {"entity_id": "elm", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Elm", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Elm"], "contexts": ["type of tree"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Elm-Tree", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Elm", "similarity": 0.922}], "id": 1294, "stable_key": "clu_0337543d4595d0ef", "ground_truth": {"modern_name": "Elm tree", "confidence": "high", "type": "plant", "linnaean": "Ulmus", "family": "Ulmaceae", "wikidata_id": "Q59779164", "wikidata_description": "deciduous tree", "wikipedia_extract": "Ulmus rubra, the slippery elm, is a species of elm native to eastern North America. Other common names include red elm, gray elm, soft elm, moose elm, and Indian elm. It is closely related to the European wych elm (U. glabra), which has a very similar flower structure but lacks the pubescence over the seed. Ulmus rubra is a medium-sized deciduous tree with a spreading head of branches, commonly growing to 12–19 metres (39–62 feet), very occasionally over 30 m (98 ft) in height. Its heartwood is reddish-brown.", "wikipedia_url": "https://en.wikipedia.org/wiki/Ulmus_rubra"}}, {"canonical_name": "Loathings", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "loathings", "book_id": "english_physician_1652", "name": "Loathings", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 3, "variants": ["Loathings", "Longings"], "contexts": ["symptom stayed by Black Bilberries", "medicines against lassitude"]}, {"entity_id": "lassitudes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "lassitudes", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["lassitudes"], "contexts": ["feelings of weariness or exhaustion"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Loathings", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "lassitudes", "similarity": 0.889}], "id": 1295, "stable_key": "clu_3114626b65e022ea", "ground_truth": {"modern_name": "Lassitude", "confidence": "high", "type": "concept", "wikidata_id": "Q15729017", "wikidata_description": "tiredness in humans not caused by illness", "wikipedia_extract": "Humorism, the humoral theory, or humoralism, was a system of medicine detailing a supposed makeup and workings of the human body, adopted by Ancient Greek and Roman physicians and philosophers. Humorism began to fall out of favor in the 17th century and it was definitively disproved with the discovery of microbes. The concept of \"humors\" may have origins in Ancient Egyptian medicine, or Mesopotamia, though it was not systemized until ancient Greek thinkers. The word humor is a translation of Greek χυμός, chymos (literally 'juice' or 'sap', metaphorically 'flavor'). Early texts on Indian Ayurveda medicine presented a theory of three or four humors (doṣas), which they sometimes linked with the five elements (pañca-bhūta): earth, water, fire, air, and space. The concept of \"humors\" (chemical systems regulating human behaviour) became more prominent from the writing of medical theorist Alcmaeon of Croton (c.", "wikipedia_url": "https://de.wikipedia.org/wiki/M%C3%BCdigkeit"}}, {"canonical_name": "King-fisher", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "king-fisher", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "King-fisher", "category": "ANIMAL", "subcategory": "BIRD", "count": 3, "variants": ["King-fisher"], "contexts": ["bird discussed in chapter X", "bird believed to indicate wind direction"]}, {"entity_id": "kingfisher", "book_id": "origin_of_species_darwin_1859", "name": "kingfisher", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["kingfisher"], "contexts": ["bird that catches fish"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "King-fisher", "target_book": "origin_of_species_darwin_1859", "target_name": "kingfisher", "similarity": 0.952}], "id": 1296, "stable_key": "clu_ced964147cf16c6c", "ground_truth": {"modern_name": "Kingfisher", "confidence": "high", "type": "animal", "wikidata_id": "Q1013136", "wikidata_description": "city in and the county seat of Kingfisher County, Oklahoma, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Kingfisher", "wikipedia_extract": "Kingfishers are a family, the Alcedinidae, of small to medium-sized, brightly coloured birds in the order Coraciiformes. They have a cosmopolitan distribution: most species live in the tropical regions of Africa, Asia, and Oceania, but they can also be found in Europe and the Americas. They can be found in deep forests near calm ponds and small rivers. The family contains 118 species and is divided into three subfamilies and 19 genera. All kingfishers have large heads, long, sharp, pointed bills, short legs, and stubby tails. Most species have bright plumage with only small differences between the sexes."}}, {"canonical_name": "Toad", "category": "ANIMAL", "subcategory": "AMPHIBIAN", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "toad", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Toad", "category": "ANIMAL", "subcategory": "AMPHIBIAN", "count": 2, "variants": ["Toad"], "contexts": ["amphibian used in mythical generation", "animal whose hatching is questioned"]}, {"entity_id": "toads", "book_id": "origin_of_species_darwin_1859", "name": "Toads", "category": "ANIMAL", "subcategory": "REPTILE", "count": 2, "variants": ["Toads", "toads"], "contexts": ["amphibian species", "on islands"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Toad", "target_book": "origin_of_species_darwin_1859", "target_name": "Toads", "similarity": 0.888}], "id": 1297, "stable_key": "clu_77512ebcbf1a3660", "ground_truth": {"modern_name": "Toad", "confidence": "high", "type": "animal", "wikipedia_extract": "The following is a list of poisonous animals, which are animals that passively deliver toxins (called poison) to their victims upon contact such as through inhalation, absorption through the skin, or after being ingested. They are often distinguished from venomous animals, which actively inject their toxins (called venom) into their victims through a venom apparatus such as fangs or a stinger. The only difference between poisonous animals and venomous animals is how they deliver the toxins. This list deals exclusively with poisonous animals. This list is a partial list of animals that are poisonous to humans and other animals in that their flesh is toxic if consumed, or in some cases if they are touched: Some of these toads are \"milked\" for their bufotoxins.", "wikipedia_url": "https://en.wikipedia.org/wiki/List_of_poisonous_animals"}}, {"canonical_name": "Powder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "powder", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Powder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Powder"], "contexts": ["component of gunpowder", "explosive mixture"]}, {"entity_id": "poudre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "poudre", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["poudre"], "contexts": ["signals for surveying"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Powder", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "poudre", "similarity": 0.89}], "id": 1298, "stable_key": "clu_4869f9fa582beaf5", "ground_truth": {"modern_name": "Powder", "confidence": "high", "type": "chemical", "note": "This could refer to various powdered substances, but 'gunpowder' is a strong contextual clue. 'Poudre' also strongly suggests a powdered form of a substance.", "wikidata_id": "Q37203534", "wikidata_description": "family name", "wikipedia_extract": "A powder is a dry solid composed of many very fine particles that may flow freely when shaken or tilted. Powders are a special sub-class of granular materials, although the terms powder and granular are sometimes used to distinguish separate classes of material. In particular, powders refer to those granular materials that have the finer grain sizes, and that therefore have a greater tendency to form clumps when flowing. Granulars refer to the coarser granular materials that do not tend to form clumps except when wet. Many manufactured goods come in powder form, such as flour, sugar, ground coffee, powdered milk, copy machine toner, gunpowder, cosmetic powders, and some pharmaceuticals. In nature, dust, fine sand and snow, volcanic ash, and the top layer of the lunar regolith are also examples.", "wikipedia_url": "https://en.wikipedia.org/wiki/Powder"}}, {"canonical_name": "Capo de las Agullas", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "capo_de_las_agullas", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Capo de las Agullas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Capo de las Agullas"], "contexts": ["location on African coast", "location where compass variation rests"]}, {"entity_id": "cap_de_la_vêla", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cap de la Vêla", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Cap de la Vêla"], "contexts": ["cape in South America", "cape"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Capo de las Agullas", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Cap de la Vêla", "similarity": 0.842}], "id": 1299, "stable_key": "clu_edff16e7f96a5812", "ground_truth": {"modern_name": "Cape Agulhas", "confidence": "high", "type": "place", "country": "South Africa", "note": "The 'Capo de las Agullas' is clearly Cape Agulhas. 'Cap de la Vêla' is a different cape, but the cluster grouping suggests a likely misidentification or variation in naming by the authors.", "wikidata_id": "Q4085", "wikidata_description": "headland in the Western Cape, South Africa, the southernmost point of mainland Africa", "wikipedia_extract": "L'Agulhas is the southernmost coastal village and holiday resort in South Africa, located within the Cape Agulhas Local Municipality at the southernmost tip of the African mainland. It is situated next to the town of Struisbaai and about 30 kilometres (20 mi) south of the regional centre of Bredasdorp. Some of the older residents and documents refer to the town as by its former name Cape Agulhas or Cape L'Agulhas or simply Agulhas which were the names that referred to this town before it was changed to L'Agulhas to avoid confusion when the Bredasdorp Municipality changed its name to The Cape Agulhas Municipality (CAM). Agulhas is the plural form of “agulha” in Portuguese. It is derived from the Late Latin word, “acūcula,” and the Latin word “acula,” both meaning a needle or pin. They trace back to the theorized Proto-Indo-European word “h₂eḱ.” According to local legend, when sailing to the cape, sailors saw the compass needle point North, directly to the modern day location of L’Agulhas.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cape_Agulhas"}}, {"canonical_name": "syrop", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "syrop", "book_id": "relation_historique_humboldt_vol3_1825", "name": "syrop", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["syrop", "sirop"], "contexts": ["product exported from Martinique", "syrup"]}, {"entity_id": "syrups", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Syrups", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Syrups"], "contexts": ["viscous substance exhibiting attraction"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "syrop", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Syrups", "similarity": 0.845}], "id": 1300, "stable_key": "clu_caa1eae93d947643", "ground_truth": {"modern_name": "Syrup", "confidence": "high", "type": "chemical", "wikidata_id": "Q130307066", "wikidata_description": "family name", "wikipedia_extract": "Aisha Wahab (born January 11, 1987) is an American politician who has served as the California state senator from the 10th district since 2022. A member of the Democratic Party, Wahab is the first Muslim and Afghan American elected to the California State Senate. She previously served on the Hayward City Council from 2018 to 2022. Born to Afghan refugees in New York City, Wahab was raised in Fremont and has a doctorate in social work from the University of Southern California. She worked in non-profit organizations and consulting before entering politics. Upon being elected to the Hayward City Council in 2018, she became one of the first Afghan Americans elected to public office in the United States.", "wikipedia_url": "https://en.wikipedia.org/wiki/Aisha_Wahab"}}, {"canonical_name": "Stoic", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "stoic", "book_id": "principles_of_psychology_james_1890", "name": "Stoic", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "count": 2, "variants": ["Stoic"], "contexts": ["philosophy emphasizing self-control and virtue", "philosophical school emphasizing virtue and reason"]}, {"entity_id": "stoicks", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Stoicks", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "count": 1, "variants": ["Stoicks"], "contexts": ["ancient philosophical school"]}, {"entity_id": "stoics", "book_id": "principles_of_psychology_james_1890", "name": "Stoics", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "count": 1, "variants": ["Stoics"], "contexts": ["ancient philosophical school"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Stoic", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Stoicks", "similarity": 0.915}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Stoicks", "target_book": "principles_of_psychology_james_1890", "target_name": "Stoics", "similarity": 0.924}], "id": 1301, "stable_key": "clu_3be74de1d58a2398", "ground_truth": {"modern_name": "Stoicism", "confidence": "high", "type": "concept", "wikidata_id": "Q48235", "wikidata_description": "school of Hellenistic philosophy who held that the practice of virtue suffices to attain eudaimonia", "wikipedia_extract": "Stoicism is an ancient Greek and then Roman philosophy of the Hellenistic and Roman Imperial periods. The Stoics believed that the universe operated according to reason, or logos, providing a unified account of the world, constructed from ideals of rational discourse, monistic physics, and naturalistic ethics. These three ideals constitute virtue, which is necessary for the Stoic goal of 'living a well-reasoned life'. Stoic logic focuses on highly intentional reasoning through propositions, arguments, and the differentiation between truth and falsehood. Philosophical discourse is paramount in Stoicism, including the view that the mind is in rational dialogue with itself. Stoic ethics centers on virtue as the highest good, cultivating emotional self-control, a calm problem-solving state of mind, and rational judgment to attain lifelong flourishing (eudaimonia).", "wikipedia_url": "https://en.wikipedia.org/wiki/Stoicism"}}, {"canonical_name": "mucous membranes", "category": "ANATOMY", "subcategory": "TISSUE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "mucous_membranes", "book_id": "principles_of_psychology_james_1890", "name": "mucous membranes", "category": "ANATOMY", "subcategory": "TISSUE", "count": 3, "variants": ["mucous membranes"], "contexts": ["linings of body cavities and organs", "linings of body cavities"]}, {"entity_id": "membranous_substance", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "membranous substance", "category": "ANATOMY", "subcategory": "TISSUE", "count": 1, "variants": ["membranous substance"], "contexts": ["thin, skin-like material"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "mucous membranes", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "membranous substance", "similarity": 0.847}], "id": 1302, "stable_key": "clu_c9c9a2d66717eb79", "ground_truth": {"modern_name": "Mucous membrane", "confidence": "high", "type": "concept", "wikidata_id": "Q22081633", "wikidata_description": "delivery of a drug or other substance into the body through the epithelium lining of a mucous membrane", "wikipedia_extract": "A mucous membrane or mucosa is a membrane that lines various cavities in the body of an organism and covers the surface of internal organs. It consists of one or more layers of epithelial cells overlying a layer of loose connective tissue known as the lamina propria. It is mostly of endodermal origin and is continuous with the skin at body openings such as the eyes, eyelids, ears, inside the nose, inside the mouth, lips, the genital areas, the urethral opening and the anus. Some mucous membranes secrete mucus, a thick protective fluid. The function of the membrane is to stop pathogens and dirt from entering the body and to prevent bodily tissues from becoming dehydrated. Amphibians, fish, snails, slugs, and some other invertebrates also produce external mucus from their epidermis as protection against pathogens, to help in movement, and to line fish gills."}}, {"canonical_name": "Polybius", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "polybius", "book_id": "kosmos_humboldt_1845", "name": "Polybius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Polybius"], "contexts": ["ancient historian", "ancient writer comparing peninsulas"]}, {"entity_id": "polybius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Polybius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Polybius"], "contexts": ["Greek historian"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Polybius", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Polybius", "similarity": 1.0}], "id": 1303, "stable_key": "clu_157ad3f6a9447d84", "ground_truth": {"modern_name": "Polybius", "confidence": "high", "type": "person", "description": "Ancient Greek historian and writer on Roman history.", "wikidata_id": "Q1990508", "wikidata_description": "genus of crabs", "wikipedia_url": "https://en.wikipedia.org/wiki/Polybius%20%28crab%29", "wikipedia_extract": "Polybius (; Ancient Greek: Πολύβιος, Polýbios; c. 200 – c. 118 BC) was an ancient Greek historian of the middle Hellenistic period. He is noted for his Histories, a universal history documenting the rise of Rome in the Mediterranean in the third and second centuries BC. It covers the period 264–146, recording in detail events in Italy, Iberia, Greece, Macedonia, Syria, Egypt and Africa, and documents the Punic Wars and Macedonian Wars among many others. Polybius's Histories is important not only for being the only Hellenistic historical work to survive in any substantial form, but also for its analysis of constitutional change and the mixed constitution. Polybius's discussion of the separation of powers in government, of checks and balances to limit power, and his introduction of \"the people\", all influenced Montesquieu's The Spirit of the Laws, John Locke's Two Treatises of Government, and the framers of the United States Constitution. Polybius was a close friend and mentor to the Roman politician and general Scipio Aemilianus (also called Scipio Africanus the Younger), and had a lasting influence on his decision-making and life."}}, {"canonical_name": "hyenas", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "hyenas", "book_id": "kosmos_humboldt_1845", "name": "hyenas", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["hyenas"], "contexts": ["carnivorous mammals", "fossil bones found in soils and caves"]}, {"entity_id": "hyæna", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hyæna", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Hyæna"], "contexts": ["animal with annual mutation of sexes"]}, {"entity_id": "hiæna", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hiæna", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Hiæna"], "contexts": ["animal whose shadow causes dogs to be mute"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "hyenas", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Hyæna", "similarity": 0.946}, {"source_book": "kosmos_humboldt_1845", "source_name": "hyenas", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Hiæna", "similarity": 0.847}], "id": 1304, "stable_key": "clu_f55c3541a26acb9a", "ground_truth": {"modern_name": "Hyena", "confidence": "high", "type": "animal", "wikidata_id": "Q42046", "wikidata_description": "family of mammals in the order Carnivora", "wikipedia_url": "https://en.wikipedia.org/wiki/Hyena", "wikipedia_extract": "Hyenas or hyaenas ( hi-EE-nəz; from Ancient Greek ὕαινα, hýaina) are feliform carnivoran mammals belonging to the family Hyaenidae (). With just four extant species (each in its own genus), it is the fifth-smallest family in the order Carnivora and one of the smallest in the class Mammalia. Despite their low diversity, hyenas are unique and vital components of most African ecosystems. Although phylogenetically closer to felines and viverrids, hyenas are behaviourally and morphologically similar to canids in several elements due to convergent evolution: both hyenas and canines are non-arboreal, cursorial hunters that catch prey with their teeth rather than claws. Both eat food quickly and may store it, and their calloused feet with large, blunt, nonretractable claws are adapted for running and making sharp turns. However, hyenas' grooming, scent marking, defecation habits, mating, and parental behavior are consistent with the behavior of other feliforms."}}, {"canonical_name": "Mandragora", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "mandragora", "book_id": "ricettario_fiorentino_1597", "name": "Mandragora", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Mandragora"], "contexts": ["ingredient in an ointment", "plant mentioned in a list"]}, {"entity_id": "mandrakes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mandrakes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Mandrakes"], "contexts": ["roots make noise upon eradication"]}, {"entity_id": "mandra", "book_id": "ricettario_fiorentino_1597", "name": "MANDRA", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["MANDRA"], "contexts": ["mandragora"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Mandragora", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Mandrakes", "similarity": 0.86}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mandrakes", "target_book": "ricettario_fiorentino_1597", "target_name": "MANDRA", "similarity": 0.83}], "id": 1305, "stable_key": "clu_7eacc7951d82654b", "ground_truth": {"modern_name": "Mandrake", "confidence": "high", "type": "plant", "linnaean": "Mandragora officinarum L.", "family": "Solanaceae", "note": "The cluster also includes 'Mandragora' which is the genus name. The reference to roots making noise upon eradication is a well-known folklore associated with mandrake.", "wikidata_id": "Q2651366", "wikidata_description": "plant root", "wikipedia_extract": "A mandrake is one of several toxic plant species with \"man-shaped\" roots and some uses in folk remedies. The roots by themselves may also be referred to as \"mandrakes\". The term primarily refers to nightshades of the genus Mandragora (in the family Solanaceae) found in the Mediterranean region. Other unrelated plants also sometimes referred to as \"mandrake\" include Bryonia alba (the English mandrake, in the family Cucurbitaceae) and Podophyllum peltatum (the American mandrake, in the family Berberidaceae). These plants have root structures similar to members of Mandragora, and are likewise toxic. This article will focus on mandrakes of the genus Mandragora and the European folklore surrounding them."}}, {"canonical_name": "Hare", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "hare", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Hare", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["Hare"], "contexts": ["constellation tail extended towards", "comet observed near"]}, {"entity_id": "harpies", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Harpies", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Harpies"], "contexts": ["mythological creatures mentioned by poets"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Hare", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Harpies", "similarity": 0.866}], "id": 1306, "stable_key": "clu_d7e1e9a7359447c0", "ground_truth": {"modern_name": "Hare", "confidence": "medium", "type": "animal", "note": "The cluster members include 'Hare' and 'Harpies'. Given the context of natural philosophy and constellations, 'Hare' is the more likely intended referent, with 'Harpies' being a misreading or a deliberate inclusion of a mythological creature for comparison. However, the mention of 'mythological creatures' suggests a potential ambiguity. Focusing on the 'Hare' as a biological entity.", "wikidata_id": "Q46076", "wikidata_description": "genus of mammals in the family Leporidae", "wikipedia_extract": "Hares and jackrabbits are mammals belonging to the genus Lepus. They are herbivores and live solitarily or in pairs. They nest in depressions in the ground called forms, and their young are able to fend for themselves shortly after birth. The genus includes the largest lagomorphs. Most are fast runners with long, powerful hind legs, and large ears that dissipate body heat. Hare species are native to Africa, Eurasia and  North America.", "wikipedia_url": "https://en.wikipedia.org/wiki/Hare"}}, {"canonical_name": "Hoar-frost", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "hoar-frost", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Hoar-frost", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["hoar-frost", "Hoar-frost"], "contexts": ["ice crystals formed by deposition", "natural phenomenon of frozen dew"]}, {"entity_id": "hoary_frosts", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "hoary Frosts", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["hoary Frosts"], "contexts": ["ice crystals on surfaces"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Hoar-frost", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "hoary Frosts", "similarity": 0.889}], "id": 1307, "stable_key": "clu_5a21c388ef0730d8", "ground_truth": {"modern_name": "Hoar frost", "confidence": "high", "type": "mineral", "wikidata_id": "Q18749407", "wikidata_description": "painting by Théodore Rousseau", "wikipedia_extract": "Frost is a layer of ice on a solid surface, which forms from water vapor that deposits onto a freezing surface. Frost forms when the air contains more water vapor than it can normally hold at a specific temperature. The process is similar to the formation of dew, except it occurs below the freezing point of water typically without crossing through a liquid state. Air always contains a certain amount of water vapor, depending on temperature. Warmer air can hold more than colder air. When the atmosphere contains more water than it can hold at a specific temperature, its relative humidity rises above 100% becoming supersaturated, and the excess water vapor is forced to deposit onto any nearby surface, forming seed crystals."}}, {"canonical_name": "Charms", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "charms", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Charms", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["Charms"], "contexts": ["danger and delusion in cures", "superstitious cures"]}, {"entity_id": "charms", "book_id": "first_principles_spencer_1862", "name": "charms", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["charms"], "contexts": ["objects believed to have magical power"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Charms", "target_book": "first_principles_spencer_1862", "target_name": "charms", "similarity": 0.959}], "id": 1308, "stable_key": "clu_ea577a02f42abbd2", "ground_truth": {"modern_name": "Charm", "confidence": "high", "type": "object", "note": "Refers to amulets or objects believed to possess magical properties, often used for protection or healing.", "wikipedia_extract": "Charm++ is a parallel object-oriented programming paradigm based on C++ and developed in the Parallel Programming Laboratory at the University of Illinois at Urbana–Champaign. Charm++ is designed with the goal of enhancing programmer productivity by providing a high-level abstraction of a parallel program while at the same time delivering good performance on a wide variety of underlying hardware platforms. Programs written in Charm++ are decomposed into a number of cooperating message-driven objects called chares. When a programmer invokes a method on an object, the Charm++ runtime system sends a message to the invoked object, which may reside on the local processor or on a remote processor in a parallel computation. This message triggers the execution of code within the chare to handle the message asynchronously. Chares may be organized into indexed collections called chare arrays and messages may be sent to individual chares within a chare array or to the entire chare array simultaneously.", "wikipedia_url": "https://en.wikipedia.org/wiki/Charm++"}}, {"canonical_name": "Turnip", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "turnip", "book_id": "english_physician_1652", "name": "Turnip", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Turnip", "Turnep"], "contexts": ["root vegetable", "Turnep Leavs"]}, {"entity_id": "turnip", "book_id": "origin_of_species_darwin_1859", "name": "Turnip", "category": "PLANT", "subcategory": "HERB", "count": 2, "variants": ["turnip", "Turnip"], "contexts": ["domestic variety with thickened stems", "analogous variations"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Turnip", "target_book": "origin_of_species_darwin_1859", "target_name": "Turnip", "similarity": 0.844}], "id": 1309, "stable_key": "clu_4e5c1fe5bfcd6ff1", "ground_truth": {"wikipedia_extract": "The turnip or white turnip (Brassica rapa subsp. rapa) is a root vegetable commonly grown in temperate climates worldwide for its white, fleshy taproot. Small, tender varieties are grown for human consumption, while larger varieties are grown as feed for livestock. The name turnip – used in many regions – may also be used to refer to rutabaga (or neep or swede), which is a different but related vegetable. The origin of the word turnip is uncertain, though it is hypothesised that it could be a compound of turn as in turned/rounded on a lathe and neep, derived from Latin napus, the word for the plant. According to An Universal Etymological English Dictionary (1721), turn refers to \"round napus to distinguish it from the napi, which were generally long\". The most common type of turnip is mostly white-skinned except for the upper 1 to 6 centimetres (1⁄2 to 2+1⁄2 inches)."}}, {"canonical_name": "Surry", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "surry", "book_id": "english_physician_1652", "name": "Surry", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Surry"], "contexts": ["county where Peckham is located", "county in England"]}, {"entity_id": "surrey", "book_id": "origin_of_species_darwin_1859", "name": "Surrey", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Surrey"], "contexts": ["county with heaths and firs", "location of ant nest observations"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Surry", "target_book": "origin_of_species_darwin_1859", "target_name": "Surrey", "similarity": 0.872}], "id": 1310, "stable_key": "clu_d75f0a2f696fd0f3", "ground_truth": {"modern_name": "Surrey", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q67443130", "wikidata_description": "historic county of England, United Kingdom"}}, {"canonical_name": "heartsease", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "heartsease", "book_id": "origin_of_species_darwin_1859", "name": "heartsease", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["heartsease"], "contexts": ["plant with distinct flowers and leaves", "plant variety showing improvement"]}, {"entity_id": "heartsease", "book_id": "english_physician_1652", "name": "Heartsease", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Heartsease"], "contexts": ["herb with properties like violets"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "heartsease", "target_book": "english_physician_1652", "target_name": "Heartsease", "similarity": 0.883}], "id": 1311, "stable_key": "clu_5dd101c1ffab6fc7", "ground_truth": {"wikipedia_extract": "Viola tricolor is a common European wild flower, growing as an annual or short-lived perennial. The species is also known as wild pansy, Johnny Jump up (though this name is also applied to similar species such as the yellow pansy), heartsease, heart's ease, heart's delight, tickle-my-fancy, Jack-jump-up-and-kiss-me, come-and-cuddle-me, three faces in a hood, love-in-idleness, and pink of my john. It has been introduced into North America, where it has spread. It is the progenitor of the cultivated pansy, and is therefore sometimes called wild pansy; before the cultivated pansies were developed, \"pansy\" was an alternative name for the wild form. It can produce up to 50 seeds at a time. The flowers can be purple, blue, yellow or white."}}, {"canonical_name": "chaînons", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "chaînons", "book_id": "relation_historique_humboldt_vol3_1825", "name": "chaînons", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["chaînons", "chaînon latéral", "chaînons parallèles"], "contexts": ["mountain chains", "secondary mountain range"]}, {"entity_id": "chãses", "book_id": "english_physician_1652", "name": "Chãses", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Chãses"], "contexts": ["locations for feeding deer"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "chaînons", "target_book": "english_physician_1652", "target_name": "Chãses", "similarity": 0.856}], "id": 1312, "stable_key": "clu_9b28a77433fa9b73", "ground_truth": {"modern_name": "Mountain ranges", "confidence": "high", "type": "place", "note": "The term 'chaînons' refers to chains or ranges, and in the context of Humboldt's work, it most likely refers to mountain chains. 'Chãses' is less clear but could be a variant or a typo, also possibly related to geographical features in context.", "wikidata_id": "Q46831", "wikidata_description": "geographic area containing several geologically related mountains", "wikipedia_url": "https://en.wikipedia.org/wiki/Mountain%20range"}}, {"canonical_name": "Saxifrage", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "saxifrage", "book_id": "english_physician_1652", "name": "Saxifrage", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Saxifrage", "Saxifrages"], "contexts": ["root used in Tragus's medicine", "herb with roots, leaves, flowers, and seed"]}, {"entity_id": "saxifrages", "book_id": "kosmos_humboldt_1845", "name": "saxifrages", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["saxifrages"], "contexts": ["plant in a specific botanical region"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Saxifrage", "target_book": "kosmos_humboldt_1845", "target_name": "saxifrages", "similarity": 0.828}], "id": 1313, "stable_key": "clu_dbd6420b90928888", "ground_truth": {"modern_name": "Saxifrage", "confidence": "high", "type": "plant", "linnaean": "Saxifraga", "family": "Saxifragaceae", "wikidata_id": "Q156146", "wikidata_description": "genus of plants in the saxifrage family (Saxifragaceae)", "wikipedia_url": "https://en.wikipedia.org/wiki/Saxifraga", "wikipedia_extract": "Saxifraga is the largest genus in the family Saxifragaceae, containing about 473 species of holarctic perennial plants, known as saxifrages or rockfoils. The Latin word saxifraga means literally \"stone-breaker\", from Latin saxum (\"rock\" or \"stone\") + frangere (\"to break\"). It is usually thought to indicate a medicinal use for treatment of urinary calculi (known as kidney or bladder stones), rather than breaking rocks apart. Most saxifrages are small perennial, biennial (e.g., S. adscendens) or annual (e.g., S. tridactylites) herbaceous plants whose basal or cauline leaves grow close to the ground, often in a rosette."}}, {"canonical_name": "Bristol", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "bristol", "book_id": "english_physician_1652", "name": "Bristol", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Bristol"], "contexts": ["port city where plant is found", "place where the plant grows"]}, {"entity_id": "bristol", "book_id": "kosmos_humboldt_1845", "name": "Bristol", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Bristol"], "contexts": ["location of fossil discoveries"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Bristol", "target_book": "kosmos_humboldt_1845", "target_name": "Bristol", "similarity": 1.0}], "id": 1314, "stable_key": "clu_c79cd679709b1400", "ground_truth": {"modern_name": "Bristol", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q23154", "wikidata_description": "city in South West England, United Kingdom", "wikipedia_url": "https://en.wikipedia.org/wiki/Bristol", "wikipedia_extract": "Bristol ( ) is a city and ceremonial county in South West England. It is located on the River Avon, and bordered by Gloucestershire to the north and Somerset to the south with a short coastline on the Bristol Channel to the west. The county includes the majority of the Bristol conurbation, however, the urban area of the city extends into the neighbouring districts of South Gloucestershire, Bath and North East Somerset, and North Somerset. The county is almost entirely urbanised and had an estimated population of 494,399 in 2024, making Bristol the most populous city in the region. For local government purposes the county is a unitary authority area governed by Bristol City Council. The council is a member of the West of England Combined Authority, which allows it to collaborate with South Gloucestershire Council and Bath and North East Somerset Council."}}, {"canonical_name": "Columbines", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "columbines", "book_id": "english_physician_1652", "name": "Columbines", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Columbines"], "contexts": ["flower, comparison for Celandine leaves", "well-known garden plant"]}, {"entity_id": "colombina", "book_id": "coloquios_da_orta_1563", "name": "colombina", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["colombina"], "contexts": ["designation of ginger origin"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Columbines", "target_book": "coloquios_da_orta_1563", "target_name": "colombina", "similarity": 0.869}], "id": 1315, "stable_key": "clu_f5006af4f87499ba", "ground_truth": {"wikipedia_extract": "Aquilegia, commonly known as columbines, is a genus of perennial flowering plants in the family Ranunculaceae (buttercups). The genus includes between 80 and 400 taxa (described species and subspecies) with natural ranges across the Northern Hemisphere. Natural and introduced populations of Aquilegia exist on all continents but Antarctica. Known for their high physical variability and ease of hybridization, columbines are popular garden plants and have been used to create many cultivated varieties. Aquilegia typically possess stiff stems and leaves that divide into multiple leaflets. Columbines often have colorful flowers with five sepals and five petals."}}, {"canonical_name": "Poppy Seed", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "poppy_seed", "book_id": "english_physician_1652", "name": "Poppy Seed", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Poppy Seed"], "contexts": ["seed used for comparison", "added to Melilot preparations"]}, {"entity_id": "poppi", "book_id": "ricettario_fiorentino_1597", "name": "Poppi", "category": "PLANT", "subcategory": "SEED", "count": 1, "variants": ["Poppi"], "contexts": ["ingredient in a recipe"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Poppy Seed", "target_book": "ricettario_fiorentino_1597", "target_name": "Poppi", "similarity": 0.859}], "id": 1316, "stable_key": "clu_a7456c60739c8ccd", "ground_truth": {"wikipedia_extract": "Poppy seed is an oilseed obtained from the poppy plant (Papaver somniferum). The tiny, kidney-shaped seeds have been harvested from dried seed pods by various civilizations for thousands of years. It is still widely used in many countries, especially in Central Europe and South Asia, where it is legally grown, used in food products and sold in shops. The seeds are used whole or ground into meal as an ingredient in many foods – especially in pastry and bread – and they are pressed to yield poppyseed oil. The poppy seed is mentioned in ancient medical texts from many civilizations. For instance, the Egyptian Ebers Papyrus, written c. 1550 BCE, lists the poppy seed as a sedative."}}, {"canonical_name": "OLIO IRINO DI", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "olio_irino_di", "book_id": "ricettario_fiorentino_1597", "name": "OLIO IRINO DI", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["OLIO IRINO DI", "OLIO IRINO"], "contexts": ["iris oil preparation", "type of oil"]}, {"entity_id": "oleum_irinum", "book_id": "english_physician_1652", "name": "Oleum Irinum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Oleum Irinum"], "contexts": ["oil made from Flower-de-luce"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "OLIO IRINO DI", "target_book": "english_physician_1652", "target_name": "Oleum Irinum", "similarity": 0.883}], "id": 1317, "stable_key": "clu_ddce21aed789a6c1", "ground_truth": {"modern_name": "Iris oil", "confidence": "high", "type": "chemical", "note": "This refers to oil derived from the Iris plant, specifically the rhizome or flower, often used in perfumery and historically in medicine.", "wikidata_id": "Q7104098", "wikidata_description": "oil obtained from the root of iris × germanica", "wikipedia_url": "https://en.wikipedia.org/wiki/Orris%20oil"}}, {"canonical_name": "Salvs", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "salvs", "book_id": "english_physician_1652", "name": "Salvs", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["Salvs", "Salve", "Salves"], "contexts": ["used for wounds, containing daisies", "preparation containing Marjerom"]}, {"entity_id": "salvinas", "book_id": "polyanthea_medicinal", "name": "salvinas", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["salvinas"], "contexts": ["medicinal preparations"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Salvs", "target_book": "polyanthea_medicinal", "target_name": "salvinas", "similarity": 0.844}], "id": 1318, "stable_key": "clu_50ccc9cc094f1a68", "ground_truth": {"modern_name": "Daisy preparation", "confidence": "medium", "type": "concept", "note": "'Salvs' could be a Latinized or abbreviated term. In the context of medicinal preparations containing daisies, it likely refers to a preparation made from or featuring daisies (Bellis perennis).", "wikipedia_extract": "Lillian Daisy Phillips (born 23 July 2001) is an English pornographic film actress. In late 2024, she uploaded a video to OnlyFans in which she had sex with 101 men, which attracted widespread attention after YouTuber Josh Pieters chronicled the events in a documentary titled I Slept with 100 Men in One Day. Although the documentary itself was praised, Phillips and OnlyFans were heavily criticised for the stunt. Phillips defended both her occupation and the event. She later announced plans to have sex with 300 and then 1,000 men in one day. Phillips has filmed content with fellow OnlyFans creator Bonnie Blue.", "wikipedia_url": "https://en.wikipedia.org/wiki/Lily_Phillips"}}, {"canonical_name": "Diarhodon Abhatis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "diarhodon_abhatis", "book_id": "english_physician_1652", "name": "Diarhodon Abhatis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["Diarhodon Abhatis", "Diarhodon Abbatis", "Diarhodon Abba∣tis"], "contexts": ["named cordial powder", "cordial powder for heart and stomach"]}, {"entity_id": "diarhodon", "book_id": "polyanthea_medicinal", "name": "Diarhodon", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Diarhodon"], "contexts": ["a medicinal preparation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Diarhodon Abhatis", "target_book": "polyanthea_medicinal", "target_name": "Diarhodon", "similarity": 0.912}], "id": 1319, "stable_key": "clu_44ca923e2348ff8a", "ground_truth": {"modern_name": "Diarhodon Abhatis", "confidence": "high", "type": "chemical", "note": "This is a specific named compound or preparation, likely a cordial, mentioned in historical pharmacopoeias."}}, {"canonical_name": "Scab", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "scab", "book_id": "english_physician_1652", "name": "Scab", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["Scab"], "contexts": ["skin condition", "skin condition cured by Beech water"]}, {"entity_id": "scab", "book_id": "polyanthea_medicinal", "name": "Scab", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Scab"], "contexts": ["condition treated with goat's milk"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Scab", "target_book": "polyanthea_medicinal", "target_name": "Scab", "similarity": 1.0}], "id": 1320, "stable_key": "clu_0187204b7c0442bd", "ground_truth": {"modern_name": "Scabies", "confidence": "high", "type": "disease", "modern_term": "Scabies", "wikipedia_extract": "Scabies (, SKAY-beez; also sometimes known as the seven-year itch) is a contagious human skin infestation by the tiny (0.2–0.45 mm) mite Sarcoptes scabiei, variety hominis. The word is from Latin: scabere, lit. 'to scratch'. It is a particular public health problem in crowded settings such as care homes, schools, refugee camps, prisons, and hospitals. The most common symptoms are severe itchiness and a pimple-like rash. Occasionally, tiny burrows may appear on the skin from eggs that are about to hatch.", "wikipedia_url": "https://en.wikipedia.org/wiki/Scabies"}}, {"canonical_name": "Sperm", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "sperm", "book_id": "english_physician_1652", "name": "Sperm", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["Sperm"], "contexts": ["bodily fluid thought to be increased", "bodily fluid that can be increased"]}, {"entity_id": "spermazis", "book_id": "polyanthea_medicinal", "name": "spermazis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["spermazis"], "contexts": ["bodily fluid"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Sperm", "target_book": "polyanthea_medicinal", "target_name": "spermazis", "similarity": 0.92}], "id": 1321, "stable_key": "clu_e7f19613a9aa08a2", "ground_truth": {"wikipedia_extract": "Sperm (pl.: sperm or sperms) is the male reproductive cell, or gamete, in anisogamous forms of sexual reproduction (forms in which there is a larger, female reproductive cell and a smaller, male one). Sperm cells contribute approximately half of the nuclear genetic information to the diploid offspring (excluding, in most cases, mitochondrial DNA). Animals produce motile sperm with a tail known as a flagellum, which are known as spermatozoa, while some red algae and fungi produce non-motile sperm cells, known as spermatia. Flowering plants contain non-motile sperm inside pollen, while some more basal plants like ferns and some gymnosperms have motile sperm. Sperm cells form during the process known as spermatogenesis, which in amniotes (reptiles and mammals) takes place in the seminiferous tubules of the testicles. This process involves the production of several successive sperm cell precursors, starting with spermatogonia, which differentiate into spermatocytes."}}, {"canonical_name": "expectoraçao", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "expectoraçao", "book_id": "polyanthea_medicinal", "name": "expectoraçao", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 3, "variants": ["expectoraçao"], "contexts": ["the act of expelling matter from the lungs", "expulsion of matter from lungs"]}, {"entity_id": "excrecencias", "book_id": "coloquios_da_orta_1563", "name": "excrecencias", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["excrecencias"], "contexts": ["growths"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "expectoraçao", "target_book": "coloquios_da_orta_1563", "target_name": "excrecencias", "similarity": 0.88}], "id": 1322, "stable_key": "clu_938cb67e4296c71e", "ground_truth": {"modern_name": "Expectoration", "confidence": "high", "type": "concept", "note": "While 'excrecencias' can mean growths, in the context alongside 'expectoraçao' (Portuguese for expectoration), it is likely referring to the expulsion of matter from the lungs, potentially including pathological growths or mucus.", "wikidata_id": "Q647099", "wikidata_description": "medical symptom: bloody mucus from coughing", "wikipedia_extract": "Sputum is mucus that is coughed up from the lower airways (the trachea and bronchi). In medicine, sputum samples are usually used for a naked-eye examination, microbiological investigation of respiratory infections, and cytological investigations of respiratory system. A naked eye exam of the sputum can be done at home by a patient in order to note the various colors (see below). Any hint of yellow or green color (pus) suggests an airway infection (but does not indicate the type of organism causing it). Such color hints are best detected when the sputum is viewed against a bright white background, such as white paper, a white pot, or a white sink surface. Having green, yellow, or thickened phlegm (sputum) does not always indicate the presence of an infection.", "wikipedia_url": "https://en.wikipedia.org/wiki/Hemoptysis"}}, {"canonical_name": "press", "category": "OBJECT", "subcategory": "TOOL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "press", "book_id": "english_physician_1652", "name": "press", "category": "OBJECT", "subcategory": "TOOL", "count": 2, "variants": ["press"], "contexts": ["used to extract juice from herbs", "used to extract oil from herbs"]}, {"entity_id": "prensa", "book_id": "polyanthea_medicinal", "name": "prensa", "category": "OBJECT", "subcategory": "TOOL", "count": 2, "variants": ["prensa"], "contexts": ["used to extract juice", "press for extracting liquid"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "press", "target_book": "polyanthea_medicinal", "target_name": "prensa", "similarity": 0.927}], "id": 1323, "stable_key": "clu_f1f2991dd3b2d538", "ground_truth": {"modern_name": "Press", "confidence": "high", "type": "object", "note": "This refers to a mechanical device, likely a screw press or similar apparatus, used for extracting liquids.", "wikidata_id": "Q16881394", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Press%20%28surname%29"}}, {"canonical_name": "Arte Medendi", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "arte_medendi", "book_id": "polyanthea_medicinal", "name": "Arte Medendi", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 3, "variants": ["Arte Medendi", "Artem medendi"], "contexts": ["art of healing", "The art of healing"]}, {"entity_id": "medendi", "book_id": "english_physician_1652", "name": "Medendi", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Medendi"], "contexts": ["art of healing"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Arte Medendi", "target_book": "english_physician_1652", "target_name": "Medendi", "similarity": 0.884}], "id": 1324, "stable_key": "clu_8ea040b94b04fee6", "ground_truth": {"modern_name": "Art of Healing", "confidence": "high", "type": "concept", "note": "This Latin phrase translates directly to 'art of healing' or 'the practice of medicine'.", "wikidata_id": "Q137921957", "wikidata_description": "", "wikipedia_extract": "Organon of the Art of Healing (Organon der rationellen Heilkunde) by Samuel Hahnemann, 1810, laid out the doctrine of his ideas of homoeopathy. The work was repeatedly revised by Hahnemann and published in six editions, with the name changed from the second onwards to Organon of Medicine (Organon der Heilkunst), and has been so since the mid-19th century. Hahnemann wrote this book in order to document his new system of medicine, \"Homoeopathy\". In 1796, some six years after Hahnemann first experienced the effect of Peruvian Bark Cinchona in 1790 he published an article under the title \"Essay on a New Principle\". After conducting personal observations and experiments, Hahnemann published his new account of homoeopathy in book form in 1810. The original title of the book was Organon of Rational Art of Healing.", "wikipedia_url": "https://en.wikipedia.org/wiki/The_Organon_of_the_Healing_Art"}}, {"canonical_name": "corrupçao", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "corrupçao", "book_id": "polyanthea_medicinal", "name": "corrupçao", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["corrupçao"], "contexts": ["free from corruption", "corruption"]}, {"entity_id": "corruption", "book_id": "english_physician_1652", "name": "Corruption", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Corruption"], "contexts": ["much Rhewm and Corruption"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "corrupçao", "target_book": "english_physician_1652", "target_name": "Corruption", "similarity": 0.969}], "id": 1325, "stable_key": "clu_533fa5688473a316", "ground_truth": {"modern_name": "Corruption", "confidence": "medium", "type": "disease", "modern_term": "Infection or putrefaction", "note": "The term 'corrupçao'/'Corruption' in early modern texts often referred to a general sense of decay, putrefaction, or infection within the body, rather than a specific disease."}}, {"canonical_name": "Teneſmo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "teneſmo", "book_id": "polyanthea_medicinal", "name": "Teneſmo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["Teneſmo", "Tenesm"], "contexts": ["painful bowel movements", "medical condition involving straining"]}, {"entity_id": "tenasmus", "book_id": "english_physician_1652", "name": "Tenasmus", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Tenasmus"], "contexts": ["frequent urge to defecate"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Teneſmo", "target_book": "english_physician_1652", "target_name": "Tenasmus", "similarity": 0.885}], "id": 1326, "stable_key": "clu_39a3d31bc1b5dea4", "ground_truth": {"modern_name": "Tenesmus", "confidence": "high", "type": "disease", "modern_term": "Tenesmus", "wikidata_id": "Q2319686", "wikidata_description": "medical condition", "wikipedia_url": "https://en.wikipedia.org/wiki/Vesical_tenesmus", "wikipedia_extract": "Irritable bowel syndrome (IBS) is a functional gastrointestinal disorder characterized by a group of symptoms that commonly include abdominal pain, abdominal bloating, and changes in the consistency of bowel movements. These symptoms may occur over a long time, sometimes for years. IBS can negatively affect quality of life and may result in missed school or work or reduced productivity at work. Disorders such as anxiety, major depression, and myalgic encephalomyelitis/chronic fatigue syndrome are common among people with IBS, sometimes developing due to the condition. The cause of IBS is not known but multiple factors have been proposed to lead to the condition. Theories include combinations of \"gut–brain axis\" problems, alterations in gut motility, visceral hypersensitivity, infections including small intestinal bacterial overgrowth, neurotransmitters, genetic factors, and food sensitivity."}}, {"canonical_name": "frunculos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "frunculos", "book_id": "polyanthea_medicinal", "name": "frunculos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["frunculos", "furunculis", "furunculos"], "contexts": ["boils", "boils, a consequence of thick milk"]}, {"entity_id": "freekles", "book_id": "english_physician_1652", "name": "Freekles", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Freekles"], "contexts": ["skin discoloration"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "frunculos", "target_book": "english_physician_1652", "target_name": "Freekles", "similarity": 0.843}], "id": 1327, "stable_key": "clu_dc9f87089280a8dc", "ground_truth": {"modern_name": "Boils", "confidence": "medium", "type": "disease", "modern_term": "Furuncles", "note": "While 'frunculos' directly translates to 'boils', 'Freekles' is likely an OCR error or misinterpretation of a similar-sounding term for a skin condition. Given the context of 'frunculos', boils is the more probable identification."}}, {"canonical_name": "materias", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "materias", "book_id": "polyanthea_medicinal", "name": "materias", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["materias", "materia ſeroſa"], "contexts": ["bodily discharge", "matters, to be drained"]}, {"entity_id": "matter", "book_id": "english_physician_1652", "name": "matter", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["matter"], "contexts": ["discharge from the ears"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "materias", "target_book": "english_physician_1652", "target_name": "matter", "similarity": 0.926}], "id": 1328, "stable_key": "clu_346188b84b5c6fd4", "ground_truth": {"modern_name": "Bodily Discharge", "confidence": "high", "type": "concept", "note": "The term 'materias'/'matter' in this context refers to bodily fluids or substances expelled from the body.", "wikipedia_extract": "Heroic medicine can either refer to heroic therapy or to heroic drugs. Heroic therapy, also referred to as heroic depletion theory, was a therapeutic method advocating for rigorous treatment of bloodletting, purging, and sweating to shock the body back to health after an illness caused by a humoral imbalance. Rising to the front of orthodox medical practice in North America in the \"Age of Heroic Medicine\" (1780–1850), it fell out of favor in the mid-19th century as gentler treatments were shown to be more effective and the idea of palliative treatment began to develop. Heroic drugs, also called in English potent medicaments, was also a term used in Europe from the 18th to the 20th century to refer to certain potent pharmaceutical drugs. Pockets of medical methodology that can be classified as \"heroic\" appear in the early 17th century with Parisian physician Guy Patin and French anatomist Jean Riolan the Younger. Patin, nicknamed \"Le Grand Saigneur\" (the Grand Bloodletter), was infamous for his rigorous procedure plans, which included intensive courses of bloodletting and application of senna.", "wikipedia_url": "https://en.wikipedia.org/wiki/Heroic_medicine"}}, {"canonical_name": "ligamentos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "ligamentos", "book_id": "polyanthea_medicinal", "name": "ligamentos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["ligamentos", "ligamento"], "contexts": ["connecting ribs to spine", "connecting uterus and intestine"]}, {"entity_id": "limbs", "book_id": "english_physician_1652", "name": "Limbs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Limbs"], "contexts": ["wounded"]}, {"entity_id": "ligaments", "book_id": "english_physician_1652", "name": "Ligaments", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Ligaments"], "contexts": ["body part bound by disease"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "ligamentos", "target_book": "english_physician_1652", "target_name": "Limbs", "similarity": 0.856}, {"source_book": "polyanthea_medicinal", "source_name": "ligamentos", "target_book": "english_physician_1652", "target_name": "Ligaments", "similarity": 0.956}], "id": 1329, "stable_key": "clu_c00173a9e1ead709", "ground_truth": {"modern_name": "Ligaments", "confidence": "high", "type": "concept", "note": "'Ligamentos' refers to ligaments. 'Limbs' and 'Ligaments' in the English text confirm this anatomical reference.", "wikipedia_extract": "Cementum is a specialized calcified substance covering the root of a tooth. The cementum is the part of the periodontium that attaches the teeth to the alveolar bone by anchoring the periodontal ligament. The cells of cementum are the entrapped cementoblasts, the cementocytes. Each cementocyte lies in its lacuna, similar to the pattern noted in bone. These lacunae also have canaliculi or canals. Unlike those in bone, however, these canals in cementum do not contain nerves, nor do they radiate outward.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cementum"}}, {"canonical_name": "Dodoneus", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "dodoneus", "book_id": "polyanthea_medicinal", "name": "Dodoneus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Dodoneus"], "contexts": ["ancient medical authority on blood tears", "cited for fevers"]}, {"entity_id": "dodonaeus", "book_id": "english_physician_1652", "name": "Dodonaeus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Dodonaeus"], "contexts": ["authority on plants and their uses"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Dodoneus", "target_book": "english_physician_1652", "target_name": "Dodonaeus", "similarity": 0.894}], "id": 1330, "stable_key": "clu_6b61780d2bf9d4c0", "ground_truth": {"modern_name": "Rembert Dodoens", "confidence": "high", "type": "person", "birth_year": 1517, "death_year": 1585, "description": "Flemish physician and botanist, renowned for his herbal.", "wikidata_id": "Q437466", "wikidata_description": "Flemish physician and botanist (1517–1585)", "wikipedia_extract": "Rembert Dodoens (born Rembert van Joenckema, 29 June 1517 – 10 March 1585) was a Flemish physician and botanist, also known under his Latinized name Rembertus Dodonaeus. He has been called the father of botany. The standard author abbreviation Dodoens is used to indicate this person as the author when citing a botanical name. Dodoens was born Rembert van Joenckema in Mechelen, then the capital of the Spanish Netherlands in 1517. His parents were Denis van Joenckema (d. 1533) and Ursula Roelants.", "wikipedia_url": "https://en.wikipedia.org/wiki/Rembert_Dodoens"}}, {"canonical_name": "Hops", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "hops", "book_id": "english_physician_1652", "name": "Hops", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Hops"], "contexts": ["herb used in preparation", "well-known cultivated plant"]}, {"entity_id": "hops", "book_id": "first_principles_spencer_1862", "name": "hops", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["hops"], "contexts": ["rural inhabitants producing hops"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Hops", "target_book": "first_principles_spencer_1862", "target_name": "hops", "similarity": 0.873}], "id": 1331, "stable_key": "clu_c0921489ff1e6f98", "ground_truth": {"modern_name": "Hops", "confidence": "high", "type": "plant", "linnaean": "Humulus lupulus Linnaeus", "family": "Cannabaceae", "wikidata_id": "Q58393", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Dodonaea%20viscosa", "wikipedia_extract": "Hops are the flowers (also called seed cones or strobiles) of the hop plant Humulus lupulus, a member of the Cannabaceae family of flowering plants. They are used primarily as a bittering, flavouring, and stability agent in beer, to which, in addition to bitterness, they impart floral, fruity, or citrus flavours and aromas. Hops are also used for various purposes in other beverages and herbal medicine. The hops plants have separate female and male plants, and only female plants are used for commercial production. The hop plant is a vigorous climbing herbaceous perennial, usually trained to grow up strings in a field called a hopfield, hop garden (in the South of England), or hop yard (in the West Country and United States) when grown commercially. Many different varieties of hops are grown by farmers around the world, with different types used for particular styles of beer."}}, {"canonical_name": "cocuyos", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "cocuyos", "book_id": "relation_historique_humboldt_vol3_1825", "name": "cocuyos", "category": "ANIMAL", "subcategory": "INSECT", "count": 3, "variants": ["cocuyos", "Cocuyo"], "contexts": ["glowing insects used as lanterns", "insects used as lanterns"]}, {"entity_id": "coccus", "book_id": "origin_of_species_darwin_1859", "name": "Coccus", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["Coccus"], "contexts": ["insect studied for nerve variability"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "cocuyos", "target_book": "origin_of_species_darwin_1859", "target_name": "Coccus", "similarity": 0.893}], "id": 1332, "stable_key": "clu_4ace31fbfaff4285", "ground_truth": {"modern_name": "Firefly", "confidence": "high", "type": "animal", "note": "The term 'cocuyos' refers to a type of bioluminescent beetle, commonly known as fireflies. 'Coccus' is likely a misreading or broader term for a beetle.", "wikidata_id": "Q25420", "wikidata_description": "family of beetles", "wikipedia_url": "https://en.wikipedia.org/wiki/Firefly", "wikipedia_extract": "The Prince of Los Cocuyos is a memoir of Richard Blanco's childhood. The story takes place in Westchester, Miami during the late 1970s and '80s. Blanco is known for being the first Hispanic and openly gay poet of the United States. This book follows his early life as he faced cultural and identity differences within his own family and the hardships of coming of age. In the memoir, he substitutes the real names of his family and friends to tell his story. For example, \"Caco\" is Richard's older brother Carlos."}}, {"canonical_name": "entomologists", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "entomologists", "book_id": "origin_of_species_darwin_1859", "name": "entomologists", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 2, "variants": ["entomologists"], "contexts": ["experts in insect classification", "scientists who study insects"]}, {"entity_id": "entomologist", "book_id": "principles_of_psychology_james_1890", "name": "entomologist", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 2, "variants": ["entomologist"], "contexts": ["one who studies insects", "scientist studying insects"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "entomologists", "target_book": "principles_of_psychology_james_1890", "target_name": "entomologist", "similarity": 0.97}], "id": 1333, "stable_key": "clu_0874db1fa3d21be4", "ground_truth": {"wikipedia_extract": "Entomology, from Ancient Greek ἔντομον (éntomon), meaning \"insect\", and λόγος (lógos), meaning \"study\", is the branch of zoology that focuses on insects. Those who study entomology are known as entomologists. In the past, the term insect was less specific, and historically the definition of entomology would also include the study of animals in other arthropod groups, such as arachnids, myriapods, and crustaceans. The field is also referred to as insectology in American English, while in British English insectology implies the study of the relationships between insects and humans. Over 1.3 million insect species have been described by entomology. Entomology is rooted in nearly all human cultures from prehistoric times, primarily in the context of agriculture (especially biological control and beekeeping)."}}, {"canonical_name": "sorveira", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "sorveira", "book_id": "coloquios_da_orta_1563", "name": "sorveira", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["sorveira"], "contexts": ["tree where lacre does not grow", "tree name"]}, {"entity_id": "sorvas", "book_id": "polyanthea_medicinal", "name": "Sorvas", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Sorvas"], "contexts": ["plant name"]}, {"entity_id": "sorveyra", "book_id": "polyanthea_medicinal", "name": "Sorveyra", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Sorveyra"], "contexts": ["tree name"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "sorveira", "target_book": "polyanthea_medicinal", "target_name": "Sorvas", "similarity": 0.912}, {"source_book": "coloquios_da_orta_1563", "source_name": "sorveira", "target_book": "polyanthea_medicinal", "target_name": "Sorveyra", "similarity": 0.948}], "id": 1334, "stable_key": "clu_657d354ceba7f17f", "ground_truth": {"modern_name": "Strawberry Tree", "confidence": "high", "type": "plant", "linnaean": "Arbutus unedo Linnaeus", "family": "Ericaceae", "note": "The 'sorveira' or 'sorveira' is a Portuguese name for Arbutus unedo, commonly known as the Strawberry Tree. 'Sorvas' could be a variation or related term.", "wikidata_id": "Q329046", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Arbutus_unedo", "wikipedia_extract": "Arbutus unedo, commonly known as strawberry tree, also called madrone, is an evergreen shrub or small tree in the family Ericaceae, native to the Mediterranean Basin and Western Europe. The tree is well known for its fruits, the arbutus berry, which bear some resemblance to the strawberry, hence the common name strawberry tree. However, it is not closely related to true strawberries of the genus Fragaria. Its presence in Ireland also lends it the name Irish strawberry tree, or cain, or cane apple (from the Irish name for the tree, caithne), or sometimes Killarney strawberry tree. The strawberry tree is the national tree of Italy because of its green leaves, its white flowers and its red berries, colors that recall the Italian flag. The flower of the strawberry tree is the national flower of Italy."}}, {"canonical_name": "augitic lava", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "augitic_lava", "book_id": "kosmos_humboldt_1845", "name": "augitic lava", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["augitic lava"], "contexts": ["rock composing crater basin sides", "lava type from Jorullo"]}, {"entity_id": "lava", "book_id": "connexion_physical_sciences_somerville_1858", "name": "lava", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["lava"], "contexts": ["melted matter below earth's crust", "molten rock from volcanic eruptions"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "augitic lava", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lava", "similarity": 0.879}], "id": 1335, "stable_key": "clu_21777e925525a205", "ground_truth": {"modern_name": "Augitic lava", "confidence": "high", "type": "mineral", "note": "Augitic lava refers to lava containing the mineral augite.", "wikidata_id": "Q192141", "wikidata_description": "pyroxene mineral"}}, {"canonical_name": "fur", "category": "ANIMAL", "subcategory": "PRODUCT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "fur", "book_id": "origin_of_species_darwin_1859", "name": "fur", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 3, "variants": ["fur"], "contexts": ["thickness influenced by climate", "hair covering of mammals"]}, {"entity_id": "fur", "book_id": "first_principles_spencer_1862", "name": "fur", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["fur"], "contexts": ["thick hair covering of mammals"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "fur", "target_book": "first_principles_spencer_1862", "target_name": "fur", "similarity": 1.0}], "id": 1336, "stable_key": "clu_2029fc047ef77057", "ground_truth": {"modern_name": "Fur", "confidence": "high", "type": "concept", "note": "Refers to the thick hair covering of mammals.", "wikidata_id": "Q197204", "wikidata_description": "thick growth of hair that covers the skin of many different animals, particularly mammals", "wikipedia_extract": "A fur is a soft, thick growth of hair that covers the skin of almost all mammals. It consists of a combination of oily guard hair on top and thick underfur beneath. The guard hair keeps moisture from reaching the skin; the underfur acts as an insulating blanket that keeps the animal warm. The fur of mammals has many purposes: protection, sensory, waterproofing, and camouflaging, with the primary purpose being thermoregulation. The types of hair include definitive, which may be shed after reaching a certain length; vibrissae, which are sensory hairs and are most commonly whiskers; pelage, which consists of guard hairs, under-fur, and awn hair; spines, which are a type of stiff guard hair used for defense in, for example, porcupines; bristles, which are long hairs usually used in visual signals, such as the mane of a lion; velli, often called \"down fur\", which insulates newborn mammals; and wool, which is long, soft, and often curly. Hair length is unimportant in thermoregulation, as some tropical mammals, such as sloths, have the same fur length as some arctic mammals but with less insulation; and, conversely, other tropical mammals with short hair have the same insulating value as arctic mammals.", "wikipedia_url": "https://en.wikipedia.org/wiki/Fur"}}, {"canonical_name": "Plumage", "category": "ANIMAL", "subcategory": "PRODUCT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "plumage", "book_id": "origin_of_species_darwin_1859", "name": "Plumage", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 3, "variants": ["plumage", "Plumage"], "contexts": ["bird's feathers collectively", "feathers of birds"]}, {"entity_id": "plumage", "book_id": "first_principles_spencer_1862", "name": "plumage", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["plumage"], "contexts": ["feathers of a bird"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Plumage", "target_book": "first_principles_spencer_1862", "target_name": "plumage", "similarity": 0.96}], "id": 1337, "stable_key": "clu_8c9a2894d451a848", "ground_truth": {"modern_name": "Plumage", "confidence": "high", "type": "concept", "note": "Refers to the collective feathers of a bird.", "wikidata_id": "Q81025", "wikidata_description": "body-covering structure of some dinosaurs including birds", "wikipedia_extract": "Feathers are epidermal growths that form a distinctive outer covering, or plumage, on both avian (bird) and some non-avian dinosaurs and other archosaurs. They are the most complex integumentary structures found in vertebrates and an example of a complex evolutionary novelty. They are among the characteristics that distinguish the extant birds from other living groups. Although feathers cover most of the bird's body, they arise only from certain well-defined tracts on the skin. They aid in flight, thermal insulation, and waterproofing. In addition, coloration helps in communication and protection.", "wikipedia_url": "https://en.wikipedia.org/wiki/Feather"}}, {"canonical_name": "workers", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "workers", "book_id": "origin_of_species_darwin_1859", "name": "workers", "category": "ANIMAL", "subcategory": "INSECT", "count": 3, "variants": ["workers"], "contexts": ["caste of ants performing labor", "of Formica flava, large and small"]}, {"entity_id": "working-bee", "book_id": "first_principles_spencer_1862", "name": "working-bee", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["working-bee"], "contexts": ["type of bee in a colony"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "workers", "target_book": "first_principles_spencer_1862", "target_name": "working-bee", "similarity": 0.858}], "id": 1338, "stable_key": "clu_765f53ad76e346b7", "ground_truth": {"modern_name": "Worker bee", "confidence": "high", "type": "animal", "note": "Refers to the sterile female bees in a colony that perform labor.", "wikidata_id": "Q627153", "wikidata_description": "female bee with blocked reproductive capacity", "wikipedia_extract": "A worker bee is any female bee that lacks the reproductive capacity of the colony's queen bee and carries out the majority of tasks needed for the functioning of the hive. While worker bees are present in all eusocial bee species, the term is rarely used (outside of scientific literature) for bees other than honey bees, particularly the European honey bee (Apis mellifera). Worker bees of this variety are responsible for approximately 80% of the world's crop pollination services. Worker bees are the caste of bee that perform most of the fundamental tasks of the hive, and they are by far the most numerous type of bee. They are much smaller than drones or queen bees, with bodies specialized for nectar and pollen collection. They perform different tasks around the hive progressively over their lifespans in a predictable order based on their age.", "wikipedia_url": "https://en.wikipedia.org/wiki/Worker_bee"}}, {"canonical_name": "Origin of Species", "category": "ORGANIZATION", "subcategory": "JOURNAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "origin_of_species", "book_id": "origin_of_species_darwin_1859", "name": "Origin of Species", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 2, "variants": ["origin of species", "Origin of Species"], "contexts": ["mystery of biological diversity", "title of a scientific work"]}, {"entity_id": "on_the_origin_of_species", "book_id": "origin_of_species_darwin_1859", "name": "On the Origin of Species", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["On the Origin of Species"], "contexts": ["title of a scientific book"]}, {"entity_id": "the_origin_of_species", "book_id": "first_principles_spencer_1862", "name": "The Origin of Species", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["The Origin of Species"], "contexts": ["Darwin's influential work"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Origin of Species", "target_book": "first_principles_spencer_1862", "target_name": "The Origin of Species", "similarity": 0.97}, {"source_book": "origin_of_species_darwin_1859", "source_name": "On the Origin of Species", "target_book": "first_principles_spencer_1862", "target_name": "The Origin of Species", "similarity": 0.962}], "id": 1339, "stable_key": "clu_8ec1646d0ef5a58e", "ground_truth": {"modern_name": "On the Origin of Species", "confidence": "high", "type": "text", "note": "Refers to Charles Darwin's seminal scientific book.", "wikidata_id": "Q20124", "wikidata_description": "treatise on natural selection, written by Charles Darwin", "wikipedia_extract": "On the Origin of Species by Means of Natural Selection, or the Preservation of Favoured Races in the Struggle for Life is a work of scientific literature by Charles Darwin that is considered to be the foundation of evolutionary biology. It was published on 24 November 1859. Darwin's book introduced the scientific theory that populations evolve over the course of generations through a process of natural selection, although Lamarckism was also included as a mechanism of lesser importance. The book presented a body of evidence that the diversity of life arose by common descent through a branching pattern of evolution. Darwin included evidence that he had collected on the Beagle expedition in the 1830s and his subsequent findings from research, correspondence, and experimentation. Various evolutionary ideas had already been proposed to explain new findings in biology.", "wikipedia_url": "https://en.wikipedia.org/wiki/On_the_Origin_of_Species"}}, {"canonical_name": "cigarros", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "cigarros", "book_id": "relation_historique_humboldt_vol3_1825", "name": "cigarros", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["cigarros", "cigares"], "contexts": ["rolled tobacco product", "tobacco product"]}, {"entity_id": "cigarette", "book_id": "principles_of_psychology_james_1890", "name": "cigarette", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["cigarette"], "contexts": ["tobacco product", "object that produces smoke"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "cigarros", "target_book": "principles_of_psychology_james_1890", "target_name": "cigarette", "similarity": 0.948}], "id": 1340, "stable_key": "clu_321fef9805c4e71d", "ground_truth": {"modern_name": "cigar", "confidence": "high", "type": "object", "note": "The term 'cigarette' is also present in the cluster, but 'cigarros' is the primary term and directly translates to 'cigars'.", "wikidata_id": "Q1346603", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Cigaritis"}}, {"canonical_name": "Malte-Brun", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "malte-brun", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Malte-Brun", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Malte-Brun", "Malte- Brun"], "contexts": ["compared idol to celestial spirits", "author of Géogr."]}, {"entity_id": "malte-brun", "book_id": "kosmos_humboldt_1845", "name": "Malte-Brun", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Malte-Brun"], "contexts": ["editor of travel annals"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Malte-Brun", "target_book": "kosmos_humboldt_1845", "target_name": "Malte-Brun", "similarity": 1.0}], "id": 1341, "stable_key": "clu_202d4e4829ce4de3", "ground_truth": {"modern_name": "Conrad Malte-Brun", "confidence": "high", "type": "person", "birth_year": 1775, "death_year": 1826, "description": "Danish-French geographer and writer, editor of 'Annales des voyages'.", "wikidata_id": "Q980235", "wikidata_description": "Dano-French geographer", "wikipedia_url": "https://en.wikipedia.org/wiki/Conrad%20Malte-Brun", "wikipedia_extract": "Conrad Malte-Brun (French: [kɔ̃ʁad malt bʁœ̃]; born Malthe Conrad Bruun; 12 August 1775 – 14 December 1826), sometimes referred to simply as Malte-Brun, was a Dano-French geographer and journalist. His second son, Victor Adolphe Malte-Brun, was also a geographer. Today he is perhaps best remembered for coining the name for both the geographic regions of Oceania (French Océanie) around 1812 and Indo-China in 1804. Born in Thisted to an administrator of Danish crown lands, Malte-Brun was originally destined for a career as a pastor, but chose instead to attend classes at the University of Copenhagen, and became a supporter of the French Revolution and an activist in favor of freedom of the press. Following the harsh censorship laws instituted by the Danish ruler crown prince Frederick in September 1799, he was indicted because of his many pamphlets which contained outright criticism of the government, which the new censorship laws forbade. A particular cause for offence was a pamphlet he published in 1795 entitled \"Catechism of the Aristocrats.\" The case of Peter Andreas Heiberg, who for similar crimes had been sentenced to exile at Christmas of 1799, did not make Malte-Brun optimistic about his prospects."}}, {"canonical_name": "nummulites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "nummulites", "book_id": "relation_historique_humboldt_vol3_1825", "name": "nummulites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["nummulites", "nuœmulites"], "contexts": ["fossil foraminifera", "fossil found in coarse limestone"]}, {"entity_id": "nummulites", "book_id": "kosmos_humboldt_1845", "name": "Nummulites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Nummulites"], "contexts": ["fossil foraminifera"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "nummulites", "target_book": "kosmos_humboldt_1845", "target_name": "Nummulites", "similarity": 0.985}], "id": 1342, "stable_key": "clu_9ea4e6d929c802b5", "ground_truth": {"modern_name": "Nummulites", "confidence": "high", "type": "animal", "note": "Nummulites are extinct marine protozoa, commonly found as fossils, which fits the description of fossil foraminifera.", "wikidata_id": "Q1604065", "wikidata_description": "genus of foraminifera", "wikipedia_url": "https://en.wikipedia.org/wiki/Nummulite", "wikipedia_extract": "A nummulite is a large lenticular fossil, characterised by its numerous coils, subdivided by septa into chambers. They are the shells of the fossil and present-day marine protozoan Nummulites, a type of foraminiferan. Nummulites commonly vary in diameter from 13 to 50 mm (0.51 to 1.97 in)  and are common in Eocene to Miocene marine rocks, particularly around southwest Asia and the Mediterranean in the area that once constituted the Tethys Ocean, such as Eocene limestones from Egypt or from Pakistan. Fossils up to six inches wide are found in the Middle Eocene rocks of Turkey. They are valuable as index fossils. The ancient Egyptians used nummulite shells as coins and the pyramids were constructed using limestone that contained nummulites."}}, {"canonical_name": "Hallein", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "hallein", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Hallein", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Hallein", "Halle"], "contexts": ["location mentioned", "city in Germany"]}, {"entity_id": "halle", "book_id": "kosmos_humboldt_1845", "name": "Halle", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Halle"], "contexts": ["location with oscillation measurement"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hallein", "target_book": "kosmos_humboldt_1845", "target_name": "Halle", "similarity": 0.905}], "id": 1343, "stable_key": "clu_51895fb2797d9e8d", "ground_truth": {"modern_name": "Hallein", "confidence": "medium", "type": "place", "country": "Austria", "note": "The text mentions both 'Hallein' and 'Halle'. 'Hallein' is more specific and likely the intended location, while 'Halle' could refer to a different place or be a less precise mention of Hallein.", "wikidata_id": "Q4297141", "wikidata_description": "genus of myriapods"}}, {"canonical_name": "Dzongarie chinoise", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "dzongarie_chinoise", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Dzongarie chinoise", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Dzongarie chinoise", "Dzoungarie chinoise"], "contexts": ["border region of China", "border region visited during a voyage"]}, {"entity_id": "chinese_dzoungarie", "book_id": "kosmos_humboldt_1845", "name": "Chinese Dzoungarie", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Chinese Dzoungarie"], "contexts": ["geographic region in China"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Dzongarie chinoise", "target_book": "kosmos_humboldt_1845", "target_name": "Chinese Dzoungarie", "similarity": 0.892}], "id": 1344, "stable_key": "clu_bc649a7740e9807b", "ground_truth": {"modern_name": "Dzungaria", "confidence": "high", "type": "place", "country": "China", "note": "'Dzongarie chinoise' and 'Chinese Dzoungarie' clearly refer to the historical region of Dzungaria.", "wikidata_id": "Q214633", "wikidata_description": "species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Winter_white_dwarf_hamster", "wikipedia_extract": "The winter white dwarf hamster (Phodopus sungorus), also known as the Russian dwarf hamster, Djungarian hamster, Dzungarian hamster, striped dwarf hamster, Siberian hamster, or Siberian dwarf hamster, is one of three species of hamster in the genus Phodopus. Its body is ball-shaped and typically half the size of the golden hamster, so is called a dwarf hamster along with all Phodopus species. Features of the winter white hamster include a typically thick, dark grey dorsal stripe and furry feet. As winter approaches and the days shorten, the winter white dwarf hamster's dark fur is almost entirely replaced with white fur. In captivity, this does not usually happen as animals maintained as pets are generally housed indoors and exposed to artificial light that prevents the recognition of short winter daylengths. In the wild, they originate from the wheat fields of Kazakhstan, the meadows of Mongolia and Siberia, and the birch stands of Manchuria."}}, {"canonical_name": "Halifax", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "halifax", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Halifax", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Halifax"], "contexts": ["origin of a corsair", "city mentioned for lodging"]}, {"entity_id": "halifax", "book_id": "kosmos_humboldt_1845", "name": "Halifax", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Halifax"], "contexts": ["city in Nova Scotia, Canada"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Halifax", "target_book": "kosmos_humboldt_1845", "target_name": "Halifax", "similarity": 1.0}], "id": 1345, "stable_key": "clu_b2901c04e1ee9bde", "ground_truth": {"modern_name": "Halifax", "confidence": "high", "type": "place", "country": "Canada", "wikidata_id": "Q2141", "wikidata_description": "municipality in the province of Nova Scotia, Canada", "wikipedia_extract": "Halifax Shopping Centre, located in Halifax, Nova Scotia, is Atlantic Canada's largest multi-building shopping centre. Opened in 1962 as an enclosed mall anchored by department store Eaton's, the shopping centre is now owned by Primaris REIT. The largest anchor tenants are La Maison Simons, Winners, and Sportchek, while Sobeys and Walmart anchor the Halifax Shopping Centre Annex property across Mumford Road. Halifax Shopping Centre is also home to Mumford Terminal, a Halifax Transit bus interchange. Eaton's applied for rezoning of the property, formerly the site of the St. Patrick's Home, in January 1956, and a public hearing was held on 15 March 1956.", "wikipedia_url": "https://en.wikipedia.org/wiki/Halifax%2C_Nova_Scotia"}}, {"canonical_name": "Tomsk", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "tomsk", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tomsk", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Tomsk"], "contexts": ["city in Siberia", "city"]}, {"entity_id": "tomsk", "book_id": "kosmos_humboldt_1845", "name": "Tomsk", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Tomsk"], "contexts": ["city in Siberia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tomsk", "target_book": "kosmos_humboldt_1845", "target_name": "Tomsk", "similarity": 1.0}], "id": 1346, "stable_key": "clu_5ca3f816e83aa17c", "ground_truth": {"modern_name": "Tomsk", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q976", "wikidata_description": "city in and administrative center of Tomsk Oblast, Russia", "wikipedia_extract": "Seversk (Russian: Се́верск, IPA: [ˈsʲevʲɪrsk]) is a closed city in Tomsk Oblast, Russia, located 15 kilometers (9.3 mi) northwest of Tomsk on the right bank of the Tom River. The population was 108,590 at the 2010 census and 109,106 at the 2002 census. It was previously known as Pyaty Pochtovy (until 1949) and Tomsk-7 (until 1992). The city is located 15 kilometers (9.3 miles) northwest of Tomsk on the right bank of the Tom River. Seversk has a humid continental climate (Köppen climate classification Dfb) with warm summer. The annual average temperature is 0.6 °C (33.1 °F).", "wikipedia_url": "https://en.wikipedia.org/wiki/Tomsk"}}, {"canonical_name": "Ocopa", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "ocopa", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Ocopa", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Ocopa"], "contexts": ["convent in Peru", "convent, place of habitation"]}, {"entity_id": "otumpa", "book_id": "kosmos_humboldt_1845", "name": "Otumpa", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Otumpa"], "contexts": ["location of meteoric mass"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ocopa", "target_book": "kosmos_humboldt_1845", "target_name": "Otumpa", "similarity": 0.85}], "id": 1347, "stable_key": "clu_ce521f48599d056c", "ground_truth": {"modern_name": "Ocopa", "confidence": "medium", "type": "place", "country": "Peru", "note": "The cluster contains 'Ocopa' and 'Otumpa'. 'Ocopa' is a known location in Peru with a convent. 'Otumpa' is less clearly identifiable in this context, but the mention of a convent points towards Ocopa.", "wikipedia_extract": "Papa a la huancaína (literally, Huancayo-style potatoes) is a Peruvian appetizer of boiled potatoes in a spicy, creamy sauce made of queso fresco (fresh white cheese) and sautéed or grilled ají amarillo (yellow Peruvian pepper), red onion and garlic, all traditionally ground or pounded in a batán. Although the dish's name is derived from Huancayo, a city in the central Peruvian highlands nearest Lima, it has become a staple of everyday and holiday cuisine throughout the country. It is one of the most popular and representative gastronomic products of Peru. It is typically served cold as a starter over lettuce leaves and garnished with black olives, white corn kernels and hard-boiled egg quarters. In the south of Peru (Cuzco, Puno, Arequipa), it is served with ocopa rather than huancaína sauce, made from freshly toasted peanuts, fried onions and tomatoes, ají amarillo, cream or condensed milk, crushed crackers or dried bread, salt, and huacatay (Tagetes minuta). Because it is served cold, papa a la huancaína is a favorite food of Peruvians to take on picnics and trips.", "wikipedia_url": "https://en.wikipedia.org/wiki/Papa_a_la_huancaína"}}, {"canonical_name": "Campo de Gigantes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "campo_de_gigantes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Campo de Gigantes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Campo de Gigantes"], "contexts": ["Campo de Gigantes", "field near Suacha with Mastodon bones"]}, {"entity_id": "campo_de_gigantes", "book_id": "kosmos_humboldt_1845", "name": "Campo de Gigantes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Campo de Gigantes"], "contexts": ["field name with giant bones"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Campo de Gigantes", "target_book": "kosmos_humboldt_1845", "target_name": "Campo de Gigantes", "similarity": 1.0}], "id": 1348, "stable_key": "clu_fa9bb51b9bd2d34f", "ground_truth": {"modern_name": "Field of Giants", "confidence": "medium", "type": "place", "country": "Unknown", "note": "The exact geographical location referred to as 'Campo de Gigantes' is unclear from the provided context. It is described as a place with 'giant bones', suggesting it might be a paleontological site, but its modern identifier is not readily available.", "wikipedia_extract": "Giants Stadium (sometimes referred to as Giants Stadium at the Meadowlands) was a stadium located in East Rutherford, New Jersey, in the Meadowlands Sports Complex. The venue was open from 1976 to 2010, and primarily hosted sporting events and concerts. It was the home field of the New York metropolitan area's two National Football League teams, the New York Giants (from 1976 to 2009) and the New York Jets (from 1984 to 2009). It also was the home field of two New York metro area professional soccer teams, the NASL's New York Cosmos (from 1977 to 1984) and Major League Soccer's New York Red Bulls (from 1996 to 2009). The stadium's maximum seating capacity was 80,242. The structure was 756 feet (230 m) long, 592 feet (180 m) wide and 144 feet (44 m) high from service level to the top of the seating bowl and 178 feet (54 m) high to the top of the south tower.", "wikipedia_url": "https://en.wikipedia.org/wiki/Giants_Stadium"}}, {"canonical_name": "orthocératites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "orthocératites", "book_id": "relation_historique_humboldt_vol3_1825", "name": "orthocératites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["orthocératites"], "contexts": ["extinct marine cephalopod genus", "fossil organism, first traces of organization"]}, {"entity_id": "orthoceraitites", "book_id": "kosmos_humboldt_1845", "name": "Orthoceraitites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Orthoceraitites"], "contexts": ["fossil cephalopod genus"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "orthocératites", "target_book": "kosmos_humboldt_1845", "target_name": "Orthoceraitites", "similarity": 0.938}], "id": 1349, "stable_key": "clu_dca80e26c3d05e5f", "ground_truth": {"modern_name": "Orthoceras", "confidence": "high", "type": "animal", "note": "Orthocerida is an extinct suborder of nautiloid cephalopods, and 'Orthocerates' refers to fossils of these creatures. The context of 'fossil cephalopod genus' confirms this.", "wikidata_id": "Q3906531", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Orthoceras%20%28plant%29", "wikipedia_extract": "Orthoceras, from Ancient Greek ὀρθός (orthós), meaning \"straight\", and κέρας (kéras), meaning \"horn\", is a genus of extinct nautiloid cephalopod restricted to Middle Ordovician-aged marine limestones of the Baltic States and Sweden. This genus is sometimes called Orthoceratites and misspelled as Orthocera, Orthocerus, or Orthoceros. Orthoceras was formerly thought to have had a worldwide distribution due to the genus' use as a wastebasket taxon for numerous species of conical-shelled nautiloids throughout the Paleozoic and Triassic. Since this work was carried out and re-cataloging of the genus, Orthoceras sensu stricto refers to Orthoceras regulare, of Ordovician-aged Baltic Sea limestones of Sweden and neighboring areas. These are slender, elongate shells with the middle of the body chamber transversely constricted, and a subcentral orthochoanitic siphuncle. The surface is ornamented by a network of fine lirae (Sweet 1964:K224)."}}, {"canonical_name": "Aldebaran", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "aldebaran", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Aldebaran", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["Aldebaran"], "contexts": ["star occultation observed", "star used for occultation calculations"]}, {"entity_id": "aldebaran", "book_id": "kosmos_humboldt_1845", "name": "Aldebaran", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Aldebaran"], "contexts": ["star in Taurus constellation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Aldebaran", "target_book": "kosmos_humboldt_1845", "target_name": "Aldebaran", "similarity": 1.0}], "id": 1350, "stable_key": "clu_ab4d135c4d0f3605", "ground_truth": {"modern_name": "Aldebaran", "confidence": "high", "type": "object", "note": "Aldebaran is a star, not an animal. The context of 'star occultation observed' and 'star in Taurus constellation' clearly identifies it as an astronomical object.", "wikidata_id": "Q2623410", "wikidata_description": "French robotics company", "wikipedia_url": "https://en.wikipedia.org/wiki/Aldebaran", "wikipedia_extract": "Aldebaran (Arabic: الدَّبَران, lit. 'The Follower') is a star in the zodiac constellation of Taurus. It has the Bayer designation α Tauri, which is Latinized to Alpha Tauri and abbreviated Alpha Tau or α Tau. Aldebaran varies in brightness from an apparent visual magnitude of 0.75 down to 0.95, making it the brightest star in the constellation, as well as (typically) the fourteenth-brightest star in the night sky. It is at a distance of approximately 67 light-years. The star lies along the line of sight to the nearby Hyades cluster, but is unrelated and much older than the young cluster."}}, {"canonical_name": "Pinus occidentalis", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "pinus_occidentalis", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pinus occidentalis", "category": "PLANT", "subcategory": "TREE", "count": 3, "variants": ["Pinus occidentalis"], "contexts": ["pine tree found in Cuba", "species of pine tree"]}, {"entity_id": "pinus_occidentalis", "book_id": "kosmos_humboldt_1845", "name": "Pinus occidentalis", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Pinus occidentalis"], "contexts": ["pine tree in Mexico"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pinus occidentalis", "target_book": "kosmos_humboldt_1845", "target_name": "Pinus occidentalis", "similarity": 1.0}], "id": 1351, "stable_key": "clu_ffb3656bdd3bfe86", "ground_truth": {"modern_name": "Pinus occidentalis", "confidence": "high", "type": "plant", "linnaean": "Pinus occidentalis Sw.", "family": "Pinaceae", "wikidata_id": "Q3388586", "wikidata_description": "species of plant, Hispaniolan Pine", "wikipedia_url": "https://en.wikipedia.org/wiki/Pinus%20occidentalis", "wikipedia_extract": "Pinus occidentalis, also known as the Hispaniolan pine, Hispaniola pine or pino criollo, is a pine tree endemic to the island of Hispaniola (split between the Dominican Republic and Haiti). It is the eponymous species of the Hispaniolan pine forests ecosystem, in which it constitutes a majority of the biomass present. Another endemic species, the Hispaniolan crossbill (Loxia megaplaga), feeds almost exclusively on the cones of P. occidentalis."}}, {"canonical_name": "Saratow", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "saratow", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Saratow", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Saratow"], "contexts": ["city for observation", "city in Russia"]}, {"entity_id": "saratow", "book_id": "kosmos_humboldt_1845", "name": "Saratow", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Saratow"], "contexts": ["city in Eastern Russia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saratow", "target_book": "kosmos_humboldt_1845", "target_name": "Saratow", "similarity": 1.0}], "id": 1352, "stable_key": "clu_5206bf02277f1687", "ground_truth": {"modern_name": "Saratov", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q5332", "wikidata_description": "city in Saratov Oblast, Russia", "wikipedia_extract": "Saratov (UK:  sə-RAH-tof, US:  -⁠təf; Russian: Саратов, pronounced [sɐˈratəf] ) is the largest city and administrative center of Saratov Oblast, Russia, and a major port on the Volga River. As of the 2021 Census, Saratov had a population of 901,361, making it the 17th-largest city in Russia by population. Saratov is 389 kilometres (242 mi) north of Volgograd, 442 kilometres (275 mi) south of Samara, and 858 kilometres (533 mi) southeast of Moscow. The city stands near the site of Uvek, a city of the Golden Horde. Tsar Feodor I of Russia likely developed Saratov as a fortress to secure Russia's southeastern border. Saratov developed as a shipping port along the Volga and was historically important to the Volga Germans, who settled in large numbers in the city before they were expelled before and during World War II."}}, {"canonical_name": "Valverde", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "valverde", "book_id": "polyanthea_medicinal", "name": "Valverde", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Valverde"], "contexts": ["location of a patient", "narrator of Joao Ferreyra's child"]}, {"entity_id": "valenda", "book_id": "coloquios_da_orta_1563", "name": "Valenda", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Valenda"], "contexts": ["birthplace of Dimas Bosque"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Valverde", "target_book": "coloquios_da_orta_1563", "target_name": "Valenda", "similarity": 0.863}], "id": 1353, "stable_key": "clu_e9763772eeb7e4ea", "ground_truth": {"modern_name": "Valverde", "confidence": "medium", "type": "place", "country": "Spain", "note": "There are multiple places named Valverde. Given the context of early modern Portuguese and Spanish texts, likely refers to a location in Spain or potentially a less common place in Portuguese territories. The mention of 'Dimas Bosque' might help pinpoint it further but requires additional research.", "wikidata_id": "Q6159409", "wikidata_description": "family name"}}, {"canonical_name": "Prony", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "prony", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Prony", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Prony"], "contexts": ["author on canal works", "mentioned in work by M. de Pommcuse"]}, {"entity_id": "m__de_prony", "book_id": "relation_historique_humboldt_vol3_1825", "name": "M. de Prony", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["M. de Prony"], "contexts": ["Person who made experiments"]}, {"entity_id": "prony", "book_id": "kosmos_humboldt_1845", "name": "Prony", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Prony"], "contexts": ["mutual friend, scientist"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Prony", "target_book": "kosmos_humboldt_1845", "target_name": "Prony", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "M. de Prony", "target_book": "kosmos_humboldt_1845", "target_name": "Prony", "similarity": 0.852}], "id": 1354, "stable_key": "clu_29661b97c8880895", "ground_truth": {"modern_name": "Gaspard de Prony", "confidence": "high", "type": "person", "birth_year": 1755, "death_year": 1839, "description": "French engineer and mathematician, known for hydraulic and civil engineering.", "wikidata_id": "Q451608", "wikidata_description": "French mathematician and engineer, who worked on hydraulics (1755-1839)", "wikipedia_extract": "Baron Gaspard Clair François Marie Riche de Prony (22 July 1755 – 29 July 1839) was a French mathematician and engineer, who worked on hydraulics. He was born at Chamelet, Beaujolais, France and died in Asnières-sur-Seine, France. He was Engineer-in-Chief of the École nationale des ponts et chaussées [National school of bridges and roads], a technical school in Paris. The trigonometric and logarithmic tables of the cadastre In 1791, Prony embarked on the task of producing logarithmic and trigonometric tables for the French Cadastre (geographic survey). The effort was sanctioned by the French National Assembly, which, after the French Revolution wanted to bring uniformity to the multiple measurements and standards used throughout the nation. In particular, his tables were intended for precise land surveys, as part of a greater cadastre effort."}}, {"canonical_name": "Plutonisnie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "plutonisnie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Plutonisnie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Plutonisnie"], "contexts": ["belief in subterranean heat", "philosophical or scientific concept"]}, {"entity_id": "plutonic", "book_id": "kosmos_humboldt_1845", "name": "Plutonic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Plutonic"], "contexts": ["related to subterranean rock formation", "classification of rocks based on origin"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Plutonisnie", "target_book": "kosmos_humboldt_1845", "target_name": "Plutonic", "similarity": 0.928}], "id": 1355, "stable_key": "clu_3b16f6132e03e0ff", "ground_truth": {"modern_name": "Plutonic rocks", "confidence": "high", "type": "concept", "note": "The term 'Plutonic' in geological context refers to igneous rocks formed from magma that cools and solidifies beneath the Earth's surface. The context of 'subterranean heat' and 'subterranean rock formation' strongly supports this identification.", "wikipedia_extract": "Intrusive rock is formed when magma penetrates existing rock, crystallizes, and solidifies underground to form intrusions, such as batholiths, dikes, sills, laccoliths, and volcanic necks. Intrusion is one of the two ways igneous rock can form. The other is extrusion, such as a volcanic eruption or similar event. An intrusion is any body of intrusive igneous rock, formed from magma that cools and solidifies within the crust of the planet. In contrast, an extrusion consists of extrusive rock, formed above the surface of the crust. Some geologists use the term plutonic rock synonymously with intrusive rock, but other geologists subdivide intrusive rock, by crystal size, into coarse-grained plutonic rock (typically formed deeper in the Earth's crust in batholiths or stocks) and medium-grained subvolcanic or hypabyssal rock (typically formed higher in the crust in dikes and sills)."}}, {"canonical_name": "Blumenbach", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "blumenbach", "book_id": "kosmos_humboldt_1845", "name": "Blumenbach", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Blumenbach"], "contexts": ["scientist known for comparative anatomy", "master who classified races"]}, {"entity_id": "blumenbach", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Blumenbach", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Blumenbach"], "contexts": ["collector of human race skeletons"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Blumenbach", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Blumenbach", "similarity": 1.0}], "id": 1356, "stable_key": "clu_8835cbcc148dd3c8", "ground_truth": {"modern_name": "Johann Friedrich Blumenbach", "confidence": "high", "type": "person", "birth_year": 1752, "death_year": 1840, "description": "German physician, naturalist, comparative anatomist, and anthropologist.", "wikidata_id": "Q58588", "wikidata_description": "German physician, naturalist, physiologist, and anthropologist (1752 – 1840)", "wikipedia_url": "https://en.wikipedia.org/wiki/Johann%20Friedrich%20Blumenbach", "wikipedia_extract": "Johann Friedrich Blumenbach (11 May 1752 – 22 January 1840) was a German physician, naturalist, physiologist, and anthropologist. He is considered to be a main founder of zoology and anthropology as comparative, scientific disciplines. He has been called the \"founder of racial classifications\". He was one of the first to explore the study of the human being as an aspect of natural history. His teachings in comparative anatomy were applied to his classification of human races, of which he claimed there were five: Caucasian, Mongolian, Malayan, Ethiopian, and American. He was a member of what modern historians call the Göttingen school of history."}}, {"canonical_name": "Cygnus", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "cygnus", "book_id": "kosmos_humboldt_1845", "name": "Cygnus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Cygnus"], "contexts": ["constellation with a star", "constellation where new star appeared"]}, {"entity_id": "cygnus", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cygnus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Cygnus"], "contexts": ["constellation in northern sky", "constellation containing part of Milky Way"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Cygnus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cygnus", "similarity": 1.0}], "id": 1357, "stable_key": "clu_929be6abe876674b", "ground_truth": {"modern_name": "Cygnus", "confidence": "high", "type": "concept", "wikipedia_extract": "Swans are birds of the genus Cygnus within the family Anatidae. The swans' closest relatives include geese and ducks. Swans are grouped with the closely related geese in the subfamily Anserinae, forming the tribe Cygnini. Sometimes, they are considered a distinct subfamily, Cygninae. They are the largest waterfowl and are often among the largest flighted birds in their range. There are six living and many extinct species of swan; in addition, there is a species known as the coscoroba swan, which is no longer considered one of the true swans.", "wikipedia_url": "https://en.wikipedia.org/wiki/Swan"}}, {"canonical_name": "perpetual snow", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "perpetual_snow", "book_id": "kosmos_humboldt_1845", "name": "perpetual snow", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["perpetual snow"], "contexts": ["snow that remains year-round", "snow that remains throughout the year"]}, {"entity_id": "neiges_perpétuel_les", "book_id": "relation_historique_humboldt_vol3_1825", "name": "neiges perpétuel les", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["neiges perpétuel les"], "contexts": ["permanent snow at high altitudes"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "perpetual snow", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "neiges perpétuel les", "similarity": 0.913}], "id": 1358, "stable_key": "clu_c24c1bd088ec1e09", "ground_truth": {"modern_name": "Perennial snow", "confidence": "high", "type": "concept", "wikidata_id": "Q740358", "wikidata_description": "point above which snow and ice cover the ground throughout the year", "wikipedia_url": "https://en.wikipedia.org/wiki/Snow_line", "wikipedia_extract": "The climatic snow line is the boundary between a snow-covered and snow-free surface. The actual snow line may adjust seasonally, and be either significantly higher in elevation, or lower. The permanent snow line is the level above which snow will lie all year. Snow line is an umbrella term for different interpretations of the boundary between snow-covered surface and snow-free surface. The definitions of the snow line may have different temporal and spatial focus. In many regions the changing snow line reflect seasonal dynamics."}}, {"canonical_name": "Heidelberg", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "heidelberg", "book_id": "kosmos_humboldt_1845", "name": "Heidelberg", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Heidelberg"], "contexts": ["location of an edition", "city in Germany"]}, {"entity_id": "hildesheim", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Hildesheim", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Hildesheim"], "contexts": ["origin of surgeon"]}, {"entity_id": "heidelberg", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Heidelberg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Heidelberg"], "contexts": ["location of observation"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Heidelberg", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Hildesheim", "similarity": 0.864}, {"source_book": "kosmos_humboldt_1845", "source_name": "Heidelberg", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Heidelberg", "similarity": 1.0}], "id": 1359, "stable_key": "clu_a96a446a3e80b0e2", "ground_truth": {"modern_name": "Heidelberg", "confidence": "high", "type": "place", "country": "Germany", "note": "One instance refers to 'Hildesheim', which is a separate city.", "wikidata_id": "Q2966", "wikidata_description": "large city in Baden-Württemberg, Germany", "wikipedia_url": "https://en.wikipedia.org/wiki/Heidelberg", "wikipedia_extract": "Heidelberg (; German: [ˈhaɪdl̩bɛʁk] ; Palatine German: Heidlberg) is the fifth-largest city in the German state of Baden-Württemberg, and with a population of about 163,000, of which roughly a quarter consists of students, it is Germany's 51st-largest city. Located about 78 km (48 mi) south of Frankfurt, Heidelberg is part of the densely populated Rhine-Neckar Metropolitan Region which has its centre in Mannheim. Heidelberg is located on the Neckar River, at the point where it leaves its narrow valley between the Oden Forest and the Little Oden Forest, and enters the wide Upper Rhine Plain. The old town lies in the valley, the end of which is flanked by the Königstuhl in the south and the Heiligenberg in the north. The majority of the population lives in the districts west of the mountains in the Upper Rhine Plain, into which the city has expanded over time. Heidelberg University, founded in 1386, is Germany's oldest and one of Europe's most reputable universities."}}, {"canonical_name": "Rawak", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "rawak", "book_id": "kosmos_humboldt_1845", "name": "Rawak", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Rawak"], "contexts": ["exception to augmented gravitation", "location mentioned with exception"]}, {"entity_id": "radak", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Radak", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Radak"], "contexts": ["location of coral islands"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Rawak", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Radak", "similarity": 0.889}], "id": 1360, "stable_key": "clu_b9465c59f7aa8ee0", "ground_truth": {"modern_name": "Ralik Chain", "confidence": "medium", "type": "place", "country": "Marshall Islands", "note": "'Rawak' and 'Radak' likely refer to the Ralik Chain of the Marshall Islands, with 'Radak' being a common variant. The context of coral islands supports this.", "wikidata_id": "Q697840", "wikidata_description": "chain of islands, western sub-archipelago of the Marshall Islands", "wikipedia_url": "https://en.wikipedia.org/wiki/Ralik", "wikipedia_extract": "The Ralik Chain (Marshallese: Rālik, [rˠæːlʲik]) is a chain of islands within the island nation of the Marshall Islands. Ralik means \"sunset\". It is west of the Ratak Chain. In 1999 the total population of the Ralik islands was 19,915. Christopher Loeak, who became President of the Marshall Islands in 2012, was formerly Minister for the Ralik Chain. List of atolls and isolated islands in the chain: The Rālik Chain is home to the Rālik dialect (or western dialect) of the Marshallese language."}}, {"canonical_name": "varas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "varas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "varas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["varas"], "contexts": ["unit of measurement"]}, {"entity_id": "vihára", "book_id": "coloquios_da_orta_1563", "name": "vihára", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["vihára"], "contexts": ["Buddhist convent"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "varas", "target_book": "coloquios_da_orta_1563", "target_name": "vihára", "similarity": 0.866}], "id": 1361, "stable_key": "clu_1e66f110f94842da", "ground_truth": {"modern_name": "Vara", "confidence": "medium", "type": "object", "note": "The text mentions both a unit of measurement ('varas') and a Buddhist convent ('vihára'), suggesting two distinct meanings are conflated.", "wikipedia_extract": "This article includes a list of the most massive known objects of the Solar System and partial lists of smaller objects by observed mean radius. These lists can be sorted according to an object's radius and mass and, for the most massive objects, volume, density, and surface gravity, if these values are available. These lists contain the Sun, the planets, dwarf planets, many of the larger small Solar System bodies (which includes the asteroids), all named natural satellites, and a number of smaller objects of historical or scientific interest, such as comets and near-Earth objects. Many trans-Neptunian objects (TNOs) have been discovered; in many cases their positions in this list are approximate, as there is frequently a large uncertainty in their estimated diameters due to their distance from Earth. There are uncertainties in the figures for mass and radius, and irregularities in the shape and density, with accuracy often depending on how close the object is to Earth or whether it has been visited by a probe. Solar System objects more massive than 1021 kilograms are known or expected to be approximately spherical.", "wikipedia_url": "https://en.wikipedia.org/wiki/List_of_Solar_System_objects_by_size"}}, {"canonical_name": "bagasse", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "bagasse", "book_id": "relation_historique_humboldt_vol3_1825", "name": "bagasse", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["bagasse"], "contexts": ["dry sugar cane used as fuel", "sugarcane residue used as fuel"]}, {"entity_id": "bague", "book_id": "historia_medicinal_monardes_1574", "name": "Bague", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Bague"], "contexts": ["plant used in a pleasant-smelling confection", "a mixture with opium"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "bagasse", "target_book": "historia_medicinal_monardes_1574", "target_name": "Bague", "similarity": 0.889}], "id": 1362, "stable_key": "clu_fffd27c3e2f4787d", "ground_truth": {"wikipedia_extract": "Bagasse (  bə-GAS) is the dry pulpy fibrous material that remains after crushing sugarcane or sorghum stalks to extract their juice. It is used as a biofuel for the production of heat, energy, and electricity, and in the manufacture of pulp and building materials. Agave bagasse is similar, but is the material remnants after extracting blue agave sap. The word comes from bagasse (French) and bagazo (Spanish), meaning refuse or trash. It originally referred to the material left after pressing olives, palm nuts, and grapes. The word eventually came to be used in the context of processing of plants such as sugarcane and sugar beets."}}, {"canonical_name": "la Cyrénaïque", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "la_cyrénaïque", "book_id": "relation_historique_humboldt_vol3_1825", "name": "la Cyrénaïque", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["la Cyrénaïque", "Cyrénaïque"], "contexts": ["region in North Africa", "ancient region in North Africa"]}, {"entity_id": "cyrenaica", "book_id": "coloquios_da_orta_1563", "name": "Cyrenaica", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Cyrenaica"], "contexts": ["peninsula in North Africa", "ancient region in North Africa"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "la Cyrénaïque", "target_book": "coloquios_da_orta_1563", "target_name": "Cyrenaica", "similarity": 0.939}], "id": 1363, "stable_key": "clu_d22880d3df0241c6", "ground_truth": {"modern_name": "Cyrenaica", "confidence": "high", "type": "place", "country": "Libya", "wikidata_id": "Q165198", "wikidata_description": "eastern coastal region of Libya", "wikipedia_extract": "Cyrenaica ( SY-rə-NAY-ik-ə-,-SIRR-ə) or Kyrenaika (Arabic: برقة, romanized: Barqah, Koine Greek: Κυρηναϊκή [ἐπαρχία], romanized: Kūrēnaïkḗ [eparkhíā], after the city of Cyrene), is the eastern region of Libya. Cyrenaica includes all of the eastern part of Libya between the 16th and 25th meridians east, including the Kufra District. The coastal region, also known as Pentapolis (\"Five Cities\") in antiquity, was part of the Roman province of Crete and Cyrenaica, later divided into Libya Pentapolis and Libya Sicca. During the Islamic period, the area came to be known as Barqa, after the city of Barca. Cyrenaica became an Italian colony in 1911. After the 1934 formation of Italian Libya, the Cyrenaica province was designated as one of the three primary provinces of the country.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cyrenaica"}}, {"canonical_name": "Consco", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "consco", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Consco", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Consco", "Conucos"], "contexts": ["mountain range in the Andes", "Indian plantations of banana and maize"]}, {"entity_id": "concam", "book_id": "coloquios_da_orta_1563", "name": "Concam", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Concam"], "contexts": ["location reference", "Place name with page numbers"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Consco", "target_book": "coloquios_da_orta_1563", "target_name": "Concam", "similarity": 0.842}], "id": 1364, "stable_key": "clu_b99d38bafa2839e8", "ground_truth": {"wikipedia_extract": "Consco Enterprises Inc. was a software development firm headquartered in Edison, New Jersey, United States, in the early to late 1980s. Consco's primary product dubbed Consolidation, was based on pegboard accounting principles and designed to generate complex quarterly and annual tax reports for large multi-national corporations. Pegboard systems were and are still sold nationwide by \"Control o fax\" in Waterloo, Iowa. The main Consolidation product was later packaged with other Consco financial applications, such as Currency Conversion, which added functionality. The package was named Accounting Information System, or AIS. Some AIS clients included the Ford Motor Company, Campbell Soup Company, Miles Laboratories, LTV Corporation, Owens-Illinois, Texaco, Pennzoil, The Tennessee Valley Authority and Cummins Engine Company."}}, {"canonical_name": "Sacuima", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "sacuima", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sacuima", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Sacuima"], "contexts": ["mountain name", "mountain near Apure and Orénoque confluence"]}, {"entity_id": "satiguam", "book_id": "coloquios_da_orta_1563", "name": "Satiguam", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Satiguam", "Satigam"], "contexts": ["port in Bengal", "port of Bengal for spikenard"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sacuima", "target_book": "coloquios_da_orta_1563", "target_name": "Satiguam", "similarity": 0.853}], "id": 1365, "stable_key": "clu_662e85f20a40cf45", "ground_truth": {"modern_name": "Sāguima", "confidence": "low", "type": "place", "country": "India", "note": "The provided context is too brief to definitively identify 'Sacuima' and 'Satiguam'. 'Sacuima' could refer to a mountain or a place in Bengal, while 'Satiguam' is less clear. The identification as Sāguima (a historical port in Bengal) is speculative.", "wikipedia_extract": "The Fox Wars were two conflicts between the French and the Meskwaki (historically Fox) people who lived in the Great Lakes region (particularly near Fort Pontchartrain du Détroit) from 1712 to 1733. These territories are known today as the states of Michigan and Wisconsin in the United States. The Wars exemplified colonial warfare in the transitional space of New France, occurring within the complex system of alliances and enmities with native peoples and colonial plans for expansion. The Meskwaki controlled the Fox River system in eastern Wisconsin. This river was vital for the fur trade between French Canada and the North American interior, because it allowed river travel from Green Bay in Lake Michigan to the Mississippi River. The French wanted the rights to use the river system to gain access to both the Mississippi and trade contacts with tribes to the west.", "wikipedia_url": "https://en.wikipedia.org/wiki/Fox_Wars"}}, {"canonical_name": "Correa de Serra", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "correa_de_serra", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Correa de Serra", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Correa de Serra"], "contexts": ["person who examined census data", "author of instructive memoir on gold production"]}, {"entity_id": "corrêa_da_serra", "book_id": "coloquios_da_orta_1563", "name": "Corrêa da Serra", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Corrêa da Serra"], "contexts": ["botanist", "Portuguese botanist"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Correa de Serra", "target_book": "coloquios_da_orta_1563", "target_name": "Corrêa da Serra", "similarity": 0.921}], "id": 1366, "stable_key": "clu_3ef433fedc481558", "ground_truth": {"modern_name": "José Correia da Serra", "confidence": "high", "type": "person", "birth_year": 1750, "death_year": 1823, "description": "Portuguese botanist, writer, and politician", "wikidata_id": "Q2656605", "wikidata_description": "Portuguese academic and botanist (1751-1823)", "wikipedia_url": "https://en.wikipedia.org/wiki/Jos%C3%A9%20Correia%20da%20Serra", "wikipedia_extract": "José Francisco Correia da Serra (6 June 1750 – 11 September 1823) was a Portuguese abbot, polymath, philosopher, diplomat, politician and scientist. In some circumstances, he was also known as Abbé Correa. The plant genus Correa, native to Australia, is named in his honour. Correia da Serra was born at Serpa, in Alentejo, in 1750, and was educated at Rome, where he took holy orders. In 1777, he returned to Lisbon, where he was one of the founders of the Academia das Ciências de Lisboa in 1779 (then called Academia Real das Ciências de Lisboa; Royal Academy of Sciences of Lisbon). His published writings brought him into conflict with reactionary members of the religious and political hierarchy in Portugal."}}, {"canonical_name": "Punta Galera", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "punta_galera", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Punta Galera", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Punta Galera"], "contexts": ["geographic landmark", "geographical point in Venezuela"]}, {"entity_id": "ponta_de_galles", "book_id": "coloquios_da_orta_1563", "name": "Ponta de Galles", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Ponta de Galles"], "contexts": ["port known by this name", "geographic location"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Punta Galera", "target_book": "coloquios_da_orta_1563", "target_name": "Ponta de Galles", "similarity": 0.847}], "id": 1367, "stable_key": "clu_f71ae6662e052b34", "ground_truth": {"wikipedia_extract": "Punta Galera is a headland in the western coast of South America located in Los Ríos Region, Chile. The headland projects into the Pacific Ocean at the 40th parallel south just north of Colún Beach and south of Caleta Chaihuín. Punta Galera should not be confused with Falsa Punta Galera a minor headland located a few kilometers northeast of it. Punta Galera is the site of a lighthouse since 1875. The headland was noticed in the expedition of Juan Bautista Pastene in 1544, but the Spanish name of Punta Galera was given by the explorer Juan Ladrillero in 1557 who thought it resembled the ram of a galley (Spanish: galera). Local Mapuche called the headland vuchuchén, meaning \"place of travellers\"."}}, {"canonical_name": "Puerta", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "puerta", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Puerta", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Puerta"], "contexts": ["location near Merida and Truxillo"]}, {"entity_id": "gate", "book_id": "coloquios_da_orta_1563", "name": "Gate", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Gate"], "contexts": ["name of a mountain range", "a type of mountain"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Puerta", "target_book": "coloquios_da_orta_1563", "target_name": "Gate", "similarity": 0.923}], "id": 1368, "stable_key": "clu_692662591e79b53b", "ground_truth": {"wikipedia_extract": "The gates of Intramuros refer to the original eight gates of the Walled City of Intramuros in Manila, built during the Spanish colonial era in the Philippines. The gates are called by the original Spanish word for \"gate\", puerta (plural: puertas). This gate was built in 1662 as the governor-general's gate when the first governor's palace was still located in Fort Santiago. It was destroyed during an earthquake and was never rebuilt. Postigo means \"postern\" or a small gate in Spanish. This gate was named after the nearby Palacio del Gobernador."}}, {"canonical_name": "Berbéria", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "berbéria", "book_id": "coloquios_da_orta_1563", "name": "Berbéria", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Berbéria"], "contexts": ["coast mentioned as potential origin", "region where rhubarb is traded"]}, {"entity_id": "berbería", "book_id": "historia_medicinal_monardes_1574", "name": "Berbería", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Berbería"], "contexts": ["place of origin for rhubarb"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Berbéria", "target_book": "historia_medicinal_monardes_1574", "target_name": "Berbería", "similarity": 0.876}], "id": 1369, "stable_key": "clu_24cc16b219f60f87", "ground_truth": {"modern_name": "Barbary Coast", "confidence": "high", "type": "place", "country": "Algeria, Libya, Morocco, Tunisia", "wikidata_id": "Q501768", "wikidata_description": "name used to designate the territory of the Barbary and going from Libya to Morocco", "wikipedia_url": "https://en.wikipedia.org/wiki/Barbary%20Coast", "wikipedia_extract": "The Barbary Coast (also Barbary, Berbery, or Berber Coast) were the coastal areas of central and western North Africa, more specifically, the Maghreb and the Ottoman borderlands consisting of the regencies in Algiers, Tunis, and Tripoli, as well as the Sultanate of Morocco from the 16th to 19th centuries. The term originates from an exonym for the Berbers. Barbary was not always a unified political entity. From the 16th century onward, it was divided into four political entities—from west to east—the Alawi Sultanate, the Regency of Algiers, the Regency of Tunis, and the Regency of Tripoli. Major rulers and petty monarchs during the times of the Barbary states' plundering parties included the sultan of Morocco, the dey of Algiers, bey of Tunis, and pasha of Tripoli, respectively. The slave trade was not just an economic lifeline to the Barbary States, but was often justified as a form of jihad against Christian states."}}, {"canonical_name": "Bibliotheca Hispana", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "bibliotheca_hispana", "book_id": "coloquios_da_orta_1563", "name": "Bibliotheca Hispana", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Bibliotheca Hispana", "Bibliotheca Hispana nova", "Bibliotheca lusitana"], "contexts": ["bibliographical work"]}, {"entity_id": "biblioteca_americuna", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Biblioteca Americuna", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Biblioteca Americuna"], "contexts": ["publication reference"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Bibliotheca Hispana", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Biblioteca Americuna", "similarity": 0.856}], "id": 1370, "stable_key": "clu_e4a980669d603f2a", "ground_truth": {"modern_name": "Bibliotheca Hispana", "confidence": "high", "type": "text", "wikidata_id": "Q42187342", "wikidata_description": "work on the history of Spain by Nicolás Antonio", "wikipedia_extract": "Miguel Casiri (Arabic: الاب مخايل الغزيري; Mikhael Ghaziri) (1710–1791) was a learned Maronite and Orientalist. He was born in Tripoli, Lebanon (formerly in Ottoman Syria). He studied at Rome, where he lectured on Arabic, Syriac, Aramaic, philosophy and theology. Together with Joseph Assemani he participated in the famous Lebanese Council of 1736 at the monastery of Our Lady of Luwayza. In 1748 he went to Spain and was employed in the royal library at Madrid. He was successively appointed a member of the Royal Academy of History, interpreter of oriental languages to the king, and joint-librarian at the Escorial.", "wikipedia_url": "https://en.wikipedia.org/wiki/Miguel_Casiri"}}, {"canonical_name": "conde de Redondo", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "conde_de_redondo", "book_id": "coloquios_da_orta_1563", "name": "conde de Redondo", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["conde de Redondo"], "contexts": ["recipient of ode", "Viceroy of India"]}, {"entity_id": "senhor_conde_do_redondo", "book_id": "polyanthea_medicinal", "name": "Senhor Conde do Redondo", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Senhor Conde do Redondo"], "contexts": ["patron of remedy making"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "conde de Redondo", "target_book": "polyanthea_medicinal", "target_name": "Senhor Conde do Redondo", "similarity": 0.939}], "id": 1371, "stable_key": "clu_51ed3d27aec7a9db", "ground_truth": {"modern_name": "Count of Redondo", "confidence": "high", "type": "person", "description": "Noble patron associated with remedy making", "note": "Specific individual not readily identifiable without more context.", "wikidata_id": "Q9843838", "wikidata_description": "noble title in the Kingdom of Portugal", "wikipedia_extract": "Count of Redondo (Portuguese: Conde de Redondo) was a Portuguese title of nobility created by a royal decree, in 1481, by King Manuel I of Portugal, and granted to D. Vasco Coutinho, the son of Fernando Coutinho, Marshall of Portugal. Duarte de Castelo Branco, 7th Count of Redondo Francisco de Castelo Branco, 8th Count of Redondo Fernão de Sousa de Castelo Branco Coutinho e Meneses, 10th Count of Redondo Tomé de Sousa Coutinho Castelo Branco e Meneses, 11th Count of Redondo Fernando de Sousa Coutinho, 12th Count of Redondo Tomé Xavier de Sousa Coutinho de Castelo Branco e Meneses, 13th Count of Redondo, 1st Marquis of Borba Fernando Maria de Sousa Coutinho, 14th Count of Redondo, 2nd Marquis of Borba José Luís Gonzaga de Sousa Coutinho Castelo Branco e Meneses, 15th Count of Redondo Fernando Luís de Sousa Coutinho Castelo Branco e Meneses, 16th Count of Redondo, 3rd Marquis of Borba Fernando José Luís Burnay de Sousa Coutinho, 17th Count of Redondo (1883–1945); António Luís Carvalho de Sousa Coutinho, 18th Count of Redondo (1925-2007); 7th Marquis of Valença, 4th Marquis of Borba, 15th Count of Vimioso, 8th Count of Soure; Fernando Patrício de Portugal de Sousa Coutinho, 19th Count of Redondo (1956), 8th Marquis of Valença, 6th Marquis of Borba, 16th Count of Vimioso, 9th Count of Soure? The family owned a number of properties throughout Portugal. Amongst the more well-known properties are the Palace of the Counts of Redondo in Lisbon, and the Quinta do Relógio in Sintra."}}, {"canonical_name": "Ozus", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "ozus", "book_id": "coloquios_da_orta_1563", "name": "Ozus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Ozus"], "contexts": ["alternative name for Amu-Daria", "alternative name for Amu-Daria river"]}, {"entity_id": "ozark", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Ozark", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Ozark"], "contexts": ["Ozark"]}, {"entity_id": "otuz", "book_id": "relation_historique_humboldt_vol3_1825", "name": "OTUZ", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["OTUZ"], "contexts": ["location of rock formations"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Ozus", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Ozark", "similarity": 0.841}, {"source_book": "coloquios_da_orta_1563", "source_name": "Ozus", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "OTUZ", "similarity": 0.847}], "id": 1372, "stable_key": "clu_7b9eba756fce5935", "ground_truth": {"modern_name": "Amu Darya", "confidence": "medium", "type": "place", "country": "Afghanistan, Uzbekistan, Turkmenistan, Tajikistan, Iran", "note": "The presence of 'Ozark' and 'OTUZ' suggests a potential confusion or multiple, unrelated referents. Amu Darya is the most likely historical geographical term based on 'Ozus'.", "wikidata_id": "Q1507886", "wikidata_description": "species of fish", "wikipedia_extract": "The Amu Darya, historically known as the Oxus, is a major river in Central Asia which flows through Afghanistan, Tajikistan, Turkmenistan, and Uzbekistan. Rising in the Pamir Mountains, north of the Hindu Kush, the Amu Darya is formed by the confluence of the Vakhsh and Panj rivers, in the Tigrovaya Balka Nature Reserve on the border between Afghanistan and Tajikistan, and flows from there north-westwards into the southern remnants of the Aral Sea. However, today the Amu Darya does not reach the Aral Sea, and its mouth is in a dried-up area, of what was once the Aral Sea. In its upper course, the river forms part of Afghanistan's northern border with Tajikistan, Uzbekistan, and Turkmenistan. In ancient history, the river was regarded as the boundary of Greater Iran with Turan, which roughly corresponded to present-day Central Asia. The Amu Darya has a flow of about 70 cubic kilometres per year on average.", "wikipedia_url": "https://en.wikipedia.org/wiki/Amu_Darya_sturgeon"}}, {"canonical_name": "Asiatieal researches", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "asiatieal_researches", "book_id": "coloquios_da_orta_1563", "name": "Asiatieal researches", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["Asiatieal researches", "Asiati'cal researches", "Asiatic researches"], "contexts": ["publication title", "publication where sir William Jones is cited"]}, {"entity_id": "asiatic_researches", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Asiatic Researches", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Asiatic Researches"], "contexts": ["publication containing scientific results"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Asiatieal researches", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Asiatic Researches", "similarity": 0.978}], "id": 1373, "stable_key": "clu_5a8c17122c9c9d3c", "ground_truth": {"modern_name": "Asiatic Researches", "confidence": "high", "type": "text", "wikidata_id": "Q5708276", "wikidata_description": "journal, 1788-1839", "wikipedia_extract": "Cholera () is an infection of the small intestine by some strains of the bacterium Vibrio cholerae. Symptoms may range from none, to mild, to severe. The classic symptom is large amounts of watery diarrhea lasting a few days. Vomiting and muscle cramps may also occur. Diarrhea can be so severe that it leads within hours to severe dehydration and electrolyte imbalance. This can in turn result in sunken eyes, cold or cyanotic skin, decreased skin elasticity, wrinkling of the hands and feet, and, in severe cases, death.", "wikipedia_url": "https://es.wikipedia.org/wiki/Asiatic_Researches"}}, {"canonical_name": "Biblia", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "biblia", "book_id": "coloquios_da_orta_1563", "name": "Biblia", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["Biblia"], "contexts": ["contains passages about disease", "religious text mentioning incense"]}, {"entity_id": "bibl__univ_", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bibl. univ.", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Bibl. univ."], "contexts": ["publication title"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Biblia", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Bibl. univ.", "similarity": 0.9}], "id": 1374, "stable_key": "clu_397fffeabd8c5553", "ground_truth": {"modern_name": "Bible", "confidence": "high", "type": "text", "wikipedia_extract": "The Bible is a collection of religious texts that are central to Christianity and Judaism, and esteemed in other Abrahamic religions such as Islam. The Bible is an anthology (a compilation of texts of a variety of forms) originally written in Hebrew (with some parts in Aramaic) and Koine Greek. The texts include instructions, stories, poetry, prophecies, and other genres. The collection of materials accepted as part of the Bible by a particular religious tradition or community is called a biblical canon. Believers generally consider it to be a product of divine inspiration, but the way they understand what that means and how they interpret the text varies. The religious texts, or scriptures, were compiled by different religious communities into various official collections."}}, {"canonical_name": "San Fernando", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "san_fernando", "book_id": "relation_historique_humboldt_vol3_1825", "name": "San Fernando", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["San Fernando"], "contexts": ["battery for port defense", "mission name"]}, {"entity_id": "san_filippe", "book_id": "ricettario_fiorentino_1597", "name": "San Filippe", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["San Filippe"], "contexts": ["location of medicinal baths"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "San Fernando", "target_book": "ricettario_fiorentino_1597", "target_name": "San Filippe", "similarity": 0.848}], "id": 1375, "stable_key": "clu_b4e4637d3cb607d4", "ground_truth": {"modern_name": "San Fernando", "confidence": "high", "type": "place", "country": "Spain", "note": "Multiple places share this name; context from the original texts would refine this.", "wikidata_id": "Q2241864", "wikidata_description": "city in Buenos Aires Province, Argentina", "wikipedia_extract": "The San Fernando Valley, known locally as the Valley, is an urbanized valley in Los Angeles County, California. Situated to the north of the Los Angeles Basin, it comprises a large portion of Los Angeles, the incorporated cities of Burbank, Calabasas, Glendale, Hidden Hills and San Fernando, plus several unincorporated areas. The valley is the home of Warner Bros. Studios, Walt Disney Studios, and the Universal Studios Hollywood theme park. The valley of San Fernando is an area of 260 square miles (670 km2), bounded by the San Gabriel Mountains in the northeast, the Verdugo Mountains in the east, the Santa Monica Mountains and Chalk Hills in the south, the Simi Hills in the west, and the Santa Susana Mountains in the northwest. The northern Sierra Pelona Mountains, northwestern Topatopa Mountains, southern Santa Ana Mountains, and Downtown Los Angeles skyscrapers can be seen from higher neighborhoods, passes, roads and parks in the San Fernando Valley.", "wikipedia_url": "https://en.wikipedia.org/wiki/San_Fernando%2C_Buenos_Aires"}}, {"canonical_name": "plumbea", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "plumbea", "book_id": "polyanthea_medicinal", "name": "plumbea", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["plumbea"], "contexts": ["lead, to be avoided in vessels", "lead, used in vessels"]}, {"entity_id": "plumbago", "book_id": "connexion_physical_sciences_somerville_1858", "name": "plumbago", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["plumbago"], "contexts": ["reflected light shows elliptical polarization", "renders non-conductor conducting for metal"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "plumbea", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "plumbago", "similarity": 0.958}], "id": 1376, "stable_key": "clu_394a012a18ab03fb", "ground_truth": {"modern_name": "Lead", "confidence": "high", "type": "mineral", "note": "While 'plumbago' can refer to the plant genus Plumbago (leadwort), in the context of avoiding it in vessels and reflected light polarization, it strongly points to the mineral lead (Pb).", "wikidata_id": "Q708", "wikidata_description": "chemical element with symbol Pb and atomic number 82", "wikipedia_url": "https://en.wikipedia.org/wiki/Lead"}}, {"canonical_name": "Valladolid", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "valladolid", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Valladolid", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Valladolid", "Valladolid de Mechoacan"], "contexts": ["intendancy in Nouvelle-Espagne", "city in New Spain"]}, {"entity_id": "valladolid", "book_id": "polyanthea_medicinal", "name": "Valladolid", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Valladolid"], "contexts": ["location of professorship"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Valladolid", "target_book": "polyanthea_medicinal", "target_name": "Valladolid", "similarity": 1.0}], "id": 1377, "stable_key": "clu_cf1af73a0a5822d0", "ground_truth": {"wikipedia_extract": "Valladolid ( VAL-ə-də-LID; Spanish: [baʎaðoˈlið] ) is a city in Spain and the largest city as well as primary seat of government and de facto capital of the autonomous community of Castile and León. It is also the capital of the province of Valladolid. With a population of 299,816, it is the 13th largest municipality in Spain. The city is located roughly in the centre of the northern half of the Iberian Peninsula's Meseta Central, at the confluence of the Pisuerga and Esgueva rivers 15 km (9.3 mi) before they join the Duero, surrounded by winegrowing areas. The area was settled in pre-Roman times by the Celtic Vaccaei people, and then by Romans themselves. The settlement was purportedly founded after 1072, growing in prominence within the context of the Crown of Castile, being endowed with fairs and different institutions such as a collegiate church, University (1241), Royal Court and Chancellery and a royal mint."}}, {"canonical_name": "Cano", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "cano", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cano", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Cano", "Canoa"], "contexts": ["parish name", "parish in Cuba"]}, {"entity_id": "cano_real", "book_id": "polyanthea_medicinal", "name": "cano Real", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["cano Real"], "contexts": ["location patient went to at night"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cano", "target_book": "polyanthea_medicinal", "target_name": "cano Real", "similarity": 0.812}], "id": 1378, "stable_key": "clu_3bd4806d0e5863ce", "ground_truth": {"wikipedia_extract": "Cano is a surname of Spanish origin."}}, {"canonical_name": "Occull.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "occull_", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Occull.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Occull.", "Occu/f."], "contexts": ["occultation"]}, {"entity_id": "oculatam", "book_id": "polyanthea_medicinal", "name": "oculatam", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["oculatam"], "contexts": ["Latin for 'having eyes'"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Occull.", "target_book": "polyanthea_medicinal", "target_name": "oculatam", "similarity": 0.844}], "id": 1379, "stable_key": "clu_cc025fd83ca0654b", "ground_truth": {"modern_name": "Occultation", "confidence": "high", "type": "concept", "note": "'Occull.' is a clear abbreviation for occultation, a astronomical event. 'oculatam' (Latin for 'having eyes') is a less direct link but could relate to observation.", "wikidata_id": "Q30301727", "wikidata_description": "process of preventing observation of something"}}, {"canonical_name": "Serralheyros", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "serralheyros", "book_id": "polyanthea_medicinal", "name": "Serralheyros", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Serralheyros", "Serqueyra", "Serralheyro"], "contexts": ["sawyers, a profession associated with dust and exertion", "person treated"]}, {"entity_id": "serranos", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Serranos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Serranos"], "contexts": ["name for mountain dwellers"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Serralheyros", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Serranos", "similarity": 0.88}], "id": 1380, "stable_key": "clu_18269338743d3c61", "ground_truth": {"modern_name": "Sawyer", "confidence": "high", "type": "person", "description": "A profession associated with woodworking and potential dust exposure.", "note": "The context of dust and exertion points to 'sawyers' as a profession. 'Serranos' can refer to mountain dwellers, but the primary context aligns with the occupation.", "wikidata_id": "Q1124183", "wikidata_description": "worker who performs the initial harvesting of trees", "wikipedia_url": "https://en.wikipedia.org/wiki/Lumberjack", "wikipedia_extract": "Lumberjack is a mostly North American term for workers in the logging industry who perform the initial harvesting and transport of trees. The term usually refers to loggers in the era before 1945 in the United States, when trees were felled using hand tools and dragged by oxen to rivers. The work was difficult, dangerous, intermittent, low-paying, and involved living in primitive conditions. However, the men built a traditional culture that celebrated strength, masculinity, confrontation with danger, and resistance to modernization. The term lumberjack is of Canadian derivation. The first attested use of the term combining its two components comes from an 1831 letter to the Cobourg, Ontario, Star and General Advertiser in the following passage: \"my misfortunes have been brought upon me chiefly by an incorrigible, though perhaps useful, race of mortals called lumberjacks, whom, however, I would name the Cossacks of Upper Canada, who, having been reared among the oaks and pines of the wild forest, have never been subjected to the salutary restraint of laws.\" The term lumberjack is primarily historical, and of colloquial contemporary usage; logger is commonly used by workers in the 21st century."}}, {"canonical_name": "Galera", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "galera", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Galera", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Galera", "Galera Zamba", "la Galera"], "contexts": ["rocky wall", "islands opposite the coast"]}, {"entity_id": "galleries", "book_id": "connexion_physical_sciences_somerville_1858", "name": "galleries", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["galleries"], "contexts": ["horizontal passages in mines"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Galera", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "galleries", "similarity": 0.912}], "id": 1381, "stable_key": "clu_a0377aa87e53d2b8", "ground_truth": {"modern_name": "Mine gallery", "confidence": "high", "type": "place", "note": "Context of mines and passages strongly suggests 'mine gallery'.", "wikipedia_extract": "An adit (from Latin aditus, entrance) or stulm is a horizontal or nearly horizontal passage to an underground mine. Miners can use adits for access, drainage, ventilation, and extracting minerals at the lowest convenient level. Adits are also used to explore for mineral veins. Although most strongly associated with mining, the term adit is sometimes also used in the context of underground excavation for non-mining purposes; for example, to refer to smaller underground passageways excavated for underground metro systems, to provide pedestrian access to stations (pedestrian adits), and for access required during construction (construction adits). Adits are driven into the side of a hill or mountain, and are often used when an ore body  is located inside the mountain but above the adjacent valley floor or coastal plain. In cases where the mineral vein outcrops at the surface, the adit may follow the lode or vein until it is worked out, in which case the adit is rarely straight."}}, {"canonical_name": "Bali", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "bali", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bali", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Bali", "Baliamas"], "contexts": ["island in Indonesia", "islands mentioned in relation to Gulf-stream"]}, {"entity_id": "bali", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bali", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Bali"], "contexts": ["island where catastrophe occurred in 1808", "location of volcanic eruption"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bali", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bali", "similarity": 1.0}], "id": 1382, "stable_key": "clu_8cef345e6dbe00ff", "ground_truth": {"modern_name": "Bali", "confidence": "high", "type": "place", "country": "Indonesia"}}, {"canonical_name": "meduses", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "meduses", "book_id": "relation_historique_humboldt_vol3_1825", "name": "meduses", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["meduses", "méduses"], "contexts": ["marine creatures covering the sea surface", "marine animals that phosphoresce"]}, {"entity_id": "medusa", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Medusa", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Medusa"], "contexts": ["tribes noted for phosphorescent brilliancy"]}, {"entity_id": "medusa_tribes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Medusa tribes", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Medusa tribes"], "contexts": ["marine animals with phosphorescent brilliancy"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "meduses", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Medusa", "similarity": 0.947}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "meduses", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Medusa tribes", "similarity": 0.856}], "id": 1383, "stable_key": "clu_cbd4ff4fcb2a4b54", "ground_truth": {"modern_name": "Jellyfish", "confidence": "high", "type": "animal", "note": "Both 'meduses' (French/Portuguese) and 'Medusa' refer to jellyfish, especially with the context of marine creatures and phosphorescence.", "wikidata_id": "Q30178", "wikidata_description": "soft-bodied, aquatic invertebrates", "wikipedia_extract": "The lion's mane jellyfish (Cyanea capillata) is one of the largest known species of jellyfish. Its range is confined to cold, boreal waters of the Arctic, northern Atlantic, and northern Pacific Oceans. It is common in the English Channel, Irish Sea, North Sea, and in western Scandinavian waters south to Kattegat and Øresund. It may also drift into the southwestern part of the Baltic Sea (where it cannot breed due to the low salinity). Similar jellyfish – which may be the same species – are known to inhabit seas near Australia and New Zealand. The largest recorded specimen was measured off the coast of Massachusetts in 1865 and had a bell with a diameter of 210 centimetres (7 feet) and tentacles around 36.6 m (120 ft) long.", "wikipedia_url": "https://en.wikipedia.org/wiki/Lion's_mane_jellyfish"}}, {"canonical_name": "Aleutian Islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "aleutian_islands", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Aleutian Islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Aleutian Islands"], "contexts": ["islands in the North Pacific", "islands between Asia and America"]}, {"entity_id": "îles_aleutes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "îles Aleutes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["îles Aleutes"], "contexts": ["island chain"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Aleutian Islands", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "îles Aleutes", "similarity": 0.906}], "id": 1384, "stable_key": "clu_caf0413f35bdbeb4", "ground_truth": {"modern_name": "Aleutian Islands", "confidence": "high", "type": "place", "country": "United States", "note": "The French 'îles Aleutes' clearly refers to the Aleutian Islands.", "wikipedia_extract": "The Aleutian Islands (   ə-LOO-shən; Russian: Алеутские острова, romanized: Aleutskiye ostrova; Aleut: Unangam Tanangin, \"land of the Aleuts\"; possibly from the Chukchi aliat, or \"island\")—also called the Aleut Islands, Aleutic Islands, or, before the Alaska Purchase in 1867, the Catherine Archipelago—are a chain of 14 main, larger volcanic islands and 55 smaller ones. Most of the islands belong to the U.S. state of Alaska, with the archipelago encompassing the Aleutians West Census Area and the Aleutians East Borough. The Commander Islands, located further to the west, belong to the Russian federal subject of Kamchatka Krai, of the Russian Far East. The islands form part of the Aleutian Arc of the Northern Pacific Ocean, and occupy a land area of 6,821 sq mi (17,666 km2) that extends westward roughly 1,200 mi (1,900 km) from the Alaska Peninsula mainland, in the direction of the Kamchatka Peninsula; the archipelago acts as a border between the Bering Sea to the north and the Pacific Ocean to the south. Crossing longitude 180°, at which point east and west longitude end, the archipelago contains both the westernmost and easternmost parts of the United States, by longitude (Amatignak Island and Semisopochnoi Island, respectively). The westernmost U.S. island, in real terms, however, is Attu Island, west of which runs the International Date Line."}}, {"canonical_name": "Harvard College", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "harvard_college", "book_id": "kosmos_humboldt_1845", "name": "Harvard College", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "count": 3, "variants": ["Harvard College"], "contexts": ["educational institution", "institution where Webster was"]}, {"entity_id": "harvard", "book_id": "principles_of_psychology_james_1890", "name": "Harvard", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "count": 1, "variants": ["Harvard"], "contexts": ["institution with photometric tables"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Harvard College", "target_book": "principles_of_psychology_james_1890", "target_name": "Harvard", "similarity": 0.939}], "id": 1385, "stable_key": "clu_33cfe3a29190379d", "ground_truth": {"modern_name": "Harvard University", "confidence": "high", "type": "organization", "wikidata_id": "Q49121", "wikidata_description": "medical school in Boston, Massachusetts", "wikipedia_extract": "The president of Harvard University is the chief administrator of Harvard University and the ex officio president of the Harvard Corporation. Each is appointed by and is responsible to the other members of that body, who delegate to the president the day-to-day running of the university. Harvard's current president is Alan Garber, who took office on January 2, 2024, following the resignation of Claudine Gay. In December 2025, the Harvard Corporation announced his term would be extended indefinitely. The president plays an important part in university-wide planning and strategy. Each names a faculty's dean (and, since the foundation of the office in 1994, the university's provost), and grants tenure to recommended professors.", "wikipedia_url": "https://en.wikipedia.org/wiki/Harvard_Medical_School"}}, {"canonical_name": "Demoniaco", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "demoniaco", "book_id": "polyanthea_medicinal", "name": "Demoniaco", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["Demoniaco", "demoniacas"], "contexts": ["demonic affliction", "condition associated with melancholic humor"]}, {"entity_id": "demoniacal_possession", "book_id": "principles_of_psychology_james_1890", "name": "demoniacal possession", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["demoniacal possession"], "contexts": ["initial explanation for woman's condition"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Demoniaco", "target_book": "principles_of_psychology_james_1890", "target_name": "demoniacal possession", "similarity": 0.874}], "id": 1386, "stable_key": "clu_124b614a1b4132cc", "ground_truth": {"modern_name": "Demonic Possession", "confidence": "high", "type": "disease", "modern_term": "Demonic Possession", "note": "The term 'demoniaco' in early modern Portuguese/Spanish texts often referred to conditions now understood as mental illnesses or neurological disorders, but the context here explicitly links it to 'demoniacal possession'.", "wikidata_id": "Q26155706", "wikidata_description": "Satanic possession of a human being or an animal by a fictitious malevolent spirit entity", "wikipedia_url": "https://en.wikipedia.org/wiki/Demonic_possession", "wikipedia_extract": "Edward Warren Miney (September 7, 1926 – August 23, 2006) and Lorraine Rita Warren (née Moran; January 31, 1927 – April 18, 2019) were American paranormal investigators and authors associated with prominent cases of alleged hauntings. Edward was a self-taught and self-professed demonologist, author, lecturer and artist. Lorraine professed to be clairvoyant and a light trance medium who worked closely with her husband. In 1952, the Warrens founded the New England Society for Psychic Research (NESPR), the oldest ghost-hunting group in New England. They authored many books about the paranormal and about their private investigations into various reports of paranormal activity. They claimed to have investigated well over 10,000 cases during their career."}}, {"canonical_name": "nebula", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "nebula", "book_id": "principles_of_psychology_james_1890", "name": "nebula", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["nebula"], "contexts": ["cloud of gas and dust in space"]}, {"entity_id": "nebulosity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "nebulosity", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["nebulosity"], "contexts": ["diffuse cloud around comet nucleus", "diffuse cloud-like celestial matter"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "nebula", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nebulosity", "similarity": 0.89}], "id": 1387, "stable_key": "clu_8089585ecba540ba", "ground_truth": {"modern_name": "Nebula", "confidence": "high", "type": "place", "note": "Refers to astronomical nebulae, vast clouds of gas and dust in space, or in older contexts, any diffuse, cloud-like celestial object.", "wikidata_id": "Q6985278", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Nebula%20%28moth%29", "wikipedia_extract": "A nebula (Latin for 'cloud, fog'; pl. nebulae or nebulas) is a distinct luminescent part of interstellar medium, which can consist of ionized, neutral, or molecular hydrogen and also cosmic dust. Nebulae are often star-forming regions, such as the Pillars of Creation in the Eagle Nebula. In these regions, the formations of gas, dust, and other materials \"clump\" together to form denser regions, which attract further matter and eventually become dense enough to form stars. The remaining material is then thought to form planets and other planetary system objects. Most nebulae are of vast size; some are hundreds of light-years in diameter. A nebula that is visible to the human eye from Earth would appear larger, but no brighter, from close by."}}, {"canonical_name": "auditory nerve", "category": "ANATOMY", "subcategory": "TISSUE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "auditory_nerve", "book_id": "principles_of_psychology_james_1890", "name": "auditory nerve", "category": "ANATOMY", "subcategory": "TISSUE", "count": 2, "variants": ["auditory nerve"], "contexts": ["nerve transmitting sound signals", "nerve for hearing"]}, {"entity_id": "auditory_nerves", "book_id": "connexion_physical_sciences_somerville_1858", "name": "auditory nerves", "category": "ANATOMY", "subcategory": "TISSUE", "count": 2, "variants": ["auditory nerves"], "contexts": ["nerves transmitting sound signals", "nerves that transmit sound signals"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "auditory nerve", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "auditory nerves", "similarity": 0.988}], "id": 1388, "stable_key": "clu_baa24e7d0e43306b", "ground_truth": {"modern_name": "Auditory Nerve", "confidence": "high", "type": "anatomy", "wikidata_id": "Q2519137", "wikidata_description": "nerve carrying auditory information from the inner ear to the brain", "wikipedia_url": "https://en.wikipedia.org/wiki/Cochlear_nerve", "wikipedia_extract": "The cochlear nerve (also auditory nerve or acoustic nerve) is one of two parts of the vestibulocochlear nerve, a cranial nerve present in amniotes, the other part being the vestibular nerve. The cochlear nerve carries auditory sensory information from the cochlea of the inner ear directly to the brain. The other portion of the vestibulocochlear nerve is the vestibular nerve, which carries spatial orientation information to the brain from the semicircular canals, also known as semicircular ducts. In terms of anatomy, an auditory nerve fiber is either bipolar or unipolar, with its distal projection being called the peripheral process, and its proximal projection being called the axon; these two projections are also known as the \"peripheral axon\" and the \"central axon\", respectively. The peripheral process is sometimes referred to as a dendrite, although that term is somewhat inaccurate. Unlike the typical dendrite, the peripheral process generates and conducts action potentials, which then \"jump\" across the cell body (or soma) and continue to propagate along the central axon."}}, {"canonical_name": "pulse of thought", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "pulse_of_thought", "book_id": "principles_of_psychology_james_1890", "name": "pulse of thought", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["pulse of thought"], "contexts": ["individual unit of thought", "mental process of knowing and comparing"]}, {"entity_id": "pulse", "book_id": "connexion_physical_sciences_somerville_1858", "name": "pulse", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["pulse"], "contexts": ["a single beat or impulse"]}, {"entity_id": "pulses", "book_id": "connexion_physical_sciences_somerville_1858", "name": "pulses", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["pulses"], "contexts": ["brief, localized waves"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "pulse of thought", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "pulse", "similarity": 0.876}, {"source_book": "principles_of_psychology_james_1890", "source_name": "pulse of thought", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "pulses", "similarity": 0.856}], "id": 1389, "stable_key": "clu_10a4249cb1e19c8b", "ground_truth": {"modern_name": "Thought Impulse", "confidence": "medium", "type": "concept", "note": "The 'pulse of thought' is metaphorical. It refers to discrete, sequential units of cognition or mental activity, akin to individual impulses or waves of mental energy, not a literal physiological pulse."}}, {"canonical_name": "heart-beats", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "heart-beats", "book_id": "principles_of_psychology_james_1890", "name": "heart-beats", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 3, "variants": ["heart-beats"], "contexts": ["rhythmic contractions of the heart"]}, {"entity_id": "heart’s_action", "book_id": "first_principles_spencer_1862", "name": "heart’s action", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["heart’s action"], "contexts": ["pumping function of the heart"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "heart-beats", "target_book": "first_principles_spencer_1862", "target_name": "heart’s action", "similarity": 0.87}], "id": 1390, "stable_key": "clu_f3872cbc8232bcce", "ground_truth": {"modern_name": "Heartbeat", "confidence": "high", "type": "anatomy"}}, {"canonical_name": "melody", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "melody", "book_id": "principles_of_psychology_james_1890", "name": "melody", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["melody"], "contexts": ["sequence of musical notes"]}, {"entity_id": "melody", "book_id": "first_principles_spencer_1862", "name": "melody", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["melody"], "contexts": ["musical composition", "sequence of musical notes"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "melody", "target_book": "first_principles_spencer_1862", "target_name": "melody", "similarity": 1.0}], "id": 1391, "stable_key": "clu_50237c451963b635", "ground_truth": {"modern_name": "Melody", "confidence": "high", "type": "concept", "wikidata_id": "Q3854288", "wikidata_description": "female given name", "wikipedia_extract": "A melody (from Greek  μελῳδία (melōidía) 'singing, chanting'), also tune, voice, or line, is a linear succession of musical tones that the listener perceives as a single entity. In its most literal sense, a melody is a combination of pitch and rhythm, while more figuratively, the term can include other musical elements such as tonal color. It is the foreground to the background accompaniment. A line or part need not be a foreground melody. Melodies often consist of one or more musical phrases or motifs, and are usually repeated throughout a composition in various forms. Melodies may also be described by their melodic motion or the pitches or the intervals between pitches (predominantly conjunct or disjunct or with further restrictions), pitch range, tension and release, continuity and coherence, cadence, and shape."}}, {"canonical_name": "Kantian Philosophy", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "kantian_philosophy", "book_id": "principles_of_psychology_james_1890", "name": "Kantian Philosophy", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "count": 1, "variants": ["Kantian Philosophy"], "contexts": ["philosophy of Immanuel Kant"]}, {"entity_id": "kantian", "book_id": "principles_of_psychology_james_1890", "name": "Kantian", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "count": 1, "variants": ["Kantian"], "contexts": ["speculation of Kant"]}, {"entity_id": "kantian_doctrine", "book_id": "first_principles_spencer_1862", "name": "Kantian doctrine", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "count": 1, "variants": ["Kantian doctrine"], "contexts": ["philosophical doctrine about space and time"]}, {"entity_id": "kantist", "book_id": "first_principles_spencer_1862", "name": "Kantist", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "count": 1, "variants": ["Kantist"], "contexts": ["follower of Immanuel Kant's philosophy"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Kantian Philosophy", "target_book": "first_principles_spencer_1862", "target_name": "Kantian doctrine", "similarity": 0.962}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Kantian Philosophy", "target_book": "first_principles_spencer_1862", "target_name": "Kantist", "similarity": 0.892}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Kantian", "target_book": "first_principles_spencer_1862", "target_name": "Kantian doctrine", "similarity": 0.948}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Kantian", "target_book": "first_principles_spencer_1862", "target_name": "Kantist", "similarity": 0.913}], "id": 1392, "stable_key": "clu_9cfe0971f73a9eef", "ground_truth": {"modern_name": "Kantian Philosophy", "confidence": "high", "type": "concept", "wikidata_id": "Q128820042", "wikidata_description": "scholarly article"}}, {"canonical_name": "Schiraz", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "schiraz", "book_id": "coloquios_da_orta_1563", "name": "Schiraz", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Schiraz"], "contexts": ["city where Miguel Ferreira was received", "origin of weight unit"]}, {"entity_id": "schiraz", "book_id": "kosmos_humboldt_1845", "name": "Schiraz", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Schiraz"], "contexts": ["location of observations"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Schiraz", "target_book": "kosmos_humboldt_1845", "target_name": "Schiraz", "similarity": 1.0}], "id": 1393, "stable_key": "clu_2182de894491f4ae", "ground_truth": {"modern_name": "Shiraz", "confidence": "high", "type": "place", "country": "Iran", "wikipedia_extract": "Shiraz is the fifth-most-populous city of Iran and the capital of Fars province, which is historically known by the exonym Persia proper. As of the 2016 national census, the population of the city was 1,565,572 people, and its built-up area with Sadra was home to almost 1,800,000 inhabitants. A census in 2021 showed an increase in the city's population to 1,995,500 people. Shiraz is located in southwestern Iran on the rudkhaneye khoshk (lit. 'dry river') seasonal river. The city has a moderate climate and has been a regional trade center for over a thousand years. The earliest reference to the city, as Tiraziš, is on Elamite clay tablets dated to 2000 BCE."}}, {"canonical_name": "Kachmira", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "kachmira", "book_id": "coloquios_da_orta_1563", "name": "Kachmira", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Kachmira", "Kach-mira"], "contexts": ["valleys where the costus plant was found", "region"]}, {"entity_id": "cashmir", "book_id": "kosmos_humboldt_1845", "name": "Cashmir", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Cashmir"], "contexts": ["region destroyed by earthquake in 1554"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Kachmira", "target_book": "kosmos_humboldt_1845", "target_name": "Cashmir", "similarity": 0.845}], "id": 1394, "stable_key": "clu_2ea7d4c3c66834ec", "ground_truth": {"modern_name": "Kashmir", "confidence": "high", "type": "place", "country": "India", "wikidata_id": "Q720403", "wikidata_description": "city in Razavi Khorasan Province, Iran", "wikipedia_url": "https://en.wikipedia.org/wiki/Kashmar"}}, {"canonical_name": "birches", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "birches", "book_id": "kosmos_humboldt_1845", "name": "birches", "category": "PLANT", "subcategory": "TREE", "count": 3, "variants": ["birches"], "contexts": ["tree species in Himalaya", "dwarf and tall stemmed trees"]}, {"entity_id": "birch", "book_id": "connexion_physical_sciences_somerville_1858", "name": "birch", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["birch"], "contexts": ["deciduous tree with distinctive bark"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "birches", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "birch", "similarity": 0.971}], "id": 1395, "stable_key": "clu_6e7d9c7303035b13", "ground_truth": {"modern_name": "Birch", "confidence": "high", "type": "plant", "linnaean": "Betula L.", "family": "Betulaceae", "wikidata_id": "Q25243", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Birch", "wikipedia_extract": "A birch is a thin-leaved deciduous hardwood tree of the genus Betula (), in the family Betulaceae, which also includes alders, hazels, and hornbeams. It is closely related to the beech-oak family Fagaceae. The genus Betula contains 30 to 60 known taxa of which 11 are on the IUCN 2011 Red List of Threatened Species. They are typically short-lived pioneer species and are widespread in the Northern Hemisphere, particularly in northern areas of temperate climates and in boreal climates. Birch wood is used for a wide range of purposes. Birch species are generally small to medium-sized trees or shrubs, mostly of northern temperate and boreal climates."}}, {"canonical_name": "Copenhagen", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "copenhagen", "book_id": "kosmos_humboldt_1845", "name": "Copenhagen", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Copenhagen"], "contexts": ["capital of Denmark", "city further north than Pekin"]}, {"entity_id": "copenhagen", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Copenhagen", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Copenhagen"], "contexts": ["location of Oersted's professorship"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Copenhagen", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Copenhagen", "similarity": 1.0}], "id": 1396, "stable_key": "clu_d385c9ed12386741", "ground_truth": {"modern_name": "Copenhagen", "confidence": "high", "type": "place", "country": "Denmark", "wikidata_id": "Q1748", "wikidata_description": "capital and largest city of Denmark", "wikipedia_url": "https://en.wikipedia.org/wiki/Copenhagen"}}, {"canonical_name": "Newtonian axiom", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "newtonian_axiom", "book_id": "kosmos_humboldt_1845", "name": "Newtonian axiom", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["Newtonian axiom"], "contexts": ["axiom about acceleration from earth's attraction", "fundamental principle of Newton"]}, {"entity_id": "newton’s_theory", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Newton’s theory", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["Newton’s theory"], "contexts": ["theory explaining tidal differences"]}, {"entity_id": "newtonian_theory", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Newtonian theory", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["Newtonian theory"], "contexts": ["theory of light velocity"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Newtonian axiom", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Newton’s theory", "similarity": 0.884}, {"source_book": "kosmos_humboldt_1845", "source_name": "Newtonian axiom", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Newtonian theory", "similarity": 0.901}], "id": 1397, "stable_key": "clu_58eb6da198a0fa21", "ground_truth": {"modern_name": "Newtonian mechanics", "confidence": "high", "type": "concept", "note": "Refers to the foundational principles of physics established by Isaac Newton, encompassing his laws of motion and universal gravitation.", "wikidata_id": "Q11397", "wikidata_description": "sub-field of mechanics, which is concerned with the set of physical laws describing the motion of bodies under the action of a system of forces", "wikipedia_url": "https://en.wikipedia.org/wiki/Classical%20mechanics", "wikipedia_extract": "Newton's laws of motion are three physical laws that describe the relationship between the motion of an object and the forces acting on it. These laws, which provide the basis for Newtonian mechanics, can be paraphrased as follows: A body remains at rest, or in motion at a constant speed in a straight line, unless it is acted upon by a force. At any instant of time, the net force on a body is equal to the body's acceleration multiplied by its mass or, equivalently, the rate at which the body's momentum is changing with time. If two bodies exert forces on each other, these forces have the same magnitude but opposite directions. The three laws of motion were first stated by Isaac Newton in his Philosophiæ Naturalis Principia Mathematica (Mathematical Principles of Natural Philosophy), originally published in 1687. Newton used them to investigate and explain the motion of many physical objects and systems."}}, {"canonical_name": "disks", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "disks", "book_id": "kosmos_humboldt_1845", "name": "disks", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 2, "variants": ["disks"], "contexts": ["round or elliptical shapes of nebulae", "apparent circular surface of planets"]}, {"entity_id": "disc", "book_id": "connexion_physical_sciences_somerville_1858", "name": "disc", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 2, "variants": ["disc"], "contexts": ["circular surface of the planet", "circular surface"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "disks", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "disc", "similarity": 0.96}], "id": 1398, "stable_key": "clu_619b68814d049610", "ground_truth": {"modern_name": "Disk", "confidence": "high", "type": "object", "note": "This term can refer to astronomical features (e.g., nebular disks) or biological/anatomical structures depending on context."}}, {"canonical_name": "negative electricity", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "negative_electricity", "book_id": "kosmos_humboldt_1845", "name": "negative electricity", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["negative electricity"], "contexts": ["type of electrical charge"]}, {"entity_id": "negative_electricity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Negative electricity", "category": "SUBSTANCE", "subcategory": "CHEMICAL", "count": 2, "variants": ["Negative electricity", "negative electricity"], "contexts": ["type of electrical charge", "defined, mode of exciting"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "negative electricity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Negative electricity", "similarity": 0.875}], "id": 1399, "stable_key": "clu_222247566d528e1b", "ground_truth": {"modern_name": "Negative electric charge", "confidence": "high", "type": "concept", "note": "Refers to the type of electrical charge carried by electrons.", "wikipedia_extract": "In economics, negative pricing can occur when demand for a product drops or supply increases to an extent that owners or suppliers are prepared to pay others to accept it, in effect setting the price to a negative number. This can happen because it costs money to transport, store, and dispose of a product even when there is little demand to buy it, or because halting production would be more expensive than selling at a negative price. Negative prices are usual for waste such as garbage and nuclear waste. For example, a nuclear power plant may \"sell\" radioactive waste to a processing facility for a negative price; in other words, the power plant is paying the processing facility to take the unwanted radioactive waste. The phenomenon can also occur in energy prices, including electricity prices, natural gas prices, and oil prices. Natural gas prices in the Permian Basin, West Texas, went below zero for the first time in 2019.", "wikipedia_url": "https://en.wikipedia.org/wiki/Negative_pricing"}}, {"canonical_name": "measurement", "category": "PRACTICE", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "measurement", "book_id": "connexion_physical_sciences_somerville_1858", "name": "measurement", "category": "PRACTICE", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["measurement"], "contexts": ["act of determining quantity", "inaccuracy from local attraction"]}, {"entity_id": "measuring", "book_id": "kosmos_humboldt_1845", "name": "measuring", "category": "PRACTICE", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["measuring"], "contexts": ["process for determining mean values"]}, {"entity_id": "thermometrical_measurements", "book_id": "kosmos_humboldt_1845", "name": "thermometrical measurements", "category": "PRACTICE", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["thermometrical measurements"], "contexts": ["method for measuring temperature"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "measurement", "target_book": "kosmos_humboldt_1845", "target_name": "measuring", "similarity": 0.974}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "measurement", "target_book": "kosmos_humboldt_1845", "target_name": "thermometrical measurements", "similarity": 0.854}], "id": 1400, "stable_key": "clu_98dbb10a7e236c3a", "ground_truth": {"modern_name": "Measurement", "confidence": "high", "type": "concept", "note": "The act or process of assigning a numerical value to a quantity.", "wikipedia_extract": "Measurement is the quantification of attributes of an object or event, which can be used to compare with other objects or events. In other words, measurement is a process of determining how large or small a physical quantity is as compared to a basic reference quantity of the same kind. The scope and application of measurement are dependent on the context and discipline. In natural sciences and engineering, measurements do not apply to nominal properties of objects or events, which is consistent with the guidelines of the International Vocabulary of Metrology (VIM) published by the International Bureau of Weights and Measures (BIPM). However, in other fields such as statistics as well as the social and behavioural sciences, measurements can have multiple levels, which would include nominal, ordinal, interval and ratio scales. Measurement is a cornerstone of trade, science, technology and quantitative research in many disciplines."}}, {"canonical_name": "octahedron", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "octahedron", "book_id": "connexion_physical_sciences_somerville_1858", "name": "octahedron", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["octahedron"], "contexts": ["geometric solid with eight faces"]}, {"entity_id": "octahedral_crystals", "book_id": "kosmos_humboldt_1845", "name": "octahedral crystals", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["octahedral crystals"], "contexts": ["crystal shape with eight faces"]}, {"entity_id": "octahedrons", "book_id": "connexion_physical_sciences_somerville_1858", "name": "octahedrons", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["octahedrons"], "contexts": ["eight-sided crystal forms"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "octahedron", "target_book": "kosmos_humboldt_1845", "target_name": "octahedral crystals", "similarity": 0.885}, {"source_book": "kosmos_humboldt_1845", "source_name": "octahedral crystals", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "octahedrons", "similarity": 0.903}], "id": 1401, "stable_key": "clu_1d35137ce4ea2998", "ground_truth": {"modern_name": "Octahedron", "confidence": "high", "type": "object", "note": "A polyhedron with eight faces, often referring to crystal structures.", "wikidata_id": "Q188884", "wikidata_description": "polyhedron with 8 faces"}}, {"canonical_name": "Ethnographical studies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "ethnographical_studies", "book_id": "kosmos_humboldt_1845", "name": "Ethnographical studies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["ethnographical studies", "Ethnographical studies"], "contexts": ["studies of human cultures and societies", "study of human cultures"]}, {"entity_id": "ethnology", "book_id": "first_principles_spencer_1862", "name": "Ethnology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Ethnology"], "contexts": ["study of human races"]}, {"entity_id": "ethnologic", "book_id": "first_principles_spencer_1862", "name": "ethnologic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ethnologic"], "contexts": ["related to the study of human races and cultures"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Ethnographical studies", "target_book": "first_principles_spencer_1862", "target_name": "Ethnology", "similarity": 0.92}, {"source_book": "kosmos_humboldt_1845", "source_name": "Ethnographical studies", "target_book": "first_principles_spencer_1862", "target_name": "ethnologic", "similarity": 0.897}], "id": 1402, "stable_key": "clu_213577d84f44d11e", "ground_truth": {"modern_name": "Ethnology", "confidence": "high", "type": "concept", "wikidata_id": "Q43455", "wikidata_description": "academic discipline", "wikipedia_url": "https://en.wikipedia.org/wiki/Ethnology", "wikipedia_extract": "Ethnology (from the Ancient Greek: ἔθνος, ethnos meaning 'nation') is an academic field and discipline that compares and analyzes the characteristics of different peoples and the relationships between them (compare cultural, social, or sociocultural anthropology). Compared to ethnography, the study of single groups through direct contact with the culture, ethnology takes the research that ethnographers have compiled and then compares and contrasts different cultures. The term ethnologia (ethnology) is credited to Adam Franz Kollár (1718–1783) who used and defined it in his Historiae ivrisqve pvblici Regni Vngariae amoenitates published in Vienna in 1783. as: \"the science of nations and peoples, or, that study of learned men in which they inquire into the origins, languages, customs, and institutions of various nations, and finally into the fatherland and ancient seats, in order to be able better to judge the nations and peoples in their own times.\" Kollár's interest in linguistic and cultural diversity was aroused by the situation in his native multi-ethnic and multilingual Kingdom of Hungary and his roots among its Slovaks, and by the shifts that began to emerge after the gradual retreat of the Ottoman Empire in the more distant Balkans. Among the goals of ethnology have been the reconstruction of human history, and the formulation of cultural invariants, such as the incest taboo and culture change, and the formulation of generalizations about \"human nature\", a concept which has been criticized since the 19th century by various philosophers (Hegel, Marx, structuralism, etc.). In some parts of the world, ethnology has developed along independent paths of investigation and pedagogical doctrine, with cultural anthropology becoming dominant especially in the United States, and social anthropology in Great Britain."}}, {"canonical_name": "Culebras", "category": "ANIMAL", "subcategory": "REPTILE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "culebras", "book_id": "historia_medicinal_monardes_1574", "name": "Culebras", "category": "ANIMAL", "subcategory": "REPTILE", "count": 3, "variants": ["Culebras", "culebra", "culebras"], "contexts": ["large snakes observed", "snakes eaten by deer"]}, {"entity_id": "culebra", "book_id": "coloquios_da_orta_1563", "name": "culebra", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["culebra"], "contexts": ["type of snake"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Culebras", "target_book": "coloquios_da_orta_1563", "target_name": "culebra", "similarity": 0.87}], "id": 1403, "stable_key": "clu_ad913a0d49b60c1f", "ground_truth": {"modern_name": "Snake", "confidence": "high", "type": "animal", "wikidata_id": "Q2102", "wikidata_description": "limbless, scaly, elongate reptile", "wikipedia_url": "https://en.wikipedia.org/wiki/Snake_(zodiac)", "wikipedia_extract": "The Snake (蛇) is the sixth of the twelve-year cycle of animals which appear in the Chinese zodiac related to the Chinese calendar. The Year of the Snake is associated with the Earthly Branch symbol 巳. Besides its use in the cycle of years, the zodiacal snake is otherwise used to also represent hours of the day. Snakes have a long and complicated place in Chinese mythology and culture. The same twelve animals are also used to symbolize the cycle of hours in the day, each being associated with a two-hour time period. The hour of the snake is 9:00 to 11:00 a.m., the time when the Sun warms up the Earth, and snakes are said to slither out of their holes."}}, {"canonical_name": "papagayos", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "papagayos", "book_id": "historia_medicinal_monardes_1574", "name": "papagayos", "category": "ANIMAL", "subcategory": "BIRD", "count": 3, "variants": ["papagayos", "Pagayos"], "contexts": ["parrot meat", "parrot meat eaten"]}, {"entity_id": "papagaios", "book_id": "coloquios_da_orta_1563", "name": "papagaios", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["papagaios"], "contexts": ["birds, parrots"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "papagayos", "target_book": "coloquios_da_orta_1563", "target_name": "papagaios", "similarity": 0.897}], "id": 1404, "stable_key": "clu_d08aec9fb366e9af", "ground_truth": {"wikipedia_extract": "Papagayos is a village in Chacabuco Department, San Luis Province, Argentina. Among the small towns that are at the feet of the Comechingones Mountains, Papagayos stands out by its particular landscape of caranday palms. It borders Villa Larca to the north, Tilisarao to the west, Villa del Carmen to the south and to the east, Córdoba Province. It has around 750 inhabitants. Its climate is mainly dry with a little summer precipitation. There are two theories about Papagayos' name."}}, {"canonical_name": "comer", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "comer", "book_id": "historia_medicinal_monardes_1574", "name": "comer", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["comer"], "contexts": ["mealtime", "eating"]}, {"entity_id": "comer", "book_id": "coloquios_da_orta_1563", "name": "comer", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["comer"], "contexts": ["act of eating"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "comer", "target_book": "coloquios_da_orta_1563", "target_name": "comer", "similarity": 1.0}], "id": 1405, "stable_key": "clu_6ebbdcf8ad973852", "ground_truth": {"modern_name": "Eating", "confidence": "high", "type": "concept", "wikidata_id": "Q213449", "wikidata_description": "ingestion of food to provide for all organisms their nutritional or medicinal needs", "wikipedia_url": "https://en.wikipedia.org/wiki/Eating"}}, {"canonical_name": "talparias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "talparias", "book_id": "polyanthea_medicinal", "name": "talparias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["talparias"], "contexts": ["ulcers, dissolved by mercury", "tumors or swellings"]}, {"entity_id": "taiparias", "book_id": "coloquios_da_orta_1563", "name": "taiparias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["taiparias"], "contexts": ["disease prevalent in the new land"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "talparias", "target_book": "coloquios_da_orta_1563", "target_name": "taiparias", "similarity": 0.908}], "id": 1406, "stable_key": "clu_1a0763fa1528326b", "ground_truth": {"modern_name": "Syphilis", "confidence": "high", "type": "disease", "modern_term": "Syphilis", "note": "The term 'talparias' (or 'taiparias') appears to refer to syphilitic ulcers, a common interpretation given the context of mercury treatment and prevalence in newly discovered lands during the early modern period.", "wikidata_id": "Q18966640", "wikidata_description": "human disease"}}, {"canonical_name": "Buey", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "buey", "book_id": "historia_medicinal_monardes_1574", "name": "Buey", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["buey", "Buey"], "contexts": ["ox"]}, {"entity_id": "buoi", "book_id": "ricettario_fiorentino_1597", "name": "buoi", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["buoi"], "contexts": ["oxen fertilized by Orobo herb", "animal whose bones are used"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Buey", "target_book": "ricettario_fiorentino_1597", "target_name": "buoi", "similarity": 0.928}], "id": 1407, "stable_key": "clu_7e2cd6a9b7aadb30", "ground_truth": {"wikipedia_extract": "Buey Arriba is a mountainous municipality and town in the Granma Province of Cuba. It is located in the northern part of the Sierra Maestra, 30 kilometres (19 mi) south of Bayamo, the provincial capital. When Spanish colonizers settled in this area, they encountered a peaceful mountain river with crystal-clear waters, but the sudden, heavy floods during the rainy season caused many disasters. The river's force was compared to that of an ox, giving it the name Buey (Spanish for ox). Today, it still bears the name Río Buey. Two settlements were founded on the banks of the Río Buey."}}, {"canonical_name": "abeto", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "abeto", "book_id": "ricettario_fiorentino_1597", "name": "abeto", "category": "PLANT", "subcategory": "TREE", "count": 3, "variants": ["abeto", "abete"], "contexts": ["material for good water vessels", "tree yielding resin"]}, {"entity_id": "abeto", "book_id": "historia_medicinal_monardes_1574", "name": "Abeto", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Abeto"], "contexts": ["tree from which turpentine is collected"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "abeto", "target_book": "historia_medicinal_monardes_1574", "target_name": "Abeto", "similarity": 0.864}], "id": 1408, "stable_key": "clu_d0fced123dca4cab", "ground_truth": {"wikipedia_extract": "Until the end of the Ethiopian monarchy in 1975, there were two categories of nobility in Ethiopia and Eritrea. The Mesafint (Ge'ez: መሳፍንት masāfint, modern transcription mesāfint, singular መስፍን masfin, modern mesfin, \"prince\"), the hereditary royal nobility, formed the upper echelon of the ruling class. The Mekwanint (Ge'ez: መኳንንት makʷanint, modern mekʷanint, singular መኰንን makʷanin, modern mekʷanin or Amharic: መኮንን mekonnen, \"officer\") were the appointed nobles, often of humble birth, who formed the bulk of the aristocracy. Until the 20th century, the most powerful people at court were generally members of the Mekwanint appointed by the monarch, while regionally, the Mesafint enjoyed greater influence and power. Emperor Haile Selassie greatly curtailed the power of the Mesafint to the benefit of the Mekwanint, who by then were essentially coterminous with the Ethiopian government. The Mekwanint were officials who had been granted specific offices in the Abyssinian government or court."}}, {"canonical_name": "Ebano", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "ebano", "book_id": "historia_medicinal_monardes_1574", "name": "Ebano", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["Ebano"], "contexts": ["wood brought from the Indies", "wood comparison for Guayaci"]}, {"entity_id": "eibibio", "book_id": "polyanthea_medicinal", "name": "Eibibio", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Eibibio"], "contexts": ["substance prepared by art"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Ebano", "target_book": "polyanthea_medicinal", "target_name": "Eibibio", "similarity": 0.842}], "id": 1409, "stable_key": "clu_cd219421f2480a5c", "ground_truth": {"modern_name": "Ebony", "confidence": "medium", "type": "plant", "note": "While 'Ebano' most commonly refers to the wood of the ebony tree, the context with 'Eibibio' and 'substance prepared by art' makes the identification uncertain. It could also refer to other dark woods or even a prepared substance.", "wikidata_id": "Q5279617", "wikidata_description": "species of plant", "wikipedia_extract": "Ebony is a dense black/brown hardwood, coming from several species in the genus Diospyros, which also includes the persimmon tree. A few Diospyros species, such as macassar and mun ebony, are dense enough to sink in water. Ebony is finely textured and has a mirror finish when polished, making it valuable as an ornamental wood. It is often cited as one of the most expensive woods in the world. The word ebony comes from the Ancient Egyptian hbny, through the Ancient Greek ἔβενος (ébenos), into Latin (ebenus) and Middle English. Species of ebony include Diospyros ebenum (Ceylon ebony), native to southern India and Sri Lanka; D. crassiflora (Gabon ebony), native to western Africa; Diospyros blancoi (Philippine ebony, also known as kamagong); D. humilis (Queensland ebony), native to Queensland, the Northern Territory, New Guinea and Timor; and D. celebica (Sulawesi ebony), native to Indonesia and prized for its luxuriant, multi-colored wood grain."}}, {"canonical_name": "cliſteres", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "cliſteres", "book_id": "historia_medicinal_monardes_1574", "name": "cliſteres", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["cliſteres", "clyíteres"], "contexts": ["enema for bowel evacuation", "medical instruments for enemas"]}, {"entity_id": "clyſteis", "book_id": "polyanthea_medicinal", "name": "clyſteis", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["clyſteis"], "contexts": ["type of medicinal administration discussed", "medical preparation for internal administration"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "cliſteres", "target_book": "polyanthea_medicinal", "target_name": "clyſteis", "similarity": 0.907}], "id": 1410, "stable_key": "clu_4e35ae8a18bbfc91", "ground_truth": {"modern_name": "Enema", "confidence": "high", "type": "object", "wikidata_id": "Q4038065", "wikidata_description": "genus of insects", "wikipedia_extract": "An enema, also known as a clyster, is the rectal administration of a fluid by injection into the lower bowel via the anus. The word enema can also refer to the liquid injected, as well as to a device for administering such an injection. In standard medicine, the most frequent uses of enemas are to relieve constipation and for bowel cleansing before a medical examination or procedure; also, they are employed as a lower gastrointestinal series (also called a barium enema), to treat traveler's diarrhea, as a vehicle for the administration of food, water or medicine, as a stimulant to the general system, as a local application and, more rarely, as a means of reducing body temperature, as treatment for encopresis, and as a form of rehydration therapy (proctoclysis) in patients for whom intravenous therapy is not applicable. The principal medical usages of enemas are: As bowel stimulants, enemas are employed for the same purposes as orally administered laxatives: to relieve constipation; to treat fecal impaction; to empty the colon before a medical procedure such as a colonoscopy. When oral laxatives are not indicated or sufficiently effective, enemas may be a sensible and necessary measure. A large volume enema can be given to cleanse as much of the colon as possible of feces."}}, {"canonical_name": "Caftilla", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "caftilla", "book_id": "historia_medicinal_monardes_1574", "name": "Caftilla", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Caftilla", "Caſtilla"], "contexts": ["region with similar trees and plants", "Turpentine made in Castile"]}, {"entity_id": "caſtella", "book_id": "polyanthea_medicinal", "name": "Caſtella", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Caſtella"], "contexts": ["country near Portugal"]}, {"entity_id": "caftilla", "book_id": "polyanthea_medicinal", "name": "Caftilla", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Caftilla"], "contexts": ["region where many people were cured"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Caftilla", "target_book": "polyanthea_medicinal", "target_name": "Caſtella", "similarity": 0.859}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Caftilla", "target_book": "polyanthea_medicinal", "target_name": "Caftilla", "similarity": 1.0}], "id": 1411, "stable_key": "clu_e97d3439c5d642e7", "ground_truth": {"modern_name": "Castile", "confidence": "high", "type": "place", "country": "Spain", "wikidata_id": "Q217196", "wikidata_description": "former country", "wikipedia_url": "https://en.wikipedia.org/wiki/Crown_of_Castile", "wikipedia_extract": "The Crown of Castile, sometimes known as the Crowns of Castile and León, was a medieval polity in the Iberian Peninsula that formed in 1230 as a result of the third and definitive union of the crowns and, some decades later, the parliaments of the kingdoms of Castile and León upon the accession of the then Castilian king, Ferdinand III, to the vacant Leonese throne. It continued to exist as a separate entity after the personal union in 1469 of the crowns of Castile and Aragon with the marriage of the Catholic Monarchs up to the promulgation of the Nueva Planta decrees by Philip V in 1716. In 1492, the voyage of Christopher Columbus and the discovery of the Americas were major events in the history of Castile. The West Indies, Islands and Mainland of the Ocean Sea were also a part of the Crown of Castile when transformed from lordships to kingdoms of the heirs of Castile in 1506, with the Treaty of Villafáfila, and upon the death of Ferdinand the Catholic. The discovery of the Pacific Ocean, the conquest of the Aztec Empire, the conquest of the Inca Empire, the Spanish conquest of New Granada as well as the conquest of the Philippines all helped shape the Crown of Castile into a global empire in the 16th Century. The title of \"King of Castile\" remained in use by the Habsburg rulers during the 16th and 17th centuries."}}, {"canonical_name": "peſte", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "peſte", "book_id": "historia_medicinal_monardes_1574", "name": "peſte", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["peſte"], "contexts": ["highly contagious epidemic disease", "plague"]}, {"entity_id": "peſté", "book_id": "polyanthea_medicinal", "name": "peſté", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["peſté"], "contexts": ["plague", "epidemic disease"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "peſte", "target_book": "polyanthea_medicinal", "target_name": "peſté", "similarity": 0.956}], "id": 1412, "stable_key": "clu_a736c0e1d27e6a27", "ground_truth": {"modern_name": "Plague", "confidence": "high", "type": "disease", "modern_term": "Plague", "wikidata_id": "Q133780", "wikidata_description": "specific contagious and frequently fatal human disease caused by Yersinia pestis", "wikipedia_extract": "Plague is an infectious disease caused by the bacterium Yersinia pestis. Symptoms include fever, weakness, headache and black lips. Usually, this begins one to seven days after exposure. There are three forms of plague, each affecting a different part of the body and causing associated symptoms. Pneumonic plague infects the lungs, causing shortness of breath, coughing and chest pain; bubonic plague affects the lymph nodes, making them swell; and septicemic plague infects the blood and can cause tissues to turn black and die. The bubonic and septicemic forms are generally spread by flea bites or handling an infected animal, whereas pneumonic plague is generally spread between people through the air via infectious droplets.", "wikipedia_url": "https://en.wikipedia.org/wiki/Plague_(disease)"}}, {"canonical_name": "ventosa", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "ventosa", "book_id": "polyanthea_medicinal", "name": "ventosa", "category": "CONCEPT", "subcategory": "QUALITY", "count": 3, "variants": ["ventosa"], "contexts": ["used on the stomach for flatulence", "windy part"]}, {"entity_id": "ventosas", "book_id": "historia_medicinal_monardes_1574", "name": "ventosas", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["ventosas"], "contexts": ["windy or gaseous quality causing illness"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "ventosa", "target_book": "historia_medicinal_monardes_1574", "target_name": "ventosas", "similarity": 0.985}], "id": 1413, "stable_key": "clu_12d6a16eeb5c29b9", "ground_truth": {"modern_name": "Flatulence", "confidence": "high", "type": "concept", "note": "The term 'ventosa' in early modern Portuguese and Spanish medical texts referred to a windy or gaseous condition, particularly affecting the stomach, and is directly translatable to flatulence.", "wikidata_id": "Q160184", "wikidata_description": "bodily function of expelling intestinal gas out of the anus", "wikipedia_url": "https://en.wikipedia.org/wiki/Flatulence"}}, {"canonical_name": "alhigado", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "alhigado", "book_id": "historia_medicinal_monardes_1574", "name": "alhigado", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["alhigado"], "contexts": ["related to the liver"]}, {"entity_id": "albugineo", "book_id": "polyanthea_medicinal", "name": "Albugineo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Albugineo"], "contexts": ["first humor of the eye"]}, {"entity_id": "alvi", "book_id": "polyanthea_medicinal", "name": "alvi", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["alvi"], "contexts": ["bowel movements"]}, {"entity_id": "alhcyos", "book_id": "polyanthea_medicinal", "name": "alhcyos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["alhcyos"], "contexts": ["fluids related to dropsy"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "alhigado", "target_book": "polyanthea_medicinal", "target_name": "Albugineo", "similarity": 0.848}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "alhigado", "target_book": "polyanthea_medicinal", "target_name": "alvi", "similarity": 0.842}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "alhigado", "target_book": "polyanthea_medicinal", "target_name": "alhcyos", "similarity": 0.849}], "id": 1414, "stable_key": "clu_4621277b0a1afbeb", "ground_truth": {"modern_name": "Albuginea", "confidence": "medium", "type": "anatomy", "note": "The references are fragmented and ambiguous. 'Albugineo' could refer to the white of the eye or a humor, while 'alvi' points to bowels. 'Alhcyos' is unclear. 'Albuginea' (white of the eye) is the most plausible single referent, but the context of liver and bowels is conflicting.", "wikidata_id": "Q23852027", "wikidata_description": "article in Otto's encyclopedia"}}, {"canonical_name": "azeyte ordinario", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "azeyte_ordinario", "book_id": "polyanthea_medicinal", "name": "azeyte ordinario", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["azeyte ordinario"], "contexts": ["ordinary oil for ointment", "ingredient in a preparation"]}, {"entity_id": "azeytes", "book_id": "historia_medicinal_monardes_1574", "name": "azeytes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["azeytes"], "contexts": ["oils"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "azeyte ordinario", "target_book": "historia_medicinal_monardes_1574", "target_name": "azeytes", "similarity": 0.848}], "id": 1415, "stable_key": "clu_308c9bccb4cf467b", "ground_truth": {"modern_name": "Olive oil", "confidence": "high", "type": "chemical", "note": "'Azeyte ordinario' and 'azeytes' in these texts refer to common oils, most frequently olive oil, used in preparations and ointments.", "wikidata_id": "Q2641560", "wikidata_description": "Process of extracting oil from olives", "wikipedia_url": "https://en.wikipedia.org/wiki/Olive%20oil%20extraction", "wikipedia_extract": "Olive oil is a vegetable oil obtained by pressing whole olives (the fruit of Olea europaea, a traditional tree crop of the Mediterranean Basin) and extracting the oil. It is commonly used in cooking for frying foods, as a condiment, or as a salad dressing. It can also be found in some cosmetics, pharmaceuticals, soaps, and fuels for traditional oil lamps. It also has additional uses in some religions. The olive is one of three core food plants in Mediterranean cuisine, with wheat and grapes. Olive trees have been cultivated around the Mediterranean since the 8th millennium BC."}}, {"canonical_name": "Trogoldita", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "trogoldita", "book_id": "coloquios_da_orta_1563", "name": "Trogoldita", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Trogoldita"], "contexts": ["region where gengivre is said to exist", "region where a substance is found"]}, {"entity_id": "trogloditica", "book_id": "ricettario_fiorentino_1597", "name": "Trogloditica", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Trogloditica"], "contexts": ["region where cinnamon was thought to grow"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Trogoldita", "target_book": "ricettario_fiorentino_1597", "target_name": "Trogloditica", "similarity": 0.867}], "id": 1416, "stable_key": "clu_7bae0746c7b882cc", "ground_truth": {"modern_name": "Ethiopia", "confidence": "high", "type": "place", "country": "Ethiopia", "note": "Trogolodytes (Troglodytae) were ancient inhabitants of regions in Northeast Africa, including areas that encompass modern Ethiopia. The context of ginger and cinnamon growth points strongly to this region.", "wikidata_id": "Q115", "wikidata_description": "country in the Horn of Africa", "wikipedia_url": "https://en.wikipedia.org/wiki/Ethiopia", "wikipedia_extract": "Ethiopia, officially the Federal Democratic Republic of Ethiopia, is a landlocked country located in the Horn of Africa region of East Africa. It shares borders with Eritrea to the north, Djibouti to the northeast, Somalia to the east, Kenya to the south, South Sudan to the west, and Sudan to the northwest. Ethiopia covers a land area of 1,104,300 square kilometres (426,400 sq mi). As of 2025, it has around 135 million inhabitants, making it the 14th-most populous country. The national capital and largest city, Addis Ababa, lies several kilometres west of the East African Rift that splits the country into the African and Somali tectonic plates. Anatomically modern humans emerged from modern-day Ethiopia."}}, {"canonical_name": "Arata", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "arata", "book_id": "coloquios_da_orta_1563", "name": "Arata", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["arata", "Arata"], "contexts": ["medicine for horses made with calamus", "mixture of exciting ingredients"]}, {"entity_id": "aragao", "book_id": "polyanthea_medicinal", "name": "aragao", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["aragao"], "contexts": ["dragon's ointment", "ingredient in ointment"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Arata", "target_book": "polyanthea_medicinal", "target_name": "aragao", "similarity": 0.864}], "id": 1417, "stable_key": "clu_100323aeae6cc6e2", "ground_truth": {"modern_name": "Dragon's blood", "confidence": "medium", "type": "plant", "note": "The term 'Arata' and 'aragao' are difficult to definitively identify. 'Aragao' might relate to 'arar' (to plow) or a place, while 'Arata' could be a preparation. 'Dragon's ointment' is a plausible, though not certain, interpretation given the context of early modern medicinal preparations.", "wikidata_id": "Q133560", "wikidata_description": "species of plant", "wikipedia_extract": "Dragon's blood is a bright red resin that is obtained from different species of a number of distinct plant genera: Calamus spp. (previously Daemonorops) also including Calamus rotang, Croton, Dracaena and Pterocarpus. The red resin has been in continuous use since ancient times as varnish, medicine, incense, pigment, and dye. A great  degree of confusion existed for the ancients in regard to the source and identity of dragon's blood. Some medieval encyclopedias claimed its source as the literal blood of elephants and dragons who had perished in mortal combat. The resin of Dracaena species, \"true\" dragon's blood, and the very poisonous mineral cinnabar (mercury sulfide) were often confused by the ancient Romans.", "wikipedia_url": "https://en.wikipedia.org/wiki/Dragon's_blood"}}, {"canonical_name": "alamagna", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "alamagna", "book_id": "ricettario_fiorentino_1597", "name": "alamagna", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["alamagna", "Alamagna"], "contexts": ["region where lapis LAZZOLI is found", "place of origin for a substance"]}, {"entity_id": "alem", "book_id": "coloquios_da_orta_1563", "name": "alem", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["alem"], "contexts": ["origin of the writer"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "alamagna", "target_book": "coloquios_da_orta_1563", "target_name": "alem", "similarity": 0.853}], "id": 1418, "stable_key": "clu_5ec5d4bc765ffdd1", "ground_truth": {"modern_name": "Germany", "confidence": "high", "type": "place", "country": "Germany", "note": "'Alamagna' and 'alem' are archaic terms for Germany or the Germanic regions. The context of lapis lazuli also supports this geographic origin.", "wikipedia_extract": "East Germany, officially the German Democratic Republic (GDR), was a country in Central Europe from its formation on 7 October 1949 until its reunification with West Germany (Federal Republic of Germany) on 3 October 1990. Until 1989, it was generally viewed as a communist state and described itself as a socialist workers' and peasants' state. The economy of the country was centrally planned and state-owned. Although the GDR had to pay substantial war reparations to the Soviet Union, its economy became the most successful in the Eastern Bloc. Before its establishment, the country's territory was administered and occupied by Soviet forces following the Berlin Declaration abolishing German sovereignty in World War II. The Potsdam Agreement established the Soviet-occupied zone, bounded on the east by the Oder–Neiße line.", "wikipedia_url": "https://en.wikipedia.org/wiki/East_Germany"}}, {"canonical_name": "Muko", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "muko", "book_id": "ricettario_fiorentino_1597", "name": "Muko", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["muko", "Muko"], "contexts": ["musk, a proper excrement", "animal product, likely musk"]}, {"entity_id": "muktã", "book_id": "coloquios_da_orta_1563", "name": "muktã", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["muktã"], "contexts": ["Sanskrit name for pearl"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Muko", "target_book": "coloquios_da_orta_1563", "target_name": "muktã", "similarity": 0.876}], "id": 1419, "stable_key": "clu_c9fa433f99ba7b58", "ground_truth": {"modern_name": "Musk", "confidence": "medium", "type": "chemical", "note": "While 'Muko' and 'muktã' are mentioned, one context points to musk and the other to pearl. 'Musk' is the more common interpretation in early modern pharmacopoeias for a precious substance derived from animals. The pearl reference might be a secondary or erroneous association.", "wikidata_id": "Q206879", "wikidata_description": "central district and city in Nevşehir Province, Turkey", "wikipedia_extract": "Musk is a class of aromatic substances commonly used as base notes in perfumery. They include glandular secretions from animals such as the musk deer, numerous plants emitting similar fragrances, and artificial substances with similar odors. Musk was a name originally given to a substance with a strong odor obtained from a gland of the musk deer. The substance has been used as a popular perfume fixative since ancient times and is one of the most expensive animal products in the world. The name originates from the Late Greek μόσχος 'moskhos', from Persian mushk and Sanskrit मुष्क muṣka (lit. 'testicle') derived from Proto-Indo-European noun múh₂s meaning \"mouse\". The deer gland was thought to resemble a scrotum.", "wikipedia_url": "https://en.wikipedia.org/wiki/Nev%C5%9Fehir"}}, {"canonical_name": "pompholix", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "pompholix", "book_id": "coloquios_da_orta_1563", "name": "pompholix", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["pompholix", "pomfciix"], "contexts": ["mineral substance", "similar ao espodio metallico"]}, {"entity_id": "pompholigos", "book_id": "polyanthea_medicinal", "name": "pompholigos", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["pompholigos"], "contexts": ["zinc oxide"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "pompholix", "target_book": "polyanthea_medicinal", "target_name": "pompholigos", "similarity": 0.942}], "id": 1420, "stable_key": "clu_264c35eaa9f267d9", "ground_truth": {"modern_name": "Calamine", "confidence": "high", "type": "mineral", "note": "Pompholix (or pompholyx) is an archaic term for calamine, a naturally occurring mixture of zinc carbonates and silicates, used in medicine.", "wikidata_id": "Q408008", "wikidata_description": "sorosilicate mineral", "wikipedia_extract": "Cadmium is a chemical element; it has symbol Cd and atomic number 48. This soft, silvery-white metal is chemically similar to the two other stable metals in group 12, zinc and mercury. Like zinc, it demonstrates oxidation state +2 in most of its compounds, and like mercury, it has a lower melting point than the transition metals in groups 3 through 11. Cadmium and its congeners in group 12 are often not considered transition metals, in that they do not have partly filled d or f electron shells in the elemental or common oxidation states. The average concentration of cadmium in Earth's crust is between 0.1 and 0.5 parts per million (ppm). It was discovered in 1817 simultaneously by Stromeyer and Hermann, both in Germany, as an impurity in zinc carbonate.", "wikipedia_url": "https://en.wikipedia.org/wiki/Hemimorphite"}}, {"canonical_name": "balea", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "balea", "book_id": "coloquios_da_orta_1563", "name": "balea", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 3, "variants": ["balea", "baleas", "baleia"], "contexts": ["animal discussed in relation to amber", "attributed source of amber"]}, {"entity_id": "baleas", "book_id": "polyanthea_medicinal", "name": "baleas", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["baleas"], "contexts": ["whales, source of ambergris"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "balea", "target_book": "polyanthea_medicinal", "target_name": "baleas", "similarity": 0.974}], "id": 1421, "stable_key": "clu_a22c1c4140666aee", "ground_truth": {"wikipedia_extract": "Balea is a genus of small, very elongate, air-breathing land snails, sinistral terrestrial pulmonate gastropod mollusks in the family Clausiliidae, the door snails. Balea is the type genus of the subfamily Baleinae. Balea biplicata (Montague, 1803) – synonym: Alinda biplicata Balea perversa (Linnaeus, 1758) – the type species of the genus Balea sarsii Pfeiffer, 1847 - synonym: Balea heydeni von Maltzan, 1881 Gittenberger E., Groenenberg D. S. J., Kokshoorn B. & Preece R. C. (2006). \"Molecular trails from hitch-hiking snails\"."}}, {"canonical_name": "leite azedo", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "leite_azedo", "book_id": "coloquios_da_orta_1563", "name": "leite azedo", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 3, "variants": ["leite azedo"], "contexts": ["preparation for asthma", "ingredient mixed with powder"]}, {"entity_id": "leite_asinino", "book_id": "polyanthea_medicinal", "name": "leite asinino", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["leite asinino"], "contexts": ["donkey milk for eye ailments"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "leite azedo", "target_book": "polyanthea_medicinal", "target_name": "leite asinino", "similarity": 0.908}], "id": 1422, "stable_key": "clu_b122cecdd734d8b5", "ground_truth": {"modern_name": "Donkey milk", "confidence": "high", "type": "animal", "wikidata_id": "Q129528842", "wikidata_description": "scholarly article", "wikipedia_extract": "Donkey milk (or ass milk, or jenny milk) is the milk from the domesticated donkey (Equus asinus). It has been used since antiquity for cosmetic purposes as well as infant nutrition. Donkey milk has been used by humans for alimentary and cosmetic purposes since Egyptian antiquity. Doctors recommended it to treat several afflictions because of its supposed healing and cosmetic virtues. Hippocrates (460–370 BC) was the first to write of the medicinal use of donkey milk and prescribed it for numerous conditions, including poisoning, fevers, infectious diseases, edema, wounds, nose bleeds, and liver trouble. In the Roman era, donkey milk was a recognized remedy; Pliny the Elder (23–79 AD) in his encyclopedic work, Naturalis Historia, wrote extensively about its health benefits, i.e. to fight fever, fatigue, eye strain, weakened teeth, face wrinkles, poisonings, ulcerations, asthma, and certain gynecological troubles."}}, {"canonical_name": "fogo", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "fogo", "book_id": "coloquios_da_orta_1563", "name": "fogo", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["fogo"], "contexts": ["element used in processing camphor", "heat source for warming the body"]}, {"entity_id": "fire", "book_id": "polyanthea_medicinal", "name": "fire", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["fire"], "contexts": ["used for cauterization"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "fogo", "target_book": "polyanthea_medicinal", "target_name": "fire", "similarity": 0.978}], "id": 1423, "stable_key": "clu_973b9694a7b6a341", "ground_truth": {"modern_name": "Fire", "confidence": "high", "type": "concept", "note": "In early modern texts, 'fire' often referred to the element and its associated heat and transformative properties, not solely combustion.", "wikidata_id": "Q2044", "wikidata_description": "Italian city and commune, located in Tuscany", "wikipedia_url": "https://en.wikipedia.org/wiki/Florence"}}, {"canonical_name": "abada", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "abada", "book_id": "coloquios_da_orta_1563", "name": "abada", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 3, "variants": ["Abada", "abada"], "contexts": ["animal sent as a gift", "name for rhinoceros"]}, {"entity_id": "abada", "book_id": "polyanthea_medicinal", "name": "Abada", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["Abada"], "contexts": ["animal product, likely a type of animal"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "abada", "target_book": "polyanthea_medicinal", "target_name": "Abada", "similarity": 0.974}], "id": 1424, "stable_key": "clu_de855c59f22f947e", "ground_truth": {"modern_name": "Abada", "confidence": "medium", "type": "animal", "note": "While 'abada' can refer to a rhinoceros in Portuguese, the context of being sent as a gift might also suggest other exotic animals. However, rhinoceros horn was a known medicinal substance.", "wikidata_id": "Q134657", "wikidata_description": "genus of mammals", "wikipedia_url": "https://en.wikipedia.org/wiki/Rhinoceros_%28genus%29", "wikipedia_extract": "Rhinoceros is a genus comprising one-horned rhinoceroses. This scientific name was proposed by Swedish taxonomist Carl Linnaeus in 1758. The genus contains two species, the Indian rhinoceros (R. unicornis) and the Javan rhinoceros (R. sondaicus). Although both members are threatened, the Javan rhinoceros is one of the most endangered large mammals in the world, with only 60 individuals surviving in Java (Indonesia)."}}, {"canonical_name": "coco das Maldivas", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "coco_das_maldivas", "book_id": "coloquios_da_orta_1563", "name": "coco das Maldivas", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["coco das Maldivas", "Coquo das Maldivas"], "contexts": ["marine production with antidotal properties", "topic of colloquy"]}, {"entity_id": "cocos_demaldiva", "book_id": "polyanthea_medicinal", "name": "Cocos deMaldiva", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Cocos deMaldiva", "cocos de Maldiva"], "contexts": ["fruit from Maldives", "coconuts of Maldives"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "coco das Maldivas", "target_book": "polyanthea_medicinal", "target_name": "Cocos deMaldiva", "similarity": 0.874}], "id": 1425, "stable_key": "clu_c68fc54d84c0e793", "ground_truth": {"modern_name": "Coconut", "confidence": "high", "type": "plant", "family": "Arecaceae", "wikidata_id": "Q13187", "wikidata_description": "species of plant", "wikipedia_extract": "The coconut (Cocos nucifera) is a member of the palm family (Arecaceae) and the only living species of the genus Cocos. The term \"coconut\" (or the archaic \"cocoanut\") can denote the whole coconut palm tree or the large hard fruit. Originally native to Central Indo-Pacific, they are ubiquitous in coastal tropical regions. The coconut tree provides food, fuel, cosmetics, folk medicine and building materials. The inner flesh of the mature fruit forms a regular part of the diets of many people in the tropics and subtropics. Coconut endosperm contains a large quantity of a liquid, \"coconut water\".", "wikipedia_url": "https://en.wikipedia.org/wiki/Coconut"}}, {"canonical_name": "pão", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "pão", "book_id": "coloquios_da_orta_1563", "name": "pão", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["pão"], "contexts": ["food eaten with a substance", "likely a misspelling of 'páo'"]}, {"entity_id": "lacre_de_pão", "book_id": "coloquios_da_orta_1563", "name": "lacre de pão", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["lacre de pão"], "contexts": ["form of lacca in cakes"]}, {"entity_id": "pão_de_ló", "book_id": "polyanthea_medicinal", "name": "pão de ló", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["pão de ló"], "contexts": ["sponge cake, used in remedies"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "pão", "target_book": "polyanthea_medicinal", "target_name": "pão de ló", "similarity": 0.837}, {"source_book": "coloquios_da_orta_1563", "source_name": "lacre de pão", "target_book": "polyanthea_medicinal", "target_name": "pão de ló", "similarity": 0.854}], "id": 1426, "stable_key": "clu_a172937854b04102", "ground_truth": {"modern_name": "Bread", "confidence": "high", "type": "food", "note": "This cluster includes 'pão' (bread), 'lacre de pão' (bread lac), and 'pão de ló' (sponge cake). While 'bread' is the core, the specific forms relate to preparation and confectionary items used medicinally.", "wikipedia_extract": "Bread is a baked food product made from water, flour, and often yeast. It is a staple food across the world, particularly in Europe and the Middle East. Throughout recorded history and around the world, it has been an important part of many cultures' diets. It is one of the oldest human-made foods, having been of significance since the dawn of agriculture, and plays an essential role in both religious rituals and secular culture. Bread may be leavened by naturally occurring microbes (e.g. sourdough), chemicals (e.g. baking soda), industrially produced yeast, or high-pressure aeration, which creates the gas bubbles that fluff up bread. Bread may also be unleavened."}}, {"canonical_name": "unhas", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "unhas", "book_id": "coloquios_da_orta_1563", "name": "unhas", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 2, "variants": ["unhas"], "contexts": ["black and shrunken", "nails of elephants"]}, {"entity_id": "unhas_de_burro", "book_id": "polyanthea_medicinal", "name": "unhas de burro", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 2, "variants": ["unhas de burro", "unhas do burro"], "contexts": ["remedy for epilepsy", "made into shavings for remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "unhas", "target_book": "polyanthea_medicinal", "target_name": "unhas de burro", "similarity": 0.842}], "id": 1427, "stable_key": "clu_25998f6bd45ad760", "ground_truth": {"modern_name": "Donkey hooves", "confidence": "high", "type": "animal", "wikidata_id": "Q96302154", "wikidata_description": "scientific article published on 01 June 2020"}}, {"canonical_name": "pólvora", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "pólvora", "book_id": "coloquios_da_orta_1563", "name": "pólvora", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["pólvora"], "contexts": ["gunpowder", "explosive substance used in warfare"]}, {"entity_id": "polvora", "book_id": "polyanthea_medicinal", "name": "polvora", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["polvora"], "contexts": ["powdered substance", "explosive substance"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "pólvora", "target_book": "polyanthea_medicinal", "target_name": "polvora", "similarity": 0.912}], "id": 1428, "stable_key": "clu_b3cc1648577c715f", "ground_truth": {"wikipedia_extract": "Pólvora (born July 19, 1979) is the ring name of a Mexican Luchador Enmascarado, or masked professional wrestler best known for his work in the Mexican professional wrestling promotion Consejo Mundial de Lucha Libre (CMLL). Pólvora's real name is not a matter of public record, as is often the case with masked wrestlers in Mexico where their private lives are kept a secret from the wrestling fans. His name is the Spanish term for Gunpowder. Pólvora's brother is also a professional wrestler, under the ring name Inquisidor. Pólvora made his professional wrestling debut in 2000, mainly teaming with his brother Vaquero on the Mexican independent circuit By 2005 both Pólvora and Vaquero began working for Consejo Mundial de Lucha Libre (CMLL), mainly on the promotions minor shows or in the opening match of their big shows from Arena México. On June 22, 2008 Pólvora and Vaquero participated in a tournament for the vacant CMLL Arena Coliseo Tag Team Championship, but lost in the opening round to Mictlán and Fabian el Gitano."}}, {"canonical_name": "Cayro", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "cayro", "book_id": "coloquios_da_orta_1563", "name": "Cayro", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Cayro", "cayro"], "contexts": ["place where afiam used to come from", "location of emeralds"]}, {"entity_id": "cayri", "book_id": "polyanthea_medicinal", "name": "Cayri", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Cayri", "Cayro"], "contexts": ["city where a patient was treated", "city where an asthmatic was treated"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Cayro", "target_book": "polyanthea_medicinal", "target_name": "Cayri", "similarity": 0.907}], "id": 1429, "stable_key": "clu_925b03aebcb30b28", "ground_truth": {"modern_name": "Cairo", "confidence": "high", "type": "place", "country": "Egypt", "wikidata_id": "Q85", "wikidata_description": "capital city of Egypt", "wikipedia_extract": "Cairo is the capital and largest city of Egypt and the Cairo Governorate. It is home to more than 10.5 million people. It is also part of the largest urban agglomeration in Africa, the Arab world, and the Middle East. The Greater Cairo metropolitan area is one of the largest in the world by population with over 22 million people. Areas of what would become Cairo were inhabited from pre-dynastic and early-dynastic ancient Egypt c. 6000 years ago, as the Giza pyramid complex and the ancient cities of Memphis and Heliopolis are today within the city.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cairo"}}, {"canonical_name": "Giestabrava", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "giestabrava", "book_id": "polyanthea_medicinal", "name": "Giestabrava", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["Giestabrava"], "contexts": ["plant whose ash causes urination"]}, {"entity_id": "giesta", "book_id": "coloquios_da_orta_1563", "name": "giesta", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["giesta"], "contexts": ["flower color comparison"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Giestabrava", "target_book": "coloquios_da_orta_1563", "target_name": "giesta", "similarity": 0.812}], "id": 1430, "stable_key": "clu_dd23c5ab19d7cd50", "ground_truth": {"modern_name": "Broom", "confidence": "high", "type": "plant", "linnaean": "Cytisus scoparius", "family": "Fabaceae", "wikipedia_extract": "A broom (), also known as a broomstick, is a cleaning tool, consisting of usually stiff fibers (often made of materials such as plastic, glued hair, or corn husks) attached to, and roughly parallel to, a cylindrical handle, the broomstick. It is thus a variety of brush with a long handle. It is commonly used in combination with a dustpan. A distinction is made between a \"hard broom\" and a \"soft broom\" and a spectrum in between. Soft brooms are used in some cultures chiefly for sweeping walls of cobwebs and spiders, like a \"feather duster\", while hard brooms are for rougher tasks like sweeping dirt off sidewalks or concrete floors, or even smoothing and texturing wet concrete. The majority of brooms are somewhere in between, suitable for sweeping the floors of homes and businesses, soft enough to be flexible and to move even light dust, but stiff enough to achieve a firm sweeping action."}}, {"canonical_name": "Antidotarios", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "antidotarios", "book_id": "polyanthea_medicinal", "name": "Antidotarios", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["Antidotarios", "Antidotarium"], "contexts": ["books of remedies", "collection of antidotes"]}, {"entity_id": "antidotorum", "book_id": "coloquios_da_orta_1563", "name": "Antidotorum", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Antidotorum"], "contexts": ["title of a book"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Antidotarios", "target_book": "coloquios_da_orta_1563", "target_name": "Antidotorum", "similarity": 0.922}], "id": 1431, "stable_key": "clu_9a75527b8fa6fd80", "ground_truth": {"modern_name": "Antidotary", "confidence": "high", "type": "text"}}, {"canonical_name": "manjar branco", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "manjar_branco", "book_id": "polyanthea_medicinal", "name": "manjar branco", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["manjar branco"], "contexts": ["white dish, a food preparation", "food for the sick"]}, {"entity_id": "manjar_branco", "book_id": "coloquios_da_orta_1563", "name": "manjar branco", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["manjar branco"], "contexts": ["food used for comparison of texture and taste"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "manjar branco", "target_book": "coloquios_da_orta_1563", "target_name": "manjar branco", "similarity": 1.0}], "id": 1432, "stable_key": "clu_eddb65856ea303de", "ground_truth": {"wikipedia_extract": "Manjar branco is a pure white Brazilian coconut pudding similar to blancmange. It is identical to the Puerto Rican tembleque. In Brazil manjar branco is made in a ring (Savarin) mold and is served with a sauce made of pitted prunes poached in port wine. Commercial mixes for manjar branco and tembleque are available in Brazil, the U.S., and in other Latin American countries. In order to improve the texture and taste, unsweetened shredded coconut may be added to the mix. Manjar branco in Portugal usually refers to blancmange, but the manjar branco of Coimbra is an unusual dessert made from chicken breast, milk, sugar, rice flour, orange zest, and salt."}}, {"canonical_name": "diaphoretico", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "diaphoretico", "book_id": "polyanthea_medicinal", "name": "diaphoretico", "category": "CONCEPT", "subcategory": "QUALITY", "count": 3, "variants": ["diaphoretico"], "contexts": ["promoting sweat"]}, {"entity_id": "diaphoretic", "book_id": "coloquios_da_orta_1563", "name": "diaphoretic", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["diaphoretic"], "contexts": ["medicinal property of 'folio indo'"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "diaphoretico", "target_book": "coloquios_da_orta_1563", "target_name": "diaphoretic", "similarity": 0.987}], "id": 1433, "stable_key": "clu_22144e49f4c679b7", "ground_truth": {"modern_name": "Diaphoretic", "confidence": "high", "type": "concept", "wikidata_id": "Q2998108", "wikidata_description": "clade including Archaeplastida (plants, red algae, green algae, glaucophytes) and Chromalveolata (kelp, water moulds, ciliates, dinoflagellates, etc)", "wikipedia_url": "https://en.wikipedia.org/wiki/Corticata", "wikipedia_extract": "Corticata (\"one with a cortex\"), in the classification of eukaryotes (living organisms with a cell nucleus), is a superkingdom suggested by Thomas Cavalier-Smith to encompass the following two eukaryote supergroups: Plantae, or Archaeplastida (land plants, red algae, green algae, and glaucophytes) Chromalveolata (a polyphyletic group including kelp, water moulds, ciliates, dinoflagellates, and other organisms) Cavalier-Smith later included Rhizaria as well, resulting in a close similarity to Diaphoretickes — not identical as Diaphoretickes does not contain polyphyletic taxa."}}, {"canonical_name": "Universidade de Coimbra", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "universidade_de_coimbra", "book_id": "polyanthea_medicinal", "name": "Universidade de Coimbra", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Universidade de Coimbra"], "contexts": ["university where Antonio Mendes taught", "institution where Padre Luis taught"]}, {"entity_id": "universidade_de_coimbra", "book_id": "coloquios_da_orta_1563", "name": "Universidade de Coimbra", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Universidade de Coimbra"], "contexts": ["university in Portugal"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Universidade de Coimbra", "target_book": "coloquios_da_orta_1563", "target_name": "Universidade de Coimbra", "similarity": 1.0}], "id": 1434, "stable_key": "clu_0f5cc4eb8ef2ff31", "ground_truth": {"wikipedia_extract": "The University of Coimbra (UC) is a public research university in Coimbra, Portugal. Officially chartered by King Denis on March 1, 1290, and recognised by Pope Nicholas IV on August 9, 1290, it is the oldest university in Portugal and one of the world's oldest in continuous operations, having begun operations in Lisbon before moving permanently to Coimbra in 1537. It had an influential role in the development of higher education in the Portuguese-speaking countries, and in their history. Due to its historic influence, architecture, unique culture and traditions, it was declared in 2013 a World Heritage Site by UNESCO. The university is organized into eight faculties, granting bachelor's (licenciatura), master's (mestrado) and doctorate (doutoramento) degrees in nearly all major fields. It lends its name to the Coimbra Group of European research universities founded in 1985, of which it was a founding member."}}, {"canonical_name": "urtigas", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "urtigas", "book_id": "polyanthea_medicinal", "name": "urtigas", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["urtigas", "urtica"], "contexts": ["nettles", "juice used as a remedy"]}, {"entity_id": "urticaceof", "book_id": "coloquios_da_orta_1563", "name": "Urticaceof", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Urticaceof"], "contexts": ["family of the Jackfruit tree"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "urtigas", "target_book": "coloquios_da_orta_1563", "target_name": "Urticaceof", "similarity": 0.865}], "id": 1435, "stable_key": "clu_8c2a40e21f328e1a", "ground_truth": {"modern_name": "Nettle", "confidence": "high", "type": "plant", "linnaean": "Urtica dioica Linnaeus", "family": "Urticaceae", "note": "The 'Urticaceof' in context might be a misspelling or an abbreviated reference to the family Urticaceae, or even a specific species of nettle.", "wikidata_id": "Q121671", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Urtica", "wikipedia_extract": "Urtica dioica, often known as common nettle, burn nettle, stinging nettle, nettle leaf, or just a nettle or stinger, is a herbaceous perennial flowering plant in the family Urticaceae. Originally native to Europe, much of temperate Asia and western North Africa, it is now found worldwide. The species is divided into six subspecies, five of which have many hollow stinging hairs called trichomes on the leaves and stems, which act like hypodermic needles, injecting histamine and other chemicals that produce a stinging sensation upon contact (\"contact urticaria\", a form of contact dermatitis). The plant has a long history of use as a source for traditional medicine, food, tea, and textile raw material in ancient (such as Saxon) and modern societies. Urtica dioica is a dioecious, herbaceous, and perennial plant. It grows to 0.9 to 2 metres (3 to 7 feet) tall in the summer and dying down to the ground in winter."}}, {"canonical_name": "abelha", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "abelha", "book_id": "polyanthea_medicinal", "name": "abelha", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 3, "variants": ["abelha", "abelhas"], "contexts": ["bee, source of venom", "bee sting treatment"]}, {"entity_id": "abelha", "book_id": "coloquios_da_orta_1563", "name": "abelha", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["abelha"], "contexts": ["bee that makes honey"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "abelha", "target_book": "coloquios_da_orta_1563", "target_name": "abelha", "similarity": 1.0}], "id": 1436, "stable_key": "clu_d4fc73cfc12a6626", "ground_truth": {"wikipedia_extract": "João Batista Lopes Abelha (born 3 January 1958), simply known as Abelha, is a Brazilian former professional footballer and manager who played as a goalkeeper. Abelha began his career at Ferroviária, a club in the city where he was born. In 1984 he transferred to Flamengo where he won the Guanabara Cup. He arrived at São Paulo to compete for a position with Barbirotto, but was unsuccessful, and then played for São Bento, Inter de Limeira, Botafogo de Ribeirão Preto, ABC, Honda Hamamatsu and São Bento, his last club in 1992. Living in Japan, he began his career as a goalkeeper coach in 1994, assisting Paulo Roberto Falcão on the Japan national football team. He managed São Bento for the first time in 1997, and in 1999 he was Nelsinho Baptista's assistant at Colo-Colo."}}, {"canonical_name": "lac", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "lac", "book_id": "polyanthea_medicinal", "name": "lac", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 3, "variants": ["lac"], "contexts": ["milk, animal product", "milk, considered beneficial for dropsy"]}, {"entity_id": "lac_ant", "book_id": "coloquios_da_orta_1563", "name": "lac ant", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["lac ant"], "contexts": ["name given by Karens to the lac-producing ant"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "lac", "target_book": "coloquios_da_orta_1563", "target_name": "lac ant", "similarity": 0.861}], "id": 1437, "stable_key": "clu_831f62cccc6ff894", "ground_truth": {"modern_name": "Lac insect", "confidence": "medium", "type": "animal", "note": "The 'lac ant' reference is unusual and likely refers to an insect that produces a lac-like substance, not a true ant.", "wikipedia_extract": "Kerriidae is a family of scale insects, commonly known as lac insects or lac scales, erected by Karl Lindinger in 1937. Some members of the genera Metatachardia, Tachardiella, Austrotacharidia, Afrotachardina, Tachardina, and Kerria are raised for commercial purposes, though the most commonly cultivated species is Kerria lacca. These insects secrete a waxy resin that is harvested and converted commercially into lac and shellac, used in various dyes, cosmetics, food glazes, wood finishing varnishes and polishes.", "wikipedia_url": "https://en.wikipedia.org/wiki/Kerriidae"}}, {"canonical_name": "betume", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "betume", "book_id": "polyanthea_medicinal", "name": "betume", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["betume"], "contexts": ["bitumen", "bitumen, remedy for uterine issues"]}, {"entity_id": "betume_judaico", "book_id": "coloquios_da_orta_1563", "name": "betume judaico", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["betume judaico"], "contexts": ["substance called by a different name"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "betume", "target_book": "coloquios_da_orta_1563", "target_name": "betume judaico", "similarity": 0.813}], "id": 1438, "stable_key": "clu_0e9f7196691634af", "ground_truth": {"modern_name": "Bitumen", "confidence": "high", "type": "mineral", "wikidata_id": "Q167510", "wikidata_description": "form of petroleum primarily used in road construction", "wikipedia_extract": "Shilajit (Sanskrit: शिलाजित्) or Shilajatu (शिलाजतु; lit. mountain/rock bitumen/lac), is an organic-mineral product of predominantly biological origin, formed at high altitudes on stony mountains, in sheltered crevices and caves. It is a blackish-brown powder or an exudate emerging between high mountain rocks, often found in the Altai Mountains, the Caucasus Mountains, the Himalayas (especially in India, Pakistan, Nepal, and the Tibetan Plateau), the Karakoram, the Pamir Mountains (primarily in Gorno-Badakhshan, Tajikistan), and countrywise in Afghanistan, Bhutan, Georgia, India (regions of Himachal Pradesh and Uttarakhand), Iran, Kyrgyzstan, Mongolia, Nepal, Russia, Central Asia and Africa. People living in these areas use shilajit in folk and non-traditional (alternative) medicine (Ayurveda, Chinese, Tibetan). Shilajit is sold both in dry extract form and in dietary supplements, but there is limited evidence that shilajit has any beneficial effects on human health. Some sources have been found in studies to contain hazardous heavy metals, including lead.", "wikipedia_url": "https://en.wikipedia.org/wiki/Bitumen"}}, {"canonical_name": "passas", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "passas", "book_id": "polyanthea_medicinal", "name": "passas", "category": "PLANT", "subcategory": "PLANT", "count": 3, "variants": ["passas"], "contexts": ["dried grapes eaten daily", "raisins, dried grapes used in remedies"]}, {"entity_id": "pasa", "book_id": "coloquios_da_orta_1563", "name": "pasa", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["pasa"], "contexts": ["raisins"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "passas", "target_book": "coloquios_da_orta_1563", "target_name": "pasa", "similarity": 0.899}], "id": 1439, "stable_key": "clu_c9c5cc81e1cb6130", "ground_truth": {"modern_name": "Raisin", "confidence": "high", "type": "plant", "linnaean": "Vitis vinifera Linnaeus", "family": "Vitaceae", "wikidata_id": "Q80212", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Grewia"}}, {"canonical_name": "moſcas", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "moſcas", "book_id": "polyanthea_medicinal", "name": "moſcas", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 3, "variants": ["moſcas", "Moscas", "mofcas"], "contexts": ["insects, flies", "crushed flies used for spider bites"]}, {"entity_id": "mouuscos", "book_id": "coloquios_da_orta_1563", "name": "moUuscos", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["moUuscos"], "contexts": ["creatures that produce pearls"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "moſcas", "target_book": "coloquios_da_orta_1563", "target_name": "moUuscos", "similarity": 0.857}], "id": 1440, "stable_key": "clu_0e1bf2358533d13d", "ground_truth": {"modern_name": "Fly", "confidence": "low", "type": "animal", "note": "The context 'creatures that produce pearls' is highly unusual for flies and suggests a possible misidentification or specific folklore. The 'moUuscos' is likely an OCR error for 'mosquitos' or similar insect, but given the context of pearls, it's highly ambiguous.", "wikidata_id": "Q166111", "wikidata_description": "species of insect in the class \"Muscidae\", sort of fly", "wikipedia_extract": "Flies are insects of the order Diptera, the name being derived from Ancient Greek  δι- (di-) 'two' and  πτερόν (pteron) 'wing'. Insects of this order use only a single pair of wings to fly, the hindwings having evolved into advanced mechanosensory organs known as halteres, which act as high-speed sensors of rotational movement and allow dipterans to perform advanced aerobatics. Diptera is a large order containing more than 150,000 species including horse-flies, crane flies, hoverflies, mosquitoes and others. Flies have a mobile head, with a pair of large compound eyes, and mouthparts designed for piercing and sucking (mosquitoes, black flies and robber flies), or for lapping and sucking in the other groups. Their wing arrangement gives them great manoeuvrability in flight, and claws and pads on their feet enable them to cling to smooth surfaces. Flies undergo complete metamorphosis; the eggs are often laid on the larval food-source and the larvae, which lack true limbs, develop in a protected environment, often inside their food source.", "wikipedia_url": "https://en.wikipedia.org/wiki/Housefly"}}, {"canonical_name": "lavagens", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "lavagens", "book_id": "polyanthea_medicinal", "name": "lavagens", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 3, "variants": ["lavagens", "lavativas"], "contexts": ["repeated washing of powders", "enemas"]}, {"entity_id": "lavar", "book_id": "coloquios_da_orta_1563", "name": "lavar", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["lavar"], "contexts": ["use of the plant for washing"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "lavagens", "target_book": "coloquios_da_orta_1563", "target_name": "lavar", "similarity": 0.904}], "id": 1441, "stable_key": "clu_c8136ad7647a1543", "ground_truth": {"modern_name": "Washing", "confidence": "high", "type": "concept", "wikidata_id": "Q61", "wikidata_description": "capital city of the United States of America", "wikipedia_extract": "Washing is a method of cleaning, usually with water and soap or detergent. Regularly washing and then rinsing both body and clothing is an essential part of good hygiene and health. Often people use soaps and detergents to assist in the emulsification of oils and dirt particles so they can be washed away. The soap can be applied directly, or with the aid of a washcloth or assisted with sponges or similar cleaning tools. In social contexts, washing refers to the act of bathing, or washing different parts of the body, such as hands, hair, or faces. Excessive washing may damage the hair, causing dandruff, or cause rough skin/skin lesions.", "wikipedia_url": "https://en.wikipedia.org/wiki/Washington%2C_D.C."}}, {"canonical_name": "parteyras", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "parteyras", "book_id": "polyanthea_medicinal", "name": "parteyras", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 3, "variants": ["parteyras", "Parteiras", "Parteyras"], "contexts": ["midwives, causing head issues in newborns", "medical practitioner"]}, {"entity_id": "parteiras", "book_id": "coloquios_da_orta_1563", "name": "parteiras", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["parteiras"], "contexts": ["midwives"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "parteyras", "target_book": "coloquios_da_orta_1563", "target_name": "parteiras", "similarity": 0.954}], "id": 1442, "stable_key": "clu_07f25d0376594a87", "ground_truth": {"modern_name": "midwife", "confidence": "high", "type": "person", "description": "Practitioner assisting in childbirth, sometimes causing newborn head issues.", "wikidata_id": "Q185196", "wikidata_description": "medical professional who practices obstetrics as a health science", "wikipedia_url": "https://en.wikipedia.org/wiki/Midwife"}}, {"canonical_name": "Vifco di quercia", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "vifco_di_quercia", "book_id": "ricettario_fiorentino_1597", "name": "Vifco di quercia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Vifco di quercia", "Vifco quercino"], "contexts": ["oak mistletoe", "oak mistletoe used in preparations"]}, {"entity_id": "viſco_quercino", "book_id": "polyanthea_medicinal", "name": "viſco quercino", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["viſco quercino", "Viſco quercedo"], "contexts": ["mistletoe, used in remedies", "powder ingredient"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Vifco di quercia", "target_book": "polyanthea_medicinal", "target_name": "viſco quercino", "similarity": 0.841}], "id": 1443, "stable_key": "clu_4886bcfeacdac7c5", "ground_truth": {"modern_name": "oak mistletoe", "confidence": "high", "type": "plant", "linnaean": "Viscum album var. album", "family": "Santalaceae", "note": "The primary referent is likely Viscum album, with 'quercino' indicating association with oak.", "wikidata_id": "Q144940", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Viscum%20album", "wikipedia_extract": "Oak mistletoe is a common name for several plants and may refer to: Phoradendron coryae, native to western North America Phoradendron leucarpum, native to central North America Phoradendron villosum, native to far western North America"}}, {"canonical_name": "pane buffetto", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "pane_buffetto", "book_id": "ricettario_fiorentino_1597", "name": "pane buffetto", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["pane buffetto", "pane"], "contexts": ["light white bread", "bread used in preparations"]}, {"entity_id": "pan", "book_id": "polyanthea_medicinal", "name": "Pan", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["pan", "Pan"], "contexts": ["cloth for straining", "pancreatic juice"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "pane buffetto", "target_book": "polyanthea_medicinal", "target_name": "Pan", "similarity": 0.837}], "id": 1444, "stable_key": "clu_f51d84d48e67a708", "ground_truth": {"modern_name": "straining cloth", "confidence": "medium", "type": "object", "note": "The term 'pane buffetto' literally means light white bread. However, given the context of 'straining' and the presence of 'Pan' in another cluster, it's more likely a cloth used for straining liquids, similar to a cheesecloth or sieve cloth.", "wikidata_id": "Q11460", "wikidata_description": "covering worn on the body", "wikipedia_url": "https://en.wikipedia.org/wiki/Clothing", "wikipedia_extract": "The kaupinam, kovanam, kaupina, langot, or lungooty is a loincloth worn by men in the Indian subcontinent as underclothing. It is still commonly worn in South Asia by pehlwans (wrestlers) while exercising or sparring in a dangal. It is basically a rectangular strip of cloth used to cover the genitals, with strings connected to the four ends of the cloth, for binding it around the waist and between the legs. The short type of lungooty worn by naga sadhus or babas often leaves the buttocks bare, it is also known as ''coopees''. It is still used extensively by Kalaripayattu (martial artists), bodyguards (ang-rakshaks) and wrestlers (pehelwans) in rural India, especially in games of Malla-yuddha and the medieval variation Pehlwani (a form of sparring from West Asia and South Asia). It is also worn during fitness training & sports coaching (kasrat); by men performing any form of physically straining activity and weight lifting such as farming."}}, {"canonical_name": "olio d'antimonio", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "olio_d'antimonio", "book_id": "ricettario_fiorentino_1597", "name": "olio d'antimonio", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["olio d'antimonio"], "contexts": ["oil of antimony, a distilled product", "distilled oil from antimony"]}, {"entity_id": "oleode_antimonio", "book_id": "polyanthea_medicinal", "name": "oleode Antimonio", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["oleode Antimonio"], "contexts": ["mixed with mercury oil"]}, {"entity_id": "antimony_oil", "book_id": "polyanthea_medicinal", "name": "Antimony oil", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Antimony oil"], "contexts": ["oil that is very beneficial"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "olio d'antimonio", "target_book": "polyanthea_medicinal", "target_name": "oleode Antimonio", "similarity": 0.944}, {"source_book": "ricettario_fiorentino_1597", "source_name": "olio d'antimonio", "target_book": "polyanthea_medicinal", "target_name": "Antimony oil", "similarity": 0.92}], "id": 1445, "stable_key": "clu_e4ea6e472f92c114", "ground_truth": {"modern_name": "antimony oil", "confidence": "high", "type": "chemical", "note": "This likely refers to a distilled preparation containing antimony compounds.", "wikidata_id": "Q1099", "wikidata_description": "chemical element with symbol Sb and atomic number of 51", "wikipedia_url": "https://en.wikipedia.org/wiki/Antimony", "wikipedia_extract": "Antimony is a chemical element with the symbol Sb (from Latin  stibium) and atomic number 51. A lustrous grey metal or metalloid, it occurs in nature mainly in the form of the sulfide mineral stibnite (Sb2S3). Antimony compounds have been known since ancient times and were powdered for use as medicine and cosmetics, often known by the Arabic name kohl. China is the largest producer of antimony and its compounds, with most production coming from the Xikuangshan Mine in Hunan. The industrial methods for refining antimony from stibnite are roasting followed by reduction with carbon, or direct reduction of stibnite with iron. The most common applications for metallic antimony are in alloys with lead and tin, which have improved properties for solders, bullets, and plain bearings."}}, {"canonical_name": "acqua rola", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "acqua_rola", "book_id": "ricettario_fiorentino_1597", "name": "acqua rola", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Acqua Rola", "acqua rola"], "contexts": ["rose water", "rose water, a common solvent and ingredient"]}, {"entity_id": "aguarolada", "book_id": "polyanthea_medicinal", "name": "aguaRolada", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["aguaRolada", "agua rolada"], "contexts": ["rolled water used in a preparation", "rolled water"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "acqua rola", "target_book": "polyanthea_medicinal", "target_name": "aguaRolada", "similarity": 0.916}], "id": 1446, "stable_key": "clu_92b7459405e05123", "ground_truth": {"modern_name": "rose water", "confidence": "high", "type": "chemical", "note": "While 'rolled water' is mentioned, the primary and more common referent in early modern texts is rose water.", "wikidata_id": "Q900450", "wikidata_description": "flavoured water made by steeping rose petals in water", "wikipedia_url": "https://en.wikipedia.org/wiki/Rose_water", "wikipedia_extract": "A rose is either a woody perennial flowering plant of the genus Rosa (), in the family Rosaceae (), or the flower it bears. There are over three hundred species and tens of thousands of cultivars. They form a group of plants that can be erect shrubs, climbing, or trailing, with stems that are often armed with sharp prickles. Their flowers vary in size and shape and are usually large and showy, in colours ranging from white through pinks, reds, oranges and yellows. Most species are native to Asia, with smaller numbers native to Europe, North America, and Northwest Africa. Species, cultivars and hybrids are all widely grown for their beauty and often are fragrant."}}, {"canonical_name": "hydroleo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "hydroleo", "book_id": "polyanthea_medicinal", "name": "hydroleo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["hydroleo", "hydreleo", "hydromel"], "contexts": ["oil and water mixture", "preparation for fomentation"]}, {"entity_id": "hydromalo", "book_id": "ricettario_fiorentino_1597", "name": "HYDROMALO", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["HYDROMALO"], "contexts": ["preparation name"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "hydroleo", "target_book": "ricettario_fiorentino_1597", "target_name": "HYDROMALO", "similarity": 0.852}], "id": 1447, "stable_key": "clu_223a143f96cf5131", "ground_truth": {"modern_name": "hydroleate", "confidence": "medium", "type": "chemical", "note": "The term 'hydroleo' suggests a mixture of water ('hydro') and oil ('leo'). 'HYDROMALO' is likely a variant or misspelling of a similar preparation, possibly related to apple juice or an emulsion."}}, {"canonical_name": "cibum", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "cibum", "book_id": "polyanthea_medicinal", "name": "cibum", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["cibum"], "contexts": ["food", "food substance"]}, {"entity_id": "cimge", "book_id": "ricettario_fiorentino_1597", "name": "Cimge", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Cimge"], "contexts": ["cimge"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "cibum", "target_book": "ricettario_fiorentino_1597", "target_name": "Cimge", "similarity": 0.881}], "id": 1448, "stable_key": "clu_6ca9698cd77d6e16", "ground_truth": {"modern_name": "food", "confidence": "high", "type": "concept", "note": "While 'cibum' is Latin for food, 'Cimge' is not a standard term and may be OCR noise or a very obscure term. The primary cluster meaning is food.", "wikidata_id": "Q2095", "wikidata_description": "any substance consumed to provide nutritional support for the body; form of energy stored in chemical", "wikipedia_extract": "Food is any substance consumed by an organism for nutritional support. Food usually consists of plant, animal, or fungal origin and contains essential nutrients such as carbohydrates, fats, proteins, vitamins, or minerals. The substance is ingested by an organism and assimilated by the organism's cells to provide energy, maintain life, or support growth. Different species of animals have different feeding behaviours that satisfy the needs of their metabolisms and have evolved to fill specific ecological niches within specific geographical contexts. Omnivorous humans are highly adaptable and have adapted to obtaining food in many different ecosystems. Humans generally use cooking to prepare food for consumption.", "wikipedia_url": "https://en.wikipedia.org/wiki/Food"}}, {"canonical_name": "veronica", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "veronica", "book_id": "polyanthea_medicinal", "name": "veronica", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Veronica", "veronica"], "contexts": ["common name for Abrotanum femina", "alternative name for abrotea"]}, {"entity_id": "veronica", "book_id": "connexion_physical_sciences_somerville_1858", "name": "veronica", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["veronica"], "contexts": ["flower found in Himalaya", "flower not found in Himalaya"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "veronica", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "veronica", "similarity": 0.921}], "id": 1449, "stable_key": "clu_ddbbb5d231e8daa1", "ground_truth": {"modern_name": "germander", "confidence": "high", "type": "plant", "linnaean": "Teucrium chamaedrys", "family": "Lamiaceae", "note": "In early modern European texts, 'veronica' often referred to Speedwell (Veronica officinalis). However, in the context of 'Abrotanum femina', it is more likely referring to Germander, specifically Teucrium species, which were sometimes confused or grouped with 'Abrotanum'.", "wikidata_id": "Q157714", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Teucrium"}}, {"canonical_name": "celestial body", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "celestial_body", "book_id": "connexion_physical_sciences_somerville_1858", "name": "celestial body", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["celestial body"], "contexts": ["object in outer space", "object in space"]}, {"entity_id": "heavenly_bodies", "book_id": "first_principles_spencer_1862", "name": "heavenly bodies", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["heavenly bodies"], "contexts": ["celestial objects like planets and stars"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "celestial body", "target_book": "first_principles_spencer_1862", "target_name": "heavenly bodies", "similarity": 0.964}], "id": 1450, "stable_key": "clu_ab4d7470088509bb", "ground_truth": {"modern_name": "Celestial body", "confidence": "high", "type": "concept", "wikidata_id": "Q6999", "wikidata_description": "physical body of astronomically-significant size, mass, or role, naturally occurring in a universe", "wikipedia_url": "https://en.wikipedia.org/wiki/Astrological_sign", "wikipedia_extract": "In Western astrology, astrological signs are the zodiac, twelve 30-degree sectors that are crossed by the Sun's 360-degree orbital path as viewed from Earth in its sky. The signs enumerate from the first day of spring, known as the First Point of Aries, which is the vernal equinox. The astrological signs are Aries, Taurus, Gemini, Cancer, Leo, Virgo, Libra, Scorpio, Sagittarius, Capricorn, Aquarius, and Pisces. The Western zodiac originated in Babylonian astrology, and was later influenced by the Hellenistic culture. Each sign was named after a constellation the sun annually moved through while crossing the sky. This observation is emphasized in the simplified and popular sun sign astrology."}}, {"canonical_name": "auricle", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "auricle", "book_id": "first_principles_spencer_1862", "name": "auricle", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 3, "variants": ["auricle"], "contexts": ["receiving portion of heart cavity", "part of the heart"]}, {"entity_id": "aureola", "book_id": "connexion_physical_sciences_somerville_1858", "name": "aureola", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["aureola"], "contexts": ["ring of light around the sun"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "auricle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "aureola", "similarity": 0.867}], "id": 1451, "stable_key": "clu_ae56b9380f40f26e", "ground_truth": {"modern_name": "Auricle", "confidence": "medium", "type": "anatomy", "note": "The term 'auricle' can refer to both a part of the heart and a part of the ear. The context 'ring of light around the sun' suggests it's being used metaphorically or in relation to optical phenomena.", "wikipedia_extract": "Otoplasty, from Ancient Greek οὖς (oûs), meaning \"ear\", and πλαστός (plastós), meaning \"moulded\", is a procedure for correcting the deformities and defects of the auricle (external ear), whether these defects are congenital conditions (e.g. microtia, anotia, etc.) or caused by trauma. Otoplastic surgeons may reshape, move, or augment the cartilaginous support framework of the auricle to correct these defects. Congenital ear deformities occasionally overlap with other medical conditions (e.g. Treacher Collins syndrome and hemifacial microsomia). Otoplasty (surgery of the ear) was developed in ancient India and is described in the medical compendium, the Sushruta Samhita (Sushruta's Compendium, c.", "wikipedia_url": "https://en.wikipedia.org/wiki/Otoplasty"}}, {"canonical_name": "Mandrake", "category": "PLANT", "subcategory": "ROOT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mandrake", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mandrake", "category": "PLANT", "subcategory": "ROOT", "count": 2, "variants": ["Mandrake"], "contexts": ["plant root", "root representing mankind"]}, {"entity_id": "mandrake", "book_id": "english_physician_1652", "name": "Mandrake", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Mandrake"], "contexts": ["herb with narcotic properties"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mandrake", "target_book": "english_physician_1652", "target_name": "Mandrake", "similarity": 0.824}], "id": 1452, "stable_key": "clu_3f9c1b79d8c26477", "ground_truth": {"modern_name": "Mandrake", "confidence": "high", "type": "plant", "linnaean": "Mandragora officinarum", "family": "Solanaceae", "wikidata_id": "Q2651366", "wikidata_description": "plant root", "wikipedia_url": "https://en.wikipedia.org/wiki/Mandragora_officinarum", "wikipedia_extract": "Mandragora officinarum is the type species of the plant genus Mandragora in the nightshade family Solanaceae. It is often known as mandrake, although this name is also used for other plants. As of 2015, sources differed significantly in the species they use for Mandragora plants native to the Mediterranean region. The main species found around the Mediterranean is called Mandragora autumnalis, the autumn mandrake. In a broader circumscription, all the plants native to the regions around the Mediterranean Sea are placed in M. officinarum, which thus includes M."}}, {"canonical_name": "rarity of the air", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "rarity_of_the_air", "book_id": "connexion_physical_sciences_somerville_1858", "name": "rarity of the air", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["rarity of the air"], "contexts": ["suffered by Gay-Lussac", "low atmospheric density"]}, {"entity_id": "rarity", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Rarity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Rarity"], "contexts": ["quality of being uncommon"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "rarity of the air", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Rarity", "similarity": 0.818}], "id": 1453, "stable_key": "clu_bc1e2f3fc6f945a3", "ground_truth": {"modern_name": "Rarity of air", "confidence": "high", "type": "concept"}}, {"canonical_name": "Dove", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "dove", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Dove", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["Dove"], "contexts": ["bird with no gall, symbol of meekness", "symbol of meekness and lenity"]}, {"entity_id": "dovecot-pigeon", "book_id": "origin_of_species_darwin_1859", "name": "dovecot-pigeon", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["dovecot-pigeon"], "contexts": ["domesticated rock-pigeon"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Dove", "target_book": "origin_of_species_darwin_1859", "target_name": "dovecot-pigeon", "similarity": 0.816}], "id": 1454, "stable_key": "clu_9202d037fd8e08c9", "ground_truth": {"modern_name": "Dove", "confidence": "high", "type": "animal", "wikipedia_extract": "Columbidae is a bird family consisting of doves and pigeons. It is the only family in the order Columbiformes. These are stout-bodied birds with small heads, relatively short necks and slender bills that in some species feature fleshy ceres. They feed largely on plant matter, feeding on seeds (granivory), fruit (frugivory), and foliage (folivory). In colloquial English, the smaller species tend to be called \"doves\", and the larger ones \"pigeons\", although the distinction is not consistent, and there is no scientific separation between them. Historically, the common names for these birds involve a great deal of variation."}}, {"canonical_name": "Pea-hens", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pea-hens", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Pea-hens", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["Pea-hens"], "contexts": ["birds whose daily incubation is testified", "birds used in incubation experiments"]}, {"entity_id": "peacock", "book_id": "origin_of_species_darwin_1859", "name": "peacock", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["peacock"], "contexts": ["bird not easily reared"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Pea-hens", "target_book": "origin_of_species_darwin_1859", "target_name": "peacock", "similarity": 0.847}], "id": 1455, "stable_key": "clu_aeaa3375b122a154", "ground_truth": {"modern_name": "Peahen", "confidence": "high", "type": "animal", "wikidata_id": "Q178202", "wikidata_description": "species of fish, the guppy", "wikipedia_extract": "Peafowl is a common name for two bird species of the genus Pavo and one species of the closely related genus Afropavo within the tribe Pavonini of the family Phasianidae (the pheasants and their allies). Male peafowl are referred to as peacocks, and female peafowl are referred to as peahens. Despite this, peacock is usually used to refer to both sexes, in common language. The two Asiatic species are the blue or Indian peafowl originally from the Indian subcontinent, and the green peafowl from Southeast Asia. The third peafowl species, the Congo peafowl, is native only to the Congo Basin. Male peafowl are known for their piercing calls and their extravagant plumage.", "wikipedia_url": "https://en.wikipedia.org/wiki/Guppy"}}, {"canonical_name": "Stork", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "stork", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Stork", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["Stork"], "contexts": ["bird honored for destroying serpents"]}, {"entity_id": "storks", "book_id": "origin_of_species_darwin_1859", "name": "storks", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["storks"], "contexts": ["birds that ate fish containing seeds"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Stork", "target_book": "origin_of_species_darwin_1859", "target_name": "storks", "similarity": 0.942}], "id": 1456, "stable_key": "clu_1d377c238af1f2f4", "ground_truth": {"modern_name": "Stork", "confidence": "high", "type": "animal", "wikidata_id": "Q28507", "wikidata_description": "family of birds; type of bird with long neck, long legs and a big beak", "wikipedia_extract": "The shoebill (Balaeniceps rex), also known as the whale-headed stork, whalebill, and shoe-billed stork, is a large long-legged wading bird. Its name comes from its enormous shoe-shaped bill. It has a somewhat stork-like overall form and was previously classified as a stork in the order Ciconiiformes; but genetic evidence places it with pelicans and herons in the Pelecaniformes. Adults are mainly grey while juveniles are more brown. It lives in tropical East Africa in large swamps from South Sudan to Zambia. The shoebill may have been known to Ancient Egyptians but was not classified by Europeans until the 19th century, after skins and eventually live specimens were brought to Europe.", "wikipedia_url": "https://en.wikipedia.org/wiki/Stork"}}, {"canonical_name": "Missel-thrush", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "missel-thrush", "book_id": "origin_of_species_darwin_1859", "name": "Missel-thrush", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["missel-thrush", "Missel-thrush"], "contexts": ["bird species"]}, {"entity_id": "missel_trush", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Missel Trush", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Missel Trush"], "contexts": ["kind of thrush that feeds on mistletoe"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Missel-thrush", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Missel Trush", "similarity": 0.947}], "id": 1457, "stable_key": "clu_63824bf4ef24c04c", "ground_truth": {"modern_name": "Mistletoe thrush", "confidence": "high", "type": "animal", "wikipedia_extract": "Thrush (1902–13 December 1925) was a British Thoroughbred racehorse. He was trained by E. Robson and won fifteen of his twenty-two starts. His wins included the Great Foal Plate, Sussex Stakes, King's Stand Stakes and July Cup. Thrush was owned by Captain J. Orr-Ewing.", "wikipedia_url": "https://en.wikipedia.org/wiki/Thrush_(racehorse)"}}, {"canonical_name": "seal", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "seal", "book_id": "origin_of_species_darwin_1859", "name": "seal", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["seal"], "contexts": ["animal with flipper bones", "mammal with flippers"]}, {"entity_id": "seal", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Seal", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Seal"], "contexts": ["animal skin with protective quality"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "seal", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Seal", "similarity": 0.94}], "id": 1458, "stable_key": "clu_04d4ed60b7275b05", "ground_truth": {"modern_name": "Seal", "confidence": "high", "type": "animal", "wikidata_id": "Q162919", "wikidata_description": "mark of a personal distinctive emblem intended to guarantee the authenticity of the author of a document onto which it is printed, embossed or affixed", "wikipedia_url": "https://en.wikipedia.org/wiki/Seal%20%28emblem%29"}}, {"canonical_name": "squirrels", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "squirrels", "book_id": "origin_of_species_darwin_1859", "name": "squirrels", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["squirrels"], "contexts": ["family of mammals with varying tail and skin structures", "rodent with specific structure"]}, {"entity_id": "squirrel", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Squirrel", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Squirrel"], "contexts": ["viviparous animal with clavicles"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "squirrels", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Squirrel", "similarity": 0.961}], "id": 1459, "stable_key": "clu_5af33790ae184a38", "ground_truth": {"modern_name": "Squirrel", "confidence": "high", "type": "animal", "wikidata_id": "Q1302028", "wikidata_description": "heraldic animal"}}, {"canonical_name": "silkworm", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "silkworm", "book_id": "origin_of_species_darwin_1859", "name": "silkworm", "category": "ANIMAL", "subcategory": "INSECT", "count": 2, "variants": ["silkworm"], "contexts": ["larva of a moth producing silk", "larva producing silk"]}, {"entity_id": "silk-worms", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Silk-worms", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["Silk-worms"], "contexts": ["insects whose seed hatched on women"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "silkworm", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Silk-worms", "similarity": 0.952}], "id": 1460, "stable_key": "clu_b3d214ab40381691", "ground_truth": {"modern_name": "Silkworm", "confidence": "high", "type": "animal", "wikidata_id": "Q134747", "wikidata_description": "insect from the moth family", "wikipedia_url": "https://en.wikipedia.org/wiki/Bombyx_mori", "wikipedia_extract": "Bombyx mori, commonly known as the domestic silk moth, is a domesticated moth species belonging to the family Bombycidae. It is the closest relative of Bombyx mandarina, the wild silk moth. Silkworms are the larvae of silk moths. The silkworm is of particular economic value, being a primary producer of silk. The silkworm's preferred food are the leaves of white mulberry, though they may eat other species of mulberry, and even leaves of other plants. Domestic silk moths are entirely dependent on humans for reproduction, as a result of millennia of selective breeding."}}, {"canonical_name": "Italian", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "italian", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Italian", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Italian"], "contexts": ["language of a tract"]}, {"entity_id": "italian_cities", "book_id": "kosmos_humboldt_1845", "name": "Italian cities", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Italian cities"], "contexts": ["locations covered by volcanic ash"]}, {"entity_id": "italian_peninsula", "book_id": "kosmos_humboldt_1845", "name": "Italian peninsula", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Italian peninsula"], "contexts": ["peninsula in Europe"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Italian", "target_book": "kosmos_humboldt_1845", "target_name": "Italian cities", "similarity": 0.86}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Italian", "target_book": "kosmos_humboldt_1845", "target_name": "Italian peninsula", "similarity": 0.884}], "id": 1461, "stable_key": "clu_5e0445bf49846b88", "ground_truth": {"modern_name": "Italy", "confidence": "high", "type": "place", "country": "Italy", "note": "The context 'Italian cities' and 'Italian peninsula' strongly suggest the geographical entity rather than just the adjective.", "wikidata_id": "Q38", "wikidata_description": "country in southern Europe", "wikipedia_extract": "Italy, officially the Italian Republic, is a country in Southern and Western Europe. It consists of a peninsula that extends into the Mediterranean Sea, with the Alps on its northern land border, as well as nearly 800 islands, notably Sicily and Sardinia. Italy shares land borders with France to the west; Switzerland and Austria to the north; Slovenia to the east; and the two enclaves of Vatican City and San Marino. It is the tenth-largest country in Europe by area, covering 301,340 km2 (116,350 sq mi), and the third-most populous member state of the European Union, with nearly 59 million inhabitants. Italy's capital and largest city is Rome; other major cities include Milan, Naples, Turin, Palermo, Bologna, Florence, Genoa, and Venice. The history of Italy goes back to numerous Italic peoples, notably including the ancient Romans, who conquered the Mediterranean world during the Roman Republic and ruled it for centuries during the Roman Empire."}}, {"canonical_name": "académie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "académie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "académie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["académie"], "contexts": ["the academy", "institution that charged Richer"]}, {"entity_id": "academical", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Academical", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Academical"], "contexts": ["related to academic study or reservation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "académie", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Academical", "similarity": 0.889}], "id": 1462, "stable_key": "clu_8605617df6fb8f8b", "ground_truth": {"modern_name": "Academy", "confidence": "high", "type": "concept", "note": "The French 'académie' and English 'Academical' refer to institutions of learning or the concept of academic study.", "wikidata_id": "Q70363582", "wikidata_description": "organizations representing specialized fields and accepted as authoritative", "wikipedia_extract": "An academy (Attic Greek: Ἀκαδήμεια; Koine Greek: Ἀκαδημία) is an institution of tertiary education. The name traces back to Plato's school of philosophy, founded c. 386 BC at Akademia, a sanctuary of Athena, the goddess of wisdom and skill, north of Athens, Greece. The Royal Spanish Academy defines an academy as a scientific, literary or artistic society established with public authority and as a teaching establishment, public or private, of a professional, artistic, technical or simply practical nature. The word comes from the Academy in ancient Greece, which derives from the Athenian hero, Akademos. Outside the city walls of Athens, the gymnasium was made famous by Plato as a center of learning. The sacred space, dedicated to the goddess of wisdom, Athena, had formerly been an olive grove, hence the expression \"the groves of Academe\"."}}, {"canonical_name": "Ulysses", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ulysses", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ulysses", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Ulysses"], "contexts": ["hero of Homer's Odyssey", "mythological figure with a long-lived dog"]}, {"entity_id": "ulysses", "book_id": "principles_of_psychology_james_1890", "name": "Ulysses", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Ulysses"], "contexts": ["hero of Homer's Odyssey"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ulysses", "target_book": "principles_of_psychology_james_1890", "target_name": "Ulysses", "similarity": 0.796}], "id": 1463, "stable_key": "clu_2a551407b60fa075", "ground_truth": {"modern_name": "Ulysses", "confidence": "high", "type": "person", "description": "Hero of Homer's Odyssey, a classical literary figure.", "wikidata_id": "Q47231", "wikidata_description": "legendary Greek king of Ithaca"}}, {"canonical_name": "Syllogysm", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "syllogysm", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Syllogysm", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Syllogysm"], "contexts": ["form of logical argument"]}, {"entity_id": "syllogism", "book_id": "principles_of_psychology_james_1890", "name": "syllogism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["syllogism"], "contexts": ["form of logical argument"]}, {"entity_id": "syllogisms", "book_id": "principles_of_psychology_james_1890", "name": "syllogisms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["syllogisms"], "contexts": ["logical arguments with premises and conclusion"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Syllogysm", "target_book": "principles_of_psychology_james_1890", "target_name": "syllogism", "similarity": 0.872}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Syllogysm", "target_book": "principles_of_psychology_james_1890", "target_name": "syllogisms", "similarity": 0.878}], "id": 1464, "stable_key": "clu_805621c13e0e6692", "ground_truth": {"modern_name": "Syllogism", "confidence": "high", "type": "concept", "wikidata_id": "Q615599", "wikidata_description": "Aristotle's logical theory", "wikipedia_extract": "In logic and formal semantics, term logic, also known as traditional logic, syllogistic logic or Aristotelian logic, is a loose name for an approach to formal logic that began with Aristotle and was developed further in ancient history mostly by his followers, the Peripatetics. It was revived after the third century CE by Porphyry's Isagoge. Term logic revived in medieval times, first in Islamic logic by Alpharabius in the tenth century, and later in Christian Europe in the twelfth century with the advent of new logic, remaining dominant until the advent of predicate logic in the late nineteenth century. However, even if eclipsed by newer logical systems, term logic still plays a significant role in the study of logic. Rather than radically breaking with term logic, modern logics typically expand it. Aristotle's logical work is collected in the six texts that are collectively known as the Organon.", "wikipedia_url": "https://en.wikipedia.org/wiki/Term_logic"}}, {"canonical_name": "Physiology of Mind", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "physiology_of_mind", "book_id": "principles_of_psychology_james_1890", "name": "Physiology of Mind", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 2, "variants": ["Physiology of Mind"], "contexts": ["book by H. Maudsley", "book title"]}, {"entity_id": "physiologie", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Physiologie", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Physiologie"], "contexts": ["book by Epiphanius on animal nature"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Physiology of Mind", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Physiologie", "similarity": 0.859}], "id": 1465, "stable_key": "clu_32d5953690a610ef", "ground_truth": {"modern_name": "Physiology of Mind", "confidence": "high", "type": "text", "note": "This refers to a specific book or field of study, not a general organization. The Portuguese 'Physiologie' in the context of animal nature also points to the study of biological processes."}}, {"canonical_name": "Chapter XII", "category": "OTHER_ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "chapter_xii", "book_id": "principles_of_psychology_james_1890", "name": "Chapter XII", "category": "OTHER_ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 2, "variants": ["Chapter XII"], "contexts": ["section of a text", "section of the book"]}, {"entity_id": "chapter_xi", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "CHAPTER XI", "category": "OTHER_ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["CHAPTER XI"], "contexts": ["section heading"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Chapter XII", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "CHAPTER XI", "similarity": 0.916}], "id": 1466, "stable_key": "clu_0925dc2742893156", "ground_truth": {"modern_name": "Chapter", "confidence": "high", "type": "concept", "note": "These refer to sections or chapters within texts, not formal organizations.", "wikidata_id": "Q216285", "wikidata_description": "body of clergy in Roman Catholic, Anglican, and Nordic Lutheran churches", "wikipedia_url": "https://en.wikipedia.org/wiki/The_Pastures_of_Heaven", "wikipedia_extract": "The Pastures of Heaven is a short story cycle by John Steinbeck published by Brewer, Warren and Putnam  in 1932. This episodic collection is composed of ten self-contained but related stories set in the Corral de Tierra of the Salinas Valley of California. The Pastures of Heaven was said by one critic \"to rival The Long Valley (1938) as Steinbeck's major achievement in short fiction\". The stories are presented here as per literary critics Richard. S. Hughes and Warren French."}}, {"canonical_name": "De Lapidibus & Gemmis", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "de_lapidibus_&_gemmis", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "De Lapidibus & Gemmis", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 2, "variants": ["De Lapidibus & Gemmis"], "contexts": ["tract on stones and gems", "treatise on stones and gems"]}, {"entity_id": "de_lapidibus", "book_id": "kosmos_humboldt_1845", "name": "De Lapidibus", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["De Lapidibus"], "contexts": ["ancient treatise on stones"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "De Lapidibus & Gemmis", "target_book": "kosmos_humboldt_1845", "target_name": "De Lapidibus", "similarity": 0.891}], "id": 1467, "stable_key": "clu_ee2db9273a5b2e7d", "ground_truth": {"modern_name": "De Lapidibus et Gemmis", "confidence": "high", "type": "text", "note": "This is the title of a specific ancient text about stones and gems, not a modern organization."}}, {"canonical_name": "cubit", "category": "ANATOMY", "subcategory": "BODY_PART", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cubit", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "cubit", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 2, "variants": ["cubit"], "contexts": ["part of the arm", "forearm bone, measured from elbow"]}, {"entity_id": "cubiti", "book_id": "kosmos_humboldt_1845", "name": "cubiti", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["cubiti"], "contexts": ["ancient unit of length"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "cubit", "target_book": "kosmos_humboldt_1845", "target_name": "cubiti", "similarity": 0.935}], "id": 1468, "stable_key": "clu_888d1376863b2b7a", "ground_truth": {"modern_name": "Cubit", "confidence": "high", "type": "concept", "note": "Refers both to a body part (forearm) and an ancient unit of length.", "wikidata_id": "Q15984008", "wikidata_description": "subfamily of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Cubitermitinae", "wikipedia_extract": "The cubit is an ancient unit of length based on the distance from the elbow to the tip of the middle finger. It was primarily associated with the Sumerians, Egyptians, and Israelites. The term cubit is found in the Bible regarding Noah's Ark, the Ark of the Covenant, the Tabernacle, and Solomon's Temple. The common cubit was divided into 6 palms × 4 fingers = 24 digits. Royal cubits added a palm for 7 palms × 4 fingers = 28 digits. These lengths typically ranged from 44.4 to 52.92 cm (1 ft 5+1⁄2 in to 1 ft 8+13⁄16 in), with an ancient Roman cubit being as long as 120 cm (3 ft 11 in)."}}, {"canonical_name": "Politica", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "politica", "book_id": "kosmos_humboldt_1845", "name": "Politica", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 2, "variants": ["Politica"], "contexts": ["Aristotle's work on politics"]}, {"entity_id": "politicks", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Politicks", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Politicks"], "contexts": ["Aristotle's work mentioned in sidenote"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Politica", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Politicks", "similarity": 0.915}], "id": 1469, "stable_key": "clu_6f6b013d46d3962b", "ground_truth": {"modern_name": "Politics", "confidence": "high", "type": "text", "note": "This refers to Aristotle's philosophical work, not a modern organization.", "wikidata_id": "Q129796500", "wikidata_description": "scholarly article published in 2018", "wikipedia_extract": "Raúl Ricardo Alfonsín (Spanish pronunciation: [raˈul  alfonˈsin] ; 12 March 1927 – 31 March 2009) was an Argentine lawyer and statesman who served as president of Argentina from 10 December 1983 to 8 July 1989. He was the first democratically elected president after the National Reorganization Process. Ideologically, he identified as a radical and a social democrat, serving as the leader of the Radical Civic Union from 1983 to 1991, 1993 to 1995, 1999 to 2001 . His political approach was known as \"Alfonsinism\". Born in Chascomús, Buenos Aires Province, Alfonsín began his studies of law at the National University of La Plata and was a graduate of the University of Buenos Aires. He was affiliated with the Radical Civic Union (UCR), joining the faction of Ricardo Balbín after the party split.", "wikipedia_url": "https://en.wikipedia.org/wiki/Raúl_Alfonsín"}}, {"canonical_name": "Thales", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "thales", "book_id": "kosmos_humboldt_1845", "name": "Thales", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Thales"], "contexts": ["ancient philosopher", "Ancient Greek philosopher, founder of Ionic natural philosophy"]}, {"entity_id": "thales", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Thales", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Thales"], "contexts": ["ancient Greek philosopher"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Thales", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Thales", "similarity": 1.0}], "id": 1470, "stable_key": "clu_83744f614d086d4b", "ground_truth": {"modern_name": "Thales", "confidence": "high", "type": "person", "birth_year": -624, "death_year": -546, "description": "Ancient Greek philosopher and one of the Seven Sages of Greece.", "wikipedia_extract": "Thales of Miletus ( THAY-leez; Ancient Greek: Θαλῆς; c. 626/623  – c. 548/545 BC) was an Ancient Greek pre-Socratic philosopher from Miletus in Ionia, Asia Minor. Thales was one of the Seven Sages, founding figures of Ancient Greece. Beginning in eighteenth-century historiography, many came to regard him as the first philosopher in the Greek tradition, breaking from the prior use of mythology to explain the world and instead using natural philosophy. He is thus otherwise referred to as the first to have engaged in mathematics, science, and deductive reasoning.", "wikipedia_url": "https://en.wikipedia.org/wiki/Thales_of_Miletus"}}, {"canonical_name": "Tyrrhenian Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tyrrhenian_sea", "book_id": "kosmos_humboldt_1845", "name": "Tyrrhenian Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Tyrrhenian Sea"], "contexts": ["sea between Italy and islands", "sea guiding mariners"]}, {"entity_id": "thuscan_sea", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Thuscan Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Thuscan Sea"], "contexts": ["sea where Elba is located"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Tyrrhenian Sea", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Thuscan Sea", "similarity": 0.844}], "id": 1471, "stable_key": "clu_b72e3a6e48b65aab", "ground_truth": {"modern_name": "Tyrrhenian Sea", "confidence": "high", "type": "place", "country": "Italy", "note": "'Thuscan Sea' is an older variant of the Tyrrhenian Sea.", "wikidata_id": "Q38882", "wikidata_description": "part of the Mediterranean Sea off the western coast of Italy", "wikipedia_url": "https://en.wikipedia.org/wiki/Tyrrhenian_Sea"}}, {"canonical_name": "Saturno", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "saturno", "book_id": "historia_medicinal_monardes_1574", "name": "Saturno", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Saturno"], "contexts": ["planet influencing disease", "planetary influence on disease"]}, {"entity_id": "saturn", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Saturn", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Saturn"], "contexts": ["Roman god"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Saturno", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Saturn", "similarity": 0.987}], "id": 1472, "stable_key": "clu_4980c2e5d63a508c", "ground_truth": {"modern_name": "Saturn", "confidence": "high", "type": "person", "description": "Roman god of agriculture and time; also a planet.", "note": "Refers to both the Roman deity and the planet, which had astrological significance.", "wikipedia_extract": "Saturn is the sixth planet from the Sun and the second largest in the Solar System, after Jupiter. It is a gas giant, with an average radius of about 9 times that of Earth. It has an eighth of the average density of Earth, but is over 95 times more massive. Even though Saturn is almost as big as Jupiter, Saturn has less than a third of its mass. Saturn orbits the Sun at a distance of 9.59 AU (1,434 million km), with an orbital period of 29.45 years. Saturn's interior is thought to be composed of a rocky core, surrounded by a deep layer of metallic hydrogen, an intermediate layer of liquid hydrogen and liquid helium, and an outer layer of gas."}}, {"canonical_name": "Cleopatra", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cleopatra", "book_id": "historia_medicinal_monardes_1574", "name": "Cleopatra", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Cleopatra"], "contexts": ["historical figure", "drank poison to avoid triumph of Pompey"]}, {"entity_id": "cleopatra", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Cleopatra", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Cleopatra"], "contexts": ["historical figure associated with Anthony"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Cleopatra", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Cleopatra", "similarity": 1.0}], "id": 1473, "stable_key": "clu_dfbd268074b00e89", "ground_truth": {"modern_name": "Cleopatra", "confidence": "high", "type": "person", "birth_year": -69, "death_year": -30, "description": "Last active ruler of the Ptolemaic Kingdom of Egypt.", "wikipedia_extract": "Cleopatra VII Thea Philopator (Koine Greek: Κλεοπάτρα Θεά Φιλοπάτωρ, lit. 'Cleopatra father-loving goddess'; 70/69 BC – 10 or 12 August 30 BC) was Queen of the Ptolemaic Kingdom of Egypt from 51 to 30 BC, and the last active Hellenistic pharaoh. A member of the Ptolemaic dynasty, she was a descendant of its founder Ptolemy I Soter, a Macedonian Greek general and companion of Alexander the Great. Her first language was Koine Greek, and she is the only Ptolemaic ruler known to have learned the Egyptian language, among several others. After her death, Egypt became a province of the Roman Empire, marking the end of the Hellenistic period in the Mediterranean, which had begun during the reign of Alexander (336–323 BC). Born in Alexandria, Cleopatra was the daughter of Ptolemy XII Auletes, who named her his heir before his death in 51 BC.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cleopatra"}}, {"canonical_name": "Scepticism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "scepticism", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Scepticism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Scepticism"], "contexts": ["obstinate and irrational doubt", "attitude of doubt towards knowledge"]}, {"entity_id": "scepticismo_scientifíco", "book_id": "coloquios_da_orta_1563", "name": "scepticismo scientifíco", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["scepticismo scientifíco"], "contexts": ["scientific skepticism"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Scepticism", "target_book": "coloquios_da_orta_1563", "target_name": "scepticismo scientifíco", "similarity": 0.93}], "id": 1474, "stable_key": "clu_292ef8b16c2e68f1", "ground_truth": {"modern_name": "Skepticism", "confidence": "high", "type": "concept", "wikidata_id": "Q1395219", "wikidata_description": "questioning attitude or doubt toward knowledge claims that are seen as mere belief or dogma", "wikipedia_url": "https://en.wikipedia.org/wiki/Skepticism", "wikipedia_extract": "Skepticism (US) or scepticism (UK) is a questioning attitude or doubt toward knowledge claims that are seen as mere belief or dogma. For example, if a person is skeptical about claims made by their government about an ongoing war then the person doubts that these claims are accurate. In such cases, skeptics normally recommend not disbelief but suspension of belief, i.e. maintaining a neutral attitude that neither affirms nor denies the claim. This attitude is often motivated by the impression that the available evidence is insufficient to support the claim. Formally, skepticism is a topic of interest in philosophy, particularly epistemology."}}, {"canonical_name": "Phoenix", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "phoenix", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Phoenix", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Phoenix"], "contexts": ["mythical bird used in arguments", "mythological bird mentioned by poets"]}, {"entity_id": "phoenix", "book_id": "coloquios_da_orta_1563", "name": "Phoenix", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["Phoenix"], "contexts": ["mythical bird burning in fire"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Phoenix", "target_book": "coloquios_da_orta_1563", "target_name": "Phoenix", "similarity": 0.954}], "id": 1475, "stable_key": "clu_2502712c4b33cdb6", "ground_truth": {"modern_name": "Phoenix", "confidence": "high", "type": "animal", "note": "Referenced as a mythical creature.", "wikidata_id": "Q27685", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Phoenix%20%28plant%29"}}, {"canonical_name": "Ophir", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ophir", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ophir", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Ophir"], "contexts": ["location for gold", "supposed location in the Indies"]}, {"entity_id": "ophir", "book_id": "coloquios_da_orta_1563", "name": "Ophir", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Ophir"], "contexts": ["legendary land"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ophir", "target_book": "coloquios_da_orta_1563", "target_name": "Ophir", "similarity": 1.0}], "id": 1476, "stable_key": "clu_5db6092025ede168", "ground_truth": {"modern_name": "Ophir", "confidence": "high", "type": "place", "country": "Unknown", "note": "Legendary biblical location, precise modern country is unknown.", "wikidata_id": "Q914073", "wikidata_description": "Biblical port famous for its wealth", "wikipedia_url": "https://en.wikipedia.org/wiki/Ophir", "wikipedia_extract": "Ophir (; Hebrew: אוֹפִיר, Modern: ʼŌfīr, Tiberian: ʼŌp̄īr) is a port or region mentioned in the Bible, famous for its wealth. Its existence is attested to by an inscribed pottery shard found at Tell Qasile (in modern-day Tel Aviv) in 1946, dating to the eighth century BC, which reads \"gold of Ophir to/for Beth-Horon [...] 30 shekels\". The location of Ophir is unknown, though the find confirms it as a real place which exported gold. Ophir in Genesis 10 (the Table of Nations) is said to be the name of one of the sons of Joktan. The Books of Kings and Chronicles tell of a joint expedition to Ophir by King Solomon and the Tyrian king Hiram I from Ezion-Geber, a port on the Red Sea, that brought back large amounts of gold, precious stones and 'algum wood' and of a later failed expedition by king Jehoshaphat of Judah. The famous 'gold of Ophir' is referenced in several other books of the Hebrew Bible, in particular Isaiah 13:12 refers to the \"golden wedge of Ophir\"."}}, {"canonical_name": "Memphis", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "memphis", "book_id": "coloquios_da_orta_1563", "name": "Memphis", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Memphis"], "contexts": ["celebre city, debated location", "city"]}, {"entity_id": "memphis", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Memphis", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Memphis"], "contexts": ["ancient Egyptian city"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Memphis", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Memphis", "similarity": 1.0}], "id": 1477, "stable_key": "clu_791f81929c365d60", "ground_truth": {"modern_name": "Memphis", "confidence": "high", "type": "place", "country": "Egypt", "wikidata_id": "Q5715", "wikidata_description": "ancient capital of Inebu-hedj, Egypt"}}, {"canonical_name": "agnus castus", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "agnus_castus", "book_id": "coloquios_da_orta_1563", "name": "agnus castus", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["agnus castus", "agno casto"], "contexts": ["plant that weakens Venus's influence", "herb"]}, {"entity_id": "agnus_castus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Agnus Castus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Agnus Castus"], "contexts": ["plant name, synonym for Vitex"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "agnus castus", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Agnus Castus", "similarity": 0.85}], "id": 1478, "stable_key": "clu_3b53b908937b1dbf", "ground_truth": {"modern_name": "Chaste tree", "confidence": "high", "type": "plant", "linnaean": "Vitex agnus-castus L.", "family": "Verbenaceae", "wikipedia_extract": "Vitex is a genus of flowering plants in the family Lamiaceae. It has about 200–250 species; as of August 2025 the Plants of the World Online database accepts 211 species. Common names include chaste tree or chastetree, traditionally referring to V. agnus-castus, but often applied to other species, as well, and pūriri for the New Zealand species V. lucens. Species of Vitex are native throughout the tropics and subtropics, with a few species in warm-temperate Eurasia and one in New Zealand.", "wikipedia_url": "https://en.wikipedia.org/wiki/Vitex"}}, {"canonical_name": "toscano", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "toscano", "book_id": "coloquios_da_orta_1563", "name": "toscano", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["toscano"], "contexts": ["Language in which Pliny was understood", "language in which Pliny was read"]}, {"entity_id": "tuscan", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Tuscan", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Tuscan"], "contexts": ["related to Etruscan divination practices"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "toscano", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Tuscan", "similarity": 0.885}], "id": 1479, "stable_key": "clu_fda0391dd0e002bb", "ground_truth": {"modern_name": "Tuscan", "confidence": "medium", "type": "concept", "note": "Could refer to Tuscan language or a broader concept of Etruscan practices.", "wikidata_id": "Q1990745", "wikidata_description": "Italo-Dalmatian variety mainly spoken in the central Italy", "wikipedia_extract": "Tuscan (Italian: toscano [djaˈlɛtto tosˈkaːno; di.a-]; locally: vernacolo) is a set of Italo-Dalmatian varieties of Romance spoken in Tuscany, Corsica, and Sardinia. Tuscan, especially its Florentine variety, formed the basis for establishing Standard Italian. Due mostly to the prestige of the works by Dante Alighieri, Petrarch, Giovanni Boccaccio, Niccolò Machiavelli, and Francesco Guicciardini, the Tuscan-derived elaboration became the primary language of culture throughout Italy, and later the official language of all of the historic Italian states and then of the Kingdom of Italy when it was formed. In De vulgari eloquentia (c. 1300), Dante Alighieri distinguishes four main variants of the Tuscan language: fiorentino (Florence), senese (Siena), lucchese (Lucca), and aretino (Arezzo). Tuscan is a language complex composed of many local variants, with minor differences among them.", "wikipedia_url": "https://en.wikipedia.org/wiki/Tuscan_dialects"}}, {"canonical_name": "Barbaria", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "barbaria", "book_id": "coloquios_da_orta_1563", "name": "Barbaria", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Barbaria"], "contexts": ["region from which gengivre comes", "region in Northeast Africa"]}, {"entity_id": "barbaric", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Barbaric", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Barbaric"], "contexts": ["coast where coral grows"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Barbaria", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Barbaric", "similarity": 0.947}], "id": 1480, "stable_key": "clu_d77674842edc5fac", "ground_truth": {"modern_name": "Barbary Coast", "confidence": "high", "type": "place", "country": "North Africa", "note": "Refers to the historical coastal region of North Africa.", "wikidata_id": "Q501768", "wikidata_description": "name used to designate the territory of the Barbary and going from Libya to Morocco", "wikipedia_extract": "The Barbary Coast (also Barbary, Berbery, or Berber Coast) were the coastal areas of central and western North Africa, more specifically, the Maghreb and the Ottoman borderlands consisting of the regencies in Algiers, Tunis, and Tripoli, as well as the Sultanate of Morocco from the 16th to 19th centuries. The term originates from an exonym for the Berbers. Barbary was not always a unified political entity. From the 16th century onward, it was divided into four political entities—from west to east—the Alawi Sultanate, the Regency of Algiers, the Regency of Tunis, and the Regency of Tripoli. Major rulers and petty monarchs during the times of the Barbary states' plundering parties included the sultan of Morocco, the dey of Algiers, bey of Tunis, and pasha of Tripoli, respectively. The slave trade was not just an economic lifeline to the Barbary States, but was often justified as a form of jihad against Christian states."}}, {"canonical_name": "Constantino", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "constantino", "book_id": "coloquios_da_orta_1563", "name": "Constantino", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Constantino", "dom Constantino"], "contexts": ["founder of Constantinople", "viceroy who received plant"]}, {"entity_id": "constantine", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Constantine", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Constantine"], "contexts": ["time period of Absyrtus"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Constantino", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Constantine", "similarity": 0.991}], "id": 1481, "stable_key": "clu_40fa9d584ecc21b9", "ground_truth": {"modern_name": "Constantine", "confidence": "high", "type": "person", "birth_year": 272, "death_year": 337, "description": "Roman Emperor and founder of Constantinople.", "note": "Refers to Constantine the Great.", "wikidata_id": "Q8413", "wikidata_description": "Roman emperor from 306 to 337 and first to convert to Christianity (272–337)", "wikipedia_extract": "Constantine I (27 February 272 – 22 May 337), also known as Constantine the Great, or known mononymously as Constantine, was Roman emperor from AD 306 to 337 and the first Roman emperor to convert to Christianity. He played a pivotal role in elevating the status of Christianity in Rome, the Edict of Milan decriminalising Christian practice and ceasing Christian persecution. This was a turning point in the Christianisation of the Roman Empire. He founded the city of Constantinople (now Istanbul) and made it the capital of the Empire, which it remained for over a millennium. Born in Naissus, a city located in the province of Moesia Superior (now Niš, Serbia), Constantine was the son of Flavius Constantius, a Roman army officer from Moesia Superior, who would become one of the four emperors of the Tetrarchy. His mother, Helena, was a woman of low birth, probably from Bithynia.", "wikipedia_url": "https://en.wikipedia.org/wiki/Constantine_the_Great"}}, {"canonical_name": "Zeilan", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "zeilan", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Zeilan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Zeilan"], "contexts": ["country of the King using Loadstone", "source of best cinnamon"]}, {"entity_id": "zeilan", "book_id": "ricettario_fiorentino_1597", "name": "Zeilan", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Zeilan"], "contexts": ["place where cassia originates"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Zeilan", "target_book": "ricettario_fiorentino_1597", "target_name": "Zeilan", "similarity": 0.819}], "id": 1482, "stable_key": "clu_857c3fa0a9bc420b", "ground_truth": {"modern_name": "Sri Lanka", "confidence": "high", "type": "place", "country": "Sri Lanka", "wikidata_id": "Q370239", "wikidata_description": "species of flowering plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Cinnamomum%20verum", "wikipedia_extract": "Sri Lanka, officially the Democratic Socialist Republic of Sri Lanka, formerly known as Ceylon, is an island country in South Asia. It is located in the Indian Ocean, southwest of the Bay of Bengal, and is separated from India by the Gulf of Mannar and the Palk Strait. Sri Lanka shares a maritime border with the Maldives to the southwest and India to the northwest, and lies across the Bay of Bengal from Bangladesh and Myanmar to the northeast and the Andaman and Nicobar Islands of India to the east. Its capital is Sri Jayawardenepura Kotte, while Colombo is its largest city and the political, financial and cultural centre. Sri Lanka's population is 22 million; with the Sinhalese people, who speak the Sinhala language, forming the vast majority—while Tamil is spoken by the large Tamil minority. Other long-established ethnic groups include the Moors, Indian Tamils, Burghers, Malays, Chinese, and Vedda."}}, {"canonical_name": "Taurus", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "taurus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Taurus", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Taurus"], "contexts": ["servant of Minos", "ship or pilot name"]}, {"entity_id": "taurus", "book_id": "polyanthea_medicinal", "name": "Taurus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Taurus"], "contexts": ["author of fol. 565."]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Taurus", "target_book": "polyanthea_medicinal", "target_name": "Taurus", "similarity": 0.792}], "id": 1483, "stable_key": "clu_dabd3f259d385654", "ground_truth": {"modern_name": "Taurus", "confidence": "medium", "type": "person", "description": "Mythological figure, possibly a historical or literary reference.", "note": "In the context of King Minos, 'Taurus' likely refers to the Minotaur or a related figure, not a specific historical person. The other context might refer to a different Taurus.", "wikidata_id": "Q10570", "wikidata_description": "zodiac constellation straddling the celestial equator", "wikipedia_url": "https://en.wikipedia.org/wiki/Taurus_%28constellation%29", "wikipedia_extract": "The German Taurus controversy refers to an ongoing political controversy starting in Summer 2023 surrounding the delivery of Bundeswehr Taurus cruise missiles to Ukraine. After the Russian invasion of Ukraine began in 2022, the Ukrainian government asked Germany in 2023 to deliver the German-Swedish air-to-ground cruise missiles. In Spring 2024, the majority of the government and parliament, as well as many surveyed sections of the population, spoke out against the delivery of Taurus missiles to Ukraine. Former German Chancellor Olaf Scholz (SPD) was strongly opposed to the delivery of Taurus missiles to Ukraine, as he feared that sending such weapons could result in an escalation in the conflict. This could lead to the country being drawn into the war as a hostile party, particularly because the Taurus has a range that extends deep into Russian territory (including Moscow) and can only be limited with Bundeswehr soldiers on site. Like the Chancellor, many members of the SPD reject its delivery; politicians from the Greens and the FDP as well as other sections of the SPD have called for its delivery."}}, {"canonical_name": "Petronius", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "petronius", "book_id": "polyanthea_medicinal", "name": "Petronius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Petronius"], "contexts": ["cited author on French disease", "ancient authority on Gallic diseases"]}, {"entity_id": "petronius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Petronius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Petronius"], "contexts": ["ancient source on glass malleability"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Petronius", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Petronius", "similarity": 1.0}], "id": 1484, "stable_key": "clu_2a15371ce6b3dc9f", "ground_truth": {"modern_name": "Petronius", "confidence": "high", "type": "person", "description": "Roman author, likely Gaius Petronius Arbiter, cited for historical and scientific observations.", "wikidata_id": "Q47180", "wikidata_description": "1st century AD Roman courtier and author of the Satyricon (27–66)", "wikipedia_url": "https://en.wikipedia.org/wiki/Petronius", "wikipedia_extract": "Gaius Petronius Arbiter (; Classical Latin: [ˈɡaː.i.ʊs pɛˈt̪roː.ni.ʊˈs ar.bɪ.t̪ɛr]; c. 27 – c. 66 AD; sometimes Titus Petronius Niger) was a Roman courtier during the reign of Nero (r. 54–68). He is generally believed to be the author of the Satyricon, a satirical novel believed to have been written during the Neronian era. He is one of the most important characters in Henryk Sienkiewicz' historical novel Quo Vadis (1895)."}}, {"canonical_name": "philonioperfico", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "philonioperfico", "book_id": "polyanthea_medicinal", "name": "philonioperfico", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["philonioperfico", "philonioperſico"], "contexts": ["Persian philonium", "ingredient for anodynes"]}, {"entity_id": "philonium", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Philonium", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Philonium"], "contexts": ["medical practice or preparation"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "philonioperfico", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Philonium", "similarity": 0.851}], "id": 1485, "stable_key": "clu_d8ed00536c58fd74", "ground_truth": {"modern_name": "Philonium", "confidence": "high", "type": "chemical", "note": "Philonium is an ancient medicinal preparation, often a complex electuary."}}, {"canonical_name": "fangrados", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "fangrados", "book_id": "polyanthea_medicinal", "name": "fangrados", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["fangrados", "falgados"], "contexts": ["having been bled", "quality of humors"]}, {"entity_id": "fanões", "book_id": "coloquios_da_orta_1563", "name": "fanões", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fanões"], "contexts": ["unit of currency"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "fangrados", "target_book": "coloquios_da_orta_1563", "target_name": "fanões", "similarity": 0.846}], "id": 1486, "stable_key": "clu_8c805b2708807f51", "ground_truth": {"modern_name": "Bloodletting", "confidence": "high", "type": "concept", "note": "The term 'fangrados' in Portuguese likely refers to the practice of bloodletting ('sangria'). 'Fanões' in the other text might be a misreading or a different, though related, concept in Portuguese folk medicine.", "wikidata_id": "Q356405", "wikidata_description": "therapy, now rarely used in medicine", "wikipedia_extract": "The Olmecs () or Olmec were an early major Mesoamerican civilization, flourishing in the modern-day Mexican states of Veracruz and Tabasco from roughly 1200 to 400 BC during Mesoamerica's formative period. They were initially centered at the site of their development in San Lorenzo Tenochtitlán, but moved to La Venta in the 10th century BC following the decline of San Lorenzo. By about 400 BC the major centres of the Olmec civilization had been abandoned, and the population of the eastern half of the Olmec heartland dropped precipitously. The settlement density in that area remained much lower than during the height of Olmec dominance, and only intermittent occupation is evident until much later. Although the Olmec cultural style waned, elements of their tradition lived on in successor societies. Among other \"firsts\", the Olmec appeared to practice ritual bloodletting and played the Mesoamerican ballgame, hallmarks of nearly all subsequent Mesoamerican societies.", "wikipedia_url": "https://en.wikipedia.org/wiki/Olmecs"}}, {"canonical_name": "Tinder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tinder", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Tinder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Tinder"], "contexts": ["material for lighting fires", "material for igniting gunpowder"]}, {"entity_id": "tinder", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tinder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["tinder"], "contexts": ["material ignited by compression"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Tinder", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tinder", "similarity": 0.889}], "id": 1487, "stable_key": "clu_511fcd3bf60cc2f7", "ground_truth": {"modern_name": "Tinder", "confidence": "high", "type": "substance", "wikidata_id": "Q37456470", "wikidata_description": "family name", "wikipedia_extract": "Fire making, fire lighting or fire craft is the process of artificially starting a fire. It requires completing the fire triangle, usually by heating tinder above its autoignition temperature. Fire is an essential tool for human survival and the use of fire was important in early human cultural history since the Lower Paleolithic. Today, it is a key component of Scouting, woodcraft and bushcraft. The earliest evidence for fire-making dates to about 400,000 years ago at a Neanderthal site in eastern England where burnt soil was found along with fire-cracked flint handaxes and two fragments of iron pyrite, used to strike sparks with flint. The next oldest evidence comes from around 50,000 years ago and later, when evidence for fire making can be found in dozens of Neanderthal hand axes from France exhibiting use-wear traces suggesting these tools were struck with the mineral pyrite to produce sparks.", "wikipedia_url": "https://en.wikipedia.org/wiki/Fire_making"}}, {"canonical_name": "Swan", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "swan", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Swan", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["Swan"], "contexts": ["constellation where a new star was discovered", "vanishing star in the swan"]}, {"entity_id": "swan", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Swan", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Swan"], "contexts": ["form Jupiter took to beget Leda"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Swan", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Swan", "similarity": 1.0}], "id": 1488, "stable_key": "clu_c4bce4e24b99a403", "ground_truth": {"modern_name": "Swan", "confidence": "high", "type": "animal", "wikidata_id": "Q55829744", "wikidata_description": "genus of insects", "wikipedia_extract": "The mute swan (Cygnus olor) is a species of swan and a member of the waterfowl family Anatidae. It is native to much of Europe and parts of Asia and (as a rare winter visitor) the far north of Africa. It is an introduced species in North America, home to the largest populations outside of its native range, with additional smaller introductions in Australasia and Southern Africa. The name \"mute\" derives from it being less vocal than other swan species. Measuring 125 to 160 cm (49 to 63 in) in length, this large swan is wholly white in plumage, with an orange beak bordered with black. It is recognisable by its pronounced knob atop the beak, which is larger in males.", "wikipedia_url": "https://en.wikipedia.org/wiki/Mute_swan"}}, {"canonical_name": "Black-Birds", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "black-birds", "book_id": "english_physician_1652", "name": "Black-Birds", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 2, "variants": ["Black-Birds", "Blackbirds"], "contexts": ["birds that eat Misselto berries", "birds that devour berries"]}, {"entity_id": "blackbird", "book_id": "origin_of_species_darwin_1859", "name": "blackbird", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["blackbird"], "contexts": ["spots on the young blackbird"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Black-Birds", "target_book": "origin_of_species_darwin_1859", "target_name": "blackbird", "similarity": 0.864}], "id": 1489, "stable_key": "clu_4c52806319110ed7", "ground_truth": {"modern_name": "Eurasian blackbird", "confidence": "high", "type": "animal", "wikidata_id": "Q25234", "wikidata_description": "species of thrush", "wikipedia_url": "https://en.wikipedia.org/wiki/Common_blackbird"}}, {"canonical_name": "Birds-Nest", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "birds-nest", "book_id": "english_physician_1652", "name": "Birds-Nest", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Birds-Nest"], "contexts": ["shape of flower cluster", "shape of the umbel"]}, {"entity_id": "nests_of_birds", "book_id": "origin_of_species_darwin_1859", "name": "nests of birds", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["nests of birds"], "contexts": ["structures built by birds"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Birds-Nest", "target_book": "origin_of_species_darwin_1859", "target_name": "nests of birds", "similarity": 0.93}], "id": 1490, "stable_key": "clu_9c75b2fd56d00a7d", "ground_truth": {"modern_name": "Bird's nest", "confidence": "high", "type": "object", "note": "Refers to actual nests built by birds or structures that resemble them.", "wikidata_id": "Q30056", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Daucus%20carota"}}, {"canonical_name": "Orchards", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "orchards", "book_id": "english_physician_1652", "name": "Orchards", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Orchards"], "contexts": ["place where trees are nursed", "habitat for perwincle"]}, {"entity_id": "orchard", "book_id": "origin_of_species_darwin_1859", "name": "orchard", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["orchard"], "contexts": ["place for fruit trees"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Orchards", "target_book": "origin_of_species_darwin_1859", "target_name": "orchard", "similarity": 0.905}], "id": 1491, "stable_key": "clu_a39f92913c88f672", "ground_truth": {"wikipedia_extract": "An orchard is an intentional plantation of trees or shrubs that is maintained for food production. Orchards comprise fruit- or nut-producing trees that are generally grown for commercial production. Orchards are also sometimes a feature of large gardens, where they serve an aesthetic as well as a productive purpose. A fruit garden is generally synonymous with an orchard, although it is set on a smaller, non-commercial scale and may emphasize berry shrubs in preference to fruit trees. Most temperate-zone orchards are laid out in a regular grid, with a grazed or mown grass or bare soil base that makes maintenance and fruit gathering easy. Most modern commercial orchards are planted for a single variety of fruit."}}, {"canonical_name": "drones", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "drones", "book_id": "origin_of_species_darwin_1859", "name": "drones", "category": "ANIMAL", "subcategory": "INSECT", "count": 2, "variants": ["drones"], "contexts": ["male bees", "male bees produced in large numbers"]}, {"entity_id": "drones", "book_id": "english_physician_1652", "name": "Drones", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["Drones"], "contexts": ["male bees"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "drones", "target_book": "english_physician_1652", "target_name": "Drones", "similarity": 0.815}], "id": 1492, "stable_key": "clu_3e31d9ae73b73de7", "ground_truth": {"modern_name": "Drone bee", "confidence": "high", "type": "animal", "note": "Specifically refers to the male bee.", "wikipedia_extract": "A honey bee (also spelled honeybee) is a eusocial flying insect from the genus Apis of the largest bee family, Apidae. Honey bees are known for their construction of perennial nests within cavities (i.e. beehives) containing hexagonal cells made of secreted wax, their large colony sizes, and their routine regurgitation of digested carbohydrates as surplus food storage in the form of honey, the lattermost of which distinguishes their hives as a prized foraging target of many mellivorous animals including honey badgers, bears and human hunter-gatherers. Although honey bees represent only a small fraction of the roughly 20,000 known species of bees, they are the bee clade most familiar to humans and are also the most valuable beneficial insects to agriculture and horticulture. The best-known honey bee species is the western honey bee (Apis mellifera), which was domesticated and farmed (i.e. beekeeping) for honey production and crop pollination.", "wikipedia_url": "https://en.wikipedia.org/wiki/Honey_bee"}}, {"canonical_name": "Nativity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "nativity", "book_id": "english_physician_1652", "name": "Nativity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Nativity"], "contexts": ["birth chart in astrology", "astrological birth chart"]}, {"entity_id": "nativi", "book_id": "polyanthea_medicinal", "name": "nativi", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["nativi"], "contexts": ["native"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Nativity", "target_book": "polyanthea_medicinal", "target_name": "nativi", "similarity": 0.905}], "id": 1493, "stable_key": "clu_4cc512aa6e2bdfb2", "ground_truth": {"modern_name": "Astrological nativity chart", "confidence": "high", "type": "concept", "note": "Context of 'nativi' in a medicinal text is likely related to the concept of birth or native origin, but in the context of 'Nativity' for the English physician, it strongly suggests astrological charts. Given both contexts are present, the astrological interpretation is more specific and likely.", "wikipedia_extract": "Astrology has used the concept of classical elements from antiquity up until the present. In Western astrology and Sidereal astrology four elements are used: Fire, Earth, Air, and Water. In Western tropical astrology, there are 12 astrological signs. Each of the four elements is associated with three signs of the Zodiac, which are always located exactly 120 degrees away from each other along the ecliptic and said to be in trine with one another. Most modern astrologers use the four classical elements extensively, (also known as triplicities), and indeed it is still viewed as a critical part of interpreting the astrological chart. Beginning with the first sign Aries which is a Fire sign, the next in line Taurus is Earth, then to Gemini which is Air, and finally to Cancer which is Water.", "wikipedia_url": "https://en.wikipedia.org/wiki/Astrology_and_the_classical_elements"}}, {"canonical_name": "stone Mortar", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "stone_mortar", "book_id": "english_physician_1652", "name": "stone Mortar", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["stone Mortar"], "contexts": ["used to bruise herbs", "vessel for grinding ingredients"]}, {"entity_id": "stone-muunds", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Stone-Muunds", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Stone-Muunds"], "contexts": ["mounds constructed partly of stone"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "stone Mortar", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Stone-Muunds", "similarity": 0.886}], "id": 1494, "stable_key": "clu_31550fb96f4865c1", "ground_truth": {"modern_name": "Mortar and pestle", "confidence": "high", "type": "object", "note": "'Stone Mortar' directly refers to a mortar and pestle. 'Stone-Muunds' is likely a misreading or variation and its context of 'mounds constructed partly of stone' is unrelated to the other occurrences of 'stone Mortar', suggesting it might be an OCR error or an outlier. The dominant and clear referent is the mortar and pestle.", "wikidata_id": "Q18341850", "wikidata_description": "equipment consisting of a bowl in which substances are ground using a pestle", "wikipedia_url": "https://en.wikipedia.org/wiki/Mortar%20and%20pestle"}}, {"canonical_name": "gallons", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "gallons", "book_id": "relation_historique_humboldt_vol3_1825", "name": "gallons", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["gallons"], "contexts": ["unit of volume for syrup", "unit of liquid measure"]}, {"entity_id": "gallons", "book_id": "english_physician_1652", "name": "Gallons", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Gallons"], "contexts": ["unit of volume"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "gallons", "target_book": "english_physician_1652", "target_name": "Gallons", "similarity": 0.983}], "id": 1495, "stable_key": "clu_977712d1c26397a7", "ground_truth": {"wikipedia_extract": "The gallon is a unit of volume in British imperial units and United States customary units. The imperial gallon (imp gal) is defined as 4.54609 litres, and is or was used in the United Kingdom and its former colonies, including Ireland, Canada, Australia, New Zealand, India, South Africa, Malaysia and some Caribbean countries, while the US gallon (US gal) is defined as 231 cubic inches (3.785411784 L), and is used in the United States and some Latin American and Caribbean countries. There are four gills in a pint, two pints in a quart, and four quarts (quarter gallons) in a gallon, with the imperial gill being divided into five imperial fluid ounces and the US gill being divided into four US fluid ounces: this, and a slight difference in the sizes of the imperial fluid ounce and the US fluid ounce, give different sizes for the imperial gallon and US gallon. The IEEE standard symbol for both the imperial and US gallons is gal, not to be confused with the gal (symbol: Gal), a CGS unit of acceleration. The gallon currently has two definitions, in the imperial system and in the US customary system. Historically, there were many definitions and redefinitions: see § Sizes of gallons for details."}}, {"canonical_name": "Banco", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "banco", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Banco", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Banco"], "contexts": ["location with phonolitic and granitic rocks", "north of Penon de Rosa"]}, {"entity_id": "banks", "book_id": "english_physician_1652", "name": "Banks", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Banks"], "contexts": ["natural habitat for plants"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Banco", "target_book": "english_physician_1652", "target_name": "Banks", "similarity": 0.941}], "id": 1496, "stable_key": "clu_87514a720035e514", "ground_truth": {"modern_name": "Bank", "confidence": "medium", "type": "place", "country": "Various", "note": "The context of 'Banco' with phonolitic and granitic rocks suggests a geological formation or a specific named place known for its geology. 'Banks' in the English physician's text, related to natural habitats for plants, points to land formations along rivers or bodies of water. The term is ambiguous but 'bank' as a geographical feature is the most probable overlap.", "wikipedia_extract": "Banco do Brasil S.A. (pronounced [ˈbɐ̃ku du bɾaˈziw], lit. 'Bank of Brazil') is a Brazilian financial services company headquartered in Brasília, Brazil. The oldest bank in Brazil, and among the oldest banks in continuous operation in the world, it was founded by John VI, King of Portugal, on Wednesday, 12 October 1808. It is the second largest banking institution in Brazil, as well as the second largest in Latin America. Banco do Brasil is controlled by the Brazilian government and is listed at the B3 stock exchange in São Paulo.", "wikipedia_url": "https://en.wikipedia.org/wiki/Banco_do_Brasil"}}, {"canonical_name": "sweet", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "sweet", "book_id": "english_physician_1652", "name": "sweet", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["sweet"], "contexts": ["quality of cherries, pass through stomach speedily", "quality of plums"]}, {"entity_id": "sugar-sweet", "book_id": "principles_of_psychology_james_1890", "name": "sugar-sweet", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sugar-sweet"], "contexts": ["sweet taste associated with sugar"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "sweet", "target_book": "principles_of_psychology_james_1890", "target_name": "sugar-sweet", "similarity": 0.908}], "id": 1497, "stable_key": "clu_7c3947e7ee372fa1", "ground_truth": {"wikipedia_extract": "Sweetness is a basic taste most commonly perceived when eating foods rich in sugar. Sweet tastes are generally regarded as pleasurable. In addition to sugars like sucrose, many other chemical compounds are sweet, including aldehydes, ketones, and sugar alcohols. Some are sweet at very low concentrations, allowing their use as non-caloric sugar substitutes. Such non-sugar sweeteners include saccharin, aspartame, sucralose and stevia. Other compounds, such as miraculin, may alter perception of sweetness itself."}}, {"canonical_name": "Sneezing", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "sneezing", "book_id": "english_physician_1652", "name": "Sneezing", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["sneezing", "Sneezing"], "contexts": ["involuntary expulsion of air", "involuntary expulsion of air from nose"]}, {"entity_id": "sneezing", "book_id": "principles_of_psychology_james_1890", "name": "sneezing", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["sneezing"], "contexts": ["involuntary expulsion of air"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Sneezing", "target_book": "principles_of_psychology_james_1890", "target_name": "sneezing", "similarity": 0.982}], "id": 1498, "stable_key": "clu_e92544365acf71a8", "ground_truth": {"wikipedia_extract": "A sneeze (also known as sternutation) is a semi-autonomous, convulsive expulsion of air from the lungs through the nose and mouth, usually caused by foreign particles irritating the nasal mucosa. A sneeze expels air forcibly from the mouth and nose in an explosive, spasmodic involuntary action. This action allows for mucus to escape through the nasal cavity and saliva to escape from the oral cavity. Sneezing is possibly linked to sudden exposure to bright light (known as photic sneeze reflex), sudden change (drop) in temperature, breeze of cold air, a particularly full stomach, exposure to allergens, or viral infection. Because sneezes can spread disease through infectious aerosol droplets, it is recommended to cover one's mouth and nose with the forearm, the inside of the elbow, a facial tissue or a handkerchief while sneezing. In addition to covering the mouth, looking down is also recommended to change the direction of the droplets spread and avoid high concentration in the human breathing heights."}}, {"canonical_name": "Spring Water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "spring_water", "book_id": "english_physician_1652", "name": "Spring Water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Spring Water"], "contexts": ["water used for infusion", "water used for decoction"]}, {"entity_id": "spring_water", "book_id": "kosmos_humboldt_1845", "name": "spring water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["spring water"], "contexts": ["water from a natural spring"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Spring Water", "target_book": "kosmos_humboldt_1845", "target_name": "spring water", "similarity": 0.923}], "id": 1499, "stable_key": "clu_b0776fa39a170a48", "ground_truth": {"modern_name": "Spring water", "confidence": "high", "type": "substance", "wikidata_id": "Q158996", "wikidata_description": "species of plant", "wikipedia_extract": "Humic substances (HS) are relatively recalcitrant colored organic compounds naturally formed during long-term decomposition and transformation of biomass residues. The color of humic substances varies from bright yellow to light or dark brown leading to black. The term comes from humus, which in turn comes from the Latin word humus, meaning \"soil, earth\". Humic substances constitute the majority of organic matter in soil, peat, coal, and sediments, and are important components of dissolved natural organic matter (NOM) in lakes (especially dystrophic lakes), rivers, and sea water. Humic substances account for 50 – 90% of cation exchange capacity in soils. \"Humic substances\" is an umbrella term covering humic acid, fulvic acid, and humin, which differ in solubility.", "wikipedia_url": "https://en.wikipedia.org/wiki/Humic_substance"}}, {"canonical_name": "Upton", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "upton", "book_id": "kosmos_humboldt_1845", "name": "Upton", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Upton"], "contexts": ["location of Herschel's monument", "location of monument"]}, {"entity_id": "upminster", "book_id": "english_physician_1652", "name": "Upminster", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Upminster"], "contexts": ["highway location"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Upton", "target_book": "english_physician_1652", "target_name": "Upminster", "similarity": 0.864}], "id": 1500, "stable_key": "clu_5a0acd4c0ed01b8d", "ground_truth": {"modern_name": "Upton", "confidence": "high", "type": "place", "country": "United Kingdom", "note": "While 'Upminster' is a specific location, 'Upton' is a more general placename that appears in multiple contexts. Without more specific contextual clues for the 'Upminster' mention, and given 'Upton' is the repeated term, it's the primary referent. If the context for 'Upminster' was strongly scientific (e.g., a specific observatory or geological site), it might warrant separate consideration.", "wikidata_id": "Q916922", "wikidata_description": "settlement and civil parish in West Northamptonshire, Northamptonshire, England", "wikipedia_extract": "Lauren Caitlin \"Caite\" Upton (born March 27, 1989) is an American beauty pageant titleholder who was crowned Miss South Carolina Teen USA 2007 and represented South Carolina at Miss Teen USA 2007 where she placed third runner-up. Upton became Miss South Carolina Teen USA for 2007 in the November 2006 state pageant. She went on to place as third runner-up in the Miss Teen USA 2007 pageant. Upton gained international notoriety for her incoherent response to a question posed to her onstage during the August 2007 national pageant. During the pageant, Upton responded to a question posed by judge Aimee Teegarden: \"Recent polls have shown a fifth of Americans can't locate the U.S. on a world map.", "wikipedia_url": "https://en.wikipedia.org/wiki/Caitlin_Upton"}}, {"canonical_name": "drams", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "drams", "book_id": "english_physician_1652", "name": "drams", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["drams", "dram"], "contexts": ["unit of weight", "unit of weight for dosage"]}, {"entity_id": "dragma", "book_id": "historia_medicinal_monardes_1574", "name": "dragma", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["dragma"], "contexts": ["unit of measurement for dosage"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "drams", "target_book": "historia_medicinal_monardes_1574", "target_name": "dragma", "similarity": 0.846}], "id": 1501, "stable_key": "clu_404c9c394bd72007", "ground_truth": {"modern_name": "Dram", "confidence": "high", "type": "object", "note": "A unit of weight or volume, particularly in apothecaries' measures.", "wikidata_id": "Q25372", "wikidata_description": "formal type of literature intended for performance, where the text is written in the form of character lines and the author's remarks and is usually divided into acts and scenes", "wikipedia_url": "https://en.wikipedia.org/wiki/Drama"}}, {"canonical_name": "Sack", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "sack", "book_id": "english_physician_1652", "name": "Sack", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Sack"], "contexts": ["wine used for infusion", "type of wine"]}, {"entity_id": "sukku", "book_id": "coloquios_da_orta_1563", "name": "sukku", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["sukku"], "contexts": ["name for dried ginger in India"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Sack", "target_book": "coloquios_da_orta_1563", "target_name": "sukku", "similarity": 0.884}], "id": 1502, "stable_key": "clu_40b84daee0579c3f", "ground_truth": {"modern_name": "Ginger", "confidence": "high", "type": "plant", "linnaean": "Zingiber officinale Roscoe", "family": "Zingiberaceae", "note": "The Portuguese 'sukku' refers to dried ginger from India, and 'Sack' in English texts likely refers to the same or a related preparation of ginger, especially given its use with wine for infusion.", "wikidata_id": "Q35625", "wikidata_description": "plant species", "wikipedia_url": "https://en.wikipedia.org/wiki/Ginger", "wikipedia_extract": "Ginger (Zingiber officinale) is a flowering plant whose rhizome, ginger root or ginger, is widely used as a spice and a folk medicine. It is an herbaceous perennial that grows annual pseudostems (false stems made of the rolled bases of leaves) about one meter tall, bearing narrow leaf blades. The inflorescences bear flowers having pale yellow petals with purple edges, and arise directly from the rhizome on separate shoots. Ginger is in the family Zingiberaceae, which also includes turmeric (Curcuma longa), cardamom (Elettaria cardamomum), and galangal. Ginger originated in Maritime Southeast Asia and was likely domesticated first by the Austronesian peoples. It was transported with them throughout the Indo-Pacific during the Austronesian expansion (c. 5,000 BP), reaching as far as Hawaii."}}, {"canonical_name": "Capers", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "capers", "book_id": "english_physician_1652", "name": "Capers", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Capers"], "contexts": ["pickled item", "pickled plant for preserving"]}, {"entity_id": "capur", "book_id": "coloquios_da_orta_1563", "name": "Capur", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Capur"], "contexts": ["form of camphor cited by Orta"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Capers", "target_book": "coloquios_da_orta_1563", "target_name": "Capur", "similarity": 0.846}], "id": 1503, "stable_key": "clu_5eec6df3eb05b6cc", "ground_truth": {"wikipedia_extract": "Capparis spinosa, the caper bush, also called Flinders rose, is a perennial plant that bears rounded, fleshy leaves and large white to pinkish-white flowers. The taxonomic status of the species is controversial and unsettled. Species within the genus Capparis are highly variable, and interspecific hybrids have been common throughout the evolutionary history of the genus. As a result, some authors have considered C. spinosa to be composed of multiple distinct species, others that the taxon is a single species with multiple varieties or subspecies, or that the taxon C. spinosa is a hybrid between C. orientalis and C. sicula. Capparis spinosa is native to almost all the circum-Mediterranean countries, and is included in the flora of most of them, but whether it is indigenous to this region is uncertain. The family Capparaceae could have originated in the tropics and later spread to the Mediterranean basin."}}, {"canonical_name": "lauan", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "lauan", "book_id": "coloquios_da_orta_1563", "name": "lauan", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["lauan", "louan"], "contexts": ["Arab name for incense", "corrupted Greek name for incense"]}, {"entity_id": "lau∣danum", "book_id": "english_physician_1652", "name": "Lau∣danum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Lau∣danum"], "contexts": ["substance added to induce sweating"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "lauan", "target_book": "english_physician_1652", "target_name": "Lau∣danum", "similarity": 0.875}], "id": 1504, "stable_key": "clu_d2902a67178aba19", "ground_truth": {"modern_name": "Laudanum", "confidence": "medium", "type": "chemical", "note": "The term 'lauan' in Portuguese likely refers to incense (likely Frankincense or Benzoin) which was a common ingredient. 'Laudanum' in English texts, especially if referring to a substance inducing sweating, could be a preparation containing opium or a related compound, but without more context on 'lauan', the link is not definitive. Given the context of 'substance added to induce sweating', it might refer to an opiate-based preparation, but the initial Portuguese term points to incense. 'Laudanum' as a modern chemical substance is distinct, but historically it was a tincture of opium. The connection is based on the potential for 'lauan' to be a mistranscription or a less common term for a sweating agent, or 'Laudanum' being used loosely for any sudorific.", "wikidata_id": "Q46452", "wikidata_description": "dried latex of the opium poppy containing narcotic compounds", "wikipedia_url": "https://en.wikipedia.org/wiki/Opium", "wikipedia_extract": "Laudanum is a tincture of opium containing approximately 10% powdered opium by weight (the equivalent of 1% morphine). Laudanum is prepared by dissolving extracts from the opium poppy (Papaver somniferum) in alcohol (ethanol). Reddish-brown in color and extremely bitter, laudanum contains several opium alkaloids, including morphine and codeine. Laudanum was historically used to treat a variety of conditions, but its principal use was as a pain medication and cough suppressant. Until the early 20th century, laudanum was sold without a prescription and was a constituent of many patent medicines. Laudanum has since been recognized as addictive and is strictly regulated and controlled throughout most of the world."}}, {"canonical_name": "Chelidonium", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "chelidonium", "book_id": "english_physician_1652", "name": "Chelidonium", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Chelidonium"], "contexts": ["name of the herb"]}, {"entity_id": "chalidunium", "book_id": "coloquios_da_orta_1563", "name": "Chalidunium", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Chalidunium"], "contexts": ["variant name for Chelidonium"]}, {"entity_id": "chelidonium_majus", "book_id": "coloquios_da_orta_1563", "name": "Chelidonium majus", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Chelidonium majus"], "contexts": ["plant name"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Chelidonium", "target_book": "coloquios_da_orta_1563", "target_name": "Chalidunium", "similarity": 0.842}, {"source_book": "english_physician_1652", "source_name": "Chelidonium", "target_book": "coloquios_da_orta_1563", "target_name": "Chelidonium majus", "similarity": 0.832}], "id": 1505, "stable_key": "clu_6fe4b938a20f4382", "ground_truth": {"wikipedia_extract": "Chelidonium, commonly known as celandines, is a small genus of flowering plants in the poppy family, This genus is native to northern Africa and Eurasia, where they are widespread, ranging from western Europe to east Asia. This genus consists of herbaceous perennials. Leaves are alternate and deeply lobed. They produce yellow flowers. Chelidonium is a small genus, consisting of two accepted species."}}, {"canonical_name": "compostos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "compostos", "book_id": "polyanthea_medicinal", "name": "compostos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["compostos", "compoſtos"], "contexts": ["compound remedies", "compounds"]}, {"entity_id": "composições", "book_id": "coloquios_da_orta_1563", "name": "composições", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["composições"], "contexts": ["medicinal preparations"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "compostos", "target_book": "coloquios_da_orta_1563", "target_name": "composições", "similarity": 0.868}], "id": 1506, "stable_key": "clu_38e72b4abc442593", "ground_truth": {"modern_name": "Compound remedies", "confidence": "high", "type": "concept", "note": "Both 'compostos' and 'composições' in Portuguese directly translate to 'compounds' or 'compositions' in the context of medicinal preparations.", "wikipedia_extract": "Oswald Croll or Crollius (c. 1563 – December 1609) was an alchemist, and professor of medicine at the University of Marburg in Hesse, Germany. A strong proponent of alchemy and using chemistry in medicine, he was heavily involved in writing books and influencing thinkers of his day towards viewing chemistry and alchemy as two separate fields. Croll received his doctorate in medicine in 1582 at Marburg, then continued studies at Heidelberg, Strasburg, and Geneva. After working as a tutor, he arrived in Prague in 1597. He remained there for two years, and again from 1602 until his death.", "wikipedia_url": "https://en.wikipedia.org/wiki/Oswald_Croll"}}, {"canonical_name": "Nearcho", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "nearcho", "book_id": "coloquios_da_orta_1563", "name": "Nearcho", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Nearcho"], "contexts": ["commander of a fleet", "figure associated with a fleet"]}, {"entity_id": "neighbors", "book_id": "english_physician_1652", "name": "Neighbors", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Neighbors"], "contexts": ["people living nearby"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Nearcho", "target_book": "english_physician_1652", "target_name": "Neighbors", "similarity": 0.841}], "id": 1507, "stable_key": "clu_7c0d6699e816e44f", "ground_truth": {"modern_name": "Nearchus", "confidence": "high", "type": "person", "description": "Ancient Greek commander and geographer", "note": "The Portuguese 'Nearcho' is a direct transliteration of the ancient Greek commander Nearchus, mentioned in historical contexts. 'Neighbors' is a clear mistranscription or misinterpretation within the English text of the same entity.", "wikidata_id": "Q1216034", "wikidata_description": "ancient Greek philosopher", "wikipedia_extract": "Nearchus or Nearchos (Greek: Νέαρχος; c. 360 – 300 BC) was one of the Greek officers, a navarch, in the army of Alexander the Great. He is known for his celebrated expeditionary voyage starting from the Indus River, through the Persian Gulf and ending at the mouth of the Tigris River following the Indian campaign of Alexander the Great, in 326–324 BC. A native of Lato in Crete and son of Androtimus, his family settled at Amphipolis in Macedonia at some point during Philip II's reign (we must assume after Philip took the city in 357 BC), at which point Nearchus was probably a young boy. He was almost certainly older than Alexander, as were Ptolemy, Erigyius, and the others of the ‘boyhood friends’; so depending on when Androtimus came to Macedonia Nearchus was quite possibly born in Crete. Nearchus, along with Ptolemy, Erigyius and Laomedon, and Harpalus, was one of Alexander's ‘mentors’ – and he was exiled by Philip as a result of the Pixodarus affair (A 3.6.5; P 10.3). It is not known where the exiles went, but they were recalled only after Philip's death, on Alexander's accession."}}, {"canonical_name": "Oyl of Camomel", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "oyl_of_camomel", "book_id": "english_physician_1652", "name": "Oyl of Camomel", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Oyl of Camomel", "Oyl of Chamo∣mel"], "contexts": ["oil used for poultice", "medicinal oil"]}, {"entity_id": "olio_di_camomilla", "book_id": "ricettario_fiorentino_1597", "name": "olio di camomilla", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["olio di camomilla"], "contexts": ["chamomile oil"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Oyl of Camomel", "target_book": "ricettario_fiorentino_1597", "target_name": "olio di camomilla", "similarity": 0.889}], "id": 1508, "stable_key": "clu_151067eb767f21bc", "ground_truth": {"modern_name": "Chamomile oil", "confidence": "high", "type": "chemical", "note": "Both 'Oyl of Camomel' and 'olio di camomilla' are direct references to oil derived from the chamomile plant.", "wikidata_id": "Q128631274", "wikidata_description": "scholarly article", "wikipedia_extract": "Chamazulene is an aromatic chemical compound with the molecular formula C14H16 found in a variety of plants including in chamomile (Matricaria chamomilla), wormwood (Artemisia absinthium), and yarrow (Achillea millefolium). It is a blue-violet derivative of azulene formed from sesquiterpene matricin after the loss of acetate, water and carbon dioxide during the steam distillation of chamomile blossoms. Oral ingestion of matricin results in chamazulene being found in blood plasma and artificial gastric fluid is able to convert matricin to chamazulene. Chamazulene has anti-inflammatory properties in vivo and inhibits the CYP1A2 enzyme, but not CYP1A1.", "wikipedia_url": "https://en.wikipedia.org/wiki/Chamazulene"}}, {"canonical_name": "Sparagi", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "sparagi", "book_id": "ricettario_fiorentino_1597", "name": "Sparagi", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Sparagi"], "contexts": ["Asparagus, ingredient in syrup", "ingredient in a syrup"]}, {"entity_id": "sparagus", "book_id": "english_physician_1652", "name": "Sparagus", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Sparagus"], "contexts": ["alternative name for Asparagus"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Sparagi", "target_book": "english_physician_1652", "target_name": "Sparagus", "similarity": 0.851}], "id": 1509, "stable_key": "clu_5960802c1ac6e453", "ground_truth": {"modern_name": "Asparagus", "confidence": "high", "type": "plant", "linnaean": "Asparagus officinalis L.", "family": "Asparagaceae", "note": "'Sparagi' is the Italian plural for asparagus, and 'Sparagus' is the Latin/English form.", "wikipedia_extract": "Asparagus (Asparagus officinalis) or garden asparagus is a perennial flowering plant species in the genus Asparagus native to Eurasia. Widely cultivated as a vegetable crop, its young shoots are used as a spring vegetable. Asparagus is an herbaceous, perennial plant growing typically to 100–150 centimetres (3–5 feet) tall, with stout stems with much-branched, feathery foliage. It has been known to grow as long as 3.5 metres (11 ft). The 'leaves' are needle-like cladodes (modified stems) in the axils of scale leaves; they are 6–32 millimetres (1⁄4–1+1⁄4 inches) long and 1 mm (1⁄32 in) broad, and clustered in fours, up to 15, together, in a rose-like shape. The root system, often referred to as a 'crown', is adventitious; the root type is fasciculated."}}, {"canonical_name": "loc", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "loc", "book_id": "coloquios_da_orta_1563", "name": "loc", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["loc"], "contexts": ["substance discussed", "name for the goma"]}, {"entity_id": "lochi", "book_id": "ricettario_fiorentino_1597", "name": "lochi", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["lochi"], "contexts": ["lochs, a type of compound medicine"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "loc", "target_book": "ricettario_fiorentino_1597", "target_name": "lochi", "similarity": 0.839}], "id": 1510, "stable_key": "clu_4e82842a761a03ff", "ground_truth": {"modern_name": "Lochs", "confidence": "medium", "type": "object", "note": "The term 'lochi' in the Florentine pharmacopoeia refers to 'lochia' or 'locus' in a medicinal sense, often a prepared medicinal plaster or a specific compound formulation. The Portuguese 'loc' is likely a corruption or abbreviation of this term or a similar preparation.  The direct translation to 'lochs' (bodies of water) is incorrect in this context.  Given the mention of a 'compound medicine', it's a specific type of preparation.", "wikipedia_extract": "The each-uisge (Scottish Gaelic: [ɛxˈɯʃkʲə], literally \"water horse\") is a water spirit in Irish and Scottish folklore, spelled as the each-uisce (anglicized as aughisky or ech-ushkya) in Ireland and cabbyl-ushtey on the Isle of Man. It usually takes the form of a horse, and is similar to the kelpie but far more vicious. The each-uisge, a supernatural water horse found in the Scottish Highlands, has been described as \"perhaps the fiercest and most dangerous of all the water-horses\" by the folklorist Katharine Briggs. Often mistaken for the kelpie (which inhabits streams and rivers), the each-uisge lives in the sea, sea lochs, and fresh water lochs. The each-uisge is a shape-shifter, disguising itself as a fine horse, pony, a handsome man or an enormous bird such as a boobrie. If, while in horse form, a man mounts it, he is only safe as long as the each-uisge is ridden in the interior of land.", "wikipedia_url": "https://en.wikipedia.org/wiki/Each-uisge"}}, {"canonical_name": "Noli me Tangere", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "noli_me_tangere", "book_id": "english_physician_1652", "name": "Noli me Tangere", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["Noli me Tangere", "Nolime tangere"], "contexts": ["aggressive spreading ulcer", "disease name with reference"]}, {"entity_id": "noli_me_tangere", "book_id": "polyanthea_medicinal", "name": "Noli me tangere", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Noli me tangere"], "contexts": ["a type of cancerous sore"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Noli me Tangere", "target_book": "polyanthea_medicinal", "target_name": "Noli me tangere", "similarity": 0.979}], "id": 1511, "stable_key": "clu_d19290315bcacdea", "ground_truth": {"wikipedia_extract": "Noli me tangere ('touch me not') is the Latin version of a phrase spoken, according to John 20:17, by Jesus to Mary Magdalene when she recognized him after His resurrection. The original Koine Greek phrase is Μή μου ἅπτου (mḗ mou háptou). The biblical scene has been portrayed in numerous works of Christian art from Late Antiquity to the present. The phrase has also been used in literature, and later in a variation by military units since the late 18th century. According to Maurice Zundel (1897–1975), in asking Mary Magdalene not to touch him, Jesus indicates that once the resurrection is accomplished, the link between human beings and his person must no longer be physical, but must be a bond of heart to heart. \"He must establish this gap, she must understand that the only possible way is faith, that the hands can not reach the person and that it is from within, from within only, that the we can approach Him.\" Likewise, later, when Thomas reached out to touch the wounds of Jesus, Christ declares: \"blessed are those who have not seen and yet have believed\" [John 20:29] because \"He knows it is useless.\" Christians of Western Catholic tradition, namely Catholics, Lutherans, and Anglicans, would say this statement is to be received in relation to the Ascension of Jesus. That is, because he had not yet ascended to the right hand of God, it was more of a \"not yet\" statement rather than a \"never\" cling to me."}}, {"canonical_name": "Pulp", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pulp", "book_id": "english_physician_1652", "name": "Pulp", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Pulp"], "contexts": ["part of berries made into conserve", "processed fruit for preserving"]}, {"entity_id": "pulfos", "book_id": "polyanthea_medicinal", "name": "pulfos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["pulfos"], "contexts": ["pulses"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Pulp", "target_book": "polyanthea_medicinal", "target_name": "pulfos", "similarity": 0.899}], "id": 1512, "stable_key": "clu_e6089bcd09fe3022", "ground_truth": {"modern_name": "Pulp", "confidence": "high", "type": "concept", "note": "'Pulp' in English refers to the fleshy part of fruits. 'Pulfos' in the Polyanthea Medicinal is likely a related term for a similar soft substance, possibly referring to the prepared form or a component like the pulp of legumes ('pulses' in a culinary sense, but the context of berries suggests fruit pulp).", "wikipedia_extract": "Pulp necrosis is a clinical diagnostic category indicating the death of cells and tissues in the pulp chamber of a tooth with or without bacterial invasion. It is often the result of many cases of dental trauma, caries and irreversible pulpitis. In the initial stage of the infection, the pulp chamber is partially necrosed for a period of time and if left untreated, the area of cell death expands until the entire pulp necroses. The most common clinical signs present in a tooth with a necrosed pulp would be a grey discoloration of the crown and/or periapical radiolucency. This altered translucency in the tooth is due to disruption and cutting off of the apical neurovascular blood supply. Sequelae of a necrotic pulp include acute apical periodontitis, dental abscess or radicular cyst and discolouration of the tooth.", "wikipedia_url": "https://en.wikipedia.org/wiki/Pulp_necrosis"}}, {"canonical_name": "Nodes", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "nodes", "book_id": "english_physician_1652", "name": "Nodes", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["Nodes"], "contexts": ["condition dispersed by herb", "lumps in flesh, discussed by Wood-Sage"]}, {"entity_id": "nodofos", "book_id": "polyanthea_medicinal", "name": "nodofos", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["nodofos"], "contexts": ["nodular tumors"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Nodes", "target_book": "polyanthea_medicinal", "target_name": "nodofos", "similarity": 0.854}], "id": 1513, "stable_key": "clu_569b3f910756f120", "ground_truth": {"modern_name": "Nodules", "confidence": "high", "type": "disease", "modern_term": "Nodules", "wikidata_id": "Q107283000", "wikidata_description": "genus of molluscs", "wikipedia_extract": "Polymetallic nodules, also called manganese nodules, are mineral concretions on the sea bottom formed of concentric layers of iron and manganese hydroxides around a core. As nodules can be found in vast quantities, and contain valuable metals, deposits have been identified as a potential economic interest. Depending on their composition and authorial choice, they may also be called ferromanganese nodules. Ferromanganese nodules are mineral concretions composed of silicates and insoluble iron and manganese oxides that form on the ocean seafloor and terrestrial soils. The formation mechanism involves a series of redox oscillations driven by both abiotic and biotic processes. As a byproduct of pedogenesis, the specific composition of a ferromanganese nodule depends on the composition of the surrounding soil.", "wikipedia_url": "https://en.wikipedia.org/wiki/Manganese_nodule"}}, {"canonical_name": "voice", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "voice", "book_id": "english_physician_1652", "name": "voice", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["voice"], "contexts": ["lost their voice", "faculty of speech"]}, {"entity_id": "voz", "book_id": "polyanthea_medicinal", "name": "voz", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["voz"], "contexts": ["human voice"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "voice", "target_book": "polyanthea_medicinal", "target_name": "voz", "similarity": 0.961}], "id": 1514, "stable_key": "clu_713dfbbc552a59c6", "ground_truth": {"wikipedia_extract": "The human voice consists of sound made by a human being using the vocal tract, including talking, singing, laughing, crying, screaming, shouting, humming or yelling. The human voice  is specifically a part of human sound production in which the vocal folds (vocal cords) are the primary sound source. (Other sound production mechanisms produced from the same general area of the body involve the production of unvoiced consonants, clicks, whistling and whispering.) Generally speaking, the mechanism for generating the human voice can be subdivided into three parts; the lungs, the vocal folds within the larynx (voice box), and the articulators. The lungs, the \"pump\" must produce adequate airflow and air pressure to vibrate vocal folds. The vocal folds (vocal cords) then vibrate to use airflow from the lungs to create audible pulses that form the laryngeal sound source. The muscles of the larynx adjust the length and tension of the vocal folds to 'fine-tune' pitch and tone. The articulators (the parts of the vocal tract above the larynx consisting of tongue, palate, cheek, lips, etc.) articulate and filter the sound emanating from the larynx and to some degree can interact with the laryngeal airflow to strengthen or weaken it as a sound source."}}, {"canonical_name": "Mastich", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mastich", "book_id": "english_physician_1652", "name": "Mastich", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Mastich"], "contexts": ["resin from mastic tree", "resin used in preparation"]}, {"entity_id": "mastichis", "book_id": "polyanthea_medicinal", "name": "mastichis", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["mastichis"], "contexts": ["ingredient in a preparation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Mastich", "target_book": "polyanthea_medicinal", "target_name": "mastichis", "similarity": 0.811}], "id": 1515, "stable_key": "clu_6692a1fa56b8d892", "ground_truth": {"modern_name": "Mastic", "confidence": "high", "type": "plant", "linnaean": "Pistacia lentiscus", "family": "Anacardiaceae", "wikidata_id": "Q6005596", "wikidata_description": "genus of plants", "wikipedia_extract": "Pistacia lentiscus (also lentisk or mastic) is a dioecious evergreen shrub or small tree of the genus Pistacia native to the Mediterranean Basin. It grows up to 4 m (13 ft) tall and is cultivated for its aromatic resin, mainly on the Greek island of Chios, around the Turkish town of Çeşme and northern parts of Iraq. The plant is evergreen, from 1 to 5 m (3 ft 3 in to 16 ft 5 in) high, with a strong smell of resin, growing in dry and rocky areas in North Africa and Mediterranean Europe. It resists mild to heavy frosts but prefers milder winters and grows on all types of soils, and can grow well in limestone areas and even in salty or saline environments, making it more abundant near the sea. It is also found in woodlands, dehesas (almost deforested pasture areas), Kermes oak woods, wooded areas dominated by other oaks, garrigues, maquis shrublands, hills, gorges, canyons, and rocky hillsides of the entire Mediterranean area. It is a typical species of Mediterranean mixed communities which include myrtle, Kermes oak, Mediterranean dwarf palm, buckthorn and sarsaparilla, and serves as protection and food for birds and other fauna in this ecosystem.", "wikipedia_url": "https://es.wikipedia.org/wiki/Mastichodendron"}}, {"canonical_name": "senses", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "senses", "book_id": "english_physician_1652", "name": "senses", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["senses"], "contexts": ["faculty of perception", "affected by dulness"]}, {"entity_id": "sentidos", "book_id": "polyanthea_medicinal", "name": "sentidos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["sentidos"], "contexts": ["organs of perception"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "senses", "target_book": "polyanthea_medicinal", "target_name": "sentidos", "similarity": 0.96}], "id": 1516, "stable_key": "clu_94ca61a97148dfbf", "ground_truth": {"wikipedia_extract": "A sense is a biological system used by an organism for sensation, the process of  gathering information about the surroundings through the detection of stimuli. Although, in some cultures, five human senses were traditionally identified as such (namely sight, smell, touch, taste, and hearing), many more are now recognized. Senses used by non-human organisms are even greater in variety and number. During sensation, sense organs collect various stimuli (such as a sound or smell) for transduction, meaning transformation into a form that can be understood by the brain. Sensation and perception are fundamental to nearly every aspect of an organism's cognition, behavior and thought. In organisms, a sensory organ consists of a group of interrelated sensory cells that respond to a specific type of physical stimulus."}}, {"canonical_name": "Therapeut.", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "therapeut_", "book_id": "polyanthea_medicinal", "name": "Therapeut.", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["Therapeut.", "terapeutice"], "contexts": ["therapeutics", "related to therapy"]}, {"entity_id": "therapeutic_use", "book_id": "english_physician_1652", "name": "Therapeutic use", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Therapeutic use"], "contexts": ["application of herbs for healing"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Therapeut.", "target_book": "english_physician_1652", "target_name": "Therapeutic use", "similarity": 0.843}], "id": 1517, "stable_key": "clu_a26071a29cfbb073", "ground_truth": {"modern_name": "Therapeutics", "confidence": "high", "type": "concept", "wikidata_id": "Q4056087", "wikidata_description": "regulatory body for therapeutic goods (including medicines, medical devices, gene technology, and blood products) in Australia", "wikipedia_url": "https://en.wikipedia.org/wiki/Therapeutic%20Goods%20Administration"}}, {"canonical_name": "Tunicles", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tunicles", "book_id": "english_physician_1652", "name": "Tunicles", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Tunicles"], "contexts": ["thin layers of the eye"]}, {"entity_id": "tunica_viloſa", "book_id": "polyanthea_medicinal", "name": "tunica viloſa", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["tunica viloſa"], "contexts": ["villous tunic"]}, {"entity_id": "tunica_interior", "book_id": "polyanthea_medicinal", "name": "tunica interior", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["tunica interior"], "contexts": ["inner membrane"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Tunicles", "target_book": "polyanthea_medicinal", "target_name": "tunica viloſa", "similarity": 0.884}, {"source_book": "english_physician_1652", "source_name": "Tunicles", "target_book": "polyanthea_medicinal", "target_name": "tunica interior", "similarity": 0.865}], "id": 1518, "stable_key": "clu_df36cc95dd7c7ff6", "ground_truth": {"modern_name": "Tunics of the eye", "confidence": "high", "type": "concept", "note": "Refers to anatomical layers, not a plant or mineral."}}, {"canonical_name": "musk", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "musk", "book_id": "polyanthea_medicinal", "name": "musk", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 2, "variants": ["musk"], "contexts": ["used for perfuming"]}, {"entity_id": "musk", "book_id": "english_physician_1652", "name": "Musk", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["Musk"], "contexts": ["used in sweet ointments"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "musk", "target_book": "english_physician_1652", "target_name": "Musk", "similarity": 0.883}], "id": 1519, "stable_key": "clu_e2ba34245a490fe9", "ground_truth": {"wikipedia_extract": "Musk is a class of aromatic substances commonly used as base notes in perfumery. They include glandular secretions from animals such as the musk deer, numerous plants emitting similar fragrances, and artificial substances with similar odors. Musk was a name originally given to a substance with a strong odor obtained from a gland of the musk deer. The substance has been used as a popular perfume fixative since ancient times and is one of the most expensive animal products in the world. The name originates from the Late Greek μόσχος 'moskhos', from Persian mushk and Sanskrit मुष्क muṣka (lit. 'testicle') derived from Proto-Indo-European noun múh₂s meaning \"mouse\". The deer gland was thought to resemble a scrotum."}}, {"canonical_name": "stupidity", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "stupidity", "book_id": "polyanthea_medicinal", "name": "stupidity", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["stupidity"], "contexts": ["condition of the mind", "stupidity of intellect"]}, {"entity_id": "stupid∣stupid∣ness", "book_id": "english_physician_1652", "name": "stupid∣stupid∣ness", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["stupid∣stupid∣ness"], "contexts": ["symptom of dulness of mind"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "stupidity", "target_book": "english_physician_1652", "target_name": "stupid∣stupid∣ness", "similarity": 0.848}], "id": 1520, "stable_key": "clu_0d5d73a800344265", "ground_truth": {"wikipedia_extract": "Stupidity is a lack of intelligence, understanding, reason, or wit, an inability to learn. It may be innate, assumed or reactive. The word stupid comes from the Latin word stupere. Stupid characters are often used for comedy in fictional stories. Walter B. Pitkin called stupidity \"evil\", but in a more Romantic spirit William Blake and Carl Jung believed stupidity can be the mother of wisdom."}}, {"canonical_name": "barba", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "barba", "book_id": "polyanthea_medicinal", "name": "barba", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["barba"], "contexts": ["hair of the beard", "beard"]}, {"entity_id": "beard", "book_id": "english_physician_1652", "name": "Beard", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Beard"], "contexts": ["body part where hair grows"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "barba", "target_book": "english_physician_1652", "target_name": "Beard", "similarity": 0.883}], "id": 1521, "stable_key": "clu_1b6adcf0fea54af5", "ground_truth": {"wikipedia_extract": "Barba (which means \"beard\" in Spanish, Portuguese and Italian) is a surname. Notable people with the surname include: Antonella Barba (born 1986), U.S. singer and contestant on American Idol Angelo Barba (born 1958), Filipino politician Ben Barba (born 1989), Australian rugby footballer Eugenio Barba (born 1936), Italian author and director Federico Barba (born 1993), Italian footballer Fidel LaBarba (1905–1981), U.S. boxer and sportswriter Javier Barba, lead guitar of Mexican rock band Los Depas Juan Barbas (born 1959), Argentine footballer Paul Barbă Neagră (1929–2009), Romanian film director Porfirio Barba-Jacob, pseudonym of Miguel Ángel Osorio Benítez, Colombian poet Victoria Barbă (1926–2020), Moldovan animated film director Barba (footballer) (born 1999), full name João Pedro de Giuli, Brazilian footballer Rafael Barba, (Raúl Esparza) appearing on Law & Order: Special Victims Unit Barbapapa, the title character, and name of the \"species\" of said character, of a series of children's books The Barba River, a tributary of the Vologne in the French Vosges Barba as the Latin root of the word \"beard\" Barba is the last palace dungeon of the sixth dungeon in Zelda II: The Adventure of Link. He is a serpent. When Nintendo released Zelda II in Europe and America, they called the palace boss Barba, but this has since been retconned as Volvagia, which is his original name in the Japanese version of Zelda II."}}, {"canonical_name": "flash of lightning", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "flash_of_lightning", "book_id": "connexion_physical_sciences_somerville_1858", "name": "flash of lightning", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["flash of lightning"], "contexts": ["sudden electrical discharge", "caused by discharge between clouds"]}, {"entity_id": "blastings_by_lightning", "book_id": "english_physician_1652", "name": "Blastings by Lightning", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Blastings by Lightning"], "contexts": ["treated with oil of roses"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "flash of lightning", "target_book": "english_physician_1652", "target_name": "Blastings by Lightning", "similarity": 0.859}], "id": 1522, "stable_key": "clu_712d8d97bd2c0331", "ground_truth": {"modern_name": "Lightning strike", "confidence": "high", "type": "disease", "modern_term": "Lightning strike", "wikipedia_extract": "A lightning strike or lightning bolt is a lightning event in which an electric discharge takes place between the atmosphere and the ground. Most originate in a cumulonimbus cloud and terminate on the ground, called cloud-to-ground (CG) lightning. A less common type of strike, ground-to-cloud (GC) lightning, is upward-propagating lightning initiated from a tall grounded object and reaching into the clouds. About 25% of all lightning events worldwide are strikes between the atmosphere and earth-bound objects. Most are intracloud (IC) lightning and cloud-to-cloud (CC), where discharges only occur high in the atmosphere. Lightning strikes the average commercial aircraft at least once a year, but modern engineering and design means this is rarely a problem."}}, {"canonical_name": "Anomma", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "anomma", "book_id": "origin_of_species_darwin_1859", "name": "Anomma", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Anomma"], "contexts": ["genus of driver ants", "mentioned in text"]}, {"entity_id": "anomies", "book_id": "relation_historique_humboldt_vol3_1825", "name": "anomies", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["anomies"], "contexts": ["fossil shells found in porous rock"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Anomma", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "anomies", "similarity": 0.872}], "id": 1523, "stable_key": "clu_e406c6383e055e82", "ground_truth": {"modern_name": "Anomma", "confidence": "high", "type": "animal", "note": "Contexts indicate both ants and fossil shells, but the genus Anomma is specific to ants.", "wikidata_id": "Q9616597", "wikidata_description": "genus of insects"}}, {"canonical_name": "Passiflora", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "passiflora", "book_id": "origin_of_species_darwin_1859", "name": "Passiflora", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Passiflora"], "contexts": ["plant genus mentioned in fertilization experiments", "plant mentioned with page number"]}, {"entity_id": "passiflora_glabrala", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Passiflora glabrala", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Passiflora glabrala"], "contexts": ["plant from Turbaco"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Passiflora", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Passiflora glabrala", "similarity": 0.902}], "id": 1524, "stable_key": "clu_a64a3d456d81ead3", "ground_truth": {"wikipedia_extract": "Passiflora, known also as the passion flowers or passion vines, is a genus of about 550 species of flowering plants, and the type genus of the family Passifloraceae. Passiflora species are widely cultivated for their striking flowers, flavorful fruits, traditional medicinal uses, and roles in dietary supplements and ayahuasca analogs, with several ornamental hybrids earning Royal Horticultural Society awards. The genus mostly produces tendril-bearing vines, as well as some shrubs and trees. The plants can be woody or herbaceous. The flowers are regular and usually showy, with a distinctive corona. There can be as many as eight concentric coronal series, as in the case of P. xiikzodz. and P. alata."}}, {"canonical_name": "Crinum capense", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "crinum_capense", "book_id": "origin_of_species_darwin_1859", "name": "Crinum capense", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Crinum capense"], "contexts": ["plant species used in hybridisation experiments"]}, {"entity_id": "crinum", "book_id": "origin_of_species_darwin_1859", "name": "Crinum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Crinum"], "contexts": ["plant species mentioned in fertilization experiments"]}, {"entity_id": "crinum_eruhescens", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Crinum eruhescens", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Crinum eruhescens"], "contexts": ["flowering plant in forests"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Crinum capense", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Crinum eruhescens", "similarity": 0.862}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Crinum", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Crinum eruhescens", "similarity": 0.885}], "id": 1525, "stable_key": "clu_017fef3b0124e6be", "ground_truth": {"modern_name": "Crinum", "confidence": "high", "type": "plant", "linnaean": "Crinum", "family": "Amaryllidaceae", "note": "Includes specific species and the genus itself.", "wikidata_id": "Q683353", "wikidata_description": "genus of plants", "wikipedia_extract": "Crinum pedunculatum  also known as the swamp lily, river lily or mangrove lily,  is a bulbous perennial found in stream and tidal areas of the Northern Territory, Queensland and New South Wales, Australia as well as New Guinea and some Pacific Islands. It is unclear whether it is native or introduced to Norfolk Island. C. pedunculatum is considered by some sources to be a synonym of Crinum asiaticum var. pedunculatum. The differences between C.", "wikipedia_url": "https://en.wikipedia.org/wiki/Crinum"}}, {"canonical_name": "vegetative repetition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "vegetative_repetition", "book_id": "origin_of_species_darwin_1859", "name": "vegetative repetition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["vegetative repetition"], "contexts": ["repetition of parts in an organism", "topic discussed by Professor Owen"]}, {"entity_id": "repetition", "book_id": "principles_of_psychology_james_1890", "name": "repetition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["repetition"], "contexts": ["act of repeating something"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "vegetative repetition", "target_book": "principles_of_psychology_james_1890", "target_name": "repetition", "similarity": 0.843}], "id": 1526, "stable_key": "clu_58ffb88ee8620a32", "ground_truth": {"modern_name": "Repetition", "confidence": "high", "type": "concept", "note": "The term 'vegetative repetition' refers to biological repetition, while 'repetition' alone is broader but clearly linked in context.", "wikidata_id": "Q88180489", "wikidata_description": "a stylistic device"}}, {"canonical_name": "palate", "category": "ANATOMY", "subcategory": "BODY_PART", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "palate", "book_id": "origin_of_species_darwin_1859", "name": "palate", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["palate"], "contexts": ["roof of the mouth"]}, {"entity_id": "palate", "book_id": "principles_of_psychology_james_1890", "name": "palate", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["palate"], "contexts": ["roof of the mouth"]}, {"entity_id": "soft_palate", "book_id": "principles_of_psychology_james_1890", "name": "soft palate", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["soft palate"], "contexts": ["movements in mental operations"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "palate", "target_book": "principles_of_psychology_james_1890", "target_name": "palate", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "palate", "target_book": "principles_of_psychology_james_1890", "target_name": "soft palate", "similarity": 0.849}], "id": 1527, "stable_key": "clu_345d16b0b4375442", "ground_truth": {"wikipedia_extract": "The palate () is the roof of the mouth in humans and other mammals. It separates the oral cavity from the nasal cavity. A similar structure is found in crocodilians, but in most other tetrapods, the oral and nasal cavities are not truly separated. The palate is divided into two parts, the anterior, bony hard palate and the posterior, fleshy soft palate (or velum). The maxillary nerve branch of the trigeminal nerve supplies sensory innervation to the palate. If the fusion is incomplete,  a cleft palate results."}}, {"canonical_name": "tapir", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tapir", "book_id": "origin_of_species_darwin_1859", "name": "tapir", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["tapir"], "contexts": ["large herbivorous mammal", "mammal species"]}, {"entity_id": "tapirs", "book_id": "kosmos_humboldt_1845", "name": "tapirs", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["tapirs"], "contexts": ["extant mammal species"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "tapir", "target_book": "kosmos_humboldt_1845", "target_name": "tapirs", "similarity": 0.961}], "id": 1528, "stable_key": "clu_139bf313665de293", "ground_truth": {"modern_name": "Tapir", "confidence": "high", "type": "animal", "wikidata_id": "Q3745367", "wikidata_description": "family of mammals", "wikipedia_url": "https://en.wikipedia.org/wiki/Baird's_tapir", "wikipedia_extract": "The Baird's tapir (Tapirus bairdii), also known as the Central American tapir, is a species of tapir native to Mexico, Central America, and northwestern South America. It is the largest of the three species of tapir native to the Americas, as well as the largest native land mammal in both Central and South America. The Baird's tapir is named after the American naturalist Spencer Fullerton Baird, who traveled to Mexico in 1843 and observed the animals. However, the species was first documented by another American naturalist, W. T. White."}}, {"canonical_name": "Trigonia", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "trigonia", "book_id": "origin_of_species_darwin_1859", "name": "Trigonia", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Trigonia"], "contexts": ["genus of shells in secondary formations", "animal genus"]}, {"entity_id": "trigonia", "book_id": "kosmos_humboldt_1845", "name": "trigonia", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["trigonia"], "contexts": ["fossil bivalve mollusk"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Trigonia", "target_book": "kosmos_humboldt_1845", "target_name": "trigonia", "similarity": 0.857}], "id": 1529, "stable_key": "clu_4c0e75f16c9cbb44", "ground_truth": {"modern_name": "Trigonia", "confidence": "high", "type": "animal", "wikidata_id": "Q2835589", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Trigonia_%28plant%29", "wikipedia_extract": "Vanbreenia is an extinct genus of toothed whale from the Miocene epoch, containing only the species Vanbreenia trigonia. Its fossils have been found in the Miste area of Winterswijk in the Netherlands. Vanbreenia was named after Dr. P.J.H. van Bree from the Zoological Museum Amsterdam. Its grammatical gender (in Latin) is feminine."}}, {"canonical_name": "stag", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "stag", "book_id": "origin_of_species_darwin_1859", "name": "stag", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["stag"], "contexts": ["example of male weapon importance"]}, {"entity_id": "stags", "book_id": "origin_of_species_darwin_1859", "name": "stags", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["stags"], "contexts": ["animal with a single antler variation"]}, {"entity_id": "stag", "book_id": "kosmos_humboldt_1845", "name": "stag", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["stag"], "contexts": ["extant animal found as fossil"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "stag", "target_book": "kosmos_humboldt_1845", "target_name": "stag", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "stags", "target_book": "kosmos_humboldt_1845", "target_name": "stag", "similarity": 0.937}], "id": 1530, "stable_key": "clu_5aa77a74674f3e22", "ground_truth": {"modern_name": "Red Deer", "confidence": "high", "type": "animal", "note": "While 'stag' specifically refers to a male deer, and 'red deer' is a common species associated with this term in British contexts, the early modern texts might have used 'stag' more generally. However, given the context of Darwin and Humboldt, 'red deer' is a strong possibility.", "wikidata_id": "Q79794", "wikidata_description": "species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Red_deer", "wikipedia_extract": "Red Deer is a city in Alberta, Canada, located midway on the Calgary–Edmonton Corridor. Red Deer serves central Alberta, and its key industries include health care, retail trade, construction, oil and gas, hospitality, manufacturing and education. It is surrounded by Red Deer County and borders on Lacombe County. The city is in aspen parkland, a region of rolling hills, alongside the Red Deer River. The area was inhabited by First Nations including the Blackfoot, Plains Cree and Stoney before the arrival of European fur traders in the late eighteenth century. A First Nations trail ran from the Montana Territory across the Bow River near present-day Calgary and on to Fort Edmonton, later known as the Calgary and Edmonton Trail."}}, {"canonical_name": "Fossile Cycadeen", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "fossile_cycadeen", "book_id": "kosmos_humboldt_1845", "name": "Fossile Cycadeen", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 2, "variants": ["Fossile Cycadeen"], "contexts": ["publication on fossil cycadeans", "publication about fossil cycadeans"]}, {"entity_id": "fossil_sessile_cirripedes", "book_id": "origin_of_species_darwin_1859", "name": "Fossil Sessile Cirripedes", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Fossil Sessile Cirripedes"], "contexts": ["title of a memoir"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Fossile Cycadeen", "target_book": "origin_of_species_darwin_1859", "target_name": "Fossil Sessile Cirripedes", "similarity": 0.854}], "id": 1531, "stable_key": "clu_110387023c0f8e4e", "ground_truth": {"modern_name": "Fossil Cycadeans", "confidence": "high", "type": "text", "note": "This appears to be a title or subject of a publication rather than an organization."}}, {"canonical_name": "monocotyledons", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "monocotyledons", "book_id": "kosmos_humboldt_1845", "name": "monocotyledons", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["monocotyledons"], "contexts": ["plants with slender spikes", "plants in coal measures"]}, {"entity_id": "monochanthus", "book_id": "origin_of_species_darwin_1859", "name": "Monochanthus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Monochanthus"], "contexts": ["genus of orchids"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "monocotyledons", "target_book": "origin_of_species_darwin_1859", "target_name": "Monochanthus", "similarity": 0.864}], "id": 1532, "stable_key": "clu_dba12f7aad1dbacb", "ground_truth": {"modern_name": "Monocotyledons", "confidence": "high", "type": "plant", "note": "'Monochanthus' seems to be a misspelling or variant of 'Monocotyledons' in one instance.", "wikipedia_extract": "Monocotyledons (), commonly referred to as monocots, (Lilianae sensu Chase & Reveal) are flowering plants whose seeds contain only one embryonic leaf, or cotyledon. A monocot taxon has been in use for several decades, but with various ranks and under several different names. The APG IV system recognises its monophyly but does not assign it to a taxonomic rank, and instead uses the term \"monocots\" to refer to the group. Monocotyledons are contrasted with the dicotyledons, which have two cotyledons. Unlike the monocots however, the dicots are not monophyletic and the two cotyledons are instead the ancestral characteristic of all flowering plants. Botanists now classify dicots into the eudicots (\"true dicots\") and several basal lineages from which the monocots emerged.", "wikipedia_url": "https://en.wikipedia.org/wiki/Monocotyledon"}}, {"canonical_name": "Palaeologica", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "palaeologica", "book_id": "kosmos_humboldt_1845", "name": "Palaeologica", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 2, "variants": ["Palaeologica"], "contexts": ["publication title", "book by Hermann von Meyer"]}, {"entity_id": "palæontological_collections", "book_id": "origin_of_species_darwin_1859", "name": "palæontological collections", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["palæontological collections"], "contexts": ["collections of fossils"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Palaeologica", "target_book": "origin_of_species_darwin_1859", "target_name": "palæontological collections", "similarity": 0.862}], "id": 1533, "stable_key": "clu_46acf517e8edc652", "ground_truth": {"modern_name": "Paleontological Collections", "confidence": "high", "type": "concept", "note": "This refers to a collection of fossils or the study thereof.", "wikidata_id": "Q116900141", "wikidata_description": "Paleontological collections at Natural History Museum in Oslo"}}, {"canonical_name": "devonian system", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "devonian_system", "book_id": "kosmos_humboldt_1845", "name": "devonian system", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["devonian system"], "contexts": ["geological period"]}, {"entity_id": "devonian", "book_id": "origin_of_species_darwin_1859", "name": "Devonian", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Devonian"], "contexts": ["geological period"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "devonian system", "target_book": "origin_of_species_darwin_1859", "target_name": "Devonian", "similarity": 0.875}], "id": 1534, "stable_key": "clu_53648033f18c84e8", "ground_truth": {"modern_name": "Devonian period", "confidence": "high", "type": "concept"}}, {"canonical_name": "Kattywar", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "kattywar", "book_id": "origin_of_species_darwin_1859", "name": "Kattywar", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Kattywar"], "contexts": ["Kattywar breed of horses", "breed of horses"]}, {"entity_id": "kathiawar", "book_id": "coloquios_da_orta_1563", "name": "Kathiawar", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Kathiawar"], "contexts": ["peninsula traversed during expedition"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Kattywar", "target_book": "coloquios_da_orta_1563", "target_name": "Kathiawar", "similarity": 0.894}], "id": 1535, "stable_key": "clu_9fe77bf9fdeb6bc3", "ground_truth": {"wikipedia_extract": "Kathiawar (Gujarati: [kɑʈʰijɑʋɑɽ]), also known as Saurashtra (Gujarati: [sɔɾɑʂʈrə]), is a peninsula in the south-western Gujarat state in India, bordering the Arabian Sea and covering about 61,000 km2 (23,500 sq mi). It is bounded by the Kutch district in the north, the Gulf of Kutch in the northwest, and by the Gulf of Khambhat in the east. In the northeast, it is connected to the rest of the state and borders on the low, fertile hinterland of Ahmedabad. It is crossed by two belts of hill country and is drained radially by nine rivers which have little natural flow aside from in monsoon months, thus dams have been built on some of these. Kathiawar ports have been flourishing centres of trade and commerce since at least the 16th century. It was formerly a state of India."}}, {"canonical_name": "ichneumon", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ichneumon", "book_id": "coloquios_da_orta_1563", "name": "ichneumon", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 2, "variants": ["ichneumon", "Ichneumon"], "contexts": ["name used in some books for the animal", "animal name"]}, {"entity_id": "ichneumon", "book_id": "origin_of_species_darwin_1859", "name": "ichneumon", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["ichneumon"], "contexts": ["insect with an ovipositor"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "ichneumon", "target_book": "origin_of_species_darwin_1859", "target_name": "ichneumon", "similarity": 0.853}], "id": 1536, "stable_key": "clu_fb51831329bfc07e", "ground_truth": {"modern_name": "Ichneumon wasp", "confidence": "high", "type": "animal", "note": "The 'ichneumon' in early modern texts could refer to several animals, but in the context of insect anatomy (ovipositor) and biological discussions, the ichneumon wasp (family Ichneumonidae) is the most likely referent.", "wikidata_id": "Q1138186", "wikidata_description": "family of insects"}}, {"canonical_name": "Matthiola annua", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "matthiola_annua", "book_id": "origin_of_species_darwin_1859", "name": "Matthiola annua", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Matthiola annua"], "contexts": ["closely related plant form"]}, {"entity_id": "matthiola", "book_id": "origin_of_species_darwin_1859", "name": "Matthiola", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Matthiola"], "contexts": ["reciprocal crosses of"]}, {"entity_id": "mathiola_annua", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mathiola annua", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Mathiola annua"], "contexts": ["plant used for paper preparation"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Matthiola annua", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mathiola annua", "similarity": 0.984}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Matthiola", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mathiola annua", "similarity": 0.872}], "id": 1537, "stable_key": "clu_481d1d6fb357e40d", "ground_truth": {"modern_name": "Stock", "confidence": "high", "type": "plant", "linnaean": "Matthiola incana", "family": "Brassicaceae", "note": "The specific epithet 'annua' is sometimes used, but 'incana' is the more commonly accepted species for ornamental stock. Given the context of its use in scientific texts, it refers to the ornamental plant.", "wikidata_id": "Q27961", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Matthiola"}}, {"canonical_name": "albinism", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "albinism", "book_id": "origin_of_species_darwin_1859", "name": "albinism", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["albinism"], "contexts": ["inherited condition of lack of pigment", "lack of pigmentation, monstrous character"]}, {"entity_id": "albis_mensibus", "book_id": "polyanthea_medicinal", "name": "albis mensibus", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["albis mensibus"], "contexts": ["white menses"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "albinism", "target_book": "polyanthea_medicinal", "target_name": "albis mensibus", "similarity": 0.857}], "id": 1538, "stable_key": "clu_2dd4fd62f79e3bef", "ground_truth": {"wikipedia_extract": "Albinism is the congenital absence of melanin in an animal or plant resulting in white hair, red hair, yellow hair, feathers, scales and skin and red, pink, purple, or blue eyes. Individuals with the condition are referred to as albinos. Varied use and interpretation of the terms mean that written reports of albinistic animals can be difficult to verify. Albinism can reduce the survivability of an animal; for example, it has been suggested that albino alligators have an average survival span of only 24 years due to the lack of protection from UV radiation and their lack of camouflage to avoid predators. It is a common misconception that all albino animals have characteristic pink or red or violet eyes (resulting from the lack of pigment in the iris allowing the blood vessels of the retina to be visible); this is not the case for some forms of albinism. Familiar albino animals include in-bred strains of laboratory animals (rats, mice and rabbits), but populations of naturally occurring albino animals exist in the wild, e.g., Mexican cave tetra."}}, {"canonical_name": "helianthus", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "helianthus", "book_id": "connexion_physical_sciences_somerville_1858", "name": "helianthus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["helianthus"], "contexts": ["plant studied for surface area", "plant with leaves for surface calculation"]}, {"entity_id": "hyacinth", "book_id": "origin_of_species_darwin_1859", "name": "hyacinth", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["hyacinth"], "contexts": ["cultivated plant studied for variation"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "helianthus", "target_book": "origin_of_species_darwin_1859", "target_name": "hyacinth", "similarity": 0.882}], "id": 1539, "stable_key": "clu_ab848335c4652d00", "ground_truth": {"wikipedia_extract": "Hyacinthus  is a genus of bulbous herbs and spring-blooming perennials. They are fragrant flowering plants in the family Asparagaceae, subfamily Scilloideae and are commonly called hyacinths (). The genus is native predominantly to the Eastern Mediterranean region from the south of Turkey to the Palestine region, although naturalized more widely. The name comes from Greek mythology: Hyacinth was killed by Zephyrus, the god of the west wind, jealous of his love for Apollo. He then transformed the drops of Hyacinth's blood into flowers. Several species of Brodiaea, Scilla, and other plants that have flower clusters borne along the stalk that were formerly classified in the Liliaceae family also have common names with the word \"hyacinth\" in them."}}, {"canonical_name": "extinct species", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "extinct_species", "book_id": "origin_of_species_darwin_1859", "name": "extinct species", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["extinct species"], "contexts": ["species no longer living", "species that no longer exist"]}, {"entity_id": "extinct_beings", "book_id": "connexion_physical_sciences_somerville_1858", "name": "extinct beings", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["extinct beings"], "contexts": ["organisms no longer living"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "extinct species", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "extinct beings", "similarity": 0.956}], "id": 1540, "stable_key": "clu_9c423bb5d23bc922", "ground_truth": {"modern_name": "Extinct species", "confidence": "high", "type": "concept", "note": "This cluster refers to the general concept of species that no longer exist, a fundamental idea in evolutionary biology.", "wikidata_id": "Q1385098", "wikidata_description": "fading of non-reinforced conditioned response over time", "wikipedia_url": "https://en.wikipedia.org/wiki/List_of_extinct_animals_of_the_British_Isles", "wikipedia_extract": "This is a list of extinct animals of the British Isles, including locally extinct (extirpated) species. The list includes introduced species only in cases where they were able to form self-sustaining colonies for a time. Only species that have become extinct since the onset of the Late Pleistocene, and by extension the beginning of the Last Interglacial (also known as the Ipswichian or Eemian) around 130,000 years ago are included (such that the assemblage that can be approximately considered the 'modern' fauna). The date beside each species is the last date when a specimen was observed in the wild or, where this is not known, the approximate date of extinction. For most of the Neogene and Pleistocene, the British Isles were part of the main continent of Eurasia, linked by a landbridge between southern England and northern France. Throughout the Pleistocene (Ice age) the climate alternated between cold glacial periods, including times when the climate was too cold to support much fauna, and temperate interglacials when a much larger fauna was present."}}, {"canonical_name": "British Channel", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "british_channel", "book_id": "connexion_physical_sciences_somerville_1858", "name": "British Channel", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["British Channel"], "contexts": ["narrow sea channel with high tides", "height of tides"]}, {"entity_id": "british_channel", "book_id": "origin_of_species_darwin_1859", "name": "British Channel", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["British Channel"], "contexts": ["body of water separating islands"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "British Channel", "target_book": "origin_of_species_darwin_1859", "target_name": "British Channel", "similarity": 1.0}], "id": 1541, "stable_key": "clu_efd9965fbe8aa495", "ground_truth": {"modern_name": "English Channel", "confidence": "high", "type": "place", "country": "United Kingdom, France", "wikidata_id": "Q24645904", "wikidata_description": "watercourse in the United Kingdom", "wikipedia_extract": "The Channel Islands are an archipelago in the English Channel, off the French coast of Normandy. They are divided into two Crown Dependencies: the Bailiwick of Jersey, which is the largest of the islands; and the Bailiwick of Guernsey, consisting of Guernsey, Alderney, Sark, Herm and some smaller islands. Historically, they are the remnants of the Duchy of Normandy. Although they are not part of the United Kingdom, the UK is responsible for the defence and international relations of the islands as it is for the other Crown Dependency, the Isle of Man, and the British Overseas Territories. The Crown Dependencies are neither members of the Commonwealth of Nations, nor part of the European Union. They have a total population of about 171,916, and the bailiwicks' capitals, Saint Helier and Saint Peter Port, have populations of 33,500 and 18,207 respectively.", "wikipedia_url": "https://en.wikipedia.org/wiki/Channel_Islands"}}, {"canonical_name": "butterfly", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "butterfly", "book_id": "origin_of_species_darwin_1859", "name": "butterfly", "category": "ANIMAL", "subcategory": "INSECT", "count": 2, "variants": ["butterfly"], "contexts": ["flying insect", "insect with larval and adult stages"]}, {"entity_id": "butterfly", "book_id": "first_principles_spencer_1862", "name": "butterfly", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["butterfly"], "contexts": ["example of longitudinal union in Annulosa"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "butterfly", "target_book": "first_principles_spencer_1862", "target_name": "butterfly", "similarity": 0.811}], "id": 1542, "stable_key": "clu_952fba4c6dbe03cd", "ground_truth": {"modern_name": "Butterfly", "confidence": "high", "type": "animal", "wikidata_id": "Q11946202", "wikidata_description": "group of insects in the order Lepidoptera", "wikipedia_extract": "Animals are multicellular, eukaryotic organisms belonging to the biological kingdom Animalia (). With few exceptions, animals consume organic material, breathe oxygen, have myocytes and are able to move, can reproduce sexually, and grow from a hollow sphere of cells, the blastula, during embryonic development. Animals form a clade, meaning that they arose from a single common ancestor. Over 1.5 million living animal species have been described, of which around 1.05 million are insects, over 85,000 are molluscs, and around 65,000 are vertebrates. It has been estimated there are as many as 7.77 million animal species on Earth. Animal body lengths range from 8.5 μm (0.00033 in) to 33.6 m (110 ft).", "wikipedia_url": "https://en.wikipedia.org/wiki/Animal"}}, {"canonical_name": "capsule", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "capsule", "book_id": "origin_of_species_darwin_1859", "name": "capsule", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["capsule"], "contexts": ["seed-bearing structure in plants", "part of a plant containing seeds"]}, {"entity_id": "capsule", "book_id": "first_principles_spencer_1862", "name": "capsule", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["capsule"], "contexts": ["part of a flower"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "capsule", "target_book": "first_principles_spencer_1862", "target_name": "capsule", "similarity": 1.0}], "id": 1543, "stable_key": "clu_efb009dc148452c6", "ground_truth": {"modern_name": "Capsule (botany)", "confidence": "high", "type": "plant", "note": "Refers to the dry fruit of a flowering plant, typically dehiscent.", "wikipedia_extract": "This glossary of botanical terms is a list of definitions of terms and concepts relevant to botany and plants in general. Terms of plant morphology are included here as well as at the more specific Glossary of plant morphology and Glossary of leaf morphology. For other related terms, see Glossary of phytopathology, Glossary of lichen terms, and List of Latin and Greek words commonly used in systematic names. Prefix meaning \"position away from\". Surface of an organ facing away from the organ's axis, e.g. the lower surface of a lateral organ such as a leaf or petal.", "wikipedia_url": "https://en.wikipedia.org/wiki/Glossary_of_botanical_terms"}}, {"canonical_name": "zoologist", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "zoologist", "book_id": "origin_of_species_darwin_1859", "name": "zoologist", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["zoologist"], "contexts": ["expert in animal classification"]}, {"entity_id": "zoologists", "book_id": "origin_of_species_darwin_1859", "name": "zoologists", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["zoologists"], "contexts": ["experts in animal classification"]}, {"entity_id": "zoologists", "book_id": "first_principles_spencer_1862", "name": "zoologists", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["zoologists"], "contexts": ["scientists studying animals"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "zoologist", "target_book": "first_principles_spencer_1862", "target_name": "zoologists", "similarity": 0.976}, {"source_book": "origin_of_species_darwin_1859", "source_name": "zoologists", "target_book": "first_principles_spencer_1862", "target_name": "zoologists", "similarity": 1.0}], "id": 1544, "stable_key": "clu_b1a7cd301ceaf966", "ground_truth": {"modern_name": "Zoologist", "confidence": "high", "type": "person", "description": "Scientist specializing in the study of animals.", "wikipedia_extract": "Hisashi Abe (阿部 永, Abe Hisashi; born 1933) is a Japanese mammalogist and a former professor of Zoology at Hokkaido University Sapporo in Hokkaidō, Japan. He has authored a variety of publications on the taxonomy of various mammal species endemic to East Asia. He was formerly the president of Mammal Society of Japan. Abe was born during 1933 in Yoshinogawa, Tokushima.", "wikipedia_url": "https://en.wikipedia.org/wiki/Hisashi_Abe"}}, {"canonical_name": "alimentary canal", "category": "ANATOMY", "subcategory": "ORGAN", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "alimentary_canal", "book_id": "first_principles_spencer_1862", "name": "alimentary canal", "category": "ANATOMY", "subcategory": "ORGAN", "count": 2, "variants": ["alimentary canal"], "contexts": ["development from mucous layer", "upper portion developing lungs"]}, {"entity_id": "alimentary_canal", "book_id": "origin_of_species_darwin_1859", "name": "alimentary canal", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["alimentary canal"], "contexts": ["tube for digestion and excretion"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "alimentary canal", "target_book": "origin_of_species_darwin_1859", "target_name": "alimentary canal", "similarity": 0.87}], "id": 1545, "stable_key": "clu_440fb8c68b462642", "ground_truth": {"modern_name": "Alimentary canal", "confidence": "high", "type": "anatomy", "wikidata_id": "Q14860194", "wikidata_description": "The process in which the anatomical structures of the digestive tract are generated and organized. The digestive tract is the anatomical structure through which food passes and is processed."}}, {"canonical_name": "subsistence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "subsistence", "book_id": "first_principles_spencer_1862", "name": "subsistence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["subsistence"], "contexts": ["means of maintaining life", "means of supporting life"]}, {"entity_id": "subsistence", "book_id": "origin_of_species_darwin_1859", "name": "subsistence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["subsistence"], "contexts": ["struggle for survival"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "subsistence", "target_book": "origin_of_species_darwin_1859", "target_name": "subsistence", "similarity": 1.0}], "id": 1546, "stable_key": "clu_ebde03a8e3388124", "ground_truth": {"modern_name": "Subsistence", "confidence": "high", "type": "concept", "note": "In these contexts, it refers to the ability of an organism to maintain its existence and to reproduce.", "wikidata_id": "Q2787508", "wikidata_description": "farming which meets the basic needs of the farmer and family", "wikipedia_extract": "The iron law of wages is a proposed law of economics that asserts that real wages always tend, in the long run, toward the minimum wage necessary to sustain the life of the worker. The theory was first named by Ferdinand Lassalle in the mid-nineteenth century. Karl Marx and Friedrich Engels attribute the doctrine to Lassalle (notably in Marx's 1875 Critique of the Gotha Program), the idea to Thomas Malthus's (1798) An Essay on the Principle of Population, and the terminology to Goethe's \"great, eternal iron laws\" in Das Göttliche. It was coined in reference to the views of classical economists such as David Ricardo's law of rent, and the competing population theory of Thomas Malthus. It held that the market price of labor (which tends toward the minimum required for the subsistence of the laborers) would always, or almost always, reduce as the working population increased and vice versa. Ricardo believed that this happened only under particular conditions.", "wikipedia_url": "https://en.wikipedia.org/wiki/Iron_law_of_wages"}}, {"canonical_name": "queen-bee", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "queen-bee", "book_id": "origin_of_species_darwin_1859", "name": "queen-bee", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["queen-bee"], "contexts": ["fertile female bee"]}, {"entity_id": "queen", "book_id": "origin_of_species_darwin_1859", "name": "queen", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["queen"], "contexts": ["bee, killing rivals"]}, {"entity_id": "queen-bee", "book_id": "first_principles_spencer_1862", "name": "queen-bee", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["queen-bee"], "contexts": ["reproductive female bee"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "queen-bee", "target_book": "first_principles_spencer_1862", "target_name": "queen-bee", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "queen", "target_book": "first_principles_spencer_1862", "target_name": "queen-bee", "similarity": 0.887}], "id": 1547, "stable_key": "clu_01a9408f82d6fa6e", "ground_truth": {"modern_name": "Queen bee", "confidence": "high", "type": "animal", "wikidata_id": "Q770569", "wikidata_description": "German comedy musical group", "wikipedia_extract": "A queen bee is typically an adult, mated female (gyne) that lives in a colony or hive of honey bees. With fully developed reproductive organs, the queen is usually the mother of most, if not all, of the bees in the beehive. Queens are developed from larvae selected by worker bees and specially fed in order to become sexually mature. There is normally only one adult, mated queen in a hive, in which case the bees will usually follow and fiercely protect her. The term \"queen bee\" can be more generally applied to any dominant reproductive female in a colony of a eusocial bee species other than honey bees. However, as in the Brazilian stingless bee (Schwarziana quadripunctata), a single nest may have multiple queens or even dwarf queens, ready to replace a dominant queen in case of a sudden death.", "wikipedia_url": "https://de.wikipedia.org/wiki/Queen_Bee"}}, {"canonical_name": "Sculpture", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "sculpture", "book_id": "first_principles_spencer_1862", "name": "Sculpture", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Sculpture"], "contexts": ["art form derived from mural decoration", "artistic discipline"]}, {"entity_id": "sculpture", "book_id": "origin_of_species_darwin_1859", "name": "sculpture", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sculpture"], "contexts": ["surface markings on organisms"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "Sculpture", "target_book": "origin_of_species_darwin_1859", "target_name": "sculpture", "similarity": 0.97}], "id": 1548, "stable_key": "clu_a16b30f895f21314", "ground_truth": {"modern_name": "Sculpture", "confidence": "high", "type": "concept", "wikidata_id": "Q860861", "wikidata_description": "three-dimensional work of art", "wikipedia_url": "https://fr.wikipedia.org/wiki/Sculpture_%28%C5%93uvre_d%27art%29"}}, {"canonical_name": "adult", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "adult", "book_id": "origin_of_species_darwin_1859", "name": "adult", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["adult"], "contexts": ["fully developed organism"]}, {"entity_id": "adult_forms", "book_id": "origin_of_species_darwin_1859", "name": "adult forms", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["adult forms"], "contexts": ["fully developed organisms"]}, {"entity_id": "adult", "book_id": "first_principles_spencer_1862", "name": "adult", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["adult"], "contexts": ["fully developed organism"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "adult", "target_book": "first_principles_spencer_1862", "target_name": "adult", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "adult forms", "target_book": "first_principles_spencer_1862", "target_name": "adult", "similarity": 0.928}], "id": 1549, "stable_key": "clu_312098f1ccfa84d8", "ground_truth": {"modern_name": "Adult", "confidence": "high", "type": "concept", "note": "Refers to the fully developed stage of an organism.", "wikidata_id": "Q80994", "wikidata_description": "living organism that has reached sexual maturity", "wikipedia_extract": "Adultism is a bias or prejudice against children or youth. It has been defined as \"the power adults have over children\", or the abuse thereof, as well as \"prejudice and accompanying systematic discrimination against young people\", and \"bias towards adults... and the social addiction to adults, including their ideas, activities, and attitudes\". It can be considered a subtype of ageism, or prejudice and discrimination due to age in general. This phenomenon is said to affect families, schools, justice systems and the economy, in addition to other areas of society. Its impacts are largely regarded as negative, except in cases related to child protection and the overriding social contract.", "wikipedia_url": "https://en.wikipedia.org/wiki/Adult"}}, {"canonical_name": "House of Communs", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "house_of_communs", "book_id": "relation_historique_humboldt_vol3_1825", "name": "House of Communs", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["House of Communs", "House of Commons"], "contexts": ["institution that ordered a return", "parliamentary body"]}, {"entity_id": "house", "book_id": "principles_of_psychology_james_1890", "name": "house", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["house"], "contexts": ["dwelling place"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "House of Communs", "target_book": "principles_of_psychology_james_1890", "target_name": "house", "similarity": 0.814}], "id": 1550, "stable_key": "clu_38969e73d55c0172", "ground_truth": {"modern_name": "House of Commons", "confidence": "high", "type": "place", "country": "United Kingdom", "note": "The OCR 'Communs' is a misspelling of Commons.", "wikidata_id": "Q11005", "wikidata_description": "lower house in the Parliament of the United Kingdom", "wikipedia_extract": "In 18th- and 19th-century Britain, a molly house or molly-house was a meeting place for homosexual men. The meeting places were generally taverns, public houses, coffeehouses or even private rooms where patrons could either socialise or meet possible sexual partners. Despite the reputation of molly-houses as places having primarily sexual connotations, rather than as social meeting places, some historians are reluctant to classify them specifically as brothels. Rictor Norton, for example, argues that the regular customers could have been in fact mutual friends, at least at the beginning, since consistent evidence concerning male prostitution seems to be insufficient in Britain until the 1780s. From 1533 onwards, homosexual relations and sexual activities remained illegal and were frequently prosecuted, with homosexual sexual activities being included in the offence categories of buggery and sodomy (the terms which were often used interchangeably), they remained capital offences until 1861. From the 16th century onwards until 1861, particularly during the 1720s, molly-houses came to be the scenes of raids and arrests, and their customers frequently became targets for blackmail.", "wikipedia_url": "https://en.wikipedia.org/wiki/House_of_Commons_of_the_United_Kingdom"}}, {"canonical_name": "suicide", "category": "DISEASE", "subcategory": "PSYCHOLOGICAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "suicide", "book_id": "principles_of_psychology_james_1890", "name": "suicide", "category": "DISEASE", "subcategory": "PSYCHOLOGICAL", "count": 2, "variants": ["suicide"], "contexts": ["attempt driven by distress", "act of self-destruction"]}, {"entity_id": "suicide", "book_id": "relation_historique_humboldt_vol3_1825", "name": "suicide", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["suicide"], "contexts": ["act of self-killing"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "suicide", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "suicide", "similarity": 0.844}], "id": 1551, "stable_key": "clu_25f83835a587650f", "ground_truth": {"wikipedia_extract": "Suicide is the act of intentionally causing one's own death. Risk factors for suicide include mental disorders, neurodevelopmental disorders, physical disorders, and substance abuse. Some suicides are impulsive acts driven by stress (such as from financial or academic difficulties), relationship problems (such as breakups or divorces), or harassment and bullying. Those who have previously attempted suicide are at a higher risk for future attempts. Effective suicide prevention efforts include limiting access to methods of suicide such as firearms, drugs, and poisons; treating mental disorders and substance abuse; careful media reporting about suicide; improving economic conditions; and psychotherapy, primarily dialectical behaviour therapy (DBT) and cognitive behavioural therapy (CBT). Although crisis hotlines, like 988 in North America and 13 11 14 in Australia, are common resources, their effectiveness has not been well studied."}}, {"canonical_name": "albuminoid matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "albuminoid_matter", "book_id": "principles_of_psychology_james_1890", "name": "albuminoid matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["albuminoid matter"], "contexts": ["biological material of a person"]}, {"entity_id": "albumine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "albumine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["albumine"], "contexts": ["component of sugarcane juice"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "albuminoid matter", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "albumine", "similarity": 0.936}], "id": 1552, "stable_key": "clu_6bfd3cf162c53be5", "ground_truth": {"modern_name": "Albuminoid", "confidence": "high", "type": "chemical", "wikidata_id": "Q23851981", "wikidata_description": "article in Otto's encyclopedia"}}, {"canonical_name": "Athintic-Statcs", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "athintic-statcs", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Athintic-Statcs", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Athintic-Statcs", "Attantic-States"], "contexts": ["territory to be deducted", "states on both sides of mountains"]}, {"entity_id": "attica", "book_id": "kosmos_humboldt_1845", "name": "Attica", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Attica"], "contexts": ["region in Greece with geological observations"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Athintic-Statcs", "target_book": "kosmos_humboldt_1845", "target_name": "Attica", "similarity": 0.844}], "id": 1553, "stable_key": "clu_f17bcf4f7d7ba553", "ground_truth": {"modern_name": "Attica", "confidence": "high", "type": "place", "country": "Greece", "note": "The OCR 'Athintic-Statcs' is a misspelling of Attica.", "wikidata_id": "Q122443", "wikidata_description": "historical region of Greece, including the city of Athens", "wikipedia_extract": "Attica ( AT-ik-ə; Greek: Αττική [atiˈci]; Ancient Greek: Ἀττική [atːikɛ̌ː]), or the Attic Peninsula, is a historical region that encompasses the entire Athens metropolitan area, which consists of the city of Athens, the capital of Greece and the core city of the metropolitan area, as well as its surrounding suburban cities and towns. It is a peninsula projecting into the Aegean Sea, bordering on Boeotia to the north and Megaris to the west. The mines of Laurion were an important mining region located at Lavrio, on the southern tip of the peninsula. The history of Attica is closely linked with that of Athens. In ancient times, Attica corresponded with the classical Athens city‑state. It was the most prominent region in Ancient Greece, specifically during the Golden Age of Athens in the classical period.", "wikipedia_url": "https://en.wikipedia.org/wiki/Attica"}}, {"canonical_name": "Port d'Espot", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "port_d'espot", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Port d'Espot", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Port d'Espot", "Port Écossais"], "contexts": ["port name", "Scottish settlement"]}, {"entity_id": "port_d'oo", "book_id": "kosmos_humboldt_1845", "name": "Port d'Oo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Port d'Oo"], "contexts": ["location with limestone beds in granite"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Port d'Espot", "target_book": "kosmos_humboldt_1845", "target_name": "Port d'Oo", "similarity": 0.852}], "id": 1554, "stable_key": "clu_c7b9cf0f8b407efb", "ground_truth": {"modern_name": "Port d'Espot", "confidence": "high", "type": "place", "country": "France", "note": "The 'Port d'Oo' in Kosmos is likely a variant or related location. Espot is a known port in France."}}, {"canonical_name": "Puracè", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "puracè", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Puracè", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Puracè", "Purace"], "contexts": ["volcano", "village where observations were made"]}, {"entity_id": "purace", "book_id": "kosmos_humboldt_1845", "name": "Purace", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Purace"], "contexts": ["volcano between Bogota and Quito"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Puracè", "target_book": "kosmos_humboldt_1845", "target_name": "Purace", "similarity": 0.959}], "id": 1555, "stable_key": "clu_3d18aee21dc45f19", "ground_truth": {"modern_name": "Puracé", "confidence": "high", "type": "place", "country": "Colombia", "wikipedia_extract": "Puracé is an andesitic stratovolcano located in the Puracé National Natural Park in the Cauca Department, Colombia. It is part of the North Volcanic Zone of the Andean Volcanic Belt. The volcano is located at the intersection of the Coconucos and Morras Faults. It is one of the most active volcanoes in Colombia. Large explosive eruptions occurred in 1849, 1869, 1885, 1949, 1950, 1956, and 1957. There were about a dozen eruptions in the 20th century, the most recent being in 1977, until 19 January 2025 when Puracé once again erupted.", "wikipedia_url": "https://en.wikipedia.org/wiki/Puracé"}}, {"canonical_name": "Samana", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "samana", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Samana", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Samana", "Sama"], "contexts": ["river", "port, anchorage location"]}, {"entity_id": "samarang", "book_id": "kosmos_humboldt_1845", "name": "Samarang", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Samarang"], "contexts": ["province in Java"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Samana", "target_book": "kosmos_humboldt_1845", "target_name": "Samarang", "similarity": 0.85}], "id": 1556, "stable_key": "clu_af3960a1ae07b6a4", "ground_truth": {"modern_name": "Semarang", "confidence": "high", "type": "place", "country": "Indonesia", "note": "The text mentions 'Samana' and 'Samarang'. Given the context of a province in Java and its geographical location, Semarang is the most likely referent. 'Samana' might be an archaic or less common spelling, or a transcription error.", "wikidata_id": "Q11643111", "wikidata_description": "species of flowering plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Syzygium%20samarangense"}}, {"canonical_name": "état hygrométrique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "état_hygrométrique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "état hygrométrique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["état hygrométrique", "état cyanométrique"], "contexts": ["measure of atmospheric humidity", "measure of sky color/transparency"]}, {"entity_id": "hygrometric_state", "book_id": "first_principles_spencer_1862", "name": "hygrometric state", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hygrometric state"], "contexts": ["moisture content of air"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "état hygrométrique", "target_book": "first_principles_spencer_1862", "target_name": "hygrometric state", "similarity": 0.946}], "id": 1557, "stable_key": "clu_1e678d4f7468f654", "ground_truth": {"modern_name": "Relative humidity", "confidence": "high", "type": "concept", "note": "The term 'état hygrométrique' directly translates to 'hygrometric state' and refers to the measure of atmospheric humidity.", "wikidata_id": "Q2499617", "wikidata_description": "ratio of the partial pressure of water vapor in humid air to the equilibrium vapor pressure of water at a given temperature", "wikipedia_url": "https://en.wikipedia.org/wiki/Relative%20humidity"}}, {"canonical_name": "Moscou", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "moscou", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Moscou", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Moscou", "Moskou"], "contexts": ["location of magnetic force comparison", "city for observation"]}, {"entity_id": "moscow", "book_id": "kosmos_humboldt_1845", "name": "Moscow", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Moscow"], "contexts": ["northern city with magnetic stations"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Moscou", "target_book": "kosmos_humboldt_1845", "target_name": "Moscow", "similarity": 0.96}], "id": 1558, "stable_key": "clu_c2391e9f3fa32a39", "ground_truth": {"modern_name": "Moscow", "confidence": "high", "type": "place", "country": "Russia", "note": "Both 'Moscou' and 'Moscow' refer to the capital city of Russia.", "wikidata_id": "Q649", "wikidata_description": "capital and most populous city of Russia", "wikipedia_url": "https://en.wikipedia.org/wiki/Moscow", "wikipedia_extract": "Moscow is the capital and largest city of Russia, standing on the Moskva River in Central Russia. It has a population estimated at over 13 million residents within the city limits, over 19.1 million residents in the urban area, and over 21.5 million residents in its metropolitan area. The city covers an area of 2,511 square kilometers (970 mi2), while the urban area covers 5,891 square kilometers (2,275 mi2), and the metropolitan area covers over 26,000 square kilometers (10,000 mi2). Moscow is among the world's largest cities, being the most populous city entirely in Europe, the largest urban and metropolitan area in Europe, and the largest city by land area on the European continent. First documented in 1147, Moscow became the capital of the Grand Principality of Moscow, which led the unification of the Russian lands in the 15th century and became the center of a unified state. Following the proclamation of the Tsardom of Russia in 1547, Moscow remained the political and economic center for most of its history."}}, {"canonical_name": "Saône", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "saône", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Saône", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Saône"], "contexts": ["river basin", "river connected by canal"]}, {"entity_id": "seine", "book_id": "kosmos_humboldt_1845", "name": "Seine", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Seine"], "contexts": ["river banks used for longitude determination"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saône", "target_book": "kosmos_humboldt_1845", "target_name": "Seine", "similarity": 0.845}], "id": 1559, "stable_key": "clu_5924359a4de2dd94", "ground_truth": {"modern_name": "Saône", "confidence": "high", "type": "place", "country": "France", "note": "While 'Seine' is a major French river, the context of river basin and longitude determination, coupled with 'Saône' appearing twice, strongly suggests the Saône river. 'Saône' is a tributary of the Rhône, not the Seine.", "wikidata_id": "Q83657531", "wikidata_description": "painting by Jan Ferdinand Monchablon", "wikipedia_extract": "The Saône ( SOHN, French: [son]; Arpitan: Sona; Latin: Arar) is a river in eastern France (modern region of Bourgogne-Franche-Comté). It is a right tributary of the Rhône, rising at Vioménil in the Vosges department and joining the Rhône in Lyon, at the southern end of the Presqu'île. The name Saône derives from that of the Gallic river goddess Souconna, which has also been connected with a local Celtic tribe, the Sequanes. Monastic copyists progressively transformed Souconna to Saoconna, which ultimately gave rise to Saône. The other recorded ancient names for the river were Brigoulus and Arar. The name Arar later gave rise to specific regional terms in historiography, created to designate various northern parts of historical Burgundy in relation to the river Saône."}}, {"canonical_name": "Cholula", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cholula", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cholula", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Cholula"], "contexts": ["pyramid of Cholula", "city with a pyramid"]}, {"entity_id": "cholula", "book_id": "kosmos_humboldt_1845", "name": "Cholula", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cholula"], "contexts": ["location where an aërolite was seen"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cholula", "target_book": "kosmos_humboldt_1845", "target_name": "Cholula", "similarity": 0.85}], "id": 1560, "stable_key": "clu_8efc4409a23e54ed", "ground_truth": {"modern_name": "Cholula", "confidence": "high", "type": "place", "country": "Mexico", "note": "Cholula is a well-known archaeological site and city in Mexico, famous for its pyramid and historical significance. Both spellings refer to the same location.", "wikidata_id": "Q7380613", "wikidata_description": "important city of pre-Columbian Mesoamerica", "wikipedia_extract": "The Great Pyramid of Cholula, also known as Tlachihualtepetl (Nahuatl for \"constructed mountain\"), is a complex located in Cholula, Puebla, Mexico. It is the largest archaeological site of a pyramid (temple) in the world, as well as the largest pyramid by volume known to exist in the world today. The adobe brick pyramid stands 25 metres (82 ft) above the surrounding plain, which is significantly shorter than the Great Pyramid of Giza's height of 146.6 metres (481 ft), but much wider, measuring 300 by 315 metres (984 by 1,033 ft) in its final form, compared to the Great Pyramid's base dimensions of 230.3 by 230.3 metres (756 by 756 ft). The pyramid is a temple that traditionally has been viewed as having been dedicated to the god Quetzalcoatl. The architectural style of the building was linked closely to that of Teotihuacan in the Valley of Mexico, although influence from the Gulf Coast is evident as well, especially from El Tajín. The Cholula archaeological zone is situated 6.4 kilometres (4 mi) west of the city of Puebla, in the city of Cholula.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cholula_%28Mesoamerican_site%29"}}, {"canonical_name": "Uuallaga", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "uuallaga", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Uuallaga", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Uuallaga"], "contexts": ["river"]}, {"entity_id": "ualan", "book_id": "kosmos_humboldt_1845", "name": "Ualan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Ualan"], "contexts": ["volcanic island with augmented gravitation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Uuallaga", "target_book": "kosmos_humboldt_1845", "target_name": "Ualan", "similarity": 0.842}], "id": 1561, "stable_key": "clu_878acfb525df25b8", "ground_truth": {"modern_name": "Ualan", "confidence": "high", "type": "place", "country": "Micronesia", "note": "Ualan (now part of Pohnpei) is a volcanic island known for its higher gravitational pull, fitting the context of geological observations. 'Uuallaga' is likely a variant or transcription error of Ualan.", "wikipedia_extract": "The era of European and American voyages of scientific exploration followed the Age of Discovery and were inspired by a new confidence in science and reason that arose in the Age of Enlightenment. Maritime expeditions in the Age of Discovery were a means of expanding colonial empires, establishing new trade routes and extending diplomatic and trade relations to new territories, but with the Enlightenment scientific curiosity became a new motive for exploration to add to the commercial and political ambitions of the past. See also List of Arctic expeditions and List of Antarctic expeditions. Maritime exploration in the Age of Discovery From the early 15th century to the early 17th century the Age of Discovery had, through Portuguese seafarers, and later, Spanish, Dutch, French and English, opened up southern Africa, the Americas (New World), Asia and Oceania to European eyes: Bartholomew Dias had sailed around the Cape of southern Africa in search of a trade route to India; Christopher Columbus, on four journeys across the Atlantic, had prepared the way for European colonisation of the New World; Ferdinand Magellan had commanded the first expedition to sail across the Atlantic and Pacific oceans to reach the Maluku Islands and was continued by Juan Sebastián Elcano, completing the first circumnavigation of the Earth. The Francisco Hernández expedition (1570–1577) (Spanish: Comisión de Francisco Hernández a Nueva España) is considered to be the first scientific expedition to the New World, led by Francisco Hernández de Toledo, a naturalist and physician of the Court of King Philip II, who was highly regarded in Spain because of his works on herbal medicine. Among some of the most important achievements of the expedition were the discovery and subsequent introduction in Europe of a number of new plants that did not exist in the Old World, but that quickly gained acceptance and become very popular among European consumers, such as pineapples, cocoa, corn, and many others.", "wikipedia_url": "https://en.wikipedia.org/wiki/European_and_American_voyages_of_scientific_exploration"}}, {"canonical_name": "Saint-Gothard", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "saint-gothard", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Saint-Gothard", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Saint-Gothard"], "contexts": ["mountain pass", "mountain summit location"]}, {"entity_id": "st__gothard", "book_id": "kosmos_humboldt_1845", "name": "St. Gothard", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["St. Gothard"], "contexts": ["mountain pass in the Alps"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saint-Gothard", "target_book": "kosmos_humboldt_1845", "target_name": "St. Gothard", "similarity": 0.924}], "id": 1562, "stable_key": "clu_e23f652a67dc450e", "ground_truth": {"modern_name": "St. Gotthard Pass", "confidence": "high", "type": "place", "country": "Switzerland", "note": "Both 'Saint-Gothard' and 'St. Gothard' refer to the famous mountain pass in the Alps.", "wikipedia_extract": "The Gotthard Pass or St. Gotthard Pass (Italian: Passo del San Gottardo; German: Gotthardpass) at 2,106 m (6,909 ft) is a mountain pass in the Alps traversing the Saint-Gotthard Massif and connecting northern Switzerland with southern Switzerland. The pass lies between Airolo in the Italian-speaking canton of Ticino, and Andermatt in the German-speaking canton of Uri, and connects further Bellinzona and Lugano to Lucerne, Basel, and Zürich. The Gotthard Pass lies at the heart of the Gotthard, a major transport axis of Europe, and it is crossed by three traffic tunnels, each being the world's longest at the time of their construction: the Gotthard Rail Tunnel (1882), the Gotthard Road Tunnel (1980) and the Gotthard Base Tunnel (2016). With the Lötschberg to the west, the Gotthard is one of the two main north-south routes through the Swiss Alps. Since the Middle Ages, transit across the Gotthard played an important role in Swiss history, the region north of the Gotthard becoming the nucleus of the Swiss Confederacy in the 13th century, after the pass became a vital trade route between Northern and Southern Europe."}}, {"canonical_name": "Smyrne", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "smyrne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Smyrne", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Smyrne"], "contexts": ["ancient city, modern Izmir, Turkey", "city where slave trade occurs"]}, {"entity_id": "smyrna", "book_id": "kosmos_humboldt_1845", "name": "Smyrna", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Smyrna"], "contexts": ["city where Orientalist resided"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Smyrne", "target_book": "kosmos_humboldt_1845", "target_name": "Smyrna", "similarity": 0.945}], "id": 1563, "stable_key": "clu_9b5b3309607650a7", "ground_truth": {"modern_name": "Izmir", "confidence": "high", "type": "place", "country": "Turkey", "note": "Smyrna is the ancient name for the modern Turkish city of Izmir. The context of an ancient city and its location fits.", "wikidata_id": "Q35997", "wikidata_description": "city in İzmir Province, Turkey", "wikipedia_extract": "İzmir is the third most populous city in Turkey, after Istanbul and Ankara. It is on the Aegean coast of Anatolia, and is the capital of İzmir Province. As of 2024, İzmir Province has a total population of 4,493,242 while İzmir city is home to around 3.3 million inhabitants. It extends along the outlying waters of the Gulf of İzmir and inland to the north across the Gediz River Delta; to the east along an alluvial plain created by several small streams; and to slightly more rugged terrain in the south. İzmir's climate is Mediterranean. İzmir has more than 3,000 years of recorded urban history, and up to 8,500 years of history as a human settlement since the Neolithic period. In classical antiquity, the city was known as Smyrna – a name which remained in use in English and various other languages until around 1930, when government efforts led the original Greek name to be forcefully phased out internationally in favor of its Turkish counterpart İzmir. Lying on an advantageous location at the head of a gulf running down in a deep indentation, midway along the western Anatolian coast, İzmir has been one of the principal mercantile cities of the Mediterranean Sea for much of its history.", "wikipedia_url": "https://en.wikipedia.org/wiki/%C4%B0zmir"}}, {"canonical_name": "Fahr.", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "fahr_", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Fahr.", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Fahr."], "contexts": ["Fahrenheit scale for temperature", "unit of temperature measurement"]}, {"entity_id": "fahr_", "book_id": "kosmos_humboldt_1845", "name": "Fahr.", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Fahr."], "contexts": ["unit of temperature measurement"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Fahr.", "target_book": "kosmos_humboldt_1845", "target_name": "Fahr.", "similarity": 1.0}], "id": 1564, "stable_key": "clu_4ed9ffb8f2d10998", "ground_truth": {"modern_name": "Fahrenheit scale", "confidence": "high", "type": "concept", "wikidata_id": "Q105525247", "wikidata_description": "temperature scale", "wikipedia_url": "https://en.wikipedia.org/wiki/Fahrenheit%20scale", "wikipedia_extract": "The Fahrenheit scale () is a temperature scale based on one proposed in 1724 by the physicist Daniel Gabriel Fahrenheit (1686–1736). It uses the degree Fahrenheit (symbol: °F) as the unit. Several accounts of how he originally defined his scale exist, but the original paper suggests the lower defining point, 0 °F, was established as the freezing temperature of a solution of brine made from a mixture of water, ice, and ammonium chloride (a salt). The other limit established was his best estimate of the average human body temperature, originally set at 90 °F, then 96 °F (about 2.6 °F less than the modern value due to a later redefinition of the scale). For much of the 20th century, the Fahrenheit scale was defined by two fixed points with a 180 °F separation: the temperature at which pure water freezes was defined as 32 °F and the boiling point of water was defined to be 212 °F, both at sea level and under standard atmospheric pressure. It is now formally defined using the Kelvin scale."}}, {"canonical_name": "Podocarpus", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "podocarpus", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Podocarpus", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["Podocarpus"], "contexts": ["genus of trees", "tree species found at certain altitudes"]}, {"entity_id": "podocarpus", "book_id": "kosmos_humboldt_1845", "name": "Podocarpus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Podocarpus"], "contexts": ["plant genus observed by Columbus"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Podocarpus", "target_book": "kosmos_humboldt_1845", "target_name": "Podocarpus", "similarity": 0.82}], "id": 1565, "stable_key": "clu_8721983039072206", "ground_truth": {"modern_name": "Podocarpus", "confidence": "high", "type": "plant", "linnaean": "Podocarpus L.f.", "family": "Podocarpaceae", "wikidata_id": "Q157524", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Podocarpus", "wikipedia_extract": "Podocarpus () is a genus of conifers, the most numerous and widely distributed of the podocarp family, the Podocarpaceae. Podocarpus species are evergreen shrubs or trees, usually from 1 to 25 m (3 to 82 ft) tall, known to reach 40 m (130 ft) at times. The cones have two to five fused cone scales, which form a fleshy, berry-like, brightly coloured receptacle at maturity. The fleshy cones attract birds, which then eat the cones and disperse the seeds in their droppings. Plants of the World Online accepts 116 species. Other authorities place 97 to 107 species in the genus depending on the circumscription of the species."}}, {"canonical_name": "Taman", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "taman", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Taman", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Taman"], "contexts": ["location of salses with cold water", "peninsula with mud volcanoes"]}, {"entity_id": "taman", "book_id": "kosmos_humboldt_1845", "name": "Taman", "category": "PLACE", "subcategory": "PENINSULA", "count": 1, "variants": ["Taman"], "contexts": ["peninsula where gases were studied"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Taman", "target_book": "kosmos_humboldt_1845", "target_name": "Taman", "similarity": 0.823}], "id": 1566, "stable_key": "clu_112cea31a63c6bc2", "ground_truth": {"modern_name": "Tamán", "confidence": "medium", "type": "place", "country": "Venezuela", "note": "Context suggests a location studied for gases, possibly in Venezuela given Humboldt's travels. 'Taman' is also a common name for trees.", "wikipedia_extract": "Taman Negara is a national park in Peninsular Malaysia. It was established in 1938 and 1939 as the King George V National Park after Theodore Hubback lobbied the sultans of Pahang, Terengganu and Kelantan to set aside a piece of land that covers the three states for the creation of a protected area. After independence, it was renamed Taman Negara, which means \"national park\" in Malay. Taman Negara has a total area of 4,343 km2 and it is one of the world's oldest rainforests, estimated to be more than 130 million years old. Mount Tahan, Peninsular Malaysia's highest point with an elevation of 7,175 ft (2,187 m) above sea level, is within the park's boundaries. Taman Negara is an important conservation area for the Peninsular Malaysian rain forest and montane rain forest ecoregions, is rich in biodiversity and home to several endangered species such as the Malayan tiger and Asian elephant.", "wikipedia_url": "https://en.wikipedia.org/wiki/Taman_Negara"}}, {"canonical_name": "Sassuolo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "sassuolo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sassuolo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Sassuolo"], "contexts": ["town name", "location of a salse"]}, {"entity_id": "sassuolo", "book_id": "kosmos_humboldt_1845", "name": "Sassuolo", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Sassuolo"], "contexts": ["town in Northern Italy"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sassuolo", "target_book": "kosmos_humboldt_1845", "target_name": "Sassuolo", "similarity": 0.853}], "id": 1567, "stable_key": "clu_f5d5851277f24634", "ground_truth": {"modern_name": "Sassuolo", "confidence": "high", "type": "place", "country": "Italy", "wikidata_id": "Q8598", "wikidata_description": "Italian comune", "wikipedia_url": "https://en.wikipedia.org/wiki/Sassuolo", "wikipedia_extract": "Sassuolo (Italian pronunciation: [sasˈswɔːlo]; Modenese: Sasól [saˈsoːl]) is an Italian town, comune, and industrial centre of the Province of Modena in Emilia-Romagna. Standing on the right bank of the river Secchia some 17 kilometres (11 mi) southwest of Modena, the town is best known for being the centre of the Italian tile industry and for being the home town of Serie A side U.S. Sassuolo Calcio. The exact origin of the toponym Sassuolo is unclear. One theory is that it might derive from the abundant deposits of petroleum found in the area. This is because petroleum was anciently known as \"stone oil\" or \"olio di sasso\" in Italian, from which the composite word Sassuolo (sasso + olio) may have been created."}}, {"canonical_name": "arméniens", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "arméniens", "book_id": "relation_historique_humboldt_vol3_1825", "name": "arméniens", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["arméniens"], "contexts": ["Armenians", "military operations"]}, {"entity_id": "iranians", "book_id": "kosmos_humboldt_1845", "name": "Iranians", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Iranians"], "contexts": ["people related to ancient Persia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "arméniens", "target_book": "kosmos_humboldt_1845", "target_name": "Iranians", "similarity": 0.86}], "id": 1568, "stable_key": "clu_6df0030e2a0addee", "ground_truth": {"modern_name": "Armenians", "confidence": "high", "type": "concept", "note": "The parallel mention of 'Iranians' strongly suggests the ethnic/geographic group.", "wikidata_id": "Q536018", "wikidata_description": "sports traditions in Armenia", "wikipedia_extract": "Armenians (Armenian: հայեր, romanized: hayer, [hɑˈjɛɾ]) are an ethnic group indigenous to the Armenian highlands of West Asia. Armenians constitute the main demographic group in Armenia and constituted the main population of the breakaway Republic of Artsakh until their subsequent flight due to the 2023 Azerbaijani offensive. There is a large diaspora of around five million people of Armenian ancestry living outside the Republic of Armenia. The largest Armenian populations exist in Russia, the United States, France, Georgia, Iran, Germany, Ukraine, Lebanon, Brazil, Argentina, Syria, and Turkey. The present-day Armenian diaspora was formed mainly as a result of the Armenian genocide with the exceptions of Iran, former Soviet states, and parts of the Levant. Armenian is an Indo-European language."}}, {"canonical_name": "Obdorsk", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "obdorsk", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Obdorsk", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Obdorsk"], "contexts": ["location near mouth of Ob river", "city near the mouths of the Oby river"]}, {"entity_id": "obdorsk", "book_id": "kosmos_humboldt_1845", "name": "Obdorsk", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Obdorsk"], "contexts": ["location on the Oby river"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Obdorsk", "target_book": "kosmos_humboldt_1845", "target_name": "Obdorsk", "similarity": 1.0}], "id": 1569, "stable_key": "clu_d919ace080fd23f9", "ground_truth": {"modern_name": "Obdorsk", "confidence": "high", "type": "place", "country": "Russia", "note": "Obdorsk is a historical name for the city now known as Salekhard, located at the mouth of the Ob river.", "wikidata_id": "Q117070340", "wikidata_description": "fishing vessel built in 1959", "wikipedia_extract": "Salekhard (Russian: Салеха́рд [səlʲɪˈxart]; Khanty: Пуӆңават, Pułñawat; Nenets: Саляʼ харад, Saljaꜧ harad, formerly Obdorsk) is a town and the administrative centre of Yamalo-Nenets Autonomous Okrug, Russia. The town lies on the Arctic Circle, with the town centre being about 1 kilometer (0.62 mi) south and suburbs stretching to the north of the circle. The population is 47,910 (2021 census). The settlement of Obdorsk (Обдорск) was founded in 1595, in the place of a Khanty settlement called Polnovat-Vozh (Полноват-вож), by Russian settlers after the conquest of Siberia. It was situated on the Ob River, and its name supposedly derives from that. The land around Obdorsk was referred to as Obdorsky krai, or Obdoriya."}}, {"canonical_name": "Luneburg", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "luneburg", "book_id": "kosmos_humboldt_1845", "name": "Luneburg", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Luneburg"], "contexts": ["probable birthplace of Varenius", "birthplace of the geographer"]}, {"entity_id": "lunebourg", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Lunebourg", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Lunebourg"], "contexts": ["duchy of Lunebourg"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Luneburg", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Lunebourg", "similarity": 0.872}], "id": 1570, "stable_key": "clu_492cd434584ec3a8", "ground_truth": {"modern_name": "Lüneburg", "confidence": "high", "type": "place", "country": "Germany", "note": "Likely referring to the historical Duchy of Lüneburg, which contained the town.", "wikipedia_extract": "Lüneburg, officially the Hanseatic City of Lüneburg and also known in English as Lunenburg, is a town in the German state of Lower Saxony. It is located about 50 km (31 mi) southeast of another Hanseatic city, Hamburg, and belongs to that city's wider metropolitan region. The capital of the district which bears its name, it is home to roughly 77,000 people. Lüneburg's urban area, which includes the surrounding communities of Adendorf, Bardowick, Barendorf and Reppenstedt, has a population of around 103,000. Lüneburg has been allowed to use the title Hansestadt ('Hanseatic Town') in its name since 2007, in recognition of its membership in the former Hanseatic League. Lüneburg is also home to Leuphana University."}}, {"canonical_name": "Jeniseisk", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "jeniseisk", "book_id": "kosmos_humboldt_1845", "name": "Jeniseisk", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Jeniseisk"], "contexts": ["government in Siberia", "government containing district of Agram"]}, {"entity_id": "jeniseisk", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Jeniseisk", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Jeniseisk"], "contexts": ["city in Siberia"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Jeniseisk", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Jeniseisk", "similarity": 0.824}], "id": 1571, "stable_key": "clu_60cd01e72dab1c70", "ground_truth": {"modern_name": "Yeniseysk", "confidence": "high", "type": "place", "country": "Russia", "note": "Both 'government' (guberniya) and 'city' refer to the administrative and urban center in Siberia.", "wikidata_id": "Q135686", "wikidata_description": "town in Yeniseysk Urban Okrug, Krasnoyarsk Krai, Russia", "wikipedia_extract": "Yeniseysk (Russian: Енисейск, IPA: [jɪnʲɪˈsʲejsk]) is a town in Krasnoyarsk Krai, Russia, located on the Yenisei River. Population: 18,766 (2010 census); 20,394 (2002 census); 22,891 (1989 Soviet census); 20,000 (1970). Yeniseysk was founded in 1619 as a stockaded town—the first town on the Yenisei River. It played an important role in Russian colonization of East Siberia in the 17th–18th centuries. Its location is due to the Siberian River Routes from the Urals, up the Ob, up the Ket River and over a portage to Yeniseysk and from there to the Yenisei basin. It became less important due to road and rail building further south."}}, {"canonical_name": "Abel Rémusat", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "abel_rémusat", "book_id": "kosmos_humboldt_1845", "name": "Abel Rémusat", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Abel Rémusat"], "contexts": ["translator and scholar of Chinese", "author of scientific text"]}, {"entity_id": "mm__abel_remusat", "book_id": "relation_historique_humboldt_vol3_1825", "name": "MM. Abel Remusat", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["MM. Abel Remusat"], "contexts": ["savante researcher of languages"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Abel Rémusat", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "MM. Abel Remusat", "similarity": 0.917}], "id": 1572, "stable_key": "clu_03c0835810d3581d", "ground_truth": {"modern_name": "Abel Rémusat", "confidence": "high", "type": "person", "birth_year": 1788, "death_year": 1832, "description": "French sinologist, orientalist, and linguist.", "wikidata_id": "Q716743", "wikidata_description": "French sinologist (1788-1832)", "wikipedia_url": "https://en.wikipedia.org/wiki/Jean-Pierre%20Abel-R%C3%A9musat", "wikipedia_extract": "Jean-Pierre Abel-Rémusat (French pronunciation: [ʒɑ̃ pjɛʁ abɛl ʁemyza]; 5 September 1788 – 2 June 1832) was a French sinologist best known as the first Chair of Sinology at the Collège de France. Rémusat studied medicine as a young man, but his discovery of a Chinese herbal treatise enamored him with the Chinese language, and he spent five years teaching himself to read it. After publishing several well-received articles on Chinese topics, a chair in Chinese was created at the Collège de France in 1814 and Rémusat was placed in it. Rémusat was born in Paris on 5 September 1788 and was educated for the medical profession, earning a doctorate in medicine in 1813. While studying medicine, Rémusat discovered a Chinese herbal treatise in the collection of the Abbé Tersan and was immediately fascinated by it. He taught himself to read it by tirelessly studying the traditional Chinese dictionary Zhengzitong."}}, {"canonical_name": "Carguairazo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "carguairazo", "book_id": "kosmos_humboldt_1845", "name": "Carguairazo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Carguairazo"], "contexts": ["mountain that fell in", "location of volcanic mud eruptions"]}, {"entity_id": "carguairazo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Carguairazo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Carguairazo"], "contexts": ["volcano in Ecuador"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Carguairazo", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Carguairazo", "similarity": 1.0}], "id": 1573, "stable_key": "clu_10214cb2dcfb0fb3", "ground_truth": {"modern_name": "Carguaírazo", "confidence": "high", "type": "place", "country": "Ecuador"}}, {"canonical_name": "Aguas Calientes de las Trincheras", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "aguas_calientes_de_las_trincheras", "book_id": "kosmos_humboldt_1845", "name": "Aguas Calientes de las Trincheras", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Aguas Calientes de las Trincheras"], "contexts": ["hot springs location in South America", "location of hot springs"]}, {"entity_id": "aguascalientes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Aguascalientes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Aguascalientes"], "contexts": ["geographical location"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Aguas Calientes de las Trincheras", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Aguascalientes", "similarity": 0.84}], "id": 1574, "stable_key": "clu_01bca9c9e0e4bf40", "ground_truth": {"modern_name": "Aguas Calientes de las Trincheras", "confidence": "high", "type": "place", "country": "Venezuela", "note": "The text 'Aguascalientes' in relation_historique_humboldt_vol3_1825 could refer to this location or another place named Aguascalientes. Given the context of 'hot springs', the Trincheras location is more likely.", "wikipedia_extract": "There are hot springs on all continents and in many countries around the world. Countries that are renowned for their hot springs include Bulgaria,  Canada, Chile, Fiji, Honduras, Hungary, Iceland,  India, Japan, Romania, Turkey, Taiwan, New Zealand, and the United States, but there are interesting and unique hot springs in many other places as well. Hammam Essalihine (Thermes de Flavius), 35.4403°N 7.0844°E Kambo, North Kivu, in North Kivu province (150 to 270 °C) Uvira, South Kivu province (275 to 369 °C), 3°22′12″S 29°08′24″E There are thirteen developed and undeveloped hot spring pools in Eswatini. All are sulphur springs with temperatures ranging from 26 °C to 52 °C. Dallol Hot Springs at Dallol volcano, Afar Region, Ethiopia Sodere (Oromo: Sodaree), a spa town in central Ethiopia Nyakabuye Hot Springs, near Cyangugu Brandvlei, Worcester area, Western Cape Goudini Spa, Worcester area, Western Cape At least 15 geothermal areas exist in Tanzania.", "wikipedia_url": "https://en.wikipedia.org/wiki/List_of_hot_springs"}}, {"canonical_name": "London clay", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "london_clay", "book_id": "kosmos_humboldt_1845", "name": "London clay", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["London clay"], "contexts": ["geological deposit containing fossil fishes", "geological formation"]}, {"entity_id": "argile_de_londres", "book_id": "relation_historique_humboldt_vol3_1825", "name": "argile de Londres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["argile de Londres"], "contexts": ["London clay"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "London clay", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "argile de Londres", "similarity": 0.902}], "id": 1575, "stable_key": "clu_4897373d0355258a", "ground_truth": {"modern_name": "London Clay", "confidence": "high", "type": "mineral", "wikidata_id": "Q59637656", "wikidata_description": "scholarly article by David Atkinson published in June 1969", "wikipedia_extract": "The London Clay Formation is a marine geological formation of Ypresian (early Eocene Epoch, c. 54-50 million years ago) age which crops out in the southeast of England. The London Clay is well known for its fossil content. The fossils from the lower Eocene rocks indicate a moderately warm climate, the tropical or subtropical flora. Though sea levels changed during the deposition of the clay, the habitat was generally a lush forest – perhaps like in Indonesia or East Africa today – bordering a warm, shallow ocean. The London Clay is a stiff bluish clay which becomes brown when weathered and oxidized. Nodular lumps of pyrite are frequently found in the clay layers."}}, {"canonical_name": "Manheim", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "manheim", "book_id": "kosmos_humboldt_1845", "name": "Manheim", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Manheim"], "contexts": ["location of observation", "city in Germany"]}, {"entity_id": "manheim", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Manheim", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Manheim"], "contexts": ["city of meteorological society"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Manheim", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Manheim", "similarity": 1.0}], "id": 1576, "stable_key": "clu_fbe379204c79f36b", "ground_truth": {"modern_name": "Mannheim", "confidence": "high", "type": "place", "country": "Germany", "wikidata_id": "Q2119", "wikidata_description": "city in Baden-Württemberg, Germany", "wikipedia_url": "https://en.wikipedia.org/wiki/Mannheim", "wikipedia_extract": "Mannheim (German pronunciation: [ˈmanhaɪm] ; Palatine German: Mannem or Monnem), officially the University City of Mannheim (German: Universitätsstadt Mannheim), is the second-largest city in Baden-Württemberg after Stuttgart, the state capital, and Germany's 21st-largest city, with a population of over 315,000. It is located at the border with Rhineland-Palatinate. The city is the cultural and economic centre of the Rhine-Neckar, Germany's seventh-largest metropolitan region, with nearly 2.4 million inhabitants. Mannheim is located at the confluence of the Upper Rhine and the Neckar in the Kurpfalz (Electoral Palatinate) region of northwestern Baden-Württemberg. The city lies in the Upper Rhine Plain, Germany's warmest region, between the Palatine Forest and the Oden Forest. Mannheim forms a continuous urban zone of around 500,000 inhabitants with Ludwigshafen am Rhein in the Rhineland-Palatinate, while some northern suburbs lie in Hesse; Hamburg is the only other German city with a presence in two states other than its own."}}, {"canonical_name": "Girgenti", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "girgenti", "book_id": "kosmos_humboldt_1845", "name": "Girgenti", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Girgenti"], "contexts": ["location of mud volcanoes", "location in Sicily"]}, {"entity_id": "girgenti", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Girgenti", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Girgenti"], "contexts": ["near Macaluba mud volcano"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Girgenti", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Girgenti", "similarity": 0.865}], "id": 1577, "stable_key": "clu_f75a608771c88747", "ground_truth": {"modern_name": "Agrigento", "confidence": "high", "type": "place", "country": "Italy", "note": "Girgenti is the historical Italian name for Agrigento.", "wikipedia_extract": "Agrigento (Italian: [aɡriˈdʒɛnto] ; Sicilian: Girgenti [dʒɪɾˈdʒɛndɪ] or Giurgenti [dʒʊɾˈdʒɛndɪ]) is a city on the southern coast of the autonomous island region of Sicily in Italy, capital of the province of Agrigento. As of 2025, with a population of 55,227, it is also the largest city in the province, 10th-largest in Sicily and 115th-largest in Italy. Founded around 582 BC by Greek colonists from Gela, Agrigento, then known as Akragas, was one of the leading cities during the golden age of Ancient Greece. The city flourished under Theron's leadership in the 5th century BC, marked by ambitious public works and the construction of renowned temples. Despite periods of dormancy during the Punic Wars, Agrigento emerged as one of Sicily's largest cities in the Republican era. During the Principate, Agrigento's strategic port and diverse economic ventures, including sulfur mining, trade and agriculture, sustained its importance throughout the high and late Empire."}}, {"canonical_name": "Baku", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "baku", "book_id": "kosmos_humboldt_1845", "name": "Baku", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Baku"], "contexts": ["city east of Abscheron", "location near Caspian Sea with sea level marks"]}, {"entity_id": "bakou", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bakou", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bakou"], "contexts": ["location of salses"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Baku", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Bakou", "similarity": 0.88}], "id": 1578, "stable_key": "clu_fda927c6e2b3e1da", "ground_truth": {"modern_name": "Baku", "confidence": "high", "type": "place", "country": "Azerbaijan", "wikidata_id": "Q68078772", "wikidata_description": "sports club", "wikipedia_extract": "Baku (US: , UK: ; Azerbaijani: Bakı [bɑˈcɯ] ) is the capital and largest city of Azerbaijan, as well as the largest city on the Caspian Sea and in the Caucasus region. Baku is 28 metres (92 ft) below sea level, which makes it the lowest lying national capital in the world and also the largest city in the world below sea level. Baku lies on the southern shore of the Absheron Peninsula, on the Bay of Baku. Baku's urban population was estimated at two million people as of 2009. Baku is the primate city of Azerbaijan—it is the sole metropolis in the country, and about 25% of all inhabitants of the country live in Baku's metropolitan area. Baku is divided into twelve administrative raions and 48 townships."}}, {"canonical_name": "Magdeburg", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "magdeburg", "book_id": "kosmos_humboldt_1845", "name": "Magdeburg", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Magdeburg"], "contexts": ["city where Leibnitz wrote a letter", "city where Leibnitz's letter was sent"]}, {"entity_id": "magdebourg", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Magdebourg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Magdebourg"], "contexts": ["location of observation"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Magdeburg", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Magdebourg", "similarity": 0.978}], "id": 1579, "stable_key": "clu_de5a51ab5763d092", "ground_truth": {"modern_name": "Magdeburg", "confidence": "high", "type": "place", "country": "Germany", "wikidata_id": "Q1733", "wikidata_description": "capital city of the German state of Saxony-Anhalt", "wikipedia_extract": "Magdeburg (  MAG-də-burg, German: [ˈmakdəbʊʁk] , locally [ˈmaχdəbʊɐ̯ç]; Low Saxon: Meideborg [ˈmaˑɪ̯debɔɐ̯x]) is the capital of the German state of Saxony-Anhalt. The city is on the Elbe river. Otto I, the Holy Roman Emperor and the founder of the Archbishopric of Magdeburg, was buried in the city's cathedral after his death. Magdeburg's version of German town law, known as Magdeburg rights, spread throughout Central and Eastern Europe. In the Late Middle Ages, Magdeburg was one of the largest and most prosperous German cities and a notable member of the Hanseatic League. One of the most notable people from the city was Otto von Guericke, famous for his experiments with the Magdeburg hemispheres.", "wikipedia_url": "https://en.wikipedia.org/wiki/Magdeburg"}}, {"canonical_name": "Dresden", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "dresden", "book_id": "kosmos_humboldt_1845", "name": "Dresden", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Dresden"], "contexts": ["city in Germany", "city with a certain temperature"]}, {"entity_id": "dresde", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Dresde", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Dresde"], "contexts": ["city where an observation was made"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Dresden", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Dresde", "similarity": 0.908}], "id": 1580, "stable_key": "clu_9c9c7b5c0bee3e0b", "ground_truth": {"modern_name": "Dresden", "confidence": "high", "type": "place", "country": "Germany", "wikidata_id": "Q1731", "wikidata_description": "capital city of the Free State of Saxony in Germany", "wikipedia_url": "https://en.wikipedia.org/wiki/Dresden", "wikipedia_extract": "Dresden (; German: [ˈdʁeːsdn̩] ; Upper Saxon: Dräsdn; Upper Sorbian: Drježdźany, pronounced [ˈdʁʲɛʒdʒanɨ]) is the capital city of the German state of Saxony and its second most populous city after Leipzig. It is the 12th most populous city of Germany, the fourth largest by area (after Berlin, Hamburg, and Cologne), and the third-most populous city in the area of former East Germany, after Berlin and Leipzig. Dresden's urban area comprises the towns of Freital, Pirna, Radebeul, Meissen, Coswig, Radeberg, and Heidenau and has around 790,000 inhabitants. The Dresden metropolitan area has over 1.3 million inhabitants. Dresden is the second largest city on the River Elbe after Hamburg. Most of the city's population lives in the Elbe Valley, but a large, albeit very sparsely populated, area of the city east of the Elbe lies in the West Lusatian Hill Country and Uplands (the westernmost part of the Sudetes) and thus in Lusatia."}}, {"canonical_name": "craters of elevation", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "craters_of_elevation", "book_id": "kosmos_humboldt_1845", "name": "craters of elevation", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["craters of elevation", "Craters of elevation"], "contexts": ["geological formations"]}, {"entity_id": "cratère", "book_id": "relation_historique_humboldt_vol3_1825", "name": "cratère", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["cratère"], "contexts": ["opening of a volcano"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "craters of elevation", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "cratère", "similarity": 0.884}], "id": 1581, "stable_key": "clu_b316674e21dc6f4b", "ground_truth": {"modern_name": "Volcanic Craters", "confidence": "high", "type": "concept", "note": "The term 'craters of elevation' might refer to a specific geological theory by Humboldt, but the general concept points to volcanic openings.", "wikidata_id": "Q57869554", "wikidata_description": "scholarly article by Károly Németh & Shane J. Cronin published 2008 in Geological Society Special Publication", "wikipedia_extract": "The Mono–Inyo Craters are a volcanic chain of craters, domes and lava flows in Mono County, Eastern California, United States. The chain stretches 25 miles (40 km) from the northwest shore of Mono Lake to the south of Mammoth Mountain. The Mono Lake Volcanic Field forms the northernmost part of the chain and consists of two volcanic islands in the lake and one cinder cone volcano on its northwest shore. Most of the Mono Craters, which make up the bulk of the northern part of the Mono–Inyo chain, are phreatic (steam explosion) volcanoes that have since been either plugged or over-topped by rhyolite domes and lava flows. The Inyo volcanic chain form much of the southern part of the chain and consist of phreatic explosion pits, and rhyolitic lava flows and domes. The southernmost part of the chain consists of fumaroles and explosion pits on Mammoth Mountain and a set of cinder cones south of the mountain; the latter are called the Red Cones.", "wikipedia_url": "https://en.wikipedia.org/wiki/Mono–Inyo_Craters"}}, {"canonical_name": "Alcornoque", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "alcornoque", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Alcornoque", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["Alcornoque", "Alcornoco"], "contexts": ["cork tree, name given to Malpighia", "common name for a tree"]}, {"entity_id": "alcornoque", "book_id": "historia_medicinal_monardes_1574", "name": "Alcornoque", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Alcornoque"], "contexts": ["tree with thick bark"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Alcornoque", "target_book": "historia_medicinal_monardes_1574", "target_name": "Alcornoque", "similarity": 1.0}], "id": 1582, "stable_key": "clu_074d5c4831717c8b", "ground_truth": {"modern_name": "Cork Oak", "confidence": "high", "type": "plant", "linnaean": "Quercus suber Linnaeus", "family": "Fagaceae", "note": "While 'Alcornoque' can refer to other plants, in historical texts about medicinal plants and trees with thick bark, it most commonly refers to the cork oak.", "wikidata_id": "Q156137", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Quercus%20suber", "wikipedia_extract": "Quercus suber, commonly called the cork oak,  is a medium-sized, evergreen oak tree in the section Quercus sect. Cerris. It is the primary source of cork for wine bottle stoppers and other uses, such as cork flooring and as the cores of cricket balls. It is native to southwest Europe and northwest Africa. In the Mediterranean basin the tree is an ancient species with fossil remnants dating back to the Tertiary period. It can survive for as long as two centuries."}}, {"canonical_name": "San Francisco", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "san_francisco", "book_id": "relation_historique_humboldt_vol3_1825", "name": "San Francisco", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["San Francisco", "San Francisco de la Nouvelle-Californie"], "contexts": ["location north of San Francisco", "city defining equatorial parallel"]}, {"entity_id": "sane_francisco", "book_id": "historia_medicinal_monardes_1574", "name": "Sane Francisco", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Sane Francisco"], "contexts": ["monastery in a city"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "San Francisco", "target_book": "historia_medicinal_monardes_1574", "target_name": "Sane Francisco", "similarity": 0.868}], "id": 1583, "stable_key": "clu_903d87cb9b515201", "ground_truth": {"wikipedia_extract": "San Francisco, officially the City and County of San Francisco, is a commercial, financial, and cultural center of Northern California. With an estimated population of 827,526 residents as of 2024, San Francisco proper is the fourth-most populous city in the U.S. state of California and the 17th-most populous in the United States. Among U.S. cities proper with over 300,000 residents, San Francisco is ranked second by population density, first by per capita income, and sixth by aggregate income as of 2023. 4.6 million residents live in the city's metropolitan statistical area, the 13th-largest in the United States.  9.2 million live in the broader combined statistical area, the fifth-largest in the nation. Prior to European settlement, the modern city proper was inhabited by the Yelamu Ohlone. On June 29, 1776, settlers from New Spain established the Presidio of San Francisco at the Golden Gate, and the Mission San Francisco de Asís a few miles away, both named for Francis of Assisi. The California gold rush of 1849 brought rapid growth, making it the largest city on the West Coast at the time."}}, {"canonical_name": "trésor", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "trésor", "book_id": "relation_historique_humboldt_vol3_1825", "name": "trésor", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["trésor", "trésor royal"], "contexts": ["financial reserve", "royal treasury"]}, {"entity_id": "tesoro", "book_id": "historia_medicinal_monardes_1574", "name": "tesoro", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["tesoro"], "contexts": ["treasure, likely precious metals and jewels"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "trésor", "target_book": "historia_medicinal_monardes_1574", "target_name": "tesoro", "similarity": 0.942}], "id": 1584, "stable_key": "clu_114d88108f3a90fd", "ground_truth": {"modern_name": "Treasury", "confidence": "high", "type": "concept", "note": "This refers to a financial reserve or accumulated wealth, not a specific chemical substance.", "wikidata_id": "Q10756188", "wikidata_description": "department of an organisation related to finance", "wikipedia_url": "https://en.wikipedia.org/wiki/Treasury", "wikipedia_extract": "a government department related to finance and taxation, a finance ministry; in a business context, corporate treasury a place or location where treasure, such as currency or precious items are kept. These can be  state or royal property, church treasure or in private ownership. The head of a treasury is typically known as a treasurer. This position may not necessarily have the final control over the actions of the treasury, particularly if they are not an elected representative. The adjective for a treasury is normally \"treasurial\". The adjective \"tresorial\" can also be used, but this normally means pertaining to a treasurer."}}, {"canonical_name": "Curiana", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "curiana", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Curiana", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Curiana"], "contexts": ["place name in South America", "location near Cauchieto"]}, {"entity_id": "cúriel", "book_id": "historia_medicinal_monardes_1574", "name": "Cúriel", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cúriel"], "contexts": ["town belonging to the noblewoman"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Curiana", "target_book": "historia_medicinal_monardes_1574", "target_name": "Cúriel", "similarity": 0.863}], "id": 1585, "stable_key": "clu_40c6a71d293bf7ef", "ground_truth": {"modern_name": "Curiana", "confidence": "medium", "type": "place", "country": "Venezuela", "note": "The reference to 'Cúriel' in Monardes' text and 'Curiana' in Humboldt suggests a place name in South America, likely historical.", "wikipedia_extract": "María Luisa González Gragirena de Escobar (née María Luisa González Gragirena; known artistically by her married name María Luisa Escobar; also credited as Maritza Graxirena; 5 December 1903 – 14 May 1985) was a Venezuelan musicologist, pianist, composer, and caricaturist. She founded the Caracas Athenaeum in 1931. She also served as President of the Venezuelan Red Cross (Valencia, 1921; Caracas, 1922–23). María Luisa González Gragirena was born in Valencia in 5 December 1903, the daughter of Henrique A. González and Maria Gragirena y Mijarez de González. At the age of five, she entered the Colegio de Lourdes where she began to study piano.", "wikipedia_url": "https://en.wikipedia.org/wiki/María_Luisa_Escobar"}}, {"canonical_name": "gryphées", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "gryphées", "book_id": "relation_historique_humboldt_vol3_1825", "name": "gryphées", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["gryphées"], "contexts": ["fossil oyster genus", "found in limestone rich in lead"]}, {"entity_id": "griphos", "book_id": "historia_medicinal_monardes_1574", "name": "Griphos", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Griphos"], "contexts": ["creatures brought from the Indies"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "gryphées", "target_book": "historia_medicinal_monardes_1574", "target_name": "Griphos", "similarity": 0.919}], "id": 1586, "stable_key": "clu_1bce91391c686a3b", "ground_truth": {"modern_name": "Gryphaea (Fossil Oysters)", "confidence": "high", "type": "animal", "note": "Refers to fossil oysters, often found as fossils in geological contexts. 'Griphos' in Monardes is likely a variant spelling or confusion.", "wikipedia_extract": "The Gryphaeidae, common name the foam oysters or honeycomb oysters, are a family of marine bivalve mollusks. This family of bivalves is very well represented in the fossil record, however the number of living species is very few. All species have shells cemented to a substrate. Shells are considered brittle, inequivalve, with the left, lower (cemented) valve convex and the right (upper, non-cemented) valve flat or slightly concave. Genera and species within this family are divided into three subfamilies, Exogyrinae, Gryphaeinae and Pycnodonteinae. Both Exogyrinae and Gryphaeinae are completely extinct.", "wikipedia_url": "https://en.wikipedia.org/wiki/Gryphaeidae"}}, {"canonical_name": "Souabe", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "souabe", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Souabe", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Souabe"], "contexts": ["region with plateaus", "region in Germany"]}, {"entity_id": "sabéa", "book_id": "coloquios_da_orta_1563", "name": "Sabéa", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Sabéa"], "contexts": ["port where spice arrived"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Souabe", "target_book": "coloquios_da_orta_1563", "target_name": "Sabéa", "similarity": 0.843}], "id": 1587, "stable_key": "clu_bf4d9cd9868196fa", "ground_truth": {"modern_name": "Swabia", "confidence": "high", "type": "place", "country": "Germany", "note": "The spelling variations and contexts point to the historical region of Swabia in Germany and a possible port associated with the spice trade.", "wikidata_id": "Q11812551", "wikidata_description": "cultural, historic and linguistic region of Germany", "wikipedia_extract": "Swabia is a cultural, historical and linguistic region in southwestern Germany. The name is ultimately derived from the medieval Duchy of Swabia, one of the German stem duchies, representing the historic settlement area of the  Germanic tribe alliances named Alemanni and Suebi. This territory would include all of the Alemannic German area, but the modern concept of Swabia is more restricted, due to the collapse of the duchy of Swabia in the thirteenth century. Swabia as understood in modern ethnography roughly coincides with the Swabian Circle of the Holy Roman Empire as it stood during the early modern period, now divided between the states of Bavaria and Baden-Württemberg. Swabians (Schwaben, singular Schwabe) are the natives of Swabia and speakers of Swabian German. Their number was estimated at close to 800,000 by SIL Ethnologue as of 2006, out of a total population of 7.5 million in the regions of Tübingen, Stuttgart and Bavarian Swabia.", "wikipedia_url": "https://en.wikipedia.org/wiki/Swabia"}}, {"canonical_name": "Hayhay", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "hayhay", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Hayhay", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Hayhay", "Hayliay"], "contexts": ["nom ancien d'Ayay", "island name in Caribe language"]}, {"entity_id": "haify", "book_id": "coloquios_da_orta_1563", "name": "Haify", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Haify"], "contexts": ["place associated with Telesio"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hayhay", "target_book": "coloquios_da_orta_1563", "target_name": "Haify", "similarity": 0.85}], "id": 1588, "stable_key": "clu_f7e168ab1b6dff57", "ground_truth": {"modern_name": "Ayay", "confidence": "medium", "type": "place", "country": "Brazil", "note": "The spelling variations and association with Telesio in one context suggest a place name, likely historical, in South America. The modern name 'Ayay' is a tentative identification based on historical maps and gazetteers."}}, {"canonical_name": "l'AJmirante", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "l'ajmirante", "book_id": "relation_historique_humboldt_vol3_1825", "name": "l'AJmirante", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["l'AJmirante", "Almirante"], "contexts": ["plantation location", "location within Cuba"]}, {"entity_id": "as_do_almirante", "book_id": "coloquios_da_orta_1563", "name": "as do Almirante", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["as do Almirante"], "contexts": ["islands northeast of Madagascar"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "l'AJmirante", "target_book": "coloquios_da_orta_1563", "target_name": "as do Almirante", "similarity": 0.907}], "id": 1589, "stable_key": "clu_b15a340a0f2ea725", "ground_truth": {"modern_name": "Almirante", "confidence": "high", "type": "place", "country": "Madagascar", "note": "The text mentions 'islands northeast of Madagascar'. 'Almirante' likely refers to a specific island or group of islands in that region.", "wikipedia_extract": "Almirante Sur is a barrio in the municipality of Vega Baja, Puerto Rico. Its population in 2010 was 3,115. Almirante Sur was in Spain's gazetteers until Puerto Rico was ceded by Spain in the aftermath of the Spanish–American War under the terms of the Treaty of Paris of 1898 and became an unincorporated territory of the United States. In 1899, the United States Department of War conducted a census of Puerto Rico finding that the population of Almirante Sur barrio was 847.", "wikipedia_url": "https://en.wikipedia.org/wiki/Almirante_Sur"}}, {"canonical_name": "La Vega", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "la_vega", "book_id": "relation_historique_humboldt_vol3_1825", "name": "La Vega", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["La Vega"], "contexts": ["location within Caracas", "place name in Venezuela"]}, {"entity_id": "vega", "book_id": "coloquios_da_orta_1563", "name": "Vega", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Vega"], "contexts": ["city with convent of S. Francisco"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "La Vega", "target_book": "coloquios_da_orta_1563", "target_name": "Vega", "similarity": 0.894}], "id": 1590, "stable_key": "clu_c2c57f505c6d23d1", "ground_truth": {"modern_name": "La Vega", "confidence": "high", "type": "place", "country": "Venezuela", "note": "Context of 'location within Caracas' and 'city with convent of S. Francisco' points to a specific settlement in Venezuela."}}, {"canonical_name": "Mura", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mura", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mura", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Mura"], "contexts": ["location", "rapids caused by mountains"]}, {"entity_id": "murano", "book_id": "coloquios_da_orta_1563", "name": "Murano", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Murano"], "contexts": ["location outside Venice"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mura", "target_book": "coloquios_da_orta_1563", "target_name": "Murano", "similarity": 0.898}], "id": 1591, "stable_key": "clu_e5b651b065b8c676", "ground_truth": {"modern_name": "Murano", "confidence": "high", "type": "place", "country": "Italy", "note": "The context 'location outside Venice' strongly suggests Murano, a famous island within the Venetian lagoon.", "wikidata_id": "Q48980759", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Murano%20%28surname%29", "wikipedia_extract": "Murano is a series of islands linked by bridges in the Venetian Lagoon, northern Italy. It lies about 1.5 km (1 mi) north of Venice and measures about 1.5 km (1 mi) across with a population of just over 5,000 (2004 figures). It is famous for its glass making. It was once an independent comune, but is now a frazione of the comune of Venice. Murano was initially settled by the Romans and from the sixth century by people from Altinum and Oderzo. At first, the island prospered as a fishing port and through its production of salt."}}, {"canonical_name": "Havann", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "havann", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Havann", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Havann"], "contexts": ["governorate in Cuba", "Government of Havana"]}, {"entity_id": "hanoviae", "book_id": "coloquios_da_orta_1563", "name": "Hanoviae", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Hanoviae"], "contexts": ["publication location of Gemmarum et lapidarum historia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Havann", "target_book": "coloquios_da_orta_1563", "target_name": "Hanoviae", "similarity": 0.846}], "id": 1592, "stable_key": "clu_04757644905690ab", "ground_truth": {"modern_name": "Havana", "confidence": "high", "type": "place", "country": "Cuba", "note": "'Governorate in Cuba' is a clear descriptor for Havana. 'Hanoviae' is a Latinized form.", "wikidata_id": "Q1563", "wikidata_description": "capital and largest city of Cuba", "wikipedia_url": "https://en.wikipedia.org/wiki/Havana", "wikipedia_extract": "Havana (, US also ; Spanish: La Habana [la‿aˈβana] ) is the capital and largest city of Cuba. The heart of La Habana Province, Havana is the country's main port and commercial center. It is the most populous city, the largest by area, and the second-largest metropolitan area in the Caribbean region. The population in 2021 was 2,142,939 inhabitants, and its area is 728.26 km2 (281.18 sq mi) for the capital city and 8,475.57 km2 for the metropolitan zone. Its official population was 1,749,964 inhabitants in 2024. Founded in 1519 on its current location on Havana Bay under initiative of the Spanish Empire, it had already taken an edge over Santiago by the mid 16th century due to the geo-strategic advantages of its harbor, becoming the capital of the island in 1552."}}, {"canonical_name": "Décadas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "décadas", "book_id": "coloquios_da_orta_1563", "name": "Décadas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Décadas"], "contexts": ["work by JoSo de Barros", "work by Diogo do Couto"]}, {"entity_id": "décade_ég^'pt_", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Décade ég^'pt.", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Décade ég^'pt."], "contexts": ["publication title"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Décadas", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Décade ég^'pt.", "similarity": 0.92}], "id": 1593, "stable_key": "clu_3b37305a1323085b", "ground_truth": {"modern_name": "Décadas", "confidence": "high", "type": "text", "note": "Refers to 'Décadas' by JoSo de Barros, a significant historical and geographical work."}}, {"canonical_name": "kala", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "kala", "book_id": "coloquios_da_orta_1563", "name": "kala", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["kala", "kayla"], "contexts": ["Indian name for banana"]}, {"entity_id": "kelte", "book_id": "relation_historique_humboldt_vol3_1825", "name": "kelte", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["kelte"], "contexts": ["language family"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "kala", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "kelte", "similarity": 0.848}], "id": 1594, "stable_key": "clu_3be7e4e7ea272135", "ground_truth": {"modern_name": "banana", "confidence": "medium", "type": "plant", "linnaean": "Musa acuminata", "family": "Musaceae", "note": "The context 'Indian name for banana' is strong. 'Kala' is a possible indigenous name. 'Kelte' in the other text seems like a transcription error or unrelated.", "wikidata_id": "Q503", "wikidata_description": "elongated, edible fruit produced by several kinds of large herbaceous flowering plants in the genus Musa", "wikipedia_extract": "Musa acuminata is a species of banana native to Southern Asia, its range comprising the Indian subcontinent and Southeast Asia. Many of the modern edible dessert bananas are derived from this species, although some are hybrids with Musa balbisiana. First cultivated by humans around 8000 BCE, it is one of the early examples of domesticated plants. Musa acuminata is classified by botanists as an herbaceous plant and an evergreen and a perennial, but not as a tree. The trunk (known as the pseudostem) is made of tightly packed layers of leaf sheaths emerging from completely or partially buried corms. The leaves are at the top of the leaf sheaths, or petioles and in the subspecies M. a. truncata the blade or lamina is up to 22 feet (6.7 m) in length and 39 inches (0.99 m) wide.", "wikipedia_url": "https://en.wikipedia.org/wiki/Banana"}}, {"canonical_name": "Miniſtros", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "miniſtros", "book_id": "polyanthea_medicinal", "name": "Miniſtros", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Miniſtros", "Miniſtro"], "contexts": ["officials who need to stay awake", "official receiving information"]}, {"entity_id": "mineurs", "book_id": "relation_historique_humboldt_vol3_1825", "name": "mineurs", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["mineurs"], "contexts": ["workers in mines"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Miniſtros", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "mineurs", "similarity": 0.894}], "id": 1595, "stable_key": "clu_3a9263dcc8d0e021", "ground_truth": {"modern_name": "ministers", "confidence": "low", "type": "concept", "note": "The terms 'Miniſtros' (officials) and 'mineurs' (workers in mines) are too divergent and lack specific medical/scientific context to confidently identify a single referent. 'Ministers' is a general guess for the first term.", "wikidata_id": "Q83307", "wikidata_description": "politician who holds significant civil public office in a national or regional government, generally heading a ministry", "wikipedia_extract": "The Union Council of Ministers is the principal executive organ of the Government of India, which serves to aid and advise the President of India in execution of their functions. It is chaired by the Prime Minister of India and consists of the heads of each of the executive government ministries. Currently, the council is headed by Narendra Modi and consists of 71 fellow members. The council is answerable to the Lok Sabha. A smaller executive body called the Union Cabinet is the supreme decision-making body in India; it is a subset of the Union Council of Ministers who hold important portfolios and ministries of the government. Pursuant to Article 75(3), the Council of Ministers is responsible collectively to the lower house of the Indian parliament, called the Lok Sabha (House of the People).", "wikipedia_url": "https://en.wikipedia.org/wiki/Minister_%28government%29"}}, {"canonical_name": "Tanger", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tanger", "book_id": "coloquios_da_orta_1563", "name": "Tanger", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Tanger"], "contexts": ["city in Africa", "city in Morocco"]}, {"entity_id": "tanger", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tanger", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Tanger"], "contexts": ["place where M. de Rieux conceived a plan"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Tanger", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Tanger", "similarity": 1.0}], "id": 1596, "stable_key": "clu_a6491f14986d439f", "ground_truth": {"wikipedia_extract": "Tangier ( tan-JEER; Arabic: طنجة, romanized: Ṭanjah, [tˤandʒa], [tˤanʒa]) is a city in northwestern Morocco, on the coasts of the Mediterranean Sea and the Atlantic Ocean. The city is the capital of the Tangier-Tetouan-Al Hoceima region, as well as the Tangier-Assilah Prefecture of Morocco. Many civilisations and cultures have influenced the history of Tangier, starting from before the 10th century BCE. Originating as a strategic Phoenician town and trading centre, Tangier has been a nexus for many cultures. In 1923, it became an international zone managed by colonial powers and became a destination for many European and American diplomats, spies, bohemians, writers and businessmen. That status came to an end with Moroccan independence, in phases between 1956 and 1960."}}, {"canonical_name": "loutre", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "loutre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "loutre", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["loutre"], "contexts": ["animal whose fur was traded", "animal whose skins wrapped scrolls"]}, {"entity_id": "lontra", "book_id": "ricettario_fiorentino_1597", "name": "lontra", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["lontra"], "contexts": ["otter, an amphibian animal"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "loutre", "target_book": "ricettario_fiorentino_1597", "target_name": "lontra", "similarity": 0.846}], "id": 1597, "stable_key": "clu_baece8a6dd23cfa4", "ground_truth": {"modern_name": "otter", "confidence": "high", "type": "animal", "note": "'Loutre' is French for otter, and 'lontra' is Portuguese/Italian for otter. Both contexts point to the same animal.", "wikidata_id": "Q200184", "wikidata_description": "subfamily of mammals", "wikipedia_extract": "Otters are carnivorous mammals in the subfamily Lutrinae. The 14 extant otter species are all semiaquatic, both freshwater and marine. Lutrinae is a branch of the Mustelidae family, which includes weasels, badgers, mink, and wolverines, among other animals. Otters are distinguished by their long, slim bodies, powerful webbed feet for swimming, and their dense fur, which keeps them warm and buoyant in water. They are playful animals, engaging in activities like sliding into water on natural slides and playing with stones. Otters exhibit a varied life cycle with a gestation period of about 60–86 days, and offspring typically stay with their family for a year.", "wikipedia_url": "https://en.wikipedia.org/wiki/Otter"}}, {"canonical_name": "Merano", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "merano", "book_id": "ricettario_fiorentino_1597", "name": "Merano", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Merano"], "contexts": ["plant used in a preparation", "location mentioned"]}, {"entity_id": "mero", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mero", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Mero"], "contexts": ["a cape on the Araya peninsula"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Merano", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Mero", "similarity": 0.877}], "id": 1598, "stable_key": "clu_ec4258b61cb032f9", "ground_truth": {"wikipedia_extract": "Merano or Meran is a comune (municipality) in South Tyrol, Northern Italy. Generally best known for its spa resorts, it is located within a basin, surrounded by mountains standing up to 3,335 metres (10,942 feet) above sea level, at the entrance to the Passeier Valley and the Vinschgau. The city has been a popular place of residence for several scientists, literary people, and artists, including Franz Kafka, Paul Lazarsfeld and also Empress Elisabeth of Austria, who appreciated its mild climate. Both the Italian (Merano) and the German (Meran) names for the city are used in English. The Ladin form of the name is Maran. The official name of the municipality (comune) is Comune di Merano in Italian and Stadtgemeinde Meran in German (both are in official use)."}}, {"canonical_name": "Salsapariglia", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "salsapariglia", "book_id": "ricettario_fiorentino_1597", "name": "Salsapariglia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Salsapariglia", "SALSAPARIGLIA"], "contexts": ["plant root from western regions", "herb used for decoctions and syrups"]}, {"entity_id": "salsepareille", "book_id": "relation_historique_humboldt_vol3_1825", "name": "salsepareille", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["salsepareille"], "contexts": ["plant species"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Salsapariglia", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "salsepareille", "similarity": 0.929}], "id": 1599, "stable_key": "clu_7b30ab04063acff3", "ground_truth": {"modern_name": "Sarsaparilla", "confidence": "high", "type": "plant", "linnaean": "Smilax ornata", "family": "Smilacaceae", "wikidata_id": "Q1117102", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Smilax%20regelii", "wikipedia_extract": "Smilax ornata is a perennial trailing vine with prickly stems that is native to Mexico and Central America. Common names include sarsaparilla, Honduran sarsaparilla, and Jamaican sarsaparilla. It is known in Spanish as zarzaparrilla, which is derived from the words zarza meaning \"bramble\" (from Basque sartzia \"bramble\"), and parrilla, meaning \"little grape vine\". Smilax ornata is used as the basis for a soft drink known as sarsaparilla. It is also a primary ingredient in old fashioned-style licorice, in conjunction with sassafras, which was more widely available prior to studies of its potential health risks. Smilax ornata was considered by Native Americans to have medicinal properties, and was a popular European treatment for syphilis when it was introduced from the New World."}}, {"canonical_name": "rcaux", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "rcaux", "book_id": "relation_historique_humboldt_vol3_1825", "name": "rcaux", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["rcaux"], "contexts": ["currency unit"]}, {"entity_id": "riccio", "book_id": "ricettario_fiorentino_1597", "name": "riccio", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["riccio"], "contexts": ["sugar candy"]}, {"entity_id": "racqua", "book_id": "ricettario_fiorentino_1597", "name": "racqua", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["racqua"], "contexts": ["water substance"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "rcaux", "target_book": "ricettario_fiorentino_1597", "target_name": "riccio", "similarity": 0.849}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "rcaux", "target_book": "ricettario_fiorentino_1597", "target_name": "racqua", "similarity": 0.858}], "id": 1600, "stable_key": "clu_1ab10c3aee05ba61", "ground_truth": {"modern_name": "Sugar Candy", "confidence": "medium", "type": "chemical", "note": "The members 'rcaux', 'riccio', and 'racqua' are likely misspellings or OCR errors. 'Riccio' in Italian can mean sea urchin, but in a medical context, 'sugar candy' is a more plausible interpretation given the association with 'sugar'. The mention of 'currency unit' is likely a misinterpretation or a highly unusual context for these terms.", "wikidata_id": "Q849816", "wikidata_description": "confection composed of relatively large sugar crystals", "wikipedia_url": "https://en.wikipedia.org/wiki/Rock%20candy", "wikipedia_extract": "Sugar Candy (Czech: Cukrkandl) is a 2025 Czech adventure children's film directed and written by Pavel Jandourek. The film was shot in Luhačovice (the main location was the local villa Kancnýřka), Hodonín, Úštěk, Zubrnice and also in Slovakia. The film takes place during the Austro-Hungarian Empire at the turn of the 19th and 20th centuries and combines elements of a fairy tale and historical drama. The film stars Tereza Ramba, Marek Adamczyk, Jiří Dvořák, Jaroslav Plesl, Pavel Zedníček, Vica Kerekes and Jiří Lábus. The film's world premiere took place on June 1, 2025 at the Zlín Film Festival. The premiere in Czech cinemas took place on October 23, 2025."}}, {"canonical_name": "Faenza", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "faenza", "book_id": "ricettario_fiorentino_1597", "name": "Faenza", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Faenza"], "contexts": ["city name", "location mentioned in the passage"]}, {"entity_id": "faenza", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Faenza", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Faenza"], "contexts": ["location of observation"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Faenza", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Faenza", "similarity": 1.0}], "id": 1601, "stable_key": "clu_ed6649ed123bf759", "ground_truth": {"wikipedia_extract": "Faenza (UK:  fah-ENT-sə, US:  fah-EN-zə, Italian: [faˈɛntsa]; Romagnol: Fènza or Fẽza; Latin: Faventia) is a comune (municipality) with 58,746 inhabitants in the Province of Ravenna in Emilia-Romagna, Italy. The city is historically renowned for its production of artistic ceramics, to the extent that maiolica, due to the fame of local craftsmanship, is known worldwide as faience. Of Roman origin, under the rule of the Manfredi, Faenza entered a period of significant growth that peaked during the Renaissance and Baroque eras, shaping its art and architecture. Due to its vibrant artistic and cultural activity, between the 18th and 19th centuries, it became a prominent center of Neoclassicism in Italy and Europe, with the finest example today being the National Museum of Palazzo Milzetti. Beyond its role as a thriving creative hub, Faenza is currently home to research and development centers focused on materials and environmental sustainability. Located just west of the heart of Romagna, at the foot of the first slopes of the Faenza Apennines, it serves as the administrative seat of the Union of Faenza Romagna and is the episcopal see of the Diocese of Faenza-Modigliana."}}, {"canonical_name": "Maracayho", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "maracayho", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Maracayho", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Maracayho", "Maracaibo"], "contexts": ["province of Maracayho", "province in Zulia"]}, {"entity_id": "maranhao", "book_id": "polyanthea_medicinal", "name": "Maranhao", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Maranhao"], "contexts": ["place where a fish is found"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Maracayho", "target_book": "polyanthea_medicinal", "target_name": "Maranhao", "similarity": 0.848}], "id": 1602, "stable_key": "clu_b5209cdecd5e512d", "ground_truth": {"modern_name": "Maranhão", "confidence": "high", "type": "place", "country": "Brazil", "wikidata_id": "Q42362", "wikidata_description": "state in the Northeast Region of Brazil", "wikipedia_url": "https://en.wikipedia.org/wiki/Maranh%C3%A3o", "wikipedia_extract": "Maranhão (, MAH-rə-NYOWN; Brazilian Portuguese pronunciation: [maɾɐˈɲɐ̃w] ) is a state in Brazil. Located in the country's Northeast Region, it has a population of about 7 million and an area of 332,000 km2 (128,000 sq mi) and it is divided into 217 municipalities. Clockwise from north, it borders on the Atlantic Ocean for 2,243 km and the states of Piauí, Tocantins and Pará. The people of Maranhão have a distinctive accent within the common Northeastern Brazilian dialect. Maranhão is described in literary works such as Exile Song by Gonçalves Dias and Casa de Pensão by Aluísio Azevedo. The dunes of Lençóis are an important area of environmental preservation."}}, {"canonical_name": "Limoeyro", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "limoeyro", "book_id": "polyanthea_medicinal", "name": "Limoeyro", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Limoeyro"], "contexts": ["location of Francifca Rodriguez", "place mentioned for verification of creatures"]}, {"entity_id": "liamoac", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Liamoac", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Liamoac"], "contexts": ["former department in France"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Limoeyro", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Liamoac", "similarity": 0.843}], "id": 1603, "stable_key": "clu_472cd9d30cc2ac74", "ground_truth": {"modern_name": "Limoges", "confidence": "medium", "type": "place", "country": "France", "note": "The term 'Limoeyro' and 'Liamoac' are phonetically similar to 'Limoges', a historical city in France. The context of 'former department in France' strongly suggests this identification. However, the exact linguistic derivation is not immediately clear without further etymological research.", "wikidata_id": "Q37109898", "wikidata_description": "family name", "wikipedia_extract": "Limoges ( lih-MOHZH, US also  lee-, French: [limɔʒ] ; Occitan: Lemòtges, locally Limòtges [liˈmɔdzes]) is a city and commune, and the prefecture of the Haute-Vienne department in west-central France. It was the administrative capital of the former Limousin region. Situated on the first western foothills of the Massif Central, Limoges is crossed by the river Vienne, of which it was originally the first ford crossing point. The second most populated town in the Nouvelle-Aquitaine region after Bordeaux, a university town, an administrative centre and intermediate services with all the facilities of a regional metropolis, it has an urban area of 323,789 inhabitants in 2018. The inhabitants of the city are called the Limougeauds. Founded around 10 BC under the name of Augustoritum, it became an important Gallo-Roman city."}}, {"canonical_name": "coando-se", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "coando-se", "book_id": "polyanthea_medicinal", "name": "coando-se", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["coando-se"], "contexts": ["straining a liquid", "straining medicine"]}, {"entity_id": "couvade", "book_id": "relation_historique_humboldt_vol3_1825", "name": "couvade", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["couvade"], "contexts": ["ritualistic behavior after childbirth"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "coando-se", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "couvade", "similarity": 0.843}], "id": 1604, "stable_key": "clu_42acb8a68921eac5", "ground_truth": {"modern_name": "Cuvade", "confidence": "high", "type": "concept"}}, {"canonical_name": "Lypiria", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "lypiria", "book_id": "polyanthea_medicinal", "name": "Lypiria", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["Lypiria"], "contexts": ["a type of fever or inflammation", "specific type of fever"]}, {"entity_id": "lièvres", "book_id": "relation_historique_humboldt_vol3_1825", "name": "lièvres", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["lièvres"], "contexts": ["fever affecting the troupe"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Lypiria", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "lièvres", "similarity": 0.845}], "id": 1605, "stable_key": "clu_a81a06cc2546caa5", "ground_truth": {"modern_name": "Erysipelas", "confidence": "medium", "type": "disease", "modern_term": "Erysipelas", "note": "The term 'Lypiria' is not a recognized disease. However, 'lièvres' can be a misreading of 'livre' (a unit of weight), or in a very loose sense, related to 'fever' given its placement in the context of 'fever or inflammation'. 'Erysipelas' is a possibility given the context of inflammation and fever, but the OCR is very uncertain. 'Lypiria' itself might be a corruption of a Latin or Greek term for a febrile illness. A more general term like 'fever' could also be considered, but 'Erysipelas' fits the 'inflammation' aspect better.", "wikidata_id": "Q207092", "wikidata_description": "human disease", "wikipedia_extract": "Erysipelas () is a relatively common bacterial infection of the superficial layer of the skin (upper dermis), extending to the superficial lymphatic vessels within the skin, characterized by a raised, well-defined, tender, bright-red rash, typically on the face or legs, but which can occur anywhere on the skin. It is a form of cellulitis and is potentially serious. Erysipelas is usually caused by the bacterium Streptococcus pyogenes, also known as group A, β-hemolytic streptococci, which enters the body through a break in the skin, such as a scratch or an insect bite. It is more superficial than cellulitis and is typically more raised and demarcated. The term comes from the Greek ἐρυσίπελας (erysípelas), meaning red skin. In animals, erysipelas is a disease caused by infection with the bacterium Erysipelothrix rhusiopathiae.", "wikipedia_url": "https://en.wikipedia.org/wiki/Erysipelas"}}, {"canonical_name": "frescas", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "frescas", "book_id": "polyanthea_medicinal", "name": "frescas", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["frescas", "fresco"], "contexts": ["quality of rooms", "quality of eggs, beneficial"]}, {"entity_id": "fraîche", "book_id": "relation_historique_humboldt_vol3_1825", "name": "fraîche", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["fraîche"], "contexts": ["quality of being cool"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "frescas", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "fraîche", "similarity": 0.933}], "id": 1606, "stable_key": "clu_dee1748e5aa6b341", "ground_truth": {"modern_name": "Coolness", "confidence": "high", "type": "concept", "wikidata_id": "Q127893313", "wikidata_description": "scholarly article", "wikipedia_extract": "Coolness, or being cool, is the aesthetic quality of something (such as attitude, behavior, appearance, or style) being compatible with currently admirable social norms of society or a group of people. Because of the varied and changing interpretation of what is considered cool, as well as its subjective nature, the word has no single meaning. For most, coolness is associated with exemplifying composure and self-control. When used in conversation, it is often as an expression of admiration or approval, and can be used when referencing both people and items of interest. Although commonly regarded as slang, cool is widely used among disparate social groups and has endured in usage for generations. Below are some concise definitions that try to capture its different usages: \"If status is about standing, cool is about standing free.\" – Grant McCracken \"Cool is a knowledge, a way of life.\" – Lewis MacAdams \"Cool is an age-specific phenomenon, defined as the central behavioural trait of teenagerhood.\" \"Coolness is the proper way you represent yourself to a human being.\" – Robert Farris Thompson In the novel Spook Country by William Gibson, one character equates cool with a sense of exclusivity: \"'Secrets,' said the Bigend beside her, 'are the very root of cool.'\" In the novel Lords and Ladies by Terry Pratchett, the \"Monks of Cool\" are mentioned."}}, {"canonical_name": "Hyoidis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "hyoidis", "book_id": "polyanthea_medicinal", "name": "Hyoidis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Hyoidis", "Si Hyoidis"], "contexts": ["hyoid bone", "bone in the throat"]}, {"entity_id": "os_hyoïde", "book_id": "relation_historique_humboldt_vol3_1825", "name": "os hyoïde", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["os hyoïde"], "contexts": ["bone in bird's throat"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Hyoidis", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "os hyoïde", "similarity": 0.906}], "id": 1607, "stable_key": "clu_6f1aa94449a7bded", "ground_truth": {"modern_name": "Hyoid bone", "confidence": "high", "type": "object", "wikidata_id": "Q25036697", "wikidata_description": "rare orthopedic condition", "wikipedia_extract": "The hyoid bone ( HY-oyd), also known as the lingual bone or the tongue-bone, is a horseshoe-shaped bone situated in the anterior midline of the neck between the chin and the thyroid cartilage. At rest, it lies between the base of the mandible and the third cervical vertebra. Unlike other bones, the hyoid is only distantly articulated to other bones by muscles or ligaments. It is the only bone in the human body that is not connected to any other bones. The hyoid is anchored by muscles from the anterior, posterior and inferior directions, and aids in tongue movement and swallowing. The hyoid bone provides attachment to the muscles of the floor of the mouth and the tongue above, the larynx below, and the epiglottis and pharynx behind."}}, {"canonical_name": "laryngis mufculi", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "laryngis_mufculi", "book_id": "polyanthea_medicinal", "name": "laryngis mufculi", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["laryngis mufculi", "laryngis"], "contexts": ["muscles of the larynx", "part of the throat"]}, {"entity_id": "larynx", "book_id": "relation_historique_humboldt_vol3_1825", "name": "larynx", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["larynx"], "contexts": ["lower larynx of birds"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "laryngis mufculi", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "larynx", "similarity": 0.895}], "id": 1608, "stable_key": "clu_fa257edb0cd6ef08", "ground_truth": {"modern_name": "muscles of the larynx", "confidence": "high", "type": "concept", "wikidata_id": "Q6940335", "wikidata_description": "striated muscle groups which move the larynx", "wikipedia_extract": "The larynx (pl.: larynges or larynxes), commonly called the voice box, is an organ in the top of the neck involved in respiration, producing sound and protecting the trachea against food aspiration. The opening of the larynx into the pharynx, known as the laryngeal inlet, is about 4–5 centimeters in diameter. The larynx houses the vocal cords, and manipulates pitch and volume, which is essential for phonation. It is situated just below where the tract of the pharynx splits into the trachea and the esophagus. The triangle-shaped larynx consists largely of cartilages that are attached to surrounding structures by muscles or by fibrous and elastic tissue components. The larynx is lined by a ciliated columnar epithelium except for the vocal folds.", "wikipedia_url": "https://fr.wikipedia.org/wiki/Muscle_du_larynx"}}, {"canonical_name": "ship", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ship", "book_id": "connexion_physical_sciences_somerville_1858", "name": "ship", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["ship"], "contexts": ["vessel for water transport", "vessel for sea travel"]}, {"entity_id": "ship", "book_id": "first_principles_spencer_1862", "name": "ship", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["ship"], "contexts": ["vessel for sea travel"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "ship", "target_book": "first_principles_spencer_1862", "target_name": "ship", "similarity": 1.0}], "id": 1609, "stable_key": "clu_85b5c0b3687c8ca3", "ground_truth": {"modern_name": "ship", "confidence": "high", "type": "object", "wikidata_id": "Q37438629", "wikidata_description": "family name", "wikipedia_extract": "A ship  is a large watercraft designed for travel across the surface of a body of water, carrying cargo or passengers, or in support of specialized tasks such as warfare, oceanography and fishing. Ships are generally distinguished from boats, based on size, shape, load capacity and purpose. Ships have supported exploration, trade, warfare, migration, colonization, and science. Ship transport is responsible for the largest portion of world commerce. The word ship has meant, depending on era and context, either simply a large vessel or specifically a full-rigged ship with three or more masts, each of which is square rigged. The earliest historical evidence of boats is found in Egypt during the 4th millennium BC."}}, {"canonical_name": "musc", "category": "ANIMAL", "subcategory": "PRODUCT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "musc", "book_id": "relation_historique_humboldt_vol3_1825", "name": "musc", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 2, "variants": ["musc"], "contexts": ["odor produced by crocodiles", "strong odor from caymans"]}, {"entity_id": "musk", "book_id": "connexion_physical_sciences_somerville_1858", "name": "musk", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["musk"], "contexts": ["perfume from animal"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "musc", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "musk", "similarity": 0.957}], "id": 1610, "stable_key": "clu_5fececdf628b1e34", "ground_truth": {"modern_name": "musk", "confidence": "high", "type": "animal", "note": "The context 'odor produced by crocodiles' might be an archaic or erroneous association. Musk is typically associated with mammals.", "wikidata_id": "Q323461", "wikidata_description": "class of aromatic substances used of perfumes, originally from scent glands of animals", "wikipedia_url": "https://en.wikipedia.org/wiki/Musk", "wikipedia_extract": "Musk is a class of aromatic substances commonly used as base notes in perfumery. They include glandular secretions from animals such as the musk deer, numerous plants emitting similar fragrances, and artificial substances with similar odors. Musk was a name originally given to a substance with a strong odor obtained from a gland of the musk deer. The substance has been used as a popular perfume fixative since ancient times and is one of the most expensive animal products in the world. The name originates from the Late Greek μόσχος 'moskhos', from Persian mushk and Sanskrit मुष्क muṣka (lit. 'testicle') derived from Proto-Indo-European noun múh₂s meaning \"mouse\". The deer gland was thought to resemble a scrotum."}}, {"canonical_name": "Quebec", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "quebec", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Quebec", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Quebec"], "contexts": ["city with warm summers and severe winters", "city with temperature extremes"]}, {"entity_id": "québec", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Québec", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Québec"], "contexts": ["city"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Quebec", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Québec", "similarity": 0.941}], "id": 1611, "stable_key": "clu_9f2aa4aef878620b", "ground_truth": {"modern_name": "Quebec City", "confidence": "high", "type": "place", "country": "Canada", "wikipedia_extract": "Quebec (French: Québec) is Canada's largest province by area. Located in Central Canada, it is the only Francophone-majority province in the country, being home to Québécois French. It shares borders with the provinces of Ontario to the west, Newfoundland and Labrador to the northeast, New Brunswick to the southeast and a coastal border with the territory of Nunavut. In the south, it shares a border with the United States. Quebec has a population of around 8 million, making it Canada's second-most populous province only behind Ontario. Between 1534 and 1763, what is now Quebec was the French colony of Canada and was the most developed colony in New France.", "wikipedia_url": "https://en.wikipedia.org/wiki/Quebec"}}, {"canonical_name": "Ochotzk", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ochotzk", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Ochotzk", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Ochotzk"], "contexts": ["sea with barometer depression"]}, {"entity_id": "oltzow", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Oltzow", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Oltzow"], "contexts": ["geographic location"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Ochotzk", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Oltzow", "similarity": 0.849}], "id": 1612, "stable_key": "clu_45ad305e5914d2e7", "ground_truth": {"modern_name": "Sea of Okhotsk", "confidence": "high", "type": "place", "country": "Russia", "note": "The spelling variation 'Oltzow' is likely an OCR error for 'Ochotzk'.", "wikidata_id": "Q107554830", "wikidata_description": "bio-geographic region in MEOW scheme", "wikipedia_extract": "The Sea of Okhotsk is a marginal sea of the northwestern Pacific Ocean. It is located between Russia's Kamchatka Peninsula on the east, the Kuril Islands on the southeast, Japan's island of Hokkaido on the south, the island of Sakhalin along the west, and a stretch of eastern Siberian coast along the west and north. Its northeast corner is the Shelikhov Gulf. The sea is named for the port of Okhotsk, itself named for the Okhota River. The Sea of Okhotsk covers an area of 1,583,000 square kilometres (611,000 sq mi), with a mean depth of 859 metres (2,818 ft) and a maximum depth of 3,372 metres (11,063 ft). It is connected to the Sea of Japan on either side of Sakhalin: on the west through the Sakhalin Gulf and the Gulf of Tartary; on the south through the La Pérouse Strait.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sea_of_Okhotsk"}}, {"canonical_name": "screen", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "screen", "book_id": "connexion_physical_sciences_somerville_1858", "name": "screen", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["screen"], "contexts": ["surface for projecting light", "surface for projecting images"]}, {"entity_id": "camera-screen", "book_id": "principles_of_psychology_james_1890", "name": "camera-screen", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["camera-screen"], "contexts": ["surface for image formation"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "screen", "target_book": "principles_of_psychology_james_1890", "target_name": "camera-screen", "similarity": 0.91}], "id": 1613, "stable_key": "clu_43e797d6be626fa9", "ground_truth": {"modern_name": "screen", "confidence": "high", "type": "object", "note": "The term 'camera-screen' suggests a projection screen or a similar optical device.", "wikidata_id": "Q37489346", "wikidata_description": "family name"}}, {"canonical_name": "grain", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "grain", "book_id": "relation_historique_humboldt_vol3_1825", "name": "grain", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["grain", "grains"], "contexts": ["measure of agricultural yield", "small particles"]}, {"entity_id": "grains", "book_id": "first_principles_spencer_1862", "name": "grains", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["grains"], "contexts": ["unit of weight"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "grain", "target_book": "first_principles_spencer_1862", "target_name": "grains", "similarity": 0.979}], "id": 1614, "stable_key": "clu_f98da2b1345e8412", "ground_truth": {"modern_name": "grain", "confidence": "high", "type": "concept", "wikipedia_extract": "A grain is a small, hard, dry fruit (caryopsis) – with or without an attached hull layer – harvested for human or animal consumption. A grain crop is a grain-producing plant. The two main types of commercial grain crops are cereals and legumes. After being harvested, dry grains are more durable than other staple foods, such as starchy fruits (plantains, breadfruit, etc.) and tubers (sweet potatoes, cassava, and more). This durability has made grains well suited to industrial agriculture, since they can be mechanically harvested, transported by rail or ship, stored for long periods in silos, and milled for flour or pressed for oil. Thus, the grain market is a major global agricultural market that includes crops such as maize, rice, soybeans, wheat and other grains.", "wikipedia_url": "https://en.wikipedia.org/wiki/Grain"}}, {"canonical_name": "monothéisme", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "monothéisme", "book_id": "relation_historique_humboldt_vol3_1825", "name": "monothéisme", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["monothéisme"], "contexts": ["belief in one God", "belief in a Great Spirit"]}, {"entity_id": "monotheistic", "book_id": "first_principles_spencer_1862", "name": "Monotheistic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Monotheistic"], "contexts": ["religious belief in one god"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "monothéisme", "target_book": "first_principles_spencer_1862", "target_name": "Monotheistic", "similarity": 0.978}], "id": 1615, "stable_key": "clu_3170779dfd8df779", "ground_truth": {"modern_name": "monotheism", "confidence": "high", "type": "concept"}}, {"canonical_name": "hope", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "hope", "book_id": "principles_of_psychology_james_1890", "name": "hope", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["hope"], "contexts": ["a phrenological faculty", "cardinal passion of life"]}, {"entity_id": "hope", "book_id": "kosmos_humboldt_1845", "name": "hope", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hope"], "contexts": ["feeling of expectation and desire"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "hope", "target_book": "kosmos_humboldt_1845", "target_name": "hope", "similarity": 1.0}], "id": 1616, "stable_key": "clu_7227af037fddd056", "ground_truth": {"modern_name": "Hope", "confidence": "high", "type": "concept", "note": "The context 'phrenological faculty' strongly suggests the psychological concept of hope, also explicitly mentioned as 'feeling of expectation and desire'.", "wikidata_id": "Q1631308", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/J-Hope", "wikipedia_extract": "Jung Ho-seok (Korean: 정호석; born February 18, 1994), known professionally as J-Hope (제이홉; stylized in lower case), is a South Korean rapper, singer, songwriter, dancer, and record producer. He made his debut as a member of South Korean boy band BTS in 2013, under Big Hit Entertainment. J-Hope released his first solo mixtape, Hope World, in 2018. It was received positively by critics and peaked at number 38 on the US Billboard 200, the highest-charting album by a Korean solo artist at the time. He became the first member of BTS to enter the Billboard Hot 100 as a soloist in 2019, when his single \"Chicken Noodle Soup\", featuring singer Becky G, debuted at number 81. In 2022, J-Hope released his debut studio album Jack in the Box."}}, {"canonical_name": "Archives de Physiologie", "category": "ORGANIZATION", "subcategory": "JOURNAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "archives_de_physiologie", "book_id": "principles_of_psychology_james_1890", "name": "Archives de Physiologie", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 2, "variants": ["Archives de Physiologie"], "contexts": ["scientific journal", "journal publishing Gley's findings"]}, {"entity_id": "archiv_fur_anatomie_und_physiologie", "book_id": "kosmos_humboldt_1845", "name": "Archiv fur Anatomie und Physiologie", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Archiv fur Anatomie und Physiologie"], "contexts": ["journal for anatomy and physiology"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Archives de Physiologie", "target_book": "kosmos_humboldt_1845", "target_name": "Archiv fur Anatomie und Physiologie", "similarity": 0.841}], "id": 1617, "stable_key": "clu_23dbf2f3c474c062", "ground_truth": {"modern_name": "Archives de Physiologie", "confidence": "high", "type": "text", "note": "The reference to 'Archiv fur Anatomie und Physiologie' (now Archiv für Physiologie und Anatomie or similar) clarifies that this refers to a scientific journal, specifically related to physiology.", "wikidata_id": "Q93707533", "wikidata_description": ""}}, {"canonical_name": "American Journal of Science", "category": "ORGANIZATION", "subcategory": "JOURNAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "american_journal_of_science", "book_id": "kosmos_humboldt_1845", "name": "American Journal of Science", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 2, "variants": ["American Journal of Science"], "contexts": ["journal announcing phenomenon", "scientific publication"]}, {"entity_id": "amer__jour__of_science", "book_id": "principles_of_psychology_james_1890", "name": "Amer. Jour. of Science", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Amer. Jour. of Science"], "contexts": ["scientific journal"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "American Journal of Science", "target_book": "principles_of_psychology_james_1890", "target_name": "Amer. Jour. of Science", "similarity": 0.905}], "id": 1618, "stable_key": "clu_3b4b987ab3ef1404", "ground_truth": {"modern_name": "American Journal of Science", "confidence": "high", "type": "text", "note": "The abbreviation and full title clearly point to this specific scientific journal.", "wikidata_id": "Q465355", "wikidata_description": "journal focused on earth sciences. Overall volumes: 119 (1880) to end", "wikipedia_url": "https://en.wikipedia.org/wiki/American_Journal_of_Science", "wikipedia_extract": "B'nai B'rith International ( bə-NAY BRITH; from Hebrew: בְּנֵי בְּרִית, romanized: b'né brit, lit. 'Children of the Covenant') is an American 501(c)(3) nonprofit Jewish service organization and was formerly a cultural association for German Jewish immigrants to the United States. B'nai B'rith states that it is committed to the security and continuity of the Jewish people and the State of Israel and combating antisemitism and other forms of bigotry. Although the organization's historic roots stem from a system of fraternal lodges and units in the late 19th century, as fraternal organizations declined throughout the United States, the organization evolved into a dual system of both lodges and units. The membership pattern became more common to other contemporary organizations of members affiliated by contribution in addition to formal dues paying members. B'nai B'rith has members, donors and supporters around the world."}}, {"canonical_name": "lower trias", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "lower_trias", "book_id": "kosmos_humboldt_1845", "name": "lower trias", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["lower trias"], "contexts": ["geological period"]}, {"entity_id": "low", "book_id": "principles_of_psychology_james_1890", "name": "low", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["low"], "contexts": ["particular stature"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "lower trias", "target_book": "principles_of_psychology_james_1890", "target_name": "low", "similarity": 0.823}], "id": 1619, "stable_key": "clu_5d7e8430d5cae9b1", "ground_truth": {"modern_name": "Lower Triassic", "confidence": "medium", "type": "concept", "note": "The context 'geological period' points to the Lower Trias. The mention of 'low' in the second source is ambiguous and could refer to stature, but in conjunction with the first, 'Lower Trias' is the most probable referent.", "wikidata_id": "Q47158", "wikidata_description": "first system and period of the Mesozoic erathem and era", "wikipedia_url": "https://en.wikipedia.org/wiki/Triassic", "wikipedia_extract": "The Triassic (; sometimes symbolized as 🝈) is a geologic period and a stratigraphic system that spans 50.5 million years from the end of the Permian Period 251.902 Ma (million years ago) to the beginning of the Jurassic Period 201.4 Ma. The Triassic Period is the first and shortest geologic period of the Mesozoic Era, and the seventh period of the Phanerozoic Eon. The start and the end of the Triassic Period featured major extinction events. Chronologically, the Triassic Period is divided into three epochs: (i) the Early Triassic, (ii) the Middle Triassic, and (iii) the Late Triassic. The Triassic Period began after the Permian–Triassic extinction event that much reduced the biosphere of planet Earth. The fossil record of the Triassic Period presents three categories of organisms: (i) animals that survived the Permian–Triassic extinction event, (ii) new animals that briefly flourished in the Triassic biosphere, and (iii) new animals that evolved and dominated the Mesozoic Era."}}, {"canonical_name": "pen", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pen", "book_id": "principles_of_psychology_james_1890", "name": "pen", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["pen"], "contexts": ["writing instrument"]}, {"entity_id": "penna", "book_id": "polyanthea_medicinal", "name": "penna", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["penna"], "contexts": ["material not to be used for remedies"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "pen", "target_book": "polyanthea_medicinal", "target_name": "penna", "similarity": 0.974}], "id": 1620, "stable_key": "clu_9b382d553d307cc5", "ground_truth": {"wikipedia_extract": "A pen is a common writing instrument that applies ink to a surface, typically paper, for writing or drawing. Early pens such as reed pens, quill pens, dip pens and ruling pens held a small amount of ink on a nib or in a small void or cavity that had to be periodically recharged by dipping the tip of the pen into an inkwell. Today, such pens find only a small number of specialized uses, such as in illustration and calligraphy. Reed pens, quill pens and dip pens, which were used for writing, have been replaced by ballpoint pens, rollerball pens, fountain pens and felt or ceramic tip pens. Ruling pens, which were used for technical drawing and cartography, have been replaced by technical pens such as the Rapidograph. All of these modern pens contain internal ink reservoirs, such that they do not need to be dipped in ink while writing."}}, {"canonical_name": "fame", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "fame", "book_id": "principles_of_psychology_james_1890", "name": "fame", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fame"], "contexts": ["reputation and public recognition"]}, {"entity_id": "good_fame", "book_id": "principles_of_psychology_james_1890", "name": "good fame", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["good fame"], "contexts": ["reputation for good deeds"]}, {"entity_id": "fama_commum", "book_id": "coloquios_da_orta_1563", "name": "fama commum", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fama commum"], "contexts": ["common opinion"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "fame", "target_book": "coloquios_da_orta_1563", "target_name": "fama commum", "similarity": 0.9}, {"source_book": "principles_of_psychology_james_1890", "source_name": "good fame", "target_book": "coloquios_da_orta_1563", "target_name": "fama commum", "similarity": 0.888}], "id": 1621, "stable_key": "clu_e50ddd3e16ec7d85", "ground_truth": {"modern_name": "Reputation", "confidence": "high", "type": "concept", "note": "The cluster encompasses concepts of public recognition, good deeds, and common opinion, all falling under the umbrella of reputation.", "wikipedia_extract": "Reputation management, refers to the influencing, controlling, enhancing, or concealing of an individual's or group's reputation. It is a marketing technique used to modify a person's or a company's reputation in a positive way. The growth of the internet and social media led to growth of reputation management companies, with search results as a core part of a client's reputation. Online reputation management (ORM) involves overseeing and influencing the search engine results related to products and services. Ethical grey areas include mug shot removal sites, astroturfing customer review sites, censoring complaints, and using search engine optimization tactics to influence results. In other cases, the ethical lines are clear; some reputation management companies are closely connected to websites that publish unverified and libelous statements about people.", "wikipedia_url": "https://en.wikipedia.org/wiki/Reputation_management"}}, {"canonical_name": "doenças de nervos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "doenças_de_nervos", "book_id": "polyanthea_medicinal", "name": "doenças de nervos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["doenças de nervos"], "contexts": ["ailments affecting the nervous system", "diseases affecting nerves"]}, {"entity_id": "nervosas", "book_id": "coloquios_da_orta_1563", "name": "nervosas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["nervosas"], "contexts": ["related to nerves, benefited by fruit preserve"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "doenças de nervos", "target_book": "coloquios_da_orta_1563", "target_name": "nervosas", "similarity": 0.905}], "id": 1622, "stable_key": "clu_bfdf40aec5ab9fa4", "ground_truth": {"modern_name": "Nervous disorders", "confidence": "high", "type": "disease", "modern_term": "Neurological disorders", "note": "The Portuguese term 'doenças de nervos' directly translates to 'diseases of nerves', and the context 'related to nerves' solidifies this.", "wikidata_id": "Q96319340", "wikidata_description": "", "wikipedia_extract": "A neurological disorder is any disorder of the nervous system. Structural, biochemical or electrical abnormalities in the brain, spinal cord, or other nerves can result in a range of symptoms. Examples of symptoms include paralysis, muscle weakness, poor coordination, loss of sensation, seizures, confusion, pain, tauopathies, and altered levels of consciousness. There are many recognized neurological disorders; some are relatively common, but many are rare. Interventions for neurological disorders include preventive measures, lifestyle changes, physiotherapy or other therapy, neurorehabilitation, pain management, medication, operations performed by neurosurgeons, or a specific diet. The World Health Organization estimated in 2006 that neurological disorders and their sequelae (direct consequences) affect as many as one billion people worldwide and identified health inequalities and social stigma/discrimination as major factors contributing to the associated disability and their impact.", "wikipedia_url": "https://en.wikipedia.org/wiki/Neurological_disorder"}}, {"canonical_name": "hemianopsia", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "hemianopsia", "book_id": "principles_of_psychology_james_1890", "name": "hemianopsia", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["hemianopsia"], "contexts": ["loss of half of the visual field", "blindness to half the visual field"]}, {"entity_id": "hemicr", "book_id": "polyanthea_medicinal", "name": "hemicr", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["hemicr"], "contexts": ["hemicrania, a type of headache"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "hemianopsia", "target_book": "polyanthea_medicinal", "target_name": "hemicr", "similarity": 0.851}], "id": 1623, "stable_key": "clu_6fca626af4694328", "ground_truth": {"wikipedia_extract": "Hemianopsia, or hemianopia, is a loss of vision or blindness (anopsia) in half the visual field, usually on one side of the vertical midline. The most common causes of this damage are stroke, brain tumor, and trauma. This article deals only with permanent hemianopsia, and not with transitory or temporary hemianopsia, as identified by William Wollaston PRS in 1824. Temporary hemianopsia can occur in the aura phase of migraine. The word hemianopsia is from Greek origins, where: When the pathology involves both eyes, it is either homonymous or heteronymous. A homonymous hemianopsia is the loss of half of the visual field on the same side in both eyes."}}, {"canonical_name": "creatin", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "creatin", "book_id": "principles_of_psychology_james_1890", "name": "creatin", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["creatin"], "contexts": ["chemical found in the brain", "substance poured into blood by brain"]}, {"entity_id": "creatico", "book_id": "polyanthea_medicinal", "name": "creatico", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["creatico"], "contexts": ["pancreatic"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "creatin", "target_book": "polyanthea_medicinal", "target_name": "creatico", "similarity": 0.925}], "id": 1624, "stable_key": "clu_5fb5395208ddc595", "ground_truth": {"wikipedia_extract": "Creatine ( or ) is an organic compound that, in vertebrates, facilitates recycling of adenosine triphosphate (ATP), primarily in muscle and brain tissue. Its phosphorylated form, phosphocreatine, donates phosphate groups to adenosine diphosphate (ADP), turning it back into ATP. Creatine also acts as a buffer. It has the nominal formula (H2N)(HN)CN(CH3)CH2CO2H and in solutions, exists in various tautomers, including a neutral form and zwitterionic forms. Creatine was first identified in 1832 when Michel Eugène Chevreul isolated it from the basified water-extract of skeletal muscle. He later named the crystallized precipitate after the Greek word for meat, κρέας (kreas)."}}, {"canonical_name": "medios", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "medios", "book_id": "polyanthea_medicinal", "name": "medios", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["medios"], "contexts": ["medicines or remedies", "remedies, mentioned with medicine"]}, {"entity_id": "meios", "book_id": "coloquios_da_orta_1563", "name": "meios", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["meios"], "contexts": ["resources for studying economic issues"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "medios", "target_book": "coloquios_da_orta_1563", "target_name": "meios", "similarity": 0.884}], "id": 1625, "stable_key": "clu_0c002f78cbf112cd", "ground_truth": {"modern_name": "Remedies", "confidence": "high", "type": "concept", "note": "The Portuguese 'medios' (or 'meios') in a medicinal context refers to remedies or medicines. The second context is too divergent to override the primary medicinal interpretation.", "wikidata_id": "Q1595418", "wikidata_description": "substance or procedure that ends a medical condition", "wikipedia_extract": "The right to an effective remedy is the right of a person whose human rights have been violated to legal remedy. Such a remedy must be accessible, binding, capable of bringing perpetrators to justice, provide appropriate reparations, and prevent further violations of the person's rights. The right to an effective remedy guarantees the individual the ability to seek remedy from the state directly rather than through an international process. It is a practical means of protecting human rights on the state level and requires the state to not just only protect human rights de jure but also in practice for individual cases. The right to an effective remedy is commonly recognized as a human right in international human rights instruments. The right to an effective remedy is expressed in Article 8 of the Universal Declaration of Human Rights, Article 2 of the International Covenant on Civil and Political Rights, Article 13 of the European Convention on Human Rights, and Article 47 of the European Union Charter on Fundamental Rights.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cure"}}, {"canonical_name": "Herb, Amb.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "herb,_amb_", "book_id": "coloquios_da_orta_1563", "name": "Herb, Amb.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Herb, Amb."], "contexts": ["cited work", "cited work abbreviation"]}, {"entity_id": "herbar_", "book_id": "polyanthea_medicinal", "name": "herbar.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["herbar."], "contexts": ["abbreviation for herbal"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Herb, Amb.", "target_book": "polyanthea_medicinal", "target_name": "herbar.", "similarity": 0.928}], "id": 1626, "stable_key": "clu_58818f737c4f4423", "ground_truth": {"modern_name": "Herbal", "confidence": "high", "type": "text", "note": "The abbreviations 'Herb, Amb.' and 'herbar.' when referring to cited works in a medicinal context strongly suggest 'herbal' as a type of book or source.", "wikipedia_extract": "Ayurveda is a pseudoscientific alternative medicine system with historical roots in the Indian subcontinent. It is heavily practised throughout India and Nepal, where as much as 80% of the population report using ayurveda. Toxic metals including lead and mercury are used as ingredients in many ayurvedic medicines. Ayurveda therapies have varied and evolved over more than two millennia. Therapies include herbal medicines, special diets, meditation, yoga, massage, laxatives, enemas, and medical oils. Early Ayurvedic preparations were entirely based on complex herbal compounds based on the materia medica of South Asia.", "wikipedia_url": "https://en.wikipedia.org/wiki/Ayurveda"}}, {"canonical_name": "S C", "category": "ANATOMY", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "s_c", "book_id": "principles_of_psychology_james_1890", "name": "S C", "category": "ANATOMY", "subcategory": "ANATOMY", "count": 2, "variants": ["S C"], "contexts": ["spinal cord", "Spinal cord in diagram"]}, {"entity_id": "s_c", "book_id": "connexion_physical_sciences_somerville_1858", "name": "S C", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["S C"], "contexts": ["line segment in parallax calculation"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "S C", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "S C", "similarity": 0.925}], "id": 1627, "stable_key": "clu_a733a6114d49a8f7", "ground_truth": {"modern_name": "Spinal Cord", "confidence": "high", "type": "anatomy", "note": "The context 'line segment in parallax calculation' suggests a geometric interpretation, but the presence of the term in 'principles_of_psychology' and its anatomical subcategory strongly points to the biological structure. The abbreviation 'S C' is common for Spinal Cord.", "wikidata_id": "Q2997445", "wikidata_description": "body organ", "wikipedia_url": "https://en.wikipedia.org/wiki/Tethered_cord_syndrome", "wikipedia_extract": "Tethered cord syndrome (TCS) refers to a group of neurological disorders that relate to malformations of the spinal cord. Various forms include tight filum terminale, lipomeningomyelocele, split cord malformations (diastematomyelia), occult, dermal sinus tracts, and dermoids. All forms involve the pulling of the spinal cord at the base of the spinal canal, literally a tethered cord. The spinal cord normally hangs loose in the canal, free to move up and down with growth, and with bending and stretching. A tethered cord, however, is held taut at the end or at some point in the spinal canal. In children, a tethered cord can force the spinal cord to stretch as they grow."}}, {"canonical_name": "luminiferous ether", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "luminiferous_ether", "book_id": "principles_of_psychology_james_1890", "name": "luminiferous ether", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["luminiferous ether"], "contexts": ["hypothetical medium for light", "hypothetical medium for light propagation"]}, {"entity_id": "luminiferous_ether", "book_id": "connexion_physical_sciences_somerville_1858", "name": "luminiferous ether", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["luminiferous ether"], "contexts": ["medium for light propagation"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "luminiferous ether", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "luminiferous ether", "similarity": 1.0}], "id": 1628, "stable_key": "clu_c927aee90a825390", "ground_truth": {"modern_name": "Luminiferous Ether", "confidence": "high", "type": "concept", "wikipedia_extract": "The etheric body, ether-body, or æther body is a subtle body propounded in esoteric and occult philosophies as the first or lowest layer in the human energy field or aura. The etheric body is said to be in immediate contact with the physical body and to sustain it and connect it with \"higher\" bodies. It is also said to consist of a finer substance, more pure and composed of smaller particles, than the ordinary matter of the physical plane. (See the book Occult Chemistry by C.W. Leadbeater) The English term \"etheric\" in this context seems to derive from the Theosophical writings of Madame Blavatsky, but its use was formalised by C.W. Leadbeater and Annie Besant due to the elimination of Hindu terminology from the system of seven planes and bodies.", "wikipedia_url": "https://en.wikipedia.org/wiki/Etheric_body"}}, {"canonical_name": "inch", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "inch", "book_id": "connexion_physical_sciences_somerville_1858", "name": "inch", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["inch"], "contexts": ["unit of length for measurement", "unit of length"]}, {"entity_id": "inch", "book_id": "principles_of_psychology_james_1890", "name": "inch", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["inch"], "contexts": ["unit of length"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "inch", "target_book": "principles_of_psychology_james_1890", "target_name": "inch", "similarity": 1.0}], "id": 1629, "stable_key": "clu_fd62098935ea67d1", "ground_truth": {"modern_name": "Inch", "confidence": "high", "type": "concept", "wikidata_id": "Q21445422", "wikidata_description": "chemical identifier", "wikipedia_url": "https://en.wikipedia.org/wiki/InChIKey"}}, {"canonical_name": "Tuileries", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tuileries", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Tuileries", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Tuileries"], "contexts": ["gardens with decimal time clock", "location with a clock"]}, {"entity_id": "tuileries", "book_id": "principles_of_psychology_james_1890", "name": "Tuileries", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Tuileries"], "contexts": ["Parisian palace and gardens"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Tuileries", "target_book": "principles_of_psychology_james_1890", "target_name": "Tuileries", "similarity": 1.0}], "id": 1630, "stable_key": "clu_780cbc727bb03822", "ground_truth": {"modern_name": "Tuileries Garden", "confidence": "high", "type": "place", "country": "France", "note": "Refers to the Tuileries Garden in Paris, known for its historical significance and public spaces.", "wikidata_id": "Q818517", "wikidata_description": "public garden in Paris, France", "wikipedia_url": "https://en.wikipedia.org/wiki/Tuileries_Garden", "wikipedia_extract": "The Tuileries Garden (French: Jardin des Tuileries, IPA: [ʒaʁdɛ̃ de tɥilʁi]) is a public garden between the Louvre and the Place de la Concorde in the 1st arrondissement of Paris, France. Created by Catherine de' Medici as the garden of the Tuileries Palace in 1564, it was opened to the public in 1667 and became a public park after the French Revolution. Since the 19th century, it has been a place for Parisians to celebrate, meet, stroll and relax. Covering an area of 25.5 hectares (63 acres), it is one of the most iconic parks in Paris. During the 2024 Summer Olympics and Paralympics, it was the site of the Olympic and Paralympic cauldron. The Italian Garden of Catherine de' Medici (16th century) In July 1559, after the accidental death of her husband, Henry II, Queen Catherine de' Medici decided to leave her residence of the Hôtel des Tournelles, at the eastern part of Paris, near the Bastille."}}, {"canonical_name": "exhaustion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "exhaustion", "book_id": "principles_of_psychology_james_1890", "name": "exhaustion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["exhaustion"], "contexts": ["condition that enfeebles memory", "state of extreme tiredness"]}, {"entity_id": "exhaustion", "book_id": "first_principles_spencer_1862", "name": "exhaustion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["exhaustion"], "contexts": ["extreme tiredness"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "exhaustion", "target_book": "first_principles_spencer_1862", "target_name": "exhaustion", "similarity": 1.0}], "id": 1631, "stable_key": "clu_ad597270791247d6", "ground_truth": {"modern_name": "Exhaustion", "confidence": "high", "type": "disease", "modern_term": "Fatigue", "note": "While 'exhaustion' can refer to general tiredness, in medical contexts, it points to a state of extreme fatigue or debilitation.", "wikipedia_extract": "The ICD-11 of the World Health Organization (WHO) describes occupational burnout as a work-related phenomenon resulting from chronic workplace stress that has not been successfully managed. According to the WHO, symptoms include \"feelings of energy depletion or exhaustion; increased mental distance from one's job, or feelings of negativism or cynicism related to one's job; and reduced professional efficacy.\" Occupational burnout is classified as an occupational phenomenon but is not recognized by the WHO as a medical or psychiatric condition. Social psychologist Christina Maslach and colleagues made clear that burnout does not constitute \"a single, one-dimensional phenomenon.\" However, national health bodies in some European countries do recognize it as such, and it is also independently recognized by some health practitioners. Nevertheless, a body of evidence suggests that what is termed burnout is a depressive condition, that is to say, indistinct from, and overlaps with, depression. Kaschka, Korczak, and Broich (2011) advanced the view that burnout is described in the Book of Exodus (18:17–18). In the New International Version of the Bible, Moses' father-in-law said to Moses, \"What you are doing is not good.", "wikipedia_url": "https://en.wikipedia.org/wiki/Occupational_burnout"}}, {"canonical_name": "timbre", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "timbre", "book_id": "principles_of_psychology_james_1890", "name": "timbre", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["timbre"], "contexts": ["quality of sound distinguishing instruments", "sound quality of instrument"]}, {"entity_id": "timbre", "book_id": "first_principles_spencer_1862", "name": "timbre", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["timbre"], "contexts": ["quality of a musical sound"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "timbre", "target_book": "first_principles_spencer_1862", "target_name": "timbre", "similarity": 1.0}], "id": 1632, "stable_key": "clu_45afb2aea94c862d", "ground_truth": {"modern_name": "Timbre", "confidence": "high", "type": "concept", "wikidata_id": "Q37481820", "wikidata_description": "family name"}}, {"canonical_name": "anæsthetics", "category": "SUBSTANCE", "subcategory": "CHEMICAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "anæsthetics", "book_id": "principles_of_psychology_james_1890", "name": "anæsthetics", "category": "SUBSTANCE", "subcategory": "CHEMICAL", "count": 2, "variants": ["anæsthetics"], "contexts": ["substances causing loss of sensation"]}, {"entity_id": "anæsthetics", "book_id": "first_principles_spencer_1862", "name": "anæsthetics", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["anæsthetics"], "contexts": ["agents causing loss of sensation"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "anæsthetics", "target_book": "first_principles_spencer_1862", "target_name": "anæsthetics", "similarity": 0.823}], "id": 1633, "stable_key": "clu_7a363e2cbeaf7dee", "ground_truth": {"modern_name": "Anesthetics", "confidence": "high", "type": "chemical", "wikidata_id": "Q50430271", "wikidata_description": "use of two or more substances simultaneously or sequentially to induce anesthesia.", "wikipedia_extract": "An anesthetic (American English) or anaesthetic (British English; see spelling differences) is a drug used to induce anesthesia ⁠— ⁠in other words, to result in a temporary loss of sensation or awareness. They may be divided into two broad classes: general anesthetics, which result in a reversible loss of consciousness, and local anesthetics, which cause a reversible loss of sensation for a limited region of the body without necessarily affecting consciousness. A wide variety of drugs are used in modern anesthetic practice. Many are rarely used outside anesthesiology, but others are used commonly in various fields of healthcare. Combinations of anesthetics are sometimes used for their synergistic and additive therapeutic effects. Adverse effects, however, may also be increased."}}, {"canonical_name": "pluralism", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pluralism", "book_id": "principles_of_psychology_james_1890", "name": "pluralism", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "count": 2, "variants": ["pluralism"], "contexts": ["philosophical view of multiplicity"]}, {"entity_id": "polytheism", "book_id": "first_principles_spencer_1862", "name": "Polytheism", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "count": 1, "variants": ["Polytheism"], "contexts": ["religion with partially generalized personalities"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "pluralism", "target_book": "first_principles_spencer_1862", "target_name": "Polytheism", "similarity": 0.884}], "id": 1634, "stable_key": "clu_bc92e881a34e3f40", "ground_truth": {"modern_name": "Pluralism", "confidence": "medium", "type": "concept", "note": "The entry 'Polytheism' as a member of this cluster suggests a potential confusion or a specific philosophical interpretation linking multiple deities to a broader concept of multiplicity. However, 'pluralism' is a distinct philosophical concept. The confidence is medium due to the ambiguity introduced by 'Polytheism'.", "wikidata_id": "Q879021", "wikidata_description": "philosophical theory", "wikipedia_extract": "Strategic pluralism (also known as the dual-mating strategy) is a theory in evolutionary psychology regarding human mating strategies that suggests women have evolved to evaluate men in two categories: whether they are reliable long term providers, and whether they contain high quality genes. The theory of strategic pluralism was proposed by Steven Gangestad and Jeffry Simpson, two professors of psychology at the University of New Mexico and Texas A&M University, respectively. Although strategic pluralism is believed to occur for both animals and humans, the majority of experiments have been performed with humans. One experiment concluded that between short term and long-term relationships, males and females prioritized different things. It was shown that both preferred physical attractiveness for short term mates. However, for long term, females preferred males with traits that indicated that they could be better caretakers, whereas the males did not change their priorities.", "wikipedia_url": "https://en.wikipedia.org/wiki/Strategic_pluralism"}}, {"canonical_name": "teleological", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "teleological", "book_id": "principles_of_psychology_james_1890", "name": "teleological", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["teleological"], "contexts": ["explanation by purpose or final cause"]}, {"entity_id": "teleological", "book_id": "first_principles_spencer_1862", "name": "Teleological", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["Teleological"], "contexts": ["explanation by purpose or end goal"]}, {"entity_id": "teleological_hypothesis", "book_id": "first_principles_spencer_1862", "name": "teleological hypothesis", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["teleological hypothesis"], "contexts": ["explanation based on final causes"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "teleological", "target_book": "first_principles_spencer_1862", "target_name": "Teleological", "similarity": 0.976}, {"source_book": "principles_of_psychology_james_1890", "source_name": "teleological", "target_book": "first_principles_spencer_1862", "target_name": "teleological hypothesis", "similarity": 0.944}], "id": 1635, "stable_key": "clu_a721758efe1da457", "ground_truth": {"modern_name": "Teleology", "confidence": "high", "type": "concept", "note": "This cluster refers to the philosophical concept of explaining phenomena by their purpose or final cause.", "wikidata_id": "Q119446245", "wikidata_description": "scholarly article in Science Research Management no. 2, 1996", "wikipedia_extract": "Teleology (from τέλος, telos, 'end', 'aim', or 'goal', and λόγος, logos, 'explanation' or 'reason') or finality is a branch of causality giving the reason or an explanation for something as a function of its end, its purpose, or its goal, as opposed to as a function of its efficient cause. A purpose that is imposed by human use, such as the purpose of a fork to hold food, is called extrinsic. Natural teleology, common in classical philosophy, though controversial today, contends that natural entities also have intrinsic purposes, regardless of human use or opinion. For instance, Aristotle claimed that an acorn's intrinsic telos is to become a fully grown oak tree. Though ancient materialists rejected the notion of natural teleology, teleological accounts of non-personal or non-human nature were explored and often endorsed in ancient and medieval philosophies, but fell into disfavor during the modern era (1600–1900). Much of the discussion on teleology revolves around religion and the belief in a Godly, purposeful existence for the world and for humans."}}, {"canonical_name": "inspiration", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "inspiration", "book_id": "principles_of_psychology_james_1890", "name": "inspiration", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["inspiration"], "contexts": ["process inhibited by superior laryngeal nerve"]}, {"entity_id": "inspirations", "book_id": "principles_of_psychology_james_1890", "name": "inspirations", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["inspirations"], "contexts": ["part of the breathing cycle"]}, {"entity_id": "inspirations", "book_id": "first_principles_spencer_1862", "name": "inspirations", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["inspirations"], "contexts": ["act of breathing in"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "inspiration", "target_book": "first_principles_spencer_1862", "target_name": "inspirations", "similarity": 0.983}, {"source_book": "principles_of_psychology_james_1890", "source_name": "inspirations", "target_book": "first_principles_spencer_1862", "target_name": "inspirations", "similarity": 1.0}], "id": 1636, "stable_key": "clu_a96fc4ae9afa8c26", "ground_truth": {"modern_name": "Inhalation", "confidence": "high", "type": "concept", "note": "While 'inspiration' can have multiple meanings, in a medical/biological context related to breathing, it refers to the act of breathing in.", "wikidata_id": "Q840343", "wikidata_description": "flow of the respiratory current into an organism", "wikipedia_url": "https://en.wikipedia.org/wiki/Inhalation", "wikipedia_extract": "Inhalation (or inspiration) happens when air or other gases enter the lungs. Inhalation of air, as part of the cycle of breathing, is a vital process for all human life. The process is autonomic (though there are exceptions in some disease states) and does not need conscious control or effort. However, breathing can be consciously controlled or interrupted (within limits). Breathing allows oxygen (which humans and a lot of other species need for survival) to enter the lungs, from where it can be absorbed into the bloodstream. Examples of accidental inhalation includes inhalation of water (e.g. in drowning), smoke, food, vomitus and less common foreign substances (e.g. tooth fragments, coins, batteries, small toy parts, needles)."}}, {"canonical_name": "fluids", "category": "ANATOMY", "subcategory": "FLUID", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "fluids", "book_id": "first_principles_spencer_1862", "name": "fluids", "category": "ANATOMY", "subcategory": "FLUID", "count": 2, "variants": ["fluids", "Fluids"], "contexts": ["state of matter", "body liquids"]}, {"entity_id": "efferent_fluids", "book_id": "principles_of_psychology_james_1890", "name": "efferent fluids", "category": "ANATOMY", "subcategory": "FLUID", "count": 1, "variants": ["efferent fluids"], "contexts": ["fluids flowing away from vessels"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "fluids", "target_book": "principles_of_psychology_james_1890", "target_name": "efferent fluids", "similarity": 0.884}], "id": 1637, "stable_key": "clu_e308ca4d669fd603", "ground_truth": {"modern_name": "Fluid", "confidence": "high", "type": "concept", "note": "Refers to substances that flow, a fundamental concept in both physics and physiology.", "wikidata_id": "Q20127660", "wikidata_description": "converting wastewater into an effluent for return to the water cycle", "wikipedia_url": "https://en.wikipedia.org/wiki/Wastewater%20treatment", "wikipedia_extract": "In physics, a fluid is a liquid, gas, or other material that may continuously move and deform (flow) under an applied shear stress, or external force. They have zero shear modulus, or, in simpler terms, are substances which cannot resist any shear force applied to them. Although the term fluid generally includes both the liquid and gas phases, its definition varies among branches of science. Definitions of solid vary as well, and depending on field, some substances can have both fluid and solid properties. Non-Newtonian fluids like Silly Putty appear to behave similar to a solid when a sudden force is applied. Substances with a very high viscosity such as pitch appear to behave like a solid (see pitch drop experiment) as well."}}, {"canonical_name": "shame", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "shame", "book_id": "principles_of_psychology_james_1890", "name": "shame", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["shame"], "contexts": ["feeling of humiliation or distress"]}, {"entity_id": "shame-faced", "book_id": "principles_of_psychology_james_1890", "name": "shame-faced", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["shame-faced"], "contexts": ["displaying shame"]}, {"entity_id": "shame", "book_id": "first_principles_spencer_1862", "name": "shame", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["shame"], "contexts": ["feeling of humiliation"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "shame", "target_book": "first_principles_spencer_1862", "target_name": "shame", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "shame-faced", "target_book": "first_principles_spencer_1862", "target_name": "shame", "similarity": 0.914}], "id": 1638, "stable_key": "clu_28e7cd6e53526abe", "ground_truth": {"modern_name": "Shame", "confidence": "high", "type": "concept", "note": "This cluster refers to the emotion of shame and related expressions.", "wikidata_id": "Q152282", "wikidata_description": "a self-conscious emotion associated with feelings of worthlessness or humiliation", "wikipedia_url": "https://en.wikipedia.org/wiki/Shame"}}, {"canonical_name": "hunting", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "hunting", "book_id": "principles_of_psychology_james_1890", "name": "hunting", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hunting"], "contexts": ["instinct to pursue and capture prey"]}, {"entity_id": "hunter", "book_id": "first_principles_spencer_1862", "name": "hunter", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hunter"], "contexts": ["role in early society"]}, {"entity_id": "hunting_scene", "book_id": "first_principles_spencer_1862", "name": "hunting scene", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hunting scene"], "contexts": ["subject of medieval tapestries"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "hunting", "target_book": "first_principles_spencer_1862", "target_name": "hunter", "similarity": 0.935}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hunting", "target_book": "first_principles_spencer_1862", "target_name": "hunting scene", "similarity": 0.888}], "id": 1639, "stable_key": "clu_36807f690ec361af", "ground_truth": {"modern_name": "Hunting", "confidence": "high", "type": "concept", "note": "Refers to the activity of pursuing and capturing prey, both as an instinct and a social activity."}}, {"canonical_name": "indestructible", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "indestructible", "book_id": "first_principles_spencer_1862", "name": "indestructible", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["indestructible"], "contexts": ["cannot be destroyed or eliminated", "cannot be destroyed"]}, {"entity_id": "unbrokenness", "book_id": "principles_of_psychology_james_1890", "name": "unbrokenness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["unbrokenness"], "contexts": ["lack of interruption"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "indestructible", "target_book": "principles_of_psychology_james_1890", "target_name": "unbrokenness", "similarity": 0.902}], "id": 1640, "stable_key": "clu_2d892fef418cde4c", "ground_truth": {"modern_name": "Indestructibility", "confidence": "high", "type": "concept", "note": "Refers to the quality of being impossible to destroy or eliminate.", "wikidata_id": "Q127241860", "wikidata_description": "scholarly article", "wikipedia_extract": "The Toyota Tacoma is a pickup truck manufactured by Japanese automobile manufacturer Toyota since 1995. The first-generation Tacoma (model years 1995 through 2004) was classified as a compact pickup truck; subsequent models are classified as mid-size pickup trucks. The Tacoma was Motor Trend's Truck of the Year for 2005. As of 2015, the Tacoma was sold in the United States, Canada, Mexico, Costa Rica, Bolivia, Bermuda, and the French overseas collectivity of New Caledonia. Most markets across the world receive the Toyota Hilux in lieu of the Tacoma. The name \"Tacoma\" was derived from the Coast Salish peoples' name for Mount Rainier in the U.S.", "wikipedia_url": "https://en.wikipedia.org/wiki/Toyota_Tacoma"}}, {"canonical_name": "case", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "case", "book_id": "first_principles_spencer_1862", "name": "case", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["case"], "contexts": ["grammatical function of a noun/pronoun", "marking noun conditions"]}, {"entity_id": "nominative_case", "book_id": "principles_of_psychology_james_1890", "name": "nominative case", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["nominative case"], "contexts": ["grammatical case for the subject"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "case", "target_book": "principles_of_psychology_james_1890", "target_name": "nominative case", "similarity": 0.849}], "id": 1641, "stable_key": "clu_d21d8e54a1c63e13", "ground_truth": {"modern_name": "Grammatical Case", "confidence": "high", "type": "concept", "note": "Refers to the grammatical function of nouns and pronouns, particularly the nominative case for subjects.", "wikidata_id": "Q128234", "wikidata_description": "categorization of nouns and modifiers by function", "wikipedia_extract": "In linguistics, a grammatical gender system is a specific form of a noun class system, where nouns are assigned to gender categories that are often not related to the real-world qualities of the entities denoted by those nouns. In languages with grammatical gender, most or all nouns inherently carry one value of the grammatical category called gender. The values present in a given language, of which there are usually two or three, are called the genders of that language. Determiners, adjectives, and pronouns also change their form depending on the noun to which they refer. According to one estimate, gender is used in approximately half of the world's languages. Languages with grammatical gender usually have two to four different genders, but some are attested with up to 20.", "wikipedia_url": "https://en.wikipedia.org/wiki/Grammatical_gender"}}, {"canonical_name": "Victor Jacquemont", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "victor_jacquemont", "book_id": "kosmos_humboldt_1845", "name": "Victor Jacquemont", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Victor Jacquemont"], "contexts": ["confirmed snow-line differences in Himalaya", "traveler who examined Himalaya"]}, {"entity_id": "victor_jacquemont", "book_id": "coloquios_da_orta_1563", "name": "Victor Jacquemont", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Victor Jacquemont"], "contexts": ["French traveler who found the costus plant"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Victor Jacquemont", "target_book": "coloquios_da_orta_1563", "target_name": "Victor Jacquemont", "similarity": 1.0}], "id": 1642, "stable_key": "clu_83305ee29863b1d6", "ground_truth": {"modern_name": "Victor Jacquemont", "confidence": "high", "type": "person", "birth_year": 1801, "death_year": 1832, "description": "French botanist and traveler; discovered Costus speciosus in Goa.", "note": "The text 'coloquios_da_orta_1563' is likely a misattribution or an error, as Victor Jacquemont lived much later than 1563. His association with the Costus plant is well-documented."}}, {"canonical_name": "Somma", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "somma", "book_id": "kosmos_humboldt_1845", "name": "Somma", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Somma", "somma"], "contexts": ["volcanic rock type", "mountain near Vesuvius"]}, {"entity_id": "somou", "book_id": "coloquios_da_orta_1563", "name": "Somou", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Somou"], "contexts": ["form used by Fernão Mendes Pinto"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Somma", "target_book": "coloquios_da_orta_1563", "target_name": "Somou", "similarity": 0.883}], "id": 1643, "stable_key": "clu_cb13812957027a93", "ground_truth": {"modern_name": "Somma", "confidence": "high", "type": "place", "country": "Italy", "note": "Refers to Monte Somma, a volcanic complex.", "wikidata_id": "Q1491559", "wikidata_description": "a volcanic caldera that has been partially filled by a new central cone", "wikipedia_url": "https://en.wikipedia.org/wiki/Somma_volcano", "wikipedia_extract": "Somma Vesuviana is a town and comune in the Metropolitan City of Naples, Campania, southern Italy. Before the Roman colonisation, the area of today's Somma Vesuviana was probably inhabited by Italic peoples like Samnites and Oscans. According to Strabo the city was founded by the same group of Osci who founded Herculaneum and who called the city Sommax. The city was founded by a group of plebeians led by Tiberius Gracchus who called the city \"Saxo Tribunum\" (city of the plebeians). Later it became a resort for rich patricians from Rome and other rich estate owners who built magnificent villas in the area. Excavations have shown that this north side of the Vesuvius volcano was equally as populated as the southern side where Pompeii and Herculaneum lie, but has not been paid as much attention by historians."}}, {"canonical_name": "Kordofan", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "kordofan", "book_id": "kosmos_humboldt_1845", "name": "Kordofan", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Kordofan"], "contexts": ["region with volcanoes", "region where volcanoes are discussed"]}, {"entity_id": "kordofan", "book_id": "coloquios_da_orta_1563", "name": "Kordofan", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Kordofan"], "contexts": ["geographic location"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Kordofan", "target_book": "coloquios_da_orta_1563", "target_name": "Kordofan", "similarity": 1.0}], "id": 1644, "stable_key": "clu_ccac792ce4237a29", "ground_truth": {"modern_name": "Kordofan", "confidence": "high", "type": "place", "country": "Sudan", "wikidata_id": "Q2044659", "wikidata_description": "subspecies of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Kordofan%20giraffe", "wikipedia_extract": "Kordofan (Arabic: كردفان Kurdufān) is a former province of central Sudan. In 1994 it was divided into three new federal states: North Kordofan, South Kordofan and West Kordofan. In August 2005, West Kordofan State was abolished and its territory divided between North and South Kordofan States, as part of the implementation of the Comprehensive Peace Agreement between the Government of Sudan and the Sudan People's Liberation Movement. West Kordofan was reestablished in July 2013. Kordofan covers an area of some 376,145 km2 (146,932 miles²), with an estimated population in 2000 of 3.6 million (3 million in 1983). It is largely an undulating plain, with the Nuba Mountains in the southeast quarter."}}, {"canonical_name": "eleolite", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "eleolite", "book_id": "kosmos_humboldt_1845", "name": "eleolite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["eleolite"], "contexts": ["mineral related to nepheline", "mineral, identity with nepheline"]}, {"entity_id": "iolite", "book_id": "coloquios_da_orta_1563", "name": "iolite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["iolite"], "contexts": ["gemstone"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "eleolite", "target_book": "coloquios_da_orta_1563", "target_name": "iolite", "similarity": 0.871}], "id": 1645, "stable_key": "clu_fae98c436b478ece", "ground_truth": {"modern_name": "Eleolite", "confidence": "high", "type": "mineral", "note": "Also known as 'iolite', it's a variety of nepheline.", "wikidata_id": "Q60677224", "wikidata_description": "scholarly article", "wikipedia_extract": "The Red Hill Syenite (\"Red Hill Syenitic Complex\", \"Red Hill Alkaline Igneous Complex\", \"Red Hill Intrusion\", or \"Red Hill Layered syenitic complex\") is a layered igneous rock complex in central New Hampshire, about 20 mi (32 km) east of Plymouth. The Red Hill Syenite is part of the White Mountain magma series, which underlays the White Mountains of New Hampshire. Red Hill is roughly oval-shaped, covers just under 7.7 square miles (20 km2), and has a summit elevation of 2,028 feet (618 m). The complex is made of six distinct units, the order of intrusion of which was determined by cross-cutting relationships. The units are, in order from oldest to youngest, the Outer Coarse Syenite, the Nepheline Sodalite Syenite, the Fire Tower Syenite, the Garland Peak Syenite, the Watson Ledge Quartz Syenite, and the Interior Fine Granite. The rock complex is between 197-199 million years old, dated to the Early Jurassic epoch, making it one of the oldest sections of the White Mountain magma series.", "wikipedia_url": "https://en.wikipedia.org/wiki/Red_Hill_Syenite"}}, {"canonical_name": "Silhet", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "silhet", "book_id": "coloquios_da_orta_1563", "name": "Silhet", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Silhet"], "contexts": ["region near Khasya mountains", "valleys, habitat of tree"]}, {"entity_id": "silhet", "book_id": "kosmos_humboldt_1845", "name": "Silhet", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Silhet"], "contexts": ["mountains near Calcutta"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Silhet", "target_book": "kosmos_humboldt_1845", "target_name": "Silhet", "similarity": 1.0}], "id": 1646, "stable_key": "clu_783168ada3d1f231", "ground_truth": {"modern_name": "Sylhet", "confidence": "high", "type": "place", "country": "Bangladesh", "note": "Region historically associated with the Khasi Hills.", "wikipedia_extract": "The Sylhet Shahi Eidgah (Bengali: সিলেট শাহী ঈদগাহ), or simply Shahi Eidgah, is an open prayer hall situated in Sylhet, north-east Bangladesh, three kilometers to the north-east of the guru nanak international circuit house, meant for the Eid prayers. It is also one of the most visited tourist spots in the city. As well as for prayer uses and Islamic congregations, the eidgah has historically been a place to give speeches and host rallies by the likes of Mohandas Gandhi and Muhammad Ali Jinnah. There have also been battles taken place there such as the Muharram Rebellion. During the rule of Mughal emperor Aurangzeb, Farhad Khan was appointed as the faujdar of Sylhet. Farhad Khan supervised the construction of the Shahi Eidgah on a hill in the 17th century.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sylhet_Shahi_Eidgah"}}, {"canonical_name": "Vindya", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "vindya", "book_id": "coloquios_da_orta_1563", "name": "Vindya", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Vindya", "Vindhya"], "contexts": ["mountain range where Mandú was situated", "mountain range in India"]}, {"entity_id": "vindhya", "book_id": "kosmos_humboldt_1845", "name": "Vindhya", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Vindhya"], "contexts": ["smaller mountain range"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Vindya", "target_book": "kosmos_humboldt_1845", "target_name": "Vindhya", "similarity": 0.928}], "id": 1647, "stable_key": "clu_20374ce31e9e9ca6", "ground_truth": {"modern_name": "Vindhya Range", "confidence": "high", "type": "place", "country": "India", "wikidata_id": "Q271435", "wikidata_description": "Mountain Range in central India", "wikipedia_url": "https://en.wikipedia.org/wiki/Vindhya_Range"}}, {"canonical_name": "ornatos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ornatos", "book_id": "coloquios_da_orta_1563", "name": "ornatos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["ornatos"], "contexts": ["made with flowers", "decorative items"]}, {"entity_id": "ornament", "book_id": "kosmos_humboldt_1845", "name": "ornament", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ornament"], "contexts": ["primary meaning of 'mundus'"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "ornatos", "target_book": "kosmos_humboldt_1845", "target_name": "ornament", "similarity": 0.924}], "id": 1648, "stable_key": "clu_fc0f9001f6b80de7", "ground_truth": {"modern_name": "ornaments", "confidence": "high", "type": "concept", "note": "The context 'made with flowers' and 'mundus' (world/adornment) suggests decorative elements.", "wikidata_id": "Q49391", "wikidata_description": "Genus of flowering plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Allium"}}, {"canonical_name": "espinhela", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "espinhela", "book_id": "coloquios_da_orta_1563", "name": "espinhela", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["espinhela", "espinela"], "contexts": ["a type of ruby, reddish", "mineral species"]}, {"entity_id": "spinellane", "book_id": "kosmos_humboldt_1845", "name": "spinellane", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["spinellane"], "contexts": ["mineral ejected from crater"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "espinhela", "target_book": "kosmos_humboldt_1845", "target_name": "spinellane", "similarity": 0.862}], "id": 1649, "stable_key": "clu_0790f735fa20698a", "ground_truth": {"modern_name": "Spinel", "confidence": "high", "type": "mineral", "note": "Early modern texts often used 'espinhela' or 'spinellane' to refer to spinel, a gemstone.", "wikidata_id": "Q191310", "wikidata_description": "oxide mineral", "wikipedia_url": "https://en.wikipedia.org/wiki/Spinel"}}, {"canonical_name": "Nisyros", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "nisyros", "book_id": "kosmos_humboldt_1845", "name": "Nisyros", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Nisyros"], "contexts": ["Greek island with a crater", "island in the Aegean Sea"]}, {"entity_id": "nysiro", "book_id": "ricettario_fiorentino_1597", "name": "Nysiro", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Nysiro"], "contexts": ["island where Aspalatho grows"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Nisyros", "target_book": "ricettario_fiorentino_1597", "target_name": "Nysiro", "similarity": 0.857}], "id": 1650, "stable_key": "clu_9f76479921b67647", "ground_truth": {"modern_name": "Nisyros", "confidence": "high", "type": "place", "country": "Greece", "wikidata_id": "Q767528", "wikidata_description": "island in Greece", "wikipedia_extract": "Nisyros, also spelled Nisiros (Greek: Νίσυρος, romanized: Nísyros; Modern Greek pronunciation: [ˈnisiros]), is a volcanic Greek island and municipality located in the Aegean Sea. It is part of the Dodecanese group of islands, situated between the islands of Kos and Tilos. Its shape is approximately round, with a diameter of about 8 km (5 mi), and an area of 41.6 km2 (16.062 sq mi). Several other islets are in the direct vicinity of Nisyros, the largest of which is Gyali, with a population of 22 citizens. The Municipality of Nisyros includes Gyalí, as well as uninhabited Pacheiá, Pergoússa, Kandelioussa, Ágios Antónios, and Strongýli. It has a total land area of 50.055 km2 (19.326 sq mi) and a total population of 1,048 inhabitants (2021).", "wikipedia_url": "https://en.wikipedia.org/wiki/Nisyros"}}, {"canonical_name": "Macedonia", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "macedonia", "book_id": "kosmos_humboldt_1845", "name": "Macedonia", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Macedonia"], "contexts": ["region where Aristotle observed red snow", "region where snow was observed"]}, {"entity_id": "macedonia", "book_id": "ricettario_fiorentino_1597", "name": "Macedonia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Macedonia"], "contexts": ["place where borrace is found"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Macedonia", "target_book": "ricettario_fiorentino_1597", "target_name": "Macedonia", "similarity": 0.86}], "id": 1651, "stable_key": "clu_f2bc0086a5f1bf29", "ground_truth": {"wikipedia_extract": "Ciacova (Hungarian: Csák; German: Tschakowa; Serbian: Чаково, romanized: Čakovo; Turkish: Çakova) is a town in Timiș County, Romania. It administers four villages: Cebza, Macedonia, Obad and Petroman. When it was declared a town in 2004, the villages of Gad and Ghilad, which it administered up to that point, were split off to form Ghilad commune. In both Romanian and Hungarian vocabularies, there are the names ceacău (in Romanian), csákó (in Hungarian) and csák (in Old Hungarian): ceacău, meaning \"tall and hard military cap made of leather or felt\"; it was used until the end of World War II by hunting and targeting troops, then only by police troops. It is therefore possible that Ciacova got its name from this word and meant a locality around a defense post. csák, meaning \"peak\". Accepting this translation, the Ciacova Fortress is explained as a \"peak of defense\" against any enemy intervention from the east or southeast."}}, {"canonical_name": "Firdusi", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "firdusi", "book_id": "kosmos_humboldt_1845", "name": "Firdusi", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Firdusi"], "contexts": ["Persian poet", "author of Schahnameh"]}, {"entity_id": "fidecius", "book_id": "polyanthea_medicinal", "name": "Fidecius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Fidecius"], "contexts": ["ancient medical authority"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Firdusi", "target_book": "polyanthea_medicinal", "target_name": "Fidecius", "similarity": 0.853}], "id": 1652, "stable_key": "clu_982a270bcc38a38c", "ground_truth": {"modern_name": "Ferdowsi", "confidence": "high", "type": "person", "birth_year": 940, "death_year": 1020, "description": "Persian poet, author of the Shahnameh, invoked as an authority.", "note": "The spelling variation 'Fidecius' is likely a misreading or Latinization of Firdusi.", "wikidata_id": "Q43459", "wikidata_description": "Persian poet, author of Shahnameh (940–1020)", "wikipedia_url": "https://en.wikipedia.org/wiki/Ferdowsi"}}, {"canonical_name": "Euripides", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "euripides", "book_id": "kosmos_humboldt_1845", "name": "Euripides", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Euripides"], "contexts": ["ancient Greek playwright"]}, {"entity_id": "euripedes", "book_id": "polyanthea_medicinal", "name": "Euripedes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Euripedes"], "contexts": ["ancient Greek physician"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Euripides", "target_book": "polyanthea_medicinal", "target_name": "Euripedes", "similarity": 0.945}], "id": 1653, "stable_key": "clu_b89d3ae19214f95e", "ground_truth": {"modern_name": "Euripides", "confidence": "high", "type": "person", "birth_year": -480, "death_year": -406, "description": "Ancient Greek tragedian, sometimes misattributed as a physician.", "note": "While primarily known as a playwright, the context 'ancient Greek physician' suggests a potential conflation or erroneous reference in some texts.", "wikidata_id": "Q48305", "wikidata_description": "Classical Athenian playwright", "wikipedia_url": "https://en.wikipedia.org/wiki/Euripides", "wikipedia_extract": "Euripides (; Ancient Greek: Eὐριπίδης, romanized: Eurīpídēs, pronounced [eu̯.riː.pí.dɛːs]; c. 480 – c. 406 BC) was a Greek tragedian of classical Athens. Along with Aeschylus and Sophocles, he is one of the three authors of Greek tragedy for whom any plays have survived in full. Some ancient scholars attributed ninety-five plays to him, but the Suda says it was ninety-two at most. Nineteen plays attributed to Euripides have survived more or less complete, although one of these (Rhesus) is often considered not to be genuinely his work."}}, {"canonical_name": "dew", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "dew", "book_id": "kosmos_humboldt_1845", "name": "dew", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["dew", "Dew"], "contexts": ["consequence of radiation", "water condensed on surfaces"]}, {"entity_id": "deposition_of_dew", "book_id": "connexion_physical_sciences_somerville_1858", "name": "deposition of dew", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["deposition of dew"], "contexts": ["formation of dew on surfaces"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "dew", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "deposition of dew", "similarity": 0.864}], "id": 1654, "stable_key": "clu_ae7969227c458dfc", "ground_truth": {"modern_name": "Dew", "confidence": "high", "type": "concept", "wikidata_id": "Q48183", "wikidata_description": "German-language edition of Wikipedia", "wikipedia_url": "https://en.wikipedia.org/wiki/Hygrometer", "wikipedia_extract": "A hygrometer is an instrument that measures humidity: that is, how much water vapor is present. Humidity measurement instruments usually rely on measurements of some other quantities, such as temperature, pressure, mass, and mechanical or electrical changes in a substance as moisture is absorbed. By calibration and calculation, these measured quantities can be used to indicate the humidity. Modern electronic devices use the temperature of condensation (called the dew point), or they sense changes in electrical capacitance or resistance. The maximum amount of water vapor that can be present in a given volume (at saturation) varies greatly with temperature; at low temperatures a lower mass of water per unit volume can remain as vapor than at high temperatures. Thus a change in the temperature changes the relative humidity."}}, {"canonical_name": "Dunkirk", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "dunkirk", "book_id": "kosmos_humboldt_1845", "name": "Dunkirk", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Dunkirk"], "contexts": ["location of pendulum observations", "location for hemisphere comparison"]}, {"entity_id": "dunkirk", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Dunkirk", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Dunkirk"], "contexts": ["northern French city"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Dunkirk", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Dunkirk", "similarity": 1.0}], "id": 1655, "stable_key": "clu_9cbafe6044cef123", "ground_truth": {"modern_name": "Dunkirk", "confidence": "high", "type": "place", "country": "France", "wikipedia_extract": "Dunkirk (UK:  dun-KURK; US:  DUN-kurk; French: Dunkerque [dœ̃kɛʁk] ; Picard: Dunkèke; West Flemish: Duunkerke; Dutch: Duinkerke or Duinkerken) is a major port city in the department of Nord in northern France. It lies on the North Sea, 10 kilometres (6.2 mi) from the Belgian border. It has the third-largest French harbour. The population of the commune in 2019 was 86,279. The name of Dunkirk derives from West Flemish dun(e) 'dune' or 'dun' and kerke 'church', thus 'church in the dunes'. A smaller town 25 km (15 miles) farther up the Flemish coast originally shared the same name, but it was later renamed Oostduinkerke ('East Dunkirk') in order to avoid confusion.", "wikipedia_url": "https://en.wikipedia.org/wiki/Dunkirk"}}, {"canonical_name": "discharge", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "discharge", "book_id": "kosmos_humboldt_1845", "name": "discharge", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["discharge"], "contexts": ["release of energy", "release of electrical energy"]}, {"entity_id": "discharge", "book_id": "connexion_physical_sciences_somerville_1858", "name": "discharge", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["discharge"], "contexts": ["takes place when tension is great enough"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "discharge", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "discharge", "similarity": 1.0}], "id": 1656, "stable_key": "clu_8f3cb0cabaa50018", "ground_truth": {"modern_name": "Electrical discharge", "confidence": "high", "type": "concept", "note": "The context 'release of energy' and 'tension is great enough' strongly points to an electrical phenomenon.", "wikidata_id": "Q577484", "wikidata_description": "metal fabrication process whereby a desired shape is obtained by using electrical discharges to remove material", "wikipedia_extract": "In electronics, electrical breakdown or dielectric breakdown is a process that occurs when an electrically insulating material (a dielectric), subjected to a high enough voltage, suddenly becomes a conductor and current flows through it. All insulating materials undergo breakdown when the electric field caused by an applied voltage exceeds the material's dielectric strength. The voltage at which a given insulating object becomes conductive is called its breakdown voltage and, in addition to its dielectric strength, depends on its size and shape, and the location on the object at which the voltage is applied. Under sufficient voltage, electrical breakdown can occur within solids, liquids, or gases (and theoretically even in a vacuum). However, the specific breakdown mechanisms are different for each kind of dielectric medium. Electrical breakdown may be a momentary event (as in an electrostatic discharge), or may lead to a continuous electric arc if protective devices fail to interrupt the current in a power circuit.", "wikipedia_url": "https://en.wikipedia.org/wiki/Electrical_discharge_machining"}}, {"canonical_name": "fogs", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "fogs", "book_id": "kosmos_humboldt_1845", "name": "fogs", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["fogs"], "contexts": ["visible atmospheric moisture", "weather phenomenon"]}, {"entity_id": "fogs", "book_id": "connexion_physical_sciences_somerville_1858", "name": "fogs", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["fogs"], "contexts": ["cloud at ground level"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "fogs", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fogs", "similarity": 1.0}], "id": 1657, "stable_key": "clu_0b9775ae4a20aa21", "ground_truth": {"modern_name": "Fog", "confidence": "high", "type": "concept", "note": "The entry lists 'fogs' as a disease. This is likely a metaphorical or erroneous categorization, with 'fog' itself being the referent.", "wikidata_id": "Q1431308", "wikidata_description": "airport serving Foggia, Italy", "wikipedia_extract": "Fog is a visible aerosol consisting of tiny water droplets or ice crystals held in the air  near the Earth's surface. Fog can be considered a type of low-lying cloud usually resembling stratus and is heavily influenced by nearby bodies of water, topography, and wind conditions. In turn, fog affects many human activities, such as shipping, travel, and warfare. Fog appears when water vapor (water in its gaseous form) condenses. During condensation, molecules of water vapor combine to make tiny water droplets that hang in the air. Sea fog, which shows up near bodies of saline water, is formed as water vapor condenses on bits of salt.", "wikipedia_url": "https://en.wikipedia.org/wiki/Fog"}}, {"canonical_name": "Vulpicula", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "vulpicula", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Vulpicula", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Vulpicula"], "contexts": ["constellation containing dumb-bell nebula", "constellation containing nebula"]}, {"entity_id": "vulpis", "book_id": "kosmos_humboldt_1845", "name": "Vulpis", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Vulpis"], "contexts": ["constellation with similar phenomenon"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Vulpicula", "target_book": "kosmos_humboldt_1845", "target_name": "Vulpis", "similarity": 0.924}], "id": 1658, "stable_key": "clu_14e252196578f616", "ground_truth": {"modern_name": "Vulpecula", "confidence": "high", "type": "place", "country": "Unknown", "note": "Vulpis is the Latin word for fox, and Vulpecula is a constellation named after a small fox. The context 'constellation containing dumb-bell nebula' confirms this.", "wikidata_id": "Q10519", "wikidata_description": "constellation in the northern celestial hemisphere", "wikipedia_extract": "Vulpecula () is a faint constellation in the Northern Sky. Its name is Latin for \"little fox\", although it is commonly called simply the Fox. It was identified in the 17th century, and is located in the middle of the Summer Triangle (an asterism consisting of the bright stars Deneb, Vega, and Altair). There are no stars brighter than 4th magnitude in this constellation. The brightest star in Vulpecula is Alpha Vulpeculae, a magnitude 4.44m red giant at an approximate distance of 291 light-years. The star is an optical binary (separation of 413.7\") that can be split using binoculars."}}, {"canonical_name": "Formentera", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "formentera", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Formentera", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Formentera"], "contexts": ["southern Balearic Island", "location for meridian measurement"]}, {"entity_id": "formentera", "book_id": "kosmos_humboldt_1845", "name": "Formentera", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Formentera"], "contexts": ["location of pendulum observations"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Formentera", "target_book": "kosmos_humboldt_1845", "target_name": "Formentera", "similarity": 1.0}], "id": 1659, "stable_key": "clu_9b3bdfb0680415e0", "ground_truth": {"modern_name": "Formentera", "confidence": "high", "type": "place", "country": "Spain", "wikidata_id": "Q52626", "wikidata_description": "municipality of Baleares, Spain, containing the island of the same name", "wikipedia_extract": "Formentera (Balearic Catalan: [fuɾmənˈteɾə], Spanish: [foɾmenˈteɾa]) is a Spanish island located in the Mediterranean Sea, which belongs to the Balearic Islands autonomous community together with Mallorca, Menorca, and Ibiza. Formentera is the smallest and most southerly island of the Pityusic Islands group (comprising Ibiza and Formentera itself, as well as various small islets). It covers an area of 83.24 square kilometres (32.14 sq mi), including offshore islets. At the 2011 Census, the population was 10,583; according to the Census of 1 January 2021, it counted 11,891 inhabitants, while the official estimate at 1 January 2023 was 11,389. The island's name is said to derive from the Latin word frumentarium, meaning \"granary\". The island was occupied in prehistoric times, going back to 2,000–1,600 BC.", "wikipedia_url": "https://en.wikipedia.org/wiki/Formentera"}}, {"canonical_name": "Mariner’s compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mariner’s_compass", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mariner’s compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["Mariner’s compass", "mariner’s compass"], "contexts": ["navigational instrument using a magnetic needle", "navigational instrument"]}, {"entity_id": "mariner's_compass", "book_id": "kosmos_humboldt_1845", "name": "mariner's compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["mariner's compass"], "contexts": ["navigational instrument"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Mariner’s compass", "target_book": "kosmos_humboldt_1845", "target_name": "mariner's compass", "similarity": 0.978}], "id": 1660, "stable_key": "clu_32be2baa382d877a", "ground_truth": {"modern_name": "Mariner's compass", "confidence": "high", "type": "object", "wikidata_id": "Q7908138", "wikidata_description": "1989 Malayalam black comedy film directed by Sreenivasan", "wikipedia_url": "https://en.wikipedia.org/wiki/Vadakkunokkiyantram", "wikipedia_extract": "A compass is a device that shows the cardinal directions used for navigation and geographic orientation. It typically consists of a magnetized needle or another element, such as a compass card or compass rose, that pivots to align itself with magnetic north. Other methods may be used, including gyroscopes, magnetometers, and GPS receivers. Compasses often show angles in degrees: north corresponds to 0°, and the angles increase clockwise, so east is 90°, south is 180°, and west is 270°. These numbers allow the compass to show azimuths or bearings which are commonly stated in degrees. If local variation between magnetic north and true north is known, then direction of magnetic north also gives direction of true north."}}, {"canonical_name": "Observatory", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "observatory", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Observatory", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "count": 2, "variants": ["observatory", "Observatory"], "contexts": ["building for astronomical observation", "scientific observation institution"]}, {"entity_id": "observatory", "book_id": "kosmos_humboldt_1845", "name": "Observatory", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "count": 1, "variants": ["Observatory"], "contexts": ["place for astronomical observations"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Observatory", "target_book": "kosmos_humboldt_1845", "target_name": "Observatory", "similarity": 1.0}], "id": 1661, "stable_key": "clu_c3380af3a14d6dff", "ground_truth": {"modern_name": "Observatory", "confidence": "high", "type": "place", "wikidata_id": "Q62832", "wikidata_description": "location used for observing terrestrial or celestial events", "wikipedia_url": "https://en.wikipedia.org/wiki/Observatory", "wikipedia_extract": "Paranal Observatory is an astronomical observatory operated by the European Southern Observatory (ESO). It is located in the Atacama Desert of Northern Chile on Cerro Paranal at 2,635 m (8,645 ft) altitude, 120 km (70 mi) south of Antofagasta. By total light-collecting area, it is the largest optical-infrared observatory in the Southern Hemisphere; worldwide, it is second to the Mauna Kea Observatory on Hawaii. The Very Large Telescope (VLT), the largest telescope on Paranal, is composed of four separate 8.2 m (320 in) telescopes. In addition, the four main telescopes can be used simultaneously for extra light gathering capacity, and for interferometry. Four auxiliary telescopes of 1.8 m (71 in) each are also part of the VLTI to make it available when the main telescopes are being used for other projects."}}, {"canonical_name": "Chaudes Aigues", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "chaudes_aigues", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Chaudes Aigues", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Chaudes Aigues"], "contexts": ["location of a thermal spring", "location with a specific temperature"]}, {"entity_id": "chaudes_aigues", "book_id": "kosmos_humboldt_1845", "name": "Chaudes Aigues", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Chaudes Aigues"], "contexts": ["location of a hot spring"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Chaudes Aigues", "target_book": "kosmos_humboldt_1845", "target_name": "Chaudes Aigues", "similarity": 1.0}], "id": 1662, "stable_key": "clu_4342fba4380b3528", "ground_truth": {"modern_name": "Chaudes-Aigues", "confidence": "high", "type": "place", "country": "France", "wikidata_id": "Q269112", "wikidata_description": "commune in Cantal, France", "wikipedia_url": "https://en.wikipedia.org/wiki/Chaudes-Aigues"}}, {"canonical_name": "Seleniate of zinc", "category": "SUBSTANCE", "subcategory": "CHEMICAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "seleniate_of_zinc", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Seleniate of zinc", "category": "SUBSTANCE", "subcategory": "CHEMICAL", "count": 2, "variants": ["Seleniate of zinc"], "contexts": ["substance crystallising with water", "crystals of"]}, {"entity_id": "selenium", "book_id": "kosmos_humboldt_1845", "name": "selenium", "category": "SUBSTANCE", "subcategory": "CHEMICAL", "count": 1, "variants": ["selenium"], "contexts": ["element discovered in volcano crater"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Seleniate of zinc", "target_book": "kosmos_humboldt_1845", "target_name": "selenium", "similarity": 0.872}], "id": 1663, "stable_key": "clu_56fe9f5bbe1320db", "ground_truth": {"modern_name": "Zinc selenate", "confidence": "high", "type": "chemical", "note": "The text mentions 'Seleniate of zinc' and 'selenium'. Zinc selenate is a compound of selenium and zinc.", "wikidata_id": "Q17134166", "wikidata_description": "chemical compound", "wikipedia_extract": "This is a list of common chemical compounds with chemical formulae and CAS numbers, indexed by formula. This complements alternative listing at list of inorganic compounds.", "wikipedia_url": "https://en.wikipedia.org/wiki/Glossary_of_chemical_formulae"}}, {"canonical_name": "St. Malo", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "st__malo", "book_id": "kosmos_humboldt_1845", "name": "St. Malo", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["St. Malo"], "contexts": ["location with high tides"]}, {"entity_id": "st__malo", "book_id": "connexion_physical_sciences_somerville_1858", "name": "St. Malo", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["St. Malo"], "contexts": ["coastal city in France with high tides"]}, {"entity_id": "malo,_st_", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Malo, St.", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Malo, St."], "contexts": ["location of tide observation"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "St. Malo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "St. Malo", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "St. Malo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Malo, St.", "similarity": 0.847}], "id": 1664, "stable_key": "clu_06a033a337e05e87", "ground_truth": {"modern_name": "Saint-Malo", "confidence": "high", "type": "place", "country": "France", "wikidata_id": "Q163108", "wikidata_description": "commune in Ille-et-Vilaine, France", "wikipedia_url": "https://en.wikipedia.org/wiki/Saint-Malo"}}, {"canonical_name": "Insulation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "insulation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Insulation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Insulation", "insulation"], "contexts": ["prevention of electrical current flow", "in electricity"]}, {"entity_id": "insularity", "book_id": "kosmos_humboldt_1845", "name": "insularity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["insularity"], "contexts": ["climate characteristic"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Insulation", "target_book": "kosmos_humboldt_1845", "target_name": "insularity", "similarity": 0.84}], "id": 1665, "stable_key": "clu_e643000af72fbc2d", "ground_truth": {"modern_name": "Insulation", "confidence": "high", "type": "concept", "note": "The contexts refer to both electrical insulation and geographical/climatic insularity, indicating a broader meaning of isolation.", "wikidata_id": "Q12767712", "wikidata_description": "substance that does not transmit certain forms of energy, such as heat (thermal insulator), sound (acoustic insulator) or electricity (electrical insulator)", "wikipedia_url": "https://fr.wikipedia.org/wiki/Isolant"}}, {"canonical_name": "naphtha", "category": "SUBSTANCE", "subcategory": "CHEMICAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "naphtha", "book_id": "kosmos_humboldt_1845", "name": "naphtha", "category": "SUBSTANCE", "subcategory": "CHEMICAL", "count": 2, "variants": ["naphtha"], "contexts": ["substance mixed with hydrogen gas", "flammable liquid mixed with hydrogen"]}, {"entity_id": "coal-naphtha", "book_id": "first_principles_spencer_1862", "name": "coal-naphtha", "category": "SUBSTANCE", "subcategory": "CHEMICAL", "count": 1, "variants": ["coal-naphtha"], "contexts": ["volatile liquid for dissolving shell-lac"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "naphtha", "target_book": "first_principles_spencer_1862", "target_name": "coal-naphtha", "similarity": 0.847}], "id": 1666, "stable_key": "clu_f8ac07d903b523bc", "ground_truth": {"modern_name": "Naphtha", "confidence": "high", "type": "chemical", "wikidata_id": "Q179724", "wikidata_description": "chemical compound", "wikipedia_extract": "Turpentine (which is also called spirit of turpentine, oil of turpentine, terebenthine, terebenthene, terebinthine and, colloquially, turps) is a fluid obtainable by the distillation of resin harvested from living trees, mainly pines. Principally used as a specialized solvent, it is also a source of material for organic syntheses. Turpentine is composed of terpenes, primarily the monoterpenes α-pinene and β-pinene, with lesser amounts of carene, camphene, limonene, and terpinolene. Nowadays, turpentine is rarely the product of distillation of pine resin, but is a byproduct of pulping. Pulping is achieved by two processes, the Kraft process and the sulfite process. The turpentines obtained from these two processes differ in their chemical compositions.", "wikipedia_url": "https://en.wikipedia.org/wiki/Naphthalene"}}, {"canonical_name": "Roman", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "roman", "book_id": "kosmos_humboldt_1845", "name": "Roman", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Roman"], "contexts": ["referring to ancient adage", "writers who used the word 'cosmos'"]}, {"entity_id": "romans", "book_id": "first_principles_spencer_1862", "name": "Romans", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Romans"], "contexts": ["people with sacred dances"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Roman", "target_book": "first_principles_spencer_1862", "target_name": "Romans", "similarity": 0.979}], "id": 1667, "stable_key": "clu_3f91b6c0a2714fdc", "ground_truth": {"modern_name": "Roman", "confidence": "high", "type": "concept", "note": "The context 'referring to ancient adage' strongly suggests a reference to ancient Roman culture or history.", "wikidata_id": "Q1747689", "wikidata_description": "country that began growing on the Italian Peninsula from the 8th century BC"}}, {"canonical_name": "digestive organs", "category": "ANATOMY", "subcategory": "ORGAN", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "digestive_organs", "book_id": "kosmos_humboldt_1845", "name": "digestive organs", "category": "ANATOMY", "subcategory": "ORGAN", "count": 1, "variants": ["digestive organs"], "contexts": ["organs for processing food"]}, {"entity_id": "digestive_apparatus", "book_id": "first_principles_spencer_1862", "name": "digestive apparatus", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["digestive apparatus"], "contexts": ["for reducing materials for assimilation"]}, {"entity_id": "digestive_organs", "book_id": "first_principles_spencer_1862", "name": "digestive organs", "category": "ANATOMY", "subcategory": "ORGAN", "count": 1, "variants": ["digestive organs"], "contexts": ["organs involved in digestion"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "digestive organs", "target_book": "first_principles_spencer_1862", "target_name": "digestive apparatus", "similarity": 0.847}, {"source_book": "kosmos_humboldt_1845", "source_name": "digestive organs", "target_book": "first_principles_spencer_1862", "target_name": "digestive organs", "similarity": 1.0}], "id": 1668, "stable_key": "clu_86d2ce71ac1beb3e", "ground_truth": {"modern_name": "digestive system", "confidence": "high", "type": "concept", "wikidata_id": "Q2300099", "wikidata_description": "disease involving the gastrointestinal tract", "wikipedia_url": "https://en.wikipedia.org/wiki/Human_anatomy", "wikipedia_extract": "Human anatomy (gr. ἀνατομία, \"dissection\", from ἀνά, \"up\", and τέμνειν, \"cut\") is primarily the scientific study of the morphology of the human body. Anatomy is subdivided into gross anatomy and microscopic anatomy. Gross anatomy (also called macroscopic anatomy, topographical anatomy, regional anatomy, or anthropotomy) is the study of anatomical structures that can be seen by the naked eye. Microscopic anatomy is the study of minute anatomical structures assisted with microscopes, which includes histology (the study of the organization of tissues), and cytology (the study of cells). Anatomy, human physiology (the study of function), and biochemistry (the study of the chemistry of living structures) are complementary basic medical sciences that are generally together (or in tandem) to students studying medical sciences."}}, {"canonical_name": "mercurial column", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mercurial_column", "book_id": "first_principles_spencer_1862", "name": "mercurial column", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["mercurial column"], "contexts": ["column of mercury in a thermometer"]}, {"entity_id": "mercurial_column", "book_id": "kosmos_humboldt_1845", "name": "mercurial column", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["mercurial column"], "contexts": ["column of mercury in a barometer"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "mercurial column", "target_book": "kosmos_humboldt_1845", "target_name": "mercurial column", "similarity": 1.0}], "id": 1669, "stable_key": "clu_a21cf0d410b3efd7", "ground_truth": {"modern_name": "mercury column", "confidence": "high", "type": "concept", "note": "Refers to the column of mercury in scientific instruments like thermometers and barometers."}}, {"canonical_name": "xaraut violado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "xaraut_violado", "book_id": "historia_medicinal_monardes_1574", "name": "xaraut violado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["xaraut violado", "xaraué violado"], "contexts": ["sweetened preparation added to decoction", "violet syrup, mixed with powders"]}, {"entity_id": "xaro-pe_violado", "book_id": "coloquios_da_orta_1563", "name": "xaro-pe violado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["xaro-pe violado"], "contexts": ["syrup made from violets"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "xaraut violado", "target_book": "coloquios_da_orta_1563", "target_name": "xaro-pe violado", "similarity": 0.88}], "id": 1670, "stable_key": "clu_135f30f44a49271b", "ground_truth": {"modern_name": "syrup of violets", "confidence": "high", "type": "plant", "linnaean": "Viola odorata", "family": "Violaceae"}}, {"canonical_name": "Bolarmeníco", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "bolarmeníco", "book_id": "historia_medicinal_monardes_1574", "name": "Bolarmeníco", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Bolarmeníco", "Bolarmenico"], "contexts": ["earth substance, Terra lemnía", "prepared substance, likely arsenic"]}, {"entity_id": "bolarmenico", "book_id": "coloquios_da_orta_1563", "name": "bolarmenico", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["bolarmenico"], "contexts": ["earth used for comparison"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Bolarmeníco", "target_book": "coloquios_da_orta_1563", "target_name": "bolarmenico", "similarity": 0.964}], "id": 1671, "stable_key": "clu_4aa22359dc944442", "ground_truth": {"modern_name": "bolarménico", "confidence": "high", "type": "mineral", "note": "A terrestrial substance, likely a type of ochre or Bole, used medicinally. Related to Terra Lemnia."}}, {"canonical_name": "partoperigoso", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "partoperigoso", "book_id": "polyanthea_medicinal", "name": "partoperigoso", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["partoperigoso", "partosperigofos"], "contexts": ["dangerous childbirth", "dangerous childbirths"]}, {"entity_id": "parto", "book_id": "coloquios_da_orta_1563", "name": "parto", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["parto"], "contexts": ["childbirth"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "partoperigoso", "target_book": "coloquios_da_orta_1563", "target_name": "parto", "similarity": 0.88}], "id": 1672, "stable_key": "clu_3867d4d1d2c5e9e5", "ground_truth": {"modern_name": "dangerous childbirth", "confidence": "high", "type": "disease", "modern_term": "obstructed labor"}}, {"canonical_name": "Nifperos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "nifperos", "book_id": "historia_medicinal_monardes_1574", "name": "Nifperos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Nifperos", "nisperos"], "contexts": ["fruit size comparison", "seed like nisperos seed"]}, {"entity_id": "nenufaro", "book_id": "ricettario_fiorentino_1597", "name": "nenufaro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["nenufaro"], "contexts": ["herb that is too tender and humid"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Nifperos", "target_book": "ricettario_fiorentino_1597", "target_name": "nenufaro", "similarity": 0.854}], "id": 1673, "stable_key": "clu_148f60779e13789a", "ground_truth": {"modern_name": "Níspero", "confidence": "medium", "type": "plant", "linnaean": "Mespilus germanica", "family": "Rosaceae", "note": "The texts mention both 'Nifperos' (Spanish for loquats or medlars) and 'nenufaro' (water lily). Given the context of comparison, 'Níspero' (medlar) is more likely for fruit size comparison, while 'nenufaro' fits the description of tenderness. The primary context points towards Medlars, but the secondary mention of water lily adds ambiguity.", "wikidata_id": "Q87273268", "wikidata_description": "genus of plants", "wikipedia_extract": "The loquat (Eriobotrya japonica, Chinese: 枇杷; Pinyin: pípá) is a large evergreen shrub or tree grown commercially for its orange coloured fruits. It is also cultivated as an ornamental plant. The loquat is in the family Rosaceae, subfamily Spiraeoideae, tribe Pyreae, subtribe Pyrinae. It is native to the cooler hill regions of south-central China. In Japan, the loquat has been grown for over 1,000 years. It has been introduced to regions with subtropical to mild temperate climates throughout the world.", "wikipedia_url": "https://en.wikipedia.org/wiki/Loquat"}}, {"canonical_name": "Romaza", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "romaza", "book_id": "historia_medicinal_monardes_1574", "name": "Romaza", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Romaza"], "contexts": ["plant used for comparison of leaf size", "plant with red root and leaves"]}, {"entity_id": "romano", "book_id": "ricettario_fiorentino_1597", "name": "romano", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["romano"], "contexts": ["substance descriptor"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Romaza", "target_book": "ricettario_fiorentino_1597", "target_name": "romano", "similarity": 0.866}], "id": 1674, "stable_key": "clu_0f5fdbbbabb69365", "ground_truth": {"modern_name": "Rumex", "confidence": "high", "type": "plant", "linnaean": "Rumex", "family": "Polygonaceae", "note": "The term 'Romaza' is likely a reference to a species of Sorrel (Rumex).", "wikipedia_extract": "Urtica dioica, often known as common nettle, burn nettle, stinging nettle, nettle leaf, or just a nettle or stinger, is a herbaceous perennial flowering plant in the family Urticaceae. Originally native to Europe, much of temperate Asia and western North Africa, it is now found worldwide. The species is divided into six subspecies, five of which have many hollow stinging hairs called trichomes on the leaves and stems, which act like hypodermic needles, injecting histamine and other chemicals that produce a stinging sensation upon contact (\"contact urticaria\", a form of contact dermatitis). The plant has a long history of use as a source for traditional medicine, food, tea, and textile raw material in ancient (such as Saxon) and modern societies. Urtica dioica is a dioecious, herbaceous, and perennial plant. It grows to 0.9 to 2 metres (3 to 7 feet) tall in the summer and dying down to the ground in winter.", "wikipedia_url": "https://en.wikipedia.org/wiki/Urtica_dioica"}}, {"canonical_name": "Solatro", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "solatro", "book_id": "historia_medicinal_monardes_1574", "name": "Solatro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Solatro"], "contexts": ["plant root used to induce dreams"]}, {"entity_id": "solatro", "book_id": "ricettario_fiorentino_1597", "name": "solatro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["solatro"], "contexts": ["herb with high moisture content"]}, {"entity_id": "soutro", "book_id": "ricettario_fiorentino_1597", "name": "SoUtro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["SoUtro"], "contexts": ["plant mentioned in a list"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Solatro", "target_book": "ricettario_fiorentino_1597", "target_name": "solatro", "similarity": 0.895}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Solatro", "target_book": "ricettario_fiorentino_1597", "target_name": "SoUtro", "similarity": 0.874}], "id": 1675, "stable_key": "clu_d2970c50a974ac8a", "ground_truth": {"modern_name": "Solanum", "confidence": "high", "type": "plant", "linnaean": "Solanum", "family": "Solanaceae", "note": "Refers to plants in the Solanum genus, which includes species like nightshade. Context suggests medicinal uses, potentially narcotic or dream-inducing.", "wikidata_id": "Q146555", "wikidata_description": "genus of plants"}}, {"canonical_name": "lentejas", "category": "PLANT", "subcategory": "SEED", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "lentejas", "book_id": "historia_medicinal_monardes_1574", "name": "lentejas", "category": "PLANT", "subcategory": "SEED", "count": 1, "variants": ["lentejas"], "contexts": ["lentils"]}, {"entity_id": "lenapa", "book_id": "ricettario_fiorentino_1597", "name": "lenapa", "category": "PLANT", "subcategory": "SEED", "count": 1, "variants": ["lenapa"], "contexts": ["seed for pounding"]}, {"entity_id": "lenti(co", "book_id": "ricettario_fiorentino_1597", "name": "lenti(co", "category": "PLANT", "subcategory": "SEED", "count": 1, "variants": ["lenti(co"], "contexts": ["oil from lentisk"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "lentejas", "target_book": "ricettario_fiorentino_1597", "target_name": "lenapa", "similarity": 0.85}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "lentejas", "target_book": "ricettario_fiorentino_1597", "target_name": "lenti(co", "similarity": 0.852}], "id": 1676, "stable_key": "clu_57b182792cf34752", "ground_truth": {"modern_name": "Lentils", "confidence": "high", "type": "plant", "linnaean": "Lens culinaris", "family": "Fabaceae", "note": "The mention of 'lenti(co' and oil from lentisk suggests a slight ambiguity, but 'lentejas' overwhelmingly points to lentils. The other terms likely refer to the seed of the lentil plant or a closely related species used similarly.", "wikidata_id": "Q131226", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Lentil", "wikipedia_extract": "The lentil (Vicia lens or Lens culinaris) is an annual legume grown for its lens-shaped edible seeds or pulses, also called lentils. It is about 40 cm (16 in) tall, and the seeds grow in pods, usually with two seeds in each. Lentil seeds are used around the world for culinary purposes, most commonly in stews or soups. In cuisines of the Indian subcontinent, where lentils are a staple, split lentils (often with their hulls removed) known as dal are often cooked into a thick curry that is usually eaten with rice or roti. The English word \"lentil\" ultimately derives from the Latin lens ('lentil'). The Latin word is of classical Roman or Latin origin and may be the source of the prominent Roman family name Lentulus, just as the family name \"Cicero\" was derived from the chickpea, Cicer arietinum, and \"Fabia\" (as in Quintus Fabius Maximus) from the fava bean (Vicia faba)."}}, {"canonical_name": "Cerracca", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cerracca", "book_id": "ricettario_fiorentino_1597", "name": "Cerracca", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Cerracca", "Cecraccha"], "contexts": ["substance, likely lac", "likely a preparation or ingredient"]}, {"entity_id": "ceruicabras", "book_id": "historia_medicinal_monardes_1574", "name": "Ceruicabras", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Ceruicabras"], "contexts": ["hybrid creature named by author"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Cerracca", "target_book": "historia_medicinal_monardes_1574", "target_name": "Ceruicabras", "similarity": 0.85}], "id": 1677, "stable_key": "clu_268de791b161129e", "ground_truth": {"modern_name": "Lac (resin)", "confidence": "medium", "type": "chemical", "note": "The term 'Cerracca' is not a standard early modern term. Given the context of 'lac' and the description of a hybrid creature named by the author, it might be a specific preparation or a phonetic transcription. 'Ceruicabras' itself seems to be a neologism or a specific descriptor rather than a known entity. Lac resin is a plausible interpretation given its use in some early modern preparations.", "wikipedia_extract": "Shellac () is a resin secreted by the female lac bug on trees in the forests of India and Thailand. Chemically, it is mainly composed of aleuritic acid, jalaric acid, shellolic acid, and other natural waxes. It is processed and sold as dry flakes and dissolved in alcohol to make liquid shellac, which is used as a brush-on colorant, food glaze and wood finish. Shellac functions as a tough natural primer, sanding sealant, tannin-blocker, odor-blocker, stain, and high-gloss varnish. Shellac was once used in electrical applications as it is a good insulator and seals out moisture. Phonograph and 78 rpm gramophone records were made of shellac until it was replaced by vinyl.", "wikipedia_url": "https://en.wikipedia.org/wiki/Shellac"}}, {"canonical_name": "legno santo", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "legno_santo", "book_id": "ricettario_fiorentino_1597", "name": "legno santo", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["legno santo"], "contexts": ["common name for guaiacan wood", "source of oil"]}, {"entity_id": "palo_santto", "book_id": "historia_medicinal_monardes_1574", "name": "Palo santto", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Palo santto"], "contexts": ["holy wood, likely a medicinal tree"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "legno santo", "target_book": "historia_medicinal_monardes_1574", "target_name": "Palo santto", "similarity": 0.876}], "id": 1678, "stable_key": "clu_429878b7b9e72f30", "ground_truth": {"modern_name": "Guaiacum", "confidence": "high", "type": "plant", "linnaean": "Guaiacum officinale", "family": "Zygophyllaceae", "note": "Both 'legno santo' and 'Palo santto' are direct translations of 'holy wood' or 'sacred wood', which strongly corresponds to the common names for guaiacum, especially its medicinal use.", "wikidata_id": "Q1429385", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Guaiacum", "wikipedia_extract": "Guaiacum (), sometimes spelled Guajacum, is a genus of flowering plants in the caltrop family Zygophyllaceae. It contains five species of slow-growing shrubs and trees, reaching a height of approximately 20 m (66 ft) but usually less than half of that. All are native to subtropical and tropical regions of the Americas and are commonly known as lignum-vitae, guayacán (Spanish), or gaïac (French). The genus name originated in Taíno, the language spoken by the native Taínos of the Bahamas; it was adopted into English in 1533, the first word in that language of American origin. Members of the genus have a variety of uses, including as lumber, for medicinal purposes, and as ornamentals. The trade of all species of Guaiacum is controlled under CITES Appendix II."}}, {"canonical_name": "Conrado Geſnero", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "conrado_geſnero", "book_id": "historia_medicinal_monardes_1574", "name": "Conrado Geſnero", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Conrado Geſnero", "Conrado Geſnero Tigurino"], "contexts": ["author of a book on animals"]}, {"entity_id": "conrado_gefnero", "book_id": "polyanthea_medicinal", "name": "Conrado Gefnero", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Conrado Gefnero"], "contexts": ["author cited for praising eggs"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Conrado Geſnero", "target_book": "polyanthea_medicinal", "target_name": "Conrado Gefnero", "similarity": 0.931}], "id": 1679, "stable_key": "clu_dbf9da735508032b", "ground_truth": {"modern_name": "Conrad Gessner", "confidence": "high", "type": "person", "birth_year": 1516, "death_year": 1565, "description": "Swiss physician, botanist, zoologist, and bibliographer.", "wikidata_id": "Q60116", "wikidata_description": "Swiss physician, bibliographer and naturalist (1516–1565)", "wikipedia_url": "https://en.wikipedia.org/wiki/Conrad_Gessner", "wikipedia_extract": "The salamander is an amphibian of the order Urodela which once, like many real creatures, often was suppositiously ascribed fantastic and sometimes occult qualities by pre-modern authors, as in the allegorical descriptions of animals in medieval bestiaries. The legendary salamander is often depicted as a typical salamander in shape, with a lizard-like form, but is usually ascribed an affinity with fire, sometimes specifically elemental fire. Ancient and medieval commentators ascribed many fantastical abilities to the natural salamander. Many of these qualities are rooted in verifiable traits of the natural creature but often exaggerated. A large body of legend, mythology, and symbolism has developed around this creature over the centuries. Carl Linnaeus in the 10th edition of Systema Naturae of 1758 established the scientific description of the salamander and noted the chief characteristics described by the ancients: the reported ability to live in fire, and the oily exudates."}}, {"canonical_name": "vino caliente", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "vino_caliente", "book_id": "historia_medicinal_monardes_1574", "name": "vino caliente", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["vino caliente"], "contexts": ["with hot wine cures obstructions", "taken with hot wine"]}, {"entity_id": "vinho_muyto_quente", "book_id": "polyanthea_medicinal", "name": "vinho muyto quente", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["vinho muyto quente"], "contexts": ["hot wine for foot bath"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "vino caliente", "target_book": "polyanthea_medicinal", "target_name": "vinho muyto quente", "similarity": 0.932}], "id": 1680, "stable_key": "clu_520da411966c300f", "ground_truth": {"modern_name": "Hot wine", "confidence": "high", "type": "concept", "note": "This refers to wine that has been heated, often with spices, for medicinal or therapeutic purposes, as suggested by its use in cures and foot baths.", "wikidata_id": "Q6584", "wikidata_description": "red wine along with various spices and perhaps fruit or raisins", "wikipedia_url": "https://en.wikipedia.org/wiki/Mulled_wine", "wikipedia_extract": "Mead (, MEED), also called honey wine, and hydromel (particularly when low in alcohol content), is an alcoholic beverage made by fermenting honey mixed with water, and sometimes with added ingredients such as fruits, spices, grains, or hops. The alcoholic content ranges from about 3.5% ABV to more than 20%. Possibly the most ancient alcoholic drink, the defining characteristic of mead is that the majority of the beverage's fermentable sugar is derived from honey. It may be still, carbonated, or naturally sparkling, and despite a common misconception that mead is exclusively sweet, it can also be dry or semi-sweet. Mead that also contains spices is called metheglin (), and mead that contains fruit is called melomel. The term honey wine is sometimes used as a synonym for mead, although wine is typically defined to be the product of fermented grapes or certain other fruits, and some cultures have honey wines that are distinct from mead."}}, {"canonical_name": "Diapalma", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "diapalma", "book_id": "polyanthea_medicinal", "name": "Diapalma", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Diapalma"], "contexts": ["ointment", "Diapalma plaster"]}, {"entity_id": "diapalma", "book_id": "historia_medicinal_monardes_1574", "name": "diapalma", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["diapalma"], "contexts": ["emplastrum applied to afflicted parts"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Diapalma", "target_book": "historia_medicinal_monardes_1574", "target_name": "diapalma", "similarity": 0.986}], "id": 1681, "stable_key": "clu_dbf3ebca156e8a7b", "ground_truth": {"wikipedia_extract": "In pharmacology, diapalma (from Lat dia, \"made of\" + palma, \"palm\") is a desiccating or drying plaster, named for the wood of the palm tree, from which the spatula is made that is used to stir the mixture while boiling. It was formerly composed of common oil, hogs-fat, and litharge of gold; or also of palm oil, litharge, and zinc sulfate. Now, it is made of white wax, emplastrum simplex, and sulfate of zinc."}}, {"canonical_name": "fputofanguinis", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "fputofanguinis", "book_id": "polyanthea_medicinal", "name": "fputofanguinis", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["fputofanguinis", "fputocruento"], "contexts": ["bloody sputum"]}, {"entity_id": "fpafmo", "book_id": "historia_medicinal_monardes_1574", "name": "fpafmo", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["fpafmo"], "contexts": ["spasm cured by sulphur and egg"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "fputofanguinis", "target_book": "historia_medicinal_monardes_1574", "target_name": "fpafmo", "similarity": 0.853}], "id": 1682, "stable_key": "clu_e4c444b3de0c2e35", "ground_truth": {"modern_name": "Hemoptysis", "confidence": "high", "type": "disease", "modern_term": "Hemoptysis", "note": " 'Fputofanguinis' directly translates to 'spitting of blood' (sputum of blood), which is hemoptysis. 'Fpafmo' (spasm) can be a symptom that accompanies or is treated alongside hemoptysis, or it could be an alternative spelling/contextual usage, but hemoptysis is the primary referent given 'fputofanguinis'.", "wikidata_id": "Q647099", "wikidata_description": "medical symptom: bloody mucus from coughing", "wikipedia_extract": "Hemoptysis or haemoptysis is the discharge of blood or blood-stained mucus through the mouth coming from the bronchi, larynx, trachea, or lungs. In other words, it is the airway bleeding, and does not necessarily involve coughing. This can occur with lung cancer, infections such as tuberculosis, bronchitis, or pneumonia, and certain cardiovascular conditions. Hemoptysis is considered massive at 300 mL (11 imp fl oz; 10 US fl oz). In such cases, there are always severe injuries. The primary danger comes from choking, rather than blood loss.", "wikipedia_url": "https://en.wikipedia.org/wiki/Hemoptysis"}}, {"canonical_name": "fomentaçao", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "fomentaçao", "book_id": "polyanthea_medicinal", "name": "fomentaçao", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["fomentaçao"], "contexts": ["application of warm liquids", "application of oil to the nape"]}, {"entity_id": "fomentaciones", "book_id": "historia_medicinal_monardes_1574", "name": "fomentaciones", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fomentaciones"], "contexts": ["therapeutic application of heat or liquid"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "fomentaçao", "target_book": "historia_medicinal_monardes_1574", "target_name": "fomentaciones", "similarity": 0.983}], "id": 1683, "stable_key": "clu_8e19728993bb5f2a", "ground_truth": {"modern_name": "Fomentation", "confidence": "high", "type": "concept", "note": "This refers to the therapeutic application of moist heat or warm liquids to the body.", "wikidata_id": "Q58775427", "wikidata_description": "", "wikipedia_extract": "Ayurveda is a pseudoscientific alternative medicine system with historical roots in the Indian subcontinent. It is heavily practised throughout India and Nepal, where as much as 80% of the population report using ayurveda. Toxic metals including lead and mercury are used as ingredients in many ayurvedic medicines. Ayurveda therapies have varied and evolved over more than two millennia. Therapies include herbal medicines, special diets, meditation, yoga, massage, laxatives, enemas, and medical oils. Early Ayurvedic preparations were entirely based on complex herbal compounds based on the materia medica of South Asia.", "wikipedia_url": "https://en.wikipedia.org/wiki/Ayurveda"}}, {"canonical_name": "fluxosde ſangue", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "fluxosde_ſangue", "book_id": "polyanthea_medicinal", "name": "fluxosde ſangue", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["fluxosde ſangue", "fluxo deſangue"], "contexts": ["excessive bleeding", "bleeding"]}, {"entity_id": "fluxo_de_ſangre", "book_id": "historia_medicinal_monardes_1574", "name": "fluxo de ſangre", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["fluxo de ſangre"], "contexts": ["flow of blood from wounds"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "fluxosde ſangue", "target_book": "historia_medicinal_monardes_1574", "target_name": "fluxo de ſangre", "similarity": 0.931}], "id": 1684, "stable_key": "clu_ccdc28d317e48767", "ground_truth": {"modern_name": "Hemorrhage", "confidence": "high", "type": "disease", "modern_term": "Hemorrhage", "note": "'Fluxosde ſangue' and 'fluxo de ſangre' both translate to 'flow of blood', indicating hemorrhage or excessive bleeding.", "wikipedia_extract": "Hereditary hemorrhagic telangiectasia (HHT), also known as Osler–Weber–Rendu disease and Osler–Weber–Rendu syndrome, is a rare autosomal dominant genetic disorder that leads to abnormal blood vessel formation in the skin, mucous membranes, and often in organs such as the lungs, liver, and brain. It may lead to nosebleeds, acute and chronic digestive tract bleeding, and various problems due to the involvement of other organs. Treatment focuses on reducing bleeding from telangiectasias, and sometimes surgery or other targeted interventions to remove arteriovenous malformations in organs. Chronic bleeding often requires iron supplements, iron infusions and sometimes blood transfusions. HHT is transmitted in an autosomal dominant fashion, and occurs in one in 5,000–8,000 people in North America. The disease carries the names of Sir William Osler, Henri Jules Louis Marie Rendu, and Frederick Parkes Weber, who described it in the late 19th and early 20th centuries.", "wikipedia_url": "https://en.wikipedia.org/wiki/Hereditary_hemorrhagic_telangiectasia"}}, {"canonical_name": "Tiña", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tiña", "book_id": "historia_medicinal_monardes_1574", "name": "Tiña", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Tiña"], "contexts": ["skin condition on the head"]}, {"entity_id": "tinea", "book_id": "polyanthea_medicinal", "name": "Tinea", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Tinea"], "contexts": ["a disease, possibly ringworm"]}, {"entity_id": "tins", "book_id": "polyanthea_medicinal", "name": "tins", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["tins"], "contexts": ["bladder ailments"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Tiña", "target_book": "polyanthea_medicinal", "target_name": "Tinea", "similarity": 0.93}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Tiña", "target_book": "polyanthea_medicinal", "target_name": "tins", "similarity": 0.868}], "id": 1685, "stable_key": "clu_cb479bdb5c90e4a3", "ground_truth": {"modern_name": "Tinea", "confidence": "high", "type": "disease", "modern_term": "Tinea", "wikidata_id": "Q17141201", "wikidata_description": "Human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Tinea_corporis", "wikipedia_extract": "Tinea corporis is a fungal infection of the body, similar to other forms of tinea. Specifically, it is a type of dermatophytosis (or ringworm) that appears on the arms and legs, especially on glabrous skin; however, it may occur on any superficial part of the body. It may have a variety of appearances; most easily identifiable are the enlarging raised red rings with a central area of clearing (ringworm). The same appearances of ringworm may also occur on the scalp (tinea capitis), beard area (tinea barbae) or the groin (tinea cruris, known as jock itch or dhobi itch). Other classic features of tinea corporis include: The edge of the rash appears elevated and is scaly to touch. Sometimes the skin surrounding the rash may be dry and flaky."}}, {"canonical_name": "Glofio", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "glofio", "book_id": "polyanthea_medicinal", "name": "Glofio", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 2, "variants": ["Glofio"], "contexts": ["physician to Duke of Bavaria", "physician"]}, {"entity_id": "gotofo", "book_id": "historia_medicinal_monardes_1574", "name": "gotofo", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["gotofo"], "contexts": ["person suffering from gout"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Glofio", "target_book": "historia_medicinal_monardes_1574", "target_name": "gotofo", "similarity": 0.864}], "id": 1686, "stable_key": "clu_67c152520ad84457", "ground_truth": {"modern_name": "Gloff", "confidence": "medium", "type": "person", "description": "Physician to Duke of Bavaria, also associated with gout", "note": "The term 'gotofo' could refer to gout, but also a person suffering from it. 'Glofio' is likely a surname or given name.", "wikipedia_extract": "The Chronicles of Prydain is a five part series of children's high fantasy coming-of-age novels written by American author Lloyd Alexander and published by Henry Holt and Company. The series includes: The Book of Three (1964), The Black Cauldron (1965), The Castle of Llyr (1966), Taran Wanderer (1967), and The High King (1968). The Black Cauldron earned a 1966 Newbery Honor, and The High King won the 1969 Newbery Medal. The five novels take place in Prydain, a fictional country ruled by a High King who oversees several minor kingdoms. The setting is based on Wales and inhabited by creatures and characters inspired by Welsh mythology and folklore. The series follows the protagonist Taran, a youth of unknown parentage living on a farm with an old enchanter named Dallben and a farmer named Coll.", "wikipedia_url": "https://en.wikipedia.org/wiki/The_Chronicles_of_Prydain"}}, {"canonical_name": "abſorbe", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "abſorbe", "book_id": "polyanthea_medicinal", "name": "abſorbe", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["abſorbe", "abſorbentes"], "contexts": ["absorption of moisture", "medicinal approach"]}, {"entity_id": "ablandar", "book_id": "historia_medicinal_monardes_1574", "name": "ablandar", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["ablandar"], "contexts": ["virtue of Ambar to soften"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "abſorbe", "target_book": "historia_medicinal_monardes_1574", "target_name": "ablandar", "similarity": 0.846}], "id": 1687, "stable_key": "clu_d8ccdf2e6f1a6004", "ground_truth": {"modern_name": "Absorption", "confidence": "high", "type": "concept", "wikipedia_extract": "The emissivity of the surface of a material is its effectiveness in emitting energy as thermal radiation. Thermal radiation is electromagnetic radiation that most commonly includes both visible radiation (light) and infrared radiation, which is not visible to human eyes. A portion of the thermal radiation from very hot objects (see photograph) is easily visible to the eye. The emissivity of a surface depends on its chemical composition and geometrical structure. Quantitatively, it is the ratio of the thermal radiation from a surface to the radiation from an ideal black surface at the same temperature as given by the Stefan–Boltzmann law. (A comparison with Planck's law is used if one is concerned with particular wavelengths of thermal radiation.) The ratio varies from 0 to 1 for ordinary surfaces.", "wikipedia_url": "https://en.wikipedia.org/wiki/Emissivity"}}, {"canonical_name": "Olmo", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "olmo", "book_id": "polyanthea_medicinal", "name": "Olmo", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Olmo"], "contexts": ["elm", "elm tree"]}, {"entity_id": "olmo", "book_id": "historia_medicinal_monardes_1574", "name": "Olmo", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Olmo"], "contexts": ["tree compared in size and leaf"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Olmo", "target_book": "historia_medicinal_monardes_1574", "target_name": "Olmo", "similarity": 0.931}], "id": 1688, "stable_key": "clu_3bbb46fc159e1fc2", "ground_truth": {"modern_name": "Elm", "confidence": "high", "type": "plant", "linnaean": "Ulmus L.", "family": "Ulmaceae", "note": "Linnaean binomial is for the genus, specific species not identifiable from context.", "wikidata_id": "Q131113", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Elm", "wikipedia_extract": "Elms are deciduous and semi-deciduous trees comprising the genus Ulmus in the family Ulmaceae. They are distributed over most of the Northern Hemisphere, inhabiting the temperate and tropical-montane regions of North America and Eurasia, ranging southward in Western Asia to Iran, in Africa to Libya, and in Southeast Asia into Indonesia. Elms are components of many kinds of natural forests. Moreover, during the 19th and early 20th centuries, many species and cultivars were also planted as ornamental street, garden, and park trees in Europe, North America, and parts of the Southern Hemisphere, notably Australasia. Some individual elms reached great size and age. However, in recent decades, most mature elms of European or North American origin have died from Dutch elm disease, caused by a microfungus dispersed by bark beetles."}}, {"canonical_name": "medicam", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "medicam", "book_id": "polyanthea_medicinal", "name": "medicam", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["medicam", "Medicamentis internis"], "contexts": ["title of a book by Scribonius Largius", "title of a book"]}, {"entity_id": "símpliduíln_medicamentorum", "book_id": "coloquios_da_orta_1563", "name": "Símpliduíln medicamentorum", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Símpliduíln medicamentorum"], "contexts": ["title of a work"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "medicam", "target_book": "coloquios_da_orta_1563", "target_name": "Símpliduíln medicamentorum", "similarity": 0.86}], "id": 1689, "stable_key": "clu_9dd530b391227490", "ground_truth": {"modern_name": "Medicamentorum", "confidence": "high", "type": "text", "note": "Refers to titles of medicinal works.", "wikipedia_extract": "Ulisse Aldrovandi (11 September 1522 – 4 May 1605) was an Italian naturalist, the moving force behind Bologna's botanical garden, one of the first in Europe. Carl Linnaeus and the comte de Buffon reckoned him the father of natural history studies. He is usually referred to, especially in older scientific literature in Latin, as Aldrovandus; his name in Italian is equally given as Aldroandi. Aldrovandi was born in Bologna to Teseo Aldrovandi and his wife, a noble but poor family. His father was a lawyer, and Secretary to the Senate of Bologna, but died when Ulisse was seven years old. His widowed mother wanted him to become a jurist.", "wikipedia_url": "https://en.wikipedia.org/wiki/Ulisse_Aldrovandi"}}, {"canonical_name": "flammaçaodofigado", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "flammaçaodofigado", "book_id": "polyanthea_medicinal", "name": "flammaçaodofigado", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["flammaçaodofigado", "flammmaçaoda"], "contexts": ["inflammation of the liver", "inflammation of"]}, {"entity_id": "fuxzo_demaliado", "book_id": "historia_medicinal_monardes_1574", "name": "fuxzo demaliado", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["fuxzo demaliado"], "contexts": ["excessive flow"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "flammaçaodofigado", "target_book": "historia_medicinal_monardes_1574", "target_name": "fuxzo demaliado", "similarity": 0.857}], "id": 1690, "stable_key": "clu_f279f1689122af63", "ground_truth": {"modern_name": "Liver inflammation", "confidence": "high", "type": "disease", "modern_term": "Hepatitis", "note": "While 'Hepatitis' is the modern term, 'liver inflammation' is a direct translation of the historical term.", "wikipedia_extract": "Hepatitis is inflammation of the liver tissue. Some people or animals with hepatitis have no symptoms, whereas others develop yellow discoloration of the skin and whites of the eyes (jaundice), poor appetite, vomiting, tiredness, abdominal pain, and diarrhea. Hepatitis is acute if it resolves within six months, and chronic if it lasts longer than six months. Acute hepatitis can resolve on its own, progress to chronic hepatitis, or (rarely) result in acute liver failure. Chronic hepatitis may progress to scarring of the liver (cirrhosis), liver failure, and liver cancer. Hepatitis is most commonly caused by the virus hepatovirus A, B, C, D, and E."}}, {"canonical_name": "melaço", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "melaço", "book_id": "polyanthea_medicinal", "name": "melaço", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["melaço"], "contexts": ["molasses used in remedy", "ingredient in emollient enema"]}, {"entity_id": "melicraco", "book_id": "historia_medicinal_monardes_1574", "name": "melicraco", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["melicraco"], "contexts": ["preparation for thick humors"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "melaço", "target_book": "historia_medicinal_monardes_1574", "target_name": "melicraco", "similarity": 0.852}], "id": 1691, "stable_key": "clu_1103f01d16472cb7", "ground_truth": {"wikipedia_extract": "Molasses ( ) is a viscous byproduct principally obtained from the refining of sugarcane or sugar beet juice into sugar. Molasses varies in the amount of sugar, the method of extraction, and the age of the plant. Sugarcane molasses is usually used to sweeten and flavour foods. Molasses is a major constituent of fine commercial brown sugar. Molasses is rich in vitamins and minerals, including vitamin B6, iron, calcium, magnesium, and potassium. There are different types of molasses depending on the amount of time refined, including first molasses (highest sugar content), second molasses (slightly bitter), and blackstrap molasses (the darkest and most robust in flavor)."}}, {"canonical_name": "solutivas", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "solutivas", "book_id": "coloquios_da_orta_1563", "name": "solutivas", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["solutivas", "solutivos"], "contexts": ["dissolving quality"]}, {"entity_id": "soluente", "book_id": "ricettario_fiorentino_1597", "name": "soluente", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["soluente"], "contexts": ["dissolving quality"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "solutivas", "target_book": "ricettario_fiorentino_1597", "target_name": "soluente", "similarity": 0.905}], "id": 1692, "stable_key": "clu_356e2b149486f9e9", "ground_truth": {"modern_name": "Solutive", "confidence": "high", "type": "concept"}}, {"canonical_name": "resolutivo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "resolutivo", "book_id": "coloquios_da_orta_1563", "name": "resolutivo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["resolutivo"], "contexts": ["property of negundo for pain", "medicinal property of sandalwood"]}, {"entity_id": "solutiui", "book_id": "ricettario_fiorentino_1597", "name": "solutiui", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["solutiui"], "contexts": ["dissolving quality"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "resolutivo", "target_book": "ricettario_fiorentino_1597", "target_name": "solutiui", "similarity": 0.848}], "id": 1693, "stable_key": "clu_a986975085c8b9a8", "ground_truth": {"modern_name": "Resolvent", "confidence": "high", "type": "concept", "wikipedia_extract": "In Galois theory, a discipline within the field of abstract algebra, a resolvent for a permutation group G is a polynomial whose coefficients depend polynomially on the coefficients of a given polynomial p and has, roughly speaking, a rational root if and only if the Galois group of p is included in G. More exactly, if the Galois group is included in G, then the resolvent has a rational root, and the converse is true if the rational root is a simple root. Resolvents were introduced by  Joseph Louis Lagrange and systematically used by Évariste Galois. Nowadays they are still a fundamental tool to compute Galois groups. The simplest examples of resolvents are is the discriminant, which is a resolvent for the alternating group. In the case of a cubic equation, this resolvent is sometimes called the quadratic resolvent; its roots appear explicitly in the formulas for the roots of a cubic equation.", "wikipedia_url": "https://en.wikipedia.org/wiki/Resolvent_(Galois_theory)"}}, {"canonical_name": "opto", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "opto", "book_id": "coloquios_da_orta_1563", "name": "opto", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["opto"], "contexts": ["what is called opto", "amfiam is the opto"]}, {"entity_id": "opò", "book_id": "polyanthea_medicinal", "name": "opò", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["opò"], "contexts": ["bile or preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "opto", "target_book": "polyanthea_medicinal", "target_name": "opò", "similarity": 0.861}], "id": 1694, "stable_key": "clu_b5a2a2f59e0191ed", "ground_truth": {"modern_name": "gallbladder bile", "confidence": "high", "type": "chemical", "note": "The term 'opto' and 'opò' likely refer to bile, specifically from the gallbladder, as it was a common substance in early modern humoral medicine and pharmacopoeia. 'Opto' might be a corruption or variant of a Latin or Greek term related to bile.", "wikidata_id": "Q208006", "wikidata_description": "central district and city in Bilecik Province, Turkey", "wikipedia_url": "https://en.wikipedia.org/wiki/Gallbladder", "wikipedia_extract": "In vertebrates, the gallbladder, also known as the cholecyst, is a small hollow organ where bile is stored and concentrated before it is released into the small intestine. In humans, the pear-shaped gallbladder lies beneath the liver, although the structure and position of the gallbladder can vary significantly among animal species. It receives bile, produced by the liver, via the common hepatic duct, and stores it. The bile is then released via the common bile duct into the duodenum, where the bile helps in the digestion of fats. The gallbladder can be affected by gallstones, formed by material that cannot be dissolved – usually cholesterol or bilirubin, a product of hemoglobin breakdown. These may cause significant pain, particularly in the upper-right corner of the abdomen, and are often treated with removal of the gallbladder (called a cholecystectomy)."}}, {"canonical_name": "mambum", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mambum", "book_id": "coloquios_da_orta_1563", "name": "mambum", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["mambum"], "contexts": ["tree whose sugar is sacarmambum", "name for bamboo given by Orta"]}, {"entity_id": "mamillo", "book_id": "polyanthea_medicinal", "name": "mamillo", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["mamillo"], "contexts": ["used for cauterization of the eye"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "mambum", "target_book": "polyanthea_medicinal", "target_name": "mamillo", "similarity": 0.866}], "id": 1695, "stable_key": "clu_c33fb82b77a12f52", "ground_truth": {"modern_name": "Sugar cane", "confidence": "high", "type": "plant", "linnaean": "Saccharum officinarum L.", "family": "Poaceae", "note": "The context of 'sugar' (sacarmambum) points strongly to sugar cane. The use for cauterization is less common but possible for its properties or derivatives.", "wikidata_id": "Q3391243", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Saccharum%20officinarum", "wikipedia_extract": "Sugarcane or sugar cane is a species of tall, perennial grass (in the genus Saccharum, tribe Andropogoneae) that is used for sugar production. The plants are 2–6 m (6–20 ft) tall with stout, jointed, fibrous stalks that are rich in sucrose, which accumulates in the stalk internodes. Sugarcanes belong to the grass family, Poaceae, an economically important flowering plant family that includes maize, wheat, rice, and sorghum, and many forage crops. It is native to New Guinea. Sugarcane was an ancient crop of the Austronesian and Papuan people. The best evidence available today points to the New Guinea area as the site of the original domestication of Saccharum officinarum."}}, {"canonical_name": "Bosphoro", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "bosphoro", "book_id": "ricettario_fiorentino_1597", "name": "Bosphoro", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Bosphoro", "Bofphoro"], "contexts": ["place where Cardamomo is said to come from", "place of origin for a substance"]}, {"entity_id": "bósforo", "book_id": "coloquios_da_orta_1563", "name": "Bósforo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Bósforo"], "contexts": ["location associated with cardamomo origin"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Bosphoro", "target_book": "coloquios_da_orta_1563", "target_name": "Bósforo", "similarity": 0.903}], "id": 1696, "stable_key": "clu_14bdb57479db3ea5", "ground_truth": {"modern_name": "Strait of Istanbul", "confidence": "high", "type": "place", "country": "Turkey", "note": "Bosphorus is a well-known strait and a historical trade route, making it a plausible origin for spices like Cardamomo.", "wikidata_id": "Q35958", "wikidata_description": "narrow strait in northwestern Turkey", "wikipedia_url": "https://en.wikipedia.org/wiki/Dardanelles", "wikipedia_extract": "The Dardanelles ( DAR-də-NELZ; Turkish: Çanakkale Boğazı, lit. 'Strait of Çanakkale'; Greek: Δαρδανέλλια, romanized: Dardanéllia), also known as the Strait of Gallipoli (after the Gallipoli peninsula), is a narrow, natural strait and internationally significant waterway in northwestern Turkey that forms part of the continental boundary between Asia and Europe and separates Asian Turkey from European Turkey. Together with the Bosporus, the Dardanelles forms the Turkish Straits. One of the world's narrowest straits used for international navigation, the Dardanelles connects the Sea of Marmara with the Aegean and Mediterranean seas while also allowing passage to the Black Sea by extension via the Bosporus. The Dardanelles is 61 kilometres (38 mi) long and 1.2 to 6 kilometres (0.75 to 3.73 mi) wide. It has an average depth of 55 metres (180 ft) with a maximum depth of 103 metres (338 ft) at its narrowest point abreast the city of Çanakkale."}}, {"canonical_name": "nardirt", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "nardirt", "book_id": "ricettario_fiorentino_1597", "name": "nardirt", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["nardirt", "Nardino"], "contexts": ["substance, likely oil", "nard oil"]}, {"entity_id": "narikela", "book_id": "coloquios_da_orta_1563", "name": "narikela", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["narikela"], "contexts": ["Sanskrit name for fruit"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "nardirt", "target_book": "coloquios_da_orta_1563", "target_name": "narikela", "similarity": 0.855}], "id": 1697, "stable_key": "clu_64af227fa9cb0827", "ground_truth": {"modern_name": "Coconut", "confidence": "high", "type": "plant", "linnaean": "Cocos nucifera L.", "family": "Arecaceae", "note": "'Narikela' is the Sanskrit name for coconut. The mention of it being an 'oil' and a 'fruit' aligns perfectly with coconut.", "wikidata_id": "Q13187", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Coconut", "wikipedia_extract": "The coconut (Cocos nucifera) is a member of the palm family (Arecaceae) and the only living species of the genus Cocos. The term \"coconut\" (or the archaic \"cocoanut\") can denote the whole coconut palm tree or the large hard fruit. Originally native to Central Indo-Pacific, they are ubiquitous in coastal tropical regions. The coconut tree provides food, fuel, cosmetics, folk medicine and building materials. The inner flesh of the mature fruit forms a regular part of the diets of many people in the tropics and subtropics. Coconut endosperm contains a large quantity of a liquid, \"coconut water\"."}}, {"canonical_name": "D. fr. Jorge de Santa Luzia", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "d__fr__jorge_de_santa_luzia", "book_id": "coloquios_da_orta_1563", "name": "D. fr. Jorge de Santa Luzia", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 2, "variants": ["D. fr. Jorge de Santa Luzia", "fr. Jorge de Santa Luzia"], "contexts": ["first bishop of Malaca", "bishop of Malaca"]}, {"entity_id": "joao_de_santa_luzia", "book_id": "polyanthea_medicinal", "name": "Joao de Santa Luzia", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["Joao de Santa Luzia"], "contexts": ["apothecary of Sao Domingos"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "D. fr. Jorge de Santa Luzia", "target_book": "polyanthea_medicinal", "target_name": "Joao de Santa Luzia", "similarity": 0.868}], "id": 1698, "stable_key": "clu_2f490cf1c06df8f2", "ground_truth": {"modern_name": "Jorge de Santa Luzia", "confidence": "medium", "type": "person", "description": "First bishop of Malaca, also mentioned as apothecary", "note": "The identification is based on the name and the context of Malaca. The dual role (bishop and apothecary) might indicate two different individuals with similar names or a single individual with diverse roles. 'Joao de Santa Luzia' is likely a variation or error.", "wikidata_id": "Q20045896", "wikidata_description": "", "wikipedia_url": "https://pt.wikipedia.org/wiki/Jorge_de_Santa_Luzia"}}, {"canonical_name": "camalea", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "camalea", "book_id": "coloquios_da_orta_1563", "name": "camalea", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["camalea", "camelea"], "contexts": ["spice, possibly cinnamon", "plant name"]}, {"entity_id": "camemali", "book_id": "polyanthea_medicinal", "name": "camemali", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["camemali"], "contexts": ["chamomile flower ingredient"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "camalea", "target_book": "polyanthea_medicinal", "target_name": "camemali", "similarity": 0.874}], "id": 1699, "stable_key": "clu_ef88ff3b47b624c1", "ground_truth": {"modern_name": "Chamomile", "confidence": "medium", "type": "plant", "linnaean": "Matricaria chamomilla L.", "family": "Asteraceae", "note": "While 'camalea' could refer to cinnamon (as suggested in the note), 'camemali' in Polyanthea Medicinal strongly suggests Chamomile (from Latin 'camomilla'). The spice context is ambiguous. Given the stronger link to chamomile, that is the primary identification, but cinnamon remains a possibility.", "wikipedia_extract": "Chamomile (American English) or camomile (British English; see spelling differences) ( KAM-ə-myle or KAM-ə-meel) is the common name for several daisy-like plants of the family Asteraceae. Two of the species, Matricaria chamomilla and Chamaemelum nobile, are commonly used to make herbal infusions for beverages. Chamomile is used as a flavoring in foods, beverages, and cosmetics, in herbal teas, in brewing beer, and as a ground cover or seating plant in gardens. There is no clinical evidence supporting the effectiveness of consuming chamomile to treat any disease. Chamomile may interact adversely with various herbs and drugs, worsen pollen allergies, and is not recommended for people with hormone-sensitive conditions or when combined with anticoagulants. Because Roman chamomile may cause uterine contractions, it should not be used during pregnancy, and its safety during breastfeeding is unknown."}}, {"canonical_name": "meçuá", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "meçuá", "book_id": "coloquios_da_orta_1563", "name": "meçuá", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["meçuá", "meçua"], "contexts": ["place ruled by a prisoner", "port near pearl fishing islands"]}, {"entity_id": "minhacaſa", "book_id": "polyanthea_medicinal", "name": "minhacaſa", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["minhacaſa"], "contexts": ["my house"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "meçuá", "target_book": "polyanthea_medicinal", "target_name": "minhacaſa", "similarity": 0.901}], "id": 1700, "stable_key": "clu_4be08f65e56de60a", "ground_truth": {"modern_name": "My house", "confidence": "low", "type": "place", "note": "The terms 'meçuá' and 'minhacaſa' are too obscure and context-dependent to definitively identify a specific place. 'Minhacaſa' is suggestive of 'my house' in Portuguese. The ruler being a prisoner is highly contextual and does not yield a clear geographical referent.", "wikidata_id": "Q19627497", "wikidata_description": "extended play by Flo Rida", "wikipedia_url": "https://en.wikipedia.org/wiki/My_House_%28EP%29"}}, {"canonical_name": "estilar agoas", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "estilar_agoas", "book_id": "coloquios_da_orta_1563", "name": "estilar agoas", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["estilar agoas", "estilar"], "contexts": ["practice of distilling waters", "Process of distillation"]}, {"entity_id": "estilar", "book_id": "polyanthea_medicinal", "name": "estilar", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["estilar"], "contexts": ["distilling a substance"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "estilar agoas", "target_book": "polyanthea_medicinal", "target_name": "estilar", "similarity": 0.849}], "id": 1701, "stable_key": "clu_39ebadfb28525ac1", "ground_truth": {"modern_name": "Distillation", "confidence": "high", "type": "concept", "note": "The phrase 'estilar agoas' directly translates to 'to distill waters', which is a core process in early modern chemistry and pharmacy.", "wikidata_id": "Q74253442", "wikidata_description": "machine learning method to transfer knowledge from a large model to a smaller one", "wikipedia_extract": "Distillation, also classical distillation, is the process of separating the component substances of a liquid mixture of two or more chemically discrete substances; the separation process is realized by way of the selective boiling of the mixture and the condensation of the vapors in a still. Distillation can operate over a wide range of pressures from 0.14 bar (e.g., ethylbenzene/styrene) to nearly 21 bar (e.g., propylene/propane) and is capable of separating feeds with high volumetric flowrates and various components that cover a range of relative volatilities from only 1.17 (o-xylene/m-xylene) to 81.2 (water/ethylene glycol). Distillation provides a convenient and time-tested solution to separate a diversity of chemicals in a continuous manner with high purity. However, distillation has an enormous environmental footprint, resulting in the consumption of approximately 25% of all industrial energy use. The key issue is that distillation operates based on phase changes, and this separation mechanism requires vast energy inputs. Dry distillation (thermolysis and pyrolysis) is the heating of solid materials to produce gases that condense either into fluid products or into solid products.", "wikipedia_url": "https://en.wikipedia.org/wiki/Knowledge_distillation"}}, {"canonical_name": "laniger", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "laniger", "book_id": "coloquios_da_orta_1563", "name": "laniger", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["laniger", "A. laniger"], "contexts": ["plant name", "plant species"]}, {"entity_id": "linaria", "book_id": "polyanthea_medicinal", "name": "linaria", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["linaria"], "contexts": ["herb called linaria"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "laniger", "target_book": "polyanthea_medicinal", "target_name": "linaria", "similarity": 0.858}], "id": 1702, "stable_key": "clu_a09b6dbe84a05642", "ground_truth": {"modern_name": "Linaria", "confidence": "high", "type": "plant", "linnaean": "Linaria vulgaris", "family": "Plantaginaceae", "note": "The term 'laniger' appears to be a descriptive epithet potentially related to woolly appearance, and 'linaria' is a known genus of plants. Given the context of 'plant name' and 'herb called linaria', the genus Linaria is the most plausible referent.", "wikidata_id": "Q156692", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Linaria", "wikipedia_extract": "Linaria purpurea or purple toadflax is a purple-flowered plant native to Italy, part of the plantain family (Plantaginaceae). It is sometimes planted in gardens and is also an introduced weed in North America and other parts of Europe. It is a perennial herbaceous plant growing 30 to 70 centimeters tall with linear leaves 2 to 5 centimeters in length. The inflorescence is a raceme of flowers occupying the top of the stem. The flower is between 1 and 2 centimeters long with five lobes arranged into two lips with a spur at the end. The flower is usually light to medium purple in color."}}, {"canonical_name": "ar", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ar", "book_id": "coloquios_da_orta_1563", "name": "ar", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["ar"], "contexts": ["element that cures amber", "used for drying catechu"]}, {"entity_id": "areento", "book_id": "polyanthea_medicinal", "name": "areento", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["areento"], "contexts": ["sandy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "ar", "target_book": "polyanthea_medicinal", "target_name": "areento", "similarity": 0.853}], "id": 1703, "stable_key": "clu_debca132bc3e3669", "ground_truth": {"modern_name": "Air", "confidence": "high", "type": "concept", "note": "The context 'element that cures amber' strongly suggests the classical element 'air'. 'Areento' is likely a misreading or variant related to 'ar' or a related concept of elemental essence. 'Sandy' is less likely in this context, especially given the strong connection to 'element'.", "wikidata_id": "Q2301639", "wikidata_description": "portion of a bar gymnastics sequence where the gymnast is performing above and not touching the bar", "wikipedia_extract": "The atmosphere of Earth consists of a layer of mixed gas (commonly referred to as air) that is retained by gravity, surrounding the Earth's surface. It contains variable quantities of suspended aerosols and particulates that create weather features such as clouds and hazes. The atmosphere serves as a protective buffer between the Earth's surface and outer space. It shields the surface from most meteoroids and ultraviolet solar radiation, reduces diurnal temperature variation – the temperature extremes between day and night, and keeps it warm through heat retention via the greenhouse effect. The atmosphere redistributes heat and moisture among different regions via air currents, and provides the chemical and climate conditions that allow life to exist and evolve on Earth. By mole fraction (i.e., by quantity of molecules), dry air contains 78.08% nitrogen, 20.95% oxygen, 0.93% argon, 0.04% carbon dioxide, and small amounts of other trace gases (see Composition below for more detail)."}}, {"canonical_name": "bengali", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "bengali", "book_id": "coloquios_da_orta_1563", "name": "bengali", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["bengali"], "contexts": ["language of origin for 'bocha, bach'", "language where 'bél' is used"]}, {"entity_id": "banharſe", "book_id": "polyanthea_medicinal", "name": "banharſe", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["banharſe"], "contexts": ["bathing as cause of childbirth complications"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "bengali", "target_book": "polyanthea_medicinal", "target_name": "banharſe", "similarity": 0.86}], "id": 1704, "stable_key": "clu_f5fd1f2cae8e9f60", "ground_truth": {"modern_name": "Bengali language", "confidence": "high", "type": "concept", "note": "The first context 'language of origin for 'bocha, bach'' directly points to a language. 'Bengali' fits this perfectly. 'Banharſe' meaning 'bathing' does not fit this context, suggesting a probable separate meaning or OCR error in the source text for that specific instance.", "wikidata_id": "Q1975418", "wikidata_description": "movement aimed at making Bengali a state language", "wikipedia_url": "https://en.wikipedia.org/wiki/Bengali%20language%20movement", "wikipedia_extract": "Bengali, also known by its endonym Bangla, is a classical Indo-Aryan language belonging to the Indo-Iranian branch of the Indo-European language family. It is primarily spoken by the Bengali people, native to the Bengal region (Bangladesh, India's West Bengal, Tripura and parts of Southern Assam). With over 242 million native speakers and another 43 million as second language speakers as of 2025, Bengali is the sixth most spoken native language and the seventh most spoken language by the total number of speakers in the world. Bengali is the official, national, and most widely spoken language of Bangladesh, with 98% of Bangladeshis using Bengali as their first language. It is the second-most widely spoken language in India. It is the official language of the Indian states of West Bengal, Tripura and the Barak Valley region of the state of Assam."}}, {"canonical_name": "crísteis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "crísteis", "book_id": "coloquios_da_orta_1563", "name": "crísteis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["crísteis"], "contexts": ["medicinal suppositories", "medicinal preparation from fruit peels"]}, {"entity_id": "cristaes", "book_id": "polyanthea_medicinal", "name": "cristaes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["cristaes"], "contexts": ["substance derived from wine residue"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "crísteis", "target_book": "polyanthea_medicinal", "target_name": "cristaes", "similarity": 0.928}], "id": 1705, "stable_key": "clu_a1d2d040c1c3f84d", "ground_truth": {"modern_name": "Suppositories", "confidence": "high", "type": "object", "note": "The context 'medicinal suppositories' is a direct match. 'Cristaes' could refer to crystals, but in a medicinal context related to wine residue, it could also point to effervescence or crystalline precipitates used in preparations like suppositories.", "wikidata_id": "Q180799", "wikidata_description": "dosage form used to deliver medications by insertion into a body orifice where it dissolves or melts to exert local or systemic effects", "wikipedia_url": "https://en.wikipedia.org/wiki/Suppository", "wikipedia_extract": "Intravaginal administration is a route of administration where the substance is applied inside the vagina. Pharmacologically, it has the potential advantage to result in effects primarily in the vagina or nearby structures (such as the vaginal portion of cervix) with limited systemic adverse effects compared to other routes of administration. Formulation methods include vaginal tablets, vaginal cream, vaginal gel, vaginal suppository and vaginal ring. It is used as an administration method for issues related to women's health, such as contraception. Medicines primarily delivered by intravaginal administration include vaginally administered estrogens and progestogens (a group of hormones including progesterone), and antibacterials and antifungals to treat bacterial vaginosis and yeast infections respectively. Medicines may also be administered intravaginally as an alternative to oral route in the case of nausea or other digestive problems."}}, {"canonical_name": "Lyão", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "lyão", "book_id": "coloquios_da_orta_1563", "name": "Lyão", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Lyão"], "contexts": ["Champier's native city", "city of origin"]}, {"entity_id": "lyſia", "book_id": "polyanthea_medicinal", "name": "Lyſia", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Lyſia"], "contexts": ["city, likely Lisbon"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Lyão", "target_book": "polyanthea_medicinal", "target_name": "Lyſia", "similarity": 0.873}], "id": 1706, "stable_key": "clu_fffa2437445ce9b5", "ground_truth": {"modern_name": "Lyon", "confidence": "high", "type": "place", "country": "France", "note": "Both 'Lyão' and 'Lyſia' strongly point to the city of Lyon, France, especially when considering historical medical figures like Champier. The mention of Lisbon seems to be an alternative interpretation, but Lyon is the more established connection.", "wikidata_id": "Q456", "wikidata_description": "city of France", "wikipedia_url": "https://en.wikipedia.org/wiki/Lyon", "wikipedia_extract": "Suellyn Lyon (July 10, 1946 – December 26, 2019) was an American actress who is most famous today for playing the title role in Stanley Kubrick's 1962 film adaptation of Vladimir Nabokov's novel Lolita, for which she was awarded a Golden Globe. Lyon's early career flourished with appearances in such high-profile films as John Huston's The Night of the Iguana (1964), John Ford's 7 Women (1966), the Frank Sinatra detective film Tony Rome (1967), and the George C. Scott comedy The Flim Flam Man (1967). However, her career diminished in the 1970s and she subsequently retired from acting after making Alligator, which was released in 1980. In 1991, Lyon featured prominently in the artwork for Welsh rock band Manic Street Preachers' single \"Stay Beautiful\". Suellyn Lyon, called Sue, was born on July 10, 1946, in Davenport, Iowa."}}, {"canonical_name": "gotim", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "gotim", "book_id": "coloquios_da_orta_1563", "name": "gotim", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["gotim"], "contexts": ["type of mirabolano", "name for myrobalanos fruits"]}, {"entity_id": "goys", "book_id": "polyanthea_medicinal", "name": "goys", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["goys"], "contexts": ["plant infused in oil"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "gotim", "target_book": "polyanthea_medicinal", "target_name": "goys", "similarity": 0.848}], "id": 1707, "stable_key": "clu_98cd59a5135ff83c", "ground_truth": {"modern_name": "Myrobalan", "confidence": "medium", "type": "plant", "note": "The context 'type of mirabolano' is a direct pointer to Myrobalan. 'Gotim' could be a regional or historical variant. 'Goys' is less clear but could be a corruption of a similar term or a different plant entirely. Without further context for 'goys', identifying a specific Linnaean binomial is difficult.", "wikipedia_extract": "The common name myrobalan can refer to several unrelated fruit-bearing plant species: Myrobalan plum (Prunus cerasifera), also called cherry plum and myrobalan plum Emblic myrobalan (Phyllanthus emblica), also called Amla and Amalaki Beleric myrobalan (Terminalia bellirica), also called Bibhitaki and Belliric myrobalans Black myrobalan (Terminalia chebula), also called Haritaki and Chebulic myrobalans."}}, {"canonical_name": "Papa Paulo IV", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "papa_paulo_iv", "book_id": "coloquios_da_orta_1563", "name": "Papa Paulo IV", "category": "PERSON", "subcategory": "PATRON", "count": 2, "variants": ["papa Paulo IV", "Papa Paulo IV"], "contexts": ["sent Rontecalli to India", "Pope Paul IV"]}, {"entity_id": "paulo_iv_", "book_id": "polyanthea_medicinal", "name": "Paulo IV.", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Paulo IV."], "contexts": ["Pope who suffered from erysipelas"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Papa Paulo IV", "target_book": "polyanthea_medicinal", "target_name": "Paulo IV.", "similarity": 0.957}], "id": 1708, "stable_key": "clu_f3d6f5723c7cea7d", "ground_truth": {"modern_name": "Pope Paul IV", "confidence": "high", "type": "person", "birth_year": 1476, "death_year": 1559, "description": "Pope during the Counter-Reformation, known for his policies.", "note": "Both 'Papa Paulo IV' and 'Paulo IV.' clearly refer to Pope Paul IV, a significant figure in the 16th century, aligning with the early modern period.", "wikidata_id": "Q101430", "wikidata_description": "pope of catholic church 1555-1559", "wikipedia_extract": "This page is a list of popes by country of origin and nationality. There have been 265 popes, from the continents of Asia, Europe, Africa, South America, and North America. Since the office of pope has existed for almost two millennia, many of the countries of origin of popes no longer exist, and so they are grouped under three periods: the Roman Empire period, the Middle Ages to modernity, and since the creation of Vatican City with the 1929 Lateran Treaty. Countries are listed in chronological order within each section. As of 2025, 265 men have been pope, with at least one pope hailing (in chronological order) from Asia (9), Europe (251), Africa (3), or the Americas (2). Every pope since Pope Pius XI has been a citizen of Vatican City (established in the 1929 Lateran Treaty).", "wikipedia_url": "https://en.wikipedia.org/wiki/Pope_Paul_IV"}}, {"canonical_name": "Bonifá", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "bonifá", "book_id": "coloquios_da_orta_1563", "name": "Bonifá", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Bonifá"], "contexts": ["cited authority", "cited by Serapio"]}, {"entity_id": "bonifucci", "book_id": "polyanthea_medicinal", "name": "Bonifucci", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Bonifucci"], "contexts": ["cited author on nourishing foods"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Bonifá", "target_book": "polyanthea_medicinal", "target_name": "Bonifucci", "similarity": 0.91}], "id": 1709, "stable_key": "clu_74f94c549b5d15f6", "ground_truth": {"modern_name": "Boniface", "confidence": "medium", "type": "person", "description": "Cited authority on nutrition and health in early modern texts.", "note": "The name 'Bonifá' and 'Bonifucci' likely refer to an author or scholar cited in these texts. The common element is 'Boniface'. It's difficult to pinpoint a specific historical figure with certainty without more context, but it refers to a cited authority.", "wikidata_id": "Q37323384", "wikidata_description": "family name", "wikipedia_extract": "The Université de Saint-Boniface (USB) is a French-language public university located in the St. Boniface neighbourhood of Winnipeg, Manitoba, Canada. An affiliated institution of the University of Manitoba, the university offers general and specialized university degree programs as well as technical and professional training. In 2014, 1,368 regular students were enrolled. Its Continuing Education Division, which includes a language school, has also counted over 4,200 enrolments. Université de Saint-Boniface was established by Father Norbert Provencher (1787–1853) in 1818, making it western Canada's oldest post-secondary educational institution.", "wikipedia_url": "https://en.wikipedia.org/wiki/Boniface_%28name%29"}}, {"canonical_name": "nespereira", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "nespereira", "book_id": "coloquios_da_orta_1563", "name": "nespereira", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["nespereira"], "contexts": ["tree where lacre does not grow", "tree name"]}, {"entity_id": "neſperas", "book_id": "polyanthea_medicinal", "name": "neſperas", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["neſperas"], "contexts": ["loquats"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "nespereira", "target_book": "polyanthea_medicinal", "target_name": "neſperas", "similarity": 0.869}], "id": 1710, "stable_key": "clu_6ea773ce24e8f756", "ground_truth": {"modern_name": "Loquat", "confidence": "high", "type": "plant", "linnaean": "Eriobotrya japonica Lindl.", "family": "Rosaceae", "note": "The term 'nespereira' in Portuguese and Spanish refers to the loquat tree. The mention of 'lacre' (lacquer) is likely a misunderstanding or a localized use, as loquats are not typically associated with lacquer production.", "wikidata_id": "Q41505", "wikidata_description": "species of plant, Loquat", "wikipedia_url": "https://en.wikipedia.org/wiki/Loquat", "wikipedia_extract": "The loquat (Eriobotrya japonica, Chinese: 枇杷; Pinyin: pípá) is a large evergreen shrub or tree grown commercially for its orange coloured fruits. It is also cultivated as an ornamental plant. The loquat is in the family Rosaceae, subfamily Spiraeoideae, tribe Pyreae, subtribe Pyrinae. It is native to the cooler hill regions of south-central China. In Japan, the loquat has been grown for over 1,000 years. It has been introduced to regions with subtropical to mild temperate climates throughout the world."}}, {"canonical_name": "cão danado", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cão_danado", "book_id": "polyanthea_medicinal", "name": "cão danado", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["cão danado"], "contexts": ["rabid dog", "mad dog"]}, {"entity_id": "doença_do_cão", "book_id": "coloquios_da_orta_1563", "name": "doença do cão", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["doença do cão"], "contexts": ["disease of the dog"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "cão danado", "target_book": "coloquios_da_orta_1563", "target_name": "doença do cão", "similarity": 0.863}], "id": 1711, "stable_key": "clu_aa65e9a831957dde", "ground_truth": {"modern_name": "Rabies", "confidence": "high", "type": "disease", "modern_term": "Rabies", "note": "'Cão danado' literally translates to 'mad dog' and is a common historical term for rabies.", "wikidata_id": "Q39222", "wikidata_description": "deadly viral disease, transmitted through animals", "wikipedia_url": "https://en.wikipedia.org/wiki/Rabies"}}, {"canonical_name": "caroços de tamara", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "caroços_de_tamara", "book_id": "polyanthea_medicinal", "name": "caroços de tamara", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["caroços de tamara", "caroço de tamara"], "contexts": ["plant material for treatment", "date pit used in preparation"]}, {"entity_id": "caroços_do_tamarinho", "book_id": "coloquios_da_orta_1563", "name": "caroços do tamarinho", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["caroços do tamarinho"], "contexts": ["fruit pit similar to anacardo"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "caroços de tamara", "target_book": "coloquios_da_orta_1563", "target_name": "caroços do tamarinho", "similarity": 0.9}], "id": 1712, "stable_key": "clu_899af0915ba9a003", "ground_truth": {"modern_name": "Date pit", "confidence": "medium", "type": "plant", "note": "The term 'caroços de tamara' or 'tamarinho' refers to the pits of dates. While the context mentions similarity to 'anacardo' (cashew), the primary referent is the date pit itself.", "wikidata_id": "Q135287262", "wikidata_description": "the inner hard thing in the date fruit"}}, {"canonical_name": "lirios brancos", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "lirios_brancos", "book_id": "polyanthea_medicinal", "name": "lirios brancos", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["lirios brancos", "lilios brancos"], "contexts": ["white lilies used in fomentations", "white lilies used in preparation"]}, {"entity_id": "lirío_branco", "book_id": "coloquios_da_orta_1563", "name": "lirío branco", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["lirío branco"], "contexts": ["white lily, benchmark for scent"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "lirios brancos", "target_book": "coloquios_da_orta_1563", "target_name": "lirío branco", "similarity": 0.919}], "id": 1713, "stable_key": "clu_3dc246d6c542b160", "ground_truth": {"modern_name": "White lily", "confidence": "high", "type": "plant", "linnaean": "Lilium candidum L.", "family": "Liliaceae", "note": "The term 'lirios brancos' clearly refers to white lilies, often used in historical medicinal contexts for their properties and scent.", "wikidata_id": "Q159811", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Lilium%20candidum", "wikipedia_extract": "Lilium candidum, the Madonna lily or white lily, is a plant in the true lily family. It is native to the Balkans and Middle East, and naturalized in other parts of Europe, including France, Italy, and Ukraine, and in North Africa, the Canary Islands, Mexico, and other regions. It has been cultivated since antiquity, for at least 3,000 years, and has great symbolic value since then for many cultures. It is susceptible to several virus diseases common to lilies, and especially to Botrytis fungus. One technique to avoid problems with viruses is to grow plants from seed instead of bulblets. It forms bulbs at ground level, and, unlike other lilies, grows a basal rosette of leaves during winter, which die the following summer."}}, {"canonical_name": "casia", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "casia", "book_id": "coloquios_da_orta_1563", "name": "casia", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["casia"], "contexts": ["name applied to bark and trunks of Cinnamomum"]}, {"entity_id": "casia", "book_id": "polyanthea_medicinal", "name": "Casia", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Casia"], "contexts": ["cassia"]}, {"entity_id": "casè", "book_id": "polyanthea_medicinal", "name": "Casè", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Casè"], "contexts": ["plant used as medicine"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "casia", "target_book": "polyanthea_medicinal", "target_name": "Casia", "similarity": 0.899}, {"source_book": "coloquios_da_orta_1563", "source_name": "casia", "target_book": "polyanthea_medicinal", "target_name": "Casè", "similarity": 0.845}], "id": 1714, "stable_key": "clu_2112ad8f7763c400", "ground_truth": {"modern_name": "Cassia", "confidence": "high", "type": "plant", "linnaean": "Cinnamomum aromaticum Nees", "family": "Lauraceae", "note": "The term 'casia' in early modern Portuguese and Spanish medical texts often referred to the bark of the cinnamon tree, specifically the species now known as Cinnamomum aromaticum or Cinnamomum verum. The context of bark and trunks confirms this identification.", "wikidata_id": "Q162882", "wikidata_description": "genus of plants", "wikipedia_extract": "Cassia, Kezia or Keziah, a female surname of Biblical origin the female gentilicium name of the Cassia gens in ancient Rome Cassia or Kassia, Byzantine abbess and music scholar Cássia Eller (1962–2001), Brazilian musician Cássia Kiss (born 1958), Brazilian actress Cassià Maria Just (1926–2008), Catalan abbot Cassia O'Reilly (born 1996), Irish singer-songwriter Cassia, a fictional playable character in Heroes of the Storm Cassia Maria Reyes, the protagonist of the Matched trilogy by Ally Condie", "wikipedia_url": "https://en.wikipedia.org/wiki/Cassia_%28genus%29"}}, {"canonical_name": "queijos", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "queijos", "book_id": "polyanthea_medicinal", "name": "queijos", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 2, "variants": ["queijos"], "contexts": ["dairy product", "cheeses causing harm to kidneys"]}, {"entity_id": "queijo_de_ovelhas", "book_id": "coloquios_da_orta_1563", "name": "queijo de ovelhas", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["queijo de ovelhas"], "contexts": ["sheep's cheese"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "queijos", "target_book": "coloquios_da_orta_1563", "target_name": "queijo de ovelhas", "similarity": 0.848}], "id": 1715, "stable_key": "clu_b9071a067feaf5ec", "ground_truth": {"modern_name": "Sheep's cheese", "confidence": "high", "type": "food", "note": "Although listed under ANIMAL, 'queijos' and 'queijo de ovelhas' refer to a food product derived from animals (sheep's milk)."}}, {"canonical_name": "gergelim", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "gergelim", "book_id": "polyanthea_medicinal", "name": "gergelim", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["gergelim"], "contexts": ["oil used in a liniment", "sesame used in fomentations"]}, {"entity_id": "gergelim", "book_id": "coloquios_da_orta_1563", "name": "gergelim", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["gergelim"], "contexts": ["sesame, used for oil"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "gergelim", "target_book": "coloquios_da_orta_1563", "target_name": "gergelim", "similarity": 1.0}], "id": 1716, "stable_key": "clu_807d59637c2019e7", "ground_truth": {"modern_name": "Sesame", "confidence": "high", "type": "plant", "linnaean": "Sesamum indicum L.", "family": "Pedaliaceae", "note": "The term 'gergelim' is the Portuguese word for sesame, a plant well-known for its oil used in medicinal preparations.", "wikipedia_extract": "Sesame (; Sesamum indicum) is a plant in the genus Sesamum, also called benne. Numerous wild relatives occur in Africa and a smaller number in India. It is widely naturalized in tropical regions around the world and is cultivated for its edible seeds, which grow in pods. World production in 2018 was 6 million tonnes (5.9 million long tons), with Sudan, Myanmar, and India as the largest producers. Sesame seed is one of the oldest oilseed crops known, domesticated well over 3,000 years ago. Sesamum has many other species, most being wild and native to sub-Saharan Africa.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sesame"}}, {"canonical_name": "expelir", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "expelir", "book_id": "coloquios_da_orta_1563", "name": "expelir", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["expelir"], "contexts": ["bodily function of expulsion"]}, {"entity_id": "exficcantur", "book_id": "polyanthea_medicinal", "name": "exficcantur", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["exficcantur"], "contexts": ["drying effect of baths"]}, {"entity_id": "expellir", "book_id": "polyanthea_medicinal", "name": "expellir", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["expellir"], "contexts": ["to expel"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "expelir", "target_book": "polyanthea_medicinal", "target_name": "exficcantur", "similarity": 0.846}, {"source_book": "coloquios_da_orta_1563", "source_name": "expelir", "target_book": "polyanthea_medicinal", "target_name": "expellir", "similarity": 0.922}], "id": 1717, "stable_key": "clu_5bb1d60771b8fdac", "ground_truth": {"modern_name": "Expulsion", "confidence": "high", "type": "concept", "note": "The Latin 'exficcantur' and Portuguese 'expelir' both refer to the act of expelling or emitting, a common concept in early modern medicine relating to bodily fluids and processes."}}, {"canonical_name": "nerari", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "nerari", "book_id": "polyanthea_medicinal", "name": "nerari", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["nerari"], "contexts": ["nerves", "nerves, part of nervous system"]}, {"entity_id": "neruos", "book_id": "coloquios_da_orta_1563", "name": "neruos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["neruos"], "contexts": ["affected by cramps"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "nerari", "target_book": "coloquios_da_orta_1563", "target_name": "neruos", "similarity": 0.94}], "id": 1718, "stable_key": "clu_4630e36e6abf5885", "ground_truth": {"modern_name": "nerves", "confidence": "high", "type": "concept", "note": "The text mentions 'neruos' and 'nerari' in the context of nerves affected by cramps, pointing to the anatomical concept of nerves.", "wikidata_id": "Q3234179", "wikidata_description": "short story by Anton Chekhov", "wikipedia_extract": "A nerve is an enclosed, cable-like bundle of nerve fibers (called axons). Nerves have historically been considered the basic units of the peripheral nervous system. A nerve provides a common pathway for the electrochemical nerve impulses called action potentials that are transmitted along each of the axons to peripheral organs or, in the case of sensory nerves, from the periphery back to the central nervous system. Each axon is an extension of an individual neuron, along with other supportive cells such as some Schwann cells that coat the axons in myelin. Each axon is surrounded by a layer of connective tissue called the endoneurium. The axons are bundled together into groups called fascicles, and each fascicle is wrapped in a layer of connective tissue called the perineurium.", "wikipedia_url": "https://fr.wikipedia.org/wiki/Les_Nerfs"}}, {"canonical_name": "autopsia", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "autopsia", "book_id": "polyanthea_medicinal", "name": "autopsia", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["autopsia"], "contexts": ["autopsy", "examination of bodies"]}, {"entity_id": "autopsia", "book_id": "coloquios_da_orta_1563", "name": "autopsia", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["autopsia"], "contexts": ["examination of a dead body"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "autopsia", "target_book": "coloquios_da_orta_1563", "target_name": "autopsia", "similarity": 1.0}], "id": 1719, "stable_key": "clu_0617dd5d660b4fef", "ground_truth": {"wikipedia_extract": "Autopsia is a European art project focused on music and visual production, gathering authors of different professions in the realization of multimedia projects. Its art practice began in London in the late 1970s and continued during the 1980s in the former Yugoslavia. Since 1990, Autopsia has been based in Prague, Czech Republic. At the beginning of its activity, Autopsia issued dozens of mini-recordings. In the period after 1989, twenty CDs were issued, at first for Staalplaat, then for German label Hypnobeat and London's Gymnastic Records. One of its compositions is a part of the soundtrack for Peter Greenaway's The Pillow Book (1996)."}}, {"canonical_name": "corno de Veado", "category": "ANIMAL", "subcategory": "ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "corno_de_veado", "book_id": "polyanthea_medicinal", "name": "corno de Veado", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 2, "variants": ["corno de Veado", "corno de veado volatil"], "contexts": ["deer horn, source of spirit", "volatile hartshorn spirit"]}, {"entity_id": "couro_de_veado", "book_id": "coloquios_da_orta_1563", "name": "couro de veado", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["couro de veado"], "contexts": ["material for ropes"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "corno de Veado", "target_book": "coloquios_da_orta_1563", "target_name": "couro de veado", "similarity": 0.873}], "id": 1720, "stable_key": "clu_a234d4a2e9484764", "ground_truth": {"modern_name": "deer horn", "confidence": "high", "type": "animal", "note": "The term 'corno de Veado' directly translates to deer horn. While 'couro de veado' is deer hide, the primary mention of 'corno de Veado' suggests deer horn as a substance.", "wikidata_id": "Q5250858", "wikidata_description": "Vehicle-mounted wildlife warning device", "wikipedia_url": "https://en.wikipedia.org/wiki/Deer%20horn", "wikipedia_extract": "A deer horn, or deer whistle, is a whistle mounted on automobiles intended to help prevent collisions with deer. Air moving through the device produces sound (ultrasound in some models), intended to warn deer of a vehicle's approach. Deer are highly unpredictable, skittish animals whose normal reaction to an unfamiliar sound is to stop, look and listen to determine if they are being threatened. If the whistle gives them advance warning, they may freeze on the roadside, rather than running across the road into the path of the vehicle. In Australia, a different product, with electrically powered speakers (Shu Roo), is used to decrease collisions with kangaroos. Researchers with the University of Wisconsin–Madison measured three devices and a press report said they found these three devices produced \"low-pitched and ultrasonic sounds at speeds of 30 to 70 miles per hour; however, researchers were unable to verify that deer responded to the sounds.\" Researchers with the Georgia Game and Fish Department have pointed out several reasons for ultrasound devices not to work as advertised: Some deer whistles do not emit any ultrasonic sound under the advertised operating conditions (typically when the vehicle exceeds 30 mph)."}}, {"canonical_name": "Villa-Nova", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "villa-nova", "book_id": "polyanthea_medicinal", "name": "Villa-Nova", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Villa-Nova"], "contexts": ["residence of the Countess", "Location associated with a noblewoman"]}, {"entity_id": "villa_nova_de_portimão", "book_id": "coloquios_da_orta_1563", "name": "Villa Nova de Portimão", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Villa Nova de Portimão"], "contexts": ["estate owned by nobleman"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Villa-Nova", "target_book": "coloquios_da_orta_1563", "target_name": "Villa Nova de Portimão", "similarity": 0.868}], "id": 1721, "stable_key": "clu_0982c0fc8cf4e8d0", "ground_truth": {"modern_name": "Vila Nova de Portimão", "confidence": "high", "type": "place", "country": "Portugal", "note": "The mention of 'Villa Nova de Portimão' in one text and 'Villa-Nova' in another, with context suggesting specific locations, leads to this identification.", "wikidata_id": "Q5176798", "wikidata_description": "noble title in the Kingdom of Portugal", "wikipedia_url": "https://en.wikipedia.org/wiki/Count%20of%20Vila%20Nova%20de%20Portim%C3%A3o"}}, {"canonical_name": "golfaó", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "golfaó", "book_id": "polyanthea_medicinal", "name": "golfaó", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["golfaó"], "contexts": ["plant used with ointment", "plant for fluxes"]}, {"entity_id": "golfam", "book_id": "coloquios_da_orta_1563", "name": "golfam", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["golfam"], "contexts": ["plant with similar appearance"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "golfaó", "target_book": "coloquios_da_orta_1563", "target_name": "golfam", "similarity": 0.91}], "id": 1722, "stable_key": "clu_01388f68f59758ad", "ground_truth": {"modern_name": "gulfam", "confidence": "medium", "type": "plant", "note": "The terms 'golfaó' and 'golfam' appear in contexts of medicinal use and visual similarity. Without more specific botanical descriptions, precise identification is difficult. 'Gulfam' can refer to various plants in different regions."}}, {"canonical_name": "aguda", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "aguda", "book_id": "polyanthea_medicinal", "name": "aguda", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["aguda"], "contexts": ["describing illness", "sharp, a quality of pain"]}, {"entity_id": "agudo", "book_id": "coloquios_da_orta_1563", "name": "agudo", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["agudo"], "contexts": ["quality of açoro and calamo aromático"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "aguda", "target_book": "coloquios_da_orta_1563", "target_name": "agudo", "similarity": 0.881}], "id": 1723, "stable_key": "clu_8becf7f15f129da4", "ground_truth": {"modern_name": "acute", "confidence": "high", "type": "concept", "note": "The terms 'aguda' and 'agudo' are used to describe illnesses and qualities of substances, aligning with the concept of 'acute'.", "wikidata_id": "Q24706667", "wikidata_description": "conference abstract published in 2004"}}, {"canonical_name": "Dom Affonio V", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "dom_affonio_v", "book_id": "polyanthea_medicinal", "name": "Dom Affonio V", "category": "PERSON", "subcategory": "PATRON", "count": 2, "variants": ["Dom Affonio V", "Dom Affonfo Sexto"], "contexts": ["King whose chapel scribe suffered", "King"]}, {"entity_id": "d__affonso_v", "book_id": "coloquios_da_orta_1563", "name": "D. Affonso V", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["D. Affonso V"], "contexts": ["king whose cruzado value is noted"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Dom Affonio V", "target_book": "coloquios_da_orta_1563", "target_name": "D. Affonso V", "similarity": 0.909}], "id": 1724, "stable_key": "clu_3dcb9a4922236cf8", "ground_truth": {"modern_name": "Afonso V of Portugal", "confidence": "high", "type": "person", "birth_year": 1432, "death_year": 1481, "description": "King of Portugal, mentioned in historical contexts.", "wikipedia_extract": "Afonso V (European Portuguese: [ɐˈfõsu]; 15 January 1432 – 28 August 1481), also known as the African (Portuguese: o Africano), was King of Portugal from 1438 until he died in 1481, with a brief interruption in 1477. The son of Edward, King of Portugal, and Eleanor of Aragon, Afonso acceded to the throne when he was only six years old. His early reign was marked by a struggle over the regency between his mother, Eleanor, and his uncle, Pedro, Duke of Coimbra. Pedro was appointed sole regent in 1439, but the Braganza faction at court continued to challenge his authority. Influenced by his other uncle, Afonso I, Duke of Braganza, the King dismissed Pedro in 1448 and defeated him in the Battle of Alfarrobeira in 1449. Between 1458 and 1471, Afonso pursued military campaigns in Africa, concentrating efforts predominantly on Morocco."}}, {"canonical_name": "cantari", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cantari", "book_id": "polyanthea_medicinal", "name": "cantari", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["cantari", "cantari­das"], "contexts": ["medical condition, likely cantharides poisoning", "blisters, likely from cantharides"]}, {"entity_id": "cantaras", "book_id": "coloquios_da_orta_1563", "name": "cantaras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["cantaras"], "contexts": ["illness treated by herpas"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "cantari", "target_book": "coloquios_da_orta_1563", "target_name": "cantaras", "similarity": 0.973}], "id": 1725, "stable_key": "clu_42cbe44edea3892e", "ground_truth": {"modern_name": "cantharidism", "confidence": "high", "type": "disease", "modern_term": "cantharidism", "note": "The terms 'cantari' and 'cantaras' in a medical context, particularly with the mention of treatment by 'herpas' (likely referring to cantharides), strongly suggest cantharidism (poisoning from blister beetles).", "wikipedia_extract": "Morgan le Fay (; Welsh and Cornish: Morgen; Modern French: Fée Morgane), alternatively known as Morgan[n]a, Morgain[a/e], Morgant[e], Morg[a]ne, Morgayn[e], Morgein[e], and Morgue[in] among other names and spellings, is a powerful and ambiguous enchantress from the legend of King Arthur, in which most often she and he are siblings. According to the different authors, she is a fairy or a human; beneficial or harmful; either a sister, half-sister, or unrelated to Arthur. A significant aspect in many of Morgan's medieval and later iterations is the unpredictable duality of her nature, with potential for both good and evil. Her character may have originated from Welsh mythology as well as from other ancient and medieval myths and historical figures. Early appearances of Morgan in Arthurian literature do not elaborate her character beyond her role as a goddess, a fay, a witch, or a sorceress, generally benevolent and connected to Arthur as his magical saviour and protector. The earliest documented account, by Geoffrey of Monmouth in Vita Merlini (written c.", "wikipedia_url": "https://en.wikipedia.org/wiki/Morgan_le_Fay"}}, {"canonical_name": "Eaglewood", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "eaglewood", "book_id": "polyanthea_medicinal", "name": "Eaglewood", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Eaglewood"], "contexts": ["used for perfuming"]}, {"entity_id": "eagle_wood", "book_id": "coloquios_da_orta_1563", "name": "eagle wood", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["eagle wood"], "contexts": ["English name for aloes wood"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Eaglewood", "target_book": "coloquios_da_orta_1563", "target_name": "eagle wood", "similarity": 0.892}], "id": 1726, "stable_key": "clu_82bbc172068defd7", "ground_truth": {"wikipedia_extract": "Agarwood, aloeswood, eaglewood, gaharuwood, commonly referred to as oud or oudh (from Arabic: عود, romanized: ʿūd, pronounced [ʕuːd]), is a fragrant, dark and resinous wood used in incense, perfume, and small hand carvings. It forms in the heartwood of Aquilaria trees after they become infected with a type of Phaeoacremonium mold, P. parasitica. The tree defensively secretes a resin to combat the fungal infestation. Prior to becoming infected, the heartwood mostly lacks scent, and is relatively light and pale in colouration. However, as the infection advances and the tree produces its fragrant resin as a final option of defense, the heartwood becomes very dense, dark, and saturated with resin. This product is harvested, and most famously referred to in cosmetics under the scent names of oud, oodh or aguru; however, it is also called aloes (not to be confused with the succulent plant genus Aloe), agar (this name, as well, is not to be confused with the edible, algae-derived thickening agent agar agar), as well as gaharu or jinko."}}, {"canonical_name": "çumo de limões", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "çumo_de_limões", "book_id": "coloquios_da_orta_1563", "name": "çumo de limões", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["çumo de limões"], "contexts": ["juice of lemons used in medicine"]}, {"entity_id": "çumo_de_limão_galego", "book_id": "polyanthea_medicinal", "name": "çumo de limão galego", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["çumo de limão galego"], "contexts": ["juice of a specific type of lemon"]}, {"entity_id": "çumo_de_raiz_de_lirio", "book_id": "polyanthea_medicinal", "name": "çumo de raiz de lirio", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["çumo de raiz de lirio"], "contexts": ["ingredient in a preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "çumo de limões", "target_book": "polyanthea_medicinal", "target_name": "çumo de limão galego", "similarity": 0.889}, {"source_book": "coloquios_da_orta_1563", "source_name": "çumo de limões", "target_book": "polyanthea_medicinal", "target_name": "çumo de raiz de lirio", "similarity": 0.844}], "id": 1727, "stable_key": "clu_55cc3676d9744f64", "ground_truth": {"modern_name": "lemon juice", "confidence": "high", "type": "plant", "linnaean": "Citrus × limon", "family": "Rutaceae", "note": "The terms 'çumo de limões', 'çumo de limão galego', and 'çumo de raiz de lirio' all refer to juices used medicinally. 'Çumo de limões' and 'çumo de limão galego' are clearly lemon juice. 'Çumo de raiz de lirio' is lily root juice, but the cluster is primarily about citrus juice given the dominant terms.", "wikidata_id": "Q1375049", "wikidata_description": "fruit juice", "wikipedia_extract": "The lemon (Citrus × limon) is a species of small evergreen tree in the Citrus genus of the flowering plant family Rutaceae. A true lemon is a hybrid of the citron and the bitter orange. Its origins are uncertain, but some evidence suggests lemons originated during the 1st millennium BC in what is now northeastern India. Some other citrus fruits are called lemon. The yellow fruit of the lemon tree is used throughout the world, primarily for its juice. The pulp and rind are used in cooking and baking."}}, {"canonical_name": "coentro seco", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "coentro_seco", "book_id": "polyanthea_medicinal", "name": "coentro seco", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["coentro seco"], "contexts": ["dried coriander", "dried herb used in an electuary"]}, {"entity_id": "coentro_seco", "book_id": "coloquios_da_orta_1563", "name": "coentro seco", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["coentro seco"], "contexts": ["herb used for seasoning"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "coentro seco", "target_book": "coloquios_da_orta_1563", "target_name": "coentro seco", "similarity": 1.0}], "id": 1728, "stable_key": "clu_37d6d2a1592c3608", "ground_truth": {"modern_name": "Coriander", "confidence": "high", "type": "plant", "linnaean": "Coriandrum sativum", "family": "Apiaceae", "wikidata_id": "Q41611", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Coriander", "wikipedia_extract": "Coriander (), or Coriandrum sativum, is an annual herb in the family Apiaceae. The leaves are known as cilantro () in the United States (but not in the United Kingdom). Most people perceive the leaves as having a fresh, slightly citrus taste. Due to variations in the gene OR6A2, some people perceive its flavor to be more soaplike or rotten. The species is native to the Mediterranean Basin. All parts of the plant are edible, with the fresh leaves and dried seeds most traditionally used in cooking."}}, {"canonical_name": "Artetica", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "artetica", "book_id": "polyanthea_medicinal", "name": "Artetica", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["Artetica", "artetica"], "contexts": ["herb added to artificial baths", "disease affecting all joints"]}, {"entity_id": "artetica", "book_id": "coloquios_da_orta_1563", "name": "artetica", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["artetica"], "contexts": ["gout"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Artetica", "target_book": "coloquios_da_orta_1563", "target_name": "artetica", "similarity": 0.914}], "id": 1729, "stable_key": "clu_3a2dff5b25909966", "ground_truth": {"modern_name": "Gout", "confidence": "high", "type": "disease", "modern_term": "Gout", "wikidata_id": "Q133087", "wikidata_description": "medical condition that results in recurrent pain and swelling of joints", "wikipedia_url": "https://en.wikipedia.org/wiki/Gout", "wikipedia_extract": "Gout ( GOWT) is a form of inflammatory arthritis characterized by recurrent attacks of pain in a red, tender, hot, and swollen joint, caused by the deposition of needle-shaped crystals of the monosodium salt of uric acid. Pain typically comes on rapidly, reaching maximal intensity in less than 12 hours. In about half of cases, the joint at the base of the big toe is affected (Podagra). It may also result in tophi, kidney stones, or kidney damage. Gout is due to persistently elevated levels of uric acid (urate) in the blood (hyperuricemia). This occurs from a combination of diet, other health problems, and genetic factors."}}, {"canonical_name": "ethicas", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ethicas", "book_id": "polyanthea_medicinal", "name": "ethicas", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["ethicas", "Eticos"], "contexts": ["chronic fevers", "etics, and tics, or internal inflammations"]}, {"entity_id": "ético", "book_id": "coloquios_da_orta_1563", "name": "ético", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["ético"], "contexts": ["consumptive"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "ethicas", "target_book": "coloquios_da_orta_1563", "target_name": "ético", "similarity": 0.926}], "id": 1730, "stable_key": "clu_cafb28883b57fba2", "ground_truth": {"modern_name": "Phthisis", "confidence": "high", "type": "disease", "modern_term": "Tuberculosis", "note": "The term 'ethicas' is a Latinized form of Greek 'ethos' or 'ethikos', often referring to habit or custom. In a medical context, it could describe chronic or habitual fevers or a consumptive state.", "wikidata_id": "Q12204", "wikidata_description": "infectious disease caused by the bacterium Mycobacterium tuberculosis", "wikipedia_url": "https://en.wikipedia.org/wiki/Ethics", "wikipedia_extract": "Ethics is the philosophical study of moral phenomena. Also called moral philosophy, it investigates normative questions about what people ought to do or which behavior is morally right. Its main branches include normative ethics, applied ethics, and metaethics. Normative ethics aims to find general principles that govern how people should act. Applied ethics examines concrete ethical problems in real-life situations, such as abortion, treatment of animals, and business practices. Metaethics explores the underlying assumptions and concepts of ethics."}}, {"canonical_name": "aballo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "aballo", "book_id": "polyanthea_medicinal", "name": "aballo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["aballo", "abalo"], "contexts": ["shaking or agitation", "shock or disturbance"]}, {"entity_id": "awál", "book_id": "coloquios_da_orta_1563", "name": "awál", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["awál"], "contexts": ["term related to medicine"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "aballo", "target_book": "coloquios_da_orta_1563", "target_name": "awál", "similarity": 0.851}], "id": 1731, "stable_key": "clu_21f91ca1df753ccc", "ground_truth": {"wikipedia_extract": "Avallon (French pronunciation: [avalɔ̃] ) is a commune in the Burgundian department of Yonne, in France. Avallon, Latin Aballō, ablative Aballone, is ultimately derived from Gaulish *Aballū, oblique *Aballon- meaning \"Apple-tree (place)\" or \"(place of the) \"Apple Tree Goddess\" (from Proto-Celtic *abalnā, cf. Old Irish aball, Welsh afall, Old Breton aball(en), \"apple tree\"). Avallon is located 50 km south-southeast of Auxerre, served by a branch of the Paris–Lyon railway and by exit 22 of the A6 motorway. The old town, with many winding cobblestone streets flanked by traditional stone and woodwork buildings, is situated on a flat promontory, the base of which is washed on the south by the river Cousin, on the east and west by small streams. Chance finds of coins and pottery fragments and a fine head of Minerva are reminders of the Roman settlement carrying the Celtic name Aballo, a mutatio or post where fresh horses could be obtained."}}, {"canonical_name": "Amaranthus", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "amaranthus", "book_id": "polyanthea_medicinal", "name": "Amaranthus", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["Amaranthus", "amaranthus"], "contexts": ["immortal plant, symbolizing immortality", "plant name"]}, {"entity_id": "amarindo", "book_id": "coloquios_da_orta_1563", "name": "amarindo", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["amarindo"], "contexts": ["medicinal fruit"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Amaranthus", "target_book": "coloquios_da_orta_1563", "target_name": "amarindo", "similarity": 0.861}], "id": 1732, "stable_key": "clu_5d9fcc2002f60302", "ground_truth": {"wikipedia_extract": "Amaranthus is a genus of plants commonly known as amaranths. Some species are known by variants of the common name \"pigweed\". Some members are annual and others are perennial. The plant can grow from 1 to 2.5 metres (3 to 8 feet) tall with a succulent, hollow stem. Parts of the plant vary from green to reddish. Catkin-like cymes of densely packed flowers grow in the summer or fall."}}, {"canonical_name": "raiz de equiceto", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "raiz_de_equiceto", "book_id": "polyanthea_medicinal", "name": "raiz de equiceto", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["raiz de equiceto", "raiz chamada equiceto"], "contexts": ["plant root, horsetail", "horsetail root"]}, {"entity_id": "raiz_do_esquinanto", "book_id": "coloquios_da_orta_1563", "name": "raiz do esquinanto", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["raiz do esquinanto"], "contexts": ["not Galanga"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "raiz de equiceto", "target_book": "coloquios_da_orta_1563", "target_name": "raiz do esquinanto", "similarity": 0.847}], "id": 1733, "stable_key": "clu_7427581efc1f82c5", "ground_truth": {"modern_name": "Horsetail", "confidence": "high", "type": "plant", "linnaean": "Equisetum arvense", "family": "Equisetaceae", "note": "The term 'esquinanto' could be a variant spelling of 'equinanto', which points to Equisetum. The context excludes Galanga.", "wikidata_id": "Q107592", "wikidata_description": "species of plant", "wikipedia_extract": "Equisetum arvense, commonly known as field horsetail or common horsetail, is a species of vascular plant in the horsetail family Equisetaceae. Like all horsetails, it is a type of fern. It is native throughout the arctic and temperate regions of the Northern Hemisphere. It has two distinct growth forms, a fertile spore-bearing stem and a sterile green stem. It is sometimes confused with mare's tail, Hippuris vulgaris. Equisetum arvense is a perennial herbaceous plant that spreads by means of an underground rhizome."}}, {"canonical_name": "Antarctíc", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "antarctíc", "book_id": "coloquios_da_orta_1563", "name": "Antarctíc", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Antarctíc"], "contexts": ["region name", "name of a whaling ship"]}, {"entity_id": "α_antaris", "book_id": "connexion_physical_sciences_somerville_1858", "name": "α Antaris", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["α Antaris"], "contexts": ["star in Scorpius constellation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Antarctíc", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "α Antaris", "similarity": 0.909}], "id": 1734, "stable_key": "clu_7b7db2db39b76a13", "ground_truth": {"modern_name": "Antares", "confidence": "high", "type": "person", "description": "Bright star in the constellation Scorpius.", "note": "The primary reference is to Antares, a star. The 'Antarctíc' refers to the Antarctic region, but the star reference is stronger given the 'α Antaris' mention.", "wikidata_id": "Q113662422", "wikidata_description": "genus of sponge", "wikipedia_extract": "Antares is the brightest star in the constellation of Scorpius. It has the Bayer designation α Scorpii, which is Latinised to Alpha Scorpii. Often referred to as \"the heart of the scorpion\", Antares is flanked by σ Scorpii and τ Scorpii near the center of the constellation. Distinctly reddish when viewed with the naked eye, Antares is a slow irregular variable star that ranges in brightness from an apparent visual magnitude of +0.6 down to +1.6. It is on average the fifteenth-brightest star in the night sky. Antares is the brightest and most evolved stellar member of the Scorpius–Centaurus association, the nearest OB association to the Sun."}}, {"canonical_name": "Tutia preparada", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tutia_preparada", "book_id": "polyanthea_medicinal", "name": "Tutia preparada", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Tutia preparada"], "contexts": ["mixed with ointment for itching", "prepared tutty used in eye wash"]}, {"entity_id": "tuzia_preparata", "book_id": "ricettario_fiorentino_1597", "name": "Tuzia preparata", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Tuzia preparata"], "contexts": ["prepared tutty used in powders"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Tutia preparada", "target_book": "ricettario_fiorentino_1597", "target_name": "Tuzia preparata", "similarity": 0.927}], "id": 1735, "stable_key": "clu_5a2b5b77cff898cf", "ground_truth": {"modern_name": "Tutty", "confidence": "high", "type": "mineral", "wikidata_id": "Q37228363", "wikidata_description": "family name", "wikipedia_extract": "Domestic violence (DV) is violence that occurs in a domestic setting, such as in a marriage or cohabitation. In a broader sense, abuse including nonphysical abuse in such settings is called domestic abuse. The term domestic violence is often used as a synonym for intimate partner violence, which is committed by one of the people in an intimate relationship against the other, and can take place in relationships or between former spouses or partners. In a broader sense, the term can also refer to violence against one's family members, such as children, siblings or parents. Forms of domestic abuse include physical, verbal, emotional, financial, religious, reproductive and sexual. It can range from subtle, coercive forms to marital rape and other violent physical abuse, such as choking, beating, female genital mutilation, and acid throwing that may result in disfigurement or death, and includes the use of technology to harass, control, monitor, stalk or hack.", "wikipedia_url": "https://en.wikipedia.org/wiki/Domestic_violence"}}, {"canonical_name": "confeyçam Anacardina", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "confeyçam_anacardina", "book_id": "polyanthea_medicinal", "name": "confeyçam Anacardina", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["confeyçam Anacardina", "confeyção Anacardina"], "contexts": ["Anacardine confection for memory loss", "remedy to be given"]}, {"entity_id": "confettione_anacardinadi", "book_id": "ricettario_fiorentino_1597", "name": "Confettione anacardinadi", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Confettione anacardinadi"], "contexts": ["anacardine confection"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "confeyçam Anacardina", "target_book": "ricettario_fiorentino_1597", "target_name": "Confettione anacardinadi", "similarity": 0.844}], "id": 1736, "stable_key": "clu_195451b719efae25", "ground_truth": {"modern_name": "Anacardine Confection", "confidence": "high", "type": "preparation"}}, {"canonical_name": "Elixir vitæ", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "elixir_vitæ", "book_id": "polyanthea_medicinal", "name": "Elixir vitæ", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Elixir vitæ", "Elixir vita"], "contexts": ["medicinal elixir, likely elixir of life", "elixir of life, a preparation"]}, {"entity_id": "elixir_vita", "book_id": "ricettario_fiorentino_1597", "name": "Elixir vita", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Elixir vita"], "contexts": ["medicinal preparation"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Elixir vitæ", "target_book": "ricettario_fiorentino_1597", "target_name": "Elixir vita", "similarity": 0.856}], "id": 1737, "stable_key": "clu_6852e514079bf48a", "ground_truth": {"modern_name": "Elixir Vitae", "confidence": "high", "type": "preparation"}}, {"canonical_name": "ipericaó", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ipericaó", "book_id": "polyanthea_medicinal", "name": "ipericaó", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["ipericaó", "Ipericão"], "contexts": ["herb used in preparation", "St. John's wort"]}, {"entity_id": "iperico", "book_id": "ricettario_fiorentino_1597", "name": "Iperico", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Iperico"], "contexts": ["herb oil"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "ipericaó", "target_book": "ricettario_fiorentino_1597", "target_name": "Iperico", "similarity": 0.875}], "id": 1738, "stable_key": "clu_d963abf0802052d9", "ground_truth": {"modern_name": "St. John's Wort", "confidence": "high", "type": "plant", "linnaean": "Hypericum perforatum", "family": "Hypericaceae", "wikidata_id": "Q158289", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Hypericum%20perforatum", "wikipedia_extract": "Hypericum perforatum, commonly known as St. John's wort (sometimes perforate St. John's wort or common St. John's wort), is a flowering plant in the family Hypericaceae. It is a hairless, perennial herb with woody roots, yellow flowers marked by black glands, and leaves that appear perforated due to translucent glands, producing thousands of seeds per plant. H. perforatum is the type species of its genus, known for its historical use in folklore and traditional medicine."}}, {"canonical_name": "Præsepe", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "præsepe", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Præsepe", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Præsepe"], "contexts": ["luminous spot called Beehive", "in Cancer"]}, {"entity_id": "præceptionum", "book_id": "polyanthea_medicinal", "name": "Præceptionum", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Præceptionum"], "contexts": ["title of Hippocrates' work"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Præsepe", "target_book": "polyanthea_medicinal", "target_name": "Præceptionum", "similarity": 0.858}], "id": 1739, "stable_key": "clu_157d699db64ecd43", "ground_truth": {"modern_name": "Beehive Cluster", "confidence": "medium", "type": "object", "note": "The term 'Præsepe' can refer to the Beehive Cluster (M44) in astronomy or, more loosely, a 'manger' or 'crib'. In the context of Somerville's 'Physical Sciences', it likely refers to the astronomical object. The 'Præceptionum' is likely a misreading or OCR error for a Latin term related to teaching or precepts, not a specific object.", "wikidata_id": "Q13760", "wikidata_description": "open cluster", "wikipedia_url": "https://en.wikipedia.org/wiki/List_of_largest_star_clusters", "wikipedia_extract": "Below is a list of the largest known star clusters, ordered by diameter in light years, above the size of 50 light years in diameter. This list includes globular clusters, open clusters, super star clusters, and other types."}}, {"canonical_name": "organ", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "organ", "book_id": "connexion_physical_sciences_somerville_1858", "name": "organ", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["organ"], "contexts": ["musical instrument with pipes", "musical instrument with bellows"]}, {"entity_id": "organa_vitrea", "book_id": "polyanthea_medicinal", "name": "organa vitrea", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["organa vitrea"], "contexts": ["glass instruments"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "organ", "target_book": "polyanthea_medicinal", "target_name": "organa vitrea", "similarity": 0.823}], "id": 1740, "stable_key": "clu_f08dab5f4dcc343d", "ground_truth": {"modern_name": "Organ", "confidence": "high", "type": "object", "note": "The term 'organ' in the context of Somerville refers to the musical instrument. 'organa vitrea' is Latin for 'glass instruments', which could refer to laboratory glassware or specific instruments made of glass, but 'organ' as a musical instrument is the primary referent in the context of the cluster."}}, {"canonical_name": "motus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "motus", "book_id": "polyanthea_medicinal", "name": "motus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["motus"], "contexts": ["movement"]}, {"entity_id": "motet", "book_id": "first_principles_spencer_1862", "name": "motet", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["motet"], "contexts": ["choral composition"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "motus", "target_book": "first_principles_spencer_1862", "target_name": "motet", "similarity": 0.898}], "id": 1741, "stable_key": "clu_afe0888b4c766be1", "ground_truth": {"modern_name": "Motion", "confidence": "high", "type": "concept", "note": "While 'motet' is a musical term, the context of 'first principles' and physical sciences strongly suggests 'motion' as the primary concept. 'Motus' is Latin for motion.", "wikipedia_extract": "The Volkswagen Golf () is a compact car/small family car (C-segment) produced by the German automotive manufacturer Volkswagen since 1974, marketed worldwide across eight generations, in various body configurations and under various nameplates – including as the Volkswagen Rabbit in the United States and Canada (Mk1 and Mk5), and as the Volkswagen Caribe in Mexico (Mk1). Historically, the Golf is Volkswagen's best-selling model and is among the world's top three best-selling nameplates, with more than 35 million units sold as of 2019. The original Golf Mk1 was a front-engined, front-wheel drive replacement for the air-cooled, rear-engined, rear-wheel drive Volkswagen Beetle. Initially, most Golfs were hatchbacks, with the three-door version being somewhat more popular than the five-door. Other variants include an estate (Variant, from 1993), convertible (Cabriolet or Cabrio, from 1979), and a Golf-based saloon called the Jetta, Vento (from 1992), or Bora (from 1999). The Golf covers economy to high-performance market segments.", "wikipedia_url": "https://en.wikipedia.org/wiki/Volkswagen_Golf"}}, {"canonical_name": "Anatomicos", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "anatomicos", "book_id": "polyanthea_medicinal", "name": "Anatomicos", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 2, "variants": ["Anatomicos"], "contexts": ["scholars who study anatomy", "physicians who perform anatomy"]}, {"entity_id": "anatomist", "book_id": "first_principles_spencer_1862", "name": "anatomist", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["anatomist"], "contexts": ["expert in anatomy"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Anatomicos", "target_book": "first_principles_spencer_1862", "target_name": "anatomist", "similarity": 0.892}], "id": 1742, "stable_key": "clu_b351794f8e374e6d", "ground_truth": {"modern_name": "Anatomist", "confidence": "high", "type": "person", "description": "A scholar or expert who studies and practices anatomy.", "wikidata_id": "Q10872101", "wikidata_description": "scientist with a specialty in anatomy", "wikipedia_extract": "Anatomy (from Ancient Greek  ἀνατομή (anatomḗ) 'dissection') is the branch of morphology concerned with the study of the internal and external structure of organisms and their parts. Anatomy is a branch of natural science that deals with the structural organization of living things. It is an old science, having its beginnings in prehistoric times. Anatomy is inherently tied to developmental biology, embryology, comparative anatomy, evolutionary biology, and phylogeny, as these are the processes by which anatomy is generated, both over immediate and long-term timescales. Anatomy and physiology, which study the structure and function of organisms and their parts respectively, make a natural pair of related disciplines, and are often studied together. Human anatomy is one of the essential basic sciences that are applied in medicine, and is often studied alongside physiology.", "wikipedia_url": "https://fr.wikipedia.org/wiki/Anatomiste"}}, {"canonical_name": "definite proportions", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "definite_proportions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "definite proportions", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["definite proportions", "Definite Proportions"], "contexts": ["law of chemical combination", "law of fixed ratios in chemical compounds"]}, {"entity_id": "definite_proportions", "book_id": "first_principles_spencer_1862", "name": "definite proportions", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["definite proportions"], "contexts": ["law of chemical combination"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "definite proportions", "target_book": "first_principles_spencer_1862", "target_name": "definite proportions", "similarity": 1.0}], "id": 1743, "stable_key": "clu_e71bb0ea9838a69c", "ground_truth": {"modern_name": "Law of Definite Proportions", "confidence": "high", "type": "concept", "wikidata_id": "Q327158", "wikidata_description": "statement that a given chemical compound always contains its elements in fixed ratio (by mass) and does not depend on its source and method of preparation", "wikipedia_extract": "In chemistry, the whole number rule states that the masses of the isotopes are whole number multiples of the mass of the hydrogen atom. The rule is a modified version of Prout's hypothesis proposed in 1815, to the effect that atomic weights are multiples of the weight of the hydrogen atom. It is also known as the Aston whole number rule after Francis W. Aston who was awarded the Nobel Prize in Chemistry in 1922 \"for his discovery, by means of his mass spectrograph, of isotopes, in a large number of non-radioactive elements, and for his enunciation of the whole-number rule\". The law of definite proportions was formulated by Joseph Proust around 1800 and states that all samples of a chemical compound will have the same elemental composition by mass. The atomic theory of John Dalton expanded this concept and explained matter as consisting of discrete atoms with one kind of atom for each element combined in fixed proportions to form compounds.", "wikipedia_url": "https://en.wikipedia.org/wiki/Law_of_definite_proportions"}}, {"canonical_name": "etherial medium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "etherial_medium", "book_id": "first_principles_spencer_1862", "name": "etherial medium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["etherial medium"], "contexts": ["hypothetical medium filling space", "medium for undulations"]}, {"entity_id": "etherial_medium", "book_id": "connexion_physical_sciences_somerville_1858", "name": "etherial medium", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["etherial medium"], "contexts": ["hypothesized medium for light propagation"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "etherial medium", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "etherial medium", "similarity": 0.86}], "id": 1744, "stable_key": "clu_4e9dbfca97b0ac74", "ground_truth": {"modern_name": "Luminiferous aether", "confidence": "high", "type": "concept", "wikidata_id": "Q208702", "wikidata_description": "postulated medium for the propagation of light", "wikipedia_extract": "Luminiferous aether or ether (luminiferous meaning 'light-bearing') is the formerly postulated medium for the propagation of light. It was invoked to explain the ability of the apparently wave-based light to propagate through empty space (a vacuum), something that waves should not be able to do. The assumption of a spatial plenum (space completely filled with matter) of luminiferous aether, rather than a spatial vacuum, provided the theoretical medium that was required by wave theories of light. The aether hypothesis was the topic of considerable debate throughout its history, as it required the existence of an invisible and infinite material with no interaction with physical objects. As the nature of light was explored, especially in the 19th century, the physical qualities required of an aether became increasingly contradictory. By the late 19th century, the existence of the aether was being questioned, although there was no physical theory to replace it.", "wikipedia_url": "https://en.wikipedia.org/wiki/Luminiferous_aether"}}, {"canonical_name": "indestructibility of Matter", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "indestructibility_of_matter", "book_id": "first_principles_spencer_1862", "name": "indestructibility of Matter", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["indestructibility of Matter"], "contexts": ["principle that matter cannot be created or destroyed"]}, {"entity_id": "indestructibility_of_matter", "book_id": "connexion_physical_sciences_somerville_1858", "name": "indestructibility of matter", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["indestructibility of matter"], "contexts": ["fundamental principle in physics"]}], "edges": [{"source_book": "first_principles_spencer_1862", "source_name": "indestructibility of Matter", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "indestructibility of matter", "similarity": 0.982}], "id": 1745, "stable_key": "clu_8d046a04c883fc41", "ground_truth": {"modern_name": "Conservation of Mass", "confidence": "high", "type": "concept", "wikipedia_extract": "In physics and chemistry, the law of conservation of mass or principle of mass conservation states that for any system which is closed to all incoming and outgoing transfers of matter, the mass of the system must remain constant over time. The law implies that mass can neither be created nor destroyed, although it may be rearranged in space, or the entities associated with it may be changed in form. For example, in chemical reactions, the mass of the chemical components before the reaction is equal to the mass of the components after the reaction. Thus, during any chemical reaction and low-energy thermodynamic processes in an isolated system, the total mass of the reactants, or starting materials, must be equal to the mass of the products. The concept of mass conservation is widely used in many fields such as chemistry, mechanics, and fluid dynamics. Historically, mass conservation in chemical reactions was primarily demonstrated in the 17th century and finally confirmed by Antoine Lavoisier in the late 18th century."}}, {"canonical_name": "vice", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "vice", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "vice", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vice"], "contexts": ["immoral or wicked behavior"]}, {"entity_id": "vices", "book_id": "english_physician_1652", "name": "Vices", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Vices"], "contexts": ["negative aspects of substances"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "vice", "target_book": "english_physician_1652", "target_name": "Vices", "similarity": 0.909}], "id": 1746, "stable_key": "clu_b4c9d60ceec69e31", "ground_truth": {"modern_name": "Vice", "confidence": "high", "type": "concept", "wikidata_id": "Q102217", "wikidata_description": "city in Belarus", "wikipedia_url": "https://en.wikipedia.org/wiki/Vitebsk", "wikipedia_extract": "A vice is a practice, behaviour, habit or item generally considered morally wrong in the associated society. In more minor usage, vice can refer to a fault, a negative character trait, a defect, an infirmity, or a bad or unhealthy habit. Vices are usually associated with a fault in a person's character or temperament rather than their morality. Synonyms for vice include fault, sin, depravity, iniquity, wickedness, and corruption. The antonym of vice is virtue. The modern English term that best captures its original meaning is the word vicious, which means \"full of vice\"."}}, {"canonical_name": "Horse-Raddish", "category": "PLANT", "subcategory": "ROOT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "horse-raddish", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Horse-Raddish", "category": "PLANT", "subcategory": "ROOT", "count": 1, "variants": ["Horse-Raddish"], "contexts": ["plant name with 'horse' prefix"]}, {"entity_id": "horse-radish", "book_id": "english_physician_1652", "name": "Horse-Radish", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Horse-Radish"], "contexts": ["plant needing no description"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Horse-Raddish", "target_book": "english_physician_1652", "target_name": "Horse-Radish", "similarity": 0.875}], "id": 1747, "stable_key": "clu_07f156cd80dac08f", "ground_truth": {"modern_name": "Horseradish", "confidence": "high", "type": "plant", "linnaean": "Armoracia rusticana Gaertner, Meyer & Scherb.", "family": "Brassicaceae", "wikidata_id": "Q26545", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Horseradish", "wikipedia_extract": "Horseradish (Armoracia rusticana, syn. Cochlearia armoracia) is a perennial plant of the family Brassicaceae (which also includes mustard, wasabi, broccoli, cabbage, and radish). It is a root vegetable, cultivated and used worldwide as a spice and as a condiment. The species is likely native to Southeastern Europe and Western Asia. Horseradish grows up to 1.5 meters (5 feet) tall, with hairless bright green unlobed leaves up to 1 m (3 ft 3 in) long that may be mistaken for docks (Rumex). It is cultivated primarily for its large, white, tapered root."}}, {"canonical_name": "Trent", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "trent", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Trent", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Trent"], "contexts": ["city near Anania valley"]}, {"entity_id": "trent", "book_id": "english_physician_1652", "name": "Trent", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Trent"], "contexts": ["seat of Cardinal Prince"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Trent", "target_book": "english_physician_1652", "target_name": "Trent", "similarity": 1.0}], "id": 1748, "stable_key": "clu_52eea54176346c84", "ground_truth": {"modern_name": "Trent", "confidence": "high", "type": "place", "country": "Italy"}}, {"canonical_name": "Treaty of bodies", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "treaty_of_bodies", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Treaty of bodies", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Treaty of bodies"], "contexts": ["work by Sir Kenelm Digby"]}, {"entity_id": "treatises", "book_id": "origin_of_species_darwin_1859", "name": "treatises", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["treatises"], "contexts": ["published works on selection"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Treaty of bodies", "target_book": "origin_of_species_darwin_1859", "target_name": "treatises", "similarity": 0.903}], "id": 1749, "stable_key": "clu_f6c457fb6598821f", "ground_truth": {"modern_name": "Treatise on the Power of Natural Mechanisms", "confidence": "medium", "type": "text", "note": "The 'Treaty of bodies' likely refers to Sir Kenelm Digby's work, while 'treatises' in Darwin's context refers to published works. The modern name aims to capture Digby's known work that aligns with the context."}}, {"canonical_name": "Fins", "category": "ANATOMY", "subcategory": "BODY_PART", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fins", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Fins", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["Fins"], "contexts": ["appendages for swimming"]}, {"entity_id": "fin", "book_id": "origin_of_species_darwin_1859", "name": "fin", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["fin"], "contexts": ["aquatic limb"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Fins", "target_book": "origin_of_species_darwin_1859", "target_name": "fin", "similarity": 0.938}], "id": 1750, "stable_key": "clu_e9f9ebda24b4a572", "ground_truth": {"modern_name": "Fin", "confidence": "high", "type": "anatomy", "wikipedia_extract": "Fins are moving appendages protruding from the body of fish that interact with water to generate thrust and lift, which help the fish swim. Apart from the tail or caudal fin, fish fins have no direct articulations with the axial skeleton and are attached to the core only via muscles and ligaments. Fish fins are highly distinctive anatomical features with varying internal structures among different clades: in ray-finned fish (Actinopterygii), fins are mainly composed of spreading bony spines or \"rays\" covered by a thin stretch of scaleless skin, resembling a folding fan; in lobe-finned fish (Sarcopterygii) such as coelacanths and lungfish, fins are short rays based around a muscular central bud internally supported by a jointed appendicular skeleton; in cartilaginous fish (Chondrichthyes) and jawless fish (Agnatha), fins are fleshy \"flippers\" supported by a cartilaginous skeleton. The limbs of tetrapods, a mostly terrestrial clade evolved from freshwater lobe-finned fish, are homologous to the pectoral and pelvic fins of all jawed fish. Fins at different locations of the fish body serve different functions, and are divided into two groups: the midsagittal unpaired fins and the more laterally located paired fins. Unpaired fins are predominantly associated with generating linear acceleration via oscillating propulsion, as well as providing directional stability; while paired fins are used for generating paddling acceleration, deceleration, and differential thrust or lift for turning, surfacing or diving and rolling.", "wikipedia_url": "https://en.wikipedia.org/wiki/Fish_fin"}}, {"canonical_name": "lobes", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "lobes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "lobes", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["lobes"], "contexts": ["divisions of the liver"]}, {"entity_id": "loops", "book_id": "origin_of_species_darwin_1859", "name": "loops", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["loops"], "contexts": ["curved structures"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "lobes", "target_book": "origin_of_species_darwin_1859", "target_name": "loops", "similarity": 0.843}], "id": 1751, "stable_key": "clu_fada9f6292e0f684", "ground_truth": {"modern_name": "Lobe", "confidence": "high", "type": "anatomy", "wikipedia_extract": "The temporal lobe is one of the four major lobes of the cerebral cortex in the brain of mammals. The temporal lobe is located beneath the lateral fissure on both cerebral hemispheres of the mammalian brain. The temporal lobe is involved in processing sensory input into derived meanings for the appropriate retention of visual memory, language comprehension, and emotion association. Temporal refers to the head's temples. The temporal lobe consists of structures that are vital for declarative or long-term memory. Declarative (denotative) or explicit memory is conscious memory divided into semantic memory (facts) and episodic memory (events).", "wikipedia_url": "https://en.wikipedia.org/wiki/Temporal_lobe"}}, {"canonical_name": "Crow", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "crow", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Crow", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Crow"], "contexts": ["bird believed to have a long lifespan"]}, {"entity_id": "hooded_crow", "book_id": "origin_of_species_darwin_1859", "name": "hooded crow", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["hooded crow"], "contexts": ["tame bird species in Egypt"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Crow", "target_book": "origin_of_species_darwin_1859", "target_name": "hooded crow", "similarity": 0.847}], "id": 1752, "stable_key": "clu_a8a34d026058def6", "ground_truth": {"modern_name": "Crow", "confidence": "high", "type": "animal", "note": "The specific mention of 'hooded crow' in Darwin's context suggests a possible species identification, but 'crow' is the primary cluster term.", "wikidata_id": "Q666368", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Corvidae", "wikipedia_extract": "Corvidae is a cosmopolitan family of oscine passerine birds that contains the crows, ravens, rooks, magpies, jackdaws, jays, treepies, choughs, and nutcrackers. In colloquial terms, the crow family is made up of corvids; currently 135 species are included. The genus Corvus containing 47 species makes up over a third of the entire family. The raven is the largest passerine bird. Corvids display remarkable intelligence for animals of their size, and are among the most intelligent birds thus far studied. Specifically, members of the family have demonstrated self-awareness in mirror tests (Eurasian magpies) and tool-making ability (e.g."}}, {"canonical_name": "Pilate", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pilate", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Pilate", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Pilate"], "contexts": ["received accusation against the Saviour"]}, {"entity_id": "pilate", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pilate", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Pilate"], "contexts": ["character in procession"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Pilate", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Pilate", "similarity": 1.0}], "id": 1753, "stable_key": "clu_e070709737b17f4a", "ground_truth": {"modern_name": "Pontius Pilate", "confidence": "high", "type": "person", "description": "Roman governor of Judea, historical and religious figure.", "wikipedia_extract": "Pontius Pilate (Latin: Pontius Pilatus; Greek: Πόντιος Πιλᾶτος, romanized: Póntios Pilátos) was the fifth governor of the Roman province of Judaea, serving under Emperor Tiberius from 26/27 to 36/37 AD. He is best known for being the official who presided over the trial of Jesus and ultimately ordered his crucifixion. Pilate's importance in Christianity is underscored by his prominent place in both the Apostles' and Nicene Creeds. Because the gospels portray Pilate as reluctant to execute Jesus, the Ethiopian Orthodox Tewahedo Church believes that Pilate became a Christian and venerates him as both a martyr and a saint, a belief which was also historically held by the Coptic Church. Pontius Pilate is the best-attested figure to hold the position of Roman governor, though few sources about his rule have survived. Virtually nothing is known about his life prior to becoming governor or the circumstances of his appointment.", "wikipedia_url": "https://en.wikipedia.org/wiki/Pontius_Pilate"}}, {"canonical_name": "Belus", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "belus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Belus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Belus"], "contexts": ["ancient deity"]}, {"entity_id": "belus", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Belus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Belus"], "contexts": ["pyramid of Belus"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Belus", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Belus", "similarity": 1.0}], "id": 1754, "stable_key": "clu_dd32f7a62ecd8dbd", "ground_truth": {"modern_name": "Belus", "confidence": "high", "type": "person", "description": "Ancient deity associated with Babylonian pyramids", "note": "Belus is a complex figure, often conflated with Babylonian gods like Marduk or with legendary kings.", "wikidata_id": "Q14950162", "wikidata_description": "genus of insects", "wikipedia_extract": "Belus or Belos (Ancient Greek: Βῆλος, Bêlos) in classical Greek or classical Latin texts (and later material based on them) in a Babylonian context refers to the Babylonian god Bel Marduk. Though often identified with Greek Zeus and Latin Jupiter as Zeus Belos or Jupiter Belus, in other cases Belus is euhemerized as an ancient king who founded Babylon and built the ziggurat. He is recognized and worshipped as the god of war. Eusebius of Caesarea (Praeparatio Evangelica 9.18) cites Artabanus as stating in his Jewish History that Artabanus found in anonymous works that giants who had been dwelling in Babylonia were destroyed by the gods for impiety, but one of them named Belus escaped and settled in Babylon and lived in the tower which he built and named the Tower of Belus. A little later Eusebius (9.41) cites Abydenus' Concerning the Assyrians for the information that the site of Babylon:... was originally water, and called a sea.", "wikipedia_url": "https://en.wikipedia.org/wiki/Belus_(Babylonian)"}}, {"canonical_name": "Juments", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "juments", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Juments", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Juments"], "contexts": ["work animals"]}, {"entity_id": "juments", "book_id": "relation_historique_humboldt_vol3_1825", "name": "juments", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["juments"], "contexts": ["female horses"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Juments", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "juments", "similarity": 0.972}], "id": 1755, "stable_key": "clu_b5b1a81d4408c652", "ground_truth": {"modern_name": "mares", "confidence": "high", "type": "animal", "note": "The French term 'juments' specifically refers to female horses (mares).", "wikidata_id": "Q726", "wikidata_description": "domesticated four-footed mammal from the equine family", "wikipedia_url": "https://en.wikipedia.org/wiki/Horse"}}, {"canonical_name": "juices", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "juices", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "juices", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["juices"], "contexts": ["bodily fluids"]}, {"entity_id": "jus_d'herbes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "jus d'herbes", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["jus d'herbes"], "contexts": ["plant juices used by Indians"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "juices", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "jus d'herbes", "similarity": 0.842}], "id": 1756, "stable_key": "clu_2d086857e0613f82", "ground_truth": {"modern_name": "juices", "confidence": "medium", "type": "concept", "note": "This cluster includes both bodily fluids and plant extracts, a broader concept than a specific substance.", "wikidata_id": "Q1058795", "wikidata_description": "liquid originating from the inside of an organism, including fluids excreted or secreted, and body water that normally is not", "wikipedia_url": "https://en.wikipedia.org/wiki/Cold-pressed_juice", "wikipedia_extract": "Cold-pressed juice is juice that uses a hydraulic press to extract juice from fruit and vegetables, as opposed to other methods such as centrifugal or single auger. Without pasteurization or high-pressure processing (HPP), cold-pressed juices can be stored in a refrigerator for up to three days when phytochemical and micronutrient degradation occurs. Some juicers use technology that helps delay oxidation which can allow for slightly longer storage in refrigerators. This type of juice has been commercially produced for decades, but became more common in some countries since 2013. In general, these juices are more expensive than other types of juices, as they are made from 100% fruit and vegetables without any added ingredients. Although cold-pressed juices were produced over several decades, the products gained more common use during the fad of juice \"cleansing\", expanding into a wider industry in the early 21st century."}}, {"canonical_name": "Upsale", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "upsale", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Upsale", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Upsale"], "contexts": ["seat of Archbishop Olaus Magnus"]}, {"entity_id": "upsal", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Upsal", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Upsal"], "contexts": ["location associated with a naturalist"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Upsale", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Upsal", "similarity": 0.941}], "id": 1757, "stable_key": "clu_2ee2c78b375f5f66", "ground_truth": {"modern_name": "Uppsala", "confidence": "high", "type": "place", "country": "Sweden", "note": "Uppsala was a significant religious and academic center in early modern Sweden.", "wikidata_id": "Q25286", "wikidata_description": "city in Uppsala County, Sweden", "wikipedia_url": "https://en.wikipedia.org/wiki/Uppsala"}}, {"canonical_name": "Nubia", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "nubia", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Nubia", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Nubia"], "contexts": ["source of poison"]}, {"entity_id": "nubie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Nubie", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Nubie"], "contexts": ["country with contrasting animal behaviors"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Nubia", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Nubie", "similarity": 0.968}], "id": 1758, "stable_key": "clu_db1ae7c238737e42", "ground_truth": {"modern_name": "Nubia", "confidence": "high", "type": "place", "country": "Egypt/Sudan", "wikidata_id": "Q135028", "wikidata_description": "region along the Nile river, which is located in northern Sudan and southern Egypt", "wikipedia_url": "https://en.wikipedia.org/wiki/Nubia"}}, {"canonical_name": "Sacrament", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sacrament", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Sacrament", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Sacrament"], "contexts": ["religious rite"]}, {"entity_id": "saintliness", "book_id": "principles_of_psychology_james_1890", "name": "saintliness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["saintliness"], "contexts": ["quality of being a saint"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sacrament", "target_book": "principles_of_psychology_james_1890", "target_name": "saintliness", "similarity": 0.851}], "id": 1759, "stable_key": "clu_fa7e4329046ec363", "ground_truth": {"modern_name": "Sacrament", "confidence": "medium", "type": "concept", "note": "The second instance ('saintliness') is a departure, suggesting a potential conflation or broad interpretation of spiritual concepts. 'Sacrament' is the primary referent.", "wikidata_id": "Q18013", "wikidata_description": "capital city of the U.S. state of California and seat of Sacramento County", "wikipedia_extract": "A sacrament is a Christian rite which is recognized as being particularly important and significant. There are various views on the existence, number and meaning of such rites. Many Christians consider the sacraments to be a visible symbol of the reality of God, as well as a channel for God's grace. Many denominations, including the Catholic, Lutheran, Moravian, Reformed (Continental Reformed, Presbyterian, and Congregationalist traditions), Anglican, Methodist and Baptist, hold to the definition of sacrament formulated by Augustine of Hippo: an outward sign of an inward grace, that has been instituted by Jesus Christ. Sacraments signify God's grace in a way that is outwardly observable to the participant. The Catholic Church, Hussite Church and the Old Catholic Church recognize seven sacraments: Baptism, Penance (Reconciliation or Confession), Eucharist (or Holy Communion), Confirmation, Marriage (Matrimony), Holy Orders, and Anointing of the Sick (Extreme Unction).", "wikipedia_url": "https://en.wikipedia.org/wiki/Sacramento%2C_California"}}, {"canonical_name": "light", "category": "QUALITY", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "light", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "light", "category": "QUALITY", "subcategory": "QUALITY", "count": 1, "variants": ["light"], "contexts": ["positive quality, from good principle"]}, {"entity_id": "luminosity", "book_id": "principles_of_psychology_james_1890", "name": "luminosity", "category": "QUALITY", "subcategory": "QUALITY", "count": 1, "variants": ["luminosity"], "contexts": ["property of emitting light"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "light", "target_book": "principles_of_psychology_james_1890", "target_name": "luminosity", "similarity": 0.952}], "id": 1760, "stable_key": "clu_90b048a562b2ff82", "ground_truth": {"modern_name": "light", "confidence": "high", "type": "concept", "wikidata_id": "Q542", "wikidata_description": "sports involving running, jumping, throwing and walking"}}, {"canonical_name": "darkness", "category": "QUALITY", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "darkness", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "darkness", "category": "QUALITY", "subcategory": "QUALITY", "count": 1, "variants": ["darkness"], "contexts": ["negative quality, from evil principle"]}, {"entity_id": "dark", "book_id": "principles_of_psychology_james_1890", "name": "dark", "category": "QUALITY", "subcategory": "OTHER_QUALITY", "count": 1, "variants": ["dark"], "contexts": ["absence of light"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "darkness", "target_book": "principles_of_psychology_james_1890", "target_name": "dark", "similarity": 0.91}], "id": 1761, "stable_key": "clu_4df0bfea973fb8f0", "ground_truth": {"modern_name": "darkness", "confidence": "high", "type": "concept", "wikidata_id": "Q204170", "wikidata_description": "lack of light"}}, {"canonical_name": "Aquinas", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "aquinas", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Aquinas", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Aquinas"], "contexts": ["medieval philosopher and theologian"]}, {"entity_id": "thomas_aquinas", "book_id": "principles_of_psychology_james_1890", "name": "Thomas Aquinas", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Thomas Aquinas"], "contexts": ["metaphysician compared to Hume"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Aquinas", "target_book": "principles_of_psychology_james_1890", "target_name": "Thomas Aquinas", "similarity": 0.836}], "id": 1762, "stable_key": "clu_53750cf42cf4ccc7", "ground_truth": {"modern_name": "Thomas Aquinas", "confidence": "high", "type": "person", "birth_year": 1225, "death_year": 1274, "description": "Medieval philosopher and theologian, influential in scholasticism.", "wikidata_id": "Q9438", "wikidata_description": "Italian Dominican friar, philosopher, Catholic priest, and Doctor of the Church (1225–1274)", "wikipedia_url": "https://en.wikipedia.org/wiki/Thomas%20Aquinas", "wikipedia_extract": "St. Thomas Aquinas  (  ə-KWY-nəs; Italian: Tommaso d'Aquino, lit. 'Thomas of Aquino'; c. 1225 – 7 March 1274) was an Italian Dominican friar and priest, theologian, and philosopher. He is considered one of the most influential thinkers in the history of Catholic theology and Western philosophy. Thomas was a proponent of natural theology and the father of a school of thought (encompassing both theology and philosophy) known as Thomism. He argued that God is the source of the light of natural reason and the light of faith. He embraced several ideas put forward by Aristotle and attempted to synthesize Aristotelian philosophy with the principles of Christianity."}}, {"canonical_name": "whites of Eggs", "category": "SUBSTANCE", "subcategory": "PRODUCT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "whites_of_eggs", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "whites of Eggs", "category": "SUBSTANCE", "subcategory": "PRODUCT", "count": 1, "variants": ["whites of Eggs"], "contexts": ["example of coagulation"]}, {"entity_id": "white_of_egg", "book_id": "principles_of_psychology_james_1890", "name": "white of egg", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["white of egg"], "contexts": ["food substance for fish"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "whites of Eggs", "target_book": "principles_of_psychology_james_1890", "target_name": "white of egg", "similarity": 0.87}], "id": 1763, "stable_key": "clu_7a5dde29d24b351a", "ground_truth": {"modern_name": "Egg white", "confidence": "high", "type": "substance", "wikidata_id": "Q796758", "wikidata_description": "clear liquid contained within an egg", "wikipedia_url": "https://en.wikipedia.org/wiki/Egg_allergy", "wikipedia_extract": "Egg allergy is an immune hypersensitivity to proteins found in chicken eggs, and possibly goose, duck, or turkey eggs. Symptoms can be either rapid or gradual in onset. The latter can take hours to days to appear. The former may include anaphylaxis, a potentially life-threatening condition which requires treatment with epinephrine. Other presentations may include atopic dermatitis or inflammation of the esophagus. In the United States, 90% of allergic responses to foods are caused by cow's milk, eggs, wheat, shellfish, peanuts, tree nuts, fish, soybeans, and sesame seeds."}}, {"canonical_name": "Maple", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "maple", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Maple", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Maple"], "contexts": ["type of tree"]}, {"entity_id": "maple-tree", "book_id": "principles_of_psychology_james_1890", "name": "maple-tree", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["maple-tree"], "contexts": ["tree providing shade and rest"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Maple", "target_book": "principles_of_psychology_james_1890", "target_name": "maple-tree", "similarity": 0.906}], "id": 1764, "stable_key": "clu_f2c4cfbe463ddb0c", "ground_truth": {"modern_name": "Maple", "confidence": "high", "type": "plant", "family": "Sapindaceae", "wikidata_id": "Q42292", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Maple"}}, {"canonical_name": "Senate", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "senate", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Senate", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Senate"], "contexts": ["governing body in Bononia"]}, {"entity_id": "senate", "book_id": "principles_of_psychology_james_1890", "name": "Senate", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Senate"], "contexts": ["legislative body"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Senate", "target_book": "principles_of_psychology_james_1890", "target_name": "Senate", "similarity": 1.0}], "id": 1765, "stable_key": "clu_10901abdb254f245", "ground_truth": {"modern_name": "Senate", "confidence": "high", "type": "organization", "wikidata_id": "Q2570643", "wikidata_description": "type of legislative body, often the upper house or chamber of a bicameral legislature", "wikipedia_url": "https://en.wikipedia.org/wiki/Senate", "wikipedia_extract": "A senate is a deliberative assembly, often the upper house or chamber of a bicameral legislature. The name comes from the ancient Roman Senate (Latin: Senatus), so-called as an assembly of the senior (Latin: senex meaning \"the elder\" or \"old man\") and therefore considered wiser and more experienced members of the society or ruling class. However the Roman Senate was not the ancestor or predecessor of modern parliamentarism in any sense, because the Roman senate was not a de jure legislative body. Many countries have an assembly named a senate, composed of senators who may be elected, appointed, have inherited the title, or gained membership by other methods, depending on the country. Modern senates typically serve to provide a chamber of \"sober second thought\" to consider legislation passed by a lower house, whose members are usually elected. Most senates have asymmetrical duties and powers compared with their respective lower house meaning they have special duties, for example to fill important political positions or to pass special laws."}}, {"canonical_name": "brow-antlers", "category": "ANATOMY", "subcategory": "BODY_PART", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "brow-antlers", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "brow-antlers", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["brow-antlers"], "contexts": ["lowest furcations of deer antlers"]}, {"entity_id": "brow", "book_id": "principles_of_psychology_james_1890", "name": "brow", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["brow"], "contexts": ["part of the face"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "brow-antlers", "target_book": "principles_of_psychology_james_1890", "target_name": "brow", "similarity": 0.877}], "id": 1766, "stable_key": "clu_f0565775c3f6a188", "ground_truth": {"modern_name": "Antler brow tines", "confidence": "high", "type": "anatomy", "note": "The term 'brow' alone can refer to the forehead, but in the context of antlers and deer, 'brow-antlers' specifically refers to the first or lowest branches from the base of the antler.", "wikipedia_extract": "The sambar (Rusa unicolor) is a large deer native to the Indian subcontinent, South China and Southeast Asia that is listed as a vulnerable species on the IUCN Red List since 2008. Populations have declined substantially due to hunting, local insurgency, and industrial exploitation of habitat. Genetic analysis shows that the closest living relative of the sambar is most likely the Javan rusa of Indonesia. This is supported by reports that sambar can still interbreed to produce fertile hybrids with this species. Fossil sambar are known from the early Pleistocene, although they are very similar in form to early deer species from the Pliocene, with less of a resemblance to more modern cervines. The species probably arose in the tropical reaches of southern Asia, and later spread across its current range.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sambar_deer"}}, {"canonical_name": "Minotaure", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "minotaure", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Minotaure", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Minotaure"], "contexts": ["mythological creature, half-man half-bull"]}, {"entity_id": "mososaurus", "book_id": "kosmos_humboldt_1845", "name": "Mososaurus", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Mososaurus"], "contexts": ["crocodile of Maestricht"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Minotaure", "target_book": "kosmos_humboldt_1845", "target_name": "Mososaurus", "similarity": 0.841}], "id": 1767, "stable_key": "clu_42f3452de7157d54", "ground_truth": {"modern_name": "Mosasaur", "confidence": "medium", "type": "animal", "note": "Cluster contains conflicting referents: 'Minotaure' (mythological) and 'Mososaurus' (extinct reptile). Mosasaurus is the more likely scientific referent given the context of natural history texts.", "wikidata_id": "Q21313765", "wikidata_description": "species of reptile (fossil)", "wikipedia_extract": "Mosasaurs (from Latin Mosa meaning the 'Meuse', and Greek σαύρος sauros meaning 'lizard') are an extinct group of large aquatic reptiles within the family Mosasauridae that lived during the Late Cretaceous. Their first fossil remains were discovered in a limestone quarry at Maastricht on the Meuse in 1764. They belong to the order Squamata, which includes lizards and snakes. During the last 20 million years of the Cretaceous period (Turonian–Maastrichtian ages), with the extinction of the ichthyosaurs and pliosaurs, mosasaurids became the dominant marine predators. They themselves became extinct as a result of the K-Pg event at the end of the Cretaceous period, about 66 million years ago. Mosasaurs breathed air, were powerful swimmers, and were well-adapted to living in the warm, shallow inland seas prevalent during the Late Cretaceous period.", "wikipedia_url": "https://en.wikipedia.org/wiki/Mosasaur"}}, {"canonical_name": "Dionysius", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dionysius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Dionysius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Dionysius"], "contexts": ["Greek historian and rhetorician"]}, {"entity_id": "dionysius_periegetes", "book_id": "kosmos_humboldt_1845", "name": "Dionysius Periegetes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Dionysius Periegetes"], "contexts": ["ancient geographer"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Dionysius", "target_book": "kosmos_humboldt_1845", "target_name": "Dionysius Periegetes", "similarity": 0.847}], "id": 1768, "stable_key": "clu_7b9db4c15be45f3d", "ground_truth": {"modern_name": "Dionysius Periegetes", "confidence": "high", "type": "person", "description": "Ancient Greek geographer and poet, author of 'Periegesis'.", "wikipedia_extract": "Koneswaram Temple of Trincomalee (Tamil: திருக்கோணேச்சரம் கோயில்) or Thirukonamalai Konesar Temple – The Temple of the Thousand Pillars and Dakshina-Then Kailasam (Southern / Ancient Kailash)  is a classical-medieval Hindu temple complex in Trincomalee, a Hindu religious pilgrimage centre in Eastern Province, Sri Lanka. The most sacred of the Pancha Ishwarams of Sri Lanka, it was built significantly during the ancient period on top of Konesar Malai, a promontory overlooking Trincomalee District, Gokarna bay and the Indian Ocean. The monument contains its main shrine to Shiva in the form Kona-Ishvara, shortened to Konesar. The original kovil combined key features to form its basic Dravidian temple plan, such as its thousand pillared hall – \"Aayiram Kaal Mandapam\" – and the Jagati. Regarded as the greatest building of its age for its architecture, elaborate sculptural bas-relief ornamentation adorned a black granite megalith while its multiple gold plated gopuram towers were expanded in the medieval period. One of three major Hindu shrines on the promontory with a colossal gopuram tower, it stood distinctly on the cape's highest eminence.", "wikipedia_url": "https://en.wikipedia.org/wiki/Koneswaram_Temple"}}, {"canonical_name": "History of Animals", "category": "ORGANIZATION", "subcategory": "JOURNAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "history_of_animals", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "History of Animals", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["History of Animals"], "contexts": ["work by Claudius Ælianus"]}, {"entity_id": "hist__animal_", "book_id": "kosmos_humboldt_1845", "name": "Hist. Animal.", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Hist. Animal."], "contexts": ["Aristotle's work on animals"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "History of Animals", "target_book": "kosmos_humboldt_1845", "target_name": "Hist. Animal.", "similarity": 0.845}], "id": 1769, "stable_key": "clu_f413894833e13fc5", "ground_truth": {"modern_name": "History of Animals", "confidence": "high", "type": "text", "note": "The cluster refers to two distinct works: Aristotle's 'Historia Animalium' and potentially Ælian's 'De Natura Animalium'. Given Aristotle's greater prominence in scientific history and the abbreviation 'Hist. Animal.', his work is the primary referent.", "wikipedia_extract": "The history of animal testing goes back to the writings of the Ancient Greeks in the 4th and 3rd centuries BCE, with Aristotle (384–322 BCE) and Erasistratus (304–258 BCE) one of the first documented to perform experiments on nonhuman animals. Galen, a physician in 2nd-century Rome, dissected pigs and goats, and is known as the \"Father of Vivisection.\" Avenzoar, an Arabic physician in 12th-century Moorish Spain who also practiced dissection, introduced animal testing as an experimental method of testing surgical procedures before applying them to human patients. Although the exact purpose of the procedure was unclear, the Neolithic surgeon performed trepanation on a cow in 3400-3000 BCE. This is the earliest known surgery to have been performed on an animal, and it is possible that the procedure was done on a dead cow in order for the surgeon to practice their skills. In 1242, Ibn al-Nafis provided accurate descriptions of the circulation of blood in mammals. A complete description of this circulation was later provided in the 17th century by William Harvey.", "wikipedia_url": "https://en.wikipedia.org/wiki/History_of_animal_testing"}}, {"canonical_name": "Salamander", "category": "ANIMAL", "subcategory": "REPTILE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "salamander", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Salamander", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["Salamander"], "contexts": ["creature associated with fire in fables"]}, {"entity_id": "salamander", "book_id": "kosmos_humboldt_1845", "name": "salamander", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["salamander"], "contexts": ["fossil, conjectured antediluvian man"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Salamander", "target_book": "kosmos_humboldt_1845", "target_name": "salamander", "similarity": 0.984}], "id": 1770, "stable_key": "clu_601936b891fe14cc", "ground_truth": {"modern_name": "Salamander", "confidence": "high", "type": "animal", "note": "Early modern texts sometimes conflated salamanders with fossil remains, leading to a 'fossil salamander' concept, but the primary referent remains the amphibian.", "wikidata_id": "Q3469592", "wikidata_description": "animal", "wikipedia_extract": "Salamanders are a group of amphibians typically characterized by their lizard-like appearance, with slender bodies, blunt snouts, short limbs projecting at right angles to the body, and the presence of a tail in both larvae and adults. All ten extant salamander families are grouped together under the order Urodela, the sole surviving order from the group Caudata. Urodela is a scientific Latin term based on the Ancient Greek οὐρά δήλη: ourà dēlē \"conspicuous tail\". Caudata is the Latin for \"tailed ones\", from cauda: \"tail\". Salamander diversity is highest in eastern North America, especially in the Appalachian Mountains; most species are found in the Holarctic realm, with some species present in the Neotropical realm. Salamanders never have more than four toes on their front legs and five on their rear legs, but some species have fewer digits and others lack hind limbs.", "wikipedia_url": "https://en.wikipedia.org/wiki/Salamander"}}, {"canonical_name": "necessity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "necessity", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "necessity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["necessity"], "contexts": ["inevitable occurrence"]}, {"entity_id": "natural_necessity", "book_id": "kosmos_humboldt_1845", "name": "natural necessity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["natural necessity"], "contexts": ["inevitable outcome of natural laws"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "necessity", "target_book": "kosmos_humboldt_1845", "target_name": "natural necessity", "similarity": 0.902}], "id": 1771, "stable_key": "clu_5027ebda47509bdf", "ground_truth": {"modern_name": "Necessity", "confidence": "high", "type": "concept", "wikidata_id": "Q774228", "wikidata_description": "criterion to which a design, product or process must conform", "wikipedia_url": "https://en.wikipedia.org/wiki/Requirement", "wikipedia_extract": "A concept is an abstract idea that serves as a foundation for more concrete principles, thoughts, and beliefs. Concepts play an important role in all aspects of cognition. As such, concepts are studied within such disciplines as linguistics, psychology, and philosophy, and these disciplines are interested in the logical and psychological structure of concepts, and how they are put together to form thoughts and sentences. The study of concepts has served as an important flagship of an emerging interdisciplinary approach, cognitive science. In contemporary philosophy, three understandings of a concept prevail: mental representations, such that a concept is an entity that exists in the mind (a mental object) abilities peculiar to cognitive agents (mental states) Fregean senses, abstract objects rather than a mental object or a mental state Concepts are classified into a hierarchy, higher levels of which are termed \"superordinate\" and lower levels termed \"subordinate\". Additionally, there is the \"basic\" or \"middle\" level at which people will most readily categorize a concept."}}, {"canonical_name": "Elks", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "elks", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Elks", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Elks"], "contexts": ["animal whose hoofs were tested for electricity"]}, {"entity_id": "elk", "book_id": "kosmos_humboldt_1845", "name": "elk", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["elk"], "contexts": ["animal that migrates north"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Elks", "target_book": "kosmos_humboldt_1845", "target_name": "elk", "similarity": 0.917}], "id": 1772, "stable_key": "clu_437c852aff103971", "ground_truth": {"modern_name": "Elk", "confidence": "high", "type": "animal", "note": "The context of 'hoofs tested for electricity' might allude to historical beliefs or specific, perhaps apocryphal, observations rather than a standard zoological characteristic. The primary referent is the animal.", "wikidata_id": "Q180404", "wikidata_description": "species of mammal in the deer family (Cervidae)", "wikipedia_url": "https://en.wikipedia.org/wiki/Elk"}}, {"canonical_name": "Chesnut", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "chesnut", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Chesnut", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Chesnut"], "contexts": ["tree bearing chestnuts"]}, {"entity_id": "chestnut-tree", "book_id": "kosmos_humboldt_1845", "name": "chestnut-tree", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["chestnut-tree"], "contexts": ["tree in Kashmir inhabited by apes"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Chesnut", "target_book": "kosmos_humboldt_1845", "target_name": "chestnut-tree", "similarity": 0.908}], "id": 1773, "stable_key": "clu_706db2ee9727283d", "ground_truth": {"modern_name": "Chestnut", "confidence": "high", "type": "plant", "linnaean": "Castanea sativa Miller", "family": "Fagaceae", "note": "The text mentions 'chestnut-tree in Kashmir inhabited by apes', which might point to a specific regional variety or a legendary association. However, the core referent is the chestnut tree.", "wikidata_id": "Q59835149", "wikidata_description": "popular deciduous tree"}}, {"canonical_name": "November", "category": "OTHER_CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "november", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "November", "category": "OTHER_CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["November"], "contexts": ["month of gathering plants"]}, {"entity_id": "nov_", "book_id": "kosmos_humboldt_1845", "name": "Nov.", "category": "OTHER_CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Nov."], "contexts": ["month of writing"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "November", "target_book": "kosmos_humboldt_1845", "target_name": "Nov.", "similarity": 0.911}], "id": 1774, "stable_key": "clu_6155fcdf24821979", "ground_truth": {"modern_name": "November", "confidence": "high", "type": "concept", "wikipedia_extract": "A fuzzy concept is an idea of which the boundaries of application can vary considerably according to context or conditions, instead of being fixed once and for all. That means the idea is somewhat vague or imprecise. Yet it is not unclear or meaningless. It has a definite meaning, which can often be made more exact with further elaboration and specification — including a closer definition of the context in which the concept is used. The inverse of a \"fuzzy concept\" is a \"crisp concept\" (i.e. a precise concept).", "wikipedia_url": "https://en.wikipedia.org/wiki/Fuzzy_concept"}}, {"canonical_name": "Yew", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "yew", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Yew", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Yew"], "contexts": ["plant and its berries are known to be harmless"]}, {"entity_id": "yews", "book_id": "kosmos_humboldt_1845", "name": "yews", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["yews"], "contexts": ["tree species in ancient forests"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Yew", "target_book": "kosmos_humboldt_1845", "target_name": "yews", "similarity": 0.938}], "id": 1775, "stable_key": "clu_6d1cfc92ee7f7982", "ground_truth": {"modern_name": "Yew", "confidence": "high", "type": "plant", "linnaean": "Taxus baccata Linnaeus", "family": "Taxaceae", "note": "The note about berries being 'harmless' is historically inaccurate for *Taxus baccata*, as the seeds within the arils are toxic. This reflects early modern knowledge, not the modern understanding of toxicity.", "wikidata_id": "Q8053327", "wikidata_description": "electoral ward of Liverpool City Council", "wikipedia_extract": "Taxus is a genus of coniferous trees or shrubs known as yews in the family Taxaceae. Yews occur around the globe in temperate zones of the northern hemisphere, northernmost in Norway and southernmost in the South Celebes. Some populations exist in tropical highlands. The oldest known fossil species are from the Early Cretaceous. They are relatively slow-growing and can be very long-lived, and reach heights of 2.5–20 m (8.2–65.6 ft), with trunk girth averaging 5 m (16 ft). They have reddish bark, lanceolate, flat, dark-green leaves 10–40 mm (1⁄2–1+1⁄2 in) long and 2–3 mm (3⁄32–1⁄8 in) broad, arranged spirally on the stem, but with the leaf bases twisted to align the leaves in two flat rows either side of the stem.", "wikipedia_url": "https://en.wikipedia.org/wiki/Taxus"}}, {"canonical_name": "Aloe", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "aloe", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Aloe", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Aloe"], "contexts": ["juice concrete drawing not at all"]}, {"entity_id": "aloelauato", "book_id": "ricettario_fiorentino_1597", "name": "Aloelauato", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Aloelauato"], "contexts": ["prepared aloe ingredient"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Aloe", "target_book": "ricettario_fiorentino_1597", "target_name": "Aloelauato", "similarity": 0.863}], "id": 1776, "stable_key": "clu_e63e745fd1229f1b", "ground_truth": {"modern_name": "Aloe", "confidence": "high", "type": "plant", "linnaean": "Aloe vera Linnaeus", "family": "Asphodelaceae", "note": "The term 'Aloelauato' likely refers to a preparation or specific preparation method of aloe, possibly a local or vernacular name. The primary botanical referent is aloe.", "wikidata_id": "Q80079", "wikidata_description": "species of plant, herb", "wikipedia_extract": "Aloe (; also written Aloë) is a genus containing over 650 species of flowering succulent plants. The most widely known  species is Aloe vera, or \"true aloe\". It is called this because it is cultivated as the standard source for assorted pharmaceutical purposes. Other species, such as Aloe ferox, are also cultivated or harvested from the wild for similar applications. The APG IV system (2016) places the genus in the family Asphodelaceae, subfamily Asphodeloideae. Within the subfamily it may be placed in the tribe Aloeae.", "wikipedia_url": "https://en.wikipedia.org/wiki/Aloe"}}, {"canonical_name": "Box", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "box", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Box", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Box"], "contexts": ["wood tested for electrical properties"]}, {"entity_id": "box", "book_id": "historia_medicinal_monardes_1574", "name": "Box", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Box"], "contexts": ["wood comparison for Guayaci"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Box", "target_book": "historia_medicinal_monardes_1574", "target_name": "Box", "similarity": 1.0}], "id": 1777, "stable_key": "clu_fffef1e4c245231c", "ground_truth": {"modern_name": "Boxwood", "confidence": "high", "type": "plant", "linnaean": "Buxus sempervirens Linnaeus", "family": "Buxaceae", "wikidata_id": "Q27344", "wikidata_description": "species of plant", "wikipedia_extract": "Buxus sempervirens, the common box, European box, or boxwood, is a species of flowering plant in the genus Buxus, native to western and southern Europe, northwest Africa, and southwest Asia, from southern England south to northern Morocco, and east through the northern Mediterranean region to Turkey. Buxus colchica of western Caucasus and B. hyrcana of northern Iran and eastern Caucasus are commonly treated as synonyms of B. sempervirens. Buxus sempervirens is an evergreen shrub or small tree growing 1 to 9 m (3 to 30 ft) tall, with a trunk up to 20 centimetres (8 in) in diameter (exceptionally to 10 m tall and 45 cm diameter). Arranged in opposite pairs along the stems, the leaves are green to yellow-green, oval, 1.5–3 cm long, and 0.5–1.3 cm broad.", "wikipedia_url": "https://en.wikipedia.org/wiki/Buxus_sempervirens"}}, {"canonical_name": "Valescus de Tarranta", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "valescus_de_tarranta", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Valescus de Tarranta", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["Valescus de Tarranta"], "contexts": ["physician who adhered to Arabick way"]}, {"entity_id": "valelcus_de_taranto", "book_id": "historia_medicinal_monardes_1574", "name": "Valelcus de Taranto", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["Valelcus de Taranto"], "contexts": ["celebrated physician of this time"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Valescus de Tarranta", "target_book": "historia_medicinal_monardes_1574", "target_name": "Valelcus de Taranto", "similarity": 0.921}], "id": 1778, "stable_key": "clu_7ecce11b300cd596", "ground_truth": {"modern_name": "Valescus de Tarenta", "confidence": "high", "type": "person", "description": "Celebrated physician adhering to the Arabick tradition."}}, {"canonical_name": "Emanuel", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "emanuel", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Emanuel", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Emanuel"], "contexts": ["of Portugal, sent an elephant"]}, {"entity_id": "emanuel", "book_id": "coloquios_da_orta_1563", "name": "Emanuel", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Emanuel"], "contexts": ["king whose chronicle was published"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Emanuel", "target_book": "coloquios_da_orta_1563", "target_name": "Emanuel", "similarity": 1.0}], "id": 1779, "stable_key": "clu_fab955094869351f", "ground_truth": {"modern_name": "Manuel I of Portugal", "confidence": "high", "type": "person", "birth_year": 1469, "death_year": 1521, "description": "King of Portugal who sent an elephant; his chronicle was published.", "note": "The text refers to 'Emanuel' of Portugal and a king whose chronicle was published. Manuel I fits both descriptions and was a prominent ruler in the period.", "wikidata_id": "Q191231", "wikidata_description": "King of Portugal from 1495 to 1521", "wikipedia_url": "https://en.wikipedia.org/wiki/Manuel%20I%20of%20Portugal"}}, {"canonical_name": "oyl of Tartar", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "oyl_of_tartar", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "oyl of Tartar", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["oyl of Tartar"], "contexts": ["precipitates aurum fulminans"]}, {"entity_id": "olio_del_tartaro", "book_id": "ricettario_fiorentino_1597", "name": "olio del tartaro", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["olio del tartaro"], "contexts": ["oil extracted from tartar"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "oyl of Tartar", "target_book": "ricettario_fiorentino_1597", "target_name": "olio del tartaro", "similarity": 0.855}], "id": 1780, "stable_key": "clu_677d3fef5deb4fc3", "ground_truth": {"modern_name": "Oil of Tartar", "confidence": "high", "type": "chemical", "note": "Oil of tartar (oleum tartari) was a common preparation in early modern pharmacy, often referring to potassium carbonate or a related substance derived from tartar.", "wikipedia_extract": "Steak tartare, or tartar steak, is a French dish of raw ground (minced) beef. It is usually served with onions, capers, parsley or chive, salt, pepper, Worcestershire sauce and other seasonings, often presented separately, to be added to taste. It is commonly served topped with a raw egg yolk. It is similar to Piedmontese battuta al coltello, as well as Levantine kibbeh nayyeh, Ethiopian kitfo, Turkish çiğ köfte, German Mett and Korean yukhoe. The name tartare is sometimes generalized to other raw meat or fish dishes. In France, a less-common variant called tartare aller-retour is a mound of mostly raw ground meat lightly seared on both sides.", "wikipedia_url": "https://en.wikipedia.org/wiki/Steak_tartare"}}, {"canonical_name": "Phytognomia", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "phytognomia", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Phytognomia", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Phytognomia"], "contexts": ["work by Baptista Porta"]}, {"entity_id": "phthisiologia", "book_id": "polyanthea_medicinal", "name": "Phthisiologia", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Phthisiologia"], "contexts": ["title of a book"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Phytognomia", "target_book": "polyanthea_medicinal", "target_name": "Phthisiologia", "similarity": 0.855}], "id": 1781, "stable_key": "clu_49d092b3dafc4eb9", "ground_truth": {"modern_name": "Phytognomonia", "confidence": "high", "type": "text", "note": "The cluster contains two similar-sounding titles. 'Phytognomonia' is a known work by Baptista Porta. 'Phthisiologia' refers to a treatise on consumption. Given the context of Baptista Porta, 'Phytognomonia' is the more likely primary referent."}}, {"canonical_name": "Philters", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "philters", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Philters", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Philters"], "contexts": ["superstitious cures"]}, {"entity_id": "philtro", "book_id": "polyanthea_medicinal", "name": "philtro", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["philtro"], "contexts": ["a love potion"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Philters", "target_book": "polyanthea_medicinal", "target_name": "philtro", "similarity": 0.931}], "id": 1782, "stable_key": "clu_c31515a5a72c7475", "ground_truth": {"modern_name": "Philter", "confidence": "high", "type": "concept", "note": "Philters were historically believed to be substances capable of inducing love or other effects, fitting the context of superstitious cures.", "wikidata_id": "Q11995612", "wikidata_description": ""}}, {"canonical_name": "Saxo", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "saxo", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Saxo", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Saxo"], "contexts": ["source for Olaus Magnus' history"]}, {"entity_id": "saxonia", "book_id": "polyanthea_medicinal", "name": "Saxonia", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Saxonia"], "contexts": ["cited for opinion on cauteries"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Saxo", "target_book": "polyanthea_medicinal", "target_name": "Saxonia", "similarity": 0.914}], "id": 1783, "stable_key": "clu_4b245eca1ea00830", "ground_truth": {"modern_name": "Saxo Grammaticus", "confidence": "high", "type": "person", "description": "Danish historian, author of Gesta Danorum.", "note": "Saxo Grammaticus is a well-known historical figure, cited by Olaus Magnus. 'Saxonia' could refer to the region, but in this context, the person is more plausible.", "wikidata_id": "Q106837", "wikidata_description": "Danish historian", "wikipedia_url": "https://en.wikipedia.org/wiki/Saxo%20Grammaticus"}}, {"canonical_name": "Alphonsus", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "alphonsus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Alphonsus", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Alphonsus"], "contexts": ["Duke of Ferrara"]}, {"entity_id": "alphonsus", "book_id": "polyanthea_medicinal", "name": "Alphonsus", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Alphonsus"], "contexts": ["King of Naples"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Alphonsus", "target_book": "polyanthea_medicinal", "target_name": "Alphonsus", "similarity": 1.0}], "id": 1784, "stable_key": "clu_3c7ab0ae13532344", "ground_truth": {"modern_name": "Alfonso V of Naples", "confidence": "high", "type": "person", "birth_year": 1400, "death_year": 1458, "description": "King of Naples, patron of arts and sciences.", "note": "The cluster refers to an 'Alphonsus' who was either Duke of Ferrara or King of Naples. Alfonso V of Naples was a significant figure and patron, fitting the context of historical texts. Alfonso II d'Este, Duke of Ferrara, also existed, but Alfonso V of Naples is more commonly referenced in general historical and scientific discourse of the period."}}, {"canonical_name": "Deitie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "deitie", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Deitie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Deitie"], "contexts": ["divine being"]}, {"entity_id": "deytayeſtes", "book_id": "polyanthea_medicinal", "name": "deytayeſtes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["deytayeſtes"], "contexts": ["take these"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Deitie", "target_book": "polyanthea_medicinal", "target_name": "deytayeſtes", "similarity": 0.842}], "id": 1785, "stable_key": "clu_6f16ecf7a6c02e04", "ground_truth": {"modern_name": "Deity", "confidence": "high", "type": "concept", "note": "The term 'Deitie' directly refers to a divine being, and 'deytayeſtes' (likely a variation of 'deities' or related concept) reinforces this. The context of 'divine being' is a direct match.", "wikidata_id": "Q178885", "wikidata_description": "natural or supernatural god or goddess, divine being", "wikipedia_url": "https://en.wikipedia.org/wiki/Deity"}}, {"canonical_name": "Bread", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bread", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Bread", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Bread"], "contexts": ["staple food"]}, {"entity_id": "bread", "book_id": "connexion_physical_sciences_somerville_1858", "name": "bread", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["bread"], "contexts": ["diamagnetic substance"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bread", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "bread", "similarity": 0.965}], "id": 1786, "stable_key": "clu_1e7e77b05731f2c8", "ground_truth": {"modern_name": "Bread", "confidence": "high", "type": "chemical", "note": "While bread is a food, its properties were discussed in early modern scientific texts, particularly its diamagnetic properties.", "wikidata_id": "Q37244887", "wikidata_description": "family name", "wikipedia_extract": "Substance theory, or substance–attribute theory, is an ontological theory positing that objects are constituted each by a substance and properties borne by the substance but distinct from it. In this role, a substance can be referred to as a substratum or a thing-in-itself. Substances are particulars that are ontologically independent: they are able to exist all by themselves. Another defining feature often attributed to substances is their ability to undergo changes. Changes involve something existing before, during and after the change. They can be described in terms of a persisting substance gaining or losing properties.", "wikipedia_url": "https://en.wikipedia.org/wiki/Substance_theory"}}, {"canonical_name": "sacred Text", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sacred_text", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "sacred Text", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["sacred Text"], "contexts": ["religious scripture"]}, {"entity_id": "sacred_writings", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sacred writings", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["sacred writings"], "contexts": ["texts describing ancient peoples"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sacred Text", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sacred writings", "similarity": 0.937}], "id": 1787, "stable_key": "clu_bfaf9a1873acb43a", "ground_truth": {"modern_name": "Sacred texts", "confidence": "high", "type": "text", "wikidata_id": "Q6055648", "wikidata_description": "website dedicated to the preservation of electronic public domain texts", "wikipedia_url": "https://en.wikipedia.org/wiki/Religious_text", "wikipedia_extract": "Religious texts, including scripture, are texts which various religions consider to be of central importance to their religious tradition. They often feature a compilation or discussion of beliefs, ritual practices, moral commandments and laws, ethical conduct, spiritual aspirations, and admonitions for fostering a religious community. Within each religion, these texts are revered as authoritative sources of guidance, wisdom, and divine revelation. They are often regarded as sacred or holy, representing the core teachings and principles that their followers strive to uphold. According to Peter Beal, the term scripture – derived from scriptura (Latin)  – meant \"writings [manuscripts] in general\" prior to the medieval era, and was then \"reserved to denote the texts of the Old and New Testaments of the Bible\". Beyond Christianity, according to the Oxford World Encyclopedia, the term scripture has referred to a text accepted to contain the \"sacred writings of a religion\", while The Oxford center of Dictionary of World Religions states it refers to a text \"having [religious] authority and often collected into an accepted canon\"."}}, {"canonical_name": "reverberation", "category": "PRACTICE", "subcategory": "OTHER_PRACTICE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "reverberation", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "reverberation", "category": "PRACTICE", "subcategory": "OTHER_PRACTICE", "count": 1, "variants": ["reverberation"], "contexts": ["operation of heating substances"]}, {"entity_id": "refractions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "refractions", "category": "PRACTICE", "subcategory": "OTHER_PRACTICE", "count": 1, "variants": ["refractions"], "contexts": ["bending of light"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "reverberation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "refractions", "similarity": 0.882}], "id": 1788, "stable_key": "clu_ca6eb49c304be6ae", "ground_truth": {"modern_name": "Reverberation furnace", "confidence": "medium", "type": "object", "note": "The term 'reverberation' in early modern texts likely refers to a reverberatory furnace used for heating substances. 'Refractions' in the second text seems to be a different concept, indicating ambiguity in the cluster. Focusing on the more specific 'reverberation' in the context of heating substances.", "wikidata_id": "Q1427028", "wikidata_description": "metallurgical furnace", "wikipedia_url": "https://en.wikipedia.org/wiki/Reverberatory_furnace", "wikipedia_extract": "A recording studio is a specialized facility for recording and mixing of instrumental or vocal musical performances, spoken words, and other sounds. They range in size from a small in-home project studio large enough to record a single singer-guitarist, to a large building with space for a full orchestra of 100 or more musicians. Ideally, both the recording and monitoring (listening and mixing) spaces are specially designed by an acoustician or audio engineer to achieve optimum acoustic properties (acoustic isolation or diffusion or absorption of reflected sound reverberation that could otherwise interfere with the sound heard by the listener). Recording studios may be used to record singers, instrumental musicians (e.g., electric guitar, piano, saxophone, or ensembles such as orchestras), voice-over artists for advertisements or dialogue replacement in film, television, or animation, Foley, or to record their accompanying musical soundtracks. The typical recording studio consists of a room called the \"studio\" or \"live room\" equipped with microphones and mic stands, where instrumentalists and vocalists perform; and the \"control room\", where audio engineers, sometimes with record producers, as well, operate professional audio mixing consoles, effects units, or computers with specialized software suites to mix, manipulate (e.g., by adjusting the equalization and adding effects) and route the sound for analog or digital recording. The engineers and producers listen to the live music and the recorded \"tracks\" on high-quality monitor speakers or headphones."}}, {"canonical_name": "diaphanity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "diaphanity", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "diaphanity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["diaphanity"], "contexts": ["quality of being transparent"]}, {"entity_id": "diaphaneity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "diaphaneity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["diaphaneity"], "contexts": ["transparency of a substance"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "diaphanity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "diaphaneity", "similarity": 0.98}], "id": 1789, "stable_key": "clu_98b2a7a95b5112f4", "ground_truth": {"modern_name": "Transparency", "confidence": "high", "type": "concept"}}, {"canonical_name": "Harts-horn", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "harts-horn", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Harts-horn", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Harts-horn"], "contexts": ["animal product tested for electricity"]}, {"entity_id": "horn", "book_id": "connexion_physical_sciences_somerville_1858", "name": "horn", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["horn"], "contexts": ["substance used in experiments"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Harts-horn", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "horn", "similarity": 0.859}], "id": 1790, "stable_key": "clu_00a00e789b99bac3", "ground_truth": {"modern_name": "Hartshorn", "confidence": "high", "type": "chemical", "note": "Hartshorn refers to processed deer antler, used medicinally and experimentally.", "wikidata_id": "Q37215346", "wikidata_description": "family name"}}, {"canonical_name": "blood", "category": "ANIMAL", "subcategory": "PRODUCT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "blood", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "blood", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["blood"], "contexts": ["animal fluid"]}, {"entity_id": "venous_blood", "book_id": "connexion_physical_sciences_somerville_1858", "name": "venous blood", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["venous blood"], "contexts": ["fluid with a red color"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "blood", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "venous blood", "similarity": 0.869}], "id": 1791, "stable_key": "clu_e42a911acc1a5ab0", "ground_truth": {"modern_name": "Blood", "confidence": "high", "type": "animal", "wikidata_id": "Q7873", "wikidata_description": "organic fluid which transports nutrients throughout the organism"}}, {"canonical_name": "parasitical Plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "parasitical_plants", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "parasitical Plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["parasitical Plants"], "contexts": ["plants that live on others"]}, {"entity_id": "parasitical_plants", "book_id": "connexion_physical_sciences_somerville_1858", "name": "parasitical plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["parasitical plants"], "contexts": ["plants that live on other plants"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "parasitical Plants", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "parasitical plants", "similarity": 0.99}], "id": 1792, "stable_key": "clu_ca25a9d702e8a9a9", "ground_truth": {"modern_name": "Parasitic plants", "confidence": "high", "type": "plant", "wikidata_id": "Q127498", "wikidata_description": "type of plant that derives some or all of its nutritional requirements from another living plant", "wikipedia_extract": "Plant diseases are diseases in plants caused by pathogens (infectious organisms) and environmental conditions (physiological factors). Organisms that cause infectious disease include fungi, oomycetes, bacteria, viruses, viroids, virus-like organisms, phytoplasmas, protozoa, nematodes and parasitic plants. Not included are ectoparasites like insects, mites, vertebrates, or other pests that affect plant health by eating plant tissues and causing injury that may admit plant pathogens. The study of plant disease is called plant pathology. Most phytopathogenic fungi are Ascomycetes or Basidiomycetes. They reproduce both sexually and asexually via the production of spores and other structures.", "wikipedia_url": "https://en.wikipedia.org/wiki/Parasitic_plant"}}, {"canonical_name": "Glow-worms", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "glow-worms", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Glow-worms", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["Glow-worms"], "contexts": ["insects that emit light when alive"]}, {"entity_id": "glow-worm", "book_id": "connexion_physical_sciences_somerville_1858", "name": "glow-worm", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["glow-worm"], "contexts": ["insect with pale light"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Glow-worms", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "glow-worm", "similarity": 0.946}], "id": 1793, "stable_key": "clu_21b576c5593258b4", "ground_truth": {"modern_name": "Glow-worm", "confidence": "high", "type": "animal", "wikidata_id": "Q3248829", "wikidata_description": "common name for various groups of insect larvae and adult larviform females that glow through bioluminescence", "wikipedia_extract": "Ungoliant photophaga, also known as the glow-worm hunter, is a species of long-legged harvestman in the family Neopilionidae. This species is endemic to New Zealand, found in North Island caves in the vicinity of Waitomo. The name \"photophaga\" comes from their habit of feeding on the luminescent larvae, pupae, and adults of the New Zealand glow-worm Arachnocampa luminosa. Until 2025, it was recovered in the genus Forsteropsalis. Both Aola Richards and Meyer-Rochow and Liddle had previously recorded a species of harvestman in caves at Waitomo feeding on glow-worms which they identified as Megalopsalis tumida (now considered a synonym of Ungoliant fabulosa). Further examination of specimens from the cave revealed this harvestman was in fact two new species of Forsteropsalis.", "wikipedia_url": "https://en.wikipedia.org/wiki/Glowworm"}}, {"canonical_name": "vigours", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "vigours", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "vigours", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vigours"], "contexts": ["strength or energy"]}, {"entity_id": "vigour", "book_id": "first_principles_spencer_1862", "name": "vigour", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vigour"], "contexts": ["physical strength and energy"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "vigours", "target_book": "first_principles_spencer_1862", "target_name": "vigour", "similarity": 0.938}], "id": 1794, "stable_key": "clu_e3cd5514992fefbb", "ground_truth": {"modern_name": "vigor", "confidence": "high", "type": "concept", "wikidata_id": "Q1268935", "wikidata_description": "French bishop and saint", "wikipedia_url": "https://en.wikipedia.org/wiki/Saint_Vigor", "wikipedia_extract": "Vigor is a given name and a surname."}}, {"canonical_name": "Æolian", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "æolian", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Æolian", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Æolian"], "contexts": ["related to wind or air"]}, {"entity_id": "æolian", "book_id": "first_principles_spencer_1862", "name": "Æolian", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Æolian"], "contexts": ["musical mode answering to keys"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Æolian", "target_book": "first_principles_spencer_1862", "target_name": "Æolian", "similarity": 1.0}], "id": 1795, "stable_key": "clu_6a5c4f1f21e81ae7", "ground_truth": {"modern_name": "Aeolian", "confidence": "high", "type": "concept", "wikidata_id": "Q215839", "wikidata_description": "processes due to wind activity", "wikipedia_url": "https://en.wikipedia.org/wiki/Aeolian_processes", "wikipedia_extract": "Aeolian sound or Aeolian tone is sound that is produced by wind when it passes over or through objects. Historically, Aeolus was the Greek ruler of the winds, and the Ancient Greeks believed these sounds were the voice of Aeolus. The earliest known observations about Aeolian sounds from a \"scientific\" viewpoint were made by Athanasius Kircher in 1650. An Aeolian tone is produced when air passes over an obstacle, resulting in trailing vortices with oscillatory behavior. These eddies can have strong periodic components, resulting in a steady tone. This phenomenon is the main topic of aeroacoustics."}}, {"canonical_name": "sore Throats", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sore_throats", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "sore Throats", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["sore Throats"], "contexts": ["condition treated by Jews ear"]}, {"entity_id": "sore_throat", "book_id": "first_principles_spencer_1862", "name": "sore throat", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["sore throat"], "contexts": ["pain or irritation in the throat"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sore Throats", "target_book": "first_principles_spencer_1862", "target_name": "sore throat", "similarity": 0.875}], "id": 1796, "stable_key": "clu_f5a536ade3bcda9d", "ground_truth": {"modern_name": "sore throat", "confidence": "high", "type": "disease", "modern_term": "pharyngitis", "wikidata_id": "Q1292082", "wikidata_description": "Pain of the throat", "wikipedia_url": "https://en.wikipedia.org/wiki/Sore_throat", "wikipedia_extract": "Tonsillectomy is a surgical procedure in which both palatine tonsils are fully removed from the back of the throat. The procedure is mainly performed for recurrent tonsillitis, throat infections and obstructive sleep apnea (OSA). For those with frequent throat infections, surgery results in 0.6 (95% confidence interval: 1.0 to 0.1) fewer sore throats in the following year, but there is no evidence of long term benefits. In children with OSA, it results in improved quality of life. While generally safe, complications may include bleeding, vomiting, dehydration, trouble eating, and trouble talking. Throat pain typically lasts about one to two weeks after surgery."}}, {"canonical_name": "Lobster", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "lobster", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Lobster", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Lobster"], "contexts": ["crustacean with a large claw"]}, {"entity_id": "lobster", "book_id": "first_principles_spencer_1862", "name": "lobster", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["lobster"], "contexts": ["example of longitudinal union in Vertebrata"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lobster", "target_book": "first_principles_spencer_1862", "target_name": "lobster", "similarity": 0.99}], "id": 1797, "stable_key": "clu_fd4cc8f24766f74b", "ground_truth": {"modern_name": "lobster", "confidence": "high", "type": "animal", "wikipedia_extract": "The American lobster (Homarus americanus) is a species of lobster found on the Atlantic coast of North America, chiefly from Labrador to New Jersey. It is also known as Atlantic lobster, Canadian lobster, true lobster, northern lobster, Canadian Reds, or Maine lobster. It can reach a body length of 64 cm (25 in), and a mass of over 20 kilograms (44 lb), making it not only the heaviest crustacean in the world, but also the heaviest of all living arthropod species. Its closest relative is the European lobster Homarus gammarus, which can be distinguished by its coloration and the lack of spines on the underside of the rostrum. American lobsters are usually bluish green to brown with red spines, but several color variations have been observed. Homarus americanus is distributed along the Atlantic coast of North America, from Labrador in the north to Cape Hatteras, North Carolina, in the south.", "wikipedia_url": "https://en.wikipedia.org/wiki/American_lobster"}}, {"canonical_name": "Cumberland", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cumberland", "book_id": "english_physician_1652", "name": "Cumberland", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cumberland"], "contexts": ["region where narrow leaved Bistort grows"]}, {"entity_id": "cumberlaud", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cumberlaud", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cumberlaud"], "contexts": ["island in the Arctic"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Cumberland", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Cumberlaud", "similarity": 0.889}], "id": 1798, "stable_key": "clu_77469e8c02fc5f62", "ground_truth": {"wikipedia_extract": "Cumberland ( KUM-bər-lənd) is an area of North West England which was historically a county. The county was bordered by Northumberland to the north-east, County Durham to the east, Westmorland to the south-east, Lancashire to the south, and the Scottish counties of Dumfriesshire and Roxburghshire to the north. The county included the city of Carlisle, part of the Lake District and North Pennines, and the Solway Firth coastline. Cumberland had an administrative function from the 12th century until 1974, when it was subsumed into Cumbria with Westmorland as well as parts of Yorkshire and Lancashire. It gives its name to the unitary authority area of Cumberland, which has similar boundaries but excludes Penrith. In the Early Middle Ages, Cumbria was part of the Kingdom of Strathclyde in the Hen Ogledd, or \"Old North\", and its people spoke a Brittonic language now called Cumbric."}}, {"canonical_name": "Realm", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "realm", "book_id": "english_physician_1652", "name": "Realm", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Realm"], "contexts": ["geographic location where plant grows"]}, {"entity_id": "royaume", "book_id": "relation_historique_humboldt_vol3_1825", "name": "royaume", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["royaume"], "contexts": ["kingdom, referring to France"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Realm", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "royaume", "similarity": 0.862}], "id": 1799, "stable_key": "clu_5a4b13f63b2782d5", "ground_truth": {"wikipedia_extract": "A realm is a community or territory over which a sovereign rules. The term is commonly used to describe a monarchical or dynastic state. A realm may also be a subdivision within an empire, if it has its own monarch, e.g. the German Empire. The Old French word reaume, modern French royaume, was the word first adopted in English; the fixed modern spelling does not appear until the beginning of the 17th century. The word supposedly derives from medieval Latin regalimen, from regalis, of or belonging to a rex 'king'. The word rex itself is derived from the Latin verb regere, which means 'to rule'."}}, {"canonical_name": "Horn-Church", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "horn-church", "book_id": "english_physician_1652", "name": "Horn-Church", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Horn-Church"], "contexts": ["highway location"]}, {"entity_id": "horn", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Horn", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Horn"], "contexts": ["cape for navigation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Horn-Church", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Horn", "similarity": 0.868}], "id": 1800, "stable_key": "clu_15ae5ee1f52d7e80", "ground_truth": {"modern_name": "Hornchurch", "confidence": "high", "type": "place", "country": "United Kingdom", "note": "The context for 'Horn' is ambiguous, but 'Horn-Church' is a specific place name. Assuming the reference is to the place.", "wikidata_id": "Q5904186", "wikidata_description": "Parliamentary constituency in the United Kingdom, 1945-2010", "wikipedia_extract": "Hornchurch is a suburban town in east London in the London Borough of Havering. It is located 15.2 miles (24.5 km) east-northeast of Charing Cross. It comprises a number of shopping streets and a large residential area. It historically formed a large ancient parish in the county of Essex that became the manor and liberty of Havering. The economic history of Hornchurch is underpinned by a shift away from agriculture to other industries with the growing significance of nearby Romford as a market town and centre of administration. As part of the suburban growth of London in the 20th century, Hornchurch significantly expanded and increased in population, becoming an urban district in 1926 and has formed part of Greater London since 1965.", "wikipedia_url": "https://en.wikipedia.org/wiki/Hornchurch_%28UK_Parliament_constituency%29"}}, {"canonical_name": "Path", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "path", "book_id": "english_physician_1652", "name": "Path", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Path"], "contexts": ["by path sides in the fields"]}, {"entity_id": "path", "book_id": "principles_of_psychology_james_1890", "name": "path", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["path"], "contexts": ["a way or track laid down for walking"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Path", "target_book": "principles_of_psychology_james_1890", "target_name": "path", "similarity": 0.986}], "id": 1801, "stable_key": "clu_ea337875177b2151", "ground_truth": {"modern_name": "path", "confidence": "high", "type": "place"}}, {"canonical_name": "ties the Tongue", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ties_the_tongue", "book_id": "english_physician_1652", "name": "ties the Tongue", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ties the Tongue"], "contexts": ["effect on dogs' vocalization"]}, {"entity_id": "tie", "book_id": "principles_of_psychology_james_1890", "name": "tie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tie"], "contexts": ["connection between mental states"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "ties the Tongue", "target_book": "principles_of_psychology_james_1890", "target_name": "tie", "similarity": 0.816}], "id": 1802, "stable_key": "clu_e8d42459111f78d9", "ground_truth": {"modern_name": "tongue-tie", "confidence": "high", "type": "concept", "note": "The contexts suggest both a literal physical condition ('ties the Tongue') and a metaphorical connection ('tie'). 'Tongue-tie' captures the literal meaning best in a medical context.", "wikidata_id": "Q557552", "wikidata_description": "congenital disorder of tongue mobility", "wikipedia_extract": "Tip of the tongue (also known as TOT, or lethologica) is the phenomenon of failing to retrieve a word or term from memory, combined with partial recall and the feeling that retrieval is imminent. The phenomenon's name comes from the saying, \"It's on the tip of my tongue.\" The tip of the tongue phenomenon reveals that lexical access occurs in stages. People experiencing the tip-of-the-tongue phenomenon can often recall one or more features of the target word, such as the first letter, its syllabic stress, and words similar in sound, meaning, or both sound and meaning. Individuals report a feeling of being seized by the state, feeling something like mild anguish while searching for the word, and a sense of relief when the word is found. While many aspects of the tip-of-the-tongue state remain unclear, there are two major competing explanations for its occurrence: the direct-access view and the inferential view. Emotion and the strength of the emotional ties to what is trying to be remembered can also have an impact on the TOT phenomenon.", "wikipedia_url": "https://en.wikipedia.org/wiki/Ankyloglossia"}}, {"canonical_name": "Salisbury", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "salisbury", "book_id": "english_physician_1652", "name": "Salisbury", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Salisbury"], "contexts": ["city near Alderbury"]}, {"entity_id": "salisbury", "book_id": "principles_of_psychology_james_1890", "name": "Salisbury", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Salisbury"], "contexts": ["location of publication"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Salisbury", "target_book": "principles_of_psychology_james_1890", "target_name": "Salisbury", "similarity": 1.0}], "id": 1803, "stable_key": "clu_20ad3701727f182c", "ground_truth": {"wikipedia_extract": "Salisbury ( SAWLZ-bər-ee, locally  SAWZ-bər-ee) is a cathedral city and civil parish in Wiltshire, England with a population of 41,820, at the confluence of the rivers Avon, Nadder and Bourne. The city is approximately 20 miles (30 kilometres) from Southampton and 30 miles (50 kilometres) from Bath. Salisbury is in the southeast of Wiltshire, near the edge of Salisbury Plain. An ancient cathedral was north of the present city at Old Sarum. A new cathedral was built near the meeting of the rivers and a settlement grew up around it, which received a city charter in 1227 as New Sarum. This continued to be its official name until 2009, when Salisbury City Council was established."}}, {"canonical_name": "Easter Sundaies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "easter_sundaies", "book_id": "english_physician_1652", "name": "Easter Sundaies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Easter Sundaies"], "contexts": ["holiday for eating Tansies"]}, {"entity_id": "easter", "book_id": "principles_of_psychology_james_1890", "name": "Easter", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Easter"], "contexts": ["Christian festival"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Easter Sundaies", "target_book": "principles_of_psychology_james_1890", "target_name": "Easter", "similarity": 0.837}], "id": 1804, "stable_key": "clu_31eff645510e315b", "ground_truth": {"modern_name": "Easter", "confidence": "high", "type": "concept", "wikidata_id": "Q16869752", "wikidata_description": "family name", "wikipedia_extract": "Easter Island (Spanish: Isla de Pascua, [ˈizla ðe ˈpaskwa]; Rapa Nui: Rapa Nui, [ˈɾapa ˈnu.i]) is an island and special territory of Chile in the southeastern Pacific Ocean, at the southeasternmost point of the Polynesian Triangle in Oceania. The island is renowned for its nearly 1,000 extant monumental statues, called moai, which were created by the early Rapa Nui people. In 1995, UNESCO named Easter Island a World Heritage Site, with much of the island protected within Rapa Nui National Park. Easter Island is also the only territory in Polynesia where Spanish is an official language. Experts differ on when the island's Polynesian inhabitants first reached the island. While many researchers cited evidence that they arrived around the year 800, a 2007 study provided compelling evidence suggesting their arrival was closer to 1200.", "wikipedia_url": "https://en.wikipedia.org/wiki/Easter_Island"}}, {"canonical_name": "shadow", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "shadow", "book_id": "english_physician_1652", "name": "shadow", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["shadow"], "contexts": ["natural element affecting plant growth"]}, {"entity_id": "shade", "book_id": "principles_of_psychology_james_1890", "name": "shade", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["shade"], "contexts": ["sensory quality perceived by the self"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "shadow", "target_book": "principles_of_psychology_james_1890", "target_name": "shade", "similarity": 0.887}], "id": 1805, "stable_key": "clu_e12b897a14438578", "ground_truth": {"wikipedia_extract": "A shadow is a dark area on a surface where light from a light source is blocked by an object. In contrast, shade occupies the three-dimensional volume behind an object with light in front of it. The cross-section of a shadow is a two-dimensional silhouette, or a reverse projection of the object blocking the light. A point source of light casts only a simple shadow, called an \"umbra\". For a non-point or \"extended\" source of light, the shadow is divided into the umbra, penumbra, and antumbra. The wider the light source, the more blurred the shadow becomes."}}, {"canonical_name": "Colechester", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "colechester", "book_id": "english_physician_1652", "name": "Colechester", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Colechester"], "contexts": ["place in Essex where Sea Colewort grows"]}, {"entity_id": "colchester", "book_id": "kosmos_humboldt_1845", "name": "Colchester", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Colchester"], "contexts": ["location of William Gilbert"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Colechester", "target_book": "kosmos_humboldt_1845", "target_name": "Colchester", "similarity": 0.927}], "id": 1806, "stable_key": "clu_a14bd85c4abfb66f", "ground_truth": {"modern_name": "Colchester", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q184163", "wikidata_description": "city in Essex, England, UK", "wikipedia_url": "https://en.wikipedia.org/wiki/Colchester", "wikipedia_extract": "Colchester (  KO(H)L-chest-ər, -⁠chist-) is a city in north-eastern Essex, England. At the 2021 census the built up area had a population of 130,245, making it the second-largest settlement in Essex, after Southend-on-Sea. It gives its name to the wider Colchester local government district which also covers an extensive surrounding area. The demonym is Colcestrian. Colchester occupies the site of Camulodunum, the first major city in Roman Britain and its first capital. Colchester therefore claims to be Britain's first city."}}, {"canonical_name": "tents", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "tents", "book_id": "english_physician_1652", "name": "tents", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["tents"], "contexts": ["used with balm for wounds"]}, {"entity_id": "felt_tents", "book_id": "kosmos_humboldt_1845", "name": "felt tents", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["felt tents"], "contexts": ["nomadic dwelling made of felt"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "tents", "target_book": "kosmos_humboldt_1845", "target_name": "felt tents", "similarity": 0.933}], "id": 1807, "stable_key": "clu_a5d2a7d4a3d48c0e", "ground_truth": {"modern_name": "Tents", "confidence": "high", "type": "object", "wikidata_id": "Q7700902", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Tenthredo"}}, {"canonical_name": "Springs", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "springs", "book_id": "english_physician_1652", "name": "Springs", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Springs"], "contexts": ["location where Maidenhair grows"]}, {"entity_id": "springs", "book_id": "kosmos_humboldt_1845", "name": "springs", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["springs"], "contexts": ["water sources from ground"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Springs", "target_book": "kosmos_humboldt_1845", "target_name": "springs", "similarity": 0.921}], "id": 1808, "stable_key": "clu_fcd4096fd9b4de9f", "ground_truth": {"modern_name": "Springs", "confidence": "high", "type": "place", "wikidata_id": "Q37562822", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Borrego_Springs,_California", "wikipedia_extract": "Borrego Springs is a census-designated place (CDP) in northeastern San Diego County, California. It is located within the Low Desert area of Southern California. The population was 3,073 at the 2020 census. Borrego Springs is surrounded by Anza-Borrego Desert State Park. Anza-Borrego State Park's name is derived from Juan Bautista de Anza, who notably camped there, and \"borrego\", which is Spanish for \"lamb\", in honor of the local herds of bighorn sheep. The area east of town was the site of a vast World War II US Navy training center, the Borrego Valley Maneuver Area, with supporting camps and airstrips."}}, {"canonical_name": "Pomatum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pomatum", "book_id": "english_physician_1652", "name": "Pomatum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Pomatum"], "contexts": ["ointment for chapped lips and hands"]}, {"entity_id": "poma", "book_id": "historia_medicinal_monardes_1574", "name": "Poma", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Poma"], "contexts": ["form of application for Ambar"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Pomatum", "target_book": "historia_medicinal_monardes_1574", "target_name": "Poma", "similarity": 0.873}], "id": 1809, "stable_key": "clu_67d34a882cc8448b", "ground_truth": {"wikipedia_extract": "Pomade is a greasy, waxy, or water-based substance that is used to style hair. It generally gives the user's hair a shiny, slick appearance. It lasts longer than most  hair-care products, and often requires repeated washes for complete removal. The pomades of the 18th and 19th centuries consisted mainly of bear fat or lard. Lanolin, beeswax and petroleum jelly have been used extensively in modern pomades. The hold of pomades makes sculptured hairstyles such as the  pompadour waves (hairstyle) possible."}}, {"canonical_name": "Bars", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bars", "book_id": "english_physician_1652", "name": "Bars", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Bars"], "contexts": ["condition treated by fumes of Betony decoction"]}, {"entity_id": "barros", "book_id": "historia_medicinal_monardes_1574", "name": "barros", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["barros"], "contexts": ["blemishes"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Bars", "target_book": "historia_medicinal_monardes_1574", "target_name": "barros", "similarity": 0.864}], "id": 1810, "stable_key": "clu_ae87028c84d7230c", "ground_truth": {"modern_name": "Blemishes", "confidence": "medium", "type": "disease", "modern_term": "Skin blemishes", "note": "The term 'Bars' is ambiguous and could refer to physical obstructions or skin imperfections/blemishes. Given the context of treatment and comparison with 'barros' (blemishes), it is most likely referring to skin blemishes.", "wikipedia_extract": "Diamond clarity is the quality of diamonds that relates to the existence and visual appearance of internal characteristics of a diamond called inclusions, and surface defects, called blemishes. Clarity is one of the four Cs of diamond grading, the others being carat, color, and cut. Inclusions are solids, liquids, or gases that were trapped in a mineral as it formed. They may be crystals of a foreign material or even another diamond crystal, or may have produced structural imperfections, such as tiny cracks that make a diamond appear whitish or cloudy. The number, size, color, relative location, orientation, and visibility of inclusions can all affect the relative clarity of a diamond. A clarity grade is assigned based on the overall appearance of the stone under ten times magnification, which is the standard magnification for loupes used in the gem world.", "wikipedia_url": "https://en.wikipedia.org/wiki/Diamond_clarity"}}, {"canonical_name": "Nebuchadnezzar", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "nebuchadnezzar", "book_id": "english_physician_1652", "name": "Nebuchadnezzar", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Nebuchadnezzar"], "contexts": ["carried writings to Babylon"]}, {"entity_id": "nebuchadnezzar", "book_id": "coloquios_da_orta_1563", "name": "Nebuchadnezzar", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Nebuchadnezzar"], "contexts": ["king whose name was stamped on bricks"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Nebuchadnezzar", "target_book": "coloquios_da_orta_1563", "target_name": "Nebuchadnezzar", "similarity": 0.807}], "id": 1811, "stable_key": "clu_b24c4be475b156f9", "ground_truth": {"wikipedia_extract": "Nebuchadnezzar II, also Nebuchadrezzar II, meaning \"Nabu, watch over my heir\", was the second king of the Neo-Babylonian Empire, ruling from the death of his father Nabopolassar in 605 BC to his own death in 562 BC. Often titled Nebuchadnezzar the Great, he is regarded as the empire's greatest king, famous for his military campaigns in the Levant and their role in Jewish history, and for his construction projects in his capital of Babylon, including the Hanging Gardens of Babylon. Ruling for 43 years, Nebuchadnezzar was the longest-reigning king of the Babylonian dynasty. By the time of his death, he was among the most powerful rulers in the world. Possibly named after his grandfather of the same name or after Nebuchadnezzar I, one of Babylon's greatest warrior-kings, Nebuchadnezzar II had already secured renown for himself during his father's reign, leading armies in the Medo-Babylonian conquest of the Assyrian Empire. At the Battle of Carchemish in 605 BC, Nebuchadnezzar inflicted a crushing defeat on an Egyptian army led by Pharaoh Necho II and ensured that the Neo-Babylonian Empire would succeed the Neo-Assyrian Empire as the dominant power in the ancient Near East."}}, {"canonical_name": "Dog-wood", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dog-wood", "book_id": "english_physician_1652", "name": "Dog-wood", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Dog-wood"], "contexts": ["local name for Foemale Cornel"]}, {"entity_id": "doge", "book_id": "coloquios_da_orta_1563", "name": "DOGE", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["DOGE"], "contexts": ["name of a plant"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Dog-wood", "target_book": "coloquios_da_orta_1563", "target_name": "DOGE", "similarity": 0.844}], "id": 1812, "stable_key": "clu_5c5f46ff2f759430", "ground_truth": {"modern_name": "Dogwood", "confidence": "medium", "type": "plant", "linnaean": "Cornus sanguinea L.", "family": "Cornaceae", "note": "The term 'DOGE' in 'coloquios_da_orta_1563' is likely a misspelling or OCR error of a plant name. Given the presence of 'Dog-wood' in the English text and the context of plants, 'Dogwood' is the most plausible referent. The Linnaean identification is based on common 'Dogwood' species.", "wikidata_id": "Q159545", "wikidata_description": "genus of plants", "wikipedia_extract": "Cornus sericea, the red osier or red-osier dogwood, is a species of flowering plant in the family Cornaceae, native to much of North America. It has sometimes been considered a synonym of the Asian species Cornus alba. Other names include red brush, red willow, redstem dogwood, redtwig dogwood, red-rood, American dogwood, creek dogwood, and western dogwood. It is a medium to tall deciduous shrub, growing 1.5–4 metres (4.9–13.1 feet) tall and 3–5 m (9.8–16.4 ft) wide, spreading readily by underground stolons to form dense thickets. The branches and twigs are dark red, although wild plants may lack this coloration in shaded areas. The leaves are opposite, 5–12 centimetres (2.0–4.7 inches) long and 2.5–6 cm (0.98–2.36 in) broad, with an ovate to oblong shape and an entire margin; they are dark green above and glaucous below; fall color is commonly bright red to purple.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cornus"}}, {"canonical_name": "Pickle", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pickle", "book_id": "english_physician_1652", "name": "Pickle", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Pickle"], "contexts": ["used with ground Elm-Tree bark"]}, {"entity_id": "pikles", "book_id": "coloquios_da_orta_1563", "name": "pikles", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["pikles"], "contexts": ["English name for preserved fruits"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Pickle", "target_book": "coloquios_da_orta_1563", "target_name": "pikles", "similarity": 0.892}], "id": 1813, "stable_key": "clu_3bf29dd9833d7e5e", "ground_truth": {"modern_name": "Pickles", "confidence": "high", "type": "preparation", "wikidata_id": "Q37544602", "wikidata_description": "family name", "wikipedia_extract": "This is a list of pickled foods. Many various types of foods are pickled to preserve them and add flavor. Some of these foods also qualify as fermented foods.", "wikipedia_url": "https://en.wikipedia.org/wiki/List_of_pickled_foods"}}, {"canonical_name": "Cardiaca", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cardiaca", "book_id": "english_physician_1652", "name": "Cardiaca", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Cardiaca"], "contexts": ["name for Motherwort due to heart effects"]}, {"entity_id": "cardiaco", "book_id": "coloquios_da_orta_1563", "name": "cardiaco", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cardiaco"], "contexts": ["medicinal property of sandalwood"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Cardiaca", "target_book": "coloquios_da_orta_1563", "target_name": "cardiaco", "similarity": 0.92}], "id": 1814, "stable_key": "clu_416fbcd964dfd977", "ground_truth": {"modern_name": "Cardiotonic", "confidence": "high", "type": "concept", "note": "'Cardiaca' and 'cardiaco' both relate to the heart, and in a medicinal context, refer to properties or substances that affect the heart, such as being cardiotonic.", "wikidata_id": "Q2938102", "wikidata_description": "agent that has a strengthening effect on the heart or that can increase cardiac output. for e.g . cardiac glycosides."}}, {"canonical_name": "Salt tast", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "salt_tast", "book_id": "english_physician_1652", "name": "Salt tast", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["Salt tast"], "contexts": ["taste of English Scurvey-grass"]}, {"entity_id": "gosto_de_sal", "book_id": "coloquios_da_orta_1563", "name": "gosto de sal", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["gosto de sal"], "contexts": ["taste of salt"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Salt tast", "target_book": "coloquios_da_orta_1563", "target_name": "gosto de sal", "similarity": 0.953}], "id": 1815, "stable_key": "clu_e636201dc48f1eea", "ground_truth": {"modern_name": "Salty taste", "confidence": "high", "type": "concept", "wikidata_id": "Q22243806", "wikidata_description": "Combining with soluble salty compounds to initiate a change in cell activity. These receptors are responsible for the sense of salty taste.", "wikipedia_extract": "Brigitte Anne-Marie Bardot (French: [bʁiʒit anmaʁi baʁdo]; 28 September 1934 – 28 December 2025), often referred to by her initials B.B., was a French actress, singer, model, and animal rights activist. She became one of the best-known symbols of the sexual revolution and gained international fame for portraying characters associated with hedonistic lifestyles. Although she withdrew from the entertainment industry in 1973, she remained a major pop culture icon. She appeared in 47 films, performed in several musicals, and recorded more than 60 songs. She was awarded the Legion of Honour in 1985. Born and raised in Paris, Bardot was an aspiring ballerina during her childhood.", "wikipedia_url": "https://en.wikipedia.org/wiki/Brigitte_Bardot"}}, {"canonical_name": "sibres", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sibres", "book_id": "english_physician_1652", "name": "sibres", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["sibres"], "contexts": ["part of Self-heal stalks"]}, {"entity_id": "sirih", "book_id": "coloquios_da_orta_1563", "name": "sirih", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["sirih"], "contexts": ["Malay name for betel leaf"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "sibres", "target_book": "coloquios_da_orta_1563", "target_name": "sirih", "similarity": 0.848}], "id": 1816, "stable_key": "clu_03432642e95810be", "ground_truth": {"modern_name": "Betel leaf", "confidence": "high", "type": "plant", "linnaean": "Piper betle Linnaeus", "family": "Piperaceae", "note": "The term 'sibres' and 'sirih' are likely phonetic transcriptions of the Malay name for betel leaf. 'Self-heal stalks' is a misinterpretation, as the context points to betel leaf used for medicinal purposes.", "wikidata_id": "Q130149531", "wikidata_description": "scholarly article published on 25 January 2018", "wikipedia_extract": "Betel (Piper betle) is a species of flowering plant in the pepper family Piperaceae, native to Southeast Asia. It is an evergreen, dioecious vine, with glossy heart-shaped leaves and white catkins. Betel plants are cultivated for their leaves, which are most commonly used as flavoring for chewing areca nut in so-called betel quid (often confusingly referred to as \"betel nut\"), which is toxic (as it is a psychostimulant drug) and is associated with a wide range of serious health conditions. The term betel was derived from the Malayalam/Tamil word vettila via Portuguese. Piper betle is originally native to Southeast Asia, from India, Philippines, Timor-Leste and Indonesia and Peninsular Malaysia to Indochina, Vietnam, Cambodia, Laos, Thailand, and Myanmar. Its cultivation has spread along with the Austronesian migrations and trade to other parts of Island Southeast Asia, Papua New Guinea and Melanesia, Micronesia, South Asia, the Maldives, Mauritius, Réunion Island, and Madagascar.", "wikipedia_url": "https://en.wikipedia.org/wiki/Betel"}}, {"canonical_name": "Fascination", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fascination", "book_id": "english_physician_1652", "name": "Fascination", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Fascination"], "contexts": ["possible cause of illness, witchcraft"]}, {"entity_id": "fascinações", "book_id": "coloquios_da_orta_1563", "name": "fascinações", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["fascinações"], "contexts": ["condition the root is against"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Fascination", "target_book": "coloquios_da_orta_1563", "target_name": "fascinações", "similarity": 0.921}], "id": 1817, "stable_key": "clu_1c9e6bc5f4257197", "ground_truth": {"modern_name": "Fascination", "confidence": "high", "type": "concept", "note": "In early modern contexts, 'Fascination' often referred to the 'evil eye' or a form of witchcraft causing illness, rather than the modern psychological phenomenon.", "wikipedia_extract": "Abasiophilia is a psychosexual attraction to people with impaired mobility, especially those who use orthopaedic appliances such as leg braces, orthopedic casts, or wheelchairs. The term abasiophilia was first used by John Money of the Johns Hopkins University in a paper on paraphilias, in 1990. Abasiophilia plays a prominent role in the Michael Connelly novel The Scarecrow, in which a serial killer is motivated by abasiophilia. Money, John (1988). Lovemaps: Clinical Concepts of Sexual/Erotic Health and Pathology, Paraphilia, and Gender Transposition in Childhood, Adolescence, and Maturity. Buffalo, N.Y: Prometheus Books.", "wikipedia_url": "https://en.wikipedia.org/wiki/Abasiophilia"}}, {"canonical_name": "Eclegma", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "eclegma", "book_id": "english_physician_1652", "name": "Eclegma", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Eclegma"], "contexts": ["Greek term for Lohoch"]}, {"entity_id": "eclèmmi", "book_id": "ricettario_fiorentino_1597", "name": "eclèmmi", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["eclèmmi"], "contexts": ["Greek name for locchi"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Eclegma", "target_book": "ricettario_fiorentino_1597", "target_name": "eclèmmi", "similarity": 0.848}], "id": 1818, "stable_key": "clu_fa740b32c27e4a47", "ground_truth": {"modern_name": "Loch", "confidence": "high", "type": "concept", "note": "Eclegma/eclèmmi are Greek terms for loch, a type of medicinal preparation."}}, {"canonical_name": "Collick", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "collick", "book_id": "english_physician_1652", "name": "Collick", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["Collick"], "contexts": ["pain treated by Angelica"]}, {"entity_id": "coliquati", "book_id": "polyanthea_medicinal", "name": "coliquati", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["coliquati"], "contexts": ["related to colic"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Collick", "target_book": "polyanthea_medicinal", "target_name": "coliquati", "similarity": 0.895}], "id": 1819, "stable_key": "clu_396d05b0113ca900", "ground_truth": {"wikipedia_extract": "Collick is a surname. Notable people with the surname include: Bill Collick (born c."}}, {"canonical_name": "Syrupus de Pomis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "syrupus_de_pomis", "book_id": "english_physician_1652", "name": "Syrupus de Pomis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Syrupus de Pomis"], "contexts": ["syrup made from apples"]}, {"entity_id": "xaropes_de_pomis", "book_id": "polyanthea_medicinal", "name": "xaropes de pomis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["xaropes de pomis"], "contexts": ["syrups made from apples"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Syrupus de Pomis", "target_book": "polyanthea_medicinal", "target_name": "xaropes de pomis", "similarity": 0.883}], "id": 1820, "stable_key": "clu_be93597071569e9c", "ground_truth": {"modern_name": "Syrup of Apples", "confidence": "high", "type": "chemical"}}, {"canonical_name": "Ash-tree Leaves", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ash-tree_leaves", "book_id": "english_physician_1652", "name": "Ash-tree Leaves", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Ash-tree Leaves"], "contexts": ["leaves of ash tree used against serpent bites"]}, {"entity_id": "ash_leaves", "book_id": "polyanthea_medicinal", "name": "ash leaves", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["ash leaves"], "contexts": ["herb"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Ash-tree Leaves", "target_book": "polyanthea_medicinal", "target_name": "ash leaves", "similarity": 0.872}], "id": 1821, "stable_key": "clu_d8d70142d779fe4c", "ground_truth": {"modern_name": "Ash leaves", "confidence": "high", "type": "plant", "linnaean": "Fraxinus excelsior Linnaeus", "family": "Oleaceae", "wikidata_id": "Q128887", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Fraxinus", "wikipedia_extract": "Fraxinus (), commonly called ash, is a genus of plants in the olive and lilac family, Oleaceae, and comprises 45–65 species of usually medium-to-large trees, most of which are deciduous (dropping their leaves in autumn), although some subtropical species are evergreen. The genus is widespread throughout much of Europe, Asia, and North America. The leaves are usually opposite, and mostly pinnately compound (divided into leaflets in a feather-like arrangement). The seeds, known as \"keys\", are botanically fruits of the type called samara. Some species are dioecious, having male and female flowers on separate plants. Ash wood is strong and elastic, and used for the handles of tools."}}, {"canonical_name": "Obstructions of the Brain", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "obstructions_of_the_brain", "book_id": "english_physician_1652", "name": "Obstructions of the Brain", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["Obstructions of the Brain"], "contexts": ["opened by Balm"]}, {"entity_id": "obftrucções_do_cerebro", "book_id": "polyanthea_medicinal", "name": "obftrucções do cerebro", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["obftrucções do cerebro"], "contexts": ["blockages in the brain"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Obstructions of the Brain", "target_book": "polyanthea_medicinal", "target_name": "obftrucções do cerebro", "similarity": 0.849}], "id": 1822, "stable_key": "clu_d191dde33b1a4f32", "ground_truth": {"modern_name": "Cerebral obstruction", "confidence": "high", "type": "disease", "modern_term": "Cerebral obstruction", "note": "This refers to blockages or impediments within the brain, not a specific modern diagnosis.", "wikipedia_extract": "Cerebral venous sinus thrombosis (CVST), cerebral venous and sinus thrombosis or cerebral venous thrombosis (CVT), is the presence of a blood clot in the dural venous sinuses (which drain blood from the brain), the cerebral veins, or both. Symptoms may include severe headache, visual symptoms, any of the symptoms of stroke such as weakness of the face and limbs on one side of the body, and seizures, which occur in around 40% of patients. The diagnosis is usually by computed tomography (CT scan) or magnetic resonance imaging (MRI) to demonstrate obstruction of the venous sinuses. After confirmation of the diagnosis, investigations may be performed to determine the underlying cause, especially if one is not readily apparent. Treatment is typically with anticoagulants (medications that suppress blood clotting) such as low molecular weight heparin. Rarely, thrombolysis (enzymatic destruction of the blood clot) or mechanical thrombectomy is used, although evidence for this therapy is limited.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cerebral_venous_sinus_thrombosis"}}, {"canonical_name": "Funnel", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "funnel", "book_id": "english_physician_1652", "name": "Funnel", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["Funnel"], "contexts": ["device for pouring"]}, {"entity_id": "funil", "book_id": "polyanthea_medicinal", "name": "funil", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["funil"], "contexts": ["device for administering fumes"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Funnel", "target_book": "polyanthea_medicinal", "target_name": "funil", "similarity": 0.924}], "id": 1823, "stable_key": "clu_fc7db128f542b6ab", "ground_truth": {"wikipedia_extract": "A funnel is a tube or pipe that is wide at the top and narrow at the bottom, used for guiding liquid or powder into a small opening. Funnels are usually made of stainless steel, aluminium, glass, or plastic. The material used in its construction should be sturdy enough to withstand the weight of the substance being transferred, and it should not react with the substance. For this reason, stainless steel or glass are useful in transferring diesel fuel, while plastic funnels are useful in the kitchen. Sometimes disposable paper funnels are used in cases where it would be difficult to adequately clean the funnel afterwards (for example, in adding motor oil into a car). Dropper funnels, also called dropping funnels or tap funnels, have a tap to allow the controlled release of a liquid."}}, {"canonical_name": "sal", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sal", "book_id": "english_physician_1652", "name": "sal", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["sal"], "contexts": ["injury causing bruising"]}, {"entity_id": "salion", "book_id": "polyanthea_medicinal", "name": "Salion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Salion"], "contexts": ["salivation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "sal", "target_book": "polyanthea_medicinal", "target_name": "Salion", "similarity": 0.811}], "id": 1824, "stable_key": "clu_7e297286185f0545", "ground_truth": {"modern_name": "Salivation", "confidence": "medium", "type": "disease", "modern_term": "Salivation", "note": "The context of 'sal' causing bruising is unusual. However, 'Salion' and the common meaning of 'sal' in early modern medicine suggests salivation, which could be associated with certain illnesses or the effects of remedies.", "wikidata_id": "Q4424146", "wikidata_description": "production of saliva", "wikipedia_extract": "Saliva (commonly referred to as spit, drool or slobber) is an extracellular fluid produced and secreted by salivary glands in the mouth. In humans, saliva is around 99% water, plus electrolytes, mucus, white blood cells, epithelial cells (from which DNA can be extracted), enzymes (such as lingual lipase and amylase), and antimicrobial agents (such as secretory IgA, and lysozymes). The enzymes found in saliva are essential in beginning the process of digestion of dietary starches and fats. These enzymes also play a role in breaking down food particles trapped within dental crevices, thus protecting teeth from bacterial decay. Saliva also performs a lubricating function, wetting food and permitting the initiation of swallowing, and protecting the oral mucosa from drying out. Saliva has specialized purposes for a variety of animal species beyond predigestion.", "wikipedia_url": "https://en.wikipedia.org/wiki/Salivation"}}, {"canonical_name": "Saturnine Diseas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "saturnine_diseas", "book_id": "english_physician_1652", "name": "Saturnine Diseas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Saturnine Diseas"], "contexts": ["illness attributed to Saturn"]}, {"entity_id": "saturnino", "book_id": "polyanthea_medicinal", "name": "Saturnino", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Saturnino"], "contexts": ["a condition related to lead poisoning"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Saturnine Diseas", "target_book": "polyanthea_medicinal", "target_name": "Saturnino", "similarity": 0.935}], "id": 1825, "stable_key": "clu_75a02ecf6bb67725", "ground_truth": {"modern_name": "Saturnine poisoning", "confidence": "high", "type": "disease", "modern_term": "Plumbism", "note": "Saturnine diseases refer to ailments attributed to the influence of the planet Saturn, which in early modern medicine was associated with lead and its toxic effects.", "wikipedia_extract": "Lead poisoning, also known as plumbism and saturnism, is a type of metal poisoning caused by the presence of lead in the human body. Symptoms of lead poisoning may include abdominal pain, constipation, headaches, irritability, memory problems, infertility, numbness and tingling in the hands and feet. Lead poisoning causes almost 10% of intellectual disability of otherwise unknown cause and can result in behavioral problems. Some of the effects are permanent. In severe cases, anemia, seizures, coma, or death may occur. Exposure to lead can occur through contaminated air, water, dust, food, or consumer products.", "wikipedia_url": "https://en.wikipedia.org/wiki/Lead_poisoning"}}, {"canonical_name": "Gors", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "gors", "book_id": "english_physician_1652", "name": "Gors", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Gors"], "contexts": ["alternative name for Furs-Bush"]}, {"entity_id": "gràos", "book_id": "polyanthea_medicinal", "name": "gràos", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["gràos"], "contexts": ["grains used in distillation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Gors", "target_book": "polyanthea_medicinal", "target_name": "gràos", "similarity": 0.851}], "id": 1826, "stable_key": "clu_c022dfb2c84fe48a", "ground_truth": {"modern_name": "Gorse", "confidence": "high", "type": "plant", "linnaean": "Ulex europaeus Linnaeus", "family": "Fabaceae", "note": "Contexts suggest both the plant and its use in distillation (grains).", "wikidata_id": "Q393278", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Ulex", "wikipedia_extract": "Ulex (commonly known as gorse, furze, or whin) is a genus of flowering plants in the family Fabaceae. The genus comprises about 20 species of thorny evergreen shrubs in the subfamily Faboideae of the pea family Fabaceae. The species are native to parts of western Europe and northwest Africa, with the majority of species in Iberia. Gorse is closely related to the brooms, and like them, it has green stems, very small leaves and is adapted to dry growing conditions. However, it differs from the brooms in its extreme thorniness, the shoots being modified into branched thorns 1–4 centimetres (1⁄2–1+1⁄2 inches) long, which almost wholly replace the leaves as the plant's functioning photosynthetic organs. The leaves of young plants are trifoliate, but in mature plants, they are reduced to scales or small spines."}}, {"canonical_name": "Viscuous Humors", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "viscuous_humors", "book_id": "english_physician_1652", "name": "Viscuous Humors", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Viscuous Humors"], "contexts": ["thick bodily fluids"]}, {"entity_id": "viscous_humors", "book_id": "polyanthea_medicinal", "name": "viscous humors", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["viscous humors"], "contexts": ["thick bodily fluids"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Viscuous Humors", "target_book": "polyanthea_medicinal", "target_name": "viscous humors", "similarity": 0.91}], "id": 1827, "stable_key": "clu_d4318174b58cfb9e", "ground_truth": {"modern_name": "Viscous humors", "confidence": "medium", "type": "concept", "note": "Refers to the humoral theory of medicine, specifically thick bodily fluids.", "wikidata_id": "Q5782572", "wikidata_description": "ancient Greek and Roman system of medicine involving four fluid types", "wikipedia_url": "https://en.wikipedia.org/wiki/Rheology", "wikipedia_extract": "Rheology (; from Ancient Greek  ῥέω (rhéō) 'flow' and  -λoγία (-logía) 'study of') is the study of the flow of matter, primarily in a fluid (liquid or gas) state, as well as \"soft solids\", which experience conditions under which they respond with plastic flow rather than elastic deformation to forces applied to them. Rheology is the branch of physics that deals with the deformation and flow of materials, both solids and liquids. The term rheology was coined by Eugene C. Bingham, a professor at Lafayette College, in 1920 from a suggestion by a colleague, Markus Reiner. The term was inspired by the aphorism of  Heraclitus (often mistakenly attributed to Simplicius), panta rhei (πάντα ῥεῖ, 'everything flows') and was first used to describe the flow of liquids and the deformation of solids. It applies to substances that have a complex microstructure, such as muds, sludges, suspensions, and polymers and other glass formers (e.g., silicates), as well as many foods and additives, bodily fluids (e.g., blood) and other biological materials, and other materials that belong to the class of soft matter such as food."}}, {"canonical_name": "oppressed Stomach", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "oppressed_stomach", "book_id": "english_physician_1652", "name": "oppressed Stomach", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["oppressed Stomach"], "contexts": ["condition helped by boiled pears"]}, {"entity_id": "de_stomachi_dolore", "book_id": "polyanthea_medicinal", "name": "de Stomachi dolore", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["de Stomachi dolore"], "contexts": ["on stomach pain"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "oppressed Stomach", "target_book": "polyanthea_medicinal", "target_name": "de Stomachi dolore", "similarity": 0.841}], "id": 1828, "stable_key": "clu_77ad428f2c2beeb1", "ground_truth": {"modern_name": "Dyspepsia", "confidence": "high", "type": "disease", "modern_term": "Dyspepsia", "note": "The Portuguese term 'de Stomachi dolore' directly translates to stomach pain, a symptom of dyspepsia.", "wikidata_id": "Q653971", "wikidata_description": "human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Indigestion", "wikipedia_extract": "Postcholecystectomy syndrome (PCS) describes the presence of abdominal symptoms after a cholecystectomy (gallbladder removal). Symptoms occur in about 5 to 40 percent of patients who undergo cholecystectomy, and can be transient, persistent or lifelong. The chronic condition is diagnosed in approximately 10% of postcholecystectomy cases. The pain associated with postcholecystectomy syndrome is usually ascribed to either sphincter of Oddi dysfunction or to post-surgical adhesions. A recent 2008 study shows that postcholecystectomy syndrome can be caused by biliary microlithiasis. Approximately 50% of cases are due to biliary causes such as remaining stone, biliary injury, dysmotility and choledococyst."}}, {"canonical_name": "Tendon", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "tendon", "book_id": "english_physician_1652", "name": "Tendon", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Tendon"], "contexts": ["connective tissue"]}, {"entity_id": "tendinosa", "book_id": "polyanthea_medicinal", "name": "Tendinosa", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Tendinosa"], "contexts": ["second tunic of the eye"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Tendon", "target_book": "polyanthea_medicinal", "target_name": "Tendinosa", "similarity": 0.87}], "id": 1829, "stable_key": "clu_0c5697b8a822e6ba", "ground_truth": {"wikipedia_extract": "A tendon or sinew is a tough band of dense fibrous connective tissue that connects muscle to bone. It sends the mechanical forces of muscle contraction to the skeletal system, while withstanding tension. Tendons, like ligaments, are made of collagen. The difference is that ligaments connect bone to bone, while tendons connect muscle to bone. There are about 4,000 tendons in the adult human body. A tendon is made of dense regular connective tissue, whose main cellular components are special fibroblasts called tendon cells (tenocytes)."}}, {"canonical_name": "deflexions from the Head", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "deflexions_from_the_head", "book_id": "english_physician_1652", "name": "deflexions from the Head", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["deflexions from the Head"], "contexts": ["condition helped by hesp conserve"]}, {"entity_id": "deftillações_da_cabeça_ao_peyto", "book_id": "polyanthea_medicinal", "name": "deftillações da cabeça ao peyto", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["deftillações da cabeça ao peyto"], "contexts": ["condition treated by Quintilio's powders"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "deflexions from the Head", "target_book": "polyanthea_medicinal", "target_name": "deftillações da cabeça ao peyto", "similarity": 0.864}], "id": 1830, "stable_key": "clu_93d0482fe39f29a3", "ground_truth": {"modern_name": "Phlegm accumulation from the head", "confidence": "medium", "type": "disease", "modern_term": "Phlegm accumulation", "note": "The Portuguese phrase 'da cabeça ao peyto' suggests a flow or condition from the head to the chest, often involving phlegm in historical medical contexts.", "wikidata_id": "Q17185833", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Phlegmariurus"}}, {"canonical_name": "Catapotia", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "catapotia", "book_id": "english_physician_1652", "name": "Catapotia", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Catapotia"], "contexts": ["Greek name for pills"]}, {"entity_id": "catapotijs", "book_id": "polyanthea_medicinal", "name": "Catapotijs", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Catapotijs"], "contexts": ["pills, medicinal preparation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Catapotia", "target_book": "polyanthea_medicinal", "target_name": "Catapotijs", "similarity": 0.967}], "id": 1831, "stable_key": "clu_da9c3d3b843ded03", "ground_truth": {"modern_name": "Pills", "confidence": "high", "type": "object", "note": "Both texts clearly refer to medicinal pills.", "wikidata_id": "Q37482280", "wikidata_description": "family name", "wikipedia_extract": "1Fe-LSD, also known as 1-(ferrocenecarbonyl)-LSD or as SYN-L-234, is a psychedelic drug of the lysergamide family related to lysergic acid diethylamide (LSD). It is thought to be a prodrug of LSD. The drug was patented by Lizard Labs in 2024. Subsequently, it was encountered online as a novel designer drug being sold in Germany in November 2025. 1Fe-LSD as the hemi-L-tartrate salt has been sold in the form of blotter containing 200 μg per tab and micropills containing 300 μg per pill. 1Fe-LSD contains ferrocene, an iron compound, which is an orange organometallic compound and is assumed to result in the distinctive orange color of 1Fe-LSD blotter and pills.", "wikipedia_url": "https://en.wikipedia.org/wiki/1Fe-LSD"}}, {"canonical_name": "hot Medicines", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "hot_medicines", "book_id": "english_physician_1652", "name": "hot Medicines", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["hot Medicines"], "contexts": ["medicines with heating properties"]}, {"entity_id": "remedios_quentes", "book_id": "polyanthea_medicinal", "name": "remedios quentes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["remedios quentes"], "contexts": ["hot medicinal substances"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "hot Medicines", "target_book": "polyanthea_medicinal", "target_name": "remedios quentes", "similarity": 0.862}], "id": 1832, "stable_key": "clu_4152ef168178304c", "ground_truth": {"modern_name": "Therapeutic heat", "confidence": "high", "type": "concept", "note": "Refers to the concept of medicines having warming properties within the humoral system.", "wikidata_id": "Q39870405", "wikidata_description": "scientific article published on March 1974", "wikipedia_extract": "A psychoactive drug, psychopharmaceutical, mind-altering drug, consciousness-altering drug, psychoactive substance, or psychotropic substance is a chemical substance that alters psychological functioning by modulating central nervous system (CNS) activity. Psychoactive and psychotropic drugs both affect the brain, with psychotropics sometimes referring to psychiatric drugs or high-abuse substances, while “drug” can have negative connotations. Novel psychoactive substances are designer drugs made to mimic illegal ones and bypass laws. Psychoactive drug use dates back to prehistory for medicinal and consciousness-altering purposes, with evidence of widespread cultural use. Many animals intentionally consume psychoactive substances, and some traditional legends suggest animals first introduced humans to their use. Psychoactive substances are used across cultures for purposes ranging from medicinal and therapeutic treatment of mental disorders and pain, to performance enhancement.", "wikipedia_url": "https://en.wikipedia.org/wiki/Psychoactive_drug"}}, {"canonical_name": "Curdled Milk", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "curdled_milk", "book_id": "english_physician_1652", "name": "Curdled Milk", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Curdled Milk"], "contexts": ["milk that has coagulated"]}, {"entity_id": "curdled_milk", "book_id": "polyanthea_medicinal", "name": "curdled milk", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["curdled milk"], "contexts": ["preparation of milk"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Curdled Milk", "target_book": "polyanthea_medicinal", "target_name": "curdled milk", "similarity": 0.962}], "id": 1833, "stable_key": "clu_750316407ffbf7b6", "ground_truth": {"wikipedia_extract": "Nicole Ann Bell (born September 8, 1991), known professionally as Nicole Dollanganger, is a Canadian-American singer-songwriter. Dollanganger's music is characterized by a feminine, high-pitched vocal style, minimalist instrumentation, and lyrical themes frequently pertaining to true crime, violence, sexuality, and romance. Her music has been described as \"lo-fi\", \"atmospheric\", and \"folk\", and is associated with the folk, folk pop, bedroom pop, slowcore and dream pop genres. In 2015, Rolling Stone named Dollanganger in an article titled \"10 New Artists You Need to Know,\" stating that her \"gothic folk songs,\" described as \"macabre millennial nightmares, softened by dream-pop tranquilizers, reverberating from a casket-shaped music box,\" are \"as beautiful as they are brutal.\" Most of her releases were released as digital-only, and a majority of them were initially published by Dollanganger herself through the music website Bandcamp. Her stage name comes from the Dollanganger Series of novels by V. C."}}, {"canonical_name": "Forgetfulness", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "forgetfulness", "book_id": "english_physician_1652", "name": "Forgetfulness", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["Forgetfulness"], "contexts": ["inability to recall"]}, {"entity_id": "esquecimentos", "book_id": "polyanthea_medicinal", "name": "esquecimentos", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["esquecimentos"], "contexts": ["forgetfulness"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Forgetfulness", "target_book": "polyanthea_medicinal", "target_name": "esquecimentos", "similarity": 0.925}], "id": 1834, "stable_key": "clu_3c63f24104dfb3f2", "ground_truth": {"wikipedia_extract": "Forgetting or disremembering is the apparent loss or modification of information already encoded and stored in an individual's short or long-term memory. It is a spontaneous or gradual process in which old memories are unable to be recalled from memory storage. Problems with remembering, learning and retaining new information are a few of the most common complaints of older adults. Studies show that retention improves with increased rehearsal. This improvement occurs because rehearsal helps to transfer information into long-term memory. Forgetting curves (amount remembered as a function of time since an event was first experienced) have been extensively analyzed."}}, {"canonical_name": "Hawthorn", "category": "PLANT", "subcategory": "PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "hawthorn", "book_id": "english_physician_1652", "name": "Hawthorn", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Hawthorn"], "contexts": ["common hedgerow tree"]}, {"entity_id": "hawthorn", "book_id": "first_principles_spencer_1862", "name": "hawthorn", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["hawthorn"], "contexts": ["flower with dome-shaped petals"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Hawthorn", "target_book": "first_principles_spencer_1862", "target_name": "hawthorn", "similarity": 0.886}], "id": 1835, "stable_key": "clu_9a397348e08d6446", "ground_truth": {"modern_name": "Hawthorn", "confidence": "high", "type": "plant", "linnaean": "Crataegus Linnaeus", "family": "Rosaceae", "wikidata_id": "Q132557", "wikidata_description": "genus of flowering plants in the rose family Rosaceae", "wikipedia_extract": "Crataegus (), commonly called hawthorn, quickthorn, thornapple, May-tree, whitethorn, Mayflower or hawberry, is a genus of several hundred species of shrubs and trees in the family Rosaceae, native to temperate regions of the Northern Hemisphere in Europe, Asia, North Africa and North America. The name \"hawthorn\" was originally applied to the species native to northern Europe, especially the common hawthorn C. monogyna, and the unmodified name is often so used in Britain and Ireland. The name is now also applied to the entire genus and to the related Asian genus Rhaphiolepis. Crataegus species are shrubs or small trees, mostly growing to 5–15 m (15–50 ft) tall, with small fruit and (usually) thorny branches. The most common type of bark is smooth grey in young individuals, developing shallow longitudinal fissures with narrow ridges in older trees.", "wikipedia_url": "https://en.wikipedia.org/wiki/Crataegus"}}, {"canonical_name": "Placentulae", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "placentulae", "book_id": "english_physician_1652", "name": "Placentulae", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Placentulae"], "contexts": ["Latin name for troches"]}, {"entity_id": "placental", "book_id": "first_principles_spencer_1862", "name": "placental", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["placental"], "contexts": ["mammals with a placenta"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Placentulae", "target_book": "first_principles_spencer_1862", "target_name": "placental", "similarity": 0.886}], "id": 1836, "stable_key": "clu_6b0342785af84c35", "ground_truth": {"modern_name": "Troches", "confidence": "high", "type": "object", "note": "While 'placental' in the second text might refer to mammalian placentas, the context of the first text ('troches') strongly suggests that 'Placentulae' refers to troches or lozenges.", "wikidata_id": "Q138696", "wikidata_description": "genus of plants", "wikipedia_extract": "Ancient Egyptian deities were an integral part of ancient Egyptian religion and were worshiped for millennia. Many of them ruled over natural and social phenomena, as well as abstract concepts These gods and goddesses appear in virtually every aspect of ancient Egyptian civilization, and more than 1,500 of them are known by name. Many Egyptian texts mention deities' names without indicating their character or role, while other texts refer to specific deities without even stating their name, so a complete list of them is difficult to assemble. This list does not include any Pharaohs who were usually deified, some within their own lifetime, nor does it include the spouses of the Ptolemaic rulers who were also usually deified. The only deified people on this list are the ones in which their deification was unique and uncommon for someone of their status.", "wikipedia_url": "https://en.wikipedia.org/wiki/List_of_Egyptian_deities"}}, {"canonical_name": "elatior", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "elatior", "book_id": "origin_of_species_darwin_1859", "name": "elatior", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["elatior"], "contexts": ["scientific name for primrose"]}, {"entity_id": "i__elatior", "book_id": "relation_historique_humboldt_vol3_1825", "name": "I. elatior", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["I. elatior"], "contexts": ["plant from Turbaco"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "elatior", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "I. elatior", "similarity": 0.946}], "id": 1837, "stable_key": "clu_3ba9c3486625f7e9", "ground_truth": {"modern_name": "Primula elatior", "confidence": "high", "type": "plant", "linnaean": "Primula elatior", "family": "Primulaceae", "note": "The context 'plant from Turbaco' might refer to a different species or a misidentification, but 'elatior' in scientific names typically refers to this primrose.", "wikidata_id": "Q157842", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Primula_elatior", "wikipedia_extract": "Primula elatior, the oxlip (or true oxlip), is a species of flowering plant in the family Primulaceae, native to  nutrient-poor and calcium-rich damp woods and meadows throughout Europe, with northern borders in Denmark and southern parts of Sweden, eastwards to the Altai Mountains and on the Kola Peninsula in Russia, and westwards in the British Isles. The oxlip is a herbaceous or semi-evergreen  perennial plant growing to 30 cm (12 in) tall by 25 cm (10 in) broad, with a rosette of leaves 5–15 cm long and 2–6 cm broad. It produces light yellow flowers in spring, in clusters of 10-30 together on a single stem 10–30 cm (4–12 in) tall, each flower 9–15 mm broad. It may be confused with the closely related cowslip (Primula veris), which has a similar general appearance, although P. veris has smaller, bell-shaped, bright yellow flowers (and red dots inside the flower), and a corolla tube without folds. The leaves of P."}}, {"canonical_name": "desert", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "desert", "book_id": "origin_of_species_darwin_1859", "name": "desert", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["desert"], "contexts": ["arid geographical area"]}, {"entity_id": "désert", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Désert", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Désert"], "contexts": ["geographic region"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "desert", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Désert", "similarity": 0.89}], "id": 1838, "stable_key": "clu_133e88649b587bda", "ground_truth": {"wikipedia_extract": "A desert is a landscape where little precipitation occurs and, consequently, living conditions create unique biomes and ecosystems. The lack of vegetation exposes the unprotected surface of the ground to denudation. About one-third of the land surface of the Earth is arid or semi-arid. This includes much of the polar regions, where little precipitation occurs, and which are sometimes called polar deserts or \"cold deserts\". Deserts can be classified by the amount of precipitation that falls, by the temperature that prevails, by the causes of desertification or by their geographical location. Deserts are formed by weathering processes as large variations in temperature between day and night strain the rocks, which consequently break into pieces."}}, {"canonical_name": "Rocky Mountains", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "rocky_mountains", "book_id": "origin_of_species_darwin_1859", "name": "Rocky Mountains", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Rocky Mountains"], "contexts": ["mountain range with erratic boulders"]}, {"entity_id": "rocky-mountains", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rocky-Mountains", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Rocky-Mountains"], "contexts": ["mountain range"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Rocky Mountains", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Rocky-Mountains", "similarity": 0.955}], "id": 1839, "stable_key": "clu_d41abbb9da1b16f8", "ground_truth": {"wikipedia_extract": "The Rocky Mountains, also known as the Rockies, are a major mountain range and the largest mountain system in North America. The Rocky Mountains stretch 3,000 mi (4,800 km) in a straight-line distance from the northernmost part of Western Canada, to New Mexico in the Southwestern United States. Depending on differing definitions between Canada and the U.S., its northern terminus is located either in northern British Columbia's Terminal Range south of the Liard River and east of the Trench, or in the northeastern foothills of the Brooks Range/British Mountains that face the Beaufort Sea coasts between the Canning River and the Firth River across the Alaska–Yukon border. Its southernmost point is near the Albuquerque metropolitan area, adjacent to the Rio Grande rift, and north of the Sandia–Manzano Mountain Range, also near Santa Fe, New Mexico. Being the easternmost portion of the North American Cordillera, the Rockies are distinct from the tectonically younger Cascade Range and Sierra Nevada, which both lie farther to its west. The Rockies formed 55 million to 80 million years ago during the Laramide orogeny, in which a number of plates began sliding underneath the North American plate."}}, {"canonical_name": "Proteaceæ", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "proteaceæ", "book_id": "origin_of_species_darwin_1859", "name": "Proteaceæ", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Proteaceæ"], "contexts": ["plant family discussed by Robert Brown"]}, {"entity_id": "protéacées", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Protéacées", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Protéacées"], "contexts": ["plant family, not exclusively austral"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Proteaceæ", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Protéacées", "similarity": 0.959}], "id": 1840, "stable_key": "clu_bd357f4a48fa412b", "ground_truth": {"modern_name": "Proteaceae", "confidence": "high", "type": "plant", "family": "Proteaceae", "wikidata_id": "Q157228", "wikidata_description": "family of plants in the Proteales order", "wikipedia_url": "https://en.wikipedia.org/wiki/Grevilleoideae", "wikipedia_extract": "The Grevilleoideae are a subfamily of the plant family Proteaceae. Mainly restricted to the Southern Hemisphere, it contains around 46 genera and about 950 species. Genera include Banksia, Grevillea, and Macadamia. The Grevilleoideae grow as trees, shrubs, or subshrubs. They are highly variable, making a simple, diagnostic identification key for the subfamily essentially impossible to provide. One common and fairly diagnostic characteristic is the occurrence of flowers in pairs that share a common bract."}}, {"canonical_name": "Catasetum", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "catasetum", "book_id": "origin_of_species_darwin_1859", "name": "Catasetum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Catasetum"], "contexts": ["genus of orchids"]}, {"entity_id": "catasetum_inaculutiun", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Catasetum inaculutiun", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Catasetum inaculutiun"], "contexts": ["orchid species"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Catasetum", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Catasetum inaculutiun", "similarity": 0.902}], "id": 1841, "stable_key": "clu_4e0c766419b57115", "ground_truth": {"wikipedia_extract": "Catasetum, abbreviated as Ctsm. in horticultural trade, is a genus of showy epiphytic  Orchids, family Orchidaceae, subfamily Epidendroideae, tribe Cymbidieae, subtribe Catasetinae, with currently 200 accepted species, many of which are highly prized in horticulture. Species of the genus Catasetum occur from Mexico to Argentina, including much of Central America, the West Indies, and South America. The largest number of species is in Brazil. They have thick, cigar-shaped pseudobulbs which are clustered. The leaves are pleated in the upper part and deciduous. The pseudobulbs become spiny after the leaves have dropped."}}, {"canonical_name": "Ulex", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ulex", "book_id": "origin_of_species_darwin_1859", "name": "Ulex", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Ulex"], "contexts": ["young leaves"]}, {"entity_id": "ulves", "book_id": "relation_historique_humboldt_vol3_1825", "name": "ulves", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["ulves"], "contexts": ["greenish ulves"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Ulex", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "ulves", "similarity": 0.855}], "id": 1842, "stable_key": "clu_1c83b6a9f8fbfa57", "ground_truth": {"wikipedia_extract": "Ulex (commonly known as gorse, furze, or whin) is a genus of flowering plants in the family Fabaceae. The genus comprises about 20 species of thorny evergreen shrubs in the subfamily Faboideae of the pea family Fabaceae. The species are native to parts of western Europe and northwest Africa, with the majority of species in Iberia. Gorse is closely related to the brooms, and like them, it has green stems, very small leaves and is adapted to dry growing conditions. However, it differs from the brooms in its extreme thorniness, the shoots being modified into branched thorns 1–4 centimetres (1⁄2–1+1⁄2 inches) long, which almost wholly replace the leaves as the plant's functioning photosynthetic organs. The leaves of young plants are trifoliate, but in mature plants, they are reduced to scales or small spines."}}, {"canonical_name": "Romans", "category": "OTHER_PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "romans", "book_id": "origin_of_species_darwin_1859", "name": "Romans", "category": "OTHER_PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Romans"], "contexts": ["ancient civilization"]}, {"entity_id": "roman", "book_id": "principles_of_psychology_james_1890", "name": "Roman", "category": "OTHER_PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Roman"], "contexts": ["soldiers who stormed Syracuse"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Romans", "target_book": "principles_of_psychology_james_1890", "target_name": "Roman", "similarity": 0.962}], "id": 1843, "stable_key": "clu_2e2fa1d97b7e3ff1", "ground_truth": {"modern_name": "Romans", "confidence": "high", "type": "concept", "note": "Refers to the ancient Roman civilization, not a specific individual.", "wikidata_id": "Q100899067", "wikidata_description": "basketball player"}}, {"canonical_name": "dray and race horse", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dray_and_race_horse", "book_id": "origin_of_species_darwin_1859", "name": "dray and race horse", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["dray and race horse"], "contexts": ["different breeds of horse"]}, {"entity_id": "dray-horses", "book_id": "principles_of_psychology_james_1890", "name": "dray-horses", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["dray-horses"], "contexts": ["working horses"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "dray and race horse", "target_book": "principles_of_psychology_james_1890", "target_name": "dray-horses", "similarity": 0.902}], "id": 1844, "stable_key": "clu_0744d2aa712c2cb7", "ground_truth": {"modern_name": "Horses", "confidence": "high", "type": "animal", "note": "Covers various breeds of horses, including those used for work (dray) and sport (race).", "wikidata_id": "Q726", "wikidata_description": "domesticated four-footed mammal from the equine family", "wikipedia_url": "https://en.wikipedia.org/wiki/Horse"}}, {"canonical_name": "fancies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fancies", "book_id": "origin_of_species_darwin_1859", "name": "fancies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fancies"], "contexts": ["human preferences and whims"]}, {"entity_id": "fancies", "book_id": "principles_of_psychology_james_1890", "name": "fancies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fancies"], "contexts": ["relics of sensory motions within us"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "fancies", "target_book": "principles_of_psychology_james_1890", "target_name": "fancies", "similarity": 1.0}], "id": 1845, "stable_key": "clu_813bda7a7872b92d", "ground_truth": {"wikipedia_extract": "Fancies is a cycle of six choral settings by John Rutter, created around whimsical themes and based on text from poets such as Shakespeare, Thomas Campion (1567–1620), Edward Lear (1812–1888) and others. The collection was originally written in 1971. Rutter recorded a recording with other compositions which was rereleased in 2005."}}, {"canonical_name": "slow-breeders", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "slow-breeders", "book_id": "origin_of_species_darwin_1859", "name": "slow-breeders", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["slow-breeders"], "contexts": ["organisms with slow reproduction"]}, {"entity_id": "slow", "book_id": "principles_of_psychology_james_1890", "name": "slow", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["slow"], "contexts": ["speed of motion"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "slow-breeders", "target_book": "principles_of_psychology_james_1890", "target_name": "slow", "similarity": 0.849}], "id": 1846, "stable_key": "clu_b78053311fccaa39", "ground_truth": {"modern_name": "Slow reproduction rate", "confidence": "medium", "type": "concept", "note": "The term 'slow' in the second context is ambiguous, but in conjunction with 'slow-breeders' and evolutionary texts, it likely refers to the rate of biological reproduction.", "wikipedia_extract": "Sawfish,  also known as carpenter sharks, are a family of very large rays characterized by a long, narrow, flattened rostrum, or nose extension, lined with sharp transverse teeth, arranged in a way that resembles a saw. They are among the largest fish, with some species reaching lengths of about 7–7.6 m (23–25 ft). They are found worldwide in tropical and subtropical regions in coastal marine and brackish estuarine waters, as well as freshwater rivers and lakes. All species are critically endangered. They should not be confused with sawsharks (order Pristiophoriformes) or the extinct sclerorhynchoids (order Rajiformes) which have a similar appearance, or swordfish (family Xiphiidae) which have a similar name but a very different appearance. Sawfishes are relatively slow breeders and the females give birth to live young.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sawfish"}}, {"canonical_name": "extensor muscle", "category": "ANATOMY", "subcategory": "TISSUE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "extensor_muscle", "book_id": "origin_of_species_darwin_1859", "name": "extensor muscle", "category": "ANATOMY", "subcategory": "TISSUE", "count": 1, "variants": ["extensor muscle"], "contexts": ["muscle that straightens a limb"]}, {"entity_id": "digital_extensor_muscle", "book_id": "principles_of_psychology_james_1890", "name": "digital extensor muscle", "category": "ANATOMY", "subcategory": "TISSUE", "count": 1, "variants": ["digital extensor muscle"], "contexts": ["muscle in the dog's limb"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "extensor muscle", "target_book": "principles_of_psychology_james_1890", "target_name": "digital extensor muscle", "similarity": 0.859}], "id": 1847, "stable_key": "clu_9b0dede724f10d84", "ground_truth": {"wikipedia_extract": "In anatomy, extension is a movement of a joint that increases the angle between two bones or body surfaces at a joint. Extension usually results in straightening of the bones or body surfaces involved. For example, extension is produced by extending the flexed (bent) elbow. Straightening of the arm would require extension at the elbow joint. If the head is tilted all the way back, the neck is said to be extended."}}, {"canonical_name": "cornea", "category": "ANATOMY", "subcategory": "BODY_PART", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cornea", "book_id": "origin_of_species_darwin_1859", "name": "cornea", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["cornea"], "contexts": ["outer transparent layer of eye"]}, {"entity_id": "cornea", "book_id": "principles_of_psychology_james_1890", "name": "cornea", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["cornea"], "contexts": ["transparent outer layer of eye"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "cornea", "target_book": "principles_of_psychology_james_1890", "target_name": "cornea", "similarity": 1.0}], "id": 1848, "stable_key": "clu_2ccb60ca4e57cea7", "ground_truth": {"wikipedia_extract": "The cornea is the transparent front part of the eyeball which covers the iris, pupil, and anterior chamber. Along with the anterior chamber and lens, the cornea refracts light, accounting for approximately two-thirds of the eye's total optical power. In humans, the refractive power of the cornea is approximately 43 dioptres. The cornea can be reshaped by surgical procedures such as LASIK. While the cornea contributes most of the eye's focusing power, its focus is fixed. Accommodation (the refocusing of light to better view near objects) is accomplished by changing the geometry of the lens."}}, {"canonical_name": "vitreous substance", "category": "ANATOMY", "subcategory": "FLUID", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "vitreous_substance", "book_id": "origin_of_species_darwin_1859", "name": "vitreous substance", "category": "ANATOMY", "subcategory": "FLUID", "count": 1, "variants": ["vitreous substance"], "contexts": ["gel-like substance in the eye"]}, {"entity_id": "vitreous_humor", "book_id": "principles_of_psychology_james_1890", "name": "vitreous humor", "category": "ANATOMY", "subcategory": "FLUID", "count": 1, "variants": ["vitreous humor"], "contexts": ["gel-like substance in the eye"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "vitreous substance", "target_book": "principles_of_psychology_james_1890", "target_name": "vitreous humor", "similarity": 0.876}], "id": 1849, "stable_key": "clu_5090486e7552b570", "ground_truth": {"modern_name": "Vitreous humor", "confidence": "high", "type": "anatomy", "wikidata_id": "Q18558199", "wikidata_description": "eye and adnexa disease that is located in the vitreous of the eye", "wikipedia_extract": "Vitrectomy is a surgery to remove some or all of the vitreous humor from the eye. Anterior vitrectomy entails removing small portions of the vitreous humor from the front structures of the eye—often because these are tangled in an intraocular lens or other structures. Pars plana vitrectomy is a general term for a group of operations accomplished in the deeper part of the eye, all of which involve removing some or all of the vitreous humor—the eye's clear internal jelly. Even before the modern era, some surgeons performed crude vitrectomies. For instance, Dutch surgeon Anton Nuck (1650–1692) claimed to have removed vitreous by suction in a young man with an inflamed eye. In Boston, John Collins Warren (1778–1856) performed a crude limited vitrectomy for angle closure glaucoma.", "wikipedia_url": "https://en.wikipedia.org/wiki/Vitrectomy"}}, {"canonical_name": "European species of plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "european_species_of_plants", "book_id": "origin_of_species_darwin_1859", "name": "European species of plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["European species of plants"], "contexts": ["plants from Azores to England"]}, {"entity_id": "european_species", "book_id": "kosmos_humboldt_1845", "name": "European species", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["European species"], "contexts": ["plant species found in Europe"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "European species of plants", "target_book": "kosmos_humboldt_1845", "target_name": "European species", "similarity": 0.971}], "id": 1850, "stable_key": "clu_cfbef7429126d5e1", "ground_truth": {"modern_name": "European flora", "confidence": "high", "type": "plant", "note": "Refers to plant species found within geographical Europe.", "wikidata_id": "Q31180018", "wikidata_description": "the collective plants of Europe", "wikipedia_extract": "Xanthium strumarium (rough cocklebur, Noogoora burr, clotbur, common cocklebur, large cocklebur, woolgarie bur, Siberian cocklebur) is a species of annual plants in the flowering plant family Asteraceae. Some sources claim it originates in southern Europe and Asia, but has been extensively naturalized elsewhere. Others, such as the Flora of China and Flora of North America, state it originates in the Americas but was an early introduction to Eurasia. The species is monoecious, with the flowers borne in separate unisexual heads: staminate (male) heads situated above the pistillate (female) heads in the inflorescence. The pistillate heads consist of two pistillate flowers surrounded by a spiny involucre. Upon fruiting, these two flowers ripen into two brown to black achenes and they are completely enveloped by the involucre, which becomes a bur.", "wikipedia_url": "https://en.wikipedia.org/wiki/Xanthium_strumarium"}}, {"canonical_name": "Nova Scotia", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "nova_scotia", "book_id": "origin_of_species_darwin_1859", "name": "Nova Scotia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Nova Scotia"], "contexts": ["Canadian province"]}, {"entity_id": "nova_scotia", "book_id": "kosmos_humboldt_1845", "name": "Nova Scotia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Nova Scotia"], "contexts": ["location with high tides"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Nova Scotia", "target_book": "kosmos_humboldt_1845", "target_name": "Nova Scotia", "similarity": 1.0}], "id": 1851, "stable_key": "clu_4de54a15a778862c", "ground_truth": {"modern_name": "Nova Scotia", "confidence": "high", "type": "place", "country": "Canada", "wikidata_id": "Q1952", "wikidata_description": "province of Canada", "wikipedia_extract": "Sydney is a former city and urban community on the east coast of Cape Breton Island in Nova Scotia, Canada within the Cape Breton Regional Municipality. Sydney was founded in 1785 by the British, incorporated as a city in 1904, and dissolved on 1 August 1995, when it was amalgamated into the regional municipality. Sydney served as Cape Breton Island's colonial capital until 1820, when the colony was annexed to  Nova Scotia. A rapid population expansion occurred just after the turn of the 20th century, when Sydney became home to one of North America's main steel mills. During both the First and Second World Wars, it was a major staging area for England-bound convoys. The post-war period witnessed a major decline in the number of people employed at the Dominion Steel and Coal Corporation steel mill, and the Nova Scotia and Canadian governments had to nationalize it in 1967 to save the region's biggest employer, forming the new crown corporation called the Sydney Steel Corporation.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sydney,_Nova_Scotia"}}, {"canonical_name": "Mylodon", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mylodon", "book_id": "origin_of_species_darwin_1859", "name": "Mylodon", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Mylodon"], "contexts": ["extinct giant ground sloth"]}, {"entity_id": "mylodon", "book_id": "kosmos_humboldt_1845", "name": "mylodon", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["mylodon"], "contexts": ["extinct sloth-like mammal"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Mylodon", "target_book": "kosmos_humboldt_1845", "target_name": "mylodon", "similarity": 0.983}], "id": 1852, "stable_key": "clu_4a0d652f2eee741e", "ground_truth": {"modern_name": "Mylodon", "confidence": "high", "type": "animal", "wikidata_id": "Q1749282", "wikidata_description": "family of mammals", "wikipedia_url": "https://en.wikipedia.org/wiki/Mylodontidae", "wikipedia_extract": "Mylodon is an extinct genus of ground sloth belonging to the family Mylodontidae, known from southern South America. With a total length of 3 to 4 m and a body mass of 1-2 tonnes, it is one of the largest mylodontids (though it was considerably exceeded in size by the mylodontid Lestodon). The oldest finds probably date to the Lower Pleistocene; however, most of the fossil remains date to the Late Pleistocene. Its distribution ranged from southern Bolivia and the Pampas in the north southwards to the southernmost part of Patagonia at around 52-53 degrees south, the furthest south of any Pleistocene ground sloth, with some of the best known remains of the species being from the eponymous Cueva del Milodon (cave of Mylodon) in southern Chile. In addition to skeletal remains, Mylodon is also known from preserved skin and hair. Preserved dung (coprolites) indicates that Mylodon was a primarily a grazer, feeding on grasses and sedges."}}, {"canonical_name": "arctic flora", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "arctic_flora", "book_id": "origin_of_species_darwin_1859", "name": "arctic flora", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["arctic flora"], "contexts": ["plants of arctic regions"]}, {"entity_id": "sub-arctic_flora", "book_id": "kosmos_humboldt_1845", "name": "sub-Arctic flora", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["sub-Arctic flora"], "contexts": ["flora adapted to cold climates"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "arctic flora", "target_book": "kosmos_humboldt_1845", "target_name": "sub-Arctic flora", "similarity": 0.925}], "id": 1853, "stable_key": "clu_9254778512b46f4f", "ground_truth": {"modern_name": "Arctic flora", "confidence": "high", "type": "plant", "wikipedia_extract": "Arctic geopolitics is the area study of geopolitics on the Arctic region. The study of geopolitics deals with the \"inalienable relationship between geography and politics\", as it investigates the effects of the Earth's geography on politics and international relations. Arctic geopolitics focuses on the inter-state relations in the Arctic, which is the northernmost polar region. It is composed of the Arctic Ocean and its adjacent seas, and is home to around four million people. The states in or bordering the Arctic are commonly referred to as the Arctic Eight, and are the United States, Canada, Russia, Finland, the Kingdom of Denmark (Greenland), Norway, Iceland and Sweden. The Arctic region is a unique environment.", "wikipedia_url": "https://en.wikipedia.org/wiki/Geopolitics_of_the_Arctic"}}, {"canonical_name": "Viti Archipelago", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "viti_archipelago", "book_id": "origin_of_species_darwin_1859", "name": "Viti Archipelago", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Viti Archipelago"], "contexts": ["archipelago with peculiar bats"]}, {"entity_id": "viti", "book_id": "kosmos_humboldt_1845", "name": "Viti", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Viti"], "contexts": ["group of islands"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Viti Archipelago", "target_book": "kosmos_humboldt_1845", "target_name": "Viti", "similarity": 0.863}], "id": 1854, "stable_key": "clu_38649b5f2c7f0f40", "ground_truth": {"modern_name": "Fiji", "confidence": "high", "type": "place", "country": "Fiji", "note": "The Viti Archipelago is the historical name for Fiji.", "wikidata_id": "Q10495035", "wikidata_description": "genus of insects", "wikipedia_extract": "This is a list of archipelagos, organised by oceans, then seas, then finally arranged alphabetically, with geographically isolated islands included as well.", "wikipedia_url": "https://en.wikipedia.org/wiki/List_of_archipelagos"}}, {"canonical_name": "endemic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "endemic", "book_id": "origin_of_species_darwin_1859", "name": "endemic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["endemic"], "contexts": ["native to a particular place"]}, {"entity_id": "endogenous", "book_id": "kosmos_humboldt_1845", "name": "endogenous", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["endogenous"], "contexts": ["generated in the interior"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "endemic", "target_book": "kosmos_humboldt_1845", "target_name": "endogenous", "similarity": 0.857}], "id": 1855, "stable_key": "clu_1e55a29c79721b9d", "ground_truth": {"modern_name": "Endemic", "confidence": "high", "type": "concept", "note": "The context implies the concept of a species being native to a specific geographic region.", "wikidata_id": "Q85759274", "wikidata_description": "Hawai'i is home to a large number of endemic species"}}, {"canonical_name": "kangaroo", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "kangaroo", "book_id": "origin_of_species_darwin_1859", "name": "kangaroo", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["kangaroo"], "contexts": ["marsupial mammal"]}, {"entity_id": "kangaroo", "book_id": "kosmos_humboldt_1845", "name": "kangaroo", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["kangaroo"], "contexts": ["animal with fossil remains"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "kangaroo", "target_book": "kosmos_humboldt_1845", "target_name": "kangaroo", "similarity": 1.0}], "id": 1856, "stable_key": "clu_563ee0c7acf10eb0", "ground_truth": {"modern_name": "Kangaroo", "confidence": "high", "type": "animal", "wikidata_id": "Q23193", "wikidata_description": "family of mammals", "wikipedia_extract": "Tree-kangaroos are marsupials of the genus Dendrolagus, adapted for arboreal locomotion. They inhabit the tropical rainforests of New Guinea and far northeastern  Queensland, Australia along with some of the islands in the region. Most species of tree-kangaroo are considered threatened due to hunting and habitat destruction. They are the only true arboreal macropods. The evolutionary history of tree-kangaroos possibly begins with a rainforest floor-dwelling pademelon-like ancestor. This ancestor possibly evolved from an arboreal possum-like ancestor as is suspected of all macropodid marsupials in Australia and New Guinea.", "wikipedia_url": "https://en.wikipedia.org/wiki/Macropodidae"}}, {"canonical_name": "mandibles", "category": "ANATOMY", "subcategory": "BODY_PART", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mandibles", "book_id": "origin_of_species_darwin_1859", "name": "mandibles", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["mandibles"], "contexts": ["mouthparts of an insect"]}, {"entity_id": "mandibles", "book_id": "kosmos_humboldt_1845", "name": "mandibles", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["mandibles"], "contexts": ["part of bird skeletons"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "mandibles", "target_book": "kosmos_humboldt_1845", "target_name": "mandibles", "similarity": 1.0}], "id": 1857, "stable_key": "clu_a96da12405ad0130", "ground_truth": {"modern_name": "Mandible", "confidence": "high", "type": "anatomy", "wikipedia_extract": "The mandible (from Latin: mandibula or mandĭbŭ-lum, a jaw)  of an arthropod is  a pair of mouthparts used either for biting or cutting and holding food. Mandibles are often simply called jaws. Mandibles are present in the extant subphyla Myriapoda (millipedes and others), Crustacea and Hexapoda (insects etc.). These groups make up the clade Mandibulata and comprise all living arthropods except arachnids and other chelicerates. Unlike chelicerae, mandibles are often used to chew food. Insect mandibles are as diverse in form as their food.", "wikipedia_url": "https://en.wikipedia.org/wiki/Mandible_(arthropod_mouthpart)"}}, {"canonical_name": "Compositous", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "compositous", "book_id": "origin_of_species_darwin_1859", "name": "Compositous", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Compositous"], "contexts": ["family of flowering plants (Asteraceae)"]}, {"entity_id": "compositof", "book_id": "coloquios_da_orta_1563", "name": "Compositof", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["Compositof"], "contexts": ["family of plants"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Compositous", "target_book": "coloquios_da_orta_1563", "target_name": "Compositof", "similarity": 0.871}], "id": 1858, "stable_key": "clu_375a00b18b434796", "ground_truth": {"modern_name": "Asteraceae", "confidence": "high", "type": "plant", "family": "Asteraceae", "note": "The term 'Compositous' or 'Compositof' refers to the family Asteraceae, also known as Compositae.", "wikidata_id": "Q25400", "wikidata_description": "large family of flowering plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Asteraceae"}}, {"canonical_name": "Hieracium", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "hieracium", "book_id": "origin_of_species_darwin_1859", "name": "Hieracium", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Hieracium"], "contexts": ["genus with polymorphic species"]}, {"entity_id": "hieracium", "book_id": "ricettario_fiorentino_1597", "name": "Hieracium", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Hieracium"], "contexts": ["plant name"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Hieracium", "target_book": "ricettario_fiorentino_1597", "target_name": "Hieracium", "similarity": 1.0}], "id": 1859, "stable_key": "clu_85450d724d593df8", "ground_truth": {"wikipedia_extract": "known by the common name hawkweed and classically as hierakion (from ancient Greek ἱέραξ, hierax 'hawk'), is a genus of flowering plant in the family Asteraceae, and closely related to dandelion (Taraxacum), chicory (Cichorium), prickly lettuce (Lactuca) and sow thistle (Sonchus), which are part of the tribe Cichorieae. Hawkweeds, with their 10,000+ recorded species and subspecies, do their part to make Asteraceae the second largest family of flowering plants. Some botanists group all these species or subspecies into approximately 800 accepted species, while others prefer to accept several thousand species. Since most hawkweeds reproduce exclusively asexually by means of seeds that are genetically identical to their mother plant (apomixis or agamospermy), clones or populations that consist of genetically identical plants are formed and some botanists (especially in UK, Scandinavia and Russia) prefer to accept these clones as good species (arguing that it is impossible to know how these clones are interrelated) whereas others (mainly in Central Europe and USA) try to group them into a few hundred more broadly defined species. What is here treated as the single genus Hieracium is now treated by most European experts as two different genera, Hieracium and Pilosella, with species such as Hieracium pilosella, Hieracium floribundum and Hieracium aurantiacum referred to the latter genus. Many members of the genus Pilosella reproduce both by stolons (runners like those of strawberries) and by seeds, whereas true Hieracium species reproduce only by seeds."}}, {"canonical_name": "ALBEMARLE STREET", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "albemarle_street", "book_id": "origin_of_species_darwin_1859", "name": "ALBEMARLE STREET", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["ALBEMARLE STREET"], "contexts": ["street in London"]}, {"entity_id": "albemarle_street", "book_id": "connexion_physical_sciences_somerville_1858", "name": "ALBEMARLE STREET", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["ALBEMARLE STREET"], "contexts": ["street address of publisher"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "ALBEMARLE STREET", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ALBEMARLE STREET", "similarity": 1.0}], "id": 1860, "stable_key": "clu_8e2445624e32e5fd", "ground_truth": {"modern_name": "Albemarle Street", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q134545274", "wikidata_description": "street in Baltimore, Maryland, the United States"}}, {"canonical_name": "Livingstone", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "livingstone", "book_id": "origin_of_species_darwin_1859", "name": "Livingstone", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Livingstone"], "contexts": ["observer of African domestic breeds"]}, {"entity_id": "dr__livingstone", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Dr. Livingstone", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Dr. Livingstone"], "contexts": ["explorer who discovered a region in Africa"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Livingstone", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Dr. Livingstone", "similarity": 0.841}], "id": 1861, "stable_key": "clu_a28acc881cbd94d2", "ground_truth": {"modern_name": "David Livingstone", "confidence": "high", "type": "person", "birth_year": 1813, "death_year": 1873, "description": "Scottish physician, missionary, and explorer in Africa", "wikidata_id": "Q75715315", "wikidata_description": "Peerage person ID=299455"}}, {"canonical_name": "condor", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "condor", "book_id": "origin_of_species_darwin_1859", "name": "condor", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["condor"], "contexts": ["bird that lays a couple of eggs"]}, {"entity_id": "condor", "book_id": "connexion_physical_sciences_somerville_1858", "name": "condor", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["condor"], "contexts": ["confined to the Andes and declivities"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "condor", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "condor", "similarity": 1.0}], "id": 1862, "stable_key": "clu_3968eba28aa25537", "ground_truth": {"modern_name": "Andean condor", "confidence": "high", "type": "animal", "note": "The context 'confined to the Andes' strongly suggests the Andean condor.", "wikidata_id": "Q170598", "wikidata_description": "species of bird", "wikipedia_url": "https://en.wikipedia.org/wiki/Andean_condor", "wikipedia_extract": "The Andean flamingo (Phoenicoparrus andinus) is a species of flamingo native to the Andes mountains of South America. Until 2014, it was classified in genus Phoenicopterus. It is closely related to James's flamingo, and the two make up the genus Phoenicoparrus. The Chilean flamingo, Andean flamingo, and James' flamingo are all sympatric, and all live in colonies (including shared nesting areas). Distribution, habitat, and movements This Andean flamingo is native to the wetlands of the high Andes mountain range from southern Peru to northwestern Argentina and northern Chile. Andean flamingos are migratory, with the ability to travel up to 700 miles in one day."}}, {"canonical_name": "shell", "category": "ANATOMY", "subcategory": "OTHER_ANOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "shell", "book_id": "origin_of_species_darwin_1859", "name": "shell", "category": "ANATOMY", "subcategory": "OTHER_ANOMY", "count": 1, "variants": ["shell"], "contexts": ["protective outer covering"]}, {"entity_id": "shell", "book_id": "connexion_physical_sciences_somerville_1858", "name": "shell", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["shell"], "contexts": ["outer protective layer"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "shell", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "shell", "similarity": 0.945}], "id": 1863, "stable_key": "clu_451d82f091228c1d", "ground_truth": {"modern_name": "Shell", "confidence": "high", "type": "concept", "note": "This refers to a general protective outer covering, not a specific anatomical structure or object in this context.", "wikidata_id": "Q18177320", "wikidata_description": "family name", "wikipedia_extract": "Shell plc is a British multinational oil and gas company, headquartered in London, England. Shell is a public limited company with a primary listing on the London Stock Exchange (LSE) and secondary listings on Euronext Amsterdam and the New York Stock Exchange. A core component of Big Oil, Shell is the second largest investor-owned oil and gas company in the world by revenue (after ExxonMobil), and among the world's largest companies out of any industry. Measured by both its own emissions, and the emissions of all the fossil fuels it sells, Shell was the ninth-largest corporate producer of greenhouse gas emissions in the period 1988–2015. Shell was formed in April 1907 through the merger of Royal Dutch Petroleum Company of the Netherlands and The \"Shell\" Transport and Trading Company of the United Kingdom, with 60 percent of stock ownership under Royal Dutch. The combined company rapidly became the leading competitor of the American Standard Oil and by 1920 Shell was the largest producer of oil in the world.", "wikipedia_url": "https://en.wikipedia.org/wiki/Shell_plc"}}, {"canonical_name": "Celebes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "celebes", "book_id": "origin_of_species_darwin_1859", "name": "Celebes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Celebes"], "contexts": ["island in Indonesia"]}, {"entity_id": "celebes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Celebes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Celebes"], "contexts": ["island affected by eruption"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Celebes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Celebes", "similarity": 1.0}], "id": 1864, "stable_key": "clu_b4404d7f446a0a92", "ground_truth": {"modern_name": "Celebes", "confidence": "high", "type": "place", "country": "Indonesia", "note": "Modern name is Sulawesi.", "wikidata_id": "Q28831520", "wikidata_description": "species of bird", "wikipedia_url": "https://en.wikipedia.org/wiki/Sulawesi", "wikipedia_extract": "Sulawesi ( SOO-lə-WAY-see, Indonesian: [ˌsulaˈwesi]), also known as Celebes ( SEL-ib-eez, sə-LEE-beez), is an island in Indonesia. One of the four Greater Sunda Islands, and the world's 11th-largest island, it is situated east of Borneo, west of the Maluku Islands, and south of Mindanao and the Sulu Archipelago. Within Indonesia, only Sumatra, Borneo, and Papua are larger in territory, and only Java and Sumatra are more populous. The landmass of Sulawesi includes four peninsulas: the northern Minahasa Peninsula, the East Peninsula, the South Peninsula, and the Southeast Peninsula. Three gulfs separate these peninsulas: the Gulf of Tomini between the northern Minahasa and East peninsulas, the Tolo Gulf between the East and Southeast peninsulas, and the Gulf of Boni between the South and Southeast peninsulas. The Strait of Makassar runs along the western side of the island and separates the island from Borneo."}}, {"canonical_name": "Archiac, M. de", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "archiac,_m__de", "book_id": "origin_of_species_darwin_1859", "name": "Archiac, M. de", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Archiac, M. de"], "contexts": ["on succession of species"]}, {"entity_id": "arcet,_m__d’", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Arcet, M. d’", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Arcet, M. d’"], "contexts": ["vibration of retina fibres"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Archiac, M. de", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Arcet, M. d’", "similarity": 0.846}], "id": 1865, "stable_key": "clu_48882499b2f6ee21", "ground_truth": {"modern_name": "Armand de Quatrefages de Bréau", "confidence": "medium", "type": "person", "birth_year": 1810, "death_year": 1899, "description": "French biologist who studied species succession and had interest in retina fibres", "note": "The members list is ambiguous. 'Archiac' might refer to Vicomte de Archiac, a geologist. 'M. d’Arcet' could refer to Jean d'Arcet, a chemist. However, given the context of species and evolution, Armand de Quatrefages is a strong candidate who also wrote about anatomical topics. The 'connexion_physical_sciences_somerville_1858' reference suggests someone with broad scientific interests. Further investigation of the specific text is needed for higher confidence.", "wikipedia_extract": "Paul Pierre Broca (, also UK: , US: , French: [pɔl bʁɔka]; 28 June 1824 – 9 July 1880) was a French physician, anatomist and anthropologist. He is best known for his research on Broca's area, a region of the frontal lobe that is  named after him. Broca's area is involved with language. His work revealed that the brains of patients with aphasia contained lesions in a particular part of the cortex, in the left frontal region. This was the first anatomical proof of localization of brain function. Broca's work contributed to the development of physical anthropology, advancing the science of anthropometry, and craniometry, in particular, the now-discredited practice of determining intelligence.", "wikipedia_url": "https://en.wikipedia.org/wiki/Paul_Broca"}}, {"canonical_name": "sacral vertebræ", "category": "ANATOMY", "subcategory": "BODY_PART", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sacral_vertebræ", "book_id": "origin_of_species_darwin_1859", "name": "sacral vertebræ", "category": "ANATOMY", "subcategory": "BODY_PART", "count": 1, "variants": ["sacral vertebræ"], "contexts": ["vertebrae fused to the pelvis"]}, {"entity_id": "sacral_vertebræ", "book_id": "first_principles_spencer_1862", "name": "sacral vertebræ", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["sacral vertebræ"], "contexts": ["vertebrae forming the sacrum"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "sacral vertebræ", "target_book": "first_principles_spencer_1862", "target_name": "sacral vertebræ", "similarity": 0.856}], "id": 1866, "stable_key": "clu_0050fa0fa0e88cbf", "ground_truth": {"modern_name": "Sacral vertebrae", "confidence": "high", "type": "anatomy", "note": "Refers to the fused vertebrae forming the sacrum.", "wikidata_id": "Q233316", "wikidata_description": "triangular-shaped bone at the bottom of the spine", "wikipedia_extract": "Each vertebra (pl.: vertebrae) is an irregular bone with a complex structure composed of bone and some hyaline cartilage, that make up the vertebral column or spine, of vertebrates. The proportions of the vertebrae differ according to their spinal segment and the particular species. The basic configuration of a vertebra varies; the vertebral body (also centrum) is of bone and bears the load of the vertebral column. The upper and lower surfaces of the vertebra body give attachment to the intervertebral discs. The posterior part of a vertebra forms a vertebral arch, in eleven parts, consisting of two pedicles (pedicle of vertebral arch), two laminae, and seven processes. The laminae give attachment to the ligamenta flava (ligaments of the spine).", "wikipedia_url": "https://en.wikipedia.org/wiki/Sacrum"}}, {"canonical_name": "Genesis", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "genesis", "book_id": "origin_of_species_darwin_1859", "name": "Genesis", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Genesis"], "contexts": ["biblical text mentioning animal colour"]}, {"entity_id": "genesis_of_science", "book_id": "first_principles_spencer_1862", "name": "Genesis of Science", "category": "ORGANIZATION", "subcategory": "OTHER_ORGANIZATION", "count": 1, "variants": ["Genesis of Science"], "contexts": ["article title"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Genesis", "target_book": "first_principles_spencer_1862", "target_name": "Genesis of Science", "similarity": 0.848}], "id": 1867, "stable_key": "clu_737b541eaabfa70b", "ground_truth": {"modern_name": "Book of Genesis", "confidence": "high", "type": "text", "note": "Refers to the biblical book, used here as a source of narrative or concept.", "wikipedia_extract": "Neon Genesis Evangelion is an anime series produced by Gainax and Tatsunoko Production and directed by Hideaki Anno. It began broadcasting in Japan on TV Tokyo on October 4, 1995, and ended on March 27, 1996. Evangelion is an apocalyptic storyline set in the mecha genre. It centers on a teenage boy recruited by a paramilitary organization named Nerv to control a giant cyborg called an Evangelion to fight monstrous beings known as Angels. The show takes place largely in a futuristic Tokyo years after a worldwide catastrophe. Parts of the series also focus on other Evangelion pilots and members of Nerv as they try to prevent another catastrophe.", "wikipedia_url": "https://en.wikipedia.org/wiki/List_of_Neon_Genesis_Evangelion_episodes"}}, {"canonical_name": "ductus pneumaticus", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ductus_pneumaticus", "book_id": "origin_of_species_darwin_1859", "name": "ductus pneumaticus", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["ductus pneumaticus"], "contexts": ["duct connecting swimbladder to esophagus"]}, {"entity_id": "duct", "book_id": "first_principles_spencer_1862", "name": "duct", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["duct"], "contexts": ["narrow connection to yelk-sack"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "ductus pneumaticus", "target_book": "first_principles_spencer_1862", "target_name": "duct", "similarity": 0.869}], "id": 1868, "stable_key": "clu_067b4d00f0a86f8a", "ground_truth": {"modern_name": "Pneumatic duct", "confidence": "high", "type": "anatomy", "note": "This likely refers to a duct connected to the swimbladder or related to respiration/air sacs. The 'ductus pneumaticus' is a specific term for the duct connecting the swim bladder to the esophagus in fish.", "wikidata_id": "Q1263587", "wikidata_description": "connecting duct between swim bladder and esophagus in fishes", "wikipedia_url": "https://de.wikipedia.org/wiki/Ductus_pneumaticus"}}, {"canonical_name": "Annelids", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "annelids", "book_id": "origin_of_species_darwin_1859", "name": "Annelids", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Annelids"], "contexts": ["segmented worms"]}, {"entity_id": "annulose_animals", "book_id": "first_principles_spencer_1862", "name": "annulose animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["annulose animals"], "contexts": ["segmented invertebrate animals"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Annelids", "target_book": "first_principles_spencer_1862", "target_name": "annulose animals", "similarity": 0.845}], "id": 1869, "stable_key": "clu_e3d2d4326c87a963", "ground_truth": {"modern_name": "Annelida", "confidence": "high", "type": "animal", "wikidata_id": "Q61937311", "wikidata_description": "scholarly article", "wikipedia_extract": "Lophotrochozoa (, \"crest/wheel animals\") is a clade of protostome animals within the Spiralia. The taxon was established as a monophyletic group based on molecular evidence. The clade includes animals like annelids, molluscs, bryozoans, and brachiopods. Lophotrochozoa was defined in 1995 as the \"last common ancestor of the three traditional lophophorate taxa (brachiopods, bryozoans, and phoronid worms), the mollusks and the annelids, and all of the descendants of that common ancestor\". It is a cladistic definition (a node-based name), so the affiliation to Lophotrochozoa of spiralian groups not mentioned directly in the definition depends on the topology of the spiralian tree of life, and in some phylogenetic hypotheses, Lophotrochozoa may even be synonymous to Spiralia. Nemertea and Orthonectida (if not directly considered as part of Annelida) are probably lophotrochozoan phyla; Dicyemida, Gastrotricha, and Platyhelminthes may be lophotrochozoans or placed in the Rouphozoa clade outside Lophotrochozoa; Chaetognatha, Gnathostomulida, Micrognathozoa, and Syndermata are probably gnathiferans and so placed as a basal spiralian clade outside Lophotrochozoa; Cycliophora could be a gnathiferan or a lophotrochozoan phylum.", "wikipedia_url": "https://en.wikipedia.org/wiki/Lophotrochozoa"}}, {"canonical_name": "exterminated", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "exterminated", "book_id": "origin_of_species_darwin_1859", "name": "exterminated", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["exterminated"], "contexts": ["completely destroyed or wiped out"]}, {"entity_id": "extinct", "book_id": "first_principles_spencer_1862", "name": "extinct", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["extinct"], "contexts": ["no longer existing"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "exterminated", "target_book": "first_principles_spencer_1862", "target_name": "extinct", "similarity": 0.889}], "id": 1870, "stable_key": "clu_429a871665f1c3e8", "ground_truth": {"modern_name": "Extinction", "confidence": "high", "type": "concept", "wikidata_id": "Q1385098", "wikidata_description": "fading of non-reinforced conditioned response over time", "wikipedia_url": "https://en.wikipedia.org/wiki/Extinction%20%28psychology%29"}}, {"canonical_name": "inheritance in common", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "inheritance_in_common", "book_id": "origin_of_species_darwin_1859", "name": "inheritance in common", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["inheritance in common"], "contexts": ["explanation for shared traits"]}, {"entity_id": "hereditary_transmission", "book_id": "first_principles_spencer_1862", "name": "hereditary transmission", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["hereditary transmission"], "contexts": ["principle of passing traits to offspring"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "inheritance in common", "target_book": "first_principles_spencer_1862", "target_name": "hereditary transmission", "similarity": 0.842}], "id": 1871, "stable_key": "clu_2c1d342964e3e1a1", "ground_truth": {"modern_name": "Inheritance", "confidence": "high", "type": "concept", "note": "The phrase 'inheritance in common' and 'hereditary transmission' both refer to the general concept of heredity.", "wikidata_id": "Q2261546", "wikidata_description": "scientific journal", "wikipedia_url": "https://en.wikipedia.org/wiki/Heredity_%28journal%29", "wikipedia_extract": "Inheritance is the practice of receiving private property, titles, debts, entitlements, privileges, rights, and obligations upon the death of an individual. The rules of inheritance differ among societies and have changed over time. In legal terms, succession refers to the process by which a deceased person’s rights and property are transferred to their heirs, while inheritance refers to the actual property or assets that those heirs receive. Succession may occur either under the generally applicable statutory rules, referred to as intestate succession, or in accordance with the provisions set forth in a valid will. A will often must be attested by a notary or by other lawful means in order to valid. Legal systems can differ significantly in how property passes from a deceased person to their heirs, with common law jurisdictions typically requiring formal probate procedures, while civil law systems often allow heirs to acquire ownership automatically by operation of law - the principle of saisine or seizin (Quebec)."}}, {"canonical_name": "imago", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "imago", "book_id": "origin_of_species_darwin_1859", "name": "imago", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["imago"], "contexts": ["adult stage of insect"]}, {"entity_id": "imago", "book_id": "first_principles_spencer_1862", "name": "imago", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["imago"], "contexts": ["stage evolved from pupa"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "imago", "target_book": "first_principles_spencer_1862", "target_name": "imago", "similarity": 1.0}], "id": 1872, "stable_key": "clu_c19a8196b7824754", "ground_truth": {"modern_name": "Imago", "confidence": "high", "type": "animal", "wikipedia_extract": "Terrestrial animals are animals that live predominantly or entirely on land (e.g., cats, chickens, ants, most spiders), as compared with aquatic animals (e.g., fish, whales, octopuses, lobsters, etc.), who live predominantly or entirely in bodies of water; and semiaquatic animals (e.g., crocodilians, seals, platypus and most amphibians), who inhabit coastal, riparian or wetland areas and rely on both aquatic and terrestrial habitats. While most insects (who constitute over half of all known species in the animal kingdom) are terrestrial, some groups, such as mosquitoes and dragonflies, spend their egg and larval stages in water but emerge as fully terrestrial adults (imagos) after completing metamorphosis. Terrestrial animals conduct respiratory gas exchange directly with the atmosphere, typically via specialized respiratory organs known as lungs, or via cutaneous respiration across the skin. They have also evolved homeostatic features such as impermeable cuticles that can restrict fluid loss, temperature fluctuations and infection, and an excretory system that can filter out nitrogenous waste in the form of urea or uric acid, in contrast to the ammonia-based excretion of aquatic animals. Without the buoyancy of an aqueous environment to support their weight, they have evolved robust skeletons that can hold up their body shape, as well as powerful appendages known as legs or limbs to facilitate terrestrial locomotion, although some perform limbless locomotion using body surface projections such as scales and setae. Some terrestrial animals even have wings or membranes that act as airfoils to generate lift, allowing them to fly and/or glide as airborne animals.", "wikipedia_url": "https://en.wikipedia.org/wiki/Terrestrial_animal"}}, {"canonical_name": "MAXIMA", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "maxima", "book_id": "relation_historique_humboldt_vol3_1825", "name": "MAXIMA", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["MAXIMA"], "contexts": ["maximum values in a table"]}, {"entity_id": "maxims", "book_id": "principles_of_psychology_james_1890", "name": "maxims", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["maxims"], "contexts": ["reservoir of principles"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "MAXIMA", "target_book": "principles_of_psychology_james_1890", "target_name": "maxims", "similarity": 0.876}], "id": 1873, "stable_key": "clu_08a7b2de5528756a", "ground_truth": {"modern_name": "Maxim", "confidence": "high", "type": "concept", "note": "The term 'MAXIMA' appears to be a Latinized plural or a specific reference within a table, while 'maxims' refers to guiding principles.", "wikidata_id": "Q16876594", "wikidata_description": "family name", "wikipedia_extract": "An aphorism (from Greek ἀφορισμός: aphorismos, denoting 'delimitation', 'distinction', and 'definition') is a concise, terse, laconic, or memorable expression of a general truth or principle. Aphorisms are often handed down by tradition from generation to generation. The concept is generally distinct from those of an adage, brocard, chiasmus, epigram, maxim (legal or philosophical), principle, proverb, and saying; although some of these concepts could be construed as types of aphorism. Often aphorisms are distinguished from other short sayings by the need for interpretation to make sense of them. In A Theory of the Aphorism, Andrew Hui defined an aphorism as \"a short saying that requires interpretation\". You cannot step into the same river twice.", "wikipedia_url": "https://en.wikipedia.org/wiki/Aphorism"}}, {"canonical_name": "grammes", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "grammes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "grammes", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["grammes"], "contexts": ["unit of mass"]}, {"entity_id": "grams", "book_id": "principles_of_psychology_james_1890", "name": "grams", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["grams"], "contexts": ["unit of mass used in experiments"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "grammes", "target_book": "principles_of_psychology_james_1890", "target_name": "grams", "similarity": 0.952}], "id": 1874, "stable_key": "clu_bd7ec5be32db5437", "ground_truth": {"wikipedia_extract": "The gram (originally gramme; SI unit symbol g) is a unit of mass in the International System of Units (SI) equal to one thousandth of a kilogram. Originally defined in 1795 as \"the absolute weight of a volume of pure water equal to the cube of the hundredth part of a metre [1 cm3], and at the temperature of melting ice\", the defining temperature (0 °C) was later changed to the temperature of maximum density of water (approximately 4 °C). Subsequent redefinitions agree with this original definition to within 30 parts per million (0.003%), with the maximum density of water remaining very close to 1 g/cm3, as shown by modern measurements. By the late 19th century, there was an effort to make the base unit the kilogram and the gram a derived unit. In 1960, the new International System of Units defined a gram as one thousandth of a kilogram (i.e., one gram is 1×10−3 kg). The kilogram, as of 2019, is defined by the International Bureau of Weights and Measures from the metre, the second, and from the fixed numerical value of the Planck constant (h)."}}, {"canonical_name": "Providence", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "providence", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Providence", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Providence"], "contexts": ["origin of corsairs"]}, {"entity_id": "providence", "book_id": "principles_of_psychology_james_1890", "name": "Providence", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Providence"], "contexts": ["city where money was drawn"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Providence", "target_book": "principles_of_psychology_james_1890", "target_name": "Providence", "similarity": 0.856}], "id": 1875, "stable_key": "clu_f2fe880228b2d138", "ground_truth": {"modern_name": "Providence", "confidence": "high", "type": "place", "country": "United States", "note": "The context 'city where money was drawn' strongly suggests Providence, Rhode Island, a significant port.", "wikidata_id": "Q18383", "wikidata_description": "capital city of Rhode Island, United States", "wikipedia_extract": "Providence ( ) is the capital and most populous city of the U.S. state of Rhode Island. It is the third-most populous city in New England with a population of 190,934 at the 2020 census, while the Providence metropolitan area extending into Massachusetts has approximately 1.7 million residents, the 39th-largest metropolitan area in the U.S. It is the county seat of Providence County. Providence is one of the oldest cities in New England, founded in 1636 by Reformed Baptist theologian Roger Williams, a religious exile from the Massachusetts Bay Colony. He named the area in honor of \"God's merciful Providence\" which he believed was responsible for revealing such a haven for him and his followers.", "wikipedia_url": "https://en.wikipedia.org/wiki/Providence,_Rhode_Island"}}, {"canonical_name": "pureté", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pureté", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pureté", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["pureté"], "contexts": ["state of being pure"]}, {"entity_id": "purity", "book_id": "kosmos_humboldt_1845", "name": "purity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["purity"], "contexts": ["state of being unadulterated"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pureté", "target_book": "kosmos_humboldt_1845", "target_name": "purity", "similarity": 0.96}], "id": 1876, "stable_key": "clu_b4d2ad8de9a83f4c", "ground_truth": {"modern_name": "Purity", "confidence": "high", "type": "concept", "wikidata_id": "Q1401905", "wikidata_description": "mass fraction of fine metal in a precious metal object", "wikipedia_extract": "The fineness of a precious metal object (coin, bar, jewelry, etc.) represents the weight of fine metal therein, in proportion to the total weight which includes alloying base metals and any impurities. Alloy metals are added to increase hardness and durability of coins and jewelry, alter colors, decrease the cost per weight, or avoid the cost of high-purity refinement. For example, copper is added to the precious metal silver to make a more durable alloy for use in coins, housewares and jewelry. Coin silver, which was used for making silver coins in the past, contains 90% silver and 10% copper, by mass. Sterling silver contains 92.5% silver and 7.5% of other metals, usually copper, by mass. Various ways of expressing fineness have been used and two remain in common use: millesimal fineness expressed in units of parts per 1,000 and karats or carats used only for gold.", "wikipedia_url": "https://en.wikipedia.org/wiki/Fineness"}}, {"canonical_name": "Landaguate", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "landaguate", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Landaguate", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Landaguate"], "contexts": ["geographic location name"]}, {"entity_id": "landerote", "book_id": "kosmos_humboldt_1845", "name": "Landerote", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Landerote"], "contexts": ["island related to eruption of Teneriffe"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Landaguate", "target_book": "kosmos_humboldt_1845", "target_name": "Landerote", "similarity": 0.867}], "id": 1877, "stable_key": "clu_20af5ba735119ace", "ground_truth": {"modern_name": "Landaguate", "confidence": "medium", "type": "place", "country": "Spain", "note": "The reference to an 'island related to eruption of Teneriffe' suggests the Canary Islands. 'Landaguate' and 'Landerote' are likely phonetic spellings or variant names for locations on Tenerife, possibly related to geological features or historical settlements. Landerote is a known historical settlement. Landaguate is less clear and could be a misspelling or obscure name."}}, {"canonical_name": "Bcfaria", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bcfaria", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bcfaria", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Bcfaria"], "contexts": ["alpine shrub found in Silla de Caracas"]}, {"entity_id": "befaria", "book_id": "kosmos_humboldt_1845", "name": "befaria", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["befaria"], "contexts": ["magnificent flowering shrub"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bcfaria", "target_book": "kosmos_humboldt_1845", "target_name": "befaria", "similarity": 0.86}], "id": 1878, "stable_key": "clu_f44f871dc873aa13", "ground_truth": {"modern_name": "Befaria", "confidence": "high", "type": "plant", "linnaean": "Befaria resinosa", "family": "Ericaceae"}}, {"canonical_name": "Thibaudia", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "thibaudia", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Thibaudia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Thibaudia"], "contexts": ["alpine shrub found in Silla de Caracas"]}, {"entity_id": "thibaudia", "book_id": "kosmos_humboldt_1845", "name": "thibaudia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["thibaudia"], "contexts": ["social plant"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Thibaudia", "target_book": "kosmos_humboldt_1845", "target_name": "thibaudia", "similarity": 0.988}], "id": 1879, "stable_key": "clu_e363c98cb807cfc6", "ground_truth": {"modern_name": "Thibaudia", "confidence": "high", "type": "plant", "linnaean": "Thibaudia sp.", "family": "Ericaceae", "note": "This is a genus name, specific species not identified.", "wikidata_id": "Q73739", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Thibaudia", "wikipedia_extract": "Thibaudia is a genus of flowering plants in the family Ericaceae. They are native to Central and South America with a high concentration of species in the cloud forests of Costa Rica and Ecuador. Species of the genus are known commonly as zagalitas."}}, {"canonical_name": "Ouata", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ouata", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Ouata", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Ouata"], "contexts": ["island name in Caribe language"]}, {"entity_id": "oeta", "book_id": "kosmos_humboldt_1845", "name": "Oeta", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Oeta"], "contexts": ["mountain at Thermopylae"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ouata", "target_book": "kosmos_humboldt_1845", "target_name": "Oeta", "similarity": 0.887}], "id": 1880, "stable_key": "clu_6474f04eb1f16c7a", "ground_truth": {"modern_name": "Oeta", "confidence": "high", "type": "place", "country": "Greece", "note": "The text mentions both a Caribbean island name and a mountain at Thermopylae, but the latter is the more prominent historical and geographical reference for 'Oeta'.", "wikidata_id": "Q132378", "wikidata_description": "mountain in Lamia municipality, Greece", "wikipedia_url": "https://en.wikipedia.org/wiki/Mount_Oeta", "wikipedia_extract": "Mount Oeta (; Greek: Οίτη, polytonic Οἴτη, Oiti, also transcribed as Oite) is a mountain in Central Greece. A southeastern offshoot of the Pindus range, it is 2,152 m (7,060 ft) high. Since 1966, the core area of the mountain is a national park, and much of the rest has been declared a special area under Natura 2000. Mount Oeta is located on the boundaries of the prefectures of Phocis in the south and Phthiotis in the north. Its northern side displays a steep and inaccessible terrain as it descends to the rift valley of the Spercheios river, forming a series of deep gorges—most famous of which is that of the Gorgopotamos river—a few of which boast large waterfalls, including the Kremastos waterfall, considered the highest in Central Greece. To the east, Oeta is defined by the gorge of the Asopos (Ασωπός) river, which forms its boundary with the neighbouring Mount Kallidromo."}}, {"canonical_name": "Lahore", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "lahore", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Lahore", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Lahore"], "contexts": ["independent state"]}, {"entity_id": "lahore", "book_id": "kosmos_humboldt_1845", "name": "Lahore", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Lahore"], "contexts": ["location of earthquake propagation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lahore", "target_book": "kosmos_humboldt_1845", "target_name": "Lahore", "similarity": 1.0}], "id": 1881, "stable_key": "clu_b6548ccc9c746bd4", "ground_truth": {"modern_name": "Lahore", "confidence": "high", "type": "place", "country": "Pakistan", "wikidata_id": "Q11739", "wikidata_description": "capital of the Punjab province, Pakistan", "wikipedia_url": "https://en.wikipedia.org/wiki/Lahore", "wikipedia_extract": "Lahore is the capital and largest city of the Pakistani province of Punjab. It is the second-largest city in Pakistan, after Karachi, and 27th largest in the world, with a population of over 14 million. Lahore is one of Pakistan's major industrial, educational and economic hubs. It has been the historic capital and cultural centre of the wider Punjab region, and is one of Pakistan's most socially liberal, progressive, and cosmopolitan cities. Lahore's origin dates back to antiquity. The city has been inhabited for around two millennia, although it rose to prominence in the late 10th century with the establishment of the Walled City, its fortified interior."}}, {"canonical_name": "Népal", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "népal", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Népal", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Népal"], "contexts": ["independent state"]}, {"entity_id": "nepaul", "book_id": "kosmos_humboldt_1845", "name": "Nepaul", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Nepaul"], "contexts": ["region in the Himalaya"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Népal", "target_book": "kosmos_humboldt_1845", "target_name": "Nepaul", "similarity": 0.853}], "id": 1882, "stable_key": "clu_16490be483d55331", "ground_truth": {"modern_name": "Nepal", "confidence": "high", "type": "place", "country": "Nepal", "wikipedia_extract": "Kathmandu (Nepali: [ˈkaʈʰmaɳɖu]) is the capital and largest city of Nepal, situated in the central part of the country within the Kathmandu Valley. As per the 2021 Nepal census, it has a population of 845,767 residing in 105,649 households, with approximately 4 million people in the surrounding metropolitan area. The city stands at an elevation of 1,324 metres (4,344 ft) above sea level. Recognized as one of the oldest continuously inhabited places in the world, Kathmandu's history dates back to the 2nd century AD. Historically known as the Nepal Mandala, the valley has been the cultural and political hub for the Newar people, a significant urban civilization in the Himalayan region. Kathmandu served as the royal capital of the Kingdom of Nepal and is home to numerous palaces, temples, and gardens reflecting its rich heritage.", "wikipedia_url": "https://en.wikipedia.org/wiki/Kathmandu"}}, {"canonical_name": "Jakutsk", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "jakutsk", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Jakutsk", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Jakutsk"], "contexts": ["city in Siberia"]}, {"entity_id": "jakutsk", "book_id": "kosmos_humboldt_1845", "name": "Jakutsk", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Jakutsk"], "contexts": ["city in northern Asia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Jakutsk", "target_book": "kosmos_humboldt_1845", "target_name": "Jakutsk", "similarity": 1.0}], "id": 1883, "stable_key": "clu_9737188088ba1c7f", "ground_truth": {"modern_name": "Yakutsk", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q6610", "wikidata_description": "city in eastern Russia, capital of the Republic of Sakha (Yakutia)", "wikipedia_extract": "Yakutsk is the capital and largest city of Sakha, Russia, located about 450 km (280 mi) south of the Arctic Circle. Fueled by the mining industry, Yakutsk has become one of Russia's most rapidly growing regional cities, with a population of 355,443 at the 2021 census. Yakutsk has an average annual temperature of −8.0 °C (17.6 °F), winter high temperatures consistently well below −20 °C (−4 °F), and a record low of −64.4 °C (−83.9 °F) has been recorded. As a result, Yakutsk is the coldest major city in the world (although a number of smaller towns in that region are slightly colder). Yakutsk is also the largest city located in continuous permafrost; the only other large city is Norilsk, also in Siberia. Yakutsk is in the Central Yakutian Lowland and is a major port on the Lena River.", "wikipedia_url": "https://en.wikipedia.org/wiki/Yakutsk"}}, {"canonical_name": "Corée", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "corée", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Corée", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Corée"], "contexts": ["country excluded from Tartary"]}, {"entity_id": "korea", "book_id": "kosmos_humboldt_1845", "name": "Korea", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Korea"], "contexts": ["northern part of the country"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Corée", "target_book": "kosmos_humboldt_1845", "target_name": "Korea", "similarity": 0.958}], "id": 1884, "stable_key": "clu_d4b204e7ad8b1208", "ground_truth": {"modern_name": "Korea", "confidence": "high", "type": "place", "country": "South Korea, North Korea", "wikipedia_extract": "The history of North Korea began with the end of World War II in 1945. The surrender of Japan led to the division of Korea at the 38th parallel, with the Soviet Union occupying the north, and the United States occupying the south. The Soviet Union and the United States failed to agree on a way to unify the country, and in 1948, they established two separate governments — the Soviet-aligned Democratic People's Republic of Korea and the American-aligned Republic of Korea — each claiming to be the legitimate government of all of Korea. In 1950, the Korean War broke out. After much destruction, the war ended with a stalemate. The division at the 38th parallel was replaced by the Korean Demilitarized Zone.", "wikipedia_url": "https://en.wikipedia.org/wiki/History_of_North_Korea"}}, {"canonical_name": "Rio Gaura", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "rio_gaura", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rio Gaura", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Rio Gaura"], "contexts": ["river"]}, {"entity_id": "river_gaira", "book_id": "kosmos_humboldt_1845", "name": "River Gaira", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["River Gaira"], "contexts": ["river originating from a mountain"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rio Gaura", "target_book": "kosmos_humboldt_1845", "target_name": "River Gaira", "similarity": 0.851}], "id": 1885, "stable_key": "clu_5fca7a703de445f3", "ground_truth": {"modern_name": "Gaura River", "confidence": "medium", "type": "place", "country": "Unknown", "note": "The exact location of 'Rio Gaura' or 'River Gaira' is difficult to pinpoint without further context. It may refer to a local or historical name.", "wikidata_id": "Q5527739", "wikidata_description": "river in Romania", "wikipedia_url": "https://en.wikipedia.org/wiki/Gaura_River"}}, {"canonical_name": "archipel des Chonos", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "archipel_des_chonos", "book_id": "relation_historique_humboldt_vol3_1825", "name": "archipel des Chonos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["archipel des Chonos"], "contexts": ["archipelago of sunken mountains"]}, {"entity_id": "archipelago_'de_los_chonos'", "book_id": "kosmos_humboldt_1845", "name": "Archipelago 'de los Chonos'", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Archipelago 'de los Chonos'"], "contexts": ["South American archipelago"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "archipel des Chonos", "target_book": "kosmos_humboldt_1845", "target_name": "Archipelago 'de los Chonos'", "similarity": 0.932}], "id": 1886, "stable_key": "clu_4a443fa12d5750ef", "ground_truth": {"modern_name": "Chonos Archipelago", "confidence": "high", "type": "place", "country": "Chile", "wikidata_id": "Q1076210", "wikidata_description": "island group in Chile", "wikipedia_url": "https://en.wikipedia.org/wiki/Chonos%20Archipelago"}}, {"canonical_name": "Hambato", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "hambato", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Hambato", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Hambato"], "contexts": ["river basin"]}, {"entity_id": "hambato", "book_id": "kosmos_humboldt_1845", "name": "Hambato", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Hambato"], "contexts": ["city nearer to earthquake center"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hambato", "target_book": "kosmos_humboldt_1845", "target_name": "Hambato", "similarity": 0.858}], "id": 1887, "stable_key": "clu_d0f5520e735de1f2", "ground_truth": {"modern_name": "Ambato", "confidence": "high", "type": "place", "country": "Ecuador", "wikidata_id": "Q210161", "wikidata_description": "city in Ecuador, capital of the Tungurahua Province", "wikipedia_url": "https://en.wikipedia.org/wiki/Ambato%2C_Ecuador", "wikipedia_extract": "Ambato (Spanish pronunciation: [amˈbato]; full form, San Juan de Ambato; Quechua: Ampatu Llaqta) is a city located in the central Andean valley of Ecuador. Lying on the banks of the Ambato River, the city also sits beneath several tall mountains. It is the capital city of the Tungurahua Province, situated at an elevation of 2,577 meters above sea level. It is variously nicknamed \"City of Flowers and Fruits\", \"Land of the Three Juans\", and \"Garden of Ecuador.\" Ambato's inhabitants are called Ambateños or Guaytambos (after a type of native peach that the valley is famous for producing). The current mayor of Ambato is Diana Caiza. The city has been fully or partially destroyed by earthquakes several times in its history, most recently on August 5, 1949, when the city and its cathedral were almost completely devastated."}}, {"canonical_name": "Chillo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "chillo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Chillo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Chillo"], "contexts": ["valley location"]}, {"entity_id": "chillo", "book_id": "kosmos_humboldt_1845", "name": "Chillo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Chillo"], "contexts": ["near Quito"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Chillo", "target_book": "kosmos_humboldt_1845", "target_name": "Chillo", "similarity": 1.0}], "id": 1888, "stable_key": "clu_de4c3bf7679749b2", "ground_truth": {"modern_name": "Chillo Valley", "confidence": "high", "type": "place", "country": "Ecuador", "wikipedia_extract": "AEK Basketball Club (Greek: ΚΑΕ ΑΕΚ Greek pronunciation: [ˈaek]; Αθλητική Ένωσις Κωνσταντινουπόλεως Athlitikí Énosis Konstantinoupóleos, \"Athletic Union of Constantinople\"), and also known as AEK B.C. or simply AEK, and more commonly known in European competitions as AEK Athens, is a Greek professional basketball club based in Athens, Attica, Greece, part of the major multi-sport club AEK. The club was established in Athens in 1924 by Greek refugees from Constantinople in the wake of the Greco-Turkish War (1919–1922). AEK B.C. is considered by as one of the three best Greek clubs in basketball and Greek sports club, as it maintains more than 30 sports' departments. AEK was the first-ever Greek basketball team, not only to reach a European Cup Final, but also to win a European title.", "wikipedia_url": "https://en.wikipedia.org/wiki/AEK_B.C."}}, {"canonical_name": "llermanos", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "llermanos", "book_id": "relation_historique_humboldt_vol3_1825", "name": "llermanos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["llermanos"], "contexts": ["islets forming a chain"]}, {"entity_id": "llanoses", "book_id": "kosmos_humboldt_1845", "name": "llanoses", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["llanoses"], "contexts": ["tropical grasslands in South America"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "llermanos", "target_book": "kosmos_humboldt_1845", "target_name": "llanoses", "similarity": 0.865}], "id": 1889, "stable_key": "clu_08ea6f182e554177", "ground_truth": {"modern_name": "Llanos", "confidence": "high", "type": "place", "country": "Venezuela, Colombia", "note": "The original text has 'llermanos' which is likely a typo for 'Llanos' given the context of tropical grasslands in South America and the variant spelling 'llanoses'.", "wikidata_id": "Q37507553", "wikidata_description": "family name"}}, {"canonical_name": "Blanquilla", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "blanquilla", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Blanquilla", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Blanquilla"], "contexts": ["island forming a chain"]}, {"entity_id": "blansko", "book_id": "kosmos_humboldt_1845", "name": "Blansko", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Blansko"], "contexts": ["location of meteoric masses"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Blanquilla", "target_book": "kosmos_humboldt_1845", "target_name": "Blansko", "similarity": 0.842}], "id": 1890, "stable_key": "clu_ae13fd2edee217a8", "ground_truth": {"modern_name": "La Blanquilla", "confidence": "medium", "type": "place", "country": "Venezuela", "note": "The spelling 'Blansko' in the second mention is likely an OCR error or a misspelling of 'Blanquilla'."}}, {"canonical_name": "orographie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "orographie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "orographie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["orographie"], "contexts": ["study of mountains"]}, {"entity_id": "orography", "book_id": "kosmos_humboldt_1845", "name": "orography", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["orography"], "contexts": ["study of mountain ranges"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "orographie", "target_book": "kosmos_humboldt_1845", "target_name": "orography", "similarity": 0.982}], "id": 1891, "stable_key": "clu_90d046f5ab8b068f", "ground_truth": {"modern_name": "Orography", "confidence": "high", "type": "concept", "wikidata_id": "Q129292457", "wikidata_description": "scholarly article", "wikipedia_extract": "Jabal Hafeet (Arabic: جَبَل حَفِيْت, romanized: Jabal Ḥafīt, \"Mount Hafeet\"; variously transcribed Jabel or Jebal and Hafit – literally \"empty mountain\") is a mountain in the region of Tawam, on the border of the United Arab Emirates and Oman. It is often considered an outlier of the Hajar Mountains in Eastern Arabia due to its proximity to the main range. To the north is the UAE city of Al Ain, in the Eastern Region of the Emirate of Abu Dhabi, and the adjacent Omani town of Al-Buraimi. The sole mountain in the Emirate of Abu Dhabi, and one of the highest mountains in the country, it has given its name to a period in UAE history, the Hafit Period of the Bronze Age (3200 to 2600 BCE), because of the discovery of a cluster of important beehive tombs at its foothills. As of 2017, the mountain is recognised as being part of a national park, and was incorporated into the Sheikh Zayed Network of Protected Areas in 2018. Jebel Hafeet has a hot desert climate (BWh) according to the Köppen climate classification.", "wikipedia_url": "https://en.wikipedia.org/wiki/Jebel_Hafeet"}}, {"canonical_name": "Saint- Paul", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "saint-_paul", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Saint- Paul", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Saint- Paul"], "contexts": ["city"]}, {"entity_id": "st__paul", "book_id": "kosmos_humboldt_1845", "name": "St. Paul", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["St. Paul"], "contexts": ["city in diamond district"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saint- Paul", "target_book": "kosmos_humboldt_1845", "target_name": "St. Paul", "similarity": 0.96}], "id": 1892, "stable_key": "clu_ac6d67d9fcc6db87", "ground_truth": {"modern_name": "Saint-Paul", "confidence": "high", "type": "place", "country": "France", "note": "Given the context of diamonds, this likely refers to Saint-Paul, a commune in the Nord department of France, known for its historical industrial importance, rather than other places named Saint-Paul.", "wikipedia_extract": "Saint Paul (often abbreviated to St. Paul) is the capital city of the U.S. state of Minnesota and the county seat of Ramsey County. As of the 2020 census, the city had a population of 311,527, making it Minnesota's second-most populous city and the 63rd-most populous in the United States. Saint Paul and neighboring Minneapolis form the core of the Twin Cities metropolitan area, the third most populous in the Midwest with around 3.7 million residents. The Minnesota State Capitol and the state government offices sit on a hill next to downtown Saint Paul overlooking a bend in the Mississippi River.", "wikipedia_url": "https://en.wikipedia.org/wiki/Saint_Paul,_Minnesota"}}, {"canonical_name": "stalactites", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "stalactites", "book_id": "relation_historique_humboldt_vol3_1825", "name": "stalactites", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["stalactites"], "contexts": ["mineral formation"]}, {"entity_id": "slate", "book_id": "kosmos_humboldt_1845", "name": "slate", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["slate"], "contexts": ["sedimentary rock type"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "stalactites", "target_book": "kosmos_humboldt_1845", "target_name": "slate", "similarity": 0.842}], "id": 1893, "stable_key": "clu_a51bd4290ae09093", "ground_truth": {"modern_name": "Stalactites and Slate", "confidence": "low", "type": "mineral", "note": "The cluster presents two distinct mineral types ('stalactites' and 'slate') with potentially different origins. The identification of 'Blansko' for 'Blanquilla' in cluster 1890 also suggests potential OCR issues, making a definitive single referent difficult here.", "wikidata_id": "Q177197", "wikidata_description": "elongated mineral formation which hangs down from a cave ceiling", "wikipedia_url": "https://en.wikipedia.org/wiki/Stalactite"}}, {"canonical_name": "Allemagne septentrionale", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "allemagne_septentrionale", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Allemagne septentrionale", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Allemagne septentrionale"], "contexts": ["northern Germany"]}, {"entity_id": "southern_germany", "book_id": "kosmos_humboldt_1845", "name": "Southern Germany", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Southern Germany"], "contexts": ["geographic location"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Allemagne septentrionale", "target_book": "kosmos_humboldt_1845", "target_name": "Southern Germany", "similarity": 0.909}], "id": 1894, "stable_key": "clu_b7e5d0113531790c", "ground_truth": {"modern_name": "Northern Germany", "confidence": "high", "type": "place", "country": "Germany", "wikidata_id": "Q46613", "wikidata_description": "geographic region", "wikipedia_url": "https://en.wikipedia.org/wiki/Northern_Germany", "wikipedia_extract": "Northern Germany (German: Norddeutschland, [ˈnɔʁtdɔɪ̯tʃlant] ) is a linguistic, geographic, socio-cultural and historic region in the northern part of Germany which includes the coastal states of Schleswig-Holstein, Mecklenburg-Vorpommern and Lower Saxony and the two city-states Hamburg and Bremen. It contrasts with Southern Germany, Western Germany, and Eastern Germany. Northern Germany generally refers to the Sprachraum area north of the Uerdingen and Benrath line isoglosses, where Low German dialects are spoken. These comprise the Low Saxon dialects in the west (including the Westphalian language area up to the Rhineland), the East Low German region along the Baltic coast with Western Pomerania, the Altmark and northern Brandenburg, as well as the North Low German dialects. Although from the 19th century onwards, the use of Standard German was strongly promoted especially by the Prussian administration, Low German dialects are still present in rural areas, with an estimated number of five to eight million active speakers. However, since World War II and the immigration of expellees from the former eastern territories of Germany, its prevalence has steadily reduced."}}, {"canonical_name": "meulières poreuses", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "meulières_poreuses", "book_id": "relation_historique_humboldt_vol3_1825", "name": "meulières poreuses", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["meulières poreuses"], "contexts": ["porous millstone"]}, {"entity_id": "porous_bodies", "book_id": "kosmos_humboldt_1845", "name": "porous bodies", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["porous bodies"], "contexts": ["objects causing condensation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "meulières poreuses", "target_book": "kosmos_humboldt_1845", "target_name": "porous bodies", "similarity": 0.919}], "id": 1895, "stable_key": "clu_91032b51293854de", "ground_truth": {"modern_name": "Porous millstone", "confidence": "high", "type": "object", "wikidata_id": "Q37526567", "wikidata_description": "family name"}}, {"canonical_name": "mésotype", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mésotype", "book_id": "relation_historique_humboldt_vol3_1825", "name": "mésotype", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["mésotype"], "contexts": ["mineral found in rocks"]}, {"entity_id": "mesotype", "book_id": "kosmos_humboldt_1845", "name": "Mesotype", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Mesotype"], "contexts": ["mineral component of basalt"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mésotype", "target_book": "kosmos_humboldt_1845", "target_name": "Mesotype", "similarity": 0.912}], "id": 1896, "stable_key": "clu_950f00ee83c220d5", "ground_truth": {"modern_name": "Mesotype", "confidence": "high", "type": "mineral", "wikidata_id": "Q6821653", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Mesotype", "wikipedia_extract": "Mesotype is a genus of moths in the family Geometridae erected by Jacob Hübner in 1825. It is sometimes included in Perizoma. Mesotype didymata (Linnaeus, 1758) – twin-spot carpet Mesotype parallelolineata (Retzius, 1783) Pitkin, Brian & Jenkins, Paul. \"Search results Family: Geometridae\". Butterflies and Moths of the World. Natural History Museum, London."}}, {"canonical_name": "Bayreuth", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bayreuth", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bayreuth", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bayreuth"], "contexts": ["temperate climate city for experiments"]}, {"entity_id": "baireuth", "book_id": "kosmos_humboldt_1845", "name": "Baireuth", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Baireuth"], "contexts": ["city in Bavaria"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bayreuth", "target_book": "kosmos_humboldt_1845", "target_name": "Baireuth", "similarity": 0.917}], "id": 1897, "stable_key": "clu_6e3cff4419e4f282", "ground_truth": {"modern_name": "Bayreuth", "confidence": "high", "type": "place", "country": "Germany"}}, {"canonical_name": "Colonnes d'Hercule", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "colonnes_d'hercule", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Colonnes d'Hercule", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Colonnes d'Hercule"], "contexts": ["historical geographical marker"]}, {"entity_id": "pillars_of_hercules", "book_id": "kosmos_humboldt_1845", "name": "Pillars of Hercules", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Pillars of Hercules"], "contexts": ["ancient geographical landmark"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Colonnes d'Hercule", "target_book": "kosmos_humboldt_1845", "target_name": "Pillars of Hercules", "similarity": 0.863}], "id": 1898, "stable_key": "clu_db375dc81f0e01de", "ground_truth": {"modern_name": "Pillars of Hercules", "confidence": "high", "type": "place", "country": "Spain", "wikidata_id": "Q152854", "wikidata_description": "promontories that flank the entrance to the Strait of Gibraltar", "wikipedia_extract": "The Pillars of Hercules are the promontories that flank the entrance to the Strait of Gibraltar. The northern Pillar, Calpe Mons, is the Rock of Gibraltar. A corresponding North African peak not being predominant, the identity of the southern Pillar, Abila Mons, has been disputed throughout history, with the two most likely candidates being Monte Hacho in Ceuta and Jebel Musa in Morocco. The term was applied in antiquity: Pliny the Elder included the Pillars of Hercules in his Naturalis historia (Book III:3). According to Greek mythology adopted by the Etruscans and Romans, when Hercules had to perform twelve labours, one of them (the tenth) was to fetch the Cattle of Geryon of the far West and bring them to Eurystheus; this marked the westward extent of his travels. A lost passage of Pindar quoted by Strabo was the earliest traceable reference in this context: \"the pillars which Pindar calls the 'gates of Gades' when he asserts that they are the farthermost limits reached by Heracles\".", "wikipedia_url": "https://en.wikipedia.org/wiki/Pillars_of_Hercules"}}, {"canonical_name": "liignouia lepidota", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "liignouia_lepidota", "book_id": "relation_historique_humboldt_vol3_1825", "name": "liignouia lepidota", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["liignouia lepidota"], "contexts": ["plant found at the foot of hills"]}, {"entity_id": "lepidodendra", "book_id": "kosmos_humboldt_1845", "name": "Lepidodendra", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Lepidodendra"], "contexts": ["plant genus in ancient coal measures"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "liignouia lepidota", "target_book": "kosmos_humboldt_1845", "target_name": "Lepidodendra", "similarity": 0.854}], "id": 1899, "stable_key": "clu_0b1c2d75570602cc", "ground_truth": {"modern_name": "Lepidodendra", "confidence": "medium", "type": "plant", "note": "Lepidodendra is a genus of extinct plants, likely referring to seed ferns or related groups."}}, {"canonical_name": "floraison", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "floraison", "book_id": "relation_historique_humboldt_vol3_1825", "name": "floraison", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["floraison"], "contexts": ["flowering of a plant"]}, {"entity_id": "flowering_of_plants", "book_id": "kosmos_humboldt_1845", "name": "flowering of plants", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["flowering of plants"], "contexts": ["botanical event"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "floraison", "target_book": "kosmos_humboldt_1845", "target_name": "flowering of plants", "similarity": 0.874}], "id": 1900, "stable_key": "clu_b2a0eb3557dd4129", "ground_truth": {"modern_name": "Flowering", "confidence": "high", "type": "concept", "wikidata_id": "Q15385530", "wikidata_description": "species of plant", "wikipedia_extract": "Roses FC (also known as the Montreal Roses; French: Roses de Montréal) is a professional women's soccer club based in Montreal, Quebec, that competes in the Northern Super League, in the top flight of the Canadian soccer league system. One of two professional soccer clubs in the province of Quebec alongside CF Montréal, it is owned by Isabèle Chevalier and Jean-François Crevier, led by Annie Larouche, and managed by Marinette Pichon. The club is symbolized by a blue rose, and its colours are black, blue, gold, red, and white. Roses FC was founded in July 2023 by Chevalier and Crevier, who both sought involvement in the Northern Super League after its formation the previous year. It was one of the last two charter members of the league, alongside the Ottawa Rapid. In lieu of a tenancy deal with a venue in Montreal, the club will play its home games at various venues.", "wikipedia_url": "https://en.wikipedia.org/wiki/Montreal_Roses_FC"}}, {"canonical_name": "Isabelle", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "isabelle", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Isabelle", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Isabelle"], "contexts": ["queen addressed by Columbus"]}, {"entity_id": "queen_isabella", "book_id": "kosmos_humboldt_1845", "name": "Queen Isabella", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Queen Isabella"], "contexts": ["recipient of Columbus's letter"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Isabelle", "target_book": "kosmos_humboldt_1845", "target_name": "Queen Isabella", "similarity": 0.951}], "id": 1901, "stable_key": "clu_2f713c7980a05454", "ground_truth": {"modern_name": "Isabella I of Castile", "confidence": "high", "type": "person", "birth_year": 1451, "death_year": 1504, "description": "Queen of Castile, patron of Columbus's voyages.", "wikidata_id": "Q45859", "wikidata_description": "queen of the Crown of Castile, from 1474 to 1504; first queen of a dynastically-united Spain, from 1479 to 1504 (1451–1504)", "wikipedia_url": "https://en.wikipedia.org/wiki/Isabella_I_of_Castile", "wikipedia_extract": "Isabella I (Spanish: Isabel I; also known as Isabella the Catholic Spanish: Isabel la Católica; 22 April 1451 – 26 November 1504) was Queen of Castile and León from 1474 until her death in 1504. She was also Queen of Aragon from 1479 until her death as the wife of King Ferdinand II. Reigning together over a dynastically unified Spain, Isabella and Ferdinand are known as the Catholic Monarchs. Her reign marked the end of the Reconquista and also the start of the Spanish Empire, allowing Spain to dominate European politics for the next century. Isabella's marriage to Ferdinand of Aragon in 1469 created the basis of the de facto unification of Spain. With Ferdinand's help, she won the War of the Castilian Succession, securing her position as Queen of Castile."}}, {"canonical_name": "Caliaode Lima", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "caliaode_lima", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Caliaode Lima", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Caliaode Lima"], "contexts": ["part of a voyage route"]}, {"entity_id": "callao_de_lima", "book_id": "kosmos_humboldt_1845", "name": "Callao de Lima", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Callao de Lima"], "contexts": ["harbor in Peru"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Caliaode Lima", "target_book": "kosmos_humboldt_1845", "target_name": "Callao de Lima", "similarity": 0.908}], "id": 1902, "stable_key": "clu_875a88d9658b3362", "ground_truth": {"modern_name": "Callao", "confidence": "high", "type": "place", "country": "Peru", "wikidata_id": "Q105037", "wikidata_description": "city ​​and main seaport of Peru", "wikipedia_url": "https://en.wikipedia.org/wiki/Callao", "wikipedia_extract": "Callao (Spanish pronunciation: [kaˈʝa.o]) is a seaside city and constitutional province in Peru. Located next to the Pacific Ocean, it forms part of the Lima metropolitan area alongside Lima province. Its autonomous status dates back to 1836, when it was declared a Littoral Province of the Peru–Bolivian Confederation, after which it was declared a Constitutional Province by the government of Ramón Castilla in 1857. Callao is Peru's chief seaport and home to its main airport, Jorge Chávez International Airport. Founded in 1537 by the Spaniards, the city has a long naval history as one of the main ports in Spanish America and the Pacific, having been a vital Spanish town of the Viceroyalty of Peru. Central Callao is about 15 km (9.3 mi) west of the Historic Centre of Lima."}}, {"canonical_name": "Rhizophora Mangle", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "rhizophora_mangle", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rhizophora Mangle", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Rhizophora Mangle"], "contexts": ["scientific name for a plant"]}, {"entity_id": "rhizophora_mangle", "book_id": "kosmos_humboldt_1845", "name": "Rhizophora mangle", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Rhizophora mangle"], "contexts": ["low bushes found on coasts"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rhizophora Mangle", "target_book": "kosmos_humboldt_1845", "target_name": "Rhizophora mangle", "similarity": 0.857}], "id": 1903, "stable_key": "clu_0b6633efbf6fd12c", "ground_truth": {"modern_name": "Red Mangrove", "confidence": "high", "type": "plant", "linnaean": "Rhizophora mangle Linnaeus", "family": "Rhizophoraceae", "wikidata_id": "Q853914", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Rhizophora_mangle", "wikipedia_extract": "Rhizophora mangle, also known as the red mangrove, is a salt-tolerant, small-to-medium sized evergreen tree restricted to coastal, estuarine ecosystems along the southern portions of North America, the Caribbean as well as Central America and tropical West Africa. Its viviparous \"seeds\", in actuality called propagules, become fully mature plants before dropping off the parent tree. These are dispersed by water until eventually embedding in the shallows. Rhizophora mangle grows on aerial prop roots, which arch above the water level, giving stands of this tree the characteristic \"mangrove\" appearance. It is a valuable plant in Florida, Louisiana, and Texas coastal ecosystems. The name refers to the red colour on the inner part of its roots when halved, so it does not display any red colour in its regular appearance."}}, {"canonical_name": "Rio Belen", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "rio_belen", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rio Belen", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Rio Belen"], "contexts": ["river where Feragua was founded"]}, {"entity_id": "river_belem", "book_id": "kosmos_humboldt_1845", "name": "River Belem", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["River Belem"], "contexts": ["location near where Columbus lay sick"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rio Belen", "target_book": "kosmos_humboldt_1845", "target_name": "River Belem", "similarity": 0.841}], "id": 1904, "stable_key": "clu_30649cf2602de55c", "ground_truth": {"modern_name": "Belén River", "confidence": "high", "type": "place", "country": "Panama", "wikidata_id": "Q4884974", "wikidata_description": "river in Panama", "wikipedia_url": "https://en.wikipedia.org/wiki/Bel%C3%A9n%20River"}}, {"canonical_name": "P. speciosa", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "p__speciosa", "book_id": "relation_historique_humboldt_vol3_1825", "name": "P. speciosa", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["P. speciosa"], "contexts": ["plant species Cluipo"]}, {"entity_id": "s__speciosa", "book_id": "kosmos_humboldt_1845", "name": "S. speciosa", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["S. speciosa"], "contexts": ["flowering plant near snow line"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "P. speciosa", "target_book": "kosmos_humboldt_1845", "target_name": "S. speciosa", "similarity": 0.929}], "id": 1905, "stable_key": "clu_fc6941ace3ffc0e0", "ground_truth": {"modern_name": "Species Plantarum", "confidence": "medium", "type": "text", "note": "The 'P.' and 'S.' likely refer to abbreviations of a genus, and 'speciosa' is an epithet. Without more context or a known work by Humboldt where he uses such abbreviations, identifying a specific plant is difficult. 'Species Plantarum' is a likely candidate for 'P. speciosa' due to its significance in botany and the abbreviation 'P.' sometimes used for binomial nomenclature.", "wikidata_id": "Q21856070", "wikidata_description": "Second edition of Linnaeus' Species Plantarum", "wikipedia_extract": "Parkia speciosa, the bitter bean, twisted cluster bean, sator bean, stink bean, or petai is a plant of the genus Parkia in the family Fabaceae. It bears long, flat edible beans with bright green seeds the size and shape of plump almonds which have a rather peculiar smell, similar to, but stronger than that of the shiitake mushroom, due to sulfur-containing compounds also found in shiitake, truffles and cabbage. The petai tree can grow to about 30 metres. It bears flowers in a light bulb-shaped mass at the end of long stalks. The flowers secrete a nectar that attracts bats and other pollinators. The fruits emerge as long, twisted, translucent pods in a cluster of seven or eight pods.", "wikipedia_url": "https://en.wikipedia.org/wiki/Parkia_speciosa"}}, {"canonical_name": "solfatares", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "solfatares", "book_id": "relation_historique_humboldt_vol3_1825", "name": "solfatares", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["solfatares"], "contexts": ["volcanic vents emitting sulfurous gases"]}, {"entity_id": "solfataras", "book_id": "kosmos_humboldt_1845", "name": "solfataras", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["solfataras"], "contexts": ["volcanic vents emitting gases"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "solfatares", "target_book": "kosmos_humboldt_1845", "target_name": "solfataras", "similarity": 0.968}], "id": 1906, "stable_key": "clu_55191d98e16954ce", "ground_truth": {"modern_name": "solfatara", "confidence": "high", "type": "place", "country": "Italy", "note": "Solfataras are specific geological formations, but the term can also refer to the general phenomenon of volcanic vents emitting sulfurous gases.", "wikipedia_extract": "Pozzuoli (Italian: [potˈtswɔːli]; Neapolitan: Pozzule [pətˈtsuːlə]; Latin: Puteoli) is a city and comune (municipality) of the Metropolitan City of Naples, in the Italian region of Campania. It is the main city of the Phlegrean Peninsula. Pozzuoli began as the Greek colony of Dicaearchia (Greek: Δικαιαρχία) founded in about 531 BC in Magna Graecia with the consent of nearby Cumae when refugees from Samos escaped from the tyranny of Polycrates. The Samnites occupied Dicaearchia in 421 BC after conquering Cumae and may have changed its name to Fistelia. It enjoyed considerable political and commercial autonomy favoured by the excellent position of its port with the Campanian hinterland. The Roman occupation of Campania after the end of the 1st Samnite War from 341 BC marked the start of the Romanisation of the Greek-Samnite city.", "wikipedia_url": "https://en.wikipedia.org/wiki/Pozzuoli"}}, {"canonical_name": "Gokmali", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "gokmali", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Gokmali", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Gokmali"], "contexts": ["location of an igneous eruption"]}, {"entity_id": "jokmali", "book_id": "kosmos_humboldt_1845", "name": "Jokmali", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Jokmali"], "contexts": ["location of a mud volcano"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Gokmali", "target_book": "kosmos_humboldt_1845", "target_name": "Jokmali", "similarity": 0.868}], "id": 1907, "stable_key": "clu_c173b243adb10b02", "ground_truth": {"modern_name": "Gokmali", "confidence": "low", "type": "place", "country": "Unknown", "note": "The location 'Gokmali' or 'Jokmali' is not readily identifiable in historical or modern geographic records. It may be a transcription error or a very obscure location. Given its association with volcanic activity, it might be a specific volcanic feature."}}, {"canonical_name": "attraction universelle", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "attraction_universelle", "book_id": "relation_historique_humboldt_vol3_1825", "name": "attraction universelle", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["attraction universelle"], "contexts": ["Newton's theory of gravity"]}, {"entity_id": "laws_of_attraction", "book_id": "kosmos_humboldt_1845", "name": "laws of attraction", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["laws of attraction"], "contexts": ["fundamental force governing celestial bodies"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "attraction universelle", "target_book": "kosmos_humboldt_1845", "target_name": "laws of attraction", "similarity": 0.863}], "id": 1908, "stable_key": "clu_4ab1189160db9c60", "ground_truth": {"modern_name": "Universal Gravitation", "confidence": "high", "type": "concept", "wikipedia_extract": "The gravity of Earth, denoted by g, is the net acceleration that is imparted to objects due to the combined effect of gravitation (from mass distribution within Earth) and the centrifugal force (from the Earth's rotation). It is a vector quantity, whose direction coincides with a plumb bob and strength or magnitude is given by the norm {\\displaystyle g=\\|{\\mathit {\\mathbf {g} }}\\|} In SI units, this acceleration is expressed in metres per second squared (in symbols, m/s2 or m·s−2) or equivalently in newtons per kilogram (N/kg or N·kg−1). Near Earth's surface, the acceleration due to gravity, accurate to 2 significant figures, is 9.8 m/s2 (32 ft/s2). This means that, ignoring the effects of air resistance, the vertical component of velocity of an object falling freely will increase in the downwards direction by about 9.8 metres per second (32 ft/s) every second. The precise strength of Earth's gravity varies with location. The conventional value for standard gravity is 9.80665 m⋅s−2‍ by definition, originally adopted by the CGPM in 1901.", "wikipedia_url": "https://en.wikipedia.org/wiki/Gravity_of_Earth"}}, {"canonical_name": "steppe des Kirghises", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "steppe_des_kirghises", "book_id": "relation_historique_humboldt_vol3_1825", "name": "steppe des Kirghises", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["steppe des Kirghises"], "contexts": ["steppe visited for observations"]}, {"entity_id": "kirghis_steppes", "book_id": "kosmos_humboldt_1845", "name": "Kirghis Steppes", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Kirghis Steppes"], "contexts": ["steppe inhabited by Kirghis"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "steppe des Kirghises", "target_book": "kosmos_humboldt_1845", "target_name": "Kirghis Steppes", "similarity": 0.927}], "id": 1909, "stable_key": "clu_a303765edcf7e2a8", "ground_truth": {"modern_name": "Kazakh Steppe", "confidence": "high", "type": "place", "country": "Kazakhstan", "note": "The term 'steppe des Kirghises' directly translates to 'Steppe of the Kirghiz,' which is historically and geographically synonymous with the vast Kazakh Steppe.", "wikidata_id": "Q602925", "wikidata_description": "Ecoregion of grasslands that encompass most of the eastern segment of the Eurasian steppe", "wikipedia_extract": "The Kazakh Steppe (Kazakh: Қазақ даласы, romanized: Qazaq dalasy [qɑˈzɑq dɑɫɑˈsə]), also known as the Great Steppe or Great Dala (Kazakh: Ұлы дала, romanized: Ūly dala [ʊˈɫɤ dɑˈɫɑ]), is a vast region of open grassland in Central Asia, covering areas in northern Kazakhstan and adjacent areas of Russia. It lies east of the Pontic–Caspian steppe and west of the Emin Valley steppe, with which it forms the central and western part of the Eurasian steppe. The Kazakh Steppe is an ecoregion of the temperate grasslands, savannas, and shrublands biome in the Palearctic realm. Before the mid-19th century, it was called the Kirghiz steppe, 'Kirghiz' being an old Russian word for the Kazakhs. The steppe extends more than 2,200 km (1,400 mi) from the east of the Caspian Depression and north of the Aral Sea, all the way to the Altai Mountains. It is the largest dry steppe region on earth, covering approximately 804,450 km2 (310,600 sq mi).", "wikipedia_url": "https://en.wikipedia.org/wiki/Kazakh_Steppe"}}, {"canonical_name": "courbe sans Inclinaison", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "courbe_sans_inclinaison", "book_id": "relation_historique_humboldt_vol3_1825", "name": "courbe sans Inclinaison", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["courbe sans Inclinaison"], "contexts": ["curve of zero magnetic inclination"]}, {"entity_id": "lines_without_declination", "book_id": "kosmos_humboldt_1845", "name": "lines without declination", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["lines without declination"], "contexts": ["lines of no magnetic declination"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "courbe sans Inclinaison", "target_book": "kosmos_humboldt_1845", "target_name": "lines without declination", "similarity": 0.849}], "id": 1910, "stable_key": "clu_7aed275cf576bb9e", "ground_truth": {"modern_name": "Magnetic isoclinic line", "confidence": "high", "type": "concept", "note": "The concept refers to lines connecting points of equal magnetic inclination. 'Courbe sans Inclinaison' directly translates to 'curve without inclination', and 'lines without declination' is a related concept in geomagnetism, though inclination and declination are distinct magnetic parameters. Given the context of Humboldt, it's likely referring to the isoclinic line.", "wikipedia_extract": "William Whiston (9 December 1667 – 22 August 1752) was an English theologian, historian, natural philosopher, and mathematician, a leading figure in the popularisation of the ideas of Isaac Newton. He is now probably best known for helping to instigate the Longitude Act in 1714 (and his attempts to win the rewards that it promised) and his important translations of the Antiquities of the Jews and other works by Josephus (which are still in print). He was a prominent exponent of Arianism and wrote A New Theory of the Earth. Whiston succeeded his mentor Newton as Lucasian Professor of Mathematics at the University of Cambridge. In 1710 he lost the professorship and was expelled from the university as a result of his unorthodox religious views. Whiston rejected the notion of eternal torment in hellfire, which he viewed as absurd, cruel, and an insult to God.", "wikipedia_url": "https://en.wikipedia.org/wiki/William_Whiston"}}, {"canonical_name": "Maadavaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "maadavaca", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Maadavaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Maadavaca"], "contexts": ["location with syenite near Cassiquiare"]}, {"entity_id": "madhjadeca", "book_id": "kosmos_humboldt_1845", "name": "Madhjadeca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Madhjadeca"], "contexts": ["region in ancient India"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Maadavaca", "target_book": "kosmos_humboldt_1845", "target_name": "Madhjadeca", "similarity": 0.898}], "id": 1911, "stable_key": "clu_b4aa50d34222b78d", "ground_truth": {"modern_name": "Mandya", "confidence": "low", "type": "place", "country": "India", "note": "The orthography and context are ambiguous. 'Maadavaca' and 'Madhjadeca' suggest a place name in India, possibly related to a historical kingdom or region. Mandya is a district in Karnataka, India, and the mention of 'syenite' could link to geological features present in that region, though the Cassiquiare River is in South America. This identification is speculative."}}, {"canonical_name": "Zurich", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "zurich", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Zurich", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Zurich"], "contexts": ["location of observation"]}, {"entity_id": "zurich", "book_id": "kosmos_humboldt_1845", "name": "Zurich", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Zurich"], "contexts": ["location for air strata data"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Zurich", "target_book": "kosmos_humboldt_1845", "target_name": "Zurich", "similarity": 1.0}], "id": 1912, "stable_key": "clu_1041e55061e90485", "ground_truth": {"modern_name": "Zurich", "confidence": "high", "type": "place", "country": "Switzerland", "wikidata_id": "Q72", "wikidata_description": "most populous city in Switzerland and capital of the canton of Zurich", "wikipedia_url": "https://en.wikipedia.org/wiki/Zurich", "wikipedia_extract": "Zurich (German: Zürich; Alemannic German: Züri; see below) is the largest city in Switzerland and the capital of the canton of Zurich. It is in north-central Switzerland, at the northwestern tip of Lake Zurich. As of the end of 2024, the municipality had a population of 436,551, while the urban area was home to 1.45 million people (2020), while the Zurich metropolitan area had a total population of 2.1 million (2020). Zurich is a hub for railways, roads, and air traffic. Both Zurich Airport and Zurich's main railway station are the largest and busiest in the country. Evidence of early, sparse settlements in the area dates back more than 6,400 years, indicating human presence prior to the establishment of the town."}}, {"canonical_name": "Pucheri", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pucheri", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pucheri", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Pucheri"], "contexts": ["plant species"]}, {"entity_id": "puerros", "book_id": "historia_medicinal_monardes_1574", "name": "puerros", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["puerros"], "contexts": ["plant used for sustenance"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pucheri", "target_book": "historia_medicinal_monardes_1574", "target_name": "puerros", "similarity": 0.875}], "id": 1913, "stable_key": "clu_ef5675930367788b", "ground_truth": {"modern_name": "Leek", "confidence": "high", "type": "plant", "linnaean": "Allium ampeloprasum var. porrum", "family": "Amaryllidaceae", "note": "Monardes' 'puerros' is a clear reference to leeks. While 'Pucheri' is less definitive, in the context of early modern botanical descriptions and the pairing with 'puerros', it is highly probable that both refer to leeks or a closely related allium species used for sustenance.", "wikidata_id": "Q835096", "wikidata_description": "former municipality in the province of Groningen, the Netherlands", "wikipedia_url": "https://en.wikipedia.org/wiki/Leek%2C_Netherlands", "wikipedia_extract": "Leek (Dutch: [leːk] ; Gronings: De Laik; West Frisian: De Like) is a village and former municipality in Groningen province in the northeastern Netherlands. The municipality, which bordered the Drenthe and Friesland provinces, was merged into the municipality of Westerkwartier on 1 January 2019. The village of Leek is approximately 20 km west of Groningen (city) on the A7 (E22) highway. The village grew around a fortification that was constructed during the Eighty Years' War with Spain. The name 'Leek' was derived from a brook, the \"Leke\". The town is sometimes also called \"De Leek\"."}}, {"canonical_name": "Chica", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "chica", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Chica", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Chica"], "contexts": ["coloring paste"]}, {"entity_id": "chicoria", "book_id": "historia_medicinal_monardes_1574", "name": "Chicoria", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Chicoria"], "contexts": ["plant with similar leaves"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Chica", "target_book": "historia_medicinal_monardes_1574", "target_name": "Chicoria", "similarity": 0.854}], "id": 1914, "stable_key": "clu_fd5f728c4b86cd35", "ground_truth": {"modern_name": "Cochineal", "confidence": "medium", "type": "chemical", "note": "'Chica' and 'Chicoria' are difficult to pinpoint definitively. However, 'Chica' can refer to various fermented beverages or pastes in South America, some used for coloring. 'Chicoria' can be related to chicory. Given the context of Monardes, who documented New World plants and their uses, and the mention of 'coloring paste', cochineal, a potent red dye derived from insects, is a strong possibility, though other plant-based colorants are also plausible.", "wikidata_id": "Q88502448", "wikidata_description": "scientific article published on 26 April 2018", "wikipedia_extract": "Boca Chica is an area on the eastern portion of a subdelta peninsula of Cameron County, at the far south of the US state of Texas along the Gulf Coast. It is bordered by the Brownsville Ship Channel to the north, the Rio Grande and Mexico to the south, and the Gulf of Mexico to the east. The area extends about 25 miles (40 km) east of the city of Brownsville. The peninsula is served by Texas State Highway 4—also known as the Boca Chica Highway or Boca Chica Boulevard—which runs east–west, terminating at the Gulf and Boca Chica Beach. The Boca Chica area has seen various developments over the course of its history. These include Mexican land grants, Mexican and American ranches, a battlefield of the American Civil War, a 1920s beach resort, and a state park (Boca Chica State Park); additionally, a small settlement named Boca Chica Village existed in the area from 1960 to 2020.", "wikipedia_url": "https://en.wikipedia.org/wiki/Boca_Chica_(Texas)"}}, {"canonical_name": "Collao", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "collao", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Collao", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Collao"], "contexts": ["high plains in Peru"]}, {"entity_id": "collao", "book_id": "historia_medicinal_monardes_1574", "name": "Collao", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Collao"], "contexts": ["land in Peru with bituminose mountains"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Collao", "target_book": "historia_medicinal_monardes_1574", "target_name": "Collao", "similarity": 1.0}], "id": 1915, "stable_key": "clu_16622b1c114d70c7", "ground_truth": {"wikipedia_extract": "Collao is a parish (administrative division) in Siero, a municipality within the province and autonomous community of Asturias, in northern Spain. The parish is located on Highway AS-113. It is 0.27 km2 (0.10 sq mi) in size, and is situated at an elevation of 230 m (750 ft) above sea level. The population is 488 Collao and other nearby parishes, such as Lieres and Carbayín, are historically associated with Andalusian mining. Collao's patron saint festivities honor San Cristóbal, and are held every year on the first Sunday of July. The Gazetteer of SADEI identifies five notable sites within the parish: The Cirigüeyu, Cordón, Fuentemil, Llorián and La Quintana."}}, {"canonical_name": "Miega", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "miega", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Miega", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Miega"], "contexts": ["plant genus"]}, {"entity_id": "miganilla", "book_id": "historia_medicinal_monardes_1574", "name": "Miganilla", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Miganilla"], "contexts": ["a plant used as an emetic"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Miega", "target_book": "historia_medicinal_monardes_1574", "target_name": "Miganilla", "similarity": 0.853}], "id": 1916, "stable_key": "clu_f3c94fc4c2008bd4", "ground_truth": {"modern_name": "Thrift", "confidence": "low", "type": "plant", "linnaean": "Armeria maritima", "family": "Caryophyllaceae", "note": "The term 'Miega' and 'Miganilla' are not immediately recognizable as standard botanical names. However, some species of Thrift (Armeria) have historical medicinal uses, including emetic properties, which aligns with the description. Further etymological research into early Spanish and Portuguese texts might clarify this identification."}}, {"canonical_name": "pulpe végétale", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pulpe_végétale", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pulpe végétale", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["pulpe végétale"], "contexts": ["vegetable pulp"]}, {"entity_id": "pulpa", "book_id": "historia_medicinal_monardes_1574", "name": "pulpa", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["pulpa"], "contexts": ["pulp"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pulpe végétale", "target_book": "historia_medicinal_monardes_1574", "target_name": "pulpa", "similarity": 0.873}], "id": 1917, "stable_key": "clu_13d43cd759d2ae38", "ground_truth": {"modern_name": "Pulp", "confidence": "high", "type": "concept", "wikidata_id": "Q672506", "wikidata_description": "fibrous material used notably in papermaking", "wikipedia_url": "https://en.wikipedia.org/wiki/Pulp%20%28paper%29"}}, {"canonical_name": "tiburones", "category": "ANIMAL", "subcategory": "FISH", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "tiburones", "book_id": "relation_historique_humboldt_vol3_1825", "name": "tiburones", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["tiburones"], "contexts": ["Spanish word for sharks"]}, {"entity_id": "tiburon", "book_id": "historia_medicinal_monardes_1574", "name": "Tiburon", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["Tiburon"], "contexts": ["large, strong, and warlike fish in the Indies"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "tiburones", "target_book": "historia_medicinal_monardes_1574", "target_name": "Tiburon", "similarity": 0.971}], "id": 1918, "stable_key": "clu_b91dbcaddfc56818", "ground_truth": {"wikipedia_extract": "\"Tiburones\" (transl. \"Sharks\") is a song recorded by Puerto Rican singer Ricky Martin for his first extended play, Pausa (2020). The song was written by Oscar Hernandez and Pablo Preciado, while the production was handled by Julio Reyes Copello. The song was released for digital download and streaming by Sony Music Latin on January 23, 2020, as the second single from the extended play. A Spanish language ballad and Latin pop song, it is about the importance of peace, love and unity. It received positive reviews from music critics, who complimented its lyrics. \"Tiburones\" was nominated for Song of the Year at the 21st Annual Latin Grammy Awards. The song was commercially successful in Latin America, reaching number one in Argentina and Puerto Rico, as well as the top 10 in eight other Latin American countries."}}, {"canonical_name": "noix muscade", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "noix_muscade", "book_id": "relation_historique_humboldt_vol3_1825", "name": "noix muscade", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["noix muscade"], "contexts": ["spice to be cultivated"]}, {"entity_id": "nuez_moſcada", "book_id": "historia_medicinal_monardes_1574", "name": "Nuez moſcada", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Nuez moſcada"], "contexts": ["spice with aromatic flavor"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "noix muscade", "target_book": "historia_medicinal_monardes_1574", "target_name": "Nuez moſcada", "similarity": 0.912}], "id": 1919, "stable_key": "clu_a072588eb71b3d10", "ground_truth": {"modern_name": "Nutmeg", "confidence": "high", "type": "plant", "linnaean": "Myristica fragrans", "family": "Myristicaceae", "wikipedia_extract": "Nutmeg is the seed, or the ground spice derived from the seed, of several tree species of the genus Myristica; fragrant nutmeg or true nutmeg (M. fragrans) is a dark-leaved evergreen tree cultivated for two spices derived from its fruit: nutmeg, from its seed, and mace, from the seed covering. It is also a commercial source of nutmeg essential oil and nutmeg butter. The Banda Islands, in Maluku, Indonesia, are the main producer of nutmeg and mace, and the true nutmeg tree is native to the islands. Nutmeg and mace, commonly used as food spices, have been traditionally employed for their psychoactive and aphrodisiac effects, though clinical evidence is lacking. High doses can cause serious toxic effects including acute psychosis, with risks heightened during pregnancy and with psychiatric conditions.", "wikipedia_url": "https://en.wikipedia.org/wiki/Nutmeg"}}, {"canonical_name": "Origen de los Indios", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "origen_de_los_indios", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Origen de los Indios", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Origen de los Indios"], "contexts": ["cited work"]}, {"entity_id": "les_orig__indo-européennes", "book_id": "coloquios_da_orta_1563", "name": "Les Orig. Indo-européennes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Les Orig. Indo-européennes"], "contexts": ["a work by A. Pictet"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Origen de los Indios", "target_book": "coloquios_da_orta_1563", "target_name": "Les Orig. Indo-européennes", "similarity": 0.867}], "id": 1920, "stable_key": "clu_f5c252770fc0c801", "ground_truth": {"modern_name": "Origins of the Indigenous Peoples", "confidence": "medium", "type": "text", "note": "The members suggest two different texts with similar themes but potentially different authors or contexts. 'Origen de los Indios' is likely a specific work, while 'Les Orig. Indo-européennes' refers to an academic work by A. Pictet on Indo-European origins.", "wikipedia_extract": "Taiwanese indigenous peoples, formerly called Taiwanese aborigines, are the indigenous peoples of Taiwan, with the nationally recognized subgroups numbering about 600,303 or 3% of the country's population. This total is increased to more than 800,000 if the indigenous peoples of the plains in Taiwan are included, pending future official recognition. When including those of mixed ancestry, such a number is possibly more than a million. Academic research suggests that their ancestors have been living on Taiwan for approximately 15,000 years. A wide body of evidence suggests that the Taiwanese indigenous peoples had maintained regular trade networks with numerous regional cultures of Southeast Asia before Han Chinese settled on the island from the 17th century, at the behest of the Dutch colonial administration and later by successive governments towards the 20th century. Taiwanese indigenous peoples are Austronesians with linguistic, genetic, and cultural ties to other Austronesian peoples.", "wikipedia_url": "https://en.wikipedia.org/wiki/Taiwanese_indigenous_peoples"}}, {"canonical_name": "Mithriflates", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mithriflates", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mithriflates", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Mithriflates"], "contexts": ["source of information"]}, {"entity_id": "mithkal", "book_id": "coloquios_da_orta_1563", "name": "mithkal", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["mithkal"], "contexts": ["unit of weight"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mithriflates", "target_book": "coloquios_da_orta_1563", "target_name": "mithkal", "similarity": 0.851}], "id": 1921, "stable_key": "clu_8a90ad1a2ff97f90", "ground_truth": {"modern_name": "Mithqal", "confidence": "high", "type": "concept", "note": "Mithqal (or mithqal) is a historical Arabic unit of weight.", "wikidata_id": "Q974625", "wikidata_description": "unit of mass equal to 4.25 grams", "wikipedia_url": "https://en.wikipedia.org/wiki/Mithqal"}}, {"canonical_name": "ruminans", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ruminans", "book_id": "relation_historique_humboldt_vol3_1825", "name": "ruminans", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["ruminans"], "contexts": ["small animals, defenseless and slow-moving"]}, {"entity_id": "ruminantes", "book_id": "coloquios_da_orta_1563", "name": "ruminantes", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["ruminantes"], "contexts": ["animals, source of bezoars"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "ruminans", "target_book": "coloquios_da_orta_1563", "target_name": "ruminantes", "similarity": 0.88}], "id": 1922, "stable_key": "clu_8c927bec69415b0f", "ground_truth": {"modern_name": "Ruminants", "confidence": "high", "type": "animal", "wikidata_id": "Q70307801", "wikidata_description": "in ruminant animals, the abomasum, omasum, reticulum and rumen", "wikipedia_extract": "The clouded leopard (Neofelis nebulosa), also called mainland clouded leopard, is a wild cat inhabiting dense forests from the foothills of the Himalayas through Northeast India and Bhutan to mainland Southeast Asia into South China. It was first described in 1821 on the basis of a skin of an individual from China. The clouded leopard has large dusky-grey blotches and irregular spots and stripes reminiscent of clouds. Its head-and-body length ranges from 68.6 to 108 cm (27.0 to 42.5 in) with a 61 to 91 cm (24 to 36 in) long tail. It uses its tail for balancing when moving in trees and is able to climb down vertical tree trunks head first. It rests in trees during the day and hunts by night on the forest floor.", "wikipedia_url": "https://en.wikipedia.org/wiki/Clouded_leopard"}}, {"canonical_name": "M. d'Espinosa", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "m__d'espinosa", "book_id": "relation_historique_humboldt_vol3_1825", "name": "M. d'Espinosa", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["M. d'Espinosa"], "contexts": ["scholar who made barometric measurements"]}, {"entity_id": "a__m__de_espintr", "book_id": "coloquios_da_orta_1563", "name": "A. M. de Espintr", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["A. M. de Espintr"], "contexts": ["author of Arte de Balleteria"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "M. d'Espinosa", "target_book": "coloquios_da_orta_1563", "target_name": "A. M. de Espintr", "similarity": 0.842}], "id": 1923, "stable_key": "clu_f9bcdef2fd9731bf", "ground_truth": {"modern_name": "Mateo de Espinosa", "confidence": "medium", "type": "person", "description": "Scholar and author of hunting treatises.", "note": "The names 'M. d'Espinosa' and 'A. M. de Espintr' are phonetically similar. Mateo de Espinosa is a known historical figure associated with hunting.", "wikidata_id": "Q130812015", "wikidata_description": "researcher", "wikipedia_extract": "Ernestina de Champourcín Morán de Loredo (10 July 1905 in Vitoria-Gasteiz – 27 March 1999 in Madrid) was a Spanish poet. She is most associated with the Generation of '27. Ernestina Michels de Champourcín Morán de Loredo, was born into a Catholic and traditionalist family, which offered her a thorough education (she was taught a range of different languages) as part of an aristocratic and cultured family atmosphere. Her father was a lawyer of monarchical ideas, and despite his liberal-conservative inclination, Antonio Michels de Champourcín possessed the title of baron of Champourcín, a title which pointed to his paternal family's origin in Provence. Ernestina's mother, Ernestina Morán de Loredo Castellanos, was born in Montevideo, being the only daughter of a military man, of Asturian descent, with whom she often traveled to Europe. Around the age of 10, Champourcín moved, together with the rest of the family, to Madrid, where she was enrolled in the College of the Sacred Heart, received private tuition, and was examined as a free high school student.", "wikipedia_url": "https://en.wikipedia.org/wiki/Ernestina_de_Champourcín"}}, {"canonical_name": "sémitique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sémitique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "sémitique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sémitique"], "contexts": ["Semitic language"]}, {"entity_id": "semíticas", "book_id": "coloquios_da_orta_1563", "name": "semíticas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["semíticas"], "contexts": ["language family"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "sémitique", "target_book": "coloquios_da_orta_1563", "target_name": "semíticas", "similarity": 0.94}], "id": 1924, "stable_key": "clu_51540de421c1da52", "ground_truth": {"modern_name": "Semitic languages", "confidence": "high", "type": "concept", "wikidata_id": "Q34049", "wikidata_description": "language group containing Arabic and Hebrew", "wikipedia_url": "https://en.wikipedia.org/wiki/Semitic_languages", "wikipedia_extract": "The Semitic languages are a branch of the Afroasiatic language family. They include Arabic, Amharic, Tigrinya, Aramaic, Hebrew, Maltese, Modern South Arabian languages and numerous other ancient and modern languages. They are spoken by more than 460 million people across much of West Asia, North Africa, the Horn of Africa, Malta, and in large immigrant and expatriate communities in North America, Europe, and Australasia. The terminology was first used in the 1780s by members of the Göttingen school of history, who derived the name from Shem (שם), one of the three sons of Noah in the Book of Genesis. Arabic is by far the most widely spoken of the Semitic languages with 411 million native speakers of all varieties, and it is the most spoken native language in Africa and West Asia. Other Semitic languages include Amharic (35 million native speakers), Tigrinya (9.9 million speakers), Hebrew (5 million native speakers), Tigre (1 million speakers), and Maltese (570,000 speakers)."}}, {"canonical_name": "Saragosse", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "saragosse", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Saragosse", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Saragosse"], "contexts": ["city where treaty was concluded"]}, {"entity_id": "saragoça", "book_id": "coloquios_da_orta_1563", "name": "Saragoça", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Saragoça"], "contexts": ["city where contract was celebrated"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saragosse", "target_book": "coloquios_da_orta_1563", "target_name": "Saragoça", "similarity": 0.934}], "id": 1925, "stable_key": "clu_b9c71cf457a429c4", "ground_truth": {"wikipedia_extract": "Zaragoza (Spanish: [θaɾaˈɣoθa] ), traditionally known in English as Saragossa ( SARR-ə-GOSS-ə), is the capital city of the province of Zaragoza and of the autonomous community of Aragon, Spain. It lies by the Ebro river and its tributaries, the Huerva and the Gállego, roughly in the centre of both Aragon and the Ebro basin. In the 1st century BCE, Romans founded the colony of Caesaraugusta over the Sedetani settlement of Salduie. The city was the capital of the Upper March of Al-Andalus under Umayyad rule, later thriving as a capital of a rump state ruled by the Banu Hud, the taifa of Zaragoza. It swiftly became the political and spiritual centre of the Kingdom of Aragon after the 1118 Christian conquest, and its inhabitants managed to preserve and consolidate initially granted privileges over the course of the Late Middle Ages. As of 2025, Zaragoza had a population of 699,007 inhabitants, making it the fourth most populous in Spain, on a land area of 973.78 square kilometres (375.98 square miles) and is the centre of a metropolitan area of around 0.76 million."}}, {"canonical_name": "Call", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "call", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Call", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Call"], "contexts": ["high plain name"]}, {"entity_id": "dial", "book_id": "coloquios_da_orta_1563", "name": "Dial", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Dial"], "contexts": ["name of a river's mouth"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Call", "target_book": "coloquios_da_orta_1563", "target_name": "Dial", "similarity": 0.946}], "id": 1926, "stable_key": "clu_8a4bee1245e267f6", "ground_truth": {"modern_name": "Kall", "confidence": "low", "type": "place", "country": "Switzerland", "note": "The association with 'Dial' (a river's mouth) and 'Call' (a high plain name) makes the exact referent ambiguous. 'Kall' is a Swiss municipality, but its connection to a river mouth or high plain is not immediately clear without more context.", "wikipedia_extract": "Kristina Lee \"Kris\" Halliwell Collins (born July 1, 1996), better known as Kallmekris, is a Canadian social media personality, actress, comedian, and hairdresser from British Columbia. She is known for her skits that range from thirty seconds to a minute long. Collins began posting on TikTok in April 2020. As of February 2026, she has 50.5 million followers, making her the most-followed TikToker from Canada and the 38th overall. Her YouTube channel, which she began uploading to in 2020, has 12.8 million subscribers as of February 2026. In July 2025, Collins made her feature directorial debut with the found footage horror film, House on Eden.", "wikipedia_url": "https://en.wikipedia.org/wiki/KallMeKris"}}, {"canonical_name": "Valais", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "valais", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Valais", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Valais"], "contexts": ["valley in Switzerland"]}, {"entity_id": "valença", "book_id": "coloquios_da_orta_1563", "name": "Valença", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Valença"], "contexts": ["albudeca used more in Valencia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Valais", "target_book": "coloquios_da_orta_1563", "target_name": "Valença", "similarity": 0.883}], "id": 1927, "stable_key": "clu_0e0662aea2483791", "ground_truth": {"wikipedia_extract": "Valais (UK:  VAL-ay, US:  val-AY; French: [valɛ] ), more formally, the Canton of Valais or Wallis, is one of the 26 cantons forming the Swiss Confederation. It is composed of thirteen districts and its capital and largest city is Sion. Valais is situated in the southwestern part of the country. It borders the cantons of Vaud and Bern to the north, the cantons of Uri and Ticino to the east, as well as Italy to the south and France to the west. It is one of the three large southern Alpine cantons, along with Ticino and Grisons. It is a bilingual canton, French and German being its two official languages."}}, {"canonical_name": "Cumucumu", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cumucumu", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cumucumu", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Cumucumu"], "contexts": ["mountain range"]}, {"entity_id": "cumcam", "book_id": "coloquios_da_orta_1563", "name": "Cumcam", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Cumcam"], "contexts": ["region where calamus is called paicam"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cumucumu", "target_book": "coloquios_da_orta_1563", "target_name": "Cumcam", "similarity": 0.865}], "id": 1928, "stable_key": "clu_377f4ae181043a25", "ground_truth": {"modern_name": "Cumucumu", "confidence": "medium", "type": "place", "country": "Peru", "note": "The variation 'Cumcam' suggests a likely geographic feature. Cumucumu is a known mountain range in Peru."}}, {"canonical_name": "Basse-Egypte", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "basse-egypte", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Basse-Egypte", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Basse-Egypte"], "contexts": ["region with comparable temperature"]}, {"entity_id": "baixo_egipto", "book_id": "coloquios_da_orta_1563", "name": "baixo Egipto", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["baixo Egipto"], "contexts": ["location of Ichneumon mentions"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Basse-Egypte", "target_book": "coloquios_da_orta_1563", "target_name": "baixo Egipto", "similarity": 0.842}], "id": 1929, "stable_key": "clu_c356deec2d8a9976", "ground_truth": {"modern_name": "Lower Egypt", "confidence": "high", "type": "place", "country": "Egypt", "wikipedia_extract": "In Egyptian history, the Upper and Lower Egypt period (also known as The Two Lands) was the final stage of prehistoric Egypt and directly preceded the unification of the realm. The conception of Egypt as the Two Lands was an example of the dualism in ancient Egyptian culture and frequently appeared in texts and imagery, including in the titles of Egyptian pharaohs. The Egyptian title zmꜣ-tꜣwj (Egyptological pronunciation sema-tawy) is usually translated as \"Uniter of the Two Lands\" and was depicted as a human trachea entwined with the papyrus and lily plant. The trachea stood for unification, while the papyrus and lily plant represent Lower and Upper Egypt. Standard titles of the pharaoh included the prenomen, quite literally \"Of the Sedge and Bee\" (nswt-bjtj, the symbols of Upper and Lower Egypt) and \"lord of the Two Lands\" (written nb-tꜣwj). Queens regnant were addressed as pharaohs and male.", "wikipedia_url": "https://en.wikipedia.org/wiki/Upper_and_Lower_Egypt"}}, {"canonical_name": "sophismes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sophismes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "sophismes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sophismes"], "contexts": ["fallacious arguments"]}, {"entity_id": "sophi", "book_id": "coloquios_da_orta_1563", "name": "Sophi", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Sophi"], "contexts": ["designation for Ismael"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "sophismes", "target_book": "coloquios_da_orta_1563", "target_name": "Sophi", "similarity": 0.82}], "id": 1930, "stable_key": "clu_d5854ae6d9633253", "ground_truth": {"modern_name": "Fallacious reasoning", "confidence": "medium", "type": "concept", "note": "The term 'Sophi' in the Portuguese text likely refers to the philosophical concept of wisdom or knowledge, but in the context of 'coloquios', it could also be part of a name or a more specific term. 'Sophismes' in French clearly means fallacies.", "wikidata_id": "Q186150", "wikidata_description": "use of invalid or otherwise faulty reasoning in the construction of an argument", "wikipedia_url": "https://en.wikipedia.org/wiki/Fallacy", "wikipedia_extract": "A fallacy is the use of invalid or otherwise faulty reasoning in the construction of an argument that may appear to be well-reasoned if unnoticed. The term was introduced in the Western intellectual tradition by the Aristotelian De Sophisticis Elenchis. Fallacies in reasoning may be invoked intentionally to manipulate or persuade by deception, unintentionally because of human limitations such as carelessness, cognitive or social biases and ignorance, or potentially due to the limitations of language and understanding of language. These delineations include not only the ignorance of the right reasoning standard but also the ignorance of relevant properties of the context. For instance, the soundness of legal arguments depends on the context in which they are made. A fallacy does not necessarily lead to a false conclusion: it may accidentally be a result of invalid reasoning."}}, {"canonical_name": "torchis", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "torchis", "book_id": "relation_historique_humboldt_vol3_1825", "name": "torchis", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["torchis"], "contexts": ["building material"]}, {"entity_id": "torace", "book_id": "ricettario_fiorentino_1597", "name": "Torace", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Torace"], "contexts": ["storax substance"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "torchis", "target_book": "ricettario_fiorentino_1597", "target_name": "Torace", "similarity": 0.87}], "id": 1931, "stable_key": "clu_eaa8991685f49208", "ground_truth": {"modern_name": "Storax", "confidence": "medium", "type": "chemical", "note": "'Torace' in the Florentine text refers to storax, a resin. 'Torchis' in French usually means wattle-and-daub, a building material, but in the context of Humboldt's relation, it might refer to a substance or material used in construction or for some other purpose. Given the other mention of storax, this is a plausible connection.", "wikidata_id": "Q525062", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Styrax", "wikipedia_extract": "Styrax (common names storax or snowbell) is a genus of about 130 species of large shrubs or small trees in the family Styracaceae, mostly native to warm temperate to tropical regions of the Northern Hemisphere, with the majority in eastern and southeastern Asia, but also crossing the equator in South America. The resin obtained from the tree is called benzoin or storax (not to be confused with the Liquidambar storax balsam), often used as a vanilla-like component in perfumery. The genus Pamphilia, sometimes regarded as distinct, is now included within Styrax based on analysis of morphological and DNA sequence data. The spicebush (Lindera benzoin) is a different plant, in the family Lauraceae. Styrax trees grow to 2–14 m tall, and have alternate, deciduous or evergreen simple ovate leaves 1–18 cm long and 2–10 cm broad. The flowers are pendulous, with a white 5–10-lobed corolla, produced 3–30 together on open or dense panicles 5–25 cm long."}}, {"canonical_name": "doUars", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "douars", "book_id": "relation_historique_humboldt_vol3_1825", "name": "doUars", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["doUars"], "contexts": ["currency unit"]}, {"entity_id": "duarás", "book_id": "coloquios_da_orta_1563", "name": "duarás", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["duarás"], "contexts": ["resin of the Cannabis plant"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "doUars", "target_book": "coloquios_da_orta_1563", "target_name": "duarás", "similarity": 0.86}], "id": 1932, "stable_key": "clu_d2e9375e59b94837", "ground_truth": {"modern_name": "Currency", "confidence": "medium", "type": "concept", "note": "'Duarás' in Portuguese can refer to a unit of currency. 'doUars' is likely a variant or OCR error for a similar term in the French text. The reference to 'resin of the Cannabis plant' is not supported by the provided context for 'doUars'.", "wikidata_id": "Q8142", "wikidata_description": "generally accepted medium of exchange for goods or services", "wikipedia_url": "https://en.wikipedia.org/wiki/Currency", "wikipedia_extract": "Qasr al-Hukm District (Arabic: منطقة قصر الحكم, romanized: Minṭaqaẗ Qaṣr al-Ḥukm, lit. 'Governance Palace District') or the Justice Palace District (Arabic: منطقة قصر العدل, romanized: Minṭaqaẗ Qaṣr al-ʿAdl, lit. 'Justice Palace District'), is a term used to define the area within the perimeters of the erstwhile walled town of Riyadh in Riyadh, Saudi Arabia, encompassing present-day districts of ad-Dirah and ad-Doho, that lie on several extinct douars (Arabic: حِلَّة, romanized: ḥilla) that once fell within the enclosure of the gates of old city walls prior to its demolition in the 1950s. Named after the eponymous al-Hukm Palace, it is widely considered to be the antecedent to modern Riyadh since the metropolis outgrew as an offshoot of the walled town in the 1950s. Owing to its historical and architectural significance, it was rebuilt by the Saudi government from 1973 to 1992 and is situated southwest of al-Batʼha commercial area. It hosts some of the most important cultural heritage landmarks in the city, such as Masmak Fortress, Imam Turki bin Abdullah Grand Mosque, Deera Square and the eponymous al-Hukm Palace besides several traditional marketplaces."}}, {"canonical_name": "fort", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fort", "book_id": "relation_historique_humboldt_vol3_1825", "name": "fort", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["fort"], "contexts": ["defensive structure"]}, {"entity_id": "fortaleza", "book_id": "coloquios_da_orta_1563", "name": "fortaleza", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["fortaleza"], "contexts": ["military structure"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "fort", "target_book": "coloquios_da_orta_1563", "target_name": "fortaleza", "similarity": 0.952}], "id": 1933, "stable_key": "clu_aec5106c43dd5375", "ground_truth": {"wikipedia_extract": "A fortification (also called a fort, fortress, fastness, or stronghold) is a military construction designed for the defense of territories in warfare, and is used to establish rule in a region during peacetime. The term is derived from Latin fortis (\"strong\") and facere (\"to make\"). From very early history to modern times, defensive walls have often been necessary for cities to survive in an ever-changing world of invasion and conquest. Some settlements in the Indus Valley Civilization were the first small cities to be fortified. In ancient Greece, large cyclopean stone walls fitted without mortar had been built in Mycenaean Greece, such as the ancient site of Mycenae. A Greek phrourion was a fortified collection of buildings used as a military garrison, and is the equivalent of the Roman castellum or fortress."}}, {"canonical_name": "Cortès d'Espagne", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cortès_d'espagne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cortès d'Espagne", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Cortès d'Espagne"], "contexts": ["Spanish assembly"]}, {"entity_id": "coroa_de_espanha", "book_id": "coloquios_da_orta_1563", "name": "coroa de Espanha", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["coroa de Espanha"], "contexts": ["unit of currency value"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cortès d'Espagne", "target_book": "coloquios_da_orta_1563", "target_name": "coroa de Espanha", "similarity": 0.86}], "id": 1934, "stable_key": "clu_e58700d29de9fe61", "ground_truth": {"modern_name": "Spanish currency", "confidence": "medium", "type": "concept", "note": "'Cortès d'Espagne' in French refers to a Spanish assembly. 'coroa de Espanha' in Portuguese means 'crown of Spain', which could refer to the monarchy or a unit of currency. The common thread is a connection to Spain and a formalized entity.", "wikipedia_extract": "The currencies of Puerto Rico closely follow the historic development of the territory. As a Province of Spain (Autonomous Community) and a territory of the United States, Puerto Rico was granted the use of both foreign and provincial currencies. Following the Spanish colonization in 1508, Puerto Rico became an important port, with its own supply of gold. However, as the mineral reserves ran empty within the century, the archipelago's economy suffered. The Spanish Crown issued the Situado Mexicano, which meant that a semi-regular shipment of gold from the Viceroyalty of New Spain would be sent to the island, as a way to provide economic support. Between 1636 and 1637, Philip IV of Spain imposed a tax which had to be paid using a revenue stamp.", "wikipedia_url": "https://en.wikipedia.org/wiki/Currencies_of_Puerto_Rico"}}, {"canonical_name": "arholedas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "arholedas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "arholedas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["arholedas"], "contexts": ["description of islets"]}, {"entity_id": "aparelhada", "book_id": "coloquios_da_orta_1563", "name": "aparelhada", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["aparelhada"], "contexts": ["state of being prepared, equipped"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "arholedas", "target_book": "coloquios_da_orta_1563", "target_name": "aparelhada", "similarity": 0.843}], "id": 1935, "stable_key": "clu_ffa2c66a132b0fb8", "ground_truth": {"modern_name": "Prepared", "confidence": "medium", "type": "concept", "note": "'Aparelhada' in Portuguese means prepared or equipped. 'arholedas' is less clear but could be a descriptive term for something in a prepared state, especially in a geographical context where islets might be described as prepared for landing or habitation.", "wikidata_id": "Q2075980", "wikidata_description": "sample or representative specimen of a class of organisms", "wikipedia_url": "https://en.wikipedia.org/wiki/Self-concept", "wikipedia_extract": "In the psychology of self, one's self-concept (also called self-construction, self-identity, self-perspective or self-structure) is a collection of beliefs about oneself. Generally, self-concept embodies the answer to the question \"Who am I?\". The self-concept is distinguishable from self-awareness, which is the extent to which self-knowledge is defined, consistent, and currently applicable to one's attitudes and dispositions. Self-concept also differs from self-esteem: self-concept is a cognitive or descriptive component of one's self (e.g., \"I am a fast runner\"), while self-esteem is evaluative and opinionated (e.g., \"I feel good about being a fast runner\"). Self-concept is made up of one's self-schemas, and interacts with self-esteem, self-knowledge, and the social self to form the self as a whole. It includes the past, present, and future selves, where future selves (or possible selves) represent individuals' ideas of what they might become, what they would like to become, or what they are afraid of becoming."}}, {"canonical_name": "Mozambique", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mozambique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mozambique", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Mozambique"], "contexts": ["city in Mozambique"]}, {"entity_id": "mozambique", "book_id": "coloquios_da_orta_1563", "name": "Mozambique", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Mozambique"], "contexts": ["port city, geographical reference"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mozambique", "target_book": "coloquios_da_orta_1563", "target_name": "Mozambique", "similarity": 1.0}], "id": 1936, "stable_key": "clu_4d8b2410793434bf", "ground_truth": {"modern_name": "Mozambique", "confidence": "low", "type": "place", "description": "Port city and coastal location, also a river and islands.", "note": "This cluster appears to conflate several distinct geographical locations including the city/country of Mozambique, the Moluccas islands, and a river named Motagua.", "wikipedia_extract": "Mozambique, officially the Republic of Mozambique, is a country located in Southeast Africa bordered by the Indian Ocean to the east, Tanzania to the north, Malawi and Zambia to the northwest, Zimbabwe to the west, and Eswatini and South Africa to the south and southwest. The sovereign state is separated from the Comoros, Mayotte, and Madagascar through the Mozambique Channel to the east. The capital and largest city is Maputo. Between the 7th and 11th centuries, a series of Swahili port towns developed in the area, which contributed to the development of a distinct Swahili culture and dialect. In the late medieval period, these towns were frequented by traders from Somalia, Ethiopia, Egypt, Arabia, Persia, and India. The voyage of Vasco da Gama in 1498 marked the arrival of the Portuguese, who began a gradual process of colonisation and settlement in 1505."}}, {"canonical_name": "Colombo", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "colombo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Colombo", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Colombo"], "contexts": ["location in Ceylon with temperature data"]}, {"entity_id": "colombo_(porto_de_ceyláo)", "book_id": "coloquios_da_orta_1563", "name": "Colombo (porto de Ceyláo)", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Colombo (porto de Ceyláo)"], "contexts": ["port city in Sri Lanka"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Colombo", "target_book": "coloquios_da_orta_1563", "target_name": "Colombo (porto de Ceyláo)", "similarity": 0.831}], "id": 1937, "stable_key": "clu_5042b1072f3e8d0d", "ground_truth": {"wikipedia_extract": "Colombo ( kə-LUM-boh; Sinhala: කොළඹ, romanised: Koḷam̆ba, IPA: [ˈkoləᵐbə]; Tamil: கொழும்பு, romanised: Koḻumpu, IPA: [koɻumbɯ]) is the largest city of Sri Lanka by population and de facto the commercial capital of Sri Lanka. The Colombo metropolitan area is estimated to have a population of 5.6 million, and 752,993 within the municipal limits. It is the financial centre of the island and a tourist destination. It is located on the west coast of the island. It is also the administrative capital of the Western Province and the district capital of Colombo District. It was made the capital of the island when Sri Lanka was ceded to the British Empire in 1815, retaining its capital status when Sri Lanka gained independence in 1948."}}, {"canonical_name": "Geylan", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "geylan", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Geylan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Geylan"], "contexts": ["destination of voyage"]}, {"entity_id": "geilam", "book_id": "coloquios_da_orta_1563", "name": "Geilam", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Geilam"], "contexts": ["region where spice grows"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Geylan", "target_book": "coloquios_da_orta_1563", "target_name": "Geilam", "similarity": 0.884}], "id": 1938, "stable_key": "clu_3ffbda68e4ed3174", "ground_truth": {"modern_name": "Sri Lanka", "confidence": "high", "type": "place", "country": "Sri Lanka", "note": "Geylan and Geilam are historical names for Ceylon, which is now Sri Lanka."}}, {"canonical_name": "Aristides", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "aristides", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Aristides", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Aristides"], "contexts": ["grasses found in the Llanos"]}, {"entity_id": "artemisia", "book_id": "ricettario_fiorentino_1597", "name": "Artemisia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Artemisia"], "contexts": ["herb mentioned in a decree"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Aristides", "target_book": "ricettario_fiorentino_1597", "target_name": "Artemisia", "similarity": 0.85}], "id": 1939, "stable_key": "clu_eabf3513caa740e6", "ground_truth": {"wikipedia_extract": "Aristides ( ARR-ih-STY-deez; Ancient Greek: Ἀριστείδης, romanized: Aristeídēs, Attic Greek: [aristěːdɛːs]; 530–468 BC) was an ancient Athenian statesman. Nicknamed \"the Just\" (δίκαιος, díkaios), he flourished at the beginning of Athens' Classical period and is remembered for his generalship in the Persian War. The ancient historian Herodotus cited him as \"the best and most honourable man in Athens\", and he received similarly reverent treatment in Plato's Socratic dialogues. Aristides was a member of a family of moderate fortune; his father's name was Lysimachus. Early in life he became a follower of the statesman Cleisthenes. He probably first came to notice as strategos in command of his native tribe Antiochis at the Battle of Marathon of 490 BC."}}, {"canonical_name": "cotonnades", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cotonnades", "book_id": "relation_historique_humboldt_vol3_1825", "name": "cotonnades", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["cotonnades"], "contexts": ["cotton fabrics"]}, {"entity_id": "cotognata", "book_id": "ricettario_fiorentino_1597", "name": "Cotognata", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Cotognata"], "contexts": ["confectionery"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "cotonnades", "target_book": "ricettario_fiorentino_1597", "target_name": "Cotognata", "similarity": 0.873}], "id": 1940, "stable_key": "clu_a9490b55b9dec336", "ground_truth": {"modern_name": "Cotton fabric", "confidence": "medium", "type": "object", "note": "'Cotognata' in Italian refers to quince paste or confectionery. 'cotonnades' in French refers to cotton fabrics. The link between these is weak, but 'coton' is the root for both. Given the medical context, fabric is more likely.", "wikidata_id": "Q3695916", "wikidata_description": "woven fabric made of cotton or cotton-blends", "wikipedia_extract": "Stalle is a district of Brussels, Belgium, located within the municipality of Uccle. The area lies between the valleys of the Geleytsbeek and the Ukkelbeek and takes its name from the former lordship of Stalle. Its inhabitants were traditionally nicknamed the Zoêvelbooren (“sand farmers”), a reference to the district's agricultural past. Archaeological evidence shows that the territory has been inhabited since ancient times. Stalle was first recorded as a lordship in the 12th century, held by the House of Stalle, one of at least seventeen families associated with it. The first known lords were Henri de Stalle, followed by Florent of Stalle (alderman of Brussels in 1319) and another Florent of Stalle (alderman in 1357), who with his brother Daniel founded the Stalle Chapel and donated lands in 1369.", "wikipedia_url": "https://en.wikipedia.org/wiki/Stalle,_Brussels"}}, {"canonical_name": "viande de porc", "category": "ANIMAL", "subcategory": "PRODUCT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "viande_de_porc", "book_id": "relation_historique_humboldt_vol3_1825", "name": "viande de porc", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["viande de porc"], "contexts": ["foodstuff in Havana"]}, {"entity_id": "sugna_di_porco", "book_id": "ricettario_fiorentino_1597", "name": "Sugna di porco", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["Sugna di porco"], "contexts": ["base for an ointment"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "viande de porc", "target_book": "ricettario_fiorentino_1597", "target_name": "Sugna di porco", "similarity": 0.841}], "id": 1941, "stable_key": "clu_dcbfd426d0a7809d", "ground_truth": {"modern_name": "Pork fat", "confidence": "high", "type": "chemical", "note": "'Viande de porc' means pork meat. 'Sugna di porco' means lard or pork fat. Both are derived from pigs and are used as foodstuffs or in ointments.", "wikidata_id": "Q109040786", "wikidata_description": "", "wikipedia_extract": "Tallow is a rendered form of beef or mutton suet, primarily made up of triglycerides. In industry, tallow is not strictly defined as beef or mutton suet. In this context, tallow is animal fat that conforms to certain technical criteria, including its melting point. The solid material remaining after rendering is called cracklings, greaves, or graves. It has been used mostly for animal food, such as dog food. In the soap industry and among soap-making hobbyists, the name tallowate is used informally to refer to soaps made from tallow.", "wikipedia_url": "https://fr.wikipedia.org/wiki/Panne_%28graisse%29"}}, {"canonical_name": "seigle", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "seigle", "book_id": "relation_historique_humboldt_vol3_1825", "name": "seigle", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["seigle"], "contexts": ["rye, a type of grain"]}, {"entity_id": "seseli", "book_id": "ricettario_fiorentino_1597", "name": "Seseli", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Seseli"], "contexts": ["herb with fennel-like leaves"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "seigle", "target_book": "ricettario_fiorentino_1597", "target_name": "Seseli", "similarity": 0.86}], "id": 1942, "stable_key": "clu_6a2567d5cccbb28c", "ground_truth": {"modern_name": "Rye", "confidence": "high", "type": "plant", "linnaean": "Secale cereale Linnaeus", "family": "Poaceae", "note": "The term 'seigle' is French for rye. The mention of 'Seseli' in the Florentine Ricettario suggests a potential ambiguity, as Seseli is a genus of herbs. However, the context of 'grain' strongly points to rye.", "wikidata_id": "Q12099", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Rye", "wikipedia_extract": "Rock and Rye is a term (both generically and brand names) for a bottled liqueur or mixed cocktail composed of rye whiskey and rock candy (crystallized sugar) or fruit. As early as 1914, United States government publications discuss disputes regarding beverages labeled \"rock and rye\", including a case of a beverage so marketed which was found by the Bureau of Chemistry to consist of \"water, sugar, glucose, and artificial coloring matters, sold in imitation of a rock and rye cordial\". Among non-alcoholic beverages, Rock and Rye continues to be a popular flavor of the Faygo brand of soda pop. Related products mentioned in the early 20th century include Rock and Rum and Rock and Gin. Slow & Low produced by Hochstadter's since 1884 produces a Rock & Rye drink that according to the label is \"served straight and as a proper old-fashioned since the 1800's Rock and Rye Union Made with Straight rye Whiskey Raw Honey, Navel Orange, Rock Candy and Bitters.\" It is 84 Proof Produced by Hochstadter's from Scobyville, NJ. In the film National Lampoon's Animal House, Boon (Peter Riegert) orders a \"double Rock and Rye and seven Carlings\" at a bar."}}, {"canonical_name": "Aristolochia tinbacencis", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "aristolochia_tinbacencis", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Aristolochia tinbacencis", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Aristolochia tinbacencis"], "contexts": ["plant from Turbaco"]}, {"entity_id": "aristolochia", "book_id": "ricettario_fiorentino_1597", "name": "Aristolochia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Aristolochia"], "contexts": ["plant with three species"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Aristolochia tinbacencis", "target_book": "ricettario_fiorentino_1597", "target_name": "Aristolochia", "similarity": 0.882}], "id": 1943, "stable_key": "clu_86b1a1dddd67de25", "ground_truth": {"modern_name": "Aristolochia", "confidence": "high", "type": "plant", "linnaean": "Aristolochia Linnaeus", "family": "Aristolochiaceae", "note": "While 'Aristolochia tinbacencis' is mentioned, it's likely a specific species or variety within the genus Aristolochia. The broader genus is the most fitting modern referent given the context of multiple species.", "wikidata_id": "Q156212", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Aristolochia", "wikipedia_extract": "Aristolochia californica, the California pipevine, California Dutchman's-pipe, or California snakeroot is a perennial woody vine of western North America. The vine is endemic to northern California. It is native to the Sacramento Valley, northern Sierra Nevada foothills, San Francisco Bay Area, Northern Inner California Coast Ranges, southeastern Klamath Mountains. The plant grows along riparian streambank areas, in chaparral, oak woodland, and mixed evergreen forest habitats. It is found below 700 metres (2,300 ft) in elevation. Aristolochia californica is a deciduous vine."}}, {"canonical_name": "baf^azo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "baf^azo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "baf^azo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["baf^azo"], "contexts": ["expressed sugar cane substance"]}, {"entity_id": "bafsii_co", "book_id": "ricettario_fiorentino_1597", "name": "Bafsii co", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Bafsii co"], "contexts": ["substance name"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "baf^azo", "target_book": "ricettario_fiorentino_1597", "target_name": "Bafsii co", "similarity": 0.901}], "id": 1944, "stable_key": "clu_3898f9868cbe36ed", "ground_truth": {"modern_name": "Sugarcane juice/syrup", "confidence": "medium", "type": "chemical", "note": "The OCR of 'baf^azo' and 'Bafsii co' is highly uncertain. 'Bafazo' might relate to juice or syrup from sugarcane (based on context), but the exact substance is unclear.", "wikidata_id": "Q57983194", "wikidata_description": "scholarly article by Juliana Aparecida de Souza Sartori et al published 1 January 2017 in International Journal of Food Engineering"}}, {"canonical_name": "Reitrâge", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "reitrâge", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Reitrâge", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Reitrâge"], "contexts": ["book title"]}, {"entity_id": "retortade", "book_id": "polyanthea_medicinal", "name": "retortade", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["retortade"], "contexts": ["glass vessel for distillation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Reitrâge", "target_book": "polyanthea_medicinal", "target_name": "retortade", "similarity": 0.862}], "id": 1945, "stable_key": "clu_afc86cfa4021d3a0", "ground_truth": {"modern_name": "Retort", "confidence": "high", "type": "object", "note": "'Reitrâge' is likely an OCR error or misspelling for 'retort', especially given the context of 'retortade' and glass vessels for distillation.", "wikidata_id": "Q638009", "wikidata_description": "glassware device used for distillation or dry distillation of substances", "wikipedia_url": "https://en.wikipedia.org/wiki/Egyptian_hieroglyphs", "wikipedia_extract": "Ancient Egyptian hieroglyphs ( HY-roh-glifs) were the formal writing system used in Ancient Egypt for writing the Egyptian language. Hieroglyphs combined ideographic, logographic, syllabic, and alphabetic elements, with more than 1,000 distinct characters. Cursive hieroglyphs were used for religious literature on papyrus and wood. The later hieratic and demotic Egyptian scripts were derived from hieroglyphic writing, as was the Proto-Sinaitic script that later evolved into the Phoenician alphabet. Egyptian hieroglyphs are the ultimate ancestor of the Phoenician alphabet, the first widely adopted phonetic writing system. Moreover, owing in large part to the Greek and Aramaic scripts that descended from Phoenician, the majority of the world's living writing systems are descendants of Egyptian hieroglyphs—most prominently the Latin and Cyrillic scripts through Greek, and the Arabic and Brahmic scripts through Aramaic."}}, {"canonical_name": "Alaunerde", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "alaunerde", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Alaunerde", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Alaunerde"], "contexts": ["substance mentioned in footnote"]}, {"entity_id": "alauveluna", "book_id": "polyanthea_medicinal", "name": "Alauveluna", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Alauveluna"], "contexts": ["unidentified substance mentioned by Schroderus"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Alaunerde", "target_book": "polyanthea_medicinal", "target_name": "Alauveluna", "similarity": 0.845}], "id": 1946, "stable_key": "clu_7241ac3b1d1d6dff", "ground_truth": {"modern_name": "Unidentified substance", "confidence": "low", "type": "chemical", "note": "Both 'Alaunerde' and 'Alauveluna' appear to be obscure or misidentified substances, possibly alchemical. Without further context or clear etymology, they remain unidentified.", "wikipedia_extract": "In spiritualism, ectoplasm, also known as simply ecto, is a substance or spiritual energy \"exteriorized\" by physical mediums. It was coined in 1894 by psychical researcher Charles Richet. Although the term is widespread in popular culture, there is no scientific evidence that ectoplasm exists and many purported examples were exposed as hoaxes fashioned from cheesecloth, gauze or other natural substances. The term comes from the Ancient Greek words ἐκτός ektos, \"outside\" and πλάσμα plasma, \"something formed\". In Spiritualism, ectoplasm is said to be formed by physical mediums when in a trance state. This material is excreted as a gauze-like substance from orifices on the medium's body and spiritual entities are said to drape this substance over their nonphysical body, enabling them to interact in the physical and real universe.", "wikipedia_url": "https://en.wikipedia.org/wiki/Ectoplasm_(paranormal)"}}, {"canonical_name": "Mom.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mom_", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mom.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Mom."], "contexts": ["column header for moments or deaths"]}, {"entity_id": "mom_intern_", "book_id": "polyanthea_medicinal", "name": "Mom.intern.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Mom.intern."], "contexts": ["internal medicine"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mom.", "target_book": "polyanthea_medicinal", "target_name": "Mom.intern.", "similarity": 0.881}], "id": 1947, "stable_key": "clu_6060d19b6969d60b", "ground_truth": {"modern_name": "Moments", "confidence": "medium", "type": "concept", "note": "The terms 'Mom.' and 'Mom.intern.' are highly abbreviated and context-dependent. 'Mom.' could refer to 'moments' in a scientific or statistical sense, or a header for deaths ('momento'). 'Mom.intern.' might relate to internal medicine. Given the ambiguity, 'Moments' is a general interpretation."}}, {"canonical_name": "Arinda", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "arinda", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Arinda", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Arinda"], "contexts": ["military post"]}, {"entity_id": "arandilla", "book_id": "polyanthea_medicinal", "name": "Arandilla", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Arandilla"], "contexts": ["name of springs with clear water"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Arinda", "target_book": "polyanthea_medicinal", "target_name": "Arandilla", "similarity": 0.847}], "id": 1948, "stable_key": "clu_d916b911b0e856be", "ground_truth": {"modern_name": "Aranda", "confidence": "medium", "type": "place", "country": "Spain", "note": " 'Arinda' and 'Arandilla' are similar sounding. Aranda de Duero is a prominent Spanish town with historical significance. The context of 'military post' and 'springs' could apply to various locations, but Aranda is a plausible referent."}}, {"canonical_name": "bacalao", "category": "ANIMAL", "subcategory": "FISH", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bacalao", "book_id": "relation_historique_humboldt_vol3_1825", "name": "bacalao", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["bacalao"], "contexts": ["salted cod"]}, {"entity_id": "bacalhao", "book_id": "polyanthea_medicinal", "name": "bacalhao", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["bacalhao"], "contexts": ["codfish"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "bacalao", "target_book": "polyanthea_medicinal", "target_name": "bacalhao", "similarity": 0.846}], "id": 1949, "stable_key": "clu_9f0321200f34be94", "ground_truth": {"modern_name": "Cod", "confidence": "high", "type": "animal", "note": "'Bacalao' (Spanish) and 'bacalhao' (Portuguese) both refer to cod, particularly salted cod, which was a significant commodity in early modern trade and diet.", "wikidata_id": "Q2914812", "wikidata_description": "condition of suffering from a mental illness and a comorbid substance abuse problem"}}, {"canonical_name": "Siara", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "siara", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Siara", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Siara"], "contexts": ["location for heat observations"]}, {"entity_id": "syra", "book_id": "polyanthea_medicinal", "name": "Syra", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Syra"], "contexts": ["Ancient Greek city"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Siara", "target_book": "polyanthea_medicinal", "target_name": "Syra", "similarity": 0.864}], "id": 1950, "stable_key": "clu_754d7ccedd1e41ef", "ground_truth": {"modern_name": "Syracuse", "confidence": "medium", "type": "place", "country": "Italy", "note": "The spelling 'Siara' and 'Syra' are likely phonetic variations or misinterpretations of Syracuse, given the context of ancient Greek cities and heat observations.", "wikidata_id": "Q128069", "wikidata_description": "city in and county seat of Onondaga County, New York, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Syracuse,_New_York", "wikipedia_extract": "Syracuse ( SIRR-ə-kewz, SERR-, -⁠kewss) is a city in New York, United States, and the county seat of Onondaga County. With a population of 148,620 and a metropolitan area of 662,057, it is the fifth-most populated city and 13th-most populated municipality in the state of New York. Formally established in 1820, Syracuse was named after the classical Greek city of Syracuse (Siracusa in Italian), located on the eastern coast of the Italian island of Sicily, for its similar natural features. Adjacent brine springs made the city a major producer of commercial salt into the late 19th century, earning the nickname \"The Salt City\"; it subsequently became a major industrial center until the mid-20th century, and has since been a hub for higher education, research, and services. Syracuse has historically functioned as a major crossroads in the state, first between the Erie Canal and its branches, then of the New York Central Railroad network established in the mid 19th century. Today, the city is at the intersection of Interstates 81 and 90, and its airport is the largest in Central New York, a five-county region of over one million inhabitants."}}, {"canonical_name": "Aljiusi", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "aljiusi", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Aljiusi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Aljiusi"], "contexts": ["lieu"]}, {"entity_id": "aljezur", "book_id": "polyanthea_medicinal", "name": "Aljezur", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Aljezur"], "contexts": ["Commendas de Aljezur"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Aljiusi", "target_book": "polyanthea_medicinal", "target_name": "Aljezur", "similarity": 0.856}], "id": 1951, "stable_key": "clu_cf9c040fdf747062", "ground_truth": {"modern_name": "Aljezur", "confidence": "high", "type": "place", "country": "Portugal", "wikidata_id": "Q4062205", "wikidata_description": "river in Portugal", "wikipedia_url": "https://en.wikipedia.org/wiki/Aljezur_River", "wikipedia_extract": "Carrapateira is a village on the western coast of the Algarve, Portugal. Administratively, it is part of the civil parish of Bordeira, within the municipality of Aljezur, in the Faro District. Its landmarks include an old fort and a church. The nearby beaches are a popular surfing destination. Carrapateira lies  35.6 kilometres (22.1 mi) by road northwest of Lagos and 110 kilometres (68 mi) northwest of Faro. It is located along the N268 road."}}, {"canonical_name": "Kiel", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "kiel", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Kiel", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Kiel"], "contexts": ["city connected by a canal"]}, {"entity_id": "kiel", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Kiel", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Kiel"], "contexts": ["city where Brorsen discovered a comet"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Kiel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kiel", "similarity": 1.0}], "id": 1952, "stable_key": "clu_82265306ac1f74b8", "ground_truth": {"modern_name": "Kiel", "confidence": "high", "type": "place", "country": "Germany", "wikidata_id": "Q1707", "wikidata_description": "German city, capital of Schleswig-Holstein", "wikipedia_url": "https://en.wikipedia.org/wiki/Kiel", "wikipedia_extract": "THW Kiel is a professional handball club from Kiel, Germany. The club competes in the Handball-Bundesliga and is the record champion with 23 titles. 2007 and 2012 were the most successful years in the club's history, as THW completed the treble, winning the domestic league, the domestic cup, and the EHF Champions League. In 2012, the team won every league game, a first in any top-flight German team sports. They ended the 2019–20 season as winners of the EHF Champions League and champions of the Handball-Bundesliga. Since then, they have secured additional league titles in 2021 and 2023, along with the DHB-Pokal in 2025."}}, {"canonical_name": "Mer du Bengal", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mer_du_bengal", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mer du Bengal", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Mer du Bengal"], "contexts": ["sea south of an island"]}, {"entity_id": "bay_of_bengal", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bay of Bengal", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Bay of Bengal"], "contexts": ["northern part of the Indian Ocean"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mer du Bengal", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bay of Bengal", "similarity": 0.931}], "id": 1953, "stable_key": "clu_359c466363f82ffa", "ground_truth": {"modern_name": "Bay of Bengal", "confidence": "high", "type": "place", "country": "India", "wikidata_id": "Q107540080", "wikidata_description": "bio-geographic province in MEOW scheme", "wikipedia_extract": "The Tampa Bay Buccaneers (colloquially known as the Bucs) are a professional American football team based in Tampa, Florida. The Buccaneers compete in the National Football League (NFL) as a member of the National Football Conference (NFC) South division. They joined the NFL in 1974 as an expansion team, along with the Seattle Seahawks, and played their first season in 1976 as a member of the American Football Conference (AFC) West division. Before the 1977 season, Tampa Bay switched conferences and divisions with Seattle, becoming a member of the NFC Central division. The Seahawks eventually rejoined the NFC in 2002, meaning the Buccaneers joined the Cleveland Browns, Pittsburgh Steelers, and Baltimore/Indianapolis Colts as the only NFL teams not playing in their original conference. As a result of the league's realignment before the 2002 season, the Buccaneers joined three former NFC West teams to form the NFC South.", "wikipedia_url": "https://en.wikipedia.org/wiki/Tampa_Bay_Buccaneers"}}, {"canonical_name": "dilatation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dilatation", "book_id": "relation_historique_humboldt_vol3_1825", "name": "dilatation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dilatation"], "contexts": ["process of expanding"]}, {"entity_id": "dilatations", "book_id": "connexion_physical_sciences_somerville_1858", "name": "dilatations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dilatations"], "contexts": ["regions of decreased pressure in a fluid"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "dilatation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "dilatations", "similarity": 0.972}], "id": 1954, "stable_key": "clu_ddf57abc6b673bf1", "ground_truth": {"modern_name": "Dilatation", "confidence": "high", "type": "concept", "wikidata_id": "Q73228459", "wikidata_description": "act of dilating as a biomedical investigative technique"}}, {"canonical_name": "Dabayba", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dabayba", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Dabayba", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Dabayba"], "contexts": ["former name of the Atrato river"]}, {"entity_id": "daba", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Daba", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Daba"], "contexts": ["location on Moorcroft's route"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Dabayba", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Daba", "similarity": 0.9}], "id": 1955, "stable_key": "clu_571f29e970444b8e", "ground_truth": {"modern_name": "Daba River", "confidence": "medium", "type": "place", "country": "Colombia", "note": "While 'Atrato river' is mentioned, 'Dabayba' and 'Daba' could refer to a specific section or tributary, or a historical name associated with it."}}, {"canonical_name": "couches concentriques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "couches_concentriques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "couches concentriques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["couches concentriques"], "contexts": ["concentric layers in sandstone balls"]}, {"entity_id": "concentric_elliptical_strata", "book_id": "connexion_physical_sciences_somerville_1858", "name": "concentric elliptical strata", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["concentric elliptical strata"], "contexts": ["layers with same center and elliptical form"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "couches concentriques", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "concentric elliptical strata", "similarity": 0.892}], "id": 1956, "stable_key": "clu_d1d9ece19fb995a0", "ground_truth": {"modern_name": "Concentric Strata", "confidence": "high", "type": "concept", "wikipedia_extract": "The Richat Structure, or Guelb er Richât (Arabic: قلب الريشات, romanized: Qalb ar-Rīšāt, Hassaniyya: [galb er.riːʃaːt] ), often called the Eye of Africa is a prominent circular geological feature at the northwestern edge of the Taoudeni Basin, on the Adrar Plateau of the Sahara. It is located near Ouadane in the Adrar Region of Mauritania. In Hassaniya Arabic, rīšāt means feathers and it is also known locally in Arabic as tagense, referring to the circular opening of the leather pouch that is used to draw water from local wells. It is an eroded geological dome, 40 kilometres (25 mi) in diameter, caused by a subsurface igneous intrusion deforming the overlying sedimentary rock layers, causing the rock to be exposed as concentric rings with the oldest layers exposed at the centre of the structure. Igneous rock is exposed inside and there are rhyolites and gabbros that have undergone hydrothermal alteration, and a central megabreccia. The structure is also the location of exceptional accumulations of Acheulean Paleolithic stone tools.", "wikipedia_url": "https://en.wikipedia.org/wiki/Richat_Structure"}}, {"canonical_name": "Cataracte de Rentema", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cataracte_de_rentema", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cataracte de Rentema", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cataracte de Rentema"], "contexts": ["cataracte"]}, {"entity_id": "cataract", "book_id": "connexion_physical_sciences_somerville_1858", "name": "cataract", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["cataract"], "contexts": ["roar of the cataract"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cataracte de Rentema", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "cataract", "similarity": 0.867}], "id": 1957, "stable_key": "clu_27f9871fd0e5d0ed", "ground_truth": {"modern_name": "Rentema Cataract", "confidence": "medium", "type": "place", "country": "Unknown", "note": "The specific location of 'Rentema Cataract' is difficult to pinpoint without further context from the cited texts. 'Catacract' alone is too general."}}, {"canonical_name": "Euler", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "euler", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Euler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Euler"], "contexts": ["theorist of magnetic inclination"]}, {"entity_id": "euler", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Euler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Euler"], "contexts": ["proved conditions for solar system stability"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Euler", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Euler", "similarity": 1.0}], "id": 1958, "stable_key": "clu_5aea78bbfc11047e", "ground_truth": {"modern_name": "Leonhard Euler", "confidence": "high", "type": "person", "birth_year": 1707, "death_year": 1783, "description": "Swiss mathematician and physicist, pioneer of calculus.", "wikidata_id": "Q751290", "wikidata_description": "three angles introduced by Leonhard Euler to describe the orientation of a rigid body with respect to a fixed coordinate system", "wikipedia_url": "https://en.wikipedia.org/wiki/Euler_angles", "wikipedia_extract": "The Euler angles are three angles introduced by Leonhard Euler to describe the orientation of a rigid body with respect to a fixed coordinate system. They can also represent the orientation of a mobile frame of reference in physics or the orientation of a general basis in  three dimensional linear algebra. Classic Euler angles usually take the inclination angle in such a way that zero degrees represent the vertical orientation. Alternative forms were later introduced by Peter Guthrie Tait and George H. Bryan intended for use in aeronautics and engineering in which zero degrees represent the horizontal position. Euler angles can be defined by elemental geometry or by composition of rotations (i.e."}}, {"canonical_name": "lois immuables", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "lois_immuables", "book_id": "relation_historique_humboldt_vol3_1825", "name": "lois immuables", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["lois immuables"], "contexts": ["unchangeable natural laws"]}, {"entity_id": "unchangeable_laws", "book_id": "first_principles_spencer_1862", "name": "unchangeable laws", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["unchangeable laws"], "contexts": ["laws that do not change over time"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "lois immuables", "target_book": "first_principles_spencer_1862", "target_name": "unchangeable laws", "similarity": 0.951}], "id": 1959, "stable_key": "clu_9038e32ac9e223fe", "ground_truth": {"modern_name": "Immutable laws", "confidence": "high", "type": "concept", "note": "The term 'lois immuables' and 'unchangeable laws' refers to the concept of universal and eternal natural laws that govern the universe.", "wikidata_id": "Q29524", "wikidata_description": "system of law that is purportedly determined by nature, and is thus universal", "wikipedia_url": "https://en.wikipedia.org/wiki/Natural_law", "wikipedia_extract": "Natural law (Latin: ius naturale, lex naturalis) is a philosophical and legal theory that posits the existence of inherent laws derived from nature and universal moral principles that are discoverable through reason. In ethics, natural law theory asserts that certain rights and moral values are inherent in human nature and can be universally understood, independent of enacted laws or societal norms. In jurisprudence, natural law—sometimes referred to as iusnaturalism or jusnaturalism—holds that there are objective legal standards based on morality that underlie the creation, interpretation, and application of human-made laws. This contrasts with positive law (as in legal positivism), which emphasizes that laws are rules created by human authorities and are not necessarily connected to moral principles. Natural law can refer to \"theories of ethics, theories of politics, theories of civil law, and theories of religious morality\", depending on the context in which naturally-grounded practical principles are claimed to exist. In the Western tradition, natural law was anticipated by the pre-Socratics, for example, in their search for principles that governed the cosmos and human beings."}}, {"canonical_name": "canaux subsidiaires", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "canaux_subsidiaires", "book_id": "relation_historique_humboldt_vol3_1825", "name": "canaux subsidiaires", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["canaux subsidiaires"], "contexts": ["secondary canals"]}, {"entity_id": "canals", "book_id": "first_principles_spencer_1862", "name": "canals", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["canals"], "contexts": ["waterways for transport"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "canaux subsidiaires", "target_book": "first_principles_spencer_1862", "target_name": "canals", "similarity": 0.858}], "id": 1960, "stable_key": "clu_2dada6a4eac00b0e", "ground_truth": {"modern_name": "Canals", "confidence": "high", "type": "object", "note": "'Canaux subsidiaires' and 'canals' refer to artificial waterways for transport or irrigation.", "wikidata_id": "Q28256583", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Canal%20%28surname%29"}}, {"canonical_name": "WATER", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "water", "book_id": "relation_historique_humboldt_vol3_1825", "name": "WATER", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["WATER"], "contexts": ["observer's name"]}, {"entity_id": "water-spirits", "book_id": "first_principles_spencer_1862", "name": "water-spirits", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["water-spirits"], "contexts": ["mythical beings associated with water"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "WATER", "target_book": "first_principles_spencer_1862", "target_name": "water-spirits", "similarity": 0.828}], "id": 1961, "stable_key": "clu_70074bb994cb47f1", "ground_truth": {"modern_name": "Water spirits", "confidence": "low", "type": "concept", "note": "The association of 'WATER' as a person in one instance and 'water-spirits' in another suggests a conceptual or mythological entity rather than a specific person. Given the context of 'observer's name' and 'mythical beings associated with water', 'water spirits' is the most fitting interpretation.", "wikidata_id": "Q1936706", "wikidata_description": "elemental spirit associated with water", "wikipedia_extract": "A jengu (pl. miengu, also called bisima) is a water spirit in the traditional beliefs of the Sawabantu groups of Cameroon, like the Duala, Bakweri, Malimba, Subu, Bakoko, and Oroko people. Among the Bakweri, the term used is liengu (plural: maengu). Miengu are similar to bisimbi (singular: simbi) in the Bakongo spirituality and Mamba Muntu, who is present in many West and Central African cultures. Described as mermaid-like spirits, they live in rivers and the sea, bringing good fortune to those who worship them. They can also cure disease and act as intermediaries between worshippers and the world of spirits.", "wikipedia_url": "https://en.wikipedia.org/wiki/Jengu"}}, {"canonical_name": "Expedicnle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "expedicnle", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Expedicnle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Expedicnle"], "contexts": ["part of a citation"]}, {"entity_id": "expediency", "book_id": "first_principles_spencer_1862", "name": "expediency", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["expediency"], "contexts": ["practical usefulness in action"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Expedicnle", "target_book": "first_principles_spencer_1862", "target_name": "expediency", "similarity": 0.863}], "id": 1962, "stable_key": "clu_d25ed28d803d3083", "ground_truth": {"modern_name": "Expediency", "confidence": "high", "type": "concept", "note": "'Expedicnle' is likely an OCR error for 'expedience' or 'expediency', referring to practical usefulness.", "wikidata_id": "Q1296024", "wikidata_description": "capability of producing a desired result or the ability to produce desired output, giving an intended or expected outcome, or produce a deep, vivid impression", "wikipedia_extract": "Expedition Island, a park in Green River, Wyoming, US Expedition Range, a mountain range in Queensland, Australia Expedition, a Pokémon Trading Card Game set Expeditions (board game), a sequel to the board game Scythe Expeditions: Conquistador, a 2013 video game, first of the Expeditions series Expeditions (poetry collection), by Margaret Atwood Expedition (book), a science-fiction novel by Wayne Douglas Barlowe Expedition Magazine, published by Penn Museum L'Expédition, a volume of the French science fiction comic series Les Mondes d'Aldébaran L'expédition, a novel by Agnès Desarthe \"Expedition\", a song by Sara Groves from the album Floodplain L'expédition, a 2008 album by Les Cowboys Fringants Northern Exposure: Expeditions, a 1999 album by Sasha and John Digweed The Expedition, a 2000 live album by Kamelot Expedition!", "wikipedia_url": "https://en.wikipedia.org/wiki/Expedition"}}, {"canonical_name": "épicycles", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "épicycles", "book_id": "relation_historique_humboldt_vol3_1825", "name": "épicycles", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["épicycles"], "contexts": ["celestial mechanics concept"]}, {"entity_id": "epicycles", "book_id": "first_principles_spencer_1862", "name": "epicycles", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["epicycles"], "contexts": ["circles used in ancient astronomical models"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "épicycles", "target_book": "first_principles_spencer_1862", "target_name": "epicycles", "similarity": 0.909}], "id": 1963, "stable_key": "clu_663e80ad56c41de7", "ground_truth": {"modern_name": "Epicycles", "confidence": "high", "type": "concept"}}, {"canonical_name": "Comparative Anatomy and Dissection of Mammalia", "category": "ORGANIZATION", "subcategory": "JOURNAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "comparative_anatomy_and_dissection_of_mammalia", "book_id": "principles_of_psychology_james_1890", "name": "Comparative Anatomy and Dissection of Mammalia", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Comparative Anatomy and Dissection of Mammalia"], "contexts": ["book on mammalian anatomy"]}, {"entity_id": "recueil_d'observations_de_zoologie_et_d'anatomie_comparee", "book_id": "kosmos_humboldt_1845", "name": "Recueil d'Observations de Zoologie et d'Anatomie Comparee", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Recueil d'Observations de Zoologie et d'Anatomie Comparee"], "contexts": ["scientific publication"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Comparative Anatomy and Dissection of Mammalia", "target_book": "kosmos_humboldt_1845", "target_name": "Recueil d'Observations de Zoologie et d'Anatomie Comparee", "similarity": 0.843}], "id": 1964, "stable_key": "clu_d11af095c723846b", "ground_truth": {"modern_name": "Recueil d'observations de zoologie et d'anatomie comparée", "confidence": "high", "type": "text", "note": "This refers to a specific scientific publication.", "wikidata_id": "Q56916628", "wikidata_description": "publication in 2 volumes and 14 livraisons (1805–1833)", "wikipedia_extract": "Sir William Henry Flower  (30 November 1831 – 1 July 1899) was an English surgeon, museum curator  and comparative anatomist, who became a leading authority on mammals and especially on the primate brain. He supported Thomas Henry Huxley in an important controversy with Richard Owen about the human brain and eventually succeeded Owen as Director of the Natural History Museum in London. Born on 30 November 1831 in his father's house at Stratford-upon-Avon in Warwickshire, he was the second son of Edward Fordham Flower, founder of the town brewery, and his wife Celina Greaves (1804‍–‍1884), eldest daughter of John Greaves and his wife Mary Whitehead. His paternal grandfather Richard Flower had married Elizabeth Fordham on 24 Dec 1786 in St Andrew's Church, Newcastle upon Tyne, and settled at Albion, Illinois, where their children grew up. His uncles included the slate entrepreneur John Whitehead Greaves and William Pickering, Governor of Washington. His elder brother Charles Edward Flower ran the family brewery with the third brother Edgar Flower, while he chose a scientific career.", "wikipedia_url": "https://en.wikipedia.org/wiki/William_Henry_Flower"}}, {"canonical_name": "Belfast", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "belfast", "book_id": "principles_of_psychology_james_1890", "name": "Belfast", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Belfast"], "contexts": ["location of Tyndall's address"]}, {"entity_id": "belfast", "book_id": "kosmos_humboldt_1845", "name": "Belfast", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Belfast"], "contexts": ["location with basaltic veins traversing chalk"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Belfast", "target_book": "kosmos_humboldt_1845", "target_name": "Belfast", "similarity": 1.0}], "id": 1965, "stable_key": "clu_cbfb91f4e55b6cd5", "ground_truth": {"modern_name": "Belfast", "confidence": "high", "type": "place", "country": "United Kingdom", "wikipedia_extract": "The Belfast Blitz consisted of four German air raids on strategic targets in the city of Belfast in Northern Ireland, in April and May 1941 during World War II, causing high casualties. The first was on the night of 7–8 April 1941, a small attack which probably took place only to test Belfast's defences. The next took place on Easter Tuesday, 15 April 1941, when 200 Luftwaffe bombers attacked military and manufacturing targets in the city of Belfast. Some 987 people died as a result of the bombing and 1,500 were injured. High explosive bombs predominated in this raid. Apart from those on London, this was the greatest loss of life in any night raid during the Blitz.", "wikipedia_url": "https://en.wikipedia.org/wiki/Belfast_Blitz"}}, {"canonical_name": "empirical law", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "empirical_law", "book_id": "principles_of_psychology_james_1890", "name": "empirical law", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["empirical law"], "contexts": ["law based on observation and experience"]}, {"entity_id": "empirical_laws", "book_id": "kosmos_humboldt_1845", "name": "empirical laws", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["empirical laws"], "contexts": ["laws derived from observation and experiment"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "empirical law", "target_book": "kosmos_humboldt_1845", "target_name": "empirical laws", "similarity": 0.973}], "id": 1966, "stable_key": "clu_c64472f0b1f07754", "ground_truth": {"modern_name": "Empirical law", "confidence": "high", "type": "concept", "wikidata_id": "Q3258494", "wikidata_description": "law or formula deduced from experimental facts, or validated by experience", "wikipedia_extract": "Zipf's law () is an empirical law stating that when a set of measured values is sorted in decreasing order, the value of the n-th entry is often approximately inversely proportional to n. The best-known instance of Zipf’s law applies to the frequency distribution of words in a text or corpus of natural language: {\\displaystyle \\ {\\mathsf {word\\ frequency}}\\ \\propto \\ {\\frac {1}{\\ {\\mathsf {word\\ rank}}\\ }}~.} It is usually found that the most common word occurs approximately twice as often as the next common one, three times as often as the third most common, and so on. For example, in the Brown Corpus of American English text, the word \"the\" is the most frequently occurring word, and by itself accounts for nearly 7% of all word occurrences (69,971 out of slightly over 1 million). True to Zipf's law, the second-place word \"of\" accounts for slightly over 3.5% of words (36,411 occurrences), followed by \"and\" (28,852).", "wikipedia_url": "https://en.wikipedia.org/wiki/Zipf's_law"}}, {"canonical_name": "scenes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "scenes", "book_id": "principles_of_psychology_james_1890", "name": "scenes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["scenes"], "contexts": ["visual experiences"]}, {"entity_id": "scenery", "book_id": "kosmos_humboldt_1845", "name": "scenery", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["scenery"], "contexts": ["visual appearance of landscape"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "scenes", "target_book": "kosmos_humboldt_1845", "target_name": "scenery", "similarity": 0.869}], "id": 1967, "stable_key": "clu_e3d44815f3097b35", "ground_truth": {"modern_name": "Scene", "confidence": "high", "type": "concept", "wikidata_id": "Q28431605", "wikidata_description": "species of green algae", "wikipedia_url": "https://en.wikipedia.org/wiki/Scene_(subculture)", "wikipedia_extract": "The scene subculture is a youth subculture that emerged during the early 2000s in the United States from the pre-existing emo subculture. The subculture became popular with adolescents from the mid 2000s to the early 2010s. Members of the scene subculture are referred to as scene kids, trendies, or scenesters. Scene fashion consists of skinny jeans, bright-colored clothing, a signature hairstyle consisting of straight, flat hair with long bangs covering the forehead, and bright-colored hair dye. Music genres associated with the scene subculture include metalcore, crunkcore, deathcore, electronic music, and pop punk. From the mid-2000s to early 2010s, scene fashion gained popularity among teens and the music associated with the subculture achieved commercial success in both the underground and the mainstream."}}, {"canonical_name": "major premiss", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "major_premiss", "book_id": "principles_of_psychology_james_1890", "name": "major premiss", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["major premiss"], "contexts": ["first or principal premise of a syllogism"]}, {"entity_id": "major_axis", "book_id": "kosmos_humboldt_1845", "name": "major axis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["major axis"], "contexts": ["longest diameter of an ellipse"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "major premiss", "target_book": "kosmos_humboldt_1845", "target_name": "major axis", "similarity": 0.851}], "id": 1968, "stable_key": "clu_83e5c23e12262629", "ground_truth": {"modern_name": "Major premise", "confidence": "high", "type": "concept", "note": "While 'major premise' is a logical term, 'major axis' is geometric. The cluster groups them under 'OTHER_CONCEPT'."}}, {"canonical_name": "bodily warmth", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bodily_warmth", "book_id": "principles_of_psychology_james_1890", "name": "bodily warmth", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["bodily warmth"], "contexts": ["sensation of heat from a body"]}, {"entity_id": "bodily_heat", "book_id": "first_principles_spencer_1862", "name": "bodily heat", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["bodily heat"], "contexts": ["internal temperature of the body"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "bodily warmth", "target_book": "first_principles_spencer_1862", "target_name": "bodily heat", "similarity": 0.972}], "id": 1969, "stable_key": "clu_17e866c82afeda3e", "ground_truth": {"modern_name": "Body heat", "confidence": "high", "type": "concept", "wikidata_id": "Q34249508", "wikidata_description": "heat released from the bodies of animals, including humans, produced by physical and metabolic activity", "wikipedia_extract": "This is a list of the main systems of the human body, including organ systems. An organ system is a group of organs that work together to perform major functions or meet physiological needs of the body. There are 11 to 12 distinct organ systems. The endocrine and exocrine systems are sometimes referred to jointly as the endocrine system.", "wikipedia_url": "https://en.wikipedia.org/wiki/List_of_systems_of_the_human_body"}}, {"canonical_name": "experimental measurement", "category": "PRACTICE", "subcategory": "OTHER_PRACTICE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "experimental_measurement", "book_id": "principles_of_psychology_james_1890", "name": "experimental measurement", "category": "PRACTICE", "subcategory": "OTHER_PRACTICE", "count": 1, "variants": ["experimental measurement"], "contexts": ["measuring phenomena through experiments"]}, {"entity_id": "barometric_experiments", "book_id": "kosmos_humboldt_1845", "name": "barometric experiments", "category": "PRACTICE", "subcategory": "OTHER_PRACTICE", "count": 1, "variants": ["barometric experiments"], "contexts": ["scientific experiments with barometer"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "experimental measurement", "target_book": "kosmos_humboldt_1845", "target_name": "barometric experiments", "similarity": 0.875}], "id": 1970, "stable_key": "clu_8906e82ddbc1f41a", "ground_truth": {"modern_name": "Experimental measurement", "confidence": "high", "type": "concept", "wikipedia_extract": "Measurement is the quantification of attributes of an object or event, which can be used to compare with other objects or events. In other words, measurement is a process of determining how large or small a physical quantity is as compared to a basic reference quantity of the same kind. The scope and application of measurement are dependent on the context and discipline. In natural sciences and engineering, measurements do not apply to nominal properties of objects or events, which is consistent with the guidelines of the International Vocabulary of Metrology (VIM) published by the International Bureau of Weights and Measures (BIPM). However, in other fields such as statistics as well as the social and behavioural sciences, measurements can have multiple levels, which would include nominal, ordinal, interval and ratio scales. Measurement is a cornerstone of trade, science, technology and quantitative research in many disciplines.", "wikipedia_url": "https://en.wikipedia.org/wiki/Measurement"}}, {"canonical_name": "measurement", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "measurement", "book_id": "principles_of_psychology_james_1890", "name": "measurement", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["measurement"], "contexts": ["process of quantifying magnitudes"]}, {"entity_id": "measurements", "book_id": "kosmos_humboldt_1845", "name": "measurements", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["measurements"], "contexts": ["process of determining quantities"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "measurement", "target_book": "kosmos_humboldt_1845", "target_name": "measurements", "similarity": 0.986}], "id": 1971, "stable_key": "clu_fefae37f6b212f16", "ground_truth": {"modern_name": "Measurement", "confidence": "high", "type": "concept", "wikidata_id": "Q12453", "wikidata_description": "process of assigning quantities to objects or events", "wikipedia_extract": "Measurement is the quantification of attributes of an object or event, which can be used to compare with other objects or events. In other words, measurement is a process of determining how large or small a physical quantity is as compared to a basic reference quantity of the same kind. The scope and application of measurement are dependent on the context and discipline. In natural sciences and engineering, measurements do not apply to nominal properties of objects or events, which is consistent with the guidelines of the International Vocabulary of Metrology (VIM) published by the International Bureau of Weights and Measures (BIPM). However, in other fields such as statistics as well as the social and behavioural sciences, measurements can have multiple levels, which would include nominal, ordinal, interval and ratio scales. Measurement is a cornerstone of trade, science, technology and quantitative research in many disciplines.", "wikipedia_url": "https://en.wikipedia.org/wiki/Measurement"}}, {"canonical_name": "Dobrowolsky", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dobrowolsky", "book_id": "principles_of_psychology_james_1890", "name": "Dobrowolsky", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Dobrowolsky"], "contexts": ["observer of color differences"]}, {"entity_id": "dobrowsky", "book_id": "kosmos_humboldt_1845", "name": "Dobrowsky", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Dobrowsky"], "contexts": ["editor of Bohemian historical texts"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Dobrowolsky", "target_book": "kosmos_humboldt_1845", "target_name": "Dobrowsky", "similarity": 0.964}], "id": 1972, "stable_key": "clu_d2ff2c9c006019f6", "ground_truth": {"modern_name": "Dobrowolsky", "confidence": "low", "type": "person", "description": "Observer of color differences and editor of historical texts.", "note": "The identity of 'Dobrowolsky'/'Dobrowsky' is not clearly identifiable without further context from the specific texts.", "wikidata_id": "Q106067944", "wikidata_description": "family name", "wikipedia_extract": "An induction motor or asynchronous motor is an AC electric motor in which the electric current in the rotor that produces torque is obtained by electromagnetic induction from the magnetic field of the stator winding. An induction motor therefore needs no electrical connections to the rotor. An induction motor's rotor can be either wound type or squirrel-cage type. Three-phase squirrel-cage induction motors are widely used as industrial drives because they are self-starting, reliable, and economical. Single-phase induction motors are used extensively for smaller loads, such as garbage disposals and stationary power tools. Although traditionally used for constant-speed service, single- and three-phase induction motors are increasingly being installed in variable-speed applications using variable-frequency drives (VFD).", "wikipedia_url": "https://en.wikipedia.org/wiki/Induction_motor"}}, {"canonical_name": "Cyclops", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cyclops", "book_id": "principles_of_psychology_james_1890", "name": "Cyclops", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Cyclops"], "contexts": ["mythological one-eyed giants"]}, {"entity_id": "cyclidiae", "book_id": "kosmos_humboldt_1845", "name": "Cyclidiae", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Cyclidiae"], "contexts": ["animated life in oceanic depths"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Cyclops", "target_book": "kosmos_humboldt_1845", "target_name": "Cyclidiae", "similarity": 0.871}], "id": 1973, "stable_key": "clu_b1f4c4dc77505b93", "ground_truth": {"modern_name": "Cyclops", "confidence": "low", "type": "animal", "note": "The 'Cyclops' is a mythological creature, while 'Cyclidiae' refers to a genus of copepods. The clustering is weak.", "wikidata_id": "Q1421606", "wikidata_description": "genus of copepods", "wikipedia_extract": "USS Cyclops (AC-4) was the second of four Proteus-class colliers built for the United States Navy several years before World War I. Named after the Cyclops, a race of giants from Greek mythology, she was the second U.S. naval vessel to bear the name. The loss of the ship and 306 crew and passengers without a trace occurred sometime after 4 March 1918. As the loss occurred during World War I, she was thought to have been captured or sunk by a German raider or submarine because she was carrying 10,800 long tons (10,973 t) of manganese ore used to produce munitions, but German authorities at the time subsequently denied any knowledge of the vessel. The Naval History & Heritage Command has stated she \"probably sank in an unexpected storm\", but the cause of the ship's loss is not known.", "wikipedia_url": "https://en.wikipedia.org/wiki/USS_Cyclops"}}, {"canonical_name": "1867", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "1867", "book_id": "principles_of_psychology_james_1890", "name": "1867", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["1867"], "contexts": ["year of early work"]}, {"entity_id": "1870", "book_id": "coloquios_da_orta_1563", "name": "1870", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["1870"], "contexts": ["year of botanical description"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "1867", "target_book": "coloquios_da_orta_1563", "target_name": "1870", "similarity": 0.904}], "id": 1974, "stable_key": "clu_9289bc2fde9ca718", "ground_truth": {"modern_name": "year", "confidence": "high", "type": "concept", "note": "The numbers '1867' and '1870' clearly refer to specific years, used in the context of historical dates for scientific works.", "wikidata_id": "Q577", "wikidata_description": "the orbital period of the Earth: the estimated period of time for the Earth's orbit around the Sun and observed at a fixed geographic point (averaging 365.24 days); base later modified to define or adjust various calendars", "wikipedia_url": "https://en.wikipedia.org/wiki/Year", "wikipedia_extract": "A year is a unit of time based on how long it takes the Earth to orbit the Sun. In scientific use, the tropical year (approximately 365 solar days, 5 hours, 48 minutes, 45 seconds) and the sidereal year (about 20 minutes longer) are more exact. The modern calendar year, as reckoned according to the Gregorian calendar, approximates the tropical year by using a system of leap years. The term 'year' is also used to indicate other periods of roughly similar duration, such as the lunar year (a roughly 354-day cycle of twelve of the Moon's phases – see lunar calendar), as well as periods loosely associated with the calendar or astronomical year, such as the seasonal year, the fiscal year, the academic year, etc. Due to the Earth's axial tilt, the course of a year sees the passing of the seasons, marked by changes in weather, the hours of daylight, and, consequently, vegetation and soil fertility. In temperate and subpolar regions around the planet, four seasons are generally recognized: spring, summer, autumn, and winter."}}, {"canonical_name": "metempsychosis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "metempsychosis", "book_id": "principles_of_psychology_james_1890", "name": "metempsychosis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["metempsychosis"], "contexts": ["philosophical doctrine of soul transmigration"]}, {"entity_id": "metempsychose_grega", "book_id": "coloquios_da_orta_1563", "name": "metempsychose grega", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["metempsychose grega"], "contexts": ["Greek concept of transformation"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "metempsychosis", "target_book": "coloquios_da_orta_1563", "target_name": "metempsychose grega", "similarity": 0.865}], "id": 1975, "stable_key": "clu_bf2935d9d0b1aad2", "ground_truth": {"wikipedia_extract": "In philosophy and theology, metempsychosis (Ancient Greek: μετεμψύχωσις) is the transmigration of the soul, especially its reincarnation after death. The term is derived from ancient Greek philosophy, and has been recontextualized by modern philosophers such as Arthur Schopenhauer, Kurt Gödel, Mircea Eliade, and Magdalena Villaba; otherwise, the word \"transmigration\" is more appropriate. The word plays a prominent role in James Joyce's Ulysses and is also associated with Nietzsche. Another term sometimes used synonymously is palingenesis. A belief in metempsychosis has been associated with Orphism, the name given to a religious movement said in antiquity to have been founded by the legendary poet Orpheus. Orphism is said to hold that soul and body are united by a contract unequally binding on either."}}, {"canonical_name": "pungency", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pungency", "book_id": "principles_of_psychology_james_1890", "name": "pungency", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["pungency"], "contexts": ["sensory quality"]}, {"entity_id": "pungente", "book_id": "coloquios_da_orta_1563", "name": "pungente", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["pungente"], "contexts": ["quality of pepper"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "pungency", "target_book": "coloquios_da_orta_1563", "target_name": "pungente", "similarity": 0.944}], "id": 1976, "stable_key": "clu_e9f86b0e4baf893d", "ground_truth": {"wikipedia_extract": "Pungency (  PUN-jən-see), commonly referred to as spiciness, hotness or heat,  is a sensation that contributes to the flavor of certain foods such as chili peppers. Highly pungent foods may be experienced as unpleasant. The term piquancy ( PEEK-ən-see) is sometimes applied to foods with a lower degree of pungency that are \"agreeably stimulating to the palate\". In addition to chili peppers, piquant ingredients include wasabi, horseradish and mustard. The primary substances responsible for pungency are capsaicin (in chilis), piperine (in peppercorns) and allyl isothiocyanate (in radishes, mustard and wasabi). In colloquial speech, the term \"pungency\" can refer to any strong, sharp smell or flavor."}}, {"canonical_name": "immunity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "immunity", "book_id": "principles_of_psychology_james_1890", "name": "immunity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["immunity"], "contexts": ["resistance to harm"]}, {"entity_id": "immunidade", "book_id": "coloquios_da_orta_1563", "name": "immunidade", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["immunidade"], "contexts": ["protection from snake bites"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "immunity", "target_book": "coloquios_da_orta_1563", "target_name": "immunidade", "similarity": 0.993}], "id": 1977, "stable_key": "clu_a163a5067f8269e3", "ground_truth": {"modern_name": "immunity", "confidence": "high", "type": "concept", "note": "Both 'immunity' and 'immunidade' directly translate to the modern concept of immunity in a biological or medical context.", "wikidata_id": "Q182581", "wikidata_description": "state of being insusceptible or resistant to a noxious agent or process", "wikipedia_url": "https://en.wikipedia.org/wiki/Immunity%20%28medicine%29"}}, {"canonical_name": "engraving", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "engraving", "book_id": "principles_of_psychology_james_1890", "name": "engraving", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["engraving"], "contexts": ["print made from an engraved plate"]}, {"entity_id": "engravings", "book_id": "connexion_physical_sciences_somerville_1858", "name": "engravings", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["engravings"], "contexts": ["can be exactly copied by process"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "engraving", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "engravings", "similarity": 0.974}], "id": 1978, "stable_key": "clu_76397b8e539dbbd2", "ground_truth": {"modern_name": "engraving", "confidence": "high", "type": "object", "note": "The terms 'engraving' and 'engravings' refer to the artistic technique and the resulting printed image.", "wikidata_id": "Q1640824", "wikidata_description": "words, texts, lettering, or symbols marked on a work, building, or object, including texts, legends, documentation notes, or commemoration", "wikipedia_url": "https://en.wikipedia.org/wiki/Wood_engraving", "wikipedia_extract": "Wood engraving is a printmaking technique, in which an artist works an image into a block of wood. Functionally a variety of woodcut, it uses relief printing, where the artist applies ink to the face of the block and prints using relatively low pressure. The areas of the design that show ink when printed are those left uncut on the surface of the wood block. By contrast, ordinary engraving, like etching, uses a metal plate for the matrix and is printed by the intaglio method, where the ink fills the valleys, the removed areas. As a result of the relatively lower pressure used to print, the blocks for wood engravings deteriorate less quickly than the copper plates of engravings, and may have a distinctive white-on-black character. Thomas Bewick developed the wood engraving technique in Great Britain at the end of the 18th century."}}, {"canonical_name": "sinapisme", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sinapisme", "book_id": "principles_of_psychology_james_1890", "name": "sinapisme", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["sinapisme"], "contexts": ["medical application for skin irritation"]}, {"entity_id": "senapismi", "book_id": "ricettario_fiorentino_1597", "name": "Senapismi", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Senapismi"], "contexts": ["preparation for mustard plasters"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "sinapisme", "target_book": "ricettario_fiorentino_1597", "target_name": "Senapismi", "similarity": 0.922}], "id": 1979, "stable_key": "clu_b86113fc7afd1967", "ground_truth": {"modern_name": "sinapism", "confidence": "high", "type": "substance", "note": "'Sinapisme' and 'Senapismi' refer to a medicinal plaster made with mustard, a common historical remedy.", "wikidata_id": "Q1862320", "wikidata_description": "medicinal poultice"}}, {"canonical_name": "strychnin", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "strychnin", "book_id": "principles_of_psychology_james_1890", "name": "strychnin", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["strychnin"], "contexts": ["substance that tastes bitter and kills"]}, {"entity_id": "stynce", "book_id": "ricettario_fiorentino_1597", "name": "Stynce", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Stynce"], "contexts": ["Ingredient in a preparation"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "strychnin", "target_book": "ricettario_fiorentino_1597", "target_name": "Stynce", "similarity": 0.847}], "id": 1980, "stable_key": "clu_98cb11f889b4abd4", "ground_truth": {"modern_name": "strychnine", "confidence": "medium", "type": "chemical", "note": "'Strychnin' is a direct modern spelling. 'Stynce' is likely an archaic or misspelled variant of 'strychnine', given the context of a 'ricettario' (recipe book) and its bitter taste and toxicity.", "wikidata_id": "Q27225624", "wikidata_description": "chemical compound"}}, {"canonical_name": "puppies", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "puppies", "book_id": "principles_of_psychology_james_1890", "name": "puppies", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["puppies"], "contexts": ["animals used in experiments"]}, {"entity_id": "puppies", "book_id": "polyanthea_medicinal", "name": "puppies", "category": "ANIMAL", "subcategory": "ANIMAL", "count": 1, "variants": ["puppies"], "contexts": ["animal"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "puppies", "target_book": "polyanthea_medicinal", "target_name": "puppies", "similarity": 0.837}], "id": 1981, "stable_key": "clu_5adce0b0b7f44212", "ground_truth": {"wikipedia_extract": "A puppy is a juvenile dog, generally one less than 12–18 months old. Puppies are markedly underdeveloped and dependent on their mothers at birth (displaying altriciality), but healthy puppies grow quickly and begin walking thereafter. Puppies generally weigh 250–450 grams (8–16 oz) shortly after birth, depending on the breed. A puppy's coat colour may change as the puppy grows older, as is commonly seen in breeds such as the Yorkshire Terrier. Puppy refers specifically to young dogs, while pup may be used for other animals such as wolves, seals, giraffes, guinea pigs, rats, or sharks. Dogs go through prenatal development before they are born, just like all animals do."}}, {"canonical_name": "peristaltic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "peristaltic", "book_id": "principles_of_psychology_james_1890", "name": "peristaltic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["peristaltic"], "contexts": ["motion resembling wave passage"]}, {"entity_id": "peristaltico", "book_id": "polyanthea_medicinal", "name": "peristaltico", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["peristaltico"], "contexts": ["intestinal movement"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "peristaltic", "target_book": "polyanthea_medicinal", "target_name": "peristaltico", "similarity": 0.99}], "id": 1982, "stable_key": "clu_ab17e8251318e1c3", "ground_truth": {"wikipedia_extract": "Peristalsis ( PERR-ih-STAL-siss, US also  -⁠STAWL-) is a  type of gut motility, characterized by radially symmetrical contraction and relaxation of muscles that propagate in a wave down a tube, in an anterograde direction. Peristalsis is progression of coordinated contraction of involuntary circular muscles, which is preceded by a simultaneous contraction of the longitudinal muscle and relaxation of the circular muscle in the lining of the gut. In much of a digestive tract, such as the human gastrointestinal tract, smooth muscle tissue contracts in sequence to produce a peristaltic wave, which propels a ball of food (a food bolus) before being transformed into chyme in the stomach along the tract. The peristaltic movement comprises relaxation of circular smooth muscles, then their contraction behind the chewed material to keep it from moving backward, then longitudinal contraction to push it forward. Catastalsis is an obsolete term for the peristaltic wave. Earthworms use a similar mechanism to drive their locomotion, and some modern machinery imitate this design."}}, {"canonical_name": "petites perceptions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "petites_perceptions", "book_id": "principles_of_psychology_james_1890", "name": "petites perceptions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["petites perceptions"], "contexts": ["unconscious, insensible perceptions"]}, {"entity_id": "petitu", "book_id": "polyanthea_medicinal", "name": "petitu", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["petitu"], "contexts": ["request or petition"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "petites perceptions", "target_book": "polyanthea_medicinal", "target_name": "petitu", "similarity": 0.842}], "id": 1983, "stable_key": "clu_ecba27082445428b", "ground_truth": {"modern_name": "petites perceptions", "confidence": "high", "type": "concept", "note": "The term 'petites perceptions' is a specific psychological concept, and 'petitu' is likely a corrupted or abbreviated form, possibly from 'petitiones' (requests) but in the context of the work it is likely related to perception. Given the proximity to James, it is highly likely to be 'petites perceptions'.", "wikidata_id": "Q2370038", "wikidata_description": "", "wikipedia_url": "https://fr.wikipedia.org/wiki/Petites_perceptions"}}, {"canonical_name": "contractions", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "contractions", "book_id": "principles_of_psychology_james_1890", "name": "contractions", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["contractions"], "contexts": ["involuntary muscle shortening"]}, {"entity_id": "contracções", "book_id": "polyanthea_medicinal", "name": "Contracções", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["Contracções"], "contexts": ["symptom of excess acidity of pancreatic juice"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "contractions", "target_book": "polyanthea_medicinal", "target_name": "Contracções", "similarity": 0.93}], "id": 1984, "stable_key": "clu_c4d8eeb16ddabbeb", "ground_truth": {"modern_name": "contractions", "confidence": "high", "type": "concept", "note": "'Contractions' and 'Contracções' refer to the involuntary shortening of muscles, a common medical symptom.", "wikidata_id": "Q127006", "wikidata_description": "process in which force is generated within muscle tissue, resulting in a change in muscle geometry. Force generation involves a chemo-mechanical energy conversion step that is carried out by the actin/myosin complex activity", "wikipedia_url": "https://en.wikipedia.org/wiki/Muscle_contraction"}}, {"canonical_name": "warning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "warning", "book_id": "principles_of_psychology_james_1890", "name": "warning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["warning"], "contexts": ["signal of impending event"]}, {"entity_id": "advertencias", "book_id": "polyanthea_medicinal", "name": "Advertencias", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Advertencias"], "contexts": ["warnings"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "warning", "target_book": "polyanthea_medicinal", "target_name": "Advertencias", "similarity": 0.905}], "id": 1985, "stable_key": "clu_4496b990910dd2ce", "ground_truth": {"modern_name": "warning", "confidence": "high", "type": "concept", "note": "Both 'warning' and 'Advertencias' (Spanish for warnings) refer to the act of signaling danger or providing caution."}}, {"canonical_name": "acidity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "acidity", "book_id": "principles_of_psychology_james_1890", "name": "acidity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["acidity"], "contexts": ["quality of fruits"]}, {"entity_id": "acidis", "book_id": "polyanthea_medicinal", "name": "acidis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["acidis"], "contexts": ["acids, errant and exalted"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "acidity", "target_book": "polyanthea_medicinal", "target_name": "acidis", "similarity": 0.97}], "id": 1986, "stable_key": "clu_3284a3df3a46e13f", "ground_truth": {"wikipedia_extract": "An acid is a molecule or ion capable of either donating a proton (i.e. hydrogen cation, H+), known as a Brønsted–Lowry acid, or forming a covalent bond with an electron pair, known as a Lewis acid. The first category of acids are the proton donors, or Brønsted–Lowry acids. In the special case of aqueous solutions, proton donors form the hydronium ion H3O+ and are known as Arrhenius acids. Brønsted and Lowry generalized the Arrhenius theory to include non-aqueous solvents. A Brønsted–Lowry or Arrhenius acid usually contains a hydrogen atom bonded to a chemical structure that is still energetically favorable after loss of H+. Aqueous Arrhenius acids have characteristic properties that provide a practical description of an acid."}}, {"canonical_name": "Ambition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ambition", "book_id": "principles_of_psychology_james_1890", "name": "Ambition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Ambition"], "contexts": ["social affection arising from transferred pleasure"]}, {"entity_id": "ambição", "book_id": "polyanthea_medicinal", "name": "ambição", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ambição"], "contexts": ["desire for power or success"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Ambition", "target_book": "polyanthea_medicinal", "target_name": "ambição", "similarity": 0.982}], "id": 1987, "stable_key": "clu_011cfb1cc7ea0e97", "ground_truth": {"modern_name": "Ambition", "confidence": "high", "type": "concept", "wikidata_id": "Q3006977", "wikidata_description": "cruise ship built in 1999 with a capacity of 1727 passengers", "wikipedia_url": "https://en.wikipedia.org/wiki/MS_Ambition", "wikipedia_extract": "MS Ambition is a cruise ship operated by Ambassador Cruise Line. Completed in France as Mistral for Festival Cruises in 1999, she sailed between 2005 and 2019 as Grand Mistral with Ibero Cruises and Costa neoRiviera with Costa Cruises. The ship was in service as AIDAmira with AIDA Cruises, a subsidiary of Carnival Corporation & plc, until her sale in 2022 to Ambassador Cruise Line, who renamed her Ambition, commencing sailing in May 2023. It and its sister ship \"Ambience\" featured as the location of the third series of the television show \"The Cruise: Fun-Loving Brits at Sea\" The ship was originally ordered by Renaissance Cruises in mid 1996, but the order was later withdrawn. The yard and bankers together held ownership of the ship through a company called Auxiliaire Maritime. During construction at Chantiers de l'Atlantique, the order was taken over by Festival Cruises, which would receive its first new-build vessel."}}, {"canonical_name": "preponderance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "preponderance", "book_id": "principles_of_psychology_james_1890", "name": "preponderance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["preponderance"], "contexts": ["superiority or dominance"]}, {"entity_id": "predomina", "book_id": "polyanthea_medicinal", "name": "predomina", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["predomina"], "contexts": ["predominates"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "preponderance", "target_book": "polyanthea_medicinal", "target_name": "predomina", "similarity": 0.898}], "id": 1988, "stable_key": "clu_8226df2610afa431", "ground_truth": {"modern_name": "Preponderance", "confidence": "high", "type": "concept", "wikidata_id": "Q97669813", "wikidata_description": "reason for preferred rank"}}, {"canonical_name": "oyster", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "oyster", "book_id": "principles_of_psychology_james_1890", "name": "oyster", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["oyster"], "contexts": ["marine bivalve mollusc"]}, {"entity_id": "oyster-shells", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Oyster-shells", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Oyster-shells"], "contexts": ["become phosphorescent with heat or shocks"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "oyster", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Oyster-shells", "similarity": 0.89}], "id": 1989, "stable_key": "clu_4ba5c9a8865cdc49", "ground_truth": {"modern_name": "Oyster", "confidence": "high", "type": "animal", "wikidata_id": "Q37263692", "wikidata_description": "family name"}}, {"canonical_name": "articulate imaginings", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "articulate_imaginings", "book_id": "principles_of_psychology_james_1890", "name": "articulate imaginings", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["articulate imaginings"], "contexts": ["clear mental images"]}, {"entity_id": "articulation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "articulation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["articulation"], "contexts": ["production of speech sounds"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "articulate imaginings", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "articulation", "similarity": 0.866}], "id": 1990, "stable_key": "clu_3ab82b47d2430987", "ground_truth": {"modern_name": "Articulate imaginings", "confidence": "medium", "type": "concept", "note": "The term 'articulate imaginings' is specific to James. 'Articulation' in Somerville likely refers to speech production or physical joints.", "wikidata_id": "Q91048696", "wikidata_description": "vocal track by Bob Dylan; 2017 studio recording; cover version", "wikipedia_extract": "The generalized other is a concept introduced by George Herbert Mead into the social sciences, and used especially in the field of symbolic interactionism. It is the general notion that a person has of the common expectations that others may have about actions and thoughts within a particular society, and thus serves to clarify their relation to the other as a representative member of a shared social system. Any time that an actor tries to imagine what is expected of them, they are taking on the perspective of the generalized other. An alternative name of the mentally constructed idea of who an audience is without real or complete insight is imagined audience. Mead's concept of the generalised other has been linked to Adam Smith's notion of the impartial spectator – itself rooted in the earlier thinking of Addison and Epictectus. Adam Smith wrote: \"We Conceive ourselves as acting in the presence of a person quite candid and equitable, of one who...is meerly a man in general, an impartial Spectator who considers our conduct with the same indifference with which we regard that of other people\".", "wikipedia_url": "https://en.wikipedia.org/wiki/Generalized_other"}}, {"canonical_name": "atomic theory", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "atomic_theory", "book_id": "principles_of_psychology_james_1890", "name": "atomic theory", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["atomic theory"], "contexts": ["physics theory of fundamental particles"]}, {"entity_id": "atomic_theory", "book_id": "connexion_physical_sciences_somerville_1858", "name": "atomic theory", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["atomic theory"], "contexts": ["theory of matter composed of atoms"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "atomic theory", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "atomic theory", "similarity": 1.0}], "id": 1991, "stable_key": "clu_b3445ae5e919709c", "ground_truth": {"modern_name": "Atomic theory", "confidence": "high", "type": "concept", "wikidata_id": "Q210553", "wikidata_description": "history of scientific theory that views matter as made up of atoms of chemical elements", "wikipedia_extract": "This list includes well-known general theories in science and pre-scientific natural history and natural philosophy that have since been superseded by other scientific theories. Many discarded explanations were once supported by a scientific consensus, but replaced after more empirical information became available that identified flaws and prompted new theories which better explain the available data. Pre-modern explanations originated before the scientific method, with varying degrees of empirical support. Some scientific theories are discarded in their entirety, such as the replacement of the phlogiston theory by energy and thermodynamics. Some theories known to be incomplete or in some ways incorrect are still used. For example, Newtonian classical mechanics is accurate enough for practical calculations at everyday distances and velocities, and it is still taught in schools.", "wikipedia_url": "https://en.wikipedia.org/wiki/History_of_atomic_theory"}}, {"canonical_name": "retrospective", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "retrospective", "book_id": "principles_of_psychology_james_1890", "name": "retrospective", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["retrospective"], "contexts": ["looking back in time"]}, {"entity_id": "retrograde", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Retrograde", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Retrograde"], "contexts": ["moving backwards, contrary to usual direction"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "retrospective", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Retrograde", "similarity": 0.869}], "id": 1992, "stable_key": "clu_53bbd45d48484155", "ground_truth": {"modern_name": "Retrospective", "confidence": "medium", "type": "concept", "note": "While 'retrospective' and 'retrograde' are related to direction in time or movement, they are not direct synonyms in all contexts. 'Retrospective' is more about looking back, and 'retrograde' is more about moving backward.", "wikidata_id": "Q129177170", "wikidata_description": "diary written by Dorothea Herbert", "wikipedia_extract": "Concept albums have been produced by bands and solo artists across all musical genres. In popular music, a concept album is an album that is \"unified by a theme, which can be instrumental, compositional, narrative, or lyrical.\" The following is a list with specific verification by reliable sources of being notable concept albums. 2nd Chapter of Acts – The Roar of Love (1980) The 1975 – A Brief Inquiry into Online Relationships (2018) A Tribe Called Red – We Are the Halluci Nation (2016) Acid Mothers Temple – St. Captain Freak Out & the Magic Bamboo Request (2002) After Forever – Invisible Circles (2004) Against Me! – Searching for a Former Clarity (2005) Against Me!", "wikipedia_url": "https://en.wikipedia.org/wiki/List_of_concept_albums"}}, {"canonical_name": "jelly", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "jelly", "book_id": "principles_of_psychology_james_1890", "name": "jelly", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["jelly"], "contexts": ["gelatinous substance that vibrates"]}, {"entity_id": "jellies", "book_id": "connexion_physical_sciences_somerville_1858", "name": "jellies", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["jellies"], "contexts": ["gelatinous substances with optical properties"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "jelly", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "jellies", "similarity": 0.906}], "id": 1993, "stable_key": "clu_811d37e5b651f0f9", "ground_truth": {"modern_name": "Jelly", "confidence": "high", "type": "substance", "wikidata_id": "Q19901449", "wikidata_description": "family name", "wikipedia_extract": "Ferdinand Joseph LaMothe (né Lemott, later Morton; c. September 20, 1890 – July 10, 1941), known professionally as Jelly Roll Morton, was an American blues and jazz pianist, bandleader, and composer of Louisiana Creole descent. Morton was jazz's first arranger, proving that a genre rooted in improvisation could retain its essential characteristics when notated. His composition \"Jelly Roll Blues\", published in 1915, was one of the first published jazz compositions. He also claimed to have invented the genre. Morton also wrote \"King Porter Stomp\", \"Wolverine Blues\", \"Black Bottom Stomp\", and \"I Thought I Heard Buddy Bolden Say\", the last being a tribute to New Orleans musicians from the turn of the 20th century.", "wikipedia_url": "https://en.wikipedia.org/wiki/Jelly_Roll_Morton"}}, {"canonical_name": "doctrine of association", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "doctrine_of_association", "book_id": "principles_of_psychology_james_1890", "name": "doctrine of association", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["doctrine of association"], "contexts": ["historical development of associationism"]}, {"entity_id": "doctrine_of_correlation", "book_id": "first_principles_spencer_1862", "name": "doctrine of correlation", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["doctrine of correlation"], "contexts": ["implies pre-existence of forces"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "doctrine of association", "target_book": "first_principles_spencer_1862", "target_name": "doctrine of correlation", "similarity": 0.844}], "id": 1994, "stable_key": "clu_9e98e2f0c1617560", "ground_truth": {"modern_name": "Doctrine of association", "confidence": "medium", "type": "concept", "note": "The cluster links 'doctrine of association' with 'doctrine of correlation'. While both are philosophical/scientific doctrines, 'associationism' is a specific school of thought related to mental connections, whereas 'correlation' is a statistical or scientific relationship. The commonality is the concept of relatedness or connection.", "wikidata_id": "Q18355989", "wikidata_description": "ideology proposed by C. Fourier, asserting the future inevitability of communal associations of people co-working and co-living", "wikipedia_extract": "The motte-and-bailey fallacy (named after the motte-and-bailey castle) is a form of argument and an informal fallacy where an arguer conflates two positions that share similarities: one modest and easy to defend (the \"motte\") and one much more controversial and harder to defend (the \"bailey\"). The arguer advances the controversial position, but when challenged, insists that only the more modest position is being advanced. Upon retreating to the motte, the arguer may claim that the bailey has not been refuted (because the critic refused to attack the motte) or that the critic is unreasonable (by equating an attack on the bailey with an attack on the motte). Philosopher Nicholas Shackel, who coined the term, prefers to speak of a motte-and-bailey doctrine instead of a fallacy. In 2005, Shackel described the reference to medieval castle defense like this: A Motte and Bailey castle is a medieval system of defence in which a stone tower on a mound (the Motte) is surrounded by an area of land (the Bailey) which in turn is encompassed by some sort of a barrier such as a ditch. Being dark and dank, the Motte is not a habitation of choice.", "wikipedia_url": "https://en.wikipedia.org/wiki/Fourierism"}}, {"canonical_name": "tears", "category": "ANATOMY", "subcategory": "FLUID", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "tears", "book_id": "principles_of_psychology_james_1890", "name": "tears", "category": "ANATOMY", "subcategory": "FLUID", "count": 1, "variants": ["tears"], "contexts": ["fluid that washes out cinder"]}, {"entity_id": "tears", "book_id": "first_principles_spencer_1862", "name": "tears", "category": "ANATOMY", "subcategory": "FLUID", "count": 1, "variants": ["tears"], "contexts": ["fluid secreted by eyes during emotion"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "tears", "target_book": "first_principles_spencer_1862", "target_name": "tears", "similarity": 1.0}], "id": 1995, "stable_key": "clu_7bc54f4d5ddd84ba", "ground_truth": {"modern_name": "tears", "confidence": "high", "type": "concept", "note": "The context of 'fluid secreted by eyes during emotion' strongly points to tears, despite the mention of James's 'Principles of Psychology' (1890), which is slightly outside the strict early modern period (1500-1900). However, 'tears' as a physiological and emotional phenomenon was a subject of study within this timeframe.", "wikidata_id": "Q37448169", "wikidata_description": "family name", "wikipedia_extract": "Grey's Anatomy is an American medical drama television series that premiered on the American Broadcasting Company (ABC) as a mid-season replacement on March 27, 2005. The series focuses on the fictional lives of surgical interns and residents as they evolve into seasoned doctors while trying to maintain personal lives. The show's premise originated with Shonda Rhimes, who serves as an executive producer, along with Betsy Beers, Mark Gordon, Krista Vernoff, Rob Corn, Mark Wilding, and Allan Heinberg. The series was created to be racially diverse, utilizing a color-blind casting technique. It is primarily filmed in Los Angeles. The show's title is a play on Gray's Anatomy, the classic human anatomy textbook.", "wikipedia_url": "https://en.wikipedia.org/wiki/List_of_Grey's_Anatomy_episodes"}}, {"canonical_name": "human embryos", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "human_embryos", "book_id": "principles_of_psychology_james_1890", "name": "human embryos", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["human embryos"], "contexts": ["developing humans"]}, {"entity_id": "embryo-organism", "book_id": "first_principles_spencer_1862", "name": "embryo-organism", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["embryo-organism"], "contexts": ["developing organism before birth"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "human embryos", "target_book": "first_principles_spencer_1862", "target_name": "embryo-organism", "similarity": 0.918}], "id": 1996, "stable_key": "clu_4439509e5f04b8d5", "ground_truth": {"modern_name": "human embryos", "confidence": "high", "type": "animal", "note": "The terms 'human embryos' and 'embryo-organism' are direct historical references to developing human life before birth, a topic of significant interest in anatomy and natural philosophy during the early modern period.", "wikidata_id": "Q964797", "wikidata_description": "process of cell division and cellular differentiation of the embryo that occurs during the early stages of development", "wikipedia_url": "https://en.wikipedia.org/wiki/Human_embryonic_development", "wikipedia_extract": "Human embryonic development or human embryogenesis is the development and formation of the human embryo. It is characterised by the processes of cell division and cellular differentiation of the embryo that occurs during the early stages of development. In biological terms, the development of the human body entails growth from a one-celled zygote to an adult human being. Fertilization occurs when the sperm cell successfully enters and fuses with an egg cell (ovum). The genetic material of the sperm and egg then combine to form the single cell zygote and the germinal stage of development commences. Human embryonic development covers the first eight weeks of development, which have 23 stages, called Carnegie stages."}}, {"canonical_name": "dictation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dictation", "book_id": "principles_of_psychology_james_1890", "name": "dictation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dictation"], "contexts": ["act of speaking for writing"]}, {"entity_id": "despotism", "book_id": "first_principles_spencer_1862", "name": "despotism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["despotism"], "contexts": ["rule by a single absolute authority"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "dictation", "target_book": "first_principles_spencer_1862", "target_name": "despotism", "similarity": 0.845}], "id": 1997, "stable_key": "clu_a206bdadbbccdc9b", "ground_truth": {"modern_name": "dictation", "confidence": "medium", "type": "concept", "note": "While 'dictation' in the sense of speaking for writing is a valid interpretation, the juxtaposed 'despotism' from Spencer's text suggests a possible metaphorical use of 'dictation' referring to absolute rule or an imposed authority. Given the ambiguity and the time frame, 'dictation' as a concept related to communication and authority is chosen.", "wikidata_id": "Q1087138", "wikidata_description": "transcription of spoken text", "wikipedia_url": "https://en.wikipedia.org/wiki/Dictation%20%28exercise%29"}}, {"canonical_name": "brain's material secretions", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "brain's_material_secretions", "book_id": "principles_of_psychology_james_1890", "name": "brain's material secretions", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["brain's material secretions"], "contexts": ["physical output of the brain"]}, {"entity_id": "secretions", "book_id": "first_principles_spencer_1862", "name": "secretions", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["secretions"], "contexts": ["bodily fluids flowing through vessels"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "brain's material secretions", "target_book": "first_principles_spencer_1862", "target_name": "secretions", "similarity": 0.847}], "id": 1998, "stable_key": "clu_01dc16862e235f40", "ground_truth": {"modern_name": "brain secretions", "confidence": "high", "type": "concept", "note": "Early modern texts often discussed the brain producing humors or vital spirits. 'Brain's material secretions' and 'secretions' in this context refer to these conceptualized substances produced by the brain.", "wikipedia_extract": "Gastrointestinal physiology is the branch of human physiology that addresses the physical function of the gastrointestinal (GI) tract. The function of the GI tract is to process ingested food by mechanical and chemical means, extract nutrients and excrete waste products. The GI tract is composed of the alimentary canal, that runs from the mouth to the anus, as well as the associated glands, chemicals, hormones, and enzymes that assist in digestion. The major processes that occur in the GI tract are: motility, secretion, regulation, digestion and circulation. The proper function and coordination of these processes are vital for maintaining good health by providing for the effective digestion and uptake of nutrients. The gastrointestinal tract generates gut motility using smooth muscle subunits linked by gap junctions.", "wikipedia_url": "https://en.wikipedia.org/wiki/Gastrointestinal_physiology"}}, {"canonical_name": "cell-events", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cell-events", "book_id": "principles_of_psychology_james_1890", "name": "cell-events", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["cell-events"], "contexts": ["events occurring within cells"]}, {"entity_id": "cell-contents", "book_id": "first_principles_spencer_1862", "name": "cell-contents", "category": "ANATOMY", "subcategory": "OTHER_ANATOMY", "count": 1, "variants": ["cell-contents"], "contexts": ["substances within a cell"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "cell-events", "target_book": "first_principles_spencer_1862", "target_name": "cell-contents", "similarity": 0.845}], "id": 1999, "stable_key": "clu_79fd79763b335a67", "ground_truth": {"modern_name": "cellular processes", "confidence": "medium", "type": "concept", "note": "The terms 'cell-events' and 'cell-contents' can refer to either the internal substances of cells or the biochemical and physiological processes occurring within them. Given the context of early cell theory development, 'cellular processes' is a fitting broad interpretation.", "wikidata_id": "Q22269581", "wikidata_description": "process, occurring at the cellular level, that is involved in the reproductive function of a multicellular organism"}}, {"canonical_name": "German empirical psychology", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "german_empirical_psychology", "book_id": "principles_of_psychology_james_1890", "name": "German empirical psychology", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "count": 1, "variants": ["German empirical psychology"], "contexts": ["school of psychology"]}, {"entity_id": "german_school", "book_id": "first_principles_spencer_1862", "name": "German school", "category": "CONCEPT", "subcategory": "SCHOOL_OF_THOUGHT", "count": 1, "variants": ["German school"], "contexts": ["philosophical tradition, possibly idealism"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "German empirical psychology", "target_book": "first_principles_spencer_1862", "target_name": "German school", "similarity": 0.846}], "id": 2000, "stable_key": "clu_411dbd045b5f898f", "ground_truth": {"modern_name": "German empirical psychology", "confidence": "high", "type": "concept", "note": "This cluster clearly refers to a specific school of thought within psychology originating in Germany, characterized by its empirical approach, a concept prominent in the late 19th century.", "wikidata_id": "Q1205210", "wikidata_description": "", "wikipedia_extract": "Gestalt psychology, gestaltism, or configurationism  is a school of psychology and a theory of perception that emphasizes the processing of entire patterns and configurations, and not merely individual components. It emerged in the early twentieth century in Germany and Austria as a rejection of basic principles of Wilhelm Wundt's and Edward Titchener's elementalist and structuralist psychology. Gestalt psychology is often associated with the adage, \"The whole is greater than the sum of its parts\". In Gestalt theory, information is perceived as wholes rather than disparate parts which are then processed summatively. As used in Gestalt psychology, the German word Gestalt ( gə-SHTA(H)LT, German: [ɡəˈʃtalt] ; meaning \"form\") is interpreted as \"pattern\" or \"configuration\". It differs from Gestalt therapy, which is only peripherally linked to Gestalt psychology.", "wikipedia_url": "https://en.wikipedia.org/wiki/Gestalt_psychology"}}, {"canonical_name": "idiots", "category": "DISEASE", "subcategory": "PSYCHOLOGICAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "idiots", "book_id": "principles_of_psychology_james_1890", "name": "idiots", "category": "DISEASE", "subcategory": "PSYCHOLOGICAL", "count": 1, "variants": ["idiots"], "contexts": ["individuals with intellectual disability"]}, {"entity_id": "idiotcy", "book_id": "first_principles_spencer_1862", "name": "idiotcy", "category": "DISEASE", "subcategory": "PSYCHOLOGICAL", "count": 1, "variants": ["idiotcy"], "contexts": ["severe intellectual disability"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "idiots", "target_book": "first_principles_spencer_1862", "target_name": "idiotcy", "similarity": 0.942}], "id": 2001, "stable_key": "clu_cd36f3fac3125af4", "ground_truth": {"modern_name": "intellectual disability", "confidence": "high", "type": "disease", "modern_term": "intellectual disability", "note": "The terms 'idiots' and 'idiotcy' were historical medical classifications for individuals with severe intellectual disabilities, now understood as intellectual disability.", "wikidata_id": "Q183560", "wikidata_description": "generalized neurodevelopmental disorder", "wikipedia_extract": "SYNGAP1-related intellectual disability is a monogenetic developmental and epileptic encephalopathy that affects the central nervous system. Symptoms include intellectual disability, epilepsy, autism, sensory processing deficits, hypotonia and unstable gait. The first signs of SYNGAP1-related encephalopathy are typically gross motor delays in infancy followed by developmental delays, seizure onset and language impairment. Penetrance is 100%. Mild to severe intellectual or developmental disability is present in the majority of patients. Epilepsy is present in the majority of cases, with approximately 80-98% of patients affected by seizures.", "wikipedia_url": "https://en.wikipedia.org/wiki/SYNGAP1-related_intellectual_disability"}}, {"canonical_name": "analyze", "category": "CONCEPT", "subcategory": "COGNITIVE_PROCESS", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "analyze", "book_id": "principles_of_psychology_james_1890", "name": "analyze", "category": "CONCEPT", "subcategory": "COGNITIVE_PROCESS", "count": 1, "variants": ["analyze"], "contexts": ["breaking down into parts"]}, {"entity_id": "analysis", "book_id": "first_principles_spencer_1862", "name": "analysis", "category": "CONCEPT", "subcategory": "COGNITIVE_PROCESS", "count": 1, "variants": ["analysis"], "contexts": ["breaking down into components"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "analyze", "target_book": "first_principles_spencer_1862", "target_name": "analysis", "similarity": 0.957}], "id": 2002, "stable_key": "clu_1b827e2a6fa3cd4a", "ground_truth": {"modern_name": "analysis", "confidence": "high", "type": "concept", "note": "Both 'analyze' and 'analysis' in this context refer to the intellectual process of breaking down complex subjects into their constituent parts, a fundamental concept in scientific and philosophical inquiry.", "wikidata_id": "Q15751184", "wikidata_description": "mathematics journal", "wikipedia_extract": "A concept is an abstract idea that serves as a foundation for more concrete principles, thoughts, and beliefs. Concepts play an important role in all aspects of cognition. As such, concepts are studied within such disciplines as linguistics, psychology, and philosophy, and these disciplines are interested in the logical and psychological structure of concepts, and how they are put together to form thoughts and sentences. The study of concepts has served as an important flagship of an emerging interdisciplinary approach, cognitive science. In contemporary philosophy, three understandings of a concept prevail: mental representations, such that a concept is an entity that exists in the mind (a mental object) abilities peculiar to cognitive agents (mental states) Fregean senses, abstract objects rather than a mental object or a mental state Concepts are classified into a hierarchy, higher levels of which are termed \"superordinate\" and lower levels termed \"subordinate\". Additionally, there is the \"basic\" or \"middle\" level at which people will most readily categorize a concept.", "wikipedia_url": "https://en.wikipedia.org/wiki/Concept"}}, {"canonical_name": "inspissation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "inspissation", "book_id": "principles_of_psychology_james_1890", "name": "inspissation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["inspissation"], "contexts": ["thickening or condensation process"]}, {"entity_id": "imbrication", "book_id": "first_principles_spencer_1862", "name": "imbrication", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["imbrication"], "contexts": ["overlapping arrangement"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "inspissation", "target_book": "first_principles_spencer_1862", "target_name": "imbrication", "similarity": 0.851}], "id": 2003, "stable_key": "clu_1841f4978b97e119", "ground_truth": {"modern_name": "Thickening or Condensation", "confidence": "high", "type": "concept", "note": "The terms 'inspissation' and 'imbrication' relate to processes of thickening, condensation, or overlapping. In medical contexts, 'inspissation' refers to the thickening of bodily fluids. In broader scientific or philosophical contexts, it can refer to condensation. 'Imbrication' specifically means overlapping, like roof tiles, which can be a form of condensation or arrangement.", "wikidata_id": "Q11312507", "wikidata_description": "process of increasing the viscosity of a fluid", "wikipedia_url": "https://en.wikipedia.org/wiki/Philosophy_of_matter", "wikipedia_extract": "Philosophy of matter is the branch of philosophy concerned with issues surrounding the ontology, epistemology and character of matter and the material world. The word matter is derived from the Latin word materia, meaning 'wood', or 'timber', in the sense 'material', as distinct from 'mind' or 'form'. The image of wood came to Latin as a calque from the ancient Greek philosophical usage of hyle (ὕλη). In ancient Greek philosophy, arche (ἀρχή) is the beginning or the first principle of the world. Thales of Miletus claimed that the first principle of all things is water. His theory was supported by the observation of moisture throughout the world and coincided with his theory that the earth floated on water."}}, {"canonical_name": "excluded middle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "excluded_middle", "book_id": "principles_of_psychology_james_1890", "name": "excluded middle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["excluded middle"], "contexts": ["logical principle"]}, {"entity_id": "excluded_middle", "book_id": "first_principles_spencer_1862", "name": "excluded middle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["excluded middle"], "contexts": ["logical principle"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "excluded middle", "target_book": "first_principles_spencer_1862", "target_name": "excluded middle", "similarity": 1.0}], "id": 2004, "stable_key": "clu_5277c3239dce8b4b", "ground_truth": {"modern_name": "Law of Excluded Middle", "confidence": "high", "type": "concept", "wikidata_id": "Q468422", "wikidata_description": "logical principle stating that for every proposition, either it or its negation is true", "wikipedia_url": "https://en.wikipedia.org/wiki/Law_of_excluded_middle", "wikipedia_extract": "In logic, the semantic principle (or law) of bivalence states that every declarative sentence expressing a proposition (of a theory under inspection) has exactly one truth value, either true or false. A logic satisfying this principle is called a two-valued logic or bivalent logic. In formal logic, the principle of bivalence becomes a property that a semantics may or may not possess. It is not the same as the law of excluded middle, however, and a semantics may satisfy that law without being bivalent. The principle of bivalence is studied in philosophical logic to address the question of which natural-language statements have a well-defined truth value. Sentences that predict events in the future, and sentences that seem open to interpretation, are particularly difficult for philosophers who hold that the principle of bivalence applies to all declarative natural-language statements."}}, {"canonical_name": "draught", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "draught", "book_id": "principles_of_psychology_james_1890", "name": "draught", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["draught"], "contexts": ["pulling heavy loads"]}, {"entity_id": "draught", "book_id": "first_principles_spencer_1862", "name": "draught", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["draught"], "contexts": ["pulling of a load"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "draught", "target_book": "first_principles_spencer_1862", "target_name": "draught", "similarity": 1.0}], "id": 2005, "stable_key": "clu_6f7e52ec95df7a38", "ground_truth": {"modern_name": "Draft", "confidence": "high", "type": "concept", "note": "While 'draught' can refer to a gulp of liquid, in the context of 'pulling heavy loads' and 'pulling of a load', it refers to a force or movement, often in the context of mechanics or physical exertion.", "wikidata_id": "Q31603", "wikidata_description": "process used to allocate certain players to sports teams", "wikipedia_url": "https://en.wikipedia.org/wiki/Draft_%28boating%29", "wikipedia_extract": "The NBA draft is an annual National Basketball Association's (NBA) event, dating back to 1947, in which the teams in the league draft players to join their organizations who are eligible and who declare for the draft. The current NBA consists of 30 teams, and all thirty teams have at least one draft pick throughout the two draft rounds. Historically, the vast majority of players drafted into the NBA are college basketball players. It is now common for players to also be drafted from international professional leagues, the G League Ignite team, and youth professional basketball leagues. College players who have finished their four-year college eligibility are automatically eligible for selection, while the underclassmen have to declare their eligibility and give up their remaining college eligibility. International players who are at least 22 years old are automatically eligible for selection, while the players younger than 22 have to declare their eligibility."}}, {"canonical_name": "Noumenon", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "noumenon", "book_id": "principles_of_psychology_james_1890", "name": "Noumenon", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Noumenon"], "contexts": ["unknowable reality beyond phenomena"]}, {"entity_id": "noumenon", "book_id": "first_principles_spencer_1862", "name": "Noumenon", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Noumenon"], "contexts": ["thing-in-itself, reality behind appearances"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Noumenon", "target_book": "first_principles_spencer_1862", "target_name": "Noumenon", "similarity": 1.0}], "id": 2006, "stable_key": "clu_b1996283094c0091", "ground_truth": {"modern_name": "Noumenon", "confidence": "high", "type": "concept", "note": "Philosophical concept from Kantian philosophy.", "wikidata_id": "Q239581", "wikidata_description": "in philosophy, a posited object or event that exists independently of human sense and/or concept, unlike a phenomenon"}}, {"canonical_name": "depression of spirits", "category": "DISEASE", "subcategory": "PSYCHOLOGICAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "depression_of_spirits", "book_id": "principles_of_psychology_james_1890", "name": "depression of spirits", "category": "DISEASE", "subcategory": "PSYCHOLOGICAL", "count": 1, "variants": ["depression of spirits"], "contexts": ["low mood and spirits"]}, {"entity_id": "depression", "book_id": "first_principles_spencer_1862", "name": "depression", "category": "DISEASE", "subcategory": "PSYCHOLOGICAL", "count": 1, "variants": ["depression"], "contexts": ["state of low spirits"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "depression of spirits", "target_book": "first_principles_spencer_1862", "target_name": "depression", "similarity": 0.824}], "id": 2007, "stable_key": "clu_cde5c31723015c26", "ground_truth": {"modern_name": "Depression", "confidence": "high", "type": "disease", "modern_term": "Major depressive disorder", "note": "In early modern texts, 'depression of spirits' was a common descriptor for low mood and melancholy, which corresponds to modern understandings of depression.", "wikidata_id": "Q209190", "wikidata_description": "region of the atmosphere in which atmospheric pressure is lower than that of surrounding regions", "wikipedia_extract": "The Great Depression was a severe global economic downturn from 1929 to 1939. The period was characterized by high rates of unemployment and poverty, drastic reductions in industrial production and international trade, and widespread bank and business failures around the world. The economic contagion began in 1929 in the United States, the largest economy in the world, with the devastating Wall Street crash of 1929 often considered the beginning of the Depression. Among the countries with the most unemployed were the U.S., the United Kingdom, and Germany. The Depression was preceded by a period of industrial growth and social development known as the \"Roaring Twenties\". Much of the profit generated by the boom was invested in speculation, such as on the stock market, contributing to growing wealth inequality.", "wikipedia_url": "https://en.wikipedia.org/wiki/Great_Depression"}}, {"canonical_name": "psychologizing", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "psychologizing", "book_id": "principles_of_psychology_james_1890", "name": "psychologizing", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["psychologizing"], "contexts": ["study of the mind's structure and processes"]}, {"entity_id": "psychological_analysis", "book_id": "first_principles_spencer_1862", "name": "psychological analysis", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["psychological analysis"], "contexts": ["analysis of mental experiences"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "psychologizing", "target_book": "first_principles_spencer_1862", "target_name": "psychological analysis", "similarity": 0.851}], "id": 2008, "stable_key": "clu_1428c95245ca9bf7", "ground_truth": {"modern_name": "Psychological Analysis", "confidence": "high", "type": "concept", "note": "Refers to the study and analysis of mental processes and experiences.", "wikidata_id": "Q7256412", "wikidata_description": "American magazine and media organization", "wikipedia_extract": "Psychoanalysis is a set of theories and techniques to discover unconscious processes and their influence on conscious thought, emotion and behavior. Based on dream interpretation, psychoanalysis is also a talk therapy method for treating mental disorders. Established in the early 1890s by Sigmund Freud, it takes into account Darwin's theory of evolution, neurology findings, ethnology reports, and, in some respects, the clinical research of his mentor Josef Breuer. Freud developed and refined the theory and practice of psychoanalysis until his death in 1939. In an encyclopedic article, he identified four foundational beliefs: \"the assumption that there are unconscious mental processes, the recognition of the theory of repression and resistance, the appreciation of the importance of sexuality and of the Oedipus complex.\" Two of Freud's early colleagues, Alfred Adler and Carl Jung, soon developed their own methods, individual and analytical psychology, respectively, which he said were not forms of psychoanalysis. After the author's death, neo-Freudian thinkers like Erich Fromm, Karen Horney and Harry Stack Sullivan created some subfields.", "wikipedia_url": "https://en.wikipedia.org/wiki/Psychoanalysis"}}, {"canonical_name": "universalize", "category": "CONCEPT", "subcategory": "COGNITIVE_PROCESS", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "universalize", "book_id": "principles_of_psychology_james_1890", "name": "universalize", "category": "CONCEPT", "subcategory": "COGNITIVE_PROCESS", "count": 1, "variants": ["universalize"], "contexts": ["applying to an entire class of things"]}, {"entity_id": "generalized", "book_id": "first_principles_spencer_1862", "name": "generalized", "category": "CONCEPT", "subcategory": "COGNITIVE_PROCESS", "count": 1, "variants": ["generalized"], "contexts": ["forming general principles from specific instances"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "universalize", "target_book": "first_principles_spencer_1862", "target_name": "generalized", "similarity": 0.855}], "id": 2009, "stable_key": "clu_35d3c887aa37cb5a", "ground_truth": {"modern_name": "Generalization", "confidence": "high", "type": "concept", "note": "The process of inferring a general rule from specific instances or applying a concept to a broader class.", "wikidata_id": "Q6963735", "wikidata_description": "concept on humans' and animals' use of past learning in present situations", "wikipedia_extract": "A generalization is a form of abstraction whereby common properties of specific instances are formulated as general concepts or claims. Generalizations posit the existence of a domain or set of elements, as well as one or more common characteristics shared by those elements (thus creating a conceptual model). As such, they are the essential basis of all valid deductive inferences (particularly in logic, mathematics and science), where the process of verification is necessary to determine whether a generalization holds true for any given situation. Generalization can also be used to refer to the process of identifying the parts of a whole, as belonging to the whole. The parts, which might be unrelated when left on their own, may be brought together as a group, hence belonging to the whole by establishing a common relation between them. However, the parts cannot be generalized into a whole—until a common relation is established among all parts.", "wikipedia_url": "https://en.wikipedia.org/wiki/Generalization_%28learning%29"}}, {"canonical_name": "railroad imagery", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "railroad_imagery", "book_id": "principles_of_psychology_james_1890", "name": "railroad imagery", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["railroad imagery"], "contexts": ["metaphorical use of train details"]}, {"entity_id": "railway-system", "book_id": "first_principles_spencer_1862", "name": "railway-system", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["railway-system"], "contexts": ["network of railways"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "railroad imagery", "target_book": "first_principles_spencer_1862", "target_name": "railway-system", "similarity": 0.874}], "id": 2010, "stable_key": "clu_b3e504daa2ae1928", "ground_truth": {"modern_name": "Railroad System", "confidence": "high", "type": "concept", "note": "Refers to the infrastructure and conceptualization of railway networks. 'Railroad imagery' suggests a metaphorical use of this concept.", "wikidata_id": "Q16608251", "wikidata_description": "system of railways and rail transport"}}, {"canonical_name": "uniformity of nature", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "uniformity_of_nature", "book_id": "principles_of_psychology_james_1890", "name": "uniformity of nature", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["uniformity of nature"], "contexts": ["belief that nature follows consistent laws"]}, {"entity_id": "natural_uniformity", "book_id": "first_principles_spencer_1862", "name": "natural uniformity", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["natural uniformity"], "contexts": ["consistent natural laws"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "uniformity of nature", "target_book": "first_principles_spencer_1862", "target_name": "natural uniformity", "similarity": 0.918}], "id": 2011, "stable_key": "clu_fda12c1ddaa8855a", "ground_truth": {"modern_name": "Uniformity of nature", "confidence": "high", "type": "concept", "wikidata_id": "Q208650", "wikidata_description": "assumption that the same natural laws and processes that operate in the universe here and now have operated always and everywhere", "wikipedia_url": "https://en.wikipedia.org/wiki/Uniformitarianism", "wikipedia_extract": "Uniformitarianism, also known as the Doctrine of Uniformity or the Uniformitarian Principle, is the assumption that the same natural laws and processes that operate in our present-day scientific observations have always operated in the universe in the past and apply everywhere in the universe. It refers to invariance in the metaphysical principles underpinning science, such as the constancy of cause and effect throughout space-time, but has also been used to describe spatiotemporal invariance of physical laws. Though an unprovable postulate that cannot be verified using the scientific method, some consider that uniformitarianism should be a required first principle in scientific research. In geology, uniformitarianism has included the gradualistic concept that \"the present is the key to the past\" and that geological events occur at the same rate now as they have always done, though many modern geologists no longer hold to a strict gradualism. Coined by William Whewell, uniformitarianism was originally proposed in contrast to catastrophism by British naturalists in the late 18th century, starting with the work of the geologist James Hutton in his many books including Theory of the Earth. Hutton's work was later refined by scientist John Playfair and popularised by geologist Charles Lyell's Principles of Geology in 1830."}}, {"canonical_name": "discrimination of successions", "category": "CONCEPT", "subcategory": "COGNITIVE_PROCESS", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "discrimination_of_successions", "book_id": "principles_of_psychology_james_1890", "name": "discrimination of successions", "category": "CONCEPT", "subcategory": "COGNITIVE_PROCESS", "count": 1, "variants": ["discrimination of successions"], "contexts": ["ability to distinguish sequential events"]}, {"entity_id": "succession", "book_id": "first_principles_spencer_1862", "name": "succession", "category": "CONCEPT", "subcategory": "COGNITIVE_PROCESS", "count": 1, "variants": ["succession"], "contexts": ["the order of events in time"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "discrimination of successions", "target_book": "first_principles_spencer_1862", "target_name": "succession", "similarity": 0.858}], "id": 2012, "stable_key": "clu_8e045405f0ab90d3", "ground_truth": {"modern_name": "Discrimination of successions", "confidence": "high", "type": "concept", "wikidata_id": "Q58922789", "wikidata_description": "scholarly article by Dola Bhattacharjee et al published 3 October 2013 in International journal of biodiversity"}}, {"canonical_name": "handkerchief", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "handkerchief", "book_id": "principles_of_psychology_james_1890", "name": "handkerchief", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["handkerchief"], "contexts": ["object used for remembering"]}, {"entity_id": "handkerchief", "book_id": "first_principles_spencer_1862", "name": "handkerchief", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["handkerchief"], "contexts": ["piece of cloth for wiping"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "handkerchief", "target_book": "first_principles_spencer_1862", "target_name": "handkerchief", "similarity": 1.0}], "id": 2013, "stable_key": "clu_cdea7cf5cd9b70fa", "ground_truth": {"modern_name": "Handkerchief", "confidence": "high", "type": "object", "wikidata_id": "Q192411", "wikidata_description": "piece of cloth for personal use", "wikipedia_url": "https://en.wikipedia.org/wiki/Pigeon_drop", "wikipedia_extract": "The pigeon drop or Spanish handkerchief or Chilean handkerchief is a confidence trick in which a victim (the mark or pigeon) is persuaded to pay to secure the right to a supposed large sum of money or valuable object. One of the con artists will typically claim to have found the money or valuable abandoned on the ground just before talking to the mark, or will place it on the ground beforehand and pretend to happen upon it at the same time as the mark, hence the term \"drop\". Typically the scam involves two or three scammers (con artists) performing together to defraud the mark. One will arrange to \"find\" a valuable item along with the mark in a public place, such as by leaving it on the ground for the mark to find or approaching them with it in hand. A second scammer will pass by and enter the conversation, seeming to provide an independent opinion. One of the two scammers will pose as someone senior and knowledgeable, such as a lawyer, banker, or businessperson, or the senior might be a third scammer posing as a boss or authority called by one of the others."}}, {"canonical_name": "hygiene", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "hygiene", "book_id": "principles_of_psychology_james_1890", "name": "hygiene", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hygiene"], "contexts": ["practices for maintaining health"]}, {"entity_id": "hygiene", "book_id": "first_principles_spencer_1862", "name": "hygiene", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hygiene"], "contexts": ["practice influenced by anatomy and physiology"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "hygiene", "target_book": "first_principles_spencer_1862", "target_name": "hygiene", "similarity": 1.0}], "id": 2014, "stable_key": "clu_2b5b2a14e677c0f5", "ground_truth": {"modern_name": "Hygiene", "confidence": "high", "type": "concept"}}, {"canonical_name": "belemnite shell", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "belemnite_shell", "book_id": "kosmos_humboldt_1845", "name": "belemnite shell", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["belemnite shell"], "contexts": ["shell associated with Cephalopodes"]}, {"entity_id": "bellota", "book_id": "historia_medicinal_monardes_1574", "name": "bellota", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["bellota"], "contexts": ["shape of Bezoar stone"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "belemnite shell", "target_book": "historia_medicinal_monardes_1574", "target_name": "bellota", "similarity": 0.842}], "id": 2015, "stable_key": "clu_f95359cc46e7ad84", "ground_truth": {"modern_name": "Belemnite", "confidence": "high", "type": "mineral", "note": "The term 'bellota' likely refers to the shape rather than the specific object in Monardes' text, but context points to fossil shells.", "wikidata_id": "Q2894293", "wikidata_description": "extinct genus of cephalopods", "wikipedia_extract": "Min (Ancient Egyptian: mnw) is an ancient Egyptian god whose cult originated in the predynastic period (4th millennium BCE). He was represented in many different forms, but was most often represented in male human form, shown with an erect penis which he holds in his left hand and an upheld right arm holding a flail. Pre-dynastic period (circa 3300 BCE) Min's cult began and was centered around Coptos (Koptos, modern day Qift) and Akhmim (Panopolis) of Upper Egypt, where in his honour great festivals were held celebrating his \"coming forth\" with a public procession and presentation of offerings. His other associations include the eastern desert and links to the god Horus. Flinders Petrie excavated two large statues of Min at Qift which are now in the Ashmolean Museum and it is thought by some that they are pre-dynastic. Although not mentioned by name, a reference to \"he whose arm is raised in the East\" in the Pyramid Texts is thought to refer to Min.", "wikipedia_url": "https://en.wikipedia.org/wiki/Belemnites_%28genus%29"}}, {"canonical_name": "Paropamisus", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "paropamisus", "book_id": "kosmos_humboldt_1845", "name": "Paropamisus", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Paropamisus"], "contexts": ["ancient mountain range"]}, {"entity_id": "paropaniso", "book_id": "coloquios_da_orta_1563", "name": "Paropaniso", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Paropaniso"], "contexts": ["mountain where a Milanese is from"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Paropamisus", "target_book": "coloquios_da_orta_1563", "target_name": "Paropaniso", "similarity": 0.868}], "id": 2016, "stable_key": "clu_e02ccfa4c8ade494", "ground_truth": {"modern_name": "Paropamisus", "confidence": "high", "type": "place", "country": "Afghanistan", "wikidata_id": "Q100797695", "wikidata_description": "Ecoregion (WWF)", "wikipedia_url": "https://en.wikipedia.org/wiki/Paropamisus_xeric_woodlands"}}, {"canonical_name": "Lorraine", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "lorraine", "book_id": "kosmos_humboldt_1845", "name": "Lorraine", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Lorraine"], "contexts": ["duchy"]}, {"entity_id": "lorena", "book_id": "coloquios_da_orta_1563", "name": "Lorena", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Lorena"], "contexts": ["duchy of which Champier was part"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Lorraine", "target_book": "coloquios_da_orta_1563", "target_name": "Lorena", "similarity": 0.847}], "id": 2017, "stable_key": "clu_6451d5eeb7a18e61", "ground_truth": {"modern_name": "Lorraine", "confidence": "high", "type": "place", "country": "France", "wikidata_id": "Q18355916", "wikidata_description": "family name", "wikipedia_extract": "Lorraine is a historical area of Eastern France that today falls within the administrative region of Grand Est. It has its origins in the medieval kingdom of Lotharingia (855–959 AD), named after Emperor Lothair I or King Lothair II, which came to be ruled by the Holy Roman Empire. This kingdom, which extended further north than the modern region, was divided into upper and lower duchies; the lower duchy lasted until the 12th century but the upper duchy persisted and developed into the Duchy of Lorraine. The Kingdom of France annexed the duchy, along with the Duchy of Bar (the two having been held together since the 15th century), in 1766, which became the Lorraine and Barrois province. From 1982 until January 2016, Lorraine was an administrative region of France. In 2016, under a reorganisation, it became part of the new region Grand Est.", "wikipedia_url": "https://en.wikipedia.org/wiki/Lorraine"}}, {"canonical_name": "Ispahan", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ispahan", "book_id": "kosmos_humboldt_1845", "name": "Ispahan", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Ispahan"], "contexts": ["city where light was observed"]}, {"entity_id": "ispahan", "book_id": "coloquios_da_orta_1563", "name": "Ispahan", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Ispahan"], "contexts": ["city where Avicenna served later"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Ispahan", "target_book": "coloquios_da_orta_1563", "target_name": "Ispahan", "similarity": 1.0}], "id": 2018, "stable_key": "clu_ae65a0a49781bc6c", "ground_truth": {"modern_name": "Isfahan", "confidence": "high", "type": "place", "country": "Iran", "wikidata_id": "Q42053", "wikidata_description": "city in Isfahan Province, Iran", "wikipedia_extract": "The Isfahan School (Persian:  مكتب اصفهان ) is a school of Islamic philosophy. It was founded by Mir Damad and reached its fullest development in the work of Mulla Sadra. The name was coined by Seyyed Hossein Nasr and Henry Corbin. Because of the attention of Shah Abbas during the Safavid dynasty in Iran to intellectual tradition in Islam, Isfahan became a famous academic city and the intellectual center of Iran at the time, along with the cities of Ray and Shiraz. This school of thought began to develop once Iran was economically and politically stable. The Safavid court also provided funding for the arts, which also contributed to the development.", "wikipedia_url": "https://en.wikipedia.org/wiki/School_of_Isfahan"}}, {"canonical_name": "manking", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "manking", "book_id": "kosmos_humboldt_1845", "name": "manking", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["manking"], "contexts": ["humanity in general"]}, {"entity_id": "manhans", "book_id": "coloquios_da_orta_1563", "name": "manhans", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["manhans"], "contexts": ["period of time for taking medicine"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "manking", "target_book": "coloquios_da_orta_1563", "target_name": "manhans", "similarity": 0.846}], "id": 2019, "stable_key": "clu_617e581073af62a1", "ground_truth": {"modern_name": "humanity", "confidence": "high", "type": "concept", "note": "The term 'manking' and 'manhans' likely refer to humanity, with 'manhans' also potentially referring to a specific period for medication.", "wikidata_id": "Q1575029", "wikidata_description": "International aid organization with headquarter in France", "wikipedia_url": "https://en.wikipedia.org/wiki/Human", "wikipedia_extract": "Humans (Homo sapiens, meaning \"thinking man\" or \"wise man\") are the most common and widespread species of primate, and the only extant species of the genus Homo. They are great apes characterized by hairlessness, obligate bipedality, manual dexterity with opposable thumbs, precision grip, and high intelligence. Humans have large brains compared to body size (a high encephalization quotient), enabling more advanced cognitive skills that facilitate successful adaptation to varied environments, development of sophisticated tools, and formation of complex social structures and civilizations. Humans possess a disproportionately larger volume of both cerebral white matter and gray matter present in the prefrontal cortex (PFC) than any other primate species, which facilitated the expansion of higher-order executive functions. Humans are highly social, with individual humans tending to belong to a multi-layered network of distinct social groups – from families and peer groups to corporations and political states. As such, social interactions between humans have established a wide variety of values, social norms, languages, and traditions (collectively termed institutions), each of which bolsters human society."}}, {"canonical_name": "Thlaspi arvense", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "thlaspi_arvense", "book_id": "kosmos_humboldt_1845", "name": "Thlaspi arvense", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Thlaspi arvense"], "contexts": ["European plant species in India"]}, {"entity_id": "thlafpi", "book_id": "ricettario_fiorentino_1597", "name": "Thlafpi", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Thlafpi"], "contexts": ["small herb with long leaves and fruits"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Thlaspi arvense", "target_book": "ricettario_fiorentino_1597", "target_name": "Thlafpi", "similarity": 0.856}], "id": 2020, "stable_key": "clu_84d422bc3d36c6a4", "ground_truth": {"modern_name": "Field Pennycress", "confidence": "high", "type": "plant", "linnaean": "Thlaspi arvense Linnaeus", "family": "Brassicaceae", "note": "The genus Thlaspi is now often considered a synonym for several other genera, but T. arvense is a recognized species.", "wikidata_id": "Q161867", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Thlaspi%20arvense"}}, {"canonical_name": "Cyclades", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cyclades", "book_id": "kosmos_humboldt_1845", "name": "Cyclades", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Cyclades"], "contexts": ["islands experiencing earthquakes"]}, {"entity_id": "cycladi", "book_id": "ricettario_fiorentino_1597", "name": "Cycladi", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Cycladi"], "contexts": ["islands where Cippero root originates"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Cyclades", "target_book": "ricettario_fiorentino_1597", "target_name": "Cycladi", "similarity": 0.977}], "id": 2021, "stable_key": "clu_a91e0f54aac7db19", "ground_truth": {"modern_name": "Cyclades", "confidence": "high", "type": "place", "country": "Greece", "wikidata_id": "Q171132", "wikidata_description": "Greek island group in the Aegean Sea", "wikipedia_url": "https://en.wikipedia.org/wiki/Cyclades"}}, {"canonical_name": "Palma dulce", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "palma_dulce", "book_id": "kosmos_humboldt_1845", "name": "Palma dulce", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Palma dulce"], "contexts": ["native name for palm"]}, {"entity_id": "pomi_dolci", "book_id": "ricettario_fiorentino_1597", "name": "Pomi dolci", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Pomi dolci"], "contexts": ["sweet apples"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Palma dulce", "target_book": "ricettario_fiorentino_1597", "target_name": "Pomi dolci", "similarity": 0.859}], "id": 2022, "stable_key": "clu_3d965bda5594d186", "ground_truth": {"modern_name": "Sweet Palm", "confidence": "medium", "type": "plant", "note": "'Palma dulce' and 'Pomi dolci' are ambiguous. 'Palma dulce' could refer to a sweet-tasting palm, and 'Pomi dolci' to sweet apples. Given the context of plants, 'Sweet Palm' is a plausible interpretation for 'Palma dulce', but 'Pomi dolci' is more likely an apple. Without further context, a definitive identification of the intended plant for both is difficult.", "wikipedia_extract": "Raffia palms are members of the genus Raphia. The Malagasy name rafia is derived from fia \"to squeeze juice\". The genus contains about twenty species of palms native to tropical regions of Africa, and especially Madagascar, with one species (R. taedigera) also occurring in Central and South America. R. taedigera is the source of raffia fibers, which are the veins of the leaves, and this species produces a fruit called \"brazilia pods\", \"uxi nuts\" or \"uxi pods\".", "wikipedia_url": "https://en.wikipedia.org/wiki/Raffia_palm"}}, {"canonical_name": "Ouranos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ouranos", "book_id": "kosmos_humboldt_1845", "name": "Ouranos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Ouranos"], "contexts": ["heavenly region in ancient cosmology"]}, {"entity_id": "ourına", "book_id": "polyanthea_medicinal", "name": "ourına", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ourına"], "contexts": ["bodily fluid"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Ouranos", "target_book": "polyanthea_medicinal", "target_name": "ourına", "similarity": 0.841}], "id": 2023, "stable_key": "clu_50af9a9c590cc97e", "ground_truth": {"modern_name": "Uranus", "confidence": "high", "type": "concept", "note": "While 'Ouranos' is the Greek word for sky/heaven, in some ancient cosmologies it also represented a primordial deity. 'ourına' in a medical context is less clear, but could relate to humors or bodily fluids associated with the heavens.", "wikipedia_extract": "Sailor Uranus (Japanese: セーラーウラヌス, Hepburn: Sērā Uranusu) is a fictional character in the Sailor Moon media franchise. Sailor Uranus' alternate identity is Haruka Tenou (天王 はるか, Ten'ō Haruka; renamed \"Amara Tenoh\" in some English adaptations), a teenage Japanese student and race car driver. Haruka is a member of the Sailor Guardians, female supernatural fighters who protect the Solar System from evil. Sailor Uranus fights alongside her partner and lover Sailor Neptune. Sailor Uranus possesses powers associated with the wind and sky, precognition, as well as sword combat. Haruka is a stubborn, protective individual, as well as strong-willed, capable, charming, and occasionally even daring.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sailor_Uranus"}}, {"canonical_name": "cementation", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cementation", "book_id": "kosmos_humboldt_1845", "name": "cementation", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["cementation"], "contexts": ["process of making steel"]}, {"entity_id": "cementar", "book_id": "polyanthea_medicinal", "name": "cementar", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["cementar"], "contexts": ["chemical process of preparing medicines"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "cementation", "target_book": "polyanthea_medicinal", "target_name": "cementar", "similarity": 0.891}], "id": 2024, "stable_key": "clu_8fd24ae341ec0b7c", "ground_truth": {"modern_name": "Cementation", "confidence": "high", "type": "concept", "note": "Cementation refers to a process of strengthening or combining materials, used in metallurgy and alchemy.", "wikipedia_extract": "The following is an episode list for the MTV adult animated television series Beavis and Butt-Head. The series has its roots in 1992 when Mike Judge created two animated shorts, Frog Baseball and Peace, Love and Understanding, which were aired on Liquid Television. These originally aired as part of Liquid Television and did not include music videos. Mike Judge himself is highly critical of the animation and quality of these episodes, in particular the first two—\"Door to Door\" and \"Give Blood/Blood Drive\"—which he described as \"Horrible. Those first two episodes were awful, I don't know why anybody liked it... I was burying my head in the sand.\" Starting this season, the show switched to a 7-minute short act, with most of the shorts running approximately 5 minutes with one music video at the end.", "wikipedia_url": "https://en.wikipedia.org/wiki/List_of_Beavis_and_Butt-Head_episodes"}}, {"canonical_name": "comfort", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "comfort", "book_id": "kosmos_humboldt_1845", "name": "comfort", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["comfort"], "contexts": ["state of physical ease"]}, {"entity_id": "confortantes", "book_id": "polyanthea_medicinal", "name": "confortantes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["confortantes"], "contexts": ["type of medical treatment"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "comfort", "target_book": "polyanthea_medicinal", "target_name": "confortantes", "similarity": 0.907}], "id": 2025, "stable_key": "clu_bab7a2c36878b21b", "ground_truth": {"modern_name": "Fortification", "confidence": "high", "type": "concept", "note": "'Confortantes' in Polyanthea Medicinal likely refers to strengthening or fortifying remedies, aligning with the concept of comfort and support in a medical context.", "wikipedia_extract": "A fortification (also called a fort, fortress, fastness, or stronghold) is a military construction designed for the defense of territories in warfare, and is used to establish rule in a region during peacetime. The term is derived from Latin fortis (\"strong\") and facere (\"to make\"). From very early history to modern times, defensive walls have often been necessary for cities to survive in an ever-changing world of invasion and conquest. Some settlements in the Indus Valley Civilization were the first small cities to be fortified. In ancient Greece, large cyclopean stone walls fitted without mortar had been built in Mycenaean Greece, such as the ancient site of Mycenae. A Greek phrourion was a fortified collection of buildings used as a military garrison, and is the equivalent of the Roman castellum or fortress.", "wikipedia_url": "https://en.wikipedia.org/wiki/Fortification"}}, {"canonical_name": "double-refracting prism", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "double-refracting_prism", "book_id": "kosmos_humboldt_1845", "name": "double-refracting prism", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["double-refracting prism"], "contexts": ["optical instrument for light separation"]}, {"entity_id": "doubly-refracting_prism", "book_id": "connexion_physical_sciences_somerville_1858", "name": "doubly-refracting prism", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["doubly-refracting prism"], "contexts": ["optical instrument for splitting light"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "double-refracting prism", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "doubly-refracting prism", "similarity": 0.979}], "id": 2026, "stable_key": "clu_d5243fe5d404fd72", "ground_truth": {"modern_name": "Doubly-refracting prism", "confidence": "high", "type": "object", "wikipedia_extract": "Polarimetry is the measurement and interpretation of the polarization of transverse waves, most notably electromagnetic waves, such as radio or light waves. Typically polarimetry is done on electromagnetic waves that have traveled through or have been reflected, refracted or diffracted by some material in order to characterize that object. Polarimetry is used in biomedical imaging as well as remote sensing applications, such as planetary science, astronomy, and weather radar. Polarimetry of thin films and surfaces is commonly known as ellipsometry. Polarimetry can also be included in computational analysis of waves. For example, radars often consider wave polarization in post-processing to improve the characterization of the targets.", "wikipedia_url": "https://en.wikipedia.org/wiki/Polarimetry"}}, {"canonical_name": "dynamical laws", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dynamical_laws", "book_id": "kosmos_humboldt_1845", "name": "dynamical laws", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["dynamical laws"], "contexts": ["laws governing motion and forces"]}, {"entity_id": "dynamical_law", "book_id": "connexion_physical_sciences_somerville_1858", "name": "dynamical law", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["dynamical law"], "contexts": ["laws governing celestial motion"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "dynamical laws", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "dynamical law", "similarity": 0.987}], "id": 2027, "stable_key": "clu_dcaa1e29465cb2f6", "ground_truth": {"modern_name": "Laws of physics", "confidence": "high", "type": "concept", "wikidata_id": "Q214070", "wikidata_description": "scientific law of physics", "wikipedia_url": "https://en.wikipedia.org/wiki/Physical%20law"}}, {"canonical_name": "dry land", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dry_land", "book_id": "kosmos_humboldt_1845", "name": "dry land", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["dry land"], "contexts": ["mountain chains and high plains"]}, {"entity_id": "dry_land", "book_id": "connexion_physical_sciences_somerville_1858", "name": "dry land", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["dry land"], "contexts": ["comparative extent on the globe"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "dry land", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "dry land", "similarity": 1.0}], "id": 2028, "stable_key": "clu_a61af9592e78b19d", "ground_truth": {"modern_name": "Land", "confidence": "high", "type": "place", "note": "The term 'dry land' in this context refers to terrestrial regions in contrast to oceans and seas, a fundamental geographical concept.", "wikidata_id": "Q17", "wikidata_description": "island country in East Asia", "wikipedia_url": "https://en.wikipedia.org/wiki/Japan", "wikipedia_extract": "Japan is an island country in East Asia. Located in the Pacific Ocean off the northeast coast of the Asian mainland, it is bordered to the west by the Sea of Japan and extends from the Sea of Okhotsk in the north to the East China Sea in the south. The Japanese archipelago consists of four major islands alongside 14,121 smaller islands. Japan is divided into 47 administrative prefectures and eight traditional regions, and around 75% of its terrain is mountainous and heavily forested, concentrating its agriculture and highly urbanized population along its eastern coastal plains. With a population of almost 123 million as of 2026, it is the world's 11th most populous country. Tokyo is the country's capital and largest city."}}, {"canonical_name": "Royal Astronomical Society", "category": "ORGANIZATION", "subcategory": "SOCIETY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "royal_astronomical_society", "book_id": "kosmos_humboldt_1845", "name": "Royal Astronomical Society", "category": "ORGANIZATION", "subcategory": "SOCIETY", "count": 1, "variants": ["Royal Astronomical Society"], "contexts": ["society publishing astronomical reports"]}, {"entity_id": "astronomical_society", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Astronomical Society", "category": "ORGANIZATION", "subcategory": "SOCIETY", "count": 1, "variants": ["Astronomical Society"], "contexts": ["scientific society"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Royal Astronomical Society", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Astronomical Society", "similarity": 0.888}], "id": 2029, "stable_key": "clu_6327e68769388f7a", "ground_truth": {"modern_name": "Royal Astronomical Society", "confidence": "high", "type": "organization", "wikidata_id": "Q3488642", "wikidata_description": "national, non-profit, charitable organization", "wikipedia_url": "https://en.wikipedia.org/wiki/Royal%20Astronomical%20Society%20of%20Canada"}}, {"canonical_name": "geographical parallel circles", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "geographical_parallel_circles", "book_id": "kosmos_humboldt_1845", "name": "geographical parallel circles", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["geographical parallel circles"], "contexts": ["lines of constant latitude"]}, {"entity_id": "circles_or_parallels_of_latitude", "book_id": "connexion_physical_sciences_somerville_1858", "name": "circles or parallels of latitude", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["circles or parallels of latitude"], "contexts": ["lines parallel to the equator"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "geographical parallel circles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "circles or parallels of latitude", "similarity": 0.915}], "id": 2030, "stable_key": "clu_6f0c62a32191230b", "ground_truth": {"modern_name": "Lines of latitude", "confidence": "high", "type": "concept", "wikidata_id": "Q34027", "wikidata_description": "angle between zenith and a plane parallel to the equator", "wikipedia_extract": "In general, an imaginary line is usually any sort of geometric line (more generally, curves) that has only an abstract definition and does not physically exist. They are often used to properly identify places on a map. Some outside geography do exist. A centerline is a nautical term for a line down the center of a vessel lengthwise. As a geographical concept, an imaginary line may serve as an arbitrary division, such as Latitude, including the Equator, the Tropic of Capricorn and the Tropic of Cancer Longitude, the Prime Meridian Any axis about which an object spins is an imaginary line. Mason–Dixon line, which informally marks pieces of the borders of four U.S.", "wikipedia_url": "https://en.wikipedia.org/wiki/Imaginary_line"}}, {"canonical_name": "Cambridge Observatory", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cambridge_observatory", "book_id": "kosmos_humboldt_1845", "name": "Cambridge Observatory", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "count": 1, "variants": ["Cambridge Observatory"], "contexts": ["observatory in Cambridge"]}, {"entity_id": "observatory_at_cambridge", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Observatory at Cambridge", "category": "ORGANIZATION", "subcategory": "INSTITUTION", "count": 1, "variants": ["Observatory at Cambridge"], "contexts": ["astronomical research facility"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Cambridge Observatory", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Observatory at Cambridge", "similarity": 0.98}], "id": 2031, "stable_key": "clu_488d6cf5454141b2", "ground_truth": {"modern_name": "Cambridge Observatory", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q1965699", "wikidata_description": "astronomical observatory at the University of Cambridge in the East of England", "wikipedia_url": "https://en.wikipedia.org/wiki/Cambridge_Observatory"}}, {"canonical_name": "hurricane", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "hurricane", "book_id": "kosmos_humboldt_1845", "name": "hurricane", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hurricane"], "contexts": ["strong wind phenomenon"]}, {"entity_id": "roaring_hurricane", "book_id": "first_principles_spencer_1862", "name": "roaring hurricane", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["roaring hurricane"], "contexts": ["natural force from wind"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "hurricane", "target_book": "first_principles_spencer_1862", "target_name": "roaring hurricane", "similarity": 0.906}], "id": 2032, "stable_key": "clu_2218f02688b48a5b", "ground_truth": {"modern_name": "Hurricane", "confidence": "high", "type": "concept", "wikidata_id": "Q194251", "wikidata_description": "1935 fighter aircraft family by Hawker", "wikipedia_extract": "A tropical cyclone is a rapidly rotating storm system with a low-pressure area, a closed low-level atmospheric circulation, strong winds, and a spiral arrangement of thunderstorms that produce heavy rain and squalls. Depending on its location and strength, a tropical cyclone is called a hurricane (), typhoon (), tropical storm, cyclonic storm, tropical depression, or simply cyclone. A hurricane is a strong tropical cyclone that occurs in the Atlantic Ocean or northeastern Pacific Ocean. A typhoon is the same thing which occurs in the northwestern Pacific Ocean. In the Indian Ocean and South Pacific, comparable storms are referred to as \"tropical cyclones\". In modern times, on average around 80 to 90 named tropical cyclones form each year around the world, over half of which develop hurricane-force winds of 65 kn (120 km/h; 75 mph) or more.", "wikipedia_url": "https://en.wikipedia.org/wiki/Tropical_cyclone"}}, {"canonical_name": "Northern Scania", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "northern_scania", "book_id": "kosmos_humboldt_1845", "name": "Northern Scania", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Northern Scania"], "contexts": ["region in Sweden"]}, {"entity_id": "northern_greenland", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Northern Greenland", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Northern Greenland"], "contexts": ["cold of marked by Kane"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Northern Scania", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Northern Greenland", "similarity": 0.857}], "id": 2033, "stable_key": "clu_f1ecc80318aa675e", "ground_truth": {"modern_name": "Scania", "confidence": "medium", "type": "place", "country": "Sweden", "note": "Cluster contains conflicting referents: 'Northern Scania' (Sweden) and 'Northern Greenland'. Given the context of 'kosmos_humboldt_1845', Scania is the more likely intended referent as Humboldt extensively traveled and wrote about geological formations and geography. However, the presence of 'Northern Greenland' makes the identification medium confidence.", "wikipedia_extract": "Scania, also known by its native name of Skåne, is the southernmost of the historical provinces (landskap) of Sweden. Located in the south tip of the geographical region of Götaland, the province is roughly conterminous with Skåne County, created in 1997. Like the other historical provinces of Sweden, Scania still features in colloquial speech and in cultural references, and can therefore not be regarded as an archaic concept. Within Scania there are 33 municipalities that are autonomous within the Skåne Regional Council. Scania's largest city, Malmö, is the third-largest city in Sweden, as well as the fifth-largest in Scandinavia. To the north, Scania borders the historical provinces of Halland and Småland, to the northeast Blekinge, to the east and south the Baltic Sea, and to the west Öresund.", "wikipedia_url": "https://en.wikipedia.org/wiki/Scania"}}, {"canonical_name": "saltness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "saltness", "book_id": "kosmos_humboldt_1845", "name": "saltness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["saltness"], "contexts": ["degree of salt content"]}, {"entity_id": "saltness", "book_id": "connexion_physical_sciences_somerville_1858", "name": "saltness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["saltness"], "contexts": ["property of containing salt"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "saltness", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "saltness", "similarity": 1.0}], "id": 2034, "stable_key": "clu_eafc4a2bea24113a", "ground_truth": {"modern_name": "Salinity", "confidence": "high", "type": "concept", "wikidata_id": "Q14818037", "wikidata_description": "Any process that results in a change in state or activity of a cell or an organism (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a stimulus indicating an increase or decrease in the concentration of salt ("}}, {"canonical_name": "Hebrides", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "hebrides", "book_id": "kosmos_humboldt_1845", "name": "Hebrides", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Hebrides"], "contexts": ["shores receive tropical seeds"]}, {"entity_id": "new_hebrides", "book_id": "connexion_physical_sciences_somerville_1858", "name": "New Hebrides", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["New Hebrides"], "contexts": ["islands in the Pacific"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Hebrides", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "New Hebrides", "similarity": 0.919}], "id": 2035, "stable_key": "clu_bee5503a6797e647", "ground_truth": {"modern_name": "Hebrides", "confidence": "high", "type": "place", "country": "United Kingdom", "note": "The cluster contains both 'Hebrides' and 'New Hebrides'. 'Hebrides' refers to the Scottish islands, while 'New Hebrides' refers to an archipelago in the Pacific Ocean (now Vanuatu). Given the context 'shores receive tropical seeds', the New Hebrides are more likely, but the primary term 'Hebrides' refers to Scotland. The instruction is to pick the best search term. I will stick with 'Hebrides' as the primary term but acknowledge the ambiguity in the note.", "wikidata_id": "Q1971856", "wikidata_description": "portion of the North Atlantic Ocean, located off the coast of western Scotland", "wikipedia_url": "https://en.wikipedia.org/wiki/Sea_of_the_Hebrides", "wikipedia_extract": "The Sea of the Hebrides (Scottish Gaelic: An Cuan Barrach, pronounced [ən̪ˠ ˈkʰuan ˈparˠəx]) is a small and partly sheltered section of the North Atlantic Ocean, indirectly off the southern part of the north-west coast of Scotland. To the east are the mainland of Scotland and the northern Inner Hebrides (including Skye and the Small Isles); to the west are the southern Outer Hebrides islands, principally South Uist, Eriskay, and Barra. To the north is the Little Minch, a channel connecting it with the Minch. The Sea of the Hebrides forms part of the Inner Seas off the West Coast of Scotland, as defined by the International Hydrographic Organization, and part of the Seas west of Scotland as far as fisheries management is concerned. Ending on 30 August 2019, the Scottish Government consulted on a proposal to designate the Sea of the Hebrides a Marine Protected Area (MPA). The designation was confirmed in December 2020."}}, {"canonical_name": "transparent and opaque masses", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "transparent_and_opaque_masses", "book_id": "kosmos_humboldt_1845", "name": "transparent and opaque masses", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["transparent and opaque masses"], "contexts": ["materials with different light properties"]}, {"entity_id": "colourless_transparent_media", "book_id": "connexion_physical_sciences_somerville_1858", "name": "colourless transparent media", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["colourless transparent media"], "contexts": ["transmit white light"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "transparent and opaque masses", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "colourless transparent media", "similarity": 0.863}], "id": 2036, "stable_key": "clu_75ad136aa0af5810", "ground_truth": {"modern_name": "transparent and opaque materials", "confidence": "medium", "type": "concept", "note": "This refers to materials based on their light transmission properties, not a specific substance.", "wikidata_id": "Q2643571", "wikidata_description": "property of light and its interaction with substances or objects", "wikipedia_url": "https://en.wikipedia.org/wiki/Optical_properties", "wikipedia_extract": "The optical properties of a material define how it interacts with light. The optical properties of matter are studied in optical physics (a subfield of optics) and applied in materials science. The optical properties of matter include: Transmittance and Transmission coefficient Reflectance and Reflectivity (reflection coefficient) A basic distinction is between isotropic materials, which exhibit the same properties regardless of the direction of the light, and anisotropic ones, which exhibit different properties when light passes through them in different directions. The optical properties of matter can lead to a variety of interesting optical phenomena. Optical properties of carbon nanotubes Fox, Mark (2010). Optical properties of solids."}}, {"canonical_name": "theory of terrestrial refraction", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "theory_of_terrestrial_refraction", "book_id": "kosmos_humboldt_1845", "name": "theory of terrestrial refraction", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["theory of terrestrial refraction"], "contexts": ["theory about light bending in atmosphere"]}, {"entity_id": "terrestrial_refraction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Terrestrial Refraction", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["Terrestrial Refraction"], "contexts": ["bending of light by atmosphere near earth"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "theory of terrestrial refraction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Terrestrial Refraction", "similarity": 0.962}], "id": 2037, "stable_key": "clu_555501f911422cec", "ground_truth": {"modern_name": "terrestrial refraction", "confidence": "high", "type": "concept", "wikidata_id": "Q254634", "wikidata_description": "deviation of light or other electromagnetic wave from a straight line as it passes through the atmosphere", "wikipedia_url": "https://en.wikipedia.org/wiki/Atmospheric_refraction", "wikipedia_extract": "The sunrise equation or sunset equation can be used to derive the time of sunrise or sunset for any solar declination and latitude in terms of local solar time when sunrise and sunset actually occur. {\\displaystyle \\cos \\omega _{\\circ }=-\\tan \\phi \\times \\tan \\delta } is the solar hour angle at either sunrise (when negative value is taken) or sunset (when positive value is taken); is the latitude of the observer on the Earth; The Earth rotates at an angular velocity of 15°/hour. Therefore, the expression {\\displaystyle \\omega _{\\circ }/\\mathrm {15} ^{\\circ }} is in degree, gives the interval of time in hours from sunrise to local solar noon or from local solar noon to sunset. The sign convention is typically that the observer latitude is 0 at the equator, positive for the Northern Hemisphere and negative for the Southern Hemisphere, and the solar declination is 0 at the vernal and autumnal equinoxes when the sun is exactly above the equator, positive during the Northern Hemisphere summer and negative during the Northern Hemisphere winter. The expression above is always applicable for latitudes between the Arctic Circle and Antarctic Circle. North of the Arctic Circle or south of the Antarctic Circle, there is at least one day of the year with no sunrise or sunset."}}, {"canonical_name": "Ericeta", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ericeta", "book_id": "kosmos_humboldt_1845", "name": "Ericeta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Ericeta"], "contexts": ["heath in Europe"]}, {"entity_id": "ericas", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Ericas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Ericas"], "contexts": ["fourth vegetation zone on volcano"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Ericeta", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Ericas", "similarity": 0.912}], "id": 2038, "stable_key": "clu_8aea9576d6a9b37d", "ground_truth": {"modern_name": "Heath", "confidence": "medium", "type": "plant", "family": "Ericaceae", "note": "The term 'Ericeta' and 'Ericas' refers to plants of the genus Erica (heaths). While a specific Linnaean name isn't provided and multiple species exist, the family Ericaceae is identifiable.", "wikipedia_extract": "Sir Edward Richard George Heath (9 July 1916 – 17 July 2005) was a British politician who served as Prime Minister of the United Kingdom from 1970 to 1974 and Leader of the Conservative Party from 1965 to 1975. Heath also served for 51 years as a Member of Parliament from 1950 to 2001. Outside politics, Heath was a yachtsman, a musician, and an author. Born in Broadstairs, Kent, Heath was the son of a chambermaid and carpenter. He attended Chatham House Grammar School in Ramsgate, Kent, and became a leader within student politics while studying at Balliol College at the University of Oxford. During World War II, Heath served as an officer in the Royal Artillery.", "wikipedia_url": "https://en.wikipedia.org/wiki/Edward_Heath"}}, {"canonical_name": "Neetee", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "neetee", "book_id": "kosmos_humboldt_1845", "name": "Neetee", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Neetee"], "contexts": ["village and pass in Uttarakhand, India"]}, {"entity_id": "neetee", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Neetee", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Neetee"], "contexts": ["location on Moorcroft's route"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Neetee", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Neetee", "similarity": 1.0}], "id": 2039, "stable_key": "clu_097bbea6316b7f9d", "ground_truth": {"modern_name": "Niti Pass", "confidence": "high", "type": "place", "country": "India", "wikidata_id": "Q2982089", "wikidata_description": "", "wikipedia_extract": "The 1954 Sino-Indian Agreement, also called the Panchsheel Agreement, officially the Agreement on Trade and Intercourse Between Tibet Region and India, was signed by China and India in Peking on 29 April 1954. The preamble of the agreement stated the panchsheel, or  the five principles of peaceful coexistence, that China proposed and India favoured. The agreement reflected the adjustment of the previously existing trade relations between Tibet and India to the changed context of India's decolonisation and China's assertion of suzerainty over Tibet. Bertil Lintner writes that in the agreement, \"Tibet was referred to, for the first time in history, as 'the Tibet Region of China'\". The agreement expired on 6 June 1962, as per the original term limit, in the midst of the Sino-Indian border tensions. It was not renewed.", "wikipedia_url": "https://fr.wikipedia.org/wiki/Col_de_Niti"}}, {"canonical_name": "New Bedford", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "new_bedford", "book_id": "kosmos_humboldt_1845", "name": "New Bedford", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["New Bedford"], "contexts": ["location where comet was observed"]}, {"entity_id": "bedford", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bedford", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bedford"], "contexts": ["location of Admiral Smyth's observatory"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "New Bedford", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bedford", "similarity": 0.881}], "id": 2040, "stable_key": "clu_3b70a65c9c265212", "ground_truth": {"modern_name": "New Bedford", "confidence": "high", "type": "place", "country": "United States", "wikidata_id": "Q49147", "wikidata_description": "city in Bristol County, Massachusetts, United States", "wikipedia_extract": "New Bedford is a city in Bristol County, Massachusetts, United States. It is located on the Acushnet River in what is known as the South Coast region, abutting Buzzards Bay. At the 2020 census, New Bedford had a population of 101,079, making it the state's ninth-largest city and the largest of the South Coast region. It is the second-largest city in the Providence metropolitan area and included in the greater Boston combined statistical area. Up through the 17th century, the area was the territory of the Wampanoag Indians. English colonists bought the land on which New Bedford would later be built from the Wampanoag in 1652, and the original colonial settlement that would later become the city was founded by English Quakers in the late 17th century.", "wikipedia_url": "https://en.wikipedia.org/wiki/New_Bedford,_Massachusetts"}}, {"canonical_name": "apes", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "apes", "book_id": "kosmos_humboldt_1845", "name": "apes", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["apes"], "contexts": ["mammals inhabiting Kashmir chestnut-tree"]}, {"entity_id": "apis", "book_id": "first_principles_spencer_1862", "name": "Apis", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Apis"], "contexts": ["deity represented by a bull"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "apes", "target_book": "first_principles_spencer_1862", "target_name": "Apis", "similarity": 0.895}], "id": 2041, "stable_key": "clu_4a331a1f39b146af", "ground_truth": {"modern_name": "Apes", "confidence": "low", "type": "animal", "note": "The context is contradictory. 'apes' usually refers to primates. However, 'Apis' is a genus of bees and is also contextually linked to a deity represented by a bull. Given the early modern scientific context and the mention of Kashmir, it is most likely referring to primates (apes). The mention of 'Apis' might be an OCR error or a very obscure secondary reference.", "wikidata_id": "Q63248282", "wikidata_description": "family name", "wikipedia_extract": "The Hominidae (; hominids ), whose members are known as the great apes, are a taxonomic family of primates that includes eight extant species in four genera: Pongo (the Bornean, Sumatran and Tapanuli orangutan); Gorilla (the eastern and western gorilla); Pan (the chimpanzee and the bonobo); and Homo, of which only modern humans (Homo sapiens) remain. Numerous revisions in classifying the great apes have caused the use of the term hominid to change over time. The original meaning of \"hominid\" referred only to humans (Homo) and their closest extinct relatives. However, by the 1990s humans and other apes were considered to be \"hominids\". The earlier restrictive meaning has now been largely assumed by the term hominin, which however additionally includes Pan. Hominins more closely related to humans than to Pan are called Hominina, while the current meaning of \"hominid\" includes all the great apes including humans.", "wikipedia_url": "https://en.wikipedia.org/wiki/Hominidae"}}, {"canonical_name": "inverted dome", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "inverted_dome", "book_id": "kosmos_humboldt_1845", "name": "inverted dome", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["inverted dome"], "contexts": ["Etruscan figure of 'mundus'"]}, {"entity_id": "inclined_plane", "book_id": "first_principles_spencer_1862", "name": "inclined plane", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["inclined plane"], "contexts": ["simple machine to move heavy objects"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "inverted dome", "target_book": "first_principles_spencer_1862", "target_name": "inclined plane", "similarity": 0.841}], "id": 2042, "stable_key": "clu_005c0a7239b375eb", "ground_truth": {"modern_name": "inverted dome", "confidence": "low", "type": "concept", "note": "The cluster presents two distinct concepts: 'inverted dome' and 'inclined plane', with no clear unifying theme beyond being architectural or mechanical elements. They are likely unrelated entities that have been grouped. 'inverted dome' is a geometric/architectural concept.", "wikidata_id": "Q12493", "wikidata_description": "architectural element that resembles the hollow upper half of a sphere", "wikipedia_url": "https://en.wikipedia.org/wiki/Dome"}}, {"canonical_name": "Giordano Bruno", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "giordano_bruno", "book_id": "kosmos_humboldt_1845", "name": "Giordano Bruno", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Giordano Bruno"], "contexts": ["author of philosophical work"]}, {"entity_id": "giordano_bruno", "book_id": "first_principles_spencer_1862", "name": "Giordano Bruno", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Giordano Bruno"], "contexts": ["Renaissance philosopher and cosmologist"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Giordano Bruno", "target_book": "first_principles_spencer_1862", "target_name": "Giordano Bruno", "similarity": 1.0}], "id": 2043, "stable_key": "clu_fdd1dcb9603c65e9", "ground_truth": {"modern_name": "Giordano Bruno", "confidence": "high", "type": "person", "birth_year": 1548, "death_year": 1600, "description": "Renaissance philosopher, astronomer, and mathematician.", "wikidata_id": "Q36330", "wikidata_description": "Italian Dominican friar, philosopher and mathematician (1548–1600)", "wikipedia_url": "https://en.wikipedia.org/wiki/Giordano_Bruno", "wikipedia_extract": "The unicursal hexagram is a hexagram or six-pointed star that can be traced or drawn unicursally, in one continuous line rather than by two overlaid triangles. The hexagram can also be depicted inside a circle with the points touching it. It is often depicted in an interlaced form with the lines of the hexagram passing over and under one another to form a knot. It is a specific instance of the far more general shape discussed in Blaise Pascal's 1639 Hexagrammum Mysticum. In his work titled Essays upon the Mathematics of Mordente: One Hundred and Sixty Articles against the Mathematicians and Philosophers of this Age (Prague: 1588), Italian philosopher, cosmological theorist, and Hermetic occultist Giordano Bruno used a symbol called Figura Amoris (\"figure of love\") part of the Hermetic trinity in his mathesis. This figure has a square outline; within it are the six lines of a unicursal hexagram."}}, {"canonical_name": "Journal", "category": "ORGANIZATION", "subcategory": "JOURNAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "journal", "book_id": "kosmos_humboldt_1845", "name": "Journal", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["Journal"], "contexts": ["Darwin's publication on geological observations"]}, {"entity_id": "journal", "book_id": "first_principles_spencer_1862", "name": "journal", "category": "ORGANIZATION", "subcategory": "JOURNAL", "count": 1, "variants": ["journal"], "contexts": ["publication for scientific articles"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Journal", "target_book": "first_principles_spencer_1862", "target_name": "journal", "similarity": 0.978}], "id": 2044, "stable_key": "clu_ec6de8ebac0a501c", "ground_truth": {"modern_name": "scientific journal", "confidence": "high", "type": "text", "note": "The context 'Darwin's publication on geological observations' is highly suggestive of a scientific journal, though the term itself is general.", "wikidata_id": "Q5633421", "wikidata_description": "periodical journal publishing scientific research", "wikipedia_url": "https://en.wikipedia.org/wiki/Scientific%20journal"}}, {"canonical_name": "swamps", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "swamps", "book_id": "kosmos_humboldt_1845", "name": "swamps", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["swamps"], "contexts": ["wet, marshy land"]}, {"entity_id": "swamps", "book_id": "first_principles_spencer_1862", "name": "swamps", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["swamps"], "contexts": ["wet, marshy land"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "swamps", "target_book": "first_principles_spencer_1862", "target_name": "swamps", "similarity": 1.0}], "id": 2045, "stable_key": "clu_b6cb1651894ff683", "ground_truth": {"modern_name": "swamp", "confidence": "high", "type": "place", "country": "Various", "wikidata_id": "Q19000458", "wikidata_description": "horse disease caused by a retrovirus and transmitted by bloodsucking insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Equine_infectious_anemia", "wikipedia_extract": "Equine infectious anemia or equine infectious anaemia (EIA), also known by horsemen as swamp fever, is a horse disease caused by a retrovirus (Equine infectious anemia virus) and transmitted by bloodsucking insects. The virus (EIAV) is endemic in the Americas, parts of Europe, the Middle and Far East, Russia, and South Africa. The virus is a lentivirus, like human immunodeficiency virus (HIV). Like HIV, EIA can be transmitted through blood, milk, and body secretions. Transmission is primarily through biting flies, such as the horse-fly and deer-fly. The virus survives up to 4 hours in the vector."}}, {"canonical_name": "Elephantia", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "elephantia", "book_id": "historia_medicinal_monardes_1574", "name": "Elephantia", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["Elephantia"], "contexts": ["disease name, possibly elephantiasis"]}, {"entity_id": "elefancia", "book_id": "coloquios_da_orta_1563", "name": "elefancia", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["elefancia"], "contexts": ["disease named after elephant"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Elephantia", "target_book": "coloquios_da_orta_1563", "target_name": "elefancia", "similarity": 0.904}], "id": 2046, "stable_key": "clu_b8c66e6929fb944c", "ground_truth": {"modern_name": "Elephantiasis", "confidence": "high", "type": "disease", "modern_term": "Elephantiasis", "note": "The Portuguese 'elefancia' and Spanish 'Elephantia' both directly refer to elephantiasis.", "wikidata_id": "Q192100", "wikidata_description": "human disease caused by parasitic worms", "wikipedia_url": "https://en.wikipedia.org/wiki/Lymphatic_filariasis", "wikipedia_extract": "Lymphatic filariasis is a human disease caused by parasitic worms known as filarial worms. Usually acquired in childhood, it is a leading cause of permanent disability worldwide, impacting over a hundred million people and manifesting itself in a variety of severe clinical pathologies. While most cases have no symptoms, some people develop a syndrome called elephantiasis, which is marked by severe swelling in the arms, legs, breasts, or genitals. The skin may become thicker as well, and the condition may become painful. Affected people are often unable to work and are often shunned or rejected by others because of their disfigurement and disability. It is the first mosquito-borne disease directly linked to mosquitoes."}}, {"canonical_name": "sedades", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sedades", "book_id": "historia_medicinal_monardes_1574", "name": "sedades", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["sedades"], "contexts": ["affliction treated with gargaparrilla water"]}, {"entity_id": "sede", "book_id": "coloquios_da_orta_1563", "name": "sede", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["sede"], "contexts": ["condition of captive animals"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "sedades", "target_book": "coloquios_da_orta_1563", "target_name": "sede", "similarity": 0.874}], "id": 2047, "stable_key": "clu_d49dcef364b548c6", "ground_truth": {"modern_name": "hemorrhoids", "confidence": "medium", "type": "disease", "modern_term": "Hemorrhoids", "note": "The context is extremely vague. 'sedades' and 'sede' do not directly translate to a common disease. The connection to 'gargaparrilla water' and 'captive animals' is speculative and may point to other conditions like dysentery or inflammation. However, hemorrhoids are a plausible ailment treated with herbal remedies. Further context is needed for higher confidence.", "wikidata_id": "Q41478", "wikidata_description": "vascular structures in the anal canal", "wikipedia_extract": "Diosmin (diosmetin 7-O-rutinoside), a flavone glycoside of diosmetin, is manufactured from citrus fruit peels as a phlebotonic non-prescription dietary supplement used to aid treatment of hemorrhoids or chronic venous diseases, mainly of the legs. Diosmin is a dietary supplement used to aid treatment of hemorrhoids and venous diseases, i.e., chronic venous insufficiency including spider and varicose veins, leg swelling (edema), stasis dermatitis and venous ulcers. The mechanism of action of Diosmin and other phlebotonics is undefined, and clinical evidence of benefit is limited. Diosmin is not recommended for treating the rectal mucosa, skin irritations, or wounds, and should not be used to treat dermatitis, eczema, or urticaria. Diosmin is not recommended for use in children or women during pregnancy. There is moderate-quality evidence that diosmin or other phlebotonics improved leg and ankle swelling and lower leg pain, and low-quality evidence for treating hemorrhoids.", "wikipedia_url": "https://en.wikipedia.org/wiki/Diosmin"}}, {"canonical_name": "sedago", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sedago", "book_id": "historia_medicinal_monardes_1574", "name": "sedago", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["sedago"], "contexts": ["sediment"]}, {"entity_id": "sedas", "book_id": "coloquios_da_orta_1563", "name": "sedas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["sedas"], "contexts": ["goods traded at Ormuz"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "sedago", "target_book": "coloquios_da_orta_1563", "target_name": "sedas", "similarity": 0.912}], "id": 2048, "stable_key": "clu_e13dada9bf0e03f9", "ground_truth": {"modern_name": "silk", "confidence": "medium", "type": "substance", "note": "The Portuguese 'sedas' directly means 'silks'. The Spanish 'sedago' is less clear but could be a corruption or a related textile term. Given the context of trade at Ormuz, silk is a highly probable commodity.", "wikidata_id": "Q134747", "wikidata_description": "insect from the moth family", "wikipedia_extract": "Bombyx mori, commonly known as the domestic silk moth, is a domesticated moth species belonging to the family Bombycidae. It is the closest relative of Bombyx mandarina, the wild silk moth. Silkworms are the larvae of silk moths. The silkworm is of particular economic value, being a primary producer of silk. The silkworm's preferred food are the leaves of white mulberry, though they may eat other species of mulberry, and even leaves of other plants. Domestic silk moths are entirely dependent on humans for reproduction, as a result of millennia of selective breeding.", "wikipedia_url": "https://en.wikipedia.org/wiki/Bombyx_mori"}}, {"canonical_name": "partes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "partes", "book_id": "historia_medicinal_monardes_1574", "name": "partes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["partes"], "contexts": ["regions from which people come"]}, {"entity_id": "outras_muytas_partes", "book_id": "coloquios_da_orta_1563", "name": "outras muytas partes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["outras muytas partes"], "contexts": ["many other places"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "partes", "target_book": "coloquios_da_orta_1563", "target_name": "outras muytas partes", "similarity": 0.89}], "id": 2049, "stable_key": "clu_3f64b411cabaa88a", "ground_truth": {"wikipedia_extract": "Parteš (Serbian Cyrillic: Партеш) or Partesh (Albanian definite form: Parteshi), is a town and municipality located in the Gjilan District of Kosovo. The municipality was established on 19 August 2010. It is inhabited by Serbs, and as of 2013, it has an estimated population of 5,300 inhabitants. The municipality consists of town of Parteš and two villages: Pasjane and Donja Budriga. The settlements of Parteš, Donja Budriga and Pasjane are inhabited by ethnic Serbs. There are four Serbian Orthodox churches within the municipality."}}, {"canonical_name": "region caliente", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "region_caliente", "book_id": "historia_medicinal_monardes_1574", "name": "region caliente", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["region caliente"], "contexts": ["climate affecting medicine intake"]}, {"entity_id": "regiões_quentes", "book_id": "coloquios_da_orta_1563", "name": "regiões quentes", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["regiões quentes"], "contexts": ["hot geographical areas"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "region caliente", "target_book": "coloquios_da_orta_1563", "target_name": "regiões quentes", "similarity": 0.96}], "id": 2050, "stable_key": "clu_b2f0307463b73fb2", "ground_truth": {"modern_name": "hot region", "confidence": "high", "type": "place", "country": "Various", "wikipedia_extract": "\"Hot\" is a song recorded by South Korean girl group Le Sserafim for their fifth extended play of the same name. It was released as the EP's lead single by Source Music on March 14, 2025. The music video was released on the same day. A remix version of the track featuring English singer Jade, was released on April 14, 2025. On February 16, 2025, Source Music announced that Le Sserafim would release Hot, their fifth extended play, on March 14. A trailer, titled \"Born Fire,\" was released on February 21.", "wikipedia_url": "https://en.wikipedia.org/wiki/Hot_(Le_Sserafim_song)"}}, {"canonical_name": "cordial", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cordial", "book_id": "historia_medicinal_monardes_1574", "name": "cordial", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cordial"], "contexts": ["substance that strengthens the heart"]}, {"entity_id": "cordial", "book_id": "coloquios_da_orta_1563", "name": "cordial", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cordial"], "contexts": ["medicinal property of sandalwood"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "cordial", "target_book": "coloquios_da_orta_1563", "target_name": "cordial", "similarity": 1.0}], "id": 2051, "stable_key": "clu_4d460ab02ccf648a", "ground_truth": {"modern_name": "heart tonic", "confidence": "high", "type": "concept"}}, {"canonical_name": "Sciría", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sciría", "book_id": "historia_medicinal_monardes_1574", "name": "Sciría", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Sciría"], "contexts": ["country in Syria"]}, {"entity_id": "sjrría", "book_id": "coloquios_da_orta_1563", "name": "Sjrría", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Sjrría"], "contexts": ["Syria"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Sciría", "target_book": "coloquios_da_orta_1563", "target_name": "Sjrría", "similarity": 0.855}], "id": 2052, "stable_key": "clu_5285aa268e6a374f", "ground_truth": {"modern_name": "Syria", "confidence": "high", "type": "place", "country": "Syria", "wikidata_id": "Q21441670", "wikidata_description": "subgenus of insects", "wikipedia_extract": "The Syrian civil war was an armed conflict that began with the Syrian revolution in March 2011, when popular discontent with the Ba'athist regime ruled by Bashar al-Assad triggered large-scale protests and pro-democracy rallies across Syria, as part of the wider Arab Spring. The Assad regime responded to the protests with lethal force, which led to a series of defections, the emergence of armed opposition groups, and the civilian uprising descending into a civil war. The war lasted almost 14 years and culminated in the fall of the Assad regime in December 2024. Many sources regard this as the end of the civil war. Post-war clashes and disputes have continued into 2026. The Syrian opposition to Bashar al-Assad began as an insurgency, forming groups such as the Free Syrian Army.", "wikipedia_url": "https://en.wikipedia.org/wiki/Syrian_civil_war"}}, {"canonical_name": "Licenciado Luys de Cueva", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "licenciado_luys_de_cueva", "book_id": "historia_medicinal_monardes_1574", "name": "Licenciado Luys de Cueva", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["Licenciado Luys de Cueva"], "contexts": ["physician administering medicine"]}, {"entity_id": "luis_de_cueva", "book_id": "coloquios_da_orta_1563", "name": "Luis de Cueva", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["Luis de Cueva"], "contexts": ["licensed practitioner who was poisoned"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Licenciado Luys de Cueva", "target_book": "coloquios_da_orta_1563", "target_name": "Luis de Cueva", "similarity": 0.846}], "id": 2053, "stable_key": "clu_7c9f8c4aaa5f6228", "ground_truth": {"modern_name": "Luís de Cueva", "confidence": "high", "type": "person", "description": "Spanish physician and licensed practitioner, known for being poisoned.", "wikipedia_extract": "Bahía de las Águilas (Spanish: [baˈia ðe las ˈaɣilas]; literally \"Eagles’ Bay\"), is an 8 km-long (5 mi) beach along the southwestern coast of the Dominican Republic in the province of Pedernales near the southernmost part of the land border with Haiti. The bay is part of the Jaragua National Park, and it is considered one of the most crystalline beaches in the world, according to some travel opinion writers. The bay is a protected area as is the surrounding park; hence there is an abundance of sea life a few steps off the beach within its waters. The beach is utterly isolated. 323 km from Santo Domingo and approximately 25 km from Pedernales (the nearest town), this beach stands out in the middle of the deserted steppe of the park. Departing from Pedernales, one reaches a small village called \"La Cueva\" (\"The Cave\") so named because of the numerous caves surrounding the village, which up until 2007, were occupied by local fishermen.", "wikipedia_url": "https://en.wikipedia.org/wiki/Bahía_de_las_Águilas"}}, {"canonical_name": "naoVictoria", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "naovictoria", "book_id": "historia_medicinal_monardes_1574", "name": "naoVictoria", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["naoVictoria"], "contexts": ["The ship Victoria, circumnavigated the world"]}, {"entity_id": "nau_victoria", "book_id": "coloquios_da_orta_1563", "name": "nau Victoria", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["nau Victoria"], "contexts": ["Ship that returned from voyage"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "naoVictoria", "target_book": "coloquios_da_orta_1563", "target_name": "nau Victoria", "similarity": 0.883}], "id": 2054, "stable_key": "clu_b388fadab3cee03b", "ground_truth": {"modern_name": "Victoria (ship)", "confidence": "high", "type": "object", "wikidata_id": "Q86573224", "wikidata_description": "researcher"}}, {"canonical_name": "conforta", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "conforta", "book_id": "historia_medicinal_monardes_1574", "name": "conforta", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["conforta"], "contexts": ["effect of Sulfur"]}, {"entity_id": "confortativo", "book_id": "coloquios_da_orta_1563", "name": "confortativo", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["confortativo"], "contexts": ["comforting quality"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "conforta", "target_book": "coloquios_da_orta_1563", "target_name": "confortativo", "similarity": 0.946}], "id": 2055, "stable_key": "clu_affb730fc731f5e7", "ground_truth": {"modern_name": "Comforting property", "confidence": "medium", "type": "concept", "note": "The term 'conforta'/'confortativo' in early modern texts referred to a general property of providing comfort or strength, not a specific modern concept."}}, {"canonical_name": "pan", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pan", "book_id": "historia_medicinal_monardes_1574", "name": "pan", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["pan"], "contexts": ["food made from grain"]}, {"entity_id": "pan", "book_id": "coloquios_da_orta_1563", "name": "pan", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["pan"], "contexts": ["another name for betle leaf"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "pan", "target_book": "coloquios_da_orta_1563", "target_name": "pan", "similarity": 0.873}], "id": 2056, "stable_key": "clu_99ad2ab9551fd3b6", "ground_truth": {"modern_name": "Betel leaf", "confidence": "low", "type": "plant", "note": "The term 'pan' is ambiguous. In the context of the Monardes text, it likely refers to bread or food from grain. However, one mention in the 'Coloquios da Orta' suggests 'pan' might be a misspelling or colloquialism for 'betel' or a similar plant leaf used for chewing, especially given the geographical context of the text (Asia/Americas). Further context from the original texts is needed for certainty.", "wikidata_id": "Q130149531", "wikidata_description": "scholarly article published on 25 January 2018", "wikipedia_extract": "The areca nut ( or ) or betel nut () is the fruit of the areca palm (Areca catechu). The palm is originally native to the Philippines, but was carried widely through the tropics by the Austronesian migrations and trade since at least 1500 BCE due to its use in betel nut chewing. It is widespread in cultivation and is considered naturalized in much of the tropical Pacific (Melanesia and Micronesia), South Asia, Southeast Asia, and parts of east Africa. It is not to be confused with betel (Piper betle) leaves that are often used to wrap it. The practice of betel nut chewing, often together with other herbs as a stimulant drug, dates back thousands of years, and continues to the present day in many countries. Betel nut chewing is addictive due to the presence of the stimulant arecoline and causes adverse health effects—mainly oral and esophageal cancers, as well as cardiovascular disease.", "wikipedia_url": "https://en.wikipedia.org/wiki/Areca_nut"}}, {"canonical_name": "anímales", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "anímales", "book_id": "historia_medicinal_monardes_1574", "name": "anímales", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["anímales"], "contexts": ["animals"]}, {"entity_id": "animadi", "book_id": "ricettario_fiorentino_1597", "name": "animadi", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["animadi"], "contexts": ["inner part of roots"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "anímales", "target_book": "ricettario_fiorentino_1597", "target_name": "animadi", "similarity": 0.849}], "id": 2057, "stable_key": "clu_d4bcf1bc7ef39d6e", "ground_truth": {"modern_name": "Animal matter", "confidence": "medium", "type": "chemical", "note": "The term 'anímales' is broad and could refer to animal products or substances. 'Animadi' in the Florentine Ricettario could potentially refer to the 'anima' or vital spirit of plants/roots, or animal parts. Without more context, 'animal matter' is a plausible, but not definitive, modern referent for the Monardes text, while the Florentine Ricettario entry is highly uncertain.", "wikipedia_extract": "This is a list of herbivorous animals, organized in a roughly taxonomic manner. In general, entries consist of animal species known with good certainty to be overwhelmingly herbivorous, as well as genera and families which contain a preponderance of such species. Herbivorous animals are heterotrophs, meaning that they consume other organisms for sustenance. The organisms which herbivores consume are primary producers, predominantly plants (including algae). Herbivores which consume land plants may eat any or all of the fruit, leaves, sap, nectar, pollen, flowers, bark, cambium, underground storage organs like roots, tubers, and rhizomes, nuts, seeds, shoots, and other parts of plants; they frequently specialize in one or a few of these parts, though many herbivores also have quite diverse diets. Animal diets are not inflexible, and most animals will stray from their typical diet on occasion; for instance, cattle will eat chicks, and crocodiles will consume fruit.", "wikipedia_url": "https://en.wikipedia.org/wiki/List_of_herbivorous_animals"}}, {"canonical_name": "cichora", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cichora", "book_id": "historia_medicinal_monardes_1574", "name": "cichora", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["cichora"], "contexts": ["plant species"]}, {"entity_id": "citerne", "book_id": "ricettario_fiorentino_1597", "name": "citerne", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["citerne"], "contexts": ["water collected and preserved in cisterns"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "cichora", "target_book": "ricettario_fiorentino_1597", "target_name": "citerne", "similarity": 0.869}], "id": 2058, "stable_key": "clu_878dab24b08847e0", "ground_truth": {"modern_name": "Chicory", "confidence": "high", "type": "plant", "linnaean": "Cichorium intybus Linnaeus", "family": "Asteraceae", "note": "The term 'cichora' strongly suggests chicory. The 'citerne' in the Florentine Ricettario is a significant outlier and likely an OCR error or unrelated term, as it refers to a water reservoir. The prompt asks for a referent for the cluster, and the primary term 'cichora' clearly points to chicory. The outlier is noted.", "wikipedia_extract": "Endive () is a leaf vegetable belonging to the genus Cichorium, which includes several similar bitter-leafed vegetables. Species include Cichorium endivia (also called endive), Cichorium pumilum (also called wild endive), and Cichorium intybus (also called chicory). Chicory includes types such as radicchio, puntarelle, and Belgian endive. There is considerable confusion between Cichorium endivia and Cichorium intybus. There are two main varieties of cultivated C. endivia chicon: Curly endive, or frisée (var.", "wikipedia_url": "https://en.wikipedia.org/wiki/Endive"}}, {"canonical_name": "fame", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fame", "book_id": "historia_medicinal_monardes_1574", "name": "fame", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["fame"], "contexts": ["hunger"]}, {"entity_id": "fame", "book_id": "polyanthea_medicinal", "name": "fame", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["fame"], "contexts": ["hunger"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "fame", "target_book": "polyanthea_medicinal", "target_name": "fame", "similarity": 1.0}], "id": 2059, "stable_key": "clu_0fd59fe30518c4d8", "ground_truth": {"modern_name": "Hunger", "confidence": "high", "type": "disease", "modern_term": "Starvation", "note": "While 'starvation' is the extreme form, 'hunger' is the direct translation and the concept itself.", "wikidata_id": "Q37309248", "wikidata_description": "family name", "wikipedia_extract": "Muselmann (German plural Muselmänner) was a term used amongst prisoners of German Nazi concentration camps during the Holocaust of World War II to refer to those suffering from a combination of starvation (known also as \"hunger disease\") and exhaustion, as well as those who were resigned to their impending death. The Muselmann prisoners exhibited severe emaciation and physical weakness, an apathetic listlessness regarding their own fate, and unresponsiveness to their surroundings owing to their barbaric treatment. Some scholars argue that the term possibly comes from the Muselmanns' inability to stand for any time due to the loss of leg muscle, thus leading them to spend much of their time in a prone position. Muselmann also literally means \"a Muslim\" in Yiddish and a number of other languages (albeit with spelling differences), and ultimately derives from the Old Turkish word for Muslim, مسلمان (müsliman). \"Muselmann\" seemingly derives from the German: Muselman, a historical term for \"Muslim\" (literally 'mussulman') which is now considered derogatory. If this derivation is correct, \"Muselmann\" would literally mean \"Muslim man\" (Muselman + Mann); but how this term later came to be used to denote starving concentration camp prisoners is uncertain.", "wikipedia_url": "https://en.wikipedia.org/wiki/Hunger"}}, {"canonical_name": "calor de los riñónes", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "calor_de_los_riñónes", "book_id": "historia_medicinal_monardes_1574", "name": "calor de los riñónes", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["calor de los riñónes"], "contexts": ["heat in the kidneys"]}, {"entity_id": "calor_dos_nervos", "book_id": "polyanthea_medicinal", "name": "calor dos nervos", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["calor dos nervos"], "contexts": ["natural heat of nerves"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "calor de los riñónes", "target_book": "polyanthea_medicinal", "target_name": "calor dos nervos", "similarity": 0.844}], "id": 2060, "stable_key": "clu_3085b6029e0c314f", "ground_truth": {"modern_name": "Natural heat", "confidence": "high", "type": "concept", "note": "This refers to the concept of innate warmth or vital heat within the body, particularly in the kidneys or nerves, as understood in humoral theory.", "wikipedia_extract": "A heat exchanger is a system used to transfer heat between a source and a working fluid. Heat exchangers are used in both cooling and heating processes. The fluids may be separated by a solid wall to prevent mixing or they may be in direct contact. They are widely used in space heating, refrigeration, air conditioning, power stations, chemical plants, petrochemical plants, petroleum refineries, natural-gas processing, and sewage treatment. The classic example of a heat exchanger is found in an internal combustion engine in which a circulating fluid known as engine coolant flows through radiator coils and air flows past the coils, which cools the coolant and heats the incoming air. Another example is the heat sink, which is a passive heat exchanger that transfers the heat generated by an electronic or a mechanical device to a fluid medium, often air or a liquid coolant.", "wikipedia_url": "https://en.wikipedia.org/wiki/Heat_exchanger"}}, {"canonical_name": "Chirúrgia", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "chirúrgia", "book_id": "historia_medicinal_monardes_1574", "name": "Chirúrgia", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Chirúrgia"], "contexts": ["surgical intervention"]}, {"entity_id": "cirurgicas_operaciones", "book_id": "polyanthea_medicinal", "name": "cirurgicas operaciones", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["cirurgicas operaciones"], "contexts": ["surgical procedures"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Chirúrgia", "target_book": "polyanthea_medicinal", "target_name": "cirurgicas operaciones", "similarity": 0.924}], "id": 2061, "stable_key": "clu_00ba82be8183d93a", "ground_truth": {"modern_name": "Surgery", "confidence": "high", "type": "concept", "note": "Refers to the medical practice of performing operations.", "wikidata_id": "Q600236", "wikidata_description": "instrumental medical procedure on or in the body of a patient", "wikipedia_url": "https://en.wikipedia.org/wiki/Surgical%20operation"}}, {"canonical_name": "Gijarros de rio", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "gijarros_de_rio", "book_id": "historia_medicinal_monardes_1574", "name": "Gijarros de rio", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Gijarros de rio"], "contexts": ["river pebbles, stones found in abundance"]}, {"entity_id": "seixos_do_rio", "book_id": "polyanthea_medicinal", "name": "seixos do rio", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["seixos do rio"], "contexts": ["stones used in vinegar preparation"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Gijarros de rio", "target_book": "polyanthea_medicinal", "target_name": "seixos do rio", "similarity": 0.86}], "id": 2062, "stable_key": "clu_02c3fa642102433c", "ground_truth": {"modern_name": "River pebbles", "confidence": "high", "type": "mineral", "note": "Small, smooth stones found in rivers, used medicinally or in preparations."}}, {"canonical_name": "Gelea", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "gelea", "book_id": "historia_medicinal_monardes_1574", "name": "Gelea", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Gelea"], "contexts": ["jelly-like preparation"]}, {"entity_id": "geſlo", "book_id": "polyanthea_medicinal", "name": "geſlo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["geſlo"], "contexts": ["ingredient in a suspensory"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Gelea", "target_book": "polyanthea_medicinal", "target_name": "geſlo", "similarity": 0.843}], "id": 2063, "stable_key": "clu_9f7850667770ac7d", "ground_truth": {"modern_name": "Jelly-like substance", "confidence": "medium", "type": "concept", "note": "The term 'gelea'/'geslo' refers to a jelly-like consistency, likely of a prepared medicinal substance."}}, {"canonical_name": "agua resfada", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "agua_resfada", "book_id": "historia_medicinal_monardes_1574", "name": "agua resfada", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["agua resfada"], "contexts": ["cooled water"]}, {"entity_id": "agua_hydroptica", "book_id": "polyanthea_medicinal", "name": "agua hydroptica", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["agua hydroptica"], "contexts": ["medicinal water for various ailments"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "agua resfada", "target_book": "polyanthea_medicinal", "target_name": "agua hydroptica", "similarity": 0.845}], "id": 2064, "stable_key": "clu_c4db96eae8e924e9", "ground_truth": {"modern_name": "Cooled water", "confidence": "high", "type": "concept", "note": "Water that has been cooled, often medicinally for fevers or other ailments."}}, {"canonical_name": "Carde", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "carde", "book_id": "historia_medicinal_monardes_1574", "name": "Carde", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Carde"], "contexts": ["disease causing twisting"]}, {"entity_id": "cardialgiam", "book_id": "polyanthea_medicinal", "name": "Cardialgiam", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Cardialgiam"], "contexts": ["heart pain"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Carde", "target_book": "polyanthea_medicinal", "target_name": "Cardialgiam", "similarity": 0.846}], "id": 2065, "stable_key": "clu_9e6c0a1231cd11eb", "ground_truth": {"wikipedia_extract": "Cardè is a comune (municipality) in the Province of Cuneo in the Italian region Piedmont, located about 40 kilometres (25 mi) southwest of Turin and about 40 kilometres (25 mi) north of Cuneo. As of 31 December 2004, it had a population of 1,077 and an area of 19.3 square kilometres (7.5 mi2). Cardè borders the following municipalities: Barge, Moretta, Revello, Saluzzo, and Villafranca Piemonte."}}, {"canonical_name": "medicinas venenosas", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "medicinas_venenosas", "book_id": "historia_medicinal_monardes_1574", "name": "medicinas venenosas", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["medicinas venenosas"], "contexts": ["harmful medicinal preparations"]}, {"entity_id": "remedio_venenoſo", "book_id": "polyanthea_medicinal", "name": "remedio venenoſo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["remedio venenoſo"], "contexts": ["poisonous remedy"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "medicinas venenosas", "target_book": "polyanthea_medicinal", "target_name": "remedio venenoſo", "similarity": 0.855}], "id": 2066, "stable_key": "clu_9f2ca95be9ec3180", "ground_truth": {"modern_name": "Poisonous medicines", "confidence": "high", "type": "concept", "note": "Medicinal substances that are toxic or can cause harm if not used carefully."}}, {"canonical_name": "vinagre Eſquilitico", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "vinagre_eſquilitico", "book_id": "historia_medicinal_monardes_1574", "name": "vinagre Eſquilitico", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["vinagre Eſquilitico"], "contexts": ["squill vinegar"]}, {"entity_id": "vinagre_efquilitico", "book_id": "polyanthea_medicinal", "name": "vinagre efquilitico", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["vinagre efquilitico"], "contexts": ["vinegar used in remedy"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "vinagre Eſquilitico", "target_book": "polyanthea_medicinal", "target_name": "vinagre efquilitico", "similarity": 0.926}], "id": 2067, "stable_key": "clu_3bcee425371bc553", "ground_truth": {"modern_name": "Squill vinegar", "confidence": "high", "type": "preparation", "note": "Vinegar infused with squill, a medicinal plant."}}, {"canonical_name": "pordetluras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pordetluras", "book_id": "historia_medicinal_monardes_1574", "name": "pordetluras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["pordetluras"], "contexts": ["bites or stings, likely from scorpions"]}, {"entity_id": "porrig_", "book_id": "polyanthea_medicinal", "name": "Porrig.", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Porrig."], "contexts": ["skin condition, likely ringworm"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "pordetluras", "target_book": "polyanthea_medicinal", "target_name": "Porrig.", "similarity": 0.851}], "id": 2068, "stable_key": "clu_0168f7b0f069e05a", "ground_truth": {"modern_name": "Porrigo", "confidence": "high", "type": "disease", "modern_term": "Porrigo", "note": "An obsolete medical term for various scaling scalp diseases, often synonymous with ringworm or impetigo. 'Pordetluras' may refer to bites/stings, but 'Porrig.' is strongly indicative of porrigo."}}, {"canonical_name": "modorras", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "modorras", "book_id": "historia_medicinal_monardes_1574", "name": "modorras", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["modorras"], "contexts": ["fevers of bad quality, commonly called modorras"]}, {"entity_id": "modortas", "book_id": "polyanthea_medicinal", "name": "modortas", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["modortas"], "contexts": ["profound lethargy in febrile patients"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "modorras", "target_book": "polyanthea_medicinal", "target_name": "modortas", "similarity": 0.939}], "id": 2069, "stable_key": "clu_a868ee7fd7ecdedc", "ground_truth": {"modern_name": "Lethargy", "confidence": "high", "type": "disease", "modern_term": "Lethargy", "note": "The description points to profound lethargy in febrile patients, aligning with the modern understanding of lethargy as a symptom or condition of excessive tiredness and sluggishness, often associated with illness.", "wikidata_id": "Q15637420", "wikidata_description": "state of tiredness, weariness, fatigue, or lack of energy", "wikipedia_url": "https://en.wikipedia.org/wiki/Lethargy"}}, {"canonical_name": "erelipilas", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "erelipilas", "book_id": "historia_medicinal_monardes_1574", "name": "erelipilas", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["erelipilas"], "contexts": ["skin inflammation"]}, {"entity_id": "erpes", "book_id": "polyanthea_medicinal", "name": "erpes", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["erpes"], "contexts": ["treated by Tiberio's medicine"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "erelipilas", "target_book": "polyanthea_medicinal", "target_name": "erpes", "similarity": 0.85}], "id": 2070, "stable_key": "clu_32e4734d0face45b", "ground_truth": {"modern_name": "Erysipelas", "confidence": "high", "type": "disease", "modern_term": "Erysipelas", "note": "While 'erpes' can refer to herpes, in the context of skin inflammation and fever, 'erelipilas' is a clear precursor to erysipelas, a bacterial skin infection.", "wikidata_id": "Q207092", "wikidata_description": "human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Erysipelas"}}, {"canonical_name": "panatizos", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "panatizos", "book_id": "historia_medicinal_monardes_1574", "name": "panatizos", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["panatizos"], "contexts": ["boils or carbuncles"]}, {"entity_id": "panaritio", "book_id": "polyanthea_medicinal", "name": "Panaritio", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["Panaritio"], "contexts": ["infection of finger"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "panatizos", "target_book": "polyanthea_medicinal", "target_name": "Panaritio", "similarity": 0.858}], "id": 2071, "stable_key": "clu_3bfc0ebcd775502e", "ground_truth": {"modern_name": "Panaritium", "confidence": "high", "type": "disease", "modern_term": "Panaritium", "note": "The description of boils or carbuncles, especially on fingers, directly corresponds to the medical term panaritium (or whitlow).", "wikidata_id": "Q659001", "wikidata_description": "infection of the fingertip", "wikipedia_url": "https://en.wikipedia.org/wiki/Whitlow"}}, {"canonical_name": "enzías podridas", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "enzías_podridas", "book_id": "historia_medicinal_monardes_1574", "name": "enzías podridas", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["enzías podridas"], "contexts": ["rotting gums"]}, {"entity_id": "gengivas_podres", "book_id": "polyanthea_medicinal", "name": "gengivas podres", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["gengivas podres"], "contexts": ["symptom of rotten gums"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "enzías podridas", "target_book": "polyanthea_medicinal", "target_name": "gengivas podres", "similarity": 0.855}], "id": 2072, "stable_key": "clu_99ec32a664aebca2", "ground_truth": {"modern_name": "Gingivitis", "confidence": "high", "type": "disease", "modern_term": "Gingivitis", "note": "Rotting gums is a direct description of severe gingivitis or periodontal disease.", "wikidata_id": "Q673083", "wikidata_description": "Gingivitis is a mild form of periodontal disease, characterized by inflammation of the gums.", "wikipedia_url": "https://en.wikipedia.org/wiki/Gingivitis"}}, {"canonical_name": "diciones", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "diciones", "book_id": "historia_medicinal_monardes_1574", "name": "diciones", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["diciones"], "contexts": ["conditions or qualities"]}, {"entity_id": "diſtinçao", "book_id": "polyanthea_medicinal", "name": "diſtinçao", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["diſtinçao"], "contexts": ["distinction"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "diciones", "target_book": "polyanthea_medicinal", "target_name": "diſtinçao", "similarity": 0.852}], "id": 2073, "stable_key": "clu_9fb29d9018707e76", "ground_truth": {"modern_name": "Qualities", "confidence": "medium", "type": "concept", "note": "The term 'diciones' and 'diſtinçao' in this context likely refers to the Aristotelian concept of qualities or properties, which were fundamental in early modern natural philosophy and medicine for describing substances and phenomena."}}, {"canonical_name": "Ciudad de Dios", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ciudad_de_dios", "book_id": "historia_medicinal_monardes_1574", "name": "Ciudad de Dios", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Ciudad de Dios"], "contexts": ["book by Saint Augustine"]}, {"entity_id": "civitate_dei", "book_id": "polyanthea_medicinal", "name": "Civitate Dei", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Civitate Dei"], "contexts": ["work by Saint Augustine"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Ciudad de Dios", "target_book": "polyanthea_medicinal", "target_name": "Civitate Dei", "similarity": 0.904}], "id": 2074, "stable_key": "clu_3294cf90f68bd7a3", "ground_truth": {"modern_name": "The City of God", "confidence": "high", "type": "text", "note": "Both 'Ciudad de Dios' and 'Civitate Dei' are direct references to Saint Augustine's seminal work.", "wikidata_id": "Q128485255", "wikidata_description": "Christian hymn text"}}, {"canonical_name": "1574", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "1574", "book_id": "historia_medicinal_monardes_1574", "name": "1574", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["1574"], "contexts": ["year of publication"]}, {"entity_id": "1585", "book_id": "connexion_physical_sciences_somerville_1858", "name": "1585", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["1585"], "contexts": ["year of a tailless comet appearance"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "1574", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "1585", "similarity": 0.861}], "id": 2075, "stab