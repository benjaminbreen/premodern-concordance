me": "sangue", "target_book": "polyanthea_medicinal", "target_name": "sangue quente", "similarity": 0.812}, {"source_book": "coloquios_da_orta_1563", "source_name": "sangue", "target_book": "polyanthea_medicinal", "target_name": "sangue central", "similarity": 0.826}, {"source_book": "ricettario_fiorentino_1597", "source_name": "sangue", "target_book": "polyanthea_medicinal", "target_name": "sangue quente", "similarity": 0.812}, {"source_book": "ricettario_fiorentino_1597", "source_name": "sangue", "target_book": "polyanthea_medicinal", "target_name": "sangue central", "similarity": 0.826}, {"source_book": "polyanthea_medicinal", "source_name": "fangue", "target_book": "ricettario_fiorentino_1597", "target_name": "fangue", "similarity": 1.0}], "id": 91, "stable_key": "clu_ad00c60e96254f7d", "ground_truth": {"modern_name": "blood", "confidence": "high", "type": "substance", "description": "The red bodily fluid circulating in humans and animals.", "wikipedia_extract": "Blood is a body fluid in the circulatory system of humans and other vertebrates that delivers necessary substances such as nutrients and oxygen to the cells, and transports metabolic waste products away from those same cells. Blood is composed of blood cells suspended in plasma. Plasma, which constitutes 55% of blood fluid, is mostly water (92% by volume), and contains proteins, glucose, mineral ions, and hormones. The blood cells are mainly red blood cells (erythrocytes), white blood cells (leukocytes), and (in mammals) platelets (thrombocytes). The most abundant cells are red blood cells. These contain hemoglobin, which facilitates oxygen transport by reversibly binding to it, increasing its solubility."}}, {"canonical_name": "vinagre", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 4, "total_mentions": 212, "members": [{"entity_id": "vinagre", "book_id": "polyanthea_medicinal", "name": "vinagre", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 127, "variants": ["vinagre", "Vinacearum", "Vinagre", "vina", "vinacea", "vinagre Roſado", "vinagre aguado", "vinagre branco forte", "vinagre forte", "vinagre fortiffimo", "vinagre fortissimo", "vinagre rofado", "vinagre rolado", "vinagre rosado", "vinagre roſado", "vinagreRofado", "vinagreRoſado", "vinagrebem forte", "vinagreforte"], "contexts": ["vinegar, an acidic liquid", "added to remedy"]}, {"entity_id": "vinegar", "book_id": "english_physician_1652", "name": "Vinegar", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 65, "variants": ["Vinegar", "Vineger", "Vine∣gar", "vinegar"], "contexts": ["ingredient used with herb", "acidic liquid used in preparations"]}, {"entity_id": "vinagre", "book_id": "historia_medicinal_monardes_1574", "name": "vinagre", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 10, "variants": ["vinagre"], "contexts": ["acidic liquid used in preparation", "ingredient in a preparation"]}, {"entity_id": "vinagre", "book_id": "coloquios_da_orta_1563", "name": "vinagre", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 10, "variants": ["vinagre"], "contexts": ["Product made from fruit peel", "acidic liquid"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "vinagre", "target_book": "english_physician_1652", "target_name": "Vinegar", "similarity": 0.909}, {"source_book": "polyanthea_medicinal", "source_name": "vinagre", "target_book": "historia_medicinal_monardes_1574", "target_name": "vinagre", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "vinagre", "target_book": "coloquios_da_orta_1563", "target_name": "vinagre", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Vinegar", "target_book": "historia_medicinal_monardes_1574", "target_name": "vinagre", "similarity": 0.909}, {"source_book": "english_physician_1652", "source_name": "Vinegar", "target_book": "coloquios_da_orta_1563", "target_name": "vinagre", "similarity": 0.909}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "vinagre", "target_book": "coloquios_da_orta_1563", "target_name": "vinagre", "similarity": 1.0}], "id": 92, "stable_key": "clu_255994a3f1e92c80", "ground_truth": {"modern_name": "vinegar", "confidence": "high", "type": "substance", "description": "An acidic liquid produced by fermentation of ethanol.", "wikipedia_extract": "Vinegar (from Old French  vyn egre 'sour wine') is an odorous aqueous solution of diluted acetic acid and trace compounds that may include flavorings or naturally occurring organic compounds. Vinegar typically contains from 4% to 18% acetic acid by volume. Usually, the acetic acid is produced by a double fermentation—converting simple sugars to ethanol using yeast, and then converting ethanol to acetic acid using acetic acid bacteria. Many types of vinegar are made, depending on source materials. The product is now mainly used in the culinary arts as a flavorful, acidic cooking ingredient, salad dressing, or pickling agent. Various types are used as condiments or garnishes, including balsamic vinegar and malt vinegar."}}, {"canonical_name": "figado", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 207, "members": [{"entity_id": "figado", "book_id": "polyanthea_medicinal", "name": "figado", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 181, "variants": ["figado", "Figado", "figado affado", "figado aflado", "figado eſquentado", "figado hep", "figadodemodo", "fígado"], "contexts": ["liver", "organ near the stomach"]}, {"entity_id": "fígado", "book_id": "coloquios_da_orta_1563", "name": "fígado", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["fígado", "figado"], "contexts": ["organ of the body", "organ that can be obstructed"]}, {"entity_id": "fieli", "book_id": "ricettario_fiorentino_1597", "name": "Fieli", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["fieli", "Fieli"], "contexts": ["animal gallbladders", "animal parts prepared in medicine"]}, {"entity_id": "higado", "book_id": "historia_medicinal_monardes_1574", "name": "Higado", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 17, "variants": ["Higado", "Higa", "hidago", "higado"], "contexts": ["an organ in the body", "liver organ"]}, {"entity_id": "higado", "book_id": "polyanthea_medicinal", "name": "higado", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["higado"], "contexts": ["organ affected by heat"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "figado", "target_book": "coloquios_da_orta_1563", "target_name": "fígado", "similarity": 0.91}, {"source_book": "polyanthea_medicinal", "source_name": "figado", "target_book": "ricettario_fiorentino_1597", "target_name": "Fieli", "similarity": 0.854}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Higado", "target_book": "polyanthea_medicinal", "target_name": "higado", "similarity": 0.978}], "id": 93, "stable_key": "clu_6c1c2dfad9fb7ad7", "ground_truth": {"modern_name": "liver", "confidence": "high", "type": "substance", "description": "A large organ in the abdomen responsible for many metabolic functions.", "wikipedia_extract": "The liver is a major metabolic organ exclusively found in vertebrates, which performs many essential biological functions such as detoxification of the organism, and the synthesis of various proteins and various other biochemicals necessary for digestion and growth. In humans, it is located in the right upper quadrant of the abdomen, below the diaphragm and mostly shielded by the lower right rib cage. Its other metabolic roles include carbohydrate metabolism, the production of a number of hormones, conversion and storage of nutrients such as glucose and glycogen, and the decomposition of red blood cells. Anatomical and medical terminology often use the prefix hepat- from ἡπατο-, from the Greek word for liver, such as hepatology, and hepatitis. The liver is also an accessory digestive organ that produces bile, an alkaline fluid containing cholesterol and bile acids,  which emulsifies and aids the breakdown of dietary fat. The gallbladder, a small hollow pouch that sits just under the right lobe of liver, stores and concentrates the bile produced by the liver, which is later excreted to the duodenum to help with digestion."}}, {"canonical_name": "sun", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 4, "total_mentions": 199, "members": [{"entity_id": "sun", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sun", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 184, "variants": ["sun", "Sun"], "contexts": ["star at the center of our solar system", "celestial body with parallax"]}, {"entity_id": "sun", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Sun", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 6, "variants": ["Sun"], "contexts": ["Sun, the fixed Stars lesser than the Moon", "celestial body, one of the great lights"]}, {"entity_id": "suns", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Suns", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Suns"], "contexts": ["celestial bodies"]}, {"entity_id": "sun", "book_id": "principles_of_psychology_james_1890", "name": "sun", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["sun"], "contexts": ["celestial body providing light and heat", "celestial body"]}, {"entity_id": "mean_sun", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mean sun", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["mean sun"], "contexts": ["hypothetical sun for timekeeping"]}, {"entity_id": "suns", "book_id": "first_principles_spencer_1862", "name": "suns", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["suns"], "contexts": ["celestial bodies, incandescent matter"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "sun", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Sun", "similarity": 0.985}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "sun", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Suns", "similarity": 0.939}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "sun", "target_book": "principles_of_psychology_james_1890", "target_name": "sun", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "sun", "target_book": "first_principles_spencer_1862", "target_name": "suns", "similarity": 0.95}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sun", "target_book": "principles_of_psychology_james_1890", "target_name": "sun", "similarity": 0.985}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sun", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mean sun", "similarity": 0.898}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sun", "target_book": "first_principles_spencer_1862", "target_name": "suns", "similarity": 0.933}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Suns", "target_book": "principles_of_psychology_james_1890", "target_name": "sun", "similarity": 0.939}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Suns", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mean sun", "similarity": 0.862}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Suns", "target_book": "first_principles_spencer_1862", "target_name": "suns", "similarity": 0.982}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sun", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mean sun", "similarity": 0.918}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sun", "target_book": "first_principles_spencer_1862", "target_name": "suns", "similarity": 0.95}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "mean sun", "target_book": "first_principles_spencer_1862", "target_name": "suns", "similarity": 0.882}], "id": 94, "stable_key": "clu_0f58dc887d5e1fab", "ground_truth": {"modern_name": "Sun", "confidence": "high", "type": "object", "note": "Although 'animal' is listed as a subcategory, in this context 'sun' refers to the celestial body.", "wikidata_id": "Q28039407", "wikidata_description": "family name", "wikipedia_extract": "The Sun is the star at the centre of the Solar System. It is a massive, nearly perfect sphere of hot plasma, heated to incandescence by nuclear fusion reactions in its core, radiating the energy from its surface mainly as visible light and infrared radiation with 10% at ultraviolet energies. It is the main source of energy for life on Earth. The Sun has been an object of veneration in many cultures and a central subject for astronomical research since antiquity. The Sun orbits the Galactic Center at a distance of 24,000 to 28,000 light-years. Its mean distance from Earth is about 1.496×108 kilometres or about 8 light-minutes."}}, {"canonical_name": "Ciatica", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 4, "total_mentions": 170, "members": [{"entity_id": "ciatica", "book_id": "polyanthea_medicinal", "name": "Ciatica", "category": "DISEASE", "subcategory": "CHRONIC", "count": 116, "variants": ["Ciatica", "Ciaticas", "Hecticas", "Sciatica", "ciatica", "ciaticas", "hectica", "hecticas", "hepaticas"], "contexts": ["pain in the hip and leg", "illness treated by Quintilio's powders"]}, {"entity_id": "sciatica", "book_id": "english_physician_1652", "name": "Sciatica", "category": "DISEASE", "subcategory": "CHRONIC", "count": 49, "variants": ["Sciatica", "Stiatica"], "contexts": ["ailment treated by the herb", "pain treated by Angelica water"]}, {"entity_id": "catarros", "book_id": "historia_medicinal_monardes_1574", "name": "Catarros", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["Catarros"], "contexts": ["cold catarrhs, treated with fumigation"]}, {"entity_id": "ciática", "book_id": "coloquios_da_orta_1563", "name": "ciática", "category": "DISEASE", "subcategory": "CHRONIC", "count": 3, "variants": ["ciática"], "contexts": ["a medical condition", "painful condition affecting the sciatic nerve"]}, {"entity_id": "ciragra", "book_id": "coloquios_da_orta_1563", "name": "ciragra", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["ciragra"], "contexts": ["gout of the hand"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Ciatica", "target_book": "english_physician_1652", "target_name": "Sciatica", "similarity": 0.87}, {"source_book": "polyanthea_medicinal", "source_name": "Ciatica", "target_book": "historia_medicinal_monardes_1574", "target_name": "Catarros", "similarity": 0.881}, {"source_book": "polyanthea_medicinal", "source_name": "Ciatica", "target_book": "coloquios_da_orta_1563", "target_name": "ciática", "similarity": 0.957}, {"source_book": "polyanthea_medicinal", "source_name": "Ciatica", "target_book": "coloquios_da_orta_1563", "target_name": "ciragra", "similarity": 0.856}, {"source_book": "english_physician_1652", "source_name": "Sciatica", "target_book": "coloquios_da_orta_1563", "target_name": "ciática", "similarity": 0.871}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Catarros", "target_book": "coloquios_da_orta_1563", "target_name": "ciática", "similarity": 0.878}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Catarros", "target_book": "coloquios_da_orta_1563", "target_name": "ciragra", "similarity": 0.854}], "id": 95, "stable_key": "clu_51950a4a56c48d49", "ground_truth": {"modern_name": "Sciatica", "confidence": "high", "type": "disease", "description": "Pain radiating along the path of the sciatic nerve.", "note": "Includes 'Ciatica', 'Sciatica', and 'ciática'. 'Catarros' (colds/catarrh) and 'ciragra' (gout of the hand) are less direct but contextually related to pain and illness.", "wikipedia_extract": "Sciatica is pain going down the leg from the lower back. This pain may extend down the back, outside, or front of the leg. Onset is often sudden following activities such as heavy lifting, though gradual onset may also occur. The pain is often described as shooting. Typically, symptoms occur on only one side of the body; certain causes, however, may result in pain on both sides. Lower back pain is sometimes present."}}, {"canonical_name": "Root", "category": "PLANT", "subcategory": "PLANT", "book_count": 4, "total_mentions": 158, "members": [{"entity_id": "root", "book_id": "english_physician_1652", "name": "Root", "category": "PLANT", "subcategory": "PLANT", "count": 138, "variants": ["Root", "Roots"], "contexts": ["part of Angelica used medicinally", "part of the Arsmart plant"]}, {"entity_id": "root", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Root", "category": "PLANT", "subcategory": "ROOT", "count": 1, "variants": ["Root"], "contexts": ["plant part"]}, {"entity_id": "grass_roots", "book_id": "english_physician_1652", "name": "grass Roots", "category": "PLANT", "subcategory": "PLANT", "count": 2, "variants": ["grass Roots", "Grass Roots"], "contexts": ["added to decoction for strength", "root used in syrup preparation"]}, {"entity_id": "raiz", "book_id": "coloquios_da_orta_1563", "name": "raiz", "category": "PLANT", "subcategory": "PLANT", "count": 16, "variants": ["raiz", "raizes", "raíz", "raízes"], "contexts": ["part of a plant", "part of a plant, used as a spice"]}, {"entity_id": "root", "book_id": "polyanthea_medicinal", "name": "root", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["root"], "contexts": ["a part of a plant used medicinally"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Root", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Root", "similarity": 0.914}, {"source_book": "english_physician_1652", "source_name": "Root", "target_book": "coloquios_da_orta_1563", "target_name": "raiz", "similarity": 0.892}, {"source_book": "english_physician_1652", "source_name": "Root", "target_book": "polyanthea_medicinal", "target_name": "root", "similarity": 0.983}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Root", "target_book": "polyanthea_medicinal", "target_name": "root", "similarity": 0.913}, {"source_book": "coloquios_da_orta_1563", "source_name": "raiz", "target_book": "polyanthea_medicinal", "target_name": "root", "similarity": 0.888}], "id": 96, "stable_key": "clu_2260fb5866e5b564", "ground_truth": {"modern_name": "Root", "confidence": "high", "type": "plant", "description": "The underground part of a plant, often used medicinally.", "wikipedia_extract": "In vascular plants, the roots are the organs of a plant that are modified to provide anchorage for the plant and take in water and nutrients into the plant body, which allows plants to grow taller and faster. They are most often below the surface of the soil, but roots can also be aerial or aerating, that is, growing up above the ground or especially above water. Roots perform several essential and specialised roles that support plant growth, development and survival. Their primary functions are anchorage, uptake (absorption) of water and dissolved minerals, and conduction of these resources to the shoot. Beyond these, roots carry out a range of important secondary and adaptive functions — storage of reserves, synthesis of growth regulators, gas exchange in waterlogged environments, facilitation of symbiotic nutrient acquisition, and vegetative propagation. Anchorage and mechanical support."}}, {"canonical_name": "Arábios", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 4, "total_mentions": 139, "members": [{"entity_id": "arábios", "book_id": "coloquios_da_orta_1563", "name": "Arábios", "category": "PERSON", "subcategory": "AUTHORITY", "count": 118, "variants": ["arábios", "Arábios"], "contexts": ["people who discern aloés quality", "people from Arabia"]}, {"entity_id": "arabian_authors", "book_id": "kosmos_humboldt_1845", "name": "Arabian authors", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Arabian authors"], "contexts": ["compared periodic falls to swarms of locusts"]}, {"entity_id": "arabi", "book_id": "ricettario_fiorentino_1597", "name": "Arabi", "category": "PERSON", "subcategory": "AUTHORITY", "count": 17, "variants": ["Arabi"], "contexts": ["group who wrote about Cardamomo", "authorities on medicine"]}, {"entity_id": "arabes", "book_id": "polyanthea_medicinal", "name": "Arabes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Arabes", "Arabum"], "contexts": ["ancient medical authorities", "Arab physicians"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Arábios", "target_book": "kosmos_humboldt_1845", "target_name": "Arabian authors", "similarity": 0.847}, {"source_book": "coloquios_da_orta_1563", "source_name": "Arábios", "target_book": "ricettario_fiorentino_1597", "target_name": "Arabi", "similarity": 0.947}, {"source_book": "coloquios_da_orta_1563", "source_name": "Arábios", "target_book": "polyanthea_medicinal", "target_name": "Arabes", "similarity": 0.953}, {"source_book": "kosmos_humboldt_1845", "source_name": "Arabian authors", "target_book": "ricettario_fiorentino_1597", "target_name": "Arabi", "similarity": 0.858}, {"source_book": "kosmos_humboldt_1845", "source_name": "Arabian authors", "target_book": "polyanthea_medicinal", "target_name": "Arabes", "similarity": 0.849}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Arabi", "target_book": "polyanthea_medicinal", "target_name": "Arabes", "similarity": 0.971}], "id": 97, "stable_key": "clu_6c85b7ad5b196f9c", "ground_truth": {"modern_name": "Arab physicians", "confidence": "high", "type": "person", "description": "Medical authorities and writers from the Arab world.", "note": "Refers to people from Arabia, specifically in the context of historical medical knowledge.", "wikipedia_extract": "In the history of medicine, \"Islamic medicine\", also known as \"Arabian medicine\" is the science of medicine developed in the Middle East, and usually written in Arabic, the lingua franca of Islamic civilization. Islamic medicine adopted, systematized and developed the medical knowledge of classical antiquity, including the major traditions of Hippocrates, Galen and Dioscorides. During the post-classical era, Middle Eastern medicine was the most advanced in the world, integrating concepts of Modern Greek, Roman, Mesopotamian and Persian medicine as well as the ancient Indian tradition of Ayurveda, while making numerous advances and innovations. Islamic medicine, along with knowledge of classical medicine, was later adopted in the medieval medicine of Western Europe, after European physicians became familiar with Islamic medical authors during the Renaissance of the 12th century. Medieval Islamic physicians largely retained their authority until the rise of medicine as a part of the natural sciences, beginning with the Age of Enlightenment, nearly six hundred years after their textbooks were opened by many people. Aspects of their writings remain of interest to physicians even today."}}, {"canonical_name": "Urine", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 125, "members": [{"entity_id": "urine", "book_id": "english_physician_1652", "name": "Urine", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 95, "variants": ["Urine", "Urin", "U∣rine", "urin"], "contexts": ["provoked by herb", "bodily fluid"]}, {"entity_id": "urine", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Urine", "category": "SUBSTANCE", "subcategory": "FLUID", "count": 3, "variants": ["Urine"], "contexts": ["bodily fluid", "source of volatile salt and Aqua vitæ"]}, {"entity_id": "passages_of_urine", "book_id": "english_physician_1652", "name": "Passages of Urine", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Passages of Urine", "passages of Urine"], "contexts": ["urinary tract cleansed by fern root decoction", "body part where decoctions are useful"]}, {"entity_id": "urina", "book_id": "historia_medicinal_monardes_1574", "name": "urina", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["urina"], "contexts": ["urine treated by the water", "bodily fluid, its flow is affected by remedies"]}, {"entity_id": "urina", "book_id": "polyanthea_medicinal", "name": "urina", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 22, "variants": ["urina", "urinam", "urinas", "urine"], "contexts": ["urine, its burning is avoided", "urine, bodily fluid"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Urine", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Urine", "similarity": 0.836}, {"source_book": "english_physician_1652", "source_name": "Urine", "target_book": "historia_medicinal_monardes_1574", "target_name": "urina", "similarity": 0.954}, {"source_book": "english_physician_1652", "source_name": "Urine", "target_book": "polyanthea_medicinal", "target_name": "urina", "similarity": 0.954}, {"source_book": "english_physician_1652", "source_name": "Passages of Urine", "target_book": "historia_medicinal_monardes_1574", "target_name": "urina", "similarity": 0.855}, {"source_book": "english_physician_1652", "source_name": "Passages of Urine", "target_book": "polyanthea_medicinal", "target_name": "urina", "similarity": 0.855}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "urina", "target_book": "polyanthea_medicinal", "target_name": "urina", "similarity": 1.0}], "id": 98, "stable_key": "clu_625b9c30c980a1a0", "ground_truth": {"modern_name": "Urine", "confidence": "high", "type": "substance", "description": "A bodily fluid produced by the kidneys and excreted from the body.", "note": "Refers to the bodily fluid itself and the passages through which it travels.", "wikipedia_extract": "Urine, excreted by the kidneys, is a liquid containing excess water and water-soluble nitrogen-rich by-products of metabolism including urea, uric acid, and creatinine, which must be cleared from the bloodstream. Urinalysis detects these nitrogenous wastes in mammals. In placental mammals, urine travels from the kidneys via the ureters to the bladder and exits the urethra through the penis or vulva during urination. Other vertebrates excrete urine through the cloaca. Urine plays an important role in the earth's nitrogen cycle. In balanced ecosystems, urine fertilizes the soil and thus helps plants to grow."}}, {"canonical_name": "Goa", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 123, "members": [{"entity_id": "goa", "book_id": "coloquios_da_orta_1563", "name": "Goa", "category": "PLACE", "subcategory": "CITY", "count": 117, "variants": ["Goa", "GOA"], "contexts": ["city where Ruano arrived", "City where aloe is used"]}, {"entity_id": "goa", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Goa", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Goa"], "contexts": ["independent settlement"]}, {"entity_id": "cidade_de_goa", "book_id": "coloquios_da_orta_1563", "name": "cidade de Goa", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["cidade de Goa"], "contexts": ["city where hospital was located"]}, {"entity_id": "goa", "book_id": "ricettario_fiorentino_1597", "name": "Goa", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Goa"], "contexts": ["city from which Spodio arrived", "city in India"]}, {"entity_id": "goadou", "book_id": "polyanthea_medicinal", "name": "Goadou", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Goadou"], "contexts": ["city where physician saw asthmatics cured"]}, {"entity_id": "goa", "book_id": "polyanthea_medicinal", "name": "Goa", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Goa"], "contexts": ["city where Padre Ungarete was a pharmacist"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Goa", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Goa", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Goa", "target_book": "ricettario_fiorentino_1597", "target_name": "Goa", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Goa", "target_book": "polyanthea_medicinal", "target_name": "Goadou", "similarity": 0.829}, {"source_book": "coloquios_da_orta_1563", "source_name": "Goa", "target_book": "polyanthea_medicinal", "target_name": "Goa", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Goa", "target_book": "coloquios_da_orta_1563", "target_name": "cidade de Goa", "similarity": 0.946}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Goa", "target_book": "ricettario_fiorentino_1597", "target_name": "Goa", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Goa", "target_book": "polyanthea_medicinal", "target_name": "Goadou", "similarity": 0.829}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Goa", "target_book": "polyanthea_medicinal", "target_name": "Goa", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "cidade de Goa", "target_book": "ricettario_fiorentino_1597", "target_name": "Goa", "similarity": 0.946}, {"source_book": "coloquios_da_orta_1563", "source_name": "cidade de Goa", "target_book": "polyanthea_medicinal", "target_name": "Goa", "similarity": 0.946}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Goa", "target_book": "polyanthea_medicinal", "target_name": "Goadou", "similarity": 0.829}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Goa", "target_book": "polyanthea_medicinal", "target_name": "Goa", "similarity": 1.0}], "id": 99, "stable_key": "clu_6060d47e8583b4a5", "ground_truth": {"modern_name": "Goa", "confidence": "high", "type": "place", "description": "A city and region in India.", "wikipedia_extract": "Goa ( GOH-ə; Konkani: [ɡɔ̃j]; Portuguese: [ˈɡoɐ] ) is a state on the southwestern coast of India within the Konkan region. It is geographically separated from the Deccan highlands by the Western Ghats. It is bordered by the Indian states of Maharashtra to the north and Karnataka to the east and south, with the Arabian Sea forming its western coastline. It is India's smallest state by area and fourth-smallest by population. Panaji (Panjim) is the state's capital, while Vasco da Gama is its largest city by population. The state's official language is Konkani, spoken by the majority of its inhabitants."}}, {"canonical_name": "nervos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 114, "members": [{"entity_id": "nervos", "book_id": "polyanthea_medicinal", "name": "nervos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 92, "variants": ["nervos", "nerveos", "nerves", "nervinhos", "nervis", "nervo", "nervootico", "nervos opticos", "nervosas", "pardos nervos", "partes nervosas"], "contexts": ["nerves", "body part affected by wine"]}, {"entity_id": "nervs", "book_id": "english_physician_1652", "name": "Nervs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 10, "variants": ["Nervs", "Nerves"], "contexts": ["body part helped by oil", "body part that can be hurt"]}, {"entity_id": "nervios", "book_id": "historia_medicinal_monardes_1574", "name": "Nervios", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["nervios", "Nervios"], "contexts": ["part of the nervous system", "nerves, part of the body"]}, {"entity_id": "nervos", "book_id": "coloquios_da_orta_1563", "name": "nervos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 8, "variants": ["nervos", "nervo"], "contexts": ["nerves, affected by calamus", "body part affected by açaroro and calamo"]}, {"entity_id": "nervos_auditórios", "book_id": "polyanthea_medicinal", "name": "nervos auditórios", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["nervos auditórios"], "contexts": ["auditory nerves"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "nervos", "target_book": "english_physician_1652", "target_name": "Nervs", "similarity": 0.951}, {"source_book": "polyanthea_medicinal", "source_name": "nervos", "target_book": "historia_medicinal_monardes_1574", "target_name": "Nervios", "similarity": 0.925}, {"source_book": "polyanthea_medicinal", "source_name": "nervos", "target_book": "coloquios_da_orta_1563", "target_name": "nervos", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Nervs", "target_book": "historia_medicinal_monardes_1574", "target_name": "Nervios", "similarity": 0.96}, {"source_book": "english_physician_1652", "source_name": "Nervs", "target_book": "coloquios_da_orta_1563", "target_name": "nervos", "similarity": 0.951}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Nervios", "target_book": "coloquios_da_orta_1563", "target_name": "nervos", "similarity": 0.925}, {"source_book": "coloquios_da_orta_1563", "source_name": "nervos", "target_book": "polyanthea_medicinal", "target_name": "nervos auditórios", "similarity": 0.816}], "id": 100, "stable_key": "clu_0a726ccc9c8f1aeb", "ground_truth": {"modern_name": "Nerve", "confidence": "high", "type": "anatomy", "description": "Bundles of fibers transmitting nerve impulses.", "wikipedia_extract": "A nerve is an enclosed, cable-like bundle of nerve fibers (called axons). Nerves have historically been considered the basic units of the peripheral nervous system. A nerve provides a common pathway for the electrochemical nerve impulses called action potentials that are transmitted along each of the axons to peripheral organs or, in the case of sensory nerves, from the periphery back to the central nervous system. Each axon is an extension of an individual neuron, along with other supportive cells such as some Schwann cells that coat the axons in myelin. Each axon is surrounded by a layer of connective tissue called the endoneurium. The axons are bundled together into groups called fascicles, and each fascicle is wrapped in a layer of connective tissue called the perineurium."}}, {"canonical_name": "madre", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 110, "members": [{"entity_id": "madre", "book_id": "polyanthea_medicinal", "name": "madre", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 60, "variants": ["madre", "Madre", "madredeytade"], "contexts": ["mother, referring to dura mater", "membrane connected to the head"]}, {"entity_id": "mother", "book_id": "english_physician_1652", "name": "Mother", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 33, "variants": ["Mother"], "contexts": ["strangled with the mother", "affected by pains"]}, {"entity_id": "madre", "book_id": "historia_medicinal_monardes_1574", "name": "madre", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 13, "variants": ["madre"], "contexts": ["mother (referring to the womb)", "uterus"]}, {"entity_id": "madre", "book_id": "coloquios_da_orta_1563", "name": "madre", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["madre"], "contexts": ["womb, affected by calamus", "womb, benefited by fruit preserve"]}, {"entity_id": "mammas", "book_id": "coloquios_da_orta_1563", "name": "mammas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["mammas"], "contexts": ["breasts of female dugongs"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "madre", "target_book": "english_physician_1652", "target_name": "Mother", "similarity": 0.98}, {"source_book": "polyanthea_medicinal", "source_name": "madre", "target_book": "historia_medicinal_monardes_1574", "target_name": "madre", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "madre", "target_book": "coloquios_da_orta_1563", "target_name": "madre", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "madre", "target_book": "coloquios_da_orta_1563", "target_name": "mammas", "similarity": 0.959}, {"source_book": "english_physician_1652", "source_name": "Mother", "target_book": "historia_medicinal_monardes_1574", "target_name": "madre", "similarity": 0.98}, {"source_book": "english_physician_1652", "source_name": "Mother", "target_book": "coloquios_da_orta_1563", "target_name": "madre", "similarity": 0.98}, {"source_book": "english_physician_1652", "source_name": "Mother", "target_book": "coloquios_da_orta_1563", "target_name": "mammas", "similarity": 0.944}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "madre", "target_book": "coloquios_da_orta_1563", "target_name": "madre", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "madre", "target_book": "coloquios_da_orta_1563", "target_name": "mammas", "similarity": 0.959}], "id": 101, "stable_key": "clu_b6ed7355ecfef4a7", "ground_truth": {"modern_name": "Womb", "confidence": "high", "type": "anatomy", "description": "The organ in female mammals where offspring develop.", "note": "Also refers to 'dura mater' in some contexts.", "wikipedia_extract": "The uterus (from Latin uterus, pl.: uteri or uteruses) or womb () is the organ in the reproductive system of most female mammals, including humans, that accommodates the embryonic and fetal development of one or more fertilized eggs until birth. The uterus is a hormone-responsive sex organ that contains glands in its lining that secrete uterine milk for embryonic nourishment. (The term uterus is also applied to analogous structures in some non-mammalian animals.) In humans, the lower end of the uterus is a narrow part known as the isthmus that connects to the cervix, the anterior gateway leading to the vagina. The upper end, the body of the uterus, is connected to the fallopian tubes at the uterine horns; the rounded part, the fundus, is above the openings to the fallopian tubes. The connection of the uterine cavity with a fallopian tube is called the uterotubal junction. The fertilized egg is carried to the uterus along the fallopian tube. It will have divided on its journey to form a blastocyst that will implant itself into the lining of the uterus – the endometrium, where it will receive nutrients and develop into the embryo proper, and later fetus, for the duration of the pregnancy."}}, {"canonical_name": "sucre", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 99, "members": [{"entity_id": "sucre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "sucre", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 96, "variants": ["sucre", "SUCRE", "Sucre", "betterave à sucre", "canne à sucre", "canne à sucre ordinaire", "cannes à sucre", "cannès à sucre", "la canne à sucre", "sucre de betterave", "sucre de canne"], "contexts": ["precious production", "cultivated plant for export"]}, {"entity_id": "sugar-cane", "book_id": "kosmos_humboldt_1845", "name": "sugar-cane", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["sugar-cane"], "contexts": ["plant requiring hot climate"]}, {"entity_id": "sugar", "book_id": "coloquios_da_orta_1563", "name": "sugar", "category": "PLANT", "subcategory": "PLANT", "count": 1, "variants": ["sugar"], "contexts": ["entry in glossary"]}, {"entity_id": "sugar-cane", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sugar-cane", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["sugar-cane"], "contexts": ["plant source of sugar"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "sucre", "target_book": "kosmos_humboldt_1845", "target_name": "sugar-cane", "similarity": 0.889}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "sucre", "target_book": "coloquios_da_orta_1563", "target_name": "sugar", "similarity": 0.874}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "sucre", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sugar-cane", "similarity": 0.889}, {"source_book": "kosmos_humboldt_1845", "source_name": "sugar-cane", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sugar-cane", "similarity": 1.0}], "id": 102, "stable_key": "clu_8956eb73e3d0abe4", "ground_truth": {"modern_name": "Sugar", "confidence": "high", "type": "plant", "linnaean": "Saccharum officinarum", "family": "Poaceae", "description": "Sweet crystalline substance obtained from various plants, especially sugarcane.", "note": "Refers to the plant source and the substance derived from it.", "wikipedia_extract": "Saccharum officinarum is a large, strong-growing species of grass in the sugarcane genus. Its stout stalks are rich in sucrose, a disaccharide sugar which accumulates in the stalk internodes. It originated in New Guinea, and is now cultivated in tropical and subtropical countries worldwide for the production of sugar, ethanol and other products. It is one of the most productive and most intensively cultivated kinds of sugarcane. Saccharum officinarum, a perennial plant, grows in clumps consisting of a number of strong unbranched stems. A network of rhizomes forms under the soil which sends up secondary shoots near the parent plant."}}, {"canonical_name": "Jupiter", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 4, "total_mentions": 98, "members": [{"entity_id": "jupiter", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Jupiter", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 79, "variants": ["Jupiter"], "contexts": ["planet in the solar system", "planet with satellites"]}, {"entity_id": "jupiter", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Jupiter", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 8, "variants": ["Jupiter"], "contexts": ["planet whose satellite is observed", "celestial body, satellites observed"]}, {"entity_id": "jupiter's_satellites", "book_id": "kosmos_humboldt_1845", "name": "Jupiter's satellites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Jupiter's satellites"], "contexts": ["celestial bodies used for geographical determination"]}, {"entity_id": "jupiter’s_satellites", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Jupiter’s satellites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 6, "variants": ["Jupiter’s satellites", "Jupiter’s Satellites"], "contexts": ["moons of Jupiter", "moons orbiting Jupiter"]}, {"entity_id": "jupiter_and_saturn", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Jupiter and Saturn", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Jupiter and Saturn"], "contexts": ["inequality marking historical epochs"]}, {"entity_id": "jupiter's_satellites", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Jupiter's satellites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Jupiter's satellites"], "contexts": ["theory of"]}, {"entity_id": "jupiter’s_satellite", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Jupiter’s satellite", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Jupiter’s satellite"], "contexts": ["rotation determined"]}, {"entity_id": 