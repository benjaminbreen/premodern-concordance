1890", "source_name": "Mississippi", "target_book": "first_principles_spencer_1862", "target_name": "Mississippi", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mississippi", "target_book": "first_principles_spencer_1862", "target_name": "Mississippi", "similarity": 1.0}], "id": 58, "stable_key": "clu_8ea4c9d30ad10b23", "ground_truth": {"modern_name": "Mississippi River", "confidence": "high", "type": "place", "description": "A major river in the central United States.", "note": "Also refers to the historical territory associated with the river.", "wikipedia_extract": "The Mississippi River is the primary river of the largest drainage basin in the United States. It is the second-longest river in the United States, behind only the Missouri. From its traditional source of Lake Itasca in northern Minnesota, it flows generally south for 2,340 mi (3,770 km) to the Mississippi River Delta in the Gulf of Mexico. With its many tributaries, the Mississippi's watershed drains all or parts of 32 U.S. states and two Canadian provinces between the Rocky and Appalachian mountains. The river either borders or passes through the states of Minnesota, Wisconsin, Iowa, Illinois, Missouri, Kentucky, Tennessee, Arkansas, Mississippi, and Louisiana. The main stem is entirely within the United States; the total drainage basin is 1,151,000 mi2 (2,980,000 km2), of which only about one percent is in Canada."}}, {"canonical_name": "thermomètre", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 5, "total_mentions": 68, "members": [{"entity_id": "thermomètre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "thermomètre", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 46, "variants": ["thermomètre", "THERMOMÈTRE", "Thermom.", "thermo-mètre", "thermometer", "thermometre", "thermomètre centesimal", "thermomètre centigrade", "thermomètre centésimal", "thermomètre centésùnal", "thermomètre dcRcaumur", "thermomètre de Fabr.", "thermomètres"], "contexts": ["instrument for measuring temperature", "thermometer"]}, {"entity_id": "thermometers", "book_id": "principles_of_psychology_james_1890", "name": "thermometers", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["thermometers"], "contexts": ["devices for measuring temperature"]}, {"entity_id": "thermometer", "book_id": "kosmos_humboldt_1845", "name": "Thermometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 6, "variants": ["thermometer", "Thermometer"], "contexts": ["instrument for measuring temperature", "instrument used to measure temperature"]}, {"entity_id": "thermometers", "book_id": "kosmos_humboldt_1845", "name": "thermometers", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["thermometers"], "contexts": ["devices for measuring temperature"]}, {"entity_id": "thermoscope", "book_id": "kosmos_humboldt_1845", "name": "thermoscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["thermoscope"], "contexts": ["a thermoscope and a magnet"]}, {"entity_id": "thermometri", "book_id": "kosmos_humboldt_1845", "name": "thermometri", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["thermometri"], "contexts": ["instrument for measuring temperature"]}, {"entity_id": "thermometer", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Thermometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 10, "variants": ["Thermometer", "thermometer"], "contexts": ["measures temperature", "instrument for measuring temperature"]}, {"entity_id": "thermometer", "book_id": "first_principles_spencer_1862", "name": "thermometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["thermometer"], "contexts": ["instrument for measuring temperature"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "thermomètre", "target_book": "principles_of_psychology_jam