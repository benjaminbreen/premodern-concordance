ique_humboldt_vol3_1825", "name": "Chili", "category": "PLACE", "subcategory": "COUNTRY", "count": 34, "variants": ["Chili"], "contexts": ["country inhabited by people compared to Caribes", "geographic location with pronounced soil features"]}, {"entity_id": "chili", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Chili", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Chili"], "contexts": ["country in Western South America"]}, {"entity_id": "chile", "book_id": "origin_of_species_darwin_1859", "name": "Chile", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Chile"], "contexts": ["country of origin for species", "location with glacial moraine"]}, {"entity_id": "chili", "book_id": "kosmos_humboldt_1845", "name": "Chili", "category": "PLACE", "subcategory": "COUNTRY", "count": 10, "variants": ["Chili"], "contexts": ["coast with earthquake example", "South American country"]}, {"entity_id": "chile", "book_id": "historia_medicinal_monardes_1574", "name": "Chile", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Chile"], "contexts": ["location where events occurred", "region inhabited by indigenous people"]}, {"entity_id": "chile", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Chile", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Chile"], "contexts": ["South American country", "country with land elevation due to earthquake"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Chili", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Chili", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Chili", "target_book": "origin_of_species_darwin_1859", "target_name": "Chile", "similarity": 0.948}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Chili", "target_book": "kosmos_humboldt_1845", "target_name": "Chili", "similarity": 1.