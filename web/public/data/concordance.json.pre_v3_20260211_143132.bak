t_book": "historia_medicinal_monardes_1574", "target_name": "Peru", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Peru", "target_book": "coloquios_da_orta_1563", "target_name": "Peru", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Peru", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Peru", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Peru", "target_book": "coloquios_da_orta_1563", "target_name": "Peru", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Peru", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Peru", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Peru", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Peru", "similarity": 1.0}], "id": 25, "stable_key": "clu_7068d16ce9981e7a", "ground_truth": {"modern_name": "Peru", "confidence": "low", "type": "place", "description": "A country in South America, also historically associated with Persia.", "note": "The cluster mixes references to Peru and Persia.", "wikipedia_extract": "Peru, officially the Republic of Peru, is a country in western South America. It is bordered to the north by Ecuador and Colombia, to the east by Brazil, to the southeast by Bolivia, to the south by Chile, and to the south and west by the Pacific Ocean. Peru is a megadiverse country, with habitats ranging from the arid plains of the Pacific coastal region in the west, to the peaks of the Andes mountains extending from the north to the southeast of the country, to the tropical Amazon basin rainforest in the east with the Amazon River. Peru has a population of over 32 million, and its capital and largest city is Lima. At 1,285,216 km2 (496,225 sq mi), Peru is the 19th largest country in the world, and the third largest in South America. Peruvian territory was home to several cultures during the ancient and medieval periods, and has one of the longest histories of civilization of any country, tracing its heritage back to the 10th millennium BCE Caral–Supe civilization, the earliest civilization in the Americas and considered one of the cradles of civilization."}}, {"canonical_name": "Paris", "category": "PLACE", "subcategory": "CITY", "book_count": 6, "total_mentions": 177, "members": [{"entity_id": "paris", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Paris", "category": "PLACE", "subcategory": "CITY", "count": 95, "variants": ["Paris", "PARIS", "de Paris"], "contexts": ["city where Jardin des Plantes is located", "capital of France"]}, {"entity_id": "paris", "book_id": "principles_of_psychology_james_1890", "name": "Paris", "category": "PLACE", "subcategory": "CITY", "count": 13, "variants": ["Paris"], "contexts": ["city revisited after ten years' absence", "city where L'Automatisme Psychologique was published"]}, {"entity_id": "paris", "book_id": "kosmos_humboldt_1845", "name": "Paris", "category": "PLACE", "subcategory": "CITY", "count": 27, "variants": ["Paris"], "contexts": ["spent in Paris", "city where lectures were delivered"]}, {"entity_id": "paris", "book_id": "coloquios_da_orta_1563", "name": "Paris", "category": "PLACE", "subcategory": "CITY", "count": 27, "variants": ["Paris"], "contexts": ["city of translation publication", "edition of Guibourt's book"]}, {"entity_id": "parís", "book_id": "polyanthea_medicinal", "name": "París", "category": "PLACE", "subcategory": "CITY", "count": 7, "variants": ["París", "Paris", "Parisiis", "Pariz"], "contexts": ["Paris", "city where a man broke stones"]}, {"entity_id": "paris", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Paris", "category": "PLACE", "subcategory": "CITY", "count": 8, "variants": ["Paris"], "contexts": ["location of seconds' pendulum measurement", "city where aqueduct experiments were conducted"]}], "edges": [{"source_book": "relation_his