subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "cinchona", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cinchona", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["Cinchona", "Cinchona ferruginea"], "contexts": ["genus of true quinquina", "genus of plants"]}, {"entity_id": "cinchona", "book_id": "kosmos_humboldt_1845", "name": "cinchona", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cinchona"], "contexts": ["plant yielding febrifuge bark"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cinchona", "target_book": "kosmos_humboldt_1845", "target_name": "cinchona", "similarity": 0.875}], "id": 3078, "stable_key": "clu_b6c2ad52a05bbc32", "ground_truth": {"modern_name": "Cinchona", "confidence": "high", "type": "plant", "linnaean": "Cinchona", "family": "Rubiaceae", "wikidata_id": "Q160090", "wikidata_description": "genus of plants in the family Rubiaceae"}}, {"canonical_name": "Quindi\u00f9", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "quindi\u00f9", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Quindi\u00f9", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Quindi\u00f9", "Quindiii", "Quindi\u00e0"], "contexts": ["passage name", "mountain range"]}, {"entity_id": "quindiu", "book_id": "kosmos_humboldt_1845", "name": "Quindiu", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Quindiu"], "contexts": ["mountain chain"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Quindi\u00f9", "target_book": "kosmos_humboldt_1845", "target_name": "Quindiu", "similarity": 0.931}], "id": 3079, "stable_key": "clu_f52eccb6071b15e1", "ground_truth": {"modern_name": "P\u00e1ramo de Sumapaz", "confidence": "medium", "type": "place", "country": "Colombia", "note": "Based on Humboldt's works and geographic descriptions, 'Quindi\u00f9' or 'Quindiu' most likely refers to the P\u00e1ramo de Sumapaz, a high-altitude plateau region in the Colombian Andes.", "wikidata_id": "Q3411486", "wikidata_description": "mountain in Colombia", "wikipedia_extract": "Moorland or moor is a type of habitat found in upland areas in temperate grasslands, savannas, and shrublands and the biomes of montane grasslands and shrublands, characterised by low-growing vegetation on acidic soils. Moorland today generally means uncultivated hill land (such as Dartmoor in South West England), but also includes low-lying wetlands (such as Sedgemoor, also South West England). It is closely related to heath, although experts disagree on the exact distinction between these types of vegetation. Generally, moor refers to highland and high rainfall areas, while heath refers to lowland zones which are more likely to be the result of human activity. Moorland habitats are found mainly in tropical Africa, northern and western Europe, and South America. Most of the world's moorlands are diverse ecosystems.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sumapaz_P%C3%A1ramo"}}, {"canonical_name": "Oural", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "oural", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Oural", "category": "PLACE", "subcategory": "REGION", "count": 7, "variants": ["Oural"], "contexts": ["mountains bordering Europe", "mountain range limit"]}, {"entity_id": "oural", "book_id": "kosmos_humboldt_1845", "name": "Oural", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Oural"], "contexts": ["mountain range and platinum district"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oural", "target_book": "kosmos_humboldt_1845", "target_name": "Oural", "similarity": 1.0}], "id": 3080, "stable_key": "clu_d72650ad2c0bdfbe", "ground_truth": {"modern_name": "Ural Mountains", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q23136011", "wikidata_description": "chronology of creation of settles by humans in the region from the Arctic Ocean in the north to the Ural River and northwestern modern Kazakhstan", "wikipedia_url": "https://en.wikipedia.org/wiki/History_of_human_settlement_in_the_Ural_Mountains", "wikipedia_extract": "The Ural Mountains ( YOOR-\u0259l), or simply the Urals, are a mountain range in Eurasia that runs north\u2013south mostly through Russia, from the coast of the Arctic Ocean to the river Ural and northwestern Kazakhstan. The mountain range forms part of the conventional boundary between the continents of Europe and Asia, marking the separation between European Russia and Siberia. Vaygach Island and the islands of Novaya Zemlya form continuations of the chain to the north into the Arctic Ocean. The average altitudes of the Urals are around 1,000\u20131,300 metres (3,300\u20134,300 ft), the highest point being Mount Narodnaya, which reaches a height of 1,894 metres (6,214 ft). The mountains lie within the Ural geographical region and significantly overlap with the Ural Federal District and the Ural economic region. Their resources include metal ores, coal, precious and semi-precious stones."}}, {"canonical_name": "Alpes maritimes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "alpes_maritimes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Alpes maritimes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Alpes maritimes"], "contexts": ["region where wheat and rye disappear", "mountains in California"]}, {"entity_id": "maritime_alps", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Maritime Alps", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Maritime Alps"], "contexts": ["mountains becoming storm centers"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Alpes maritimes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Maritime Alps", "similarity": 0.909}], "id": 3081, "stable_key": "clu_d92f6fd0662480ff", "ground_truth": {"modern_name": "Alps", "confidence": "high", "type": "place", "country": "Switzerland", "note": "'Alpes maritimes' is a specific part of the Alps. 'Altai' is a different mountain range, but 'Alps' is the dominant term.", "wikidata_id": "Q1286", "wikidata_description": "Human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Maritime_Alps", "wikipedia_extract": "The Maritime Alps (French: Alpes Maritimes [alp ma\u0281itim]; Italian: Alpi Marittime [\u02c8alpi ma\u02c8rittime]) are a mountain range in the southwestern part of the Alps. They form the border between the French region of Provence-Alpes-C\u00f4te d'Azur and the Italian regions of Piedmont and Liguria. They are the southernmost part of the Alps. Administratively the range is divided between the Italian provinces of Cuneo and Imperia (eastern slopes) and the French department of Alpes-Maritimes (western slopes). The Maritime Alps are drained by the rivers Roya, Var and Verdon and their tributaries on the French side; by the Stura di Demonte and other tributaries of the Tanaro and Po on the Italian side. There are many attractive perched villages, such as Belv\u00e9d\u00e8re at the entrance to the spectacular Gordolasque valley, some concealing unexpected architectural riches (for example in the south there are numerous churches decorated with murals and altarpieces by primitive Ni\u00e7ois painters)."}}, {"canonical_name": "las Trincheras", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "las_trincheras", "book_id": "relation_historique_humboldt_vol3_1825", "name": "las Trincheras", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["Las Trincheras", "las Trincheras"], "contexts": ["near Portocabello, location of sulfurous waters", "location of hot springs"]}, {"entity_id": "las_trincheras", "book_id": "kosmos_humboldt_1845", "name": "Las Trincheras", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Las Trincheras"], "contexts": ["location with granite ledges", "location of thermal springs"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "las Trincheras", "target_book": "kosmos_humboldt_1845", "target_name": "Las Trincheras", "similarity": 0.985}], "id": 3082, "stable_key": "clu_fd4e971279b579ec", "ground_truth": {"modern_name": "Las Trincheras", "confidence": "high", "type": "place", "country": "Venezuela", "wikidata_id": "Q65059480", "wikidata_description": "place in Carabobo, Venezuela", "wikipedia_url": "https://en.wikipedia.org/wiki/Venezuelan_independence", "wikipedia_extract": "The Venezuelan Independence was the juridical-political process that put an end to the ties between the Captaincy General of Venezuela and the Spanish Empire. It also implied the replacement of the absolute monarchy by the republic as the form of government in Venezuela. The independence of Venezuela produced the armed conflict known as the Venezuelan War of Independence between the independence army or Patriotas (\"patriots\") and the royalist army or Realistas (\"royalists\"). On July 5, 1811, the independence declaration is signed. That day is celebrated in Venezuela as its national day. On that date formally, through the document \"Acta de Declaraci\u00f3n de Independencia\", Venezuela separates from Spain."}}, {"canonical_name": "titane rutile", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "titane_rutile", "book_id": "relation_historique_humboldt_vol3_1825", "name": "titane rutile", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["titane rutile", "titane", "titane - rutile"], "contexts": ["mineral found in schist", "mineral found in rock"]}, {"entity_id": "titanium", "book_id": "kosmos_humboldt_1845", "name": "titanium", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["titanium"], "contexts": ["mineral element", "metallis titanium"]}, {"entity_id": "metallis_titanium", "book_id": "kosmos_humboldt_1845", "name": "metallis titanium", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["metallis titanium"], "contexts": ["metallic form of titanium"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "titane rutile", "target_book": "kosmos_humboldt_1845", "target_name": "titanium", "similarity": 0.882}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "titane rutile", "target_book": "kosmos_humboldt_1845", "target_name": "metallis titanium", "similarity": 0.883}], "id": 3083, "stable_key": "clu_7db9297549305fc2", "ground_truth": {"modern_name": "Rutile", "confidence": "high", "type": "mineral", "note": "The term 'titane rutile' refers to rutile, a mineral composed of titanium dioxide, often described as a metallic titanium compound in early texts.", "wikidata_id": "Q320603", "wikidata_description": "oxide mineral"}}, {"canonical_name": "\u00e9vaporation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "\u00e9vaporation", "book_id": "relation_historique_humboldt_vol3_1825", "name": "\u00e9vaporation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["\u00e9vaporation"], "contexts": ["process of water turning into vapor", "process of turning liquid into vapor"]}, {"entity_id": "evaporation", "book_id": "kosmos_humboldt_1845", "name": "evaporation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["evaporation"], "contexts": ["process of liquid turning to vapor", "process influenced by solar heat"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "\u00e9vaporation", "target_book": "kosmos_humboldt_1845", "target_name": "evaporation", "similarity": 0.729}], "id": 3084, "stable_key": "clu_6670b0485f8d8198", "ground_truth": {"modern_name": "Evaporation", "confidence": "high", "type": "concept", "wikidata_id": "Q132814", "wikidata_description": "type of vaporization of a liquid that occurs from its surface; surface phenomenon"}}, {"canonical_name": "Godin", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "godin", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Godin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Godin"], "contexts": ["collaborator who discovered regularity of tides", "scholar who noticed daily and periodic variations"]}, {"entity_id": "godin", "book_id": "kosmos_humboldt_1845", "name": "Godin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Godin"], "contexts": ["erected monument at equator", "left South America in July 1744"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Godin", "target_book": "kosmos_humboldt_1845", "target_name": "Godin", "similarity": 1.0}], "id": 3085, "stable_key": "clu_018949731b7d6780", "ground_truth": {"modern_name": "Louis Godin", "confidence": "high", "type": "person", "birth_year": 1704, "death_year": 1760, "description": "French astronomer and geodesist, member of the French Geodesic Mission.", "wikidata_id": "Q1241227", "wikidata_description": "French astronomer", "wikipedia_url": "https://en.wikipedia.org/wiki/Louis%20Godin", "wikipedia_extract": "Louis Godin (28 February 1704 \u2013 11 September 1760) was a French astronomer and member of the French Academy of Sciences. He worked in Peru, Spain, Portugal and France. Godin was born in Paris; his parents were Fran\u00e7ois Godin and Elisabeth Charron. He was graduated at the College of Louis le Grand, and studied astronomy under Joseph-Nicolas Delisle. His astronomical tables (1724) gave him reputation, and the French Academy of Sciences elected him a pensionary member. He was commissioned to write a continuation of the history of the academy, left uncompleted by Bernard le Bovier de Fontenelle, and was also authorized to submit to the minister, Cardinal Andr\u00e9-Hercule de Fleury, the best means of discovering the truth in regard to the figure of the Earth, and proposed sending expeditions to the equator and the polar sea."}}, {"canonical_name": "ALTA\u00cf", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "alta\u00ef", "book_id": "relation_historique_humboldt_vol3_1825", "name": "ALTA\u00cf", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Alta\u00ef", "ALTA\u00cf"], "contexts": ["mountains visited during a voyage", "mountain range visited for observations"]}, {"entity_id": "altai", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Altai", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Altai"], "contexts": ["mountain range name"]}, {"entity_id": "altai", "book_id": "kosmos_humboldt_1845", "name": "Altai", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Altai"], "contexts": ["mountain chain", "geographic region"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "ALTA\u00cf", "target_book": "kosmos_humboldt_1845", "target_name": "Altai", "similarity": 0.843}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Altai", "target_book": "kosmos_humboldt_1845", "target_name": "Altai", "similarity": 0.789}], "id": 3086, "stable_key": "clu_6416a8e05e2fc62e", "ground_truth": {"modern_name": "Alps", "confidence": "high", "type": "place", "country": "Switzerland", "note": "'Alpes maritimes' is a specific part of the Alps. 'Altai' is a different mountain range, but 'Alps' is the dominant term.", "wikidata_id": "Q5955", "wikidata_description": "Human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Altai_Mountains", "wikipedia_extract": "The Altai Mountains ( ahl-TY) are a mountain range in Central Asia, where Russia, China, Mongolia, and Kazakhstan converge, and where the rivers Irtysh and Ob have their headwaters. The highest summit of the range is Belukha, whose summit reaches 4,506 m (14,783 ft) above sea level. The massif merges with the Sayan Mountains in the northeast, and gradually becomes lower in the southeast, where it merges into the high plateau of the Gobi Desert. In the southwest, it is separated from the higher Tian Shan range by the Junggar Basin. It spans from about 45\u00b0 to 52\u00b0 N and from about 84\u00b0 to 99\u00b0 E. The region is inhabited by a sparse but ethnically diverse population, including Turkic peoples, Mongols, and Volga Germans, though predominantly represented by indigenous ethnic minorities of semi-nomadic people."}}, {"canonical_name": "chr\u00e9tiens", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "chr\u00e9tiens", "book_id": "relation_historique_humboldt_vol3_1825", "name": "chr\u00e9tiens", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["chr\u00e9tiens", "chr\u00e9tienne", "chr\u00e9tient\u00e9"], "contexts": ["followers of Christianity", "religion practiced by a tribe"]}, {"entity_id": "christ\u00e3os", "book_id": "coloquios_da_orta_1563", "name": "christ\u00e3os", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["christ\u00e3os", "christandade", "christ\u00e3o"], "contexts": ["Christians", "called dogs by mussulmans"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "chr\u00e9tiens", "target_book": "coloquios_da_orta_1563", "target_name": "christ\u00e3os", "similarity": 0.945}], "id": 3087, "stable_key": "clu_eaf225a7084125af-2", "ground_truth": {"modern_name": "Christians", "confidence": "high", "type": "concept", "wikidata_id": "Q5043", "wikidata_description": "Abrahamic monotheistic religion founded on the teachings, person and life of Jesus", "note": "Refers to someone adhering to Christianity."}}, {"canonical_name": "lunar eclipses", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "\u00e9clipse_de_lune", "book_id": "relation_historique_humboldt_vol3_1825", "name": "\u00e9clipse de lune", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["\u00e9clipse de lune", "Eclipses de soleil", "\u00e9clipses du soleil"], "contexts": ["astronomical phenomenon", "astronomical events used for longitude"]}, {"entity_id": "lunar_eclipses", "book_id": "connexion_physical_sciences_somerville_1858", "name": "lunar eclipses", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["lunar eclipses", "Lunar Eclipses"], "contexts": ["Earth's shadow on the Moon", "shadowing of Moon by Earth"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "\u00e9clipse de lune", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lunar eclipses", "similarity": 0.932}], "id": 3088, "stable_key": "clu_9c30fd84a7ec1e7c", "ground_truth": {"modern_name": "Lunar eclipse", "confidence": "high", "type": "concept"}}, {"canonical_name": "obsidian", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "obsidienne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "obsidienne", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["obsidienne"], "contexts": ["Geological formation", "roche volcanique"]}, {"entity_id": "obsidian", "book_id": "kosmos_humboldt_1845", "name": "obsidian", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["obsidian"], "contexts": ["vitrified mass struck in cavities", "vitrified mass struck in subterranean cavities"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "obsidienne", "target_book": "kosmos_humboldt_1845", "target_name": "obsidian", "similarity": 0.96}], "id": 3089, "stable_key": "clu_f4147a75be0e6094", "ground_truth": {"modern_name": "obsidian", "confidence": "high", "type": "mineral", "wikidata_id": "Q53754", "wikidata_description": "naturally occurring volcanic glass"}}, {"canonical_name": "Burckhardt", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "burckhardt", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Burckhardt", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Burckhardt"], "contexts": ["author of accounts"]}, {"entity_id": "burckhardt", "book_id": "kosmos_humboldt_1845", "name": "Burckhardt", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["Burckhardt"], "contexts": ["determined Moon's radius and volume", "associated with a comet of 1770"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Burckhardt", "target_book": "kosmos_humboldt_1845", "target_name": "Burckhardt", "similarity": 0.805}], "id": 3090, "stable_key": "clu_a4684bb4674af1bd", "ground_truth": {"modern_name": "Johann Ludwig Burckhardt", "confidence": "high", "type": "person", "birth_year": 1784, "death_year": 1817, "description": "Swiss explorer and orientalist, known for research on the Moon.", "note": "The context implies scientific/astronomical contributions, which is unusual for the famous explorer. However, the name and repeated mentions in Humboldt's works suggest it is indeed him.", "wikidata_id": "Q39691", "wikidata_description": "Swiss traveller and writer (1784-1817)"}}, {"canonical_name": "quartzose porphyry", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "porphyre_quarzi\u00e8re", "book_id": "relation_historique_humboldt_vol3_1825", "name": "porphyre quarzi\u00e8re", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["porphyre quarzi\u00e8re"], "contexts": ["quartz porphyry rock type"]}, {"entity_id": "porphyre_quartz\u00e9ux", "book_id": "relation_historique_humboldt_vol3_1825", "name": "porphyre quartz\u00e9ux", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["porphyre quartz\u00e9ux"], "contexts": ["porphyre quartz\u00e9ux"]}, {"entity_id": "quartzose_porphyry", "book_id": "kosmos_humboldt_1845", "name": "quartzose porphyry", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["quartzose porphyry", "Quartzose porphyry"], "contexts": ["type of rock", "rock type found in veins"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "porphyre quarzi\u00e8re", "target_book": "kosmos_humboldt_1845", "target_name": "quartzose porphyry", "similarity": 0.946}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "porphyre quartz\u00e9ux", "target_book": "kosmos_humboldt_1845", "target_name": "quartzose porphyry", "similarity": 0.929}], "id": 3091, "stable_key": "clu_6a3e2af90018d3d8", "ground_truth": {"modern_name": "quartz porphyry", "confidence": "high", "type": "mineral"}}, {"canonical_name": "Hamilton", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "hamilton", "book_id": "principles_of_psychology_james_1890", "name": "Hamilton", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["Hamilton"], "contexts": ["philosopher, presentation and representation", "doctrine of soul's presence to body"]}, {"entity_id": "hamilton", "book_id": "first_principles_spencer_1862", "name": "Hamilton", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Hamilton"], "contexts": ["philosopher whose doctrine is extended"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Hamilton", "target_book": "first_principles_spencer_1862", "target_name": "Hamilton", "similarity": 1.0}], "id": 3092, "stable_key": "clu_15238fbb7e3e88f1", "ground_truth": {"modern_name": "Sir William Rowan Hamilton", "confidence": "high", "type": "person", "birth_year": 1805, "death_year": 1865, "description": "Irish physicist, mathematician, and astronomer. Important for quaternions and optics.", "note": "While 'Hamilton' is ambiguous, James and Spencer were prominent thinkers influenced by or engaging with scientific developments. William Rowan Hamilton was a major figure in mathematics and physics in the 19th century, whose work could be referenced in philosophical discussions of principles.", "wikidata_id": "Q11887", "wikidata_description": "Irish mathematician and astronomer (1805-1865)"}}, {"canonical_name": "personal consciousness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "personal_consciousness", "book_id": "principles_of_psychology_james_1890", "name": "personal consciousness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["personal consciousness"], "contexts": ["individual awareness of mental states", "individual awareness"]}, {"entity_id": "consciousness_of_self", "book_id": "first_principles_spencer_1862", "name": "consciousness of self", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["consciousness of self"], "contexts": ["awareness of one's own existence"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "personal consciousness", "target_book": "first_principles_spencer_1862", "target_name": "consciousness of self", "similarity": 0.915}], "id": 3093, "stable_key": "clu_fad1e6499454b3ca-3", "ground_truth": {"modern_name": "consciousness", "confidence": "high", "type": "concept", "note": "The overwhelming number of occurrences of 'consciousness' and related terms in William James's work firmly identifies this cluster.", "wikidata_id": "Q4313500", "wikidata_description": "medical condition that inhibits consciousness, sprituality", "wikipedia_url": "https://en.wikipedia.org/wiki/Disorder%20of%20consciousness", "wikipedia_extract": "Consciousness is being aware of something internal to one's self or being conscious of states or objects in one's external environment. It has been the topic of extensive explanations, analyses, and debate among philosophers, scientists, and theologians for millennia. There is no consensus on what exactly needs to be studied, or even if consciousness can be considered a scientific concept. In some explanations, it is synonymous with mind, while in others it is considered an aspect of it. In the past, consciousness meant one's \"inner life\": the world of introspection, private thought, imagination, and volition. Today, it often includes any kind of cognition, experience, feeling, or perception."}}, {"canonical_name": "habitual", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "habitual", "book_id": "principles_of_psychology_james_1890", "name": "habitual", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["habitual"], "contexts": ["performed by habit", "processes that are automatic and easy"]}, {"entity_id": "habitually", "book_id": "principles_of_psychology_james_1890", "name": "habitually", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["habitually"], "contexts": ["related to repeated association"]}, {"entity_id": "habitually", "book_id": "first_principles_spencer_1862", "name": "habitually", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["habitually"], "contexts": ["done by habit or custom", "acting by repeated practice"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "habitual", "target_book": "first_principles_spencer_1862", "target_name": "habitually", "similarity": 0.832}, {"source_book": "principles_of_psychology_james_1890", "source_name": "habitually", "target_book": "first_principles_spencer_1862", "target_name": "habitually", "similarity": 1.0}], "id": 3094, "stable_key": "clu_c8a62cedb3cb68be-3", "ground_truth": {"modern_name": "Habits", "confidence": "high", "type": "concept", "note": "Refers to learned behaviors and ingrained patterns of action, both in animals and humans.", "wikidata_id": "Q52105", "wikidata_description": "ecological or environmental area inhabited by a particular species; natural environment in which an organism lives, or the physical environment that surrounds a species population"}}, {"canonical_name": "belief", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "belief", "book_id": "principles_of_psychology_james_1890", "name": "belief", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Belief", "belief"], "contexts": ["acceptance of something as true", "feeling of conviction in an object's reality"]}, {"entity_id": "belief", "book_id": "first_principles_spencer_1862", "name": "belief", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["belief"], "contexts": ["acceptance of something as true"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "belief", "target_book": "first_principles_spencer_1862", "target_name": "belief", "similarity": 1.0}], "id": 3095, "stable_key": "clu_536b4b9ce6608f45", "ground_truth": {"modern_name": "Belief", "confidence": "high", "type": "concept", "wikidata_id": "Q812540", "wikidata_description": "probabilistic graphical model that represents a set of variables and their conditional dependencies via a directed acyclic graph"}}, {"canonical_name": "hypnotism", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "hypnotism", "book_id": "principles_of_psychology_james_1890", "name": "hypnotism", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 4, "variants": ["hypnotism"], "contexts": ["induced state of altered consciousness", "induced state of trance"]}, {"entity_id": "hypnotic", "book_id": "principles_of_psychology_james_1890", "name": "hypnotic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["hypnotic"], "contexts": ["related to hypnosis"]}, {"entity_id": "hypnotically", "book_id": "principles_of_psychology_james_1890", "name": "hypnotically", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hypnotically"], "contexts": ["in a state of hypnosis"]}, {"entity_id": "hypnotica", "book_id": "polyanthea_medicinal", "name": "hypnotica", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hypnotica"], "contexts": ["hypnotic quality"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "hypnotism", "target_book": "polyanthea_medicinal", "target_name": "hypnotica", "similarity": 0.958}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hypnotic", "target_book": "polyanthea_medicinal", "target_name": "hypnotica", "similarity": 0.967}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hypnotically", "target_book": "polyanthea_medicinal", "target_name": "hypnotica", "similarity": 0.933}], "id": 3096, "stable_key": "clu_1dccd8dd05ea1ba8", "ground_truth": {"modern_name": "hypnotic", "confidence": "high", "type": "concept", "description": "Related to or inducing a state of hypnosis.", "wikipedia_extract": "A hypnotic (from Greek Hypnos, sleep), also known as a somnifacient or soporific, and commonly known as sleeping pills, are a class of psychoactive drugs whose primary function is to induce sleep and to treat insomnia (sleeplessness). Some hypnotics are also used to treat narcolepsy and hypersomnia by improving sleep at night and thereby reducing daytime sleepiness. Certain hypnotics can be used to treat non-restorative sleep and associated symptoms in conditions like fibromyalgia as well. This group of drugs is related to sedatives. Whereas the term sedative describes drugs that serve to calm or relieve anxiety, the term hypnotic generally describes drugs whose main purpose is to initiate, sustain, or lengthen sleep. Because these two functions frequently overlap, and because drugs in this class generally produce dose-dependent effects (ranging from anxiolysis to loss of consciousness), they are often referred to collectively as sedative\u2013hypnotic drugs."}}, {"canonical_name": "Colors", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "colors", "book_id": "principles_of_psychology_james_1890", "name": "Colors", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["colors", "Colors"], "contexts": ["visual perception of light", "visual perception of light wavelengths"]}, {"entity_id": "colours", "book_id": "connexion_physical_sciences_somerville_1858", "name": "colours", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["colours"], "contexts": ["property of light", "perceived property of light"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Colors", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "colours", "similarity": 0.977}], "id": 3097, "stable_key": "clu_47296163f0ec0df4-3", "ground_truth": {"modern_name": "color", "confidence": "high", "type": "concept", "wikidata_id": "Q1261", "wikidata_description": "state of the United States of America", "wikipedia_url": "https://en.wikipedia.org/wiki/Color", "note": "The context in 'principles_of_psychology_james_1890' and 'relation_historique_humboldt_vol3_1825' might lean towards pigments or optical phenomena, but 'color' as a general concept covers these.", "wikipedia_extract": "Color (or colour in Commonwealth English; see spelling differences) is the visual perception based on the electromagnetic spectrum. Though color is not an inherent property of matter, color perception is related to an object's light absorption, emission, reflection and transmission. For most humans, visible wavelengths of light are the ones perceived in the visible light spectrum, with three types of cone cells (trichromacy). Other animals may have a different number of cone cell types or have eyes sensitive to different wavelengths, such as bees that can distinguish ultraviolet, and thus have a different color sensitivity range. Animal perception of color originates from different light wavelength or spectral sensitivity in cone cell types, which is then processed by the brain. Colors have perceived properties such as hue, colorfulness, and lightness."}}, {"canonical_name": "representations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "representations", "book_id": "principles_of_psychology_james_1890", "name": "representations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["representations"], "contexts": ["mental images or ideas"]}, {"entity_id": "representation", "book_id": "principles_of_psychology_james_1890", "name": "representation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["representation"], "contexts": ["mental image or idea"]}, {"entity_id": "representation", "book_id": "first_principles_spencer_1862", "name": "representation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["representation"], "contexts": ["mental image or idea"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "representations", "target_book": "first_principles_spencer_1862", "target_name": "representation", "similarity": 0.941}, {"source_book": "principles_of_psychology_james_1890", "source_name": "representation", "target_book": "first_principles_spencer_1862", "target_name": "representation", "similarity": 1.0}], "id": 3098, "stable_key": "clu_a5d0c4793c73445d", "ground_truth": {"modern_name": "Representation", "confidence": "high", "type": "concept", "wikidata_id": "Q5244910", "wikidata_description": "organization that serves as an unofficial embassy"}}, {"canonical_name": "Hegel", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "hegel", "book_id": "principles_of_psychology_james_1890", "name": "Hegel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Hegel"], "contexts": ["philosopher whose passages are obscure", "philosopher who discussed being and nothing"]}, {"entity_id": "hegel", "book_id": "kosmos_humboldt_1845", "name": "Hegel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Hegel"], "contexts": ["philosopher quoted on history and nature", "19th-century German philosopher"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Hegel", "target_book": "kosmos_humboldt_1845", "target_name": "Hegel", "similarity": 1.0}], "id": 3099, "stable_key": "clu_d070aa815b2f9fe3", "ground_truth": {"modern_name": "Georg Wilhelm Friedrich Hegel", "confidence": "high", "type": "person", "birth_year": 1770, "death_year": 1831, "description": "German philosopher, key figure in idealism and phenomenology."}}, {"canonical_name": "clocks", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "clock", "book_id": "principles_of_psychology_james_1890", "name": "clock", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["clock"], "contexts": ["timekeeping device", "object that ticks"]}, {"entity_id": "clocks", "book_id": "connexion_physical_sciences_somerville_1858", "name": "clocks", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 4, "variants": ["clocks"], "contexts": ["timekeeping instruments", "devices for measuring time"]}, {"entity_id": "clock", "book_id": "connexion_physical_sciences_somerville_1858", "name": "clock", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["clock"], "contexts": ["device for measuring time"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "clock", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "clocks", "similarity": 0.939}, {"source_book": "principles_of_psychology_james_1890", "source_name": "clock", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "clock", "similarity": 1.0}], "id": 3100, "stable_key": "clu_61882fc77dc4bbec", "ground_truth": {"modern_name": "clock", "confidence": "high", "type": "object"}}, {"canonical_name": "grief", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "sorrow", "book_id": "principles_of_psychology_james_1890", "name": "sorrow", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["sorrow"], "contexts": ["inward emotional state", "broad genus of \u00e6sthetic feeling"]}, {"entity_id": "grief", "book_id": "first_principles_spencer_1862", "name": "grief", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["grief"], "contexts": ["deep sorrow", "intense sorrow"]}, {"entity_id": "sorrow", "book_id": "first_principles_spencer_1862", "name": "sorrow", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["sorrow"], "contexts": ["feeling of sadness", "feeling of deep sadness"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "sorrow", "target_book": "first_principles_spencer_1862", "target_name": "grief", "similarity": 0.932}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sorrow", "target_book": "first_principles_spencer_1862", "target_name": "sorrow", "similarity": 1.0}], "id": 3101, "stable_key": "clu_115610c837cc313b", "ground_truth": {"modern_name": "Grief", "confidence": "high", "type": "concept", "note": "Directly refers to the emotional state of sorrow or deep sadness.", "wikidata_id": "Q1026040", "wikidata_description": "reaction to loss of someone or something close or important", "wikipedia_url": "https://en.wikipedia.org/wiki/Grief", "wikipedia_extract": "Grief is the response to the loss of something deemed important, in particular the death of a person or animal to which a bond or affection was formed. Although conventionally focused on the emotional response to loss, grief also has physical, cognitive, behavioral, social, cultural, spiritual, political and philosophical dimensions. While the terms are often used interchangeably, bereavement refers to the state of loss, while grief is the reaction to that loss. The grief associated with death is familiar to most people, but individuals grieve in connection with a variety of losses throughout their lives, such as unemployment, ill health or the end of a relationship. Loss can be categorized as either physical or abstract; physical loss is related to something that the individual can touch or measure, such as losing a spouse through death, while other types of loss are more abstract, possibly relating to aspects of a person's social interactions. Modern research has moved beyond rigid stage-based models, such as K\u00fcbler-Ross's five stages, toward more flexible frameworks."}}, {"canonical_name": "Gulf Stream", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "gulf_stream", "book_id": "kosmos_humboldt_1845", "name": "Gulf Stream", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Gulf Stream"], "contexts": ["Atlantic warm Gulf Stream", "ocean current attributed to Varenius"]}, {"entity_id": "gulf_stream", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Gulf Stream", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Gulf Stream"], "contexts": ["ocean current followed by hurricane"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Gulf Stream", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Gulf Stream", "similarity": 1.0}], "id": 3102, "stable_key": "clu_ef1edfe81c4249ca", "ground_truth": {"modern_name": "Gulf Stream", "confidence": "high", "type": "place", "country": "Atlantic Ocean", "wikidata_id": "Q34771011", "wikidata_description": "river in Somerset County, Maine, United States of America"}}, {"canonical_name": "Pekin", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "pekin", "book_id": "kosmos_humboldt_1845", "name": "Pekin", "category": "PLACE", "subcategory": "CITY", "count": 7, "variants": ["Pekin"], "contexts": ["former name for Beijing", "end point of magnetic stations"]}, {"entity_id": "peking", "book_id": "coloquios_da_orta_1563", "name": "Peking", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Peking"], "contexts": ["city where J. Edkins is from"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Pekin", "target_book": "coloquios_da_orta_1563", "target_name": "Peking", "similarity": 0.94}], "id": 3103, "stable_key": "clu_bc03092b1e3e2c2c", "ground_truth": {"modern_name": "Beijing", "confidence": "high", "type": "place", "country": "China", "note": "'Pekin' is an older variant spelling for Beijing, the capital of China.", "wikidata_id": "Q956", "wikidata_description": "capital city of China", "wikipedia_extract": "Beijing, previously romanized as Peking, is the capital city of China. With more than 22 million residents, it is the world's most populous national capital city, as well as China's second largest city by urban area, after Shanghai. It is located in Northern China, and is governed as a municipality under the direct administration of the State Council with 16 urban districts. Beijing is mostly surrounded by Hebei Province and neighbors Tianjin to the southeast; together, the three divisions form the Jing-Jin-Ji cluster. Beijing is a global city and one of the world's leading centres for culture, diplomacy, politics, finance, business and economics, education, research, language, tourism, media, sport, science and technology, transportation, and art. It is home to the headquarters of most of China's largest state-owned companies and houses the largest number of Fortune Global 500 companies in the world, as well as the world's four biggest financial institutions by total assets.", "wikipedia_url": "https://en.wikipedia.org/wiki/Beijing"}}, {"canonical_name": "Dufrenoy", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "dufrenoy", "book_id": "kosmos_humboldt_1845", "name": "Dufrenoy", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["Dufrenoy"], "contexts": ["author of geological explanation", "author of Geologie de la France"]}, {"entity_id": "dufr\u00e9noy", "book_id": "coloquios_da_orta_1563", "name": "Dufr\u00e9noy", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Dufr\u00e9noy"], "contexts": ["author of mineralogy treatises"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Dufrenoy", "target_book": "coloquios_da_orta_1563", "target_name": "Dufr\u00e9noy", "similarity": 0.874}], "id": 3104, "stable_key": "clu_0681530c8db77d81", "ground_truth": {"modern_name": "Odet-Julien d'Uzes Dufrenoy", "confidence": "high", "type": "person", "birth_year": 1787, "death_year": 1857, "description": "French geologist and mineralogist, co-author of important geological works.", "note": "The provided context mentions geological and mineralogy treatises, fitting Dufrenoy's expertise. The name spelling variations are common."}}, {"canonical_name": "Central Asia", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "central_asia", "book_id": "kosmos_humboldt_1845", "name": "Central Asia", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Central Asia"], "contexts": ["region with favorable land configuration", "geographic region"]}, {"entity_id": "central_asia", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Central Asia", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Central Asia"], "contexts": ["mountains where Marco Polo felt difficulty", "mountains visited by Marco Polo"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Central Asia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Central Asia", "similarity": 1.0}], "id": 3105, "stable_key": "clu_197d0bb130bc8f74", "ground_truth": {"modern_name": "East Asia", "confidence": "high", "type": "place", "note": "The French 'Asie orientale' directly translates to 'East Asia'. 'Central Asia' is also a plausible interpretation in some contexts, but 'East Asia' is more encompassing given the provided contexts.", "wikidata_id": "Q156895", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Betula%20pendula", "wikipedia_extract": "Betula pendula, commonly known as silver birch, warty birch, European white birch, or East Asian white birch, is a species of tree in the family Betulaceae, native to Europe and parts of Asia, though in southern Europe, it is only found at higher altitudes. Its range extends into Siberia, China, and southwest Asia in the mountains of northern Turkey, the Caucasus, and northern Iran. It has been introduced into North America, where it is known as the European white birch or weeping birch and is considered invasive in some states in the United States and parts of Canada. The silver birch is a medium-sized deciduous tree that owes its common name to the white peeling bark on the trunk. The twigs are slender and often pendulous and the leaves are roughly triangular with doubly serrate margins and turn yellow and brown in autumn before they fall. The flowers are catkins and the light, winged seeds get widely scattered by the wind."}}, {"canonical_name": "Potash", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "potash", "book_id": "kosmos_humboldt_1845", "name": "Potash", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["potash", "Potash"], "contexts": ["chemical element in meteoric masses", "accompanying silica"]}, {"entity_id": "potash", "book_id": "connexion_physical_sciences_somerville_1858", "name": "potash", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["potash"], "contexts": ["alkaline substance used with azolitmine", "alkali decomposed by electricity"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Potash", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "potash", "similarity": 0.971}], "id": 3106, "stable_key": "clu_1232004f5968b2f4", "ground_truth": {"modern_name": "Potassium carbonate", "confidence": "high", "type": "chemical", "note": "Historically, 'potash' referred to potassium carbonate, a common alkali used in various chemical processes."}}, {"canonical_name": "carbonic acid gas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "carbonic_acid_gas", "book_id": "kosmos_humboldt_1845", "name": "carbonic acid gas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["carbonic acid gas"], "contexts": ["gas influencing plant assimilation", "gas exhalation from volcanic activity"]}, {"entity_id": "carbonic_acid_gases", "book_id": "kosmos_humboldt_1845", "name": "carbonic acid gases", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["carbonic acid gases"], "contexts": ["gas in hot springs"]}, {"entity_id": "carbonic_acid_gas", "book_id": "connexion_physical_sciences_somerville_1858", "name": "carbonic acid gas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["carbonic acid gas"], "contexts": ["gas consumed by plants for nourishment", "gas studied in spectral analysis"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "carbonic acid gas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "carbonic acid gas", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "carbonic acid gases", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "carbonic acid gas", "similarity": 0.944}], "id": 3107, "stable_key": "clu_3608d503c168f323", "ground_truth": {"modern_name": "Carbon dioxide", "confidence": "high", "type": "chemical", "note": "The descriptions clearly point to carbon dioxide, its role in plant assimilation and presence in hot springs.", "wikidata_id": "Q1997", "wikidata_description": "chemical compound"}}, {"canonical_name": "Greece", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "greece", "book_id": "kosmos_humboldt_1845", "name": "Greece", "category": "PLACE", "subcategory": "COUNTRY", "count": 5, "variants": ["Greece"], "contexts": ["country in Europe", "mainland with limestone transformation"]}, {"entity_id": "greece", "book_id": "first_principles_spencer_1862", "name": "Greece", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Greece"], "contexts": ["civilization that repeated art progress stages", "country where arts were united"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Greece", "target_book": "first_principles_spencer_1862", "target_name": "Greece", "similarity": 1.0}], "id": 3108, "stable_key": "clu_451098d60ff27967-2", "ground_truth": {"modern_name": "Greece", "confidence": "high", "type": "place", "description": "Southeastern European country, cradle of Western civilization and ancient knowledge.", "note": "Includes references to the Greek language and people.", "wikipedia_extract": "Greece, officially the Hellenic Republic, is a country in Southeast Europe. Located on the southern tip of the Balkan peninsula, it shares land borders with Albania to the northwest, North Macedonia and Bulgaria to the north, and Turkey to the east. The Aegean Sea lies to the east of the mainland, the Ionian Sea to the west, and the Sea of Crete and the Mediterranean Sea to the south. Greece has the longest coastline on the Mediterranean basin, spanning thousands of islands and nine traditional geographic regions. It has a population of over 10 million. Athens is the nation's capital and largest city, followed by Thessaloniki and Patras."}}, {"canonical_name": "aerolite", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "aerolite", "book_id": "kosmos_humboldt_1845", "name": "aerolite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["aerolite"], "contexts": ["meteorite that fell in Maryland", "object found at Aegos Potamos"]}, {"entity_id": "a\u00ebrolite", "book_id": "kosmos_humboldt_1845", "name": "a\u00ebrolite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["a\u00ebrolite"], "contexts": ["another term for meteoric stone", "stone falling from heaven"]}, {"entity_id": "a\u00ebrolite", "book_id": "connexion_physical_sciences_somerville_1858", "name": "a\u00ebrolite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["a\u00ebrolite"], "contexts": ["meteorite that reaches the earth's surface"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "aerolite", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "a\u00ebrolite", "similarity": 0.828}, {"source_book": "kosmos_humboldt_1845", "source_name": "a\u00ebrolite", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "a\u00ebrolite", "similarity": 1.0}], "id": 3109, "stable_key": "clu_1accce3775f1c3ef-3", "ground_truth": {"modern_name": "meteorites", "confidence": "high", "type": "mineral", "note": "The term 'aerufegi' appears to be an OCR error or very obscure variant.", "wikidata_id": "Q18104262", "wikidata_description": "genus of insects"}}, {"canonical_name": "falling stars", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "falling_stars", "book_id": "kosmos_humboldt_1845", "name": "falling stars", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["falling stars"], "contexts": ["meteoric phenomenon", "celestial objects entering atmosphere"]}, {"entity_id": "falling_stars", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Falling stars", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Falling stars", "falling stars"], "contexts": ["meteors igniting in atmosphere", "celestial phenomena and theories"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "falling stars", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Falling stars", "similarity": 0.987}], "id": 3110, "stable_key": "clu_0dbb245e717115e6", "ground_truth": {"modern_name": "Meteor", "confidence": "high", "type": "concept", "note": "While 'shooting stars' is a common name, 'meteor' is the scientific term for the phenomenon.", "wikidata_id": "Q14502780", "wikidata_description": "genus of insects"}}, {"canonical_name": "Calabria", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "calabria", "book_id": "kosmos_humboldt_1845", "name": "Calabria", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Calabria"], "contexts": ["region experiencing earthquake", "region with cities destroyed by earthquake"]}, {"entity_id": "cal\u00e1bria", "book_id": "coloquios_da_orta_1563", "name": "Cal\u00e1bria", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Cal\u00e1bria"], "contexts": ["region with similar substance", "region where manna was collected"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Calabria", "target_book": "coloquios_da_orta_1563", "target_name": "Cal\u00e1bria", "similarity": 0.75}], "id": 3111, "stable_key": "clu_577281248afa1288", "ground_truth": {"modern_name": "Calabria", "confidence": "high", "type": "place", "description": "Region in Southern Italy known for minerals and manna.", "note": "Refers to the geographical region of Calabria in Italy.", "wikipedia_extract": "Calabria is a region in Southern Italy. It is a peninsula bordered by the region Basilicata to the north, the Ionian Sea to the east, the Strait of Messina to the southwest, which separates it from Sicily, and the Tyrrhenian Sea to the west. It has 1,832,147 residents as of 2025 across a total area of 15,222 km2 (5,877 sq mi). Catanzaro is the region's capital. Calabria is the birthplace of the name of Italy, given to it by the Ancient Greeks who settled in this land starting from the 8th century BC. They established the first cities, mainly on the coast, as Greek colonies."}}, {"canonical_name": "British Islands", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "british_islands", "book_id": "kosmos_humboldt_1845", "name": "British Islands", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["British Islands"], "contexts": ["location of lignite deposits", "geographic area for faunas and floras"]}, {"entity_id": "british_isles", "book_id": "kosmos_humboldt_1845", "name": "British Isles", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["British Isles"], "contexts": ["location of flora and faunas", "geographic location for flora and fauna distribution"]}, {"entity_id": "british_islands", "book_id": "connexion_physical_sciences_somerville_1858", "name": "British Islands", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["British Islands"], "contexts": ["area where November wave passes"]}, {"entity_id": "british_isles", "book_id": "connexion_physical_sciences_somerville_1858", "name": "British Isles", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["British Isles"], "contexts": ["atmospheric wave passing over"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "British Islands", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "British Islands", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "British Islands", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "British Isles", "similarity": 0.892}, {"source_book": "kosmos_humboldt_1845", "source_name": "British Isles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "British Islands", "similarity": 0.892}, {"source_book": "kosmos_humboldt_1845", "source_name": "British Isles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "British Isles", "similarity": 1.0}], "id": 3112, "stable_key": "clu_e5ffe0989bac6ec4", "ground_truth": {"modern_name": "United Kingdom", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q38272", "wikidata_description": "group of islands in northwest Europe"}}, {"canonical_name": "mosses", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "mosses", "book_id": "kosmos_humboldt_1845", "name": "mosses", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["mosses"], "contexts": ["plant type in ancient forests", "plant group with antheridia"]}, {"entity_id": "mosses", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mosses", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["mosses"], "contexts": ["small, non-flowering plants", "low order of vegetable creation"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "mosses", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mosses", "similarity": 1.0}], "id": 3113, "stable_key": "clu_4b4f8a942df93fe1-2", "ground_truth": {"modern_name": "moss", "confidence": "high", "type": "plant", "note": "Early modern texts often referred to mosses collectively without specific taxonomic classification.", "wikidata_id": "Q25347", "wikidata_description": "division of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Moss", "wikipedia_extract": "Mosses are small, non-vascular flowerless plants in the taxonomic division Bryophyta (, ) sensu stricto. Bryophyta (sensu lato, Schimp. 1879) may also refer to the parent group bryophytes, which comprise liverworts, mosses, and hornworts. Mosses typically form dense green clumps or mats, often in damp or shady locations. The individual plants are usually composed of simple leaves that are generally only one cell thick, attached to a stem that may be branched or unbranched and has only a limited role in conducting water and nutrients. Although some species have conducting tissues, these are generally poorly developed and structurally different from similar tissue found in vascular plants. Mosses do not have seeds and after fertilisation develop sporophytes with unbranched stalks topped with single capsules containing spores."}}, {"canonical_name": "Padua", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "padua", "book_id": "kosmos_humboldt_1845", "name": "Padua", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Padua"], "contexts": ["city in Italy", "city with high annual temperature"]}, {"entity_id": "padua", "book_id": "polyanthea_medicinal", "name": "Padua", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Padua"], "contexts": ["city where Alexandre Maflaria lectured", "city where Augenio was professor"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Padua", "target_book": "polyanthea_medicinal", "target_name": "Padua", "similarity": 1.0}], "id": 3114, "stable_key": "clu_83321e96191294dd", "ground_truth": {"modern_name": "Padua", "confidence": "high", "type": "place", "description": "A historic city in Italy, known for its university and academic figures.", "wikipedia_extract": "Padua ( PAD-ew-\u0259) is a city and comune (municipality) in Veneto, northern Italy, and the capital of the province of Padua. The city lies on the banks of the river Bacchiglione, 40 kilometres (25 miles) west of Venice and 29 km (18 miles) southeast of Vicenza. With a population of 207,694 as of 2025, Padua is the third-largest city in Veneto. It is also the economic and communications hub of the area. Padua is sometimes included, with Venice and Treviso, in the Padua-Treviso-Venice Metropolitan Area (PATREVE), which has a population of around 2,600,000. Besides the Bacchiglione, the Brenta River, which once ran through the city, still touches the northern districts."}}, {"canonical_name": "Seaweeds", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "weeds_of_the_sea", "book_id": "kosmos_humboldt_1845", "name": "weeds of the sea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["weeds of the sea"], "contexts": ["vegetation on the ocean shore"]}, {"entity_id": "sea_weeds", "book_id": "kosmos_humboldt_1845", "name": "sea weeds", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["sea weeds"], "contexts": ["fossil remains in ancient strata"]}, {"entity_id": "sea-weed", "book_id": "kosmos_humboldt_1845", "name": "sea-weed", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["sea-weed"], "contexts": ["borne by current, indicates velocity"]}, {"entity_id": "seaweeds", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Seaweeds", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["seaweeds", "Seaweeds"], "contexts": ["objects for photographic impressions", "organisms with colors"]}, {"entity_id": "sea-weeds", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sea-weeds", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["sea-weeds"], "contexts": ["marine algae in Cryptogamia"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "weeds of the sea", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Seaweeds", "similarity": 0.917}, {"source_book": "kosmos_humboldt_1845", "source_name": "weeds of the sea", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sea-weeds", "similarity": 0.957}, {"source_book": "kosmos_humboldt_1845", "source_name": "sea weeds", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Seaweeds", "similarity": 0.95}, {"source_book": "kosmos_humboldt_1845", "source_name": "sea weeds", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sea-weeds", "similarity": 0.986}, {"source_book": "kosmos_humboldt_1845", "source_name": "sea-weed", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sea-weeds", "similarity": 0.891}], "id": 3115, "stable_key": "clu_cc568e545eb4304e", "ground_truth": {"modern_name": null, "confidence": "high", "type": "plant", "note": "Refers to a broad category of marine algae, not a specific species.", "wikidata_id": "Q606703", "wikidata_description": "genus of fishes (Syngnathus)"}}, {"canonical_name": "gr\u00e3os", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "grain", "book_id": "kosmos_humboldt_1845", "name": "grain", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["grain"], "contexts": ["cultivated crops on slopes"]}, {"entity_id": "gr\u00e3os", "book_id": "coloquios_da_orta_1563", "name": "gr\u00e3os", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["gr\u00e3os", "gr\u00e3os de trigo"], "contexts": ["seeds used in medicine", "fruit of the cubebas tree"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "grain", "target_book": "coloquios_da_orta_1563", "target_name": "gr\u00e3os", "similarity": 0.888}], "id": 3116, "stable_key": "clu_0be9cc9bde4dcac2", "ground_truth": {"modern_name": "Grains", "confidence": "medium", "type": "plant", "note": "The term 'gr\u00e3os' is very general and can refer to various seeds or cereals. Context suggests cultivated crops and medicinal seeds, but without further specification, it's difficult to pinpoint a single Linnaean binomial. 'Grain' is a broad English translation.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "gaseous", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "gaseous_substances", "book_id": "kosmos_humboldt_1845", "name": "gaseous substances", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["gaseous substances"], "contexts": ["substances in gaseous state"]}, {"entity_id": "gaseo-fluid", "book_id": "kosmos_humboldt_1845", "name": "gaseo-fluid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["gaseo-fluid"], "contexts": ["state between gas and liquid"]}, {"entity_id": "gaseous_fluids", "book_id": "kosmos_humboldt_1845", "name": "gaseous fluids", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["gaseous fluids"], "contexts": ["fluids rising from earth's interior"]}, {"entity_id": "gaseous", "book_id": "first_principles_spencer_1862", "name": "gaseous", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["gaseous"], "contexts": ["state of matter like a gas", "state of matter"]}, {"entity_id": "gaseous_matters", "book_id": "first_principles_spencer_1862", "name": "gaseous matters", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["gaseous matters"], "contexts": ["motions on Earth's surface"]}, {"entity_id": "gaseous_matter", "book_id": "first_principles_spencer_1862", "name": "gaseous matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["gaseous matter"], "contexts": ["state of matter"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "gaseous substances", "target_book": "first_principles_spencer_1862", "target_name": "gaseous", "similarity": 0.962}, {"source_book": "kosmos_humboldt_1845", "source_name": "gaseous substances", "target_book": "first_principles_spencer_1862", "target_name": "gaseous matters", "similarity": 0.99}, {"source_book": "kosmos_humboldt_1845", "source_name": "gaseous substances", "target_book": "first_principles_spencer_1862", "target_name": "gaseous matter", "similarity": 0.977}, {"source_book": "kosmos_humboldt_1845", "source_name": "gaseo-fluid", "target_book": "first_principles_spencer_1862", "target_name": "gaseous", "similarity": 0.921}, {"source_book": "kosmos_humboldt_1845", "source_name": "gaseous fluids", "target_book": "first_principles_spencer_1862", "target_name": "gaseous", "similarity": 0.956}, {"source_book": "kosmos_humboldt_1845", "source_name": "gaseous fluids", "target_book": "first_principles_spencer_1862", "target_name": "gaseous matters", "similarity": 0.964}, {"source_book": "kosmos_humboldt_1845", "source_name": "gaseous fluids", "target_book": "first_principles_spencer_1862", "target_name": "gaseous matter", "similarity": 0.952}], "id": 3117, "stable_key": "clu_8ab19821da76c0dd", "ground_truth": {"modern_name": "Gaseous substances", "confidence": "high", "type": "concept"}}, {"canonical_name": "Jupiter\u2019s satellites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "jupiter's_satellites", "book_id": "kosmos_humboldt_1845", "name": "Jupiter's satellites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Jupiter's satellites"], "contexts": ["celestial bodies used for geographical determination"]}, {"entity_id": "jupiter\u2019s_satellites", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Jupiter\u2019s satellites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 6, "variants": ["Jupiter\u2019s satellites", "Jupiter\u2019s Satellites"], "contexts": ["moons of Jupiter", "moons orbiting Jupiter"]}, {"entity_id": "jupiter's_satellites", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Jupiter's satellites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Jupiter's satellites"], "contexts": ["theory of"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Jupiter's satellites", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Jupiter\u2019s satellites", "similarity": 0.998}, {"source_book": "kosmos_humboldt_1845", "source_name": "Jupiter's satellites", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Jupiter's satellites", "similarity": 1.0}], "id": 3118, "stable_key": "clu_2fa1f8ceaf6594dd", "ground_truth": {"modern_name": "moons of Jupiter", "confidence": "high", "type": "object", "note": "Early astronomical texts sometimes used poetic or mythological names for celestial bodies and their satellites.", "wikidata_id": "Q61702557", "wikidata_description": "natural satellite orbiting Jupiter", "wikipedia_url": "https://en.wikipedia.org/wiki/Moon%20of%20Jupiter"}}, {"canonical_name": "Airy", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "airy", "book_id": "kosmos_humboldt_1845", "name": "Airy", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Airy"], "contexts": ["contributor to science"]}, {"entity_id": "airy", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Airy", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["Airy"], "contexts": ["arrived at similar earth figure results", "scientist"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Airy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Airy", "similarity": 1.0}], "id": 3119, "stable_key": "clu_5a62bb640c786593", "ground_truth": {"modern_name": "George Biddell Airy", "confidence": "high", "type": "person", "birth_year": 1801, "death_year": 1892, "description": "Astronomer Royal, made significant contributions to geodesy and science.", "wikidata_id": "Q20018", "wikidata_description": "English mathematician and astronomer (*1801 \u2013 \u20201892)"}}, {"canonical_name": "sulphate of lime", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "sulphates_of_lime", "book_id": "kosmos_humboldt_1845", "name": "sulphates of lime", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["sulphates of lime"], "contexts": ["mineral salt"]}, {"entity_id": "sulphate_of_lime", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sulphate of lime", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["sulphate of lime", "Sulphate of Lime"], "contexts": ["crystal for polarized light phenomena", "mineral compound used in optics"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "sulphates of lime", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sulphate of lime", "similarity": 0.943}], "id": 3120, "stable_key": "clu_1912aecbbb0020f3-2", "ground_truth": {"modern_name": "Gypsum", "confidence": "high", "type": "mineral", "wikidata_id": "Q82658", "wikidata_description": "mineral, calcium sulfate with bounded water", "wikipedia_url": "https://en.wikipedia.org/wiki/Gypsum", "wikipedia_extract": "Gypsum is a soft sulfate mineral composed of calcium sulfate dihydrate, with the chemical formula CaSO4\u00b72H2O. It is widely mined and is used as a fertilizer and as the main constituent in many forms of plaster, drywall and blackboard or sidewalk chalk. Gypsum also crystallizes as translucent crystals of selenite. It forms as an evaporite mineral and as a hydration product of anhydrite. The Mohs scale of mineral hardness defines gypsum as hardness value 2 based on scratch hardness comparison. Fine-grained white or lightly tinted forms of gypsum known as alabaster have been used for sculpture by many cultures including Ancient Egypt, Mesopotamia, Ancient Rome, the Byzantine Empire, and the Nottingham alabasters of Medieval England.", "note": "The term 'gesso' in this context refers to gypsum, a mineral commonly used in medicinal preparations and sometimes for adulteration."}}, {"canonical_name": "isothermal lines", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "chthonisothermal_lines", "book_id": "kosmos_humboldt_1845", "name": "chthonisothermal lines", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["chthonisothermal lines"], "contexts": ["alternative term for isogeothermal lines"]}, {"entity_id": "isothermal_lines", "book_id": "connexion_physical_sciences_somerville_1858", "name": "isothermal lines", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["isothermal lines", "Isothermal Lines", "Isothermal lines"], "contexts": ["lines of equal temperature", "lines of equal mean annual temperature"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "chthonisothermal lines", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "isothermal lines", "similarity": 0.886}], "id": 3121, "stable_key": "clu_e146910e40386ba2", "ground_truth": {"modern_name": "Isotherms", "confidence": "high", "type": "concept"}}, {"canonical_name": "salud", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "salud", "book_id": "historia_medicinal_monardes_1574", "name": "salud", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["salud", "salud corporal"], "contexts": ["health desired by the father", "state of being well"]}, {"entity_id": "sa\u00fade", "book_id": "coloquios_da_orta_1563", "name": "sa\u00fade", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sa\u00fade"], "contexts": ["state of well-being"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "salud", "target_book": "coloquios_da_orta_1563", "target_name": "sa\u00fade", "similarity": 0.993}], "id": 3122, "stable_key": "clu_f9be01a7b86dc130", "ground_truth": {"modern_name": "Health", "confidence": "high", "type": "concept", "note": "The terms 'salud', 'sa\u00fade', and 'health' in the provided contexts clearly refer to the state of well-being and absence of disease.", "wikidata_id": "Q189603", "wikidata_description": "science and art of preventing disease, prolonging life and promoting health through organized efforts and informed choices of society, organizations, public and private, communities and individuals", "wikipedia_url": "https://en.wikipedia.org/wiki/Public%20health", "wikipedia_extract": "Public health is \"the science and art of preventing disease, prolonging life and promoting health through the organized efforts and informed choices of society, organizations, public and private, communities and individuals\". Analyzing the determinants of health of a population and the threats it faces is the basis for public health. The public can be as small as a handful of people or as large as a village or an entire city; in the case of a pandemic it may encompass several continents. The concept of health takes into account physical, psychological, and social well-being, among other factors. Public health is an interdisciplinary field. For example, epidemiology, biostatistics, social sciences and management of health services are all relevant."}}, {"canonical_name": "enfermo", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "enfermo", "book_id": "historia_medicinal_monardes_1574", "name": "enfermo", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 7, "variants": ["enfermo", "enfermos"], "contexts": ["sick person", "patient undergoing treatment"]}, {"entity_id": "enfermo", "book_id": "coloquios_da_orta_1563", "name": "ENFERMO", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["ENFERMO"], "contexts": ["patient in dialogue"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "enfermo", "target_book": "coloquios_da_orta_1563", "target_name": "ENFERMO", "similarity": 0.941}], "id": 3123, "stable_key": "clu_1912a148f56ef022-2", "ground_truth": {"modern_name": "Patient", "confidence": "high", "type": "concept", "note": "The Spanish/Portuguese term 'enfermo' translates directly to 'sick person' or 'patient'.", "wikidata_id": "Q181600", "wikidata_description": "person who takes a medical treatment or is subject of a case study"}}, {"canonical_name": "Amato Lusitano", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "amato_lulitana", "book_id": "historia_medicinal_monardes_1574", "name": "Amato Lulitana", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Amato Lulitana", "Amato Lulitano"], "contexts": ["learned doctor, commented on Dioscorides", "early modern scholar"]}, {"entity_id": "amato_lusitano", "book_id": "coloquios_da_orta_1563", "name": "Amato Lusitano", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Amato Lusitano", "Amatus Lusitanus"], "contexts": ["early modern writer", "pharmacologist who commented on Dioscorides"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Amato Lulitana", "target_book": "coloquios_da_orta_1563", "target_name": "Amato Lusitano", "similarity": 0.872}], "id": 3124, "stable_key": "clu_14735447ce1ac0e6", "ground_truth": {"modern_name": "Amato Lusitano", "confidence": "high", "type": "person", "birth_year": 1511, "death_year": 1583, "description": "Portuguese physician and botanist of Jewish descent"}}, {"canonical_name": "porcelana", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "porcelanas", "book_id": "historia_medicinal_monardes_1574", "name": "porcelanas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["porcelanas"], "contexts": ["porcelain fragments"]}, {"entity_id": "porcelana", "book_id": "coloquios_da_orta_1563", "name": "porcelana", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 7, "variants": ["porcelana", "porcellana"], "contexts": ["merchandise from China", "ceramic material traded"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "porcelanas", "target_book": "coloquios_da_orta_1563", "target_name": "porcelana", "similarity": 0.948}], "id": 3125, "stable_key": "clu_e5436b0844002c5b", "ground_truth": {"modern_name": "Porcelain", "confidence": "high", "type": "object", "description": "A hard, white, ceramic material, often decorated, originating from China.", "note": "Also refers to a plant with a viscous juice.", "wikipedia_extract": "Porcelain (), also called china, is a ceramic material made by heating raw materials, generally including kaolinite, in a kiln to temperatures between 1,200 and 1,400 \u00b0C (2,200 and 2,600 \u00b0F). The greater strength and translucence of porcelain, relative to other types of pottery, arise mainly from vitrification and the formation of the mineral mullite within the body at these high temperatures. End applications include tableware, decorative ware such as figurines, and products in technology and industry such as electrical insulators and laboratory ware. The manufacturing process used for porcelain is similar to that used for earthenware and stoneware, the two other main types of pottery, although it can be more challenging to produce. It has usually been regarded as the most prestigious type of pottery due to its delicacy, strength, and high degree of whiteness. It is frequently both glazed and decorated."}}, {"canonical_name": "t\u00e2maras", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "t\u00e2maras", "book_id": "coloquios_da_orta_1563", "name": "t\u00e2maras", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["t\u00e2maras", "T\u00e2mara", "t\u00e2mara"], "contexts": ["cultivated crop", "fruit traded from Arabia to India"]}, {"entity_id": "tamaras", "book_id": "polyanthea_medicinal", "name": "tamaras", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["tamaras"], "contexts": ["ingredient in a remedy", "dates"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "t\u00e2maras", "target_book": "polyanthea_medicinal", "target_name": "tamaras", "similarity": 0.754}], "id": 3126, "stable_key": "clu_b30470427d8290dd", "ground_truth": {"modern_name": "Dates", "confidence": "high", "type": "plant", "description": "Sweet fruit of the date palm, cultivated and traded.", "wikipedia_extract": "A stem is one of two main structural axes of a vascular plant, the other being the root. It supports leaves, flowers and fruits, transports water and dissolved substances between the roots and the shoots in the xylem and phloem, engages in photosynthesis, stores nutrients, and produces new living tissue. The stem can also be called the culm, halm, haulm, stalk, or thyrsus. The stem is normally divided into nodes and internodes: The nodes are the points of attachment for leaves and can hold one or more leaves. There are sometimes axillary buds between the stem and leaf which can grow into branches (with leaves, conifer cones, or flowers). Adventitious roots (e.g. brace roots) may also be produced from the nodes."}}, {"canonical_name": "secura", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "secura", "book_id": "coloquios_da_orta_1563", "name": "secura", "category": "CONCEPT", "subcategory": "QUALITY", "count": 3, "variants": ["secura"], "contexts": ["dryness", "quality of dryness"]}, {"entity_id": "secura", "book_id": "polyanthea_medicinal", "name": "secura", "category": "CONCEPT", "subcategory": "QUALITY", "count": 5, "variants": ["secura"], "contexts": ["dryness, a quality of substances", "Bodily quality of dryness"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "secura", "target_book": "polyanthea_medicinal", "target_name": "secura", "similarity": 1.0}], "id": 3127, "stable_key": "clu_393c78794e6a7ea5-3", "ground_truth": {"modern_name": "dryness", "confidence": "high", "type": "concept", "note": "In humoral theory, 'dryness' was considered a fundamental quality of the four elements and humors, impacting physiology and the environment.", "wikidata_id": "Q5309747", "wikidata_description": "medical condition in which there is a decrease in normal lubrication of the skin or mucous membranes", "wikipedia_url": "https://en.wikipedia.org/wiki/Dryness%20%28medical%29", "wikipedia_extract": "Dryness is a medical condition in which there is local or more generalized decrease in normal lubrication of the skin or mucous membranes. Examples of local dryness include dry mouth, dry eyes, dry skin (xeroderma), diabetic foot and vaginal dryness. These often have specific causes and treatments. It is possible to have dry eyes without any other signs or symptoms, but this usually causes a syndrome of eye symptoms called keratoconjunctivitis sicca. More generalized dryness can be caused by e.g. dehydration (that is, more general loss of body fluids), anticholinergic drugs and Sj\u00f6gren syndrome."}}, {"canonical_name": "carvalho", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "carvalhos", "book_id": "coloquios_da_orta_1563", "name": "carvalhos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["carvalhos", "carvalho"], "contexts": ["trees producing manna and galls", "material for alexandre manuscripts"]}, {"entity_id": "carvalho", "book_id": "polyanthea_medicinal", "name": "carvalho", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["carvalho", "Carvalhinha", "Carvalho"], "contexts": ["part of a plant name", "oak leaves for washing"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "carvalhos", "target_book": "polyanthea_medicinal", "target_name": "carvalho", "similarity": 0.942}], "id": 3128, "stable_key": "clu_363000d95e00cbb0-4", "ground_truth": {"modern_name": "Oak", "confidence": "high", "type": "plant", "family": "Fagaceae", "note": "'pedunculated oaks' refers to Quercus robur.", "wikidata_id": "Q12004", "wikidata_description": "genus of plants", "linnaean": "Quercus", "description": "A large tree known for its wood and acorns, with medicinal uses.", "wikipedia_extract": "An oak is a hardwood tree or shrub in the genus Quercus of the beech family. They have spirally arranged leaves, often with lobed edges, and a nut called an acorn, borne within a cup. The genus is widely distributed in the Northern Hemisphere, with some 500 species, both deciduous and evergreen. Fossil oaks date back to the Middle Eocene. Molecular phylogeny shows that the genus is divided into Old World and New World clades, but many oak species hybridise freely, making the genus's history difficult to resolve. Ecologically, oaks are keystone species in habitats from Mediterranean semi-desert to subtropical rainforest."}}, {"canonical_name": "narcoticos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "drogas", "book_id": "coloquios_da_orta_1563", "name": "drogas", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["drogas"], "contexts": ["medicinal substances", "items sent to the kingdom"]}, {"entity_id": "narcoticos", "book_id": "polyanthea_medicinal", "name": "narcoticos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 6, "variants": ["narcoticos", "narcotic"], "contexts": ["narcotic remedies", "substances causing torpor"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "drogas", "target_book": "polyanthea_medicinal", "target_name": "narcoticos", "similarity": 0.946}], "id": 3129, "stable_key": "clu_1a4d262d40fbe359", "ground_truth": {"modern_name": "Narcotics", "confidence": "high", "type": "concept", "note": "The term 'drogas' is a broader term for drugs or medicines, but in the context of 'narcoticos', it refers to substances with sedative or stupifying effects.", "wikidata_id": "Q10268802", "wikidata_description": "psychoactive drug whose possession, use or trade is outlawed"}}, {"canonical_name": "Mar\u00e7o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "marzo", "book_id": "ricettario_fiorentino_1597", "name": "Marzo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Marzo"], "contexts": ["month of March"]}, {"entity_id": "mar\u00e7o", "book_id": "polyanthea_medicinal", "name": "Mar\u00e7o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["Mar\u00e7o"], "contexts": ["month when the patient sought help", "month and day of a medical consultation"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Marzo", "target_book": "polyanthea_medicinal", "target_name": "Mar\u00e7o", "similarity": 0.883}], "id": 3130, "stable_key": "clu_54cb9c5c28114da0", "ground_truth": {"modern_name": "March", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "caparro\u017fa", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "caparosa", "book_id": "coloquios_da_orta_1563", "name": "caparosa", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["caparosa"], "contexts": ["substancia usada como caustico", "mineral substance mentioned with numbers"]}, {"entity_id": "caparro\u017fa", "book_id": "polyanthea_medicinal", "name": "caparro\u017fa", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["caparro\u017fa", "Caparro\u017fa"], "contexts": ["ingredient in unguent", "herb for bleeding"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "caparosa", "target_book": "polyanthea_medicinal", "target_name": "caparro\u017fa", "similarity": 0.887}], "id": 3131, "stable_key": "clu_82d4941c77a01b7e-2", "ground_truth": {"modern_name": "Vitriol", "confidence": "high", "type": "chemical", "note": "Vitriol was a general term for sulfates of metals, often used in alchemy and early chemistry/medicine.", "wikidata_id": "Q4118", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Sulfuric%20acid", "wikipedia_extract": "Sulfuric acid (American spelling and the preferred IUPAC name) or sulphuric acid (Commonwealth spelling), known in antiquity as oil of vitriol, is a mineral acid composed of the elements sulfur, oxygen, and hydrogen, with the molecular formula H2SO4. It is a colorless, odorless, and viscous liquid that is miscible with water. Pure sulfuric acid does not occur naturally due to its strong affinity to water vapor; it is hygroscopic and readily absorbs water vapor from the air. Concentrated sulfuric acid is a strong oxidant with powerful dehydrating properties, making it highly corrosive towards other materials, from rocks to metals. Phosphorus pentoxide is a notable exception in that it is not dehydrated by sulfuric acid but, to the contrary, dehydrates sulfuric acid to sulfur trioxide. Upon addition of sulfuric acid to water, a considerable amount of heat is released; thus, the reverse procedure of adding water to the acid is generally avoided since the heat released may boil the solution, spraying droplets of hot acid during the process.", "description": "A sulfate mineral, often used as a caustic or astringent."}}, {"canonical_name": "ameyxas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "amexas", "book_id": "coloquios_da_orta_1563", "name": "amexas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["amexas"], "contexts": ["fruit described as similar to plums"]}, {"entity_id": "ameyxas", "book_id": "polyanthea_medicinal", "name": "ameyxas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["ameyxas", "amcyxas"], "contexts": ["fruit used in remedies", "fresh plums, cooling"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "amexas", "target_book": "polyanthea_medicinal", "target_name": "ameyxas", "similarity": 0.882}], "id": 3132, "stable_key": "clu_fc76d82d08fc1b89", "ground_truth": {"modern_name": "plum", "confidence": "high", "type": "plant", "linnaean": "Prunus domestica", "family": "Rosaceae", "wikidata_id": "Q44120", "wikidata_description": "species of plant in the rose family (Rosaceae)", "description": "A common fruit tree bearing sweet, edible drupes.", "note": "The singular 'Plum' is more appropriate for the general fruit type.", "wikipedia_extract": "Prunus domestica is a species of flowering plant in the family Rosaceae. A deciduous tree, it includes many varieties of the fruit trees known as plums in English, though not all plums belong to this species. The greengages and damsons also belong to subspecies of P. domestica. It typically forms a large shrub or a small tree. It may be somewhat thorny, with white blossom, borne in early spring. The oval or spherical fruit varies in size, but can be up to 8 centimetres (3 inches) across."}}, {"canonical_name": "diureticos", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "diur\u00e9tico", "book_id": "coloquios_da_orta_1563", "name": "diur\u00e9tico", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["diur\u00e9tico"], "contexts": ["medicinal property of 'folio indo'"]}, {"entity_id": "diureticos", "book_id": "polyanthea_medicinal", "name": "diureticos", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 7, "variants": ["diureticos", "diureticas", "diureticis", "remedios diureticos"], "contexts": ["substances that promote urination", "medicines that promote urination"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "diur\u00e9tico", "target_book": "polyanthea_medicinal", "target_name": "diureticos", "similarity": 0.863}], "id": 3133, "stable_key": "clu_b90384668de4478c", "ground_truth": {"modern_name": "Diuretic", "confidence": "high", "type": "concept", "description": "A substance or property that promotes urination.", "wikipedia_extract": "A diuretic ( ) is any substance that promotes diuresis, the increased production of urine. This includes forced diuresis. A diuretic tablet is sometimes colloquially called a water tablet. There are several categories of diuretics. All diuretics increase the excretion of water from the body, through the kidneys. There exist several classes of diuretic, and each works in a distinct way."}}, {"canonical_name": "Alem-Tejo", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "alemtejo", "book_id": "coloquios_da_orta_1563", "name": "Alemtejo", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Alemtejo"], "contexts": ["region where expression is current"]}, {"entity_id": "alem-tejo", "book_id": "polyanthea_medicinal", "name": "Alem-Tejo", "category": "PLACE", "subcategory": "REGION", "count": 7, "variants": ["Alem-Tejo"], "contexts": ["Provincia do Alem-Tejo", "region with famous physicians"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Alemtejo", "target_book": "polyanthea_medicinal", "target_name": "Alem-Tejo", "similarity": 0.645}], "id": 3134, "stable_key": "clu_9fe8a6bc5b43cbbf", "ground_truth": {"modern_name": "Alentejo", "confidence": "high", "type": "place", "country": "Portugal", "wikidata_id": "Q20963720", "wikidata_description": "geographical, historical and cultural region of Portugal"}}, {"canonical_name": "raba\u00e7as", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "raba\u00e7a", "book_id": "coloquios_da_orta_1563", "name": "raba\u00e7a", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["raba\u00e7a"], "contexts": ["plant, possibly a synonym for napelo"]}, {"entity_id": "raba\u00e7as", "book_id": "polyanthea_medicinal", "name": "raba\u00e7as", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["raba\u00e7as", "rabao", "rabaos", "raba\u014d"], "contexts": ["radish leaves used in conserve", "leaves used in conserve"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "raba\u00e7a", "target_book": "polyanthea_medicinal", "target_name": "raba\u00e7as", "similarity": 0.905}], "id": 3135, "stable_key": "clu_186e2814b40188fe-2", "ground_truth": {"modern_name": "Radish", "confidence": "high", "type": "plant", "linnaean": "Raphanus sativus", "family": "Brassicaceae", "description": "Edible root vegetable with a peppery flavor, commonly consumed raw.", "note": "The term 'rab\u00f4' in one context appears to refer to a specific type of pepper, but the overwhelming evidence points to 'radish' for the other instances.", "wikipedia_extract": "The radish (Raphanus sativus or Raphanus raphanistrum subsp. sativus) is a flowering plant in the mustard family, Brassicaceae. Its large taproot is commonly used as a root vegetable, although the entire plant is edible and its leaves are sometimes used as a leaf vegetable. Originally domesticated in Asia, radishes are now grown and consumed globally. The radish is sometimes considered to form a species complex with the wild radish and instead treated as the subspecies Raphanus raphanistrum subsp. sativus. Radishes are often used raw as a crunchy salad vegetable with a pungent, slightly spicy flavor, varying in intensity depending on its growing environment. There are numerous varieties varying in size, flavor, color, and length of time they take to mature.", "wikidata_id": "Q7224565", "wikidata_description": "species of plant"}}, {"canonical_name": "Petrofellino", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "petrofellino", "book_id": "ricettario_fiorentino_1597", "name": "Petrofellino", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["Petrofellino", "Petrofelino Macedonico", "Petrofilio"], "contexts": ["Parsley, ingredient in syrup", "parsley herb"]}, {"entity_id": "petrofelino", "book_id": "polyanthea_medicinal", "name": "petrofelino", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["petrofelino"], "contexts": ["herb"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Petrofellino", "target_book": "polyanthea_medicinal", "target_name": "petrofelino", "similarity": 0.907}], "id": 3136, "stable_key": "clu_fcb08df250329926", "ground_truth": {"modern_name": "Parsley", "confidence": "high", "type": "plant", "linnaean": "Petroselinum crispum", "family": "Apiaceae", "description": "An aromatic herb used in cooking and traditional medicine.", "wikipedia_extract": "Parsley, or garden parsley (Petroselinum crispum), is a species of flowering plant in the family Apiaceae that is native to the Balkans. It has been introduced and naturalized in Europe and elsewhere in the world with suitable climates, and is widely cultivated as a herb and a vegetable. It is believed to have been originally grown in Sardinia, and was cultivated in around the 3rd century BC. Linnaeus stated its wild habitat to be Sardinia, whence it was brought to England and apparently first cultivated in Britain in 1548, though literary evidence suggests parsley was used in England in the Middle Ages as early as the Anglo-Saxon period. Parsley is widely used in European, Middle Eastern, and American cuisine. Curly-leaf parsley is often used as a garnish."}}, {"canonical_name": "olio di", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "olio_di", "book_id": "ricettario_fiorentino_1597", "name": "olio di", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["olio di", "Olio dt Kolfo", "olio di camp", "olio di coto"], "contexts": ["oil preparation", "oil made from quince"]}, {"entity_id": "oleum", "book_id": "polyanthea_medicinal", "name": "oleum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["oleum"], "contexts": ["oil used in wound treatment", "oily substance in medicine"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "olio di", "target_book": "polyanthea_medicinal", "target_name": "oleum", "similarity": 0.903}], "id": 3137, "stable_key": "clu_3e12dbd72846a700-2", "ground_truth": {"modern_name": "Oil", "confidence": "high", "type": "chemical", "note": "The contexts 'oil' and 'emetic ingredient' strongly suggest a general term for oil, which could be vegetable or animal.", "wikidata_id": "Q170885", "wikidata_description": "hydrophobic liquid containing volatile aroma compounds from plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Essential%20oil", "wikipedia_extract": "Essential oils are compodes of hydrophobic volatile organic compounds, usually in liquid form, obtained from plant material. Essential oils are also known as volatile oils, ethereal oils, aetheroleum, or simply as the oil of the plant from which they were extracted, such as oil of clove. An essential oil is essential in the sense that the oil contains the fragrance or essence of the plant. The term \"essential\" used here does not indicate that it is nutritionally required in the diet, as with essential amino acid or essential fatty acid. Essential oils, according to ISO, are produced either by steam distillation, by mechanical manipulation of the rind of the fruits of the genus Citrus (also called cold pressing), or by dry distillation. Other methods, such as solvent extraction, are not accepted and, in fact, result in different perfumed products (pommades, concretes, and absolutes)."}}, {"canonical_name": "elliptical orbit", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "elliptical_orbit", "book_id": "connexion_physical_sciences_somerville_1858", "name": "elliptical orbit", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["elliptical orbit"], "contexts": ["oval path of a planet", "planetary path in an ellipse"]}, {"entity_id": "ellipticity_of_the_orbit", "book_id": "first_principles_spencer_1862", "name": "ellipticity of the orbit", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ellipticity of the orbit"], "contexts": ["shape of celestial body's path"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "elliptical orbit", "target_book": "first_principles_spencer_1862", "target_name": "ellipticity of the orbit", "similarity": 0.88}], "id": 3138, "stable_key": "clu_5a4bf2ebeca43e12", "ground_truth": {"modern_name": "Elliptical orbit", "confidence": "high", "type": "concept"}}, {"canonical_name": "galvanic electricity", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "galvanic_electricity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "galvanic electricity", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Galvanic electricity", "galvanic electricity"], "contexts": ["electricity from chemical action", "deposits metal from metallic solution"]}, {"entity_id": "galvanic_current", "book_id": "connexion_physical_sciences_somerville_1858", "name": "galvanic current", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["galvanic current"], "contexts": ["current used in chemical analysis", "electrical current from chemical reaction"]}, {"entity_id": "galvanic_currents", "book_id":