, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "fluides", "target_book": "first_principles_spencer_1862", "target_name": "fluids", "similarity": 0.998}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fluids", "target_book": "kosmos_humboldt_1845", "target_name": "fluids", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fluids", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fluids", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fluids", "target_book": "first_principles_spencer_1862", "target_name": "fluids", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "fluids", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fluids", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "fluids", "target_book": "first_principles_spencer_1862", "target_name": "fluids", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "fluids", "target_book": "first_principles_spencer_1862", "target_name": "fluids", "similarity": 1.0}], "id": 248, "stable_key": "clu_4a284a954056e201", "ground_truth": {"modern_name": "Fluids", "confidence": "high", "type": "concept", "note": "In early modern texts, 'fluids' often referred to the four humors of the body, but also more generally to any liquid substance or state of matter.", "wikidata_id": "Q20127660", "wikidata_description": "converting wastewater into an effluent for return to the water cycle", "wikipedia_url": "https://en.wikipedia.org/wiki/Wastewater%20treatment", "wikipedia_extract": "Wastewater treatment is a process which removes contaminants from wastewater. The resulting effluent, discharged to a water body, has an acceptable impact on the environment. Domestic wastewater, also called municipal wastewater or sewage, is processed at a sewage treatment plant. Industrial wastewater is often processed at a specially-designed industrial wastewater treatment facility, or at a sewage treatment plant. In the latter case the industry typically performs on-site pretreatment of the waste, before it is sent to the municipal plant. Other types of wastewater treatment plants include agricultural wastewater treatment and leachate treatment plants."}}, {"canonical_name": "Solomon", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 5, "total_mentions": 12, "members": [{"entity_id": "solomon", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Solomon", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["Solomon"], "contexts": ["biblical king, builder of the Temple", "biblical king and wise man"]}, {"entity_id": "solomon", "book_id": "english_physician_1652", "name": "Solomon", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Solomon"], "contexts": ["searched after herbs, plants, and trees", "mentioned as an exception"]}, {"entity_id": "salom\u00e3o", "book_id": "coloquios_da_orta_1563", "name": "Salom\u00e3o", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Salom\u00e3o"], "contexts": ["praised fragrant things", "biblical king"]}, {"entity_id": "salomone", "book_id": "ricettario_fiorentino_1597", "name": "Salomone", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Salomone"], "contexts": ["wise king, author of proverbs"]}, {"entity_id": "solomon", "book_id": "polyanthea_medicinal", "name": "Solomon", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Solomon", "Salomon"], "contexts": ["King mentioned in relation to a case", "Latin name for Salama\u014d"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Solomon", "target_book": "english_physician_1652", "target_name": "Solomon", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Solomon", "target_book": "coloquios_da_orta_1563", "target_name": "Salom\u00e3o", "similarity": 0.917}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Solomon", "target_book": "ricettario_fiorentino_1597", "target_name": "Salomone", "similarity": 0.931}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Solomon", "target_book": "polyanthea_medicinal", "target_name": "Solomon", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Solomon", "target_book": "coloquios_da_orta_1563", "target_name": "Salom\u00e3o", "similarity": 0.917}, {"source_book": "english_physician_1652", "source_name": "Solomon", "target_book": "ricettario_fiorentino_1597", "target_name": "Salomone", "similarity": 0.931}, {"source_book": "english_physician_1652", "source_name": "Solomon", "target_book": "polyanthea_medicinal", "target_name": "Solomon", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Salom\u00e3o", "target_book": "ricettario_fiorentino_1597", "target_name": "Salomone", "similarity": 0.899}, {"source_book": "coloquios_da_orta_1563", "source_name": "Salom\u00e3o", "target_book": "polyanthea_medicinal", "target_name": "Solomon", "similarity": 0.917}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Salomone", "target_book": "polyanthea_medicinal", "target_name": "Solomon", "similarity": 0.931}], "id": 249, "stable_key": "clu_f13114753c23add2", "ground_truth": {"modern_name": "Solomon", "confidence": "high", "type": "person", "description": "Biblical king associated with wisdom and knowledge.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Solomon", "wikipedia_extract": "Solomon (), also called Jedidiah, was a king of the Kingdom of Israel and Judah, according to the Hebrew Bible. The successor of his father David, he is described as the penultimate ruler of all Twelve Tribes of Israel under a united Israel and Judah. His reign is hypothesized to have lasted from c. 970\u2013931 BCE. According to the biblical narrative, his reign brought commercial prosperity through alliances and trade, but his accumulation of wealth, horses, and foreign wives, many of whom introduced idolatry, led to divine punishment. After Solomon's death, his son Rehoboam\u2019s harsh policies led the northern Israelites to reject the Davidic line and follow Jeroboam, splitting the kingdom into Israel in the north and Judah in the south, according to the Hebrew Bible."}}, {"canonical_name": "fusion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 12, "members": [{"entity_id": "fusion", "book_id": "epoques_nature_buffon_1778", "name": "fusion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["fusion"], "contexts": ["melting, fusion", "process of melting and forming"]}, {"entity_id": "fusion", "book_id": "principles_of_psychology_james_1890", "name": "fusion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["fusion"], "contexts": ["concept of merging into one", "process of combining elements"]}, {"entity_id": "fusion", "book_id": "kosmos_humboldt_1845", "name": "fusion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fusion"], "contexts": ["process of melting"]}, {"entity_id": "fusion", "book_id": "connexion_physical_sciences_somerville_1858", "name": "fusion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["fusion"], "contexts": ["transition from solid to liquid", "process of melting"]}, {"entity_id": "fusion", "book_id": "first_principles_spencer_1862", "name": "fusion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fusion"], "contexts": ["transition from solid to liquid state"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "fusion", "target_book": "principles_of_psychology_james_1890", "target_name": "fusion", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "fusion", "target_book": "kosmos_humboldt_1845", "target_name": "fusion", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "fusion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fusion", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "fusion", "target_book": "first_principles_spencer_1862", "target_name": "fusion", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fusion", "target_book": "kosmos_humboldt_1845", "target_name": "fusion", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fusion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fusion", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fusion", "target_book": "first_principles_spencer_1862", "target_name": "fusion", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "fusion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fusion", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "fusion", "target_book": "first_principles_spencer_1862", "target_name": "fusion", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "fusion", "target_book": "first_principles_spencer_1862", "target_name": "fusion", "similarity": 1.0}], "id": 250, "stable_key": "clu_c3f2d177f01dabf4", "ground_truth": {"modern_name": "Melting point", "confidence": "high", "type": "concept", "note": "The contexts 'fusion point' and 'process of melting' clearly point to the physical phenomenon of phase transition.", "wikidata_id": "Q465149", "wikidata_description": "process in which adding a solute to a solvent decreases the freezing point of the solvent", "wikipedia_url": "https://en.wikipedia.org/wiki/Freezing-point%20depression", "wikipedia_extract": "The melting point (or, rarely, liquefaction point) of a substance is the temperature at which it changes state from solid to liquid. At the melting point the solid and liquid phase exist in equilibrium. The melting point of a substance depends on pressure and is usually specified at a standard pressure such as 1 atmosphere or 100 kPa. When considered as the temperature of the reverse change from liquid to solid, it is referred to as the freezing point or crystallization point. Because of the ability of substances to supercool, the freezing point can easily appear to be below its actual value. When the \"characteristic freezing point\" of a substance is determined, in fact, the actual methodology is almost always \"the principle of observing the disappearance rather than the formation of ice, that is, the melting point.\" For most substances, melting and freezing points are approximately equal."}}, {"canonical_name": "agriculture", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 12, "members": [{"entity_id": "agriculture", "book_id": "epoques_nature_buffon_1778", "name": "agriculture", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["agriculture"], "contexts": ["art founded on science and observation"]}, {"entity_id": "agricultural", "book_id": "origin_of_species_darwin_1859", "name": "agricultural", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["agricultural"], "contexts": ["related to farming"]}, {"entity_id": "agriculture", "book_id": "relation_historique_humboldt_vol3_1825", "name": "agriculture", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["agriculture", "agricole"], "contexts": ["farming", "foundation of Venezuela's territorial wealth"]}, {"entity_id": "agriculture", "book_id": "kosmos_humboldt_1845", "name": "agriculture", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["agriculture"], "contexts": ["cultivation of land and raising livestock", "practice of farming"]}, {"entity_id": "agricultura", "book_id": "polyanthea_medicinal", "name": "agricultura", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["agricultura"], "contexts": ["practice of farming"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "agriculture", "target_book": "origin_of_species_darwin_1859", "target_name": "agricultural", "similarity": 0.92}, {"source_book": "epoques_nature_buffon_1778", "source_name": "agriculture", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "agriculture", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "agriculture", "target_book": "kosmos_humboldt_1845", "target_name": "agriculture", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "agriculture", "target_book": "polyanthea_medicinal", "target_name": "agricultura", "similarity": 0.955}, {"source_book": "origin_of_species_darwin_1859", "source_name": "agricultural", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "agriculture", "similarity": 0.92}, {"source_book": "origin_of_species_darwin_1859", "source_name": "agricultural", "target_book": "kosmos_humboldt_1845", "target_name": "agriculture", "similarity": 0.92}, {"source_book": "origin_of_species_darwin_1859", "source_name": "agricultural", "target_book": "polyanthea_medicinal", "target_name": "agricultura", "similarity": 0.917}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "agriculture", "target_book": "kosmos_humboldt_1845", "target_name": "agriculture", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "agriculture", "target_book": "polyanthea_medicinal", "target_name": "agricultura", "similarity": 0.955}, {"source_book": "kosmos_humboldt_1845", "source_name": "agriculture", "target_book": "polyanthea_medicinal", "target_name": "agricultura", "similarity": 0.955}], "id": 251, "stable_key": "clu_9020ae8e0a2bd355", "ground_truth": {"modern_name": "Agriculture", "confidence": "high", "type": "concept", "wikidata_id": "Q11451", "wikidata_description": "cultivation of plants and animals to provide useful products", "wikipedia_url": "https://en.wikipedia.org/wiki/Agriculture", "wikipedia_extract": "Agriculture is the practice of cultivating the soil, planting, raising, and harvesting both food and non-food crops, as well as livestock production. Broader definitions also include forestry and aquaculture. Agriculture was a key factor in the rise of sedentary human civilization, whereby farming of domesticated plants and animals created food surpluses that enabled people to live in the cities. While humans started gathering grains at least 105,000 years ago, nascent farmers only began planting them around 11,500 years ago. Sheep, goats, pigs, and cattle were domesticated around 10,000 years ago. Plants were independently cultivated in at least 11 regions of the world."}}, {"canonical_name": "family", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 12, "members": [{"entity_id": "family", "book_id": "origin_of_species_darwin_1859", "name": "family", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["family"], "contexts": ["taxonomic rank above genus", "biological classification unit"]}, {"entity_id": "famille", "book_id": "relation_historique_humboldt_vol3_1825", "name": "famille", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["famille"], "contexts": ["group of related people"]}, {"entity_id": "family", "book_id": "principles_of_psychology_james_1890", "name": "family", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["family"], "contexts": ["group of related individuals"]}, {"entity_id": "familia", "book_id": "coloquios_da_orta_1563", "name": "familia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["familia"], "contexts": ["plant belongs to this family"]}, {"entity_id": "family", "book_id": "first_principles_spencer_1862", "name": "family", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["family"], "contexts": ["basic social unit", "taxonomic rank in classification"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "family", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "famille", "similarity": 0.982}, {"source_book": "origin_of_species_darwin_1859", "source_name": "family", "target_book": "principles_of_psychology_james_1890", "target_name": "family", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "family", "target_book": "coloquios_da_orta_1563", "target_name": "familia", "similarity": 0.975}, {"source_book": "origin_of_species_darwin_1859", "source_name": "family", "target_book": "first_principles_spencer_1862", "target_name": "family", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "famille", "target_book": "principles_of_psychology_james_1890", "target_name": "family", "similarity": 0.982}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "famille", "target_book": "coloquios_da_orta_1563", "target_name": "familia", "similarity": 0.985}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "famille", "target_book": "first_principles_spencer_1862", "target_name": "family", "similarity": 0.982}, {"source_book": "principles_of_psychology_james_1890", "source_name": "family", "target_book": "coloquios_da_orta_1563", "target_name": "familia", "similarity": 0.975}, {"source_book": "principles_of_psychology_james_1890", "source_name": "family", "target_book": "first_principles_spencer_1862", "target_name": "family", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "familia", "target_book": "first_principles_spencer_1862", "target_name": "family", "similarity": 0.975}], "id": 252, "stable_key": "clu_3c034de00d307ed3", "ground_truth": {"modern_name": "Taxonomic rank (biology)", "confidence": "high", "type": "concept", "note": "The cluster includes usage in both taxonomy (above genus) and for groups of related people, but the primary scientific context in early modern texts often points to the taxonomic rank."}}, {"canonical_name": "laurel", "category": "PLANT", "subcategory": "HERB", "book_count": 5, "total_mentions": 12, "members": [{"entity_id": "laurel", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "laurel", "category": "PLANT", "subcategory": "HERB", "count": 5, "variants": ["laurel", "Laurel"], "contexts": ["a tree, similar to clove tree", "tree whose berries are similar to the fruit"]}, {"entity_id": "laurel", "book_id": "historia_medicinal_monardes_1574", "name": "Laurel", "category": "PLANT", "subcategory": "TREE", "count": 3, "variants": ["Laurel"], "contexts": ["leaf shape of the Cinnamon tree", "tree whose leaves are similar to Canela"]}, {"entity_id": "laurel", "book_id": "connexion_physical_sciences_somerville_1858", "name": "laurel", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["laurel"], "contexts": ["essential oil with circular polarization"]}, {"entity_id": "laurel", "book_id": "origin_of_species_darwin_1859", "name": "laurel", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["laurel"], "contexts": ["plant with juice excreted at leaf back"]}, {"entity_id": "laurel", "book_id": "kosmos_humboldt_1845", "name": "laurel", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["laurel"], "contexts": ["plant impression, debated interpretation"]}, {"entity_id": "laurels", "book_id": "connexion_physical_sciences_somerville_1858", "name": "laurels", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["laurels"], "contexts": ["second vegetation zone on volcano"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "laurel", "target_book": "historia_medicinal_monardes_1574", "target_name": "Laurel", "similarity": 0.581}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "laurel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "laurel", "similarity": 0.837}, {"source_book": "origin_of_species_darwin_1859", "source_name": "laurel", "target_book": "kosmos_humboldt_1845", "target_name": "laurel", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "laurel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "laurels", "similarity": 0.929}, {"source_book": "kosmos_humboldt_1845", "source_name": "laurel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "laurels", "similarity": 0.929}], "id": 253, "stable_key": "clu_f885710f727800bc", "ground_truth": {"modern_name": "Bay Laurel", "confidence": "high", "type": "plant", "linnaean": "Laurus nobilis Linnaeus", "family": "Lauraceae", "wikidata_id": "Q26006", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Laurus_nobilis", "wikipedia_extract": "Laurus nobilis  is an aromatic evergreen tree or large shrub with green, glabrous (smooth) leaves. It is in the flowering plant family Lauraceae. According to  Muer, Jahn, & Sauerbier, the stem can be 1 metre in diameter and the tree can be as high as 20 metres. It is native to the Mediterranean region and is used as bay leaf for seasoning in cooking. Its common names include bay tree (esp. United Kingdom), bay laurel, sweet bay, true laurel, Grecian laurel, or simply laurel.", "note": "The reference to 'Laurel' in Monardes' medicinal history, and its general use in natural philosophy, points strongly to the common laurel (Laurus nobilis). The mention of 'cinnamon tree' leaf shape suggests a comparison or confusion, but the primary referent for 'laurel' remains."}}, {"canonical_name": "method", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 5, "total_mentions": 12, "members": [{"entity_id": "m\u00e9thode", "book_id": "medecine_experimentale_bernard_1865", "name": "m\u00e9thode", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["m\u00e9thode"], "contexts": ["scientific method", "systematic way of doing things"]}, {"entity_id": "methodo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Methodo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Methodo"], "contexts": ["systematic approach to understanding virtues"]}, {"entity_id": "method", "book_id": "polyanthea_medicinal", "name": "method", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 4, "variants": ["method", "Method", "Methodica"], "contexts": ["medical treatise", "a medical treatise by Galen"]}, {"entity_id": "methods", "book_id": "principles_of_psychology_james_1890", "name": "methods", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["methods"], "contexts": ["systematic ways of inquiry"]}, {"entity_id": "methods", "book_id": "kosmos_humboldt_1845", "name": "methods", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["methods"], "contexts": ["procedures for scientific investigation"]}, {"entity_id": "method_", "book_id": "polyanthea_medicinal", "name": "Method.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Method.", "Method. Cur. morb."], "contexts": ["medical method", "part of book title"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "m\u00e9thode", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "Methodo", "similarity": 0.938}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "m\u00e9thode", "target_book": "polyanthea_medicinal", "target_name": "method", "similarity": 0.949}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Methodo", "target_book": "polyanthea_medicinal", "target_name": "method", "similarity": 0.941}, {"source_book": "principles_of_psychology_james_1890", "source_name": "methods", "target_book": "kosmos_humboldt_1845", "target_name": "methods", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "methods", "target_book": "polyanthea_medicinal", "target_name": "Method.", "similarity": 0.836}, {"source_book": "kosmos_humboldt_1845", "source_name": "methods", "target_book": "polyanthea_medicinal", "target_name": "Method.", "similarity": 0.836}], "id": 254, "stable_key": "clu_3ba9cf5255915081", "ground_truth": {"modern_name": "Method", "confidence": "high", "type": "concept", "description": "Systematic approach or procedure for inquiry or practice.", "wikipedia_extract": "A proof of concept (POC or PoC), also known as proof of principle, is an inchoate realization of a certain idea or method in order to demonstrate its feasibility or viability. A proof of concept is usually small and may or may not be complete, but aims to demonstrate in principle that the concept has practical potential without needing to fully develop it. A proof of value (PoV) is sometimes used along proof of concept, and differs by focusing more on demonstrating the potential customer use case and value, and is usually less in-depth than a proof of concept. The term has been in use since 1967. In a 1969 hearing of the Committee on Science and Astronautics, Subcommittee on Advanced Research and Technology, proof of concept was defined as following: The Board defined proof of concept as a phase in development in which experimental hardware is constructed and tested to explore and demonstrate the feasibility of a new concept. One definition of the term \"proof of concept\" was by Bruce Carsten in the context of a \"proof-of-concept prototype\" in his magazine column \"Carsten's Corner\" (1989): Proof-of-Concept Prototype is a term that (I believe) I coined in 1984."}}, {"canonical_name": "art", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 11, "members": [{"entity_id": "art", "book_id": "medecine_experimentale_bernard_1865", "name": "art", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["art"], "contexts": ["expression of human creative skill"]}, {"entity_id": "art", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Art", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Art"], "contexts": ["body of knowledge or skill"]}, {"entity_id": "art", "book_id": "origin_of_species_darwin_1859", "name": "Art", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Art"], "contexts": ["human creation and skill"]}, {"entity_id": "art", "book_id": "kosmos_humboldt_1845", "name": "art", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["art"], "contexts": ["manifestation of intellectual power"]}, {"entity_id": "art", "book_id": "first_principles_spencer_1862", "name": "art", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["Art", "art"], "contexts": ["expression of human creativity", "development from simple to complex"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "art", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Art", "similarity": 0.983}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "art", "target_book": "origin_of_species_darwin_1859", "target_name": "Art", "similarity": 0.983}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "art", "target_book": "kosmos_humboldt_1845", "target_name": "art", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "art", "target_book": "first_principles_spencer_1862", "target_name": "art", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Art", "target_book": "origin_of_species_darwin_1859", "target_name": "Art", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Art", "target_book": "kosmos_humboldt_1845", "target_name": "art", "similarity": 0.983}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Art", "target_book": "first_principles_spencer_1862", "target_name": "art", "similarity": 0.983}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Art", "target_book": "kosmos_humboldt_1845", "target_name": "art", "similarity": 0.983}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Art", "target_book": "first_principles_spencer_1862", "target_name": "art", "similarity": 0.983}, {"source_book": "kosmos_humboldt_1845", "source_name": "art", "target_book": "first_principles_spencer_1862", "target_name": "art", "similarity": 1.0}], "id": 255, "stable_key": "clu_2b19f5061b820f6f", "ground_truth": {"modern_name": "Art", "confidence": "high", "type": "concept", "note": "Context suggests 'Art' refers to the skillful practice or discipline of medicine, rather than fine art.", "wikidata_id": "Q96704320", "wikidata_description": ""}}, {"canonical_name": "humanity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 11, "members": [{"entity_id": "humanit\u00e9", "book_id": "medecine_experimentale_bernard_1865", "name": "humanit\u00e9", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["humanit\u00e9"], "contexts": ["human race and its well-being"]}, {"entity_id": "humanit\u00e9", "book_id": "relation_historique_humboldt_vol3_1825", "name": "humanit\u00e9", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["humanit\u00e9"], "contexts": ["interest for friends of humanity", "principle for slave treatment"]}, {"entity_id": "humanity", "book_id": "principles_of_psychology_james_1890", "name": "humanity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["humanity"], "contexts": ["the human race collectively", "abstract idea of man"]}, {"entity_id": "humanity", "book_id": "kosmos_humboldt_1845", "name": "humanity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["humanity"], "contexts": ["state of being human"]}, {"entity_id": "humanity", "book_id": "first_principles_spencer_1862", "name": "humanity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["humanity", "Humanity"], "contexts": ["human race and its debt to religion", "collective human race"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "humanit\u00e9", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "humanit\u00e9", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "humanit\u00e9", "target_book": "principles_of_psychology_james_1890", "target_name": "humanity", "similarity": 0.982}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "humanit\u00e9", "target_book": "kosmos_humboldt_1845", "target_name": "humanity", "similarity": 0.982}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "humanit\u00e9", "target_book": "first_principles_spencer_1862", "target_name": "humanity", "similarity": 0.982}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "humanit\u00e9", "target_book": "principles_of_psychology_james_1890", "target_name": "humanity", "similarity": 0.982}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "humanit\u00e9", "target_book": "kosmos_humboldt_1845", "target_name": "humanity", "similarity": 0.982}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "humanit\u00e9", "target_book": "first_principles_spencer_1862", "target_name": "humanity", "similarity": 0.982}, {"source_book": "principles_of_psychology_james_1890", "source_name": "humanity", "target_book": "kosmos_humboldt_1845", "target_name": "humanity", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "humanity", "target_book": "first_principles_spencer_1862", "target_name": "humanity", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "humanity", "target_book": "first_principles_spencer_1862", "target_name": "humanity", "similarity": 1.0}], "id": 256, "stable_key": "clu_d0ad0d299c171cfc", "ground_truth": {"modern_name": "humanity", "confidence": "high", "type": "concept", "note": "The term 'manking' and 'manhans' likely refer to humanity, with 'manhans' also potentially referring to a specific period for medication.", "wikidata_id": "Q1575029", "wikidata_description": "International aid organization with headquarter in France", "wikipedia_url": "https://en.wikipedia.org/wiki/Human", "wikipedia_extract": "Humans (Homo sapiens, meaning \"thinking man\" or \"wise man\") are the most common and widespread species of primate, and the only extant species of the genus Homo. They are great apes characterized by hairlessness, obligate bipedality, manual dexterity with opposable thumbs, precision grip, and high intelligence. Humans have large brains compared to body size (a high encephalization quotient), enabling more advanced cognitive skills that facilitate successful adaptation to varied environments, development of sophisticated tools, and formation of complex social structures and civilizations. Humans possess a disproportionately larger volume of both cerebral white matter and gray matter present in the prefrontal cortex (PFC) than any other primate species, which facilitated the expansion of higher-order executive functions. Humans are highly social, with individual humans tending to belong to a multi-layered network of distinct social groups \u2013 from families and peer groups to corporations and political states. As such, social interactions between humans have established a wide variety of values, social norms, languages, and traditions (collectively termed institutions), each of which bolsters human society.", "linnaean": "Trichechus manatus", "family": "Trichechidae", "description": "Large, aquatic marine mammal with paddle-like flippers."}}, {"canonical_name": "Persia", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 5, "total_mentions": 11, "members": [{"entity_id": "persia", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Persia", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Persia"], "contexts": ["country in ancient times"]}, {"entity_id": "persia", "book_id": "origin_of_species_darwin_1859", "name": "Persia", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Persia"], "contexts": ["source of pigeon skins", "location of existing pigeon breeds"]}, {"entity_id": "persia", "book_id": "kosmos_humboldt_1845", "name": "Persia", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Persia"], "contexts": ["location of observation", "location where a famous comet was seen"]}, {"entity_id": "persia", "book_id": "historia_medicinal_monardes_1574", "name": "Persia", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Persia"], "contexts": ["mountains where goats are found", "country where peach was poisonous"]}, {"entity_id": "persia", "book_id": "coloquios_da_orta_1563", "name": "Persia", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Persia"], "contexts": ["country where chess was adopted"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Persia", "target_book": "origin_of_species_darwin_1859", "target_name": "Persia", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Persia", "target_book": "kosmos_humboldt_1845", "target_name": "Persia", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Persia", "target_book": "historia_medicinal_monardes_1574", "target_name": "Persia", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Persia", "target_book": "coloquios_da_orta_1563", "target_name": "Persia", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Persia", "target_book": "kosmos_humboldt_1845", "target_name": "Persia", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Persia", "target_book": "historia_medicinal_monardes_1574", "target_name": "Persia", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Persia", "target_book": "coloquios_da_orta_1563", "target_name": "Persia", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Persia", "target_book": "historia_medicinal_monardes_1574", "target_name": "Persia", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Persia", "target_book": "coloquios_da_orta_1563", "target_name": "Persia", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Persia", "target_book": "coloquios_da_orta_1563", "target_name": "Persia", "similarity": 1.0}], "id": 257, "stable_key": "clu_1a1db9c754f4454c", "ground_truth": {"modern_name": "Persia", "confidence": "high", "type": "place", "description": "Historical and modern name for the country now known as Iran.", "wikipedia_extract": "Iran, officially the Islamic Republic of Iran, and also known as Persia, is a country in West Asia. It borders Iraq to the west, Turkey, Azerbaijan, and Armenia to the northwest, the Caspian Sea to the north, Turkmenistan to the northeast, Afghanistan to the east, Pakistan to the southeast, and the Gulf of Oman and the Persian Gulf to the south. With a population of over 90 million, Iran ranks 17th globally in both geographic size and population and is the sixth-largest country in Asia. It is divided into five regions with 31 provinces. Tehran is the nation's capital, largest city, and financial center. Home to one of the world's oldest continuous major civilizations, most of Iran was first united as a nation by the Medes under Cyaxares in the 7th century BC and reached its territorial height in the 6th century BC, when Cyrus the Great founded the Achaemenid Empire."}}, {"canonical_name": "Creator", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 5, "total_mentions": 11, "members": [{"entity_id": "creator", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Creator", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Creator"], "contexts": ["divine being"]}, {"entity_id": "creator", "book_id": "origin_of_species_darwin_1859", "name": "Creator", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["Creator"], "contexts": ["divine being responsible for creation", "divine being, source of natural wonders"]}, {"entity_id": "creator", "book_id": "principles_of_psychology_james_1890", "name": "Creator", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Creator"], "contexts": ["divine being who made the world"]}, {"entity_id": "creator", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Creator", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Creator"], "contexts": ["ordained matter should act upon matter", "ultimate source of existence"]}, {"entity_id": "creator", "book_id": "first_principles_spencer_1862", "name": "creator", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["creator"], "contexts": ["entity responsible for creation", "entity that creates the universe"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Creator", "target_book": "origin_of_species_darwin_1859", "target_name": "Creator", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Creator", "target_book": "principles_of_psychology_james_1890", "target_name": "Creator", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Creator", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Creator", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Creator", "target_book": "first_principles_spencer_1862", "target_name": "creator", "similarity": 0.983}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Creator", "target_book": "principles_of_psychology_james_1890", "target_name": "Creator", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Creator", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Creator", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Creator", "target_book": "first_principles_spencer_1862", "target_name": "creator", "similarity": 0.983}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Creator", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Creator", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Creator", "target_book": "first_principles_spencer_1862", "target_name": "creator", "similarity": 0.983}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Creator", "target_book": "first_principles_spencer_1862", "target_name": "creator", "similarity": 0.983}], "id": 258, "stable_key": "clu_33949e8ae0dd49b0-2", "ground_truth": {"modern_name": "God", "confidence": "high", "type": "person", "description": "The supreme being, creator, and ultimate cause in theological and philosophical discourse.", "wikidata_id": "", "wikidata_description": "family name", "note": "The term 'Deos' (Portuguese/Spanish) and 'deities' (English) all refer to God or divine beings within the religious and philosophical context of early modern texts."}}, {"canonical_name": "Arabia", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 5, "total_mentions": 11, "members": [{"entity_id": "arabia", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Arabia", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Arabia"], "contexts": ["in Arabia"]}, {"entity_id": "arabia", "book_id": "english_physician_1652", "name": "Arabia", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Arabia"], "contexts": ["King of Arabia", "origin of Juleps"]}, {"entity_id": "arabia", "book_id": "kosmos_humboldt_1845", "name": "Arabia", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Arabia"], "contexts": ["peninsula mentioned in passage"]}, {"entity_id": "arab\u00eda", "book_id": "historia_medicinal_monardes_1574", "name": "Arab\u00eda", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Arab\u00eda"], "contexts": ["region mentioned for medicines"]}, {"entity_id": "arabia", "book_id": "ricettario_fiorentino_1597", "name": "Arabia", "category": "PLACE", "subcategory": "COUNTRY", "count": 6, "variants": ["Arabia"], "contexts": ["country where Cardamomo grows", "region of origin for a substance"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Arabia", "target_book": "english_physician_1652", "target_name": "Arabia", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Arabia", "target_book": "kosmos_humboldt_1845", "target_name": "Arabia", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Arabia", "target_book": "historia_medicinal_monardes_1574", "target_name": "Arab\u00eda", "similarity": 0.969}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Arabia", "target_book": "ricettario_fiorentino_1597", "target_name": "Arabia", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Arabia", "target_book": "kosmos_humboldt_1845", "target_name": "Arabia", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Arabia", "target_book": "historia_medicinal_monardes_1574", "target_name": "Arab\u00eda", "similarity": 0.969}, {"source_book": "english_physician_1652", "source_name": "Arabia", "target_book": "ricettario_fiorentino_1597", "target_name": "Arabia", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Arabia", "target_book": "historia_medicinal_monardes_1574", "target_name": "Arab\u00eda", "similarity": 0.969}, {"source_book": "kosmos_humboldt_1845", "source_name": "Arabia", "target_book": "ricettario_fiorentino_1597", "target_name": "Arabia", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Arab\u00eda", "target_book": "ricettario_fiorentino_1597", "target_name": "Arabia", "similarity": 0.969}], "id": 259, "stable_key": "clu_390f4f5caab41262", "ground_truth": {"modern_name": "Arabia", "confidence": "high", "type": "place", "description": "Peninsula in Southwest Asia, historically significant for trade and culture.", "wikipedia_extract": "The Arabian Peninsula (Arabic: \u0634\u0628\u0647 \u0627\u0644\u062c\u0632\u064a\u0631\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629, romanized: shibh al-jaz\u012bra al-\u02bfarabiyya, or \u062c\u0632\u064a\u0631\u0629 \u0627\u0644\u0639\u0631\u0628, jaz\u012brat al-\u02bfarab, 'the Island of Arabs'), or simply Arabia, is a peninsula in West Asia, situated north-east of Africa on the Arabian plate. At 3,237,500 km2 (1.25 million mi2), comparable in size to India, the Arabian Peninsula is the largest peninsula in the world. Geographically, the Arabian Peninsula comprises Bahrain, Kuwait, Oman, Qatar, Saudi Arabia, the United Arab Emirates (UAE) and Yemen, as well as southern Iraq and Jordan. The largest of these is Saudi Arabia. In ancient antiquity, particularly from the 9th century BC to the 7th century AD, the Sinai Peninsula was also considered a part of Arabia. The Arabian Peninsula formed as a result of the rifting of the Red Sea between 56 and 23 million years ago, and is bordered by the Red Sea to the west and south-west, the Persian Gulf and the Gulf of Oman to the north-east, the Levant and Mesopotamia to the north and the Arabian Sea and the Indian Ocean to the south-east."}}, {"canonical_name": "Venezia", "category": "PLACE", "subcategory": "CITY", "book_count": 5, "total_mentions": 11, "members": [{"entity_id": "venecia", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Venecia", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Venecia"], "contexts": ["city"]}, {"entity_id": "venet_", "book_id": "kosmos_humboldt_1845", "name": "Venet.", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Venet."], "contexts": ["Venice, publication location"]}, {"entity_id": "venecia", "book_id": "historia_medicinal_monardes_1574", "name": "Venecia", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Venecia"], "contexts": ["city where Ca\u00f1afistola was brought to", "better than that from Venice"]}, {"entity_id": "venezia", "book_id": "ricettario_fiorentino_1597", "name": "Venezia", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Venezia", "Venetia", "Vinetia"], "contexts": ["city where Acacia was seen", "city where substances are found"]}, {"entity_id": "venetijs", "book_id": "polyanthea_medicinal", "name": "Venetijs", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Venetijs"], "contexts": ["location where worms were observed", "city where experience was gained"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Venecia", "target_book": "kosmos_humboldt_1845", "target_name": "Venet.", "similarity": 0.931}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Venecia", "target_book": "historia_medicinal_monardes_1574", "target_name": "Venecia", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Venecia", "target_book": "ricettario_fiorentino_1597", "target_name": "Venezia", "similarity": 0.924}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Venecia", "target_book": "polyanthea_medicinal", "target_name": "Venetijs", "similarity": 0.95}, {"source_book": "kosmos_humboldt_1845", "source_name": "Venet.", "target_book": "historia_medicinal_monardes_1574", "target_name": "Venecia", "similarity": 0.931}, {"source_book": "kosmos_humboldt_1845", "source_name": "Venet.", "target_book": "polyanthea_medicinal", "target_name": "Venetijs", "similarity": 0.95}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Venecia", "target_book": "ricettario_fiorentino_1597", "target_name": "Venezia", "similarity": 0.924}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Venecia", "target_book": "polyanthea_medicinal", "target_name": "Venetijs", "similarity": 0.95}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Venezia", "target_book": "polyanthea_medicinal", "target_name": "Venetijs", "similarity": 0.889}], "id": 260, "stable_key": "clu_5296ee5594d1f16a", "ground_truth": {"modern_name": "Venice", "confidence": "high", "type": "place", "description": "Major city-state in Italy, a historical center of trade and culture.", "wikipedia_extract": "Venice is a city in northeastern Italy and the capital of the region of Veneto. It is built on a group of 126 islands that are separated by expanses of open water and by canals; portions of the city are linked by 472 bridges. The islands are in the shallow Venetian Lagoon, an enclosed bay lying between the mouths of the Po and the Piave rivers (more exactly between the Brenta and the Sile). As of 2025, the city proper (comune of Venice) has 249,466 inhabitants, nearly 50,000 of whom live in the historical island city of Venice (centro storico), while most of the population resides on the mainland (terraferma), and about 25,000 live on other islands in the lagoon (estuario). Together with the cities of Padua and Treviso, Venice is included in the Padua-Treviso-Venice Metropolitan Area (PATREVE), which is considered a statistical metropolitan area, with a total population of 2.6 million. The name is derived from the ancient Veneti people who inhabited the region by the 10th century BC."}}, {"canonical_name": "gas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 5, "total_mentions": 11, "members": [{"entity_id": "gas", "book_id": "principles_of_psychology_james_1890", "name": "gas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["gas"], "contexts": ["flammable gas used to create a flame"]}, {"entity_id": "gas", "book_id": "kosmos_humboldt_1845", "name": "gas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["gas"], "contexts": ["state of matter emitted from volcanoes", "developed with loud noise"]}, {"entity_id": "gas", "book_id": "polyanthea_medicinal", "name": "gas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["gas"], "contexts": ["purgatives", "affected by water"]}, {"entity_id": "gas", "book_id": "connexion_physical_sciences_somerville_1858", "name": "gas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["gas"], "contexts": ["state of matter", "substance in solution producing positive electricity"]}, {"entity_id": "gas", "book_id": "first_principles_spencer_1862", "name": "gas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["gas"], "contexts": ["state of matter with dispersed particles"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "gas", "target_book": "kosmos_humboldt_1845", "target_name": "gas", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "gas", "target_book": "polyanthea_medicinal", "target_name": "gas", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "gas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gas", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "gas", "target_book": "first_principles_spencer_1862", "target_name": "gas", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "gas", "target_book": "polyanthea_medicinal", "target_name": "gas", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "gas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gas", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "gas", "target_book": "first_principles_spencer_1862", "target_name": "gas", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "gas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gas", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "gas", "target_book": "first_principles_spencer_1862", "target_name": "gas", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "gas", "target_book": "first_principles_spencer_1862", "target_name": "gas", "similarity": 1.0}], "id": 261, "stable_key": "clu_4c00c092b41f27d3", "ground_truth": {"modern_name": "Gas", "confidence": "high", "type": "concept", "note": "The term 'gas' in early modern texts referred to a state of matter, sometimes associated with vapors or aerial substances, and the contexts align with this scientific understanding, even if the specific properties or understanding differed from modern chemistry.", "wikidata_id": "Q131271", "wikidata_description": "species of bacterium", "wikipedia_url": "https://en.wikipedia.org/wiki/Streptococcus%20pyogenes", "wikipedia_extract": "Streptococcus pyogenes is a species of Gram-positive, aerotolerant bacteria in the genus Streptococcus. These bacteria are extracellular, and made up of non-motile and non-sporing cocci (round cells) that tend to link in chains. They are clinically important for humans, as they are an infrequent, but usually pathogenic, part of the skin microbiota that can cause group A streptococcal infection. S. pyogenes  is the predominant species harboring the Lancefield group A antigen, and is often called group A Streptococcus (GAS). However, both Streptococcus dysgalactiae and the Streptococcus anginosus group can possess group A antigen as well."}}, {"canonical_name": "Arteries", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 11, "members": [{"entity_id": "art\u00e8res", "book_id": "medecine_experimentale_bernard_1865", "name": "art\u00e8res", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["art\u00e8res"], "contexts": ["blood vessels carrying blood from heart"]}, {"entity_id": "arteries", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Arteries", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["arteries", "Arteries"], "contexts": ["convey spirits into brain", "structures formed in embryonic development"]}, {"entity_id": "arteries", "book_id": "english_physician_1652", "name": "Arteries", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 6, "variants": ["Arteries"], "contexts": ["melancholy vapors expelled from", "body part helped by oil"]}, {"entity_id": "arteries", "book_id": "origin_of_species_darwin_1859", "name": "arteries", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["arteries"], "contexts": ["blood vessels carrying blood away from heart"]}, {"entity_id": "arterie", "book_id": "polyanthea_medicinal", "name": "arterie", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["arterie"], "contexts": ["body part"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "art\u00e8res", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Arteries", "similarity": 0.957}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "art\u00e8res", "target_book": "english_physician_1652", "target_name": "Arteries", "similarity": 0.957}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Arteries", "target_book": "english_physician_1652", "target_name": "Arteries", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "arteries", "target_book": "polyanthea_medicinal", "target_name": "arterie", "similarity": 0.986}], "id": 262, "stable_key": "clu_f706f8d8b22ef168", "ground_truth": {"modern_name": "Artery", "confidence": "high", "type": "concept", "note": "This refers to the anatomical structure, not a specific disease or condition.", "wikidata_id": "Q14890445", "wikidata_description": "The process in which the anatomical structures of arterial blood vessels are generated and organized. Arteries are blood vessels that transport blood from the heart to the body and its organs."}}, {"canonical_name": "r\u00e9volution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 11, "members": [{"entity_id": "r\u00e9volutions", "book_id": "epoques_nature_buffon_1778", "name": "r\u00e9volutions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["r\u00e9volutions"], "contexts": ["interruptions in geological history"]}, {"entity_id": "r\u00e9volution", "book_id": "relation_historique_humboldt_vol3_1825", "name": "r\u00e9volution", "cate