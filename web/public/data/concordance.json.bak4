escription": "French physiologist, studied the nervous system"}}, {"canonical_name": "dissociation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "dissociation", "book_id": "medecine_experimentale_bernard_1865", "name": "dissociation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dissociation"], "contexts": ["chemical process of breaking down compounds"]}, {"entity_id": "dissociation", "book_id": "principles_of_psychology_james_1890", "name": "dissociation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["dissociation", "Dissociation"], "contexts": ["separation of mental functions", "opening out of one into many"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "dissociation", "target_book": "principles_of_psychology_james_1890", "target_name": "dissociation", "similarity": 1.0}], "id": 3881, "stable_key": "clu_b6eb3f7892a2d101", "ground_truth": {"modern_name": "Dissociation", "confidence": "high", "type": "concept", "note": "The term 'dissociation' in early modern medical and scientific texts could refer to chemical dissociation or the separation of mental functions, as indicated by the contexts provided.", "wikidata_id": "Q17009329", "wikidata_description": "rhetorical device where speaker splits concept considered unitary", "wikipedia_url": "https://en.wikipedia.org/wiki/Dissociation%20%28rhetoric%29"}}, {"canonical_name": "Leyden", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "leyden", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Leyden", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Leyden"], "contexts": ["city in the Netherlands", "city associated with a party of people"]}, {"entity_id": "leyden", "book_id": "english_physician_1652", "name": "Leyden", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Leyden"], "contexts": ["university where Dioscorides' book is used"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Leyden", "target_book": "english_physician_1652", "target_name": "Leyden", "similarity": 1.0}], "id": 3882, "stable_key": "clu_a3c8bda997824d9d", "ground_truth": {"wikipedia_extract": "Leiden ( LY-d\u0259n; Dutch: [\u02c8l\u025bid\u0259(n)] ; in English and archaic Dutch also Leyden) is a city and municipality in the province of South Holland, Netherlands. The municipality of Leiden has a population of 127,046 (31 January 2023), but the city forms one densely connected agglomeration with its suburbs Oegstgeest, Leiderdorp, Voorschoten and Zoeterwoude with 215,602 inhabitants. The Netherlands Central Bureau of Statistics (CBS) further includes Katwijk in the agglomeration which makes the total population of the Leiden urban agglomeration 282,207. Further, Teylingen, Noordwijk, and Noordwijkerhout are included in the larger Leiden urban area, which has 365,913 inhabitants. Leiden is located on the Oude Rijn, at a distance of some 20 km (12 mi) from The Hague to its south and some 40 km (25 mi) from Amsterdam to its north. The recreational area of the Kaag Lakes (Kagerplassen) lies just to the northeast of Leiden."}}, {"canonical_name": "Juvenal", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "juvenal", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Juvenal", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Juvenal"], "contexts": ["ancient Roman satirist", "ancient Roman poet"]}, {"entity_id": "juvenal", "book_id": "english_physician_1652", "name": "Juvenal", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Juvenal"], "contexts": ["ancient Roman poet"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Juvenal", "target_book": "english_physician_1652", "target_name": "Juvenal", "similarity": 1.0}], "id": 3883, "stable_key": "clu_50acc99a3d390798", "ground_truth": {"modern_name": "Juvenal", "confidence": "high", "type": "person", "birth_year": 60, "death_year": 127, "description": "Roman satirist and poet, influential ancient authority", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "\u00c6sculapius", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "\u00e6sculapius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "\u00c6sculapius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["\u00c6sculapius"], "contexts": ["Greek god of medicine", "mythological god of healing"]}, {"entity_id": "aesculapius", "book_id": "english_physician_1652", "name": "AEsculapius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["AEsculapius"], "contexts": ["deity associated with healing"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "\u00c6sculapius", "target_book": "english_physician_1652", "target_name": "AEsculapius", "similarity": 0.909}], "id": 3884, "stable_key": "clu_f8205348de0bcb5d", "ground_truth": {"modern_name": "Asclepius", "confidence": "high", "type": "person", "description": "Greek god of healing and medicine"}}, {"canonical_name": "Pitch", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "pitch", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Pitch", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Pitch"], "contexts": ["tar-like substance", "viscous black substance"]}, {"entity_id": "pitch", "book_id": "english_physician_1652", "name": "Pitch", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Pitch"], "contexts": ["material used in a plaister with Angelica"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Pitch", "target_book": "english_physician_1652", "target_name": "Pitch", "similarity": 0.783}], "id": 3885, "stable_key": "clu_1f2593cf666dfa86-2", "ground_truth": {"modern_name": "pitch", "confidence": "high", "type": "substance", "description": "A thick, sticky, dark substance obtained from resin.", "note": "'pezze' context might refer to pieces of cloth or material.", "wikipedia_extract": "Pez (English: , German: [pe\u02d0ts]; stylised as PEZ, officially Pfefferminz, German for peppermint) is the brand name of an Austrian candy and associated manual candy dispensers. The candy is a pressed, dry, straight-edged, curved-corner block 15 mm (5\u20448 inch) long, 8 mm (5\u204416 inch) wide and 5 mm (3\u204416 inch) high, with each Pez dispenser holding 12 candy pieces. Pez was invented in Austria and later exported worldwide. The all-uppercase spelling of the logo echoes the trademark's style on the packaging and the dispensers, with the logo drawn in perspective and giving the appearance that the letters are built out of 44 brick-like Pez mints (14 bricks in the P and 15 in each of the E and Z). Despite the widespread recognition and popularity of the Pez dispenser, the company considers itself to be primarily a candy company, stating that \"[t]oday, billions of PEZ candies are consumed annually in the U.S.A. alone\". Pez dispensers are a part of popular culture in many nations, an example being \"Soul Candy\" in the Japanese manga series Bleach.", "wikidata_id": "Q840692", "wikidata_description": "mixture of aromatic organic compounds, black, tar-like, super viscous liquid"}}, {"canonical_name": "Josephus", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "josephus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Josephus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Josephus"], "contexts": ["ancient historian", "ancient Jewish historian"]}, {"entity_id": "jos\u00e8phe", "book_id": "epoques_nature_buffon_1778", "name": "Jos\u00e8phe", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Jos\u00e8phe"], "contexts": ["historian who transmitted a period"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Josephus", "target_book": "epoques_nature_buffon_1778", "target_name": "Jos\u00e8phe", "similarity": 0.882}], "id": 3886, "stable_key": "clu_99a7ae204af1c86e", "ground_truth": {"modern_name": "Josephus", "confidence": "high", "type": "person", "birth_year": 37, "death_year": 100, "description": "Roman-Jewish historian known for his accounts of Jewish history.", "wikidata_id": "Q134461", "wikidata_description": "Roman\u2013Jewish historian and military leader (c. 37\u2013c. 100)", "wikipedia_url": "https://en.wikipedia.org/wiki/Josephus"}}, {"canonical_name": "Manes", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "manes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Manes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Manes"], "contexts": ["founder of Manichaeism", "body was phantastical"]}, {"entity_id": "menezes", "book_id": "polyanthea_medicinal", "name": "Menezes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Menezes"], "contexts": ["uncle of Senhor de Aguas Bellas"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Manes", "target_book": "polyanthea_medicinal", "target_name": "Menezes", "similarity": 0.851}], "id": 3887, "stable_key": "clu_01623d3f02e34694", "ground_truth": {"modern_name": "Manes", "confidence": "high", "type": "person", "birth_year": 216, "death_year": 274, "description": "Founder of Manichaeism, ancient religious figure", "note": "The mention of 'Menezes' in 'polyanthea_medicinal' is likely a distinct individual, but 'Manes' as the founder of Manichaeism is the primary referent given the context of pseudodoxia epidemica."}}, {"canonical_name": "Charms", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "charms", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Charms", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["Charms"], "contexts": ["danger and delusion in cures", "superstitious cures"]}, {"entity_id": "charms", "book_id": "first_principles_spencer_1862", "name": "charms", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["charms"], "contexts": ["objects believed to have magical power"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Charms", "target_book": "first_principles_spencer_1862", "target_name": "charms", "similarity": 0.903}], "id": 3888, "stable_key": "clu_ea577a02f42abbd2", "ground_truth": {"modern_name": "Charm", "confidence": "high", "type": "object", "note": "Refers to amulets or objects believed to possess magical properties, often used for protection or healing.", "wikipedia_extract": "Charm++ is a parallel object-oriented programming paradigm based on C++ and developed in the Parallel Programming Laboratory at the University of Illinois at Urbana\u2013Champaign. Charm++ is designed with the goal of enhancing programmer productivity by providing a high-level abstraction of a parallel program while at the same time delivering good performance on a wide variety of underlying hardware platforms. Programs written in Charm++ are decomposed into a number of cooperating message-driven objects called chares. When a programmer invokes a method on an object, the Charm++ runtime system sends a message to the invoked object, which may reside on the local processor or on a remote processor in a parallel computation. This message triggers the execution of code within the chare to handle the message asynchronously. Chares may be organized into indexed collections called chare arrays and messages may be sent to individual chares within a chare array or to the entire chare array simultaneously.", "wikipedia_url": "https://en.wikipedia.org/wiki/Charm++"}}, {"canonical_name": "Beryls", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "beryls", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Beryls", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["Beryls"], "contexts": ["gemstone", "stones subject to fusion in fire"]}, {"entity_id": "beryls", "book_id": "kosmos_humboldt_1845", "name": "beryls", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["beryls"], "contexts": ["magnificent crystals"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Beryls", "target_book": "kosmos_humboldt_1845", "target_name": "beryls", "similarity": 0.973}], "id": 3889, "stable_key": "clu_f5830b1002c6a7c2-2", "ground_truth": {"modern_name": "beryl", "confidence": "high", "type": "mineral", "wikidata_id": "Q569", "wikidata_description": "chemical element with symbol Be and atomic number 4", "wikipedia_url": "https://en.wikipedia.org/wiki/Beryllium", "wikipedia_extract": "Beryl ( BERR-\u0259l) is a mineral composed of beryllium aluminium silicate with the chemical formula Be3Al2(SiO3)6. Well-known varieties of beryl include emerald and aquamarine. Naturally occurring  hexagonal crystals of beryl can be up to several meters in size, but terminated crystals are relatively rare. Pure beryl is colorless, but it is frequently tinted by impurities; possible colors are green, blue, yellow, pink, and red (the rarest). It is an ore source of beryllium. The word beryl \u2013 Middle English: beril \u2013 is borrowed, via Old French: beryl and Latin: beryllus, from Ancient Greek \u03b2\u03ae\u03c1\u03c5\u03bb\u03bb\u03bf\u03c2 b\u1e17ryllos, which referred to various blue-green stones, from Prakrit veru\u1e37iya, ve\u1e37uriya 'beryl' which is ultimately of Dravidian origin, maybe from the name of Belur or Velur, a town in Karnataka, southern India."}}, {"canonical_name": "Flint", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "flint", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Flint", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["Flint"], "contexts": ["stone that strikes fire with steel", "vulgar stone with no attractive power"]}, {"entity_id": "flint", "book_id": "first_principles_spencer_1862", "name": "Flint", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Flint"], "contexts": ["implement material found in geologic deposits"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Flint", "target_book": "first_principles_spencer_1862", "target_name": "Flint", "similarity": 1.0}], "id": 3890, "stable_key": "clu_b18a24c50080fbe2", "ground_truth": {"modern_name": "Flint", "confidence": "high", "type": "mineral", "wikidata_id": "Q1428848", "wikidata_description": "town in Wales, United Kingdom"}}, {"canonical_name": "Urine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "urine", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Urine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Urine"], "contexts": ["bodily fluid", "source of volatile salt and Aqua vit\u00e6"]}, {"entity_id": "urine", "book_id": "principles_of_psychology_james_1890", "name": "urine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["urine"], "contexts": ["fluid secreted by kidneys"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Urine", "target_book": "principles_of_psychology_james_1890", "target_name": "urine", "similarity": 0.974}], "id": 3891, "stable_key": "clu_ddc070d23d54551c", "ground_truth": {"modern_name": "Urine", "confidence": "high", "type": "substance", "description": "A bodily fluid produced by the kidneys and excreted from the body.", "note": "Refers to the bodily fluid itself and the passages through which it travels.", "wikipedia_extract": "Urine, excreted by the kidneys, is a liquid containing excess water and water-soluble nitrogen-rich by-products of metabolism including urea, uric acid, and creatinine, which must be cleared from the bloodstream. Urinalysis detects these nitrogenous wastes in mammals. In placental mammals, urine travels from the kidneys via the ureters to the bladder and exits the urethra through the penis or vulva during urination. Other vertebrates excrete urine through the cloaca. Urine plays an important role in the earth's nitrogen cycle. In balanced ecosystems, urine fertilizes the soil and thus helps plants to grow."}}, {"canonical_name": "Iris", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "iris", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Iris", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["Iris"], "contexts": ["gem similar to Crystal", "generation of iris"]}, {"entity_id": "iris", "book_id": "polyanthea_medicinal", "name": "Iris", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Iris"], "contexts": ["colored part of the eye"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Iris", "target_book": "polyanthea_medicinal", "target_name": "Iris", "similarity": 0.635}], "id": 3892, "stable_key": "clu_34a4a58bcd991e09", "ground_truth": {"modern_name": "Iris", "confidence": "medium", "type": "concept", "note": "The term 'Iris' in early modern texts could refer to the gemstone or the part of the eye. Context is needed for definitive identification."}}, {"canonical_name": "Albertus Magnus", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "albertus_magnus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Albertus Magnus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Albertus Magnus"], "contexts": ["made mention of the magnet", "medieval scholar on badger leg inequality"]}, {"entity_id": "albertus_magnus", "book_id": "first_principles_spencer_1862", "name": "Albertus Magnus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Albertus Magnus"], "contexts": ["medieval philosopher and theologian"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Albertus Magnus", "target_book": "first_principles_spencer_1862", "target_name": "Albertus Magnus", "similarity": 1.0}], "id": 3893, "stable_key": "clu_642c994b615164d7-2", "ground_truth": {"modern_name": "Albertus Magnus", "confidence": "high", "type": "person", "birth_year": 1200, "death_year": 1280, "description": "Medieval philosopher, theologian, and prolific writer on natural philosophy.", "wikidata_id": "Q60059", "wikidata_description": "German-Dominican friar and saint (c. 1200\u20131280)"}}, {"canonical_name": "King-fisher", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "king-fisher", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "King-fisher", "category": "ANIMAL", "subcategory": "BIRD", "count": 3, "variants": ["King-fisher"], "contexts": ["bird discussed in chapter X", "bird believed to indicate wind direction"]}, {"entity_id": "kingfisher", "book_id": "origin_of_species_darwin_1859", "name": "kingfisher", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["kingfisher"], "contexts": ["bird that catches fish"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "King-fisher", "target_book": "origin_of_species_darwin_1859", "target_name": "kingfisher", "similarity": 0.973}], "id": 3894, "stable_key": "clu_ced964147cf16c6c", "ground_truth": {"modern_name": "Kingfisher", "confidence": "high", "type": "animal", "wikidata_id": "Q1013136", "wikidata_description": "city in and the county seat of Kingfisher County, Oklahoma, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Kingfisher", "wikipedia_extract": "Kingfishers are a family, the Alcedinidae, of small to medium-sized, brightly coloured birds in the order Coraciiformes. They have a cosmopolitan distribution: most species live in the tropical regions of Africa, Asia, and Oceania, but they can also be found in Europe and the Americas. They can be found in deep forests near calm ponds and small rivers. The family contains 118 species and is divided into three subfamilies and 19 genera. All kingfishers have large heads, long, sharp, pointed bills, short legs, and stubby tails. Most species have bright plumage with only small differences between the sexes."}}, {"canonical_name": "Latina", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "latina", "book_id": "ricettario_fiorentino_1597", "name": "Latina", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Latina"], "contexts": ["Latin language"]}, {"entity_id": "latina", "book_id": "polyanthea_medicinal", "name": "Latina", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Latina"], "contexts": ["language spoken by Cornelius Celsus", "language of Cornelius Celsus' people"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Latina", "target_book": "polyanthea_medicinal", "target_name": "Latina", "similarity": 1.0}], "id": 3895, "stable_key": "clu_9abd4d618c616dd5-2", "ground_truth": {"modern_name": "Latin language", "confidence": "high", "type": "concept", "wikidata_id": "Q397", "wikidata_description": "Indo-European language of the Italic branch", "wikipedia_url": "https://en.wikipedia.org/wiki/Latin", "wikipedia_extract": "Latin (lingua Latina or Latinum) is a classical language belonging to the Italic branch of the Indo-European languages. Latin was originally spoken by the Latins in Latium (now known as Lazio), the lower Tiber area around Rome, Italy. Through the expansion of the Roman Republic, it became the dominant language in the Italian Peninsula and subsequently throughout the Roman Empire. It has greatly influenced many languages, including English, having contributed many words to the English lexicon, particularly after the Christianisation of the Anglo-Saxons and the Norman Conquest. Latin roots appear frequently in the technical vocabulary used by fields such as theology, the sciences, medicine, and law. By the late Roman Republic, Old Latin had evolved into standardised Classical Latin."}}, {"canonical_name": "Idea", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "idea", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Idea", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Idea"], "contexts": ["original conception in divine mind", "mental representation or concept"]}, {"entity_id": "idea", "book_id": "polyanthea_medicinal", "name": "idea", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["idea"], "contexts": ["mental impression"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Idea", "target_book": "polyanthea_medicinal", "target_name": "idea", "similarity": 0.981}], "id": 3896, "stable_key": "clu_a0170198e146432d-2", "ground_truth": {"modern_name": "Ideas", "confidence": "high", "type": "concept", "wikidata_id": "Q131841", "wikidata_description": "mental image or concept", "wikipedia_url": "https://en.wikipedia.org/wiki/Idea", "wikipedia_extract": "In philosophy and in common usage, an idea (from the Greek word: \u1f30\u03b4\u03ad\u03b1 (idea), meaning 'a form, or a pattern') is the result of thought. Also in philosophy, ideas can also be mental representational images of some object. Many philosophers have considered ideas to be a fundamental ontological category of being. The capacity to create  and understand the meaning of ideas is considered to be an essential and defining feature of human beings. An idea arises in a reflexive, spontaneous manner, even without thinking or serious reflection, for example, when we talk about the idea of a person or a place. A new or an original idea can often lead to innovation."}}, {"canonical_name": "mankind", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "mankind", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "mankind", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Mankind", "mankind"], "contexts": ["greater part of Mankind", "collective humanity"]}, {"entity_id": "mankind", "book_id": "kosmos_humboldt_1845", "name": "mankind", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["mankind"], "contexts": ["the human race"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "mankind", "target_book": "kosmos_humboldt_1845", "target_name": "mankind", "similarity": 1.0}], "id": 3897, "stable_key": "clu_8ba69b4c7d3a1d34", "ground_truth": {"modern_name": "humanity", "confidence": "high", "type": "concept", "note": "While 'mankind' and 'man' can refer to individual persons, in these contexts they refer to the collective human race or the species.", "wikidata_id": "Q1575029", "wikidata_description": "International aid organization with headquarter in France"}}, {"canonical_name": "Barbara", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "barbara", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Barbara", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Barbara"], "contexts": ["specific type of syllogism", "saint associated with a plant name"]}, {"entity_id": "barbara", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Barbara", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Barbara"], "contexts": ["queen, daughter of John V of Portugal", "mother of Don Carlos, queen"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Barbara", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Barbara", "similarity": 1.0}], "id": 3898, "stable_key": "clu_903dd037756cfba7", "ground_truth": {"modern_name": "Barbara", "confidence": "medium", "type": "concept", "note": "The term 'Barbara' likely refers to the Barbara syllogism, a specific form of logical argument in Aristotelian logic. The mention of a queen is less common in scientific texts."}}, {"canonical_name": "Geometry", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "geometry", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Geometry", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Geometry"], "contexts": ["branch of mathematics", "mathematical study of shapes and space"]}, {"entity_id": "geometry", "book_id": "first_principles_spencer_1862", "name": "Geometry", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["geometry", "Geometry"], "contexts": ["mathematical study of shapes", "study of partitioning ground and buildings"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Geometry", "target_book": "first_principles_spencer_1862", "target_name": "Geometry", "similarity": 1.0}], "id": 3899, "stable_key": "clu_9db880f075de9327", "ground_truth": {"modern_name": "Geometry", "confidence": "high", "type": "concept"}}, {"canonical_name": "Ezekiel", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "ezekiel", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ezekiel", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Ezekiel"], "contexts": ["biblical prophet", "biblical book referenced"]}, {"entity_id": "ezekiel", "book_id": "coloquios_da_orta_1563", "name": "Ezekiel", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Ezekiel"], "contexts": ["biblical figure who spoke of Motei", "mentioned in relation to merchants of Sheba"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ezekiel", "target_book": "coloquios_da_orta_1563", "target_name": "Ezekiel", "similarity": 1.0}], "id": 3900, "stable_key": "clu_94b2ef7a1c12dc91", "ground_truth": {"modern_name": "Ezekiel", "confidence": "high", "type": "person", "description": "Biblical prophet and visionary"}}, {"canonical_name": "Brasilia", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "brasilia", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Brasilia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Brasilia"], "contexts": ["region with compass variation", "region in South America"]}, {"entity_id": "brazils", "book_id": "coloquios_da_orta_1563", "name": "Brazils", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Brazils"], "contexts": ["land in the Americas", "geographic location mentioned in citation"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Brasilia", "target_book": "coloquios_da_orta_1563", "target_name": "Brazils", "similarity": 0.948}], "id": 3901, "stable_key": "clu_2d2c2b3926e4e7b5-2", "ground_truth": {"modern_name": "Brazil", "confidence": "high", "type": "place", "description": "A country in South America.", "wikipedia_extract": "Brazil, officially the Federative Republic of Brazil, is the largest country in South America. It is also the world's fifth-largest country by area and the seventh-largest by population, with over 213 million people. The country is a federation composed of 26 states and a Federal District, which hosts the capital, Bras\u00edlia. Its most populous city is S\u00e3o Paulo, followed by Rio de Janeiro. Brazil has the most Portuguese speakers in the world and is the only country in the Americas where Portuguese is an official language. Bounded by the Atlantic Ocean on the east, Brazil has a coastline of 7,491 kilometers (4,655 mi).", "country": "Brazil", "note": "The term 'Brasilia' or 'Brazils' in early modern texts likely referred to the region of Brazil, not the modern city of Bras\u00edlia.", "wikidata_id": "Q155", "wikidata_description": "country in South America"}}, {"canonical_name": "Ophir", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "ophir", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ophir", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Ophir"], "contexts": ["location for gold", "supposed location in the Indies"]}, {"entity_id": "ophir", "book_id": "coloquios_da_orta_1563", "name": "Ophir", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Ophir"], "contexts": ["legendary land"]}, {"entity_id": "\u00f2phir", "book_id": "coloquios_da_orta_1563", "name": "\u00d2phir", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["\u00d2phir"], "contexts": ["biblical land of gold"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ophir", "target_book": "coloquios_da_orta_1563", "target_name": "Ophir", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ophir", "target_book": "coloquios_da_orta_1563", "target_name": "\u00d2phir", "similarity": 0.669}], "id": 3902, "stable_key": "clu_5db6092025ede168", "ground_truth": {"modern_name": "Ophir", "confidence": "high", "type": "place", "country": "Unknown", "note": "Legendary biblical location, precise modern country is unknown.", "wikidata_id": "Q914073", "wikidata_description": "Biblical port famous for its wealth", "wikipedia_url": "https://en.wikipedia.org/wiki/Ophir", "wikipedia_extract": "Ophir (; Hebrew: \u05d0\u05d5\u05b9\u05e4\u05b4\u05d9\u05e8, Modern: \u02bc\u014cf\u012br, Tiberian: \u02bc\u014cp\u0304\u012br) is a port or region mentioned in the Bible, famous for its wealth. Its existence is attested to by an inscribed pottery shard found at Tell Qasile (in modern-day Tel Aviv) in 1946, dating to the eighth century BC, which reads \"gold of Ophir to/for Beth-Horon [...] 30 shekels\". The location of Ophir is unknown, though the find confirms it as a real place which exported gold. Ophir in Genesis 10 (the Table of Nations) is said to be the name of one of the sons of Joktan. The Books of Kings and Chronicles tell of a joint expedition to Ophir by King Solomon and the Tyrian king Hiram I from Ezion-Geber, a port on the Red Sea, that brought back large amounts of gold, precious stones and 'algum wood' and of a later failed expedition by king Jehoshaphat of Judah. The famous 'gold of Ophir' is referenced in several other books of the Hebrew Bible, in particular Isaiah 13:12 refers to the \"golden wedge of Ophir\"."}}, {"canonical_name": "Electrick", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "electrick", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Electrick", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["electrick", "Electrick"], "contexts": ["substance exhibiting electrical attraction", "body exhibiting attraction"]}, {"entity_id": "electrical", "book_id": "first_principles_spencer_1862", "name": "electrical", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["electrical"], "contexts": ["facts about matter composition", "relating to electric phenomena"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Electrick", "target_book": "first_principles_spencer_1862", "target_name": "electrical", "similarity": 0.915}], "id": 3903, "stable_key": "clu_db24937985ffaaec-2", "ground_truth": {"modern_name": "Electric", "confidence": "high", "type": "concept", "note": "Refers to phenomena or substances related to electricity in general, not a specific substance.", "wikidata_id": "Q383973", "wikidata_description": "process of generating electrical power"}}, {"canonical_name": "State", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "state", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "State", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["State"], "contexts": ["governance and political affairs", "political entity or governance"]}, {"entity_id": "state", "book_id": "first_principles_spencer_1862", "name": "State", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["State"], "contexts": ["entity with governmental power", "secular part of government"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "State", "target_book": "first_principles_spencer_1862", "target_name": "State", "similarity": 1.0}], "id": 3904, "stable_key": "clu_a873e2f762832f26", "ground_truth": {"modern_name": "State", "confidence": "high", "type": "concept"}}, {"canonical_name": "Scammony", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "scammony", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Scammony", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Scammony"], "contexts": ["laxative plant product", "plant with purging virtues"]}, {"entity_id": "scammony", "book_id": "english_physician_1652", "name": "Scammony", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Scammony"], "contexts": ["herb used in learned receipts", "used for watery humors"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Scammony", "target_book": "english_physician_1652", "target_name": "Scammony", "similarity": 1.0}], "id": 3905, "stable_key": "clu_b0c8c6b0e4550b0e", "ground_truth": {"modern_name": "Scammony", "confidence": "high", "type": "plant", "linnaean": "Convolvulus scammonia", "family": "Convolvulaceae", "description": "Resinous purgative obtained from the root of a bindweed plant.", "wikipedia_extract": "Convolvulus scammonia, commonly known as scammony, is a bindweed native to the countries of the eastern part of the Mediterranean basin; it grows in bushy waste places, from Syria in the south to Crimea in the north, its range extending westward to the Greek islands, but not to northern Africa or Italy. It is a twining perennial, bearing flowers like those of Convolvulus arvensis, and having irregularly arrow-shaped leaves and a thick fleshy root. A cathartic resinous tincture known as scammoniae resina, which is obtained from the dried root by digestion with ethanol has been used as a traditional medicine. Upon consumption, the resin is inert until it has passed from the stomach into the duodenum, where it meets the bile. A chemical reaction occurs between it and taurocholate and glycocholate in the bile, whereby it is converted into a powerful purgative which in high doses becomes a violent gastrointestinal irritant. Scammony kills both roundworm and tapeworm, especially the former, and it was therefore used as an anthelmintic."}}, {"canonical_name": "Ginger", "category": "PLANT", "subcategory": "ROOT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "ginger", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ginger", "category": "PLANT", "subcategory": "ROOT", "count": 2, "variants": ["Ginger"], "contexts": ["spice from a plant", "root of an herbaceous plant"]}, {"entity_id": "ginger", "book_id": "english_physician_1652", "name": "Ginger", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Ginger"], "contexts": ["spice used in a powder", "aromatic root"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ginger", "target_book": "english_physician_1652", "target_name": "Ginger", "similarity": 0.863}], "id": 3906, "stable_key": "clu_427dbe98d053f861-2", "ground_truth": {"modern_name": "Ginger", "confidence": "high", "type": "plant", "linnaean": "Zingiber officinale Roscoe", "family": "Zingiberaceae", "wikidata_id": "Q35625", "wikidata_description": "plant species", "wikipedia_extract": "Modern ginger beer is a sweetened and carbonated, usually non-alcoholic beverage, a type of soft drink. Historically it was a type of beer brewed by the natural fermentation of prepared ginger spice, yeast and sugar. Modern ginger beers are often manufactured rather than brewed, frequently with flavour and colour additives, with artificial carbonation. The related ginger ales also are not brewed. Ginger beer is still produced at home using a type of symbiotic colony of yeast and Lactobacillus bacteria (SCOBY) known as a \"ginger beer plant\", or from a \"ginger bug\" starter created from fermenting ginger, sugar, and water. Brewed ginger beer originated in Yorkshire in England in the mid-18th century and became popular throughout Britain, the United States, Ireland, South Africa, the Caribbean and Canada, reaching a peak of popularity in the early 20th century.", "wikipedia_url": "https://en.wikipedia.org/wiki/Ginger_beer", "description": "A spicy rhizome used in medicine, cooking, and as a spice."}}, {"canonical_name": "Misseltoe", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "misseltoe", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Misseltoe", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Misseltoe"], "contexts": ["plant found on some trees", "parasitic plant growing on trees"]}, {"entity_id": "misseltoe", "book_id": "origin_of_species_darwin_1859", "name": "Misseltoe", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Misseltoe", "misseltoe"], "contexts": ["parasitic plant with specific needs", "complex relations of"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Misseltoe", "target_book": "origin_of_species_darwin_1859", "target_name": "Misseltoe", "similarity": 1.0}], "id": 3907, "stable_key": "clu_ce7e0cdc36b852c0", "ground_truth": {"modern_name": "Mistletoe", "confidence": "high", "type": "plant", "linnaean": "Viscum album Linnaeus", "family": "Santalaceae", "wikidata_id": "Q144940", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Viscum%20album", "wikipedia_extract": "Mistletoe is the common name for obligate hemiparasitic plants in the order Santalales. They are attached to their host tree or shrub by a structure called the haustorium, through which they extract water and nutrients from the host plant. There are hundreds of species which mostly live in tropical regions. The name mistletoe originally referred to the species Viscum album (European mistletoe, of the family Santalaceae in the order Santalales); it is the only species native to the British Isles and much of Europe. A related species with red fruits, rather than white, Viscum cruciatum, occurs in Southwest Spain and Southern Portugal, as well as in Morocco in North Africa and in southern Africa. There is also a wide variety of species in Australia.", "note": "The primary referent is likely Viscum album, with 'quercino' indicating association with oak."}}, {"canonical_name": "roots", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "roots", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "roots", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["roots"], "contexts": ["plant part planted in a garden", "sap of Trees runs down to the roots"]}, {"entity_id": "root", "book_id": "first_principles_spencer_1862", "name": "root", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["root"], "contexts": ["underlying source or basis", "plant organ growing through soil"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "roots", "target_book": "first_principles_spencer_1862", "target_name": "root", "similarity": 0.936}], "id": 3908, "stable_key": "clu_f44de2881b345810", "ground_truth": {"modern_name": "Root", "confidence": "high", "type": "plant"}}, {"canonical_name": "Acorns", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "acorns", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "acorns", "category": "PLANT", "subcategory": "SEED", "count": 1, "variants": ["acorns"], "contexts": ["seed of an oak tree"]}, {"entity_id": "acorns", "book_id": "english_physician_1652", "name": "Acorns", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Acorns", "Acorus"], "contexts": ["Hogs eat Acorns", "fruit of the oak tree, used medicinally"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "acorns", "target_book": "english_physician_1652", "target_name": "Acorns", "similarity": 0.761}], "id": 3909, "stable_key": "clu_4df975d9c80e155e", "ground_truth": {"modern_name": "Acorn", "confidence": "medium", "type": "plant", "linnaean": "Quercus spp.", "family": "Fagaceae", "note": "The term 'Acorus' appears in one source and refers to a different plant (sweet flag). Given the context 'seed of an oak tree' and 'Hogs eat Acorns', 'Acorn' is the primary identification, but 'Acorus' introduces ambiguity.", "wikidata_id": "Q3914781", "wikidata_description": "fruit/nut of the oak tree", "wikipedia_url": "https://en.wikipedia.org/wiki/Acorn", "wikipedia_extract": "The acorn  is the nut of the oaks and their close relatives (genera Quercus, Notholithocarpus and Lithocarpus, in the family Fagaceae); alternatively known as glans. It usually contains a seedling surrounded by two cotyledons (seedling leaves), enclosed in a tough shell known as the pericarp, and borne in a cup-shaped cupule. Acorns are 1\u20136 cm (1\u20442\u20132+1\u20442 in) long and 0.8\u20134 cm (3\u20448\u20131+5\u20448 in) on the fat side. Acorns take between 5 and 24 months (depending on the species) to mature; see the list of Quercus species for details of oak classification, in which acorn morphology and phenology are important factors. The word acorn (earlier akerne, and acharn) is related to the Gothic name akran, which had the sense of \"fruit of the unenclosed land\". The word was applied to the most important forest produce, that of the oak."}}, {"canonical_name": "Thomas Brown", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "thomas_brown", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "THOMAS BROWN", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["THOMAS BROWN"], "contexts": ["author of the text"]}, {"entity_id": "thomas_brown", "book_id": "principles_of_psychology_james_1890", "name": "Thomas Brown", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Thomas Brown"], "contexts": ["philosopher quoted on consciousness", "philosopher quoted on mental states"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "THOMAS BROWN", "target_book": "principles_of_psychology_james_1890", "target_name": "Thomas Brown", "similarity": 0.87}], "id": 3910, "stable_key": "clu_47c2fd67eb292cf4", "ground_truth": {"modern_name": "Thomas Browne", "confidence": "high", "type": "person", "birth_year": 1605, "death_year": 1682, "description": "English physician, writer, and early scientist, author of Pseudodoxia Epidemica.", "note": "William James quotes Thomas Browne, but the primary association in the cluster is with the author of Pseudodoxia Epidemica.", "wikidata_id": "Q313925", "wikidata_description": "English polymath and author (1605\u20131682)"}}, {"canonical_name": "opinions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "opinions", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "opinions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["opinions"], "contexts": ["beliefs or judgments"]}, {"entity_id": "opinions", "book_id": "first_principles_spencer_1862", "name": "opinions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["opinions"], "contexts": ["beliefs or judgments", "beliefs or judgments held by individuals"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "opinions", "target_book": "first_principles_spencer_1862", "target_name": "opinions", "similarity": 1.0}], "id": 3911, "stable_key": "clu_0b56640bfae1c41c-3", "ground_truth": {"modern_name": "Opinion", "confidence": "high", "type": "concept", "wikidata_id": "Q2271421", "wikidata_description": "use of natural language processing, text analysis and computational linguistics to identify and extract subjective information in source materials"}}, {"canonical_name": "Herod", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "herod", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Herod", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Herod"], "contexts": ["Jewish king"]}, {"entity_id": "herod", "book_id": "kosmos_humboldt_1845", "name": "Herod", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Herod"], "contexts": ["ancient historian", "ancient historian, Herodotus"]}, {"entity_id": "herod_", "book_id": "kosmos_humboldt_1845", "name": "Herod.", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Herod."], "contexts": ["ancient Greek historian"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Herod", "target_book": "kosmos_humboldt_1845", "target_name": "Herod", "similarity": 0.879}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Herod", "target_book": "kosmos_humboldt_1845", "target_name": "Herod.", "similarity": 0.891}], "id": 3912, "stable_key": "clu_e7ef52620ade1db4", "ground_truth": {"modern_name": "Herod the Great", "confidence": "high", "type": "person", "birth_year": -73, "death_year": -4, "description": "King of Judea, client king of Rome.", "note": "The context of 'ancient Greek historian' for Herod is likely a misattribution or confusion with other historical figures.", "wikidata_id": "Q51672", "wikidata_description": "king of Judea from 37/6 BCE to 4/1 BCE"}}, {"canonical_name": "Justinian", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "justinian", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Justinian", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Justinian"], "contexts": ["Emperor, took in with Hippocrates"]}, {"entity_id": "justinian", "book_id": "kosmos_humboldt_1845", "name": "Justinian", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Justinian"], "contexts": ["ruled during comet appearance in 539", "ancient source on Aetna"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Justinian", "target_book": "kosmos_humboldt_1845", "target_name": "Justinian", "similarity": 0.695}], "id": 3913, "stable_key": "clu_dc0738dec6ff854b", "ground_truth": {"modern_name": "Justinian I", "confidence": "high", "type": "person", "birth_year": 482, "death_year": 565, "description": "Byzantine emperor known for legal reforms and building projects.", "wikidata_id": "Q41866", "wikidata_description": "Eastern Roman Emperor who ruled from 527 to 565 (482-565)"}}, {"canonical_name": "Polybius", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "polybius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Polybius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Polybius"], "contexts": ["Greek historian"]}, {"entity_id": "polybius", "book_id": "kosmos_humboldt_1845", "name": "Polybius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Polybius"], "contexts": ["ancient historian", "ancient writer comparing peninsulas"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Polybius", "target_book": "kosmos_humboldt_1845", "target_name": "Polybius", "similarity": 1.0}], "id": 3914, "stable_key": "clu_157ad3f6a9447d84", "ground_truth": {"modern_name": "Polybius", "confidence": "high", "type": "person", "description": "Ancient Greek historian and writer on Roman history.", "wikidata_id": "Q1990508", "wikidata_description": "genus of crabs", "wikipedia_url": "https://en.wikipedia.org/wiki/Polybius%20%28crab%29", "wikipedia_extract": "Polybius (; Ancient Greek: \u03a0\u03bf\u03bb\u03cd\u03b2\u03b9\u03bf\u03c2, Pol\u00fdbios; c.\u2009200 \u2013 c.\u2009118 BC) was an ancient Greek historian of the middle Hellenistic period. He is noted for his Histories, a universal history documenting the rise of Rome in the Mediterranean in the third and second centuries BC. It covers the period 264\u2013146, recording in detail events in Italy, Iberia, Greece, Macedonia, Syria, Egypt and Africa, and documents the Punic Wars and Macedonian Wars among many others. Polybius's Histories is important not only for being the only Hellenistic historical work to survive in any substantial form, but also for its analysis of constitutional change and the mixed constitution. Polybius's discussion of the separation of powers in government, of checks and balances to limit power, and his introduction of \"the people\", all influenced Montesquieu's The Spirit of the Laws, John Locke's Two Treatises of Government, and the framers of the United States Constitution. Polybius was a close friend and mentor to the Roman politician and general Scipio Aemilianus (also called Scipio Africanus the Younger), and had a lasting influence on his decision-making and life."}}, {"canonical_name": "Crato", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "cratevas", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Cratevas", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Cratevas"], "contexts": ["predecessor to Dioscorides"]}, {"entity_id": "crato", "book_id": "polyanthea_medicinal", "name": "Crato", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Crato", "Crat."], "contexts": ["early modern author", "cited for medical consultations"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Cratevas", "target_book": "polyanthea_medicinal", "target_name": "Crato", "similarity": 0.858}], "id": 3915, "stable_key": "clu_4a60a37647efd39f", "ground_truth": {"modern_name": "Cratevas", "confidence": "high", "type": "person", "description": "Greek physician and botanist, author of a herbal.", "note": "The text mentions 'predecessor to Dioscorides' and 'early modern author'. Cratevas was an ancient Greek physician and botanist, contemporary with or slightly before Dioscorides. The 'early modern author' context might refer to the re-publication or discussion of his work, or a confusion with another author named Crato. However, Cratevas is the most likely historical figure given the other clues.", "wikidata_id": "Q743993", "wikidata_description": "ancient Greek physician and rhizotomist"}}, {"canonical_name": "Vitex", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "vitex", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Vitex", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Vitex"], "contexts": ["plant name"]}, {"entity_id": "vitex", "book_id": "coloquios_da_orta_1563", "name": "Vitex", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Vitex"], "contexts": ["plant genus, subject of correction", "genus of plants used in Hindu medicine"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Vitex", "target_book": "coloquios_da_orta_1563", "target_name": "Vitex", "similarity": 1.0}], "id": 3916, "stable_key": "clu_bc25bb888df0700c-2", "ground_truth": {"modern_name": "Chaste tree", "confidence": "high", "type": "plant", "linnaean": "Vitex agnus-castus L.", "family": "Verbenaceae", "wikipedia_extract": "Vitex is a genus of flowering plants in the family Lamiaceae. It has about 200\u2013250 species; as of August 2025 the Plants of the World Online database accepts 211 species. Common names include chaste tree or chastetree, traditionally referring to V. agnus-castus, but often applied to other species, as well, and p\u016briri for the New Zealand species V. lucens. Species of Vitex are native throughout the tropics and subtropics, with a few species in warm-temperate Eurasia and one in New Zealand.", "wikipedia_url": "https://en.wikipedia.org/wiki/Vitex", "description": "Shrub whose berries were used to reduce libido and for medicinal purposes.", "note": "'Agnocasto' is the Italian/Portuguese name for Vitex agnus-castus.", "wikidata_id": "Q29533", "wikidata_description": "species of flowering plant"}}, {"canonical_name": "Thomas", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "thomas", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Thomas", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Thomas"], "contexts": ["biblical figure"]}, {"entity_id": "thomas", "book_id": "polyanthea_medicinal", "name": "Thomas", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Thomas"], "contexts": ["author on Tortura oris", "apothecary"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Thomas", "target_book": "polyanthea_medicinal", "target_name": "Thomas", "similarity": 0.791}], "id": 3917, "stable_key": "clu_2c9d7f0f50073f08", "ground_truth": {"modern_name": "Thomas Aquinas", "confidence": "high", "type": "person", "birth_year": 1225, "death_year": 1274, "description": "Dominican friar, philosopher, theologian, and Doctor of the Church.", "note": "The context of 'author on Tortura oris' strongly suggests Thomas Aquinas, whose Summa Theologica was a foundational text, though direct reference to this specific procedure is less common.", "wikidata_id": "Q9438", "wikidata_description": "Italian Dominican friar, philosopher, Catholic priest, and Doctor of the Church (1225\u20131274)"}}, {"canonical_name": "Cork", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "globe_of_cork", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Globe of Cork", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Globe of Cork"], "contexts": ["floating device for needle experiment"]}, {"entity_id": "cork", "book_id": "english_physician_1652", "name": "Cork", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["Cork"], "contexts": ["material placed in vessel to prevent drowning", "stopper for vessels"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Globe of Cork", "target_book": "english_physician_1652", "target_name": "Cork", "similarity": 0.885}], "id": 3918, "stable_key": "clu_9e4142ee786f87e4", "ground_truth": {"modern_name": "Cork", "confidence": "high", "type": "plant", "linnaean": "Quercus suber Linnaeus", "family": "Fagaceae", "note": "While 'cork' can refer to the material, in the context of experiments involving needles and preventing drowning, it specifically refers to the buoyant material derived from the cork oak tree.", "wikidata_id": "Q36647", "wikidata_description": "city in County Cork, Munster Province, Ireland"}}, {"canonical_name": "Dicaearchus", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "nearchus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Nearchus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Nearchus"], "contexts": ["Nearchus the Admiral of Alexander"]}, {"entity_id": "dicaearchus", "book_id": "kosmos_humboldt_1845", "name": "Dicaearchus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Dicaearchus"], "contexts": ["ancient Greek geographer", "mentioned 'parallel of the diaphragm'"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Nearchus", "target_book": "kosmos_humboldt_1845", "target_name": "Dicaearchus", "similarity": 0.87}], "id": 3919, "stable_key": "clu_f93f201bfa56e9ba", "ground_truth": {"modern_name": "Nearchus", "confidence": "high", "type": "person", "description": "Ancient Greek commander and geographer", "note": "The Portuguese 'Nearcho' is a direct transliteration of the ancient Greek commander Nearchus, mentioned in historical contexts. 'Neighbors' is a clear mistranscription or misinterpretation within the English text of the same entity.", "wikidata_id": "Q1216034", "wikidata_description": "ancient Greek philosopher", "wikipedia_extract": "Nearchus or Nearchos (Greek: \u039d\u03ad\u03b1\u03c1\u03c7\u03bf\u03c2; c.\u2009360 \u2013 300 BC) was one of the Greek officers, a navarch, in the army of Alexander the Great. He is known for his celebrated expeditionary voyage starting from the Indus River, through the Persian Gulf and ending at the mouth of the Tigris River following the Indian campaign of Alexander the Great, in 326\u2013324 BC. A native of Lato in Crete and son of Androtimus, his family settled at Amphipolis in Macedonia at some point during Philip II's reign (we must assume after Philip took the city in 357 BC), at which point Nearchus was probably a young boy. He was almost certainly older than Alexander, as were Ptolemy, Erigyius, and the others of the \u2018boyhood friends\u2019; so depending on when Androtimus came to Macedonia Nearchus was quite possibly born in Crete. Nearchus, along with Ptolemy, Erigyius and Laomedon, and Harpalus, was one of Alexander's \u2018mentors\u2019 \u2013 and he was exiled by Philip as a result of the Pixodarus affair (A 3.6.5; P 10.3). It is not known where the exiles went, but they were recalled only after Philip's death, on Alexander's accession."}}, {"canonical_name": "Balsamis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "balsam", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Balsam", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Balsam"], "contexts": ["healing substance for wounds"]}, {"entity_id": "balsamis", "book_id": "polyanthea_medicinal", "name": "Balsamis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["Balsamis", "Balsamis Chymicisingenere", "Balsamo"], "contexts": ["balsams, medicinal preparations", "chemical preparation"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Balsam", "target_book": "polyanthea_medicinal", "target_name": "Balsamis", "similarity": 0.904}], "id": 3920, "stable_key": "clu_39f8b096b7372fad-2", "ground_truth": {"modern_name": "Balsam", "confidence": "high", "type": "substance", "description": "A fragrant resinous substance obtained from certain trees, used medicinally.", "wikipedia_extract": "Balsam is the resinous exudate (or sap) which forms on certain kinds of trees and shrubs. Balsam (from Latin balsamum \"gum of the balsam tree,\" ultimately from a Semitic source such as Hebrew: \u05d1\u05b9\u05bc\u05e9\u05b6\u05c2\u05dd, romanized: bo\u015bem, lit.\u2009'spice, perfume') owes its name to the biblical Balm of Gilead. Balsams often contain benzoic or cinnamic acid or their esters. The Balsam of Matariyya was a substance famous as a panacea among physicians in the Middle East and Europe during the Antique and Medieval periods. The substance has long been used as a medicine, with early references to the substance recorded as far back as 285 BC. The Balsam of Matariyya was said to be derived from an Egyptian plant and is sometimes also referred to as the balm of Gilead or the balm of Mecca.", "wikidata_id": "Q428750", "wikidata_description": "species of plant in the family Cucurbitaceae"}}, {"canonical_name": "Rush", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "rushes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Rushes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Rushes"], "contexts": ["plant used for charcoal in gunpowder"]}, {"entity_id": "rush", "book_id": "english_physician_1652", "name": "Rush", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Rush", "Rushes"], "contexts": ["plant used for size comparison", "plant used in proverb"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Rushes", "target_book": "english_physician_1652", "target_name": "Rush", "similarity": 0.887}], "id": 3921, "stable_key": "clu_cf7e86a664f0d6cf", "ground_truth": {"modern_name": "Rush", "confidence": "high", "type": "plant", "linnaean": "Juncus", "family": "Juncaceae", "note": "Refers to plants of the genus Juncus, commonly known as rushes. The contexts provided align with their use as materials and components.", "wikipedia_extract": "Juncus is a genus of monocotyledonous flowering plants, commonly known as rushes. It is the largest genus in the family Juncaceae, containing around 340 species. Rushes of the genus Juncus are herbaceous plants that superficially resemble grasses or sedges. They have historically received little attention from botanists; in his 1819 monograph, James Ebenezer Bicheno described the genus as \"obscure and uninviting\". The form of the flower differentiates rushes from grasses or sedges. The flowers of Juncus comprise five whorls of floral parts: three sepals, three petals (or, taken together, six tepals), two to six stamens (in two whorls) and a stigma with three lobes."}}, {"canonical_name": "Corallines", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "coralline", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Coralline", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Coralline"], "contexts": ["plant that can indurate underwater"]}, {"entity_id": "corallines", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Corallines", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Corallines"], "contexts": ["marine organisms", "marine organisms, often plant-like"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Coralline", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Corallines", "similarity": 0.949}], "id": 3922, "stable_key": "clu_1bccabb9923f528b", "ground_truth": {"modern_name": "Coralline", "confidence": "high", "type": "plant", "note": "Refers to a group of marine algae, not a single species. The term 'coralline' in early modern texts could encompass various red algae that form calcareous deposits.", "wikidata_id": "Q1547337", "wikidata_description": "collective term for those islands of the Seychelles that are not on the shallow Seychelles Bank"}}, {"canonical_name": "Milius", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "milius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Milius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Milius"], "contexts": ["accounted carbuncle flame a vulgar error"]}, {"entity_id": "milius", "book_id": "polyanthea_medicinal", "name": "Milius", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Milius"], "contexts": ["cited for case in Bafilic. Chym.", "author of Basilic. Chymic."]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Milius", "target_book": "polyanthea_medicinal", "target_name": "Milius", "similarity": 0.603}], "id": 3923, "stable_key": "clu_6132299a28d5499a", "ground_truth": {"modern_name": "Lorenzo Bellini", "confidence": "medium", "type": "person", "birth_year": 1643, "death_year": 1704, "description": "Italian physician and anatomist, discussed carbuncle as a vulgar error.", "note": "The identification of 'Milius' as Lorenzo Bellini is based on the context of discussing carbuncles and the period. Further confirmation from the specific cited works is needed.", "wikidata_id": "Q128715075", "wikidata_description": "scholarly article"}}, {"canonical_name": "Carrots", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "carrots", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Carrots", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Carrots"], "contexts": ["vegetable plant"]}, {"entity_id": "carrots", "book_id": "english_physician_1652", "name": "Carrots", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Carrots"], "contexts": ["garden vegetable", "root vegetable"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Carrots", "target_book": "english_physician_1652", "target_name": "Carrots", "similarity": 1.0}], "id": 3924, "stable_key": "clu_c3e184d05f7b7b7d", "ground_truth": {"modern_name": "Carrot", "confidence": "high", "type": "plant", "linnaean": "Daucus carota", "family": "Apiaceae", "wikidata_id": "Q81", "wikidata_description": "root vegetable, plant of the Apiaceae family"}}, {"canonical_name": "Suffolk", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "suffolk", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Suffolk", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Suffolk"], "contexts": ["county in England"]}, {"entity_id": "suffolk", "book_id": "english_physician_1652", "name": "Suffolk", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Suffolk", "Susfolk"], "contexts": ["location where Wall-Rue grows", "county in England"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Suffolk", "target_book": "english_physician_1652", "target_name": "Suffolk", "similarity": 1.0}], "id": 3925, "stable_key": "clu_760256c33192e803", "ground_truth": {"modern_name": "Sussex", "confidence": "high", "type": "place", "description": "A county in England, mentioned for local flora and fauna observations.", "wikipedia_extract": "Sussex (/\u02c8s\u028cs\u026aks/;  from the Old English S\u016b\u00feseaxe; lit.\u2009'South Saxons'; 'Sussex') is an area of South East England that was historically a kingdom and, later, a county. The current ceremonial counties of East Sussex and West Sussex cover approximately the same area. The two ceremonial counties border Surrey to the north, Kent to the north-east, the English Channel to the south, and Hampshire to the west. Sussex contains the city of Brighton and Hove and its wider city region, part of the South Downs National Park and the national landscape of the High Weald, and Chichester Harbour. Its coastline is 137 miles (220 km) long. The Kingdom of Sussex emerged in the fifth century in the area that had previously been inhabited by the Regni tribe in the Romano-British period."}}, {"canonical_name": "Carthage", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "carthage", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Carthage", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Carthage"], "contexts": ["city whose gates were battered"]}, {"entity_id": "carthage", "book_id": "kosmos_humboldt_1845", "name": "Carthage", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Carthage"], "contexts": ["location of hot springs phenomenon", "location of hot springs"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Carthage", "target_book": "kosmos_humboldt_1845", "target_name": "Carthage", "similarity": 1.0}], "id": 3926, "stable_key": "clu_9eb44e0638397508", "ground_truth": {"modern_name": "Carthage", "confidence": "high", "type": "place", "country": "Tunisia", "note": "The spelling 'Carthag\u00e8ne' is an archaic French rendering of Carthage.", "wikidata_id": "Q976381", "wikidata_description": "city in and county seat of Panola County, Texas, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Carthage%2C%20Texas", "wikipedia_extract": "Carthage (Arabic: \u0642\u0631\u0637\u0627\u062c, ) was an ancient city in Northern Africa, on the eastern side of the Lake of Tunis in what is now Tunisia. Carthage was one of the most important trading hubs of the Ancient Mediterranean and one of the most affluent cities of the classical world. It became the capital city of the civilization of Ancient Carthage and later Roman Carthage. The city developed from a Phoenician colony into the capital of a Punic empire which dominated large parts of the Southwest Mediterranean during the first millennium BC. The legendary Queen Elissa, Alyssa or Dido, originally from Tyre, is regarded as the founder of the city, though her historicity has been questioned. In the myth, Dido asked for land from a local tribe, which told her that she could get as much land as an oxhide could cover."}}, {"canonical_name": "wrist", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "wrists", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "wrists", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["wrists"], "contexts": ["part of the arm"]}, {"entity_id": "wrist", "book_id": "principles_of_psychology_james_1890", "name": "wrist", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["wrist"], "contexts": ["joint between hand and forearm", "deeper organs, central segments"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "wrists", "target_book": "principles_of_psychology_james_1890", "target_name": "wrist", "similarity": 0.939}], "id": 3927, "stable_key": "clu_cde9a17c35102bf7", "ground_truth": {"modern_name": "Wrist", "confidence": "high", "type": "concept"}}, {"canonical_name": "Lewis", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "lewis", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Lewis", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Lewis"], "contexts": ["French King who sent an elephant"]}, {"entity_id": "lewis", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Lewis", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Lewis", "Lewis et Clark"], "contexts": ["considered tribes as from Asia", "explorer"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lewis", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Lewis", "similarity": 0.679}], "id": 3928, "stable_key": "clu_071eb83644622012", "ground_truth": {"modern_name": "Louis IX of France", "confidence": "medium", "type": "person", "birth_year": 1214, "death_year": 1270, "description": "French king known for his piety and crusades", "note": "The context suggests a French King associated with sending an elephant, which aligns with Louis IX. 'Lewis' is an anglicized form."}}, {"canonical_name": "Turkey", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "turkeys", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Turkeys", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Turkeys"], "contexts": ["large domesticated fowl"]}, {"entity_id": "turkey", "book_id": "origin_of_species_darwin_1859", "name": "Turkey", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["Turkey", "turkey"], "contexts": ["bird whose digestive organs pass fruit seeds", "naked skin on head"]}, {"entity_id": "turkeys", "book_id": "origin_of_species_darwin_1859", "name": "turkeys", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["turkeys"], "contexts": ["large domesticated fowl"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Turkeys", "target_book": "origin_of_species_darwin_1859", "target_name": "Turkey", "similarity": 0.899}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Turkeys", "target_book": "origin_of_species_darwin_1859", "target_name": "turkeys", "similarity": 0.951}], "id": 3929, "stable_key": "clu_27c65c08b4f09f4c", "ground_truth": {"modern_name": "Turkey", "confidence": "high", "type": "animal", "wikidata_id": "Q43794", "wikidata_description": "North American genus of large birds", "wikipedia_url": "https://en.wikipedia.org/wiki/Turkey_%28bird%29", "wikipedia_extract": "The Ottoman Empire, historically also known as the Turkish Empire, controlled much of Southeast Europe, West Asia, and North Africa from the 14th century to the early 20th century. It also controlled parts of southeastern Central Europe between the early 16th and early 18th centuries. The empire emerged from a beylik, or principality, founded in northwestern Anatolia in c. 1299 by the Turkoman tribal leader Osman I. His successors conquered much of Anatolia and expanded into the Balkans by the mid-14th century, transforming their petty kingdom into a transcontinental empire. The Ottomans ended the Byzantine Empire with the conquest of Constantinople in 1453 by Mehmed II."}}, {"canonical_name": "conceit", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "conceit", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "conceit", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["conceit"], "contexts": ["idea or notion"]}, {"entity_id": "conceit", "book_id": "principles_of_psychology_james_1890", "name": "conceit", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["conceit"], "contexts": ["excessive pride in oneself", "excessive pride"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "conceit", "target_book": "principles_of_psychology_james_1890", "target_name": "conceit", "similarity": 1.0}], "id": 3930, "stable_key": "clu_2eae3988dd7b0bad", "ground_truth": {"modern_name": "Conceit", "confidence": "high", "type": "concept"}}, {"canonical_name": "Riolanus", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "riolanus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Riolanus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Riolanus"], "contexts": ["authority refuting the proverb"]}, {"entity_id": "riolanus", "book_id": "polyanthea_medicinal", "name": "Riolanus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Riolanus", "Riolano"], "contexts": ["author of medical text", "Riolanus,Partic. Method.Medic."]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Riolanus", "target_book": "polyanthea_medicinal", "target_name": "Riolanus", "similarity": 0.659}], "id": 3931, "stable_key": "clu_aa5d5ed3428bec7b", "ground_truth": {"modern_name": "Jean Riolan the Younger", "confidence": "high", "type": "person", "birth_year": 1580, "death_year": 1657, "description": "French anatomist and physician, critic of Harvey", "wikidata_id": "Q3174345", "wikidata_description": "French physician (1539-1605)"}}, {"canonical_name": "camel", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "camel", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Camel", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Camel"], "contexts": ["mammal used for comparison of lifespan"]}, {"entity_id": "camel", "book_id": "origin_of_species_darwin_1859", "name": "camel", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["camel"], "contexts": ["domesticated camelid species", "large desert mammal"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Camel", "target_book": "origin_of_species_darwin_1859", "target_name": "camel", "similarity": 0.814}], "id": 3932, "stable_key": "clu_cd5336fbdb117b1a", "ground_truth": {"modern_name": "Camel", "confidence": "high", "type": "animal", "wikidata_id": "Q7375", "wikidata_description": "genus of mammals", "wikipedia_url": "https://en.wikipedia.org/wiki/Camel", "wikipedia_extract": "A camel (from Latin: camelus and Ancient Greek: \u03ba\u03ac\u03bc\u03b7\u03bb\u03bf\u03c2 (kam\u0113los) from Ancient Semitic: g\u0101m\u0101l) is an even-toed ungulate in the genus Camelus that bears distinctive fatty deposits known as \"humps\" on its back. Camels have long been domesticated and, as livestock, they provide food (camel milk and meat) and textiles (fiber and felt from camel hair). Camels are working animals especially suited to their desert habitat and are a vital means of transport for passengers and cargo. There are three surviving species of camel. The one-humped dromedary makes up 94% of the world's camel population, and the two-humped Bactrian camel makes up 6%. The wild Bactrian camel is a distinct species that is not ancestral to the domestic Bactrian camel, and is now critically endangered, with fewer than 1,000 individuals."}}, {"canonical_name": "granits", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "granits", "book_id": "epoques_nature_buffon_1778", "name": "granits", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["granits"], "contexts": ["igneous rock mineral", "granite masses"]}, {"entity_id": "granites", "book_id": "kosmos_humboldt_1845", "name": "granites", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["granites"], "contexts": ["rock crumbling into gravel"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "granits", "target_book": "kosmos_humboldt_1845", "target_name": "granites", "similarity": 0.994}], "id": 3933, "stable_key": "clu_c6b743ee3d106093-2", "ground_truth": {"modern_name": "Granite", "confidence": "high", "type": "mineral", "wikidata_id": "Q36405", "wikidata_description": "city in Scotland, United Kingdom", "wikipedia_url": "https://en.wikipedia.org/wiki/Aberdeen", "wikipedia_extract": "Aberdeen (  AB-\u0259r-DEEN;  locally [\u02cce\u02d0b\u0259r\u02c8din]  or [\u02c8e\u02d0b\u0259rdin] ; Scottish Gaelic: Obar Dheathain [\u02c8op\u0259\u027e \u02c8\u029d\u025b.\u026a\u0272]) is a port city in North East Scotland, and is the third most populous Scottish city. Historically, Aberdeen was within the historic county of Aberdeenshire, but is now separate from the council area of Aberdeenshire. Aberdeen City Council is one of Scotland's 32 local authorities (commonly referred to as councils). Aberdeen has a population of 198,590 (2020) for the main urban area and 220,690 (2020) for the wider settlement including outlying localities, making it the United Kingdom's 39th most populous built-up area. Aberdeen has a long, sandy coastline and features an oceanic climate, with cool summers and mild, rainy winters. Aberdeen received royal burgh status from David I of Scotland (1124\u20131153), which transformed the city economically."}}, {"canonical_name": "mati\u00e8res volatiles", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "mati\u00e8res_volatiles", "book_id": "epoques_nature_buffon_1778", "name": "mati\u00e8res volatiles", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["mati\u00e8res volatiles"], "contexts": ["volatile substances", "volatile materials"]}, {"entity_id": "volatile_liquids", "book_id": "first_principles_spencer_1862", "name": "volatile liquids", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["volatile liquids"], "contexts": ["liquids dissolving non-crystalline substances"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "mati\u00e8res volatiles", "target_book": "first_principles_spencer_1862", "target_name": "volatile liquids", "similarity": 0.933}], "id": 3934, "stable_key": "clu_d7e8bf91e3511754", "ground_truth": {"modern_name": "Volatile substances", "confidence": "high", "type": "chemical", "note": "Refers to substances that readily vaporize or sublimate; also used more broadly for substances that are volatile or reactive.", "wikidata_id": "Q126282532", "wikidata_description": "type of chemical substance with a tendency to evaporate"}}, {"canonical_name": "refroidissement", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "refroidissement", "book_id": "epoques_nature_buffon_1778", "name": "refroidissement", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["refroidissement"], "contexts": ["process of cooling", "process of becoming colder"]}, {"entity_id": "refroidissement_de_l'atmosph\u00e8re", "book_id": "relation_historique_humboldt_vol3_1825", "name": "refroidissement de l'atmosph\u00e8re", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["refroidissement de l'atmosph\u00e8re"], "contexts": ["contributes to temperature drops"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "refroidissement", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "refroidissement de l'atmosph\u00e8re", "similarity": 0.904}], "id": 3935, "stable_key": "clu_bbe088db64d871b9", "ground_truth": {"modern_name": "Cooling", "confidence": "high", "type": "concept", "wikidata_id": "Q16865737", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Cooling%20%28surname%29"}}, {"canonical_name": "Provence", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "provence", "book_id": "epoques_nature_buffon_1778", "name": "Provence", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Provence"], "contexts": ["region in France with volcanoes", "French region with volcanic activity"]}, {"entity_id": "provence", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Provence", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Provence"], "contexts": ["region where wheat and rye disappear"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Provence", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Provence", "similarity": 1.0}], "id": 3936, "stable_key": "clu_7cfb033a4b9d8796", "ground_truth": {"modern_name": "Provence", "confidence": "high", "type": "place", "country": "France", "wikidata_id": "Q101081", "wikidata_description": "region and historical province of southeastern France", "wikipedia_url": "https://en.wikipedia.org/wiki/Provence"}}, {"canonical_name": "cachalots", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "cachalots", "book_id": "epoques_nature_buffon_1778", "name": "cachalots", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["cachalots"], "contexts": ["large marine mammals", "type of whale"]}, {"entity_id": "cachalot", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cachalot", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Cachalot"], "contexts": ["animal fished in the Pacific Ocean"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "cachalots", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Cachalot", "similarity": 0.894}], "id": 3937, "stable_key": "clu_ba0c4b51d408517e", "ground_truth": {"modern_name": "Sperm whale", "confidence": "high", "type": "animal", "wikidata_id": "Q81214", "wikidata_description": "largest species of toothed whale", "wikipedia_url": "https://en.wikipedia.org/wiki/Sperm%20whale"}}, {"canonical_name": "lac Aral", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "lac_aral", "book_id": "epoques_nature_buffon_1778", "name": "lac Aral", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "varian