ey": "clu_1b110af4ecbf62a3", "ground_truth": {"modern_name": "Caribbean Sea", "confidence": "high", "type": "place", "country": "Multiple", "wikidata_id": "Q1247", "wikidata_description": "Marginal tropical sea of the Atlantic Ocean, located east of Central America, south of the Greater Antilles and north of South America"}}, {"canonical_name": "Kirghis", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "kirgises", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Kirgises", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Kirgises"], "contexts": ["people in Orenbourg region"]}, {"entity_id": "kirghis", "book_id": "kosmos_humboldt_1845", "name": "Kirghis", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["Kirghis"], "contexts": ["nomadic people", "nomadic tribe"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Kirgises", "target_book": "kosmos_humboldt_1845", "target_name": "Kirghis", "similarity": 0.96}], "id": 3737, "stable_key": "clu_8ea2d9007044e816", "ground_truth": {"modern_name": "Kyrgyz people", "confidence": "high", "type": "person", "description": "Nomadic people historically in the Orenburg region", "wikidata_id": "Q120269663", "wikidata_description": "people belonging to the Turkic ethnic group living in a country in Eastern Europe and Northern Asia"}}, {"canonical_name": "Indian Archipelago", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "l'archipel_de_l'inde", "book_id": "relation_historique_humboldt_vol3_1825", "name": "l'archipel de l'Inde", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["l'archipel de l'Inde"], "contexts": ["archipelago in Southeast Asia"]}, {"entity_id": "indian_archipelago", "book_id": "kosmos_humboldt_1845", "name": "Indian Archipelago", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Indian Archipelago"], "contexts": ["islands in Southeast Asia", "group of islands with volcanoes"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "l'archipel de l'Inde", "target_book": "kosmos_humboldt_1845", "target_name": "Indian Archipelago", "similarity": 0.908}], "id": 3738, "stable_key": "clu_4fea3c33a39cac1b", "ground_truth": {"modern_name": "Indian Archipelago", "confidence": "high", "type": "place", "country": "Southeast Asia", "wikidata_id": "Q113276545", "wikidata_description": "archipelago in Southeast Asia and western Oceania", "wikipedia_url": "https://en.wikipedia.org/wiki/Indonesian%20archipelago"}}, {"canonical_name": "Santarem", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "santarem", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Santarem", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Santarem"], "contexts": ["city on the Amazon river"]}, {"entity_id": "santarem", "book_id": "polyanthea_medicinal", "name": "Santarem", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Santarem"], "contexts": ["town where case occurred", "city where a patient previously resided"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Santarem", "target_book": "polyanthea_medicinal", "target_name": "Santarem", "similarity": 1.0}], "id": 3739, "stable_key": "clu_dc350236252422eb", "ground_truth": {"modern_name": "Santar\u00e9m", "confidence": "high", "type": "place", "description": "City in Portugal on the Amazon River.", "wikipedia_extract": "Santar\u00e9m (European Portuguese pronunciation: [s\u0250\u0303t\u0250\u02c8\u027e\u0250\u0303j] ) is a Portuguese city and municipality located in the district of Santar\u00e9m. The population of the historic Ribatejo capital  in 2021 was 58,671, in an area of 552.54 km2. The population of the city proper was 29,929 in 2012. The mayor is Ricardo Gon\u00e7alves (PSD). The municipal holiday is March 19, the day of Saint Joseph (S\u00e3o Jos\u00e9). The city is on the Portuguese Way variant of the Way of Saint James."}}, {"canonical_name": "Fichtelgebirge", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "fichtelgebirge", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Fichtelgebirge", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Fichtelgebirge"], "contexts": ["mountain range in Franconia"]}, {"entity_id": "fichtelgebirge", "book_id": "kosmos_humboldt_1845", "name": "Fichtelgebirge", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Fichtelgebirge"], "contexts": ["mountain range location", "mountain range"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Fichtelgebirge", "target_book": "kosmos_humboldt_1845", "target_name": "Fichtelgebirge", "similarity": 0.756}], "id": 3740, "stable_key": "clu_3991d31dacba541b", "ground_truth": {"modern_name": "Fichtel Mountains", "confidence": "high", "type": "place", "country": "Germany", "wikidata_id": "Q572747", "wikidata_description": "hiking and voluntary association in Germany", "wikipedia_url": "https://en.wikipedia.org/wiki/Fichtelgebirge%20Club", "wikipedia_extract": "The Fichtelgebirge Club (German: Fichtelgebirgsverein or FGV) is a large walking club and local heritage society in Bavaria and recognised conservation group with 20,000 members in 55 local groups. As the name says, its main sphere of activity is in the Fichtel Mountains in north Bavaria. Its emblem is the Arctic starflower (the Siebenstern). The aims of the club are the fostering of hiking, training of hiking guides, marking of footpaths, construction and maintenance of rock climbing facilities, observation towers and accommodation facilities, conservation work and support, landscape conservation, support of local culture, monument protection, running the Fichtelgebirge Museum and other local history and natural history collections, publication of the club magazine Der Siebenstern and other heritage publications, youth work and youth support. In 1878 the Fichtel Mountains Section (Sektion Fichtelgebirg) of the German and Austrian Alpine Club was founded in Wunsiedel. From the outset it focussed only on the development of the Fichtel Mountains."}}, {"canonical_name": "Laugier", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "laugier", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Laugier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Laugier"], "contexts": ["author in Annales de Chimie"]}, {"entity_id": "laugier", "book_id": "kosmos_humboldt_1845", "name": "Laugier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Laugier"], "contexts": ["made calculations on comet returns", "calculated comet returns"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Laugier", "target_book": "kosmos_humboldt_1845", "target_name": "Laugier", "similarity": 1.0}], "id": 3741, "stable_key": "clu_76ddef56f493e57e", "ground_truth": {"modern_name": "Laugier", "confidence": "high", "type": "person", "description": "French chemist and author of Annales de Chimie"}}, {"canonical_name": "Norway", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "norge", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Norge", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Norge"], "contexts": ["country mentioned in a travelogue"]}, {"entity_id": "norway", "book_id": "kosmos_humboldt_1845", "name": "Norway", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Norway"], "contexts": ["Northern hemisphere location", "country in Northern hemisphere"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Norge", "target_book": "kosmos_humboldt_1845", "target_name": "Norway", "similarity": 0.966}], "id": 3742, "stable_key": "clu_6c1b17363b16ece0-2", "ground_truth": {"modern_name": "Norway", "confidence": "high", "type": "place", "country": "Norway", "wikidata_id": "Q184224", "wikidata_description": "species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Brown%20rat", "wikipedia_extract": "The brown rat (Rattus norvegicus), also known as the common rat, street rat, sewer rat, wharf rat, Hanover rat, Norway rat and Norwegian rat, is a widespread, common species of rat. One of the largest muroids, it is a brown or grey rodent with a body length of up to 28 cm (11 in) long, and a tail slightly shorter than that. It weighs between 140 and 500 g (4.9 and 17.6 oz). Thought to have originated in northern China and neighbouring areas, it has now spread to all continents except Antarctica, and is the dominant rat in Europe and much of North America, having become naturalised across the world. With rare exceptions, the brown rat lives wherever humans live, particularly in urban areas. They are omnivorous, reproduce rapidly, and can be a vector for several human diseases."}}, {"canonical_name": "fresh water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "fresh_water", "book_id": "kosmos_humboldt_1845", "name": "fresh water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["fresh water"], "contexts": ["water not saline", "water without significant salt"]}, {"entity_id": "fresh_water", "book_id": "connexion_physical_sciences_somerville_1858", "name": "fresh water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["fresh water"], "contexts": ["water with low salt concentration", "contact with earth generates positive electricity"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "fresh water", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fresh water", "similarity": 1.0}], "id": 3743, "stable_key": "clu_7fa3be36be0c0dd9", "ground_truth": {"modern_name": "Freshwater", "confidence": "high", "type": "concept", "wikidata_id": "Q5503092", "wikidata_description": "human settlement in Conception Bay, Newfoundland and Labrador, Canada"}}, {"canonical_name": "J. Pereira", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "pereira", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pereira", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Pereira"], "contexts": ["colonel who made temperature observations"]}, {"entity_id": "j__pereira", "book_id": "coloquios_da_orta_1563", "name": "J. Pereira", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["J. Pereira", "Jonatham Pereira", "Jonathan Pereira"], "contexts": ["proposed name for a plant", "modern scholar of cardamom"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pereira", "target_book": "coloquios_da_orta_1563", "target_name": "J. Pereira", "similarity": 0.853}], "id": 3744, "stable_key": "clu_ebdd5d6658b181a4", "ground_truth": {"modern_name": "Jonathan Pereira", "confidence": "high", "type": "person", "birth_year": 1804, "death_year": 1858, "description": "British pharmacologist and chemist, author of 'The Elements of Materia Medica'", "note": "The context 'proposed name for a plant' refers to his work in botany and materia medica. The 'colonel who made temperature observations' is a less certain association but fits with a scientist of that era.", "wikidata_id": "Q385683", "wikidata_description": "British pharmacologist (1804-1853)"}}, {"canonical_name": "Eastern Europe", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "europe_orientale", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Europe orientale", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Europe orientale"], "contexts": ["region with salt deposits"]}, {"entity_id": "eastern_europe", "book_id": "kosmos_humboldt_1845", "name": "Eastern Europe", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Eastern Europe", "eastern Europe"], "contexts": ["geographic region", "location of experiments"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Europe orientale", "target_book": "kosmos_humboldt_1845", "target_name": "Eastern Europe", "similarity": 0.947}], "id": 3745, "stable_key": "clu_cb34b2b8563887cb", "ground_truth": {"modern_name": "Eastern Europe", "confidence": "high", "type": "place", "country": "Europe"}}, {"canonical_name": "Barnaul", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "barnaul", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Barnaul", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Barnaul"], "contexts": ["city for observation"]}, {"entity_id": "barnaul", "book_id": "kosmos_humboldt_1845", "name": "Barnaul", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Barnaul"], "contexts": ["location of magnetic station", "city on magnetic stations line"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Barnaul", "target_book": "kosmos_humboldt_1845", "target_name": "Barnaul", "similarity": 1.0}], "id": 3746, "stable_key": "clu_897790439691117d", "ground_truth": {"modern_name": "Barnaul", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q6014", "wikidata_description": "city in eastern Russia", "wikipedia_url": "https://en.wikipedia.org/wiki/Barnaul", "wikipedia_extract": "Barnaul (Russian: \u0411\u0430\u0440\u043d\u0430\u0443\u0301\u043b, IPA: [b\u0259rn\u0250\u02c8ul] ) is the largest city and administrative centre of Altai Krai, Russia, located at the confluence of the Barnaulka and Ob rivers in the West Siberian Plain. As of the 2021 census, its population was 630,877, making it the 20th-largest city in Russia and the fourth-largest in the Siberian Federal District. Located in the south of western Siberia on the left bank of the Ob River, Barnaul is a major transport, industrial, cultural, medical and educational hub of Siberia. Barnaul was founded by the wealthy Demidov family, who intended to develop the production of copper and silver, which continued after the factories were taken over by the Crown. Barnaul became a major centre of silver production in Russia. Barnaul was granted city status in 1771."}}, {"canonical_name": "cord", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "cord", "book_id": "principles_of_psychology_james_1890", "name": "cord", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["cord"], "contexts": ["spinal cord", "part of the central nervous system"]}, {"entity_id": "corde", "book_id": "polyanthea_medicinal", "name": "Corde", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Corde"], "contexts": ["the heart"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "cord", "target_book": "polyanthea_medicinal", "target_name": "Corde", "similarity": 0.887}], "id": 3747, "stable_key": "clu_636f092e86daff7c-3", "ground_truth": {"modern_name": "Spinal cord", "confidence": "high", "type": "object", "note": "While 'spinal column' and 'spinal segment' are related, the primary referent is the 'spinal cord' given the frequency and context of 'central nervous system pathway'.", "wikidata_id": "Q2997445", "wikidata_description": "body organ", "wikipedia_url": "https://en.wikipedia.org/wiki/Anterior%20grey%20column", "description": "The central nerve pathway connecting the brain to the body.", "wikipedia_extract": "The spinal cord is a long, thin, tubular structure made up of nervous tissue that extends from the medulla oblongata in the lower brainstem to the lumbar region of the vertebral column (backbone) of vertebrate animals. The center of the spinal cord is hollow and contains a structure called the central canal, which contains cerebrospinal fluid. The spinal cord is also covered by the meninges and enclosed by the neural arches. Together, the brain and spinal cord make up the central nervous system. In humans, the spinal cord is a continuation of the brainstem and anatomically begins at the occipital bone, passing out of the foramen magnum and then enters the spinal canal at the beginning of the cervical vertebrae. The spinal cord extends down to between the first and second lumbar vertebrae, where it tapers to become the cauda equina."}}, {"canonical_name": "distinguish", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "distinguish", "book_id": "principles_of_psychology_james_1890", "name": "distinguish", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["distinguish"], "contexts": ["recognize differences between objects", "mental act of differentiating"]}, {"entity_id": "distin\u00e7am", "book_id": "coloquios_da_orta_1563", "name": "distin\u00e7am", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["distin\u00e7am"], "contexts": ["difference in naming substances"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "distinguish", "target_book": "coloquios_da_orta_1563", "target_name": "distin\u00e7am", "similarity": 0.903}], "id": 3748, "stable_key": "clu_3a000fc08f1d0f7f", "ground_truth": {"modern_name": "distinguish", "confidence": "high", "type": "concept"}}, {"canonical_name": "world", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "world", "book_id": "principles_of_psychology_james_1890", "name": "world", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["world", "World"], "contexts": ["the earth and its inhabitants", "philosophical concept of reality"]}, {"entity_id": "world", "book_id": "first_principles_spencer_1862", "name": "world", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["world"], "contexts": ["external reality interacting with mind"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "world", "target_book": "first_principles_spencer_1862", "target_name": "world", "similarity": 1.0}], "id": 3749, "stable_key": "clu_77ef716fcd90ab0a", "ground_truth": {"modern_name": "world", "confidence": "high", "type": "concept"}}, {"canonical_name": "stream", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "stream", "book_id": "principles_of_psychology_james_1890", "name": "stream", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["stream"], "contexts": ["continuous flow", "continuous flow of thought"]}, {"entity_id": "stream", "book_id": "first_principles_spencer_1862", "name": "stream", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["stream"], "contexts": ["smooth stream on whose surface undulations die away"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "stream", "target_book": "first_principles_spencer_1862", "target_name": "stream", "similarity": 1.0}], "id": 3750, "stable_key": "clu_09cf89c95ff8cc7e", "ground_truth": {"modern_name": "stream", "confidence": "high", "type": "place"}}, {"canonical_name": "abstract", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "abstract", "book_id": "principles_of_psychology_james_1890", "name": "abstract", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["abstract"], "contexts": ["dealing with consciousness in isolation", "concept separated from particulars"]}, {"entity_id": "abstract", "book_id": "first_principles_spencer_1862", "name": "abstract", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["abstract"], "contexts": ["non-physical concepts"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "abstract", "target_book": "first_principles_spencer_1862", "target_name": "abstract", "similarity": 1.0}], "id": 3751, "stable_key": "clu_5c2330b29467e88e", "ground_truth": {"modern_name": "abstract concept", "confidence": "high", "type": "concept", "note": "This refers to abstract ideas or thinking, rather than a specific object or substance.", "wikidata_id": "Q2822059", "wikidata_description": "type of thinking"}}, {"canonical_name": "spiritual", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "spiritual", "book_id": "principles_of_psychology_james_1890", "name": "spiritual", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["SPIRITUAL", "spiritual"], "contexts": ["relating to the non-physical aspect of being", "spiritual constituents of the 'Me'"]}, {"entity_id": "spiritualistic", "book_id": "first_principles_spencer_1862", "name": "spiritualistic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["spiritualistic"], "contexts": ["philosophical view of spirit as primary"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "spiritual", "target_book": "first_principles_spencer_1862", "target_name": "spiritualistic", "similarity": 0.894}], "id": 3752, "stable_key": "clu_f576b70526c15545-3", "ground_truth": {"modern_name": "Spiritualists", "confidence": "high", "type": "concept", "note": "Refers to adherents of Spiritualism, a belief system focusing on communication with spirits.", "wikidata_id": "Q829348", "wikidata_description": "19th century religious movement based on the belief that one can communicate with the spirits of the dead"}}, {"canonical_name": "Homer", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "homer", "book_id": "principles_of_psychology_james_1890", "name": "Homer", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["Homer"], "contexts": ["ancient Greek epic poet", "ancient poet, cited for memory of grief"]}, {"entity_id": "homer", "book_id": "first_principles_spencer_1862", "name": "Homer", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Homer"], "contexts": ["ancient poet, mentioned for winnowing example"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Homer", "target_book": "first_principles_spencer_1862", "target_name": "Homer", "similarity": 1.0}], "id": 3753, "stable_key": "clu_e749e6acf7753b85", "ground_truth": {"modern_name": "Homer", "confidence": "high", "type": "person", "description": "Ancient Greek epic poet, cited as an authority.", "wikidata_id": "Q6691", "wikidata_description": "reputed author of the Iliad and the Odyssey"}}, {"canonical_name": "Cause and Effect", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "cause_and_effect", "book_id": "principles_of_psychology_james_1890", "name": "Cause and Effect", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["CAUSE and EFFECT", "Cause and Effect", "cause and effect"], "contexts": ["relationship between action and consequence", "quality of association between ideas"]}, {"entity_id": "cause_and_effect", "book_id": "first_principles_spencer_1862", "name": "cause and effect", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cause and effect"], "contexts": ["relationship between action and result"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Cause and Effect", "target_book": "first_principles_spencer_1862", "target_name": "cause and effect", "similarity": 0.968}], "id": 3754, "stable_key": "clu_4c6b51045c026813-2", "ground_truth": {"modern_name": "Causality", "confidence": "high", "type": "concept", "wikidata_id": "Q1149766", "wikidata_description": "conceptual link between natural phenomena that temporally follow one another because one is the cause of the other", "wikipedia_url": "https://en.wikipedia.org/wiki/Causality%20%28physics%29", "wikipedia_extract": "In physics,  causality, requires the cause of an event to be in the past light cone of the result and to be ultimately reducible to fundamental interactions. Similarly, a cause cannot have an effect outside its future light cone. Macroscopic vs microscopic causality Causality can be defined macroscopically, at the level of human observers, or microscopically, for fundamental events at the atomic level. The strong causality principle forbids information transfer faster than the speed of light; the weak causality principle operates at the microscopic level and need not lead to information transfer. Physical models can obey the weak principle without obeying the strong version. In the algebraic formulation of quantum field theory, microscopic causality is taken as an axiom, formulated technically but equivalent to the idea that two measurements in different places at the same time cannot affect each other."}}, {"canonical_name": "Wolfe", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "wolfe", "book_id": "principles_of_psychology_james_1890", "name": "Wolfe", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Wolfe"], "contexts": ["experimenter on recognition", "conducted experiments on recognition"]}, {"entity_id": "wolphio", "book_id": "polyanthea_medicinal", "name": "Wolphio", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Wolphio"], "contexts": ["early modern medical author"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Wolfe", "target_book": "polyanthea_medicinal", "target_name": "Wolphio", "similarity": 0.878}], "id": 3755, "stable_key": "clu_51539c529b948444", "ground_truth": {"modern_name": "Christoph Wirsung", "confidence": "medium", "type": "person", "birth_year": 1595, "death_year": 1667, "description": "German physician and alchemist, noted for pancreatic duct discovery.", "note": "The mention of 'Wolphio' is likely a misspelling or variant of Wirsung.  James might be referencing a psychologist discussing historical concepts, potentially linking to earlier medical authors like Wirsung.", "wikidata_id": "Q1086119", "wikidata_description": "German pharmacist and translator"}}, {"canonical_name": "violin", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "violin", "book_id": "principles_of_psychology_james_1890", "name": "violin", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["violin"], "contexts": ["musical instrument", "musical instrument held in the hand"]}, {"entity_id": "violin", "book_id": "connexion_physical_sciences_somerville_1858", "name": "violin", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["violin"], "contexts": ["instrument used to excite vibrations", "stringed instrument"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "violin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "violin", "similarity": 0.894}], "id": 3756, "stable_key": "clu_1e4fde42cafa92b0", "ground_truth": {"modern_name": "violin", "confidence": "high", "type": "object", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "Le Violon d'Ingres (French for Ingres' Violin) is a black-and-white photograph created by American visual artist Man Ray in 1924. It is one of his best-known photographs and of surrealist photography. The picture was first published in the Surrealist magazine Litt\u00e9rature in June 1924. It shows model Kiki de Montparnasse from the back, nude to below her waist, with two f-holes painted on to draw similarities between the shape of her body and a violin. The photograph takes its name from a popular French expression, le violon d'Ingres, which means a hobby, in reference to the fact that the French neoclassical painter Jean-Auguste-Dominique Ingres used to play the violin as a pastime when he was not painting. Man Ray admired Ingres's work and he drew inspiration from his painting The Valpin\u00e7on Bather (1808) for this photograph.", "wikipedia_url": "https://en.wikipedia.org/wiki/Le_Violon_d'Ingres"}}, {"canonical_name": "animal kingdom", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "animal_kingdom", "book_id": "principles_of_psychology_james_1890", "name": "animal kingdom", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["animal kingdom"], "contexts": ["all animal life", "shared with man, general animal life"]}, {"entity_id": "animal_kingdom", "book_id": "kosmos_humboldt_1845", "name": "animal kingdom", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["animal kingdom"], "contexts": ["all animal life forms", "realm of animals"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "animal kingdom", "target_book": "kosmos_humboldt_1845", "target_name": "animal kingdom", "similarity": 1.0}], "id": 3757, "stable_key": "clu_e5ce0a4beba82a94", "ground_truth": {"modern_name": "Animal Kingdom", "confidence": "high", "type": "concept", "wikidata_id": "Q99427839", "wikidata_description": "subject category of the 20th Century Press Archives", "note": "Refers to the collective classification of all animal life."}}, {"canonical_name": "Shakespeare", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "shakespeare", "book_id": "principles_of_psychology_james_1890", "name": "Shakespeare", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Shakespeare"], "contexts": ["author of Hamlet", "subject of spiritual history"]}, {"entity_id": "shakespeare", "book_id": "first_principles_spencer_1862", "name": "Shakespeare", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Shakespeare"], "contexts": ["poet and playwright", "poetical anticipation of disappearance"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Shakespeare", "target_book": "first_principles_spencer_1862", "target_name": "Shakespeare", "similarity": 0.799}], "id": 3758, "stable_key": "clu_58a097c0da75f015", "ground_truth": {"modern_name": "William Shakespeare", "confidence": "high", "type": "person", "birth_year": 1564, "death_year": 1616, "description": "English playwright, poet, and actor, widely regarded as the greatest writer in the English language.", "wikidata_id": "Q18911456", "wikidata_description": "English physician, poet, and war veteran"}}, {"canonical_name": "sense-impressions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "sense-impressions", "book_id": "principles_of_psychology_james_1890", "name": "sense-impressions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["sense-impressions"], "contexts": ["sensory input", "sensory input to the mind"]}, {"entity_id": "sense-impression", "book_id": "principles_of_psychology_james_1890", "name": "sense-impression", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sense-impression"], "contexts": ["sensory input from the environment"]}, {"entity_id": "sense-impressions", "book_id": "first_principles_spencer_1862", "name": "sense-impressions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sense-impressions"], "contexts": ["sensory data received by the mind"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "sense-impressions", "target_book": "first_principles_spencer_1862", "target_name": "sense-impressions", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sense-impression", "target_book": "first_principles_spencer_1862", "target_name": "sense-impressions", "similarity": 0.935}], "id": 3759, "stable_key": "clu_f260270ca0cb99f0", "ground_truth": {"modern_name": "sensory input", "confidence": "high", "type": "concept", "wikidata_id": "Q60143327", "wikidata_description": "scientific article published on 16 November 2003"}}, {"canonical_name": "percepts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "percepts", "book_id": "principles_of_psychology_james_1890", "name": "percepts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["percepts"], "contexts": ["consciousness of complex objects, vivid", "mental impressions of sensory data"]}, {"entity_id": "perceptions", "book_id": "first_principles_spencer_1862", "name": "perceptions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["perceptions"], "contexts": ["awareness of sensory information"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "percepts", "target_book": "first_principles_spencer_1862", "target_name": "perceptions", "similarity": 0.962}