", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Portugais-Br\u00e9siliens"], "contexts": ["people of Portuguese-Brazilian origin", "Portuguese-Brazilians who detached Cisplatine"]}, {"entity_id": "portugueses", "book_id": "historia_medicinal_monardes_1574", "name": "Portugueses", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Portugueses", "Portuguezes", "portugueses"], "contexts": ["Portuguese people who brought goods", "the Portuguese brought to Spain"]}, {"entity_id": "portuguezes", "book_id": "coloquios_da_orta_1563", "name": "Portuguezes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 79, "variants": ["Portuguezes", "Portugueses", "Portuguezas", "portugueses", "portuguez velho", "portuguezas", "portuguezcs", "portuguezea", "portuguezes"], "contexts": ["people who call alo\u00e9s 'a^etTe'", "traders of amber"]}, {"entity_id": "portuguezes", "book_id": "polyanthea_medicinal", "name": "Portuguezes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Portuguezes"], "contexts": ["nationality", "people from Portugal"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Portugais-Br\u00e9siliens", "target_book": "historia_medicinal_monardes_1574", "target_name": "Portugueses", "similarity": 0.881}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Portugais-Br\u00e9siliens", "target_book": "coloquios_da_orta_1563", "target_name": "Portuguezes", "similarity": 0.873}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Portugais-Br\u00e9siliens", "target_book": "polyanthea_medicinal", "target_name": "Portuguezes", "similarity": 0.873}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Portugueses", "target_book": "coloquios_da_orta_1563", "target_name": "Portuguezes", "similarity": 0.977}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Portugueses", "target_book": "polyanthea_medicinal", "target_name": "Portuguezes", "similarity": 0.977}, {"source_book": "coloquios_da_orta_1563", "source_name": "Portuguezes", "target_book": "polyanthea_medicinal", "target_name": "Portuguezes", "similarity": 1.0}], "id": 349, "stable_key": "clu_1dae12ef4158555e", "ground_truth": {"modern_name": "Portuguese people", "confidence": "high", "type": "concept", "note": "Refers to people of Portuguese origin or nationality, particularly in historical contexts of exploration and trade.", "wikidata_id": "Q178630", "wikidata_description": "people from or residents of Portugal", "wikipedia_url": "https://en.wikipedia.org/wiki/Portuguese%20people", "wikipedia_extract": "The Portuguese people (Portuguese: Portugueses \u2013 masculine \u2013 or Portuguesas) are a Romance-speaking ethnic group and nation indigenous to Portugal, a country that occupies the west side of the Iberian Peninsula in south-west Europe, who share culture, ancestry and language. The Portuguese state began with the founding of the County of Portugal in 868. Following the Battle of S\u00e3o Mamede (1128), Portugal gained international recognition as a kingdom through the Treaty of Zamora and the papal bull Manifestis Probatum. This Portuguese state paved the way for the Portuguese people to unite as a nation. The Portuguese explored distant lands previously unknown to Europeans\u2014in the Americas, Africa, Asia and Oceania (southwest Pacific Ocean). In 1415, with the conquest of Ceuta, the Portuguese took a significant role in the Age of Discovery, which culminated in a colonial empire."}}, {"canonical_name": "Deos", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 86, "members": [{"entity_id": "dieux", "book_id": "epoques_nature_buffon_1778", "name": "dieux", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["dieux"], "contexts": ["gods, deities"]}, {"entity_id": "deos", "book_id": "coloquios_da_or