: "Refers to the continent of Africa and its associated regions and people."}}, {"canonical_name": "Head", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 7, "total_mentions": 89, "members": [{"entity_id": "head", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Head", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Head"], "contexts": ["can be intoxicated by medicine"]}, {"entity_id": "head", "book_id": "english_physician_1652", "name": "Head", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 67, "variants": ["Head", "Heads", "head", "heads"], "contexts": ["body part ruled by Aries", "body part washed for comfort"]}, {"entity_id": "head", "book_id": "origin_of_species_darwin_1859", "name": "head", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["head"], "contexts": ["elongated with long limbs", "child's head shaped by mother's pelvis"]}, {"entity_id": "head", "book_id": "principles_of_psychology_james_1890", "name": "head", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 11, "variants": ["head"], "contexts": ["part of the body containing the brain", "least rigid part of body, moves during piano playing"]}, {"entity_id": "head", "book_id": "kosmos_humboldt_1845", "name": "head", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["head"], "contexts": ["preserved part of Cephalopodes"]}, {"entity_id": "head", "book_id": "polyanthea_medicinal", "name": "head", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["head"], "contexts": ["part of the body"]}, {"entity_id": "head", "book_id": "first_principles_spencer_1862", "name": "head", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["head"], "contexts": ["anterior part of body", "anterior part of the body containing the brain"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Head", "target_book": "english_ph