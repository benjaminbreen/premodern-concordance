": "kosmos_humboldt_1845", "source_name": "waves", "target_book": "first_principles_spencer_1862", "target_name": "waves", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Waves", "target_book": "first_principles_spencer_1862", "target_name": "waves", "similarity": 0.957}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "wave", "target_book": "first_principles_spencer_1862", "target_name": "waves", "similarity": 0.89}], "id": 1084, "stable_key": "clu_3e4ea56f43f8d4c7", "ground_truth": {"modern_name": "Wave", "confidence": "high", "type": "concept", "wikidata_id": "Q58966964", "wikidata_description": "scientific article published in Nature"}}, {"canonical_name": "curar", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "cura", "book_id": "historia_medicinal_monardes_1574", "name": "cura", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["cura"], "contexts": ["cure, of diseases using cooled beverages"]}, {"entity_id": "cura", "book_id": "coloquios_da_orta_1563", "name": "cura", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 7, "variants": ["cura", "Cura", "curar", "curas"], "contexts": ["type of distilled spirit", "Sanskrit word for palm sap"]}, {"entity_id": "curar", "book_id": "polyanthea_medicinal", "name": "curar", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 9, "variants": ["curar", "curarem", "curas"], "contexts": ["act of healing", "can cure many diseases"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "cura", "target_book": "coloquios_da_orta_1563", "target_name": "cura", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "cura", "target_book": "polyanthea_medicinal", "target_name": "curar", "similarity": 0.896}, {"source_book": "coloquios_da_orta_1563", "source_name": "cura", "target_book": "polyanthea_medicinal", "target_name": "curar", "similarity": 0.896}], "id": 1085, "stable_key": "clu_c2bcb4ae6aec6f3f", "ground_truth": {"modern_name": "To cure", "confidence": "high", "type": "concept", "description": "The act of healing or restoring to health.", "note": "'curar' and its variations relate to the act of healing.", "wikipedia_extract": "The Cure are an English rock band formed in Crawley in 1976 by Robert Smith (vocals, guitar) and Lol Tolhurst (drums). As of 2026, the band's line-up comprises Smith, Simon Gallup (bass), Roger O'Donnell (keyboards), Jason Cooper (drums) and Reeves Gabrels (guitar). Smith has remained the only constant member throughout numerous line-up changes since the band's formation. Three Imaginary Boys (the Cure's 1979 debut album) and several early singles placed the band at the forefront of the emerging post-punk and new wave movements that were gaining prominence in the United Kingdom. The band adopted an increasingly dark and tormented style beginning with their second album Seventeen Seconds (1980), which had a strong influence on the emerging genre of gothic rock. After the release of their fourth album Pornography (1982), Smith started to introduce more pop into the band's music."}}, {"canonical_name": "CuBEBAS", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "cubebas", "book_id": "coloquios_da_orta_1563", "name": "CuBEBAS", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["CuBEBAS", "Cubebas", "cubebas", "cubebe"], "contexts": ["spice discussed in dialogue", "spice from a tree"]}, {"entity_id": "cubeba", "book_id": "ricettario_fiorentino_1597", "name": "cubeba", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cubeba"], "contexts": ["plant similar to Amomo"]}, {"entity_id": "cubebas", "book_id": "polyanthea_medicinal", "name": "cubebas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["cubebas", "Cubebas"], "contexts": ["cubeb pepper, used as powder", "cubeb pepper, ingredient for wine remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "CuBEBAS", "target_book": "polyanthea_medicinal", "target_name": "cubebas", "similarity": 0.785}, {"source_book": "ricettario_fiorentino_1597", "source_name": "cubeba", "target_book": "polyanthea_medicinal", "target_name": "cubebas", "similarity": 0.913}], "id": 1086, "stable_key": "clu_562cddeef12e48ef", "ground_truth": {"modern_name": "Cubeb pepper", "confidence": "high", "type": "plant", "linnaean": "Piper cubeba", "family": "Piperaceae"}}, {"canonical_name": "Celidonia", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "celidonia", "book_id": "coloquios_da_orta_1563", "name": "celidonia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["celidonia", "celidonia maior", "cilidonia"], "contexts": ["plant possibly confused with memiran", "plant mentioned with numbers"]}, {"entity_id": "celidonia", "book_id": "ricettario_fiorentino_1597", "name": "Celidonia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Celidonia"], "contexts": ["herb used in preparations"]}, {"entity_id": "celidonia", "book_id": "polyanthea_medicinal", "name": "Celidonia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 11, "variants": ["Celidonia", "Celidonium", "celidonia"], "contexts": ["celandine, ingredient for ointment", "herb used in eye collirium"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "celidonia", "target_book": "ricettario_fiorentino_1597", "target_name": "Celidonia", "similarity": 0.987}, {"source_book": "coloquios_da_orta_1563", "source_name": "celidonia", "target_book": "polyanthea_medicinal", "target_name": "Celidonia", "similarity": 0.987}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Celidonia", "target_book": "polyanthea_medicinal", "target_name": "Celidonia", "similarity": 1.0}], "id": 1087, "stable_key": "clu_78ce2cd18b6426d7", "ground_truth": {"modern_name": "Celandine", "confidence": "high", "type": "plant", "linnaean": "Chelidonium majus", "family": "Papaveraceae", "description": "Herb with yellow flowers, used in traditional medicine, especially for eyes.", "wikipedia_extract": "Chelidonium majus, the greater celandine, is a perennial herbaceous flowering plant in the poppy family Papaveraceae. One of two species in the genus Chelidonium, it is native to Europe and western Asia and introduced widely in North America. The plant known as lesser celandine (Ficaria verna) is not closely related, as it belongs to the buttercup family Ranunculaceae. Greater celandine is a perennial herbaceous plant with an erect habit, and reaches 30\u2013120 cm (12\u201347 in) high. The blue-green leaves are pinnate with lobed and wavy margins, up to 30 cm (12 in) long. When injured, the plant exudes a yellow to orange latex."}}, {"canonical_name": "zedoaria", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "zedoaria", "book_id": "coloquios_da_orta_1563", "name": "zedoaria", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["zedoaria", "ZEDOARIA", "Zedor\u00eda", "zedoar\u00eda"], "contexts": ["subject of colloquy", "plant with debated identity"]}, {"entity_id": "zedoaria", "book_id": "ricettario_fiorentino_1597", "name": "Zedoaria", "category": "PLANT", "subcategory": "ROOT", "count": 5, "variants": ["Zedoaria", "Zedoana"], "contexts": ["zedoary root", "zedoary, a medicinal root"]}, {"entity_id": "zedosria", "book_id": "ricettario_fiorentino_1597", "name": "Zedosria", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Zedosria"], "contexts": ["ingredient in a preparation"]}, {"entity_id": "zedoaria", "book_id": "polyanthea_medicinal", "name": "zedoaria", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["zedoaria"], "contexts": ["root used in a purgative", "zedoary"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "zedoaria", "target_book": "ricettario_fiorentino_1597", "target_name": "Zedoaria", "similarity": 0.818}, {"source_book": "coloquios_da_orta_1563", "source_name": "zedoaria", "target_book": "ricettario_fiorentino_1597", "target_name": "Zedosria", "similarity": 0.91}, {"source_book": "coloquios_da_orta_1563", "source_name": "zedoaria", "target_book": "polyanthea_medicinal", "target_name": "zedoaria", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Zedoaria", "target_book": "polyanthea_medicinal", "target_name": "zedoaria", "similarity": 0.818}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Zedosria", "target_book": "polyanthea_medicinal", "target_name": "zedoaria", "similarity": 0.91}], "id": 1088, "stable_key": "clu_24328416e681780e", "ground_truth": {"modern_name": "Zedoary", "confidence": "high", "type": "plant", "linnaean": "Curcuma zedoaria", "family": "Zingiberaceae", "description": "A rhizomatous herbaceous perennial plant in the ginger family.", "wikipedia_extract": "Curcuma zedoaria (zedoary /\u02c8z\u025bd\u0259\u028a\u0259r\u026a/, white turmeric, or temu putih) is a perennial herb and member of the genus Curcuma, family Zingiberaceae. The plant is native to South Asia and Southeast Asia but is now naturalized in other places including the US state of Florida. Zedoary was one of the ancient food plants of the Austronesian peoples. They were spread during prehistoric times to the Pacific Islands and Madagascar during the Austronesian expansion (c.\u20093000 BCE). Its use as a spice in the West today is extremely rare, having been replaced by ginger, and to a lesser extent, yellow turmeric. The name zedoary derives from Persian via Arabic and Latin."}}, {"canonical_name": "Axis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "axis", "book_id": "kosmos_humboldt_1845", "name": "axis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["axis"], "contexts": ["imaginary line through a planet's center"]}, {"entity_id": "axis", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Axis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 9, "variants": ["axis", "Axis"], "contexts": ["line of rotation", "line around which something rotates"]}, {"entity_id": "vertebrate_axis", "book_id": "first_principles_spencer_1862", "name": "vertebrate axis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["vertebrate axis"], "contexts": ["fundamental characteristic of mature animals"]}, {"entity_id": "axes", "book_id": "kosmos_humboldt_1845", "name": "axes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["axes"], "contexts": ["lines of symmetry for celestial bodies", "directions of expansion in crystals"]}, {"entity_id": "axes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Axes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Axes"], "contexts": ["imaginary lines for rotation"]}, {"entity_id": "axis", "book_id": "first_principles_spencer_1862", "name": "axis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["axis"], "contexts": ["imaginary line for rotation", "central line of rotation for a top"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "axis", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Axis", "similarity": 0.995}, {"source_book": "kosmos_humboldt_1845", "source_name": "axis", "target_book": "first_principles_spencer_1862", "target_name": "vertebrate axis", "similarity": 0.929}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Axis", "target_book": "first_principles_spencer_1862", "target_name": "vertebrate axis", "similarity": 0.923}, {"source_book": "kosmos_humboldt_1845", "source_name": "axes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Axes", "similarity": 0.994}, {"source_book": "kosmos_humboldt_1845", "source_name": "axes", "target_book": "first_principles_spencer_1862", "target_name": "axis", "similarity": 0.91}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Axes", "target_book": "first_principles_spencer_1862", "target_name": "axis", "similarity": 0.893}], "id": 1089, "stable_key": "clu_b48b18fb4720e215", "ground_truth": {"modern_name": "Axis of rotation", "confidence": "high", "type": "concept", "note": "The context refers to both astronomical/geometric axes and biological axes, but the overarching concept is an imaginary line around which rotation occurs or a fundamental organizational line.", "wikidata_id": "Q2995427", "wikidata_description": "motion in space when there is fixed line of points", "wikipedia_url": "https://en.wikipedia.org/wiki/Rotation%20around%20a%20fixed%20axis", "wikipedia_extract": "Rotation around a fixed axis or axial rotation is a special case of rotational motion around an axis of rotation fixed, stationary, or static in three-dimensional space. This type of motion excludes the possibility of the instantaneous axis of rotation changing its orientation and cannot describe such phenomena as wobbling or precession. According to Euler's rotation theorem, simultaneous rotation along a number of stationary axes at the same time is impossible; if two rotations are forced at the same time, a new axis of rotation will result. This concept assumes that the rotation is also stable, such that no torque is required to keep it going. The kinematics and dynamics of rotation around a fixed axis of a rigid body are mathematically much simpler than those for free rotation of a rigid body; they are entirely analogous to those of linear motion along a single fixed direction, which is not true for free rotation of a rigid body. The expressions for the kinetic energy of the object, and for the forces on the parts of the object, are also simpler for rotation around a fixed axis, than for general rotational motion."}}, {"canonical_name": "Carlos V.", "category": "PERSON", "subcategory": "PATRON", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "imperador_carlos_v", "book_id": "coloquios_da_orta_1563", "name": "Imperador Carlos V", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Imperador Carlos V"], "contexts": ["Emperor who sold rights"]}, {"entity_id": "carlos_quinto", "book_id": "coloquios_da_orta_1563", "name": "Carlos quinto", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Carlos quinto"], "contexts": ["emperor who used the root"]}, {"entity_id": "carlos_v_", "book_id": "polyanthea_medicinal", "name": "Carlos V.", "category": "PERSON", "subcategory": "PATRON", "count": 8, "variants": ["Carlos V.", "Carlos II", "Carlos II.", "Carlos VII"], "contexts": ["Emperor who rewarded translation of Dioscorides", "Emperor whose soldiers were treated"]}, {"entity_id": "carlos_v", "book_id": "coloquios_da_orta_1563", "name": "Carlos V", "category": "PERSON", "subcategory": "PATRON", "count": 5, "variants": ["Carlos V"], "contexts": ["Holy Roman Emperor and King of Spain", "emperor who used the stone"]}, {"entity_id": "charles_v_", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Charles V.", "category": "PERSON", "subcategory": "PATRON", "count": 2, "variants": ["Charles V."], "contexts": ["Emperor during comet observation", "Emperor, observations on comets made in his reign"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Imperador Carlos V", "target_book": "polyanthea_medicinal", "target_name": "Carlos V.", "similarity": 0.912}, {"source_book": "coloquios_da_orta_1563", "source_name": "Carlos quinto", "target_book": "polyanthea_medicinal", "target_name": "Carlos V.", "similarity": 0.926}, {"source_book": "coloquios_da_orta_1563", "source_name": "Carlos V", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Charles V.", "similarity": 0.896}], "id": 1090, "stable_key": "clu_38a5f3745a07c96f", "ground_truth": {"modern_name": "Charles V, Holy Roman Emperor", "confidence": "high", "type": "person", "birth_year": 1500, "death_year": 1558, "description": "Holy Roman Emperor and King of Spain"}}, {"canonical_name": "naturalist", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "naturaliste", "book_id": "medecine_experimentale_bernard_1865", "name": "naturaliste", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 5, "variants": ["naturaliste"], "contexts": ["natural scientist", "researcher of principles"]}, {"entity_id": "le_naturaliste", "book_id": "medecine_experimentale_bernard_1865", "name": "le naturaliste", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["le naturaliste"], "contexts": ["scientist studying natural history"]}, {"entity_id": "naturalist", "book_id": "origin_of_species_darwin_1859", "name": "naturalist", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 7, "variants": ["naturalist"], "contexts": ["expert in natural world", "scientist studying nature"]}, {"entity_id": "naturales", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "naturales", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["naturales", "Naturales"], "contexts": ["indigenous people, their knowledge of the herb", "held in high esteem by natives"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "naturaliste", "target_book": "origin_of_species_darwin_1859", "target_name": "naturalist", "similarity": 0.984}, {"source_book": "medecine_experimentale_bernard_1865", "sour