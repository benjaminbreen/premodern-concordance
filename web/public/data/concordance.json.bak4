gory": "OTHER_DISEASE", "count": 1, "variants": ["mistake"], "contexts": ["error in judgment or action"]}, {"entity_id": "errors", "book_id": "principles_of_psychology_james_1890", "name": "errors", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["errors"], "contexts": ["mistakes in judgment or perception"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "error", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Errors", "similarity": 0.943}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "error", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "mistake", "similarity": 0.949}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "error", "target_book": "principles_of_psychology_james_1890", "target_name": "errors", "similarity": 0.949}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Errors", "target_book": "principles_of_psychology_james_1890", "target_name": "errors", "similarity": 0.992}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "mistake", "target_book": "principles_of_psychology_james_1890", "target_name": "errors", "similarity": 0.895}], "id": 1393, "stable_key": "clu_90602413dad376cc", "ground_truth": {"wikipedia_extract": "An error (from the Latin err\u0101re, meaning 'to wander') is an inaccurate or incorrect action, thought, or judgement. In statistics, \"error\" refers to the difference between the value which has been computed and the correct value. An error could result in failure or in a deviation from the intended performance or behavior. One reference differentiates between \"error\" and \"mistake\" as follows: An 'error' is a deviation from accuracy or correctness. A 'mistake' is an error caused by a fault: the fault being misjudgment, carelessness, or forgetfulness. Now, say that I run a stop sign because I was in a hurry, and wasn't concentrating, and the police stop me, that is a mistake."}}, {"canonical_name": "Fontanus", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "fontana", "book_id": "medecine_experimentale_bernard_1865", "name": "Fontana", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Fontana"], "contexts": ["researcher who used poisons"]}, {"entity_id": "fontana", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Fontana", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Fontana"], "contexts": ["inventor of eudiometer"]}, {"entity_id": "fontanus", "book_id": "polyanthea_medicinal", "name": "Fontanus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Fontanus", "Fontech", "Fontecha"], "contexts": ["cited for medical practice", "early modern medical scholar cited"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Fontana", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Fontana", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Fontana", "target_book": "polyanthea_medicinal", "target_name": "Fontanus", "similarity": 0.943}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Fontana", "target_book": "polyanthea_medicinal", "target_name": "Fontanus", "similarity": 0.943}], "id": 1394, "stable_key": "clu_8011de9aac990a14", "ground_truth": {"modern_name": "Felice Fontana", "confidence": "high", "type": "person", "birth_year": 1730, "death_year": 1805, "description": "Italian physiologist, physicist, and inventor of scientific instruments.", "wikidata_id": "Q55033821", "wikidata_description": "Italian polymath"}}, {"canonical_name": "animal life", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "vie_animale", "book_id": "medecine_experimentale_bernard_1865", "name": "vie an