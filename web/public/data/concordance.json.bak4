arity": 0.98}], "id": 2928, "stable_key": "clu_15b49048647e5106", "ground_truth": {"modern_name": "Plant life", "confidence": "high", "type": "plant", "note": "This cluster refers to plant life in a general sense, not a specific species or group of plants."}}, {"canonical_name": "roches primitives", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "roche_primitive", "book_id": "epoques_nature_buffon_1778", "name": "roche primitive", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["roche primitive"], "contexts": ["solid mass of vitrescible matter"]}, {"entity_id": "roches_primitives", "book_id": "relation_historique_humboldt_vol3_1825", "name": "roches primitives", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["roches primitives"], "contexts": ["rocks found on mountain slopes", "primary or foundational rocks"]}, {"entity_id": "roche_primitive", "book_id": "relation_historique_humboldt_vol3_1825", "name": "roche primitive", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["roche primitive"], "contexts": ["primitive rock"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "roche primitive", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "roches primitives", "similarity": 0.982}, {"source_book": "epoques_nature_buffon_1778", "source_name": "roche primitive", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "roche primitive", "similarity": 1.0}], "id": 2929, "stable_key": "clu_32a2b560e5579814", "ground_truth": {"modern_name": "Primary rocks", "confidence": "high", "type": "mineral", "note": "Early modern concept of 'roches primitives' often referred to igneous rocks and metamorphic rocks formed from them, considered the oldest.", "wikidata_id": "Q42045", "wikidata_description": "one of the three main rock types; formed through the cooling and solidification of magma or lava", "wikipedia_url": "https://en.wikipedia.org/wiki/Igneous%20rock"}}, {"canonical_name": "warmth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "warm", "book_id": "english_physician_1652", "name": "warm", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["warm"], "contexts": ["quality of stomach"]}, {"entity_id": "warmth", "book_id": "principles_of_psychology_james_1890", "name": "warmth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["warmth"], "contexts": ["sensation of heat", "feeling of bodily existence"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "warm", "target_book": "principles_of_psychology_james_1890", "target_name": "warmth", "similarity": 0.921}], "id": 2930, "stable_key": "clu_186efa40b7f472bf-4", "ground_truth": {"modern_name": "Heat", "confidence": "high", "type": "concept", "wikidata_id": "Q28128222", "wikidata_description": "state of high relative temperature, often said about body temperature, weather or objects", "note": "Refers to the Aristotelian/Galenic quality of heat, a fundamental concept in early modern humoral theory and philosophy of nature."}}, {"canonical_name": "Scorpion", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "scorpion", "book_id": "english_physician_1652", "name": "Scorpion", "category": "CONCEPT", "subcategory": "THEORY", "count": 8, "variants": ["Scorpion"], "contexts": ["zodiac sign associated with herb", "creature whose poison is resisted"]}, {"entity_id": "escorpi\u00e3o", "book_id": "polyanthea_medicinal", "name": "Escorpi\u00e3o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Escorpi\u00e3o"], "contexts": ["zodiac sign"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Scorpion", "target_book": "polyanthea_medicinal", "target_name": "Escorpi\u00e3o", "similarity": 0.96}], "id": 2931, "stable_key": "clu_4bf434f66ea043f6-2", "ground_truth": {"modern_name": "Tropic of Capricorn", "confidence": "high", "type": "concept", "description": "The southern-most latitude where the sun can be directly overhead.", "note": "Includes references to the zodiac sign Capricorn and the tropic line.", "wikipedia_extract": "The Tropic of Capricorn (or the Southern Tropic) is the circle of latitude that contains the subsolar point at the December (or southern) solstice. It is thus the southernmost latitude where the Sun can be seen directly overhead. It also reaches 90 degrees below the horizon at solar midnight on the June Solstice. Its northern equivalent is the Tropic of Cancer. The Tropic of Capricorn is one of the five major circles of latitude marked on maps of Earth. Its latitude is currently 23\u00b026\u203209.2\u2033 (or 23.4359\u00b0) south of the Equator, but it is very gradually moving northward, currently at the rate of 0.47 arcseconds, or 15 metres, per year."}}, {"canonical_name": "Lancashire", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "lancashire", "book_id": "english_physician_1652", "name": "Lancashire", "category": "PLACE", "subcategory": "REGION", "count": 7, "variants": ["Lancashire", "Lanca\u0361shire"], "contexts": ["county where Red Bilberry grows", "region where narrow leaved Bistort grows"]}, {"entity_id": "lancashire", "book_id": "first_principles_spencer_1862", "name": "Lancashire", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Lancashire"], "contexts": ["region with social activities due to imported materials", "region with social activities"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Lancashire", "target_book": "first_principles_spencer_1862", "target_name": "Lancashire", "similarity": 1.0}], "id": 2932, "stable_key": "clu_82c48720adfbce57", "ground_truth": {"modern_name": "Lancashire", "confidence": "high", "type": "place", "country": "United Kingdom", "wikipedia_extract": "Preston ( ) is a city on the north bank of the River Ribble in Lancashire, in North West England. The city is the administrative centre of the county of Lancashire and the wider City of Preston local government district. Preston and its surrounding district obtained city status in 2002, becoming England's 50th city in the 50th year of Queen Elizabeth II's reign. Preston had a population of 147,835 at the 2021 census, the City of Preston district 156,411 in 2023 and the Preston Built-up Area 313,322. The Preston Travel To Work Area, in 2011, had a population of 420,661, compared with 354,000 at the previous census. The south bank of the Ribble is part of the Preston urban area, although it forms the South Ribble borough that is administratively separate.", "wikipedia_url": "https://en.wikipedia.org/wiki/Preston,_Lancashire"}}, {"canonical_name": "Pepper", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "pepper", "book_id": "english_physician_1652", "name": "Pepper", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["Pepper", "Pepperwort"], "contexts": ["spice added to kernels", "comparison for heat"]}, {"entity_id": "pepper", "book_id": "polyanthea_medicinal", "name": "pepper", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["pepper"], "contexts": ["mixed with wine"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Pepper", "target_book": "polyanthea_medicinal", "target_name": "pepper", "similarity": 0.97}], "id": 2933, "stable_key": "clu_220162fb7b9b2be1-3", "ground_truth": {"modern_name": "pepper", "confidence": "high", "type": "plant", "linnaean": "Piper nigrum Linnaeus", "family": "Piperaceae", "note": "Likely refers to black pepper (Piper nigrum), but could also encompass other pungent spices depending on context. 'Pimenta redonda' might refer to a specific variety or another round spice.", "wikidata_id": "Q43084", "wikidata_description": "species of plant"}}, {"canonical_name": "sharp", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "sharp", "book_id": "english_physician_1652", "name": "sharp", "category": "CONCEPT", "subcategory": "QUALITY", "count": 7, "variants": ["sharp", "Sharpness", "sharpness"], "contexts": ["taste quality of Water-Cresses", "quality of substance"]}, {"entity_id": "sharp", "book_id": "principles_of_psychology_james_1890", "name": "sharp", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["sharp"], "contexts": ["sensation of pointedness"]}, {"entity_id": "f_sharp", "book_id": "principles_of_psychology_james_1890", "name": "f sharp", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["f sharp"], "contexts": ["musical note"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "sharp", "target_book": "principles_of_psychology_james_1890", "target_name": "sharp", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "sharp", "target_book": "principles_of_psychology_james_1890", "target_name": "f sharp", "similarity": 0.908}], "id": 2934, "stable_key": "clu_b233003267c98222", "ground_truth": {"modern_name": "Sharp", "confidence": "high", "type": "concept", "description": "Possessing a keen edge or point; intense taste or sensation.", "wikipedia_extract": "Venomous Concept is an American hardcore punk band formed by Kevin Sharp of Brutal Truth and Shane Embury of Napalm Death in 2004. Sharp and Embury were joined by Danny Herrera and Buzz Osborne, who was later replaced by Danny Lilker. They have released five studio albums to date: Retroactive Abortion (2004), Poisoned Apple (2008), Kick Me Silly VCIII (2016), \"Politics Versus the Erection\" (2020) and \"The Good Ship Lollipop\" (2023). They have also released two split albums: one with Japanese grindcore band 324 (2006), and the other with Australian extreme metal band Blood Duster (2008). The band's name is a play on Poison Idea, in the style of name-mangling Japanese hardcore acts. In February 2004, Kevin Sharp was the tour driver for Napalm Death on The Art of Noise tour with Nile, Strapping Young Lad, Dark Tranquillity and The Berzerker."}}, {"canonical_name": "Passions of the Heart", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "passions_of_the_heart", "book_id": "english_physician_1652", "name": "Passions of the Heart", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 6, "variants": ["Passions of the Heart", "passions", "passions of it", "passions of the Heart", "passions of the Mother"], "contexts": ["condition troubled by borrage", "helped by a drink"]}, {"entity_id": "passions", "book_id": "principles_of_psychology_james_1890", "name": "passions", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["passions"], "contexts": ["engendered by association of ideas", "strong emotional states"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Passions of the Heart", "target_book": "principles_of_psychology_james_1890", "target_name": "passions", "similarity": 0.922}], "id": 2935, "stable_key": "clu_f9a441935b1f1c61", "ground_truth": {"modern_name": "Emotional disturbance", "confidence": "medium", "type": "concept", "note": "The term 'passions of the heart' in early modern texts referred to strong emotions or emotional disturbances, not a specific disease in the modern sense. It's closer to a psychological or emotional state.", "wikidata_id": "Q12046440", "wikidata_description": "symptom"}}, {"canonical_name": "cabbage", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "cabbages", "book_id": "english_physician_1652", "name": "cabbages", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Cabbages", "cabbages"], "contexts": ["common garden vegetable", "vegetable eaten boiled for opening body"]}, {"entity_id": "cabbage", "book_id": "origin_of_species_darwin_1859", "name": "cabbage", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["cabbage"], "contexts": ["cultivated plant with wild ancestor", "plant with distinct leaves and flowers"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "cabbages", "target_book": "origin_of_species_darwin_1859", "target_name": "cabbage", "similarity": 0.949}], "id": 2936, "stable_key": "clu_4206d8bd8596e8ca", "ground_truth": {"modern_name": "Cabbage", "confidence": "high", "type": "plant", "linnaean": "Brassica oleracea Linnaeus", "family": "Brassicaceae", "wikidata_id": "Q58677", "wikidata_description": "genus of plants"}}, {"canonical_name": "Terra santa", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "terra_sacratissima", "book_id": "english_physician_1652", "name": "Terra sacratissima", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Terra sacratissima"], "contexts": ["philosophical term for a substance"]}, {"entity_id": "terra_santa", "book_id": "polyanthea_medicinal", "name": "Terra santa", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["Terra santa", "Terra Santa"], "contexts": ["name for prepared antimony", "name given to valuable powders"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Terra sacratissima", "target_book": "polyanthea_medicinal", "target_name": "Terra santa", "similarity": 0.941}], "id": 2937, "stable_key": "clu_157c6ffe199c26c2-3", "ground_truth": {"modern_name": "Antimony", "confidence": "high", "type": "mineral", "wikidata_id": "Q1099", "wikidata_description": "chemical element with symbol Sb and atomic number of 51", "wikipedia_extract": "Antimony potassium tartrate, also known as potassium antimonyl tartrate, potassium antimontarterate, or tartar emetic, has the formula K2Sb2(C4H2O6)2. The compound has long been known as a powerful emetic, and was used in the treatment of schistosomiasis and leishmaniasis. It is used as a resolving agent. It typically is obtained as a hydrate. The first treatment application against trypanosomiasis was tested in 1906, and the compound's use to treat other tropical diseases was researched. The treatment of leishmania with antimony potassium tartrate started in 1913.", "wikipedia_url": "https://en.wikipedia.org/wiki/Antimony", "note": "This likely refers to a distilled preparation containing antimony compounds.", "description": "A metallic element, often prepared and used in alchemical and medicinal contexts."}}, {"canonical_name": "hypocistide", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "hypocistis", "book_id": "english_physician_1652", "name": "Hypocistis", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Hypocistis"], "contexts": ["used for binding effect"]}, {"entity_id": "hypocistide", "book_id": "ricettario_fiorentino_1597", "name": "hypocistide", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["hypocistide", "Hipocifti", "Hy pociftide", "Hypocifti", "Hypocistide", "Hypoc\u00ecftide", "hypociftide"], "contexts": ["substance discussed", "plant for pounding with liquid"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Hypocistis", "target_book": "ricettario_fiorentino_1597", "target_name": "hypocistide", "similarity": 0.956}], "id": 2938, "stable_key": "clu_0c9326ebca92e065", "ground_truth": {"modern_name": "Hypocistis", "confidence": "high", "type": "plant", "linnaean": "Cistanche phelypaea", "family": "Orobanchaceae", "description": "Parasitic plant extract used for binding and in medicinal preparations.", "wikipedia_extract": "Cistanche phelypaea, also spelled Cistanche phelipaea, is a species of plant in the family Orobanchaceae. It has a wide range of distribution from the Arabian Peninsula and the Syrian Desert in the east, through the Sahara, Cyprus, Crete and the southwest of the Iberian Peninsula, to Macaronesia in the west. Cistanche phelypaea is a chlorophyll-free, obligate parasitic plant with stout fleshy flowering stems bearing bright yellow flowers and rising to 20\u201350 cm (7.9\u201319.7 in) tall from a generally swollen base. The stem is glabrous and yellow to purple gray. Leaves are ovate-lanceolate, obtuse, glabrous and normally brown in color. Inflorescence is dense, more or less cylindrical."}}, {"canonical_name": "natural system", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "natural_system", "book_id": "origin_of_species_darwin_1859", "name": "natural system", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["Natural System", "Natural system", "natural system"], "contexts": ["classification based on natural relationships", "classification of species"]}, {"entity_id": "systems_of_nature", "book_id": "kosmos_humboldt_1845", "name": "Systems of Nature", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Systems of Nature"], "contexts": ["title for catalogues of organized beings"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "natural system", "target_book": "kosmos_humboldt_1845", "target_name": "Systems of Nature", "similarity": 0.896}], "id": 2939, "stable_key": "clu_747d4e06751c908b", "ground_truth": {"modern_name": "Natural System", "confidence": "high", "type": "concept", "wikidata_id": "Q106865236", "wikidata_description": "naturally-occurring system"}}, {"canonical_name": "Huber", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "huber", "book_id": "origin_of_species_darwin_1859", "name": "Huber", "category": "PERSON", "subcategory": "SCHOLAR", "count": 8, "variants": ["Huber"], "contexts": ["observer of ant behavior", "statements trusted by the author"]}, {"entity_id": "huber", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Huber", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Huber"], "contexts": ["added information to a translation"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Huber", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Huber", "similarity": 1.0}], "id": 2940, "stable_key": "clu_7061a76998ba1ee2", "ground_truth": {"modern_name": "Fran\u00e7ois Huber", "confidence": "high", "type": "person", "birth_year": 1750, "death_year": 1831, "description": "Swiss naturalist who studied ants and bees."}}, {"canonical_name": "breed", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "breed", "book_id": "origin_of_species_darwin_1859", "name": "breed", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["breed"], "contexts": ["line of domesticated animals", "group of domesticated animals"]}, {"entity_id": "breeds", "book_id": "origin_of_species_darwin_1859", "name": "breeds", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["breeds"], "contexts": ["modified animal types", "groups of domestic animals"]}, {"entity_id": "breed", "book_id": "first_principles_spencer_1862", "name": "breed", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["breed"], "contexts": ["distinct group within a species"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "breed", "target_book": "first_principles_spencer_1862", "target_name": "breed", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "breeds", "target_book": "first_principles_spencer_1862", "target_name": "breed", "similarity": 0.881}], "id": 2941, "stable_key": "clu_962a1174496c9e29", "ground_truth": {"modern_name": "Breed", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Fir-trees", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "fir-trees", "book_id": "origin_of_species_darwin_1859", "name": "Fir-trees", "category": "PLANT", "subcategory": "TREE", "count": 4, "variants": ["Fir-trees", "fir-trees"], "contexts": ["coniferous trees", "producing pollen"]}, {"entity_id": "firs", "book_id": "kosmos_humboldt_1845", "name": "firs", "category": "PLANT", "subcategory": "TREE", "count": 3, "variants": ["firs"], "contexts": ["abundant in middle tertiary period", "genus of coniferous trees"]}, {"entity_id": "fir-tree", "book_id": "kosmos_humboldt_1845", "name": "fir-tree", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["fir-tree"], "contexts": ["familiar tree form"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Fir-trees", "target_book": "kosmos_humboldt_1845", "target_name": "firs", "similarity": 0.901}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Fir-trees", "target_book": "kosmos_humboldt_1845", "target_name": "fir-tree", "similarity": 0.93}], "id": 2942, "stable_key": "clu_55d22d6912ed4b7a", "ground_truth": {"modern_name": "Fir", "confidence": "high", "type": "plant", "family": "Pinaceae", "wikidata_id": "Q5451213", "wikidata_description": "village in County Durham, United Kingdom"}}, {"canonical_name": "Murchison", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "murchison", "book_id": "origin_of_species_darwin_1859", "name": "Murchison", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Murchison"], "contexts": ["great geologist", "geologist who gave up catastrophe theory"]}, {"entity_id": "murchison", "book_id": "kosmos_humboldt_1845", "name": "Murchison", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Murchison"], "contexts": ["author of 'The Silurian System'", "author of 'Silurian System'"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Murchison", "target_book": "kosmos_humboldt_1845", "target_name": "Murchison", "similarity": 1.0}], "id": 2943, "stable_key": "clu_d81fc403b9155676", "ground_truth": {"modern_name": "Roderick Impey Murchison", "confidence": "high", "type": "person", "birth_year": 1792, "death_year": 1871, "description": "British geologist, known for work on Silurian system.", "wikidata_id": "Q361900", "wikidata_description": "British geologist (1792-1871)", "wikipedia_url": "https://en.wikipedia.org/wiki/Roderick%20Murchison", "wikipedia_extract": "Sir Roderick Impey Murchison, 1st Baronet (19 February 1792 \u2013 22 October 1871) was a Scottish geologist who served as director-general of the British Geological Survey from 1855 until his death in 1871. He is noted for investigating and describing the Silurian, Devonian and Permian systems. Murchison was born at Tarradale House, Muir of Ord, Ross-shire, the son of Barbara and Kenneth Murchison. His wealthy father died in 1796, when Roderick was four years old, and he was sent to Durham School three years later and then to the Royal Military College, Great Marlow, to be trained for the army. In 1808, under Wellesley, he landed in Portugal, and was present at the actions of Roli\u00e7a and Vimeiro in the Peninsular War as an ensign in the 36th Regt of Foot. Subsequently, under Sir John Moore, he took part in the retreat to Corunna and the final battle there."}}, {"canonical_name": "Egyptians", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "egyptians", "book_id": "origin_of_species_darwin_1859", "name": "Egyptians", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Egyptians"], "contexts": ["ancient civilization associated with Ateuchus", "ancient people"]}, {"entity_id": "egyptians", "book_id": "first_principles_spencer_1862", "name": "Egyptians", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 7, "variants": ["Egyptians"], "contexts": ["ancient civilization", "people with hieroglyphics and written language"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Egyptians", "target_book": "first_principles_spencer_1862", "target_name": "Egyptians", "similarity": 1.0}], "id": 2944, "stable_key": "clu_ece86bf05e80660e", "ground_truth": {"modern_name": "Ancient Egyptians", "confidence": "high", "type": "person", "description": "People from ancient Egypt, known for early civilization and knowledge", "wikidata_id": "Q56202338", "wikidata_description": "people inhabiting or originating from Ancient Egypt"}}, {"canonical_name": "negros", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "negroes", "book_id": "origin_of_species_darwin_1859", "name": "negroes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["negroes"], "contexts": ["people of African descent"]}, {"entity_id": "negros", "book_id": "coloquios_da_orta_1563", "name": "negros", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 8, "variants": ["negros", "negra", "negro"], "contexts": ["people referred to as Zingis", "people who adopted liamba/riamba"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "negroes", "target_book": "coloquios_da_orta_1563", "target_name": "negros", "similarity": 0.997}], "id": 2945, "stable_key": "clu_8f74ad5c2698feef", "ground_truth": {"modern_name": "People of African descent", "confidence": "high", "type": "person", "description": "People of African descent, often used in historical colonial contexts.", "note": "The term 'negro'/'negra' is a historical term for people of African descent and can carry offensive connotations. The context of its usage in these early modern texts varies, sometimes referring to general populations, and other times to enslaved individuals or specific physical descriptions.", "wikidata_id": "Q99585672", "wikidata_description": "AHRC Research Grant (2017)"}}, {"canonical_name": "oaks", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "pedunculated_oaks", "book_id": "origin_of_species_darwin_1859", "name": "pedunculated oaks", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["pedunculated oaks"], "contexts": ["type of oak tree"]}, {"entity_id": "oaks", "book_id": "kosmos_humboldt_1845", "name": "oaks", "category": "PLANT", "subcategory": "TREE", "count": 8, "variants": ["oaks"], "contexts": ["tree species in Himalaya", "tall trees on southern Himalaya slopes"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "pedunculated oaks", "target_book": "kosmos_humboldt_1845", "target_name": "oaks", "similarity": 0.911}], "id": 2946, "stable_key": "clu_363000d95e00cbb0-3", "ground_truth": {"modern_name": "Oak", "confidence": "high", "type": "plant", "family": "Fagaceae", "note": "'pedunculated oaks' refers to Quercus robur.", "wikidata_id": "Q12004", "wikidata_description": "genus of plants", "linnaean": "Quercus", "description": "A large tree known for its wood and acorns, with medicinal uses.", "wikipedia_extract": "An oak is a hardwood tree or shrub in the genus Quercus of the beech family. They have spirally arranged leaves, often with lobed edges, and a nut called an acorn, borne within a cup. The genus is widely distributed in the Northern Hemisphere, with some 500 species, both deciduous and evergreen. Fossil oaks date back to the Middle Eocene. Molecular phylogeny shows that the genus is divided into Old World and New World clades, but many oak species hybridise freely, making the genus's history difficult to resolve. Ecologically, oaks are keystone species in habitats from Mediterranean semi-desert to subtropical rainforest."}}, {"canonical_name": "zone torride", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "torrid_zones", "book_id": "origin_of_species_darwin_1859", "name": "torrid zones", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["torrid zones"], "contexts": ["islands in hot climate zones"]}, {"entity_id": "zone_torride", "book_id": "relation_historique_humboldt_vol3_1825", "name": "zone torride", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["zone torride"], "contexts": ["Torrid zone", "tropical region of the Earth"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "torrid zones", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "zone torride", "similarity": 0.945}], "id": 2947, "stable_key": "clu_efa17ff517020478", "ground_truth": {"modern_name": "Torrid Zone", "confidence": "high", "type": "concept", "wikidata_id": "Q117455236", "wikidata_description": "lies between TROPIC OF CANCER AND TROPIC OF CAPRICORN", "wikipedia_url": "https://en.wikipedia.org/wiki/Torrid%20zone", "country": "Global", "wikipedia_extract": "The torrid zone was the name given by ancient Greek and Roman geographers to the equatorial area of the Earth, so hot that it was thought to be impenetrable to sailors or explorers. That notion became a deterrent for European explorers until the 15th century. Aristotle, like all classical thinkers, knew that the world was a sphere. He posited that the western half of the temperate zone on the other side of the globe from Greece might be habitable and that, because of symmetry, there must be in the Southern Hemisphere a temperate zone corresponding to that in the northern. He thought, however, that the excessive heat in the torrid zone would prevent the exploration. the meridian through Syene is drawn approximately along the course of the Nile from Mero\u00eb to Alexandria, and this distance is about ten thousand stadia [~1,800 km]; and Syene must lie in the centre of that distance; so that the distance from Syene to Mero\u00eb is five thousand stadia [~900 km]."}}, {"canonical_name": "canarim", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "canary", "book_id": "origin_of_species_darwin_1859", "name": "canary", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["canary"], "contexts": ["seed that germinated after bird digestion"]}, {"entity_id": "canarim", "book_id": "coloquios_da_orta_1563", "name": "canarim", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["canarim", "CANARDI"], "contexts": ["language spoken in a region", "language and people"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "canary", "target_book": "coloquios_da_orta_1563", "target_name": "canarim", "similarity": 0.889}], "id": 2948, "stable_key": "clu_f20897f35bf7aae2", "ground_truth": {"modern_name": "Canary grass", "confidence": "high", "type": "plant", "linnaean": "Phalaris canariensis Linnaeus", "family": "Poaceae", "wikidata_id": "Q2086586", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Canary%20grass", "wikipedia_extract": "Canary grass is a plant, Phalaris canariensis, belonging to the family Poaceae. Originally a native of the Mediterranean region, it is now grown commercially in several parts of the world for birdseed. Phalaris canariensis resembles Phalaris arundinacea (reed canary grass), a perennial forage crop and a wild grass. Although heads of both crops are panicles, Phalaris canariensis heads resemble club wheat. This large, coarse grass has erect, hairless stems, usually from 2 to 6 feet (0.61 to 1.83 m) tall. The ligule is prominent and membranous, 1\u20444 inch (0.64 cm) long and rounded at the apex."}}, {"canonical_name": "hijada", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "hijada", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "hijada", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 8, "variants": ["hijada"], "contexts": ["pain in the flank", "lower abdomen, affected by illness"]}, {"entity_id": "hijada", "book_id": "polyanthea_medicinal", "name": "Hijada", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Hijada"], "contexts": ["stone name, likely related to kidney"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "hijada", "target_book": "polyanthea_medicinal", "target_name": "Hijada", "similarity": 0.442}], "id": 2949, "stable_key": "clu_417bb7bcb27ba15a", "ground_truth": {"modern_name": "Flank pain", "confidence": "high", "type": "disease", "modern_term": "Flank pain", "note": "The term 'hijada' in Hernandez can refer to a pain in the flank region, often associated with kidney stones or colic, rather than a specific disease entity. It's more descriptive of a symptom or location of pain.", "wikidata_id": "Q22269224", "wikidata_description": "medical symptom"}}, {"canonical_name": "sal", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "sal", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "sal", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 8, "variants": ["sal"], "contexts": ["common salt", "salt used with leaves for poultice"]}, {"entity_id": "salt", "book_id": "kosmos_humboldt_1845", "name": "salt", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTA