members": [{"entity_id": "roulin", "book_id": "medecine_experimentale_bernard_1865", "name": "Roulin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Roulin"], "contexts": ["provided relations about curare"]}, {"entity_id": "rollin", "book_id": "origin_of_species_darwin_1859", "name": "Rollin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Rollin"], "contexts": ["asserts facts about mules"]}, {"entity_id": "boulin", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Boulin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Boulin"], "contexts": ["traveler and author"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Roulin", "target_book": "origin_of_species_darwin_1859", "target_name": "Rollin", "similarity": 0.885}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Roulin", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Boulin", "similarity": 0.86}], "id": 1975, "stable_key": "clu_132888d436aef018-2", "ground_truth": {"modern_name": "Pierre Bouguer", "confidence": "high", "type": "person", "birth_year": 1698, "death_year": 1758, "description": "French geodesist, astronomer, and cartographer.", "note": "Variant spellings like 'Budeu' and 'Boulin' likely refer to him given the context of exploration and scientific works.", "wikidata_id": "Q11065", "wikidata_description": "French astronomer and mathematician (1698-1758)", "wikipedia_url": "https://en.wikipedia.org/wiki/Pierre%20Bouguer", "wikipedia_extract": "Pierre Bouguer (French: [bu\u02c8ge]) (16 February 1698, Le Croisic, Province of Brittany \u2013 15 August 1758, Paris) was a French mathematician, geophysicist, geodesist, and astronomer. He is also known as \"the father of naval architecture\". Bouguer's father, Jean Bouguer, one of the best hydrographers of his time, was Regius Professor of hydrography at Le Croisic in lower Brittany, and author of a treatise on navigation. He taught his sons Pierre and Jan at their home, where he also taught private students. In 1714, at the age of 16, Pierre was appointed to succeed his deceased father as professor of hydrography. In 1727 he gained the prize given by the French Academy of Sciences for his paper On the masting of ships, beating Leonhard Euler; and two other prizes, one for his dissertation On the best method of observing the altitude of stars at sea, the other for his paper On the best method of observing the variation of the compass at sea."}}, {"canonical_name": "syst\u00e8me circulatoire", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "syst\u00e8me_circulatoire", "book_id": "medecine_experimentale_bernard_1865", "name": "syst\u00e8me circulatoire", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["syst\u00e8me circulatoire"], "contexts": ["network of blood vessels"]}, {"entity_id": "circulation", "book_id": "principles_of_psychology_james_1890", "name": "circulation", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["circulation"], "contexts": ["movement of blood through the body"]}, {"entity_id": "circulation", "book_id": "first_principles_spencer_1862", "name": "circulation", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["circulation"], "contexts": ["movement of blood through the body"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "syst\u00e8me circulatoire", "target_book": "principles_of_psychology_james_1890", "target_name": "circulation", "similarity": 0.926}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "syst\u00e8me circulatoire", "target_book": "first_principles_spencer_1862", "target_name": "circulation", "similarity": 0.926}, {"source_book": "principles_of_psychology_james_1890", "source_name": "circulation", "target_book": "first_principles_spencer_1862", "target_name": "circulation", "similarity": 1.0}], "id": 1976, "stable_key": "clu_efa604e3edfd05e5", "ground_truth": {"modern_name": "Circulation of the blood", "confidence": "high", "type": "concept", "note": "Refers to the physiological concept of blood circulation."}}, {"canonical_name": "alimentation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "alimentation", "book_id": "medecine_experimentale_bernard_1865", "name": "alimentation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["alimentation"], "contexts": ["dietary intake"]}, {"entity_id": "alimentation", "book_id": "principles_of_psychology_james_1890", "name": "alimentation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["alimentation"], "contexts": ["process of nourishing the body"]}, {"entity_id": "nutr\u00edmento", "book_id": "coloquios_da_orta_1563", "name": "nutr\u00edmento", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["nutr\u00edmento"], "contexts": ["nourishment of the figuo"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "alimentation", "target_book": "principles_of_psychology_james_1890", "target_name": "alimentation", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "alimentation", "target_book": "coloquios_da_orta_1563", "target_name": "nutr\u00edmento", "similarity": 0.955}, {"source_book": "principles_of_psychology_james_1890", "source_name": "alimentation", "target_book": "coloquios_da_orta_1563", "target_name": "nutr\u00edmento", "similarity": 0.955}], "id": 1977, "stable_key": "clu_17ba893672718676-2", "ground_truth": {"modern_name": "nutrition", "confidence": "high", "type": "concept", "wikidata_id": "Q17652193", "wikidata_description": "science that interprets the nutrients and other substances in food in relation to maintenance, growth, reproduction, health and disease of an organism", "wikipedia_url": "https://en.wikipedia.org/wiki/Nutritional%20science", "note": "The term 'nourishment' and its Portuguese equivalent 'nutr\u00edmento' directly refer to the biological process of providing or receiving sustenance, which is the modern concept of nutrition.", "wikipedia_extract": "Nutritional science (also nutrition science, sometimes short nutrition, dated trophology) is the science that studies the physiological process of nutrition (primarily human nutrition), interpreting the nutrients and other substances in food in relation to maintenance, growth, reproduction, health and disease of an organism. Before nutritional science emerged as an independent study disciplines, mainly chemists worked in this area. The chemical composition of food was examined. Macronutrients, especially protein, fat and carbohydrates, have been the focus components of the study of (human) nutrition since the 19th century. Until the discovery of vitamins and vital substances, the quality of nutrition was measured exclusively by the intake of nutritional energy. The early years of the 20th century were summarized by Kenneth John Carpenter in his Short History of Nutritional Science as \"the vitamin era\"."}}, {"canonical_name": "vaisseaux capillaires", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "vaisseaux_capillaires", "book_id": "medecine_experimentale_bernard_1865", "name": "vaisseaux capillaires", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["vaisseaux capillaires"], "contexts": ["smallest blood vessels"]}, {"entity_id": "capillary_surface", "book_id": "connexion_physical_sciences_somerville_1858", "name": "capillary surface", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["capillary surface"], "contexts": ["surface of liquid in a capillary tube"]}, {"entity_id": "capillaries", "book_id": "first_principles_spencer_1862", "name": "capillaries", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["capillaries"], "contexts": ["vessels through which fluid transudes"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "vaisseaux capillaires", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "capillary surface", "similarity": 0.887}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "vaisseaux capillaires", "target_book": "first_principles_spencer_1862", "target_name": "capillaries", "similarity": 0.923}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "capillary surface", "target_book": "first_principles_spencer_1862", "target_name": "capillaries", "similarity": 0.894}], "id": 1978, "stable_key": "clu_3ccf55c377b848fe", "ground_truth": {"modern_name": "Capillaries", "confidence": "high", "type": "concept", "note": "Refers to the anatomical structures, specifically blood capillaries.", "wikidata_id": "Q71402759", "wikidata_description": "scientific article published on 01 January 1984"}}, {"canonical_name": "erreurs", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "erreurs", "book_id": "medecine_experimentale_bernard_1865", "name": "erreurs", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["erreurs"], "contexts": ["mistakes or inaccuracies"]}, {"entity_id": "erros", "book_id": "coloquios_da_orta_1563", "name": "erros", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["erros"], "contexts": ["consequences of equivocation"]}, {"entity_id": "errori", "book_id": "ricettario_fiorentino_1597", "name": "Errori", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Errori"], "contexts": ["concept of mistakes"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "erreurs", "target_book": "coloquios_da_orta_1563", "target_name": "erros", "similarity": 0.934}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "erreurs", "target_book": "ricettario_fiorentino_1597", "target_name": "Errori", "similarity": 0.948}, {"source_book": "coloquios_da_orta_1563", "source_name": "erros", "target_book": "ricettario_fiorentino_1597", "target_name": "Errori", "similarity": 0.963}], "id": 1979, "stable_key": "clu_d3cd58b526ff0628-2", "ground_truth": {"modern_name": "Error", "confidence": "high", "type": "concept", "wikidata_id": "Q29485", "wikidata_description": "action or proposition which is inaccurate or incorrect, that could result in failure or deviation from the intended performance or behaviour", "wikipedia_url": "https://en.wikipedia.org/wiki/Error", "wikipedia_extract": "An error (from the Latin err\u0101re, meaning 'to wander') is an inaccurate or incorrect action, thought, or judgement. In statistics, \"error\" refers to the difference between the value which has been computed and the correct value. An error could result in failure or in a deviation from the intended performance or behavior. One reference differentiates between \"error\" and \"mistake\" as follows: An 'error' is a deviation from accuracy or correctness. A 'mistake' is an error caused by a fault: the fault being misjudgment, carelessness, or forgetfulness. Now, say that I run a stop sign because I was in a hurry, and wasn't concentrating, and the police stop me, that is a mistake."}}, {"canonical_name": "vitality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "vitality", "book_id": "medecine_experimentale_bernard_1865", "name": "vitality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vitality"], "contexts": ["term for unknown life force"]}, {"entity_id": "vitality", "book_id": "principles_of_psychology_james_1890", "name": "vitality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vitality"], "contexts": ["state of being strong and active"]}, {"entity_id": "vitality", "book_id": "kosmos_humboldt_1845", "name": "vitality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vitality"], "contexts": ["quality of being alive"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "vitality", "target_book": "principles_of_psychology_james_1890", "target_name": "vitality", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "vitality", "target_book": "kosmos_humboldt_1845", "target_name": "vitality", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "vitality", "target_book": "kosmos_humboldt_1845", "target_name": "vitality", "similarity": 1.0}], "id": 1980, "stable_key": "clu_1bb8515afd515a06", "ground_truth": {"modern_name": "vitality", "confidence": "high", "type": "concept", "wikidata_id": "Q24702794", "wikidata_description": "French esports organisation", "wikipedia_url": "https://en.wikipedia.org/wiki/Team%20Vitality", "wikipedia_extract": "Team Vitality, or simply Vitality, is a French esport club founded in 2013 by Fabien \"Neo\" Devide, Nicolas Maurer, Corentin \"Gotaga\" Houssein, and Kevin \"BrokyBrawks\" Georges. Team Vitality has teams in eleven PC/console esports titles (League of Legends, Valorant, Counter-Strike 2, Rocket League, EA FC, StarCraft II, Tekken, Rennsport, Street Fighter 6, Call of Duty Warzone and Teamfight Tactics), with several professional teams and content creators from across Europe and South Korea. Vitality also has teams in four mobile esports titles (Mobile Legends: Bang Bang, Honor of Kings, Free Fire and PUBG Mobile) under the name \"Bigetron by Vitality\" after they acquired the Indonesian organization Bigetron Esports in 2025. The organization has previously fielded teams in numerous other titles, including Call of Duty, Call of Duty Mobile, Fortnite, Rainbow Six: Siege, PUBG, H1Z1, Clash Royale, Street Fighter, Formula 1, Hearthstone, Gears of War and Arena of Valor, as well as previously operating in India. Since 2019, the organization has made the Stade de France its training center, becoming the first resident club of the stadium. Team Vitality entered the professional League of Legends on 9 December 2015, after it acquired Gambit Gaming's spot in the 2016 EU LCS Spring Split."}}, {"canonical_name": "organic matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "organic_matter", "book_id": "medecine_experimentale_bernard_1865", "name": "organic matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["organic matter"], "contexts": ["matter derived from living organisms"]}, {"entity_id": "organic_matter", "book_id": "kosmos_humboldt_1845", "name": "organic matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["organic matter"], "contexts": ["matter derived from living organisms"]}, {"entity_id": "organic_matter", "book_id": "first_principles_spencer_1862", "name": "organic matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["organic matter"], "contexts": ["matter capable of organization into living forms"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "organic matter", "target_book": "kosmos_humboldt_1845", "target_name": "organic matter", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "organic matter", "target_book": "first_principles_spencer_1862", "target_name": "organic matter", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "organic matter", "target_book": "first_principles_spencer_1862", "target_name": "organic matter", "similarity": 1.0}], "id": 1981, "stable_key": "clu_4fc4971379eaa92a-2", "ground_truth": {"modern_name": "Organic compounds", "confidence": "high", "type": "concept", "note": "The terms 'organic matter', 'organic substances', and 'organic compounds' all refer to chemical compounds that typically contain carbon, especially those found in living organisms or derived from them."}}, {"canonical_name": "corps min\u00e9raux", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "corps_min\u00e9raux", "book_id": "medecine_experimentale_bernard_1865", "name": "corps min\u00e9raux", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["corps min\u00e9raux"], "contexts": ["mineral bodies in chemical indifference"]}, {"entity_id": "terreous_bodies", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Terreous Bodies", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Terreous Bodies"], "contexts": ["category of bodies examined"]}, {"entity_id": "mineral_bodies", "book_id": "kosmos_humboldt_1845", "name": "mineral bodies", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["mineral bodies"], "contexts": ["finely-pulverized non-living materials"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "corps min\u00e9raux", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Terreous Bodies", "similarity": 0.896}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "corps min\u00e9raux", "target_book": "kosmos_humboldt_1845", "target_name": "mineral bodies", "similarity": 0.949}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Terreous Bodies", "target_book": "kosmos_humboldt_1845", "target_name": "mineral bodies", "similarity": 0.908}], "id": 1982, "stable_key": "clu_0722933ad43b554d", "ground_truth": {"modern_name": "mineral substances", "confidence": "high", "type": "mineral", "note": "Refers to naturally occurring inorganic substances or compounds.", "wikidata_id": "Q5309", "wikidata_description": "allotrope of carbon, mineral, substance", "wikipedia_url": "https://en.wikipedia.org/wiki/Graphite"}}, {"canonical_name": "animalibus", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "animalibus", "book_id": "medecine_experimentale_bernard_1865", "name": "animalibus", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["animalibus"], "contexts": ["animals"]}, {"entity_id": "animalibus", "book_id": "epoques_nature_buffon_1778", "name": "animalibus", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["animalibus"], "contexts": ["from animals"]}, {"entity_id": "bus", "book_id": "polyanthea_medicinal", "name": "Bus", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Bus"], "contexts": ["animal part used for dropsy"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "animalibus", "target_book": "epoques_nature_buffon_1778", "target_name": "animalibus", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "animalibus", "target_book": "polyanthea_medicinal", "target_name": "Bus", "similarity": 0.932}, {"source_book": "epoques_nature_buffon_1778", "source_name": "animalibus", "target_book": "polyanthea_medicinal", "target_name": "Bus", "similarity": 0.932}], "id": 1983, "stable_key": "clu_373174bf9f812db4", "ground_truth": {"modern_name": "Animals", "confidence": "high", "type": "animal", "wikidata_id": "Q431", "wikidata_description": "scientific study of animals", "wikipedia_url": "https://en.wikipedia.org/wiki/Zoology"}}, {"canonical_name": "Andreas", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "andreas", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Andreas", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Andreas"], "contexts": ["ancient author of a piece"]}, {"entity_id": "andreas", "book_id": "coloquios_da_orta_1563", "name": "Andreas", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Andreas"], "contexts": ["translator"]}, {"entity_id": "andreas", "book_id": "polyanthea_medicinal", "name": "Andreas", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Andreas"], "contexts": ["name of an author"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Andreas", "target_book": "coloquios_da_orta_1563", "target_name": "Andreas", "similarity": 0.82}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Andreas", "target_book": "polyanthea_medicinal", "target_name": "Andreas", "similarity": 0.82}, {"source_book": "coloquios_da_orta_1563", "source_name": "Andreas", "target_book": "polyanthea_medicinal", "target_name": "Andreas", "similarity": 1.0}], "id": 1984, "stable_key": "clu_103ad5815cbf2a80", "ground_truth": {"modern_name": "Andreas Vesalius", "confidence": "medium", "type": "person", "birth_year": 1514, "death_year": 1564, "description": "Pioneering anatomist and physician, author of 'De humani corporis fabrica'.", "note": "The name 'Andreas' is common. Vesalius is a strong candidate given the context of medical texts, but other ancient authors named Andreas are possible."}}, {"canonical_name": "Theology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "theology", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Theology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Theology"], "contexts": ["divine subject matter"]}, {"entity_id": "theologia", "book_id": "polyanthea_medicinal", "name": "Theologia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Theologia"], "contexts": ["Religious doctrine"]}, {"entity_id": "theology", "book_id": "first_principles_spencer_1862", "name": "theology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["theology"], "contexts": ["study of the nature of God"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Theology", "target_book": "polyanthea_medicinal", "target_name": "Theologia", "similarity": 0.992}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Theology", "target_book": "first_principles_spencer_1862", "target_name": "theology", "similarity": 0.983}, {"source_book": "polyanthea_medicinal", "source_name": "Theologia", "target_book": "first_principles_spencer_1862", "target_name": "theology", "similarity": 0.971}], "id": 1985, "stable_key": "clu_c84b5a51279bb7ac-2", "ground_truth": {"modern_name": "Theology", "confidence": "high", "type": "concept", "wikidata_id": "Q34178", "wikidata_description": "study of the nature of deities and religious beliefs", "wikipedia_url": "https://en.wikipedia.org/wiki/Theology", "wikipedia_extract": "Theology is the study of religious belief from a religious perspective, with a focus on the nature of divinity and the history behind religion. It is taught as an academic discipline, typically in universities and seminaries. It occupies itself with the unique content of analyzing the supernatural, but also deals with religious epistemology, asks and seeks to answer the question of revelation. Revelation pertains to the acceptance of God, gods, or deities, as not only transcendent or above the natural world, but also willing and able to interact with the natural world and to reveal themselves to humankind. Theologians use various forms of analysis and argument (experiential, philosophical, ethnographic, historical, and others) to help understand, explain, test, critique, defend or promote any myriad of religious topics. As in philosophy of ethics and case law, arguments often assume the existence of previously resolved questions, and develop by making analogies from them to draw new inferences in new situations."}}, {"canonical_name": "verities", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "verities", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "verities", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["verities"], "contexts": ["causes which determine their verities"]}, {"entity_id": "v\u00e9rit\u00e9s", "book_id": "epoques_nature_buffon_1778", "name": "v\u00e9rit\u00e9s", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["v\u00e9rit\u00e9s"], "contexts": ["abstract principles and facts"]}, {"entity_id": "truths", "book_id": "english_physician_1652", "name": "Truths", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Truths"], "contexts": ["held forth by the Gospel"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "verities", "target_book": "epoques_nature_buffon_1778", "target_name": "v\u00e9rit\u00e9s", "similarity": 0.949}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "verities", "target_book": "english_physician_1652", "target_name": "Truths", "similarity": 0.943}, {"source_book": "epoques_nature_buffon_1778", "source_name": "v\u00e9rit\u00e9s", "target_book": "english_physician_1652", "target_name": "Truths", "similarity": 0.973}], "id": 1986, "stable_key": "clu_93f1243e6d74848d", "ground_truth": {"modern_name": "Truths", "confidence": "high", "type": "concept"}}, {"canonical_name": "Apologue", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "apologue", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Apologue", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Apologue"], "contexts": ["moral tale or fable"]}, {"entity_id": "apologia", "book_id": "coloquios_da_orta_1563", "name": "Apologia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Apologia"], "contexts": ["work by Pico Mirandolano"]}, {"entity_id": "apologia", "book_id": "polyanthea_medicinal", "name": "Apologia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Apologia"], "contexts": ["a defense or justification, likely of a scientific or medical argument"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Apologue", "target_book": "coloquios_da_orta_1563", "target_name": "Apologia", "similarity": 0.945}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Apologue", "target_book": "polyanthea_medicinal", "target_name": "Apologia", "similarity": 0.945}, {"source_book": "coloquios_da_orta_1563", "source_name": "Apologia", "target_book": "polyanthea_medicinal", "target_name": "Apologia", "similarity": 1.0}], "id": 1987, "stable_key": "clu_ff56ead7221037b8", "ground_truth": {"modern_name": "Apology", "confidence": "high", "type": "concept", "note": "The term 'Apologue' can refer to a fable or moral tale. 'Apologia' can mean a defense or justification. In a scientific or medical context, it likely refers to a defense of an argument.", "wikidata_id": "Q1416320", "wikidata_description": "statement justifying one's actions or religion (different from apologizing or saying sorry)", "wikipedia_url": "https://en.wikipedia.org/wiki/Apologia", "wikipedia_extract": "An apologia (Latin for apology, from Ancient Greek: \u1f00\u03c0\u03bf\u03bb\u03bf\u03b3\u03af\u03b1, lit. 'speaking in defense') is a formal defense of an opinion, position or action. The term's current use, often in the context of religion, theology and philosophy, derives from Justin Martyr's First Apology (AD 155\u2013157) and was later employed by John Henry Newman's Apologia Pro Vita Sua (English: A Defense of One's Own Life) of 1864, which presented a formal defense of the history of his Christian life, leading to his acceptance by the Catholic Church in 1845. In Ancient Greece, an apologia was primarily used as a legal defense:  The accuser would present a kategoria, or accusation, and the defendant would present his apologia, or defense. In modern usage, apologia describes a formal defense of an idea or belief, rather than against a legal charge. In both ancient and modern uses it differs from an apology, or expression of regret."}}, {"canonical_name": "Demonstrations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "demonstrations", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Demonstrations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Demonstrations"], "contexts": ["proofs or evidence"]}, {"entity_id": "demonstration", "book_id": "principles_of_psychology_james_1890", "name": "demonstration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["demonstration"], "contexts": ["proof or explanation"]}, {"entity_id": "demonstration", "book_id": "first_principles_spencer_1862", "name": "demonstration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["demonstration"], "contexts": ["logical proof"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Demonstrations", "target_book": "principles_of_psychology_james_1890", "target_name": "demonstration", "similarity": 0.891}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Demonstrations", "target_book": "first_principles_spencer_1862", "target_name": "demonstration", "similarity": 0.891}, {"source_book": "principles_of_psychology_james_1890", "source_name": "demonstration", "target_book": "first_principles_spencer_1862", "target_name": "demonstration", "similarity": 1.0}], "id": 1988, "stable_key": "clu_dd0eb8efdf04f350", "ground_truth": {"modern_name": "Demonstration", "confidence": "high", "type": "concept", "note": "Refers to a proof, evidence, or logical explanation.", "wikidata_id": "Q175331", "wikidata_description": "collective action (e.g. march) by people who are supporting or protesting against a cause of concern", "wikipedia_url": "https://en.wikipedia.org/wiki/Political%20demonstration", "wikipedia_extract": "A political demonstration is an action by a mass group or collection of groups of people in favor of a political or other cause or people partaking in a protest against a cause of concern; it often consists of walking in a mass march formation and either beginning with or meeting at a designated endpoint, or rally, in order to hear speakers. It is different from mass meeting. Demonstrations may include actions such as blockades and sit-ins. They can be either nonviolent or violent, with participants often referring to violent demonstrations as \"militant.\" Depending on the circumstances, a demonstration may begin as nonviolent and escalate to violence. Law enforcement, such as riot police, may become involved in these situations. Police involvement at protests is ideally to protect the participants and their right to assemble."}}, {"canonical_name": "Magitians", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "magitians", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Magitians", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Magitians"], "contexts": ["those who practice magic"]}, {"entity_id": "mago", "book_id": "coloquios_da_orta_1563", "name": "mago", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["mago"], "contexts": ["wise men who adored Jesus"]}, {"entity_id": "magi\u017ftri", "book_id": "polyanthea_medicinal", "name": "Magi\u017ftri", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Magi\u017ftri"], "contexts": ["masters of medicine"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Magitians", "target_book": "coloquios_da_orta_1563", "target_name": "mago", "similarity": 0.879}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Magitians", "target_book": "polyanthea_medicinal", "target_name": "Magi\u017ftri", "similarity": 0.859}, {"source_book": "coloquios_da_orta_1563", "source_name": "mago", "target_book": "polyanthea_medicinal", "target_name": "Magi\u017ftri", "similarity": 0.884}], "id": 1989, "stable_key": "clu_7ce5b60eee605d8c", "ground_truth": {"modern_name": "Magician", "confidence": "medium", "type": "person", "description": "Practitioner of magic, wise man, or master of a craft.", "note": "The cluster includes terms that can refer to practitioners of magic, wise men (like the Magi), and masters of a trade or discipline, suggesting a broad meaning that might not always align strictly with 'magician'."}}, {"canonical_name": "Servius", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "servius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Servius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Servius"], "contexts": ["ancient authority on Centaur origins"]}, {"entity_id": "servius", "book_id": "kosmos_humboldt_1845", "name": "Servius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Servius"], "contexts": ["ancient commentator on Virgil"]}, {"entity_id": "servius", "book_id": "coloquios_da_orta_1563", "name": "Servius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Servius"], "contexts": ["quoted regarding Ethiopia and India"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Servius", "target_book": "kosmos_humboldt_1845", "target_name": "Servius", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Servius", "target_book": "coloquios_da_orta_1563", "target_name": "Servius", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Servius", "target_book": "coloquios_da_orta_1563", "target_name": "Servius", "similarity": 1.0}], "id": 1990, "stable_key": "clu_f9b323fff3d353b8", "ground_truth": {"modern_name": "Servius", "confidence": "high", "type": "person", "description": "Roman grammarian and commentator on Virgil", "note": "The contexts describe Servius as an ancient authority on classical literature and history, fitting the identification of Servius Grammaticus, the Roman commentator on Virgil.", "wikipedia_extract": "Galba ( GAL-b\u0259; born Servius Sulpicius Galba; 24 December 3 BC \u2013 15 January AD 69) was Roman emperor, ruling for 7 months from 8 June AD 68 to 15 January 69. He was the first emperor in the Year of the Four Emperors and assumed the throne following Emperor Nero's suicide. Born into a wealthy family, Galba held at various times the positions of praetor, consul, and governor of the provinces of Gallia Aquitania, Germania Superior, and Africa during the first half of the first century AD. He retired from his positions during the latter part of Claudius' reign (with the advent of Agrippina the Younger), but Nero later granted him the governorship of Hispania. Taking advantage of the defeat of Vindex's rebellion and Nero's suicide, he became emperor with the support of the Praetorian Guard. Galba's physical weakness and general apathy led to his rule being dominated by favorites.", "wikipedia_url": "https://en.wikipedia.org/wiki/Galba"}}, {"canonical_name": "Metaphors", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "metaphors", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Metaphors", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Metaphors"], "contexts": ["figurative language"]}, {"entity_id": "metaphor", "book_id": "principles_of_psychology_james_1890", "name": "metaphor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["metaphor"], "contexts": ["figure of speech comparing dissimilar things"]}, {"entity_id": "metaphors", "book_id": "first_principles_spencer_1862", "name": "metaphors", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["metaphors"], "contexts": ["figurative expressions"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Metaphors", "target_book": "principles_of_psychology_james_1890", "target_name": "metaphor", "similarity": 0.954}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Metaphors", "target_book": "first_principles_spencer_1862", "target_name": "metaphors", "similarity": 0.984}, {"source_book": "principles_of_psychology_james_1890", "source_name": "metaphor", "target_book": "first_principles_spencer_1862", "target_name": "metaphors", "similarity": 0.968}], "id": 1991, "stable_key": "clu_b1a56223b097d2fd", "ground_truth": {"modern_name": "Metaphor", "confidence": "high", "type": "concept", "wikidata_id": "Q13847217", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Metaphorocera", "wikipedia_extract": "Metaphorocera is a genus of flies in the family Tachinidae."}}, {"canonical_name": "Geber", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "geber", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Geber", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Geber"], "contexts": ["learned Arab who accepted Prophet's doctrine"]}, {"entity_id": "geber", "book_id": "historia_medicinal_monardes_1574", "name": "Geber", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Geber"], "contexts": ["authority on metal generation"]}, {"entity_id": "geber", "book_id": "polyanthea_medicinal", "name": "Geber", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Geber"], "contexts": ["learned author"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Geber", "target_book": "historia_medicinal_monardes_1574", "target_name": "Geber", "similarity": 0.665}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Geber", "target_book": "polyanthea_medicinal", "target_name": "Geber", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Geber", "target_book": "polyanthea_medicinal", "target_name": "Geber", "similarity": 0.665}], "id": 1992, "stable_key": "clu_8fe209a87a482b87", "ground_truth": {"modern_name": "Jabir ibn Hayyan", "confidence": "high", "type": "person", "birth_year": 721, "death_year": 815, "description": "Influential alchemist and chemist, credited with early scientific methods.", "note": "Often referred to by the Latinized name 'Geber' in European texts.", "wikidata_id": "Q167852", "wikidata_description": "8th-century Islamic alchemist and author", "wikipedia_url": "https://en.wikipedia.org/wiki/Jabir%20ibn%20Hayyan", "wikipedia_extract": "Ab\u016b M\u016bs\u0101 J\u0101bir ibn \u1e24ayy\u0101n (Arabic: \u0623\u064e\u0628\u0648 \u0645\u0648\u0633\u0649 \u062c\u0627\u0628\u0650\u0631 \u0628\u0650\u0646 \u062d\u064e\u064a\u0651\u0627\u0646, variously called al-\u1e62\u016bf\u012b, al-Azd\u012b, al-K\u016bf\u012b, or al-\u1e6c\u016bs\u012b), died c. 806\u2212816, is the purported author of a large number of works in Arabic, often called the Jabirian corpus. The c. 215 treatises that survive today mainly deal with alchemy and chemistry, magic, and Shi'ite religious philosophy. However, the original scope of the corpus was vast, covering a wide range of topics ranging from cosmology, astronomy and astrology, over medicine, pharmacology, zoology and botany, to metaphysics, logic, and grammar. The works attributed to Jabir, which are tentatively dated to c."}}, {"canonical_name": "Adrian", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "adrian", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Adrian", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Adrian"], "contexts": ["Emperor, determined for Aristotle"]}, {"entity_id": "adrian", "book_id": "kosmos_humboldt_1845", "name": "Adrian", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Adrian"], "contexts": ["Roman emperor"]}, {"entity_id": "adrianus", "book_id": "polyanthea_medicinal", "name": "Adrianus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Adrianus"], "contexts": ["Pontifex Sumnus, cited for plague observations"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Adrian", "target_book": "kosmos_humboldt_1845", "target_name": "Adrian", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Adrian", "target_book": "polyanthea_medicinal", "target_name": "Adrianus", "similarity": 0.914}, {"source_book": "kosmos_humboldt_1845", "source_name": "Adrian", "target_book": "polyanthea_medicinal", "target_name": "Adrianus", "similarity": 0.914}], "id": 1993, "stable_key": "clu_6310617bc6af6c16", "ground_truth": {"modern_name": "Hadrian", "confidence": "high", "type": "person", "birth_year": 76, "death_year": 138, "description": "Roman Emperor, cited for observations related to medicine and plague.", "note": "Also appears as 'Adrianus' in Latin texts.", "wikidata_id": "Q43387", "wikidata_description": "central district and city in Edirne Province, Turkey", "wikipedia_url": "https://en.wikipedia.org/wiki/Edirne", "wikipedia_extract": "Edirne (US: ; Turkish: [e.\u02c8di\u027e.ne]), historically known as Orestias, Orestiada, Adrianople, or Adriana is a city in Turkey, in the northwestern part of the province of Edirne in Eastern Thrace. Situated 7 km (4.3 mi) from the Greek and 20 km (12 mi) from the Bulgarian borders, Edirne was the second capital city of the Ottoman Empire from the 1360s to 1453, before Constantinople became its capital. The city is a commercial centre for woven textiles, silks, carpets and agricultural products and has a growing tourism industry. It is the seat of Edirne Province and Edirne District. Its population is 180,002 (2022). The city was founded and named after the Roman emperor Hadrian as Hadrianopolis (Adrianople in English, ; \u1f09\u03b4\u03c1\u03b9\u03b1\u03bd\u03bf\u03cd\u03c0\u03bf\u03bb\u03b9\u03c2 in Greek) on the site of the Greek city of Orestias, which was itself founded on an earlier Thracian settlement named Uskudama."}}, {"canonical_name": "Christian Religion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "christian_religion", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Christian Religion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Christian Religion"], "contexts": ["specific religious doctrine"]}, {"entity_id": "christianity", "book_id": "principles_of_psychology_james_1890", "name": "Christianity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Christianity"], "contexts": ["religious belief system"]}, {"entity_id": "christianity", "book_id": "kosmos_humboldt_1845", "name": "Christianity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Christianity"], "contexts": ["religion that promulgated exalted charity"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Christian Religion", "target_book": "principles_of_psychology_james_1890", "target_name": "Christianity", "similarity": 0.928}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Christian Religion", "target_book": "kosmos_humboldt_1845", "target_name": "Christianity", "similarity": 0.928}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Christianity", "target_book": "kosmos_humboldt_1845", "target_name": "Christianity", "similarity": 1.0}], "id": 1994, "stable_key": "clu_eaf225a7084125af", "ground_truth": {"modern_name": "Christians", "confidence": "high", "type": "concept", "wikidata_id": "Q5043", "wikidata_description": "Abrahamic monotheistic religion founded on the teachings, person and life of Jesus", "note": "Refers to someone adhering to Christianity."}}, {"canonical_name": "prejudice", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "prejudice", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "prejudice", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["prejudice"], "contexts": ["preconceived opinion"]}, {"entity_id": "pr\u00e9jug\u00e9", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pr\u00e9jug\u00e9", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["pr\u00e9jug\u00e9"], "contexts": ["unfounded belief or opinion"]}, {"entity_id": "prejudices", "book_id": "principles_of_psychology_james_1890", "name": "prejudices", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["prejudices"], "contexts": ["part of character, hard to escape"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "prejudice", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "pr\u00e9jug\u00e9", "similarity": 0.918}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "prejudice", "target_book": "principles_of_psychology_james_1890", "target_name": "prejudices", "similarity": 0.956}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pr\u00e9jug\u00e9", "target_book": "principles_of_psychology_james_1890", "target_name": "prejudices", "similarity": 0.904}], "id": 1995, "stable_key": "clu_4f6ed1fef56cbefe", "ground_truth": {"modern_name": "prejudice", "confidence": "high", "type": "concept", "wikidata_id": "Q742736", "wikidata_description": "partiality that prevents objective or alternative consideration of an issue or situation", "wikipedia_url": "https://en.wikipedia.org/wiki/Bias", "wikipedia_extract": "Bias is a disproportionate weight in favor of or against an idea or thing, usually in a way that is inaccurate, closed-minded, prejudicial, or unfair. Biases can be innate or learned. People may develop biases for or against an individual, a group, or a belief. In science and engineering, a bias is a systematic error. Statistical bias results from an unfair sampling of a population, or from an estimation process that does not give accurate results on average. The word appears to derive from Old Proven\u00e7al into Old French biais, \"sideways, askance, against the grain\"."}}, {"canonical_name": "fortune", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "fortune", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "fortune", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fortune"], "contexts": ["chance or luck"]}, {"entity_id": "fortune", "book_id": "english_physician_1652", "name": "Fortune", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Fortune"], "contexts": ["astrological influence"]}, {"entity_id": "good_fortune", "book_id": "principles_of_psychology_james_1890", "name": "good fortune", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["good fortune"], "contexts": ["luck or favorable circumstances"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fortune", "target_book": "english_physician_1652", "target_name": "Fortune", "similarity": 0.903}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fortune", "target_book": "principles_of_psychology_james_1890", "target_name": "good fortune", "similarity": 0.913}], "id": 1996, "stable_key": "clu_e606642a4d4c9890", "ground_truth": {"modern_name": "fortune", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "darkness", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "darkness", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "darkness", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["darkness"], "contexts": ["negative quality, from evil principle"]}, {"entity_id": "dark", "book_id": "principles_of_psychology_james_1890", "name": "dark", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dark"], "contexts": ["absence of light"]}, {"entity_id": "darkness", "book_id": "connexion_physical_sciences_somerville_1858", "name": "darkness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["darkness"], "contexts": ["absence of light"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "darkness", "target_book": "principles_of_psychology_james_1890", "target_name": "dark", "similarity": 0.952}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "darkness", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "darkness", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "dark", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "darkness", "similarity": 0.952}], "id": 1997, "stable_key": "clu_3a8a7dcd2371dc90", "ground_truth": {"modern_name": "darkness", "confidence": "high", "type": "concept"}}, {"canonical_name": "Mineral bodies", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "mineral_bodies", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mineral bodies", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Mineral bodies"], "contexts": ["non-living substances from the earth"]}, {"entity_id": "mati\u00e8res_min\u00e9rales", "book_id": "epoques_nature_buffon_1778", "name": "mati\u00e8res min\u00e9rales", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["mati\u00e8res min\u00e9rales"], "contexts": ["substances of mineral origin"]}, {"entity_id": "mineral_substances", "book_id": "kosmos_humboldt_1845", "name": "mineral substances", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["mineral substances"], "contexts": ["dissolved materials in spring water"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mineral bodies", "target_book": "epoques_nature_buffon_1778", "target_name": "mati\u00e8res min\u00e9rales", "similarity": 0.917}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mineral bodies", "target_book": "kosmos_humboldt_1845", "target_name": "mineral substances", "similarity": 0.939}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mati\u00e8res min\u00e9rales", "target_book": "kosmos_humboldt_1845", "target_name": "mineral substances", "similarity": 0.958}], "id": 1998, "stable_key": "clu_684025f2f518eba0-4", "ground_truth": {"modern_name": "Minerals", "confidence": "high", "type": "mineral", "note": "This cluster clearly refers to inorganic solid substances studied in natural philosophy and medicine, aligning directly with the modern scientific definition of minerals.", "wikidata_id": "Q7946", "wikidata_description": "naturally occurring usually inorganic substance that has a (more or less) definite chemical composition and a crystal structure", "wikipedia_url": "https://en.wikipedia.org/wiki/Mineral", "wikipedia_extract": "In geology and mineralogy, a mineral or mineral species is, broadly speaking, a solid substance with a fairly well-defined chemical composition and a specific crystal structure that occurs naturally in pure form. The geological definition of mineral normally excludes compounds that occur only in living organisms. However, some minerals are often biogenic (such as calcite) or chemically organic compounds (such as mellite). Moreover, living organisms often synthesize inorganic minerals (such as hydroxylapatite) that also occur in rocks. The concept of mineral is distinct from rock, which is any bulk solid geologic material that is relatively homogeneous at a large enough scale. A rock may consist of one type of mineral or may be an aggregate of two or more different types of minerals, spacially segregated into distinct phases."}}, {"canonical_name": "reverberation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "reverberation", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "reverberation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["reverberation"], "contexts": ["operation of heating substances"]}, {"entity_id": "reverbera\u00e7\u00e3o_do_ar", "book_id": "polyanthea_medicinal", "name": "reverbera\u00e7\u00e3o do ar", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["reverbera\u00e7\u00e3o do ar"], "contexts": ["vibration of air"]}, {"entity_id": "reverberation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "reverberation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["reverberation"], "contexts": ["repeated echoes"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "reverberation", "target_book": "polyanthea_medicinal", "target_name": "reverbera\u00e7\u00e3o do ar", "similarity": 0.889}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "reverberation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "reverberation", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "reverbera\u00e7\u00e3o do ar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "reverberation", "similarity": 0.889}], "id": 1999, "stable_key": "clu_53c3f90bcdc75223", "ground_truth": {"modern_name": "Reverberation", "confidence": "high", "type": "concept", "note": "This concept has multiple meanings: heating in furnaces, sound reflection, and echoes. The context of air vibration points to sound.", "wikidata_id": "Q468809", "wikidata_description": "persistence of sound after the sound is produced", "wikipedia_url": "https://en.wikipedia.org/wiki/Reverberation", "wikipedia_extract": "In acoustics, reverberation (commonly shortened to reverb) is a persistence of sound after it is produced. It is often created when a sound is reflected on surfaces, causing multiple reflections that build up and then decay as the sound is absorbed by the surfaces of objects in the space \u2013 which could include furniture, people, and air. This is most noticeable when the sound source stops but the reflections continue, their amplitude decreasing, until zero is reached. Reverberation is frequency dependent: the length of the decay, or reverberation time, receives special consideration in the architectural design of spaces which need to have specific reverberation times to achieve optimum performance for their intended activity. In comparison to a distinct echo, that is detectable at a minimum of 50 to 100 ms after the previous sound, reverberation is the occurrence of reflections that arrive in a sequence of less than approximately 50 ms. As time passes, the amplitude of the reflections gradually reduces to non-noticeable levels."}}, {"canonical_name": "Atoms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "atoms", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Atoms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Atoms"], "contexts": ["fundamental particles"]}, {"entity_id": "atomos", "book_id": "polyanthea_medicinal", "name": "atomos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["atomos"], "contexts": ["atoms of salt, acid, and alkali in the human body"]}, {"entity_id": "atom", "book_id": "first_principles_spencer_1862", "name": "atom", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["atom"], "contexts": ["fundamental particle of matter"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Atoms", "target_book": "polyanthea_medicinal", "target_name": "atomos", "similarity": 0.966}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Atoms", "target_book": "first_principles_spencer_1862", "target_name": "atom", "similarity": 0.869}, {"source_book": "polyanthea_medicinal", "source_name": "atomos", "target_book": "first_principles_spencer_1862", "target_name": "atom", "similarity": 0.888}], "id": 2000, "stable_key": "clu_c362e2c37fea0ea8", "ground_truth": {"modern_name": "Atom", "confidence": "high", "type": "concept", "wikidata_id": "Q9121", "wikidata_description": "smallest unit of a chemical element", "wikipedia_url": "https://en.wikipedia.org/wiki/Atom", "wikipedia_extract": "Atoms are the basic particles of the chemical elements and the fundamental building blocks of matter. An atom consists of a nucleus of protons and generally neutrons, surrounded by an electromagnetically bound swarm of electrons. The chemical elements are distinguished from each other by the number of protons that are in their atoms. For example, any atom that contains 11 protons is sodium, and any atom that contains 29 protons is copper. Atoms with the same number of protons but a different number of neutrons are called isotopes of the same element. Atoms are extremely small, typically around 100 picometers across."}}, {"canonical_name": "manganes", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "manganes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "manganes", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["manganes"], "contexts": ["mineral used in glass making"]}, {"entity_id": "manganese", "book_id": "kosmos_humboldt_1845", "name": "manganese", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["manganese"], "contexts": ["chemical element in meteoric masses"]}, {"entity_id": "manganese", "book_id": "connexion_physical_sciences_somerville_1858", "name": "manganese", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["manganese"], "contexts": ["metal in protoxides"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "manganes", "target_book": "kosmos_humboldt_1845", "target_name": "manganese", "similarity": 0.959}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "manganes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "manganese", "similarity": 0.959}, {"source_book": "kosmos_humboldt_1845", "source_name": "manganese", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "manganese", "similarity": 1.0}], "id": 2001, "stable_key": "clu_89a511e3fbe0e4a0", "ground_truth": {"modern_name": "Manganese", "confidence": "high", "type": "mineral", "wikidata_id": "Q731", "wikidata_description": "chemical element, symbol Mn and atomic number 25", "wikipedia_url": "https://en.wikipedia.org/wiki/Manganese", "wikipedia_extract": "Manganese is a chemical element; it has symbol Mn and atomic number 25. It is a hard, brittle, silvery metal, often found in minerals in combination with iron. First isolated in the 1770s, manganese is a transition metal with many industrial alloy uses, particularly in stainless steels. It improves strength, workability, and resistance to wear. Manganese oxide is used as an oxidising agent, as a rubber additive, and in glass making, fertilizers, and ceramics. Manganese sulfate can be used as a fungicide."}}, {"canonical_name": "Almanack", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "almanack", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Almanack", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Almanack"], "contexts": ["annual publication with astronomical data"]}, {"entity_id": "calendar", "book_id": "principles_of_psychology_james_1890", "name": "calendar", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["calendar"], "contexts": ["system for organizing dates"]}, {"entity_id": "calendar", "book_id": "kosmos_humboldt_1845", "name": "calendar", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["calendar"], "contexts": ["system for organizing days"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Almanack", "target_book": "principles_of_psychology_james_1890", "target_name": "calendar", "similarity": 0.914}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Almanack", "target_book": "kosmos_humboldt_1845", "target_name": "calendar", "similarity": 0.914}, {"source_book": "principles_of_psychology_james_1890", "source_name": "calendar", "target_book": "kosmos_humboldt_1845", "target_name": "calendar", "similarity": 1.0}], "id": 2002, "stable_key": "clu_c765517fbb8ea252", "ground_truth": {"modern_name": "Almanac", "confidence": "high", "type": "object", "wikidata_id": "Q96888274", "wikidata_description": "biographical dictionary of Czech physicians (1913)"}}, {"canonical_name": "Opalls", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "opalls", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Opalls", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Opalls"], "contexts": ["mineral with attractive quality"]}, {"entity_id": "opale", "book_id": "epoques_nature_buffon_1778", "name": "opale", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["opale"], "contexts": ["siliceous mineral formed from heat"]}, {"entity_id": "opal", "book_id": "kosmos_humboldt_1845", "name": "opal", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["opal"], "contexts": ["hydrated amorphous silica"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Opalls", "target_book": "epoques_nature_buffon_1778", "target_name": "opale", "similarity": 0.899}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Opalls", "target_book": "kosmos_humboldt_1845", "target_name": "opal", "similarity": 0.885}, {"source_book": "epoques_nature_buffon_1778", "source_name": "opale", "target_book": "kosmos_humboldt_1845", "target_name": "opal", "similarity": 0.981}], "id": 2003, "stable_key": "clu_f75642577abb3983", "ground_truth": {"modern_name": "Opal", "confidence": "high", "type": "mineral", "wikidata_id": "Q171058", "wikidata_description": "silica mineral"}}, {"canonical_name": "Box", "category": "PLANT", "subcategory": "TREE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "box", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Box", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Box"], "contexts": ["wood tested for electrical properties"]}, {"entity_id": "box", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "box", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["box"], "contexts": ["tree species palo Guayacan resembles"]}, {"entity_id": "box", "book_id": "historia_medicinal_monardes_1574", "name": "Box", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Box"], "contexts": ["wood comparison for Guayaci"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Box", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "box", "similarity": 0.992}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Box", "target_book": "historia_medicinal_monardes_1574", "target_name": "Box", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "box", "target_book": "historia_medicinal_monardes_1574", "target_name": "Box", "similarity": 0.992}], "id": 2004, "stable_key": "clu_fffef1e4c245231c", "ground_truth": {"modern_name": "Boxwood", "confidence": "high", "type": "plant", "linnaean": "Buxus sempervirens Linnaeus", "family": "Buxaceae", "wikidata_id": "Q27344", "wikidata_description": "species of plant", "wikipedia_extract": "Buxus sempervirens, the common box, European box, or boxwood, is a species of flowering plant in the genus Buxus, native to western and southern Europe, northwest Africa, and southwest Asia, from southern England south to northern Morocco, and east through the northern Mediterranean region to Turkey. Buxus colchica of western Caucasus and B. hyrcana of northern Iran and eastern Caucasus are commonly treated as synonyms of B. sempervirens. Buxus sempervirens is an evergreen shrub or small tree growing 1 to 9 m (3 to 30 ft) tall, with a trunk up to 20 centimetres (8 in) in diameter (exceptionally to 10 m tall and 45 cm diameter). Arranged in opposite pairs along the stems, the leaves are green to yellow-green, oval, 1.5\u20133 cm long, and 0.5\u20131.3 cm broad.", "wikipedia_url": "https://en.wikipedia.org/wiki/Buxus_sempervirens"}}, {"canonical_name": "Dantzich", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "dantzich", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Dantzich", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Dantzich"], "contexts": ["city where Bellabonus wrote"]}, {"entity_id": "dantzick", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Dantzick", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Dantzick"], "contexts": ["city in Poland"]}, {"entity_id": "danzica", "book_id": "ricettario_fiorentino_1597", "name": "Danzica", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Danzica"], "contexts": ["port where amber is found"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Dantzich", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Dantzick", "similarity": 0.925}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Dantzich", "target_book": "ricettario_fiorentino_1597", "target_name": "Danzica", "similarity": 0.909}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Dantzick", "target_book": "ricettario_fiorentino_1597", "target_name": "Danzica", "similarity": 0.889}], "id": 2005, "stable_key": "clu_41a1ad70599e073d", "ground_truth": {"wikipedia_extract": "Gda\u0144sk (Kashubian: Gdu\u0144sk; German: Danzig) is a city on the Baltic coast of northern Poland, and the capital of the Pomeranian Voivodeship. With a population of 486,492, it is Poland's sixth-largest city and its major seaport. Gda\u0144sk lies at the mouth of the Mot\u0142awa River and is situated at the southern edge of Gda\u0144sk Bay, close to the city of Gdynia and the resort town of Sopot; these form a metropolitan area called the Tricity (Tr\u00f3jmiasto), with a population of approximately 1.5 million. Gda\u0144sk was first mentioned in 997 as part of the early Polish state, and thereafter grew into a trading town under the Piast and Samboride dynasties. Shifting between Polish and Teutonic control during the Middle Ages, it subsequently joined the Hanseatic League and, with considerable autonomy, served as the Polish Crown's principal seaport and largest city until the early 18th century. With the Partitions of Poland, the city was annexed by Prussia in 1793, and was integrated into the German Empire in 1871."}}, {"canonical_name": "Siler montanum", "category": "PLANT", "subcategory": "HERB", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "siler_montanum", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Siler montanum", "category": "PLANT", "subcategory": "HERB", "count": 1, "variants": ["Siler montanum"], "contexts": ["herb with medicinal properties"]}, {"entity_id": "siler_montanum", "book_id": "coloquios_da_orta_1563", "name": "siler montanum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["siler montanum"], "contexts": ["mountain celery"]}, {"entity_id": "siler_monta", "book_id": "polyanthea_medicinal", "name": "Siler monta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Siler monta"], "contexts": ["ingredient in an electuary remedy"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Siler montanum", "target_book": "coloquios_da_orta_1563", "target_name": "siler montanum", "similarity": 0.769}, {"source_book": "coloquios_da_orta_1563", "source_name": "siler montanum", "target_book": "polyanthea_medicinal", "target_name": "Siler monta", "similarity": 0.943}], "id": 2006, "stable_key": "clu_e181b3e6512171fa", "ground_truth": {"wikipedia_extract": "Siler montanum, the laserwort, is a herbaceous perennial plant in the family Apiaceae. It is a robust perennial that can reach a height of about 30\u2013100 centimetres (12\u201339 in). It has bipinnate, alternate leaves, and produces compound umbels of white five-stellate flowers from June to August. This species can be found in central and southern Europe, in the Alps, the Pyrenees, the Apennine Mountains and the Iberian Mountains. It occurs in gorges and rocky slopes at elevations of 800\u20132,250 metres (2,620\u20137,380 ft). The roots and seeds can be used as spices. and have been used in making gruit or beer Siler montanum subsp. apuanum F.Conti & Bartolucci \u2013 central Italy (Apuan Alps) Siler montanum subsp. corrasianum Bacch., Congiu, F.Conti & Bartolucci \u2013 Sardinia Siler montanum subsp. montanum \u2013 Alps, Pyrenees, and Iberian Mountains Siler montanum subsp. ogliastrinum Bacch., F.Conti & Bartolucci \u2013 Sardinia Siler montanum subsp. stabianum (Lacaita) F.Conti & Bartolucci \u2013 Italy (central and southern Apennines) Siler montanum Crantz."}}, {"canonical_name": "Eagle", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "eagle", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Eagle", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Eagle"], "contexts": ["animal with protective quality"]}, {"entity_id": "eagle", "book_id": "english_physician_1652", "name": "Eagle", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Eagle"], "contexts": ["bird that scorns to meddle with a fly"]}, {"entity_id": "eagle", "book_id": "origin_of_species_darwin_1859", "name": "eagle", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["eagle"], "contexts": ["bird with a perfect eye"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Eagle", "target_book": "english_physician_1652", "target_name": "Eagle", "similarity": 0.897}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Eagle", "target_book": "origin_of_species_darwin_1859", "target_name": "eagle", "similarity": 0.936}], "id": 2007, "stable_key": "clu_2ee43c90cb1eb460", "ground_truth": {"modern_name": "Eagle", "confidence": "high", "type": "animal"}}, {"canonical_name": "shoulders", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "shoulders", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "shoulders", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["shoulders"], "contexts": ["joint connecting arm to torso"]}, {"entity_id": "shoulders", "book_id": "english_physician_1652", "name": "shoulders", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["shoulders"], "contexts": ["body part, pains are eased"]}, {"entity_id": "shoulders", "book_id": "principles_of_psychology_james_1890", "name": "shoulders", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["shoulders"], "contexts": ["part of the upper torso"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "shoulders", "target_book": "english_physician_1652", "target_name": "shoulders", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "shoulders", "target_book": "principles_of_psychology_james_1890", "target_name": "shoulders", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "shoulders", "target_book": "principles_of_psychology_james_1890", "target_name": "shoulders", "similarity": 1.0}], "id": 2008, "stable_key": "clu_86f26e5facb708ea", "ground_truth": {"modern_name": "Shoulder joint", "confidence": "high", "type": "concept", "note": "The term 'shoulders' in the provided contexts refers to the anatomical region and joint, not a substance.", "wikidata_id": "Q1758798", "wikidata_description": "synovial ball and socket joint in the shoulder", "wikipedia_url": "https://en.wikipedia.org/wiki/Shoulder%20joint", "wikipedia_extract": "The shoulder joint (or glenohumeral joint from Greek glene, eyeball, + -oid, 'form of', + Latin humerus, shoulder) is structurally classified as a synovial ball-and-socket joint and functionally as a diarthrosis and multiaxial joint. It involves an articulation between the glenoid fossa of the scapula (shoulder blade) and the head of the humerus (upper arm bone). Due to the very loose joint capsule, it gives a limited interface of the humerus and scapula and is the most mobile joint of the human body. The shoulder joint is a ball-and-socket joint between the scapula and the humerus. The socket of the glenoid fossa of the scapula is itself quite shallow, but it is made deeper by the addition of the glenoid labrum. The glenoid labrum is a ring of cartilaginous fibre attached to the circumference of the cavity."}}, {"canonical_name": "meatus", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "meatus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "meatus", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["meatus"], "contexts": ["passages or openings"]}, {"entity_id": "meatus", "book_id": "kosmos_humboldt_1845", "name": "meatus", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["meatus"], "contexts": ["openings or passages"]}, {"entity_id": "meatos", "book_id": "polyanthea_medicinal", "name": "meatos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["meatos"], "contexts": ["passageways"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "meatus", "target_book": "kosmos_humboldt_1845", "target_name": "meatus", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "meatus", "target_book": "polyanthea_medicinal", "target_name": "meatos", "similarity": 0.93}, {"source_book": "kosmos_humboldt_1845", "source_name": "meatus", "target_book": "polyanthea_medicinal", "target_name": "meatos", "similarity": 0.93}], "id": 2009, "stable_key": "clu_8487882258499c31", "ground_truth": {"modern_name": "Meatus", "confidence": "high", "type": "concept", "note": "Refers to anatomical passages or openings.", "wikidata_id": "Q748953", "wikidata_description": "anatomical cavity that filters vocalizations", "wikipedia_url": "https://en.wikipedia.org/wiki/Vocal%20tract", "wikipedia_extract": "The vocal tract or speech apparatus is the cavity in mammals and in birds where the sound produced at the sound source (larynx in mammals; syrinx in birds) is filtered. In mammals, it consists of the laryngeal cavity, the pharynx, the oral cavity, and the nasal cavity. In birds, it consists of the trachea, the syrinx, the oral cavity, the upper part of the esophagus, and the beak. The estimated average length of the vocal tract in men is 16.9 cm and 14.1 cm in women."}}, {"canonical_name": "Animation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "animation", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Animation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Animation"], "contexts": ["prerequisite for birth"]}, {"entity_id": "animate", "book_id": "principles_of_psychology_james_1890", "name": "animate", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["animate"], "contexts": ["living or having life"]}, {"entity_id": "animates", "book_id": "kosmos_humboldt_1845", "name": "animates", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["animates"], "contexts": ["gives life or spirit"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Animation", "target_book": "principles_of_psychology_james_1890", "target_name": "animate", "similarity": 0.92}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Animation", "target_book": "kosmos_humboldt_1845", "target_name": "animates", "similarity": 0.916}, {"source_book": "principles_of_psychology_james_1890", "source_name": "animate", "target_book": "kosmos_humboldt_1845", "target_name": "animates", "similarity": 0.969}], "id": 2010, "stable_key": "clu_4a6b4cb816813879-3", "ground_truth": {"modern_name": "Vitalism", "confidence": "high", "type": "concept", "note": "The phrases 'vital activity', 'vital actions', and 'life force' are hallmarks of the philosophical concept of vitalism.", "wikidata_id": "Q137271198", "wikidata_description": "nonprofit organisation from the Netherlands"}}, {"canonical_name": "rotation du globe", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "rotation_du_globe", "book_id": "epoques_nature_buffon_1778", "name": "rotation du globe", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["rotation du globe"], "contexts": ["abstract ideas, theories, mental faculties, and processes"]}, {"entity_id": "earth's_rotation", "book_id": "kosmos_humboldt_1845", "name": "Earth's rotation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Earth's rotation"], "contexts": ["planet's spinning motion"]}, {"entity_id": "rotation_of_planets", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Rotation of Planets", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Rotation of Planets"], "contexts": ["spinning of planets"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "rotation du globe", "target_book": "kosmos_humboldt_1845", "target_name": "Earth's rotation", "similarity": 0.943}, {"source_book": "epoques_nature_buffon_1778", "source_name": "rotation du globe", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Rotation of Planets", "similarity": 0.89}, {"source_book": "kosmos_humboldt_1845", "source_name": "Earth's rotation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Rotation of Planets", "similarity": 0.898}], "id": 2011, "stable_key": "clu_827e6d273fdc6c67", "ground_truth": {"modern_name": "Earth's rotation", "confidence": "high", "type": "concept", "wikidata_id": "Q20521710", "wikidata_description": ""}}, {"canonical_name": "courants d\u2019eau", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "courants_d\u2019eau", "book_id": "epoques_nature_buffon_1778", "name": "courants d\u2019eau", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["courants d\u2019eau"], "contexts": ["abstract ideas, theories, mental faculties, and processes"]}, {"entity_id": "currents_of_water", "book_id": "kosmos_humboldt_1845", "name": "currents of water", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["currents of water"], "contexts": ["flow of water"]}, {"entity_id": "currents_of_water", "book_id": "first_principles_spencer_1862", "name": "currents of water", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["currents of water"], "contexts": ["selective action for particle separation"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "courants d\u2019eau", "target_book": "kosmos_humboldt_1845", "target_name": "currents of water", "similarity": 0.929}, {"source_book": "epoques_nature_buffon_1778", "source_name": "courants d\u2019eau", "target_book": "first_principles_spencer_1862", "target_name": "currents of water", "similarity": 0.929}, {"source_book": "kosmos_humboldt_1845", "source_name": "currents of water", "target_book": "first_principles_spencer_1862", "target_name": "currents of water", "similarity": 1.0}], "id": 2012, "stable_key": "clu_23777a8ace3df4fe-2", "ground_truth": {"modern_name": "Electric current", "confidence": "high", "type": "concept", "note": "The context 'inducing state upon matter' points towards electrical phenomena, distinguishing it from purely oceanic or hydraulic currents.", "wikidata_id": "Q11651", "wikidata_description": "flow of electric charge", "wikipedia_url": "https://en.wikipedia.org/wiki/Electric%20current", "wikipedia_extract": "An electric current is a flow of charged particles, such as electrons or ions, moving through an electrical conductor or space. It is defined as the net rate of flow of electric charge through a surface. The moving particles are called charge carriers, which may be one of several types of particles, depending on the conductor. In electric circuits the charge carriers are often electrons moving through a wire. In semiconductors they can be electrons or holes. In an electrolyte the charge carriers are ions, while in plasma, an ionized gas, they are ions and electrons."}}, {"canonical_name": "mati\u00e8res argileuses", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "mati\u00e8res_argileuses", "book_id": "epoques_nature_buffon_1778", "name": "mati\u00e8res argileuses", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["mati\u00e8res argileuses"], "contexts": ["clayey materials"]}, {"entity_id": "argiles_boueuses", "book_id": "relation_historique_humboldt_vol3_1825", "name": "argiles boueuses", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["argiles boueuses"], "contexts": ["muddy clays ejected"]}, {"entity_id": "argillaceous_substances", "book_id": "kosmos_humboldt_1845", "name": "argillaceous substances", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["argillaceous substances"], "contexts": ["clay-like materials"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "mati\u00e8res argileuses", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "argiles boueuses", "similarity": 0.884}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mati\u00e8res argileuses", "target_book": "kosmos_humboldt_1845", "target_name": "argillaceous substances", "similarity": 0.938}], "id": 2013, "stable_key": "clu_ba87d0ee774