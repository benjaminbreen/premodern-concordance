ria_medicinal_monardes_1574", "name": "volc\u00e1", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["volc\u00e1"], "contexts": ["volcano near Nicaragua sulphur"]}, {"entity_id": "volcanic_eruptions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "volcanic eruptions", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["volcanic eruptions"], "contexts": ["expulsion of molten rock and gases", "recorded geological events"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "volcans \u00e9teints", "target_book": "kosmos_humboldt_1845", "target_name": "volcanoes", "similarity": 0.89}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "volcan", "target_book": "kosmos_humboldt_1845", "target_name": "volcanoes", "similarity": 0.95}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "volcan", "target_book": "historia_medicinal_monardes_1574", "target_name": "volc\u00e1", "similarity": 0.946}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "volcan", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "volcanic eruptions", "similarity": 0.89}, {"source_book": "kosmos_humboldt_1845", "source_name": "volcanoes", "target_book": "historia_medicinal_monardes_1574", "target_name": "volc\u00e1", "similarity": 0.913}, {"source_book": "kosmos_humboldt_1845", "source_name": "volcanoes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "volcanic eruptions", "similarity": 0.94}], "id": 161, "stable_key": "clu_e54403f6fb6d1b38", "ground_truth": {"modern_name": "volcano", "confidence": "high", "type": "object", "wikidata_id": "Q8072", "wikidata_description": "natural, surface vent or fissure usually in a mountainous form", "wikipedia_url": "https://en.wikipedia.org/wiki/Volcano", "wikipedia_extract": "A volcano is commonly defined as a vent or fissure in the crust of a planetary-mass object, such as Earth, that allows hot lava, volcanic ash, and gases to escape from a magma chamber below the surface. On Earth, volcanoes are most often found where tectonic plates are diverging or converging, and because most of Earth's plate boundaries are underwater, most volcanoes are found underwater. For example, a mid-ocean ridge, such as the Mid-Atlantic Ridge, has volcanoes caused by divergent tectonic plates whereas the Pacific Ring of Fire has volcanoes caused by convergent tectonic plates. Volcanoes resulting from divergent tectonic activity are usually non-explosive whereas those resulting from convergent tectonic activity cause violent eruptions. Volcanoes can also form where there is stretching and thinning of the crust's plates, such as in the East African Rift, the Wells Gray-Clearwater volcanic field, and the Rio Grande rift in North America. Volcanism away from plate boundaries most likely arises from upwelling diapirs from the core\u2013mantle boundary called mantle plumes, 3,000 kilometres (1,900 mi) deep within Earth."}}, {"canonical_name": "Chemistry", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 27, "members": [{"entity_id": "chemistry", "book_id": "medecine_experimentale_bernard_1865", "name": "chemistry", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["chemistry"], "contexts": ["laws governing phenomena", "study of matter and its properties"]}, {"entity_id": "chymistry", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Chymistry", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Chymistry"], "contexts": ["art of separating substances"]}, {"entity_id": "chemistry", "book_id": "principles_of_psychology_james_1890", "name": "chemistry", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Chemistry", "chemistry"], "contexts": ["Science of matter and its properties", "science of element