rimentale_bernard_1865", "name": "triangle", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["triangle"], "contexts": ["geometric shape with three angles"]}, {"entity_id": "triangle", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Triangle", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Triangle"], "contexts": ["geometric shape with three angles"]}, {"entity_id": "triangles", "book_id": "relation_historique_humboldt_vol3_1825", "name": "triangles", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["triangles"], "contexts": ["used for linking coasts"]}, {"entity_id": "triangles", "book_id": "connexion_physical_sciences_somerville_1858", "name": "triangles", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["triangles"], "contexts": ["geometric shapes for surveying"]}, {"entity_id": "spherical_triangles", "book_id": "connexion_physical_sciences_somerville_1858", "name": "spherical triangles", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["spherical triangles"], "contexts": ["triangles on a sphere's surface"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "triangle", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Triangle", "similarity": 0.995}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "triangle", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "triangles", "similarity": 0.926}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "triangle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "triangles", "similarity": 0.926}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "triangle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "spherical triangles", "similarity": 0.881}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Triangle", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "triangles", "similarity": 0.921}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Triangle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "triangles", "similarity": 0.921}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "triangles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "triangles", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "triangles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "spherical triangles", "similarity": 0.941}], "id": 758, "stable_key": "clu_cea0ef9703be4f6b", "ground_truth": {"modern_name": "triangle", "confidence": "high", "type": "object", "wikidata_id": "Q201735", "wikidata_description": "idiophone type of musical instrument in the percussion family", "wikipedia_url": "https://en.wikipedia.org/wiki/Triangle%20%28musical%20instrument%29", "wikipedia_extract": "The triangle, or  musical triangle, is a musical instrument in the percussion family, classified as an idiophone in the Hornbostel-Sachs classification system. Triangles are made from a variety of metals including aluminum, beryllium copper, brass, bronze, iron, and steel. The metal is bent into a triangular shape with one open end. The instrument is usually held by a loop of some form of thread or wire at the top curve to enable the triangle to vibrate, and it is struck with a metal rod called a \"beater\". The triangle theoretically has indefinite pitch, and produces a plurality of overtones when struck with an appropriate beater. Iconography is the primary source for knowledge of the history of the triangle, and provides insight into the musical and social context in which the instrument developed."}}, {"canonical_name": "Scepticism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "scepticisme", "book_id": "medecine_experimentale_bernard_1865", "name": "scepticisme", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["scepticisme"], "contexts": ["attitude of disbelief or doubt"]}, {"entity_id": "scepticism", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Scepticism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Scepticism"], "contexts": ["obstinate and irrational doubt", "attitude of doubt towards knowledge"]}, {"entity_id": "scepticismo_scientif\u00edco", "book_id": "coloquios_da_orta_1563", "name": "scepticismo scientif\u00edco", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["scepticismo scientif\u00edco"], "contexts": ["scientific skepticism"]}, {"entity_id": "scepticism", "book_id": "first_principles_spencer_1862", "name": "scepticism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["scepticism"], "contexts": ["philosophical stance of doubt"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "scepticisme", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Scepticism", "similarity": 0.965}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "scepticisme", "target_book": "coloquios_da_orta_1563", "target_name": "scepticismo scientif\u00edco", "similarity": 0.93}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "scepticisme", "target_book": "first_principles_spencer_1862", "target_name": "scepticism", "similarity": 0.998}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Scepticism", "target_book": "coloquios_da_orta_1563", "target_name": "scepticismo scientif\u00edco", "similarity": 0.914}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Scepticism", "target_book": "first_principles_spencer_1862", "target_name": "scepticism", "similarity": 0.965}, {"source_book": "coloquios_da_orta_1563", "source_name": "scepticismo scientif\u00edco", "target_book": "first_principles_spencer_1862", "target_name": "scepticism", "similarity": 0.928}], "id": 759, "stable_key": "clu_b47507f65e6453a6", "ground_truth": {"modern_name": "Skepticism", "confidence": "high", "type": "concept", "wikidata_id": "Q1395219", "wikidata_description": "questioning attitude or doubt toward knowledge claims that are seen as mere belief or dogma", "wikipedia_url": "https://en.wikipedia.org/wiki/Skepticism", "wikipedia_extract": "Skepticism (US) or scepticism (UK) is a questioning attitude or doubt toward knowledge claims that are seen as mere belief or dogma. For example, if a person is skeptical about claims made by their government about an ongoing war then the person doubts that these claims are accurate. In such cases, skeptics normally recommend not disbelief but suspension of belief, i.e. maintaining a neutral attitude that neither affirms nor denies the claim. This attitude is often motivated by the impression that the available evidence is insufficient to support the claim. Formally, skepticism is a topic of interest in philosophy, particularly epistemology."}}, {"canonical_name": "organic compounds", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "mati\u00e8res_organiques", "book_id": "medecine_experimentale_bernard_1865", "name": "mati\u00e8res organiques", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["mati\u00e8res organiques"], "contexts": ["dissolved in organic aqueous media"]}, {"entity_id": "organic_substances", "book_id": "kosmos_humboldt_1845", "name": "organic substances", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["organic substances"], "contexts": ["substances of living origin"]}, {"entity_id": "organic_substances", "book