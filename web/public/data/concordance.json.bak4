: "spirit", "target_book": "english_physician_1652", "target_name": "Spirit", "similarity": 0.646}], "id": 631, "stable_key": "clu_3b8f8ec8a00ec41a", "ground_truth": {"modern_name": "animal spirits", "confidence": "high", "type": "concept", "note": "In early modern physiology, 'animal spirits' referred to a vital fluid believed to transmit impulses from the brain and nerves.", "wikidata_id": "Q4764907", "wikidata_description": "book by George Akerlof"}}, {"canonical_name": "Brionia", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 10, "members": [{"entity_id": "briony", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Briony", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Briony"], "contexts": ["plant species", "plant with monstrous root"]}, {"entity_id": "briony", "book_id": "english_physician_1652", "name": "Briony", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Briony"], "contexts": ["plant with medicinal properties", "plant with roots used for medicinal purposes"]}, {"entity_id": "brionia", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "brionia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["brionia"], "contexts": ["plant referred to by indigenous people as ehichic amolli"]}, {"entity_id": "brionia", "book_id": "ricettario_fiorentino_1597", "name": "Brionia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Brionia", "brionia"], "contexts": ["root collected and dried", "herb mentioned in the passage"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Briony", "target_book": "english_physician_1652", "target_name": "Briony", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Briony", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "brionia", "similarity": 0.903}, {"source_book": "pseudodoxi