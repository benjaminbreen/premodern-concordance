surrate", "book_id": "coloquios_da_orta_1563", "name": "Surrate", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Surrate"], "contexts": ["origin of a type of camphor", "maritime city receiving merchandise"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Surrate", "target_book": "coloquios_da_orta_1563", "target_name": "Surrate", "similarity": 0.732}], "id": 3418, "stable_key": "clu_8e53d0f6dc777326", "ground_truth": {"modern_name": "Surat", "confidence": "high", "type": "place", "country": "India", "wikidata_id": "Q26759850", "wikidata_description": "island in Aru Islands Regency, Maluku Province, Indonesia"}}, {"canonical_name": "Flandres", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "flandres", "book_id": "coloquios_da_orta_1563", "name": "Flandres", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Flandres"], "contexts": ["location of Portuguese trading posts", "location where rab\u00f4 pepper was sent"]}, {"entity_id": "flandres", "book_id": "polyanthea_medicinal", "name": "Flandres", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Flandres", "Flandes"], "contexts": ["region mentioned with hair entanglement", "region governed"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Flandres", "target_book": "polyanthea_medicinal", "target_name": "Flandres", "similarity": 0.929}], "id": 3419, "stable_key": "clu_cac026542a8e1d6b", "ground_truth": {"modern_name": "Flanders", "confidence": "high", "type": "place", "country": "Belgium, France, Netherlands", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Gulf-stream", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "gulf-stream", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Gulf-stream", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Gulf-stream", "GulJ-stream", "Gulf-siream"], "contexts": ["warm waters influencing climate", "ocean current with variable direction"]}, {"entity_id": "gulf-stream", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Gulf-stream", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Gulf-stream"], "contexts": ["warm ocean current in the Atlantic"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Gulf-stream", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Gulf-stream", "similarity": 1.0}], "id": 3420, "stable_key": "clu_cc078f1f8673d5e7", "ground_truth": {"modern_name": "Gulf Stream", "confidence": "high", "type": "concept", "wikidata_id": "Q34771011", "wikidata_description": "river in Somerset County, Maine, United States of America", "wikipedia_extract": "The Gulf Stream is a warm and swift Atlantic ocean current that originates in the Gulf of Mexico and flows through the Straits of Florida and up the eastern coastline of the United States, then veers east near 36\u00b0N latitude  (North Carolina) and moves toward Northwest Europe as the North Atlantic Current. The process of western intensification causes the Gulf Stream to be a northward-accelerating current off the east coast of North America. Around 40\u00b00\u2032N 30\u00b00\u2032W, it splits in two, with the northern stream, the North Atlantic Drift, crossing to Northern Europe and the southern stream, the Canary Current, recirculating off West Africa. The Gulf Stream influences the climate of the coastal areas of the East Coast of the United States from Florida to southeast Virginia (near 36\u00b0N latitude), and to a greater degree, the climate of Northwest Europe. A consensus exists that the climate of Northwest Europe is warmer than other areas of similar latitude at least partially because of the strong North Atlantic Current. It is part of the North Atlantic Gyre."}}, {"canonical_name": "diallage m\u00e9tallo\u00efde", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "diallage_m\u00e9tallo\u00efde", "book_id": "relation_historique_humboldt_vol3_1825", "name": "diallage m\u00e9tallo\u00efde", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["diallage m\u00e9tallo\u00efde", "diallage", "diallage metallo\u00efde"], "contexts": ["mineral found in serpentine", "metallic diallage"]}, {"entity_id": "diallage", "book_id": "kosmos_humboldt_1845", "name": "diallage", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["diallage"], "contexts": ["mineral laminae"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "diallage m\u00e9tallo\u00efde", "target_book": "kosmos_humboldt_1845", "target_name": "diallage", "similarity": 0.909}], "id": 3421, "stable_key": "clu_bd9fbc86c94e175b", "ground_truth": {"modern_name": "Diallage", "confidence": "high", "type": "mineral", "note": "'Diallage m\u00e9tallo\u00efde' refers to a specific variety of diallage.", "wikipedia_extract": "Diallage is an inosilicate, meaning it is a chain silicate, and is a part of the pyroxene group. Diallage is a junction between augite and diopside, just like fassaite. It was named in 1801 by Ren\u00e9 Just Ha\u00fcy. Its name derives from the Greek word diallagh\u00e9 (meaning change, transform, difference), as its composition differs from that of the other minerals in the pyroxene group. It is a fairly common mineral, and is cheap. Diallage is typically an opaque mineral, but translucent specimens can occur."}}, {"canonical_name": "Ramon de la Sagra", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "ramon_de_la_sagra", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Ramon de la Sagra", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Ramon de la Sagra", "Don Ramon DE LA SaGBA", "M. Ramon de la Sagra", "M. Ramun de la Sagra"], "contexts": ["author of Analts de Cttncias and memoir", "author cited for sugar cane information"]}, {"entity_id": "sagra,_ramon_de_la", "book_id": "kosmos_humboldt_1845", "name": "Sagra, Ramon de la", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Sagra, Ramon de la"], "contexts": ["observations on rain quantity in Havana"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ramon de la Sagra", "target_book": "kosmos_humboldt_1845", "target_name": "Sagra, Ramon de la", "similarity": 0.896}], "id": 3422, "stable_key": "clu_c450723ff1b66d6c", "ground_truth": {"modern_name": "Ram\u00f3n de la Sagra", "confidence": "high", "type": "person", "birth_year": 1798, "death_year": 1871, "description": "Cuban naturalist, economist, and writer.", "wikidata_id": "Q973094", "wikidata_description": "Spanish economist, sociologist, botanist, and political writer (1798\u20131871)"}}, {"canonical_name": "Rio Apure", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "rio_apure", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rio Apure", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Rio Apure"], "contexts": ["river bordering the Llanos", "river in Venezuela"]}, {"entity_id": "rio_apure", "book_id": "kosmos_humboldt_1845", "name": "Rio Apure", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Rio Apure"], "contexts": ["river falling into the Orinoco"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rio Apure", "target_book": "kosmos_humboldt_1845", "target_name": "Rio Apure", "similarity": 1.0}], "id": 3423, "stable_key": "clu_c0b8a1e3c2911fe2", "ground_truth": {"modern_name": "Apure River", "confidence": "high", "type": "place", "country": "Venezuela", "wikidata_id": "Q853315", "wikidata_description": "river in Venezuela"}}, {"canonical_name": "Harz", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "harz", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Harz", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Harz"], "contexts": ["location of granite chains", "mountain range"]}, {"entity_id": "harz", "book_id": "kosmos_humboldt_1845", "name": "Harz", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Harz"], "contexts": ["mountain range with mines"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Harz", "target_book": "kosmos_humboldt_1845", "target_name": "Harz", "similarity": 1.0}], "id": 3424, "stable_key": "clu_33c600981f65c88b", "ground_truth": {"modern_name": "Harz Mountains", "confidence": "high", "type": "place", "country": "Germany", "wikidata_id": "Q4186", "wikidata_description": "low mountain range in northern Germany", "wikipedia_extract": "The Hexentanzplatz (literally \u201cWitches\u2032 Dance Floor\u201d) in the Harz mountains is a plateau (454 m above sea level (NN)) that lies high above the Bode Gorge, opposite the Rosstrappe in Saxony-Anhalt, Germany. The Hexentanzplatz is reputedly an Old Saxon cult site, at which pagan celebrations were held in honour of the so-called Hagedisen (forest and mountain goddesses), particularly on the night of 1 May. The place did not become known as the Hexentanzplatz until the cult was banned by the invading Christian Franks. According to tradition the site was guarded by Frankish soldiers in order to enforce the ban and they were chased off by Saxons dressed as witches and riding on broomsticks. Another old Saxon cult site is found on the Brocken. Above the Hexentanzplatz are the remains of the Sachsenwall (\u201cSaxon Dyke\u201d), a wall of granite rocks and possibly part of a larger fortification, more than 1,500 years old.", "wikipedia_url": "https://en.wikipedia.org/wiki/Harz"}}, {"canonical_name": "Bahia", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "bahia", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bahia", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Bahia"], "contexts": ["port that received slaves", "city and region"]}, {"entity_id": "bahia", "book_id": "kosmos_humboldt_1845", "name": "Bahia", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bahia"], "contexts": ["city in Brazil"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bahia", "target_book": "kosmos_humboldt_1845", "target_name": "Bahia", "similarity": 1.0}], "id": 3425, "stable_key": "clu_040efc22572f3dca", "ground_truth": {"modern_name": "Bahia", "confidence": "high", "type": "place", "country": "Brazil", "wikidata_id": "Q2236958", "wikidata_description": "genus of plants", "wikipedia_extract": "Bahia (English: , b\u0259-(H)EE-\u0259; Brazilian Portuguese: [ba\u02c8i.\u0250] ) is one of the 26 states of Brazil, located in the Northeast Region of the country. It is the fourth-largest Brazilian state by population (after S\u00e3o Paulo, Minas Gerais, and Rio de Janeiro) and the 5th-largest by area. Bahia's capital is the city of Salvador (formerly known as \"Cidade do S\u00e3o Salvador da Bahia de Todos os Santos\", literally \"City of the Holy Savior of the Bay of All the Saints\"), on a spit of land separating the Bay of All Saints from the Atlantic. Once a stronghold of supporters of direct rule of Brazil by the Portuguese monarchy, and dominated by agricultural, slaving, and ranching interests, Bahia is now a predominantly working-class industrial and agricultural state. The state is home to 7% of the Brazilian population and produces 4.2% of the country's GDP. It is divided into 417 municipalities.", "wikipedia_url": "https://en.wikipedia.org/wiki/Bahia"}}, {"canonical_name": "Rio de la Madeira", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "rio_de_la_madeira", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rio de la Madeira", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Rio de la Madeira"], "contexts": ["river forming a boundary", "river mentioned in relation to portage"]}, {"entity_id": "rio_de_madeira", "book_id": "kosmos_humboldt_1845", "name": "Rio de Madeira", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Rio de Madeira"], "contexts": ["river in South America"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rio de la Madeira", "target_book": "kosmos_humboldt_1845", "target_name": "Rio de Madeira", "similarity": 0.987}], "id": 3426, "stable_key": "clu_1eeb729a643c1f8c", "ground_truth": {"modern_name": "Madeira River", "confidence": "high", "type": "place", "country": "Brazil", "wikidata_id": "Q118251", "wikidata_description": "river in Bolivia and Brazil"}}, {"canonical_name": "Guatire", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "guatire", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Guatire", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Guatire"], "contexts": ["location within Caracas", "place name in Venezuela"]}, {"entity_id": "guate", "book_id": "coloquios_da_orta_1563", "name": "Guate", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Guate"], "contexts": ["mountain", "name of a mountain range"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Guatire", "target_book": "coloquios_da_orta_1563", "target_name": "Guate", "similarity": 0.931}], "id": 3427, "stable_key": "clu_9b91d16b51a98d80", "ground_truth": {"modern_name": "Guatire", "confidence": "high", "type": "place", "country": "Venezuela", "note": "The mention of 'Guate' in the context of Garcia de Orta's works from 1563, which focused on the East Indies, might suggest an East Asian locality. However, given the overwhelming association of 'Guatire' with Venezuela in Humboldt's works, and the possibility of similar sounding place names or transcription errors, the Venezuelan location is considered the primary referent, especially in a broader early modern geographical context. Further disambiguation would require deeper textual analysis.", "wikidata_id": "Q1026987", "wikidata_description": "city in Venezuela"}}, {"canonical_name": "Tobolsk", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "tobolsk", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tobolsk", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Tobolsk"], "contexts": ["city in Siberia", "location of magnetic force comparison"]}, {"entity_id": "tobolsk", "book_id": "kosmos_humboldt_1845", "name": "Tobolsk", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Tobolsk"], "contexts": ["city in Asiatic Continent", "city in Western Siberia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tobolsk", "target_book": "kosmos_humboldt_1845", "target_name": "Tobolsk", "similarity": 1.0}], "id": 3428, "stable_key": "clu_8304c3900aa83872", "ground_truth": {"modern_name": "Tobolsk", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q168782", "wikidata_description": "town in Tyumen Oblast, Russia", "wikipedia_url": "https://en.wikipedia.org/wiki/Tobolsk", "wikipedia_extract": "Tobolsk (Russian: \u0422\u043e\u0431\u043e\u0301\u043b\u044c\u0441\u043a, IPA: [t\u0250\u02c8bol\u02b2sk]) is a town in Tyumen Oblast, Russia, located at the confluence of the Tobol and Irtysh rivers. Founded in 1587, Tobolsk is the second-oldest Russian settlement east of the Ural Mountains in Asian Russia, and was the historic capital of the Siberia region. Population: 100,352\u2009(2021 census); 99,694\u2009(2010 census); 92,880\u2009(2002 census); 94,143\u2009(1989 Soviet census). The town was founded on the site of the Tatar town of Sibir-tura. In 1580, a group of Yermak Timofeyevich's Cossacks initiated the Russian conquest of Siberia, pushing eastwards on behalf of the Tsardom of Russia. After a year of Tatar attacks, Yermak prepared for the conquest of the Khanate of Sibir and a campaign to take the Khanate's capital city, Qashliq."}}, {"canonical_name": "Cincinnati", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "cincinnati", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cincinnati", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Cincinnati"], "contexts": ["city near Petit Miami", "city where shell was discovered"]}, {"entity_id": "cincinnati", "book_id": "kosmos_humboldt_1845", "name": "Cincinnati", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Cincinnati"], "contexts": ["city in Ohio, USA", "city in the United States of America"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cincinnati", "target_book": "kosmos_humboldt_1845", "target_name": "Cincinnati", "similarity": 1.0}], "id": 3429, "stable_key": "clu_f47b86c4f2e14641", "ground_truth": {"modern_name": "Cincinnati", "confidence": "high", "type": "place", "country": "United States", "wikidata_id": "Q43196", "wikidata_description": "city in Ohio, United States; county seat of Hamilton County", "wikipedia_extract": "Cincinnati, colloquially nicknamed Cincy, is the most populous city in Hamilton County, Ohio, United States, and its county seat. Settled in 1788, the city is located on the northern side of the confluence of the Licking and Ohio rivers, the latter of which marks the state line with Kentucky. The third-most populous city in Ohio with a population of 309,317 at the 2020 census, Cincinnati serves as the economic and cultural hub of the tri-state Cincinnati metropolitan area, Ohio's most populous metropolitan area and the nation's 30th-largest at over 2.3 million residents. Throughout much of the 19th century, Cincinnati was among the top 10 U.S. cities by population. The city developed as an inland port for cargo shipping by steamboats, located at the crossroads of the Northern and Southern United States, with fewer immigrants and less influence from Europe than East Coast cities in the same period. However, it received a significant number of German-speaking immigrants, who founded many of the city's cultural institutions."}}, {"canonical_name": "degr\u00e9", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "degr\u00e9", "book_id": "relation_historique_humboldt_vol3_1825", "name": "degr\u00e9", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["degr\u00e9", "degr\u00e9 \u00e9quatorial"], "contexts": ["unit of angular measurement", "measurement related to Earth's equator"]}, {"entity_id": "degrees", "book_id": "connexion_physical_sciences_somerville_1858", "name": "degrees", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["degrees"], "contexts": ["unit of angular measurement", "unit of angular measure"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "degr\u00e9", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "degrees", "similarity": 0.846}], "id": 3430, "stable_key": "clu_c4bad17dc9f94a26", "ground_truth": {"modern_name": "Degree (angle)", "confidence": "high", "type": "concept", "wikidata_id": "Q57571141", "wikidata_description": "scientific article published on 21 June 2007"}}, {"canonical_name": "Tunguragua", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "tunguragua", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tunguragua", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Tunguragua", "Tonguragua"], "contexts": ["mountain in Ecuador", "volcano in Quito group"]}, {"entity_id": "tunguragua", "book_id": "kosmos_humboldt_1845", "name": "Tunguragua", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Tunguragua"], "contexts": ["active volcano", "grand volcano near Penipe"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tunguragua", "target_book": "kosmos_humboldt_1845", "target_name": "Tunguragua", "similarity": 1.0}], "id": 3431, "stable_key": "clu_a18ae398932cc101", "ground_truth": {"modern_name": "Tungurahua", "confidence": "high", "type": "place", "country": "Ecuador", "wikidata_id": "Q21228016", "wikidata_description": "genus of insects"}}, {"canonical_name": "Conglom\u00e9rat", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "conglom\u00e9rat", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Conglom\u00e9rat", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["conglom\u00e9rat", "Conglom\u00e9rat"], "contexts": ["conglomerate rock", "rock composed of rounded fragments"]}, {"entity_id": "conglomerates", "book_id": "kosmos_humboldt_1845", "name": "conglomerates", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["conglomerates"], "contexts": ["compound rocks with fossils", "rock composed of rounded pebbles"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Conglom\u00e9rat", "target_book": "kosmos_humboldt_1845", "target_name": "conglomerates", "similarity": 0.946}], "id": 3432, "stable_key": "clu_c9c581ac2d84c28c", "ground_truth": {"modern_name": "Conglomerate rock", "confidence": "high", "type": "mineral", "wikidata_id": "Q76990788", "wikidata_description": "photograph by Carleton E Watkins (1829-1916)"}}, {"canonical_name": "baie de Hudson", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "baie_de_hudson", "book_id": "relation_historique_humboldt_vol3_1825", "name": "baie de Hudson", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["baie de Hudson"], "contexts": ["bay", "body of water"]}, {"entity_id": "hudson\u2019s_bay", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Hudson\u2019s Bay", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Hudson\u2019s Bay"], "contexts": ["bay where tides are perceptible", "location with tidal phenomena"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "baie de Hudson", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Hudson\u2019s Bay", "similarity": 0.921}], "id": 3433, "stable_key": "clu_db1ec94d71baefbf", "ground_truth": {"modern_name": "Hudson Bay", "confidence": "high", "type": "place", "country": "Canada", "wikidata_id": "Q322145", "wikidata_description": "species of North American mammal", "wikipedia_extract": "Hudson Bay, sometimes called Hudson's Bay (usually historically), is a large body of saltwater in northeastern Canada with a surface area of 1,230,000 km2 (470,000 sq mi). It is located north of Ontario, west of Quebec, northeast of Manitoba, and southeast of Nunavut, but politically entirely part of Nunavut. It is an inland marginal sea of the Arctic Ocean. The Hudson Strait provides a connection to the Labrador Sea and the Atlantic Ocean in the northeast, while the Foxe Channel connects Hudson Bay with the Arctic Ocean in the north. The Hudson Bay drainage basin drains a very large area, about 3,861,400 km2 (1,490,900 sq mi), that includes parts of southeastern Nunavut, Alberta, Saskatchewan, Ontario, Quebec, all of Manitoba, and parts of the U.S. states of North Dakota, South Dakota, Minnesota, and Montana. Hudson Bay's southern arm is called James Bay."}}, {"canonical_name": "Parrot", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "parrot", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Parrot", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Parrot"], "contexts": ["person involved in leveling operations", "described mud volcano"]}, {"entity_id": "parrot", "book_id": "kosmos_humboldt_1845", "name": "Parrot", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Parrot"], "contexts": ["author of travelogue to Ararat", "co-author on gas nature"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Parrot", "target_book": "kosmos_humboldt_1845", "target_name": "Parrot", "similarity": 1.0}], "id": 3434, "stable_key": "clu_4d27a8f0ddefaa68", "ground_truth": {"modern_name": "Friedrich Parrot", "confidence": "high", "type": "person", "birth_year": 1791, "death_year": 1841, "description": "Baltic German physicist and explorer, traveled to Mount Ararat", "wikidata_id": "Q707716", "wikidata_description": "Baltic German explorer (1791-1841)"}}, {"canonical_name": "Dieppe", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "dieppe", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Dieppe", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Dieppe"], "contexts": ["city near la Chapelle", "city in France"]}, {"entity_id": "dieppe", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Dieppe", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Dieppe"], "contexts": ["visible from Hastings", "city visible in the afternoon"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Dieppe", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Dieppe", "similarity": 1.0}], "id": 3435, "stable_key": "clu_a990e4940cfaa2ec", "ground_truth": {"modern_name": "Dieppe", "confidence": "high", "type": "place", "country": "France", "wikidata_id": "Q264075", "wikidata_description": "city in New Brunswick, Canada"}}, {"canonical_name": "Gassiot", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "gaspuri", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Gaspuri", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Gaspuri"], "contexts": ["Author of geographical handbook", "cited for population statistics"]}, {"entity_id": "gassiot", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Gassiot", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Gassiot"], "contexts": ["Vice-President of the Royal Society", "scientist conducting electrical experiments"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Gaspuri", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Gassiot", "similarity": 0.851}], "id": 3436, "stable_key": "clu_ad79b0e3ce6caaac", "ground_truth": {"modern_name": "John Peter Gassiot", "confidence": "high", "type": "person", "birth_year": 1797, "death_year": 1877, "description": "English scientist and businessman, known for work on electricity", "note": "The 'Gaspuri' spelling appears to be a transcription error.", "wikidata_id": "Q447290", "wikidata_description": "British scientist and businessman (1797-1877)"}}, {"canonical_name": "porphyries", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "porphyres_pyrox\u00e9uiques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "porphyres pyrox\u00e9uiques", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["porphyres pyrox\u00e9uiques"], "contexts": ["rocks causing effects in Tyrol and Scotland", "type of porphyry rock"]}, {"entity_id": "porphyres_pyroy\u00e9niques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "porphyres pyroy\u00e9niques", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["porphyres pyroy\u00e9niques"], "contexts": ["pyroxene porphyry rock type"]}, {"entity_id": "porphyries", "book_id": "kosmos_humboldt_1845", "name": "porphyries", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["porphyries"], "contexts": ["rock crumbling into gravel", "igneous rocks with large crystals"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "porphyres pyrox\u00e9uiques", "target_book": "kosmos_humboldt_1845", "target_name": "porphyries", "similarity": 0.904}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "porphyres pyroy\u00e9niques", "target_book": "kosmos_humboldt_1845", "target_name": "porphyries", "similarity": 0.894}], "id": 3437, "stable_key": "clu_04593b67396f2838-2", "ground_truth": {"modern_name": "Porphyry", "confidence": "high", "type": "mineral", "wikidata_id": "Q203445", "wikidata_description": "3rd-century Greek Neoplatonist philosopher", "note": "The Italian 'Porfido' directly translates to porphyry."}}, {"canonical_name": "Mason", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "mason", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mason", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Mason"], "contexts": ["surveyor"]}, {"entity_id": "mason", "book_id": "coloquios_da_orta_1563", "name": "Mason", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["CL Mason", "Mason", "Maton", "dr. Mason"], "contexts": ["author of Burma", "botanist who named Elettaria Cardamomum"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mason", "target_book": "coloquios_da_orta_1563", "target_name": "Mason", "similarity": 0.807}], "id": 3438, "stable_key": "clu_0aa748e68a2f132e", "ground_truth": {"modern_name": "Charles Mason", "confidence": "medium", "type": "person", "birth_year": 1730, "death_year": 1805, "description": "English surveyor, astronomer, and geographer, notable for Mason-Dixon line.", "note": "Multiple individuals named Mason existed during this period. This identification is based on the context of surveying and geographic contributions, which strongly aligns with Charles Mason.", "wikidata_id": "Q108877225", "wikidata_description": "Rector of Grace Church in Boston, Mass"}}, {"canonical_name": "Irkutsk", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "irkutsk", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Irkutsk", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Irkutsk"], "contexts": ["city in Siberia"]}, {"entity_id": "irkutsk", "book_id": "kosmos_humboldt_1845", "name": "Irkutsk", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Irkutsk"], "contexts": ["city near Lake Baikal", "city in Asiatic Continent"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Irkutsk", "target_book": "kosmos_humboldt_1845", "target_name": "Irkutsk", "similarity": 1.0}], "id": 3439, "stable_key": "clu_8d99acde044c0efe", "ground_truth": {"modern_name": "Irkutsk", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q6576", "wikidata_description": "capital city of Irkutsk Oblast, Siberia, in eastern Russia", "wikipedia_url": "https://en.wikipedia.org/wiki/Irkutsk", "wikipedia_extract": "Irkutsk ( eer-KOOTSK; Russian: \u0418\u0440\u043a\u0443\u0442\u0441\u043a, IPA: [\u026ar\u02c8kutsk]; Buryat and Mongolian: \u042d\u0440\u0445\u04af\u04af, Erh\u00fc\u00fc [\u025br\u02c8xu\u02d0]) is the largest city and administrative center of Irkutsk Oblast, Russia. With a population of 587,891 as of the 2010 Census, Irkutsk is the 25th-largest city in Russia by population, the fifth-largest in the Siberian Federal District, and one of the largest cities in Siberia. Located in the south of the eponymous oblast, the city proper lies on the Angara River, a tributary of the Yenisei, about 850 kilometres (530 mi) to the south-east of Krasnoyarsk and about 520 kilometres (320 mi) north of Ulaanbaatar. The Trans-Siberian Highway (Federal M53 and M55 Highways) and Trans-Siberian Railway connect Irkutsk to other regions in Russia and Mongolia. Many distinguished Russians were sent into exile in Irkutsk for their part in the Decembrist revolt of 1825, and the city became an exile-post for the rest of the century. Some historic wooden houses still survive."}}, {"canonical_name": "M. Bessel", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "m__bessel", "book_id": "relation_historique_humboldt_vol3_1825", "name": "M. Bessel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["M. Bessel"], "contexts": ["published important result on barometric oscillations"]}, {"entity_id": "m__bessel", "book_id": "connexion_physical_sciences_somerville_1858", "name": "M. Bessel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["M. Bessel"], "contexts": ["astronomer who studied Saturn's ring", "astronomer calculating obliquity variation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "M. Bessel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "M. Bessel", "similarity": 1.0}], "id": 3440, "stable_key": "clu_4a6b821ca1c809ab-2", "ground_truth": {"modern_name": "Friedrich Bessel", "confidence": "high", "type": "person", "birth_year": 1784, "death_year": 1846, "description": "Astronomer who calculated the first accurate value of stellar parallax.", "wikidata_id": "Q120832704", "wikidata_description": "street in Paffendorf, Bergheim, NRW, Germany", "note": "The description of studying barometric oscillations is less commonly associated with Bessel, but his astronomical work on Saturn's rings and his prominence in the scientific community make him the most likely referent."}}, {"canonical_name": "palhas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "hachas", "book_id": "historia_medicinal_monardes_1574", "name": "hachas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["hachas"], "contexts": ["objects made from wax"]}, {"entity_id": "palhas", "book_id": "polyanthea_medicinal", "name": "palhas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 5, "variants": ["palhas"], "contexts": ["straw", "straws, attracted by amber and diamond"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "hachas", "target_book": "polyanthea_medicinal", "target_name": "palhas", "similarity": 0.886}], "id": 3441, "stable_key": "clu_764e27187143feb0", "ground_truth": {"modern_name": "Straw", "confidence": "low", "type": "object", "note": "'Palhas' can refer to various dry stalks of grain, including straw. 'Hachas' is a misspelling or OCR error and does not fit the context of objects made from wax or straw."}}, {"canonical_name": "Tripoli", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "tripoli", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tripoli", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Tripoli"], "contexts": ["city with sugar consumption"]}, {"entity_id": "tripoli", "book_id": "coloquios_da_orta_1563", "name": "Tripoli", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Tripoli"], "contexts": ["city spices were transported to", "city mentioned in footnote"]}, {"entity_id": "tripol", "book_id": "coloquios_da_orta_1563", "name": "Tripol", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Tripol"], "contexts": ["city in Syria"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tripoli", "target_book": "coloquios_da_orta_1563", "target_name": "Tripoli", "similarity": 0.903}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tripoli", "target_book": "coloquios_da_orta_1563", "target_name": "Tripol", "similarity": 0.882}], "id": 3442, "stable_key": "clu_d79f4680dbe0374d", "ground_truth": {"modern_name": "Tripoli", "confidence": "high", "type": "place", "description": "Mediterranean port cities in Libya and Lebanon.", "note": "Refers to both Tripoli in Libya and Tripoli (also known as Tarabulus al-Sham or Tripoli of Syria) in Lebanon.", "wikipedia_extract": "Tripoli, historically known as Tripoli-of-the-West, is the capital and largest city of Libya, with a population of about 1.317 million people in 2021. It is located in the northwest of Libya on the edge of the desert, on a point of rocky land projecting into the Mediterranean Sea and forming a bay. It includes the port of Tripoli and the country's largest commercial and manufacturing center. It is also the site of the University of Tripoli. Tripoli was founded in the 7th century BC by the Phoenicians, who gave it the Libyco-Berber name Oyat (Punic: \ud802\udd05\ud802\udd09\u202c\u202c\ud802\udd0f\u202c\ud802\udd15, romanized: Wy\u02bft), before passing into the hands of the Greek rulers of Cyrenaica as Oea (Ancient Greek: \u1f48\u03af\u03b1, romanized: O\u00eda). Due to the city's long history, there are many sites of archeological significance in Tripoli."}}, {"canonical_name": "conduction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "conduction", "book_id": "principles_of_psychology_james_1890", "name": "conduction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["conduction"], "contexts": ["transfer of heat or electricity", "transmission of nerve impulses"]}, {"entity_id": "conduction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Conduction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Conduction"], "contexts": ["transfer of electricity"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "conduction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Conduction", "similarity": 0.989}], "id": 3443, "stable_key": "clu_41b385c49d06582c", "ground_truth": {"modern_name": "Conduction", "confidence": "high", "type": "concept"}}, {"canonical_name": "stimulation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "stimulation", "book_id": "principles_of_psychology_james_1890", "name": "stimulation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["stimulation"], "contexts": ["process of exciting a nerve pathway", "process of exciting a nerve or organ"]}, {"entity_id": "estimular", "book_id": "polyanthea_medicinal", "name": "estimular", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["estimular"], "contexts": ["to stimulate"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "stimulation", "target_book": "polyanthea_medicinal", "target_name": "estimular", "similarity": 0.892}], "id": 3444, "stable_key": "clu_7db8bfd92b19d14e-2", "ground_truth": {"modern_name": "Stimulation", "confidence": "high", "type": "concept", "wikidata_id": "Q14818068", "wikidata_description": "Any process that activates or increases the frequency, rate or extent of transcription from an RNA polymerase II promoter."}}, {"canonical_name": "Hermann", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "hermann", "book_id": "principles_of_psychology_james_1890", "name": "Hermann", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Hermann"], "contexts": ["author of Handbook", "cited physiologist"]}, {"entity_id": "hermanno", "book_id": "coloquios_da_orta_1563", "name": "Hermanno", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Hermanno"], "contexts": ["ancient botanist noting plant name"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Hermann", "target_book": "coloquios_da_orta_1563", "target_name": "Hermanno", "similarity": 0.943}], "id": 3445, "stable_key": "clu_ac5a478f44a2b09b-3", "ground_truth": {"modern_name": "Hermann von Helmholtz", "confidence": "high", "type": "person", "birth_year": 1821, "death_year": 1894, "description": "German physician and physicist, pioneering researcher in optics, electromagnetism, and nerve physiology.", "wikidata_id": "Q113814860", "wikidata_description": "street in Kleinmachnow, Brandenburg, Germany", "note": "The text 'principles_of_psychology_james_1890' refers to William James, whose work was heavily influenced by Helmholtz. The 'coloquios_da_orta_1563' reference to 'Hermanno' is likely a different individual, possibly referencing Dioscorides' 'Hermion' or similar ancient botanical names, but the primary context points to Helmholtz. Given the dominant context, Helmholtz is the most probable referent."}}, {"canonical_name": "Sir W. Hamilton", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "sir_w__hamilton", "book_id": "principles_of_psychology_james_1890", "name": "Sir W. Hamilton", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Sir W. Hamilton"], "contexts": ["philosopher, critic of Cartesianism", "philosopher cited for lectures on metaphysics"]}, {"entity_id": "sir_w__hamilton", "book_id": "first_principles_spencer_1862", "name": "Sir W. Hamilton", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Sir W. Hamilton"], "contexts": ["omitted a fundamental condition of thought"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Sir W. Hamilton", "target_book": "first_principles_spencer_1862", "target_name": "Sir W. Hamilton", "similarity": 1.0}], "id": 3446, "stable_key": "clu_7091b30cab033e4e-2", "ground_truth": {"modern_name": "William Hamilton", "confidence": "medium", "type": "person", "birth_year": 1730, "death_year": 1796, "description": "Scottish geologist and diplomat, influential in vulcanology and archaeology.", "note": "The context mentions 'philosopher defending soul's presence in body' and 'doctrine of religious thought limits', which aligns with Sir William Hamilton (1730-1796), a Scottish philosopher and diplomat known for his writings on metaphysics and theology, rather than the geologist. However, some associations could also be with the scientist William Rowan Hamilton (1805-1865). Given the provided texts are from the 19th century, and one mentions 'first principles', it leans towards the philosopher Sir William Hamilton for his metaphysical work.", "wikidata_id": "Q15443", "wikidata_description": "Irish physician and botanist (1783-1856)"}}, {"canonical_name": "Greek", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "greek", "book_id": "principles_of_psychology_james_1890", "name": "Greek", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["Greek"], "contexts": ["language and culture of ancient Greece", "ancient language and culture"]}, {"entity_id": "greca", "book_id": "ricettario_fiorentino_1597", "name": "Greca", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Greca"], "contexts": ["Greek pitch"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Greek", "target_book": "ricettario_fiorentino_1597", "target_name": "Greca", "similarity": 0.932}], "id": 3447, "stable_key": "clu_91f198a6aa49c9bd", "ground_truth": {"modern_name": "Greek", "confidence": "high", "type": "concept", "description": "Relating to the language, culture, or pitch of ancient Greece.", "note": "Refers to the language and culture of ancient Greece, and Greek pitch.", "wikipedia_extract": "Ancient Greek (\u1f19\u03bb\u03bb\u03b7\u03bd\u03b9\u03ba\u03ae, Hell\u0113nik\u1e17 [hell\u025b\u02d0nik\u025b\u0301\u02d0]) includes the forms of the Greek language used in ancient Greece and the ancient world from around 1500 BC to 300 BC. It is often roughly divided into the following periods: Mycenaean Greek (c.\u20091400 \u2013 c.\u20091200 BC), Dark Ages (c.\u20091200 \u2013 c.\u2009800 BC), the Archaic or Homeric period (c.\u2009800 \u2013 c.\u2009500 BC), and the Classical period (c.\u2009500 \u2013 c.\u2009300 BC). Ancient Greek was the language of Homer and of fifth-century Athenian historians, playwrights, and philosophers. It has contributed many words to English vocabulary and has been a standard subject of study in educational institutions of the Western world since the Renaissance. This article primarily contains information about the Epic and Classical periods of the language, which are the best-attested periods and considered most typical of Ancient Greek. From the Hellenistic period (c.\u2009300 BC), Ancient Greek was followed by Koine Greek, which is regarded as a separate historical stage, though its earliest form closely resembles Attic Greek, and its latest form approaches Medieval Greek, and Koine may be classified as Ancient Greek in a wider sense \u2013 being an ancient rather than medieval form of Greek, though over the centuries increasingly resembling Medieval and Modern Greek."}}, {"canonical_name": "past", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "past", "book_id": "principles_of_psychology_james_1890", "name": "past", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["past"], "contexts": ["temporal quality of events", "time that has gone by"]}, {"entity_id": "passado", "book_id": "coloquios_da_orta_1563", "name": "passado", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["passado"], "contexts": ["period of reputation"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "past", "target_book": "coloquios_da_orta_1563", "target_name": "passado", "similarity": 0.927}], "id": 3448, "stable_key": "clu_25f18f3a305e61f7", "ground_truth": {"modern_name": "past", "confidence": "high", "type": "concept"}}, {"canonical_name": "volitions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "volitions", "book_id": "principles_of_psychology_james_1890", "name": "volitions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["volitions"], "contexts": ["engendered by association of ideas", "conscious acts of will"]}, {"entity_id": "volitions", "book_id": "first_principles_spencer_1862", "name": "volitions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["volitions"], "contexts": ["willpower and decision-making", "act of willing or choosing"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "volitions", "target_book": "first_principles_spencer_1862", "target_name": "volitions", "similarity": 1.0}], "id": 3449, "stable_key": "clu_8d9d4e0a1351aa68-2", "ground_truth": {"modern_name": "volition", "confidence": "high", "type": "concept", "wikidata_id": "Q1441519", "wikidata_description": "cognitive process by which an individual decides on and commits to a particular course of action", "wikipedia_url": "https://en.wikipedia.org/wiki/Volition%20%28psychology%29", "wikipedia_extract": "Volition, also known as will or conation, is the cognitive process by which an individual decides on and commits to a particular course of action. It is defined as purposive striving and is one of the primary human psychological functions. Others include affect (feeling or emotion), motivation (goals and expectations), and cognition (thinking). Volitional processes can be applied consciously or they can be automatized as habits over time. Most modern conceptions of volition address it as a process of conscious action control which becomes automatized (e.g. see Heckhausen and Kuhl; Gollwitzer; Boekaerts and Corno)."}}, {"canonical_name": "paths", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "paths", "book_id": "principles_of_psychology_james_1890", "name": "paths", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["paths"], "contexts": ["neural pathways for signals", "nerve pathways"]}, {"entity_id": "path", "book_id": "connexion_physical_sciences_somerville_1858", "name": "path", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["path"], "contexts": ["course taken by a body", "route taken"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "paths", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "path", "similarity": 0.901}], "id": 3450, "stable_key": "clu_9ecc17db44b9dc67", "ground_truth": {"modern_name": "pathway", "confidence": "high", "type": "concept"}}, {"canonical_name": "Time and Space", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "time_and_space", "book_id": "principles_of_psychology_james_1890", "name": "Time and Space", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Time and Space"], "contexts": ["work by Hodgson", "book on philosophical concepts"]}, {"entity_id": "time_and_space", "book_id": "first_principles_spencer_1862", "name": "Time and Space", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Time and Space"], "contexts": ["conditions for Force's presentation", "fixed conditions for phenomena"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Time and Space", "target_book": "first_principles_spencer_1862", "target_name": "Time and Space", "similarity": 1.0}], "id": 3451, "stable_key": "clu_0a3a4b8a812791b9", "ground_truth": {"modern_name": "time and space", "confidence": "high", "type": "concept", "wikidata_id": "Q57627396", "wikidata_description": "scholarly article by Michel Christol published in July 2002"}}, {"canonical_name": "knowing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "knowing", "book_id": "principles_of_psychology_james_1890", "name": "knowing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["knowing"], "contexts": ["understanding or awareness of facts", "the act of acquiring knowledge"]}, {"entity_id": "knowing_and_the_known", "book_id": "first_principles_spencer_1862", "name": "knowing and the known", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["knowing and the known"], "contexts": ["the act of knowing and what is known"]}, {"entity_id": "knowing", "book_id": "first_principles_spencer_1862", "name": "knowing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["knowing"], "contexts": ["term requiring specific interpretation"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name":