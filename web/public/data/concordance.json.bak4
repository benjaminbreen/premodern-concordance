": ["elemental atoms"], "contexts": ["fundamental particles of matter"]}, {"entity_id": "atoms", "book_id": "first_principles_spencer_1862", "name": "atoms", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 20, "variants": ["atoms"], "contexts": ["hypothetical fundamental units of matter", "indivisible particles of matter"]}, {"entity_id": "atoms", "book_id": "principles_of_psychology_james_1890", "name": "atoms", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["atoms"], "contexts": ["fundamental particles of matter", "fundamental particles"]}, {"entity_id": "atoms", "book_id": "kosmos_humboldt_1845", "name": "atoms", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["atoms", "Atoms"], "contexts": ["fundamental particles in mechanical construction", "hypothetical construction of matter"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "elemental atoms", "target_book": "first_principles_spencer_1862", "target_name": "atoms", "similarity": 0.968}, {"source_book": "principles_of_psychology_james_1890", "source_name": "atoms", "target_book": "kosmos_humboldt_1845", "target_name": "atoms", "similarity": 1.0}], "id": 449, "stable_key": "clu_35840a60816d9356", "ground_truth": {"modern_name": "atom", "confidence": "high", "type": "chemical", "note": "Early modern texts often refer to atoms as fundamental, indivisible particles, reflecting the philosophical rather than the modern quantum mechanical understanding.", "wikidata_id": "Q9121", "wikidata_description": "smallest unit of a chemical element", "wikipedia_url": "https://en.wikipedia.org/wiki/Atom", "wikipedia_extract": "Atoms are the basic particles of the chemical elements and the fundamental building blocks of matter. An atom consists of a nucleus of protons and generally neutrons, surrounded by an electromagnetically bound swarm of electrons. The chemical elements are distinguished from each other by the number of protons that are in their atoms. For example, any atom that contains 11 protons is sodium, and any atom that contains 29 protons is copper. Atoms with the same number of protons but a different number of neutrons are called isotopes of the same element. Atoms are extremely small, typically around 100 picometers across."}}, {"canonical_name": "hypoth\u00e8se", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 4, "total_mentions": 26, "members": [{"entity_id": "hypoth\u00e8se", "book_id": "medecine_experimentale_bernard_1865", "name": "hypoth\u00e8se", "category": "CONCEPT", "subcategory": "THEORY", "count": 12, "variants": ["hypoth\u00e8se"], "contexts": ["a proposed explanation for phenomena", "proposed explanation for phenomena"]}, {"entity_id": "hypoth\u00e8ses", "book_id": "medecine_experimentale_bernard_1865", "name": "hypoth\u00e8ses", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["hypoth\u00e8ses"], "contexts": ["ideas guiding scientific inquiry", "scientific hypotheses"]}, {"entity_id": "hypothesis", "book_id": "origin_of_species_darwin_1859", "name": "hypothesis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hypothesis"], "contexts": ["proposed explanation for phenomena"]}, {"entity_id": "hypothesis", "book_id": "principles_of_psychology_james_1890", "name": "hypothesis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["hypothesis"], "contexts": ["proposed explanation for phenomena", "proposed explanation to be tested"]}, {"entity_id": "hypothesis", "book_id": "kosmos_humboldt_1845", "name": "hypothesis", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["hypothesis"], "contexts": ["alternative to a scientific theory", "convenient or bold idea"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "hypoth\u00e8se", "target_book": "origin_of_species_darwin_1859", "target_name": "hypothesis", "similarity": 0.917}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "hypoth\u00e8se", "target_book": "principles_of_psychology_james_1890", "target_name": "hypothesis", "similarity": 0.917}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "hypoth\u00e8se", "target_book": "kosmos_humboldt_1845", "target_name": "hypothesis", "similarity": 0.917}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "hypoth\u00e8ses", "target_book": "origin_of_species_darwin_1859", "target_name": "hypothesis", "similarity": 0.913}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "hypoth\u00e8ses", "target_book": "principles_of_psychology_james_1890", "target_name": "hypothesis", "similarity": 0.913}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "hypoth\u00e8ses", "target_book": "kosmos_humboldt_1845", "target_name": "hypothesis", "similarity": 0.913}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hypothesis", "target_book": "principles_of_psychology_james_1890", "target_name": "hypothesis", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hypothesis", "target_book": "kosmos_humboldt_1845", "target_name": "hypothesis", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hypothesis", "target_book": "kosmos_humboldt_1845", "target_name": "hypothesis", "similarity": 1.0}], "id": 450, "stable_key": "clu_953b92350dd8e925", "ground_truth": {"modern_name": "hypothesis", "confidence": "high", "type": "concept", "wikidata_id": "Q5961247", "wikidata_description": "US nonprofit organization that develops and stewards technologies and practices to annotate the web", "wikipedia_url": "https://en.wikipedia.org/wiki/Hypothes.is", "wikipedia_extract": "Hypothes.is is an open-source software project that aims to collect comments about statements made in any web-accessible content, and filter and rank those comments to assess each statement's credibility. It has been summarized as \"a peer review layer for the entire Internet.\" The project is a system which allows annotation of web pages, using comments contributed by individuals and a reputation system for rating the comments. The plan is that the comments will be stored in the Internet Archive. Normal use is with a browser plug-in (Chrome) or a bookmarklet (others), and the plan is that links to specific comments will also be viewable without needing a plug-in. The project is led by Dan Whaley, co-founder of GetThere, one of the first online travel booking systems in 1995. Its advisors have included John Perry Barlow, Charles Bazerman, Philip Bourne and Brewster Kahle."}}, {"canonical_name": "Musa", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 4, "total_mentions": 26, "members": [{"entity_id": "moses", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Moses", "category": "PERSON", "subcategory": "AUTHORITY", "count": 10, "variants": ["Moses"], "contexts": ["author of scripture account before Flood", "prophet in Judaism and Christianity"]}, {"entity_id": "mo\u00efse", "book_id": "epoques_nature_buffon_1778", "name": "Mo\u00efse", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Mo\u00efse"], "contexts": ["narrator of creation account"]}, {"entity_id": "musa", "book_id": "coloquios_da_orta_1563", "name": "Musa", "category": "PERSON", "subcategory": "AUTHORITY", "count": 12, "variants": ["Musa", "musa"], "contexts": ["Arab name for figs", "fig fruit"]}, {"entity_id": "moys\u00e9s", "book_id": "coloquios_da_orta_1563", "name": "Moys\u00e9s", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Moys\u00e9s"], "contexts": ["figure in the Hebrew Bible", "ancient figure associated with Hebrews"]}, {"entity_id": "moses", "book_id": "first_principles_spencer_1862", "name": "Moses", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Moses"], "contexts": ["composer of triumphal ode"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Moses", "target_book": "epoques_nature_buffon_1778", "target_name": "Mo\u00efse", "similarity": 0.951}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Moses", "target_book": "coloquios_da_orta_1563", "target_name": "Musa", "similarity": 0.945}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Moses", "target_book": "coloquios_da_orta_1563", "target_name": "Moys\u00e9s", "similarity": 0.923}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Moses", "target_book": "first_principles_spencer_1862", "target_name": "Moses", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Mo\u00efse", "target_book": "coloquios_da_orta_1563", "target_name": "Musa", "similarity": 0.923}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Mo\u00efse", "target_book": "coloquios_da_orta_1563", "target_name": "Moys\u00e9s", "similarity": 0.933}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Mo\u00efse", "target_book": "first_principles_spencer_1862", "target_name": "Moses", "similarity": 0.951}, {"source_book": "coloquios_da_orta_1563", "source_name": "Musa", "target_book": "first_principles_spencer_1862", "target_name": "Moses", "similarity": 0.945}, {"source_book": "coloquios_da_orta_1563", "source_name": "Moys\u00e9s", "target_book": "first_principles_spencer_1862", "target_name": "Moses", "similarity": 0.923}], "id": 451, "stable_key": "clu_8abb8e9b3fa0aa7d", "ground_truth": {"modern_name": "Moses", "confidence": "high", "type": "person", "description": "Biblical figure, author of scripture, and fig reference.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Moses", "wikipedia_extract": "In Abrahamic religions, Moses was the Hebrew prophet who led the Israelites out of slavery in the Exodus from Egypt. He is considered the most important prophet in Judaism and Samaritanism, and one of the most important prophets in Christianity, Islam, the Bah\u00e1\u02bc\u00ed Faith, and other Abrahamic religions. According to the Abrahamic scriptures, God dictated the Mosaic Law to Moses, which he wrote down and which formed part of the Torah. According to the Book of Exodus, Moses was born in a period when his people, the Israelites, who were an enslaved minority, were increasing in population; consequently, the Egyptian Pharaoh was worried that they might ally themselves with Egypt's enemies. When Pharaoh ordered all newborn Hebrew boys to be killed in order to reduce the population of the Israelites, Moses' Hebrew mother, Jochebed, secretly hid him in the bulrushes along the Nile river. The Pharaoh's daughter discovered the infant there and adopted him as a foundling."}}, {"canonical_name": "seeds", "category": "PLANT", "subcategory": "SEED", "book_count": 4, "total_mentions": 26, "members": [{"entity_id": "seeds", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "seeds", "category": "PLANT", "subcategory": "SEED", "count": 3, "variants": ["seeds"], "contexts": ["determined by seminalities, that is, created and defined seeds", "seeds as big as glasses"]}, {"entity_id": "seeds", "book_id": "origin_of_species_darwin_1859", "name": "seeds", "category": "PLANT", "subcategory": "SEED", "count": 21, "variants": ["seeds"], "contexts": ["food for singing birds", "reproductive units of plants"]}, {"entity_id": "seeds", "book_id": "principles_of_psychology_james_1890", "name": "seeds", "category": "PLANT", "subcategory": "SEED", "count": 1, "variants": ["seeds"], "contexts": ["reproductive units of plants"]}, {"entity_id": "seeds", "book_id": "first_principles_spencer_1862", "name": "seeds", "category": "PLANT", "subcategory": "SEED", "count": 1, "variants": ["seeds"], "contexts": ["part of plant structure"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "seeds", "target_book": "origin_of_species_darwin_1859", "target_name": "seeds", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "seeds", "target_book": "principles_of_psychology_james_1890", "target_name": "seeds", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "seeds", "target_book": "first_principles_spencer_1862", "target_name": "seeds", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "seeds", "target_book": "principles_of_psychology_james_1890", "target_name": "seeds", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "seeds", "target_book": "first_principles_spencer_1862", "target_name": "seeds", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "seeds", "target_book": "first_principles_spencer_1862", "target_name": "seeds", "similarity": 1.0}], "id": 452, "stable_key": "clu_fd25c4af762ba6d2-2", "ground_truth": {"modern_name": "Seed", "confidence": "high", "type": "plant", "note": "This cluster refers to the botanical seed, a fundamental part of plant reproduction and dispersal, as well as the early stage of a plant's life.", "wikidata_id": "Q40763", "wikidata_description": "embryonic plant enclosed in a protective outer covering (seed coat)", "wikipedia_url": "https://en.wikipedia.org/wiki/Seed", "wikipedia_extract": "In botany, a seed is a plant structure containing an embryo and stored nutrients in a protective coat called a testa. More generally, the term seed means anything that can be sown, which may include seed and husk or tuber. Seeds are the product of the ripened ovule, after the embryo sac is fertilized by sperm from pollen, forming a zygote. The embryo within a seed develops from the zygote and grows within the mother plant to a certain size before growth is halted. The formation of the seed is the defining part of the process of reproduction in seed plants (spermatophytes). Other plants such as ferns, mosses and liverworts, do not have seeds and use water-dependent means to propagate themselves."}}, {"canonical_name": "poros", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 26, "members": [{"entity_id": "pores", "book_id": "english_physician_1652", "name": "Pores", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Pores"], "contexts": ["part of the body to be opened"]}, {"entity_id": "poros", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "poros", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["poros"], "contexts": ["body openings", "pores of the body"]}, {"entity_id": "pores", "book_id": "kosmos_humboldt_1845", "name": "pores", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["pores"], "contexts": ["small openings in meteorite structure"]}, {"entity_id": "poros", "book_id": "polyanthea_medicinal", "name": "poros", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 22, "variants": ["poros", "poros do corpo", "porosidades", "p\u00f2ros"], "contexts": ["pores in the brain", "pores, small openings"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Pores", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "poros", "similarity": 0.919}, {"source_book": "english_physician_1652", "source_name": "Pores", "target_book": "kosmos_humboldt_1845", "target_name": "pores", "similarity": 0.994}, {"source_book": "english_physician_1652", "source_name": "Pores", "target_book": "polyanthea_medicinal", "target_name": "poros", "similarity": 0.919}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "poros", "target_book": "kosmos_humboldt_1845", "target_name": "pores", "similarity": 0.922}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "poros", "target_book": "polyanthea_medicinal", "target_name": "poros", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "pores", "target_book": "polyanthea_medicinal", "target_name": "poros", "similarity": 0.922}], "id": 453, "stable_key": "clu_cb8881759d3787b4", "ground_truth": {"modern_name": "Pores", "confidence": "high", "type": "substance", "description": "Minute openings in the surface of the skin or other tissues.", "note": "The contexts relate to biological structures for absorption or excretion.", "wikipedia_extract": "Poros (Greek: \u03a0\u03cc\u03c1\u03bf\u03c2; Modern Greek pronunciation: [\u02c8poros]) is a small Greek island-pair in the southern part of the Saronic Gulf, about 58 km (36 miles; 31 nautical miles) south of the port of Piraeus and separated from the Peloponnese by a 200 m (656 ft) wide sea channel, with the town of Galatas on the mainland across the strait. Its surface area is about 31 square kilometres (12 sq mi) and it has 3,261 inhabitants (2021). The ancient name of Poros was Pogon. Like other ports in the Saronic, it is a popular weekend destination for Athenian travellers. Poros consists of two islands: Sphaeria (Greek: \u03a3\u03c6\u03b1\u03b9\u03c1\u03af\u03b1, pronounced [sfe\u02c8ria]), the southern part, which is of volcanic origin, where today's city is located, and Kalaureia (Greek: \u039a\u03b1\u03bb\u03b1\u03c5\u03c1\u03af\u03b1, [kalav\u02c8ria]), also Kalavria or Calauria (meaning 'gentle breeze'), the northern and largest part. A bridge connects the two islands over a narrow strait."}}, {"canonical_name": "Elie de Beaumont", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 26, "members": [{"entity_id": "elie_de_beaumont", "book_id": "origin_of_species_darwin_1859", "name": "Elie de Beaumont", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Elie de Beaumont"], "contexts": ["geologist who gave up catastrophe theory"]}, {"entity_id": "elie_de_beaumont", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Elie de Beaumont", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Elie de Beaumont", "M. Elie de Beaumont"], "contexts": ["geologist who collected facts", "scholar who collected information on mountains"]}, {"entity_id": "elie_de_beaumont", "book_id": "kosmos_humboldt_1845", "name": "Elie de Beaumont", "category": "PERSON", "subcategory": "SCHOLAR", "count": 20, "variants": ["Elie de Beaumont"], "contexts": ["geologist with grand views on mountains", "geologist cited for research"]}, {"entity_id": "beaumont,_elie_de", "book_id": "kosmos_humboldt_1845", "name": "Beaumont, Elie de", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Beaumont, Elie de"], "contexts": ["geologist studying mountain uplift"]}, {"entity_id": "m__elie_de_beaumont", "book_id": "first_principles_spencer_1862", "name": "M. Elie de Beaumont", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["M. Elie de Beaumont"], "contexts": ["proposed theory on Earth's crustal changes"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Elie de Beaumont", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Elie de Beaumont", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Elie de Beaumont", "target_book": "kosmos_humboldt_1845", "target_name": "Elie de Beaumont", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Elie de Beaumont", "target_book": "kosmos_humboldt_1845", "target_name": "Beaumont, Elie de", "similarity": 0.874}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Elie de Beaumont", "target_book": "first_principles_spencer_1862", "target_name": "M. Elie de Beaumont", "similarity": 0.962}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Elie de Beaumont", "target_book": "kosmos_humboldt_1845", "target_name": "Elie de Beaumont", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Elie de Beaumont", "target_book": "kosmos_humboldt_1845", "target_name": "Beaumont, Elie de", "similarity": 0.874}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Elie de Beaumont", "target_book": "first_principles_spencer_1862", "target_name": "M. Elie de Beaumont", "similarity": 0.962}, {"source_book": "kosmos_humboldt_1845", "source_name": "Elie de Beaumont", "target_book": "first_principles_spencer_1862", "target_name": "M. Elie de Beaumont", "similarity": 0.962}, {"source_book": "kosmos_humboldt_1845", "source_name": "Beaumont, Elie de", "target_book": "first_principles_spencer_1862", "target_name": "M. Elie de Beaumont", "similarity": 0.902}], "id": 454, "stable_key": "clu_779c6c4293b8a311", "ground_truth": {"modern_name": "Jean-Baptiste \u00c9lie de Beaumont", "confidence": "high", "type": "person", "birth_year": 1798, "death_year": 1874, "description": "French geologist known for his work on mountain ranges and geological time.", "wikidata_id": "Q1950452", "wikidata_description": "mountain in New Zealand", "wikipedia_url": "https://en.wikipedia.org/wiki/Mount%20Elie%20de%20Beaumont", "wikipedia_extract": "Mount Elie de Beaumont is a 3,109 metres (10,200 ft) high mountain in the Southern Alps on the South Island of New Zealand and the northernmost Three-thousander of the country. It is surrounded by several glaciers like Johannes Glacier in the north, Burton Glacier to the east, Times Glacier to the west and Anna Glacier, a tributary to the Tasman Glacier, in the south. It was named by Julius von Haast after the French geologist Jean-Baptiste \u00c9lie de Beaumont."}}, {"canonical_name": "density", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 4, "total_mentions": 26, "members": [{"entity_id": "density", "book_id": "kosmos_humboldt_1845", "name": "density", "category": "CONCEPT", "subcategory": "QUALITY", "count": 7, "variants": ["density"], "contexts": ["mass per unit volume", "measure of mass per unit volume"]}, {"entity_id": "densidade", "book_id": "coloquios_da_orta_1563", "name": "densidade", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["densidade"], "contexts": ["property of diamonds"]}, {"entity_id": "density", "book_id": "connexion_physical_sciences_somerville_1858", "name": "density", "category": "CONCEPT", "subcategory": "QUALITY", "count": 15, "variants": ["density", "Density"], "contexts": ["mass per unit volume", "property of matter related to mass and volume"]}, {"entity_id": "densities", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Densities", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Densities"], "contexts": ["mass per unit volume"]}, {"entity_id": "density", "book_id": "first_principles_spencer_1862", "name": "density", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["density"], "contexts": ["mass per unit volume"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "density", "target_book": "coloquios_da_orta_1563", "target_name": "densidade", "similarity": 0.995}, {"source_book": "kosmos_humboldt_1845", "source_name": "density", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "density", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "density", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Densities", "similarity": 0.961}, {"source_book": "kosmos_humboldt_1845", "source_name": "density", "target_book": "first_principles_spencer_1862", "target_name": "density", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "densidade", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "density", "similarity": 0.995}, {"source_book": "coloquios_da_orta_1563", "source_name": "densidade", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Densities", "similarity": 0.958}, {"source_book": "coloquios_da_orta_1563", "source_name": "densidade", "target_book": "first_principles_spencer_1862", "target_name": "density", "similarity": 0.995}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "density", "target_book": "first_principles_spencer_1862", "target_name": "density", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Densities", "target_book": "first_principles_spencer_1862", "target_name": "density", "similarity": 0.961}], "id": 455, "stable_key": "clu_c77f92bc275b4995", "ground_truth": {"modern_name": "Density", "confidence": "high", "type": "concept", "wikidata_id": "Q29539", "wikidata_description": "mass of a sample, material or body divided by its volume", "wikipedia_url": "https://en.wikipedia.org/wiki/Density", "wikipedia_extract": "Density (volumetric mass density or specific mass) is the ratio of a substance's mass to its volume. The symbol most often used for density is \u03c1 (the lower case Greek letter rho), although the Latin letter D (or d) can also be used: {\\displaystyle \\rho ={\\frac {m}{V}},} where \u03c1 is the density, m is the mass, and V is the volume. In some cases (for instance, in the United States oil and gas industry), density is loosely defined as its weight per unit volume, although this is scientifically inaccurate \u2013  this quantity is more specifically called specific weight. For a pure substance, the density is equal to its mass concentration. Different materials usually have different densities, and density may be relevant to buoyancy, purity and packaging. Osmium is the densest known element at standard conditions for temperature and pressure."}}, {"canonical_name": "pestilentes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 4, "total_mentions": 25, "members": [{"entity_id": "pestilence", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Pestilence", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Pestilence"], "contexts": ["disease signified by spiders"]}, {"entity_id": "pestilence", "book_id": "origin_of_species_darwin_1859", "name": "pestilence", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["pestilence"], "contexts": ["widespread deadly disease", "swept away by short-horns as if by pestilence"]}, {"entity_id": "pestilencia", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "pestilencia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["pestilencia"], "contexts": ["plague or epidemic disease", "a disease, likely plague"]}, {"entity_id": "pestilentes", "book_id": "polyanthea_medicinal", "name": "pestilentes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 20, "variants": ["pestilentes", "peftilencia", "peftilente", "peftilentia", "pestemihi", "pestilenciaes", "pestilente", "pestilentia", "pe\u017ftalenciaes", "pe\u017ftilencial", "pe\u017ftilente", "pe\u017ftilentem"], "contexts": ["pestilential", "pestilential or plague-like"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Pestilence", "target_book": "origin_of_species_darwin_1859", "target_name": "pestilence", "similarity": 0.994}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Pestilence", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "pestilencia", "similarity": 0.983}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Pestilence", "target_book": "polyanthea_medicinal", "target_name": "pestilentes", "similarity": 0.959}, {"source_book": "origin_of_species_darwin_1859", "source_name": "pestilence", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "pestilencia", "similarity": 0.99}, {"source_book": "origin_of_species_darwin_1859", "source_name": "pestilence", "target_book": "polyanthea_medicinal", "target_name": "pestilentes", "similarity": 0.964}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "pestilencia", "target_book": "polyanthea_medicinal", "target_name": "pestilentes", "similarity": 0.964}], "id": 456, "stable_key": "clu_4876e4591c4f1246", "ground_truth": {"modern_name": "Pestilence", "confidence": "high", "type": "disease", "modern_term": "Plague", "note": "While 'pestilence' can broadly refer to any deadly epidemic, its historical usage, especially in conjunction with 'pestilentes', strongly points to plague, particularly in earlier texts. In modern terms, 'plague' is the most direct equivalent for widespread, devastating epidemics of that era."}}, {"canonical_name": "Conserve", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 4, "total_mentions": 25, "members": [{"entity_id": "conserve", "book_id": "english_physician_1652", "name": "Conserve", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 17, "variants": ["Conserve", "Conserv"], "contexts": ["preserved plant preparation", "preparation of Betony"]}, {"entity_id": "conserba", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "conserba", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["conserba"], "contexts": ["preserved ginger with sugar"]}, {"entity_id": "conserva", "book_id": "coloquios_da_orta_1563", "name": "conserva", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 6, "variants": ["conserva", "conservas"], "contexts": ["preserved violets", "Method of preparation"]}, {"entity_id": "conserva", "book_id": "ricettario_fiorentino_1597", "name": "conserva", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["conserva"], "contexts": ["conserves, a type of compound medicine"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Conserve", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "conserba", "similarity": 0.958}, {"source_book": "english_physician_1652", "source_name": "Conserve", "target_book": "coloquios_da_orta_1563", "target_name": "conserva", "similarity": 0.919}, {"source_book": "english_physician_1652", "source_name": "Conserve", "target_book": "ricettario_fiorentino_1597", "target_name": "conserva", "similarity": 0.919}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "conserba", "target_book": "coloquios_da_orta_1563", "target_name": "conserva", "similarity": 0.893}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "conserba", "target_book": "ricettario_fiorentino_1597", "target_name": "conserva", "similarity": 0.893}, {"source_book": "coloquios_da_orta_1563", "source_name": "conserva", "target_book": "ricettario_fiorentino_1597", "target_name": "conserva", "similarity": 1.0}], "id": 457, "stable_key": "clu_b600864a96cc4e7c", "ground_truth": {"modern_name": "Conserve", "confidence": "high", "type": "substance", "description": "A pharmaceutical preparation, typically of fruits or herbs preserved with sugar.", "note": "Refers to a preserved preparation, often medicinal.", "wikipedia_extract": "Shellac () is a resin secreted by the female lac bug on trees in the forests of India and Thailand. Chemically, it is mainly composed of aleuritic acid, jalaric acid, shellolic acid, and other natural waxes. It is processed and sold as dry flakes and dissolved in alcohol to make liquid shellac, which is used as a brush-on colorant, food glaze and wood finish. Shellac functions as a tough natural primer, sanding sealant, tannin-blocker, odor-blocker, stain, and high-gloss varnish. Shellac was once used in electrical applications as it is a good insulator and seals out moisture. Phonograph and 78 rpm gramophone records were made of shellac until it was replaced by vinyl.", "wikipedia_url": "https://en.wikipedia.org/wiki/Shellac"}}, {"canonical_name": "Cordill\u00e8re des Andes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 25, "members": [{"entity_id": "cordill\u00e8re_des_andes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cordill\u00e8re des Andes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 16, "variants": ["Cordill\u00e8re des Andes"], "contexts": ["east of the Cordill\u00e8re des Andes", "mountain range"]}, {"entity_id": "cordill\u00e8re_orientale_des_andes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cordill\u00e8re orientale des Andes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cordill\u00e8re orientale des Andes"], "contexts": ["eastern part of the Andes mountain range"]}, {"entity_id": "cordillere_des_andes", "book_id": "kosmos_humboldt_1845", "name": "Cordillere des Andes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cordillere des Andes"], "contexts": ["mountain range"]}, {"entity_id": "andes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Andes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["Andes"], "contexts": ["mountain range in South America", "mountains ascended by Humboldt"]}, {"entity_id": "andes", "book_id": "first_principles_spencer_1862", "name": "Andes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Andes"], "contexts": ["mountain system"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cordill\u00e8re des Andes", "target_book": "kosmos_humboldt_1845", "target_name": "Cordillere des Andes", "similarity": 0.997}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cordill\u00e8re des Andes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Andes", "similarity": 0.933}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cordill\u00e8re de