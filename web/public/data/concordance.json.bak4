ples_spencer_1862", "target_name": "physical forces", "similarity": 0.887}], "id": 2796, "stable_key": "clu_9a136386bbfa0cad", "ground_truth": {"modern_name": "Physical forces", "confidence": "high", "type": "concept", "wikidata_id": "Q55920182", "wikidata_description": ""}}, {"canonical_name": "thunder", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "thunder", "book_id": "principles_of_psychology_james_1890", "name": "thunder", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["thunder"], "contexts": ["sound caused by lightning", "sound of lightning discharge"]}, {"entity_id": "thunder", "book_id": "kosmos_humboldt_1845", "name": "thunder", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 9, "variants": ["thunder"], "contexts": ["sound produced by lightning", "atmospheric electrical discharge sound"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "thunder", "target_book": "kosmos_humboldt_1845", "target_name": "thunder", "similarity": 1.0}], "id": 2797, "stable_key": "clu_2769ee94ff180603", "ground_truth": {"modern_name": "Thunder", "confidence": "high", "type": "concept", "note": "While 'thunder' is a natural phenomenon, in the context of early modern scientific texts discussing senses and perception, it functions as a sensory concept.", "wikidata_id": "Q34116", "wikidata_description": "city in Thunder Bay District, province of Ontario, Canada", "wikipedia_url": "https://en.wikipedia.org/wiki/Thunder%20Bay"}}, {"canonical_name": "radiant heat", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "radiant_heat", "book_id": "principles_of_psychology_james_1890", "name": "radiant heat", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["radiant heat"], "contexts": ["form of energy affecting skin"]}, {"entity_id": "ra