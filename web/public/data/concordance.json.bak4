f1adas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["mugeres fe pre\u00f1adas"], "contexts": ["women becoming pregnant"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "pre\u00f1adas", "target_book": "historia_medicinal_monardes_1574", "target_name": "mugeres fe pre\u00f1adas", "similarity": 0.885}], "id": 5545, "stable_key": "clu_303ceec1c09187c2", "ground_truth": {"modern_name": "Pregnancy", "confidence": "high", "type": "disease", "modern_term": "Pregnancy", "note": "While not a disease in the modern sense, 'pre\u00f1adas' refers to the state of being pregnant, often discussed within medical texts of the era regarding women's health.", "wikidata_id": "Q207087", "wikidata_description": "female reproductive system disease characterized by the implantation of the embryo outside the uterine cavity", "wikipedia_url": "https://en.wikipedia.org/wiki/Ectopic%20pregnancy"}}, {"canonical_name": "fopotoc", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fopotoc", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "fopotoc", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["fopotoc"], "contexts": ["plant name from Panuco"]}, {"entity_id": "fopo", "book_id": "ricettario_fiorentino_1597", "name": "fopo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["fopo"], "contexts": ["common name for domestic Hyssop"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "fopotoc", "target_book": "ricettario_fiorentino_1597", "target_name": "fopo", "similarity": 0.884}], "id": 5546, "stable_key": "clu_e6c5ad60b85fb8f0", "ground_truth": {"modern_name": "Hyssop", "confidence": "medium", "type": "plant", "linnaean": "Hyssopus officinalis Linnaeus", "family": "Lamiaceae", "note": "The term 'fopotoc' is indigenous, and 'fopo' is suggested as a common name for domestic Hyssop. Without more context on 'fopotoc', direct identification is difficult, but Hyssop is a plausible candidate given its medicinal use.", "wikidata_id": "Q720501", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Hyssopus%20%28plant%29"}}, {"canonical_name": "batatas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "batatas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "batatas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["batatas"], "contexts": ["plant with seeds like gamones"]}, {"entity_id": "b\u00e1tatas", "book_id": "historia_medicinal_monardes_1574", "name": "B\u00e1tatas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["B\u00e1tatas"], "contexts": ["fruit common in those lands"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "batatas", "target_book": "historia_medicinal_monardes_1574", "target_name": "B\u00e1tatas", "similarity": 0.795}], "id": 5547, "stable_key": "clu_4d6f706b5771d43c", "ground_truth": {"modern_name": "Sweet potato", "confidence": "high", "type": "plant", "linnaean": "Ipomoea batatas (Linnaeus) Lamarck", "family": "Convolvulaceae", "note": "'Batatas' is a direct reference to the sweet potato, common in the Americas and discussed in early European botanical works.", "wikidata_id": "Q37937", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Sweet%20potato"}}, {"canonical_name": "brutos animales", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "brutos_animales", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "brutos animales", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["brutos animales"], "contexts": ["animals whose state humans desire"]}, 