anonical_name": "sciences math\u00e9matiques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "sciences_math\u00e9matiques", "book_id": "medecine_experimentale_bernard_1865", "name": "sciences math\u00e9matiques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["sciences math\u00e9matiques"], "contexts": ["branch of science dealing with logic", "mathematical sciences"]}, {"entity_id": "mathematical_sciences", "book_id": "kosmos_humboldt_1845", "name": "mathematical sciences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["mathematical sciences"], "contexts": ["importance of mathematical sciences", "field of study"]}, {"entity_id": "mathematical_and_physical_sciences", "book_id": "kosmos_humboldt_1845", "name": "mathematical and physical sciences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["mathematical and physical sciences"], "contexts": ["branches of scientific study", "sciences advanced by proximity to ocean"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "sciences math\u00e9matiques", "target_book": "kosmos_humboldt_1845", "target_name": "mathematical sciences", "similarity": 0.978}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "sciences math\u00e9matiques", "target_book": "kosmos_humboldt_1845", "target_name": "mathematical and physical sciences", "similarity": 0.901}], "id": 3020, "stable_key": "clu_aa7b75e3c263398b-3", "ground_truth": {"modern_name": "Mathematics", "confidence": "high", "type": "concept", "wikidata_id": "Q853077", "wikidata_description": "mathematics teaching, learning and scholarly research", "wikipedia_url": "https://en.wikipedia.org/wiki/Mathematics%20education", "wikipedia_extract": "In contemporary education, mathematics education (known in Europe as the didactics or pedagogy of mathematics) is the practice of teaching, learning, and carrying out scholarly research into the transfer of mathematical knowledge. Although research into mathematics education is primarily concerned with the tools, methods, and approaches that facilitate practice or the study of practice, it also covers an extensive field of study encompassing a variety of different concepts, theories and methods. National and international organisations regularly hold conferences and publish literature in order to improve mathematics education. Elementary mathematics were a core part of education in many ancient civilisations, including ancient Egypt, ancient Babylonia, ancient Greece, ancient Rome, and Vedic India. In most cases, formal education was only available to male children with sufficiently high status, wealth, or caste. The oldest known mathematics textbook is the Rhind papyrus, dated from circa 1650 BCE."}}, {"canonical_name": "esprit humain", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "esprit_humain", "book_id": "medecine_experimentale_bernard_1865", "name": "esprit humain", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["esprit humain"], "contexts": ["human intellect and consciousness", "human mind"]}, {"entity_id": "l'esprit_humain", "book_id": "medecine_experimentale_bernard_1865", "name": "l'esprit humain", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["l'esprit humain"], "contexts": ["human mind and its evolution"]}, {"entity_id": "esprit_humain", "book_id": "epoques_nature_buffon_1778", "name": "esprit humain", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["esprit humain"], "contexts": ["the faculty of human thought and reason", "human mind"]}, {"entity_id": "l\u2019esprit_humain", "book_id": "epoques_nature_buffon_1778", "name": "l\u2019esprit humain", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "cou