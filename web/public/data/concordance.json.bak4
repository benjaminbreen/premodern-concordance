ntity_id": "physical_constitution", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Physical Constitution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Physical Constitution"], "contexts": ["composition and structure"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "physical constitution", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Physical Constitution", "similarity": 0.885}], "id": 5936, "stable_key": "clu_6bb0e142c3e3488a", "ground_truth": {"modern_name": "Physical constitution", "confidence": "high", "type": "concept"}}, {"canonical_name": "St. Malo", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "st__malo", "book_id": "kosmos_humboldt_1845", "name": "St. Malo", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["St. Malo"], "contexts": ["location with high tides"]}, {"entity_id": "st__malo", "book_id": "connexion_physical_sciences_somerville_1858", "name": "St. Malo", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["St. Malo"], "contexts": ["coastal city in France with high tides"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "St. Malo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "St. Malo", "similarity": 1.0}], "id": 5937, "stable_key": "clu_4b697caea9d3136f", "ground_truth": {"modern_name": "Saint-Malo", "confidence": "high", "type": "place", "country": "France", "wikidata_id": "Q163108", "wikidata_description": "commune in Ille-et-Vilaine, France", "wikipedia_url": "https://en.wikipedia.org/wiki/Saint-Malo", "wikipedia_extract": "Saint-Malo (UK: , US: , French: [s\u025b\u0303 malo] ; Gallo: Saent-Mal\u00f4; Breton: Sant-Malo\u00f9) is a historic French port commune in Ille-et-Vilaine, Brittany. The walled city on the English Channel coast has a long history of piracy, earning much wealth from local extortion and overseas adventures. In 1944, during World War II, the Allies heavily bombed Saint-Malo. The city became a popular tourist centre, with a ferry terminal serving the Channel Islands of Jersey and Guernsey, as well as the Southern English settlements of Portsmouth, Hampshire and Poole, Dorset. The transatlantic single-handed yacht race Route du Rhum, which takes place every four years in November, is between Saint Malo and Pointe-\u00e0-Pitre in Guadeloupe. The population in 2017 was 46,097 \u2013 though this can increase to up to 300,000 in the summer tourist season."}}, {"canonical_name": "Hebrides", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "hebrides", "book_id": "kosmos_humboldt_1845", "name": "Hebrides", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Hebrides"], "contexts": ["shores receive tropical seeds"]}, {"entity_id": "new_hebrides", "book_id": "connexion_physical_sciences_somerville_1858", "name": "New Hebrides", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["New Hebrides"], "contexts": ["islands in the Pacific"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Hebrides", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "New Hebrides", "similarity": 0.933}], "id": 5938, "stable_key": "clu_bee5503a6797e647", "ground_truth": {"modern_name": "Hebrides", "confidence": "high", "type": "place", "country": "United Kingdom", "note": "The cluster contains both 'Hebrides' and 'New Hebrides'. 'Hebrides' refers to the Scottish islands, while 'New Hebrides' refers to an archipelago in the Pacific Ocean (now Vanuatu). Given the context 'shores receive tropical seeds', the New Hebrides are more likely, but the primary term 'Hebrides' refers to Scotland. The instruction is to pick the best search term. I will stick with 'Hebrides' as the primary term but acknowledge the ambiguity in the note.", "wikidata_id": "Q1971856", "wikidata_description": "portion of the North Atlantic Ocean, located off the coast of western Scotland", "wikipedia_url": "https://en.wikipedia.org/wiki/Sea_of_the_Hebrides", "wikipedia_extract": "The Sea of the Hebrides (Scottish Gaelic: An Cuan Barrach, pronounced [\u0259n\u032a\u02e0 \u02c8k\u02b0uan \u02c8par\u02e0\u0259x]) is a small and partly sheltered section of the North Atlantic Ocean, indirectly off the southern part of the north-west coast of Scotland. To the east are the mainland of Scotland and the northern Inner Hebrides (including Skye and the Small Isles); to the west are the southern Outer Hebrides islands, principally South Uist, Eriskay, and Barra. To the north is the Little Minch, a channel connecting it with the Minch. The Sea of the Hebrides forms part of the Inner Seas off the West Coast of Scotland, as defined by the International Hydrographic Organization, and part of the Seas west of Scotland as far as fisheries management is concerned. Ending on 30 August 2019, the Scottish Government consulted on a proposal to designate the Sea of the Hebrides a Marine Protected Area (MPA). The designation was confirmed in December 2020."}}, {"canonical_name": "Catholic monarchs", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "catholic_monarchs", "book_id": "kosmos_humboldt_1845", "name": "Catholic monarchs", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Catholic monarchs"], "contexts": ["recipients of Columbus's letter"]}, {"entity_id": "reis_catholicos", "book_id": "coloquios_da_orta_1563", "name": "reis catholicos", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["reis catholicos"], "contexts": ["Catholic monarchs who sent aid"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Catholic monarchs", "target_book": "coloquios_da_orta_1563", "target_name": "reis catholicos", "similarity": 0.856}], "id": 5939, "stable_key": "clu_4da20640901367af", "ground_truth": {"modern_name": "Catholic Monarchs", "confidence": "high", "type": "person", "description": "Spanish monarchs who sponsored Christopher Columbus's voyages"}}, {"canonical_name": "nitrogenous contents", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "nitrogenous_contents", "book_id": "kosmos_humboldt_1845", "name": "nitrogenous contents", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nitrogenous contents"], "contexts": ["derived by plants from atmosphere"]}, {"entity_id": "nitrogenous_compounds", "book_id": "first_principles_spencer_1862", "name": "nitrogenous compounds", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nitrogenous compounds"], "contexts": ["chemical compounds containing nitrogen"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "nitrogenous contents", "target_book": "first_principles_spencer_1862", "target_name": "nitrogenous compounds", "similarity": 0.924}], "id": 5940, "stable_key": "clu_04324929190b4802-2", "ground_truth": {"modern_name": "Nitrogen", "confidence": "high", "type": "chemical", "wikidata_id": "Q14914558", "wikidata_description": "the chemical reactions and pathways involving organic or inorganic compounds that contain nitrogen"}}, {"canonical_name": "electric condition of the atmosphere", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "electric_condition_of_the_atmosphere", "book_id": "kosmos_humboldt_1845", "name": "electric condition of the atmosphere", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["electric condition of the atmosphere"], "contexts": ["electrical state of the air"]}, {"entity_id": "electric_state_of_the_air", "book_id": "connexion_physical_sciences_somer