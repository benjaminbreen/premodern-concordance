faunas", "similarity": 0.959}, {"source_book": "epoques_nature_buffon_1778", "source_name": "animaux marins", "target_book": "kosmos_humboldt_1845", "target_name": "marine animals", "similarity": 0.982}, {"source_book": "origin_of_species_darwin_1859", "source_name": "marine faunas", "target_book": "kosmos_humboldt_1845", "target_name": "marine animals", "similarity": 0.967}], "id": 1722, "stable_key": "clu_63521d95b442746a", "ground_truth": {"modern_name": "Marine animal", "confidence": "high", "type": "animal", "wikidata_id": "Q100989659", "wikidata_description": "marine animal that is a symbol of an organisation"}}, {"canonical_name": "syst\u00e8me du monde", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "syst\u00e8me_du_monde", "book_id": "epoques_nature_buffon_1778", "name": "syst\u00e8me du monde", "category": "CONCEPT", "subcategory": "THEORY", "count": 3, "variants": ["syst\u00e8me du monde"], "contexts": ["understanding of the universe's structure", "understanding of the universe"]}, {"entity_id": "systeme_du_monde", "book_id": "kosmos_humboldt_1845", "name": "Systeme du Monde", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Systeme du Monde"], "contexts": ["book title"]}, {"entity_id": "system_of_the_world", "book_id": "connexion_physical_sciences_somerville_1858", "name": "system of the world", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["system of the world"], "contexts": ["arrangement and workings of celestial bodies"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "syst\u00e8me du monde", "target_book": "kosmos_humboldt_1845", "target_name": "Systeme du Monde", "similarity": 0.927}, {"source_book": "epoques_nature_buffon_1778", "source_name": "syst\u00e8me du monde", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "system of the world", "similarity": 0.972}, {"source_book": "kosmos_humboldt_1845", "source_name": "Systeme du Monde", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "system of the world", "similarity": 0.932}], "id": 1723, "stable_key": "clu_974d63c2e4744dfc", "ground_truth": {"modern_name": "System of the World", "confidence": "high", "type": "concept", "note": "Refers to the title of a book by Pierre Simon Laplace."}}, {"canonical_name": "substances m\u00e9talliques", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "substances_m\u00e9talliques", "book_id": "epoques_nature_buffon_1778", "name": "substances m\u00e9talliques", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["substances m\u00e9talliques"], "contexts": ["metallic substances", "materials separated by heat"]}, {"entity_id": "rerum_metallicarum", "book_id": "kosmos_humboldt_1845", "name": "rerum metallicarum", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["rerum metallicarum"], "contexts": ["metallic substances"]}, {"entity_id": "metallic_substances", "book_id": "connexion_physical_sciences_somerville_1858", "name": "metallic substances", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["metallic substances"], "contexts": ["materials that conduct electricity"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "substances m\u00e9talliques", "target_book": "kosmos_humboldt_1845", "target_name": "rerum metallicarum", "similarity": 0.926}, {"source_book": "epoques_nature_buffon_1778", "source_name": "substances m\u00e9talliques", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "metallic substances", "similarity": 0.964}, {"source_book": "kosmos_humboldt_1845", "source_name": "rerum metallicarum", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "metallic substances", "similarity": 0.942}], "id": 1724, "stable_key": "clu_7907da80da20d2e2-4", "ground_truth": {"modern_name": "Metal", "confidence": "high", "type": "mineral", "wikidata_id": "Q11426", "wikidata_description": "element, compound, or alloy that is a good conductor of both electricity and heat", "wikipedia_url": "https://en.wikipedia.org/wiki/Metal", "note": "The Latin 'rerum metallicarum' directly translates to 'of metallic things' or 'metallic substances'. The context of electrical conductivity reinforces this.", "wikipedia_extract": "A metal (from Ancient Greek  \u03bc\u03ad\u03c4\u03b1\u03bb\u03bb\u03bf\u03bd (m\u00e9tallon) 'mine, quarry, metal') is a material that, when polished or fractured, shows a lustrous appearance, and conducts electricity and heat relatively well. These properties are all associated with having electrons available at the Fermi level, as opposed to nonmetallic materials which do not. Metals are typically ductile (can be drawn into a wire) and malleable (can be shaped via hammering or pressing). A metal may be a chemical element, such as iron, an alloy, such as stainless steel, or a molecular compound, such as polymeric sulfur nitride. The general science of metals is called metallurgy, a subtopic of materials science; aspects of their electronic and thermal properties are also within the scope of condensed matter physics and solid-state chemistry, as it is a multidisciplinary topic. In colloquial use, materials such as steel alloys are referred to as metals, while others, such as polymers, wood, or ceramics are nonmetallic materials."}}, {"canonical_name": "t\u00e9n\u00e8bres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "t\u00e9n\u00e8bres", "book_id": "epoques_nature_buffon_1778", "name": "t\u00e9n\u00e8bres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["t\u00e9n\u00e8bres"], "contexts": ["state of darkness covering the abyss", "element separated from light"]}, {"entity_id": "darkness", "book_id": "principles_of_psychology_james_1890", "name": "darkness", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["darkness"], "contexts": ["absence of light"]}, {"entity_id": "darkness", "book_id": "first_principles_spencer_1862", "name": "darkness", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["darkness"], "contexts": ["absence of light"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "t\u00e9n\u00e8bres", "target_book": "principles_of_psychology_james_1890", "target_name": "darkness", "similarity": 0.921}, {"source_book": "epoques_nature_buffon_1778", "source_name": "t\u00e9n\u00e8bres", "target_book": "first_principles_spencer_1862", "target_name": "darkness", "similarity": 0.921}, {"source_book": "principles_of_psychology_james_1890", "source_name": "darkness", "target_book": "first_principles_spencer_1862", "target_name": "darkness", "similarity": 1.0}], "id": 1725, "stable_key": "clu_7211966a5b504747", "ground_truth": {"modern_name": "Darkness", "confidence": "high", "type": "concept", "wikidata_id": "Q204170", "wikidata_description": "lack of light", "wikipedia_url": "https://en.wikipedia.org/wiki/Darkness", "wikipedia_extract": "Darkness is the condition resulting from a lack of illumination, or an absence of visible light. Human vision is unable to distinguish colors in conditions of very low luminance because the hue-sensitive photoreceptor cells on the retina are inactive when light levels are insufficient, in the range of visual perception referred to as scotopic vision. The emotional response to darkness has led to metaphorical usages of the term in many cultures, often to convey feelings of unhappiness or forebording. \"Darkness\" may also refer to night, which occurs when the Sun is more than 18\u00b0 below the horizon. The perception of darkness differs from the mere absence of light that sometimes lead to afterimages. In perceiving, the eye is active, and the part of the retina that is unstimulated produces a complementary afterimage."}}, {"canonical_name": "Tartarie chinoise", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "tartarie_chinoise", "book_id": "epoques_nature_buffon_1778", "name": "Tartarie chinoise", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Tartarie chinoise"], "contexts": ["region east of Tibet", "region where Amour river flows"]}, {"entity_id": "tartarie_chinoise", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tartarie Chinoise", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Tartarie Chinoise"], "contexts": ["historical region in Asia"]}, {"entity_id": "chinese_tartary", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Chinese Tartary", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Chinese Tartary"], "contexts": ["region where herbarium was collected", "herbarium collected in"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Tartarie chinoise", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Tartarie Chinoise", "similarity": 0.97}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Tartarie chinoise", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Chinese Tartary", "similarity": 0.911}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tartarie Chinoise", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Chinese Tartary", "similarity": 0.886}], "id": 1726, "stable_key": "clu_b0ef4bcbc1153307", "ground_truth": {"modern_name": "Chinese Tartary", "confidence": "high", "type": "place", "country": "China", "wikidata_id": "Q5100667", "wikidata_description": "indirect control areas of the Qing dynasty east of the Pamir plateau", "wikipedia_url": "https://en.wikipedia.org/wiki/Chinese%20Tartary", "wikipedia_extract": "Chinese Tartary (Chinese: \u4e2d\u570b\u97c3\u977c\u5229\u4e9e; pinyin: Zh\u014dnggu\u00f3 D\u00e1d\u00e1l\u00ecy\u00e0 or Chinese: \u4e2d\u5c5e\u9791\u977c\u5229\u4e9a; pinyin: Zh\u014dng sh\u01d4 D\u00e1d\u00e1l\u00ecy\u00e0) is an archaic geographical term referring to the regions of Manchuria, Mongolia, Xinjiang (also referred to as Chinese Turkestan), and Tibet under the rule of the Qing dynasty of China. The geographical extent of Chinese Tartary largely corresponds with that of the \"Feudatory Regions\" (Chinese: \u85e9\u90e8; pinyin: f\u0101nb\u00f9), as defined by the Qing court. The term \"Tartar\" was used by Europeans to refer to ethnicities living in northern, northeastern, and western China, including the Mongols, Manchus, Tibetans, and Central Asians. Some definitions include the Japanese (as indicated in violet on the map below). The regions are now more commonly referred to by scholars as Inner Asia. Early European writers used the term \"Tartar\" indiscriminately for all the peoples of Northern Eurasia and referred to their lands as \"Tartary\"."}}, {"canonical_name": "impulse", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "impulsion", "book_id": "epoques_nature_buffon_1778", "name": "impulsion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["impulsion"], "contexts": ["impulse"]}, {"entity_id": "impulse", "book_id": "principles_of_psychology_james_1890", "name": "impulse", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["impulse"], "contexts": ["sudden urge to act", "sudden urge or motivation"]}, {"entity_id": "impulse", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Impulse", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Impulse"], "contexts": ["sudden force"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "impulsion", "target_book": "principles_of_psychology_james_1890", "target_name": "impulse", "similarity": 0.969}, {"source_book": "epoques_nature_buffon_1778", "source_name": "impulsion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Impulse", "similarity": 0.887}, {"source_book": "principles_of_psychology_james_1890", "source_name": "impulse", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Impulse", "similarity": 0.927}], "id": 1727, "stable_key": "clu_1986f5d0de31ef08", "ground_truth": {"modern_name": "Impulse", "confidence": "high", "type": "concept", "wikidata_id": "Q11267664", "wikidata_description": "Bulgarian musical group"}}, {"canonical_name": "La M\u00e9diterran\u00e9e", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "mer_m\u00e9diterran\u00e9e", "book_id": "epoques_nature_buffon_1778", "name": "mer M\u00e9diterran\u00e9e", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["mer M\u00e9diterran\u00e9e"], "contexts": ["sea bordering Africa and Europe"]}, {"entity_id": "la_m\u00e9diterran\u00e9e", "book_id": "relation_historique_humboldt_vol3_1825", "name": "La M\u00e9diterran\u00e9e", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["la M\u00e9diterran\u00e9e", "La M\u00e9diterran\u00e9e"], "contexts": ["sea basin in early navigation", "sea with a specific surface area"]}, {"entity_id": "mediterra\u00e2neo", "book_id": "coloquios_da_orta_1563", "name": "Mediterra\u00e2neo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Mediterra\u00e2neo", "mar Mediterr\u00e2neo"], "contexts": ["sea where spice reached peoples", "sea"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "mer M\u00e9diterran\u00e9e", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "La M\u00e9diterran\u00e9e", "similarity": 0.978}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mer M\u00e9diterran\u00e9e", "target_book": "coloquios_da_orta_1563", "target_name": "Mediterra\u00e2neo", "similarity": 0.971}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "La M\u00e9diterran\u00e9e", "target_book": "coloquios_da_orta_1563", "target_name": "Mediterra\u00e2neo", "similarity": 0.971}], "id": 1728, "stable_key": "clu_65745ddfaecb6834-2", "ground_truth": {"modern_name": "Mediterranean Sea", "confidence": "high", "type": "place", "country": "Multiple", "wikidata_id": "Q72499", "wikidata_description": "loosely defined region of lands around the Mediterranean Sea", "wikipedia_url": "https://en.wikipedia.org/wiki/Mediterranean%20basin", "wikipedia_extract": "In biogeography, the Mediterranean basin ( MED-ih-t\u0259-RAY-nee-\u0259n), also known as the Mediterranean region or sometimes Mediterranea, is the region of lands around the Mediterranean Sea that mostly have a Mediterranean climate, with mild to cool, rainy winters and warm to hot, dry summers, which supports characteristic Mediterranean forests, woodlands, and scrub vegetation. The Mediterranean basin covers portions of three continents: Africa, Asia, and Europe. It is not the same as the drainage basin of the Mediterranean Sea; the drainage basin is larger, as rivers including the Nile and Rh\u00f4ne reach further into Africa and Europe. Conversely, the Mediterranean basin includes regions not in the drainage basin, such as Iraq, Jordan, and Portugal. It has a varied and contrasting topography. The Mediterranean region offers a varied landscape of high mountains, rocky shores, impenetrable scrub, semi-arid steppes, coastal wetlands, sandy beaches and a myriad of islands of various shapes and sizes dotted amidst the clear blue sea."}}, {"canonical_name": "Grape", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "grape", "book_id": "english_physician_1652", "name": "Grape", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Grape", "Grapes"], "contexts": ["plant with stones for comparison", "fruit of a vine"]}, {"entity_id": "grapes", "book_id": "kosmos_humboldt_1845", "name": "grapes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["grapes"], "contexts": ["fruit"]}, {"entity_id": "grape", "book_id": "kosmos_humboldt_1845", "name": "grape", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["grape"], "contexts": ["fruit that requires heat for wine production"]}, {"entity_id": "grapes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "grapes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["grapes"], "contexts": ["fruit source of sugar"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Grape", "target_book": "kosmos_humboldt_1845", "target_name": "grapes", "similarity": 0.922}, {"source_book": "english_physician_1652", "source_name": "Grape", "target_book": "kosmos_humboldt_1845", "target_name": "grape", "similarity": 0.975}, {"source_book": "english_physician_1652", "source_name": "Grape", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "grapes", "similarity": 0.922}, {"source_book": "kosmos_humboldt_1845", "source_name": "grapes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "grapes", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "grape", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "grapes", "similarity": 0.947}], "id": 1729, "stable_key": "clu_ff926b990942b265", "ground_truth": {"modern_name": "Vine", "confidence": "high", "type": "plant", "note": "While 'vine' can refer to many climbing plants, the context of 'yielding grapes' strongly suggests the grapevine.", "wikidata_id": "Q30046", "wikidata_description": "species of flowering plant in the grape vine family Vitaceae", "wikipedia_url": "https://en.wikipedia.org/wiki/Vitis%20vinifera", "linnaean": "Vitis vinifera", "family": "Vitaceae", "wikipedia_extract": "Vitis vinifera, the common grape vine, is a species of flowering plant, native to the Mediterranean region, Central Europe, and southwestern Asia, from Morocco and Portugal north to southern Germany and east to northern Iran. As of 2012, there were between 5,000 and 10,000 varieties of Vitis vinifera grapes though only a few are of commercial significance for wine and table grape production. The wild grape is sometimes classified as Vitis vinifera var. sylvestris (in some classifications considered Vitis sylvestris), with Vitis vinifera var vinifera restricted to cultivated forms. Domesticated vines have hermaphrodite flowers, but V. vinifera var."}}, {"canonical_name": "Cup", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "cup", "book_id": "english_physician_1652", "name": "Cup", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Cup"], "contexts": ["vessel for drinking", "drinking vessels made of wood"]}, {"entity_id": "ta\u00e7a", "book_id": "coloquios_da_orta_1563", "name": "ta\u00e7a", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["ta\u00e7a"], "contexts": ["use of shell", "vessel, originally meaning mollusk shell"]}, {"entity_id": "cup", "book_id": "connexion_physical_sciences_somerville_1858", "name": "cup", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["cup"], "contexts": ["vessel for liquid"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Cup", "target_book": "coloquios_da_orta_1563", "target_name": "ta\u00e7a", "similarity": 0.901}, {"source_book": "english_physician_1652", "source_name": "Cup", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "cup", "similarity": 0.984}, {"source_book": "coloquios_da_orta_1563", "source_name": "ta\u00e7a", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "cup", "similarity": 0.923}], "id": 1730, "stable_key": "clu_fc380682835ea6df", "ground_truth": {"modern_name": "Cup", "confidence": "high", "type": "object", "wikidata_id": "Q146037", "wikidata_description": "family of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Cupressaceae", "wikipedia_extract": "Cupressaceae or the cypress family is a family of conifers. The family includes 27\u201330 genera (17 monotypic), which include the junipers and redwoods, with about 130\u2013140 species in total. They are monoecious, subdioecious or (rarely) dioecious trees and shrubs up to 116 m (381 ft) tall. The bark of mature trees is commonly orange- to red-brown and of stringy texture, often flaking or peeling in vertical strips, but smooth, scaly or hard and square-cracked in some species. The family reached its peak of diversity during the Mesozoic era. The leaves are arranged either spirally, in decussate pairs (opposite pairs, each pair at 90\u00b0 to the previous pair) or in decussate whorls of three or four, depending on the genus."}}, {"canonical_name": "Sea Coasts", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "sea_coasts", "book_id": "english_physician_1652", "name": "Sea Coasts", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Sea Coasts"], "contexts": ["geographic location", "location where the plant is found"]}, {"entity_id": "sea-coasts", "book_id": "origin_of_species_darwin_1859", "name": "sea-coasts", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["sea-coasts"], "contexts": ["habitats for brassy or lurid insects"]}, {"entity_id": "sea-coast", "book_id": "kosmos_humboldt_1845", "name": "sea-coast", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["sea-coast"], "contexts": ["boundary between land and sea", "edge of the land bordering the sea"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Sea Coasts", "target_book": "origin_of_species_darwin_1859", "target_name": "sea-coasts", "similarity": 0.969}, {"source_book": "origin_of_species_darwin_1859", "source_name": "sea-coasts", "target_book": "kosmos_humboldt_1845", "target_name": "sea-coast", "similarity": 0.971}], "id": 1731, "stable_key": "clu_8dfaf03ebf057298", "ground_truth": {"modern_name": "Coastline", "confidence": "high", "type": "place", "note": "This refers to the general geographical feature of land bordering the sea.", "wikidata_id": "Q1701967", "wikidata_description": "outline of the coast"}}, {"canonical_name": "Oats", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "oats", "book_id": "english_physician_1652", "name": "Oats", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Oats"], "contexts": ["cereal grain", "grain used in a poultice"]}, {"entity_id": "oat", "book_id": "origin_of_species_darwin_1859", "name": "oat", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["oat"], "contexts": ["seed that germinated after bird digestion"]}, {"entity_id": "oats", "book_id": "first_principles_spencer_1862", "name": "oats", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["oats"], "contexts": ["agricultural staple crop", "rural inhabitants producing oats"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Oats", "target_book": "origin_of_species_darwin_1859", "target_name": "oat", "similarity": 0.903}, {"source_book": "english_physician_1652", "source_name": "Oats", "target_book": "first_principles_spencer_1862", "target_name": "oats", "similarity": 0.984}, {"source_book": "origin_of_species_darwin_1859", "source_name": "oat", "target_book": "first_principles_spencer_1862", "target_name": "oats", "similarity": 0.929}], "id": 1732, "stable_key": "clu_0377c783cf3f1f68", "ground_truth": {"modern_name": "Oats", "confidence": "high", "type": "plant", "linnaean": "Avena sativa", "family": "Poaceae", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "parents", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "parentis", "book_id": "english_physician_1652", "name": "Parentis", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Parentis"], "contexts": ["father"]}, {"entity_id": "parents", "book_id": "origin_of_species_darwin_1859", "name": "parents", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["parents"], "contexts": ["progenitors of offspring"]}, {"entity_id": "parent", "book_id": "origin_of_species_darwin_1859", "name": "parent", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["parent"], "contexts": ["progenitor of offspring"]}, {"entity_id": "parente", "book_id": "polyanthea_medicinal", "name": "parente", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["parente"], "contexts": ["relative of the narrator"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Parentis", "target_book": "origin_of_species_darwin_1859", "target_name": "parents", "similarity": 0.858}, {"source_book": "english_physician_1652", "source_name": "Parentis", "target_book": "origin_of_species_darwin_1859", "target_name": "parent", "similarity": 0.902}, {"source_book": "english_physician_1652", "source_name": "Parentis", "target_book": "polyanthea_medicinal", "target_name": "parente", "similarity": 0.9}, {"source_book": "origin_of_species_darwin_1859", "source_name": "parents", "target_book": "polyanthea_medicinal", "target_name": "parente", "similarity": 0.909}, {"source_book": "origin_of_species_darwin_1859", "source_name": "parent", "target_book": "polyanthea_medicinal", "target_name": "parente", "similarity": 0.976}], "id": 1733, "stable_key": "clu_5f44fb4419aed9fa", "ground_truth": {"modern_name": "Parents", "confidence": "high", "type": "person", "description": "Progenitors of offspring, biological or familial", "wikidata_id": "Q7566", "wikidata_description": "progenitor or caregiver of the offspring in their own species, inverse label for property P40", "wikipedia_url": "https://en.wikipedia.org/wiki/Parent", "wikipedia_extract": "A parent is either the progenitor of a child or, in humans, it can refer to a caregiver or legal guardian, generally called an adoptive parent or step-parent. Parents who are progenitors are first-degree relatives and have 50% genetic meet. A female can also become a parent through surrogacy. Some parents may be adoptive parents, who nurture and raise an offspring, but are not related to the child. Orphans without adoptive parents can be raised by their grandparents or other family members. A parent can also be elaborated as an ancestor removed one generation."}}, {"canonical_name": "Turner", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "turner", "book_id": "english_physician_1652", "name": "Turner", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Turner"], "contexts": ["author"]}, {"entity_id": "turner", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Turner", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Turner"], "contexts": ["traveler in the Himalayas"]}, {"entity_id": "turner", "book_id": "kosmos_humboldt_1845", "name": "Turner", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Turner"], "contexts": ["author of Collections for the History of Grantham", "author of 'Collections for the History of Grantham'"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Turner", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Turner", "similarity": 0.797}, {"source_book": "english_physician_1652", "source_name": "Turner", "target_book": "kosmos_humboldt_1845", "target_name": "Turner", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Turner", "target_book": "kosmos_humboldt_1845", "target_name": "Turner", "similarity": 0.797}], "id": 1734, "stable_key": "clu_84be5e5f1d94ed15", "ground_truth": {"modern_name": "William Turner", "confidence": "high", "type": "person", "birth_year": 1508, "death_year": 1568, "description": "English physician, naturalist, and cleric", "note": "Multiple individuals named Turner existed. The context of early modern texts and natural history points to William Turner, a prominent physician and naturalist of the 16th century. While Humboldt's 'Kosmos' is later (19th C), it often referenced earlier naturalists."}}, {"canonical_name": "Prayer", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "prayer", "book_id": "english_physician_1652", "name": "Prayer", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Prayer"], "contexts": ["religious observance"]}, {"entity_id": "prayers", "book_id": "principles_of_psychology_james_1890", "name": "prayers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["prayers"], "contexts": ["can be said with attention elsewhere"]}, {"entity_id": "prayer", "book_id": "principles_of_psychology_james_1890", "name": "prayer", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["prayer"], "contexts": ["communication with a deity"]}, {"entity_id": "ora\u00e7\u00e3o", "book_id": "polyanthea_medicinal", "name": "Ora\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Ora\u00e7\u00e3o"], "contexts": ["religious practice"]}, {"entity_id": "rezar", "book_id": "polyanthea_medicinal", "name": "rezar", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["rezar"], "contexts": ["praying"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Prayer", "target_book": "principles_of_psychology_james_1890", "target_name": "prayers", "similarity": 0.919}, {"source_book": "english_physician_1652", "source_name": "Prayer", "target_book": "principles_of_psychology_james_1890", "target_name": "prayer", "similarity": 0.97}, {"source_book": "english_physician_1652", "source_name": "Prayer", "target_book": "polyanthea_medicinal", "target_name": "Ora\u00e7\u00e3o", "similarity": 0.945}, {"source_book": "english_physician_1652", "source_name": "Prayer", "target_book": "polyanthea_medicinal", "target_name": "rezar", "similarity": 0.914}, {"source_book": "principles_of_psychology_james_1890", "source_name": "prayers", "target_book": "polyanthea_medicinal", "target_name": "rezar", "similarity": 0.883}, {"source_book": "principles_of_psychology_james_1890", "source_name": "prayer", "target_book": "polyanthea_medicinal", "target_name": "Ora\u00e7\u00e3o", "similarity": 0.939}, {"source_book": "principles_of_psychology_james_1890", "source_name": "prayer", "target_book": "polyanthea_medicinal", "target_name": "rezar", "similarity": 0.919}], "id": 1735, "stable_key": "clu_22c2d650f28b20ad", "ground_truth": {"modern_name": "prayer", "confidence": "high", "type": "concept", "description": "Communication with or worship of a deity; religious observance.", "wikipedia_extract": "Prayer is an invocation or act that seeks to activate a rapport with an object of worship through deliberate communication. In the narrow sense, the term refers to an act of supplication or intercession directed towards a deity or a deified ancestor. More generally, prayer can also have the purpose of giving thanks or praise, and in comparative religion is closely associated with more abstract forms of meditation and with charms or spells. Prayer can take a variety of forms: it can be part of a set liturgy or ritual, and it can be performed alone or in groups. Prayer may take the form of a hymn, incantation, formal creedal statement, or a spontaneous utterance in the praying person. The act of prayer is attested in written sources as early as five thousand years ago."}}, {"canonical_name": "olives", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "olives", "book_id": "english_physician_1652", "name": "Olives", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Olives"], "contexts": ["unripe fruit used for oil"]}, {"entity_id": "olives", "book_id": "relation_historique_humboldt_vol3_1825", "name": "olives", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["olives"], "contexts": ["dried fruit import"]}, {"entity_id": "olives", "book_id": "kosmos_humboldt_1845", "name": "olives", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["olives"], "contexts": ["fruit-bearing trees", "cultivated plant"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Olives", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "olives", "similarity": 0.972}, {"source_book": "english_physician_1652", "source_name": "Olives", "target_book": "kosmos_humboldt_1845", "target_name": "olives", "similarity": 0.972}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "olives", "target_book": "kosmos_humboldt_1845", "target_name": "olives", "similarity": 1.0}], "id": 1736, "stable_key": "clu_8dd432ad0cd0c7f8", "ground_truth": {"modern_name": "olive tree", "confidence": "high", "type": "plant", "linnaean": "Olea europaea", "family": "Oleaceae", "description": "Tree producing olives and olive oil, valued for its fruit and oil.", "wikipedia_extract": "The olive (botanical name Olea europaea, \"European olive\") is a species of subtropical evergreen tree in the family Oleaceae. Originating in Asia Minor, it is abundant throughout the Mediterranean Basin, with wild subspecies in Africa and western Asia; modern cultivars are traced primarily to the Near East, Aegean Sea, and Strait of Gibraltar. The olive is the type species for its genus, Olea, and lends its name to the Oleaceae plant family, which includes lilac, jasmine, forsythia, and ash. The olive fruit is classed botanically as a drupe, similar in structure and function to the cherry or peach. The term oil\u2014now used to describe any viscous water-insoluble liquid\u2014was originally synonymous with olive oil, the liquid fat derived from olives. The olive has deep historical, economic, and cultural significance in the Mediterranean."}}, {"canonical_name": "vertebrate animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "vertebrate_animals", "book_id": "origin_of_species_darwin_1859", "name": "vertebrate animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["vertebrate animals"], "contexts": ["animals that pair for birth", "animals with a backbone"]}, {"entity_id": "vertebrated_animals", "book_id": "kosmos_humboldt_1845", "name": "vertebrated animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["vertebrated animals"], "contexts": ["animals with a backbone"]}, {"entity_id": "vertebrate_animals", "book_id": "first_principles_spencer_1862", "name": "vertebrate animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["vertebrate animals"], "contexts": ["animals with backbones"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "vertebrate animals", "target_book": "kosmos_humboldt_1845", "target_name": "vertebrated animals", "similarity": 0.996}, {"source_book": "origin_of_species_darwin_1859", "source_name": "vertebrate animals", "target_book": "first_principles_spencer_1862", "target_name": "vertebrate animals", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "vertebrated animals", "target_book": "first_principles_spencer_1862", "target_name": "vertebrate animals", "similarity": 0.996}], "id": 1737, "stable_key": "clu_342d61281544e12d-2", "ground_truth": {"modern_name": "Vertebrata", "confidence": "high", "type": "animal", "wikidata_id": "Q3556237", "wikidata_description": "genus of algae"}}, {"canonical_name": "Ceylon", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "ceylon", "book_id": "origin_of_species_darwin_1859", "name": "Ceylon", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Ceylon"], "contexts": ["island nation in South Asia", "location of observation"]}, {"entity_id": "geylan", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Geylan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Geylan"], "contexts": ["destination of voyage"]}, {"entity_id": "ceylon", "book_id": "kosmos_humboldt_1845", "name": "Ceylon", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Ceylon"], "contexts": ["proposed location for magnetic stations"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Ceylon", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Geylan", "similarity": 0.902}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Ceylon", "target_book": "kosmos_humboldt_1845", "target_name": "Ceylon", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Geylan", "target_book": "kosmos_humboldt_1845", "target_name": "Ceylon", "similarity": 0.902}], "id": 1738, "stable_key": "clu_8d0e5c83d385a826", "ground_truth": {"modern_name": "Sri Lanka", "confidence": "high", "type": "place", "country": "Sri Lanka", "note": "Geylan and Geilam are historical names for Ceylon, which is now Sri Lanka."}}, {"canonical_name": "snakes", "category": "ANIMAL", "subcategory": "REPTILE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "snakes", "book_id": "origin_of_species_darwin_1859", "name": "snakes", "category": "ANIMAL", "subcategory": "REPTILE", "count": 3, "variants": ["snakes"], "contexts": ["reptiles with specific body and swallowing shapes", "reptiles with rudimentary lung lobes or pelvis"]}, {"entity_id": "snakes", "book_id": "kosmos_humboldt_1845", "name": "snakes", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["snakes"], "contexts": ["animals suffocated by gas"]}, {"entity_id": "snakes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "snakes", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["snakes"], "contexts": ["venomous, specifically different in localities"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "snakes", "target_book": "kosmos_humboldt_1845", "target_name": "snakes", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "snakes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "snakes", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "snakes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "snakes", "similarity": 1.0}], "id": 1739, "stable_key": "clu_22a686330488aa12-3", "ground_truth": {"modern_name": "Snakes", "confidence": "high", "type": "animal", "wikidata_id": "Q2102", "wikidata_description": "limbless, scaly, elongate reptile", "wikipedia_url": "https://en.wikipedia.org/wiki/Snake", "wikipedia_extract": "Snakes are elongated limbless reptiles of the suborder Serpentes. Cladistically squamates, snakes are ectothermic, amniote vertebrates covered in overlapping scales much like other members of the group. Many species of snakes have skulls with several more joints than their lizard ancestors and relatives, enabling them to swallow prey much larger than their heads (cranial kinesis). To accommodate their narrow bodies, snakes' paired organs (such as kidneys) appear one in front of the other instead of side by side, and most only have one functional lung. Some species retain a pelvic girdle with a pair of vestigial claws on either side of the cloaca. Lizards have independently evolved elongate bodies without limbs or with greatly reduced limbs at least twenty-five times via convergent evolution, leading to many lineages of legless lizards."}}, {"canonical_name": "spiders", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "spiders", "book_id": "origin_of_species_darwin_1859", "name": "spiders", "category": "ANIMAL", "subcategory": "INSECT", "count": 3, "variants": ["spiders"], "contexts": ["animals with no metamorphosis", "example of animal development rule"]}, {"entity_id": "spiders", "book_id": "kosmos_humboldt_1845", "name": "spiders", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["spiders"], "contexts": ["arachnids found in amber"]}, {"entity_id": "spiders", "book_id": "first_principles_spencer_1862", "name": "spiders", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["spiders"], "contexts": ["higher division of Annulosa with reduced segments"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "spiders", "target_book": "kosmos_humboldt_1845", "target_name": "spiders", "similarity": 0.931}, {"source_book": "origin_of_species_darwin_1859", "source_name": "spiders", "target_book": "first_principles_spencer_1862", "target_name": "spiders", "similarity": 0.931}, {"source_book": "kosmos_humboldt_1845", "source_name": "spiders", "target_book": "first_principles_spencer_1862", "target_name": "spiders", "similarity": 1.0}], "id": 1740, "stable_key": "clu_5f00f67bc5e475b3", "ground_truth": {"wikipedia_extract": "Spiders (order Araneae) are air-breathing arthropods that have eight limbs, chelicerae with fangs generally able to inject venom, and spinnerets that extrude silk. They are the largest order of arachnids and rank seventh in total species diversity among all orders of organisms. Spiders are found worldwide on every continent except Antarctica, and have become established in nearly every land habitat. As of January 2026, 53,680 spider species in 139 families have been recorded by taxonomists. However, there has been debate among scientists about how families should be classified, with over 20 different classifications proposed since 1900. Anatomically, spiders (as with all arachnids) differ from other arthropods in that the usual body segments are fused into two tagmata, the cephalothorax or prosoma, and the opisthosoma, or abdomen, and joined by a small, cylindrical pedicel."}}, {"canonical_name": "Professor Owen", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "professor_owen", "book_id": "origin_of_species_darwin_1859", "name": "Professor Owen", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Professor Owen"], "contexts": ["naturalist who coined 'vegetative repetition'", "identified fossil horse tooth"]}, {"entity_id": "professor_owen", "book_id": "kosmos_humboldt_1845", "name": "Professor Owen", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Professor Owen"], "contexts": ["described preserved Cephalopodes specimens", "author of memoir on fossil remains"]}, {"entity_id": "prof__owen", "book_id": "first_principles_spencer_1862", "name": "Prof. Owen", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Prof. Owen"], "contexts": ["authority on animal structure"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Professor Owen", "target_book": "kosmos_humboldt_1845", "target_name": "Professor Owen", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Professor Owen", "target_book": "first_principles_spencer_1862", "target_name": "Prof. Owen", "similarity": 0.977}, {"source_book": "kosmos_humboldt_1845", "source_name": "Professor Owen", "target_book": "first_principles_spencer_1862", "target_name": "Prof. Owen", "similarity": 0.977}], "id": 1741, "stable_key": "clu_43c33b14556c53df", "ground_truth": {"modern_name": "Richard Owen", "confidence": "high", "type": "person", "birth_year": 1804, "death_year": 1892, "description": "British biologist, comparative anatomist, and paleontologist.", "wikidata_id": "Q151556", "wikidata_description": "English biologist and paleontologist (1804\u20131892)", "wikipedia_url": "https://en.wikipedia.org/wiki/Richard%20Owen", "wikipedia_extract": "Sir Richard Owen  (20 July 1804 \u2013 18 December 1892) was an English biologist, comparative anatomist and  palaeontologist. Owen is generally considered to have been an outstanding naturalist with a remarkable gift for interpreting fossils. Owen produced a vast array of scientific work, but is probably best remembered today for coining the word Dinosauria (meaning \"Terrible Reptile\" or \"Fearfully Great Reptile\"). An outspoken critic of Charles Darwin's theory of evolution by natural selection, Owen agreed with Darwin that evolution occurred but thought it was more complex than outlined in Darwin's On the Origin of Species.[page range too broad] Owen's approach to evolution can be considered to have anticipated the issues that have gained greater attention with the recent emergence of evolutionary developmental biology. Owen was the first president of the Microscopical Society of London in 1839 and edited many issues of its journal \u2013 then known as The Microscopic Journal. Owen also campaigned for the natural specimens in the British Museum to be given a new home."}}, {"canonical_name": "numbers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "numbers", "book_id": "origin_of_species_darwin_1859", "name": "numbers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["numbers"], "contexts": ["quantity of individuals"]}, {"entity_id": "numerals", "book_id": "principles_of_psychology_james_1890", "name": "numerals", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["numerals"], "contexts": ["words representing numbers"]}, {"entity_id": "number", "book_id": "principles_of_psychology_james_1890", "name": "number", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["number"], "contexts": ["mathematical quantity"]}, {"entity_id": "numbers", "book_id": "principles_of_psychology_james_1890", "name": "numbers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["numbers"], "contexts": ["mathematical symbols for quantity"]}, {"entity_id": "number", "book_id": "first_principles_spencer_1862", "name": "number", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["number"], "contexts": ["grammatical distinction of singular/plural"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "numbers", "target_book": "principles_of_psychology_james_1890", "target_name": "numerals", "similarity": 0.951}, {"source_book": "origin_of_species_darwin_1859", "source_name": "numbers", "target_book": "principles_of_psychology_james_1890", "target_name": "number", "similarity": 0.855}, {"source_book": "origin_of_species_darwin_1859", "source_name": "numbers", "target_book": "principles_of_psychology_james_1890", "target_name": "numbers", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "numbers", "target_book": "first_principles_spencer_1862", "target_name": "number", "similarity": 0.855}, {"source_book": "principles_of_psychology_james_1890", "source_name": "number", "target_book": "first_principles_spencer_1862", "target_name": "number", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "numbers", "target_book": "first_principles_spencer_1862", "target_name": "number", "similarity": 0.855}], "id": 1742, "stable_key": "clu_da340677956c2a49", "ground_truth": {"modern_name": "Number", "confidence": "high", "type": "concept", "wikidata_id": "Q11563", "wikidata_description": "mathematical object used to count, label, and measure", "wikipedia_url": "https://en.wikipedia.org/wiki/Number", "wikipedia_extract": "A number is a mathematical object used to count, measure, and label. The most basic examples are the natural numbers: 1, 2, 3, 4, 5, and so forth. Individual numbers can be represented in language with number words or by dedicated symbols called numerals; for example, \"five\" is a number word and \"5\" is the corresponding numeral. As only a limited list of symbols can be memorized, a numeral system is used to represent any number in an organized way. The most common representation is the Hindu\u2013Arabic numeral system, which can display any non-negative integer using a combination of ten symbols, called numerical digits. Numerals can be used for counting (as with cardinal number of a collection or set), labels (as with telephone numbers), for ordering (as with serial numbers), and for codes (as with ISBNs)."}}, {"canonical_name": "innate", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "hereditary", "book_id": "origin_of_species_darwin_1859", "name": "hereditary", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hereditary"], "contexts": ["passed down through inheritance"]}, {"entity_id": "inherited", "book_id": "origin_of_species_darwin_1859", "name": "inherited", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["inherited"], "contexts": ["passed down genetically"]}, {"entity_id": "innate", "book_id": "principles_of_psychology_james_1890", "name": "innate", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["innate"], "contexts": ["inborn, natural", "inherent quality of movement"]}, {"entity_id": "hereditary", "book_id": "first_principles_spencer_1862", "name": "hereditary", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hereditary"], "contexts": ["passed down through generations"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "hereditary", "target_book": "first_principles_spencer_1862", "target_name": "hereditary", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "inherited", "target_book": "principles_of_psychology_james_1890", "target_name": "innate", "similarity": 0.892}, {"source_book": "origin_of_species_darwin_1859", "source_name": "inherited", "target_book": "first_principles_spencer_1862", "target_name": "hereditary", "similarity": 0.93}], "id": 1743, "stable_key": "clu_4310a3e28994b064", "ground_truth": {"modern_name": "Heredity", "confidence": "high", "type": "concept", "wikidata_id": "Q2261546", "wikidata_description": "scientific journal", "wikipedia_url": "https://en.wikipedia.org/wiki/Heredity", "wikipedia_extract": "Heredity, also called inheritance or biological inheritance, is the passing on of traits from parents to their offspring; either through asexual reproduction or sexual reproduction, the offspring cells or organisms acquire the genetic information of their parents. Through heredity, variations between individuals can accumulate and cause species to evolve by natural selection. The study of heredity in biology is genetics. In humans, eye color is an example of an inherited characteristic: an individual might inherit the \"brown-eye trait\" from one of the parents. Inherited traits are controlled by genes and the complete set of genes within an organism's genome is called its genotype. The complete set of observable traits of the structure and behavior of an organism is called its phenotype."}}, {"canonical_name": "pinos", "category": "PLANT", "subcategory": "TREE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "pines", "book_id": "origin_of_species_darwin_1859", "name": "pines", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["pines"], "contexts": ["coniferous evergreen trees"]}, {"entity_id": "pinos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "pinos", "category": "PLANT", "subcategory": "TREE", "count": 3, "variants": ["pinos"], "contexts": ["trees in comparison to palo santo", "tall pine trees, compared to ahuehuetl"]}, {"entity_id": "pines", "book_id": "connexion_physical_sciences_somerville_1858", "name": "pines", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["pines"], "contexts": ["third vegetation zone on volcano"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "pines", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "pinos", "similarity": 0.957}, {"source_book": "origin_of_species_darwin_1859", "source_name": "pines", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "pines", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "pinos", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "pines", "similarity": 0.957}], "id": 1744, "stable_key": "clu_39b28c9774d76de8-3", "ground_truth": {"modern_name": "Pine", "confidence": "high", "type": "plant", "linnaean": "Pinus", "family": "Pinaceae", "wikidata_id": "Q1258277", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Pinellia%20ternata", "note": "'pine-apple' in Darwin's *Origin of Species* is an archaic term for the fruit of the pineapple plant, but the presence of 'pines' and 'pineta' referring to coniferous trees in other contexts makes 'Pine' the most encompassing modern referent.", "wikipedia_extract": "Pinellia ternata (Chinese: \u534a\u590f, Japanese: \u30ab\u30e9\u30b9\u30d3\u30b7\u30e3\u30af), crow-dipper, is a plant that is native to China, Japan, and Korea. However, it also grows as an invasive weed in parts of Europe (Austria, Germany) and in North America (California, Ontario, the northeastern United States). The leaves are trifoliate, and the flowers are of the spathe and spadix form that is typical of plants in the family Araceae. The plant spreads by rhizomes, and there are also small bulblets (also known as bulbils) at the base of each leaf. Flowers are borne in spring. This plant is toxic in raw form and must be processed."}}, {"canonical_name": "Glasgow", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "glasgow", "book_id": "origin_of_species_darwin_1859", "name": "Glasgow", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Glasgow"], "contexts": ["location of house-tumblers"]}, {"entity_id": "glasgow", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Glasgow", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Glasgow"], "contexts": ["city where William Thomson worked", "city associated with Thompson"]}, {"entity_id": "glasgow", "book_id": "first_principles_spencer_1862", "name": "Glasgow", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Glasgow"], "contexts": ["city with advantage in iron ship building"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Glasgow", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Glasgow", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Glasgow", "target_book": "first_principles_spencer_1862", "target_name": "Glasgow", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Glasgow", "target_book": "first_principles_spencer_1862", "target_name": "Glasgow", "similarity": 1.0}], "id": 1745, "stable_key": "clu_409e485174daf5e3", "ground_truth": {"modern_name": "Glasgow", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q4093", "wikidata_description": "city in Scotland, United Kingdom"}}, {"canonical_name": "British Museum", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "british_museum", "book_id": "origin_of_species_darwin_1859", "name": "British Museum", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["British Museum"], "contexts": ["institution where F. Smith worked"]}, {"entity_id": "british_museum", "book_id": "kosmos_humboldt_1845", "name": "British Museum", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["British Museum"], "contexts": ["museum in London", "preserves skeleton slab"]}, {"entity_id": "british_museum", "book_id": "first_principles_spencer_1862", "name": "British Museum", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["British Museum"], "contexts": ["museum with Egyptian art collection"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "British Museum", "target_book": "kosmos_humboldt_1845", "target_name": "British Museum", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "British Museum", "target_book": "first_principles_spencer_1862", "target_name": "British Museum", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "British Museum", "target_book": "first_principles_spencer_1862", "target_name": "British Museum", "similarity": 1.0}], "id": 1746, "stable_key": "clu_133eb1927fb8bc79", "ground_truth": {"modern_name": "The British Museum", "confidence": "high", "type": "place", "country": "United Kingdom"}}, {"canonical_name": "distinction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "specific_distinction", "book_id": "origin_of_species_darwin_1859", "name": "specific distinction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["specific distinction"], "contexts": ["criteria for separating species"]}, {"entity_id": "distinctions", "book_id": "principles_of_psychology_james_1890", "name": "distinctions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["distinctions"], "contexts": ["philosophical concept of differences"]}, {"entity_id": "distinction", "book_id": "principles_of_psychology_james_1890", "name": "distinction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["distinction"], "contexts": ["recognizing differences between things"]}, {"entity_id": "distinction", "book_id": "first_principles_spencer_1862", "name": "distinction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["distinction"], "contexts": ["recognizing differences between things", "identifying differences between mental states"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "specific distinction", "target_book": "principles_of_psychology_james_1890", "target_name": "distinction", "similarity": 0.91}, {"source_book": "origin_of_species_darwin_1859", "source_name": "specific distinction", "target_book": "first_principles_spencer_1862", "target_name": "distinction", "similarity": 0.91}, {"source_book": "principles_of_psychology_james_1890", "source_name": "distinctions", "target_book": "first_principles_spencer_1862", "target_name": "distinction", "similarity": 0.939}, {"source_book": "principles_of_psychology_james_1890", "source_name": "distinction", "target_book": "first_principles_spencer_1862", "target_name": "distinction", "similarity": 1.0}], "id": 1747, "stable_key": "clu_4ed0f874f7148347", "ground_truth": {"modern_name": "Distinction", "confidence": "high", "type": "concept", "wikidata_id": "Q65770711", "wikidata_description": "distinction between concepts that is observed in some contexts, but in others the concepts are conflated"}}, {"canonical_name": "Bohemia", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "bohemia", "book_id": "origin_of_species_darwin_1859", "name": "Bohemia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Bohemia"], "contexts": ["region with Silurian deposits"]}, {"entity_id": "bohemia", "book_id": "kosmos_humboldt_1845", "name": "Bohemia", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Bohemia"], "contexts": ["historical region in Central Europe", "region of Joachimsthal mine"]}, {"entity_id": "bohemia", "book_id": "polyanthea_medicinal", "name": "Bohemia", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Bohemia"], "contexts": ["Rey de Bohemia"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Bohemia", "target_book": "kosmos_humboldt_1845", "target_name": "Bohemia", "similarity": 0.926}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Bohemia", "target_book": "polyanthea_medicinal", "target_name": "Bohemia", "similarity": 0.926}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bohemia", "target_book": "polyanthea_medicinal", "target_name": "Bohemia", "similarity": 1.0}], "id": 1748, "stable_key": "clu_e82969ab736fdb4f", "ground_truth": {"modern_name": "Bohemia", "confidence": "high", "type": "place", "country": "Czech Republic", "wikidata_id": "Q39193", "wikidata_description": "historical region in the Czech Republic", "wikipedia_url": "https://en.wikipedia.org/wiki/Bohemia", "wikipedia_extract": "Bohemia ( boh-HEE-mee-\u0259; Czech: \u010cechy [\u02c8t\u0283\u025bx\u026a] ; German: B\u00f6hmen [\u02c8b\u00f8\u02d0m\u0259n] ) is the westernmost and largest historical region of the Czech Republic. Bohemia can also refer to a wider area consisting of the historical Lands of the Bohemian Crown ruled by the Bohemian kings, including Moravia and Czech Silesia, in which case the smaller region is referred to as Bohemia proper as a means of distinction. Bohemians principality became a part of Great Moravia, and then an independent Duchy of Bohemia, which became a kingdom in the Holy Roman Empire. This subsequently became a part of the Habsburg monarchy and the Austrian Empire. After World War I and the establishment of an independent Czechoslovak state, the whole of Bohemia became a part of Czechoslovakia, defying claims of the German-speaking inhabitants that regions with German-speaking majority should be included in the Republic of German-Austria. Between 1938 and 1945, these border regions were annexed to Nazi Germany as the Sudetenland."}}, {"canonical_name": "africaine", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "african_mainland", "book_id": "origin_of_species_darwin_1859", "name": "African mainland", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["African mainland"], "contexts": ["source of plants and animals for African islands"]}, {"entity_id": "africaine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "africaine", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["africaine"], "contexts": ["African race", "African colony"]}, {"entity_id": "afri", "book_id": "coloquios_da_orta_1563", "name": "Afri", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Afri"], "contexts": ["mentioned in a collection of voyages"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "African mainland", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "africaine", "similarity": 0.901}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "africaine", "target_book": "coloquios_da_orta_1563", "target_name": "Afri", "similarity": 0.961}], "id": 1749, "stable_key": "clu_abc95a0d76c3bec8-2", "ground_truth": {"modern_name": "Africa", "confidence": "high", "type": "place", "country": "Multiple", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Africa", "wikipedia_extract": "Africa is the world's second-largest and second-most populous continent after Asia. At about 30.3 million km2 (11.7 million square miles) including adjacent islands, it covers around 20% of Earth's land area and 6% of its total surface area. With nearly 1.4 billion people as of 2021, it accounts for about 18% of the world's human population. Africa's population is the youngest among all the continents; the median age in 2012 was 19.7, when the worldwide median age was 30.4. Based on 2024 projections, Africa's population will exceed 3.8 billion people by 2100. Africa is the least wealthy inhabited continent per capita and second-least wealthy by total wealth, ahead of Oceania.", "description": "Continent, its regions, islands, and people.", "note": "Refers to the continent of Africa and its associated regions and people."}}, {"canonical_name": "mental forces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "mental_power", "book_id": "origin_of_species_darwin_1859", "name": "mental power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mental power"], "contexts": ["cognitive abilities"]}, {"entity_id": "mental_powers", "book_id": "principles_of_psychology_james_1890", "name": "mental powers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mental powers"], "contexts": ["intellectual capabilities of the mind"]}, {"entity_id": "mental_forces", "book_id": "first_principles_spencer_1862", "name": "mental forces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["mental forces"], "contexts": ["powers of the mind", "forces related to the mind"]}, {"entity_id": "mental_power", "book_id": "first_principles_spencer_1862", "name": "mental power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mental power"], "contexts": ["intellectual and cognitive ability"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "mental power", "target_book": "principles_of_psychology_james_1890", "target_name": "mental powers", "similarity": 0.951}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mental power", "target_book": "first_principles_spencer_1862", "target_name": "mental forces", "similarity": 0.883}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mental power", "target_book": "first_principles_spencer_1862", "target_name": "mental power", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "mental powers", "target_book": "first_principles_spencer_1862", "target_name": "mental power", "similarity": 0.951}], "id": 1750, "stable_key": "clu_b93ab2022232e785-2", "ground_truth": {"modern_name": "Mental Faculties", "confidence": "high", "type": "concept", "note": "Refers to the innate powers or capacities of the mind, a significant concept in psychology and philosophy of mind."}}, {"canonical_name": "causa fria", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "causa_fria", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "causa fria", "category": "CONCEPT", "subcategory": "QUALITY", "count": 3, "variants": ["causa fria"], "contexts": ["cold cause of ailments", "pains born of a cold cause"]}, {"entity_id": "causa_fria", "book_id": "coloquios_da_orta_1563", "name": "causa fria", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["causa fria"], "contexts": ["cold cause of headache"]}, {"entity_id": "causa_fria", "book_id": "polyanthea_medicinal", "name": "causa fria", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["causa fria"], "contexts": ["condition for using baths"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "causa fria", "target_book": "coloquios_da_orta_1563", "target_name": "causa fria", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "causa fria", "target_book": "polyanthea_medicinal", "target_name": "causa fria", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "causa fria", "target_book": "polyanthea_medicinal", "target_name": "causa fria", "similarity": 1.0}], "id": 1751, "stable_key": "clu_6dc95379fb298543", "ground_truth": {"modern_name": "coldness", "confidence": "high", "type": "CONCEPT", "description": "A bodily quality or state associated with low temperature or lack of heat.", "note": "Refers to the humoral concept of coldness affecting the body.", "wikipedia_extract": "In statistical thermodynamics, thermodynamic beta, also known as coldness, is the reciprocal of the thermodynamic temperature of a system: {\\displaystyle \\beta \\equiv {\\frac {1}{k_{\\rm {B}}T}}} (where T is the temperature and kB is Boltzmann constant). Thermodynamic beta has units reciprocal to that of energy (in SI units, reciprocal joules, {\\displaystyle [\\beta ]={\\textrm {J}}^{-1}} ). In non-thermal units, it can also be measured in byte per joule, or more conveniently, gigabyte per nanojoule; 1 K\u22121 is equivalent to about 13,062 gigabytes per nanojoule; at room temperature: T = 300K, \u03b2 \u2248 44 GB/nJ \u2248 39 eV\u22121 \u2248 2.4\u00d71020 J\u22121. The conversion factor is 1 GB/nJ = Thermodynamic beta is essentially the connection between the information theory and statistical mechanics interpretation of a physical system through its entropy and the thermodynamics associated with its energy. It expresses the response of entropy to an increase in energy. If a small amount of energy is added to the system, then \u03b2 describes the amount the system will randomize.", "wikidata_id": "Q270952", "wikidata_description": "relative or subjective state of low temperature"}}, {"canonical_name": "melones", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "melones", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "melones", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["melones"], "contexts": ["melons for comparison", "fruit whose seeds resemble plant's seeds"]}, {"entity_id": "melons", "book_id": "relation_historique_humboldt_vol3_1825", "name": "melons", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["melons"], "contexts": ["fruit mentioned in relation to dryness"]}, {"entity_id": "melones_de_agua", "book_id": "coloquios_da_orta_1563", "name": "melones de agua", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["melones de agua"], "contexts": ["Roman name for large melons"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "melones", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "melons", "similarity": 0.996}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "melones", "target_book": "coloquios_da_orta_1563", "target_name": "melones de agua", "similarity": 0.886}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "melons", "target_book": "coloquios_da_orta_1563", "target_name": "melones de agua", "similarity": 0.885}], "id": 1752, "stable_key": "clu_6a6e11a60e1f83a5", "ground_truth": {"modern_name": "Melons", "confidence": "high", "type": "plant", "family": "Cucurbitaceae", "note": "The term 'melons' is broad and can encompass many species within the Cucurbitaceae family, such as cantaloupe, honeydew, and watermelon (melones de agua).", "wikidata_id": "Q81602", "wikidata_description": "species of plant"}}, {"canonical_name": "cuchillos", "category": "OBJECT", "subcategory": "TOOL", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "cuchillos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "cuchillos", "category": "OBJECT", "subcategory": "TOOL", "count": 3, "variants": ["cuchillos"], "contexts": ["object, knives", "sharp implements used as weapons"]}, {"entity_id": "martellos", "book_id": "coloquios_da_orta_1563", "name": "martellos", "category": "OBJECT", "subcategory": "TOOL", "count": 1, "variants": ["martellos"], "contexts": ["hammers"]}, {"entity_id": "martello", "book_id": "ricettario_fiorentino_1597", "name": "martello", "category": "OBJECT", "subcategory": "TOOL", "count": 1, "variants": ["martello"], "contexts": ["hammer used for crushing nuts"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cuchillos", "target_book": "coloquios_da_orta_1563", "target_name": "martellos", "similarity": 0.908}, {"source_book": "coloquios_da_orta_1563", "source_name": "martellos", "target_book": "ricettario_fiorentino_1597", "target_name": "martello", "similarity": 0.951}], "id": 1753, "stable_key": "clu_e14f32ece37761b1", "ground_truth": {"modern_name": "hammer", "confidence": "high", "type": "object"}}, {"canonical_name": "olmo", "category": "PLANT", "subcategory": "TREE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "olmo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "olmo", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["olmo"], "contexts": ["elm tree, comparison for achiotl leaves", "tree whose leaves are similar to the plant's leaves"]}, {"entity_id": "olmo", "book_id": "historia_medicinal_monardes_1574", "name": "Olmo", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Olmo"], "contexts": ["tree compared in size and leaf"]}, {"entity_id": "olmo", "book_id": "polyanthea_medicinal", "name": "Olmo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Olmo"], "contexts": ["elm", "elm tree"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "olmo", "target_book": "historia_medicinal_monardes_1574", "target_name": "Olmo", "similarity": 0.983}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "olmo", "target_book": "polyanthea_medicinal", "target_name": "Olmo", "similarity": 0.886}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Olmo", "target_book": "polyanthea_medicinal", "target_name": "Olmo", "similarity": 0.891}], "id": 1754, "stable_key": "clu_3bbb46fc159e1fc2", "ground_truth": {"modern_name": "Elm", "confidence": "high", "type": "plant", "linnaean": "Ulmus L.", "family": "Ulmaceae", "note": "Linnaean binomial is for the genus, specific species not identifiable from context.", "wikidata_id": "Q131113", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Elm", "wikipedia_extract": "Elms are deciduous and semi-deciduous trees comprising the genus Ulmus in the family Ulmaceae. They are distributed over most of the Northern Hemisphere, inhabiting the temperate and tropical-montane regions of North America and Eurasia, ranging southward in Western Asia to Iran, in Africa to Libya, and in Southeast Asia into Indonesia. Elms are components of many kinds of natural forests. Moreover, during the 19th and early 20th centuries, many species and cultivars were also planted as ornamental street, garden, and park trees in Europe, North America, and parts of the Southern Hemisphere, notably Australasia. Some individual elms reached great size and age. However, in recent decades, most mature elms of European or North American origin have died from Dutch elm disease, caused by a microfungus dispersed by bark beetles."}}, {"canonical_name": "templada", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "templada", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "templada", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["templada"], "contexts": ["nature cold or somewhat temperate", "temperate quality of food"]}, {"entity_id": "templada", "book_id": "relation_historique_humboldt_vol3_1825", "name": "templada", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["templada"], "contexts": ["temperate land in New Granada"]}, {"entity_id": "templada", "book_id": "historia_medicinal_monardes_1574", "name": "templada", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["templada", "templar"], "contexts": ["considered temperate", "effect of Azogue"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "templada", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "templada", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "templada", "target_book": "historia_medicinal_monardes_1574", "target_name": "templada", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "templada", "target_book": "historia_medicinal_monardes_1574", "target_name": "templada", "similarity": 1.0}], "id": 1755, "stable_key": "clu_ce45c6d3c7187773-2", "ground_truth": {"modern_name": "Temperate", "confidence": "high", "type": "concept", "note": "Refers to a moderate climate or quality, distinct from extreme heat or cold.", "wikidata_id": "Q167466", "wikidata_description": "main climate class", "wikipedia_url": "https://en.wikipedia.org/wiki/Temperate%20climate", "wikipedia_extract": "In geography, the temperate climates of Earth occur in the middle latitudes (approximately 23.5\u00b0 to 66.5\u00b0 N/S of the Equator), which span between the tropics and the polar regions of Earth. These zones generally have wider temperature ranges throughout the year and more distinct seasonal changes compared to tropical climates, where such variations are often small; they usually differ only in the amount of precipitation. In temperate climates, not only do latitudinal positions influence temperature changes, but various sea currents, prevailing wind direction, continentality (how large a landmass is) and altitude also shape temperate climates. The K\u00f6ppen climate classification defines a climate as \"temperate\" C, when the mean temperature is above \u22123 \u00b0C (26.6 \u00b0F) but below 18 \u00b0C (64.4 \u00b0F) in the coldest month to account for the persistence of frost. However, some adaptations of K\u00f6ppen set the minimum at 0 \u00b0C (32.0 \u00b0F). Continental climates are classified as D and considered to be varieties of temperate climates, having more extreme temperatures, with mean temperatures in the coldest month usually being below \u22123 \u00b0C (26.6 \u00b0F)."}}, {"canonical_name": "dolor del espaldas", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "dolores_de_costado", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "dolores de costado", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["dolores de costado"], "contexts": ["side pains"]}, {"entity_id": "dolor_del_espaldas", "book_id": "historia_medicinal_monardes_1574", "name": "dolor del espaldas", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 3, "variants": ["dolor del espaldas", "dolon de costado", "dolores de costado"], "contexts": ["pain in the back", "side pains"]}, {"entity_id": "pains_in_the_back", "book_id": "first_principles_spencer_1862", "name": "pains in the back", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["pains in the back"], "contexts": ["discomfort in the dorsal region"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "dolores de costado", "target_book": "historia_medicinal_monardes_1574", "target_name": "dolor del espaldas", "similarity": 0.89}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "dolor del espaldas", "target_book": "first_principles_spencer_1862", "target_name": "pains in the back", "similarity": 0.926}], "id": 1756, "stable_key": "clu_68a715158290ad54", "ground_truth": {"modern_name": "Back pain", "confidence": "high", "type": "disease", "modern_term": "Back pain", "wikidata_id": "Q5781808", "wikidata_description": "type of pain felt in the back"}}, {"canonical_name": "males", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "males", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "males", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["males"], "contexts": ["ills"]}, {"entity_id": "males", "book_id": "historia_medicinal_monardes_1574", "name": "males", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["males"], "contexts": ["illnesses", "serious illnesses"]}, {"entity_id": "males", "book_id": "polyanthea_medicinal", "name": "males", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["males"], "contexts": ["human ailments discussed in the book"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "males", "target_book": "historia_medicinal_monardes_1574", "target_name": "males", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "males", "target_book": "polyanthea_medicinal", "target_name": "males", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "males", "target_book": "polyanthea_medicinal", "target_name": "males", "similarity": 1.0}], "id": 1757, "stable_key": "clu_66e9b8104ca0ed8c-2", "ground_truth": {"modern_name": "Illness", "confidence": "high", "type": "disease", "modern_term": "Illness", "wikidata_id": "Q3052614", "wikidata_description": "specific phobia that involves an irrational fear of contracting a disease", "note": "While 'enfermidade' can also mean sickness or infirmity, in the context of early modern medical texts, it broadly refers to a state of ill health or disease. 'Illness' is a suitable modern equivalent covering this range."}}, {"canonical_name": "veronica", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "ver\u00f3nica", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "ver\u00f3nica", "category": "PLANT", "subcategory": "HERB", "count": 1, "variants": ["ver\u00f3nica"], "contexts": ["herb with small, round leaves"]}, {"entity_id": "veronica", "book_id": "polyanthea_medicinal", "name": "veronica", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Veronica", "veronica"], "contexts": ["common name for Abrotanum femina", "alternative name for abrotea"]}, {"entity_id": "veronica", "book_id": "connexion_physical_sciences_somerville_1858", "name": "veronica", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["veronica"], "contexts": ["flower found in Himalaya", "flower not found in Himalaya"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ver\u00f3nica", "target_book": "polyanthea_medicinal", "target_name": "veronica", "similarity": 0.724}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ver\u00f3nica", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "veronica", "similarity": 0.724}, {"source_book": "polyanthea_medicinal", "source_name": "veronica", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "veronica", "similarity": 1.0}], "id": 1758, "stable_key": "clu_ddbbb5d231e8daa1", "ground_truth": {"modern_name": "germander", "confidence": "high", "type": "plant", "linnaean": "Teucrium chamaedrys", "family": "Lamiaceae", "note": "In early modern European texts, 'veronica' often referred to Speedwell (Veronica officinalis). However, in the context of 'Abrotanum femina', it is more likely referring to Germander, specifically Teucrium species, which were sometimes confused or grouped with 'Abrotanum'.", "wikidata_id": "Q157714", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Teucrium", "wikipedia_extract": "Teucrium is a cosmopolitan genus of flowering plants in the mint family Lamiaceae, commonly known as germanders. Plants in this genus are perennial herbs or shrubs, with branches that are more or less square in cross-section, leaves arranged in opposite pairs, and flowers arranged in thyrses, the corolla with mostly white to cream-coloured, lobed petals. Plants in the genus Teucrium are perennial herbs or shrubs with four-cornered stems, often with simple hairs and sessile glands. The leaves are arranged in opposite pairs, simple or with three leaflets sometimes with lobed or serrated edges. The flowers are arranged in a thyrse, sometimes in a cyme in leaf axils. The flowers have five more or less similar sepals fused at the base, and the corolla is white or cream-coloured with five lobes forming two lips."}}, {"canonical_name": "Pinam", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "pi\u00f1a", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "pi\u00f1a", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["pi\u00f1a"], "contexts": ["fruit, likely pineapple"]}, {"entity_id": "pina", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Pina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Pina"], "contexts": ["Spanish name for the pineapple"]}, {"entity_id": "pinam", "book_id": "coloquios_da_orta_1563", "name": "Pinam", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Pinam", "pinam"], "contexts": ["Malaca name for areca", "Malay name for Areca catechu seed"]}, {"entity_id": "\u017fpina", "book_id": "polyanthea_medicinal", "name": "\u017fpina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["\u017fpina"], "contexts": ["spinach"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "pi\u00f1a", "target_book": "polyanthea_medicinal", "target_name": "\u017fpina", "similarity": 0.85}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Pina", "target_book": "coloquios_da_orta_1563", "target_name": "Pinam", "similarity": 0.927}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Pina", "target_book": "polyanthea_medicinal", "target_name": "\u017fpina", "similarity": 0.876}], "id": 1759, "stable_key": "clu_be1fa0ab47db63ae", "ground_truth": {"modern_name": "Pineapple", "confidence": "medium", "type": "plant", "linnaean": "Ananas comosus", "family": "Bromeliaceae", "note": "The cluster refers to 'pi\u00f1a' (Spanish for pineapple) and 'pinam' (Malaca name for areca). Given the context of early modern exploration and trade, 'pi\u00f1a' is the more likely dominant referent, but 'areca' is also a possibility.", "wikidata_id": "Q1493", "wikidata_description": "tile bearing bromeliad", "wikipedia_url": "https://en.wikipedia.org/wiki/Pineapple"}}, {"canonical_name": "ananas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "ananas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Ananas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Ananas"], "contexts": ["name in the East Indies"]}, {"entity_id": "ananas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "ananas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["ananas", "Ananas communs"], "contexts": ["food plants", "common pineapple plant"]}, {"entity_id": "anana", "book_id": "coloquios_da_orta_1563", "name": "anana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["anana", "ananaz"], "contexts": ["king of fruits", "pineapple"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Ananas", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "ananas", "similarity": 0.858}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "ananas", "target_book": "coloquios_da_orta_1563", "target_name": "anana", "similarity": 0.889}], "id": 1760, "stable_key": "clu_415e5885f71628a9", "ground_truth": {"modern_name": "Pineapple", "confidence": "high", "type": "plant", "linnaean": "Ananas comosus", "family": "Bromeliaceae", "wikidata_id": "Q1493", "wikidata_description": "tile bearing bromeliad", "wikipedia_url": "https://en.wikipedia.org/wiki/Pineapple", "wikipedia_extract": "The pineapple (Ananas comosus) is a tropical plant with an edible fruit; it is the most economically significant plant in the family Bromeliaceae. The pineapple is indigenous to South America, where it has been cultivated for many centuries. The introduction of the pineapple plant to Europe in the 17th century made it a significant cultural icon of luxury. Since the 1820s, pineapple has been commercially grown in greenhouses and many tropical plantations. The fruit, particularly its juice, has diverse uses in cuisines and desserts. Pineapples grow as a small shrub; the individual flowers of the unpollinated plant fuse to form a multiple fruit."}}, {"canonical_name": "azedo", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "acedo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "acedo", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["acedo"], "contexts": ["sour taste of the fruit"]}, {"entity_id": "azedo", "book_id": "coloquios_da_orta_1563", "name": "azedo", "category": "CONCEPT", "subcategory": "QUALITY", "count": 3, "variants": ["azedo"], "contexts": ["sour flavor", "Taste quality"]}, {"entity_id": "acrid", "book_id": "polyanthea_medicinal", "name": "acrid", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["acrid"], "contexts": ["quality of blood"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "acedo", "target_book": "coloquios_da_orta_1563", "target_name": "azedo", "similarity": 0.922}, {"source_book": "coloquios_da_orta_1563", "source_name": "azedo", "target_book": "polyanthea_medicinal", "target_name": "acrid", "similarity": 0.889}], "id": 1761, "stable_key": "clu_2829259268b8c3dd", "ground_truth": {"modern_name": "sour", "confidence": "high", "type": "concept", "description": "Having a sharp, acidic taste or quality.", "note": "Refers to a taste quality.", "wikipedia_extract": "Sourness, also known as sour, is a basic taste sensation perceived through hydrogen ions from acidic compounds interacting with taste bud receptors, and it can also refer to an unpleasant or acidic quality in taste, disposition, or tone. It is a warning sign for potentially spoiled food, though it is balanced in some food products by sweetness, and it is associated with a low pH. The most common foods with natural sourness are fruits, such as lemon, lime, grape, orange, tamarind, and bitter melon. Fermented foods, such as wine, sour cream, vinegar or yogurt, may have sour taste. Children show a greater enjoyment of sour flavors than adults, and sour candy containing citric acid or malic acid is common."}}, {"canonical_name": "J\u00e9suites", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "jesuita", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "jesuita", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["jesuita"], "contexts": ["member of the Society of Jesus"]}, {"entity_id": "j\u00e9suites", "book_id": "relation_historique_humboldt_vol3_1825", "name": "J\u00e9suites", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["J\u00e9suites"], "contexts": ["religious order", "religious order at convent"]}, {"entity_id": "jesu\u00edtas", "book_id": "coloquios_da_orta_1563", "name": "jesu\u00edtas", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["jesu\u00edtas"], "contexts": ["religious order"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "jesuita", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "J\u00e9suites", "similarity": 0.884}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "jesuita", "target_book": "coloquios_da_orta_1563", "target_name": "jesu\u00edtas", "similarity": 0.905}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "J\u00e9suites", "target_book": "coloquios_da_orta_1563", "target_name": "jesu\u00edtas", "similarity": 0.919}], "id": 1762, "stable_key": "clu_4a5efb62d0595df4", "ground_truth": {"modern_name": "Jesuits", "confidence": "high", "type": "person", "description": "Members of the Society of Jesus, a Catholic religious order", "wikidata_id": "Q10351458", "wikidata_description": "historic bridge in the city of Rio de Janeiro, Brazil"}}, {"canonical_name": "Haut-Canada", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "haut-canada", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Haut-Canada", "category": "P