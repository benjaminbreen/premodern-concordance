, "year of comet appearance"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "1843", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "1843", "similarity": 1.0}], "id": 4353, "stable_key": "clu_268ee7f650591653", "ground_truth": {"modern_name": "1843", "confidence": "high", "type": "concept", "wikidata_id": "Q19241469", "wikidata_description": "natural number"}}, {"canonical_name": "vasos limphaticos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "vaisseaux_h\u00e9patiques", "book_id": "medecine_experimentale_bernard_1865", "name": "vaisseaux h\u00e9patiques", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["vaisseaux h\u00e9patiques"], "contexts": ["vessels within the liver"]}, {"entity_id": "vasos_limphaticos", "book_id": "polyanthea_medicinal", "name": "vasos limphaticos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["vasos limphaticos"], "contexts": ["body vessels involved in disease", "lymphatic vessels"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "vaisseaux h\u00e9patiques", "target_book": "polyanthea_medicinal", "target_name": "vasos limphaticos", "similarity": 0.887}], "id": 4354, "stable_key": "clu_89ec61f36841c482", "ground_truth": {"modern_name": "Hepatic vessels", "confidence": "high", "type": "anatomy"}}, {"canonical_name": "Alquimistas", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "alchimistes", "book_id": "medecine_experimentale_bernard_1865", "name": "alchimistes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["alchimistes"], "contexts": ["historical practitioners of alchemy"]}, {"entity_id": "alquimistas", "book_id": "historia_medicinal_monardes_1574", "name": "Alquimistas", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["alquimistas", "Alquimistas"], "contexts": ["alchemists who speak of gold's matter", "practitioners of alchemy"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "alchimistes", "target_book": "historia_medicinal_monardes_1574", "target_name": "Alquimistas", "similarity": 0.986}], "id": 4355, "stable_key": "clu_740d6d6da4624d15", "ground_truth": {"modern_name": "Alchemists", "confidence": "high", "type": "person", "description": "Practitioners of alchemy and transmutational arts.", "note": "The cluster refers to the practitioners of alchemy, a prominent practice in the early modern period, rather than specific individuals.", "wikidata_id": "Q947275", "wikidata_description": "computer puzzle game from PopCap Games", "wikipedia_url": "https://en.wikipedia.org/wiki/Alchemy", "wikipedia_extract": "Alchemy (from the Arabic word al-k\u012bm\u012b\u0101, \u0627\u0644\u0643\u06cc\u0645\u06cc\u0627\u0621) is an ancient branch of natural philosophy, a philosophical and protoscientific tradition that was historically practised in China, India, the Muslim world, and Europe. In its Western form, alchemy is first attested in a number of pseudepigraphical texts written in Greco-Roman Egypt during the first few centuries AD. Greek-speaking alchemists often referred to their craft as \"the Art\" (\u03c4\u03ad\u03c7\u03bd\u03b7) or \"Knowledge\" (\u1f10\u03c0\u03b9\u03c3\u03c4\u03ae\u03bc\u03b7), and it was often characterised as mystic (\u03bc\u03c5\u03c3\u03c4\u03b9\u03ba\u03ae), sacred (\u1f31\u025b\u03c1\u03ac), or divine (\u03b8\u025b\u00ed\u03b1). Alchemists attempted to purify, mature, and perfect certain materials. Common aims were chrysopoeia, the transmutation of \"base metals\" (e.g., lead) into \"noble metals\" (particularly gold); the creation of an elixir of immortality; and the creation of panaceas able to cure any disease. The perfection of the human body and soul was thought to result from the alchemical magnum opus (\"Great Work\")."}}, {"canonical_name": "Benevolence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "benevolence", "book_id": "principles_of_psychology_james_1890", "name": "Benevolence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["benevolence", "Benevolence"], "contexts": ["a phrenological faculty", "social affection arising from transferred pleasure"]}, {"entity_id": "charitable", "book_id": "first_principles_spencer_1862", "name": "charitable", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["charitable"], "contexts": ["type of society with roughly sketched ends"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Benevolence", "target_book": "first_principles_spencer_1862", "target_name": "charitable", "similarity": 0.902}], "id": 4356, "stable_key": "clu_f60cf6df5ad8bf8c", "ground_truth": {"modern_name": "benevolence", "confidence": "high", "type": "concept", "note": "In the context of phrenology, 'benevolence' refers to a specific faculty of the brain.", "wikidata_id": "Q16509717", "wikidata_description": "good disposition to others"}}, {"canonical_name": "health", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "health", "book_id": "medecine_experimentale_bernard_1865", "name": "health", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["health"], "contexts": ["state of well-being"]}, {"entity_id": "health", "book_id": "principles_of_psychology_james_1890", "name": "health", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["health"], "contexts": ["state of being free from illness", "state of well-being"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "health", "target_book": "principles_of_psychology_james_1890", "target_name": "health", "similarity": 1.0}], "id": 4357, "stable_key": "clu_f9be01a7b86dc130-2", "ground_truth": {"modern_name": "Health", "confidence": "high", "type": "concept", "note": "The terms 'salud', 'sa\u00fade', and 'health' in the provided contexts clearly refer to the state of well-being and absence of disease.", "wikidata_id": "Q189603", "wikidata_description": "science and art of preventing disease, prolonging life and promoting health through organized efforts and informed choices of society, organizations, public and private, communities and individuals", "wikipedia_url": "https://en.wikipedia.org/wiki/Public%20health", "wikipedia_extract": "Public health is \"the science and art of preventing disease, prolonging life and promoting health through the organized efforts and informed choices of society, organizations, public and private, communities and individuals\". Analyzing the determinants of health of a population and the threats it faces is the basis for public health. The public can be as small as a handful of people or as large as a village or an entire city; in the case of a pandemic it may encompass several continents. The concept of health takes into account physical, psychological, and social well-being, among other factors. Public health is an interdisciplinary field. For example, epidemiology, biostatistics, social sciences and management of health services are all relevant."}}, {"canonical_name": "affinity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "affinity", "book_id": "medecine_experimentale_bernard_1865", "name": "affinity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["affinity"], "contexts": ["chemical concept of attraction"]}, {"entity_id": "affinity", "book_id": "principles_of_psychology_james_1890", "name": "affinity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["affinity"], "contexts": ["likeness or similarity", "felt connection or attraction"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "affinity", "target_book": "principles_of_psychology_james_1890", "target_name": "affinity", "similarity": 1.0}], "id": 4358, "stable_key": "clu_90524b26a7e712ae-2", "ground_truth": {"modern_name": "affinity", "confidence": "high", "type": "concept", "wikidata_id": "Q382497", "wikidata_description": "automorphism of an affine space", "wikipedia_url": "https://en.wikipedia.org/wiki/Affine%20transformation", "wikipedia_extract": "In Euclidean geometry, an affine transformation or affinity (from the Latin, affinis, \"connected with\") is a geometric transformation that preserves lines and parallelism, but not necessarily Euclidean distances and angles. More generally, an affine transformation is an automorphism of an affine space (Euclidean spaces are specific affine spaces), that is, a function which maps an affine space onto itself while preserving both the dimension of any affine subspaces (meaning that it sends points to points, lines to lines, planes to planes, and so on) and the ratios of the lengths of parallel line segments. Consequently, sets of parallel affine subspaces remain parallel after an affine transformation. An affine transformation does not necessarily preserve angles between lines or distances between points, though it does preserve ratios of distances between points lying on a straight line. If X is the point set of an affine space, then every affine transformation on X can be represented as the composition of a linear transformation on X and a translation of X. Unlike a purely linear transformation, an affine transformation need not preserve the origin of the affine space."}}, {"canonical_name": "combinations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "combinaison", "book_id": "medecine_experimentale_bernard_1865", "name": "combinaison", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["combinaison"], "contexts": ["process of substances joining together"]}, {"entity_id": "combinations", "book_id": "principles_of_psychology_james_1890", "name": "combinations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["combinations"], "contexts": ["ways elements are joined together", "linking of ideas or elements"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "combinaison", "target_book": "principles_of_psychology_james_1890", "target_name": "combinations", "similarity": 0.93}], "id": 4359, "stable_key": "clu_4f8736eb9fd6d35c", "ground_truth": {"modern_name": "Combinations", "confidence": "high", "type": "concept", "wikidata_id": "Q273499", "wikidata_description": "technique in chemistry"}}, {"canonical_name": "experimental knowledge", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "connaissance_exp\u00e9rimentale", "book_id": "medecine_experimentale_bernard_1865", "name": "connaissance exp\u00e9rimentale", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["connaissance exp\u00e9rimentale"], "contexts": ["experimental knowledge"]}, {"entity_id": "experimental_knowledge", "book_id": "kosmos_humboldt_1845", "name": "experimental knowledge", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["experimental knowledge"], "contexts": ["results obtained from experiments", "knowledge gained through experimentation"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "connaissance exp\u00e9rimentale", "target_book": "kosmos_humboldt_1845", "target_name": "experimental knowledge", "similarity": 0.932}], "id": 4360, "stable_key": "clu_27255c73d8b7efa9", "ground_truth": {"modern_name": "Experimental knowledge", "confidence": "high", "type": "concept"}}, {"canonical_name": "Astruc", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "astruc", "book_id": "medecine_experimentale_bernard_1865", "name": "Astruc", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["Astruc"], "contexts": ["physician and writer on venereal diseases"]}, {"entity_id": "astruc", "book_id": "coloquios_da_orta_1563", "name": "Astruc", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Astruc"], "contexts": ["erudite physician", "learned physician"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Astruc", "target_book": "coloquios_da_orta_1563", "target_name": "Astruc", "similarity": 0.54}], "id": 4361, "stable_key": "clu_48311f1e77c50059", "ground_truth": {"modern_name": "Gabriel Astruc", "confidence": "high", "type": "person", "birth_year": 1684, "death_year": 1767, "description": "French physician, writer on venereal diseases"}}, {"canonical_name": "doen\u00e7as de nervos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pathologie_du_syst\u00e8me_nerveux", "book_id": "medecine_experimentale_bernard_1865", "name": "pathologie du syst\u00e8me nerveux", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["pathologie du syst\u00e8me nerveux"], "contexts": ["diseases of the nervous system"]}, {"entity_id": "doen\u00e7as_de_nervos", "book_id": "polyanthea_medicinal", "name": "doen\u00e7as de nervos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["doen\u00e7as de nervos"], "contexts": ["ailments affecting the nervous system", "diseases affecting nerves"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "pathologie du syst\u00e8me nerveux", "target_book": "polyanthea_medicinal", "target_name": "doen\u00e7as de nervos", "similarity": 0.907}], "id": 4362, "stable_key": "clu_1730aeb41e45e578", "ground_truth": {"modern_name": "Diseases of the nervous system", "confidence": "high", "type": "disease", "modern_term": "Nervous system disorders", "wikidata_id": "Q34738395", "wikidata_description": "scientific article"}}, {"canonical_name": "Ann. de Chimie et de Physique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ann__de_chimie_et_de_physique", "book_id": "medecine_experimentale_bernard_1865", "name": "Ann. de chimie et de physique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Ann. de chimie et de physique"], "contexts": ["French scientific journal"]}, {"entity_id": "ann__de_chimie_et_de_physique", "book_id": "kosmos_humboldt_1845", "name": "Ann. de Chimie et de Physique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Ann. de Chimie et de Physique"], "contexts": ["journal publishing Boussingault's memoir", "chemistry and physics journal"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Ann. de chimie et de physique", "target_book": "kosmos_humboldt_1845", "target_name": "Ann. de Chimie et de Physique", "similarity": 0.949}], "id": 4363, "stable_key": "clu_d085880f2876975b", "ground_truth": {"modern_name": "Annales de Chimie et de Physique", "confidence": "high", "type": "text", "wikidata_id": "Q564386", "wikidata_description": "scientific journal", "wikipedia_url": "https://en.wikipedia.org/wiki/Annales%20de%20chimie%20et%20de%20physique"}}, {"canonical_name": "Scholars", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "scholars", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Scholars", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Scholars"], "contexts": ["individuals engaged in academic study", "learned individuals"]}, {"entity_id": "scholars", "book_id": "principles_of_psychology_james_1890", "name": "scholars", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["scholars"], "contexts": ["learned individuals"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Scholars", "target_book": "principles_of_psychology_james_1890", "target_name": "scholars", "similarity": 0.946}], "id": 4364, "stable_key": "clu_787c608d8c761d64", "ground_truth": {"modern_name": "Scholars", "confidence": "high", "type": "concept", "note": "This cluster refers to the general concept of learned individuals rather than specific historical figures."}}, {"canonical_name": "Taurus", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "taurus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Taurus", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Taurus"], "contexts": ["servant of Minos", "ship or pilot name"]}, {"entity_id": "taurus", "book_id": "polyanthea_medicinal", "name": "Taurus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Taurus"], "contexts": ["author of fol. 565."]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Taurus", "target_book": "polyanthea_medicinal", "target_name": "Taurus", "similarity": 0.868}], "id": 4365, "stable_key": "clu_dabd3f259d385654", "ground_truth": {"modern_name": "Taurus", "confidence": "medium", "type": "person", "description": "Mythological figure, possibly a historical or literary reference.", "note": "In the context of King Minos, 'Taurus' likely refers to the Minotaur or a related figure, not a specific historical person. The other context might refer to a different Taurus.", "wikidata_id": "Q10570", "wikidata_description": "zodiac constellation straddling the celestial equator", "wikipedia_url": "https://en.wikipedia.org/wiki/Taurus_%28constellation%29", "wikipedia_extract": "The German Taurus controversy refers to an ongoing political controversy starting in Summer 2023 surrounding the delivery of Bundeswehr Taurus cruise missiles to Ukraine. After the Russian invasion of Ukraine began in 2022, the Ukrainian government asked Germany in 2023 to deliver the German-Swedish air-to-ground cruise missiles. In Spring 2024, the majority of the government and parliament, as well as many surveyed sections of the population, spoke out against the delivery of Taurus missiles to Ukraine. Former German Chancellor Olaf Scholz (SPD) was strongly opposed to the delivery of Taurus missiles to Ukraine, as he feared that sending such weapons could result in an escalation in the conflict. This could lead to the country being drawn into the war as a hostile party, particularly because the Taurus has a range that extends deep into Russian territory (including Moscow) and can only be limited with Bundeswehr soldiers on site. Like the Chancellor, many members of the SPD reject its delivery; politicians from the Greens and the FDP as well as other sections of the SPD have called for its delivery."}}, {"canonical_name": "Salmasius", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "salmasius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Salmasius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Salmasius"], "contexts": ["scholar who commented on Pliny", "commentator on Pliny"]}, {"entity_id": "salmasius", "book_id": "coloquios_da_orta_1563", "name": "Salmasius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Salmasius"], "contexts": ["erudite scholar"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Salmasius", "target_book": "coloquios_da_orta_1563", "target_name": "Salmasius", "similarity": 1.0}], "id": 4366, "stable_key": "clu_5518db8305e42a91", "ground_truth": {"modern_name": "Claude Saumaise", "confidence": "high", "type": "person", "birth_year": 1588, "death_year": 1653, "description": "French classical scholar and critic, commentator on Pliny.", "wikidata_id": "Q605328", "wikidata_description": "French classical scholar, writer and professor in Leiden (1588-1653)"}}, {"canonical_name": "Ardoynus", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ardoynus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ardoynus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Ardoynus"], "contexts": ["modern author who used traditions of poisons and antidotes", "author on natural history"]}, {"entity_id": "ardonius", "book_id": "historia_medicinal_monardes_1574", "name": "Ardonius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Ardonius"], "contexts": ["Italian physician, praised Bezoar stone"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ardoynus", "target_book": "historia_medicinal_monardes_1574", "target_name": "Ardonius", "similarity": 0.85}], "id": 4367, "stable_key": "clu_3860238061283a68", "ground_truth": {"modern_name": "Nicolaus Ardoin", "confidence": "high", "type": "person", "description": "Italian physician and scholar, praised bezoar stones.", "note": "The spelling 'Ardoynus' and 'Ardonius' are variants of the same name."}}, {"canonical_name": "Phoenix", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "phoenix", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Phoenix", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Phoenix"], "contexts": ["mythical bird used in arguments", "mythological bird mentioned by poets"]}, {"entity_id": "phoenix", "book_id": "coloquios_da_orta_1563", "name": "Phoenix", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Phoenix"], "contexts": ["mythical bird burning in fire"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Phoenix", "target_book": "coloquios_da_orta_1563", "target_name": "Phoenix", "similarity": 1.0}], "id": 4368, "stable_key": "clu_2502712c4b33cdb6", "ground_truth": {"modern_name": "Phoenix", "confidence": "high", "type": "animal", "note": "Referenced as a mythical creature.", "wikidata_id": "Q27685", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Phoenix%20%28plant%29", "wikipedia_extract": "Phoenix is a genus of 14 species of palms, native to an area starting from the Canary Islands in the west, across northern and central Africa, to the extreme southeast of Europe (Crete), and continuing throughout southern Asia, from Anatolia east to southern China and Malaysia. The diverse habitats they occupy include swamps, deserts, and mangrove sea coasts. Most Phoenix species originate in semi-arid regions, but usually occur near high groundwater levels, rivers, or springs. The genus is unusual among members of subfamily Coryphoideae in having pinnate, rather than palmate leaves; tribe Caryoteae also have pinnate or bipinnate leaves. The palms were more numerous and widespread in the past than they are at present. Some Phoenix palms have become naturalised in other parts of the world; in particular, the date palm's long history of cultivation means that escaped plants in the past have long-since become ingrained into the native ecosystems of countries far from its original range in the Middle East."}}, {"canonical_name": "Tobias", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tobias", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Tobias", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Tobias"], "contexts": ["biblical figure"]}, {"entity_id": "tobias", "book_id": "polyanthea_medicinal", "name": "Tobias", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Tobias"], "contexts": ["Biblical figure"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Tobias", "target_book": "polyanthea_medicinal", "target_name": "Tobias", "similarity": 0.827}], "id": 4369, "stable_key": "clu_6d242262d777ea8e", "ground_truth": {"modern_name": "Tobias (Biblical figure)", "confidence": "high", "type": "person", "description": "Biblical figure, possibly referring to the prophet Tobit.", "note": "This refers to the biblical figure, not a specific historical person."}}, {"canonical_name": "Epicurus", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "epicurus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Epicurus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Epicurus"], "contexts": ["ancient Greek philosopher", "ancient philosopher"]}, {"entity_id": "epictetus", "book_id": "principles_of_psychology_james_1890", "name": "Epictetus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Epictetus"], "contexts": ["Stoic philosopher, author of Enchiridion"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Epicurus", "target_book": "principles_of_psychology_james_1890", "target_name": "Epictetus", "similarity": 0.929}], "id": 4370, "stable_key": "clu_c355b44b5df5e22b", "ground_truth": {"modern_name": "Epicurus", "confidence": "high", "type": "person", "birth_year": -341, "death_year": -270, "description": "Ancient Greek philosopher, founder of Epicureanism.", "note": "While Epictetus is also mentioned, the context of 'ancient Greek philosopher' strongly points to Epicurus as the primary referent.", "wikidata_id": "Q43216", "wikidata_description": "ancient Greek philosopher"}}, {"canonical_name": "Ammoniac", "category": "PLANT", "subcategory": "RESIN", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ammoniac", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ammoniac", "category": "PLANT", "subcategory": "RESIN", "count": 2, "variants": ["Ammoniac"], "contexts": ["mineral solution that crystallizes", "resinous substance"]}, {"entity_id": "ammoniaco_chyma", "book_id": "ricettario_fiorentino_1597", "name": "Ammoniaco chyma", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["Ammoniaco chyma"], "contexts": ["variant of Ammoniaco"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ammoniac", "target_book": "ricettario_fiorentino_1597", "target_name": "Ammoniaco chyma", "similarity": 0.914}], "id": 4371, "stable_key": "clu_f7811fbaddabafec", "ground_truth": {"modern_name": "Ammoniac", "confidence": "high", "type": "chemical", "note": "The context 'mineral solution that crystallizes' and 'variant of Ammoniaco' suggests a chemical substance derived from a plant, rather than a living plant itself.", "wikidata_id": "Q4747296", "wikidata_description": "genus of plants"}}, {"canonical_name": "Mastick", "category": "PLANT", "subcategory": "RESIN", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mastick", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mastick", "category": "PLANT", "subcategory": "RESIN", "count": 2, "variants": ["Mastick"], "contexts": ["aromatic resin", "resin with attractive quality"]}, {"entity_id": "mastick", "book_id": "english_physician_1652", "name": "Mastick", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Mastick"], "contexts": ["plant used to make powder"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mastick", "target_book": "english_physician_1652", "target_name": "Mastick", "similarity": 0.566}], "id": 4372, "stable_key": "clu_8e7a01d0adc54a90-2", "ground_truth": {"modern_name": "mastic", "confidence": "high", "type": "PLANT", "linnaean": "Pistacia lentiscus", "family": "Anacardiaceae", "description": "Aromatic resin from the mastic tree, used medicinally and as a spice.", "note": "Also known as Almaciga. 'Almecega do Brasil' likely refers to related species or similar resins.", "wikipedia_extract": "Pistacia lentiscus (also lentisk or mastic) is a dioecious evergreen shrub or small tree of the genus Pistacia native to the Mediterranean Basin. It grows up to 4 m (13 ft) tall and is cultivated for its aromatic resin, mainly on the Greek island of Chios, around the Turkish town of \u00c7e\u015fme and northern parts of Iraq. The plant is evergreen, from 1 to 5 m (3 ft 3 in to 16 ft 5 in) high, with a strong smell of resin, growing in dry and rocky areas in North Africa and Mediterranean Europe. It resists mild to heavy frosts but prefers milder winters and grows on all types of soils, and can grow well in limestone areas and even in salty or saline environments, making it more abundant near the sea. It is also found in woodlands, dehesas (almost deforested pasture areas), Kermes oak woods, wooded areas dominated by other oaks, garrigues, maquis shrublands, hills, gorges, canyons, and rocky hillsides of the entire Mediterranean area. It is a typical species of Mediterranean mixed communities which include myrtle, Kermes oak, Mediterranean dwarf palm, buckthorn and sarsaparilla, and serves as protection and food for birds and other fauna in this ecosystem.", "wikidata_id": "Q6005596", "wikidata_description": "genus of plants"}}, {"canonical_name": "Flints", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "flints", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Flints", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Flints"], "contexts": ["hard sedimentary rock", "stones subject to fusion in fire"]}, {"entity_id": "flints", "book_id": "first_principles_spencer_1862", "name": "flints", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["flints"], "contexts": ["mineral component in porcelain mixture"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Flints", "target_book": "first_principles_spencer_1862", "target_name": "flints", "similarity": 0.754}], "id": 4373, "stable_key": "clu_b18a24c50080fbe2-2", "ground_truth": {"modern_name": "Flint", "confidence": "high", "type": "mineral", "wikidata_id": "Q1428848", "wikidata_description": "town in Wales, United Kingdom"}}, {"canonical_name": "Aqua vit\u00e6", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "aqua_vit\u00e6", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Aqua vit\u00e6", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Aqua vit\u00e6"], "contexts": ["liquid in which ice floats", "liquid coagulated by volatile salt"]}, {"entity_id": "aqua_vitae", "book_id": "english_physician_1652", "name": "Aqua vitae", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Aqua vitae"], "contexts": ["used in a drink"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Aqua vit\u00e6", "target_book": "english_physician_1652", "target_name": "Aqua vitae", "similarity": 0.91}], "id": 4374, "stable_key": "clu_67b6f1fe94c5d738-4", "ground_truth": {"modern_name": "Alcohol", "confidence": "high", "type": "chemical", "wikidata_id": "Q153", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Ethanol", "wikipedia_extract": "Ethanol (also called ethyl alcohol, grain alcohol, drinking alcohol, or simply alcohol) is an organic compound with the chemical formula CH3CH2OH. It is an alcohol, with its formula also written as C2H5OH, C2H6O or EtOH, where Et is the pseudoelement symbol for ethyl. Ethanol is a volatile, flammable, colorless liquid with a pungent taste. As a psychoactive depressant, it is the active ingredient in alcoholic beverages, and the second most consumed drug globally behind caffeine. Ethanol is naturally produced by the fermentation process of sugars by yeasts or via petrochemical processes such as ethylene hydration. Historically it was used as a general anesthetic, and has modern medical applications as an antiseptic, disinfectant, solvent for some medications, and antidote for methanol poisoning and ethylene glycol poisoning.", "note": "Aqua vitae (Latin for 'water of life') is an archaic term for distilled spirits, most commonly referring to ethanol."}}, {"canonical_name": "Emery", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "emery", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Emery", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Emery"], "contexts": ["abrasive mineral for polishing", "abrasive material"]}, {"entity_id": "emery", "book_id": "first_principles_spencer_1862", "name": "Emery", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Emery"], "contexts": ["ground and separated by water current"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Emery", "target_book": "first_principles_spencer_1862", "target_name": "Emery", "similarity": 1.0}], "id": 4375, "stable_key": "clu_736c4d760bf40817", "ground_truth": {"modern_name": "Emery", "confidence": "high", "type": "mineral", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Americus", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "americus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Americus", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Americus"], "contexts": ["Italian explorer and cartographer", "explorer after whom America named"]}, {"entity_id": "am\u00e9ricains_des_\u00e9tats-unis", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Am\u00e9ricains des \u00c9tats-Unis", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Am\u00e9ricains des \u00c9tats-Unis"], "contexts": ["Americans from the United States with route shortening"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Americus", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Am\u00e9ricains des \u00c9tats-Unis", "similarity": 0.891}], "id": 4376, "stable_key": "clu_c47dc872d14cde01-2", "ground_truth": {"modern_name": "Amerigo Vespucci", "confidence": "high", "type": "person", "birth_year": 1454, "death_year": 1512, "description": "Italian explorer, financier, and cartographer.", "wikidata_id": "Q47674", "wikidata_description": "Italian explorer, financier, navigator and cartographer"}}, {"canonical_name": "Achilles", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "achilles", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Achilles", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Achilles"], "contexts": ["strongest argument for antiquity of compass", "hero with a speaking horse in Homer"]}, {"entity_id": "achilles", "book_id": "english_physician_1652", "name": "Achilles", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Achilles"], "contexts": ["credited with discovering Yarrow's virtues"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Achilles", "target_book": "english_physician_1652", "target_name": "Achilles", "similarity": 0.796}], "id": 4377, "stable_key": "clu_885338880d09d805", "ground_truth": {"modern_name": "Achilles", "confidence": "high", "type": "person", "description": "Legendary Greek hero from the Trojan War.", "note": "The context of Yarrow's virtues likely refers to an apocryphal attribution or a metaphorical use rather than a direct action by the mythical hero.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Ulysses", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ulysses", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ulysses", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Ulysses"], "contexts": ["hero of Homer's Odyssey", "mythological figure with a long-lived dog"]}, {"entity_id": "ulysses", "book_id": "principles_of_psychology_james_1890", "name": "Ulysses", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Ulysses"], "contexts": ["hero of Homer's Odyssey"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ulysses", "target_book": "principles_of_psychology_james_1890", "target_name": "Ulysses", "similarity": 0.857}], "id": 4378, "stable_key": "clu_2a551407b60fa075", "ground_truth": {"modern_name": "Ulysses", "confidence": "high", "type": "person", "description": "Hero of Homer's Odyssey, a classical literary figure.", "wikidata_id": "Q47231", "wikidata_description": "legendary Greek king of Ithaca"}}, {"canonical_name": "Apocalyps", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "apocalyps", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Apocalyps", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Apocalyps"], "contexts": ["mentioned in relation to gems", "biblical book"]}, {"entity_id": "apocalypse", "book_id": "coloquios_da_orta_1563", "name": "Apocalypse", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Apocalypse"], "contexts": ["text with accompanying commentaries"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Apocalyps", "target_book": "coloquios_da_orta_1563", "target_name": "Apocalypse", "similarity": 0.974}], "id": 4379, "stable_key": "clu_a115fdc3b612f6d2", "ground_truth": {"modern_name": "Apocalypse", "confidence": "high", "type": "concept", "note": "The term 'Apocalyps' is an archaic spelling of 'Apocalypse', referring to a religious or prophetic revelation."}}, {"canonical_name": "Zeilan", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "zeilan", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Zeilan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Zeilan"], "contexts": ["country of the King using Loadstone", "source of best cinnamon"]}, {"entity_id": "zeilan", "book_id": "ricettario_fiorentino_1597", "name": "Zeilan", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Zeilan"], "contexts": ["place where cassia originates"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Zeilan", "target_book": "ricettario_fiorentino_1597", "target_name": "Zeilan", "similarity": 0.895}], "id": 4380, "stable_key": "clu_857c3fa0a9bc420b", "ground_truth": {"modern_name": "Sri Lanka", "confidence": "high", "type": "place", "country": "Sri Lanka", "wikidata_id": "Q370239", "wikidata_description": "species of flowering plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Cinnamomum%20verum", "wikipedia_extract": "Sri Lanka, officially the Democratic Socialist Republic of Sri Lanka, formerly known as Ceylon, is an island country in South Asia. It is located in the Indian Ocean, southwest of the Bay of Bengal, and is separated from India by the Gulf of Mannar and the Palk Strait. Sri Lanka shares a maritime border with the Maldives to the southwest and India to the northwest, and lies across the Bay of Bengal from Bangladesh and Myanmar to the northeast and the Andaman and Nicobar Islands of India to the east. Its capital is Sri Jayawardenepura Kotte, while Colombo is its largest city and the political, financial and cultural centre. Sri Lanka's population is 22 million; with the Sinhalese people, who speak the Sinhala language, forming the vast majority\u2014while Tamil is spoken by the large Tamil minority. Other long-established ethnic groups include the Moors, Indian Tamils, Burghers, Malays, Chinese, and Vedda."}}, {"canonical_name": "Leeches", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "leeches", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Leeches", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Leeches"], "contexts": ["creatures causing blood effusion", "segmented annelid worms"]}, {"entity_id": "leech", "book_id": "english_physician_1652", "name": "Leech", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Leech"], "contexts": ["creature used for bloodletting"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Leeches", "target_book": "english_physician_1652", "target_name": "Leech", "similarity": 0.907}], "id": 4381, "stable_key": "clu_3e70cf4aabe217d3", "ground_truth": {"modern_name": "Leech", "confidence": "medium", "type": "animal", "note": "The term 'Lea\u00f5' is Portuguese for lion. However, the context 'creature used for bloodletting' strongly suggests a leech, which is a common medical practice. The dual meaning makes it ambiguous without further context.", "wikidata_id": "Q43012", "wikidata_description": "sovereign island country and city-state in maritime Southeast Asia", "wikipedia_extract": "The lion (Panthera leo) is a large cat of the genus Panthera, currently ranging only in Sub-Saharan Africa and India. It has a muscular, broad-chested body; a short, rounded head; round ears; and a dark, hairy tuft at the tip of its tail. It is sexually dimorphic; adult male lions are larger than females and have a prominent mane that which extends from the head to the shoulders and chest. The lion inhabits grasslands, savannahs, and shrublands. It is an apex and keystone predator, preying mostly on medium-sized and large ungulates. It is usually more diurnal than other wild cats, but when persecuted, it adapts to being active at night and at twilight.", "wikipedia_url": "https://en.wikipedia.org/wiki/Lion"}}, {"canonical_name": "Sponge", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "sponge", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Sponge", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Sponge"], "contexts": ["organism that swells in stomach", "porous marine organism"]}, {"entity_id": "sponge", "book_id": "first_principles_spencer_1862", "name": "sponge", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["sponge"], "contexts": ["aquatic invertebrate with porous body"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sponge", "target_book": "first_principles_spencer_1862", "target_name": "sponge", "similarity": 0.799}], "id": 4382, "stable_key": "clu_64f7ecb494b2718f", "ground_truth": {"modern_name": "Sponge", "confidence": "high", "type": "animal", "note": "Refers to sponges as organisms, aquatic invertebrates, and marine invertebrates. One context mentions a sponge swelling in the stomach, possibly referring to a medicinal preparation or a misidentification.", "wikidata_id": "Q18960", "wikidata_description": "phylum of animals", "wikipedia_extract": "Sponges or sea sponges are primarily marine invertebrates of the animal phylum Porifera (; meaning 'pore bearer'). They are sessile filter feeders that are bound to the seabed, and are one of the most ancient members of macrobenthos, with many historical species being important reef-building organisms. Sponges are multicellular organisms consisting of jelly-like mesohyl sandwiched between two thin layers of cells, and usually have tube-like bodies full of pores and channels that allow water to circulate through them. They have unspecialized cells that can transform into other types and that often migrate between the main cell layers and the mesohyl in the process. They do not have complex nervous, digestive or circulatory systems. Instead, most rely on maintaining a constant water flow through their bodies to obtain food and oxygen and to remove wastes, usually via flagella movements of the so-called \"collar cells\".", "wikipedia_url": "https://en.wikipedia.org/wiki/Sponge"}}, {"canonical_name": "Tiberius", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tiberius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Tiberius", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Tiberius"], "contexts": ["emperor related to glass story", "wore laurel for protection"]}, {"entity_id": "tiberius", "book_id": "kosmos_humboldt_1845", "name": "Tiberius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Tiberius"], "contexts": ["Roman emperor during earthquake"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Tiberius", "target_book": "kosmos_humboldt_1845", "target_name": "Tiberius", "similarity": 0.829}], "id": 4383, "stable_key": "clu_8fb84748455ae028", "ground_truth": {"modern_name": "Tiberius", "confidence": "high", "type": "person", "birth_year": -42, "death_year": 37, "description": "Roman Emperor, associated with stories about glass and earthquakes.", "wikidata_id": "Q1407", "wikidata_description": "second Roman Emperor from 14 to 37 AD"}}, {"canonical_name": "Tinder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tinder", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Tinder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Tinder"], "contexts": ["material for lighting fires", "material for igniting gunpowder"]}, {"entity_id": "tinder", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tinder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["tinder"], "contexts": ["material ignited by compression"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Tinder", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tinder", "similarity": 0.902}], "id": 4384, "stable_key": "clu_511fcd3bf60cc2f7", "ground_truth": {"modern_name": "Tinder", "confidence": "high", "type": "substance", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "Fire making, fire lighting or fire craft is the process of artificially starting a fire. It requires completing the fire triangle, usually by heating tinder above its autoignition temperature. Fire is an essential tool for human survival and the use of fire was important in early human cultural history since the Lower Paleolithic. Today, it is a key component of Scouting, woodcraft and bushcraft. The earliest evidence for fire-making dates to about 400,000 years ago at a Neanderthal site in eastern England where burnt soil was found along with fire-cracked flint handaxes and two fragments of iron pyrite, used to strike sparks with flint. The next oldest evidence comes from around 50,000 years ago and later, when evidence for fire making can be found in dozens of Neanderthal hand axes from France exhibiting use-wear traces suggesting these tools were struck with the mineral pyrite to produce sparks.", "wikipedia_url": "https://en.wikipedia.org/wiki/Fire_making"}}, {"canonical_name": "Gesner", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "gesner", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Gesner", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Gesner"], "contexts": ["described a stony plant", "names a plant"]}, {"entity_id": "gesner", "book_id": "english_physician_1652", "name": "Gesner", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Gesner"], "contexts": ["Renaissance naturalist"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gesner", "target_book": "english_physician_1652", "target_name": "Gesner", "similarity": 1.0}], "id": 4385, "stable_key": "clu_9bc53eb92a174873", "ground_truth": {"modern_name": "Conrad Gessner", "confidence": "high", "type": "person", "birth_year": 1516, "death_year": 1565, "description": "Swiss physician, botanist, zoologist, and bibliographer.", "wikidata_id": "Q60116", "wikidata_description": "Swiss physician, bibliographer and naturalist (1516\u20131565)", "wikipedia_url": "https://en.wikipedia.org/wiki/Conrad_Gessner", "wikipedia_extract": "The salamander is an amphibian of the order Urodela which once, like many real creatures, often was suppositiously ascribed fantastic and sometimes occult qualities by pre-modern authors, as in the allegorical descriptions of animals in medieval bestiaries. The legendary salamander is often depicted as a typical salamander in shape, with a lizard-like form, but is usually ascribed an affinity with fire, sometimes specifically elemental fire. Ancient and medieval commentators ascribed many fantastical abilities to the natural salamander. Many of these qualities are rooted in verifiable traits of the natural creature but often exaggerated. A large body of legend, mythology, and symbolism has developed around this creature over the centuries. Carl Linnaeus in the 10th edition of Systema Naturae of 1758 established the scientific description of the salamander and noted the chief characteristics described by the ancients: the reported ability to live in fire, and the oily exudates."}}, {"canonical_name": "Aconite", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "aconite", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Aconite", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Aconite"], "contexts": ["poisonous plant"]}, {"entity_id": "aconitum", "book_id": "coloquios_da_orta_1563", "name": "Aconitum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Aconitum"], "contexts": ["genus of a poisonous plant"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Aconite", "target_book": "coloquios_da_orta_1563", "target_name": "Aconitum", "similarity": 0.882}], "id": 4386, "stable_key": "clu_5417d99c2e22984f", "ground_truth": {"modern_name": "Aconitum", "confidence": "high", "type": "plant", "linnaean": "Aconitum", "family": "Ranunculaceae", "wikidata_id": "Q155904", "wikidata_description": "genus of flowering plants in the buttercup family Ranunculaceae", "wikipedia_url": "https://en.wikipedia.org/wiki/Aconitum", "wikipedia_extract": "Aconitum (), also known as aconite, monkshood, wolfsbane, leopard's bane, devil's helmet, or blue rocket, is a genus of over 250 species of flowering plants belonging to the family Ranunculaceae. These herbaceous, frequently toxic perennial plants are chiefly native to the mountainous parts of the Northern Hemisphere in North America, Europe, and Asia, growing in the moisture-retentive but well-draining soils of mountain meadows. Most Aconitum species are extremely poisonous and must be handled very carefully. Several Aconitum hybrids, such as the Arendsii form of Aconitum carmichaelii, have won gardening awards\u2014such as the Royal Horticultural Society's Award of Garden Merit. The name aconitum comes from the Greek word \u1f00\u03ba\u03cc\u03bd\u03b9\u03c4\u03bf\u03bd, which may derive from the Greek akon for dart or javelin, the tips of which were poisoned with the substance, or from akonae, because of the rocky ground on which the plant was thought to grow. The Greek name lycoctonum, which translates literally to \"wolf's bane\", is thought to indicate the use of its juice to poison arrows or baits used to kill wolves."}}, {"canonical_name": "Mandrake", "category": "PLANT", "subcategory": "ROOT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mandrake", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mandrake", "category": "PLANT", "subcategory": "ROOT", "count": 2, "variants": ["Mandrake"], "contexts": ["plant root", "root representing mankind"]}, {"entity_id": "mandrake", "book_id": "english_physician_1652", "name": "Mandrake", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Mandrake"], "contexts": ["herb with narcotic properties"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mandrake", "target_book": "english_physician_1652", "target_name": "Mandrake", "similarity": 0.836}], "id": 4387, "stable_key": "clu_3f9c1b79d8c26477", "ground_truth": {"modern_name": "Mandrake", "confidence": "high", "type": "plant", "linnaean": "Mandragora officinarum", "family": "Solanaceae", "wikidata_id": "Q2651366", "wikidata_description": "plant root", "wikipedia_url": "https://en.wikipedia.org/wiki/Mandragora_officinarum", "wikipedia_extract": "Mandragora officinarum is the type species of the plant genus Mandragora in the nightshade family Solanaceae. It is often known as mandrake, although this name is also used for other plants. As of 2015, sources differed significantly in the species they use for Mandragora plants native to the Mediterranean region. The main species found around the Mediterranean is called Mandragora autumnalis, the autumn mandrake. In a broader circumscription, all the plants native to the regions around the Mediterranean Sea are placed in M. officinarum, which thus includes M."}}, {"canonical_name": "Spider", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "spider", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Spider", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Spider"], "contexts": ["arachnid creature", "venemous creature signifying pestilence"]}, {"entity_id": "spider", "book_id": "polyanthea_medicinal", "name": "spider", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["spider"], "contexts": ["venomous creature"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Spider", "target_book": "polyanthea_medicinal", "target_name": "spider", "similarity": 0.912}], "id": 4388, "stable_key": "clu_5f00f67bc5e475b3-2", "ground_truth": {"wikipedia_extract": "Spiders (order Araneae) are air-breathing arthropods that have eight limbs, chelicerae with fangs generally able to inject venom, and spinnerets that extrude silk. They are the largest order of arachnids and rank seventh in total species diversity among all orders of organisms. Spiders are found worldwide on every continent except Antarctica, and have become established in nearly every land habitat. As of January 2026, 53,680 spider species in 139 families have been recorded by taxonomists. However, there has been debate among scientists about how families should be classified, with over 20 different classifications proposed since 1900. Anatomically, spiders (as with all arachnids) differ from other arthropods in that the usual body segments are fused into two tagmata, the cephalothorax or prosoma, and the opisthosoma, or abdomen, and joined by a small, cylindrical pedicel."}}, {"canonical_name": "articulations", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "articulations", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "articulations", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["articulations"], "contexts": ["joint-like structures", "joints or connections in the body"]}, {"entity_id": "articulated_parts", "book_id": "kosmos_humboldt_1845", "name": "articulated parts", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["articulated parts"], "contexts": ["minutest details of articulated parts"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "articulations", "target_book": "kosmos_humboldt_1845", "target_name": "articulated parts", "similarity": 0.934}], "id": 4389, "stable_key": "clu_1cdc076c550e474c-3", "ground_truth": {"modern_name": "Joints", "confidence": "high", "type": "concept", "wikidata_id": "Q33652928", "wikidata_description": "scientific article", "note": "'Articulations' in this context refers to the anatomical structures of joints, where bones connect, allowing for movement. It can also refer to the manner in which things are joined or connected.", "description": "The points where two bones meet; connections in the body.", "wikipedia_extract": "A joint or articulation (or articular surface) is the connection made between bones, ossicles, or other hard structures in the body which link an animal's skeletal system into a functional whole. They are constructed to allow for different degrees and types of movement. Some joints, such as the knee, elbow, and shoulder, are self-lubricating, almost frictionless, and are able to withstand compression and maintain heavy loads while still executing smooth and precise movements. Other joints such as sutures between the bones of the skull permit very little movement (only during birth) in order to protect the brain and the sense organs. The connection between a tooth and the jawbone is also called a joint, and is described as a fibrous joint known as a gomphosis. Joints are classified both structurally and functionally."}}, {"canonical_name": "Spanish", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "spanish", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Spanish", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Spanish"], "contexts": ["relating to Spain", "origin of Mares"]}, {"entity_id": "spanish", "book_id": "first_principles_spencer_1862", "name": "Spanish", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Spanish"], "contexts": ["language and people"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Spanish", "target_book": "first_principles_spencer_1862", "target_name": "Spanish", "similarity": 1.0}], "id": 4390, "stable_key": "clu_16feb9df060d385d-4", "ground_truth": {"modern_name": "Spain", "confidence": "high", "type": "place", "country": "Spain", "wikidata_id": "Q29", "wikidata_description": "country in southwestern Europe with territories in Africa", "wikipedia_url": "https://en.wikipedia.org/wiki/Spain", "wikipedia_extract": "Spain, officially the Kingdom of Spain, is a country in Southern and Western Europe with territories in North Africa. Featuring the southernmost point of continental Europe, it is the largest country in Southern Europe and the fourth-most populous European Union (EU) member state. Spanning the majority of the Iberian Peninsula, its territory also includes the Canary Islands, in the Eastern Atlantic Ocean; the Balearic Islands, in the Western Mediterranean Sea; and the autonomous cities of Ceuta and Melilla, in mainland Africa. Peninsular Spain is bordered to the north by France, Andorra, and the Bay of Biscay; to the east and south by the Mediterranean Sea and Gibraltar; and to the west by Portugal and the Atlantic Ocean. Spain's capital and largest city is Madrid; other major urban areas include Barcelona, Valencia, Seville, Zaragoza, M\u00e1laga, Murcia, and Palma de Mallorca. In early antiquity, the Iberian Peninsula was inhabited by Celts, Iberians, and other pre-Roman peoples."}}, {"canonical_name": "Cock", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cock", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Cock", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["Cock"], "contexts": ["bird with a comb", "male chicken"]}, {"entity_id": "cock", "book_id": "origin_of_species_darwin_1859", "name": "cock", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["cock"], "contexts": ["example of male weapon importance"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Cock", "target_book": "origin_of_species_darwin_1859", "target_name": "cock", "similarity": 0.908}], "id": 4391, "stable_key": "clu_bc2fcaedf8539407", "ground_truth": {"modern_name": "Rooster", "confidence": "high", "type": "animal", "wikidata_id": "Q688973", "wikidata_description": "heraldic animal"}}, {"canonical_name": "Incubation", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "incubation", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Incubation", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["incubation", "Incubation"], "contexts": ["process of hatching eggs"]}, {"entity_id": "incubation", "book_id": "first_principles_spencer_1862", "name": "incubation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["incubation"], "contexts": ["process exhibiting force connection"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Incubation", "target_book": "first_principles_spencer_1862", "target_name": "incubation", "similarity": 0.973}], "id": 4392, "stable_key": "clu_69902eba99f36138", "ground_truth": {"modern_name": "Incubation", "confidence": "high", "type": "concept", "note": "The term 'incubation' in early modern texts could refer to the process of egg hatching or, more broadly, to a period of development or gestation, including for diseases or ideas.", "wikidata_id": "Q12823380", "wikidata_description": "developmental process of animals (birds, fish, reptiles, monotremes etc.) from eggs"}}, {"canonical_name": "English", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "english", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "English", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["English"], "contexts": ["language of the people"]}, {"entity_id": "english", "book_id": "first_principles_spencer_1862", "name": "English", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["English"], "contexts": ["modern language form", "language with inflexions lost by contraction"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "English", "target_book": "first_principles_spencer_1862", "target_name": "English", "similarity": 1.0}], "id": 4393, "stable_key": "clu_d4bd7a2fb10d4994", "ground_truth": {"modern_name": "English language", "confidence": "high", "type": "concept", "note": "Refers to the English language as a linguistic and cultural entity.", "wikidata_id": "Q1860", "wikidata_description": "West Germanic language", "wikipedia_url": "https://en.wikipedia.org/wiki/English%20language", "wikipedia_extract": "English is a West Germanic language that emerged in early medieval England and has since become a global lingua franca. The namesake of the language is the Angles, one of the Germanic peoples who migrated to Britain after the end of Roman rule. English is the most spoken language in the world, primarily due to the global influences of the former British Empire (succeeded by the Commonwealth of Nations) and the United States. It is the most widely learned second language in the world, with more second-language speakers than native speakers. However, English is only the third-most spoken native language, after Mandarin Chinese and Spanish. English is either the official language, or one of the official languages, in 57 sovereign states and 30 dependent territories, making it the most geographically widespread language in the world."}}, {"canonical_name": "sensibilities", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "sensuality", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Sensuality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Sensuality"], "contexts": ["indulgence of physical desires"]}, {"entity_id": "sensibilities", "book_id": "principles_of_psychology_james_1890", "name": "sensibilities", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["sensibilities"], "contexts": ["capacity to feel or perceive"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sensuality", "target_book": "principles_of_psychology_james_1890", "target_name": "sensibilities", "similarity": 0.922}], "id": 4394, "stable_key": "clu_4a3b4a28461959d9", "ground_truth": {"modern_name": "Sensibility", "confidence": "high", "type": "concept", "note": "Refers to the capacity to feel, perceive, or experience emotions and sensations, often with connotations of refinement or susceptibility.", "wikidata_id": "Q1195509", "wikidata_description": "acute perception of or responsiveness toward something, such as the emotions of another"}}, {"canonical_name": "Tree of Life", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tree_of_life", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Tree of life", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Tree of life"], "contexts": ["biblical tree granting immortality"]}, {"entity_id": "tree_of_life", "book_id": "origin_of_species_darwin_1859", "name": "Tree of Life", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["Tree of Life"], "contexts": ["metaphor for evolutionary relationships", "metaphorical tree representing life's diversity"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Tree of life", "target_book": "origin_of_species_darwin_1859", "target_name": "Tree of Life", "similarity": 0.857}], "id": 4395, "stable_key": "clu_8beee57bca63e7cc", "ground_truth": {"modern_name": "Tree of Life", "confidence": "high", "type": "concept", "note": "Refers to both the biblical concept and Darwin's metaphorical use for evolutionary relationships. In early modern biology, it could also refer to specific symbolic plants or genera.", "wikidata_id": "Q2051175", "wikidata_description": "species of plant"}}, {"canonical_name": "Insane delusions", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "delusions", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "delusions", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["delusions"], "contexts": ["false beliefs or perceptions"]}, {"entity_id": "insane_delusions", "book_id": "principles_of_psychology_james_1890", "name": "Insane delusions", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["Insane delusions"], "contexts": ["mutations of the self", "false beliefs held in insanity"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "delusions", "target_book": "principles_of_psychology_james_1890", "target_name": "Insane delusions", "similarity": 0.939}], "id": 4396, "stable_key": "clu_41aa7fbda4f61f69", "ground_truth": {"modern_name": "Delusion", "confidence": "high", "type": "disease", "modern_term": "Delusion"}}, {"canonical_name": "petitio principii", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "petitio_principii", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Petitio principii", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Petitio principii"], "contexts": ["logical fallacy of assuming the premise"]}, {"entity_id": "petitio_principii", "book_id": "first_principles_spencer_1862", "name": "petitio principii", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["petitio principii"], "contexts": ["logical fallacy of assuming the conclusion"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Petitio principii", "target_book": "first_principles_spencer_1862", "target_name": "petitio principii", "similarity": 0.983}], "id": 4397, "stable_key": "clu_adaac01f2891b031", "ground_truth": {"modern_name": "Begging the question", "confidence": "high", "type": "concept", "wikidata_id": "Q219429", "wikidata_description": "type of fallacy, where a proposition is assumed as a premise, which itself needs a proof and directly entails the conclusion", "wikipedia_url": "https://en.wikipedia.org/wiki/Begging%20the%20question", "wikipedia_extract": "In classical rhetoric and logic, begging the question or assuming the conclusion (Latin: pet\u012bti\u014d principi\u012b) is an informal fallacy that occurs when an argument's premises assume the truth of the conclusion. Historically, begging the question refers to a fault in a dialectical argument in which the speaker assumes some premise that has not been demonstrated to be true. In modern usage, it has come to refer to an argument in which the premises assume the conclusion without supporting it. This makes it an example of circular reasoning. \u201cWool sweaters are better than nylon jackets as fall attire because wool sweaters have higher wool content\". The claim here is that wool sweaters are better than nylon jackets as fall attire."}}, {"canonical_name": "Citron", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "citron", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Citron", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Citron"], "contexts": ["smell believed to cause generation in Heaven"]}, {"entity_id": "citron", "book_id": "english_physician_1652", "name": "Citron", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Citron", "Citrons"], "contexts": ["seed to balance coldness", "bark used for preserving"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Citron", "target_book": "english_physician_1652", "target_name": "Citron", "similarity": 1.0}], "id": 4398, "stable_key": "clu_59f01bee901af4a9", "ground_truth": {"modern_name": "Citron", "confidence": "high", "type": "plant", "linnaean": "Citrus medica Linnaeus", "family": "Rutaceae", "wikidata_id": "Q150064", "wikidata_description": "species of citrus plant"}}, {"canonical_name": "Divine Wisdom", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "wisdom_of_god", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Wisdom of God", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Wisdom of God"], "contexts": ["divine understanding and order"]}, {"entity_id": "divine_wisdom", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Divine Wisdom", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Divine Wisdom"], "contexts": ["creator's selection of laws", "attributed with selecting laws of nature"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Wisdom of God", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Divine Wisdom", "similarity": 0.947}], "id": 4399, "stable_key": "clu_fb447b466b09e35e", "ground_truth": {"modern_name": "Divine wisdom", "confidence": "high", "type": "concept", "wikidata_id": "Q106859960", "wikidata_description": "painting by Unidentified Artist"}}, {"canonical_name": "foxes", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "foxes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Foxes", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Foxes"], "contexts": ["vulpine animals"]}, {"entity_id": "foxes", "book_id": "origin_of_species_darwin_1859", "name": "foxes", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["foxes"], "contexts": ["wild canid species", "wild canids"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Foxes", "target_book": "origin_of_species_darwin_1859", "target_name": "foxes", "similarity": 0.896}], "id": 4400, "stable_key": "clu_f78c0ebe565ca6b8", "ground_truth": {"modern_name": "Fox", "confidence": "high", "type": "animal", "wikidata_id": "Q8332", "wikidata_description": "species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Red%20fox", "wikipedia_extract": "The red fox (Vulpes vulpes) is the largest of the true foxes and one of the most widely distributed members of the order Carnivora. It is present across the entire Northern Hemisphere, including most of North America, Europe and Asia, as well as parts of North Africa. Its range has expanded alongside human settlement, with the species having been introduced to Australia, where it preys on native small and medium-sized rodents and marsupials. The red fox is listed as of least concern on the IUCN Red List. Because of its impact on native species, it is also included on the list of the \"world's 100 worst invasive species\". The red fox originated in Eurasia during the Middle Pleistocene at least 400,000 years ago and later colonised North America sometime prior to 130,000 years ago."}}, {"canonical_name": "dyoscorides", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "diascorides", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Diascorides", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Diascorides"], "contexts": ["ancient Greek physician and botanist"]}, {"entity_id": "dyoscorides", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "dyoscorides", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["dyoscorides"], "contexts": ["ancient authority who named Rhododendron", "ancient Greek physician and botanist"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Diascorides", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "dyoscorides", "similarity": 0.856}], "id": 4401, "stable_key": "clu_cb8fafa36ee75a77", "ground_truth": {"modern_name": "Dioscorides", "confidence": "high", "type": "person", "description": "Ancient Greek physician and botanist, author of De Materia Medica.", "wikidata_id": "Q297776", "wikidata_description": "Greco-Roman physician and pharmacologist (AD c.40-90)", "wikipedia_url": "https://en.wikipedia.org/wiki/Dioscorides"}}, {"canonical_name": "Compo\u017fitione medicamentorum", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "de_compositione_medicamentorum", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "De Compositione Medicamentorum", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["De Compositione Medicamentorum"], "contexts": ["work by Scribonius Largus"]}, {"entity_id": "compo\u017fitione_medicamentorum", "book_id": "polyanthea_medicinal", "name": "Compo\u017fitione medicamentorum", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["Compo\u017fitione medicamentorum", "Compofitione medicamentorum"], "contexts": ["composition of medicines"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "De Compositione Medicamentorum", "target_book": "polyanthea_medicinal", "target_name": "Compo\u017fitione medicamentorum", "similarity": 0.899}], "id": 4402, "stable_key": "clu_9f694a3cc27ad580", "ground_truth": {"modern_name": "Composition of Medicines", "confidence": "high", "type": "text", "note": "This refers to a classical medical text on the preparation of remedies.", "wikidata_id": "Q543881", "wikidata_description": "Byzantine compendium on medical science"}}, {"canonical_name": "Fable", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "fables", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Fables", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Fables"], "contexts": ["mythical or untrue stories"]}, {"entity_id": "fable", "book_id": "epoques_nature_buffon_1778", "name": "Fable", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Fable"], "contexts": ["mythological stories and narratives", "mythical or allegorical narrative"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Fables", "target_book": "epoques_nature_buffon_1778", "target_name": "Fable", "similarity": 0.86}], "id": 4403, "stable_key": "clu_1f537f6d1afddd1a", "ground_truth": {"modern_name": "Fable", "confidence": "high", "type": "concept", "wikidata_id": "Q37449164", "wikidata_description": "family name"}}, {"canonical_name": "Memphis", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "memphis", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Memphis", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Memphis"], "contexts": ["ancient Egyptian city"]}, {"entity_id": "memphis", "book_id": "coloquios_da_orta_1563", "name": "Memphis", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Memphis"], "contexts": ["celebre city, debated location", "city"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Memphis", "target_book": "coloquios_da_orta_1563", "target_name": "Memphis", "similarity": 1.0}], "id": 4404, "stable_key": "clu_791f81929c365d60", "ground_truth": {"modern_name": "Memphis", "confidence": "high", "type": "place", "country": "Egypt", "wikidata_id": "Q5715", "wikidata_description": "ancient capital of Inebu-hedj, Egypt"}}, {"canonical_name": "Thales", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "thales", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Thales", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Thales"], "contexts": ["ancient Greek philosopher"]}, {"entity_id": "thales", "book_id": "kosmos_humboldt_1845", "name": "Thales", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Thales"], "contexts": ["ancient philosopher", "Ancient Greek philosopher, founder of Ionic natural philosophy"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Thales", "target_book": "kosmos_humboldt_1845", "target_name": "Thales", "similarity": 1.0}], "id": 4405, "stable_key": "clu_83744f614d086d4b", "ground_truth": {"modern_name": "Thales", "confidence": "high", "type": "person", "birth_year": -624, "death_year": -546, "description": "Ancient Greek philosopher and one of the Seven Sages of Greece.", "wikipedia_extract": "Thales of Miletus ( THAY-leez; Ancient Greek: \u0398\u03b1\u03bb\u1fc6\u03c2; c. 626/623  \u2013 c. 548/545 BC) was an Ancient Greek pre-Socratic philosopher from Miletus in Ionia, Asia Minor. Thales was one of the Seven Sages, founding figures of Ancient Greece. Beginning in eighteenth-century historiography, many came to regard him as the first philosopher in the Greek tradition, breaking from the prior use of mythology to explain the world and instead using natural philosophy. He is thus otherwise referred to as the first to have engaged in mathematics, science, and deductive reasoning.", "wikipedia_url": "https://en.wikipedia.org/wiki/Thales_of_Miletus"}}, {"canonical_name": "morality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "morality", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Morality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Morality"], "contexts": ["principles concerning the distinction between right and wrong"]}, {"entity_id": "morality", "book_id": "first_principles_spencer_1862", "name": "morality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["morality"], "contexts": ["principles of right and wrong", "principles of right and wrong conduct"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Morality", "target_book": "first_principles_spencer_1862", "target_name": "morality", "similarity": 0.986}], "id": 4406, "stable_key": "clu_a4a058a04da5fcac-2", "ground_truth": {"modern_name": "Morality", "confidence": "high", "type": "concept", "wikidata_id": "Q1132684", "wikidata_description": "ethical practice concerning scientific research", "wikipedia_url": "https://en.wikipedia.org/wiki/Research%20ethics", "wikipedia_extract": "Research ethics is a discipline within the study of applied ethics. Its scope ranges from general scientific integrity and misconduct to the treatment of human and animal subjects. The social responsibilities of scientists and researchers are not traditionally included and are less well defined. The discipline is most developed in medical research. Beyond the issues of falsification, fabrication, and plagiarism that arise in every scientific field, research design in human subject research and animal testing are the areas that raise ethical questions most often. The list of historic cases includes many large-scale violations and crimes against humanity such as Nazi human experimentation and the Tuskegee syphilis experiment which led to international codes of research ethics."}}, {"canonical_name": "agnus castus", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "agnus_castus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Agnus Castus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Agnus Castus"], "contexts": ["plant name, synonym for Vitex"]}, {"entity_id": "agnus_castus", "book_id": "coloquios_da_orta_1563", "name": "agnus castus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["agnus castus", "agno casto"], "contexts": ["plant that weakens Venus's influence", "herb"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Agnus Castus", "target_book": "coloquios_da_orta_1563", "target_name": "agnus castus", "similarity": 0.926}], "id": 4407, "stable_key": "clu_bc25bb888df0700c-3", "ground_truth": {"modern_name": "Chaste tree", "confidence": "high", "type": "plant", "linnaean": "Vitex agnus-castus L.", "family": "Verbenaceae", "wikipedia_extract": "Vitex is a genus of flowering plants in the family Lamiaceae. It has about 200\u2013250 species; as of August 2025 the Plants of the World Online database accepts 211 species. Common names include chaste tree or chastetree, traditionally referring to V. agnus-castus, but often applied to other species, as well, and p\u016briri for the New Zealand species V. lucens. Species of Vitex are native throughout the tropics and subtropics, with a few species in warm-temperate Eurasia and one in New Zealand.", "wikipedia_url": "https://en.wikipedia.org/wiki/Vitex", "description": "Shrub whose berries were used to reduce libido and for medicinal purposes.", "note": "'Agnocasto' is the Italian/Portuguese name for Vitex agnus-castus.", "wikidata_id": "Q29533", "wikidata_description": "species of flowering plant"}}, {"canonical_name": "Saturno", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "saturn", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Saturn", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Saturn"], "contexts": ["Roman god"]}, {"entity_id": "saturno", "book_id": "historia_medicinal_monardes_1574", "name": "Saturno", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Saturno"], "contexts": ["planet influencing disease", "planetary influence on disease"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Saturn", "target_book": "historia_medicinal_monardes_1574", "target_name": "Saturno", "similarity": 0.988}], "id": 4408, "stable_key": "clu_4980c2e5d63a508c", "ground_truth": {"modern_name": "Saturn", "confidence": "high", "type": "person", "description": "Roman god of agriculture and time; also a planet.", "note": "Refers to both the Roman deity and the planet, which had astrological significance.", "wikipedia_extract": "Saturn is the sixth planet from the Sun and the second largest in the Solar System, after Jupiter. It is a gas giant, with an average radius of about 9 times that of Earth. It has an eighth of the average density of Earth, but is over 95 times more massive. Even though Saturn is almost as big as Jupiter, Saturn has less than a third of its mass. Saturn orbits the Sun at a distance of 9.59 AU (1,434 million km), with an orbital period of 29.45 years. Saturn's interior is thought to be composed of a rocky core, surrounded by a deep layer of metallic hydrogen, an intermediate layer of liquid hydrogen and liquid helium, and an outer layer of gas."}}, {"canonical_name": "Divis\u00f5es", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "division", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "division", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["division"], "contexts": ["negative quality, from evil principle"]}, {"entity_id": "divis\u00f5es", "book_id": "coloquios_da_orta_1563", "name": "Divis\u00f5es", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Divis\u00f5es"], "contexts": ["work by Rasis", "Division of the world by papal bull"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "division", "target_book": "coloquios_da_orta_1563", "target_name": "Divis\u00f5es", "similarity": 0.884}], "id": 4409, "stable_key": "clu_b28aebf083327406", "ground_truth": {"modern_name": "Division", "confidence": "medium", "type": "concept", "note": "The context suggests a philosophical or medical concept of division, possibly related to classification or differentiation."}}, {"canonical_name": "feminine sex", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "feminine_sex", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "feminine sex", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["feminine sex"], "contexts": ["biological sex"]}, {"entity_id": "female_sexual_elements", "book_id": "origin_of_species_darwin_1859", "name": "female sexual elements", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["female sexual elements"], "contexts": ["eggs or related structures"]}, {"entity_id": "female_sexual_element", "book_id": "origin_of_species_darwin_1859", "name": "female sexual element", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["female sexual element"], "contexts": ["egg or ovule"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "feminine sex", "target_book": "origin_of_species_darwin_1859", "target_name": "female sexual elements", "similarity": 0.909}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "feminine sex", "target_book": "origin_of_species_darwin_1859", "target_name": "female sexual element", "similarity": 0.905}], "id": 4410, "stable_key": "clu_6038c51f34c9ca3a", "ground_truth": {"modern_name": "sex", "confidence": "high", "type": "concept"}}, {"canonical_name": "Princes", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "princes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Princes", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Princes"], "contexts": ["rulers with power over oracles"]}, {"entity_id": "princes", "book_id": "english_physician_1652", "name": "Princes", "category": "PERSON", "subcategory": "PATRON", "count": 2, "variants": ["Princes"], "contexts": ["supported Mathiolus' work", "supported the art"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Princes", "target_book": "english_physician_1652", "target_name": "Princes", "similarity": 1.0}], "id": 4411, "stable_key": "clu_1c025956fb17f454", "ground_truth": {"modern_name": "Patronage", "confidence": "high", "type": "concept", "note": "The context implies rulers or wealthy individuals who supported scholars and their work, rather than the individuals themselves.", "wikidata_id": "Q516590", "wikidata_description": "honorary person or organization that supports another organization or person or effort"}}, {"canonical_name": "vegetable forms", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "vegetable_bodies", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Vegetable bodies", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Vegetable bodies"], "contexts": ["substances derived from plants"]}, {"entity_id": "vegetable_forms", "book_id": "kosmos_humboldt_1845", "name": "vegetable forms", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["vegetable forms"], "contexts": ["forms of plant life", "plant structures"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Vegetable bodies", "target_book": "kosmos_humboldt_1845", "target_name": "vegetable forms", "similarity": 0.94}], "id": 4412, "stable_key": "clu_eaf8d0ffebcecc7d", "ground_truth": {"modern_name": "Plant matter", "confidence": "medium", "type": "plant", "note": "The terms 'vegetable bodies' and 'vegetable forms' are general and could refer to various aspects of plants.", "wikidata_id": "Q114615924", "wikidata_description": "scientific article published in 2008"}}, {"canonical_name": "Horse dung", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "horse-dung", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "horse-dung", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["horse-dung"], "contexts": ["excrement from horses"]}, {"entity_id": "horse_dung", "book_id": "english_physician_1652", "name": "Horse dung", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Horse dung", "Horse-dung"], "contexts": ["bed for distilling medicine", "animal excrement used for compost"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "horse-dung", "target_book": "english_physician_1652", "target_name": "Horse dung", "similarity": 0.81}], "id": 4413, "stable_key": "clu_78dd18a1f1d621b0", "ground_truth": {"modern_name": "Horse dung", "confidence": "high", "type": "animal", "wikidata_id": "Q127549096", "wikidata_description": "scholarly article"}}, {"canonical_name": "basaltic", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "basaltes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Basaltes", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Basaltes"], "contexts": ["mineral with angular figures"]}, {"entity_id": "basaltic", "book_id": "kosmos_humboldt_1845", "name": "basaltic", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["basaltic"], "contexts": ["dense rock masses", "type of volcanic rock"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Basaltes", "target_book": "kosmos_humboldt_1845", "target_name": "basaltic", "similarity": 0.901}], "id": 4414, "stable_key": "clu_ef11226103bcbb98-3", "ground_truth": {"modern_name": "Basalt", "confidence": "high", "type": "mineral", "wikidata_id": "Q18943892", "wikidata_description": "street in Langenboom, the Netherlands", "note": "The term 'Basaltes' or 'basaltic' refers to the igneous rock basalt, often described for its density and sometimes its columnar jointing."}}, {"canonical_name": "Pots", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tongs", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Tongs", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Tongs"], "contexts": ["culinary utensil acquiring magnetism"]}, {"entity_id": "pots", "book_id": "english_physician_1652", "name": "Pots", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Pots"], "contexts": ["used to keep lohochs", "containers for ointments"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Tongs", "target_book": "english_physician_1652", "target_name": "Pots", "similarity": 0.911}], "id": 4415, "stable_key": "clu_07762b7b310c3712", "ground_truth": {"modern_name": "Pots", "confidence": "medium", "type": "object", "note": "The term 'Tongs' in the context of acquiring magnetism and 'Pots' for keeping lohochs suggests a variety of containers or tools, with 'pots' being the more general and likely referent when combined with the 'lohochs' context. However, the inclusion of 'tongs' makes the precise object ambiguous."}}, {"canonical_name": "Levinus Lemnius", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "levinus_lemnius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Levinus Lemnius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Levinus Lemnius"], "contexts": ["believed in antiquity of compass knowledge"]}, {"entity_id": "levinus_lemnius", "book_id": "polyanthea_medicinal", "name": "Levinus Lemnius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Levinus Lemnius"], "contexts": ["early modern scholar", "Levinus Lemniusde Occultis natura miraculis"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Levinus Lemnius", "target_book": "polyanthea_medicinal", "target_name": "Levinus Lemnius", "similarity": 1.0}], "id": 4416, "stable_key": "clu_eeedddde007bda22", "ground_truth": {"modern_name": "Levinus Lemnius", "confidence": "high", "type": "person", "birth_year": 1506, "death_year": 1568, "description": "Dutch physician and humanist, known for his writings on natural philosophy.", "wikidata_id": "Q3237230", "wikidata_description": "Dutch writer (1505-1568)", "wikipedia_url": "https://en.wikipedia.org/wiki/Levinus%20Lemnius", "wikipedia_extract": "Levinus Lemnius  (20 May 1505 in Zierikzee \u2013 1 July 1568 in Zierikzee) was a Dutch physician and author. Lemnius studied medicine at the University of Leuven under Rembert Dodoens and Konrad Gesner; and under Vesalius at Padua. He also travelled to Switzerland and England. After his wife's death, he became a priest. Occulta naturae miracula (1559, Antwerp) by the University and State Library D\u00fcsseldorf) This was translated as De gli occvlti miracoli, Les Occultes Merveilles et Secretz de Nature (online text, The secret miracles of nature, and Wunderbarliche Geheimnisse der Natur online text). De habitu et constitutione corporis (1561, Antwerp)."}}, {"canonical_name": "Cleopatra", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cleopatra", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Cleopatra", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Cleopatra"], "contexts": ["historical figure associated with Anthony"]}, {"entity_id": "cleopatra", "book_id": "historia_medicinal_monardes_1574", "name": "Cleopatra", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Cleopatra"], "contexts": ["historical figure", "drank poison to avoid triumph of Pompey"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Cleopatra", "target_book": "historia_medicinal_monardes_1574", "target_name": "Cleopatra", "similarity": 1.0}], "id": 4417, "stable_key": "clu_dfbd268074b00e89", "ground_truth": {"modern_name": "Cleopatra", "confidence": "high", "type": "person", "birth_year": -69, "death_year": -30, "description": "Last active ruler of the Ptolemaic Kingdom of Egypt.", "wikipedia_extract": "Cleopatra VII Thea Philopator (Koine Greek: \u039a\u03bb\u03b5\u03bf\u03c0\u03ac\u03c4\u03c1\u03b1 \u0398\u03b5\u03ac \u03a6\u03b9\u03bb\u03bf\u03c0\u03ac\u03c4\u03c9\u03c1, lit. 'Cleopatra father-loving goddess'; 70/69 BC \u2013 10 or 12 August 30 BC) was Queen of the Ptolemaic Kingdom of Egypt from 51 to 30 BC, and the last active Hellenistic pharaoh. A member of the Ptolemaic dynasty, she was a descendant of its founder Ptolemy I Soter, a Macedonian Greek general and companion of Alexander the Great. Her first language was Koine Greek, and she is the only Ptolemaic ruler known to have learned the Egyptian language, among several others. After her death, Egypt became a province of the Roman Empire, marking the end of the Hellenistic period in the Mediterranean, which had begun during the reign of Alexander (336\u2013323 BC). Born in Alexandria, Cleopatra was the daughter of Ptolemy XII Auletes, who named her his heir before his death in 51 BC.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cleopatra"}}, {"canonical_name": "specific forms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "specifical_forms", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "specifical forms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["specifical forms"], "contexts": ["attributed causes for effects"]}, {"entity_id": "specific_forms", "book_id": "origin_of_species_darwin_1859", "name": "specific forms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["specific forms"], "contexts": ["distinct biological species", "biological entities with defined characteristics"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "specifical forms", "target_book": "origin_of_species_darwin_1859", "target_name": "specific forms", "similarity": 0.914}], "id": 4418, "stable_key": "clu_2f329d474f4ef5d1", "ground_truth": {"modern_name": "species", "confidence": "high", "type": "concept", "note": "The context of Darwin's 'Origin of Species' strongly suggests the biological concept of species, while Browne's usage in 'Pseudodoxia Epidemica' also points to distinct kinds or forms.", "wikidata_id": "Q2984250", "wikidata_description": "Group of animals capable of interbreeding", "wikipedia_url": "https://en.wikipedia.org/wiki/Species%20concept"}}, {"canonical_name": "Remora", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "remora", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Remora", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["Remora"], "contexts": ["fish whose salt was used in a magical preparation"]}, {"entity_id": "remora", "book_id": "polyanthea_medicinal", "name": "Remora", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Remora", "R\u00e9mora"], "contexts": ["fish that stops ships", "fish with singular virtue"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Remora", "target_book": "polyanthea_medicinal", "target_name": "Remora", "similarity": 0.708}], "id": 4419, "stable_key": "clu_85a5074cefc448cc", "ground_truth": {"modern_name": "Remora", "confidence": "high", "type": "animal"}}, {"canonical_name": "Lucretius", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "lucretius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Lucretius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Lucretius"], "contexts": ["poet whose style was emulated"]}, {"entity_id": "lucretius", "book_id": "polyanthea_medicinal", "name": "Lucretius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Lucretius"], "contexts": ["ancient philosopher and poet"]}, {"entity_id": "lucret_", "book_id": "polyanthea_medicinal", "name": "Lucret.", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Lucret."], "contexts": ["ancient authority cited in text"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lucretius", "target_book": "polyanthea_medicinal", "target_name": "Lucretius", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lucretius", "target_book": "polyanthea_medicinal", "target_name": "Lucret.", "similarity": 0.875}], "id": 4420, "stable_key": "clu_fe935467b50090bb", "ground_truth": {"modern_name": "Lucretius", "confidence": "high", "type": "person", "birth_year": -100, "death_year": -55, "description": "Roman philosopher and poet, author of De rerum natura.", "wikidata_id": "Q47154", "wikidata_description": "1st-century BC Roman poet and philosopher", "wikipedia_url": "https://en.wikipedia.org/wiki/Lucretius", "wikipedia_extract": "Titus Lucretius Carus ( TY-t\u0259s loo-KREE-sh\u0259s; Latin: [\u02c8tit\u028as l\u028a\u02c8kre\u02d0t\u026a.\u028as \u02c8ka\u02d0r\u028as]; c. 99 \u2013 October 15, 55 BC) was a Roman poet and philosopher. His only known work is the philosophical poem De rerum natura, a didactic work about the tenets and philosophy of Epicureanism, which usually is translated into English as On the Nature of Things\u2014and somewhat less often as On the Nature of the Universe. Very little is known about Lucretius's life; the only certainty is that he was either a friend or client of Gaius Memmius, to whom the poem was addressed and dedicated. De rerum natura was a considerable influence on the Augustan poets, particularly Virgil (in his Aeneid and Georgics, and to a lesser extent on the Eclogues) and Horace. The work was almost lost during the Middle Ages, but was rediscovered in 1417 in a monastery in Germany by Poggio Bracciolini."}}, {"canonical_name": "piedra de los ri\u00f1ones", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "stone_in_the_bladder", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "stone in the bladder", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["stone in the bladder"], "contexts": ["medical condition"]}, {"entity_id": "piedra_de_los_ri\u00f1ones", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "piedra de los ri\u00f1ones", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["piedra de los ri\u00f1ones"], "contexts": ["kidney stones"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "stone in the bladder", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "piedra de los ri\u00f1ones", "similarity": 0.897}], "id": 4421, "stable_key": "clu_9873717b362558bd", "ground_truth": {"modern_name": "Kidney stones", "confidence": "high", "type": "disease", "modern_term": "Nephrolithiasis", "wikidata_id": "Q18557037", "wikidata_description": "Human disease"}}, {"canonical_name": "Petronius", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "petronius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Petronius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Petronius"], "contexts": ["ancient source on glass malleability"]}, {"entity_id": "petronius", "book_id": "polyanthea_medicinal", "name": "Petronius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Petronius"], "contexts": ["cited author on French disease", "ancient authority on Gallic diseases"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Petronius", "target_book": "polyanthea_medicinal", "target_name": "Petronius", "similarity": 1.0}], "id": 4422, "stable_key": "clu_2a15371ce6b3dc9f", "ground_truth": {"modern_name": "Petronius", "confidence": "high", "type": "person", "description": "Roman author, likely Gaius Petronius Arbiter, cited for historical and scientific observations.", "wikidata_id": "Q47180", "wikidata_description": "1st century AD Roman courtier and author of the Satyricon (27\u201366)", "wikipedia_url": "https://en.wikipedia.org/wiki/Petronius", "wikipedia_extract": "Gaius Petronius Arbiter (; Classical Latin: [\u02c8\u0261a\u02d0.i.\u028as p\u025b\u02c8t\u032aro\u02d0.ni.\u028a\u02c8s ar.b\u026a.t\u032a\u025br]; c. 27 \u2013 c. 66 AD; sometimes Titus Petronius Niger) was a Roman courtier during the reign of Nero (r. 54\u201368). He is generally believed to be the author of the Satyricon, a satirical novel believed to have been written during the Neronian era. He is one of the most important characters in Henryk Sienkiewicz' historical novel Quo Vadis (1895)."}}, {"canonical_name": "nitreous", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "nitreous", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "nitreous", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nitreous"], "contexts": ["subterraneous veins"]}, {"entity_id": "nitrate", "book_id": "connexion_physical_sciences_somerville_1858", "name": "nitrate", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nitrate"], "contexts": ["prepared surfaces for pictures"]}, {"entity_id": "nitric_acid", "book_id": "connexion_physical_sciences_somerville_1858", "name": "nitric acid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nitric acid"], "contexts": ["acid containing copper or silver in solution"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "nitreous", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nitrate", "similarity": 0.892}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "nitreous", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nitric acid", "similarity": 0.905}], "id": 4423, "stable_key": "clu_e7998c56729f32e5-2", "ground_truth": {"modern_name": "Potassium nitrate", "confidence": "high", "type": "chemical", "wikidata_id": "Q177836", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Potassium%20nitrate", "note": "This cluster includes related terms like 'nitrous' and 'nitric acid', all pointing to compounds containing the nitrate ion.", "wikipedia_extract": "Potassium nitrate is a chemical compound with a sharp, salty, bitter taste and the chemical formula KNO3. It is a potassium salt of nitric acid. This salt consists of potassium cations K+ and nitrate anions NO\u22123, and is therefore an alkali metal nitrate. It occurs in nature as a mineral, niter (or nitre outside the United States). It is a source of nitrogen, and nitrogen was named after niter. Potassium nitrate is one of several nitrogen-containing compounds collectively referred to as saltpetre (or saltpeter in American English)."}}, {"canonical_name": "gumo", "category": "PLANT", "subcategory": "RESIN", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "gum", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Gum", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["Gum"], "contexts": ["viscous plant substance"]}, {"entity_id": "gumo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "gumo", "category": "PLANT", "subcategory": "RESIN", "count": 2, "variants": ["gumo"], "contexts": ["gum from Yuca has two parts", "sticky substance from plants"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gum", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "gumo", "similarity": 0.92}], "id": 4424, "stable_key": "clu_462b414699698af2-2", "ground_truth": {"modern_name": "Plant gums", "confidence": "high", "type": "plant", "note": "Refers to exudates from plants, often sticky and viscous, used in medicine and industry.", "wikidata_id": "Q424275", "wikidata_description": "viscous substance produced by nearly all plants and some microorganisms; in terms of science, a polar glycoprotein and exopolysaccharide", "wikipedia_url": "https://en.wikipedia.org/wiki/Resin", "wikipedia_extract": "A resin is a solid or highly viscous liquid that can be converted into a polymer. Resins may be biological or synthetic in origin, but are typically harvested from plants. Resins are mixtures of organic compounds insoluble in water, predominantly terpenes. Technically, resins should not be confused with gums, which consist predominantly of water-soluble polysaccharides, although these two terms are often interchangeable in the less formal context. Common resins include pine oleoresins, amber, hashish, frankincense, myrrh and the animal-derived resin, shellac. Resins are used in varnishes, adhesives, food additives, incenses and perfumes."}}, {"canonical_name": "Barbaria", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "barbaric", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Barbaric", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Barbaric"], "contexts": ["coast where coral grows"]}, {"entity_id": "barbaria", "book_id": "coloquios_da_orta_1563", "name": "Barbaria", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Barbaria"], "contexts": ["region from which gengivre comes", "region in Northeast Africa"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Barbaric", "target_book": "coloquios_da_orta_1563", "target_name": "Barbaria", "similarity": 0.942}], "id": 4425, "stable_key": "clu_3172dd973a979450-2", "ground_truth": {"modern_name": "Barbary Coast", "confidence": "high", "type": "place", "country": "Algeria, Libya, Morocco, Tunisia", "wikidata_id": "Q501768", "wikidata_description": "name used to designate the territory of the Barbary and going from Libya to Morocco", "wikipedia_url": "https://en.wikipedia.org/wiki/Barbary%20Coast", "wikipedia_extract": "The Barbary Coast (also Barbary, Berbery, or Berber Coast) were the coastal areas of central and western North Africa, more specifically, the Maghreb and the Ottoman borderlands consisting of the regencies in Algiers, Tunis, and Tripoli, as well as the Sultanate of Morocco from the 16th to 19th centuries. The term originates from an exonym for the Berbers. Barbary was not always a unified political entity. From the 16th century onward, it was divided into four political entities\u2014from west to east\u2014the Alawi Sultanate, the Regency of Algiers, the Regency of Tunis, and the Regency of Tripoli. Major rulers and petty monarchs during the times of the Barbary states' plundering parties included the sultan of Morocco, the dey of Algiers, bey of Tunis, and pasha of Tripoli, respectively. The slave trade was not just an economic lifeline to the Barbary States, but was often justified as a form of jihad against Christian states.", "note": "Refers to the historical coastal region of North Africa."}}, {"canonical_name": "smelting furnace", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "furnace", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "furnace", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["furnace"], "contexts": ["used to fire dishes"]}, {"entity_id": "smelting_furnace", "book_id": "kosmos_humboldt_1845", "name": "smelting furnace", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["smelting furnace"], "contexts": ["industrial furnace for melting ore", "furnace for metal extraction"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "furnace", "target_book": "kosmos_humboldt_1845", "target_name": "smelting furnace", "similarity": 0.923}], "id": 4426, "stable_key": "clu_9248d23d836fd0be-2", "ground_truth": {"modern_name": "furnaces", "confidence": "high", "type": "object", "wikidata_id": "", "wikidata_description": "family name", "note": "The context suggests a general furnace, with 'smelting furnace' being a specific type mentioned."}}, {"canonical_name": "beryl", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "beryl", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Beryl", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Beryl"], "contexts": ["gem"]}, {"entity_id": "beryl", "book_id": "connexion_physical_sciences_somerville_1858", "name": "beryl", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["beryl"], "contexts": ["negative crystal with two optic axes", "crystal with optical properties"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Beryl", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "beryl", "similarity": 0.976}], "id": 4427, "stable_key": "clu_f5830b1002c6a7c2-3", "ground_truth": {"modern_name": "beryl", "confidence": "high", "type": "mineral", "wikidata_id": "Q569", "wikidata_description": "chemical element with symbol Be and atomic number 4", "wikipedia_url": "https://en.wikipedia.org/wiki/Beryllium", "wikipedia_extract": "Beryl ( BERR-\u0259l) is a mineral composed of beryllium aluminium silicate with the chemical formula Be3Al2(SiO3)6. Well-known varieties of beryl include emerald and aquamarine. Naturally occurring  hexagonal crystals of beryl can be up to several meters in size, but terminated crystals are relatively rare. Pure beryl is colorless, but it is frequently tinted by impurities; possible colors are green, blue, yellow, pink, and red (the rarest). It is an ore source of beryllium. The word beryl \u2013 Middle English: beril \u2013 is borrowed, via Old French: beryl and Latin: beryllus, from Ancient Greek \u03b2\u03ae\u03c1\u03c5\u03bb\u03bb\u03bf\u03c2 b\u1e17ryllos, which referred to various blue-green stones, from Prakrit veru\u1e37iya, ve\u1e37uriya 'beryl' which is ultimately of Dravidian origin, maybe from the name of Belur or Velur, a town in Karnataka, southern India."}}, {"canonical_name": "vegetables", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "vegetables", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Vegetables", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Vegetables"], "contexts": ["plants"]}, {"entity_id": "vegetables", "book_id": "connexion_physical_sciences_somerville_1858", "name": "vegetables", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["vegetables"], "contexts": ["organisms with sap", "supply food for insects"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Vegetables", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "vegetables", "similarity": 0.973}], "id": 4428, "stable_key": "clu_02680b4bf4c59a87", "ground_truth": {"modern_name": "Vegetables", "confidence": "high", "type": "plant", "wikidata_id": "Q11004", "wikidata_description": "edible plant or part of a plant, involved in cooking"}}, {"canonical_name": "herbaceous Plant", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "herbaceous_plant", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "herbaceous Plant", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["herbaceous Plant"], "contexts": ["plant type for ginger"]}, {"entity_id": "herbaceous_plants", "book_id": "origin_of_species_darwin_1859", "name": "herbaceous plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["herbaceous plants"], "contexts": ["plants that grow from the ground annually"]}, {"entity_id": "herbaceous_forms", "book_id": "origin_of_species_darwin_1859", "name": "herbaceous forms", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["herbaceous forms"], "contexts": ["plant forms developed into trees"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "herbaceous Plant", "target_book": "origin_of_species_darwin_1859", "target_name": "herbaceous plants", "similarity": 0.95}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "herbaceous Plant", "target_book": "origin_of_species_darwin_1859", "target_name": "herbaceous forms", "similarity": 0.914}], "id": 4429, "stable_key": "clu_3e39d1a72b11b179", "ground_truth": {"modern_name": "herbaceous plant", "confidence": "high", "type": "plant", "wikidata_id": "Q190903", "wikidata_description": "plant which has no persistent woody stem above ground", "wikipedia_url": "https://en.wikipedia.org/wiki/Herbaceous%20plant", "wikipedia_extract": "Herbaceous plants are vascular plants that have no persistent woody stems above ground. This broad category of plants includes many perennials, and nearly all annuals and biennials. Definitions of \"herb\" and \"herbaceous\" The fourth edition of the Shorter Oxford English Dictionary defines \"herb\" as: \"A plant whose stem does not become woody and persistent (as in a tree or shrub) but remains soft and succulent, and dies (completely or down to the root) after flowering\"; \"A (freq. aromatic) plant used for flavouring or scent, in medicine, etc.\". (See: Herb) The same dictionary defines \"herbaceous\" as: \"Of the nature of a herb; esp. not forming a woody stem but dying down to the root each year\"; \"BOTANY Resembling a leaf in colour or texture."}}, {"canonical_name": "apple", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "apple", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Apple", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Apple"], "contexts": ["fruit from apple trees"]}, {"entity_id": "apple", "book_id": "origin_of_species_darwin_1859", "name": "apple", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["apple"], "contexts": ["tree host for missletoe", "fruit-bearing tree"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Apple", "target_book": "origin_of_species_darwin_1859", "target_name": "apple", "similarity": 0.98}], "id": 4430, "stable_key": "clu_8a787fe0ebf076c4", "ground_truth": {"modern_name": "apple", "confidence": "high", "type": "plant", "linnaean": "Malus domestica Borkh.", "family": "Rosaceae"}}, {"canonical_name": "Holly-trees", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "holly", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Holly", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Holly"], "contexts": ["evergreen tree"]}, {"entity_id": "holly-trees", "book_id": "origin_of_species_darwin_1859", "name": "Holly-trees", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["holly-trees", "Holly-trees"], "contexts": ["plant species with separate male and female individuals", "sexes of trees"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Holly", "target_book": "origin_of_species_darwin_1859", "target_name": "Holly-trees", "similarity": 0.941}], "id": 4431, "stable_key": "clu_2b5fde96a5165f13", "ground_truth": {"modern_name": "holly", "confidence": "high", "type": "plant", "linnaean": "Ilex aquifolium Linnaeus", "family": "Aquifoliaceae", "note": "The description of male and female individuals and evergreen nature strongly points to Ilex aquifolium.", "wikipedia_extract": "Charles Hardin Holley (September 7, 1936 \u2013 February 3, 1959), known professionally by his stage name Buddy Holly, was an American singer, songwriter, and musician who was a central and pioneering figure of rock and roll. He was born to a musical family in Lubbock, Texas, during the Great Depression, and learned to play guitar and sing alongside his two siblings. Holly made his first appearance on local television in 1952, and the following year he formed the group Buddy and Bob with his friend Bob Montgomery. In 1955, after opening once for Elvis Presley, Holly decided to pursue a career in music. He played with Presley three times that year, and his band's style shifted from country and western to rock and roll. In October that year, when Holly opened for Bill Haley & His Comets, he was spotted by Nashville scout Eddie Crandall, who helped him get a contract with Decca Records.", "wikipedia_url": "https://en.wikipedia.org/wiki/Buddy_Holly"}}, {"canonical_name": "Missel-thrush", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "missel_trush", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Missel Trush", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Missel Trush"], "contexts": ["kind of thrush that feeds on mistletoe"]}, {"entity_id": "missel-thrush", "book_id": "origin_of_species_darwin_1859", "name": "Missel-thrush", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["missel-thrush", "Missel-thrush"], "contexts": ["bird species"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Missel Trush", "target_book": "origin_of_species_darwin_1859", "target_name": "Missel-thrush", "similarity": 0.926}], "id": 4432, "stable_key": "clu_63824bf4ef24c04c", "ground_truth": {"modern_name": "Mistletoe thrush", "confidence": "high", "type": "animal", "wikipedia_extract": "Thrush (1902\u201313 December 1925) was a British Thoroughbred racehorse. He was trained by E. Robson and won fifteen of his twenty-two starts. His wins included the Great Foal Plate, Sussex Stakes, King's Stand Stakes and July Cup. Thrush was owned by Captain J. Orr-Ewing.", "wikipedia_url": "https://en.wikipedia.org/wiki/Thrush_(racehorse)"}}, {"canonical_name": "seal", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "seal", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Seal", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Seal"], "contexts": ["animal skin with protective quality"]}, {"entity_id": "seal", "book_id": "origin_of_species_darwin_1859", "name": "seal", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["seal"], "contexts": ["animal with flipper bones", "mammal with flippers"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Seal", "target_book": "origin_of_species_darwin_1859", "target_name": "seal", "similarity": 0.861}], "id": 4433, "stable_key": "clu_04d4ed60b7275b05", "ground_truth": {"modern_name": "Seal", "confidence": "high", "type": "animal", "wikidata_id": "Q162919", "wikidata_description": "mark of a personal distinctive emblem intended to guarantee the authenticity of the author of a document onto which it is printed, embossed or affixed", "wikipedia_url": "https://en.wikipedia.org/wiki/Seal%20%28emblem%29", "wikipedia_extract": "A seal is a device for making an impression in wax, clay, paper, or some other medium, including an embossment on paper, and is also the impression thus made. The original purpose was to authenticate a document, or to prevent interference with a package or envelope by applying a seal which had to be broken to open the container (hence the modern English verb \"to seal\", which implies secure closing without an actual wax seal). The seal-making device is also referred to as the seal matrix or die; the imprint it creates as the seal impression (or, more rarely, the sealing). If the impression is made purely as a relief resulting from the greater pressure on the paper where the high parts of the matrix touch, the seal is known as a dry seal; in other cases ink or another liquid or liquefied medium is used, in another color than the paper. In most traditional forms of dry seal the design on the seal matrix is in intaglio (cut below the flat surface) and therefore the design on the impressions made is in relief (raised above the surface). The design on the impression will reverse (be a mirror-image of) that of the matrix, which is especially important when script is included in the design, as it very often is."}}, {"canonical_name": "facultad animal", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "animal_faculties", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "animal faculties", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["animal faculties"], "contexts": ["disturbed by serpent bites"]}, {"entity_id": "facultad_animal", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "facultad animal", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["facultad animal"], "contexts": ["vital functions of the body", "animal faculty, possibly related to vital forces"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "animal faculties", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "facultad animal", "similarity": 0.886}], "id": 4434, "stable_key": "clu_b95d6f4bb619516b", "ground_truth": {"modern_name": "Animal faculties", "confidence": "high", "type": "concept"}}, {"canonical_name": "Pontifice", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pontificem", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Pontificem", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Pontificem"], "contexts": ["Pope"]}, {"entity_id": "pontifice", "book_id": "polyanthea_medicinal", "name": "Pontifice", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Pontifice", "Pontifices"], "contexts": ["title of a father of a patient", "pontiffs"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Pontificem", "target_book": "polyanthea_medicinal", "target_name": "Pontifice", "similarity": 0.914}], "id": 4435, "stable_key": "clu_1e5a6ee3add1dc91-2", "ground_truth": {"modern_name": "Pope", "confidence": "high", "type": "person", "description": "Head of the Catholic Church, associated with folk remedies", "wikidata_id": "Q25382", "wikidata_description": "species of bird", "wikipedia_url": "https://en.wikipedia.org/wiki/Eurasian%20bullfinch", "note": "The term 'Pontifice' (and its variations) could refer to the Pope or be used metaphorically for a paternal figure. Context is key.", "wikipedia_extract": "The Eurasian bullfinch, common bullfinch or bullfinch (Pyrrhula pyrrhula) is a small passerine bird in the finch family, Fringillidae. In Anglophone Europe it is known simply as the bullfinch (English regional, Shropshire: plum bird), as it is the original bird to bear the name bullfinch. The Eurasian bullfinch was formally described in 1758 by Linnaeus in the 10th edition of his Systema Naturae under the binomial name Loxia pyrrhula. It is now placed in the genus Pyrrhula that was introduced in 1760 by the French zoologist Mathurin Jacques Brisson. The Latin word pyrrhula comes from the Greek \u03c0\u03c5\u03c1\u03c1\u03cc\u03c2 (a flame-coloured bird, from \u03c0\u03c5\u03c1\u03c1\u03cc\u03c2 'flame-coloured', from \u03c0\u03c5\u03c1 'fire': Pyrrha), a 'worm eating bird' that is mentioned by Aristotle. The Latin name pyrrhula for the Eurasian bullfinch had been used in 1555 by the Swiss naturalist Conrad Gessner in his Historiae animalium."}}, {"canonical_name": "squirrels", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "squirrel", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Squirrel", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Squirrel"], "contexts": ["viviparous animal with clavicles"]}, {"entity_id": "squirrels", "book_id": "origin_of_species_darwin_1859", "name": "squirrels", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["squirrels"], "contexts": ["family of mammals with varying tail and skin structures", "rodent with specific structure"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Squirrel", "target_book": "origin_of_species_darwin_1859", "target_name": "squirrels", "similarity": 0.924}], "id": 4436, "stable_key": "clu_5af33790ae184a38", "ground_truth": {"modern_name": "Squirrel", "confidence": "high", "type": "animal", "wikidata_id": "Q1302028", "wikidata_description": "heraldic animal"}}, {"canonical_name": "Constantino", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "constantine", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Constantine", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Constantine"], "contexts": ["time period of Absyrtus"]}, {"entity_id": "constantino", "book_id": "coloquios_da_orta_1563", "name": "Constantino", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Constantino", "dom Constantino"], "contexts": ["founder of Constantinople", "viceroy who received plant"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Constantine", "target_book": "coloquios_da_orta_1563", "target_name": "Constantino", "similarity": 0.986}], "id": 4437, "stable_key": "clu_40fa9d584ecc21b9", "ground_truth": {"modern_name": "Constantine", "confidence": "high", "type": "person", "birth_year": 272, "death_year": 337, "description": "Roman Emperor and founder of Constantinople.", "note": "Refers to Constantine the Great.", "wikidata_id": "Q8413", "wikidata_description": "Roman emperor from 306 to 337 and first to convert to Christianity (272\u2013337)", "wikipedia_extract": "Constantine I (27 February 272 \u2013 22 May 337), also known as Constantine the Great, or known mononymously as Constantine, was Roman emperor from AD 306 to 337 and the first Roman emperor to convert to Christianity. He played a pivotal role in elevating the status of Christianity in Rome, the Edict of Milan decriminalising Christian practice and ceasing Christian persecution. This was a turning point in the Christianisation of the Roman Empire. He founded the city of Constantinople (now Istanbul) and made it the capital of the Empire, which it remained for over a millennium. Born in Naissus, a city located in the province of Moesia Superior (now Ni\u0161, Serbia), Constantine was the son of Flavius Constantius, a Roman army officer from Moesia Superior, who would become one of the four emperors of the Tetrarchy. His mother, Helena, was a woman of low birth, probably from Bithynia.", "wikipedia_url": "https://en.wikipedia.org/wiki/Constantine_the_Great"}}, {"canonical_name": "Heron", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "heron", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Heron", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Heron"], "contexts": ["long-legged wading bird"]}, {"entity_id": "heron", "book_id": "origin_of_species_darwin_1859", "name": "Heron", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["Heron", "heron"], "contexts": ["bird that might fly long distances", "bird eating seed"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Heron", "target_book": "origin_of_species_darwin_1859", "target_name": "Heron", "similarity": 1.0}], "id": 4438, "stable_key": "clu_ca943b750614fe09", "ground_truth": {"modern_name": "Heron", "confidence": "high", "type": "animal", "wikidata_id": "Q18789", "wikidata_description": "family of birds", "wikipedia_url": "https://en.wikipedia.org/wiki/Heron"}}, {"canonical_name": "Logique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "logic", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Logic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Logic"], "contexts": ["discipline governing valid inference"]}, {"entity_id": "logique", "book_id": "principles_of_psychology_james_1890", "name": "Logique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Logique"], "contexts": ["part of Renouvier's work", "publication on logic"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Logic", "target_book": "principles_of_psychology_james_1890", "target_name": "Logique", "similarity": 0.984}], "id": 4439, "stable_key": "clu_6f1f332833c6382c-3", "ground_truth": {"modern_name": "Logic", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "gaseous emanations", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "emanations", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "emanations", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["emanations"], "contexts": ["subtle outgoing substances"]}, {"entity_id": "gaseous_emanations", "book_id": "kosmos_humboldt_1845", "name": "gaseous emanations", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Gaseous Emanations", "gaseous emanations"], "contexts": ["release of gases from the Earth", "gases released from the interior"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "emanations", "target_book": "kosmos_humboldt_1845", "target_name": "gaseous emanations", "similarity": 0.895}], "id": 4440, "stable_key": "clu_2758578312e2f7dc", "ground_truth": {"modern_name": "Gaseous emissions", "confidence": "high", "type": "concept", "wikidata_id": "Q42089671", "wikidata_description": "scientific article published on September 1983"}}, {"canonical_name": "silkworm", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "silk-worms", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Silk-worms", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["Silk-worms"], "contexts": ["insects whose seed hatched on women"]}, {"entity_id": "silkworm", "book_id": "origin_of_species_darwin_1859", "name": "silkworm", "category": "ANIMAL", "subcategory": "INSECT", "count": 2, "variants": ["silkworm"], "contexts": ["larva of a moth producing silk", "larva producing silk"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Silk-worms", "target_book": "origin_of_species_darwin_1859", "target_name": "silkworm", "similarity": 0.944}], "id": 4441, "stable_key": "clu_b3d214ab40381691", "ground_truth": {"modern_name": "Silkworm", "confidence": "high", "type": "animal", "wikidata_id": "Q134747", "wikidata_description": "insect from the moth family", "wikipedia_url": "https://en.wikipedia.org/wiki/Bombyx_mori", "wikipedia_extract": "Bombyx mori, commonly known as the domestic silk moth, is a domesticated moth species belonging to the family Bombycidae. It is the closest relative of Bombyx mandarina, the wild silk moth. Silkworms are the larvae of silk moths. The silkworm is of particular economic value, being a primary producer of silk. The silkworm's preferred food are the leaves of white mulberry, though they may eat other species of mulberry, and even leaves of other plants. Domestic silk moths are entirely dependent on humans for reproduction, as a result of millennia of selective breeding."}}, {"canonical_name": "Swan", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "swan", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Swan", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Swan"], "contexts": ["form Jupiter took to beget Leda"]}, {"entity_id": "swan", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Swan", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["Swan"], "contexts": ["constellation where a new star was discovered", "vanishing star in the swan"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Swan", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Swan", "similarity": 1.0}], "id": 4442, "stable_key": "clu_c4bce4e24b99a403", "ground_truth": {"modern_name": "Swan", "confidence": "high", "type": "animal", "wikidata_id": "Q55829744", "wikidata_description": "genus of insects", "wikipedia_extract": "The mute swan (Cygnus olor) is a species of swan and a member of the waterfowl family Anatidae. It is native to much of Europe and parts of Asia and (as a rare winter visitor) the far north of Africa. It is an introduced species in North America, home to the largest populations outside of its native range, with additional smaller introductions in Australasia and Southern Africa. The name \"mute\" derives from it being less vocal than other swan species. Measuring 125 to 160 cm (49 to 63 in) in length, this large swan is wholly white in plumage, with an orange beak bordered with black. It is recognisable by its pronounced knob atop the beak, which is larger in males.", "wikipedia_url": "https://en.wikipedia.org/wiki/Mute_swan"}}, {"canonical_name": "Eternity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "eternity", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Eternity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Eternity"], "contexts": ["concept of endless time"]}, {"entity_id": "eternity", "book_id": "principles_of_psychology_james_1890", "name": "eternity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["eternity"], "contexts": ["infinite or unending time"]}, {"entity_id": "eternal", "book_id": "principles_of_psychology_james_1890", "name": "eternal", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["eternal"], "contexts": ["lasting forever"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Eternity", "target_book": "principles_of_psychology_james_1890", "target_name": "eternity", "similarity": 0.957}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Eternity", "target_book": "principles_of_psychology_james_1890", "target_name": "eternal", "similarity": 0.89}], "id": 4443, "stable_key": "clu_518ff5b57a5d1453", "ground_truth": {"modern_name": "Eternity", "confidence": "high", "type": "concept", "wikidata_id": "Q138045", "wikidata_description": "endless time, an infinite duration"}}, {"canonical_name": "vivacity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "vivacity", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "vivacity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vivacity"], "contexts": ["quality of being lively or energetic"]}, {"entity_id": "vivacity", "book_id": "first_principles_spencer_1862", "name": "vivacity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["vivacity"], "contexts": ["lively and animated state", "liveliness and energy"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "vivacity", "target_book": "first_principles_spencer_1862", "target_name": "vivacity", "similarity": 1.0}], "id": 4444, "stable_key": "clu_1bb8515afd515a06-2", "ground_truth": {"modern_name": "vitality", "confidence": "high", "type": "concept", "wikidata_id": "Q24702794", "wikidata_description": "French esports organisation", "wikipedia_url": "https://en.wikipedia.org/wiki/Team%20Vitality", "wikipedia_extract": "Team Vitality, or simply Vitality, is a French esport club founded in 2013 by Fabien \"Neo\" Devide, Nicolas Maurer, Corentin \"Gotaga\" Houssein, and Kevin \"BrokyBrawks\" Georges. Team Vitality has teams in eleven PC/console esports titles (League of Legends, Valorant, Counter-Strike 2, Rocket League, EA FC, StarCraft II, Tekken, Rennsport, Street Fighter 6, Call of Duty Warzone and Teamfight Tactics), with several professional teams and content creators from across Europe and South Korea. Vitality also has teams in four mobile esports titles (Mobile Legends: Bang Bang, Honor of Kings, Free Fire and PUBG Mobile) under the name \"Bigetron by Vitality\" after they acquired the Indonesian organization Bigetron Esports in 2025. The organization has previously fielded teams in numerous other titles, including Call of Duty, Call of Duty Mobile, Fortnite, Rainbow Six: Siege, PUBG, H1Z1, Clash Royale, Street Fighter, Formula 1, Hearthstone, Gears of War and Arena of Valor, as well as previously operating in India. Since 2019, the organization has made the Stade de France its training center, becoming the first resident club of the stadium. Team Vitality entered the professional League of Legends on 9 December 2015, after it acquired Gambit Gaming's spot in the 2016 EU LCS Spring Split."}}, {"canonical_name": "Hemorrhoi\u2223dal Veins", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "hemorrhoi\u2223dal_veins", "book_id": "english_physician_1652", "name": "Hemorrhoi\u2223dal Veins", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Hemorrhoi\u2223dal Veins", "Hemorrhoidal Veins"], "contexts": ["veins around the anus", "veins affected by bleeding"]}, {"entity_id": "arteria_veno\u017fa", "book_id": "polyanthea_medicinal", "name": "arteria veno\u017fa", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["arteria veno\u017fa"], "contexts": ["venous artery, a blood vessel"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Hemorrhoi\u2223dal Veins", "target_book": "polyanthea_medicinal", "target_name": "arteria veno\u017fa", "similarity": 0.904}], "id": 4445, "stable_key": "clu_16843c64abed0509", "ground_truth": {"modern_name": "hemorrhoidal veins", "confidence": "high", "type": "anatomy", "note": "The term 'arteria venosa' in this context likely refers to a vessel that carries venous blood but might have arterial-like characteristics or be part of the arterial system feeding the hemorrhoids. However, 'hemorrhoidal veins' is the most direct interpretation of the primary term."}}, {"canonical_name": "boar", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "boar", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Boar", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Boar"], "contexts": ["animal absent in Africa"]}, {"entity_id": "boar", "book_id": "origin_of_species_darwin_1859", "name": "boar", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["boar"], "contexts": ["example of sexual selection for defense", "animal with shoulder-pads"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Boar", "target_book": "origin_of_species_darwin_1859", "target_name": "boar", "similarity": 0.907}], "id": 4446, "stable_key": "clu_8e14846962f338c7-4", "ground_truth": {"modern_name": "Pigs", "confidence": "medium", "type": "animal", "note": "The term 'porcos' is clearly pigs. 'Porpoces' could refer to porpoises, and 'por\u00e7ovejos' is unclear but potentially a misspelling or regional term. However, the context of gall presence for medicinal use often involved domestic animals like pigs.", "wikidata_id": "Q58697", "wikidata_description": "omnivore species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Wild%20boar", "wikipedia_extract": "The wild boar (Sus scrofa), also known as the wild swine, common wild pig, Eurasian wild pig, or simply wild pig, is a suid native to much of Eurasia and North Africa, and has been introduced to the Americas and Oceania. The species is now one of the widest-ranging mammals in the world, as well as the most widespread suiform. It has been assessed as least concern on the IUCN Red List due to its wide range, high numbers, and adaptability to a diversity of habitats. It has become an invasive species in part of its introduced range. Wild boars probably originated in Southeast Asia during the Early Pleistocene and outcompeted other suid species as they spread throughout the Old World. As of 2005, up to 16 subspecies are recognized, which are divided into four regional groupings based on skull height and lacrimal bone length."}}, {"canonical_name": "living forms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "living_form", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "living form", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["living form"], "contexts": ["essential nature of a living being"]}, {"entity_id": "living_forms", "book_id": "first_principles_spencer_1862", "name": "living forms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["living forms"], "contexts": ["organisms with organizational capacity", "all biological organisms"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "living form", "target_book": "first_principles_spencer_1862", "target_name": "living forms", "similarity": 0.939}], "id": 4447, "stable_key": "clu_480572f11a5aa95c", "ground_truth": {"modern_name": "Living organisms", "confidence": "high", "type": "concept", "note": "While 'organic beings' can refer to animals specifically, in these contexts, it broadly encompasses all living entities.", "wikidata_id": "Q7239", "wikidata_description": "any individual living being or physical living system", "wikipedia_url": "https://en.wikipedia.org/wiki/Organism", "wikipedia_extract": "An organism is any living thing that functions as an individual. Such a definition raises more problems than it solves, not least because the concept of an individual is also difficult. Several criteria, few of which are widely accepted, have been proposed to define what constitutes an organism. Among the most common is that an organism has autonomous reproduction, growth, and metabolism. This would exclude viruses, even though they evolve like organisms. Other problematic cases include colonial organisms; a colony of eusocial insects is organised adaptively, and has germ-soma specialisation, with some insects reproducing, others not, like cells in an animal's body."}}, {"canonical_name": "pierre", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pierre", "book_id": "epoques_nature_buffon_1778", "name": "pierre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["pierre"], "contexts": ["material for comparison with marble", "general term for rock"]}, {"entity_id": "pierre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pierre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["pierre"], "contexts": ["material of discovered axes"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "pierre", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "pierre", "similarity": 1.0}], "id": 4448, "stable_key": "clu_b6084e143d97a14e", "ground_truth": {"modern_name": "Stone", "confidence": "high", "type": "mineral", "wikidata_id": "Q12803555", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Stone%20%28surname%29"}}, {"canonical_name": "mati\u00e8res fusibles", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mati\u00e8res_fusibles", "book_id": "epoques_nature_buffon_1778", "name": "mati\u00e8res fusibles", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["mati\u00e8res fusibles"], "contexts": ["materials that can be melted", "fusible materials"]}, {"entity_id": "mati\u00e8re_fusible", "book_id": "relation_historique_humboldt_vol3_1825", "name": "mati\u00e8re fusible", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["mati\u00e8re fusible"], "contexts": ["meltable substance"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "mati\u00e8res fusibles", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "mati\u00e8re fusible", "similarity": 0.905}], "id": 4449, "stable_key": "clu_9ce487d8ca29bb82", "ground_truth": {"modern_name": "Fusible materials", "confidence": "high", "type": "concept"}}, {"canonical_name": "Bailly", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "bailly", "book_id": "epoques_nature_buffon_1778", "name": "Bailly", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Bailly"], "contexts": ["demonstrated satellite orbits of Jupiter", "author of work on ancient astronomy"]}, {"entity_id": "bailly", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bailly", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bailly"], "contexts": ["historian of astronomy"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Bailly", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bailly", "similarity": 1.0}], "id": 4450, "stable_key": "clu_6b94be6e38096a26", "ground_truth": {"modern_name": "Nicolas Louis de Lacaille", "confidence": "medium", "type": "person", "birth_year": 1713, "death_year": 1762, "description": "French astronomer who mapped southern stars and observed Jupiter's moons.", "note": "While Bailly is mentioned, the context of demonstrating Jupiter's satellite orbits points strongly to Lacaille's work on Jupiter's moons, not to Jean-Sylvain Bailly's later astronomical history.", "wikidata_id": "Q59003750", "wikidata_description": "scholarly article published on March 1952"}}, {"canonical_name": "mines", "category": "SUBSTANCE", "su