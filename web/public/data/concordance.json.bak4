whose shields were found"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "infusoires", "target_book": "kosmos_humboldt_1845", "target_name": "infusoria", "similarity": 0.91}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "infusoire", "target_book": "kosmos_humboldt_1845", "target_name": "infusoria", "similarity": 0.946}], "id": 2911, "stable_key": "clu_c849a944bddab200", "ground_truth": {"modern_name": "Infusoria", "confidence": "high", "type": "animal", "note": "Historical term for microscopic, often ciliated, aquatic organisms, now largely superseded by protozoa, rotifers, etc.", "wikidata_id": "Q224920", "wikidata_description": "obsolete taxon", "wikipedia_url": "https://en.wikipedia.org/wiki/Infusoria"}}, {"canonical_name": "Marsupials", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "mammif\u00e8res", "book_id": "medecine_experimentale_bernard_1865", "name": "mammif\u00e8res", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["mammif\u00e8res"], "contexts": ["vertebrates with mammary glands", "animals studied for nerve properties"]}, {"entity_id": "marsupials", "book_id": "origin_of_species_darwin_1859", "name": "Marsupials", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 7, "variants": ["Marsupials", "marsupials"], "contexts": ["Australian pouched mammals", "living mammals of Australia"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "mammif\u00e8res", "target_book": "origin_of_species_darwin_1859", "target_name": "Marsupials", "similarity": 0.908}], "id": 2912, "stable_key": "clu_7b5f3f9bf511c49c", "ground_truth": {"modern_name": "Marsupial", "confidence": "high", "type": "animal", "note": "The term 'mammif\u00e8res' likely refers to a broader category including marsupials in the context of classification.", "wikidata_id": "Q685786", "wikidata_description": "species of m