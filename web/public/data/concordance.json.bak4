, "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["barometrical pressure"], "contexts": ["atmospheric condition affecting organs"]}, {"entity_id": "barometric_pressure", "book_id": "connexion_physical_sciences_somerville_1858", "name": "barometric pressure", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["barometric pressure"], "contexts": ["pressure exerted by the atmosphere", "pressure of the atmosphere"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "pression barom\u00e9trique", "target_book": "kosmos_humboldt_1845", "target_name": "barometrical pressure", "similarity": 0.924}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "pression barom\u00e9trique", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "barometric pressure", "similarity": 0.957}, {"source_book": "kosmos_humboldt_1845", "source_name": "barometrical pressure", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "barometric pressure", "similarity": 0.926}], "id": 1680, "stable_key": "clu_dec797a117eedc59", "ground_truth": {"modern_name": "barometric pressure", "confidence": "high", "type": "concept"}}, {"canonical_name": "autopsie", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "autopsie", "book_id": "medecine_experimentale_bernard_1865", "name": "autopsie", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["autopsie"], "contexts": ["examination of a body after death"]}, {"entity_id": "autopsia", "book_id": "coloquios_da_orta_1563", "name": "autopsia", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["autopsia"], "contexts": ["examination of a dead body"]}, {"entity_id": "autopsia", "book_id": "polyanthea_medicinal", "name": "autopsia", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["autopsia"], "contexts": ["autopsy", "examination of bodies"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "autopsie", "target_book": "coloquios_da_orta_1563", "target_name": "autopsia", "similarity": 0.994}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "autopsie", "target_book": "polyanthea_medicinal", "target_name": "autopsia", "similarity": 0.994}, {"source_book": "coloquios_da_orta_1563", "source_name": "autopsia", "target_book": "polyanthea_medicinal", "target_name": "autopsia", "similarity": 1.0}], "id": 1681, "stable_key": "clu_0617dd5d660b4fef", "ground_truth": {"wikipedia_extract": "Autopsia is a European art project focused on music and visual production, gathering authors of different professions in the realization of multimedia projects. Its art practice began in London in the late 1970s and continued during the 1980s in the former Yugoslavia. Since 1990, Autopsia has been based in Prague, Czech Republic. At the beginning of its activity, Autopsia issued dozens of mini-recordings. In the period after 1989, twenty CDs were issued, at first for Staalplaat, then for German label Hypnobeat and London's Gymnastic Records. One of its compositions is a part of the soundtrack for Peter Greenaway's The Pillow Book (1996)."}}, {"canonical_name": "pneumonie", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "pneumonie", "book_id": "medecine_experimentale_bernard_1865", "name": "pneumonie", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["pneumonie"], "contexts": ["inflammation of the lungs", "lung inflammation treated by bleeding"]}, {"entity_id": "pneumonia", "book_id": "polyanthea_medicinal", "name": "pneumonia", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["pneumonia", "Pulmonia"], "contexts": ["inflammation of the lungs", "pneumonia, an acute lung inflammation"]}, {"entity_id": "pneumonia", "book_id": "first_principles_spencer_1862", "name": "pneumonia", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["pneumonia"], "contexts": ["lung inflammation"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "pneumonie", "target_book": "polyanthea_medicinal", "target_name": "pneumonia", "similarity": 0.957}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "pneumonie", "target_book": "first_principles_spencer_1862", "target_name": "pneumonia", "similarity": 0.957}, {"source_book": "polyanthea_medicinal", "source_name": "pneumonia", "target_book": "first_principles_spencer_1862", "target_name": "pneumonia", "similarity": 1.0}], "id": 1682, "stable_key": "clu_6687ef1385275f94", "ground_truth": {"modern_name": "Pneumonia", "confidence": "high", "type": "disease", "modern_term": "Pneumonia", "wikidata_id": "Q32540", "wikidata_description": "disease in which an eosinophil, a type of white blood cell, accumulates in the lung", "wikipedia_url": "https://en.wikipedia.org/wiki/Eosinophilic%20pneumonia", "wikipedia_extract": "Pneumonia is an inflammatory condition of the lung primarily affecting the small air sacs known as alveoli. Symptoms typically include some combination of productive or dry cough, chest pain, fever, and difficulty breathing. The severity of the condition is variable. Pneumonia is usually caused by infection with viruses or bacteria, and less commonly by other microorganisms. Identifying the responsible pathogen can be difficult. Diagnosis is often based on symptoms and physical examination."}}, {"canonical_name": "zoologistes", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "zoologistes", "book_id": "medecine_experimentale_bernard_1865", "name": "zoologistes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["zoologistes"], "contexts": ["scientists studying animals", "experts in zoology"]}, {"entity_id": "zoologist", "book_id": "origin_of_species_darwin_1859", "name": "zoologist", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["zoologist"], "contexts": ["expert in animal classification"]}, {"entity_id": "zoologists", "book_id": "origin_of_species_darwin_1859", "name": "zoologists", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["zoologists"], "contexts": ["experts in animal classification"]}, {"entity_id": "zoologists", "book_id": "first_principles_spencer_1862", "name": "zoologists", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["zoologists"], "contexts": ["scientists studying animals"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "zoologistes", "target_book": "origin_of_species_darwin_1859", "target_name": "zoologist", "similarity": 0.893}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "zoologistes", "target_book": "origin_of_species_darwin_1859", "target_name": "zoologists", "similarity": 0.956}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "zoologistes", "target_book": "first_principles_spencer_1862", "target_name": "zoologists", "similarity": 0.956}, {"source_book": "origin_of_species_darwin_1859", "source_name": "zoologist", "target_book": "first_principles_spencer_1862", "target_name": "zoologists", "similarity": 0.929}, {"source_book": "origin_of_species_darwin_1859", "source_name": "zoologists", "target_book": "first_principles_spencer_1862", "target_name": "zoologists", "similarity": 1.0}], "id": 1683, "stable_key": "clu_b1a7cd301ceaf966", "ground_truth": {"modern_name": "Zoologist", "confidence": "high", "type": "person", "description": "Scientist specializing in the study of animals.", "wikipedia_extract": "Hisashi Abe (\u963f\u90e8 \u6c38, Abe Hisashi; born 1933) is a Japanese mammalogist and a former professor of Zoology at Hokkaido University Sapporo in Hokkaid\u014d, Japan. He has authored a variety of publications on the taxonomy of various mammal species endemic to East Asia. He was formerly the president of Mammal Society of Japan. Abe was born during 1933 in Yoshinogawa, Tokushima.", "wikipedia_url": "https://en.wikipedia.org/wiki/Hisashi_Abe"}}, {"canonical_name": "min\u00e9ralogie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "min\u00e9ralogie", "book_id": "medecine_experimentale_bernard_1865", "name": "min\u00e9ralogie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["min\u00e9ralogie"], "contexts": ["study of minerals", "science of minerals"]}, {"entity_id": "mineralogy", "book_id": "kosmos_humboldt_1845", "name": "mineralogy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mineralogy"], "contexts": ["study of minerals"]}, {"entity_id": "mineral\u00f3gica", "book_id": "coloquios_da_orta_1563", "name": "mineral\u00f3gica", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["mineral\u00f3gica", "mineralogie"], "contexts": ["study of minerals"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "min\u00e9ralogie", "target_book": "kosmos_humboldt_1845", "target_name": "mineralogy", "similarity": 0.907}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "min\u00e9ralogie", "target_book": "coloquios_da_orta_1563", "target_name": "mineral\u00f3gica", "similarity": 0.938}, {"source_book": "kosmos_humboldt_1845", "source_name": "mineralogy", "target_book": "coloquios_da_orta_1563", "target_name": "mineral\u00f3gica", "similarity": 0.926}], "id": 1684, "stable_key": "clu_08cc4591981f357c", "ground_truth": {"modern_name": "mineralogy", "confidence": "high", "type": "concept", "note": "The adjective 'mineralogical' refers to the field of study, mineralogy."}}, {"canonical_name": "carnivores", "category": "ANI