iples_of_psychology_james_1890", "source_name": "cerebral circulation", "target_book": "first_principles_spencer_1862", "target_name": "cerebral circulation", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Cerebral blood-supply", "target_book": "first_principles_spencer_1862", "target_name": "cerebral circulation", "similarity": 0.898}], "id": 3460, "stable_key": "clu_d7bc90572c644900", "ground_truth": {"modern_name": "cerebral circulation", "confidence": "high", "type": "concept"}}, {"canonical_name": "cognized", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "cognized", "book_id": "principles_of_psychology_james_1890", "name": "cognized", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["cognized"], "contexts": ["known or perceived", "perceived and understood"]}, {"entity_id": "cognize", "book_id": "principles_of_psychology_james_1890", "name": "cognize", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["cognize"], "contexts": ["to know or perceive", "process of gaining knowledge"]}, {"entity_id": "cognized", "book_id": "first_principles_spencer_1862", "name": "cognized", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["cognized"], "contexts": ["perceived or recognized", "process of becoming aware of something"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "cognized", "target_book": "first_principles_spencer_1862", "target_name": "cognized", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "cognize", "target_book": "first_principles_spencer_1862", "target_name": "cognized", "similarity": 0.88}], "id": 3461, "stable_key": "clu_2deccffb9da4d316-3", "ground_truth": {"modern_name": "cognition", "confidence": "high", "type": "concept", "wikidata_id": "Q3065932", "wikidata_description": "disease of mental health that affects cognitive functions including memory processing, perception and problem solving", "wikipedia_url": "https://en.wikipedia.org/wiki/Neurocognitive%20disorder", "note": "Early modern concepts of 'intellectual powers' encompassed reasoning, memory, perception, and understanding, aligning with modern cognitive science.", "wikipedia_extract": "Neurocognitive disorders (NCDs), also known as cognitive disorders (CDs), are a category of mental health disorders that primarily affect cognitive abilities including learning, memory, perception, and problem-solving. Neurocognitive disorders include delirium, mild neurocognitive disorders, and major neurocognitive disorder (also known as dementia). They are defined by deficits in cognitive ability that are acquired (as opposed to developmental), typically represent decline, and may have an underlying brain pathology. The DSM-5 defines six key domains of cognitive function: executive function, learning and memory, perceptual-motor function, language, complex attention, and social cognition. Although Alzheimer's disease accounts for the majority of cases of neurocognitive disorders, there are various medical conditions that affect mental functions such as memory, thinking, and the ability to reason, including frontotemporal degeneration, Huntington's disease, dementia with Lewy bodies, traumatic brain injury (TBI), Parkinson's disease, prion disease, and dementia/neurocognitive issues due to HIV infection. Neurocognitive disorders are diagnosed as mild and major based on the severity of their symptoms."}}, {"canonical_name": "nervous actions", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "nervous_processes", "book_id": "principles_of_psychology_james_1890", "name": "nervous processes", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["nervous processes"], "contexts": ["subtle processes involved in memory", "activities within the nervous system"]}, {"entity_id": "nerve-actions", "book_id": "principles_of_psychology_james_1890", "name": "nerve-actions", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nerve-actions"], "contexts": ["physiological processes in nerves"]}, {"entity_id": "nervous_actions", "book_id": "first_principles_spencer_1862", "name": "nervous actions", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["nervous actions"], "contexts": ["physiological processes of the nervous system", "physiological processes underlying mental life"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "nervous processes", "target_book": "first_principles_spencer_1862", "target_name": "nervous actions", "similarity": 0.909}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nerve-actions", "target_book": "first_principles_spencer_1862", "target_name": "nervous actions", "similarity": 0.951}], "id": 3462, "stable_key": "clu_b0959c38b50ab1d9", "ground_truth": {"modern_name": "nervous system activity", "confidence": "high", "type": "concept", "note": "Encompasses both physiological processes and electrical/chemical changes in nerves."}}, {"canonical_name": "Comptes Rendus de l'Acad. des Sciences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "comptes_rendus_de_l'acad__d__sciences", "book_id": "principles_of_psychology_james_1890", "name": "Comptes Rendus de l'Acad. d. Sciences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Comptes Rendus de l'Acad. d. Sciences"], "contexts": ["scientific journal of the Academy of Sciences"]}, {"entity_id": "comptes_rendus_de_l'acad__des_sciences", "book_id": "kosmos_humboldt_1845", "name": "Comptes Rendus de l'Acad. des Sciences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Comptes Rendus de l'Acad. des Sciences"], "contexts": ["proceedings of the Academy of Sciences", "publication referencing Lapland observations"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Comptes Rendus de l'Acad. d. Sciences", "target_book": "kosmos_humboldt_1845", "target_name": "Comptes Rendus de l'Acad. des Sciences", "similarity": 0.992}], "id": 3463, "stable_key": "clu_e79ffe71bd4f7aee", "ground_truth": {"modern_name": "Comptes Rendus de l'Acad\u00e9mie des Sciences", "confidence": "high", "type": "text", "wikidata_id": "Q21384991", "wikidata_description": "scientific journal"}}, {"canonical_name": "vibration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "vibration", "book_id": "principles_of_psychology_james_1890", "name": "vibration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vibration"], "contexts": ["rapid back-and-forth motion"]}, {"entity_id": "vibration", "book_id": "connexion_physical_sciences_somerville_1858", "name": "vibration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["vibration"], "contexts": ["oscillation of a string or body", "physical phenomenon studied"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "vibration", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "vibration", "similarity": 1.0}], "id": 3464, "stable_key": "clu_c105063439020540", "ground_truth": {"modern_name": "Vibration", "confidence": "high", "type": "concept", "wikidata_id": "Q3695508", "wikidata_description": "mechanical phenomenon whereby oscillations occur about an equilibrium point; precisely used to describe mechanical oscillation"}}, {"canonical_name": "musical notes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "musical_