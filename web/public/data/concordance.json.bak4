e8me philosophique", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "syst\u00e8me_philosophique", "book_id": "medecine_experimentale_bernard_1865", "name": "syst\u00e8me philosophique", "category": "CONCEPT", "subcategory": "THEORY", "count": 3, "variants": ["syst\u00e8me philosophique"], "contexts": ["philosophical framework", "framework of philosophical ideas"]}, {"entity_id": "philosophical_system", "book_id": "principles_of_psychology_james_1890", "name": "Philosophical System", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Philosophical System"], "contexts": ["book title"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "syst\u00e8me philosophique", "target_book": "principles_of_psychology_james_1890", "target_name": "Philosophical System", "similarity": 0.961}], "id": 3858, "stable_key": "clu_6c7a062cd572ed5f", "ground_truth": {"modern_name": "Philosophical system", "confidence": "high", "type": "concept", "wikidata_id": "Q5891", "wikidata_description": "study of the truths and principles of being, schools of thought, knowledge, or conduct", "wikipedia_url": "https://en.wikipedia.org/wiki/Philosophy"}}, {"canonical_name": "a posteriori", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "a_posteriori", "book_id": "medecine_experimentale_bernard_1865", "name": "a posteriori", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["a posteriori"], "contexts": ["based on experience and observation", "ideas derived from experience"]}, {"entity_id": "\u00e0_posteriori", "book_id": "first_principles_spencer_1862", "name": "\u00e0 posteriori", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["\u00e0 posteriori"], "contexts": ["philosophical term for 'from experience'", "based on experience or empirical evidence"