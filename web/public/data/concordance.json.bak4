ty_id": "mr__lyell", "book_id": "kosmos_humboldt_1845", "name": "Mr. Lyell", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Mr. Lyell"], "contexts": ["author of 'Principles of Geology'", "observer in America"]}, {"entity_id": "mr__lassell", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mr. Lassell", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Mr. Lassell"], "contexts": ["distinguished astronomer of Liverpool", "astronomer who made discoveries about Saturn"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Mr. Lyell", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mr. Lassell", "similarity": 0.881}], "id": 4192, "stable_key": "clu_9f197b248e0a368d-3", "ground_truth": {"modern_name": "Charles Lyell", "confidence": "high", "type": "person", "birth_year": 1797, "death_year": 1875, "description": "Scottish geologist, author of 'Principles of Geology'", "wikidata_id": "Q76126037", "wikidata_description": "Peerage person ID=549048", "note": "The text mentions both 'Mr. Lyell' and 'Mr. Lassell'. 'Mr. Lyell' is strongly associated with 'Principles of Geology', identifying Charles Lyell. 'Mr. Lassell' is likely William Lassell, an astronomer, as mentioned in the context of astronomy."}}, {"canonical_name": "calcareous spar", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "calcareous_spar", "book_id": "kosmos_humboldt_1845", "name": "calcareous spar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["calcareous spar"], "contexts": ["crystalline form of calcium carbonate", "crystalline body that expands and contracts"]}, {"entity_id": "calcareous_spar", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Calcareous spar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Calcareous spar", "calcareous spar"], "contexts": ["diamagnetic crystal, a form of calcite", "mineral retaining magnetic character at high temperature"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "calcareous spar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Calcareous spar", "similarity": 0.949}], "id": 4193, "stable_key": "clu_e5279b5171f6d651", "ground_truth": {"modern_name": "calcite", "confidence": "high", "type": "mineral"}}, {"canonical_name": "tropical zone", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "tropical_zone", "book_id": "kosmos_humboldt_1845", "name": "tropical zone", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["tropical zone"], "contexts": ["equatorial climate zone", "geographic region with frequent thunderstorms"]}, {"entity_id": "tropical_regions", "book_id": "first_principles_spencer_1862", "name": "tropical regions", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["tropical regions"], "contexts": ["areas near the equator with warm climate", "areas near the equator"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "tropical zone", "target_book": "first_principles_spencer_1862", "target_name": "tropical regions", "similarity": 0.935}], "id": 4194, "stable_key": "clu_64eba7a2fd8d9004-2", "ground_truth": {"modern_name": "Tropics", "confidence": "high", "type": "place", "country": "Global", "wikidata_id": "Q42530", "wikidata_description": "region of the Earth surrounding the equator", "wikipedia_url": "https://en.wikipedia.org/wiki/Tropics", "wikipedia_extract": "The tropics are the region of Earth surrounding the equator, where the Sun may shine directly overhead. This contrasts with the temperate or polar regions of Earth, where the Sun can never be directly overhead. Because of Earth's axial tilt, the width of the tropics (in latitude) is twice the tilt. The tropics are also referred to as the tropical zone and the torrid zone (see geographical zone). Due to the sun's high angle throughout the year, the tropics receive the most solar energy over the course of the year, and consequently have the highest temperatures on the planet. Even when not directly overhead, the sun is still close to overhead throughout the year, therefore the tropics also have the lowest seasonal variation on the planet; \"winter\" and \"summer\" lose their temperature contrast."}}, {"canonical_name": "negative electricity", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "negative_electricity", "book_id": "kosmos_humboldt_1845", "name": "negative electricity", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["negative electricity"], "contexts": ["type of electrical charge"]}, {"entity_id": "negative_electricity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Negative electricity", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Negative electricity", "negative electricity"], "contexts": ["type of electrical charge", "defined, mode of exciting"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "negative electricity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Negative electricity", "similarity": 0.991}], "id": 4195, "stable_key": "clu_222247566d528e1b", "ground_truth": {"modern_name": "Negative electric charge", "confidence": "high", "type": "concept", "note": "Refers to the type of electrical charge carried by electrons.", "wikipedia_extract": "In economics, negative pricing can occur when demand for a product drops or supply increases to an extent that owners or suppliers are prepared to pay others to accept it, in effect setting the price to a negative number. This can happen because it costs money to transport, store, and dispose of a product even when there is little demand to buy it, or because halting production would be more expensive than selling at a negative price. Negative prices are usual for waste such as garbage and nuclear waste. For example, a nuclear power plant may \"sell\" radioactive waste to a processing facility for a negative price; in other words, the power plant is paying the processing facility to take the unwanted radioactive waste. The phenomenon can also occur in energy prices, including electricity prices, natural gas prices, and oil prices. Natural gas prices in the Permian Basin, West Texas, went below zero for the first time in 2019.", "wikipedia_url": "https://en.wikipedia.org/wiki/Negative_pricing"}}, {"canonical_name": "Galle, Dr.", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "galle,_dr_", "book_id": "kosmos_humboldt_1845", "name": "Galle, Dr.", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 2, "variants": ["Galle, Dr."], "contexts": ["scientist mentioned", "medical practitioner"]}, {"entity_id": "dr__galle", "book_id": "kosmos_humboldt_1845", "name": "Dr. Galle", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Dr. Galle"], "contexts": ["discovered new planet"]}, {"entity_id": "dr__galle", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Dr. Galle", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["Dr. Galle"], "contexts": ["astronomer who found Neptune"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Galle, Dr.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Dr. Galle", "similarity": 0.93}, {"source_book": "kosmos_humboldt_1845", "source_name": "Dr. Galle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Dr. Galle", "similarity": 0.805}], "id": 4196, "stable_key": "clu_40b53c17cee68741", "ground_truth": {"modern_name": "Johann Galle", "confidence": "high", "type": "person", "birth_year": 1812, "death_year": 1910, "description": "German astronomer who discovered Neptune", "wikidata_id": "Q95219", "wikidata_description": "German historian"}}, {"canonical_name": "nebulous stars", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "nebulous_stars", "book_id": "kosmos_humboldt_1845", "name": "nebulous stars", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["nebulous stars"], "contexts": ["stars surrounded by nebulae", "stars appearing like nebulae"]}, {"entity_id": "nebulous_stars", "book_id": "connexion_physical_sciences_somerville_1858", "name": "nebulous stars", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["nebulous stars"], "contexts": ["stars appearing like nebulae", "celestial bodies with a hazy appearance"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "nebulous stars", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nebulous stars", "similarity": 1.0}], "id": 4197, "stable_key": "clu_c21ee176c963bc6b", "ground_truth": {"modern_name": "Nebulous stars", "confidence": "high", "type": "object"}}, {"canonical_name": "planetary nebulae", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "planetary_nebulae", "book_id": "kosmos_humboldt_1845", "name": "planetary nebulae", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["planetary nebulae"], "contexts": ["faintness of light", "celestial objects with faint light"]}, {"entity_id": "annular_nebula", "book_id": "connexion_physical_sciences_somerville_1858", "name": "annular nebula", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["annular nebula"], "contexts": ["nebula with diameter", "ring-shaped nebula"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name":