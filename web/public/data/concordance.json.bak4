round_truth": {"modern_name": "Divinity", "confidence": "high", "type": "concept"}}, {"canonical_name": "Bellonius", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "bellonius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Bellonius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Bellonius"], "contexts": ["informed about Rose of Jericho imposture", "inquisitive herbalist who traveled Jericho"]}, {"entity_id": "bellonius", "book_id": "english_physician_1652", "name": "Bellonius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bellonius"], "contexts": ["studied the nature of herbs"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bellonius", "target_book": "english_physician_1652", "target_name": "Bellonius", "similarity": 1.0}], "id": 3154, "stable_key": "clu_e10439eccf94c0e2", "ground_truth": {"modern_name": "Pierre Belon", "confidence": "high", "type": "person", "birth_year": 1517, "death_year": 1564, "description": "French naturalist and physician, studied anatomy and zoology.", "wikidata_id": "Q445560", "wikidata_description": "French traveler, naturalist, writer and diplomat (1517-1564)"}}, {"canonical_name": "Mahomet", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "mahomet", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mahomet", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 5, "variants": ["Mahomet"], "contexts": ["founder of Islam", "religious figure who forbade wine"]}, {"entity_id": "mahometans", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mahometans", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Mahometans"], "contexts": ["intentions and attempt by Mahometans"]}, {"entity_id": "mahom\u00e9tans", "book_id": "relation_historique_humboldt_vol3_1825", "name": "mahom\u00e9tans", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["mahom\u00e9tans"], "contexts": ["Mohammedans"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mahomet", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "mahom\u00e9tans", "similarity": 0.878}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mahometans", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "mahom\u00e9tans", "similarity": 0.873}], "id": 3155, "stable_key": "clu_05248e0fd8c5cc90", "ground_truth": {"modern_name": "Muhammad", "confidence": "high", "type": "person", "birth_year": 570, "death_year": 632, "description": "Founder of Islam, prophet of God."}}, {"canonical_name": "Air", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "air", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Air", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["air", "Air"], "contexts": ["gaseous substance", "medium for effluvium"]}, {"entity_id": "air", "book_id": "english_physician_1652", "name": "Air", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Air"], "contexts": ["corrected by burning rosemary", "nourishes bodies near the sea"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Air", "target_book": "english_physician_1652", "target_name": "Air", "similarity": 1.0}], "id": 3156, "stable_key": "clu_ef5cd6384b5e1753-2", "ground_truth": {"modern_name": "Air", "confidence": "high", "type": "chemical", "wikidata_id": "Q25299932", "wikidata_description": "island in Padang City, West Sumatra Province, Indonesia"}}, {"canonical_name": "Alder-Tree", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "alder", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Alder", "category": "PLANT", "subcategory": "TREE", "count": 3, "variants": ["Alder"], "contexts": ["wood used for small-coal", "tree used in gunpowder composition"]}, {"entity_id": "alder-tree", "book_id": "english_physician_1652", "name": "Alder-Tree", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Alder-Tree", "Elder-Tree"], "contexts": ["tree with similar leaves", "plant with cooling, drying, binding properties"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Alder", "target_book": "english_physician_1652", "target_name": "Alder-Tree", "similarity": 0.889}], "id": 3157, "stable_key": "clu_d519dfdbc22b8d4b", "ground_truth": {"modern_name": "Alder", "confidence": "high", "type": "plant", "linnaean": "Alnus glutinosa Linnaeus", "family": "Betulaceae", "wikidata_id": "Q25440698", "wikidata_description": "botanical natural monument in Cherkasy Oblast, Ukraine"}}, {"canonical_name": "Camerarius", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "camerarius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Camerarius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Camerarius"], "contexts": ["scholar who defended Herodotus"]}, {"entity_id": "camerarius", "book_id": "english_physician_1652", "name": "Camerarius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Camerarius", "Cameravius"], "contexts": ["cited for remedy", "scholar who noted use of Meadow Rue for Jaundice"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Camerarius", "target_book": "english_physician_1652", "target_name": "Camerarius", "similarity": 1.0}], "id": 3158, "stable_key": "clu_98ba6c71c3ae3857", "ground_truth": {"modern_name": "Joachim Camerarius", "confidence": "high", "type": "person", "birth_year": 1500, "death_year": 1574, "description": "German humanist scholar, physician, and botanist.", "note": "There were multiple scholars named Camerarius. Joachim Camerarius the Younger (1534-1598) was also a physician and botanist. The citations suggest a historical figure associated with botanical knowledge and remedies.", "wikidata_id": "Q71261", "wikidata_description": "German scientist (1534-1598)", "wikipedia_url": "https://en.wikipedia.org/wiki/Joachim%20Camerarius%20the%20Younger", "wikipedia_extract": "Joachim Camerarius (12 April 1500 \u2013 17 April 1574), the Elder, was a German classical scholar. His critical abilities, his deep understanding of Greek and Latin, and his wide-ranging knowledge of the ancient world made him one of the foremost German scholars of his time. Camerarius was born in Bamberg, in the Prince-Bishopric of Bamberg. His family name was Liebhard, but he was generally called Kammermeister, previous members of his family having held the office of chamberlain (camerarius) to the bishops of Bamberg. He studied at Leipzig, Erfurt and Wittenberg, where he became a student and friend of Philipp Melanchthon. For some years he was teacher of history and Greek at the gymnasium in Nuremberg (\u00c4gidiengymnasium)."}}, {"canonical_name": "diameters", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "diameter", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Diameter", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Diameter"], "contexts": ["straight line passing through circle's center"]}, {"entity_id": "circumference", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "circumference", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["circumference"], "contexts": ["boundary of a circle"]}, {"entity_id": "diameters", "book_id": "connexion_physical_sciences_somerville_1858", "name": "diameters", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["Diameters", "diameters"], "contexts": ["straight line passing through the center", "lines through the center of a shape"]}, {"entity_id": "circumference", "book_id": "connexion_physical_sciences_somerville_1858", "name": "circumference", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["circumference"], "contexts": ["outer boundary of a circle or sphere", "distance around a circular object"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Diameter", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "diameters", "similarity": 0.939}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Diameter", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "circumference", "similarity": 0.903}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "circumference", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "diameters", "similarity": 0.884}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "circumference", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "circumference", "similarity": 1.0}], "id": 3159, "stable_key": "clu_b20770b75698451a", "ground_truth": {"modern_name": "Diameter", "confidence": "high", "type": "concept", "note": "This cluster refers to geometrical concepts rather than a specific substance or anatomical part. The context of 'boundary of a circle' and 'straight line passing through the center' points to the geometric definition of a diameter and circumference."}}, {"canonical_name": "pole", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "poles", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "poles", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["poles"], "contexts": ["Earth's magnetic poles"]}, {"entity_id": "pole", "book_id": "connexion_physical_sciences_somerville_1858", "name": "pole", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 6, "variants": ["pole"], "contexts": ["geographic extremity of the earth", "northernmost point of Earth's axis"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "poles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "pole", "similarity": 0.938}], "id": 3160, "stable_key": "clu_f51de4c710633306", "ground_truth": {"modern_name": "Pole", "confidence": "high", "type": "concept", "note": "The contexts 'Earth's magnetic poles' and 'geographic extremity of the earth' refer to the concept of poles, both geographic and magnetic, rather than a physical object or substance."}}, {"canonical_name": "silk", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "silk", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Silk", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Silk"], "contexts": ["natural fiber"]}, {"entity_id": "silk", "book_id": "connexion_physical_sciences_somerville_1858", "name": "silk", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["silk"], "contexts": ["fabric with light reflecting properties", "material used for rubbing glass"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Silk", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "silk", "similarity": 0.949}], "id": 3161, "stable_key": "clu_9ee27f59abb0c03c", "ground_truth": {"modern_name": "silk", "confidence": "medium", "type": "substance", "note": "The Portuguese 'sedas' directly means 'silks'. The Spanish 'sedago' is less clear but could be a corruption or a related textile term. Given the context of trade at Ormuz, silk is a highly probable commodity.", "wikidata_id": "Q134747", "wikidata_description": "insect from the moth family", "wikipedia_extract": "Bombyx mori, commonly known as the domestic silk moth, is a domesticated moth species belonging to the family Bombycidae. It is the closest relative of Bombyx mandarina, the wild silk moth. Silkworms are the larvae of silk moths. The silkworm is of particular economic value, being a primary producer of silk. The silkworm's preferred food are the leaves of white mulberry, though they may eat other species of mulberry, and even leaves of other plants. Domestic silk moths are entirely dependent on humans for reproduction, as a result of millennia of selective breeding.", "wikipedia_url": "https://en.wikipedia.org/wiki/Bombyx_mori", "description": "A natural protein fiber produced by certain insect larvae, spun into a soft, lustrous textile."}}, {"canonical_name": "Bee", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "bee", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Bee", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["Bee"], "contexts": ["insect found in amber"]}, {"entity_id": "bee", "book_id": "origin_of_species_darwin_1859", "name": "Bee", "category": "ANIMAL", "subcategory": "INSECT", "count": 6, "variants": ["bee", "Bee"], "contexts": ["social insect that makes honey", "insect with a stinging tail"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bee", "target_book": "origin_of_species_darwin_1859", "target_name": "Bee", "similarity": 1.0}], "id": 3162, "stable_key": "clu_70974a96653b749d-2", "ground_truth": {"modern_name": "Bees", "confidence": "high", "type": "animal", "description": "Social insects known for honey production and pollination.", "wikipedia_extract": "Bees are winged insects that form a monophyletic clade Anthophila within the superfamily Apoidea of the order Hymenoptera, with over 20,000 known species in seven recognized families. Some species \u2013 including honey bees, bumblebees, and stingless bees \u2013 are social insects living in highly hierarchical colonies, while over 90% of bee species \u2013 including mason bees, carpenter bees, leafcutter bees, and sweat bees \u2013 are solitary. Members of the most well-known bee genus, Apis (i.e. honey bees), are known to construct hexagonally celled waxy nests called hives. Unlike the closely related wasps and ants, who are carnivorous/omnivorous, bees are herbivores that specifically feed on nectar (nectarivory) and pollen (palynivory), the former primarily as a carbohydrate source for metabolic energy, and the latter primarily for protein and other nutrients for their larvae. They are found on every continent except Antarctica, and in every habitat on the planet that contains insect-pollinated flowering plants. The most common bees in the Northern Hemisphere are the Halictidae, or sweat bees, but they are small and often mistaken for wasps or flies."}}, {"canonical_name": "Parsnip", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "parsnips", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Parsnips", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Parsnips"], "contexts": ["vegetable plant"]}, {"entity_id": "parsnip", "book_id": "english_physician_1652", "name": "Parsnip", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["Parsnip", "Parsnep", "Parsnips"], "contexts": ["root mistaken for Hemlock root", "root vegetable for comparison"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Parsnips", "target_book": "english_physician_1652", "target_name": "Parsnip", "similarity": 0.962}], "id": 3163, "stable_key": "clu_8bf7f40a7dc5ac42", "ground_truth": {"modern_name": "Parsnip", "confidence": "high", "type": "plant", "linnaean": "Pastinaca sativa Linnaeus", "family": "Apiaceae", "note": "The text mentions mistaking its root for Hemlock, a known confusion between similar-looking plants.", "wikidata_id": "Q1479657", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Heracleum_maximum", "wikipedia_extract": "Heracleum maximum, commonly known as cow parsnip, is the only member of the genus Heracleum native to North America. It is also known as American cow-parsnip, Satan celery, Indian celery, Indian rhubarb, poison turnip or pushki. Cow parsnip is a tall herbaceous perennial plant, reaching heights of 3 metres (10 feet). The stems are hollow and densely hairy. The leaves are very large, up to 40 centimetres (16 inches) across and divided into three lobes. Cow parsnip has the characteristic flower umbels of the carrot family (Apiaceae), blooming from February to September."}}, {"canonical_name": "Meteorology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "meteorology", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Meteorology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Meteorology"], "contexts": ["study of weather phenomena"]}, {"entity_id": "meteorology", "book_id": "kosmos_humboldt_1845", "name": "Meteorology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["Meteorology", "meteorology"], "contexts": ["study of atmospheric phenomena", "science dealing with the atmosphere"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Meteorology", "target_book": "kosmos_humboldt_1845", "target_name": "Meteorology", "similarity": 1.0}], "id": 3164, "stable_key": "clu_101df4218b7bae46-3", "ground_truth": {"modern_name": "Meteorology", "confidence": "high", "type": "concept", "wikidata_id": "Q25261", "wikidata_description": "branch of science dealing with the study of atmospheric phenomena and the short term variation of weather conditions including wind, precipitation, temperature, humidity, cloud cover, and air pressure", "wikipedia_url": "https://en.wikipedia.org/wiki/Meteorology", "note": "Refers to Aristotle's work on atmospheric phenomena.", "wikipedia_extract": "Meteorology is the scientific study of the Earth's atmosphere and short-term atmospheric phenomena (i.e., weather), with a focus on weather forecasting. It has applications in the military, aviation, energy production, transport, agriculture, construction, weather warnings, and disaster management. Along with climatology, atmospheric physics, atmospheric chemistry, and aeronomy, meteorology forms the broader field of the atmospheric sciences. The interactions between Earth's atmosphere and its oceans (notably El Ni\u00f1o and La Ni\u00f1a) are studied in the interdisciplinary field of hydrometeorology. Other interdisciplinary areas include biometeorology, space weather, and planetary meteorology. Marine weather forecasting relates meteorology to maritime and coastal safety, based on atmospheric interactions with large bodies of water."}}, {"canonical_name": "schistes", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "schistes", "book_id": "epoques_nature_buffon_1778", "name": "schistes", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["schistes"], "contexts": ["fine-grained metamorphic rock", "rock type for secondary mines"]}, {"entity_id": "schistes_calcif\u00e9res", "book_id": "relation_historique_humboldt_vol3_1825", "name": "schistes calcif\u00e9res", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["schistes calcif\u00e9res"], "contexts": ["calcareous schist type"]}, {"entity_id": "schistes_calcarif\u00e9res", "book_id": "relation_historique_humboldt_vol3_1825", "name": "schistes calcarif\u00e9res", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["schistes calcarif\u00e9res"], "contexts": ["calcareous schist rock type"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "schistes", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "schistes calcif\u00e9res", "similarity": 0.881}, {"source_book": "epoques_nature_buffon_1778", "source_name": "schistes", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "schistes calcarif\u00e9res", "similarity": 0.889}], "id": 3165, "stable_key": "clu_16b9c806e4c106f8", "ground_truth": {"modern_name": "Schist", "confidence": "high", "type": "mineral", "note": " 'Schistes' refers to a group of metamorphic rocks. 'Schistes calcif\u00e8res' and 'schistes calcarif\u00e8res' are specific types containing calcium carbonate.", "wikidata_id": "Q281634", "wikidata_description": "species of insect", "wikipedia_url": "https://en.wikipedia.org/wiki/Desert%20locust"}}, {"canonical_name": "crustac\u00e9s", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "crustac\u00e9s", "book_id": "epoques_nature_buffon_1778", "name": "crustac\u00e9s", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["crustac\u00e9s"], "contexts": ["crustaceans", "head of crustaceans"]}, {"entity_id": "crustacean", "book_id": "origin_of_species_darwin_1859", "name": "crustacean", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["crustacean"], "contexts": ["type of arthropod, ancestor of trilobites", "type of arthropod, including barnacles"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "crustac\u00e9s", "target_book": "origin_of_species_darwin_1859", "target_name": "crustacean", "similarity": 0.956}], "id": 3166, "stable_key": "clu_fc17ae855f902eef-2", "ground_truth": {"modern_name": "Crustaceans", "confidence": "high", "type": "animal", "note": "The mention of 'cet\u00e1ceos' (cetaceans) in the context of Garcia de Orta's Colloquios is likely a misidentification or OCR error, as 'cet\u00e1ceos' refers to whales and dolphins, not crustaceans. The dominant theme points to crustaceans.", "wikidata_id": "Q25364", "wikidata_description": "subphylum of arthropods", "wikipedia_url": "https://en.wikipedia.org/wiki/Crustacean", "wikipedia_extract": "Crustaceans (from Latin word \"crustacea\" meaning: \"those with shells\" or \"crusted ones\") are invertebrate animals that constitute one group of arthropods that are traditionally a part of the subphylum Crustacea (), a large, diverse group of mainly aquatic arthropods including the more familiar decapods (shrimps, prawns, crabs, lobsters and crayfish), seed shrimps, branchiopods, fish lice, krill, remipedes, isopods, barnacles, copepods, opossum shrimps, amphipods and mantis shrimp. The crustacean group can be treated as a subphylum under the clade Mandibulata. It is now well accepted that the hexapods (insects and entognathans) emerged deep in the crustacean group, with the completed pan-group referred to as Pancrustacea. The three classes Cephalocarida, Branchiopoda and Remipedia are more closely related to the hexapods than they are to any of the other crustaceans (oligostracans and multicrustaceans). The 67,000 described species range in size from Stygotantulus stocki at 0.1 mm (0.004 in), to the Japanese spider crab with a leg span of up to 3.8 m (12.5 ft) and a mass of 20 kg (44 lb). Like other arthropods, crustaceans have an exoskeleton, which they moult to grow."}}, {"canonical_name": "Atlantide", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "atlantide", "book_id": "epoques_nature_buffon_1778", "name": "Atlantide", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Atlantide"], "contexts": ["legendary land west of Spain", "mythical land of submersion"]}, {"entity_id": "atlantis", "book_id": "kosmos_humboldt_1845", "name": "Atlantis", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Atlantis"], "contexts": ["mythical land connecting Europe and North America", "fabled lost continent"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Atlantide", "target_book": "kosmos_humboldt_1845", "target_name": "Atlantis", "similarity": 0.933}], "id": 3167, "stable_key": "clu_43538bf26b89c3d3", "ground_truth": {"modern_name": "Atlantis", "confidence": "high", "type": "place", "country": "Mythical", "wikidata_id": "Q5710888", "wikidata_description": "genus of insects"}}, {"canonical_name": "formations calcaires", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "substances_calcaires", "book_id": "epoques_nature_buffon_1778", "name": "substances calcaires", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["substances calcaires"], "contexts": ["calcareous materials, a type of calcinable substance", "lime-containing materials in earth layers"]}, {"entity_id": "masses_calcaires", "book_id": "epoques_nature_buffon_1778", "name": "masses calcaires", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["masses calcaires"], "contexts": ["calcareous masses"]}, {"entity_id": "formations_calcaires", "book_id": "relation_historique_humboldt_vol3_1825", "name": "formations calcaires", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["formations calcaires"], "contexts": ["rock type", "appearance of calcareous formations"]}, {"entity_id": "formation_calcaire", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Formation calcaire", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Formation calcaire"], "contexts": ["geological formation"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "substances calcaires", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "formations calcaires", "similarity": 0.94}, {"source_