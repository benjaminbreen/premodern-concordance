contexts": ["crystalline rock type"]}, {"entity_id": "crystalline_rock", "book_id": "kosmos_humboldt_1845", "name": "crystalline rock", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["crystalline rock"], "contexts": ["rock forming volcano structure"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "roches cristallines", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "roches cristallines", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "roches cristallines", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "roche cristalline", "similarity": 0.98}, {"source_book": "epoques_nature_buffon_1778", "source_name": "roches cristallines", "target_book": "kosmos_humboldt_1845", "target_name": "crystalline rock", "similarity": 0.924}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "roches cristallines", "target_book": "kosmos_humboldt_1845", "target_name": "crystalline rock", "similarity": 0.924}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "roche cristalline", "target_book": "kosmos_humboldt_1845", "target_name": "crystalline rock", "similarity": 0.915}], "id": 1605, "stable_key": "clu_41b7851134ee5dbd", "ground_truth": {"modern_name": "Crystalline rocks", "confidence": "high", "type": "mineral", "wikidata_id": "Q5416295", "wikidata_description": "a type of rock"}}, {"canonical_name": "P\u00e9tersbourg", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "p\u00e9tersbourg", "book_id": "epoques_nature_buffon_1778", "name": "P\u00e9tersbourg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["P\u00e9tersbourg"], "contexts": ["city where map was engraved"]}, {"entity_id": "p\u00e9tersbourg", "book_id": "relation_historique_humboldt_vol3_1825", "name": "P\u00e9tersbourg", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["P\u00e9tersbourg"], "contexts": ["city in Russia", "to Petersburg"]}, {"entity_id": "st__p\u00e9tersbourg", "book_id": "kosmos_humboldt_1845", "name": "St. P\u00e9tersbourg", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["St. P\u00e9tersbourg"], "contexts": ["city of the Academy", "city of imperial academy"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "P\u00e9tersbourg", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "P\u00e9tersbourg", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "P\u00e9tersbourg", "target_book": "kosmos_humboldt_1845", "target_name": "St. P\u00e9tersbourg", "similarity": 0.941}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "P\u00e9tersbourg", "target_book": "kosmos_humboldt_1845", "target_name": "St. P\u00e9tersbourg", "similarity": 0.941}], "id": 1606, "stable_key": "clu_f65d918a6f72a573-2", "ground_truth": {"modern_name": "Saint Petersburg", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q656", "wikidata_description": "federal city and former capital of Russia", "wikipedia_url": "https://en.wikipedia.org/wiki/Saint%20Petersburg", "wikipedia_extract": "Saint Petersburg, formerly known as Petrograd (\u041f\u0435\u0442\u0440\u043e\u0433\u0440\u0430\u0434) and later Leningrad (\u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434), is the second-largest city in Russia, after Moscow, the nation's capital. It is situated on the River Neva, at the head of the Gulf of Finland on the Baltic Sea. With an area of 1,439 square kilometers (556 square miles), Saint Petersburg is the smallest administrative division of Russia by area. The city had a population of 5,601,911 residents as of 2021, with more than 6.4 million people living in the metropolitan area. Saint Petersburg is the fourth-most populous city in Europe, the most populous city on the Baltic Sea, and the world's northernmost city of more than 1 million residents. As the former capital of the Russian Empire, and a historically strategic port, it is governed as a federal city."}}, {"canonical_name": "putrefaction", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "putrefaction", "book_id": "english_physician_1652", "name": "putrefaction", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["putrefaction", "putrefaction of the Blood", "putresaction"], "contexts": ["condition treated by the herb", "causing evil smell from gums"]}, {"entity_id": "putrefacion", "book_id": "historia_medicinal_monardes_1574", "name": "putrefacion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["putrefacion"], "contexts": ["process of decay"]}, {"entity_id": "putrefa\u00e7\u00e3o", "book_id": "coloquios_da_orta_1563", "name": "putrefa\u00e7\u00e3o", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["putrefa\u00e7\u00e3o"], "contexts": ["decomposition or decay"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "putrefaction", "target_book": "historia_medicinal_monardes_1574", "target_name": "putrefacion", "similarity": 0.918}, {"source_book": "english_physician_1652", "source_name": "putrefaction", "target_book": "coloquios_da_orta_1563", "target_name": "putrefa\u00e7\u00e3o", "similarity": 0.915}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "putrefacion", "target_book": "coloquios_da_orta_1563", "target_name": "putrefa\u00e7\u00e3o", "similarity": 0.957}], "id": 1607, "stable_key": "clu_2b7d737988c9e91c", "ground_truth": {"modern_name": "putrefaction", "confidence": "high", "type": "disease", "modern_term": "putrefaction", "wikidata_id": "Q671701", "wikidata_description": "breaking down of a body of a human or animal post-mortem", "wikipedia_url": "https://en.wikipedia.org/wiki/Putrefaction", "wikipedia_extract": "Putrefaction is the fifth stage of death, following pallor mortis, livor mortis, algor mortis, and rigor mortis. This process references the breaking down of a body of an animal post-mortem. In broad terms, it can be viewed as the decomposition of proteins, and the eventual breakdown of the cohesiveness between tissues, and the liquefaction of most organs. This is caused by the decomposition of organic matter by bacterial or fungal digestion, which causes the release of gases that infiltrate the body's tissues, and leads to the deterioration of the tissues and organs. The approximate time it takes putrefaction to occur is dependent on various factors. Internal factors that affect the rate of putrefaction include the age at which death has occurred, the overall structure and condition of the body, the cause of death, and external injuries arising before or after death."}}, {"canonical_name": "Gerard", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "gerard", "book_id": "english_physician_1652", "name": "Gerard", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Gerard", "Gerhard"], "contexts": ["English author on herbs", "mentioned as a source for plant lore"]}, {"entity_id": "gerards", "book_id": "english_physician_1652", "name": "Gerards", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Gerards"], "contexts": ["author of an herbal"]}, {"entity_id": "gerard", "book_id": "kosmos_humboldt_1845", "name": "Gerard", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Gerard"], "contexts": ["provided data on mountain elevations"]}, {"entity_id": "gerardo", "book_id": "polyanthea_medicinal", "name": "Gerardo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Gerardo"], "contexts": ["learned author"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Gerard", "target_book": "kosmos_humboldt_1845", "target_name": "Gerard", "similarity": 0.737}, {"source_book": "english_physician_1652", "source_name": "Gerards", "target_book": "kosmos_humboldt_1845", "target_name": "Gerard", "similarity": 0.842}, {"source_book": "kosmos_humboldt_1845", "source_name": "Gerard", "target_book": "polyanthea_medicinal", "target_name": "Gerardo", "similarity": 0.973}], "id": 1608, "stable_key": "clu_1a9f62d05a506681", "ground_truth": {"modern_name": "John Gerard", "confidence": "high", "type": "person", "birth_year": 1545, "death_year": 1612, "description": "English herbalist and author of 'Herball'", "note": "Multiple individuals named Gerard could be referenced, but John Gerard's fame as an herbalist makes him the most likely referent in medical contexts.", "wikidata_id": "Q75765559", "wikidata_description": "Peerage person ID=322663"}}, {"canonical_name": "Colds", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "colds", "book_id": "english_physician_1652", "name": "Colds", "category": "DISEASE", "subcategory": "ACUTE", "count": 3, "variants": ["Colds"], "contexts": ["respiratory infection", "common respiratory illness"]}, {"entity_id": "resfriado", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "resfriado", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["resfriado"], "contexts": ["common cold"]}, {"entity_id": "colds", "book_id": "first_principles_spencer_1862", "name": "colds", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["colds"], "contexts": ["common respiratory illness"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Colds", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "resfriado", "similarity": 0.899}, {"source_book": "english_physician_1652", "source_name": "Colds", "target_book": "first_principles_spencer_1862", "target_name": "colds", "similarity": 0.989}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "resfriado", "target_book": "first_principles_spencer_1862", "target_name": "colds", "similarity": 0.919}], "id": 1609, "stable_key": "clu_76832e712c10b888", "ground_truth": {"modern_name": "Cold", "confidence": "high", "type": "disease", "modern_term": "Common cold", "note": "Early modern texts often grouped various ailments associated with 'coldness' under a broad category. While 'common cold' is a plausible modern referent, the historical usage could encompass a wider range of conditions than the modern specific viral infection.", "wikidata_id": "Q5153310", "wikidata_description": "former unit of the British Medical Research Council", "wikipedia_url": "https://en.wikipedia.org/wiki/Common%20Cold%20Unit", "wikipedia_extract": "The Common Cold Unit (CCU) or Common Cold Research Unit (CCRU) was a unit of the British Medical Research Council which undertook laboratory and epidemiological research on the common cold between 1946 and 1989 and produced 1,006 papers. The unit studied etiology, epidemiology, prevention, and treatment of common colds. It utilised Harvard Hospital, near Salisbury, a redundant Second World War-duration emergency infectious diseases field-hospital at Harnham Down. Common colds account for a majority of all acute respiratory infections, and the economic costs are substantial in terms of sick leave. The public-facing side of the CCU involved continually recruiting human volunteers, by advertising. Volunteers were housed at the hospital, for typically ten-days while participating in common cold trials."}}, {"canonical_name": "Pontus", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "pontus", "book_id": "english_physician_1652", "name": "Pontus", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Pontus"], "contexts": ["King of Pontus", "ancient kingdom"]}, {"entity_id": "ponto", "book_id": "coloquios_da_orta_1563", "name": "Ponto", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Ponto"], "contexts": ["location of a\u00e7aroro according to Pliny", "geographic region"]}, {"entity_id": "ponto", "book_id": "ricettario_fiorentino_1597", "name": "Ponto", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Ponto"], "contexts": ["region known for wax", "region where Sinope was located"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Pontus", "target_book": "coloquios_da_orta_1563", "target_name": "Ponto", "similarity": 0.971}, {"source_book": "english_physician_1652", "source_name": "Pontus", "target_book": "ricettario_fiorentino_1597", "target_name": "Ponto", "similarity": 0.971}, {"source_book": "coloquios_da_orta_1563", "source_name": "Ponto", "target_book": "ricettario_fiorentino_1597", "target_name": "Ponto", "similarity": 1.0}], "id": 1610, "stable_key": "clu_867e8628d836a460", "ground_truth": {"modern_name": "Pontus", "confidence": "high", "type": "place", "description": "Ancient kingdom and geographic region in Anatolia.", "note": "Refers to the historical region in Anatolia, not the planet or the mythological figure.", "wikipedia_extract": "Pontus or Pontos (; Greek: \u03a0\u03cc\u03bd\u03c4\u03bf\u03c2, romanized: P\u00f3ntos, lit.\u2009'sea',) is a region within Anatolia on the southern coast of the Black Sea, located in the modern-day eastern Black Sea region of Turkey, in West Asia. The name was applied to the coastal region and its mountainous hinterland (rising to the Pontic Alps in the east) by the Greeks who colonized the area in the Archaic period and derived from the Greek name of the Black Sea: \u0395\u03cd\u03be\u03b5\u03b9\u03bd\u03bf\u03c2 \u03a0\u03cc\u03bd\u03c4\u03bf\u03c2 (E\u00faxinos P\u00f3ntos), 'Hospitable Sea', or simply Pontos (\u1f41 \u03a0\u03cc\u03bd\u03c4\u03bf\u03c2) as early as the Aeschylean Persians (472 BC) and Herodotus' Histories (c.\u2009440 BC). Having originally no specific name, the region east of the river Halys was spoken of as the country \u1f18\u03bd \u03a0\u03cc\u03bd\u03c4\u1ff3 (En P\u00f3nt\u014d), lit.\u2009'on the [Euxinos] Pontos', and hence it acquired the name of Pontus, which is first found in Xenophon's Anabasis (c.\u2009370 BC). The extent of the region varied through the ages but generally extended from the borders of Colchis (modern western Georgia) until well into Paphlagonia in the west, with varying amounts of hinterland. Several states and provinces bearing the name of Pontus or variants thereof were established in the region in the Hellenistic, Roman and Byzantine periods, culminating in the late Byzantine Empire of Trebizond. Pontus is sometimes considered as the original home of the Amazons, in ancient Greek mythology and historiography (e.g. by Herodotus and Strabo)."}}, {"canonical_name": "Pipe", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "pipe", "book_id": "english_physician_1652", "name": "Pipe", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Pipe"], "contexts": ["used for smoking rosemary leaves", "instrument for taking smoke"]}, {"entity_id": "tube", "book_id": "principles_of_psychology_james_1890", "name": "tube", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["tube"], "contexts": ["hollow cylinder"]}, {"entity_id": "tube", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tube", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["tube"], "contexts": ["hollow cylinder", "conduit for water in Artesian wells"]}, {"entity_id": "pipe", "book_id": "connexion_physical_sciences_somerville_1858", "name": "pipe", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["pipe"], "contexts": ["object for producing musical notes"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Pipe", "target_book": "principles_of_psychology_james_1890", "target_name": "tube", "similarity": 0.922}, {"source_book": "english_physician_1652", "source_name": "Pipe", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tube", "similarity": 0.922}, {"source_book": "english_physician_1652", "source_name": "Pipe", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "pipe", "similarity": 0.971}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tube", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tube", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tube", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "pipe", "similarity": 0.925}], "id": 1611, "stable_key": "clu_9ff02013bb1a5a75", "ground_truth": {"modern_name": "Pipe", "confidence": "high", "type": "object", "wikidata_id": "Q159536", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Piper%20%28plant%29", "wikipedia_extract": "Piper, the pepper plants or pepper vines, is an economically and ecologically important genus in the family Piperaceae. The genus contains about 1,000\u20132,000 species of shrubs, herbs, and lianas, many of which are dominant species in their native habitat. The diversification of this taxon is of interest to understanding the evolution of plants. The scientific name Piper and the common name \"pepper\" are derived from the Sanskrit term pippali, denoting the long pepper (P. longum). Most Piper species are either herbaceous or vines; some grow as shrubs or almost as small trees."}}, {"canonical_name": "work", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "work", "book_id": "english_physician_1652", "name": "Work", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Work"], "contexts": ["Mathiolus' great, good work"]}, {"entity_id": "work", "book_id": "principles_of_psychology_james_1890", "name": "work", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["work"], "contexts": ["regular activity for habituation", "regular work for habituation"]}, {"entity_id": "work", "book_id": "connexion_physical_sciences_somerville_1858", "name": "work", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["work"], "contexts": ["energy expended to perform a task", "energy transferred by force"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Work", "target_book": "principles_of_psychology_james_1890", "target_name": "work", "similarity": 0.947}, {"source_book": "english_physician_1652", "source_name": "Work", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "work", "similarity": 0.947}, {"source_book": "principles_of_psychology_james_1890", "source_name": "work", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "work", "similarity": 1.0}], "id": 1612, "stable_key": "clu_5f1dfcfe18c71dd4", "ground_truth": {"modern_name": "Work", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "project of one or more scientists, or of an organization in a scientific field", "wikipedia_url": "", "wikipedia_extract": ""}}, {"canonical_name": "clothes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "cloathes", "book_id": "english_physician_1652", "name": "Cloathes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Cloathes"], "contexts": ["items wetted with distilled water"]}, {"entity_id": "wardrobe", "book_id": "english_physician_1652", "name": "Wardrobe", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Wardrobe"], "contexts": ["place with many fine clothes"]}, {"entity_id": "clothes", "book_id": "principles_of_psychology_james_1890", "name": "clothes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["clothes"], "contexts": ["items worn on the body", "garments worn for covering and adornment"]}, {"entity_id": "garments", "book_id": "principles_of_psychology_james_1890", "name": "garments", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["garments"], "contexts": ["articles of clothing"]}, {"entity_id": "ropa", "book_id": "historia_medicinal_monardes_1574", "name": "ropa", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["ropa"], "contexts": ["clothing used for scenting"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Cloathes", "target_book": "principles_of_psychology_james_1890", "target_name": "clothes", "similarity": 0.938}, {"source_book": "english_physician_1652", "source_name": "Cloathes", "target_book": "principles_of_psychology_james_1890", "target_name": "garments", "similarity": 0.925}, {"source_book": "english_physician_1652", "source_name": "Wardrobe", "target_book": "principles_of_psychology_james_1890", "target_name": "clothes", "similarity": 0.909}, {"source_book": "english_physician_1652", "source_name": "Wardrobe", "target_book": "principles_of_psychology_james_1890", "target_name": "garments", "similarity": 0.889}, {"source_book": "principles_of_psychology_james_1890", "source_name": "clothes", "target_book": "historia_medicinal_monardes_1574", "target_name": "ropa", "similarity": 0.935}, {"source_book": "principles_of_psychology_james_1890", "source_name": "garments", "target_book": "historia_medicinal_monardes_1574", "target_name": "ropa", "similarity": 0.901}], "id": 1613, "stable_key": "clu_2c2d79010fdb5f98-2", "ground_truth": {"modern_name": "Clothing", "confidence": "high", "type": "object", "wikidata_id": "Q11460", "wikidata_description": "covering worn on the body", "wikipedia_url": "https://en.wikipedia.org/wiki/Clothing", "wikipedia_extract": "Clothing (also known as clothes, garments, dress, apparel, or attire) is any item worn on a human body. Typically, clothing is made of fabrics or textiles, but over time it has included garments made from animal skin and other thin sheets of materials and natural products found in the environment, put together. The wearing of clothing is mostly restricted to humans and is a feature of all human societies. The amount and type of clothing worn depends on gender, body type, social factors, and geographic considerations. Garments cover the body, footwear covers the feet, gloves cover the hands, hats and headgear cover the head, and underwear covers the intimate parts. Clothing serves many purposes: it can serve as protection from the elements, rough surfaces, sharp stones, rash-causing plants, and insect bites, by providing a barrier between the skin and the environment."}}, {"canonical_name": "distribution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "distribution", "book_id": "origin_of_species_darwin_1859", "name": "distribution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["distribution"], "contexts": ["spatial arrangement of organisms", "spread of organisms"]}, {"entity_id": "distribution", "book_id": "kosmos_humboldt_1845", "name": "distribution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["distribution"], "contexts": ["arrangement or spread"]}, {"entity_id": "distribution", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Distribution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Distribution"], "contexts": ["arrangement of electric charge"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "distribution", "target_book": "kosmos_humboldt_1845", "target_name": "distribution", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "distribution", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Distribution", "similarity": 0.931}, {"source_book": "kosmos_humboldt_1845", "source_name": "distribution", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Distribution", "similarity": 0.931}], "id": 1614, "stable_key": "clu_4d0e2178872e381a", "ground_truth": {"modern_name": "Distribution", "confidence": "high", "type": "concept", "wikidata_id": "Q865811", "wikidata_description": "a continuous functional on a space of test functions (Schwartz space), which generalizes the concept of locally integrable functions", "wikipedia_url": "https://en.wikipedia.org/wiki/Distribution%20%28mathematical%20analysis%29", "wikipedia_extract": "Distributions, also known as Schwartz distributions are a kind of generalized function in mathematical analysis. Distributions make it possible to differentiate functions whose derivatives do not exist in the classical sense. In particular, any locally integrable function has a distributional derivative. Distributions are widely used in the theory of partial differential equations, where it may be easier to establish the existence of distributional solutions (weak solutions) than classical solutions, or where appropriate classical solutions may not exist. Distributions are also important in physics and engineering where many problems naturally lead to differential equations whose solutions or initial conditions are singular, such as the Dirac delta function. is normally thought of as acting on the points in the function domain by \"sending\" a point \u2060."}}, {"canonical_name": "tiger", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "tiger", "book_id": "origin_of_species_darwin_1859", "name": "tiger", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["tiger"], "contexts": ["large carnivorous cat", "predatory mammal in India"]}, {"entity_id": "tiger", "book_id": "principles_of_psychology_james_1890", "name": "tiger", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["tiger"], "contexts": ["large predatory cat", "animal that escaped from a cage"]}, {"entity_id": "royal_tiger", "book_id": "kosmos_humboldt_1845", "name": "royal tiger", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["royal tiger"], "contexts": ["tiger species migrating north"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "tiger", "target_book": "principles_of_psychology_james_1890", "target_name": "tiger", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "tiger", "target_book": "kosmos_humboldt_1845", "target_name": "royal tiger", "similarity": 0.933}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tiger", "target_book": "kosmos_humboldt_1845", "target_name": "royal tiger", "similarity": 0.933}], "id": 1615, "stable_key": "clu_e95da8e7c5f9b7ed", "ground_truth": {"modern_name": "tiger", "confidence": "high", "type": "animal", "linnaean": "Panthera tigris", "family": "Felidae", "description": "Large carnivorous cat native to Asia.", "wikipedia_extract": "The tiger (Panthera tigris) is a large cat and a member of the genus Panthera native to Asia. It has a powerful, muscular body with a large head and paws, a long tail and orange fur with black, mostly vertical stripes. It is traditionally classified into nine recent subspecies, though some recognise only two subspecies, mainland Asian tigers and the island tigers of the Sunda Islands. Throughout the tiger's range, it inhabits mainly forests, from coniferous and temperate broadleaf and mixed forests in the Russian Far East and Northeast China to tropical and subtropical moist broadleaf forests on the Indian subcontinent and Southeast Asia. The tiger is an apex predator and preys mainly on ungulates, which it takes by ambush. It lives a mostly solitary life and occupies home ranges, defending these from individuals of the same sex."}}, {"canonical_name": "economy of nature", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "economy_of_nature", "book_id": "origin_of_species_darwin_1859", "name": "economy of nature", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["economy of nature"], "contexts": ["interconnectedness of natural world", "interrelationships in ecosystems"]}, {"entity_id": "economia_natural", "book_id": "polyanthea_medicinal", "name": "economia natural", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["economia natural"], "contexts": ["natural bodily balance", "natural economy disturbed by perverted fermentations"]}, {"entity_id": "economy_of_nature", "book_id": "connexion_physical_sciences_somerville_1858", "name": "economy of nature", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["economy of nature"], "contexts": ["interconnectedness of natural phenomena"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "economy of nature", "target_book": "polyanthea_medicinal", "target_name": "economia natural", "similarity": 0.929}, {"source_book": "origin_of_species_darwin_1859", "source_name": "economy of nature", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "economy of nature", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "economia natural", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "economy of nature", "similarity": 0.929}], "id": 1616, "stable_key": "clu_3a32f54c259a0f9e", "ground_truth": {"modern_name": "Economy of nature", "confidence": "high", "type": "concept", "wikidata_id": "Q128779459", "wikidata_description": "scholarly article"}}, {"