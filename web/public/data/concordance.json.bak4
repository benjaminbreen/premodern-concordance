da's_girdle", "book_id": "kosmos_humboldt_1845", "name": "Andromeda's girdle", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Andromeda's girdle"], "contexts": ["region in the heavens"]}, {"entity_id": "andromeda", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Andromeda", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Andromeda"], "contexts": ["constellation through which circle would pass", "constellation containing a fine elliptical nebula"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Andromeda's girdle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Andromeda", "similarity": 0.88}], "id": 3492, "stable_key": "clu_2b910d440395e678", "ground_truth": {"modern_name": "Andromeda", "confidence": "high", "type": "place", "country": "Multiple"}}, {"canonical_name": "Sir James Ross", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "sir_james_ross", "book_id": "kosmos_humboldt_1845", "name": "Sir James Ross", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Sir James Ross"], "contexts": ["explorer who sounded ocean depths"]}, {"entity_id": "james_clark_ross", "book_id": "kosmos_humboldt_1845", "name": "James Clark Ross", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["James Clark Ross"], "contexts": ["navigator investigating magnetic force"]}, {"entity_id": "ross,_sir_james", "book_id": "kosmos_humboldt_1845", "name": "Ross, Sir James", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Ross, Sir James"], "contexts": ["magnetic observations at South Pole and Antarctic expedition"]}, {"entity_id": "sir_james_ross", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Sir James Ross", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Sir James Ross"], "contexts": ["e