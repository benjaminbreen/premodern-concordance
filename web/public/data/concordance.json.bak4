ource_name": "Paris", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Paris", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Paris", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Paris", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Paris", "target_book": "kosmos_humboldt_1845", "target_name": "Paris", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Paris", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Paris", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Paris", "target_book": "kosmos_humboldt_1845", "target_name": "Paris", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Paris", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Paris", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Paris", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Paris", "similarity": 1.0}], "id": 58, "stable_key": "clu_38c324102b5ef545", "ground_truth": {"modern_name": "Paris", "confidence": "high", "type": "place", "description": "The capital city of France.", "wikipedia_extract": "Paris is the capital and largest city of France, with an estimated city population of 2,047,602 in an area of 105.4 km2 (40.7 sq mi), and a metropolitan population of 13,239,090 as of January 2026. Located on the river Seine in the centre of the \u00cele-de-France region, it is the largest metropolitan area and fourth-most populous city in the European Union (EU). Nicknamed the City of Light, partly because of its role in the Age of Enlightenment, Paris has been one of the world's major centres of finance, diplomacy, commerce, culture, fashion, and gastronomy since the 17th century. Administratively, Paris is divided into twenty arrondissements (districts), each having their own cultural identity. Haussmann's renovation of Paris, which created new boulevards, parks, and public works, gave birth to a modern city known as the \"capital of the 19th century\". Paris is a major railway, motorway, and air-transport hub; in 2024 Charles de Gaulle Airport was the EU's busiest airport."}}, {"canonical_name": "Antimonio", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 5, "total_mentions": 132, "members": [{"entity_id": "antimony", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Antimony", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["Antimony"], "contexts": ["element used in glass, appears red", "mineral with attractive quality"]}, {"entity_id": "antimony", "book_id": "kosmos_humboldt_1845", "name": "antimony", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["antimony"], "contexts": ["element with specific density"]}, {"entity_id": "antimonio", "book_id": "ricettario_fiorentino_1597", "name": "Antimonio", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["Antimonio", "Antimonio arfo", "antimonio"], "contexts": ["antimony that is burned", "mineral substance, antimony"]}, {"entity_id": "antimonio", "book_id": "polyanthea_medicinal", "name": "Antimonio", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 119, "variants": ["Antimonio", "Antimodo", "Antimon", "Antimoni", "Antimoniaes", "Antimoniali", "Antimonii", "Antimonij", "Antimonio Diaphoretico", "Antimonio cru", "Antimonio crudi", "Antimonio de infulao", "Antimonio diaphoretico", "Antimonio diaphoretico reverberado", "Antimonio macho", "Antimonio meteorizado", "Antimonio preparado", "Antimonio pretas", "AntimonioDiaphoretico", "Antimoniocru", "Antimoniodiaphoreticobem reverberado", "Antimoniomeo", "Antimonion", "Antimoniopara", "Antimonioprepamenta", "Antimoniopreparantur", "Antimonium", "antimonio"], "contexts": ["substance discussed in the text", "Substance with qualities and virtues"]}, {"entity_id": "antimony", "book_id": "connexion_physical_sciences_somerville_1858", "name": "antimony", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["antimony"], "contexts": ["metal in heterogeneous circuit", "element used in electric experiments"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Antimony", "target_book": "kosmos_humboldt_1845", "target_name": "antimony", "similarity": 0.988}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Antimony", "target_book": "ricettario_fiorentino_1597", "target_name": "Antimonio", "similarity": 0.954}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Antimony", "target_book": "polyanthea_medicinal", "target_name": "Antimonio", "similarity": 0.954}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Antimony", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "antimony", "similarity": 0.988}, {"source_book": "kosmos_humboldt_1845", "source_name": "antimony", "target_book": "ricettario_fiorentino_1597", "target_name": "Antimonio", "similarity": 0.95}, {"source_book": "kosmos_humboldt_1845", "source_name": "antimony", "target_book": "polyanthea_medicinal", "target_name": "Antimonio", "similarity": 0.95}, {"source_book": "kosmos_humboldt_1845", "source_name": "antimony", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "antimony", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Antimonio", "target_book": "polyanthea_medicinal", "target_name": "Antimonio", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Antimonio", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "antimony", "similarity": 0.95}, {"source_book": "polyanthea_medicinal", "source_name": "Antimonio", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "antimony", "similarity": 0.95}], "id": 59, "stable_key": "clu_157c6ffe199c26c2", "ground_truth": {"modern_name": "Antimony", "confidence": "high", "type": "mineral", "wikidata_id": "Q1099", "wikidata_description": "chemical element with symbol Sb and atomic number of 51", "wikipedia_extract": "Antimony potassium tartrate, also known as potassium antimonyl tartrate, potassium antimontarterate, or tartar emetic, has the formula K2Sb2(C4H2O6)2. The compound has long been known as a powerful emetic, and was used in the treatment of schistosomiasis and leishmaniasis. It is used as a resolving agent. It typically is obtained as a hydrate. The first treatment application against trypanosomiasis was tested in 1906, and the compound's use to treat other tropical diseases was researched. The treatment of leishmania with antimony potassium tartrate started in 1913.", "wikipedia_url": "https://en.wikipedia.org/wiki/Antimony", "note": "This likely refers to a distilled preparation containing antimony compounds.", "description": "A metallic element, often prepared and used in alchemical and medicinal contexts."}}, {"canonical_name": "Sun", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 5, "total_mentions": 127, "members": [{"entity_id": "soleil", "book_id": "epoques_nature_buffon_1778", "name": "soleil", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 29, "variants": ["soleil"], "contexts": ["star providing external heat", "celestial body providing heat"]}, {"entity_id": "soleil", "book_id": "relation_historique_humboldt_vol3_1825", "name": "soleil", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 14, "variants": ["Soleil", "soleil"], "contexts": ["celestial body, deity", "divine parent of rulers"]}, {"entity_id": "sun", "book_id": "kosmos_humboldt_1845", "name": "Sun", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 51, "variants": ["sun", "Sun"], "contexts": ["central body of our solar system", "celestial body"]}, {"entity_id": "sol", "book_id": "historia_medicinal_monardes_1574", "name": "Sol", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 5, "variants": ["Sol"], "contexts": ["celestial body the flower turns towards", "sun, used for drying"]}, {"entity_id": "sol", "book_id": "polyanthea_medicinal", "name": "Sol", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 28, "variants": ["Sol"], "contexts": ["the Sun", "Source of lights"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "soleil", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "soleil", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "soleil", "target_book": "kosmos_humboldt_1845", "target_name": "Sun", "similarity": 0.957}, {"source_book": "epoques_nature_buffon_1778", "source_name": "soleil", "target_book": "historia_medicinal_monardes_1574", "target_name": "Sol", "similarity": 0.944}, {"source_book": "epoques_nature_buffon_1778", "source_name": "soleil", "target_book": "polyanthea_medicinal", "target_name": "Sol", "similarity": 0.944}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "soleil", "target_book": "kosmos_humboldt_1845", "target_name": "Sun", "similarity": 0.957}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "soleil", "target_book": "historia_medicinal_monardes_1574", "target_name": "Sol", "similarity": 0.944}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "soleil", "target_book": "polyanthea_medicinal", "target_name": "Sol", "similarity": 0.944}, {"source_book": "kosmos_humboldt_1845", "source_name": "Sun", "target_book": "historia_medicinal_monardes_1574", "target_name": "Sol", "similarity": 0.958}, {"source_book": "kosmos_humboldt_1845", "source_name": "Sun", "target_book": "polyanthea_medicinal", "target_name": "Sol", "similarity": 0.958}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Sol", "target_book": "polyanthea_medicinal", "target_name": "Sol", "similarity": 1.0}], "id": 60, "stable_key": "clu_73904e3257f026e4", "ground_truth": {"modern_name": "Sun", "confidence": "high", "type": "object", "description": "The star at the center of our solar system; source of light and heat.", "note": "Refers to the celestial body, not the Roman deity unless context implies it.", "wikipedia_extract": "The Sun is the star at the centre of the Solar System. It is a massive, nearly perfect sphere of hot plasma, heated to incandescence by nuclear fusion reactions in its core, radiating the energy from its surface mainly as visible light and infrared radiation with 10% at ultraviolet energies. It is the main source of energy for life on Earth. The Sun has been an object of veneration in many cultures and a central subject for astronomical research since antiquity. The Sun orbits the Galactic Center at a distance of 24,000 to 28,000 light-years. Its mean distance from Earth is about 1.496\u00d7108 kilometres or about 8 light-minutes."}}, {"canonical_name": "bloodletting", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 5, "total_mentions": 127, "members": [{"entity_id": "bloodletting", "book_id": "english_physician_1652", "name": "bloodletting", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 3, "variants": ["bloodletting", "Bloodletting"], "contexts": ["medical practice of removing blood", "implied by treatment of humors"]}, {"entity_id": "bloodletting", "book_id": "historia_medicinal_monardes_1574", "name": "bloodletting", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["bloodletting"], "contexts": ["implied by medical context"]}, {"entity_id": "bloodletting", "book_id": "coloquios_da_orta_1563", "name": "bloodletting", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 13, "variants": ["bloodletting"], "contexts": ["medical practice of purging", "implied medical practice"]}, {"entity_id": "bloodletting", "book_id": "ricettario_fiorentino_1597", "name": "Bloodletting", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["bloodletting", "Bloodletting"], "contexts": ["implied by discussion of medicine and body", "medical practice"]}, {"entity_id": "bloodletting", "book_id": "polyanthea_medicinal", "name": "bloodletting", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 108, "variants": ["bloodletting", "Bloodletting"], "contexts": ["implied medical practice", "medical practice"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "bloodletting", "target_book": "historia_medicinal_monardes_1574", "target_name": "bloodletting", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "bloodletting", "target_book": "coloquios_da_orta_1563", "target_name": "bloodletting", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "bloodletting", "target_book": "ricettario_fiorentino_1597", "target_name": "Bloodletting", "similarity": 0.966}, {"source_book": "english_physician_1652", "source_name": "bloodletting", "target_book": "polyanthea_medicinal", "target_name": "bloodletting", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "bloodletting", "target_book": "coloquios_da_orta_1563", "target_name": "bloodletting", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "bloodletting", "target_book": "ricettario_fiorentino_1597", "target_name": "Bloodletting", "similarity": 0.966}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "bloodletting", "target_book": "polyanthea_medicinal", "target_name": "bloodletting", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "bloodletting", "target_book": "ricettario_fiorentino_1597", "target_name": "Bloodletting", "similarity": 0.966}, {"source_book": "coloquios_da_orta_1563", "source_name": "bloodletting", "target_book": "polyanthea_medicinal", "target_name": "bloodletting", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Bloodletting", "target_book": "polyanthea_medicinal", "target_name": "bloodletting", "similarity": 0.966}], "id": 61, "stable_key": "clu_6ef341a8c77ec868", "ground_truth": {"modern_name": "Bloodletting", "confidence": "high", "type": "concept", "wikidata_id": "Q356405", "wikidata_description": "therapy, now rarely used in medicine", "wikipedia_url": "https://en.wikipedia.org/wiki/Bloodletting", "wikipedia_extract": "Bloodletting (or blood-letting) is the deliberate withdrawal of blood from a patient to prevent or cure illness and disease. Bloodletting, whether by a physician or by leeches, was based on an ancient system of medicine in which blood and other bodily fluids were regarded as \"humors\" that had to remain in proper balance to maintain health. It was the most common medical practice performed by surgeons from antiquity until the late 19th century, a span of over 2,000 years. In Europe, the practice continued to be relatively common until the end of the 19th century. The practice has been abandoned by modern-style medicine for all except a few very specific medical conditions. In the beginning of the 19th century, studies had begun to show the harmful effects of bloodletting.", "description": "A medical procedure involving the withdrawal of blood."}}, {"canonical_name": "Evolution", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 5, "total_mentions": 126, "members": [{"entity_id": "\u00e9volution", "book_id": "medecine_experimentale_bernard_1865", "name": "\u00e9volution", "category": "CONCEPT", "subcategory": "THEORY", "count": 4, "variants": ["\u00e9volution"], "contexts": ["gradual development or change", "theory of biological change"]}, {"entity_id": "\u00e9volution", "book_id": "epoques_nature_buffon_1778", "name": "\u00e9volution", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["\u00e9volution"], "contexts": ["process of change in the globe"]}, {"entity_id": "evolution", "book_id": "principles_of_psychology_james_1890", "name": "evolution", "category": "CONCEPT", "subcategory": "THEORY", "count": 6, "variants": ["evolution"], "contexts": ["process of biological change over time", "theory of gradual development of life"]}, {"entity_id": "evolution", "book_id": "kosmos_humboldt_1845", "name": "evolution", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["evolution"], "contexts": ["doctrine of organic development"]}, {"entity_id": "evolution", "book_id": "first_principles_spencer_1862", "name": "Evolution", "category": "CONCEPT", "subcategory": "THEORY", "count": 114, "variants": ["evolution", "EVOLUTION", "Evolution"], "contexts": ["law of evolution in scientific thought", "theory of biological development"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "\u00e9volution", "target_book": "epoques_nature_buffon_1778", "target_name": "\u00e9volution", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "\u00e9volution", "target_book": "principles_of_psychology_james_1890", "target_name": "evolution", "similarity": 0.944}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "\u00e9volution", "target_book": "kosmos_humboldt_1845", "target_name": "evolution", "similarity": 0.944}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "\u00e9volution", "target_book": "first_principles_spencer_1862", "target_name": "Evolution", "similarity": 0.903}, {"source_book": "epoques_nature_buffon_1778", "source_name": "\u00e9volution", "target_book": "principles_of_psychology_james_1890", "target_name": "evolution", "similarity": 0.944}, {"source_book": "epoques_nature_buffon_1778", "source_name": "\u00e9volution", "target_book": "kosmos_humboldt_1845", "target_name": "evolution", "similarity": 0.944}, {"source_book": "epoques_nature_buffon_1778", "source_name": "\u00e9volution", "target_book": "first_principles_spencer_1862", "target_name": "Evolution", "similarity": 0.903}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolution", "target_book": "kosmos_humboldt_1845", "target_name": "evolution", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolution", "target_book": "first_principles_spencer_1862", "target_name": "Evolution", "similarity": 0.961}, {"source_book": "kosmos_humboldt_1845", "source_name": "evolution", "target_book": "first_principles_spencer_1862", "target_name": "Evolution", "similarity": 0.961}], "id": 62, "stable_key": "clu_f61cf96cef849460", "ground_truth": {"modern_name": "Evolution", "confidence": "high", "type": "concept", "note": "The overwhelming frequency of 'Evolution' in Spencer's and James's works, along with the contexts 'biological change' and 'development across animal species,' clearly points to the scientific concept of evolution.", "wikidata_id": "Q4038411", "wikidata_description": "monthly scientific journal", "wikipedia_url": "https://en.wikipedia.org/wiki/Evolution", "wikipedia_extract": "Evolution is the change in the heritable characteristics of biological populations over successive generations. It occurs when evolutionary processes such as genetic drift and natural selection act on genetic variation, resulting in certain characteristics becoming more or less common within a population over successive generations. The process of evolution has given rise to biodiversity at every level of biological organisation. The scientific theory of evolution by natural selection was conceived independently by two British naturalists, Charles Darwin and Alfred Russel Wallace, in the mid-19th century as an explanation for why organisms are adapted to their physical and biological environments. The theory was first set out in detail in Darwin's book On the Origin of Species. Evolution by natural selection is established by observable facts about living organisms: (1) more offspring are often produced than can possibly survive; (2) traits vary among individuals with respect to their morphology, physiology, and behaviour; (3) different traits confer different rates of survival and reproduction (differential fitness); and (4) traits can be passed from generation to generation (heritability of fitness)."}}, {"canonical_name": "Canela", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 5, "total_mentions": 125, "members": [{"entity_id": "canelle", "book_id": "relation_historique_humboldt_vol3_1825", "name": "canelle", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["canelle"], "contexts": ["spice to be cultivated"]}, {"entity_id": "canela", "book_id": "historia_medicinal_monardes_1574", "name": "Canela", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 13, "variants": ["Canela", "Cane", "Canela dela India"], "contexts": ["spice from the Moluccas Islands", "spice with strong aroma and flavor"]}, {"entity_id": "canela", "book_id": "polyanthea_medicinal", "name": "Canela", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 55, "variants": ["Canela", "canela", "canella"], "contexts": ["spice used in a preparation", "cinnamon used in a medicinal preparation"]}, {"entity_id": "canela", "book_id": "coloquios_da_orta_1563", "name": "canela", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 39, "variants": ["canela", "CANELA", "Canela", "Canelia", "Canella", "canelia", "canella", "canella boa"], "contexts": ["spice discussed in colloquy", "Spice eaten with gusto"]}, {"entity_id": "canela_fina", "book_id": "polyanthea_medicinal", "name": "canela fina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["canela fina"], "contexts": ["spice used in remedy", "spice used in a syrup"]}, {"entity_id": "canela", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "canela", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["canela", "CANELA"], "contexts": ["cinnamon, a tree", "cinnamon, same origin as cassia"]}, {"entity_id": "canela_fina", "book_id": "coloquios_da_orta_1563", "name": "canela fina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["canela fina"], "contexts": ["fine cinnamon spice"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "canelle", "target_book": "historia_medicinal_monardes_1574", "target_name": "Canela", "similarity": 0.891}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "canelle", "target_book": "polyanthea_medicinal", "target_name": "Canela", "similarity": 0.891}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Canela", "target_book": "polyanthea_medicinal", "target_name": "Canela", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "canela", "target_book": "polyanthea_medicinal", "target_name": "canela fina", "similarity": 0.891}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "canela", "target_book": "coloquios_da_orta_1563", "target_name": "canela fina", "similarity": 0.891}], "id": 63, "stable_key": "clu_f3e6baaf0c14937a", "ground_truth": {"modern_name": "Cinnamon", "confidence": "high", "type": "plant", "linnaean": "Cinnamomum verum J.Presl", "family": "Lauraceae", "note": "While 'canela' can refer to both cinnamon and cassia, the context of Moluccas Islands strongly suggests cinnamon.", "wikidata_id": "Q28165", "wikidata_description": "spice obtained from the inner bark of several tree species from the genus Cinnamomum", "wikipedia_url": "https://en.wikipedia.org/wiki/Cinnamon", "wikipedia_extract": "Cinnamon is a spice obtained from the inner bark of several tree species from the genus Cinnamomum. Cinnamon is used mainly as an aromatic condiment and flavouring additive in a wide variety of cuisines, in particular sweet and savoury dishes such as biscuits, breakfast cereals, snack foods, bagels, teas, hot chocolate, and traditional foods. The aroma and flavour of cinnamon derive from its essential oil and principal component, cinnamaldehyde, as well as numerous other constituents, including eugenol. Cinnamon is the name for several species of trees and the commercial spice products that some of them produce. All are members of the genus Cinnamomum in the family Lauraceae. Only a few Cinnamomum species are grown commercially for spice."}}, {"canonical_name": "Goa", "category": "PLACE", "subcategory": "CITY", "book_count": 5, "total_mentions": 124, "members": [{"entity_id": "goa", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Goa", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Goa"], "contexts": ["city in Ca\u00f1ara province", "city where plant grows"]}, {"entity_id": "goa", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Goa", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Goa"], "contexts": ["independent settlement"]}, {"entity_id": "goa", "book_id": "coloquios_da_orta_1563", "name": "Goa", "category": "PLACE", "subcategory": "CITY", "count": 117, "variants": ["Goa", "GOA"], "contexts": ["city where Ruano arrived", "City where aloe is used"]}, {"entity_id": "goa", "book_id": "ricettario_fiorentino_1597", "name": "Goa", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Goa"], "contexts": ["city from which Spodio arrived", "city in India"]}, {"entity_id": "goa", "book_id": "polyanthea_medicinal", "name": "Goa", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Goa"], "contexts": ["city where Padre Ungarete was a pharmacist"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Goa", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Goa", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Goa", "target_book": "coloquios_da_orta_1563", "target_name": "Goa", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Goa", "target_book": "ricettario_fiorentino_1597", "target_name": "Goa", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Goa", "target_book": "polyanthea_medicinal", "target_name": "Goa", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Goa", "target_book": "coloquios_da_orta_1563", "target_name": "Goa", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Goa", "target_book": "ricettario_fiorentino_1597", "target_name": "Goa", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Goa", "target_book": "polyanthea_medicinal", "target_name": "Goa", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Goa", "target_book": "ricettario_fiorentino_1597", "target_name": "Goa", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Goa", "target_book": "polyanthea_medicinal", "target_name": "Goa", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Goa", "target_book": "polyanthea_medicinal", "target_name": "Goa", "similarity": 1.0}], "id": 64, "stable_key": "clu_bbb54fdf1aa717bf", "ground_truth": {"modern_name": "Goa", "confidence": "high", "type": "place", "description": "A city and region in India.", "wikipedia_extract": "Goa ( GOH-\u0259; Konkani: [\u0261\u0254\u0303j]; Portuguese: [\u02c8\u0261o\u0250] ) is a state on the southwestern coast of India within the Konkan region. It is geographically separated from the Deccan highlands by the Western Ghats. It is bordered by the Indian states of Maharashtra to the north and Karnataka to the east and south, with the Arabian Sea forming its western coastline. It is India's smallest state by area and fourth-smallest by population. Panaji (Panjim) is the state's capital, while Vasco da Gama is its largest city by population. The state's official language is Konkani, spoken by the majority of its inhabitants."}}, {"canonical_name": "madre", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 110, "members": [{"entity_id": "mother", "book_id": "english_physician_1652", "name": "Mother", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 33, "variants": ["Mother"], "contexts": ["strangled with the mother", "affected by pains"]}, {"entity_id": "mother", "book_id": "origin_of_species_darwin_1859", "name": "mother", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["mother"], "contexts": ["female parent in reproduction"]}, {"entity_id": "madre", "book_id": "historia_medicinal_monardes_1574", "name": "madre", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 13, "variants": ["madre"], "contexts": ["mother (referring to the womb)", "uterus"]}, {"entity_id": "madre", "book_id": "coloquios_da_orta_1563", "name": "madre", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["madre"], "contexts": ["womb, affected by calamus", "womb, benefited by fruit preserve"]}, {"entity_id": "madre", "book_id": "polyanthea_medicinal", "name": "madre", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 60, "variants": ["madre", "Madre", "madredeytade"], "contexts": ["mother, referring to dura mater", "membrane connected to the head"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Mother", "target_book": "origin_of_species_darwin_1859", "target_name": "mother", "similarity": 0.992}, {"source_book": "english_physician_1652", "source_name": "Mother", "target_book": "historia_medicinal_monardes_1574", "target_name": "madre", "similarity": 0.981}, {"source_book": "english_physician_1652", "source_name": "Mother", "target_book": "coloquios_da_orta_1563", "target_name": "madre", "similarity": 0.981}, {"source_book": "english_physician_1652", "source_name": "Mother", "target_book": "polyanthea_medicinal", "target_name": "madre", "similarity": 0.981}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mother", "target_book": "historia_medicinal_monardes_1574", "target_name": "madre", "similarity": 0.986}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mother", "target_book": "coloquios_da_orta_1563", "target_name": "madre", "similarity": 0.986}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mother", "target_book": "polyanthea_medicinal", "target_name": "madre", "similarity": 0.986}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "madre", "target_book": "coloquios_da_orta_1563", "target_name": "madre", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "madre", "target_book": "polyanthea_medicinal", "target_name": "madre", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "madre", "target_book": "polyanthea_medicinal", "target_name": "madre", "similarity": 1.0}], "id": 65, "stable_key": "clu_b88ed5ad2ca0cf21", "ground_truth": {"modern_name": "Womb", "confidence": "high", "type": "anatomy", "description": "The organ in female mammals where offspring develop.", "note": "Also refers to 'dura mater' in some contexts.", "wikipedia_extract": "The uterus (from Latin uterus, pl.: uteri or uteruses) or womb () is the organ in the reproductive system of most female mammals, including humans, that accommodates the embryonic and fetal development of one or more fertilized eggs until birth. The uterus is a hormone-responsive sex organ that contains glands in its lining that secrete uterine milk for embryonic nourishment. (The term uterus is also applied to analogous structures in some non-mammalian animals.) In humans, the lower end of the uterus is a narrow part known as the isthmus that connects to the cervix, the anterior gateway leading to the vagina. The upper end, the body of the uterus, is connected to the fallopian tubes at the uterine horns; the rounded part, the fundus, is above the openings to the fallopian tubes. The connection of the uterine cavity with a fallopian tube is called the uterotubal junction. The fertilized egg is carried to the uterus along the fallopian tube. It will have divided on its journey to form a blastocyst that will implant itself into the lining of the uterus \u2013 the endometrium, where it will receive nutrients and develop into the embryo proper, and later fetus, for the duration of the pregnancy."}}, {"canonical_name": "brain", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 108, "members": [{"entity_id": "brain", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "brain", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["brain"], "contexts": ["affected by drink spirits", "organ infected by poison"]}, {"entity_id": "brain", "book_id": "origin_of_species_darwin_1859", "name": "brain", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["brain"], "contexts": ["central organ of the nervous system"]}, {"entity_id": "brain", "book_id": "principles_of_psychology_james_1890", "name": "brain", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 101, "variants": ["BRAIN", "brain", "Brain"], "contexts": ["physical basis for thoughts and feelings", "central organ of the nervous system"]}, {"entity_id": "brain", "book_id": "kosmos_humboldt_1845", "name": "brain", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["brain"], "contexts": ["organ of thought and control"]}, {"entity_id": "brain", "book_id": "polyanthea_medicinal", "name": "brain", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["brain"], "contexts": ["organ of the nervous system", "organ of the body"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "brain", "target_book": "origin_of_species_darwin_1859", "target_name": "brain", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "brain", "target_book": "principles_of_psychology_james_1890", "target_name": "brain", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "brain", "target_book": "kosmos_humboldt_1845", "target_name": "brain", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "brain", "target_book": "polyanthea_medicinal", "target_name": "brain", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "brain", "target_book": "principles_of_psychology_james_1890", "target_name": "brain", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "brain", "target_book": "kosmos_humboldt_1845", "target_name": "brain", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "brain", "target_book": "polyanthea_medicinal", "target_name": "brain", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "brain", "target_book": "kosmos_humboldt_1845", "target_name": "brain", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "brain", "target_book": "polyanthea_medicinal", "target_name": "brain", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "brain", "target_book": "polyanthea_medicinal", "target_name": "brain", "similarity": 1.0}], "id": 66, "stable_key": "clu_6a5b94657380a917", "ground_truth": {"modern_name": "Brain", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Brain", "note": "While 'cerebro' directly translates to brain, in early modern texts it often referred to the concept of the seat of intellect and memory, as well as the physical organ.", "wikipedia_extract": "The brain is an organ that serves as the center of the nervous system in all vertebrate and most invertebrate animals. It consists of nervous tissue and is typically located in the head (cephalization), usually near organs for special senses such as vision, hearing, and olfaction. Being the most specialized organ, it is responsible for receiving information from the sensory nervous system, processing that information (thought, cognition, and intelligence) and the coordination of motor control (muscle activity and endocrine system). While invertebrate brains arise from paired segmental ganglia (each of which is only responsible for the respective body segment) of the ventral nerve cord, vertebrate brains develop axially from the midline dorsal nerve cord as a vesicular enlargement at the rostral end of the neural tube, with centralized control over all body segments. All vertebrate brains can be embryonically divided into three parts: the forebrain (prosencephalon, subdivided into telencephalon and diencephalon), midbrain (mesencephalon) and hindbrain (rhombencephalon, subdivided into metencephalon and myelencephalon). The spinal cord, which directly interacts with somatic functions below the head, can be considered a caudal extension of the myelencephalon enclosed inside the vertebral column."}}, {"canonical_name": "Malabar", "category": "PLACE", "subcategory": "REGION", "book_count": 5, "total_mentions": 107, "members": [{"entity_id": "malabar", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "malabar", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["malabar"], "contexts": ["region where a plant grows"]}, {"entity_id": "malabar", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Malabar", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Malabar"], "contexts": ["coastal region where observations were made"]}, {"entity_id": "malabar", "book_id": "kosmos_humboldt_1845", "name": "Malabar", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Malabar"], "contexts": ["location for monsoon naming"]}, {"entity_id": "malabar", "book_id": "coloquios_da_orta_1563", "name": "Malabar", "category": "PLACE", "subcategory": "REGION", "count": 103, "variants": ["Malabar", "Malavar", "malabar", "malavar"], "contexts": ["language", "region where Diogo Pereira was knowledgeable"]}, {"entity_id": "malabar", "book_id": "ricettario_fiorentino_1597", "name": "Malabar", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Malabar"], "contexts": ["region where cinnamon grows"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "malabar", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Malabar", "similarity": 0.859}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "malabar", "target_book": "kosmos_humboldt_1845", "target_name": "Malabar", "similarity": 0.859}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "malabar", "target_book": "coloquios_da_orta_1563", "target_name": "Malabar", "similarity": 0.859}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "malabar", "target_book": "ricettario_fiorentino_1597", "target_name": "Malabar", "similarity": 0.859}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Malabar", "target_book": "kosmos_humboldt_1845", "target_name": "Malabar", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Malabar", "target_book": "coloquios_da_orta_1563", "target_name": "Malabar", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Malabar", "target_book": "ricettario_fiorentino_1597", "target_name": "Malabar", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Malabar", "target_book": "coloquios_da_orta_1563", "target_name": "Malabar", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Malabar", "target_book": "ricettario_fiorentino_1597", "target_name": "Malabar", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Malabar", "target_book": "ricettario_fiorentino_1597", "target_name": "Malabar", "similarity": 1.0}], "id": 67, "stable_key": "clu_ce659446ca8eae8b", "ground_truth": {"modern_name": "Malabar Coast", "confidence": "high", "type": "place", "description": "Region in southwestern India.", "wikipedia_extract": "The Malabar Coast (Malayalam: [m\u0250l\u0250ba\u02d0r]) is the southwestern region of the Indian subcontinent. It generally refers to the western coastline of India stretching from Konkan to Kanyakumari. Geographically, it comprises one of the wettest regions of the subcontinent, which includes the southern tip of Goa, Kanara region of Karnataka, all of Kerala and Kanyakumari region of Tamil Nadu. Kuttanad, which is the point of the lowest elevation in India, lies on the Malabar Coast. Kuttanad, also known as The Rice Bowl of Kerala, is among the few places in the world where cultivation takes place below sea level. The peak of Anamudi, which is also the point of highest elevation in India outside the Himalayas, lies parallel to the Malabar Coast on the Western Ghats."}}, {"canonical_name": "Stomach", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 106, "members": [{"entity_id": "stomach", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Stomach", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Stomach", "stomach"], "contexts": ["organ where sponge swells", "digestive organ"]}, {"entity_id": "stomach", "book_id": "english_physician_1652", "name": "Stomach", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 100, "variants": ["Stomach", "Stomachs", "Stomack", "Stomi\u2022\u2022s", "Sto\u2223mach", "Sto\u2223machs", "stomach"], "contexts": ["body part treated by the herb", "organ warmed by herb"]}, {"entity_id": "stomach", "book_id": "origin_of_species_darwin_1859", "name": "stomach", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["stomach"], "contexts": ["organ for digesting food", "organ for digestion"]}, {"entity_id": "stomach", "book_id": "principles_of_psychology_james_1890", "name": "stomach", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["stomach"], "contexts": ["digestive organ"]}, {"entity_id": "stomach", "book_id": "first_principles_spencer_1862", "name": "stomach", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["stomach"], "contexts": ["organ for digesting food"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Stomach", "target_book": "english_physician_1652", "target_name": "Stomach", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Stomach", "target_book": "origin_of_species_darwin_1859", "target_name": "stomach", "similarity": 0.947}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Stomach", "target_book": "principles_of_psychology_james_1890", "target_name": "stomach", "similarity": 0.947}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Stomach", "target_book": "first_principles_spencer_1862", "target_name": "stomach", "similarity": 0.947}, {"source_book": "english_physician_1652", "source_name": "Stomach", "target_book": "origin_of_species_darwin_1859", "target_name": "stomach", "similarity": 0.947}, {"source_book": "english_physician_1652", "source_name": "Stomach", "target_book": "principles_of_psychology_james_1890", "target_name": "stomach", "similarity": 0.947}, {"source_book": "english_physician_1652", "source_name": "Stomach", "target_book": "first_principles_spencer_1862", "target_name": "stomach", "similarity": 0.947}, {"source_book": "origin_of_species_darwin_1859", "source_name": "stomach", "target_book": "principles_of_psychology_james_1890", "target_name": "stomach", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "stomach", "target_book": "first_principles_spencer_1862", "target_name": "stomach", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "stomach", "target_book": "first_principles_spencer_1862", "target_name": "stomach", "similarity": 1.0}], "id": 68, "stable_key": "clu_bf502760d0058f8c", "ground_truth": {"modern_name": "Stomach", "confidence": "high", "type": "anatomical_part", "description": "The organ responsible for digestion and processing food.", "note": "Includes variations in spelling and the mention of its 'tunicas' (linings).", "wikipedia_extract": "The stomach is a muscular, hollow organ in the upper gastrointestinal tract of humans and many other animals, including several invertebrates. The Ancient Greek name for the stomach is gaster which is used as gastric in medical terms related to the stomach. The stomach has a dilated structure and functions as a vital organ in the digestive system. The stomach is involved in the gastric phase of digestion, following the cephalic phase in which the sight and smell of food and the act of chewing are stimuli. In the stomach a chemical breakdown of food takes place by means of secreted  digestive enzymes and gastric acid. It also plays a role in regulating gut microbiota, influencing digestion and overall health.", "wikidata_id": "Q156103", "wikidata_description": "medical condition characterized by inflammation of the stomach and/or small intestine"}}, {"canonical_name": "Liver", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 100, "members": [{"entity_id": "liver", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Liver", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["liver", "Liver"], "contexts": ["organ where gall is seated", "abdominal organ"]}, {"entity_id": "liver", "book_id": "english_physician_1652", "name": "Liver", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 87, "variants": ["Liver"], "contexts": ["organ involved in digestion and detoxification", "organ that is cleansed and helped"]}, {"entity_id": "liver", "book_id": "principles_of_psychology_james_1890", "name": "liver", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["liver"], "contexts": ["organ that secretes bile", "organ involved in activity"]}, {"entity_id": "liver", "book_id": "polyanthea_medicinal", "name": "Liver", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Liver", "liver"], "contexts": ["organ of the body", "an organ of the body"]}, {"entity_id": "liver", "book_id": "first_principles_spencer_1862", "name": "liver", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["liver"], "contexts": ["commences as multiplication of cells", "organ developing from intestine wall"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Liver", "target_book": "english_physician_1652", "target_name": "Liver", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Liver", "target_book": "principles_of_psychology_james_1890", "target_name": "liver", "similarity": 0.934}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Liver", "target_book": "polyanthea_medicinal", "target_name": "Liver", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Liver", "target_book": "first_principles_spencer_1862", "target_name": "liver", "similarity": 0.934}, {"source_book": "english_physician_1652", "source_name": "Liver", "target_book": "principles_of_psychology_james_1890", "target_name": "liver", "similarity": 0.934}, {"source_book": "english_physician_1652", "source_name": "Liver", "target_book": "polyanthea_medicinal", "target_name": "Liver", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Liver", "target_book": "first_principles_spencer_1862", "target_name": "liver", "similarity": 0.934}, {"source_book": "principles_of_psychology_james_1890", "source_name": "liver", "target_book": "polyanthea_medicinal", "target_name": "Liver", "similarity": 0.934}, {"source_book": "principles_of_psychology_james_1890", "source_name": "liver", "target_book": "first_principles_spencer_1862", "target_name": "liver", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Liver", "target_book": "first_principles_spencer_1862", "target_name": "liver", "similarity": 0.934}], "id": 69, "stable_key": "clu_8c3aeff51a8005ae", "ground_truth": {"modern_name": "Liver", "confidence": "high", "type": "anatomy", "description": "Large organ in the abdomen involved in detoxification and metabolism.", "wikipedia_extract": "The liver is a major metabolic organ exclusively found in vertebrates, which performs many essential biological functions such as detoxification of the organism, and the synthesis of various proteins and various other biochemicals necessary for digestion and growth. In humans, it is located in the right upper quadrant of the abdomen, below the diaphragm and mostly shielded by the lower right rib cage. Its other metabolic roles include carbohydrate metabolism, the production of a number of hormones, conversion and storage of nutrients such as glucose and glycogen, and the decomposition of red blood cells. Anatomical and medical terminology often use the prefix hepat- from \u1f21\u03c0\u03b1\u03c4\u03bf-, from the Greek word for liver, such as hepatology, and hepatitis. The liver is also an accessory digestive organ that produces bile, an alkaline fluid containing cholesterol and bile acids,  which emulsifies and aids the breakdown of dietary fat. The gallbladder, a small hollow pouch that sits just under the right lobe of liver, stores and concentrates the bile produced by the liver, which is later excreted to the duodenum to help with digestion."}}, {"canonical_name": "Venus", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 5, "total_mentions": 97, "members": [{"entity_id": "venus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Venus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Venus"], "contexts": ["goddess associated with attraction"]}, {"entity_id": "venus", "book_id": "english_physician_1652", "name": "Venus", "category": "CONCEPT", "subcategory": "THEORY", "count": 67, "variants": ["Venus"], "contexts": ["planet associated with generation instruments", "planet that governs the French Pox"]}, {"entity_id": "venus", "book_id": "polyanthea_medicinal", "name": "Venus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 16, "variants": ["venus", "Venus"], "contexts": ["sexual intercourse", "sexual activity"]}, {"entity_id": "v\u00e9nus", "book_id": "relation_historique_humboldt_vol3_1825", "name": "V\u00e9nus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["V\u00e9nus"], "contexts": ["celestial body observed"]}, {"entity_id": "v\u00e9nus", "book_id": "coloquios_da_orta_1563", "name": "V\u00e9nus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["V\u00e9nus"], "contexts": ["planet associated with inclination to scent", "title of the section"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Venus", "target_book": "english_physician_1652", "target_name": "Venus", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Venus", "target_book": "polyanthea_medicinal", "target_name": "Venus", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Venus", "target_book": "polyanthea_medicinal", "target_name": "Venus", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "V\u00e9nus", "target_book": "coloquios_da_orta_1563", "target_name": "V\u00e9nus", "similarity": 1.0}], "id": 70, "stable_key": "clu_b88070be4821bd3e", "ground_truth": {"modern_name": "Venus", "confidence": "high", "type": "concept", "description": "Relates to sexual desire, intercourse, and the planet Venus.", "note": "Can refer to the act of sex ('Venery') or the planet 'Venus'.", "wikipedia_extract": "Venus is the second planet from the Sun. It is often called Earth's \"twin\" or \"sister\" among the planets of the Solar System for its orbit being the closest to Earth's, both being terrestrial planets, and having the most similar and nearly equal size, mass, and surface gravity. Venus, though, is significantly different, especially as it has no liquid water, and its atmosphere is far thicker and denser than that of any other rocky body in the Solar System. The atmosphere is composed mostly of carbon dioxide and has a thick cloud layer of sulfuric acid that spans the whole planet. At the mean surface level, the atmosphere reaches a temperature of 737 K (464 \u00b0C; 867 \u00b0F) and a pressure 92 times greater than Earth's at sea level, turning the lowest layer of the atmosphere into a supercritical fluid. From Earth, Venus is visible as a star-like point of light, appearing brighter than any other natural point of light in the sky, and as an inferior planet it is always relatively close to the Sun, either as the brightest \"morning star\" or \"evening star\"."}}, {"canonical_name": "sal", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 5, "total_mentions": 96, "members": [{"entity_id": "salt", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Salt", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 12, "variants": ["Salt", "salt"], "contexts": ["crystalline mineral compound", "substance to make waters wholesome"]}, {"entity_id": "salt", "book_id": "english_physician_1652", "name": "Salt", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 24, "variants": ["Salt", "Salts"], "contexts": ["ingredient used with herb", "used with Balm"]}, {"entity_id": "sal", "book_id": "coloquios_da_orta_1563", "name": "sal", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 11, "variants": ["sal", "Sal"], "contexts": ["Salt", "used to preserve green anacardo"]}, {"entity_id": "sal", "book_id": "polyanthea_medicinal", "name": "sal", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 44, "variants": ["sal", "Sal"], "contexts": ["salt, a mineral", "added to water for preparation"]}, {"entity_id": "salt", "book_id": "connexion_physical_sciences_somerville_1858", "name": "salt", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["Salt", "salt"], "contexts": ["collector of Egyptian antiquities", "absorbs moisture via capillary action"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Salt", "target_book": "english_physician_1652", "target_name": "Salt", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Salt", "target_book": "coloquios_da_orta_1563", "target_name": "sal", "similarity": 0.963}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Salt", "target_book": "polyanthea_medicinal", "target_name": "sal", "similarity": 0.963}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Salt", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "salt", "similarity": 0.988}, {"source_book": "english_physician_1652", "source_name": "Salt", "target_book": "coloquios_da_orta_1563", "target_name": "sal", "similarity": 0.963}, {"source_book": "english_physician_1652", "source_name": "Salt", "target_book": "polyanthea_medicinal", "target_name": "sal", "similarity": 0.963}, {"source_book": "english_physician_1652", "source_name": "Salt", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "salt", "similarity": 0.988}, {"source_book": "coloquios_da_orta_1563", "source_name": "sal", "target_book": "polyanthea_medicinal", "target_name": "sal", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "sal", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "salt", "similarity": 0.967}, {"source_book": "polyanthea_medicinal", "source_name": "sal", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "salt", "similarity": 0.967}], "id": 71, "stable_key": "clu_b7cebce5bcfaf712", "ground_truth": {"modern_name": "Salt", "confidence": "high", "type": "chemical", "note": "Refers to sodium chloride (NaCl), a fundamental chemical compound.", "wikidata_id": "Q2314", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Sodium%20chloride", "wikipedia_extract": "Sodium chloride , commonly known as table salt, is an ionic compound with the chemical formula NaCl, representing a 1:1 ratio of sodium and chloride ions. It is transparent or translucent, brittle, hygroscopic, and occurs as the mineral halite. In its edible form, it is commonly used as a condiment and food preservative. Large quantities of sodium chloride are used in many industrial processes, and it is a major source of sodium and chlorine compounds used as feedstocks for further chemical syntheses. Another major application of sodium chloride is de-icing of roadways in sub-freezing weather. In addition to the many familiar domestic uses of salt, more dominant applications of the approximately 250 million tonnes per year production (2008 data) include chemicals and de-icing."}}, {"canonical_name": "Swellings", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 5, "total_mentions": 96, "members": [{"entity_id": "swellings", "book_id": "english_physician_1652", "name": "Swellings", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 69, "variants": ["Swellings", "Swelings", "Swelling", "Swellings of the Spleen", "Swel\u2223lings", "Swounings", "Swou\u2223nings", "sweatings", "swelling", "swellings", "swellings of the Spleen", "swel\u2223lings", "swounings"], "contexts": ["condition treated by Alder-Tree leaves", "condition treated by Angelica"]}, {"entity_id": "swelling", "book_id": "principles_of_psychology_james_1890", "name": "swelling", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["swelling"], "contexts": ["enlargement of body part"]}, {"entity_id": "swelling", "book_id": "coloquios_da_orta_1563", "name": "swelling", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["swelling"], "contexts": ["abnormal enlargement of body part"]}, {"entity_id": "swelling", "book_id": "ricettario_fiorentino_1597", "name": "Swelling", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["Swelling"], "contexts": ["enlargement of body part"]}, {"entity_id": "swelling", "book_id": "polyanthea_medicinal", "name": "swelling", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 24, "variants": ["swelling", "Swelling"], "contexts": ["a common symptom", "enlargement of a body part"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Swellings", "target_book": "principles_of_psychology_james_1890", "target_name": "swelling", "similarity": 0.944}, {"source_book": "english_physician_1652", "source_name": "Swellings", "target_book": "coloquios_da_orta_1563", "target_name": "swelling", "similarity": 0.944}, {"source_book": "english_physician_1652", "source_name": "Swellings", "target_book": "ricettario_fiorentino_1597", "target_name": "Swelling", "similarity": 0.971}, {"source_book": "english_physician_1652", "source_name": "Swellings", "target_book": "polyanthea_medicinal", "target_name": "swelling", "similarity": 0.944}, {"source_book": "principles_of_psychology_james_1890", "source_name": "swelling", "target_book": "coloquios_da_orta_1563", "target_name": "swelling", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "swelling", "target_book": "ricettario_fiorentino_1597", "target_name": "Swelling", "similarity": 0.933}, {"source_book": "principles_of_psychology_james_1890", "source_name": "swelling", "target_book": "polyanthea_medicinal", "target_name": "swelling", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "swelling", "target_book": "ricettario_fiorentino_1597", "target_name": "Swelling", "similarity": 0.933}, {"source_book": "coloquios_da_orta_1563", "source_name": "swelling", "target_book": "polyanthea_medicinal", "target_name": "swelling", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Swelling", "target_book": "polyanthea_medicinal", "target_name": "swelling", "similarity": 0.933}], "id": 72, "stable_key": "clu_4fc4e5e59a2e3991", "ground_truth": {"modern_name": "Swelling", "confidence": "high", "type": "disease", "modern_term": "Edema", "wikidata_id": "Q953049", "wikidata_description": "human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Papilledema", "note": "While 'dropsy' is an older term, it directly refers to edema, especially when localized or generalized fluid accumulation.", "wikipedia_extract": "Papilledema or papilloedema is optic disc swelling that is caused by increased intracranial pressure due to any cause. The swelling is usually bilateral and can occur over a period of hours to weeks. Unilateral presentation is extremely rare. In intracranial hypertension, the optic disc swelling most commonly occurs bilaterally. When papilledema is found on fundoscopy, further evaluation is warranted because vision loss can result if the underlying condition is not treated. Further evaluation with a CT scan or MRI of the brain and/or spine is usually done.", "description": "Abnormal enlargement or puffiness of a body part."}}, {"canonical_name": "Motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 95, "members": [{"entity_id": "motion", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Motion", "motion"], "contexts": ["act of moving", "prerequisite for birth"]}, {"entity_id": "motion", "book_id": "principles_of_psychology_james_1890", "name": "motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["motion"], "contexts": ["physical movement or action", "physical movement"]}, {"entity_id": "motion", "book_id": "kosmos_humboldt_1845", "name": "motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["motion"], "contexts": ["movement of heavenly bodies", "fundamental principle in nature"]}, {"entity_id": "motion", "book_id": "connexion_physical_sciences_somerville_1858", "name": "motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 20, "variants": ["motion", "Motion"], "contexts": ["change in position", "change in position over time"]}, {"entity_id": "motion", "book_id": "first_principles_spencer_1862", "name": "Motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 62, "variants": ["motion", "MOTION", "Motion"], "contexts": ["fundamental concept of physics", "self-existent, adequate cause of appearance"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Motion", "target_book": "principles_of_psychology_james_1890", "target_name": "motion", "similarity": 0.989}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Motion", "target_book": "kosmos_humboldt_1845", "target_name": "motion", "similarity": 0.989}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Motion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "motion", "similarity": 0.989}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Motion", "target_book": "first_principles_spencer_1862", "target_name": "Motion", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "motion", "target_book": "kosmos_humboldt_1845", "target_name": "motion", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "motion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "motion", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "motion", "target_book": "first_principles_spencer_1862", "target_name": "Motion", "similarity": 0.989}, {"source_book": "kosmos_humboldt_1845", "source_name": "motion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "motion", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "motion", "target_book": "first_principles_spencer_1862", "target_name": "Motion", "similarity": 0.989}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "motion", "target_book": "first_principles_spencer_1862", "target_name": "Motion", "similarity": 0.989}], "id": 73, "stable_key": "clu_63aa0520937b163f", "ground_truth": {"modern_name": "Motion", "confidence": "high", "type": "concept", "wikidata_id": "Q79782", "wikidata_description": "change in position of an object over time; a body is said to be in motion if it changes its position or orientation with respect to its immediate surroundings", "wikipedia_url": "https://en.wikipedia.org/wiki/Motion", "wikipedia_extract": "In physics, motion is when an object changes its position with respect to a reference point in a given time. Motion is mathematically described in terms of displacement, distance, velocity, acceleration, speed, and frame of reference to an observer, measuring the change in position of the body relative to that frame with a change in time. The branch of physics describing the motion of objects without reference to their cause is called kinematics, while the branch studying forces and their effect on motion is called dynamics. If an object is not in motion relative to a given frame of reference, it is said to be at rest, motionless, immobile, stationary, or to have a constant or time-invariant position with reference to its surroundings. Modern physics holds that, as there is no absolute frame of reference, Isaac Newton's concept of absolute motion cannot be determined. Everything in the universe can be considered to be in motion.", "note": "While 'motet' is a musical term, the context of 'first principles' and physical sciences strongly suggests 'motion' as the primary concept. 'Motus' is Latin for motion."}}, {"canonical_name": "terre", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 5, "total_mentions": 94, "members": [{"entity_id": "terre", "book_id": "medecine_experimentale_bernard_1865", "name": "terre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["terre"], "contexts": ["planet Earth", "the earth"]}, {"entity_id": "terre", "book_id": "epoques_nature_buffon_1778", "name": "terre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 51, "variants": ["terre", "TERRE"], "contexts": ["earth, as a body", "earth's interior heat and composition"]}, {"entity_id": "tierra", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "tierra", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["tierra"], "contexts": ["material to cover transplanted roots", "soil for planting and growing crops"]}, {"entity_id": "tierra", "book_id": "historia_medicinal_monardes_1574", "name": "tierra", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 9, "variants": ["tierra", "Tierra"], "contexts": ["land or region", "earth-like substance"]}, {"entity_id": "terra", "book_id": "ricettario_fiorentino_1597", "name": "terra", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 26, "variants": ["terra", "TERRA", "TERRA SIGILLATA", "Terra figiUata", "Terra figillata", "Terra lemnia", "terra figillata", "terra lennia"], "contexts": ["earth used in medicine", "earthen vessels for storage"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "terre", "target_book": "epoques_nature_buffon_1778", "target_name": "terre", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "terre", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "tierra", "similarity": 0.971}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "terre", "target_book": "historia_medicinal_monardes_1574", "target_name": "tierra", "similarity": 0.971}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "terre", "target_book": "ricettario_fiorentino_1597", "target_name": "terra", "similarity": 0.977}, {"source_book": "epoques_nature_buffon_1778", "source_name": "terre", "target_book": "ricettario_fiorentino_1597", "target_name": "terra", "similarity": 0.977}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "tierra", "target_book": "historia_medicinal_monardes_1574", "target_name": "tierra", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "tierra", "target_book": "ricettario_fiorentino_1597", "target_name": "terra", "similarity": 0.988}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "tierra", "target_book": "ricettario_fiorentino_1597", "target_name": "terra", "similarity": 0.988}], "id": 74, "stable_key": "clu_359477f10a3a8db6", "ground_truth": {"modern_name": "Earth", "confidence": "high", "type": "mineral", "note": "The term 'terra' (Spanish/Portuguese) and 'earth' (English) refers to soil, land, or the element earth in classical and early modern contexts.", "wikidata_id": "Q36133", "wikidata_description": "natural body consisting of layers that are primarily composed of minerals", "wikipedia_url": "https://en.wikipedia.org/wiki/Soil", "country": "Global", "wikipedia_extract": "Soil, also commonly referred to as earth, is a mixture of organic matter, minerals, gases, water, and organisms that together support the life of plants and soil organisms. Some scientific definitions distinguish dirt from soil by restricting the former term specifically to displaced soil. Soil consists of a solid collection of minerals and organic matter (the soil matrix), as well as a porous phase that holds gases (the soil atmosphere) and a liquid phase that holds water and dissolved substances both organic and inorganic, in ionic or in molecular form (the soil solution). Accordingly, soil is a complex three-state system of solids, liquids, and gases. Soil is a product of several factors: the influence of climate, relief (elevation, orientation, and slope of terrain), organisms, and the soil's parent materials (original minerals) interacting over time. It continually undergoes development by way of numerous physical, chemical and biological processes, which include weathering with associated erosion."}}, {"canonical_name": "Asie", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 5, "total_mentions": 93, "members": [{"entity_id": "asia", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Asia", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Asia"], "contexts": ["continent influencing compass variation", "continent in Eurasia"]}, {"entity_id": "asie", "book_id": "epoques_nature_buffon_1778", "name": "Asie", "category": "PLACE", "subcategory": "COUNTRY", "count": 28, "variants": ["Asie"], "contexts": ["region where elephant skeletons are found", "northern region where ivory is found"]}, {"entity_id": "asie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Asie", "category": "PLACE", "subcategory": "COUNTRY", "count": 32, "variants": ["Asie"], "contexts": ["continent mentioned for customs", "region with mountains"]}, {"entity_id": "asia", "book_id": "kosmos_humboldt_1845", "name": "Asia", "category": "PLACE", "subcategory": "COUNTRY", "count": 24, "variants": ["Asia"], "contexts": ["direction of Asia", "western peninsula of Europe"]}, {"entity_id": "asia", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Asia", "category": "PLACE", "subcategory": "COUNTRY", "count": 7, "variants": ["Asia"], "contexts": ["continent", "continent with steppes"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Asia", "target_book": "epoques_nature_buffon_1778", "target_name": "Asie", "similarity": 0.975}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Asia", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Asie", "similarity": 0.975}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Asia", "target_book": "kosmos_humboldt_1845", "target_name": "Asia", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Asia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Asia", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Asie", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Asie", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Asie", "target_book": "kosmos_humboldt_1845", "target_name": "Asia", "similarity": 0.975}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Asie", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Asia", "similarity": 0.975}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Asie", "target_book": "kosmos_humboldt_1845", "target_name": "Asia", "similarity": 0.975}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Asie", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Asia", "similarity": 0.975}, {"source_book": "kosmos_humboldt_1845", "source_name": "Asia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Asia", "similarity": 1.0}], "id": 75, "stable_key": "clu_f13b617f6c0f0df6", "ground_truth": {"modern_name": "Asia", "confidence": "high", "type": "place", "country": "Asia", "wikidata_id": "Q210718", "wikidata_description": "Roman province", "wikipedia_url": "https://en.wikipedia.org/wiki/Asia%20%28Roman%20province%29", "note": "Historically referred to a vast region of Asia, often encompassing South Asia and Southeast Asia.", "wikipedia_extract": "Asia (Ancient Greek: \u1f08\u03c3\u03af\u03b1) was a Roman province covering most of western Asia Minor (Anatolia, Turkey), which was created following the Roman Republic's annexation of the Attalid Kingdom in 133 BC. After the establishment of the Roman Empire by Augustus, it was the most prestigious senatorial province and was governed by a proconsul. That arrangement endured until the province was subdivided in the fourth century AD. The province was one of the richest of the Empire and was at peace for most of the Imperial period. It contained hundreds of largely self-governing Greek city-states, who competed fiercely with one another for status, through appeals to the Imperial authorities and the cultivation of prestigious cultural institutions such as festival games, religious cults, and oratory. The province of Asia originally consisted of the territories of Mysia, the Troad, Aeolis, Lydia, Ionia, Caria, and the land corridor through Pisidia to Pamphylia."}}, {"canonical_name": "gregos", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 5, "total_mentions": 92, "members": [{"entity_id": "greeks", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Greeks", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 6, "variants": ["Greeks"], "contexts": ["people speaking Greek", "people who transcribed Latin texts"]}, {"entity_id": "grecs", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Grecs", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Grecs"], "contexts": ["ancient people from Greece", "ancient people with slave prices"]}, {"entity_id": "greeks", "book_id": "kosmos_humboldt_1845", "name": "Greeks", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 11, "variants": ["Greeks"], "contexts": ["ancient civilization known for philosophy", "ancient civilization interpreting nature"]}, {"entity_id": "griegos", "book_id": "historia_medicinal_monardes_1574", "name": "Griegos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 8, "variants": ["Griegos"], "contexts": ["ancient Greek authorities on dragon's blood", "ancient sources of knowledge"]}, {"entity_id": "gregos", "book_id": "coloquios_da_orta_1563", "name": "gregos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 65, "variants": ["gregos", "Gr^uos", "Greggos", "Gregos", "Gregos modernos"], "contexts": ["ancient people mentioned", "people who did not speak about amber"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Greeks", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Grecs", "similarity": 0.983}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Greeks", "target_book": "kosmos_humboldt_1845", "target_name": "Greeks", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Greeks", "target_book": "historia_medicinal_monardes_1574", "target_name": "Griegos", "similarity": 0.965}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Greeks", "target_book": "coloquios_da_orta_1563", "target_name": "gregos", "similarity": 0.959}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Grecs", "target_book": "kosmos_humboldt_1845", "target_name": "Greeks", "similarity": 0.983}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Grecs", "