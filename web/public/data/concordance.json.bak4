": "fiebres", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "fiebres", "category": "DISEASE", "subcategory": "ACUTE", "count": 13, "variants": ["fiebres"], "contexts": ["fevers of any cause", "fevers healed by tree sap"]}, {"entity_id": "fevers", "book_id": "principles_of_psychology_james_1890", "name": "fevers", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["fevers"], "contexts": ["condition that can resuscitate forgotten things"]}, {"entity_id": "fiebres", "book_id": "historia_medicinal_monardes_1574", "name": "fiebres", "category": "DISEASE", "subcategory": "ACUTE", "count": 30, "variants": ["fiebres", "fiebre", "fiebre mala", "fiebres agudas", "fiebres arfiuas", "fiebres calientes", "fiebres de mala qualidad", "fiebres erraticas", "fiebres largas importunas", "fiebres largas y importunas", "fiebres malignas", "fiebres peltilenciales", "fiebres peltilneciales", "fiebres pestilenciales", "fiebres pestilentes"], "contexts": ["acute illness treated with gargaparrilla water", "fevers, long and troublesome"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Fevers", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "fiebres", "similarity": 0.961}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Fevers", "target_book": "principles_of_psychology_james_1890", "target_name": "fevers", "similarity": 0.994}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Fevers", "target_book": "historia_medicinal_monardes_1574", "target_name": "fiebres", "similarity": 0.961}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "fiebres", "target_book": "principles_of_psychology_james_1890", "target_name": "fevers", "similarity": 0.964}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "fiebres", "target_book": "historia_medicinal_monardes_1574", "target_name": "fiebres", "similarity": 1.0}], "id": 394, "stable_key": "clu_6223dcf2803ef3cf", "ground_truth": {"modern_name": "Fever", "confidence": "high", "type": "disease", "modern_term": "Fever", "wikidata_id": "Q38933", "wikidata_description": "common medical sign characterized by elevated body temperature", "wikipedia_url": "https://en.wikipedia.org/wiki/Fever", "wikipedia_extract": "Fever or pyrexia in humans is a symptom of an anti-infection defense mechanism that appears with body temperature exceeding the normal range caused by an increase in the body's temperature set point in the hypothalamus. There is no single agreed-upon upper limit for normal temperature: sources use values ranging between 37.2 and 38.3 \u00b0C (99.0 and 100.9 \u00b0F) in humans. The increase in set point triggers increased muscle contractions and causes a feeling of cold or chills. This results in greater heat production and efforts to conserve heat. When the set point temperature returns to normal, a person feels hot, becomes flushed, and may begin to sweat. Rarely a fever may trigger a febrile seizure, with this being more common in young children.", "description": "An acute illness characterized by elevated body temperature and potential delirium."}}, {"canonical_name": "Chili", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 4, "total_mentions": 46, "members": [{"entity_id": "chili", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Chili", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Chili"], "contexts": ["country in Western South America"]}, {"entity_id": "chili", "book_id": "epoques_nature_buffon_1778", "name": "Chili", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Chili"], "contexts": ["highlands where humans established"]}, {"entity_id": "chili", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Chili", "category": "PLACE", "subcategory": "COUNTRY", "count": 34, "variants": ["Chili"], "contexts": ["country inhabited by people compared to Caribes", "geographic location with pronounced soil features"]}, {"entity_id": "chili", "book_id": "kosmos_humboldt_1845", "name": "Chili", "category": "PLACE", "subcategory": "COUNTRY", "count": 10, "variants": ["Chili"], "contexts": ["coast with earthquake example", "South American country"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Chili", "target_book": "epoques_nature_buffon_1778", "target_name": "Chili", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Chili", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Chili", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Chili", "target_book": "kosmos_humboldt_1845", "target_name": "Chili", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Chili", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Chili", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Chili", "target_book": "kosmos_humboldt_1845", "target_name": "Chili", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Chili", "target_book": "kosmos_humboldt_1845", "target_name": "Chili", "similarity": 1.0}], "id": 395, "stable_key": "clu_5a20c0ef22ae9577", "ground_truth": {"modern_name": "Chile", "confidence": "high", "type": "place", "description": "A country in South America, known for its geography and inhabitants.", "wikipedia_extract": "Chile, officially the Republic of Chile, is a country in western South America. It is the southernmost country in the world and the closest to Antarctica, extending along a narrow strip of land between the Andes Mountains and the Pacific Ocean. According to the 2024 census, Chile had an enumerated population of 18.5 million. The country covers a territorial area of 756,102 square kilometers (291,933 sq mi), sharing borders with Peru to the north, Bolivia to the northeast, Argentina to the east, and the Drake Passage to the south. It also administers several Pacific islands, including Juan Fern\u00e1ndez, Isla Salas y G\u00f3mez, Desventuradas, and Easter Island, and claims about 1,250,000 square kilometers (480,000 sq mi) of Antarctica as the Chilean Antarctic Territory. The capital and largest city is Santiago, and the national language is Spanish."}}, {"canonical_name": "Lima", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 46, "members": [{"entity_id": "lima", "book_id": "epoques_nature_buffon_1778", "name": "Lima", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Lima"], "contexts": ["city where Cordilleras curve east"]}, {"entity_id": "lima", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Lima", "category": "PLACE", "subcategory": "CITY", "count": 33, "variants": ["Lima"], "contexts": ["city in Peru", "capital of Peru"]}, {"entity_id": "lima", "book_id": "kosmos_humboldt_1845", "name": "Lima", "category": "PLACE", "subcategory": "CITY", "count": 9, "variants": ["Lima"], "contexts": ["capital of Peru", "city near magnetic equator intersection"]}, {"entity_id": "lima", "book_id": "historia_medicinal_monardes_1574", "name": "Lima", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Lima"], "contexts": ["city where the letter was written", "city in Peru"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Lima", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Lima", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Lima", "target_book": "kosmos_humboldt_1845", "target_name": "Lima", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Lima", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lima", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lima", "target_book": "kosmos_humboldt_1845", "target_name": "Lima", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lima", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lima", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Lima", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lima", "similarity": 1.0}], "id": 396, "stable_key": "clu_233ef58496bf7dbe", "ground_truth": {"modern_name": "Lima", "confidence": "high", "type": "place", "description": "Capital city of Peru, located on the Pacific coast.", "wikipedia_extract": "Lima is the capital and largest city of Peru. It is located in the valleys of the Chill\u00f3n, R\u00edmac and Lur\u00edn Rivers, in the desert zone of the central coastal part of the country, overlooking the Pacific Ocean. The city is considered the political, cultural, financial and commercial center of Peru. Due to its geostrategic importance, the Globalization and World Cities Research Network has categorized it as a \"beta\" tier city. Jurisdictionally, the metropolis extends mainly within the province of Lima and in a smaller portion, to the west, within the Constitutional Province of Callao, where the seaport and the Jorge Ch\u00e1vez Airport are located. Both provinces have had regional autonomy since 2002."}}, {"canonical_name": "enfermidades", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 4, "total_mentions": 44, "members": [{"entity_id": "maladies", "book_id": "medecine_experimentale_bernard_1865", "name": "maladies", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 14, "variants": ["maladies"], "contexts": ["medical conditions", "conditions of ill health"]}, {"entity_id": "maladies", "book_id": "relation_historique_humboldt_vol3_1825", "name": "maladies", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["maladies"], "contexts": ["Cause of death for non-acclimated whites"]}, {"enti