f_species_darwin_1859", "name": "northern hemisphere", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["northern hemisphere"], "contexts": ["hemisphere north of the equator"]}, {"entity_id": "western_hemisphere", "book_id": "kosmos_humboldt_1845", "name": "Western hemisphere", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Western hemisphere"], "contexts": ["geographic division"]}, {"entity_id": "southern_hemisphere", "book_id": "connexion_physical_sciences_somerville_1858", "name": "southern hemisphere", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["southern hemisphere"], "contexts": ["half of celestial sphere south of ecliptic", "half of the Earth south of the equator"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "northern hemisphere", "target_book": "kosmos_humboldt_1845", "target_name": "Western hemisphere", "similarity": 0.931}, {"source_book": "origin_of_species_darwin_1859", "source_name": "northern hemisphere", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "southern hemisphere", "similarity": 0.951}, {"source_book": "kosmos_humboldt_1845", "source_name": "Western hemisphere", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "southern hemisphere", "similarity": 0.942}], "id": 1435, "stable_key": "clu_0e1cf682ca26b371", "ground_truth": {"modern_name": "Southern Hemisphere", "confidence": "high", "type": "place", "wikidata_id": "Q41228", "wikidata_description": "part of Earth that lies south of the equator", "wikipedia_url": "https://en.wikipedia.org/wiki/Southern%20Hemisphere", "wikipedia_extract": "The Southern Hemisphere is the half (hemisphere) of Earth that is south of the equator. It contains all or part of five continents (the whole of Antarctica, the whole of Australia, about 90% of South America, about one-third of Africa, and some islands off the continental mainland of Asia) and four oceans (the whole Southern Ocean, the majority of the Indian Ocean, the South Atlantic Ocean, and the South Pacific Ocean), as well as New Zealand and most of the Pacific Islands in Oceania. Its surface is 80.9% water, compared with 60.7% water in the Northern Hemisphere, and it contains 32.7% of Earth's land. More than 850 million people live in the Southern Hemisphere, representing around 10\u201312% of the total global human population. Owing to the tilt of Earth's rotation relative to the Sun and the ecliptic plane, summer is from December to February (inclusive) and winter is from June to August (inclusive). September 22 or 23 is the vernal equinox and March 20 or 21 is the autumnal equinox."}}, {"canonical_name": "Richardson", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "m__richard", "book_id": "origin_of_species_darwin_1859", "name": "M. Richard", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["M. Richard"], "contexts": ["sagaciously saw genus retention"]}, {"entity_id": "richard", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Richard", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Richard"], "contexts": ["author of manuscripts"]}, {"entity_id": "richardson", "book_id": "kosmos_humboldt_1845", "name": "Richardson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Richardson"], "contexts": ["observed clouds near American north pole", "observed Aurora near the north pole"]}, {"entity_id": "richard", "book_id": "kosmos_humboldt_1845", "name": "Richard", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Richard"], "contexts": ["botanist who published memoir"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "M. Richard", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Richard", "similarity": 0.914}, {"source_book": "origin_of_species_darwin_1859", "source_name": "M. Richard", "target_book": "kosmos_humboldt_1845", "target_name": "Richard", "similarity": 0.914}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Richard", "target_book": "kosmos_humboldt_1845", "target_name": "Richardson", "similarity": 0.834}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Richard", "target_book": "kosmos_humboldt_1845", "target_name": "Richard", "similarity": 1.0}], "id": 1436, "stable_key": "clu_c12e210cba61bc73", "ground_truth": {"modern_name": "Sir John Richardson", "confidence": "medium", "type": "person", "birth_year": 1787, "death_year": 1865, "description": "Arctic explorer and naturalist, observed clouds.", "note": "Multiple 'Richardson' figures could fit the context of arctic exploration and observation. Sir John Richardson is a strong candidate given the historical context of Darwin and Humboldt's writings. The reference to 'clouds near American north pole' strongly suggests him.", "wikidata_id": "Q545944", "wikidata_description": "Scottish naval surgeon, naturalist and arctic explorer (1787\u20131865)", "wikipedia_url": "https://en.wikipedia.org/wiki/John%20Richardson%20%28naturalist%29", "wikipedia_extract": "Sir John Richardson FRS FRSE (5 November 1787 \u2013 5 June 1865) was a Scottish naval surgeon, naturalist and Arctic explorer. Richardson was born at Nith Place in Dumfries the son of Gabriel Richardson, Provost of Dumfries, and his wife, Anne Mundell. He was educated at Dumfries Grammar School. He was then apprenticed to his maternal uncle, Dr James Mundell, a surgeon in Dumfries. Richardson studied medicine at Edinburgh University, and became a surgeon in the navy in 1807. He traveled with John Franklin in search of the Northwest Passage on the Coppermine Expedition of 1819\u20131822."}}, {"canonical_name": "Islas Philipinas", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "islas_philipinas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Islas Philipinas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Islas Philipinas"], "contexts": ["location where copal grows copiously", "Philippine Islands"]}, {"entity_id": "\u00eeles_philippines", "book_id": "relation_historique_humboldt_vol3_1825", "name": "\u00eeles Philippines", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["\u00eeles Philippines", "Iles Philipi)ines"], "contexts": ["islands for new route", "towards the Philippine Islands"]}, {"entity_id": "philippine_islands", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Philippine Islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Philippine Islands"], "contexts": ["islands in Southeast Asia"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Islas Philipinas", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "\u00eeles Philippines", "similarity": 0.964}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Islas Philipinas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Philippine Islands", "similarity": 0.958}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "\u00eeles Philippines", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Philippine Islands", "similarity": 0.961}], "id": 1437, "stable_key": "clu_50aac63513850908", "ground_truth": {"modern_name": "Philippines", "confidence": "high", "type": "place", "description": "Archipelago and fertile district, historically known as Filipinas.", "wikipedia_extract": "The Philippines, officially the Republic of the Philippines, is an archipelagic country in Southeast Asia. Located in the western Pacific Ocean, it consists of about 7,641 islands, with a total area of about 300,000 square kilometers, which are broadly categorized in three main geographical divisions from north to south: Luzon, Visayas, and Mindanao. With a population of over 112 million, it is the world's fourteenth-most-populous country. The Philippines is bounded by the South China Sea to the west, the Philippine Sea to the east, and the Celebes Sea to the south. It shares maritime borders with Taiwan to the north, Japan to the northeast, Palau to the east and southeast, Indonesia to the south, Malaysia to the southwest, Vietnam to the west, and China to the northwest. It has diverse ethnicities and a rich culture."}}, {"canonical_name": "palo santo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "palo_santo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "palo santo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["palo santo"], "contexts": ["tree known as guayacan", "a medicinal tree species"]}, {"entity_id": "palo_santo", "book_id": "historia_medicinal_monardes_1574", "name": "Palo santo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Palo santo"], "contexts": ["specific type of Palo plant", "plant used in medicinal preparations"]}, {"entity_id": "p\u00e0o_santo", "book_id": "polyanthea_medicinal", "name": "p\u00e0o santo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["p\u00e0o santo", "pao santo"], "contexts": ["wood used in sweat preparation", "plant used in remedies"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "palo santo", "target_book": "historia_medicinal_monardes_1574", "target_name": "Palo santo", "similarity": 0.934}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "palo santo", "target_book": "polyanthea_medicinal", "target_name": "p\u00e0o santo", "similarity": 0.893}], "id": 1438, "stable_key": "clu_7ffac84139624ff3", "ground_truth": {"modern_name": "Palo santo", "confidence": "high", "type": "plant", "note": "Multiple species can be referred to as palo santo, and precise identification without more context is difficult. The genera Bursera and Bulnesia are common.", "wikidata_id": "Q2051175", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Guaiacum%20officinale"}}, {"canonical_name": "algod\u00f3n", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "algod\u00f3n", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "algod\u00f3n", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["algod\u00f3n"], "contexts": ["plant fiber", "fiber used for cloth"]}, {"entity_id": "algodon", "book_id": "historia_medicinal_monardes_1574", "name": "Algodon", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Algodon"], "contexts": ["plant product brought from the Indies"]}, {"entity_id": "algodao", "book_id": "polyanthea_medicinal", "name": "algodao", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["algodao"], "contexts": ["used for application", "plant fiber used in medicine"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "algod\u00f3n", "target_book": "historia_medicinal_monardes_1574", "target_name": "Algodon", "similarity": 0.861}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "algod\u00f3n", "target_book": "polyanthea_medicinal", "target_name": "algodao", "similarity": 0.913}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Algodon", "target_book": "polyanthea_medicinal", "target_name": "algodao", "similarity": 0.891}], "id": 1439, "stable_key": "clu_e3c9b651b171a9d4", "ground_truth": {"modern_name": "Cotton", "confidence": "high", "type": "plant", "linnaean": "Gossypium spp.", "family": "Malvaceae"}}, {"canonica