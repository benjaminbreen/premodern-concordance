inciples_spencer_1862", "target_name": "carbonate", "similarity": 0.911}, {"source_book": "kosmos_humboldt_1845", "source_name": "carbon", "target_book": "ricettario_fiorentino_1597", "target_name": "carboni", "similarity": 0.953}, {"source_book": "kosmos_humboldt_1845", "source_name": "carbon", "target_book": "first_principles_spencer_1862", "target_name": "carbon", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "carbon", "target_book": "first_principles_spencer_1862", "target_name": "carbonate", "similarity": 0.913}, {"source_book": "ricettario_fiorentino_1597", "source_name": "carboni", "target_book": "first_principles_spencer_1862", "target_name": "carbon", "similarity": 0.953}, {"source_book": "ricettario_fiorentino_1597", "source_name": "carboni", "target_book": "first_principles_spencer_1862", "target_name": "carbonate", "similarity": 0.908}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "carbone", "target_book": "historia_medicinal_monardes_1574", "target_name": "carbon", "similarity": 0.988}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "carbone", "target_book": "polyanthea_medicinal", "target_name": "carbonum", "similarity": 0.974}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "carbone", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "carbon", "similarity": 0.988}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "carbon", "target_book": "polyanthea_medicinal", "target_name": "carbonum", "similarity": 0.973}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "carbon", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "carbon", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "carbonum", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "carbon", "similarity": 0.973}], "id": 5, "stable_key": "clu_28fa5d0bf79c5484", "ground_truth": {"modern_name": "Carbon", "confidence": "high", "type": "chemical", "note": "References to 'carbon', 'carboni', and 'carbone' in chemical and scientific contexts indicate the element carbon. 'Carbonate' is a compound derived from it.", "wikidata_id": "Q623", "wikidata_description": "chemical element with symbol C and atomic number 6; common element of all known life", "wikipedia_url": "https://en.wikipedia.org/wiki/Carbon", "wikipedia_extract": "Carbon (from Latin  carbo 'coal') is a chemical element;  it has symbol C and atomic number 6. It is nonmetallic and tetravalent\u2014meaning that its atoms are able to form up to four covalent bonds due to its valence shell exhibiting 4 electrons. It belongs to group 14 of the periodic table. Carbon makes up about 0.025 percent of Earth's crust. Three isotopes occur naturally, 12C and 13C being stable, while 14C is a radionuclide, decaying with a half-life of 5,700 years. Carbon is one of the few elements known since antiquity."}}, {"canonical_name": "creation", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 8, "total_mentions": 26, "members": [{"entity_id": "cr\u00e9ation", "book_id": "epoques_nature_buffon_1778", "name": "cr\u00e9ation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cr\u00e9ation"], "contexts": ["act of bringing into existence"]}, {"entity_id": "creation", "book_id": "origin_of_species_darwin_1859", "name": "creation", "category": "CONCEPT", "subcategory": "THEORY", "count": 9, "variants": ["creation", "Creation"], "contexts": ["special act of creation", "theory of divine origin"]}, {"entity_id": "creation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "creation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["creation", "Creation"], "contexts": ["the universe and all within it", "act of bringing into existence"]}, {"entity_id": "creation", "book_id": "first_principles_spencer_1862", "name": "creation", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["creation"], "contexts": ["the act of bringing something into existence", "act of bringing something into existence"]}, {"entity_id": "creation", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Creation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Creation"], "contexts": ["the act of bringing the universe into existence"]}, {"entity_id": "creation", "book_id": "english_physician_1652", "name": "Creation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Creation"], "contexts": ["harmony and wisdom of God"]}, {"entity_id": "creation", "book_id": "principles_of_psychology_james_1890", "name": "Creation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Creation", "creation"], "contexts": ["act of bringing into existence", "religious concept of origin"]}, {"entity_id": "creation", "book_id": "kosmos_humboldt_1845", "name": "Creation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Creation", "creation"], "contexts": ["the universe and its existence", "the act of making the world"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "cr\u00e9ation", "target_book": "origin_of_species_darwin_1859", "target_name": "creation", "similarity": 0.965}, {"source_book": "epoques_nature_buffon_1778", "source_name": "cr\u00e9ation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "creation", "similarity": 0.965}, {"source_book": "epoques_nature_buffon_1778", "source_name": "cr\u00e9ation", "target_book": "first_principles_spencer_1862", "target_name": "creation", "similarity": 0.965}, {"source_book": "origin_of_species_darwin_1859", "source_name": "creation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "creation", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "creation", "target_book": "first_principles_spencer_1862", "target_name": "creation", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "creation", "target_book": "first_principles_spencer_1862", "target_name": "creation", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Creation", "target_book": "english_physician_1652", "target_name": "Creation", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Creation", "target_book": "principles_of_psychology_james_1890", "target_name": "Creation", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Creation", "target_book": "kosmos_humboldt_1845", "target_name": "Creation", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Creation", "target_book": "principles_of_psychology_james_1890", "target_name": "Creation", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Creation", "target_book": "kosmos_humboldt_1845", "target_name": "Creation", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Creation", "target_book": "kosmos_humboldt_1845", "target_name": "Creation", "similarity": 1.0}], "id": 6, "stable_key": "clu_e83e8757ff966dee", "ground_truth": {"modern_name": "Creationism", "confidence": "high", "type": "concept", "note": "Contexts suggest a theory of how species originated, contrasting with Darwinian evolution.", "wikidata_id": "Q1430216", "wikidata_description": "doctrine that God creates a soul for each body that is generated, as opposed to pre-existing before birth or being generated during conception", "wikipedia_url": "https://en.wikipedia.org/wiki/Creationism%20%28soul%29", "wikipedia_extract": "Creationism is the religious belief that nature, and aspects such as the universe, Earth, life, and humans, originated with supernatural acts of divine creation, and is often pseudoscientific. In its broadest sense, creationism includes various religious views, which differ in their acceptance or rejection of modern scientific concepts, such as evolution, that describe the origin and development of natural phenomena. The term creationism most often refers to belief in special creation: the claim that the universe and lifeforms were created as they exist today by divine action, and that the only true explanations are those which are compatible with a Christian fundamentalist literal interpretation of the creation myth found in the Bible's Genesis creation narrative. Since the 1970s, the most common form of this has been Young Earth creationism which posits special creation of the universe and lifeforms within the last 10,000 years on the basis of flood geology, and promotes pseudoscientific creation science. From the 18th century onward, Old Earth creationism accepted geological time harmonized with Genesis through gap or day-age theory, while supporting anti-evolution. Modern old-Earth creationists support progressive creationism and continue to reject evolutionary explanations."}}, {"canonical_name": "Wood", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 8, "total_mentions": 21, "members": [{"entity_id": "wood", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Wood", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Wood", "wood"], "contexts": ["material that putrifies", "material that can be converted into iron"]}, {"entity_id": "wood", "book_id": "english_physician_1652", "name": "Wood", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Wood"], "contexts": ["splinters of wood drawn forth", "material of the Poplar tree"]}, {"entity_id": "madera", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "madera", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["madera"], "contexts": ["wood used for making fire", "material for handles"]}, {"entity_id": "wood", "book_id": "kosmos_humboldt_1845", "name": "wood", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["wood"], "contexts": ["material for floating device", "hard fibrous material of trees"]}, {"entity_id": "wood", "book_id": "coloquios_da_orta_1563", "name": "wood", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["wood"], "contexts": ["aloes wood"]}, {"entity_id": "timber", "book_id": "origin_of_species_darwin_1859", "name": "timber", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["timber"], "contexts": ["wood from trees"]}, {"entity_id": "wood", "book_id": "connexion_physical_sciences_somerville_1858", "name": "wood", "category": "PLANT", "subcategory": "TREE", "count": 6, "variants": ["wood"], "contexts": ["material of floating balls", "material for making pipes"]}, {"entity_id": "timber", "book_id": "first_principles_spencer_1862", "name": "timber", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["timber"], "contexts": ["material imported for railways"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Wood", "target_book": "english_physician_1652", "target_name": "Wood", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Wood", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "madera", "similarity": 0.951}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Wood", "target_book": "kosmos_humboldt_1845", "target_name": "wood", "similarity": 0.985}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Wood", "target_book": "coloquios_da_orta_1563", "target_name": "wood", "similarity": 0.985}, {"source_book": "english_physician_1652", "source_name": "Wood", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "madera", "similarity": 0.951}, {"source_book": "english_physician_1652", "source_name": "Wood", "target_book": "kosmos_humboldt_1845", "target_name": "wood", "similarity": 0.985}, {"source_book": "english_physician_1652", "source_name": "Wood", "target_book": "coloquios_da_orta_1563", "target_name": "wood", "similarity": 0.985}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "madera", "target_book": "kosmos_humboldt_1845", "target_name": "wood", "similarity": 0.963}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "madera", "target_book": "coloquios_da_orta_1563", "target_name": "wood", "similarity": 0.963}, {"source_book": "kosmos_humboldt_1845", "source_name": "wood", "target_book": "coloquios_da_orta_1563", "target_name": "wood", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "timber", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "wood", "similarity": 0.96}, {"source_book": "origin_of_species_darwin_1859", "source_name": "timber", "target_book": "first_principles_spencer_1862", "target_name": "timber", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "wood", "target_book": "first_principles_spencer_1862", "target_name": "timber", "similarity": 0.96}], "id": 7, "stable_key": "clu_8a1ea2407ba4f0ee", "ground_truth": {"modern_name": "Wood", "confidence": "high", "type": "concept", "note": "The context of 'timber', 'bois', and 'woods' consistently refers to the material derived from trees, used for construction, fuel, or as a habitat.", "wikidata_id": "Q105596644", "wikidata_description": "study of wood as a material and its physical, chemical, and biological characteristics", "wikipedia_url": "https://en.wikipedia.org/wiki/Wood%20science", "description": "The hard fibrous material forming the main substance of the trunk or branches of a tree or shrub.", "wikipedia_extract": "Wood is a structural tissue/material found as xylem in the stems and roots of trees and other woody plants. Being a natural material, it is characterized as an organic material \u2013 a natural composite of cellulosic fibers that are strong in tension and embedded in a matrix of lignin and hemicelluloses that resists compression. Wood is sometimes defined as only the secondary xylem in the stems of trees, or more broadly to include the same type of tissue elsewhere, such as in the roots of trees or shrubs. In a living tree, it performs a mechanical-support function, enabling woody plants to grow large or to stand up by themselves. It also conveys water and nutrients among the leaves, other growing tissues, and the roots. Wood may also refer to other plant materials with comparable properties, and to material engineered from wood, woodchips, or fibers."}}, {"canonical_name": "distillation", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 7, "total_mentions": 222, "members": [{"entity_id": "distillation", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "distillation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["distillation"], "contexts": ["operation of heating substances"]}, {"entity_id": "distillation", "book_id": "relation_historique_humboldt_vol3_1825", "name": "distillation", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 3, "variants": ["distillation"], "contexts": ["process of separating liquids by heating", "a process of separation by heating and cooling"]}, {"entity_id": "distillation", "book_id": "coloquios_da_orta_1563", "name": "distillation", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 30, "variants": ["distillation", "destila\u00e7\u00e3o", "distila\u00e7\u00e3o", "distilla^\u00e3o", "distillar"], "contexts": ["process of preparing substances", "implied alchemical practice"]}, {"entity_id": "distillation", "book_id": "polyanthea_medicinal", "name": "distillation", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 168, "variants": ["distillation", "Destillat .felt.", "Distillation", "destila\u00e7\u00e3o", "destillada", "destilladas", "destilla\u00e7\u00e3o", "distila\u00e7\u00e3o", "distillada", "distillar", "distillarem", "distillat", "distillatio", "distillatione", "distilla\u00e7\u00e3o", "distille"], "contexts": ["implied alchemical or medicinal process", "alchemical process"]}, {"entity_id": "distillation", "book_id": "first_principles_spencer_1862", "name": "distillation", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["distillation"], "contexts": ["process to separate alcohol from water"]}, {"entity_id": "distillation", "book_id": "english_physician_1652", "name": "Distillation", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 14, "variants": ["Distillation", "Distillati\u2223ons", "Distilled", "distill", "distillation", "distilled"], "contexts": ["process of separating liquids", "process to obtain water"]}, {"entity_id": "distillation", "book_id": "ricettario_fiorentino_1597", "name": "Distillation", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 5, "variants": ["Distillation", "distillation", "distillatona"], "contexts": ["practice mentioned in context of purification", "process of extracting liquids"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "distillation", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "distillation", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "distillation", "target_book": "coloquios_da_orta_1563", "target_name": "distillation", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "distillation", "target_book": "polyanthea_medicinal", "target_name": "distillation", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "distillation", "target_book": "first_principles_spencer_1862", "target_name": "distillation", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "distillation", "target_book": "coloquios_da_orta_1563", "target_name": "distillation", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "distillation", "target_book": "polyanthea_medicinal", "target_name": "distillation", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "distillation", "target_book": "first_principles_spencer_1862", "target_name": "distillation", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "distillation", "target_book": "polyanthea_medicinal", "target_name": "distillation", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "distillation", "target_book": "first_principles_spencer_1862", "target_name": "distillation", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "distillation", "target_book": "first_principles_spencer_1862", "target_name": "distillation", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Distillation", "target_book": "ricettario_fiorentino_1597", "target_name": "Distillation", "similarity": 1.0}], "id": 8, "stable_key": "clu_0b234c0df54c86c6", "ground_truth": {"modern_name": "distillation", "confidence": "high", "type": "concept", "description": "A process of heating and cooling to separate or purify substances.", "wikipedia_extract": "Distillation, also classical distillation, is the process of separating the component substances of a liquid mixture of two or more chemically discrete substances; the separation process is realized by way of the selective boiling of the mixture and the condensation of the vapors in a still. Distillation can operate over a wide range of pressures from 0.14 bar (e.g., ethylbenzene/styrene) to nearly 21 bar (e.g., propylene/propane) and is capable of separating feeds with high volumetric flowrates and various components that cover a range of relative volatilities from only 1.17 (o-xylene/m-xylene) to 81.2 (water/ethylene glycol). Distillation provides a convenient and time-tested solution to separate a diversity of chemicals in a continuous manner with high purity. However, distillation has an enormous environmental footprint, resulting in the consumption of approximately 25% of all industrial energy use. The key issue is that distillation operates based on phase changes, and this separation mechanism requires vast energy inputs. Dry distillation (thermolysis and pyrolysis) is the heating of solid materials to produce gases that condense either into fluid products or into solid products."}}, {"canonical_name": "Vomitos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 7, "total_mentions": 193, "members": [{"entity_id": "vomissement", "book_id": "epoques_nature_buffon_1778", "name": "vomissement", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["vomissement"], "contexts": ["expulsion of matter"]}, {"entity_id": "vomitings", "book_id": "english_physician_1652", "name": "Vomitings", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 22, "variants": ["Vomitings", "Vomi", "Vomiting", "Vomi\u2223ting", "Vomi\u2223tings"], "contexts": ["symptom caused by fresh bark", "condition stopped by Bistort"]}, {"entity_id": "vomilo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "vomilo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["vomilo"], "contexts": ["illness entering hospital", "disease affecting coastal inhabitants"]}, {"entity_id": "vomitos", "book_id": "historia_medicinal_monardes_1574", "name": "vomitos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["vomitos"], "contexts": ["symptom of illness", "expulsion of stomach contents"]}, {"entity_id": "vomitos", "book_id": "polyanthea_medicinal", "name": "Vomitos", "category": "DISEASE", "subcatego