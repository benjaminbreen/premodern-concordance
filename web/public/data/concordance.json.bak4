tures"]}, {"entity_id": "birds", "book_id": "origin_of_species_darwin_1859", "name": "birds", "category": "ANIMAL", "subcategory": "BIRD", "count": 34, "variants": ["Birds", "birds"], "contexts": ["transport misseltoe seeds", "disseminators of missletoe seeds"]}, {"entity_id": "birds", "book_id": "kosmos_humboldt_1845", "name": "birds", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["birds"], "contexts": ["feathered vertebrates"]}, {"entity_id": "birds", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Birds", "category": "ANIMAL", "subcategory": "BIRD", "count": 5, "variants": ["birds", "Birds"], "contexts": ["warm-blooded vertebrates with feathers", "singing of birds produces sound"]}, {"entity_id": "birds", "book_id": "first_principles_spencer_1862", "name": "birds", "category": "ANIMAL", "subcategory": "BIRD", "count": 11, "variants": ["birds", "Birds"], "contexts": ["larger division of animals", "heterogeneous vertebrate class"]}, {"entity_id": "birds", "book_id": "english_physician_1652", "name": "Birds", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Birds"], "contexts": ["creatures that eat Misselto berries"]}, {"entity_id": "birds", "book_id": "principles_of_psychology_james_1890", "name": "birds", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 8, "variants": ["birds"], "contexts": ["animals for experimentation", "animals for which Munk denies vision persistence"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Birds", "target_book": "origin_of_species_darwin_1859", "target_name": "birds", "similarity": 0.986}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Birds", "target_book": "kosmos_humboldt_1845", "target_name": "birds", "similarity": 0.986}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Birds", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Birds", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Birds", "target_book": "first_principles_spencer_1862", "target_name": "birds", "similarity": 0.986}, {"source_book": "origin_of_species_darwin_1859", "source_name": "birds", "target_book": "kosmos_humboldt_1845", "target_name": "birds", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "birds", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Birds", "similarity": 0.986}, {"source_book": "origin_of_species_darwin_1859", "source_name": "birds", "target_book": "first_principles_spencer_1862", "target_name": "birds", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "birds", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Birds", "similarity": 0.986}, {"source_book": "kosmos_humboldt_1845", "source_name": "birds", "target_book": "first_principles_spencer_1862", "target_name": "birds", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Birds", "target_book": "first_principles_spencer_1862", "target_name": "birds", "similarity": 0.986}, {"source_book": "english_physician_1652", "source_name": "Birds", "target_book": "principles_of_psychology_james_1890", "target_name": "birds", "similarity": 0.982}], "id": 17, "stable_key": "clu_0256a7c1d393eff8", "ground_truth": {"modern_name": "Birds", "confidence": "high", "type": "animal", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Bird", "note": "General term for avian animals.", "wikipedia_extract": "Birds are a group of warm-blooded theropod dinosaurs constituting the class Aves, characterised by feathers, toothless beaked jaws, the laying of hard-shelled eggs, a high metabolic rate, a four-chambered heart, and a strong yet lightweight skeleton. Birds live worldwide and range in size from the 5.5 cm (2.2 in) bee hummingbird to the 2.8 m (9 ft 2 in) common ostrich. There are over 11,000 living species and they are split into 44 orders. More than half are passerine or \"perching\" birds. Birds have wings whose development varies according to species; the only known groups without wings are the extinct moa and elephant birds. Wings, which are modified forelimbs, gave birds the ability to fly, although further evolution has led to the loss of flight in some birds, including ratites, penguins, and diverse endemic island species."}}, {"canonical_name": "London", "category": "PLACE", "subcategory": "CITY", "book_count": 7, "total_mentions": 55, "members": [{"entity_id": "london", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "London", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["London"], "contexts": ["city with compass variation", "capital city of England"]}, {"entity_id": "london", "book_id": "english_physician_1652", "name": "London", "category": "PLACE", "subcategory": "CITY", "count": 11, "variants": ["London", "LONDON"], "contexts": ["place of publication", "city of printing"]}, {"entity_id": "london", "book_id": "principles_of_psychology_james_1890", "name": "London", "category": "PLACE", "subcategory": "CITY", "count": 7, "variants": ["London"], "contexts": ["location of book publication", "location of society"]}, {"entity_id": "london", "book_id": "coloquios_da_orta_1563", "name": "London", "category": "PLACE", "subcategory": "CITY", "count": 20, "variants": ["London"], "contexts": ["city where book was published", "Location of the glossary publication"]}, {"entity_id": "london", "book_id": "first_principles_spencer_1862", "name": "London", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["London"], "contexts": ["publication location", "location of publication"]}, {"entity_id": "london", "book_id": "origin_of_species_darwin_1859", "name": "LONDON", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["LONDON"], "contexts": ["city where the book was published"]}, {"entity_id": "london", "book_id": "connexion_physical_sciences_somerville_1858", "name": "LONDON", "category": "PLACE", "subcategory": "CITY", "count": 11, "variants": ["LONDON", "London"], "contexts": ["location of publisher", "city used for distance comparison"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "London", "target_book": "english_physician_1652", "target_name": "London", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "London", "target_book": "principles_of_psychology_james_1890", "target_name": "London", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "London", "target_book": "coloquios_da_orta_1563", "target_name": "London", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "London", "target_book": "first_principles_spencer_1862", "target_name": "London", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "London", "target_book": "principles_of_psychology_james_1890", "target_name": "London", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "London", "target_book": "coloquios_da_orta_1563", "target_name": "London", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "London", "target_book": "first_principles_spencer_1862", "target_name": "London", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "London", "target_book": "coloquios_da_orta_1563", "target_name": "London", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "London", "target_book": "first_principles_spencer_1862", "target_name": "London", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "London", "target_book": "first_principles_spencer_1862", "target_name": "London", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "LONDON", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "LONDON", "similarity": 1.0}], "id": 18, "stable_key": "clu_a99df22ea91362d2", "ground_truth": {"modern_name": "London", "confidence": "high", "type": "place", "description": "Capital city of England, often mentioned as a place of publication.", "wikipedia_extract": "London is the capital and largest city of both England and the United Kingdom, with a population of 9.1 million people in 2024. Its wider metropolitan area is the largest in Western Europe, with a population of 15.1 million. London stands on the River Thames in southeast England, at the head of a 50-mile (80 km) tidal estuary down to the North Sea, and has been a major settlement for nearly 2,000 years. Its ancient core and financial centre, the City of London, was founded by the Romans as Londinium and has retained its medieval boundaries. The City of Westminster, to the west of the City of London, for centuries has been as the site of the national government and parliament. London grew rapidly in the 19th century, becoming the world's largest city at the time."}}, {"canonical_name": "reason", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 7, "total_mentions": 55, "members": [{"entity_id": "reason", "book_id": "medecine_experimentale_bernard_1865", "name": "reason", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["reason"], "contexts": ["faculty for logical thought and inference"]}, {"entity_id": "reason", "book_id": "principles_of_psychology_james_1890", "name": "reason", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 15, "variants": ["reason", "Reason"], "contexts": ["explanation or justification", "faculty for knowing relations"]}, {"entity_id": "reason", "book_id": "kosmos_humboldt_1845", "name": "reason", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 10, "variants": ["reason", "Reason"], "contexts": ["faculty of logical thought", "faculty for testing observations"]}, {"entity_id": "reason", "book_id": "first_principles_spencer_1862", "name": "reason", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["reason"], "contexts": ["faculty of thinking and understanding", "faculty of thought"]}, {"entity_id": "reason", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Reason", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 18, "variants": ["Reason", "reason"], "contexts": ["faculty of logical thought", "faculty for rules"]}, {"entity_id": "reason", "book_id": "english_physician_1652", "name": "Reason", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Reason"], "contexts": ["faculty of logical thought", "basis for judgment and understanding"]}, {"entity_id": "reason", "book_id": "origin_of_species_darwin_1859", "name": "Reason", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Reason", "reason"], "contexts": ["capacity for logical thought", "faculty of logical thought"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "reason", "target_book": "principles_of_psychology_james_1890", "target_name": "reason", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "reason", "target_book": "kosmos_humboldt_1845", "target_name": "reason", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "reason", "target_book": "first_principles_spencer_1862", "target_name": "reason", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "reason", "target_book": "kosmos_humboldt_1845", "target_name": "reason", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "reason", "target_book": "first_principles_spencer_1862", "target_name": "reason", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "reason", "target_book": "first_principles_spencer_1862", "target_name": "reason", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Reason", "target_book": "english_physician_1652", "target_name": "Reason", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Reason", "target_book": "origin_of_species_darwin_1859", "target_name": "Reason", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Reason", "target_book": "origin_of_species_darwin_1859", "target_name": "Reason", "similarity": 1.0}], "id": 19, "stable_key": "clu_8507ca77402d628a", "ground_truth": {"modern_name": "Reason", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Reason", "wikipedia_extract": "Reason is the capacity of consciously applying logic by drawing valid conclusions from new or existing information, with the aim of seeking truth. It is associated with such characteristically human activities as philosophy, religion, science, language, and mathematics, and is normally considered to be a distinguishing ability possessed by humans. Reason is sometimes referred to as rationality, although the latter is more about its application. Reasoning involves using more-or-less rational processes of thinking and cognition to extrapolate from one's existing knowledge to generate new knowledge, and involves the use of one's intellect. The field of logic studies the ways in which humans can use formal reasoning to produce logically valid arguments and true conclusions. Reasoning may be subdivided into forms of logical reasoning, such as deductive reasoning, inductive reasoning, and abductive reasoning."}}, {"canonical_name": "dogs", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 7, "total_mentions": 49, "members": [{"entity_id": "dogs", "book_id": "pseudodoxia