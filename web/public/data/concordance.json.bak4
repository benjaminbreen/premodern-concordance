k": "quatro_libros_naturaleza_hernandez_1615", "target_name": "dulce", "similarity": 0.953}, {"source_book": "english_physician_1652", "source_name": "sweet", "target_book": "principles_of_psychology_james_1890", "target_name": "sweet", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "sweet", "target_book": "polyanthea_medicinal", "target_name": "dulcesfie", "similarity": 0.898}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "dulce", "target_book": "principles_of_psychology_james_1890", "target_name": "sweet", "similarity": 0.953}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "dulce", "target_book": "polyanthea_medicinal", "target_name": "dulcesfie", "similarity": 0.887}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sweet", "target_book": "polyanthea_medicinal", "target_name": "dulcesfie", "similarity": 0.898}], "id": 685, "stable_key": "clu_3bbe9fa8c5ecb166", "ground_truth": {"wikipedia_extract": "Sweetness is a basic taste most commonly perceived when eating foods rich in sugar. Sweet tastes are generally regarded as pleasurable. In addition to sugars like sucrose, many other chemical compounds are sweet, including aldehydes, ketones, and sugar alcohols. Some are sweet at very low concentrations, allowing their use as non-caloric sugar substitutes. Such non-sugar sweeteners include saccharin, aspartame, sucralose and stevia. Other compounds, such as miraculin, may alter perception of sweetness itself."}}, {"canonical_name": "Ferdinand", "category": "PERSON", "subcategory": "PATRON", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "ferdinand_the_emperor", "book_id": "english_physician_1652", "name": "Ferdinand the Emperor", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Ferdinand the Emperor"], "contexts": ["furnished money for Mathiolus' work"]}, {"entity_id": "ferdinand", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Ferdinand", "category": "PERSON", "subcategory": "PATRON", "count": 4, "variants": ["Ferdinand", "Ferdinand VI", "Ferdinand Vil"], "contexts": ["king addressed by Columbus", "King to whom wax was presented"]}, {"entity_id": "ferdinand_the_catholic", "book_id": "kosmos_humboldt_1845", "name": "Ferdinand the Catholic", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Ferdinand the Catholic"], "contexts": ["ruler and employer of Anghiera"]}, {"entity_id": "ferdinando", "book_id": "polyanthea_medicinal", "name": "Ferdinando", "category": "PERSON", "subcategory": "PATRON", "count": 2, "variants": ["Ferdinando"], "contexts": ["patient of Epifanio", "Emperor's physician"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Ferdinand the Emperor", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Ferdinand", "similarity": 0.94}, {"source_book": "english_physician_1652", "source_name": "Ferdinand the Emperor", "target_book": "kosmos_humboldt_1845", "target_name": "Ferdinand the Catholic", "similarity": 0.867}, {"source_book": "english_physician_1652", "source_name": "Ferdinand the Emperor", "target_book": "polyanthea_medicinal", "target_name": "Ferdinando", "similarity": 0.916}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ferdinand", "target_book": "kosmos_humboldt_1845", "target_name": "Ferdinand the Catholic", "similarity": 0.864}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ferdinand", "target_book": "polyanthea_medicinal", "target_name": "Ferdinando", "similarity": 0.962}, {"source_book": "kosmos_humboldt_1845", "source_name": "Ferdinand the Catholic", "target_book": "polyanthea_medicinal", "target_name": "Ferdinando", "similarity": 0.912}], "id": 686, "stable_key": "clu_e45329e9d526a57b", "ground_truth": {"modern_name": "Ferdinand II, Holy Roman Emperor", "confidence": "high", "type": "person", "birth_year": 1578, "death_year": 1637, "description": "Holy Roman Emperor and patron of scientific endeavors.", "note": "While \"Ferdinand the Emperor\" could refer to others (e.g., Ferdinand I), the context of patronage for Mathioli's work strongly points to Ferdinand II, who was a known patron. Ferdinand the Catholic is a distinct historical figure."}}, {"canonical_name": "Armadillo", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "armadillo", "book_id": "origin_of_species_darwin_1859", "name": "armadillo", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["armadillo"], "contexts": ["animal with pieces of armour", "living mammal in South America"]}, {"entity_id": "armadillo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "armadillo", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["armadillo"], "contexts": ["animal, means turtle shell rabbit", "Spanish name for Ayotochtli"]}, {"entity_id": "armadillo", "book_id": "historia_medicinal_monardes_1574", "name": "Armadillo", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["Armadillo", "armadillo"], "contexts": ["animal from another nature", "animal covered in armor, like a horse"]}, {"entity_id": "armadillo", "book_id": "first_principles_spencer_1862", "name": "Armadillo", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Armadillo"], "contexts": ["mammal allied to Glyptodon"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "armadillo", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "armadillo", "similarity": 0.729}, {"source_book": "origin_of_species_darwin_1859", "source_name": "armadillo", "target_book": "historia_medicinal_monardes_1574", "target_name": "Armadillo", "similarity": 0.962}, {"source_book": "origin_of_species_darwin_1859", "source_name": "armadillo", "target_book": "first_principles_spencer_1862", "target_name": "Armadillo", "similarity": 0.962}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "armadillo", "target_book": "historia_medicinal_monardes_1574", "target_name": "Armadillo", "similarity": 0.69}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "armadillo", "target_book": "first_principles_spencer_1862", "target_name": "Armadillo", "similarity": 0.69}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Armadillo", "target_book": "first_principles_spencer_1862", "target_name": "Armadillo", "similarity": 1.0}], "id": 687, "stable_key": "clu_2e278f54c15bf49c", "ground_truth": {"modern_name": "armadillo", "confidence": "high", "type": "animal", "family": "Dasypodidae", "description": "South American mammal with a bony or leathery shell.", "wikipedia_extract": "Armadillos (Spanish for 'little armored ones') are New World placental mammals in the order Cingulata. They form part of the superorder Xenarthra, along with the anteaters and sloths. 21 extant species of armadillo have been described, some of which are distinguished by the number of bands on their armor. All species are native to the Americas, where they inhabit a variety of environments. Living armadillos are characterized by a leathery armor shell and long, sharp claws for digging. They have short legs, but can move quite quickly. The average length of an armadillo is about 75 cm (30 in), including its tail."}}, {"canonical_name": "Mississippi", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "mississippi", "book_id": "origin_of_species_darwin_1859", "name": "Mississippi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Mississippi"], "contexts": ["river mouth where sediment accumulates", "rate of deposition at mouth"]}, {"entity_id": "mississippi_river", "book_id": "origin_of_species_darwin_1859", "name": "Mississippi river", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Mississippi river"], "contexts": ["river with sediment deposition"]}, {"entity_id": "mississippi", "book_id": "principles_of_psychology_james_1890", "name": "Mississippi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Mississippi"], "contexts": ["river used in an analogy for urine measurement"]}, {"entity_id": "mississippi", "book_id": "kosmos_humboldt_1845", "name": "Mississippi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Mississippi"], "contexts": ["river valley", "river mouth with drift-wood"]}, {"entity_id": "mississippi", "book_id": "first_principles_spencer_1862", "name": "Mississippi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Mississippi"], "contexts": ["great river with trees held by current", "river mouth with sinking strata"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Mississippi", "target_book": "principles_of_psychology_james_1890", "target_name": "Mississippi", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Mississippi", "target_book": "kosmos_humboldt_1845", "target_name": "Mississippi", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Mississippi", "target_book": "first_principles_spencer_1862", "target_name": "Mississippi", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Mississippi river", "target_book": "principles_of_psychology_james_1890", "target_name": "Mississippi", "similarity": 0.883}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Mississippi river", "target_book": "kosmos_humboldt_1845", "target_name": "Mississippi", "similarity": 0.883}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Mississippi river", "target_book": "first_principles_spencer_1862", "target_name": "Mississippi", "similarity": 0.883}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Mississippi", "target_book": "kosmos_humboldt_1845", "target_name": "Mississippi", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Mississippi", "target_book": "first_principles_spencer_1862", "target_name": "Mississippi", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mississippi", "target_book": "first_principles_spencer_1862", "target_name": "Mississippi", "similarity": 1.0}], "id": 688, "stable_key": "clu_80634fb3f6caed39", "ground_truth": {"modern_name": "Mississippi River", "confidence": "high", "type": "place", "description": "A major river in the central United States.", "note": "Also refers to the historical territory associated with the river.", "wikipedia_extract": "The Mississippi River is the primary river of the largest drainage basin in the United States. It is the second-longest river in the United States, behind only the Missouri. From its traditional source of Lake Itasca in northern Minnesota, it flows generally south for 2,340 mi (3,770 km) to the Mississippi River Delta in the Gulf of Mexico. With its many tributaries, the Mississippi's watershed drains all or parts of 32 U.S. states and two Canadian provinces between the Rocky and Appalachian mountains. The river either borders or passes through the states of Minnesota, Wisconsin, Iowa, Illinois, Missouri, Kentucky, Tennessee, Arkansas, Mississippi, and Louisiana. The main stem is entirely within the United States; the total drainage basin is 1,151,000 mi2 (2,980,000 km2), of which only about one percent is in Canada."}}, {"canonical_name": "glands", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "glands", "book_id": "origin_of_species_darwin_1859", "name": "glands", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["glands"], "contexts": ["structures that excrete nectar"]}, {"entity_id": "glands", "book_id": "principles_of_psychology_james_1890", "name": "glands", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["glands"], "contexts": ["organs producing secretions", "body parts producing feelings"]}, {"entity_id": "gland", "book_id": "principles_of_psychology_james_1890", "name": "gland", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["gland"], "contexts": ["organ secreting substances"]}, {"entity_id": "glandulo\u017fas", "book_id": "polyanthea_medicinal", "name": "glandulo\u017fas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["glandulo\u017fas"], "contexts": ["glandular body parts"]}, {"entity_id": "mammary_glands", "book_id": "first_principles_spencer_1862", "name": "mammary glands", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["mammary glands"], "contexts": ["glands producing milk in mammals"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "glands", "target_book": "principles_of_psychology_james_1890", "target_name": "glands", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "glands", "target_book": "principles_of_psychology_james_1890", "target_name": "gland", "similarity": 0.958}, {"source_book": "origin_of_species_darwin_1859", "source_name": "glands", "target_book": "polyanthea_medicinal", "target_name": "glandulo\u017fas", "similarity": 0.901}, {"source_book": "principles_of_psychology_james_1890", "source_name": "glands", "target_book": "polyanthea_medicinal", "target_name": "glandulo\u017fas", "similarity": 0.901}, {"source_book": "principles_of_psychology_james_1890", "source_name": "glands", "target_book": "first_principles_spencer_1862", "target_name": "mammary glands", "similarity": 0.896}, {"source_book": "principles_of_psychology_james_1890", "source_name": "gland", "target_book": "polyanthea_medicinal", "target_name": "glandulo\u017fas", "similarity": 0.89}], "id": 689, "stable_key": "clu_bfa73f3c2dad782c", "ground_truth": {"modern_name": "glands", "confidence": "high", "type": "concept", "wikidata_id": "Q9647", "wikidata_description": "type of animal organ", "wikipedia_url": "https://en.wikipedia.org/wiki/Gland", "wikipedia_extract": "A gland is a cell or an organ in an animal's body that produces and secretes different substances that the organism needs, either into the bloodstream or into a body cavity or outer surface. A gland may also function to remove unwanted substances such as urine from the body. There are two types of gland, each with a different method of secretion. Endocrine glands are ductless and secrete their products, hormones,  directly into interstitial spaces to be taken up into the bloodstream. Exocrine glands secrete their products through a duct into a body cavity or outer surface. Glands are mostly composed of epithelial tissue, and typically have a supporting framework of connective tissue, and a capsule."}}, {"canonical_name": "dispersion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "dispersal", "book_id": "origin_of_species_darwin_1859", "name": "dispersal", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dispersal"], "contexts": ["spreading of species over wide areas"]}, {"entity_id": "dispersion", "book_id": "kosmos_humboldt_1845", "name": "dispersion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dispersion"], "contexts": ["scattering of species"]}, {"entity_id": "dispersion", "book_id": "connexion_physical_sciences_somerville_1858", "name": "dispersion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["dispersion"], "contexts": ["spreading or separation of coloured rays", "spreading of light into spectrum"]}, {"entity_id": "diffusion", "book_id": "first_principles_spencer_1862", "name": "diffusion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["diffusion"], "contexts": ["spreading of substances or energy", "spreading of particles"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "dispersal", "target_book": "kosmos_humboldt_1845", "target_name": "dispersion", "similarity": 0.916}, {"source_book": "origin_of_species_darwin_1859", "source_name": "dispersal", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "dispersion", "similarity": 0.916}, {"source_book": "kosmos_humboldt_1845", "source_name": "dispersion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "dispersion", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "dispersion", "target_book": "first_principles_spencer_1862", "target_name": "diffusion", "similarity": 0.908}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "dispersion", "target_book": "first_principles_spencer_1862", "target_name": "diffusion", "similarity": 0.908}], "id": 690, "stable_key": "clu_a4da4b2b5caa9c19", "ground_truth": {"modern_name": "Dispersal", "confidence": "high", "type": "concept", "note": "In the context of species spreading over areas, 'dispersal' is the modern scientific term. 'Diffusion' can be related but 'dispersal' is more precise for biological spread.", "wikidata_id": "Q110782443", "wikidata_description": "ecological concept"}}, {"canonical_name": "palato", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "palate", "book_id": "origin_of_species_darwin_1859", "name": "palate", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["palate"], "contexts": ["roof of the mouth"]}, {"entity_id": "paladar", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "paladar", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["paladar"], "contexts": ["palate"]}, {"entity_id": "palate", "book_id": "principles_of_psychology_james_1890", "name": "palate", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["palate"], "contexts": ["roof of the mouth"]}, {"entity_id": "palato", "book_id": "polyanthea_medicinal", "name": "palato", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["palato", "pala"], "contexts": ["palate", "palate, affected by nerve damage"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "palate", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "paladar", "similarity": 0.964}, {"source_book": "origin_of_species_darwin_1859", "source_name": "palate", "target_book": "principles_of_psychology_james_1890", "target_name": "palate", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "palate", "target_book": "polyanthea_medicinal", "target_name": "palato", "similarity": 0.961}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "paladar", "target_book": "principles_of_psychology_james_1890", "target_name": "palate", "similarity": 0.964}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "paladar", "target_book": "polyanthea_medicinal", "target_name": "palato", "similarity": 0.933}, {"source_book": "principles_of_psychology_james_1890", "source_name": "palate", "target_book": "polyanthea_medicinal", "target_name": "palato", "similarity": 0.961}], "id": 691, "stable_key": "clu_d4eaaaa38f7b932f", "ground_truth": {"modern_name": "Palate", "confidence": "high", "type": "anatomy", "description": "The roof of the mouth, a part of the oral anatomy.", "wikipedia_extract": "The palate () is the roof of the mouth in humans and other mammals. It separates the oral cavity from the nasal cavity. A similar structure is found in crocodilians, but in most other tetrapods, the oral and nasal cavities are not truly separated. The palate is divided into two parts, the anterior, bony hard palate and the posterior, fleshy soft palate (or velum). The maxillary nerve branch of the trigeminal nerve supplies sensory innervation to the palate. If the fusion is incomplete,  a cleft palate results."}}, {"canonical_name": "tapsia", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "tapsia", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Tapsia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Tapsia", "tapsia"], "contexts": ["plant identified with Dioscorides' description", "plant used in Spain"]}, {"entity_id": "tapsia", "book_id": "coloquios_da_orta_1563", "name": "tapsia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["tapsia"], "contexts": ["plant name", "plant with large roots"]}, {"entity_id": "tapfia", "book_id": "ricettario_fiorentino_1597", "name": "tapfia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["tapfia"], "contexts": ["plant from which juice is extracted"]}, {"entity_id": "tapfia", "book_id": "polyanthea_medicinal", "name": "tapfia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["tapfia"], "contexts": ["plant substance"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Tapsia", "target_book": "coloquios_da_orta_1563", "target_name": "tapsia", "similarity": 0.966}, {"source_book": "coloquios_da_orta_1563", "source_name": "tapsia", "target_book": "ricettario_fiorentino_1597", "target_name": "tapfia", "similarity": 0.88}, {"source_book": "coloquios_da_orta_1563", "source_name": "tapsia", "target_book": "polyanthea_medicinal", "target_name": "tapfia", "similarity": 0.88}, {"source_book": "ricettario_fiorentino_1597", "source_name": "tapfia", "target_book": "polyanthea_medicinal", "target_name": "tapfia", "similarity": 1.0}], "id": 692, "stable_key": "clu_54c2601805395c1a", "ground_truth": {"modern_name": "Tapsia", "confidence": "high", "type": "plant", "description": "A plant, likely from the carrot family, known for its roots.", "note": "Possibly Ferula feruloides or a similar plant in the Apiaceae family.", "wikipedia_extract": "Tapsia (also spelled Tapsiya) is a village in the Gopiballavpur II CD block in the Jhargram subdivision of the Jhargram district in the state of West Bengal, India. Tapsia is located at 22\u00b015\u203240.5\u2033N 86\u00b054\u203253.6\u2033E. Jhargram subdivision, the only one in Jhargram district, shown in the map alongside, is composed of  hills, mounds and rolling lands. It is rather succinctly described in the District Human Development Report, 2011 (at that time it was part of Paschim Medinipur district), \u201cThe western boundary is more broken and picturesque, for the lower ranges of the Chhotanagpur Hills line the horizon, the jungle assumes the character of forest, and large trees begin to predominate. The soil, however, is lateritic, a considerable area is unproductive, almost uninhabited, especially in the extreme north-west where there are several hills over 1000 feet in height. The remainder of the country is an almost level plain broken only by the sand hills.\u201d 3.48% of the population lives in urban areas and 96.52% lives in the rural areas. 20.11% of the total population belonged to scheduled castes and 29.37% belonged to scheduled tribes."}}, {"canonical_name": "espelho", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "espejo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "espejo", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["espejo"], "contexts": ["object, mirror"]}, {"entity_id": "miroir", "book_id": "relation_historique_humboldt_vol3_1825", "name": "miroir", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["miroir"], "contexts": ["reflective surface used for observation"]}, {"entity_id": "espelho", "book_id": "polyanthea_medicinal", "name": "espelho", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 4, "variants": ["espelho", "espelho quebrado", "espe\u00e7elho"], "contexts": ["object used for observation", "mirror"]}, {"entity_id": "mirrors", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mirrors", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["mirrors"], "contexts": ["surfaces that reflect light"]}, {"entity_id": "mirror", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mirror", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["mirror"], "contexts": ["instrument used in experiments"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "espejo", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "miroir", "similarity": 0.961}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "espejo", "target_book": "polyanthea_medicinal", "target_name": "espelho", "similarity": 0.987}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "espejo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mirrors", "similarity": 0.919}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "espejo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mirror", "similarity": 0.968}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "miroir", "target_book": "polyanthea_medicinal", "target_name": "espelho", "similarity": 0.961}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "miroir", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mirrors", "similarity": 0.91}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "miroir", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mirror", "similarity": 0.959}, {"source_book": "polyanthea_medicinal", "source_name": "espelho", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mirrors", "similarity": 0.917}, {"source_book": "polyanthea_medicinal", "source_name": "espelho", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mirror", "similarity": 0.963}], "id": 693, "stable_key": "clu_22d6c3fe7a321a09", "ground_truth": {"modern_name": "Mirror", "confidence": "high", "type": "object", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Clerigo", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "clerg\u00e9", "book_id": "relation_historique_humboldt_vol3_1825", "name": "clerg\u00e9", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["clerg\u00e9"], "contexts": ["religious officials", "religious personnel in Cuba"]}, {"entity_id": "clergyman", "book_id": "principles_of_psychology_james_1890", "name": "clergyman", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["clergyman"], "contexts": ["individual with improved sermon learning"]}, {"entity_id": "clerigo", "book_id": "historia_medicinal_monardes_1574", "name": "clerigo", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["clerigo", "Clerigos"], "contexts": ["religious figure with a medical condition", "clergy members"]}, {"entity_id": "clerigo", "book_id": "polyanthea_medicinal", "name": "Clerigo", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Clerigo", "Clerigo Maltez", "Clerigo Thefoureyro"], "contexts": ["natural daVilla doPedrofo", "Maltese cleric"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "clerg\u00e9", "target_book": "principles_of_psychology_james_1890", "target_name": "clergyman", "similarity": 0.953}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "clerg\u00e9", "target_book": "historia_medicinal_monardes_1574", "target_name": "clerigo", "similarity": 0.869}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "clerg\u00e9", "target_book": "polyanthea_medicinal", "target_name": "Clerigo", "similarity": 0.887}, {"source_book": "principles_of_psychology_james_1890", "source_name": "clergyman", "target_book": "polyanthea_medicinal", "target_name": "Clerigo", "similarity": 0.853}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "clerigo", "target_book": "polyanthea_medicinal", "target_name": "Clerigo", "similarity": 0.966}], "id": 694, "stable_key": "clu_fda905f6698b7dfb", "ground_truth": {"modern_name": "Clergyman", "confidence": "high", "type": "person", "description": "Religious official, sometimes involved in medical contexts or discussion.", "wikidata_id": "Q106914679", "wikidata_description": "priests and deacons incardinated in the Personal Prelature of the Holy Cross and Opus Dei. The prelate of Opus Dei becomes its bishop. They come from the numeraries and male associates"}}, {"canonical_name": "precipitar", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "pr\u00e9cipitation", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pr\u00e9cipitation", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["pr\u00e9cipitation"], "contexts": ["chemical process"]}, {"entity_id": "precipitation", "book_id": "kosmos_humboldt_1845", "name": "precipitation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["precipitation"], "contexts": ["process of settling out", "water falling from the atmosphere"]}, {"entity_id": "precipitar", "book_id": "polyanthea_medicinal", "name": "precipitar", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 4, "variants": ["precipitar", "Precipitar", "precipitando", "precipita\u00e7oens"], "contexts": ["causing a substance to fall down", "chemical process of preparing medicines"]}, {"entity_id": "precipitation", "book_id": "first_principles_spencer_1862", "name": "precipitation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["precipitation"], "contexts": ["water falling from atmosphere as rain, snow, etc."]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pr\u00e9cipitation", "target_book": "kosmos_humboldt_1845", "target_name": "precipitation", "similarity": 0.927}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pr\u00e9cipitation", "target_book": "first_principles_spencer_1862", "target_name": "precipitation", "similarity": 0.927}, {"source_book": "kosmos_humboldt_1845", "source_name": "precipitation", "target_book": "polyanthea_medicinal", "target_name": "precipitar", "similarity": 0.897}, {"source_book": "kosmos_humboldt_1845", "source_name": "precipitation", "target_book": "first_principles_spencer_1862", "target_name": "precipitation", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "precipitar", "target_book": "first_principles_spencer_1862", "target_name": "precipitation", "similarity": 0.897}], "id": 695, "stable_key": "clu_79588e92bf625e2a", "ground_truth": {"modern_name": "precipitation", "confidence": "high", "type": "concept", "description": "Chemical process causing a substance to fall out of solution.", "wikipedia_extract": "In meteorology, precipitation is any product of the condensation of atmospheric water vapor that falls from clouds due to gravitational pull. The main forms of precipitation include drizzle, rain, rain and snow mixed (\"sleet\" in Commonwealth usage), snow, ice pellets, graupel and hail. Precipitation occurs when a portion of the atmosphere becomes saturated with water vapor (reaching 100% relative humidity), so that the water condenses and \"precipitates\" or falls. Thus, fog and mist are not precipitation; their water vapor does not condense sufficiently to precipitate, so fog and mist do not fall. (Such a non-precipitating combination is a colloid.) Two processes, possibly acting together, can lead to air becoming saturated with water vapor: cooling the air or adding water vapor to the air. Precipitation forms as smaller droplets coalesce via collision with other rain drops or ice crystals within a cloud. Short, intense periods of rain in scattered locations are called showers."}}, {"canonical_name": "odor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "odor", "book_id": "principles_of_psychology_james_1890", "name": "odor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["odor"], "contexts": ["olfactory property of substances", "sense of smell"]}, {"entity_id": "odors", "book_id": "principles_of_psychology_james_1890", "name": "odors", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["odors"], "contexts": ["sensory input"]}, {"entity_id": "odor", "book_id": "kosmos_humboldt_1845", "name": "odor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["odor"], "contexts": ["sensory perception"]}, {"entity_id": "odore", "book_id": "ricettario_fiorentino_1597", "name": "odore", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["odore"], "contexts": ["quality of water", "smell of plants"]}, {"entity_id": "odour", "book_id": "first_principles_spencer_1862", "name": "odour", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["odour"], "contexts": ["quality of smell", "distinguished feelings"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "odor", "target_book": "kosmos_humboldt_1845", "target_name": "odor", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "odor", "target_book": "ricettario_fiorentino_1597", "target_name": "odore", "similarity": 0.984}, {"source_book": "principles_of_psychology_james_1890", "source_name": "odor", "target_book": "first_principles_spencer_1862", "target_name": "odour", "similarity": 0.993}, {"source_book": "principles_of_psychology_james_1890", "source_name": "odors", "target_book": "kosmos_humboldt_1845", "target_name": "odor", "similarity": 0.983}, {"source_book": "principles_of_psychology_james_1890", "source_name": "odors", "target_book": "first_principles_spencer_1862", "target_name": "odour", "similarity": 0.98}, {"source_book": "kosmos_humboldt_1845", "source_name": "odor", "target_book": "ricettario_fiorentino_1597", "target_name": "odore", "similarity": 0.984}, {"source_book": "kosmos_humboldt_1845", "source_name": "odor", "target_book": "first_principles_spencer_1862", "target_name": "odour", "similarity": 0.993}, {"source_book": "ricettario_fiorentino_1597", "source_name": "odore", "target_book": "first_principles_spencer_1862", "target_name": "odour", "similarity": 0.991}], "id": 696, "stable_key": "clu_2776feb488187061", "ground_truth": {"modern_name": "Odor", "confidence": "high", "type": "concept", "wikidata_id": "Q24774756", "wikidata_description": "InterPro Family", "wikipedia_url": "https://en.wikipedia.org/wiki/Olfactory%20receptor", "wikipedia_extract": "Olfactory receptors (ORs), also known as odorant receptors, are chemoreceptors expressed in the cell membranes of olfactory receptor neurons and are responsible for the detection of odorants (for example, compounds that have an odor) which give rise to the sense of smell. Activated olfactory receptors trigger nerve impulses which transmit information about odor to the brain. In vertebrates, these receptors are members of the class A rhodopsin-like family of G protein-coupled receptors (GPCRs). The olfactory receptors form the largest multigene family in vertebrates consisting of around 400 genes in humans and 1400 genes in mice. In insects, olfactory receptors are members of an unrelated group of ligand-gated ion channels. In vertebrates, the olfactory receptors are located in both the cilia and synapses of the olfactory sensory neurons and in the epithelium of the human airway."}}, {"canonical_name": "storm", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "storm", "book_id": "kosmos_humboldt_1845", "name": "storm", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["storm"], "contexts": ["violent atmospheric disturbance", "weather phenomenon"]}, {"entity_id": "tormenta", "book_id": "polyanthea_medicinal", "name": "tormenta", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["tormenta"], "contexts": ["metaphor for a difficult life situation"]}, {"entity_id": "thunderstorm", "book_id": "connexion_physical_sciences_somerville_1858", "name": "thunderstorm", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["thunderstorm"], "contexts": ["approach causes rapid transitions in electric state", "atmospheric electrical phenomenon"]}, {"entity_id": "storm", "book_id": "connexion_physical_sciences_somerville_1858", "name": "storm", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["storm"], "contexts": ["violent atmospheric disturbance"]}, {"entity_id": "storm", "book_id": "first_principles_spencer_1862", "name": "storm", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["storm"], "contexts": ["period of severe weather"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "storm", "target_book": "polyanthea_medicinal", "target_name": "tormenta", "similarity": 0.95}, {"source_book": "kosmos_humboldt_1845", "source_name": "storm", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "thunderstorm", "similarity": 0.937}, {"source_book": "polyanthea_medicinal", "source_name": "tormenta", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "thunderstorm", "similarity": 0.933}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "storm", "target_book": "first_principles_spencer_1862", "target_name": "storm", "similarity": 1.0}], "id": 697, "stable_key": "clu_aa1aafdeea694189", "ground_truth": {"modern_name": "weather events", "confidence": "high", "type": "concept", "note": "The term 'storms' in early modern texts, especially in contexts like Humboldt's 'Kosmos', refers to natural meteorological phenomena rather than diseases. 'Magnetic storms' refers to geomagnetic disturbances.", "wikidata_id": "Q130240049", "wikidata_description": "", "wikipedia_url": "https://en.wikipedia.org/wiki/Weather%20events%20during%20wars", "wikipedia_extract": "A storm is any disturbed state of the natural environment or the atmosphere of an astronomical body. It may be marked by significant disruptions to normal conditions such as strong wind, tornadoes, hail, thunder and lightning (a thunderstorm), heavy precipitation (snowstorm, rainstorm), heavy freezing rain (ice storm), strong winds (tropical cyclone, windstorm), wind transporting some substance through the atmosphere such as in a dust storm, among other forms of severe weather. Storms have the potential to harm lives and property via storm surge, heavy rain or snow causing flooding or road impassibility, lightning, wildfires, and vertical and horizontal wind shear. Systems with significant rainfall and duration help alleviate drought in places they move through. Heavy snowfall can allow special recreational activities to take place which would not be possible otherwise, such as skiing and snowmobiling. The English word comes from Proto-Germanic sturmaz meaning \"noise, tumult\"; a synonym is tempest, of French origin."}}, {"canonical_name": "Martin", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "martin", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Martin", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 5, "variants": ["Martin", "Martinez"], "contexts": ["observer in January 1826", "observer and year"]}, {"entity_id": "martin", "book_id": "kosmos_humboldt_1845", "name": "Martin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Martin"], "contexts": ["scholar who studied Plato's Timaeus"]}, {"entity_id": "martin", "book_id": "origin_of_species_darwin_1859", "name": "Martin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Martin"], "contexts": ["on striped mules"]}, {"entity_id": "martin_(andr\u00e9s_de_s_)", "book_id": "coloquios_da_orta_1563", "name": "Martin (Andr\u00e9s de S.)", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Martin (Andr\u00e9s de S.)"], "contexts": ["early modern scholar"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Martin", "target_book": "kosmos_humboldt_1845", "target_name": "Martin", "similarity": 0.703}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Martin", "target_book": "coloquios_da_orta_1563", "target_name": "Martin (Andr\u00e9s de S.)", "similarity": 0.853}], "id": 698, "stable_key": "clu_113616ff3cd47c00", "ground_truth": {"modern_name": "Martin", "confidence": "medium", "type": "person", "description": "Historical figure, likely a scholar or observer referenced in scientific texts.", "note": "The specific 'Martin' is not identifiable without more context, but 'Andr\u00e9s de S. Martin' is a notable figure. The generic reference to 'Martin' makes it difficult to pinpoint a single individual with high confidence.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "bilis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "bilis", "book_id": "coloquios_da_orta_1563", "name": "bilis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bilis"], "contexts": ["bile, one of the humors"]}, {"entity_id": "bilis", "book_id": "polyanthea_medicinal", "name": "bilis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["bilis"], "contexts": ["humor causing illness", "bile, one of the humors"]}, {"entity_id": "bilis", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "bilis", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["bilis"], "contexts": ["Latin for bile"]}, {"entity_id": "bile-cells", "book_id": "first_principles_spencer_1862", "name": "bile-cells", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["bile-cells"], "contexts": ["cells forming rudimentary liver"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "bilis", "target_book": "polyanthea_medicinal", "target_name": "bilis", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "bilis", "target_book": "first_principles_spencer_1862", "target_name": "bile-cells", "similarity": 0.882}], "id": 699, "stable_key": "clu_bf373224f813fc6b", "ground_truth": {"modern_name": "Bile", "confidence": "high", "type": "chemical", "note": "The term 'gall' in early modern texts often referred to bile, a fluid produced by the liver, but could also refer to the gallbladder itself or gallstones.", "wikidata_id": "Q208006", "wikidata_description": "central district and city in Bilecik Province, Turkey", "wikipedia_url": "https://en.wikipedia.org/wiki/Bilecik", "wikipedia_extract": "Bilecik is a city in northwestern Anatolia, Turkey. It is the seat of Bilecik Province and Bilecik District. Its population is 74,457 (2021). The mayor is Melek M\u0131zrak Suba\u015f\u0131 (CHP). The town is famous for its numerous restored Turkish houses. It is increasingly becoming more attractive to tourists.", "description": "A humor of the body, associated with illness and bodily functions."}}, {"canonical_name": "Vine", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "vine", "book_id": "english_physician_1652", "name": "Vine", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Vine", "vine"], "contexts": ["plant dedicated to Bacchus", "plant with antipathy to colewort"]}, {"entity_id": "vigne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "vigne", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["vigne"], "contexts": ["plant for cultivation"]}, {"entity_id": "vine", "book_id": "kosmos_humboldt_1845", "name": "vine", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["vine"], "contexts": ["plant producing grapes for wine", "plant cultivated for wine production"]}, {"entity_id": "vines", "book_id": "connexion_physical_sciences_somerville_1858", "name": "vines", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["vines"], "contexts": ["first vegetation zone on volcano"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Vine", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "vigne", "similarity": 0.895}, {"source_book": "kosmos_humboldt_1845", "source_name": "vine", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "vines", "similarity": 0.902}], "id": 700, "stable_key": "clu_d3e47a08bb1d08a6", "ground_truth": {"modern_name": "Wine", "confidence": "low", "type": "object", "description": "A liquid used in medicine, derived from grapes.", "note": "While 'vinho' directly translates to wine, 'Vine' could refer to the plant itself. Given the context of usage in medicine, 'wine' as a substance is a more fitting identification.", "wikipedia_extract": "Wine is an alcoholic drink made from fermented grape juice. It is produced and consumed in many regions around the world, in a wide variety of styles which are influenced by different varieties of grapes, growing environments, viticulture methods, and production techniques. Wine has been produced for thousands of years, the earliest evidence dating from c.\u20096000 BCE in present-day Georgia. Its popularity spread around the Mediterranean during Classical antiquity, and was sustained in Western Europe by winemaking monks and a secular trade for general drinking. New World wine was established by settler colonies from the 16th century onwards, and the wine trade increased dramatically up to the latter half of the 19th century, when European vineyards were largely destroyed by the invasive pest phylloxera. After the Second World War, the wine market improved dramatically as winemakers focused on quality and marketing to cater for a more discerning audience, and wine remains a popular drink in much of the world."}}, {"canonical_name": "surface", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "superficie_do_corpo", "book_id": "polyanthea_medicinal", "name": "superficie do corpo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["superficie do corpo"], "contexts": ["surface of the body", "body part affected by acids"]}, {"entity_id": "surface", "book_id": "connexion_physical_sciences_somerville_1858", "name": "surface", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["surface"], "contexts": ["outer layer or covering", "outer layer of an object"]}, {"entity_id": "surface", "book_id": "epoques_nature_buffon_1778", "name": "surface", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["surface"], "contexts": ["surface"]}, {"entity_id": "surface", "book_id": "principles_of_psychology_james_1890", "name": "surface", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["surface"], "contexts": ["outer layer of a structure"]}, {"entity_id": "plane_surface", "book_id": "connexion_physical_sciences_somerville_1858", "name": "plane surface", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["plane surface"], "contexts": ["flat external boundary"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "superficie do corpo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "surface", "similarity": 0.936}, {"source_book": "epoques_nature_buffon_1778", "source_name": "surface", "target_book": "principles_of_psychology_james_1890", "target_name": "surface", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "surface", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "plane surface", "similarity": 0.948}, {"source_book": "principles_of_psychology_james_1890", "source_name": "surface", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "plane surface", "similarity": 0.948}], "id": 701, "stable_key": "clu_bdff433dbdb73e89", "ground_truth": {"modern_name": "surface", "confidence": "high", "type": "concept", "note": "Includes direct English translation and Portuguese 'superficie do corpo'.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "paraliticos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "paralysie", "book_id": "medecine_experimentale_bernard_1865", "name": "paralysie", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["paralysie"], "contexts": ["loss of movement or sensation", "loss of muscle function"]}, {"entity_id": "paraplegics", "book_id": "principles_of_psychology_james_1890", "name": "Paraplegics", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Paraplegics"], "contexts": ["individuals with leg paralysis"]}, {"entity_id": "paraliticos", "book_id": "historia_medicinal_monardes_1574", "name": "paraliticos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["paraliticos"], "contexts": ["condition caused by coldness"]}, {"entity_id": "paraliticos", "book_id": "coloquios_da_orta_1563", "name": "paraliticos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["paraliticos", "paraHticos"], "contexts": ["people with paralysis", "affliction treated with cooked Raiz da china"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "paralysie", "target_book": "principles_of_psychology_james_1890", "target_name": "Paraplegics", "similarity": 0.904}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "paralysie", "target_book": "historia_medicinal_monardes_1574", "target_name": "paraliticos", "similarity": 0.922}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "paralysie", "target_book": "coloquios_da_orta_1563", "target_name": "paraliticos", "similarity": 0.922}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Paraplegics", "target_book": "historia_medicinal_monardes_1574", "target_name": "paraliticos", "similarity": 0.932}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Paraplegics", "target_book": "coloquios_da_orta_1563", "target_name": "paraliticos", "similarity": 0.932}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "paraliticos", "target_book": "coloquios_da_orta_1563", "target_name": "paraliticos", "similarity": 1.0}], "id": 702, "stable_key": "clu_6ddf0b9468255db3-2", "ground_truth": {"modern_name": "paralysis", "confidence": "high", "type": "disease", "description": "Loss of muscle function in one or more parts of the body.", "wikipedia_extract": "Paralysis (pl.: paralyses; also known as plegia) is a loss of motor function in one or more muscles. Paralysis can also be accompanied by a loss of feeling (sensory loss) in the affected area if there is sensory damage. In the United States, roughly 1 in 50 people have been diagnosed with some form of permanent or transient paralysis. The word \"paralysis\" derives from the Greek \u03c0\u03b1\u03c1\u03ac\u03bb\u03c5\u03c3\u03b9\u03c2, meaning \"disabling of the nerves\" from \u03c0\u03b1\u03c1\u03ac (para) meaning \"beside, by\" and \u03bb\u03cd\u03c3\u03b9\u03c2 (lysis) meaning \"making loose\". A paralysis accompanied by involuntary tremors is usually called \"palsy\". Paralysis is most often caused by damage in the nervous system, especially the spinal cord.", "note": "Covers general paralysis and related conditions like paralytic dementia.", "modern_term": "Paralysis", "wikidata_id": "Q1788314", "wikidata_description": "human disease"}}, {"canonical_name": "Philosophical Transactions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "philosophical_transactions", "book_id": "medecine_experimentale_bernard_1865", "name": "Philosophical Transactions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Philosophical Transactions"], "contexts": ["journal of the Royal Society"]}, {"entity_id": "philosophical_transactions", "book_id": "principles_of_psychology_james_1890", "name": "Philosophical Transactions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Philosophical Transactions"], "contexts": ["scientific journal", "publication of the Royal Society"]}, {"entity_id": "philosophical_transactions", "book_id": "kosmos_humboldt_1845", "name": "Philosophical Transactions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Philosophical Transactions"], "contexts": ["publication of experimental sciences", "scientific journal publishing article on compass"]}, {"entity_id": "philosophical_transactions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Philosophical Transactions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Philosophical Transactions"], "contexts": ["journal where Herschel published"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Philosophical Transactions", "target_book": "principles_of_psychology_james_1890", "target_name": "Philosophical Transactions", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Philosophical Transactions", "target_book": "kosmos_humboldt_1845", "target_name": "Philosophical Transactions", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Philosophical Transactions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Philosophical Transactions", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Philosophical Transactions", "target_book": "kosmos_humboldt_1845", "target_name": "Philosophical Transactions", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Philosophical Transactions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Philosophical Transactions", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Philosophical Transactions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Philosophical Transactions", "similarity": 1.0}], "id": 703, "stable_key": "clu_0543de890d70bb10", "ground_truth": {"modern_name": "Philosophical Transactions of the Royal Society", "confidence": "high", "type": "text", "wikidata_id": "Q913162", "wikidata_description": "British scientific journal published by the Royal Society", "wikipedia_url": "https://en.wikipedia.org/wiki/Philosophical%20Transactions%20of%20the%20Royal%20Society", "note": "This refers to the scientific journal published by the Royal Society.", "wikipedia_extract": "Philosophical Transactions of the Royal Society is a scientific journal published by the Royal Society. In its earliest days, it was a private venture of the Royal Society's secretary. It was established in 1665, making it the second journal in the world exclusively devoted to science, after the Journal des s\u00e7avans, and therefore also the world's longest-running scientific journal. It became an official society publication in 1752. The use of the word philosophical in the title refers to natural philosophy, which was the equivalent of what would now be generally called science. In 1887 the journal expanded and divided into two separate publications, one serving the physical sciences (Philosophical Transactions of the Royal Society A: Mathematical, Physical and Engineering Sciences) and the other focusing on the life sciences (Philosophical Transactions of the Royal Society B: Biological Sciences)."}}, {"canonical_name": "Powder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "powder", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Powder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Powder"], "contexts": ["component of gunpowder", "explosive mixture"]}, {"entity_id": "poudre", "book_id": "epoques_nature_buffon_1778", "name": "poudre", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["poudre"], "contexts": ["powder"]}, {"entity_id": "powder", "book_id": "english_physician_1652", "name": "Powder", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Powder"], "contexts": ["dried herb for wounds and ulcers"]}, {"entity_id": "poudre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "poudre", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["poudre"], "contexts": ["signals for surveying"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Powder", "target_book": "epoques_nature_buffon_1778", "target_name": "poudre", "similarity": 0.889}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Powder", "target_book": "english_physician_1652", "target_name": "Powder", "similarity": 0.755}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Powder", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "poudre", "similarity": 0.889}, {"source_book": "epoques_nature_buffon_1778", "source_name": "poudre", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "poudre", "similarity": 1.0}], "id": 704, "stable_key": "clu_4869f9fa582beaf5", "ground_truth": {"modern_name": "Powder", "confidence": "high", "type": "chemical", "note": "This could refer to various powdered substances, but 'gunpowder' is a strong contextual clue. 'Poudre' also strongly suggests a powdered form of a substance.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "A powder is a dry solid composed of many very fine particles that may flow freely when shaken or tilted. Powders are a special sub-class of granular materials, although the terms powder and granular are sometimes used to distinguish separate classes of material. In particular, powders refer to those granular materials that have the finer grain sizes, and that therefore have a greater tendency to form clumps when flowing. Granulars refer to the coarser granular materials that do not tend to form clumps except when wet. Many manufactured goods come in powder form, such as flour, sugar, ground coffee, powdered milk, copy machine toner, gunpowder, cosmetic powders, and some pharmaceuticals. In nature, dust, fine sand and snow, volcanic ash, and the top layer of the lunar regolith are also examples.", "wikipedia_url": "https://en.wikipedia.org/wiki/Powder"}}, {"canonical_name": "Priests", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "priests", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Priests", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Priests"], "contexts": ["religious officiants", "worshipped idols, possibly symbolically"]}, {"entity_id": "priest", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Priest", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Priest"], "contexts": ["gathered mistletoe with solemnity", "religious officiant"]}, {"entity_id": "pr\u00eatre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pr\u00eatre", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["pr\u00eatre"], "contexts": ["religious figure"]}, {"entity_id": "priest", "book_id": "principles_of_psychology_james_1890", "name": "priest", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["priest"], "contexts": ["religious official"]}, {"entity_id": "priest", "book_id": "first_principles_spencer_1862", "name": "priest", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["priest"], "contexts": ["religious official"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Priests", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "pr\u00eatre", "similarity": 0.873}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Priests", "target_book": "principles_of_psychology_james_1890", "target_name": "priest", "similarity": 0.9}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Priests", "target_book": "first_principles_spencer_1862", "target_name": "priest", "similarity": 0.9}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Priest", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "pr\u00eatre", "similarity": 0.966}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Priest", "target_book": "principles_of_psychology_james_1890", "target_name": "priest", "similarity": 0.996}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Priest", "target_book": "first_principles_spencer_1862", "target_name": "priest", "similarity": 0.996}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pr\u00eatre", "target_book": "principles_of_psychology_james_1890", "target_name": "priest", "similarity": 0.964}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pr\u00eatre", "target_book": "first_principles_spencer_1862", "target_name": "priest", "similarity": 0.964}, {"source_book": "principles_of_psychology_james_1890", "source_name": "priest", "target_book": "first_principles_spencer_1862", "target_name": "priest", "similarity": 1.0}], "id": 705, "stable_key": "clu_27b6659e36f711e9", "ground_truth": {"modern_name": "Priest", "confidence": "high", "type": "person", "description": "Clerical role in religious institutions, often involved in rituals.", "wikidata_id": "Q42603", "wikidata_description": "person who consecrates his life to some divinity and whose main functions are to direct religious rites and offer sacrifices to the divinity (for a minister use Q1423891)", "wikipedia_url": "https://en.wikipedia.org/wiki/Priest", "wikipedia_extract": "A priest is a religious leader authorized to perform the sacred rituals of a religion, especially as a mediatory agent between humans and one or more deities. They also have the authority or power to administer religious rites; in particular, rites of sacrifice to, and propitiation of, a deity or deities. Their office or position is the \"priesthood\", a term which also may apply to such persons collectively. A priest may have the duty to hear confessions periodically, give marriage counseling, provide prenuptial counseling, give spiritual direction, teach catechism, or visit those confined indoors, such as the sick in hospitals and nursing homes. According to the trifunctional hypothesis of prehistoric Proto-Indo-European society, priests have existed since the earliest of times and in the simplest societies, most likely as a result of agricultural surplus and consequent social stratification. The necessity to read sacred texts and keep temple or church records helped foster literacy in many early societies."}}, {"canonical_name": "Socrates", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "socrates", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Socrates", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Socrates"], "contexts": ["suffered for his beliefs about gods", "ancient Greek philosopher"]}, {"entity_id": "socrates", "book_id": "english_physician_1652", "name": "Socrates", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Socrates"], "contexts": ["ancient Greek philosopher"]}, {"entity_id": "socrates", "book_id": "kosmos_humboldt_1845", "name": "Socrates", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Socrates"], "contexts": ["ancient Greek philosopher", "ancient philosopher quoted"]}, {"entity_id": "socrates", "book_id": "historia_medicinal_monardes_1574", "name": "Socrates", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Socrates"], "contexts": ["ancient philosopher quoted on wealth"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Socrates", "target_book": "english_physician_1652", "target_name": "Socrates", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Socrates", "target_book": "kosmos_humboldt_1845", "target_name": "Socrates", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Socrates", "target_book": "historia_medicinal_monardes_1574", "target_name": "Socrates", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Socrates", "target_book": "kosmos_humboldt_1845", "target_name": "Socrates", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Socrates", "target_book": "historia_medicinal_monardes_1574", "target_name": "Socrates", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Socrates", "target_book": "historia_medicinal_monardes_1574", "target_name": "Socrates", "similarity": 1.0}], "id": 706, "stable_key": "clu_274b048f59923684", "ground_truth": {"modern_name": "Socrates", "confidence": "high", "type": "person", "birth_year": -470, "death_year": -399, "description": "Ancient Greek philosopher, known for his Socratic method.", "wikidata_id": "Q913", "wikidata_description": "5th-century BCE Greek philosopher", "wikipedia_url": "https://en.wikipedia.org/wiki/Socrates", "wikipedia_extract": "Socrates (; Ancient Greek: \u03a3\u03c9\u03ba\u03c1\u03ac\u03c4\u03b7\u03c2, romanized: S\u014dkr\u00e1t\u0113s; c. 470 \u2013 399 BC) was an ancient Greek philosopher from Classical Athens, perhaps the first Western moral philosopher, and a major inspiration on his student Plato, who largely founded the tradition of Western philosophy. An enigmatic figure, Socrates authored no texts and is known mainly through the posthumous accounts of classical writers, particularly his students Plato and Xenophon. These accounts are written as dialogues, in which Socrates and his interlocutors examine a subject in the style of question and answer; they gave rise to the Socratic dialogue literary genre. Contradictory accounts of Socrates make a reconstruction of his philosophy nearly impossible, a situation known as the Socratic problem. Socrates was a polarizing figure in Athenian society."}}, {"canonical_name": "Drake", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "drake", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Drake", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Drake"], "contexts": ["performed voyage about the Earth", "performed voyage around the Earth"]}, {"entity_id": "drake", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Drake", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Drake"], "contexts": ["explorer", "author"]}, {"entity_id": "drake", "book_id": "kosmos_humboldt_1845", "name": "Drake", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Drake"], "contexts": ["author cited in footnote", "reported earth shaking"]}, {"entity_id": "drake", "book_id": "coloquios_da_orta_1563", "name": "Drake", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Drake"], "contexts": ["navigator who brought plant"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Drake", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Drake", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Drake", "target_book": "kosmos_humboldt_1845", "target_name": "Drake", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Drake", "target_book": "coloquios_da_orta_1563", "target_name": "Drake", "similarity": 0.781}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Drake", "target_book": "kosmos_humboldt_1845", "target_name": "Drake", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Drake", "target_book": "coloquios_da_orta_1563", "target_name": "Drake", "similarity": 0.781}, {"source_book": "kosmos_humboldt_1845", "source_name": "Drake", "target_book": "coloquios_da_orta_1563", "target_name": "Drake", "similarity": 0.781}], "id": 707, "stable_key": "clu_91748bd920dfd987", "ground_truth": {"modern_name": "Sir Francis Drake", "confidence": "high", "type": "person", "birth_year": 1540, "death_year": 1596, "description": "English explorer, sea captain, and privateer who circumnavigated the globe.", "note": "While 'Drake' could refer to other individuals, the context of voyages and exploration strongly points to Sir Francis Drake. The text 'pseudodoxia_epidemica_browne_1646' is known to discuss historical figures.", "wikidata_id": "Q36517", "wikidata_description": "English sailor and privateer (c. 1540 \u2013 1596)", "wikipedia_url": "https://en.wikipedia.org/wiki/Francis%20Drake", "wikipedia_extract": "Sir Francis Drake (c. 1540 \u2013 28 January 1596) was an English explorer and privateer best known for making the second circumnavigation of the world in a single expedition between 1577 and 1580 (being the first English expedition to accomplish this). He is also known for participating in the early English slaving voyages of his cousin,  John Hawkins, and John Lovell. Having started as a simple seaman, in 1588 he was part of the fight against the Spanish Armada as a vice admiral. At an early age, Drake was placed into the household of a relative, William Hawkins, a prominent sea captain in Plymouth. In 1572, he set sail on his first independent mission, privateering along the Spanish Main. Drake's circumnavigation began on 15 December 1577."}}, {"canonical_name": "Italians", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "italians", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Italians", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Italians"], "contexts": ["observed in fine Earthen Vessels"]}, {"entity_id": "italians", "book_id": "english_physician_1652", "name": "Italians", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["Italians", "Italian Dames"], "contexts": ["people who use herb in pouder", "used the herb for healing fresh wounds"]}, {"entity_id": "italiana", "book_id": "coloquios_da_orta_1563", "name": "italiana", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["italiana"], "contexts": ["mother of a person"]}, {"entity_id": "italiano", "book_id": "polyanthea_medicinal", "name": "Italiano", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Italiano"], "contexts": ["nationality of a patient"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Italians", "target_book": "english_physician_1652", "target_name": "Italians", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Italians", "target_book": "coloquios_da_orta_1563", "target_name": "italiana", "similarity": 0.931}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Italians", "target_book": "polyanthea_medicinal", "target_name": "Italiano", "similarity": 0.921}, {"source_book": "english_physician_1652", "source_name": "Italians", "target_book": "coloquios_da_orta_1563", "target_name": "italiana", "similarity": 0.931}, {"source_book": "english_physician_1652", "source_name": "Italians", "target_book": "polyanthea_medicinal", "target_name": "Italiano", "similarity": 0.921}, {"source_book": "coloquios_da_orta_1563", "source_name": "italiana", "target_book": "polyanthea_medicinal", "target_name": "Italiano", "similarity": 0.948}], "id": 708, "stable_key": "clu_7cbf8830ca5087bc", "ground_truth": {"modern_name": "Italian people", "confidence": "high", "type": "person", "description": "Inhabitants of Italy, often referenced for their customs or origins.", "wikidata_id": "Q110904399", "wikidata_description": "residents or citizens of Italy, regardless of ethnicity"}}, {"canonical_name": "locomotion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "locomotion", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "locomotion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["locomotion"], "contexts": ["ability to move"]}, {"entity_id": "locomotion", "book_id": "origin_of_species_darwin_1859", "name": "locomotion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["locomotion"], "contexts": ["the movement of animals"]}, {"entity_id": "locomotion", "book_id": "principles_of_psychology_james_1890", "name": "locomotion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Locomotion", "locomotion"], "contexts": ["movement or ability to move", "ability to move"]}, {"entity_id": "locomotion", "book_id": "first_principles_spencer_1862", "name": "locomotion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["locomotion"], "contexts": ["movement for finding and securing materials", "movement from one place to another"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "locomotion", "target_book": "origin_of_species_darwin_1859", "target_name": "locomotion", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "locomotion", "target_book": "principles_of_psychology_james_1890", "target_name": "locomotion", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "locomotion", "target_book": "first_principles_spencer_1862", "target_name": "locomotion", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "locomotion", "target_book": "principles_of_psychology_james_1890", "target_name": "locomotion", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "locomotion", "target_book": "first_principles_spencer_1862", "target_name": "locomotion", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "locomotion", "target_book": "first_principles_spencer_1862", "target_name": "locomotion", "similarity": 1.0}], "id": 709, "stable_key": "clu_1f2aca5731facb59", "ground_truth": {"modern_name": "Locomotion", "confidence": "high", "type": "concept"}}, {"canonical_name": "fruits", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "fruits", "book_id": "epoques_nature_buffon_1778", "name": "fruits", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["fruits"], "contexts": ["reproductive part of a plant", "fruits, improved over time"]}, {"entity_id": "fruits", "book_id": "principles_of_psychology_james_1890", "name": "fruits", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["fruits"], "contexts": ["sweet, fleshy product of a tree or plant", "food source with acidity"]}, {"entity_id": "fruits", "book_id": "kosmos_humboldt_1845", "name": "fruits", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["fruits"], "contexts": ["ripening influenced by sky clarity"]}, {"entity_id": "fruits", "book_id": "first_principles_spencer_1862", "name": "fruits", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["fruits"], "contexts": ["edible plant products"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "fruits", "target_book": "principles_of_psychology_james_1890", "target_name": "fruits", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "fruits", "target_book": "kosmos_humboldt_1845", "target_name": "fruits", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "fruits", "target_book": "first_principles_spencer_1862", "target_name": "fruits", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fruits", "target_book": "kosmos_humboldt_1845", "target_name": "fruits", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fruits", "target_book": "first_principles_spencer_1862", "target_name": "fruits", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "fruits", "target_book": "first_principles_spencer_1862", "target_name": "fruits", "similarity": 1.0}], "id": 710, "stable_key": "clu_abf4c8815f72cf52-2", "ground_truth": {"modern_name": "fruit", "confidence": "high", "type": "plant", "note": "The term 'frutas'/'fruits' is general and refers to the edible product of plants, not a specific species.", "wikidata_id": "Q3314483", "wikidata_description": "typically sweet and/or sour, edible part/s of a plant that resembles seed-bearing fruit", "wikipedia_url": "https://en.wikipedia.org/wiki/Fruit", "wikipedia_extract": "In botany, a fruit is the seed-bearing structure in flowering plants (angiosperms) that is formed from the ovary after flowering. Fruits are the means by which angiosperms disseminate their seeds. Edible fruits in particular have long propagated using the movements of humans and other animals in a symbiotic relationship that is the means for seed dispersal for the one group and nutrition for the other; humans, and many other animals, have become dependent on fruits as a source of food. Consequently, fruits account for a substantial fraction of the world's agricultural output, and some (such as the apple and the pomegranate) have acquired extensive cultural and symbolic meanings. In common language and culinary usage, fruit normally means the seed-associated fleshy structures (or produce) of plants that typically are sweet (or sour) and edible in the raw state, such as apples, bananas, grapes, lemons, oranges, and strawberries. In botanical usage, the term fruit also includes many structures that are not commonly called as such in everyday language, such as nuts, bean pods, corn kernels, tomatoes, and wheat grains."}}, {"canonical_name": "volcanic matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "mati\u00e8res_soulev\u00e9es_et_rejet\u00e9es_par_les_volcans", "book_id": "epoques_nature_buffon_1778", "name": "mati\u00e8res soulev\u00e9es et rejet\u00e9es par les volcans", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["mati\u00e8res soulev\u00e9es et rejet\u00e9es par les volcans"], "contexts": ["volcanic ejecta"]}, {"entity_id": "mati\u00e8res_volcanis\u00e9es", "book_id": "epoques_nature_buffon_1778", "name": "mati\u00e8res volcanis\u00e9es", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["mati\u00e8res volcanis\u00e9es"], "contexts": ["materials from volcanic activity"]}, {"entity_id": "volcanic_matter", "book_id": "origin_of_species_darwin_1859", "name": "volcanic matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["volcanic matter"], "contexts": ["material from volcanoes"]}, {"entity_id": "volcanique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "volcanique", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["volcanique"], "contexts": ["volcanic terrain", "volcanic rocks"]}, {"entity_id": "volcanic_detritus", "book_id": "kosmos_humboldt_1845", "name": "volcanic detritus", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["volcanic detritus"], "contexts": ["deposit of volcanic material"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "mati\u00e8res soulev\u00e9es et rejet\u00e9es par les volcans", "target_book": "origin_of_species_darwin_1859", "target_name": "volcanic matter", "similarity": 0.922}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mati\u00e8res soulev\u00e9es et rejet\u00e9es par les volcans", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "volcanique", "similarity": 0.894}, {"source_book": "epoques_nature_buffon_1778"