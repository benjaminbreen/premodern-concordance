_humboldt_vol3_1825", "name": "Vera-Cruz", "category": "PLACE", "subcategory": "CITY", "count": 45, "variants": ["Vera-Cruz", "Veia-Cruz", "Vera Cruz", "Vera-Crut", "Vera-Gruz", "Vrra-Cruz", "la Vera-Cruz"], "contexts": ["destination city", "city for financial transactions"]}, {"entity_id": "vera_cruz", "book_id": "coloquios_da_orta_1563", "name": "Vera Cruz", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Vera Cruz"], "contexts": ["primitive name of Santa Cruz"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Veracruz", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Vera-Cruz", "similarity": 0.891}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Veracruz", "target_book": "coloquios_da_orta_1563", "target_name": "Vera Cruz", "similarity": 0.687}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Vera-Cruz", "target_book": "coloquios_da_orta_1563", "target_name": "Vera Cruz", "similarity": 0.731}], "id": 879, "stable_key": "clu_26eb19a82ee3893d", "ground_truth": {"modern_name": "Veracruz", "confidence": "high", "type": "place", "country": "Mexico", "wikidata_id": "Q173270", "wikidata_description": "city of Veracruz, Mexico"}}, {"canonical_name": "Marco Polo", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 48, "members": [{"entity_id": "marco_polo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Marco Polo", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Marco Polo"], "contexts": ["narrator of riches of India and Asia"]}, {"entity_id": "marco_polo", "book_id": "coloquios_da_orta_1563", "name": "Marco Polo", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 43, "variants": ["Marco Polo"], "contexts": ["gave exact news on amber extraction", "author of 'Marco Polo'"]}, {"entity_id": "marco_polo", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Marco Polo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Marco Polo"], "contexts": ["felt difficulty on mountains of Central Asia", "Venetian traveler in Central Asia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Marco Polo", "target_book": "coloquios_da_orta_1563", "target_name": "Marco Polo", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Marco Polo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Marco Polo", "similarity": 0.797}, {"source_book": "coloquios_da_orta_1563", "source_name": "Marco Polo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Marco Polo", "similarity": 0.797}], "id": 880, "stable_key": "clu_25f0beb7df74636d", "ground_truth": {"modern_name": "Marco Polo", "confidence": "high", "type": "person", "description": "Venetian merchant and explorer known for his travels to Asia.", "wikipedia_extract": "Marco Polo (c.\u20091254 \u2013  8 January 1324) was a Venetian merchant, explorer, and writer who travelled through Asia along the Silk Road between 1271 and 1295. His travels are recorded in The Travels of Marco Polo (also known as Book of the Marvels of the World  and Il Milione, c.\u20091300), a book that described the then-mysterious culture and inner workings of the Eastern world, including the wealth and great size of the Mongol Empire and China under the Yuan dynasty, giving Europeans their first comprehensive look into China, Persia, India, Japan, and other Asian societies. Born in Venice, Marco learned the mercantile trade from his father and his uncle, Niccol\u00f2 and Maffeo, who travelled through Asia and met Kublai Khan. In 1269, they returned to Venice to meet Marco for the first time. The three of them embarked on an epic journey to Asia, exploring many places along the Silk Road until they reached \"Cathay\". They were received by the royal court of Kublai Khan, who was impressed by Marco's intelligence and humility."}}, {"canonical_name": "Throat", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 47, "members": [{"entity_id": "throat", "book_id": "english_physician_1652", "name": "Throat", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 44, "variants": ["Throat"], "contexts": ["body part gargled with decoction", "body part"]}, {"entity_id": "throat", "book_id": "principles_of_psychology_james_1890", "name": "throat", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["throat"], "contexts": ["part of the neck behind the mouth", "air passes through"]}, {"entity_id": "throat", "book_id": "polyanthea_medicinal", "name": "throat", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["throat"], "contexts": ["part of the neck"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Throat", "target_book": "principles_of_psychology_james_1890", "target_name": "throat", "similarity": 0.944}, {"source_book": "english_physician_1652", "source_name": "Throat", "target_book": "polyanthea_medicinal", "target_name": "throat", "similarity": 0.944}, {"source_book": "principles_of_psychology_james_1890", "source_name": "throat", "target_book": "polyanthea_medicinal", "target_name": "throat", "similarity": 1.0}], "id": 881, "stable_key": "clu_52b61830d202061f-2", "ground_truth": {"modern_name": "Throat", "confidence": "high", "type": "concept", "note": "'Garganta' is the direct translation of 'throat' in Portuguese and Spanish, referring to the anatomical region.", "wikidata_id": "Q1783924", "wikidata_description": "organ system cancer in the head or neck region", "wikipedia_url": "https://en.wikipedia.org/wiki/Head%20and%20neck%20cancer", "wikipedia_extract": "Head and neck cancer is a general term encompassing multiple cancers that can develop in the head and neck region. These include cancers of the mouth, tongue, gums and lips (oral cancer), voice box (laryngeal), throat (nasopharyngeal, oropharyngeal, hypopharyngeal), salivary glands, nose and sinuses. Head and neck cancer can present a wide range of symptoms depending on where the cancer developed. These can include an ulcer in the mouth that does not heal, changes in the voice, difficulty swallowing, red or white patches in the mouth, and a neck lump. The majority of head and neck cancer is caused by the use of alcohol or tobacco (including smokeless tobacco). An increasing number of cases are caused by the human papillomavirus (HPV).", "description": "The anatomical part of the neck including the gullet."}}, {"canonical_name": "betonica", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 47, "members": [{"entity_id": "betony", "book_id": "english_physician_1652", "name": "Betony", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Betony"], "contexts": ["herb used for various ailments and preparations", "little inferior to betony"]}, {"entity_id": "bet\u00f3nica", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "bet\u00f3nica", "category": "PLANT", "subcategory": "HERB", "count": 3, "variants": ["bet\u00f3nica"], "contexts": ["herb with similar flowers", "plant with similar shaped flowers"]}, {"entity_id": "betonica", "book_id": "polyanthea_medicinal", "name": "betonica", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 40, "variants": ["betonica", "Betonica"], "contexts": ["herb used in preparation", "herb used in fomentation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Betony", "target_book": "polyanthea_medicinal", "target_name": "betonica", "similarity": 0.887}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "bet\u00f3nica", "target_book": "polyanthea_medicinal", "target_name": "betonica", "similarity": 0.683}], "id": 882, "stable_key": "clu_b5b335da2a10e694", "ground_truth": {"modern_name": "Betony", "confidence": "high", "type": "plant", "linnaean": "Stachys officinalis", "family": "Lamiaceae", "description": "A herb with traditional medicinal uses.", "wikipedia_extract": "Betonica officinalis, common name betony is a species of flowering plant in the mint family Lamiaceae, native to Europe, western Asia, and northern Africa. Other vernacular names include wood betony, common hedgenettle, purple betony, bishopwort, or bishop's wort. It was until recently usually included in the genus Stachys as its synonym Stachys officinalis, but Betonica was separated at genus rank from Stachys when a detailed examination showed clear consistent differences in both the foliage and flowers, valid at a higher rank than the previous treatment as just a subgenus. This has been confirmed by genetic study, which shows Betonica is separate from Stachys and more closely related to the hemp-nettles Galeopsis. The Latin specific epithet officinalis refers to plants which had a culinary or medicinal use. Betonica officinalis is a rhizotomous, patch-forming, grassland herbaceous perennial growing to 30\u201360 cm (12\u201324 in) tall."}}, {"canonical_name": "flores", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 47, "members": [{"entity_id": "flores", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "flores", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 22, "variants": ["flores"], "contexts": ["part of the xuchinacaztli plant", "flowers"]}, {"entity_id": "flores", "book_id": "coloquios_da_orta_1563", "name": "flores", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 10, "variants": ["flores", "Flores", "flores brancas"], "contexts": ["part of the tree", "used for strong scent"]}, {"entity_id": "flores", "book_id": "polyanthea_medicinal", "name": "flores", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 15, "variants": ["flores", "flor", "flores das violetas", "flores de violas"], "contexts": ["flowers appearing in certain months", "delicate plant part for distillation"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "flores", "target_book": "coloquios_da_orta_1563", "target_name": "flores", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "flores", "target_book": "polyanthea_medicinal", "target_name": "flores", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "flores", "target_book": "polyanthea_medicinal", "target_name": "flores", "similarity": 1.0}], "id": 883, "stable_key": "clu_d578cfdb0e260c54", "ground_truth": {"modern_name": "Flowers", "confidence": "high", "type": "plant", "note": "The term 'flores' is a general term for flowers and does not specify a particular plant species in these contexts.", "wikidata_id": "", "wikidata_description": "psychoactive herb from the Cannabis plant used for medical or recreational purposes", "wikipedia_url": "", "wikipedia_extract": ""}}, {"canonical_name": "cera", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 47, "members": [{"entity_id": "cera", "book_id": "historia_medicinal_monardes_1574", "name": "cera", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["cera"], "contexts": ["wax used to collect balsam", "wax used in ointments"]}, {"entity_id": "cera", "book_id": "ricettario_fiorentino_1597", "name": "cera", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 20, "variants": ["cera", "Cera", "cera tedesca"], "contexts": ["substance for adulteration", "substance that dissolves in water like milk"]}, {"entity_id": "cera", "book_id": "polyanthea_medicinal", "name": "cera", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 25, "variants": ["cera"], "contexts": ["ingredient in masticatories", "ingredient in an emplaster"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "cera", "target_book": "ricettario_fiorentino_1597", "target_name": "cera", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "cera", "target_book": "polyanthea_medicinal", "target_name": "cera", "similarity": 0.839}, {"source_book": "ricettario_fiorentino_1597", "source_name": "cera", "target_book": "polyanthea_medicinal", "target_name": "cera", "similarity": 0.839}], "id": 884, "stable_key": "clu_e8dd4b57cdb35d37", "ground_truth": {"modern_name": "Wax", "confidence": "high", "type": "substance", "description": "A malleable substance derived from bees or plants, used in preparations.", "note": "Includes mentions of 'Ceruss' (white lead), which is a distinct substance.", "wikipedia_extract": "Waxes are a diverse class of organic compounds that are lipophilic solids that are  malleable near ambient temperatures. They include higher alkanes and lipids, typically with melting points above about 40 \u00b0C (104 \u00b0F), melting to give low viscosity liquids. Waxes are insoluble in water but soluble in nonpolar organic solvents such as hexane, benzene and chloroform. Natural waxes of various types are produced by plants and animals and occur in petroleum. Waxes are organic compounds that characteristically consist of long aliphatic alkyl chains, although aromatic compounds may also be present. Natural waxes may contain unsaturated bonds and include various functional groups such as fatty acids, primary and secondary alcohols, ketones, aldehydes and fatty acid esters."}}, {"canonical_name": "Choller", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 46, "members": [{"entity_id": "choller", "book_id": "english_physician_1652", "name": "Choller", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 41, "variants": ["Choller", "Chol"], "contexts": ["humor associated with anger and bile", "bodily fluid governed by Mars"]}, {"entity_id": "choleras", "book_id": "historia_medicinal_monardes_1574", "name": "choleras", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["choleras", "choler\u00edcos"], "contexts": ["type of humors evacuated by the root", "humors described as choleric"]}, {"entity_id": "cholericis", "book_id": "polyanthea_medicinal", "name": "cholericis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["cholericis"], "contexts": ["body humors with ailments", "choleric humors"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Choller", "target_book": "historia_medicinal_monardes_1574", "target_name": "choleras", "similarity": 0.953}, {"source_book": "english_physician_1652", "source_name": "Choller", "target_book": "polyanthea_medicinal", "target_name": "cholericis", "similarity": 0.927}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "choleras", "target_book": "polyanthea_medicinal", "target_name": "cholericis", "similarity": 0.947}], "id": 885, "stable_key": "clu_3be1b55806cdf973", "ground_truth": {"modern_name": "Choleric humor", "confidence": "high", "type": "concept", "note": "Refers to one of the four humors of ancient and medieval medicine, associated with bile and temperament, not the modern disease cholera."}}, {"canonical_name": "desmayos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 46, "members": [{"entity_id": "desmayos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "desmayos", "category": "DISEASE", "subcategory": "ACUTE", "count": 6, "variants": ["desmayos"], "contexts": ["fainting spells relieved by plant", "symptom of fainting"]}, {"entity_id": "desmayos", "book_id": "polyanthea_medicinal", "name": "desmayos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 37, "variants": ["desmayos", "defmayo", "deimayos", "dema\u017fias", "desmaios", "desmayados", "desmayo", "desmayos fyncopaes", "desmayos mortaes"], "contexts": ["fainting spells", "symptom attributed to the uterus"]}, {"entity_id": "desmayos", "book_id": "coloquios_da_orta_1563", "name": "desmayos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["desmayos"], "contexts": ["fainting spells"]}, {"entity_id": "desgostos", "book_id": "polyanthea_medicinal", "name": "desgostos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["desgostos"], "contexts": ["displeasures as a cause"]}, {"entity_id": "demezes", "book_id": "polyanthea_medicinal", "name": "demezes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["demezes"], "contexts": ["a type of flux or discharge"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "desmayos", "target_book": "polyanthea_medicinal", "target_name": "desmayos", "similarity": 0.806}, {"source_book": "coloquios_da_orta_1563", "source_name": "desmayos", "target_book": "polyanthea_medicinal", "target_name": "desgostos", "similarity": 0.916}, {"source_book": "coloquios_da_orta_1563", "source_name": "desmayos", "target_book": "polyanthea_medicinal", "target_name": "demezes", "similarity": 0.89}], "id": 886, "stable_key": "clu_a908b26be286b990", "ground_truth": {"modern_name": "fainting", "confidence": "high", "type": "disease", "modern_term": "syncope", "wikidata_id": "Q7659241", "wikidata_description": "religious art concept", "wikipedia_url": "https://en.wikipedia.org/wiki/Swoon%20of%20the%20Virgin", "wikipedia_extract": "The Swoon of the Virgin, in Italian Lo Spasimo della Vergine, or Fainting Virgin Mary was an idea developed in the late Middle Ages, that the Virgin Mary had fainted during the Passion of Christ, most often placed while she watched the Crucifixion of Jesus. It was based on mentions in later texts of the apocryphal Gospel of Nicodemus (Acta Pilati), which describe Mary swooning. It was popular in later medieval art and theological literature, but as it was not mentioned in the Canonical Gospels, it became controversial - Protestants rejecting it outright, and from the 16th century discouraged also by many senior Catholic churchmen. The swoon might be placed during the episode of Christ Carrying the Cross, as on the Via Dolorosa in Jerusalem, but very commonly also during the Crucifixion of Jesus; Nicholas Penny estimates that \"about half of the surviving paintings of the Crucifixion made between 1300 and 1500 will be found to include the Virgin fainting\". It also appeared in works showing the Deposition from the Cross and Entombment of Christ, as well as the 15th-century novelty of Christ taking leave of his Mother. A fainting Mary is sometimes shown in art as early as the 12th century, and becomes common by the middle of the 13th century.", "description": "A temporary loss of consciousness due to a sudden decrease in blood flow."}}, {"canonical_name": "frutas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 45, "members": [{"entity_id": "frutas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "frutas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["frutas"], "contexts": ["food for the animal"]}, {"entity_id": "frutas", "book_id": "coloquios_da_orta_1563", "name": "frutas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 13, "variants": ["frutas", "Frutas", "firuita", "fructo", "fruita", "fruta", "fruto"], "contexts": ["produce found on the island", "tropical and temperate fruits found on the island"]}, {"entity_id": "frutas", "book_id": "polyanthea_medicinal", "name": "frutas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 31, "variants": ["frutas", "Fruta", "Frutos", "fruits", "fruta", "frutas azedas", "frutas verdes", "frutom.", "frutos"], "contexts": ["sweet edible plant products", "fruits associated with coldness"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "frutas", "target_book": "coloquios_da_orta_1563", "target_name": "frutas", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "frutas", "target_book": "polyanthea_medicinal", "target_name": "frutas", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "frutas", "target_book": "polyanthea_medicinal", "target_name": "frutas", "similarity": 1.0}], "id": 887, "stable_key": "clu_abf4c8815f72cf52-3", "ground_truth": {"modern_name": "fruit", "confidence": "high", "type": "plant", "note": "The term 'frutas'/'fruits' is general and refers to the edible product of plants, not a specific species.", "wikidata_id": "Q3314483", "wikidata_description": "typically sweet and/or sour, edible part/s of a plant that resembles seed-bearing fruit", "wikipedia_url": "https://en.wikipedia.org/wiki/Fruit", "wikipedia_extract": "In botany, a fruit is the seed-bearing structure in flowering plants (angiosperms) that is formed from the ovary after flowering. Fruits are the means by which angiosperms disseminate their seeds. Edible fruits in particular have long propagated using the movements of humans and other animals in a symbiotic relationship that is the means for seed dispersal for the one group and nutrition for the other; humans, and many other animals, have become dependent on fruits as a source of food. Consequently, fruits account for a substantial fraction of the world's agricultural output, and some (such as the apple and the pomegranate) have acquired extensive cultural and symbolic meanings. In common language and culinary usage, fruit normally means the seed-associated fleshy structures (or produce) of plants that typically are sweet (or sour) and edible in the raw state, such as apples, bananas, grapes, lemons, oranges, and strawberries. In botanical usage, the term fruit also includes many structures that are not commonly called as such in everyday language, such as nuts, bean pods, corn kernels, tomatoes, and wheat grains."}}, {"canonical_name": "Arbol", "category": "PLANT", "subcategory": "TREE", "book_count": 3, "total_mentions": 45, "members": [{"entity_id": "arbol", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "ARBOL", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["ARBOL"], "contexts": ["tree"]}, {"entity_id": "arbol", "book_id": "historia_medicinal_monardes_1574", "name": "Arbol", "category": "PLANT", "subcategory": "TREE", "count": 25, "variants": ["Arbol", "Arbel", "Arboles", "arbol", "arboles", "arbolicos", "\u00e1rbol"], "contexts": ["large tree", "tree from which Liquido is extracted"]}, {"entity_id": "\u00e1rbol", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "\u00e1rbol", "category": "PLANT", "subcategory": "TREE", "count": 16, "variants": ["\u00e1rbol"], "contexts": ["type of plant", "a tree"]}, {"entity_id": "arbore", "book_id": "ricettario_fiorentino_1597", "name": "arbore", "category": "PLANT", "subcategory": "TREE", "count": 3, "variants": ["arbore", "arbori"], "contexts": ["tree bearing Gherofani", "a tree"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ARBOL", "target_book": "historia_medicinal_monardes_1574", "target_name": "Arbol", "similarity": 0.934}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "\u00e1rbol", "target_book": "ricettario_fiorentino_1597", "target_name": "arbore", "similarity": 0.978}], "id": 888, "stable_key": "clu_c3c188d2ab77cd00-3", "ground_truth": {"modern_name": "Tree", "confidence": "high", "type": "plant", "note": "This cluster refers to the general category of 'tree' rather than a specific species. 'Arbusto' (shrub) is a related but distinct botanical term.", "wikidata_id": "Q10884", "wikidata_description": "perennial woody plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Tree", "wikipedia_extract": "In botany, a tree is a perennial plant with an elongated stem, or trunk, usually supporting branches and leaves. In some usages, the definition of a tree may be narrower, e.g., including only woody plants with secondary growth, only plants that are usable as lumber, or only plants above a specified height. Wider definitions include taller palms, tree ferns, bananas, and bamboos. Trees are not a monophyletic taxonomic group but consist of a wide variety of plant species that have independently evolved a trunk and branches as a way to tower above other plants to compete for sunlight. The majority of tree species are angiosperms or hardwoods; of the rest, many are gymnosperms or softwoods. Trees tend to be long-lived, some trees reaching several thousand years old.", "description": "A woody perennial plant, typically having a single stem or trunk."}}, {"canonical_name": "North America", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 44, "members": [{"entity_id": "north_america", "book_id": "origin_of_species_darwin_1859", "name": "North America", "category": "PLACE", "subcategory": "COUNTRY", "count": 27, "variants": ["North America"], "contexts": ["birds and insects in North America", "continent with cave systems"]}, {"entity_id": "north_america", "book_id": "kosmos_humboldt_1845", "name": "North America", "category": "PLACE", "subcategory": "COUNTRY", "count": 14, "variants": ["North America"], "contexts": ["location of observed meteor showers", "location of phenomenon"]}, {"entity_id": "north_america", "book_id": "connexion_physical_sciences_somerville_1858", "name": "North America", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["North America"], "contexts": ["continent with plains", "independent Christian states like those of Union"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "North America", "target_book": "kosmos_humboldt_1845", "target_name": "North America", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "North America", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "North America", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "North America", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "North America", "similarity": 1.0}], "id": 889, "stable_key": "clu_3761b80cf6d4e89d", "ground_truth": {"modern_name": "North America", "confidence": "high", "type": "place", "country": "North America", "wikidata_id": "Q502117", "wikidata_description": "1940 bomber aircraft family", "wikipedia_url": "https://en.wikipedia.org/wiki/North%20American%20B-25%20Mitchell", "wikipedia_extract": "The North American B-25 Mitchell is an American medium bomber that was introduced in 1941 and named in honor of Brigadier General William \"Billy\" Mitchell, a pioneer of U.S. military aviation. Used by many Allied air forces, the B-25 served in every theater of World War II, and after the war ended, many remained in service, operating across four decades. Produced in numerous variants, nearly 10,000 B-25s were built. It was the most-produced American medium bomber and the third-most-produced American bomber overall. These included several limited models such as the F-10 reconnaissance aircraft, the AT-24 crew trainer, and the United States Marine Corps' PBJ-1 patrol bomber."}}, {"canonical_name": "Egypto", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 44, "members": [{"entity_id": "egypto", "book_id": "historia_medicinal_monardes_1574", "name": "Egypto", "category": "PLACE", "subcategory": "COUNTRY", "count": 7, "variants": ["Egypto", "Egipto", "Egyp"], "contexts": ["land where true Balsamo existed", "place where ballamo used to be"]}, {"entity_id": "egypto", "book_id": "coloquios_da_orta_1563", "name": "Egypto", "category": "PLACE", "subcategory": "COUNTRY", "count": 29, "variants": ["Egypto", "Egipto", "Egito", "Egitto", "Egjpto", "Egjrpto", "egypto"], "contexts": ["place where Cassia fistula was distributed", "country, geographical reference"]}, {"entity_id": "egypto", "book_id": "polyanthea_medicinal", "name": "Egypto", "category": "PLACE", "subcategory": "COUNTRY", "count": 8, "variants": ["Egypto", "\u00c6gypto", "\u00c6gyptum"], "contexts": ["Ancient land, associated with slavery and miracles", "place from which a people was rescued"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Egypto", "target_book": "coloquios_da_orta_1563", "target_name": "Egypto", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Egypto", "target_book": "polyanthea_medicinal", "target_name": "Egypto", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Egypto", "target_book": "polyanthea_medicinal", "target_name": "Egypto", "similarity": 1.0}], "id": 890, "stable_key": "clu_e565c9eea0cfc369-2", "ground_truth": {"modern_name": "Egypt", "confidence": "high", "type": "place", "description": "An ancient civilization and geographical location, relevant to medicinal plants and history.", "note": "Includes Portuguese ('Egypto'), French ('Egypte'), and English ('Egypt', 'Egyptian', 'AEgypt').", "wikipedia_extract": "Egypt, officially the Arab Republic of Egypt, is a country spanning the northeast corner of Africa and southwest corner of Asia via the Sinai Peninsula. It is bordered by the Mediterranean Sea to the north, Palestine and Israel to the northeast, the Red Sea to the east, Sudan to the south, and Libya to the west. The Gulf of Aqaba in the northeast separates Egypt from Jordan and Saudi Arabia. Cairo is the capital, largest city, and leading cultural centre, while Alexandria is the second-largest city and an important hub of industry and tourism. With over 107 million inhabitants, Egypt is the third-most populous country in Africa and 15th-most populated in the world. Egypt has one of the longest histories of any country, tracing its heritage along the Nile Delta back to the 6th\u20134th millennia BCE.", "country": "Egypt"}}, {"canonical_name": "Mercurio", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 44, "members": [{"entity_id": "merc\u00fario", "book_id": "coloquios_da_orta_1563", "name": "merc\u00fario", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["merc\u00fario"], "contexts": ["mercury, traded commodity"]}, {"entity_id": "mercurio", "book_id": "ricettario_fiorentino_1597", "name": "Mercurio", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Mercurio"], "contexts": ["ingredient in a preparation"]}, {"entity_id": "mercurio", "book_id": "polyanthea_medicinal", "name": "Mercurio", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 42, "variants": ["Mercurio", "Mercu", "Mercurio Calomelanos", "Mercurio da vida", "Mercurio doce", "Mercurio precipitado", "Mercuriocrudo", "Mercurios", "Mercurius", "Mercurius vivus", "mercurio", "mercurio da vida", "mercurio doce", "mercurio doceprecipitado", "mercurio fublimado doce", "mercurio precipitado", "mercurioprecipitado", "mercury"], "contexts": ["used in cathartic and sudorific medicines", "mercury, a mineral"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "merc\u00fario", "target_book": "ricettario_fiorentino_1597", "target_name": "Mercurio", "similarity": 0.924}, {"source_book": "coloquios_da_orta_1563", "source_name": "merc\u00fario", "target_book": "polyanthea_medicinal", "target_name": "Mercurio", "similarity": 0.924}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Mercurio", "target_book": "polyanthea_medicinal", "target_name": "Mercurio", "similarity": 1.0}], "id": 891, "stable_key": "clu_7b4c22977030f8b9-2", "ground_truth": {"modern_name": "Quicksilver", "confidence": "high", "type": "chemical", "wikidata_id": "Q925", "wikidata_description": "chemical element with symbol Hg and atomic number 80", "wikipedia_extract": "Quicksilver is a 2024 romantasy novel by British author Callie Hart, the first in her Fae & Alchemy trilogy. Hart self-published the book in June 2024 after declining her literary agent's request for substantial revisions. Initial sales were modest, but the book found an audience after Hart sent copies to BookTok creators on TikTok, generating over three million views within two months. The viral attention sparked a 10-bidder auction for publishing rights. Forever, an imprint of Grand Central Publishing, won the auction, releasing a traditional edition on December 3, 2024 that debuted at number one on The New York Times Best Seller list. That same week, Netflix acquired film adaptation rights for seven figures.", "wikipedia_url": "https://en.wikipedia.org/wiki/Quicksilver_(Hart_novel)", "note": "'Azougue' and 'Azogue' are archaic terms for mercury, commonly used in Iberian languages."}}, {"canonical_name": "terrestrial magnetism", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 3, "total_mentions": 44, "members": [{"entity_id": "magn\u00e9tisme_terrestre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "magn\u00e9tisme terrestre", "category": "CONCEPT", "subcategory": "THEORY", "count": 5, "variants": ["magn\u00e9tisme terrestre"], "contexts": ["theory of Earth's magnetism", "variations of earth's magnetism"]}, {"entity_id": "terrestrial_magnetism", "book_id": "kosmos_humboldt_1845", "name": "terrestrial magnetism", "category": "CONCEPT", "subcategory": "THEORY", "count": 25, "variants": ["terrestrial magnetism", "Terrestrial Magnetism", "Terrestrial magnetism"], "contexts": ["study of Earth's magnetic field", "magnetic properties of the Earth"]}, {"entity_id": "magnetism,_terrestrial", "book_id": "kosmos_humboldt_1845", "name": "Magnetism, terrestrial", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Magnetism, terrestrial"], "contexts": ["Earth's magnetic field"]}, {"entity_id": "terrestrial_magnetism", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Terrestrial magnetism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 13, "variants": ["terrestrial magnetism", "Terrestrial Magnetism", "Terrestrial magnetism"], "contexts": ["magnetic field of the Earth", "Earth's magnetic field"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "magn\u00e9tisme terrestre", "target_book": "kosmos_humboldt_1845", "target_name": "terrestrial magnetism", "similarity": 0.904}, {"source_book": "kosmos_humboldt_1845", "source_name": "Magnetism, terrestrial", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Terrestrial magnetism", "similarity": 0.927}], "id": 892, "stable_key": "clu_0d2e6ad874aaf3dd", "ground_truth": {"modern_name": "Terrestrial magnetism", "confidence": "high", "type": "concept", "wikidata_id": "Q64325870", "wikidata_description": "scholarly article"}}, {"canonical_name": "Bladder", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 43, "members": [{"entity_id": "bladder", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "bladder", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["bladder", "Bladder"], "contexts": ["organ where stones can form"]}, {"entity_id": "bladder", "book_id": "english_physician_1652", "name": "Bladder", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 40, "variants": ["Bladder", "Bladders", "bladder"], "contexts": ["affected by pains", "organ for storing urine"]}, {"entity_id": "bladder", "book_id": "origin_of_species_darwin_1859", "name": "Bladder", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Bladder"], "contexts": ["for swimming in fish"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "bladder", "target_book": "english_physician_1652", "target_name": "Bladder", "similarity": 0.903}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "bladder", "target_book": "origin_of_species_darwin_1859", "target_name": "Bladder", "similarity": 0.903}, {"source_book": "english_physician_1652", "source_name": "Bladder", "target_book": "origin_of_species_darwin_1859", "target_name": "Bladder", "similarity": 1.0}], "id": 893, "stable_key": "clu_1123faaa49db51b8-2", "ground_truth": {"modern_name": "Bladder", "confidence": "high", "type": "substance", "description": "An organ that stores urine.", "wikipedia_extract": "The bladder (from Old English  bl\u00e6dre 'bladder, blister, pimple') is a hollow organ in humans and other vertebrates that stores urine from the kidneys. In placental mammals, urine enters the bladder via the ureters and exits via the urethra during urination. In humans, the bladder is a distensible organ that sits on the pelvic floor. The typical adult human bladder will hold between 300 and 500 ml (10 and 17 fl oz) before the urge to empty occurs, but can hold considerably more. The Latin phrase for \"urinary bladder\" is vesica urinaria, and the term vesical or prefix vesico- appear in connection with associated structures such as vesical veins. The modern Latin word for \"bladder\" \u2013 cystis \u2013 appears in associated terms such as cystitis (inflammation of the bladder).", "wikidata_id": "Q9382", "wikidata_description": "internal organ of humans and vertebrates"}}, {"canonical_name": "Inde", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 42, "members": [{"entity_id": "inde", "book_id": "epoques_nature_buffon_1778", "name": "Inde", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Inde"], "contexts": ["South Asian country", "peninsula in South Asia"]}, {"entity_id": "inde", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Inde", "category": "PLACE", "subcategory": "COUNTRY", "count": 37, "variants": ["Inde", "Indes", "l'Inde"], "contexts": ["South Asian country", "origin of a dialect spoken by Bohemians"]}, {"entity_id": "inde", "book_id": "coloquios_da_orta_1563", "name": "Inde", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Inde"], "contexts": ["region where epidemic occurred"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Inde", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Inde", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Inde", "target_book": "coloquios_da_orta_1563", "target_name": "Inde", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Inde", "target_book": "coloquios_da_orta_1563", "target_name": "Inde", "similarity": 1.0}], "id": 894, "stable_key": "clu_3b1f5efc22628429-2", "ground_truth": {"modern_name": "India", "confidence": "high", "type": "place", "country": "India", "note": "Hindostan is an older Persian name for the Indian subcontinent.", "wikidata_id": "Q668", "wikidata_description": "country in South Asia", "wikipedia_url": "https://en.wikipedia.org/wiki/India", "wikipedia_extract": "India, officially the Republic of India, is a country in South Asia. It is the seventh-largest country by area; the most populous country since 2023; and, since its independence in 1947, the world's most populous democracy. Bounded by the Indian Ocean on the south, the Arabian Sea on the southwest, and the Bay of Bengal on the southeast, it shares land borders with Pakistan to the west; China, Nepal, and Bhutan to the north; and Bangladesh and Myanmar to the east. In the Indian Ocean, India is near Sri Lanka and the Maldives; its Andaman and Nicobar Islands share a maritime border with Myanmar, Thailand, and Indonesia. Modern humans arrived on the Indian subcontinent from Africa no later than 55,000 years ago. Their long occupation, predominantly in isolation as hunter-gatherers, has made the region highly diverse."}}, {"canonical_name": "Itch", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 3, "total_mentions": 41, "members": [{"entity_id": "itch", "book_id": "english_physician_1652", "name": "Itch", "category": "DISEASE", "subcategory": "CHRONIC", "count": 37, "variants": ["Itch", "Itches"], "contexts": ["affliction under Mars", "skin condition helped by juice"]}, {"entity_id": "itching", "book_id": "english_physician_1652", "name": "itching", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["itching", "Itching"], "contexts": ["symptom caused by tender body", "sensation of the hemorrhoids"]}, {"entity_id": "itch", "book_id": "polyanthea_medicinal", "name": "Itch", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Itch"], "contexts": ["a skin condition or symptom"]}, {"entity_id": "itching", "book_id": "first_principles_spencer_1862", "name": "itching", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["itching"], "contexts": ["sensation causing desire to scratch"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Itch", "target_book": "polyanthea_medicinal", "target_name": "Itch", "similarity": 0.935}, {"source_book": "english_physician_1652", "source_name": "itching", "target_book": "polyanthea_medicinal", "target_name": "Itch", "similarity": 0.881}, {"source_book": "english_physician_1652", "source_name": "itching", "target_book": "first_principles_spencer_1862", "target_name": "itching", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Itch", "target_book": "first_principles_spencer_1862", "target_name": "itching", "similarity": 0.881}], "id": 895, "stable_key": "clu_fba14b53dda3486d-2", "ground_truth": {"modern_name": "Scabies", "confidence": "high", "type": "disease", "modern_term": "Scabies", "wikidata_id": "Q167178", "wikidata_description": "human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Scabies", "note": "The early modern term 'itch' encompassed both the symptom of itching and specific conditions like scabies. Given the context of skin conditions and affections, scabies is the most likely specific disease referent.", "wikipedia_extract": "Scabies (, SKAY-beez; also sometimes known as the seven-year itch) is a contagious human skin infestation by the tiny (0.2\u20130.45 mm) mite Sarcoptes scabiei, variety hominis. The word is from Latin: scabere, lit. 'to scratch'. It is a particular public health problem in crowded settings such as care homes, schools, refugee camps, prisons, and hospitals. The most common symptoms are severe itchiness and a pimple-like rash. Occasionally, tiny burrows may appear on the skin from eggs that are about to hatch."}}, {"canonical_name": "Milk", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 41, "members": [{"entity_id": "milk", "book_id": "english_physician_1652", "name": "Milk", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 30, "variants": ["Milk", "Milk in Cattel"], "contexts": ["product of kine increased by leaves", "substance borrage seed/leaves increase"]}, {"entity_id": "goats_milk", "book_id": "english_physician_1652", "name": "Goats Milk", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Goats Milk"], "contexts": ["animal product used in medicine", "remedy for Henbane poisoning"]}, {"entity_id": "leite", "book_id": "coloquios_da_orta_1563", "name": "leite", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 8, "variants": ["leite", "leite de cabras"], "contexts": ["Milk", "used to prepare anacardo for asthma"]}, {"entity_id": "milk", "book_id": "polyanthea_medicinal", "name": "milk", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["milk"], "contexts": ["animal product"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Milk", "target_book": "coloquios_da_orta_1563", "target_name": "leite", "similarity": 0.961}, {"source_book": "english_physician_1652", "source_name": "Milk", "target_book": "polyanthea_medicinal", "target_name": "milk", "similarity": 0.995}, {"source_book": "english_physician_1652", "source_name": "Goats Milk", "target_book": "coloquios_da_orta_1563", "target_name": "leite", "similarity": 0.899}, {"source_book": "english_physician_1652", "source_name": "Goats Milk", "target_book": "polyanthea_medicinal", "target_name": "milk", "similarity": 0.923}, {"source_book": "coloquios_da_orta_1563", "source_name": "leite", "target_book": "polyanthea_medicinal", "target_name": "milk", "similarity": 0.968}], "id": 896, "stable_key": "clu_04796173450b0376", "ground_truth": {"modern_name": "milk", "confidence": "high", "type": "animal", "wikidata_id": "Q157184", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Astragalus%20%28plant%29"}}, {"canonical_name": "genera", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 41, "members": [{"entity_id": "genera", "book_id": "origin_of_species_darwin_1859", "name": "genera", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 38, "variants": ["genera"], "contexts": ["taxonomic rank above species", "groups of closely related species"]}, {"entity_id": "genera", "book_id": "kosmos_humboldt_1845", "name": "genera", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["genera"], "contexts": ["taxonomic rank below family"]}, {"entity_id": "genera", "book_id": "first_principles_spencer_1862", "name": "genera", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["genera"], "contexts": ["higher taxonomic rank", "botanical classification level"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "genera", "target_book": "kosmos_humboldt_1845", "target_name": "genera", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "genera", "target_book": "first_principles_spencer_1862", "target_name": "genera", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "genera", "target_book": "first_principles_spencer_1862", "target_name": "genera", "similarity": 1.0}], "id": 897, "stable_key": "clu_5b887efbadbd8098", "ground_truth": {"modern_name": "Genus", "confidence": "high", "type": "concept", "note": "The term 'genera' is the plural of 'genus', a fundamental taxonomic rank in biological classification."}}, {"canonical_name": "banho", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 40, "members": [{"entity_id": "bath", "book_id": "english_physician_1652", "name": "bath", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 3, "variants": ["bath", "Bath", "Bathing"], "contexts": ["outward application of St. Johns-wort", "method of treating skin conditions"]}, {"entity_id": "banhos", "book_id": "coloquios_da_orta_1563", "name": "banhos", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["banhos"], "contexts": ["used to treat berib\u00e9ri"]}, {"entity_id": "banho", "book_id": "polyanthea_medicinal", "name": "banho", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 24, "variants": ["banho", "banho de agua", "banho de agua morna", "banho de aguadoce", "banhode agua fervente", "banhos de agua doce", "banhos de agua fria", "banhos de agua morna", "banhos de agua tibia", "banhos de aguadoce", "banhos de aguamuyto quente", "banhos de leite", "banhos deagua doce"], "contexts": ["therapeutic bath with herbs", "therapeutic bath"]}, {"entity_id": "banhos", "book_id": "polyanthea_medicinal", "name": "banhos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["banhos", "banhos de agua"], "contexts": ["baths", "therapeutic practice"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "bath", "target_book": "polyanthea_medicinal", "target_name": "banho", "similarity": 0.912}, {"source_book": "coloquios_da_orta_1563", "source_name": "banhos", "target_book": "polyanthea_medicinal", "target_name": "banho", "similarity": 0.941}, {"source_book": "coloquios_da_orta_1563", "source_name": "banhos", "target_book": "polyanthea_medicinal", "target_name": "banhos", "similarity": 1.0}], "id": 898, "stable_key": "clu_e550ba0b6c0255c8", "ground_truth": {"modern_name": "Baths", "confidence": "high", "type": "concept", "description": "Therapeutic practice involving immersion in water or herbal preparations.", "wikipedia_extract": "Balneotherapy (Latin: balneum \"bath\") is a pseudoscientific method of treating diseases by bathing, a traditional medicine technique usually practiced at spas. Since ancient times, humans have used hot springs, public baths and thermal medicine for therapeutic effects. While it is considered distinct from hydrotherapy, there are some overlaps in practice and in underlying principles. Balneotherapy may involve hot or cold water, massage through moving water, relaxation, or stimulation. Many mineral waters at spas are rich in particular minerals such as silica, sulfur, selenium, and radium. Medicinal clays are also widely used, a practice known as 'fangotherapy'. \"Balneotherapy\" is the practice of immersing a subject in mineral water or mineral-laden mud; it is part of the traditional medicine of many cultures and originated in hot springs, cold water springs, or other sources of such water, like the Dead Sea.", "wikidata_id": "Q70816289", "wikidata_description": "scientific article published on 01 March 1970"}}, {"canonical_name": "puxos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 40, "members": [{"entity_id": "puxo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "puxo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["puxo"], "contexts": ["some manner of straining", "condition treated by plant preparation"]}, {"entity_id": "puxo", "book_id": "historia_medicinal_monardes_1574", "name": "puxo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["puxo"], "contexts": ["for the flux whatever it may be"]}, {"entity_id": "puxos", "book_id": "polyanthea_medicinal", "name": "puxos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 36, "variants": ["puxos", "Puxos", "puxos deourina"], "contexts": ["medical condition", "convulsions"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "puxo", "target_book": "historia_medicinal_monardes_1574", "target_name": "puxo", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "puxo", "target_book": "polyanthea_medicinal", "target_name": "puxos", "similarity": 0.937}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "puxo", "target_book": "polyanthea_medicinal", "target_name": "puxos", "similarity": 0.937}], "id": 899, "stable_key": "clu_b0675fac2a12f7b8-2", "ground_truth": {"modern_name": "Convulsions", "confidence": "high", "type": "disease", "modern_term": "Convulsions", "wikidata_id": "Q6279182", "wikidata_description": "disease, disturbance of cortical function due to a sudden, abnormal, exin cells.", "wikipedia_url": "https://en.wikipedia.org/wiki/Seizure", "note": "In early modern medical texts, 'fits' was a common term for sudden episodes of illness, often referring to seizures.", "wikipedia_extract": "A seizure is a sudden disruption of brain activity caused by excessive, synchronized neuronal firing that results in changes in behavior. This neurological condition is common, affecting approximately 50 million individuals around the world. Depending on the regions of the brain involved, seizures can lead to changes in movement, sensation, behavior, awareness, or consciousness. Symptoms vary widely. Some seizures involve subtle changes, such as brief lapses in attention or awareness (as seen in absence seizures), while others cause generalized convulsions with loss of consciousness (tonic\u2013clonic seizures). Most seizures last less than two minutes and are followed by a postictal period of confusion, fatigue, or other symptoms.", "description": "A medical condition characterized by sudden, involuntary muscle contractions."}}, {"canonical_name": "farinha de cevada", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 40, "members": [{"entity_id": "farine_des_c\u00e9r\u00e9ales", "book_id": "relation_historique_humboldt_vol3_1825", "name": "farine des c\u00e9r\u00e9ales", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["farine des c\u00e9r\u00e9ales"], "contexts": ["food item"]}, {"entity_id": "farinha_de_trigo", "book_id": "coloquios_da_orta_1563", "name": "farinha de trigo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["farinha de trigo", "farinha de triguo"], "contexts": ["wheat flour", "ingredient in falcon plaster"]}, {"entity_id": "farinha_de_cevada", "book_id": "polyanthea_medicinal", "name": "farinha de cevada", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 36, "variants": ["farinha de cevada", "fari-nha de trigo", "farinha", "farinha Trem\u00e8s", "farinha de centeyo", "farinha de favas", "farinha de tremo\u00e7os", "farinha de trigo", "farinha dearroz", "farinha decevada", "farinhade cevada", "farinhade pao", "farinhade tremo\u00e7os", "farinhade trigo"], "contexts": ["barley flour, a thickening agent", "barley flour"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "farine des c\u00e9r\u00e9ales", "target_book": "coloquios_da_orta_1563", "target_name": "farinha de trigo", "similarity": 0.921}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "farine des c\u00e9r\u00e9ales", "target_book": "polyanthea_medicinal", "target_name": "farinha de cevada", "similarity": 0.919}, {"source_book": "coloquios_da_orta_1563", "source_name": "farinha de trigo", "target_book": "polyanthea_medicinal", "target_name": "farinha de cevada", "similarity": 0.939}], "id": 900, "stable_key": "clu_cbd1531e68fc10ea", "ground_truth": {"modern_name": "Barley flour", "confidence": "high", "type": "plant", "description": "Flour made from ground barley grains.", "note": "Includes 'farinha de trigo' (wheat flour) as a related ingredient.", "wikipedia_extract": "Barley flour is a flour prepared from dried and ground barley. Barley flour is used to prepare barley bread and other breads, such as flat bread and yeast breads. There are two general types of barley flour: coarse and fine. Barley groats are milled to make coarse barley flour, and pearl barley is milled to make fine barley flour. Additionally, patent barley flour is a finer barley flour that is ground to a greater degree compared to fine barley flour. Barley flour is used to prepare breads such as barley bread."}}, {"canonical_name": "alimentos", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 40, "members": [{"entity_id": "alimentos", "book_id": "polyanthea_medicinal", "name": "alimentos", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 29, "variants": ["alimentos", "alimento exterior", "alimento interior", "alimentos acres", "alimentos liquidos", "alimentos mordazes", "alimentos muyto aduba", "alimentos muyto adubados", "alimentos muyto humidos", "alimentos m\u00e1os", "alimentos solidos", "alimentos \u017feccos", "alimentum"], "contexts": ["food", "nourishment"]}, {"entity_id": "food", "book_id": "connexion_physical_sciences_somerville_1858", "name": "food", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["food"], "contexts": ["substance providing nourishment"]}, {"entity_id": "food", "book_id": "first_principles_spencer_1862", "name": "food", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 10, "variants": ["Food", "food"], "contexts": ["substance providing nourishment", "distinguished by mechanical and chemical actions"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "alimentos", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "food", "similarity": 0.976}, {"source_book": "polyanthea_medicinal", "source_name": "alimentos", "target_book": "first_principles_spencer_1862", "target_name": "food", "similarity": 0.976}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "food", "target_book": "first_principles_spencer_1862", "target_name": "food", "similarity": 1.0}], "id": 901, "stable_key": "clu_c915d1ccb942e547", "ground_truth": {"modern_name": "food", "confidence": "high", "type": "concept", "description": "Substances providing nourishment and sustenance.", "wikipedia_extract": "Food is any substance consumed by an organism for nutritional support. Food usually consists of plant, animal, or fungal origin and contains essential nutrients such as carbohydrates, fats, proteins, vitamins, or minerals. The substance is ingested by an organism and assimilated by the organism's cells to provide energy, maintain life, or support growth. Different species of animals have different feeding behaviours that satisfy the needs of their metabolisms and have evolved to fill specific ecological niches within specific geographical contexts. Omnivorous humans are highly adaptable and have adapted to obtaining food in many different ecosystems. Humans generally use cooking to prepare food for consumption."}}, {"canonical_name": "Venemous Beasts", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 39, "members": [{"entity_id": "venemous_beasts", "book_id": "english_physician_1652", "name": "Venemous Beasts", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 19, "variants": ["Venemous Beasts", "Venemous Creature", "Venemous Serpents", "Venemous serpents", "venemous Beasts", "venemous creature"], "contexts": ["creatures whose bites are under Mars", "dangerous animals"]}, {"entity_id": "animales_venenosos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "animales venenosos", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["animales venenosos"], "contexts": ["poisonous animals", "venomous animals whose stings are treated"]}, {"entity_id": "animales_venenossos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "animales venenossos", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["animales venenossos"], "contexts": ["venomous animals whose bites are treated", "venomous animals"]}, {"entity_id": "animal_veneno\u017fo", "book_id": "polyanthea_medicinal", "name": "animal veneno\u017fo", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 16, "variants": ["animal veneno\u017fo", "animaes muyto venenofos", "animaes venenofos", "animaes veneno\u017fos", "animal venenofo", "animal venenoso", "animalium venenatorum", "bichos venenofos", "bichos veneno\u017fos"], "contexts": ["venomous animal", "poisonous animal"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Venemous Beasts", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "animales venenosos", "similarity": 0.948}, {"source_book": "english_physician_1652", "source_name": "Venemous Beasts", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "animales venenossos", "similarity": 0.955}, {"source_book": "english_physician_1652", "source_name": "Venemous Beasts", "target_book": "polyanthea_medicinal", "target_name": "animal veneno\u017fo", "similarity": 0.935}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "animales venenosos", "target_book": "polyanthea_medicinal", "target_name": "animal veneno\u017fo", "similarity": 0.966}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "animales venenossos", "target_book": "polyanthea_medicinal", "target_name": "animal veneno\u017fo", "similarity": 0.966}], "id": 902, "stable_key": "clu_0889a7fce663c336", "ground_truth": {"modern_name": "Venomous Animals", "confidence": "high", "type": "animal", "description": "Creatures capable of inflicting harm through venomous bites or stings.", "wikipedia_extract": "The following is a list of poisonous animals, which are animals that passively deliver toxins (called poison) to their victims upon contact such as through inhalation, absorption through the skin, or after being ingested. They are often distinguished from venomous animals, which actively inject their toxins (called venom) into their victims through a venom apparatus such as fangs or a stinger. The only difference between poisonous animals and venomous animals is how they deliver the toxins. This list deals exclusively with poisonous animals. This list is a partial list of animals that are poisonous to humans and other animals in that their flesh is toxic if consumed, or in some cases if they are touched: Some of these toads are \"milked\" for their bufotoxins."}}, {"canonical_name": "epithimo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 38, "members": [{"entity_id": "epithimum", "book_id": "english_physician_1652", "name": "Epithimum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Epithimum"], "contexts": ["true dodder of time", "herb praised by physicians"]}, {"entity_id": "epithymo", "book_id": "ricettario_fiorentino_1597", "name": "Epithymo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 10, "variants": ["Epithymo", "EPITHYMO", "Epahymo", "Epithymio", "Epithynio", "Epitnymo"], "contexts": ["herb mentioned", "plant similar to Cuscuta"]}, {"entity_id": "epitimo", "book_id": "ricettario_fiorentino_1597", "name": "epitimo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["epitimo", "Epichymo", "Epirnymo", "Epitbymo", "Epithimo", "Epithymoi", "Epitymo", "epithym-"], "contexts": ["herb used in purgatives", "herb"]}, {"entity_id": "epithimo", "book_id": "polyanthea_medicinal", "name": "epithimo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 17, "variants": ["epithimo", "Epitimo", "Epitome", "epitimo", "epitome"], "contexts": ["herb used in a syrup", "dodder, a parasitic plant used medicinally"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Epithimum", "target_book": "ricettario_fiorentino_1597", "target_name": "Epithymo", "similarity": 0.937}, {"source_book": "english_physician_1652", "source_name": "Epithimum", "target_book": "ricettario_fiorentino_1597", "target_name": "epitimo", "similarity": 0.881}, {"source_book": "english_physician_1652", "source_name": "Epithimum", "target_book": "polyanthea_medicinal", "target_name": "epithimo", "similarity": 0.937}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Epithymo", "target_book": "polyanthea_medicinal", "target_name": "epithimo", "similarity": 0.941}, {"source_book": "ricettario_fiorentino_1597", "source_name": "epitimo", "target_book": "polyanthea_medicinal", "target_name": "epithimo", "similarity": 0.881}], "id": 903, "stable_key": "clu_d31c83e250da44df", "ground_truth": {"modern_name": "Cuscuta epithymum", "confidence": "high", "type": "plant", "linnaean": "Cuscuta epithymum", "family": "Convolvulaceae", "description": "A parasitic herb, also known as dodder, used medicinally.", "note": "Commonly referred to as 'dodder'.", "wikipedia_extract": "Cuscuta epithymum (dodder, lesser dodder, hellweed, strangle-tare) is a parasitic plant assigned to the family Cuscutaceae or Convolvulaceae, depending on the taxonomy. It is red-pigmented, not being photosynthetically active. It has a filiform habit, like a group of yarns. Its leaves are very small, like flakes. Its flowers, disposed in little glomerules, have a white corolla, with the androecium welded to the corolla. In Eurasia, this species of dodder would often attach itself to the Conehead thyme (Thymus capitatus), taking on the plant's pungency."}}, {"canonical_name": "feelings", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 38, "members": [{"entity_id": "feelings", "book_id": "principles_of_psychology_james_1890", "name": "feelings", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 27, "variants": ["feelings", "Feelings"], "contexts": ["mental phenomena", "emotional states"]}, {"entity_id": "feelings", "book_id": "kosmos_humboldt_1845", "name": "feelings", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["feelings"], "contexts": ["emotional states", "influenced by sky clarity"]}, {"entity_id": "feelings", "book_id": "first_principles_spencer_1862", "name": "feelings", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["feelings"], "contexts": ["emotional responses", "emotional states"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "feelings", "target_book": "kosmos_humboldt_1845", "target_name": "feelings", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "feelings", "target_book": "first_principles_spencer_1862", "target_name": "feelings", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "feelings", "target_book": "first_principles_spencer_1862", "target_name": "feelings", "similarity": 1.0}], "id": 904, "stable_key": "clu_a5707314b67e2cd7", "ground_truth": {"modern_name": "emotions", "confidence": "high", "type": "concept", "wikidata_id": "Q208166", "wikidata_description": "personality disorder characterized by variability of moods and unstable relationships", "wikipedia_url": "https://en.wikipedia.org/wiki/Borderline%20personality%20disorder", "wikipedia_extract": "Borderline personality disorder (BPD) is a personality disorder characterized by a pervasive, long-term pattern of significant interpersonal relationship instability, acute fear of abandonment, and intense emotional outbursts. People with BPD frequently exhibit self-harming behaviours and engage in risky activities, primarily caused by difficulties in regulating emotions. Symptoms such as dissociation, a pervasive sense of emptiness, and distorted sense of self are prevalent. Onset of symptoms can be triggered by events others perceive as normal, with the disorder typically manifesting in early adulthood and persisting across diverse contexts. BPD is often comorbid with substance use disorders, depressive disorders, and eating disorders. Studies estimate up to 10 percent of people with BPD die by suicide."}}, {"canonical_name": "calamo arom\u00e1tico", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 38, "members": [{"entity_id": "calamo_arom\u00e1tico", "book_id": "coloquios_da_orta_1563", "name": "calamo arom\u00e1tico", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 19, "variants": ["Calamo arom\u00e1tico", "calamo arom\u00e1tico", "CALAMO AROM\u00c1TICO"], "contexts": ["plant with strong smell", "aromatic reed"]}, {"entity_id": "calamo_aromatico", "book_id": "ricettario_fiorentino_1597", "name": "calamo aromatico", "category": "PLANT", "subcategory": "ROOT", "count": 17, "variants": ["calamo aromatico", "CaUmo aromatico", "Calamo aromat", "Calamo aromati", "Calamo aromatico", "Calamo aroo", "Calamo odorato", "Calamoaromat"], "contexts": ["aromatic reed similar to Acoro", "aromatic reed of spices"]}, {"entity_id": "calamo_aromatico", "book_id": "polyanthea_medicinal", "name": "calamo aromatico", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["calamo aromatico"], "contexts": ["spice used in a syrup", "used in confection"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "calamo arom\u00e1tico", "target_book": "ricettario_fiorentino_1597", "target_name": "calamo aromatico", "similarity": 0.895}, {"source_book": "coloquios_da_orta_1563", "source_name": "calamo arom\u00e1tico", "target_book": "polyanthea_medicinal", "target_name": "calamo aromatico", "similarity": 0.989}, {"source_book": "ricettario_fiorentino_1597", "source_name": "calamo aromatico", "target_book": "polyanthea_medicinal", "target_name": "calamo aromatico", "similarity": 0.899}], "id": 905, "stable_key": "clu_91d47fa07fa32596", "ground_truth": {"modern_name": "Sweet Flag", "confidence": "high", "type": "plant", "description": "An aromatic reed plant (Acorus calamus) used as a spice and in medicine.", "note": "Known for its aromatic properties and medicinal applications.", "wikipedia_extract": "Acorus calamus (also called sweet flag, sway or muskrat root, among many other common names) is a species of flowering plant with psychoactive chemicals. It is a tall wetland monocot of the family Acoraceae, in the genus Acorus. Although used in traditional medicine over centuries to treat digestive disorders and pain, it has no clinical evidence of safety or efficacy and may be toxic if ingested, and so has been commercially banned for use in food in the United States. Sweet flag is a herbaceous perennial, 2 m (79 in) tall. Its leaves resemble those of the iris family. Sweet flag consists of tufts of basal leaves that rise from a spreading rhizome."}}, {"canonical_name": "acrimonia", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 38, "members": [{"entity_id": "acrimonia", "book_id": "historia_medicinal_monardes_1574", "name": "acrimonia", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["acrimonia"], "contexts": ["quality of the Saissasfras bark"]}, {"entity_id": "acrimonia", "book_id": "coloquios_da_orta_1563", "name": "acrimonia", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["acrimonia"], "contexts": ["quality of sharpness"]}, {"entity_id": "acrimonia", "book_id": "polyanthea_medicinal", "name": "acrimonia", "category": "CONCEPT", "subcategory": "QUALITY", "count": 36, "variants": ["acrimonia", "acrimoniada", "acrimoniado", "acrimoniado sangue", "acrimoniaurine"], "contexts": ["sharpness or bitterness", "acridity"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "acrimonia", "target_book": "coloquios_da_orta_1563", "target_name": "acrimonia", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "acrimonia", "target_book": "polyanthea_medicinal", "target_name": "acrimonia", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "acrimonia", "target_book": "polyanthea_medicinal", "target_name": "acrimonia", "similarity": 1.0}], "id": 906, "stable_key": "clu_5be36632f508b90d", "ground_truth": {"modern_name": "acridity", "confidence": "high", "type": "concept", "description": "A sharp, biting, or acrid taste or smell; pungency.", "note": "Refers to a sensory quality of sharpness or bitterness.", "wikipedia_extract": "Humorism, the humoral theory, or humoralism, was a system of medicine detailing a supposed makeup and workings of the human body, adopted by Ancient Greek and Roman physicians and philosophers. Humorism began to fall out of favor in the 17th century and it was definitively disproved with the discovery of microbes. The concept of \"humors\" may have origins in Ancient Egyptian medicine, or Mesopotamia, though it was not systemized until ancient Greek thinkers. The word humor is a translation of Greek \u03c7\u03c5\u03bc\u03cc\u03c2, chymos (literally 'juice' or 'sap', metaphorically 'flavor'). Early texts on Indian Ayurveda medicine presented a theory of three or four humors (do\u1e63as), which they sometimes linked with the five elements (pa\u00f1ca-bh\u016bta): earth, water, fire, air, and space. The concept of \"humors\" (chemical systems regulating human behaviour) became more prominent from the writing of medical theorist Alcmaeon of Croton (c. 540\u2013500 BC)."}}, {"canonical_name": "v\u00e9g\u00e9taux", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 37, "members": [{"entity_id": "v\u00e9g\u00e9taux", "book_id": "medecine_experimentale_bernard_1865", "name": "v\u00e9g\u00e9taux", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["v\u00e9g\u00e9taux"], "contexts": ["plants", "plants as a general category"]}, {"entity_id": "v\u00e9g\u00e9taux", "book_id": "epoques_nature_buffon_1778", "name": "v\u00e9g\u00e9taux", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 26, "variants": ["v\u00e9g\u00e9taux"], "contexts": ["plant life, part of earth's composition", "plants"]}, {"entity_id": "v\u00e9g\u00e9tales", "book_id": "epoques_nature_buffon_1778", "name": "v\u00e9g\u00e9tales", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["v\u00e9g\u00e9tales"], "contexts": ["plant matter forming layers"]}, {"entity_id": "v\u00e9g\u00e9tal", "book_id": "epoques_nature_buffon_1778", "name": "v\u00e9g\u00e9tal", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["v\u00e9g\u00e9tal"], "contexts": ["general term for plant life"]}, {"entity_id": "v\u00e9g\u00e9tale", "book_id": "relation_historique_humboldt_vol3_1825", "name": "v\u00e9g\u00e9tale", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["v\u00e9g\u00e9tale"], "contexts": ["life mentioned as ending at a certain altitude"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "v\u00e9g\u00e9taux", "target_book": "epoques_nature_buffon_1778", "target_name": "v\u00e9g\u00e9taux", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "v\u00e9g\u00e9taux", "target_book": "epoques_nature_buffon_1778", "target_name": "v\u00e9g\u00e9tales", "similarity": 0.991}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "v\u00e9g\u00e9taux", "target_book": "epoques_nature_buffon_1778", "target_name": "v\u00e9g\u00e9tal", "similarity": 0.961}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "v\u00e9g\u00e9taux", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "v\u00e9g\u00e9tale", "similarity": 0.965}, {"source_book": "epoques_nature_buffon_1778", "source_name": "v\u00e9g\u00e9taux", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "v\u00e9g\u00e9tale", "similarity": 0.965}, {"source_book": "epoques_nature_buffon_1778", "source_name": "v\u00e9g\u00e9tales", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "v\u00e9g\u00e9tale", "similarity": 0.974}, {"source_book": "epoques_nature_buffon_1778", "source_name": "v\u00e9g\u00e9tal", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "v\u00e9g\u00e9tale", "similarity": 0.996}], "id": 907, "stable_key": "clu_e8543f65dec242d0", "ground_truth": {"modern_name": "plants", "confidence": "high", "type": "plant", "wikidata_id": "Q164686", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Plantago"}}, {"canonical_name": "Mercurial", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 37, "members": [{"entity_id": "mercury", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mercury", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["Mercury"], "contexts": ["plant name", "Roman god, messenger"]}, {"entity_id": "mercury", "book_id": "english_physician_1652", "name": "Mercury", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 15, "variants": ["Mercury"], "contexts": ["god associated with herbs", "planet associated with Fennel"]}, {"entity_id": "mercurial", "book_id": "polyanthea_medicinal", "name": "Mercurial", "category": "PERSON", "subcategory": "AUTHORITY", "count": 18, "variants": ["Mercurial", "Mercur", "Mercurial."], "contexts": ["mentioned with birth anomalies", "author cited for a remedy"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mercury", "target_book": "english_physician_1652", "target_name": "Mercury", "similarity": 0.836}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mercury", "target_book": "polyanthea_medicinal", "target_name": "Mercurial", "similarity": 0.969}], "id": 908, "stable_key": "clu_433436686adff372", "ground_truth": {"modern_name": "Girolamo Mercuriale", "confidence": "high", "type": "person", "birth_year": 1530, "death_year": 1606, "description": "Italian physician, philosopher, and botanist; author of De Arte Gymnastica.", "wikidata_id": "Q129011568", "wikidata_description": "scholarly article", "wikipedia_extract": "Girolamo Mercuriale or Mercuriali (Italian: Geronimo Mercuriali; Latin: Hieronymus Mercurialis, Hyeronimus Mercurialis) (September 30, 1530 \u2013 November 8, 1606) was an Italian philologist and physician, most famous for his work De Arte Gymnastica. Born in the city of Forl\u00ec, the son of Giovanni Mercuriali, also a doctor, he was educated at Bologna, Padua and Venice, where he received his doctorate in 1555. Settling in Forli, he was sent on a political mission to Rome. The pope at the time was Paul IV. In Rome, he made favorable contacts and had free access to the great libraries where, with sweeping enthusiasm, he studied the classical and medical literature of the Greeks and Romans. His studies of the attitudes of the ancients toward diet, exercise, and hygiene and the use of natural methods for the cure of disease culminated in the publication of his De Arte Gymnastica(Venice, 1569).", "note": "The spelling 'Monruo' and 'Montuo' are likely transcriptions/misspellings of Girolamo Mercuriale, a prominent physician and scholar referenced in similar contexts."}}, {"canonical_name": "Turbit", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 37, "members": [{"entity_id": "turbit", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "turbit", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["turbit"], "contexts": ["plant from the East Indies"]}, {"entity_id": "turbit", "book_id": "coloquios_da_orta_1563", "name": "Turbit", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 31, "variants": ["Turbit", "turbit", "turbith"], "contexts": ["plant substance", "a purgative root"]}, {"entity_id": "turbit", "book_id": "polyanthea_medicinal", "name": "turbit", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["turbit", "Turbit", "Turbith", "turbith"], "contexts": ["ingredient in a wine remedy", "chosen, ingredient in a medicinal preparation"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "turbit", "target_book": "coloquios_da_orta_1563", "target_name": "Turbit", "similarity": 0.97}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "turbit", "target_book": "polyanthea_medicinal", "target_name": "turbit", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Turbit", "target_book": "polyanthea_medicinal", "target_name": "turbit", "similarity": 0.97}], "id": 909, "stable_key": "clu_41b3ef87a3ac307a", "ground_truth": {"modern_name": "Turpeth", "confidence": "high", "type": "plant", "linnaean": "Ipomoea turpethum", "family": "Convolvulaceae"}}, {"canonical_name": "Caripe", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 37, "members": [{"entity_id": "caripe", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Caripe", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 35, "variants": ["Caripe", "Cari", "Cariai", "Cariay", "Cariben", "Carihava", "Caruache"], "contexts": ["populous valley in Venezuela", "location with calcareous mountains"]}, {"entity_id": "caripe", "book_id": "kosmos_humboldt_1845", "name": "Caripe", "category": "PLACE", "subcategory": "OTHER_PLAC