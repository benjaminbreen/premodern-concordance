get_book": "first_principles_spencer_1862", "target_name": "flowers", "similarity": 1.0}], "id": 335, "stable_key": "clu_6bae96f4efa09017", "ground_truth": {"modern_name": "Flowers", "confidence": "high", "type": "plant", "note": "The term 'flowers' in this context refers to the reproductive part of plants, not a specific species or genus. The texts mention them in relation to medicine, botany, and optics.", "wikidata_id": "", "wikidata_description": "psychoactive herb from the Cannabis plant used for medical or recreational purposes", "wikipedia_url": "", "wikipedia_extract": ""}}, {"canonical_name": "colica", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 4, "total_mentions": 120, "members": [{"entity_id": "colica", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "colica", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["colica"], "contexts": ["heals colic pains"]}, {"entity_id": "colica", "book_id": "historia_medicinal_monardes_1574", "name": "Colica", "category": "DISEASE", "subcategory": "CHRONIC", "count": 3, "variants": ["colica", "Colica"], "contexts": ["colic, a type of abdominal pain", "colic, a type of illness"]}, {"entity_id": "colica", "book_id": "polyanthea_medicinal", "name": "colica", "category": "DISEASE", "subcategory": "CHRONIC", "count": 100, "variants": ["colica", "Colic", "Colica", "Colica Nephritica", "Colica biliofa", "Colicas", "colica Nephritica", "colica Pictonica", "colica flatulenta", "colica fleymatica", "colica nephritica", "colicas", "colicas Ictericas", "colicas Nephriticas", "colicas Nepo", "colicas biliofas", "colicas flatuotas", "colicas nephriticas", "colicasNephriticas", "colicis"], "contexts": ["disease dependent on stomach", "colic"]}, {"entity_id": "c\u00f3lica", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "c\u00f3lica", "category": "DISEASE", "subcategory": "ACUTE", "count": 13, "variants": ["c\u00f3lica"], "contexts": ["colic", "disease cured by the p