"subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["organic creation"], "contexts": ["various changes exhibited by the organic creation", "living aspect of creation"]}, {"entity_id": "inorganic_creation", "book_id": "first_principles_spencer_1862", "name": "inorganic creation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["inorganic creation"], "contexts": ["non-living aspect of creation"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "organic creation", "target_book": "first_principles_spencer_1862", "target_name": "organic creation", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "organic creation", "target_book": "first_principles_spencer_1862", "target_name": "inorganic creation", "similarity": 0.885}, {"source_book": "kosmos_humboldt_1845", "source_name": "inorganic creation", "target_book": "first_principles_spencer_1862", "target_name": "organic creation", "similarity": 0.885}, {"source_book": "kosmos_humboldt_1845", "source_name": "inorganic creation", "target_book": "first_principles_spencer_1862", "target_name": "inorganic creation", "similarity": 1.0}], "id": 3798, "stable_key": "clu_e0afb82006cd2722", "ground_truth": {"modern_name": "organic vs inorganic matter", "confidence": "high", "type": "concept", "note": "This cluster refers to the distinction between living (organic) and non-living (inorganic) matter, a fundamental concept in early modern science and philosophy."}}, {"canonical_name": "radius", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "radius", "book_id": "kosmos_humboldt_1845", "name": "radius", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["radius"], "contexts": ["distance from center to edge of a circle"]}, {"entity_id": "radius", "book_id": "connexion_physical_sciences_somerville_1858", "name": "radius", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["radius"], "contexts": ["distance from center to edge", "line from center to circumference of circle"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "radius", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "radius", "similarity": 1.0}], "id": 3799, "stable_key": "clu_f39d594c564bf890", "ground_truth": {"modern_name": "radius", "confidence": "high", "type": "concept", "note": "While 'radius' is a geometric term, its use in relation to 'distance from center to edge' suggests a conceptual rather than a purely anatomical or object-based reference in this context.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "ellipticity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "ellipticity", "book_id": "kosmos_humboldt_1845", "name": "ellipticity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ellipticity"], "contexts": ["measure of Earth's deviation from sphere"]}, {"entity_id": "ellipticity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "ellipticity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["ellipticity"], "contexts": ["degree of ovalness of an orbit", "degree of being elliptical"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "ellipticity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ellipticity", "similarity": 1.0}], "id": 3800, "stable_key": "clu_9ed0f86273f4ff24", "ground_truth": {"modern_name": "ellipticity", "confidence": "high", "type": "concept", "wikidata_id": "Q58490119", "wikidata_description": "scholarly article"}}, {"canonical_name": "Amboyna", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "amboyna", "book_id": "kosmos_humboldt_1845", "name": "Amboyna", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Amboyna"], "contexts": ["location of experiments"]}, {"entity_id": "amboyna", "book_id": "coloquios_da_orta_1563", "name": "Amboyna", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Amboyna"], "contexts": ["place where Rumphius wrote", "island in Indonesia"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Amboyna", "target_book": "coloquios_da_orta_1563", "target_name": "Amboyna", "similarity": 0.849}], "id": 3801, "stable_key": "clu_86d2fc3b08f1d680", "ground_truth": {"modern_name": "Ambon", "confidence": "high", "type": "place", "country": "Indonesia", "note": "Amboyna is the historical name for the island and city of Ambon.", "wikidata_id": "Q18970", "wikidata_description": "city in Maluku Province, Indonesia", "wikipedia_url": "https://en.wikipedia.org/wiki/Ambon%2C_Maluku", "wikipedia_extract": "Ambon (Indonesian pronunciation: [\u02c8amb\u0254n]; formerly Dutch: Amboina) is the capital and largest city of the Indonesian province of Maluku. This city is also known as Ambon Manise, which means \"beautiful\" or \"pretty\" Ambon in the Ambonese language. It covers a land area of 359.45 square kilometres (138.78 sq mi), and had a population of 331,254 at the 2010 Census and 347,288 at the 2020 Census; the official estimate as of mid 2024 was 357,289. The city is divided into five administrative districts (kecamatan) \u2013 namely Nusaniwe, Sirimau, Teluk Ambon (Ambon Bay), Baguala (officially Teluk Ambon Baguala) and Leitimur Selatan (South Leitimur). Known as Indonesia's music city, Ambon became the first city in Southeast Asia to be recognised as the UNESCO City of Music in 2019. The city is populated by a mix of ethnic Alifuru (original Moluccans), Javanese, Balinese, Butonese, Bugis, Makassar, Papuan, Minahasa, Minang, Flobamora (Flores, Sumba, Alor and Timor ethnics) and those of foreign descent (Chinese, Arabian-Ambonese, Spanish-Ambonese, German-Ambonese, Portuguese-Ambonese and Dutch-Ambonese)."}}, {"canonical_name": "electric force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "electric_force", "book_id": "kosmos_humboldt_1845", "name": "electric force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["electric force"], "contexts": ["force exerted by electric charge"]}, {"entity_id": "electric_force", "book_id": "connexion_physical_sciences_somerville_1858", "name": "electric force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["electric force", "Electric Force"], "contexts": ["force exerted by electric charges", "force associated with electric charge"]}, {"entity_id": "electric_forces", "book_id": "connexion_physical_sciences_somerville_1858", "name": "electric forces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["electric forces"], "contexts": ["forces related to electricity", "forces associated with electricity"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "electric force", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electric force", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "electric force", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electric forces", "similarity": 0.941}], "id": 3802, "stable_key": "clu_34320e1c18e9c065", "ground_truth": {"modern_name": "Electric force", "confidence": "high", "type": "concept"}}, {"canonical_name": "Henderson", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "henderson", "book_id": "kosmos_humboldt_1845", "name": "Henderson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Henderson"], "contexts": ["reported sound from Aurora in Iceland"]}, {"entity_id": "henderson", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Henderson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Henderson"], "contexts": ["observer of stellar parallax and motion", "associated with Sirius and Maclear"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Henderson", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Henderson", "similarity": 1.0}], "id": 3803, "stable_key": "clu_293c45e53fcbf6a3", "ground_truth": {"modern_name": "Alexander Henderson", "confidence": "medium", "type": "person", "description": "Observer of Aurora Borealis and stellar phenomena", "note": "Multiple individuals named Henderson, context suggests a scientific observer.", "wikidata_id": "Q43911516", "wikidata_description": "person associated with the witch trials in Scotland"}}, {"canonical_name": "vapori dell acqua", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "aqueous_vapors", "book_id": "kosmos_humboldt_1845", "name": "aqueous vapors", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["aqueous vapors"], "contexts": ["water in gaseous form"]}, {"entity_id": "vapori_dell_acqua", "book_id": "ricettario_fiorentino_1597", "name": "vapori dell acqua", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["vapori dell acqua", "vapo", "vapori"], "contexts": ["used for indirect heating of medicines", "vapors for heating"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "aqueous vapors", "target_book": "ricettario_fiorentino_1597", "target_name": "vapori dell acqua", "similarity": 0.904}], "id": 3804, "stable_key": "clu_e770353762c0d79a-3", "ground_truth": {"modern_name": "Steam", "confidence": "high", "type": "chemical", "wikidata_id": "Q190120", "wikidata_description": "gaseous phase of water; unlike other forms of water, water vapor is invisible", "wikipedia_url": "https://en.wikipedia.org/wiki/Water%20vapor", "wikipedia_extract": "Water vapor, water vapour, or aqueous vapor is the gaseous phase of water. It is one state of water within the hydrosphere. Water vapor can be produced from the evaporation or boiling of liquid water or from the sublimation of ice. Water vapor is transparent, like most constituents of the atmosphere. Under typical atmospheric conditions, water vapor is continuously generated by evaporation and removed by condensation. It is less dense than most of the other constituents of air and triggers convection currents that can lead to clouds and fog."}}, {"canonical_name": "Purgatorio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "purgatorio", "book_id": "kosmos_humboldt_1845", "name": "Purgatorio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Purgatorio"], "contexts": ["canto of Divina Commedia"]}, {"entity_id": "purgatorio", "book_id": "polyanthea_medicinal", "name": "Purgatorio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Purgatorio", "purgar\u017fe", "purga\u00e7\u00e3odo parto"], "contexts": ["state of souls", "mental purges, related to excesses"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Purgatorio", "target_book": "polyanthea_medicinal", "target_name": "Purgatorio", "similarity": 1.0}], "id": 3805, "stable_key": "clu_60cd8377637606ea", "ground_truth": {"modern_name": "Purgatorio", "confidence": "high", "type": "text", "note": "Refers to Dante Alighieri's 'Purgatorio', part of the Divine Comedy.", "wikidata_id": "Q95629239", "wikidata_description": "river in the Basque Country"}}, {"canonical_name": "Scitaminea", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "scitamineae", "book_id": "kosmos_humboldt_1845", "name": "Scitamineae", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Scitamineae"], "contexts": ["plant family"]}, {"entity_id": "scitaminea", "book_id": "coloquios_da_orta_1563", "name": "Scitaminea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Scitaminea", "Scitaminece"], "contexts": ["plant family", "plant discussed in previous colloquy"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Scitamineae", "target_book": "coloquios_da_orta_1563", "target_name": "Scitaminea", "similarity": 0.945}], "id": 3806, "stable_key": "clu_008f86aeb5545484", "ground_truth": {"modern_name": "Zingiberales", "confidence": "high", "type": "plant", "linnaean": "Zingiberales", "family": "Zingiberaceae", "note": "Scitaminea is an older taxonomic grouping that corresponds to the modern order Zingiberales, which includes families like Zingiberaceae (ginger family) and Musaceae (banana family).", "wikidata_id": "Q203779", "wikidata_description": "order of plants", "wikipedia_extract": "The ginger-families or ginger group or Core Zingiberales is a terminal clade in the order Zingiberales (Monocotyledoneae) that comprises Zingiberaceae (the ginger family), Costaceae, Marantaceae and Cannaceae. Their shared synapomorphy of a single fertile anther and four or five highly modified staminodia differentiate them from the basal paraphyletic assemblage of the \"banana-families\". They form a Suborder Zingiberineae Kress in taxonomic classification, with the following phylogeny, the four families being grouped into two superfamilies.", "wikipedia_url": "https://en.wikipedia.org/wiki/Zingiberales"}}, {"canonical_name": "tropical plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "tropical_plants", "book_id": "kosmos_humboldt_1845", "name": "tropical plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["tropical plants"], "contexts": ["plants from tropical regions"]}, {"entity_id": "tropical_plants", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tropical plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["tropical plants"], "contexts": ["plants from warm climates", "plants native to tropical regions"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "tropical plants", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tropical plants", "similarity": 1.0}], "id": 3807, "stable_key": "clu_27fb80036dd25500", "ground_truth": {"modern_name": "tropical plants", "confidence": "high", "type": "plant", "wikidata_id": "Q7846186", "wikidata_description": "vegetation in tropical latitudes"}}, {"canonical_name": "polarization of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "polarization_of_light", "book_id": "kosmos_humboldt_1845", "name": "polarization of light", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["polarization of light"], "contexts": ["theory about light's wave properties"]}, {"entity_id": "polarization_of_light", "book_id": "connexion_physical_sciences_somerville_1858", "name": "polarization of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["polarization of light", "Polarization of Light"], "contexts": ["orientation of light waves", "property of light affecting reflection and refraction"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "polarization of light", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "polarization of light", "similarity": 1.0}], "id": 3808, "stable_key": "clu_94fd9acb3c0e6322", "ground_truth": {"modern_name": "polarization of light", "confidence": "high", "type": "concept"}}, {"canonical_name": "Sidereal System", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "sidereal_systems", "book_id": "kosmos_humboldt_1845", "name": "Sidereal systems", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Sidereal systems"], "contexts": ["astronomical systems"]}, {"entity_id": "sidereal_system", "book_id": "first_principles_spencer_1862", "name": "Sidereal System", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Sidereal System", "sidereal system"], "contexts": ["system of stars", "system of stars and galaxies"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Sidereal systems", "target_book": "first_principles_spencer_1862", "target_name": "Sidereal System", "similarity": 0.966}], "id": 3809, "stable_key": "clu_65fdcbe736120cf6", "ground_truth": {"modern_name": "Stellar system", "confidence": "high", "type": "place", "note": "Refers to a group of stars, such as galaxies or star clusters.", "wikidata_id": "Q68651525", "wikidata_description": "scholarly article", "wikipedia_extract": "Sidereus Nuncius (usually Sidereal Messenger, also Starry Messenger or Sidereal Message) is a short astronomical treatise (or pamphlet) published in Neo-Latin by Galileo Galilei on March 13, 1610. It was the first published scientific work based on observations made through a telescope, and it contains the results of Galileo's early observations of the imperfect and mountainous Moon, of hundreds of stars not visible to the naked eye in the Milky Way and in certain constellations, and of the Medicean Stars (Galilean moons) that appeared to be circling Jupiter. The Latin word nuncius was typically used during this time period to denote messenger; however, it was also (though less frequently) rendered as message. Though the title Sidereus Nuncius is usually translated into English as Sidereal Messenger, many of Galileo's early drafts of the book and later related writings indicate that the intended purpose of the book was \"simply to report the news about recent developments in astronomy, not to pass himself off solemnly as an ambassador from heaven.\" The first telescopes appeared in the Netherlands in 1608, when Middelburg spectacle-maker Hans Lippershey tried to obtain a patent on one. By 1609 Galileo had learned of this and built his own improved version. He was not the first person to aim the new invention at the night sky but his was the first published study of celestial bodies using one.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sidereus_Nuncius"}}, {"canonical_name": "cholericas", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "cholericas", "book_id": "historia_medicinal_monardes_1574", "name": "cholericas", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["cholericas"], "contexts": ["choleric humors", "related to choler or yellow bile"]}, {"entity_id": "cholerico", "book_id": "historia_medicinal_monardes_1574", "name": "cholerico", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["cholerico"], "contexts": ["patient with choleric temperament"]}, {"entity_id": "choleric", "book_id": "polyanthea_medicinal", "name": "choleric", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["choleric", "choler"], "contexts": ["quality related to bile", "humor to be purged"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "cholericas", "target_book": "polyanthea_medicinal", "target_name": "choleric", "similarity": 0.969}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "cholerico", "target_book": "polyanthea_medicinal", "target_name": "choleric", "similarity": 0.989}], "id": 3810, "stable_key": "clu_b294656484f56a2f", "ground_truth": {"modern_name": "Choleric", "confidence": "high", "type": "concept", "description": "Relating to the humor of yellow bile; hot-tempered.", "note": "Refers to a humor in the humoral theory of medicine.", "wikipedia_extract": "The four temperament theory is a proto-psychological theory which suggests that there are four fundamental personality types: sanguine, choleric, melancholic, and phlegmatic. Most formulations include the possibility of mixtures among the types where an individual's personality types overlap and they share two or more temperaments. Greek physician Hippocrates (c. 460 \u2013 c. 370 BC) described the four temperaments as part of the ancient medical concept of humourism, that four bodily fluids affect human personality traits and behaviours. Modern medical science does not define a fixed relationship between internal secretions and personality, although some psychological personality type systems use categories similar to the Greek temperaments. The four temperament theory was abandoned after the 1850s. Temperament theory has its roots in the ancient theory of humourism."}}, {"canonical_name": "Babil\u00f3nia", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "babilon\u00eda", "book_id": "historia_medicinal_monardes_1574", "name": "Babilon\u00eda", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Babilon\u00eda"], "contexts": ["ancient city"]}, {"entity_id": "babil\u00f3nia", "book_id": "coloquios_da_orta_1563", "name": "Babil\u00f3nia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Babil\u00f3nia", "babil\u00f3nico"], "contexts": ["anciently named city", "possible origin of substance"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Babilon\u00eda", "target_book": "coloquios_da_orta_1563", "target_name": "Babil\u00f3nia", "similarity": 0.647}], "id": 3811, "stable_key": "clu_fc5322cb10dfccd4", "ground_truth": {"modern_name": "Babylon", "confidence": "high", "type": "place", "description": "An ancient Mesopotamian city, historically significant.", "note": "'Babil\u00f3nia' is the Portuguese spelling for Babylon.", "wikipedia_extract": "Babylon ( BAB-il-on) was an ancient city located on the lower Euphrates river in southern Mesopotamia, within modern-day Hillah, Iraq, about 85 kilometres (53 miles) south of modern-day Baghdad. Babylon functioned as the main cultural and political centre of the Akkadian-speaking region of Babylonia. Its rulers established two important empires in antiquity, the 19th\u201316th century BC Old Babylonian Empire, and the 7th\u20136th century BC Neo-Babylonian Empire. Babylon was also used as a regional capital of other empires, such as the Achaemenid Empire. Babylon was one of the most important urban centres of the ancient Near East, until its decline during the Hellenistic period. Nearby ancient sites are Kish, Borsippa, Dilbat, and Kutha."}}, {"canonical_name": "papa", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "papa", "book_id": "coloquios_da_orta_1563", "name": "papa", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["papa", "Papa"], "contexts": ["head of the Catholic Church", "Pope who sent his guard"]}, {"entity_id": "padre", "book_id": "polyanthea_medicinal", "name": "Padre", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Padre"], "contexts": ["took snake broths"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "papa", "target_book": "polyanthea_medicinal", "target_name": "Padre", "similarity": 0.85}], "id": 3812, "stable_key": "clu_1e5a6ee3add1dc91", "ground_truth": {"modern_name": "Pope", "confidence": "high", "type": "person", "description": "Head of the Catholic Church, associated with folk remedies", "wikidata_id": "Q25382", "wikidata_description": "species of bird", "wikipedia_url": "https://en.wikipedia.org/wiki/Eurasian%20bullfinch", "note": "The term 'Pontifice' (and its variations) could refer to the Pope or be used metaphorically for a paternal figure. Context is key.", "wikipedia_extract": "The Eurasian bullfinch, common bullfinch or bullfinch (Pyrrhula pyrrhula) is a small passerine bird in the finch family, Fringillidae. In Anglophone Europe it is known simply as the bullfinch (English regional, Shropshire: plum bird), as it is the original bird to bear the name bullfinch. The Eurasian bullfinch was formally described in 1758 by Linnaeus in the 10th edition of his Systema Naturae under the binomial name Loxia pyrrhula. It is now placed in the genus Pyrrhula that was introduced in 1760 by the French zoologist Mathurin Jacques Brisson. The Latin word pyrrhula comes from the Greek \u03c0\u03c5\u03c1\u03c1\u03cc\u03c2 (a flame-coloured bird, from \u03c0\u03c5\u03c1\u03c1\u03cc\u03c2 'flame-coloured', from \u03c0\u03c5\u03c1 'fire': Pyrrha), a 'worm eating bird' that is mentioned by Aristotle. The Latin name pyrrhula for the Eurasian bullfinch had been used in 1555 by the Swiss naturalist Conrad Gessner in his Historiae animalium."}}, {"canonical_name": "cau\u017fa fria", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "cau\u017fa_fr\u00eda", "book_id": "historia_medicinal_monardes_1574", "name": "cau\u017fa fr\u00eda", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["cau\u017fa fr\u00eda"], "contexts": ["cold cause of ailments"]}, {"entity_id": "cau\u017fa_fria", "book_id": "polyanthea_medicinal", "name": "cau\u017fa fria", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["cau\u017fa fria"], "contexts": ["cold cause", "cold cause, a concept in humoral theory"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "cau\u017fa fr\u00eda", "target_book": "polyanthea_medicinal", "target_name": "cau\u017fa fria", "similarity": 0.967}], "id": 3813, "stable_key": "clu_531dd9edf4f94e53", "ground_truth": {"modern_name": "Cold causation", "confidence": "high", "type": "concept"}}, {"canonical_name": "Hiera", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "hiera", "book_id": "historia_medicinal_monardes_1574", "name": "Hiera", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Hiera"], "contexts": ["herb used in medicine"]}, {"entity_id": "hiera", "book_id": "ricettario_fiorentino_1597", "name": "Hiera", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["Hiera", "Hiera picra", "Hierapicra"], "contexts": ["compound medicine name", "preparation for pills"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Hiera", "target_book": "ricettario_fiorentino_1597", "target_name": "Hiera", "similarity": 0.727}], "id": 3814, "stable_key": "clu_5a4358cda05f4b5c", "ground_truth": {"modern_name": "Hierapicra", "confidence": "high", "type": "substance", "description": "A historical medicinal compound, often a purgative.", "note": "Also known as Hiera Picra or Hiera.", "wikipedia_extract": "Centaurea () is a genus of over 700 species of herbaceous thistle-like flowering plants in the family Asteraceae. Members of the genus are found only north of the equator, mostly in the Eastern Hemisphere; the Middle East and surrounding regions are particularly species-rich. Common names for this genus are centaury, centory, starthistles, knapweeds, centaureas and the more ambiguous bluets; a vernacular name used for these plants in parts of England is loggerheads (common knapweed). The Plectocephalus group \u2013 possibly a distinct genus \u2013 is known as basketflowers. Cornflower is used for a few species, but that term more often specifically means either C. cyanus (the annual cornflower) or Centaurea montana (the perennial cornflower). The common name centaury is sometimes used, although this also refers to the unrelated plant genus Centaurium."}}, {"canonical_name": "gordas", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "engorda", "book_id": "historia_medicinal_monardes_1574", "name": "engorda", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["engorda"], "contexts": ["fattening"]}, {"entity_id": "gordas", "book_id": "polyanthea_medicinal", "name": "gordas", "category": "CONCEPT", "subcategory": "QUALITY", "count": 4, "variants": ["gordas", "gordo", "gordos"], "contexts": ["fatty, quality of food", "as coufas gordas"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "engorda", "target_book": "polyanthea_medicinal", "target_name": "gordas", "similarity": 0.887}], "id": 3815, "stable_key": "clu_91a9203eaa913d3a", "ground_truth": {"modern_name": "Fatty", "confidence": "high", "type": "concept"}}, {"canonical_name": "modernos", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "modernos", "book_id": "historia_medicinal_monardes_1574", "name": "Modernos", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Modernos"], "contexts": ["early modern scholars discussing dragon's blood"]}, {"entity_id": "modernos", "book_id": "polyanthea_medicinal", "name": "modernos", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 4, "variants": ["modernos"], "contexts": ["modern authors", "contemporary scholars or physicians"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Modernos", "target_book": "polyanthea_medicinal", "target_name": "modernos", "similarity": 0.659}], "id": 3816, "stable_key": "clu_eae8f7e15059f16d", "ground_truth": {"modern_name": "Modern authors", "confidence": "high", "type": "concept", "note": "Refers to contemporary scholars and authors within the context of the text.", "wikidata_id": "Q120129985", "wikidata_description": ""}}, {"canonical_name": "Entendimento", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "entendimiento", "book_id": "historia_medicinal_monardes_1574", "name": "entendimiento", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["entendimiento"], "contexts": ["faculty Ambar can improve"]}, {"entity_id": "entendimento", "book_id": "polyanthea_medicinal", "name": "Entendimento", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Entendimento", "conhecimento", "entendimento", "entendimiento"], "contexts": ["faculty of comprehension", "understanding"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "entendimiento", "target_book": "polyanthea_medicinal", "target_name": "Entendimento", "similarity": 0.931}], "id": 3817, "stable_key": "clu_ff211a0e4bfeed12-2", "ground_truth": {"modern_name": "Understanding", "confidence": "high", "type": "concept", "wikidata_id": "Q46744", "wikidata_description": "ability to think about and use concepts to deal adequately with an object", "wikipedia_url": "https://en.wikipedia.org/wiki/Understanding", "wikipedia_extract": "Understanding is a cognitive process related to an abstract or physical object, such as a person, situation, or message whereby one is able to use concepts to model that object. Understanding is a relation between the knower and an object of understanding. Understanding implies abilities and dispositions with respect to an object of knowledge that are sufficient to support intelligent behavior. Understanding is often, though not always, related to learning concepts, and sometimes also the theory or theories associated with those concepts. However, a person may have a good ability to predict the behavior of an object, animal or system\u2014and therefore may, in some sense, understand it\u2014without necessarily being familiar with the concepts or theories associated with that object, animal, or system in their culture. They may have developed their own distinct concepts and theories, which may be equivalent, better or worse than the recognized standard concepts and theories of their culture."}}, {"canonical_name": "Ovidio", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "ovidio", "book_id": "coloquios_da_orta_1563", "name": "Ovidio", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["Ovidio", "Ov\u00eddio"], "contexts": ["classical author of metamorphoses", "classical Greek and Latin mythology comparison"]}, {"entity_id": "ovidio", "book_id": "polyanthea_medicinal", "name": "Ovidio", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Ovidio"], "contexts": ["cited for a quote about monuments and writing"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Ovidio", "target_book": "polyanthea_medicinal", "target_name": "Ovidio", "similarity": 1.0}], "id": 3818, "stable_key": "clu_0d6da417cb9a92c9-2", "ground_truth": {"modern_name": "Ovid", "confidence": "high", "type": "person", "description": "Roman poet, author of 'Metamorphoses' and known for classical mythology.", "wikipedia_extract": "Publius Ovidius Naso (Latin: [\u02c8pu\u02d0bli\u028as \u0254\u02c8w\u026adi\u028as \u02c8na\u02d0so\u02d0]; 20 March 43 BC \u2013 AD 17/18), known in English as Ovid ( OV-id), was a Roman poet who lived during the reign of Augustus. He was a younger contemporary of Virgil and Horace, with whom he is often ranked as one of the three canonical poets of Latin literature. The Imperial scholar Quintilian considered him the last of the Latin love elegists. Although Ovid enjoyed enormous popularity during his lifetime, the emperor Augustus exiled him to Tomis, the capital of the newly organised province of Moesia, on the Black Sea, where he remained for the last nine or ten years of his life. Ovid himself attributed his banishment to a carmen et error (\"poem and a mistake\"), but his reluctance to disclose specifics has resulted in much speculation among scholars. Ovid is most famous for the Metamorphoses, a continuous mythological narrative in fifteen books written in dactylic hexameters."}}, {"canonical_name": "caro\u00e7os", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "caro\u00e7os", "book_id": "coloquios_da_orta_1563", "name": "caro\u00e7os", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["caro\u00e7os", "cardos"], "contexts": ["part of the fruit", "pits of fruits"]}, {"entity_id": "caro\u00e7os_deginjas", "book_id": "polyanthea_medicinal", "name": "caro\u00e7os deginjas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["caro\u00e7os deginjas"], "contexts": ["plum kernels"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "caro\u00e7os", "target_book": "polyanthea_medicinal", "target_name": "caro\u00e7os deginjas", "similarity": 0.887}], "id": 3819, "stable_key": "clu_0d5d774398fbb33b", "ground_truth": {"modern_name": "plum kernels", "confidence": "high", "type": "plant", "note": "The term 'caro\u00e7os' translates to 'kernels' or 'stones', and 'caro\u00e7os deginjas' specifically refers to plum kernels."}}, {"canonical_name": "ponente", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "ponente", "book_id": "coloquios_da_orta_1563", "name": "ponente", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["ponente"], "contexts": ["western regions", "direction of the west"]}, {"entity_id": "ponente", "book_id": "ricettario_fiorentino_1597", "name": "Ponente", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Ponente"], "contexts": ["region producing musk"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "ponente", "target_book": "ricettario_fiorentino_1597", "target_name": "Ponente", "similarity": 0.567}], "id": 3820, "stable_key": "clu_91816a699fe34669", "ground_truth": {"modern_name": "west", "confidence": "high", "type": "concept", "note": "In early modern texts, 'ponente' (or 'Ponente') refers to the west or western regions, often in a geographical or directional sense. The context of 'region producing musk' further solidifies this directional interpretation, as certain Western or Eastern regions might have been known for specific products.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "faca", "category": "OBJECT", "subcategory": "TOOL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "faca", "book_id": "coloquios_da_orta_1563", "name": "faca", "category": "OBJECT", "subcategory": "TOOL", "count": 3, "variants": ["faca", "facas"], "contexts": ["knife, a cutting tool", "tool for cutting"]}, {"entity_id": "faca", "book_id": "polyanthea_medicinal", "name": "faca", "category": "OBJECT", "subcategory": "TOOL", "count": 2, "variants": ["faca"], "contexts": ["brought a knife", "tool for cutting testicles"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "faca", "target_book": "polyanthea_medicinal", "target_name": "faca", "similarity": 1.0}], "id": 3821, "stable_key": "clu_f24684c271950071-2", "ground_truth": {"modern_name": "Knife", "confidence": "high", "type": "object", "wikidata_id": "Q32489", "wikidata_description": "tool with a cutting edge or blade", "wikipedia_url": "https://en.wikipedia.org/wiki/Knife", "wikipedia_extract": "A knife (pl.: knives; from Old Norse knifr 'knife, dirk') is a tool or weapon with a cutting edge or blade, usually attached to a handle or hilt. One of the earliest tools used by humanity, knives appeared at least 2.5 million years ago, as evidenced by the Oldowan tools. Originally made of wood, bone, and stone (such as flint and obsidian), over the centuries, in step with improvements in both metallurgy and manufacturing, knife blades have been made from copper, bronze, iron, steel, ceramic, and titanium. Most modern knives have fixed or folding blades, with styles varying by maker and country. Knives can serve various purposes. Hunters use a hunting knife, soldiers use the combat knife, scouts, campers, and hikers carry a pocketknife; there are kitchen knives for preparing foods (the chef's knife, the paring knife, bread knife, cleaver), table knife (butter knives and steak knives), weapons (daggers or switchblades), knives for throwing or juggling, and knives for religious ceremony or display (the kirpan)."}}, {"canonical_name": "simples", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "simples", "book_id": "coloquios_da_orta_1563", "name": "simples", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["simples"], "contexts": ["medicines from India", "single medicinal ingredient"]}, {"entity_id": "simplices", "book_id": "polyanthea_medicinal", "name": "Simplices", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Simplices"], "contexts": ["simple remedies"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "simples", "target_book": "polyanthea_medicinal", "target_name": "Simplices", "similarity": 0.932}], "id": 3822, "stable_key": "clu_db551c5b32287ce2", "ground_truth": {"modern_name": "Simple remedies", "confidence": "high", "type": "concept", "description": "Medicinal substances derived from single, unprocessed natural sources.", "note": "'Simples' refers to single, uncompounded medicinal ingredients, often plants.", "wikipedia_extract": "The doctrine of signatures, also known as the doctrine of correspondences, is a biomedicinal theory of pseudoscience. It states that herbs or animals have physical or behavioral traits that mirror the ailment it can successfully treat. Theological justifications, such as that of botanist William Cole, were that God would want to show men what plants would be useful for. The doctrine of signatures has a debated origin. Many historians believe it begins with primitive thinking methods, while other historians believe it originated with Dioscorides and was popularized in the 16th and 17th centuries after Jakob B\u00f6hme coined the doctrine of signatures in his book The Signature of All Things. This theory is a possible explanation for the ancient discovery of medicinal properties; however, there is no definitive proof as to whether the medicinal property or the connection in physical/behavioral traits was realized first."}}, {"canonical_name": "buxo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "buxo", "book_id": "coloquios_da_orta_1563", "name": "buxo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["buxo"], "contexts": ["plant used for comparison of color", "plant resembling the tree"]}, {"entity_id": "buxo", "book_id": "polyanthea_medicinal", "name": "buxo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["buxo"], "contexts": ["box tree", "elder plant"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "buxo", "target_book": "polyanthea_medicinal", "target_name": "buxo", "similarity": 1.0}], "id": 3823, "stable_key": "clu_f0312e6a9beec49b", "ground_truth": {"modern_name": "Box tree", "confidence": "high", "type": "plant", "linnaean": "Buxus sempervirens", "family": "Buxaceae", "description": "Shrub with evergreen leaves, used for comparison and its wood.", "note": "Mentions of 'elder plant' might indicate a confusion or a less common usage.", "wikipedia_extract": "Buxus sempervirens, the common box, European box, or boxwood, is a species of flowering plant in the genus Buxus, native to western and southern Europe, northwest Africa, and southwest Asia, from southern England south to northern Morocco, and east through the northern Mediterranean region to Turkey. Buxus colchica of western Caucasus and B. hyrcana of northern Iran and eastern Caucasus are commonly treated as synonyms of B. sempervirens. Buxus sempervirens is an evergreen shrub or small tree growing 1 to 9 m (3 to 30 ft) tall, with a trunk up to 20 centimetres (8 in) in diameter (exceptionally to 10 m tall and 45 cm diameter). Arranged in opposite pairs along the stems, the leaves are green to yellow-green, oval, 1.5\u20133 cm long, and 0.5\u20131.3 cm broad. The monoecious flowers are inconspicuous but highly scented, greenish-yellow, with no petals, and are insect pollinated; the fruit is a three-lobed capsule containing three to six seeds. The species typically grows on soils derived from chalk, limestone, usually as an understorey in forests of larger trees, most commonly associated with European beech (Fagus sylvatica) forests, but also sometimes in open dry montane scrub, particularly in the Mediterranean region."}}, {"canonical_name": "Zerumbet", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "zerumbet", "book_id": "coloquios_da_orta_1563", "name": "Zerumbet", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Zerumbet", "ZERUMBET", "zerumbet"], "contexts": ["subject of colloquy", "plant with debated identity"]}, {"entity_id": "zurumbet", "book_id": "ricettario_fiorentino_1597", "name": "Zurumbet", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Zurumbet"], "contexts": ["a type of ginger or spice", "ingredient in a preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Zerumbet", "target_book": "ricettario_fiorentino_1597", "target_name": "Zurumbet", "similarity": 0.895}], "id": 3824, "stable_key": "clu_dbff154057a4fc43", "ground_truth": {"modern_name": "Zerumbet ginger", "confidence": "high", "type": "plant", "linnaean": "Zingiber zerumbet Smith", "family": "Zingiberaceae", "note": "Zerumbet (or Zurumbet) is a historical name for Zingiber zerumbet, a species of ginger known for its medicinal and culinary uses, often mentioned in early modern botanical and pharmacopoeial texts.", "wikidata_id": "Q60980", "wikidata_description": "species of plant"}}, {"canonical_name": "carminativo", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "carminativo", "book_id": "coloquios_da_orta_1563", "name": "carminativo", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["carminativo", "carminativa"], "contexts": ["medicinal property of 'folio indo'", "property of linaloes"]}, {"entity_id": "carminativas", "book_id": "coloquios_da_orta_1563", "name": "carminativas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["carminativas"], "contexts": ["medicinal property for gas"]}, {"entity_id": "carminativas", "book_id": "polyanthea_medicinal", "name": "carminativas", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["carminativas"], "contexts": ["medicines to expel gas"]}, {"entity_id": "carminativos", "book_id": "polyanthea_medicinal", "name": "Carminativos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Carminativos"], "contexts": ["medicines to dispel windiness"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "carminativo", "target_book": "polyanthea_medicinal", "target_name": "carminativas", "similarity": 0.91}, {"source_book": "coloquios_da_orta_1563", "source_name": "carminativo", "target_book": "polyanthea_medicinal", "target_name": "Carminativos", "similarity": 0.909}, {"source_book": "coloquios_da_orta_1563", "source_name": "carminativas", "target_book": "polyanthea_medicinal", "target_name": "carminativas", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "carminativas", "target_book": "polyanthea_medicinal", "target_name": "Carminativos", "similarity": 0.929}], "id": 3825, "stable_key": "clu_32cc932cecbe57aa", "ground_truth": {"modern_name": "carminative", "confidence": "high", "type": "concept", "wikidata_id": "Q1734091", "wikidata_description": "herb or preparation intended to either prevent formation of gas in the gastrointestinal tract or facilitate the expulsion of said gas, thereby combatting flatulence"}}, {"canonical_name": "Agnocasto", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "agnocasto", "book_id": "coloquios_da_orta_1563", "name": "agnocasto", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["agnocasto", "agnO'Casto"], "contexts": ["plant used to repress carnal desires", "plant distinguished from negundo"]}, {"entity_id": "agnocasto", "book_id": "polyanthea_medicinal", "name": "Agnocasto", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Agnocasto", "Agnocafto", "agnocasto"], "contexts": ["chaste tree", "chaste tree, herb"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "agnocasto", "target_book": "polyanthea_medicinal", "target_name": "Agnocasto", "similarity": 0.98}], "id": 3826, "stable_key": "clu_bc25bb888df0700c", "ground_truth": {"modern_name": "Chaste tree", "confidence": "high", "type": "plant", "linnaean": "Vitex agnus-castus L.", "family": "Verbenaceae", "wikipedia_extract": "Vitex is a genus of flowering plants in the family Lamiaceae. It has about 200\u2013250 species; as of August 2025 the Plants of the World Online database accepts 211 species. Common names include chaste tree or chastetree, traditionally referring to V. agnus-castus, but often applied to other species, as well, and p\u016briri for the New Zealand species V. lucens. Species of Vitex are native throughout the tropics and subtropics, with a few species in warm-temperate Eurasia and one in New Zealand.", "wikipedia_url": "https://en.wikipedia.org/wiki/Vitex", "description": "Shrub whose berries were used to reduce libido and for medicinal purposes.", "note": "'Agnocasto' is the Italian/Portuguese name for Vitex agnus-castus.", "wikidata_id": "Q29533", "wikidata_description": "species of flowering plant"}}, {"canonical_name": "milho miudo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "milho", "book_id": "coloquios_da_orta_1563", "name": "milho", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["milho"], "contexts": ["plant", "seeds similar to long pepper"]}, {"entity_id": "milho_miudo", "book_id": "polyanthea_medicinal", "name": "milho miudo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["milho miudo"], "contexts": ["small millet used in syrup", "ingredient in a preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "milho", "target_book": "polyanthea_medicinal", "target_name": "milho miudo", "similarity": 0.924}], "id": 3827, "stable_key": "clu_e76bec39b57bec9b", "ground_truth": {"modern_name": "millet", "confidence": "high", "type": "plant", "description": "A small-grained cereal grass, used as food and in preparations.", "note": "The term 'milho miudo' specifically refers to small millet.", "wikipedia_extract": "Millets () are a highly varied group of small-seeded grasses, widely grown around the world as cereal crops or grains for fodder and human food. Most millets belong to the tribe Paniceae. Millets are important crops in the semi-arid tropics of Asia and Africa, especially in India, Mali, Nigeria, and Niger, with 97% of production in developing countries. The crop is favoured for its productivity and short growing season under hot dry conditions. The millets are sometimes understood to include the widely cultivated sorghum; apart from that, pearl millet is the most commonly cultivated of the millets. Finger millet, proso millet, barnyard millet, little millet, kodo millet, browntop millet and foxtail millet are other important crop species."}}, {"canonical_name": "Carlos Magno", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "carlos_magno", "book_id": "coloquios_da_orta_1563", "name": "Carlos Magno", "category": "PERSON", "subcategory": "PATRON", "count": 2, "variants": ["Carlos Magno"], "contexts": ["recipient of a gift", "historical ruler mentioned with numbers"]}, {"entity_id": "carlos_magno", "book_id": "polyanthea_medicinal", "name": "Carlos Magno", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Carlos Magno", "Alexandre Magno"], "contexts": ["Emperor who received root from an Angel", "Emperor Charles the Great"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Carlos Magno", "target_book": "polyanthea_medicinal", "target_name": "Carlos Magno", "similarity": 0.766}], "id": 3828, "stable_key": "clu_2d75ef2e5c0c5b40", "ground_truth": {"modern_name": "Charlemagne", "confidence": "high", "type": "person", "birth_year": 747, "death_year": 814, "description": "Frankish king and Holy Roman Emperor, historical figure", "wikidata_id": "Q3044", "wikidata_description": "king of Franks, regarded as the first Holy Roman Emperor (747\u2013814)"}}, {"canonical_name": "mumia", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "m\u00famia", "book_id": "coloquios_da_orta_1563", "name": "m\u00famia", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["m\u00famia"], "contexts": ["main ingredient in a 'solda'"]}, {"entity_id": "mumia", "book_id": "polyanthea_medicinal", "name": "mumia", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["mumia", "Mumia", "Mumia hominisfani", "Mumiade"], "contexts": ["mummy, ingredient in oil", "mummy, medicinal substance"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "m\u00famia", "target_book": "polyanthea_medicinal", "target_name": "mumia", "similarity": 0.86}], "id": 3829, "stable_key": "clu_4e2c60a631f383b0", "ground_truth": {"modern_name": "mummy", "confidence": "high", "type": "substance", "description": "Preserved human or animal remains used as a medicinal substance.", "wikipedia_extract": "A mummy is a dead human or an animal whose soft tissues and organs have been preserved by either intentional or accidental exposure to chemicals, extreme cold, very low humidity, or lack of air, so that the recovered body does not decay further if kept in cool and dry conditions. Some authorities restrict the use of the term to bodies deliberately embalmed with chemicals, but the use of the word to cover accidentally desiccated bodies goes back to at least the early 17th century. Mummies of humans and animals have been found on every continent, both as a result of natural preservation through unusual conditions, and as cultural artifacts. Over one million animal mummies have been found in Egypt, many of which are cats. Many of the Egyptian animal mummies are sacred ibis, and radiocarbon dating suggests the Egyptian ibis mummies that have been analyzed were from a time frame that falls between approximately 450 and 250 BC. The earliest discovered evidence of deliberate mummification in human cultures now extends to approximately 10,000 B.C. and is documented to have existed across Southeast Asia, China, New Guinea, and Australia in burials discovered there, and is prompting research to cultures documented to 20,000 years ago for evidence of use of the same mummification methods."}}, {"canonical_name": "caput", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "caput", "book_id": "coloquios_da_orta_1563", "name": "caput", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["caput"], "contexts": ["Latin for head"]}, {"entity_id": "caput", "book_id": "polyanthea_medicinal", "name": "caput", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["caput", "CAPUT"], "contexts": ["head", "head of the people"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "caput", "target_book": "polyanthea_medicinal", "target_name": "caput", "similarity": 1.0}], "id": 3830, "stable_key": "clu_d39c353bdd295151-3", "ground_truth": {"modern_name": "Head", "confidence": "high", "type": "concept", "note": "Refers to the anatomical head, but also used metaphorically for leadership or highest point. In this context, medical and anatomical references suggest the former.", "wikidata_id": "Q23640", "wikidata_description": "anterior anatomical region in many animals, which tends to contain sensory and nervous organs and orifices for ingestion and breathing", "wikipedia_url": "https://en.wikipedia.org/wiki/Head", "wikipedia_extract": "A head is the part of an organism which usually includes the ears, brain, forehead, cheeks, chin, eyes, nose, and mouth, each of which aid in various sensory functions such as sight, hearing, smell, and taste. Some very simple animals may not have a head, but many bilaterally symmetric forms do, regardless of size. Heads develop in animals by an evolutionary trend known as cephalization. In bilaterally symmetrical animals, nervous tissue concentrate at the anterior region, forming structures responsible for information processing. Through biological evolution, sense organs and feeding structures also concentrate into the anterior region; these collectively form the head. The human head is an anatomical unit that consists of the skull, hyoid bone and cervical vertebrae."}}, {"canonical_name": "rosalgar", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "rosalgar", "book_id": "coloquios_da_orta_1563", "name": "rosalgar", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["rosalgar"], "contexts": ["medicine administered"]}, {"entity_id": "rosalgar", "book_id": "polyanthea_medicinal", "name": "rosalgar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["rosalgar", "rosalgar branco", "ro\u017falgar"], "contexts": ["preparation, a refined poison", "arsenic"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "rosalgar", "target_book": "polyanthea_medicinal", "target_name": "rosalgar", "similarity": 0.526}], "id": 3831, "stable_key": "clu_2a9759c25f4a6cd6", "ground_truth": {"modern_name": "Realgar", "confidence": "high", "type": "mineral", "wikidata_id": "Q109746", "wikidata_description": "arsenic sulfide mineral"}}, {"canonical_name": "impotencias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "impotentes", "book_id": "coloquios_da_orta_1563", "name": "impotentes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["impotentes"], "contexts": ["effect of camphor on men"]}, {"entity_id": "impotencias", "book_id": "polyanthea_medicinal", "name": "impotencias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["impotencias", "impotencia"], "contexts": ["impotence", "inability to sleep"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "impotentes", "target_book": "polyanthea_medicinal", "target_name": "impotencias", "similarity": 0.967}], "id": 3832, "stable_key": "clu_ba0d5f7ccc1e357e", "ground_truth": {"modern_name": "impotence", "confidence": "high", "type": "disease", "description": "Inability to achieve or maintain sexual erection; general inability.", "wikipedia_extract": "Erectile dysfunction (ED), also referred to as impotence, is a form of sexual dysfunction in males characterized by the persistent or recurring inability to achieve or maintain a penile erection with sufficient rigidity and duration for satisfactory sexual activity. It is the most common sexual problem in males and can cause psychological distress due to its impact on self-image and sexual relationships. The term erectile dysfunction does not encompass other erection-related disorders, such as priapism. The majority of ED cases are attributed to physical risk factors and predictive factors. These factors can be categorized as vascular, neurological, local penile, hormonal, and drug-induced. Notable predictors of ED include aging, cardiovascular disease, diabetes mellitus, high blood pressure, obesity, abnormal lipid levels in the blood, hypogonadism, smoking, depression, and medication use."}}, {"canonical_name": "Cadmia", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "cadmia", "book_id": "ricettario_fiorentino_1597", "name": "Cadmia", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["Cadmia", "cadmi3", "cadmia", "cadmia naturale"], "contexts": ["mineral substance for heating", "cadmia, a zinc ore"]}, {"entity_id": "cadmium", "book_id": "connexion_physical_sciences_somerville_1858", "name": "cadmium", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["cadmium"], "contexts": ["metal producing a spectrum"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Cadmia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "cadmium", "similarity": 0.918}], "id": 3833, "stable_key": "clu_19825a6d180a1633", "ground_truth": {"modern_name": "Cadmium", "confidence": "high", "type": "chemical", "note": "The substance 'Cadmia' in early modern texts could refer to calamine (a zinc ore) or more broadly to zinc oxide or even impure zinc metal. The mention of a 'metal producing a spectrum' in Somerville's text strongly points to elemental cadmium, likely discovered in the early 19th century and named after the ore from which it was derived (cadmia)."}}, {"canonical_name": "Scariola", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "scariola", "book_id": "ricettario_fiorentino_1597", "name": "Scariola", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Scariola"], "contexts": ["herb used in syrup", "ingredient in a syrup"]}, {"entity_id": "scariola", "book_id": "polyanthea_medicinal", "name": "Scariola", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Scariola"], "contexts": ["plant juice used in remedies"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Scariola", "target_book": "polyanthea_medicinal", "target_name": "Scariola", "similarity": 1.0}], "id": 3834, "stable_key": "clu_dad3bbd264e3606f", "ground_truth": {"modern_name": "Scariola", "confidence": "high", "type": "plant", "description": "A genus of plants, often referring to wild lettuce, used medicinally.", "note": "Likely refers to a species within the *Lactuca* genus, commonly known as wild lettuce.", "wikipedia_extract": "Lactuca, commonly known as lettuce, is a genus of flowering plants in the family Asteraceae. The genus includes at least 50 species, distributed worldwide, but mainly in temperate Eurasia. Its best-known representative is the garden lettuce (Lactuca sativa), with its many varieties. \"Wild lettuce\" commonly refers to the wild-growing relatives of common garden lettuce. Many species are common weeds. Lactuca species are diverse and take a wide variety of forms. They are annuals, biennials, perennials, or shrubs."}}, {"canonical_name": "Carlina", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "carlina", "book_id": "ricettario_fiorentino_1597", "name": "carlina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["carlina"], "contexts": ["root collected and dried", "herb mentioned in the passage"]}, {"entity_id": "carlina", "book_id": "polyanthea_medicinal", "name": "Carlina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Carlina", "Carlinu"], "contexts": ["root used as a remedy", "root used as antidote and for pestilence"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "carlina", "target_book": "polyanthea_medicinal", "target_name": "Carlina", "similarity": 0.875}], "id": 3835, "stable_key": "clu_1b00fbeffdbc5fc3", "ground_truth": {"modern_name": "Carlina", "confidence": "high", "type": "plant", "linnaean": "Carlina acaulis", "family": "Asteraceae", "note": "Carlina acaulis (carline thistle) is a well-known medicinal plant with a long history of use, particularly its root.", "wikidata_id": "Q1136447", "wikidata_description": "genus of plants"}}, {"canonical_name": "epatica", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "epatico", "book_id": "ricettario_fiorentino_1597", "name": "epatico", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["epatico"], "contexts": ["type of aloe juice"]}, {"entity_id": "epatica", "book_id": "polyanthea_medicinal", "name": "epatica", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["epatica"], "contexts": ["ingredient in a decoction for fever", "liverwort, a plant"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "epatico", "target_book": "polyanthea_medicinal", "target_name": "epatica", "similarity": 0.977}], "id": 3836, "stable_key": "clu_e1339fce63ab92e3", "ground_truth": {"modern_name": "liverwort", "confidence": "high", "type": "plant", "linnaean": "Marchantiopsida", "family": "Marchantiaceae", "note": "The early modern term 'liverwort' encompasses various plants now classified under different orders and families within the division Bryophyta. Marchantiopsida is a broad class that includes the most common forms referred to by this name historically. The specific family is harder to pinpoint without more context, but Marchantiaceae is a representative example.", "wikidata_id": "Q161050", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Anemone%20hepatica", "wikipedia_extract": "Marchantiopsida is a class of liverworts within the phylum Marchantiophyta. The species in this class are known as complex thalloid liverworts. The species in this class are widely distributed and can be found worldwide. Complex oil bodies are only found in the gametophyte. Marchantiidae Engl. 1893 sensu He-Nygr\u00e9n et al. 2006 Marchantiales Limpr. 1877 (complex thalloids) Aytoniaceae Cavers 1911  [Rebouliaceae; Grimaldiaceae] Conocephalaceae M\u00fcll.Frib. ex Grolle 1972 Cyathodiaceae Stotler & Crand.-Stotl. 2000 Exormothecaceae M\u00fcll.Frib.", "description": "A small, non-vascular plant often used for liver ailments."}}, {"canonical_name": "fol", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "fole", "book_id": "ricettario_fiorentino_1597", "name": "fole", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["fole"], "contexts": ["sun exposure"]}, {"entity_id": "fol", "book_id": "polyanthea_medicinal", "name": "fol", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["fol"], "contexts": ["page number indicator", "folio"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "fole", "target_book": "polyanthea_medicinal", "target_name": "fol", "similarity": 0.943}], "id": 3837, "stable_key": "clu_43d60f0d9b0b6be5", "ground_truth": {"modern_name": "Bellows", "confidence": "low", "type": "object", "note": "The context 'sun exposure' is unusual for 'bellows'. It could also refer to a page or leaf in a book, or a section of text, especially given 'fol' (from Latin 'folium').", "wikidata_id": "Q37260822", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Bellows%20%28surname%29"}}, {"canonical_name": "althea", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "althea", "book_id": "ricettario_fiorentino_1597", "name": "Althea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Althea"], "contexts": ["herb used in plaster"]}, {"entity_id": "althea", "book_id": "polyanthea_medicinal", "name": "althea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Althea", "althea"], "contexts": ["ingredient in unguento", "unguent used in a liniment"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Althea", "target_book": "polyanthea_medicinal", "target_name": "althea", "similarity": 0.82}], "id": 3838, "stable_key": "clu_d51a7dad640ac8f8", "ground_truth": {"modern_name": "Marshmallow", "confidence": "high", "type": "plant", "linnaean": "Althaea officinalis", "family": "Malvaceae", "note": "Althea is the classical Latin name for Althaea officinalis, commonly known as marshmallow, which has a long history of medicinal use.", "wikidata_id": "Q158496", "wikidata_description": "species of plant"}}, {"canonical_name": "inflama\u00e7\u00e3odo cerebro", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "inflama\u00e7\u00e3odo_cerebro", "book_id": "polyanthea_medicinal", "name": "inflama\u00e7\u00e3odo cerebro", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["inflama\u00e7\u00e3odo cerebro", "inflamma\u00e7aodo cerebro", "inflamma\u00e7\u00e3o no cerebro", "inflamma\u00e7\u00e3odo cerebro"], "contexts": ["brain inflammation", "condition related to vomiting"]}, {"entity_id": "inflammation_of_the_brain", "book_id": "first_principles_spencer_1862", "name": "inflammation of the brain", "category": "DISEASE", "subcategory": "OTHE