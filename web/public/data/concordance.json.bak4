al_mentions": 36, "members": [{"entity_id": "calbanum", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Calbanum", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["Calbanum"], "contexts": ["gum drawing not at all"]}, {"entity_id": "cancamo", "book_id": "coloquios_da_orta_1563", "name": "cancamo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 10, "variants": ["Cancamo", "cancamo"], "contexts": ["fragrant substance used for perfumes", "substance in question"]}, {"entity_id": "galbano", "book_id": "ricettario_fiorentino_1597", "name": "Galbano", "category": "PLANT", "subcategory": "RESIN", "count": 15, "variants": ["Galbano", "GALBANO", "galbano"], "contexts": ["resin with strong odor", "liquor from a ferula, now unknown"]}, {"entity_id": "cancamo", "book_id": "ricettario_fiorentino_1597", "name": "Cancamo", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["Cancamo"], "contexts": ["Greek name for Lacca"]}, {"entity_id": "galbano", "book_id": "polyanthea_medicinal", "name": "galbano", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["Galbano", "galbano"], "contexts": ["galbanum, used in plaster", "incense for stupor"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Calbanum", "target_book": "ricettario_fiorentino_1597", "target_name": "Galbano", "similarity": 0.882}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Calbanum", "target_book": "ricettario_fiorentino_1597", "target_name": "Cancamo", "similarity": 0.896}, {"source_book": "coloquios_da_orta_1563", "source_name": "cancamo", "target_book": "ricettario_fiorentino_1597", "target_name": "Cancamo", "similarity": 0.751}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Galbano", "target_book": "polyanthea_medicinal", "target_name": "galbano", "similarity": 0.587}], "id": 413, "stable_key": "clu_d14b780bdee48adc", "ground_truth": {"modern_name": "Galangal", "confidence": "high", "type": "plant", "linnaean": "Alpinia galanga", "family": "Zingiberaceae", "description": "An aromatic root used medicinally and as a spice.", "note": "Distinct from galbanum.", "wikipedia_extract": "Alpinia galanga, a plant in the ginger family, bears a rhizome used largely as an herb in Unani medicine and as a spice in Southeast Asian cookery. It is one of four plants known as \"galangal\". Its common names include greater galangal, lengkuas, and blue ginger. The name \"galangal\" is probably derived from Persian qulanjan or Arabic khalanjan, which in turn may be an adaptation of Chinese gao liang jiang. Its names in North India are derived from the same root, including kulanja in Sanskrit, kulanjan in Hindi, and kholinjan in Urdu. The name \"lengkuas\", on the other hand, is derived from Malay lengkuas, which is derived from Proto-Western Malayo-Polynesian *la\u014bkuas, with cognates including Ilokano langku\u00e1s; Tagalog, Bikol, Kapampangan, Visayan, and Manobo langk\u00e1uas or langk\u00e1was; Aklanon eangkaw\u00e1s; Kadazan Dusun hongkuas; Ida'an lengkuas; Ngaju Dayak langkuas; and Iban engkuas."}}, {"canonical_name": "lune", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 4, "total_mentions": 36, "members": [{"entity_id": "lune", "book_id": "epoques_nature_buffon_1778", "name": "lune", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 16, "variants": ["lune"], "contexts": ["celestial body placed in the sky", "celestial body, second star"]}, {"entity_id": "lune", "book_id": "relation_historique_humboldt_vol3_1825", "name": "lune", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 14, "variants": ["Lune", "lune", "LUNE"], "contexts": ["celestial body", "celestial body with circular basins"]}, {"entity_id": "moon", "book_id": "principles_of_psychology_james_1890", "name": "moon", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 5, "variants": ["moon"], "contexts": ["natural satellite of the earth", "celestial body"]}, {"entity_id": "luna", "book_id": "historia_medicinal_monardes_1574", "name": "Luna", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Luna"], "contexts": ["celestial body, the moon"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "lune", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "lune", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "lune", "target_book": "principles_of_psychology_james_1890", "target_name": "moon", "similarity": 0.944}, {"source_book": "epoques_nature_buffon_1778", "source_name": "lune", "target_book": "historia_medicinal_monardes_1574", "target_name": "Luna", "similarity": 0.951}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "lune", "target_book": "principles_of_psychology_james_1890", "target_name": "moon", "similarity": 0.944}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "lune", "target_book": "historia_medicinal_monardes_1574", "target_name": "Luna", "similarity": 0.951}, {"source_book": "principles_of_psychology_james_1890", "source_name": "moon", "target_book": "historia_medicinal_monardes_1574", "target_name": "Luna", "similarity": 0.948}], "id": 414, "stable_key": "clu_1f192b291e12d6e8", "ground_truth": {"modern_name": "Moon", "confidence": "high", "type": "object", "note": "The term 'lune' was used in some contexts to refer to the moon, particularly in older texts or when discussing its astronomical or astrological significance. 'Luna' is the Latin word for moon.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Moon", "wikipedia_extract": "The Moon is the only natural satellite of Earth. It orbits around Earth at an average distance of 384,399 kilometres (238,854 mi), a distance roughly 30 times the width of Earth. It completes an orbit (lunar month) in relation to Earth and the Sun (synodically) every 29.5 days. The Moon and Earth are bound by gravitational attraction, which is stronger on the sides facing each other. The resulting tidal forces are the main driver of Earth's tides, and have pulled the Moon to always face Earth with the same near side. This tidal locking effectively synchronizes the Moon's rotation period (lunar day) to its orbital period (lunar month)."}}, {"canonical_name": "Mexicanos", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 36, "members": [{"entity_id": "mexicanos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Mexicanos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 29, "variants": ["mexicanos", "Mexicanos"], "contexts": ["indigenous people of Mexico", "people who use the name tlaolii"]}, {"entity_id": "mexicanas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Mexicanas", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Mexicanas"], "contexts": ["women who chew a mineral"]}, {"entity_id": "mexicains", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mexicains", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["Mexicains"], "contexts": ["people of Mexico", "migrating people"]}, {"entity_id": "mexicans", "book_id": "kosmos_humboldt_1845", "name": "Mexicans", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Mexicans"], "contexts": ["people known for wild and cruel incursions"]}, {"entity_id": "mexicans", "book_id": "first_principles_spencer_1862", "name": "Mexicans", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Mexicans"], "contexts": ["people who used picture-writing"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Mexicanos", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Mexicains", "similarity": 0.965}, {"source_bo