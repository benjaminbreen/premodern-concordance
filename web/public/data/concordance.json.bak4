: "nostrils", "book_id": "origin_of_species_darwin_1859", "name": "nostrils", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["nostrils"], "contexts": ["part of pigeon anatomy", "openings for breathing"]}, {"entity_id": "nostril", "book_id": "origin_of_species_darwin_1859", "name": "nostril", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["nostril"], "contexts": ["measured length of bird's nostril"]}, {"entity_id": "nostrils", "book_id": "principles_of_psychology_james_1890", "name": "nostrils", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["nostrils"], "contexts": ["external openings of the nose", "details to be distinguished"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "nostrils", "target_book": "principles_of_psychology_james_1890", "target_name": "nostrils", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "nostril", "target_book": "principles_of_psychology_james_1890", "target_name": "nostrils", "similarity": 0.981}], "id": 3397, "stable_key": "clu_984fe778c6ab94d6", "ground_truth": {"modern_name": "Nostril", "confidence": "high", "type": "anatomy", "wikidata_id": "Q135402101", "wikidata_description": "fictional animal character from Wild Kratts"}}, {"canonical_name": "division of labour", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "division_of_labour", "book_id": "origin_of_species_darwin_1859", "name": "division of labour", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["division of labour"], "contexts": ["specialization of functions", "specialization of tasks"]}, {"entity_id": "division_of_labour", "book_id": "first_principles_spencer_1862", "name": "division of labour", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["division of labour"], "contexts": ["specialization of tasks in production", "specialization of tasks in society"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "division of labour", "target_book": "first_principles_spencer_1862", "target_name": "division of labour", "similarity": 1.0}], "id": 3398, "stable_key": "clu_65864a820718e9ec", "ground_truth": {"modern_name": "Division of labor", "confidence": "high", "type": "concept"}}, {"canonical_name": "pal\u00e6ozoic period", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "pal\u00e6ozoic_period", "book_id": "origin_of_species_darwin_1859", "name": "pal\u00e6ozoic period", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["pal\u00e6ozoic period"], "contexts": ["geological period of species extinction", "geological time period"]}, {"entity_id": "pal\u00e6ozoic", "book_id": "origin_of_species_darwin_1859", "name": "pal\u00e6ozoic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["pal\u00e6ozoic"], "contexts": ["geological era with ancient animals", "geological epoch of ancient life forms"]}, {"entity_id": "pal\u00e6ozoic", "book_id": "first_principles_spencer_1862", "name": "Pal\u00e6ozoic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Pal\u00e6ozoic"], "contexts": ["earliest known fossiliferous strata", "geologic period with early vertebrate fauna"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "pal\u00e6ozoic period", "target_book": "first_principles_spencer_1862", "target_name": "Pal\u00e6ozoic", "similarity": 0.898}, {"source_book": "origin_of_species_darwin_1859", "source_name": "pal\u00e6ozoic", "target_book": "first_principles_spencer_1862", "target_name": "Pal\u00e6ozoic", "similarity": 0.95}], "id": 3399, "stable_key": "clu_9b34371b388d23ce", "ground_truth": {"modern_name": "Paleozoic Era", "confidence": "high", "type": "concept"}}, {"canonical_name": "Sir John", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "sir_j_", "book_id": "origin_of_species_darwin_1859", "name": "Sir J.", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Sir J."], "contexts": ["individual mentioned in the text"]}, {"entity_id": "sir_john", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Sir John", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 5, "variants": ["Sir John"], "contexts": ["scientist discussing solar phenomena", "quoted on solar and earth's atmospheric effects"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Sir J.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Sir John", "similarity": 0.886}], "id": 3400, "stable_key": "clu_7704807617099028-3", "ground_truth": {"modern_name": "John Herschel", "confidence": "high", "type": "person", "birth_year": 1792, "death_year": 1871, "description": "Astronomer and mathematician, son of William Herschel.", "wikidata_id": "Q14278", "wikidata_description": "English polymath, mathematician, astronomer, chemist, inventor and photographer (*1792 \u2013 \u20201871)", "wikipedia_url": "https://en.wikipedia.org/wiki/John%20Herschel", "note": "The context of 'connexion_physical_sciences_somerville_1858' and discussions of solar phenomena strongly point to Sir John Herschel.", "wikipedia_extract": "Sir John Frederick William Herschel, 1st Baronet  (; 7 March 1792 \u2013 11 May 1871) was an English polymath active as a mathematician, astronomer, chemist, inventor and experimental photographer who invented the blueprint and did botanical work. Herschel originated the use of the Julian day system in astronomy. He named seven moons of Saturn and four moons of Uranus \u2013 the seventh planet, discovered by his father Sir William Herschel. He made many contributions to the science of photography, and investigated colour blindness and the chemical power of ultraviolet rays. His Preliminary Discourse (1831), which advocated an inductive approach to scientific experiment and theory-building, was an important contribution to the philosophy of science. Herschel was born in Slough, Buckinghamshire, the son of Mary Baldwin and astronomer Sir William Herschel."}}, {"canonical_name": "temperate zone", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "temperate_region", "book_id": "origin_of_species_darwin_1859", "name": "temperate region", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["temperate region"], "contexts": ["region between tropics and polar circles"]}, {"entity_id": "temperate_zone", "book_id": "kosmos_humboldt_1845", "name": "temperate zone", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["temperate Zone", "temperate zone"], "contexts": ["geographic area between tropics and poles", "zone favorable to reason and civilization"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "temperate region", "target_book": "kosmos_humboldt_1845", "target_name": "temperate zone", "similarity": 0.976}], "id": 3401, "stable_key": "clu_5cc1e393fc5c44c9", "ground_truth": {"modern_name": "Temperate Zone", "confidence": "high", "type": "place"}}, {"canonical_name": "word-deafness", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "deafness", "book_id": "origin_of_species_darwin_1859", "name": "deafness", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["deafness"], "contexts": ["linked to blue eyes in cats"]}, {"entity_id": "word-deafness", "book_id": "principles_of_psychology_james_1890", "name": "word-deafness", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["word-deafness"], "contexts": ["inability to understand spoken words", "cases studied by Allen Starr"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "deafness", "target_book": "principles_of_psychology_james_1890", "target_name": "word-deafness", "similarity": 0.943}], "id": 3402, "stable_key": "clu_1417880785f873bd", "ground_truth": {"modern_name": "Pure word deafness", "confidence": "high", "type": "disease", "modern_term": "Pure word deafness", "note": "The term 'deafness' is very broad, but 'word-deafness' specifically points to this condition.", "wikidata_id": "Q76005580", "wikidata_description": "scientific article published on 01 February 1952"}}, {"canonical_name": "Rocky Mountains", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "rocky_mountains", "book_id": "origin_of_species_darwin_1859", "name": "Rocky Mountains", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Rocky Mountains"], "contexts": ["mountain range with erratic boulders"]}, {"entity_id": "rocky_mountains", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rocky Mountains", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Rocky Mountains", "Rocky Mount."], "contexts": ["mountain range", "Rocky Mountains"]}, {"entity_id": "rocky-mountains", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rocky-Mountains", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Rocky-Mountains"], "contexts": ["mountain range"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Rocky Mountains", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Rocky Mountains", "similarity": 0.817}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Rocky Mountains", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Rocky-Mountains", "similarity": 0.945}], "id": 3403, "stable_key": "clu_8ad5072ccfe68512", "ground_truth": {"wikipedia_extract": "The Rocky Mountains, also known as the Rockies, are a major mountain range and the largest mountain system in North America. The Rocky Mountains stretch 3,000 mi (4,800 km) in a straight-line distance from the northernmost part of Western Canada, to New Mexico in the Southwestern United States. Depending on differing definitions between Canada and the U.S., its northern terminus is located either in northern British Columbia's Terminal Range south of the Liard River and east of the Trench, or in the northeastern foothills of the Brooks Range/British Mountains that face the Beaufort Sea coasts between the Canning River and the Firth River across the Alaska\u2013Yukon border. Its southernmost point is near the Albuquerque metropolitan area, adjacent to the Rio Grande rift, and north of the Sandia\u2013Manzano Mountain Range, also near Santa Fe, New Mexico. Being the easternmost portion of the North American Cordillera, the Rockies are distinct from the tectonically younger Cascade Range and Sierra Nevada, which both lie farther to its west. The Rockies formed 55 million to 80 million years ago during the Laramide orogeny, in which a number of plates began sliding underneath the North American plate."}}, {"canonical_name": "W. Thomson", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "thomson", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Thomson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Thomson"], "contexts": ["author of Chemistry edition"]}, {"entity_id": "w__thomson", "book_id": "connexion_physical_sciences_somerville_1858", "name": "W. Thomson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["W. Thomson"], "contexts": ["proved experimentally about freezing water", "computed power from solar radiation"]}, {"entity_id": "thomson", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Thomson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Thomson"], "contexts": ["mathematically investigated Faraday's discovery"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Thomson", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "W. Thomson", "similarity": 0.89}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Thomson", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Thomson", "similarity": 1.0}], "id": 3404, "stable_key": "clu_ad1de19610fb6e51", "ground_truth": {"modern_name": "William Thomson", "confidence": "medium", "type": "person", "description": "Scientist who investigated water freezing and Faraday's work.", "note": "The initial 'W.' is crucial; assuming 'William' is the most common first name for a Thomson of that era in scientific circles.", "wikidata_id": "Q75961067", "wikidata_description": "Peerage person ID=432095"}}, {"canonical_name": "ti\u00f1a", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "ti\u00f1a", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "ti\u00f1a", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["ti\u00f1a"], "contexts": ["ringworm", "skin condition treated with coraron"]}, {"entity_id": "ti\u00f1a", "book_id": "historia_medicinal_monardes_1574", "name": "Ti\u00f1a", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Ti\u00f1a"], "contexts": ["skin condition on the head"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ti\u00f1a", "target_book": "historia_medicinal_monardes_1574", "target_name": "Ti\u00f1a", "similarity": 0.801}], "id": 3405, "stable_key": "clu_aaad93dfbea85181", "ground_truth": {"modern_name": "ringworm", "confidence": "high", "type": "disease", "modern_term":