ty", "similarity": 0.913}], "id": 2684, "stable_key": "clu_d478da5d58182c5a", "ground_truth": {"modern_name": "static electricity", "confidence": "high", "type": "concept", "wikidata_id": "Q94986960", "wikidata_description": "phenomenon of hair standing on end due to static electricity"}}, {"canonical_name": "Sides", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "sides", "book_id": "english_physician_1652", "name": "Sides", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 10, "variants": ["Sides", "sides"], "contexts": ["body part where pain is eased", "lateral parts of the body"]}, {"entity_id": "side", "book_id": "principles_of_psychology_james_1890", "name": "side", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["side"], "contexts": ["lateral aspect of the body"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Sides", "target_book": "principles_of_psychology_james_1890", "target_name": "side", "similarity": 0.947}], "id": 2685, "stable_key": "clu_2a124fc7e88c387e", "ground_truth": {"modern_name": "Side", "confidence": "high", "type": "concept", "note": "Referred to as a 'SUBSTANCE' but anatomically it functions as a body part/concept.", "wikidata_id": "Q431310", "wikidata_description": "genus of plants"}}, {"canonical_name": "inflamma\u00e7oens", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "inflamati\u2223on", "book_id": "english_physician_1652", "name": "Inflamati\u2223on", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["Inflamati\u2223on", "In\u2223flamati\u2223ons in Wounds"], "contexts": ["swelling and redness", "condition Self-heal can repress heat of"]}, {"entity_id": "inflamma\u00e7oens", "book_id": "polyanthea_medicinal", "name": "inflamma\u00e7oens", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 8, "variants": ["inflamma\u00e7oens"], "contexts": ["inflammations", "inflammations of the throat"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Inflamati\u2223on", "target_book": "polyanthea_medicinal", "target_name": "inflamma\u00e7oens", "similarity": 0.938}], "id": 2686, "stable_key": "clu_4390b9f094c2b63f-4", "ground_truth": {"modern_name": "Inflammation", "confidence": "high", "type": "disease", "modern_term": "Inflammation", "wikidata_id": "Q14819849", "wikidata_description": "immediate defensive reaction (by vertebrate tissue) to infection or injury caused by chemical or physical agents, characterized by local vasodilation, extravasation of plasma into intercellular spaces and accumulation of white blood cells", "note": "The terms 'enflamed', 'inflama\u00e7a\u00f3', and 'inflammada' all refer to the state of being inflamed, a symptom or process of inflammation."}}, {"canonical_name": "descent", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "descent", "book_id": "origin_of_species_darwin_1859", "name": "descent", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["Descent", "descent"], "contexts": ["hereditary lineage", "lineage from ancestors"]}, {"entity_id": "descent", "book_id": "kosmos_humboldt_1845", "name": "descent", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["descent"], "contexts": ["hereditary lineage and origin"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "descent", "target_book": "kosmos_humboldt_1845", "target_name": "descent", "similarity": 1.0}], "id": 2687, "stable_key": "clu_1f1d1913dcbfa563", "ground_truth": {"modern_name": "Descent", "confidence": "high", "type": "concept"}}, {"canonical_name": "Tierra del Fuego", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "tierra_del_fuego", "book_id": "origin_of_species_darwin_1859", "name": "Tierra del Fuego", "category": "PLACE", "subcategory": "REGION", "count": 11, "variants": ["Tierra del Fuego"], "contexts": ["location of indigenous peoples with dogs", "geographic location with savages"]}, {"entity_id": "tierra_del_fuego", "book_id": "kosmos_humboldt_1845", "name": "Tierra del Fuego", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Tierra del Fuego"], "contexts": ["archipelago in southern hemisphere"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Tierra del Fuego", "target_book": "kosmos_humboldt_1845", "target_name": "Tierra del Fuego", "similarity": 0.811}], "id": 2688, "stable_key": "clu_821536fb131301a4", "ground_truth": {"modern_name": "Tierra del Fuego", "confidence": "high", "type": "place", "description": "Archipelago at the southern tip of South America.", "wikipedia_extract": "Tierra del Fuego (; Spanish: [\u02c8tjera \u00f0el \u02c8fwe\u0263o]; Spanish for 'Land of Fire') is an archipelago off the southernmost tip of the South American mainland, across the Strait of Magellan. The archipelago consists of the main island, Isla Grande de Tierra del Fuego, with an area of 73,746 km2 (28,473 sq mi), along with numerous smaller islands, including Cape Horn and Diego Ram\u00edrez Islands. The western part of the Tierra del Fuego archipelago, about two-thirds including its many islands, is part of Chile, and the eastern part is part of Argentina. The southernmost extent of the archipelago, Cape Horn, lies just north of 56\u00b0 south. The earliest-known human settlement in Tierra del Fuego dates to c.\u20098,000 BC. Europeans first explored the islands during Ferdinand Magellan's expedition of 1520."}}, {"canonical_name": "Struggle for Life", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "struggle_for_life", "book_id": "origin_of_species_darwin_1859", "name": "Struggle for Life", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["Struggle for Life", "struggle for life"], "contexts": ["competition for survival", "competition for survival and reproduction"]}, {"entity_id": "struggle_for_life", "book_id": "principles_of_psychology_james_1890", "name": "struggle for life", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["struggle for life"], "contexts": ["competition for survival"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Struggle for Life", "target_book": "principles_of_psychology_james_1890", "target_name": "struggle for life", "similarity": 0.928}], "id": 2689, "stable_key": "clu_044136f16dee6107", "ground_truth": {"modern_name": "Struggle for Existence", "confidence": "high", "type": "concept"}}, {"canonical_name": "orders", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "orders", "book_id": "origin_of_species_darwin_1859", "name": "orders", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["orders"], "contexts": ["biological classification rank", "taxonomic rank above family"]}, {"entity_id": "orders", "book_id": "first_principles_spencer_1862", "name": "orders", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["orders"], "contexts": ["botanical classification level"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "orders", "target_book": "first_principles_spencer_1862", "target_name": "orders", "similarity": 1.0}], "id": 2690, "stable_key": "clu_91a75a6a7b236b2c", "ground_truth": {"modern_name": "Taxonomic Rank", "confidence": "high", "type": "concept", "wikidata_id": "Q427626", "wikidata_description": "in biology, level in a taxonomic hierarchy"}}, {"canonical_name": "classification", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total