7fmo animal"], "contexts": ["bite of the same animal"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "mordeduras de los animales ponpo\u00fcosos", "target_book": "polyanthea_medicinal", "target_name": "mordeduras de bichos pe\u00e7oj", "similarity": 0.889}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "mordeduras de los animales ponpo\u00fcosos", "target_book": "polyanthea_medicinal", "target_name": "mordeduradome\u017fmo animal", "similarity": 0.906}], "id": 4649, "stable_key": "clu_e4b7d2ac725f39d3", "ground_truth": {"modern_name": "Bites of poisonous creatures", "confidence": "high", "type": "disease", "modern_term": "Venomous animal bites"}}, {"canonical_name": "tremor de frio", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "dolores_de_fri\u00f3", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "dolores de fri\u00f3", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["dolores de fri\u00f3"], "contexts": ["pains from cold"]}, {"entity_id": "tremor_de_frio", "book_id": "polyanthea_medicinal", "name": "tremor de frio", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["tremor de frio"], "contexts": ["symptom of fever", "symptom of shivering with cold"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "dolores de fri\u00f3", "target_book": "polyanthea_medicinal", "target_name": "tremor de frio", "similarity": 0.895}], "id": 4650, "stable_key": "clu_2e1ee4228b495452-2", "ground_truth": {"modern_name": "Cold sweats", "confidence": "high", "type": "disease", "description": "A symptom characterized by cold, clammy perspiration, often associated with illness.", "note": "This cluster includes terms referring to cold pains and cold sweats in Spanish and English.", "wikipedia_extract": "Sweating sickness, also known as the sweats, English sweating sickness, English sweat or sudor anglicus in Latin, was a mysterious and contagious disease that struck England and later continental Europe in a series of epidemics beginning in 1485. Other major outbreaks of the English sweating sickness occurred in 1508, 1517, and 1528, with the last outbreak in 1551, after which the disease apparently vanished. The onset of symptoms was sudden, and death or recovery often occurred within 8\u201310 hours. Sweating sickness epidemics were unique compared with other disease outbreaks of the time: whereas other epidemics were typically urban and long-lasting, cases of sweating sickness spiked and receded very quickly, significantly affecting rural populations. Its cause remains unknown, although it has been suggested that an unknown species of hantavirus was responsible. John Caius was a physician in Shrewsbury in 1551, when an outbreak occurred, and he described the symptoms and signs of the disease in A Boke or Counseill Against the Disease Commonly Called the Sweate, or Sweatyng Sicknesse (1552), which is the main historical source of knowledge of the disease."}}, {"canonical_name": "partes superiores", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "partes_ynferiores", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "partes ynferiores", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["partes ynferiores"], "contexts": ["lower parts of the body"]}, {"entity_id": "partes_superiores", "book_id": "polyanthea_medicinal", "name": "partes superiores", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["partes superiores", "lugares superiores"], "contexts": ["body regions", "upper places on the body"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "partes ynferiores", "target_book": "polyanthea_medicinal", "target_name": "partes superiores", "similarity": 0.894}], "id": 4651, "stable_key": "clu_c16d42e68ed805e1", "ground_truth": {"modern_name": "Body regions", "confidence": "medium", "type": "concept", "note": "This refers to general anatomical areas rather than specific organs or diseases."}}, {"canonical_name": "carneros", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "carnero", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "carnero", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["carnero"], "contexts": ["food after purging"]}, {"entity_id": "carneros", "book_id": "historia_medicinal_monardes_1574", "name": "carneros", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["Carneros", "carneros"], "contexts": ["sheep-like animals", "animal source of Bezoar stone"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "carnero", "target_book": "historia_medicinal_monardes_1574", "target_name": "carneros", "similarity": 0.923}], "id": 4652, "stable_key": "clu_5b55b2ecb71d1ac6", "ground_truth": {"modern_name": "Sheep", "confidence": "high", "type": "animal", "wikidata_id": "Q4628", "wikidata_description": "North Atlantic archipelago organized as an autonomous constituent country of the Kingdom of Denmark", "wikipedia_url": "https://en.wikipedia.org/wiki/Faroe%20Islands"}}, {"canonical_name": "inte\u017ftino", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "intestino", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "intestino", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["intestino"], "contexts": ["part of the digestive tract"]}, {"entity_id": "inte\u017ftino", "book_id": "polyanthea_medicinal", "name": "inte\u017ftino", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["inte\u017ftino"], "contexts": ["body part affected by pain", "part of the digestive system"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "intestino", "target_book": "polyanthea_medicinal", "target_name": "inte\u017ftino", "similarity": 0.97}], "id": 4653, "stable_key": "clu_c4bdae41c002bf76", "ground_truth": {"modern_name": "Intestine", "confidence": "high", "type": "concept", "note": "While 'intestine' refers to a specific anatomical organ, in early modern texts, it often functions as a conceptual unit within anatomical descriptions, particularly when discussing its function or role in disease processes. It's not the organ itself as a distinct biological entity being discussed in isolation, but rather its part in broader systems and conditions."}}, {"canonical_name": "gula", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "gula", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "gula", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["gula"], "contexts": ["throat"]}, {"entity_id": "gula", "book_id": "polyanthea_medicinal", "name": "gula", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["gula"], "contexts": ["excessive appetite or gluttony", "gullet"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "gula", "target_book": "polyanthea_medicinal", "target_name": "gula", "similarity": 1.0}], "id": 4654, "stable_key": "clu_ac467bb742d493b4", "ground_truth": {"modern_name": "throat / gluttony", "confidence": "medium", "type": "concept", "note": "The term 'gula' in early modern Portuguese and Spanish could refer to the anatomical throat or the concept of gluttony. The context of 'excessive appetite' strongly suggests the latter, but the mention of 'throat' as anatomy makes it ambiguous.", "wikidata_id": "Q1783924", "wikidata_description": "organ system cancer in the head or neck region", "wikipedia_url": "https://en.wikipedia.org/wiki/Head%20and%20neck%20cancer"}}, {"canonical_name": "Andrea Masthiolo", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "andrea_matiolo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Andrea Matiolo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Andrea Matiolo"], "contexts": ["Italian physician and botanist"]}, {"entity_id": "andrea_masthiolo", "book_id": "historia_medicinal_monardes_1574", "name": "Andrea Masthiolo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Andrea Masthiolo"], "contexts": ["recipient of an epistle", "recipient of a letter"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Andrea Matiolo", "target_book": "historia_medicinal_monardes_1574", "target_name": "Andrea Masthiolo", "similarity": 0.841}], "id": 4655, "stable_key": "clu_d2c321361718a4fb", "ground_truth": {"modern_name": "Pietro Andrea Mattioli", "confidence": "high", "type": "person", "birth_year": 1501, "death_year": 1577, "description": "Italian physician and botanist, famed for his commentaries on Dioscorides.", "wikidata_id": "Q457191", "wikidata_description": "Italian scientist (1501\u20131578)", "wikipedia_url": "https://en.wikipedia.org/wiki/Pietro%20Andrea%20Mattioli"}}, {"canonical_name": "Erelypelas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "erysipela", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "erysipela", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["erysipela"], "contexts": ["skin inflammation treated with plant"]}, {"entity_id": "erelypelas", "book_id": "historia_medicinal_monardes_1574", "name": "Erelypelas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["Erelypelas", "Ere\u017fipelas"], "contexts": ["erysipelas treated with herb gum", "erysipelas"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "erysipela", "target_book": "historia_medicinal_monardes_1574", "target_name": "Erelypelas", "similarity": 0.888}], "id": 4656, "stable_key": "clu_e0ac64038d25fd96", "ground_truth": {"modern_name": "Erysipelas", "confidence": "high", "type": "disease", "modern_term": "Erysipelas", "note": "The spelling variation is common in early modern texts and OCR.", "wikidata_id": "Q207092", "wikidata_description": "human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Erysipelas"}}, {"canonical_name": "Ciruelas palas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ciruelas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "ciruelas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["ciruelas"], "contexts": ["fruit resembling plums"]}, {"entity_id": "ciruelas_palas", "book_id": "historia_medicinal_monardes_1574", "name": "Ciruelas palas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Ciruelas palas", "Ciruelas"], "contexts": ["fruit ingredient in a decoction", "fruit recommended for cooling"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ciruelas", "target_book": "historia_medicinal_monardes_1574", "target_name": "Ciruelas palas", "similarity": 0.925}], "id": 4657, "stable_key": "clu_7b16b9c8c3b58f04", "ground_truth": {"modern_name": "Plums", "confidence": "medium", "type": "plant", "linnaean": "Prunus domestica", "family": "Rosaceae", "note": "'Ciruelas palas' likely refers to plums, but the descriptor 'palas' is unclear and could indicate a specific variety or a mistranscription. 'Ciruelas' itself translates to plums.", "wikidata_id": "Q44120", "wikidata_description": "species of plant in the rose family (Rosaceae)", "wikipedia_url": "https://en.wikipedia.org/wiki/Prunus%20domestica"}}, {"canonical_name": "brachium", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "bra^o", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "bra^o", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bra^o"], "contexts": ["body part for application"]}, {"entity_id": "brachium", "book_id": "polyanthea_medicinal", "name": "brachium", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["brachium", "brachia"], "contexts": ["part of the body", "arms that can swell in dropsy"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "bra^o", "target_book": "polyanthea_medicinal", "target_name": "brachium", "similarity": 0.917}], "id": 4658, "stable_key": "clu_d9ed3f871e51a940", "ground_truth": {"modern_name": "Arm", "confidence": "high", "type": "concept", "note": "'Bra\u00e7o' (Portuguese) and 'brachium' (Latin) both refer to the arm.", "wikidata_id": "Q399", "wikidata_description": "sovereign state in the South Caucasus region of Eurasia", "wikipedia_url": "https://en.wikipedia.org/wiki/Armenia"}}, {"canonical_name": "R ejalgar", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "rejalgar", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "rejalgar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["rejalgar"], "contexts": ["caustic substance for cauterizing"]}, {"entity_id": "r_ejalgar", "book_id": "historia_medicinal_monardes_1574", "name": "R ejalgar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["R ejalgar", "rejalgar"], "contexts": ["mineral substance compared to Ceuadilla's effect", "poisonous substance taken with stone"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "rejalgar", "target_book": "historia_medicinal_monardes_1574", "target_name": "R ejalgar", "similarity": 0.85}], "id": 4659, "stable_key": "clu_4c5bc562cde3e6ec", "ground_truth": {"modern_name": "Orpiment", "confidence": "medium", "type": "mineral", "note": "'Rejalgar' typically refers to Realgar (arsenic disulfide), which is red. However, the context of a 'caustic substance for cauterizing' and comparison to 'Ceuadilla's effect' could also point to Orpiment (arsenic trisulfide), which is yellow and also caustic. Both are arsenic sulfides. Realgar is more commonly associated with cauterization, but Orpiment's visual and chemical properties might be conflated.", "wikidata_id": "Q419183", "wikidata_description": "sulfide mineral", "wikipedia_url": "https://en.wikipedia.org/wiki/Orpiment"}}, {"canonical_name": "Hauana", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "hauana", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Hauana", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Hauana"], "contexts": ["city in Cuba"]}, {"entity_id": "hauana", "book_id": "historia_medicinal_monardes_1574", "name": "Hauana", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Hauana"], "contexts": ["city where a doctor is located", "location where illness occurred"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Hauana", "target_book": "historia_medicinal_monardes_1574", "target_name": "Hauana", "similarity": 1.0}], "id": 4660, "stable_key": "clu_a79d6be195a7cae8", "ground_truth": {"modern_name": "Havana", "confidence": "high", "type": "place", "country": "Cuba"}}, {"canonical_name": "Tibur\u00f3n", "category": "ANIMAL", "subcategory": "FISH", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tibur\u00f3n", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Tibur\u00f3n", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["Tibur\u00f3n"], "contexts": ["type of shark"]}, {"entity_id": "tiburon", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "tiburon", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["tiburon"], "contexts": ["type of fish, shark"]}, {"entity_id": "tiburon", "book_id": "historia_medicinal_monardes_1574", "name": "Tiburon", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["Tiburon"], "contexts": ["large, strong, and warlike fish in the Indies"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Tibur\u00f3n", "target_book": "historia_medicinal_monardes_1574", "target_name": "Tiburon", "similarity": 0.92}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "tiburon", "target_book": "historia_medicinal_monardes_1574", "target_name": "Tiburon", "similarity": 0.99}], "id": 4661, "stable_key": "clu_b91dbcaddfc56818-2", "ground_truth": {"wikipedia_extract": "\"Tiburones\" (transl.\u2009\"Sharks\") is a song recorded by Puerto Rican singer Ricky Martin for his first extended play, Pausa (2020). The song was written by Oscar Hernandez and Pablo Preciado, while the production was handled by Julio Reyes Copello. The song was released for digital download and streaming by Sony Music Latin on January 23, 2020, as the second single from the extended play. A Spanish language ballad and Latin pop song, it is about the importance of peace, love and unity. It received positive reviews from music critics, who complimented its lyrics. \"Tiburones\" was nominated for Song of the Year at the 21st Annual Latin Grammy Awards. The song was commercially successful in Latin America, reaching number one in Argentina and Puerto Rico, as well as the top 10 in eight other Latin American countries."}}, {"canonical_name": "Pav\u00f5es", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pav\u00f3n", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Pav\u00f3n", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Pav\u00f3n"], "contexts": ["name for manati in the Philippines"]}, {"entity_id": "pav\u00f5es", "book_id": "coloquios_da_orta_1563", "name": "Pav\u00f5es", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["pav\u00f5es", "Pav\u00f5es"], "contexts": ["birds found in abundance", "birds found in the island's thickets"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Pav\u00f3n", "target_book": "coloquios_da_orta_1563", "target_name": "Pav\u00f5es", "similarity": 0.922}], "id": 4662, "stable_key": "clu_2103ca687c412e45", "ground_truth": {"modern_name": "Peacock/Manatee", "confidence": "low", "type": "animal", "note": "The term 'Pav\u00e3o' (Portuguese) usually means peacock. However, in the context of the Philippines ('manati in the Philippines'), it is used for manatee. The dual mention suggests either a confusion of terms or that both creatures were present and discussed. Given the distinct contexts, it refers to two different entities.", "wikidata_id": "Q201251", "wikidata_description": "group of birds formed by the Indian peafowl, the green peafowl and the Congo peafowl"}}, {"canonical_name": "Maluco", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "maluco", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "maluco", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["maluco"], "contexts": ["region associated with birds"]}, {"entity_id": "maluco", "book_id": "historia_medicinal_monardes_1574", "name": "Maluco", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Maluco", "Malucos"], "contexts": ["place where aromatic spices are brought from", "region mentioned for spices"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "maluco", "target_book": "historia_medicinal_monardes_1574", "target_name": "Maluco", "similarity": 0.735}], "id": 4663, "stable_key": "clu_136cc0d926ba01e5", "ground_truth": {"modern_name": "Moluccas", "confidence": "high", "type": "place", "country": "Indonesia", "wikidata_id": "Q14643845", "wikidata_description": "genus of insects"}}, {"canonical_name": "escribanos", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "escribanos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "escribanos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["escribanos"], "contexts": ["scribes who provided testimonies"]}, {"entity_id": "escribanos", "book_id": "relation_historique_humboldt_vol3_1825", "name": "escribanos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["escribanos", "Escribanos"], "contexts": ["scribes or clerks", "scribes in Cuba"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "escribanos", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "escribanos", "similarity": 1.0}], "id": 4664, "stable_key": "clu_982934a58db36720", "ground_truth": {"modern_name": "scribes", "confidence": "high", "type": "person", "description": "Clerical staff responsible for recording testimonies and documents.", "wikidata_id": "Q916292", "wikidata_description": "person who wrote or copied manuscripts", "wikipedia_url": "https://en.wikipedia.org/wiki/Scribe"}}, {"canonical_name": "Marfil", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "marfil", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "marfil", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["marfil"], "contexts": ["ivory-like substance"]}, {"entity_id": "marfil", "book_id": "historia_medicinal_monardes_1574", "