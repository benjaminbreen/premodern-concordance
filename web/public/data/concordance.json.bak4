_monardes_1574", "name": "corazon", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["corazon", "coraz\u00f3n"], "contexts": ["organ of the body", "heart"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "corazon", "target_book": "historia_medicinal_monardes_1574", "target_name": "corazon", "similarity": 1.0}], "id": 2952, "stable_key": "clu_3f39cde64d3b82c4", "ground_truth": {"modern_name": "Heart", "confidence": "high", "type": "concept", "note": "The context 'organ of the body' clearly points to the heart. The context 'part of a tree that produces seed' is likely metaphorical or refers to a plant part named after the heart, but the primary identification remains the organ.", "wikidata_id": "Q1072", "wikidata_description": "inner organ for the circulation of blood", "wikipedia_url": "https://en.wikipedia.org/wiki/Heart"}}, {"canonical_name": "Esquinanto", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "esquinanto", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "esquinanto", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["esquinanto"], "contexts": ["plant species", "plant name, possibly elecampane"]}, {"entity_id": "esquinanto", "book_id": "coloquios_da_orta_1563", "name": "Esquinanto", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["esquinanto", "Esquinanto"], "contexts": ["a root from Arabia", "medicine"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "esquinanto", "target_book": "coloquios_da_orta_1563", "target_name": "Esquinanto", "similarity": 0.971}], "id": 2953, "stable_key": "clu_a32dfe7bfbc0e3e3", "ground_truth": {"modern_name": "Swallowwort", "confidence": "medium", "type": "plant", "linnaean": "Vincetoxicum hirundinaria", "family": "Apocynaceae", "note": "The identification of 'Esquinanto' can be challenging. While often linked to swallowwort (Vincetoxicum spp.), historical usage and regional variations mean other plants might also be referred to by similar names. The mention of 'root from Arabia' is a useful clue but not definitive on its own.", "wikidata_id": "Q156807", "wikidata_description": "species of plant in the poppy family", "wikipedia_url": "https://en.wikipedia.org/wiki/Chelidonium%20majus"}}, {"canonical_name": "seco", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "secos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "secos", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["secos"], "contexts": ["quality of medicines and herbs", "quality of growing places"]}, {"entity_id": "seco", "book_id": "coloquios_da_orta_1563", "name": "seco", "category": "CONCEPT", "subcategory": "QUALITY", "count": 7, "variants": ["seco", "seca", "secco"], "contexts": ["quality of substances", "implied quality of substances"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "secos", "target_book": "coloquios_da_orta_1563", "target_name": "seco", "similarity": 0.927}], "id": 2954, "stable_key": "clu_037e64c65cfde6bc", "ground_truth": {"modern_name": "Dryness", "confidence": "high", "type": "concept", "wikidata_id": "Q5309747", "wikidata_description": "medical condition in which there is a decrease in normal lubrication of the skin or mucous membranes", "wikipedia_url": "https://en.wikipedia.org/wiki/Dryness%20%28medical%29"}}, {"canonical_name": "bago", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "bago", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "bago", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bago"], "contexts": ["spleen, affected by opilations"]}, {"entity_id": "bago", "book_id": "historia_medicinal_monardes_1574", "name": "bago", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 8, "variants": ["bago", "Bago"], "contexts": ["spleen", "spleen, organ of the body"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "bago", "target_book": "historia_medicinal_monardes_1574", "target_name": "bago", "similarity": 1.0}], "id": 2955, "stable_key": "clu_b1c6492235dd536d", "ground_truth": {"modern_name": "Spleen", "confidence": "high", "type": "concept", "note": "The context 'spleen, affected by opilations' and 'spleen' directly identifies the organ. 'Opilations' refers to blockages or obstructions, often associated with the spleen in humoral pathology.", "wikidata_id": "Q5347305", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Asplenium"}}, {"canonical_name": "gargaparrilla", "category": "PLANT", "subcategory": "ROOT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "sanyaparrilla", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "sanyaparrilla", "category": "PLANT", "subcategory": "ROOT", "count": 1, "variants": ["sanyaparrilla"], "contexts": ["root used in medicine"]}, {"entity_id": "gargaparrilla", "book_id": "historia_medicinal_monardes_1574", "name": "gargaparrilla", "category": "PLANT", "subcategory": "ROOT", "count": 8, "variants": ["gargaparrilla", "garcaparrilla", "garsaparillas"], "contexts": ["plant used in a medicinal preparation", "plant used in medicinal preparations"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "sanyaparrilla", "target_book": "historia_medicinal_monardes_1574", "target_name": "gargaparrilla", "similarity": 0.884}], "id": 2956, "stable_key": "clu_3d07859127ae5ee8", "ground_truth": {"modern_name": "Sarsaparilla", "confidence": "high", "type": "plant", "linnaean": "Smilax ornata", "family": "Smilacaceae", "note": "The terms 'gargaparrilla' and 'sanyaparrilla' are likely variations or misspellings of 'sarsaparilla', a well-known medicinal root from the Americas.", "wikidata_id": "Q1117102", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Smilax%20regelii"}}, {"canonical_name": "cebolas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "cebolla", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "cebolla", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cebolla"], "contexts": ["onion"]}, {"entity_id": "cebolas", "book_id": "coloquios_da_orta_1563", "name": "cebolas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["cebolas", "cebola", "cebolla", "cebollas"], "contexts": ["ingredient for flavoring food", "vegetable, onions"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cebolla", "target_book": "coloquios_da_orta_1563", "target_name": "cebolas", "similarity": 0.915}], "id": 2957, "stable_key": "clu_4258944386d586dd-2", "ground_truth": {"modern_name": "onion", "confidence": "high", "type": "plant", "linnaean": "Allium cepa", "family": "Amaryllidaceae", "description": "A pungent, edible bulb vegetable.", "wikipedia_extract": "The onion (Allium cepa L.Tooltip Carl Linnaeus, from Latin cepa), also known as the bulb onion or common onion, is a vegetable that is the most widely cultivated species of the genus Allium. The shallot is a botanical variety of the onion which was classified as a separate species until 2011. The onion's close relatives include garlic, scallion, leek, and chives. The genus contains several other species variously called onions and cultivated for food, such as the Japanese bunching onion Allium fistulosum, the tree onion Allium \u00d7 proliferum, and the Canada onion Allium canadense. The name wild onion is applied to a number of Allium species, but A. cepa is exclusively known from cultivation. Its ancestral wild original form is not known, although escapes from cultivation have become established in some regions."}}, {"canonical_name": "poluo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "poluo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "poluo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["poluo"], "contexts": ["powder form of the plant"]}, {"entity_id": "poluo", "book_id": "historia_medicinal_monardes_1574", "name": "poluo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 8, "variants": ["poluo", "poluora"], "contexts": ["powder", "powder made from a fruit pit"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "poluo", "target_book": "historia_medicinal_monardes_1574", "target_name": "poluo", "similarity": 1.0}], "id": 2958, "stable_key": "clu_37638aebeca7ec70", "ground_truth": {"modern_name": "Powder", "confidence": "high", "type": "concept", "note": "The context 'powder form of the plant' and 'powder' directly indicate a pulverized substance.", "wikidata_id": "Q37203534", "wikidata_description": "family name"}}, {"canonical_name": "Doctor Monardes", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "doctor_monardez", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Doctor Monardez", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Doctor Monardez"], "contexts": ["scholar who wrote about stones"]}, {"entity_id": "doctor_monardes", "book_id": "historia_medicinal_monardes_1574", "name": "Doctor Monardes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 8, "variants": ["Doctor Monardes", "Doctor BMonardes"], "contexts": ["physician from Seville", "author of the text on Tabaco"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Doctor Monardez