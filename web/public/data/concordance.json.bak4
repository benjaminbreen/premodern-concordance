", "target_name": "alcoholic intoxication", "similarity": 0.887}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "embriaguez", "target_book": "polyanthea_medicinal", "target_name": "ebrietate", "similarity": 0.91}, {"source_book": "principles_of_psychology_james_1890", "source_name": "alcoholic intoxication", "target_book": "polyanthea_medicinal", "target_name": "ebrietate", "similarity": 0.916}], "id": 750, "stable_key": "clu_37ebe83cfa02e68e", "ground_truth": {"modern_name": "Alcohol intoxication", "confidence": "high", "type": "disease", "modern_term": "Alcohol intoxication", "wikidata_id": "Q85990312", "wikidata_description": "practice"}}, {"canonical_name": "atolls", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "atolls", "book_id": "origin_of_species_darwin_1859", "name": "atolls", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["atolls"], "contexts": ["rings of coral marking sunken islands", "ring-shaped coral islands"]}, {"entity_id": "\u00eeles", "book_id": "relation_historique_humboldt_vol3_1825", "name": "\u00eeles", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["\u00eeles"], "contexts": ["location of emigration", "location of Caribe people"]}, {"entity_id": "islands", "book_id": "kosmos_humboldt_1845", "name": "islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["islands"], "contexts": ["land masses surrounded by water"]}, {"entity_id": "islands", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Islands"], "contexts": ["character of their floras"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "atolls", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "\u00eeles", "similarity": 0.946}, {"source_book": "origin_of_sp