on_physical_sciences_somerville_1858", "target_name": "Newton", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Newton", "target_book": "first_principles_spencer_1862", "target_name": "Newton", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Newton", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Newton", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Newton", "target_book": "first_principles_spencer_1862", "target_name": "Newton", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Newton", "target_book": "first_principles_spencer_1862", "target_name": "Newton", "similarity": 1.0}], "id": 104, "stable_key": "clu_c35d0b4007f016f8", "ground_truth": {"modern_name": "Isaac Newton", "confidence": "high", "type": "person", "birth_year": 1643, "death_year": 1727, "description": "English mathematician, physicist, astronomer, and alchemist, laws of motion.", "wikidata_id": "Q935", "wikidata_description": "English mathematician and physicist (1642\u20131727)", "wikipedia_url": "https://en.wikipedia.org/wiki/Isaac%20Newton", "wikipedia_extract": "Sir Isaac Newton ( ; 4 January [O.S. 25 December] 1643 \u2013 31 March [O.S. 20 March] 1727) was an English polymath who was a mathematician, physicist, astronomer, alchemist, theologian, author and inventor. He was a key figure in the Scientific Revolution and the Enlightenment that followed. His book Philosophi\u00e6 Naturalis Principia Mathematica (Mathematical Principles of Natural Philosophy), first published in 1687, achieved the first great unification in physics and established classical mechanics. Newton also made seminal contributions to optics, and shares credit with the German mathematician Gottfried Wilhelm Leibniz for formulating infinitesimal calculus, although he developed calculus years before Leibniz."}}, {"canonical_name": "Australia", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 5, "total_mentions": 46, "members": [{"entity_id": "australia", "book_id": "origin_of_species_darwin_1859", "name": "Australia", "category": "PLACE", "subcategory": "COUNTRY", "count": 33, "variants": ["Australia"], "contexts": ["location of indigenous peoples with dogs", "geographic location with savages"]}, {"entity_id": "australia", "book_id": "kosmos_humboldt_1845", "name": "Australia", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Australia"], "contexts": ["continent where Sound is located", "continent with similar species"]}, {"entity_id": "austr\u00e1lia", "book_id": "coloquios_da_orta_1563", "name": "Austr\u00e1lia", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Austr\u00e1lia"], "contexts": ["mentioned in relation to an abyss", "continent and country"]}, {"entity_id": "australia", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Australia", "category": "PLACE", "subcategory": "COUNTRY", "count": 6, "variants": ["Australia"], "contexts": ["continent with a desert influencing winds", "continent with plant species"]}, {"entity_id": "australia", "book_id": "first_principles_spencer_1862", "name": "Australia", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Australia"], "contexts": ["continent and country", "continent and country with indigenous tribes"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Australia", "target_book": "kosmos_humboldt_1845", "target_name": "Australia", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Australia", "target_book": "coloquios_da_orta_1563", "target_name": "Austr\u00e1lia", "similarity": 0.945}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Australia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Australia", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Australia", "target_book": "first_principles_spencer_1862", "target_name": "Australia", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Australia", "target_book": "coloquios_da_orta_1563", "target_name": "Austr\u00e1lia", "similarity": 0.945}, {"source_book": "kosmos_humboldt_1845", "source_name": "Australia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Australia", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Australia", "target_book": "first_principles_spencer_1862", "target_name": "Australia", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Austr\u00e1lia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Australia", "similarity": 0.945}, {"source_book": "coloquios_da_orta_1563", "source_name": "Austr\u00e1lia", "target_book": "first_principles_spencer_1862", "target_name": "Australia", "similarity": 0.945}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Australia", "target_book": "first_principles_spencer_1862", "target_name": "Australia", "similarity": 1.0}], "id": 105, "stable_key": "clu_a55e5c4431554e67", "ground_truth": {"modern_name": "Australia", "confidence": "high", "type": "place", "country": "Australia", "note": " 'New Holland' was the historical name given to the western part of Australia. The context of distinct species and shores confirms this identification.", "wikidata_id": "Q408", "wikidata_description": "country in Oceania", "wikipedia_url": "https://en.wikipedia.org/wiki/Australia", "wikipedia_extract": "Australia, officially the Commonwealth of Australia, is a country comprising the mainland of the Australian continent, the island of Tasmania and numerous smaller islands. It has a total area of 7,688,287 km2 (2,968,464 sq mi), making it the sixth-largest country in the world and the largest in Oceania. Australia is the world's flattest and driest inhabited continent. It is a megadiverse country, and its size gives it a wide variety of landscapes and climates including deserts in the interior and tropical rainforests along the coast. The ancestors of Aboriginal Australians began arriving from Southeast Asia 50,000 to 65,000 years ago, during the Last Glacial Period. By the time of British settlement, Aboriginal Australians spoke more than 250 distinct languages and had one of the oldest living cultures in the world.", "description": "Continent and country in the Southern Hemisphere, known for unique wildlife."}}, {"canonical_name": "hand", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 46, "members": [{"entity_id": "hand", "book_id": "origin_of_species_darwin_1859", "name": "hand", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["hand"], "contexts": ["part of human skeletal framework"]}, {"entity_id": "hand", "book_id": "principles_of_psychology_james_1890", "name": "hand", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 39, "variants": ["hand"], "contexts": ["part of the arm used for grasping", "body part that can be insensible and motionless"]}, {"entity_id": "hand", "book_id": "kosmos_humboldt_1845", "name": "hand", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["hand"], "contexts": ["wrested by the hand of man"]}, {"entity_id": "hand", "book_id": "connexion_physical_sciences_somerville_1858", "name": "hand", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["hand"], "contexts": ["part of the body touched by wire", "part of the human body"]}, {"entity_id": "hand", "book_id": "first_principles_spencer_1862", "name": "hand", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["hand"], "contexts": ["part of the body used for action", "body part name in Pawnee language"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "hand", "target_book": "principles_of_psychology_james_1890", "target_name": "hand", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hand", "target_book": "kosmos_humboldt_1845", "target_name": "hand", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hand", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "hand", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hand", "target_book": "first_principles_spencer_1862", "target_name": "hand", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hand", "target_book": "kosmos_humboldt_1845", "target_name": "hand", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hand", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "hand", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hand", "target_book": "first_principles_spencer_1862", "target_name": "hand", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "hand", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "hand", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "hand", "target_book": "first_principles_spencer_1862", "target_name": "hand", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "hand", "target_book": "first_principles_spencer_1862", "target_name": "hand", "similarity": 1.0}], "id": 106, "stable_key": "clu_23ff13c140e5c3b7", "ground_truth": {"modern_name": "Hand", "confidence": "high", "type": "object", "wikidata_id": "Q8418", "wikidata_description": "team sport played with a thrown ball and goals", "wikipedia_url": "https://en.wikipedia.org/wiki/Handball", "note": "Referred to as a 'SUBSTANCE' but anatomically it functions as a body part/concept.", "wikipedia_extract": "Handball (also known as team handball, European handball, Olympic handball, or indoor handball) is a team sport in which two teams of seven players each (six outcourt players and a goalkeeper) pass a ball using their hands with the aim of throwing it into the goal of the opposing team. A standard match consists of two periods of 30 minutes, and the team that scores more goals wins. Modern handball is played on a court of 40 by 20 metres (131 by 66 ft), with a goal in the middle of each end. The goals are surrounded by a 6-metre (20 ft) zone where only the defending goalkeeper is allowed; goals must be scored by throwing the ball from outside the zone or while \"diving\" into it. The sport is usually played indoors, but outdoor variants exist in the forms of field handball, Czech handball (which were more common in the past) and beach handball. The game is fast and high-scoring: professional teams now typically score between 20 and 35 goals each, though lower scores were not uncommon until a few decades ago."}}, {"canonical_name": "Greci", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 5, "total_mentions": 45, "members": [{"entity_id": "greeks", "book_id": "english_physician_1652", "name": "Greeks", "category": "PERSON", "subcategory": "AUTHORITY", "count": 7, "variants": ["Greeks"], "contexts": ["did not mention Balm", "people who named Cachexia"]}, {"entity_id": "griegos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "griegos", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["griegos", "Griegos"], "contexts": ["ancient Greek sources", "ancient people with different customs"]}, {"entity_id": "greci", "book_id": "ricettario_fiorentino_1597", "name": "Greci", "category": "PERSON", "subcategory": "AUTHORITY", "count": 27, "variants": ["Greci", "Grcci"], "contexts": ["ancient Greek inventors and scholars", "ancient Greek term for amphibians"]}, {"entity_id": "greeks", "book_id": "connexi