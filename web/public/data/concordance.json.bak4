 "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "caspian_sea", "book_id": "kosmos_humboldt_1845", "name": "Caspian Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["Caspian Sea"], "contexts": ["sea east of Baku", "sea"]}, {"entity_id": "caspian_sea", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Caspian Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Caspian Sea"], "contexts": ["largest inland body of water"]}, {"entity_id": "caspian_seas", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Caspian Seas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Caspian Seas"], "contexts": ["sea bordering Oriental region"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Caspian Sea", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Caspian Sea", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Caspian Sea", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Caspian Seas", "similarity": 0.993}], "id": 2800, "stable_key": "clu_10cbeee9df5e8ac6-2", "ground_truth": {"modern_name": "Caspian Sea", "confidence": "high", "type": "place", "country": "International", "wikidata_id": "Q742727", "wikidata_description": "species of mammal"}}, {"canonical_name": "earthquake", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "earthquake", "book_id": "kosmos_humboldt_1845", "name": "earthquake", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 8, "variants": ["earthquake"], "contexts": ["geological event causing strata modification", "geological phenomenon causing shaking"]}, {"entity_id": "earthquake", "book_id": "connexion_physical_sciences_somerville_1858", "name": "earthquake", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["earthquake"], "contexts": ["natural disaster causing destruction", "causing land elevation in Chile"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "earthquake", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "earthquake", "similarity": 1.0}], "id": 2801, "stable_key": "clu_751d25fc7c798428", "ground_truth": {"modern_name": "Earthquake", "confidence": "high", "type": "concept", "note": "While earthquakes are geological events, they were sometimes discussed in early modern texts in relation to their perceived physical or even 'unnatural' causes, sometimes grouped loosely with phenomena that could affect health or the environment, hence the 'disease' categorization in the prompt's format.", "wikidata_id": "Q7944", "wikidata_description": "result of a sudden release of energy in the Earth's crust that creates seismic waves", "wikipedia_url": "https://en.wikipedia.org/wiki/Earthquake", "modern_term": "Earthquake", "wikipedia_extract": "An earthquake, also called a quake, tremor, or temblor, is the shaking of the Earth's surface resulting from a sudden release of energy in the lithosphere that creates seismic waves. Earthquakes can range in intensity, from those so weak they cannot be felt, to those violent enough to propel objects and people into the air, damage critical infrastructure, and wreak destruction across entire cities. The seismic activity of an area is the frequency, type, and size of earthquakes experienced over a particular time. The seismicity at a particular location in the Earth is the average rate of seismic energy release per unit volume. In its most general sense, the word earthquake is used to describe any seismic event that generates seismic waves. Earthquakes can occur naturally or be induced by human activities, such as mining, fracking, and nuclear weapons testing."}}, {"canonical_name": "M\u00e4dler", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "m\u00e4dler", "book_id": "kosmos_humboldt_1845", "name": "M\u00e4dler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["M\u00e4dler"], "contexts": ["author of 'Astron.'", "made planetary measurements"]}, {"entity_id": "madler", "book_id": "kosmos_humboldt_1845", "name": "Madler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Madler"], "contexts": ["author of 'Ast.'", "astronomer, co-author"]}, {"entity_id": "madler", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Madler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Madler"], "contexts": ["computed orbits of binary systems"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "M\u00e4dler", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Madler", "similarity": 0.81}, {"source_book": "kosmos_humboldt_1845", "source_name": "Madler", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Madler", "similarity": 1.0}], "id": 2802, "stable_key": "clu_72c08d576eb7d267", "ground_truth": {"modern_name": "Johann Heinrich M\u00e4dler", "confidence": "high", "type": "person", "birth_year": 1794, "death_year": 1874, "description": "German astronomer who calculated orbits of binary stars.", "wikidata_id": "Q61267", "wikidata_description": "German astronomer (1794\u20131874)"}}, {"canonical_name": "Struve", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "struve", "book_id": "kosmos_humboldt_1845", "name": "Struve", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Struve"], "contexts": ["astronomer, published in Recueil des Mem.", "astronomer who discovered double stars"]}, {"entity_id": "struve", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Struve", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Struve"], "contexts": ["supervised Russian arc measurement", "discovered ring eccentricity"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Struve", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Struve", "similarity": 1.0}], "id": 2803, "stable_key": "clu_ffd964461c031112", "ground_truth": {"modern_name": "Friedrich Georg Wilhelm von Struve", "confidence": "high", "type": "person", "birth_year": 1793, "death_year": 1864, "description": "German-Russian astronomer, measured arc of meridian.", "wikidata_id": "Q57164", "wikidata_description": "Baltic German astronomer (1793\u20131864)"}}, {"canonical_name": "Trade winds", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "trade_winds", "book_id": "kosmos_humboldt_1845", "name": "trade winds", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["trade winds"], "contexts": ["prevailing winds in tropical regions", "contribute to sea movement"]}, {"entity_id": "trade_winds", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Trade winds", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Trade winds", "trade winds"], "contexts": ["prevailing winds in tropical regions", "prevailing winds near the equator"]}, {"entity_id": "trade-winds", "book_id": "connexion_physical_sciences_somerville_1858", "name": "trade-winds", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["trade-winds", "Trade-Winds"], "contexts": ["prevailing winds in tropics", "winds blowing towards the equator"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "trade winds", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Trade winds", "similarity": 0.992}, {"source_book": "kosmos_humboldt_1845", "source_name": "trade winds", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "trade-winds", "similarity": 0.963}], "id": 2804, "stable_key": "clu_718677d90e528bef", "ground_truth": {"modern_name": "Trade winds", "confidence": "high", "type": "concept", "wikidata_id": "Q160603", "wikidata_description": "permanent east-to-west prevailing winds that flow in the Earth's equatorial region"}}, {"canonical_name": "physicists", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "physicists", "book_id": "kosmos_humboldt_1845", "name": "physicists", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["physicists"], "contexts": ["scientific professionals", "scientists interested in light phenomena"]}, {"entity_id": "physicists", "book_id": "first_principles_spencer_1862", "name": "physicists", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 8, "variants": ["physicists"], "contexts": ["scientists studying physical phenomena", "scholars studying physical forces"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "physicists", "target_book": "first_principles_spencer_1862", "target_name": "physicists", "similarity": 0.919}], "id": 2805, "stable_key": "clu_568d02ecb976fd7f-2", "ground_truth": {"modern_name": "physicist", "confidence": "high", "type": "person", "description": "A scientist who studies the fundamental constituents and behavior of matter and energy.", "note": "The term 'physiciens' and 'physicists' in the context of Humboldt's work, especially in 'Kosmos', clearly refers to natural philosophers and early scientists who studied physical phenomena, which aligns with the modern concept of a physicist.", "wikidata_id": "Q169470", "wikidata_description": "scientist who does research in physics", "wikipedia_url": "https://en.wikipedia.org/wiki/Physicist", "wikipedia_extract": "A physicist is a scientist who specializes in the field of physics, which encompasses the interactions of matter and energy at all length and time scales in the physical universe. Physicists generally are interested in the root or ultimate causes of phenomena, and usually frame their understanding in mathematical terms. They work across a wide range of research fields, spanning all length scales: from sub-atomic and particle physics, through biological physics, to cosmological length scales encompassing the universe as a whole. The field generally includes two types of physicists: experimental physicists who specialize in the observation of natural phenomena and the development and analysis of experiments, and theoretical physicists who specialize in mathematical modeling of physical systems to rationalize, explain and predict natural phenomena. Physicists can apply their knowledge towards solving practical problems or to developing new technologies (also known as applied physics or engineering physics). The study and practice of physics is based on an intellectual ladder of discoveries and insights from ancient times to the present."}}, {"canonical_name": "\u00c1sia menor", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "asia_minor", "book_id": "kosmos_humboldt_1845", "name": "Asia Minor", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Asia Minor"], "contexts": ["region in modern Turkey", "region with cities destroyed by earthquake"]}, {"entity_id": "\u00e1sia_menor", "book_id": "coloquios_da_orta_1563", "name": "\u00c1sia menor", "category": "PLACE", "subcategory": "REGION", "count": 8, "variants": ["\u00c1sia menor", "Asia-menor", "\u00c1sia Menor"], "contexts": ["habitat of tree", "foreigners in India"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Asia Minor", "target_book": "coloquios_da_orta_1563", "target_name": "\u00c1sia menor", "similarity": 0.945}], "id": 2806, "stable_key": "clu_6a492d9d2ca84789", "ground_truth": {"modern_name": "Anatolia", "confidence": "high", "type": "place", "country": "Turkey", "wikipedia_extract": "Turkey, officially the Republic of T\u00fcrkiye, is a country mainly located in Anatolia in West Asia, with a relatively small part called East Thrace in Southeast Europe. It borders the Black Sea to the north; Georgia, Armenia, Azerbaijan, and Iran to the east; Iraq, Syria, and the Mediterranean Sea to the south; and the Aegean Sea, Greece, and Bulgaria to the west. Turkey is home to over 86 million people; most are ethnic Turks, while Kurds are the largest ethnic minority. Officially a secular state, Turkey has a Muslim-majority population. Ankara is Turkey's capital and second-largest city. Istanbul is its largest city and economic center.", "wikipedia_url": "https://en.wikipedia.org/wiki/Turkey"}}, {"canonical_name": "Greenwich", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "greenwich", "book_id": "kosmos_humboldt_1845", "name": "Greenwich", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Greenwich"], "contexts": ["location of Observatory"]}, {"entity_id": "greenwich", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Greenwich", "category": "PLACE", "subcategory": "CITY", "count": 10, "variants": ["Greenwich"], "contexts": ["meridian for time computation", "meridian for astronomical computations"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Greenwich", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Greenwich", "similarity": 0.882}], "id": 2807, "stable_key": "clu_01aaad1d55c85cf1", "ground_truth": {"modern_name": "Greenwich", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q693450", "wikidata_description": "royal borough in the London Region in England", "wikipedia_url": "https://en.wikipedia.org/wiki/Royal_Borough_of_Greenwich", "wikipedia_extract": "The Royal Borough of Greenwich ( , ,  or ) is a London borough in southeast Greater London, England. The London Borough of Greenwich was formed in 1965 by the London Government Act 1963. The new borough covered the former area of the Metropolitan Borough of Greenwich and most of the Metropolitan Borough of Woolwich to the east. The local council is Greenwich London Borough Council which meets in Woolwich Town Hall. The Royal Borough of Greenwich is a large borough covering almost 50 km\u00b2 and containing a broad mix of historic, suburban, and rapidly redeveloping districts. It includes the Greenwich Town and Park, the site of the UNESCO World Heritage Site of Maritime Greenwich which encompasses the Prime Meridian, the Royal Observatory, Cutty Sark, and the former Royal Naval College."}}, {"canonical_name": "mordedura", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "mordeduras", "book_id": "historia_medicinal_monardes_1574", "name": "mordeduras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["mordeduras", "mordeduras de animales venenosos", "mordeduras de serpientes", "mordeduras veneno\u017fas"], "contexts": ["bites from venomous animals", "poisonous bites"]}, {"entity_id": "mordedura", "book_id": "polyanthea_medicinal", "name": "mordedura", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 7, "variants": ["mordedura"], "contexts": ["bite, the condition being treated", "injury from biting"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "mordeduras", "target_book": "polyanthea_medicinal", "target_name": "mordedura", "similarity": 0.915}], "id": 2808, "stable_key": "clu_e8d8fcc657450a34", "ground_truth": {"modern_name": "Venomous bite", "confidence": "high", "type": "disease", "modern_term": "Venomous bite", "note": "The context of Monardes, who described New World fauna and their medicinal uses, and the general understanding of 'mordedura' in medical texts of the era, points to bites from venomous animals as the primary referent.", "wikidata_id": "Q39579114", "wikidata_description": "scientific article published on April 24, 2012"}}, {"canonical_name": "Suores", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "sudores", "book_id": "historia_medicinal_monardes_1574", "name": "sudores", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["sudores"], "contexts": ["sweating as a healing practice"]}, {"entity_id": "suores", "book_id": "polyanthea_medicinal", "name": "Suores", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 10, "variants": ["Suores", "suores", "s\u00faores"], "contexts": ["sweating", "sweating, a medical practice"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "sudores", "target_book": "polyanthea_medicinal", "target_name": "Suores", "similarity": 0.942}], "id": 2809, "stable_key": "clu_145f2d1b3be2ccd0", "ground_truth": {"modern_name": "Therapeutic sweating", "confidence": "high", "type": "concept", "note": "The context of medicinal texts and practices strongly indicates that 'Suores' or 'sudores' refers to sweating as a deliberate therapeutic intervention, often induced to treat various ailments."}}, {"canonical_name": "espadana", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "espadana", "book_id": "coloquios_da_orta_1563", "name": "espadana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["espadana"], "contexts": ["plant, possibly iris", "plant with similar leaves to the fruit's leaves"]}, {"entity_id": "espadana", "book_id": "polyanthea_medicinal", "name": "espadana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["espadana", "espadanal"], "contexts": ["sword lily root", "roots used in baths"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "espadana", "target_book": "polyanthea_medicinal", "target_name": "espadana", "similarity": 1.0}], "id": 2810, "stable_key": "clu_358a9ac6cf98fa99", "ground_truth": {"modern_name": "Sword lily root", "confidence": "high", "type": "plant", "linnaean": "Iris germanica", "family": "Iridaceae", "description": "Root of the sword lily (Iris), used medicinally.", "wikipedia_extract": "Iris \u00d7 germanica is the accepted name for a species of flowering plants in the family Iridaceae commonly known as the bearded iris or the German bearded iris. It is of hybrid origin. Varieties include I. \u00d7 g. var. florentina. Iris \u00d7 germanica grows up to 120 cm (47 in) high and 30 cm (12 in) wide. The roots can go up to 10 cm (3.9 in) deep and it is a rhizomatous perennial that blooms mid to late spring. Hundreds of cultivars exist representing nearly every colour from jet black to sparkling whites and red."}}, {"canonical_name": "Rey de Portugal", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "elrey_de_portugal", "book_id": "coloquios_da_orta_1563", "name": "elrey de Portugal", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["elrey de Portugal", "Rey de Portugal"], "contexts": ["king of Portugal", "ruler of Portugal"]}, {"entity_id": "rey_de_portugal", "book_id": "polyanthea_medicinal", "name": "Rey de Portugal", "category": "PERSON", "subcategory": "PATRON", "count": 8, "variants": ["Rey de Portugal", "Rey da Per\u017fia", "Rey de Polonia"], "contexts": ["King of Portugal", "D. Joao o IV. Rey de Portugal"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "elrey de Portugal", "target_book": "polyanthea_medicinal", "target_name": "Rey de Portugal", "similarity": 0.933}], "id": 2811, "stable_key": "clu_d538e8bd93fb6a66", "ground_truth": {"modern_name": "King of Portugal", "confidence": "high", "type": "person", "description": "Monarch of the Portuguese kingdom, patron of exploration and science.", "note": "This refers to the reigning monarch of Portugal during the period of publication of these texts, who often served as patrons for scientific and exploration endeavors.", "wikidata_id": "Q58800860", "wikidata_description": "Head of State of the Kingdom of Portugal"}}, {"canonical_name": "Evora", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "\u00e9vora", "book_id": "coloquios_da_orta_1563", "name": "\u00c9vora", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["\u00c9vora"], "contexts": ["city in Portugal", "city where book was published"]}, {"entity_id": "evora", "book_id": "polyanthea_medicinal", "name": "Evora", "category": "PLACE", "subcategory": "CITY", "count": 8, "variants": ["Evora"], "contexts": ["city where the Archbishop resided", "city where patient resided"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "\u00c9vora", "target_book": "polyanthea_medicinal", "target_name": "Evora", "similarity": 0.733}], "id": 2812, "stable_key": "clu_0050a36d1a68d8c5", "ground_truth": {"modern_name": "\u00c9vora", "confidence": "high", "type": "place", "description": "Historic city in Portugal, known for its Roman and medieval heritage.", "wikipedia_extract": "\u00c9vora, officially the Very Noble and Ever Loyal City of \u00c9vora, is a city and a municipality in Portugal. It has 53,591 inhabitants (2021), in an area of 1,307.08 square kilometers (504.67 mi2). It is considered the historic capital of the Alentejo region and serves as the seat of the \u00c9vora District. Due to its well-preserved old town centre, still partially enclosed by medieval walls, and many monuments dating from various historical periods, including a Roman Temple, \u00c9vora is a UNESCO World Heritage Site since 1986. Due to its inland position, \u00c9vora is one of Portugal's hottest cities in the summer, frequently subject to heatwaves. \u00c9vora is ranked number two in the Portuguese most livable cities survey of living conditions published yearly by Expresso. It was ranked first in a study concerning competitiveness of the 18 Portuguese district capitals, according to a 2006 study made by University of Minho economics researchers."}}, {"canonical_name": "Floren\u00e7a", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "floren\u00e7a", "book_id": "coloquios_da_orta_1563", "name": "Floren\u00e7a", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Floren\u00e7a"], "contexts": ["city of the Bardi house", "city of the Bardi commercial house"]}, {"entity_id": "floren\u00e7a", "book_id": "polyanthea_medicinal", "name": "Floren\u00e7a", "category": "PLACE", "subcategory": "CITY", "count": 9, "variants": ["Floren\u00e7a"], "contexts": ["city associated with a Grand Duke", "city associated with the Grand Duke"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Floren\u00e7a", "target_book": "polyanthea_medicinal", "target_name": "Floren\u00e7a", "similarity": 1.0}], "id": 2813, "stable_key": "clu_ac8f15d98fa3af49", "ground_truth": {"modern_name": "Florence", "confidence": "high", "type": "place", "description": "A major city in Tuscany, Italy, a center of Renaissance art and commerce.", "note": "Refers to the city and its historical significance.", "wikipedia_extract": "Florence (Italian: Firenze) is the capital and most populous city of the Italian region of Tuscany, with 362,353 inhabitants as of 2025. It is also the capital of the eponymous metropolitan province, which counts 989,460 inhabitants. Florence was a centre of medieval European trade and finance and one of the wealthiest cities of that era. It is considered by many academics to have been the birthplace of the Renaissance, becoming a major artistic, cultural, commercial, political, economic and financial center. During this time, Florence rose to a position of enormous influence in Italy, Europe, and beyond. Its turbulent political history includes periods of rule by the powerful Medici family and numerous religious and republican revolutions."}}, {"canonical_name": "Thomas Rodriguez da Veiga", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "thomaz_rodrigues_da_veiga", "book_id": "coloquios_da_orta_1563", "name": "Thomaz Rodrigues da Veiga", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Thomaz Rodrigues da Veiga"], "contexts": ["doctor whose lessons were heard in Coimbra"]}, {"entity_id": "thomas_rodriguez_da_veiga", "book_id": "polyanthea_medicinal", "name": "Thomas Rodriguez da Veiga", "category": "PERSON", "subcategory": "AUTHORITY", "count": 10, "variants": ["Thomas Rodriguez da Veiga", "Thomas Rodericus", "Thomas Rodriguez da Veyga"], "contexts": ["author recommending bloodletting for inflammations", "Portuguese scholar on medicine and nation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Thomaz Rodrigues da Veiga", "target_book": "polyanthea_medicinal", "target_name": "Thomas Rodriguez da Veiga", "similarity": 0.863}], "id": 2814, "stable_key": "clu_6b78a770a7eb5af4", "ground_truth": {"modern_name": "Thomas Rodriguez da Veiga", "confidence": "high", "type": "person", "description": "Portuguese scholar and physician, author of medicinal works.", "wikipedia_extract": "The Portuguese people (Portuguese: Portugueses \u2013 masculine \u2013 or Portuguesas) are a Romance-speaking ethnic group and nation indigenous to Portugal, a country that occupies the west side of the Iberian Peninsula in south-west Europe, who share culture, ancestry and language. The Portuguese state began with the founding of the County of Portugal in 868. Following the Battle of S\u00e3o Mamede (1128), Portugal gained international recognition as a kingdom through the Treaty of Zamora and the papal bull Manifestis Probatum. This Portuguese state paved the way for the Portuguese people to unite as a nation. The Portuguese explored distant lands previously unknown to Europeans\u2014in the Americas, Africa, Asia and Oceania (southwest Pacific Ocean). In 1415, with the conquest of Ceuta, the Portuguese took a significant role in the Age of Discovery, which culminated in a colonial empire."}}, {"canonical_name": "on\u00e7a", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "oncia", "book_id": "ricettario_fiorentino_1597", "name": "oncia", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["oncia"], "contexts": ["ounce", "unit of weight"]}, {"entity_id": "on\u00e7a", "book_id": "polyanthea_medicinal", "name": "on\u00e7a", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 9, "variants": ["on\u00e7a"], "contexts": ["ounce", "measure of weight"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "oncia", "target_book": "polyanthea_medicinal", "target_name": "on\u00e7a", "similarity": 0.923}], "id": 2815, "stable_key": "clu_9e317eaab04afa69", "ground_truth": {"modern_name": "ounce", "confidence": "high", "type": "object", "description": "A unit of weight, commonly 1/12th of a pound.", "wikipedia_extract": "The  ounce () is any of several different units of mass, weight, or volume and is derived almost unchanged from the uncia, an Ancient Roman unit of measurement. The avoirdupois ounce (exactly 28.349523125 g) is 1\u204416 avoirdupois pound; this is the United States customary and British imperial ounce. It is primarily used in the United States. Although the avoirdupois ounce is the mass measure used for most purposes, the 'troy ounce' of exactly 31.1034768 g is used instead for the mass of precious metals such as gold, silver, platinum, palladium, rhodium, etc. The term 'ounce' is also used in other contexts: The ounce-force is a measure of force (see below). Historically, a variety of different ounces measuring mass or volume were used in different jurisdictions by different trades and at different times in history."}}, {"canonical_name": "syllogisme", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "syllogisme", "book_id": "medecine_experimentale_bernard_1865", "name": "syllogisme", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["syllogisme"], "contexts": ["logical argument structure", "mode of reasoning"]}, {"entity_id": "syllogism", "book_id": "principles_of_psychology_james_1890", "name": "syllogism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["syllogism"], "contexts": ["form of logical argument"]}, {"entity_id": "syllogisms", "book_id": "principles_of_psychology_james_1890", "name": "syllogisms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["syllogisms"], "contexts": ["logical arguments with premises and conclusion"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "syllogisme", "target_book": "principles_of_psychology_james_1890", "target_name": "syllogism", "similarity": 0.967}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "syllogisme", "target_book": "principles_of_psychology_james_1890", "target_name": "syllogisms", "similarity": 0.897}], "id": 2816, "stable_key": "clu_3fdf0682ec8a9bed", "ground_truth": {"modern_name": "Syllogism", "confidence": "high", "type": "concept", "wikidata_id": "Q615599", "wikidata_description": "Aristotle's logical theory", "wikipedia_url": "https://en.wikipedia.org/wiki/Aristotelian%20logic"}}, {"canonical_name": "Hippocrate", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "hippocrate", "book_id": "medecine_experimentale_bernard_1865", "name": "Hippocrate", "category": "PERSON", "subcategory": "AUTHORITY", "count": 8, "variants": ["Hippocrate"], "contexts": ["ancient Greek physician, father of medicine", "ancient Greek physician, proponent of observation"]}, {"entity_id": "hippocrate", "book_id": "ricettario_fiorentino_1597", "name": "Hippocrate", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Hippocrate", "Hippocrates"], "contexts": ["ancient authority on rivers", "ancient authority on water quality"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Hippocrate", "target_book": "ricettario_fiorentino_1597", "target_name": "Hippocrate", "similarity": 1.0}], "id": 2817, "stable_key": "clu_8a00baf77bbe9a69", "ground_truth": {"modern_name": "Hippocrates", "confidence": "high", "type": "person", "birth_year": -460, "death_year": -370, "description": "Ancient Greek physician, considered the father of medicine.", "wikidata_id": "Q5264", "wikidata_description": "Greek physician (c.\u2009460 \u2013 c.\u2009370 BC)", "wikipedia_url": "https://en.wikipedia.org/wiki/Hippocrates"}}, {"canonical_name": "nerve-centres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "centres_nerveux", "book_id": "medecine_experimentale_bernard_1865", "name": "centres nerveux", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["centres nerveux"], "contexts": ["central nervous system components"]}, {"entity_id": "nerve-centres", "book_id": "principles_of_psychology_james_1890", "name": "nerve-centres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 9, "variants": ["nerve-centres", "NERVE-CENTRES"], "contexts": ["central processing areas of the nervous system", "central nervous system components"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "centres nerveux", "target_book": "principles_of_psychology_james_1890", "target_name": "nerve-centres", "similarity": 0.977}], "id": 2818, "stable_key": "clu_dff9755b2cedd6b6", "ground_truth": {"modern_name": "Nerve centers", "confidence": "high", "type": "concept", "note": "Refers to the central components of the nervous system, encompassing the brain and spinal cord.", "wikidata_id": "Q48526696", "wikidata_description": "scientific article published in June 2006"}}, {"canonical_name": "Eve", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "eve", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Eve", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 9, "variants": ["Eve"], "contexts": ["first woman, deceived by serpent", "presented the fruit"]}, {"entity_id": "eva", "book_id": "coloquios_da_orta_1563", "name": "Eva", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Eva"], "contexts": ["Biblical figure"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Eve", "target_book": "coloquios_da_orta_1563", "target_name": "Eva", "similarity": 0.911}], "id": 2819, "stable_key": "clu_04a2e1cfa40b2bab", "ground_truth": {"modern_name": "Eve", "confidence": "high", "type": "person", "description": "Biblical first woman, deceived by serpent", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Guts", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "guts", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Guts", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["guts", "Guts"], "contexts": ["intestines", "intestinal tract"]}, {"entity_id": "guts", "book_id": "english_physician_1652", "name": "Guts", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 7, "variants": ["Guts"], "contexts": ["intestinal organs", "internal body part"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Guts", "target_book": "english_physician_1652", "target_name": "Guts", "similarity": 1.0}], "id": 2820, "stable_key": "clu_52b61830d202061f-3", "ground_truth": {"modern_name": "Throat", "confidence": "high", "type": "concept", "note": "'Garganta' is the direct translation of 'throat' in Portuguese and Spanish, referring to the anatomical region.", "wikidata_id": "Q1783924", "wikidata_description": "organ system cancer in the head or neck region", "wikipedia_url": "https://en.wikipedia.org/wiki/Head%20and%20neck%20cancer", "wikipedia_extract": "Head and neck cancer is a general term encompassing multiple cancers that can develop in the head and neck region. These include cancers of the mouth, tongue, gums and lips (oral cancer), voice box (laryngeal), throat (nasopharyngeal, oropharyngeal, hypopharyngeal), salivary glands, nose and sinuses. Head and neck cancer can present a wide range of symptoms depending on where the cancer developed. These can include an ulcer in the mouth that does not heal, changes in the voice, difficulty swallowing, red or white patches in the mouth, and a neck lump. The majority of head and neck cancer is caused by the use of alcohol or tobacco (including smokeless tobacco). An increasing number of cases are caused by the human papillomavirus (HPV).", "description": "The anatomical part of the neck including the gullet."}}, {"canonical_name": "Lapis lafuli", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "lapis_anguinus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Lapis Anguinus", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Lapis Anguinus"], "contexts": ["stone with regular figures", "fossil stone, possibly snake-shaped"]}, {"entity_id": "lapis_lasuli", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Lapis Lasuli", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Lapis Lasuli"], "contexts": ["mineral with purgative faculty"]}, {"entity_id": "lapis_lafuli", "book_id": "polyanthea_medicinal", "name": "Lapis lafuli", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["Lapis lafuli", "Lapis-Lafuli", "Lapi\u017f-Lafuli", "lapilli", "lapillus", "lapis latuli"], "contexts": ["used in purgative pills", "stone used in medicine"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lapis Anguinus", "target_book": "polyanthea_medicinal", "target_name": "Lapis lafuli", "similarity": 0.881}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lapis Lasuli", "target_book": "polyanthea_medicinal", "target_name": "Lapis lafuli", "similarity": 0.92}], "id": 2821, "stable_key": "clu_78134e2d00134e05", "ground_truth": {"modern_name": "Lapis lazuli", "confidence": "high", "type": "mineral", "note": "The spelling 'Lapis lafuli' and 'Lapis Lasuli' are variations of 'Lapis lazuli'. 'Lapis Anguinus' refers to a snake stone, which is a different concept.", "wikidata_id": "Q10914750", "wikidata_description": "tectosilicate mineral; probably a sulfide-rich variety of ha\u00fcyne"}}, {"canonical_name": "sapphira", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "saphire", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Saphire", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Saphire"], "contexts": ["emits effluvium without diminution of weight", "stone preservative against inchantments"]}, {"entity_id": "sapphira", "book_id": "coloquios_da_orta_1563", "name": "sapphira", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 8, "variants": ["sapphira", "Sapphirorum", "sappkira", "sappkiras"], "contexts": ["precious stone", "ingredient: sapphires"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Saphire", "target_book": "coloquios_da_orta_1563", "target_name": "sapphira", "similarity": 0.909}], "id": 2822, "stable_key": "clu_b7f81552a7ac24d3", "ground_truth": {"modern_name": "Sapphire", "confidence": "high", "type": "mineral", "wikidata_id": "Q1767374", "wikidata_description": "butterfly genus in family Lycaenidae", "note": "The spelling 'Saphire' is an archaic variation."}}, {"canonical_name": "Alexipharmacum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "alexipharmaca", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Alexipharmaca", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Alexipharmaca"], "contexts": ["work by Nicander on venemous beasts and antidotes"]}, {"entity_id": "alexipharmacum", "book_id": "polyanthea_medicinal", "name": "Alexipharmacum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 9, "variants": ["Alexipharmacum", "adalexipharmaca", "alexipharmac", "alexipharmaca", "alexipharmacos", "alexipharmacum"], "contexts": ["remedy against poison", "remedy for plague"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Alexipharmaca", "target_book": "polyanthea_medicinal", "target_name": "Alexipharmacum", "similarity": 0.955}], "id": 2823, "stable_key": "clu_8fd99945f80af783", "ground_truth": {"modern_name": "Alexipharmic", "confidence": "high", "type": "concept", "note": "Alexipharmacum/Alexipharmaca/Alexiphar refers to a substance or remedy that protects against poison or venom. It is a concept rather than a specific chemical or preparation.", "wikidata_id": "Q194168", "wikidata_description": "substance that can counteract a form of poisoning", "wikipedia_url": "https://en.wikipedia.org/wiki/Antidote", "wikipedia_extract": "Justus de Harduwijn, also written Hardwijn, Herdewijn, Harduyn or Harduijn (11 April 1582 \u2013 21 June 1636 in Oudegem), was a 17th-century Roman Catholic priest and poet from the Southern Netherlands. He was the poetic link between the Renaissance and the Counter-Reformation in the Netherlands. De Harduwijn was born in a humanist, intellectual family in Ghent. His grandfather Thomas was a steward to Louis of Praet. His father Franciscus owned a bookbinding shop in Ghent and was a member of the Council of Flanders, the highest judicial college in the County of Flanders. His father was a friend of writer Jan van der Noot who had introduced him to the French poets of La Pl\u00e9iade, and is said to have been the first translator of Anacreon into Dutch."}}, {"canonical_name": "globe terrestre", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "globe_of_the_earth", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Globe of the Earth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Globe of the Earth"], "contexts": ["the Earth as a spherical body"]}, {"entity_id": "globe_terrestre", "book_id": "epoques_nature_buffon_1778", "name": "globe terrestre", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 9, "variants": ["globe terrestre"], "contexts": ["the planet Earth", "celestial body undergoing consolidation"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Globe of the Earth", "target_book": "epoques_nature_buffon_1778", "target_name": "globe terrestre", "similarity": 0.944}], "id": 2824, "stable_key": "clu_bff2d656b4c61f47", "ground_truth": {"modern_name": "Earth's globe", "confidence": "high", "type": "concept", "note": "Refers to the planet Earth as a spherical body.", "wikidata_id": "Q36133", "wikidata_description": "natural body consisting of layers that are primarily composed of minerals", "wikipedia_url": "https://en.wikipedia.org/wiki/Soil"}}, {"canonical_name": "contiguity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "contiguity", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "contiguity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["contiguity"], "contexts": ["state of being close"]}, {"entity_id": "contiguity", "book_id": "principles_of_psychology_james_1890", "name": "contiguity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["contiguity", "Contiguity", "CONTIGUITY"], "contexts": ["closeness in space or time", "closeness in thought or experience"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "contiguity", "target_book": "principles_of_psychology_james_1890", "target_name": "contiguity", "similarity": 1.0}], "id": 2825, "stable_key": "clu_6e8dab8d48072e63", "ground_truth": {"modern_name": "Contiguity", "confidence": "high", "type": "concept", "wikidata_id": "Q5165214", "wikidata_description": "theoretical concept in probability theory"}}, {"canonical_name": "Langius", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "langius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Langius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Langius"], "contexts": ["writer on natural history"]}, {"entity_id": "langius", "book_id": "polyanthea_medicinal", "name": "Langius", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 9, "variants": ["Langius"], "contexts": ["author of medical advice", "cited medical authority"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Langius", "target_book": "polyanthea_medicinal", "target_name": "Langius", "similarity": 0.702}], "id": 2826, "stable_key": "clu_0cfb7aaa9f8f40bd", "ground_truth": {"modern_name": "Jean Riolan", "confidence": "high", "type": "person", "birth_year": 1580, "death_year": 1657, "description": "French anatomist and physician, known for his anatomical works.", "note": "While 'Langius' could refer to various figures, Jean Riolan is a strong candidate in the context of early modern medical texts and comparative anatomy as discussed by Browne.", "wikidata_id": "", "wikidata_description": "French physician (1539-1605)"}}, {"canonical_name": "Pareus", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "pareus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Pareus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Pareus"], "contexts": ["author on hernias"]}, {"entity_id": "pareus", "book_id": "polyanthea_medicinal", "name": "Pareus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 9, "variants": ["Pareus", "Pareu"], "contexts": ["early modern scholar", "book 19"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Pareus", "target_book": "polyanthea_medicinal", "target_name": "Pareus", "similarity": 1.0}], "id": 2827, "stable_key": "clu_d6c9f6b6e8e85bc2", "ground_truth": {"modern_name": "Ambroise Par\u00e9", "confidence": "high", "type": "person", "birth_year": 1510, "death_year": 1590, "description": "Pioneering French surgeon and anatomist, influential in battlefield medicine.", "wikidata_id": "Q62087806", "wikidata_description": "V\u00e9lo'v bicycle-sharing station, Lyon region, France"}}, {"canonical_name": "sagapeno", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "sagapeno", "book_id": "ricettario_fiorentino_1597", "name": "Sagapeno", "category": "PLANT", "subcategory": "RESIN", "count": 4, "variants": ["Sagapeno"], "contexts": ["Greek name for Serapino", "resin from the spice trade"]}, {"entity_id": "sagapeno", "book_id": "polyanthea_medicinal", "name": "sagapeno", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["sagapeno", "Sagapeno", "Segapeno"], "contexts": ["sagapenum preparation for pills", "incense f