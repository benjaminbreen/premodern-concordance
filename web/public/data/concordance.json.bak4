_book": "ricettario_fiorentino_1597", "target_name": "lemon", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "lemon", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lemon", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "lim\u00e3o", "target_book": "ricettario_fiorentino_1597", "target_name": "lemon", "similarity": 0.916}, {"source_book": "coloquios_da_orta_1563", "source_name": "lim\u00e3o", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lemon", "similarity": 0.916}, {"source_book": "ricettario_fiorentino_1597", "source_name": "lemon", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lemon", "similarity": 1.0}], "id": 782, "stable_key": "clu_af88437fc51c06cd", "ground_truth": {"modern_name": "Citrus limon", "confidence": "high", "type": "plant", "linnaean": "Citrus limon L.", "family": "Rutaceae", "note": "The terms 'limoens', 'lim\u00f5es', and 'limas' all refer to citrus fruits, primarily lemons and limes. 'Limas' can also specifically refer to limes, but in the context of early modern texts and often alongside 'lim\u00f5es', it is a reasonable inclusion under the broader umbrella of citrus commonly known as lemons and limes.", "wikidata_id": "Q500", "wikidata_description": "nothospecies of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Lemon", "wikipedia_extract": "The lemon (Citrus \u00d7 limon) is a species of small evergreen tree in the Citrus genus of the flowering plant family Rutaceae. A true lemon is a hybrid of the citron and the bitter orange. Its origins are uncertain, but some evidence suggests lemons originated during the 1st millennium BC in what is now northeastern India. Some other citrus fruits are called lemon. The yellow fruit of the lemon tree is used throughout the world, primarily for its juice. The pulp and rind are used in cooking and baking."}}, {"canonical_name": "poets", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "poets", "book_id": "principles_of_psychology_james_1890", "name": "poets", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["poets"], "contexts": ["writers of poetry"]}, {"entity_id": "poet", "book_id": "principles_of_psychology_james_1890", "name": "poet", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["poet"], "contexts": ["writer of verse"]}, {"entity_id": "poets_of_nature", "book_id": "kosmos_humboldt_1845", "name": "poets of nature", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["poets of nature"], "contexts": ["early users of expression"]}, {"entity_id": "poetas", "book_id": "coloquios_da_orta_1563", "name": "poetas", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["poetas"], "contexts": ["writers of verse"]}, {"entity_id": "poet", "book_id": "first_principles_spencer_1862", "name": "poet", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["poet"], "contexts": ["refers to an unnamed poet"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "poets", "target_book": "kosmos_humboldt_1845", "target_name": "poets of nature", "similarity": 0.881}, {"source_book": "principles_of_psychology_james_1890", "source_name": "poets", "target_book": "coloquios_da_orta_1563", "target_name": "poetas", "similarity": 0.983}, {"source_book": "principles_of_psychology_james_1890", "source_name": "poets", "target_book": "first_principles_spencer_1862", "target_name": "poet", "similarity": 0.925}, {"source_book": "principles_of_psychology_james_1890", "source_name": "poet", "target_book": "coloquios_da_orta_1563", "target_name": "poetas", "similarity": 0.904}, {"source_book": "principles_of_psychology_james_1890", "source_name": "poet", "target_book": "first_principles_spencer_1862", "target_name": "poet", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "poets of nature", "target_book": "coloquios_da_orta_1563", "target_name": "poetas", "similarity": 0.868}, {"source_book": "coloquios_da_orta_1563", "source_name": "poetas", "target_book": "first_principles_spencer_1862", "target_name": "poet", "similarity": 0.904}], "id": 783, "stable_key": "clu_6226a424d9f5429a", "ground_truth": {"modern_name": "poet", "confidence": "high", "type": "person", "description": "Author of poetry or verse, often as early users of expression."}}, {"canonical_name": "Copper", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "copper", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Copper", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Copper"], "contexts": ["metal, can be formed from iron", "metal mixed with gold as an allay"]}, {"entity_id": "copper", "book_id": "english_physician_1652", "name": "Copper", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Copper"], "contexts": ["metal used for plates"]}, {"entity_id": "copper", "book_id": "relation_historique_humboldt_vol3_1825", "name": "copper", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["copper"], "contexts": ["crucibles for melting copper"]}, {"entity_id": "copper", "book_id": "principles_of_psychology_james_1890", "name": "copper", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["copper"], "contexts": ["chemical element and metal"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Copper", "target_book": "english_physician_1652", "target_name": "Copper", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "copper", "target_book": "principles_of_psychology_james_1890", "target_name": "copper", "similarity": 1.0}], "id": 784, "stable_key": "clu_1fa3ab7b274a70ee-2", "ground_truth": {"modern_name": "Copper", "confidence": "high", "type": "mineral", "wikidata_id": "Q753", "wikidata_description": "chemical element with symbol Cu and atomic number 29", "wikipedia_url": "https://en.wikipedia.org/wiki/Copper", "wikipedia_extract": "Copper is a chemical element; it has symbol Cu (from Latin cuprum) and atomic number 29. It is a soft, malleable, and ductile metal with very high thermal and electrical conductivity. A freshly exposed surface of pure copper has a pinkish-orange color. Copper is used as a conductor of heat and electricity, as a building material, and as a constituent of various metal alloys, such as sterling silver used in jewelry, cupronickel used to make marine hardware and coins, and constantan used in strain gauges and thermocouples for temperature measurement. Copper is one of the few native metals, meaning metals that occur naturally in a directly usable, unalloyed metallic form. This led to very early human use in several regions, from c."}}, {"canonical_name": "Italian", "category": "PLACE", "subcategory": "REGION", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "italian", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Italian", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Italian"], "contexts": ["language of a tract"]}, {"entity_id": "italian", "book_id": "kosmos_humboldt_1845", "name": "Italian", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Italian"], "contexts": ["person from Italy", "peninsula form compared"]}, {"entity_id": "italian", "book_id": "principles_of_psychology_james_1890", "name": "Italian", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Italian"], "contexts": ["language and country"]}, {"entity_id": "italian", "book_id": "first_principles_spencer_1862", "name": "Italian", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Italian"], "contexts": ["language and people"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Italian", "target_book": "kosmos_humboldt_1845", "target_name": "Italian", "similarity": 0.758}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Italian", "target_book": "first_principles_spencer_1862", "target_name": "Italian", "similarity": 1.0}], "id": 785, "stable_key": "clu_0af750baac0f4da7-3", "ground_truth": {"modern_name": "Italy", "confidence": "high", "type": "place", "description": "European country associated with specific plants and historical references.", "wikipedia_extract": "Italy, officially the Italian Republic, is a country in Southern and Western Europe. It consists of a peninsula that extends into the Mediterranean Sea, with the Alps on its northern land border, as well as nearly 800 islands, notably Sicily and Sardinia. Italy shares land borders with France to the west; Switzerland and Austria to the north; Slovenia to the east; and the two enclaves of Vatican City and San Marino. It is the tenth-largest country in Europe by area, covering 301,340 km2 (116,350 sq mi), and the third-most populous member state of the European Union, with nearly 59 million inhabitants. Italy's capital and largest city is Rome; other major cities include Milan, Naples, Turin, Palermo, Bologna, Florence, Genoa, and Venice. The history of Italy goes back to numerous Italic peoples, notably including the ancient Romans, who conquered the Mediterranean world during the Roman Republic and ruled it for centuries during the Roman Empire."}}, {"canonical_name": "d\u00e9couverte", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 4, "members": [{"entity_id": "d\u00e9couverte", "book_id": "medecine_experimentale_bernard_1865", "name": "d\u00e9couverte", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["d\u00e9couverte"], "contexts": ["act of finding something new"]}, {"entity_id": "d\u00e9couverte", "book_id": "epoques_nature_buffon_1778", "name": "d\u00e9couverte", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["d\u00e9couverte"], "contexts": ["advancement in knowledge"]}, {"entity_id": "descoberto", "book_id": "coloquios_da_orta_1563", "name": "descoberto", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["descoberto"], "contexts": ["quality of the pulse"]}, {"entity_id": "discovery", "book_id": "connexion_physical_sciences_somerville_1858", "name": "discovery", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["discovery"], "contexts": ["act of finding something new"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "d\u00e9couverte", "target_book": "epoques_nature_buffon_1778", "target_name": "d\u00e9couverte", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "d\u00e9couverte", "target_book": "coloquios_da_orta_1563", "target_name": "descoberto", "similarity": 0.922}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "d\u00e9couverte", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "discovery", "similarity": 0.922}, {"source_book": "epoques_nature_buffon_1778", "source_name": "d\u00e9couverte", "target_book": "coloquios_da_orta_1563", "target_name": "descoberto", "similarity": 0.922}], "id": 786, "stable_key": "clu_3eb829e20b8f2cb7-2", "ground_truth": {"modern_name": "Discoveries", "confidence": "high", "type": "concept", "wikidata_id": "Q42135811", "wikidata_description": "scientific article published on 18 January 2012"}}, {"canonical_name": "exp\u00e9rimentations", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 4, "total_mentions": 4, "members": [{"entity_id": "exp\u00e9rimentations", "book_id": "medecine_experimentale_bernard_1865", "name": "exp\u00e9rimentations", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["exp\u00e9rimentations"], "contexts": ["scientific testing and trials"]}, {"entity_id": "experiments", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "experiments", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["experiments"], "contexts": ["scientific tests for discovery"]}, {"entity_id": "experiments", "book_id": "principles_of_psychology_james_1890", "name": "experiments", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["experiments"], "contexts": ["scientific procedures to test hypotheses"]}, {"entity_id": "experimentey", "book_id": "polyanthea_medicinal", "name": "experimentey", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["experimentey"], "contexts": ["medical action"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "exp\u00e9rimentations", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "experiments", "similarity": 0.94}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "exp\u00e9rimentations", "target_book": "principles_of_psychology_james_1890", "target_name": "experiments", "similarity": 0.94}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "exp\u00e9rimentations", "target_book": "polyanthea_medicinal", "target_name": "experimentey", "similarity": 0.905}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "experiments", "target_book": "principles_of_psychology_james_1890", "target_name": "experiments", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "experiments", "target_book": "polyanthea_medicinal", "target_name": "experimentey", "similarity": 0.93}, {"source_book": "principles_of_psychology_james_1890", "source_name": "experiments", "target_book": "polyanthea_medicinal", "target_name": "experimentey", "similarity": 0.93}], "id": 787, "stable_key": "clu_275d933ddcfa49f7", "ground_truth": {"modern_name": "scientific experiment", "confidence": "high", "type": "concept", "note": "This cluster refers to the general concept and practice of conducting experiments for scientific inquiry.", "wikidata_id": "Q101965", "wikidata_description": "scientific procedure carried out to support, refute, or validate a hypothesis", "wikipedia_url": "https://en.wikipedia.org/wiki/Experiment", "wikipedia_extract": "An experiment is a procedure carried out to support or refute a hypothesis, or determine the efficacy or likelihood of something previously untried. Experiments provide insight into cause-and-effect by demonstrating what outcome occurs when a particular factor is manipulated. Experiments vary greatly in goal and scale but always rely on repeatable procedure and logical analysis of the results. There also exist  natural experimental studies. A child may carry out basic experiments to understand how things fall to the ground, while teams of scientists may take years of systematic investigation to advance their understanding of a phenomenon. Experiments and other types of hands-on activities are very important to student learning in the science classroom."}}, {"canonical_name": "Garden", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 4, "members": [{"entity_id": "garden", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Garden", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Garden"], "contexts": ["location where Adam hid from God"]}, {"entity_id": "garden", "book_id": "origin_of_species_darwin_1859", "name": "garden", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["garden"], "contexts": ["location where seeds were found"]}, {"entity_id": "garden", "book_id": "principles_of_psychology_james_1890", "name": "garden", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["garden"], "contexts": ["location for plants"]}, {"entity_id": "horto", "book_id": "ricettario_fiorentino_1597", "name": "horto", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["horto"], "contexts": ["Garden"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Garden", "target_book": "origin_of_species_darwin_1859", "target_name": "garden", "similarity": 0.991}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Garden", "target_book": "principles_of_psychology_james_1890", "target_name": "garden", "similarity": 0.991}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Garden", "target_book": "ricettario_fiorentino_1597", "target_name": "horto", "similarity": 0.936}, {"source_book": "origin_of_species_darwin_1859", "source_name": "garden", "target_book": "principles_of_psychology_james_1890", "target_name": "garden", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "garden", "target_book": "ricettario_fiorentino_1597", "target_name": "horto", "similarity": 0.94}, {"source_book": "principles_of_psychology_james_1890", "source_name": "garden", "target_book": "ricettario_fiorentino_1597", "target_name": "horto", "similarity": 0.94}], "id": 788, "stable_key": "clu_6af94cce1f0ea253-2", "ground_truth": {"modern_name": "Gardens", "confidence": "high", "type": "place", "note": "The term 'Jardinillos' can refer to specific gardens but in this context, across multiple languages and texts, it broadly refers to gardens where plants were cultivated or observed.", "wikidata_id": "Q740887", "wikidata_description": "genus of flowering plants in the coffee family Rubiaceae", "wikipedia_url": "https://en.wikipedia.org/wiki/Gardenia", "wikipedia_extract": "Gardenia is a genus of flowering plants in the coffee family, Rubiaceae, native to the tropical and subtropical regions of Africa, Asia, Madagascar, Pacific Islands, and Australia. The genus was named by Carl Linnaeus and John Ellis after Alexander Garden (1730\u20131791), a Scottish naturalist. The type species is Gardenia jasminoides, as first published by Ellis in 1761. Gardenia species typically grow as shrubs or small trees, however some species, such as those native to New Guinea, may grow to 20-30m tall. A small number of species found in tropical East Africa and southern Africa grow as small pyrophytic subshrubs. At least one species, Gardenia epiphytica, native to Gabon and Cameroon, grows as an epiphyte."}}, {"canonical_name": "Clay", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 4, "total_mentions": 4, "members": [{"entity_id": "clay", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Clay", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Clay"], "contexts": ["earthy material"]}, {"entity_id": "clay", "book_id": "kosmos_humboldt_1845", "name": "clay", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["clay"], "contexts": ["accompanying silica"]}, {"entity_id": "clay", "book_id": "connexion_physical_sciences_somerville_1858", "name": "clay", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["clay"], "contexts": ["moist material producing electrical currents"]}, {"entity_id": "clay", "book_id": "first_principles_spencer_1862", "name": "clay", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["clay"], "contexts": ["fine-grained natural soil"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Clay", "target_book": "kosmos_humboldt_1845", "target_name": "clay", "similarity": 0.922}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Clay", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "clay", "similarity": 0.922}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Clay", "target_book": "first_principles_spencer_1862", "target_name": "clay", "similarity": 0.922}, {"source_book": "kosmos_humboldt_1845", "source_name": "clay", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "clay", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "clay", "target_book": "first_principles_spencer_1862", "target_name": "clay", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "clay", "target_book": "first_principles_spencer_1862", "target_name": "clay", "similarity": 1.0}], "id": 789, "stable_key": "clu_7ff1143f6fac33cf-3", "ground_truth": {"modern_name": "Clay", "confidence": "high", "type": "mineral", "wikidata_id": "Q164192", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Claytonia", "note": "Argile and argilla are historical terms for clay.", "wikipedia_extract": "Claytonia (spring beauty) is a genus of flowering plants native to Asia, North America, and Central America. The vitamin-rich leaves can be eaten raw or cooked, and the tubers can be prepared like potatoes. The plants are somewhat fleshy and only a few centimeters in height. The flower heads are about 2.5 cm (1 inch) in diameter. The genus was formerly included in the purslane family (Portulacaceae), but with the adoption of the APG IV system, in 2009 it was moved to the family Montiaceae. A number of the species were formerly treated in the related genus Montia."}}, {"canonical_name": "Electrick attraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 4, "members": [{"entity_id": "electrick_attraction", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Electrick attraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Electrick attraction"], "contexts": ["phenomenon caused by sulphureous effluvium"]}, {"entity_id": "attraction_magn\u00e9tique", "book_id": "epoques_nature_buffon_1778", "name": "attraction magn\u00e9tique", "category": "CONCEPT", "subca