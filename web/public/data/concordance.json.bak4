"geological period"]}, {"entity_id": "tertiary_periods", "book_id": "origin_of_species_darwin_1859", "name": "tertiary periods", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tertiary periods"], "contexts": ["geological time divisions"]}, {"entity_id": "tertiary_period", "book_id": "kosmos_humboldt_1845", "name": "tertiary period", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tertiary period"], "contexts": ["geological era"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "p\u00e9riode tertiaire", "target_book": "origin_of_species_darwin_1859", "target_name": "tertiary periods", "similarity": 0.925}, {"source_book": "epoques_nature_buffon_1778", "source_name": "p\u00e9riode tertiaire", "target_book": "kosmos_humboldt_1845", "target_name": "tertiary period", "similarity": 0.958}, {"source_book": "origin_of_species_darwin_1859", "source_name": "tertiary periods", "target_book": "kosmos_humboldt_1845", "target_name": "tertiary period", "similarity": 0.958}], "id": 2015, "stable_key": "clu_c8c1dce26c257100", "ground_truth": {"modern_name": "Neogene Period", "confidence": "high", "type": "concept", "note": "While 'tertiary periods' was a common term in the 19th century, it has been superseded by the Neogene and Paleogene periods within the Cenozoic Era. The context of geological time divisions points to this."}}, {"canonical_name": "arbres fruitiers", "category": "PLANT", "subcategory": "TREE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "arbres_fruitiers", "book_id": "epoques_nature_buffon_1778", "name": "arbres fruitiers", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["arbres fruitiers"], "contexts": ["trees bearing fruit"]}, {"entity_id": "fruit_trees", "book_id": "origin_of_species_darwin_1859", "name": "fruit trees", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["fruit trees"], "contexts": ["cultivated trees for fruit production"]}, {"entity_id": "arbres_fruitiers", "book_id": "relation_historique_humboldt_vol3_1825", "name": "arbres fruitiers", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["arbres fruitiers"], "contexts": ["fruit trees found in the surroundings of Pao"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "arbres fruitiers", "target_book": "origin_of_species_darwin_1859", "target_name": "fruit trees", "similarity": 0.961}, {"source_book": "epoques_nature_buffon_1778", "source_name": "arbres fruitiers", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "arbres fruitiers", "similarity": 0.917}], "id": 2016, "stable_key": "clu_80bd9b1dc193cda9", "ground_truth": {"modern_name": "Fruit trees", "confidence": "high", "type": "plant", "wikidata_id": "Q904653", "wikidata_description": "tree which bears fruit that is consumed or used by humans and some animals"}}, {"canonical_name": "canards", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "canards", "book_id": "epoques_nature_buffon_1778", "name": "canards", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["canards"], "contexts": ["domesticated waterfowl"]}, {"entity_id": "canary-bird", "book_id": "origin_of_species_darwin_1859", "name": "canary-bird", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["canary-bird"], "contexts": ["bird used in hybridization experiments"]}, {"entity_id": "canards", "book_id": "relation_historique_humboldt_vol3_1825", "name": "canards", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["canards"], "contexts": ["ducks"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "canards", "target_book": "origin_of_species_darwin_1859", "target_name": "canary-bird", "similarity": 0.899}, {"source_book": "epoques_nature_buffon_1778", "source_name": "canards", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "canards", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "canary-bird", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "canards", "similarity": 0.899}], "id": 2017, "stable_key": "clu_36d4834e004e6077", "ground_truth": {"modern_name": "Canary", "confidence": "medium", "type": "animal", "note": "While 'canary-bird' clearly refers to the bird, 'canards' in the Humboldt text is likely a misspelling or a different word referring to ducks, leading to a low confidence for the cluster as a whole encompassing both. However, the strong presence of 'canary-bird' makes the bird identification high confidence.", "wikidata_id": "Q2936174", "wikidata_description": "rose cultivar"}}, {"canonical_name": "lumi\u00e8re solaire", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "lumi\u00e8re_solaire", "book_id": "epoques_nature_buffon_1778", "name": "lumi\u00e8re solaire", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["lumi\u00e8re solaire"], "contexts": ["influence on plant matter"]}, {"entity_id": "sunshine", "book_id": "principles_of_psychology_james_1890", "name": "sunshine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["sunshine"], "contexts": ["light from the sun"]}, {"entity_id": "sunshine", "book_id": "kosmos_humboldt_1845", "name": "sunshine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["sunshine"], "contexts": ["light from the sun"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "lumi\u00e8re solaire", "target_book": "principles_of_psychology_james_1890", "target_name": "sunshine", "similarity": 0.914}, {"source_book": "epoques_nature_buffon_1778", "source_name": "lumi\u00e8re solaire", "target_book": "kosmos_humboldt_1845", "target_name": "sunshine", "similarity": 0.914}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sunshine", "target_book": "kosmos_humboldt_1845", "target_name": "sunshine", "similarity": 1.0}], "id": 2018, "stable_key": "clu_c61fb93ef3228773-2", "ground_truth": {"modern_name": "Sunlight", "confidence": "high", "type": "concept", "note": "The phrases 'solar light' and 'Sun\u2019s substance' all refer to light originating from the sun.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "mat\u00e9riaux inorganiques", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "mat\u00e9riaux_inorganiques", "book_id": "epoques_nature_buffon_1778", "name": "mat\u00e9riaux inorganiques", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["mat\u00e9riaux inorganiques"], "contexts": ["absorbed from soil by plants"]}, {"entity_id": "inorganic_substances", "book_id": "kosmos_humboldt_1845", "name": "inorganic substances", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["inorganic substances"], "contexts": ["non-living substances"]}, {"entity_id": "inorganic_compounds", "book_id": "first_principles_spencer_1862", "name": "inorganic compounds", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["inorganic compounds"], "contexts": ["chemical compounds without carbon-hydrogen bonds"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "mat\u00e9riaux inorganiques", "target_book": "kosmos_humboldt_1845", "target_name": "inorganic substances", "similarity": 0.945}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mat\u00e9riaux inorganiques", "target_book": "first_principles_spencer_1862", "target_name": "inorganic compounds", "similarity": 0.943}, {"source_book": "kosmos_humboldt_1845", "source_name": "inorganic substances", "target_book": "first_principles_spencer_1862", "target_name": "inorganic compounds", "similarity": 0.98}], "id": 2019, "stable_key": "clu_26f3f8ac009888b6", "ground_truth": {"modern_name": "Inorganic compounds", "confidence": "high", "type": "chemical", "note": "'Amorphous substances' are a subset of inorganic or organic substances that lack a regular, ordered internal structure. However, in the context of contrasting with living substances or focusing on fundamental chemical constituents, 'inorganic compounds' is a fitting overarching term.", "wikidata_id": "Q190065", "wikidata_description": "compound that is not organic: i.e. does not contain carbon with exceptions e.g. CO, carbon dioxide, disulfide and diselenide, carbides, HCN, carbonic acid, cyanic, isocyanic and fulminic acids and carbonates, hydrogen carbonates, cyanides, cyanates", "wikipedia_url": "https://en.wikipedia.org/wiki/Inorganic%20compound", "wikipedia_extract": "An inorganic compound is typically a chemical compound that lacks carbon\u2013hydrogen bonds\u2060\u200d\u2014\u200dthat is, a compound that is not an organic compound. The study of inorganic compounds is a subfield of chemistry known as inorganic chemistry. Inorganic compounds comprise most of the Earth's crust, although the compositions of the deep mantle remain active areas of investigation. All allotropes of carbon and some simple carbon compounds are often considered inorganic. Examples include the allotropes of carbon (graphite, diamond, buckminsterfullerene, graphene, etc.), carbon monoxide CO, carbon dioxide CO2, carbides, and salts of inorganic anions such as carbonates, cyanides, cyanates, thiocyanates, isothiocyanates, etc. Many of these are normal parts of mostly organic systems, including organisms; describing a chemical as inorganic does not necessarily mean that it cannot occur within living things."}}, {"canonical_name": "Defluxions of humors", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "defluxions_of_humors", "book_id": "english_physician_1652", "name": "Defluxions of humors", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Defluxions of humors"], "contexts": ["eye condition treated with water"]}, {"entity_id": "humorales", "book_id": "polyanthea_medicinal", "name": "humorales", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["humorales"], "contexts": ["diseases related to humors"]}, {"entity_id": "moods", "book_id": "first_principles_spencer_1862", "name": "moods", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["moods"], "contexts": ["temporary states of mind"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Defluxions of humors", "target_book": "polyanthea_medicinal", "target_name": "humorales", "similarity": 0.903}, {"source_book": "english_physician_1652", "source_name": "Defluxions of humors", "target_book": "first_principles_spencer_1862", "target_name": "moods", "similarity": 0.889}, {"source_book": "polyanthea_medicinal", "source_name": "humorales", "target_book": "first_principles_spencer_1862", "target_name": "moods", "similarity": 0.908}], "id": 2020, "stable_key": "clu_f055a8a1f965bf26", "ground_truth": {"modern_name": "Humoralism", "confidence": "high", "type": "concept", "note": "The phrase 'Defluxions of humors' refers to a concept within the humoral theory of medicine, where imbalances or excessive flow of bodily fluids (humors) were believed to cause disease or temporary states. 'Moods' in this context likely refers to the emotional or physiological states influenced by these humors.", "wikidata_id": "Q5782572", "wikidata_description": "ancient Greek and Roman system of medicine involving four fluid types", "wikipedia_url": "https://en.wikipedia.org/wiki/Humorism", "wikipedia_extract": "Humorism, the humoral theory, or humoralism, was a system of medicine detailing a supposed makeup and workings of the human body, adopted by Ancient Greek and Roman physicians and philosophers. Humorism began to fall out of favor in the 17th century and it was definitively disproved with the discovery of microbes. The concept of \"humors\" may have origins in Ancient Egyptian medicine, or Mesopotamia, though it was not systemized until ancient Greek thinkers. The word humor is a translation of Greek \u03c7\u03c5\u03bc\u03cc\u03c2, chymos (literally 'juice' or 'sap', metaphorically 'flavor'). Early texts on Indian Ayurveda medicine presented a theory of three or four humors (do\u1e63as), which they sometimes linked with the five elements (pa\u00f1ca-bh\u016bta): earth, water, fire, air, and space. The concept of \"humors\" (chemical systems regulating human behaviour) became more prominent from the writing of medical theorist Alcmaeon of Croton (c."}}, {"canonical_name": "round", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "round", "book_id": "english_physician_1652", "name": "round", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["round"], "contexts": ["shape of heads"]}, {"entity_id": "round", "book_id": "principles_of_psychology_james_1890", "name": "round", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["round"], "contexts": ["shape attribute of an object"]}, {"entity_id": "round", "book_id": "connexion_physical_sciences_somerville_1858", "name": "round", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["round"], "contexts": ["spherical or circular shape"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "round", "target_book": "principles_of_psychology_james_1890", "target_name": "round", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "round", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "round", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "round", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "round", "similarity": 1.0}], "id": 2021, "stable_key": "clu_13a571c528c786bb", "ground_truth": {"modern_name": "roundness", "confidence": "high", "type": "concept", "wikidata_id": "Q128171531", "wikidata_description": "scholarly article", "wikipedia_extract": "Body roundness index (BRI) is a calculated geometric index used to quantify an aspect of a person's individual body shape. Based on the principle of body eccentricity, it provides a rapid visual and anthropometric tool for health evaluation. Introduced in 2013, the BRI calculation can be used to estimate total and visceral body fat. Ranges of healthy body roundness have been established to accurately classify people with healthy fat mass (weight) compared to obese people who are at risk for morbidities. Compared to traditional metrics, such as the body mass index (BMI, which uses weight and height), BRI may improve predictions of the amount of body fat and the volume of visceral adipose tissue. Despite its common use, BMI can misclassify individuals as obese because it does not distinguish between a person's lean body mass and fat mass.", "wikipedia_url": "https://en.wikipedia.org/wiki/Body_roundness_index"}}, {"canonical_name": "property", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "property", "book_id": "english_physician_1652", "name": "property", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["property"], "contexts": ["drying and binding property"]}, {"entity_id": "propiedad", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "propiedad", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["propiedad"], "contexts": ["property or characteristic"]}, {"entity_id": "propri\u00e9t\u00e9", "book_id": "relation_historique_humboldt_vol3_1825", "name": "propri\u00e9t\u00e9", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["propri\u00e9t\u00e9"], "contexts": ["ownership"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "property", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "propiedad", "similarity": 0.936}, {"source_book": "english_physician_1652", "source_name": "property", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "propri\u00e9t\u00e9", "similarity": 0.889}], "id": 2022, "stable_key": "clu_a01d4aca5c83f45e", "ground_truth": {"modern_name": "Property", "confidence": "high", "type": "concept"}}, {"canonical_name": "Purges", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "purges", "book_id": "english_physician_1652", "name": "Purges", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Purges"], "contexts": ["medical procedures"]}, {"entity_id": "purgando", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "purgando", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["purgando"], "contexts": ["purging the stomach with Tepetla xihuitl"]}, {"entity_id": "purging", "book_id": "coloquios_da_orta_1563", "name": "purging", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["purging"], "contexts": ["medical practice discussed"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Purges", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "purgando", "similarity": 0.894}, {"source_book": "english_physician_1652", "source_name": "Purges", "target_book": "coloquios_da_orta_1563", "target_name": "purging", "similarity": 0.92}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "purgando", "target_book": "coloquios_da_orta_1563", "target_name": "purging", "similarity": 0.949}], "id": 2023, "stable_key": "clu_9b7d1c8135f3f6b5-2", "ground_truth": {"modern_name": "Purging", "confidence": "high", "type": "concept", "description": "Medical practice of cleansing the body, often with medicines.", "note": "Refers to inducing vomiting or bowel movements for medical purposes.", "wikipedia_extract": "In medicine, a cathartic is a substance that accelerates defecation. This is similar to a laxative, which is a substance that eases defecation, usually by softening feces. It is possible for a substance to be both a laxative and a cathartic. However, agents such as psyllium seed husks increase the bulk of the feces. Cathartics such as sorbitol, magnesium citrate, magnesium sulfate, or sodium sulfate were previously used as a form of gastrointestinal decontamination following poisoning via ingestion. They are no longer routinely recommended for poisonings."}}, {"canonical_name": "Springs", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "springs", "book_id": "english_physician_1652", "name": "Springs", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Springs"], "contexts": ["location where Maidenhair grows"]}, {"entity_id": "springs", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "springs", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["springs"], "contexts": ["source of salt"]}, {"entity_id": "springs", "book_id": "kosmos_humboldt_1845", "name": "springs", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["springs"], "contexts": ["water sources from ground"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Springs", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "springs", "similarity": 0.959}, {"source_book": "english_physician_1652", "source_name": "Springs", "target_book": "kosmos_humboldt_1845", "target_name": "springs", "similarity": 0.959}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "springs", "target_book": "kosmos_humboldt_1845", "target_name": "springs", "similarity": 1.0}], "id": 2024, "stable_key": "clu_fcd4096fd9b4de9f", "ground_truth": {"modern_name": "Springs", "confidence": "high", "type": "place", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Borrego_Springs,_California", "wikipedia_extract": "Borrego Springs is a census-designated place (CDP) in northeastern San Diego County, California. It is located within the Low Desert area of Southern California. The population was 3,073 at the 2020 census. Borrego Springs is surrounded by Anza-Borrego Desert State Park. Anza-Borrego State Park's name is derived from Juan Bautista de Anza, who notably camped there, and \"borrego\", which is Spanish for \"lamb\", in honor of the local herds of bighorn sheep. The area east of town was the site of a vast World War II US Navy training center, the Borrego Valley Maneuver Area, with supporting camps and airstrips."}}, {"canonical_name": "Places", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "places", "book_id": "english_physician_1652", "name": "Places", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Places"], "contexts": ["section heading for locations"]}, {"entity_id": "des_lieux", "book_id": "relation_historique_humboldt_vol3_1825", "name": "des lieux", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["des lieux"], "contexts": ["of the places"]}, {"entity_id": "lugares", "book_id": "polyanthea_medicinal", "name": "lugares", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["lugares"], "contexts": ["places"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Places", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "des lieux", "similarity": 0.947}, {"source_book": "english_physician_1652", "source_name": "Places", "target_book": "polyanthea_medicinal", "target_name": "lugares", "similarity": 0.968}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "des lieux", "target_book": "polyanthea_medicinal", "target_name": "lugares", "similarity": 0.95}], "id": 2025, "stable_key": "clu_ebe9aa9f7ebce7a6", "ground_truth": {"modern_name": "Places", "confidence": "high", "type": "place", "wikidata_id": "Q7200212", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Place%20%28surname%29"}}, {"canonical_name": "Portsmouth", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "portsmouth", "book_id": "english_physician_1652", "name": "Portsmouth", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Portsmouth"], "contexts": ["coastal town"]}, {"entity_id": "portsmouth", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Portsmouth", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Portsmouth"], "contexts": ["city vis-\u00e0-vis Alexandria"]}, {"entity_id": "portsmouth", "book_id": "kosmos_humboldt_1845", "name": "Portsmouth", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Portsmouth"], "contexts": ["westernmost point of observation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Portsmouth", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Portsmouth", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Portsmouth", "target_book": "kosmos_humboldt_1845", "target_name": "Portsmouth", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Portsmouth", "target_book": "kosmos_humboldt_1845", "target_name": "Portsmouth", "similarity": 1.0}], "id": 2026, "stable_key": "clu_6f30da145d2f5651", "ground_truth": {"modern_name": "Portsmouth", "confidence": "high", "type": "place", "country": "United Kingdom", "note": "Portsmouth is a well-established city and naval base in the UK.", "wikidata_id": "Q72259", "wikidata_description": "city in Hampshire, England, United Kingdom"}}, {"canonical_name": "consuming", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "consuming", "book_id": "english_physician_1652", "name": "consuming", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["consuming"], "contexts": ["property of honeysuckles"]}, {"entity_id": "consume", "book_id": "historia_medicinal_monardes_1574", "name": "consume", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["consume"], "contexts": ["effect of Sulfur"]}, {"entity_id": "consumption", "book_id": "first_principles_spencer_1862", "name": "consumption", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["consumption"], "contexts": ["use of goods and services"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "consuming", "target_book": "historia_medicinal_monardes_1574", "target_name": "consume", "similarity": 0.952}, {"source_book": "english_physician_1652", "source_name": "consuming", "target_book": "first_principles_spencer_1862", "target_name": "consumption", "similarity": 0.913}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "consume", "target_book": "first_principles_spencer_1862", "target_name": "consumption", "similarity": 0.943}], "id": 2027, "stable_key": "clu_6c2f035546f1ad2c", "ground_truth": {"modern_name": "Consumption", "confidence": "high", "type": "concept", "note": "In the context of early modern medicine, 'consuming' and 'consumption' often referred to wasting diseases, particularly tuberculosis, but could also describe the depletion or use of something."}}, {"canonical_name": "Shell", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "shell", "book_id": "english_physician_1652", "name": "Shell", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Shell"], "contexts": ["outer covering of walnuts"]}, {"entity_id": "shell", "book_id": "origin_of_species_darwin_1859", "name": "shell", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["shell"], "contexts": ["protective outer covering"]}, {"entity_id": "shell", "book_id": "connexion_physical_sciences_somerville_1858", "name": "shell", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["shell"], "contexts": ["outer protective layer"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Shell", "target_book": "origin_of_species_darwin_1859", "target_name": "shell", "similarity": 0.844}, {"source_book": "english_physician_1652", "source_name": "Shell", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "shell", "similarity": 0.643}, {"source_book": "origin_of_species_darwin_1859", "source_name": "shell", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "shell", "similarity": 0.753}], "id": 2028, "stable_key": "clu_de25100725f90990", "ground_truth": {"modern_name": "Shell", "confidence": "high", "type": "object", "note": "Refers to the hard outer covering of various organisms (e.g., walnuts, mollusks) or in a broader sense, any protective casing.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Sr.", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "sr_", "book_id": "english_physician_1652", "name": "Sr.", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Sr."], "contexts": ["salutation to a correspondent"]}, {"entity_id": "mr_", "book_id": "origin_of_species_darwin_1859", "name": "Mr.", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Mr."], "contexts": ["informant about bat observations"]}, {"entity_id": "sr__hou^", "book_id": "coloquios_da_orta_1563", "name": "sr. Hou^", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["sr. Hou^"], "contexts": ["owner of a famous mango tree"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Sr.", "target_book": "origin_of_species_darwin_1859", "target_name": "Mr.", "similarity": 0.95}, {"source_book": "english_physician_1652", "source_name": "Sr.", "target_book": "coloquios_da_orta_1563", "target_name": "sr. Hou^", "similarity": 0.843}], "id": 2029, "stable_key": "clu_a06539b2bc097c50", "ground_truth": {"modern_name": "Sir", "confidence": "medium", "type": "concept", "note": "The presence of 'Sr.' and 'sr. Hou^' suggests an honorific title, though the 'Hou^' might refer to a specific person or entity. 'Sir' is the most general modern equivalent."}}, {"canonical_name": "ribs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "ribs", "book_id": "origin_of_species_darwin_1859", "name": "ribs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["ribs"], "contexts": ["bones protecting the chest cavity"]}, {"entity_id": "ribs", "book_id": "principles_of_psychology_james_1890", "name": "ribs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["ribs"], "contexts": ["bones protecting the chest"]}, {"entity_id": "ribs", "book_id": "first_principles_spencer_1862", "name": "ribs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["ribs"], "contexts": ["bones forming the rib cage"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "ribs", "target_book": "principles_of_psychology_james_1890", "target_name": "ribs", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "ribs", "target_book": "first_principles_spencer_1862", "target_name": "ribs", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "ribs", "target_book": "first_principles_spencer_1862", "target_name": "ribs", "similarity": 1.0}], "id": 2030, "stable_key": "clu_361138602d74b5b0", "ground_truth": {"modern_name": "Ribs", "confidence": "high", "type": "object", "note": "Refers to the bony structures forming the rib cage, protecting internal organs.", "wikidata_id": "Q2576226", "wikidata_description": "arrangement of bones", "wikipedia_url": "https://en.wikipedia.org/wiki/Rib%20cage", "wikipedia_extract": "The rib cage or thoracic cage is an endoskeletal enclosure in the thorax of most vertebrates that comprises the ribs, vertebral column and sternum, which protect the vital organs of the thoracic cavity, such as the heart, lungs and great vessels and support the shoulder girdle to form the core part of the axial skeleton. A typical human thoracic cage consists of 12 pairs of ribs and the adjoining costal cartilages, the sternum (along with the manubrium and xiphoid process), and the 12 thoracic vertebrae articulating with the ribs. The thoracic cage also provides attachments for extrinsic skeletal muscles of the neck, upper limbs, upper abdomen and back, and together with the overlying skin and associated fascia and muscles, makes up the thoracic wall. In tetrapods, the rib cage intrinsically holds the muscles of respiration (diaphragm, intercostal muscles, etc.) that are crucial for active inhalation and forced exhalation, and therefore has a major ventilatory function in the respiratory system. There are thirty-three vertebrae in the human vertebral column. The rib cage is associated with TH1\u2212TH12."}}, {"canonical_name": "Europeans", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "europeans", "book_id": "origin_of_species_darwin_1859", "name": "Europeans", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Europeans"], "contexts": ["people from Europe"]}, {"entity_id": "euroji\u00e9ens", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Euroji\u00e9ens", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Euroji\u00e9ens"], "contexts": ["Europeans who have frequented the area"]}, {"entity_id": "europeans", "book_id": "kosmos_humboldt_1845", "name": "Europeans", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Europeans"], "contexts": ["group studied for brain research"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Europeans", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Euroji\u00e9ens", "similarity": 0.896}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Europeans", "target_book": "kosmos_humboldt_1845", "target_name": "Europeans", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Euroji\u00e9ens", "target_book": "kosmos_humboldt_1845", "target_name": "Europeans", "similarity": 0.896}], "id": 2031, "stable_key": "clu_31552a21c004ebcf", "ground_truth": {"modern_name": "Europeans", "confidence": "high", "type": "person", "description": "People originating from or residing in the continent of Europe."}}, {"canonical_name": "carnivorous mammals", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "carnivorous_mammals", "book_id": "origin_of_species_darwin_1859", "name": "carnivorous mammals", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["carnivorous mammals"], "contexts": ["meat-eating mammals"]}, {"entity_id": "carnivora", "book_id": "principles_of_psychology_james_1890", "name": "carnivora", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["carnivora"], "contexts": ["animals with more brain localization"]}, {"entity_id": "carnivora", "book_id": "first_principles_spencer_1862", "name": "carnivora", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["carnivora"], "contexts": ["mammals that eat meat"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "carnivorous mammals", "target_book": "principles_of_psychology_james_1890", "target_name": "carnivora", "similarity": 0.912}, {"source_book": "origin_of_species_darwin_1859", "source_name": "carnivorous mammals", "target_book": "first_principles_spencer_1862", "target_name": "carnivora", "similarity": 0.912}, {"source_book": "principles_of_psychology_james_1890", "source_name": "carnivora", "target_book": "first_principles_spencer_1862", "target_name": "carnivora", "similarity": 1.0}], "id": 2032, "stable_key": "clu_10e5d138adb62473", "ground_truth": {"modern_name": "carnivorans", "confidence": "high", "type": "animal", "wikidata_id": "Q81875", "wikidata_description": "organism that eats mostly or exclusively animal tissue", "wikipedia_url": "https://en.wikipedia.org/wiki/Carnivore", "wikipedia_extract": "A carnivore , or meat-eater (Latin, caro, genitive carnis, meaning meat or flesh and vorare meaning \"to devour\"), is an animal or plant whose nutrition and energy requirements are met by consumption of animal tissues (mainly muscle, fat and other soft tissues) as food, whether through predation or scavenging. The technical term for mammals in the order Carnivora is carnivoran, and they are so-named because most member species in the group have a carnivorous diet, but the similarity of the name of the order and the name of the diet causes confusion. Many but not all carnivorans are meat eaters; a few, such as the large and small cats (Felidae) are obligate carnivores whose diet requires nutrients found only in animal flesh. Other classes of carnivore are highly variable. The ursids (bears), for example: while the Arctic polar bear eats meat almost exclusively (more than 90% of its diet is meat), almost all other bear species are omnivorous, and one species, the giant panda, is nearly exclusively herbivorous. Dietary carnivory is not a distinguishing trait of the order."}}, {"canonical_name": "cultivation", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "cultivation", "book_id": "origin_of_species_darwin_1859", "name": "cultivation", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["cultivation"], "contexts": ["process of growing plants"]}, {"entity_id": "cultivation", "book_id": "kosmos_humboldt_1845", "name": "cultivation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cultivation"], "contexts": ["moral and intellectual cultivation"]}, {"entity_id": "cultivada", "book_id": "coloquios_da_orta_1563", "name": "cultivada", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cultivada"], "contexts": ["state of being farmed, cultivated"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "cultivation", "target_book": "kosmos_humboldt_1845", "target_name": "cultivation", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "cultivation", "target_book": "coloquios_da_orta_1563", "target_name": "cultivada", "similarity": 0.906}, {"source_book": "kosmos_humboldt_1845", "source_name": "cultivation", "target_book": "coloquios_da_orta_1563", "target_name": "cultivada", "similarity": 0.906}], "id": 2033, "stable_key": "clu_f9eaab3f933ce572", "ground_truth": {"modern_name": "cultivation", "confidence": "high", "type": "concept", "wikidata_id": "Q357279", "wikidata_description": "creation and maintenance of conditions that ensure the growth of certain organisms"}}, {"canonical_name": "trachea", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "trachea", "book_id": "origin_of_species_darwin_1859", "name": "trachea", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["trachea"], "contexts": ["windpipe for breathing"]}, {"entity_id": "trachea", "book_id": "kosmos_humboldt_1845", "name": "trachea", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["trachea"], "contexts": ["windpipe containing bony rings"]}, {"entity_id": "trachea", "book_id": "polyanthea_medicinal", "name": "Trachea", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Trachea"], "contexts": ["part of the respiratory system"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "trachea", "target_book": "kosmos_humboldt_1845", "target_name": "trachea", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "trachea", "target_book": "polyanthea_medicinal", "target_name": "Trachea", "similarity": 0.991}, {"source_book": "kosmos_humboldt_1845", "source_name": "trachea", "target_book": "polyanthea_medicinal", "target_name": "Trachea", "similarity": 0.991}], "id": 2034, "stable_key": "clu_0cc04120d599bee1", "ground_truth": {"modern_name": "trachea", "confidence": "high", "type": "concept", "wikidata_id": "Q2136371", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Trachea%20%28moth%29", "wikipedia_extract": "Trachea is a genus of moths of the family Noctuidae erected by Ferdinand Ochsenheimer in 1816. Pitkin, Brian & Jenkins, Paul. \"Search results Family: Noctuidae\". Butterflies and Moths of the World. Natural History Museum, London. Savela, Markku."}}, {"canonical_name": "habits of life", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "habits_of_life", "book_id": "origin_of_species_darwin_1859", "name": "habits of life", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["habits of life"], "contexts": ["organism's behavior"]}, {"entity_id": "human_habits", "book_id": "principles_of_psychology_james_1890", "name": "human habits", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human habits"], "contexts": ["learned behavioral patterns"]}, {"entity_id": "habits_of_life", "book_id": "first_principles_spencer_1862", "name": "habits of life", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["habits of life"], "contexts": ["repeated behaviors"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "habits of life", "target_book": "principles_of_psychology_james_1890", "target_name": "human habits", "similarity": 0.892}, {"source_book": "origin_of_species_darwin_1859", "source_name": "habits of life", "target_book": "first_principles_spencer_1862", "target_name": "habits of life", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "human habits", "target_book": "first_principles_spencer_1862", "target_name": "habits of life", "similarity": 0.892}], "id": 2035, "stable_key": "clu_c8a62cedb3cb68be", "ground_truth": {"modern_name": "Habits", "confidence": "high", "type": "concept", "note": "Refers to learned behaviors and ingrained patterns of action, both in animals and humans.", "wikidata_id": "Q52105", "wikidata_description": "ecological or environmental area inhabited by a particular species; natural environment in which an organism lives, or the physical environment that surrounds a species population"}}, {"canonical_name": "Invertebrata", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "invertebrata", "book_id": "origin_of_species_darwin_1859", "name": "Invertebrata", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Invertebrata"], "contexts": ["group of animals"]}, {"entity_id": "invertebrata", "book_id": "kosmos_humboldt_1845", "name": "invertebrata", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["invertebrata"], "contexts": ["animals without a backbone"]}, {"entity_id": "invertebrate", "book_id": "first_principles_spencer_1862", "name": "invertebrate", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["invertebrate"], "contexts": ["classification of animals"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Invertebrata", "target_book": "kosmos_humboldt_1845", "target_name": "invertebrata", "similarity": 0.962}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Invertebrata", "target_book": "first_principles_spencer_1862", "target_name": "invertebrate", "similarity": 0.934}, {"source_book": "kosmos_humboldt_1845", "source_name": "invertebrata", "target_book": "first_principles_spencer_1862", "target_name": "invertebrate", "similarity": 0.976}], "id": 2036, "stable_key": "clu_d4075e059dd99690", "ground_truth": {"modern_name": "Invertebrates", "confidence": "high", "type": "animal", "wikidata_id": "Q43806", "wikidata_description": "animal without a vertebral column", "wikipedia_url": "https://en.wikipedia.org/wiki/Invertebrate", "wikipedia_extract": "Invertebrates are animals that neither develop nor retain a vertebral column (commonly known as a spine or backbone), which evolved from the notochord. It is a paraphyletic grouping including all animals excluding the chordate subphylum Vertebrata, i.e. vertebrates. Well-known phyla of invertebrates include arthropods, molluscs, annelids, echinoderms, flatworms, cnidarians, and sponges. The majority of animal species are invertebrates; one estimate puts the figure at 97%. Many invertebrate taxa have a greater number and diversity of species than the entire subphylum of Vertebrata."}}, {"canonical_name": "Northern Italy", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "northern_italy", "book_id": "origin_of_species_darwin_1859", "name": "Northern Italy", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Northern Italy"], "contexts": ["location of gigantic moraines from glaciers"]}, {"entity_id": "northern_italy", "book_id": "kosmos_humboldt_1845", "name": "Northern Italy", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Northern Italy"], "contexts": ["region containing Sassuolo"]}, {"entity_id": "northern_italy", "book_id": "connexion_physical_sciences_somerville_1858", "name": "northern Italy", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["northern Italy"], "contexts": ["location of anomaly"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Northern Italy", "target_book": "kosmos_humboldt_1845", "target_name": "Northern Italy", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Northern Italy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "northern Italy", "similarity": 0.968}, {"source_book": "kosmos_humboldt_1845", "source_name": "Northern Italy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "northern Italy", "similarity": 0.968}], "id": 2037, "stable_key": "clu_6ccf6106ff3e3a0c", "ground_truth": {"modern_name": "Northern Italy", "confidence": "high", "type": "place", "country": "Italy", "wikidata_id": "Q4345530", "wikidata_description": "geographic region of Italy", "wikipedia_url": "https://en.wikipedia.org/wiki/Northern%20Italy", "wikipedia_extract": "Northern Italy (Italian: Italia Settentrionale, Nord Italia, Alta Italia) is a geographical and cultural region in the northern part of Italy. The Italian National Institute of Statistics defines the region as encompassing the four northwestern regions of Piedmont, Aosta Valley, Liguria and Lombardy in addition to the four northeastern regions of Trentino-Alto Adige/S\u00fcdtirol, Veneto, Friuli-Venezia Giulia and Emilia-Romagna. With a population of 27.5 million in an area of 120,312.72 km2 (46,453.00 mi2) as of 2025, the region covers roughly 40% of Italy and contains 46% of its population. Two of Italy's largest metropolitan areas, Milan and Turin, are located in the region. Northern Italy's GDP was estimated at \u20ac1 trillion in 2021, accounting for 56.5% of the Italian economy. Northern Italy has a rich and distinct culture."}}, {"canonical_name": "transport", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "transport", "book_id": "origin_of_species_darwin_1859", "name": "transport", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["transport"], "contexts": ["means of moving organisms"]}, {"entity_id": "transport", "book_id": "relation_historique_humboldt_vol3_1825", "name": "transport", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["transport"], "contexts": ["movement of goods"]}, {"entity_id": "transport", "book_id": "first_principles_spencer_1862", "name": "transport", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["transport"], "contexts": ["movement of goods and people"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "transport", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "transport", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "transport", "target_book": "first_principles_spencer_1862", "target_name": "transport", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "transport", "target_book": "first_principles_spencer_1862", "target_name": "transport", "similarity": 1.0}], "id": 2038, "stable_key": "clu_6f1230fbc0986596", "ground_truth": {"modern_name": "transport", "confidence": "high", "type": "concept", "wikidata_id": "Q1435575", "wikidata_description": "directed movement of substances or cellular components into, out of or within a cell, or between cells, or within a multicellular organism by means of an agent"}}, {"canonical_name": "mandibles", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "mandibles", "book_id": "origin_of_species_darwin_1859", "name": "mandibles", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["mandibles"], "contexts": ["mouthparts of an insect"]}, {"entity_id": "mandibles", "book_id": "kosmos_humboldt_1845", "name": "mandibles", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["mandibles"], "contexts": ["part of bird skeletons"]}, {"entity_id": "mandibulis", "book_id": "polyanthea_medicinal", "name": "mandibulis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["mandibulis"], "contexts": ["jaws"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "mandibles", "target_book": "kosmos_humboldt_1845", "target_name": "mandibles", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mandibles", "target_book": "polyanthea_medicinal", "target_name": "mandibulis", "similarity": 0.91}, {"source_book": "kosmos_humboldt_1845", "source_name": "mandibles", "target_book": "polyanthea_medicinal", "target_name": "mandibulis", "similarity": 0.91}], "id": 2039, "stable_key": "clu_3848789eb2f881d0", "ground_truth": {"modern_name": "mandibles", "confidence": "high", "type": "object", "note": "The term 'mandibles' in early modern texts can refer to insect mouthparts, bird beaks, or the jaws of other animals. In the context of Darwin and Humboldt, it most likely refers to the mouthparts of insects."}}, {"canonical_name": "cellular tissue", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "cellular_tissue", "book_id": "origin_of_species_darwin_1859", "name": "cellular tissue", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["cellular tissue"], "contexts": ["tissue composed of cells"]}, {"entity_id": "cellular_bodies", "book_id": "principles_of_psychology_james_1890", "name": "cellular bodies", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["cellular bodies"], "contexts": ["nerve cells"]}, {"entity_id": "cellular_tissues", "book_id": "kosmos_humboldt_1845", "name": "cellular tissues", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["cellular tissues"], "contexts": ["basic structural units of plants and animals"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "cellular tissue", "target_book": "principles_of_psychology_james_1890", "target_name": "cellular bodies", "similarity": 0.93}, {"source_book": "origin_of_species_darwin_1859", "source_name": "cellular tissue", "target_book": "kosmos_humboldt_1845", "target_name": "cellular tissues", "similarity": 0.99}, {"source_book": "principles_of_psychology_james_1890", "source_name": "cellular bodies", "target_book": "kosmos_humboldt_1845", "target_name": "cellular tissues", "similarity": 0.95}], "id": 2040, "stable_key": "clu_b579c71c9bca0636", "ground_truth": {"modern_name": "Cellular tissue", "confidence": "high", "type": "concept", "wikidata_id": "Q48177311", "wikidata_description": "scientific article"}}, {"canonical_name": "human intellect", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "human_intellect", "book_id": "origin_of_species_darwin_1859", "name": "human intellect", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human intellect"], "contexts": ["capacity for understanding and reasoning"]}, {"entity_id": "human_intellect", "book_id": "kosmos_humboldt_1845", "name": "human intellect", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human intellect"], "contexts": ["faculty for understanding natural phenomena"]}, {"entity_id": "human_intellect", "book_id": "first_principles_spencer_1862", "name": "human intellect", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human intellect"], "contexts": ["capacity for thought and understanding"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "human intellect", "target_book": "kosmos_humboldt_1845", "target_name": "human intellect", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "human intellect", "target_book": "first_principles_spencer_1862", "target_name": "human intellect", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "human intellect", "target_book": "first_principles_spencer_1862", "target_name": "human intellect", "similarity": 1.0}], "id": 2041, "stable_key": "clu_ec1607f800ff86e4", "ground_truth": {"modern_name": "Human intellect", "confidence": "high", "type": "concept", "wikidata_id": "Q111807027", "wikidata_description": "narrative motif documented in Thompson's Motif-Index of Folk-Literature"}}, {"canonical_name": "Bamboo", "category": "PLANT", "subcategory": "TREE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "bamboo", "book_id": "origin_of_species_darwin_1859", "name": "Bamboo", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Bamboo"], "contexts": ["with hooks"]}, {"entity_id": "bamboo", "book_id": "principles_of_psychology_james_1890", "name": "bamboo", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["bamboo"], "contexts": ["plant with hollow stems"]}, {"entity_id": "bamboo", "book_id": "connexion_physical_sciences_somerville_1858", "name": "bamboo", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["bamboo"], "contexts": ["tall, woody grass"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Bamboo", "target_book": "principles_of_psychology_james_1890", "target_name": "bamboo", "similarity": 0.984}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Bamboo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "bamboo", "similarity": 0.984}, {"source_book": "principles_of_psychology_james_1890", "source_name": "bamboo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "bamboo", "similarity": 1.0}], "id": 2042, "stable_key": "clu_1f53217dd0179861", "ground_truth": {"modern_name": "Bamboo", "confidence": "high", "type": "plant", "linnaean": "Bambuseae", "family": "Poaceae", "note": "Bambusa is a tribe, not a genus, but commonly used for bamboo in older texts.", "wikidata_id": "Q670887", "wikidata_description": "subfamily of plants"}}, {"canonical_name": "Vulture", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "vulture", "book_id": "origin_of_species_darwin_1859", "name": "Vulture", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Vulture"], "contexts": ["naked skin on head"]}, {"entity_id": "vulture", "book_id": "kosmos_humboldt_1845", "name": "vulture", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["vulture"], "contexts": ["animal previously thought to be dodo"]}, {"entity_id": "vulture", "book_id": "connexion_physical_sciences_somerville_1858", "name": "vulture", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["vulture"], "contexts": ["bird that spots prey from afar"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Vulture", "target_book": "kosmos_humboldt_1845", "target_name": "vulture", "similarity": 0.902}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Vulture", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "vulture", "similarity": 0.902}, {"source_book": "kosmos_humboldt_1845", "source_name": "vulture", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "vulture", "similarity": 1.0}], "id": 2043, "stable_key": "clu_9fe730e29bb97e5c", "ground_truth": {"modern_name": "Vulture", "confidence": "high", "type": "animal", "note": "The mention of 'bearded vulture' and 'confined to the Alps' suggests Gyps fulvus or Gypaetus barbatus, but 'Vulture' generally refers to the family Accipitridae or Cathartidae.", "wikidata_id": "Q123120", "wikidata_description": "common name for several types of scavenging birds of prey", "wikipedia_extract": "Old World vultures are vultures that are found in the Old World, i.e. the continents of Europe, Asia and Africa, and which belong to the family Accipitridae, which also includes eagles, buzzards, kites, and hawks. Old World vultures are not closely related to the superficially similar New World vultures and condors, and do not share that group's good sense of smell. The similarities between the two groups of vultures are due to convergent evolution, rather than a close relationship. They were widespread in both the Old World and North America during the Neogene. Old World vultures are probably a polyphyletic group within Accipitridae, belonging to two separate not closely related groups within the family.", "wikipedia_url": "https://en.wikipedia.org/wiki/Vulture"}}, {"canonical_name": "salvia", "category": "PLANT", "subcategory": "HERB", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "salvia", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "salvia", "category": "PLANT", "subcategory": "HERB", "count": 1, "variants": ["salvia"], "contexts": ["sage, herb"]}, {"entity_id": "salvia", "book_id": "ricettario_fiorentino_1597", "name": "salvia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["salvia"], "contexts": ["sage, herb used in conserves"]}, {"entity_id": "salvia", "book_id": "polyanthea_medicinal", "name": "salvia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["salvia"], "contexts": ["herb used in decoctions"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "salvia", "target_book": "ricettario_fiorentino_1597", "target_name": "salvia", "similarity": 0.905}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "salvia", "target_book": "polyanthea_medicinal", "target_name": "salvia", "similarity": 0.905}, {"source_book": "ricettario_fiorentino_1597", "source_name": "salvia", "target_book": "polyanthea_medicinal", "target_name": "salvia", "similarity": 1.0}], "id": 2044, "stable_key": "clu_fd208aff7ea17b85", "ground_truth": {"modern_name": "Sage", "confidence": "high", "type": "plant", "linnaean": "Salvia officinalis Linnaeus", "family": "Lamiaceae"}}, {"canonical_name": "enfermedades de los ojos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "enfermedades_de_los_ojos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "enfermedades de los ojos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["enfermedades de los ojos"], "contexts": ["diseases of the eyes"]}, {"entity_id": "disorder_of_the_eyes", "book_id": "principles_of_psychology_james_1890", "name": "disorder of the eyes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["disorder of the eyes"], "contexts": ["medical condition affecting vision"]}, {"entity_id": "indisposizioni_degli_occhi", "book_id": "ricettario_fiorentino_1597", "name": "indisposizioni degli occhi", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["indisposizioni degli occhi"], "contexts": ["eye ailments"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "enfermedades de los ojos", "target_book": "principles_of_psychology_james_1890", "target_name": "disorder of the eyes", "similarity": 0.955}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "enfermedades de los ojos", "target_book": "ricettario_fiorentino_1597", "target_name": "indisposizioni degli occhi", "similarity": 0.919}, {"source_book": "principles_of_psychology_james_1890", "source_name": "disorder of the eyes", "target_book": "ricettario_fiorentino_1597", "target_name": "indisposizioni degli occhi", "similarity": 0.943}], "id": 2045, "stable_key": "clu_7b20cacdd2f188bb", "ground_truth": {"modern_name": "Eye diseases", "confidence": "high", "type": "disease", "modern_term": "Ophthalmopathy", "wikidata_id": "Q3041498", "wikidata_description": "health condition negatively affecting the eye", "wikipedia_url": "https://en.wikipedia.org/wiki/Eye%20disease"}}, {"canonical_name": "tos", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "tos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "tos", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["tos"], "contexts": ["cough"]}, {"entity_id": "tos", "book_id": "historia_medicinal_monardes_1574", "name": "Tos", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["Tos"], "contexts": ["cough, a symptom"]}, {"entity_id": "cough", "book_id": "first_principles_spencer_1862", "name": "cough", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["cough"], "contexts": ["sudden expulsion of air from lungs"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "tos", "target_book": "historia_medicinal_monardes_1574", "target_name": "Tos", "similarity": 0.986}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "tos", "target_book": "first_principles_spencer_1862", "target_name": "cough", "similarity": 0.884}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Tos", "target_book": "first_principles_spencer_1862", "target_name": "cough", "similarity": 0.885}], "id": 2046, "stable_key": "clu_b22d07fb0c66ae0c", "ground_truth": {"modern_name": "Cough", "confidence": "high", "type": "disease", "modern_term": "Cough", "wikidata_id": "Q35805", "wikidata_description": "medical symptom, reflex to clear large breathing passages", "wikipedia_extract": "A cough is a sudden expulsion of air through the large breathing passages which can help clear them of fluids, irritants, foreign particles and microbes. As a protective reflex, coughing can be repetitive with the cough reflex following three phases: an inhalation, a forced exhalation against a closed glottis, and a violent release of air from the lungs following opening of the glottis, usually accompanied by a distinctive sound. Coughing into one's elbow or toward the ground\u2014rather than forward at breathing height\u2014can reduce the spread of infectious droplets in the air. Frequent coughing usually indicates the presence of a disease. Many viruses and bacteria benefit, from an evolutionary perspective, by causing the host to cough, which helps to spread the disease to new hosts. Irregular coughing is usually caused by a respiratory tract infection but can also be triggered by choking, smoking, air pollution, asthma, gastroesophageal reflux disease, post-nasal drip, chronic bronchitis, lung tumors, heart failure and medications such as angiotensin-converting-enzyme inhibitors (ACE inhibitors) and beta blockers.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cough"}}, {"canonical_name": "trabaxo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "trabaxo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "trabaxo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["trabaxo"], "contexts": ["effort or hardship"]}, {"entity_id": "travail", "book_id": "relation_historique_humboldt_vol3_1825", "name": "travail", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["travail"], "contexts": ["effort exerted for a purpose"]}, {"entity_id": "travail", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Travail", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Travail"], "contexts": ["French term for work done in mechanics"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "trabaxo", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "travail", "similarity": 0.922}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "trabaxo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Travail", "similarity": 0.912}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "travail", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Travail", "similarity": 0.91}], "id": 2047, "stable_key": "clu_ec81724f10ab206d-2", "ground_truth": {"modern_name": "effort", "confidence": "high", "type": "concept", "wikidata_id": "Q510236", "wikidata_description": "psychopathological term to denote a condition with symptoms of fatigue, anxiety, headache, heart palpitations, high blood pressure, neuralgia, and depressed mood", "wikipedia_url": "https://en.wikipedia.org/wiki/Neurasthenia", "wikipedia_extract": "Neurasthenia (from Ancient Greek  \u03bd\u03b5\u1fe6\u03c1\u03bf\u03bd (neuron) 'nerve' and \u1f00\u03c3\u03b8\u03b5\u03bd\u03ae\u03c2 (asthen\u00e9s) 'weak') is a term that was first used as early as 1829 for a mechanical weakness of the nerves. It became a major diagnosis in North America during the late nineteenth and early twentieth centuries after neurologist George Miller Beard reintroduced the concept in 1869. As a psychopathological term, the first to publish on neurasthenia was Michigan alienist E. H. Van Deusen of the Kalamazoo asylum in 1869. Also in 1868, New York neurologist George Beard used the term in an article published in the Boston Medical and Surgical Journal to denote a condition with symptoms of fatigue, anxiety, headache, heart palpitations, high blood pressure, neuralgia, and depressed mood."}}, {"canonical_name": "vista", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "vista", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "vista", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["vista"], "contexts": ["sight"]}, {"entity_id": "sights", "book_id": "principles_of_psychology_james_1890", "name": "sights", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["sights"], "contexts": ["visual sensations"]}, {"entity_id": "sight", "book_id": "first_principles_spencer_1862", "name": "sight", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["sight"], "contexts": ["sense of vision"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "vista", "target_book": "first_principles_spencer_1862", "target_name": "sight", "similarity": 0.947}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sights", "target_book": "first_principles_spencer_1862", "target_name": "sight", "similarity": 0.919}], "id": 2048, "stable_key": "clu_93fd7b067b6fa7b1", "ground_truth": {"modern_name": "sight", "confidence": "high", "type": "concept", "wikidata_id": "Q52266213", "wikidata_description": "occurrence where a region of land is spotted from a ship"}}, {"canonical_name": "sacerdote", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "sacerdote", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "sacerdote", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["sacerdote"], "contexts": ["priest"]}, {"entity_id": "sacerdotes", "book_id": "historia_medicinal_monardes_1574", "name": "Sacerdotes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Sacerdotes"], "contexts": ["indigenous priests"]}, {"entity_id": "sacerdote_abexim", "book_id": "coloquios_da_orta_1563", "name": "sacerdote abexim", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["sacerdote abexim"], "contexts": ["source of information about Bedoins"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "sacerdote", "target_book": "historia_medicinal_monardes_1574", "target_name": "Sacerdotes", "similarity": 0.893}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "sacerdote", "target_book": "coloquios_da_orta_1563", "target_name": "sacerdote abexim", "similarity": 0.906}], "id": 2049, "stable_key": "clu_21a446132d3bc970", "ground_truth": {"modern_name": "Priest", "confidence": "high", "type": "person", "description": "Religious official, often a source of knowledge or authority", "wikidata_id": "Q42603", "wikidata_description": "person who consecrates his life to some divinity and whose main functions are to direct religious rites and offer sacrifices to the divinity (for a minister use Q1423891)", "wikipedia_url": "https://en.wikipedia.org/wiki/Priest"}}, {"canonical_name": "ignorancia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "ignorancia", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "ignorancia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ignorancia"], "contexts": ["ignorance"]}, {"entity_id": "ignor\u00e2ncia", "book_id": "coloquios_da_orta_1563", "name": "ignor\u00e2ncia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ignor\u00e2ncia"], "contexts": ["reason for applying European rules to the East"]}, {"entity_id": "ignorancia", "book_id": "polyanthea_medicinal", "name": "ignorancia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ignorancia"], "contexts": ["lack of knowledge"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ignorancia", "target_book": "coloquios_da_orta_1563", "target_name": "ignor\u00e2ncia", "similarity": 0.975}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ignorancia", "target_book": "polyanthea_medicinal", "target_name": "ignorancia", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "ignor\u00e2ncia", "target_book": "polyanthea_medicinal", "target_name": "ignorancia", "similarity": 0.975}], "id": 2050, "stable_key": "clu_7cd581f03e6929ef-2", "ground_truth": {"modern_name": "Ignorance", "confidence": "high", "type": "concept", "description": "A lack of knowledge, understanding, or information.", "wikipedia_extract": "Ignorance is a lack of knowledge, information and understanding. Deliberate ignorance is a culturally-induced phenomenon, the study of which is called agnotology. The word \"ignorant\" is an adjective that describes a person in the state of being unaware, or even cognitive dissonance and other cognitive relation, and can describe individuals who are unaware of important information or facts. Ignorance can appear in three different types: factual ignorance (absence of knowledge of some fact), object ignorance (unacquaintance with some object), and technical ignorance (absence of knowledge of how to do something). Ignorance can have negative effects on individuals and societies, but can also benefit them by creating within them the desire to know more. For example, ignorance within science opens the opportunity to seek knowledge and make discoveries by asking new questions."}}, {"canonical_name": "laguna", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "laguna", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "laguna", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["laguna"], "contexts": ["lagoon"]}, {"entity_id": "laguna", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Laguna", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Laguna"], "contexts": ["lagoon"]}, {"entity_id": "laguna", "book_id": "historia_medicinal_monardes_1574", "name": "laguna", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["laguna"], "contexts": ["place that was a useless lagoon"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "laguna", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Laguna", "similarity": 0.933}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "laguna", "target_book": "historia_medicinal_monardes_1574", "target_name": "laguna", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Laguna", "target_book": "historia_medicinal_monardes_1574", "target_name": "laguna", "similarity": 0.933}], "id": 2051, "stable_key": "clu_a370c3745bfa9f4f", "ground_truth": {"modern_name": "lagoon", "confidence": "high", "type": "place", "country": "uncertain", "note": "The term 'laguna' can refer to a geographical feature (a lagoon) or potentially a place name. Without more context, 'lagoon' is the most direct interpretation."}}, {"canonical_name": "ph\u00e9nom\u00e8nes c\u00e9lestes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "ph\u00e9nom\u00e8nes_c\u00e9lestes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "ph\u00e9nom\u00e8nes c\u00e9lestes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ph\u00e9nom\u00e8nes c\u00e9lestes"], "contexts": ["used for absolute determination"]}, {"entity_id": "celestial_phenomena", "book_id": "kosmos_humboldt_1845", "name": "celestial phenomena", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["celestial phenomena"], "contexts": ["observable events in the sky"]}, {"entity_id": "astronomical_phenomena", "book_id": "connexion_physical_sciences_somerville_1858", "name": "astronomical phenomena", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["astronomical phenomena"], "contexts": ["events related to celestial bodies"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "ph\u00e9nom\u00e8nes c\u00e9lestes", "target_book": "kosmos_humboldt_1845", "target_name": "celestial phenomena", "similarity": 0.949}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "ph\u00e9nom\u00e8nes c\u00e9lestes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "astronomical phenomena", "similarity": 0.881}, {"source_book": "kosmos_humboldt_1845", "source_name": "celestial phenomena", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "astronomical phenomena", "similarity": 0.943}], "id": 2052, "stable_key": "clu_ff5d95e6a8d24171", "ground_truth": {"modern_name": "celestial phenomena", "confidence": "high", "type": "concept"}}, {"canonical_name": "Davy", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "davy", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Davy", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Davy"], "contexts": ["scholar who experimented on soil fertility"]}, {"entity_id": "davy", "book_id": "kosmos_humboldt_1845", "name": "Davy", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Davy"], "contexts": ["author of 'Consolation in Travel'"]}, {"entity_id": "davy", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Davy", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Davy"], "contexts": ["pioneered photographic pictures"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Davy", "target_book": "kosmos_humboldt_1845", "target_name": "Davy", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Davy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Davy", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Davy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Davy", "similarity": 1.0}], "id": 2053, "stable_key": "clu_5026748bdb62d20f", "ground_truth": {"modern_name": "Humphry Davy", "confidence": "high", "type": "person", "birth_year": 1778, "death_year": 1829, "description": "Chemist and inventor, pioneer in electrochemistry and photography.", "wikidata_id": "Q5941768", "wikidata_description": "British baronet and physician (1862\u20131944)", "wikipedia_url": "https://en.wikipedia.org/wiki/Humphry%20Rolleston", "wikipedia_extract": "Sir Humphry Davy Rolleston, 1st Baronet,  (21 June 1862 \u2013 23 September 1944) was a prominent English physician. Rolleston was the son of George Rolleston (Linacre Professor of Physiology at Oxford) and Grace Davy, daughter of John Davy and niece of Sir Humphry Davy, Bt (chemist). He was educated at Marlborough College, proceeded to St John's College, Cambridge and graduated in Natural Sciences in 1886. After clinical training at St Bartholomew's Hospital, London he qualified MB (Cambridge) in 1888 and MD in 1892. In 1891 he became Physician at St George's Hospital, Hyde Park Corner, London and continued there until 1919. This period, however, was interrupted by his service during the Second Boer War, where he served with the Imperial Yeomanry Hospital, Pretoria."}}, {"canonical_name": "for\u00eat", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "for\u00eat", "book_id": "relation_historique_humboldt_vol3_1825", "name": "for\u00eat", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["for\u00eat"], "contexts": ["dense vegetation"]}, {"entity_id": "forest", "book_id": "principles_of_psychology_james_1890", "name": "forest", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["forest"], "contexts": ["area covered with trees"]}, {"entity_id": "floresta", "book_id": "coloquios_da_orta_1563", "name": "floresta", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["floresta"], "contexts": ["natural habitat"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "for\u00eat", "target_book": "principles_of_psychology_james_1890", "target_name": "forest", "similarity": 0.968}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "for\u00eat", "target_book": "coloquios_da_orta_1563", "target_name": "floresta", "similarity": 0.956}, {"source_book": "principles_of_psychology_james_1890", "source_name": "forest", "target_book": "coloquios_da_orta_1563", "target_name": "floresta", "similarity": 0.958}], "id": 2054, "stable_key": "clu_f7bf8b5791a60bd3-2", "ground_truth": {"modern_name": "Forest", "confidence": "high", "type": "place", "note": "The term 'forests' is general and not specific to a particular geographical location.", "wikidata_id": "Q4421", "wikidata_description": "dense collection of trees covering a relatively large area", "wikipedia_url": "https://en.wikipedia.org/wiki/Forest", "wikipedia_extract": "A forest is an ecosystem characterized by a dense community of trees. Hundreds of definitions of forest are used throughout the world, incorporating factors such as tree density, tree height, land use, legal standing, and ecological function. The United Nations' Food and Agriculture Organization (FAO) defines a forest as, \"Land spanning more than 0.5 hectares with trees higher than 5 meters and a canopy cover of more than 10 percent, or trees able to reach these thresholds in situ. It does not include land that is predominantly under agricultural or urban use.\" Using this definition, Global Forest Resources Assessment 2020 found that forests covered 4.06 billion hectares (10.0 billion acres; 40.6 million square kilometres; 15.7 million square miles), or approximately 31 percent of the world's land area in 2020. Forests are the largest terrestrial ecosystems of Earth by area, and are found around the globe. 45 percent of forest land is in the tropical latitudes."}}, {"canonical_name": "\u00eeles Kuriles", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "\u00eeles_kuriles", "book_id": "relation_historique_humboldt_vol3_1825", "name": "\u00eeles Kuriles", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["\u00eeles Kuriles"], "contexts": ["island chain"]}, {"entity_id": "kurile_islands", "book_id": "kosmos_humboldt_1845", "name": "Kurile Islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Kurile Islands"], "contexts": ["islands with volcanic eruptions"]}, {"entity_id": "kurile_islands", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Kurile Islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Kurile Islands"], "contexts": ["islands between Japan and Russia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "\u00eeles Kuriles", "target_book": "kosmos_humboldt_1845", "target_name": "Kurile Islands", "similarity": 0.953}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "\u00eeles Kuriles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kurile Islands", "similarity": 0.953}, {"source_book": "kosmos_humboldt_1845", "source_name": "Kurile Islands", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kurile Islands", "similarity": 1.0}], "id": 2055, "stable_key": "clu_e157321386eb9d53", "ground_truth": {"modern_name": "Kurile Islands", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q80389", "wikidata_description": "island chain located in Northeast Asia administered by Russia", "wikipedia_url": "https://en.wikipedia.org/wiki/Kuril_Islands", "wikipedia_extract": "The Kuril Islands or Kurile Islands are a volcanic archipelago administered as part of Sakhalin Oblast in the Russian Far East. The islands stretch approximately 1,300 km (810 mi) northeast from Hokkaido in Japan to Kamchatka Peninsula in Russia, separating the Sea of Okhotsk from the north Pacific Ocean. There are 56 islands and many minor islets. The Kuril Islands consist of the Greater Kuril Chain and, at the southwest end, the parallel Lesser Kuril Chain. The group termed the 'South Kurils' consists of those of the Lesser Kuril Chain together with Kunashir and Iturup in the Greater Kuril Chain. The Vries Strait between Iturup and Urup forms the Miyabe Line dividing the North and South Kurils."}}, {"canonical_name": "r\u00e9gularit\u00e9", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "r\u00e9gularit\u00e9", "book_id": "relation_historique_humboldt_vol3_1825", "name": "r\u00e9gularit\u00e9", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["r\u00e9gularit\u00e9"], "contexts": ["characteristic of observed phenomena"]}, {"entity_id": "regularity", "book_id": "kosmos_humboldt_1845", "name": "regularity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["regularity"], "contexts": ["implied by 'mundus'"]}, {"entity_id": "regularity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "regularity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["regularity"], "contexts": ["state of being orderly"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "r\u00e9gularit\u00e9", "target_book": "kosmos_humboldt_1845", "target_name": "regularity", "similarity": 0.957}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "r\u00e9gularit\u00e9", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "regularity", "similarity": 0.957}, {"source_book": "kosmos_humboldt_1845", "source_name": "regularity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "regularity", "similarity": 1.0}], "id": 2056, "stable_key": "clu_9a9bb68780fc4d29", "ground_truth": {"modern_name": "regularity", "confidence": "high", "type": "concept", "wikidata_id": "Q117467430", "wikidata_description": "concept in mathematics", "wikipedia_url": "https://en.wikipedia.org/wiki/Regularity%20theory", "wikipedia_extract": "Regularity is a topic of the mathematical study of partial differential equations (PDE) such as Laplace's equation, about the integrability and differentiability of weak solutions. Hilbert's nineteenth problem was concerned with this concept. The motivation for this study is as follows. It is often difficult to construct a classical solution satisfying the PDE in regular sense, so we search for a weak solution at first, and then find out whether the weak solution is smooth enough to be qualified as a classical solution. Several theorems have been proposed for different types of PDEs. ."}}, {"canonical_name": "Saba", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "saba", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Saba", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Saba"], "contexts": ["island name"]}, {"entity_id": "saba", "book_id": "historia_medicinal_monardes_1574", "name": "Saba", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Saba"], "contexts": ["region where Encienso grows"]}, {"entity_id": "saba", "book_id": "coloquios_da_orta_1563", "name": "Saba", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Saba"], "contexts": ["place mentioned in Ezekiel"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saba", "target_book": "historia_medicinal_monardes_1574", "target_name": "Saba", "similarity": 0.857}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saba", "target_book": "coloquios_da_orta_1563", "target_name": "Saba", "similarity": 0.893}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Saba", "target_book": "coloquios_da_orta_1563", "target_name": "Saba", "similarity": 0.879}], "id": 2057, "stable_key": "clu_c69ea47ef954918f", "ground_truth": {"modern_name": "Saba", "confidence": "high", "type": "place", "country": "Netherlands", "note": "Monardes's usage might refer to a medicinal plant from Saba rather than the island itself, but the context provided is too limited to be definitive.", "wikidata_id": "Q25019088", "wikidata_description": "island in Sorong Regency, Southwest Papua Province, Indonesia"}}, {"canonical_name": "colonies fran\u00e7oises", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "colonies_fran\u00e7oises", "book_id": "relation_historique_humboldt_vol3_1825", "name": "colonies fran\u00e7oises", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["colonies fran\u00e7oises"], "contexts": ["colonies absorbing slaves"]}, {"entity_id": "french_colonies", "book_id": "kosmos_humboldt_1845", "name": "French colonies", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["French colonies"], "contexts": ["colonies where negroes live"]}, {"entity_id": "col\u00f3nias_francezas", "book_id": "coloquios_da_orta_1563", "name": "Col\u00f3nias francezas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Col\u00f3nias francezas"], "contexts": ["French colonies"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "colonies fran\u00e7oises", "target_book": "kosmos_humboldt_1845", "target_name": "French colonies", "similarity": 0.948}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "colonies fran\u00e7oises", "target_book": "coloquios_da_orta_1563", "target_name": "Col\u00f3nias francezas", "similarity": 0.934}, {"source_book": "kosmos_humboldt_1845", "source_name": "French colonies", "target_book": "coloquios_da_orta_1563", "target_name": "Col\u00f3nias francezas", "similarity": 0.949}], "id": 2058, "stable_key": "clu_3d318d02dd8028fb", "ground_truth": {"modern_name": "French colonies", "confidence": "high", "type": "place", "country": "France", "wikidata_id": "Q179023", "wikidata_description": "set of territories that were under French rule primarily from the 17th century to the late 1960s"}}, {"canonical_name": "Syracuse", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "syracuse", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Syracuse", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Syracuse"], "contexts": ["location of freshwater eruptions"]}, {"entity_id": "syracuse", "book_id": "principles_of_psychology_james_1890", "name": "Syracuse", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Syracuse"], "contexts": ["city stormed during Archimedes' meditation"]}, {"entity_id": "syracuse", "book_id": "kosmos_humboldt_1845", "name": "Syracuse", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Syracuse"], "contexts": ["city with quarries yielding marine fossils"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Syracuse", "target_book": "principles_of_psychology_james_1890", "target_name": "Syracuse", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Syracuse", "target_book": "kosmos_humboldt_1845", "target_name": "Syracuse", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Syracuse", "target_book": "kosmos_humboldt_1845", "target_name": "Syracuse", "similarity": 1.0}], "id": 2059, "stable_key": "clu_1a7d9a9a31e32857", "ground_truth": {"modern_name": "Syracuse", "confidence": "high", "type": "place", "country": "Italy", "wikidata_id": "Q128069", "wikidata_description": "city in and county seat of Onondaga County, New York, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Syracuse%2C_New_York", "wikipedia_extract": "Syracuse ( SIRR-\u0259-kewz, SERR-, -\u2060kewss) is a city in New York, United States, and the county seat of Onondaga County. With a population of 148,620 and a metropolitan area of 662,057, it is the fifth-most populated city and 13th-most populated municipality in the state of New York. Formally established in 1820, Syracuse was named after the classical Greek city of Syracuse (Siracusa in Italian), located on the eastern coast of the Italian island of Sicily, for its similar natural features. Adjacent brine springs made the city a major producer of commercial salt into the late 19th century, earning the nickname \"The Salt City\"; it subsequently became a major industrial center until the mid-20th century, and has since been a hub for higher education, research, and services. Syracuse has historically functioned as a major crossroads in the state, first between the Erie Canal and its branches, then of the New York Central Railroad network established in the mid 19th century. Today, the city is at the intersection of Interstates 81 and 90, and its airport is the largest in Central New York, a five-county region of over one million inhabitants."}}, {"canonical_name": "Petit", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "petit", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Petit", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Petit"], "contexts": ["work on temperature reductions"]}, {"entity_id": "petit", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Petit", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Petit"], "contexts": ["calculated existence of small satellites"]}, {"entity_id": "petit", "book_id": "first_principles_spencer_1862", "name": "Petit", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Petit"], "contexts": ["scientist studying heat and affinity"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Petit", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Petit", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Petit", "target_book": "first_principles_spencer_1862", "target_name": "Petit", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Petit", "target_book": "first_principles_spencer_1862", "target_name": "Petit", "similarity": 1.0}], "id": 2060, "stable_key": "clu_b48fd36cdabebf19", "ground_truth": {"modern_name": "Alexis Petit", "confidence": "medium", "type": "person", "birth_year": 1715, "death_year": 1784, "description": "French astronomer and mathematician, known for astronomical calculations", "note": "The name 'Petit' appears in multiple scientific contexts; Alexis Petit is a plausible fit for astronomical work. Could also refer to Louis Petit if context leans purely towards meteors.", "wikidata_id": "Q728536", "wikidata_description": "French physicist (1791\u20131820)", "wikipedia_url": "https://en.wikipedia.org/wiki/Alexis_Th%C3%A9r%C3%A8se_Petit", "wikipedia_extract": "Alexis Th\u00e9r\u00e8se Petit (French: [p\u0259ti]; 2 October 1791 \u2013 21 June 1820) was a French physicist. Petit is known for his work on the efficiencies of air- and steam-engines, published in 1818 (M\u00e9moire sur l\u2019emploi du principe des forces vives dans le calcul des machines). His well-known discussions with the French physicist Sadi Carnot, founder of thermodynamics, may have stimulated Carnot in his reflexions on heat engines and thermodynamic efficiency. The Dulong\u2013Petit law (1819) is named after him and his collaborator Pierre Louis Dulong. Petit was born in Vesoul, Haute-Sa\u00f4ne. At the age of 10, he proved that he was already capable of taking the difficult entrance exam to France's most prestigious scientific school of the time, the \u00c9cole polytechnique of Paris."}}, {"canonical_name": "Pavie", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "pavie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pavie", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Pavie"], "contexts": ["location of observation"]}, {"entity_id": "pavia", "book_id": "kosmos_humboldt_1845", "name": "Pavia", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Pavia"], "contexts": ["city with high annual temperature"]}, {"entity_id": "pavia", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Pavia", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Pavia"], "contexts": ["Professor at Pavia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pavie", "target_book": "kosmos_humboldt_1845", "target_name": "Pavia", "similarity": 0.937}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pavie", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Pavia", "similarity": 0.937}, {"source_book": "kosmos_humboldt_1845", "source_name": "Pavia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Pavia", "similarity": 1.0}], "id": 2061, "stable_key": "clu_77b4afa491d735e0", "ground_truth": {"modern_name": "Pavia", "confidence": "high", "type": "place", "country": "Italy", "wikidata_id": "Q86604590", "wikidata_description": "genus of plants"}}, {"canonical_name": "Bologne", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "bologne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bologne", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bologne"], "contexts": ["location of observation"]}, {"entity_id": "bologna", "book_id": "kosmos_humboldt_1845", "name": "Bologna", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bologna"], "contexts": ["city where light was seen"]}, {"entity_id": "bologna", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bologna", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bologna"], "contexts": ["Professor of Anatomy in Bologna"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bologne", "target_book": "kosmos_humboldt_1845", "target_name": "Bologna", "similarity": 0.903}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bologne", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bologna", "similarity": 0.903}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bologna", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bologna", "similarity": 1.0}], "id": 2062, "stable_key": "clu_cf47a40c533df00b", "ground_truth": {"modern_name": "Poland", "confidence": "high", "type": "place", "description": "European country, historical kingdom and later part of Russian Empire.", "wikipedia_extract": "Poland, officially the Republic of Poland, is a country in Central Europe. It extends from the Baltic Sea in the north to the Sudetes and Carpathian Mountains in the south. Poland borders Kaliningrad Oblast and Lithuania to the north; Belarus and Ukraine to the east; Slovakia and the Czech Republic to the south; and Germany to the west. The territory has a varied landscape, diverse ecosystems, and a temperate climate. Poland is composed of sixteen voivodeships and is the fifth most populous member state of the European Union (EU), with over 38 million people, and the fifth largest EU country by land area, covering 312,696 km2 (120,733 sq mi). The capital and largest city is Warsaw; other major cities include Krak\u00f3w, Wroc\u0142aw, \u0141\u00f3d\u017a, Pozna\u0144, and Gda\u0144sk."}}, {"canonical_name": "measurements", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "measurements", "book_id": "principles_of_psychology_james_1890", "name": "measurements", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["measurements"], "contexts": ["quantification of phenomena"]}, {"entity_id": "measurements", "book_id": "kosmos_humboldt_1845", "name": "measurements", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["measurements"], "contexts": ["process of determining quantities"]}, {"entity_id": "measurements", "book_id": "connexion_physical_sciences_somerville_1858", "name": "measurements", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["measurements"], "contexts": ["of Etna"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "measurements", "target_book": "kosmos_humboldt_1845", "target_name": "measurements", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "measurements", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "measurements", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "measurements", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "measurements", "similarity": 1.0}], "id": 2063, "stable_key": "clu_987585922aca1b1d-2", "ground_truth": {"modern_name": "Measurement", "confidence": "high", "type": "concept", "wikidata_id": "Q12453", "wikidata_description": "process of assigning quantities to objects or events", "wikipedia_extract": "Measurement is the quantification of attributes of an object or event, which can be used to compare with other objects or events. In other words, measurement is a process of determining how large or small a physical quantity is as compared to a basic reference quantity of the same kind. The scope and application of measurement are dependent on the context and discipline. In natural sciences and engineering, measurements do not apply to nominal properties of objects or events, which is consistent with the guidelines of the International Vocabulary of Metrology (VIM) published by the International Bureau of Weights and Measures (BIPM). However, in other fields such as statistics as well as the social and behavioural sciences, measurements can have multiple levels, which would include nominal, ordinal, interval and ratio scales. Measurement is a cornerstone of trade, science, technology and quantitative research in many disciplines.", "wikipedia_url": "https://en.wikipedia.org/wiki/Measurement"}}, {"canonical_name": "opposite", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "opposite", "book_id": "principles_of_psychology_james_1890", "name": "opposite", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["opposite"], "contexts": ["contrasting or contrary"]}, {"entity_id": "contrario", "book_id": "historia_medicinal_monardes_1574", "name": "contrario", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["contrario"], "contexts": ["opposite to counteract poison"]}, {"entity_id": "opposite", "book_id": "connexion_physical_sciences_somerville_1858", "name": "opposite", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["opposite"], "contexts": ["facing the other way"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "opposite", "target_book": "historia_medicinal_monardes_1574", "target_name": "contrario", "similarity": 0.951}, {"source_book": "principles_of_psychology_james_1890", "source_name": "opposite", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "opposite", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "contrario", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "opposite", "similarity": 0.951}], "id": 2064, "stable_key": "clu_bea7bbe61a78dd90", "ground_truth": {"modern_name": "Opposite", "confidence": "high", "type": "concept", "note": "This refers to the philosophical or physical concept of being contrary or opposed, not a specific scientific term.", "wikidata_id": "Q2602337", "wikidata_description": "written prose piece in a publication expressing the opinion of an author or entity"}}, {"canonical_name": "organic growth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "organic_growth", "book_id": "principles_of_psychology_james_1890", "name": "organic growth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic growth"], "contexts": ["development through biological processes"]}, {"entity_id": "organic_development", "book_id": "kosmos_humboldt_1845", "name": "organic development", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic development"], "contexts": ["process of growth and change"]}, {"entity_id": "organic_growth", "book_id": "first_principles_spencer_1862", "name": "organic growth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic growth"], "contexts": ["biological development process"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "organic growth", "target_book": "kosmos_humboldt_1845", "target_name": "organic development", "similarity": 0.915}, {"source_book": "principles_of_psychology_james_1890", "source_name": "organic growth", "target_book": "first_principles_spencer_1862", "target_name": "organic growth", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "organic development", "target_book": "first_principles_spencer_1862", "target_name": "organic growth", "similarity": 0.915}], "id": 2065, "stable_key": "clu_716da89b103c2d9a", "ground_truth": {"modern_name": "Organic growth", "confidence": "high", "type": "concept", "note": "Refers to development through biological processes, a key concept in early evolutionary and developmental biology.", "wikidata_id": "Q445127", "wikidata_description": "business expansion through increasing output and sales as opposed to mergers, acquisitions and takeovers"}}, {"canonical_name": "instability", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "instability", "book_id": "principles_of_psychology_james_1890", "name": "instability", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["instability"], "contexts": ["lack of fixed or predictable state"]}, {"entity_id": "instability", "book_id": "connexion_physical_sciences_somerville_1858", "name": "instability", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["instability"], "contexts": ["state of being unstable"]}, {"entity_id": "instability", "book_id": "first_principles_spencer_1862", "name": "instability", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["instability"], "contexts": ["tendency to change"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "instability", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "instability", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "instability", "target_book": "first_principles_spencer_1862", "target_name": "instability", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "instability", "target_book": "first_principles_spencer_1862", "target_name": "instability", "similarity": 1.0}], "id": 2066, "stable_key": "clu_6557326207b00c88", "ground_truth": {"modern_name": "Instability", "confidence": "high", "type": "concept", "wikidata_id": "Q405372", "wikidata_description": "characterized by some of the outputs or internal states growing without bounds", "wikipedia_url": "https://en.wikipedia.org/wiki/Instability", "wikipedia_extract": "In dynamical systems instability means that some of the outputs or internal states increase with time, without bounds. Not all systems that are not stable are unstable; systems can also be marginally stable or exhibit limit cycle behavior. In structural engineering, a structural beam or column can become unstable when excessive compressive load is applied. Beyond a certain threshold, structural deflections magnify stresses, which in turn increases deflections. This can take the form of buckling or crippling. The general field of study is called structural stability."}}, {"canonical_name": "corpuscular philosophy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "corpuscular_philosophy", "book_id": "principles_of_psychology_james_1890", "name": "corpuscular philosophy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["corpuscular philosophy"], "contexts": ["philosophy of tiny particles"]}, {"entity_id": "corpuscular_philosophy", "book_id": "polyanthea_medicinal", "name": "corpuscular philosophy", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["corpuscular philosophy"], "contexts": ["theory of corpuscles"]}, {"entity_id": "corpuscular_philosophers", "book_id": "connexion_physical_sciences_somerville_1858", "name": "corpuscular philosophers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["corpuscular philosophers"], "contexts": ["philosophers with corpuscular theory of light"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "corpuscular philosophy", "target_book": "polyanthea_medicinal", "target_name": "corpuscular philosophy", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "corpuscular philosophy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "corpuscular philosophers", "similarity": 0.89}, {"source_book": "polyanthea_medicinal", "source_name": "corpuscular philosophy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "corpuscular philosophers", "similarity": 0.89}], "id": 2067, "stable_key": "clu_9f9c8aa189d97bea", "ground_truth": {"modern_name": "Corpuscular theory", "confidence": "high", "type": "concept", "wikidata_id": "Q456954", "wikidata_description": "theory", "wikipedia_url": "https://en.wikipedia.org/wiki/Corpuscular%20theory%20of%20light", "wikipedia_extract": "In optics, the corpuscular theory of light states that light is made up of small discrete particles called \"corpuscles\" (little particles) which travel in a straight line with a finite velocity and possess impetus. This notion was based on an alternate description of atomism of the time period. Isaac Newton laid the foundations for this theory through his work in optics. This early conception of the particle theory of light was an early forerunner to the modern understanding of the photon. This theory came to dominate the conceptions of light in the eighteenth century, displacing the previously prominent vibration theories, where light was viewed as \"pressure\" of the medium between the source and the receiver, first championed by Ren\u00e9 Descartes, and later in a more refined form by Christiaan Huygens. In part correct, being able to successfully explain refraction, reflection, rectilinear propagation and to a lesser extent diffraction, the theory would fall out of favor in the early nineteenth century, as the wave theory of light amassed new experimental evidence."}}, {"canonical_name": "individuals", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "individuals", "book_id": "principles_of_psychology_james_1890", "name": "individuals", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["individuals"], "contexts": ["distinct human beings"]}, {"entity_id": "individuals", "book_id": "kosmos_humboldt_1845", "name": "individuals", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["individuals"], "contexts": ["distinct beings"]}, {"entity_id": "individuals", "book_id": "first_principles_spencer_1862", "name": "individuals", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["individuals"], "contexts": ["single living beings"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "individuals", "target_book": "kosmos_humboldt_1845", "target_name": "individuals", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "individuals", "target_book": "first_principles_spencer_1862", "target_name": "individuals", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "individuals", "target_book": "first_principles_spencer_1862", "target_name": "individuals", "similarity": 1.0}], "id": 2068, "stable_key": "clu_605ec8cdf0359f79-2", "ground_truth": {"modern_name": "Individuals", "confidence": "high", "type": "concept", "note": "While 'individuals' refers to distinct beings, in a scientific context, it often functions as a concept referring to distinct units of observation or analysis rather than a specific group of people.", "wikidata_id": "Q5", "wikidata_description": "any single member of Homo sapiens, unique extant species of the genus Homo", "wikipedia_url": "https://en.wikipedia.org/wiki/Human", "description": "General term for human beings, often in the context of medical treatment.", "wikipedia_extract": "Humans (Homo sapiens, meaning \"thinking man\" or \"wise man\") are the most common and widespread species of primate, and the only extant species of the genus Homo. They are great apes characterized by hairlessness, obligate bipedality, manual dexterity with opposable thumbs, precision grip, and high intelligence. Humans have large brains compared to body size (a high encephalization quotient), enabling more advanced cognitive skills that facilitate successful adaptation to varied environments, development of sophisticated tools, and formation of complex social structures and civilizations. Humans possess a disproportionately larger volume of both cerebral white matter and gray matter present in the prefrontal cortex (PFC) than any other primate species, which facilitated the expansion of higher-order executive functions. Humans are highly social, with individual humans tending to belong to a multi-layered network of distinct social groups \u2013 from families and peer groups to corporations and political states. As such, social interactions between humans have established a wide variety of values, social norms, languages, and traditions (collectively termed institutions), each of which bolsters human society."}}, {"canonical_name": "H. Helmholtz", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "h__helmholtz", "book_id": "principles_of_psychology_james_1890", "name": "H. Helmholtz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["H. Helmholtz"], "contexts": ["author of Popular Scientific Lectures"]}, {"entity_id": "professor_helmholtz", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Professor Helmholtz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Professor Helmholtz"], "contexts": ["calculated chemical force magnitude"]}, {"entity_id": "prof__helmholtz", "book_id": "first_principles_spencer_1862", "name": "Prof. Helmholtz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Prof. Helmholtz"], "contexts": ["author of paper on natural forces"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "H. Helmholtz", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Professor Helmholtz", "similarity": 0.903}, {"source_book": "principles_of_psychology_james_1890", "source_name": "H. Helmholtz", "target_book": "first_principles_spencer_1862", "target_name": "Prof. Helmholtz", "similarity": 0.91}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Professor Helmholtz", "target_book": "first_principles_spencer_1862", "target_name": "Prof. Helmholtz", "similarity": 0.982}], "id": 2069, "stable_key": "clu_ac5a478f44a2b09b-2", "ground_truth": {"modern_name": "Hermann von Helmholtz", "confidence": "high", "type": "person", "birth_year": 1821, "death_year": 1894, "description": "German physician and physicist, pioneering researcher in optics, electromagnetism, and nerve physiology.", "wikidata_id": "Q113814860", "wikidata_description": "street in Kleinmachnow, Brandenburg, Germany", "note": "The text 'principles_of_psychology_james_1890' refers to William James, whose work was heavily influenced by Helmholtz. The 'coloquios_da_orta_1563' reference to 'Hermanno' is likely a different individual, possibly referencing Dioscorides' 'Hermion' or similar ancient botanical names, but the primary context points to Helmholtz. Given the dominant context, Helmholtz is the most probable referent."}}, {"canonical_name": "spinning top", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "spinning_top", "book_id": "principles_of_psychology_james_1890", "name": "spinning top", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["spinning top"], "contexts": ["toy that spins on its axis"]}, {"entity_id": "top_spinning", "book_id": "connexion_physical_sciences_somerville_1858", "name": "top spinning", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["top spinning"], "contexts": ["toy that spins"]}, {"entity_id": "spinning_top", "book_id": "first_principles_spencer_1862", "name": "spinning top", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["spinning top"], "contexts": ["example of successive equilibration of combined movements"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "spinning top", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "top spinning", "similarity": 0.926}, {"source_book": "principles_of_psychology_james_1890", "source_name": "spinning top", "target_book": "first_principles_spencer_1862", "target_name": "spinning top", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "top spinning", "target_book": "first_principles_spencer_1862", "target_name": "spinning top", "similarity": 0.926}], "id": 2070, "stable_key": "clu_ce788392d94a0724", "ground_truth": {"modern_name": "spinning top", "confidence": "high", "type": "object", "wikidata_id": "Q15583916", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Leucadendron%20rubrum", "wikipedia_extract": "Leucadendron rubrum, the spinning top, is a flower-bearing shrub belonging to the genus Leucadendron and forms part of the fynbos. The plant is native to the Western Cape, South Africa. The shrub grows 2.5 m (8.2 ft) tall and flowers from August to September. Fire destroys the plant but the seeds survive. The seeds are stored in a toll on the female plant and are released where they are spread by the wind. The seed has a parachute mechanism that allows it to float and rotate through the air."}}, {"canonical_name": "tendency", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "tendency", "book_id": "principles_of_psychology_james_1890", "name": "tendency", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tendency"], "contexts": ["internal inclination or disposition"]}, {"entity_id": "tendency", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tendency", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tendency"], "contexts": ["inclination to move"]}, {"entity_id": "tendencies", "book_id": "first_principles_spencer_1862", "name": "tendencies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tendencies"], "contexts": ["inclinations or predispositions"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "tendency", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tendency", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tendency", "target_book": "first_principles_spencer_1862", "target_name": "tendencies", "similarity": 0.927}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "tendency", "target_book": "first_principles_spencer_1862", "target_name": "tendencies", "similarity": 0.927}], "id": 2071, "stable_key": "clu_c856280aebbdb2b1", "ground_truth": {"modern_name": "tendency", "confidence": "high", "type": "concept", "wikidata_id": "Q55919789", "wikidata_description": "characteristic of an entity that makes a given outcome or event more likely than it would otherwise be", "wikipedia_url": "https://en.wikipedia.org/wiki/Tendency", "wikipedia_extract": "Tendency or tendencies may refer to: Seasonal tendencies, qualities of economic phenomena that appear to be related to the calendar \"Tendencies\", a song by Hollywood Undead on the 2011 album American Tragedy Tendency film, socially conscious, left-leaning films produced in Japan during the 1920s and 1930s Tendency (party politics), particularly factions within Marxist parties, or Marxist factions in larger parties All pages with titles containing tendency All pages with titles containing tendencies"}}, {"canonical_name": "cannon", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "cannon", "book_id": "principles_of_psychology_james_1890", "name": "cannon", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["cannon"], "contexts": ["object producing a real sound"]}, {"entity_id": "lan\u00e7a", "book_id": "coloquios_da_orta_1563", "name": "lan\u00e7a", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["lan\u00e7a"], "contexts": ["shape of the leaf"]}, {"entity_id": "cannon", "book_id": "first_principles_spencer_1862", "name": "cannon", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["cannon"], "contexts": ["weapon that produces loud sound"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "cannon", "target_book": "coloquios_da_orta_1563", "target_name": "lan\u00e7a", "similarity": 0.892}, {"source_book": "principles_of_psychology_james_1890", "source_name": "cannon", "target_book": "first_principles_spencer_1862", "target_name": "cannon", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "lan\u00e7a", "target_book": "first_principles_spencer_1862", "target_name": "cannon", "similarity": 0.892}], "id": 2072, "stable_key": "clu_519e33b818d10c76", "ground_truth": {"modern_name": "cannon", "confidence": "medium", "type": "object", "note": "The context 'shape of the leaf' is likely a misattribution or OCR error; 'lan\u00e7a' usually refers to a spear, but in some contexts could relate to projectile weapons. 'cannon ball' and 'bullet' suggest a military projectile context.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Cannon", "wikipedia_extract": "A cannon (plural either cannons or cannon) is a large-caliber gun classified as a type of artillery, which usually launches a projectile using explosive chemical propellant. Gunpowder (\"black powder\") was the primary propellant before the invention of smokeless powder during the late 19th century. Cannons vary in gauge, effective range, mobility, rate of fire, angle of fire and firepower; different forms of cannon combine and balance these attributes in varying degrees, depending on their intended use on the battlefield. A cannon is a type of heavy artillery weapon. The word cannon is derived from several languages, in which the original definition can usually be translated as tube, cane, or reed. The earliest known depiction of cannons may have appeared in Song dynasty China as early as the 12th century; however, solid archaeological and documentary evidence of cannons do not appear until the 13th century."}}, {"canonical_name": "Wolf", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "wolf", "book_id": "principles_of_psychology_james_1890", "name": "Wolf", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Wolf"], "contexts": ["philosopher defending soul substantiality"]}, {"entity_id": "wolf__hoferus", "book_id": "polyanthea_medicinal", "name": "wolf. Hoferus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["wolf. Hoferus"], "contexts": ["author on women's diseases"]}, {"entity_id": "wolff", "book_id": "first_principles_spencer_1862", "name": "Wolff", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Wolff"], "contexts": ["established truth of organismal development"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Wolf", "target_book": "polyanthea_medicinal", "target_name": "wolf. Hoferus", "similarity": 0.862}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Wolf", "target_book": "first_principles_spencer_1862", "target_name": "Wolff", "similarity": 0.957}, {"source_book": "polyanthea_medicinal", "source_name": "wolf. Hoferus", "target_book": "first_principles_spencer_1862", "target_name": "Wolff", "similarity": 0.877}], "id": 2073, "stable_key": "clu_afbc2e02db68b3ac", "ground_truth": {"modern_name": "Caspar Friedrich Wolff", "confidence": "high", "type": "person", "birth_year": 1734, "death_year": 1794, "description": "German physiologist who proposed evolutionary theory of epigenesis", "note": "While 'Wolf' and 'Wolff' are present, the context of organismal development points strongly to Caspar Friedrich Wolff. 'Hoferus' is likely a Latinized reference to a different individual, possibly associated with 'wolf. Hoferus' in a medical text."}}, {"canonical_name": "moral", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "moral", "book_id": "principles_of_psychology_james_1890", "name": "moral", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["moral"], "contexts": ["relating to principles of right and wrong"]}, {"entity_id": "moral", "book_id": "polyanthea_medicinal", "name": "Moral", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Moral"], "contexts": ["ethics"]}, {"entity_id": "moral_ideal", "book_id": "first_principles_spencer_1862", "name": "moral ideal", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["moral ideal"], "contexts": ["goal of ethical progress"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "moral", "target_book": "polyanthea_medicinal", "target_name": "Moral", "similarity": 0.983}, {"source_book": "principles_of_psychology_james_1890", "source_name": "moral", "target_book": "first_principles_spencer_1862", "target_name": "moral ideal", "similarity": 0.891}, {"source_book": "polyanthea_medicinal", "source_name": "Moral", "target_book": "first_principles_spencer_1862", "target_name": "moral ideal", "similarity": 0.884}], "id": 2074, "stable_key": "clu_a4a058a04da5fcac", "ground_truth": {"modern_name": "Morality", "confidence": "high", "type": "concept", "wikidata_id": "Q1132684", "wikidata_description": "ethical practice concerning scientific research", "wikipedia_url": "https://en.wikipedia.org/wiki/Research%20ethics", "wikipedia_extract": "Research ethics is a discipline within the study of applied ethics. Its scope ranges from general scientific integrity and misconduct to the treatment of human and animal subjects. The social responsibilities of scientists and researchers are not traditionally included and are less well defined. The discipline is most developed in medical research. Beyond the issues of falsification, fabrication, and plagiarism that arise in every scientific field, research design in human subject research and animal testing are the areas that raise ethical questions most often. The list of historic cases includes many large-scale violations and crimes against humanity such as Nazi human experimentation and the Tuskegee syphilis experiment which led to international codes of research ethics."}}, {"canonical_name": "vibrating string", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "vibrating_string", "book_id": "principles_of_psychology_james_1890", "name": "vibrating string", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["vibrating string"], "contexts": ["object producing sound through vibration"]}, {"entity_id": "vibrating_string", "book_id": "connexion_physical_sciences_somerville_1858", "name": "vibrating string", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["vibrating string"], "contexts": ["string that oscillates"]}, {"entity_id": "vibrating_strings", "book_id": "first_principles_spencer_1862", "name": "vibrating strings", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["vibrating strings"], "contexts": ["strings producing sound waves"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "vibrating string", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "vibrating string", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "vibrating string", "target_book": "first_principles_spencer_1862", "target_name": "vibrating strings", "similarity": 0.961}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "vibrating string", "target_book": "first_principles_spencer_1862", "target_name": "vibrating strings", "similarity": 0.961}], "id": 2075, "stable_key": "clu_bb9739b799534c47", "ground_truth": {"modern_name": "vibrating string", "confidence": "high", "type": "object", "wikidata_id": "Q3252739", "wikidata_description": "A vibration in a string is a wave", "wikipedia_extract": "A sex toy is an object or device that is primarily used to facilitate sexual pleasure, such as a dildo, artificial vagina or vibrator. Many popular sex toys are designed to resemble human genitals, and may be vibrating or non-vibrating. The term sex toy can also include BDSM apparatus and sex furniture such as sex swings; however, it is not applied to items such as birth control, pornography, or condoms. Alternative terms for sex toy include adult toy and the dated euphemism marital aid. Marital aid also has a broader meaning and is applied to drugs and herbs marketed to enhance or prolong sex. Sex toys are most commonly sold at sex shops or online, but they may also be sold in a pharmacy, a pornography store, a head shop, or a department store.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sex_toy"}}, {"canonical_name": "qualitatively", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "qualitatively", "book_id": "principles_of_psychology_james_1890", "name": "qualitatively", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["qualitatively"], "contexts": ["pertaining to differences in kind"]}, {"entity_id": "qualitative", "book_id": "kosmos_humboldt_1845", "name": "qualitative", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["qualitative"], "contexts": ["abstraction based on material characters"]}, {"entity_id": "qualitative", "book_id": "first_principles_spencer_1862", "name": "qualitative", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["qualitative"], "contexts": ["relating to quality or nature"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "qualitatively", "target_book": "kosmos_humboldt_1845", "target_name": "qualitative", "similarity": 0.935}, {"source_book": "principles_of_psychology_james_1890", "source_name": "qualitatively", "target_book": "first_principles_spencer_1862", "target_name": "qualitative", "similarity": 0.935}, {"source_book": "kosmos_humboldt_1845", "source_name": "qualitative", "target_book": "first_principles_spencer_1862", "target_name": "qualitative", "similarity": 1.0}], "id": 2076, "stable_key": "clu_0f234d1a56c4e62d", "ground_truth": {"modern_name": "Qualitative", "confidence": "high", "type": "concept", "wikidata_id": "Q57302333", "wikidata_description": "article"}}, {"canonical_name": "palm", "category": "PLANT", "subcategory": "TREE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "palm", "book_id": "principles_of_psychology_james_1890", "name": "palm", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["palm"], "contexts": ["tree that produces dates"]}, {"entity_id": "palm", "book_id": "kosmos_humboldt_1845", "name": "palm", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["palm"], "contexts": ["plant family in tropical regions"]}, {"entity_id": "palm", "book_id": "connexion_physical_sciences_somerville_1858", "name": "palm", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["palm"], "contexts": ["tropical tree with large leaves"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "palm", "target_book": "kosmos_humboldt_1845", "target_name": "palm", "similarity": 0.863}, {"source_book": "principles_of_psychology_james_1890", "source_name": "palm", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "palm", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "palm", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "palm", "similarity": 0.863}], "id": 2077, "stable_key": "clu_a0b8e7c12cda39ae-3", "ground_truth": {"modern_name": "Palm tree", "confidence": "high", "type": "plant", "family": "Arecaceae", "note": "Palma is the direct Spanish and Italian word for palm. Given the contexts, it refers to the plant family or specific trees within it.", "wikidata_id": "Q14080", "wikidata_description": "family of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Arecaceae", "wikipedia_extract": "The Arecaceae () are a family of perennial, flowering plants in the monocot order Arecales. Their growth form can be climbers, shrubs, tree-like and stemless plants, all commonly known as palms. Those having a tree-like form are colloquially called palm trees. Currently, 181 genera with around 2,600 species are known, most of which are restricted to tropical and subtropical climates. Most palms are distinguished by their large, compound, evergreen leaves, known as fronds, arranged at the top of an unbranched stem, except for the Hyphaene genus, which has branched palms. However, palms exhibit an enormous diversity in physical characteristics and inhabit nearly every type of habitat within their range, from rainforests to deserts."}}, {"canonical_name": "Stockholm", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "stockholm", "book_id": "principles_of_psychology_james_1890", "name": "Stockholm", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Stockholm"], "contexts": ["location of Swedish Academy of Sciences"]}, {"entity_id": "stockholm", "book_id": "kosmos_humboldt_1845", "name": "Stockholm", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Stockholm"], "contexts": ["city for latitude comparison"]}, {"entity_id": "stockholm", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Stockholm", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Stockholm"], "contexts": ["city on isothermal line of 41\u00b0 Fahrenheit"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Stockholm", "target_book": "kosmos_humboldt_1845", "target_name": "Stockholm", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Stockholm", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Stockholm", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Stockholm", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Stockholm", "similarity": 1.0}], "id": 2078, "stable_key": "clu_0a1c6ae72d1258a0", "ground_truth": {"modern_name": "Stockholm", "confidence": "high", "type": "place", "country": "Sweden", "wikidata_id": "Q1754", "wikidata_description": "capital and largest city of Sweden", "wikipedia_url": "https://en.wikipedia.org/wiki/Stockholm", "wikipedia_extract": "Stockholm (; Swedish: [\u02c8st\u0254\u0302k\u02d0(h)\u0254lm] ) is the capital and most populous city of Sweden, as well as the largest urban area in the Nordic countries. Approximately 1 million people live in the municipality, with 1.6 million in the urban area, and 2.5 million in the metropolitan area. The city stretches across fourteen islands where Lake M\u00e4laren flows into the Baltic Sea. Outside the city to the east, and along the coast, is the island chain of the Stockholm archipelago. The area has been settled since the Stone Age, in the 6th millennium BC, and was founded as a city in 1252 by Swedish statesman Birger Jarl. The city serves as the county seat of Stockholm County."}}, {"canonical_name": "velocity of sound", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "velocity_of_sound", "book_id": "principles_of_psychology_james_1890", "name": "velocity of sound", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["velocity of sound"], "contexts": ["speed at which sound travels"]}, {"entity_id": "velocity_of_sound", "book_id": "kosmos_humboldt_1845", "name": "velocity of sound", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["velocity of sound"], "contexts": ["speed of sound propagation"]}, {"entity_id": "velocity_of_sound", "book_id": "connexion_physical_sciences_somerville_1858", "name": "velocity of sound", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["velocity of sound"], "contexts": ["speed of sound propagation"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "velocity of sound", "target_book": "kosmos_humboldt_1845", "target_name": "velocity of sound", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "velocity of sound", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "velocity of sound", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "velocity of sound", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "velocity of sound", "similarity": 1.0}], "id": 2079, "stable_key": "clu_c25f4a10d4959b8f", "ground_truth": {"modern_name": "Speed of sound", "confidence": "high", "type": "concept", "wikidata_id": "Q124003", "wikidata_description": "distance travelled during a unit of time by a sound wave propagating through an elastic medium"}}, {"canonical_name": "Great Indian Archipelago", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "great_indian_archipelago", "book_id": "kosmos_humboldt_1845", "name": "Great Indian Archipelago", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Great Indian Archipelago"], "contexts": ["region with varied natural elements"]}, {"entity_id": "indian_archipelago", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Indian Archipelago", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Indian Archipelago"], "contexts": ["islands between Asia and Australia"]}, {"entity_id": "east_indian_archipelago", "book_id": "first_principles_spencer_1862", "name": "East Indian Archipelago", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["East Indian Archipelago"], "contexts": ["archipelago in Southeast Asia"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Great Indian Archipelago", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Indian Archipelago", "similarity": 0.934}, {"source_book": "kosmos_humboldt_1845", "source_name": "Great Indian Archipelago", "target_book": "first_principles_spencer_1862", "target_name": "East Indian Archipelago", "similarity": 0.898}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Indian Archipelago", "target_book": "first_principles_spencer_1862", "target_name": "East Indian Archipelago", "similarity": 0.93}], "id": 2080, "stable_key": "clu_2a895c14988dcaf4", "ground_truth": {"modern_name": "Indonesian Archipelago", "confidence": "high", "type": "place", "country": "Indonesia", "wikidata_id": "Q49332", "wikidata_description": "Old Javanese term for the archipelagic Majapahit territory", "wikipedia_url": "https://en.wikipedia.org/wiki/Nusantara%20%28term%29", "wikipedia_extract": "Nusantara is the Indonesian name of Maritime Southeast Asia (or parts of it). It is an Old Javanese term that literally means \"outer islands\". In Indonesia, it is generally taken to mean the Indonesian Archipelago. Outside of Indonesia, the term has been adopted to refer to the Malay Archipelago. The word Nusantara is taken from an oath by Gajah Mada in 1336, as written in the Old Javanese Pararaton. Gajah Mada was a powerful military leader and prime minister of Majapahit credited with bringing the empire to its peak of glory."}}, {"canonical_name": "ethereal fluid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "ethereal_fluid", "book_id": "kosmos_humboldt_1845", "name": "ethereal fluid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["ethereal fluid"], "contexts": ["hypothesized fluid affecting celestial bodies"]}, {"entity_id": "ethereal_fluid", "book_id": "connexion_physical_sciences_somerville_1858", "name": "ethereal fluid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["ethereal fluid"], "contexts": ["hypothetical medium for light propagation"]}, {"entity_id": "ethereal", "book_id": "first_principles_spencer_1862", "name": "ethereal", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["ethereal"], "contexts": ["hypothetical medium for light and heat"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "ethereal fluid", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ethereal fluid", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "ethereal fluid", "target_book": "first_principles_spencer_1862", "target_name": "ethereal", "similarity": 0.93}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "ethereal fluid", "target_book": "first_principles_spencer_1862", "target_name": "ethereal", "similarity": 0.93}], "id": 2081, "stable_key": "clu_4aacd6130070b8e1-2", "ground_truth": {"modern_name": "luminiferous aether", "confidence": "high", "type": "concept", "note": "Historically, this referred to a hypothetical medium for light and electromagnetic waves. It was later superseded by the concept of spacetime.", "wikidata_id": "Q208702", "wikidata_description": "postulated medium for the propagation of light"}}, {"canonical_name": "internal organization", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "internal_organization", "book_id": "kosmos_humboldt_1845", "name": "internal organization", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["internal organization"], "contexts": ["internal structure of organisms"]}, {"entity_id": "internal_structure", "book_id": "connexion_physical_sciences_somerville_1858", "name": "internal structure", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["internal structure"], "contexts": ["composition and arrangement within a body"]}, {"entity_id": "internal_arrangement", "book_id": "first_principles_spencer_1862", "name": "internal arrangement", "category": "SU