ategory": "ANATOMY", "count": 1, "variants": ["rostro"], "contexts": ["face"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "rostro", "target_book": "historia_medicinal_monardes_1574", "target_name": "rostro", "similarity": 1.0}], "id": 4603, "stable_key": "clu_0ae96c6e48c85ca3", "ground_truth": {"modern_name": "face", "confidence": "high", "type": "concept", "note": "The term 'rostro' in Spanish and Portuguese directly translates to 'face'. In the context of anatomy and medicinal texts, it refers to this facial region.", "wikidata_id": "Q355", "wikidata_description": "American online social media and social networking service", "wikipedia_url": "https://en.wikipedia.org/wiki/Facebook"}}, {"canonical_name": "agua ardiente", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "agua_ardiente", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "agua ardiente", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["agua ardiente"], "contexts": ["alcoholic spirit", "aguardiente"]}, {"entity_id": "agua_ardiente", "book_id": "historia_medicinal_monardes_1574", "name": "agua ardiente", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["agua ardiente"], "contexts": ["distilled spirit, likely alcohol"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "agua ardiente", "target_book": "historia_medicinal_monardes_1574", "target_name": "agua ardiente", "similarity": 0.885}], "id": 4604, "stable_key": "clu_2e4847f646469f92", "ground_truth": {"modern_name": "alcoholic spirit", "confidence": "high", "type": "chemical", "note": "'Agua ardiente' literally translates to 'burning water' and was a common term for distilled spirits, primarily alcohol, in early modern Iberian languages.", "wikidata_id": "Q153", "wikidata_description": "chemical compound", "wikipedia_url":