rn_name": "Malva", "confidence": "high", "type": "plant", "linnaean": "Malva sylvestris L.", "family": "Malvaceae", "note": "The texts mention 'Malua' and 'malua'. Given the context of mucilage and flower color, it strongly points to the genus Malva, with Malva sylvestris being a prominent species.", "wikidata_id": "Q147325", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Malva"}}, {"canonical_name": "pongo\u00f1a", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "ponzo\u00f1as", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "ponzo\u00f1as", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["ponzo\u00f1as"], "contexts": ["poisons"]}, {"entity_id": "pongo\u00f1a", "book_id": "historia_medicinal_monardes_1574", "name": "pongo\u00f1a", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["pongo\u00f1a", "ponge\u00f1a"], "contexts": ["pongo\u00f1a que el animal echo enla llaga", "poisonous substance"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ponzo\u00f1as", "target_book": "historia_medicinal_monardes_1574", "target_name": "pongo\u00f1a", "similarity": 0.886}], "id": 4061, "stable_key": "clu_444308830b60e7a7", "ground_truth": {"modern_name": "poison", "confidence": "high", "type": "disease", "modern_term": "poisoning", "note": "The term 'ponzo\u00f1as' in Spanish historically referred to poisons, and the context 'pongo\u00f1a que el animal echo enla llaga' suggests a poisonous substance causing harm. While 'pongo\u00f1a' can sometimes refer to specific ailments, in this context, 'poison' or 'poisoning' is the most direct modern referent for the substance.", "wikidata_id": "Q387175", "wikidata_description": "human disease"}}, {"canonical_name": "peces", "category": "ANIMAL", "subcategory": "FISH", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "pezes", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "pezes", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["pezes"], "contexts": ["creatures killed by the plant"]}, {"entity_id": "peces", "book_id": "historia_medicinal_monardes_1574", "name": "peces", "category": "ANIMAL", "subcategory": "FISH", "count": 3, "variants": ["peces", "pe\u017fces"], "contexts": ["fish that consume amber", "fish spines"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "pezes", "target_book": "historia_medicinal_monardes_1574", "target_name": "peces", "similarity": 0.954}], "id": 4062, "stable_key": "clu_3e870db386c371a9", "ground_truth": {"modern_name": "fish", "confidence": "high", "type": "animal", "wikidata_id": "Q152", "wikidata_description": "vertebrate animal that lives in water and (typically) has gills", "wikipedia_url": "https://en.wikipedia.org/wiki/Fish"}}, {"canonical_name": "muelas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "muelas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "muelas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["muelas"], "contexts": ["body part for strengthening"]}, {"entity_id": "muelas", "book_id": "historia_medicinal_monardes_1574", "name": "muelas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["muelas"], "contexts": ["teeth that can be painful", "molars"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "muelas", "target_book": "historia_medicinal_monardes_1574", "target_name": "muelas", "similarity": 1.0}], "id": 4063, "stable_key": "clu_8e7f0cd38410b776", "ground_truth": {"modern_name": "teeth", "confidence": "high", "type": "object", "note": "While 'muelas' refers specifically to molars, in the context of general medicinal texts, it often broadly refers to teeth, especially when discussing their health or pain.", "wikidata_id": "Q47450777", "wikidata_description": "one in a row of physical projections, by analogy with teeth in organisms"}}, {"canonical_name": "alvayalde", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "albayalde", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "albayalde", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["albayalde"], "contexts": ["white pigment made from lead"]}, {"entity_id": "alvayalde", "book_id": "historia_medicinal_monardes_1574", "name": "alvayalde", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["alvayalde", "alvavalde"], "contexts": ["white lead, used in treatment", "white lead, a pigment and medicine"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "albayalde", "target_book": "historia_medicinal_monardes_1574", "target_name": "alvayalde", "similarity": 0.886}], "id": 4064, "stable_key": "clu_b2ea6f1f309c866b", "ground_truth": {"modern_name": "lead white", "confidence": "high", "type": "chemical", "wikidata_id": "Q128978130", "wikidata_description": "scholarly article"}}, {"canonical_name": "Wells", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "wells", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "wells", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["wells"], "contexts": ["source of salt"]}, {"entity_id": "wells", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Wells", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Wells", "wells"], "contexts": ["locations for temperature observation", "excavations for water"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "wells", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Wells", "similarity": 0.95}], "id": 4065, "stable_key": "clu_8ad48fa67bc3bd8a", "ground_truth": {"modern_name": "well", "confidence": "high", "type": "place", "country": "unknown", "note": "The term 'wells' can refer to water sources or locations for observation. Given the dual contexts, 'well' as a general term is most appropriate. The country is unknown as the term is generic.", "wikidata_id": "Q37574363", "wikidata_description": "family name"}}, {"canonical_name": "Valladolid", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "valladolid", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Valladolid", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Valladolid", "Valladolid de Mechoacan"], "contexts": ["intendancy in Nouvelle-Espagne", "city in New Spain"]}, {"entity_id": "valladolid", "book_id": "polyanthea_medicinal", "name": "Valladolid", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Valladolid"], "contexts": ["location of professorship"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Valladolid", "target_book": "polyanthea_medicinal", "target_name": "Valladolid", "similarity": 1.0}], "id": 4066, "stable_key": "clu_cf1af73a0a5822d0", "ground_truth": {"wikipedia_extract": "Valladolid ( VAL-\u0259-d\u0259-LID; Spanish: [ba\u028ea\u00f0o\u02c8li\u00f0] ) is a city in Spain and the largest city as well as primary seat of government and de facto capital of the autonomous community of Castile and Le\u00f3n. It is also the capital of the province of Valladolid. With a population of 299,816, it is the 13th largest municipality in Spain. The city is located roughly in the centre of the northern half of the Iberian Peninsula's Meseta Central, at the confluence of the Pisuerga and Esgueva rivers 15 km (9.3 mi) before they join the Duero, surrounded by winegrowing areas. The area was settled in pre-Roman times by the Celtic Vaccaei people, and then by Romans themselves. The settlement was purportedly founded after 1072, growing in prominence within the context of the Crown of Castile, being endowed with fairs and different institutions such as a collegiate church, University (1241), Royal Court and Chancellery and a royal mint."}}, {"canonical_name": "Malte-Brun", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "malte-brun", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Malte-Brun", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Malte-Brun", "Malte- Brun"], "contexts": ["compared idol to celestial spirits", "author of G\u00e9ogr."]}, {"entity_id": "malte-brun", "book_id": "kosmos_humboldt_1845", "name": "Malte-Brun", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Malte-Brun"], "contexts": ["editor of travel annals"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Malte-Brun", "target_book": "kosmos_humboldt_1845", "target_name": "Malte-Brun", "similarity": 1.0}], "id": 4067, "stable_key": "clu_202d4e4829ce4de3", "ground_truth": {"modern_name": "Conrad Malte-Brun", "confidence": "high", "type": "person", "birth_year": 1775, "death_year": 1826, "description": "Danish-French geographer and writer, editor of 'Annales des voyages'.", "wikidata_id": "Q980235", "wikidata_description": "Dano-French geographer", "wikipedia_url": "https://en.wikipedia.org/wiki/Conrad%20Malte-Brun", "wikipedia_extract": "Conrad Malte-Brun (French: [k\u0254\u0303\u0281ad malt b\u0281\u0153\u0303]; born Malthe Conrad Bruun; 12 August 1775 \u2013 14 December 1826), sometimes referred to simply as Malte-Brun, was a Dano-French geographer and journalist. His second son, Victor Adolphe Malte-Brun, was also a geographer. Today he is perhaps best remembered for coining the name for both the geographic regions of Oceania (French Oc\u00e9anie) around 1812 and Indo-China in 1804. Born in Thisted to an administrator of Danish crown lands, Malte-Brun was originally destined for a career as a pastor, but chose instead to attend classes at the University of Copenhagen, and became a supporter of the French Revolution and an activist in favor of freedom of the press. Following the harsh censorship laws instituted by the Danish ruler crown prince Frederick in September 1799, he was indicted because of his many pamphlets which contained outright criticism of the government, which the new censorship laws forbade. A particular cause for offence was a pamphlet he published in 1795 entitled \"Catechism of the Aristocrats.\" The case of Peter Andreas Heiberg, who for similar crimes had been sentenced to exile at Christmas of 1799, did not make Malte-Brun optimistic about his prospects."}}, {"canonical_name": "Alexandre VI", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "alexandre_vi", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Alexandre VI", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["Alexandre VI", "pape Alexandre VI"], "contexts": ["pope who issued a bull", "Pope who issued a decree in favor of Spain"]}, {"entity_id": "alexandre_vi", "book_id": "coloquios_da_orta_1563", "name": "Alexandre VI", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Alexandre VI"], "contexts": ["Pope who issued a papal bull"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Alexandre VI", "target_book": "coloquios_da_orta_1563", "target_name": "Alexandre VI", "similarity": 1.0}], "id": 4068, "stable_key": "clu_d2859727f57c6b4c", "ground_truth": {"modern_name": "Pope Alexander VI", "confidence": "high", "type": "person", "birth_year": 1431, "death_year": 1503, "description": "Papal authority involved in dividing hemispheres", "wikidata_id": "Q108316", "wikidata_description": "pope of the Catholic Church 1492\u20131503 from the Borgia family (1430/32-1503)", "wikipedia_extract": "Giovanni Borgia, 2nd Duke of Gand\u00eda (Spanish: Juan de Borja; Valencian: Joan Borja; c. 1476 \u2013 14 June 1497) was the second child of Pope Alexander VI and Vannozza dei Cattanei and a member of the House of Borgia. He was the brother of Cesare, Gioffre, and Lucrezia Borgia. Giovanni Borgia was the pope's favourite son, and Alexander VI granted him important positions and honours. He was murdered in Rome on 14 June 1497. The case remained unsolved and is still considered one of the most notorious scandals of the Borgia era.", "wikipedia_url": "https://en.wikipedia.org/wiki/Pope_Alexander_VI"}}, {"canonical_name": "Huaura", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "huaura", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Huaura", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Huaura", "Huauta"], "contexts": ["city in Peru", "geographic location"]}, {"entity_id": "huaura", "book_id": "kosmos_humboldt_1845", "name": "Huaura", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Huaura"], "contexts": ["location in Peru"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Huaura", "target_book": "kosmos_humboldt_1845", "target_name": "Huaura", "similarity": 1.0}], "id": 4069, "stable_key": "clu_956786a2d775131a", "ground_truth": {"modern_name": "Huaura", "confidence": "high", "type": "place", "country": "Peru"}}, {"canonical_name": "Buch", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "buch", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Buch", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Buch", "Buchanan"], "contexts": ["author of geographical letter", "scholar who published observations on Tyrol"]}, {"entity_id": "von_buch", "book_id": "kosmos_humboldt_1845", "name": "Von Buch", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Von Buch"], "contexts": ["with Gay-Lussac and Von Buch"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Buch", "target_book": "kosmos_humboldt_1845", "target_name": "Von Buch", "similarity": 0.906}], "id": 4070, "stable_key": "clu_b631e9c95585c261-2", "ground_truth": {"modern_name": "Leopold von Buch", "confidence": "high", "type": "person", "birth_year": 1774, "death_year": 1853, "description": "German geologist and naturalist, known for volcanology and geognosy.", "wikidata_id": "Q101563992", "wikidata_description": "street in Angerm\u00fcnde, Brandenburg, Germany"}}, {"canonical_name": "nummulites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "nummulites", "book_id": "relation_historique_humboldt_vol3_1825", "name": "nummulites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["nummulites", "nu\u0153mulites"], "contexts": ["fossil foraminifera", "fossil found in coarse limestone"]}, {"entity_id": "nummulites", "book_id": "kosmos_humboldt_1845", "name": "Nummulites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Nummulites"], "contexts": ["fossil foraminifera"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "nummulites", "target_book": "kosmos_humboldt_1845", "target_name": "Nummulites", "similarity": 0.984}], "id": 4071, "stable_key": "clu_9ea4e6d929c802b5", "ground_truth": {"modern_name": "Nummulites", "confidence": "high", "type": "animal", "note": "Nummulites are extinct marine protozoa, commonly found as fossils, which fits the description of fossil foraminifera.", "wikidata_id": "Q1604065", "wikidata_description": "genus of foraminifera", "wikipedia_url": "https://en.wikipedia.org/wiki/Nummulite", "wikipedia_extract": "A nummulite is a large lenticular fossil, characterised by its numerous coils, subdivided by septa into chambers. They are the shells of the fossil and present-day marine protozoan Nummulites, a type of foraminiferan. Nummulites commonly vary in diameter from 13 to 50 mm (0.51 to 1.97 in)  and are common in Eocene to Miocene marine rocks, particularly around southwest Asia and the Mediterranean in the area that once constituted the Tethys Ocean, such as Eocene limestones from Egypt or from Pakistan. Fossils up to six inches wide are found in the Middle Eocene rocks of Turkey. They are valuable as index fossils. The ancient Egyptians used nummulite shells as coins and the pyramids were constructed using limestone that contained nummulites."}}, {"canonical_name": "l\u00e9gislation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "l\u00e9gislation", "book_id": "relation_historique_humboldt_vol3_1825", "name": "l\u00e9gislation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["l\u00e9gislation"], "contexts": ["system of laws", "abstract concept"]}, {"entity_id": "legislation", "book_id": "kosmos_humboldt_1845", "name": "legislation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["legislation"], "contexts": ["process of making laws"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "l\u00e9gislation", "target_book": "kosmos_humboldt_1845", "target_name": "legislation", "similarity": 0.928}], "id": 4072, "stable_key": "clu_f8b0da67dc97e7b6", "ground_truth": {"modern_name": "legislation", "confidence": "high", "type": "concept", "wikidata_id": "Q49371", "wikidata_description": "product of enrolling, enacting, or promulgating law by a legislature, parliament, or analogous governing body; publication type"}}, {"canonical_name": "Theoriques", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "theoriques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Theoriques", "category": "CONCEPT", "subcategory": "THEORY", "count": 3, "variants": ["Theoriques", "th\u00e9ories"], "contexts": ["based on theoretical suppositions", "theoretical suppositions"]}, {"entity_id": "theoretic", "book_id": "principles_of_psychology_james_1890", "name": "theoretic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["theoretic"], "contexts": ["relating to theory"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Theoriques", "target_book": "principles_of_psychology_james_1890", "target_name": "theoretic", "similarity": 0.925}], "id": 4073, "stable_key": "clu_d73dba3c096265f6-3", "ground_truth": {"modern_name": "theory", "confidence": "high", "type": "concept", "description": "An abstract explanation or system of ideas for understanding phenomena.", "note": "'Theoriques' is the French plural of theoretical.", "wikipedia_extract": "A theory is, in general, any hypothesis or set of ideas about something, formed in any number of ways through any sort of reasoning for any sort of reason. When applied to intellectual or academic situations, it is considered a systematic and rational form of abstract thinking about a phenomenon, or the conclusions derived from such thinking. It involves contemplative and logical reasoning, often supported by processes such as observation, experimentation, and research. Theories can be scientific, falling within the realm of empirical and testable knowledge, or they may belong to non-scientific disciplines, such as philosophy, art, or sociology. In some cases, theories may exist independently of any formal discipline. In modern science, the term \"theory\" refers to scientific theories, a well-confirmed type of explanation of nature, made in a way consistent with the scientific method, and fulfilling the criteria required by modern science."}}, {"canonical_name": "villa", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "villa", "book_id": "relation_historique_humboldt_vol3_1825", "name": "villa", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["villa", "Vilela"], "contexts": ["town or small city", "settlement type"]}, {"entity_id": "villas", "book_id": "polyanthea_medicinal", "name": "Villas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Villas"], "contexts": ["towns within the kingdom"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "villa", "target_book": "polyanthea_medicinal", "target_name": "Villas", "similarity": 0.893}], "id": 4074, "stable_key": "clu_5a846f914dda709e", "ground_truth": {"modern_name": "villa", "confidence": "high", "type": "place", "description": "A town or a small city, often with surrounding lands.", "wikipedia_extract": "A villa is a type of house that was originally an ancient Roman upper class country house that provided an escape from urban life. Since its origins in the Roman villa, the idea and function of a villa have evolved considerably. After the fall of the Roman Republic, villas became small farming compounds, which were increasingly fortified in Late Antiquity, sometimes transferred to the Church for reuse as a monastery. They gradually re-evolved through the Middle Ages into elegant upper-class country homes. In the early modern period, any comfortable detached house with a garden near a city or town was likely to be described as a villa; most surviving villas have now been engulfed by suburbia. In modern parlance, \"villa\" can refer to various types and sizes of residences, ranging from the suburban semi-detached double villa to, in some countries, especially around the Mediterranean, residences of above average size in the countryside. the villa urbana, a suburban or country seat that could easily be reached from Rome or another city for a night or two."}}, {"canonical_name": "Amerigo Vespucci", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "amerigo_vespucci", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Amerigo Vespucci", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Amerigo Vespucci"], "contexts": ["explorer and cartographer", "Discoverer of Cape San Augustin"]}, {"entity_id": "amerigo_vespucci", "book_id": "kosmos_humboldt_1845", "name": "Amerigo Vespucci", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Amerigo Vespucci"], "contexts": ["figure in naming of America"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Amerigo Vespucci", "target_book": "kosmos_humboldt_1845", "target_name": "Amerigo Vespucci", "similarity": 0.736}], "id": 4075, "stable_key": "clu_c47dc872d14cde01", "ground_truth": {"modern_name": "Amerigo Vespucci", "confidence": "high", "type": "person", "birth_year": 1454, "death_year": 1512, "description": "Italian explorer, financier, and cartographer.", "wikidata_id": "Q47674", "wikidata_description": "Italian explorer, financier, navigator and cartographer"}}, {"canonical_name": "Halifax", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "halifax", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Halifax", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Halifax"], "contexts": ["origin of a corsair", "city mentioned for lodging"]}, {"entity_id": "halifax", "book_id": "kosmos_humboldt_1845", "name": "Halifax", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Halifax"], "contexts": ["city in Nova Scotia, Canada"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Halifax", "target_book": "kosmos_humboldt_1845", "target_name": "Halifax", "similarity": 1.0}], "id": 4076, "stable_key": "clu_b2901c04e1ee9bde", "ground_truth": {"modern_name": "Halifax", "confidence": "high", "type": "place", "country": "Canada", "wikidata_id": "Q2141", "wikidata_description": "municipality in the province of Nova Scotia, Canada", "wikipedia_extract": "Halifax Shopping Centre, located in Halifax, Nova Scotia, is Atlantic Canada's largest multi-building shopping centre. Opened in 1962 as an enclosed mall anchored by department store Eaton's, the shopping centre is now owned by Primaris REIT. The largest anchor tenants are La Maison Simons, Winners, and Sportchek, while Sobeys and Walmart anchor the Halifax Shopping Centre Annex property across Mumford Road. Halifax Shopping Centre is also home to Mumford Terminal, a Halifax Transit bus interchange. Eaton's applied for rezoning of the property, formerly the site of the St. Patrick's Home, in January 1956, and a public hearing was held on 15 March 1956.", "wikipedia_url": "https://en.wikipedia.org/wiki/Halifax%2C_Nova_Scotia"}}, {"canonical_name": "graphite", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "graphite", "book_id": "relation_historique_humboldt_vol3_1825", "name": "graphite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["graphite"], "contexts": ["mineral layer in rock", "mineral found in rock"]}, {"entity_id": "graphite", "book_id": "connexion_physical_sciences_somerville_1858", "name": "graphite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["graphite"], "contexts": ["amorphous form of carbon"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "graphite", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "graphite", "similarity": 1.0}], "id": 4077, "stable_key": "clu_5ca8e47804c7a214", "ground_truth": {"modern_name": "graphite", "confidence": "high", "type": "mineral", "wikidata_id": "Q5309", "wikidata_description": "allotrope of carbon, mineral, substance"}}, {"canonical_name": "Tuckey", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "tuckey", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tuckey", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Tuckey"], "contexts": ["captain and author of maritime geography", "author of Marit. Geogr."]}, {"entity_id": "tuckey", "book_id": "coloquios_da_orta_1563", "name": "Tuckey", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Tuckey"], "contexts": ["author of Zaire expedition narrative"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tuckey", "target_book": "coloquios_da_orta_1563", "target_name": "Tuckey", "similarity": 0.694}], "id": 4078, "stable_key": "clu_777fa3827517c736", "ground_truth": {"modern_name": "James Hingston Tuckey", "confidence": "high", "type": "person", "birth_year": 1776, "death_year": 1818, "description": "British naval officer and explorer, known for his expedition on the Congo River.", "note": "The mention in 'coloquios_da_orta_1563' seems anachronistic. This likely refers to James Hingston Tuckey, a later figure."}}, {"canonical_name": "Molina", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "molina", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Molina", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Molina"], "contexts": ["author of a history of Chile", "author of a map of Chili"]}, {"entity_id": "molina", "book_id": "kosmos_humboldt_1845", "name": "Molina", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Molina"], "contexts": ["author of Mexican vocabulary"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Molina", "target_book": "kosmos_humboldt_1845", "target_name": "Molina", "similarity": 1.0}], "id": 4079, "stable_key": "clu_a39a80bc4c10ac82", "ground_truth": {"modern_name": "Juan Ignacio Molina", "confidence": "high", "type": "person", "birth_year": 1740, "death_year": 1829, "description": "Chilean naturalist, Jesuit priest, author of botanical and zoological works"}}, {"canonical_name": "Tomsk", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "tomsk", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tomsk", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Tomsk"], "contexts": ["city in Siberia", "city"]}, {"entity_id": "tomsk", "book_id": "kosmos_humboldt_1845", "name": "Tomsk", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Tomsk"], "contexts": ["city in Siberia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tomsk", "target_book": "kosmos_humboldt_1845", "target_name": "Tomsk", "similarity": 1.0}], "id": 4080, "stable_key": "clu_5ca3f816e83aa17c", "ground_truth": {"modern_name": "Tomsk", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q976", "wikidata_description": "city in and administrative center of Tomsk Oblast, Russia", "wikipedia_extract": "Seversk (Russian: \u0421\u0435\u0301\u0432\u0435\u0440\u0441\u043a, IPA: [\u02c8s\u02b2ev\u02b2\u026arsk]) is a closed city in Tomsk Oblast, Russia, located 15 kilometers (9.3 mi) northwest of Tomsk on the right bank of the Tom River. The population was 108,590 at the 2010 census and 109,106 at the 2002 census. It was previously known as Pyaty Pochtovy (until 1949) and Tomsk-7 (until 1992). The city is located 15 kilometers (9.3 miles) northwest of Tomsk on the right bank of the Tom River. Seversk has a humid continental climate (K\u00f6ppen climate classification Dfb) with warm summer. The annual average temperature is 0.6 \u00b0C (33.1 \u00b0F).", "wikipedia_url": "https://en.wikipedia.org/wiki/Tomsk"}}, {"canonical_name": "Campo de Gigantes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "campo_de_gigantes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Campo de Gigantes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Campo de Gigantes"], "contexts": ["Campo de Gigantes", "field near Suacha with Mastodon bones"]}, {"entity_id": "campo_de_gigantes", "book_id": "kosmos_humboldt_1845", "name": "Campo de Gigantes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Campo de Gigantes"], "contexts": ["field name with giant bones"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Campo de Gigantes", "target_book": "kosmos_humboldt_1845", "target_name": "Campo de Gigantes", "similarity": 1.0}], "id": 4081, "stable_key": "clu_fa9bb51b9bd2d34f", "ground_truth": {"modern_name": "Field of Giants", "confidence": "medium", "type": "place", "country": "Unknown", "note": "The exact geographical location referred to as 'Campo de Gigantes' is unclear from the provided context. It is described as a place with 'giant bones', suggesting it might be a paleontological site, but its modern identifier is not readily available.", "wikipedia_extract": "Giants Stadium (sometimes referred to as Giants Stadium at the Meadowlands) was a stadium located in East Rutherford, New Jersey, in the Meadowlands Sports Complex. The venue was open from 1976 to 2010, and primarily hosted sporting events and concerts. It was the home field of the New York metropolitan area's two National Football League teams, the New York Giants (from 1976 to 2009) and the New York Jets (from 1984 to 2009). It also was the home field of two New York metro area professional soccer teams, the NASL's New York Cosmos (from 1977 to 1984) and Major League Soccer's New York Red Bulls (from 1996 to 2009). The stadium's maximum seating capacity was 80,242. The structure was 756 feet (230 m) long, 592 feet (180 m) wide and 144 feet (44 m) high from service level to the top of the seating bowl and 178 feet (54 m) high to the top of the south tower.", "wikipedia_url": "https://en.wikipedia.org/wiki/Giants_Stadium"}}, {"canonical_name": "orthoc\u00e9ratites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "orthoc\u00e9ratites", "book_id": "relation_historique_humboldt_vol3_1825", "name": "orthoc\u00e9ratites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["orthoc\u00e9ratites"], "contexts": ["extinct marine cephalopod genus", "fossil organism, first traces of organization"]}, {"entity_id": "orthoceraitites", "book_id": "kosmos_humboldt_1845", "name": "Orthoceraitites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Orthoceraitites"], "contexts": ["fossil cephalopod genus"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "orthoc\u00e9ratites", "target_book": "kosmos_humboldt_1845", "target_name": "Orthoceraitites", "similarity": 0.911}], "id": 4082, "stable_key": "clu_dca80e26c3d05e5f", "ground_truth": {"modern_name": "Orthoceras", "confidence": "high", "type": "animal", "note": "Orthocerida is an extinct suborder of nautiloid cephalopods, and 'Orthocerates' refers to fossils of these creatures. The context of 'fossil cephalopod genus' confirms this.", "wikidata_id": "Q3906531", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Orthoceras%20%28plant%29", "wikipedia_extract": "Orthoceras, from Ancient Greek \u1f40\u03c1\u03b8\u03cc\u03c2 (orth\u00f3s), meaning \"straight\", and \u03ba\u03ad\u03c1\u03b1\u03c2 (k\u00e9ras), meaning \"horn\", is a genus of extinct nautiloid cephalopod restricted to Middle Ordovician-aged marine limestones of the Baltic States and Sweden. This genus is sometimes called Orthoceratites and misspelled as Orthocera, Orthocerus, or Orthoceros. Orthoceras was formerly thought to have had a worldwide distribution due to the genus' use as a wastebasket taxon for numerous species of conical-shelled nautiloids throughout the Paleozoic and Triassic. Since this work was carried out and re-cataloging of the genus, Orthoceras sensu stricto refers to Orthoceras regulare, of Ordovician-aged Baltic Sea limestones of Sweden and neighboring areas. These are slender, elongate shells with the middle of the body chamber transversely constricted, and a subcentral orthochoanitic siphuncle. The surface is ornamented by a network of fine lirae (Sweet 1964:K224)."}}, {"canonical_name": "Harris", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "harris", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Harris", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Harris"], "contexts": ["gave magnetic declination value", "mentioned in relation to astronomical observations"]}, {"entity_id": "harris", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Harris", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Harris"], "contexts": ["experiments in electricity"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Harris", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Harris", "similarity": 1.0}], "id": 4083, "stable_key": "clu_15238fbb7e3e88f1-2", "ground_truth": {"modern_name": "Sir William Rowan Hamilton", "confidence": "high", "type": "person", "birth_year": 1805, "death_year": 1865, "description": "Irish physicist, mathematician, and astronomer. Important for quaternions and optics.", "note": "While 'Hamilton' is ambiguous, James and Spencer were prominent thinkers influenced by or engaging with scientific developments. William Rowan Hamilton was a major figure in mathematics and physics in the 19th century, whose work could be referenced in philosophical discussions of principles.", "wikidata_id": "Q11887", "wikidata_description": "Irish mathematician and astronomer (1805-1865)"}}, {"canonical_name": "Aldebaran", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "aldebaran", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Aldebaran", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["Aldebaran"], "contexts": ["star occultation observed", "star used for occultation calculations"]}, {"entity_id": "aldebaran", "book_id": "kosmos_humboldt_1845", "name": "Aldebaran", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Aldebaran"], "contexts": ["star in Taurus constellation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Aldebaran", "target_book": "kosmos_humboldt_1845", "target_name": "Aldebaran", "similarity": 1.0}], "id": 4084, "stable_key": "clu_ab4d135c4d0f3605", "ground_truth": {"modern_name": "Aldebaran", "confidence": "high", "type": "star", "note": "While 'animal' is given as a subcategory, the context clearly points to the star Aldebaran in the constellation Taurus. This is a clear case of miscategorization in the provided data.", "wikidata_id": "Q2623410", "wikidata_description": "French robotics company", "wikipedia_url": "https://en.wikipedia.org/wiki/Aldebaran%20%28company%29"}}, {"canonical_name": "Pinus occidentalis", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "pinus_occidentalis", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pinus occidentalis", "category": "PLANT", "subcategory": "TREE", "count": 3, "variants": ["Pinus occidentalis"], "contexts": ["pine tree found in Cuba", "species of pine tree"]}, {"entity_id": "pinus_occidentalis", "book_id": "kosmos_humboldt_1845", "name": "Pinus occidentalis", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Pinus occidentalis"], "contexts": ["pine tree in Mexico"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pinus occidentalis", "target_book": "kosmos_humboldt_1845", "target_name": "Pinus occidentalis", "similarity": 1.0}], "id": 4085, "stable_key": "clu_ffb3656bdd3bfe86", "ground_truth": {"modern_name": "Pinus occidentalis", "confidence": "high", "type": "plant", "linnaean": "Pinus occidentalis Sw.", "family": "Pinaceae", "wikidata_id": "Q3388586", "wikidata_description": "species of plant, Hispaniolan Pine", "wikipedia_url": "https://en.wikipedia.org/wiki/Pinus%20occidentalis", "wikipedia_extract": "Pinus occidentalis, also known as the Hispaniolan pine, Hispaniola pine or pino criollo, is a pine tree endemic to the island of Hispaniola (split between the Dominican Republic and Haiti). It is the eponymous species of the Hispaniolan pine forests ecosystem, in which it constitutes a majority of the biomass present. Another endemic species, the Hispaniolan crossbill (Loxia megaplaga), feeds almost exclusively on the cones of P. occidentalis."}}, {"canonical_name": "liqueurs", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "liqueurs", "book_id": "relation_historique_humboldt_vol3_1825", "name": "liqueurs", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["liqueurs"], "contexts": ["alcoholic beverage imported and exported", "liquors"]}, {"entity_id": "liquefatti", "book_id": "ricettario_fiorentino_1597", "name": "liquefatti", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["liquefatti"], "contexts": ["liquefied substances"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "liqueurs", "target_book": "ricettario_fiorentino_1597", "target_name": "liquefatti", "similarity": 0.906}], "id": 4086, "stable_key": "clu_a9a119e211b9679a", "ground_truth": {"modern_name": "Liqueurs", "confidence": "high", "type": "chemical", "wikidata_id": "Q106326520", "wikidata_description": "1848 United Kingdom of Great Britain and Ireland Act of Parliament 11 & 12 Vic c. 121"}}, {"canonical_name": "Sat.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "sat_", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sat.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Sat."], "contexts": ["satellite"]}, {"entity_id": "sat_", "book_id": "kosmos_humboldt_1845", "name": "Sat.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Sat."], "contexts": ["Macrobius's work"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sat.", "target_book": "kosmos_humboldt_1845", "target_name": "Sat.", "similarity": 1.0}], "id": 4087, "stable_key": "clu_2c3712463b813c8e", "ground_truth": {"modern_name": "Satellite", "confidence": "low", "type": "animal", "note": "The contexts 'celestial bodies orbiting planets' clearly indicate this is a celestial object, not an animal. The term 'satellite' in an animal context would be highly unusual and likely metaphorical, with no clear referent without more information.", "wikidata_id": "Q2537", "wikidata_description": "celestial body that orbits a planet or other smaller body in turn directly orbiting a star", "wikipedia_url": "https://en.wikipedia.org/wiki/Natural%20satellite", "wikipedia_extract": "A natural satellite is, in the most common usage, an astronomical body that orbits a planet, dwarf planet, or small Solar System body (or sometimes another natural satellite). Natural satellites are colloquially referred to as moons, a derivation from the Moon of Earth. In the Solar System, there are six planetary satellite systems, altogether comprising 419 natural satellites with confirmed orbits. Seven objects commonly considered dwarf planets by astronomers are also known to have natural satellites: Orcus, Pluto, Haumea, Quaoar, Makemake, Gonggong, and Eris. As of January 2022, there are 447 other minor planets known to have natural satellites. The first known natural satellite was the Moon, but it was considered a \"planet\" until Copernicus' introduction of De revolutionibus orbium coelestium in 1543."}}, {"canonical_name": "Saratow", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "saratow", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Saratow", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Saratow"], "contexts": ["city for observation", "city in Russia"]}, {"entity_id": "saratow", "book_id": "kosmos_humboldt_1845", "name": "Saratow", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Saratow"], "contexts": ["city in Eastern Russia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saratow", "target_book": "kosmos_humboldt_1845", "target_name": "Saratow", "similarity": 1.0}], "id": 4088, "stable_key": "clu_5206bf02277f1687", "ground_truth": {"modern_name": "Saratov", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q5332", "wikidata_description": "city in Saratov Oblast, Russia", "wikipedia_extract": "Saratov (UK:  s\u0259-RAH-tof, US:  -\u2060t\u0259f; Russian: \u0421\u0430\u0440\u0430\u0442\u043e\u0432, pronounced [s\u0250\u02c8rat\u0259f] ) is the largest city and administrative center of Saratov Oblast, Russia, and a major port on the Volga River. As of the 2021 Census, Saratov had a population of 901,361, making it the 17th-largest city in Russia by population. Saratov is 389 kilometres (242 mi) north of Volgograd, 442 kilometres (275 mi) south of Samara, and 858 kilometres (533 mi) southeast of Moscow. The city stands near the site of Uvek, a city of the Golden Horde. Tsar Feodor I of Russia likely developed Saratov as a fortress to secure Russia's southeastern border. Saratov developed as a shipping port along the Volga and was historically important to the Volga Germans, who settled in large numbers in the city before they were expelled before and during World War II."}}, {"canonical_name": "Memorias", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "memorias", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Memorias", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Memorias", "Memorias de los Navcgantes"], "contexts": ["book with astronomical data", "title of a work"]}, {"entity_id": "memorias", "book_id": "coloquios_da_orta_1563", "name": "Memorias", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Memorias"], "contexts": ["memoirs written by B\u00e1ber", "writings by B\u00e1ber"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Memorias", "target_book": "coloquios_da_orta_1563", "target_name": "Memorias", "similarity": 1.0}], "id": 4089, "stable_key": "clu_aad6984540b53d7b", "ground_truth": {"modern_name": "Memoirs", "confidence": "high", "type": "text", "note": "This refers to written accounts or records, fitting the context of 'book with astronomical data' and 'memoirs written by B\u00e1ber'.", "wikidata_id": "Q2963729", "wikidata_description": "book on China compiled by Athanasius Kircher from various Jesuit reports"}}, {"canonical_name": "la Cyr\u00e9na\u00efque", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "la_cyr\u00e9na\u00efque", "book_id": "relation_historique_humboldt_vol3_1825", "name": "la Cyr\u00e9na\u00efque", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["la Cyr\u00e9na\u00efque", "Cyr\u00e9na\u00efque"], "contexts": ["region in North Africa", "ancient region in North Africa"]}, {"entity_id": "cyrenaica", "book_id": "coloquios_da_orta_1563", "name": "Cyrenaica", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Cyrenaica"], "contexts": ["peninsula in North Africa", "ancient region in North Africa"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "la Cyr\u00e9na\u00efque", "target_book": "coloquios_da_orta_1563", "target_name": "Cyrenaica", "similarity": 0.94}], "id": 4090, "stable_key": "clu_d22880d3df0241c6", "ground_truth": {"modern_name": "Cyrenaica", "confidence": "high", "type": "place", "country": "Libya", "wikidata_id": "Q165198", "wikidata_description": "eastern coastal region of Libya", "wikipedia_extract": "Cyrenaica ( SY-r\u0259-NAY-ik-\u0259-,-SIRR-\u0259) or Kyrenaika (Arabic: \u0628\u0631\u0642\u0629, romanized: Barqah, Koine Greek: \u039a\u03c5\u03c1\u03b7\u03bd\u03b1\u03ca\u03ba\u03ae [\u1f10\u03c0\u03b1\u03c1\u03c7\u03af\u03b1], romanized: K\u016br\u0113na\u00efk\u1e17 [eparkh\u00ed\u0101], after the city of Cyrene), is the eastern region of Libya. Cyrenaica includes all of the eastern part of Libya between the 16th and 25th meridians east, including the Kufra District. The coastal region, also known as Pentapolis (\"Five Cities\") in antiquity, was part of the Roman province of Crete and Cyrenaica, later divided into Libya Pentapolis and Libya Sicca. During the Islamic period, the area came to be known as Barqa, after the city of Barca. Cyrenaica became an Italian colony in 1911. After the 1934 formation of Italian Libya, the Cyrenaica province was designated as one of the three primary provinces of the country.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cyrenaica"}}, {"canonical_name": "Bali", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "bali", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bali", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Bali", "Baliamas"], "contexts": ["island in Indonesia", "islands mentioned in relation to Gulf-stream"]}, {"entity_id": "bali", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bali", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Bali"], "contexts": ["island where catastrophe occurred in 1808", "location of volcanic eruption"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bali", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bali", "similarity": 1.0}], "id": 4091, "stable_key": "clu_8cef345e6dbe00ff", "ground_truth": {"modern_name": "Bali", "confidence": "high", "type": "place", "country": "Indonesia"}}, {"canonical_name": "Krusenstern", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "krusenstern", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Krusenstern", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Krusenstern", "Krusensiern"], "contexts": ["leader of a voyage", "scholar cited for hydrographic memoirs"]}, {"entity_id": "krusenstern", "book_id": "kosmos_humboldt_1845", "name": "Krusenstern", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Krusenstern"], "contexts": ["saw fire-ball train shine for an hour", "cited for geographical data"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Krusenstern", "target_book": "kosmos_humboldt_1845", "target_name": "Krusenstern", "similarity": 1.0}], "id": 4092, "stable_key": "clu_40410ec9c64793d6", "ground_truth": {"modern_name": "Adam Johann von Krusenstern", "confidence": "high", "type": "person", "birth_year": 1770, "death_year": 1846, "description": "Estonian-Russian navigator and admiral who led the first Russian circumnavigation.", "wikidata_id": "Q160888", "wikidata_description": "Baltic German admiral and explorer in Russian service, who led the first Russian circumnavigation of the globe (1770\u20131846)"}}, {"canonical_name": "Hatuey", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "hatuey", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Hatuey", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Hatuey", "Hatney"], "contexts": ["Cacique against whom war was waged", "cacique who fled from Haiti"]}, {"entity_id": "hatty", "book_id": "coloquios_da_orta_1563", "name": "Hatty", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Hatty"], "contexts": ["author of Trait\u00e9 de mineralogie", "cited author on mineralogy"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hatuey", "target_book": "coloquios_da_orta_1563", "target_name": "Hatty", "similarity": 0.884}], "id": 4093, "stable_key": "clu_d5371aa06e17d48f", "ground_truth": {"modern_name": "Hatuey", "confidence": "high", "type": "person", "death_year": 1512, "description": "Ta\u00edno cacique, led rebellion against Spanish conquistadors", "note": "The 'author of Trait\u00e9 de mineralogie' is likely a misattribution or an error in the source text's contextualization of Hatuey.", "wikidata_id": "Q540324", "wikidata_description": "hispaniolan Cacique (died 1512)", "wikipedia_url": "https://en.wikipedia.org/wiki/Hatuey", "wikipedia_extract": "Hatuey (), also Hat\u00fcey (; died February 2, 1512), was a Ta\u00edno Cacique (chief) of the Hispaniolan cacicazgo of Guanaba (in present-day La Gonave, Haiti). He lived from the late 15th until the early 16th century. Chief Hatuey and many of his tribesmen travelled from present-day La Gonave by canoe to Cuba to warn the Ta\u00edno in Cuba about the Spaniards that were arriving to conquer the island. He later attained legendary status for leading a group of natives in a fight against the invasion of the Spaniards, thus becoming one of the first fighters against Spanish colonialism in the New World. He is celebrated as \"Cuba's first national hero\". In 1511, Diego Vel\u00e1zquez set out from Hispaniola to conquer what is now known as present-day La Gonave, Haiti and Dominican Republic to subjugate the indigenous people, the Ta\u00edno,  who had previously been recorded by Christopher Columbus."}}, {"canonical_name": "cigarros", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "cigarros", "book_id": "relation_historique_humboldt_vol3_1825", "name": "cigarros", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["cigarros", "cigares"], "contexts": ["rolled tobacco product", "tobacco product"]}, {"entity_id": "cigarette", "book_id": "principles_of_psychology_james_1890", "name": "cigarette", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["cigarette"], "contexts": ["tobacco product", "object that produces smoke"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "cigarros", "target_book": "principles_of_psychology_james_1890", "target_name": "cigarette", "similarity": 0.918}], "id": 4094, "stable_key": "clu_321fef9805c4e71d", "ground_truth": {"modern_name": "cigar", "confidence": "high", "type": "object", "note": "The term 'cigarette' is also present in the cluster, but 'cigarros' is the primary term and directly translates to 'cigars'.", "wikidata_id": "Q1346603", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Cigaritis", "wikipedia_extract": "Cigaritis is a genus of butterflies in the family Lycaenidae. Its species are found in the Afrotropical realm, the Indomalayan realm and adjacent regions of Asia. Cigaritis includes species that used to be placed in two other genera: Apharitis Riley, 1925 and Spindasis Wallengren, 1857. The latter were synonymised with Cigaritis by Heath et al., 2002, and this synonymy is followed in recent works. Cigaritis arooni (Murayama & Kimura, 1990) northern Thailand Cigaritis baghirmii (Stempffer, 1946) Cigaritis bergeri (Bouyer, 2003) DRC, Katanga, Sandoa Cigaritis buchanani (Rothschild, 1921) Cigaritis ducarmei (Bouyer, 2008) Congo Cigaritis dufranei (Bouyer, 1991) Za\u00efre Cigaritis elima (Moore, 1877) India and Sri Lanka Cigaritis elwesi Evans, [1925] northwestern India Cigaritis epargyros (Eversmann, 1854) Arabia, Afghanistan and northern China Cigaritis evansii (Tytler, 1915) India ( Assam) Cigaritis greeni (Heron, 1896) Sri Lanka Cigaritis ictis (Hewitson, 1865) Sri Lanka and India Cigaritis junodi (D'Abrera, 1980) South Africa Cigaritis kutu (Corbet, 1940) Malaysia Cigaritis kuyaniana (Matsumura, 1919) Taiwan Cigaritis larseni (Bouyer, 2012) Cameroon to Ghana Cigaritis learmondi (Tytler, 1940) Myanmar and Thailand Cigaritis leechi (Swinhoe, 1912) China Cigaritis lilacinus (Moore, 1884) Myanmar Cigaritis lohita (Horsfield, [1829]) Cigaritis lunulifera (Moore, 1879) India Cigaritis lutosus (Pl\u00f6tz, 1880) Ghana Cigaritis maximus (Elwes, [1893]) Myanmar, Thailand and Laos Cigaritis meghamalaiensis Sadasivan & Naicker, 2023 Southern India (Western Ghats) [= Cigaritis conjuncta Kunte & Sengupta, 2024, See Sadasivan & Sengupta, 2024]."}}, {"canonical_name": "palmeta", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "palmeta", "book_id": "relation_historique_humboldt_vol3_1825", "name": "palmeta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["palmeta", "palmito"], "contexts": ["palm groves mentioned by historians", "cylinders carried by Zambos"]}, {"entity_id": "palmeta", "book_id": "kosmos_humboldt_1845", "name": "palmeta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["palmeta"], "contexts": ["term for palm trees", "plant associated with pineta"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "palmeta", "target_book": "kosmos_humboldt_1845", "target_name": "palmeta", "similarity": 1.0}], "id": 4095, "stable_key": "clu_a0b8e7c12cda39ae-4", "ground_truth": {"modern_name": "Palm tree", "confidence": "high", "type": "plant", "family": "Arecaceae", "note": "Palma is the direct Spanish and Italian word for palm. Given the contexts, it refers to the plant family or specific trees within it.", "wikidata_id": "Q14080", "wikidata_description": "family of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Arecaceae", "wikipedia_extract": "The Arecaceae () are a family of perennial, flowering plants in the monocot order Arecales. Their growth form can be climbers, shrubs, tree-like and stemless plants, all commonly known as palms. Those having a tree-like form are colloquially called palm trees. Currently, 181 genera with around 2,600 species are known, most of which are restricted to tropical and subtropical climates. Most palms are distinguished by their large, compound, evergreen leaves, known as fronds, arranged at the top of an unbranched stem, except for the Hyphaene genus, which has branched palms. However, palms exhibit an enormous diversity in physical characteristics and inhabit nearly every type of habitat within their range, from rainforests to deserts."}}, {"canonical_name": "Syrie", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "syrie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Syrie", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Syrie"], "contexts": ["region with deserts", "region with sugar consumption"]}, {"entity_id": "assyrian", "book_id": "first_principles_spencer_1862", "name": "Assyrian", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Assyrian"], "contexts": ["ancient civilization known for architecture", "ancient civilization"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Syrie", "target_book": "first_principles_spencer_1862", "target_name": "Assyrian", "similarity": 0.902}], "id": 4096, "stable_key": "clu_29fc195ded1550cf", "ground_truth": {"modern_name": "Syria", "confidence": "high", "type": "place", "description": "A region in the Middle East.", "wikipedia_extract": "Syria, officially the Syrian Arab Republic, is a country in West Asia located in the Eastern Mediterranean and the Levant. It borders the Mediterranean Sea to the west, Turkey to the north and northwest, Iraq to the east and southeast, Jordan to the south, and Israel and Lebanon to the southwest. It is a republic under a provisional government and comprises 14 governorates. Damascus is the capital and largest city. With a population of 26 million across an area of 185,180 square kilometres (71,500 sq mi), it is the 56th-most populous and 87th-largest country. The name \"Syria\" historically referred to a wider region."}}, {"canonical_name": "Puerta", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "puerta", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Puerta", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Puerta"], "contexts": ["location near Merida and Truxillo"]}, {"entity_id": "gate", "book_id": "coloquios_da_orta_1563", "name": "Gate", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Gate"], "contexts": ["name of a mountain range", "a type of mountain"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Puerta", "target_book": "coloquios_da_orta_1563", "target_name": "Gate", "similarity": 0.939}], "id": 4097, "stable_key": "clu_692662591e79b53b", "ground_truth": {"wikipedia_extract": "The gates of Intramuros refer to the original eight gates of the Walled City of Intramuros in Manila, built during the Spanish colonial era in the Philippines. The gates are called by the original Spanish word for \"gate\", puerta (plural: puertas). This gate was built in 1662 as the governor-general's gate when the first governor's palace was still located in Fort Santiago. It was destroyed during an earthquake and was never rebuilt. Postigo means \"postern\" or a small gate in Spanish. This gate was named after the nearby Palacio del Gobernador."}}, {"canonical_name": "Moluques", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "moluques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Moluques", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Moluques"], "contexts": ["Islands claimed as Castilian domain", "archipelago in Indonesia"]}, {"entity_id": "moluccas", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Moluccas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Moluccas"], "contexts": ["islands in Indonesia", "islands affected by eruption"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Moluques", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Moluccas", "similarity": 0.908}], "id": 4098, "stable_key": "clu_c1c2ff58eddc5d49", "ground_truth": {"modern_name": "Moluccas", "confidence": "high", "type": "place", "country": "Indonesia"}}, {"canonical_name": "Meisner", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "meisner", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Meisner", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Meisner"], "contexts": ["author cited", "author of a text"]}, {"entity_id": "meissner", "book_id": "coloquios_da_orta_1563", "name": "Meissner", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Meissner"], "contexts": ["author cited in D. C. Prodromus", "described Nectandra cinnamomoides"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Meisner", "target_book": "coloquios_da_orta_1563", "target_name": "Meissner", "similarity": 0.841}], "id": 4099, "stable_key": "clu_7d2538ef61211134", "ground_truth": {"modern_name": "Bartholom\u00e4us Meisner", "confidence": "medium", "type": "person", "birth_year": 1588, "death_year": 1653, "description": "German Lutheran theologian and scholar.", "note": "The spelling variations and citation in historical texts suggest a specific academic figure. Bartholomew Meisner (1588-1653) is a strong candidate, though confirmation requires direct text analysis."}}, {"canonical_name": "biblioth\u00e8que publique", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "biblioth\u00e8que_publique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "biblioth\u00e8que publique", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["biblioth\u00e8que publique"], "contexts": ["public library founded by the governor", "public collection of books"]}, {"entity_id": "bibliothec\u00e6", "book_id": "polyanthea_medicinal", "name": "Bibliothec\u00e6", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Bibliothec\u00e6"], "contexts": ["library", "book or collection"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "biblioth\u00e8que publique", "target_book": "polyanthea_medicinal", "target_name": "Bibliothec\u00e6", "similarity": 0.893}], "id": 4100, "stable_key": "clu_6267ccccb37a1e4c", "ground_truth": {"modern_name": "Public library", "confidence": "high", "type": "object", "wikidata_id": "Q28564", "wikidata_description": "free community resource offering access to books, media, and information, promoting literacy and education for all ages"}}, {"canonical_name": "monoth\u00e9isme", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "monoth\u00e9isme", "book_id": "relation_historique_humboldt_vol3_1825", "name": "monoth\u00e9isme", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["monoth\u00e9isme"], "contexts": ["belief in one God", "belief in a Great Spirit"]}, {"entity_id": "monotheism", "book_id": "first_principles_spencer_1862", "name": "Monotheism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Monotheism"], "contexts": ["religion with wholly generalized personalities"]}, {"entity_id": "monotheistic", "book_id": "first_principles_spencer_1862", "name": "Monotheistic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Monotheistic"], "contexts": ["religious belief in one god"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "monoth\u00e9isme", "target_book": "first_principles_spencer_1862", "target_name": "Monotheism", "similarity": 0.982}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "monoth\u00e9isme", "target_book": "first_principles_spencer_1862", "target_name": "Monotheistic", "similarity": 0.947}], "id": 4101, "stable_key": "clu_8d2480c439e4a626", "ground_truth": {"modern_name": "monotheism", "confidence": "high", "type": "concept"}}, {"canonical_name": "Beta vulgaris", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "beta_vulgaris", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Beta vulgaris", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Beta vulgaris"], "contexts": ["scientific name for beetroot", "plant compared to sugarcane"]}, {"entity_id": "beta", "book_id": "polyanthea_medicinal", "name": "Beta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Beta", "betas"], "contexts": ["ingredient for making pills", "plant used in decoction"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Beta vulgaris", "target_book": "polyanthea_medicinal", "target_name": "Beta", "similarity": 0.903}], "id": 4102, "stable_key": "clu_ce1370e1c19e45bc", "ground_truth": {"modern_name": "Beetroot", "confidence": "high", "type": "plant", "linnaean": "Beta vulgaris Linnaeus", "family": "Amaranthaceae", "wikidata_id": "Q2240448", "wikidata_description": "subspecies of plants"}}, {"canonical_name": "Saccharum ofBcinarum", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "saccharum_ofbcinarum", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Saccharum ofBcinarum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Saccharum ofBcinarum"], "contexts": ["scientific name for sugarcane", "sugarcane plant"]}, {"entity_id": "saccharum", "book_id": "polyanthea_medicinal", "name": "Saccharum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Saccharum"], "contexts": ["sweet substance, possibly sugar"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saccharum ofBcinarum", "target_book": "polyanthea_medicinal", "target_name": "Saccharum", "similarity": 0.898}], "id": 4103, "stable_key": "clu_ca11f2b2414a3ac5-2", "ground_truth": {"modern_name": "Sugarcane", "confidence": "high", "type": "plant", "linnaean": "Saccharum officinarum Linnaeus", "family": "Poaceae", "note": "The text contains 'Saccharum ofBcinarum', which is likely a OCR error for 'Saccharum officinarum'.", "wikidata_id": "Q3391243", "wikidata_description": "species of plant"}}, {"canonical_name": "aldeas", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "aldeas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "aldeas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["aldeas"], "contexts": ["small rural settlements", "settlement type"]}, {"entity_id": "aldeas", "book_id": "polyanthea_medicinal", "name": "Aldeas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Aldeas"], "contexts": ["small villages", "villages within the kingdom"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "aldeas", "target_book": "polyanthea_medicinal", "target_name": "Aldeas", "similarity": 0.894}], "id": 4104, "stable_key": "clu_5be0c3a6e6c36cb6", "ground_truth": {"modern_name": "aldea", "confidence": "high", "type": "place", "description": "A small rural settlement or village.", "wikipedia_extract": "A hamlet is a human settlement that is smaller than a town or village. This is often simply an informal description of a smaller settlement or possibly a subdivision or satellite entity to a larger settlement. Sometimes, a hamlet is defined for official or administrative purposes. The word and concept of a hamlet can be traced back to Norman England, where the Old French hamelet came to apply to small human settlements. The word comes from Anglo-Norman hamelet, corresponding to Old French hamelet, the diminutive of Old French hamel meaning a little village. This, in turn, is a diminutive of Old French ham, possibly borrowed from (West Germanic) Franconian languages."}}, {"canonical_name": "Blumenbach", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "blumenbach", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Blumenbach", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Blumenbach"], "contexts": ["collector of human race skeletons"]}, {"entity_id": "blumenbach", "book_id": "kosmos_humboldt_1845", "name": "Blumenbach", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Blumenbach"], "contexts": ["scientist known for comparative anatomy", "master who classified races"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Blumenbach", "target_book": "kosmos_humboldt_1845", "target_name": "Blumenbach", "similarity": 1.0}], "id": 4105, "stable_key": "clu_8835cbcc148dd3c8", "ground_truth": {"modern_name": "Johann Friedrich Blumenbach", "confidence": "high", "type": "person", "birth_year": 1752, "death_year": 1840, "description": "German physician, naturalist, comparative anatomist, and anthropologist.", "wikidata_id": "Q58588", "wikidata_description": "German physician, naturalist, physiologist, and anthropologist (1752 \u2013 1840)", "wikipedia_url": "https://en.wikipedia.org/wiki/Johann%20Friedrich%20Blumenbach", "wikipedia_extract": "Johann Friedrich Blumenbach (11 May 1752 \u2013 22 January 1840) was a German physician, naturalist, physiologist, and anthropologist. He is considered to be a main founder of zoology and anthropology as comparative, scientific disciplines. He has been called the \"founder of racial classifications\". He was one of the first to explore the study of the human being as an aspect of natural history. His teachings in comparative anatomy were applied to his classification of human races, of which he claimed there were five: Caucasian, Mongolian, Malayan, Ethiopian, and American. He was a member of what modern historians call the G\u00f6ttingen school of history."}}, {"canonical_name": "Faleiro", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "faleiro", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Faleiro", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Faleiro"], "contexts": ["famous mathematician"]}, {"entity_id": "faleiro", "book_id": "coloquios_da_orta_1563", "name": "Faleiro", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Faleiro", "Falcio"], "contexts": ["bacharel who accompanied Magalh\u00e3es", "astrologer, cosmographer"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Faleiro", "target_book": "coloquios_da_orta_1563", "target_name": "Faleiro", "similarity": 0.711}], "id": 4106, "stable_key": "clu_705801c3d42aa5cd", "ground_truth": {"modern_name": "Fern\u00e3o de Oliveira", "confidence": "high", "type": "person", "birth_year": 1507, "description": "Portuguese mathematician and navigator, possibly associated with Magellan.", "note": "The context 'bacharel who accompanied Magalh\u00e3es' strongly points to Fern\u00e3o de Oliveira, a mathematician who sailed with Magellan's expedition. 'Faleiro' might be a corruption or a misremembered name. It is important to note that while the association is strong, the name in the text is 'Faleiro', hence the 'medium' confidence on the name itself.", "wikidata_id": "Q5445183", "wikidata_description": "Priest and grammarian"}}, {"canonical_name": "titicaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "lac_alpin_de_titicaca", "book_id": "relation_historique_humboldt_vol3_1825", "name": "lac alpin de Titicaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["lac alpin de Titicaca"], "contexts": ["alpine lake"]}, {"entity_id": "titi-caca", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Titi-caca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Titi-caca"], "contexts": ["basin name"]}, {"entity_id": "titicaca", "book_id": "kosmos_humboldt_1845", "name": "titicaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["titicaca", "Titicaca"], "contexts": ["South American lake", "highlands where skulls were found"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "lac alpin de Titicaca", "target_book": "kosmos_humboldt_1845", "target_name": "titicaca", "similarity": 0.91}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Titi-caca", "target_book": "kosmos_humboldt_1845", "target_name": "titicaca", "similarity": 0.661}], "id": 4107, "stable_key": "clu_69d96da7a892f9d8", "ground_truth": {"modern_name": "Lake Titicaca", "confidence": "high", "type": "place", "country": "Peru, Bolivia", "wikidata_id": "Q1628083", "wikidata_description": "species of amphibian", "wikipedia_extract": "Waru Waru is a type of raised field agriculture developed by pre-Hispanic people in the Andes region of South America from Ecuador to Bolivia. This regional agricultural technique is also referred to as camellones in Spanish. Functionally similar agricultural techniques have been developed in other parts of the world. This type of altiplano field agriculture consists of parallel canals alternated by raised planting beds, which would be strategically located on floodplains or near a water source so that the fields could be properly irrigated. These flooded fields were composed of soil that was rich in nutrients due to the presence of aquatic plants and other organic materials. Through the process of mounding up this soil to create planting beds, natural, recyclable fertilizer was made available in a region where nitrogen-rich soils were rare.", "wikipedia_url": "https://en.wikipedia.org/wiki/Waru_Waru"}}, {"canonical_name": "SantaCatharina", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "sainte-catherine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sainte-Catherine", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Sainte-Catherine"], "contexts": ["island"]}, {"entity_id": "santacatharina", "book_id": "polyanthea_medicinal", "name": "SantaCatharina", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["SantaCatharina", "Santa Catherina", "Santa Clara"], "contexts": ["landmark near a patient's home", "convent of patient"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sainte-Catherine", "target_book": "polyanthea_medicinal", "target_name": "SantaCatharina", "similarity": 0.882}], "id": 4108, "stable_key": "clu_226fddcf6ef3f5c1", "ground_truth": {"modern_name": "Santa Catarina", "confidence": "high", "type": "place", "country": "Brazil", "note": "The text mentions 'Sainte-Catherine' and 'SantaCatharina' in contexts of islands and landmarks, aligning with Santa Catarina Island in Brazil, a significant geographical feature."}}, {"canonical_name": "Eifel", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "eifel", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Eifel", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Eifel"], "contexts": ["mountain range in Germany"]}, {"entity_id": "eifel", "book_id": "kosmos_humboldt_1845", "name": "Eifel", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Eifel"], "contexts": ["region with volcanic valleys", "district containing Lake of Laach"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Eifel", "target_book": "kosmos_humboldt_1845", "target_name": "Eifel", "similarity": 0.826}], "id": 4109, "stable_key": "clu_3feb8d7b3f84d66b", "ground_truth": {"modern_name": "Eifel", "confidence": "high", "type": "place", "country": "Germany", "note": "The context of a mountain range in Germany with volcanic valleys perfectly matches the Eifel region."}}, {"canonical_name": "Noggerath", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "noggeralh", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Noggeralh", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Noggeralh"], "contexts": ["cited author"]}, {"entity_id": "noggerath", "book_id": "kosmos_humboldt_1845", "name": "Noggerath", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Noggerath"], "contexts": ["counted annual rings in a tree trunk", "counted annual rings in a tree"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Noggeralh", "target_book": "kosmos_humboldt_1845", "target_name": "Noggerath", "similarity": 0.952}], "id": 4110, "stable_key": "clu_aebe3af6f65f205f", "ground_truth": {"modern_name": "Johann Jacob N\u00f6ggerath", "confidence": "high", "type": "person", "birth_year": 1788, "death_year": 1877, "description": "German geologist and mineralogist, known for dendrochronology research.", "note": "The context of counting annual rings in a tree trunk and being a cited author aligns with the scientific work of Johann Jacob N\u00f6ggerath, a geologist and mineralogist.", "wikidata_id": "Q66415", "wikidata_description": "German mineralogist and geologist"}}, {"canonical_name": "quartzo hyal\u00edno", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "quarz_hyalin", "book_id": "relation_historique_humboldt_vol3_1825", "name": "quarz hyalin", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["quarz hyalin"], "contexts": ["clear quartz"]}, {"entity_id": "quartzo_hyal\u00edno", "book_id": "coloquios_da_orta_1563", "name": "quartzo hyal\u00edno", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["quartzo hyal\u00edno", "quartzo", "quartzo twerdeaio"], "contexts": ["another name for clear crystal", "greenish quartz sometimes called berylo"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "quarz hyalin", "target_book": "coloquios_da_orta_1563", "target_name": "quartzo hyal\u00edno", "similarity": 0.91}], "id": 4111, "stable_key": "clu_8f456b48926d6796-2", "ground_truth": {"modern_name": "Quartz", "confidence": "high", "type": "mineral", "wikidata_id": "Q43010", "wikidata_description": "mineral made of silicon and oxygen", "wikipedia_url": "https://en.wikipedia.org/wiki/Quartz", "note": "The term 'quarz' is a variant spelling. 'quartzose' refers to material composed of quartz.", "wikipedia_extract": "Quartz is a hard mineral composed of silica (silicon dioxide). Its atoms are linked in a continuous framework of SiO4 silicon\u2013oxygen tetrahedra, with each oxygen atom being shared between two tetrahedra, giving an overall chemical formula of SiO2. Therefore, quartz is classified structurally as a framework silicate mineral and compositionally as an oxide mineral. Quartz is the second most common mineral or mineral group in Earth's lithosphere, comprising about 12% by mass. Quartz exists in two forms, the normal \u03b1-quartz and the high-temperature \u03b2-quartz, both of which are chiral. The transformation from \u03b1-quartz to \u03b2-quartz takes place abruptly at 573 \u00b0C (846 K; 1,063 \u00b0F)."}}, {"canonical_name": "M\u00e9m. de l'Acad.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "m\u00e9m__de_l'acad_", "book_id": "relation_historique_humboldt_vol3_1825", "name": "M\u00e9m. de l'Acad.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["M\u00e9m. de l'Acad."], "contexts": ["Memoirs of the Academy"]}, {"entity_id": "m\u00e9m__de_l'acad_", "book_id": "kosmos_humboldt_1845", "name": "M\u00e9m. de l'Acad.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["M\u00e9m. de l'Acad."], "contexts": ["publication of the Academy", "memoirs of an academy"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "M\u00e9m. de l'Acad.", "target_book": "kosmos_humboldt_1845", "target_name": "M\u00e9m. de l'Acad.", "similarity": 1.0}], "id": 4112, "stable_key": "clu_0cc937767a6fb069", "ground_truth": {"modern_name": "Memoirs of the Academy", "confidence": "high", "type": "text"}}, {"canonical_name": "Farquharson", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "farquhar", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Farquhar", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Farquhar"], "contexts": ["scientist in Calcutta"]}, {"entity_id": "farquharson", "book_id": "kosmos_humboldt_1845", "name": "Farquharson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Farquharson"], "contexts": ["cited in Edinburgh Philosophical Journal", "contributor to Edinburgh Philos. Journal"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Farquhar", "target_book": "kosmos_humboldt_1845", "target_name": "Farquharson", "similarity": 0.897}], "id": 4113, "stable_key": "clu_05750e1686fcfd19", "ground_truth": {"modern_name": "Farquharson", "confidence": "medium", "type": "person", "description": "Scientist in Calcutta, cited in journal.", "note": "Full name and specific field of study are unclear."}}, {"canonical_name": "Asiatieal researches", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "asiatic_researches", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Asiatic Researches", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Asiatic Researches"], "contexts": ["publication containing scientific results"]}, {"entity_id": "asiatieal_researches", "book_id": "coloquios_da_orta_1563", "name": "Asiatieal researches", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["Asiatieal researches", "Asiati'cal researches", "Asiatic researches"], "contexts": ["publication title", "publication where sir William Jones is cited"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Asiatic Researches", "target_book": "coloquios_da_orta_1563", "target_name": "Asiatieal researches", "similarity": 0.976}], "id": 4114, "stable_key": "clu_5a8c17122c9c9d3c", "ground_truth": {"modern_name": "Asiatic Researches", "confidence": "high", "type": "text", "wikidata_id": "Q5708276", "wikidata_description": "journal, 1788-1839", "wikipedia_extract": "Cholera () is an infection of the small intestine by some strains of the bacterium Vibrio cholerae. Symptoms may range from none, to mild, to severe. The classic symptom is large amounts of watery diarrhea lasting a few days. Vomiting and muscle cramps may also occur. Diarrhea can be so severe that it leads within hours to severe dehydration and electrolyte imbalance. This can in turn result in sunken eyes, cold or cyanotic skin, decreased skin elasticity, wrinkling of the hands and feet, and, in severe cases, death.", "wikipedia_url": "https://es.wikipedia.org/wiki/Asiatic_Researches"}}, {"canonical_name": "R. Hodgson", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "adam_hodgson", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Adam Hodgson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Adam Hodgson"], "contexts": ["author of a letter"]}, {"entity_id": "r__hodgson", "book_id": "principles_of_psychology_james_1890", "name": "R. Hodgson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["R. Hodgson"], "contexts": ["reported on a case", "examined Mr. Bourne"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Adam Hodgson", "target_