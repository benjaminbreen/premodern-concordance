_book": "principles_of_psychology_james_1890", "target_name": "Columbus", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Columbus", "target_book": "kosmos_humboldt_1845", "target_name": "Columbus", "similarity": 0.701}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Columbus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Columbus", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Columbus", "target_book": "kosmos_humboldt_1845", "target_name": "Columbus", "similarity": 0.701}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Columbus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Columbus", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Columbus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Columbus", "similarity": 0.701}], "id": 496, "stable_key": "clu_5c3bd1598dc68d7e", "ground_truth": {"modern_name": "Christopher Columbus", "confidence": "high", "type": "person", "birth_year": 1451, "death_year": 1506, "description": "Italian explorer and navigator, discoverer of America.", "wikidata_id": "Q7322", "wikidata_description": "Italian navigator, explorer, and colonist (1451\u20131506)", "wikipedia_url": "https://en.wikipedia.org/wiki/Christopher%20Columbus", "wikipedia_extract": "Christopher Columbus (; between 25 August and 31 October 1451 \u2013 20 May 1506) was an Italian explorer and navigator from the Republic of Genoa who completed four Spanish-based voyages across the Atlantic Ocean sponsored by the Catholic Monarchs, opening the way for the widespread European exploration and colonization of the Americas. His expeditions were the first known European contact with the Caribbean and Central and South America. The name Christopher Columbus is the anglicization of the Latin Christophorus Columbus. Growing up on the coast of Liguria, he went to sea at a young age and traveled widely, as far north as the British Isles and as far south as what is now Ghana. He married Portuguese noblewoman Filipa Moniz Perestrelo, who bore a son, Diego, and was based in Lisbon for several years. He later took a Castilian mistress, Beatriz Enr\u00edquez de Arana, who bore a son, Ferdinand."}}, {"canonical_name": "fingers", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 19, "members": [{"entity_id": "fingers", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "fingers", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["fingers"], "contexts": ["part of the hand", "digits of the hand"]}, {"entity_id": "fingers", "book_id": "origin_of_species_darwin_1859", "name": "fingers", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["fingers"], "contexts": ["digits on the hand", "body part, additional can be monstrous"]}, {"entity_id": "fingers", "book_id": "principles_of_psychology_james_1890", "name": "fingers", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 12, "variants": ["fingers"], "contexts": ["digits on the hand", "digits of the hand"]}, {"entity_id": "finger-tips", "book_id": "principles_of_psychology_james_1890", "name": "finger-tips", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["finger-tips"], "contexts": ["part of hand used for drumming"]}, {"entity_id": "fingers", "book_id": "first_principles_spencer_1862", "name": "fingers", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["fingers"], "contexts": ["part of the hand for tactile sensation"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fingers", "target_book": "origin_of_species_darwin_1859", "target_name": "fingers", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fingers", "target_book": "principles_of_psychology_james_1890", "target_name": "fingers", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fingers", "target_book": "principles_of_psychology_james_1890", "target_name": "finger-tips", "similarity": 0.971}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fingers", "target_book": "first_principles_spencer_1862", "target_name": "fingers", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "fingers", "target_book": "principles_of_psychology_james_1890", "target_name": "fingers", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "fingers", "target_book": "principles_of_psychology_james_1890", "target_name": "finger-tips", "similarity": 0.971}, {"source_book": "origin_of_species_darwin_1859", "source_name": "fingers", "target_book": "first_principles_spencer_1862", "target_name": "fingers", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fingers", "target_book": "first_principles_spencer_1862", "target_name": "fingers", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "finger-tips", "target_book": "first_principles_spencer_1862", "target_name": "fingers", "similarity": 0.971}], "id": 497, "stable_key": "clu_d85b593fdf3e0390", "ground_truth": {"modern_name": "fingers", "confidence": "high", "type": "concept", "note": "While fingers are anatomical parts, the context here discusses them as general physical entities, not specific medical diagnoses or treatments, aligning more with a conceptual use within broader scientific and philosophical discourse.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Finger", "wikipedia_extract": "A finger is a prominent digit on the forelimbs of most tetrapod vertebrate animals, especially those with prehensile extremities (i.e. hands) such as humans and other primates. Most tetrapods have five digits (pentadactyly), and short digits (i.e. significantly shorter than the metacarpal/metatarsals) are typically referred to as toes, while those that are notably elongated are called fingers. In humans, the fingers are flexibly articulated and opposable, serving as an important organ of tactile sensation and fine movements, which are crucial to the dexterity of the hands and the ability to grasp and manipulate objects. Usually humans have five digits, the bones of which are termed phalanges, on each hand, although some people have more or fewer than five due to congenital disorders such as polydactyly or oligodactyly, or accidental or intentional amputations."}}, {"canonical_name": "mosquitos", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 4, "total_mentions": 19, "members": [{"entity_id": "caterpillars", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Caterpillars", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["Caterpillars"], "contexts": ["insects indicating common corruption"]}, {"entity_id": "caterpillar", "book_id": "origin_of_species_darwin_1859", "name": "caterpillar", "category": "ANIMAL", "subcategory": "INSECT", "count": 5, "variants": ["caterpillar"], "contexts": ["larval stage of a moth or butterfly", "larval stage of butterflies and moths"]}, {"entity_id": "caterpillars", "book_id": "origin_of_species_darwin_1859", "name": "caterpillars", "category": "ANIMAL", "subcategory": "INSECT", "count": 2, "variants": ["caterpillars"], "contexts": ["larval stage of moths and butterflies", "larval stage of butterflies and moths"]}, {"entity_id": "mosquitos", "book_id": "relation_historique_humboldt_vol3_1825", "name": "mosquitos", "category": "ANIMAL", "subcategory": "INSECT", "count": 8, "variants": ["mosquitos", "Mosquitos", "mosquilos"], "contexts": ["coast", "coastline"]}, {"entity_id": "caterpillar", "book_id": "first_principles_spencer_1862", "name": "caterpillar", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["caterpillar"], "contexts": ["larval stage of a butterfly or moth", "earlier stage of butterfly development"]}, {"entity_id": "mosquitoes", "book_id": "first_principles_spencer_1862", "name": "mosquitoes", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["mosquitoes"], "contexts": ["insects that can 'devour' people"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Caterpillars", "target_book": "origin_of_species_darwin_1859", "target_name": "caterpillars", "similarity": 0.909}, {"source_book": "origin_of_species_darwin_1859", "source_name": "caterpillar", "target_book": "first_principles_spencer_1862", "target_name": "caterpillar", "similarity": 0.92}, {"source_book": "origin_of_species_darwin_1859", "source_name": "caterpillars", "target_book": "first_principles_spencer_1862", "target_name": "caterpillar", "similarity": 0.904}, {"source_book": "origin_of_species_darwin_1859", "source_name": "caterpillars", "target_book": "first_principles_spencer_1862", "target_name": "mosquitoes", "similarity": 0.905}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mosquitos", "target_book": "first_principles_spencer_1862", "target_name": "mosquitoes", "similarity": 0.995}], "id": 498, "stable_key": "clu_bfdf27d390a973d3", "ground_truth": {"modern_name": "caterpillar", "confidence": "high", "type": "animal"}}, {"canonical_name": "Mer Caspienne", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 19, "members": [{"entity_id": "mer_caspienne", "book_id": "epoques_nature_buffon_1778", "name": "mer Caspienne", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["mer Caspienne"], "contexts": ["inland sea", "largest inland body of water"]}, {"entity_id": "mer_caspienne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mer Caspienne", "category": "PLACE", "subcateg