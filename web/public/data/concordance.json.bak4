, "book_id": "first_principles_spencer_1862", "name": "geologic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["geologic"], "contexts": ["related to the Earth's structure and history", "relating to the Earth's structure"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Geological", "target_book": "kosmos_humboldt_1845", "target_name": "geological", "similarity": 0.981}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Geological", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "geological", "similarity": 0.981}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Geological", "target_book": "first_principles_spencer_1862", "target_name": "geological", "similarity": 0.981}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Geological", "target_book": "first_principles_spencer_1862", "target_name": "geologic", "similarity": 0.946}, {"source_book": "kosmos_humboldt_1845", "source_name": "geological", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "geological", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "geological", "target_book": "first_principles_spencer_1862", "target_name": "geological", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "geological", "target_book": "first_principles_spencer_1862", "target_name": "geologic", "similarity": 0.971}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "geological", "target_book": "first_principles_spencer_1862", "target_name": "geological", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "geological", "target_book": "first_principles_spencer_1862", "target_name": "geologic", "similarity": 0.971}], "id": 663, "stable_key": "clu_cca7badc2a4ee24a", "ground_truth": {"modern_name": "Geology", "confidence": "high", "type": "concept", "wikidata_id": "Q1069", "wikidata_description": "study of the composition, structure, physical properties, and history of Earth's components, and the processes by which they are shaped", "wikipedia_url": "https://en.wikipedia.org/wiki/Geology", "wikipedia_extract": "Geology is a branch of natural science concerned with the Earth and other astronomical bodies, the rocks of which they are composed, and the processes by which they change over time. The name comes from Ancient Greek  \u03b3\u1fc6 (g\u00ea) 'earth' and  \u03bbo\u03b3\u03af\u03b1 (-log\u00eda) 'study of, discourse'. Modern geology significantly overlaps all other Earth sciences, including hydrology. It is integrated with Earth system science and planetary science. Geology describes the structure of the Earth on and beneath its surface and the processes that have shaped that structure. Geologists study the mineralogical composition of rocks in order to get insight into their history of formation."}}, {"canonical_name": "Mr. Brooke", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "mr__buckman", "book_id": "origin_of_species_darwin_1859", "name": "Mr. Buckman", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Mr. Buckman"], "contexts": ["conducted experiments on plants"]}, {"entity_id": "mr__brooke", "book_id": "kosmos_humboldt_1845", "name": "Mr. Brooke", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Mr. Brooke"], "contexts": ["literary and scientific friend", "designer of photographic apparatus"]}, {"entity_id": "mr__grove", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mr. Grove", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Mr. Grove"], "contexts": ["cited examples of radiating substances", "scientist on electric arc and light"]}, {"entity_id": "mr__goodricke", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mr. Goodricke", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Mr. Goodricke"], "contexts": ["discovered Algol's variable nature"]}, {"entity_id": "mr__grove", "book_id": "first_principles_spencer_1862", "name": "Mr. Grove", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Mr. Grove"], "contexts": ["author of 'The Correlation of Physical Forces'"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Mr. Buckman", "target_book": "kosmos_humboldt_1845", "target_name": "Mr. Brooke", "similarity": 0.853}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mr. Brooke", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mr. Grove", "similarity": 0.854}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mr. Brooke", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mr. Goodricke", "similarity": 0.852}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mr. Brooke", "target_book": "first_principles_spencer_1862", "target_name": "Mr. Grove", "similarity": 0.854}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Mr. Grove", "target_book": "first_principles_spencer_1862", "target_name": "Mr. Grove", "similarity": 1.0}], "id": 664, "stable_key": "clu_f7732739c13e7015", "ground_truth": {"modern_name": "Brooke", "confidence": "medium", "type": "person", "description": "Literary and scientific friend cited in texts.", "note": "Multiple individuals named Brooke, Buckman, Grove, and Goodricke are conflated. Mr. Brooke is the most frequent and plausible referent in the context of scientific discourse.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "", "wikipedia_extract": ""}}, {"canonical_name": "E\u017fpinal Medulla", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "medula", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "medula", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["medula"], "contexts": ["substance extracted from plants"]}, {"entity_id": "medulla", "book_id": "principles_of_psychology_james_1890", "name": "medulla", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["medulla"], "contexts": ["part of the brainstem"]}, {"entity_id": "medulla", "book_id": "coloquios_da_orta_1563", "name": "medulla", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["medulla"], "contexts": ["inner part of a plant", "part of the trunk observed"]}, {"entity_id": "e\u017fpinal_medulla", "book_id": "polyanthea_medicinal", "name": "E\u017fpinal Medulla", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["E\u017fpinal Medulla", "e\u017fpinal medulla"], "contexts": ["spinal cord", "part of the nervous system connected to uterus"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "medula", "target_book": "coloquios_da_orta_1563", "target_name": "medulla", "similarity": 0.96}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "medula", "target_book": "polyanthea_medicinal", "target_name": "E\u017fpinal Medulla", "similarity": 0.883}, {"source_book": "principles_of_psychology_james_1890", "source_name": "medulla", "target_book": "coloquios_da_orta_1563", "target_name": "medulla", "similarity": 0.787}, {"source_book": "coloquios_da_orta_1563", "source_name": "medulla", "target_book": "polyanthea_medicinal", "target_name": "E\u017fpinal Medulla", "similarity": 0.902}], "id": 665, "stable_key": "clu_636f092e86daff7c", "ground_truth": {"modern_name": "Spinal cord", "confidence": "high", "type": "object", "note": "While 'spinal column' and 'spinal segment' are related, the primary referent is the 'spinal cord' given the frequency and context of 'central nervous system pathway'.", "wikidata_id": "Q2997445", "wikidata_description": "body organ", "wikipedia_url": "https://en.wikipedia.org/wiki/Anterior%20grey%20column", "description": "The central nerve pathway connecting the brain to the body.", "wikipedia_extract": "The spinal cord is a long, thin, tubular structure made up of nervous tissue that extends from the medulla oblongata in the lower brainstem to the lumbar region of the vertebral column (backbone) of vertebrate animals. The center of the spinal cord is hollow and contains a structure called the central canal, which contains cerebrospinal fluid. The spinal cord is also covered by the meninges and enclosed by the neural arches. Together, the brain and spinal cord make up the central nervous system. In humans, the spinal cord is a continuation of the brainstem and anatomically begins at the occipital bone, passing out of the foramen magnum and then enters the spinal canal at the beginning of the cervical vertebrae. The spinal cord extends down to between the first and second lumbar vertebrae, where it tapers to become the cauda equina."}}, {"canonical_name": "Asparagus", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "asparagus", "book_id": "english_physician_1652", "name": "Asparagus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Asparagus"], "contexts": ["a plant with edible shoots", "shoots compared to those of Butchers-Broom"]}, {"entity_id": "asparagus_plant", "book_id": "origin_of_species_darwin_1859", "name": "asparagus plant", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["asparagus plant"], "contexts": ["a type of plant"]}, {"entity_id": "asparagorum", "book_id": "relation_historique_humboldt_vol3_1825", "name": "asparagorum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["asparagorum"], "contexts": ["plant juice used for intoxication"]}, {"entity_id": "garden_asparagus", "book_id": "english_physician_1652", "name": "Garden Asparagus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Garden Asparagus"], "contexts": ["nourishes more than wild asparagus"]}, {"entity_id": "asparagus", "book_id": "origin_of_species_darwin_1859", "name": "Asparagus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Asparagus"], "contexts": ["mentioned in text"]}, {"entity_id": "asparagus", "book_id": "coloquios_da_orta_1563", "name": "Asparagus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Asparagus", "AsparaguSf"], "contexts": ["plant species Orta might have seen", "plant species"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Asparagus", "target_book": "origin_of_species_darwin_1859", "target_name": "asparagus plant", "similarity": 0.975}, {"source_book": "english_physician_1652", "source_name": "Asparagus", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "asparagorum", "similarity": 0.915}, {"source_book": "origin_of_species_darwin_1859", "source_name": "asparagus plant", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "asparagorum", "similarity": 0.924}, {"source_book": "english_physician_1652", "source_name": "Garden Asparagus", "target_book": "origin_of_species_darwin_1859", "target_name": "Asparagus", "similarity": 0.927}, {"source_book": "english_physician_1652", "source_name": "Garden Asparagus", "target_book": "coloquios_da_orta_1563", "target_name": "Asparagus", "similarity": 0.927}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Asparagus", "target_book": "coloquios_da_orta_1563", "target_name": "Asparagus", "similarity": 1.0}], "id": 666, "stable_key": "clu_87f526e6c73a2cad", "ground_truth": {"modern_name": "Asparagus", "confidence": "high", "type": "plant", "linnaean": "Asparagus officinalis", "family": "Asparagaceae", "description": "Edible shoots of a perennial plant, also known as garden asparagus.", "wikipedia_extract": "Asparagus (Asparagus officinalis) or garden asparagus is a perennial flowering plant species in the genus Asparagus native to Eurasia. Widely cultivated as a vegetable crop, its young shoots are used as a spring vegetable. Asparagus is an herbaceous, perennial plant growing typically to 100\u2013150 centimetres (3\u20135 feet) tall, with stout stems with much-branched, feathery foliage. It has been known to grow as long as 3.5 metres (11 ft). The 'leaves' are needle-like cladodes (modified stems) in the axils of scale leaves; they are 6\u201332 millimetres (1\u20444\u20131+1\u20444 inches) long and 1 mm (1\u204432 in) broad, and clustered in fours, up to 15, together, in a rose-like shape. The root system, often referred to as a 'crown', is adventitious; the root type is fasciculated."}}, {"canonical_name": "Corn", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "corn", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Corn", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Corn"], "contexts": ["grain crop"]}, {"entity_id": "corn", "book_id": "english_physician_1652", "name": "Corn", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["Corn", "corn"], "contexts": ["crop where bluebottles grow", "grain used for comparison"]}, {"entity_id": "corn", "book_id": "origin_of_species_darwin_1859", "name": "corn", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["corn"], "contexts": ["common cereal grain plant"]}, {"entity_id": "corn", "book_id": "first_principles_spencer_1862", "name": "corn", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["corn"], "contexts": ["agricultural commodity traded"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Corn", "target_book": "english_physician_1652", "target_name": "Corn", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "corn", "target_book": "first_principles_spencer_1862", "target_name": "corn", "similarity": 1.0}], "id": 667, "stable_key": "clu_c4034bcc124549c1", "ground_truth": {"modern_name": "Corn", "confidence": "high", "type": "plant", "linnaean": "Zea mays", "family": "Poaceae", "note": "In early modern English texts, 'corn' most commonly refers to maize or Indian corn, though it could also generically mean 'grain'.", "wikidata_id": "Q158642", "wikidata_description": "species of plant"}}, {"canonical_name": "genesis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "gen\u00e8se", "book_id": "epoques_nature_buffon_1778", "name": "Gen\u00e8se", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Gen\u00e8se"], "contexts": ["biblical book, first book of the Old Testament", "first book of the Bible"]}, {"entity_id": "genesis", "book_id": "first_principles_spencer_1862", "name": "genesis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["genesis"], "contexts": ["origin or creation of something", "origin or creation of things"]}, {"entity_id": "genesis", "book_id": "english_physician_1652", "name": "Genesis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Genesis"], "contexts": ["natal chart or birth", "astrological concept of birth chart"]}, {"entity_id": "genesis", "book_id": "origin_of_species_darwin_1859", "name": "Genesis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Genesis"], "contexts": ["biblical text mentioning animal colour"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Gen\u00e8se", "target_book": "first_principles_spencer_1862", "target_name": "genesis", "similarity": 0.949}, {"source_book": "english_physician_1652", "source_name": "Genesis", "target_book": "origin_of_species_