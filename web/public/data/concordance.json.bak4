ory": "OTHER_PERSON", "count": 1, "variants": ["stranger"], "contexts": ["unfamiliar person"]}, {"entity_id": "emigrants", "book_id": "first_principles_spencer_1862", "name": "Emigrants", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Emigrants"], "contexts": ["people leaving their country"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "\u00e9trangers", "target_book": "principles_of_psychology_james_1890", "target_name": "stranger", "similarity": 0.868}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "\u00e9trangers", "target_book": "first_principles_spencer_1862", "target_name": "Emigrants", "similarity": 0.852}], "id": 1764, "stable_key": "clu_22e7ecc8eb1055d5", "ground_truth": {"modern_name": "Foreigners", "confidence": "medium", "type": "person", "note": "The term '\u00e9trangers' and 'stranger' can refer to anyone not belonging to a specific group, but in the context of historical texts, it often implies foreign residents or visitors. 'Emigrants' refers to people leaving a country, which is a related but distinct concept.", "wikidata_id": "Q473741", "wikidata_description": "person not having citizenship in a country"}}, {"canonical_name": "Stewart", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "stewart", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Stewart", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Stewart", "M. Stewart"], "contexts": ["author of 'View of the present state of Jamaica'", "source for Jamaican import value"]}, {"entity_id": "stewart", "book_id": "principles_of_psychology_james_1890", "name": "Stewart", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Stewart"], "contexts": ["Classic writer on psychology"]}, {"entity_id": "stewart", "book_id": "coloquios_da_orta_1563", "name": "Stewart", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Stewart"], "contexts": ["cited in Pharmacographia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Stewart", "target_book": "principles_of_psychology_james_1890", "target_name": "Stewart", "similarity": 0.758}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Stewart", "target_book": "coloquios_da_orta_1563", "target_name": "Stewart", "similarity": 0.758}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Stewart", "target_book": "coloquios_da_orta_1563", "target_name": "Stewart", "similarity": 1.0}], "id": 1765, "stable_key": "clu_8018ceeb023c9227", "ground_truth": {"modern_name": "Stewart", "confidence": "low", "type": "person", "description": "Historical figure mentioned in scientific and psychological texts.", "note": "Multiple individuals named Stewart are mentioned; the context suggests different persons.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Stewart%20%28name%29", "wikipedia_extract": "Stewart is a Scottish and English surname, also used as a given name. It is possibly derived from the old English word \"stigweard\", a compound of \"stig\" meaning household, and \"weard\", a guardian (ward), or from the Gaelic Sti\u00f9bhart meaning steward. Alternative spellings are Stuart, Steward and Steuart. The surname Stewart has large concentrations in the United States (mainly in the Deep South, and the other southern states), United Kingdom (mainly in Scotland, Northern Ireland, North East England, South West England, Cumbria, Lancashire, and Yorkshire), Canada, Jamaica, New Zealand, Australia and elsewhere that has large Scottish or Ulster Scots diaspora. The progenitor of the Stewart family was Alan fitz Flaad, a Breton knight who settled in England after the Norman Conquest. His son, Walter fitz Alan, relocated to Scotland during the Anarchy and became the High Steward of Scotland, hence the origin of the surname."}}, {"canonical_name": "Africains", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "africains", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Africains", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Africains"], "contexts": ["people from Africa"]}, {"entity_id": "african_nations", "book_id": "kosmos_humboldt_1845", "name": "African nations", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["African nations"], "contexts": ["group with dark-colored skin"]}, {"entity_id": "african", "book_id": "connexion_physical_sciences_somerville_1858", "name": "African", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["African"], "contexts": ["person from Africa, described as black"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Africains", "target_book": "kosmos_humboldt_1845", "target_name": "African nations", "similarity": 0.923}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Africains", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "African", "similarity": 0.957}, {"source_book": "kosmos_humboldt_1845", "source_name": "African nations", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "African", "similarity": 0.927}], "id": 1766, "stable_key": "clu_ae50f57eb54b5d88", "ground_truth": {"modern_name": "Africans", "confidence": "high", "type": "concept", "wikidata_id": "Q125017449", "wikidata_description": "publication by Dr. James Lowell Gibbs, Jr. detailing peoples and cultural practices on the content of Africa"}}, {"canonical_name": "Sierra", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "sierra", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sierra", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Sierra"], "contexts": ["mountainous region", "mountainous part of Cuba"]}, {"entity_id": "sierra", "book_id": "kosmos_humboldt_1845", "name": "Sierra", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Sierra"], "contexts": ["mountainous region in Mexico"]}, {"entity_id": "sierras", "book_id": "historia_medicinal_monardes_1574", "name": "sierras", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["sierras"], "contexts": ["devnas \u017fierras a otras por via."]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sierra", "target_book": "kosmos_humboldt_1845", "target_name": "Sierra", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sierra", "target_book": "historia_medicinal_monardes_1574", "target_name": "sierras", "similarity": 0.892}, {"source_book": "kosmos_humboldt_1845", "source_name": "Sierra", "target_book": "historia_medicinal_monardes_1574", "target_name": "sierras", "similarity": 0.892}], "id": 1767, "stable_key": "clu_dd0094bd132b2f70", "ground_truth": {"modern_name": "Sierra Nevada", "confidence": "high", "type": "place", "description": "Mountain range, often associated with snow.", "note": "Refers to a mountain range, particularly the one in South America, or generally mountainous regions.", "wikipedia_extract": "The Sierra Nevada ( see-ERR-\u0259 nih-VA(H)D-\u0259) is a mountain range in the Western United States, between the Central Valley of California and the Great Basin. The vast majority of the range lies in the state of California, although the Carson Range spur lies primarily in Nevada. The Sierra Nevada is part of the American Cordillera, an almost continuous chain of mountain ranges that forms the western \"backbone\" of the Americas. The Sierra runs 400 mi (640 km) north-south, and its width ranges from 50 mi (80 km) to 80 mi (130 km) across east\u2013west. Notable features include the General Sherman Tree, the largest tree in the world by volume; Lake Tahoe, the largest alpine lake in North America; Mount Whitney at 14,505 ft (4,421 m), the highest point in the contiguous United States; and Yosemite Valley sculpted by glaciers from one-hundred-million-year-old granite, containing high waterfalls. The Sierra is home to three national parks, twenty-six wilderness areas, ten national forests, and two national monuments."}}, {"canonical_name": "Richer", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "richer", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Richer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Richer"], "contexts": ["Richer", "charged by the academy to examine barometric height"]}, {"entity_id": "richer", "book_id": "kosmos_humboldt_1845", "name": "Richer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Richer"], "contexts": ["performed pendulum experiments"]}, {"entity_id": "richman", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Richman", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Richman"], "contexts": ["killed by lightning"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Richer", "target_book": "kosmos_humboldt_1845", "target_name": "Richer", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Richer", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Richman", "similarity": 0.92}, {"source_book": "kosmos_humboldt_1845", "source_name": "Richer", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Richman", "similarity": 0.92}], "id": 1768, "stable_key": "clu_5d757fb7c6e757ee", "ground_truth": {"modern_name": "Jean-Baptiste de Richer", "confidence": "high", "type": "person", "birth_year": 1692, "death_year": 1751, "description": "Astronomer who died in a lightning strike during experiments."}}, {"canonical_name": "silex", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "silex", "book_id": "relation_historique_humboldt_vol3_1825", "name": "silex", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["silex", "silex pyromaque"], "contexts": ["flint or silica", "type of stone"]}, {"entity_id": "silex", "book_id": "kosmos_humboldt_1845", "name": "silex", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["silex"], "contexts": ["silica, hardens rocks", "solid mineral in composite rocks"]}, {"entity_id": "silex", "book_id": "first_principles_spencer_1862", "name": "silex", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["silex"], "contexts": ["silicious material forming concretions"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "silex", "target_book": "kosmos_humboldt_1845", "target_name": "silex", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "silex", "target_book": "first_principles_spencer_1862", "target_name": "silex", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "silex", "target_book": "first_principles_spencer_1862", "target_name": "silex", "similarity": 1.0}], "id": 1769, "stable_key": "clu_c709e36c08dbd2c6-2", "ground_truth": {"modern_name": "Silica", "confidence": "high", "type": "mineral", "wikidata_id": "Q15724995", "wikidata_description": "mineral, material"}}, {"canonical_name": "Wilson", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "wilson", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Wilson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Wilson", "M. Wilson"], "contexts": ["made observations on heat radiation", "communicated results of observations"]}, {"entity_id": "wilson", "book_id": "kosmos_humboldt_1845", "name": "Wilson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Wilson"], "contexts": ["author of scientific paper"]}, {"entity_id": "wilson", "book_id": "coloquios_da_orta_1563", "name": "Wilson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Wilson"], "contexts": ["scholar revealing Indian literature to Europe", "cited for name of bamboo in Canar\u00e1"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Wilson", "target_book": "kosmos_humboldt_1845", "target_name": "Wilson", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Wilson", "target_book": "coloquios_da_orta_1563", "target_name": "Wilson", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Wilson", "target_book": "coloquios_da_orta_1563", "target_name": "Wilson", "similarity": 1.0}], "id": 1770, "stable_key": "clu_11c374500922bc68", "ground_truth": {"modern_name": "Wilson", "confidence": "medium", "type": "person", "description": "Scholar observing heat radiation and revealing Indian literature.", "note": "Multiple individuals named Wilson existed during this period; context suggests scholars or naturalists."}}, {"canonical_name": "Pisa", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "pisa", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pisa", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["pisa", "Pisa"], "contexts": ["treading of clay", "city"]}, {"entity_id": "pisa", "book_id": "polyanthea_medicinal", "name": "Pisa", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Pisa"], "contexts": ["city where scholar studied medicine"]}, {"entity_id": "pisa", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Pisa", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Pisa"], "contexts": ["location of Professor Mossotti", "city where Professor Matteucci was from"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pisa", "target_book": "polyanthea_medicinal", "target_name": "Pisa", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pisa", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Pisa", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Pisa", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Pisa", "similarity": 1.0}], "id": 1771, "stable_key": "clu_eb85f40275159afd", "ground_truth": {"wikipedia_extract": "Pisa ( PEE-z\u0259; Italian: [\u02c8pi\u02d0za]  or [\u02c8pi\u02d0sa]) is a city and comune (municipality) in Tuscany, Central Italy, straddling the Arno just before it empties into the Ligurian Sea. It is the capital city of the Province of Pisa. Although Pisa is known worldwide for the Leaning Tower of Pisa, the city contains more than twenty other historic churches, and several medieval and Renaissance palaces, mostly facing each other on the avenues along the Arno (\"Lungarno\"). Much of the city's architecture was financed from its history as one of the Italian maritime republics. The city is also home to the University of Pisa, which has a history going back to the 12th century, the Scuola Normale Superiore di Pisa, founded by Napoleon in 1810, and its offshoot, the Sant'Anna School of Advanced Studies. Most believe the hypothesis that the origin of the name Pisa comes from Etruscan and means 'mouth', as Pisa is at the mouth of the Arno river."}}, {"canonical_name": "villages", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "villages", "book_id": "relation_historique_humboldt_vol3_1825", "name": "villages", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["villages"], "contexts": ["settlements larger than hamlets", "settlement type"]}, {"entity_id": "hameaux", "book_id": "relation_historique_humboldt_vol3_1825", "name": "hameaux", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["hameaux"], "contexts": ["small rural settlements"]}, {"entity_id": "pueblos", "book_id": "historia_medicinal_monardes_1574", "name": "pueblos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["pueblos"], "contexts": ["locations with impure wells"]}, {"entity_id": "villages", "book_id": "connexion_physical_sciences_somerville_1858", "name": "villages", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["villages"], "contexts": ["small human settlements"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "villages", "target_book": "historia_medicinal_monardes_1574", "target_name": "pueblos", "similarity": 0.953}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "villages", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "villages", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "hameaux", "target_book": "historia_medicinal_monardes_1574", "target_name": "pueblos", "similarity": 0.884}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "hameaux", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "villages", "similarity": 0.898}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "pueblos", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "villages", "similarity": 0.953}], "id": 1772, "stable_key": "clu_ca70ad79751edff8", "ground_truth": {"modern_name": "Settlement", "confidence": "high", "type": "place", "note": "The term 'villages' encompasses various small human settlements, including hamlets and pueblos, and can also refer to specific locations with wells.", "wikidata_id": "Q486972", "wikidata_description": "place of any size, in which people permanently live", "wikipedia_url": "https://en.wikipedia.org/wiki/Human%20settlement", "wikipedia_extract": "In geography, statistics and archaeology, a settlement, locality or populated place is a community of people living in a particular place. The complexity of a settlement can range from a minuscule number of dwellings grouped together to the largest of cities with surrounding urbanized areas. Settlements include homesteads, hamlets, villages, towns and cities. A settlement may have known historical properties such as the date or era in which it was first settled or first settled by particular people. A number of factors like war, erosion, and the fall of great empires can result in the formation of abandoned settlements which provides relics for archaeological studies. The process of settlement involves human migration."}}, {"canonical_name": "Cordier", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "cordier", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cordier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Cordier"], "contexts": ["cited author in chemistry and physics"]}, {"entity_id": "cordier", "book_id": "kosmos_humboldt_1845", "name": "Cordier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Cordier"], "contexts": ["recipient of letter"]}, {"entity_id": "cordier", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cordier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Cordier"], "contexts": ["observed mine temperatures"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cordier", "target_book": "kosmos_humboldt_1845", "target_name": "Cordier", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cordier", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cordier", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cordier", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cordier", "similarity": 1.0}], "id": 1773, "stable_key": "clu_fd4d107b14fbcfc8", "ground_truth": {"modern_name": "Cordier", "confidence": "medium", "type": "person", "description": "Cited scholar in chemistry, physics, observed mine temperatures.", "note": "Multiple individuals named Cordier existed; context points to a scientific figure."}}, {"canonical_name": "Jacob", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "jacob", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Jacob", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Jacob"], "contexts": ["cited for gold product valuation"]}, {"entity_id": "jacob", "book_id": "polyanthea_medicinal", "name": "Jacob", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Jacob", "Jacobo Primoro\u017fo"], "contexts": ["biblical figure with spotted livestock", "mentioned in relation to life and health"]}, {"entity_id": "jacob", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Jacob", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Jacob"], "contexts": ["computed orbit of \u03b1 Centauri", "discovered Saturn's ring, determined periodic times"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Jacob", "target_book": "polyanthea_medicinal", "target_name": "Jacob", "similarity": 0.724}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Jacob", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Jacob", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Jacob", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Jacob", "similarity": 0.724}], "id": 1774, "stable_key": "clu_319906363a2b8fb4", "ground_truth": {"modern_name": "Jacob", "confidence": "medium", "type": "person", "description": "Biblical figure and agricultural innovator with livestock and financial matters.", "note": "The contexts point to multiple historical and biblical figures named Jacob. The association with livestock suggests the biblical patriarch Jacob."}}, {"canonical_name": "condensations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "condensation", "book_id": "relation_historique_humboldt_vol3_1825", "name": "condensation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["condensation"], "contexts": ["process of becoming denser"]}, {"entity_id": "condensation", "book_id": "kosmos_humboldt_1845", "name": "condensation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["condensation"], "contexts": ["process modifying chemical affinity"]}, {"entity_id": "condensations", "book_id": "connexion_physical_sciences_somerville_1858", "name": "condensations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["condensations"], "contexts": ["regions of increased pressure in a fluid", "regions of increased density"]}, {"entity_id": "condensation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "condensation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["condensation"], "contexts": ["process of becoming denser"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "condensation", "target_book": "kosmos_humboldt_1845", "target_name": "condensation", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "condensation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "condensations", "similarity": 0.956}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "condensation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "condensation", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "condensation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "condensations", "similarity": 0.956}, {"source_book": "kosmos_humboldt_1845", "source_name": "condensation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "condensation", "similarity": 1.0}], "id": 1775, "stable_key": "clu_e949ac485a868f57", "ground_truth": {"modern_name": "Condensation", "confidence": "high", "type": "concept", "wikidata_id": "Q1780990", "wikidata_description": "psychological concept for when a single idea (an image, memory, or thought) or dream object stands for several associations and ideas", "wikipedia_url": "https://en.wikipedia.org/wiki/Condensation%20%28psychology%29", "wikipedia_extract": "In Freudian psychoanalysis, a condensation (German: Verdichtung) is when a single idea (an image, memory, or thought) or dream object stands for several associations and ideas. This is an energetic reshuffling in which mental energy flows freely from one idea etc. to another. This free change of psychic energy is characteristic of so-called primary processes, which do not function with the aim of mental identity, but rather aim to fulfill pleasure, even self-deception to a certain extent, in order to make life easier, i.e. to avoid unpleasant and harmful things: a camouflage, reinterpretation, reconnection of disliked perceptions or memories. However, condensations can also be the determining factor for misperceptions, the psychoenergetic dynamics of which are not free-flowing, as certain external and internal motives are also involved."}}, {"canonical_name": "mercadores", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "mercadorcs", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mercadorcs", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Mercadorcs"], "contexts": ["merchants"]}, {"entity_id": "mercadores", "book_id": "coloquios_da_orta_1563", "name": "mercadores", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["mercadores", "hum mercador"], "contexts": ["merchants consulted about camphor water", "friend who lost money on s\u00e2ndalo"]}, {"entity_id": "mercador", "book_id": "polyanthea_medicinal", "name": "mercador", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["mercador"], "contexts": ["merchant who suffered from itching"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mercadorcs", "target_book": "coloquios_da_orta_1563", "target_name": "mercadores", "similarity": 0.94}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mercadorcs", "target_book": "polyanthea_medicinal", "target_name": "mercador", "similarity": 0.899}, {"source_book": "coloquios_da_orta_1563", "source_name": "mercadores", "target_book": "polyanthea_medicinal", "target_name": "mercador", "similarity": 0.943}], "id": 1776, "stable_key": "clu_12f72c653601de73", "ground_truth": {"modern_name": "Merchants", "confidence": "high", "type": "person", "description": "Individuals involved in trade and commerce, often consulted on goods.", "wikipedia_extract": "A merchant is a person or company engaged in trade, conducting sales through stores or online platforms, particularly one that engages in international import and export activities. Merchants have been known for as long as humans have engaged in trade and commerce. Merchants and merchant networks operated in ancient Babylonia, Assyria, China, Egypt, Greece, India, Persia, Phoenicia and Rome. During the European medieval period, a rapid expansion in trade and commerce led to the rise of a wealthy and powerful merchant class. The European Age of Discovery opened up new trading routes and gave European consumers access to a much broader range of goods. By the 18th century, a new type of manufacturer-merchant had started to emerge and modernize for the purpose of generating profit, cash flow, sales, and revenue using a combination of human, financial, intellectual and physical capital with a view to fueling economic development and growth."}}, {"canonical_name": "Madras", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "madras", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Madras", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Madras"], "contexts": ["city with observed average temperature"]}, {"entity_id": "madras", "book_id": "coloquios_da_orta_1563", "name": "Madras", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Madras", "Madrasta"], "contexts": ["publication location of Indian Botany", "modern city mentioned"]}, {"entity_id": "madras", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Madras", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Madras"], "contexts": ["location of astronomical observations", "Saturn\u2019s ring discovered from"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Madras", "target_book": "coloquios_da_orta_1563", "target_name": "Madras", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Madras", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Madras", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Madras", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Madras", "similarity": 1.0}], "id": 1777, "stable_key": "clu_53eec313c48484c4", "ground_truth": {"wikipedia_extract": "Chennai, also known as Madras (its official name until 1996), is the capital and largest city of Tamil Nadu, the southernmost state of India. It is located on the Coromandel Coast of the Bay of Bengal. According to the 2011 Indian census, Chennai is the sixth-most-populous city in India and forms the fourth-most-populous urban agglomeration. Incorporated in 1688, the Greater Chennai Corporation is the oldest municipal corporation in India and the second oldest in the world after London. Historically, the region was part of the Chola, Pandya, Pallava and Vijayanagara kingdoms during various eras. The coastal land which then contained the fishing village Madrasapattinam, was purchased by the British East India Company from the Nayak ruler Chennapa Nayaka in the 17th century."}}, {"canonical_name": "nitrous oxide gas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "gaz_nitreux", "book_id": "relation_historique_humboldt_vol3_1825", "name": "gaz nitreux", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["gaz nitreux"], "contexts": ["gas used in experiments"]}, {"entity_id": "nitrous_oxide_gas", "book_id": "principles_of_psychology_james_1890", "name": "nitrous oxide gas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["nitrous oxide gas"], "contexts": ["gas that can affect consciousness", "intoxicating gas"]}, {"entity_id": "nitrous_acid_gas", "book_id": "connexion_physical_sciences_somerville_1858", "name": "nitrous acid gas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nitrous acid gas"], "contexts": ["gas producing dark bands in spectrum"]}, {"entity_id": "nitrogen_gas", "book_id": "connexion_physical_sciences_somerville_1858", "name": "nitrogen gas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nitrogen gas"], "contexts": ["component of Earth's atmosphere"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "gaz nitreux", "target_book": "principles_of_psychology_james_1890", "target_name": "nitrous oxide gas", "similarity": 0.92}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "gaz nitreux", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nitrous acid gas", "similarity": 0.935}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "gaz nitreux", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nitrogen gas", "similarity": 0.918}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nitrous oxide gas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nitrous acid gas", "similarity": 0.968}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nitrous oxide gas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nitrogen gas", "similarity": 0.942}], "id": 1778, "stable_key": "clu_a07829510d7132c7", "ground_truth": {"modern_name": "Nitrous oxide", "confidence": "high", "type": "chemical", "note": "While 'nitrogen gas' is mentioned, the context of affecting consciousness and 'nitrous acid gas' points strongly to nitrous oxide (N2O).", "wikidata_id": "Q905750", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Nitrous%20oxide", "wikipedia_extract": "Nitrous oxide (dinitrogen oxide or dinitrogen monoxide), commonly known as laughing gas, nitrous, or historically as factitious air, among others, is a chemical compound, an oxide of nitrogen with the formula N2O. At room temperature, it is a colourless non-flammable gas, and has a slightly sweet scent and taste. At elevated temperatures, nitrous oxide is a powerful oxidiser similar to molecular oxygen. Nitrous oxide has significant medical uses, especially in surgery and dentistry, for its anaesthetic and pain-reducing effects, and it is on the World Health Organization's List of Essential Medicines. Its colloquial name, \"laughing gas\", coined by Humphry Davy, describes the euphoric effects upon inhaling it, which cause it to be used as a recreational drug inducing a brief \"high\". When abused chronically, it may cause neurological damage through inactivation of vitamin B12."}}, {"canonical_name": "Lacaille", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "la_caille", "book_id": "relation_historique_humboldt_vol3_1825", "name": "La Caille", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["La Caille"], "contexts": ["astronomer who determined southern star declinations"]}, {"entity_id": "la_caille", "book_id": "kosmos_humboldt_1845", "name": "La Caille", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["La Caille"], "contexts": ["astronomer who made pendulum measurements"]}, {"entity_id": "lacaille", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Lacaille", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Lacaille"], "contexts": ["astronomer who cataloged stars", "his globular nebulous cluster and nebula"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "La Caille", "target_book": "kosmos_humboldt_1845", "target_name": "La Caille", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "La Caille", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Lacaille", "similarity": 0.775}, {"source_book": "kosmos_humboldt_1845", "source_name": "La Caille", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Lacaille", "similarity": 0.775}], "id": 1779, "stable_key": "clu_027acd0eede3a7f2", "ground_truth": {"modern_name": "Nicolas-Louis de Lacaille", "confidence": "high", "type": "person", "birth_year": 1713, "death_year": 1762, "description": "French astronomer known for southern hemisphere star cataloging.", "wikidata_id": "Q59003750", "wikidata_description": "scholarly article published on March 1952"}}, {"canonical_name": "laryngis mufculi", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "larynx", "book_id": "relation_historique_humboldt_vol3_1825", "name": "larynx", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["larynx"], "contexts": ["lower larynx of birds"]}, {"entity_id": "larynx", "book_id": "principles_of_psychology_james_1890", "name": "larynx", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["larynx"], "contexts": ["voice box"]}, {"entity_id": "superior_laryngeal", "book_id": "principles_of_psychology_james_1890", "name": "superior laryngeal", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["superior laryngeal"], "contexts": ["nerve inhibiting inspiration"]}, {"entity_id": "laryngis_mufculi", "book_id": "polyanthea_medicinal", "name": "laryngis mufculi", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["laryngis mufculi", "laryngis"], "contexts": ["muscles of the larynx", "part of the throat"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "larynx", "target_book": "principles_of_psychology_james_1890", "target_name": "larynx", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "larynx", "target_book": "principles_of_psychology_james_1890", "target_name": "superior laryngeal", "similarity": 0.914}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "larynx", "target_book": "polyanthea_medicinal", "target_name": "laryngis mufculi", "similarity": 0.943}, {"source_book": "principles_of_psychology_james_1890", "source_name": "larynx", "target_book": "polyanthea_medicinal", "target_name": "laryngis mufculi", "similarity": 0.943}, {"source_book": "principles_of_psychology_james_1890", "source_name": "superior laryngeal", "target_book": "polyanthea_medicinal", "target_name": "laryngis mufculi", "similarity": 0.901}], "id": 1780, "stable_key": "clu_1a3b61da1b1926d4", "ground_truth": {"modern_name": "muscles of the larynx", "confidence": "high", "type": "concept", "wikidata_id": "Q6940335", "wikidata_description": "striated muscle groups which move the larynx", "wikipedia_extract": "The larynx (pl.: larynges or larynxes), commonly called the voice box, is an organ in the top of the neck involved in respiration, producing sound and protecting the trachea against food aspiration. The opening of the larynx into the pharynx, known as the laryngeal inlet, is about 4\u20135 centimeters in diameter. The larynx houses the vocal cords, and manipulates pitch and volume, which is essential for phonation. It is situated just below where the tract of the pharynx splits into the trachea and the esophagus. The triangle-shaped larynx consists largely of cartilages that are attached to surrounding structures by muscles or by fibrous and elastic tissue components. The larynx is lined by a ciliated columnar epithelium except for the vocal folds.", "wikipedia_url": "https://fr.wikipedia.org/wiki/Muscle_du_larynx"}}, {"canonical_name": "electric discharge", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "electric_discharge", "book_id": "principles_of_psychology_james_1890", "name": "electric discharge", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["electric discharge"], "contexts": ["flow of electrical energy through body", "flow of electric current"]}, {"entity_id": "electric_discharges", "book_id": "kosmos_humboldt_1845", "name": "electric discharges", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["electric discharges"], "contexts": ["electrical phenomena in clouds"]}, {"entity_id": "electric_discharge", "book_id": "connexion_physical_sciences_somerville_1858", "name": "electric discharge", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["electric discharge"], "contexts": ["transmission through steel bar"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "electric discharge", "target_book": "kosmos_humboldt_1845", "target_name": "electric discharges", "similarity": 0.981}, {"source_book": "principles_of_psychology_james_1890", "source_name": "electric discharge", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electric discharge", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "electric discharges", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electric discharge", "similarity": 0.981}], "id": 1781, "stable_key": "clu_bc5ad99d716712ab", "ground_truth": {"modern_name": "Electric discharge", "confidence": "high", "type": "concept", "wikidata_id": "Q488071", "wikidata_description": "flow of electric charge through a gas, liquid or solid", "wikipedia_url": "https://en.wikipedia.org/wiki/Electric%20discharge", "wikipedia_extract": "In electromagnetism, an  electric discharge is the release and transmission of electricity in an applied electric field through a medium such as a gas (i.e., an outgoing flow of electric current through a non-metal medium). The properties and effects of electric discharges are useful over a wide range of magnitudes. Tiny pulses of current are used to detect ionizing radiation in a Geiger\u2013M\u00fcller tube. A low steady current can illustrate the gas spectrum in a gas-filled tube. A neon lamp is an example of a gas-discharge lamp, useful both for illumination and as a voltage regulator. A flashtube generates a short pulse of intense light useful for photography by sending a heavy current through a gas arc discharge."}}, {"canonical_name": "Latin", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "latin", "book_id": "principles_of_psychology_james_1890", "name": "Latin", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Latin"], "contexts": ["language of distinction", "language and country"]}, {"entity_id": "latin", "book_id": "historia_medicinal_monardes_1574", "name": "Latin", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Latin"], "contexts": ["language of translation"]}, {"entity_id": "latin", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Latin", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Latin"], "contexts": ["ancient Indo-European language"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Latin", "target_book": "historia_medicinal_monardes_1574", "target_name": "Latin", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Latin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Latin", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Latin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Latin", "similarity": 1.0}], "id": 1782, "stable_key": "clu_a04061d00b9f884f", "ground_truth": {"wikipedia_extract": "Latin (lingua Latina or Latinum) is a classical language belonging to the Italic branch of the Indo-European languages. Latin was originally spoken by the Latins in Latium (now known as Lazio), the lower Tiber area around Rome, Italy. Through the expansion of the Roman Republic, it became the dominant language in the Italian Peninsula and subsequently throughout the Roman Empire. It has greatly influenced many languages, including English, having contributed many words to the English lexicon, particularly after the Christianisation of the Anglo-Saxons and the Norman Conquest. Latin roots appear frequently in the technical vocabulary used by fields such as theology, the sciences, medicine, and law. By the late Roman Republic, Old Latin had evolved into standardised Classical Latin."}}, {"canonical_name": "silence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "silence", "book_id": "principles_of_psychology_james_1890", "name": "silence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["silence"], "contexts": ["absence of sound"]}, {"entity_id": "silence", "book_id": "kosmos_humboldt_1845", "name": "silence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["silence"], "contexts": ["absence of sound"]}, {"entity_id": "silence", "book_id": "connexion_physical_sciences_somerville_1858", "name": "silence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["silence"], "contexts": ["absence of sound"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "silence", "target_book": "kosmos_humboldt_1845", "target_name": "silence", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "silence", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "silence", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "silence", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "silence", "similarity": 1.0}], "id": 1783, "stable_key": "clu_0bba1059bc396051", "ground_truth": {"modern_name": "silence", "confidence": "high", "type": "concept", "wikidata_id": "Q502261", "wikidata_description": "lack of audible sound", "wikipedia_url": "https://en.wikipedia.org/wiki/Silence", "wikipedia_extract": "Silence is the absence of ambient audible sound, the emission of sounds of such low intensity that they do not draw attention to themselves, or the state of having ceased to produce sounds; this latter sense can be extended to apply to the cessation or absence of any form of communication, whether through speech or other medium. Remaining mute can be a symptom of mental illness. Sometimes speakers fall silent when they hesitate in searching for a word, or interrupt themselves before correcting themselves. Discourse analysis shows that people use brief silences to mark the boundaries of prosodic units, in turn-taking, or as reactive tokens, for example, as a sign of displeasure, disagreement, embarrassment, desire to think, confusion, and the like. Relatively prolonged intervals of silence can be used in rituals; in some religious disciplines, people maintain silence for protracted periods, or even for the rest of their lives, as an ascetic means of spiritual transformation. In the philosophy of perception and the science of perception, there has been a longstanding controversy as to how humans experience silence: \"the perceptual view (we literally hear silence), and the cognitive view (we only judge or infer silence)\", with prominent theories holding the latter view."}}, {"canonical_name": "oscillation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "oscillation", "book_id": "principles_of_psychology_james_1890", "name": "oscillation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["oscillation"], "contexts": ["swinging back and forth", "rapid shifting of attention"]}, {"entity_id": "oscillation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "oscillation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["oscillation"], "contexts": ["back and forth movement", "rapid movement back and forth"]}, {"entity_id": "oscillation", "book_id": "first_principles_spencer_1862", "name": "oscillation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["oscillation"], "contexts": ["back and forth movement"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "oscillation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "oscillation", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "oscillation", "target_book": "first_principles_spencer_1862", "target_name": "oscillation", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "oscillation", "target_book": "first_principles_spencer_1862", "target_name": "oscillation", "similarity": 1.0}], "id": 1784, "stable_key": "clu_a7bd35781961ad09-2", "ground_truth": {"modern_name": "Oscillation", "confidence": "high", "type": "concept", "wikidata_id": "Q170475", "wikidata_description": "repetitive variation of some measure about a central value", "wikipedia_url": "https://en.wikipedia.org/wiki/Oscillation", "wikipedia_extract": "Oscillation is the repetitive or periodic variation, typically in time, of some measure about a central value (often a point of equilibrium) or between two or more different states. Familiar examples of oscillation include a swinging pendulum and alternating current. Oscillations can be used in physics to approximate complex interactions, such as those between atoms. Oscillations occur not only in mechanical systems but also in dynamic systems in virtually every area of science: for example the beating of the human heart (for circulation),  business cycles in economics, predator\u2013prey population cycles in ecology, geothermal geysers in geology, vibration of strings in guitar and other string instruments, periodic firing of nerve cells in the brain, and the periodic swelling of Cepheid variable stars in astronomy. The term vibration is precisely used to describe a mechanical oscillation. Oscillation, especially rapid oscillation, may be an undesirable phenomenon in process control and control theory (e.g."}}, {"canonical_name": "hours", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "hours", "book_id": "principles_of_psychology_james_1890", "name": "hours", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["hours"], "contexts": ["units of time", "unit of time"]}, {"entity_id": "horas", "book_id": "historia_medicinal_monardes_1574", "name": "horas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["horas"], "contexts": ["duration for soaking"]}, {"entity_id": "hours", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Hours", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Hours", "hours"], "contexts": ["unit of time", "units of time"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "hours", "target_book": "historia_medicinal_monardes_1574", "target_name": "horas", "similarity": 0.955}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hours", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Hours", "similarity": 0.968}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "horas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Hours", "similarity": 0.933}], "id": 1785, "stable_key": "clu_ad7e2fa36baeeb71-2", "ground_truth": {"modern_name": "Time", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "note": "The term 'hours' in the context of early modern texts invariably refers to units of time, fundamental to measurement and daily life."}}, {"canonical_name": "study", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "study", "book_id": "principles_of_psychology_james_1890", "name": "study", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["study"], "contexts": ["acquisition of knowledge", "act of learning"]}, {"entity_id": "estudo", "book_id": "polyanthea_medicinal", "name": "estudo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["estudo"], "contexts": ["activity related to learning", "study weakening stomach heat"]}, {"entity_id": "study", "book_id": "connexion_physical_sciences_somerville_1858", "name": "study", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["study"], "contexts": ["essential advantages of"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "study", "target_book": "polyanthea_medicinal", "target_name": "estudo", "similarity": 0.984}, {"source_book": "principles_of_psychology_james_1890", "source_name": "study", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "study", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "estudo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "study", "similarity": 0.984}], "id": 1786, "stable_key": "clu_e04b1a735402363a", "ground_truth": {"modern_name": "Study", "confidence": "high", "type": "concept", "note": "The concept of 'study' as the acquisition of knowledge or a learning activity is consistent across the provided texts.", "wikidata_id": "", "wikidata_description": "project of one or more scientists, or of an organization in a scientific field", "wikipedia_url": "", "wikipedia_extract": ""}}, {"canonical_name": "Royal Society", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "royal_society", "book_id": "principles_of_psychology_james_1890", "name": "Royal Society", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Royal Society"], "contexts": ["British scientific institution"]}, {"entity_id": "royal_society", "book_id": "kosmos_humboldt_1845", "name": "Royal Society", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Royal Society"], "contexts": ["scientific institution in London", "scientific society in London"]}, {"entity_id": "royal_society", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Royal Society", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Royal Society"], "contexts": ["scientific society where paper was read", "scientific society in London"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Royal Society", "target_book": "kosmos_humboldt_1845", "target_name": "Royal Society", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Royal Society", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Royal Society", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Royal Society", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Royal Society", "similarity": 1.0}], "id": 1787, "stable_key": "clu_d9854b0f4e4e2430", "ground_truth": {"modern_name": "Royal Society", "confidence": "high", "type": "concept", "wikidata_id": "Q1892802", "wikidata_description": "wildlife conservation organisation in the United Kingdom", "wikipedia_url": "https://en.wikipedia.org/wiki/Royal%20Society%20for%20the%20Protection%20of%20Birds", "wikipedia_extract": "The Royal Society for the Protection of Birds (RSPB) is a charitable organisation registered in England and Wales and in Scotland. It was founded in 1889. It works to promote conservation and protection of birds and the wider environment through public awareness campaigns, petitions and through the operation of nature reserves throughout the United Kingdom. In 2023/24 the RSPB had revenue of \u00a3169 million, 2,517 employees, 13,500 volunteers and 1.1 million members (including 195,000 youth members), making it one of the world's largest wildlife conservation organisations. The RSPB has many local groups and maintains 222 nature reserves. The origins of the RSPB lie with two groups of women, both formed in 1889: The Plumage League was founded by Emily Williamson at her house in Didsbury, Manchester, as a protest group campaigning against the use of great crested grebe and kittiwake skins and feathers in fur clothing."}}, {"canonical_name": "humana", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "human_person", "book_id": "principles_of_psychology_james_1890", "name": "human person", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human person"], "contexts": ["the individual human being"]}, {"entity_id": "humana", "book_id": "ricettario_fiorentino_1597", "name": "humana", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["humana", "Humano"], "contexts": ["human"]}, {"entity_id": "humano", "book_id": "polyanthea_medicinal", "name": "humano", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["humano"], "contexts": ["human ingenuity", "describes the nature of remedies"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "human person", "target_book": "ricettario_fiorentino_1597", "target_name": "humana", "similarity": 0.905}, {"source_book": "principles_of_psychology_james_1890", "source_name": "human person", "target_book": "polyanthea_medicinal", "target_name": "humano", "similarity": 0.904}, {"source_book": "ricettario_fiorentino_1597", "source_name": "humana", "target_book": "polyanthea_medicinal", "target_name": "humano", "similarity": 0.956}], "id": 1788, "stable_key": "clu_85e9566de5c06f74", "ground_truth": {"modern_name": "human", "confidence": "high", "type": "concept", "wikidata_id": "Q28937368", "wikidata_description": "philosophical concept"}}, {"canonical_name": "casa", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "home", "book_id": "principles_of_psychology_james_1890", "name": "home", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["home"], "contexts": ["place of residence"]}, {"entity_id": "casa", "book_id": "historia_medicinal_monardes_1574", "name": "casa", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["casa"], "contexts": ["dwelling"]}, {"entity_id": "casa", "book_id": "polyanthea_medicinal", "name": "casa", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["casa", "casas"], "contexts": ["dwelling place", "home"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "home", "target_book": "historia_medicinal_monardes_1574", "target_name": "casa", "similarity": 0.907}, {"source_book": "principles_of_psychology_james_1890", "source_name": "home", "target_book": "polyanthea_medicinal", "target_name": "casa", "similarity": 0.907}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "casa", "target_book": "polyanthea_medicinal", "target_name": "casa", "similarity": 1.0}], "id": 1789, "stable_key": "clu_064b24bb470efdb3", "ground_truth": {"modern_name": "house", "confidence": "high", "type": "place", "wikidata_id": "Q83310", "wikidata_description": "species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/House", "wikipedia_extract": "A house is a single-unit residential building. It may range in complexity from a rudimentary hut to a complex structure of wood, masonry, concrete or other material, outfitted with plumbing, electrical, and heating, ventilation, and air conditioning systems. Houses use a range of different roofing systems to keep precipitation such as rain from getting into the dwelling space. Houses generally have doors or locks to secure the dwelling space and protect its inhabitants and contents from burglars or other trespassers. Most conventional modern houses in Western cultures will contain one or more bedrooms and bathrooms, a kitchen or cooking area, and a living room. A house may have a separate dining room, or the eating area may be integrated into the kitchen or another room."}}, {"canonical_name": "bodies", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "bodies", "book_id": "kosmos_humboldt_1845", "name": "bodies", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["bodies"], "contexts": ["occupying regions of space"]}, {"entity_id": "bodies", "book_id": "connexion_physical_sciences_somerville_1858", "name": "bodies", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["bodies"], "contexts": ["celestial objects", "physical entities"]}, {"entity_id": "external_bodies", "book_id": "first_principles_spencer_1862", "name": "external bodies", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["external bodies"], "contexts": ["objects outside the system"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "bodies", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "bodies", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "bodies", "target_book": "first_principles_spencer_1862", "target_name": "external bodies", "similarity": 0.937}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "bodies", "target_book": "first_principles_spencer_1862", "target_name": "external bodies", "similarity": 0.937}], "id": 1790, "stable_key": "clu_3b49c8f11d41fb97", "ground_truth": {"modern_name": "bodies", "confidence": "high", "type": "object"}}, {"canonical_name": "Imbecillitate", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "idiotism", "book_id": "principles_of_psychology_james_1890", "name": "idiotism", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["idiotism"], "contexts": ["severe mental impairment"]}, {"entity_id": "imbecillitate", "book_id": "polyanthea_medicinal", "name": "Imbecillitate", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["Imbecillitate", "imbecillitate"], "contexts": ["weakness"]}, {"entity_id": "idiotcy", "book_id": "first_principles_spencer_1862", "name": "idiotcy", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["idiotcy"], "contexts": ["severe intellectual disability"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "idiotism", "target_book": "polyanthea_medicinal", "target_name": "Imbecillitate", "similarity": 0.911}, {"source_book": "principles_of_psychology_james_1890", "source_name": "idiotism", "target_book": "first_principles_spencer_1862", "target_name": "idiotcy", "similarity": 0.979}, {"source_book": "polyanthea_medicinal", "source_name": "Imbecillitate", "target_book": "first_principles_spencer_1862", "target_name": "idiotcy", "similarity": 0.932}], "id": 1791, "stable_key": "clu_105e55e4bb32e42d", "ground_truth": {"modern_name": "intellectual disability", "confidence": "high", "type": "disease", "modern_term": "intellectual disability", "note": "The terms 'idiots' and 'idiotcy' were historical medical classifications for individuals with severe intellectual disabilities, now understood as intellectual disability.", "wikidata_id": "Q183560", "wikidata_description": "generalized neurodevelopmental disorder", "wikipedia_extract": "SYNGAP1-related intellectual disability is a monogenetic developmental and epileptic encephalopathy that affects the central nervous system. Symptoms include intellectual disability, epilepsy, autism, sensory processing deficits, hypotonia and unstable gait. The first signs of SYNGAP1-related encephalopathy are typically gross motor delays in infancy followed by developmental delays, seizure onset and language impairment. Penetrance is 100%. Mild to severe intellectual or developmental disability is present in the majority of patients. Epilepsy is present in the majority of cases, with approximately 80-98% of patients affected by seizures.", "wikipedia_url": "https://en.wikipedia.org/wiki/SYNGAP1-related_intellectual_disability"}}, {"canonical_name": "candil", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "tallow-candle", "book_id": "principles_of_psychology_james_1890", "name": "tallow-candle", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["tallow-candle"], "contexts": ["candle made from animal fat"]}, {"entity_id": "candil", "book_id": "historia_medicinal_monardes_1574", "name": "candil", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["candil"], "contexts": ["lamp used for heating"]}, {"entity_id": "candil", "book_id": "coloquios_da_orta_1563", "name": "candil", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["candil", "candea"], "contexts": ["unit of weight in Cambaya", "unit of measurement"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "tallow-candle", "target_book": "historia_medicinal_monardes_1574", "target_name": "candil", "similarity": 0.903}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tallow-candle", "target_book": "coloquios_da_orta_1563", "target_name": "candil", "similarity": 0.903}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "candil", "target_book": "coloquios_da_orta_1563", "target_name": "candil", "similarity": 1.0}], "id": 1792, "stable_key": "clu_23872f66b456acde", "ground_truth": {"modern_name": "lamp", "confidence": "medium", "type": "object", "note": "The term 'candil' can refer to a candle or a lamp. Given the context of 'heating' and 'unit of weight', 'lamp' is a more encompassing modern referent. However, 'tallow-candle' suggests a more specific interpretation related to candles.", "wikidata_id": "Q2110", "wikidata_description": "province of Indonesia, on the island of Sumatra"}}, {"canonical_name": "Mr. Joule", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "mr__c_", "book_id": "principles_of_psychology_james_1890", "name": "Mr. C.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Mr. C."], "contexts": ["performed experiments on association times"]}, {"entity_id": "mr__joule", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mr. Joule", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Mr. Joule"], "contexts": ["scientist who proved mechanical equivalent of heat", "agrees with observed phenomena of heat"]}, {"entity_id": "mr__joule", "book_id": "first_principles_spencer_1862", "name": "Mr. Joule", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Mr. Joule"], "contexts": ["scientist who measured heat and work"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Mr. C.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mr. Joule", "similarity": 0.863}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Mr. C.", "target_book": "first_principles_spencer_1862", "target_name": "Mr. Joule", "similarity": 0.863}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Mr. Joule", "target_book": "first_principles_spencer_1862", "target_name": "Mr. Joule", "similarity": 1.0}], "id": 1793, "stable_key": "clu_bf50f0617c025f0a", "ground_truth": {"modern_name": "James Prescott Joule", "confidence": "high", "type": "person", "birth_year": 1818, "death_year": 1889, "description": "English physicist, known for work on electricity and thermodynamics.", "wikidata_id": "Q8962", "wikidata_description": "English physicist and brewer (1818\u20131889)", "wikipedia_url": "https://en.wikipedia.org/wiki/James%20Prescott%20Joule", "wikipedia_extract": "James Prescott Joule (; 24 December 1818 \u2013  11 October 1889) was an English physicist. Joule studied the nature of heat and discovered its relationship to mechanical work. This led to the law of conservation of energy, which in turn led to the development of the first law of thermodynamics. The SI unit of energy, the joule (J), is named after him. He worked with Lord Kelvin to develop an absolute thermodynamic temperature scale, which came to be called the Kelvin scale. Joule also made observations of magnetostriction, and he found the relationship between the current through a resistor and the heat dissipated, which is also called Joule's first law."}}, {"canonical_name": "dias", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "days", "book_id": "principles_of_psychology_james_1890", "name": "days", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["days"], "contexts": ["unit of time"]}, {"entity_id": "dias", "book_id": "coloquios_da_orta_1563", "name": "dias", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["dias"], "contexts": ["unit of time"]}, {"entity_id": "days", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Days", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Days", "days"], "contexts": ["unit of time", "units of time"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "days", "target_book": "coloquios_da_orta_1563", "target_name": "dias", "similarity": 0.918}, {"source_book": "principles_of_psychology_james_1890", "source_name": "days", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Days", "similarity": 0.974}, {"source_book": "coloquios_da_orta_1563", "source_name": "dias", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Days", "similarity": 0.906}], "id": 1794, "stable_key": "clu_e2871960ae5ff1f4-2", "ground_truth": {"modern_name": "day", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Day", "wikipedia_extract": "A day is the time period of a full rotation of the Earth with respect to the Sun. On average, this is 24 hours (86,400 seconds). As a day passes at a given location it experiences morning, afternoon, evening, and night. This daily cycle drives circadian rhythms in many organisms, which are vital to many life processes. A collection of sequential days is organized into calendars as dates, almost always into weeks, months and years. A solar calendar organizes dates based on the Sun's annual cycle, giving consistent start dates for the four seasons from year to year."}}, {"canonical_name": "velocity of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "velocity_of_light", "book_id": "principles_of_psychology_james_1890", "name": "velocity of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["velocity of light"], "contexts": ["speed at which light travels"]}, {"entity_id": "velocity_of_light", "book_id": "kosmos_humboldt_1845", "name": "velocity of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["velocity of light"], "contexts": ["speed of light propagation"]}, {"entity_id": "velocity_of_light", "book_id": "connexion_physical_sciences_somerville_1858", "name": "velocity of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["velocity of light", "Velocity of Light"], "contexts": ["speed at which light travels", "speed of light"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "velocity of light", "target_book": "kosmos_humboldt_1845", "target_name": "velocity of light", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "velocity of light", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "velocity of light", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "velocity of light", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "velocity of light", "similarity": 1.0}], "id": 1795, "stable_key": "clu_a7587998a33cb5c3", "ground_truth": {"modern_name": "speed of light", "confidence": "high", "type": "concept", "wikidata_id": "Q2111", "wikidata_description": "speed of electromagnetic waves in vacuum"}}, {"canonical_name": "a\u00f1o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "year", "book_id": "principles_of_psychology_james_1890", "name": "year", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["year"], "contexts": ["period of twelve months"]}, {"entity_id": "a\u00f1o", "book_id": "historia_medicinal_monardes_1574", "name": "a\u00f1o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["a\u00f1o"], "contexts": ["time period", "years"]}, {"entity_id": "year", "book_id": "connexion_physical_sciences_somerville_1858", "name": "year", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["year"], "contexts": ["time for Earth's orbit around the Sun", "period of 365 days"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "year", "target_book": "historia_medicinal_monardes_1574", "target_name": "a\u00f1o", "similarity": 0.969}, {"source_book": "principles_of_psychology_james_1890", "source_name": "year", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "year", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "a\u00f1o", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "year", "similarity": 0.969}], "id": 1796, "stable_key": "clu_97688046104221c0", "ground_truth": {"modern_name": "year", "confidence": "high", "type": "concept", "note": "The numbers '1867' and '1870' clearly refer to specific years, used in the context of historical dates for scientific works.", "wikidata_id": "Q577", "wikidata_description": "the orbital period of the Earth: the estimated period of time for the Earth's orbit around the Sun and observed at a fixed geographic point (averaging 365.24 days); base later modified to define or adjust various calendars", "wikipedia_url": "https://en.wikipedia.org/wiki/Year", "wikipedia_extract": "A year is a unit of time based on how long it takes the Earth to orbit the Sun. In scientific use, the tropical year (approximately 365 solar days, 5 hours, 48 minutes, 45 seconds) and the sidereal year (about 20 minutes longer) are more exact. The modern calendar year, as reckoned according to the Gregorian calendar, approximates the tropical year by using a system of leap years. The term 'year' is also used to indicate other periods of roughly similar duration, such as the lunar year (a roughly 354-day cycle of twelve of the Moon's phases \u2013 see lunar calendar), as well as periods loosely associated with the calendar or astronomical year, such as the seasonal year, the fiscal year, the academic year, etc. Due to the Earth's axial tilt, the course of a year sees the passing of the seasons, marked by changes in weather, the hours of daylight, and, consequently, vegetation and soil fertility. In temperate and subpolar regions around the planet, four seasons are generally recognized: spring, summer, autumn, and winter."}}, {"canonical_name": "estimuladade", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "excitations", "book_id": "principles_of_psychology_james_1890", "name": "excitations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["excitations"], "contexts": ["stimulation of nerves or organs"]}, {"entity_id": "estimuladade", "book_id": "polyanthea_medicinal", "name": "estimuladade", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["estimuladade", "estimulao"], "contexts": ["stimulated", "stimulates"]}, {"entity_id": "excitation", "book_id": "first_principles_spencer_1862", "name": "excitation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["excitation"], "contexts": ["stimulation or arousal", "stimulation of nervous tissue"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "excitations", "target_book": "first_principles_spencer_1862", "target_name": "excitation", "similarity": 0.963}, {"source_book": "polyanthea_medicinal", "source_name": "estimuladade", "target_book": "first_principles_spencer_1862", "target_name": "excitation", "similarity": 0.886}], "id": 1797, "stable_key": "clu_7db8bfd92b19d14e", "ground_truth": {"modern_name": "Stimulation", "confidence": "high", "type": "concept", "wikidata_id": "Q14818068", "wikidata_description": "Any process that activates or increases the frequency, rate or extent of transcription from an RNA polymerase II promoter."}}, {"canonical_name": "Munich", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "munich", "book_id": "kosmos_humboldt_1845", "name": "Munich", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Munich"], "contexts": ["location where Lamont saw satellites", "city in Germany"]}, {"entity_id": "munich", "book_id": "coloquios_da_orta_1563", "name": "Munich", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Munich"], "contexts": ["city of publication"]}, {"entity_id": "munich", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Munich", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Munich"], "contexts": ["city where Fraunhofer worked"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Munich", "target_book": "coloquios_da_orta_1563", "target_name": "Munich", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Munich", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Munich", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Munich", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Munich", "similarity": 1.0}], "id": 1798, "stable_key": "clu_5355b1f036488b1a", "ground_truth": {"modern_name": "Munich", "confidence": "high", "type": "place", "country": "Germany", "note": "The context of Fraunhofer working there solidifies the identification with the German city.", "wikidata_id": "Q1726", "wikidata_description": "capital and most populous city of Bavaria, Germany", "wikipedia_url": "https://en.wikipedia.org/wiki/Munich", "wikipedia_extract": "Munich is the capital and most populous city of Bavaria, Germany. As of 30 November 2024, its population was 1,604,384, making it the third-largest city in Germany after Berlin and Hamburg. Munich is the largest city in Germany that is not a state of its own, and it ranks as the 11th-largest city in the European Union. The metropolitan area has around 3 million inhabitants, and the broader Munich Metropolitan Region is home to about 6.2 million people. It is the third largest metropolitan region by GDP in the European Union. Munich is located on the river Isar north of the Alps."}}, {"canonical_name": "magnetic meridian", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "magnetic_meridian", "book_id": "kosmos_humboldt_1845", "name": "magnetic meridian", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["magnetic meridian"], "contexts": ["line of magnetic north-south", "line of magnetic force"]}, {"entity_id": "magnetic_meridians", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic meridians", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic meridians"], "contexts": ["lines of magnetic force on Earth"]}, {"entity_id": "magnetic_meridian", "book_id": "first_principles_spencer_1862", "name": "magnetic meridian", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic meridian"], "contexts": ["line of magnetic force"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "magnetic meridian", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic meridians", "similarity": 0.929}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic meridian", "target_book": "first_principles_spencer_1862", "target_name": "magnetic meridian", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "magnetic meridians", "target_book": "first_principles_spencer_1862", "target_name": "magnetic meridian", "similarity": 0.929}], "id": 1799, "stable_key": "clu_7ca1afc4d67776a7", "ground_truth": {"modern_name": "Magnetic meridian", "confidence": "high", "type": "concept"}}, {"canonical_name": "external crust", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "external_crust", "book_id": "kosmos_humboldt_1845", "name": "external crust", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["external crust"], "contexts": ["outer layer of the planet", "outer layer of the Earth"]}, {"entity_id": "crust", "book_id": "connexion_physical_sciences_somerville_1858", "name": "crust", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["crust"], "contexts": ["outer layer of a planet"]}, {"entity_id": "crust", "book_id": "first_principles_spencer_1862", "name": "crust", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["crust"], "contexts": ["outer layer of the Earth"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "external crust", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "crust", "similarity": 0.907}, {"source_book": "kosmos_humboldt_1845", "source_name": "external crust", "target_book": "first_principles_spencer_1862", "target_name": "crust", "similarity": 0.907}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "crust", "target_book": "first_principles_spencer_1862", "target_name": "crust", "similarity": 1.0}], "id": 1800, "stable_key": "clu_db99fb31e4b785e5", "ground_truth": {"modern_name": "Crust (geology)", "confidence": "high", "type": "mineral", "note": "This refers to the Earth's crust in a geological context.", "wikidata_id": "Q129923132", "wikidata_description": "scholarly article published in March 2018"}}, {"canonical_name": "polarized ray", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "colored_polar_light", "book_id": "kosmos_humboldt_1845", "name": "colored polar light", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["colored polar light"], "contexts": ["aurora borealis phenomenon"]}, {"entity_id": "polarized_ray", "book_id": "connexion_physical_sciences_somerville_1858", "name": "polarized ray", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["polarized ray"], "contexts": ["light wave with specific orientation"]}, {"entity_id": "polarized_ray_of_light", "book_id": "connexion_physical_sciences_somerville_1858", "name": "polarized ray of light", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["polarized ray of light"], "contexts": ["light whose rotation is affected by glass compression"]}, {"entity_id": "polarized_ray_of_light", "book_id": "first_principles_spencer_1862", "name": "polarized ray of light", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["polarized ray of light"], "contexts": ["light with vibrations in one plane"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "colored polar light", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "polarized ray of light", "similarity": 0.89}, {"source_book": "kosmos_humboldt_1845", "source_name": "colored polar light", "target_book": "first_principles_spencer_1862", "target_name": "polarized ray of light", "similarity": 0.89}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "polarized ray", "target_book": "first_principles_spencer_1862", "target_name": "polarized ray of light", "similarity": 0.976}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "polarized ray of light", "target_book": "first_principles_spencer_1862", "target_name": "polarized ray of light", "similarity": 1.0}], "id": 1801, "stable_key": "clu_2cbb11c0550fddff", "ground_truth": {"modern_name": "polarized light", "confidence": "high", "type": "concept", "wikidata_id": "Q12046176", "wikidata_description": "optical microscopy technique", "wikipedia_url": "https://en.wikipedia.org/wiki/Polarized%20light%20microscopy", "wikipedia_extract": "Polarized light microscopy can mean any of a number of optical microscopy techniques involving polarized light. Simple techniques include illumination of the sample with polarized light. Directly transmitted light can, optionally, be blocked with a polariser oriented at 90 degrees to the illumination. More complex microscopy techniques which take advantage of polarized light include differential interference contrast microscopy and interference reflection microscopy. Scientists will often use a device called a polarizing plate to convert natural light into polarized light. These illumination techniques are most commonly used on birefringent samples where the polarized light interacts strongly with the sample and so generating contrast with the background."}}, {"canonical_name": "Gobi", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "gobi", "book_id": "kosmos_humboldt_1845", "name": "Gobi", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Gobi"], "contexts": ["elevated desert region"]}, {"entity_id": "gobi", "book_id": "coloquios_da_orta_1563", "name": "Gobi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Gobi", "Gobl"], "contexts": ["desert on caravan route", "geographic location"]}, {"entity_id": "great_gobi", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Great Gobi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Great Gobi"], "contexts": ["arid Asiatic desert"]}, {"entity_id": "gobi", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Gobi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Gobi"], "contexts": ["effect of the expansion of air over"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Gobi", "target_book": "coloquios_da_orta_1563", "target_name": "Gobi", "similarity": 0.786}, {"source_book": "kosmos_humboldt_1845", "source_name": "Gobi", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Gobi", "similarity": 0.786}, {"source_book": "coloquios_da_orta_1563", "source_name": "Gobi", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Great Gobi", "similarity": 0.914}, {"source_book": "coloquios_da_orta_1563", "source_name": "Gobi", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Gobi", "similarity": 1.0}], "id": 1802, "stable_key": "clu_99e4b8a8477b941b", "ground_truth": {"modern_name": "Gobi Desert", "confidence": "high", "type": "place", "country": "Mongolia, China", "wikidata_id": "Q42070", "wikidata_description": "desert in China and Mongolia"}}, {"canonical_name": "mountain chains", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "chains_of_mountains", "book_id": "kosmos_humboldt_1845", "name": "chains of mountains", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["chains of mountains"], "contexts": ["ranges of high landforms"]}, {"entity_id": "mountain_chains", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mountain chains", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["mountain chains"], "contexts": ["series of mountains", "separates botanical districts"]}, {"entity_id": "mountain-chains", "book_id": "first_principles_spencer_1862", "name": "mountain-chains", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["mountain-chains"], "contexts": ["series of mountains", "series of connected mountains"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "chains of mountains", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mountain chains", "similarity": 0.975}, {"source_book": "kosmos_humboldt_1845", "source_name": "chains of mountains", "target_book": "first_principles_spencer_1862", "target_name": "mountain-chains", "similarity": 0.95}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "mountain chains", "target_book": "first_principles_spencer_1862", "target_name": "mountain-chains", "similarity": 0.978}], "id": 1803, "stable_key": "clu_6a6caccae4b60aaf", "ground_truth": {"modern_name": "Mountain ranges", "confidence": "high", "type": "place", "wikidata_id": "Q46831", "wikidata_description": "geographic area containing several geologically related mountains", "wikipedia_url": "https://en.wikipedia.org/wiki/Mountain%20range", "wikipedia_extract": "A mountain range or hill range is a series of mountains or hills arranged in a line and connected by high ground. A mountain system or mountain belt is a group of mountain ranges with similarity in form, structure, and alignment that have arisen from the same cause, usually an orogeny. Mountain ranges are formed by a variety of geological processes, but most of the significant ones on Earth are the result of plate tectonics. Mountain ranges are also found on many planetary mass objects in the Solar System and are likely a feature of most terrestrial planets. Mountain ranges are usually segmented by highlands or mountain passes and valleys. Individual mountains within the same mountain range do not necessarily have the same geologic structure or petrology."}}, {"canonical_name": "chemical decomposition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "chemical_decompositions", "book_id": "kosmos_humboldt_1845", "name": "chemical decompositions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["chemical decompositions"], "contexts": ["breaking down chemical substances"]}, {"entity_id": "chemical_decomposition", "book_id": "connexion_physical_sciences_somerville_1858", "name": "chemical decomposition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["chemical decomposition"], "contexts": ["breaking down substances by electricity", "effect of voltaic agency"]}, {"entity_id": "chemical_decomposition", "book_id": "first_principles_spencer_1862", "name": "chemical decomposition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["chemical decomposition"], "contexts": ["influenced by heat and electricity", "breaking down of chemical compounds"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "chemical decompositions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chemical decomposition", "similarity": 0.963}, {"source_book": "kosmos_humboldt_1845", "source_name": "chemical decompositions", "target_book": "first_principles_spencer_1862", "target_name": "chemical decomposition", "similarity": 0.963}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "chemical decomposition", "target_book": "first_principles_spencer_1862", "target_name": "chemical decomposition", "similarity": 1.0}], "id": 1804, "stable_key": "clu_d13f6bb6e5e7b821", "ground_truth": {"modern_name": "chemical decomposition", "confidence": "high", "type": "concept", "wikidata_id": "Q192036", "wikidata_description": "breakdown of a single entity (normal molecule, reaction intermediate, etc.) into two or more fragments; opposite or reverse process of a synthesis reaction"}}, {"canonical_name": "agua azerada", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "agua_azerada", "book_id": "historia_medicinal_monardes_1574", "name": "agua azerada", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["agua azerada", "agua Azera", "agua Azerada"], "contexts": ["acidulated water preparation", "steel-infused water"]}, {"entity_id": "agua_salgada", "book_id": "coloquios_da_orta_1563", "name": "agua salgada", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["agua salgada"], "contexts": ["water that makes reeds greener"]}, {"entity_id": "agua_salgada", "book_id": "polyanthea_medicinal", "name": "agua salgada", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["agua salgada"], "contexts": ["salt water"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "agua azerada", "target_book": "coloquios_da_orta_1563", "target_name": "agua salgada", "similarity": 0.89}, {"source_book": "coloquios_da_orta_1563", "source_name": "agua salgada", "target_book": "polyanthea_medicinal", "target_name": "agua salgada", "similarity": 0.868}], "id": 1805, "stable_key": "clu_8a6b374812dc5c19", "ground_truth": {"modern_name": "water", "confidence": "high", "type": "substance", "description": "A transparent liquid essential for life, used medicinally and as a medium.", "note": "Includes Portuguese ('agua'), French ('eau'), and generic terms ('fluid').", "wikipedia_extract": "Water is an inorganic compound with the chemical formula H2O. It is a transparent, tasteless, odorless, and nearly colorless chemical substance. It is the main constituent of Earth's streams, lakes, and oceans and the fluids of all known living organisms, in which it acts as a solvent. Water, being a polar molecule, undergoes strong intermolecular hydrogen bonding which is a large contributor to its physical and chemical properties. It is vital for all known forms of life, despite not providing food energy or being an organic micronutrient. Due to its presence in all organisms, its chemical stability, its worldwide abundance, and its strong polarity relative to its small molecular size, water is often referred to as the \"universal solvent\"."}}, {"canonical_name": "leprolos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "leprolos", "book_id": "historia_medicinal_monardes_1574", "name": "leprolos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["leprolos", "lepro\u017fos"], "contexts": ["people with red inflamed faces", "condition resembling leprosy"]}, {"entity_id": "leprosas", "book_id": "coloquios_da_orta_1563", "name": "leprosas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["leprosas"], "contexts": ["lepers"]}, {"entity_id": "leprofos", "book_id": "polyanthea_medicinal", "name": "leprofos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["leprofos"], "contexts": ["disease of leprosy", "leprosy-like conditions"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "leprolos", "target_book": "coloquios_da_orta_1563", "target_name": "leprosas", "similarity": 0.895}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "leprolos", "target_book": "polyanthea_medicinal", "target_name": "leprofos", "similarity": 0.93}], "id": 1806, "stable_key": "clu_15d8f9dfbddb30bc-2", "ground_truth": {"modern_name": "Leprosy", "confidence": "high", "type": "disease", "description": "A chronic infectious disease affecting skin and nerves.", "note": "Covers historical understanding and terminology for leprosy.", "wikipedia_extract": "Leprosy, also known as Hansen's disease (HD), is a long-term infection by the bacteria Mycobacterium leprae or Mycobacterium lepromatosis. Infection can lead to damage of the nerves, respiratory tract, skin, and eyes. This nerve damage may result in the loss of nociception, which can lead to the loss of parts of a person's extremities from repeated injuries or infection through unnoticed wounds. An infected person may also experience muscle weakness and loss of eyesight. Leprosy symptoms may begin within one year or take 20 years or more. Leprosy is spread between people, although extensive contact is necessary.", "modern_term": "Leprosy", "wikidata_id": "Q100400591", "wikidata_description": "scholarly article"}}, {"canonical_name": "cibo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "comida", "book_id": "historia_medicinal_monardes_1574", "name": "comida", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["comida"], "contexts": ["food"]}, {"entity_id": "cibo", "book_id": "coloquios_da_orta_1563", "name": "cibo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["cibo"], "contexts": ["food"]}, {"entity_id": "cibo", "book_id": "polyanthea_medicinal", "name": "cibo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["cibo", "cibi", "ciborum"], "contexts": ["food", "foodstuffs"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "comida", "target_book": "coloquios_da_orta_1563", "target_name": "cibo", "similarity": 0.972}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "comida", "target_book": "polyanthea_medicinal", "target_name": "cibo", "similarity": 0.972}, {"source_book": "coloquios_da_orta_1563", "source_name": "cibo", "target_book": "polyanthea_medicinal", "target_name": "cibo", "similarity": 1.0}], "id": 1807, "stable_key": "clu_2ca6e65437828715", "ground_truth": {"modern_name": "food", "confidence": "high", "type": "concept", "description": "Substances providing nourishment and sustenance.", "wikipedia_extract": "Food is any substance consumed by an organism for nutritional support. Food usually consists of plant, animal, or fungal origin and contains essential nutrients such as carbohydrates, fats, proteins, vitamins, or minerals. The substance is ingested by an organism and assimilated by the organism's cells to provide energy, maintain life, or support growth. Different species of animals have different feeding behaviours that satisfy the needs of their metabolisms and have evolved to fill specific ecological niches within specific geographical contexts. Omnivorous humans are highly adaptable and have adapted to obtaining food in many different ecosystems. Humans generally use cooking to prepare food for consumption."}}, {"canonical_name": "Malta", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "malta", "book_id": "coloquios_da_orta_1563", "name": "Malta", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Malta"], "contexts": ["island of origin for Rontecalli"]}, {"entity_id": "malta", "book_id": "ricettario_fiorentino_1597", "name": "Malta", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Malta"], "contexts": ["island with a white earth", "island and country, source of earth"]}, {"entity_id": "malta", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Malta", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Malta"], "contexts": ["location of astronomical observations", "location of Saturn's rings observations"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Malta", "target_book": "ricettario_fiorentino_1597", "target_name": "Malta", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Malta", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Malta", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Malta", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Malta", "similarity": 1.0}], "id": 1808, "stable_key": "clu_641bcf4ea4c0c38f", "ground_truth": {"modern_name": "Malta", "confidence": "high", "type": "place", "country": "Malta", "wikidata_id": "Q233", "wikidata_description": "country in Southern Europe situated on an archipelago in the Mediterranean Sea", "wikipedia_url": "https://en.wikipedia.org/wiki/Malta", "wikipedia_extract": "Malta, officially the Republic of Malta, is an island country in Southern Europe located in the Mediterranean Sea, between Sicily and North Africa. It consists of an archipelago 80 km (50 mi) south of Italy, 284 km (176 mi) east of Tunisia, and 333 km (207 mi) north of Libya. The two official languages are Maltese and English but Maltese is recognised as the national language. The country's capital is Valletta, which is the smallest capital city in the European Union (EU) by both area and population. With a population of about 574,250 spread over an area of 316 km2 (122 sq mi), Malta is the world's tenth-smallest country by area and the ninth-most densely populated. Various sources consider the country to consist of a single urban region, for which reason it is often described as a city-state."}}, {"canonical_name": "adaptation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "coadaptation", "book_id": "origin_of_species_darwin_1859", "name": "coadaptation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["coadaptation"], "contexts": ["mutual adaptation of species"]}, {"entity_id": "adaptation", "book_id": "first_principles_spencer_1862", "name": "adaptation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["adaptation"], "contexts": ["process of adjusting to new conditions", "process of adjusting to surrounding conditions"]}, {"entity_id": "adaptation", "book_id": "principles_of_psychology_james_1890", "name": "adaptation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["adaptation"], "contexts": ["adaptation of attention to the impression"]}, {"entity_id": "social_adaptation", "book_id": "first_principles_spencer_1862", "name": "social adaptation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["social adaptation"], "contexts": ["adjustment to societal norms"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "coadaptation", "target_book": "first_principles_spencer_1862", "target_name": "adaptation", "similarity": 0.889}, {"source_book": "principles_of_psychology_james_1890", "source_name": "adaptation", "target_book": "first_principles_spencer_1862", "target_name": "social adaptation", "similarity": 0.894}], "id": 1809, "stable_key": "clu_f8282502a3a8da2f", "ground_truth": {"modern_name": "Adaptation", "confidence": "high", "type": "concept", "wikidata_id": "Q483921", "wikidata_description": "evolutionary biological process that fits organisms to their environment, adaptive trait, or state reached by an evolving population", "wikipedia_url": "https://en.wikipedia.org/wiki/Adaptation", "wikipedia_extract": "In biology, adaptation has three related meanings. Firstly, it is the dynamic evolutionary process of natural selection that fits organisms to their environment, enhancing their evolutionary fitness. Secondly, it is a state reached by the population during that process. Thirdly, it is a phenotypic trait or adaptive trait, with a functional role in each individual organism, that is maintained and has evolved through natural selection. Historically, adaptation has been described from the time of the ancient Greek philosophers such as Empedocles and Aristotle. In 18th and 19th-century natural theology, adaptation was taken as evidence for the existence of a deity."}}, {"canonical_name": "savants", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "savants", "book_id": "medecine_experimentale_bernard_1865", "name": "savants", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["savants"], "contexts": ["learned individuals or scholars", "learned persons, especially in science"]}, {"entity_id": "savary", "book_id": "kosmos_humboldt_1845", "name": "Savary", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Savary"], "contexts": ["author in 'Connaissance des Tems'"]}, {"entity_id": "savary", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Savary", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants":