}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Snow", "target_book": "kosmos_humboldt_1845", "target_name": "snow", "similarity": 0.979}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Snow", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Snow", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Snow", "target_book": "first_principles_spencer_1862", "target_name": "snow", "similarity": 0.979}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "snow", "target_book": "kosmos_humboldt_1845", "target_name": "snow", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "snow", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Snow", "similarity": 0.979}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "snow", "target_book": "first_principles_spencer_1862", "target_name": "snow", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "snow", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Snow", "similarity": 0.979}, {"source_book": "kosmos_humboldt_1845", "source_name": "snow", "target_book": "first_principles_spencer_1862", "target_name": "snow", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Snow", "target_book": "first_principles_spencer_1862", "target_name": "snow", "similarity": 0.979}], "id": 164, "stable_key": "clu_3f78ca0f45f5efd2", "ground_truth": {"modern_name": "Snow", "confidence": "high", "type": "mineral", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Snow", "wikipedia_extract": "Snow consists of individual ice crystals that grow while suspended in the atmosphere\u2014usually within clouds\u2014and then fall, accumulating on the ground where they undergo further changes. It consists of frozen crystalline water throughout its life cycle, starting when, under suitable conditions, the ice crystals form in the atmosphere, increase to millimeter size, precipitate and accumulate on surfaces, then metamorphose in place, and ultimately melt, slide, or sublimate away. Snowstorms organize and develop by feeding on sources of atmospheric moisture and cold air. Snowflakes nucleate around particles in the atmosphere by attracting supercooled water droplets, which freeze in hexagonal-shaped crystals. Snowflakes take on a variety of shapes, basic among these are platelets, needles, columns, and rime. As snow accumulates into a snowpack, it may blow into drifts."}}, {"canonical_name": "crocodiles", "category": "ANIMAL", "subcategory": "REPTILE", "book_count": 5, "total_mentions": 26, "members": [{"entity_id": "crocodiles", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Crocodiles", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["Crocodiles"], "contexts": ["oviparous quadruped with analogous joints"]}, {"entity_id": "crocodile", "book_id": "origin_of_species_darwin_1859", "name": "crocodile", "category": "ANIMAL", "subcategory": "REPTILE", "count": 2, "variants": ["crocodile"], "contexts": ["existing reptile found with extinct forms", "reptile name"]}, {"entity_id": "crocodiles", "book_id": "relation_historique_humboldt_vol3_1825", "name": "crocodiles", "category": "ANIMAL", "subcategory": "REPTILE", "count": 20, "variants": ["crocodiles", "Crocodilus aciiius", "Crocodilus acutus", "Crocodilus aoutus", "cocodrilo", "crocodile", "crocodile du Nil"], "contexts": ["animal eaten by Caribes", "large and numerous reptiles in Rio Neveri"]}, {"entity_id": "crocodiles", "book_id": "kosmos_humboldt_1845", "name": "crocodiles", "category": "ANIMAL", "subcategory": "REPTILE", "count": 2, "variants": ["crocodiles"], "contexts": ["large semi-aquatic reptiles", "large aquatic reptiles"]}, {"entity_id": "crocodile", "book_id": "connexion_physical_sciences_somerville_1858", "name": "crocodile", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["crocodile"], "contexts": ["large aquatic reptile"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Crocodiles", "target_book": "origin_of_species_darwin_1859", "target_name": "crocodile", "similarity": 0.952}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Crocodiles", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "crocodiles", "similarity": 0.984}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Crocodiles", "target_book": "kosmos_humboldt_1845", "target_name": "crocodiles", "similarity": 0.984}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Crocodiles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "crocodile", "similarity": 0.952}, {"source_book": "origin_of_species_darwin_1859", "source_name": "crocodile", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "crocodiles", "similarity": 0.965}, {"source_book": "origin_of_species_darwin_1859", "source_name": "crocodile", "target_book": "kosmos_humboldt_1845", "target_name": "crocodiles", "similarity": 0.965}, {"source_book": "origin_of_species_darwin_1859", "source_name": "crocodile", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "crocodile", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "crocodiles", "target_book": "kosmos_humboldt_1845", "target_name": "crocodiles", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "crocodiles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "crocodile", "similarity": 0.965}, {"source_book": "kosmos_humboldt_1845", "source_name": "crocodiles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "crocodile", "similarity": 0.965}], "id": 165, "stable_key": "clu_1889f2e55505192a", "ground_truth": {"modern_name": "Crocodile", "confidence": "high", "type": "animal", "description": "Large semi-aquatic reptiles, sometimes referred to as Cayman in specific contexts.", "wikipedia_extract": "A crocodile (family Crocodylidae) or true crocodile is a large, semiaquatic reptile that lives throughout the tropics in Africa, Asia, the Americas and Australia. The term \"crocodile\" is sometimes used more loosely to include all extant members of the order Crocodilia, which includes the alligators and caimans (both members of the family Alligatoridae), the gharial and false gharial (both members of the family Gavialidae) as well as other extinct taxa. This article will use \"crocodile\" or \"true crocodile\" to refer only to the species taxonomically included in the Crocodylidae family, extant or extinct. Crocodile size, morphology, behaviour and ecology differ among species. However, they have many similarities in these areas as well. All crocodiles are semiaquatic and tend to congregate in freshwater habitats such as rivers, lakes, wetlands and sometimes in brackish water and saltwater."}}, {"canonical_name": "dog", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 5, "total_mentions": 26, "members": [{"entity_id": "dog", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Dog", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Dog"], "contexts": ["animal with a long lifespan in myth"]}, {"entity_id": "dog", "book_id": "origin_of_species_darwin_1859", "name": "dog", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 8, "variants": ["dog"], "contexts": ["domesticated animal", "domesticated mammal"]}, {"entity_id": "dog", "book_id": "principles_of_psychology_james_1890", "name": "dog", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 15, "variants": ["dog"], "contexts": ["mammal with complex nervous system", "animal with very 