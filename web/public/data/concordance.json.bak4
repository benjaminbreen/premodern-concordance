egory": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 37, "members": [{"entity_id": "galanga", "book_id": "coloquios_da_orta_1563", "name": "galanga", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 24, "variants": ["galanga", "GALANGA", "Galanga", "galago", "galamga"], "contexts": ["distinct drug from calamus", "plant discussed in colloquy"]}, {"entity_id": "galanga", "book_id": "ricettario_fiorentino_1597", "name": "Galanga", "category": "PLANT", "subcategory": "ROOT", "count": 11, "variants": ["GALANGA", "galanga", "Galanga"], "contexts": ["root for comparison of color", "a root with nodes, fragrant and sharp"]}, {"entity_id": "galanga", "book_id": "english_physician_1652", "name": "Galanga", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Galanga"], "contexts": ["aromatic root used in medicine"]}, {"entity_id": "a,_galanga", "book_id": "coloquios_da_orta_1563", "name": "A, Galanga", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["A, Galanga"], "contexts": ["plant description"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "galanga", "target_book": "ricettario_fiorentino_1597", "target_name": "Galanga", "similarity": 0.797}, {"source_book": "english_physician_1652", "source_name": "Galanga", "target_book": "coloquios_da_orta_1563", "target_name": "A, Galanga", "similarity": 0.922}], "id": 913, "stable_key": "clu_4809ba1f9114afd3", "ground_truth": {"modern_name": "Galangal", "confidence": "high", "type": "plant", "linnaean": "Alpinia galanga", "family": "Zingiberaceae", "description": "An aromatic root used medicinally and as a spice.", "note": "Distinct from galbanum.", "wikipedia_extract": "Alpinia galanga, a plant in the ginger family, bears a rhizome used largely as an herb in Unani medicine and as a spice in Southeast Asian cookery. It is one of four plants known as \"galangal\". Its common names include greater galangal, lengkuas, and blue ginger. The name \"galangal\" is probably derived from Persian qulanjan or Arabic khalanjan, which in turn may be an adaptation of Chinese gao liang jiang. Its names in North India are derived from the same root, including kulanja in Sanskrit, kulanjan in Hindi, and kholinjan in Urdu. The name \"lengkuas\", on the other hand, is derived from Malay lengkuas, which is derived from Proto-Western Malayo-Polynesian *la\u014bkuas, with cognates including Ilokano langku\u00e1s; Tagalog, Bikol, Kapampangan, Visayan, and Manobo langk\u00e1uas or langk\u00e1was; Aklanon eangkaw\u00e1s; Kadazan Dusun hongkuas; Ida'an lengkuas; Ngaju Dayak langkuas; and Iban engkuas."}}, {"canonical_name": "magnet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 37, "members": [{"entity_id": "magnet", "book_id": "kosmos_humboldt_1845", "name": "magnet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 5, "variants": ["magnet"], "contexts": ["a thermoscope and a magnet", "object with attractive force"]}, {"entity_id": "magnet", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 29, "variants": ["Magnet", "magnet"], "contexts": ["object influencing electric light", "used to divide electrical discharge"]}, {"entity_id": "magnet", "book_id": "principles_of_psychology_james_1890", "name": "magnet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["magnet"], "contexts": ["object with magnetic properties"]}, {"entity_id": "bar_magnet", "book_id": "connexion_physical_sciences_somerville_1858", "name": "bar magnet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["bar magnet"], "contexts": ["magnet in the shape of a bar"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "magnet", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnet", "similarity": 1.0}, {