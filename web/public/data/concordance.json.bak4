nd_truth": {"modern_name": "Johannes Peter M\u00fcller", "confidence": "high", "type": "person", "birth_year": 1801, "death_year": 1858, "description": "German physiologist and ichthyologist, significant figure in biology.", "note": "Given the context of scientific texts and the era, the prominent German physiologist Johannes Peter M\u00fcller is the most likely referent. The specific mention of editing an anatomical journal further supports this."}}, {"canonical_name": "Hercules", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "hercules", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hercules", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Hercules"], "contexts": ["hero who fought Cerberus", "mythological hero"]}, {"entity_id": "hercules", "book_id": "english_physician_1652", "name": "Hercules", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Hercules"], "contexts": ["figure to whom Poplar was dedicated"]}, {"entity_id": "hercules", "book_id": "kosmos_humboldt_1845", "name": "Hercules", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Hercules"], "contexts": ["mythological hero"]}, {"entity_id": "hercules", "book_id": "polyanthea_medicinal", "name": "Hercules", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Hercules"], "contexts": ["mythological hero"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hercules", "target_book": "english_physician_1652", "target_name": "Hercules", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hercules", "target_book": "kosmos_humboldt_1845", "target_name": "Hercules", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hercules", "target_book": "polyanthea_medicinal", "target_name": "Hercules", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Hercules", "target_book": "kosmos_humboldt_1845", "target_name": "Hercules", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Hercules", "target_book": "polyanthea_medicinal", "target_name": "Hercules", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Hercules", "target_book": "polyanthea_medicinal", "target_name": "Hercules", "similarity": 1.0}], "id": 765, "stable_key": "clu_df3fbe4af0f1af7c", "ground_truth": {"modern_name": "Hercules", "confidence": "high", "type": "person", "description": "Mythological hero known for his strength and labors", "wikidata_id": "Q948140", "wikidata_description": "city in western Contra Costa County, California, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Hercules%2C%20California", "wikipedia_extract": "Hercules is a city in western Contra Costa County, California. Situated along the coast of San Pablo Bay, it is located in the eastern region of the San Francisco Bay Area, about 10 miles (16 km) north of Berkeley. As of the 2020 census, its population was 26,016, according to the United States Census Bureau. The site of Hercules was first developed in 1881 as a manufacturing facility of the California Powder Works for the production of its patented dynamite formulation, Hercules powder. In 1882, the Hercules Powder Company was incorporated and assumed responsibility for the Hercules site. It was one of several explosive manufacturers that were active along the Pinole shoreline in the late 19th to the mid-20th century."}}, {"canonical_name": "Xenophanes", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "xenophanes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Xenophanes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Xenophanes"], "contexts": ["ancient philosopher who believed in another world in the Moon", "ancient Greek philosopher"]}, {"entity_id": "xenophanes", "book_id": "kosmos_humboldt_1845", "name": "Xenophanes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Xenophanes"], "contexts": ["called comets 'wandering light-clouds'"]}, {"entity_id": "xenopho", "book_id": "historia_medicinal_monardes_1574", "name": "Xenopho", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Xenopho"], "contexts": ["author of memorable things"]}, {"entity_id": "xenocrate", "book_id": "ricettario_fiorentino_1597", "name": "Xenocrate", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Xenocrate"], "contexts": ["ancient authority"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Xenophanes", "target_book": "kosmos_humboldt_1845", "target_name": "Xenophanes", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Xenophanes", "target_book": "historia_medicinal_monardes_1574", "target_name": "Xenopho", "similarity": 0.863}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Xenophanes", "target_book": "ricettario_fiorentino_1597", "target_name": "Xenocrate", "similarity": 0.872}, {"source_book": "kosmos_humboldt_1845", "source_name": "Xenophanes", "target_book": "historia_medicinal_monardes_1574", "target_name": "Xenopho", "similarity": 0.863}, {"source_book": "kosmos_humboldt_1845", "source_name": "Xenophanes", "target_book": "ricettario_fiorentino_1597", "target_name": "Xenocrate", "similarity": 0.872}], "id": 766, "stable_key": "clu_e6858fa0d5225cf8", "ground_truth": {"modern_name": "Xenophanes", "confidence": "high", "type": "person", "birth_year": -570, "death_year": -478, "description": "Ancient Greek philosopher and poet, pre-Socratic thinker", "note": "Includes 'Xenopho' and 'Xenocrate' which are likely variations or misspellings of Xenophanes.", "wikidata_id": "Q8043648", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Xenophanes%20%28butterfly%29", "wikipedia_extract": "Xenophanes is a genus of skippers in the family Hesperiidae."}}, {"canonical_name": "East Indies", "category": "PLACE", "subcategory": "REGION", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "east_indies", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "East Indies", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["East Indies"], "contexts": ["general origin of spices", "region of origin for plants"]}, {"entity_id": "west_indies", "book_id": "origin_of_species_darwin_1859", "name": "West Indies", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["West Indies"], "contexts": ["source of seeds for western shores"]}, {"entity_id": "west_indies", "book_id": "kosmos_humboldt_1845", "name": "West Indies", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["West Indies"], "contexts": ["location of compass permanency"]}, {"entity_id": "west_indies", "book_id": "connexion_physical_sciences_somerville_1858", "name": "West Indies", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["West Indies"], "contexts": ["frequent location of hurricanes"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "East Indies", "target_book": "kosmos_humboldt_1845", "target_name": "West Indies", "similarity": 0.953}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "East Indies", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "West Indies", "similarity": 0.953}, {"source_book": "origin_of_species_darwin_1859", "source_name": "West Indies", "target_book": "kosmos_humboldt_1845", "target_name": "West Indies", "similarity": 0.86}, {"source_book": "origin_of_species_darwin_1859", "source_name": "West Indies", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "West Indies", "similarity": 0.86}, {"source_book": "kosmos_humboldt_1845", "source_name": "West Indies", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "West Indies", "similarity": 1.0}], "id": 767, "stable_key": "clu_db5d78141d63ad6e", "ground_truth": {"modern_name": "East Indies", "confidence": "high", "type": "place", "country": "Indonesia, India, Southeast Asia", "note": "Includes 'West Indies' which is a different geographical region, but likely a contextual error in the source text rather than a separate referent for this cluster.", "wikidata_id": "Q213137", "wikidata_description": "region encompassing South (Em(Indian subcontinent) and Southeast Asia", "wikipedia_url": "https://en.wikipedia.org/wiki/East%20Indies", "wikipedia_extract": "The East Indies (or simply the Indies) is a term used in historical narratives of the Age of Discovery. The Indies broadly referred to various lands in the East or the Eastern Hemisphere, particularly the islands and mainlands found in and around the Indian Ocean by Portuguese explorers, soon after the Cape Route was discovered. In a narrow sense, the term was used to refer to the Malay Archipelago, which today comprises the Philippine Archipelago, Indonesian Archipelago, Borneo, and New Guinea. Historically, the term was used in the Age of Discovery to refer to the coasts of the landmasses comprising the Indian subcontinent and the Indochinese Peninsula along with the Malay Archipelago. During the era of European colonization, territories of the Spanish Empire in Asia were known as the Spanish East Indies for 333 years before the American conquest and later the independence of the Philippines. Dutch occupied colonies in the area were known for about 300 years as the Dutch East Indies until Indonesian independence."}}, {"canonical_name": "faith", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "faith", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Faith", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Faith"], "contexts": ["belief without proof"]}, {"entity_id": "faith", "book_id": "english_physician_1652", "name": "Faith", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Faith"], "contexts": ["spiritual actings"]}, {"entity_id": "faith", "book_id": "kosmos_humboldt_1845", "name": "faith", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["faith"], "contexts": ["belief without proof"]}, {"entity_id": "faith", "book_id": "first_principles_spencer_1862", "name": "faith", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["faith"], "contexts": ["belief without proof"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Faith", "target_book": "english_physician_1652", "target_name": "Faith", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Faith", "target_book": "kosmos_humboldt_1845", "target_name": "faith", "similarity": 0.962}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Faith", "target_book": "first_principles_spencer_1862", "target_name": "faith", "similarity": 0.962}, {"source_book": "english_physician_1652", "source_name": "Faith", "target_book": "kosmos_humboldt_1845", "target_name": "faith", "similarity": 0.962}, {"source_book": "english_physician_1652", "source_name": "Faith", "target_book": "first_principles_spencer_1862", "target_name": "faith", "similarity": 0.962}, {"source_book": "kosmos_humboldt_1845", "source_name": "faith", "target_book": "first_principles_spencer_1862", "target_name": "faith", "similarity": 1.0}], "id": 768, "stable_key": "clu_965f49877ca87f90", "ground_truth": {"modern_name": "Faith", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "swallow", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "swallows", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Swallows", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Swallows"], "contexts": ["birds whose presence in houses has symbolic meaning"]}, {"entity_id": "swallow", "book_id": "english_physician_1652", "name": "Swallow", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Swallow"], "contexts": ["animal associated with the herb's name"]}, {"entity_id": "swallow", "book_id": "origin_of_species_darwin_1859", "name": "swallow", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["swallow"], "contexts": ["bird species"]}, {"entity_id": "swallow", "book_id": "principles_of_psychology_james_1890", "name": "swallow", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["swallow"], "contexts": ["process of moving food down the throat", "bird species"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Swallows", "target_book": "origin_of_species_darwin_1859", "target_name": "swallow", "similarity": 0.939}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Swallows", "target_book": "principles_of_psychology_james_1890", "target_name": "swallow", "similarity": 0.939}, {"source_book": "english_physician_1652", "source_name": "Swallow", "target_book": "origin_of_species_darwin_1859", "target_name": "swallow", "similarity": 0.861}, {"source_book": "english_physician_1652", "source_name": "Swallow", "target_book": "principles_of_psychology_james_1890", "target_name": "swallow", "similarity": 0.861}, {"source_book": "origin_of_species_darwin_1859", "source_name": "swallow", "target_book": "principles_of_psychology_james_1890", "target_name": "swallow", "similarity": 1.0}], "id": 769, "stable_key": "clu_a78aa1285b9c8daa", "ground_truth": {"wikipedia_extract": "The swallows, martins, and saw-wings, or Hirundinidae, are a family of passerine songbirds found around the world on all continents, including occasionally in Antarctica. Highly adapted to aerial feeding, they have a distinctive appearance. The term \"swallow\" is used as the common name for Hirundo rustica in the United Kingdom and Ireland. Around 90 species of Hirundinidae are known, divided into 21 genera, with the greatest diversity found in Africa, which is also thought to be where they evolved as hole-nesters. They also occur on a number of oceanic islands. A number of European and North American species are long-distance migrants; by contrast, the West and South African swallows are nonmigratory."}}, {"canonical_name": "Hebreus", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "hebrews", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hebrews", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Hebrews"], "contexts": ["people from whom \u00c6gyptians may have learned"]}, {"entity_id": "h\u00e9breux", "book_id": "epoques_nature_buffon_1778", "name": "H\u00e9breux", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["H\u00e9breux"], "contexts": ["ancient people of Israel"]}, {"entity_id": "h\u00e9breux", "book_id": "relation_historique_humboldt_vol3_1825", "name": "H\u00e9breux", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["H\u00e9breux"], "contexts": ["ancient people"]}, {"entity_id": "hebreus", "book_id": "coloquios_da_orta_1563", "name": "Hebreus", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Hebreus", "Hebreos"], "contexts": ["people mentioned in sacred books", "Hebrew people"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hebrews", "target_book": "epoques_nature_buffon_1778", "target_name": "H\u00e9breux", "similarity": 0.953}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hebrews", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "H\u00e9breux", "similarity": 0.953}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hebrews", "target_book": "coloquios_da_orta_1563", "target_name": "Hebreus", "similarity": 0.926}, {"source_book": "epoques_nature_buffon_1778", "source_name": "H\u00e9breux", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "H\u00e9breux", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "H\u00e9breux", "target_book": "coloquios_da_orta_1563", "target_name": "Hebreus", "similarity": 0.94}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "H\u00e9breux", "target_book": "coloquios_da_orta_1563", "target_name": "Hebreus", "similarity": 0.94}], "id": 770, "stable_key": "clu_d3d71083d7ae083b", "ground_truth": {"modern_name": "Hebrews", "confidence": "high", "type": "person", "description": "Ancient Semitic people, historically associated with Judaism and early scholarship.", "wikidata_id": "Q570868", "wikidata_description": "ancient nation of the Middle East", "wikipedia_url": "https://en.wikipedia.org/wiki/Hebrews", "wikipedia_extract": "The Hebrews (Hebrew: \u05e2\u05b4\u05d1\u05b0\u05e8\u05b4\u05d9\u05b4\u05bc\u05d9\u05dd / \u05e2\u05b4\u05d1\u05b0\u05e8\u05b4\u05d9\u05dd, Modern: \u02bf\u012avr\u012bm / \u02bf\u012avr\u012byy\u012bm, Tiberian: \u02bf\u012a\u1e07r\u012bm / \u02bf\u012a\u1e07r\u012byy\u012bm; ISO 259-3: \u0295ibrim / \u0295ibriyim) were an ancient Semitic-speaking people. Historians mostly consider the Hebrews as synonymous with the Israelites, with the term \"Hebrew\" denoting an Israelite from the nomadic era, which preceded the establishment of the Kingdom of Israel and Judah in the 11th century BCE. However, in some instances, the designation \"Hebrew\" may also be used historically in a wider sense, referring to the Phoenicians or other ancient Semitic-speaking civilizations, such as the Shasu on the eve of the Late Bronze Age collapse. It appears 34 times within 32 verses of the Hebrew Bible. Some scholars regard \"Hebrews\" as an ethnonym, while others do not, and others still hold that the multiple modern connotations of ethnicity may not all map well onto the sociology of ancient Near Eastern groups. By the time of the Roman Empire, the term Hebraios (Greek: \u1f19\u03b2\u03c1\u03b1\u1fd6\u03bf\u03c2) could refer to any member of the Jewish people in general (as Strong's Hebrew Dictionary puts it: \"any of the Jewish nation\") or, at other times, specifically to those Jews who lived in Judea, which was a Roman province from 6 CE to 135 CE."}}, {"canonical_name": "cong\u00e9lation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "congelation", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "congelation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["congelation"], "contexts": ["process of freezing"]}, {"entity_id": "cong\u00e9lation", "book_id": "epoques_nature_buffon_1778", "name": "cong\u00e9lation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["cong\u00e9lation"], "contexts": ["process of becoming solid", "point at which liquid freezes"]}, {"entity_id": "cong\u00e9lation", "book_id": "relation_historique_humboldt_vol3_1825", "name": "cong\u00e9lation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cong\u00e9lation"], "contexts": ["process of freezing"]}, {"entity_id": "congelation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "congelation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["congelation"], "contexts": ["process of freezing into ice"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "congelation", "target_book": "epoques_nature_buffon_1778", "target_name": "cong\u00e9lation", "similarity": 0.931}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "congelation", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "cong\u00e9lation", "similarity": 0.931}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "congelation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "congelation", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "cong\u00e9lation", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "cong\u00e9lation", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "cong\u00e9lation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "congelation", "similarity": 0.931}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "cong\u00e9lation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "congelation", "similarity": 0.931}], "id": 771, "stable_key": "clu_2338c1fe4efe3f45", "ground_truth": {"modern_name": "Freezing", "confidence": "high", "type": "concept", "wikidata_id": "Q1036696", "wikidata_description": "condition caused when the human body gets too cold", "wikipedia_url": "https://en.wikipedia.org/wiki/Hypothermia", "wikipedia_extract": "Hypothermia is defined as a body core temperature below 35.0 \u00b0C (95.0 \u00b0F) in humans. Symptoms depend on the temperature. In mild hypothermia, there is shivering and mental confusion. In moderate hypothermia, shivering stops and confusion increases. In severe hypothermia, there may be hallucinations and paradoxical undressing, or the victim's removal of their clothing, as well as an increased risk of the heart's stopping. Hypothermia has two main types of causes."}}, {"canonical_name": "fomenta\u00e7ao", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "fomentations", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "fomentations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fomentations"], "contexts": ["relieve the head"]}, {"entity_id": "fomentaciones", "book_id": "historia_medicinal_monardes_1574", "name": "fomentaciones", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fomentaciones"], "contexts": ["therapeutic application of heat or liquid"]}, {"entity_id": "fomenta\u00e7\u00f5es", "book_id": "coloquios_da_orta_1563", "name": "fomenta\u00e7\u00f5es", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["fomenta\u00e7\u00f5es"], "contexts": ["used to treat berib\u00e9ri"]}, {"entity_id": "fomenta\u00e7ao", "book_id": "polyanthea_medicinal", "name": "fomenta\u00e7ao", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["fomenta\u00e7ao"], "contexts": ["application of warm liquids", "application of oil to the nape"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fomentations", "target_book": "historia_medicinal_monardes_1574", "target_name": "fomentaciones", "similarity": 0.991}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fomentations", "target_book": "coloquios_da_orta_1563", "target_name": "fomenta\u00e7\u00f5es", "similarity": 0.99}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fomentations", "target_book": "polyanthea_medicinal", "target_name": "fomenta\u00e7ao", "similarity": 0.941}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "fomentaciones", "target_book": "coloquios_da_orta_1563", "target_name": "fomenta\u00e7\u00f5es", "similarity": 0.998}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "fomentaciones", "target_book": "polyanthea_medicinal", "target_name": "fomenta\u00e7ao", "similarity": 0.943}, {"source_book": "coloquios_da_orta_1563", "source_name": "fomenta\u00e7\u00f5es", "target_book": "polyanthea_medicinal", "target_name": "fomenta\u00e7ao", "similarity": 0.946}], "id": 772, "stable_key": "clu_6d5956ece141792a", "ground_truth": {"modern_name": "Fomentation", "confidence": "high", "type": "concept", "note": "This refers to the therapeutic application of moist heat or warm liquids to the body.", "wikidata_id": "Q58775427", "wikidata_description": "", "wikipedia_extract": "Ayurveda is a pseudoscientific alternative medicine system with historical roots in the Indian subcontinent. It is heavily practised throughout India and Nepal, where as much as 80% of the population report using ayurveda. Toxic metals including lead and mercury are used as ingredients in many ayurvedic medicines. Ayurveda therapies have varied and evolved over more than two millennia. Therapies include herbal medicines, special diets, meditation, yoga, massage, laxatives, enemas, and medical oils. Early Ayurvedic preparations were entirely based on complex herbal compounds based on the materia medica of South Asia.", "wikipedia_url": "https://en.wikipedia.org/wiki/Ayurveda"}}, {"canonical_name": "squelettes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "squelettes", "book_id": "epoques_nature_buffon_1778", "name": "squelettes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["squelettes"], "contexts": ["skeletons of marine animals", "framework of bones of animals"]}, {"entity_id": "squelettes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "squelettes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["squelettes"], "contexts": ["bones found in tumuli"]}, {"entity_id": "human_remains", "book_id": "kosmos_humboldt_1845", "name": "human remains", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["human remains"], "contexts": ["parts of the human body"]}, {"entity_id": "cadaver", "book_id": "polyanthea_medicinal", "name": "cadaver", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["cadaver"], "contexts": ["dead body"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "squelettes", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "squelettes", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "squelettes", "target_book": "kosmos_humboldt_1845", "target_name": "human remains", "similarity": 0.924}, {"source_book": "epoques_nature_buffon_1778", "source_name": "squelettes", "target_book": "polyanthea_medicinal", "target_name": "cadaver", "similarity": 0.907}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "squelettes", "target_book": "kosmos_humboldt_1845", "target_name": "human remains", "similarity": 0.924}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "squelettes", "target_book": "polyanthea_medicinal", "target_name": "cadaver", "similarity": 0.907}], "id": 773, "stable_key": "clu_2249273d745058d4", "ground_truth": {"modern_name": "skeletal remains", "confidence": "high", "type": "concept", "wikidata_id": "Q11668609", "wikidata_description": "skeletal remains of a dead human or animal"}}, {"canonical_name": "day", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "jour", "book_id": "epoques_nature_buffon_1778", "name": "jour", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["jour"], "contexts": ["unit of time"]}, {"entity_id": "day", "book_id": "principles_of_psychology_james_1890", "name": "day", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["day"], "contexts": ["daytime period"]}, {"entity_id": "day", "book_id": "connexion_physical_sciences_somerville_1858", "name": "day", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["day"], "contexts": ["period of light determined by rotation", "period of light from the sun"]}, {"entity_id": "day", "book_id": "first_principles_spencer_1862", "name": "day", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["day"], "contexts": ["concept name in Pawnee language"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "jour", "target_book": "principles_of_psychology_james_1890", "target_name": "day", "similarity": 0.926}, {"source_book": "epoques_nature_buffon_1778", "source_name": "jour", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "day", "similarity": 0.926}, {"source_book": "epoques_nature_buffon_1778", "source_name": "jour", "target_book": "first_principles_spencer_1862", "target_name": "day", "similarity": 0.926}, {"source_book": "principles_of_psychology_james_1890", "source_name": "day", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "day", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "day", "target_book": "first_principles_spencer_1862", "target_name": "day", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "day", "target_book": "first_principles_spencer_1862", "target_name": "day", "similarity": 1.0}], "id": 774, "stable_key": "clu_e2871960ae5ff1f4", "ground_truth": {"modern_name": "day", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Day", "wikipedia_extract": "A day is the time period of a full rotation of the Earth with respect to the Sun. On average, this is 24 hours (86,400 seconds). As a day passes at a given location it experiences morning, afternoon, evening, and night. This daily cycle drives circadian rhythms in many organisms, which are vital to many life processes. A collection of sequential days is organized into calendars as dates, almost always into weeks, months and years. A solar calendar organizes dates based on the Sun's annual cycle, giving consistent start dates for the four seasons from year to year."}}, {"canonical_name": "r\u00e9gions de l\u2019\u00e9quateur", "category": "PLACE", "subcategory": "REGION", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "r\u00e9gions_de_l\u2019\u00e9quateur", "book_id": "epoques_nature_buffon_1778", "name": "r\u00e9gions de l\u2019\u00e9quateur", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["r\u00e9gions de l\u2019\u00e9quateur"], "contexts": ["area around the Earth's equator"]}, {"entity_id": "\u00e9quatoriales", "book_id": "epoques_nature_buffon_1778", "name": "\u00e9quatoriales", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["\u00e9quatoriales"], "contexts": ["equatorial regions of the globe"]}, {"entity_id": "equatorial_america", "book_id": "origin_of_species_darwin_1859", "name": "equatorial America", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["equatorial America"], "contexts": ["tropical region of America"]}, {"entity_id": "equatorial_regions", "book_id": "kosmos_humboldt_1845", "name": "equatorial regions", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["equatorial regions"], "contexts": ["geographic region around equator"]}, {"entity_id": "equatorial_regions", "book_id": "first_principles_spencer_1862", "name": "equatorial regions", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["equatorial regions"], "contexts": ["area around the Earth's equator"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "r\u00e9gions de l\u2019\u00e9quateur", "target_book": "kosmos_humboldt_1845", "target_name": "equatorial regions", "similarity": 0.896}, {"source_book": "epoques_nature_buffon_1778", "source_name": "r\u00e9gions de l\u2019\u00e9quateur", "target_book": "first_principles_spencer_1862", "target_name": "equatorial regions", "similarity": 0.896}, {"source_book": "epoques_nature_buffon_1778", "source_name": "\u00e9quatoriales", "target_book": "origin_of_species_darwin_1859", "target_name": "equatorial America", "similarity": 0.929}, {"source_book": "epoques_nature_buffon_1778", "source_name": "\u00e9quatoriales", "target_book": "kosmos_humboldt_1845", "target_name": "equatorial regions", "similarity": 0.965}, {"source_book": "epoques_nature_buffon_1778", "source_name": "\u00e9quatoriales", "target_book": "first_principles_spencer_1862", "target_name": "equatorial regions", "similarity": 0.965}, {"source_book": "origin_of_species_darwin_1859", "source_name": "equatorial America", "target_book": "kosmos_humboldt_1845", "target_name": "equatorial regions", "similarity": 0.901}, {"source_book": "origin_of_species_darwin_1859", "source_name": "equatorial America", "target_book": "first_principles_spencer_1862", "target_name": "equatorial regions", "similarity": 0.901}, {"source_book": "kosmos_humboldt_1845", "source_name": "equatorial regions", "target_book": "first_principles_spencer_1862", "target_name": "equatorial regions", "similarity": 1.0}], "id": 775, "stable_key": "clu_0a84e4b03a30ba83", "ground_truth": {"modern_name": "Equatorial America", "confidence": "high", "type": "place", "country": "South America"}}, {"canonical_name": "verde", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "green", "book_id": "english_physician_1652", "name": "green", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["green"], "contexts": ["state of borrage herb used"]}, {"entity_id": "verdes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "verdes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["verdes"], "contexts": ["description of islets"]}, {"entity_id": "verde", "book_id": "coloquios_da_orta_1563", "name": "verde", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["verde"], "contexts": ["color of drying anil", "color of emeralds and jaspe"]}, {"entity_id": "verde", "book_id": "ricettario_fiorentino_1597", "name": "verde", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["verde"], "contexts": ["quality of oil"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "green", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "verdes", "similarity": 0.883}, {"source_book": "english_physician_1652", "source_name": "green", "target_book": "coloquios_da_orta_1563", "target_name": "verde", "similarity": 0.94}, {"source_book": "english_physician_1652", "source_name": "green", "target_book": "ricettario_fiorentino_1597", "target_name": "verde", "similarity": 0.94}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "verdes", "target_book": "coloquios_da_orta_1563", "target_name": "verde", "similarity": 0.914}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "verdes", "target_book": "ricettario_fiorentino_1597", "target_name": "verde", "similarity": 0.914}, {"source_book": "coloquios_da_orta_1563", "source_name": "verde", "target_book": "ricettario_fiorentino_1597", "target_name": "verde", "similarity": 1.0}], "id": 776, "stable_key": "clu_80ebd833a4438f94", "ground_truth": {"modern_name": "green", "confidence": "high", "type": "concept", "description": "The color of plants, emeralds, and certain other substances.", "wikipedia_extract": "Green is the color between cyan and yellow on the visible spectrum. It is evoked by light which has a dominant wavelength of roughly 495\u2013570 nm. In subtractive color systems, used in painting and color printing, it is created by a combination of yellow and cyan; in the RGB color model, used on television and computer screens, it is one of the additive primary colors, along with red and blue, which are mixed in different combinations to create all other colors. By far the largest contributor to green in nature is chlorophyll, the chemical by which plants photosynthesize and convert sunlight into chemical energy. Many creatures have adapted to their green environments by taking on a green hue themselves as camouflage. Several minerals have a green color, including the emerald, which is colored green by its chromium content."}}, {"canonical_name": "direction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "direction", "book_id": "english_physician_1652", "name": "Direction", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["Direction"], "contexts": ["astrological prediction"]}, {"entity_id": "direction", "book_id": "principles_of_psychology_james_1890", "name": "direction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["direction"], "contexts": ["orientation of difference"]}, {"entity_id": "direction", "book_id": "kosmos_humboldt_1845", "name": "direction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["direction"], "contexts": ["orientation in space"]}, {"entity_id": "direction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "direction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["direction"], "contexts": ["path of motion", "opposite movement in hemispheres"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Direction", "target_book": "principles_of_psychology_james_1890", "target_name": "direction", "similarity": 0.983}, {"source_book": "english_physician_1652", "source_name": "Direction", "target_book": "kosmos_humboldt_1845", "target_name": "direction", "similarity": 0.983}, {"source_book": "english_physician_1652", "source_name": "Direction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "direction", "similarity": 0.983}, {"source_book": "principles_of_psychology_james_1890", "source_name": "direction", "target_book": "kosmos_humboldt_1845", "target_name": "direction", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "direction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "direction", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "direction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "direction", "similarity": 1.0}], "id": 777, "stable_key": "clu_ccfc5f09723375e4", "ground_truth": {"modern_name": "Direction", "confidence": "high", "type": "concept", "wikidata_id": "Q86913619", "wikidata_description": "instruction from a superior or a higher authority that must be obeyed"}}, {"canonical_name": "organization", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "organization", "book_id": "origin_of_species_darwin_1859", "name": "organization", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organization"], "contexts": ["structure and arrangement of parts"]}, {"entity_id": "organization", "book_id": "principles_of_psychology_james_1890", "name": "organization", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organization"], "contexts": ["structure or arrangement"]}, {"entity_id": "organization", "book_id": "kosmos_humboldt_1845", "name": "organization", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organization"], "contexts": ["structure of living things"]}, {"entity_id": "organization", "book_id": "first_principles_spencer_1862", "name": "organization", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["organization"], "contexts": ["arrangement of parts into a whole", "process of expending force by plants"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "organization", "target_book": "principles_of_psychology_james_1890", "target_name": "organization", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "organization", "target_book": "kosmos_humboldt_1845", "target_name": "organization", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "organization", "target_book": "first_principles_spencer_1862", "target_name": "organization", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "organization", "target_book": "kosmos_humboldt_1845", "target_name": "organization", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "organization", "target_book": "first_principles_spencer_1862", "target_name": "organization", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "organization", "target_book": "first_principles_spencer_1862", "target_name": "organization", "similarity": 1.0}], "id": 778, "stable_key": "clu_f890880f80a4fcfb", "ground_truth": {"modern_name": "Organization", "confidence": "high", "type": "concept", "wikidata_id": "Q2029841", "wikidata_description": "concept in economics: activity in which something is accomplished"}}, {"canonical_name": "palma", "category": "PLANT", "subcategory": "TREE", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "palma", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "palma", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["palma", "PALMA"], "contexts": ["palm tree", "plant whose leaves are similar to zozoyatic"]}, {"entity_id": "palma", "book_id": "historia_medicinal_monardes_1574", "name": "Palma", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Palma"], "contexts": ["tree used for shape comparison"]}, {"entity_id": "palma", "book_id": "coloquios_da_orta_1563", "name": "Palma", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Palma"], "contexts": ["family of palm trees"]}, {"entity_id": "palma", "book_id": "ricettario_fiorentino_1597", "name": "Palma", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Palma"], "contexts": ["palm tree, used in preparations"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "palma", "target_book": "historia_medicinal_monardes_1574", "target_name": "Palma", "similarity": 0.838}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "palma", "target_book": "ricettario_fiorentino_1597", "target_name": "Palma", "similarity": 0.838}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Palma", "target_book": "coloquios_da_orta_1563", "target_name": "Palma", "similarity": 0.844}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Palma", "target_book": "ricettario_fiorentino_1597", "target_name": "Palma", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Palma", "target_book": "ricettario_fiorentino_1597", "target_name": "Palma", "similarity": 0.844}], "id": 779, "stable_key": "clu_a0b8e7c12cda39ae", "ground_truth": {"modern_name": "Palm tree", "confidence": "high", "type": "plant", "family": "Arecaceae", "note": "Palma is the direct Spanish and Italian word for palm. Given the contexts, it refers to the plant family or specific trees within it.", "wikidata_id": "Q14080", "wikidata_description": "family of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Arecaceae", "wikipedia_extract": "The Arecaceae () are a family of perennial, flowering plants in the monocot order Arecales. Their growth form can be climbers, shrubs, tree-like and stemless plants, all commonly known as palms. Those having a tree-like form are colloquially called palm trees. Currently, 181 genera with around 2,600 species are known, most of which are restricted to tropical and subtropical climates. Most palms are distinguished by their large, compound, evergreen leaves, known as fronds, arranged at the top of an unbranched stem, except for the Hyphaene genus, which has branched palms. However, palms exhibit an enormous diversity in physical characteristics and inhabit nearly every type of habitat within their range, from rainforests to deserts."}}, {"canonical_name": "Bruxelles", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "bruxelles", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bruxelles", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Bruxelles"], "contexts": ["abandoned city", "city near the Gulf of Nicoya"]}, {"entity_id": "brussels", "book_id": "principles_of_psychology_james_1890", "name": "Brussels", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Brussels"], "contexts": ["location of research publication"]}, {"entity_id": "bruxelles", "book_id": "kosmos_humboldt_1845", "name": "Bruxelles", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bruxelles"], "contexts": ["location of Duprez's publication"]}, {"entity_id": "brussels", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Brussels", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Brussels"], "contexts": ["location of Plateau's experiments"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bruxelles", "target_book": "principles_of_psychology_james_1890", "target_name": "Brussels", "similarity": 0.95}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bruxelles", "target_book": "kosmos_humboldt_1845", "target_name": "Bruxelles", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bruxelles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Brussels", "similarity": 0.95}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Brussels", "target_book": "kosmos_humboldt_1845", "target_name": "Bruxelles", "similarity": 0.95}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Brussels", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Brussels", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bruxelles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Brussels", "similarity": 0.95}], "id": 780, "stable_key": "clu_c55abfd8c9e7cb27", "ground_truth": {"wikipedia_extract": "Brussels, officially the Brussels-Capital Region, is a region of Belgium comprising 19 municipalities, including the City of Brussels, which is the capital of Belgium. The Brussels-Capital Region is located in the central portion of the country. It is a part of both the French Community of Belgium and the Flemish Community, and is separate from the Flemish Region (Flanders), within which it forms an enclave, and the Walloon Region (Wallonia), located less than 4 kilometres (2.5 mi) to the south. Brussels grew from a small rural settlement on the river Senne to become an important city-region in Europe. Since the end of the Second World War, it has been a major centre for international politics and home to numerous international organisations, politicians, diplomats and civil servants. Brussels is the de facto capital of the European Union, as it hosts a number of principal EU institutions, including its administrative-legislative, executive-political, and legislative branches (though the judicial branch is located in Luxembourg, and the European Parliament meets for a minority of the year in Strasbourg)."}}, {"canonical_name": "industrie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "industrie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "industrie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["industrie"], "contexts": ["economic activity"]}, {"entity_id": "industry", "book_id": "kosmos_humboldt_1845", "name": "industry", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["industry"], "contexts": ["economic activity and production"]}, {"entity_id": "ind\u00fastria", "book_id": "polyanthea_medicinal", "name": "ind\u00fastria", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["ind\u00fastria"], "contexts": ["physician's method of treatment"]}, {"entity_id": "industries", "book_id": "first_principles_spencer_1862", "name": "industries", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["industries"], "contexts": ["organizations providing substances and apparatus"]}, {"entity_id": "industry", "book_id": "first_principles_spencer_1862", "name": "industry", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["industry"], "contexts": ["diligent work"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "industrie", "target_book": "kosmos_humboldt_1845", "target_name": "industry", "similarity": 0.957}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "industrie", "target_book": "polyanthea_medicinal", "target_name": "ind\u00fastria", "similarity": 0.963}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "industrie", "target_book": "first_principles_spencer_1862", "target_name": "industries", "similarity": 0.914}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "industrie", "target_book": "first_principles_spencer_1862", "target_name": "industry", "similarity": 0.957}, {"source_book": "kosmos_humboldt_1845", "source_name": "industry", "target_book": "polyanthea_medicinal", "target_name": "ind\u00fastria", "similarity": 0.95}, {"source_book": "kosmos_humboldt_1845", "source_name": "indu