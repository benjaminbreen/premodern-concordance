HER_SUBSTANCE", "count": 1, "variants": ["chlorure de sodium"], "contexts": ["common salt"]}, {"entity_id": "chlorure_de_sodium", "book_id": "relation_historique_humboldt_vol3_1825", "name": "chlorure de sodium", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["chlorure de sodium"], "contexts": ["common salt"]}, {"entity_id": "chlorid_of_sodium", "book_id": "kosmos_humboldt_1845", "name": "chlorid of sodium", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["chlorid of sodium"], "contexts": ["salt filling cavities in lava", "chemical name for salt"]}, {"entity_id": "chlorate_of_soda", "book_id": "connexion_physical_sciences_somerville_1858", "name": "chlorate of soda", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["chlorate of soda"], "contexts": ["substance dissolved in water"]}, {"entity_id": "chloride_of_sulphur", "book_id": "connexion_physical_sciences_somerville_1858", "name": "chloride of sulphur", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["chloride of sulphur"], "contexts": ["chemical with high refractive power"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "chlorure de sodium", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "chlorure de sodium", "similarity": 0.88}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "chlorure de sodium", "target_book": "kosmos_humboldt_1845", "target_name": "chlorid of sodium", "similarity": 0.98}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "chlorure de sodium", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chlorate of soda", "similarity": 0.914}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "chlorure de sodium", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chloride of sulphur", "similarity": 0.912}, {"source_book": "kosmos_humboldt_1845", "source_name": "chlorid of sodium", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chlorate of soda", "similarity": 0.934}, {"source_book": "kosmos_humboldt_1845", "source_name": "chlorid of sodium", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chloride of sulphur", "similarity": 0.919}], "id": 731, "stable_key": "clu_0b950bd0e8ac7725", "ground_truth": {"modern_name": "Sulfurous acid", "confidence": "high", "type": "chemical", "note": "While 'sulfuric acid' is also mentioned, the context of 'gaseous compound' and 'exhalations' points more strongly to sulfurous acid (H2SO3) as it is a weaker acid and can exist in gaseous form, whereas sulfuric acid (H2SO4) is a stronger acid typically encountered in liquid form or as a mist when concentrated.", "wikidata_id": "Q5282", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Sulfur%20dioxide", "wikipedia_extract": "Sulfur dioxide (IUPAC-recommended spelling) or sulphur dioxide (traditional Commonwealth English) is the chemical compound with the formula SO2. It is a colorless gas with a pungent smell that is responsible for the odor of burnt matches. It is released naturally by volcanic activity and is produced as a by-product of metals refining and the burning of sulfur-bearing hydrocarbon fuels. Sulfur dioxide is somewhat toxic to humans, although only when inhaled in relatively large quantities for a period of several minutes or more. It was known to medieval alchemists as \"volatile spirit of sulfur\". SO2 is a bent molecule with C2v symmetry point group."}}, {"canonical_name": "Palaeontology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "pal\u00e9ontologie", "book_id": "medecine_experimentale_bernard_1865", "name": "pal\u00e9ontologie", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["pal\u00e9ontologie"], "contexts": ["science reconstructing animals from fossils"]}, {"entity_id": "pal\u00e6ontology", "book_id": "origin_of_species_darwin_1859", "name": "pal\u00e6ontology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["pal\u00e6ontology"], "contexts": ["study of fossil organisms"]}, {"entity_id": "palaeontology", "book_id": "kosmos_humboldt_1845", "name": "Palaeontology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Palaeontology", "palaeontology"], "contexts": ["study of ancient life through fossils", "study of fossils"]}, {"entity_id": "pal\u00e6ontology", "book_id": "first_principles_spencer_1862", "name": "Pal\u00e6ontology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Pal\u00e6ontology"], "contexts": ["study of fossil remains"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "pal\u00e9ontologie", "target_book": "origin_of_species_darwin_1859", "target_name": "pal\u00e6ontology", "similarity": 0.983}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "pal\u00e9ontologie", "target_book": "kosmos_humboldt_1845", "target_name": "Palaeontology", "similarity": 0.951}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "pal\u00e9ontologie", "target_book": "first_principles_spencer_1862", "target_name": "Pal\u00e6ontology", "similarity": 0.968}, {"source_book": "origin_of_species_darwin_1859", "source_name": "pal\u00e6ontology", "target_book": "kosmos_humboldt_1845", "target_name": "Palaeontology", "similarity": 0.96}, {"source_book": "origin_of_species_darwin_1859", "source_name": "pal\u00e6ontology", "target_book": "first_principles_spencer_1862", "target_name": "Pal\u00e6ontology", "similarity": 0.966}, {"source_book": "kosmos_humboldt_1845", "source_name": "Palaeontology", "target_book": "first_principles_spencer_1862", "target_name": "Pal\u00e6ontology", "similarity": 0.95}], "id": 732, "stable_key": "clu_133c4f41e21517e4", "ground_truth": {"modern_name": "Palaeontology", "confidence": "high", "type": "concept", "wikidata_id": "Q246729", "wikidata_description": "scientific journal of the Palaeontological Association", "wikipedia_url": "https://en.wikipedia.org/wiki/Paleontology", "wikipedia_extract": "Paleontology or palaeontology is the scientific study of the life of the past, mainly but not exclusively through the study of fossils. Paleontologists use fossils as a means to classify organisms, measure geologic time, and assess the interactions between prehistoric organisms and their natural environment. While paleontological observations are known from at least the 6th century BC, the foundation of paleontology as a science dates back to the work of Georges Cuvier in 1796. Cuvier demonstrated evidence for the concept of extinction and how the life of the past was not necessarily the same as that of the present. The field developed rapidly over the course of the following decades, and the French word pal\u00e9ontologie was introduced for the study in 1822, which was derived from the Ancient Greek word for 'ancient' and words describing relatedness and a field of study. Further advances in the field accompanied the work of Charles Darwin who popularized the concept of evolution."}}, {"canonical_name": "individual", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "individu", "book_id": "medecine_experimentale_bernard_1865", "name": "individu", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["individu"], "contexts": ["single organism"]}, {"entity_id": "individual", "book_id": "origin_of_species_darwin_1859", "name": "individual", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["individual"], "contexts": ["single organism"]}, {"entity_id": "individual", "book_id": "connexion_physical_sciences_somerville_1858", "name": "individual", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["individual"], "contexts": ["single person"]}, {"entity_id": "individual", "book_id": "first_principles_spencer_1862", "name": "individual", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["individual"], "contexts": ["a single person", "single human being"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "individu", "target_book": "origin_of_species_darwin_1859", "target_name": "individual", "similarity": 0.994}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "individu", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "individual", "similarity": 0.994}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "individu", "target_book": "first_principles_spencer_1862", "target_name": "individual", "similarity": 0.994}, {"source_book": "origin_of_species_darwin_1859", "source_name": "individual", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "individual", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "individual", "target_book": "first_principles_spencer_1862", "target_name": "individual", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "individual", "target_book": "first_principles_spencer_1862", "target_name": "individual", "similarity": 1.0}], "id": 733, "stable_key": "clu_c37c702213273283", "ground_truth": {"modern_name": "Organism", "confidence": "high", "type": "concept", "note": "While 'individual' can refer to a person, in biological contexts (Darwin, Spencer), it strongly implies a single living organism. The presence of 'single organism' in the contexts solidifies this.", "wikidata_id": "Q55983715", "wikidata_description": "organisms which have been assigned common names in addition to their taxon name"}}, {"canonical_name": "Scheele", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "scarpa", "book_id": "medecine_experimentale_bernard_1865", "name": "Scarpa", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Scarpa"], "contexts": ["author with opinions on nerve anastomoses"]}, {"entity_id": "schouw", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Schouw", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Schouw"], "contexts": ["observer of continental atmosphere temperatures"]}, {"entity_id": "schouw", "book_id": "kosmos_humboldt_1845", "name": "Schouw", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Schouw"], "contexts": ["rain distribution in Central Europe"]}, {"entity_id": "scheele", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Scheele", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Scheele"], "contexts": ["discoverer of photographic rays", "discoverer of chemical rays"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Scarpa", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Schouw", "similarity": 0.85}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Scarpa", "target_book": "kosmos_humboldt_1845", "target_name": "Schouw", "similarity": 0.85}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Schouw", "target_book": "kosmos_humboldt_1845", "target_name": "Schouw", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Schouw", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Scheele", "similarity": 0.869}, {"source_book": "kosmos_humboldt_1845", "source_name": "Schouw", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Scheele", "similarity": 0.869}], "id": 734, "stable_key": "clu_b8bc36d6d4df8bc2", "ground_truth": {"modern_name": "Carl Wilhelm Scheele", "confidence": "high", "type": "person", "birth_year": 1742, "death_year": 1786, "description": "Swedish pharmacist and chemist, discoverer of oxygen and chlorine.", "note": "The text contains a misspelling of Scheele as 'Schouw' in two instances, but the context of chemical discoveries strongly points to Scheele.", "wikidata_id": "Q70538", "wikidata_description": "Swedish German chemist who discovered oxygen"}}, {"canonical_name": "Archimedes", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "archimedes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Archimedes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Archimedes"], "contexts": ["ancient mathematician, discovered pi ratio", "ancient mathematician, undertook large tasks"]}, {"entity_id": "archim\u00e8de", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Archim\u00e8de", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Archim\u00e8de"], "contexts": ["ancient mathematician/inventor"]}, {"entity_id": "archimedes", "book_id": "principles_of_psychology_james_1890", "name": "Archimedes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Archimedes"], "contexts": ["mathematician absorbed in geometrical meditation"]}, {"entity_id": "archimedes", "book_id": "first_principles_spencer_1862", "name": "Archimedes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Archimedes"], "contexts": ["ancient Greek mathematician and physicist"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Archimedes", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Archim\u00e8de", "similarity": 0.841}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Archimedes", "target_book": "principles_of_psychology_james_1890", "target_name": "Archimedes", "similarity": 0.799}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Archimedes", "target_book": "first_principles_spencer_1862", "target_name": "Archimedes", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Archim\u00e8de", "target_book": "first_principles_spencer_1862", "target_name": "Archimedes", "similarity": 0.841}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Archimedes", "target_book": "first_principles_spencer_1862", "target_name": "Archimedes", "similarity": 0.799}], "id": 735, "stable_key": "clu_cf5d3c488604cc99", "ground_truth": {"modern_name": "Archimedes", "confidence": "high", "type": "person", "birth_year": -287, "death_year": -212, "description": "Ancient Greek mathematician, physicist, engineer, inventor, and astronomer.", "wikidata_id": "Q776475", "wikidata_description": "genus of bryozoans (fossil)", "wikipedia_url": "https://en.wikipedia.org/wiki/Archimedes%20%28bryozoan%29", "wikipedia_extract": "Archimedes is a genus of bryozoans belonging to the family Fenestellidae. The first use of the term \"Archimedes\" in relation to this genus was in 1838. This genus of bryozoans is named Archimedes because of its corkscrew shape, in analogy to the Archimedes' screw, a type of water pump which inspired modern ship propellers in turn named after the ancient greek polymath. These forms are common as fossils but they have been extinct since the Permian. Archimedes orientalis Schulga-Nesterenko 1936 Archimedes stuckenbergi Nikiforova 1938 These bryozoans lived from the Carboniferous period (Tournaisian age) to the Permian period (Leonard age) (345.3 to 268.0 Ma), when this genus became extinct. Archimedes is a genus of fenestrate bryozoans with a calcified skeleton of a delicate spiral-shaped mesh that was thickened near the axis into a massive corkscrew-shaped central structure."}}, {"canonical_name": "transparency", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "transparency", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "transparency", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["transparency"], "contexts": ["cause of transparency in things", "ability to let light pass through"]}, {"entity_id": "transparent", "book_id": "principles_of_psychology_james_1890", "name": "transparent", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["transparent"], "contexts": ["visual quality"]}, {"entity_id": "transparency", "book_id": "principles_of_psychology_james_1890", "name": "transparency", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["transparency"], "contexts": ["state of being transparent"]}, {"entity_id": "transparency", "book_id": "kosmos_humboldt_1845", "name": "transparency", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["transparency"], "contexts": ["property of the atmosphere"]}, {"entity_id": "transparency", "book_id": "connexion_physical_sciences_somerville_1858", "name": "transparency", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["transparency"], "contexts": ["ability to allow light to pass through"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "transparency", "target_book": "principles_of_psychology_james_1890", "target_name": "transparent", "similarity": 0.901}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "transparency", "target_book": "principles_of_psychology_james_1890", "target_name": "transparency", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "transparency", "target_book": "kosmos_humboldt_1845", "target_name": "transparency", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "transparency", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "transparency", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "transparent", "target_book": "kosmos_humboldt_1845", "target_name": "transparency", "similarity": 0.901}, {"source_book": "principles_of_psychology_james_1890", "source_name": "transparent", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "transparency", "similarity": 0.901}, {"source_book": "principles_of_psychology_james_1890", "source_name": "transparency", "target_book": "kosmos_humboldt_1845", "target_name": "transparency", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "transparency", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "transparency", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "transparency", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "transparency", "similarity": 1.0}], "id": 736, "stable_key": "clu_6a5d2c800b84dc15", "ground_truth": {"modern_name": "transparent", "confidence": "high", "type": "concept", "wikidata_id": "Q568753", "wikidata_description": "economic concept", "wikipedia_url": "https://en.wikipedia.org/wiki/Transparency%20%28market%29", "wikipedia_extract": "In economics, a market is transparent if much is known by many about what products and services or capital assets are available, market depth (quantity available), what price, and where. Transparency is important since it is one of the theoretical conditions required for a free market to be efficient. Price transparency can, however, lead to higher prices. For example, if it makes sellers reluctant to give steep discounts to certain buyers (e.g. disrupting price dispersion among buyers), or if it facilitates collusion, and price volatility is another concern. A high degree of market transparency can result in disintermediation due to the buyer's increased knowledge of supply pricing."}}, {"canonical_name": "Terra Lemnia", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "terra_lemnia", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Terra Lemnia", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Terra Lemnia"], "contexts": ["medicinal earth from Lemnos", "stone mentioned with \u00c6tites"]}, {"entity_id": "terra_lemnia", "book_id": "historia_medicinal_monardes_1574", "name": "Terra lemnia", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Terra lemnia", "Terra lemn\u00eda"], "contexts": ["medicinal earth from Lemnos", "earth substance, Bolarmen\u00edco"]}, {"entity_id": "terra_de_lemnos", "book_id": "coloquios_da_orta_1563", "name": "terra de Lemnos", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["terra de Lemnos"], "contexts": ["earth used in medicine"]}, {"entity_id": "terra_lemnia", "book_id": "polyanthea_medicinal", "name": "terra Lemnia", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["terra Lemnia"], "contexts": ["type of medicinal earth"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Terra Lemnia", "target_book": "historia_medicinal_monardes_1574", "target_name": "Terra lemnia", "similarity": 0.764}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Terra Lemnia", "target_book": "coloquios_da_orta_1563", "target_name": "terra de Lemnos", "similarity": 0.893}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Terra Lemnia", "target_book": "polyanthea_medicinal", "target_name": "terra Lemnia", "similarity": 0.979}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Terra lemnia", "target_book": "polyanthea_medicinal", "target_name": "terra Lemnia", "similarity": 0.765}, {"source_book": "coloquios_da_orta_1563", "source_name": "terra de Lemnos", "target_book": "polyanthea_medicinal", "target_name": "terra Lemnia", "similarity": 0.915}], "id": 737, "stable_key": "clu_1a2500e504267e16", "ground_truth": {"modern_name": "Lemnian earth", "confidence": "high", "type": "mineral", "note": "A medicinal earth historically sourced from the island of Lemnos.", "wikidata_id": "Q135185467", "wikidata_description": "historic medicinal clay", "wikipedia_url": "https://en.wikipedia.org/wiki/Lemnian%20Earth", "wikipedia_extract": "Lemnian Earth was a medicinal clay sourced from the Greek island of Lemnos in the Aegean Sea. It was used from antiquity on until the post-medieval period for the treatment of poisonings, open wounds and other illnesses. Lemnian clay was shaped into tablets with distinctive seals stamped into them, from which it got its name terra sigillata - Latin for 'sealed earth'. Lemnian Earth was first documented in the 3rd century BCE for its use as a pigment. The earliest mention of its application as a medicine appears in Dioscorides' De Materia Medica, dated to ca. 50\u201370."}}, {"canonical_name": "fluidity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "fluidity", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "fluidity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fluidity"], "contexts": ["state of flowing"]}, {"entity_id": "fluidit\u00e9", "book_id": "epoques_nature_buffon_1778", "name": "fluidit\u00e9", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fluidit\u00e9"], "contexts": ["state of being liquid"]}, {"entity_id": "fluidity", "book_id": "kosmos_humboldt_1845", "name": "fluidity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["fluidity"], "contexts": ["state of the early planet", "ability to flow"]}, {"entity_id": "fluidity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "fluidity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["fluidity"], "contexts": ["state of being liquid or flowing", "state of being fluid, able to flow"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fluidity", "target_book": "epoques_nature_buffon_1778", "target_name": "fluidit\u00e9", "similarity": 0.986}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fluidity", "target_book": "kosmos_humboldt_1845", "target_name": "fluidity", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fluidity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fluidity", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "fluidit\u00e9", "target_book": "kosmos_humboldt_1845", "target_name": "fluidity", "similarity": 0.986}, {"source_book": "epoques_nature_buffon_1778", "source_name": "fluidit\u00e9", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fluidity", "similarity": 0.986}, {"source_book": "kosmos_humboldt_1845", "source_name": "fluidity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fluidity", "similarity": 1.0}], "id": 738, "stable_key": "clu_0439a9315981b5f0", "ground_truth": {"modern_name": "Fluidity", "confidence": "high", "type": "concept", "wikidata_id": "Q65921492", "wikidata_description": "ability of an item to change to suit some purpose", "wikipedia_url": "https://en.wikipedia.org/wiki/Flexibility%20%28engineering%29", "wikipedia_extract": "Flexibility is used as an attribute of various types of systems. In the field of engineering systems design, it refers to designs that can adapt when external changes occur. Flexibility has been defined differently in many fields of engineering, architecture, biology, economics, etc. In the context of engineering design one can define flexibility as the ability of a system to respond to potential internal or external changes affecting its value delivery, in a timely and cost-effective manner. Thus, flexibility for an engineering system is the ease with which the system can respond to uncertainty in a manner to sustain or increase its value delivery. Uncertainty is a key element in the definition of flexibility."}}, {"canonical_name": "sublimation", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "sublimation", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "sublimation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sublimation"], "contexts": ["operation of heating substances"]}, {"entity_id": "sublimation", "book_id": "epoques_nature_buffon_1778", "name": "sublimation", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["sublimation"], "contexts": ["process of turning solid to gas", "process of vaporizing and condensing solids"]}, {"entity_id": "sublimations", "book_id": "epoques_nature_buffon_1778", "name": "sublimations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sublimations"], "contexts": ["sublimation products"]}, {"entity_id": "sublima\u00e7\u00e3o", "book_id": "polyanthea_medicinal", "name": "sublima\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["sublima\u00e7\u00e3o"], "contexts": ["sublimation, a solid to gas transition"]}, {"entity_id": "sublimation", "book_id": "first_principles_spencer_1862", "name": "sublimation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sublimation"], "contexts": ["transition from solid to gas"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sublimation", "target_book": "epoques_nature_buffon_1778", "target_name": "sublimation", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sublimation", "target_book": "epoques_nature_buffon_1778", "target_name": "sublimations", "similarity": 0.955}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sublimation", "target_book": "polyanthea_medicinal", "target_name": "sublima\u00e7\u00e3o", "similarity": 0.987}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sublimation", "target_book": "first_principles_spencer_1862", "target_name": "sublimation", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "sublimation", "target_book": "polyanthea_medicinal", "target_name": "sublima\u00e7\u00e3o", "similarity": 0.987}, {"source_book": "epoques_nature_buffon_1778", "source_name": "sublimation", "target_book": "first_principles_spencer_1862", "target_name": "sublimation", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "sublimations", "target_book": "polyanthea_medicinal", "target_name": "sublima\u00e7\u00e3o", "similarity": 0.94}, {"source_book": "epoques_nature_buffon_1778", "source_name": "sublimations", "target_book": "first_principles_spencer_1862", "target_name": "sublimation", "similarity": 0.955}, {"source_book": "polyanthea_medicinal", "source_name": "sublima\u00e7\u00e3o", "target_book": "first_principles_spencer_1862", "target_name": "sublimation", "similarity": 0.987}], "id": 739, "stable_key": "clu_56e7e744a1d90590", "ground_truth": {"modern_name": "Sublimation", "confidence": "high", "type": "concept"}}, {"canonical_name": "Afphalto", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "asphaltus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Asphaltus", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Asphaltus"], "contexts": ["bitumen from Judea, tested for electricity"]}, {"entity_id": "asfalto", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "asfalto", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["asfalto"], "contexts": ["substance with a grave odor"]}, {"entity_id": "afphalto", "book_id": "ricettario_fiorentino_1597", "name": "Afphalto", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Afphalto"], "contexts": ["substance used in preparations", "bitumen, asphalt"]}, {"entity_id": "asphalt", "book_id": "connexion_physical_sciences_somerville_1858", "name": "asphalt", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["asphalt"], "contexts": ["film dissolved in oil of lavender", "dissolved in oil for photographic plate"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Asphaltus", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "asfalto", "similarity": 0.943}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Asphaltus", "target_book": "ricettario_fiorentino_1597", "target_name": "Afphalto", "similarity": 0.981}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Asphaltus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "asphalt", "similarity": 0.99}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "asfalto", "target_book": "ricettario_fiorentino_1597", "target_name": "Afphalto", "similarity": 0.946}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "asfalto", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "asphalt", "similarity": 0.947}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Afphalto", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "asphalt", "similarity": 0.976}], "id": 740, "stable_key": "clu_25eb484c5396d93c", "ground_truth": {"modern_name": "Asphalt", "confidence": "high", "type": "chemical", "note": "Includes references to asphalt and bitumen, used in preparations and tested for electrical properties.", "wikidata_id": "Q202251", "wikidata_description": "petroleum product", "wikipedia_extract": "Sealcoating, or pavement sealing, is the process of applying a protective coating to asphalt-based pavements to provide a layer of protection from the elements: water, oils, and U.V. damage. The effects of asphalt sealers have been debated. Asphalt sealing is marketed as increasing the life of the asphalt, but there is no independent research that proves these claims. Asphalt sealing can also make the asphalt more slippery and impact the environment. There are concerns about pavement sealer polluting the environment after it is abraded from the surface of the pavement.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sealcoat"}}, {"canonical_name": "saint", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "saints", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Saints", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Saints"], "contexts": ["religious figures used for plant names"]}, {"entity_id": "saints", "book_id": "english_physician_1652", "name": "Saints", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Saints"], "contexts": ["recipients of comfort and holiness"]}, {"entity_id": "saint", "book_id": "principles_of_psychology_james_1890", "name": "saint", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["saint"], "contexts": ["person recognized for holiness", "person of great virtue and holiness"]}, {"entity_id": "saints", "book_id": "first_principles_spencer_1862", "name": "saints", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["saints"], "contexts": ["religious subject in art"]}, {"entity_id": "saint", "book_id": "first_principles_spencer_1862", "name": "saint", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["saint"], "contexts": ["honored by dancing in choir"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Saints", "target_book": "english_physician_1652", "target_name": "Saints", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Saints", "target_book": "principles_of_psychology_james_1890", "target_name": "saint", "similarity": 0.875}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Saints", "target_book": "first_principles_spencer_1862", "target_name": "saints", "similarity": 0.937}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Saints", "target_book": "first_principles_spencer_1862", "target_name": "saint", "similarity": 0.875}, {"source_book": "english_physician_1652", "source_name": "Saints", "target_book": "principles_of_psychology_james_1890", "target_name": "saint", "similarity": 0.875}, {"source_book": "english_physician_1652", "source_name": "Saints", "target_book": "first_principles_spencer_1862", "target_name": "saints", "similarity": 0.937}, {"source_book": "english_physician_1652", "source_name": "Saints", "target_book": "first_principles_spencer_1862", "target_name": "saint", "similarity": 0.875}, {"source_book": "principles_of_psychology_james_1890", "source_name": "saint", "target_book": "first_principles_spencer_1862", "target_name": "saints", "similarity": 0.884}, {"source_book": "principles_of_psychology_james_1890", "source_name": "saint", "target_book": "first_principles_spencer_1862", "target_name": "saint", "similarity": 1.0}], "id": 741, "stable_key": "clu_3040d676ee4330fc", "ground_truth": {"modern_name": "Saint", "confidence": "high", "type": "person", "description": "Holy person, venerated figure in religious contexts", "wikidata_id": "Q43115", "wikidata_description": "person who has been recognized for having an exceptional degree of holiness, sanctity, and virtue; may or may not be a canonised saint", "wikipedia_url": "https://en.wikipedia.org/wiki/Saint", "wikipedia_extract": "In Christian belief, a saint, also known as a hallow, is a person who is recognized as having an exceptional degree of holiness, likeness, or closeness to God. However, the use of the term saint depends on the context and denomination. Official ecclesiastical recognition, and veneration, is conferred on some denominational saints through the process of canonization in the Catholic Church or glorification in the Eastern Orthodox Church after their approval. The saints are honored in the liturgical calendars of Evangelical Lutheranism and Anglicanism. In other nonconformist denominations, such as the Plymouth Brethren, and following from Pauline usage, saint refers broadly to any holy Christian without special recognition or selection. While the English word saint (deriving from the Latin sanctus) originated in Christianity, historians of religion tend to use the appellation \"in a more general way to refer to the state of special holiness that many religions attribute to certain people\", referring to the Hindu rishi, Sikh bhagat or guru, the Shintoist kami, the Taoist immortal or zhenren, the Jewish tzadik, the Islamic wal\u012b/fakir, and the Buddhist arhat or bodhisattva also as saints."}}, {"canonical_name": "Mauritanie", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "mauritanie", "book_id": "epoques_nature_buffon_1778", "name": "Mauritanie", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Mauritanie"], "contexts": ["country in Africa", "Mauritania"]}, {"entity_id": "mauritius", "book_id": "origin_of_species_darwin_1859", "name": "Mauritius", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Mauritius"], "contexts": ["island nation in the Indian Ocean", "island with peculiar bats"]}, {"entity_id": "mauritanie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mauritanie", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Mauritanie"], "contexts": ["country in Africa"]}, {"entity_id": "mauritius", "book_id": "kosmos_humboldt_1845", "name": "Mauritius", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Mauritius"], "contexts": ["island where the dodo lived"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Mauritanie", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Mauritanie", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Mauritanie", "target_book": "kosmos_humboldt_1845", "target_name": "Mauritius", "similarity": 0.955}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Mauritius", "target_book": "kosmos_humboldt_1845", "target_name": "Mauritius", "similarity": 0.904}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mauritanie", "target_book": "kosmos_humboldt_1845", "target_name": "Mauritius", "similarity": 0.955}], "id": 742, "stable_key": "clu_7fb9401d36b8d0cf", "ground_truth": {"modern_name": "Mauritius", "confidence": "high", "type": "place", "country": "Mauritius", "note": "Maurilia is a historical variant of Mauritius.", "wikidata_id": "Q2656389", "wikidata_description": "main island in the country of Mauritius", "wikipedia_url": "https://en.wikipedia.org/wiki/Mauritius%20Island"}}, {"canonical_name": "Volga", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "volga", "book_id": "epoques_nature_buffon_1778", "name": "Volga", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Volga"], "contexts": ["longest river in Europe"]}, {"entity_id": "volga", "book_id": "kosmos_humboldt_1845", "name": "Volga", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Volga"], "contexts": ["river mouth in Eastern Russia"]}, {"entity_id": "volga", "book_id": "coloquios_da_orta_1563", "name": "Volga", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Volga"], "contexts": ["ancient name for river", "river name"]}, {"entity_id": "volga", "book_id": "ricettario_fiorentino_1597", "name": "Volga", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Volga"], "contexts": ["river, also called Rha"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Volga", "target_book": "kosmos_humboldt_1845", "target_name": "Volga", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Volga", "target_book": "coloquios_da_orta_1563", "target_name": "Volga", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Volga", "target_book": "ricettario_fiorentino_1597", "target_name": "Volga", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Volga", "target_book": "coloquios_da_orta_1563", "target_name": "Volga", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Volga", "target_book": "ricettario_fiorentino_1597", "target_name": "Volga", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Volga", "target_book": "ricettario_fiorentino_1597", "target_name": "Volga", "similarity": 1.0}], "id": 743, "stable_key": "clu_96bee7e0e1fcbb38", "ground_truth": {"modern_name": "Volga River", "confidence": "high", "type": "place", "description": "A major river in Russia, historically known as Rha.", "wikipedia_extract": "The Volga (Russian: \u0412\u043e\u043b\u0433\u0430, pronounced [\u02c8vol\u0261\u0259] ) is the longest river in Europe and the longest endorheic basin river in the world. Situated in Russia, it flows through Central Russia to Southern Russia and into the Caspian Sea. The Volga has a length of 3,531 km (2,194 mi), and a catchment area of 1,360,000 km2 (530,000 sq mi). It is also Europe's largest river in terms of average discharge at delta \u2013 between 8,000 m3/s (280,000 cu ft/s) and 8,500 m3/s (300,000 cu ft/s) \u2013 and of drainage basin. It is widely regarded as the national river of Russia. The hypothetical old Russian state, the Rus' Khaganate, arose along the Volga c.\u2009830 AD."}}, {"canonical_name": "polar regions", "category": "PLACE", "subcategory": "REGION", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "contr\u00e9es_polaires", "book_id": "epoques_nature_buffon_1778", "name": "contr\u00e9es polaires", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["contr\u00e9es polaires"], "contexts": ["polar regions"]}, {"entity_id": "r\u00e9gions_polaires", "book_id": "epoques_nature_buffon_1778", "name": "r\u00e9gions polaires", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["r\u00e9gions polaires"], "contexts": ["areas of the globe with polar regions"]}, {"entity_id": "polar_regions", "book_id": "kosmos_humboldt_1845", "name": "polar regions", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["polar regions"], "contexts": ["cold regions at Earth's poles", "cold regions around the poles"]}, {"entity_id": "polar_regions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "polar regions", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["polar regions"], "contexts": ["regions around the Earth's poles"]}, {"entity_id": "polar_regions", "book_id": "first_principles_spencer_1862", "name": "polar regions", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["polar regions"], "contexts": ["areas around the Earth's poles"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "contr\u00e9es polaires", "target_book": "kosmos_humboldt_1845", "target_name": "polar regions", "similarity": 0.924}, {"source_book": "epoques_nature_buffon_1778", "source_name": "contr\u00e9es polaires", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "polar regions", "similarity": 0.924}, {"source_book": "epoques_nature_buffon_1778", "source_name": "contr\u00e9es polaires", "target_book": "first_principles_spencer_1862", "target_name": "polar regions", "similarity": 0.924}, {"source_book": "epoques_nature_buffon_1778", "source_name": "r\u00e9gions polaires", "target_book": "kosmos_humboldt_1845", "target_name": "polar regions", "similarity": 0.967}, {"source_book": "epoques_nature_buffon_1778", "source_name": "r\u00e9gions polaires", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "polar regions", "similarity": 0.967}, {"source_book": "epoques_nature_buffon_1778", "source_name": "r\u00e9gions polaires", "target_book": "first_principles_spencer_1862", "target_name": "polar regions", "similarity": 0.967}, {"source_book": "kosmos_humboldt_1845", "source_name": "polar regions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "polar regions", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "polar regions", "target_book": "first_principles_spencer_1862", "target_name": "polar regions", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "polar regions", "target_book": "first_principles_spencer_1862", "target_name": "polar regions", "similarity": 1.0}], "id": 744, "stable_key": "clu_df45130630d79ded", "ground_truth": {"modern_name": "Polar regions", "confidence": "high", "type": "place", "wikidata_id": "Q60670", "wikidata_description": "regions around the Earth's geographical poles", "wikipedia_url": "https://en.wikipedia.org/wiki/Polar%20regions%20of%20Earth", "country": "Antarctica, Arctic", "wikipedia_extract": "The polar regions, also called the frigid zones or polar zones, of Earth are Earth's polar ice caps, the regions of the planet that surround its geographical poles (the North Pole and the South Pole), lying within the polar circles. These high latitudes are dominated by floating sea ice covering much of the Arctic Ocean in the north, and by the Antarctic ice sheet on the continent of Antarctica and the Southern Ocean in the south. The Arctic has various definitions, including the region north of the Arctic Circle (currently Epoch 2010 at 66\u00b033'44\" N), or just the region north of 60\u00b0 north latitude, or the region from the North Pole south to the timberline. The Antarctic is usually defined simply as south of 60\u00b0 south latitude, or the continent of Antarctica. The 1959 Antarctic Treaty uses the former definition. The two polar regions are distinguished from the other two climatic and biometric belts of Earth, a tropics belt near the equator, and two middle latitude regions located between the tropics and polar regions."}}, {"canonical_name": "Macedonia", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "mac\u00e9doine", "book_id": "epoques_nature_buffon_1778", "name": "Mac\u00e9doine", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Mac\u00e9doine"], "contexts": ["historical and geographical region"]}, {"entity_id": "macedonia", "book_id": "kosmos_humboldt_1845", "name": "Macedonia", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Macedonia"], "contexts": ["region where Aristotle observed red snow", "region where snow was observed"]}, {"entity_id": "maced\u00f3nia", "book_id": "coloquios_da_orta_1563", "name": "Maced\u00f3nia", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Maced\u00f3nia"], "contexts": ["place where Macedonians are from", "location of a diamond"]}, {"entity_id": "macedonia", "book_id": "ricettario_fiorentino_1597", "name": "Macedonia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Macedonia"], "contexts": ["place where borrace is found"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Mac\u00e9doine", "target_book": "coloquios_da_orta_1563", "target_name": "Maced\u00f3nia", "similarity": 0.982}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Mac\u00e9doine", "target_book": "ricettario_fiorentino_1597", "target_name": "Macedonia", "similarity": 0.882}, {"source_book": "kosmos_humboldt_1845", "source_name": "Macedonia", "target_book": "coloquios_da_orta_1563", "target_name": "Maced\u00f3nia", "similarity": 0.827}, {"source_book": "kosmos_humboldt_1845", "source_name": "Macedonia", "target_book": "ricettario_fiorentino_1597", "target_name": "Macedonia", "similarity": 0.936}, {"source_book": "coloquios_da_orta_1563", "source_name": "Maced\u00f3nia", "target_book": "ricettario_fiorentino_1597", "target_name": "Macedonia", "similarity": 0.888}], "id": 745, "stable_key": "clu_f2bc0086a5f1bf29", "ground_truth": {"wikipedia_extract": "Ciacova (Hungarian: Cs\u00e1k; German: Tschakowa; Serbian: \u0427\u0430\u043a\u043e\u0432\u043e, romanized: \u010cakovo; Turkish: \u00c7akova) is a town in Timi\u0219 County, Romania. It administers four villages: Cebza, Macedonia, Obad and Petroman. When it was declared a town in 2004, the villages of Gad and Ghilad, which it administered up to that point, were split off to form Ghilad commune. In both Romanian and Hungarian vocabularies, there are the names ceac\u0103u (in Romanian), cs\u00e1k\u00f3 (in Hungarian) and cs\u00e1k (in Old Hungarian): ceac\u0103u, meaning \"tall and hard military cap made of leather or felt\"; it was used until the end of World War II by hunting and targeting troops, then only by police troops. It is therefore possible that Ciacova got its name from this word and meant a locality around a defense post. cs\u00e1k, meaning \"peak\". Accepting this translation, the Ciacova Fortress is explained as a \"peak of defense\" against any enemy intervention from the east or southeast."}}, {"canonical_name": "St. Petersburg", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "saint-p\u00e9tersbourg", "book_id": "epoques_nature_buffon_1778", "name": "Saint-P\u00e9tersbourg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Saint-P\u00e9tersbourg"], "contexts": ["location of elephant bone discovery"]}, {"entity_id": "st__petersburg", "book_id": "principles_of_psychology_james_1890", "name": "St. Petersburg", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["St. Petersburg"], "contexts": ["location of cited publication", "location of publication"]}, {"entity_id": "st__petersburg", "book_id": "kosmos_humboldt_1845", "name": "St. Petersburg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["St. Petersburg"], "contexts": ["location of Hensius's description"]}, {"entity_id": "st__petersburg", "book_id": "connexion_physical_sciences_somerville_1858", "name": "St. Petersburg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["St. Petersburg"], "contexts": ["location of Kratzenstein"]}, {"entity_id": "petersburg", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Petersburg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Petersburg"], "contexts": ["location where Professor Richman was struck"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Saint-P\u00e9tersbourg", "target_book": "principles_of_psychology_james_1890", "target_name": "St. Petersburg", "similarity": 0.911}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Saint-P\u00e9tersbourg", "target_book": "kosmos_humboldt_1845", "target_name": "St. Petersburg", "similarity": 0.911}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Saint-P\u00e9tersbourg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "St. Petersburg", "similarity": 0.911}, {"source_book": "principles_of_psychology_james_1890", "source_name": "St. Petersburg", "target_book": "kosmos_humboldt_1845", "target_name": "St. Petersburg", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "St. Petersburg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "St. Petersburg", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "St. Petersburg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Petersburg", "similarity": 0.943}, {"source_book": "kosmos_humboldt_1845", "source_name": "St. Petersburg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "St. Petersburg", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "St. Petersburg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Petersburg", "similarity": 0.943}], "id": 746, "stable_key": "clu_f65d918a6f72a573", "ground_truth": {"modern_name": "Saint Petersburg", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q656", "wikidata_description": "federal city and former capital of Russia", "wikipedia_url": "https://en.wikipedia.org/wiki/Saint%20Petersburg", "wikipedia_extract": "Saint Petersburg, formerly known as Petrograd (\u041f\u0435\u0442\u0440\u043e\u0433\u0440\u0430\u0434) and later Leningrad (\u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434), is the second-largest city in Russia, after Moscow, the nation's capital. It is situated on the River Neva, at the head of the Gulf of Finland on the Baltic Sea. With an area of 1,439 square kilometers (556 square miles), Saint Petersburg is the smallest administrative division of Russia by area. The city had a population of 5,601,911 residents as of 2021, with more than 6.4 million people living in the metropolitan area. Saint Petersburg is the fourth-most populous city in Europe, the most populous city on the Baltic Sea, and the world's northernmost city of more than 1 million residents. As the former capital of the Russian Empire, and a historically strategic port, it is governed as a federal city."}}, {"canonical_name": "temperate", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "temp\u00e9r\u00e9es", "book_id": "epoques_nature_buffon_1778", "name": "temp\u00e9r\u00e9es", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["temp\u00e9r\u00e9es"], "contexts": ["temperature quality"]}, {"entity_id": "temperate", "book_id": "english_physician_1652", "name": "temperate", "category": "CONCEPT", "subcategory": "QUALITY", "count": 3, "variants": ["temperate", "temper"], "contexts": ["quality of the herb", "quality of pansies"]}, {"entity_id": "temp\u00e9r\u00e9e", "book_id": "relation_historique_humboldt_vol3_1825", "name": "temp\u00e9r\u00e9e", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["temp\u00e9r\u00e9e"], "contexts": ["relating to moderate temperature"]}, {"entity_id": "temperata", "book_id": "ricettario_fiorentino_1597", "name": "temperata", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["temperata"], "contexts": ["temperate quality"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "temp\u00e9r\u00e9es", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "temp\u00e9r\u00e9e", "similarity": 0.947}, {"source_book": "english_physician_1652", "source_name": "temperate", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "temp\u00e9r\u00e9e", "similarity": 0.908}, {"source_book": "english_physician_1652", "source_name": "temperate", "target_book": "ricettario_fiorentino_1597", "target_name": "temperata", "similarity": 0.948}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "temp\u00e9r\u00e9e", "target_book": "ricettario_fiorentino_1597", "target_name": "temperata", "similarity": 0.897}], "id": 747, "stable_key": "clu_ce45c6d3c7187773", "ground_truth": {"modern_name": "Temperate", "confidence": "high", "type": "concept", "note": "Refers to a moderate climate or quality, distinct from extreme heat or cold.", "wikidata_id": "Q167466", "wikidata_description": "main climate class", "wikipedia_url": "https://en.wikipedia.org/wiki/Temperate%20climate", "wikipedia_extract": "In geography, the temperate climates of Earth occur in the middle latitudes (approximately 23.5\u00b0 to 66.5\u00b0 N/S of the Equator), which span between the tropics and the polar regions of Earth. These zones generally have wider temperature ranges throughout the year and more distinct seasonal changes compared to tropical climates, where such variations are often small; they usually differ only in the amount of precipitation. In temperate climates, not only do latitudinal positions influence temperature changes, but various sea currents, prevailing wind direction, continentality (how large a landmass is) and altitude also shape temperate climates. The K\u00f6ppen climate classification defines a climate as \"temperate\" C, when the mean temperature is above \u22123 \u00b0C (26.6 \u00b0F) but below 18 \u00b0C (64.4 \u00b0F) in the coldest month to account for the persistence of frost. However, some adaptations of K\u00f6ppen set the minimum at 0 \u00b0C (32.0 \u00b0F). Continental climates are classified as D and considered to be varieties of temperate climates, having more extreme temperatures, with mean temperatures in the coldest month usually being below \u22123 \u00b0C (26.6 \u00b0F)."}}, {"canonical_name": "subterraneous fires", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "feux_souterrains", "book_id": "epoques_nature_buffon_1778", "name": "feux souterrains", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["feux souterrains"], "contexts": ["underground fires or volcanic activity"]}, {"entity_id": "feux_souterrains", "book_id": "relation_historique_humboldt_vol3_1825", "name": "feux souterrains", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["feux souterrains"], "contexts": ["geological phenomenon"]}, {"entity_id": "subterranean_fire", "book_id": "kosmos_humboldt_1845", "name": "subterranean fire", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["subterranean fire"], "contexts": ["heat source within the earth"]}, {"entity_id": "subterraneous_fires", "book_id": "connexion_physical_sciences_somerville_1858", "name": "subterraneous fires", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["subterraneous fires"], "contexts": ["underground heat sources", "underground heat causing geological change"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "feux souterrains", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "feux souterrains", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "feux souterrains", "target_book": "kosmos_humboldt_1845", "target_name": "subterranean fire", "similarity": 0.906}, {"source_book": "epoques_nature_buffon_1778", "source_name": "feux souterrains", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "subterraneous fires", "similarity": 0.93}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "feux souterrains", "target_book": "kosmos_humboldt_1845", "target_name": "subterranean fire", "similarity": 0.906}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "feux souterrains", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "subterraneous fires", "similarity": 0.93}, {"source_book": "kosmos_humboldt_1845", "source_name": "subterranean fire", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "subterraneous fires", "similarity": 0.966}], "id": 748, "stable_key": "clu_a92714e2