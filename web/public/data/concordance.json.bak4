first_principles_spencer_1862", "name": "laws", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["laws"], "contexts": ["rules of conduct enforced by authority"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "laws", "target_book": "principles_of_psychology_james_1890", "target_name": "laws", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "laws", "target_book": "kosmos_humboldt_1845", "target_name": "laws", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "laws", "target_book": "first_principles_spencer_1862", "target_name": "laws", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "laws", "target_book": "kosmos_humboldt_1845", "target_name": "laws", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "laws", "target_book": "first_principles_spencer_1862", "target_name": "laws", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "laws", "target_book": "first_principles_spencer_1862", "target_name": "laws", "similarity": 1.0}], "id": 752, "stable_key": "clu_f139fc7bb94c2ebb", "ground_truth": {"modern_name": "Scientific Law", "confidence": "high", "type": "concept", "wikidata_id": "Q408891", "wikidata_description": "statement based on repeated experimental observations that describes some aspects of the universe", "wikipedia_url": "https://en.wikipedia.org/wiki/Scientific%20law", "wikipedia_extract": "Scientific laws or laws of science are statements, based on repeated experiments or observations, that describe or predict a range of natural phenomena. The term law has diverse usage in many cases (approximate, accurate, broad, or narrow) across all fields of natural science (physics, chemistry, astronomy, geoscience, biology). Laws are developed from data and can be further developed through mathematics; in all cases they are directly or indirectly based on empirical evidence. It is generally understood that they implicitly reflect, though they do not explicitly assert, causal relationships fundamental to reality, and are discovered rather than invented. Scientific laws summarize the results of experiments or observations, usually within a certain range of application. In general, the accuracy of a law does not change when a new theory of the relevant phenomenon is worked out, but rather the scope of the law's application, since the mathematics or statement representing the law does not change."}}, {"canonical_name": "luxuria", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "luxuria", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "luxuria", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["luxuria"], "contexts": ["incites lust", "lust, excessive desire"]}, {"entity_id": "luxe", "book_id": "relation_historique_humboldt_vol3_1825", "name": "luxe", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["luxe"], "contexts": ["non-essential item"]}, {"entity_id": "luxus", "book_id": "principles_of_psychology_james_1890", "name": "Luxus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Luxus"], "contexts": ["term for something superfluous or excessive"]}, {"entity_id": "luxuria", "book_id": "polyanthea_medicinal", "name": "luxuria", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["luxuria"], "contexts": ["excessive sexual indulgence"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "luxuria", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "luxe", "similarity": 0.912}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "luxuria", "target_book": "principles_of_psychology_james_1890", "target_name": "Luxus", "similarity": 0.92}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "luxuria", "target_book": "polyanthea_medicinal", "target_name": "luxuria", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "luxe", "target_book": "principles_of_psychology_james_1890", "target_name": "Luxus", "similarity": 0.96}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "luxe", "target_book": "polyanthea_medicinal", "target_name": "luxuria", "similarity": 0.912}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Luxus", "target_book": "polyanthea_medicinal", "target_name": "luxuria", "similarity": 0.92}], "id": 753, "stable_key": "clu_8b8f07611c666a4c", "ground_truth": {"modern_name": "Luxury", "confidence": "high", "type": "concept", "note": "The Latin 'luxuria' can also mean 'excess' or 'licentiousness', but in the context of non-essential items and superfluity, 'luxury' is the most fitting modern equivalent.", "wikipedia_extract": "The Cadillac Urban Luxury Concept (ULC) is a gasoline-electric hybrid, 4-seater, city concept car manufactured by Cadillac and unveiled at the 2010 Los Angeles Auto Show. The ULC was designed by Niki Smart and features a signature wedge shaped styling cues from most of the Cadillac models of the 2000s. The ULC features touchpad screens and projected displays that take the place of traditional gauges. The ULC seats four adults, with access through a pair of scissor doors that extend outward and rotate forward when opened allowing easy access to all four seats. The ULC was powered by a 1.0L turbocharged 3-cylinder with 350kw electric power engine with a dual-clutch transmission and a hybrid propulsion system that employs electric assist technology, engine start-stop function, and brake energy regeneration. According to Cadillac, the ULC could potentially achieve 156 miles per US gallon (1.51 L/100 km; 187 mpg\u2011imp) in the city and 165 miles per US gallon (1.43 L/100 km; 198 mpg\u2011imp) on the highway.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cadillac_Urban_Luxury_Concept"}}, {"canonical_name": "campo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "campos", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Campos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Campos"], "contexts": ["geographic area"]}, {"entity_id": "campo", "book_id": "historia_medicinal_monardes_1574", "name": "campo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["campo"], "contexts": ["rural area for farming", "outdoor area"]}, {"entity_id": "campo", "book_id": "coloquios_da_orta_1563", "name": "campo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["campo"], "contexts": ["open area"]}, {"entity_id": "campos", "book_id": "coloquios_da_orta_1563", "name": "campos", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["campos"], "contexts": ["fields"]}, {"entity_id": "campo", "book_id": "polyanthea_medicinal", "name": "campo", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["campo"], "contexts": ["countryside"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Campos", "target_book": "coloquios_da_orta_1563", "target_name": "campos", "similarity": 0.733}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "campo", "target_book": "coloquios_da_orta_1563", "target_name": "campo", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "campo", "target_book": "polyanthea_medicinal", "target_name": "campo", "similarity": 0.8}, {"source_book": "coloquios_da_orta_1563", "source_name": "campo", "target_book": "polyanthea_medicinal", "target_name": "campo", "similarity": 0.8}, {"source_book": "coloquios_da_orta_1563", "source_name": "campos", "target_book": "polyanthea_medicinal", "target_name": "campo", "similarity": 0.926}], "id": 754, "stable_key": "clu_6c3175d749eaee2e", "ground_truth": {"modern_name": "countryside", "confidence": "high", "type": "place", "country": "Portugal", "wikidata_id": "Q578447", "wikidata_description": "city in Cook County, Illinois, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Countryside%2C%20Illinois", "wikipedia_extract": "Countryside is a city in Cook County, Illinois, United States. Per the 2020 census, the population was 6,420. The land where Countryside sits was originally inhabited by the Potawatomi Indians and later by early American pioneers in the beginning of the 19th century. Settler Joseph Vial and his family were among the first non-native people to settle in the Countryside area in 1833. The area remained large expanses of rural farmland until the Great Chicago Fire of 1871, when the fire sent thousands of city dwellers into what is now west suburban Chicago. Land sold for only $2 an acre, which made areas such as Countryside a welcome respite from the congestion and industry in Chicago."}}, {"canonical_name": "electrical machine", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "electrical_machine", "book_id": "principles_of_psychology_james_1890", "name": "electrical machine", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["electrical machine"], "contexts": ["device for generating electricity"]}, {"entity_id": "electrical_instruments", "book_id": "kosmos_humboldt_1845", "name": "electrical instruments", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["electrical instruments"], "contexts": ["devices for measuring electricity"]}, {"entity_id": "electrical_machine", "book_id": "connexion_physical_sciences_somerville_1858", "name": "electrical machine", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": [