target_book": "kosmos_humboldt_1845", "target_name": "roses", "similarity": 0.968}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "rosas", "target_book": "coloquios_da_orta_1563", "target_name": "rosas", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "rosas", "target_book": "polyanthea_medicinal", "target_name": "rosas", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "roses", "target_book": "coloquios_da_orta_1563", "target_name": "rosas", "similarity": 0.968}, {"source_book": "kosmos_humboldt_1845", "source_name": "roses", "target_book": "polyanthea_medicinal", "target_name": "rosas", "similarity": 0.968}, {"source_book": "coloquios_da_orta_1563", "source_name": "rosas", "target_book": "polyanthea_medicinal", "target_name": "rosas", "similarity": 1.0}], "id": 79, "stable_key": "clu_64f105484081b305", "ground_truth": {"modern_name": "Rosemary", "confidence": "high", "type": "plant", "linnaean": "Salvia rosmarinus", "family": "Lamiaceae", "description": "An aromatic herb used in cooking and medicine.", "note": "The variation in spelling ('rofmaninho' and 'rosmaninho') points to this herb.", "wikipedia_extract": "Salvia rosmarinus, synonym Rosmarinus officinalis, commonly known as rosemary, is a shrub with fragrant, evergreen, needle-like leaves and purple or sometimes white, pink, or blue flowers. It is a member of the sage family, Lamiaceae. The species is native to the Mediterranean region. It has a number of cultivars, and its leaves are commonly used as a flavoring. Rosemary has a fibrous root system. It forms an aromatic evergreen shrub with leaves similar to Tsuga needles."}}, {"canonical_name": "gravitation", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 5, "total_mentions": 78, "members": [{"entity_id": "gravitation", "book_id": "epoques_nature_buffon_1778", "name": "gravitation", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["gravitation"], "contexts": ["theory explaining earth's shape"]}, {"entity_id": "gravitation", "book_id": "principles_of_psychology_james_1890", "name": "gravitation", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["gravitation"], "contexts": ["force governing motion and position", "law of physical attraction"]}, {"entity_id": "gravitation", "book_id": "kosmos_humboldt_1845", "name": "gravitation", "category": "CONCEPT", "subcategory": "THEORY", "count": 8, "variants": ["gravitation"], "contexts": ["law governing celestial bodies", "law of attraction between masses"]}, {"entity_id": "gravitation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "gravitation", "category": "CONCEPT", "subcategory": "THEORY", "count": 53, "variants": ["gravitation", "Gravitation"], "contexts": ["fundamental force", "force attracting bodies"]}, {"entity_id": "gravitation", "book_id": "first_principles_spencer_1862", "name": "gravitation", "category": "CONCEPT", "subcategory": "THEORY", "count": 14, "variants": ["gravitation", "Gravitation"], "contexts": ["force of attraction between masses", "central force acting through space"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "gravitation", "target_book": "principles_of_psychology_james_1890", "target_name": "gravitation", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "gravitation", "target_book": "kosmos_humboldt_1845", "target_name": "gravitation", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "gravitation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gravitation", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "gravitation", "target_book": "first_principles_spencer_1862", "target_name": "gravitation", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "gravitation", "target_book": "kosmos_humboldt_1845", "target_name": "gravitation", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "gravitation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gravitation", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "gravitation", "target_book": "first_principles_spencer_1862", "target_name": "gravitation", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "gravitation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gravitation", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "gravitation", "target_book": "first_principles_spencer_1862", "target_name": "gravitation", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "gravitation", "target_book": "first_principles_spencer_1862", "target_name": "gravitation", "similarity": 1.0}], "id": 80, "stable_key": "clu_4af905639d656f13", "ground_truth": {"modern_name": "Gravity", "confidence": "high", "type": "concept", "wikidata_id": "Q11412", "wikidata_description": "fundamental interaction affecting all matter", "wikipedia_url": "https://en.wikipedia.org/wiki/Gravity", "note": "Early modern texts often referred to 'terrestrial attraction' or 'earth's attraction' when discussing gravity, particularly in relation to Isaac Newton's work.", "wikipedia_extract": "In physics, gravity (from Latin  gravitas 'weight'), also known as gravitation or a gravitational interaction, is a fundamental interaction, which may be described as the force that draws material objects towards each other. The gravitational attraction between clouds of primordial hydrogen and clumps of dark matter in the early universe caused the hydrogen gas to coalesce, eventually condensing and fusing to form stars. At larger scales this resulted in galaxies and clusters, so gravity is a primary driver for the large-scale structures in the universe. Gravity has an infinite range, although its effects become weaker as objects get farther away. Gravity is described by the general theory of relativity, proposed by Albert Einstein in 1915, which describes gravity in terms of the curvature of spacetime, caused by the uneven distribution of mass. The most extreme example of this curvature of spacetime is a black hole, from which nothing\u2014not even light\u2014can escape once past the black hole's event horizon."}}, {"canonical_name": "Pliny", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 5, "total_mentions": 77, "members": [{"entity_id": "pliny", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Pliny", "category": "PERSON", "subcategory": "AUTHORITY", "count": 37, "variants": ["Pliny"], "contexts": ["ancient author, likely Pliny the Elder", "Roman author of Natural History"]}, {"entity_id": "pliny", "book_id": "english_physician_1652", "name": "Pliny", "category": "PERSON", "subcategory": "AUTHORITY", "count": 21, "variants": ["Pliny", "Pliiny"], "contexts": ["ancient Roman author", "mentioned as a source for plant lore"]}, {"entity_id": "pliny", "book_id": "origin_of_species_darwin_1859", "name": "Pliny", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Pliny"], "contexts": ["Roman author on natural history", "ancient writer on animal breeding"]}, {"entity_id": "pliny", "book_id": "kosmos_humboldt_1845", "name": "Pliny", "category": "PERSON", "subcategory": "AUTHORITY", "count": 15, "variants": ["Pliny"], "contexts": ["Roman author and naturalist", "writer recording opinions of predecessors"]}, {"entity_id": "pliny", "book_id": "polyanthea_medicinal", "name": "Pliny", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Pliny"], "contexts": ["ancient authority on medicine"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Pliny", "target_book": "english_physician_1652", "target_name": "Pliny", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Pliny", "target_book": "origin_of_species_darwin_1859", "target_name": "Pliny", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Pliny", "target_book": "kosmos_humboldt_1845", "target_name": "Pliny", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Pliny", "target_book": "polyanthea_medicinal", "target_name": "Pliny", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Pliny", "target_book": "origin_of_species_darwin_1859", "target_name": "Pliny", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Pliny", "target_book": "kosmos_humboldt_1845", "target_name": "Pliny", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Pliny", "target_book": "polyanthea_medicinal", "target_name": "Pliny", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Pliny", "target_book": "kosmos_humboldt_1845", "target_name": "Pliny", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Pliny", "target_book": "polyanthea_medicinal", "target_name": "Pliny", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Pliny", "target_book": "polyanthea_medicinal", "target_name": "Pliny", "similarity": 1.0}], "id": 81, "stable_key": "clu_75041dcbcc428b45-2", "ground_truth": {"modern_name": "Pliny the Elder", "confidence": "high", "type": "person", "birth_year": 23, "death_year": 79, "description": "Roman author and naturalist, known for Naturalis Historia.", "wikidata_id": "Q58340224", "wikidata_description": "scholarly article by John F. Healy published January 1981 in Interdisciplinary Science Reviews"}}, {"canonical_name": "ideas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 74, "members": [{"entity_i