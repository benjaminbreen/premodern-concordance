3303", "wikidata_description": "river in Australia"}}, {"canonical_name": "A\u00e7ores", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "a\u00e7ores", "book_id": "epoques_nature_buffon_1778", "name": "A\u00e7ores", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["A\u00e7ores"], "contexts": ["islands in the Atlantic Ocean", "islands potentially joining Canada and Spain"]}, {"entity_id": "iles_a\u00e7ores", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Iles A\u00e7ores", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Iles A\u00e7ores"], "contexts": ["islands near where Gulf-stream moves"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "A\u00e7ores", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Iles A\u00e7ores", "similarity": 0.951}], "id": 4461, "stable_key": "clu_149199efd1a4d983", "ground_truth": {"modern_name": "Azores", "confidence": "high", "type": "place", "country": "Portugal", "wikidata_id": "Q25263", "wikidata_description": "Atlantic Ocean archipelago and autonomous region of Portugal", "wikipedia_url": "https://en.wikipedia.org/wiki/Azores"}}, {"canonical_name": "graines", "category": "PLANT", "subcategory": "SEED", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "graines", "book_id": "epoques_nature_buffon_1778", "name": "graines", "category": "PLANT", "subcategory": "SEED", "count": 2, "variants": ["graines"], "contexts": ["embryonic plant", "seeds adapted for dispersion"]}, {"entity_id": "granos", "book_id": "historia_medicinal_monardes_1574", "name": "granos", "category": "PLANT", "subcategory": "SEED", "count": 1, "variants": ["granos"], "contexts": ["seeds within the fruit"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "graines", "target_book": "historia_medicinal_monardes_1574", "target_name": "granos", "similarity": 0.962}], "id": 4462, "stable_key": "clu_7e6b6c79b1a5e0ed", "ground_truth": {"modern_name": "Seeds", "confidence": "high", "type": "plant", "wikidata_id": "Q40763", "wikidata_description": "embryonic plant enclosed in a protective outer covering (seed coat)", "wikipedia_url": "https://en.wikipedia.org/wiki/Seed"}}, {"canonical_name": "Cor\u00e9e", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cor\u00e9e", "book_id": "epoques_nature_buffon_1778", "name": "Cor\u00e9e", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Cor\u00e9e"], "contexts": ["country with inland seas", "peninsula in East Asia"]}, {"entity_id": "cor\u00e9e", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cor\u00e9e", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Cor\u00e9e"], "contexts": ["country excluded from Tartary"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Cor\u00e9e", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Cor\u00e9e", "similarity": 0.905}], "id": 4463, "stable_key": "clu_d4b204e7ad8b1208", "ground_truth": {"modern_name": "Korea", "confidence": "high", "type": "place", "country": "South Korea, North Korea", "wikipedia_extract": "The history of North Korea began with the end of World War II in 1945. The surrender of Japan led to the division of Korea at the 38th parallel, with the Soviet Union occupying the north, and the United States occupying the south. The Soviet Union and the United States failed to agree on a way to unify the country, and in 1948, they established two separate governments \u2014 the Soviet-aligned Democratic People's Republic of Korea and the American-aligned Republic of Korea \u2014 each claiming to be the legitimate government of all of Korea. In 1950, the Korean War broke out. After much destruction, the war ended with a stalemate. The division at the 38th parallel was replaced by the Korean Demilitarized Zone.", "wikipedia_url": "https://en.wikipedia.org/wiki/History_of_North_Korea"}}, {"canonical_name": "Guiane", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "guiane", "book_id": "epoques_nature_buffon_1778", "name": "Guiane", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Guiane"], "contexts": ["immense extent of lands", "region where forests are cut"]}, {"entity_id": "guiana", "book_id": "first_principles_spencer_1862", "name": "Guiana", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Guiana"], "contexts": ["location of Humboldt's observations"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Guiane", "target_book": "first_principles_spencer_1862", "target_name": "Guiana", "similarity": 0.987}], "id": 4464, "stable_key": "clu_d76d822939bee704", "ground_truth": {"modern_name": "Guiana", "confidence": "high", "type": "place", "country": "Guyana", "wikidata_id": "Q1931753", "wikidata_description": "genus of fishes", "wikipedia_url": "https://en.wikipedia.org/wiki/Guianacara"}}, {"canonical_name": "fazer", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "faire", "book_id": "epoques_nature_buffon_1778", "name": "faire", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["faire"], "contexts": ["to produce or make"]}, {"entity_id": "fazer", "book_id": "polyanthea_medicinal", "name": "fazer", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["fazer", "fazer fahir"], "contexts": ["to make, to do", "to make something come out"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "faire", "target_book": "polyanthea_medicinal", "target_name": "fazer", "similarity": 0.914}], "id": 4465, "stable_key": "clu_27d7fbb4af07c7a3", "ground_truth": {"modern_name": "practice", "confidence": "high", "type": "concept", "note": "The terms 'fazer' (Portuguese) and 'faire' (French) in this context refer to the act of performing or undertaking an action, which translates to the general concept of 'practice' in English. This could encompass medical practices, philosophical practices, or scientific practices depending on the surrounding text.", "wikidata_id": "Q1751775", "wikidata_description": "practice performance", "wikipedia_url": "https://en.wikipedia.org/wiki/Rehearsal"}}, {"canonical_name": "peuple", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "peuple", "book_id": "epoques_nature_buffon_1778", "name": "peuple", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["peuple"], "contexts": ["common people, not learned"]}, {"entity_id": "peuples", "book_id": "epoques_nature_buffon_1778", "name": "peuples", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["peuples"], "contexts": ["peoples brought closer by human art"]}, {"entity_id": "peuples", "book_id": "relation_historique_humboldt_vol3_1825", "name": "peuples", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["peuples"], "contexts": ["groups of people"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "peuple", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "peuples", "similarity": 0.946}, {"source_book": "epoques_nature_buffon_1778", "source_name": "peuples", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "peuples", "similarity": 1.0}], "id": 4466, "stable_key": "clu_f11a0c4b5b3040f7", "ground_truth": {"modern_name": "people", "confidence": "high", "type": "concept", "note": "The terms 'peuple' and 'peuples' (French) refer to populations or groups of humans, as opposed to specific individuals. In a scientific or medical context, this can refer to populations under study or general human groups.", "wikidata_id": "Q5", "wikidata_description": "any single member of Homo sapiens, unique extant species of the genus Homo", "wikipedia_url": "https://en.wikipedia.org/wiki/Human"}}, {"canonical_name": "latitudes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "latitudes", "book_id": "epoques_nature_buffon_1778", "name": "latitudes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["latitudes"], "contexts": ["geographic coordinate related to temperature"]}, {"entity_id": "latitudes", "book_id": "kosmos_humboldt_1845", "name": "latitudes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["latitudes"], "contexts": ["geographic coordinate system", "geographic divisions affecting heat absorption"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "latitudes", "target_book": "kosmos_humboldt_1845", "target_name": "latitudes", "similarity": 1.0}], "id": 4467, "stable_key": "clu_181299ddb21abc71-2", "ground_truth": {"modern_name": "Latitude", "confidence": "high", "type": "concept", "wikidata_id": "Q34027", "wikidata_description": "angle between zenith and a plane parallel to the equator", "wikipedia_url": "https://en.wikipedia.org/wiki/Latitude", "wikipedia_extract": "In geography, latitude is a geographic coordinate that specifies the north-south position of a point on the surface of the Earth or another celestial body. Latitude is given as an angle that ranges from \u221290\u00b0 at the south pole to 90\u00b0 at the north pole, with 0\u00b0 at the Equator. Lines of constant latitude, or parallels, run east-west as circles parallel to the equator. Latitude and longitude are used together as a coordinate pair to specify a location on the surface of the Earth. On its own, the term latitude normally refers to the geodetic latitude as defined below. Briefly, the geodetic latitude of a point is the angle formed between the vector perpendicular (or normal) to the ellipsoidal surface from the point, and the plane of the equator."}}, {"canonical_name": "roche schisteuse", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "schistes_argileux", "book_id": "epoques_nature_buffon_1778", "name": "schistes argileux", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["schistes argileux"], "contexts": ["rock type with animal origin"]}, {"entity_id": "roche_schisteuse", "book_id": "relation_historique_humboldt_vol3_1825", "name": "roche schisteuse", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["roche schisteuse"], "contexts": ["schistose rock", "rock formation described"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "schistes argileux", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "roche schisteuse", "similarity": 0.901}], "id": 4468, "stable_key": "clu_e287e9f54162981f", "ground_truth": {"modern_name": "schist", "confidence": "high", "type": "mineral", "note": "Both 'schistes argileux' (French) and 'roche schisteuse' (French) refer to types of metamorphic rock, specifically schist, which is characterized by its layered structure. 'Argileux' indicates it is clay-rich schist.", "wikidata_id": "Q281634", "wikidata_description": "species of insect", "wikipedia_url": "https://en.wikipedia.org/wiki/Desert%20locust"}}, {"canonical_name": "Normandie", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "normandie", "book_id": "epoques_nature_buffon_1778", "name": "Normandie", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Normandie"], "contexts": ["coastal region with sediment deposition"]}, {"entity_id": "normandie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Normandie", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Normandie"], "contexts": ["region in France suitable for sugar beet", "region with barometric height"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Normandie", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Normandie", "similarity": 1.0}], "id": 4469, "stable_key": "clu_1e46cbde73c9e816", "ground_truth": {"modern_name": "Normandy", "confidence": "high", "type": "place", "country": "France", "note": "Normandie is the French name for the historical and administrative region of Normandy in northern France.", "wikidata_id": "Q15878", "wikidata_description": "geographical and cultural region which extends over a part of France and the British Channel Islands", "wikipedia_url": "https://en.wikipedia.org/wiki/Normandy"}}, {"canonical_name": "place", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "lieu", "book_id": "epoques_nature_buffon_1778", "name": "lieu", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["lieu"], "contexts": ["geographic locations"]}, {"entity_id": "place", "book_id": "first_principles_spencer_1862", "name": "place", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["place"], "contexts": ["location or position", "location"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "lieu", "target_book": "first_principles_spencer_1862", "target_name": "place", "similarity": 0.957}], "id": 4470, "stable_key": "clu_06fd74b17df570d1", "ground_truth": {"modern_name": "place", "confidence": "high", "type": "concept", "note": "The terms 'lieu' (French) and 'place' (English) in these contexts refer to general geographic locations or a specific spot or position.", "wikidata_id": "Q7200212", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Place%20%28surname%29"}}, {"canonical_name": "h\u00e9misph\u00e8re septentrional", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "h\u00e9misph\u00e8re_septentrional", "book_id": "epoques_nature_buffon_1778", "name": "h\u00e9misph\u00e8re septentrional", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["h\u00e9misph\u00e8re septentrional"], "contexts": ["Northern half of the Earth"]}, {"entity_id": "northern_hemisphere", "book_id": "first_principles_spencer_1862", "name": "northern hemisphere", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["northern hemisphere"], "contexts": ["upper half of a planet"]}, {"entity_id": "southern_hemisphere", "book_id": "first_principles_spencer_1862", "name": "southern hemisphere", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["southern hemisphere"], "contexts": ["lower half of a planet"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "h\u00e9misph\u00e8re septentrional", "target_book": "first_principles_spencer_1862", "target_name": "northern hemisphere", "similarity": 0.909}, {"source_book": "epoques_nature_buffon_1778", "source_name": "h\u00e9misph\u00e8re septentrional", "target_book": "first_principles_spencer_1862", "target_name": "southern hemisphere", "similarity": 0.931}], "id": 4471, "stable_key": "clu_c130d45672bfc40a-2", "ground_truth": {"modern_name": "Hemisphere", "confidence": "high", "type": "concept", "note": "The context describes geographical hemispheres and anatomical hemispheres. 'Hemisphere' is a general term applicable to both.", "wikidata_id": "Q399984", "wikidata_description": "bipartite divisions of Earth", "wikipedia_url": "https://en.wikipedia.org/wiki/Hemispheres%20of%20Earth", "wikipedia_extract": "In geography and cartography, hemispheres of Earth are any division of the globe into two equal halves (hemispheres), typically divided into northern and southern halves by the Equator and into western and eastern halves by the Prime meridian. Hemispheres can be divided geographically or culturally, or based on religion or prominent geographic features. Use of these divisions is applied when studying Earth's geographic distribution, cultural differences, and other geographic, demographic and socioeconomic features. Geographical hemispheres are primarily split by latitudinal (north-south) and longitudinal (east-west) markers: Alternative Earth hemispheres can divide the globe along cultural or religious lines, or be used to maximize the prominence of geographic features. For example: Geographical feature-based hemispheres Alternative hemisphere schemes can divide the planet in a way that maximizes the prominence of one geographic feature or another in each division, such as the land-water division: Land Hemisphere: Centered near 47\u00b0N, 1\u00b0E, near the city of Nantes, France, this hemisphere contains the largest possible area of land, including most of the world's continents and major landmasses. Water Hemisphere: Centered near 47\u00b0S, 179\u00b0W, in the South Pacific Ocean, this hemisphere contains the largest possible area of water, including most of the Indian, Pacific, and Southern Oceans."}}, {"canonical_name": "Bic\u00eatre", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "bic\u00eatre", "book_id": "epoques_nature_buffon_1778", "name": "Bic\u00eatre", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Bic\u00eatre"], "contexts": ["location of wells"]}, {"entity_id": "bic\u00eatre", "book_id": "principles_of_psychology_james_1890", "name": "Bic\u00eatre", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Bic\u00eatre"], "contexts": ["hospital where Louis V. was treated", "hospital where patient was treated"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Bic\u00eatre", "target_book": "principles_of_psychology_james_1890", "target_name": "Bic\u00eatre", "similarity": 1.0}], "id": 4472, "stable_key": "clu_b9d66426d2d9edf2", "ground_truth": {"modern_name": "Bic\u00eatre", "confidence": "high", "type": "place", "country": "France", "note": "Bic\u00eatre refers to the H\u00f4pital de Bic\u00eatre, a historically significant hospital and asylum in the Paris region, known for its medical research and treatment of various conditions.", "wikidata_id": "Q25478742", "wikidata_description": "Paris metro station"}}, {"canonical_name": "interior of the earth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "entrailles_de_la_terre", "book_id": "epoques_nature_buffon_1778", "name": "entrailles de la terre", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["entrailles de la terre"], "contexts": ["interior of the earth"]}, {"entity_id": "interior_of_the_earth", "book_id": "kosmos_humboldt_1845", "name": "interior of the earth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["interior of the earth", "interior of the Earth"], "contexts": ["deepest parts of the planet", "internal structure of the Earth"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "entrailles de la terre", "target_book": "kosmos_humboldt_1845", "target_name": "interior of the earth", "similarity": 0.903}], "id": 4473, "stable_key": "clu_1f2a8c01a5f032aa", "ground_truth": {"modern_name": "interior of the Earth", "confidence": "high", "type": "concept", "note": "The phrases 'entrailles de la terre' (French) and 'interior of the earth' (English) both denote the inner regions of the planet, often discussed in geological or cosmological contexts.", "wikidata_id": "Q61031870", "wikidata_description": "scholarly article by E. A. HODGSON published 1 July 1942 in Geological Society of America Bulletin"}}, {"canonical_name": "pyramides \u00e9gyptiennes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pyramides_d\u2019\u00e9gypte", "book_id": "epoques_nature_buffon_1778", "name": "pyramides d\u2019\u00c9gypte", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["pyramides d\u2019\u00c9gypte"], "contexts": ["ancient monuments in Egypt"]}, {"entity_id": "pyramides_\u00e9gyptiennes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pyramides \u00e9gyptiennes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["pyramides \u00e9gyptiennes", "pyramides mexicaines"], "contexts": ["ancient Egyptian structures", "ancient Mexican structures"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "pyramides d\u2019\u00c9gypte", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "pyramides \u00e9gyptiennes", "similarity": 0.988}], "id": 4474, "stable_key": "clu_f6621c08e54ad07c", "ground_truth": {"modern_name": "Egyptian pyramids", "confidence": "high", "type": "object", "note": "The terms 'pyramides d\u2019\u00c9gypte' (French) and 'pyramides \u00e9gyptiennes' (French) clearly refer to the ancient monumental structures in Egypt.", "wikidata_id": "Q175582", "wikidata_description": "ancient masonry structures constructed by ancient Egyptians"}}, {"canonical_name": "Tartarie", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tartarie_centrale", "book_id": "epoques_nature_buffon_1778", "name": "Tartarie centrale", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Tartarie centrale"], "contexts": ["region in Central Asia"]}, {"entity_id": "tartarie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tartarie", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Tartarie", "Tarentaise"], "contexts": ["region excluding Tibet and Korea", "valley in the French Alps"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Tartarie centrale", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Tartarie", "similarity": 0.91}], "id": 4475, "stable_key": "clu_c67bb2628f58afab-2", "ground_truth": {"modern_name": "Tartary", "confidence": "high", "type": "place", "description": "Historical region in Central and Northern Asia.", "note": "Refers to a vast historical region, often vaguely defined, in Central and Northern Asia.", "wikipedia_extract": "Tartary (Latin: Tartaria; French: Tartarie; German: Tartarei; Russian: \u0422\u0430\u0440\u0442\u0430\u0440\u0438\u044f, romanized: Tartariya) or Tatary (Russian: \u0422\u0430\u0442\u0430\u0440\u0438\u044f, romanized: Tatariya) was a blanket term used in Western European literature and cartography for a vast part of Asia bounded by the Caspian Sea, the Ural Mountains, the Pacific Ocean, and the northern borders of China, India, and Persia, at a time when this region was largely unknown to European geographers. The active use of the toponym (place name) can be traced from the 13th to the 19th centuries. In European sources, Tartary became the most common name for Central Asia that had no connection with the real polities or ethnic groups of the region; until the 19th century, European knowledge of the area remained extremely scarce and fragmentary. In modern English-speaking tradition, the region formerly known as Tartary is usually called Inner Asia or Central Eurasia. Much of this area consists of arid plains, the main nomadic population of which in the past was engaged in animal husbandry. Ignorance surrounding Tartary's use as a place name has spawned pseudohistoric conspiracy theories including ideas of a \"hidden past\" and \"mud floods\"."}}, {"canonical_name": "magnetic currents", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "courants_magn\u00e9tiques", "book_id": "epoques_nature_buffon_1778", "name": "courants magn\u00e9tiques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["courants magn\u00e9tiques"], "contexts": ["magnetic flows"]}, {"entity_id": "magnetic_currents", "book_id": "kosmos_humboldt_1845", "name": "magnetic currents", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["magnetic currents"], "contexts": ["changes of temperature call forth", "hypothesized flow of magnetic force"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "courants magn\u00e9tiques", "target_book": "kosmos_humboldt_1845", "target_name": "magnetic currents", "similarity": 0.903}], "id": 4476, "stable_key": "clu_5e75b53cc1fe0882", "ground_truth": {"modern_name": "Magnetic field", "confidence": "high", "type": "concept", "wikidata_id": "Q11408", "wikidata_description": "spatial distribution of vectors allowing the calculation of the magnetic force on a test particle", "wikipedia_url": "https://en.wikipedia.org/wiki/Magnetic%20field"}}, {"canonical_name": "Illinois", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "illinois", "book_id": "epoques_nature_buffon_1778", "name": "Illinois", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Illinois"], "contexts": ["region in North America with elephant remains"]}, {"entity_id": "illinois", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Illinois", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Illinois"], "contexts": ["state north of the Obio river", "state in the United States"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Illinois", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Illinois", "similarity": 1.0}], "id": 4477, "stable_key": "clu_eabad23e37d770ba", "ground_truth": {"modern_name": "Illinois", "confidence": "high", "type": "place", "country": "United States", "wikidata_id": "Q1204", "wikidata_description": "state of the United States of America", "wikipedia_url": "https://en.wikipedia.org/wiki/Illinois"}}, {"canonical_name": "Adriatic Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "golfe_adriatique", "book_id": "epoques_nature_buffon_1778", "name": "golfe Adriatique", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["golfe Adriatique"], "contexts": ["northernmost part of the Mediterranean Sea"]}, {"entity_id": "adriatic_sea", "book_id": "kosmos_humboldt_1845", "name": "Adriatic Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Adriatic Sea"], "contexts": ["sea with fissures and specific direction", "sea between Italy and the Balkans"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "golfe Adriatique", "target_book": "kosmos_humboldt_1845", "target_name": "Adriatic Sea", "similarity": 0.913}], "id": 4478, "stable_key": "clu_565afd10ee46237a", "ground_truth": {"modern_name": "Adriatic Sea", "confidence": "high", "type": "place", "country": "Italy", "wikidata_id": "Q13924", "wikidata_description": "body of water between the Italian Peninsula and the Balkan Peninsula", "wikipedia_url": "https://en.wikipedia.org/wiki/Adriatic%20Sea"}}, {"canonical_name": "New Guinea", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "new_guinea", "book_id": "kosmos_humboldt_1845", "name": "New Guinea", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["New Guinea"], "contexts": ["highland near Rawak", "island near Rawak"]}, {"entity_id": "new_guinea", "book_id": "first_principles_spencer_1862", "name": "New Guinea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["New Guinea"], "contexts": ["island in Oceania"]}], "edges": [