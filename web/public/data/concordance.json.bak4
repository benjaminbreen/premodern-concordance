"category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["glandes"], "contexts": ["organs producing and secreting substances", "glands"]}, {"entity_id": "glande", "book_id": "medecine_experimentale_bernard_1865", "name": "glande", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["glande"], "contexts": ["organ producing secretions"]}, {"entity_id": "glandulathymo", "book_id": "polyanthea_medicinal", "name": "glandulaThymo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["glandulaThymo"], "contexts": ["Thymus gland"]}, {"entity_id": "glande", "book_id": "polyanthea_medicinal", "name": "glande", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["glande"], "contexts": ["glans"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "glandes", "target_book": "polyanthea_medicinal", "target_name": "glandulaThymo", "similarity": 0.914}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "glandes", "target_book": "polyanthea_medicinal", "target_name": "glande", "similarity": 0.973}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "glande", "target_book": "polyanthea_medicinal", "target_name": "glandulaThymo", "similarity": 0.929}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "glande", "target_book": "polyanthea_medicinal", "target_name": "glande", "similarity": 1.0}], "id": 3327, "stable_key": "clu_a1cb9598bad7d4b2", "ground_truth": {"modern_name": "Glands", "confidence": "high", "type": "object", "note": "Includes both the general term 'glandes' and specific references like 'glande' and potentially 'glandulaThymo' (likely an archaic form related to thymus gland).", "wikidata_id": "Q9647", "wikidata_description": "type of animal organ", "wikipedia_url": "https://en.wikipedia.org/wiki/Gland"}}, {"canonical_name": "Geologie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "g\u00e9ologie", "book_id": "medecine_experimentale_bernard_1865", "name": "g\u00e9ologie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["g\u00e9ologie"], "contexts": ["study of the Earth", "science of the Earth"]}, {"entity_id": "geologie", "book_id": "kosmos_humboldt_1845", "name": "Geologie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Geologie"], "contexts": ["book title", "book title on geology"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "g\u00e9ologie", "target_book": "kosmos_humboldt_1845", "target_name": "Geologie", "similarity": 0.958}], "id": 3328, "stable_key": "clu_cca7badc2a4ee24a-3", "ground_truth": {"modern_name": "Geology", "confidence": "high", "type": "concept", "wikidata_id": "Q1069", "wikidata_description": "study of the composition, structure, physical properties, and history of Earth's components, and the processes by which they are shaped", "wikipedia_url": "https://en.wikipedia.org/wiki/Geology", "wikipedia_extract": "Geology is a branch of natural science concerned with the Earth and other astronomical bodies, the rocks of which they are composed, and the processes by which they change over time. The name comes from Ancient Greek  \u03b3\u1fc6 (g\u00ea) 'earth' and  \u03bbo\u03b3\u03af\u03b1 (-log\u00eda) 'study of, discourse'. Modern geology significantly overlaps all other Earth sciences, including hydrology. It is integrated with Earth system science and planetary science. Geology describes the structure of the Earth on and beneath its surface and the processes that have shaped that structure. Geologists study the mineralogical composition of rocks in order to get insight into their history of formation."}}, {"canonical_name": "nerve-substance", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "\u00e9l\u00e9ment_nerveux", "book_id": "medecine_experimentale_bernard_1865", "name": "\u00e9l\u00e9ment nerveux", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["\u00e9l\u00e9ment nerveux"], "contexts": ["basic unit of nervous system"]}, {"entity_id": "nerve-substance", "book_id": "principles_of_psychology_james_1890", "name": "nerve-substance", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["nerve-substance"], "contexts": ["tissue of the nervous system", "material composing nerves"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "\u00e9l\u00e9ment nerveux", "target_book": "principles_of_psychology_james_1890", "target_name": "nerve-substance", "similarity": 0.958}], "id": 3329, "stable_key": "clu_09f3dc47310c104f", "ground_truth": {"modern_name": "Nervous tissue", "confidence": "high", "type": "concept", "note": "Refers to the fundamental material of the nervous system, encompassing both cellular and extracellular components.", "wikidata_id": "Q6996973", "wikidata_description": "human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Nervous%20system%20disease"}}, {"canonical_name": "Alteratione", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "alt\u00e9ration_pathologique", "book_id": "medecine_experimentale_bernard_1865", "name": "alt\u00e9ration pathologique", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["alt\u00e9ration pathologique"], "contexts": ["abnormal physical change due to disease"]}, {"entity_id": "alt\u00e9rations_pathologiques", "book_id": "medecine_experimentale_bernard_1865", "name": "alt\u00e9rations pathologiques", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["alt\u00e9rations pathologiques"], "contexts": ["pathological changes in bodily fluids"]}, {"entity_id": "alteratione", "book_id": "po