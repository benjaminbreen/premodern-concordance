national", "note": "The text includes references to both 'Antarctic Ocean' and 'Arctic Seas'. Given the context of naval expeditions and marine life ('Diatomaceae'), it is most likely referring to the Southern Ocean, though the mention of 'Arctic Seas' introduces some ambiguity.", "wikidata_id": "Q117082685", "wikidata_description": "fishing vessel built in 1997"}}, {"canonical_name": "dientes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "dientes", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "dientes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 11, "variants": ["dientes"], "contexts": ["teeth pains mitigated by the seed", "body part that is tightened"]}, {"entity_id": "dientes", "book_id": "historia_medicinal_monardes_1574", "name": "dientes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["dientes"], "contexts": ["prevents teeth from falling out", "teeth"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "dientes", "target_book": "historia_medicinal_monardes_1574", "target_name": "dientes", "similarity": 1.0}], "id": 2543, "stable_key": "clu_8a267e63a8b13bae", "ground_truth": {"modern_name": "teeth", "confidence": "high", "type": "concept", "note": "Refers to anatomical structures used in a medicinal context.", "wikidata_id": "Q1545761", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Grevillea"}}, {"canonical_name": "planta", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "planta", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "planta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 10, "variants": ["planta"], "contexts": ["plant", "this plant and its virtues"]}, {"entity_id": "planta", "book_id": "coloquios_da_orta_1563", "name": "planta", "category": "