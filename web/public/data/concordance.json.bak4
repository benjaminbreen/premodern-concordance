kosmos_humboldt_1845", "target_name": "rats", "similarity": 0.989}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "rats", "target_book": "principles_of_psychology_james_1890", "target_name": "Rats", "similarity": 0.989}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "rats", "target_book": "kosmos_humboldt_1845", "target_name": "rats", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Rats", "target_book": "kosmos_humboldt_1845", "target_name": "rats", "similarity": 0.989}, {"source_book": "english_physician_1652", "source_name": "Rats", "target_book": "coloquios_da_orta_1563", "target_name": "ratos", "similarity": 0.939}], "id": 28, "stable_key": "clu_c733a7a249eccbf8", "ground_truth": {"modern_name": "Rats", "confidence": "high", "type": "animal", "description": "Vermin, larger rodents, sometimes seen as pests or omens.", "wikipedia_extract": "Rats are various medium-sized, long-tailed rodents. Species of rats are found throughout the order Rodentia, but stereotypical rats are found in the genus Rattus. Other rat genera include Neotoma (pack rats), Bandicota (bandicoot rats) and Dipodomys (kangaroo rats). Rats are typically distinguished from mice by their size. Usually the common name of a large muroid rodent will include the word \"rat\", while a smaller muroid's name will include \"mouse\". The common terms rat and mouse are not taxonomically specific."}}, {"canonical_name": "species", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 6, "total_mentions": 214, "members": [{"entity_id": "species", "book_id": "origin_of_species_darwin_1859", "name": "species", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 191, "variants": ["species", "Species"], "contexts": ["fundamental unit of biological classification", "biological classification unit"]}, {"entity_id": "species", "book_id": "kosmos_humboldt_1845", "name": "species", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["species"], "contexts": ["fundamental unit of biological classification", "biological classification"]}, {"entity_id": "species", "book_id": "connexion_physical_sciences_somerville_1858", "name": "species", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Species", "species"], "contexts": ["biological classification unit", "unit of biological classification"]}, {"entity_id": "species", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "species", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["species"], "contexts": ["mental representations of things", "biological classification"]}, {"entity_id": "species", "book_id": "principles_of_psychology_james_1890", "name": "species", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["species"], "contexts": ["group of organisms capable of interbreeding", "kind or sort of pain"]}, {"entity_id": "species", "book_id": "first_principles_spencer_1862", "name": "species", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 10, "variants": ["species"], "contexts": ["group of organisms capable of interbreeding", "fundamental unit of classification"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "species", "target_book": "kosmos_humboldt_1845", "target_name": "species", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "species", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "species", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "species", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "species", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "species", "target_book": "principles_of_psychology_james_1890", "target_name": "species", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "species", "target_book": "first_principles_spencer_1862", "target_name": "species", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "species", "target_book": "first_principles_spencer_1862", "target_name": "species", "similarity": 1.0}], "id": 29, "stable_key": "clu_e49294c158292789", "ground_truth": {"modern_name": "Species", "confidence": "high", "type": "concept", "note": "Refers to both biological classification and a broader sense of kind or type.", "wikidata_id": "Q13679", "wikidata_description": "free multilingual online species directory", "wikipedia_url": "https://en.wikipedia.org/wiki/Species", "wikipedia_extract": "A species (pl. species) is the basic unit of classification and a taxonomic rank of an organism, as well as a unit of biodiversity. It can be defined as the largest group of organisms in which any two individuals of the appropriate sexes or mating types can produce fertile offspring, typically by sexual reproduction. Other ways of defining species include their karyotype, DNA sequence, morphology, behaviour, or ecological niche. In addition, palaeontologists use the concept of the chronospecies since fossil reproduction cannot be examined. The most recent rigorous estimate for the total number of species of eukaryotes is between 8 and 8.7 million."}}, {"canonical_name": "Portugal", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 6, "total_mentions": 166, "members": [{"entity_id": "portugal", "book_id": "kosmos_humboldt_1845", "name": "Portugal", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Portugal"], "contexts": ["European nation", "country where myrtle blooms"]}, {"entity_id": "portugal", "book_id": "coloquios_da_orta_1563", "name": "Portugal", "category": "PLACE", "subcategory": "COUNTRY", "count": 123, "variants": ["Portugal", "Portu-gal", "PortugaL", "Portugall"], "contexts": ["country where certain terms are used", "destination for substances"]}, {"entity_id": "portugal", "book_id": "polyanthea_medicinal", "name": "Portugal", "category": "PLACE", "subcategory": "COUNTRY", "count": 35, "variants": ["Portugal", "Portuguez", "Portugueza"], "contexts": ["country where author wished to use remedy advertising", "country ruled by D. Pedro II."]}, {"entity_id": "portugal", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Portugal", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Portugal"], "contexts": ["country where plant is transported", "country for plant transport"]}, {"entity_id": "portugal", "book_id": "historia_medicinal_monardes_1574", "name": "Portugal", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Portugal"], "contexts": ["Portugal, where these animals are found", "country of origin for travelers"]}, {"entity_id": "portugal", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Portugal", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Portugal"], "contexts": ["country whose plants are found in Madeira"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Portugal", "target_book": "coloquios_da_orta_1563", "target_name": "Portugal", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Portugal", "target_book": "polyanthea_medicinal", "target_name": "Portugal", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Portugal", "target_book": "polyanthea_medicinal", "target_name": "Portugal", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Portugal", "target_book": "historia_medicinal_monardes_1574", "target_name": "Portugal", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Portugal", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Portugal", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Portugal", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Portugal", "similarity": 1.0}], "id": 30, "stable_key": "clu_c5b76ddf01e76865", "ground_truth": {"modern_name": "Portugal", "confidence": "high", "type": "place", "description": "A country in Southwestern Europe.", "wikipedia_extract": "Portugal, officially the Portuguese Republic, is a country on the Iberian Peninsula in Southwestern Europe. It is a unitary republic made up by mainland Portugal and two autonomous regions, with Lisbon as both its capital and largest city. The mainland is bordered by Spain to the north and east, with Madeira and the Azores in the Atlantic Ocean. It features the westernmost point in continental Europe. The western Iberian Peninsula has been inhabited since prehistory, with the earliest signs of settlement dating to 5500 BC. Muslims invaded the Iberian Peninsula in the 8th century, but were gradually expelled during the Reconquista."}}, {"canonical_name": "Science", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 6, "total_mentions": 120, "members": [{"entity_id": "science", "book_id": "principles_of_psychology_james_1890", "name": "Science", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["science", "Science"], "contexts": ["journal where method was published", "Systematic study of the natural world"]}, {"entity_id": "science", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Science", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["Science", "SCIENCE", "science"], "contexts": ["pursuit of truth and knowledge", "history marked by chemical discoveries"]}, {"entity_id": "science", "book_id": "first_principles_spencer_1862", "name": "Science", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 55, "variants": ["science", "Science", "SCIENCE"], "contexts": ["field of knowledge", "systematic knowledge and its advance"]}, {"entity_id": "science", "book_id": "medecine_experimentale_bernard_1865", "name": "science", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 37, "variants": ["science"], "contexts": ["science", "systematic study of the natural world"]}, {"entity_id": "science", "book_id": "epoques_nature_buffon_1778", "name": "science", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["science"], "contexts": ["systematic knowledge and study", "systematic knowledge"]}, {"entity_id": "science", "book_id": "kosmos_humboldt_1845", "name": "science", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["science"], "contexts": ["branch of science", "several departments of study"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Science", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Science", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Science", "target_book": "first_principles_spencer_1862", "target_name": "Science", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Science", "target_book": "first_principles_spencer_1862", "target_name": "Science", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "science", "target_book": "epoques_nature_buffon_1778", "target_name": "science", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "science", "target_book": "kosmos_humboldt_1845", "target_name": "science", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "science", "target_book": "kosmos_humboldt_1845", "target_name": "science", "similarity": 1.0}], "id": 31, "stable_key": "clu_79fe05a882918e5d", "ground_truth": {"modern_name": "Science", "confidence": "high", "type": "concept", "wikidata_id": "Q336", "wikidata_d