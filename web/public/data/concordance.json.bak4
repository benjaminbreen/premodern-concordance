dodoxia_epidemica_browne_1646", "source_name": "North", "target_book": "kosmos_humboldt_1845", "target_name": "northern regions", "similarity": 0.908}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "North", "target_book": "coloquios_da_orta_1563", "target_name": "norte", "similarity": 0.941}, {"source_book": "kosmos_humboldt_1845", "source_name": "northern regions", "target_book": "coloquios_da_orta_1563", "target_name": "norte", "similarity": 0.901}], "id": 1329, "stable_key": "clu_d0beb8636b67940a-2", "ground_truth": {"modern_name": "North", "confidence": "high", "type": "concept", "note": "While it can refer to a geographic area, the primary usage here is as a directional concept.", "wikidata_id": "Q7055132", "wikidata_description": "island in Queensland, Australia", "wikipedia_url": "https://en.wikipedia.org/wiki/North%20Direction%20Island", "wikipedia_extract": "North Direction Island is an island in the offshore locality of Lizard in the Shire of Cook, Queensland, Australia. It is 25 km north-east of Cape Flattery in the Great Barrier Reef Marine Park Authority and about 15 km south of Lizard Island. It is around 51 hectares or 0.51 square km in size."}}, {"canonical_name": "Tin", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "tin", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Tin", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["Tin"], "contexts": ["metallic element", "dissolved by aqua fortis"]}, {"entity_id": "tin", "book_id": "kosmos_humboldt_1845", "name": "tin", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["tin"], "contexts": ["element whose oxyd replaces nickel"]}, {"entity_id": "tin", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tin", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["tin"], "contexts": ["material of floating balls", "metal in f