nary theories.", "wikidata_id": "Q1277626", "wikidata_description": "Ethnic group indigenous to the Terai region of southern Nepal and northern India"}}, {"canonical_name": "geologists", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "geologists", "book_id": "origin_of_species_darwin_1859", "name": "geologists", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["geologists"], "contexts": ["experts in geological time", "scientists studying Earth's structure"]}, {"entity_id": "geologist", "book_id": "origin_of_species_darwin_1859", "name": "geologist", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["geologist"], "contexts": ["practitioner of geology", "scientist studying earth's history"]}, {"entity_id": "geologists", "book_id": "kosmos_humboldt_1845", "name": "geologists", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["geologists"], "contexts": ["scientists studying the Earth", "scientists studying earth's formation"]}, {"entity_id": "geologists", "book_id": "first_principles_spencer_1862", "name": "geologists", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["geologists"], "contexts": ["scientists studying Earth's history", "disciplines studying Earth's surface"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "geologists", "target_book": "kosmos_humboldt_1845", "target_name": "geologists", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "geologists", "target_book": "first_principles_spencer_1862", "target_name": "geologists", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "geologist", "target_book": "kosmos_humboldt_1845", "target_name": "geologists", "similarity": 0.93}, {"source_book": "origin_of_species_darwin_1859", "source_name": "geologist", "target_book": "first_principles_spencer_1862", "target_name": "geologists", "similarity": 0.93}, {"source_book": "kosmos_humboldt_1845", "source_name": "geologists", "target_book": "first_principles_spencer_1862", "target_name": "geologists", "similarity": 1.0}], "id": 1200, "stable_key": "clu_6c4b35789c67621d", "ground_truth": {"modern_name": "Geologists", "confidence": "high", "type": "person", "description": "Scientists who study the Earth's physical structure and substance.", "wikidata_id": "Q520549", "wikidata_description": "scientist who studies geology", "wikipedia_url": "https://en.wikipedia.org/wiki/Geologist", "wikipedia_extract": "A geologist is a scientist who studies the structure, composition, and history of Earth. Geologists incorporate techniques from physics, chemistry, biology, mathematics, and geography to perform research in the field and the laboratory. Geologists work in the energy and mining sectors to exploit natural resources. They monitor environmental hazards such as earthquakes, volcanoes, tsunamis and landslides. Geologists are also important contributors to climate change discussions. James Hutton is often viewed as the first modern geologist."}}, {"canonical_name": "cana", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "ca\u00f1a", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "ca\u00f1a", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["ca\u00f1a"], "contexts": ["cane, useful after drying", "plant resembling cane leaves"]}, {"entity_id": "cana", "book_id": "coloquios_da_orta_1563", "name": "cana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["cana", "canas"], "contexts": ["part of a plant", "plant part used for purging"]}, {"entity_id": "canna", "book_id": "polyanthea_medicinal", "name": "canna", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["canna"], "contexts": ["a plant, possibly sugarcane"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ca\u00f1a", "target_book": "coloquios_da_orta_1563", "target_name": "cana", "similarity": 0.762}, {"source_book": "coloquios_da_orta_1563", "source_name": "cana", "target_book": "polyanthea_medicinal", "target_name": "canna", "similarity": 0.89}], "id": 1201, "stable_key": "clu_ca11f2b2414a3ac5", "ground_truth": {"modern_name": "Sugarcane", "confidence": "high", "type": "plant", "linnaean": "Saccharum officinarum Linnaeus", "family": "Poaceae", "note": "The text contains 'Saccharum ofBcinarum', which is likely a OCR error for 'Saccharum officinarum'.", "wikidata_id": "Q3391243", "wikidata_description": "species of plant"}}, {"canonical_name": "vaches", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "vacas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "vacas", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 4, "variants": ["vacas"], "contexts": ["domestic cattle", "cows"]}, {"entity_id": "vaches", "book_id": "relation_historique_humboldt_vol3_1825", "name": "vaches", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 7, "variants": ["vaches", "vache", "vaches \u00e0 bosse"], "contexts": ["female cattle", "livestock import"]}, {"entity_id": "vacas", "book_id": "historia_medicinal_monardes_1574", "name": "vacas", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["vacas"], "contexts": ["cows that die in the lowlands"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "vacas", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "vaches", "similarity": 0.935}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "vacas", "target_book": "historia_medicinal_monardes_1574", "target_name": "vacas", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "vaches", "target_book": "historia_medicinal_monardes_1574", "target_name": "vacas", "similarity": 0.935}], "id": 1202, "stable_key": "clu_be41f7601f2678f6", "ground_truth": {"modern_name": "Cow", "confidence": "high", "type": "animal", "linnaean": "Bos taurus", "family": "Bovidae", "description": "Domesticated bovine animal, raised for milk, meat, and labor.", "wikipedia_extract": "Cattle (Bos taurus) are large, domesticated, bovid ungulates widely kept as livestock. They are prominent modern members of the subfamily Bovinae and the most widespread species of the genus Bos. Mature female cattle are called cows and mature males are called bulls. Taurine cattle are widely distributed across Europe and temperate areas of Asia, the Americas, and Australia. Zebus are found mainly in India and tropical areas of Asia, America, and Australia. Sanga cattle are found primarily in sub-Saharan Africa."}}, {"canonical_name": "human brain", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "cerebro", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "cerebro", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["cerebro"], "contexts": ["organ for thought and vigor", "area where leaves are applied"]}, {"entity_id": "human_brain", "book_id": "principles_of_psychology_james_1890", "name": "human brain", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["Human Brain", "human brain"], "contexts": ["brain of a human", "brain of Homo sapiens"]}, {"entity_id": "cerebral", "book_id": "principles_of_psychology_james_1890", "name": "cerebral", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["cerebral"], "contexts": ["relating to the cerebrum", "relating to the brain"]}, {"entity_id": "mammalian_brain", "book_id": "principles_of_psychology_james_1890", "name": "mammalian brain", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["mammalian brain"], "contexts": ["brain of mammals for study"]}, {"entity_id": "cerebro", "book_id": "historia_medicinal_monardes_1574", "name": "cerebro", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["cerebro"], "contexts": ["brain, organ of the body", "part of the body where amber is placed"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cerebro", "target_book": "principles_of_psychology_james_1890", "target_name": "human brain", "similarity": 0.934}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cerebro", "target_book": "principles_of_psychology_james_1890", "target_name": "cerebral", "similarity": 0.953}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cerebro", "target_book": "principles_of_psychology_james_1890", "target_name": "mammalian brain", "similarity": 0.919}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cerebro", "target_book": "historia_medicinal_monardes_1574", "target_name": "cerebro", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "human brain", "target_book": "historia_medicinal_monardes_1574", "target_name": "cerebro", "similarity": 0.934}, {"source_book": "principles_of_psychology_james_1890", "source_name": "cerebral", "target_book": "historia_medicinal_monardes_1574", "target_name": "cerebro", "similarity": 0.953}, {"source_book": "principles_of_psychology_james_1890", "source_name": "mammalian brain", "target_book": "historia_medicinal_monardes_1574", "target_name": "cerebro", "similarity": 0.919}], "id": 1203, "stable_key": "clu_321525fca4253e1f", "ground_truth": {"modern_name": "Brain", "confidence": "high", "type": "object", "note": "Refers to the organ of thought, encompassing both human and mammalian brains.", "wikidata_id": "Q16860338", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Brain%20%28surname%29"}}, {"canonical_name": "Algalia", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "algalia", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Algalia", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["Algalia"], "contexts": ["animal product with a strong scent"]}, {"entity_id": "algalia", "book_id": "coloquios_da_orta_1563", "name": "algalia", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["algalia", "algualia"], "contexts": ["used for cold humor pains", "substance with strong smell"]}, {"entity_id": "algalia", "book_id": "polyanthea_medicinal", "name": "Algalia", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 7, "variants": ["algalia", "Algalia"], "contexts": ["civet used in preparation", "civet, warm paste for abdominal pain"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Algalia", "target_book": "coloquios_da_orta_1563", "target_name": "algalia", "similarity": 0.462}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Algalia", "target_book": "polyanthea_medicinal", "target_name": "Algalia", "similarity": 0.807}, {"source_book": "coloquios_da_orta_1563", "source_name": "algalia", "target_book": "polyanthea_medicinal", "target_name": "Algalia", "similarity": 0.671}], "id": 1204, "stable_key": "clu_289605e9e9afedd5", "ground_truth": {"modern_name": "Civet", "confidence": "high", "type": "animal", "note": "Algalia refers to civet, an animal whose secretion is used in perfumery and medicine. The Spanish 'Algalia' and Portuguese 'algalia' both point to this animal. The contexts mention strong scent and use in preparation.", "wikidata_id": "Q17355875", "wikidata_description": "genus of mammals", "wikipedia_url": "https://en.wikipedia.org/wiki/Civettictis"}}, {"canonical_name": "Valparaiso", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "valparaiso", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Valparaiso", "category": "PLACE", "subcategory": "CITY", "count": 10, "variants": ["Valparaiso", "Valparayso"], "contexts": ["city in Chile", "city"]}, {"entity_id": "valparaiso", "book_id": "kosmos_humboldt_1845", "name": "Valparaiso", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Valparaiso"], "contexts": ["city near Aconcagua"]}, {"entity_id": "valparaiso", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Valparaiso", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Valparaiso"], "contexts": ["location of intense earthquake effects"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Valparaiso", "target_book": "kosmos_humboldt_1845", "target_name": "Valparaiso", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Valparaiso", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Valparaiso", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Valparaiso", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Valparaiso", "similarity": 1.0}], "id": 1205, "stable_key": "clu_0fd0e88f21b11d0c", "ground_truth": {"modern_name": "Valpara\u00edso", "confidence": "high", "type": "place", "country": "Chile", "wikidata_id": "Q868888", "wikidata_description": "city in Porter County, Indiana, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Valparaiso%2C%20Indiana", "wikipedia_extract": "Valpara\u00edso is a major city, commune, seaport, and naval base facility in the Valpara\u00edso Region of Chile. Valpara\u00edso was originally named after Valpara\u00edso de Arriba, in Castile-La Mancha, Spain. Greater Valpara\u00edso is the second-most populous metro area in the country. Valparaiso is the second-largest city in the metro area (behind Vi\u00f1a del Mar). It is located about 120 km (75 mi) northwest of Santiago, by road, and is one of the Pacific Ocean's most important seaports. Valpara\u00edso is the capital of Chile's second most-populated administrative region and has been the Chilean Navy headquarters since 1817, as well as being the seat of the National Congress of Chile since 1990."}}, {"canonical_name": "Auguste de Saint-Hilaire", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "auguste_de_saint-hilaire", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Auguste de Saint-Hilaire", "category": "PERSON", "subcategory": "SCHOLAR", "count": 10, "variants": ["Auguste de Saint-Hilaire", "Augusle de Saini-Hilaire", "Auguste de Sa'ml-Hilain", "Auguste de Saint-Hilaiie", "Saint-Hilaire"], "contexts": ["collected notes on leagues", "discoverer of Cinchona ferruginea"]}, {"entity_id": "auguste_de_la_rive", "book_id": "kosmos_humboldt_1845", "name": "Auguste de la Rive", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Auguste de la Rive"], "contexts": ["researcher at Pregny"]}, {"entity_id": "auguste_de_la_rive", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Auguste de la Rive", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Auguste de la Rive"], "contexts": ["made experiments on temperature increase with depth"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Auguste de Saint-Hilaire", "target_book": "kosmos_humboldt_1845", "target_name": "Auguste de la Rive", "similarity": 0.833}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Auguste de Saint-Hilaire", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Auguste de la Rive", "similarity": 0.833}, {"source_book": "kosmos_humboldt_1845", "source_name": "Auguste de la Rive", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Auguste de la Rive", "similarity": 1.0}], "id": 1206, "stable_key": "clu_960e55c2e3597116", "ground_truth": {"modern_name": "Auguste de Saint-Hilaire", "confidence": "high", "type": "person", "birth_year": 1779, "death_year": 1853, "description": "French botanist and explorer in South America", "note": "The provided context mentioning 'Auguste de la Rive' appears to be a misattribution or confusion with Saint-Hilaire.", "wikidata_id": "Q707961", "wikidata_description": "French botanist and traveler (1779\u20131853)", "wikipedia_url": "https://en.wikipedia.org/wiki/Augustin%20Saint-Hilaire", "wikipedia_extract": "Augustin Fran\u00e7ois C\u00e9sar Prouven\u00e7al de Saint-Hilaire (4 October 1779 \u2013 3 September 1853) was a French botanist and traveller who was born and died in Orl\u00e9ans, France. A keen observer, he is credited with important discoveries in botany, notably the direction of the radicle in the embryo sac and the double point of attachment of certain ovules. He also described two families, the Paronychiae and the Tamariscinae, as well as many genera and species. He began to publish memoirs on botanical subjects at an early age. Between 1816 and 1822 and again in 1830, he traveled in South America, especially in south and central Brazil, and the results of his study of the rich flora of the regions through which he passed appeared in several books and numerous articles in scientific journals. In his first voyage, from 1816 to 1822, he explored the Brazilian backlands, traveling ca."}}, {"canonical_name": "Pampas", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "pampas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pampas", "category": "PLACE", "subcategory": "REGION", "count": 10, "variants": ["Pampas", "pampas"], "contexts": ["plains north and south of equator", "plains where cultivation is debated"]}, {"entity_id": "pampas", "book_id": "kosmos_humboldt_1845", "name": "pampas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["pampas"], "contexts": ["grassy plains in the New Continent"]}, {"entity_id": "pampas", "book_id": "first_principles_spencer_1862", "name": "Pampas", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Pampas"], "contexts": ["location of alligators during drought"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pampas", "target_book": "kosmos_humboldt_1845", "target_name": "pampas", "similarity": 0.728}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pampas", "target_book": "first_principles_spencer_1862", "target_name": "Pampas", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "pampas", "target_book": "first_principles_spencer_1862", "target_name": "Pampas", "similarity": 0.728}], "id": 1207, "stable_key": "clu_83081156e2633476", "ground_truth": {"modern_name": "Pampas", "confidence": "high", "type": "place", "country": "Argentina, Uruguay", "wikidata_id": "Q11994681", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Pampasatyrus", "wikipedia_extract": "Pampasatyrus is a Neotropical genus of butterflies in the family Nymphalidae. Pampasatyrus glaucope (C. & R."}}, {"canonical_name": "chronom\u00e8tres", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "chronom\u00e8tres", "book_id": "relation_historique_humboldt_vol3_1825", "name": "chronom\u00e8tres", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 8, "variants": ["chronom\u00e8tres", "chronom\u00e8tre", "chronom\u00eatre"], "contexts": ["used for linking points", "measuring time"]}, {"entity_id": "chronograph", "book_id": "principles_of_psychology_james_1890", "name": "Chronograph", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["Chronograph"], "contexts": ["time-registering instrument"]}, {"entity_id": "chronoscope", "book_id": "principles_of_psychology_james_1890", "name": "Chronoscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["Chronoscope"], "contexts": ["precise time-measuring instrument"]}, {"entity_id": "chronometric_apparatus", "book_id": "principles_of_psychology_james_1890", "name": "chronometric apparatus", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["chronometric apparatus"], "contexts": ["device for measuring time"]}, {"entity_id": "chronometers", "book_id": "connexion_physical_sciences_somerville_1858", "name": "chronometers", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["chronometers"], "contexts": ["highly accurate timekeeping devices"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "chronom\u00e8tres", "target_book": "principles_of_psychology_james_1890", "target_name": "Chronograph", "similarity": 0.939}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "chronom\u00e8tres", "target_book": "principles_of_psychology_james_1890", "target_name": "Chronoscope", "similarity": 0.91}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "chronom\u00e8tres", "target_book": "principles_of_psychology_james_1890", "target_name": "chronometric apparatus", "similarity": 0.913}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "chronom\u00e8tres", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chronometers", "similarity": 0.973}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Chronograph", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chronometers", "similarity": 0.925}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Chronoscope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chronometers", "similarity": 0.9}, {"source_book": "principles_of_psychology_james_1890", "source_name": "chronometric apparatus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chronometers", "similarity": 0.911}], "id": 1208, "stable_key": "clu_4763863b0ecab4aa", "ground_truth": {"modern_name": "Chronometers", "confidence": "high", "type": "object", "description": "Instruments for measuring and indicating time with high accuracy.", "wikipedia_extract": "A clock or chronometer is a device that measures and displays time. The clock is one of the oldest human inventions, meeting the need to measure intervals of time shorter than the natural units such as the day, the lunar month, and the year. Devices operating on several physical processes have been used over the millennia. Some predecessors to the modern clock may be considered \"clocks\" that are based on movement in nature: A sundial shows the time by displaying the position of a shadow on a flat surface. There is a range of duration timers, a well-known example being the hourglass. Water clocks, along with sundials, are possibly the oldest time-measuring instruments."}}, {"canonical_name": "calmas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "calme", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Calme", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Calme", "Calme plat", "calme"], "contexts": ["state of no wind", "description of sea state"]}, {"entity_id": "calms", "book_id": "kosmos_humboldt_1845", "name": "calms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["calms"], "contexts": ["lack of wind"]}, {"entity_id": "calmas", "book_id": "polyanthea_medicinal", "name": "calmas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["calmas", "calmas exceffivas"], "contexts": ["heat or intensity", "heat"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Calme", "target_book": "kosmos_humboldt_1845", "target_name": "calms", "similarity": 0.899}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Calme", "target_book": "polyanthea_medicinal", "target_name": "calmas", "similarity": 0.92}, {"source_book": "kosmos_humboldt_1845", "source_name": "calms", "target_book": "polyanthea_medicinal", "target_name": "calmas", "similarity": 0.969}], "id": 1209, "stable_key": "clu_37efd6b2c7448b39", "ground_truth": {"modern_name": "Calm", "confidence": "high", "type": "concept", "description": "A state of stillness, especially of the air or sea, without wind.", "note": "Refers to a state of stillness, not a chemical element.", "wikipedia_extract": "Calm technology or calm design is a type of information technology where the interaction between the technology and its user is designed to occur in the user's periphery rather than constantly at the center of attention. Information from the technology smoothly shifts to the user's attention when needed but otherwise stays calmly in the user's periphery. Mark Weiser and John Seely Brown describe calm technology as \"that which informs but doesn't demand our focus or attention.\" The use of calm technology is paired with ubiquitous computing as a way to minimize the perceptible invasiveness of computers in everyday life. For a technology to be considered calm technology, there are three core principles it should adhere to: The user's attention to the technology must reside mainly in the periphery. This means that either the technology can easily shift between the center of attention and the periphery or that much of the information conveyed by the technology is present in the periphery rather than the center. The technology increases a user's use of his or her periphery."}}, {"canonical_name": "ch\u00e1", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "th\u00e9", "book_id": "relation_historique_humboldt_vol3_1825", "name": "th\u00e9", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["th\u00e9"], "contexts": ["commodity from China", "commodity with a single source"]}, {"entity_id": "ch\u00e1", "book_id": "polyanthea_medicinal", "name": "ch\u00e1", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["Ch\u00e1", "ch\u00e1"], "contexts": ["tea leaves", "a beverage with astringent qualities"]}, {"entity_id": "tea", "book_id": "first_principles_spencer_1862", "name": "tea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["tea"], "contexts": ["beverage plant"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "th\u00e9", "target_book": "polyanthea_medicinal", "target_name": "ch\u00e1", "similarity": 0.925}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "th\u00e9", "target_book": "first_principles_spencer_1862", "target_name": "tea", "similarity": 0.939}, {"source_book": "polyanthea_medicinal", "source_name": "ch\u00e1", "target_book": "first_principles_spencer_1862", "target_name": "tea", "similarity": 0.932}], "id": 1210, "stable_key": "clu_a077fbf8458fcc92", "ground_truth": {"modern_name": "Tea", "confidence": "high", "type": "plant", "linnaean": "Camellia sinensis", "family": "Theaceae", "wikidata_id": "Q101815", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Camellia%20sinensis", "wikipedia_extract": "Camellia sinensis is a species of evergreen shrub or small tree in the flowering plant family Theaceae. Its leaves, leaf buds, and stems are used to produce tea. Common names include tea plant, tea shrub, and tea tree (unrelated to Melaleuca alternifolia, the source of tea tree oil, or the genus Leptospermum commonly called tea tree). White tea, yellow tea, green tea, oolong, dark tea (which includes pu-erh tea) and black tea are all made from two of the five varieties which form the main crops now grown, C. sinensis var. sinensis and C."}}, {"canonical_name": "A.", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "aubl_", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Aubl.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Aubl."], "contexts": ["author of botanical name"]}, {"entity_id": "a__main", "book_id": "principles_of_psychology_james_1890", "name": "A. Main", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["A. Main"], "contexts": ["cited author in Mind and Revue Philos."]}, {"entity_id": "a_", "book_id": "polyanthea_medicinal", "name": "A.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 10, "variants": ["A."], "contexts": ["initial of an inventor", "author's initial"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Aubl.", "target_book": "polyanthea_medicinal", "target_name": "A.", "similarity": 0.855}, {"source_book": "principles_of_psychology_james_1890", "source_name": "A. Main", "target_book": "polyanthea_medicinal", "target_name": "A.", "similarity": 0.914}], "id": 1211, "stable_key": "clu_ebad8250bfcd854a", "ground_truth": {"modern_name": "Adanson", "confidence": "medium", "type": "person", "birth_year": 1727, "death_year": 1806, "description": "French botanist and naturalist, author of 'Familles des plantes'", "note": "The 'A.' and 'Aubl.' likely refer to Michel Adanson and Jean Baptiste Christophore Fus\u00e9e Aublet, both influential botanists frequently cited in early modern texts. 'A. Main' is less clear and might be a distinct or misspelled reference. Given the botanical context of 'author of botanical name', Adanson is a strong candidate, but Aublet also fits. The primary reference seems to point towards botanical authors.", "wikidata_id": "Q315861", "wikidata_description": "French naturalist (1727-1806)", "wikipedia_url": "https://en.wikipedia.org/wiki/Michel%20Adanson", "wikipedia_extract": "Michel Adanson (7 April 1727 \u2013 3 August 1806) was an 18th-century French botanist and naturalist who traveled to Senegal to study flora and fauna. He proposed a \"natural system\" of taxonomy distinct from the binomial system forwarded by Linnaeus. The standard author abbreviation Adans. is used to indicate this person as the author when citing a botanical name. Adanson was born at Aix-en-Provence. His family moved to Paris in 1730."}}, {"canonical_name": "Charcoal", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "charpente", "book_id": "relation_historique_humboldt_vol3_1825", "name": "charpente", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["charpente"], "contexts": ["carpentry wood"]}, {"entity_id": "coal", "book_id": "kosmos_humboldt_1845", "name": "coal", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["coal"], "contexts": ["substance capable of combustion", "carbonaceous rock"]}, {"entity_id": "charcoal", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Charcoal", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["Charcoal", "charcoal"], "contexts": ["material for producing artificial light", "conductor used in experiments"]}, {"entity_id": "coal", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Coal", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["coal", "Coal"], "contexts": ["fuel that produces heat when burnt", "combustible sedimentary rock"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "charpente", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Charcoal", "similarity": 0.888}, {"source_book": "kosmos_humboldt_1845", "source_name": "coal", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Charcoal", "similarity": 0.907}, {"source_book": "kosmos_humboldt_1845", "source_name": "coal", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Coal", "similarity": 0.993}], "id": 1212, "stable_key": "clu_015f7cd9871db30c-2", "ground_truth": {"modern_name": "Coal", "confidence": "high", "type": "mineral", "note": "Includes related terms referring to coal and coal-bearing formations.", "wikidata_id": "Q268335", "wikidata_description": "left tributary of the Liard River in Canada", "wikipedia_url": "https://en.wikipedia.org/wiki/Coal", "wikipedia_extract": "Coal is a combustible black or brownish-black sedimentary rock, formed as layers called coal seams. Coal is mostly carbon with variable amounts of other elements, chiefly hydrogen, sulfur, oxygen, and nitrogen. It is a fossil fuel, formed when plants decay into peat which is converted into coal by the heat and pressure of deep burial over millions of years. Vast deposits formed from wetlands called coal forests that covered much of the tropics during the late Carboniferous and early Permian. Coal is used primarily as a fuel. While coal has been known and used for thousands of years, its usage was limited until the Industrial Revolution."}}, {"canonical_name": "inertia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "inertia", "book_id": "principles_of_psychology_james_1890", "name": "inertia", "category": "CONCEPT", "subcategory": "THEORY", "count": 4, "variants": ["inertia"], "contexts": ["tendency to remain at rest", "tendency to remain unchanged"]}, {"entity_id": "inertia", "book_id": "connexion_physical_sciences_somerville_1858", "name": "inertia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["inertia"], "contexts": ["resistance to change in motion", "property of air affecting sound"]}, {"entity_id": "inertia", "book_id": "first_principles_spencer_1862", "name": "inertia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["inertia"], "contexts": ["resistance to change in motion", "law of motion in physics"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "inertia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "inertia", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "inertia", "target_book": "first_principles_spencer_1862", "target_name": "inertia", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "inertia", "target_book": "first_principles_spencer_1862", "target_name": "inertia", "similarity": 1.0}], "id": 1213, "stable_key": "clu_b65e2ed2e2780930", "ground_truth": {"modern_name": "Inertia", "confidence": "high", "type": "concept", "wikidata_id": "Q90390997", "wikidata_description": "UK musical group"}}, {"canonical_name": "British", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "british", "book_id": "kosmos_humboldt_1845", "name": "British", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["British"], "contexts": ["referring to British government", "European country"]}, {"entity_id": "british", "book_id": "coloquios_da_orta_1563", "name": "British", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["British", "British India"], "contexts": ["origin of the journal", "location mentioned in a book title"]}, {"entity_id": "british", "book_id": "connexion_physical_sciences_somerville_1858", "name": "British", "category": "PLACE", "subcategory": "COUNTRY", "count": 6, "variants": ["British"], "contexts": ["relating to measure of extension", "nationality of science"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "British", "target_book": "coloquios_da_orta_1563", "target_name": "British", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "British", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "British", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "British", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "British", "similarity": 1.0}], "id": 1214, "stable_key": "clu_eac142b3bcc64426-3", "ground_truth": {"modern_name": "Great Britain", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q145", "wikidata_description": "island country in north-west Europe", "wikipedia_url": "https://en.wikipedia.org/wiki/United%20Kingdom", "wikipedia_extract": "The United Kingdom of Great Britain and Northern Ireland, commonly known as the United Kingdom (UK) or Britain, is a country in northwestern Europe, off the coast of the continental mainland. It comprises England, Scotland, Wales and Northern Ireland, with a population of over 69 million in 2024. The UK includes the island of Great Britain, the north-eastern part of the island of Ireland, and most of the smaller islands within the British Isles, covering 94,354 square miles (244,376 km2). It shares a land border with the Republic of Ireland and is surrounded by the Atlantic Ocean, the North Sea, the English Channel, the Celtic Sea and the Irish Sea, while maintaining sovereignty over the Crown Dependencies and the British Overseas Territories. The capital and largest city of England and the UK is London; Edinburgh, Cardiff and Belfast are the national capitals of Scotland, Wales and Northern Ireland. Britain has been inhabited since the Neolithic."}}, {"canonical_name": "Lime", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "lime", "book_id": "kosmos_humboldt_1845", "name": "lime", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["lime"], "contexts": ["element in nepheline", "substance held in solution by water"]}, {"entity_id": "lime", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Lime", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["lime", "Lime"], "contexts": ["calcium oxide or carbonate", "substance in water producing negative electricity"]}, {"entity_id": "lime", "book_id": "first_principles_spencer_1862", "name": "lime", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["lime"], "contexts": ["mineral used in high temperature processes", "calcium oxide"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "lime", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Lime", "similarity": 0.662}, {"source_book": "kosmos_humboldt_1845", "source_name": "lime", "target_book": "first_principles_spencer_1862", "target_name": "lime", "similarity": 0.838}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Lime", "target_book": "first_principles_spencer_1862", "target_name": "lime", "similarity": 0.858}], "id": 1215, "stable_key": "clu_f83ffd9e071702a0", "ground_truth": {"modern_name": "Calcium carbonate", "confidence": "high", "type": "mineral", "note": "Contexts suggest both calcium oxide (lime) and calcium carbonate (limestone).", "wikidata_id": "Q23767", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Calcium%20carbonate", "wikipedia_extract": "Calcium carbonate is a chemical compound with the chemical formula CaCO3. It is a common substance found in rocks as the minerals calcite and aragonite, most notably in chalk and limestone, eggshells, gastropod shells, shellfish skeletons and pearls. Materials containing much calcium carbonate or resembling it are described as calcareous. Calcium carbonate is the active ingredient in agricultural lime. Limescale is calcium carbonate produced when calcium ions in hard water react with carbonate ions. Calcium carbonate has medical use as a calcium supplement or as an antacid, but excessive consumption can be hazardous and cause hypercalcemia and digestive issues."}}, {"canonical_name": "Aphelion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "aphelion", "book_id": "kosmos_humboldt_1845", "name": "aphelion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["aphelion"], "contexts": ["point farthest from the Sun in orbit"]}, {"entity_id": "aphelion", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Aphelion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["Aphelion", "aphelion"], "contexts": ["point farthest from the sun in orbit", "point of farthest approach from sun"]}, {"entity_id": "aphelion", "book_id": "first_principles_spencer_1862", "name": "aphelion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["aphelion"], "contexts": ["point farthest from the sun"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "aphelion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Aphelion", "similarity": 0.868}, {"source_book": "kosmos_humboldt_1845", "source_name": "aphelion", "target_book": "first_principles_spencer_1862", "target_name": "aphelion", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Aphelion", "target_book": "first_principles_spencer_1862", "target_name": "aphelion", "similarity": 0.868}], "id": 1216, "stable_key": "clu_95c85177f5b05502", "ground_truth": {"modern_name": "Aphelion", "confidence": "high", "type": "concept", "wikidata_id": "Q10414642", "wikidata_description": "genus of insects", "wikipedia_extract": "An apsis (from Ancient Greek  \u1f01\u03c8\u03af\u03c2 (haps\u00eds) 'arch, vault' (third declension); pl.\u2009apsides  AP-sih-deez) is the farthest or nearest point in the orbit of a planetary body about its primary body. The line of apsides (also called apse line, or major axis of the orbit) is the line connecting the two extreme values. Apsides pertaining to orbits around different bodies have distinct names to differentiate themselves from other apsides. Apsides pertaining to geocentric orbits, orbits around the Earth, are at the farthest point called the apogee, and at the nearest point the perigee, as with orbits of satellites and the Moon around Earth. Apsides pertaining to orbits around the Sun are named aphelion for the farthest and perihelion for the nearest point in a heliocentric orbit. Earth's two apsides are the farthest point, aphelion, and the nearest point, perihelion, of its orbit around the host Sun."}}, {"canonical_name": "Meca", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "mecca", "book_id": "kosmos_humboldt_1845", "name": "Mecca", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Mecca"], "contexts": ["site of pilgrim assemblage"]}, {"entity_id": "meca", "book_id": "coloquios_da_orta_1563", "name": "Meca", "category": "PLACE", "subcategory": "CITY", "count": 9, "variants": ["Meca", "Mecca"], "contexts": ["origin of goods to Diu", "strait from where a substance is brought"]}, {"entity_id": "mekka", "book_id": "coloquios_da_orta_1563", "name": "Mekka", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Mekka"], "contexts": ["city"]}, {"entity_id": "mecca", "book_id": "ricettario_fiorentino_1597", "name": "Mecca", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Mecca"], "contexts": ["origin of a type of Sena"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Mecca", "target_book": "coloquios_da_orta_1563", "target_name": "Meca", "similarity": 0.948}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mecca", "target_book": "coloquios_da_orta_1563", "target_name": "Mekka", "similarity": 0.971}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mecca", "target_book": "ricettario_fiorentino_1597", "target_name": "Mecca", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Meca", "target_book": "ricettario_fiorentino_1597", "target_name": "Mecca", "similarity": 0.948}, {"source_book": "coloquios_da_orta_1563", "source_name": "Mekka", "target_book": "ricettario_fiorentino_1597", "target_name": "Mecca", "similarity": 0.971}], "id": 1217, "stable_key": "clu_4700d43b51bfa808", "ground_truth": {"modern_name": "Mecca", "confidence": "high", "type": "place", "description": "Holy city in Saudi Arabia, ancient center of trade.", "wikipedia_extract": "Mecca, officially Makkah al-Mukarramah, is the holiest city in Islam. It is located in the Hejazi region of western Saudi Arabia and is the capital of Mecca Province. Mecca is considered the birthplace of Islam and is the birthplace of the Islamic prophet Muhammad. It is 70 km (43 mi) inland from Jeddah on the Red Sea, in a narrow valley 277 m (909 ft) above sea level. Its metropolitan population in 2022 was 2.4 million, making it the third\u2013most populated city in Saudi Arabia after Riyadh and Jeddah. The Cave of Hira atop the Jabal al-Nour, just outside the city, is where Muslims believe the Quran was first revealed to Muhammad."}}, {"canonical_name": "Corte", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "corte", "book_id": "historia_medicinal_monardes_1574", "name": "corte", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["corte"], "contexts": ["court, source of orders"]}, {"entity_id": "corte", "book_id": "ricettario_fiorentino_1597", "name": "Corte", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Corte"], "contexts": ["court or legal jurisdiction"]}, {"entity_id": "corte", "book_id": "polyanthea_medicinal", "name": "Corte", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 10, "variants": ["Corte", "Corte de Portugal", "Cortede Fran\u00e7a"], "contexts": ["location of a case", "location of a woman"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "corte", "target_book": "ricettario_fiorentino_1597", "target_name": "Corte", "similarity": 0.871}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "corte", "target_book": "polyanthea_medicinal", "target_name": "Corte", "similarity": 0.871}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Corte", "target_book": "polyanthea_medicinal", "target_name": "Corte", "similarity": 1.0}], "id": 1218, "stable_key": "clu_053a6929e6ca977a", "ground_truth": {"modern_name": "court", "confidence": "high", "type": "place", "description": "Royal court, legal jurisdiction, or enclosed space.", "note": "Contexts suggest both the physical space of a court and its associated authority.", "wikipedia_extract": "A court is an institution, often a government entity, with the authority to adjudicate legal disputes between parties  and administer justice in civil, criminal, and administrative matters in accordance with the rule of law. Courts generally consist of judges or other judicial officers, and are usually established and dissolved through legislation enacted by a legislature. Courts may also be established by constitution or an equivalent constituting instrument. The practical authority given to the court is known as its jurisdiction, which describes the court's power to decide certain kinds of questions, or petitions put to it. There are various kinds of courts, including trial courts, appellate courts, administrative courts, international courts, and tribunals. A court is any person or institution, often as a government institution, with the authority to adjudicate legal disputes between parties and carry out the administration of justice in civil, criminal, and administrative matters in accordance with the rule of law."}}, {"canonical_name": "Berberi", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "berberis", "book_id": "coloquios_da_orta_1563", "name": "Berberis", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Berberis", "berberis"], "contexts": ["plant used for juice", "genus of plants yielding rusoif"]}, {"entity_id": "berberi", "book_id": "ricettario_fiorentino_1597", "name": "Berberi", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["Berberi", "BERBERI", "Bcrberi", "berberi"], "contexts": ["plant name, context incomplete", "common barberry"]}, {"entity_id": "berberis", "book_id": "polyanthea_medicinal", "name": "berberis", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["berberis"], "contexts": ["ingredient in a remedy for diabetes"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Berberis", "target_book": "ricettario_fiorentino_1597", "target_name": "Berberi", "similarity": 0.972}, {"source_book": "coloquios_da_orta_1563", "source_name": "Berberis", "target_book": "polyanthea_medicinal", "target_name": "berberis", "similarity": 0.977}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Berberi", "target_book": "polyanthea_medicinal", "target_name": "berberis", "similarity": 0.953}], "id": 1219, "stable_key": "clu_6c10c1a6e1d97e8d", "ground_truth": {"modern_name": "barberry", "confidence": "high", "type": "plant", "linnaean": "Berberis vulgaris", "family": "Berberidaceae", "description": "Shrub with tart red berries, used in traditional medicine and as an ingredient.", "wikipedia_extract": "Berberis vulgaris, also known as common barberry, European barberry or simply barberry, is a shrub in the genus Berberis native to the Old World. It produces edible but sharply acidic berries, which people in many countries eat as a tart and refreshing fruit. It is a deciduous shrub growing up to 4 metres (13 feet) high. The leaves are small, oval, 2\u20135 centimetres (3\u20444\u20132 inches) long and 1\u20132 cm (1\u20442\u20133\u20444 in) broad, with a serrated margin; they are borne in clusters of 2\u20135 together, subtended by a three-branched spine 3\u20138 millimetres (1\u20448\u20135\u204416 in) long. The flowers are yellow, 4\u20136 mm (1\u20448\u20131\u20444 in) across, produced on 3\u20136 cm (1+1\u20448\u20132+3\u20448 in) long panicles in late spring. The fruit is an oblong red berry 7\u201310 mm (1\u20444\u20133\u20448 in) long and 3\u20135 mm (1\u20448\u20133\u204416 in) broad, ripening in late summer or autumn."}}, {"canonical_name": "monkey", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "donkey", "book_id": "origin_of_species_darwin_1859", "name": "donkey", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["donkey"], "contexts": ["mammal kept by poor people"]}, {"entity_id": "monkey", "book_id": "principles_of_psychology_james_1890", "name": "monkey", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 7, "variants": ["monkey"], "contexts": ["animal used in experiments", "animal studied for motor regions"]}, {"entity_id": "monkey", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Monkey", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Monkey"], "contexts": ["viviparous animal with clavicles"]}, {"entity_id": "monkey", "book_id": "origin_of_species_darwin_1859", "name": "monkey", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["monkey"], "contexts": ["animal with arm bones", "mammal with inherited limb bones"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "donkey", "target_book": "principles_of_psychology_james_1890", "target_name": "monkey", "similarity": 0.897}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Monkey", "target_book": "origin_of_species_darwin_1859", "target_name": "monkey", "similarity": 0.931}], "id": 1220, "stable_key": "clu_c4d5d022b9de3b86", "ground_truth": {"modern_name": "Monkey", "confidence": "high", "type": "animal", "note": "The term 'donkey' appears once, but the overwhelming majority of mentions are 'monkey', and the contexts provided (viviparous animal, use in experiments) strongly support monkey.", "wikidata_id": "Q1367", "wikidata_description": "common idea of an animal of the \"higher primates\" (the simians in English excluding apes)"}}, {"canonical_name": "emotions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "emotions", "book_id": "principles_of_psychology_james_1890", "name": "emotions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["emotions"], "contexts": ["engendered by association of ideas", "native tendencies to reaction"]}, {"entity_id": "human_emotions", "book_id": "first_principles_spencer_1862", "name": "human emotions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human emotions"], "contexts": ["classed among human emotions"]}, {"entity_id": "emotions", "book_id": "kosmos_humboldt_1845", "name": "emotions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["emotions"], "contexts": ["strong feelings"]}, {"entity_id": "emotions", "book_id": "first_principles_spencer_1862", "name": "emotions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["emotions"], "contexts": ["feelings and their expression", "feelings and sentiments"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "emotions", "target_book": "first_principles_spencer_1862", "target_name": "human emotions", "similarity": 0.949}, {"source_book": "kosmos_humboldt_1845", "source_name": "emotions", "target_book": "first_principles_spencer_1862", "target_name": "emotions", "similarity": 1.0}], "id": 1221, "stable_key": "clu_a5707314b67e2cd7-2", "ground_truth": {"modern_name": "emotions", "confidence": "high", "type": "concept", "wikidata_id": "Q208166", "wikidata_description": "personality disorder characterized by variability of moods and unstable relationships", "wikipedia_url": "https://en.wikipedia.org/wiki/Borderline%20personality%20disorder", "wikipedia_extract": "Borderline personality disorder (BPD) is a personality disorder characterized by a pervasive, long-term pattern of significant interpersonal relationship instability, acute fear of abandonment, and intense emotional outbursts. People with BPD frequently exhibit self-harming behaviours and engage in risky activities, primarily caused by difficulties in regulating emotions. Symptoms such as dissociation, a pervasive sense of emptiness, and distorted sense of self are prevalent. Onset of symptoms can be triggered by events others perceive as normal, with the disorder typically manifesting in early adulthood and persisting across diverse contexts. BPD is often comorbid with substance use disorders, depressive disorders, and eating disorders. Studies estimate up to 10 percent of people with BPD die by suicide."}}, {"canonical_name": "raison", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "raison", "book_id": "medecine_experimentale_bernard_1865", "name": "raison", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["raison"], "contexts": ["faculty for logical thought and understanding", "faculty of logical thought and deduction"]}, {"entity_id": "raison", "book_id": "epoques_nature_buffon_1778", "name": "raison", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["raison"], "contexts": ["faculty of logical thought"]}, {"entity_id": "raison", "book_id": "relation_historique_humboldt_vol3_1825", "name": "raison", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["raison"], "contexts": ["Reason"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "raison", "target_book": "epoques_nature_buffon_1778", "target_name": "raison", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "raison", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "raison", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "raison", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "raison", "similarity": 1.0}], "id": 1222, "stable_key": "clu_8507ca77402d628a-2", "ground_truth": {"modern_name": "Reason", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Reason", "wikipedia_extract": "Reason is the capacity of consciously applying logic by drawing valid conclusions from new or existing information, with the aim of seeking truth. It is associated with such characteristically human activities as philosophy, religion, science, language, and mathematics, and is normally considered to be a distinguishing ability possessed by humans. Reason is sometimes referred to as rationality, although the latter is more about its application. Reasoning involves using more-or-less rational processes of thinking and cognition to extrapolate from one's existing knowledge to generate new knowledge, and involves the use of one's intellect. The field of logic studies the ways in which humans can use formal reasoning to produce logically valid arguments and true conclusions. Reasoning may be subdivided into forms of logical reasoning, such as deductive reasoning, inductive reasoning, and abductive reasoning."}}, {"canonical_name": "intuition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "l'intuition", "book_id": "medecine_experimentale_bernard_1865", "name": "l'intuition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["l'intuition"], "contexts": ["immediate understanding without reasoning"]}, {"entity_id": "intuition", "book_id": "medecine_experimentale_bernard_1865", "name": "intuition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["intuition"], "contexts": ["ability to understand something instinctively"]}, {"entity_id": "intuition", "book_id": "principles_of_psychology_james_1890", "name": "intuition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["intuition", "Intuition"], "contexts": ["faculty of immediate understanding", "immediate understanding or insight"]}, {"entity_id": "intuited", "book_id": "principles_of_psychology_james_1890", "name": "intuited", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["intuited"], "contexts": ["directly perceived or understood"]}, {"entity_id": "intuition", "book_id": "kosmos_humboldt_1845", "name": "intuition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["intuition"], "contexts": ["vague understanding of phenomena"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "l'intuition", "target_book": "principles_of_psychology_james_1890", "target_name": "intuition", "similarity": 0.933}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "l'intuition", "target_book": "principles_of_psychology_james_1890", "target_name": "intuited", "similarity": 0.892}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "l'intuition", "target_book": "kosmos_humboldt_1845", "target_name": "intuition", "similarity": 0.933}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "intuition", "target_book": "principles_of_psychology_james_1890", "target_name": "intuition", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "intuition", "target_book": "principles_of_psychology_james_1890", "target_name": "intuited", "similarity": 0.95}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "intuition", "target_book": "kosmos_humboldt_1845", "target_name": "intuition", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "intuition", "target_book": "kosmos_humboldt_1845", "target_name": "intuition", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "intuited", "target_book": "kosmos_humboldt_1845", "target_name": "intuition", "similarity": 0.95}], "id": 1223, "stable_key": "clu_0ccdac702ec62338", "ground_truth": {"modern_name": "intuition", "confidence": "high", "type": "concept", "wikidata_id": "Q1671627", "wikidata_description": "epistemological theory"}}, {"canonical_name": "Sense", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "sense", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Sense", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["sense", "Sense"], "contexts": ["fallacies of sense", "faculty of perception"]}, {"entity_id": "sense", "book_id": "principles_of_psychology_james_1890", "name": "sense", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["sense"], "contexts": ["sensory faculty", "meaning or intelligibility"]}, {"entity_id": "senses", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Senses", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Senses", "senses"], "contexts": ["organs for perceiving the world", "necessarily inaccurate testimony"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sense", "target_book": "principles_of_psychology_james_1890", "target_name": "sense", "similarity": 0.947}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sense", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Senses", "similarity": 0.872}], "id": 1224, "stable_key": "clu_3a348fff959c6b82-3", "ground_truth": {"modern_name": "Sensation", "confidence": "high", "type": "concept", "wikidata_id": "Q173253", "wikidata_description": "physiological capacity of organisms that provides data for perception", "wikipedia_url": "https://en.wikipedia.org/wiki/Sense", "wikipedia_extract": "A sense is a biological system used by an organism for sensation, the process of  gathering information about the surroundings through the detection of stimuli. Although, in some cultures, five human senses were traditionally identified as such (namely sight, smell, touch, taste, and hearing), many more are now recognized. Senses used by non-human organisms are even greater in variety and number. During sensation, sense organs collect various stimuli (such as a sound or smell) for transduction, meaning transformation into a form that can be understood by the brain. Sensation and perception are fundamental to nearly every aspect of an organism's cognition, behavior and thought. In organisms, a sensory organ consists of a group of interrelated sensory cells that respond to a specific type of physical stimulus."}}, {"canonical_name": "Ashes", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "ashes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "ashes", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["ashes"], "contexts": ["residue after burning", "residue from burning"]}, {"entity_id": "ashes", "book_id": "english_physician_1652", "name": "Ashes", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["ashes", "Ashes"], "contexts": ["of the bark of the Ash", "part of borrage used boiled"]}, {"entity_id": "ashes", "book_id": "kosmos_humboldt_1845", "name": "ashes", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["ashes"], "contexts": ["columns from volcanic eruptions", "volcanic material ejected"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "ashes", "target_book": "english_physician_1652", "target_name": "Ashes", "similarity": 0.628}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "ashes", "target_book": "kosmos_humboldt_1845", "target_name": "ashes", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Ashes", "target_book": "kosmos_humboldt_1845", "target_name": "ashes", "similarity": 0.628}], "id": 1225, "stable_key": "clu_b8e18b56fb507088", "ground_truth": {"modern_name": "Ash", "confidence": "high", "type": "mineral", "wikidata_id": "", "wikidata_description": "family name", "note": "The contexts suggest multiple meanings: residue after burning, bark of the Ash tree, and volcanic ash."}}, {"canonical_name": "humor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "humor", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "humor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["humor"], "contexts": ["viscous quality holding parts together", "bodily fluid in ancient medicine"]}, {"entity_id": "humor", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "humor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["humor"], "contexts": ["green plant has an excretory humor", "fluid to be exhaled from roots"]}, {"entity_id": "humorc", "book_id": "ricettario_fiorentino_1597", "name": "humorc", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["humorc", "humors"], "contexts": ["bodily fluid influencing health", "implied in medical context"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "humor", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "humor", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "humor", "target_book": "ricettario_fiorentino_1597", "target_name": "humorc", "similarity": 0.932}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "humor", "target_book": "ricettario_fiorentino_1597", "target_name": "humorc", "similarity": 0.932}], "id": 1226, "stable_key": "clu_2d285b02a3067485", "ground_truth": {"modern_name": "humoral theory", "confidence": "high", "type": "concept", "description": "A medical theory explaining health based on bodily fluids (humors).", "wikipedia_extract": "Humorism, the humoral theory, or humoralism, was a system of medicine detailing a supposed makeup and workings of the human body, adopted by Ancient Greek and Roman physicians and philosophers. Humorism began to fall out of favor in the 17th century and it was definitively disproved with the discovery of microbes. The concept of \"humors\" may have origins in Ancient Egyptian medicine, or Mesopotamia, though it was not systemized until ancient Greek thinkers. The word humor is a translation of Greek \u03c7\u03c5\u03bc\u03cc\u03c2, chymos (literally 'juice' or 'sap', metaphorically 'flavor'). Early texts on Indian Ayurveda medicine presented a theory of three or four humors (do\u1e63as), which they sometimes linked with the five elements (pa\u00f1ca-bh\u016bta): earth, water, fire, air, and space. The concept of \"humors\" (chemical systems regulating human behaviour) became more prominent from the writing of medical theorist Alcmaeon of Croton (c. 540\u2013500 BC)."}}, {"canonical_name": "Adder", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "adder", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Adder", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["Adder"], "contexts": ["type of serpent"]}, {"entity_id": "adder", "book_id": "english_physician_1652", "name": "Adder", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 9, "variants": ["Adder"], "contexts": ["venomous beast", "serpent with antipathy to ash tree"]}, {"entity_id": "adder", "book_id": "origin_of_species_darwin_1859", "name": "adder", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["adder"], "contexts": ["reptile with a venomous fang"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Adder", "target_book": "english_physician_1652", "target_name": "Adder", "similarity": 0.927}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Adder", "target_book": "origin_of_species_darwin_1859", "target_name": "adder", "similarity": 0.933}, {"source_book": "english_physician_1652", "source_name": "Adder", "target_book": "origin_of_species_darwin_1859", "target_name": "adder", "similarity": 0.869}], "id": 1227, "stable_key": "clu_b036c27de1db0c17", "ground_truth": {"modern_name": "Adder", "confidence": "high", "type": "animal", "wikidata_id": "Q192056", "wikidata_description": "species of snake belonging to the viper family (Viperidae)", "wikipedia_url": "https://en.wikipedia.org/wiki/Adder", "wikipedia_extract": "Vipera berus, commonly known as the common European adder and the common European viper, is a species of venomous snake in the family Viperidae. The species is extremely widespread and can be found throughout much of Europe, and as far as East Asia. There are three recognised subspecies. Known by a host of common names including common adder and common viper, the adder has been the subject of much folklore in Britain and other European countries. It is not regarded as especially dangerous; the snake is not aggressive and usually bites only when really provoked, stepped on, or picked up. Bites can be very painful, but are rarely fatal.", "note": "The term 'vipera' is the Latin genus for vipers, while 'Viper' and 'viper' are its English equivalents."}}, {"canonical_name": "animaux terrestres", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "animaux_terrestres", "book_id": "epoques_nature_buffon_1778", "name": "animaux terrestres", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 8, "variants": ["animaux terrestres", "ANIMAUX TERRESTRES"], "contexts": ["terrestrial animals mentioned in geological layers", "land-dwelling animals"]}, {"entity_id": "land_animals", "book_id": "origin_of_species_darwin_1859", "name": "land animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["land animals"], "contexts": ["terrestrial fauna", "animals living on land"]}, {"entity_id": "terrestrial_animals", "book_id": "kosmos_humboldt_1845", "name": "terrestrial animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["terrestrial animals"], "contexts": ["animals living on land"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "animaux terrestres", "target_book": "origin_of_species_darwin_1859", "target_name": "land animals", "similarity": 0.941}, {"source_book": "epoques_nature_buffon_1778", "source_name": "animaux terrestres", "target_book": "kosmos_humboldt_1845", "target_name": "terrestrial animals", "similarity": 0.981}, {"source_book": "origin_of_species_darwin_1859", "source_name": "land animals", "target_book": "kosmos_humboldt_1845", "target_name": "terrestrial animals", "similarity": 0.958}], "id": 1228, "stable_key": "clu_f0e683f08ab7e06c", "ground_truth": {"modern_name": "Terrestrial animals", "confidence": "high", "type": "animal", "note": "This cluster represents the general category of animals living on land, as indicated by the French, English, and German terms. The contexts refer to their presence in geological layers and general fauna.", "wikidata_id": "Q3248864", "wikidata_description": "animals living on land", "wikipedia_url": "https://en.wikipedia.org/wiki/Terrestrial%20animal"}}, {"canonical_name": "madr\u00e9pores", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "madr\u00e9pores", "book_id": "epoques_nature_buffon_1778", "name": "madr\u00e9pores", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["madr\u00e9pores"], "contexts": ["reef-building polyps", "marine invertebrates that form stony structures"]}, {"entity_id": "madr\u00e9pores", "book_id": "relation_historique_humboldt_vol3_1825", "name": "madr\u00e9pores", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 8, "variants": ["madr\u00e9pores"], "contexts": ["marine invertebrates forming reefs", "fossil organism, first traces of organization"]}, {"entity_id": "madrepores", "book_id": "connexion_physical_sciences_somerville_1858", "name": "madrepores", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["madrepores"], "contexts": ["marine invertebrates forming reefs"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "madr\u00e9pores", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "madr\u00e9pores", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "madr\u00e9pores", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "madrepores", "similarity": 0.62}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "madr\u00e9pores", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "madrepores", "similarity": 0.62}], "id": 1229, "stable_key": "clu_89127756043f1c90", "ground_truth": {"modern_name": "Madreporaria", "confidence": "high", "type": "animal", "note": "Refers to stony corals, a subclass of Anthozoa.", "wikidata_id": "Q137922301", "wikidata_description": "scholarly article published on 28 October 1939", "wikipedia_extract": "Scleractinia, also called stony corals or hard corals, are marine animals in the phylum Cnidaria that build themselves a hard skeleton. The individual animals are known as polyps and have a cylindrical body crowned by an oral disc in which a mouth is fringed with tentacles. Although some species are solitary, most are colonial. The founding polyp settles and starts to secrete calcium carbonate to protect its soft body. Solitary corals can be as much as 25 cm (10 in) across but in colonial species the polyps are usually only a few millimetres in diameter. These polyps reproduce asexually by budding, but remain attached to each other, forming a multi-polyp colony of clones with a common skeleton, which may be up to several metres in diameter or height according to species."}}, {"canonical_name": "semilla", "category": "PLANT", "subcategory": "SEED", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "graine", "book_id": "epoques_nature_buffon_1778", "name": "graine", "category": "PLANT", "subcategory": "SEED", "count": 2, "variants": ["graine"], "contexts": ["seed of wheat, conserves power to reproduce", "plant reproductive unit"]}, {"entity_id": "semilla", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "semilla", "category": "PLANT", "subcategory": "SEED", "count": 8, "variants": ["semilla"], "contexts": ["part of a plant", "seed of the plant"]}, {"entity_id": "semilla", "book_id": "historia_medicinal_monardes_1574", "name": "semilla", "category": "PLANT", "subcategory": "SEED", "count": 1, "variants": ["semilla"], "contexts": ["seed used to make oil"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "graine", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "semilla", "similarity": 0.963}, {"source_book": "epoques_nature_buffon_1778", "source_name": "graine", "target_book": "historia_medicinal_monardes_1574", "target_name": "semilla", "similarity": 0.963}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "semilla", "target_book": "historia_medicinal_monardes_1574", "target_name": "semilla", "similarity": 1.0}], "id": 1230, "stable_key": "clu_fd25c4af762ba6d2-3", "ground_truth": {"modern_name": "Seed", "confidence": "high", "type": "plant", "note": "This cluster refers to the botanical seed, a fundamental part of plant reproduction and dispersal, as well as the early stage of a plant's life.", "wikidata_id": "Q40763", "wikidata_description": "embryonic plant enclosed in a protective outer covering (seed coat)", "wikipedia_url": "https://en.wikipedia.org/wiki/Seed", "wikipedia_extract": "In botany, a seed is a plant structure containing an embryo and stored nutrients in a protective coat called a testa. More generally, the term seed means anything that can be sown, which may include seed and husk or tuber. Seeds are the product of the ripened ovule, after the embryo sac is fertilized by sperm from pollen, forming a zygote. The embryo within a seed develops from the zygote and grows within the mother plant to a certain size before growth is halted. The formation of the seed is the defining part of the process of reproduction in seed plants (spermatophytes). Other plants such as ferns, mosses and liverworts, do not have seeds and use water-dependent means to propagate themselves."}}, {"canonical_name": "scoriae", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "scories", "book_id": "epoques_nature_buffon_1778", "name": "scories", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["scories"], "contexts": ["slags"]}, {"entity_id": "scories", "book_id": "relation_historique_humboldt_vol3_1825", "name": "scories", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["scories"], "contexts": ["volcanic slag"]}, {"entity_id": "scoriae", "book_id": "kosmos_humboldt_1845", "name": "scoriae", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 9, "variants": ["scoriae"], "contexts": ["volcanic rock fragments", "rough, porous volcanic rock"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "scories", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "scories", "similarity": 0.74}, {"source_book": "epoques_nature_buffon_1778", "source_name": "scories", "target_book": "kosmos_humboldt_1845", "target_name": "scoriae", "similarity": 0.916}], "id": 1231, "stable_key": "clu_59e36fcf2d18997a", "ground_truth": {"modern_name": "Slag", "confidence": "high", "type": "mineral", "note": "Scoriae (Latin) and its French cognates refer to volcanic cinders or slag, typically glassy fragments ejected during volcanic eruptions or industrial processes. The context of volcanic slag confirms this.", "wikidata_id": "Q12202", "wikidata_description": "death of a region of brain cells due to poor blood flow", "wikipedia_url": "https://en.wikipedia.org/wiki/Stroke"}}, {"canonical_name": "Rivi\u00e8re des Amazones", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "rivi\u00e8re_des_amazones", "book_id": "epoques_nature_buffon_1778", "name": "rivi\u00e8re des Amazones", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["rivi\u00e8re des Amazones"], "contexts": ["river carrying large trees"]}, {"entity_id": "rivi\u00e8re_des_amazones", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rivi\u00e8re des Amazones", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["Rivi\u00e8re des Amazones", "RIVI\u00c8RE DES AMAZONES", "Riviere des Amazones", "rivi\u00e8re de Hudson", "rivi\u00e8re de l'Amazone", "rivi\u00e8re des Amazones", "rivi\u00e8re des Illinois"], "contexts": ["River explored by Pinson", "river in South America"]}, {"entity_id": "river_amazons", "book_id": "connexion_physical_sciences_somerville_1858", "name": "river Amazons", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["river Amazons"], "contexts": ["river with woody regions"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "rivi\u00e8re des Amazones", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Rivi\u00e8re des Amazones", "similarity": 0.981}, {"source_book": "epoques_nature_buffon_1778", "source_name": "rivi\u00e8re des Amazones", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "river Amazons", "similarity": 0.971}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rivi\u00e8re des Amazones", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "river Amazons", "similarity": 0.953}], "id": 1232, "stable_key": "clu_79bbdfa7c65b19d0-2", "ground_truth": {"modern_name": "Amazon River", "confidence": "high", "type": "place", "country": "Brazil", "note": "The French 'Amazone' and 'Rivi\u00e8re des Amazones' directly translate to Amazon and River of the Amazons.", "wikidata_id": "Q205329", "wikidata_description": "species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Amazon%20river%20dolphin", "wikipedia_extract": "The Amazon River (UK: , US: ; Portuguese: rio Amazonas, Spanish: r\u00edo Amazonas) in South America is the largest river by discharge volume of water in the world, and the longest or second-longest river system in the world, a title which is disputed with the Nile. The headwaters of the Apur\u00edmac River on Nevado Mismi had been considered, for nearly a century, the Amazon basin's most distant source until a 2014 study found it to be the headwaters of the Mantaro River on the Cordillera Rumi Cruz in Peru. The Mantaro and Apur\u00edmac rivers join, and with other tributaries form the Ucayali River, which in turn meets the Mara\u00f1\u00f3n River upstream of Iquitos, Peru, forming what countries other than Brazil consider to be the main stem of the Amazon. Brazilians call this section the Solim\u00f5es River above its confluence with the Rio Negro forming what Brazilians call the Amazon at the Meeting of Waters (Portuguese: Encontro das \u00c1guas) at Manaus, the largest city on the river. The Amazon River has an average discharge of about 215,000\u2013230,000 m3/s (7,600,000\u20138,100,000 cu ft/s)\u2014approximately 6,591\u20137,570 km3 (1,581\u20131,816 cu mi) per year, greater than the next seven largest independent rivers combined. Two of the top ten rivers by discharge are tributaries of the Amazon river."}}, {"canonical_name": "fossil remains", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "fossiles", "book_id": "epoques_nature_buffon_1778", "name": "fossiles", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["fossiles"], "contexts": ["remains of ancient organisms"]}, {"entity_id": "fossil_remains", "book_id": "origin_of_species_darwin_1859", "name": "fossil remains", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["fossil remains"], "contexts": ["remains of ancient organisms", "remains in marine formations"]}, {"entity_id": "fossils", "book_id": "origin_of_species_darwin_1859", "name": "fossils", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["fossils"], "contexts": ["remains of ancient organisms"]}, {"entity_id": "fossiliferous_deposits", "book_id": "origin_of_species_darwin_1859", "name": "fossiliferous deposits", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["fossiliferous deposits"], "contexts": ["sediments containing fossils"]}, {"entity_id": "fossil_remains", "book_id": "kosmos_humboldt_1845", "name": "fossil remains", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["Fossil remains", "fossil remains"], "contexts": ["preserved remains of ancient organisms", "remains of ancient organisms"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "fossiles", "target_book": "origin_of_species_darwin_1859", "target_name": "fossil remains", "similarity": 0.949}, {"source_book": "epoques_nature_buffon_1778", "source_name": "fossiles", "target_book": "origin_of_species_darwin_1859", "target_name": "fossils", "similarity": 0.997}, {"source_book": "epoques_nature_buffon_1778", "source_name": "fossiles", "target_book": "origin_of_species_darwin_1859", "target_name": "fossiliferous deposits", "similarity": 0.915}, {"source_book": "epoques_nature_buffon_1778", "source_name": "fossiles", "target_book": "kosmos_humboldt_1845", "target_name": "fossil remains", "similarity": 0.949}, {"source_book": "origin_of_species_darwin_1859", "source_name": "fossil remains", "target_book": "kosmos_humboldt_1845", "target_name": "fossil remains", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "fossils", "target_book": "kosmos_humboldt_1845", "target_name": "fossil remains", "similarity": 0.955}, {"source_book": "origin_of_species_darwin_1859", "source_name": "fossiliferous deposits", "target_book": "kosmos_humboldt_1845", "target_name": "fossil remains", "similarity": 0.888}], "id": 1233, "stable_key": "clu_4ad4c516905284c5", "ground_truth": {"modern_name": "Fossils", "confidence": "high", "type": "concept", "note": "Early modern texts often used 'p\u00e9trifications' to refer to organic matter that had been mineralized or fossilized, including things like fossilized bones and shells.", "wikidata_id": "Q126956840", "wikidata_description": "fictional disease from Lies of P"}}, {"canonical_name": "French", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "french", "book_id": "english_physician_1652", "name": "French", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 6, "variants": ["French"], "contexts": ["nationality of Hollerius", "people who eat the herb"]}, {"entity_id": "france\u017fes", "book_id": "historia_medicinal_monardes_1574", "name": "France\u017fes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["France\u017fes", "Frances", "Franceses"], "contexts": ["called the tree Sassafras", "learned from the Indios"]}, {"entity_id": "francez", "book_id": "polyanthea_medicinal", "name": "Francez", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Francez"], "contexts": ["nationality of Samuel, a feather merchant"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "French", "target_book": "historia_medicinal_monardes_1574", "target_name": "France\u017fes", "similarity": 0.949}, {"source_book": "english_physician_1652", "source_name": "French", "target_book": "polyanthea_medicinal", "target_name": "Francez", "similarity": 0.95}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "France\u017fes", "target_book": "polyanthea_medicinal", "target_name": "Francez", "similarity": 0.928}], "id": 1234, "stable_key": "clu_d7c508e0ceaa8340", "ground_truth": {"modern_name": "French", "confidence": "high", "type": "concept", "note": "Refers to nationality or origin, not a specific person.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/French_people", "wikipedia_extract": "French people (French: Les Fran\u00e7ais, lit. 'The French') are a nation primarily located in Western Europe that share a common French culture, history, and language, identified with the country of France. The French people, especially the native speakers of langues d'o\u00efl from northern and central France, are primarily descended from Romans (or Gallo-Romans, western European Celtic and Italic peoples), Gauls (including the Belgae), as well as Germanic peoples such as the Franks, the Visigoths, the Suebi and the Burgundians who settled in Gaul from east of the Rhine after the fall of the Roman Empire, as well as various later waves of lower-level irregular migration that have continued to the present day. The Norsemen also settled in Normandy in the 10th century and contributed significantly to the ancestry of the Normans. Furthermore, regional ethnic minorities also exist within France that have distinct lineages, languages and cultures such as Bretons in Brittany, Occitans in Occitania, Basques in the French Basque Country, Catalans in northern Catalonia, Germans in Alsace, Corsicans in Corsica and Flemings in French Flanders. France has long been a patchwork of local customs and regional differences, and while most French people still speak the French language as their mother tongue, languages like Picard, Poitevin-Saintongeais, Franco-Provencal, Occitan, Catalan, Auvergnat, Corsican, Basque, French Flemish, Lorraine Franconian, Alsatian, Norman, and Breton remain spoken in their respective regions."}}, {"canonical_name": "Euphorbio", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "euphorbium", "book_id": "english_physician_1652", "name": "Euphorbium", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Euphorbium"], "contexts": ["plant resin", "plant used in a medicinal preparation"]}, {"entity_id": "euphorbiaceae", "book_id": "coloquios_da_orta_1563", "name": "Euphorbiaceae", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Euphorbiaceae", "Euphorbia"], "contexts": ["plant family", "European plant genus"]}, {"entity_id": "euphorbio", "book_id": "ricettario_fiorentino_1597", "name": "Euphorbio", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["Euphorbio", "Euforbie", "Euphoibio", "Euphorbie", "Euphorbio frefco"], "contexts": ["euphorbium, used in pills", "euphorbia plant"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Euphorbium", "target_book": "ricettario_fiorentino_1597", "target_name": "Euphorbio", "similarity": 0.928}, {"source_book": "coloquios_da_orta_1563", "source_name": "Euphorbiaceae", "target_book": "ricettario_fiorentino_1597", "target_name": "Euphorbio", "similarity": 0.888}], "id": 1235, "stable_key": "clu_41bd4a54e8bc952c", "ground_truth": {"modern_name": "euphorbium", "confidence": "high", "type": "plant", "linnaean": "Euphorbia", "family": "Euphorbiaceae", "description": "A plant and its medicinal resin, used as a purge.", "note": "Refers to both the plant genus and the medicinal resin derived from it.", "wikipedia_extract": "Euphorbia is a large and diverse genus of flowering plants, commonly called spurge, in the family Euphorbiaceae. Euphorbias range from tiny annual plants to large and long-lived trees, with perhaps the tallest being Euphorbia ampliphylla at 30 m (98 ft) or more. The genus has roughly 2,000 members, making it one of the largest genera of flowering plants. It also has one of the largest ranges of chromosome counts, along with Rumex and Senecio. Euphorbia antiquorum is the type species for the genus Euphorbia. It was first described by Carl Linnaeus in 1753 in Species Plantarum."}}, {"canonical_name": "Ostrich", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "ostrich", "book_id": "origin_of_species_darwin_1859", "name": "Ostrich", "category": "ANIMAL", "subcategory": "BIRD", "count": 7, "variants": ["ostrich", "Ostrich"], "contexts": ["large flightless bird", "bird that lays a score of eggs"]}, {"entity_id": "american_ostrich", "book_id": "origin_of_species_darwin_1859", "name": "American ostrich", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["American ostrich"], "contexts": ["ostrich species with imperfect nesting instinct"]}, {"entity_id": "ostrich", "book_id": "kosmos_humboldt_1845", "name": "ostrich", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["ostrich"], "contexts": ["bird resembling dinornis", "animal previously thought to be dodo"]}, {"entity_id": "ostrich", "book_id": "first_principles_spencer_1862", "name": "ostrich", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["ostrich"], "contexts": ["large flightless bird"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Ostrich", "target_book": "kosmos_humboldt_1845", "target_name": "ostrich", "similarity": 0.973}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Ostrich", "target_book": "first_principles_spencer_1862", "target_name": "ostrich", "similarity": 0.973}, {"source_book": "origin_of_species_darwin_1859", "source_name": "American ostrich", "target_book": "kosmos_humboldt_1845", "target_name": "ostrich", "similarity": 0.912}, {"source_book": "origin_of_species_darwin_1859", "source_name": "American ostrich", "target_book": "first_principles_spencer_1862", "target_name": "ostrich", "similarity": 0.912}, {"source_book": "kosmos_humboldt_1845", "source_name": "ostrich", "target_book": "first_principles_spencer_1862", "target_name": "ostrich", "similarity": 1.0}], "id": 1236, "stable_key": "clu_e11e31cab9784b08", "ground_truth": {"modern_name": "Ostrich", "confidence": "high", "type": "animal", "note": "Includes references to 'American ostrich', which belongs to the genus Rhea, but the primary referent is clearly the Ostrich (Struthio).", "wikidata_id": "Q2354075", "wikidata_description": "heraldic animal", "wikipedia_extract": "The common ostrich (Struthio camelus), or simply ostrich, is a species of flightless bird native to certain areas of Africa and is the largest living species of bird and thus the largest living dinosaur. The common ostrich is one of two extant species of ostriches, the only living members of the genus Struthio in the ratite group of birds. The other is the Somali ostrich (Struthio molybdophanes), which has been recognized as a distinct species by BirdLife International since 2014, having been previously considered a distinctive subspecies of ostrich. The common ostrich belongs to the order Struthioniformes. Struthioniformes previously contained all the ratites, such as the kiwis, emus, rheas, and cassowaries. However, a recent genetic analysis has found that the group is not monophyletic, as it is paraphyletic with respect to the tinamous, so the ostriches are now classified as the only members of the order.", "wikipedia_url": "https://en.wikipedia.org/wiki/Common_ostrich"}}, {"canonical_name": "Umbellifera", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "umbellifer\u00e6", "book_id": "origin_of_species_darwin_1859", "name": "Umbellifer\u00e6", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Umbellifer\u00e6", "umbellifer\u00e6"], "contexts": ["plant order with seed differences", "plant family"]}, {"entity_id": "umbelliferous", "book_id": "origin_of_species_darwin_1859", "name": "Umbelliferous", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Umbelliferous"], "contexts": ["family of flowering plants (Apiaceae)"]}, {"entity_id": "umbelliferous_plants", "book_id": "kosmos_humboldt_1845", "name": "umbelliferous plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["umbelliferous plants"], "contexts": ["plants with umbrella-shaped flower clusters"]}, {"entity_id": "umbellifera", "book_id": "coloquios_da_orta_1563", "name": "Umbellifera", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["Umbellifera", "Umbelliferae", "Umbelliferce", "Umbelliferee"], "contexts": ["plant family with aromatic seeds", "plant family, subject of correction"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Umbellifer\u00e6", "target_book": "kosmos_humboldt_1845", "target_name": "umbelliferous plants", "similarity": 0.924}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Umbellifer\u00e6", "target_book": "coloquios_da_orta_1563", "target_name": "Umbellifera", "similarity": 0.948}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Umbelliferous", "target_book": "kosmos_humboldt_1845", "target_name": "umbelliferous plants", "similarity": 0.959}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Umbelliferous", "target_book": "coloquios_da_orta_1563", "target_name": "Umbellifera", "similarity": 0.951}, {"source_book": "kosmos_humboldt_1845", "source_name": "umbelliferous plants", "target_book": "coloquios_da_orta_1563", "target_name": "Umbellifera", "similarity": 0.906}], "id": 1237, "stable_key": "clu_be6c584e36042dae", "ground_truth": {"modern_name": "Apiaceae", "confidence": "high", "type": "plant", "linnaean": "Apiaceae", "family": "Apiaceae", "note": "Early modern texts often referred to families by descriptive names like 'Umbelliferae' or 'Umbellifera'.", "wikidata_id": "Q145794", "wikidata_description": "family of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Apiaceae", "wikipedia_extract": "Apiaceae ( ), also called Umbelliferae, is a family of mostly aromatic flowering plants named after the type genus Apium, and commonly known as the celery, carrot, or parsley family, or simply as umbellifers. It is the 16th-largest family of flowering plants, with more than 3,800 species in about 446 genera, including such well-known, and economically important plants as ajwain, angelica, anise, asafoetida, caraway, carrot, celery, chervil, coriander, cumin, dill, fennel, lovage, cow parsley, parsley, parsnip and sea holly, as well as silphium, a plant whose exact identity is unclear and which may be extinct. The family Apiaceae includes a significant number of phototoxic species, such as giant hogweed, and a smaller number of highly poisonous species, such as poison hemlock, water hemlock, spotted cowbane, fool's parsley, and various species of water dropwort. Most Apiaceae are annual, biennial or perennial herbs (frequently with the leaves aggregated toward the base), though a minority are woody shrubs or small trees such as Bupleurum fruticosum. Their leaves are of variable size, and alternately arranged, or with the upper leaves becoming nearly opposite. The leaves may be petiolate or sessile."}}, {"canonical_name": "disease", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "disease", "book_id": "origin_of_species_darwin_1859", "name": "disease", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["disease"], "contexts": ["affects purple plums and yellow peaches", "abnormal condition of the body"]}, {"entity_id": "disease", "book_id": "principles_of_psychology_james_1890", "name": "disease", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["disease"], "contexts": ["a disorder of structure or function", "impairs automatic agency functions"]}, {"entity_id": "disease", "book_id": "first_principles_spencer_1862", "name": "disease", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["disease"], "contexts": ["abnormal condition of the body", "a pathological condition affecting the body"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "disease", "target_book": "principles_of_psychology_james_1890", "target_name": "disease", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "disease", "target_book": "first_principles_spencer_1862", "target_name": "disease", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "disease", "target_book": "first_principles_spencer_1862", "target_name": "disease", "similarity": 1.0}], "id": 1238, "stable_key": "clu_6da3f96bc12d1192", "ground_truth": {"modern_name": "disease", "confidence": "high", "type": "concept", "note": "This cluster represents the general concept of disease rather than a specific ailment.", "wikidata_id": "Q12136", "wikidata_description": "abnormal condition negatively affecting organisms", "wikipedia_url": "https://en.wikipedia.org/wiki/Disease", "wikipedia_extract": "A disease is a particular abnormal condition that adversely affects the structure or function of all or part of an organism and is not immediately due to any external injury. Diseases are often known to be medical conditions that are associated with specific signs and symptoms. A disease may be caused by external factors such as pathogens or by internal dysfunctions. For example, internal dysfunctions of the immune system can produce a variety of different diseases, including various forms of immunodeficiency, hypersensitivity, allergies, and autoimmune disorders. In humans, disease is often used more broadly to refer to any condition that causes pain, dysfunction, distress, social problems, or death to the person affected, or similar problems for those in contact with the person. In this broader sense, it sometimes includes injuries, disabilities, disorders, syndromes, infections, isolated symptoms, deviant behaviors, and atypical variations of structure and function, while in other contexts and for other purposes these may be considered distinguishable categories.", "modern_term": "Disease"}}, {"canonical_name": "earth's crust", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "earth's_crust", "book_id": "origin_of_species_darwin_1859", "name": "earth's crust", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["earth's crust"], "contexts": ["outer layer of the Earth"]}, {"entity_id": "earth's_crust", "book_id": "kosmos_humboldt_1845", "name": "earth's crust", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["earth's crust", "Earth's crust"], "contexts": ["outer layer of the planet", "outermost layer of the Earth"]}, {"entity_id": "earth\u2019s_crust", "book_id": "first_principles_spencer_1862", "name": "Earth\u2019s crust", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["Earth\u2019s crust"], "contexts": ["outer layer of the planet", "moulded and re-moulded by forces"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "earth's crust", "target_book": "kosmos_humboldt_1845", "target_name": "earth's crust", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "earth's crust", "target_book": "first_principles_spencer_1862", "target_name": "Earth\u2019s crust", "similarity": 0.994}, {"source_book": "kosmos_humboldt_1845", "source_name": "earth's crust", "target_book": "first_principles_spencer_1862", "target_name": "Earth\u2019s crust", "similarity": 0.994}], "id": 1239, "stable_key": "clu_9d264411fec96159", "ground_truth": {"modern_name": "Earth's crust", "confidence": "high", "type": "concept"}}, {"canonical_name": "hauteur", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "height", "book_id": "origin_of_species_darwin_1859", "name": "height", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["height"], "contexts": ["vertical dimension of landforms"]}, {"entity_id": "hauteur", "book_id": "relation_historique_humboldt_vol3_1825", "name": "hauteur", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["hauteur", "hauteur barom\u00e9trique", "hauteur barom\u00e9trique moyenne", "hauteur solsticiales", "hauteurs moyennes"], "contexts": ["geographic coordinate (altitude)", "measurement for temperate sites"]}, {"entity_id": "heights", "book_id": "connexion_physical_sciences_somerville_1858", "name": "heights", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Heights", "heights"], "contexts": ["vertical distances", "mode of ascertaining by Fahrenheit"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "height", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "hauteur", "similarity": 0.962}, {"source_book": "origin_of_species_darwin_1859", "source_name": "height", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "heights", "similarity": 0.94}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "hauteur", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "heights", "similarity": 0.941}], "id": 1240, "stable_key": "clu_4ed66a67dd727ccd", "ground_truth": {"modern_name": "altitude", "confidence": "high", "type": "concept", "note": "The texts refer to the vertical dimension of landforms and geographic coordinates, which directly relates to altitude.", "wikidata_id": "Q190200", "wikidata_description": "height in relation to a certain reference point", "wikipedia_url": "https://en.wikipedia.org/wiki/Altitude", "wikipedia_extract": "Altitude is a distance measurement, usually in the vertical or \"up\" direction, between a reference datum and a point or object. The exact definition and reference datum varies according to the context (e.g., aviation, geometry, geographical survey, sport, or atmospheric pressure). Although the term altitude is commonly used to mean the height above sea level of a location, in geography the term elevation is often preferred for this usage. In aviation, altitude is typically measured relative to mean sea level or above ground level to ensure safe navigation and flight operations. In geometry and geographical surveys, altitude helps create accurate topographic maps and understand the terrain's elevation. For high-altitude trekking and sports, knowing and adapting to altitude is vital for performance and safety."}}, {"canonical_name": "humidad", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "humidad", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "humidad", "category": "CONCEPT", "subcategory": "QUALITY", "count": 5, "variants": ["humidad"], "contexts": ["moist quality", "moisture to be removed from roots"]}, {"entity_id": "humidad", "book_id": "historia_medicinal_monardes_1574", "name": "humidad", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["humidad"], "contexts": ["moisture", "consumes its superfluous humidity"]}, {"entity_id": "humidade", "book_id": "coloquios_da_orta_1563", "name": "humidade", "category": "CONCEPT", "subcategory": "QUALITY", "count": 4, "variants": ["humidade"], "contexts": ["primary quality: moisture", "property of gengivre"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "humidad", "target_book": "historia_medicinal_monardes_1574", "target_name": "humidad", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "humidad", "target_book": "coloquios_da_orta_1563", "target_name": "humidade", "similarity": 0.997}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "humidad", "target_book": "coloquios_da_orta_1563", "target_name": "humidade", "similarity": 0.997}], "id": 1241, "stable_key": "clu_7c50c9966182ad91", "ground_truth": {"modern_name": "Humidity", "confidence": "high", "type": "concept", "wikidata_id": "Q180600", "wikidata_description": "amount of water vapor in the air", "wikipedia_url": "https://en.wikipedia.org/wiki/Humidity", "wikipedia_extract": "Humidity is the concentration of water vapor present in the air. Water vapor, the gaseous state of water, is generally invisible to the naked eye. Humidity indicates the likelihood for precipitation, dew, or fog to be present. Humidity depends on the temperature and pressure of the system of interest. The same amount of water vapor results in higher relative humidity in cool air than warm air. A related parameter is the dew point."}}, {"canonical_name": "Tercianas", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "tercianas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "tercianas", "category": "DISEASE", "subcategory": "ACUTE", "count": 3, "variants": ["tercianas"], "contexts": ["tertian fever, likely malaria", "fever, likely malaria"]}, {"entity_id": "tercianas", "book_id": "historia_medicinal_monardes_1574", "name": "Tercianas", "category": "DISEASE", "subcategory": "ACUTE", "count": 6, "variants": ["Tercianas", "Teracianas", "Tercianas nothas", "terciana"], "contexts": ["tertian fevers", "fevers that were importunate"]}, {"entity_id": "tertiana", "book_id": "polyanthea_medicinal", "name": "Tertiana", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["Tertiana"], "contexts": ["type of fever", "third-day fever"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "tercianas", "target_book": "historia_medicinal_monardes_1574", "target_name": "Tercianas", "similarity": 0.98}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Tercianas", "target_book": "polyanthea_medicinal", "target_name": "Tertiana", "similarity": 0.898}], "id": 1242, "stable_key": "clu_0bd879acc59d72f2", "ground_truth": {"modern_name": "Tertian Fever", "confidence": "high", "type": "disease", "description": "A fever characterized by recurring chills and heats every third day.", "note": "Specifically refers to fevers with a 48-hour cycle, often malaria.", "wikipedia_extract": "The history of malaria extends from its prehistoric origin as a zoonotic disease in the primates of Africa through to the 21st century. A widespread and potentially lethal human infectious disease, at its peak malaria infested every continent except Antarctica. Its prevention and treatment have been targeted in science and medicine for hundreds of years. Since the discovery of the Plasmodium parasites which cause it, research attention has focused on their biology as well as that of the mosquitoes which transmit the parasites. References to its unique, periodic fevers are found throughout recorded history, beginning in the first millennium BC in Greece and China. For thousands of years, traditional herbal remedies have been used to treat malaria."}}, {"canonical_name": "Xaraue", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "xaraue", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "xaraue", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["xaraue"], "contexts": ["syrup for taking medicine", "syrup preparation"]}, {"entity_id": "xaraues", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "xaraues", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["xaraues"], "contexts": ["syrups"]}, {"entity_id": "xaraue", "book_id": "historia_medicinal_monardes_1574", "name": "Xaraue", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 5, "variants": ["Xaraue", "xaraue", "xaraues"], "contexts": ["sweet liquid preparation", "syrup for medicinal preparations"]}, {"entity_id": "xar\u00e1o", "book_id": "coloquios_da_orta_1563", "name": "xar\u00e1o", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["xar\u00e1o", "xardo"], "contexts": ["stronger distilled spirit", "word for drink, derived from Arabic"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "xaraue", "target_book": "historia_medicinal_monardes_1574", "target_name": "Xaraue", "similarity": 0.98}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "xaraue", "target_book": "coloquios_da_orta_1563", "target_name": "xar\u00e1o", "similarity": 0.89}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "xaraues", "target_book": "historia_medicinal_monardes_1574", "target_name": "Xaraue", "similarity": 0.93}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Xaraue", "target_book": "coloquios_da_orta_1563", "target_name": "xar\u00e1o", "similarity": 0.891}], "id": 1243, "stable_key": "clu_175fecfaa2fa97b2", "ground_truth": {"modern_name": "Xaraue", "confidence": "high", "type": "substance", "description": "A sweet, distilled liquid preparation, likely a spirit or syrup.", "note": "Derived from Arabic 'xar\u00e1o' meaning drink."}}, {"canonical_name": "doen\u00e7as agudas", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "enfermedades_agudas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "enfermedades agudas", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["enfermedades agudas"], "contexts": ["acute illnesses treated with cacao drink", "acute illnesses"]}, {"entity_id": "enfermedades_agudas", "book_id": "historia_medicinal_monardes_1574", "name": "enfermedades agudas", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["enfermedades agudas"], "contexts": ["acute illnesses treated with gargaparrilla water", "acute illnesses requiring immediate attention"]}, {"entity_id": "doen\u00e7as_agudas", "book_id": "polyanthea_medicinal", "name": "doen\u00e7as agudas", "category": "DISEASE", "subcategory": "ACUTE", "count": 7, "variants": ["doen\u00e7as agudas", "doen\u00e7a aguda", "doen\u00e7as pe\u017ftilentes"], "contexts": ["acute illnesses", "pestilential diseases"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "enfermedades agudas", "target_book": "historia_medicinal_monardes_1574", "target_name": "enfermedades agudas", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "enfermedades agudas", "target_book": "polyanthea_medicinal", "target_name": "doen\u00e7as agudas", "similarity": 0.997}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "enfermedades agudas", "target_book": "polyanthea_medicinal", "target_name": "doen\u00e7as agudas", "similarity": 0.997}], "id": 1244, "stable_key": "clu_ac8b165a1b9e9bb5", "ground_truth": {"modern_name": "acute illness", "confidence": "high", "type": "disease", "modern_term": "acute illness"}}, {"canonical_name": "escammonea", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "escamonea", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "escamonea", "category": "PLANT", "subcategory": "HERB", "count": 2, "variants": ["escamonea"], "contexts": ["plant used as a purgative", "root similar to scammony"]}, {"entity_id": "escamonio", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "escamonio", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["escamonio"], "contexts": ["plant with two varieties", "plant with similar leaves to neyzotlaltpatli"]}, {"entity_id": "escamonea", "book_id": "coloquios_da_orta_1563", "name": "escamonea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["escamonea"], "contexts": ["herb used as purgative", "plant used for purging"]}, {"entity_id": "escammonea", "book_id": "polyanthea_medicinal", "name": "escammonea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["escammonea", "Scammonea", "escamonea", "scammonen", "scamonea"], "contexts": ["violent plant substance", "herb used for purging"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "escamonea", "target_book": "coloquios_da_orta_1563", "target_name": "escamonea", "similarity": 0.826}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "escamonio", "target_book": "coloquios_da_orta_1563", "target_name": "escamonea", "similarity": 0.91}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "escamonio", "target_book": "polyanthea_medicinal", "target_name": "escammonea", "similarity": 0.886}, {"source_book": "coloquios_da_orta_1563", "source_name": "escamonea", "target_book": "polyanthea_medicinal", "target_name": "escammonea", "similarity": 0.942}], "id": 1245, "stable_key": "clu_d62efe6813d1d3c4", "ground_truth": {"modern_name": "Scammony", "confidence": "high", "type": "plant", "linnaean": "Convolvulus scammonia", "family": "Convolvulaceae", "description": "Resinous purgative obtained from the root of a bindweed plant.", "wikipedia_extract": "Convolvulus scammonia, commonly known as scammony, is a bindweed native to the countries of the eastern part of the Mediterranean basin; it grows in bushy waste places, from Syria in the south to Crimea in the north, its range extending westward to the Greek islands, but not to northern Africa or Italy. It is a twining perennial, bearing flowers like those of Convolvulus arvensis, and having irregularly arrow-shaped leaves and a thick fleshy root. A cathartic resinous tincture known as scammoniae resina, which is obtained from the dried root by digestion with ethanol has been used as a traditional medicine. Upon consumption, the resin is inert until it has passed from the stomach into the duodenum, where it meets the bile. A chemical reaction occurs between it and taurocholate and glycocholate in the bile, whereby it is converted into a powerful purgative which in high doses becomes a violent gastrointestinal irritant. Scammony kills both roundworm and tapeworm, especially the former, and it was therefore used as an anthelmintic."}}, {"canonical_name": "Principes", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "principes", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Principes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Principes"], "contexts": ["princes of Mexico"]}, {"entity_id": "principes", "book_id": "historia_medicinal_monardes_1574", "name": "Principes", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Principes"], "contexts": ["rulers who can be poisoned"]}, {"entity_id": "principes", "book_id": "polyanthea_medicinal", "name": "Principes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 9, "variants": ["Principes", "Principe", "Principe de Ligne", "principiantes"], "contexts": ["princes", "rulers"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Principes", "target_book": "historia_medicinal_monardes_1574", "target_name": "Principes", "similarity": 0.78}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Principes", "target_book": "polyanthea_medicinal", "target_name": "Principes", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Principes", "target_book": "polyanthea_medicinal", "target_name": "Principes", "similarity": 0.78}], "id": 1246, "stable_key": "clu_d270e55c439c1c90", "ground_truth": {"modern_name": "Princes", "confidence": "high", "type": "person", "description": "Rulers of noble birth, capable of being poisoned.", "note": "While 'Princes' can refer to any primary principle or leader, in the context of poison and rulership, it clearly indicates royal or noble figures.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Toluca", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "ttztoluca", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Ttztoluca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Ttztoluca"], "contexts": ["location where the plant grows"]}, {"entity_id": "toluca", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Toluca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["Toluca", "Tolu", "Tol\u00f9"], "contexts": ["city with road construction", "city in Mexico"]}, {"entity_id": "toluca", "book_id": "kosmos_humboldt_1845", "name": "Toluca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Toluca"], "contexts": ["volcano with rocky pinnacles"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Ttztoluca", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Toluca", "similarity": 0.902}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Ttztoluca", "target_book": "kosmos_humboldt_1845", "target_name": "Toluca", "similarity": 0.902}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Toluca", "target_book": "kosmos_humboldt_1845", "target_name": "Toluca", "similarity": 1.0}], "id": 1247, "stable_key": "clu_c6b015c96d24fe8f", "ground_truth": {"modern_name": "Toluca de Lerdo", "confidence": "high", "type": "place", "country": "Mexico", "note": "References to Humboldt's works in the 19th century clearly indicate the city and volcano in Mexico."}}, {"canonical_name": "S. Francisco", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "francisco", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Francisco", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Francisco"], "contexts": ["King of France"]}, {"entity_id": "s__francisco", "book_id": "coloquios_da_orta_1563", "name": "S. Francisco", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 5, "variants": ["S. Francisco"], "contexts": ["convent in La Vega", "order of friars"]}, {"entity_id": "francisco_i", "book_id": "coloquios_da_orta_1563", "name": "Francisco I", "category": "PERSON", "subcategory": "PATRON", "count": 4, "variants": ["Francisco I"], "contexts": ["king who requested to see the rhinoceros", "issued an edict on prices"]}, {"entity_id": "francisco", "book_id": "polyanthea_medicinal", "name": "Francisco", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Francisco"], "contexts": ["individual with a specific stomach ferment"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Francisco", "target_book": "coloquios_da_orta_1563", "target_name": "Francisco I", "similarity": 0.885}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Francisco", "target_book": "polyanthea_medicinal", "target_name": "Francisco", "similarity": 0.712}, {"source_book": "coloquios_da_orta_1563", "source_name": "S. Francisco", "target_book": "polyanthea_medicinal", "target_name": "Francisco", "similarity": 0.892}], "id": 1248, "stable_key": "clu_89c1e0e5a31361e0", "ground_truth": {"modern_name": "Francis of Assisi", "confidence": "high", "type": "person", "birth_year": 1181, "death_year": 1226, "description": "Founder of the Franciscan Order, patron saint of animals.", "note": "The text refers to both a convent and an individual, likely a saint for devotion.", "wikidata_id": "Q676555", "wikidata_description": "Italian Catholic saint, friar, deacon and preacher and founder of the Franciscan Order (1181/2\u20131226)"}}, {"canonical_name": "blanco", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "blanca", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "blanca", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["blanca"], "contexts": ["white seed"]}, {"entity_id": "blancas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "blancas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["blancas"], "contexts": ["white flowers outside"]}, {"entity_id": "blanco", "book_id": "relation_historique_humboldt_vol3_1825", "name": "blanco", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["blanco", "blanche"], "contexts": ["type of sugar", "white sugar"]}, {"entity_id": "white", "book_id": "connexion_physical_sciences_somerville_1858", "name": "White", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["white", "White"], "contexts": ["color with accidental black", "produced by combining complementary colors"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "blanca", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "blanco", "similarity": 0.938}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "blanca", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "White", "similarity": 0.95}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "blancas", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "blanco", "similarity": 0.888}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "blancas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "White", "similarity": 0.903}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "blanco", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "White", "similarity": 0.949}], "id": 1249, "stable_key": "clu_d1ae8bd67615bf5d", "ground_truth": {"modern_name": "White substance", "confidence": "medium", "type": "concept", "note": "The term 'blanco' (Spanish) and 'White' (English) are highly ambiguous. The contexts 'white seed', 'white flowers outside', and 'type of sugar' suggest a general descriptor for something white, rather than a specific named substance or plant. Without more specific botanical or chemical context, it remains general."}}, {"canonical_name": "alcaparras", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "alcaparras", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "alcaparras", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["alcaparras"], "contexts": ["flowers smell like capers"]}, {"entity_id": "alcaparras", "book_id": "coloquios_da_orta_1563", "name": "alcaparras", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["alcaparras"], "contexts": ["flower buds", "appetite stimulant"]}, {"entity_id": "alcaparras", "book_id": "polyanthea_medicinal", "name": "alcaparras", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["alcaparras", "alcaravia"], "contexts": ["root used for unblocking", "food with deobstructing properties"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "alcaparras", "target_book": "coloquios_da_orta_1563", "target_name": "alcaparras", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "alcaparras", "target_book": "polyanthea_medicinal", "target_name": "alcaparras", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "alcaparras", "target_book": "polyanthea_medicinal", "target_name": "alcaparras", "similarity": 1.0}], "id": 1250, "stable_key": "clu_4fb1e28ecec1bbb1", "ground_truth": {"modern_name": "Capers", "confidence": "high", "type": "plant", "linnaean": "Capparis spinosa", "family": "Capparaceae", "description": "Flower buds and root of a shrub used in cuisine and medicine.", "wikipedia_extract": "Capparis spinosa, the caper bush, also called Flinders rose, is a perennial plant that bears rounded, fleshy leaves and large white to pinkish-white flowers. The taxonomic status of the species is controversial and unsettled. Species within the genus Capparis are highly variable, and interspecific hybrids have been common throughout the evolutionary history of the genus. As a result, some authors have considered C. spinosa to be composed of multiple distinct species, others that the taxon is a single species with multiple varieties or subspecies, or that the taxon C. spinosa is a hybrid between C. orientalis and C. sicula. Capparis spinosa is native to almost all the circum-Mediterranean countries, and is included in the flora of most of them, but whether it is indigenous to this region is uncertain. The family Capparaceae could have originated in the tropics and later spread to the Mediterranean basin."}}, {"canonical_name": "mordeduras de cobras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "mordeduras_de_las_serpientes", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "mordeduras de las serpientes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["mordeduras de las serpientes"], "contexts": ["snake bites treated with remedies"]}, {"entity_id": "mordeduras_de_cobras", "book_id": "coloquios_da_orta_1563", "name": "mordeduras de cobras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 9, "variants": ["mordeduras de cobras", "mordedura da bicha", "mordedura de bicha", "mordedura de culebras", "mordeduras de cobras venenosas", "mordiduras pe\u00e7onhentas"], "contexts": ["injury from snake bites", "condition treated by the plant"]}, {"entity_id": "mordeduras_da_vibora", "book_id": "polyanthea_medicinal", "name": "mordeduras da vibora", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["mordeduras da vibora"], "contexts": ["viper bites"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "mordeduras de las serpientes", "target_book": "coloquios_da_orta_1563", "target_name": "mordeduras de cobras", "similarity": 0.89}, {"source_book": "coloquios_da_orta_1563", "source_name": "mordeduras de cobras", "target_book": "polyanthea_medicinal", "target_name": "mordeduras da vibora", "similarity": 0.886}], "id": 1251, "stable_key": "clu_e63a88766d8c8a9c", "ground_truth": {"modern_name": "Snakebite", "confidence": "high", "type": "disease", "modern_term": "Snakebite", "note": "Both 'mordeduras de cobras' and 'mordeduras da vibora' directly translate to snake or viper bites, a recognized medical concern.", "wikidata_id": "Q68854", "wikidata_description": "injury caused by a bite from a snake"}}, {"canonical_name": "Bourbon", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "bourbon", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bourbon", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["BOURBON", "Bourbon"], "contexts": ["location with sugar cultivation", "location of sugar cultivation"]}, {"entity_id": "bourbon", "book_id": "kosmos_humboldt_1845", "name": "Bourbon", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Bourbon"], "contexts": ["island now known as R\u00e9union"]}, {"entity_id": "bourbon", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bourbon", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Bourbon"], "contexts": ["island in the Indian Ocean (R\u00e9union)"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bourbon", "target_book": "kosmos_humboldt_1845", "target_name": "Bourbon", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bourbon", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bourbon", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bourbon", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bourbon", "similarity": 1.0}], "id": 1252, "stable_key": "clu_de3fae7be6ed5cf5", "ground_truth": {"modern_name": "R\u00e9union", "confidence": "high", "type": "place", "country": "France", "note": "Historically referred to as Bourbon Island.", "wikidata_id": "Q17070", "wikidata_description": "overseas department of France in the Indian Ocean", "wikipedia_url": "https://en.wikipedia.org/wiki/R%C3%A9union", "wikipedia_extract": "R\u00e9union (; French: [la \u0281e.ynj\u0254\u0303] ; Reunionese Creole: La R\u00e9nyon; known as \u00cele Bourbon before 1848) is an island in the Indian Ocean that is an overseas department and region of France within the African region. Part of the Mascarene Islands, it is located approximately 679 kilometres (367 nautical miles) east of the island of Madagascar and 175 kilometres (94 nmi) southwest of the island of Mauritius. As of January 2026, it had a population of 910,985. Its capital and largest city is Saint-Denis. Before the arrival of French colonial subjects and immigrants in the 17th century, R\u00e9union was an uninhabited island. Its tropical climate led to the development of a plantation economy focused primarily on sugar; slaves from East Africa were imported as fieldworkers, followed by Malays, Vietnamese, Chinese, and Indians as indentured laborers."}}, {"canonical_name": "vins", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "vins", "book_id": "relation_historique_humboldt_vol3_1825", "name": "vins", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 8, "variants": ["vins", "vins d'Europe"], "contexts": ["alcoholic beverage imported and exported", "wines"]}, {"entity_id": "wines", "book_id": "kosmos_humboldt_1845", "name": "wines", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["wines"], "contexts": ["fermented grape beverage"]}, {"entity_id": "wines", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Wines", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["wines", "Wines"], "contexts": ["produced between specific degrees of latitude", "range of cultivation of the best"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "vins", "target_book": "kosmos_humboldt_1845", "target_name": "wines", "similarity": 0.97}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "vins", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Wines", "similarity": 0.963}, {"source_book": "kosmos_humboldt_1845", "source_name": "wines", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Wines", "similarity": 0.992}], "id": 1253, "stable_key": "clu_6110a1f26657a473-3", "ground_truth": {"modern_name": "Wine", "confidence": "high", "type": "chemical", "note": "Both 'vino' and 'Vino' are clearly the Italian and Spanish/Portuguese words for wine, a common medicinal ingredient.", "wikidata_id": "Q282", "wikidata_description": "alcoholic drink typically made from grapes through the fermentation process", "wikipedia_url": "https://en.wikipedia.org/wiki/Wine", "wikipedia_extract": "Wine is an alcoholic drink made from fermented grape juice. It is produced and consumed in many regions around the world, in a wide variety of styles which are influenced by different varieties of grapes, growing environments, viticulture methods, and production techniques. Wine has been produced for thousands of years, the earliest evidence dating from c. 6000 BCE in present-day Georgia. Its popularity spread around the Mediterranean during Classical antiquity, and was sustained in Western Europe by winemaking monks and a secular trade for general drinking. New World wine was established by settler colonies from the 16th century onwards, and the wine trade increased dramatically up to the latter half of the 19th century, when European vineyards were largely destroyed by the invasive pest phylloxera.", "description": "An alcoholic beverage made from fermented grapes."}}, {"canonical_name": "Marseille", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "marseille", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Marseille", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Marseille"], "contexts": ["market for Crimean flour", "city in France"]}, {"entity_id": "marseilles", "book_id": "kosmos_humboldt_1845", "name": "Marseilles", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Marseilles"], "contexts": ["coast mentioned", "city on the Mediterranean coast"]}, {"entity_id": "marseilles", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Marseilles", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Marseilles"], "contexts": ["location of comet sighting", "location of comet observation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Marseille", "target_book": "kosmos_humboldt_1845", "target_name": "Marseilles", "similarity": 0.988}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Marseille", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Marseilles", "similarity": 0.988}, {"source_book": "kosmos_humboldt_1845", "source_name": "Marseilles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Marseilles", "similarity": 1.0}], "id": 1254, "stable_key": "clu_ca0cccab219127c3", "ground_truth": {"modern_name": "Marseille", "confidence": "high", "type": "place", "description": "Major port city in southern France.", "wikipedia_extract": "Marseille (Proven\u00e7al Occitan: Marselha; see below) is a city in southern France, the prefecture of the department of Bouches-du-Rh\u00f4ne and of the Provence-Alpes-C\u00f4te d'Azur region. Situated in the Provence region, it is located on the coast of the Mediterranean Sea, near the mouth of the Rh\u00f4ne river. Marseille is the second-most populous city proper in France, after Paris, with 877,215 inhabitants in 2022 (Jan. census) over a municipal territory of 241 km2 (93 sq mi). Together with its suburbs and exurbs, the Marseille metropolitan area, which extends over 3,972 km2 (1,534 sq mi), had a population of 1,900,957 at the Jan. 2022 census. The cities of Marseille, Aix-en-Provence, and 90 suburban municipalities have formed since 2016 the Aix-Marseille-Provence Metropolis, an indirectly elected metropolitan authority now in charge of wider metropolitan issues, with a population of 1,922,626 at the Jan. 2022 census. Founded c.\u2009600 BC by Greek settlers from Phocaea, Marseille is the oldest city in France, as well as one of Europe's oldest continuously inhabited settlements."}}, {"canonical_name": "Connecticut", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "connecticut", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Connecticut", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Connecticut"], "contexts": ["state in the United States", "state in New England"]}, {"entity_id": "connecticut", "book_id": "principles_of_psychology_james_1890", "name": "Connecticut", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Connecticut"], "contexts": ["state in the United States"]}, {"entity_id": "connecticut", "book_id": "kosmos_humboldt_1845", "name": "Connecticut", "category": "PLACE", "subcategory": "COUNTRY", "count": 7, "variants": ["Connecticut"], "contexts": ["state where New Haven is located", "state in the United States"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Connecticut", "target_book": "principles_of_psychology_james_1890", "target_name": "Connecticut", "similarity": 0.782}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Connecticut", "target_book": "kosmos_humboldt_1845", "target_name": "Connecticut", "similarity": 0.782}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Connecticut", "target_book": "kosmos_humboldt_1845", "target_name": "Connecticut", "similarity": 1.0}], "id": 1255, "stable_key": "clu_45400baa003bf2b1", "ground_truth": {"modern_name": "Connecticut", "confidence": "high", "type": "place", "country": "United States", "wikidata_id": "Q379648", "wikidata_description": "river in the New England region of the United States", "wikipedia_extract": "Connecticut (  k\u0259-NET-ih-k\u0259t) is a state in the New England region of the Northeastern United States. It borders Rhode Island to the east, Massachusetts to the north, New York to the west, and Long Island Sound to the south. Its capital is Hartford, and its most populous city is Bridgeport. Connecticut lies between the major hubs of New York City and Boston along the Northeast Corridor, where the New York-Newark Combined Statistical Area, which includes four of Connecticut's seven largest cities, extends into the southwestern part of the state. Connecticut is the third-smallest state by area after Rhode Island and Delaware, and the 29th most populous with more than 3.6 million residents as of 2024, ranking it fourth among the most densely populated U.S. states. The state is named after the Connecticut River, the longest in New England, which roughly bisects the state and drains into the Long Island Sound between the towns of Old Saybrook and Old Lyme."}}, {"canonical_name": "Polar Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "mer_polaire", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mer Polaire", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Mer Polaire"], "contexts": ["sea forming a water divide", "body of water"]}, {"entity_id": "polar_sea", "book_id": "kosmos_humboldt_1845", "name": "Polar Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["Polar Sea"], "contexts": ["sea near Siberian coast", "location of Wrangel's observations"]}, {"entity_id": "polar_ocean", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Polar Ocean", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Polar Ocean"], "contexts": ["ocean with milder climates", "ocean with tides"]}, {"entity_id": "south_polar_seas", "book_id": "connexion_physical_sciences_somerville_1858", "name": "south polar seas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["south polar seas"], "contexts": ["seas around the South Pole"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mer Polaire", "target_book": "kosmos_humboldt_1845", "target_name": "Polar Sea", "similarity": 0.912}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mer Polaire", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Polar Ocean", "similarity": 0.894}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mer Polaire", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "south polar seas", "similarity": 0.885}, {"source_book": "kosmos_humboldt_1845", "source_name": "Polar Sea", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Polar Ocean", "similarity": 0.974}, {"source_book": "kosmos_humboldt_1845", "source_name": "Polar Sea", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "south polar seas", "similarity": 0.905}], "id": 1256, "stable_key": "clu_f48d29fd6d55ea30", "ground_truth": {"modern_name": "Arctic Ocean", "confidence": "high", "type": "place", "country": "International", "note": "While 'south polar seas' is mentioned, the majority of references to 'Polar Sea' and 'Polar Ocean' in early modern texts, especially in geographical contexts like Humboldt's work, typically refer to the Arctic Ocean. The description 'sea near Siberian coast' further supports this.", "wikidata_id": "Q25322", "wikidata_description": "polar region on the Earth's northern hemisphere", "wikipedia_url": "https://en.wikipedia.org/wiki/Arctic", "wikipedia_extract": "The Arctic (; from Ancient Greek  \u1f04\u03c1\u03ba\u03c4\u03bf\u03c2 (\u00e1rktos) 'bear') is the polar region of Earth that surrounds the North Pole, lying north of the Arctic Circle. The Arctic region, from the IERS Reference Meridian travelling east, consists of parts of northern Norway (Nordland, Troms, Finnmark, Svalbard and Jan Mayen), northernmost Sweden (V\u00e4sterbotten, Norrbotten and Lappland), northern Finland (North Ostrobothnia, Kainuu and Lappi), Russia (Murmansk, Siberia, Nenets Okrug, Novaya Zemlya), the United States (Alaska), Canada (Yukon, Northwest Territories, Nunavut), Danish Realm (Greenland), and northern Iceland (Gr\u00edmsey and Kolbeinsey), along with the Arctic Ocean and adjacent seas. Land within the Arctic region has seasonally varying snow and ice cover, with predominantly treeless permafrost under the tundra. Arctic seas contain seasonal sea ice in many places. The Arctic region is a unique area among Earth's ecosystems. The cultures in the region and the Arctic indigenous peoples have adapted to its cold and extreme conditions."}}, {"canonical_name": "succession", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "succession", "book_id": "principles_of_psychology_james_1890", "name": "succession", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["succession"], "contexts": ["sequence of events or things", "relationship of things following one another"]}, {"entity_id": "order_of_succession", "book_id": "kosmos_humboldt_1845", "name": "order of succession", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["order of succession"], "contexts": ["sequence of geological strata"]}, {"entity_id": "succession", "book_id": "first_principles_spencer_1862", "name": "succession", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["succession"], "contexts": ["the order of events in time"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "succession", "target_book": "kosmos_humboldt_1845", "target_name": "order of succession", "similarity": 0.881}, {"source_book": "principles_of_psychology_james_1890", "source_name": "succession", "target_book": "first_principles_spencer_1862", "target_name": "succession", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "order of succession", "target_book": "first_principles_spencer_1862", "target_name": "succession", "similarity": 0.881}], "id": 1257, "stable_key": "clu_9b5fcb26102f2b2b", "ground_truth": {"modern_name": "Discrimination of successions", "confidence": "high", "type": "concept", "wikidata_id": "Q58922789", "wikidata_description": "scholarly article by Dola Bhattacharjee et al published 3 October 2013 in International journal of biodiversity"}}, {"canonical_name": "harmony", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "harmony", "book_id": "principles_of_psychology_james_1890", "name": "harmony", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["harmony"], "contexts": ["positive relation to topic", "feeling of agreement in thought"]}, {"entity_id": "harmony", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Harmony", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["harmony", "Harmony"], "contexts": ["pleasing combination of musical notes", "agreeable combination of sounds"]}, {"entity_