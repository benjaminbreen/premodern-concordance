 "variants": ["grego"], "contexts": ["Greek"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "grego", "target_book": "ricettario_fiorentino_1597", "target_name": "grec\u00f2", "similarity": 0.931}, {"source_book": "coloquios_da_orta_1563", "source_name": "grego", "target_book": "polyanthea_medicinal", "target_name": "grego", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "grec\u00f2", "target_book": "polyanthea_medicinal", "target_name": "grego", "similarity": 0.931}], "id": 1094, "stable_key": "clu_451098d60ff27967", "ground_truth": {"modern_name": "Greece", "confidence": "high", "type": "place", "description": "Southeastern European country, cradle of Western civilization and ancient knowledge.", "note": "Includes references to the Greek language and people.", "wikipedia_extract": "Greece, officially the Hellenic Republic, is a country in Southeast Europe. Located on the southern tip of the Balkan peninsula, it shares land borders with Albania to the northwest, North Macedonia and Bulgaria to the north, and Turkey to the east. The Aegean Sea lies to the east of the mainland, the Ionian Sea to the west, and the Sea of Crete and the Mediterranean Sea to the south. Greece has the longest coastline on the Mediterranean basin, spanning thousands of islands and nine traditional geographic regions. It has a population of over 10 million. Athens is the nation's capital and largest city, followed by Thessaloniki and Patras."}}, {"canonical_name": "Chinese", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "chinois", "book_id": "epoques_nature_buffon_1778", "name": "Chinois", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Chinois"], "contexts": ["people known for astronomical calculations", "people who received distorted ideas"]}, {"entity_id": "chinese", "book_id": "kosmos_humboldt_1845", "name": "Chinese", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 13, "variants": ["Chinese"], "contexts": ["people of China", "civilization known for careful observation"]}, {"entity_id": "chineza", "book_id": "coloquios_da_orta_1563", "name": "chineza", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["chineza"], "contexts": ["probable origin of a copper coin"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Chinois", "target_book": "kosmos_humboldt_1845", "target_name": "Chinese", "similarity": 0.913}, {"source_book": "kosmos_humboldt_1845", "source_name": "Chinese", "target_book": "coloquios_da_orta_1563", "target_name": "chineza", "similarity": 0.963}], "id": 1095, "stable_key": "clu_34d0d9eb2be4f69c-2", "ground_truth": {"modern_name": "China", "confidence": "high", "type": "place", "country": "China", "wikidata_id": "Q148", "wikidata_description": "country in East Asia", "wikipedia_url": "https://en.wikipedia.org/wiki/Demographics_of_China", "wikipedia_extract": "The People's Republic of China is the second most-populous country in the world with a population exceeding 1.4 billion, only surpassed by India. China was the world's most populous country until being surpassed by India in 2023. In 2025, China's population officially stood at 1.404 billion, which was three million less than the previous year, with the lowest recorded birthrate since at least the proclamation of the People's Republic of China in 1949. China's population has a relatively small youth component, partially a result of the strict enforcement of China's one-child policy that was in effect from 1979 until 2015, which limited urban families to one child and rural families to two. As of 2022, Chinese state media reported the country's total fertility rate to be 1.09, one of the lowest in the world alongside South Korea, Taiwan, Hong Kong and Singapore. Since 2022, deaths have outstripped births in the country.", "description": "Country of origin for various plants, spices, and historical goods."}}, {"canonical_name": "Medlar", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "medlar", "book_id": "english_physician_1652", "name": "Medlar", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["Medlar", "Medlar stones", "Medlars"], "contexts": ["fruit tree with medicinal properties", "fruit of the Medlar tree"]}, {"entity_id": "medlars", "book_id": "kosmos_humboldt_1845", "name": "medlars", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["medlars"], "contexts": ["fruit trees"]}, {"entity_id": "medula", "book_id": "coloquios_da_orta_1563", "name": "medula", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["medula"], "contexts": ["inner part of tamarindos, sticky"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Medlar", "target_book": "kosmos_humboldt_1845", "target_name": "medlars", "similarity": 0.938}, {"source_book": "english_physician_1652", "source_name": "Medlar", "target_book": "coloquios_da_orta_1563", "target_name": "medula", "similarity": 0.905}], "id": 1096, "stable_key": "clu_ef0d8b420917632b", "ground_truth": {"modern_name": "Medlar", "confidence": "high", "type": "plant", "linnaean": "Mespilus germanica Linnaeus", "family": "Rosaceae", "note": "'Nefpoie' and 'nefperas' are consistent with historical variations of the word for medlar, a fruit used medicinally. The context 'medlar fruits' solidifies this identification.", "wikidata_id": "Q2088434", "wikidata_description": "species of flowering plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Mimusops%20elengi", "wikipedia_extract": "Mimusops elengi is a medium-sized evergreen tree found in tropical forests in South Asia, Southeast Asia and northern Australia. English common names include Spanish cherry, medlar, and bullet wood. Its timber is valuable and its fruit is edible. As the trees give thick shade and flowers emit fragrance, it is a prized collection for gardens. It is used as an ornamental tree in many places. The flowers may also be used in natural perfume.", "description": "A fruit tree with medicinal properties and its fruit."}}, {"canonical_name": "Lithargyro", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "litharge", "book_id": "english_physician_1652", "name": "Litharge", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Litharge"], "contexts": ["danger from taking, treated by parsley"]}, {"entity_id": "lithargyro", "book_id": "ricettario_fiorentino_1597", "name": "Lithargyro", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 14, "variants": ["Lithargyro", "LITHARGYRO", "Litargyro doro", "Lithargyro d'argento", "Lytargirodoro", "lichargyro", "litharge", "lithargyro", "lithargyro d argento", "lytargiro", "lytharg.ro"], "contexts": ["a substance, likely lead monoxide", "spuma d'argento, generated from lead"]}, {"entity_id": "lithargyrij", "book_id": "polyanthea_medicinal", "name": "lithargyrij", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["lithargyrij"], "contexts": ["ingredient in a preparation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Litharge", "target_book": "ricettario_fiorentino_1597", "target_name": "Lithargyro", "similarity": 0.927}, {"source_book": "english_physician_1652", "source_name": "Litharge", "target_book": "polyanthea_medicinal", "target_name": "lithargyrij", "similarity": 0.946}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Lithargyro", "target_book": "polyanthea_medicinal", "target_name": "lithargyrij", "similarity": 0.961}], "id": 1097, "stable_key": "clu_86e3a5a0b480706d", "ground_truth": {"modern_name": "Litharge", "confidence": "high", "type": "substance", "description": "A heavy, dull yellow oxide of lead; lead monoxide.", "wikipedia_extract": "Litharge (from Greek lithargyros, lithos 'stone' + argyros 'silver' \u03bb\u03b9\u03b8\u03ac\u03c1\u03b3\u03c5\u03c1\u03bf\u03c2) is one of the natural mineral forms of lead(II) oxide, PbO. Litharge is a secondary mineral which forms from the oxidation of galena ores. It forms as coatings and encrustations with internal tetragonal crystal structure. It is dimorphous with the yellow orthorhombic form massicot. It forms soft (Mohs hardness of 2), red, greasy-appearing crusts with a very high specific gravity of 9.14\u20139.35. PbO may be prepared by heating lead metal in air at approximately 600 \u00b0C (lead melts at only 300 \u00b0C)."}}, {"canonical_name": "domestic animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "domestic_animals", "book_id": "origin_of_species_darwin_1859", "name": "domestic animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 12, "variants": ["domestic animals"], "contexts": ["animals bred by humans", "animals kept by humans"]}, {"entity_id": "domestic_animals", "book_id": "principles_of_psychology_james_1890", "name": "domestic animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["domestic animals"], "contexts": ["animals kept for human use"]}, {"entity_id": "domestic_animals", "book_id": "first_principles_spencer_1862", "name": "domestic animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["domestic animals"], "contexts": ["animals tamed by humans", "animals tamed for human use"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "domestic animals", "target_book": "principles_of_psychology_james_1890", "target_name": "domestic animals", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "domestic animals", "target_book": "first_principles_spencer_1862", "target_name": "domestic animals", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "domestic animals", "target_book": "first_principles_spencer_1862", "target_name": "domestic animals", "similarity": 1.0}], "id": 1098, "stable_key": "clu_2fc50966df523ed0", "ground_truth": {"modern_name": "domestic animals", "confidence": "high", "type": "animal", "wikidata_id": "Q622852", "wikidata_description": "animal that has been biologically changed by human intervention", "wikipedia_url": "https://en.wikipedia.org/wiki/Domesticated%20animal"}}, {"canonical_name": "Great Britain", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "great_britain", "book_id": "origin_of_species_darwin_1859", "name": "Great Britain", "category": "PLACE", "subcategory": "COUNTRY", "count": 11, "variants": ["Great Britain"], "contexts": ["island nation with peculiar mammals", "flora of Great Britain"]}, {"entity_id": "great_britain", "book_id": "kosmos_humboldt_1845", "name": "Great Britain", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Great Britain"], "contexts": ["nation with extensive commerce and navy"]}, {"entity_id": "great_britain", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Great Britain", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Great Britain"], "contexts": ["location of general survey", "geographic location for earth survey"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Great Britain", "target_book": "kosmos_humboldt_1845", "target_name": "Great Britain", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Great Britain", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Great Britain", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Great Britain", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Great Britain", "similarity": 1.0}], "id": 1099, "stable_key": "clu_eac142b3bcc64426-2", "ground_truth": {"modern_name": "Great Britain", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q145", "wikidata_description": "island country in north-west Europe", "wikipedia_url": "https://en.wikipedia.org/wiki/United%20Kingdom", "wikipedia_extract": "The United Kingdom of Great Britain and Northern Ireland, commonly known as the United Kingdom (UK) or Britain, is a country in northwestern Europe, off the coast of the continental mainland. It comprises England, Scotland, Wales and Northern Ireland, with a population of over 69 million in 2024. The UK includes the island of Great Britain, the north-eastern part of the island of Ireland, and most of the smaller islands within the British Isles, covering 94,354 square miles (244,376 km2). It shares a land border with the Republic of Ireland and is surrounded by the Atlantic Ocean, the North Sea, the English Channel, the Celtic Sea and the Irish Sea, while maintaining sovereignty over the Crown Dependencies and the British Overseas Territories. The capital and largest city of England and the UK is London; Edinburgh, Cardiff and Belfast are the national capitals of Scotland, Wales and Northern Ireland. Britain has been inhabited since the Neolithic."}}, {"canonical_name": "Ohio", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "ohio", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Ohio", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 13, "variants": ["Ohio"], "contexts": ["region with fortifications", "geographic location"]}, {"entity_id": "ohio", "book_id": "kosmos_humboldt_1845", "name": "Ohio", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Ohio"], "contexts": ["river where Lepidosteus is found", "river valley"]}, {"entity_id": "ohio", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Ohio", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Ohio"], "contexts": ["country in America"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ohio", "target_book": "kosmos_humboldt_1845", "target_name": "Ohio", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ohio", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Ohio", "similarity": 0.81}, {"source_book": "kosmos_humboldt_1845", "source_name": "Ohio", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Ohio", "similarity": 0.81}], "id": 1100, "stable_key": "clu_4793f3afbda3cbd4", "ground_truth": {"modern_name": "Ohio River", "confidence": "high", "type": "place", "country": "United States", "note": "While 'Ohio' can refer to the state, the context of a river and a region with fortifications points to the river and its valley.", "wikidata_id": "Q72054518", "wikidata_description": "valley and region along the Ohio River", "wikipedia_extract": "The Cuyahoga River (see \u00a7 Pronunciation) is a river located in Northeast Ohio that feeds into Lake Erie. The Cuyahoga River bisects the city of Cleveland. As Cleveland emerged as a major manufacturing center, the river became heavily affected by industrial pollution, so much so that it caught fire at least 14 times. When it did so on June 22, 1969, news coverage of the event helped to spur the American environmental movement. For many Americans, the Cuyahoga's burning helped connect urban decay with the environmental crisis at the time in many American cities. Since then, the river has been extensively cleaned up through the efforts of Cleveland's city government and the Ohio Environmental Protection Agency (OEPA).", "wikipedia_url": "https://en.wikipedia.org/wiki/Cuyahoga_River"}}, {"canonical_name": "rhythm", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "rhythm", "book_id": "principles_of_psychology_james_1890", "name": "rhythm", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["rhythm"], "contexts": ["pattern of stressed and unstressed beats", "a pattern of sound or movement"]}, {"entity_id": "rhythm", "book_id": "connexion_physical_sciences_somerville_1858", "name": "rhythm", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["rhythm"], "contexts": ["pattern of sound or movement"]}, {"entity_id": "rhythm", "book_id": "first_principles_spencer_1862", "name": "rhythm", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["rhythm"], "contexts": ["pattern of recurring events or actions", "pattern of regular recurrence"]}, {"entity_id": "rhythms", "book_id": "first_principles_spencer_1862", "name": "rhythms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["rhythms"], "contexts": ["all motion is rhythmical", "recurring patterns of activity"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "rhythm", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "rhythm", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "rhythm", "target_book": "first_principles_spencer_1862", "target_name": "rhythm", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "rhythm", "target_book": "first_principles_spencer_1862", "target_name": "rhythms", "similarity": 0.958}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "rhythm", "target_book": "first_principles_spencer_1862", "target_name": "rhythm", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "rhythm", "target_book": "first_principles_spencer_1862", "target_name": "rhythms", "similarity": 0.958}], "id": 1101, "stable_key": "clu_8a6f1dd7d84dd671", "ground_truth": {"modern_name": "Rhythm", "confidence": "high", "type": "concept", "wikidata_id": "Q24037210", "wikidata_description": "sportsperson who takes part in rhythmic gymnastics competitions"}}, {"canonical_name": "chemical combination", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "chemical_combinations", "book_id": "kosmos_humboldt_1845", "name": "chemical combinations", "category": "CONCEPT", "subcategory": "THEORY", "count": 3, "variants": ["chemical combinations"], "contexts": ["subject of study", "formation of chemical compounds"]}, {"entity_id": "chemical_combination", "book_id": "connexion_physical_sciences_somerville_1858", "name": "chemical combination", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 3, "variants": ["chemical combination"], "contexts": ["formation of new substances", "process induced by cohesive force"]}, {"entity_id": "chemical_combinations", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Chemical combinations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Chemical combinations"], "contexts": ["theory of invariable proportions"]}, {"entity_id": "chemical_combination", "book_id": "first_principles_spencer_1862", "name": "chemical combination", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["chemical combination"], "contexts": ["formation of chemical compounds", "process of forming chemical compounds"]}, {"entity_id": "chemical_combinations", "book_id": "first_principles_spencer_1862", "name": "chemical combinations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["chemical combinations"], "contexts": ["formation of chemical compounds", "formation of new chemical substances"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "chemical combinations", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chemical combination", "similarity": 0.92}, {"source_book": "kosmos_humboldt_1845", "source_name": "chemical combinations", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Chemical combinations", "similarity": 0.989}, {"source_book": "kosmos_humboldt_1845", "source_name": "chemical combinations", "target_book": "first_principles_spencer_1862", "target_name": "chemical combination", "similarity": 0.92}, {"source_book": "kosmos_humboldt_1845", "source_name": "chemical combinations", "target_book": "first_principles_spencer_1862", "target_name": "chemical combinations", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "chemical combination", "target_book": "first_principles_spencer_1862", "target_name": "chemical combination", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "chemical combination", "target_book": "first_principles_spencer_1862", "target_name": "chemical combinations", "similarity": 0.92}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Chemical combinations", "target_book": "first_principles_spencer_1862", "target_name": "chemical combination", "similarity": 0.918}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Chemical combinations", "target_book": "first_principles_spencer_1862", "target_name": "chemical combinations", "similarity": 0.989}], "id": 1102, "stable_key": "clu_295d6828a8e74f24", "ground_truth": {"modern_name": "chemical combination", "confidence": "high", "type": "concept", "wikidata_id": "Q273499", "wikidata_description": "technique in chemistry", "wikipedia_url": "https://en.wikipedia.org/wiki/Chemical%20synthesis", "wikipedia_extract": "Chemical synthesis (chemical combination) is the artificial execution of chemical reactions to obtain one or more products. This occurs by physical and chemical manipulations, usually involving one or more reactions. In modern laboratory uses, the process is reproducible and reliable. A chemical synthesis involves one or more compounds (known as reagents or reactants) that will experience a transformation under certain conditions. Various reaction types can be applied to formulate a desired product. Many reactions require some form of processing (\"work-up\") or purification procedure to isolate the final product."}}, {"canonical_name": "palmeira", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "palm-tree", "book_id": "kosmos_humboldt_1845", "name": "palm-tree", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["palm-tree"], "contexts": ["plant found in valleys"]}, {"entity_id": "palmeira", "book_id": "coloquios_da_orta_1563", "name": "palmeira", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["palmeira", "Palmeiras", "Palmyra", "palmeiras", "palmito", "palmitos"], "contexts": ["tree whose fruit husk makes ropes", "tree with similar leaves to the coconut tree"]}, {"entity_id": "palmeyra", "book_id": "polyanthea_medicinal", "name": "palmeyra", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["palmeyra"], "contexts": ["palm tree used for ash production"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "palm-tree", "target_book": "coloquios_da_orta_1563", "target_name": "palmeira", "similarity": 0.925}, {"source_book": "kosmos_humboldt_1845", "source_name": "palm-tree", "target_book": "polyanthea_medicinal", "target_name": "palmeyra", "similarity": 0.887}, {"source_book": "coloquios_da_orta_1563", "source_name": "palmeira", "target_book": "polyanthea_medicinal", "target_name": "palmeyra", "similarity": 0.911}], "id": 1103, "stable_key": "clu_a0b8e7c12cda39ae-2", "ground_truth": {"modern_name": "Palm tree", "confidence": "high", "type": "plant", "family": "Arecaceae", "note": "Palma is the direct Spanish and Italian word for palm. Given the contexts, it refers to the plant family or specific trees within it.", "wikidata_id": "Q14080", "wikidata_description": "family of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Arecaceae", "wikipedia_extract": "The Arecaceae () are a family of perennial, flowering plants in the monocot order Arecales. Their growth form can be climbers, shrubs, tree-like and stemless plants, all commonly known as palms. Those having a tree-like form are colloquially called palm trees. Currently, 181 genera with around 2,600 species are known, most of which are restricted to tropical and subtropical climates. Most palms are distinguished by their large, compound, evergreen leaves, known as fronds, arranged at the top of an unbranched stem, except for the Hyphaene genus, which has branched palms. However, palms exhibit an enormous diversity in physical characteristics and inhabit nearly every type of habitat within their range, from rainforests to deserts."}}, {"canonical_name": "brahmanes", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "brahmins", "book_id": "kosmos_humboldt_1845", "name": "Brahmins", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Brahmins"], "contexts": ["followers of ancient Indian myth"]}, {"entity_id": "brahmanes", "book_id": "coloquios_da_orta_1563", "name": "brahmanes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 13, "variants": ["brahmanes", "Brahmane", "Brahmanes", "Bramanes", "Bramenes"], "contexts": ["group for whom hemp use was prohibited", "Indian priests or ascetics"]}, {"entity_id": "brahmins", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Brahmins", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Brahmins"], "contexts": ["people in India using seven-day periods", "measured time"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Brahmins", "target_book": "coloquios_da_orta_1563", "target_name": "brahmanes", "similarity": 0.959}, {"source_book": "kosmos_humboldt_1845", "source_name": "Brahmins", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Brahmins", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "brahmanes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Brahmins", "similarity": 0.959}], "id": 1104, "stable_key": "clu_e71147a63563afba", "ground_truth": {"modern_name": "Brahmins", "confidence": "high", "type": "person", "description": "Priestly caste in Hinduism, associated with ancient Indian practices.", "wikidata_id": "Q194497", "wikidata_description": "1500\u2013500 BC Indo-Aryan religious practices of northwest India", "wikipedia_url": "https://en.wikipedia.org/wiki/Historical%20Vedic%20religion", "wikipedia_extract": "The historical Vedic religion, also called Vedism or Brahmanism, and sometimes ancient Hinduism or Vedic Hinduism, constituted the religious ideas and practices prevalent amongst some of the Indo-Aryan peoples of the northwest Indian subcontinent (Punjab and the western Ganges plain) during the Vedic period (c. 1500\u2013500 BCE). These ideas and practices are found in the Vedic texts, and some Vedic rituals are still practised today. The Vedic religion is one of the major traditions which shaped modern Hinduism, though present-day Hinduism is significantly different from the historical Vedic religion. The Vedic religion has roots in the Indo-Iranian culture and religion of the Sintashta (c. 2200\u20131750 BCE) and Andronovo (c."}}, {"canonical_name": "b\u0153ufs", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "boeuf", "book_id": "medecine_experimentale_bernard_1865", "name": "boeuf", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["boeuf"], "contexts": ["domestic animal used in research", "meat used for feeding rabbits"]}, {"entity_id": "b\u0153ufs", "book_id": "epoques_nature_buffon_1778", "name": "b\u0153ufs", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["b\u0153ufs"], "contexts": ["animal with monstrous heads of great size"]}, {"entity_id": "b\u0153uf", "book_id": "epoques_nature_buffon_1778", "name": "b\u0153uf", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["b\u0153uf"], "contexts": ["domesticated bovine mammal"]}, {"entity_id": "b\u0153ufs", "book_id": "relation_historique_humboldt_vol3_1825", "name": "b\u0153ufs", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 9, "variants": ["b\u0153ufs", "b\u0153uf"], "contexts": ["cattle introduced to America", "livestock count"]}, {"entity_id": "boeufs", "book_id": "relation_historique_humboldt_vol3_1825", "name": "boeufs", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["boeufs"], "contexts": ["animals for transport and sustenance", "animals used for subsistence"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "boeuf", "target_book": "epoques_nature_buffon_1778", "target_name": "b\u0153ufs", "similarity": 0.895}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "boeuf", "target_book": "epoques_nature_buffon_1778", "target_name": "b\u0153uf", "similarity": 0.95}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "boeuf", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "b\u0153ufs", "similarity": 0.895}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "boeuf", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "boeufs", "similarity": 0.937}, {"source_book": "epoques_nature_buffon_1778", "source_name": "b\u0153ufs", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "b\u0153ufs", "similarity": 1.0}, {"so