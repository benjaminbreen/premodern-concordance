fidence": "high", "type": "chemical"}}, {"canonical_name": "parabola", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "parabola", "book_id": "connexion_physical_sciences_somerville_1858", "name": "parabola", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["parabola"], "contexts": ["geometric shape", "mathematical curve used to describe orbits"]}, {"entity_id": "parabola", "book_id": "first_principles_spencer_1862", "name": "parabola", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["parabola"], "contexts": ["geometric curve, path of projectile", "curve described by projectile"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "parabola", "target_book": "first_principles_spencer_1862", "target_name": "parabola", "similarity": 1.0}], "id": 4296, "stable_key": "clu_ffe572a8a5073950", "ground_truth": {"modern_name": "Parabola", "confidence": "high", "type": "concept", "wikidata_id": "Q7133719", "wikidata_description": "genus of insects"}}, {"canonical_name": "Laws in general", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "general_laws", "book_id": "connexion_physical_sciences_somerville_1858", "name": "general laws", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["general laws"], "contexts": ["derived from comparison of facts"]}, {"entity_id": "general_law", "book_id": "connexion_physical_sciences_somerville_1858", "name": "general law", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["general law"], "contexts": ["applies to animal distribution"]}, {"entity_id": "laws_in_general", "book_id": "first_principles_spencer_1862", "name": "Laws in general", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["LAWS IN GENERAL", "Laws in general"], "contexts": ["chapter title", "chapter title on uniformities of relation"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "general laws", "target_book": "first_principles_spencer_1862", "target_name": "Laws in general", "similarity": 0.926}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "general law", "target_book": "first_principles_spencer_1862", "target_name": "Laws in general", "similarity": 0.896}], "id": 4297, "stable_key": "clu_24bb0ae57223b135", "ground_truth": {"modern_name": "General laws", "confidence": "high", "type": "concept", "note": "Refers to broad scientific or philosophical principles.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Theory of Things", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "theory_of", "book_id": "connexion_physical_sciences_somerville_1858", "name": "theory of", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["theory of"], "contexts": ["explaining meteors"]}, {"entity_id": "theory_of_things", "book_id": "first_principles_spencer_1862", "name": "Theory of Things", "category": "CONCEPT", "subcategory": "THEORY", "count": 3, "variants": ["Theory of Things"], "contexts": ["Any Theory of Things which takes no account", "a framework for understanding existence"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "theory of", "target_book": "first_principles_spencer_1862", "target_name": "Theory of Things", "similarity": 0.882}], "id": 4298, "stable_key": "clu_d73dba3c096265f6-4", "ground_truth": {"modern_name": "theory", "confidence": "high", "type": "concept", "description": "An abstract explanation or system of ideas for understanding phenomena.", "note": "'Theoriques' is the French plural of theoretical.", "wikipedia_extract": "A theory is, in general, any hypothesis or set of ideas about something, formed in any number of ways through any sort of reasoning for any sort of reason. When applied to intellectual or academic situations, it is considered a systematic and rational form of abstract thinking about a phenomenon, or the conclusions derived from such thinking. It involves contemplative and logical reasoning, often supported by processes such as observation, experimentation, and research. Theories can be scientific, falling within the realm of empirical and testable knowledge, or they may belong to non-scientific disciplines, such as philosophy, art, or sociology. In some cases, theories may exist independently of any formal discipline. In modern science, the term \"theory\" refers to scientific theories, a well-confirmed type of explanation of nature, made in a way consistent with the scientific method, and fulfilling the criteria required by modern science."}}, {"canonical_name": "Zimmermann", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "zimmermann", "book_id": "medecine_experimentale_bernard_1865", "name": "Zimmermann", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Zimmermann"], "contexts": ["defined difference between experience and observation", "author of treatise on medical experience"]}, {"entity_id": "zimmermannus", "book_id": "kosmos_humboldt_1845", "name": "Zimmermannus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Zimmermannus"], "contexts": ["laid foundations of zoological geography"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Zimmermann", "target_book": "kosmos_humboldt_1845", "target_name": "Zimmermannus", "similarity": 0.924}], "id": 4299, "stable_key": "clu_838c51c5c4370c5c", "ground_truth": {"modern_name": "August Johann Georg Karl Batsch", "confidence": "medium", "type": "person", "birth_year": 1761, "death_year": 1808, "description": "German naturalist and zoologist, pioneer of evolutionary thinking.", "note": "Multiple 'Zimmermann' individuals were prominent scientists in the early modern period, notably Carl Christian Gmelin (who worked on zoogeography) and Johann Georg Zimmermann (known for his work on medical geography and epidemics). However, the context 'laid foundations of zoological geography' and 'defined difference between experience and observation' points more strongly to Batsch's influence on zoological classification and systematic thought, even though his name isn't explicitly stated in the prompt, the given context strongly implies him or a closely related figure. The provided 'Zimmermannus' in Humboldt's Kosmos (1845) further complicates this, as Humboldt referenced many scientists. A deeper textual analysis of the referenced works would be needed for absolute certainty.", "wikidata_id": "Q213687", "wikidata_description": "German naturalist (1761-1802)", "wikipedia_url": "https://en.wikipedia.org/wiki/August%20Batsch"}}, {"canonical_name": "dissection", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "dissection", "book_id": "medecine_experimentale_bernard_1865", "name": "dissection", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["dissection"], "contexts": ["cutting up bodies for study", "cutting apart for study"]}, {"entity_id": "dissection", "book_id": "origin_of_species_darwin_1859", "name": "dissection", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dissection"], "contexts": ["examination of a body"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "dissection", "target_book": "origin_of_species_darwin_1859", "target_name": "dissection", "similarity": 1.0}], "id": 4300, "stable_key": "clu_ba2feff010ead485", "ground_truth": {"modern_name": "Dissection", "confidence": "high", "type": "concept", "wikidata_id": "Q116646", "wikidata_description