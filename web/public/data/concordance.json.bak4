": "clu_f60ef18f38e08ded", "ground_truth": {"modern_name": "Reflection", "confidence": "high", "type": "concept", "note": "The German term 'nachdenken' suggests a specific kind of reflective thought, but 'reflection' as a general concept is appropriate."}}, {"canonical_name": "doctrines", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "doctrines", "book_id": "medecine_experimentale_bernard_1865", "name": "doctrines", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["doctrines"], "contexts": ["established beliefs or principles"]}, {"entity_id": "religious_doctrines", "book_id": "first_principles_spencer_1862", "name": "religious doctrines", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["religious doctrines"], "contexts": ["teachings of religious systems"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "doctrines", "target_book": "first_principles_spencer_1862", "target_name": "religious doctrines", "similarity": 0.911}], "id": 5141, "stable_key": "clu_df970164dd4be87d", "ground_truth": {"modern_name": "doctrines", "confidence": "high", "type": "concept", "note": "This cluster refers to established principles or teachings, which could be scientific, philosophical, or religious, depending on the context within the early modern texts.", "wikidata_id": "Q117850", "wikidata_description": "teaching, principle, position, or belief established within a belief system, school of thought, or academic discipline", "wikipedia_url": "https://en.wikipedia.org/wiki/Doctrine"}}, {"canonical_name": "Laromigui\u00e8re", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "laromigui\u00e8re", "book_id": "medecine_experimentale_bernard_1865", "name": "Laromigui\u00e8re", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Laromigui\u00e8re"], "context