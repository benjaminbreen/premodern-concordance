rays", "similarity": 0.996}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "sun's rays", "target_book": "first_principles_spencer_1862", "target_name": "sun\u2019s rays", "similarity": 0.996}], "id": 725, "stable_key": "clu_eb4ee00d1a588d24", "ground_truth": {"modern_name": "Solar Radiation", "confidence": "high", "type": "concept", "wikidata_id": "Q17996169", "wikidata_description": "electromagnetic radiation received from the Sun", "wikipedia_url": "https://en.wikipedia.org/wiki/Solar%20radiation", "note": "While 'solar rays' literally refers to rays from the sun, in the context of early modern science, it encompasses the broader concept of electromagnetic radiation and its effects."}}, {"canonical_name": "propri\u00e9t\u00e9s", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "propri\u00e9t\u00e9s", "book_id": "medecine_experimentale_bernard_1865", "name": "propri\u00e9t\u00e9s", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["propri\u00e9t\u00e9s"], "contexts": ["characteristics of bodies", "characteristics of a body"]}, {"entity_id": "propriedades", "book_id": "historia_medicinal_monardes_1574", "name": "propriedades", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["propriedades"], "contexts": ["qualities or characteristics"]}, {"entity_id": "propriedades", "book_id": "polyanthea_medicinal", "name": "propriedades", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["propriedades"], "contexts": ["properties and virtues", "hidden virtues of substances"]}, {"entity_id": "properties", "book_id": "first_principles_spencer_1862", "name": "properties", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["properties"], "contexts": ["characteristics of an object"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "pr