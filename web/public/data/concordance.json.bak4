e": "structural changes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "modification_of_structure", "book_id": "origin_of_species_darwin_1859", "name": "modification of structure", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["modification of structure"], "contexts": ["change in physical form"]}, {"entity_id": "structural_changes", "book_id": "first_principles_spencer_1862", "name": "structural changes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["structural changes"], "contexts": ["alterations in physical form"]}, {"entity_id": "modification_of_structure", "book_id": "first_principles_spencer_1862", "name": "modification of structure", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["modification of structure"], "contexts": ["change in physical form"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "modification of structure", "target_book": "first_principles_spencer_1862", "target_name": "structural changes", "similarity": 0.89}, {"source_book": "origin_of_species_darwin_1859", "source_name": "modification of structure", "target_book": "first_principles_spencer_1862", "target_name": "modification of structure", "similarity": 1.0}], "id": 4025, "stable_key": "clu_177751b4ef2b8f00", "ground_truth": {"modern_name": "Structural change", "confidence": "high", "type": "concept", "wikidata_id": "Q105493634", "wikidata_description": "clinical trial"}}, {"canonical_name": "D'Orbigny", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "d\u2019orbigny", "book_id": "origin_of_species_darwin_1859", "name": "D\u2019Orbigny", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["D\u2019Orbigny"], "contexts": ["conchologist who defined many species"]}, {"entity_id": "d'orbigny", "book_id": "kosmos_humboldt_1845", "name": "D'Orbigny", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["D'Orbigny"], "contexts": ["described fossils", "described Ammonites and Gryphites"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "D\u2019Orbigny", "target_book": "kosmos_humboldt_1845", "target_name": "D'Orbigny", "similarity": 0.989}], "id": 4026, "stable_key": "clu_f660a710035bd391", "ground_truth": {"modern_name": "Alcide d'Orbigny", "confidence": "high", "type": "person", "birth_year": 1802, "death_year": 1857, "description": "French naturalist, paleontologist, and conchologist, known for extensive fieldwork.", "wikipedia_extract": "Alcide Charles Victor Marie Dessalines d'Orbigny (French pronunciation: [alsid \u0283a\u0281l vikt\u0254\u0281 ma\u0281i d\u025bsalin d\u0254\u0281bi\u0272i]; 6 September 1802 \u2013 30 June 1857) was a French naturalist who made major contributions in many areas, including zoology (including malacology), palaeontology, geology, archaeology and anthropology. D'Orbigny was born in Cou\u00ebron (Loire-Atlantique), the son of a ship's physician and amateur naturalist. The family moved to La Rochelle in 1820, where his interest in natural history was developed while studying the marine fauna and especially the microscopic creatures that he named \"foraminiferans\". In Paris he became a disciple of the geologist Pierre Louis Antoine Cordier (1777\u20131861) and Georges Cuvier. All his life, he would follow the theory of Cuvier and stay opposed to Lamarckism. D'Orbigny travelled on a mission for the Paris Museum, in South America between 1826 and 1833."}}, {"canonical_name": "silurian strata", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "silurian_strata", "book_id": "origin_of_species_darwin_1859", "name": "Silurian strata", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Silurian strata"], "contexts": ["geological layers beneath Silurian"]}, {"entity_id": "silurian_strata", "book_id": "kosmos_humboldt_1845", "name": "silurian strata", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["silurian strata"], "contexts": ["geological strata with periodic stratification", "rock layer"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Silurian strata", "target_book": "kosmos_humboldt_1845", "target_name": "silurian strata", "similarity": 0.991}], "id": 4027, "stable_key": "clu_b9fe26d0c0fa8851", "ground_truth": {"modern_name": "Silurian strata", "confidence": "high", "type": "mineral", "note": "Refers to geological rock layers from the Silurian period."}}, {"canonical_name": "organic actions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "organic_action", "book_id": "origin_of_species_darwin_1859", "name": "organic action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic action"], "contexts": ["actions of living things"]}, {"entity_id": "organic_actions", "book_id": "first_principles_spencer_1862", "name": "organic actions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["organic actions"], "contexts": ["bodily functions and processes", "general actions within living organisms"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "organic action", "target_book": "first_principles_spencer_1862", "target_name": "organic actions", "similarity": 0.968}], "id": 4028, "stable_key": "clu_5b79f60d65dfb54a", "ground_truth": {"modern_name": "Bodily functions", "confidence": "high", "type": "concept", "note": "Early modern texts often referred to the physiological processes of living organisms as 'organic actions'.", "wikidata_id": "Q67372196", "wikidata_description": "scientific article published on 01 July 1975"}}, {"canonical_name": "human races", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "races_of_man", "book_id": "origin_of_species_darwin_1859", "name": "races of man", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["races of man"], "contexts": ["groups within the human species"]}, {"entity_id": "human_races", "book_id": "first_principles_spencer_1862", "name": "human races", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["human races"], "contexts": ["groups of people with shared characteristics", "distinct groups within humanity"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "races of man", "target_book": "first_principles_spencer_1862", "target_name": "human races", "similarity": 0.918}], "id": 4029, "stable_key": "clu_a7b8a4e2c4a4030c", "ground_truth": {"modern_name": "Human races", "confidence": "high", "type": "concept", "note": "This refers to historical classifications of human populations, often based on perceived physical and cultural differences.", "wikidata_id": "Q55878123", "wikidata_description": "scholarly article in American Anthropologist, vol. 100 no. 3, September 1998"}}, {"canonical_name": "vertebrate", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "vertebrate", "book_id": "origin_of_species_darwin_1859", "name": "vertebrate", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["vertebrate"], "contexts": ["animals with a backbone"]}, {"entity_id": "vertebrate", "book_id": "first_principles_spencer_1862", "name": "vertebrate", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["vertebrate"], "contexts": ["classification of animals", "animal with a backbone"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "vertebrate", "target_book": "first_principles_spencer_1862", "target_name": "vertebrate", "similarity": 1.0}], "id": 4030, "stable_key": "clu_342d61281544e12d-3", "ground_truth": {"modern_name": "Vertebrata", "confidence": "high", "type": "animal", "wikidata_id": "Q3556237", "wikidata_description": "genus of algae"}}, {"canonical_name": "United States of North America", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "united_states_of_north_america", "book_id": "kosmos_humboldt_1845", "name": "United States of North America", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["United States of North America"], "contexts": ["region of meteor observations", "location of observation"]}, {"entity_id": "north_american", "book_id": "connexion_physical_sciences_somerville_1858", "name": "North American", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["North American"], "contexts": ["relating to North America"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "United States of North America", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "North American", "similarity": 0.915}], "id": 4031, "stable_key": "clu_9c0afb49427ed09b-3", "ground_truth": {"modern_name": "United States", "confidence": "high", "type": "place", "country": "United States", "wikidata_id": "Q30", "wikidata_description": "country located primarily in North America", "wikipedia_url": "https://en.wikipedia.org/wiki/United%20States", "note": "While 'United States of North America' was a more formal designation, the modern referent is the United States.", "wikipedia_extract": "The United States of America (USA), also known as the United States (U.S.) or America, is a country primarily located in North America. It is a federal republic of 50 states and a federal capital district, Washington, D.C. The 48 contiguous states border Canada to the north and Mexico to the south, with the semi-exclave of Alaska in the northwest and the archipelago of Hawaii in the Pacific Ocean. The United States also asserts sovereignty over five major island territories and various uninhabited islands in Oceania and the Caribbean. It is a megadiverse country, with the world's third-largest land area and third-largest population, exceeding 341 million. Paleo-Indians first migrated from North Asia to North America at least 15,000 years ago, and formed various civilizations."}}, {"canonical_name": "Misteca", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "misteca", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Misteca", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Misteca"], "contexts": ["region where the plant grows", "region where tree is found"]}, {"entity_id": "misteca", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Misteca", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Misteca"], "contexts": ["region in Mexico"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Misteca", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Misteca", "similarity": 1.0}], "id": 4032, "stable_key": "clu_6a53c434361573a4", "ground_truth": {"modern_name": "Mixtec region", "confidence": "high", "type": "place", "country": "Mexico", "note": "Misteca refers to the historical and cultural region of the Mixtec people in Oaxaca, Mexico. The texts link it to plant cultivation and historical descriptions.", "wikidata_id": "Q623215", "wikidata_description": "ethnic group", "wikipedia_url": "https://en.wikipedia.org/wiki/Mixtec"}}, {"canonical_name": "Cera amarilla", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "cera_amarilla", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Cera amarilla", "category": "SUBSTANCE",