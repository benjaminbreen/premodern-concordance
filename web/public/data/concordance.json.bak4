a"]}, {"entity_id": "pyrites", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pyrites", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["pyrites"], "contexts": ["iron sulfide mineral", "Sulfide mineral, often iron pyrite"]}, {"entity_id": "iron_pyrites", "book_id": "kosmos_humboldt_1845", "name": "iron pyrites", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["iron pyrites"], "contexts": ["mineral causing brownish-red crusts on rocks"]}, {"entity_id": "iron_pyrites", "book_id": "first_principles_spencer_1862", "name": "iron pyrites", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["iron pyrites"], "contexts": ["mineral forming nodules in chalk"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "pyrites", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "pyrites cuivreuses", "similarity": 0.895}, {"source_book": "epoques_nature_buffon_1778", "source_name": "pyrites", "target_book": "kosmos_humboldt_1845", "target_name": "pyrites", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pyrites cuivreuses", "target_book": "kosmos_humboldt_1845", "target_name": "pyrites", "similarity": 0.895}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pyrites", "target_book": "kosmos_humboldt_1845", "target_name": "iron pyrites", "similarity": 0.887}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pyrites", "target_book": "first_principles_spencer_1862", "target_name": "iron pyrites", "similarity": 0.887}, {"source_book": "kosmos_humboldt_1845", "source_name": "iron pyrites", "target_book": "first_principles_spencer_1862", "target_name": "iron pyrites", "similarity": 1.0}], "id": 608, "stable_key": "clu_acab2588de7e4901", "ground_truth": {"modern_name": "Pyrite", "confidence": "high", "type": "mineral", "wikidata_id": "Q50769", "wikidata_description": "iron(II) disulfide mineral", "wikipedia_url": "https://en.wikipedia.org/wiki/Pyrite", "wikipedia_extract": "The mineral pyrite ( PY-ryte), or iron pyrite, also known as fool's gold, is an iron sulfide with the chemical formula FeS2 (iron (II) disulfide). Pyrite is the most abundant sulfide mineral. Pyrite's metallic luster and pale brass-yellow hue give it a superficial resemblance to gold, hence the well-known nickname of fool's gold. The color has also led to the nicknames brass, brazzle, and brazil, primarily used to refer to pyrite found in coal. The name pyrite is derived from the Greek \u03c0\u03c5\u03c1\u03af\u03c4\u03b7\u03c2 \u03bb\u03af\u03b8\u03bf\u03c2 (pyrit\u0113s lithos), 'stone or mineral which strikes fire', in turn from \u03c0\u1fe6\u03c1 (p\u0177r), 'fire'. In ancient Roman times, this name was applied to several types of stone that would create sparks when struck against steel; Pliny the Elder described one of them as being brassy, almost certainly a reference to what is now called pyrite."}}, {"canonical_name": "qualities", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 12, "members": [{"entity_id": "qualit\u00e9s_individuelles", "book_id": "epoques_nature_buffon_1778", "name": "qualit\u00e9s individuelles", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["qualit\u00e9s individuelles"], "contexts": ["specific traits of an individual"]}, {"entity_id": "qualities", "book_id": "principles_of_psychology_james_1890", "name": "qualities", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["qualities"], "contexts": ["attributes of objects cognized", "attributes or characteristics of things"]}, {"entity_id": "qualities", "book_id": "english_physician_1652", "name": "Qualities", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["Qualities"], "contexts": ["properties of Self-heal and Bugle"]}, {"entity_id": "calidades", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "calidades", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["calidades"], "contexts": ["characteristics of regions affecting crops"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "qualit\u00e9s individuelles", "target_book": "principles_of_psychology_james_1890", "target_name": "qualities", "similarity": 0.881}, {"source_book": "english_physician_1652", "source_name": "Qualities", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "calidades", "similarity": 0.911}], "id": 609, "stable_key": "clu_ee742ad178f239a9", "ground_truth": {"modern_name": "Qualities", "confidence": "high", "type": "concept"}}, {"canonical_name": "Diamonds", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "diamonds", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Diamonds", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["Diamonds"], "contexts": ["hard bodies that do not readily strike fire", "gem similar to Crystal"]}, {"entity_id": "diamans", "book_id": "relation_historique_humboldt_vol3_1825", "name": "diamans", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["diamans"], "contexts": ["Precious gemstone", "precious gemstone"]}, {"entity_id": "diamantes", "book_id": "historia_medicinal_monardes_1574", "name": "diamantes", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["diamantes", "Diamante", "Diamantes"], "contexts": ["precious stones from mines", "with diamonds, rubies, and other precious things"]}, {"entity_id": "diamonds", "book_id": "connexion_physical_sciences_somerville_1858", "name": "diamonds", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["diamonds"], "contexts": ["precious gemstone"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Diamonds", "target_book": "historia_medicinal_monardes_1574", "target_name": "diamantes", "similarity": 0.943}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Diamonds", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "diamonds", "similarity": 0.934}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "diamans", "target_book": "historia_medicinal_monardes_1574", "target_name": "diamantes", "similarity": 0.931}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "diamans", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "diamonds", "similarity": 0.944}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "diamantes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "diamonds", "similarity": 0.932}], "id": 610, "stable_key": "clu_3f295d20ee4888a4-2", "ground_truth": {"modern_name": "diamond", "confidence": "high", "type": "mineral", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Diamond", "wikipedia_extract": "Diamond is a solid form of the element carbon with its atoms arranged in a crystal structure called diamond cubic. Diamond is tasteless, odorless, strong, brittle solid, colorless in pure form, a poor conductor of electricity, and insoluble in water. Another solid form of carbon known as graphite is the chemically stable form of carbon at room temperature and pressure, but diamond is metastable and converts to it at a negligible rate under those conditions. Diamond has the highest hardness and thermal conductivity of any natural material, properties that are used in major industrial applications such as cutting and polishing tools. Because the arrangement of atoms in diamond is extremely rigid, few types of impurity can contaminate it (two exceptions are boron and nitrogen). Small numbers of defects or impurities (about one per million of lattice atoms) can color a diamond blue (boron), yellow (nitrogen), brown (defects), green (radiation exposure), purple, pink, orange, or red."}}, {"canonical_name": "Hawks", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "hawks", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hawks", "category": "ANIMAL", "subcategory": "BIRD", "count": 4, "variants": ["Hawks"], "contexts": ["animal whose talons were tested for electricity", "have peculiar vermine"]}, {"entity_id": "hawk", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hawk", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Hawk"], "contexts": ["predator causing birds to be silent"]}, {"entity_id": "hawks", "book_id": "origin_of_species_darwin_1859", "name": "hawks", "category": "ANIMAL", "subcategory": "BIRD", "count": 3, "variants": ["hawks"], "contexts": ["predatory birds that hunt by sight", "birds of prey that hunt other birds"]}, {"entity_id": "hawks", "book_id": "principles_of_psychology_james_1890", "name": "hawks", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["hawks"], "contexts": ["raptorial birds"]}, {"entity_id": "hawk", "book_id": "first_principles_spencer_1862", "name": "hawk", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["hawk"], "contexts": ["bird of prey", "bird of prey whose appearance causes destruction"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hawks", "target_book": "origin_of_species_darwin_1859", "target_name": "hawks", "similarity": 0.948}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hawks", "target_book": "principles_of_psychology_james_1890", "target_name": "hawks", "similarity": 0.948}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hawk", "target_book": "first_principles_spencer_1862", "target_name": "hawk", "similarity": 0.951}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hawks", "target_book": "principles_of_psychology_james_1890", "target_name": "hawks", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hawks", "target_book": "first_principles_spencer_1862", "target_name": "hawk", "similarity": 0.93}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hawks", "target_book": "first_principles_spencer_1862", "target_name": "hawk", "similarity": 0.93}], "id": 611, "stable_key": "clu_faba8ad364c6cdd2", "ground_truth": {"wikipedia_extract": "Hawks are birds of prey of the family Accipitridae. They are very widely distributed and are found on all continents, except Antarctica. The subfamily Accipitrinae includes goshawks, sparrowhawks, sharp-shinned hawks, and others. This subfamily are mainly woodland birds with short broad wings, long tails, and high visual acuity. They hunt by dashing suddenly from a concealed perch. In the United States, members of the Buteo group are also called hawks, though birds of this group are called buzzards in other parts of the world."}}, {"canonical_name": "para\u00edso terreal", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "paradise", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Paradise", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Paradise"], "contexts": ["biblical garden of Eden", "ideal place of knowledge"]}, {"entity_id": "paradise", "book_id": "kosmos_humboldt_1845", "name": "Paradise", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Paradise"], "contexts": ["biblical garden"]}, {"entity_id": "para\u00edso_terreal", "book_id": "coloquios_da_orta_1563", "name": "para\u00edso terreal", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["para\u00edso terreal", "Parayzo terreal", "Para\u00edso terrestre", "paraizo terreal"], "contexts": ["place from which a substance is said to come", "mythical location"]}, {"entity_id": "parai\u017fo_terreal", "book_id": "polyanthea_medicinal", "name": "Parai\u017fo terreal", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Parai\u017fo terreal"], "contexts": ["earthly paradise", "Earthly Paradise, location of the Tree of Life"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Paradise", "target_book": "kosmos_humboldt_1845", "target_name": "Paradise", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Paradise", "target_book": "coloquios_da_orta_1563", "target_name": "para\u00edso terreal", "similarity": 0.925}, {"source_book": "kosmos_humboldt_1845", "source_name": "Paradise", "target_book": "coloquios_da_orta_1563", "target_name": "para\u00edso terreal", "similarity": 0.925}, {"source_book": "coloquios_da_orta_1563", "source_name": "para\u00edso terreal", "target_book": "polyanthea_medicinal", "target_name": "Parai\u017fo terreal", "similarity": 0.911}], "id": 612, "stable_key": "clu_a470ce0f759c4d99", "ground_truth": {"modern_name": "Earthly Paradise", "confidence": "high", "type": "place", "description": "A mythical location, often associated with the Garden of Eden.", "wikipedia_extract": "In Abrahamic mythology, the Garden of Eden (Biblical Hebrew: \u05d2\u05b7\u05bc\u05df\u05be\u05e2\u05b5\u05d3\u05b6\u05df\u200e, romanized: gan-\u02bf\u0112\u1e0fen; Greek: \u0395\u03b4\u03ad\u03bc; Latin: Paradisus) or Garden of God (\u05d2\u05b7\u05bc\u05df\u05be\u05d9\u05b0\u05d4\u05b9\u05d5\u05b6\u05d4\u200e, gan-YHWH and \u05d2\u05b7\u05df\u05be\u05d0\u05b1\u05dc\u05b9\u05d4\u05b4\u05d9\u05dd\u200e, gan-Elohim), also called the Terrestrial Paradise, is the biblical paradise described in Genesis 2\u20133 and Ezekiel 28 and 31. The location of Eden is described in the Book of Genesis as the source of four tributaries. Various suggestions have been made for its location: at the head of the Persian Gulf, in southern Mesopotamia where the Tigris and Euphrates rivers run into the sea; and in Armenia. Others theorize that Eden was the entire Fertile Crescent or a region substantial in size in Mesopotamia, where its native inhabitants still exist in cities such as Telassar. Like the Genesis flood narrative, the Genesis creation narrative and the account of the Tower of Babel, the story of Eden echoes the Mesopotamian myth of a king, as a primordial man, who is placed in a divine garden to guard the tree of life. Scholars note that the Eden narrative shows parallels with aspects of Solomon's Temple and Jerusalem, attesting to its nature as a sacred place."}}, {"canonical_name": "Garcias", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "garcias_ab_horto", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Garcias ab horto", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Garcias ab Horto", "Garcias ab horto"], "contexts": ["physician to the Spanish Viceroy", "author on elephant experience and Malavar"]}, {"entity_id": "garcias", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Garcias", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Garcias"], "contexts": ["described ginger and nutmeg trees"]}, {"entity_id": "garcia", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Garcia", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Garcia"], "contexts": ["author of 'Orig. de los Ind.'", "cited source"]}, {"entity_id": "garcias", "book_id": "coloquios_da_orta_1563", "name": "Garcias", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Garcias", "Garciam"], "contexts": ["mentioned by Sprengel", "mentioned in relation to costus"]}, {"entity_id": "garcia", "book_id": "ricettario_fiorentino_1597", "name": "Garcia", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Garcia"], "contexts": ["scholar who described Indian trees"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Garcias ab horto", "target_book": "coloquios_da_orta_1563", "target_name": "Garcias", "similarity": 0.885}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Garcias", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Garcia", "similarity": 0.836}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Garcias", "target_book": "coloquios_da_orta_1563", "target_name": "Garcias", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Garcias", "target_book": "ricettario_fiorentino_1597", "target_name": "Garcia", "similarity": 0.836}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Garcia", "target_book": "coloquios_da_orta_1563", "target_name": "Garcias", "similarity": 0.836}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Garcia", "target_book": "ricettario_fiorentino_1597", "target_name": "Garcia", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Garcias", "target_book": "ricettario_fiorentino_1597", "target_name": "Garcia", "similarity": 0.836}], "id": 613, "stable_key": "clu_50ee63d084538d0d", "ground_truth": {"modern_name": "Christophorus a Costa", "confidence": "high", "type": "person", "birth_year": 1515, "death_year": 1588, "description": "Portuguese physician, botanist, and writer on Indian flora.", "note": "The text mentions 'Garcias ab Horto' and 'Coloquios da Orta', which refers to the Portuguese physician Garcia de Orta. However, the 'Orig. de los Ind.' and the context of ginger and nutmeg trees strongly points to Christophorus a Costa, who was a student of Garcia de Orta and wrote about his work. The name 'Garcias' is a plausible misspelling or variation of Garcia."}}, {"canonical_name": "salitre", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "saltpetre", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Saltpetre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Saltpetre"], "contexts": ["potassium nitrate"]}, {"entity_id": "salitre", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "salitre", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["salitre"], "contexts": ["saltpeter", "mineral used in wound treatment"]}, {"entity_id": "salitre", "book_id": "historia_medicinal_monardes_1574", "name": "salitre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["salitre", "Salitre"], "contexts": ["substance mentioned in contrast to snow's purity", "substance used for cooling"]}, {"entity_id": "saltpetre", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Saltpetre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Saltpetre"], "contexts": ["mineral that crystallizes in prisms"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Saltpetre", "target_book": "historia_medicinal_monardes_1574", "target_name": "salitre", "similarity": 0.893}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Saltpetre", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Saltpetre", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "salitre", "target_book": "historia_medicinal_monardes_1574", "target_name": "salitre", "similarity": 0.878}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "salitre", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Saltpetre", "similarity": 0.893}], "id": 614, "stable_key": "clu_e7998c56729f32e5", "ground_truth": {"modern_name": "Potassium nitrate", "confidence": "high", "type": "chemical", "wikidata_id": "Q177836", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Potassium%20nitrate", "note": "This cluster includes related terms like 'nitrous' and 'nitric acid', all pointing to compounds containing the nitrate ion.", "wikipedia_extract": "Potassium nitrate is a chemical compound with a sharp, salty, bitter taste and the chemical formula KNO3. It is a potassium salt of nitric acid. This salt consists of potassium cations K+ and nitrate anions NO\u22123, and is therefore an alkali metal nitrate. It occurs in nature as a mineral, niter (or nitre outside the United States). It is a source of nitrogen, and nitrogen was named after niter. Potassium nitrate is one of several nitrogen-containing compounds collectively referred to as saltpetre (or saltpeter in American English)."}}, {"canonical_name": "Butter", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "butter", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "butter", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["butter"], "contexts": ["animal product used in gunpowder"]}, {"entity_id": "butter", "book_id": "english_physician_1652", "name": "Butter", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["Butter"], "contexts": ["fried with herb for swellings", "fried in Butter"]}, {"entity_id": "beurre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "beurre", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 4, "variants": ["Beurre", "beurre"], "contexts": ["foodstuff in Havana", "butter"]}, {"entity_id": "butter", "book_id": "principles_of_psychology_james_1890", "name": "butter", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["butter"], "contexts": ["dairy product"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "butter", "target_book": "english_physician_1652", "target_name": "Butter", "similarity": 0.839}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "butter", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "beurre", "similarity": 0.912}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "butter", "target_book": "principles_of_psychology_james_1890", "target_name": "butter", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Butter", "target_book": "principles_of_psychology_james_1890", "target_name": "butter", "similarity": 0.839}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "beurre", "target_book": "principles_of_psychology_james_1890", "target_name": "butter", "similarity": 0.912}], "id": 615, "stable_key": "clu_0ef2532eb50dd363", "ground_truth": {"modern_name": "Butter", "confidence": "high", "type": "food", "note": "While butter is an animal product, in this context it's primarily referred to as a foodstuff or ingredient, not the animal itself.", "wikidata_id": "Q146130", "wikidata_description": "genus of flowering plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Ranunculus"}}, {"canonical_name": "Germans", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "germanicus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Germanicus", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Germanicus"], "contexts": ["Roman general and statesman"]}, {"entity_id": "germans", "book_id": "english_physician_1652", "name": "Germans", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 7, "variants": ["Germans"], "contexts": ["people who use Winter-Green salve", "people who prize wound herbs"]}, {"entity_id": "germans", "book_id": "principles_of_psychology_james_1890", "name": "Germans", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Germans"], "contexts": ["people who use the term empirical", "people from Germany"]}, {"entity_id": "alemanes", "book_id": "historia_medicinal_monardes_1574", "name": "Alemanes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Alemanes"], "contexts": ["soldiers in the army"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Germanicus", "target_book": "english_physician_1652", "target_name": "Germans", "similarity": 0.888}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Germanicus", "target_book": "principles_of_psychology_james_1890", "target_name": "Germans", "similarity": 0.888}, {"source_book": "english_physician_1652", "source_name": "Germans", "target_book": "principles_of_psychology_james_1890", "target_name": "Germans", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Germans", "target_book": "historia_medicinal_monardes_1574", "target_name": "Alemanes", "similarity": 0.978}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Germans", "target_book": "historia_medicinal_monardes_1574", "target_name": "Alemanes", "similarity": 0.978}], "id": 616, "stable_key": "clu_d8ba3e39812ae19d", "ground_truth": {"modern_name": "Germanicus", "confidence": "high", "type": "person", "birth_year": 15, "death_year": 19, "description": "Roman general and statesman, nephew of Emperor Augustus.", "note": "The cluster contains 'Germanicus' referring to the Roman general, and 'Germans' and 'Alemanes' which can refer to people from Germany. In the context of 'Winter-Green salve', it's likely referring to a plant associated with Germany, but the primary identification for 'Germanicus' is the historical figure.", "wikidata_id": "Q2695351", "wikidata_description": "ancient Roman cognomen, agnomen and victory title"}}, {"canonical_name": "Oxus", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "oxus", "book_id": "epoques_nature_buffon_1778", "name": "Oxus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Oxus"], "contexts": ["ancient name for Amu Darya river"]}, {"entity_id": "oxus", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Oxus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Oxus"], "contexts": ["ancient name for Amou/Djihoun river", "ancient name for Amou river"]}, {"entity_id": "oxus", "book_id": "kosmos_humboldt_1845", "name": "Oxus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Oxus"], "contexts": ["river in Central Asia", "river"]}, {"entity_id": "oxus", "book_id": "coloquios_da_orta_1563", "name": "Oxus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Oxus"], "contexts": ["river, also known as Amu-darya", "river east of which Uzbeks took lands"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Oxus", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Oxus", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Oxus", "target_book": "kosmos_humboldt_1845", "target_name": "Oxus", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Oxus", "target_book": "coloquios_da_orta_1563", "target_name": "Oxus", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oxus", "target_book": "kosmos_humboldt_1845", "target_name": "Oxus", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oxus", "target_book": "coloquios_da_orta_1563", "target_name": "Oxus", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Oxus", "target_book": "coloquios_da_orta_1563", "target_name": "Oxus", "similarity": 1.0}], "id": 617, "stable_key": "clu_e34b19c6d33f6306", "ground_truth": {"modern_name": "Amu Darya", "confidence": "high", "type": "place", "description": "A major river in Central Asia, historically known as the Oxus.", "note": "Also referred to as Djihoun in historical texts.", "wikipedia_extract": "The Amu Darya, historically known as the Oxus, is a major river in Central Asia which flows through Afghanistan, Tajikistan, Turkmenistan, and Uzbekistan. Rising in the Pamir Mountains, north of the Hindu Kush, the Amu Darya is formed by the confluence of the Vakhsh and Panj rivers, in the Tigrovaya Balka Nature Reserve on the border between Afghanistan and Tajikistan, and flows from there north-westwards into the southern remnants of the Aral Sea. However, today the Amu Darya does not reach the Aral Sea, and its mouth is in a dried-up area, of what was once the Aral Sea. In its upper course, the river forms part of Afghanistan's northern border with Tajikistan, Uzbekistan, and Turkmenistan. In ancient history, the river was regarded as the boundary of Greater Iran with Turan, which roughly corresponded to present-day Central Asia. The Amu Darya has a flow of about 70 cubic kilometres per year on average."}}, {"canonical_name": "Eggs", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "eggs", "book_id": "english_physician_1652", "name": "Eggs", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Eggs"], "contexts": ["food item"]}, {"entity_id": "eggs", "book_id": "origin_of_species_darwin_1859", "name": "Eggs", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 6, "variants": ["eggs", "Eggs"], "contexts": ["reproductive bodies of birds", "reproductive units of animals"]}, {"entity_id": "eggs", "book_id": "polyanthea_medicinal", "name": "eggs", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["eggs"], "contexts": ["soft, mixed with meat"]}, {"entity_id": "egg_yolk", "book_id": "polyanthea_medicinal", "name": "egg yolk", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["egg yolk"], "contexts": ["fresh raw egg yolk used in remedy"]}, {"entity_id": "eggs", "book_id": "first_principles_spencer_1862", "name": "eggs", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["eggs"], "contexts": ["hatching determined by temperature"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Eggs", "target_book": "origin_of_species_darwin_1859", "target_name": "Eggs", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Eggs", "target_book": "polyanthea_medicinal", "target_name": "eggs", "similarity": 0.987}, {"source_book": "english_physician_1652", "source_name": "Eggs", "target_book": "polyanthea_medicinal", "target_name": "egg yolk", "similarity": 0.934}, {"source_book": "english_physician_1652", "source_name": "Eggs", "target_book": "first_principles_spencer_1862", "target_name": "eggs", "similarity": 0.987}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Eggs", "target_book": "polyanthea_medicinal", "target_name": "eggs", "similarity": 0.987}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Eggs", "target_book": "polyanthea_medicinal", "target_name": "egg yolk", "similarity": 0.934}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Eggs", "target_book": "first_principles_spencer_1862", "target_name": "eggs", "similarity": 0.987}, {"source_book": "polyanthea_medicinal", "source_name": "eggs", "target_book": "first_principles_spencer_1862", "target_name": "eggs", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "egg yolk", "target_book": "first_principles_spencer_1862", "target_name": "eggs", "similarity": 0.932}], "id": 618, "stable_key": "clu_ff322c337a6d78e1", "ground_truth": {"modern_name": "Eggs", "confidence": "high", "type": "food", "note": "Refers to eggs as food or reproductive bodies of birds, distinct from 'egg' as an individual item.", "wikidata_id": "Q9384", "wikidata_description": "internal organ used in the male reproductive system", "wikipedia_url": "https://en.wikipedia.org/wiki/Testicle"}}, {"canonical_name": "tristeza", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "sadness", "book_id": "english_physician_1652", "name": "Sadness", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Sadness"], "contexts": ["affliction to be expelled"]}, {"entity_id": "tristezas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "tristezas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["tristezas"], "contexts": ["excessive sadness", "sadness"]}, {"entity_id": "sadness", "book_id": "kosmos_humboldt_1845", "name": "sadness", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["sadness"], "contexts": ["emotional state of unhappiness"]}, {"entity_id": "tristeza", "book_id": "polyanthea_medicinal", "name": "tristeza", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 7, "variants": ["tristeza", "Tristezas", "tristezas"], "contexts": ["Sadness that wine dispels", "emotion, sadness"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Sadness", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "tristezas", "similarity": 0.967}, {"source_book": "english_physician_1652", "source_name": "Sadness", "target_book": "kosmos_humboldt_1845", "target_name": "sadness", "similarity": 0.995}, {"source_book": "english_physician_1652", "source_name": "Sadness", "target_book": "polyanthea_medicinal", "target_name": "tristeza", "similarity": 0.971}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "tristezas", "target_book": "kosmos_humboldt_1845", "target_name": "sadness", "similarity": 0.971}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "tristezas", "target_book": "polyanthea_medicinal", "target_name": "tristeza", "similarity": 0.995}, {"source_book": "kosmos_humboldt_1845", "source_name": "sadness", "target_book": "polyanthea_medicinal", "target_name": "tristeza", "similarity": 0.977}], "id": 619, "stable_key": "clu_5e6ae3a64d00eeee", "ground_truth": {"modern_name": "Melancholy", "confidence": "high", "type": "disease", "modern_term": "Melancholy", "note": "While 'sadness' is a direct translation, in the context of early modern medicine, 'tristeza' often referred to a more profound, melancholic state akin to what was historically understood as melancholy, a recognized condition with potential physical and mental symptoms.", "wikidata_id": "Q192077", "wikidata_description": "mood disorder of non-specific depression", "wikipedia_url": "https://en.wikipedia.org/wiki/Melancholia", "wikipedia_extract": "Melancholia or melancholy (Ancient Greek: \u03bc\u03b5\u03bb\u03b1\u03b3\u03c7\u03bf\u03bb\u03af\u03b1, romanized: melanchol\u00eda; from \u03bc\u03ad\u03bb\u03b1\u03b9\u03bd\u03b1 \u03c7\u03bf\u03bb\u03ae, m\u00e9laina chol\u1e17, 'black bile') is a concept found throughout ancient, medieval, and premodern medicine in Europe that describes a condition characterized by markedly depressed mood, bodily complaints, and sometimes hallucinations and delusions. Besides a pathological condition, melancholy could also refer to a mood or temperament and at times it was even used as a description of the human condition in general. Melancholy (or more precisely the 'black bile', from which melancholy derives its name) was regarded as one of the four temperaments matching the four humours. Until the 18th century, doctors and other scholars classified melancholic conditions as such by their perceived common cause \u2013 an excess of a notional fluid known as \"black bile\", which was commonly linked to the spleen. Hippocrates and other ancient physicians described melancholia as a distinct disease with mental and physical symptoms, including persistent fears and despondencies, poor appetite, abulia, sleeplessness, irritability, and agitation. Later, fixed delusions were added by Galen and other physicians to the list of symptoms.", "description": "A state of prolonged sadness, low spirits, or humors."}}, {"canonical_name": "Labrador", "category": "PLACE", "subcategory": "REGION", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "labrador", "book_id": "origin_of_species_darwin_1859", "name": "Labrador", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Labrador"], "contexts": ["region with similar plants to White Mountains", "region with arctic plants"]}, {"entity_id": "labrador", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Labrador", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Labrador"], "contexts": ["wild country", "territory in Canada"]}, {"entity_id": "labrador", "book_id": "kosmos_humboldt_1845", "name": "Labrador", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Labrador"], "contexts": ["peninsula in northeastern Canada", "coastal area in Eastern America"]}, {"entity_id": "labrador", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Labrador", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Labrador"], "contexts": ["coast with Table Bay on freezing point line", "region in Canada"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Labrador", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Labrador", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Labrador", "target_book": "kosmos_humboldt_1845", "target_name": "Labrador", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Labrador", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Labrador", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Labrador", "target_book": "kosmos_humboldt_1845", "target_name": "Labrador", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Labrador", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Labrador", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Labrador", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Labrador", "similarity": 1.0}], "id": 620, "stable_key": "clu_210aaea351081370", "ground_truth": {"modern_name": "Labrador", "confidence": "high", "type": "place", "description": "A large geographical region in northeastern Canada.", "note": "Refers to the geographical region of Labrador, known for its arctic flora and wild terrain.", "wikipedia_extract": "Labrador () is a geographic and cultural region within the Canadian province of Newfoundland and Labrador. It is the primarily continental portion of the province and constitutes 71% of the province's area but is home to only 6% of its population. It is separated from the island of Newfoundland by the Strait of Belle Isle. It is the largest and northernmost geographical region in the four Atlantic provinces. Labrador occupies most of the eastern part of the Labrador Peninsula. It is bordered to the west and south by the province of Quebec."}}, {"canonical_name": "Mankind", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "mankind", "book_id": "origin_of_species_darwin_1859", "name": "mankind", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mankind"], "contexts": ["the human species"]}, {"entity_id": "mankind", "book_id": "principles_of_psychology_james_1890", "name": "mankind", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mankind"], "contexts": ["human nature and society"]}, {"entity_id": "mankind", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mankind", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["mankind", "Mankind"], "contexts": ["human species", "varieties of humans"]}, {"entity_id": "mankind", "book_id": "first_principles_spencer_1862", "name": "mankind", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["mankind", "Mankind"], "contexts": ["the human species", "the human race; humanity"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "mankind", "target_book": "principles_of_psychology_james_1890", "target_name": "mankind", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mankind", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mankind", "similarity": 0.966}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mankind", "target_book": "first_principles_spencer_1862", "target_name": "mankind", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "mankind", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mankind", "similarity": 0.966}, {"source_book": "principles_of_psychology_james_1890", "source_name": "mankind", "target_book": "first_principles_spencer_1862", "target_name": "mankind", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Mankind", "target_book": "first_principles_spencer_1862", "target_name": "mankind", "similarity": 0.966}], "id": 621, "stable_key": "clu_e88c12357e2fd947", "ground_truth": {"modern_name": "Humankind", "confidence": "high", "type": "concept", "wikidata_id": "Q5", "wikidata_description": "any single member of Homo sapiens, unique extant species of the genus Homo"}}, {"canonical_name": "Brown", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "brown", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Brown", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Brown", "M. Brown"], "contexts": ["author of Narrative", "cited scholar on palms"]}, {"entity_id": "brown", "book_id": "principles_of_psychology_james_1890", "name": "Brown", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 6, "variants": ["Brown"], "contexts": ["researcher of brain function", "observed hearing function in animals"]}, {"entity_id": "brown", "book_id": "kosmos_humboldt_1845", "name": "Brown", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Brown"], "contexts": ["African traveler"]}, {"entity_id": "brown", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Brown", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["brown", "Brown"], "contexts": ["color after heat application", "found peculiar vegetation in Australia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Brown", "target_book": "principles_of_psychology_james_1890", "target_name": "Brown", "similarity": 0.654}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Brown", "target_book": "kosmos_humboldt_1845", "target_name": "Brown", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Brown", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Brown", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Brown", "target_book": "kosmos_humboldt_1845", "target_name": "Brown", "similarity": 0.654}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Brown", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Brown", "similarity": 0.654}, {"source_book": "kosmos_humboldt_1845", "source_name": "Brown", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Brown", "similarity": 1.0}], "id": 622, "stable_key": "clu_16d2f0f4bd150be4", "ground_truth": {"modern_name": "John Brown", "confidence": "medium", "type": "person", "description": "African traveler, researcher of brain function, author.", "note": "Multiple individuals named Brown appear in the period. The context of African travel and brain function suggests possible figures like Mungo Park or early neurologists, but without more context, it's difficult to pinpoint.", "wikidata_id": "Q637377", "wikidata_description": "Scottish personal servant and favourite of Queen Victoria (1826\u20131883)", "wikipedia_url": "https://en.wikipedia.org/wiki/John%20Brown%20%28servant%29", "wikipedia_extract": "John Brown (8 December 1826 \u2013 27 March 1883) was a Scottish personal attendant and favourite of Queen Victoria for many years after working as a gillie for Prince Albert. He was appreciated by many (including the Queen) for his competence and companionship, and resented by others (most notably her son and heir apparent, the future Edward VII, the rest of the Queen's children, ministers, and the palace staff) for his influence and informal manner. The exact nature of his relationship with Victoria was the subject of great speculation by contemporaries. John Brown was born on 8 December 1826 at Crathienaird, Crathie and Braemar Aberdeenshire, to Margaret Leys and John Brown, and went to work as an outdoor servant (in Scots gillie or ghillie) at Balmoral Castle, which Queen Victoria and Prince Albert leased in February 1848, and purchased outright in November 1851. Brown had several younger brothers and a sister, three of whom also entered the royal service. His brother Archibald Anderson \"Archie\" Brown, 15 years John's junior, eventually became personal valet to Victoria's youngest son, Prince Leopold, Duke of Albany."}}, {"canonical_name": "color", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "color", "book_id": "principles_of_psychology_james_1890", "name": "color", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["color"], "contexts": ["perceptual quality", "visual property of light"]}, {"entity_id": "color", "book_id": "kosmos_humboldt_1845", "name": "color", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["color"], "contexts": ["property of the atmosphere"]}, {"entity_id": "color", "book_id": "historia_medicinal_monardes_1574", "name": "color", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["color", "color de nostro"], "contexts": ["desired quality of liquid", "visual appearance"]}, {"entity_id": "colore", "book_id": "ricettario_fiorentino_1597", "name": "colore", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["colore"], "contexts": ["quality of water"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "color", "target_book": "kosmos_humboldt_1845", "target_name": "color", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "color", "target_book": "historia_medicinal_monardes_1574", "target_name": "color", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "color", "target_book": "ricettario_fiorentino_1597", "target_name": "colore", "similarity": 0.975}, {"source_book": "kosmos_humboldt_1845", "source_name": "color", "target_book": "historia_medicinal_monardes_1574", "target_name": "color", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "color", "target_book": "ricettario_fiorentino_1597", "target_name": "colore", "similarity": 0.975}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "color", "target_book": "ricettario_fiorentino_1597", "target_name": "colore", "similarity": 0.975}], "id": 623, "stable_key": "clu_47296163f0ec0df4", "ground_truth": {"modern_name": "color", "confidence": "high", "type": "concept", "wikidata_id": "Q1261", "wikidata_description": "state of the United States of America", "wikipedia_url": "https://en.wikipedia.org/wiki/Color", "note": "The context in 'principles_of_psychology_james_1890' and 'relation_historique_humboldt_vol3_1825' might lean towards pigments or optical phenomena, but 'color' as a general concept covers these.", "wikipedia_extract": "Color (or colour in Commonwealth English; see spelling differences) is the visual perception based on the electromagnetic spectrum. Though color is not an inherent property of matter, color perception is related to an object's light absorption, emission, reflection and transmission. For most humans, visible wavelengths of light are the ones perceived in the visible light spectrum, with three types of cone cells (trichromacy). Other animals may have a different number of cone cell types or have eyes sensitive to different wavelengths, such as bees that can distinguish ultraviolet, and thus have a different color sensitivity range. Animal perception of color originates from different light wavelength or spectral sensitivity in cone cell types, which is then processed by the brain. Colors have perceived properties such as hue, colorfulness, and lightness."}}, {"canonical_name": "atmospheric pressure", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "pression_atmosph\u00e9rique_ext\u00e9rieure", "book_id": "medecine_experimentale_bernard_1865", "name": "pression atmosph\u00e9rique ext\u00e9rieure", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["pression atmosph\u00e9rique ext\u00e9rieure"], "contexts": ["pressure of the external atmosphere"]}, {"entity_id": "atmospheric_pressure", "book_id": "kosmos_humboldt_1845", "name": "atmospheric pressure", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["atmospheric pressure", "Atmospheric Pressure"], "contexts": ["force exerted by the atmosphere", "pressure exerted by the atmosphere"]}, {"entity_id": "atmospheric_pressure", "book_id": "connexion_physical_sciences_somerville_1858", "name": "atmospheric pressure", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["atmospheric pressure"], "contexts": ["pressure exerted by atmosphere", "force exerted by the atmosphere"]}, {"entity_id": "atmospheric_pressure", "book_id": "first_principles_spencer_1862", "name": "atmospheric pressure", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["atmospheric pressure"], "contexts": ["pressure exerted by the atmosphere"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "pression atmosph\u00e9rique ext\u00e9rieure", "target_book": "kosmos_humboldt_1845", "target_name": "atmospheric pressure", "similarity": 0.902}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "atmospheric pressure", "target_book": "first_principles_spencer_1862", "target_name": "atmospheric pressure", "similarity": 1.0}], "id": 624, "stable_key": "clu_7bb0d777e86e1698", "ground_truth": {"modern_name": "atmospheric pressure", "confidence": "high", "type": "concept", "wikidata_id": "Q81809", "wikidata_description": "static pressure exerted by the weight of the atmosphere", "wikipedia_url": "https://en.wikipedia.org/wiki/Atmospheric%20pressure", "wikipedia_extract": "Atmospheric pressure, also known as air pressure or barometric pressure (after the barometer), is the pressure within the atmosphere of Earth. The standard atmosphere (symbol: atm) is a unit of pressure defined as 101,325 Pa (1,013.25 hPa), which is equivalent to 1,013.25 millibars, 760 torr (or about 760 mmHg), about 29.9212 inHg, or about 14.696 psi. The atm unit is roughly equivalent to the mean sea-level atmospheric pressure on Earth; that is, the Earth's atmospheric pressure at sea level is approximately 1 atm. In most circumstances, atmospheric pressure is closely approximated by the hydrostatic pressure caused by the weight of air above the measurement point. As elevation increases, there is less overlying atmospheric mass, so atmospheric pressure decreases with increasing elevation. Because the atmosphere is thin relative to the Earth's radius\u2014especially the dense atmospheric layer at low altitudes\u2014the Earth's gravitational acceleration as a function of altitude can be approximated as constant and contributes little to this fall-off."}}, {"canonical_name": "generation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "generation", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "generation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["generation"], "contexts": ["process of reproduction", "process of producing offspring"]}, {"entity_id": "generation", "book_id": "origin_of_species_darwin_1859", "name": "generation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["generation"], "contexts": ["process of reproduction", "successive group of offspring"]}, {"entity_id": "g\u00e9n\u00e9ration", "book_id": "epoques_nature_buffon_1778", "name": "g\u00e9n\u00e9ration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["g\u00e9n\u00e9ration", "G\u00e9n\u00e9ration"], "contexts": ["reproduction, procreation", "Buffon's memoir on reproduction"]}, {"entity_id": "generacion", "book_id": "historia_medicinal_monardes_1574", "name": "generacion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["generacion"], "contexts": ["generation"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "generation", "target_book": "origin_of_species_darwin_1859", "target_name": "generation", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "g\u00e9n\u00e9ration", "target_book": "historia_medicinal_monardes_1574", "target_name": "generacion", "similarity": 0.966}], "id": 625, "stable_key": "clu_6a1713f883116d11", "ground_truth": {"modern_name": "Generation", "confidence": "high", "type": "concept", "note": "Refers to the process of reproduction and lineage, common in biological and philosophical discussions."}}, {"canonical_name": "math\u00e9matiques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 10, "members": [{"entity_id": "math\u00e9matiques", "book_id": "medecine_experimentale_bernard_1865", "name": "math\u00e9matiques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["math\u00e9matiques"], "contexts": ["the study of numbers, quantity, space, and structure", "abstract science of number and space"]}, {"entity_id": "mathematical", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mathematical", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Mathematical"], "contexts": ["relating to mathematics"]}, {"entity_id": "math\u00e9matique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "math\u00e9matique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["math\u00e9matique"], "contexts": ["study of numbers, quantity, space, and change"]}, {"entity_id": "mathematical", "book_id": "kosmos_humboldt_1845", "name": "mathematical", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mathematical"], "contexts": ["relating to mathematics"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "math\u00e9matiques", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "math\u00e9matique", "similarity": 0.978}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "math\u00e9matiques", "target_book": "kosmos_humboldt_1845", "target_name": "mathematical", "similarity": 0.933}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mathematical", "target_book": "kosmos_humboldt_1845", "target_name": "mathematical", "similarity": 0.967}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "math\u00e9matique", "target_book": "kosmos_humboldt_1845", "target_name": "mathematical", "similarity": 0.954}], "id": 626, "stable_key": "clu_aa7b75e3c263398b", "ground_truth": {"modern_name": "Mathematics", "confidence": "high", "type": "concept", "wikidata_id": "Q853077", "wikidata_description": "mathematics teaching, learning and scholarly research", "wikipedia_url": "https://en.wikipedia.org/wiki/Mathematics%20education", "wikipedia_extract": "In contemporary education, mathematics education (known in Europe as the didactics or pedagogy of mathematics) is the practice of teaching, learning, and carrying out scholarly research into the transfer of mathematical knowledge. Although research into mathematics education is primarily concerned with the tools, methods, and approaches that facilitate practice or the study of practice, it also covers an extensive field of study encompassing a variety of different concepts, theories and methods. National and international organisations regularly hold conferences and publish literature in order to improve mathematics education. Elementary mathematics were a core part of education in many ancient civilisations, including ancient Egypt, ancient Babylonia, ancient Greece, ancient Rome, and Vedic India. In most cases, formal education was only available to male children with sufficiently high status, wealth, or caste. The oldest known mathematics textbook is the Rhind papyrus, dated from circa 1650 BCE."}}, {"canonical_name": "exp\u00e9riences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 10, "members": [{"entity_id": "exp\u00e9riences", "book_id": "medecine_experimentale_bernard_1865", "name": "exp\u00e9riences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["exp\u00e9riences"], "contexts": ["scientific investigations and tests", "scientific experiments"]}, {"entity_id": "experiences", "book_id": "medecine_experimentale_bernard_1865", "name": "experiences", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["experiences"], "contexts": ["practical contact with and observation of facts or events"]}, {"entity_id": "experiencias", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "experiencias", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["experiencias"], "contexts": ["empirical observations and trials"]}, {"entity_id": "experiences", "book_id": "principles_of_psychology_james_1890", "name": "experiences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["experiences"], "contexts": ["events or sensations undergone", "events and sensations that fill time"]}, {"entity_id": "experiences", "book_id": "first_principles_spencer_1862", "name": "experiences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["experiences"], "contexts": ["events that shape understanding", "events or observations that inform understanding"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "exp\u00e9riences", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "experiencias", "similarity": 0.959}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "exp\u00e9riences", "target_book": "principles_of_psychology_james_1890", "target_name": "experiences", "similarity": 0.952}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "exp\u00e9riences", "target_book": "first_principles_spencer_1862", "target_name": "experiences", "similarity": 0.952}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "experiences", "target_book": "quatro_libros_naturaleza_hernandez_1615"