0.919}], "id": 5060, "stable_key": "clu_5e8c5f8b5a2ee09e", "ground_truth": {"modern_name": "Gastric digestion", "confidence": "high", "type": "concept", "note": "The phrases 'digestion gastrique' and 'digesti\u00f3n del estomago' clearly refer to the process of digestion in the stomach.", "wikidata_id": "Q74299776", "wikidata_description": "scientific article published on 01 August 2001"}}, {"canonical_name": "balle", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "balle", "book_id": "medecine_experimentale_bernard_1865", "name": "balle", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["balle"], "contexts": ["projectile causing injury"]}, {"entity_id": "balls", "book_id": "principles_of_psychology_james_1890", "name": "balls", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["balls"], "contexts": ["spherical objects for juggling"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "balle", "target_book": "principles_of_psychology_james_1890", "target_name": "balls", "similarity": 0.911}], "id": 5061, "stable_key": "clu_6b8bb335504c3bc2", "ground_truth": {"modern_name": "Projectile", "confidence": "medium", "type": "object", "note": "The term 'balle' (French) and 'balls' (English) are ambiguous. In Bernard's work, it likely refers to a projectile causing injury, but in James' work, it could be a more general spherical object. Given the context of injury, 'projectile' is the most fitting for Bernard.", "wikidata_id": "Q49393", "wikidata_description": "any object thrown into space (empty or not) by the exertion of a force", "wikipedia_url": "https://en.wikipedia.org/wiki/Projectile"}}, {"canonical_name": "l\u00e9sions pathologiques", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "l\u00e9sions_pathologiques", "book_id": "medecine_experiment