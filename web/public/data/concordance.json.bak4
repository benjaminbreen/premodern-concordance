ncient author discussing lycium"]}, {"entity_id": "celsus", "book_id": "polyanthea_medicinal", "name": "Celsus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 10, "variants": ["Celsus"], "contexts": ["ancient medical authority on maintaining health", "ancient authority"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Celsus", "target_book": "coloquios_da_orta_1563", "target_name": "Celso", "similarity": 0.906}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Celsus", "target_book": "polyanthea_medicinal", "target_name": "Celsus", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Celso", "target_book": "polyanthea_medicinal", "target_name": "Celsus", "similarity": 0.906}], "id": 1161, "stable_key": "clu_772e4f9a92d2858a", "ground_truth": {"modern_name": "Aulus Cornelius Celsus", "confidence": "high", "type": "person", "description": "Roman encyclopedist and medical writer.", "wikipedia_extract": "Aulus Cornelius Celsus (c. 25 BC \u2013 c. 50 AD) was a Roman encyclopedist, known for his extant medical work, De Medicina, which is believed to be the only surviving section of a much larger encyclopedia. The De Medicina is a primary source on diet, pharmacy, surgery and related fields, and it is one of the best sources concerning medical knowledge in the Roman world. The lost portions of his encyclopedia likely included volumes on agriculture, law, rhetoric, and military arts. He made contributions to the classification of human skin disorders in  dermatology, such as myrmecia, and his name is often found in medical terminology regarding the skin, e.g., kerion celsi and area celsi. He is also the namesake of Paracelsus (lit. Above Celsus), a great Swiss alchemist and physician prevalent in the Medical Renaissance."}}, {"canonical_name": "amber", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "amber", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Amber", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["Amber"], "contexts": ["attracts light bodies", "material reckoned among bitumens, tested for electricity"]}, {"entity_id": "amber", "book_id": "english_physician_1652", "name": "Amber", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Amber"], "contexts": ["substance mixed with plant dust", "white substance used with distilled water"]}, {"entity_id": "amber", "book_id": "kosmos_humboldt_1845", "name": "amber", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["Amber", "amber"], "contexts": ["fossilized tree resin, known for electrostatic properties", "fossilized resin found with coal"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Amber", "target_book": "english_physician_1652", "target_name": "Amber", "similarity": 0.855}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Amber", "target_book": "kosmos_humboldt_1845", "target_name": "amber", "similarity": 0.986}, {"source_book": "english_physician_1652", "source_name": "Amber", "target_book": "kosmos_humboldt_1845", "target_name": "amber", "similarity": 0.863}], "id": 1162, "stable_key": "clu_cbcca2bc5a68e3b4-2", "ground_truth": {"modern_name": "Amber", "confidence": "high", "type": "mineral", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "cat", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "cats", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Cats", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["Cats"], "contexts": ["worshipped animals", "animals that speak to witches"]}, {"entity_id": "cat", "book_id": "origin_of_species_darwin_1859", "name": "cat", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 4, "variants": ["cat"], "contexts": ["domestic feline predator", "mammal that curls its tail"]}, {"entity_id": "cat_genus", "book_id": "origin_of_species_darwin_1859", "name": "cat genus", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["cat genus"], "contexts": ["family of feline species"]}, {"entity_id": "cat", "book_id": "principles_of_psychology_james_1890", "name": "cat", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 5, "variants": ["cat"], "contexts": ["animal studied for motor regions", "a common domestic animal"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Cats", "target_book": "origin_of_species_darwin_1859", "target_name": "cat", "similarity": 0.937}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Cats", "target_book": "origin_of_species_darwin_1859", "target_name": "cat genus", "similarity": 0.893}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Cats", "target_book": "principles_of_psychology_james_1890", "target_name": "cat", "similarity": 0.937}, {"source_book": "origin_of_species_darwin_1859", "source_name": "cat", "target_book": "principles_of_psychology_james_1890", "target_name": "cat", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "cat genus", "target_book": "principles_of_psychology_james_1890", "target_name": "cat", "similarity": 0.924}], "id": 1163, "stable_key": "clu_221f8d9f0bc823ba", "ground_truth": {"modern_name": "Domestic cat", "confidence": "high", "type": "animal", "wikidata_id": "Q2961479", "wikidata_description": "heraldic animal"}}, {"canonical_name": "Viper", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "vipers", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Vipers", "category": "ANIMAL", "subcategory": "REPTILE", "count": 2, "variants": ["Vipers"], "contexts": ["creatures of higher mischiefs", "reptiles producing higher mischiefs"]}, {"entity_id": "viper", "book_id": "english_physician_1652", "name": "Viper", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 7, "variants": ["Viper", "Vipers"], "contexts": ["venomous beast", "animal whose bite is treated"]}, {"entity_id": "viper", "book_id": "polyanthea_medicinal", "name": "Viper", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["Viper", "viper", "viperas", "viperino"], "contexts": ["venomous creature", "venomous bite, volatile salt"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Vipers", "target_book": "english_physician_1652", "target_name": "Viper", "similarity": 0.898}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Vipers", "target_book": "polyanthea_medicinal", "target_name": "Viper", "similarity": 0.898}, {"source_book": "english_physician_1652", "source_name": "Viper", "target_book": "polyanthea_medicinal", "target_name": "Viper", "similarity": 1.0}], "id": 1164, "stable_key": "clu_8f0214d1b4ba7be4", "ground_truth": {"modern_name": "Viper", "confidence": "high", "type": "animal", "description": "Venomous snake used in traditional medicine and remedies.", "wikipedia_extract": "Vipers are snakes in the family Viperidae, found in most parts of the world, except for Antarctica, Australia, Hawaii, Madagascar, Ireland, and various other isolated islands. All vipers are venomous, and have long (relative to non-vipers), hinged fangs that permit deep envenomation of their prey. Three subfamilies are currently recognized. They are also known as viperids. The name \"viper\" is derived from the Latin word vipera, -ae, also meaning viper, possibly from vivus (\"living\") and parere (\"to beget\"), referring to the trait viviparity (giving live birth) common in vipers like most of the species of Boidae. The earliest known vipers are believed to have diverged from the rest of the clade Caenophidia in the early Eocene."}}, {"canonical_name": "magnets", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "magnet", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Magnet", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Magnet"], "contexts": ["attracts iron filings"]}, {"entity_id": "magnets", "book_id": "principles_of_psychology_james_1890", "name": "magnets", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["magnets"], "contexts": ["magnetic materials used for treatment", "used to remove nervous disorder"]}, {"entity_id": "magnets", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnets", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 10, "variants": ["magnets", "Magnets"], "contexts": ["objects made by electrical power", "objects with magnetic fields"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Magnet", "target_book": "principles_of_psychology_james_1890", "target_name": "magnets", "similarity": 0.923}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Magnet", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnets", "similarity": 0.923}, {"source_book": "principles_of_psychology_james_1890", "source_name": "magnets", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnets", "similarity": 1.0}], "id": 1165, "stable_key": "clu_f20acfeb31f08142", "ground_truth": {"modern_name": "Magnets", "confidence": "high", "type": "mineral", "wikidata_id": "Q161238", "wikidata_description": "non-destructive technique for imaging internal structures of objects or organisms", "wikipedia_url": "", "wikipedia_extract": ""}}, {"canonical_name": "ABortion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "abortion", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "abortion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["abortion"], "contexts": ["medical condition"]}, {"entity_id": "abortion", "book_id": "english_physician_1652", "name": "ABortion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 9, "variants": ["ABortion", "Abortion", "Abortment", "abortion", "abortment"], "contexts": ["condition prevented by plantain root decoction", "risk associated with Briony use"]}, {"entity_id": "abortire", "book_id": "polyanthea_medicinal", "name": "abortire", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["abortire", "abortive"], "contexts": ["miscarriage", "medical condition of miscarriage"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "abortion", "target_book": "english_physician_1652", "target_name": "ABortion", "similarity": 0.89}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "abortion", "target_book": "polyanthea_medicinal", "target_name": "abortire", "similarity": 0.983}, {"source_book": "english_physician_1652", "source_name": "ABortion", "target_book": "polyanthea_medicinal", "target_name": "abortire", "similarity": 0.881}], "id": 1166, "stable_key": "clu_a98fc6ea41390646", "ground_truth": {"modern_name": "abortion", "confidence": "high", "type": "disease", "description": "The premature expulsion of a fetus from the uterus.", "wikipedia_extract": "Abortion is the termination of a pregnancy by removal or expulsion of an embryo or fetus. The unmodified word abortion generally refers to induced abortion, or deliberate actions to end a pregnancy. Abortion occurring without intervention is known as spontaneous abortion or \"miscarriage\", and occurs in roughly 30\u201340% of all pregnancies. Common reasons for inducing an abortion are birth-timing and limiting family size. Other reasons include maternal health, an inability to afford a child, domestic violence, lack of support, feelings of being too young, wishing to complete an education or advance a career, and not being able, or willing, to raise a child conceived as a result of rape or incest. When done legally in industrialized societies, induced abortion is one of the safest procedures in medicine."}}, {"canonical_name": "Ptolemy", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "ptolemy", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ptolemy", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Ptolemy"], "contexts": ["ancient astronomer and geographer"]}, {"entity_id": "ptolemy", "book_id": "kosmos_humboldt_1845", "name": "Ptolemy", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Ptolemy"], "contexts": ["ancient geographer and astronomer"]}, {"entity_id": "ptolemies", "book_id": "kosmos_humboldt_1845", "name": "Ptolemies", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Ptolemies"], "contexts": ["dynasty of rulers"]}, {"entity_id": "ptolemy", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Ptolemy", "category": "PERSON", "subcategory": "AUTHORITY", "count": 10, "variants": ["Ptolemy"], "contexts": ["ancient astronomer", "ancient astronomer and geographer"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ptolemy", "target_book": "kosmos_humboldt_1845", "target_name": "Ptolemy", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ptolemy", "target_book": "kosmos_humboldt_1845", "target_name": "Ptolemies", "similarity": 0.92}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ptolemy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Ptolemy", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Ptolemy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Ptolemy", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Ptolemies", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Ptolemy", "similarity": 0.92}], "id": 1167, "stable_key": "clu_afc9d36c9ee9b66a", "ground_truth": {"modern_name": "Ptolemy", "confidence": "high", "type": "person", "birth_year": 100, "death_year": 170, "description": "Ancient astronomer, geographer, and mathematician", "note": "References may include the ruler dynasty, but astronomical context is primary.", "wikidata_id": "", "wikidata_description": "male given name", "wikipedia_url": "https://en.wikipedia.org/wiki/Ptolemy%20%28name%29", "wikipedia_extract": "Ptolemy (Ancient Greek: \u03a0\u03c4\u03bf\u03bb\u03b5\u03bc\u03b1\u1fd6\u03bf\u03c2, Ptolemaios) is a male given name, derived from Ancient Greek and meaning 'warlike'. It is formed from the Epic Greek \u03c0\u03c4\u03cc\u03bb\u03b5\u03bc\u03bf\u03c2 ptolemos meaning 'war'. The name was used throughout the Greek world, but was particularly popular in ancient Macedon and its nobility. The earliest recorded use of the name is in the Iliad of Homer. During the Hellenistic period, Ptolemy I Soter, a general of Alexander the Great, founded the Ptolemaic dynasty which ruled their Kingdom in Ancient Egypt. All male rulers of the dynasty bore the name 'Ptolemy', the last being Ptolemy XII Auletes, father of Cleopatra."}}, {"canonical_name": "Pear-tree", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "pear-tree", "book_id": "english_physician_1652", "name": "Pear-tree", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["Pear-tree", "Peach-Tree", "Peach-tree", "Pear-trees"], "contexts": ["tree whose leaf is similar", "well known tree"]}, {"entity_id": "pear", "book_id": "origin_of_species_darwin_1859", "name": "Pear", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["pear", "Pear"], "contexts": ["fruit cultivated in classical times", "fruit-bearing tree"]}, {"entity_id": "pear", "book_id": "principles_of_psychology_james_1890", "name": "pear", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["pear"], "contexts": ["fruit with a distinct flavor"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Pear-tree", "target_book": "origin_of_species_darwin_1859", "target_name": "Pear", "similarity": 0.911}, {"source_book": "english_physician_1652", "source_name": "Pear-tree", "target_book": "principles_of_psychology_james_1890", "target_name": "pear", "similarity": 0.917}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Pear", "target_book": "principles_of_psychology_james_1890", "target_name": "pear", "similarity": 0.974}], "id": 1168, "stable_key": "clu_1b9546da219d5934-2", "ground_truth": {"modern_name": "Pear", "confidence": "high", "type": "plant", "linnaean": "Pyrus communis", "family": "Rosaceae", "wikidata_id": "Q434", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Pear", "note": "The specific variety of 'P\u00eara' is not identified.", "wikipedia_extract": "Pears are fruits produced and consumed around the world, growing on a tree and are harvested in late summer into mid-autumn. The pear tree and shrub are a species of genus Pyrus , in the family Rosaceae, bearing the pomaceous fruit of the same name. Several species of pears are valued for their edible fruit and juices, while others are cultivated as trees. The tree is medium-sized and native to coastal and mildly temperate regions of Europe, North Africa, and Asia. Pear wood is one of the preferred materials in the manufacture of high-quality woodwind instruments and furniture. About 3,000 known varieties of pears are grown worldwide, which vary in both shape and taste."}}, {"canonical_name": "limbs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "limbs", "book_id": "english_physician_1652", "name": "Limbs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Limbs"], "contexts": ["wounded"]}, {"entity_id": "limbs", "book_id": "origin_of_species_darwin_1859", "name": "limbs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["limbs"], "contexts": ["part homologous with jaws", "appendages for locomotion"]}, {"entity_id": "limbs", "book_id": "first_principles_spencer_1862", "name": "limbs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 8, "variants": ["limbs"], "contexts": ["appendages for movement", "arms and legs"]}, {"entity_id": "limb", "book_id": "first_principles_spencer_1862", "name": "limb", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["limb"], "contexts": ["appendage of the body"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Limbs", "target_book": "origin_of_species_darwin_1859", "target_name": "limbs", "similarity": 0.976}, {"source_book": "english_physician_1652", "source_name": "Limbs", "target_book": "first_principles_spencer_1862", "target_name": "limbs", "similarity": 0.976}, {"source_book": "english_physician_1652", "source_name": "Limbs", "target_book": "first_principles_spencer_1862", "target_name": "limb", "similarity": 0.916}, {"source_book": "origin_of_species_darwin_1859", "source_name": "limbs", "target_book": "first_principles_spencer_1862", "target_name": "limbs", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "limbs", "target_book": "first_principles_spencer_1862", "target_name": "limb", "similarity": 0.911}], "id": 1169, "stable_key": "clu_2fa55649d2e86778", "ground_truth": {"modern_name": "Ligaments", "confidence": "high", "type": "concept", "note": "'Ligamentos' refers to ligaments. 'Limbs' and 'Ligaments' in the English text confirm this anatomical reference.", "wikipedia_extract": "A ligament is a type of fibrous connective tissue in the body that connects bones to other bones. It also connects flight feathers to bones, in dinosaurs and birds. All 30,000 species of amniotes (land animals with internal bones) have ligaments. It is also known as articular ligament, articular larua, fibrous ligament, or true ligament. Ligaments are similar to tendons and fasciae as they are all made of connective tissue. The differences among them are in the connections that they make: ligaments connect one bone to another bone, tendons connect muscle to bone, and fasciae connect muscles to other muscles.", "wikipedia_url": "https://en.wikipedia.org/wiki/Ligament"}}, {"canonical_name": "crustaceans", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "crustaceans", "book_id": "origin_of_species_darwin_1859", "name": "crustaceans", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 8, "variants": ["Crustaceans", "crustaceans"], "contexts": ["animals with graduated eye structures", "extinct Silurian crustaceans that changed greatly"]}, {"entity_id": "crustaceans", "book_id": "kosmos_humboldt_1845", "name": "crustaceans", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Crustaceans", "crustaceans"], "contexts": ["arthropods with exoskeletons", "small aquatic arthropods in amber"]}, {"entity_id": "crustaceans", "book_id": "first_principles_spencer_1862", "name": "crustaceans", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["crustaceans"], "contexts": ["higher division of Annulosa with reduced segments", "arthropods with exoskeletons, like crabs"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "crustaceans", "target_book": "kosmos_humboldt_1845", "target_name": "crustaceans", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "crustaceans", "target_book": "first_principles_spencer_1862", "target_name": "crustaceans", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "crustaceans", "target_book": "first_principles_spencer_1862", "target_name": "crustaceans", "similarity": 1.0}], "id": 1170, "stable_key": "clu_fc17ae855f902eef", "ground_truth": {"modern_name": "Crustaceans", "confidence": "high", "type": "animal", "note": "The mention of 'cet\u00e1ceos' (cetaceans) in the context of Garcia de Orta's Colloquios is likely a misidentification or OCR error, as 'cet\u00e1ceos' refers to whales and dolphins, not crustaceans. The dominant theme points to crustaceans.", "wikidata_id": "Q25364", "wikidata_description": "subphylum of arthropods", "wikipedia_url": "https://en.wikipedia.org/wiki/Crustacean", "wikipedia_extract": "Crustaceans (from Latin word \"crustacea\" meaning: \"those with shells\" or \"crusted ones\") are invertebrate animals that constitute one group of arthropods that are traditionally a part of the subphylum Crustacea (), a large, diverse group of mainly aquatic arthropods including the more familiar decapods (shrimps, prawns, crabs, lobsters and crayfish), seed shrimps, branchiopods, fish lice, krill, remipedes, isopods, barnacles, copepods, opossum shrimps, amphipods and mantis shrimp. The crustacean group can be treated as a subphylum under the clade Mandibulata. It is now well accepted that the hexapods (insects and entognathans) emerged deep in the crustacean group, with the completed pan-group referred to as Pancrustacea. The three classes Cephalocarida, Branchiopoda and Remipedia are more closely related to the hexapods than they are to any of the other crustaceans (oligostracans and multicrustaceans). The 67,000 described species range in size from Stygotantulus stocki at 0.1 mm (0.004 in), to the Japanese spider crab with a leg span of up to 3.8 m (12.5 ft) and a mass of 20 kg (44 lb). Like other arthropods, crustaceans have an exoskeleton, which they moult to grow."}}, {"canonical_name": "tail", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "tail", "book_id": "origin_of_species_darwin_1859", "name": "tail", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 6, "variants": ["tail"], "contexts": ["posterior appendage for balance", "appendage for balance and display"]}, {"entity_id": "tail-feathers", "book_id": "origin_of_species_darwin_1859", "name": "tail-feathers", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["tail-feathers"], "contexts": ["feathers of a bird's tail"]}, {"entity_id": "tails", "book_id": "origin_of_species_darwin_1859", "name": "tails", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["tails"], "contexts": ["part of runt pigeon anatomy"]}, {"entity_id": "tail", "book_id": "kosmos_humboldt_1845", "name": "tail", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["tail"], "contexts": ["streamer extending from a comet"]}, {"entity_id": "tail", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tail", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["tail"], "contexts": ["streamer extending from a comet"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "tail", "target_book": "kosmos_humboldt_1845", "target_name": "tail", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "tail", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tail", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "tail-feathers", "target_book": "kosmos_humboldt_1845", "target_name": "tail", "similarity": 0.883}, {"source_book": "origin_of_species_darwin_1859", "source_name": "tail-feathers", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tail", "similarity": 0.883}, {"source_book": "origin_of_species_darwin_1859", "source_name": "tails", "target_book": "kosmos_humboldt_1845", "target_name": "tail", "similarity": 0.911}, {"source_book": "origin_of_species_darwin_1859", "source_name": "tails", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tail", "similarity": 0.911}, {"source_book": "kosmos_humboldt_1845", "source_name": "tail", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tail", "similarity": 1.0}], "id": 1171, "stable_key": "clu_706a84a2a1517965", "ground_truth": {"modern_name": "Tail", "confidence": "high", "type": "animal", "wikidata_id": "Q4764909", "wikidata_description": "US television program", "wikipedia_url": "https://en.wikipedia.org/wiki/Animal%20Tails", "wikipedia_extract": "Animal Tails is an American television variety show for teenage animal lovers. Hosted by comedian Mark Curry, the series highlights different features of the animal kingdom, from pets to more exotic animals. Reruns of this series currently air Saturday mornings on Bounce TV."}}, {"canonical_name": "chalk", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "chalk", "book_id": "origin_of_species_darwin_1859", "name": "chalk", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["chalk"], "contexts": ["sedimentary rock"]}, {"entity_id": "chalk", "book_id": "kosmos_humboldt_1845", "name": "chalk", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 8, "variants": ["chalk"], "contexts": ["sedimentary rock", "sedimentary rock type"]}, {"entity_id": "chalk_strta", "book_id": "kosmos_humboldt_1845", "name": "chalk strta", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["chalk strta"], "contexts": ["geological layer"]}, {"entity_id": "chalk", "book_id": "connexion_physical_sciences_somerville_1858", "name": "chalk", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["chalk"], "contexts": ["used for polishing the plate", "substance in water producing negative electricity"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "chalk", "target_book": "kosmos_humboldt_1845", "target_name": "chalk", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "chalk", "target_book": "kosmos_humboldt_1845", "target_name": "chalk strta", "similarity": 0.906}, {"source_book": "origin_of_species_darwin_1859", "source_name": "chalk", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chalk", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "chalk", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chalk", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "chalk strta", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chalk", "similarity": 0.906}], "id": 1172, "stable_key": "clu_6a6b78031df7539d", "ground_truth": {"modern_name": "Chalk", "confidence": "high", "type": "mineral"}}, {"canonical_name": "sudor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "sudor", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "sudor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["sudor"], "contexts": ["fluid provoked by the plant", "sweat, provoked by fevers"]}, {"entity_id": "sudor", "book_id": "historia_medicinal_monardes_1574", "name": "sudor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["sudor"], "contexts": ["sweat, bodily fluid", "bodily fluid"]}, {"entity_id": "sweat", "book_id": "polyanthea_medicinal", "name": "sweat", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["sweat"], "contexts": ["manner of blood expulsion"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "sudor", "target_book": "historia_medicinal_monardes_1574", "target_name": "sudor", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "sudor", "target_book": "polyanthea_medicinal", "target_name": "sweat", "similarity": 0.925}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "sudor", "target_book": "polyanthea_medicinal", "target_name": "sweat", "similarity": 0.925}], "id": 1173, "stable_key": "clu_e9f2c75d72197543", "ground_truth": {"modern_name": "Sudorific", "confidence": "high", "type": "concept", "description": "A substance or remedy that induces sweating.", "wikipedia_extract": "Perspiration, also known as sweat, is the fluid secreted by sweat glands in the skin of mammals. Two types of sweat glands can be found in humans: eccrine glands and apocrine glands. The eccrine sweat glands are distributed over much of the body and are responsible for secreting the watery, brackish sweat most often triggered by excessive body temperature. Apocrine sweat glands are restricted to the armpits and a few other areas of the body and produce an odorless, oily, opaque secretion which then gains its characteristic odor from bacterial decomposition. In humans, sweating is primarily a means of thermoregulation, which is achieved by the water-rich secretion of the eccrine glands. Maximum sweat rates of an adult can be up to 2\u20134 litres (0.5\u20131 US gal) per hour or 10\u201314 litres (2.5\u20133.5 US gal) per day, but is less in children prior to puberty."}}, {"canonical_name": "Hydropicos", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "hidropicos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "hidropicos", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["hidropicos"], "contexts": ["people who die of dropsy"]}, {"entity_id": "hydropicos", "book_id": "historia_medicinal_monardes_1574", "name": "Hydropicos", "category": "DISEASE", "subcategory": "CHRONIC", "count": 11, "variants": ["Hydropicos", "Hidropef\u00eda", "Hydropefia", "Hydrope\u00f1ia", "Hydrope\u017fia", "hidropetia", "hidropicos", "hydropico"], "contexts": ["related to dropsy", "dropsy patients"]}, {"entity_id": "hidropici", "book_id": "ricettario_fiorentino_1597", "name": "hidropici", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["hidropici"], "contexts": ["patients with dropsy"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "hidropicos", "target_book": "historia_medicinal_monardes_1574", "target_name": "Hydropicos", "similarity": 0.97}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "hidropicos", "target_book": "ricettario_fiorentino_1597", "target_name": "hidropici", "similarity": 0.902}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Hydropicos", "target_book": "ricettario_fiorentino_1597", "target_name": "hidropici", "similarity": 0.903}], "id": 1174, "stable_key": "clu_8b966aa2b557e44e", "ground_truth": {"modern_name": "Dropsy", "confidence": "high", "type": "disease", "description": "A condition characterized by abnormal accumulation of fluid in body tissues.", "note": "Includes variations like Hydrope\u017fia, Hydropick diseases, Hydropicos, hydrop\u00ed, hydroforbia, and hidropici.", "wikipedia_extract": "Edema (American English), also spelled oedema (Commonwealth English), and also known as fluid retention, swelling, dropsy and hydropsy, is the build-up of fluid in the body's tissue. Most commonly, the legs or arms are affected. Symptoms may include skin that feels tight, the area feeling heavy, and joint stiffness. Other symptoms depend on the underlying cause. Causes may include venous insufficiency, heart failure, kidney problems, low protein levels, liver problems, deep vein thrombosis, infections, kwashiorkor, angioedema, certain medications, and lymphedema. It may also occur in immobile patients (stroke, spinal cord injury, aging), or with temporary immobility such as prolonged sitting or standing, and during menstruation or pregnancy."}}, {"canonical_name": "pato", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "pato", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "pato", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["pato"], "contexts": ["bird foot comparison"]}, {"entity_id": "pato", "book_id": "historia_medicinal_monardes_1574", "name": "pato", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["pato", "patonrino"], "contexts": ["duck used for cauterization", "young duck used for cauterization"]}, {"entity_id": "pato", "book_id": "polyanthea_medicinal", "name": "pato", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 10, "variants": ["pato", "Pato", "Pavao", "Pavo"], "contexts": ["used to treat horse's belly pain", "animal used in a remedy"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "pato", "target_book": "historia_medicinal_monardes_1574", "target_name": "pato", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "pato", "target_book": "polyanthea_medicinal", "target_name": "pato", "similarity": 0.827}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "pato", "target_book": "polyanthea_medicinal", "target_name": "pato", "similarity": 0.827}], "id": 1175, "stable_key": "clu_18920e31473e286f", "ground_truth": {"modern_name": "duck", "confidence": "high", "type": "animal"}}, {"canonical_name": "effort", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "effort", "book_id": "principles_of_psychology_james_1890", "name": "effort", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["effort"], "contexts": ["exertion of mental or physical energy", "exertion of physical or mental energy"]}, {"entity_id": "esfor\u00e7o", "book_id": "polyanthea_medicinal", "name": "esfor\u00e7o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["esfor\u00e7o"], "contexts": ["effort"]}, {"entity_id": "effort", "book_id": "first_principles_spencer_1862", "name": "effort", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["effort"], "contexts": ["physical or mental exertion", "exertion of mental energy"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "effort", "target_book": "polyanthea_medicinal", "target_name": "esfor\u00e7o", "similarity": 0.959}, {"source_book": "principles_of_psychology_james_1890", "source_name": "effort", "target_book": "first_principles_spencer_1862", "target_name": "effort", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "esfor\u00e7o", "target_book": "first_principles_spencer_1862", "target_name": "effort", "similarity": 0.959}], "id": 1176, "stable_key": "clu_ec81724f10ab206d", "ground_truth": {"modern_name": "effort", "confidence": "high", "type": "concept", "wikidata_id": "Q510236", "wikidata_description": "psychopathological term to denote a condition with symptoms of fatigue, anxiety, headache, heart palpitations, high blood pressure, neuralgia, and depressed mood", "wikipedia_url": "https://en.wikipedia.org/wiki/Neurasthenia", "wikipedia_extract": "Neurasthenia (from Ancient Greek  \u03bd\u03b5\u1fe6\u03c1\u03bf\u03bd (neuron) 'nerve' and \u1f00\u03c3\u03b8\u03b5\u03bd\u03ae\u03c2 (asthen\u00e9s) 'weak') is a term that was first used as early as 1829 for a mechanical weakness of the nerves. It became a major diagnosis in North America during the late nineteenth and early twentieth centuries after neurologist George Miller Beard reintroduced the concept in 1869. As a psychopathological term, the first to publish on neurasthenia was Michigan alienist E. H. Van Deusen of the Kalamazoo asylum in 1869. Also in 1868, New York neurologist George Beard used the term in an article published in the Boston Medical and Surgical Journal to denote a condition with symptoms of fatigue, anxiety, headache, heart palpitations, high blood pressure, neuralgia, and depressed mood."}}, {"canonical_name": "intensity", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "intensity", "book_id": "principles_of_psychology_james_1890", "name": "intensity", "category": "CONCEPT", "subcategory": "QUALITY", "count": 6, "variants": ["intensity"], "contexts": ["strength of a sensation", "formal element of experience"]}, {"entity_id": "intensity", "book_id": "kosmos_humboldt_1845", "name": "intensity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["intensity"], "contexts": ["strength of magnetic force", "magnetic field property"]}, {"entity_id": "intensity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "intensity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["intensity", "Intensity"], "contexts": ["magnitude of sound", "loudness of a sound"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "intensity", "target_book": "kosmos_humboldt_1845", "target_name": "intensity", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "intensity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "intensity", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "intensity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "intensity", "similarity": 1.0}], "id": 1177, "stable_key": "clu_5c48ff711904eab5", "ground_truth": {"modern_name": "intensity", "confidence": "high", "type": "concept", "wikidata_id": "Q1061524", "wikidata_description": "power transferred per unit area, where the area is measured on the plane perpendicular to the direction of propagation of the energy", "note": "The contexts clearly point to the general concept of intensity or degree of strength."}}, {"canonical_name": "cholera", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "cholera", "book_id": "principles_of_psychology_james_1890", "name": "cholera", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["cholera"], "contexts": ["infectious disease causing severe diarrhea"]}, {"entity_id": "cholera", "book_id": "coloquios_da_orta_1563", "name": "cholera", "category": "DISEASE", "subcategory": "ACUTE", "count": 11, "variants": ["cholera"], "contexts": ["disease described by Garcia da Orta", "suspected illness"]}, {"entity_id": "cholera_adu\u017fta", "book_id": "polyanthea_medicinal", "name": "cholera adu\u017fta", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["cholera adu\u017fta"], "contexts": ["burnt cholera"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "cholera", "target_book": "coloquios_da_orta_1563", "target_name": "cholera", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "cholera", "target_book": "polyanthea_medicinal", "target_name": "cholera adu\u017fta", "similarity": 0.888}, {"source_book": "coloquios_da_orta_1563", "source_name": "cholera", "target_book": "polyanthea_medicinal", "target_name": "cholera adu\u017fta", "similarity": 0.888}], "id": 1178, "stable_key": "clu_9413c19bb0b5cc69", "ground_truth": {"modern_name": "Cholera", "confidence": "high", "type": "disease", "description": "Severe infectious disease causing diarrhea and dehydration.", "wikipedia_extract": "Cholera () is an infection of the small intestine by some strains of the bacterium Vibrio cholerae. Symptoms may range from none, to mild, to severe. The classic symptom is large amounts of watery diarrhea lasting a few days. Vomiting and muscle cramps may also occur. Diarrhea can be so severe that it leads within hours to severe dehydration and electrolyte imbalance. This can in turn result in sunken eyes, cold or cyanotic skin, decreased skin elasticity, wrinkling of the hands and feet, and, in severe cases, death."}}, {"canonical_name": "Inglaterra", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "inglaterra", "book_id": "historia_medicinal_monardes_1574", "name": "Inglaterra", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Inglaterra"], "contexts": ["country of King Edward"]}, {"entity_id": "inglaterra", "book_id": "coloquios_da_orta_1563", "name": "Inglaterra", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Inglaterra", "Ingla*terra"], "contexts": ["country where price is cited", "in England around the year 1350"]}, {"entity_id": "inglaterra", "book_id": "polyanthea_medicinal", "name": "Inglaterra", "category": "PLACE", "subcategory": "COUNTRY", "count": 8, "variants": ["Inglaterra"], "contexts": ["England", "country of origin for water"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Inglaterra", "target_book": "coloquios_da_orta_1563", "target_name": "Inglaterra", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Inglaterra", "target_book": "polyanthea_medicinal", "target_name": "Inglaterra", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Inglaterra", "target_book": "polyanthea_medicinal", "target_name": "Inglaterra", "similarity": 1.0}], "id": 1179, "stable_key": "clu_7740eb6cd24ff21e-2", "ground_truth": {"modern_name": "England", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q21", "wikidata_description": "country in north-west Europe, part of the United Kingdom", "wikipedia_url": "https://en.wikipedia.org/wiki/England", "wikipedia_extract": "England is a country that is part of the United Kingdom. It is located on the island of Great Britain, of which it covers about 62%, and more than 100 smaller adjacent islands. England shares a land border with Scotland to the north and another land border with Wales to the west, and is otherwise surrounded by the North Sea to the east, the English Channel to the south, the Celtic Sea to the south-west, and the Irish Sea to the west. Continental Europe lies to the south-east, and Ireland to the west. At the 2021 census, the population was 56,490,048. London is both the largest city and the capital."}}, {"canonical_name": "Papauero", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "papaver", "book_id": "coloquios_da_orta_1563", "name": "Papaver", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Papaver"], "contexts": ["genus of opium poppy", "plant cultivated for opium"]}, {"entity_id": "papauero", "book_id": "ricettario_fiorentino_1597", "name": "Papauero", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["Papauero", "Papaueri", "Papaueri fieri", "papauero", "papautri", "paueri"], "contexts": ["flower head similar to poppy", "poppy plant"]}, {"entity_id": "papavera", "book_id": "polyanthea_medicinal", "name": "papavera", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["papavera", "Papaveris"], "contexts": ["sleep-inducing plant, poppy", "succus for urine without offense"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Papaver", "target_book": "ricettario_fiorentino_1597", "target_name": "Papauero", "similarity": 0.9}, {"source_book": "coloquios_da_orta_1563", "source_name": "Papaver", "target_book": "polyanthea_medicinal", "target_name": "papavera", "similarity": 0.947}], "id": 1180, "stable_key": "clu_e3c5b4c04bbf88a5-2", "ground_truth": {"modern_name": "Poppy", "confidence": "high", "type": "plant", "linnaean": "Papaver somniferum Linnaeus", "family": "Papaveraceae", "wikidata_id": "Q967457", "wikidata_description": "common name for various plant species of the family Papaveraceae", "wikipedia_url": "https://en.wikipedia.org/wiki/Poppy", "wikipedia_extract": "A poppy is a flowering plant in the subfamily Papaveroideae of the family Papaveraceae. Poppies are herbaceous plants, often grown for their colourful flowers. One species of poppy, Papaver somniferum, is the source of the narcotic drug mixture opium, which contains powerful medicinal alkaloids such as morphine and has been used since ancient times as an analgesic and narcotic medicinal and recreational drug. It also produces edible seeds. Following the trench warfare in the poppy fields of Flanders, Belgium, during World War I, poppies, specifically the red poppy, have become a symbol of remembrance of soldiers who have died during wartime, especially in the UK, Canada, Australia, Africa and other Commonwealth realms. Poppies are herbaceous annual, biennial or short-lived perennial plants.", "description": "A flowering plant, source of opium and other medicinal compounds.", "note": "Likely refers to species of Papaver, particularly Papaver somniferum."}}, {"canonical_name": "telescope", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "magnetic_telescope", "book_id": "kosmos_humboldt_1845", "name": "magnetic telescope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["magnetic telescope"], "contexts": ["instrument for magnetic measurements"]}, {"entity_id": "telescope", "book_id": "connexion_physical_sciences_somerville_1858", "name": "telescope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 10, "variants": ["telescope"], "contexts": ["instrument for astronomical observation", "instrument for viewing distant objects"]}, {"entity_id": "telescope", "book_id": "origin_of_species_darwin_1859", "name": "telescope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["telescope"], "contexts": ["optical instrument for viewing distant objects"]}, {"entity_id": "telescope", "book_id": "kosmos_humboldt_1845", "name": "telescope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["telescope"], "contexts": ["instrument for viewing distant objects"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "magnetic telescope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "telescope", "similarity": 0.907}, {"source_book": "origin_of_species_darwin_1859", "source_name": "telescope", "target_book": "kosmos_humboldt_1845", "target_name": "telescope", "similarity": 1.0}], "id": 1181, "stable_key": "clu_b1ec5296f66df11b", "ground_truth": {"modern_name": "Telescope", "confidence": "high", "type": "object", "wikidata_id": "Q4213", "wikidata_description": "instrument that aids in the observation of remote objects", "wikipedia_url": "https://en.wikipedia.org/wiki/Telescope", "wikipedia_extract": "A telescope is a device used to observe distant objects by their emission, absorption, or reflection of electromagnetic radiation. Originally, it was an optical instrument using lenses, curved mirrors, or a combination of both to observe distant objects \u2013 an optical telescope. Nowadays, the word \"telescope\" is defined as a wide range of instruments capable of detecting different regions of the electromagnetic spectrum, and in some cases other types of detectors. The first known practical telescopes were refracting telescopes with glass lenses and were invented in the Netherlands at the beginning of the 17th century. They were used for both terrestrial applications and astronomy. The reflecting telescope, which uses mirrors to collect and focus light, was invented within a few decades of the first refracting telescope."}}, {"canonical_name": "physiciens", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "physiciens", "book_id": "medecine_experimentale_bernard_1865", "name": "physiciens", "category": "PERSON", "subcategory": "SCHOLAR", "count": 8, "variants": ["physiciens"], "contexts": ["scientists studying physics", "practitioners of physics"]}, {"entity_id": "les_physiciens", "book_id": "medecine_experimentale_bernard_1865", "name": "les physiciens", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["les physiciens"], "contexts": ["scientists who use induction"]}, {"entity_id": "physiciens", "book_id": "epoques_nature_buffon_1778", "name": "physiciens", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["physiciens"], "contexts": ["scientists studying natural philosophy", "scholars studying physical phenomena"]}, {"entity_id": "physiciens_modernes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "physiciens modernes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["physiciens modernes"], "contexts": ["modern scientists"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "physiciens", "target_book": "epoques_nature_buffon_1778", "target_name": "physiciens", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "physiciens", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "physiciens modernes", "similarity": 0.884}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "les physiciens", "target_book": "epoques_nature_buffon_1778", "target_name": "physiciens", "similarity": 0.961}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "les physiciens", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "physiciens modernes", "similarity": 0.877}, {"source_book": "epoques_nature_buffon