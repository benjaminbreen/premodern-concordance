 "vertue", "target_book": "english_physician_1652", "target_name": "Vertue", "similarity": 0.971}], "id": 2914, "stable_key": "clu_393e8cb6beffe1a1-2", "ground_truth": {"modern_name": "Virtue", "confidence": "high", "type": "concept", "note": "The spelling 'vertue' is an archaic form of 'virtue'.", "wikidata_id": "Q1179705", "wikidata_description": "concept in Chinese philosophy"}}, {"canonical_name": "Devil", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "devil", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Devil", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 5, "variants": ["Devil"], "contexts": ["made a false assertion to Eve", "tempter of Christ"]}, {"entity_id": "devil", "book_id": "english_physician_1652", "name": "Devil", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["Devil", "Devils", "Divil"], "contexts": ["evil agent", "said to have bitten the root of Devils-bit"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Devil", "target_book": "english_physician_1652", "target_name": "Devil", "similarity": 1.0}], "id": 2915, "stable_key": "clu_e3b2bceffbf7104e-2", "ground_truth": {"modern_name": "Devil", "confidence": "high", "type": "concept", "note": "This refers to the theological or mythological concept of the Devil, not a specific historical person.", "wikidata_id": "Q6674", "wikidata_description": "genus of flowering plants in the buttercup family Ranunculaceae"}}, {"canonical_name": "memories", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "memories", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Memories", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Memories"], "contexts": ["faculty of retaining information", "faculty of retaining past experiences"]}, {"entity_id": "memories", "book_id": "principles_of_psychology_james_1890", "name": "memories", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["memories"], "contexts": ["recollection of past experiences", "stored information from past experiences"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Memories", "target_book": "principles_of_psychology_james_1890", "target_name": "memories", "similarity": 0.978}], "id": 2916, "stable_key": "clu_cf67b7333f0fc9b6-2", "ground_truth": {"modern_name": "Memory", "confidence": "high", "type": "concept", "wikidata_id": "Q492", "wikidata_description": "mental faculties and processes involved in storing and retrieving information", "wikipedia_url": "https://en.wikipedia.org/wiki/Memory", "wikipedia_extract": "Memory is the faculty of the mind by which data or information is encoded, stored, and retrieved when needed. It is the retention of information over time for the purpose of influencing future action. If past events could not be remembered, it would be impossible for language, relationships, or personal identity to develop. Memory loss is usually described as forgetfulness or amnesia. Memory is often understood as an informational processing system with explicit and implicit functioning that is made up of a sensory processor, short-term (or working) memory, and long-term memory. This can be related to the neuron."}}, {"canonical_name": "Horizon", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "horizon", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Horizon", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Horizon"], "contexts": ["horizontal plane of observation", "line separating sky and earth"]}, {"entity_id": "horizon", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Horizon", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 7, "variants": ["Horizon", "horizon"], "contexts": ["apparent line separating sky and earth", "line where sky meets earth"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Horizon", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Horizon", "similarity": 1.0}], "id": 2917, "stable_key": "clu_c81406b4b0114b98", "ground_truth": {"modern_name": "horizon", "confidence": "high", "type": "concept", "note": "Ambiguous between a perceptual concept and a scientific term.", "wikidata_id": "Q72803426", "wikidata_description": "a type of astronomical object"}}, {"canonical_name": "Crolius", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "crollius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Crollius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Crollius"], "contexts": ["affirmed antipathy between Sal Armoniac and Tartar", "author of phytognomy"]}, {"entity_id": "crolius", "book_id": "polyanthea_medicinal", "name": "Crolius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["Crolius", "Crol"], "contexts": ["cited authority in the preface", "scholar cited for his observations"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Crollius", "target_book": "polyanthea_medicinal", "target_name": "Crolius", "similarity": 0.88}], "id": 2918, "stable_key": "clu_bb368a9eadaa15b6", "ground_truth": {"modern_name": "Oswald Croll", "confidence": "high", "type": "person", "birth_year": 1563, "death_year": 1609, "description": "Chemist and astrologer, author of 'Basilica Chymica'.", "wikidata_id": "Q100432348", "wikidata_description": "street in Bernburg (Saale), Saxony-Anhalt, Germany"}}, {"canonical_name": "duck", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "ducks", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ducks", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["Ducks"], "contexts": ["birds whose eggs hatch under a hen", "birds used in incubation experiments"]}, {"entity_id": "duck", "book_id": "origin_of_species_darwin_1859", "name": "duck", "category": "ANIMAL", "subcategory": "BIRD", "count": 4, "variants": ["duck"], "contexts": ["domestic vs wild bones comparison", "bird carrying aquatic plants and shells"]}, {"entity_id": "ducks", "book_id": "origin_of_species_darwin_1859", "name": "ducks", "category": "ANIMAL", "subcategory": "BIRD", "count": 3, "variants": ["ducks"], "contexts": ["domesticated bird", "domesticated birds with differing breeds"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ducks", "target_book": "origin_of_species_darwin_1859", "target_name": "duck", "similarity": 0.94}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ducks", "target_book": "origin_of_species_darwin_1859", "target_name": "ducks", "similarity": 0.991}], "id": 2919, "stable_key": "clu_3f64bb439ed281b3", "ground_truth": {"modern_name": "duck", "confidence": "high", "type": "animal", "description": "A waterfowl used in remedies and for cauterization.", "wikipedia_extract": "Duck is the common name for numerous species of waterfowl in the family Anatidae. Ducks are generally smaller and shorter-necked than swans and geese, which are members of the same family. Divided among several subfamilies, they are a form taxon; they do not represent a monophyletic group (the group of all descendants of a single common ancestral species), since swans and geese are not considered ducks. Ducks are mostly aquatic birds, and may be found in both fresh water and sea water. Ducks are sometimes confused with several types of unrelated water birds with similar forms, such as loons or divers, grebes, gallinules and coots. The word duck comes from Old English d\u016bce 'diver', a derivative of the verb *d\u016bcan 'to duck, bend down low as if to get under something, or dive', because of the way many species in the dabbling duck group feed by upending; compare with Dutch duiken and German tauchen 'to dive'."}}, {"canonical_name": "Figs", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "figs", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "figs", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["figs"], "contexts": ["ingredient in plaister"]}, {"entity_id": "figs", "book_id": "english_physician_1652", "name": "Figs", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["Figs", "Figgs"], "contexts": ["dried fruit used in poultices", "fruit used for medicinal purposes"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "figs", "target_book": "english_physician_1652", "target_name": "Figs", "similarity": 0.895}], "id": 2920, "stable_key": "clu_d21cee2270ab836e", "ground_truth": {"modern_name": "Fig", "confidence": "high", "type": "plant", "linnaean": "Ficus carica L.", "family": "Moraceae", "wikidata_id": "Q59798", "wikidata_description": "genus of plants in the family Moraceae"}}, {"canonical_name": "balneis", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "balneo", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Balneo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Balneo"], "contexts": ["a stage of suffering"]}, {"entity_id": "balneations", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "balneations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["balneations"], "contexts": ["relieve the head"]}, {"entity_id": "balneis", "book_id": "polyanthea_medicinal", "name": "balneis", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 7, "variants": ["balneis", "Balnea", "Balneum", "balneo"], "contexts": ["therapeutic baths", "type of bath"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Balneo", "target_book": "polyanthea_medicinal", "target_name": "balneis", "similarity": 0.915}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "balneations", "target_book": "polyanthea_medicinal", "target_name": "balneis", "similarity": 0.884}], "id": 2921, "stable_key": "clu_e550ba0b6c0255c8-2", "ground_truth": {"modern_name": "Baths", "confidence": "high", "type": "concept", "description": "Therapeutic practice involving immersion in water or herbal preparations.", "wikipedia_extract": "Balneotherapy (Latin: balneum \"bath\") is a pseudoscientific method of treating diseases by bathing, a traditional medicine technique usually practiced at spas. Since ancient times, humans have used hot springs, public baths and thermal medicine for therapeutic effects. While it is considered distinct from hydrotherapy, there are some overlaps in practice and in underlying principles. Balneotherapy may involve hot or cold water, massage through moving water, relaxation, or stimulation. Many mineral waters at spas are rich in particular minerals such as silica, sulfur, selenium, and radium. Medicinal clays are also widely used, a practice known as 'fangotherapy'. \"Balneotherapy\" is the practice of immersing a subject in mineral water or mineral-laden mud; it is part of the traditional medicine of many cultures and originated in hot springs, cold water springs, or other sources of such water, like the Dead Sea.", "wikidata_id": "Q70816289", "wikidata_description": "scientific article published on 01 March 1970"}}, {"canonical_name": "Beer", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "beer", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Beer", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Beer"], "contexts": ["drink spoiled by lightning"]}, {"entity_id": "beer", "book_id": "english_physician_1652", "name": "Beer", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 8, "variants": ["Beer"], "contexts": ["liquid used to boil herbs", "alcoholic beverage"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Beer", "target_book": "english_physician_1652", "target_name": "Beer", "similarity": 0.831}], "id": 2922, "stable_key": "clu_954b36594d04bd7a", "ground_truth": {"modern_name": "Beer", "confidence": "high", "type": "object", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "M\u00e9diterran\u00e9e", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "m\u00e9diterran\u00e9e", "book_id": "epoques_nature_buffon_1778", "name": "M\u00e9diterran\u00e9e", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["M\u00e9diterran\u00e9e"], "contexts": ["sea between Europe and Africa", "sea connecting Europe, Africa, and Asia"]}, {"entity_id": "m\u00e9di-terran\u00e9e", "book_id": "relation_historique_humboldt_vol3_1825", "name": "M\u00e9di-terran\u00e9e", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["M\u00e9di-terran\u00e9e"], "contexts": ["sea"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "M\u00e9diterran\u00e9e", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "M\u00e9di-terran\u00e9e", "similarity": 0.973}], "id": 2923, "stable_key": "clu_6b9237d5b41d34c0", "ground_truth": {"modern_name": "Mediterranean Sea", "confidence": "high", "type": "place", "country": "International", "wikidata_id": "Q72499", "wikidata_description": "loosely defined region of lands around the Mediterranean Sea", "wikipedia_url": "https://en.wikipedia.org/wiki/Mediterranean%20basin"}}, {"canonical_name": "p\u00f4le austral", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "p\u00f4le_austral", "book_id": "epoques_nature_buffon_1778", "name": "p\u00f4le austral", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["p\u00f4le austral"], "contexts": ["southern pole", "South Pole"]}, {"entity_id": "h\u00e9misph\u00e8re_austral", "book_id": "relation_historique_humboldt_vol3_1825", "name": "h\u00e9misph\u00e8re austral", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["h\u00e9misph\u00e8re austral"], "contexts": ["southern half of the globe", "region of Simonoif's observations"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "p\u00f4le austral", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "h\u00e9misph\u00e8re austral", "similarity": 0.908}], "id": 2924, "stable_key": "clu_ca969d1330b21070", "ground_truth": {"modern_name": "South Pole", "confidence": "high", "type": "place", "country": "Antarctica", "note": "While 'p\u00f4le austral' can refer to the entire southern hemisphere, in the context of natural philosophy and exploration, it often implies the geographic South Pole region.", "wikidata_id": "Q933", "wikidata_description": "one of the two points where the Earth's axis of rotation intersects its surface", "wikipedia_url": "https://en.wikipedia.org/wiki/South%20Pole"}}, {"canonical_name": "vent", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "vents", "book_id": "epoques_nature_buffon_1778", "name": "vents", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["vents"], "contexts": ["abstract ideas, theories, mental faculties, and processes", "winds"]}, {"entity_id": "vent", "book_id": "relation_historique_humboldt_vol3_1825", "name": "vent", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["vent", "vents", "vents alises"], "contex