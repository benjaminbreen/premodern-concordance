ts": ["molecular motion"], "contexts": ["motion among the units of sensible masses", "movement of particles within matter"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "mouvement mol\u00e9culaire", "target_book": "principles_of_psychology_james_1890", "target_name": "molecular motion", "similarity": 0.902}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mouvement mol\u00e9culaire", "target_book": "kosmos_humboldt_1845", "target_name": "molecular motion", "similarity": 0.902}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mouvement mol\u00e9culaire", "target_book": "first_principles_spencer_1862", "target_name": "molecular motion", "similarity": 0.902}, {"source_book": "principles_of_psychology_james_1890", "source_name": "molecular motion", "target_book": "kosmos_humboldt_1845", "target_name": "molecular motion", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "molecular motion", "target_book": "first_principles_spencer_1862", "target_name": "molecular motion", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "molecular motion", "target_book": "first_principles_spencer_1862", "target_name": "molecular motion", "similarity": 1.0}], "id": 589, "stable_key": "clu_a78969b52782107c", "ground_truth": {"modern_name": "Molecular motion", "confidence": "high", "type": "concept"}}, {"canonical_name": "Icebergs", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 4, "total_mentions": 13, "members": [{"entity_id": "glaciers", "book_id": "origin_of_species_darwin_1859", "name": "glaciers", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["glaciers"], "contexts": ["ice formations leaving marks", "large masses of ice"]}, {"entity_id": "icebergs", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Icebergs", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["icebergs", "Icebergs"], "contexts": ["large pieces of floating ice", "drifting masses of ice"]}, {"entity_id": "glaciers", "book_id": "first_principles_spencer_1862", "name": "glaciers", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["glaciers"], "contexts": ["large masses of ice", "large, persistent body of ice"]}, {"entity_id": "icebergs", "book_id": "origin_of_species_darwin_1859", "name": "Icebergs", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["icebergs", "Icebergs"], "contexts": ["transport rocky burthens to islands", "transported boulders to shores"]}, {"entity_id": "igneous_mountains", "book_id": "kosmos_humboldt_1845", "name": "igneous mountains", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["igneous mountains"], "contexts": ["volcanic formations"]}, {"entity_id": "icebergs", "book_id": "first_principles_spencer_1862", "name": "icebergs", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["icebergs"], "contexts": ["large floating masses of ice"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "glaciers", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Icebergs", "similarity": 0.943}, {"source_book": "origin_of_species_darwin_1859", "source_name": "glaciers", "target_book": "first_principles_spencer_1862", "target_name": "glaciers", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Icebergs", "target_book": "first_principles_spencer_1862", "target_name": "glaciers", "similarity": 0.943}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Icebergs", "target_book": "kosmos_humboldt_1845", "target_name": "igneous mountains", "similarity": 0.893}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Icebergs", "target_book": "first_principles_spencer_1862", "target_name": "icebergs", "similarity": 0.985}, {"source_book": "kosmos_humboldt_1845", "source_name": "igneous mountains", "target_book": "first_principles_spencer_1862", "target_name": "icebergs", "similarity": 0.891}], "id": 590, "stable_key": "clu_75d40a20ccc40f2f", "ground_truth": {"modern_name": "Icebergs", "confidence": "high", "type": "object", "note": "Includes related concepts like glaciers and 'igneous mountains' which in context refer to large, naturally formed structures of ice or earth, often discussed in geological or geographical terms.", "wikidata_id": "Q47568", "wikidata_description": "large piece of fresh-water ice floating in the ocean or other body of water", "wikipedia_url": "https://en.wikipedia.org/wiki/Iceberg", "wikipedia_extract": "An iceberg is a piece of fresh water ice more than 15 meters (16 yards) long that has broken off a glacier or an ice shelf and is floating freely in open water. Smaller chunks of floating glacially derived ice are called \"growlers\" or \"bergy bits\". Much of an iceberg is below the water's surface, which led to the expression \"tip of the iceberg\" to illustrate a small part of a larger unseen issue. Icebergs are considered a serious maritime hazard. Icebergs vary considerably in size and shape. Icebergs that calve from glaciers in Greenland are often irregularly shaped while Antarctic ice shelves often produce large tabular (table top) icebergs."}}, {"canonical_name": "elevation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 13, "members": [{"entity_id": "elevation", "book_id": "kosmos_humboldt_1845", "name": "elevation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["elevation"], "contexts": ["decrease of temperature", "height above sea level"]}, {"entity_id": "land_elevation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "land elevation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["land elevation"], "contexts": ["raising of the ground surface"]}, {"entity_id": "elevation", "book_id": "origin_of_species_darwin_1859", "name": "elevation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["elevation"], "contexts": ["rising of the Earth's crust"]}, {"entity_id": "elevations", "book_id": "kosmos_humboldt_1845", "name": "Elevations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Elevations"], "contexts": ["heights above sea level"]}, {"entity_id": "elevation", "book_id": "first_principles_spencer_1862", "name": "elevation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["elevation"], "contexts": ["process of being raised"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "elevation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "land elevation", "similarity": 0.898}, {"source_book": "origin_of_species_darwin_1859", "source_name": "elevation", "target_book": "kosmos_humboldt_1845", "target_name": "Elevations", "similarity": 0.879}, {"source_book": "origin_of_species_darwin_1859", "source_name": "elevation", "target_book": "first_principles_spencer_1862", "target_name": "elevation", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Elevations", "target_book": "first_principles_spencer_1862", "target_name": "elevation", "similarity": 0.879}], "id": 591, "stable_key": "clu_a3c7c88a227b7a92", "ground_truth": {"modern_name": "Elevation", "confidence": "high", "type": "concept", "note": "The contexts provided (rising of Earth's crust, heights above sea level) clearly point to the geographical and geological concept of elevation.", "wikidata_id": "Q787025", "wikidata_description": "anatomical movement in an superior direction"}}, {"canonical_name": "intellect", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 12, "members": [{"entity_id": "intellect", "book_id": "pseudodoxia_epidemica_browne_16