ory": "OTHER_OBJECT", "count": 2, "variants": ["bell-stroke"], "contexts": ["auditory stimulus in experiment", "auditory stimulus for experiment"]}, {"entity_id": "bell", "book_id": "principles_of_psychology_james_1890", "name": "bell", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["bell"], "contexts": ["auditory signaling device"]}, {"entity_id": "bells", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bells", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Bells"], "contexts": ["hollow objects that ring", "hollow objects that produce sound when struck"]}, {"entity_id": "bell", "book_id": "connexion_physical_sciences_somerville_1858", "name": "bell", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["bell"], "contexts": ["object producing sound when struck"]}, {"entity_id": "bells", "book_id": "first_principles_spencer_1862", "name": "bells", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["bells"], "contexts": ["objects producing sound when struck"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "bell-stroke", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "bell", "similarity": 0.934}, {"source_book": "principles_of_psychology_james_1890", "source_name": "bell-stroke", "target_book": "first_principles_spencer_1862", "target_name": "bells", "similarity": 0.884}, {"source_book": "principles_of_psychology_james_1890", "source_name": "bell", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bells", "similarity": 0.883}, {"source_book": "principles_of_psychology_james_1890", "source_name": "bell", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "bell", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "bell", "target_book": "first_principles_spencer_1862", "target_name": "bells", "similarity": 0.933}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Bells", "target_book": "first_principles_spencer_1862", "target_name": "bells", "similarity": 0.949}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "bell", "target_book": "first_principles_spencer_1862", "target_name": "bells", "similarity": 0.933}], "id": 1547, "stable_key": "clu_94fdb0a3128aae8b", "ground_truth": {"modern_name": "bell", "confidence": "high", "type": "object", "note": "The term 'bell-stroke' refers to the sound produced by a bell or the act of ringing it, but the core object is the bell itself.", "wikidata_id": "Q26158", "wikidata_description": "Flowering plant in the daisy family Asteraceae", "wikipedia_url": "https://en.wikipedia.org/wiki/Bellis%20perennis", "wikipedia_extract": "Bellis perennis ( BEL-iss p\u0259-REN-iss), the daisy, is a European species of the family Asteraceae, often considered the archetypal species of the name daisy. To distinguish this species from other plants known as daisies, it is sometimes qualified or known as common daisy, lawn daisy or English daisy. Bellis perennis is a perennial herbaceous plant growing to 20 centimetres (8 inches) in height. It has short creeping rhizomes and rosettes of small rounded or spoon-shaped leaves that are from 2 to 5 cm (3\u20444\u20132 in) long and grow flat to the ground. The species habitually colonises lawns and is difficult to eradicate by mowing, hence the term 'lawn daisy'. The plant blooms from March to September and exhibits the phenomenon of heliotropism, in which the flowers follow the position of the sun in the sky."}}, {"canonical_name": "tuning-fork", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "tuning-fork", "book_id": "principles_of_psychology_james_1890", "name": "tuning-fork", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["tuning-fork"], "contexts": ["component of reaction timer"]}, {"entity_id": "tuning-forks", "book_id": "principles_of_psychology_james_1890", "name": "tuning-forks", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["tuning-forks"], "contexts": ["instrument for producing simple tones"]}, {"entity_id": "tuning-fork", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tuning-fork", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 4, "variants": ["tuning-fork"], "contexts": ["instrument for producing musical notes", "instrument producing specific musical notes"]}, {"entity_id": "tuning-fork", "book_id": "first_principles_spencer_1862", "name": "tuning-fork", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["tuning-fork"], "contexts": ["instrument producing musical tones"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "tuning-fork", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tuning-fork", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tuning-fork", "target_book": "first_principles_spencer_1862", "target_name": "tuning-fork", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tuning-forks", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tuning-fork", "similarity": 0.975}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tuning-forks", "target_book": "first_principles_spencer_1862", "target_name": "tuning-fork", "similarity": 0.975}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "tuning-fork", "target_book": "first_principles_spencer_1862", "target_name": "tuning-fork", "similarity": 1.0}], "id": 1548, "stable_key": "clu_c9992595923a609e", "ground_truth": {"modern_name": "tuning fork", "confidence": "high", "type": "object", "wikidata_id": "Q201898", "wikidata_description": "device used to produce a fixed tone", "wikipedia_url": "https://en.wikipedia.org/wiki/Tuning%20fork", "wikipedia_extract": "A tuning fork is an acoustic resonator in the form of a two-pronged fork with the prongs (tines) formed from a U-shaped bar of elastic metal (usually steel). It resonates at a specific constant pitch when set vibrating by striking it against a surface or with an object, and emits a pure musical tone once the high overtones fade out. A tuning fork's pitch depends on the length and mass of the two prongs. They are traditional sources of standard pitch for tuning musical instruments. The tuning fork was invented in 1711 by British musician John Shore, sergeant trumpeter and lutenist to the royal court. A tuning fork is a fork-shaped acoustic resonator used in many applications to produce a fixed tone."}}, {"canonical_name": "ar ambiente", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "environment", "book_id": "principles_of_psychology_james_1890", "name": "environment", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["environment"], "contexts": ["surroundings of the organism"]}, {"entity_id": "ar_ambiente", "book_id": "polyanthea_medicinal", "name": "ar ambiente", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["ar ambiente"], "contexts": ["ambient air", "ambient air as a cause"]}, {"entity_id": "environment", "book_id": "first_principles_spencer_1862", "name": "environment", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["environment"], "contexts": ["surroundings influencing organism"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "environment", "target_book": "polyanthea_medicinal", "target_name": "ar ambiente", "similarity": 0.936}, {"source_book": "principles_of_psychology_james_1890", "source_name": "environment", "target_book": "first_principles_spencer_1862", "target_name": "environment", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "ar ambiente", "target_book": "first_principles_spencer_1862", "target_name": "environment", "similarity": 0.936}], "id": 1549, "stable_key": "clu_3a94c076100c118f", "ground_truth": {"modern_name": "environment", "confidence": "high", "type": "concept", "note": "The Portuguese phrase 'ar ambiente' directly translates to 'ambient air' or 'surrounding air,' which falls under the broader concept of environment in a scientific context.", "wikidata_id": "Q2249676", "wikidata_description": "surrounding of an organism or population", "wikipedia_url": "https://en.wikipedia.org/wiki/Biophysical%20environment"}}, {"canonical_name": "physical science", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "physical_sciences", "book_id": "principles_of_psychology_james_1890", "name": "physical sciences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["physical sciences"], "contexts": ["sciences studying the material world"]}, {"entity_id": "physical_science", "book_id": "kosmos_humboldt_1845", "name": "physical science", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["physical science"], "contexts": ["science dealing with physical laws", "branch of science dealing with matter and energy"]}, {"entity_id": "physical_science", "book_id": "connexion_physical_sciences_somerville_1858", "name": "physical science", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["physical science"], "contexts": ["field of study concerning matter and energy", "branch of science dealing with matter and energy"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "physical sciences", "target_book": "kosmos_humboldt_1845", "target_name": "physical science", "similarity": 0.97}, {"source_book": "principles_of_psychology_james_1890", "source_name": "physical sciences", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "physical science", "similarity": 0.97}, {"source_book": "kosmos_humboldt_1845", "source_name": "physical science", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "physical science", "similarity": 1.0}], "id": 1550, "stable_key": "clu_46d9a1f69e8fd97d-2", "ground_truth": {"modern_name": "physical science", "confidence": "high", "type": "concept", "wikidata_id": "Q4339448", "wikidata_description": "government organization in Moscow, Russia"}}, {"canonical_name": "Mist", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "dust", "book_id": "principles_of_psychology_james_1890", "name": "dust", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["dust"], "contexts": ["fine particles of matter"]}, {"entity_id": "mist", "book_id": "kosmos_humboldt_1845", "name": "Mist", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Mist", "mist"], "contexts": ["fine water droplets suspended in air", "atmospheric water vapor"]}, {"entity_id": "dust", "book_id": "kosmos_humboldt_1845", "name": "dust", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["dust"], "contexts": ["fine particles of matter"]}, {"entity_id": "dust", "book_id": "first_principles_spencer_1862", "name": "dust", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["dust"], "contexts": ["separated by size", "minute particles carried by breeze"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "dust", "target_book": "kosmos_humboldt_1845", "target_name": "Mist", "similarity": 0.889}, {"source_book": "principles_of_psychology_james_1890", "source_name": "dust", "target_book": "kosmos_humboldt_1845", "target_name": "dust", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "dust", "target_book": "first_principles_spencer_1862", "target_name": "dust", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mist", "target_book": "first_principles_spencer_1862", "target_name": "dust", "similarity": 0.889}, {"source_book": "kosmos_humboldt_1845", "source_name": "dust", "target_book": "first_principles_spencer_1862", "target_name": "dust", "similarity": 1.0}], "id": 1551, "stable_key": "clu_3dc685eebdb98378", "ground_truth": {"modern_name": "mist", "confidence": "medium", "type": "concept", "note": "While 'mist' and 'dust' can refer to distinct phenomena, in early modern texts, the terms could sometimes be used interchangeably or with overlapping meanings for fine airborne particles or suspended water droplets. The context in Humboldt's 'Kosmos' for 'Mist' suggests atmospheric phenomena, aligning with mist. The 'dust' occurrences are less clear-cut without more context, but 'mist' as a primary referent seems plausible given the mixed usage.", "wikidata_id": "Q192196", "wikidata_description": "phenomenon caused by small droplets of water suspended in air"}}, {"canonical_name": "radiation of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "radiation_of_heat", "book_id": "kosmos_humboldt_1845", "name": "radiation of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["radiation of heat"], "contexts": ["emission of thermal energy"]}, {"entity_id": "radiation_of_heat", "book_id": "connexion_physical_sciences_somerville_1858", "name": "radiation of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Radiation of heat", "radiation of heat"], "contexts": ["transfer of motion from particles", "emission of thermal energy"]}, {"entity_id": "radiant_heat", "book_id": "first_principles_spencer_1862", "name": "radiant heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["radiant heat"], "contexts": ["researches into radiant heat and light", "researches into physical phenomena"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "radiation of heat", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "radiation of heat", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "radiation of heat", "target_book": "first_principles_spencer_1862", "target_name": "radiant heat", "similarity": 0.924}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "radiation of heat", "target_book": "first_principles_spencer_1862", "target_name": "radiant heat", "similarity": 0.924}], "id": 1552, "stable_key": "clu_64c41c0b0bc4ad37", "ground_truth": {"modern_name": "Thermal radiation", "confidence": "high", "type": "concept", "wikidata_id": "Q58469017", "wikidata_description": "scholarly article in Physical Review B, vol. 75 no. 20, May 2007"}}, {"canonical_name": "electric", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "electric", "book_id": "kosmos_humboldt_1845", "name": "electric", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["electric"], "contexts": ["phenomenon of electric charge"]}, {"entity_id": "electric", "book_id": "connexion_physical_sciences_somerville_1858", "name": "electric", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["electric"], "contexts": ["substance that can retain electric state", "state of the atmosphere on approach of rain"]}, {"entity_id": "electric", "book_id": "first_principles_spencer_1862", "name": "electric", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["electric", "Electric"], "contexts": ["related to electricity", "relating to electricity"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "electric", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electric", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "electric", "target_book": "first_principles_spencer_1862", "target_name": "electric", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "electric", "target_book": "first_principles_spencer_1862", "target_name": "electric", "similarity": 1.0}], "id": 1553, "stable_key": "clu_db24937985ffaaec", "ground_truth": {"modern_name": "Electric", "confidence": "high", "type": "concept", "note": "Refers to phenomena or substances related to electricity in general, not a specific substance.", "wikidata_id": "Q383973", "wikidata_description": "process of generating electrical power"}}, {"canonical_name": "universal gravitation", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "law_of_universal_gravitation", "book_id": "kosmos_humboldt_1845", "name": "law of universal gravitation", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["law of universal gravitation"], "contexts": ["fundamental physics principle"]}, {"entity_id": "universal_gravitation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "universal gravitation", "category": "CONCEPT", "subcategory": "THEORY", "count": 3, "variants": ["universal gravitation", "Universal Gravitation"], "contexts": ["Newton's law of gravity", "force attracting bodies"]}, {"entity_id": "law_of_gravitation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "law of gravitation", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["law of gravitation"], "contexts": ["fundamental law of physics"]}, {"entity_id": "law_of_gravitation", "book_id": "first_principles_spencer_1862", "name": "law of gravitation", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["law of gravitation"], "contexts": ["fundamental principle of physics", "fundamental force of attraction between masses"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "law of universal gravitation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "universal gravitation", "similarity": 0.926}, {"source_book": "kosmos_humboldt_1845", "source_name": "law of universal gravitation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "law of gravitation", "similarity": 0.943}, {"source_book": "kosmos_humboldt_1845", "source_name": "law of universal gravitation", "target_book": "first_principles_spencer_1862", "target_name": "law of gravitation", "similarity": 0.943}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "law of gravitation", "target_book": "first_principles_spencer_1862", "target_name": "law of gravitation", "similarity": 1.0}], "id": 1554, "stable_key": "clu_0cf48356318bef25", "ground_truth": {"modern_name": "Universal Gravitation", "confidence": "high", "type": "concept", "wikipedia_extract": "The gravity of Earth, denoted by g, is the net acceleration that is imparted to objects due to the combined effect of gravitation (from mass distribution within Earth) and the centrifugal force (from the Earth's rotation). It is a vector quantity, whose direction coincides with a plumb bob and strength or magnitude is given by the norm {\\displaystyle g=\\|{\\mathit {\\mathbf {g} }}\\|} In SI units, this acceleration is expressed in metres per second squared (in symbols, m/s2 or m\u00b7s\u22122) or equivalently in newtons per kilogram (N/kg or N\u00b7kg\u22121). Near Earth's surface, the acceleration due to gravity, accurate to 2 significant figures, is 9.8 m/s2 (32 ft/s2). This means that, ignoring the effects of air resistance, the vertical component of velocity of an object falling freely will increase in the downwards direction by about 9.8 metres per second (32 ft/s) every second. The precise strength of Earth's gravity varies with location. The conventional value for standard gravity is 9.80665 m\u22c5s\u22122\u200d by definition, originally adopted by the CGPM in 1901.", "wikipedia_url": "https://en.wikipedia.org/wiki/Gravity_of_Earth"}}, {"canonical_name": "magneto-electric machine", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "magnetic_apparatus", "book_id": "kosmos_humboldt_1845", "name": "magnetic apparatus", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["magnetic apparatus"], "contexts": ["device utilizing magnetism"]}, {"entity_id": "electro-magnetic_apparatus", "book_id": "kosmos_humboldt_1845", "name": "electro-magnetic apparatus", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["electro-magnetic apparatus"], "contexts": ["apparatus for measuring electricity"]}, {"entity_id": "magneto-electric_machine", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magneto-electric machine", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["magneto-electric machine"], "contexts": ["machine generating electricity from magnetism", "device generating electricity from magnetism"]}, {"entity_id": "magneto-electric_apparatus", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Magneto-Electric Apparatus", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["Magneto-Electric Apparatus"], "contexts": ["device for magneto-electric effects"]}, {"entity_id": "magneto-electric_machine", "book_id": "first_principles_spencer_1862", "name": "magneto-electric machine", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["magneto-electric machine"], "contexts": ["evolves electricity from rotating magnet"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "magnetic apparatus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magneto-electric machine", "similarity": 0.915}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic apparatus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Magneto-Electric Apparatus", "similarity": 0.941}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic apparatus", "target_book": "first_principles_spencer_1862", "target_name": "magneto-electric machine", "similarity": 0.915}, {"source_book": "kosmos_humboldt_1845", "source_name": "electro-magnetic apparatus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magneto-electric machine", "similarity": 0.907}, {"source_book": "kosmos_humboldt_1845", "source_name": "electro-magnetic apparatus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Magneto-Electric Apparatus", "similarity": 0.942}, {"source_book": "kosmos_humboldt_1845", "source_name": "electro-magnetic apparatus", "target_book": "first_principles_spencer_1862", "target_name": "magneto-electric machine", "similarity": 0.907}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "magneto-electric machine", "target_book": "first_principles_spencer_1862", "target_name": "magneto-electric machine", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Magneto-Electric Apparatus", "target_book": "first_principles_spencer_1862", "target_name": "magneto-electric machine", "similarity": 0.939}], "id": 1555, "stable_key": "clu_731cab968d9e75ba", "ground_truth": {"modern_name": "Magneto-electric machine", "confidence": "high", "type": "object", "note": "Early devices for generating electricity from magnetism."}}, {"canonical_name": "French", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "franceza", "book_id": "polyanthea_medicinal", "name": "Franceza", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Franceza", "franca"], "contexts": ["language of France", "free or open"]}, {"entity_id": "french", "book_id": "connexion_physical_sciences_somerville_1858", "name": "French", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["French"], "contexts": ["nationality associated with time and measures", "related to France"]}, {"entity_id": "french", "book_id": "first_principles_spencer_1862", "name": "French", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["French"], "contexts": ["language and people", "language with dwindling inflexions"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Franceza", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "French", "similarity": 0.932}, {"source_book": "polyanthea_medicinal", "source_name": "Franceza", "target_book": "first_principles_spencer_1862", "target_name": "French", "similarity": 0.932}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "French", "target_book": "first_principles_spencer_1862", "target_name": "French", "similarity": 1.0}], "id": 1556, "stable_key": "clu_c9257ab95c6c2917", "ground_truth": {"modern_name": "French", "confidence": "high", "type": "concept", "note": "Refers to the language and nationality of France.", "wikidata_id": "Q150", "wikidata_description": "Romance language", "wikipedia_url": "https://en.wikipedia.org/wiki/French%20language", "wikipedia_extract": "French (fran\u00e7ais [f\u0281\u0251\u0303s\u025b]  or langue fran\u00e7aise [l\u0251\u0303\u0261 f\u0281\u0251\u0303s\u025b\u02d0z] ) is a Romance language of the Indo-European family. Like all other Romance languages, it descended from the Vulgar Latin of the Roman Empire. French evolved from Northern Old Gallo-Romance, a descendant of the Latin spoken in Northern Gaul. Its closest relatives are the other langues d'o\u00efl\u2014languages historically spoken in northern France and in southern Belgium, which French (Francien) largely supplanted. It was also influenced by native Celtic languages of Northern Roman Gaul and by the Germanic Frankish language of the post-Roman Frankish invaders. As a result of French and Belgian colonialism from the 16th century onward, it was introduced to new territories in the Americas, Africa, and Asia, and numerous French-based creole languages, most notably Haitian Creole, were developed."}}, {"canonical_name": "prey", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "prey", "book_id": "principles_of_psychology_james_1890", "name": "prey", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Prey", "prey"], "contexts": ["animal hunted for food", "species interested in its own prey or food"]}, {"entity_id": "prey", "book_id": "first_principles_spencer_1862", "name": "prey", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["prey"], "contexts": ["sought by predatory creature", "animal hunted for food"]}, {"entity_id": "prey", "book_id": "origin_of_species_darwin_1859", "name": "prey", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["prey"], "contexts": ["animal hunted by another", "animal hunted and killed by another for food"]}, {"entity_id": "predatory_creature", "book_id": "first_principles_spencer_1862", "name": "predatory creature", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["predatory creature"], "contexts": ["pursues its prey"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "prey", "target_book": "first_principles_spencer_1862", "target_name": "prey", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "prey", "target_book": "first_principles_spencer_1862", "target_name": "predatory creature", "similarity": 0.916}], "id": 1557, "stable_key": "clu_c66ee59886be0621", "ground_truth": {"modern_name": "Prey", "confidence": "high", "type": "concept", "note": "The context clearly describes animals hunted for food or by predators.", "wikidata_id": "Q37568776", "wikidata_description": "family name"}}, {"canonical_name": "math\u00e9maticiens", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "math\u00e9maticiens", "book_id": "medecine_experimentale_bernard_1865", "name": "math\u00e9maticiens", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["math\u00e9maticiens"], "contexts": ["experts in mathematics", "practitioners of mathematics"]}, {"entity_id": "mathematicians", "book_id": "origin_of_species_darwin_1859", "name": "mathematicians", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["mathematicians"], "contexts": ["experts who studied bee cell geometry"]}, {"entity_id": "mathematicians", "book_id": "first_principles_spencer_1862", "name": "mathematicians", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["mathematicians"], "contexts": ["experts in mathematics"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "math\u00e9maticiens", "target_book": "origin_of_species_darwin_1859", "target_name": "mathematicians", "similarity": 0.881}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "math\u00e9maticiens", "target_book": "first_principles_spencer_1862", "target_name": "mathematicians", "similarity": 0.989}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mathematicians", "target_book": "first_principles_spencer_1862", "target_name": "mathematicians", "similarity": 0.888}], "id": 1558, "stable_key": "clu_d1f2c5aa7548dd44", "ground_truth": {"modern_name": "Mathematicians", "confidence": "high", "type": "person", "description": "Experts in the field of mathematics and geometry.", "wikidata_id": "Q170790", "wikidata_description": "person with an extensive knowledge of mathematics", "wikipedia_url": "https://en.wikipedia.org/wiki/Mathematician", "wikipedia_extract": "A mathematician is someone who uses an extensive knowledge of mathematics in their work, typically to solve mathematical problems. Mathematicians are concerned with numbers, data, quantity, structure, space, models, and change. One of the earliest known mathematicians was Thales of Miletus (c. 624 \u2013 c. 546 BC); he has been hailed as the first true mathematician and the first known individual to whom a mathematical discovery has been attributed. He is credited with the first use of deductive reasoning applied to geometry, by deriving four corollaries to Thales's theorem."}}, {"canonical_name": "opium", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "opium", "book_id": "medecine_experimentale_bernard_1865", "name": "opium", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["opium"], "contexts": ["drug that causes sleep", "substance that causes sleep"]}, {"entity_id": "opi", "book_id": "historia_medicinal_monardes_1574", "name": "Opi", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Opi"], "contexts": ["substance requested by an Indian"]}, {"entity_id": "opioi", "book_id": "coloquios_da_orta_1563", "name": "opioi", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["opioi"], "contexts": ["term for opium"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "opium", "target_book": "coloquios_da_orta_1563", "target_name": "opioi", "similarity": 0.901}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Opi", "target_book": "coloquios_da_orta_1563", "target_name": "opioi", "similarity": 0.895}], "id": 1559, "stable_key": "clu_c52356b218ed7bab", "ground_truth": {"modern_name": "Opium", "confidence": "high", "type": "substance", "description": "Narcotic substance obtained from the opium poppy.", "note": "'Oppio' and its variations refer to opium.", "wikipedia_extract": "Opium (also known as poppy tears, or Lachryma papaveris) is the dried latex obtained from the seed capsules of the opium poppy Papaver somniferum. Approximately 12 percent of opium is made up of the analgesic alkaloid morphine, which is processed chemically to produce heroin and other synthetic opioids for medicinal use and for the illegal drug trade. Opium's main psychoactive alkaloids, primarily morphine, act on \u03bc-opioid receptors, causing analgesia, with long-term use leading to tolerance and dependence. The latex also contains the closely related opiates codeine and thebaine, and non-analgesic alkaloids such as papaverine and noscapine. The traditional, labor-intensive method of obtaining the latex is to scratch (\"score\") the immature seed pods (fruits) by hand; the latex leaks out and dries to a sticky yellowish residue that is later scraped off and dehydrated. The English word for opium is borrowed from Latin, which in turn comes from Ancient Greek: \u1f44\u03c0\u03b9\u03bf\u03bd (\u00f3pion), a diminutive of \u1f40\u03c0\u03cc\u03c2 (op\u00f3s, 'juice of a plant')."}}, {"canonical_name": "sant\u00e9", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "sant\u00e9", "book_id": "medecine_experimentale_bernard_1865", "name": "sant\u00e9", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["sant\u00e9"], "contexts": ["state of being free from illness", "condition of the organism"]}, {"entity_id": "san\u00eda", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "san\u00eda", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["san\u00eda"], "contexts": ["illness treated by pacahuitzpatli root"]}, {"entity_id": "salud", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "salud", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["salud"], "contexts": ["state of being healthy"]}, {"entity_id": "health", "book_id": "first_principles_spencer_1862", "name": "health", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["health"], "contexts": ["state of well-being"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "sant\u00e9", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "san\u00eda", "similarity": 0.891}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "sant\u00e9", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "salud", "similarity": 0.987}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "sant\u00e9", "target_book": "first_principles_spencer_1862", "target_name": "health", "similarity": 0.984}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "san\u00eda", "target_book": "first_principles_spencer_1862", "target_name": "health", "similarity": 0.884}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "salud", "target_book": "first_principles_spencer_1862", "target_name": "health", "similarity": 0.981}], "id": 1560, "stable_key": "clu_399f4a074771d297", "ground_truth": {"modern_name": "Health", "confidence": "high", "type": "concept", "note": "The terms 'sant\u00e9', 'san\u00eda', and 'salud' all translate to health, and the context of being free from illness confirms this.", "wikidata_id": "Q189603", "wikidata_description": "science and art of preventing disease, prolonging life and promoting health through organized efforts and informed choices of society, organizations, public and private, communities and individuals", "wikipedia_url": "https://en.wikipedia.org/wiki/Public%20health"}}, {"canonical_name": "albumine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "albumine", "book_id": "medecine_experimentale_bernard_1865", "name": "albumine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["albumine"], "contexts": ["organic immediate principle", "protein coagulable by heat"]}, {"entity_id": "albumine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "albumine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["albumine"], "contexts": ["component of sugarcane juice"]}, {"entity_id": "albuminoid_matter", "book_id": "principles_of_psychology_james_1890", "name": "albuminoid matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["albuminoid matter"], "contexts": ["biological material of a person"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "albumine", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "albumine", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "albumine", "target_book": "principles_of_psychology_james_1890", "target_name": "albuminoid matter", "similarity": 0.913}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "albumine", "target_book": "principles_of_psychology_james_1890", "target_name": "albuminoid matter", "similarity": 0.913}], "id": 1561, "stable_key": "clu_6bfd3cf162c53be5", "ground_truth": {"modern_name": "Albuminoid", "confidence": "high", "type": "chemical", "wikidata_id": "Q23851981", "wikidata_description": "article in Otto's encyclopedia"}}, {"canonical_name": "contraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "contraction", "book_id": "medecine_experimentale_bernard_1865", "name": "contraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["contraction"], "contexts": ["shortening of muscle fibers", "contraction"]}, {"entity_id": "contraction", "book_id": "principles_of_psychology_james_1890", "name": "contraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["contraction"], "contexts": ["action of a muscle"]}, {"entity_id": "contraction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "contraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["contraction"], "contexts": ["process of becoming smaller", "process of decreasing in size"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "contraction", "target_book": "principles_of_psychology_james_1890", "target_name": "contraction", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "contraction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "contraction", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "contraction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "contraction", "similarity": 1.0}], "id": 1562, "stable_key": "clu_df06e698fb3cee85", "ground_truth": {"modern_name": null, "confidence": "high", "type": "concept", "wikidata_id": "Q127006", "wikidata_description": "process in which force is generated within muscle tissue, resulting in a change in muscle geometry. Force generation involves a chemo-mechanical energy conversion step that is carried out by the actin/myosin complex activity", "wikipedia_url": "https://en.wikipedia.org/wiki/Muscle%20contraction", "wikipedia_extract": "Muscle contraction is the activation of tension-generating sites within muscle cells. In physiology, muscle contraction does not necessarily mean muscle shortening because muscle tension can be produced without changes in muscle length (isometric contraction), such as when holding something heavy in the same position. The termination of muscle contraction is followed by muscle relaxation, which is a return of the muscle fibers to their low tension-generating state. For the contractions to happen, the muscle cells must rely on the change in action of two types of filament: thin and thick filaments. The major constituent of thin filaments is a chain formed by helical coiling of two strands of actin, and thick filaments dominantly consist of chains of the motor-protein myosin. Together, these two filaments form myofibrils - the basic functional organelles in the skeletal muscle system."}}, {"canonical_name": "porc", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "porc", "book_id": "medecine_experimentale_bernard_1865", "name": "porc", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["porc"], "contexts": ["domestic animal used in research", "animal chosen for experiments"]}, {"entity_id": "porcs", "book_id": "relation_historique_humboldt_vol3_1825", "name": "porcs", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["porcs", "porc"], "contexts": ["livestock consumption in Mexico", "meat of pig"]}, {"entity_id": "porco", "book_id": "ricettario_fiorentino_1597", "name": "porco", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["porco"], "contexts": ["fresh pig fat used in ointment"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "porc", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "porcs", "similarity": 0.972}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "porc", "target_book": "ricettario_fiorentino_1597", "target_name": "porco", "similarity": 0.972}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "porcs", "target_book": "ricettario_fiorentino_1597", "target_name": "porco", "similarity": 0.935}], "id": 1563, "stable_key": "clu_8e14846962f338c7-2", "ground_truth": {"modern_name": "Pigs", "confidence": "medium", "type": "animal", "note": "The term 'porcos' is clearly pigs. 'Porpoces' could refer to porpoises, and 'por\u00e7ovejos' is unclear but potentially a misspelling or regional term. However, the context of gall presence for medicinal use often involved domestic animals like pigs.", "wikidata_id": "Q58697", "wikidata_description": "omnivore species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Wild%20boar", "wikipedia_extract": "The wild boar (Sus scrofa), also known as the wild swine, common wild pig, Eurasian wild pig, or simply wild pig, is a suid native to much of Eurasia and North Africa, and has been introduced to the Americas and Oceania. The species is now one of the widest-ranging mammals in the world, as well as the most widespread suiform. It has been assessed as least concern on the IUCN Red List due to its wide range, high numbers, and adaptability to a diversity of habitats. It has become an invasive species in part of its introduced range. Wild boars probably originated in Southeast Asia during the Early Pleistocene and outcompeted other suid species as they spread throughout the Old World. As of 2005, up to 16 subspecies are recognized, which are divided into four regional groupings based on skull height and lacrimal bone length."}}, {"canonical_name": "materialism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "mat\u00e9rialisme", "book_id": "medecine_experimentale_bernard_1865", "name": "mat\u00e9rialisme", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["mat\u00e9rialisme"], "contexts": ["philosophical doctrine about matter", "philosophical view of matter as primary"]}, {"entity_id": "materialism", "book_id": "principles_of_psychology_james_1890", "name": "materialism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["materialism"], "contexts": ["philosophical view that matter is fundamental", "philosophical view of matter as primary"]}, {"entity_id": "materialism", "book_id": "first_principles_spencer_1862", "name": "Materialism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Materialism"], "contexts": ["charge made against those who ascribe phenomena to agencies"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "mat\u00e9rialisme", "target_book": "principles_of_psychology_james_1890", "target_name": "materialism", "similarity": 0.958}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "mat\u00e9rialisme", "target_book": "first_principles_spencer_1862", "target_name": "Materialism", "similarity": 0.926}, {"source_book": "principles_of_psychology_james_1890", "source_name": "materialism", "target_book": "first_principles_spencer_1862", "target_name": "Materialism", "similarity": 0.973}], "id": 1564, "stable_key": "clu_a3b5dce654d8e550", "ground_truth": {"modern_name": "materialism", "confidence": "high", "type": "concept", "wikidata_id": "Q7081", "wikidata_description": "form of philosophical monism which holds matter to be the fundamental substance in nature", "wikipedia_url": "https://en.wikipedia.org/wiki/Materialism", "wikipedia_extract": "In philosophy and metaphysics, materialism is a form of monism holding that matter is the fundamental substance of nature, so that all things, including mind and consciousness, arise from material interactions and depend on physical processes, including those of the human brain and nervous system. It contrasts with monistic idealism, which treats consciousness as fundamental, and is related to naturalism, the view that only natural laws and forces operate in the universe, and to physicalism, the view that all that exists is ultimately physical. Physicalism extends materialism by including forms of physicality beyond ordinary matter (e.g. spacetime, energy, forces, exotic matter), and some use the terms interchangeably. Alternative philosophies opposed or alternative to materialism or physicalism include idealism, pluralism, dualism, solipsism, panpsychism, and other forms of monism. Materialism is the philosophical doctrine that matter has a primary position in the nature of the world, with mind or consciousness emerging as a secondary, dependent reality or not existing at all."}}, {"canonical_name": "Physiology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "physiology", "book_id": "medecine_experimentale_bernard_1865", "name": "physiology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["physiology"], "contexts": ["laws governing phenomena", "study of the functions of living organisms"]}, {"entity_id": "physiologie", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Physiologie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Physiologie"], "contexts": ["book by Epiphanius on animal nature"]}, {"entity_id": "physiology", "book_id": "first_principles_spencer_1862", "name": "Physiology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Physiology", "physiology"], "contexts": ["science affecting medicine and hygiene", "scientific study of the functions of living organisms"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "physiology", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Physiologie", "similarity": 0.946}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "physiology", "target_book": "first_principles_spencer_1862", "target_name": "Physiology", "similarity": 0.957}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Physiologie", "target_book": "first_principles_spencer_1862", "target_name": "Physiology", "similarity": 0.992}], "id": 1565, "stable_key": "clu_a696c4f1c4868e72", "ground_truth": {"modern_name": "Human Physiology", "confidence": "high", "type": "concept", "note": "The cluster encompasses the study of the functions of the human body, with specific mentions of works on physiology.", "wikidata_id": "Q15751418", "wikidata_description": "journal"}}, {"canonical_name": "embryo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "embryo", "book_id": "medecine_experimentale_bernard_1865", "name": "Embryo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Embryo"], "contexts": ["developing organism", "embryo of deer"]}, {"entity_id": "embryos", "book_id": "origin_of_species_darwin_1859", "name": "embryos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["embryos"], "contexts": ["developing organisms"]}, {"entity_id": "embryo", "book_id": "first_principles_spencer_1862", "name": "embryo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["embryo"], "contexts": ["general structure marked out with precision", "developing organism before birth"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Embryo", "target_book": "origin_of_species_darwin_1859", "target_name": "embryos", "similarity": 0.979}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Embryo", "target_book": "first_principles_spencer_1862", "target_name": "embryo", "similarity": 0.996}, {"source_book": "origin_of_species_darwin_1859", "source_name": "embryos", "target_book": "first_principles_spencer_1862", "target_name": "embryo", "similarity": 0.981}], "id": 1566, "stable_key": "clu_42aca3f5da9440c8", "ground_truth": {"modern_name": "Embryo", "confidence": "high", "type": "concept", "note": "The term 'embryo' has remained consistent in its biological meaning.", "wikidata_id": "Q192154", "wikidata_description": "superdivision of plants"}}, {"canonical_name": "ciel", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "ciel", "book_id": "medecine_experimentale_bernard_1865", "name": "ciel", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["ciel"], "contexts": ["sky"]}, {"entity_id": "ciel", "book_id": "epoques_nature_buffon_1778", "name": "ciel", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["ciel"], "contexts": ["celestial realm", "name given to the firmament"]}, {"entity_id": "sky", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sky", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["sky"], "contexts": ["atmospheric expanse above Earth", "the atmosphere above the earth"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "ciel", "target_book": "epoques_nature_buffon_1778", "target_name": "ciel", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "ciel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sky", "similarity": 0.972}, {"source_book": "epoques_nature_buffon_1778", "source_name": "ciel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sky", "similarity": 0.972}], "id": 1567, "stable_key": "clu_119b5f457fca94a0", "ground_truth": {"modern_name": "Sky", "confidence": "high", "type": "place", "wikidata_id": "Q527", "wikidata_description": "region of the atmosphere and outer space visible from the surface of the Earth", "wikipedia_url": "https://en.wikipedia.org/wiki/Sky", "wikipedia_extract": "The sky is an unobstructed view upward from the surface of the Earth. It includes the atmosphere and outer space. It may also be considered a place between the ground and outer space, thus distinct from outer space. In the field of astronomy, the sky is also called the celestial sphere. This is an abstract sphere, concentric to the Earth, on which the Sun, Moon, planets, and stars appear to be drifting. The celestial sphere is conventionally divided into designated areas called constellations.", "note": "In this context, 'heaven' refers to the celestial sphere or the sky, not the religious afterlife."}}, {"canonical_name": "letters", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "lettres", "book_id": "medecine_experimentale_bernard_1865", "name": "lettres", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["lettres"], "contexts": ["written works, especially those of literary merit"]}, {"entity_id": "letters", "book_id": "principles_of_psychology_james_1890", "name": "letters", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["letters"], "contexts": ["written symbols", "written symbols of alphabet"]}, {"entity_id": "letter", "book_id": "principles_of_psychology_james_1890", "name": "letter", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["letter"], "contexts": ["basic unit of alphabet"]}, {"entity_id": "letter", "book_id": "kosmos_humboldt_1845", "name": "letter", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["letter"], "contexts": ["symbol in an alphabet"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "lettres", "target_book": "principles_of_psychology_james_1890", "target_name": "letters", "similarity": 0.95}, {"source_book": "principles_of_psychology_james_1890", "source_name": "letters", "target_book": "kosmos_humboldt_1845", "target_name": "letter", "similarity": 0.853}, {"source_book": "principles_of_psychology_james_1890", "source_name": "letter", "target_book": "kosmos_humboldt_1845", "target_name": "letter", "similarity": 1.0}], "id": 1568, "stable_key": "clu_b02bd6438e8bbe0a", "ground_truth": {"modern_name": "letter", "confidence": "high", "type": "concept", "note": "Refers to a written symbol representing a sound or set of sounds in an alphabet."}}, {"canonical_name": "pollo", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "poulet", "book_id": "medecine_experimentale_bernard_1865", "name": "poulet", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["poulet"], "contexts": ["example of developing organism"]}, {"entity_id": "pollo", "book_id": "historia_medicinal_monardes_1574", "name": "pollo", "category": "ANIMAL", "subcategory": "BIRD", "count": 4, "variants": ["pollo", "pollos"], "contexts": ["chicken, used as food", "small chicken for patient's weakness"]}, {"entity_id": "pollo", "book_id": "ricettario_fiorentino_1597", "name": "pollo", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["pollo"], "contexts": ["chicken, a bird"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "poulet", "target_book": "historia_medicinal_monardes_1574", "target_name": "pollo", "similarity": 0.906}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "poulet", "target_book": "ricettario_fiorentino_1597", "target_name": "pollo", "similarity": 0.906}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "pollo", "target_book": "ricettario_fiorentino_1597", "target_name": "pollo", "similarity": 1.0}], "id": 1569, "stable_key": "clu_d0a78a6a466f8e82", "ground_truth": {"modern_name": "Chicken", "confidence": "high", "type": "animal", "note": "The cluster contains 'Hens'/'Hen' clearly referring to chickens, but also 'Heron'/'Herons' referring to the bird family Ardeidae. Given the dominance of 'Hens', the primary referent is likely chicken, with 'heron' being a secondary or potentially misidentified term within the same cluster.", "wikidata_id": "Q780", "wikidata_description": "domesticated bird kept by humans primarily as a food source", "wikipedia_url": "https://en.wikipedia.org/wiki/Chicken", "wikipedia_extract": "The chicken (Gallus gallus domesticus) is a domesticated form of the red junglefowl (Gallus gallus), originally native to Southeast Asia. It was first domesticated around 8,000 years ago and is one of the most common and widespread domesticated animals in the world. Chickens are primarily kept for their meat and eggs, though they are also kept as pets. As of 2023, the global chicken population exceeds 26.5 billion, with more than 50 billion birds produced annually for consumption. Specialized breeds such as broilers and laying hens have been developed for meat and egg production, respectively. A hen bred for laying can produce over 300 eggs per year.", "linnaean": "Gallus gallus domesticus", "family": "Phasianidae", "description": "Common domestic fowl, source of meat and broth."}}, {"canonical_name": "larv\u00e6", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "larves", "book_id": "medecine_experimentale_bernard_1865", "name": "larves", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["larves"], "contexts": ["immature form of an animal"]}, {"entity_id": "larv\u00e6", "book_id": "origin_of_species_darwin_1859", "name": "larv\u00e6", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["larv\u00e6"], "contexts": ["immature insect stage", "immature insect stages"]}, {"entity_id": "larv\u00e6", "book_id": "first_principles_spencer_1862", "name": "larv\u00e6", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["larv\u00e6"], "contexts": ["immature form of an animal"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "larves", "target_book": "origin_of_species_darwin_1859", "target_name": "larv\u00e6", "similarity": 0.929}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "larves", "target_book": "first_principles_spencer_1862", "target_name": "larv\u00e6", "similarity": 0.929}, {"source_book": "origin_of_species_darwin_1859", "source_name": "larv\u00e6", "target_book": "first_principles_spencer_1862", "target_name": "larv\u00e6", "similarity": 1.0}], "id": 1570, "stable_key": "clu_d6c270b59fb4f240", "ground_truth": {"modern_name": "Larva", "confidence": "high", "type": "animal"}}, {"canonical_name": "pulse", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "pulse", "book_id": "principles_of_psychology_james_1890", "name": "pulse", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["pulse"], "contexts": ["indicator of physiological change", "bodily rhythm quickened by alarm"]}, {"entity_id": "pulso", "book_id": "coloquios_da_orta_1563", "name": "pulso", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["pulso"], "contexts": ["part of the body to be examined", "used to diagnose fever and humors"]}, {"entity_id": "pulses", "book_id": "polyanthea_medicinal", "name": "pulses", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["pulses"], "contexts": ["body part for observation"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "pulse", "target_book": "coloquios_da_orta_1563", "target_name": "pulso", "similarity": 0.978}, {"source_book": "principles_of_psychology_james_1890", "source_name": "pulse", "target_book": "polyanthea_medicinal", "target_name": "pulses", "similarity": 0.943}, {"source_book": "coloquios_da_orta_1563", "source_name": "pulso", "target_book": "polyanthea_medicinal", "target_name": "pulses", "similarity": 0.911}], "id": 1571, "stable_key": "clu_b1d48ef65942bd2f", "ground_truth": {"modern_name": "pulse", "confidence": "high", "type": "concept", "description": "The rhythmic throbbing of arteries, used for diagnosis.", "wikipedia_extract": "In medicine, pulse is the rhythmic expansion and contraction of an artery in response to the cardiac cycle (heartbeat). The pulse may be felt (palpated) in any place that allows an artery to be compressed near the surface of the body, such as at the neck (carotid artery), wrist (radial artery or ulnar artery), at the groin (femoral artery), behind the knee (popliteal artery), near the ankle joint (posterior tibial artery), and on foot (dorsalis pedis artery). The pulse is most commonly measured at the wrist or neck for adults and at the brachial artery (inner upper arm between the shoulder and elbow) for infants and very young children. A sphygmograph is an instrument for measuring the pulse. Claudius Galen was perhaps the first physiologist to describe the pulse. The pulse is an expedient tactile method of determination of systolic blood pressure to a trained observer."}}, {"canonical_name": "literature", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "literature", "book_id": "medecine_experimentale_bernard_1865", "name": "literature", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["literature"], "contexts": ["written works of art"]}, {"entity_id": "litt\u00e9rature", "book_id": "relation_historique_humboldt_vol3_1825", "name": "litt\u00e9rature", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["litt\u00e9rature"], "contexts": ["cultural aspect of European peoples"]}, {"entity_id": "literature", "book_id": "first_principles_spencer_1862", "name": "literature", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Literature", "literature"], "contexts": ["development from simple to complex", "written works collectively"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "literature", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "litt\u00e9rature", "similarity": 0.957}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "literature", "target_book": "first_principles_spencer_1862", "target_name": "literature", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "litt\u00e9rature", "target_book": "first_principles_spencer_1862", "target_name": "literature", "similarity": 0.957}], "id": 1572, "stable_key": "clu_2a5d9f69b2cfe4ba", "ground_truth": {"modern_name": "Literature", "confidence": "high", "type": "concept", "wikidata_id": "Q208217", "wikidata_description": "scholarly study of literature"}}, {"canonical_name": "Philologos", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "philologue", "book_id": "medecine_experimentale_bernard_1865", "name": "philologue", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["philologue"], "contexts": ["expert in language and literature"]}, {"entity_id": "philosophers", "book_id": "kosmos_humboldt_1845", "name": "philosophers", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["philosophers"], "contexts": ["thinkers concerned with fundamental questions"]}, {"entity_id": "philologos", "book_id": "polyanthea_medicinal", "name": "Philologos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["Philologos", "Philoftotos", "Philo\u017ftotos"], "contexts": ["scholars of language and literature", "those who study language and rhetoric"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "philologue", "target_book": "polyanthea_medicinal", "target_name": "Philologos", "similarity": 0.921}, {"source_book": "kosmos_humboldt_1845", "source_name": "philosophers", "target_book": "polyanthea_medicinal", "target_name": "Philologos", "similarity": 0.915}], "id": 1573, "stable_key": "clu_dc6ec678707a2ae0", "ground_truth": {"modern_name": "philologists", "confidence": "high", "type": "person", "description": "Scholars of language, literature, and ancient texts."}}, {"canonical_name": "cats", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "chats", "book_id": "medecine_experimentale_bernard_1865", "name": "chats", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["chats"], "contexts": ["animal used in Magendie's experiments"]}, {"entity_id": "cats", "book_id": "origin_of_species_darwin_1859", "name": "cats", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 4, "variants": ["cats"], "contexts": ["blue eyes linked to deafness", "nocturnal rambling mammals"]}, {"entity_id": "gatos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "gatos", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["gatos"], "contexts": ["domesticated felines"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "chats", "target_book": "origin_of_species_darwin_1859", "target_name": "cats", "similarity": 0.904}, {"source_book": "origin_of_species_darwin_1859", "source_name": "cats", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "gatos", "similarity": 0.906}], "id": 1574, "stable_key": "clu_221f8d9f0bc823ba-2", "ground_truth": {"modern_name": "Domestic cat", "confidence": "high", "type": "animal", "wikidata_id": "Q2961479", "wikidata_description": "heraldic animal"}}, {"canonical_name": "alcool", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "alcool", "book_id": "medecine_experimentale_bernard_1865", "name": "alcool", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["alcool"], "contexts": ["product of sugar fermentation"]}, {"entity_id": "alcool", "book_id": "relation_historique_humboldt_vol3_1825", "name": "alcool", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["alcool", "alcool rectifi\u00e9"], "contexts": ["substance that slightly coagulates plant sap", "alcohol"]}, {"entity_id": "\u00e1lcool", "book_id": "coloquios_da_orta_1563", "name": "\u00e1lcool", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["\u00e1lcool"], "contexts": ["poisonous substance mentioned with haschisch"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "alcool", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "alcool", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "alcool", "target_book": "coloquios_da_orta_1563", "target_name": "\u00e1lcool", "similarity": 0.973}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "alcool", "target_book": "coloquios_da_orta_1563", "target_name": "\u00e1lcool", "similarity": 0.973}], "id": 1575, "stable_key": "clu_67b6f1fe94c5d738-3", "ground_truth": {"modern_name": "Alcohol", "confidence": "high", "type": "chemical", "wikidata_id": "Q153", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Ethanol", "wikipedia_extract": "Ethanol (also called ethyl alcohol, grain alcohol, drinking alcohol, or simply alcohol) is an organic compound with the chemical formula CH3CH2OH. It is an alcohol, with its formula also written as C2H5OH, C2H6O or EtOH, where Et is the pseudoelement symbol for ethyl. Ethanol is a volatile, flammable, colorless liquid with a pungent taste. As a psychoactive depressant, it is the active ingredient in alcoholic beverages, and the second most consumed drug globally behind caffeine. Ethanol is naturally produced by the fermentation process of sugars by yeasts or via petrochemical processes such as ethylene hydration. Historically it was used as a general anesthetic, and has modern medical applications as an antiseptic, disinfectant, solvent for some medications, and antidote for methanol poisoning and ethylene glycol poisoning.", "note": "Aqua vitae (Latin for 'water of life') is an archaic term for distilled spirits, most commonly referring to ethanol."}}, {"canonical_name": "positivistic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "positivisme", "book_id": "medecine_experimentale_bernard_1865", "name": "positivisme", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["positivisme"], "contexts": ["philosophical system emphasizing empirical evidence"]}, {"entity_id": "positivistic", "book_id": "principles_of_psychology_james_1890", "name": "positivistic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["positivistic"], "contexts": ["point of view adopted", "psychology will remain positivistic"]}, {"entity_id": "positive", "book_id": "principles_of_psychology_james_1890", "name": "positive", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["positive"], "contexts": ["type of error in time estimation"]}, {"entity_id": "positive", "book_id": "connexion_physical_sciences_somerville_1858", "name": "positive", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["positive"], "contexts": ["one electric state"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "positivisme", "target_book": "principles_of_psychology_james_1890", "target_name": "positivistic", "similarity": 0.947}, {"source_book": "principles_of_psychology_james_1890", "source_name": "positivistic", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "positive", "similarity": 0.917}, {"source_book": "principles_of_psychology_james_1890", "source_name": "positive", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "positive", "similarity": 1.0}], "id": 1576, "stable_key": "clu_298170393256b99e", "ground_truth": {"modern_name": "positivism", "confidence": "high", "type": "concept", "note": "The term 'positivistic' and 'positive' in the context of James's 'Principles of Psychology' and Somerville's 'Connexion of the Physical Sciences' refers to the philosophical stance of positivism, especially its emphasis on empirical evidence and scientific observation.", "wikidata_id": "Q131015", "wikidata_description": "philosophy of science based on the view that information derived from scientific observation is the exclusive source of all authoritative knowledge"}}, {"canonical_name": "curiosity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "curiosity", "book_id": "medecine_experimentale_bernard_1865", "name": "curiosity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["curiosity"], "contexts": ["desire to know or learn something"]}, {"entity_id": "curiosity", "book_id": "principles_of_psychology_james_1890", "name": "curiosity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["curiosity"], "contexts": ["desire to know or learn", "a strong desire to know or learn something"]}, {"entity_id": "curiosity", "book_id": "first_principles_spencer_1862", "name": "curiosity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["curiosity"], "contexts": ["desire to know or learn"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "curiosity", "target_book": "principles_of_psychology_james_1890", "target_name": "curiosity", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "curiosity", "target_book": "first_principles_spencer_1862", "target_name": "curiosity", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "curiosity", "target_book": "first_principles_spencer_1862", "target_name": "curiosity", "similarity": 1.0}], "id": 1577, "stable_key": "clu_b16e82e1597f5ede", "ground_truth": {"modern_name": "curiosity", "confidence": "high", "type": "concept", "wikidata_id": "Q366791", "wikidata_description": "desire to learn, explore, or investigate", "wikipedia_url": "https://en.wikipedia.org/wiki/Curiosity", "wikipedia_extract": "Curiosity (from Latin c\u016bri\u014dsit\u0101s, from c\u016bri\u014dsus \"careful, diligent, curious\", akin to cura \"care\") is a quality related to inquisitive thinking, such as exploration, investigation, and learning, evident in humans and other animals. Curiosity helps human development, from which derives the process of learning and desire to acquire knowledge and skill. The term curiosity can also denote the behavior, characteristic, or emotion of being curious, in regard to the desire to gain knowledge or information. Curiosity as a behavior and emotion is the driving force behind human development, such as progress in science, language, and industry. Curiosity can be considered to be an evolutionary adaptation based on an organism's ability to learn. Certain curious animals (namely, corvids, octopuses, dolphins, elephants, rats, etc.) will pursue information in order to adapt to their surrounding and learn how things work."}}, {"canonical_name": "Diodorus", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "diodorus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Diodorus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["Diodorus"], "contexts": ["ancient historian", "denied crystal formation by cold"]}, {"entity_id": "diodore", "book_id": "epoques_nature_buffon_1778", "name": "Diodore", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Diodore"], "contexts": ["ancient historian who reported Atlantis"]}, {"entity_id": "diodorus", "book_id": "kosmos_humboldt_1845", "name": "Diodorus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Diodorus"], "contexts": ["ancient historian"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Diodorus", "target_book": "epoques_nature_buffon_1778", "target_name": "Diodore", "similarity": 0.955}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Diodorus", "target_book": "kosmos_humboldt_1845", "target_name": "Diodorus", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Diodore", "target_book": "kosmos_humboldt_1845", "target_name": "Diodorus", "similarity": 0.955}], "id": 1578, "stable_key": "clu_b57e26e64600a0ae", "ground_truth": {"modern_name": "Diodorus Siculus", "confidence": "high", "type": "person", "description": "Ancient Greek historian and chronicler", "wikidata_id": "Q171241", "wikidata_description": "1st-century BC Greek historian"}}, {"canonical_name": "Bezoar", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "bezoar", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Bezoar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["Bezoar"], "contexts": ["antidote stone from animal stomachs", "stone with no attractive power"]}, {"entity_id": "bezoar", "book_id": "historia_medicinal_monardes_1574", "name": "Bezoar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Bezoar"], "contexts": ["stone used for medicine", "stone used as antidote"]}, {"entity_id": "bezoar_stone", "book_id": "ricettario_fiorentino_1597", "name": "Bezoar stone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Bezoar stone"], "contexts": ["antidote stone from animal stomachs"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bezoar", "target_book": "historia_medicinal_monardes_1574", "target_name": "Bezoar", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bezoar", "target_book": "ricettario_fiorentino_1597", "target_name": "Bezoar stone", "similarity": 0.91}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Bezoar", "target_book": "ricettario_fiorentino_1597", "target_name": "Bezoar stone", "similarity": 0.91}], "id": 1579, "stable_key": "clu_0c4aa0111f771c6b", "ground_truth": {"modern_name": "Bezoar", "confidence": "high", "type": "mineral", "note": "'Bola' is the Arabic word for bezoar, a medicinal concretion found in the stomach of some animals. 'Bolas' in the second source likely refers to the same.", "wikidata_id": "Q897514", "wikidata_description": "subspecies of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Bezoar%20ibex", "wikipedia_extract": "The bezoar ibex (Capra aegagrus aegagrus) is a wild goat subspecies that is native to the montane forested areas in the Anatolia, Caucasus and the Zagros Mountains. The bezoar ibex, which weighs around 60 kg (130 lb) is known particularly for the size of its horns; it possesses the world's longest horns in relation to body weight, and can exceed 1.4 m (4 ft 7 in) high, those in the south and east desert ranges are typically smaller by 30 percent. Females are slightly smaller and their horns tend to grow to 0.2 m (7.9 in). Males have a dark brown summer coat, while the females have a more reddish-gold, and both sexes shift to a gray-colored coat in winter. Both sexes also have a tuft of hair extending from the chin. The ibexes have a black stripe from the spine that extends over the shoulder, limbs, and neck.", "description": "Calculus found in the stomach of animals, used as an antidote."}}, {"canonical_name": "gemms", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "gemms", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "gemms", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["gemms", "Gemms"], "contexts": ["precious stones", "precious stones, like other gemms"]}, {"entity_id": "gem", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Gem", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Gem"], "contexts": ["precious stone"]}, {"entity_id": "gemmis", "book_id": "polyanthea_medicinal", "name": "gemmis", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["gemmis"], "contexts": ["gems, believed to have virtues"]}, {"entity_id": "gems", "book_id": "connexion_physical_sciences_somerville_1858", "name": "gems", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["gems"], "contexts": ["paramagnetic substances"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "gemms", "target_book": "polyanthea_medicinal", "target_name": "gemmis", "similarity": 0.98}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "gemms", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gems", "similarity": 0.97}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gem", "target_book": "polyanthea_medicinal", "target_name": "gemmis", "similarity": 0.895}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gem", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gems", "similarity": 0.935}, {"source_book": "polyanthea_medicinal", "source_name": "gemmis", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gems", "similarity": 0.939}], "id": 1580, "stable_key": "clu_7627f3710ef49a36", "ground_truth": {"modern_name": "Gems", "confidence": "high", "type": "mineral", "note": "Refers to precious stones.", "wikidata_id": "Q83437", "wikidata_description": "piece of mineral used to make jewelry", "wikipedia_url": "https://en.wikipedia.org/wiki/Gemstone", "wikipedia_extract": "A gemstone (also called a fine gem, jewel, precious stone, semiprecious stone, or simply gem) is a piece of mineral crystal which, when cut or polished, is used to make jewelry or other adornments. Certain rocks (such as lapis lazuli, opal, and obsidian) and occasionally organic materials that are not minerals (such as amber, jet, and pearl) may also be used for jewelry and are therefore often considered to be gemstones as well. Most gemstones are hard, but some softer minerals such as brazilianite may be used in jewelry because of their color or luster or other physical properties that have aesthetic value. However, generally speaking, soft minerals are not typically used as gemstones by virtue of their brittleness and lack of durability. Found all over the world, the industry of coloured gemstones (i.e. anything other than diamonds) is currently estimated at US$1.55 billion as of 2023 and is projected to steadily increase to a value of $4.46 billion by 2033."}}, {"canonical_name": "contradiction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "contradiction", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "contradiction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["contradiction", "Contradiction"], "contexts": ["opposition to ideas", "opposition to an idea"]}, {"entity_id": "contradiction", "book_id": "principles_of_psychology_james_1890", "name": "contradiction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["contradiction"], "contexts": ["logical inconsistency", "relationship of opposition between statements"]}, {"entity_id": "contradictions", "book_id": "principles_of_psychology_james_1890", "name": "contradictions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["contradictions"], "contexts": ["statements or ideas that are opposed"]}, {"entity_id": "contradictories", "book_id": "first_principles_spencer_1862", "name": "contradictories", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["contradictories"], "contexts": ["mutually exclusive concepts"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "contradiction", "target_book": "principles_of_psychology_james_1890", "target_name": "contradiction", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "contradiction", "target_book": "principles_of_psychology_james_1890", "target_name": "contradictions", "similarity": 0.942}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "contradiction", "target_book": "first_principles_spencer_1862", "target_name": "contradictories", "similarity": 0.931}, {"source_book": "principles_of_psychology_james_1890", "source_name": "contradiction", "target_book": "first_principles_spencer_1862", "target_name": "contradictories", "similarity": 0.931}, {"source_book": "principles_of_psychology_james_1890", "source_name": "contradictions", "target_book": "first_principles_spencer_1862", "target_name": "contradictories", "similarity": 0.985}], "id": 1581, "stable_key": "clu_8918a7f3b3cd47a1", "ground_truth": {"modern_name": "contradiction", "confidence": "high", "type": "concept", "wikidata_id": "Q27719030", "wikidata_description": "academic journal"}}, {"canonical_name": "Liege", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "liege", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Liege", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Liege"], "contexts": ["city where Mandevil died"]}, {"entity_id": "li\u00e8ge", "book_id": "principles_of_psychology_james_1890", "name": "Li\u00e8ge", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Li\u00e8ge"], "contexts": ["city in Belgium"]}, {"entity_id": "liege", "book_id": "kosmos_humboldt_1845", "name": "Liege", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Liege"], "contexts": ["city in Belgium", "location of a coal basin"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Liege", "target_book": "principles_of_psychology_james_1890", "target_name": "Li\u00e8ge", "similarity": 0.756}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Liege", "target_book": "kosmos_humboldt_1845", "target_name": "Liege", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Li\u00e8ge", "target_book": "kosmos_humboldt_1845", "target_name": "Liege", "similarity": 0.756}], "id": 1582, "stable_key": "clu_a2aad49004ee726d", "ground_truth": {"wikipedia_extract": "Li\u00e8ge ( lee-EZH, lee-AYZH; French: [lj\u025b\u0292] ; Walloon: L\u00eedje [li\u02d0t\u0283]; Dutch: Luik [l\u0153yk] ; German: L\u00fcttich [\u02c8l\u028ft\u026a\u00e7] ) is a city and municipality in the Belgian region of Wallonia, and the capital of the eponymous province. The city is situated in the valley of the Meuse, in the east of Belgium, not far from borders with the Netherlands (Maastricht is about 33 km (20.5 mi) to the north) and with Germany (Aachen is about 53 km (32.9 mi) north-east). In Li\u00e8ge, the Meuse meets the river Ourthe. The city is part of the sillon industriel, the former industrial backbone of Wallonia. It is still the principal economic and cultural centre of the region. The municipality consists of the following sections (sub-municipalities): Li\u00e8ge proper, Angleur, Bressoux, Ch\u00ean\u00e9e, Glain, Grivegn\u00e9e, Jupille-sur-Meuse, Rocourt, and Wandre."}}, {"canonical_name": "Rye", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "rye", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Rye", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Rye"], "contexts": ["plant whose straws are attracted", "grain with poisonous ears"]}, {"entity_id": "rye", "book_id": "english_physician_1652", "name": "Rye", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Rye"], "contexts": ["location near Appledore where Devils-bit is found", "city in Kent"]}, {"entity_id": "rye", "book_id": "first_principles_spencer_1862", "name": "rye", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["rye"], "contexts": ["agricultural staple crop"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Rye", "target_book": "english_physician_1652", "target_name": "Rye", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Rye", "target_book": "first_principles_spencer_1862", "target_name": "rye", "similarity": 0.982}, {"source_book": "english_physician_1652", "source_name": "Rye", "target_book": "first_principles_spencer_1862", "target_name": "rye", "similarity": 0.982}], "id": 1583, "stable_key": "clu_8664fc638af1b205", "ground_truth": {"modern_name": "Rye", "confidence": "high", "type": "plant", "linnaean": "Secale cereale Linnaeus", "family": "Poaceae", "note": "The term 'seigle' is French for rye. The mention of 'Seseli' in the Florentine Ricettario suggests a potential ambiguity, as Seseli is a genus of herbs. However, the context of 'grain' strongly points to rye.", "wikidata_id": "Q12099", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Rye", "wikipedia_extract": "Rock and Rye is a term (both generically and brand names) for a bottled liqueur or mixed cocktail composed of rye whiskey and rock candy (crystallized sugar) or fruit. As early as 1914, United States government publications discuss disputes regarding beverages labeled \"rock and rye\", including a case of a beverage so marketed which was found by the Bureau of Chemistry to consist of \"water, sugar, glucose, and artificial coloring matters, sold in imitation of a rock and rye cordial\". Among non-alcoholic beverages, Rock and Rye continues to be a popular flavor of the Faygo brand of soda pop. Related products mentioned in the early 20th century include Rock and Rum and Rock and Gin. Slow & Low produced by Hochstadter's since 1884 produces a Rock & Rye drink that according to the label is \"served straight and as a proper old-fashioned since the 1800's Rock and Rye Union Made with Straight rye Whiskey Raw Honey, Navel Orange, Rock Candy and Bitters.\" It is 84 Proof Produced by Hochstadter's from Scobyville, NJ. In the film National Lampoon's Animal House, Boon (Peter Riegert) orders a \"double Rock and Rye and seven Carlings\" at a bar."}}, {"canonical_name": "Bread", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "bread", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Bread", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Bread"], "contexts": ["staple food"]}, {"entity_id": "bread", "book_id": "english_physician_1652", "name": "Bread", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["Bread", "bread"], "contexts": ["food eaten with onions", "used with parsley leaves for eyes"]}, {"entity_id": "bread", "book_id": "connexion_physical_sciences_somerville_1858", "name": "bread", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["bread"], "contexts": ["diamagnetic substance"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bread", "target_book": "english_physician_1652", "target_name": "Bread", "similarity": 0.865}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bread", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "bread", "similarity": 0.959}, {"source_book": "english_physician_1652", "source_name": "Bread", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "bread", "similarity": 0.812}], "id": 1584, "stable_key": "clu_1e7e77b05731f2c8", "ground_truth": {"modern_name": "Bread", "confidence": "high", "type": "chemical", "note": "While bread is a food, its properties were discussed in early modern scientific texts, particularly its diamagnetic properties.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "Substance theory, or substance\u2013attribute theory, is an ontological theory positing that objects are constituted each by a substance and properties borne by the substance but distinct from it. In this role, a substance can be referred to as a substratum or a thing-in-itself. Substances are particulars that are ontologically independent: they are able to exist all by themselves. Another defining feature often attributed to substances is their ability to undergo changes. Changes involve something existing before, during and after the change. They can be described in terms of a persisting substance gaining or losing properties.", "wikipedia_url": "https://en.wikipedia.org/wiki/Substance_theory"}}, {"canonical_name": "Constitution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "constitution", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Constitution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Constitution"], "contexts": ["inherent nature or makeup"]}, {"entity_id": "constitution", "book_id": "origin_of_species_darwin_1859", "name": "constitution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["constitution"], "contexts": ["innate wide flexibility", "correlated with colour in animals"]}, {"entity_id": "constitution", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Constitution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["constitution", "Constitution"], "contexts": ["composition or structure", "composition or nature of the Moon"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Constitution", "target_book": "origin_of_species_darwin_1859", "target_name": "constitution", "similarity": 0.96}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Constitution", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Constitution", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "constitution", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Constitution", "similarity": 0.96}], "id": 1585, "stable_key": "clu_bd35bff3e19c74c9", "ground_truth": {"modern_name": "Constitution", "confidence": "high", "type": "concept", "note": "Refers to the inherent nature or structure of a thing, particularly in biology and philosophy."}}, {"canonical_name": "Eratosthenes", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "eratosthenes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Eratosthenes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Eratosthenes"], "contexts": ["ancient scholar"]}, {"entity_id": "eratosthenes", "book_id": "kosmos_humboldt_1845", "name": "Eratosthenes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Eratosthenes"], "contexts": ["ancient Greek mathematician and geographer", "ancient geographer"]}, {"entity_id": "eratosthenes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Eratosthenes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Eratosthenes"], "contexts": ["first to estimate earth's circumference", "ancient Greek scholar who measured Earth's circumference"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Eratosthenes", "target_book": "kosmos_humboldt_1845", "target_name": "Eratosthenes", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Eratosthenes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Eratosthenes", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Eratosthenes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Eratosthenes", "similarity": 1.0}], "id": 1586, "stable_key": "clu_1377eff9f29a49ed", "ground_truth": {"modern_name": "Eratosthenes", "confidence": "high", "type": "person", "birth_year": -276, "death_year": -194, "description": "Ancient Greek mathematician, geographer, and astronomer; estimated Earth's circumference."}}, {"canonical_name": "Wales", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "wales", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Wales", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Wales"], "contexts": ["location with portable leather boats"]}, {"entity_id": "wales", "book_id": "english_physician_1652", "name": "Wales", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Wales", "wales"], "contexts": ["country where Bishops-weed grows wild", "country"]}, {"entity_id": "wales", "book_id": "origin_of_species_darwin_1859", "name": "Wales", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Wales"], "contexts": ["country with scored mountains from ice", "mountains with scored flanks and polished surfaces"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Wales", "target_book": "english_physician_1652", "target_name": "Wales", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Wales", "target_book": "origin_of_species_darwin_1859", "target_name": "Wales", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Wales", "target_book": "origin_of_species_darwin_1859", "target_name": "Wales", "similarity": 1.0}], "id": 1587, "stable_key": "clu_2455f0e1c8092419", "ground_truth": {"modern_name": "Wales", "confidence": "high", "type": "place", "description": "A country forming part of the United Kingdom.", "wikipedia_extract": "Wales (Welsh: Cymru [\u02c8k\u0259mr\u0268] ) is a country that is part of the United Kingdom. Located on the island of Great Britain, it is bordered by the Irish Sea to the north and west, England to the east, the Bristol Channel to the south, and the Celtic Sea to the south-west. As of 2021, it had a population of 3.2 million. It has a total area of 21,218 square kilometres (8,192 sq mi) and over 2,700 kilometres (1,680 mi) of coastline. It is largely mountainous with its higher peaks in the north and central areas, including Snowdon (Yr Wyddfa), its highest summit. The country lies within the north temperate zone and has a changeable, maritime climate."}}, {"canonical_name": "cansa\u00e7o", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "lassitudes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "lassitudes", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["lassitudes"], "contexts": ["feelings of weariness or exhaustion"]}, {"entity_id": "cansanzio", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "cansanzio", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["cansanzio"], "contexts": ["fatigue alleviated by decoction"]}, {"entity_id": "fatiga", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "fatiga", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["fatiga"], "contexts": ["weariness mitigated by decoction"]}, {"entity_id": "cansa\u00e7o", "book_id": "polyanthea_medicinal", "name": "cansa\u00e7o", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["cansa\u00e7o"], "contexts": ["symptom of fatigue", "fatigue, symptom"]}, {"entity_id": "fadiga", "book_id": "polyanthea_medicinal", "name": "fadiga", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["fadiga"], "contexts": ["fatigue"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "lassitudes", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "cansanzio", "similarity": 0.897}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "lassitudes", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "fatiga", "similarity": 0.899}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "lassitudes", "target_book": "polyanthea_medicinal", "target_name": "cansa\u00e7o", "similarity": 0.887}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "lassitudes", "target_book": "polyanthea_medicinal", "target_name": "fadiga", "similarity": 0.917}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cansanzio", "target_book": "polyanthea_medicinal", "target_name": "cansa\u00e7o", "similarity": 0.895}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cansanzio", "target_book": "polyanthea_medicinal", "target_name": "fadiga", "similarity": 0.9}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "fatiga", "target_book": "polyanthea_medicinal", "target_name": "cansa\u00e7o", "similarity": 0.962}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "fatiga", "target_book": "polyanthea_medicinal", "target_name": "fadiga", "similarity": 0.931}], "id": 1588, "stable_key": "clu_3b9524d6508e5173", "ground_truth": {"modern_name": "Fatigue", "confidence": "high", "type": "disease", "modern_term": "Fatigue", "wikidata_id": "Q209733", "wikidata_description": "medical condition involving extreme fatigue and a wide range of other symptoms", "wikipedia_url": "https://en.wikipedia.org/wiki/Myalgic%20encephalomyelitis/chronic%20fatigue%20syndrome"}}, {"canonical_name": "apes", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "apes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Apes", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Apes"], "contexts": ["animals with proximity of reason"]}, {"entity_id": "apes", "book_id": "principles_of_psychology_james_1890", "name": "apes", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 4, "variants": ["apes"], "contexts": ["primates with highly complex nervous systems", "animal with hardly any lower brain centers"]}, {"entity_id": "apes", "book_id": "kosmos_humboldt_1845", "name": "apes", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["apes"], "contexts": ["mammals inhabiting Kashmir chestnut-tree"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Apes", "target_book": "principles_of_psychology_james_1890", "target_name": "apes", "similarity": 0.862}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Apes", "target_book": "kosmos_humboldt_1845", "target_name": "apes", "similarity": 0.736}, {"source_book": "principles_of_psychology_james_1890", "source_name": "apes", "target_book": "kosmos_humboldt_1845", "target_name": "apes", "similarity": 0.788}], "id": 1589, "stable_key": "clu_64ac64edfcd431ba", "ground_truth": {"modern_name": "Apes", "confidence": "low", "type": "animal", "note": "The context is contradictory. 'apes' usually refers to primates. However, 'Apis' is a genus of bees and is also contextually linked to a deity represented by a bull. Given the early modern scientific context and the mention of Kashmir, it is most likely referring to primates (apes). The mention of 'Apis' might be an OCR error or a very obscure secondary reference.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "The Hominidae (; hominids ), whose members are known as the great apes, are a taxonomic family of primates that includes eight extant species in four genera: Pongo (the Bornean, Sumatran and Tapanuli orangutan); Gorilla (the eastern and western gorilla); Pan (the chimpanzee and the bonobo); and Homo, of which only modern humans (Homo sapiens) remain. Numerous revisions in classifying the great apes have caused the use of the term hominid to change over time. The original meaning of \"hominid\" referred only to humans (Homo) and their closest extinct relatives. However, by the 1990s humans and other apes were considered to be \"hominids\". The earlier restrictive meaning has now been largely assumed by the term hominin, which however additionally includes Pan. Hominins more closely related to humans than to Pan are called Hominina, while the current meaning of \"hominid\" includes all the great apes including humans.", "wikipedia_url": "https://en.wikipedia.org/wiki/Hominidae"}}, {"canonical_name": "Torpedo", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "torpedo", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Torpedo", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["Torpedo"], "contexts": ["fish that stupifies when alive"]}, {"entity_id": "torpedo", "book_id": "polyanthea_medicinal", "name": "Torpedo", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["Torpedo"], "contexts": ["fish that causes numbness", "an animal mentioned"]}, {"entity_id": "torpedo", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Torpedo", "category": "ANIMAL", "subcategory": "FISH", "count": 2, "variants": ["torpedo", "Torpedo"], "contexts": ["genus of ray with electrical action", "fish with electrical action"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Torpedo", "target_book": "polyanthea_medicinal", "target_name": "Torpedo", "similarity": 0.799}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Torpedo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Torpedo", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Torpedo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Torpedo", "similarity": 0.799}], "id": 1590, "stable_key": "clu_588bd2c730454e49", "ground_truth": {"modern_name": "Electric ray", "confidence": "high", "type": "animal", "note": "The term 'Torpedo' in early modern texts often referred to electric rays (family Torpedinidae) known for their electric shock capabilities.", "wikidata_id": "Q41317", "wikidata_description": "order of fishes", "wikipedia_url": "https://en.wikipedia.org/wiki/Electric%20ray", "wikipedia_extract": "The electric rays are a group of rays, flattened cartilaginous fish with enlarged pectoral fins, composing the order Torpediniformes . They are known for being capable of producing an electric discharge, ranging from 8 to 220 volts, depending on species, used to stun prey and for defense. There are 69 species in four families. Perhaps the best known members are those of the genus Torpedo. The torpedo undersea weapon is named after it. The name comes from the Latin torpere, 'to be stiffened or paralyzed', from the effect on someone who touches the fish."}}, {"canonical_name": "medium", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "medium", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "medium", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["medium"], "contexts": ["substance through which rays pass"]}, {"entity_id": "medium", "book_id": "connexion_physical_sciences_somerville_1858", "name": "medium", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["medium"], "contexts": ["substance filling space, possibly ether", "substance transmitting forces"]}, {"entity_id": "media", "book_id": "connexion_physical_sciences_somerville_1858", "name": "media", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["media"], "contexts": ["intermediate substances"]}, {"entity_id": "medium", "book_id": "first_principles_spencer_1862", "name": "medium", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["medium"], "contexts": ["surrounding environment for heat exchange"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "medium", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "medium", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "medium", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "media", "similarity": 0.93}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "medium", "target_book": "first_principles_spencer_1862", "target_name": "medium", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "medium", "target_book": "first_principles_spencer_1862", "target_name": "medium", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "media", "target_book": "first_principles_spencer_1862", "target_name": "medium", "similarity": 0.93}], "id": 1591, "stable_key": "clu_5e9cdee04e89866b", "ground_truth": {"modern_name": "Medium", "confidence": "high", "type": "concept", "note": "This refers to the substance or space through which a phenomenon (like light or sound) propagates, or an intermediate substance in a process."}}, {"canonical_name": "dores dos olhos", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "sore_eyes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "sore eyes", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["sore eyes"], "contexts": ["eyes affected by inflammation"]}, {"entity_id": "sore_eyes", "book_id": "english_physician_1652", "name": "sore Eyes", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["sore Eyes"], "contexts": ["symptom of eye irritation"]}, {"entity_id": "dores_dos_olhos", "book_id": "polyanthea_medicinal", "name": "dores dos olhos", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 4, "variants": ["dores dos olhos", "dor de olhos", "doresdos olhos"], "contexts": ["pains in the eyes", "eye pains treated by Alcae\u017ft"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sore eyes", "target_book": "english_physician_1652", "target_name": "sore Eyes", "similarity": 0.984}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sore eyes", "target_book": "polyanthea_medicinal", "target_name": "dores dos olhos", "similarity": 0.908}, {"source_book": "english_physician_1652", "source_name": "sore Eyes", "target_book": "polyanthea_medicinal", "target_name": "dores dos olhos", "similarity": 0.908}], "id": 1592, "stable_key": "clu_42f0b6bdbd169efd", "ground_truth": {"modern_name": "Eye pain", "confidence": "high", "type": "disease", "modern_term": "Ophthalmological pain", "note": "The Portuguese 'dores dos olhos' directly translates to 'pains of the eyes', and the English 'sore eyes' refers to irritation or pain in the eyes.", "wikidata_id": "Q21077147", "wikidata_description": "medical symptom", "wikipedia_url": "https://en.wikipedia.org/wiki/Eye%20pain", "wikipedia_extract": "Eye pain, also called ophthomalgia or ocular pain, is a nonspecific term for pain in one or both eyes, around the eyes, or behind the eyes. It may encompass minor eye irritation, aching, or burning sensation to intense and prolonged pain. Eye pain is a common complaint and a major driver of patient visits to both emergency departments and out-patient clinics, generally ophthalmology or neurology clinics. Between 2008 and 2019, there were 1 million emergency department visits and 4.6 million outpatient visits attributed to eye pain. Pain can occur in almost any part of the eye, including the eyelid, conjunctiva, sclera, cornea, or orbit (eye socket). Sensation of pain may be accompanied with swelling, throbbing or pressure, a stabbing or shooting pain, and/or the sensation of a foreign body in the eye."}}, {"canonical_name": "Partridge", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "partridges", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Partridges", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Partridges"], "contexts": ["birds whose eggs hatch under a hen"]}, {"entity_id": "partridge", "book_id": "origin_of_species_darwin_1859", "name": "Partridge", "category": "ANIMAL", "subcategory": "BIRD", "count": 3, "variants": ["partridge", "Partridge"], "contexts": ["terrestrial bird", "bird from which earth was collected"]}, {"entity_id": "partridges", "book_id": "origin_of_species_darwin_1859", "name": "partridges", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["partridges"], "contexts": ["game birds"]}, {"entity_id": "partridge", "book_id": "first_principles_spencer_1862", "name": "partridge", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["partridge"], "contexts": ["bird found in fields"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Partridges", "target_book": "origin_of_species_darwin_1859", "target_name": "Partridge", "similarity": 0.93}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Partridges", "target_book": "origin_of_species_darwin_1859", "target_name": "partridges", "similarity": 0.973}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Partridges", "target_book": "first_principles_spencer_1862", "target_name": "partridge", "similarity": 0.897}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Partridge", "target_book": "first_principles_spencer_1862", "target_name": "partridge", "similarity": 0.975}, {"source_book": "origin_of_species_darwin_1859", "source_name": "partridges", "target_book": "first_principles_spencer_1862", "target_name": "partridge", "similarity": 0.922}], "id": 1593, "stable_key": "clu_e94e7b3fbf380929-2", "ground_truth": {"modern_name": "partridge", "confidence": "high", "type": "animal", "wikidata_id": "Q93235", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Vaccinium%20vitis-idaea", "wikipedia_extract": "A partridge is a medium-sized galliform bird in any of several genera, with a wide native distribution throughout parts of Europe, Asia and Africa. Several species have been introduced to the Americas. They are sometimes grouped in the Perdicinae subfamily of the Phasianidae (pheasants, quail, etc.). However, molecular research suggests that partridges are not a distinct taxon within the superfamily Phasianoidea, but that some species are closer to the pheasants, while others are closer to the junglefowl. Partridges are medium-sized game birds, generally intermediate in size between the larger pheasants and smaller quail; they're ground-dwelling birds that feature variable plumage colouration across species, with most tending to grey and brown. Partridges are native to Europe, Asia, Africa, and the Middle East.", "description": "A game bird, often prepared as food."}}, {"canonical_name": "colour", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "colour", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "colour", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["colour"], "contexts": ["visual characteristic"]}, {"entity_id": "colour", "book_id": "english_physician_1652", "name": "colour", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["colour"], "contexts": ["indicator of herb freshness"]}, {"entity_id": "colour", "book_id": "origin_of_species_darwin_1859", "name": "colour", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["colour"], "contexts": ["goes with constitutional peculiarities", "correlated with constitution and fly attacks"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "colour", "target_book": "english_physician_1652", "target_name": "colour", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "colour", "target_book": "origin_of_species_darwin_1859", "target_name": "colour", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "colour", "target_book": "origin_of_species_darwin_1859", "target_name": "colour", "similarity": 1.0}], "id": 1594, "stable_key": "clu_47296163f0ec0df4-2", "ground_truth": {"modern_name": "color", "confidence": "high", "type": "concept", "wikidata_id": "Q1261", "wikidata_description": "state of the United States of America", "wikipedia_url": "https://en.wikipedia.org/wiki/Color", "note": "The context in 'principles_of_psychology_james_1890' and 'relation_historique_humboldt_vol3_1825' might lean towards pigments or optical phenomena, but 'color' as a general concept covers these.", "wikipedia_extract": "Color (or colour in Commonwealth English; see spelling differences) is the visual perception based on the electromagnetic spectrum. Though color is not an inherent property of matter, color perception is related to an object's light absorption, emission, reflection and transmission. For most humans, visible wavelengths of light are the ones perceived in the visible light spectrum, with three types of cone cells (trichromacy). Other animals may have a different number of cone cell types or have eyes sensitive to different wavelengths, such as bees that can distinguish ultraviolet, and thus have a different color sensitivity range. Animal perception of color originates from different light wavelength or spectral sensitivity in cone cell types, which is then processed by the brain. Colors have perceived properties such as hue, colorfulness, and lightness."}}, {"canonical_name": "translation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "translations", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Translations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Translations"], "contexts": ["different versions of scripture"]}, {"entity_id": "translation", "book_id": "principles_of_psychology_james_1890", "name": "translation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["translation"], "contexts": ["conversion from one form to another"]}, {"entity_id": "translate", "book_id": "principles_of_psychology_james_1890", "name": "translate", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["translate"], "contexts": ["interpret or convert information"]}, {"entity_id": "translation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "translation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Translation", "translation"], "contexts": ["movement through space", "general motion of stars"]}, {"entity_id": "translated", "book_id": "connexion_physical_sciences_somerville_1858", "name": "translated", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["translated"], "contexts": ["carried forward in space"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Translations", "target_book": "principles_of_psychology_james_1890", "target_name": "translation", "similarity": 0.916}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Translations", "target_book": "principles_of_psychology_james_1890", "target_name": "translate", "similarity": 0.883}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Translations", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "translation", "similarity": 0.916}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Translations", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "translated", "similarity": 0.89}, {"source_book": "principles_of_psychology_james_1890", "source_name": "translation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "translation", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "translation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "translated", "similarity": 0.905}, {"source_book": "principles_of_psychology_james_1890", "source_name": "translate", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "translation", "similarity": 0.949}, {"source_book": "principles_of_psychology_james_1890", "source_name": "translate", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "translated", "similarity": 0.94}], "id": 1595, "stable_key": "clu_394b791b014020c3", "ground_truth": {"modern_name": "translation", "confidence": "high", "type": "concept", "wikidata_id": "Q7553", "wikidata_description": "statement that explains the meaning of a word, phrase, concept, or idea", "wikipedia_url": "https://en.wikipedia.org/wiki/Translation", "wikipedia_extract": "Translation in the field of language is the communication of the meaning of a source-language text by means of an equivalent target-language text (also called 'receptor language'). The English language draws a terminological distinction (which does not exist in every language) between translating (a written text) and interpreting (oral or signed communication between users of different languages); under this distinction, translation can begin only after the appearance of writing within a language community. A translator always risks inadvertently introducing source-language words, grammar, or syntax into the target-language rendering. On the other hand, such \"spill-overs\" have sometimes imported useful source-language calques and loanwords that have enriched target languages. Because of the laboriousness of the translation process, since the 1940s efforts have been made, with varying degrees of success, to automate translation or to mechanically aid the human translator. More recently, the rise of the Internet has fostered a world-wide market for translation services and has facilitated \"language localisation\"."}}, {"canonical_name": "\u00c9gypte", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "\u00e6gypt", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "\u00c6gypt", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["\u00c6gypt"], "contexts": ["ancient Egypt"]}, {"entity_id": "\u00e9gypte", "book_id": "epoques_nature_buffon_1778", "name": "\u00c9gypte", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["\u00c9gypte"], "contexts": ["ancient country with pyramids", "country in Northeast Africa"]}, {"entity_id": "aegypt", "book_id": "english_physician_1652", "name": "AEgypt", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["AEgypt"], "contexts": ["destination for diseases"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "\u00c6gypt", "target_book": "epoques_nature_buffon_1778", "target_name": "\u00c9gypte", "similarity": 0.987}, {"source_book": "epoques_nature_buffon_1778", "source_name": "\u00c9gypte", "target_book": "english_physician_1652", "target_name": "AEgypt", "similarity": 0.98}], "id": 1596, "stable_key": "clu_ec0c37f7a627f6b2", "ground_truth": {"modern_name": "Egypt", "confidence": "high", "type": "place", "country": "Egypt", "wikidata_id": "Q79", "wikidata_description": "country in Northeast Africa and Southwest Asia", "wikipedia_url": "https://en.wikipedia.org/wiki/Egypt"}}, {"canonical_name": "mer Glaciale", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "mer_glaciale", "book_id": "epoques_nature_buffon_1778", "name": "mer Glaciale", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["mer Glaciale"], "contexts": ["Arctic Ocean", "Arctic Ocean north of Asia"]}, {"entity_id": "glacial_sea", "book_id": "kosmos_humboldt_1845", "name": "glacial sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["glacial sea"], "contexts": ["vast area swept by ice during an epoch", "sea during the glacial epoch"]}, {"entity_id": "glacial_sea", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Glacial Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Glacial Sea"], "contexts": ["northern boundary of Russian arc"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "mer Glaciale", "target_book": "kosmos_humboldt_1845", "target_name": "glacial sea", "similarity": 0.892}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mer Glaciale", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Glacial Sea", "similarity": 0.944}, {"source_book": "kosmos_humboldt_1845", "source_name": "glacial sea", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Glacial Sea", "similarity": 0.931}], "id": 1597, "stable_key": "clu_9700c3183278ecea", "ground_truth": {"modern_name": "Glacial Sea", "confidence": "high", "type": "place", "country": "Global", "wikidata_id": "Q788", "wikidata_description": "smallest, shallowest, coldest, and northernmost of the world's major oceans", "wikipedia_url": "https://en.wikipedia.org/wiki/Arctic%20Ocean", "wikipedia_extract": "The Arctic Ocean is the smallest and shallowest of the world's five oceanic divisions. It spans an area of approximately 14,060,000 km2 (5,430,000 sq mi) and is the coldest of the world's oceans. The International Hydrographic Organization (IHO) recognizes it as an ocean, although some oceanographers call it the Arctic Mediterranean Sea or North Polar Sea. It has also been described as an estuary of the Atlantic Ocean. It is also seen as the northernmost part of the all-encompassing world ocean. The Arctic Ocean includes the North Pole region in the middle of the Northern Hemisphere and extends south to about 60\u00b0N."}}, {"canonical_name": "Grecs", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "grecs", "book_id": "epoques_nature_buffon_1778", "name": "Grecs", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Grecs"], "contexts": ["ancient people known for astronomy", "people who worked on new astronomy"]}, {"entity_id": "grecques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "grecques", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["grecques"], "contexts": ["ancient civilization"]}, {"entity_id": "hellenic_peninsula", "book_id": "kosmos_humboldt_1845", "name": "Hellenic peninsula", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Hellenic peninsula"], "contexts": ["peninsula in Europe"]}, {"entity_id": "hellenic_nations", "book_id": "kosmos_humboldt_1845", "name": "Hellenic nations", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Hellenic nations"], "contexts": ["nations known for intellectual cultivation"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Grecs", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "grecques", "similarity": 0.974}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Grecs", "target_book": "kosmos_humboldt_1845", "target_name": "Hellenic peninsula", "similarity": 0.897}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Grecs", "target_book": "kosmos_humboldt_1845", "target_name": "Hellenic nations", "similarity": 0.945}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "grecques", "target_book": "kosmos_humboldt_1845", "target_name": "Hellenic peninsula", "similarity": 0.895}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "grecques", "target_book": "kosmos_humboldt_1845", "target_name": "Hellenic nations", "similarity": 0.939}], "id": 1598, "stable_key": "clu_094b0b395dfc4d47", "ground_truth": {"modern_name": "Ancient Greece", "confidence": "high", "type": "place", "country": "Greece", "wikidata_id": "Q11772", "wikidata_description": "Greek civilization from 1200 BC to 600 AD", "wikipedia_url": "https://en.wikipedia.org/wiki/Ancient%20Greece"}}, {"canonical_name": "Mundo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "monde", "book_id": "epoques_nature_buffon_1778", "name": "monde", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["monde"], "contexts": ["the Earth and its inhabitants", "a new world discovered by humans"]}, {"entity_id": "monde", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Monde", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Monde"], "contexts": ["global circumnavigation"]}, {"entity_id": "mundo", "book_id": "historia_medicinal_monardes_1574", "name": "Mundo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Mundo", "Nueuo mundo", "mundo"], "contexts": ["created with metals within", "The world, as a geographical entity"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "monde", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Monde", "similarity": 0.977}, {"source_book": "epoques_nature_buffon_1778", "source_name": "monde", "target_book": "historia_medicinal_monardes_1574", "target_name": "Mundo", "similarity": 0.975}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Monde", "target_book": "historia_medicinal_monardes_1574", "target_name": "Mundo", "similarity": 0.971}], "id": 1599, "stable_key": "clu_b199acae0a826eca-2", "ground_truth": {"modern_name": "World", "confidence": "high", "type": "place", "wikidata_id": "Q189289", "wikidata_description": "international sport governing body", "wikipedia_url": "https://en.wikipedia.org/wiki/World%20Aquatics", "wikipedia_extract": "World Aquatics, formerly known as FINA (French: F\u00e9d\u00e9ration internationale de natation; English: International Swimming Federation), is the international federation recognised by the International Olympic Committee (IOC) for administering international competitions in water sports. It is one of several international federations which administer a given sport or discipline for both the IOC and the international community. It is based in Lausanne, Switzerland. Founded as FINA (F\u00e9d\u00e9ration internationale de natation; International Swimming Federation) in 1908, the federation was officially renamed World Aquatics in January 2023. World Aquatics currently oversees competition in six aquatics sports: artistic swimming, water polo, and open water swimming. World Aquatics also oversees Masters competition (for competitors aged 18 years and older) in its disciplines and also hosts the World Aquatics Masters Championships (for competitors aged 25 years and older)."}}, {"canonical_name": "solar light", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "lumi\u00e8re_du_soleil", "book_id": "epoques_nature_buffon_1778", "name": "lumi\u00e8re du soleil", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["lumi\u00e8re du soleil"], "contexts": ["sunlight"]}, {"entity_id": "solar_light", "book_id": "kosmos_humboldt_1845", "name": "solar light", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["solar light"], "contexts": ["whether solar light emanates"]}, {"entity_id": "solar_light", "book_id": "connexion_physical_sciences_somerville_1858", "name": "solar light", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["solar light"], "contexts": ["light from the sun"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "lumi\u00e8re du soleil", "target_book": "kosmos_humboldt_1845", "target_name": "solar light", "similarity": 0.948}, {"source_book": "epoques_nature_buffon_1778", "source_name": "lumi\u00e8re du soleil", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "solar light", "similarity": 0.948}, {"source_book": "kosmos_humboldt_1845", "source_name": "solar light", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "solar light", "similarity": 1.0}], "id": 1600, "stable_key": "clu_c61fb93ef3228773", "ground_truth": {"modern_name": "Sunlight", "confidence": "high", "type": "concept", "note": "The phrases 'solar light' and 'Sun\u2019s substance' all refer to light originating from the sun.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Cabo de Boa Esperan\u00e7a", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "cap_de_bonne-esp\u00e9rance", "book_id": "epoques_nature_buffon_1778", "name": "cap de Bonne-Esp\u00e9rance", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["cap de Bonne-Esp\u00e9rance"], "contexts": ["geographic location in Africa"]}, {"entity_id": "cap_de_bonne-esperance", "book_id": "relation_historique_humboldt_vol3_1825", "name": "cap de Bonne-Esperance", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["cap de Bonne-Esperance", "Bonne-Esp\u00e9rance"], "contexts": ["cape at southern tip of Africa", "cape for navigation"]}, {"entity_id": "cabo_de_boa_esperan\u00e7a", "book_id": "coloquios_da_orta_1563", "name": "Cabo de Boa Esperan\u00e7a", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Cabo de Boa Esperan\u00e7a", "Boa Esperan\u00e7a", "cabo da Boa Esperan\u00e7a"], "contexts": ["cape, geographical reference", "geographical landmark"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "cap de Bonne-Esp\u00e9rance", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "cap de Bonne-Esperance", "similarity": 0.99}, {"source_book": "epoques_nature_buffon_1778", "source_name": "cap de Bonne-Esp\u00e9rance", "target_book": "coloquios_da_orta_1563", "target_name": "Cabo de Boa Esperan\u00e7a", "similarity": 0.907}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "cap de Bonne-Esperance", "target_book": "coloquios_da_orta_1563", "target_name": "Cabo de Boa Esperan\u00e7a", "similarity": 0.888}], "id": 1601, "stable_key": "clu_8489b5cddb68c745-2", "ground_truth": {"modern_name": "Cape of Good Hope", "confidence": "high", "type": "place", "country": "South Africa", "wikidata_id": "Q370736", "wikidata_description": "Dutch and British colony in Southern Africa", "wikipedia_url": "https://en.wikipedia.org/wiki/Cape%20Colony", "wikipedia_extract": "The Cape Colony (Dutch: Kaapkolonie), also known as the Cape of Good Hope, was a British colony in present-day South Africa named after the Cape of Good Hope. It existed from 1795 to 1802, and again from 1806 to 1910, when it united with three other colonies to form the Union of South Africa, then became the Cape Province, which existed even after 1961, when South Africa had become a republic, albeit temporarily outside the Commonwealth of Nations (1961\u201394). The British colony was preceded by an earlier corporate colony that became an original Dutch colony of the same name, which was established in 1652 by the Dutch East India Company (VOC). The Cape was under VOC rule from 1652 to 1795 and under rule of the Napoleonic Batavia Republic from 1803 to 1806. The VOC lost the colony to Great Britain following the 1795 Battle of Muizenberg, but it was ceded to the Batavia Republic following the 1802 Treaty of Amiens. It was re-occupied by the British following the Battle of Blaauwberg in 1806, and British possession affirmed with the Anglo-Dutch Treaty of 1814."}}, {"canonical_name": "\u00eele du Cap-Vert", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "\u00eeles_du_cap-vert", "book_id": "epoques_nature_buffon_1778", "name": "\u00eeles du Cap-Vert", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["\u00eeles du Cap-Vert"], "contexts": ["islands off the coast of Africa"]}, {"entity_id": "\u00eele_du_cap-vert", "book_id": "relation_historique_humboldt_vol3_1825", "name": "\u00eele du Cap-Vert", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["\u00eele du Cap-Vert", "\u00eeles du Cap-Vert", "\u00eeles du cap Vert"], "contexts": ["Westernmost island of Cape Verde", "Islands used as a reference for demarcation"]}, {"entity_id": "cape_verd_islands", "book_id": "kosmos_humboldt_1845", "name": "Cape Verd Islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Cape Verd Islands"], "contexts": ["location where dust falls", "geographic location where dust contains animalcule remains"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "\u00eeles du Cap-Vert", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "\u00eele du Cap-Vert", "similarity": 0.969}, {"source_book": "e