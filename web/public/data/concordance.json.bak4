arth's radius", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "earth\u2019s circumference", "similarity": 0.954}], "id": 4908, "stable_key": "clu_f419adcee759e4bf", "ground_truth": {"modern_name": "Earth's size", "confidence": "high", "type": "concept", "note": "Refers to measurements of the Earth's dimensions, such as radius and circumference."}}, {"canonical_name": "depth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "depth", "book_id": "kosmos_humboldt_1845", "name": "depth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["depth"], "contexts": ["measurement from surface downwards"]}, {"entity_id": "depths", "book_id": "kosmos_humboldt_1845", "name": "depths", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["depths"], "contexts": ["vertical distance from surface"]}, {"entity_id": "depth", "book_id": "connexion_physical_sciences_somerville_1858", "name": "depth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["depth"], "contexts": ["distance from the surface downwards"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "depth", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "depth", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "depths", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "depth", "similarity": 0.93}], "id": 4909, "stable_key": "clu_6bb81eaee78bf7b1", "ground_truth": {"modern_name": "Depth", "confidence": "high", "type": "concept", "wikidata_id": "Q930412", "wikidata_description": "vertical distance below the reference surface"}}, {"canonical_name": "compression of the Earth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "compression_of_the_earth", "book_id": "kosmos_humboldt_1845", "name": "compression of the Earth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["compression of the Earth"], "contexts": ["flattening of Earth's shape"]}, {"entity_id": "compression_of_the_earth", "book_id": "connexion_physical_sciences_somerville_1858", "name": "compression of the earth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["compression of the earth"], "contexts": ["fraction representing earth's flattening"]}, {"entity_id": "terrestrial_compression", "book_id": "connexion_physical_sciences_somerville_1858", "name": "terrestrial compression", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["terrestrial compression"], "contexts": ["flattening of the Earth"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "compression of the Earth", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "compression of the earth", "similarity": 0.992}, {"source_book": "kosmos_humboldt_1845", "source_name": "compression of the Earth", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "terrestrial compression", "similarity": 0.891}], "id": 4910, "stable_key": "clu_a0428c0b842e484d", "ground_truth": {"modern_name": "Earth's flattening", "confidence": "high", "type": "concept"}}, {"canonical_name": "Lalande", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "lalande", "book_id": "kosmos_humboldt_1845", "name": "Lalande", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Lalande"], "contexts": ["astronomer, author of 'Astron.'"]}, {"entity_id": "lalande", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Lalande", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Lalande"], "contexts": ["computed epochs of planet conjunctions", "computed epochs of conjunctions"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Lalande", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Lalande", "similarity": 1.0}], "id": 4911, "stable_key": "clu_5d4ac8804a7ba368", "ground_truth": {"modern_name": "Joseph J\u00e9r\u00f4me Le Fran\u00e7ais de Lalande", "confidence": "high", "type": "person", "birth_year": 1732, "death_year": 1807, "description": "French astronomer known for astronomical tables and star catalog", "wikidata_id": "Q168419", "wikidata_description": "French astronomer (*1732 \u2013 \u20201807)"}}, {"canonical_name": "Formentera", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "formentera", "book_id": "kosmos_humboldt_1845", "name": "Formentera", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Formentera"], "contexts": ["location of pendulum observations"]}, {"entity_id": "formentera", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Formentera", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Formentera"], "contexts": ["southern Balearic Island", "location for meridian measurement"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Formentera", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Formentera", "similarity": 1.0}], "id": 4912, "stable_key": "clu_9b3bdfb0680415e0", "ground_truth": {"modern_name": "Formentera", "confidence": "high", "type": "place", "country": "Spain", "wikidata_id": "Q52626", "wikidata_description": "municipality of Baleares, Spain, containing the island of the same name", "wikipedia_extract": "Formentera (Balearic Catalan: [fu\u027em\u0259n\u02c8te\u027e\u0259], Spanish: [fo\u027emen\u02c8te\u027ea]) is a Spanish island located in the Mediterranean Sea, which belongs to the Balearic Islands autonomous community together with Mallorca, Menorca, and Ibiza. Formentera is the smallest and most southerly island of the Pityusic Islands group (comprising Ibiza and Formentera itself, as well as various small islets). It covers an area of 83.24 square kilometres (32.14 sq mi), including offshore islets. At the 2011 Census, the population was 10,583; according to the Census of 1 January 2021, it counted 11,891 inhabitants, while the official estimate at 1 January 2023 was 11,389. The island's name is said to derive from the Latin word frumentarium, meaning \"granary\". The island was occupied in prehistoric times, going back to 2,000\u20131,600 BC.", "wikipedia_url": "https://en.wikipedia.org/wiki/Formentera"}}, {"canonical_name": "magnetic influence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "magnetic_influences", "book_id": "kosmos_humboldt_1845", "name": "magnetic influences", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["magnetic influences"], "contexts": ["phenomenon investigated in experiments"]}, {"entity_id": "magnetic_influence", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic influence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["magnetic influence"], "contexts": ["effect of magnetic fields"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "magnetic influences", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic influence", "similarity": 0.958}], "id": 4913, "stable_key": "clu_468fdc3f28cd7072", "ground_truth": {"modern_name": "Magnetic influence", "confidence": "high", "type": "concept", "wikidata_id": "Q58366054", "wikidata_description": "scholarly article by Randall C. Brooks published May 1987 in Annals of Science"}}, {"canonical_name": "conducting power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "conducting_power", "book_id": "kosmos_humboldt_1845", "name": "conducting power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["conducting power"], "contexts": ["ability to transfer heat"]}, {"entity_id": "conducting_power", "book_id": "connexion_physical_sciences_somerville_1858", "name": "conducting power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["conducting power"], "contexts": ["ability of a substance to conduct electricity", "ability to transmit electrical force"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "conducting power", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "conducting power", "similarity": 1.0}], "id": 4914, "stable_key": "clu_5d94143c13e68a04", "ground_truth": {"modern_name": "Thermal conductivity", "confidence": "high", "type": "concept", "note": "The texts also refer to electrical conductivity, but thermal conductivity is the primary scientific concept related to heat transfer.", "wikidata_id": "Q487005", "wikidata_description": "capacity of a material to conduct heat", "wikipedia_url": "https://en.wikipedia.org/wiki/Thermal%20conductivity%20and%20resistivity", "wikipedia_extract": "The thermal conductivity of a material is a measure of its ability to conduct heat. It is commonly denoted by and, in SI units, is measured in W\u00b7m\u22121\u00b7K\u22121. It quantifies the proportionality between the heat flux (heat flow rate per unit area, W\u00b7m\u22122) and the temperature gradient (K\u00b7m\u22121) in the direction of heat transport. The reciprocal of thermal conductivity is called thermal resistivity. Materials with high thermal conductivity transfer heat more efficiently than those with low thermal conductivity. Heat transport can arise from different microscopic mechanisms: In metals, thermal conductivity is typically dominated by free electrons, whereas in dielectric materials such as diamond it is largely due to lattice vibrations."}}, {"canonical_name": "Tartary", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tartary", "book_id": "kosmos_humboldt_1845", "name": "Tartary", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Tartary"], "contexts": ["region with grass plains"]}, {"entity_id": "tartary", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Tartary", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Tartary"], "contexts": ["region with distinct flora", "location where Rhodiola rosea was found"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Tartary", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Tartary", "similarity": 0.785}], "id": 4915, "stable_key": "clu_c67bb2628f58afab-3", "ground_truth": {"modern_name": "Tartary", "confidence": "high", "type": "place", "description": "Historical region in Central and Northern Asia.", "note": "Refers to a vast historical region, often vaguely defined, in Central and Northern Asia.", "wikipedia_extract": "Tartary (Latin: Tartaria; French: Tartarie; German: Tartarei; Russian: \u0422\u0430\u0440\u0442\u0430\u0440\u0438\u044f, romanized: Tartariya) or Tatary (Russian: \u0422\u0430\u0442\u0430\u0440\u0438\u044f, romanized: Tatariya) was a blanket term used in Western European literature and cartography for a vast part of Asia bounded by the Caspian Sea, the Ural Mountains, the Pacific Ocean, and the northern borders of China, India, and Persia, at a time when this region was largely unknown to European geographers. The active use of the toponym (place name) can be traced from the 13th to the 19th centuries. In European sources, Tartary became the most common name for Central Asia that had no connection with the real polities or ethnic groups of the region; until the 19th century, European knowledge of the area remained extremely scarce and fragmentary. In modern English-speaking tradition, the region formerly known as Tartary is usually called Inner Asia or Central Eurasia. Much of this area consists of arid plains, the main nomadic population of which in the past was engaged in animal husbandry. Ignorance surrounding Tartary's use as a place name has spawned pseudohistoric conspiracy theories including ideas of a \"hidden past\" and \"mud floods\"."}}, {"canonical_name": "curve", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "curves", "book_id": "kosmos_humboldt_1845", "name": "curves", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["curves"], "contexts": ["graphical representations of magnetic lines"]}, {"entity_id": "curve", "book_id": "connexion_physical_sciences_somerville_1858", "name": "curve", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["curve"], "contexts": ["path of storm movement", "mathematical representation of a path"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "curves", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "curve", "similarity": 0.914}], "id": 4916, "stable_key": "clu_5bf4b18f683ebd1b", "ground_truth": {"modern_name": "Curve", "confidence": "high", "type": "concept", "note": "The context of magnetic lines and storm paths indicates a mathematical or graphical representation of phenomena."}}, {"canonical_name": "Thermo-electric currents", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "thermo-electric_currents", "book_id": "kosmos_humboldt_1845", "name": "thermo-electric currents", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["thermo-electric currents"], "contexts": ["currents generated by heat difference"]}, {"entity_id": "thermo-electric_currents", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Thermo-electric currents", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["Thermo-electric currents"], "contexts": ["electrical currents generated by heat", "electrical currents generated by temperature differences"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "thermo-electric currents", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Thermo-electric currents", "similarity": 0.992}], "id": 4917, "stable_key": "clu_08f184c476a539a4", "ground_truth": {"modern_name": "Thermoelectric effect", "confidence": "high", "type": "concept", "note": "This refers to the generation of electric current due to a temperature difference."}}, {"canonical_name": "revolution round the sun", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "revolution_of_the_sun", "book_id": "kosmos_humboldt_1845", "name": "revolution of the Sun", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["revolution of the Sun"], "contexts": ["apparent movement of the Sun"]}, {"entity_id": "revolution_round_the_sun", "book_id": "connexion_physical_sciences_somerville_1858", "name": "revolution round the sun", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["revolution round the sun"], "contexts": ["earth's orbit around the sun", "orbital motion of a planet around the sun"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "revolution of the Sun", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "revolution round the sun", "similarity": 0.894}], "id": 4918, "stable_key": "clu_875b5fbecf3cde70", "ground_truth": {"modern_name": "Heliocentric model", "confidence": "high", "type": "concept", "note": "The phrase 'revolution round the sun' refers to the Earth's orbit, as understood in the heliocentric model."}}, {"canonical_name": "Observatory", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "observatory", "book_id": "kosmos_humboldt_1845", "name": "Observatory", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Observatory"], "contexts": ["place for astronomical observations"]}, {"entity_id": "observatory", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Observatory", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["observatory", "Observatory"], "contexts": ["building for astronomical observation", "scientific observation institution"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Observatory", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Observatory", "similarity": 1.0}], "id": 4919, "stable_key": "clu_4d491b4b780f9fc2", "ground_truth": {"modern_name": "Observatory", "confidence": "high", "type": "concept", "wikidata_id": "Q62832", "wikidata_description": "location used for observing terrestrial or celestial events", "wikipedia_url": "https://en.wikipedia.org/wiki/Observatory", "wikipedia_extract": "An observatory is a location used for observing terrestrial, marine, or celestial events. Astronomy, climatology/meteorology, geophysics, oceanography and volcanology are examples of disciplines for which observatories have been constructed. The term observatoire has been used in French since at least 1976 to denote any institution that compiles and presents data on a particular subject (such as public health observatory) or for a particular geographic area (European Audiovisual Observatory). Astronomical observatories are mainly divided into four categories according to location: space-based, airborne, ground-based, and underground-based. Historically, ground-based observatories were as simple as containing a mural instrument (for measuring the angle between stars) or Stonehenge (which has some alignments on astronomical phenomena). Astronomical observatories may be private or they may be public."}}, {"canonical_name": "Greenwich Observatory", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "observatory_at_greenwich", "book_id": "kosmos_humboldt_1845", "name": "Observatory at Greenwich", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Observatory at Greenwich"], "contexts": ["astronomical observatory"]}, {"entity_id": "greenwich_observatory", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Greenwich Observatory", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Greenwich Observatory"], "contexts": ["observatory for lunar observations", "observatory location"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Observatory at Greenwich", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Greenwich Observatory", "similarity": 0.967}], "id": 4920, "stable_key": "clu_ae6574a393440237", "ground_truth": {"modern_name": "Royal Observatory, Greenwich", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q192988", "wikidata_description": "observatory in Greenwich, London, UK"}}, {"canonical_name": "explosion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "explosion", "book_id": "kosmos_humboldt_1845", "name": "explosion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["explosion"], "contexts": ["sudden release of energy"]}, {"entity_id": "explosion", "book_id": "connexion_physical_sciences_somerville_1858", "name": "explosion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["explosion"], "contexts": ["sudden release of energy", "rapid release of energy"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "explosion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "explosion", "similarity": 1.0}], "id": 4921, "stable_key": "clu_6c96a9e770757d13", "ground_truth": {"modern_name": "Explosion", "confidence": "high", "type": "concept", "wikidata_id": "Q179057", "wikidata_description": "sudden release of energy through high temperatures and gas expansion"}}, {"canonical_name": "bluish white", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "bluish_white", "book_id": "kosmos_humboldt_1845", "name": "bluish white", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["bluish white"], "contexts": ["color"]}, {"entity_id": "reddish_white", "book_id": "connexion_physical_sciences_somerville_1858", "name": "reddish white", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["reddish white"], "contexts": ["accidental color of green"]}, {"entity_id": "blueish_white", "book_id": "connexion_physical_sciences_somerville_1858", "name": "blueish white", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["blueish white"], "contexts": ["color of light"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "bluish white", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "reddish white", "similarity": 0.938}, {"source_book": "kosmos_humboldt_1845", "source_name": "bluish white", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "blueish white", "similarity": 0.954}], "id": 4922, "stable_key": "clu_14e67b39fed28b8a", "ground_truth": {"modern_name": "Color description", "confidence": "high", "type": "concept", "note": "Describes various shades and colors.", "wikidata_id": "Q1261", "wikidata_description": "state of the United States of America", "wikipedia_url": "https://en.wikipedia.org/wiki/Colorado"}}, {"canonical_name": "Challis", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "challis", "book_id": "kosmos_humboldt_1845", "name": "Challis", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Challis"], "contexts": ["Professor at Cambridge"]}, {"entity_id": "challis", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Challis", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Challis"], "contexts": ["questioned Brewster's analysis of light", "Professor, questioned Brewster's analysis of light"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Challis", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Challis", "similarity": 1.0}], "id": 4923, "stable_key": "clu_f3d044f808a952f0", "ground_truth": {"modern_name": "James Challis", "confidence": "high", "type": "person", "birth_year": 1803, "death_year": 1883, "description": "English astronomer and physicist, Cambridge professor.", "wikidata_id": "Q731321", "wikidata_description": "British astronomer (1803-1882)", "wikipedia_url": "https://en.wikipedia.org/wiki/James%20Challis", "wikipedia_extract": "James Challis FRS (12 December 1803 \u2013 3 December 1882) was an English clergyman, physicist and astronomer. Plumian Professor of Astronomy and Experimental Philosophy and the director of the Cambridge Observatory, he investigated a wide range of physical phenomena though made few lasting contributions outside astronomy. He is best remembered for his missed opportunity to discover the planet Neptune in 1846. Challis was born in Braintree, Essex where his father, John Challis, was a stonemason. After attending various local schools, he graduated from Trinity College, Cambridge in 1825 as Senior Wrangler and first Smith's prizeman. He was elected a fellow of Trinity in 1826 and was ordained in 1830."}}, {"canonical_name": "spiritus", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "spiritu", "book_id": "kosmos_humboldt_1845", "name": "spiritu", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["spiritu"], "contexts": ["Latin for spirit or breath"]}, {"entity_id": "spiritus", "book_id": "polyanthea_medicinal", "name": "spiritus", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["spiritus", "SPIRITUS"], "contexts": ["spirit", "vapors or spirits"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "spiritu", "target_book": "polyanthea_medicinal", "target_name": "spiritus", "similarity": 0.94}], "id": 4924, "stable_key": "clu_6d1f0035bef709d1-2", "ground_truth": {"modern_name": "Spirit", "confidence": "high", "type": "concept", "note": "Covers philosophical, religious, and scientific (e.g., breath) connotations of 'spirit' across languages.", "wikidata_id": "Q9174", "wikidata_description": "social-cultural system", "wikipedia_url": "https://en.wikipedia.org/wiki/Religion", "wikipedia_extract": "Religion is a range of social-cultural systems, including designated behaviors and practices, ethics, morals, beliefs, worldviews, texts, sanctified places, prophecies, or organizations, that generally relate humanity to supernatural, transcendental, and spiritual elements\u2014although there is no scholarly consensus over what precisely constitutes a religion. It is an essentially contested concept. Different religions may or may not contain various elements ranging from the divine, sacredness, faith, and a supernatural being or beings. The origin of religious belief is an open question, with possible explanations including awareness of individual death, a sense of community, and dreams. Religions have sacred histories, narratives, and mythologies, preserved in oral traditions, sacred texts, symbols, and holy places, that may attempt to explain the origin of life, the universe, and other phenomena. Religious practice may include rituals, sermons, commemoration or veneration (of deities or saints), sacrifices, festivals, feasts, trances, initiations, matrimonial and funerary services, meditation, prayer, music, art, dance, or public service."}}, {"canonical_name": "St. Vincent", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "st__vincent", "book_id": "kosmos_humboldt_1845", "name": "St. Vincent", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["St. Vincent"], "contexts": ["volcano in the small Antilles"]}, {"entity_id": "st__vincent", "book_id": "connexion_physical_sciences_somerville_1858", "name": "St. Vincent", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["St. Vincent"], "contexts": ["island with a volcano"]}, {"entity_id": "vincent,_st_", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Vincent, St.", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Vincent, St."], "contexts": ["location of extinct volcano revival"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "St. Vincent", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "St. Vincent", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "St. Vincent", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Vincent, St.", "similarity": 0.944}], "id": 4925, "stable_key": "clu_65e54c817fdfb1e6", "ground_truth": {"modern_name": "Saint Vincent", "confidence": "high", "type": "place", "country": "Saint Vincent and the Grenadines"}}, {"canonical_name": "Equinoctial America", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "equinoctial_regions", "book_id": "kosmos_humboldt_1845", "name": "equinoctial regions", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["equinoctial regions"], "contexts": ["regions near the equator"]}, {"entity_id": "equinoctial_america", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Equinoctial America", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["equinoctial America", "Equinoctial America"], "contexts": ["region with many indigenous plant species", "region with distinct flora"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "equinoctial regions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Equinoctial America", "similarity": 0.885}], "id": 4926, "stable_key": "clu_0a84e4b03a30ba83-2", "ground_truth": {"modern_name": "Equatorial America", "confidence": "high", "type": "place", "country": "South America"}}, {"canonical_name": "torrid", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "torrid_zones", "book_id": "kosmos_humboldt_1845", "name": "torrid zones", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["torrid zones"], "contexts": ["regions near the equator with high temperatures"]}, {"entity_id": "torrid", "book_id": "connexion_physical_sciences_somerville_1858", "name": "torrid", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["torrid"], "contexts": ["tropical regions with less pressure change", "tropical regions"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "torrid zones", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "torrid", "similarity": 0.942}], "id": 4927, "stable_key": "clu_efa17ff517020478-2", "ground_truth": {"modern_name": "Torrid Zone", "confidence": "high", "type": "concept", "wikidata_id": "Q117455236", "wikidata_description": "lies between TROPIC OF CANCER AND TROPIC OF CAPRICORN", "wikipedia_url": "https://en.wikipedia.org/wiki/Torrid%20zone", "country": "Global", "wikipedia_extract": "The torrid zone was the name given by ancient Greek and Roman geographers to the equatorial area of the Earth, so hot that it was thought to be impenetrable to sailors or explorers. That notion became a deterrent for European explorers until the 15th century. Aristotle, like all classical thinkers, knew that the world was a sphere. He posited that the western half of the temperate zone on the other side of the globe from Greece might be habitable and that, because of symmetry, there must be in the Southern Hemisphere a temperate zone corresponding to that in the northern. He thought, however, that the excessive heat in the torrid zone would prevent the exploration. the meridian through Syene is drawn approximately along the course of the Nile from Mero\u00eb to Alexandria, and this distance is about ten thousand stadia [~1,800 km]; and Syene must lie in the centre of that distance; so that the distance from Syene to Mero\u00eb is five thousand stadia [~900 km]."}}, {"canonical_name": "Chaudes Aigues", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "chaudes_aigues", "book_id": "kosmos_humboldt_1845", "name": "Chaudes Aigues", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Chaudes Aigues"], "contexts": ["location of a hot spring"]}, {"entity_id": "chaudes_aigues", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Chaudes Aigues", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Chaudes Aigues"], "contexts": ["location of a thermal spring", "location with a specific temperature"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Chaudes Aigues", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Chaudes Aigues", "similarity": 1.0}], "id": 4928, "stable_key": "clu_4342fba4380b3528", "ground_truth": {"modern_name": "Chaudes-Aigues", "confidence": "high", "type": "place", "country": "France", "wikidata_id": "Q269112", "wikidata_description": "commune in Cantal, France", "wikipedia_url": "https://en.wikipedia.org/wiki/Chaudes-Aigues", "wikipedia_extract": "Chaudes-Aigues (French: [\u0283od.z\u203f\u025b\u0261]; Occitan: Chaudas Aigas, lit. '\"Hot Waters\"') is a commune in the Cantal department in south-central France. It is a spa town, famous for its hot spring waters. The commune is situated in the Massif Central in Aubrac. Its inhabitants are called the Caldagu\u00e8s, from the Latin meaning 'hot waters', or in French, eaux chaudes; hence the name of the commune, Chaudes-Aigues As its name suggests, there are thirty natural hot water sources with temperatures ranging from 45\u00b0C to more than 80\u00b0C. The most famous is the source of the Par river with a water temperature of 82\u00b0C - the hottest in Europe - with a flow in the region of 450,000 litres a day."}}, {"canonical_name": "granular", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "granular", "book_id": "kosmos_humboldt_1845", "name": "granular", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["granular"], "contexts": ["composed of small grains"]}, {"entity_id": "granular", "book_id": "polyanthea_medicinal", "name": "granular", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["Granular", "granular"], "contexts": ["forming into granules by dropping", "chemical process of preparing medicines"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "granular", "target_book": "polyanthea_medicinal", "target_name": "granular", "similarity": 1.0}], "id": 4929, "stable_key": "clu_ae7ff7bb2911e413", "ground_truth": {"modern_name": "Granular", "confidence": "high", "type": "concept", "note": "Refers to a texture or form consisting of small grains or granules, applicable in both general description and medicinal preparations."}}, {"canonical_name": "Sardine", "category": "ANIMAL", "subcategory": "FISH", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "sardine", "book_id": "kosmos_humboldt_1845", "name": "sardine", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["sardine"], "contexts": ["specific type of fish fossil"]}, {"entity_id": "sardine", "book_id": "ricettario_fiorentino_1597", "name": "Sardine", "category": "ANIMAL", "subcategory": "FISH", "count": 2, "variants": ["Sardine"], "contexts": ["sardonyx stone", "fish name"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "sardine", "target_book": "ricettario_fiorentino_1597", "target_name": "Sardine", "similarity": 0.987}], "id": 4930, "stable_key": "clu_149e5c693c76535d", "ground_truth": {"wikipedia_extract": "Sardine and pilchard are common names for various species of small, oily forage fish in the herring suborder Clupeoidei. The term \"sardine\" was first used in English during the early 15th century; a somewhat dubious etymology says it comes from the Italian island of Sardinia, around which sardines were once supposedly abundant. The terms \"sardine\" and \"pilchard\" are not precise, and what is meant depends on the region. The United Kingdom's Sea Fish Industry Authority, for example, classifies sardines as young pilchards. One criterion suggests fish shorter in length than 15 cm (6 in) are sardines, and larger fish are pilchards. The FAO/WHO Codex standard for canned sardines cites 21 species that may be classed as sardines."}}, {"canonical_name": "Northumberland", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "northumberland", "book_id": "kosmos_humboldt_1845", "name": "Northumberland", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Northumberland"], "contexts": ["region where garnets form"]}, {"entity_id": "northumberland", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Northumberland", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Northumberland"], "contexts": ["location of coal-pit", "county where Harton coal-pit is located"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Northumberland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Northumberland", "similarity": 0.834}], "id": 4931, "stable_key": "clu_58de1979e6e5a585", "ground_truth": {"modern_name": "Northumberland", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q67535553", "wikidata_description": "historic county of England, United Kingdom"}}, {"canonical_name": "animal matter", "category": "ANIMAL", "subcategory": "PRODUCT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "animal_matter", "book_id": "kosmos_humboldt_1845", "name": "animal matter", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["animal matter"], "contexts": ["substance derived from animals"]}, {"entity_id": "animal_substances", "book_id": "kosmos_humboldt_1845", "name": "animal substances", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["animal substances"], "contexts": ["materials derived from animals"]}, {"entity_id": "animal_substances", "book_id": "connexion_physical_sciences_somerville_1858", "name": "animal substances", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["animal substances"], "contexts": ["substances derived from animals"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "animal matter", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "animal substances", "similarity": 0.945}, {"source_book": "kosmos_humboldt_1845", "source_name": "animal substances", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "animal substances", "similarity": 1.0}], "id": 4932, "stable_key": "clu_d5a45915a18d0318", "ground_truth": {"modern_name": "Animal products", "confidence": "high", "type": "concept", "note": "Refers to substances or materials derived from animals.", "wikidata_id": "Q101075215", "wikidata_description": "New Zealand Legislative Instrument LI 2015/95"}}, {"canonical_name": "mercurial column", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mercurial_column", "book_id": "kosmos_humboldt_1845", "name": "mercurial column", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["mercurial column"], "contexts": ["column of mercury in a barometer"]}, {"entity_id": "mercurial_column", "book_id": "first_principles_spencer_1862", "name": "mercurial column", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["mercurial column"], "contexts": ["column of mercury in a thermometer"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "mercurial column", "target_book": "first_principles_spencer_1862", "target_name": "mercurial column", "similarity": 1.0}], "id": 4933, "stable_key": "clu_a21cf0d410b3efd7", "ground_truth": {"modern_name": "mercury column", "confidence": "high", "type": "concept", "note": "Refers to the column of mercury in scientific instruments like thermometers and barometers."}}, {"canonical_name": "mausim", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mausim", "book_id": "kosmos_humboldt_1845", "name": "mausim", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mausim"], "contexts": ["Arabic word for set time or season"]}, {"entity_id": "mausim", "book_id": "coloquios_da_orta_1563", "name": "mausim", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["mausim"], "contexts": ["Arabic word for seasonal wind", "Arabic word for monsoon"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "mausim", "target_book": "coloquios_da_orta_1563", "target_name": "mausim", "similarity": 1.0}], "id": 4934, "stable_key": "clu_20db31bed275ef96", "ground_truth": {"modern_name": "Mausim", "confidence": "high", "type": "concept", "note": "Identified as an Arabic term for season or seasonal wind as per the context provided.", "wikidata_id": "Q1884005", "wikidata_description": "Islamic and Sufi concept"}}, {"canonical_name": "transmission of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "distribution_of_heat", "book_id": "kosmos_humboldt_1845", "name": "distribution of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["distribution of heat"], "contexts": ["understanding heat in the atmosphere"]}, {"entity_id": "transmission_of_heat", "book_id": "connexion_physical_sciences_somerville_1858", "name": "transmission of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["transmission of heat"], "contexts": ["subject of M. Melloni's experiments", "movement of thermal energy"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "distribution of heat", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "transmission of heat", "similarity": 0.909}], "id": 4935, "stable_key": "clu_7823d1dc4711d30f", "ground_truth": {"modern_name": "heat transfer", "confidence": "high", "type": "concept", "wikidata_id": "Q179635", "wikidata_description": "transport of thermal energy in physical systems", "wikipedia_url": "https://en.wikipedia.org/wiki/Heat%20transfer", "wikipedia_extract": "Heat transfer is a discipline of thermal engineering that concerns the generation, use, conversion, and exchange of thermal energy (heat) between physical systems. Heat transfer is classified into various mechanisms, such as thermal conduction, thermal convection, thermal radiation, and transfer of energy by phase changes. Engineers also consider the transfer of mass of differing chemical species (mass transfer in the form of advection), either cold or hot, to achieve heat transfer. While these mechanisms have distinct characteristics, they often occur simultaneously in the same system. Heat conduction, also called diffusion, is the direct microscopic exchanges of kinetic energy of particles (such as molecules) or quasiparticles (such as lattice waves) through the boundary between two systems. When an object is at a different temperature from another body or its surroundings, heat flows so that the body and the surroundings reach the same temperature, at which point they are in thermal equilibrium."}}, {"canonical_name": "spring east winds", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "southerly_winds", "book_id": "kosmos_humboldt_1845", "name": "southerly winds", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["southerly winds"], "contexts": ["winds from the south"]}, {"entity_id": "spring_east_winds", "book_id": "first_principles_spencer_1862", "name": "spring east winds", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["spring east winds"], "contexts": ["winds in spring", "atmospheric disturbances in temperate zones"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "southerly winds", "target_book": "first_principles_spencer_1862", "target_name": "spring east winds", "similarity": 0.895}], "id": 4936, "stable_key": "clu_19d58f0aae4b17ba-3", "ground_truth": {"modern_name": "Wind", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Wind", "note": "The terms 'southerly winds' and 'spring east winds' describe specific types of winds. The most general modern referent is 'winds'.", "wikipedia_extract": "Wind is the natural movement of air or other gases relative to a planet's surface. Winds occur on a range of scales, from thunderstorm flows lasting tens of minutes, to local breezes generated by heating of land surfaces and lasting a few hours, to global winds resulting from the difference in absorption of solar energy between the climate zones on Earth. The study of wind is called anemology. The two main causes of large-scale atmospheric circulation are the differential heating between the equator and the poles, and the rotation of the planet, which is called the Coriolis effect. Within the tropics and subtropics, thermal low circulations over terrain and high plateaus can drive monsoon circulations. In coastal areas the sea breeze/land breeze cycle can define local winds; in areas that have variable terrain, mountain and valley breezes can prevail."}}, {"canonical_name": "boiling point", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "boiling-point", "book_id": "kosmos_humboldt_1845", "name": "boiling-point", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["boiling-point"], "contexts": ["temperature at which liquid boils"]}, {"entity_id": "boiling_point", "book_id": "connexion_physical_sciences_somerville_1858", "name": "boiling point", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["boiling point"], "contexts": ["temperature at which liquid boils"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "boiling-point", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "boiling point", "similarity": 0.98}], "id": 4937, "stable_key": "clu_eeaec27c88846711", "ground_truth": {"modern_name": "boiling point", "confidence": "high", "type": "concept"}}, {"canonical_name": "positive electricity", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "positive_electricity", "book_id": "kosmos_humboldt_1845", "name": "positive electricity", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["positive electricity"], "contexts": ["type of electrical charge"]}, {"entity_id": "positive_electricity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "positive electricity", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["positive electricity"], "contexts": ["type of electric charge", "type of electrical charge"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "positive electricity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "positive electricity", "similarity": 1.0}], "id": 4938, "stable_key": "clu_5366577672137714", "ground_truth": {"modern_name": "Positive electric charge", "confidence": "high", "type": "concept"}}, {"canonical_name": "electric equilibrium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "electric_equilibrium", "book_id": "kosmos_humboldt_1845", "name": "electric equilibrium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["electric equilibrium"], "contexts": ["state of balance in electrical charge"]}, {"entity_id": "electrical_equilibrium", "book_id": "connexion_physical_sciences_somerville_1858", "name": "electrical equilibrium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["electrical equilibrium"], "contexts": ["disturb electrical equilibrium"]}, {"entity_id": "electric_equilibrium", "book_id": "connexion_physical_sciences_somerville_1858", "name": "electric equilibrium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["electric equilibrium"], "contexts": ["restored by union of electric states"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "electric equilibrium", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electrical equilibrium", "similarity": 0.993}, {"source_book": "kosmos_humboldt_1845", "source_name": "electric equilibrium", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electric equilibrium", "similarity": 1.0}], "id": 4939, "stable_key": "clu_1f6cf62b4304d046", "ground_truth": {"modern_name": "Electrical equilibrium", "confidence": "high", "type": "concept"}}, {"canonical_name": "tropical", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tropical_region", "book_id": "kosmos_humboldt_1845", "name": "tropical region", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["tropical region"], "contexts": ["area with vast forests"]}, {"entity_id": "tropical", "book_id": "first_principles_spencer_1862", "name": "tropical", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["tropical"], "contexts": ["symbolic forms of writing", "relating to the tropics"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "tropical region", "target_book": "first_principles_spencer_1862", "target_name": "tropical", "similarity": 0.975}], "id": 4940, "stable_key": "clu_56d1ba8bad50e5c6-2", "ground_truth": {"modern_name": "Tropical regions", "confidence": "high", "type": "place", "country": "Global"}}, {"canonical_name": "Hist. des Mongols", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "historia_mongolorum_et_tatarorum", "book_id": "kosmos_humboldt_1845", "name": "Historia Mongolorum et Tatarorum", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Historia Mongolorum et Tatarorum"], "contexts": ["work on Mongols and Tatars"]}, {"entity_id": "hist__des_mongols", "book_id": "coloquios_da_orta_1563", "name": "Hist. des Mongols", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Hist. des Mongols", "Histoire des Mong\u00f3is"], "contexts": ["Work by D'Ohsson", "title of a historical work"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Historia Mongolorum et Tatarorum", "target_book": "coloquios_da_orta_1563", "target_name": "Hist. des Mongols", "similarity": 0.885}], "id": 4941, "stable_key": "clu_1e5cccb90b9b7172", "ground_truth": {"modern_name": "History of the Mongols", "confidence": "high", "type": "text", "note": "This refers to historical works about the Mongols, specifically mentioning 'Historia Mongolorum et Tatarorum' by Jean-Baptiste van Moorlehem and potentially 'Histoire des Mongols' by D'Ohsson. Both are historical texts."}}, {"canonical_name": "magnetism of rotation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "magnetism_of_rotation", "book_id": "kosmos_humboldt_1845", "name": "magnetism of rotation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetism of rotation"], "contexts": ["magnetic phenomenon studied by Arago"]}, {"entity_id": "magnetic_rotation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic rotation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic rotation"], "contexts": ["rotation influenced by magnetism"]}, {"entity_id": "rotation_of_magnets", "book_id": "connexion_physical_sciences_somerville_1858", "name": "rotation of magnets", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["rotation of magnets"], "contexts": ["electricity induction by"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "magnetism of rotation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic rotation", "similarity": 0.912}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetism of rotation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "rotation of magnets", "similarity": 0.928}], "id": 4942, "stable_key": "clu_6b9daa83c1ed2b6b", "ground_truth": {"modern_name": "Magnetic rotation", "confidence": "high", "type": "concept", "note": "The early modern texts refer to phenomena studied by Arago involving the rotation of magnets and its influence on induced currents or vice versa.", "wikidata_id": "Q128028415", "wikidata_description": "scholarly article"}}, {"canonical_name": "Fossil plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "fossil_vegetation", "book_id": "kosmos_humboldt_1845", "name": "fossil vegetation", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["fossil vegetation"], "contexts": ["ancient plant remains"]}, {"entity_id": "fossil_plants", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Fossil plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Fossil plants", "fossil plants"], "contexts": ["plants discovered in high latitudes", "ancient plant remains indicating temperature change"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "fossil vegetation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Fossil plants", "similarity": 0.938}], "id": 4943, "stable_key": "clu_aac834bd1e7c7d0d", "ground_truth": {"modern_name": "Fossil plants", "confidence": "high", "type": "plant", "note": "Refers to ancient plant remains discovered, not a specific species.", "wikidata_id": "Q51479306", "wikidata_description": "Pittsburgh: Published by the authority of the Board of Trustees of the Carnegie Institute, [1920]"}}, {"canonical_name": "phosphorescent", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "phosphorescent", "book_id": "kosmos_humboldt_1845", "name": "phosphorescent", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["phosphorescent"], "contexts": ["emitting light"]}, {"entity_id": "phosphorescent", "book_id": "connexion_physical_sciences_somerville_1858", "name": "phosphorescent", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["phosphorescent"], "contexts": ["emitting light after exposure to sun", "phenomena of light emission"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "phosphorescent", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "phosphorescent", "similarity": 1.0}], "id": 4944, "stable_key": "clu_a4614d891cc770e4-2", "ground_truth": {"modern_name": "phosphorescence", "confidence": "high", "type": "concept", "wikidata_id": "Q192275", "wikidata_description": "process in which energy absorbed by a substance is released relatively slowly in the form of light", "wikipedia_url": "https://en.wikipedia.org/wiki/Phosphorescence", "wikipedia_extract": "Phosphorescence is a type of photoluminescence related to fluorescence. When exposed to light (radiation) of a shorter threshold wavelength, a phosphorescent substance will glow, absorbing the light and reemitting it at a longer wavelength. Unlike fluorescence, a phosphorescent material does not immediately reemit the radiation it absorbs. Instead, a phosphorescent material absorbs some of the radiation energy and reemits it for a much longer time after the radiation source is removed. In a general sense, there is no distinct boundary between the emission times of fluorescence and phosphorescence (i.e.: if a substance glows under a black light it is generally considered fluorescent, and if it glows in the dark it is often simply called phosphorescent). In a modern, scientific sense, the phenomena can usually be classified by the three different mechanisms that produce the light and the typical timescales at which they emit light: fluorescence, triplet phosphorescence, and persistent phosphorescence."}}, {"canonical_name": "race", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "race", "book_id": "kosmos_humboldt_1845", "name": "race", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["race"], "contexts": ["human classification"]}, {"entity_id": "race", "book_id": "first_principles_spencer_1862", "name": "race", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["race"], "contexts": ["group of organisms", "group of people with shared characteristics"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "race", "target_book": "first_principles_spencer_1862", "target_name": "race", "similarity": 1.0}], "id": 4945, "stable_key": "clu_9a42b1b478a504e4", "ground_truth": {"modern_name": "race", "confidence": "high", "type": "concept", "wikidata_id": "Q11783626", "wikidata_description": "organized sports contest in athletics"}}, {"canonical_name": "agudas", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "agudas", "book_id": "historia_medicinal_monardes_1574", "name": "agudas", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["agudas", "aguda"], "contexts": ["acute illnesses treated with the root", "type of illness"]}, {"entity_id": "agudas", "book_id": "polyanthea_medicinal", "name": "agudas", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["agudas"], "contexts": ["description of diseases"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "agudas", "target_book": "polyanthea_medicinal", "target_name": "agudas", "similarity": 1.0}], "id": 4946, "stable_key": "clu_ac8b165a1b9e9bb5-2", "ground_truth": {"modern_name": "acute illness", "confidence": "high", "type": "disease", "modern_term": "acute illness"}}, {"canonical_name": "Caftilla", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "caftilla", "book_id": "historia_medicinal_monardes_1574", "name": "Caftilla", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Caftilla", "Ca\u017ftilla"], "contexts": ["region with similar trees and plants", "Turpentine made in Castile"]}, {"entity_id": "caftilla", "book_id": "polyanthea_medicinal", "name": "Caftilla", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Caftilla"], "contexts": ["region where many people were cured"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Caftilla", "target_book": "polyanthea_medicinal", "target_name": "Caftilla", "similarity": 1.0}], "id": 4947, "stable_key": "clu_2842128dcd8c23a6-2", "ground_truth": {"modern_name": "Castile", "confidence": "high", "type": "place", "country": "Spain", "note": "The context 'spring at Delphi' might refer to Castalia, a spring at Delphi, but the dominant references point to the historical region in Spain, especially given the context of 'kingdom in Spain'. Humboldt's 'Relation historique' and 'Kosmos' would primarily use 'Castille' for the Spanish region.", "wikidata_id": "Q217196", "wikidata_description": "former country", "wikipedia_url": "https://en.wikipedia.org/wiki/Crown_of_Castile", "wikipedia_extract": "On July 6, 2016, Philando Castile, a 32-year-old African American man, was fatally shot during a traffic stop by police officer Jeronimo Yanez of the St. Anthony police department in the Minneapolis\u2013Saint Paul metropolitan area. About 9 p.m., Castile was driving with his girlfriend, Diamond Reynolds, and her four-year-old daughter when he was pulled over by Yanez and another officer in Falcon Heights, a suburb of Saint Paul, Minnesota. Castile, who was licensed to carry a firearm, told Yanez that he had a firearm. Yanez replied, \"Don't reach for it then\". Castile responded, \"I'm, I, I was reaching for...\", to which Yanez replied, \"Don't pull it out\"."}}, {"canonical_name": "Duquesa de Bejar", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "duquesa_de_bejar", "book_id": "historia_medicinal_monardes_1574", "name": "Duquesa de Bejar", "category": "PERSON", "subcategory": "PATRON", "count": 2, "variants": ["Duquesa de Bejar", "Duque\u00eda de Bejar"], "contexts": ["noblewoman patron of the book", "noblewoman who was ill"]}, {"entity_id": "duqueza_de_bejar", "book_id": "coloquios_da_orta_1563", "name": "Duqueza de Bejar", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Duqueza de Bejar"], "contexts": ["noble patron"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Duquesa de Bejar", "target_book": "coloquios_da_orta_1563", "target_name": "Duqueza de Bejar", "similarity": 0.899}], "id": 4948, "stable_key": "clu_5be1047c869fb95b", "ground_truth": {"modern_name": "Duchess of Bejar", "confidence": "high", "type": "person", "description": "Noblewoman and patron of scientific texts."}}, {"canonical_name": "Conrado Ge\u017fnero", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "conrado_ge\u017fnero", "book_id": "historia_medicinal_monardes_1574", "name": "Conrado Ge\u017fnero", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Conrado Ge\u017fnero", "Conrado Ge\u017fnero Tigurino"], "contexts": ["author of a book on animals"]}, {"entity_id": "conrado_gefnero", "book_id": "polyanthea_medicinal", "name": "Conrado Gefnero", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Conrado Gefnero"], "contexts": ["author cited for praising eggs"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Conrado Ge\u017fnero", "target_book": "polyanthea_medicinal", "target_name": "Conrado Gefnero", "similarity": 0.875}], "id": 4949, "stable_key": "clu_9bc53eb92a174873-2", "ground_truth": {"modern_name": "Conrad Gessner", "confidence": "high", "type": "person", "birth_year": 1516, "death_year": 1565, "description": "Swiss physician, botanist, zoologist, and bibliographer.", "wikidata_id": "Q60116", "wikidata_description": "Swiss physician, bibliographer and naturalist (1516\u20131565)", "wikipedia_url": "https://en.wikipedia.org/wiki/Conrad_Gessner", "wikipedia_extract": "The salamander is an amphibian of the order Urodela which once, like many real creatures, often was suppositiously ascribed fantastic and sometimes occult qualities by pre-modern authors, as in the allegorical descriptions of animals in medieval bestiaries. The legendary salamander is often depicted as a typical salamander in shape, with a lizard-like form, but is usually ascribed an affinity with fire, sometimes specifically elemental fire. Ancient and medieval commentators ascribed many fantastical abilities to the natural salamander. Many of these qualities are rooted in verifiable traits of the natural creature but often exaggerated. A large body of legend, mythology, and symbolism has developed around this creature over the centuries. Carl Linnaeus in the 10th edition of Systema Naturae of 1758 established the scientific description of the salamander and noted the chief characteristics described by the ancients: the reported ability to live in fire, and the oily exudates."}}, {"canonical_name": "Genoua", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "genoua", "book_id": "historia_medicinal_monardes_1574", "name": "Genoua", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Genoua"], "contexts": ["natural place of don Christoual Col\u00f3", "city where Ca\u00f1afistola was brought to"]}, {"entity_id": "genoa", "book_id": "coloquios_da_orta_1563", "name": "Genoa", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Genoa"], "contexts": ["city where a stone is located"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Genoua", "target_book": "coloquios_da_orta_1563", "target_name": "Genoa", "similarity": 0.955}], "id": 4950, "stable_key": "clu_9aea4db9ddd84991", "ground_truth": {"modern_name": "Genoa", "confidence": "high", "type": "place", "description": "Major port city in Italy, historically significant for trade and exploration.", "note": "Refers to the city of Genoa, also known historically as G\u00eanes or Geneve in some texts.", "wikipedia_extract": "Genoa ( JEN-oh-\u0259; Italian: Genova [\u02c8d\u0292\u025b\u02d0nova] ; Ligurian: Z\u00eana [\u02c8ze\u02d0na]) is the sixth-largest city in Italy and the capital of the Italian region of Liguria. As of 2025, 565,301 people live within the city's administrative limits. While its metropolitan city has 818,629 inhabitants, more than 1.5 million people live in the wider metropolitan area stretching along the Italian Riviera. On the Gulf of Genoa in the Ligurian Sea, Genoa has historically been one of the most important ports on the Mediterranean: it is the busiest port in Italy and in the Mediterranean Sea and twelfth-busiest in the European Union. Genoa was the capital of one of the most powerful maritime republics for over seven centuries, from the 11th century to 1797. Particularly from the 12th century to the 15th century, the city played a leading role in the history of commerce and trade in Europe, becoming one of the largest naval powers of the continent and considered among the wealthiest cities in the world."}}, {"canonical_name": "mestruos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mestruos", "book_id": "historia_medicinal_monardes_1574", "name": "mestruos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["mestruos"], "contexts": ["menstrual fluxes", "menstrual flux"]}, {"entity_id": "menstruo", "book_id": "coloquios_da_orta_1563", "name": "menstruo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["menstruo"], "contexts": ["menstrual cycle"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "mestruos", "target_book": "coloquios_da_orta_1563", "target_name": "menstruo", "similarity": 0.952}], "id": 4951, "stable_key": "clu_22e02b46dbe2c2bf", "ground_truth": {"modern_name": "menstruation", "confidence": "high", "type": "concept", "note": "'Mestruos', 'menstruo', and 'menstruepurgationis' all refer to menstrual cycles or fluxes.", "wikidata_id": "Q50430082", "wikidata_description": "chemical compounds that induce menstruation, through direct action or by relieving a condition causing amenorrhea", "wikipedia_extract": "Menstruation in Islam relates to various purity related restrictions in Islamic jurisprudence. The \u1e25ay\u1e0d (Arabic: \u062d\u064a\u0636) is the religious state of menstruation in Islam. The Qur'an makes specific mention of menstruation in al-Baqara 2:222:And they ask you about menstruation. Say, \"It is harm, so keep away from wives during menstruation. And do not approach them until they are pure. And when they have purified themselves, then come to them from where All\u0101h has ordained for you.", "wikipedia_url": "https://en.wikipedia.org/wiki/Menstruation_in_Islam"}}, {"canonical_name": "cenar", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cenar", "book_id": "historia_medicinal_monardes_1574", "name": "cenar", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["cenar"], "contexts": ["evening meal", "dining"]}, {"entity_id": "jantar", "book_id": "polyanthea_medicinal", "name": "jantar", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["jantar"], "contexts": ["eating lunch, a daily activity"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "cenar", "target_book": "polyanthea_medicinal", "target_name": "jantar", "similarity": 0.904}], "id": 4952, "stable_key": "clu_a4e32c1da4f8a6c2", "ground_truth": {"modern_name": "supper", "confidence": "high", "type": "concept", "note": "While 'jantar' can mean lunch, in the context of early modern medical texts and the association with 'cenar', 'supper' or 'evening meal' is the more appropriate interpretation.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "fuerte", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "fuerte", "book_id": "historia_medicinal_monardes_1574", "name": "fuerte", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["fuerte"], "contexts": ["strong patient", "quality of Hierro"]}, {"entity_id": "forte", "book_id": "first_principles_spencer_1862", "name": "forte", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["forte"], "contexts": ["musical dynamic for loud volume"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "fuerte", "target_book": "first_principles_spencer_1862", "target_name": "forte", "similarity": 0.954}], "id": 4953, "stable_key": "clu_53d467a42fb381ab", "ground_truth": {"modern_name": "strong", "confidence": "high", "type": "concept", "note": "The context 'strong patient' clearly indicates a physical attribute. The 'musical dynamic for loud volume' is a secondary meaning, but 'strong' as a quality is the primary concept.", "wikidata_id": "Q24875716", "wikidata_description": "1995 single by T\u014dko Furuuchi"}}, {"canonical_name": "Pedra de O\u017fmar", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pedra_de_o\u017fmar", "book_id": "historia_medicinal_monardes_1574", "name": "Pedra de O\u017fmar", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Pedra de O\u017fmar"], "contexts": ["sender of the letter", "recipient of a letter"]}, {"entity_id": "pedra_da_silva", "book_id": "polyanthea_medicinal", "name": "Pedra da Silva", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Pedra da Silva"], "contexts": ["fidalgo near Santo Christo chapel"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Pedra de O\u017fmar", "target_book": "polyanthea_medicinal", "target_name": "Pedra da Silva", "similarity": 0.854}], "id": 4954, "stable_key": "clu_4b4bc18f42c377b5", "ground_truth": {"modern_name": "P\u00eadra de Osmar", "confidence": "medium", "type": "person", "description": "Sender of a letter and related to a fidalgo.", "note": "The names 'Pedra de O\u017fmar' and 'Pedra da Silva' appear to refer to the same individual, but the spelling variations introduce some uncertainty."}}, {"canonical_name": "Francia", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "francia", "book_id": "historia_medicinal_monardes_1574", "name": "Francia", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Francia"], "contexts": ["country that provided Pizarro", "country where King Envico ruled"]}, {"entity_id": "francia", "book_id": "ricettario_fiorentino_1597", "name": "Francia", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Francia"], "contexts": ["country where black amber is found"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Francia", "target_book": "ricettario_fiorentino_1597", "target_name": "Francia", "similarity": 1.0}], "id": 4955, "stable_key": "clu_91b614b8c88df838-3", "ground_truth": {"modern_name": "France", "confidence": "high", "type": "place", "description": "A country in Europe, referred to in historical and geographical contexts.", "wikipedia_extract": "France, officially the French Republic, is a country primarily located in Western Europe. Its overseas regions and territories include French Guiana in South America, Saint Pierre and Miquelon in the North Atlantic, the French West Indies, and many islands in Oceania and the Indian Ocean. Metropolitan France shares borders with Belgium and Luxembourg to the north; Germany to the northeast; Switzerland to the east; Italy and Monaco to the southeast; Andorra and Spain to the south; and a maritime border with the United Kingdom to the northwest. Its metropolitan area extends from the Rhine to the Atlantic Ocean and from the Mediterranean Sea to the English Channel and the North Sea. Its 18 integral regions\u2014five of which are overseas\u2014span a combined area of 632,702 km2 (244,288 sq mi), with a total population estimated at 69.1 million in 2026. Its capital, largest city and main cultural and economic centre is Paris."}}, {"canonical_name": "Alexandro Traliano", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "alexandro_traliano", "book_id": "historia_medicinal_monardes_1574", "name": "Alexandro Traliano", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Alexandro Traliano"], "contexts": ["ancient medical authority"]}, {"entity_id": "alexandre_traliano", "book_id": "polyanthea_medicinal", "name": "Alexandre Traliano", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Alexandre Traliano"], "contexts": ["ancient medical authority"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Alexandro Traliano", "target_book": "polyanthea_medicinal", "target_name": "Alexandre Traliano", "similarity": 0.918}], "id": 4956, "stable_key": "clu_0914dc82b13ed147-2", "ground_truth": {"modern_name": "Alexander of Tralles", "confidence": "high", "type": "person", "birth_year": 525, "death_year": 605, "description": "Byzantine Greek physician, author of 'Six Medical Books'", "wikidata_id": "Q708684", "wikidata_description": "eminent ancient physician", "wikipedia_url": "https://en.wikipedia.org/wiki/Alexander%20of%20Tralles", "wikipedia_extract": "Alexander of Tralles (Medieval Greek: \u1f08\u03bb\u03ad\u03be\u03b1\u03bd\u03b4\u03c1\u03bf\u03c2 \u1f41 \u03a4\u03c1\u03b1\u03bb\u03bb\u03b9\u03b1\u03bd\u03cc\u03c2; ca. 525 \u2013 ca. 605) was one of the most eminent physicians in the Byzantine Empire. His birth date may safely be put in the 6th century AD, for he mentions A\u00ebtius Amidenus, who probably did not write until the end of the 5th or the beginning of the 6th century, and he is himself quoted by Paul of Aegina, who is supposed to have lived in the 7th century; besides which, he is mentioned as a contemporary of Agathias, who set about writing his History in the beginning of the reign of Justin II, about 565. Alexander was born a Greek in Tralles in Asia Minor, and he had the advantage of being brought up under his father Stephanus, who was himself a physician, and also under another person, whose name he does not mention, but to whose son Cosmas he dedicates his chief work, which he wrote out of gratitude at his request. He was a man of an extensive practice, of a very long experience, and of great reputation, not only at Rome, but wherever he traveled in Spain, Gaul, and Italy, whence he was called by way of eminence \"Alexander the Physician\"."}}, {"canonical_name": "palpebras", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "palpebras", "book_id": "historia_medicinal_monardes_1574", "name": "palpebras", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["palpebras"], "contexts": ["eyelids"]}, {"entity_id": "palpebra", "book_id": "polyanthea_medicinal", "name": "palpebra", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["palpebra"], "contexts": ["body part affected by paralysis"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "palpebras", "target_book": "polyanthea_medicinal", "target_name": "palpebra", "similarity": 0.957}], "id": 4957, "stable_key": "clu_e753ebafa4ca470b", "ground_truth": {"modern_name": "eyelid", "confidence": "high", "type": "concept", "note": "The text refers to 'palpebras' as a body part affected by paralysis, clearly indicating the anatomical structure."}}, {"canonical_name": "vino caliente", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "vino_caliente", "book_id": "historia_medicinal_monardes_1574", "name": "vino caliente", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["vino caliente"], "contexts": ["with hot wine cures obstructions", "taken with hot wine"]}, {"entity_id": "vinho_muyto_quente", "book_id": "polyanthea_medicinal", "name": "vinho muyto quente", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["vinho muyto quente"], "contexts": ["hot wine for foot bath"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "vino caliente", "target_book": "polyanthea_medicinal", "target_name": "vinho muyto quente", "similarity": 0.952}], "id": 4958, "stable_key": "clu_520da411966c300f", "ground_truth": {"modern_name": "Hot wine", "confidence": "high", "type": "concept", "note": "This refers to wine that has been heated, often with spices, for medicinal or therapeutic purposes, as suggested by its use in cures and foot baths.", "wikidata_id": "Q6584", "wikidata_description": "red wine along with various spices and perhaps fruit or raisins", "wikipedia_url": "https://en.wikipedia.org/wiki/Mulled_wine", "wikipedia_extract": "Mead (, MEED), also called honey wine, and hydromel (particularly when low in alcohol content), is an alcoholic beverage made by fermenting honey mixed with water, and sometimes with added ingredients such as fruits, spices, grains, or hops. The alcoholic content ranges from about 3.5% ABV to more than 20%. Possibly the most ancient alcoholic drink, the defining characteristic of mead is that the majority of the beverage's fermentable sugar is derived from honey. It may be still, carbonated, or naturally sparkling, and despite a common misconception that mead is exclusively sweet, it can also be dry or semi-sweet. Mead that also contains spices is called metheglin (), and mead that contains fruit is called melomel. The term honey wine is sometimes used as a synonym for mead, although wine is typically defined to be the product of fermented grapes or certain other fruits, and some cultures have honey wines that are distinct from mead."}}, {"canonical_name": "Hermolao B\u00e1rbaro", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "hermolao_barbaro", "book_id": "historia_medicinal_monardes_1574", "name": "Hermolao Barbaro", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Hermolao Barbaro"], "contexts": ["learned man who spoke of Anime"]}, {"entity_id": "hermolao_b\u00e1rbaro", "book_id": "coloquios_da_orta_1563", "name": "Hermolao B\u00e1rbaro", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Hermolao B\u00e1rbaro"], "contexts": ["author of Castigat\u00edones Pliniarut", "ancient/medieval authority"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Hermolao Barbaro", "target_book": "coloquios_da_orta_1563", "target_name": "Hermolao B\u00e1rbaro", "similarity": 0.673}], "id": 4959, "stable_key": "clu_b45f7b16cd6546af", "ground_truth": {"modern_name": "Hermolaus Barbarus", "confidence": "high", "type": "person", "birth_year": 1454, "death_year": 1495, "description": "Italian humanist scholar and physician, known for Pliny translations."}}, {"canonical_name": "Diapalma", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "diapalma", "book_id": "historia_medicinal_monardes_1574", "name": "diapalma", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["diapalma"], "contexts": ["emplastrum applied to afflicted parts"]}, {"entity_id": "diapalma", "book_id": "polyanthea_medicinal", "name": "Diapalma", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Diapalma"], "contexts": ["ointment", "Diapalma plaster"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "diapalma", "target_book": "polyanthea_medicinal", "target_name": "Diapalma", "similarity": 0.986}], "id": 4960, "stable_key": "clu_dbf3ebca156e8a7b", "ground_truth": {"wikipedia_extract": "In pharmacology, diapalma (from Lat dia, \"made of\" + palma, \"palm\") is a desiccating or drying plaster, named for the wood of the palm tree, from which the spatula is made that is used to stir the mixture while boiling. It was formerly composed of common oil, hogs-fat, and litharge of gold; or also of palm oil, litharge, and zinc sulfate. Now, it is made of white wax, emplastrum simplex, and sulfate of zinc."}}, {"canonical_name": "Senhor", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "se\u00f1or", "book_id": "historia_medicinal_monardes_1574", "name": "se\u00f1or", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["se\u00f1or"], "contexts": ["lord who was purged with little quantity"]}, {"entity_id": "senhor", "book_id": "polyanthea_medicinal", "name": "Senhor", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Senhor"], "contexts": ["Lord", "Lord, referred to with Deos"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "se\u00f1or", "target_book": "polyanthea_medicinal", "target_name": "Senhor", "similarity": 0.934}], "id": 4961, "stable_key": "clu_90f0a71eb900a302", "ground_truth": {"modern_name": "Lord", "confidence": "low", "type": "person", "description": "A nobleman or person of high status, often a patient.", "note": "The term 'Se\u00f1or'/'Senhor' is a general title of respect or address, not a specific historical individual.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Lord", "wikipedia_extract": "Lord is an appellation for a person or deity who has authority, control, or power over others, acting as a master, chief, or ruler. The appellation can also denote certain persons who hold a title of the peerage in the United Kingdom, or are entitled to courtesy titles. The collective \"Lords\" can refer to a group or body of peers. According to the Oxford Dictionary of English, the etymology of the word can be traced back to the Old English word hl\u0101ford which originated from hl\u0101fweard meaning \"loaf-ward\" or \"bread-keeper\", reflecting the Germanic tribal custom of a chieftain providing food for his followers. The appellation \"lord\" is primarily applied to men, while for women the appellation \"lady\" is used. This is no longer universal: the Lord of Mann, a title previously held by the Queen of the United Kingdom, and female Lord Mayors are examples of women who are styled as \"Lord\"."}}, {"canonical_name": "Antonio", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "antonio", "book_id": "historia_medicinal_monardes_1574", "name": "Antonio", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Antonio"], "contexts": ["historical figure"]}, {"entity_id": "antonio", "book_id": "polyanthea_medicinal", "name": "Antonio", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Antonio"], "contexts": ["a young man with a medical condition", "individual with a specific stomach ferment"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Antonio", "target_book": "polyanthea_medicinal", "target_name": "Antonio", "similarity": 1.0}], "id": 4962, "stable_key": "clu_6eaf4b02ad632f61", "ground_truth": {"modern_name": "Anthony", "confidence": "low", "type": "person", "description": "A given name, likely referring to a patient or an acquaintance.", "note": "This refers to a common given name, not a specific identifiable historical figure in this context.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "camuesas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "camuesas", "book_id": "historia_medicinal_monardes_1574", "name": "camuesas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["camuesas"], "contexts": ["fruit size of camuesas"]}, {"entity_id": "camuesas", "book_id": "coloquios_da_orta_1563", "name": "camuesas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["camuesas"], "contexts": ["Fruits lacking from Portugal", "fruit lacking in India"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "camuesas", "target_book": "coloquios_da_orta_1563", "target_name": "camuesas", "similarity": 1.0}], "id": 4963, "stable_key": "clu_43b30622463aaef7-2", "ground_truth": {"modern_name": "quince", "confidence": "high", "type": "plant", "linnaean": "Cydonia oblonga", "family": "Rosaceae", "description": "A fragrant, yellow fruit used in cooking and medicine.", "wikipedia_extract": "The quince (; Cydonia oblonga) is the sole member of the genus Cydonia in the Malinae subtribe (which contains apples, pears, and other fruits) of the Rosaceae family. It is a deciduous tree that bears hard, aromatic bright golden-yellow pome fruit, similar in appearance to a pear. Ripe quince fruits are hard, tart, and astringent. They are eaten raw or processed into jam, quince cheese, or alcoholic drinks. The quince tree is sometimes grown as an ornamental plant for its attractive pale pink blossoms and as a miniature bonsai plant. Quinces are shrubs or small trees up to 4 to 6 metres (13 to 20 feet) tall and 3 to 4.5 metres (10 to 15 feet) wide.", "wikidata_id": "Q43300", "wikidata_description": "species of flowering plant in the rose family Rosaceae"}}, {"canonical_name": "azeytes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "azeytes", "book_id": "historia_medicinal_monardes_1574", "name": "azeytes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["azeytes"], "contexts": ["oils"]}, {"entity_id": "azeytes", "book_id": "polyanthea_medicinal", "name": "azeytes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["azeytes", "azeyto"], "contexts": ["oils, properties discussed", "oil"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "azeytes", "target_book": "polyanthea_medicinal", "target_name": "azeytes", "similarity": 1.0}], "id": 4964, "stable_key": "clu_07275e11ee88d3c1-2", "ground_truth": {"modern_name": "Olive oil", "confidence": "high", "type": "chemical", "note": "'Azeyte ordinario' and 'azeytes' in these texts refer to common oils, most frequently olive oil, used in preparations and ointments.", "wikidata_id": "Q2641560", "wikidata_description": "Process of extracting oil from olives", "wikipedia_url": "https://en.wikipedia.org/wiki/Olive%20oil%20extraction", "wikipedia_extract": "Olive oil is a vegetable oil obtained by pressing whole olives (the fruit of Olea europaea, a traditional tree crop of the Mediterranean Basin) and extracting the oil. It is commonly used in cooking for frying foods, as a condiment, or as a salad dressing. It can also be found in some cosmetics, pharmaceuticals, soaps, and fuels for traditional oil lamps. It also has additional uses in some religions. The olive is one of three core food plants in Mediterranean cuisine, with wheat and grapes. Olive trees have been cultivated around the Mediterranean since the 8th millennium BC."}}, {"canonical_name": "legno santo", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "palo_santto", "book_id": "historia_medicinal_monardes_1574", "name": "Palo santto", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Palo santto"], "contexts": ["holy wood, likely a medicinal tree"]}, {"entity_id": "legno_santo", "book_id": "ricettario_fiorentino_1597", "name": "legno santo", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["legno santo"], "contexts": ["common name for guaiacan wood", "source of oil"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Palo santto", "target_book": "ricettario_fiorentino_1597", "target_name": "legno santo", "similarity": 0.908}], "id": 4965, "stable_key": "clu_429878b7b9e72f30", "ground_truth": {"modern_name": "Guaiacum", "confidence": "high", "type": "plant", "linnaean": "Guaiacum officinale", "family": "Zygophyllaceae", "note": "Both 'legno santo' and 'Palo santto' are direct translations of 'holy wood' or 'sacred wood', which strongly corresponds to the common names for guaiacum, especially its medicinal use.", "wikidata_id": "Q1429385", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Guaiacum", "wikipedia_extract": "Guaiacum (), sometimes spelled Guajacum, is a genus of flowering plants in the caltrop family Zygophyllaceae. It contains five species of slow-growing shrubs and trees, reaching a height of approximately 20 m (66 ft) but usually less than half of that. All are native to subtropical and tropical regions of the Americas and are commonly known as lignum-vitae, guayac\u00e1n (Spanish), or ga\u00efac (French). The genus name originated in Ta\u00edno, the language spoken by the native Ta\u00ednos of the Bahamas; it was adopted into English in 1533, the first word in that language of American origin. Members of the genus have a variety of uses, including as lumber, for medicinal purposes, and as ornamentals. The trade of all species of Guaiacum is controlled under CITES Appendix II."}}, {"canonical_name": "caparrofa", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "caparro\u00eda", "book_id": "historia_medicinal_monardes_1574", "name": "caparro\u00eda", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["caparro\u00eda"], "contexts": ["oil for expelling poison"]}, {"entity_id": "caparrofa", "book_id": "polyanthea_medicinal", "name": "caparrofa", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["caparrofa"], "contexts": ["substance with emetic properties", "mucilaginous substance"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "caparro\u00eda", "target_book": "polyanthea_medicinal", "target_name": "caparrofa", "similarity": 0.951}], "id": 4966, "stable_key": "clu_4f71542e221baf2a", "ground_truth": {"modern_name": "Caparrofa", "confidence": "low", "type": "plant", "note": "The term 'caparrofa' appears to refer to a specific plant or substance used in historical medicine, but its precise modern identification is not readily available without further textual context. It is described as having emetic properties and being used in oils for expelling poison."}}, {"canonical_name": "planetary", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "planet\u00e1", "book_id": "historia_medicinal_monardes_1574", "name": "planet\u00e1", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["planet\u00e1"], "contexts": ["associated with specific metals by astrologers"]}, {"entity_id": "planetary", "book_id": "connexion_physical_sciences_somerville_1858", "name": "planetary", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["planetary", "Planetary"], "contexts": ["related to planets", "relating to planets, e.g., climates"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "planet\u00e1", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "planetary", "similarity": 0.887}], "id": 4967, "stable_key": "clu_90f086348564f396-3", "ground_truth": {"modern_name": "Astrology", "confidence": "high", "type": "concept", "wikidata_id": "Q34362", "wikidata_description": "ensemble of traditions, beliefs and divinations that interpret the positions of the planets and other celestial bodies; along with their correlation with terrestrial events", "note": "The context 'zodiac sign influencing body parts' clearly points to astrological signs. The broader meaning 'indicator or cue' is secondary in this medical/scientific context."}}, {"canonical_name": "Hermes", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "hermes", "book_id": "historia_medicinal_monardes_1574", "name": "Hermes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Hermes"], "contexts": ["ancient philosopher on metal duality"]}, {"entity_id": "hermes", "book_id": "polyanthea_medicinal", "name": "Hermes", "category": "PERSON", "subcategory": "PATRON", "count": 2, "variants": ["Hermes"], "contexts": ["Ancient authority, author of 'de radicibus'", "King of Damascus, grandfather of Mesues"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Hermes", "target_book": "polyanthea_medicinal", "target_name": "Hermes", "similarity": 0.719}], "id": 4968, "stable_key": "clu_9c378cc4a306b5fb", "ground_truth": {"modern_name": "Hermes Trismegistus", "confidence": "high", "type": "person", "description": "Legendary ancient philosopher and alchemical authority.", "note": "The mention of 'ancient philosopher on metal duality' and 'Ancient authority, author of 'de radicibus'' points to Hermes Trismegistus, a key figure in Hermeticism and alchemy."}}, {"canonical_name": "Aconito", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "\u00e1conito", "book_id": "historia_medicinal_monardes_1574", "name": "\u00c1conito", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["\u00c1conito"], "contexts": ["poisonous plant"]}, {"entity_id": "aconito", "book_id": "ricettario_fiorentino_1597", "name": "Aconito", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Aconito"], "contexts": ["species of Aconito", "herb that kills dogs"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "\u00c1conito", "target_book": "ricettario_fiorentino_1597", "target_name": "Aconito", "similarity": 0.947}], "id": 4969, "stable_key": "clu_bd5ab27e3a2ed770", "ground_truth": {"modern_name": "Aconite", "confidence": "high", "type": "plant", "linnaean": "Aconitum", "family": "Ranunculaceae", "wikidata_id": "Q155904", "wikidata_description": "genus of flowering plants in the buttercup family Ranunculaceae", "wikipedia_url": "https://en.wikipedia.org/wiki/Aconitum", "wikipedia_extract": "Aconitum (), also known as aconite, monkshood, wolfsbane, leopard's bane, devil's helmet, or blue rocket, is a genus of over 250 species of flowering plants belonging to the family Ranunculaceae. These herbaceous, frequently toxic perennial plants are chiefly native to the mountainous parts of the Northern Hemisphere in North America, Europe, and Asia, growing in the moisture-retentive but well-draining soils of mountain meadows. Most Aconitum species are extremely poisonous and must be handled very carefully. Several Aconitum hybrids, such as the Arendsii form of Aconitum carmichaelii, have won gardening awards\u2014such as the Royal Horticultural Society's Award of Garden Merit. The name aconitum comes from the Greek word \u1f00\u03ba\u03cc\u03bd\u03b9\u03c4\u03bf\u03bd, which may derive from the Greek akon for dart or javelin, the tips of which were poisoned with the substance, or from akonae, because of the rocky ground on which the plant was thought to grow. The Greek name lycoctonum, which translates literally to \"wolf's bane\", is thought to indicate the use of its juice to poison arrows or baits used to kill wolves."}}, {"canonical_name": "solutivas", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "solutivas", "book_id": "coloquios_da_orta_1563", "name": "solutivas", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["solutivas", "solutivos"], "contexts": ["dissolving quality"]}, {"entity_id": "solutive", "book_id": "ricettario_fiorentino_1597", "name": "solutive", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["solutive"], "contexts": ["dissolving medicines"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "solutivas", "target_book": "ricettario_fiorentino_1597", "target_name": "solutive", "similarity": 0.927}], "id": 4970, "stable_key": "clu_948a6707694c2c89", "ground_truth": {"modern_name": "Solutive", "confidence": "high", "type": "concept"}}, {"canonical_name": "justicia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "justicia", "book_id": "coloquios_da_orta_1563", "name": "justicia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["justicia", "justi\u00e7a"], "contexts": ["Latin for justice", "what is not found against Moorish kings"]}, {"entity_id": "justice", "book_id": "first_principles_spencer_1862", "name": "Justice", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Justice"], "contexts": ["mutual limitations in society"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "justicia", "target_book": "first_principles_spencer_1862", "target_name": "Justice", "similarity": 0.957}], "id": 4971, "stable_key": "clu_668f18554b26ef66", "ground_truth": {"modern_name": "Justice", "confidence": "high", "type": "concept", "note": "The term 'justicia' in Portuguese can refer to both the legal/ethical concept of justice and specific plants (e.g., Justicia sect. Jacobinia). Given the context 'mutual limitations in society', the concept of justice is the most likely referent.", "wikidata_id": "Q16533", "wikidata_description": "official who presides over court proceedings"}}, {"canonical_name": "bucho", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "bucho", "book_id": "coloquios_da_orta_1563", "name": "bucho", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["bucho", "buchos"], "contexts": ["shrunken stomach, cause of death", "stomachs of goats where the stone forms"]}, {"entity_id": "bucho", "book_id": "polyanthea_medicinal", "name": "bucho", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bucho"], "contexts": ["stomach of an animal"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "bucho", "target_book": "polyanthea_medicinal", "target_name": "bucho", "similarity": 1.0}], "id": 4972, "stable_key": "clu_bf502760d0058f8c-3", "ground_truth": {"modern_name": "Stomach", "confidence": "high", "type": "anatomical_part", "description": "The organ responsible for digestion and processing food.", "note": "Includes variations in spelling and the mention of its 'tunicas' (linings).", "wikipedia_extract": "The stomach is a muscular, hollow organ in the upper gastrointestinal tract of humans and many other animals, including several invertebrates. The Ancient Greek name for the stomach is gaster which is used as gastric in medical terms related to the stomach. The stomach has a dilated structure and functions as a vital organ in the digestive system. The stomach is involved in the gastric phase of digestion, following the cephalic phase in which the sight and smell of food and the act of chewing are stimuli. In the stomach a chemical breakdown of food takes place by means of secreted  digestive enzymes and gastric acid. It also plays a role in regulating gut microbiota, influencing digestion and overall health.", "wikidata_id": "Q156103", "wikidata_description": "medical condition characterized by inflammation of the stomach and/or small intestine"}}, {"canonical_name": "Mombaim", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mombaim", "book_id": "coloquios_da_orta_1563", "name": "Mombaim", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Mombaim", "Momba\u00e7a"], "contexts": ["city and island with better areca", "city on African coast with Baneanes"]}, {"entity_id": "momba\u00e7a", "book_id": "polyanthea_medicinal", "name": "Momba\u00e7a", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Momba\u00e7a"], "contexts": ["origin of snake stone"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Mombaim", "target_book": "polyanthea_medicinal", "target_name": "Momba\u00e7a", "similarity": 0.891}], "id": 4973, "stable_key": "clu_2fe266cf0083d985", "ground_truth": {"modern_name": "Bombay", "confidence": "high", "type": "place", "description": "A major port city in India, historically a center of trade.", "note": "Includes historical spellings like 'Bombaim' and a potential confusion with Mombasa.", "wikipedia_extract": "Mumbai ( muum-BY; Marathi: Mumba\u012b, pronounced [\u02c8mumb\u0259i] ), also known as Bombay ( bom-BAY; its official name until 1995), is the capital city of the Indian state of Maharashtra. Mumbai is the financial capital and the most populous city proper of India, with an estimated population of 12.5 million (1.25 crore). Mumbai is the centre of the Mumbai Metropolitan Region, which is among the most populous metropolitan areas in the world with a population of over 23 million (2.3 crore). Mumbai lies on the Konkan coast on the west coast of India and has a deep natural harbour. In 2008, Mumbai was named a alpha world city. Mumbai has the highest number of billionaires out of any city in Asia."}}, {"canonical_name": "kely", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "kely", "book_id": "coloquios_da_orta_1563", "name": "kely", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["kely", "kelay"], "contexts": ["Indian name for banana"]}, {"entity_id": "little", "book_id": "polyanthea_medicinal", "name": "little", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["little"], "contexts": ["quantity of blood"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "kely", "target_book": "polyanthea_medicinal", "target_name": "little", "similarity": 0.913}], "id": 4974, "stable_key": "clu_d4560cd416568a39", "ground_truth": {"modern_name": "Banana", "confidence": "medium", "type": "plant", "family": "Musaceae", "note": "The context states 'Indian name for banana'. While 'kely' could be related to a diminutive in some languages, in the context of the text by Orta (known for describing Eastern plants), it's likely referring to an indigenous name for a plant, and banana is a strong candidate given the commonality of its cultivation and description in early modern texts.", "wikidata_id": "Q503", "wikidata_description": "elongated, edible fruit produced by several kinds of large herbaceous flowering plants in the genus Musa"}}, {"canonical_name": "Aldrovando", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "aldrovando", "book_id": "coloquios_da_orta_1563", "name": "Aldrovando", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Aldrovando", "\u00c2ldrovando"], "contexts": ["author of a book", "author of a book where 'poma paradisea' is applied"]}, {"entity_id": "aldrovando", "book_id": "polyanthea_medicinal", "name": "Aldrovando", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Aldrovando"], "contexts": ["author cited for properties of clay"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Aldrovando", "target_book": "polyanthea_medicinal", "target_name": "Aldrovando", "similarity": 1.0}], "id": 4975, "stable_key": "clu_b2abe09ab6652e30", "ground_truth": {"modern_name": "Ulysses Aldrovandi", "confidence": "high", "type": "person", "birth_year": 1522, "death_year": 1605, "description": "Italian naturalist, botanist, and entomologist, founder of the Bologna museum.", "wikidata_id": "Q321358", "wikidata_description": "Italian naturalist (1522-1605)", "wikipedia_url": "https://en.wikipedia.org/wiki/Ulisse%20Aldrovandi", "wikipedia_extract": "Ulisse Aldrovandi (11 September 1522 \u2013 4 May 1605) was an Italian naturalist, the moving force behind Bologna's botanical garden, one of the first in Europe. Carl Linnaeus and the comte de Buffon reckoned him the father of natural history studies. He is usually referred to, especially in older scientific literature in Latin, as Aldrovandus; his name in Italian is equally given as Aldroandi. Aldrovandi was born in Bologna to Teseo Aldrovandi and his wife, a noble but poor family. His father was a lawyer, and Secretary to the Senate of Bologna, but died when Ulisse was seven years old. His widowed mother wanted him to become a jurist."}}, {"canonical_name": "ulceras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ulceras", "book_id": "coloquios_da_orta_1563", "name": "ulceras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["ulceras", "ulceras da bexiga"], "contexts": ["ulcers treated with cataplasm", "bladder ulcers"]}, {"entity_id": "ulcus", "book_id": "polyanthea_medicinal", "name": "ulcus", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["ulcus"], "contexts": ["wound mentioned in Hippocrates"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "ulceras", "target_book": "polyanthea_medicinal", "target_name": "ulcus", "similarity": 0.924}], "id": 4976, "stable_key": "clu_0b4d74ea7e150586", "ground_truth": {"modern_name": "Ulcers", "confidence": "high", "type": "disease", "modern_term": "Ulcers", "wikidata_id": "Q1477", "wikidata_description": "inflammatory bowel disease that causes ulcers in the colon", "wikipedia_url": "https://en.wikipedia.org/wiki/Ulcerative%20colitis", "wikipedia_extract": "Ulcerative colitis (UC) is one of the two types of inflammatory bowel disease (IBD), with the other type being Crohn's disease. It is a long-term condition that results in inflammation and ulcers of the colon and rectum. The primary symptoms of active disease are abdominal pain and diarrhea mixed with blood (hematochezia). Weight loss, fever, and anemia may also occur. Often, symptoms come on slowly and can range from mild to severe. Symptoms typically occur intermittently with periods of no symptoms between flares."}}, {"canonical_name": "falsifica\u00e7am", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "falsifica\u00e7am", "book_id": "coloquios_da_orta_1563", "name": "falsifica\u00e7am", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["falsifica\u00e7am", "falsificadas"], "contexts": ["falsification of the stone", "state of being counterfeit"]}, {"entity_id": "falsificado", "book_id": "polyanthea_medicinal", "name": "falsificado", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["falsificado"], "contexts": ["falsified, referring to remedies"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "falsifica\u00e7am", "target_book": "polyanthea_medicinal", "target_name": "falsificado", "similarity": 0.941}], "id": 4977, "stable_key": "clu_48024ba01f6a433b", "ground_truth": {"modern_name": "Falsification", "confidence": "high", "type": "concept", "note": "Refers to the act of making something counterfeit or imitation.", "wikidata_id": "Q1332286", "wikidata_description": "process of making, adapting, or imitating objects, statistics, or documents with the intent to deceive", "wikipedia_extract": "Preference falsification is the act of misrepresenting a preference under perceived public pressure. It involves publicly expressing a preference that differs from one's underlying privately held preference (or simply, a public preference at odds with one\u2019s private preference). People frequently convey to each other preferences that differ from what they would communicate privately under credible cover of anonymity (such as in opinion surveys to researchers or pollsters). Techniques such as list experiments can be used to uncover preference falsification. The term was coined by economist and political scientist Timur Kuran in a 1987 article, \"Chameleon voters and public choice.\" On controversial matters that induce preference falsification, he showed there, widely disliked policies may appear popular. The distribution of public preferences, which Kuran defines as public opinion, may differ greatly from private opinion, which is the distribution of private preferences known only to individuals themselves.", "wikipedia_url": "https://en.wikipedia.org/wiki/Forgery"}}, {"canonical_name": "Juniperos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "juniperos", "book_id": "coloquios_da_orta_1563", "name": "Juniperos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Juniperos", "junipero"], "contexts": ["trees compared to pepper trees", "plant compared to pimenta"]}, {"entity_id": "junipero", "book_id": "polyanthea_medicinal", "name": "junipero", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["junipero"], "contexts": ["ingredient for anti-paralytic confection"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Juniperos", "target_book": "polyanthea_medicinal", "target_name": "junipero", "similarity": 0.887}], "id": 4978, "stable_key": "clu_0a86eca5a0cc1abd", "ground_truth": {"modern_name": "Juniper Berries", "confidence": "high", "type": "plant", "linnaean": "Juniperus communis", "family": "Cupressaceae", "description": "The small, bluish-black, aromatic cones of the juniper tree, used medicinally.", "wikipedia_extract": "Juniperus communis, the common juniper, is a species of small tree or shrub in the cypress family Cupressaceae. An evergreen conifer, it has the largest geographical range of any woody plant, with a Holarctic distribution throughout the cool temperate Northern Hemisphere. Juniperus communis is highly variable in form, ranging from 10 metres (33 feet)\u2014rarely 16 m (52 ft)\u2014tall to a low, often prostrate spreading shrub in exposed locations. It has needle-like leaves in whorls of three; the leaves are green, with a single white stomatal band on the inner surface. It never attains the scale-like adult foliage of other members of the genus. It is dioecious, with male and female cones on separate plants so requiring wind pollination to transfer pollen from male to female cones."}}, {"canonical_name": "Rufo", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "rufo", "book_id": "coloquios_da_orta_1563", "name": "Rufo", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Rufo"], "contexts": ["ancient authority on medicine", "physician whose pills were changed"]}, {"entity_id": "rufo", "book_id": "polyanthea_medicinal", "name": "Rufo", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Rufo"], "contexts": ["made pestilential pyrolas"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Rufo", "target_book": "polyanthea_medicinal", "target_name": "Rufo", "similarity": 1.0}], "id": 4979, "stable_key": "clu_60dd105945060693", "ground_truth": {"modern_name": "Rufus of Ephesus", "confidence": "high", "type": "person", "birth_year": 70, "death_year": 130, "description": "Greek physician and medical writer, known for anatomical and pathological studies."}}, {"canonical_name": "fel", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "fel", "book_id": "coloquios_da_orta_1563", "name": "fel", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["fel"], "contexts": ["animal bile", "bile, a bodily fluid"]}, {"entity_id": "fel_della", "book_id": "polyanthea_medicinal", "name": "fel della", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["fel della"], "contexts": ["ingredient in a powder"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "fel", "target_book": "polyanthea_medicinal", "target_name": "fel della", "similarity": 0.919}], "id": 4980, "stable_key": "clu_2c1d53d7c3037041", "ground_truth": {"modern_name": "Bile", "confidence": "high", "type": "chemical", "wikidata_id": "Q208006", "wikidata_description": "central district and city in Bilecik Province, Turkey", "wikipedia_url": "https://en.wikipedia.org/wiki/Bilecik"}}, {"canonical_name": "gesso", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "gesso", "book_id": "coloquios_da_orta_1563", "name": "gesso", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["gesso"], "contexts": ["used to sophisticate substances", "plaster used as adulterant"]}, {"entity_id": "gesso", "book_id": "polyanthea_medicinal", "name": "gesso", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["gesso"], "contexts": ["gypsum used in preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "gesso", "target_book": "polyanthea_medicinal", "target_name": "gesso", "similarity": 1.0}], "id": 4981, "stable_key": "clu_1912aecbbb0020f3-3", "ground_truth": {"modern_name": "Gypsum", "confidence": "high", "type": "mineral", "wikidata_id": "Q82658", "wikidata_description": "mineral, calcium sulfate with bounded water", "wikipedia_url": "https://en.wikipedia.org/wiki/Gypsum", "wikipedia_extract": "Gypsum is a soft sulfate mineral composed of calcium sulfate dihydrate, with the chemical formula CaSO4\u00b72H2O. It is widely mined and is used as a fertilizer and as the main constituent in many forms of plaster, drywall and blackboard or sidewalk chalk. Gypsum also crystallizes as translucent crystals of selenite. It forms as an evaporite mineral and as a hydration product of anhydrite. The Mohs scale of mineral hardness defines gypsum as hardness value 2 based on scratch hardness comparison. Fine-grained white or lightly tinted forms of gypsum known as alabaster have been used for sculpture by many cultures including Ancient Egypt, Mesopotamia, Ancient Rome, the Byzantine Empire, and the Nottingham alabasters of Medieval England.", "note": "The term 'gesso' in this context refers to gypsum, a mineral commonly used in medicinal preparations and sometimes for adulteration."}}, {"canonical_name": "Lagrimas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "lagrimas", "book_id": "coloquios_da_orta_1563", "name": "Lagrimas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Lagrimas"], "contexts": ["tears", "coagulated and dry liquid from trees"]}, {"entity_id": "in_lagrima", "book_id": "ricettario_fiorentino_1597", "name": "in lagrima", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["in lagrima"], "contexts": ["form of storax"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Lagrimas", "target_book": "ricettario_fiorentino_1597", "target_name": "in lagrima", "similarity": 0.894}], "id": 4982, "stable_key": "clu_03ac3300f294cbec", "ground_truth": {"modern_name": "Tears", "confidence": "high", "type": "substance", "description": "Bodily fluid secreted by the eyes, or substances resembling it.", "note": "Can refer to literal tears or plant exudates described as such.", "wikipedia_extract": "Tears (tear film) are a transparent fluid secreted primarily by the lacrimal glands (tear gland) found in the eyes of all land mammals. According to the mode of production, tears are classified into four types: basal, closed eye, emotional, and reflex. The basal rate of tear secretion is ~0.5\u20132.2 \u00b5L/min, and irritation can increase secretion by up to ~100-fold, reaching ~300 \u00b5L/min. Tears are made up of water, electrolytes, proteins, lipids, and mucins that form layers on the surface of eyes. The four types of tears differ significantly in their composition. Some of the functions of tears include lubricating the eyes (basal tears), removing irritants (reflex tears), and also aiding the immune system.", "wikidata_id": "Q13614861", "wikidata_description": "genus of insects"}}, {"canonical_name": "D. Pedro Mascarenhas", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "d__pedro_mascarenhas", "book_id": "coloquios_da_orta_1563", "name": "D. Pedro Mascarenhas", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["D. Pedro Mascarenhas"], "contexts": ["historical figure, ambassador in Rome", "vice-re\u00ed who tried to curb luxury"]}, {"entity_id": "dom_francisco_mascarenhas", "book_id": "polyanthea_medicinal", "name": "Dom Francisco Mascarenhas", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Dom Francisco Mascarenhas"], "contexts": ["patient who recovered from illness"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "D. Pedro Mascarenhas", "target_book": "polyanthea_medicinal", "target_name": "Dom Francisco Mascarenhas", "similarity": 0.879}], "id": 4983, "stable_key": "clu_e792a977b8bf8039", "ground_truth": {"modern_name": "Pedro Mascarenhas", "confidence": "high", "type": "person", "description": "Historical figure, ambassador, and patient who recovered from illness.", "note": "While 'Dom Francisco Mascarenhas' is also mentioned, 'D. Pedro Mascarenhas' is more frequent and likely the primary referent.", "wikidata_id": "Q527755", "wikidata_description": "Portuguese explorer and colonial administrator"}}, {"canonical_name": "cr\u00edsteis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cr\u00edsteis", "book_id": "coloquios_da_orta_1563", "name": "cr\u00edsteis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["cr\u00edsteis"], "contexts": ["medicinal suppositories", "medicinal preparation from fruit peels"]}, {"entity_id": "cristaes", "book_id": "polyanthea_medicinal", "name": "cristaes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["cristaes"], "contexts": ["substance derived from wine residue"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "cr\u00edsteis", "target_book": "polyanthea_medicinal", "target_name": "cristaes", "similarity": 0.936}], "id": 4984, "stable_key": "clu_a1d2d040c1c3f84d", "ground_truth": {"modern_name": "Suppositories", "confidence": "high", "type": "object", "note": "The context 'medicinal suppositories' is a direct match. 'Cristaes' could refer to crystals, but in a medicinal context related to wine residue, it could also point to effervescence or crystalline precipitates used in preparations like suppositories.", "wikidata_id": "Q180799", "wikidata_description": "dosage form used to deliver medications by insertion into a body orifice where it dissolves or melts to exert local or systemic effects", "wikipedia_url": "https://en.wikipedia.org/wiki/Suppository", "wikipedia_extract": "Intravaginal administration is a route of administration where the substance is applied inside the vagina. Pharmacologically, it has the potential advantage to result in effects primarily in the vagina or nearby structures (such as the vaginal portion of cervix) with limited systemic adverse effects compared to other routes of administration. Formulation methods include vaginal tablets, vaginal cream, vaginal gel, vaginal suppository and vaginal ring. It is used as an administration method for issues related to women's health, such as contraception. Medicines primarily delivered by intravaginal administration include vaginally administered estrogens and progestogens (a group of hormones including progesterone), and antibacterials and antifungals to treat bacterial vaginosis and yeast infections respectively. Medicines may also be administered intravaginally as an alternative to oral route in the case of nausea or other digestive problems."}}, {"canonical_name": "Falconer", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "falconer", "book_id": "coloquios_da_orta_1563", "name": "Falconer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Falconer"], "contexts": ["identified plant", "observed the costus plant and its drug"]}, {"entity_id": "falconet", "book_id": "polyanthea_medicinal", "name": "Falconet", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Falconet"], "contexts": ["doctor cited"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Falconer", "target_book": "polyanthea_medicinal", "target_name": "Falconet", "similarity": 0.883}], "id": 4985, "stable_key": "clu_f8823d2f42813a21", "ground_truth": {"modern_name": "Falconer", "confidence": "medium", "type": "person", "description": "Doctor and scholar cited for plant identification and medical practice.", "note": "The name 'Falconet' is a plausible misspelling or variant, but 'Falconer' is the more common form for historical scholars/doctors. Without more context, certainty is reduced.", "wikidata_id": "Q28001428", "wikidata_description": "person who breeds, trains, or hunts with hawks"}}, {"canonical_name": "adstringente", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "adstringente", "book_id": "coloquios_da_orta_1563", "name": "adstringente", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["adstringente"], "contexts": ["property of areca", "medicinal property of sandalwood"]}, {"entity_id": "adstringunt", "book_id": "polyanthea_medicinal", "name": "adstringunt", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["adstringunt"], "contexts": ["to astringe, a remedy for tremors"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "adstringente", "target_book": "polyanthea_medicinal", "target_name": "adstringunt", "similarity": 0.934}], "id": 4986, "stable_key": "clu_a1a089f01ba66c75-2", "ground_truth": {"modern_name": "Astringent", "confidence": "high", "type": "concept", "note": "The context of properties of areca and remedies for tremors clearly indicates an astringent quality or action.", "wikidata_id": "Q378705", "wikidata_description": "chemical compound that tends to shrink or constrict body tissues", "description": "A substance that causes tissues to contract or tighten.", "wikipedia_extract": "An astringent (sometimes called adstringent) is a chemical that shrinks or constricts body tissues. The word derives from the Latin adstringere, which means \"to bind fast\". Astringency, the dry, puckering or numbing mouthfeel caused by the tannins in unripe fruits, lets the fruit mature by deterring eating. Tannins, being a kind of polyphenol, bind salivary proteins and make them precipitate and aggregate, producing a rough, \"sandpapery\", or dry sensation in the mouth. Smoking tobacco is also reported to have an astringent effect. In a scientific study, astringency was still detectable by subjects who had local anesthesia applied to their taste nerves, but not when both these and the trigeminal nerves were disabled."}}, {"canonical_name": "letrados", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "letrados", "book_id": "coloquios_da_orta_1563", "name": "letrados", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["letrados"], "contexts": ["Legal experts appointed by sovereigns", "learned individuals"]}, {"entity_id": "letrados", "book_id": "polyanthea_medicinal", "name": "Letrados", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Letrados"], "contexts": ["learned individuals"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "letrados", "target_book": "polyanthea_medicinal", "target_name": "Letrados", "similarity": 0.665}], "id": 4987, "stable_key": "clu_0589033f26cd34f9", "ground_truth": {"modern_name": "Legal scholar", "confidence": "high", "type": "person", "description": "Learned individuals, often with legal or academic expertise.", "wikidata_id": "Q185351", "wikidata_description": "legal scholar or academic, a professional who studies, teaches, and develops law", "wikipedia_url": "https://en.wikipedia.org/wiki/Jurist", "wikipedia_extract": "A jurist is a person with expert knowledge of law; someone who analyzes and comments on law. This person is usually a specialist legal scholar, mostly (but not always) with a formal education in law (a law degree) and often a legal practitioner. In the United Kingdom the term \"jurist\" is mostly used for legal academics, while in the United States the term may also be applied to a judge. With reference to Roman law, a \"jurist\" (in English) is a jurisconsult (iurisconsultus). The English term jurist is to be distinguished from similar terms in other European languages, where it may be synonymous with legal professional, meaning anyone with a professional law degree that qualifies for admission to the legal profession, including such positions as judge or attorney. In Germany, Scandinavia and a number of other countries jurist denotes someone with a professional law degree, and it may be a protected title, such as in Norway."}}, {"canonical_name": "bax\u00e1j", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "bax\u00e1j", "book_id": "coloquios_da_orta_1563", "name": "bax\u00e1j", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["bax\u00e1j"], "contexts": ["title for governor", "title for governor in Alepo"]}, {"entity_id": "ba\u0433\u0430\u0431", "book_id": "polyanthea_medicinal", "name": "Ba\u0433\u0430\u0431", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Ba\u0433\u0430\u0431"], "contexts": ["title of nobility"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "bax\u00e1j", "target_book": "polyanthea_medicinal", "target_name": "Ba\u0433\u0430\u0431", "similarity": 0.869}], "id": 4988, "stable_key": "clu_f4225c31982f6d39", "ground_truth": {"modern_name": "Pasha", "confidence": "high", "type": "person", "description": "High-ranking official or nobleman, often in the Ottoman Empire.", "note": "The spelling 'Ba\u0433\u0430\u0431' in polyanthea_medicinal appears to be a transcription error or archaic spelling.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Savonarola", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "savonarola", "book_id": "coloquios_da_orta_1563", "name": "Savonarola", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Savonarola"], "contexts": ["alternative spelling of Savanerola", "physician who wrote medical books"]}, {"entity_id": "savonarola", "book_id": "polyanthea_medicinal", "name": "Savonarola", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["Savonarola"], "contexts": ["physician of the Duke's household"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Savonarola", "target_book": "polyanthea_medicinal", "target_name": "Savonarola", "similarity": 0.71}], "id": 4989, "stable_key": "clu_53a30ee2f7643114", "ground_truth": {"modern_name": "Girolamo Savonarola", "confidence": "high", "type": "person", "birth_year": 1452, "death_year": 1498, "description": "Italian Dominican friar, preacher, and executed ruler of Florence.", "note": "The context 'physician of the Duke's household' might refer to a different Savonarola or a misinterpretation within the text, as Girolamo Savonarola was primarily a religious and political figure.", "wikidata_id": "Q164823", "wikidata_description": "Italian Dominican friar and preacher (1452-1498)"}}, {"canonical_name": "pre\u00e7o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pre\u00e7o", "book_id": "coloquios_da_orta_1563", "name": "pre\u00e7o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["pre\u00e7o"], "contexts": ["price", "monetary value"]}, {"entity_id": "price", "book_id": "first_principles_spencer_1862", "name": "price", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["price"], "contexts": ["monetary value of goods"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "pre\u00e7o", "target_book": "first_principles_spencer_1862", "target_name": "price", "similarity": 0.973}], "id": 4990, "stable_key": "clu_d94bb832b4cba896", "ground_truth": {"modern_name": "Price", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "panditos", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "panditos", "book_id": "coloquios_da_orta_1563", "name": "panditos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["panditos"], "contexts": ["Hindu priests or scholars", "religious scholars"]}, {"entity_id": "panditos", "book_id": "polyanthea_medicinal", "name": "Panditos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Panditos"], "contexts": ["natural healers in India"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "panditos", "target_book": "polyanthea_medicinal", "target_name": "Panditos", "similarity": 0.956}], "id": 4991, "stable_key": "clu_1b2dc985237fba3d", "ground_truth": {"modern_name": "Pandits", "confidence": "high", "type": "person", "description": "Hindu priests, scholars, or healers in India.", "wikidata_id": "Q2336535", "wikidata_description": "native explorers who assisted the British in surveying Tibet and Central Asia; used as their pseudonym in accounts of their reports", "wikipedia_url": "https://en.wikipedia.org/wiki/Pundit%20%28explorer%29", "wikipedia_extract": "The term pundit was used in the second half of the 19th century to denote native Indian surveyors used by the British to secretly explore regions north of British India. The Pundit was the code-name for one of the first native explorers, Nain Singh, who was originally a schoolteacher (or pundit). His accomplishments were so remarkable that the whole group of around twenty native explorers became known as the Pundits. Two of the most famous pundits included the cousins Nain Singh and Kishen Singh (code-named A.K.) One of the greatest projects of 19th century geography was the Great Trigonometrical Survey of India. The British also wanted geographical information on the lands further north. This was not just out of scientific curiosity: the Russians were attempting to expand their empire into Central Asia, and the British feared that they might have set their eyes on gaining the riches of India, which was at that time a British colony."}}, {"canonical_name": "Papa Paulo IV", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "papa_paulo_iv", "book_id": "coloquios_da_orta_1563", "name": "Papa Paulo IV", "category": "PERSON", "subcategory": "PATRON", "count": 2, "variants": ["papa Paulo IV", "Papa Paulo IV"], "contexts": ["sent Rontecalli to India", "Pope Paul IV"]}, {"entity_id": "paulo_iv_", "book_id": "polyanthea_medicinal", "name": "Paulo IV.", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Paulo IV."], "contexts": ["Pope who suffered from erysipelas"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Papa Paulo IV", "target_book": "polyanthea_medicinal", "target_name": "Paulo IV.", "similarity": 0.94}], "id": 4992, "stable_key": "clu_f3d6f5723c7cea7d", "ground_truth": {"modern_name": "Pope Paul IV", "confidence": "high", "type": "person", "birth_year": 1476, "death_year": 1559, "description": "Pope during the Counter-Reformation, known for his policies.", "note": "Both 'Papa Paulo IV' and 'Paulo IV.' clearly refer to Pope Paul IV, a significant figure in the 16th century, aligning with the early modern period.", "wikidata_id": "Q101430", "wikidata_description": "pope of catholic church 1555-1559", "wikipedia_extract": "This page is a list of popes by country of origin and nationality. There have been 265 popes, from the continents of Asia, Europe, Africa, South America, and North America. Since the office of pope has existed for almost two millennia, many of the countries of origin of popes no longer exist, and so they are grouped under three periods: the Roman Empire period, the Middle Ages to modernity, and since the creation of Vatican City with the 1929 Lateran Treaty. Countries are listed in chronological order within each section. As of 2025, 265 men have been pope, with at least one pope hailing (in chronological order) from Asia (9), Europe (251), Africa (3), or the Americas (2). Every pope since Pope Pius XI has been a citizen of Vatican City (established in the 1929 Lateran Treaty).", "wikipedia_url": "https://en.wikipedia.org/wiki/Pope_Paul_IV"}}, {"canonical_name": "Bonif\u00e1", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "bonif\u00e1", "book_id": "coloquios_da_orta_1563", "name": "Bonif\u00e1", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Bonif\u00e1"], "contexts": ["cited authority", "cited by Serapio"]}, {"entity_id": "bonifucci", "book_id": "polyanthea_medicinal", "name": "Bonifucci", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Bonifucci"], "contexts": ["cited author on nourishing foods"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Bonif\u00e1", "target_book": "polyanthea_medicinal", "target_name": "Bonifucci", "similarity": 0.849}], "id": 4993, "stable_key": "clu_74f94c549b5d15f6", "ground_truth": {"modern_name": "Boniface", "confidence": "medium", "type": "person", "description": "Cited authority on nutrition and health in early modern texts.", "note": "The name 'Bonif\u00e1' and 'Bonifucci' likely refer to an author or scholar cited in these texts. The common element is 'Boniface'. It's difficult to pinpoint a specific historical figure with certainty without more context, but it refers to a cited authority.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "The Universit\u00e9 de Saint-Boniface (USB) is a French-language public university located in the St. Boniface neighbourhood of Winnipeg, Manitoba, Canada. An affiliated institution of the University of Manitoba, the university offers general and specialized university degree programs as well as technical and professional training. In 2014, 1,368 regular students were enrolled. Its Continuing Education Division, which includes a language school, has also counted over 4,200 enrolments. Universit\u00e9 de Saint-Boniface was established by Father Norbert Provencher (1787\u20131853) in 1818, making it western Canada's oldest post-secondary educational institution.", "wikipedia_url": "https://en.wikipedia.org/wiki/Boniface_%28name%29"}}, {"canonical_name": "sorveira", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "sorveira", "book_id": "coloquios_da_orta_1563", "name": "sorveira", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["sorveira"], "contexts": ["tree where lacre does not grow", "tree name"]}, {"entity_id": "sorveyra", "book_id": "polyanthea_medicinal", "name": "Sorveyra", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Sorveyra"], "contexts": ["tree name"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "sorveira", "target_book": "polyanthea_medicinal", "target_name": "Sorveyra", "similarity": 0.895}], "id": 4994, "stable_key": "clu_b640a92101ca332a", "ground_truth": {"modern_name": "Strawberry Tree", "confidence": "high", "type": "plant", "linnaean": "Arbutus unedo Linnaeus", "family": "Ericaceae", "note": "The 'sorveira' or 'sorveira' is a Portuguese name for Arbutus unedo, commonly known as the Strawberry Tree. 'Sorvas' could be a variation or related term.", "wikidata_id": "Q329046", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Arbutus_unedo", "wikipedia_extract": "Arbutus unedo, commonly known as strawberry tree, also called madrone, is an evergreen shrub or small tree in the family Ericaceae, native to the Mediterranean Basin and Western Europe. The tree is well known for its fruits, the arbutus berry, which bear some resemblance to the strawberry, hence the common name strawberry tree. However, it is not closely related to true strawberries of the genus Fragaria. Its presence in Ireland also lends it the name Irish strawberry tree, or cain, or cane apple (from the Irish name for the tree, caithne), or sometimes Killarney strawberry tree. The strawberry tree is the national tree of Italy because of its green leaves, its white flowers and its red berries, colors that recall the Italian flag. The flower of the strawberry tree is the national flower of Italy."}}, {"canonical_name": "voto", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "voto", "book_id": "coloquios_da_orta_1563", "name": "voto", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["voto"], "contexts": ["Opinion or judgment"]}, {"entity_id": "voto", "book_id": "polyanthea_medicinal", "name": "voto", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["voto", "voto contrario"], "contexts": ["opinion", "opposition to a medical decision"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "voto", "target_book": "polyanthea_medicinal", "target_name": "voto", "similarity": 1.0}], "id": 4995, "stable_key": "clu_0b56640bfae1c41c-4", "ground_truth": {"modern_name": "Opinion", "confidence": "high", "type": "concept", "wikidata_id": "Q2271421", "wikidata_description": "use of natural language processing, text analysis and computational linguistics to identify and extract subjective information in source materials"}}, {"canonical_name": "gera\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "gera\u00e7\u00e3o", "book_id": "coloquios_da_orta_1563", "name": "gera\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["gera\u00e7\u00e3o"], "contexts": ["lineage or birth"]}, {"entity_id": "gera\u00e7\u00e3o", "book_id": "polyanthea_medicinal", "name": "gera\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["gera\u00e7\u00e3o"], "contexts": ["the process of reproduction", "process of procreation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "gera\u00e7\u00e3o", "target_book": "polyanthea_medicinal", "target_name": "gera\u00e7\u00e3o", "similarity": 1.0}], "id": 4996, "stable_key": "clu_6a1713f883116d11-2", "ground_truth": {"modern_name": "Generation", "confidence": "high", "type": "concept", "note": "Refers to the process of reproduction and lineage, common in biological and philosophical discussions."}}, {"canonical_name": "evapora\u00e7ao", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "evapora", "book_id": "coloquios_da_orta_1563", "name": "evapora", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["evapora"], "contexts": ["turns into vapor"]}, {"entity_id": "evapora\u00e7ao", "book_id": "polyanthea_medicinal", "name": "evapora\u00e7ao", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["evapora\u00e7ao"], "contexts": ["evaporation, a process of vaporization", "evaporation causing syncope"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "evapora", "target_book": "polyanthea_medicinal", "target_name": "evapora\u00e7ao", "similarity": 0.895}], "id": 4997, "stable_key": "clu_6670b0485f8d8198-2", "ground_truth": {"modern_name": "Evaporation", "confidence": "high", "type": "concept", "wikidata_id": "Q132814", "wikidata_description": "type of vaporization of a liquid that occurs from its surface; surface phenomenon"}}, {"canonical_name": "gergelim", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "gergelim", "book_id": "coloquios_da_orta_1563", "name": "gergelim", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["gergelim"], "contexts": ["sesame, used for oil"]}, {"entity_id": "gergelim", "book_id": "polyanthea_medicinal", "name": "gergelim", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["gergelim"], "contexts": ["oil used in a liniment", "sesame used in fomentations"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "gergelim", "target_book": "polyanthea_medicinal", "target_name": "gergelim", "similarity": 1.0}], "id": 4998, "stable_key": "clu_807d59637c2019e7", "ground_truth": {"modern_name": "Sesame", "confidence": "high", "type": "plant", "linnaean": "Sesamum indicum L.", "family": "Pedaliaceae", "note": "The term 'gergelim' is the Portuguese word for sesame, a plant well-known for its oil used in medicinal preparations.", "wikipedia_extract": "Sesame (; Sesamum indicum) is a plant in the genus Sesamum, also called benne. Numerous wild relatives occur in Africa and a smaller number in India. It is widely naturalized in tropical regions around the world and is cultivated for its edible seeds, which grow in pods. World production in 2018 was 6 million tonnes (5.9 million long tons), with Sudan, Myanmar, and India as the largest producers. Sesame seed is one of the oldest oilseed crops known, domesticated well over 3,000 years ago. Sesamum has many other species, most being wild and native to sub-Saharan Africa.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sesame"}}, {"canonical_name": "S.W.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "s_w_", "book_id": "coloquios_da_orta_1563", "name": "S.W.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["S.W."], "contexts": ["direction of monsoon"]}, {"entity_id": "s_w_", "book_id": "connexion_physical_sciences_somerville_1858", "name": "S.W.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["S.W."], "contexts": ["direction: South-West", "direction of wind bias"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "S.W.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "S.W.", "similarity": 1.0}], "id": 4999, "stable_key": "clu_62281c2199e69d46", "ground_truth": {"modern_name": "South-West", "confidence": "high", "type": "concept"}}, {"canonical_name": "ArcUipo da Torre do Tombo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "arcuipo_da_torre_do_tombo", "book_id": "coloquios_da_orta_1563", "name": "ArcUipo da Torre do Tombo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["ArcUipo da Torre do Tombo"], "contexts": ["archive where a copy is kept"]}, {"entity_id": "torre_do_tombo", "book_id": "coloquios_da_orta_1563", "name": "Torre do Tombo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Torre do Tombo"], "contexts": ["archive in Lisbon"]}, {"entity_id": "torre_do_tombo", "book_id": "polyanthea_medicinal", "name": "Torre do Tombo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Torre do Tombo"], "contexts": ["place of office"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "ArcUipo da Torre do Tombo", "target_book": "polyanthea_medicinal", "target_name": "Torre do Tombo", "similarity": 0.917}, {"source_book": "coloquios_da_orta_1563", "source_name": "Torre do Tombo", "target_book": "polyanthea_medicinal", "target_name": "Torre do Tombo", "similarity": 1.0}], "id": 5000, "stable_key": "clu_db23ec85a9feabcc", "ground_truth": {"modern_name": "Torre do Tombo National Archive", "confidence": "high", "type": "place", "country": "Portugal", "wikidata_id": "Q1769248", "wikidata_description": "national archives of Portugal", "wikipedia_url": "https://en.wikipedia.org/wiki/Torre%20do%20Tombo%20National%20Archive", "wikipedia_extract": "The Torre do Tombo National Archive (Portuguese: Arquivo Nacional da Torre do Tombo), commonly known simply as the Torre do Tombo ([\u02c8to\u0281\u0268 \u00f0u \u02c8t\u00f5bu]; literally \"Tower of the Tome\") is the national archive of Portugal, located in Lisbon. Established in 1378, it is one of the oldest archival institutions in the world. The archive is one of the oldest institutions in Portugal, since its installation in one of the towers of the castle in Lisbon, occurring during the reign of Ferdinand I, and likely in 1378 (the date where the first testimony originated). The archive served as the King's and nobilities' reference, with documents supporting the administration of the kingdom and overseas territories, and documenting the relationships between the State and foreign kingdoms. This institution was maintained by the Royal Keeper, an office sometimes paired with the post of Chief Chronicler of the Kingdom. The first known Royal Keeper was Jo\u00e3o Annes de Almada, called \"the Great\", appointed by king John I, Ferdinand's successor, who separated the office from the court chancellor's."}}, {"canonical_name": "sementes", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "sementes_de_leguminosas", "book_id": "coloquios_da_orta_1563", "name": "sementes de leguminosas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["sementes de leguminosas"], "contexts": ["food eaten by the crew"]}, {"entity_id": "sementes", "book_id": "polyanthea_medicinal", "name": "sementes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["sementes"], "contexts": ["seeds of plants", "seeds of plants used in medicine"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "sementes de leguminosas", "target_book": "polyanthea_medicinal", "target_name": "sementes", "similarity": 0.94}], "id": 5001, "stable_key": "clu_528ed944952d2042", "ground_truth": {"modern_name": "Seeds", "confidence": "high", "type": "plant"}}, {"canonical_name": "Mestres", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mestres", "book_id": "coloquios_da_orta_1563", "name": "mestres", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["mestres"], "contexts": ["masters who examined the body"]}, {"entity_id": "mestres", "book_id": "polyanthea_medicinal", "name": "Mestres", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Mestres"], "contexts": ["masters", "masters, referring to ancient authorities"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "mestres", "target_book": "polyanthea_medicinal", "target_name": "Mestres", "similarity": 0.834}], "id": 5002, "stable_key": "clu_76ae9ae7ef3ce15b", "ground_truth": {"modern_name": "Masters", "confidence": "high", "type": "person", "description": "Professors or experts in a field, often medical.", "note": "This refers to a title or role rather than specific individuals."}}, {"canonical_name": "mortandades", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mortindade", "book_id": "coloquios_da_orta_1563", "name": "mortindade", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["mortindade"], "contexts": ["great mortality"]}, {"entity_id": "mortandades", "book_id": "polyanthea_medicinal", "name": "mortandades", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["mortandades"], "contexts": ["deaths preceding plague", "mortalities"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "mortindade", "target_book": "polyanthea_medicinal", "target_name": "mortandades", "similarity": 0.92}], "id": 5003, "stable_key": "clu_edfe20c0835b21f6", "ground_truth": {"modern_name": "Mortality", "confidence": "high", "type": "disease", "modern_term": "Mortality (high death rate)", "note": "While 'mortality' can refer to the state of being mortal, in this medical context it signifies a high death rate, often due to disease outbreaks."}}, {"canonical_name": "golfa\u00f3", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "golfam", "book_id": "coloquios_da_orta_1563", "name": "golfam", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["golfam"], "contexts": ["plant with similar appearance"]}, {"entity_id": "golfa\u00f3", "book_id": "polyanthea_medicinal", "name": "golfa\u00f3", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["golfa\u00f3"], "contexts": ["plant used with ointment", "plant for fluxes"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "golfam", "target_book": "polyanthea_medicinal", "target_name": "golfa\u00f3", "similarity": 0.9}], "id": 5004, "stable_key": "clu_01388f68f59758ad", "ground_truth": {"modern_name": "gulfam", "confidence": "medium", "type": "plant", "note": "The terms 'golfa\u00f3' and 'golfam' appear in contexts of medicinal use and visual similarity. Without more specific botanical descriptions, precise identification is difficult. 'Gulfam' can refer to various plants in different regions."}}, {"canonical_name": "Dom Affonio V", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "d__affonso_v", "book_id": "coloquios_da_orta_1563", "name": "D. Affonso V", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["D. Affonso V"], "contexts": ["king whose cruzado value is noted"]}, {"entity_id": "dom_affonio_v", "book_id": "polyanthea_medicinal", "name": "Dom Affonio V", "category": "PERSON", "subcategory": "PATRON", "count": 2, "variants": ["Dom Affonio V", "Dom Affonfo Sexto"], "contexts": ["King whose chapel scribe suffered", "King"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "D. Affonso V", "target_book": "polyanthea_medicinal", "target_name": "Dom Affonio V", "similarity": 0.882}], "id": 5005, "stable_key": "clu_3dcb9a4922236cf8", "ground_truth": {"modern_name": "Afonso V of Portugal", "confidence": "high", "type": "person", "birth_year": 1432, "death_year": 1481, "description": "King of Portugal, mentioned in historical contexts.", "wikipedia_extract": "Afonso V (European Portuguese: [\u0250\u02c8f\u00f5su]; 15 January 1432 \u2013 28 August 1481), also known as the African (Portuguese: o Africano), was King of Portugal from 1438 until he died in 1481, with a brief interruption in 1477. The son of Edward, King of Portugal, and Eleanor of Aragon, Afonso acceded to the throne when he was only six years old. His early reign was marked by a struggle over the regency between his mother, Eleanor, and his uncle, Pedro, Duke of Coimbra. Pedro was appointed sole regent in 1439, but the Braganza faction at court continued to challenge his authority. Influenced by his other uncle, Afonso I, Duke of Braganza, the King dismissed Pedro in 1448 and defeated him in the Battle of Alfarrobeira in 1449. Between 1458 and 1471, Afonso pursued military campaigns in Africa, concentrating efforts predominantly on Morocco."}}, {"canonical_name": "Quastionibus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "quest\u00f5es", "book_id": "coloquios_da_orta_1563", "name": "quest\u00f5es", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["quest\u00f5es"], "contexts": ["economic issues studied in Eastern regions"]}, {"entity_id": "quastionibus", "book_id": "polyanthea_medicinal", "name": "Quastionibus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Quastionibus", "Quastion."], "contexts": ["section of a book", "abbreviation for question"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "quest\u00f5es", "target_book": "polyanthea_medicinal", "target_name": "Quastionibus", "similarity": 0.904}], "id": 5006, "stable_key": "clu_4947d1804b91cc97", "ground_truth": {"modern_name": "questions", "confidence": "high", "type": "concept", "note": "The context suggests 'questions' as in a series of inquiries or a section of a book dedicated to posing and answering questions.", "wikidata_id": "Q1505023", "wikidata_description": "formal request of a parliament to the respective government", "wikipedia_url": "https://en.wikipedia.org/wiki/Interpellation%20%28politics%29", "wikipedia_extract": "Interpellation is a formal parliamentary procedure through which members of parliament request that the government explain, clarify, or justify its policies, actions, or decisions. Typically presented in written or oral form, this process mandates that the government respond within a specified timeframe and may lead to subsequent debates or even votes of no confidence. The primary objectives of interpellation are to ensure governmental accountability\u2014upholding the principles of responsible government\u2014as well as to monitor the exercise of executive power and safeguard against its abuse while promoting transparency and public participation in policy deliberations. Interpellation in parliamentary politics can be traced back to Latin and French. The term comes from the Latin verb interpell\u0101re, meaning \u201cto interrupt by speaking\u201d or \u201cto call out.\u201d The word was subsequently absorbed into medieval French as \u201cinterpellation,\u201d retaining the meaning of \u201cto call out\u201d or \u201cto interrupt.\u201d Over time, the term came to be used to describe the formal mechanism by which legislators in parliament question or challenge government ministers on their policies or actions. In English, the concept of \u201cinterpellation\u201d in this political sense emerged in the early to mid-19th century, influenced by French constitutional practice, and became established in parliamentary politics as a tool for ensuring government accountability and transparency."}}, {"canonical_name": "Eaglewood", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "eagle_wood", "book_id": "coloquios_da_orta_1563", "name": "eagle wood", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["eagle wood"], "contexts": ["English name for aloes wood"]}, {"entity_id": "eaglewood", "book_id": "polyanthea_medicinal", "name": "Eaglewood", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Eaglewood"], "contexts": ["used for perfuming"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "eagle wood", "target_book": "polyanthea_medicinal", "target_name": "Eaglewood", "similarity": 0.903}], "id": 5007, "stable_key": "clu_032b40c540f04fcf-2", "ground_truth": {"modern_name": "aloes wood", "confidence": "high", "type": "plant", "description": "Fragrant wood used as incense and in traditional medicine.", "note": "Also known as agarwood or oud.", "wikipedia_extract": "Agarwood, aloeswood, eaglewood, gaharuwood, commonly referred to as oud or oudh (from Arabic: \u0639\u0648\u062f, romanized: \u02bf\u016bd, pronounced [\u0295u\u02d0d]), is a fragrant, dark and resinous wood used in incense, perfume, and small hand carvings. It forms in the heartwood of Aquilaria trees after they become infected with a type of Phaeoacremonium mold, P. parasitica. The tree defensively secretes a resin to combat the fungal infestation. Prior to becoming infected, the heartwood mostly lacks scent, and is relatively light and pale in colouration. However, as the infection advances and the tree produces its fragrant resin as a final option of defense, the heartwood becomes very dense, dark, and saturated with resin. This product is harvested, and most famously referred to in cosmetics under the scent names of oud, oodh or aguru; however, it is also called aloes (not to be confused with the succulent plant genus Aloe), agar (this name, as well, is not to be confused with the edible, algae-derived thickening agent agar agar), as well as gaharu or jinko."}}, {"canonical_name": "Alfama", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "alfama", "book_id": "coloquios_da_orta_1563", "name": "Alfama", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Alfama"], "contexts": ["neighborhood in Lisbon"]}, {"entity_id": "alfama", "book_id": "polyanthea_medicinal", "name": "Alfama", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Alfama"], "contexts": ["location of a woman", "location in Lisbon"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Alfama", "target_book": "polyanthea_medicinal", "target_name": "Alfama", "similarity": 0.817}], "id": 5008, "stable_key": "clu_07d32d8d4797a20c", "ground_truth": {"wikipedia_extract": "The Alfama (Portuguese pronunciation: [al\u02c8f\u0250m\u0250]) is the oldest neighborhood of Lisbon, spreading on the slope between the S\u00e3o Jorge Castle and the Tagus river. The district includes the freguesias (parishes) of S\u00e3o Miguel, Santo Est\u00eav\u00e3o, S\u00e3o Vicente de Fora and part of the two streets, \"Freguesia da S\u00e9: Rua do Bar\u00e3o\" and \"Rua S\u00e3o Jo\u00e3o da Pra\u00e7a\". It contains many important historical attractions, as well as an abundance of Fado bars and restaurants. The name Alfama originates from the Arabic al-\u1e25amma (\u0627\u0644\u062d\u064e\u0645\u0651\u0629), meaning \"hot springs\". The Arabic word comes from the root meaning \"to heat\" or \"to become hot\", from which the word hammam (Arabic: \u062d\u064e\u0645\u064e\u0651\u0627\u0645, lit.\u2009'bath, bathhouse') also derives. The Rua do Bar\u00e3o is one of the streets of the Freguesia da S\u00e9, which begins at the Rua S\u00e3o Jo\u00e3o da Pra\u00e7a (where once stood the Door of the Alfama) and ends at Rua Augusto Rosa (at the Cathedral's walls)."}}, {"canonical_name": "semente de linha\u00e7a", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "semente_de_emdivia", "book_id": "coloquios_da_orta_1563", "name": "semente de emdivia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["semente de emdivia"], "contexts": ["seed used in fevers"]}, {"entity_id": "semente_de_linha\u00e7a", "book_id": "polyanthea_medicinal", "name": "semente de linha\u00e7a", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["semente de linha\u00e7a"], "contexts": ["emollient remedy ingredient", "seed used in an emplastrum"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "semente de emdivia", "target_book": "polyanthea_medicinal", "target_name": "semente de linha\u00e7a", "similarity": 0.881}], "id": 5009, "stable_key": "clu_8a1b2095d26a826f", "ground_truth": {"modern_name": "flaxseed", "confidence": "high", "type": "plant", "linnaean": "Linum usitatissimum L.", "family": "Linaceae", "note": "The context 'emollient remedy ingredient' strongly points to flaxseed. 'Semente de linha\u00e7a' is the direct Portuguese translation.", "wikidata_id": "Q911332", "wikidata_description": "seed of the flax plant"}}, {"canonical_name": "borbulhas", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "burbulhas", "book_id": "coloquios_da_orta_1563", "name": "burbulhas", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["burbulhas"], "contexts": ["small blisters"]}, {"entity_id": "borbulhas", "book_id": "polyanthea_medicinal", "name": "borbulhas", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["borbulhas"], "contexts": ["skin eruption", "blisters that can form on the skin"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "burbulhas", "target_book": "polyanthea_medicinal", "target_name": "borbulhas", "similarity": 0.955}], "id": 5010, "stable_key": "clu_c32b6b62abd66e1d", "ground_truth": {"wikipedia_extract": "Bolh\u00e1s is a village in Somogy county, Hungary. Its name derives from the Hungarian word bolha (English: flea). According to the legends the village belonged to a knight who was called Bolha. The Hungarian folk songs Megismerni a kan\u00e1szt and Volt nekem egy kecsk\u00e9m were collected in 1922 in Bolh\u00e1s by Zolt\u00e1n Kod\u00e1ly."}}, {"canonical_name": "Schrod", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "schrad_", "book_id": "coloquios_da_orta_1563", "name": "Schrad.", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Schrad."], "contexts": ["botanist"]}, {"entity_id": "schrod", "book_id": "polyanthea_medicinal", "name": "Schrod", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Schrod", "Schrod\u00e9"], "contexts": ["cited for virtues of turpentine", "cited for virtues of oil"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Schrad.", "target_book": "polyanthea_medicinal", "target_name": "Schrod", "similarity": 0.858}], "id": 5011, "stable_key": "clu_f813e38547037c30", "ground_truth": {"modern_name": "Leonhart Fuchs", "confidence": "medium", "type": "person", "birth_year": 1501, "death_year": 1566, "description": "German botanist and physician, author of 'De Historia Stirpium'", "note": "The abbreviation 'Schrad.' is unusual for Fuchs. However, given the context of botany and citations for plant virtues, Fuchs is a strong candidate for prominent botanists of the era. If it refers to a different 'Schrod', further context would be needed."}}, {"canonical_name": "Ter\u00e7aas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "terci\u00e1rias", "book_id": "coloquios_da_orta_1563", "name": "terci\u00e1rias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["terci\u00e1rias"], "contexts": ["fever type"]}, {"entity_id": "ter\u00e7aas", "book_id": "polyanthea_medicinal", "name": "Ter\u00e7aas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["Ter\u00e7aas"], "contexts": ["fevers treated with Quinaquina", "tertian fevers"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "terci\u00e1rias", "target_book": "polyanthea_medicinal", "target_name": "Ter\u00e7aas", "similarity": 0.889}], "id": 5012, "stable_key": "clu_12e97d0a68d05fe3", "ground_truth": {"modern_name": "Sadness/Tertian Fever", "confidence": "low", "type": "disease", "description": "Emotional distress or intermittent fever type.", "note": "This cluster conflates two distinct concepts: 'tristeza' (sadness) and 'terci\u00e1rias' (tertian fever, a type of malaria)."}}, {"canonical_name": "compostos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "composi\u00e7\u00f5es", "book_id": "coloquios_da_orta_1563", "name": "composi\u00e7\u00f5es", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["composi\u00e7\u00f5es"], "contexts": ["medicinal preparations"]}, {"entity_id": "compostos", "book_id": "polyanthea_medicinal", "name": "compostos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["compostos", "compo\u017ftos"], "contexts": ["compound remedies", "compounds"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "composi\u00e7\u00f5es", "target_book": "polyanthea_medicinal", "target_name": "compostos", "similarity": 0.915}], "id": 5013, "stable_key": "clu_38e72b4abc442593", "ground_truth": {"modern_name": "Compound remedies", "confidence": "high", "type": "concept", "note": "Both 'compostos' and 'composi\u00e7\u00f5es' in Portuguese directly translate to 'compounds' or 'compositions' in the context of medicinal preparations.", "wikipedia_extract": "Oswald Croll or Crollius (c. 1563 \u2013 December 1609) was an alchemist, and professor of medicine at the University of Marburg in Hesse, Germany. A strong proponent of alchemy and using chemistry in medicine, he was heavily involved in writing books and influencing thinkers of his day towards viewing chemistry and alchemy as two separate fields. Croll received his doctorate in medicine in 1582 at Marburg, then continued studies at Heidelberg, Strasburg, and Geneva. After working as a tutor, he arrived in Prague in 1597. He remained there for two years, and again from 1602 until his death.", "wikipedia_url": "https://en.wikipedia.org/wiki/Oswald_Croll"}}, {"canonical_name": "pungente", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pungente", "book_id": "coloquios_da_orta_1563", "name": "pungente", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["pungente"], "contexts": ["quality of pepper"]}, {"entity_id": "pungente", "book_id": "polyanthea_medicinal", "name": "pungente", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["pungente"], "contexts": ["quality, pungent", "quality of blood"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "pungente", "target_book": "polyanthea_medicinal", "target_name": "pungente", "similarity": 1.0}], "id": 5014, "stable_key": "clu_4b090e21de593801", "ground_truth": {"wikipedia_extract": "Pungency (  PUN-j\u0259n-see), commonly referred to as spiciness, hotness or heat,  is a sensation that contributes to the flavor of certain foods such as chili peppers. Highly pungent foods may be experienced as unpleasant. The term piquancy ( PEEK-\u0259n-see) is sometimes applied to foods with a lower degree of pungency that are \"agreeably stimulating to the palate\". In addition to chili peppers, piquant ingredients include wasabi, horseradish and mustard. The primary substances responsible for pungency are capsaicin (in chilis), piperine (in peppercorns) and allyl isothiocyanate (in radishes, mustard and wasabi). In colloquial speech, the term \"pungency\" can refer to any strong, sharp smell or flavor."}}, {"canonical_name": "Artetica", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "artetica", "book_id": "coloquios_da_orta_1563", "name": "artetica", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["artetica"], "contexts": ["gout"]}, {"entity_id": "artetica", "book_id": "polyanthea_medicinal", "name": "Artetica", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["Artetica", "artetica"], "contexts": ["herb added to artificial baths", "disease affecting all joints"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "artetica", "target_book": "polyanthea_medicinal", "target_name": "Artetica", "similarity": 0.921}], "id": 5015, "stable_key": "clu_3a2dff5b25909966", "ground_truth": {"modern_name": "Gout", "confidence": "high", "type": "disease", "modern_term": "Gout", "wikidata_id": "Q133087", "wikidata_description": "medical condition that results in recurrent pain and swelling of joints", "wikipedia_url": "https://en.wikipedia.org/wiki/Gout"}}, {"canonical_name": "ethicas", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "\u00e9tico", "book_id": "coloquios_da_orta_1563", "name": "\u00e9tico", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["\u00e9tico"], "contexts": ["consumptive"]}, {"entity_id": "ethicas", "book_id": "polyanthea_medicinal", "name": "ethicas", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["ethicas", "Eticos"], "contexts": ["chronic fevers", "etics, and tics, or internal inflammations"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "\u00e9tico", "target_book": "polyanthea_medicinal", "target_name": "ethicas", "similarity": 0.912}], "id": 5016, "stable_key": "clu_d2e725b37de40e42-2", "ground_truth": {"modern_name": "Phthisis", "confidence": "high", "type": "disease", "modern_term": "Tuberculosis", "note": "The term 'ethicas' is a Latinized form of Greek 'ethos' or 'ethikos', often referring to habit or custom. In a medical context, it could describe chronic or habitual fevers or a consumptive state.", "wikidata_id": "Q12204", "wikidata_description": "infectious disease caused by the bacterium Mycobacterium tuberculosis", "wikipedia_url": "", "wikipedia_extract": ""}}, {"canonical_name": "ovelha", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ovelhas", "book_id": "coloquios_da_orta_1563", "name": "ovelhas", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["ovelhas"], "contexts": ["animals that eat the plant"]}, {"entity_id": "ovelha", "book_id": "polyanthea_medicinal", "name": "ovelha", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["ovelha", "ovelhas"], "contexts": ["sheep's milk", "animals that move when male is killed"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "ovelhas", "target_book": "polyanthea_medicinal", "target_name": "ovelha", "similarity": 0.946}], "id": 5017, "stable_key": "clu_7adf69cdc4a339ea-2", "ground_truth": {"modern_name": "sheep", "confidence": "high", "type": "animal", "wikidata_id": "Q4628", "wikidata_description": "North Atlantic archipelago organized as an autonomous constituent country of the Kingdom of Denmark", "wikipedia_url": "https://en.wikipedia.org/wiki/Faroe%20Islands", "wikipedia_extract": "The Faroe Islands ( FAIR-oh), also known as the Faroes, are an archipelago in the North Atlantic Ocean and a rigsdel ('autonomous territory') of the Kingdom of Denmark. Located between Iceland, Norway, and the Hebrides and Shetland isles of Scotland, the islands have a population of 54,870 as of November 2025 and a land area of 1,393 km2 (538 sq mi). The official language is Faroese, which is partially mutually intelligible with Icelandic. The terrain is rugged, dominated by fjords and cliffs with sparse vegetation and few trees. As a result of their proximity to the Arctic Circle, the islands experience perpetual civil twilight during summer nights and very short winter days; nevertheless, they experience a subpolar oceanic climate and mild temperatures year-round due to the Gulf Stream. The capital, T\u00f3rshavn, receives the fewest recorded hours of sunshine of any city in the world at only 840 per year.", "description": "Reproductive body laid by female birds, reptiles, amphibians, fish, and insects.", "note": "The context for 'ovelhas' (sheep) is anomalous; it appears to refer to animals that eat a plant, not the egg itself."}}, {"canonical_name": "Innamomo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "onamomo", "book_id": "coloquios_da_orta_1563", "name": "onamomo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["onamomo"], "contexts": ["planta com nomes em diversas linguoas"]}, {"entity_id": "innamomo", "book_id": "ricettario_fiorentino_1597", "name": "Innamomo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Innamomo", "Innamoniol"], "contexts": ["ingredient in a preparation", "cinnamon"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "onamomo", "target_book": "ricettario_fiorentino_1597", "target_name": "Innamomo", "similarity": 0.888}], "id": 5018, "stable_key": "clu_da8349cf6cb8762c", "ground_truth": {"modern_name": "Indian Almond", "confidence": "medium", "type": "plant", "linnaean": "Terminalia catappa L.", "family": "Combretaceae", "note": "The phonetic similarity between 'onamomo'/'Innamomo' and botanical names of plants with diverse linguistic appellations suggests a well-known plant. Indian Almond is known for its various medicinal uses and is described with multiple names. Further research into the specific text 'ricettario_fiorentino_1597' might clarify this."}}, {"canonical_name": "herva dos pa\u017f\u017farinhos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "herva_de_besteiros", "book_id": "coloquios_da_orta_1563", "name": "herva de besteiros", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["herva de besteiros"], "contexts": ["plant name"]}, {"entity_id": "herva_dos_pa\u017f\u017farinhos", "book_id": "polyanthea_medicinal", "name": "herva dos pa\u017f\u017farinhos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["herva dos pa\u017f\u017farinhos"], "contexts": ["bird's herb, medicinal plant", "plant used in a remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "herva de besteiros", "target_book": "polyanthea_medicinal", "target_name": "herva dos pa\u017f\u017farinhos", "similarity": 0.888}], "id": 5019, "stable_key": "clu_c2ce169af13f36da", "ground_truth": {"modern_name": "Ribes uva-crispa", "confidence": "medium", "type": "plant", "linnaean": "Ribes uva-crispa L.", "family": "Grossulariaceae", "note": "The Portuguese names 'herva dos passarinho' and 'herva de besteiros' are historically associated with gooseberry (Ribes uva-crispa), often cited for its medicinal properties.", "wikidata_id": "Q41503", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Ribes%20uva-crispa", "wikipedia_extract": "Ribes uva-crispa, commonly known as the gooseberry or European gooseberry, is a species of flowering shrub native to Europe, northwestern Africa, and southwestern Asia. It belongs to the family Grossulariaceae, which includes currants and gooseberries. The plant is cultivated for its edible fruit, which is used in culinary applications ranging from desserts to preserves. The goose in gooseberry has been seen as a corruption of either the Dutch word kruisbes or the allied German Krausbeere, or of the earlier forms of the French groseille. Alternatively, the word has been connected to the Middle High German krus ('curl, crisped'), in Latin as grossularia (also the name of its subgenus within Ribes). However, the Oxford English Dictionary takes the more literal derivation from goose and berry as probable because \"the grounds on which plants and fruits have received names associating them with animals are so often inexplicable that the inappropriateness in the meaning does not necessarily give good grounds for believing that the word is an etymological corruption\"."}}, {"canonical_name": "Hyoscyamo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "hyoscyamus", "book_id": "coloquios_da_orta_1563", "name": "Hyoscyamus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Hyoscyamus"], "contexts": ["plant name"]}, {"entity_id": "hyoscyamo", "book_id": "ricettario_fiorentino_1597", "name": "Hyoscyamo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Hyoscyamo"], "contexts": ["henbane herb"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Hyoscyamus", "target_book": "ricettario_fiorentino_1597", "target_name": "Hyoscyamo", "similarity": 0.954}], "id": 5020, "stable_key": "clu_11561a0ea0f01ca6", "ground_truth": {"modern_name": "Water-hemlock", "confidence": "high", "type": "PLANT", "description": "A genus of poisonous herbaceous plants, often found near water.", "note": "Helosciadium is an older name for some species now classified under the genus Berula, but it also refers to plants sometimes identified with Henbane (Hyoscyamus).", "wikipedia_extract": "Cicuta, commonly known as water hemlock, is a genus of four species of highly poisonous plants in the family Apiaceae. They are perennial herbaceous plants which grow up to 2.5 meters (8 ft) tall, having distinctive small green or white flowers arranged in an umbrella shape (umbel). Plants in this genus may also be referred to as cowbane or poison parsnip. Cicuta is native to temperate regions of the Northern Hemisphere, mainly North America and Europe, typically growing in wet meadows, along streambanks and other wet and marshy areas. In the United Kingdom it is frequently found along canals. These plants bear a close resemblance to other members in the family Apiaceae and may be confused with a number of edible or poisonous plants."}}, {"canonical_name": "antichi", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "antichi", "book_id": "ricettario_fiorentino_1597", "name": "antichi", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["antichi"], "contexts": ["ancient authorities on plants", "ancient authors"]}, {"entity_id": "antiqui", "book_id": "polyanthea_medicinal", "name": "Antiqui", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Antiqui"], "contexts": ["ancient authorities"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "antichi", "target_book": "polyanthea_medicinal", "target_name": "Antiqui", "similarity": 0.899}], "id": 5021, "stable_key": "clu_c311a2444a4db930-2", "ground_truth": {"modern_name": "Ancient Authorities", "confidence": "high", "type": "concept", "note": "This refers to a general concept of citing past experts, rather than a specific individual or group."}}, {"canonical_name": "Cartamo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cartamo", "book_id": "ricettario_fiorentino_1597", "name": "Cartamo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Cartamo", "cartamo"], "contexts": ["a plant with seeds difficult to separate", "safflower herb"]}, {"entity_id": "cartamo", "book_id": "polyanthea_medicinal", "name": "cartamo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cartamo"], "contexts": ["safflower, seed used in preparation"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Cartamo", "target_book": "polyanthea_medicinal", "target_name": "cartamo", "similarity": 0.898}], "id": 5022, "stable_key": "clu_3e8b365021f27e4e", "ground_truth": {"modern_name": "safflower", "confidence": "high", "type": "plant", "linnaean": "Carthamus tinctorius L.", "family": "Asteraceae", "wikidata_id": "Q156625", "wikidata_description": "species of plant, safflower"}}, {"canonical_name": "acqua vite", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "acqua_vite", "book_id": "ricettario_fiorentino_1597", "name": "acqua vite", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["acqua vite"], "contexts": ["aqua vitae (alcohol)", "distilled spirit used in preparation"]}, {"entity_id": "aqua_vite", "book_id": "polyanthea_medicinal", "name": "aqua vite", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["aqua vite"], "contexts": ["distilled spirit, possibly alcohol"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "acqua vite", "target_book": "polyanthea_medicinal", "target_name": "aqua vite", "similarity": 0.956}], "id": 5023, "stable_key": "clu_d91e6def595c1b8c", "ground_truth": {"modern_name": "Alcoholic spirits", "confidence": "high", "type": "chemical", "note": "Historically, 'aqua vitae' referred to distilled spirits, often containing high levels of alcohol.", "wikidata_id": "Q2511275", "wikidata_description": "concentrated aqueous solution of ethanol", "wikipedia_url": "https://en.wikipedia.org/wiki/Aqua%20vitae"}}, {"canonical_name": "Tito", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tito", "book_id": "ricettario_fiorentino_1597", "name": "Tito", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Tito"], "contexts": ["Roman emperor"]}, {"entity_id": "tito", "book_id": "polyanthea_medicinal", "name": "Tito", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Tito"], "contexts": ["Roman Emperor", "an Emperor who made remedies"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Tito", "target_book": "polyanthea_medicinal", "target_name": "Tito", "similarity": 0.879}], "id": 5024, "stable_key": "clu_b17a93101e9cae0e", "ground_truth": {"modern_name": "Titus", "confidence": "high", "type": "person", "birth_year": 39, "death_year": 81, "description": "Roman Emperor, known for the Flavian dynasty.", "wikidata_id": "", "wikidata_description": "family name", "note": "The identification of 'Titius' and 'Titus' is ambiguous. Titus is a known historical figure and a common Roman name. Titius could refer to a lesser-known figure or be an error."}}, {"canonical_name": "balfamo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "balfamo", "book_id": "ricettario_fiorentino_1597", "name": "balfamo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["balfamo"], "contexts": ["ingredient in Mumia"]}, {"entity_id": "balfamo", "book_id": "polyanthea_medicinal", "name": "balfamo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["balfamo"], "contexts": ["prepared substance", "plant-based substance used in medicine"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "balfamo", "target_book": "polyanthea_medicinal", "target_name": "balfamo", "similarity": 1.0}], "id": 5025, "stable_key": "clu_2c6163bb32df58d2", "ground_truth": {"modern_name": "Balsam", "confidence": "low", "type": "plant", "note": "The term 'balfamo' (or 'balsamo') in early modern texts could refer to various aromatic resins or plants known for their fragrant properties. Without more specific context, it's difficult to pinpoint a single species. It might refer to plants like *Commiphora* species (myrrh/frankincense) or even specific preparations derived from them.", "wikidata_id": "Q428750", "wikidata_description": "species of plant in the family Cucurbitaceae", "wikipedia_url": "https://en.wikipedia.org/wiki/Momordica%20charantia", "wikipedia_extract": "Momordica charantia (commonly called bitter melon, gouya,  cerassee, goya, bitter apple, bitter gourd, bitter squash, balsam-pear, karela, karavila and many more names listed below) is a tropical and subtropical vine of the family Cucurbitaceae, widely grown in Asia, Africa, and the Caribbean for its edible fruit. Its many varieties differ substantially in the shape and bitterness of the fruit. Bitter melon originated in Africa, where it was a dry-season staple food of \u01c3Kung hunter-gatherers. Wild or semi-domesticated variants spread across Asia in prehistory, and it was likely fully domesticated in Southeast Asia. It is widely used in the cuisines of East Asia, South Asia, and Southeast Asia. This herbaceous, tendril-bearing vine grows up to 5 m (16 ft) in length."}}, {"canonical_name": "opoponaco", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "opopo_naco", "book_id": "ricettario_fiorentino_1597", "name": "opopo naco", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["opopo naco"], "contexts": ["plant infused in wine"]}, {"entity_id": "opoponaco", "book_id": "polyanthea_medicinal", "name": "opoponaco", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["opoponaco"], "contexts": ["ingredient in a fomentation", "ingredient in electuary"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "opopo naco", "target_book": "polyanthea_medicinal", "target_name": "opoponaco", "similarity": 0.889}], "id": 5026, "stable_key": "clu_ad12d45ba6969ae5", "ground_truth": {"modern_name": "Opoponax", "confidence": "high", "type": "plant", "linnaean": "Opoponax chironium", "family": "Apiaceae", "wikidata_id": "Q13560912", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Opopanax%20chironium", "wikipedia_extract": "Opopanax chironium, common name Hercules' all-heal, is a herb of the family Apiaceae. Opopanax chironium grows 1\u20133 metres (3 feet 3 inches \u2013 9 feet 10 inches) high. This perennial herb has a branching stem, thick and rough close to the base. Leaves are serrate, pinnate, with long petioles. It produces a large, flat, yellow inflorescence at the top of the branches. The plant thrives in warm climates like Iran, Italy, Greece and Turkey, but also grows in cooler climates."}}, {"canonical_name": "Elixir vit\u00e6", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "elixir_vita", "book_id": "ricettario_fiorentino_1597", "name": "Elixir vita", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Elixir vita"], "contexts": ["medicinal preparation"]}, {"entity_id": "elixir_vit\u00e6", "book_id": "polyanthea_medicinal", "name": "Elixir vit\u00e6", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Elixir vit\u00e6", "Elixir vita"], "contexts": ["medicinal elixir, likely elixir of life", "elixir of life, a preparation"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Elixir vita", "target_book": "polyanthea_medicinal", "target_name": "Elixir vit\u00e6", "similarity": 0.892}], "id": 5027, "stable_key": "clu_6852e514079bf48a", "ground_truth": {"modern_name": "Elixir Vitae", "confidence": "high", "type": "preparation"}}, {"canonical_name": "iperica\u00f3", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "iperico", "book_id": "ricettario_fiorentino_1597", "name": "Iperico", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Iperico"], "contexts": ["herb oil"]}, {"entity_id": "iperica\u00f3", "book_id": "polyanthea_medicinal", "name": "iperica\u00f3", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["iperica\u00f3", "Iperic\u00e3o"], "contexts": ["herb used in preparation", "St. John's wort"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Iperico", "target_book": "polyanthea_medicinal", "target_name": "iperica\u00f3", "similarity": 0.924}], "id": 5028, "stable_key": "clu_d963abf0802052d9", "ground_truth": {"modern_name": "St. John's Wort", "confidence": "high", "type": "plant", "linnaean": "Hypericum perforatum", "family": "Hypericaceae", "wikidata_id": "Q158289", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Hypericum%20perforatum", "wikipedia_extract": "Hypericum perforatum, commonly known as St. John's wort (sometimes perforate St. John's wort or common St. John's wort), is a flowering plant in the family Hypericaceae. It is a hairless, perennial herb with woody roots, yellow flowers marked by black glands, and leaves that appear perforated due to translucent glands, producing thousands of seeds per plant. H. perforatum is the type species of its genus, known for its historical use in folklore and traditional medicine."}}, {"canonical_name": "causas exteriores", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "causas_exteriores", "book_id": "polyanthea_medicinal", "name": "causas exteriores", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["causas exteriores", "causas interiores"], "contexts": ["external causes", "internal causes"]}, {"entity_id": "foreign_cause", "book_id": "connexion_physical_sciences_somerville_1858", "name": "foreign cause", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["foreign cause"], "contexts": ["external influence"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "causas exteriores", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "foreign cause", "similarity": 0.916}], "id": 5029, "stable_key": "clu_2d45c7837c96a4c1", "ground_truth": {"modern_name": "External causes", "confidence": "high", "type": "concept", "wikidata_id": "Q5422022", "wikidata_description": "reason for the existence of a medical condition which can be associated with a specific object or acute process that was caused by something outside the body", "wikipedia_url": "https://en.wikipedia.org/wiki/External%20cause", "wikipedia_extract": "In medicine, an external cause is a reason for the existence of a medical condition which can be associated with a specific object or acute process that was caused by something outside the body. Such causes are classified as \"E codes\" in ICD 9. External Cause of Injury Codes (E codes) are ICD-9-CM codes or ICD-10 codes that are used to define the mechanism of death or injury, along with the place of occurrence of the event. [1] E codes are assigned on death certificates based on the manner of death. ICD-10 codes in the range V01\u2013X59 refer to unintentional injuries. Codes in the range X60\u2013X84 refer to intentional self-harm."}}, {"canonical_name": "inflammations", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "inflammations", "book_id": "polyanthea_medicinal", "name": "inflammations", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["inflammations"], "contexts": ["inflammation of lungs", "inflammation"]}, {"entity_id": "\u0153dematous_inflammations", "book_id": "first_principles_spencer_1862", "name": "\u0153dematous inflammations", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["\u0153dematous inflammations"], "contexts": ["swelling due to fluid accumulation"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "inflammations", "target_book": "first_principles_spencer_1862", "target_name": "\u0153dematous inflammations", "similarity": 0.893}], "id": 5030, "stable_key": "clu_8b7e43e7212a4a90", "ground_truth": {"modern_name": "Inflammation", "confidence": "high", "type": "disease", "modern_term": "Inflammation", "note": "The cluster includes both general 'inflammations' and '\u0153dematous inflammations', clearly referring to the medical condition.", "wikidata_id": "Q14819849", "wikidata_description": "immediate defensive reaction (by vertebrate tissue) to infection or injury caused by chemical or physical agents, characterized by local vasodilation, extravasation of plasma into intercellular spaces and accumulation of white blood cells"}}, {"canonical_name": "Catholicos", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "catholicos", "book_id": "polyanthea_medicinal", "name": "Catholicos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Catholicos"], "contexts": ["Catholics who confess", "religious group"]}, {"entity_id": "catholic", "book_id": "first_principles_spencer_1862", "name": "Catholic", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Catholic"], "contexts": ["ancestors who believed in church building for sins"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Catholicos", "target_book": "first_principles_spencer_1862", "target_name": "Catholic", "similarity": 0.943}], "id": 5031, "stable_key": "clu_0091e74358cc07bf", "ground_truth": {"modern_name": "Catholicism", "confidence": "high", "type": "concept", "note": "The term 'Catholicos' and 'Catholic' in these contexts refer to adherents and the broader religious system of Catholicism, rather than a specific individual.", "wikidata_id": "Q9592", "wikidata_description": "largest Christian Church, made up of 24 autonomous Churches in communion with the Pope, part of the Latin Church aka Latin Christianity aka western Christianity", "wikipedia_url": "https://en.wikipedia.org/wiki/Catholic%20Church", "wikipedia_extract": "The Catholic Church (Latin: Ecclesia Catholica), commonly known as the Roman Catholic Church, is the largest Christian denomination, with an estimated 1.27 to 1.41 billion baptized members worldwide as of 2025. One of the world's oldest continuously functioning institutions, it has played a formative role in the development of Western civilization. The Church consists of 24 sui iuris (autonomous) churches\u2014the Latin Church and 23 Eastern Catholic Churches\u2014which together encompass nearly 3,500 dioceses and eparchies governed by bishops. The pope, as bishop of Rome, serves as the Church's chief pastor. Catholic doctrine is rooted in the Nicene Creed. The Church teaches that it is the \"one, holy, catholic and apostolic Church\" founded by Jesus Christ in the Great Commission; that its bishops are the successors of the apostles; and that the pope is the successor of Saint Peter, to whom Christ entrusted a unique pastoral role."}}, {"canonical_name": "Catholico", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "catholico", "book_id": "polyanthea_medicinal", "name": "Catholico", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Catholico"], "contexts": ["religious affiliation"]}, {"entity_id": "roman_catholic", "book_id": "first_principles_spencer_1862", "name": "Roman Catholic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Roman Catholic"], "contexts": ["religious denomination"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Catholico", "target_book": "first_principles_spencer_1862", "target_name": "Roman Catholic", "similarity": 0.915}], "id": 5032, "stable_key": "clu_82efbd2c34240f28", "ground_truth": {"modern_name": "Catholicism", "confidence": "high", "type": "concept", "note": "Similar to cluster 4238, 'Catholico' and 'Roman Catholic' refer to the religious affiliation and denomination of Catholicism.", "wikidata_id": "Q9592", "wikidata_description": "largest Christian Church, made up of 24 autonomous Churches in communion with the Pope, part of the Latin Church aka Latin Christianity aka western Christianity"}}, {"canonical_name": "reptilibus", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "reptilibus", "book_id": "polyanthea_medicinal", "name": "reptilibus", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["reptilibus"], "contexts": ["reptiles"]}, {"entity_id": "invertebrate_ones", "book_id": "first_principles_spencer_1862", "name": "invertebrate ones", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["invertebrate ones"], "contexts": ["animals without backbones"]}, {"entity_id": "reptile", "book_id": "first_principles_spencer_1862", "name": "reptile", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["reptile"], "contexts": ["animal that develops from an ovum"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "reptilibus", "target_book": "first_principles_spencer_1862", "target_name": "invertebrate ones", "similarity": 0.937}, {"source_book": "polyanthea_medicinal", "source_name": "reptilibus", "target_book": "first_principles_spencer_1862", "target_name": "reptile", "similarity": 0.952}], "id": 5033, "stable_key": "clu_18e4f6e4ef9e0efb-2", "ground_truth": {"modern_name": "Reptiles", "confidence": "high", "type": "animal", "wikidata_id": "Q10811", "wikidata_description": "class of vertebrate animals (Vertebrata)", "wikipedia_url": "https://en.wikipedia.org/wiki/Reptile", "note": "The Latin 'reptilibus' directly translates to 'reptiles'. The other member 'reptile' further confirms this. 'Invertebrate ones' seems like a misinterpretation or OCR error in its context if it's meant to be linked to 'reptiles'.", "wikipedia_extract": "Reptiles, as commonly defined, are tetrapod vertebrate animals with an ectothermic metabolism and amniotic development. Reptiles traditionally comprise four orders: Testudines (turtles), Crocodilia (crocodiles, alligators and gharials), Squamata (lizards and snakes) and Rhynchocephalia (tuatara), with about 12,000 extant species listed in the Reptile Database. The study of the traditional reptile orders, customarily in combination with the study of modern amphibians, is called herpetology. Reptiles have been subject to several conflicting taxonomic definitions. In classical evolutionary taxonomy, reptiles are gathered together under the class Reptilia ( rep-TIL-ee-\u0259), which corresponds to common usage. Modern cladistic taxonomy regards that group as paraphyletic, since genetic and paleontological evidence has determined that birds (class Aves) are the only surviving group of Dinosauria, a major clade of diapsids that are more closely related to crocodilians than to other living reptiles, and thus birds are nested among reptiles (under the clade Archosauria) from a phylogenetic perspective."}}, {"canonical_name": "Fires", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "feus", "book_id": "polyanthea_medicinal", "name": "feus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["feus"], "contexts": ["Latin pronoun meaning 'his'"]}, {"entity_id": "fires", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Fires", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["fires", "Fires"], "contexts": ["source of heat in mines", "subterranean central heat"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "feus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Fires", "similarity": 0.935}], "id": 5034, "stable_key": "clu_a7125b508df3c314-2", "ground_truth": {"modern_name": "fire", "confidence": "high", "type": "concept", "note": "Refers to the element of fire, a fundamental concept in ancient and medieval natural philosophy.", "wikidata_id": "Q2044", "wikidata_description": "Italian city and commune, located in Tuscany", "wikipedia_url": "", "wikipedia_extract": ""}}, {"canonical_name": "rays of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "rays_of_light", "book_id": "connexion_physical_sciences_somerville_1858", "name": "rays of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["rays of light"], "contexts": ["electromagnetic radiation", "components of light"]}, {"entity_id": "rays_of_light", "book_id": "first_principles_spencer_1862", "name": "rays of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["rays of light"], "contexts": ["de-oxidized carbonic acid"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "rays of light", "target_book": "first_principles_spencer_1862", "target_name": "rays of light", "similarity": 1.0}], "id": 5035, "stable_key": "clu_e9b64662602134eb", "ground_truth": {"modern_name": "Light rays", "confidence": "high", "type": "concept", "note": "The context clearly refers to the propagation of light, which in early modern science was often conceptualized as rays. The mention of 'de-oxidized carbonic acid' might hint at chemical reactions involving light, but the core concept is light propagation."}}, {"canonical_name": "definite proportions", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "definite_proportions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "definite proportions", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["definite proportions", "Definite Proportions"], "contexts": ["law of chemical combination", "law of fixed ratios in chemical compounds"]}, {"entity_id": "definite_proportions", "book_id": "first_principles_spencer_1862", "name": "definite proportions", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["definite proportions"], "contexts": ["law of chemical combination"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "definite proportions", "target_book": "first_principles_spencer_1862", "target_name": "definite proportions", "similarity": 1.0}], "id": 5036, "stable_key": "clu_e71bb0ea9838a69c", "ground_truth": {"modern_name": "Law of Definite Proportions", "confidence": "high", "type": "concept", "wikidata_id": "Q327158", "wikidata_description": "statement that a given chemical compound always contains its elements in fixed ratio (by mass) and does not depend on its source and method of preparation", "wikipedia_extract": "In chemistry, the whole number rule states that the masses of the isotopes are whole number multiples of the mass of the hydrogen atom. The rule is a modified version of Prout's hypothesis proposed in 1815, to the effect that atomic weights are multiples of the weight of the hydrogen atom. It is also known as the Aston whole number rule after Francis W. Aston who was awarded the Nobel Prize in Chemistry in 1922 \"for his discovery, by means of his mass spectrograph, of isotopes, in a large number of non-radioactive elements, and for his enunciation of the whole-number rule\". The law of definite proportions was formulated by Joseph Proust around 1800 and states that all samples of a chemical compound will have the same elemental composition by mass. The atomic theory of John Dalton expanded this concept and explained matter as consisting of discrete atoms with one kind of atom for each element combined in fixed proportions to form compounds.", "wikipedia_url": "https://en.wikipedia.org/wiki/Law_of_definite_proportions"}}, {"canonical_name": "Atomic constitution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "atomic_constitution", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Atomic constitution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["atomic constitution", "Atomic constitution"], "contexts": ["internal arrangement of atoms", "arrangement of atoms in a substance"]}, {"entity_id": "atomic_arrangement", "book_id": "first_principles_spencer_1862", "name": "Atomic arrangement", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Atomic arrangement"], "contexts": ["changed by electricity"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Atomic constitution", "target_book": "first_principles_spencer_1862", "target_name": "Atomic arrangement", "similarity": 0.897}], "id": 5037, "stable_key": "clu_a8358596ca27a8d2", "ground_truth": {"modern_name": "Atomic structure", "confidence": "high", "type": "concept", "note": "The terms 'Atomic constitution' and 'Atomic arrangement' clearly refer to the internal organization of atoms, which is the modern concept of atomic structure.", "wikidata_id": "Q12355387", "wikidata_description": ""}}, {"canonical_name": "Cornwall", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cornwall", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cornwall", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Cornwall"], "contexts": ["county of Dalcoath mine", "location of hot-springs in mines"]}, {"entity_id": "cornwall", "book_id": "first_principles_spencer_1862", "name": "Cornwall", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Cornwall"], "contexts": ["Cornishmen take to mining because Cornwall is metalliferous"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Cornwall", "target_book": "first_principles_spencer_1862", "target_name": "Cornwall", "similarity": 1.0}], "id": 5038, "stable_key": "clu_14ee398c94dc10f4", "ground_truth": {"modern_name": "Cornwall", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Cornwall", "wikipedia_extract": "Cornwall (; Cornish: Kernow [\u02c8k\u025brn\u0254\u028a] or [\u02c8k\u025brn\u0254]) is a ceremonial county in South West England. It is one of the Celtic nations and the homeland of the Cornish people. The county is bordered by the Atlantic Ocean to the north and west, Devon to the east, and the English Channel to the south. The largest urban area is the Redruth and Camborne conurbation. The county is predominantly rural, with an area of 1,375 square miles (3,562 km2) and an estimated population of 585,655 in 2024. The county's major settlements include the city of Truro and St Austell in the centre, Redruth and Cambourne adjacent to each other in the south, and Penzance and Falmouth on the southern coast."}}, {"canonical_name": "dynamic theory of heat", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "dynamic_theory_of_heat", "book_id": "connexion_physical_sciences_somerville_1858", "name": "dynamic theory of heat", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["Dynamic Theory of Heat", "dynamic theory of heat"], "contexts": ["heat as a form of energy", "heat as molecular motion"]}, {"entity_id": "mechanical_theory_of_heat", "book_id": "first_principles_spencer_1862", "name": "mechanical theory of heat", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["mechanical theory of heat"], "contexts": ["theory relating heat and mechanical work"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "dynamic theory of heat", "target_book": "first_principles_spencer_1862", "target_name": "mechanical theory of heat", "similarity": 0.931}], "id": 5039, "stable_key": "clu_f485994685581302", "ground_truth": {"modern_name": "Kinetic theory of heat", "confidence": "high", "type": "concept", "note": "The terms 'dynamic theory of heat' and 'mechanical theory of heat' are early descriptions of the modern kinetic theory of heat, which posits heat as a form of energy related to the motion of particles."}}, {"canonical_name": "bar magnets", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "bar_magnets", "book_id": "connexion_physical_sciences_somerville_1858", "name": "bar magnets", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["bar magnets"], "contexts": ["magnets used in experiment", "magnets of same length, size, intensity"]}, {"entity_id": "magnets", "book_id": "first_principles_spencer_1862", "name": "magnets", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["magnets"], "contexts": ["objects with magnetic properties"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "bar magnets", "target_book": "first_principles_spencer_1862", "target_name": "magnets", "similarity": 0.935}], "id": 5040, "stable_key": "clu_ece06f0950005099", "ground_truth": {"modern_name": "Bar magnet", "confidence": "high", "type": "object", "wikidata_id": "Q29645971", "wikidata_description": "a rod of uniformely magnetized material with two opposite magnetic poles at its ends"}}, {"canonical_name": "pole of the earth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pole_of_the_earth", "book_id": "connexion_physical_sciences_somerville_1858", "name": "pole of the earth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["pole of the earth"], "contexts": ["axis of Earth's rotation", "rotational axis of the earth"]}, {"entity_id": "pole", "book_id": "first_principles_spencer_1862", "name": "pole", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["pole"], "contexts": ["transfer of matter in battery"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "pole of the earth", "target_book": "first_principles_spencer_1862", "target_name": "pole", "similarity": 0.894}], "id": 5041, "stable_key": "clu_e0a72685fabf93ca", "ground_truth": {"modern_name": "Earth's magnetic poles", "confidence": "high", "type": "concept", "note": "The context 'axis of Earth's rotation' suggests the geographic poles, while 'transfer of matter in battery' points towards magnetic poles. Given the physical science context, magnetic poles are more likely."}}, {"canonical_name": "double star", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "double_star", "book_id": "connexion_physical_sciences_somerville_1858", "name": "double star", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["double star"], "contexts": ["eclipse observed by Admiral Smyth", "astronomical object"]}, {"entity_id": "double_stars", "book_id": "first_principles_spencer_1862", "name": "Double stars", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Double stars"], "contexts": ["two stars orbiting each other"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "double star", "target_book": "first_principles_spencer_1862", "target_name": "Double stars", "similarity": 0.95}], "id": 5042, "stable_key": "clu_5f5fe05732f37589", "ground_truth": {"modern_name": "Binary star", "confidence": "high", "type": "object", "wikidata_id": "Q50053", "wikidata_description": "star system consisting of two stars rotating around a common center of mass"}}, {"canonical_name": "visual organs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "organ_of_sight", "book_id": "connexion_physical_sciences_somerville_1858", "name": "organ of sight", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["organ of sight"], "contexts": ["the eye and its visual structures"]}, {"entity_id": "visual_organs", "book_id": "first_principles_spencer_1862", "name": "visual organs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["visual organs"], "contexts": ["organs responsible for sight"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "organ of sight", "target_book": "first_principles_spencer_1862", "target_name": "visual organs", "similarity": 0.916}], "id": 5043, "stable_key": "clu_f407d4f32f9232a2-3", "ground_truth": {"modern_name": "Eye", "confidence": "high", "type": "object", "wikidata_id": "Q7364", "wikidata_description": "organ that detects light and converts it into electro-chemical impulses in neurons", "wikipedia_url": "https://en.wikipedia.org/wiki/Eye", "note": "While 'eyes' can refer to a part of an animal, the contexts and the general usage in natural philosophy lean towards the organ of sight as an object of study rather than the animal itself.", "wikipedia_extract": "An eye is a sensory organ that allows an organism to perceive visual information. It detects light and converts it into electro-chemical impulses in neurons (neurones). It is part of an organism's visual system. In higher organisms, the eye is a complex optical system that collects light from the surrounding environment, regulates its intensity through a diaphragm, focuses it through an adjustable assembly of lenses to form an image, converts this image into a set of electrical signals, and transmits these signals to the brain through neural pathways that connect the eye via the optic nerve to the visual cortex and other areas of the brain. Eyes with resolving power have come in ten fundamentally different forms, classified into compound eyes and non-compound eyes. Compound eyes are made up of multiple small visual units, and are common on insects and crustaceans."}}, {"canonical_name": "etherial medium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "etherial_medium", "book_id": "connexion_physical_sciences_somerville_1858", "name": "etherial medium", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["etherial medium"], "contexts": ["hypothesized medium for light propagation"]}, {"entity_id": "etherial_medium", "book_id": "first_principles_spencer_1862", "name": "etherial medium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["etherial medium"], "contexts": ["hypothetical medium filling space", "medium for undulations"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "etherial medium", "target_book": "first_principles_spencer_1862", "target_name": "etherial medium", "similarity": 1.0}], "id": 5044, "stable_key": "clu_4e9dbfca97b0ac74", "ground_truth": {"modern_name": "Luminiferous aether", "confidence": "high", "type": "concept", "wikidata_id": "Q208702", "wikidata_description": "postulated medium for the propagation of light", "wikipedia_extract": "Luminiferous aether or ether (luminiferous meaning 'light-bearing') is the formerly postulated medium for the propagation of light. It was invoked to explain the ability of the apparently wave-based light to propagate through empty space (a vacuum), something that waves should not be able to do. The assumption of a spatial plenum (space completely filled with matter) of luminiferous aether, rather than a spatial vacuum, provided the theoretical medium that was required by wave theories of light. The aether hypothesis was the topic of considerable debate throughout its history, as it required the existence of an invisible and infinite material with no interaction with physical objects. As the nature of light was explored, especially in the 19th century, the physical qualities required of an aether became increasingly contradictory. By the late 19th century, the existence of the aether was being questioned, although there was no physical theory to replace it.", "wikipedia_url": "https://en.wikipedia.org/wiki/Luminiferous_aether"}}, {"canonical_name": "physical geographers", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "physical_geographers", "book_id": "connexion_physical_sciences_somerville_1858", "name": "physical geographers", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["physical geographers"], "contexts": ["divided globe into botanical districts"]}, {"entity_id": "geographers", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Geographers", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Geographers"], "contexts": ["lunar motions important to them"]}, {"entity_id": "geographers", "book_id": "first_principles_spencer_1862", "name": "geographers", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["geographers"], "contexts": ["disciplines studying Earth's surface"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "physical geographers", "target_book": "first_principles_spencer_1862", "target_name": "geographers", "similarity": 0.96}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Geographers", "target_book": "first_principles_spencer_1862", "target_name": "geographers", "similarity": 0.99}], "id": 5045, "stable_key": "clu_a6cd4545dc305ca6", "ground_truth": {"modern_name": "Geographers", "confidence": "high", "type": "person", "description": "Scholars studying Earth's surface and its features.", "wikidata_id": "Q901402", "wikidata_description": "scholar whose area of study is geography", "wikipedia_url": "https://en.wikipedia.org/wiki/Geographer", "wikipedia_extract": "A geographer is a physical scientist, social scientist or humanist whose area of study is geography, the study of Earth's natural environment and human society, including how society and nature interact. The Greek prefix \"geo\" means \"earth\" and the Greek suffix, \"graphy\", meaning \"description\", so a geographer is someone who studies the earth. The word \"geography\" is a Middle French word that is believed to have been first used in 1540. Although geographers are historically known as people who make maps, map making is actually the field of study of cartography, a subset of geography. Geographers do not study only the details of the natural environment or human society, but they also study the reciprocal relationship between these two. For example, they study how the natural environment contributes to human society and how human society affects the natural environment."}}, {"canonical_name": "locality", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "localities", "book_id": "connexion_physical_sciences_somerville_1858", "name": "localities", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["localities"], "contexts": ["where venomous snakes are specifically different"]}, {"entity_id": "locality", "book_id": "first_principles_spencer_1862", "name": "locality", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["locality"], "contexts": ["specific area", "a specific place or area"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "localities", "target_book": "first_principles_spencer_1862", "target_name": "locality", "similarity": 0.924}], "id": 5046, "stable_key": "clu_d96dafaf61d1e311", "ground_truth": {"modern_name": "Locality", "confidence": "high", "type": "place", "wikidata_id": "Q3257686", "wikidata_description": "place of human settlement"}}, {"canonical_name": "Force of Expansion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "force_of_expansion", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Force of Expansion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Force of Expansion"], "contexts": ["energy driving expansion"]}, {"entity_id": "expansive_force", "book_id": "connexion_physical_sciences_somerville_1858", "name": "expansive force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["expansive force"], "contexts": ["force associated with heat absorption"]}, {"entity_id": "expansive_force", "book_id": "first_principles_spencer_1862", "name": "expansive force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["expansive force"], "contexts": ["force that promotes growth"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Force of Expansion", "target_book": "first_principles_spencer_1862", "target_name": "expansive force", "similarity": 0.934}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "expansive force", "target_book": "first_principles_spencer_1862", "target_name": "expansive force", "similarity": 1.0}], "id": 5047, "stable_key": "clu_32a184f95b5e07aa", "ground_truth": {"modern_name": "Expansive Force", "confidence": "high", "type": "concept", "wikidata_id": "Q106950291", "wikidata_description": "scientific article"}}, {"canonical_name": "mechanical action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mechanical_action", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mechanical action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mechanical action"], "contexts": ["force applied to produce work"]}, {"entity_id": "mechanical_actions", "book_id": "first_principles_spencer_1862", "name": "mechanical actions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mechanical actions"], "contexts": ["actions distinguishing food"]}, {"entity_id": "mechanical_movement", "book_id": "first_principles_spencer_1862", "name": "mechanical movement", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mechanical movement"], "contexts": ["physical motion caused by force"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "mechanical action", "target_book": "first_principles_spencer_1862", "target_name": "mechanical actions", "similarity": 0.97}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "mechanical action", "target_book": "first_principles_spencer_1862", "target_name": "mechanical movement", "similarity": 0.893}], "id": 5048, "stable_key": "clu_87bcee747039950f", "ground_truth": {"modern_name": "Mechanical Action", "confidence": "high", "type": "concept", "wikidata_id": "Q59477049", "wikidata_description": "scholarly article published August 1990"}}, {"canonical_name": "piston", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "piston", "book_id": "connexion_physical_sciences_somerville_1858", "name": "piston", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["piston"], "contexts": ["device for compressing air"]}, {"entity_id": "piston", "book_id": "first_principles_spencer_1862", "name": "piston", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["piston"], "contexts": ["moving part in a steam engine", "part of engine moved by steam"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "piston", "target_book": "first_principles_spencer_1862", "target_name": "piston", "similarity": 0.836}], "id": 5049, "stable_key": "clu_ac97cdc5bc600d1d", "ground_truth": {"modern_name": "piston", "confidence": "high", "type": "object", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Pistone", "wikipedia_extract": "Pistone is an Italian surname. Notable people with the surname include: Alessandro Pistone (born 1975), Italian footballer Anita Pistone (born 1976), Italian sprinter Chase Pistone (born 1983), American racing driver Dani\u00e8le Pistone (born 1946), French musicologist and professor Joseph D."}}, {"canonical_name": "magnetic condition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "magnetic_condition", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic condition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic condition"], "contexts": ["state of magnetic material"]}, {"entity_id": "magnetic_state", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic state", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic state"], "contexts": ["intensity of magnetism"]}, {"entity_id": "magnetic_state", "book_id": "first_principles_spencer_1862", "name": "magnetic state", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic state"], "contexts": ["change accompanied by heat"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "magnetic condition", "target_book": "first_principles_spencer_1862", "target_name": "magnetic state", "similarity": 0.917}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "magnetic state", "target_book": "first_principles_spencer_1862", "target_name": "magnetic state", "similarity": 1.0}], "id": 5050, "stable_key": "clu_6b03c3a6899f49c6", "ground_truth": {"modern_name": "magnetic state", "confidence": "high", "type": "concept", "note": "Early modern texts might use 'condition' or 'state' interchangeably with 'magnetization' or 'magnetic susceptibility'.", "wikidata_id": "Q6731637", "wikidata_description": "process contributing to image contrast in magnetic resonance imaging"}}, {"canonical_name": "magnetic variations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "secular_magnetic_variations", "book_id": "connexion_physical_sciences_somerville_1858", "name": "secular magnetic variations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["secular magnetic variations"], "contexts": ["long-term changes in Earth's magnetism"]}, {"entity_id": "magnetic_variations", "book_id": "first_principles_spencer_1862", "name": "magnetic variations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["magnetic variations"], "contexts": ["changes in Earth's magnetic field"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "secular magnetic variations", "target_book": "first_principles_spencer_1862", "target_name": "magnetic variations", "similarity": 0.915}], "id": 5051, "stable_key": "clu_3ccd2bedafa5c1ec", "ground_truth": {"modern_name": "secular variation of Earth's magnetic field", "confidence": "high", "type": "concept"}}, {"canonical_name": "indestructibility of Matter", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "indestructibility_of_matter", "book_id": "connexion_physical_sciences_somerville_1858", "name": "indestructibility of matter", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["indestructibility of matter"], "contexts": ["fundamental principle in physics"]}, {"entity_id": "indestructibility_of_matter", "book_id": "first_principles_spencer_1862", "name": "indestructibility of Matter", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["indestructibility of Matter"], "contexts": ["principle that matter cannot be created or destroyed"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "indestructibility of matter", "target_book": "first_principles_spencer_1862", "target_name": "indestructibility of Matter", "similarity": 0.978}], "id": 5052, "stable_key": "clu_8d046a04c883fc41", "ground_truth": {"modern_name": "Conservation of Mass", "confidence": "high", "type": "concept", "wikipedia_extract": "In physics and chemistry, the law of conservation of mass or principle of mass conservation states that for any system which is closed to all incoming and outgoing transfers of matter, the mass of the system must remain constant over time. The law implies that mass can neither be created nor destroyed, although it may be rearranged in space, or the entities associated with it may be changed in form. For example, in chemical reactions, the mass of the chemical components before the reaction is equal to the mass of the components after the reaction. Thus, during any chemical reaction and low-energy thermodynamic processes in an isolated system, the total mass of the reactants, or starting materials, must be equal to the mass of the products. The concept of mass conservation is widely used in many fields such as chemistry, mechanics, and fluid dynamics. Historically, mass conservation in chemical reactions was primarily demonstrated in the 17th century and finally confirmed by Antoine Lavoisier in the late 18th century."}}, {"canonical_name": "stable equilibrium", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "static_equilibrium", "book_id": "connexion_physical_sciences_somerville_1858", "name": "static equilibrium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["static equilibrium"], "contexts": ["state of balance without movement"]}, {"entity_id": "stable_equilibrium", "book_id": "first_principles_spencer_1862", "name": "stable equilibrium", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["stable equilibrium"], "contexts": ["condition reached by elements", "balance of forces that returns to position"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "static equilibrium", "target_book": "first_principles_spencer_1862", "target_name": "stable equilibrium", "similarity": 0.955}], "id": 5053, "stable_key": "clu_e00f31cc3e32b7ca", "ground_truth": {"modern_name": "stable equilibrium", "confidence": "high", "type": "concept", "wikidata_id": "Q2325497", "wikidata_description": "the tendency of a physical system to return to its equilibrium or steady state after disturbance"}}, {"canonical_name": "unstable equilibrium", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "unstable_equilibrium", "bo