, "Professor who made heat estimations"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Helmholtz", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Helmholtz", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Helmholtz", "target_book": "first_principles_spencer_1862", "target_name": "Helmholtz", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Helmholtz", "target_book": "first_principles_spencer_1862", "target_name": "Helmholtz", "similarity": 1.0}], "id": 911, "stable_key": "clu_ac5a478f44a2b09b", "ground_truth": {"modern_name": "Hermann von Helmholtz", "confidence": "high", "type": "person", "birth_year": 1821, "death_year": 1894, "description": "German physician and physicist, pioneering researcher in optics, electromagnetism, and nerve physiology.", "wikidata_id": "Q113814860", "wikidata_description": "street in Kleinmachnow, Brandenburg, Germany", "note": "The text 'principles_of_psychology_james_1890' refers to William James, whose work was heavily influenced by Helmholtz. The 'coloquios_da_orta_1563' reference to 'Hermanno' is likely a different individual, possibly referencing Dioscorides' 'Hermion' or similar ancient botanical names, but the primary context points to Helmholtz. Given the dominant context, Helmholtz is the most probable referent."}}, {"canonical_name": "Gay-Lussac", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 37, "members": [{"entity_id": "gay-lussac", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Gay-Lussac", "category": "PERSON", "subcategory": "SCHOLAR", "count": 20, "variants": ["Gay-Lussac", "J. L. Gay-Lussac", "M. Gay-Lussac", "MM. Gay-Lussac"], "contexts": ["cited author in chemistry", "author on volcano action"]}, {"entity_id": "gay-lussac", "book_id": "kosmos_humboldt_1845", "name": "Gay-Lussac", "category": "PERSON", "sub