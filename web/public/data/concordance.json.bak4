ource_book": "medecine_experimentale_bernard_1865", "source_name": "mind", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "human mind", "similarity": 0.971}], "id": 265, "stable_key": "clu_6703acf9f6afab27", "ground_truth": {"modern_name": "Human mind", "confidence": "high", "type": "concept", "note": "The contexts 'organ of thought and consciousness' and 'seat of ignorance and weakness' are consistent with early modern philosophical and psychological discussions of the mind.", "wikidata_id": "Q15221937", "wikidata_description": "non-commercial online mineralogical database", "wikipedia_url": "", "wikipedia_extract": ""}}, {"canonical_name": "substances", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 5, "total_mentions": 10, "members": [{"entity_id": "substances", "book_id": "medecine_experimentale_bernard_1865", "name": "substances", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["substances"], "contexts": ["materials eliminated by the body", "materials that can combine"]}, {"entity_id": "substances", "book_id": "epoques_nature_buffon_1778", "name": "substances", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["substances"], "contexts": ["materials forming the history of nature", "substances"]}, {"entity_id": "substances", "book_id": "principles_of_psychology_james_1890", "name": "substances", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["substances"], "contexts": ["used for gustatory reactions"]}, {"entity_id": "substances", "book_id": "kosmos_humboldt_1845", "name": "substances", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["substances"], "contexts": ["material of which a thing is made", "materials with elementary composition"]}, {"entity_id": "substances", "book_id": "first_principles_spencer_1862", "name": "substances", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["substances"], "contexts": ["affected by light agent", "materials with contrasting relations to forces"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "substances", "target_book": "epoques_nature_buffon_1778", "target_name": "substances", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "substances", "target_book": "principles_of_psychology_james_1890", "target_name": "substances", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "substances", "target_book": "kosmos_humboldt_1845", "target_name": "substances", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "substances", "target_book": "first_principles_spencer_1862", "target_name": "substances", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "substances", "target_book": "principles_of_psychology_james_1890", "target_name": "substances", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "substances", "target_book": "kosmos_humboldt_1845", "target_name": "substances", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "substances", "target_book": "first_principles_spencer_1862", "target_name": "substances", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "substances", "target_book": "kosmos_humboldt_1845", "target_name": "substances", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "substances", "target_book": "first_principles_spencer_1862", "target_name": "substances", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "substances", "target_book": "first_principles_spencer_1862", "target_name": "substances", "similarity": 1.0}], "id": 266, "stable_key": "clu_337b34319257e325", "ground_truth": {"modern_name": "Substance", "confidence": "high", "type": "concept", "wikidata_id": "Q378078", "wikidata_description": "basic ontological concept", "wikipedia_url": "https://en.wikipedia.org/wiki/Substance%20theory", "wikipedia_extract": "Substance theory, or substance\u2013attribute theory, is an ontological theory positing that objects are constituted each by a substance and properties borne by the substance but distinct from it. In this role, a substance can be referred to as a substratum or a thing-in-itself. Substances are particulars that are ontologically independent: they are able to exist all by themselves. Another defining feature often attributed to substances is their ability to undergo changes. Changes involve something existing before, during and after the change. They can be described in terms of a persisting substance gaining or losing properties."}}, {"canonical_name": "Medicine", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 5, "total_mentions": 10, "members": [{"entity_id": "medicine", "book_id": "medecine_experimentale_bernard_1865", "name": "medicine", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["medicine"], "contexts": ["practice of diagnosing and treating illness"]}, {"entity_id": "medicine", "book_id": "epoques_nature_buffon_1778", "name": "medicine", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["medicine"], "contexts": ["art and science of healing"]}, {"entity_id": "medicine", "book_id": "english_physician_1652", "name": "Medicine", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 4, "variants": ["Medicine"], "contexts": ["practice of healing", "field where Garden Valerian root is used"]}, {"entity_id": "medicine", "book_id": "principles_of_psychology_james_1890", "name": "medicine", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["medicine"], "contexts": ["practice of diagnosing and treating illness", "substance used for treating illness"]}, {"entity_id": "medicine", "book_id": "kosmos_humboldt_1845", "name": "medicine", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["medicine"], "contexts": ["field of healing and treatment"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "medicine", "target_book": "epoques_nature_buffon_1778", "target_name": "medicine", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "medicine", "target_book": "english_physician_1652", "target_name": "Medicine", "similarity": 0.966}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "medicine", "target_book": "principles_of_psychology_james_1890", "target_name": "medicine", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "medicine", "target_book": "kosmos_humboldt_1845", "target_name": "medicine", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "medicine", "target_book": "english_physician_1652", "target_name": "Medicine", "similarity": 0.966}, {"source_book": "epoques_nature_buffon_1778", "source_name": "medicine", "target_book": "principles_of_psychology_james_1890", "target_name": "medicine", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "medicine", "target_book": "kosmos_humboldt_1845", "target_name": "medicine", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Medicine", "target_book": "principles_of_psychology_james_1890", "target_name": "medicine", "similarity": 0.966}, {"source_book": "english_physician_1652", "source_name": "Medicine", "target_book": "kosmos_humboldt_1845", "target_name": "medicine", "similarity": 0.966}, {"source_book": "principles_of_psychology_james_1890", "source_name": "medicine", "target_book": "kosmos_humboldt_1845", "target_name": "medicine", "similarity": 1.0}], "id": 267, "stable_key": "clu_e874316946eb152a-2", "ground_truth": {"modern_name": "Medicine", "confidence": "high", "type": "concept", "note": "This cluster refers to the broad concept of medical practice and healing, as indicated by the various languages and contexts provided.", "wikidata_id": "Q12140", "wikidata_description": "substance used to diagnose, cure, treat, or prevent disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Medication", "wikipedia_extract": "Medication (also called medicament, medicine, pharmaceutical drug, medicinal product, medicinal drug, or simply drug) is a drug used to diagnose, cure, treat, or prevent disease. Drug therapy (pharmacotherapy) is an important part of the medical field and relies on the science of pharmacology for continual advancement and on pharmacy for appropriate management. Drugs are classified in many ways. One of the key divisions is by level of control, which distinguishes prescription drugs (those that a pharmacist dispenses only on the medical prescription) from over-the-counter drugs (those that consumers can order for themselves). Medicines may be classified by mode of action, route of administration, biological system affected, or therapeutic effects. The World Health Organization keeps a list of essential medicines."}}, {"canonical_name": "rivers", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 5, "total_mentions": 10, "members": [{"entity_id": "rivi\u00e8res", "book_id": "epoques_nature_buffon_1778", "name": "rivi\u00e8res", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["rivi\u00e8res"], "contexts": ["waterways carrying metallic flakes"]}, {"entity_id": "rivers", "book_id": "english_physician_1652", "name": "Rivers", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Rivers"], "contexts": ["habitat of the plant"]}, {"entity_id": "rivers", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "rivers", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["rivers"], "contexts": ["source of salt"]}, {"entity_id": "rivers", "book_id": "principles_of_psychology_james_1890", "name": "rivers", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["rivers"], "contexts": ["natural flowing watercourses"]}, {"entity_id": "rivers", "book_id": "first_principles_spencer_1862", "name": "rivers", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["rivers"], "contexts": ["natural flowing watercourses", "waterways carrying sediment to the sea"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "rivi\u00e8res", "target_book": "english_physician_1652", "target_name": "Rivers", "similarity": 0.959}, {"source_book": "epoques_nature_buffon_1778", "source_name": "rivi\u00e8res", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "rivers", "similarity": 0.967}, {"source_book": "epoques_nature_buffon_1778", "source_name": "rivi\u00e8res", "target_book": "principles_of_psychology_james_1890", "target_name": "rivers", "similarity": 0.967}, {"source_book": "epoques_nature_buffon_1778", "source_name": "rivi\u00e8res", "target_book": "first_principles_spencer_1862", "target_name": "rivers", "similarity": 0.967}, {"source_book": "english_physician_1652", "source_name": "Rivers", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "rivers", "similarity": 0.985}, {"source_book": "english_physician_1652", "source_name": "Rivers", "target_book": "principles_of_psychology_james_1890", "target_name": "rivers", "similarity": 0.985}, {"source_book": "english_physician_1652", "source_name": "Rivers", "target_book": "first_principles_spencer_1862", "target_name": "rivers", "similarity": 0.985}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "rivers", "target_book": "principles_of_psychology_james_1890", "target_name": "rivers", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "rivers", "target_book": "first_principles_spencer_1862", "target_name": "rivers", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "rivers", "target_book": "first_principles_spencer_1862", "target_name": "rivers", "similarity": 1.0}], "id": 268, "stable_key": "clu_abebe06cf2e7ff3c", "ground_truth": {"modern_name": "River", "confidence": "high", "type": "place", "country": "Multiple", "note": "The term 'rivi\u00e8re' is French for 'river', and the contexts clearly refer to natural waterways. The specific location is not identifiable from the provided information.", "wikidata_id": "Q15799", "wikidata_description": "Argentine professional sports club based in Buenos Aires", "wikipedia_url": "https://en.wikipedia.org/wiki/Club%20Atl%C3%A9tico%20River%20Plate", "wikipedia_extract": "Club Atl\u00e9tico River Plate (CARP) (Spanish pronunciation: [\u02c8klu\u03b2 a\u02c8tletiko \u02c8ri\u03b2er \u02c8pleit]) is an Argentine professional sports club based in the Belgrano neighborhood of Buenos Aires. Founded in 1901, the club is named after the English-language name for the city's estuary, R\u00edo de la Plata. River's home stadium, the Monumental, is the largest in South America. River had the highest average home attendance of any association football club in the world in 2023 with 84,567. With more than 350,000 members at the end of 2023, River is one of the largest sports clubs by membership. It repeated this achievement in 2024 and 2025."}}, {"canonical_name": "Soldam", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 5, "total_mentions": 10, "members": [{"entity_id": "soldier", "book_id": "english_physician_1652", "name": "Soldier", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Soldier"], "contexts": ["profession associated with Mars"]}, {"entity_id": "soldier", "book_id": "principles_of_psychology_james_1890", "name": "soldier", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["soldier"], "contexts": ["person in military service", "member of an army"]}, {"entity_id": "soldados", "book_id": "historia_medicinal_monardes_1574", "name": "soldados", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["soldados", "Soldanc\u00f3"], "contexts": ["tired individuals", "gave a poisoned wound"]}, {"entity_id": "soldam", "book_id": "coloquios_da_orta_1563", "name": "Soldam", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["Soldam", "Soldam Badur", "Soldam de Babylonia"], "contexts": ["sovereign of Egypt", "sovereign Mameluke of Egypt"]}, {"entity_id": "soldado", "book_id": "polyanthea_medicinal", "name": "Soldado", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Soldado"], "contexts": ["soldier who uses weapons"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Soldier", "target_book": "principles_of_psychology_james_1890", "target_name": "soldier", "similarity": 0.977}, {"source_book": "english_physician_1652", "source_name": "Soldier", "target_book": "historia_medicinal_monardes_1574", "target_name": "soldados", "similarity": 0.894}, {"source_book": "english_physician_1652", "source_name": "Soldier", "target_book": "coloquios_da_orta_1563", "target_name": "Soldam", "similarity": 0.97}, {"source_book": "english_physician_1652", "source_name": "Soldier", "target_book": "polyanthea_medicinal", "target_name": "Soldado", "similarity": 0.981}, {"source_book": "principles_of_psychology_james_1890", "source_name": "soldier", "target_book": "historia_medicinal_monardes_1574", "target_name": "soldados", "similarity": 0.928}, {"source_book": "principles_of_psychology_james_1890", "source_name": "soldier", "target_book": "coloquios_da_orta_1563", "target_name": "Soldam", "similarity": 0.954}, {"source_book": "principles_of_psychology_james_1890", "source_name": "soldier", "target_book": "polyanthea_medicinal", "target_name": "Soldado", "similarity": 0.956}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "soldados", "target_book": "coloquios_da_orta_1563", "target_name": "Soldam", "similarity": 0.889}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "soldados", "target_book": "polyanthea_medicinal", "target_name": "Soldado", "similarity": 0.875}, {"source_book": "coloquios_da_orta_1563", "source_name": "Soldam", "target_book": "polyanthea_medicinal", "target_name": "Soldado", "similarity": 0.972}], "id": 269, "stable_key": "clu_7f0573cd36b6d4dc", "ground_truth": {"modern_name": "Soldier", "confidence": "high", "type": "person", "description": "Individual engaged in military service, often associated with Mars.", "note": "The Spanish 'soldados' and Portuguese 'soldado' clearly translate to 'soldiers'. The context of being tired or associated with Mars further supports this identification.", "wikidata_id": "Q1981860", "wikidata_description": "city in Kansas, USA", "wikipedia_url": "https://en.wikipedia.org/wiki/Soldier%2C%20Kansas", "wikipedia_extract": "Soldier is a city in Jackson County, Kansas, United States. As of the 2020 census, the population of the city was 102. The first settlement was made at Soldier in 1877, and the town was laid out in the same year. Soldier took its name from Soldier Creek. The city was incorporated in 1896. A tornado in 1883 destroyed 18 buildings and killed four people."}}, {"canonical_name": "instruments", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 5, "total_mentions": 10, "members": [{"entity_id": "instruments", "book_id": "medecine_experimentale_bernard_1865", "name": "instruments", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["instruments"], "contexts": ["tools to aid observation", "tools for scientific experimentation"]}, {"entity_id": "instruments", "book_id": "kosmos_humboldt_1845", "name": "instruments", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["instruments"], "contexts": ["tools used for scientific observation and measurement", "tools used for measurement"]}, {"entity_id": "instrumentos", "book_id": "polyanthea_medicinal", "name": "instrumentos", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["instrumentos"], "contexts": ["tools for delivery"]}, {"entity_id": "instruments", "book_id": "epoques_nature_buffon_1778", "name": "instruments", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["instruments"], "contexts": ["tools for scientific observation"]}, {"entity_id": "instruments", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Instruments", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 4, "variants": ["instruments", "Instruments"], "contexts": ["tools used for scientific observation", "tools used in scientific observation"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "instruments", "target_book": "kosmos_humboldt_1845", "target_name": "instruments", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "instruments", "target_book": "polyanthea_medicinal", "target_name": "instrumentos", "similarity": 0.991}, {"source_book": "kosmos_humboldt_1845", "source_name": "instruments", "target_book": "polyanthea_medicinal", "target_name": "instrumentos", "similarity": 0.991}, {"source_book": "epoques_nature_buffon_1778", "source_name": "instruments", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Instruments", "similarity": 0.988}], "id": 270, "stable_key": "clu_6e18e1816b9cd014", "ground_truth": {"modern_name": "scientific instruments", "confidence": "high", "type": "object", "wikidata_id": "Q8037077", "wikidata_description": "Livery company of the City of London", "wikipedia_url": "https://en.wikipedia.org/wiki/Worshipful%20Company%20of%20Scientific%20Instrument%20Makers", "wikipedia_extract": "The Worshipful Company of Scientific Instrument Makers is one of the 111 livery companies of the City of London. It ranks 84th in the order of precedence for the livery companies. The Company was originally formed in 1956 when science and manufacturing were key to the UK economy  and the memory of war time defence requirements were still fresh and the UK was a large-scale manufacturer of specialist electronic and mechanical scientific instruments. It is one of the Modern Livery Companies formed since 1926 having been granted its livery status by the City in 1963. In 2021, it was granted a Royal Charter. As with the original Livery Companies it supports the profession and the craft of scientific instrument making, this is achieved through the exchange of ideas and information between members and guests, and also by its charitable donations supporting those in or retired from the profession."}}, {"canonical_name": "Lavoisier", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 5, "total_mentions": 9, "members": [{"entity_id": "lavoisier", "book_id": "medecine_experimentale_bernard_1865", "name": "Lavoisier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Lavoisier"], "contexts": ["scientist who conducted experiments on heat", "chemist who studied respiration"]}, {"entity_id": "lavoisier", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Lavoisier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Lavoisier"], "contexts": ["evaluator of wheat price", "evaluated kilogram of wheat"]}, {"entity_id": "lavoisier", "book_id": "principles_of_psychology_james_1890", "name": "Lavoisier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Lavoisier"], "contexts": ["Author of early Chemistry text", "author of Chemistry text"]}, {"entity_id": "lavoisier", "book_id": "kosmos_humboldt_1845", "name": "Lavoisier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Lavoisier"], "contexts": ["expressed idea about Prometheus myth", "chemist"]}, {"entity_id": "lavoisier", "book_id": "coloquios_da_orta_1563", "name": "Lavoisier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Lavoisier"], "contexts": ["scientist who anticipated experiments"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Lavoisier", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Lavoisier", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Lavoisier", "target_book": "principles_of_psychology_james_1890", "target_name": "Lavoisier", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Lavoisier", "target_book": "kosmos_humboldt_1845", "target_name": "Lavoisier", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Lavoisier", "target_book": "coloquios_da_orta_1563", "target_name": "Lavoisier", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lavoisier", "target_book": "principles_of_psychology_james_1890", "target_name": "Lavoisier", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lavoisier", "target_book": "kosmos_humboldt_1845", "target_name": "Lavoisier", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lavoisier", "target_book": "coloquios_da_orta_1563", "target_name": "Lavoisier", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Lavoisier", "target_book": "kosmos_humboldt_1845", "target_name": "Lavoisier", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Lavoisier", "target_book": "coloquios_da_orta_1563", "target_name": "Lavoisier", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Lavoisier", "target_book": "coloquios_da_orta_1563", "target_name": "Lavoisier", "similarity": 1.0}], "id": 271, "stable_key": "clu_8f86aa826fd2c352", "ground_truth": {"modern_name": "Antoine Lavoisier", "confidence": "high", "type": "person", "birth_year": 1743, "death_year": 1794, "description": "French chemist, Father of modern chemistry", "note": "The presence of 'coloquios_da_orta_1563' is an anomaly, as Lavoisier was born centuries later. This suggests an error in the provided context or data. However, the other contexts strongly point to the famous chemist.", "wikidata_id": "Q39607", "wikidata_description": "French nobleman and chemist (1743\u20131794)", "wikipedia_url": "https://en.wikipedia.org/wiki/Antoine%20Lavoisier", "wikipedia_extract": "Antoine-Laurent de Lavoisier ( l\u0259-VWAH-zee-ay; French: [\u0251\u0303twan l\u0254\u0281\u0251\u0303 d\u0259 lavwazje]; 26 August 1743 \u2013 8 May 1794), also Antoine Lavoisier after the French Revolution, was a French nobleman and chemist who was central to the 18th-century chemical revolution and who had a large influence on both the history of chemistry and the history of biology. It is generally accepted that Lavoisier's great accomplishments in chemistry stem largely from his changing the science from a qualitative to a quantitative one. Lavoisier is noted for his discovery of the role oxygen plays in combustion, opposing the prior phlogiston theory of combustion. He named oxygen (1778), recognizing it as an element, and also recognized hydrogen as an element (1783). By using more precise measurements than previous experimenters, he confirmed the  developing theory that, although matter in a closed system may change its form or shape, its mass always remains the same (now known as the law of conservation of mass), which led to the development of the balanced physical and chemical reaction equations that we still use today. Lavoisier helped construct the metric system, wrote the first extensive list of elements, in which he predicted the existence of silicon, and helped to reform chemical nomenclature."}}, {"canonical_name": "problem", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 9, "members": [{"entity_id": "probl\u00e8mes", "book_id": "medecine_experimentale_bernard_1865", "name": "probl\u00e8mes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["probl\u00e8mes"], "contexts": ["problems"]}, {"entity_id": "problems", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Problems", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Problems"], "contexts": ["Aristotle's collection of questions", "Aristotle's work on scientific questions"]}, {"entity_id": "problem", "book_id": "principles_of_psychology_james_1890", "name": "problem", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["problem"], "contexts": ["unresolved question or difficulty", "intellectual challenge to find means"]}, {"entity_id": "problem_", "book_id": "polyanthea_medicinal", "name": "Problem.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Problem."], "contexts": ["section of a text"]}, {"entity_id": "problem", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Problem", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Problem"], "contexts": ["mathematical or scientific challenge"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "probl\u00e8mes", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Problems", "similarity": 0.967}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "probl\u00e8mes", "target_book": "principles_of_psychology_james_1890", "target_name": "problem", "similarity": 0.88}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "probl\u00e8mes", "target_book": "connexion_physical_sciences_somerville_1858", "target_n