_orta_1563", "source_name": "Turquia", "target_book": "ricettario_fiorentino_1597", "target_name": "Turchia", "similarity": 0.991}, {"source_book": "coloquios_da_orta_1563", "source_name": "Turquia", "target_book": "first_principles_spencer_1862", "target_name": "Turkey", "similarity": 0.967}, {"source_book": "coloquios_da_orta_1563", "source_name": "Turco", "target_book": "ricettario_fiorentino_1597", "target_name": "Turchia", "similarity": 0.967}, {"source_book": "coloquios_da_orta_1563", "source_name": "Turco", "target_book": "first_principles_spencer_1862", "target_name": "Turkey", "similarity": 0.958}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Turchia", "target_book": "first_principles_spencer_1862", "target_name": "Turkey", "similarity": 0.965}], "id": 417, "stable_key": "clu_772f7e50749070a0", "ground_truth": {"modern_name": "Turkey", "confidence": "high", "type": "place", "description": "Country of origin for physicians and rhubarb; also associated with sugar consumption.", "wikipedia_extract": "Turkey, officially the Republic of T\u00fcrkiye, is a country mainly located in Anatolia in West Asia, with a relatively small part called East Thrace in Southeast Europe. It borders the Black Sea to the north; Georgia, Armenia, Azerbaijan, and Iran to the east; Iraq, Syria, and the Mediterranean Sea to the south; and the Aegean Sea, Greece, and Bulgaria to the west. Turkey is home to over 86 million people; most are ethnic Turks, while Kurds are the largest ethnic minority. Officially a secular state, Turkey has a Muslim-majority population. Ankara is Turkey's capital and second-largest city. Istanbul is its largest city and economic center."}}, {"canonical_name": "globe", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 35, "members": [{"entity_id": "globe", "book_id": "epoques_nature_buffon_1778", "name": "globe", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 24, "variants": ["globe"], "contexts": ["earth, as a body", "the Earth"]}, {"entity_id": "le_globe_terrestre", "book_id": "epoques_nature_buffon_1778", "name": "le globe terrestre", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["le globe terrestre"], "contexts": ["the planet Earth"]}, {"entity_id": "globe", "book_id": "relation_historique_humboldt_vol3_1825", "name": "globe", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["globe"], "contexts": ["the Earth", "the Earth as a spherical body"]}, {"entity_id": "terrestrial_globe", "book_id": "kosmos_humboldt_1845", "name": "terrestrial globe", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["terrestrial globe"], "contexts": ["the Earth", "another term for Earth"]}, {"entity_id": "globe", "book_id": "first_principles_spencer_1862", "name": "globe", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["globe"], "contexts": ["the Earth"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "globe", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "globe", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "globe", "target_book": "kosmos_humboldt_1845", "target_name": "terrestrial globe", "similarity": 0.931}, {"source_book": "epoques_nature_buffon_1778", "source_name": "globe", "target_book": "first_principles_spencer_1862", "target_name": "globe", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "le globe terrestre", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "globe", "similarity": 0.932}, {"source_book": "epoques_nature_buffon_1778", "source_name": "le globe terrestre", "target_book": "kosmos_humboldt_1845", "target_name": "terrestrial globe", "similarity": 0.968}, {"source_book": "epoques_nature_buffon_1778", "source_name": "le globe terrestre", "target_book": "first_principles_spencer_1862", "target_name": "globe", "similarity": 0.932}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "globe", "target_book": "kosmos_humboldt_1845", "target_name": "terrestrial globe", "similarity": 0.931}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "globe", "target_book": "first_principles_spencer_1862", "target_name": "globe", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "terrestrial globe", "target_book": "first_principles_spencer_1862", "target_name": "globe", "similarity": 0.931}], "id": 418, "stable_key": "clu_f522307c9c5c037e-2", "ground_truth": {"modern_name": "Earth", "confidence": "high", "type": "place", "country": "Global", "wikidata_id": "Q36133", "wikidata_description": "natural body consisting of layers that are primarily composed of minerals", "wikipedia_url": "https://en.wikipedia.org/wiki/Soil", "wikipedia_extract": "Soil, also commonly referred to as earth, is a mixture of organic matter, minerals, gases, water, and organisms that together support the life of plants and soil organisms. Some scientific definitions distinguish dirt from soil by restricting the former term specifically to displaced soil. Soil consists of a solid collection of minerals and organic matter (the soil matrix), as well as a porous phase that holds gases (the soil atmosphere) and a liquid phase that holds water and dissolved substances both organic and inorganic, in ionic or in molecular form (the soil solution). Accordingly, soil is a complex three-state system of solids, liquids, and gases. Soil is a product of several factors: the influence of climate, relief (elevation, orientation, and slope of terrain), organisms, and the soil's parent materials (original minerals) interacting over time. It continually undergoes development by way of numerous physical, chemical and biological processes, which include weathering with associated erosion.", "note": "The term 'terra' or 'terre' in early modern texts can refer to the planet Earth, or to mineral earths used in medicine or as impurities."}}, {"canonical_name": "Turcos", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 35, "members": [{"entity_id": "turcos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Turcos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["turcos", "Turcos"], "contexts": ["people who call it Ginzibil", "people who possessed the port of Marseille"]}, {"entity_id": "turks", "book_id": "kosmos_humboldt_1845", "name": "Turks", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Turks"], "contexts": ["ethnic group"]}, {"entity_id": "turcos", "book_id": "historia_medicinal_monardes_1574", "name": "Turcos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Turcos"], "contexts": ["people of Turkey"]}, {"entity_id": "turcos", "book_id": "coloquios_da_orta_1563", "name": "Turcos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 31, "variants": ["Turcos", "Turcomanos", "turcos", "turcos ottomanos", "turcos seldjukidas"], "contexts": ["people who discern alo\u00e9s quality", "people from Turkey"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Turcos", "target_book": "kosmos_humboldt_1845", "target_name": "Turks", "similarity": 0.948}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Turcos", "target_book": "historia_medicinal_monardes_1574", "target_name": "Turcos", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Turcos", "target_book": "coloquios_da_orta_1563", "target_name": "Turcos", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Turks", "target_book": "historia_medicinal_monardes_1574", "target_name": "Turcos", "similarity": 0.948}, {"source_book": "kosmos_humboldt_1845", "source_name": "Turks", "target_book": "coloquios_da_o