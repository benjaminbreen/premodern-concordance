e": "reflection", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "reflection", "book_id": "principles_of_psychology_james_1890", "name": "reflection", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["reflection"], "contexts": ["deep thought or consideration", "thinking about past experiences"]}, {"entity_id": "reflections", "book_id": "principles_of_psychology_james_1890", "name": "reflections", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["reflections"], "contexts": ["thinking about past experiences"]}, {"entity_id": "reflect", "book_id": "principles_of_psychology_james_1890", "name": "reflect", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["reflect"], "contexts": ["thinking deeply about something"]}, {"entity_id": "reflection", "book_id": "kosmos_humboldt_1845", "name": "reflection", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["reflection"], "contexts": ["power of thought and reasoning"]}, {"entity_id": "reflection", "book_id": "connexion_physical_sciences_somerville_1858", "name": "reflection", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["reflection", "Reflection"], "contexts": ["bouncing of light", "bouncing back of waves"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "reflection", "target_book": "kosmos_humboldt_1845", "target_name": "reflection", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "reflection", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "reflection", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "reflections", "target_book": "kosmos_humboldt_1845", "target_name": "reflection", "similarity": 0.928}, {"source_book": "principles_of_psychology_james_1890