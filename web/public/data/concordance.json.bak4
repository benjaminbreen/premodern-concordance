CE", "subcategory": "CITY", "count": 1, "variants": ["Berne"], "contexts": ["city in Switzerland"]}, {"entity_id": "berne", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Berne", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Berne"], "contexts": ["city with increasing mine temperature"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Berne", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Berne", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Berne", "target_book": "kosmos_humboldt_1845", "target_name": "Berne", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Berne", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Berne", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Berne", "target_book": "kosmos_humboldt_1845", "target_name": "Berne", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Berne", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Berne", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Berne", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Berne", "similarity": 1.0}], "id": 796, "stable_key": "clu_526615ec897540ee", "ground_truth": {"modern_name": "Bern", "confidence": "high", "type": "place", "country": "Switzerland", "wikidata_id": "Q935784", "wikidata_description": "city and urban gmina of Poland", "wikipedia_extract": "Bern (Swiss Standard German: [b\u025brn] ), or Berne (French: [b\u025b\u0281n] ), is the de facto capital of Switzerland, referred to as the \"federal city\". With a population of about 146,000 (as of 2024), Bern is the fifth-most populous city in Switzerland, behind Z\u00fcrich, Geneva, Basel and Lausanne. The Bern agglomeration, which includes 36 municipalities, had a population of 406,900 in 2014. The metropolitan area had a population of 660,000 in 2000. Bern is also the capital of the canton of Bern, the second-most populous of Switzerland's cantons. The city's official language is German.", "wikipedia_url": "https://en.wikipedia.org/wiki/Bern"}}, {"canonical_name": "increase", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 4, "members": [{"entity_id": "increase", "book_id": "origin_of_species_darwin_1859", "name": "increase", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["increase"], "contexts": ["become or make greater"]}, {"entity_id": "increases", "book_id": "principles_of_psychology_james_1890", "name": "increases", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["increases"], "contexts": ["quantifiable additions"]}, {"entity_id": "increase", "book_id": "connexion_physical_sciences_somerville_1858", "name": "increase", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["increase"], "contexts": ["act of becoming greater"]}, {"entity_id": "increase", "book_id": "first_principles_spencer_1862", "name": "increase", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["increase"], "contexts": ["growing in size or number"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "increase", "target_book": "principles_of_psychology_james_1890", "target_name": "increases", "similarity": 0.935}, {"source_book": "origin_of_species_darwin_1859", "source_name": "increase", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "increase", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "increase", "target_book": "first_principles_spencer_1862", "target_name": "increase", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "increases", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "increase", "similarity": 0.935}, {"source_book": "principles_of_psychology_james_1890", "source_name": "increases", "target_book": "first_principles_spencer_1862", "target_name": "increase", "similarity": 0.935}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "increase", "target_book": "first_principles_spencer_1862", "target_name": "increase", "similarity": 1.0}], "id": 797, "stable_key": "clu_650fac6694d994b5", "ground_truth": {"modern_name": "Increase", "confidence": "high", "type": "concept", "wikidata_id": "Q41861", "wikidata_description": "long term medical condition with elevated arterial blood pressure", "wikipedia_url": "https://en.wikipedia.org/wiki/Hypertension", "wikipedia_extract": "Hypertension, also known as high blood pressure, is a long-term medical condition in which the blood pressure in the arteries is persistently elevated. High blood pressure usually does not cause symptoms itself. It is, however, a major risk factor for stroke, coronary artery disease, heart failure, atrial fibrillation, peripheral arterial disease, vision loss, chronic kidney disease, and dementia. Hypertension is a major cause of premature death worldwide. High blood pressure is classified as primary (essential) hypertension or secondary hypertension. About 90\u201395% of cases are primary, defined as high blood pressure due to non-specific lifestyle and genetic factors."}}, {"canonical_name": "epidemics", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 4, "total_mentions": 4, "members": [{"entity_id": "epidemics", "book_id": "origin_of_species_darwin_1859", "name": "epidemics", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["epidemics"], "contexts": ["widespread occurrence of an infectious disease"]}, {"entity_id": "epidemics", "book_id": "kosmos_humboldt_1845", "name": "epidemics", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["epidemics"], "contexts": ["widespread outbreaks of disease"]}, {"entity_id": "epidemia", "book_id": "coloquios_da_orta_1563", "name": "epidemia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["epidemia"], "contexts": ["widespread occurrence of disease"]}, {"entity_id": "epidemia", "book_id": "polyanthea_medicinal", "name": "epidemia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["epidemia"], "contexts": ["medical text reference"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "epidemics", "target_book": "kosmos_humboldt_1845", "target_name": "epidemics", "similarity": 0.874}, {"source_book": "origin_of_species_darwin_1859", "source_name": "epidemics", "target_book": "coloquios_da_orta_1563", "target_name": "epidemia", "similarity": 0.959}, {"source_book": "origin_of_species_darwin_1859", "source_name": "epidemics", "target_book": "polyanthea_medicinal", "target_name": "epidemia", "similarity": 0.959}, {"source_book": "coloquios_da_orta_1563", "source_name": "epidemia", "target_book": "polyanthea_medicinal", "target_name": "epidemia", "similarity": 1.0}], "id": 798, "stable_key": "clu_32ac3b9125283b41", "ground_truth": {"wikipedia_extract": "An epidemic (from Greek \u1f10\u03c0\u03af epi \"upon or above\" and \u03b4\u1fc6\u03bc\u03bf\u03c2 demos \"people\") is the rapid spread of disease to a large number of hosts in a given population within a short period of time. For example, in meningococcal infections, an attack rate in excess of 15 cases per 100,000 people for two consecutive weeks is considered an epidemic. Epidemics of infectious disease are generally caused by several factors including a change in the ecology of the host population (e.g., increased stress or increase in the density of a vector species), a genetic change in the pathogen reservoir or the introduction of an emerging pathogen to a host population (by movement of pathogen or host). Generally, an epidemic occurs when host immunity to either an established pathogen or newly emerging novel pathogen is suddenly reduced below that found in the endemic equilibrium and the transmission threshold is exceeded. An epidemic may be restricted to one location; however, if it spreads to other countries or continents and affects a substantial number of people, it may be termed as a pandemic. The declaration of an epidemic usually requires a good understanding of a baseline rate of incidence; epidemics for certain diseases, such as influenza, are defined as reaching some defined increase in incidence above this baseline."}}, {"canonical_name": "internal organ", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 4, "members": [{"entity_id": "internal_organ", "book_id": "origin_of_species_darwin_1859", "name": "internal organ", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["internal organ"], "contexts": ["body part for nature's selection"]}, {"entity_id": "internal_organs", "book_id": "principles_of_psychology_james_1890", "name": "internal organs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["internal organs"], "contexts": ["body parts producing feelings"]}, {"entity_id": "internal_organism", "book_id": "kosmos_humboldt_1845", "name": "internal organism", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["internal organism"], "contexts": ["internal structure of an organism"]}, {"entity_id": "internal_organs", "book_id": "first_principles_spencer_1862", "name": "internal organs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["internal organs"], "contexts": ["organs within the body"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "internal organ", "target_book": "principles_of_psychology_james_1890", "target_name": "internal organs", "similarity": 0.983}, {"source_book": "origin_of_species_darwin_1859", "source_name": "internal organ", "target_book": "first_principles_spencer_1862", "target_name": "internal organs", "similarity": 0.983}, {"source_book": "principles_of_psychology_james_1890", "source_name": "internal organs", "target_book": "kosmos_humboldt_1845", "target_name": "internal organism", "similarity": 0.955}, {"source_book": "principles_of_psychology_james_1890", "source_name": "internal organs", "target_book": "first_principles_spencer_1862", "target_name": "internal organs", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "internal organism", "target_book": "first_principles_spencer_1862", "target_name": "internal organs", "similarity": 0.955}], "id": 799, "stable_key": "clu_c8689125fab00a91", "ground_truth": {"modern_name": "internal organs", "confidence": "high", "type": "concept", "wikidata_id": "Q17098763", "wikidata_description": "Wikimedia list article", "wikipedia_url": "https://en.wikipedia.org/wiki/List%20of%20organs%20of%20the%20human%20body", "wikipedia_extract": "This article contains a list of organs in the human body. It is widely believed that there are 78 organs (the number goes up if each bone and muscle is also included); however, there is no universal standard definition of what constitutes an organ, and some tissue groups' status as one is debated. Since there is no single standard definition of what constitutes an organ, the number of organs vary depending on how one defines an organ. For example, this list contains more than 78 organs (about ~91). The list below is not comprehensive, as it is still not clear which definition of an organ is used for all the organs in the list."}}, {"canonical_name": "electrum", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 4, "total_mentions": 4, "members": [{"entity_id": "electrum", "book_id": "relation_historique_humboldt_vol3_1825", "name": "electrum", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["electrum"], "contexts": ["ancient alloy of gold and silver"]}, {"entity_id": "electrum", "book_id": "kosmos_humboldt_1845", "name": "electrum", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["electrum"], "contexts": ["amber, attracts light objects when rubbed"]}, {"entity_id": "electrum", "book_id": "historia_medicinal_monardes_1574", "name": "Electrum", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Electrum"], "contexts": ["alloy of gold and silver"]}, {"entity_id": "elettro", "book_id": "ricettario_fiorentino_1597", "name": "elettro", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["elettro"], "contexts": ["Greek name for amber"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "electrum", "target_book": "kosmos_humboldt_1845", "target_name": "electrum", "similarity": 0.857}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "electrum", "target_book": "historia_medicinal_monardes_1574", "target_name": "Electrum", "similarity": 0.831}, {"source_book": "kosmos_humboldt_1845", "source_name": "electrum", "target_book": "historia_medicinal_monardes_1574", "target_name": "Electrum", "similarity": 0.958}, {"source_book": "kosmos_humboldt_1845", "source_name": "electrum", "target_book": "ricettario_fiorentino_1597", "target_name": "elettro", "similarity": 0.943}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Electrum", "target_book": "ricettario_fiorentino_1597", "target_name": "elettro", "similarity": 0.907}], "id": 800, "stable_key": "clu_7072b466013ae852", "ground_truth": {"modern_name": "Electrum", "confidence": "high", "type": "mineral", "note": "Early modern texts refer to electrum both as an ancient alloy of gold and silver, and as amber, which exhibits electrostatic properties.", "wikidata_id": "Q203874", "wikidata_description": "shiny alloy of copper, nickel, and zinc", "wikipedia_url": "https://en.wikipedia.org/wiki/Nickel%20silver", "wikipedia_extract": "Nickel silver, maillechort, German silver, argentan, new silver, nickel brass, albata, or alpacca is a cupronickel (copper with nickel) alloy with the addition of zinc. The usual formulation is 60% copper, 20% nickel and 20% zinc. Nickel silver does not contain silver, but resembles it, which can make it attractive as a cheaper and more durable substitute. It is also well suited for plating with silver. A naturally occurring ore composition in China was smelted into the alloy known as paktong or b\u00e1it\u00f3ng (\u767d\u9285) ('white copper' or cupronickel). The name German Silver refers to the artificial recreation of the natural ore composition by German metallurgists."}}, {"canonical_name": "rivi\u00e8re", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 4, "members": [{"entity_id": "rivi\u00e8re", "book_id": "relation_historique_humboldt_vol3_1825", "name": "rivi\u00e8re", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["rivi\u00e8re"], "contexts": ["river"]}, {"entity_id": "river", "book_id": "kosmos_humboldt_1845", "name": "river", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["river"], "contexts": ["waterway with mud-banks"]}, {"entity_id": "river", "book_id": "connexion_physical_sciences_somerville_1858", "name": "river", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["river"], "contexts": ["natural flowing watercourse"]}, {"entity_id": "river", "book_id": "first_principles_spencer_1862", "name": "river", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["river"], "contexts": ["larger stream of water"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "rivi\u00e8re", "target_book": "kosmos_humboldt_1845", "target_name": "river", "similarity": 0.956}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "rivi\u00e8re", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "river", "similarity": 0.956}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "rivi\u00e8re", "target_book": "first_principles_spencer_1862", "target_name": "river", "similarity": 0.956}, {"source_book": "kosmos_humboldt_1845", "source_name": "river", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "river", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "river", "target_book": "first_principles_spencer_1862", "target_name": "river", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "river", "target_book": "first_principles_spencer_1862", "target_name": "river", "similarity": 1.0}], "id": 801, "stable_key": "clu_abebe06cf2e7ff3c-2", "ground_truth": {"modern_name": "River", "confidence": "high", "type": "place", "country": "Multiple", "note": "The term 'rivi\u00e8re' is French for 'river', and the contexts clearly refer to natural waterways. The specific location is not identifiable from the provided information.", "wikidata_id": "Q15799", "wikidata_description": "Argentine professional sports club based in Buenos Aires", "wikipedia_url": "https://en.wikipedia.org/wiki/Club%20Atl%C3%A9tico%20River%20Plate", "wikipedia_extract": "Club Atl\u00e9tico River Plate (CARP) (Spanish pronunciation: [\u02c8klu\u03b2 a\u02c8tletiko \u02c8ri\u03b2er \u02c8pleit]) is an Argentine professional sports club based in the Belgrano neighborhood of Buenos Aires. Founded in 1901, the club is named after the English-language name for the city's estuary, R\u00edo de la Plata. River's home stadium, the Monumental, is the largest in South America. River had the highest average home attendance of any association football club in the world in 2023 with 84,567. With more than 350,000 members at the end of 2023, River is one of the largest sports clubs by membership. It repeated this achievement in 2024 and 2025."}}, {"canonical_name": "Planer", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 4, "members": [{"entity_id": "planer", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Planer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Planer"], "contexts": ["scholar who recognized barometric laws"]}, {"entity_id": "plana", "book_id": "kosmos_humboldt_1845", "name": "Plana", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Plana"], "contexts": ["geodesic operator in Lombardy"]}, {"entity_id": "plancio", "book_id": "polyanthea_medicinal", "name": "Plancio", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Plancio"], "contexts": ["says it is not surprising"]}, {"entity_id": "plana", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Plana", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Plana"], "contexts": ["developed lunar orbit formul\u00e6"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Planer", "target_book": "kosmos_humboldt_1845", "target_name": "Plana", "similarity": 0.912}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Planer", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Plana", "similarity": 0.912}, {"source_book": "kosmos_humboldt_1845", "source_name": "Plana", "target_book": "polyanthea_medicinal", "target_name": "Plancio", "similarity": 0.886}, {"source_book": "kosmos_humboldt_1845", "source_name": "Plana", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Plana", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Plancio", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Plana", "similarity": 0.886}], "id": 802, "stable_key": "clu_459a74f7e47055a6", "ground_truth": {"modern_name": "Johann Hieronymus Schrader", "confidence": "medium", "type": "person", "birth_year": 1722, "death_year": 1782, "description": "German physician and botanist, associated with Johann Christian Daniel von Schreber.", "note": "The name 'Planer' is likely a misspelling or misreading of 'Schreber' or 'Schrader' based on the context of natural history and scientific scholars."}}, {"canonical_name": "succinum", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 4, "members": [{"entity_id": "succinum", "book_id": "kosmos_humboldt_1845", "name": "succinum", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["succinum"], "contexts": ["Latin name for amber"]}, {"entity_id": "succin\u00f3", "book_id": "historia_medicinal_monardes_1574", "name": "Succin\u00f3", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Succin\u00f3"], "contexts": ["called Ambar"]}, {"entity_id": "succino", "book_id": "coloquios_da_orta_1563", "name": "succino", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["succino"], "contexts": ["synonym for carabe"]}, {"entity_id": "succino", "book_id": "ricettario_fiorentino_1597", "name": "succino", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["succino"], "contexts": ["Latin name for amber"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "succinum", "target_book": "historia_medicinal_monardes_1574", "target_name": "Succin\u00f3", "similarity": 0.949}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Succin\u00f3", "target_book": "coloquios_da_orta_1563", "target_name": "succino", "similarity": 0.752}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Succin\u00f3", "target_book": "ricettario_fiorentino_1597", "target_name": "succino", "similarity": 0.701}, {"source_book": "coloquios_da_orta_1563", "source_name": "succino", "target_book": "ricettario_fiorentino_1597", "target_name": "succino", "similarity": 0.81}], "id": 803, "stable_key": "clu_cbcca2bc5a68e3b4", "ground_truth": {"modern_name": "Amber", "confidence": "high", "type": "mineral", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Antilles", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 356, "members": [{"entity_id": "antilles", "book_id": "epoques_nature_buffon_1778", "name": "Antilles", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Antilles"], "contexts": ["archipelago in the Caribbean", "islands separated from America"]}, {"entity_id": "antilles", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Antilles", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 352, "variants": ["Antilles", "ANTILLES", "Antill'is", "Antilles Angiuises", "Antilles Anglaises", "Antilles Angloises", "Antilles angl.", "Antilles angloiseSj", "Antilles angloises", "Antilles anoloises", "Antilles bollandoises", "Antilles espagnoles", "Antilles espognoles", "Antilles fian\u00e7oises", "Antilles fran\u00e7oises", "Antilles holl., dan. et su\u00e9d,", "Antilles hollandoise", "Antilles hollandoises", "Antilles non espagnoles", "Antilles uollandoises", "Grandes Antilles", "Grandes et Petites Antilles", "Grandes et les Pelites-Antilles", "Grandes-Antilles", "Islas Antillas", "Mer des Antilles", "M\u00e9diterran\u00e9e des Antilles", "Petites Antilles", "Petites-Antilles", "Petites-Antilles Angloises", "archipel des grandes et des petites Antilles", "iles Antilles", "les autres Antilles", "mer des Antilles", "\u00eeles Antilles"], "contexts": ["islands in the Caribbean Sea", "geographical location, islands"]}, {"entity_id": "antilles_islands", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Antilles Islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Antilles Islands"], "contexts": ["hurricanes beginning at", "location of hurricanes"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Antilles", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Antilles", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Antilles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Antilles Islands", "similarity": 0.959}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Antilles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Antilles Islands", "similarity": 0.959}], "id": 804, "stable_key": "clu_64e293d18f9383a3", "ground_truth": {"modern_name": "Antilles", "confidence": "high", "type": "place", "description": "Archipelago in the Caribbean Sea, comprising numerous islands.", "wikipedia_extract": "The Antilles is an archipelago within the West Indies in the Caribbean region of the Americas. It is bordered by the Caribbean Sea to the south and west, the Gulf of Mexico to the northwest, and the North Atlantic Ocean to the north and east. The Antillean islands are divided into two smaller archipelagos: the Greater Antilles and the Lesser Antilles. The Greater Antilles include the Cayman Islands and larger islands of Cuba, Hispaniola (subdivided into the nations of the Dominican Republic and Haiti), Navassa Island, Jamaica, and Puerto Rico. The Lesser Antilles contains the northerly Leeward Islands and the southeasterly Windward Islands, as well as the Leeward Antilles immediately north of Venezuela. The Lucayan Archipelago, consisting of The Bahamas and the Turks and Caicos Islands, though a part of the West Indies, is generally not included among the Antillean islands."}}, {"canonical_name": "Havane", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 245, "members": [{"entity_id": "havane", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Havane", "category": "PLACE", "subcategory": "CITY", "count": 240, "variants": ["Havane", "HAVANE", "Habana", "Havana", "La Havane", "U Havane", "la Havane"], "contexts": ["capital of Cuba", "destination city for ships"]}, {"entity_id": "havana", "book_id": "kosmos_humboldt_1845", "name": "Havana", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Havana"], "contexts": ["location for magnetic observations", "capital city of Cuba"]}, {"entity_id": "havana", "book_id": "historia_medicinal_monardes_1574", "name": "Havana", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Havana"], "contexts": ["port city where a ship captain arrived"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Havane", "target_book": "kosmos_humboldt_1845", "target_name": "Havana", "similarity": 0.979}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Havane", "target_book": "historia_medicinal_monardes_1574", "target_name": "Havana", "similarity": 0.979}, {"source_book": "kosmos_humboldt_1845", "source_name": "Havana", "target_book": "historia_medicinal_monardes_1574", "target_name": "Havana", "similarity": 1.0}], "id": 805, "stable_key": "clu_3bf545675560647d", "ground_truth": {"modern_name": "Havana", "confidence": "high", "type": "place", "description": "Capital city and major port of Cuba, a historical center.", "wikipedia_extract": "Havana (, US also ; Spanish: La Habana [la\u203fa\u02c8\u03b2ana] ) is the capital and largest city of Cuba. The heart of La Habana Province, Havana is the country's main port and commercial center. It is the most populous city, the largest by area, and the second-largest metropolitan area in the Caribbean region. The population in 2021 was 2,142,939 inhabitants, and its area is 728.26 km2 (281.18 sq mi) for the capital city and 8,475.57 km2 for the metropolitan zone. Its official population was 1,749,964 inhabitants in 2024. Founded in 1519 on its current location on Havana Bay under initiative of the Spanish Empire, it had already taken an edge over Santiago by the mid 16th century due to the geo-strategic advantages of its harbor, becoming the capital of the island in 1552."}}, {"canonical_name": "purga", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 221, "members": [{"entity_id": "purga", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "purga", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["purga"], "contexts": ["medical purging practice"]}, {"entity_id": "purga", "book_id": "historia_medicinal_monardes_1574", "name": "purga", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["purga"], "contexts": ["act of purging or cleansing", "act of purging with medicine"]}, {"entity_id": "purga", "book_id": "polyanthea_medicinal", "name": "purga", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 215, "variants": ["purga", "Purga", "Purgas", "purga branda", "purgabis", "purgado", "purgam\u011btorum", "purgan", "purganJo", "purgandi", "purgando", "purgans", "purgante", "purgantibus", "purgar", "purgar commedicamento", "purgar o corpo", "purgas", "purgas alviducas", "purgas vomitivas", "purgat.", "purgatio", "purgation", "purgatione", "purgationem", "purgationem vi\u017fcerum", "purgationes", "purgationibus", "purgationispurgatis", "purgations", "purgatios", "purgativa", "purgativas", "purgatives", "purga\u00e7ao", "purga\u00e7a\u00f3", "purga\u00e7a\u00f5", "purga\u00e7oens men\u017faes", "purga\u00e7\u00e3o", "purga\u00e7\u00f5es", "purga\u00e7\u00f5es men\u017faes", "purga\u00f3", "purged", "purgetur", "purging", "purgou", "purgue", "purguem", "repurgar"], "contexts": ["medicines that induce purging", "medical practice of cleansing the body"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "purga", "target_book": "historia_medicinal_monardes_1574", "target_name": "purga", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "purga", "target_book": "polyanthea_medicinal", "target_name": "purga", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "purga", "target_book": "polyanthea_medicinal", "target_name": "purga", "similarity": 1.0}], "id": 806, "stable_key": "clu_9b7d1c8135f3f6b5", "ground_truth": {"modern_name": "Purging", "confidence": "high", "type": "concept", "description": "Medical practice of cleansing the body, often with medicines.", "note": "Refers to inducing vomiting or bowel movements for medical purposes.", "wikipedia_extract": "In medicine, a cathartic is a substance that accelerates defecation. This is similar to a laxative, which is a substance that eases defecation, usually by softening feces. It is possible for a substance to be both a laxative and a cathartic. However, agents such as psyllium seed husks increase the bulk of the feces. Cathartics such as sorbitol, magnesium citrate, magnesium sulfate, or sodium sulfate were previously used as a form of gastrointestinal decontamination following poisoning via ingestion. They are no longer routinely recommended for poisonings."}}, {"canonical_name": "natural selection", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 3, "total_mentions": 197, "members": [{"entity_id": "natural_selection", "book_id": "origin_of_species_darwin_1859", "name": "natural selection", "category": "CONCEPT", "subcategory": "THEORY", "count": 188, "variants": ["NATURAL SELECTION", "natural selection", "Natural selection", "Natural Selection"], "contexts": ["mechanism for evolution", "mechanism of evolution by differential survival"]}, {"entity_id": "natural_selection", "book_id": "principles_of_psychology_james_1890", "name": "natural selection", "category": "CONCEPT", "subcategory": "THEORY", "count": 3, "variants": ["natural selection"], "contexts": ["evolutionary mechanism", "mechanism of evolution"]}, {"entity_id": "natural_selection", "book_id": "first_principles_spencer_1862", "name": "natural selection", "category": "CONCEPT", "subcategory": "THEORY", "count": 6, "variants": ["natural selection"], "contexts": ["mechanism of evolution", "evolution of Life along lines of least resistance"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "natural selection", "target_book": "principles_of_psychology_james_1890", "target_name": "natural selection", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "natural selection", "target_book": "first_principles_spencer_1862", "target_name": "natural selection", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "natural selection", "target_book": "first_principles_spencer_1862", "target_name": "natural selection", "similarity": 1.0}], "id": 807, "stable_key": "clu_654eecebb336ab75", "ground_truth": {"modern_name": "natural selection", "confidence": "high", "type": "concept", "description": "Mechanism of evolution by differential survival and reproduction.", "wikipedia_extract": "Natural selection is the differential survival and reproduction of individuals due to differences in the relative fitness endowed on them by their own particular complement of observable characteristics. It is a key law or mechanism of evolution which changes the heritable traits characteristic of a population or species over generations. Charles Darwin popularised the term \"natural selection\", contrasting it with artificial selection, which is intentional, whereas natural selection is not. For Darwin natural selection was a law or principle which resulted from three different kinds of process: inheritance, including the transmission of heritable material from parent to offspring and its development (ontogeny) in the offspring; variation, which partly resulted from an organism's own agency (see phenotype; Baldwin effect); and the struggle for existence, which included both competition between organisms and cooperation or 'mutual aid' (particularly in 'social' plants and social animals). Variation of traits, both genotypic and phenotypic, exists within all populations of organisms. However, some traits are more likely to facilitate survival and reproductive success."}}, {"canonical_name": "figado", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 189, "members": [{"entity_id": "fegato", "book_id": "ricettario_fiorentino_1597", "name": "fegato", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["fegato"], "contexts": ["liver, a proper part of animals", "liver color of good Sinopia"]}, {"entity_id": "figado", "book_id": "polyanthea_medicinal", "name": "figado", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 181, "variants": ["figado", "Figado", "figado affado", "figado aflado", "figado e\u017fquentado", "figado hep", "figadodemodo", "f\u00edgado"], "contexts": ["liver", "organ near the stomach"]}, {"entity_id": "f\u00edgado", "book_id": "coloquios_da_orta_1563", "name": "f\u00edgado", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["f\u00edgado", "figado"], "contexts": ["organ of the body", "organ that can be obstructed"]}, {"entity_id": "regiao_do_figado", "book_id": "polyanthea_medicinal", "name": "regiao do figado", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["regiao do figado"], "contexts": ["region of the liver"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "fegato", "target_book": "polyanthea_medicinal", "target_name": "figado", "similarity": 0.907}, {"source_book": "coloquios_da_orta_1563", "source_name": "f\u00edgado", "target_book": "polyanthea_medicinal", "target_name": "regiao do figado", "similarity": 0.932}], "id": 808, "stable_key": "clu_643f052e7e4c5354", "ground_truth": {"modern_name": "liver", "confidence": "high", "type": "substance", "description": "A large organ in the abdomen responsible for many metabolic functions.", "wikipedia_extract": "The liver is a major metabolic organ exclusively found in vertebrates, which performs many essential biological functions such as detoxification of the organism, and the synthesis of various proteins and various other biochemicals necessary for digestion and growth. In humans, it is located in the right upper quadrant of the abdomen, below the diaphragm and mostly shielded by the lower right rib cage. Its other metabolic roles include carbohydrate metabolism, the production of a number of hormones, conversion and storage of nutrients such as glucose and glycogen, and the decomposition of red blood cells. Anatomical and medical terminology often use the prefix hepat- from \u1f21\u03c0\u03b1\u03c4\u03bf-, from the Greek word for liver, such as hepatology, and hepatitis. The liver is also an accessory digestive organ that produces bile, an alkaline fluid containing cholesterol and bile acids,  which emulsifies and aids the breakdown of dietary fat. The gallbladder, a small hollow pouch that sits just under the right lobe of liver, stores and concentrates the bile produced by the liver, which is later excreted to the duodenum to help with digestion."}}, {"canonical_name": "Avicena", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 187, "members": [{"entity_id": "avicena", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Avicena", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Avicena"], "contexts": ["ancient medical authority"]}, {"entity_id": "avicena", "book_id": "historia_medicinal_monardes_1574", "name": "Avicena", "category": "PERSON", "subcategory": "AUTHORITY", "count": 10, "variants": ["Avicena"], "contexts": ["ancient author on poisons", "authority on metal generation"]}, {"entity_id": "avicena", "book_id": "coloquios_da_orta_1563", "name": "Avicena", "category": "PERSON", "subcategory": "AUTHORITY", "count": 176, "variants": ["Avicena", "Avi-cena", "Avi-cenna", "AviCENA", "Avicen", "Avicenna", "Avi\u00ad\u00adcena", "Avi\u00e7ena", "Av\u00edcena"], "contexts": ["Arabian physician, known as Abolahi", "ancient medical authority"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Avicena", "target_book": "historia_medicinal_monardes_1574", "target_name": "Avicena", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Avicena", "target_book": "coloquios_da_orta_1563", "target_name": "Avicena", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Avicena", "target_book": "coloquios_da_orta_1563", "target_name": "Avicena", "similarity": 1.0}], "id": 809, "stable_key": "clu_d77196501d6c33a4-2", "ground_truth": {"modern_name": "Avicenna", "confidence": "high", "type": "person", "description": "Influential Persian polymath and physician of the Islamic Golden Age.", "note": "Also known by variations like Avicena and Auicena.", "wikipedia_extract": "Ibn Sina (c.\u2009980 \u2013 22 June 1037), commonly known in the West as Avicenna ( A(H)V-ih-SEN-\u0259), was a preeminent philosopher and physician of the Muslim world. He was a seminal figure of the Islamic Golden Age, serving in the courts of various Iranian rulers, and was influential to medieval European medical and Scholastic thought. Often described as the father of early modern medicine, Avicenna's most famous works are The Book of Healing, a philosophical and scientific encyclopedia, and The Canon of Medicine, a medical encyclopedia that became a standard medical text at many medieval European universities and remained in use as late as 1650. Besides philosophy and medicine, Avicenna's corpus includes writings on astronomy, alchemy, geography and geology, psychology, Islamic theology, logic, mathematics, physics, and works of poetry. His philosophy was of the Peripatetic school derived from Aristotelianism, of which he is considered among the greatest proponents within the Muslim world. Avicenna wrote most of his philosophical and scientific works in Arabic but also wrote several key works in Persian; his poetry was written in both languages."}}, {"canonical_name": "pedra", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 184, "members": [{"entity_id": "stone", "book_id": "english_physician_1652", "name": "Stone", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 77, "variants": ["Stone", "Stone in the Bladder", "Stone in the Kidneys", "Stone in the Reins", "Stone in the Reins or Kidneys", "Stones in the Kidneys", "stone"], "contexts": ["material in the body", "broken and expelled by ash-tree leaves"]}, {"entity_id": "pedra_da_bixigua", "book_id": "coloquios_da_orta_1563", "name": "pedra da bixigua", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["pedra da bixigua", "pedra da bexiga"], "contexts": ["gallstone or kidney stone", "bladder stones"]}, {"entity_id": "pedra", "book_id": "polyanthea_medicinal", "name": "pedra", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 105, "variants": ["pedra", "Pedra", "PedraNephritica", "achaquesde pedra", "pedra dabexiga", "pedra no bofe", "pedrada bexiga", "pedradabexiga", "pedradosrins", "pedras dos rins", "pedras na bexiga"], "contexts": ["calculus or stone in the body", "stone found in a man's head"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Stone", "target_book": "polyanthea_medicinal", "target_name": "pedra", "similarity": 0.92}, {"source_book": "coloquios_da_orta_1563", "source_name": "pedra da bixigua", "target_book": "polyanthea_medicinal", "target_name": "pedra", "similarity": 0.893}], "id": 810, "stable_key": "clu_27e9d1c219d3abf9", "ground_truth": {"modern_name": "calculus", "confidence": "high", "type": "disease", "description": "A hard deposit, such as a kidney stone or gallstone.", "wikipedia_extract": "Calculus is the mathematical study of continuous change, in the same way that geometry is the study of shape and algebra is the study of generalizations of arithmetic operations. Originally called infinitesimal calculus or the calculus of infinitesimals, it has two major branches, differential calculus and integral calculus. Differential calculus analyses instantaneous rates of change and the slopes of curves; integral  calculus analyses accumulation of quantities and areas under or between curves. These two branches are related to each other by the fundamental theorem of calculus. Calculus uses convergence of infinite sequences and infinite series to a well-defined mathematical limit. Calculus is the \"mathematical backbone\" for solving problems in which variable quantities change with time or another reference value."}}, {"canonical_name": "camaras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 168, "members": [{"entity_id": "camaras", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "camaras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 19, "variants": ["camaras"], "contexts": ["dysentery", "likely referring to internal ailments or tumors"]}, {"entity_id": "camaras_de_los_ni\u00f1os", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "camaras de los ni\u00f1os", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["camaras de los ni\u00f1os"], "contexts": ["condition cured by tlaquauhtilizpatli powder"]}, {"entity_id": "c\u00e1maras", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "c\u00e1maras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["c\u00e1maras"], "contexts": ["ailments stopped by flower use"]}, {"entity_id": "camaras", "book_id": "historia_medicinal_monardes_1574", "name": "camaras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 11, "variants": ["camaras", "camara"], "contexts": ["medical condition involving discharge", "illness with purging"]}, {"entity_id": "camaras", "book_id": "polyanthea_medicinal", "name": "camaras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 136, "variants": ["camaras", "Camaras", "Camaras Dysentericas", "Camaras antigas", "Camarasnegras", "camaras Celiacas", "camaras Chylolas", "camaras Lientericas", "camaras antigas", "camaras colericas", "camaras de fangue", "camaras de langue", "camaras de sangue", "camaras de \u017fangue", "camaras entericas", "camaras epaticas", "camaras fanguinolentas", "camaras hepaticas", "camaras mortaes", "camarasde", "camarasde sangue", "camarasde \u017fangue"], "contexts": ["condition treated by remedy", "medical condition"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "camaras", "target_book": "historia_medicinal_monardes_1574", "target_name": "camaras", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "camaras", "target_book": "polyanthea_medicinal", "target_name": "camaras", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "camaras de los ni\u00f1os", "target_book": "historia_medicinal_monardes_1574", "target_name": "camaras", "similarity": 0.885}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "camaras de los ni\u00f1os", "target_book": "polyanthea_medicinal", "target_name": "camaras", "similarity": 0.885}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "c\u00e1maras", "target_book": "historia_medicinal_monardes_1574", "target_name": "camaras", "similarity": 0.906}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "c\u00e1maras", "target_book": "polyanthea_medicinal", "target_name": "camaras", "similarity": 0.906}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "camaras", "target_book": "polyanthea_medicinal", "target_name": "camaras", "similarity": 1.0}], "id": 811, "stable_key": "clu_6bc42b65013c1edd", "ground_truth": {"modern_name": "Cholericas", "confidence": "low", "type": "disease", "description": "A condition associated with humors, particularly bile.", "note": "The term 'camaras' is likely a misspelling or archaic form related to 'cholericas' (choleric) or conditions affecting the stomach/bowels.", "wikipedia_extract": "Camaraou noir is a red French wine grape variety that was historically grown in South West France but is now more widely planted in the Spanish wine region of Galicia where it is known as Espadeiro. However, despite its Spanish synonym Camaraou noir has no relationship to the Portuguese wine grape Espadeiro that is used to make red Vinho Verde. The grape may have some relation to the Juran\u00e7on and B\u00e9arn wine grape Camaralet de Lasseube which is also known as Camaraou blanc but DNA analysis has shown that the two varieties are distinct and not color mutations of one or the other. Ampelographers believe that the name Camaraou derives from the B\u00e9arnese word camarau which may have, in turn, be derived itself from the Gascon word cama that means \"leg, trunk\" and could be a reference to viticultural practice of growing grapevines up trees as trellising. Another possibility is that the name has some connection to the commune of Camal\u00e8s located in the Hautes-Pyr\u00e9n\u00e9es department of southwestern France. A late 18th century document shows that a Camarau grape was growing in the Pyr\u00e9n\u00e9es-Atlantiques department, French Basque Country and in the Pa\u00eds Vasco region of northern Spain, however the description of this grapes seems to indicate that it was more likely the white Camaraou blanc (Camaralet de Lasseube) grape."}}, {"canonical_name": "Vomitorios", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 141, "members": [{"entity_id": "vomit", "book_id": "english_physician_1652", "name": "Vomit", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 4, "variants": ["Vomit", "Vomits"], "contexts": ["expulsion of stomach contents", "action to expel poison"]}, {"entity_id": "vomito", "book_id": "historia_medicinal_monardes_1574", "name": "vomito", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 6, "variants": ["vomito"], "contexts": ["vomiting symptom", "act of expelling stomach contents"]}, {"entity_id": "vomitorios", "book_id": "polyanthea_medicinal", "name": "Vomitorios", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 131, "variants": ["Vomitorios", "Vomitoria", "vomi", "vomitando", "vomition", "vomito", "vomitoria", "vomitorijs", "vomitorio", "vomitorio brando", "vomitorio efficaz", "vomitorios", "vomitorios do Quintilio", "vomitou", "vomitu"], "contexts": ["medicines for purging", "Objects used for inducing vomiting"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Vomit", "target_book": "historia_medicinal_monardes_1574", "target_name": "vomito", "similarity": 0.956}, {"source_book": "english_physician_1652", "source_name": "Vomit", "target_book": "polyanthea_medicinal", "target_name": "Vomitorios", "similarity": 0.931}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "vomito", "target_book": "polyanthea_medicinal", "target_name": "Vomitorios", "similarity": 0.911}], "id": 812, "stable_key": "clu_9214985a01db9b5f", "ground_truth": {"modern_name": "Emetics", "confidence": "high", "type": "concept", "description": "Substances or practices used to induce vomiting.", "note": "Refers to the concept of inducing vomiting, not the act itself.", "wikipedia_extract": "Vomiting (scientifically known as emesis, and otherwise known as puking, and throwing up) is the forceful expulsion of the contents of one's stomach through the mouth and sometimes the nose. The substance so produced (the erstwhile contents of the stomach, now expelled) is also known as vomit or vomitus. Vomiting can be the result of ailments like food poisoning, gastroenteritis, pregnancy, motion sickness, or hangover; or it can be an after effect of diseases such as brain tumors, elevated intracranial pressure, or overexposure to ionizing radiation. The feeling that one is about to vomit is called nausea; it often precedes, but does not always lead to vomiting. Impairment due to alcohol or anesthesia can cause inhalation of vomit. In severe cases, where dehydration develops, intravenous fluid may be required."}}, {"canonical_name": "Root", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 140, "members": [{"entity_id": "root", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Root", "category": "PLANT", "subcategory": "ROOT", "count": 1, "variants": ["Root"], "contexts": ["plant part"]}, {"entity_id": "root", "book_id": "english_physician_1652", "name": "Root", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 138, "variants": ["Root", "Roots"], "contexts": ["part of Angelica used medicinally", "part of the Arsmart plant"]}, {"entity_id": "root", "book_id": "polyanthea_medicinal", "name": "root", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["root"], "contexts": ["a part of a plant used medicinally"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Root", "target_book": "english_physician_1652", "target_name": "Root", "similarity": 0.881}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Root", "target_book": "polyanthea_medicinal", "target_name": "root", "similarity": 0.88}, {"source_book": "english_physician_1652", "source_name": "Root", "target_book": "polyanthea_medicinal", "target_name": "root", "similarity": 0.987}], "id": 813, "stable_key": "clu_903686b9671582c3", "ground_truth": {"modern_name": "Root", "confidence": "high", "type": "plant", "description": "The underground part of a plant, often used medicinally.", "wikipedia_extract": "In vascular plants, the roots are the organs of a plant that are modified to provide anchorage for the plant and take in water and nutrients into the plant body, which allows plants to grow taller and faster. They are most often below the surface of the soil, but roots can also be aerial or aerating, that is, growing up above the ground or especially above water. Roots perform several essential and specialised roles that support plant growth, development and survival. Their primary functions are anchorage, uptake (absorption) of water and dissolved minerals, and conduction of these resources to the shoot. Beyond these, roots carry out a range of important secondary and adaptive functions \u2014 storage of reserves, synthesis of growth regulators, gas exchange in waterlogged environments, facilitation of symbiotic nutrient acquisition, and vegetative propagation. Anchorage and mechanical support."}}, {"canonical_name": "Ar\u00e1bios", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 138, "members": [{"entity_id": "ar\u00e1bios", "book_id": "coloquios_da_orta_1563", "name": "Ar\u00e1bios", "category": "PERSON", "subcategory": "AUTHORITY", "count": 118, "variants": ["ar\u00e1bios", "Ar\u00e1bios"], "contexts": ["people who discern alo\u00e9s quality", "people from Arabia"]}, {"entity_id": "arabi", "book_id": "ricettario_fiorentino_1597", "name": "Arabi", "category": "PERSON", "subcategory": "AUTHORITY", "count": 17, "variants": ["Arabi"], "contexts": ["group who wrote about Cardamomo", "authorities on medicine"]}, {"entity_id": "arabes", "book_id": "polyanthea_medicinal", "name": "Arabes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Arabes", "Arabum"], "contexts": ["ancient medical authorities", "Arab physicians"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Ar\u00e1bios", "target_book": "ricettario_fiorentino_1597", "target_name": "Arabi", "similarity": 0.938}, {"source_book": "coloquios_da_orta_1563", "source_name": "Ar\u00e1bios", "target_book": "polyanthea_medicinal", "target_name": "Arabes", "similarity": 0.95}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Arabi", "target_book": "polyanthea_medicinal", "target_name": "Arabes", "similarity": 0.96}], "id": 814, "stable_key": "clu_b394afd40d211f62", "ground_truth": {"modern_name": "Arab physicians", "confidence": "high", "type": "person", "description": "Medical authorities and writers from the Arab world.", "note": "Refers to people from Arabia, specifically in the context of historical medical knowledge.", "wikipedia_extract": "In the history of medicine, \"Islamic medicine\", also known as \"Arabian medicine\" is the science of medicine developed in the Middle East, and usually written in Arabic, the lingua franca of Islamic civilization. Islamic medicine adopted, systematized and developed the medical knowledge of classical antiquity, including the major traditions of Hippocrates, Galen and Dioscorides. During the post-classical era, Middle Eastern medicine was the most advanced in the world, integrating concepts of Modern Greek, Roman, Mesopotamian and Persian medicine as well as the ancient Indian tradition of Ayurveda, while making numerous advances and innovations. Islamic medicine, along with knowledge of classical medicine, was later adopted in the medieval medicine of Western Europe, after European physicians became familiar with Islamic medical authors during the Renaissance of the 12th century. Medieval Islamic physicians largely retained their authority until the rise of medicine as a part of the natural sciences, beginning with the Age of Enlightenment, nearly six hundred years after their textbooks were opened by many people. Aspects of their writings remain of interest to physicians even today."}}, {"canonical_name": "caliente", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 134, "members": [{"entity_id": "caliente", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "caliente", "category": "CONCEPT", "subcategory": "QUALITY", "count": 62, "variants": ["caliente"], "contexts": ["quality of the plant's nature", "quality of temperature"]}, {"entity_id": "caliente", "book_id": "historia_medicinal_monardes_1574", "name": "caliente", "category": "CONCEPT", "subcategory": "QUALITY", "count": 56, "variants": ["caliente", "calience", "calienta", "caliente en tercero grado", "caliente en tercero prado", "caliente y leca", "caliente y \u017feco", "caliente: y \u017feca", "calientes"], "contexts": ["quality, hot", "quality of the Ben plant"]}, {"entity_id": "quente", "book_id": "coloquios_da_orta_1563", "name": "quente", "category": "CONCEPT", "subcategory": "QUALITY", "count": 16, "variants": ["quente", "quentes"], "contexts": ["quality of substances", "quality of a root"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "caliente", "target_book": "historia_medicinal_monardes_1574", "target_name": "caliente", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "caliente", "target_book": "coloquios_da_orta_1563", "target_name": "quente", "similarity": 0.953}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "caliente", "target_book": "coloquios_da_orta_1563", "target_name": "quente", "similarity": 0.953}], "id": 815, "stable_key": "clu_102e746c1393cc52", "ground_truth": {"modern_name": "hot (quality)", "confidence": "high", "type": "concept", "note": "Refers to the humoral quality of 'hot' in ancient and medieval medical traditions."}}, {"canonical_name": "humido", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 118, "members": [{"entity_id": "humidos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "humidos", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["humidos"], "contexts": ["a quality of regions where the plant grows"]}, {"entity_id": "humido", "book_id": "historia_medicinal_monardes_1574", "name": "humido", "category": "CONCEPT", "subcategory": "QUALITY", "count": 6, "variants": ["humido", "humedad", "humida", "h\u00famidad"], "contexts": ["moist quality", "quality, moist"]}, {"entity_id": "humido", "book_id": "polyanthea_medicinal", "name": "humido", "category": "CONCEPT", "subcategory": "QUALITY", "count": 111, "variants": ["humido", "dehumidade", "humidade", "humidadedo ar", "humidades", "humidado", "humidas", "humidi", "humididade", "humiditas", "humidonatural", "humidos", "humidum", "umido", "\u00famido"], "contexts": ["quality causing ailments", "moist"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "humidos", "target_book": "historia_medicinal_monardes_1574", "target_name": "humido", "similarity": 0.967}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "humidos", "target_book": "polyanthea_medicinal", "target_name": "humido", "similarity": 0.967}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "humido", "target_book": "polyanthea_medicinal", "target_name": "humido", "similarity": 1.0}], "id": 816, "stable_key": "clu_44347300323a2c9a-2", "ground_truth": {"modern_name": "Moisture", "confidence": "high", "type": "concept", "note": "Refers to the humoral quality of moistness in ancient and medieval medicine.", "wikidata_id": "Q6894868", "wikidata_description": "form of abiotic stress that occurs when the moisture of plant tissues is reduced to suboptimal levels", "wikipedia_url": "https://en.wikipedia.org/wiki/Moisture%20stress", "wikipedia_extract": "Moisture stress is a form of abiotic stress that occurs when the moisture of plant tissues is reduced to suboptimal levels. Water stress occurs in response to atmospheric and soil water availability when the transpiration rate exceeds the rate of water uptake by the roots and cells lose turgor pressure. Moisture stress is described by two main metrics, water potential and water content. Moisture stress has an effect on stomatal opening, mainly causing a closure in stomata as to reduce the amount of carbon dioxide assimilation. Closing of the stomata also slows the rate of transpiration, which limits water loss and helps to prevent the wilting effects of moisture stress. This closing can be triggered by the roots sensing dry soil and in response producing the hormone ABA which when transported up the xylem into the leaves will reduce stomatal conductance and wall extensibility of growing cells."}}, {"canonical_name": "frio", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 117, "members": [{"entity_id": "frios", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "frios", "category": "CONCEPT", "subcategory": "QUALITY", "count": 3, "variants": ["frios"], "contexts": ["chills", "cause of pain treated by Coltototl"]}, {"entity_id": "frio", "book_id": "coloquios_da_orta_1563", "name": "frio", "category": "CONCEPT", "subcategory": "QUALITY", "count": 12, "variants": ["frio"], "contexts": ["quality attributed to camphor", "quality of temperature"]}, {"entity_id": "frio", "book_id": "polyanthea_medicinal", "name": "frio", "category": "CONCEPT", "subcategory": "QUALITY", "count": 102, "variants": ["frio", "Frio", "ar frio", "frios actu", "frios excessivos"], "contexts": ["cold", "a quality associated with illness"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "frios", "target_book": "coloquios_da_orta_1563", "target_name": "frio", "similarity": 0.969}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "frios", "target_book": "polyanthea_medicinal", "target_name": "frio", "similarity": 0.969}, {"source_book": "coloquios_da_orta_1563", "source_name": "frio", "target_book": "polyanthea_medicinal", "target_name": "frio", "similarity": 1.0}], "id": 817, "stable_key": "clu_06ad6c064ed8b34c-3", "ground_truth": {"modern_name": "cold", "confidence": "high", "type": "concept", "wikidata_id": "Q199804", "wikidata_description": "lung disease involving long-term poor airflow", "wikipedia_url": "https://en.wikipedia.org/wiki/Chronic%20obstructive%20pulmonary%20disease", "note": "Refers to the physical sensation and thermodynamic state of low temperature, as well as its perceived qualities in historical medical contexts.", "wikipedia_extract": "Chronic obstructive pulmonary disease (COPD) is a type of progressive lung disease characterized by chronic respiratory symptoms and airflow limitation. GOLD defines COPD as a heterogeneous lung condition characterized by chronic respiratory symptoms (shortness of breath, cough, sputum production or exacerbations) due to abnormalities of the airways (bronchitis, bronchiolitis) or alveoli (emphysema) that cause persistent, often progressive, airflow obstruction. The main symptoms of COPD include shortness of breath and a cough, which may or may not produce mucus. COPD progressively worsens, with everyday activities such as walking or dressing becoming difficult. While COPD is incurable, it is preventable and treatable. The two most common types of COPD are emphysema and chronic bronchitis, and have been the two classic COPD phenotypes."}}, {"canonical_name": "sucre", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 109, "members": [{"entity_id": "sucre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "sucre", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 96, "variants": ["sucre", "SUCRE", "Sucre", "betterave \u00e0 sucre", "canne \u00e0 sucre", "canne \u00e0 sucre ordinaire", "cannes \u00e0 sucre", "cann\u00e8s \u00e0 sucre", "la canne \u00e0 sucre", "sucre de betterave", "sucre de canne"], "contexts": ["precious production", "cultivated plant for export"]}, {"entity_id": "azucar", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Azucar", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Azucar"], "contexts": ["sugar"]}, {"entity_id": "sugar", "book_id": "coloquios_da_orta_1563", "name": "sugar", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["sugar"], "contexts": ["entry in glossary"]}, {"entity_id": "a\u00e7ucar", "book_id": "polyanthea_medicinal", "name": "a\u00e7ucar", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 11, "variants": ["a\u00e7ucar", "allucar", "a\u017flucar", "a\u017f\u017fucar"], "contexts": ["sugar, used in remedies", "sweetener for infusions"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "sucre", "target_book": "coloquios_da_orta_1563", "target_name": "sugar", "similarity": 0.968}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "sucre", "target_book": "polyanthea_medicinal", "target_name": "a\u00e7ucar", "similarity": 0.948}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Azucar", "target_book": "coloquios_da_orta_1563", "target_name": "sugar", "similarity": 0.936}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Azucar", "target_book": "polyanthea_medicinal", "target_name": "a\u00e7ucar", "similarity": 0.959}, {"source_book": "coloquios_da_orta_1563", "source_name": "sugar", "target_book": "polyanthea_medicinal", "target_name": "a\u00e7ucar", "similarity": 0.942}], "id": 818, "stable_key": "clu_eccf62365b6a98fe", "ground_truth": {"modern_name": "Sugar", "confidence": "high", "type": "plant", "linnaean": "Saccharum officinarum", "family": "Poaceae", "description": "Sweet crystalline substance obtained from various plants, especially sugarcane.", "note": "Refers to the plant source and the substance derived from it.", "wikipedia_extract": "Saccharum officinarum is a large, strong-growing species of grass in the sugarcane genus. Its stout stalks are rich in sucrose, a disaccharide sugar which accumulates in the stalk internodes. It originated in New Guinea, and is now cultivated in tropical and subtropical countries worldwide for the production of sugar, ethanol and other products. It is one of the most productive and most intensively cultivated kinds of sugarcane. Saccharum officinarum, a perennial plant, grows in clumps consisting of a number of strong unbranched stems. A network of rhizomes forms under the soil which sends up secondary shoots near the parent plant."}}, {"canonical_name": "cabe\u00e7a", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 104, "members": [{"entity_id": "cabeza", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "cabeza", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 8, "variants": ["cabeza"], "contexts": ["part of the body where pain can occur", "part of the body"]}, {"entity_id": "cabe\u00e7a", "book_id": "coloquios_da_orta_1563", "name": "cabe\u00e7a", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["cabe\u00e7a"], "contexts": ["top grade of camphor", "part of the body affected by ailments"]}, {"entity_id": "cabe\u00e7a", "book_id": "polyanthea_medicinal", "name": "cabe\u00e7a", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 94, "variants": ["cabe\u00e7a", "cabeca", "cabecinha", "cabe\u00e7a inteyra", "cabe\u00e7as"], "contexts": ["body part", "part of the body affected by nervous disorders"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cabeza", "target_book": "coloquios_da_orta_1563", "target_name": "cabe\u00e7a", "similarity": 0.988}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cabeza", "target_book": "polyanthea_medicinal", "target_name": "cabe\u00e7a", "similarity": 0.988}, {"source_book": "coloquios_da_orta_1563", "source_name": "cabe\u00e7a", "target_book": "polyanthea_medicinal", "target_name": "cabe\u00e7a", "similarity": 1.0}], "id": 819, "stable_key": "clu_d39c353bdd295151-2", "ground_truth": {"modern_name": "Head", "confidence": "high", "type": "concept", "note": "Refers to the anatomical head, but also used metaphorically for leadership or highest point. In this context, medical and anatomical references suggest the former.", "wikidata_id": "Q23640", "wikidata_description": "anterior anatomical region in many animals, which tends to contain sensory and nervous organs and orifices for ingestion and breathing", "wikipedia_url": "https://en.wikipedia.org/wiki/Head", "wikipedia_extract": "A head is the part of an organism which usually includes the ears, brain, forehead, cheeks, chin, eyes, nose, and mouth, each of which aid in various sensory functions such as sight, hearing, smell, and taste. Some very simple animals may not have a head, but many bilaterally symmetric forms do, regardless of size. Heads develop in animals by an evolutionary trend known as cephalization. In bilaterally symmetrical animals, nervous tissue concentrate at the anterior region, forming structures responsible for information processing. Through biological evolution, sense organs and feeding structures also concentrate into the anterior region; these collectively form the head. The human head is an anatomical unit that consists of the skull, hyoid bone and cervical vertebrae."}}, {"canonical_name": "association", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 101, "members": [{"entity_id": "association", "book_id": "principles_of_psychology_james_1890", "name": "association", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 81, "variants": ["ASSOCIATION", "Association", "association"], "contexts": ["linking of thoughts or ideas", "linking of ideas or events"]}, {"entity_id": "associations", "book_id": "principles_of_psychology_james_1890", "name": "associations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 10, "variants": ["associations"], "contexts": ["connections between ideas or stimuli", "linking of ideas or sensations"]}, {"entity_id": "association", "book_id": "kosmos_humboldt_1845", "name": "association", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["association"], "contexts": ["linking of ideas or memories", "linking of ideas"]}, {"entity_id": "association", "book_id": "first_principles_spencer_1862", "name": "association", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["association"], "contexts": ["linking of ideas or thoughts", "linking of ideas or sensations"]}, {"entity_id": "associations", "book_id": "first_principles_spencer_1862", "name": "associations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["associations"], "contexts": ["pre-established links between ideas", "linking of ideas in the mind"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "association", "target_book": "kosmos_humboldt_1845", "target_name": "association", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "association", "target_book": "first_principles_spencer_1862", "target_name": "association", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "association", "target_book": "first_principles_spencer_1862", "target_name": "associations", "similarity": 0.918}, {"source_book": "principles_of_psychology_james_1890", "source_name": "associations", "target_book": "kosmos_humboldt_1845", "target_name": "association", "similarity": 0.918}, {"source_book": "principles_of_psychology_james_1890", "source_name": "associations", "target_book": "first_principles_spencer_1862", "target_name": "association", "similarity": 0.918}, {"source_book": "principles_of_psychology_james_1890", "source_name": "associations", "target_book": "first_principles_spencer_1862", "target_name": "associations", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "association", "target_book": "first_principles_spencer_1862", "target_name": "association", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "association", "target_book": "first_principles_spencer_1862", "target_name": "associations", "similarity": 0.918}], "id": 820, "stable_key": "clu_eedd4fd5e8e57088", "ground_truth": {"modern_name": "Doctrine of association", "confidence": "medium", "type": "concept", "note": "The cluster links 'doctrine of association' with 'doctrine of correlation'. While both are philosophical/scientific doctrines, 'associationism' is a specific school of thought related to mental connections, whereas 'correlation' is a statistical or scientific relationship. The commonality is the concept of relatedness or connection.", "wikidata_id": "Q18355989", "wikidata_description": "ideology proposed by C. Fourier, asserting the future inevitability of communal associations of people co-working and co-living", "wikipedia_extract": "The motte-and-bailey fallacy (named after the motte-and-bailey castle) is a form of argument and an informal fallacy where an arguer conflates two positions that share similarities: one modest and easy to defend (the \"motte\") and one much more controversial and harder to defend (the \"bailey\"). The arguer advances the controversial position, but when challenged, insists that only the more modest position is being advanced. Upon retreating to the motte, the arguer may claim that the bailey has not been refuted (because the critic refused to attack the motte) or that the critic is unreasonable (by equating an attack on the bailey with an attack on the motte). Philosopher Nicholas Shackel, who coined the term, prefers to speak of a motte-and-bailey doctrine instead of a fallacy. In 2005, Shackel described the reference to medieval castle defense like this: A Motte and Bailey castle is a medieval system of defence in which a stone tower on a mound (the Motte) is surrounded by an area of land (the Bailey) which in turn is encompassed by some sort of a barrier such as a ditch. Being dark and dank, the Motte is not a habitation of choice.", "wikipedia_url": "https://en.wikipedia.org/wiki/Fourierism"}}, {"canonical_name": "pimenta", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 100, "members": [{"entity_id": "pimiento", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "pimiento", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["pimiento"], "contexts": ["plant whose leaves are similar to a\u00f1ir"]}, {"entity_id": "pimenta", "book_id": "coloquios_da_orta_1563", "name": "pimenta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 73, "variants": ["pimenta", "PIMENTA BRANCA", "PIMENTA PRETA", "Pimenta", "pimenta branca", "pimenta negra", "pimenta preta", "pimenta verde"], "contexts": ["spice Ruano wants to know about", "spice used for comparison of heat"]}, {"entity_id": "pimenta", "book_id": "polyanthea_medicinal", "name": "Pimenta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 26, "variants": ["Pimenta", "pimenta", "pimenta branca", "pimenta negra", "pimentabranca"], "contexts": ["powder mixed with egg white", "ingredient in a wine remedy"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "pimiento", "target_book": "coloquios_da_orta_1563", "target_name": "pimenta", "similarity": 0.898}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "pimiento", "target_book": "polyanthea_medicinal", "target_name": "Pimenta", "similarity": 0.897}, {"source_book": "coloquios_da_orta_1563", "source_name": "pimenta", "target_book": "polyanthea_medicinal", "target_name": "Pimenta", "similarity": 0.994}], "id": 821, "stable_key": "clu_220162fb7b9b2be1", "ground_truth": {"modern_name": "pepper", "confidence": "high", "type": "plant", "linnaean": "Piper nigrum Linnaeus", "family": "Piperaceae", "note": "Likely refers to black pepper (Piper nigrum), but could also encompass other pungent spices depending on context. 'Pimenta redonda' might refer to a specific variety or another round spice.", "wikidata_id": "Q43084", "wikidata_description": "species of plant"}}, {"canonical_name": "Psychology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 92, "members": [{"entity_id": "psychology", "book_id": "origin_of_species_darwin_1859", "name": "Psychology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Psychology"], "contexts": ["study of the mind", "field of study concerning mind"]}, {"entity_id": "psychology", "book_id": "principles_of_psychology_james_1890", "name": "Psychology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 84, "variants": ["psychology", "PSYCHOLOGY", "Psychology"], "contexts": ["subject of the book", "science of finite individual minds"]}, {"entity_id": "psychology", "book_id": "first_principles_spencer_1862", "name": "Psychology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["psychology", "Psychology"], "contexts": ["science underlying morality", "study of the mind and behavior"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Psychology", "target_book": "principles_of_psychology_james_1890", "target_name": "Psychology", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Psychology", "target_book": "first_principles_spencer_1862", "target_name": "Psychology", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Psychology", "target_book": "first_principles_spencer_1862", "target_name": "Psychology", "similarity": 1.0}], "id": 822, "stable_key": "clu_4e14eedefc55e0c8", "ground_truth": {"modern_name": "Psychology", "confidence": "high", "type": "concept"}}, {"canonical_name": "Chymica", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 88, "members": [{"entity_id": "chimie", "book_id": "medecine_experimentale_bernard_1865", "name": "chimie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 23, "variants": ["chimie"], "contexts": ["chemistry", "established science"]}, {"entity_id": "chimie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Chimie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Chimie", "chimie", "chimique"], "contexts": ["scientific discipline", "science of chemistry"]}, {"entity_id": "chymica", "book_id": "polyanthea_medicinal", "name": "Chymica", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 61, "variants": ["Chymica", "CHYMICAS", "Chymiaper", "Chymicas"], "contexts": ["alchemy", "art of preparing medicines"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "chimie", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Chimie", "similarity": 0.99}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Chimie", "target_book": "polyanthea_medicinal", "target_name": "Chymica", "similarity": 0.966}], "id": 823, "stable_key": "clu_79be077d6be38fdc", "ground_truth": {"modern_name": "alchemy", "confidence": "high", "type": "concept", "description": "Ancient practice involving chemical transformation and medicine.", "note": "Also encompasses the chemical art and practice.", "wikipedia_extract": "Alchemy (from the Arabic word al-k\u012bm\u012b\u0101, \u0627\u0644\u0643\u06cc\u0645\u06cc\u0627\u0621) is an ancient branch of natural philosophy, a philosophical and protoscientific tradition that was historically practised in China, India, the Muslim world, and Europe. In its Western form, alchemy is first attested in a number of pseudepigraphical texts written in Greco-Roman Egypt during the first few centuries AD. Greek-speaking alchemists often referred to their craft as \"the Art\" (\u03c4\u03ad\u03c7\u03bd\u03b7) or \"Knowledge\" (\u1f10\u03c0\u03b9\u03c3\u03c4\u03ae\u03bc\u03b7), and it was often characterised as mystic (\u03bc\u03c5\u03c3\u03c4\u03b9\u03ba\u03ae), sacred (\u1f31\u025b\u03c1\u03ac), or divine (\u03b8\u025b\u00ed\u03b1). Alchemists attempted to purify, mature, and perfect certain materials. Common aims were chrysopoeia, the transmutation of \"base metals\" (e.g., lead) into \"noble metals\" (particularly gold); the creation of an elixir of immortality; and the creation of panaceas able to cure any disease. The perfection of the human body and soul was thought to result from the alchemical magnum opus (\"Great Work\")."}}, {"canonical_name": "Jupiter", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 88, "members": [{"entity_id": "jupiter", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Jupiter", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 8, "variants": ["Jupiter"], "contexts": ["planet whose satellite is observed", "celestial body, satellites observed"]}, {"entity_id": "jupiter", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Jupiter", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 79, "variants": ["Jupiter"], "contexts": ["planet in the solar system", "planet with satellites"]}, {"entity_id": "jupiter", "book_id": "first_principles_spencer_1862", "name": "Jupiter", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Jupiter"], "contexts": ["planet with rapid axial movement"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Jupiter", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Jupiter", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Jupiter", "target_book": "first_principles_spencer_1862", "target_name": "Jupiter", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Jupiter", "target_book": "first_principles_spencer_1862", "target_name": "Jupiter", "similarity": 1.0}], "id": 824, "stable_key": "clu_e9ca8b0f66afc757", "ground_truth": {"modern_name": "Jupiter", "confidence": "high", "type": "planet", "note": "Although 'animal' is listed as a category, the context clearly refers to the planet.", "wikidata_id": "Q319", "wikidata_description": "fifth planet in the Solar System and largest among all; gaseous giant mainly composed of hydrogen and helium", "wikipedia_url": "https://en.wikipedia.org/wiki/Jupiter"}}, {"canonical_name": "Sir John Herschel", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 88, "members": [{"entity_id": "sir_john_herschel", "book_id": "kosmos_humboldt_1845", "name": "Sir John Herschel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 13, "variants": ["Sir John Herschel"], "contexts": ["measured mountain elevations", "source for Mount Aetna elevation"]}, {"entity_id": "sir_john_herschel", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Sir John Herschel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 70, "variants": ["Sir John Herschel"], "contexts": ["attributed temperature decrease to orbit variation", "theory of absorption of light"]}, {"entity_id": "sir_john_herschel\u2019s", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Sir John Herschel\u2019s", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Sir John Herschel\u2019s"], "contexts": ["author of work on nebulae"]}, {"entity_id": "sir_john_herschel", "book_id": "first_principles_spencer_1862", "name": "Sir John Herschel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Sir John Herschel"], "contexts": ["astronomer and scientist", "astronomer, discussed star clusters and condensation"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Sir John Herschel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Sir John Herschel", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Sir John Herschel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Sir John Herschel\u2019s", "similarity": 0.97}, {"source_book": "kosmos_humboldt_1845", "source_name": "Sir John Herschel", "target_book": "first_principles_spencer_1862", "target_name": "Sir John Herschel", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Sir John Herschel", "target_book": "first_principles_spencer_1862", "target_name": "Sir John Herschel", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Sir John Herschel\u2019s", "target_book": "first_principles_spencer_1862", "target_name": "Sir John Herschel", "similarity": 0.97}], "id": 825, "stable_key": "clu_7704807617099028", "ground_truth": {"modern_name": "John Herschel", "confidence": "high", "type": "person", "birth_year": 1792, "death_year": 1871, "description": "Astronomer and mathematician, son of William Herschel.", "wikidata_id": "Q14278", "wikidata_description": "English polymath, mathematician, astronomer, chemist, inventor and photographer (*1792 \u2013 \u20201871)", "wikipedia_url": "https://en.wikipedia.org/wiki/John%20Herschel", "note": "The context of 'connexion_physical_sciences_somerville_1858' and discussions of solar phenomena strongly point to Sir John Herschel.", "wikipedia_extract": "Sir John Frederick William Herschel, 1st Baronet  (; 7 March 1792 \u2013 11 May 1871) was an English polymath active as a mathematician, astronomer, chemist, inventor and experimental photographer who invented the blueprint and did botanical work. Herschel originated the use of the Julian day system in astronomy. He named seven moons of Saturn and four moons of Uranus \u2013 the seventh planet, discovered by his father Sir William Herschel. He made many contributions to the science of photography, and investigated colour blindness and the chemical power of ultraviolet rays. His Preliminary Discourse (1831), which advocated an inductive approach to scientific experiment and theory-building, was an important contribution to the philosophy of science. Herschel was born in Slough, Buckinghamshire, the son of Mary Baldwin and astronomer Sir William Herschel."}}, {"canonical_name": "ovo", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 83, "members": [{"entity_id": "ovo_de_galinha", "book_id": "coloquios_da_orta_1563", "name": "ovo de galinha", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["ovo de galinha"], "contexts": ["egg used for size comparison"]}, {"entity_id": "ovo", "book_id": "polyanthea_medicinal", "name": "ovo", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 77, "variants": ["ovo", "ova", "oves"], "contexts": ["egg, used in a remedy", "egg used in a remedy"]}, {"entity_id": "ovum", "book_id": "first_principles_spencer_1862", "name": "ovum", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["ovum"], "contexts": ["development into an animal", "egg cell of a mammal"]}, {"entity_id": "ova", "book_id": "first_principles_spencer_1862", "name": "ova", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["ova"], "contexts": ["developing eggs"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "ovo de galinha", "target_book": "polyanthea_medicinal", "target_name": "ovo", "similarity": 0.921}, {"source_book": "polyanthea_medicinal", "source_name": "ovo", "target_book": "first_principles_spencer_1862", "target_name": "ovum", "similarity": 0.949}, {"source_book": "polyanthea_medicinal", "source_name": "ovo", "target_book": "first_principles_spencer_1862", "target_name": "ova", "similarity": 0.931}], "id": 826, "stable_key": "clu_e1c669c60929d421", "ground_truth": {"modern_name": "Egg", "confidence": "high", "type": "animal_product", "note": "The term 'animal' is broad, but 'egg' is a specific product derived from animals.", "wikidata_id": "Q9384", "wikidata_description": "internal organ used in the male reproductive system", "wikipedia_url": "https://en.wikipedia.org/wiki/Testicle"}}, {"canonical_name": "tumor", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 82, "members": [{"entity_id": "tumors", "book_id": "english_physician_1652", "name": "Tumors", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 22, "variants": ["Tumors", "tumors"], "contexts": ["dissolved by the yellow Archangel", "condition helped by fried herb"]}, {"entity_id": "tumor", "book_id": "principles_of_psychology_james_1890", "name": "tumor", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["tumor"], "contexts": ["abnormal growth in tissue"]}, {"entity_id": "tumor", "book_id": "polyanthea_medicinal", "name": "tumor", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 59, "variants": ["tumor", "Tumor", "Tumoreflatuoso", "otumor", "tumor dos olhos", "tumor dosolhos", "tumorde", "tumordo cerebro", "tumordos olhos", "tumore", "tumorem", "tumores", "tumores capitis puerorum", "tumores dos lagrimaes", "tumores duros", "tumores preternaturaes", "tumores \u017fcirrhofos", "tumoresduros", "tumorespe\u017ftilentes", "tumorofa", "tumor\u017fplenis"], "contexts": ["tumor, a growth", "swelling"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Tumors", "target_book": "principles_of_psychology_james_1890", "target_name": "tumor", "similarity": 0.931}, {"source_book": "english_physician_1652", "source_name": "Tumors", "target_book": "polyanthea_medicinal", "target_name": "tumor", "similarity": 0.931}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tumor", "target_book": "polyanthea_medicinal", "target_name": "tumor", "similarity": 1.0}], "id": 827, "stable_key": "clu_1f0bb344c0d74ff9", "ground_truth": {"modern_name": "tumor", "confidence": "high", "type": "disease", "description": "An abnormal growth or swelling of tissue in the body.", "wikipedia_extract": "A neoplasm () is a type of abnormal and excessive growth of tissue. The process that occurs to form or produce a neoplasm is called neoplasia. The growth of a neoplasm is uncoordinated with that of the normal surrounding tissue, and persists in growing abnormally, even if the original trigger is removed. This abnormal growth usually forms a mass, which may be called a tumour or tumor. ICD-10 classifies neoplasms into four main groups: benign neoplasms, in situ neoplasms, malignant neoplasms, and neoplasms of uncertain or unknown behavior. Malignant neoplasms are also simply known as cancers and are the focus of oncology."}}, {"canonical_name": "azougue", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 82, "members": [{"entity_id": "azogue", "book_id": "historia_medicinal_monardes_1574", "name": "Azogue", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 13, "variants": ["Azogue", "Azogbe", "Azoge"], "contexts": ["mercury, alchemists believe it is the matter of gold", "quicksilver, material of gold"]}, {"entity_id": "azougue", "book_id": "coloquios_da_orta_1563", "name": "azougue", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 10, "variants": ["azougue", "aiougue", "azogue"], "contexts": ["mercury, traded for cloves", "quicksilver in spice revenue"]}, {"entity_id": "azougue", "book_id": "polyanthea_medicinal", "name": "azougue", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 59, "variants": ["azougue", "Azougue", "Azougue cru", "azougue cr\u00f9", "azougue vivo", "azougui", "zougue"], "contexts": ["mercury", "substance to be expelled from the head"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Azogue", "target_book": "coloquios_da_orta_1563", "target_name": "azougue", "similarity": 0.888}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Azogue", "target_book": "polyanthea_medicinal", "target_name": "azougue", "similarity": 0.888}, {"source_book": "coloquios_da_orta_1563", "source_name": "azougue", "target_book": "polyanthea_medicinal", "target_name": "azougue", "similarity": 1.0}], "id": 828, "stable_key": "clu_7b4c22977030f8b9", "ground_truth": {"modern_name": "Quicksilver", "confidence": "high", "type": "chemical", "wikidata_id": "Q925", "wikidata_description": "chemical element with symbol Hg and atomic number 80", "wikipedia_extract": "Quicksilver is a 2024 romantasy novel by British author Callie Hart, the first in her Fae & Alchemy trilogy. Hart self-published the book in June 2024 after declining her literary agent's request for substantial revisions. Initial sales were modest, but the book found an audience after Hart sent copies to BookTok creators on TikTok, generating over three million views within two months. The viral attention sparked a 10-bidder auction for publishing rights. Forever, an imprint of Grand Central Publishing, won the auction, releasing a traditional edition on December 3, 2024 that debuted at number one on The New York Times Best Seller list. That same week, Netflix acquired film adaptation rights for seven figures.", "wikipedia_url": "https://en.wikipedia.org/wiki/Quicksilver_(Hart_novel)", "note": "'Azougue' and 'Azogue' are archaic terms for mercury, commonly used in Iberian languages."}}, {"canonical_name": "Yellow Jaundice", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 3, "total_mentions": 81, "members": [{"entity_id": "yellow_jaundice", "book_id": "english_physician_1652", "name": "Yellow Jaundice", "category": "DISEASE", "subcategory": "CHRONIC", "count": 78, "variants": ["Yellow Jaundice", "Black Jaundice", "Jaun", "Jaundice", "Jaun\u2223dice", "Yelloow Jaundice", "black Jaundice", "yel-low Jaundice", "yellow Jaundice", "yellow Jaun\u2223dice", "yellow-Jaundice", "yel\u00adlow Jaundice", "yel\u2223low Jaundice"], "contexts": ["disease affecting the gall", "disease caused by choller"]}, {"entity_id": "yellow_jaundice", "book_id": "ricettario_fiorentino_1597", "name": "Yellow Jaundice", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["Yellow Jaundice"], "contexts": ["disease of liver obstruction"]}, {"entity_id": "yellow_jaundice", "book_id": "polyanthea_medicinal", "name": "yellow Jaundice", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["yellow Jaundice"], "contexts": ["disease of liver obstruction"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Yellow Jaundice", "target_book": "ricettario_fiorentino_1597", "target_name": "Yellow Jaundice", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Yellow Jaundice", "target_book": "polyanthea_medicinal", "target_name": "yellow Jaundice", "similarity": 0.98}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Yellow Jaundice", "target_book": "polyanthea_medicinal", "target_name": "yellow Jaundice", "similarity": 0.98}], "id": 829, "stable_key": "clu_d813e07539442e12", "ground_truth": {"modern_name": "jaundice", "confidence": "high", "type": "disease", "description": "Yellowing of skin and eyes due to liver problems.", "note": "Specifically 'Yellow Jaundice' refers to the condition.", "wikipedia_extract": "Jaundice, also known as icterus, is a yellowish or, less frequently, greenish pigmentation of the skin and sclera due to high bilirubin levels. Jaundice in adults typically indicates the presence of underlying diseases involving abnormal heme metabolism, liver dysfunction, or biliary-tract obstruction. The prevalence of jaundice in adults is rare, while jaundice in babies is common, with an estimated 80% affected during their first week of life. The most commonly associated symptoms of jaundice are itchiness, pale feces, and dark urine. Normal levels of bilirubin in blood are below 1.0 mg/dl (17 \u03bcmol/L), while levels over 2\u20133 mg/dl (34\u201351 \u03bcmol/L) typically result in jaundice. High blood bilirubin is divided into two types: unconjugated and conjugated bilirubin."}}, {"canonical_name": "eau", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 80, "members": [{"entity_id": "eau", "book_id": "medecine_experimentale_bernard_1865", "name": "eau", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 9, "variants": ["eau"], "contexts": ["compound of oxygen and hydrogen", "compound of hydrogen and oxygen"]}, {"entity_id": "eau", "book_id": "epoques_nature_buffon_1778", "name": "eau", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 30, "variants": ["eau"], "contexts": ["substance that solidifies without heat", "liquid solvent"]}, {"entity_id": "l\u2019eau", "book_id": "epoques_nature_buffon_1778", "name": "l\u2019eau", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["l\u2019eau"], "contexts": ["water"]}, {"entity_id": "eau", "book_id": "relation_historique_humboldt_vol3_1825", "name": "eau", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 40, "variants": ["eau"], "contexts": ["medium for transport", "substance mixed with plant sap"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "eau", "target_book": "epoques_nature_buffon_1778", "target_name": "eau", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "eau", "target_book": "epoques_nature_buffon_1778", "target_name": "l\u2019eau", "similarity": 0.963}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "eau", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "eau", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "eau", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "eau", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "l\u2019eau", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "eau", "similarity": 0.963}], "id": 830, "stable_key": "clu_c55e1ce42bddd63b", "ground_truth": {"modern_name": "Water", "confidence": "high", "type": "chemical", "wikidata_id": "Q283", "wikidata_description": "chemical compound whose molecules are formed by two hydrogen atoms and one oxygen atom", "wikipedia_url": "https://en.wikipedia.org/wiki/Water"}}, {"canonical_name": "virtude", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 80, "members": [{"entity_id": "virtud", "book_id": "historia_medicinal_monardes_1574", "name": "virtud", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["virtud", "virtud especifica", "virtud medicinal", "virtudes medici-nales", "virtudes medicinales"], "contexts": ["virtue or power of the bone", "quality of the root"]}, {"entity_id": "virtude", "book_id": "coloquios_da_orta_1563", "name": "virtude", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["virtude", "virtudes"], "contexts": ["virtue associated with the size of the stone", "medicinal efficacy"]}, {"entity_id": "virtude", "book_id": "polyanthea_medicinal", "name": "virtude", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 71, "variants": ["virtude", "virtu", "virtud", "virtude alimenticia", "virtude analo", "virtude do enfermo", "virtude generativa", "virtude purgativa", "virtude restaurativa", "virtudere\u017ftaurativa", "virtudes", "virtudes das plantas", "virtudes \u017feminaes", "virtues", "virtute"], "contexts": ["inherent power or quality", "efficacy or power"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "virtud", "target_book": "coloquios_da_orta_1563", "target_name": "virtude", "similarity": 0.989}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "virtud", "target_book": "polyanthea_medicinal", "target_name": "virtude", "similarity": 0.989}, {"source_book": "coloquios_da_orta_1563", "source_name": "virtude", "target_book": "polyanthea_medicinal", "target_name": "virtude", "similarity": 1.0}], "id": 831, "stable_key": "clu_393e8cb6beffe1a1", "ground_truth": {"modern_name": "Virtue", "confidence": "high", "type": "concept", "note": "The spelling 'vertue' is an archaic form of 'virtue'.", "wikidata_id": "Q1179705", "wikidata_description": "concept in Chinese philosophy"}}, {"canonical_name": "Vitriolo", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 78, "members": [{"entity_id": "vitriol", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Vitriol", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["Vitriol"], "contexts": ["mineral solution that crystallizes", "acid that dissolves ice"]}, {"entity_id": "vitriol", "book_id": "english_physician_1652", "name": "Vitriol", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Vitriol"], "contexts": ["chemical substance"]}, {"entity_id": "vitriolo", "book_id": "polyanthea_medicinal", "name": "Vitriolo", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 73, "variants": ["Vitriolo", "Ovitriolo branco", "Vitriol", "Vitriolatorum", "Vitrioli", "Vitriolialbi", "Vitriolico", "Vitriolo branco", "Vitriolobranco", "vitriato", "vitrioli", "vitriolicas", "vitriolico", "vitriolicos", "vitriolo", "vitriolo branco", "vitriolobran", "vitriolobranco"], "contexts": ["a substance used in medicine", "mineral substance used as emetic"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Vitriol", "target_book": "english_physician_1652", "target_name": "Vitriol", "similarity": 0.863}, {"source_book": "english_physician_1652", "source_name": "Vitriol", "target_book": "polyanthea_medicinal", "target_name": "Vitriolo", "similarity": 0.938}], "id": 832, "stable_key": "clu_82d4941c77a01b7e", "ground_truth": {"modern_name": "Vitriol", "confidence": "high", "type": "chemical", "note": "Vitriol was a general term for sulfates of metals, often used in alchemy and early chemistry/medicine.", "wikidata_id": "Q4118", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Sulfuric%20acid", "wikipedia_extract": "Sulfuric acid (American spelling and the preferred IUPAC name) or sulphuric acid (Commonwealth spelling), known in antiquity as oil of vitriol, is a mineral acid composed of the elements sulfur, oxygen, and hydrogen, with the molecular formula H2SO4. It is a colorless, odorless, and viscous liquid that is miscible with water. Pure sulfuric acid does not occur naturally due to its strong affinity to water vapor; it is hygroscopic and readily absorbs water vapor from the air. Concentrated sulfuric acid is a strong oxidant with powerful dehydrating properties, making it highly corrosive towards other materials, from rocks to metals. Phosphorus pentoxide is a notable exception in that it is not dehydrated by sulfuric acid but, to the contrary, dehydrates sulfuric acid to sulfur trioxide. Upon addition of sulfuric acid to water, a considerable amount of heat is released; thus, the reverse procedure of adding water to the acid is generally avoided since the heat released may boil the solution, spraying droplets of hot acid during the process.", "description": "A sulfate mineral, often used as a caustic or astringent."}}, {"canonical_name": "Skin", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 78, "members": [{"entity_id": "skin", "book_id": "english_physician_1652", "name": "Skin", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 33, "variants": ["skin", "Skin"], "contexts": ["body part helped by oil", "body part, plant helps conditions"]}, {"entity_id": "skin", "book_id": "principles_of_psychology_james_1890", "name": "skin", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 23, "variants": ["skin"], "contexts": ["outer protective covering of the body", "outer protective layer of the body"]}, {"entity_id": "pelle", "book_id": "polyanthea_medicinal", "name": "pelle", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 22, "variants": ["pelle", "pelles"], "contexts": ["skin that can be constipated", "skin"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Skin", "target_book": "principles_of_psychology_james_1890", "target_name": "skin", "similarity": 0.997}, {"source_book": "english_physician_1652", "source_name": "Skin", "target_book": "polyanthea_medicinal", "target_name": "pelle", "similarity": 0.967}, {"source_book": "principles_of_psychology_james_1890", "source_name": "skin", "target_book": "polyanthea_medicinal", "target_name": "pelle", "similarity": 0.968}], "id": 833, "stable_key": "clu_aa7a8d67abb16121", "ground_truth": {"modern_name": "Skin", "confidence": "high", "type": "concept", "note": "While 'skin' is a physical organ, in these contexts it refers to the concept of the outer covering and its properties.", "wikidata_id": "Q272206", "wikidata_description": "family of reptiles (Reptilia)", "wikipedia_url": "https://en.wikipedia.org/wiki/Skin", "wikipedia_extract": "Skin is the layer of usually soft, flexible outer tissue covering the body of a vertebrate animal, with three main functions: protection, regulation, and sensation. Other animal coverings, such as the arthropod exoskeleton, have different developmental origin, structure and chemical composition. The adjective cutaneous means \"of the skin\" (from Latin cutis 'skin'). In mammals, the skin is an organ of the integumentary system made up of multiple layers of ectodermal tissue and guards the underlying muscles, bones, ligaments, and internal organs. Skin of a different nature exists in amphibians, reptiles, and birds. Skin (including cutaneous and subcutaneous tissues) plays crucial roles in formation, structure, and function of extraskeletal apparatus such as horns of bovids (e.g., cattle) and rhinos, cervids' antlers, giraffids' ossicones, armadillos' osteoderm, and os penis/os clitoris."}}, {"canonical_name": "bexigas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 78, "members": [{"entity_id": "enfermedades_dela_bexiga", "book_id": "historia_medicinal_monardes_1574", "name": "enfermedades dela bexiga", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["enfermedades dela bexiga"], "contexts": ["diseases of the bladder"]}, {"entity_id": "bexigas", "book_id": "coloquios_da_orta_1563", "name": "bexigas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["bexigas", "bexiguas"], "contexts": ["smallpox-like disease", "disease with pustules"]}, {"entity_id": "bexigas", "book_id": "polyanthea_medicinal", "name": "bexigas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 67, "variants": ["bexigas", "Bechicis", "Bexigas", "Bexigas com cova nomeyo", "bechigas", "bexigas mortaes", "bexigas veneno\u017fas", "bexigofo", "bexigoso", "bezigas"], "contexts": ["medical condition, blisters", "disease treated by cordial"]}, {"entity_id": "chagas_da_bexiga", "book_id": "polyanthea_medicinal", "name": "chagas da bexiga", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["chagas da bexiga"], "contexts": ["ulcers of the bladder", "sores of the bladder"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "enfermedades dela bexiga", "target_book": "coloquios_da_orta_1563", "target_name": "bexigas", "similarity": 0.917}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "enfermedades dela bexiga", "target_book": "polyanthea_medicinal", "target_name": "bexigas", "similarity": 0.917}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "enfermedades dela bexiga", "target_book": "polyanthea_medicinal", "target_name": "chagas da bexiga", "similarity": 0.889}, {"source_book": "coloquios_da_orta_1563", "source_name": "bexigas", "target_book": "polyanthea_medicinal", "target_name": "bexigas", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "bexigas", "target_book": "polyanthea_medicinal", "target_name": "chagas da bexiga", "similarity": 0.908}], "id": 834, "stable_key": "clu_1dca366d1434bf05", "ground_truth": {"modern_name": "Smallpox", "confidence": "high", "type": "disease", "modern_term": "Variola", "note": "While 'bexigas' can refer to bladder issues, in the context of Monardes and other early modern texts, it strongly points to smallpox, especially when combined with 'chagas' (sores/blisters).", "wikidata_id": "Q12214", "wikidata_description": "eradicated human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Smallpox", "wikipedia_extract": "Smallpox was an infectious disease caused by Variola virus (often called Smallpox virus), which belongs to the genus Orthopoxvirus. The last naturally occurring case was diagnosed in October 1977, and the World Health Organization (WHO) certified the global eradication of the disease in 1980, making smallpox the only human disease to have been eradicated as of 2022. The initial symptoms of the disease included fever and vomiting. This was followed by formation of ulcers in the mouth and a skin rash. Over a number of days, the skin rash turned into the characteristic fluid-filled blisters with a dent in the center. The bumps then scabbed over and fell off, leaving scars."}}, {"canonical_name": "seca", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 76, "members": [{"entity_id": "seca", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "seca", "category": "CONCEPT", "subcategory": "QUALITY", "count": 51, "variants": ["seca"], "contexts": ["quality of the plant's nature", "quality of temperature"]}, {"entity_id": "seccura", "book_id": "polyanthea_medicinal", "name": "seccura", "category": "CONCEPT", "subcategory": "QUALITY", "count": 7, "variants": ["seccura"], "contexts": ["dryness", "quality of weather causing pain"]}, {"entity_id": "secca", "book_id": "polyanthea_medicinal", "name": "secca", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["secca"], "contexts": ["dry quality", "dry imbalance causing illness"]}, {"entity_id": "secas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "secas", "category": "CONCEPT", "subcategory": "QUALITY", "count": 4, "variants": ["secas"], "contexts": ["dry quality of leaves", "quality of nature"]}, {"entity_id": "seca", "book_id": "historia_medicinal_monardes_1574", "name": "seca", "category": "CONCEPT", "subcategory": "QUALITY", "count": 9, "variants": ["seca", "secas", "seco"], "contexts": ["quality of the Ben plant", "quality of the root's complexion"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "seca", "target_book": "polyanthea_medicinal", "target_name": "seccura", "similarity": 0.923}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "seca", "target_book": "polyanthea_medicinal", "target_name": "secca", "similarity": 0.881}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "secas", "target_book": "historia_medicinal_monardes_1574", "target_name": "seca", "similarity": 0.948}], "id": 835, "stable_key": "clu_6f4f2ac165679e50", "ground_truth": {"modern_name": "Dryness", "confidence": "high", "type": "concept", "wikidata_id": "Q5309747", "wikidata_description": "medical condition in which there is a decrease in normal lubrication of the skin or mucous membranes", "wikipedia_url": "https://en.wikipedia.org/wiki/Dryness%20%28medical%29"}}, {"canonical_name": "unguento", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 75, "members": [{"entity_id": "unguentos", "book_id": "historia_medicinal_monardes_1574", "name": "unguentos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["unguentos", "unguento"], "contexts": ["ointments for treating ailments", "preparations in apothecaries"]}, {"entity_id": "unguenti", "book_id": "ricettario_fiorentino_1597", "name": "unguenti", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["unguenti"], "contexts": ["ointments, a type of compound medicine", "ointments"]}, {"entity_id": "unguento", "book_id": "polyanthea_medicinal", "name": "unguento", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 69, "variants": ["unguento", "Unguento acquirido", "Unguento fingular", "UnguentoArmario", "Unguentoda Conde\u00e7a", "Unguentos", "migalha de unguento Aureo", "unguento Alabastrino", "unguento Aureo", "unguento Ro\u017fado", "unguento Sandalino", "unguento branco", "unguento confortativo", "unguento da Conde\u00e7a", "unguento daConde\u00e7a", "unguento de Althea", "unguento de Arag\u00e3o", "unguento de chumbo", "unguento de chumbode almofariz", "unguento de ras", "unguento deAlsa", "unguento dedialthea", "unguento do ba\u00e7o", "unguento peytoral", "unguento populca\u00f3", "unguento populeao", "unguento populeo", "unguento refrigerante", "unguento refumptivo", "unguento re\u017fumptivo", "unguento rofado", "unguento rosado", "unguento ro\u017fado", "unguento sandolino", "unguentoApoftolorum", "unguentoArmario", "unguentoRotadoduas", "unguentoalvo canforado", "unguentoda Conde\u00e7a", "unguentodaConde\u00e7a", "unguentode Althea", "unguentode chumbo", "unguentopopulea\u014d", "unguentos"], "contexts": ["an ointment remedy", "ointment for sores"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "unguentos", "target_book": "ricettario_fiorentino_1597", "target_name": "unguenti", "similarity": 0.895}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "unguentos", "target_book": "polyanthea_medicinal", "target_name": "unguento", "similarity": 0.891}, {"source_book": "ricettario_fiorentino_1597", "source_name": "unguenti", "target_book": "polyanthea_medicinal", "target_name": "unguento", "similarity": 0.949}], "id": 836, "stable_key": "clu_d798f297dff8d25b", "ground_truth": {"modern_name": "ointment", "confidence": "high", "type": "preparation", "description": "A semi-solid medicinal preparation for external application.", "note": "The term 'unguento' is Italian for ointment.", "wikipedia_extract": "A topical medication is a medication that is applied to a particular place on or in the body. Most often topical medication means application to body surfaces such as the skin or mucous membranes to treat ailments via a large range of classes including creams, foams, gels, lotions, and ointments. Many topical medications are epicutaneous, meaning that they are applied directly to the skin. Topical medications may also be inhalational, such as asthma medications, or applied to the surface of tissues other than the skin, such as eye drops applied to the conjunctiva, or ear drops placed in the ear, or medications applied to the surface of a tooth. The word topical derives from Greek \u03c4\u03bf\u03c0\u03b9\u03ba\u03cc\u03c2 topikos, \"of a place\". Topical drug delivery is a route of administering drugs via the skin to provide topical therapeutic effects."}}, {"canonical_name": "Amazone", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 74, "members": [{"entity_id": "amazones", "book_id": "epoques_nature_buffon_1778", "name": "Amazones", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Amazones"], "contexts": ["river in America"]}, {"entity_id": "amazone", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Amazone", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 72, "variants": ["Amazone", "AMAZONES", "Amazones", "l'Amazone"], "contexts": ["river in South America", "river basin reached by Caribes"]}, {"entity_id": "amazons", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Amazons", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Amazons"], "contexts": ["river with perceptible tides and forests"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Amazones", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Amazone", "similarity": 0.99}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Amazones", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Amazons", "similarity": 0.981}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Amazone", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Amazons", "similarity": 0.974}], "id": 837, "stable_key": "clu_79bbdfa7c65b19d0", "ground_truth": {"modern_name": "Amazon River", "confidence": "high", "type": "place", "country": "Brazil", "note": "The French 'Amazone' and 'Rivi\u00e8re des Amazones' directly translate to Amazon and River of the Amazons.", "wikidata_id": "Q205329", "wikidata_description": "species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Amazon%20river%20dolphin", "wikipedia_extract": "The Amazon River (UK: , US: ; Portuguese: rio Amazonas, Spanish: r\u00edo Amazonas) in South America is the largest river by discharge volume of water in the world, and the longest or second-longest river system in the world, a title which is disputed with the Nile. The headwaters of the Apur\u00edmac River on Nevado Mismi had been considered, for nearly a century, the Amazon basin's most distant source until a 2014 study found it to be the headwaters of the Mantaro River on the Cordillera Rumi Cruz in Peru. The Mantaro and Apur\u00edmac rivers join, and with other tributaries form the Ucayali River, which in turn meets the Mara\u00f1\u00f3n River upstream of Iquitos, Peru, forming what countries other than Brazil consider to be the main stem of the Amazon. Brazilians call this section the Solim\u00f5es River above its confluence with the Rio Negro forming what Brazilians call the Amazon at the Meeting of Waters (Portuguese: Encontro das \u00c1guas) at Manaus, the largest city on the river. The Amazon River has an average discharge of about 215,000\u2013230,000 m3/s (7,600,000\u20138,100,000 cu ft/s)\u2014approximately 6,591\u20137,570 km3 (1,581\u20131,816 cu mi) per year, greater than the next seven largest independent rivers combined. Two of the top ten rivers by discharge are tributaries of the Amazon river."}}, {"canonical_name": "vino", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 74, "members": [{"entity_id": "vino", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "vino", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 23, "variants": ["vino"], "contexts": ["drink used to administer medicine", "liquid for preparation"]}, {"entity_id": "vino", "book_id": "historia_medicinal_monardes_1574", "name": "vino", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 36, "variants": ["vino", "Vino", "vino aguado", "vino blanco", "vino tinto"], "contexts": ["wine", "vehicle and corroboration for the root's work"]}, {"entity_id": "vino", "book_id": "ricettario_fiorentino_1597", "name": "Vino", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 15, "variants": ["Vino", "vino"], "contexts": ["substance drawn by art", "source of wine lees"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "vino", "target_book": "historia_medicinal_monardes_1574", "target_name": "vino", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "vino", "target_book": "ricettario_fiorentino_1597", "target_name": "Vino", "similarity": 0.986}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "vino", "target_book": "ricettario_fiorentino_1597", "target_name": "Vino", "similarity": 0.986}], "id": 838, "stable_key": "clu_6110a1f26657a473-2", "ground_truth": {"modern_name": "Wine", "confidence": "high", "type": "chemical", "note": "Both 'vino' and 'Vino' are clearly the Italian and Spanish/Portuguese words for wine, a common medicinal ingredient.", "wikidata_id": "Q282", "wikidata_description": "alcoholic drink typically made from grapes through the fermentation process", "wikipedia_url": "https://en.wikipedia.org/wiki/Wine", "wikipedia_extract": "Wine is an alcoholic drink made from fermented grape juice. It is produced and consumed in many regions around the world, in a wide variety of styles which are influenced by different varieties of grapes, growing environments, viticulture methods, and production techniques. Wine has been produced for thousands of years, the earliest evidence dating from c. 6000 BCE in present-day Georgia. Its popularity spread around the Mediterranean during Classical antiquity, and was sustained in Western Europe by winemaking monks and a secular trade for general drinking. New World wine was established by settler colonies from the 16th century onwards, and the wine trade increased dramatically up to the latter half of the 19th century, when European vineyards were largely destroyed by the invasive pest phylloxera.", "description": "An alcoholic beverage made from fermented grapes."}}, {"canonical_name": "physiologie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 73, "members": [{"entity_id": "physiologie", "book_id": "medecine_experimentale_bernard_1865", "name": "physiologie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 59, "variants": ["physiologie"], "contexts": ["study of bodily functions", "the study of bodily functions"]}, {"entity_id": "physiology", "book_id": "principles_of_psychology_james_1890", "name": "physiology", "category": "CONCEPT", "subcategory": "THEORY", "count": 11, "variants": ["physiology", "Physiology"], "contexts": ["field of study for nerve functions", "study of bodily functions"]}, {"entity_id": "physiology", "book_id": "kosmos_humboldt_1845", "name": "physiology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Physiology", "physiology"], "contexts": ["study of the functions of living organisms"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "physiologie", "target_book": "principles_of_psychology_james_1890", "target_name": "physiology", "similarity": 0.985}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "physiologie", "target_book": "kosmos_humboldt_1845", "target_name": "physiology", "similarity": 0.985}, {"source_book": "principles_of_psychology_james_1890", "source_name": "physiology", "target_book": "kosmos_humboldt_1845", "target_name": "physiology", "similarity": 1.0}], "id": 839, "stable_key": "clu_2c3cad60248bdae1", "ground_truth": {"modern_name": "Physiology", "confidence": "high", "type": "concept", "wikidata_id": "Q521", "wikidata_description": "science regarding function of organisms or living systems", "wikipedia_url": "https://en.wikipedia.org/wiki/Physiology"}}, {"canonical_name": "astrological medicine", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 3, "total_mentions": 72, "members": [{"entity_id": "astrological_medicine", "book_id": "coloquios_da_orta_1563", "name": "astrological medicine", "category": "CONCEPT", "subcategory": "THEORY", "count": 20, "variants": ["astrological medicine"], "contexts": ["implied medical theory", "implied in medical applications"]}, {"entity_id": "astrological_medicine", "book_id": "ricettario_fiorentino_1597", "name": "Astrological medicine", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["astrological medicine", "Astrological medicine"], "contexts": ["implied by discussion of celestial influence", "medical theory"]}, {"entity_id": "astrological_medicine", "book_id": "polyanthea_medicinal", "name": "astrological medicine", "category": "CONCEPT", "subcategory": "THEORY", "count": 50, "variants": ["astrological medicine", "Astrological medicine"], "contexts": ["implied medical framework", "medicine influenced by astrology"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "astrological medicine", "target_book": "ricettario_fiorentino_1597", "target_name": "Astrological medicine", "similarity": 0.954}, {"source_book": "coloquios_da_orta_1563", "source_name": "astrological medicine", "target_book": "polyanthea_medicinal", "target_name": "astrological medicine", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Astrological medicine", "target_book": "polyanthea_medicinal", "target_name": "astrological medicine", "similarity": 0.954}], "id": 840, "stable_key": "clu_0ca53389285ac0ef", "ground_truth": {"modern_name": "Astrological medicine", "confidence": "high", "type": "concept"}}, {"canonical_name": "quentes", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 71, "members": [{"entity_id": "chauds", "book_id": "epoques_nature_buffon_1778", "name": "chauds", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["chauds"], "contexts": ["quality of bodies"]}, {"entity_id": "calientes", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "calientes", "category": "CONCEPT", "subcategory": "QUALITY", "count": 23, "variants": ["calientes"], "contexts": ["quality of the plant's nature", "quality of the third degree"]}, {"entity_id": "quentes", "book_id": "polyanthea_medicinal", "name": "quentes", "category": "CONCEPT", "subcategory": "QUALITY", "count": 47, "variants": ["quentes", "quente"], "contexts": ["a quality associated with health", "hot"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "chauds", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "calientes", "similarity": 0.966}, {"source_book": "epoques_nature_buffon_1778", "source_name": "chauds", "target_book": "polyanthea_medicinal", "target_name": "quentes", "similarity": 0.964}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "calientes", "target_book": "polyanthea_medicinal", "target_name": "quentes", "similarity": 0.97}], "id": 841, "stable_key": "clu_102e746c1393cc52-2", "ground_truth": {"modern_name": "hot (quality)", "confidence": "high", "type": "concept", "note": "Refers to the humoral quality of 'hot' in ancient and medieval medical traditions."}}, {"canonical_name": "Diabetica", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 3, "total_mentions": 70, "members": [{"entity_id": "diab\u00e9tique", "book_id": "medecine_experimentale_bernard_1865", "name": "diab\u00e9tique", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["diab\u00e9tique"], "contexts": ["condition of artificial diabetes"]}, {"entity_id": "diab\u00e8te", "book_id": "medecine_experimentale_bernard_1865", "name": "diab\u00e8te", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["diab\u00e8te"], "contexts": ["artificial diabetes induced by experiment"]}, {"entity_id": "diabets", "book_id": "english_physician_1652", "name": "Diabets", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["Diabets", "Diabetes"], "contexts": ["diabetes mellitus", "metabolic disorder"]}, {"entity_id": "diabetica", "book_id": "polyanthea_medicinal", "name": "Diabetica", "category": "DISEASE", "subcategory": "CHRONIC", "count": 66, "variants": ["Diabetica", "Diabe", "Diabete", "Diabetem", "Diabeticas", "Diabeticos", "Diab\u00e9tica", "diabetica", "fedas Diabeticas"], "contexts": ["medical condition related to urine", "diabetic disease"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "diab\u00e9tique", "target_book": "english_physician_1652", "target_name": "Diabets", "similarity": 0.943}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "diab\u00e9tique", "target_book": "polyanthea_medicinal", "target_name": "Diabetica", "similarity": 0.965}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "diab\u00e8te", "target_book": "english_physician_1652", "target_name": "Diabets", "similarity": 0.944}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "diab\u00e8te", "target_book": "polyanthea_medicinal", "target_name": "Diabetica", "similarity": 0.95}, {"source_book": "english_physician_1652", "source_name": "Diabets", "target_book": "polyanthea_medicinal", "target_name": "Diabetica", "similarity": 0.953}], "id": 842, "stable_key": "clu_799f3c8465815dd3", "ground_truth": {"modern_name": "Diabetes", "confidence": "high", "type": "disease", "description": "A metabolic disease characterized by high blood sugar levels.", "wikipedia_extract": "Diabetes mellitus, commonly known as diabetes, is a group of common endocrine diseases characterized by sustained high blood sugar levels. Diabetes tends to progress in severity, and is due to either a reduced production of the hormone insulin by the pancreas or unresponsiveness of bodily cells to insulin's effects. Classic symptoms include the three Ps: polydipsia (excessive thirst), polyuria (excessive urination), and polyphagia (excessive hunger), together with weight loss and blurred vision. If left untreated, the disease can lead to many health complications, including disorders of the cardiovascular system, eye, kidney, and nerves. The major types of diabetes are type 1 and type 2. The most common type is type 2."}}, {"canonical_name": "atmosphere", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 69, "members": [{"entity_id": "atmosph\u00e8re", "book_id": "medecine_experimentale_bernard_1865", "name": "atmosph\u00e8re", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["atmosph\u00e8re"], "contexts": ["gaseous envelope surrounding the earth"]}, {"entity_id": "atmosph\u00e8re_ext\u00e9rieure", "book_id": "medecine_experimentale_bernard_1865", "name": "atmosph\u00e8re ext\u00e9rieure", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["atmosph\u00e8re ext\u00e9rieure"], "contexts": ["the external atmosphere"]}, {"entity_id": "atmosph\u00e8re", "book_id": "relation_historique_humboldt_vol3_1825", "name": "atmosph\u00e8re", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 11, "variants": ["atmosph\u00e8re", "air atmosph\u00e9rique", "atmosph\u00e8re terrestre"], "contexts": ["constitution influencing barometer variation", "gaseous envelope surrounding Earth"]}, {"entity_id": "atmosphere", "book_id": "connexion_physical_sciences_somerville_1858", "name": "atmosphere", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 56, "variants": ["Atmosphere", "atmosphere"], "contexts": ["loss of light by absorbing power", "gaseous envelope of a planet"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "atmosph\u00e8re", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "atmosph\u00e8re", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "atmosph\u00e8re", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "atmosphere", "similarity": 0.953}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "atmosph\u00e8re ext\u00e9rieure", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "atmosph\u00e8re", "similarity": 0.94}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "atmosph\u00e8re ext\u00e9rieure", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "atmosphere", "similarity": 0.898}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "atmosph\u00e8re", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "atmosphere", "similarity": 0.953}], "id": 843, "stable_key": "clu_e9da3f8672793df8", "ground_truth": {"modern_name": "Atmosphere", "confidence": "high", "type": "concept", "wikidata_id": "Q8104", "wikidata_description": "layer of gases surrounding a material body", "wikipedia_url": "https://en.wikipedia.org/wiki/Atmosphere", "wikipedia_extract": "An atmosphere is a layer of gases that envelop an astronomical object, held in place by the gravity of the object. The name originates from Ancient Greek  \u1f00\u03c4\u03bc\u03cc\u03c2 (atm\u00f3s) 'vapour, steam' and  \u03c3\u03c6\u03b1\u1fd6\u03c1\u03b1 (spha\u00eera) 'sphere'. An object acquires most of its atmosphere during its primordial epoch, either by accretion of matter or by outgassing of volatiles. The chemical interaction of the atmosphere with the solid surface can change its fundamental composition, as can photochemical interaction with the Sun. A planet retains an atmosphere for longer durations when the gravity is high and the temperature is low. The solar wind works to strip away a planet's outer atmosphere, although this process is slowed by a magnetosphere."}}, {"canonical_name": "Panama", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 69, "members": [{"entity_id": "panama", "book_id": "epoques_nature_buffon_1778", "name": "Panama", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Panama"], "contexts": ["city where Cordilleras curve west", "geographic location in America"]}, {"entity_id": "isthme_de_panama", "book_id": "epoques_nature_buffon_1778", "name": "isthme de Panama", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["isthme de Panama"], "contexts": ["land bridge between continents", "narrow strip of land connecting North and South America"]}, {"entity_id": "panama", "book_id": "origin_of_species_darwin_1859", "name": "Panama", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Panama"], "contexts": ["impassable isthmus separating faunas"]}, {"entity_id": "panama", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Panama", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 54, "variants": ["Panama"], "contexts": ["province in South America", "city with population 50,000"]}, {"entity_id": "isthme_de_panama", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Isthme de Panama", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 10, "variants": ["Isthme de Panama", "isthme de Panama"], "contexts": ["isthmus parallel to the Antilles", "geographic landform"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Panama", "target_book": "origin_of_species_darwin_1859", "target_name": "Panama", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Panama", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Panama", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "isthme de Panama", "target_book": "origin_of_species_darwin_1859", "target_name": "Panama", "similarity": 0.884}, {"source_book": "epoques_nature_buffon_1778", "source_name": "isthme de Panama", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Panama", "similarity": 0.884}, {"source_book": "epoques_nature_buffon_1778", "source_name": "isthme de Panama", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Isthme de Panama", "similarity": 0.909}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Panama", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Panama", "similarity": 1.0}], "id": 844, "stable_key": "clu_159d738fd3bced5b", "ground_truth": {"modern_name": "Panama", "confidence": "high", "type": "place", "description": "Isthmus and province in Central America.", "note": "Includes both the geographical isthmus and the historical region/city.", "wikipedia_extract": "Panama, officially the Republic of Panama, is a country located at the southern end of Central America, bordering South America. It is bordered by Costa Rica to the west, Colombia to the southeast, the Caribbean Sea to the north, and the Pacific Ocean to the south. Its capital and largest city is Panama City, whose metropolitan area is home to nearly half of the country's over 4 million inhabitants. Before the arrival of Spanish colonists in the 16th century, Panama was inhabited by a number of different indigenous tribes. It broke away from Spain in 1821 and joined the Republic of Gran Colombia, a union of Nueva Granada, Ecuador, and Venezuela. After Gran Colombia dissolved in 1831, Panama and Nueva Granada eventually became the Republic of Colombia."}}, {"canonical_name": "azeyte", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 67, "members": [{"entity_id": "azeyte", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "azeyte", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 11, "variants": ["azeyte"], "contexts": ["oil from the Liquidambar tree", "oil"]}, {"entity_id": "azeyte_deveto", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Azeyte deveto", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Azeyte deveto"], "contexts": ["oil ingredient in preparation"]}, {"entity_id": "aceyte", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "aceyte", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["aceyte"], "contexts": ["oil extracted from plant medulla"]}, {"entity_id": "azeyte", "book_id": "historia_medicinal_monardes_1574", "name": "Azeyte", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 16, "variants": ["Azeyte", "Aceyte", "Azeyte de Azahar", "Azeyte de Liquidambar", "Azeyte de a ote", "Azeyto", "aceyte", "azeyte", "azeyte Mir", "azeyte de Almen", "azeyte de Almendras dulces", "azeyte de Oliua", "azeytedeLiquidambar"], "contexts": ["oil", "substance, oil"]}, {"entity_id": "azeyte", "book_id": "polyanthea_medicinal", "name": "azeyte", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 38, "variants": ["azeyte", "Azeyte", "azeyte commum", "azeyte velho"], "contexts": ["emetic ingredient", "mixed with vinegar"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "azeyte", "target_book": "historia_medicinal_monardes_1574", "target_name": "Azeyte", "similarity": 0.992}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "azeyte", "target_book": "polyanthea_medicinal", "target_name": "azeyte", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Azeyte deveto", "target_book": "historia_medicinal_monardes_1574", "target_name": "Azeyte", "similarity": 0.897}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Azeyte deveto", "target_book": "polyanthea_medicinal", "target_name": "azeyte", "similarity": 0.896}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "aceyte", "target_book": "historia_medicinal_monardes_1574", "target_name": "Azeyte", "similarity": 0.909}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "aceyte", "target_book": "polyanthea_medicinal", "target_name": "azeyte", "similarity": 0.922}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Azeyte", "target_book": "polyanthea_medicinal", "target_name": "azeyte", "similarity": 0.992}], "id": 845, "stable_key": "clu_3e12dbd72846a700", "ground_truth": {"modern_name": "Oil", "confidence": "high", "type": "chemical", "note": "The contexts 'oil' and 'emetic ingredient' strongly suggest a general term for oil, which could be vegetable or animal.", "wikidata_id": "Q170885", "wikidata_description": "hydrophobic liquid containing volatile aroma compounds from plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Essential%20oil", "wikipedia_extract": "Essential oils are compodes of hydrophobic volatile organic compounds, usually in liquid form, obtained from plant material. Essential oils are also known as volatile oils, ethereal oils, aetheroleum, or simply as the oil of the plant from which they were extracted, such as oil of clove. An essential oil is essential in the sense that the oil contains the fragrance or essence of the plant. The term \"essential\" used here does not indicate that it is nutritionally required in the diet, as with essential amino acid or essential fatty acid. Essential oils, according to ISO, are produced either by steam distillation, by mechanical manipulation of the rind of the fruits of the genus Citrus (also called cold pressing), or by dry distillation. Other methods, such as solvent extraction, are not accepted and, in fact, result in different perfumed products (pommades, concretes, and absolutes)."}}, {"canonical_name": "Diseases", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 66, "members": [{"entity_id": "diseases", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "diseases", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["diseases"], "contexts": ["medical conditions"]}, {"entity_id": "diseases", "book_id": "english_physician_1652", "name": "Diseases", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 63, "variants": ["Diseases", "Diseas", "Disease", "Diseases aforesaid", "Diseases of the Breast and Lungs", "Diseases of the Chest and Lungs", "Diseases of the Chest or Breast", "Diseases of the Head", "Diseases of the Head and Brains", "Diseases of the Lungs", "Diseases of the Lungues", "Diseases of the Mo\u2223ther", "Diseases of the Sinews", "Diseases of the Throat", "Diseases of the mouth", "Diseases thereof", "diseases", "diseases of the brain", "sicknesses"], "contexts": ["ailments cured by herb", "general term for ailments"]}, {"entity_id": "enfermedades", "book_id": "polyanthea_medicinal", "name": "enfermedades", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["enfermedades"], "contexts": ["diseases"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "diseases", "target_book": "english_physician_1652", "target_name": "Diseases", "similarity": 0.99}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "diseases", "target_book": "polyanthea_medicinal", "target_name": "enfermedades", "similarity": 0.988}, {"source_book": "english_physician_1652", "source_name": "Diseases", "target_book": "polyanthea_medicinal", "target_name": "enfermedades", "similarity": 0.987}], "id": 846, "stable_key": "clu_d5e5eefa4c0de884-2", "ground_truth": {"modern_name": "diseases", "confidence": "high", "type": "disease", "modern_term": "diseases", "wikidata_id": "Q18123741", "wikidata_description": "disease caused by infection of pathogenic biological agents in a host organism", "wikipedia_url": "https://en.wikipedia.org/wiki/Infectious%20disease", "note": "'Enfermidades' and 'maladies' are direct translations for 'diseases' or 'illnesses'."}}, {"canonical_name": "doen\u00e7as", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 66, "members": [{"entity_id": "enfermedades", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "enfermedades", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 10, "variants": ["enfermedades"], "contexts": ["general term for illnesses", "diseases"]}, {"entity_id": "enfermedades", "book_id": "historia_medicinal_monardes_1574", "name": "enfermedades", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 14, "variants": ["enfermedades", "enfermedad"], "contexts": ["general term for illnesses", "diseases remedied by Balsamo"]}, {"entity_id": "doen\u00e7as", "book_id": "polyanthea_medicinal", "name": "doen\u00e7as", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 42, "variants": ["doen\u00e7as"], "contexts": ["Afflictions that oppress lives", "Various forms of illness"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "enfermedades", "target_book": "historia_medicinal_monardes_1574", "target_name": "enfermedades", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "enfermedades", "target_book": "polyanthea_medicinal", "target_name": "doen\u00e7as", "similarity": 0.993}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "enfermedades", "target_book": "polyanthea_medicinal", "target_name": "doen\u00e7as", "similarity": 0.993}], "id": 847, "stable_key": "clu_d5e5eefa4c0de884-3", "ground_truth": {"modern_name": "diseases", "confidence": "high", "type": "disease", "modern_term": "diseases", "wikidata_id": "Q18123741", "wikidata_description": "disease caused by infection of pathogenic biological agents in a host organism", "wikipedia_url": "https://en.wikipedia.org/wiki/Infectious%20disease", "note": "'Enfermidades' and 'maladies' are direct translations for 'diseases' or 'illnesses'."}}, {"canonical_name": "enxofre", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 65, "members": [{"entity_id": "soufres", "book_id": "epoques_nature_buffon_1778", "name": "soufres", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["soufres"], "contexts": ["sulfur substances"]}, {"entity_id": "soufre", "book_id": "epoques_nature_buffon_1778", "name": "soufre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["soufre"], "c