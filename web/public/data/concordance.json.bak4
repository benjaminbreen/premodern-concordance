lacs"], "contexts": ["bodies of water"]}, {"entity_id": "lakes", "book_id": "kosmos_humboldt_1845", "name": "lakes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["lakes"], "contexts": ["bodies of water"]}, {"entity_id": "lakes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "lakes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["lakes"], "contexts": ["large bodies of water", "bodies of water"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "lacs", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "lagoons", "similarity": 0.924}, {"source_book": "epoques_nature_buffon_1778", "source_name": "lacs", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "lacs", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "lacs", "target_book": "kosmos_humboldt_1845", "target_name": "lakes", "similarity": 0.944}, {"source_book": "epoques_nature_buffon_1778", "source_name": "lacs", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lakes", "similarity": 0.944}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "lagoons", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "lacs", "similarity": 0.924}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "lagoons", "target_book": "kosmos_humboldt_1845", "target_name": "lakes", "similarity": 0.936}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "lagoons", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lakes", "similarity": 0.936}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "lacs", "target_book": "kosmos_humboldt_1845", "target_name": "lakes", "similarity": 0.944}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "lacs", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lakes", "similarity": 0.944}, {"source_book": "kosmos_humboldt_1845", "source_name": "lakes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lakes", "similarity": 1.0}], "id": 304, "stable_key": "clu_4e8430f4af178a5e", "ground_truth": {"modern_name": "Great Lakes", "confidence": "high", "type": "place", "country": "Canada, United States", "note": "The context of 'large lakes in North America' strongly suggests the Great Lakes region.", "wikidata_id": "Q1166", "wikidata_description": "state of the United States of America", "wikipedia_url": "https://en.wikipedia.org/wiki/Michigan", "wikipedia_extract": "Michigan (  MISH-ig-\u0259n) is a peninsular state in the Great Lakes region of the Upper Midwestern United States. It shares water and land boundaries with Minnesota to the northwest, Wisconsin to the west, Indiana and Illinois to the southwest, Ohio to the southeast, and the Canadian province of Ontario to the east, northeast and north. With a population of 10.14 million and an area of 96,716 sq mi (250,490 km2), Michigan is the tenth-largest state by population, the 11th-largest by area, and the largest by total area east of the Mississippi River. The state capital is Lansing, while its most populous city is Detroit. The Metro Detroit region in Southeast Michigan is among the nation's most populous and largest metropolitan economies. Other important metropolitan areas include Grand Rapids, Flint, Ann Arbor, Kalamazoo, the Tri-Cities, and Muskegon."}}, {"canonical_name": "Creta", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 5, "total_mentions": 6, "members": [{"entity_id": "cr\u00e8te", "book_id": "epoques_nature_buffon_1778", "name": "Cr\u00e8te", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cr\u00e8te"], "contexts": ["island in the Mediterranean"]}, {"entity_id": "cretan", "book_id": "kosmos_humboldt_1845", "name": "Cretan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cretan"], "contexts": ["from the island of Crete"]}, {"entity_id": "creta", "book_id": "historia_medicinal_monardes_1574", "name": "Creta", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Creta"], "contexts": ["island where Dictamo grows", "island, Crete"]}, {"entity_id": "creta", "book_id": "coloquios_da_orta_1563", "name": "Creta", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Creta"], "contexts": ["location of a\u00e7aroro according to Pliny"]}, {"entity_id": "creta", "book_id": "polyanthea_medicinal", "name": "Creta", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Creta"], "contexts": ["location of a plague"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Cr\u00e8te", "target_book": "kosmos_humboldt_1845", "target_name": "Cretan", "similarity": 0.901}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Cr\u00e8te", "target_book": "historia_medicinal_monardes_1574", "target_name": "Creta", "similarity": 0.886}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cretan", "target_book": "historia_medicinal_monardes_1574", "target_name": "Creta", "similarity": 0.978}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Creta", "target_book": "coloquios_da_orta_1563", "target_name": "Creta", "similarity": 0.863}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Creta", "target_book": "polyanthea_medicinal", "target_name": "Creta", "similarity": 0.863}, {"source_book": "coloquios_da_orta_1563", "source_name": "Creta", "target_book": "polyanthea_medicinal", "target_name": "Creta", "similarity": 1.0}], "id": 305, "stable_key": "clu_41ed4ce9c1a1b25c", "ground_truth": {"wikipedia_extract": "Crete ( KREET; Greek: \u039a\u03c1\u03ae\u03c4\u03b7, Modern: Kr\u00edti [\u02c8kriti], Ancient: Kr\u1e17t\u0113 [kr\u025b\u030c\u02d0t\u03b5\u02d0]) is the largest and most populous of the Greek islands, the 90th largest island in the world, and the fifth largest island in the Mediterranean Sea, after Sicily, Sardinia, Cyprus, and Corsica. Crete is located approximately 100 km (62 mi) south of the Peloponnese, and about 300 km (190 mi) southwest of Anatolia. Crete has an area of 8,450 km2 (3,260 mi2) and a coastline of 1,046 km (650 mi). It bounds the southern border of the Aegean Sea, with the Sea of Crete (or North Cretan Sea) to the north and the Libyan Sea (or South Cretan Sea) to the south. Crete covers 260 km from west to east but is narrow from north to south, spanning three degrees of longitude but only half a degree of latitude. Crete and its surrounding islands and islets form the Region of Crete (Greek: \u03a0\u03b5\u03c1\u03b9\u03c6\u03ad\u03c1\u03b5\u03b9\u03b1 \u039a\u03c1\u03ae\u03c4\u03b7\u03c2), which is the southernmost of the 13 top-level administrative units of Greece, and the fifth most populous of Greece's regions."}}, {"canonical_name": "Pleurisy", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 5, "total_mentions": 6, "members": [{"entity_id": "pleurisy", "book_id": "english_physician_1652", "name": "Pleurisy", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["Pleurisy", "Pleuresy"], "contexts": ["acute illness", "inflammation of the pleura"]}, {"entity_id": "pleurisy", "book_id": "coloquios_da_orta_1563", "name": "pleurisy", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["pleurisy"], "contexts": ["acute inflammation of pleura"]}, {"entity_id": "pleurisy", "book_id": "ricettario_fiorentino_1597", "name": "Pleurisy", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["Pleurisy"], "contexts": ["inflammation of pleura"]}, {"entity_id": "pleupe", "book_id": "polyanthea_medicinal", "name": "Pleupe", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["Pleupe"], "contexts": ["acute illness, likely pleurisy"]}, {"entity_id": "pleurisy", "book_id": "first_principles_spencer_1862", "name": "pleurisy", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["pleurisy"], "contexts": ["inflammation of the pleura"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Pleurisy", "target_book": "coloquios_da_orta_1563", "target_name": "pleurisy", "similarity": 0.982}, {"source_book": "english_physician_1652", "source_name": "Pleurisy", "target_book": "ricettario_fiorentino_1597", "target_name": "Pleurisy", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Pleurisy", "target_book": "polyanthea_medicinal", "target_name": "Pleupe", "similarity": 0.883}, {"source_book": "english_physician_1652", "source_name": "Pleurisy", "target_book": "first_principles_spencer_1862", "target_name": "pleurisy", "similarity": 0.982}, {"source_book": "coloquios_da_orta_1563", "source_name": "pleurisy", "target_book": "ricettario_fiorentino_1597", "target_name": "Pleurisy", "similarity": 0.982}, {"source_book": "coloquios_da_orta_1563", "source_name": "pleurisy", "target_book": "first_principles_spencer_1862", "target_name": "pleurisy", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Pleurisy", "target_book": "polyanthea_medicinal", "target_name": "Pleupe", "similarity": 0.883}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Pleurisy", "target_book": "first_principles_spencer_1862", "target_name": "pleurisy", "similarity": 0.982}], "id": 306, "stable_key": "clu_05729e3531e11aa2", "ground_truth": {"modern_name": "Pleurisy", "confidence": "high", "type": "disease", "description": "Inflammation of the pleura, causing sharp chest pain.", "wikipedia_extract": "Pleurisy, also known as pleuritis, is inflammation of the membranes that surround the lungs and line the chest cavity (pleurae). This can result in a sharp chest pain while breathing. Occasionally the pain may be a constant dull ache. Other symptoms may include shortness of breath, cough, fever, and weight loss, depending on the underlying cause. Pleurisy can be caused by a variety of conditions, including viral or bacterial infections, autoimmune disorders, and pulmonary embolism. The most common cause is a viral infection."}}, {"canonical_name": "geographical province", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 5, "total_mentions": 6, "members": [{"entity_id": "geographical_province", "book_id": "origin_of_species_darwin_1859", "name": "geographical province", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["geographical province"], "contexts": ["distinct area with unique species distribution", "distinct area for animal migration"]}, {"entity_id": "provincia", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Provincia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Provincia"], "contexts": ["former administrative division"]}, {"entity_id": "province", "book_id": "kosmos_humboldt_1845", "name": "province", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["province"], "contexts": ["administrative region"]}, {"entity_id": "prov\u00edncia", "book_id": "coloquios_da_orta_1563", "name": "prov\u00edncia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["prov\u00edncia"], "contexts": ["province"]}, {"entity_id": "provincia", "book_id": "polyanthea_medicinal", "name": "Provincia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Provincia"], "contexts": ["religious order's jurisdiction"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "geographical province", "target_book": "kosmos_humboldt_1845", "target_name": "province", "similarity": 0.9}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Provincia", "target_book": "kosmos_humboldt_1845", "target_name": "province", "similarity": 0.928}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Provincia", "target_book": "coloquios_da_orta_1563", "target_name": "prov\u00edncia", "similarity": 0.808}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Provincia", "target_book": "polyanthea_medicinal", "target_name": "Provincia", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "province", "target_book": "polyanthea_medicinal", "target_name": "Provincia", "similarity": 0.928}, {"source_book": "coloquios_da_orta_1563", "source_name": "prov\u00edncia", "target_book": "polyanthea_medicinal", "target_name": "Provincia", "similarity": 0.808}], "id": 307, "stable_key": "clu_0bd18f6d6cefaf1c", "ground_truth": {"modern_name": "Province", "confidence": "high", "type": "place", "note": "The term 'province' is used historically for administrative regions and also in a biological context to denote a geographical area with distinct flora/fauna.", "wikidata_id": "Q1904", "wikidata_description": "province of Canada", "wikipedia_url": "https://en.wikipedia.org/wiki/Ontario", "wikipedia_extract": "Ontario is the southernmost province of Canada. Located in Central Canada, Ontario is the country's most populous province. As of the 2021 Canadian census, it is home to over 14 million people, which is 38.5% of the country's population. Ontario is the second-largest province by total area (after Quebec) and the fourth-largest jurisdiction of all the Canadian provinces and territories. It is home to the nation's capital, Ottawa, and its most populous city, Toronto, which is Ontario's provincial capital. Ontario is bordered by the province of Manitoba to the west, Hudson Bay and James Bay to the north, and Quebec to the east and northeast."}}, {"canonical_name": "order", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 6, "members": [{"entity_id": "order", "book_id": "origin_of_species_darwin_1859", "name": "order", "cate