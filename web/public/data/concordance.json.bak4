"variants": ["lamantin"], "contexts": ["marine mammal, smaller than whale"]}, {"entity_id": "lamantins", "book_id": "relation_historique_humboldt_vol3_1825", "name": "lamantins", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["lamantins"], "contexts": ["animals frequenting fresh water springs", "marine mammals"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "lamantins", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "lamantins", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "lamantin", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "lamantins", "similarity": 0.925}], "id": 3616, "stable_key": "clu_8c9ff0137f906fb9", "ground_truth": {"modern_name": "Manatee", "confidence": "high", "type": "animal", "wikidata_id": "Q40261", "wikidata_description": "species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/West%20Indian%20manatee"}}, {"canonical_name": "Terre-Neuve", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "terre-neuve", "book_id": "epoques_nature_buffon_1778", "name": "Terre-Neuve", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Terre-Neuve"], "contexts": ["banks potentially joining Canada and Spain"]}, {"entity_id": "terre-neuve", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Terre-Neuve", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Terre-Neuve"], "contexts": ["Newfoundland", "island and province"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Terre-Neuve", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Terre-Neuve", "similarity": 0.763}], "id": 3617, "stable_key": "clu_4c00e6d304e20363", "ground_truth": {"modern_name": "Newfoundland and Labrador", "confidence": "high", "type": "place", "country": "Canada", "wikidata_id": "Q48335", "wikidata_description": "island portion of Newfoundland and Labrador, Canada", "wikipedia_url": "https://en.wikipedia.org/wiki/Newfoundland%20%28island%29"}}, {"canonical_name": "Meal", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "meal", "book_id": "english_physician_1652", "name": "Meal", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Meal", "Meals"], "contexts": ["ground grain, likely flour", "used with parsley leaves for eyes"]}, {"entity_id": "food", "book_id": "principles_of_psychology_james_1890", "name": "food", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["food"], "contexts": ["species interested in its own prey or food"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Meal", "target_book": "principles_of_psychology_james_1890", "target_name": "food", "similarity": 0.935}], "id": 3618, "stable_key": "clu_f9886d2185ef8def", "ground_truth": {"modern_name": "Flour", "confidence": "medium", "type": "plant", "note": "The term 'Meal' in this context likely refers to ground grain, i.e., flour, used as food. It's not a specific plant species."}}, {"canonical_name": "Lust", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "lust", "book_id": "english_physician_1652", "name": "Lust", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Lust", "Lust provokes", "lust"], "contexts": ["bodily desire potentially procured by parsnip", "outragious bodily desire that seed can cool"]}, {"entity_id": "lusts", "book_id": "principles_of_psychology_james_1890", "name": "lusts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["lusts"], "contexts": ["strong desires or appetites"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Lust", "target_book": "principles_of_psychology_james_1890", "target_name": "lusts", "similarity": 0.851}], "id": 3619, "stable_key": "clu_38d8114e4d102712", "ground_truth": {"modern_name": "Lust", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Plums", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "plums", "book_id": "english_physician_1652", "name": "Plums", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Plums", "Plum"], "contexts": ["well-known fruit", "fruit with diverse operations"]}, {"entity_id": "plums", "book_id": "origin_of_species_darwin_1859", "name": "Plums", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Plums"], "contexts": ["fruit grown in the United States"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Plums", "target_book": "origin_of_species_darwin_1859", "target_name": "Plums", "similarity": 1.0}], "id": 3620, "stable_key": "clu_fc76d82d08fc1b89-2", "ground_truth": {"modern_name": "plum", "confidence": "high", "type": "plant", "linnaean": "Prunus domestica", "family": "Rosaceae", "wikidata_id": "Q44120", "wikidata_description": "species of plant in the rose family (Rosaceae)", "description": "A common fruit tree bearing sweet, edible drupes.", "note": "The singular 'Plum' is more appropriate for the general fruit type.", "wikipedia_extract": "Prunus domestica is a species of flowering plant in the family Rosaceae. A deciduous tree, it includes many varieties of the fruit trees known as plums in English, though not all plums belong to this species. The greengages and damsons also belong to subspecies of P. domestica. It typically forms a large shrub or a small tree. It may be somewhat thorny, with white blossom, borne in early spring. The oval or spherical fruit varies in size, but can be up to 8 centimetres (3 inches) across."}}, {"canonical_name": "Oyl of Almonds", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "oyl_of_almonds", "book_id": "english_physician_1652", "name": "Oyl of Almonds", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["Oyl of Almonds", "Oyl of Bitter Almonds", "Oyl of sweet and bitter Almonds"], "contexts": ["oil from almonds", "comparison for kernel oil"]}, {"entity_id": "oil_of_almonds", "book_id": "polyanthea_medicinal", "name": "oil of almonds", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["oil of almonds"], "contexts": ["mixed with crystal powder"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Oyl of Almonds", "target_book": "polyanthea_medicinal", "target_name": "oil of almonds", "similarity": 0.88}], "id": 3621, "stable_key": "clu_b07300b7ec98b666", "ground_truth": {"modern_name": "Oil of Almonds", "confidence": "high", "type": "substance", "description": "Oil extracted from almonds, used in remedies.", "note": "Refers to the oil derived from almond kernels.", "wikipedia_extract": "Marzipan is a confection consisting primarily of sugar and almond meal (ground almonds), sometimes augmented with almond oil or extract. It is often made into sweets; common uses are chocolate-covered marzipan and small marzipan imitations of fruits and vegetables. It can also be used in biscuits or rolled into thin sheets and glazed for icing cakes, primarily birthday cakes, wedding cakes and Christmas cakes. Marzipan may also be used as a baking ingredient, as in stollen or banket. In some countries, it is shaped into small figures of animals as a traditional treat for New Year's Day or Christmas. Marzipan is also used in Tortell, and in some versions of king cake eaten during the Carnival season."}}, {"canonical_name": "Aromaticum Rosarum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "aromaticum_rosarum", "book_id": "english_physician_1652", "name": "Aromaticum Rosarum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["Aromaticum Rosarum", "Aromatica Rosarum", "Aromatica Rosa\u2223rum"], "contexts": ["rose preparation for cordial use", "made with dried Rose leaves"]}, {"entity_id": "aromatico_rosa", "book_id": "ricettario_fiorentino_1597", "name": "AROMATICO ROSA", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["AROMATICO ROSA"], "contexts": ["aromatic preparation with rose"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Aromaticum Rosarum", "target_book": "ricettario_fiorentino_1597", "target_name": "AROMATICO ROSA", "similarity": 0.901}], "id": 3622, "stable_key": "clu_b2ee60d7cec1978e", "ground_truth": {"modern_name": "Aromaticum Rosarum", "confidence": "high", "type": "substance", "description": "Rose preparation used for cordial purposes.", "note": "This is a historical preparation name.", "wikipedia_extract": "In pre-modern medicine, \"diarrhodon\" (Gr \u03b4\u03b9\u03ac\u03c1\u03c1\u03bf\u03b4\u03bf\u03bd, \"compound of roses\", from \u1fe5\u03cc\u03b4\u03c9\u03bd, \"of roses\") is a name given to diverse compositions, in which red roses are an ingredient. Diarrhodon abbatis is a cordial powder, denominated from the Abbot who invented it. It consists of red roses, red and citron santals, lignum aloes, cinnamon, rhapontic, spikenard, ivory, harts-horn, saffron, mastic, pearls, ambergris, musk, etc. It was used to strengthen the heart, stomach, and liver, and to assist in digestion, and prevent vomiting. Philip Barrough, author of the first textbook on medicine published in English, gives this description and recipe for diarrhodon abbatis: \"Electarium Diarrhodon Abbatis mitigateth the heate of the stomacke and midrife, and yet notwithstanding furthereth their concoction, aswageth paine, and dissipateth wind. \"R. Rosarum rubrarum oz. 1 1/2."}}, {"canonical_name": "Stones", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "stones", "book_id": "english_physician_1652", "name": "Stones", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["Stones"], "contexts": ["hard concretions in kidneys or bladder", "bruised with black cherries for distillation"]}, {"entity_id": "stones", "book_id": "polyanthea_medicinal", "name": "stones", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["stones"], "contexts": ["inorganic materials"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Stones", "target_book": "polyanthea_medicinal", "target_name": "stones", "similarity": 0.971}], "id": 3623, "stable_key": "clu_252004724872cdae", "ground_truth": {"modern_name": "Calculi", "confidence": "high", "type": "disease", "modern_term": "Calculus (medical)", "note": "Specifically refers to pathological concretions in the body, most commonly urinary or gallstones."}}, {"canonical_name": "Tooth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "tooth", "book_id": "english_physician_1652", "name": "Tooth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["Tooth"], "contexts": ["aching hollow or loose tooth", "part of the mouth for chewing"]}, {"entity_id": "tooth", "book_id": "principles_of_psychology_james_1890", "name": "tooth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["tooth"], "contexts": ["body part mentioned in example"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Tooth", "target_book": "principles_of_psychology_james_1890", "target_name": "tooth", "similarity": 0.998}], "id": 3624, "stable_key": "clu_2f6830c0c90da30e", "ground_truth": {"modern_name": "Tooth", "confidence": "high", "type": "object"}}, {"canonical_name": "Onions", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "onions", "book_id": "english_physician_1652", "name": "Onions", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Onions"], "contexts": ["used as remedy", "well-known vegetable"]}, {"entity_id": "onion", "book_id": "origin_of_species_darwin_1859", "name": "onion", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["onion"], "contexts": ["variety of plant discussed for cross-pollination"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Onions", "target_book": "origin_of_species_darwin_1859", "target_name": "onion", "similarity": 0.947}], "id": 3625, "stable_key": "clu_a157a7eae72bacac", "ground_truth": {"modern_name": "Onions", "confidence": "high", "type": "plant", "linnaean": "Allium cepa", "family": "Amaryllidaceae", "description": "Common vegetable with a bulb, used for culinary and medicinal purposes.", "note": "Includes the common onion and potentially related species like Rest Harrow (Ononis).", "wikipedia_extract": "The onion (Allium cepa L.Tooltip Carl Linnaeus, from Latin cepa), also known as the bulb onion or common onion, is a vegetable that is the most widely cultivated species of the genus Allium. The shallot is a botanical variety of the onion which was classified as a separate species until 2011. The onion's close relatives include garlic, scallion, leek, and chives. The genus contains several other species variously called onions and cultivated for food, such as the Japanese bunching onion Allium fistulosum, the tree onion Allium \u00d7 proliferum, and the Canada onion Allium canadense. The name wild onion is applied to a number of Allium species, but A. cepa is exclusively known from cultivation. Its ancestral wild original form is not known, although escapes from cultivation have become established in some regions."}}, {"canonical_name": "Lips", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "lips", "book_id": "english_physician_1652", "name": "Lips", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["Lips", "Lids"], "contexts": ["body part", "stained by Bilberry juice"]}, {"entity_id": "lips", "book_id": "principles_of_psychology_james_1890", "name": "lips", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["lips"], "contexts": ["part of the mouth", "body part of a medium"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Lips", "target_book": "principles_of_psychology_james_1890", "target_name": "lips", "similarity": 0.979}], "id": 3626, "stable_key": "clu_2252c07e03e2dee6", "ground_truth": {"modern_name": "Lips", "confidence": "high", "type": "concept", "note": "While 'lips' are an anatomical feature, the context suggests its use as a general concept related to speaking, kissing, or the mouth, rather than a specific anatomical study. The texts are medical/psychological and discuss it in relation to outward expression."}}, {"canonical_name": "Peas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "peas", "book_id": "english_physician_1652", "name": "Peas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Peas", "Pears"], "contexts": ["garden plant, similar to Cich-Peas", "vegetable sown in gardens or fields"]}, {"entity_id": "peas", "book_id": "origin_of_species_darwin_1859", "name": "peas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["peas"], "contexts": ["plant with seeds providing nutriment", "plant seeds killed by seawater"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Peas", "target_book": "origin_of_species_darwin_1859", "target_name": "peas", "similarity": 0.989}], "id": 3627, "stable_key": "clu_a4c17efa6e14dbd9", "ground_truth": {"modern_name":