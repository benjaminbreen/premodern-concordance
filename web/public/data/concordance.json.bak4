{"source_book": "principles_of_psychology_james_1890", "source_name": "brutes", "target_book": "first_principles_spencer_1862", "target_name": "brutes", "similarity": 1.0}], "id": 5713, "stable_key": "clu_7bc08e8b57087dd5", "ground_truth": {"modern_name": "Brutes", "confidence": "high", "type": "animal", "note": "The term 'brutes' in this context refers broadly to animals, particularly in philosophical discussions about consciousness.", "wikidata_id": "Q729", "wikidata_description": "kingdom of multicellular eukaryotic organisms", "wikipedia_url": "https://en.wikipedia.org/wiki/Animal"}}, {"canonical_name": "mental conditions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mental_conditions", "book_id": "principles_of_psychology_james_1890", "name": "mental conditions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mental conditions"], "contexts": ["states of mind"]}, {"entity_id": "mental_states", "book_id": "first_principles_spencer_1862", "name": "mental states", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mental states"], "contexts": ["internal psychological conditions"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "mental conditions", "target_book": "first_principles_spencer_1862", "target_name": "mental states", "similarity": 0.926}], "id": 5714, "stable_key": "clu_2621fad273b3a96c-4", "ground_truth": {"modern_name": "Mental states", "confidence": "high", "type": "concept", "wikidata_id": "Q3968640", "wikidata_description": "state of mind of a person", "note": "The term 'thoughts and feelings' directly maps to the concept of mental states in psychology."}}, {"canonical_name": "attractions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "attractions", "book_id": "principles_of_psychology_james_1890", "name": "attractions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["attractions"], "contexts": ["forces drawing things together"]}, {"entity_id": "local_attractions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "local attractions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["local attractions"], "contexts": ["gravitational influence on plumb-line"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "attractions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "local attractions", "similarity": 0.887}], "id": 5715, "stable_key": "clu_ce0080d378911a5e", "ground_truth": {"modern_name": "Attraction (physics)", "confidence": "high", "type": "concept", "note": "The context 'gravitational influence on plumb-line' strongly suggests a physical force of attraction."}}, {"canonical_name": "Belfast", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "belfast", "book_id": "principles_of_psychology_james_1890", "name": "Belfast", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Belfast"], "contexts": ["location of Tyndall's address"]}, {"entity_id": "belfast", "book_id": "kosmos_humboldt_1845", "name": "Belfast", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Belfast"], "contexts": ["location with basaltic veins traversing chalk"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Belfast", "target_book": "kosmos_humboldt_1845", "target_name": "Belfast", "similarity": 1.0}], "id": 5716, "stable_key": "clu_cbfb91f4e55b6cd5", "ground_truth": {"modern_name": "Belfast", "confidence": "high", "type": "place", "country": "United Kingdom", "wikipedia_extract": "The Belfast Blitz consisted of four German air raids on strategic targets in the city of Belfast in Northern Ireland, in April and May 1941 during World War II, causing high casualties. The first was on the night of 7\u20138 April 1941, a small attack which probably took place only to test Belfast's defences. The next took place on Easter Tuesday, 15 April 1941, when 200 Luftwaffe bombers attacked military and manufacturing targets in the city of Belfast. Some 987 people died as a result of the bombing and 1,500 were injured. High explosive bombs predominated in this raid. Apart from those on London, this was the greatest loss of life in any night raid during the Blitz.", "wikipedia_url": "https://en.wikipedia.org/wiki/Belfast_Blitz"}}, {"canonical_name": "blow", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "blow", "book_id": "principles_of_psychology_james_1890", "name": "blow", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["blow"], "contexts": ["impact causing physical or mental shock"]}, {"entity_id": "blow", "book_id": "connexion_physical_sciences_somerville_1858", "name": "blow", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["blow"], "contexts": ["impact from hammer"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "blow", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "blow", "similarity": 1.0}], "id": 5717, "stable_key": "clu_23f1e012f38678ea", "ground_truth": {"modern_name": "Impact", "confidence": "high", "type": "concept", "note": "The contexts 'physical or mental shock' and 'impact from hammer' point to the physical concept of impact."}}, {"canonical_name": "energies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "energies", "book_id": "principles_of_psychology_james_1890", "name": "energies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["energies"], "contexts": ["capacity to do work"]}, {"entity_id": "bodily_energies", "book_id": "first_principles_spencer_1862", "name": "bodily energies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["bodily energies"], "contexts": ["physical vitality and strength"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "energies", "target_book": "first_principles_spencer_1862", "target_name": "bodily energies", "similarity": 0.882}], "id": 5718, "stable_key": "clu_69c527e3a4396406", "ground_truth": {"modern_name": "Energy", "confidence": "high", "type": "concept", "note": "The contexts 'capacity to do work' and 'physical vitality and strength' align with the modern scientific and biological understanding of energy."}}, {"canonical_name": "mechanical resultants", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mechanical_resultants", "book_id": "principles_of_psychology_james_1890", "name": "mechanical resultants", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mechanical resultants"], "contexts": ["outcome of combined mechanical forces"]}, {"entity_id": "mechanical_result", "book_id": "first_principles_spencer_1862", "name": "mechanical result", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mechanical result"], "contexts": ["change of position or motion"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "mechanical resultants", "target_book": "first_principles_spencer_1862", "target_name": "mechanical result", "similarity": 0.898}], "id": 5719, "stable_key": "clu_ccc3631fdb312057", "ground_truth": {"modern_name": "Resultant force", "confidence": "high", "type": "concept"}}, {"canonical_name": "spirit of the age", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "spirit_of_the_age", "book_id": "principles_of_psychology_james_1890", "name": "spirit of the age", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["spirit of the age"], "contexts": ["symbolic speech for collective sentiment"]}, {"entity_id": "spirit_of_the_age", "book_id": "kosmos_humboldt_1845", "name": "spirit of the age", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["spirit of the age"], "contexts": ["prevailing intellectual and cultural climate"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "spirit of the age", "target_book": "kosmos_humboldt_1845", "target_name": "spirit of the age", "similarity": 1.0}], "id": 5720, "stable_key": "clu_ac243df98f71d3a1", "ground_truth": {"modern_name": "Zeitgeist", "confidence": "high", "type": "concept", "wikidata_id": "Q211679", "wikidata_description": "intellectual fashion or dominant school of thought that typifies and influences the culture of a particular period in time"}}, {"canonical_name": "Atoms of matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "atoms_of_matter", "book_id": "principles_of_psychology_james_1890", "name": "Atoms of matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Atoms of matter"], "contexts": ["basic physical units"]}, {"entity_id": "atoms_of_matter", "book_id": "first_principles_spencer_1862", "name": "atoms of matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["atoms of matter"], "contexts": ["re-arrangement generates electricity"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Atoms of matter", "target_book": "first_principles_spencer_1862", "target_name": "atoms of matter", "similarity": 0.993}], "id": 5721, "stable_key": "clu_35840a60816d9356-2", "ground_truth": {"modern_name": "atom", "confidence": "high", "type": "chemical", "note": "Early modern texts often refer to atoms as fundamental, indivisible particles, reflecting the philosophical rather than the modern quantum mechanical understanding.", "wikidata_id": "Q9121", "wikidata_description": "smallest unit of a chemical element", "wikipedia_url": "https://en.wikipedia.org/wiki/Atom", "wikipedia_extract": "Atoms are the basic particles of the chemical elements and the fundamental building blocks of matter. An atom consists of a nucleus of protons and generally neutrons, surrounded by an electromagnetically bound swarm of electrons. The chemical elements are distinguished from each other by the number of protons that are in their atoms. For example, any atom that contains 11 protons is sodium, and any atom that contains 29 protons is copper. Atoms with the same number of protons but a different number of neutrons are called isotopes of the same element. Atoms are extremely small, typically around 100 picometers across."}}, {"canonical_name": "mental affections", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mental_affections", "book_id": "principles_of_psychology_james_1890", "name": "mental affections", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mental affections"], "contexts": ["subjective mental states"]}, {"entity_id": "affections", "book_id": "first_principles_spencer_1862", "name": "affections", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["affections"], "contexts": ["emotional states or desires"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "mental affections", "target_book": "first_principles_spencer_1862", "target_name": "affections", "similarity": 0.891}], "id": 5722, "stable_key": "clu_410fcd79eefa7aaa", "ground_truth": {"modern_name": "Mental disorders", "confidence": "high", "type": "disease", "modern_term": "Mental disorders"}}, {"canonical_name": "empirical law", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "empirical_law", "book_id": "principles_of_psychology_james_1890", "name": "empirical law", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["empirical law"], "contexts": ["law based on observation and experience"]}, {"entity_id": "empirical_laws", "book_id": "kosmos_humboldt_1845", "name": "empirical laws", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["empirical laws"], "contexts": ["laws derived from observation and experiment"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "empirical law", "target_book": "kosmos_humboldt_1845", "target_name": "empirical laws", "similarity": 0.965}], "id": 5723, "stable_key": "clu_c64472f0b1f07754", "ground_truth": {"modern_name": "Empirical law", "confidence": "high", "type": "concept", "wikidata_id": "Q3258494", "wikidata_description": "law or formula deduced from experimental facts, or validated by experience", "wikipedia_extract": "Zipf's law () is an empirical law stating that when a set of measured values is sorted in decreasing order, the value of the n-th entry is often approximately inversely proportional to n. The best-known instance of Zipf\u2019s law applies to the frequency distribution of words in a text or corpus of natural language: {\\displaystyle \\ {\\mathsf {word\\ frequency}}\\ \\propto \\ {\\frac {1}{\\ {\\mathsf {word\\ rank}}\\ }}~.} It is usually found that the most common word occurs approximately twice as often as the next common one, three times as often as the third most common, and so on. For example, in the Brown Corpus of American English text, the word \"the\" is the most frequently occurring word, and by itself accounts for nearly 7% of all word occurrences (69,971 out of slightly over 1 million). True to Zipf's law, the second-place word \"of\" accounts for slightly over 3.5% of words (36,411 occurrences), followed by \"and\" (28,852).", "wikipedia_url": "https://en.wikipedia.org/wiki/Zipf's_law"}}, {"canonical_name": "feeling centres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "feeling_centres", "book_id": "principles_of_psychology_james_1890", "name": "feeling centres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["feeling centres"], "contexts": ["brain areas for tactile sensation"]}, {"entity_id": "percipient_centres", "book_id": "first_principles_spencer_1862", "name": "percipient centres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["percipient centres"], "contexts": ["brain areas for processing perception"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "feeling centres", "target_book": "first_principles_spencer_1862", "target_name": "percipient centres", "similarity": 0.9}], "id": 5724, "stable_key": "clu_eb90ece8dd6a135f", "ground_truth": {"modern_name": "Cortical areas for sensation and perception", "confidence": "medium", "type": "concept", "note": "The terms are somewhat vague and could refer to general sensory or perceptual processing areas in the brain, not specific localized 'centers'."}}, {"canonical_name": "atom", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "atom", "book_id": "principles_of_psychology_james_1890", "name": "atom", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["atom"], "contexts": ["basic unit of matter"]}, {"entity_id": "atom", "book_id": "connexion_physical_sciences_somerville_1858", "name": "atom", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["atom"], "contexts": ["basic unit of matter with nucleus and atmosphere"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "atom", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "atom", "similarity": 1.0}], "id": 5725, "stable_key": "clu_35840a60816d9356-3", "ground_truth": {"modern_name": "atom", "confidence": "high", "type": "chemical", "note": "Early modern texts often refer to atoms as fundamental, indivisible particles, reflecting the philosophical rather than the modern quantum mechanical understanding.", "wikidata_id": "Q9121", "wikidata_description": "smallest unit of a chemical element", "wikipedia_url": "https://en.wikipedia.org/wiki/Atom", "wikipedia_extract": "Atoms are the basic particles of the chemical elements and the fundamental building blocks of matter. An atom consists of a nucleus of protons and generally neutrons, surrounded by an electromagnetically bound swarm of electrons. The chemical elements are distinguished from each other by the number of protons that are in their atoms. For example, any atom that contains 11 protons is sodium, and any atom that contains 29 protons is copper. Atoms with the same number of protons but a different number of neutrons are called isotopes of the same element. Atoms are extremely small, typically around 100 picometers across."}}, {"canonical_name": "spiritualistic opinion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "spiritualistic_opinion", "book_id": "principles_of_psychology_james_1890", "name": "spiritualistic opinion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["spiritualistic opinion"], "contexts": ["view of the soul as metaphysical entity"]}, {"entity_id": "theological_opinion", "book_id": "first_principles_spencer_1862", "name": "theological opinion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["theological opinion"], "contexts": ["beliefs about God and religion"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "spiritualistic opinion", "target_book": "first_principles_spencer_1862", "target_name": "theological opinion", "similarity": 0.916}], "id": 5726, "stable_key": "clu_dcfcd5956935d950", "ground_truth": {"modern_name": "religious belief", "confidence": "high", "type": "concept", "note": "The term 'spiritualistic opinion' in the context of James's 'Principles of Psychology' refers to beliefs that attributed mental phenomena to spiritual forces or entities, which falls under the broader category of religious or theological belief systems.", "wikidata_id": "Q1482612", "wikidata_description": "religion in the country"}}, {"canonical_name": "internal activity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "internal_activity", "book_id": "principles_of_psychology_james_1890", "name": "internal activity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["internal activity"], "contexts": ["scholastic principle of mind"]}, {"entity_id": "internal_action", "book_id": "first_principles_spencer_1862", "name": "internal action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["internal action"], "contexts": ["mental or psychological processes"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "internal activity", "target_book": "first_principles_spencer_1862", "target_name": "internal action", "similarity": 0.936}], "id": 5727, "stable_key": "clu_fd929c1afe739c3a", "ground_truth": {"modern_name": "mental process", "confidence": "high", "type": "concept", "note": "'Internal activity' and 'internal action' in these philosophical texts refer to the workings of the mind or consciousness.", "wikidata_id": "Q12047513", "wikidata_description": "concept in psychology that refers to the sequence of thoughts, emotions, and behaviors that reflect the mind\u2019s function and interaction with the environment"}}, {"canonical_name": "perceiving", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "perceiving", "book_id": "principles_of_psychology_james_1890", "name": "perceiving", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["perceiving"], "contexts": ["process of becoming aware of something"]}, {"entity_id": "perceiving_subject", "book_id": "first_principles_spencer_1862", "name": "perceiving subject", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["perceiving subject"], "contexts": ["the entity that perceives"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "perceiving", "target_book": "first_principles_spencer_1862", "target_name": "perceiving subject", "similarity": 0.881}], "id": 5728, "stable_key": "clu_00b290e22a7acc10-4", "ground_truth": {"modern_name": "Perception", "confidence": "high", "type": "concept", "wikidata_id": "Q160402", "wikidata_description": "organization, identification, and interpretation of sensory information in order to represent and understand the environment in the brain", "note": "While 'perceiving subject' refers to the entity doing the perceiving, the core concept being discussed across both instances is the act or process of perceiving."}}, {"canonical_name": "intellectual acts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "intellectual_acts", "book_id": "principles_of_psychology_james_1890", "name": "intellectual acts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["intellectual acts"], "contexts": ["mental processes involving thought and reason"]}, {"entity_id": "intellectual_activity", "book_id": "kosmos_humboldt_1845", "name": "intellectual activity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["intellectual activity"], "contexts": ["mental processes involving thought"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "intellectual acts", "target_book": "kosmos_humboldt_1845", "target_name": "intellectual activity", "similarity": 0.913}], "id": 5729, "stable_key": "clu_8643683ad87c9c4e-2", "ground_truth": {"modern_name": "Cognitive processes", "confidence": "high", "type": "concept"}}, {"canonical_name": "moral feeling", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "moral_feeling", "book_id": "principles_of_psychology_james_1890", "name": "moral feeling", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["moral feeling"], "contexts": ["sense of right and wrong"]}, {"entity_id": "moral_sentiments", "book_id": "first_principles_spencer_1862", "name": "moral sentiments", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["moral sentiments"], "contexts": ["feelings related to right and wrong"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "moral feeling", "target_book": "first_principles_spencer_1862", "target_name": "moral sentiments", "similarity": 0.932}], "id": 5730, "stable_key": "clu_39b199efc568917b", "ground_truth": {"modern_name": "Moral feeling", "confidence": "high", "type": "concept"}}, {"canonical_name": "contractions", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "contractions", "book_id": "principles_of_psychology_james_1890", "name": "contractions", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["contractions"], "contexts": ["involuntary muscle shortening"]}, {"entity_id": "contrac\u00e7\u00f5es", "book_id": "polyanthea_medicinal", "name": "Contrac\u00e7\u00f5es", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["Contrac\u00e7\u00f5es"], "contexts": ["symptom of excess acidity of pancreatic juice"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "contractions", "target_book": "polyanthea_medicinal", "target_name": "Contrac\u00e7\u00f5es", "similarity": 0.952}], "id": 5731, "stable_key": "clu_c4d8eeb16ddabbeb", "ground_truth": {"modern_name": "contractions", "confidence": "high", "type": "concept", "note": "'Contractions' and 'Contrac\u00e7\u00f5es' refer to the involuntary shortening of muscles, a common medical symptom.", "wikidata_id": "Q127006", "wikidata_description": "process in which force is generated within muscle tissue, resulting in a change in muscle geometry. Force generation involves a chemo-mechanical energy conversion step that is carried out by the actin/myosin complex activity", "wikipedia_url": "https://en.wikipedia.org/wiki/Muscle_contraction", "wikipedia_extract": "Muscle contraction is the activation of tension-generating sites within muscle cells. In physiology, muscle contraction does not necessarily mean muscle shortening because muscle tension can be produced without changes in muscle length (isometric contraction), such as when holding something heavy in the same position. The termination of muscle contraction is followed by muscle relaxation, which is a return of the muscle fibers to their low tension-generating state. For the contractions to happen, the muscle cells must rely on the change in action of two types of filament: thin and thick filaments. The major constituent of thin filaments is a chain formed by helical coiling of two strands of actin, and thick filaments dominantly consist of chains of the motor-protein myosin. Together, these two filaments form myofibrils - the basic functional organelles in the skeletal muscle system."}}, {"canonical_name": "sinapisme", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sinapisme", "book_id": "principles_of_psychology_james_1890", "name": "sinapisme", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["sinapisme"], "contexts": ["medical application for skin irritation"]}, {"entity_id": "senapismi", "book_id": "ricettario_fiorentino_1597", "name": "Senapismi", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Senapismi"], "contexts": ["preparation for mustard plasters"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "sinapisme", "target_book": "ricettario_fiorentino_1597", "target_name": "Senapismi", "similarity": 0.908}], "id": 5732, "stable_key": "clu_b86113fc7afd1967", "ground_truth": {"modern_name": "sinapism", "confidence": "high", "type": "substance", "note": "'Sinapisme' and 'Senapismi' refer to a medicinal plaster made with mustard, a common historical remedy.", "wikidata_id": "Q1862320", "wikidata_description": "medicinal poultice"}}, {"canonical_name": "Algiers", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "algiers", "book_id": "principles_of_psychology_james_1890", "name": "Algiers", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Algiers"], "contexts": ["location mentioned in a subject's delusion"]}, {"entity_id": "algiers", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Algiers", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Algiers"], "contexts": ["French officers observed light phenomenon"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Algiers", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Algiers", "similarity": 1.0}], "id": 5733, "stable_key": "clu_acaa2b6acc2cca9c", "ground_truth": {"modern_name": "Algiers", "confidence": "high", "type": "place", "country": "Algeria", "wikidata_id": "Q3561", "wikidata_description": "capital city of Algeria", "wikipedia_extract": "Algiers is the capital city of Algeria, located on the Mediterranean Sea in the north-central portion of the country. In 2025, an estimated 4.325 million people resided within the urban area. Algiers is the largest city in Algeria, the third-largest city on the Mediterranean, the sixth-largest city in the Arab world, and the 29th-largest city in Africa by population. Algiers is the capital of the Algiers Province; it extends over many communes without having its own separate governing body. It extends along the Bay of Algiers surrounded by the Mitidja Plain and major mountain ranges. Its favorable location made it the center of Ottoman and French influences for the region, shaping it to be a diverse metropolis.", "wikipedia_url": "https://en.wikipedia.org/wiki/Algiers"}}, {"canonical_name": "dynamically", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dynamically", "book_id": "principles_of_psychology_james_1890", "name": "dynamically", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dynamically"], "contexts": ["related to action and effect"]}, {"entity_id": "dynamic", "book_id": "connexion_physical_sciences_somerville_1858", "name": "dynamic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dynamic"], "contexts": ["surrounding the terrestrial globe"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "dynamically", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "dynamic", "similarity": 0.899}], "id": 5734, "stable_key": "clu_9c174c4363d6b051", "ground_truth": {"modern_name": "Dynamically", "confidence": "high", "type": "concept", "wikidata_id": "Q1268978", "wikidata_description": "type system paradigm in which objects' types are enforced at runtime"}}, {"canonical_name": "mortal", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mortal", "book_id": "principles_of_psychology_james_1890", "name": "mortal", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["mortal"], "contexts": ["human being subject to death"]}, {"entity_id": "mortos", "book_id": "polyanthea_medicinal", "name": "mortos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["mortos"], "contexts": ["dead people"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "mortal", "target_book": "polyanthea_medicinal", "target_name": "mortos", "similarity": 0.871}], "id": 5735, "stable_key": "clu_605ec8cdf0359f79-3", "ground_truth": {"modern_name": "Individuals", "confidence": "high", "type": "concept", "note": "While 'individuals' refers to distinct beings, in a scientific context, it often functions as a concept referring to distinct units of observation or analysis rather than a specific group of people.", "wikidata_id": "Q5", "wikidata_description": "any single member of Homo sapiens, unique extant species of the genus Homo", "wikipedia_url": "https://en.wikipedia.org/wiki/Human", "description": "General term for human beings, often in the context of medical treatment.", "wikipedia_extract": "Humans (Homo sapiens, meaning \"thinking man\" or \"wise man\") are the most common and widespread species of primate, and the only extant species of the genus Homo. They are great apes characterized by hairlessness, obligate bipedality, manual dexterity with opposable thumbs, precision grip, and high intelligence. Humans have large brains compared to body size (a high encephalization quotient), enabling more advanced cognitive skills that facilitate successful adaptation to varied environments, development of sophisticated tools, and formation of complex social structures and civilizations. Humans possess a disproportionately larger volume of both cerebral white matter and gray matter present in the prefrontal cortex (PFC) than any other primate species, which facilitated the expansion of higher-order executive functions. Humans are highly social, with individual humans tending to belong to a multi-layered network of distinct social groups \u2013 from families and peer groups to corporations and political states. As such, social interactions between humans have established a wide variety of values, social norms, languages, and traditions (collectively termed institutions), each of which bolsters human society."}}, {"canonical_name": "article", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "article", "book_id": "principles_of_psychology_james_1890", "name": "article", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["article"], "contexts": ["grammatical word like 'the'"]}, {"entity_id": "articles", "book_id": "first_principles_spencer_1862", "name": "articles", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["articles"], "contexts": ["determiners like 'a', 'an', 'the'"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "article", "target_book": "first_principles_spencer_1862", "target_name": "articles", "similarity": 0.836}], "id": 5736, "stable_key": "clu_3948af3424d6529a", "ground_truth": {"modern_name": "determiner", "confidence": "high", "type": "concept", "note": "Refers to grammatical articles like 'a', 'an', 'the'."}}, {"canonical_name": "Amer. Jour. of Science", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "amer__jour__of_science", "book_id": "principles_of_psychology_james_1890", "name": "Amer. Jour. of Science", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Amer. Jour. of Science"], "contexts": ["scientific journal"]}, {"entity_id": "amer__journ__of_science", "book_id": "kosmos_humboldt_1845", "name": "Amer. Journ. of Science", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Amer. Journ. of Science"], "contexts": ["published description of comet nucleus and tail"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Amer. Jour. of Science", "target_book": "kosmos_humboldt_1845", "target_name": "Amer. Journ. of Science", "similarity": 0.975}], "id": 5737, "stable_key": "clu_cbae61e9be0bfb1f", "ground_truth": {"modern_name": "American Journal of Science", "confidence": "high", "type": "text", "note": "A historical scientific journal."}}, {"canonical_name": "C. Wolf", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "c__wolf", "book_id": "principles_of_psychology_james_1890", "name": "C. Wolf", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["C. Wolf"], "contexts": ["philosopher cited for rational psychology"]}, {"entity_id": "wolf", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Wolf", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Wolf"], "contexts": ["Professor, computed solar heat variation periods"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "C. Wolf", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Wolf", "similarity": 0.874}], "id": 5738, "stable_key": "clu_83fcefd150194754", "ground_truth": {"modern_name": "Christian Wolff", "confidence": "high", "type": "person", "birth_year": 1679, "death_year": 1754, "description": "German philosopher, philosopher of rational psychology", "note": "The context of 'rational psychology' strongly points to Christian Wolff.", "wikidata_id": "Q76510", "wikidata_description": "German philosopher (1679\u20131754)"}}, {"canonical_name": "nerve-action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "nerve-action", "book_id": "principles_of_psychology_james_1890", "name": "nerve-action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["nerve-action"], "contexts": ["activity of nerves"]}, {"entity_id": "nervous_activity", "book_id": "first_principles_spencer_1862", "name": "nervous activity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["nervous activity"], "contexts": ["stimulation of nerves"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "nerve-action", "target_book": "first_principles_spencer_1862", "target_name": "nervous activity", "similarity": 0.898}], "id": 5739, "stable_key": "clu_8cab550f48a87211-2", "ground_truth": {"modern_name": "Nerve activity", "confidence": "high", "type": "concept"}}, {"canonical_name": "excluded middle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "excluded_middle", "book_id": "principles_of_psychology_james_1890", "name": "excluded middle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["excluded middle"], "contexts": ["logical principle"]}, {"entity_id": "excluded_middle", "book_id": "first_principles_spencer_1862", "name": "excluded middle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["excluded middle"], "contexts": ["logical principle"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "excluded middle", "target_book": "first_principles_spencer_1862", "target_name": "excluded middle", "similarity": 1.0}], "id": 5740, "stable_key": "clu_5277c3239dce8b4b", "ground_truth": {"modern_name": "Law of Excluded Middle", "confidence": "high", "type": "concept", "wikidata_id": "Q468422", "wikidata_description": "logical principle stating that for every proposition, either it or its negation is true", "wikipedia_url": "https://en.wikipedia.org/wiki/Law_of_excluded_middle", "wikipedia_extract": "In logic, the semantic principle (or law) of bivalence states that every declarative sentence expressing a proposition (of a theory under inspection) has exactly one truth value, either true or false. A logic satisfying this principle is called a two-valued logic or bivalent logic. In formal logic, the principle of bivalence becomes a property that a semantics may or may not possess. It is not the same as the law of excluded middle, however, and a semantics may satisfy that law without being bivalent. The principle of bivalence is studied in philosophical logic to address the question of which natural-language statements have a well-defined truth value. Sentences that predict events in the future, and sentences that seem open to interpretation, are particularly difficult for philosophers who hold that the principle of bivalence applies to all declarative natural-language statements."}}, {"canonical_name": "object of the thought", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "object_of_the_thought", "book_id": "principles_of_psychology_james_1890", "name": "object of the thought", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["object of the thought"], "contexts": ["content or focus of a mental idea"]}, {"entity_id": "object_of_thought", "book_id": "first_principles_spencer_1862", "name": "object of thought", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["object of thought"], "contexts": ["antithesis of subject"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "object of the thought", "target_book": "first_principles_spencer_1862", "target_name": "object of thought", "similarity": 0.988}], "id": 5741, "stable_key": "clu_f51b446ba027009a", "ground_truth": {"modern_name": "object of thought", "confidence": "high", "type": "concept"}}, {"canonical_name": "mood", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mood", "book_id": "principles_of_psychology_james_1890", "name": "mood", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mood"], "contexts": ["emotional state"]}, {"entity_id": "mood", "book_id": "first_principles_spencer_1862", "name": "mood", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mood"], "contexts": ["grammatical expression of speaker's attitude"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "mood", "target_book": "first_principles_spencer_1862", "target_name": "mood", "similarity": 1.0}], "id": 5742, "stable_key": "clu_cf4baa840f786eed", "ground_truth": {"modern_name": "Mood", "confidence": "high", "type": "concept", "wikidata_id": "Q188638", "wikidata_description": "any of various disorders characterised primarily by disturbance in an individual's mood", "wikipedia_url": "https://en.wikipedia.org/wiki/Mood%20disorder"}}, {"canonical_name": "vocabulary", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "vocabulary", "book_id": "principles_of_psychology_james_1890", "name": "vocabulary", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vocabulary"], "contexts": ["set of words used in a language"]}, {"entity_id": "vocabulary", "book_id": "first_principles_spencer_1862", "name": "vocabulary", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vocabulary"], "contexts": ["limited for peasant"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "vocabulary", "target_book": "first_principles_spencer_1862", "target_name": "vocabulary", "similarity": 1.0}], "id": 5743, "stable_key": "clu_c3907d859810940f", "ground_truth": {"modern_name": "vocabulary", "confidence": "high", "type": "concept"}}, {"canonical_name": "intercourse", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "intercourse", "book_id": "principles_of_psychology_james_1890", "name": "intercourse", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["intercourse"], "contexts": ["communication and social interaction"]}, {"entity_id": "intercourse", "book_id": "first_principles_spencer_1862", "name": "intercourse", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["intercourse"], "contexts": ["social interaction and communication"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "intercourse", "target_book": "first_principles_spencer_1862", "target_name": "intercourse", "similarity": 1.0}], "id": 5744, "stable_key": "clu_f3d59a9a958825bf", "ground_truth": {"modern_name": "social interaction", "confidence": "high", "type": "concept", "wikidata_id": "Q609298", "wikidata_description": "interactions between two or more individuals (more narrowly humans)"}}, {"canonical_name": "inanimate", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "inanimate", "book_id": "principles_of_psychology_james_1890", "name": "inanimate", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["inanimate"], "contexts": ["not alive"]}, {"entity_id": "inanimate_things", "book_id": "connexion_physical_sciences_somerville_1858", "name": "inanimate things", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["inanimate things"], "contexts": ["non-living objects"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "inanimate", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "inanimate things", "similarity": 0.935}], "id": 5745, "stable_key": "clu_d61ade84ccdeecae", "ground_truth": {"modern_name": "inanimate", "confidence": "high", "type": "concept", "wikidata_id": "Q51927539", "wikidata_description": "grammatical and/or semantic category of nouns"}}, {"canonical_name": "annihilation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "annihilation", "book_id": "principles_of_psychology_james_1890", "name": "annihilation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["annihilation"], "contexts": ["complete destruction"]}, {"entity_id": "annihilation", "book_id": "first_principles_spencer_1862", "name": "annihilation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["annihilation"], "contexts": ["idea of matter ceasing to exist"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "annihilation", "target_book": "first_principles_spencer_1862", "target_name": "annihilation", "similarity": 1.0}], "id": 5746, "stable_key": "clu_a94c4aecd666840e", "ground_truth": {"modern_name": "annihilation", "confidence": "high", "type": "concept"}}, {"canonical_name": "symbols", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "symbols", "book_id": "principles_of_psychology_james_1890", "name": "symbols", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["symbols"], "contexts": ["representations of ideas"]}, {"entity_id": "symbols", "book_id": "kosmos_humboldt_1845", "name": "symbols", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["symbols"], "contexts": ["signs representing ideas"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "symbols", "target_book": "kosmos_humboldt_1845", "target_name": "symbols", "similarity": 1.0}], "id": 5747, "stable_key": "clu_8c2d13804001ae94", "ground_truth": {"modern_name": "symbols", "confidence": "high", "type": "concept", "wikidata_id": "Q3241972", "wikidata_description": "symbol or sign (concept unrelated to computing)"}}, {"canonical_name": "draught", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "draught", "book_id": "principles_of_psychology_james_1890", "name": "draught", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["draught"], "contexts": ["pulling heavy loads"]}, {"entity_id": "draught", "book_id": "first_principles_spencer_1862", "name": "draught", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["draught"], "contexts": ["pulling of a load"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "draught", "target_book": "first_principles_spencer_1862", "target_name": "draught", "similarity": 1.0}], "id": 5748, "stable_key": "clu_6f7e52ec95df7a38", "ground_truth": {"modern_name": "Draft", "confidence": "high", "type": "concept", "note": "While 'draught' can refer to a gulp of liquid, in the context of 'pulling heavy loads' and 'pulling of a load', it refers to a force or movement, often in the context of mechanics or physical exertion.", "wikidata_id": "Q31603", "wikidata_description": "process used to allocate certain players to sports teams", "wikipedia_url": "https://en.wikipedia.org/wiki/Draft_%28boating%29", "wikipedia_extract": "The NBA draft is an annual National Basketball Association's (NBA) event, dating back to 1947, in which the teams in the league draft players to join their organizations who are eligible and who declare for the draft. The current NBA consists of 30 teams, and all thirty teams have at least one draft pick throughout the two draft rounds. Historically, the vast majority of players drafted into the NBA are college basketball players. It is now common for players to also be drafted from international professional leagues, the G League Ignite team, and youth professional basketball leagues. College players who have finished their four-year college eligibility are automatically eligible for selection, while the underclassmen have to declare their eligibility and give up their remaining college eligibility. International players who are at least 22 years old are automatically eligible for selection, while the players younger than 22 have to declare their eligibility."}}, {"canonical_name": "psychic constitution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "psychic_constitution", "book_id": "principles_of_psychology_james_1890", "name": "psychic constitution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["psychic constitution"], "contexts": ["mental makeup of a section"]}, {"entity_id": "mental_constitution", "book_id": "first_principles_spencer_1862", "name": "mental constitution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mental constitution"], "contexts": ["innate structure of the mind"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "psychic constitution", "target_book": "first_principles_spencer_1862", "target_name": "mental constitution", "similarity": 0.944}], "id": 5749, "stable_key": "clu_8cc7f4fd28e177a5", "ground_truth": {"modern_name": "mental constitution", "confidence": "high", "type": "concept"}}, {"canonical_name": "attitude", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "attitude", "book_id": "principles_of_psychology_james_1890", "name": "attitude", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["attitude"], "contexts": ["typical posture of an object"]}, {"entity_id": "attitude_of_mind", "book_id": "first_principles_spencer_1862", "name": "attitude of mind", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["attitude of mind"], "contexts": ["mental disposition during discussion"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "attitude", "target_book": "first_principles_spencer_1862", "target_name": "attitude of mind", "similarity": 0.925}], "id": 5750, "stable_key": "clu_75ab9c5c1a8830f6", "ground_truth": {"modern_name": "attitude", "confidence": "high", "type": "concept"}}, {"canonical_name": "worm", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "worm", "book_id": "principles_of_psychology_james_1890", "name": "worm", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["worm"], "contexts": ["contrasts suffering self with universe"]}, {"entity_id": "worms", "book_id": "first_principles_spencer_1862", "name": "worms", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["worms"], "contexts": ["lower members of Annulosa with many segments"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "worm", "target_book": "first_principles_spencer_1862", "target_name": "worms", "similarity": 0.961}], "id": 5751, "stable_key": "clu_d7d19b3a62fdbace", "ground_truth": {"modern_name": "Worms", "confidence": "high", "type": "animal", "note": "In early modern texts, 'worms' could refer to parasitic organisms within the body or to various invertebrate animals such as annelids or even insect larvae. Given the context of 'contrasts suffering self with universe', it's likely referring to both parasitic and free-living invertebrates, encompassing a broad category.", "wikidata_id": "Q47253", "wikidata_description": "any animal with a long, pipe-like body and no limbs"}}, {"canonical_name": "sentiments-sensations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sentiments-sensations", "book_id": "principles_of_psychology_james_1890", "name": "sentiments-sensations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sentiments-sensations"], "contexts": ["French term for sensation-feelings"]}, {"entity_id": "sentiments", "book_id": "first_principles_spencer_1862", "name": "sentiments", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sentiments"], "contexts": ["feelings and emotions"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "sentiments-sensations", "target_book": "first_principles_spencer_1862", "target_name": "sentiments", "similarity": 0.947}], "id": 5752, "stable_key": "clu_febd09a3d137e300", "ground_truth": {"modern_name": "Sentiments and sensations", "confidence": "high", "type": "concept", "note": "The French term 'sentiments' is directly translated and understood as feelings and emotions, often in conjunction with sensations."}}, {"canonical_name": "Max M\u00fcller", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "max_m\u00fcller", "book_id": "principles_of_psychology_james_1890", "name": "Max M\u00fcller", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Max M\u00fcller"], "contexts": ["scholar on science of thought"]}, {"entity_id": "max_m\u00fcller", "book_id": "first_principles_spencer_1862", "name": "Max M\u00fcller", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Max M\u00fcller"], "contexts": ["linguist, proposed language origin theory"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Max M\u00fcller", "target_book": "first_principles_spencer_1862", "target_name": "Max M\u00fcller", "similarity": 1.0}], "id": 5753, "stable_key": "clu_6b0ecf03a7b0587f", "ground_truth": {"modern_name": "Max M\u00fcller", "confidence": "high", "type": "person", "birth_year": 1823, "death_year": 1900, "description": "German-British scholar, linguist, and orientalist"}}, {"canonical_name": "concrete", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "concrete", "book_id": "principles_of_psychology_james_1890", "name": "concrete", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["concrete"], "contexts": ["view of spiritual self as a whole"]}, {"entity_id": "concrete", "book_id": "first_principles_spencer_1862", "name": "concrete", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["concrete"], "contexts": ["physical, tangible things"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "concrete", "target_book": "first_principles_spencer_1862", "target_name": "concrete", "similarity": 1.0}], "id": 5754, "stable_key": "clu_f661403bd5fb1618", "ground_truth": {"modern_name": "concrete", "confidence": "high", "type": "concept", "note": "Refers to the tangible, physical aspects contrasted with the abstract or spiritual.", "wikidata_id": "Q223557", "wikidata_description": "singular aggregation of tangible substance(s) such as matter or radiation, with overall properties"}}, {"canonical_name": "fictions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fictions", "book_id": "principles_of_psychology_james_1890", "name": "fictions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fictions"], "contexts": ["imaginary or invented things"]}, {"entity_id": "fictions", "book_id": "first_principles_spencer_1862", "name": "fictions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fictions"], "contexts": ["unverifiable and illusory mental representations"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "fictions", "target_book": "first_principles_spencer_1862", "target_name": "fictions", "similarity": 1.0}], "id": 5755, "stable_key": "clu_c2823fda251155a3", "ground_truth": {"modern_name": "fiction", "confidence": "high", "type": "concept", "note": "Refers to imaginary or invented things, or unverifiable mental representations."}}, {"canonical_name": "negating", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "negating", "book_id": "principles_of_psychology_james_1890", "name": "negating", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["negating"], "contexts": ["act of denying or disagreeing"]}, {"entity_id": "negation", "book_id": "first_principles_spencer_1862", "name": "negation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["negation"], "contexts": ["denial or opposite of something"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "negating", "target_book": "first_principles_spencer_1862", "target_name": "negation", "similarity": 0.881}], "id": 5756, "stable_key": "clu_3712a0e0f2de11ee", "ground_truth": {"modern_name": "negation", "confidence": "high", "type": "concept", "note": "Refers to the act of denying or disagreeing, or the state of being the opposite."}}, {"canonical_name": "shame", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "shame", "book_id": "principles_of_psychology_james_1890", "name": "shame", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["shame"], "contexts": ["feeling of humiliation or distress"]}, {"entity_id": "shame", "book_id": "first_principles_spencer_1862", "name": "shame", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["shame"], "contexts": ["feeling of humiliation"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "shame", "target_book": "first_principles_spencer_1862", "target_name": "shame", "similarity": 1.0}], "id": 5757, "stable_key": "clu_5943669f3986aabb", "ground_truth": {"modern_name": "Shame", "confidence": "high", "type": "concept", "note": "This cluster refers to the emotion of shame and related expressions.", "wikidata_id": "Q152282", "wikidata_description": "a self-conscious emotion associated with feelings of worthlessness or humiliation", "wikipedia_url": "https://en.wikipedia.org/wiki/Shame", "wikipedia_extract": "Shame is an unpleasant self-conscious and moral emotion often associated with negative self-evaluation; motivation to quit; and feelings of pain, exposure, distrust, powerlessness, and worthlessness. Shame is a discrete, basic emotion, described as a moral or social emotion that drives people to hide or deny their wrongdoings. Moral emotions are emotions that have an influence on a person's decision-making skills and monitors different social behaviors. The focus of shame is on the self or the individual with respect to a perceived audience. It can bring about profound feelings of deficiency, defeat, inferiority, unworthiness, or self-loathing. Our attention turns inward; we isolate from our surroundings and withdraw into closed-off self-absorption."}}, {"canonical_name": "mortification", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mortification", "book_id": "principles_of_psychology_james_1890", "name": "mortification", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mortification"], "contexts": ["extreme embarrassment or shame"]}, {"entity_id": "mortifica\u00e7\u00e3o", "book_id": "polyanthea_medicinal", "name": "mortifica\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mortifica\u00e7\u00e3o"], "contexts": ["ascetic practice"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "mortification", "target_book": "polyanthea_medicinal", "target_name": "mortifica\u00e7\u00e3o", "similarity": 0.986}], "id": 5758, "stable_key": "clu_c22da4613695c7c7", "ground_truth": {"modern_name": "mortification", "confidence": "high", "type": "concept", "note": "The context in James's 'Principles of Psychology' points towards extreme embarrassment or shame, a psychological concept. The Portuguese 'mortifica\u00e7\u00e3o' in a medicinal context could refer to gangrene or necrosis (literal death of tissue), but the given context leans more towards the psychological. Given the mixed contexts, the primary psychological meaning is chosen."}}, {"canonical_name": "self-satisfaction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "self-satisfaction", "book_id": "principles_of_psychology_james_1890", "name": "self-satisfaction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["self-satisfaction"], "contexts": ["feeling of contentment with oneself"]}, {"entity_id": "self-satisfaction", "book_id": "first_principles_spencer_1862", "name": "self-satisfaction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["self-satisfaction"], "contexts": ["fulfillment of one's own desires"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "self-satisfaction", "target_book": "first_principles_spencer_1862", "target_name": "self-satisfaction", "similarity": 1.0}], "id": 5759, "stable_key": "clu_b245e834eb9b7abb", "ground_truth": {"modern_name": "self-satisfaction", "confidence": "high", "type": "concept", "wikidata_id": "Q17992551", "wikidata_description": ""}}, {"canonical_name": "admiration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "admiration", "book_id": "principles_of_psychology_james_1890", "name": "admiration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["admiration"], "contexts": ["respect and approval"]}, {"entity_id": "admiration", "book_id": "kosmos_humboldt_1845", "name": "admiration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["admiration"], "contexts": ["feeling of wonder"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "admiration", "target_book": "kosmos_humboldt_1845", "target_name": "admiration", "similarity": 1.0}], "id": 5760, "stable_key": "clu_6b26f3a8a9ffddb2", "ground_truth": {"modern_name": "admiration", "confidence": "high", "type": "concept", "wikidata_id": "Q2824657", "wikidata_description": "social emotion"}}, {"canonical_name": "African explorer", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "african_explorer", "book_id": "principles_of_psychology_james_1890", "name": "African explorer", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["African explorer"], "contexts": ["one who explores the continent of Africa"]}, {"entity_id": "african_travellers", "book_id": "connexion_physical_sciences_somerville_1858", "name": "African travellers", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["African travellers"], "contexts": ["people who travel in Africa"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "African explorer", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "African travellers", "similarity": 0.853}], "id": 5761, "stable_key": "clu_48523e8598ccc38b", "ground_truth": {"modern_name": "African explorer", "confidence": "medium", "type": "person", "description": "Individual who undertakes expeditions to explore Africa.", "note": "This is a descriptive category rather than a specific individual. The term 'African explorers' or 'African travellers' in early modern texts often referred to a group of individuals known for their journeys into the interior of Africa. Without specific names, identifying individual modern referents is impossible. The description reflects the general role.", "wikidata_id": "Q135794063", "wikidata_description": "Commemorative medals \u203a Personality medals - Milled - German East Africa"}}, {"canonical_name": "despotism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "despotism", "book_id": "principles_of_psychology_james_1890", "name": "despotism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["despotism"], "contexts": ["exercise of absolute power"]}, {"entity_id": "despotism", "book_id": "first_principles_spencer_1862", "name": "despotism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["despotism"], "contexts": ["rule by a single absolute authority"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "despotism", "target_book": "first_principles_spencer_1862", "target_name": "despotism", "similarity": 1.0}], "id": 5762, "stable_key": "clu_c1e486e24b264b07", "ground_truth": {"modern_name": "dictation", "confidence": "medium", "type": "concept", "note": "While 'dictation' in the sense of speaking for writing is a valid interpretation, the juxtaposed 'despotism' from Spencer's text suggests a possible metaphorical use of 'dictation' referring to absolute rule or an imposed authority. Given the ambiguity and the time frame, 'dictation' as a concept related to communication and authority is chosen.", "wikidata_id": "Q1087138", "wikidata_description": "transcription of spoken text", "wikipedia_url": "https://en.wikipedia.org/wiki/Dictation%20%28exercise%29", "wikipedia_extract": "Dictation is the transcription of spoken text: one person who is \"dictating\" speaks and another who is \"taking dictation\" writes down the words as they are spoken. Among speakers of several languages, dictation is used as a test of language skill, similar to spelling bees in the English-speaking world. Secondary to teaching language skills, the exercise of dictation has also been used to introduce students to literary works, and to instill morals. Dictation has also been used in an attempt to capture endangered or dying languages, as in the case of Victoria Howard, a Chinook speaker who dictated songs and stories to Melville Jacobs. The word was first used in English in 1624, in the sense \"written material for dictating or transcribing\" (for example, an important manuscript or book passage). It originated from the Latin word dict\u0101ti\u014d (in its accusative form dict\u0101ti\u014dnem), the act of the verb dict\u0101re (\"to say repeatedly\", \"to say words for transcription\", \"to command\"), which is the frequentative of d\u012bcere (\"to utter\", \"to talk\") and the root of other Latinate English-words such as diction, dictionary, dictator and dictate."}}, {"canonical_name": "good fame", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "good_fame", "book_id": "principles_of_psychology_james_1890", "name": "good fame", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["good fame"], "contexts": ["reputation for good deeds"]}, {"entity_id": "fama_commum", "book_id": "coloquios_da_orta_1563", "name": "fama commum", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fama commum"], "contexts": ["common opinion"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "good fame", "target_book": "coloquios_da_orta_1563", "target_name": "fama commum", "similarity": 0.921}], "id": 5763, "stable_key": "clu_46e73b50cbf777c0", "ground_truth": {"modern_name": "Reputation", "confidence": "high", "type": "concept", "note": "The cluster encompasses concepts of public recognition, good deeds, and common opinion, all falling under the umbrella of reputation.", "wikipedia_extract": "Reputation management, refers to the influencing, controlling, enhancing, or concealing of an individual's or group's reputation. It is a marketing technique used to modify a person's or a company's reputation in a positive way. The growth of the internet and social media led to growth of reputation management companies, with search results as a core part of a client's reputation. Online reputation management (ORM) involves overseeing and influencing the search engine results related to products and services. Ethical grey areas include mug shot removal sites, astroturfing customer review sites, censoring complaints, and using search engine optimization tactics to influence results. In other cases, the ethical lines are clear; some reputation management companies are closely connected to websites that publish unverified and libelous statements about people.", "wikipedia_url": "https://en.wikipedia.org/wiki/Reputation_management"}}, {"canonical_name": "Psychologische Analysen", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "psychologische_analysen", "book_id": "principles_of_psychology_james_1890", "name": "Psychologische Analysen", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Psychologische Analysen"], "contexts": ["work discussing the 'pure Ego'"]}, {"entity_id": "psychological_analysis", "book_id": "first_principles_spencer_1862", "name": "psychological analysis", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["psychological analysis"], "contexts": ["analysis of mental experiences"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Psychologische Analysen", "target_book": "first_principles_spencer_1862", "target_name": "psychological analysis", "similarity": 0.927}], "id": 5764, "stable_key": "clu_14210172c6c655f3", "ground_truth": {"modern_name": "Psychological Analysis", "confidence": "high", "type": "concept", "note": "Refers to the study and analysis of mental processes and experiences.", "wikidata_id": "Q7256412", "wikidata_description": "American magazine and media organization", "wikipedia_extract": "Psychoanalysis is a set of theories and techniques to discover unconscious processes and their influence on conscious thought, emotion and behavior. Based on dream interpretation, psychoanalysis is also a talk therapy method for treating mental disorders. Established in the early 1890s by Sigmund Freud, it takes into account Darwin's theory of evolution, neurology findings, ethnology reports, and, in some respects, the clinical research of his mentor Josef Breuer. Freud developed and refined the theory and practice of psychoanalysis until his death in 1939. In an encyclopedic article, he identified four foundational beliefs: \"the assumption that there are unconscious mental processes, the recognition of the theory of repression and resistance, the appreciation of the importance of sexuality and of the Oedipus complex.\" Two of Freud's early colleagues, Alfred Adler and Carl Jung, soon developed their own methods, individual and analytical psychology, respectively, which he said were not forms of psychoanalysis. After the author's death, neo-Freudian thinkers like Erich Fromm, Karen Horney and Harry Stack Sullivan created some subfields.", "wikipedia_url": "https://en.wikipedia.org/wiki/Psychoanalysis"}}, {"canonical_name": "bodily warmth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bodily_warmth", "book_id": "principles_of_psychology_james_1890", "name": "bodily warmth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bodily warmth"], "contexts": ["sensation of heat from a body"]}, {"entity_id": "bodily_heat", "book_id": "first_principles_spencer_1862", "name": "bodily heat", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bodily heat"], "contexts": ["internal temperature of the body"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "bodily warmth", "target_book": "first_principles_spencer_1862", "target_name": "bodily heat", "similarity": 0.932}], "id": 5765, "stable_key": "clu_e585de4f998189ef", "ground_truth": {"modern_name": "Body temperature", "confidence": "high", "type": "concept", "wikidata_id": "Q190259", "wikidata_description": "ability of an organism to keep its body temperature within certain boundaries"}}, {"canonical_name": "Kantian Philosophy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "kantian_philosophy", "book_id": "principles_of_psychology_james_1890", "name": "Kantian Philosophy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Kantian Philosophy"], "contexts": ["philosophy of Immanuel Kant"]}, {"entity_id": "kantian_doctrine", "book_id": "first_principles_spencer_1862", "name": "Kantian doctrine", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Kantian doctrine"], "contexts": ["philosophical doctrine about space and time"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Kantian Philosophy", "target_book": "first_principles_spencer_1862", "target_name": "Kantian doctrine", "similarity": 0.884}], "id": 5766, "stable_key": "clu_be4ca133903c6e2c", "ground_truth": {"modern_name": "Kantian Philosophy", "confidence": "high", "type": "concept", "wikidata_id": "Q128820042", "wikidata_description": "scholarly article"}}, {"canonical_name": "Noumenon", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "noumenon", "book_id": "principles_of_psychology_james_1890", "name": "Noumenon", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Noumenon"], "contexts": ["unknowable reality beyond phenomena"]}, {"entity_id": "noumenon", "book_id": "first_principles_spencer_1862", "name": "Noumenon", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Noumenon"], "contexts": ["thing-in-itself, reality behind appearances"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Noumenon", "target_book": "first_principles_spencer_1862", "target_name": "Noumenon", "similarity": 1.0}], "id": 5767, "stable_key": "clu_b1996283094c0091", "ground_truth": {"modern_name": "Noumenon", "confidence": "high", "type": "concept", "note": "Philosophical concept from Kantian philosophy.", "wikidata_id": "Q239581", "wikidata_description": "in philosophy, a posited object or event that exists independently of human sense and/or concept, unlike a phenomenon"}}, {"canonical_name": "phenomenon of consciousness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "phenomenon_of_consciousness", "book_id": "principles_of_psychology_james_1890", "name": "phenomenon of consciousness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["phenomenon of consciousness"], "contexts": ["observable mental event"]}, {"entity_id": "phenomena_of_consciousness", "book_id": "first_principles_spencer_1862", "name": "phenomena of consciousness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["phenomena of consciousness"], "contexts": ["observable aspects of awareness"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "phenomenon of consciousness", "target_book": "first_principles_spencer_1862", "target_name": "phenomena of consciousness", "similarity": 0.951}], "id": 5768, "stable_key": "clu_62288444643ea6f2", "ground_truth": {"modern_name": "Phenomena of consciousness", "confidence": "high", "type": "concept", "wikidata_id": "Q4313500", "wikidata_description": "medical condition that inhibits consciousness, sprituality", "wikipedia_url": "https://en.wikipedia.org/wiki/Disorder%20of%20consciousness"}}, {"canonical_name": "perceived object", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "perceived_object", "book_id": "principles_of_psychology_james_1890", "name": "perceived object", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["perceived object"], "contexts": ["thing that is sensed"]}, {"entity_id": "perceived_object", "book_id": "first_principles_spencer_1862", "name": "perceived object", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["perceived object"], "contexts": ["the entity that is perceived"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "perceived object", "target_book": "first_principles_spencer_1862", "target_name": "perceived object", "similarity": 1.0}], "id": 5769, "stable_key": "clu_854cb61aeceb2f1a", "ground_truth": {"modern_name": "Perceived object", "confidence": "high", "type": "concept", "wikidata_id": "Q51984184", "wikidata_description": "scientific article published in February 2007"}}, {"canonical_name": "personage", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "personage", "book_id": "principles_of_psychology_james_1890", "name": "personage", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["personage"], "contexts": ["a distinguished person"]}, {"entity_id": "person", "book_id": "connexion_physical_sciences_somerville_1858", "name": "person", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["person"], "contexts": ["human individual"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "personage", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "person", "similarity": 0.93}], "id": 5770, "stable_key": "clu_605ec8cdf0359f79-4", "ground_truth": {"modern_name": "Individuals", "confidence": "high", "type": "concept", "note": "While 'individuals' refers to distinct beings, in a scientific context, it often functions as a concept referring to distinct units of observation or analysis rather than a specific group of people.", "wikidata_id": "Q5", "wikidata_description": "any single member of Homo sapiens, unique extant species of the genus Homo", "wikipedia_url": "https://en.wikipedia.org/wiki/Human", "description": "General term for human beings, often in the context of medical treatment.", "wikipedia_extract": "Humans (Homo sapiens, meaning \"thinking man\" or \"wise man\") are the most common and widespread species of primate, and the only extant species of the genus Homo. They are great apes characterized by hairlessness, obligate bipedality, manual dexterity with opposable thumbs, precision grip, and high intelligence. Humans have large brains compared to body size (a high encephalization quotient), enabling more advanced cognitive skills that facilitate successful adaptation to varied environments, development of sophisticated tools, and formation of complex social structures and civilizations. Humans possess a disproportionately larger volume of both cerebral white matter and gray matter present in the prefrontal cortex (PFC) than any other primate species, which facilitated the expansion of higher-order executive functions. Humans are highly social, with individual humans tending to belong to a multi-layered network of distinct social groups \u2013 from families and peer groups to corporations and political states. As such, social interactions between humans have established a wide variety of values, social norms, languages, and traditions (collectively termed institutions), each of which bolsters human society."}}, {"canonical_name": "convulsive crisis", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "convulsive_crisis", "book_id": "principles_of_psychology_james_1890", "name": "convulsive crisis", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["convulsive crisis"], "contexts": ["event following viper bite"]}, {"entity_id": "convulsion", "book_id": "kosmos_humboldt_1845", "name": "convulsion", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["convulsion"], "contexts": ["involuntary muscular contractions"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "convulsive crisis", "target_book": "kosmos_humboldt_1845", "target_name": "convulsion", "similarity": 0.948}], "id": 5771, "stable_key": "clu_fbc57583e3e873e7", "ground_truth": {"modern_name": "Seizure", "confidence": "high", "type": "disease", "modern_term": "Seizure", "note": "The description 'involuntary muscular contractions' and the context of a 'viper bite' strongly suggest a seizure."}}, {"canonical_name": "depression of spirits", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "depression_of_spirits", "book_id": "principles_of_psychology_james_1890", "name": "depression of spirits", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["depression of spirits"], "contexts": ["low mood and spirits"]}, {"entity_id": "depression", "book_id": "first_principles_spencer_1862", "name": "depression", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["depression"], "contexts": ["state of low spirits"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "depression of spirits", "target_book": "first_principles_spencer_1862", "target_name": "depression", "similarity": 0.917}], "id": 5772, "stable_key": "clu_2356c4fedf30fafa-2", "ground_truth": {"modern_name": "Depression", "confidence": "high", "type": "disease", "modern_term": "Major depressive disorder", "note": "In early modern texts, 'depression of spirits' was a common descriptor for low mood and melancholy, which corresponds to modern understandings of depression.", "wikidata_id": "Q209190", "wikidata_description": "region of the atmosphere in which atmospheric pressure is lower than that of surrounding regions", "wikipedia_extract": "The Great Depression was a severe global economic downturn from 1929 to 1939. The period was characterized by high rates of unemployment and poverty, drastic reductions in industrial production and international trade, and widespread bank and business failures around the world. The economic contagion began in 1929 in the United States, the largest economy in the world, with the devastating Wall Street crash of 1929 often considered the beginning of the Depression. Among the countries with the most unemployed were the U.S., the United Kingdom, and Germany. The Depression was preceded by a period of industrial growth and social development known as the \"Roaring Twenties\". Much of the profit generated by the boom was invested in speculation, such as on the stock market, contributing to growing wealth inequality.", "wikipedia_url": "https://en.wikipedia.org/wiki/Great_Depression"}}, {"canonical_name": "fidelity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fidelity", "book_id": "principles_of_psychology_james_1890", "name": "fidelity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fidelity"], "contexts": ["faithfulness and loyalty"]}, {"entity_id": "loyalty", "book_id": "first_principles_spencer_1862", "name": "loyalty", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["loyalty"], "contexts": ["feeling of allegiance"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "fidelity", "target_book": "first_principles_spencer_1862", "target_name": "loyalty", "similarity": 0.951}], "id": 5773, "stable_key": "clu_83376ae26965d050", "ground_truth": {"modern_name": "Loyalty", "confidence": "high", "type": "concept", "wikidata_id": "Q1132131", "wikidata_description": "faithfulness or devotion to a person, country, group, or cause"}}, {"canonical_name": "conscious selfhood", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "conscious_selfhood", "book_id": "principles_of_psychology_james_1890", "name": "conscious selfhood", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["conscious selfhood"], "contexts": ["sense of being a self"]}, {"entity_id": "self-consciousness", "book_id": "first_principles_spencer_1862", "name": "self-consciousness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["self-consciousness"], "contexts": ["awareness of oneself"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "conscious selfhood", "target_book": "first_principles_spencer_1862", "target_name": "self-consciousness", "similarity": 0.94}], "id": 5774, "stable_key": "clu_0faa29b218cf588c-2", "ground_truth": {"modern_name": "Self-awareness", "confidence": "high", "type": "concept", "wikidata_id": "Q1314553", "wikidata_description": "capacity for an individual to consciously know and understand one's own character, feelings, motives, and desires", "wikipedia_url": "https://en.wikipedia.org/wiki/Self-awareness", "wikipedia_extract": "In the philosophy of self, self-awareness is the awareness and reflection of one's own personality or individuality, including traits, feelings, and behaviors. It is not to be confused with consciousness in the sense of qualia. While consciousness is being aware of one's body and environment, self-awareness is the recognition of that consciousness. Self-awareness is how an individual experiences and understands their own character, feelings, motives, and desires. Because the term is used in both philosophical and psychological contexts, researchers distinguish between different forms of self-awareness, ranging from awareness of consciousness itself to awareness of oneself within social situations. The term self-awareness is used across several disciplines to describe related but distinct phenomena."}}, {"canonical_name": "mental derangement", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mental_derangement", "book_id": "principles_of_psychology_james_1890", "name": "mental derangement", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["mental derangement"], "contexts": ["disorder of the mind"]}, {"entity_id": "deranged", "book_id": "connexion_physical_sciences_somerville_1858", "name": "deranged", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["deranged"], "contexts": ["disrupted or disturbed"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "mental derangement", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "deranged", "similarity": 0.902}], "id": 5775, "stable_key": "clu_148cccf0bedfaa11", "ground_truth": {"modern_name": "Mental disorder", "confidence": "high", "type": "disease", "modern_term": "Mental disorder", "wikidata_id": "Q18966384", "wikidata_description": "Human disease"}}, {"canonical_name": "Julius C\u00e6sar", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "julius_c\u00e6sar", "book_id": "principles_of_psychology_james_1890", "name": "Julius C\u00e6sar", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Julius C\u00e6sar"], "contexts": ["historical figure dictating letters"]}, {"entity_id": "julius_c\u00e6sar", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Julius C\u00e6sar", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Julius C\u00e6sar"], "contexts": ["initiated the Julian Calendar"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Julius C\u00e6sar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Julius C\u00e6sar", "similarity": 0.795}], "id": 5776, "stable_key": "clu_1a6713bbd578e755-2", "ground_truth": {"modern_name": "Julius Caesar", "confidence": "high", "type": "person", "birth_year": -100, "death_year": -44, "description": "Roman general and dictator, initiated the Julian Calendar.", "wikidata_id": "Q1048", "wikidata_description": "Roman general and dictator"}}, {"canonical_name": "visual impressions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "visual_impressions", "book_id": "principles_of_psychology_james_1890", "name": "visual impressions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["visual impressions"], "contexts": ["sensory input from sight"]}, {"entity_id": "photographic_impressions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "photographic impressions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["photographic impressions"], "contexts": ["images created by photographic process"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "visual impressions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "photographic impressions", "similarity": 0.9}], "id": 5777, "stable_key": "clu_05b2675aa3670ae9-3", "ground_truth": {"modern_name": "Visual Perception", "confidence": "high", "type": "concept", "wikidata_id": "Q113263364", "wikidata_description": "capacity of an insect to extract information from light"}}, {"canonical_name": "negative", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "negative", "book_id": "principles_of_psychology_james_1890", "name": "negative", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["negative"], "contexts": ["type of error in time estimation"]}, {"entity_id": "negative", "book_id": "connexion_physical_sciences_somerville_1858", "name": "negative", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["negative"], "contexts": ["other electric state"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "negative", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "negative", "similarity": 1.0}], "id": 5778, "stable_key": "clu_41ab282f146933d6", "ground_truth": {"modern_name": "Negative", "confidence": "high", "type": "concept", "note": "The term 'negative' has multiple meanings, including errors in judgment and electrical states, and its specific historical application requires further contextual information.", "wikidata_id": "Q1478451", "wikidata_description": "grammatical form that encodes negative polarity or falsity"}}, {"canonical_name": "pendulum-strokes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pendulum-strokes", "book_id": "principles_of_psychology_james_1890", "name": "pendulum-strokes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["pendulum-strokes"], "contexts": ["sounds from pendulum movement"]}, {"entity_id": "pendulum", "book_id": "first_principles_spencer_1862", "name": "pendulum", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["pendulum"], "contexts": ["alters its rate of oscillation when taken to equator"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "pendulum-strokes", "target_book": "first_principles_spencer_1862", "target_name": "pendulum", "similarity": 0.884}], "id": 5779, "stable_key": "clu_798888e8c08c1a79-2", "ground_truth": {"modern_name": "Pendulum", "confidence": "high", "type": "OBJECT", "description": "A weight suspended from a fixed point, swinging freely.", "wikipedia_extract": "A pendulum is a device made of a weight suspended from a pivot so that it can swing freely. When a pendulum is displaced sideways from its resting, equilibrium position, it is subject to a restoring force due to gravity that will accelerate it back toward the equilibrium position. When released, the restoring force acting on the pendulum's mass causes it to oscillate about the equilibrium position, swinging back and forth. The time for one complete cycle, a left swing and a right swing, is called the period. The period depends on the length of the pendulum and also to a slight degree on the amplitude, the width of the pendulum's swing. The SI unit of the period of a pendulum is the second (s).", "note": "The term 'pendulum-strokes' likely refers to the oscillations or beats of a pendulum, particularly in the context of measuring time or the physical principles governing its movement.", "wikidata_id": "Q829360", "wikidata_description": "idealized concept of a pendulum"}}, {"canonical_name": "pronouns", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pronouns", "book_id": "principles_of_psychology_james_1890", "name": "pronouns", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["pronouns"], "contexts": ["words replacing nouns"]}, {"entity_id": "pronouns", "book_id": "first_principles_spencer_1862", "name": "pronouns", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["pronouns"], "contexts": ["words replacing nouns"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "pronouns", "target_book": "first_principles_spencer_1862", "target_name": "pronouns", "similarity": 1.0}], "id": 5780, "stable_key": "clu_efa29a6f7dda6cec", "ground_truth": {"modern_name": "pronoun", "confidence": "high", "type": "concept"}}, {"canonical_name": "photographs", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "photographs", "book_id": "principles_of_psychology_james_1890", "name": "photographs", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["photographs"], "contexts": ["images captured by camera"]}, {"entity_id": "photographs", "book_id": "connexion_physical_sciences_somerville_1858", "name": "photographs", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["photographs"], "contexts": ["coloured, obtained from Chrysotype"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "photographs", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "photographs", "similarity": 1.0}], "id": 5781, "stable_key": "clu_868dbf926b82d3aa", "ground_truth": {"modern_name": "photograph", "confidence": "high", "type": "object", "note": "Mentions of 'Chrysotype' indicate an early photographic process."}}, {"canonical_name": "muscular adjustment", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "muscular_adjustment", "book_id": "principles_of_psychology_james_1890", "name": "muscular adjustment", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["muscular adjustment"], "contexts": ["preparation of muscles for movement"]}, {"entity_id": "muscular_adjustments", "book_id": "first_principles_spencer_1862", "name": "muscular adjustments", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["muscular adjustments"], "contexts": ["movements made by muscles"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "muscular adjustment", "target_book": "first_principles_spencer_1862", "target_name": "muscular adjustments", "similarity": 0.979}], "id": 5782, "stable_key": "clu_91065b15d196dc49", "ground_truth": {"modern_name": "muscle adaptation", "confidence": "high", "type": "concept", "note": "Refers to the physiological adjustments and preparatory movements of muscles.", "wikidata_id": "Q39833245", "wikidata_description": "scientific article published on July 1, 1977"}}, {"canonical_name": "Perez", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "perez", "book_id": "principles_of_psychology_james_1890", "name": "Perez", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Perez"], "contexts": ["scholar providing an example of child's attention"]}, {"entity_id": "peres", "book_id": "polyanthea_medicinal", "name": "Peres", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Peres"], "contexts": ["early modern author on medical compendium"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Perez", "target_book": "polyanthea_medicinal", "target_name": "Peres", "similarity": 0.845}], "id": 5783, "stable_key": "clu_035fdc2f4a0f9892", "ground_truth": {"modern_name": "Lu\u00eds de Molina", "confidence": "medium", "type": "person", "birth_year": 1535, "death_year": 1600, "description": "Spanish Jesuit theologian and scholastic philosopher", "note": "The primary context points to the Jesuit theologian Lu\u00eds de Molina (1535-1600) who wrote extensively on free will, a concept relevant to the philosophical discussion of attention. The 'Peres' variant is less clear but could be a variant spelling or a different scholar if Molina is not the intended reference. However, given the philosophical context, Molina is the most likely referent.", "wikidata_id": "Q703250", "wikidata_description": "16th-century Spanish painter (1509\u20131586)"}}, {"canonical_name": "telescopic field of view", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "telescopic_field_of_view", "book_id": "principles_of_psychology_james_1890", "name": "telescopic field of view", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["telescopic field of view"], "contexts": ["visual area in telescope"]}, {"entity_id": "telescopic_field_of_view", "book_id": "kosmos_humboldt_1845", "name": "telescopic field of view", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["telescopic field of view"], "contexts": ["area seen through a telescope"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "telescopic field of view", "target_book": "kosmos_humboldt_1845", "target_name": "telescopic field of view", "similarity": 1.0}], "id": 5784, "stable_key": "clu_ca12f90f09acc357", "ground_truth": {"modern_name": "Field of view", "confidence": "high", "type": "concept", "note": "The term 'telescopic field of view' refers to the extent of the observable world that is seen through a telescope, which is a specific application of the broader concept of 'field of view'."}}, {"canonical_name": "conceivability", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "conceivability", "book_id": "principles_of_psychology_james_1890", "name": "conceivability", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["conceivability"], "contexts": ["ability to be conceived or imagined"]}, {"entity_id": "conceivable", "book_id": "first_principles_spencer_1862", "name": "conceivable", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["conceivable"], "contexts": ["capable of being thought"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "conceivability", "target_book": "first_principles_spencer_1862", "target_name": "conceivable", "similarity": 0.88}], "id": 5785, "stable_key": "clu_07169215627e33cd", "ground_truth": {"modern_name": "Conceivability", "confidence": "high", "type": "concept", "wikidata_id": "Q128777945", "wikidata_description": "scholarly article"}}, {"canonical_name": "equality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "equality", "book_id": "principles_of_psychology_james_1890", "name": "equality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["equality"], "contexts": ["state of being equal"]}, {"entity_id": "equality", "book_id": "first_principles_spencer_1862", "name": "Equality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Equality"], "contexts": ["example of a contradictorily known concept"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "equality", "target_book": "first_principles_spencer_1862", "target_name": "Equality", "similarity": 0.993}], "id": 5786, "stable_key": "clu_2b063ef3c523a6fe", "ground_truth": {"modern_name": "Equality", "confidence": "high", "type": "concept", "note": "In the context of James and Spencer, 'equality' refers to a conceptual state or principle, not a specific scientific or medical concept.", "wikidata_id": "Q113453", "wikidata_description": "state of equal ease of access to resources and opportunities regardless of gender, including economic participation and decision-making"}}, {"canonical_name": "inequality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "inequality", "book_id": "principles_of_psychology_james_1890", "name": "inequality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["inequality"], "contexts": ["state of being unequal"]}, {"entity_id": "secular_inequality", "book_id": "connexion_physical_sciences_somerville_1858", "name": "secular inequality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["secular inequality"], "contexts": ["long-term astronomical variation"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "inequality", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "secular inequality", "similarity": 0.903}], "id": 5787, "stable_key": "clu_262fb44b0411edef", "ground_truth": {"modern_name": "Inequality", "confidence": "high", "type": "concept", "note": "The term 'inequality' is used broadly here, encompassing both general states of being unequal and specific scientific phenomena like secular inequality in astronomy.", "wikidata_id": "Q3153995", "wikidata_description": "mathematical concept"}}, {"canonical_name": "whole", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "whole", "book_id": "principles_of_psychology_james_1890", "name": "whole", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["whole"], "contexts": ["entity considered as a complete unit"]}, {"entity_id": "whole", "book_id": "first_principles_spencer_1862", "name": "Whole", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Whole"], "contexts": ["concept opposed to Part"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "whole", "target_book": "first_principles_spencer_1862", "target_name": "Whole", "similarity": 0.924}], "id": 5788, "stable_key": "clu_2b44def737813952", "ground_truth": {"modern_name": "Wholeness", "confidence": "high", "type": "concept", "note": "Refers to the philosophical or psychological concept of a complete entity, often contrasted with its parts."}}, {"canonical_name": "slow", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "slow", "book_id": "principles_of_psychology_james_1890", "name": "slow", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["slow"], "contexts": ["speed of motion"]}, {"entity_id": "slow", "book_id": "polyanthea_medicinal", "name": "slow", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["slow"], "contexts": ["rate of blood flow"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "slow", "target_book": "polyanthea_medicinal", "target_name": "slow", "similarity": 1.0}], "id": 5789, "stable_key": "clu_08f8799af4fdb975", "ground_truth": {"modern_name": "Slow reproduction rate", "confidence": "medium", "type": "concept", "note": "The term 'slow' in the second context is ambiguous, but in conjunction with 'slow-breeders' and evolutionary texts, it likely refers to the rate of biological reproduction.", "wikipedia_extract": "Sawfish,  also known as carpenter sharks, are a family of very large rays characterized by a long, narrow, flattened rostrum, or nose extension, lined with sharp transverse teeth, arranged in a way that resembles a saw. They are among the largest fish, with some species reaching lengths of about 7\u20137.6 m (23\u201325 ft). They are found worldwide in tropical and subtropical regions in coastal marine and brackish estuarine waters, as well as freshwater rivers and lakes. All species are critically endangered. They should not be confused with sawsharks (order Pristiophoriformes) or the extinct sclerorhynchoids (order Rajiformes) which have a similar appearance, or swordfish (family Xiphiidae) which have a similar name but a very different appearance. Sawfishes are relatively slow breeders and the females give birth to live young.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sawfish"}}, {"canonical_name": "rectilinear", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "rectilinear", "book_id": "principles_of_psychology_james_1890", "name": "rectilinear", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["rectilinear"], "contexts": ["type of motion"]}, {"entity_id": "rectilinear", "book_id": "first_principles_spencer_1862", "name": "rectilinear", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["rectilinear"], "contexts": ["moving in a straight line"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "rectilinear", "target_book": "first_principles_spencer_1862", "target_name": "rectilinear", "similarity": 1.0}], "id": 5790, "stable_key": "clu_10da59f0d52a5cb6", "ground_truth": {"modern_name": "Rectilinear motion", "confidence": "high", "type": "concept", "note": "Specifically refers to movement along a straight line, a fundamental concept in physics and mechanics.", "wikidata_id": "Q2035846", "wikidata_description": "motion along a dimension of length (straight line in space)"}}, {"canonical_name": "Chapter IX", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "chapter_ix", "book_id": "principles_of_psychology_james_1890", "name": "Chapter IX", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Chapter IX"], "contexts": ["section of a book"]}, {"entity_id": "section_ix", "book_id": "connexion_physical_sciences_somerville_1858", "name": "SECTION IX", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["SECTION IX"], "contexts": ["section heading"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Chapter IX", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "SECTION IX", "similarity": 0.903}], "id": 5791, "stable_key": "clu_f654a0c73cce67c6", "ground_truth": {"modern_name": "Chapter or Section Heading", "confidence": "high", "type": "concept", "note": "This refers to a structural element of a book rather than a specific content topic.", "wikidata_id": "Q21481766", "wikidata_description": "chapter written by specific authors in a scholarly book"}}, {"canonical_name": "singular", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "singular", "book_id": "principles_of_psychology_james_1890", "name": "singular", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["singular"], "contexts": ["individual instance or particular"]}, {"entity_id": "singular", "book_id": "first_principles_spencer_1862", "name": "Singular", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Singular"], "contexts": ["concept opposed to Plural"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "singular", "target_book": "first_principles_spencer_1862", "target_name": "Singular", "similarity": 0.768}], "id": 5792, "stable_key": "clu_d4f0a3674368b35c", "ground_truth": {"modern_name": "singular", "confidence": "high", "type": "concept", "wikidata_id": "Q7524258", "wikidata_description": "genus of insects"}}, {"canonical_name": "indefinites", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "indefinites", "book_id": "principles_of_psychology_james_1890", "name": "indefinites", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["indefinites"], "contexts": ["vaguely defined entities"]}, {"entity_id": "indefinite", "book_id": "first_principles_spencer_1862", "name": "indefinite", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["indefinite"], "contexts": ["not clearly defined"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "indefinites", "target_book": "first_principles_spencer_1862", "target_name": "indefinite", "similarity": 0.911}], "id": 5793, "stable_key": "clu_7e0f23ac049d35fe", "ground_truth": {"modern_name": "indefinite", "confidence": "high", "type": "concept", "wikidata_id": "Q956030", "wikidata_description": "pronoun without a definite referent (e.g. \"somebody\", \"everything\", \"whoever\")"}}, {"canonical_name": "permanency", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "permanency", "book_id": "principles_of_psychology_james_1890", "name": "permanency", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["permanency"], "contexts": ["enduring nature of topics"]}, {"entity_id": "permanence", "book_id": "first_principles_spencer_1862", "name": "permanence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["permanence"], "contexts": ["state of lasting or remaining unchanged"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "permanency", "target_book": "first_principles_spencer_1862", "target_name": "permanence", "similarity": 0.98}], "id": 5794, "stable_key": "clu_47170b7c9e455576", "ground_truth": {"modern_name": "permanence", "confidence": "high", "type": "concept", "wikidata_id": "Q20742557", "wikidata_description": "quality of lasting, or being intended to last, indefinitely"}}, {"canonical_name": "ontological", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ontological", "book_id": "principles_of_psychology_james_1890", "name": "ontological", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ontological"], "contexts": ["principle of identity in philosophy"]}, {"entity_id": "ontological_theory", "book_id": "first_principles_spencer_1862", "name": "ontological theory", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["ontological theory"], "contexts": ["theory about the nature of being"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "ontological", "target_book": "first_principles_spencer_1862", "target_name": "ontological theory", "similarity": 0.916}], "id": 5795, "stable_key": "clu_fcefbacc0380cffd", "ground_truth": {"modern_name": "ontology", "confidence": "high", "type": "concept", "wikidata_id": "Q324254", "wikidata_description": "specification of a conceptualization"}}, {"canonical_name": "universality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "universality", "book_id": "principles_of_psychology_james_1890", "name": "universality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["universality"], "contexts": ["quality of being universal"]}, {"entity_id": "universality", "book_id": "first_principles_spencer_1862", "name": "universality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["universality"], "contexts": ["applying to all cases"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "universality", "target_book": "first_principles_spencer_1862", "target_name": "universality", "similarity": 1.0}], "id": 5796, "stable_key": "clu_6260ddd766da90f1", "ground_truth": {"modern_name": "universality", "confidence": "high", "type": "concept", "wikidata_id": "Q875797", "wikidata_description": "idea that universal facts exist and can be progressively discovered, as opposed to relativism"}}, {"canonical_name": "liquidity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "liquidity", "book_id": "principles_of_psychology_james_1890", "name": "liquidity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["liquidity"], "contexts": ["state of being liquid"]}, {"entity_id": "liquidity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "liquidity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["liquidity"], "contexts": ["state of being liquid"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "liquidity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "liquidity", "similarity": 1.0}], "id": 5797, "stable_key": "clu_61917a5c204771cc", "ground_truth": {"modern_name": "liquidity", "confidence": "high", "type": "concept", "wikidata_id": "Q184783", "wikidata_description": "general term, including both market and financial liquidity"}}, {"canonical_name": "musical chords", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "musical_chords", "book_id": "principles_of_psychology_james_1890", "name": "musical chords", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["musical chords"], "contexts": ["combination of musical notes"]}, {"entity_id": "musical_chord", "book_id": "connexion_physical_sciences_somerville_1858", "name": "musical chord", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["musical chord"], "contexts": ["combination of musical notes"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "musical chords", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "musical chord", "similarity": 0.861}], "id": 5798, "stable_key": "clu_bfc274d7d1efc8db", "ground_truth": {"modern_name": "Musical chord", "confidence": "high", "type": "concept", "wikidata_id": "Q170439", "wikidata_description": "harmonic set of three or more notes"}}, {"canonical_name": "Dry", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dry", "book_id": "principles_of_psychology_james_1890", "name": "Dry", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["Dry"], "contexts": ["quality of wine"]}, {"entity_id": "dry", "book_id": "ricettario_fiorentino_1597", "name": "Dry", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["Dry"], "contexts": ["quality of dryness"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Dry", "target_book": "ricettario_fiorentino_1597", "target_name": "Dry", "similarity": 1.0}], "id": 5799, "stable_key": "clu_393c78794e6a7ea5-4", "ground_truth": {"modern_name": "dryness", "confidence": "high", "type": "concept", "note": "In humoral theory, 'dryness' was considered a fundamental quality of the four elements and humors, impacting physiology and the environment.", "wikidata_id": "Q5309747", "wikidata_description": "medical condition in which there is a decrease in normal lubrication of the skin or mucous membranes", "wikipedia_url": "https://en.wikipedia.org/wiki/Dryness%20%28medical%29", "wikipedia_extract": "Dryness is a medical condition in which there is local or more generalized decrease in normal lubrication of the skin or mucous membranes. Examples of local dryness include dry mouth, dry eyes, dry skin (xeroderma), diabetic foot and vaginal dryness. These often have specific causes and treatments. It is possible to have dry eyes without any other signs or symptoms, but this usually causes a syndrome of eye symptoms called keratoconjunctivitis sicca. More generalized dryness can be caused by e.g. dehydration (that is, more general loss of body fluids), anticholinergic drugs and Sj\u00f6gren syndrome."}}, {"canonical_name": "absolute power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "absolute_power", "book_id": "principles_of_psychology_james_1890", "name": "absolute power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["absolute power"], "contexts": ["unlimited authority"]}, {"entity_id": "absolute_force", "book_id": "first_principles_spencer_1862", "name": "Absolute Force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Absolute Force"], "contexts": ["transcendent power beyond immediate consciousness"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "absolute power", "target_book": "first_principles_spencer_1862", "target_name": "Absolute Force", "similarity": 0.881}], "id": 5800, "stable_key": "clu_a2213fb9e815a874", "ground_truth": {"modern_name": "Absolute power", "confidence": "high", "type": "concept", "wikidata_id": "Q8184353", "wikidata_description": "episode of Stargate SG-1 (S4 E17)"}}, {"canonical_name": "palm of the hand", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "palm_of_the_hand", "book_id": "principles_of_psychology_james_1890", "name": "palm of the hand", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["palm of the hand"], "contexts": ["part of the hand used for tactile sensation"]}, {"entity_id": "palm_of_the_hand", "book_id": "first_principles_spencer_1862", "name": "palm of the hand", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["palm of the hand"], "contexts": ["inner surface of the hand"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "palm of the hand", "target_book": "first_principles_spencer_1862", "target_name": "palm of the hand", "similarity": 1.0}], "id": 5801, "stable_key": "clu_2652d9251fd2db94", "ground_truth": {"modern_name": "Palm of the hand", "confidence": "high", "type": "concept", "wikidata_id": "Q2001588", "wikidata_description": "central region of the front (ventral side) of the human hand or other primate hand"}}, {"canonical_name": "granules", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "granules", "book_id": "principles_of_psychology_james_1890", "name": "granules", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["granules"], "contexts": ["small particles in the eye"]}, {"entity_id": "granules", "book_id": "kosmos_humboldt_1845", "name": "granules", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["granules"], "contexts": ["small particles or grains"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "granules", "target_book": "kosmos_humboldt_1845", "target_name": "granules", "similarity": 0.735}], "id": 5802, "stable_key": "clu_fb2f53c862d99344", "ground_truth": {"modern_name": "granules", "confidence": "high", "type": "concept", "note": "The term 'granules' in early modern medical texts can refer to small, grain-like particles in the body, or more generally to any small particulate matter. In the context of anatomy, it most likely refers to histological structures or small particles observed under magnification, but without more specific context, it's best classified as a concept of particulate matter.", "wikidata_id": "Q18581596", "wikidata_description": "genus of insects"}}, {"canonical_name": "psychic process", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "psychic_process", "book_id": "principles_of_psychology_james_1890", "name": "psychic process", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["psychic process"], "contexts": ["mental processes underlying behavior"]}, {"entity_id": "psychological_process", "book_id": "first_principles_spencer_1862", "name": "psychological process", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["psychological process"], "contexts": ["mental processes and their determination"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "psychic process", "target_book": "first_principles_spencer_1862", "target_name": "psychological process", "similarity": 0.928}], "id": 5803, "stable_key": "clu_fd929c1afe739c3a-2", "ground_truth": {"modern_name": "mental process", "confidence": "high", "type": "concept", "note": "'Internal activity' and 'internal action' in these philosophical texts refer to the workings of the mind or consciousness.", "wikidata_id": "Q12047513", "wikidata_description": "concept in psychology that refers to the sequence of thoughts, emotions, and behaviors that reflect the mind\u2019s function and interaction with the environment"}}, {"canonical_name": "existents", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "existents", "book_id": "principles_of_psychology_james_1890", "name": "existents", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["existents"], "contexts": ["things that exist"]}, {"entity_id": "existences", "book_id": "first_principles_spencer_1862", "name": "existences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["existences"], "contexts": ["states of being or reality"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "existents", "target_book": "first_principles_spencer_1862", "target_name": "existences", "similarity": 0.893}], "id": 5804, "stable_key": "clu_82da87fcf7ac989f-4", "ground_truth": {"modern_name": "space", "confidence": "high", "type": "concept", "wikidata_id": "Q1", "wikidata_description": "totality consisting of space, time, matter and energy", "wikipedia_url": "https://en.wikipedia.org/wiki/Universe", "wikipedia_extract": "The universe is all of space and time and their contents. It comprises all of existence, any fundamental interaction, physical process and physical constant, and therefore all forms of matter and energy, and the structures they form, from sub-atomic particles to entire galactic filaments. Since the early 20th century, the field of cosmology establishes that space and time emerged together at the Big Bang 13.787\u00b10.020 billion years ago and that the universe has been expanding since then. The portion of the universe that can be seen by humans is approximately 93 billion light-years in diameter at present, but the total size of the universe is not known. Some of the earliest cosmological models of the universe were geocentric, placing Earth at the center. During the European Scientific Revolution, astronomical observations led to a heliocentric model."}}, {"canonical_name": "daylight", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "daylight", "book_id": "principles_of_psychology_james_1890", "name": "daylight", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["daylight"], "contexts": ["light from the sun during the day"]}, {"entity_id": "common_daylight", "book_id": "connexion_physical_sciences_somerville_1858", "name": "common daylight", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["common daylight"], "contexts": ["ordinary light from the sun"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "daylight", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "common daylight", "similarity": 0.951}], "id": 5805, "stable_key": "clu_4901eabace40360b", "ground_truth": {"modern_name": "daylight", "confidence": "high", "type": "concept", "wikidata_id": "Q36669", "wikidata_description": "seasonal adjustment of clocks"}}, {"canonical_name": "pound", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pound", "book_id": "principles_of_psychology_james_1890", "name": "pound", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["pound"], "contexts": ["unit of weight"]}, {"entity_id": "pound", "book_id": "first_principles_spencer_1862", "name": "pound", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["pound"], "contexts": ["unit of weight"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "pound", "target_book": "first_principles_spencer_1862", "target_name": "pound", "similarity": 1.0}], "id": 5806, "stable_key": "clu_d0a4a9db1531a48d", "ground_truth": {"modern_name": "pound", "confidence": "high", "type": "concept", "note": "In this context, 'pound' refers to a unit of weight, a common concept in both scientific and everyday discourse."}}, {"canonical_name": "feelings of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "feelings_of_heat", "book_id": "principles_of_psychology_james_1890", "name": "feelings of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["feelings of heat"], "contexts": ["sensory modality"]}, {"entity_id": "sensation_of_heat", "book_id": "first_principles_spencer_1862", "name": "sensation of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sensation of heat"], "contexts": ["subjective experience of heat"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "feelings of heat", "target_book": "first_principles_spencer_1862", "target_name": "sensation of heat", "similarity": 0.971}], "id": 5807, "stable_key": "clu_4cb2a3da86ebb95c", "ground_truth": {"modern_name": "sensation of heat", "confidence": "high", "type": "concept", "note": "This refers to the subjective experience of temperature, a fundamental sensory input."}}, {"canonical_name": "ratio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ratio", "book_id": "principles_of_psychology_james_1890", "name": "ratio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ratio"], "contexts": ["proportion between quantities"]}, {"entity_id": "ratio", "book_id": "polyanthea_medicinal", "name": "ratio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ratio"], "contexts": ["reason or logic in medicine"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "ratio", "target_book": "polyanthea_medicinal", "target_name": "ratio", "similarity": 1.0}], "id": 5808, "stable_key": "clu_862ea9a8c437c024", "ground_truth": {"modern_name": "ratio", "confidence": "high", "type": "concept", "note": "A fundamental mathematical and philosophical concept, applicable in both abstract reasoning and proportional relationships."}}, {"canonical_name": "coldness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "coldness", "book_id": "principles_of_psychology_james_1890", "name": "coldness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["coldness"], "contexts": ["sensation of temperature"]}, {"entity_id": "coldness", "book_id": "kosmos_humboldt_1845", "name": "coldness", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["coldness"], "contexts": ["temperature quality of mud emissions"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "coldness", "target_book": "kosmos_humboldt_1845", "target_name": "coldness", "similarity": 1.0}], "id": 5809, "stable_key": "clu_6dc95379fb298543-4", "ground_truth": {"modern_name": "coldness", "confidence": "high", "type": "CONCEPT", "description": "A bodily quality or state associated with low temperature or lack of heat.", "note": "Refers to the humoral concept of coldness affecting the body.", "wikipedia_extract": "In statistical thermodynamics, thermodynamic beta, also known as coldness, is the reciprocal of the thermodynamic temperature of a system: {\\displaystyle \\beta \\equiv {\\frac {1}{k_{\\rm {B}}T}}} (where T is the temperature and kB is Boltzmann constant). Thermodynamic beta has units reciprocal to that of energy (in SI units, reciprocal joules, {\\displaystyle [\\beta ]={\\textrm {J}}^{-1}} ). In non-thermal units, it can also be measured in byte per joule, or more conveniently, gigabyte per nanojoule; 1 K\u22121 is equivalent to about 13,062 gigabytes per nanojoule; at room temperature: T = 300K, \u03b2 \u2248 44 GB/nJ \u2248 39 eV\u22121 \u2248 2.4\u00d71020 J\u22121. The conversion factor is 1 GB/nJ = Thermodynamic beta is essentially the connection between the information theory and statistical mechanics interpretation of a physical system through its entropy and the thermodynamics associated with its energy. It expresses the response of entropy to an increase in energy. If a small amount of energy is added to the system, then \u03b2 describes the amount the system will randomize.", "wikidata_id": "Q270952", "wikidata_description": "relative or subjective state of low temperature"}}, {"canonical_name": "Dobrowolsky", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dobrowolsky", "book_id": "principles_of_psychology_james_1890", "name": "Dobrowolsky", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Dobrowolsky"], "contexts": ["observer of color differences"]}, {"entity_id": "dobrowsky", "book_id": "kosmos_humboldt_1845", "name": "Dobrowsky", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Dobrowsky"], "contexts": ["editor of Bohemian historical texts"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Dobrowolsky", "target_book": "kosmos_humboldt_1845", "target_name": "Dobrowsky", "similarity": 0.946}], "id": 5810, "stable_key": "clu_d2ff2c9c006019f6", "ground_truth": {"modern_name": "Dobrowolsky", "confidence": "low", "type": "person", "description": "Observer of color differences and editor of historical texts.", "note": "The identity of 'Dobrowolsky'/'Dobrowsky' is not clearly identifiable without further context from the specific texts.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "An induction motor or asynchronous motor is an AC electric motor in which the electric current in the rotor that produces torque is obtained by electromagnetic induction from the magnetic field of the stator winding. An induction motor therefore needs no electrical connections to the rotor. An induction motor's rotor can be either wound type or squirrel-cage type. Three-phase squirrel-cage induction motors are widely used as industrial drives because they are self-starting, reliable, and economical. Single-phase induction motors are used extensively for smaller loads, such as garbage disposals and stationary power tools. Although traditionally used for constant-speed service, single- and three-phase induction motors are increasingly being installed in variable-speed applications using variable-frequency drives (VFD).", "wikipedia_url": "https://en.wikipedia.org/wiki/Induction_motor"}}, {"canonical_name": "transitions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "transitions", "book_id": "principles_of_psychology_james_1890", "name": "transitions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["transitions"], "contexts": ["movement from one state to another"]}, {"entity_id": "transitions", "book_id": "kosmos_humboldt_1845", "name": "transitions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["transitions"], "contexts": ["changes from one state to another"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "transitions", "target_book": "kosmos_humboldt_1845", "target_name": "transitions", "similarity": 1.0}], "id": 5811, "stable_key": "clu_f027f9e428b9abf6-2", "ground_truth": {"modern_name": "transition", "confidence": "high", "type": "concept", "note": "The term 'passage' in the context of James's 'Principles of Psychology' and Spencer's 'First Principles' refers to a conceptual transition or movement between states, ideas, or stages, rather than a physical passage.", "wikidata_id": "Q98775214", "wikidata_description": "Little, Brown paperback edition"}}, {"canonical_name": "room", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "room", "book_id": "principles_of_psychology_james_1890", "name": "room", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["room"], "contexts": ["enclosed space within a building"]}, {"entity_id": "room", "book_id": "coloquios_da_orta_1563", "name": "Room", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Room"], "contexts": ["Word discussed in the glossary"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "room", "target_book": "coloquios_da_orta_1563", "target_name": "Room", "similarity": 0.996}], "id": 5812, "stable_key": "clu_cb2f31eee58f7cbe", "ground_truth": {"modern_name": "room", "confidence": "high", "type": "place", "wikidata_id": "Q220", "wikidata_description": "capital and largest city of Italy"}}, {"canonical_name": "savor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "savor", "book_id": "principles_of_psychology_james_1890", "name": "savor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["savor"], "contexts": ["distinctive taste of food"]}, {"entity_id": "taste", "book_id": "first_principles_spencer_1862", "name": "taste", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["taste"], "contexts": ["distinguished feelings"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "savor", "target_book": "first_principles_spencer_1862", "target_name": "taste", "similarity": 0.959}], "id": 5813, "stable_key": "clu_5b518be6a8cdefdf", "ground_truth": {"modern_name": "Gustation", "confidence": "high", "type": "concept"}}, {"canonical_name": "morning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "morning", "book_id": "principles_of_psychology_james_1890", "name": "morning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["morning"], "contexts": ["part of the day"]}, {"entity_id": "manh\u00e3", "book_id": "polyanthea_medicinal", "name": "manh\u00e3", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["manh\u00e3"], "contexts": ["morning"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "morning", "target_book": "polyanthea_medicinal", "target_name": "manh\u00e3", "similarity": 0.938}], "id": 5814, "stable_key": "clu_ff24d8a8bedfafad", "ground_truth": {"modern_name": "Morning", "confidence": "high", "type": "concept", "note": "The terms 'matin' (French), 'morning' (English), 'ma\u00f1ana' (Spanish), and 'manh\u00e3' (Portuguese) all refer to the early part of the day.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "Morning is either the period from sunrise to noon, or the period from midnight to noon. In the first definition it is preceded by the twilight period of dawn, and there are no exact times for when morning begins (also true of evening and night) because it can vary according to one's latitude, and the hours of daylight at each time of year. However, morning strictly ends at noon, when afternoon starts. Morning precedes afternoon, evening, and night in the sequence of a day. Originally, the term referred to sunrise. The Modern English words \"morning\" and \"tomorrow\" began in Middle English as morwening, developing into morwen, then morwe, and eventually morrow."}}, {"canonical_name": "Fig. 41", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fig__41", "book_id": "principles_of_psychology_james_1890", "name": "Fig. 41", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Fig. 41"], "contexts": ["diagram of impartial redintegration"]}, {"entity_id": "fig__54", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Fig. 54", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Fig. 54"], "contexts": ["illustration reference"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Fig. 41", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Fig. 54", "similarity": 0.914}], "id": 5815, "stable_key": "clu_45cb8a27b1908f3e", "ground_truth": {"modern_name": "Figure reference", "confidence": "high", "type": "object", "note": "This refers to a label for a visual element within a publication.", "wikidata_id": "Q21550668", "wikidata_description": "process of providing drawings or other pictures intended to elucidate a description, story, or other written material"}}, {"canonical_name": "Fig. 42", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fig__42", "book_id": "principles_of_psychology_james_1890", "name": "Fig. 42", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Fig. 42"], "contexts": ["diagram of mixed association"]}, {"entity_id": "fig__52", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Fig. 52", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Fig. 52"], "contexts": ["illustration reference"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Fig. 42", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Fig. 52", "similarity": 0.933}], "id": 5816, "stable_key": "clu_6082906f54165840", "ground_truth": {"modern_name": "Figure illustration", "confidence": "high", "type": "object", "note": "The terms 'Fig. 42' and 'Fig. 52' are references to specific illustrations or diagrams within the texts.", "wikidata_id": "Q21550668", "wikidata_description": "process of providing drawings or other pictures intended to elucidate a description, story, or other written material"}}, {"canonical_name": "uniformity of nature", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "uniformity_of_nature", "book_id": "principles_of_psychology_james_1890", "name": "uniformity of nature", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["uniformity of nature"], "contexts": ["belief that nature follows consistent laws"]}, {"entity_id": "natural_uniformity", "book_id": "first_principles_spencer_1862", "name": "natural uniformity", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["natural uniformity"], "contexts": ["consistent natural laws"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "uniformity of nature", "target_book": "first_principles_spencer_1862", "target_name": "natural uniformity", "similarity": 0.932}], "id": 5817, "stable_key": "clu_fda12c1ddaa8855a", "ground_truth": {"modern_name": "Uniformity of nature", "confidence": "high", "type": "concept", "wikidata_id": "Q208650", "wikidata_description": "assumption that the same natural laws and processes that operate in the universe here and now have operated always and everywhere", "wikipedia_url": "https://en.wikipedia.org/wiki/Uniformitarianism", "wikipedia_extract": "Uniformitarianism, also known as the Doctrine of Uniformity or the Uniformitarian Principle, is the assumption that the same natural laws and processes that operate in our present-day scientific observations have always operated in the universe in the past and apply everywhere in the universe. It refers to invariance in the metaphysical principles underpinning science, such as the constancy of cause and effect throughout space-time, but has also been used to describe spatiotemporal invariance of physical laws. Though an unprovable postulate that cannot be verified using the scientific method, some consider that uniformitarianism should be a required first principle in scientific research. In geology, uniformitarianism has included the gradualistic concept that \"the present is the key to the past\" and that geological events occur at the same rate now as they have always done, though many modern geologists no longer hold to a strict gradualism. Coined by William Whewell, uniformitarianism was originally proposed in contrast to catastrophism by British naturalists in the late 18th century, starting with the work of the geologist James Hutton in his many books including Theory of the Earth. Hutton's work was later refined by scientist John Playfair and popularised by geologist Charles Lyell's Principles of Geology in 1830."}}, {"canonical_name": "crescendo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "crescendo", "book_id": "principles_of_psychology_james_1890", "name": "crescendo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["crescendo"], "contexts": ["a gradual increase in loudness or intensity"]}, {"entity_id": "crescer", "book_id": "polyanthea_medicinal", "name": "crescer", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["crescer"], "contexts": ["to grow"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "crescendo", "target_book": "polyanthea_medicinal", "target_name": "crescer", "similarity": 0.9}], "id": 5818, "stable_key": "clu_3965dd3edba9e0d8", "ground_truth": {"modern_name": "Crescendo", "confidence": "high", "type": "concept", "note": "The early modern usage is consistent with the modern musical and general sense of gradual increase.", "wikidata_id": "Q2347888", "wikidata_description": "musical term indicating a gradual increase in dynamic strength"}}, {"canonical_name": "connection of our ideas", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "connection_of_our_ideas", "book_id": "principles_of_psychology_james_1890", "name": "connection of our ideas", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["connection of our ideas"], "contexts": ["relationship between mental concepts"]}, {"entity_id": "connections_of_ideas", "book_id": "first_principles_spencer_1862", "name": "connections of ideas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["connections of ideas"], "contexts": ["relationships between thoughts"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "connection of our ideas", "target_book": "first_principles_spencer_1862", "target_name": "connections of ideas", "similarity": 0.907}], "id": 5819, "stable_key": "clu_d6ac65f9591dc756-3", "ground_truth": {"modern_name": "Association of Ideas", "confidence": "high", "type": "concept", "wikidata_id": "Q744778", "wikidata_description": "connection between ideas or mental states due to similarity or proximity in psychology", "note": "This is a foundational concept in psychology, referring to how thoughts and memories are linked."}}, {"canonical_name": "psychologic acts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "psychologic_acts", "book_id": "principles_of_psychology_james_1890", "name": "psychologic acts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["psychologic acts"], "contexts": ["mental actions and processes"]}, {"entity_id": "mental_acts", "book_id": "first_principles_spencer_1862", "name": "mental acts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mental acts"], "contexts": ["cognitive processes involved in actions"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "psychologic acts", "target_book": "first_principles_spencer_1862", "target_name": "mental acts", "similarity": 0.941}], "id": 5820, "stable_key": "clu_827ab566d78df271", "ground_truth": {"modern_name": "Mental Acts", "confidence": "high", "type": "concept", "note": "Refers to the processes and actions of the mind."}}, {"canonical_name": "Ambition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ambition", "book_id": "principles_of_psychology_james_1890", "name": "Ambition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Ambition"], "contexts": ["social affection arising from transferred pleasure"]}, {"entity_id": "ambi\u00e7\u00e3o", "book_id": "polyanthea_medicinal", "name": "ambi\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ambi\u00e7\u00e3o"], "contexts": ["desire for power or success"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Ambition", "target_book": "polyanthea_medicinal", "target_name": "ambi\u00e7\u00e3o", "similarity": 0.979}], "id": 5821, "stable_key": "clu_011cfb1cc7ea0e97", "ground_truth": {"modern_name": "Ambition", "confidence": "high", "type": "concept", "wikidata_id": "Q3006977", "wikidata_description": "cruise ship built in 1999 with a capacity of 1727 passengers", "wikipedia_url": "https://en.wikipedia.org/wiki/MS_Ambition", "wikipedia_extract": "MS Ambition is a cruise ship operated by Ambassador Cruise Line. Completed in France as Mistral for Festival Cruises in 1999, she sailed between 2005 and 2019 as Grand Mistral with Ibero Cruises and Costa neoRiviera with Costa Cruises. The ship was in service as AIDAmira with AIDA Cruises, a subsidiary of Carnival Corporation & plc, until her sale in 2022 to Ambassador Cruise Line, who renamed her Ambition, commencing sailing in May 2023. It and its sister ship \"Ambience\" featured as the location of the third series of the television show \"The Cruise: Fun-Loving Brits at Sea\" The ship was originally ordered by Renaissance Cruises in mid 1996, but the order was later withdrawn. The yard and bankers together held ownership of the ship through a company called Auxiliaire Maritime. During construction at Chantiers de l'Atlantique, the order was taken over by Festival Cruises, which would receive its first new-build vessel."}}, {"canonical_name": "waterfall", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "waterfall", "book_id": "principles_of_psychology_james_1890", "name": "waterfall", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["waterfall"], "contexts": ["natural phenomenon with moving power"]}, {"entity_id": "waterfalls", "book_id": "kosmos_humboldt_1845", "name": "waterfalls", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["waterfalls"], "contexts": ["places with falling water"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "waterfall", "target_book": "kosmos_humboldt_1845", "target_name": "waterfalls", "similarity": 0.966}], "id": 5822, "stable_key": "clu_d21ef52e77b1a71d", "ground_truth": {"modern_name": "waterfall", "confidence": "high", "type": "place"}}, {"canonical_name": "human force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "human_force", "book_id": "principles_of_psychology_james_1890", "name": "human force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human force"], "contexts": ["power exerted by humans"]}, {"entity_id": "human_power", "book_id": "first_principles_spencer_1862", "name": "human power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human power"], "contexts": ["surplus power from economy of labour"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "human force", "target_book": "first_principles_spencer_1862", "target_name": "human power", "similarity": 0.898}], "id": 5823, "stable_key": "clu_b290a486413b44b2", "ground_truth": {"modern_name": "human power", "confidence": "high", "type": "concept", "wikidata_id": "Q11014191", "wikidata_description": "work or energy produced from the human body"}}, {"canonical_name": "roar", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "roar", "book_id": "principles_of_psychology_james_1890", "name": "roar", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["roar"], "contexts": ["loud, deep sound"]}, {"entity_id": "roar", "book_id": "connexion_physical_sciences_somerville_1858", "name": "roar", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["roar"], "contexts": ["loud, continuous sound"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "roar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "roar", "similarity": 1.0}], "id": 5824, "stable_key": "clu_cf29bfdb7a286f70", "ground_truth": {"modern_name": "roar", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "steam power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "steam_power", "book_id": "principles_of_psychology_james_1890", "name": "steam power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["steam power"], "contexts": ["mechanical force from steam"]}, {"entity_id": "steam-power", "book_id": "first_principles_spencer_1862", "name": "steam-power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["steam-power"], "contexts": ["driving force for industrial change"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "steam power", "target_book": "first_principles_spencer_1862", "target_name": "steam-power", "similarity": 0.984}], "id": 5825, "stable_key": "clu_cdcd60358eeb79ca", "ground_truth": {"modern_name": "steam power", "confidence": "high", "type": "concept", "wikidata_id": "Q1158818", "wikidata_description": "power plant, wherein the thermal energy is exploited by steam in a steam turbine"}}, {"canonical_name": "verse", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "verse", "book_id": "principles_of_psychology_james_1890", "name": "verse", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["verse"], "contexts": ["poetic structure with rhythm"]}, {"entity_id": "verses", "book_id": "first_principles_spencer_1862", "name": "verses", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["verses"], "contexts": ["lines of poetry"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "verse", "target_book": "first_principles_spencer_1862", "target_name": "verses", "similarity": 0.931}], "id": 5826, "stable_key": "clu_e1ce1a5519217e6e", "ground_truth": {"modern_name": "Verse", "confidence": "high", "type": "concept", "note": "In the context of early modern texts, 'verse' would refer to a line or lines of poetry, or by extension, a specific passage in religious or classical texts, rather than a specific psychological concept."}}, {"canonical_name": "intuitive or immediate perception", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "intuitive_or_immediate_perception", "book_id": "principles_of_psychology_james_1890", "name": "intuitive or immediate perception", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["intuitive or immediate perception"], "contexts": ["direct, unmediated awareness"]}, {"entity_id": "immediate_intuition", "book_id": "first_principles_spencer_1862", "name": "immediate intuition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["immediate intuition"], "contexts": ["direct and unmediated knowledge"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "intuitive or immediate perception", "target_book": "first_principles_spencer_1862", "target_name": "immediate intuition", "similarity": 0.903}], "id": 5827, "stable_key": "clu_08776b51bbfa2895", "ground_truth": {"modern_name": "Intuitive perception", "confidence": "high", "type": "concept", "note": "The concept of 'intuitive or immediate perception' and 'immediate intuition' refers to knowledge or awareness gained directly, without intermediary steps or reasoning. This is a well-established philosophical and psychological concept."}}, {"canonical_name": "interval", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "interval", "book_id": "principles_of_psychology_james_1890", "name": "interval", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["interval"], "contexts": ["space of time between events"]}, {"entity_id": "interval", "book_id": "connexion_physical_sciences_somerville_1858", "name": "interval", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["interval"], "contexts": ["space of time between events"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "interval", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "interval", "similarity": 1.0}], "id": 5828, "stable_key": "clu_8b25cd2acc56aab9", "ground_truth": {"modern_name": "Interval", "confidence": "high", "type": "concept", "note": "The term 'interval' in this context refers to a period of time between two events or a span of time."}}, {"canonical_name": "sequence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sequence", "book_id": "principles_of_psychology_james_1890", "name": "sequence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sequence"], "contexts": ["order of events"]}, {"entity_id": "sequence", "book_id": "first_principles_spencer_1862", "name": "sequence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sequence"], "contexts": ["order of events or items"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "sequence", "target_book": "first_principles_spencer_1862", "target_name": "sequence", "similarity": 1.0}], "id": 5829, "stable_key": "clu_c7fc7913632e3c4d", "ground_truth": {"modern_name": "Sequence", "confidence": "high", "type": "concept", "note": "The term 'sequence' refers to a series of events or items that follow one another in a particular order."}}, {"canonical_name": "respiratory movements", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "respiratory_movements", "book_id": "principles_of_psychology_james_1890", "name": "respiratory movements", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["respiratory movements"], "contexts": ["form regularly recurring sensations"]}, {"entity_id": "respiratory_actions", "book_id": "first_principles_spencer_1862", "name": "respiratory actions", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["respiratory actions"], "contexts": ["breathing processes"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "respiratory movements", "target_book": "first_principles_spencer_1862", "target_name": "respiratory actions", "similarity": 0.974}], "id": 5830, "stable_key": "clu_c29310d9f42eaf12", "ground_truth": {"modern_name": "respiratory muscles", "confidence": "high", "type": "concept", "wikidata_id": "Q754337", "wikidata_description": "muscles involved in breathing", "wikipedia_url": "https://en.wikipedia.org/wiki/Muscles%20of%20respiration", "wikipedia_extract": "The muscles of respiration are the muscles that contribute to inhalation and exhalation, by aiding in the expansion and contraction of the thoracic cavity. The diaphragm and, to a lesser extent, the intercostal muscles drive respiration during quiet breathing. The elasticity of these muscles is crucial to the health of the respiratory system and to maximize its functional capabilities. The diaphragm is the major muscle responsible for breathing. It is a thin, dome-shaped muscle that separates the abdominal cavity from the thoracic cavity. During inhalation, the diaphragm contracts, so that its center moves caudally (downward) and its edges move cranially (upward)."}}, {"canonical_name": "sensorium", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sensorium", "book_id": "principles_of_psychology_james_1890", "name": "sensorium", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["sensorium"], "contexts": ["part of brain receiving sensory input"]}, {"entity_id": "organasensuum", "book_id": "polyanthea_medicinal", "name": "organasensuum", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["organasensuum"], "contexts": ["organs of sense"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "sensorium", "target_book": "polyanthea_medicinal", "target_name": "organasensuum", "similarity": 0.917}], "id": 5831, "stable_key": "clu_27ab7783e50149df", "ground_truth": {"modern_name": "Sensorium", "confidence": "high", "type": "concept", "note": "Refers to the sensory apparatus or the part of the brain receiving sensory input."}}, {"canonical_name": "handkerchief", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "handkerchief", "book_id": "principles_of_psychology_james_1890", "name": "handkerchief", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["handkerchief"], "contexts": ["object used for remembering"]}, {"entity_id": "handkerchief", "book_id": "first_principles_spencer_1862", "name": "handkerchief", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["handkerchief"], "contexts": ["piece of cloth for wiping"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "handkerchief", "target_book": "first_principles_spencer_1862", "target_name": "handkerchief", "similarity": 1.0}], "id": 5832, "stable_key": "clu_cdea7cf5cd9b70fa", "ground_truth": {"modern_name": "Handkerchief", "confidence": "high", "type": "object", "wikidata_id": "Q192411", "wikidata_description": "piece of cloth for personal use", "wikipedia_url": "https://en.wikipedia.org/wiki/Pigeon_drop", "wikipedia_extract": "The pigeon drop or Spanish handkerchief or Chilean handkerchief is a confidence trick in which a victim (the mark or pigeon) is persuaded to pay to secure the right to a supposed large sum of money or valuable object. One of the con artists will typically claim to have found the money or valuable abandoned on the ground just before talking to the mark, or will place it on the ground beforehand and pretend to happen upon it at the same time as the mark, hence the term \"drop\". Typically the scam involves two or three scammers (con artists) performing together to defraud the mark. One will arrange to \"find\" a valuable item along with the mark in a public place, such as by leaving it on the ground for the mark to find or approaching them with it in hand. A second scammer will pass by and enter the conversation, seeming to provide an independent opinion. One of the two scammers will pose as someone senior and knowledgeable, such as a lawyer, banker, or businessperson, or the senior might be a third scammer posing as a boss or authority called by one of the others."}}, {"canonical_name": "tenacity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "tenacity", "book_id": "principles_of_psychology_james_1890", "name": "tenacity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tenacity"], "contexts": ["persistence in remembering"]}, {"entity_id": "tenacity", "book_id": "first_principles_spencer_1862", "name": "tenacity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tenacity"], "contexts": ["strength of material to resist breaking"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "tenacity", "target_book": "first_principles_spencer_1862", "target_name": "tenacity", "similarity": 1.0}], "id": 5833, "stable_key": "clu_54726e94a097471a", "ground_truth": {"modern_name": "Tenacity", "confidence": "high", "type": "concept", "note": "Covers both psychological persistence and material strength.", "wikidata_id": "Q7699426", "wikidata_description": "mineral's behavior when deformed or broken"}}, {"canonical_name": "immunity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "immunity", "book_id": "principles_of_psychology_james_1890", "name": "immunity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["immunity"], "contexts": ["resistance to harm"]}, {"entity_id": "immunidade", "book_id": "coloquios_da_orta_1563", "name": "immunidade", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["immunidade"], "contexts": ["protection from snake bites"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "immunity", "target_book": "coloquios_da_orta_1563", "target_name": "immunidade", "similarity": 0.99}], "id": 5834, "stable_key": "clu_a163a5067f8269e3", "ground_truth": {"modern_name": "immunity", "confidence": "high", "type": "concept", "note": "Both 'immunity' and 'immunidade' directly translate to the modern concept of immunity in a biological or medical context.", "wikidata_id": "Q182581", "wikidata_description": "state of being insusceptible or resistant to a noxious agent or process", "wikipedia_url": "https://en.wikipedia.org/wiki/Immunity%20%28medicine%29", "wikipedia_extract": "In biology, immunity is the state of being insusceptible or resistant to a noxious agent or process, especially a pathogen or infectious disease. Immunity may occur naturally or be produced by prior exposure or immunization. The immune system has innate and adaptive components. Innate immunity is present in all metazoans, immune responses: inflammatory responses and phagocytosis. The adaptive component, on the other hand, involves more advanced lymphatic cells that can distinguish between specific \"non-self\" substances in the presence of \"self\". The reaction to foreign substances is etymologically described as inflammation while the non-reaction to self substances is described as immunity."}}, {"canonical_name": "decay", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "decay", "book_id": "principles_of_psychology_james_1890", "name": "decay", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["decay"], "contexts": ["gradual decline"]}, {"entity_id": "decay", "book_id": "kosmos_humboldt_1845", "name": "decay", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["decay"], "contexts": ["process of decomposition"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "decay", "target_book": "kosmos_humboldt_1845", "target_name": "decay", "similarity": 1.0}], "id": 5835, "stable_key": "clu_35febdc666cb6f2e", "ground_truth": {"modern_name": "Decay", "confidence": "high", "type": "concept", "note": "Encompasses both biological decomposition and gradual decline.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Victor Hugo", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "victor_hugo", "book_id": "principles_of_psychology_james_1890", "name": "Victor Hugo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Victor Hugo"], "contexts": ["author of 'Satyr' poem"]}, {"entity_id": "victor_hugo", "book_id": "coloquios_da_orta_1563", "name": "Victor Hugo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Victor Hugo"], "contexts": ["author who introduced a term"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Victor Hugo", "target_book": "coloquios_da_orta_1563", "target_name": "Victor Hugo", "similarity": 1.0}], "id": 5836, "stable_key": "clu_08924e68b8a055fd", "ground_truth": {"modern_name": "Victor Hugo", "confidence": "high", "type": "person", "birth_year": 1802, "death_year": 1885, "description": "French poet, novelist, and playwright", "note": "The reference in 'coloquios_da_orta_1563' is likely a different individual or an anachronism, as Victor Hugo lived much later. The mention in 'principles_of_psychology_james_1890' aligns with his literary output."}}, {"canonical_name": "\u00c6neid", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "\u00e6neid", "book_id": "principles_of_psychology_james_1890", "name": "\u00c6neid", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["\u00c6neid"], "contexts": ["epic poem by Virgil"]}, {"entity_id": "\u00e6neid_", "book_id": "polyanthea_medicinal", "name": "\u00c6neid.", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["\u00c6neid."], "contexts": ["title of Virgil's epic poem"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "\u00c6neid", "target_book": "polyanthea_medicinal", "target_name": "\u00c6neid.", "similarity": 0.941}], "id": 5837, "stable_key": "clu_dd9da8eac045bb9c", "ground_truth": {"modern_name": "Aeneid", "confidence": "high", "type": "text", "note": "The mention in 'polyanthea_medicinal' might be a broader reference to classical texts or a specific medicinal preparation derived from classical knowledge.", "wikidata_id": "Q19537658", "wikidata_description": "1854 Portuguese translation by Mendes"}}, {"canonical_name": "engraving", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "engraving", "book_id": "principles_of_psychology_james_1890", "name": "engraving", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["engraving"], "contexts": ["print made from an engraved plate"]}, {"entity_id": "engravings", "book_id": "connexion_physical_sciences_somerville_1858", "name": "engravings", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["engravings"], "contexts": ["can be exactly copied by process"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "engraving", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "engravings", "similarity": 0.946}], "id": 5838, "stable_key": "clu_76397b8e539dbbd2", "ground_truth": {"modern_name": "engraving", "confidence": "high", "type": "object", "note": "The terms 'engraving' and 'engravings' refer to the artistic technique and the resulting printed image.", "wikidata_id": "Q1640824", "wikidata_description": "words, texts, lettering, or symbols marked on a work, building, or object, including texts, legends, documentation notes, or commemoration", "wikipedia_url": "https://en.wikipedia.org/wiki/Wood_engraving", "wikipedia_extract": "Wood engraving is a printmaking technique, in which an artist works an image into a block of wood. Functionally a variety of woodcut, it uses relief printing, where the artist applies ink to the face of the block and prints using relatively low pressure. The areas of the design that show ink when printed are those left uncut on the surface of the wood block. By contrast, ordinary engraving, like etching, uses a metal plate for the matrix and is printed by the intaglio method, where the ink fills the valleys, the removed areas. As a result of the relatively lower pressure used to print, the blocks for wood engravings deteriorate less quickly than the copper plates of engravings, and may have a distinctive white-on-black character. Thomas Bewick developed the wood engraving technique in Great Britain at the end of the 18th century."}}, {"canonical_name": "walls", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "walls", "book_id": "principles_of_psychology_james_1890", "name": "walls", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["walls"], "contexts": ["vertical structures enclosing a space"]}, {"entity_id": "walls", "book_id": "first_principles_spencer_1862", "name": "walls", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["walls"], "contexts": ["outer transformed part of heart cells"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "walls", "target_book": "first_principles_spencer_1862", "target_name": "walls", "similarity": 1.0}], "id": 5839, "stable_key": "clu_187691a79ec83eae", "ground_truth": {"modern_name": "cell walls", "confidence": "medium", "type": "concept", "note": "The context 'vertical structures enclosing a space' suggests architectural walls, while 'outer transformed part of heart cells' refers to biological cell walls. The term 'walls' alone is ambiguous without further context, but in a scientific text, biological structures are more likely.", "wikidata_id": "Q21181366", "wikidata_description": "process that results in the assembly, arrangement of constituent parts, or disassembly of the cell wall, the rigid or semi-rigid envelope lying outside the cell membrane of plant, fungal and most prokaryotic cells, maintaining their shape and prote"}}, {"canonical_name": "Bunsen", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bunsen", "book_id": "kosmos_humboldt_1845", "name": "Bunsen", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bunsen"], "contexts": ["learned scholar who applied expression to Cosmos"]}, {"entity_id": "bunsen", "book_id": "first_principles_spencer_1862", "name": "Bunsen", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bunsen"], "contexts": ["proposed language origin theory"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Bunsen", "target_book": "first_principles_spencer_1862", "target_name": "Bunsen", "similarity": 1.0}], "id": 5840, "stable_key": "clu_5a9beab61c5eded2", "ground_truth": {"modern_name": "Robert Bunsen", "confidence": "high", "type": "person", "birth_year": 1811, "death_year": 1899, "description": "German chemist known for spectroscopy and the Bunsen burner", "note": "Both mentions likely refer to the influential chemist Robert Bunsen, given his prominence in scientific discourse during the period.", "wikidata_id": "Q94824670", "wikidata_description": "German physician (1808-1882)"}}, {"canonical_name": "Himalaya Mountains", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "himalaya_mountains", "book_id": "kosmos_humboldt_1845", "name": "Himalaya Mountains", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Himalaya Mountains"], "contexts": ["rarity of palms and ferns"]}, {"entity_id": "himalaya_mountains", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Himalaya Mountains", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Himalaya Mountains"], "contexts": ["mountain range seen from Hindostan"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Himalaya Mountains", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Himalaya Mountains", "similarity": 1.0}], "id": 5841, "stable_key": "clu_7d5186e84304e8cc-2", "ground_truth": {"modern_name": "Himalayas", "confidence": "high", "type": "place", "description": "A major mountain range in Asia.", "wikipedia_extract": "The Himalayas, or Himalaya, is a mountain range in Asia separating the plains of the Indian subcontinent from the Tibetan Plateau. The range has some of the Earth's highest peaks, including the highest, Mount Everest. More than 100 peaks exceeding elevations of 7,200 m (23,600 ft) above sea level lie in the Himalayas. The Himalayas abut on or cross territories of five countries: Nepal, India, China, Bhutan and Pakistan. The sovereignty of the range in the Kashmir region is disputed among India, Pakistan, and China. The Himalayan range is bordered on the northwest by the Karakoram and Hindu Kush ranges, on the north by the Tibetan Plateau, and on the south by the Indo-Gangetic Plain."}}, {"canonical_name": "quantitative", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "quantitative", "book_id": "kosmos_humboldt_1845", "name": "quantitative", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["quantitative"], "contexts": ["abstraction based on number and magnitude"]}, {"entity_id": "quantitative", "book_id": "first_principles_spencer_1862", "name": "quantitative", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["quantitative"], "contexts": ["relating to quantity or amount"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "quantitative", "target_book": "first_principles_spencer_1862", "target_name": "quantitative", "similarity": 1.0}], "id": 5842, "stable_key": "clu_d69c41a2a1003bbf", "ground_truth": {"modern_name": "quantitative", "confidence": "high", "type": "concept"}}, {"canonical_name": "foci", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "foci", "book_id": "kosmos_humboldt_1845", "name": "foci", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["foci"], "contexts": ["centers or points of origin"]}, {"entity_id": "foci", "book_id": "connexion_physical_sciences_somerville_1858", "name": "foci", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["foci"], "contexts": ["points defining conic sections"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "foci", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "foci", "similarity": 1.0}], "id": 5843, "stable_key": "clu_25836a637fb96bf5", "ground_truth": {"modern_name": "foci", "confidence": "high", "type": "concept", "note": "Refers to points of origin or points defining conic sections.", "wikidata_id": "Q2736", "wikidata_description": "sport that is practiced between two teams of eleven players"}}, {"canonical_name": "Animal and vegetable life", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "animal_and_vegetable_life", "book_id": "kosmos_humboldt_1845", "name": "Animal and vegetable life", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Animal and vegetable life"], "contexts": ["study of animal and plant existence"]}, {"entity_id": "animal_and_vegetable_life", "book_id": "connexion_physical_sciences_somerville_1858", "name": "animal and vegetable life", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["animal and vegetable life"], "contexts": ["life forms on earth"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Animal and vegetable life", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "animal and vegetable life", "similarity": 0.997}], "id": 5844, "stable_key": "clu_dfbc8dfab6780163", "ground_truth": {"modern_name": "Plant life", "confidence": "high", "type": "concept", "wikidata_id": "Q2355817", "wikidata_description": "type (class) of plant"}}, {"canonical_name": "equator to the poles", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "equator_to_the_poles", "book_id": "kosmos_humboldt_1845", "name": "equator to the poles", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["equator to the poles"], "contexts": ["geographic zones from tropics to arctic"]}, {"entity_id": "poles_and_equator", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Poles and equator", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Poles and equator"], "contexts": ["geographic and astronomical reference points"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "equator to the poles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Poles and equator", "similarity": 0.898}], "id": 5845, "stable_key": "clu_3bb5a7d2b62d0c8d", "ground_truth": {"modern_name": "equator to poles", "confidence": "high", "type": "concept"}}, {"canonical_name": "cistus", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cistus", "book_id": "kosmos_humboldt_1845", "name": "cistus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cistus"], "contexts": ["plant found in uniform plains"]}, {"entity_id": "cisto", "book_id": "ricettario_fiorentino_1597", "name": "cisto", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cisto"], "contexts": ["plant genus related to ladano"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "cistus", "target_book": "ricettario_fiorentino_1597", "target_name": "cisto", "similarity": 0.927}], "id": 5846, "stable_key": "clu_f61f619cd488d308", "ground_truth": {"modern_name": "Cistus", "confidence": "high", "type": "plant", "linnaean": "Cistus L.", "family": "Cistaceae"}}, {"canonical_name": "Roger", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "roger", "book_id": "kosmos_humboldt_1845", "name": "Roger", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Roger"], "contexts": ["considered measurements of Mount Blanc"]}, {"entity_id": "rogerio", "book_id": "polyanthea_medicinal", "name": "Rogerio", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Rogerio"], "contexts": ["learned author"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Roger", "target_book": "polyanthea_medicinal", "target_name": "Rogerio", "similarity": 0.884}], "id": 5847, "stable_key": "clu_5355a3e05337da3c", "ground_truth": {"modern_name": "Roger Bacon", "confidence": "medium", "type": "person", "birth_year": 1214, "death_year": 1294, "description": "English philosopher, scientist, and Franciscan friar", "note": "The text mentions 'Roger' and 'Rogerio' in contexts of measurement and authorship, strongly suggesting Roger Bacon, a scholar known for scientific observations.", "wikidata_id": "Q171677", "wikidata_description": "English polymath, philosopher and friar (c.1219/20\u2013c.1292)"}}, {"canonical_name": "double-refracting prism", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "double-refracting_prism", "book_id": "kosmos_humboldt_1845", "name": "double-refracting prism", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["double-refracting prism"], "contexts": ["optical instrument for light separation"]}, {"entity_id": "doubly-refracting_prism", "book_id": "connexion_physical_sciences_somerville_1858", "name": "doubly-refracting prism", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["doubly-refracting prism"], "contexts": ["optical instrument for splitting light"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "double-refracting prism", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "doubly-refracting prism", "similarity": 0.983}], "id": 5848, "stable_key": "clu_d5243fe5d404fd72", "ground_truth": {"modern_name": "Doubly-refracting prism", "confidence": "high", "type": "object", "wikipedia_extract": "Polarimetry is the measurement and interpretation of the polarization of transverse waves, most notably electromagnetic waves, such as radio or light waves. Typically polarimetry is done on electromagnetic waves that have traveled through or have been reflected, refracted or diffracted by some material in order to characterize that object. Polarimetry is used in biomedical imaging as well as remote sensing applications, such as planetary science, astronomy, and weather radar. Polarimetry of thin films and surfaces is commonly known as ellipsometry. Polarimetry can also be included in computational analysis of waves. For example, radars often consider wave polarization in post-processing to improve the characterization of the targets.", "wikipedia_url": "https://en.wikipedia.org/wiki/Polarimetry"}}, {"canonical_name": "prismatic micrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "prismatic_micrometer", "book_id": "kosmos_humboldt_1845", "name": "prismatic micrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["prismatic micrometer"], "contexts": ["instrument using prisms for measurement"]}, {"entity_id": "micrometer", "book_id": "connexion_physical_sciences_somerville_1858", "name": "micrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["micrometer"], "contexts": ["instrument for measuring small distances"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "prismatic micrometer", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "micrometer", "similarity": 0.914}], "id": 5849, "stable_key": "clu_100c83f2977a9376", "ground_truth": {"wikipedia_extract": "A microscope (from Ancient Greek  \u03bc\u03b9\u03ba\u03c1\u03cc\u03c2 (mikr\u00f3s) 'small' and  \u03c3\u03ba\u03bf\u03c0\u03ad\u03c9 (skop\u00e9\u014d) 'to look (at); examine, inspect') is a laboratory instrument used to examine objects that are too small to be seen by the naked eye. Microscopy is the science of investigating small objects and structures using a microscope. Microscopic means being invisible to the eye unless aided by a microscope. There are many types of microscopes, and they may be grouped in different ways. One way is to describe the method an instrument uses to interact with a sample and produce images, either by sending a beam of light or electrons through a sample in its optical path, by detecting photon emissions from a sample, or by scanning across and a short distance from the surface of a sample using a probe. The most common microscope (and the first to be invented) is the optical microscope, which uses lenses to refract visible light that passed through a thinly sectioned sample to produce an observable image."}}, {"canonical_name": "capsule", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "capsule", "book_id": "kosmos_humboldt_1845", "name": "capsule", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["capsule"], "contexts": ["part of a moss sporophyte"]}, {"entity_id": "c\u00e1psulas", "book_id": "coloquios_da_orta_1563", "name": "c\u00e1psulas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["c\u00e1psulas"], "contexts": ["part of the poppy plant"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "capsule", "target_book": "coloquios_da_orta_1563", "target_name": "c\u00e1psulas", "similarity": 0.902}], "id": 5850, "stable_key": "clu_ea532e1d082b11ae", "ground_truth": {"modern_name": "capsule", "confidence": "high", "type": "concept", "note": "The term 'capsule' in early modern texts can refer to a botanical structure (like in mosses) or a medicinal preparation, making it a concept with multiple applications.", "wikidata_id": "Q519410", "wikidata_description": "relatively stable shell containing medicine"}}, {"canonical_name": "cold regions", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cold_regions", "book_id": "kosmos_humboldt_1845", "name": "cold regions", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["cold regions"], "contexts": ["areas of low temperature on Earth"]}, {"entity_id": "frigid_zones", "book_id": "connexion_physical_sciences_somerville_1858", "name": "frigid zones", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["frigid zones"], "contexts": ["polar regions of the Earth"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "cold regions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "frigid zones", "similarity": 0.955}], "id": 5851, "stable_key": "clu_df45130630d79ded-3", "ground_truth": {"modern_name": "Polar regions", "confidence": "high", "type": "place", "wikidata_id": "Q60670", "wikidata_description": "regions around the Earth's geographical poles", "wikipedia_url": "https://en.wikipedia.org/wiki/Polar%20regions%20of%20Earth", "country": "Antarctica, Arctic", "wikipedia_extract": "The polar regions, also called the frigid zones or polar zones, of Earth are Earth's polar ice caps, the regions of the planet that surround its geographical poles (the North Pole and the South Pole), lying within the polar circles. These high latitudes are dominated by floating sea ice covering much of the Arctic Ocean in the north, and by the Antarctic ice sheet on the continent of Antarctica and the Southern Ocean in the south. The Arctic has various definitions, including the region north of the Arctic Circle (currently Epoch 2010 at 66\u00b033'44\" N), or just the region north of 60\u00b0 north latitude, or the region from the North Pole south to the timberline. The Antarctic is usually defined simply as south of 60\u00b0 south latitude, or the continent of Antarctica. The 1959 Antarctic Treaty uses the former definition. The two polar regions are distinguished from the other two climatic and biometric belts of Earth, a tropics belt near the equator, and two middle latitude regions located between the tropics and polar regions."}}, {"canonical_name": "equatorial axis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "equatorial_axis", "book_id": "kosmos_humboldt_1845", "name": "equatorial axis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["equatorial axis"], "contexts": ["axis of the globe at the equator"]}, {"entity_id": "equatorial_axes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "equatorial axes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["equatorial axes"], "contexts": ["diameter of planet at equator"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "equatorial axis", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "equatorial axes", "similarity": 0.966}], "id": 5852, "stable_key": "clu_5b6bbaeab6e3f9b2", "ground_truth": {"modern_name": "Equatorial diameter", "confidence": "high", "type": "concept", "note": "The 'equatorial axis' in early modern texts refers to the diameter of a celestial body or planet that lies along the equator. This is synonymous with the equatorial diameter."}}, {"canonical_name": "fine arts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fine_arts", "book_id": "kosmos_humboldt_1845", "name": "fine arts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fine arts"], "contexts": ["art forms valued for beauty"]}, {"entity_id": "fine_arts", "book_id": "first_principles_spencer_1862", "name": "Fine Arts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Fine Arts"], "contexts": ["artistic expressions and their development"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "fine arts", "target_book": "first_principles_spencer_1862", "target_name": "Fine Arts", "similarity": 0.961}], "id": 5853, "stable_key": "clu_582bba5479cd7e5a", "ground_truth": {"modern_name": "Fine arts", "confidence": "high", "type": "concept"}}, {"canonical_name": "political institutions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "political_institutions", "book_id": "kosmos_humboldt_1845", "name": "political institutions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["political institutions"], "contexts": ["structures of government and governance"]}, {"entity_id": "governmental_institutions", "book_id": "first_principles_spencer_1862", "name": "governmental institutions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["governmental institutions"], "contexts": ["structures for governing a society"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "political institutions", "target_book": "first_principles_spencer_1862", "target_name": "governmental institutions", "similarity": 0.908}], "id": 5854, "stable_key": "clu_ad5b053fc25e5b07", "ground_truth": {"modern_name": "Political institutions", "confidence": "high", "type": "concept"}}, {"canonical_name": "Philosophy of the Inductive Sciences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "philosophy_of_the_inductive_sciences", "book_id": "kosmos_humboldt_1845", "name": "Philosophy of the Inductive Sciences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Philosophy of the Inductive Sciences"], "contexts": ["work on inductive sciences"]}, {"entity_id": "the_philosophy_of_the_inductive_sciences", "book_id": "first_principles_spencer_1862", "name": "The Philosophy of the Inductive Sciences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["The Philosophy of the Inductive Sciences"], "contexts": ["work on scientific philosophy"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Philosophy of the Inductive Sciences", "target_book": "first_principles_spencer_1862", "target_name": "The Philosophy of the Inductive Sciences", "similarity": 0.987}], "id": 5855, "stable_key": "clu_022caa9b73a4f12e", "ground_truth": {"modern_name": "Philosophy of the Inductive Sciences", "confidence": "high", "type": "text", "note": "This refers to the specific title of a work by William Whewell.", "wikidata_id": "Q42194234", "wikidata_description": ""}}, {"canonical_name": "families of plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "families_of_plants", "book_id": "kosmos_humboldt_1845", "name": "families of plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["families of plants"], "contexts": ["taxonomic groups of plants"]}, {"entity_id": "vegetable_families", "book_id": "connexion_physical_sciences_somerville_1858", "name": "vegetable families", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["vegetable families"], "contexts": ["other plant groups"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "families of plants", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "vegetable families", "similarity": 0.941}], "id": 5856, "stable_key": "clu_95f4a543cc9996c0", "ground_truth": {"modern_name": null, "confidence": "high", "type": "concept", "wikidata_id": "Q1138178", "wikidata_description": "the study of relation between plant species and genera"}}, {"canonical_name": "our planet", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "our_planet", "book_id": "kosmos_humboldt_1845", "name": "our planet", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["our planet"], "contexts": ["Earth"]}, {"entity_id": "nossa_terra", "book_id": "coloquios_da_orta_1563", "name": "nossa terra", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["nossa terra"], "contexts": ["local origin of the herb"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "our planet", "target_book": "coloquios_da_orta_1563", "target_name": "nossa terra", "similarity": 0.905}], "id": 5857, "stable_key": "clu_f522307c9c5c037e-4", "ground_truth": {"modern_name": "Earth", "confidence": "high", "type": "place", "country": "Global", "wikidata_id": "Q36133", "wikidata_description": "natural body consisting of layers that are primarily composed of minerals", "wikipedia_url": "https://en.wikipedia.org/wiki/Soil", "wikipedia_extract": "Soil, also commonly referred to as earth, is a mixture of organic matter, minerals, gases, water, and organisms that together support the life of plants and soil organisms. Some scientific definitions distinguish dirt from soil by restricting the former term specifically to displaced soil. Soil consists of a solid collection of minerals and organic matter (the soil matrix), as well as a porous phase that holds gases (the soil atmosphere) and a liquid phase that holds water and dissolved substances both organic and inorganic, in ionic or in molecular form (the soil solution). Accordingly, soil is a complex three-state system of solids, liquids, and gases. Soil is a product of several factors: the influence of climate, relief (elevation, orientation, and slope of terrain), organisms, and the soil's parent materials (original minerals) interacting over time. It continually undergoes development by way of numerous physical, chemical and biological processes, which include weathering with associated erosion.", "note": "The term 'terra' or 'terre' in early modern texts can refer to the planet Earth, or to mineral earths used in medicine or as impurities."}}, {"canonical_name": "dynamical laws", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dynamical_laws", "book_id": "kosmos_humboldt_1845", "name": "dynamical laws", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["dynamical laws"], "contexts": ["laws governing motion and forces"]}, {"entity_id": "dynamical_law", "book_id": "connexion_physical_sciences_somerville_1858", "name": "dynamical law", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["dynamical law"], "contexts": ["laws governing celestial motion"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "dynamical laws", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "dynamical law", "similarity": 0.974}], "id": 5858, "stable_key": "clu_e621a6d0da04efe6-2", "ground_truth": {"modern_name": "Physical Laws", "confidence": "high", "type": "concept", "note": "The terms 'mechanical laws', 'physical laws', and 'mechanical natural law' all refer to the fundamental principles governing the physical universe.", "wikidata_id": "Q214070", "wikidata_description": "scientific law of physics", "wikipedia_url": "https://en.wikipedia.org/wiki/Physical%20law"}}, {"canonical_name": "laws of motion", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "laws_of_motion", "book_id": "kosmos_humboldt_1845", "name": "laws of motion", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["laws of motion"], "contexts": ["principles governing movement of objects"]}, {"entity_id": "laws_of_compound_motion", "book_id": "first_principles_spencer_1862", "name": "laws of compound motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["laws of compound motion"], "contexts": ["principles of combined movements"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "laws of motion", "target_book": "first_principles_spencer_1862", "target_name": "laws of compound motion", "similarity": 0.909}], "id": 5859, "stable_key": "clu_a174657e17a4f4db", "ground_truth": {"modern_name": "laws of motion", "confidence": "high", "type": "concept", "note": "The cluster explicitly mentions 'law of motion' and 'law of direction of Motion', directly referring to Newton's laws of motion or similar principles governing movement.", "wikidata_id": "Q38433", "wikidata_description": "classical formulation of Mechanics by Isaac Newton"}}, {"canonical_name": "masses", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "masses", "book_id": "kosmos_humboldt_1845", "name": "masses", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["masses"], "contexts": ["quantity of matter, celestial bodies"]}, {"entity_id": "masses", "book_id": "first_principles_spencer_1862", "name": "masses", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["masses"], "contexts": ["respective masses will generate"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "masses", "target_book": "first_principles_spencer_1862", "target_name": "masses", "similarity": 0.768}], "id": 5860, "stable_key": "clu_5f2d5ee83971533b", "ground_truth": {"modern_name": "Mass", "confidence": "high", "type": "concept", "note": "Refers to the physical property of matter or collections of matter.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Mass", "wikipedia_extract": "Mass is an intrinsic property of a body. In modern physics, it is generally defined as the strength of an object's gravitational attraction to other bodies - as measured by an observer moving along at the same speed. It was traditionally believed to be related to the quantity of matter in a body, until the discovery of the atom and particle physics. It was found that different atoms and different elementary particles, theoretically with the same amount of matter, have nonetheless different masses. Mass in modern physics has multiple definitions which are conceptually distinct, but physically equivalent. Mass can be experimentally defined as a measure of the body's inertia, meaning the resistance to acceleration (change of velocity) when a net force is applied."}}, {"canonical_name": "celestial", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "celestial", "book_id": "kosmos_humboldt_1845", "name": "celestial", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["celestial"], "contexts": ["relating to the sky"]}, {"entity_id": "celestial", "book_id": "connexion_physical_sciences_somerville_1858", "name": "celestial", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["celestial"], "contexts": ["relating to the sky or heavens"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "celestial", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "celestial", "similarity": 1.0}], "id": 5861, "stable_key": "clu_f864a4815d70e501", "ground_truth": {"modern_name": null, "confidence": "high", "type": "concept", "note": "Refers to things related to the sky or heavens, often in the context of astronomy.", "wikidata_id": "Q6999", "wikidata_description": "physical body of astronomically-significant size, mass, or role, naturally occurring in a universe"}}, {"canonical_name": "condition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "condition", "book_id": "kosmos_humboldt_1845", "name": "condition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["condition"], "contexts": ["state or requirement"]}, {"entity_id": "condi\u00e7\u00e3o", "book_id": "polyanthea_medicinal", "name": "condi\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["condi\u00e7\u00e3o"], "contexts": ["quality or state"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "condition", "target_book": "polyanthea_medicinal", "target_name": "condi\u00e7\u00e3o", "similarity": 0.966}], "id": 5862, "stable_key": "clu_0665c32d118b0081", "ground_truth": {"modern_name": "condition", "confidence": "high", "type": "concept", "wikidata_id": "Q12136", "wikidata_description": "abnormal condition negatively affecting organisms", "wikipedia_url": "https://en.wikipedia.org/wiki/Disease", "wikipedia_extract": "A disease is a particular abnormal condition that adversely affects the structure or function of all or part of an organism and is not immediately due to any external injury. Diseases are often known to be medical conditions that are associated with specific signs and symptoms. A disease may be caused by external factors such as pathogens or by internal dysfunctions. For example, internal dysfunctions of the immune system can produce a variety of different diseases, including various forms of immunodeficiency, hypersensitivity, allergies, and autoimmune disorders. In humans, disease is often used more broadly to refer to any condition that causes pain, dysfunction, distress, social problems, or death to the person affected, or similar problems for those in contact with the person. In this broader sense, it sometimes includes injuries, disabilities, disorders, syndromes, infections, isolated symptoms, deviant behaviors, and atypical variations of structure and function, while in other contexts and for other purposes these may be considered distinguishable categories."}}, {"canonical_name": "vegetable and animal matter", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "vegetable_and_animal_matter", "book_id": "kosmos_humboldt_1845", "name": "vegetable and animal matter", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vegetable and animal matter"], "contexts": ["substances from plants and animals"]}, {"entity_id": "animal_and_vegetable_matter", "book_id": "connexion_physical_sciences_somerville_1858", "name": "animal and vegetable matter", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["animal and vegetable matter"], "contexts": ["diamagnetic substances"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "vegetable and animal matter", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "animal and vegetable matter", "similarity": 0.98}], "id": 5863, "stable_key": "clu_f71e71a670c7203e", "ground_truth": {"modern_name": "organic matter", "confidence": "high", "type": "concept", "note": "This refers to matter derived from living organisms, encompassing both plant and animal origins.", "wikidata_id": "Q1783121", "wikidata_description": "matter composed of organic compounds"}}, {"canonical_name": "Giordano Bruno", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "giordano_bruno", "book_id": "kosmos_humboldt_1845", "name": "Giordano Bruno", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Giordano Bruno"], "contexts": ["author of philosophical work"]}, {"entity_id": "giordano_bruno", "book_id": "first_principles_spencer_1862", "name": "Giordano Bruno", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Giordano Bruno"], "contexts": ["Renaissance philosopher and cosmologist"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Giordano Bruno", "target_book": "first_principles_spencer_1862", "target_name": "Giordano Bruno", "similarity": 1.0}], "id": 5864, "stable_key": "clu_fdd1dcb9603c65e9", "ground_truth": {"modern_name": "Giordano Bruno", "confidence": "high", "type": "person", "birth_year": 1548, "death_year": 1600, "description": "Renaissance philosopher, astronomer, and mathematician.", "wikidata_id": "Q36330", "wikidata_description": "Italian Dominican friar, philosopher and mathematician (1548\u20131600)", "wikipedia_url": "https://en.wikipedia.org/wiki/Giordano_Bruno", "wikipedia_extract": "The unicursal hexagram is a hexagram or six-pointed star that can be traced or drawn unicursally, in one continuous line rather than by two overlaid triangles. The hexagram can also be depicted inside a circle with the points touching it. It is often depicted in an interlaced form with the lines of the hexagram passing over and under one another to form a knot. It is a specific instance of the far more general shape discussed in Blaise Pascal's 1639 Hexagrammum Mysticum. In his work titled Essays upon the Mathematics of Mordente: One Hundred and Sixty Articles against the Mathematicians and Philosophers of this Age (Prague: 1588), Italian philosopher, cosmological theorist, and Hermetic occultist Giordano Bruno used a symbol called Figura Amoris (\"figure of love\") part of the Hermetic trinity in his mathesis. This figure has a square outline; within it are the six lines of a unicursal hexagram."}}, {"canonical_name": "Anaximenes", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "anaximenes", "book_id": "kosmos_humboldt_1845", "name": "Anaximenes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Anaximenes"], "contexts": ["ancient philosopher of condensation"]}, {"entity_id": "anaximenes", "book_id": "historia_medicinal_monardes_1574", "name": "AnaXimenes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["AnaXimenes"], "contexts": ["philosopher"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Anaximenes", "target_book": "historia_medicinal_monardes_1574", "target_name": "AnaXimenes", "similarity": 0.854}], "id": 5865, "stable_key": "clu_59528cc7e0f22f99", "ground_truth": {"modern_name": "Anaximenes", "confidence": "high", "type": "person", "birth_year": -586, "death_year": -528, "description": "Ancient Greek philosopher, proponent of air as the fundamental substance."}}, {"canonical_name": "pine wood", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pine_wood", "book_id": "kosmos_humboldt_1845", "name": "pine wood", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["pine wood"], "contexts": ["plant material with specific density"]}, {"entity_id": "pine", "book_id": "connexion_physical_sciences_somerville_1858", "name": "pine", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["pine"], "contexts": ["evergreen coniferous tree"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "pine wood", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "pine", "similarity": 0.963}], "id": 5866, "stable_key": "clu_39b28c9774d76de8-4", "ground_truth": {"modern_name": "Pine", "confidence": "high", "type": "plant", "linnaean": "Pinus", "family": "Pinaceae", "wikidata_id": "Q1258277", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Pinellia%20ternata", "note": "'pine-apple' in Darwin's *Origin of Species* is an archaic term for the fruit of the pineapple plant, but the presence of 'pines' and 'pineta' referring to coniferous trees in other contexts makes 'Pine' the most encompassing modern referent.", "wikipedia_extract": "Pinellia ternata (Chinese: \u534a\u590f, Japanese: \u30ab\u30e9\u30b9\u30d3\u30b7\u30e3\u30af), crow-dipper, is a plant that is native to China, Japan, and Korea. However, it also grows as an invasive weed in parts of Europe (Austria, Germany) and in North America (California, Ontario, the northeastern United States). The leaves are trifoliate, and the flowers are of the spathe and spadix form that is typical of plants in the family Araceae. The plant spreads by rhizomes, and there are also small bulblets (also known as bulbils) at the base of each leaf. Flowers are borne in spring. This plant is toxic in raw form and must be processed."}}, {"canonical_name": "major axes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "major_axes", "book_id": "kosmos_humboldt_1845", "name": "major axes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["major axes"], "contexts": ["largest diameter of an ellipse"]}, {"entity_id": "axis_major", "book_id": "first_principles_spencer_1862", "name": "axis major", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["axis major"], "contexts": ["longest diameter of an ellipse"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "major axes", "target_book": "first_principles_spencer_1862", "target_name": "axis major", "similarity": 0.934}], "id": 5867, "stable_key": "clu_daf71bfcc0d44a7c", "ground_truth": {"modern_name": "major axis", "confidence": "high", "type": "concept", "note": "Refers to the longest diameter of an ellipse or other conic section.", "wikidata_id": "Q66617704", "wikidata_description": "scientific article"}}, {"canonical_name": "Du Sejour", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "du_sejour", "book_id": "kosmos_humboldt_1845", "name": "Du Sejour", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Du Sejour"], "contexts": ["calculated comet 837's distance from Earth"]}, {"entity_id": "dusejour", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Dusejour", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Dusejour"], "contexts": ["calculated comet passage times and effects"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Du Sejour", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Dusejour", "similarity": 0.799}], "id": 5868, "stable_key": "clu_ac97c45b7a76cf0a", "ground_truth": {"modern_name": "M. Dutour", "confidence": "medium", "type": "person", "description": "Astronomer who calculated comet distances and passages.", "note": "The name 'Du Sejour'/'Dusejour' is likely a misspelling or variant of 'Dutour', as historical records point to M. Dutour (often referred to as 'M. Dutour of the Academy') as a contemporary astronomer involved in comet calculations. Without more context, certainty is limited."}}, {"canonical_name": "vibratory motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "vibratory_motion", "book_id": "kosmos_humboldt_1845", "name": "vibratory motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vibratory motion"], "contexts": ["type of motion observed"]}, {"entity_id": "vibratory_motion", "book_id": "connexion_physical_sciences_somerville_1858", "name": "vibratory motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vibratory motion"], "contexts": ["particle movement for induction"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "vibratory motion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "vibratory motion", "similarity": 1.0}], "id": 5869, "stable_key": "clu_47a6f4be08a03516", "ground_truth": {"modern_name": "Vibrational motion", "confidence": "high", "type": "concept"}}, {"canonical_name": "comet of 1819", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "comet_of_1819", "book_id": "kosmos_humboldt_1845", "name": "comet of 1819", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["comet of 1819"], "contexts": ["celestial body observed for light"]}, {"entity_id": "comet_of_1825", "book_id": "connexion_physical_sciences_somerville_1858", "name": "comet of 1825", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["comet of 1825"], "contexts": ["specific comet observed in 1825"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "comet of 1819", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "comet of 1825", "similarity": 0.915}], "id": 5870, "stable_key": "clu_079f44aeb6c7ff62", "ground_truth": {"modern_name": "Comet of 1819", "confidence": "medium", "type": "object", "note": "The cluster mentions both 'comet of 1819' and 'comet of 1825'. As the object is a specific celestial event, the earlier date is generally considered the primary reference point unless context strongly suggests otherwise. The '1825' might be a subsequent mention or a slightly different observation."}}, {"canonical_name": "1618", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "1618", "book_id": "kosmos_humboldt_1845", "name": "1618", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["1618"], "contexts": ["year of comet observation"]}, {"entity_id": "1618", "book_id": "connexion_physical_sciences_somerville_1858", "name": "1618", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["1618"], "contexts": ["year of a notable comet appearance"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "1618", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "1618", "similarity": 1.0}], "id": 5871, "stable_key": "clu_10fe3ef716fcfa62", "ground_truth": {"modern_name": "1618", "confidence": "high", "type": "concept", "note": "This refers to the year 1618, often associated with astronomical events like comet appearances.", "wikidata_id": "Q13634731", "wikidata_description": "natural number"}}, {"canonical_name": "perturbations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "perturbations", "book_id": "kosmos_humboldt_1845", "name": "perturbations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["perturbations"], "contexts": ["deviations from regular orbital motion"]}, {"entity_id": "perturbations", "book_id": "first_principles_spencer_1862", "name": "perturbations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["perturbations"], "contexts": ["deviations in celestial orbits"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "perturbations", "target_book": "first_principles_spencer_1862", "target_name": "perturbations", "similarity": 1.0}], "id": 5872, "stable_key": "clu_1996fe26a14d6596", "ground_truth": {"modern_name": "Orbital perturbation", "confidence": "high", "type": "concept", "note": "Contexts clearly indicate astronomical deviations from ideal orbits.", "wikidata_id": "Q7100083", "wikidata_description": "", "wikipedia_url": "https://en.wikipedia.org/wiki/Orbital%20perturbation%20analysis"}}, {"canonical_name": "terrestrial attraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "terrestrial_attraction", "book_id": "kosmos_humboldt_1845", "name": "terrestrial attraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["terrestrial attraction"], "contexts": ["force of gravity from Earth"]}, {"entity_id": "earth\u2019s_attraction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "earth\u2019s attraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["earth\u2019s attraction"], "contexts": ["gravitational pull of Earth"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "terrestrial attraction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "earth\u2019s attraction", "similarity": 0.928}], "id": 5873, "stable_key": "clu_4af905639d656f13-4", "ground_truth": {"modern_name": "Gravity", "confidence": "high", "type": "concept", "wikidata_id": "Q11412", "wikidata_description": "fundamental interaction affecting all matter", "wikipedia_url": "https://en.wikipedia.org/wiki/Gravity", "note": "Early modern texts often referred to 'terrestrial attraction' or 'earth's attraction' when discussing gravity, particularly in relation to Isaac Newton's work.", "wikipedia_extract": "In physics, gravity (from Latin  gravitas 'weight'), also known as gravitation or a gravitational interaction, is a fundamental interaction, which may be described as the force that draws material objects towards each other. The gravitational attraction between clouds of primordial hydrogen and clumps of dark matter in the early universe caused the hydrogen gas to coalesce, eventually condensing and fusing to form stars. At larger scales this resulted in galaxies and clusters, so gravity is a primary driver for the large-scale structures in the universe. Gravity has an infinite range, although its effects become weaker as objects get farther away. Gravity is described by the general theory of relativity, proposed by Albert Einstein in 1915, which describes gravity in terms of the curvature of spacetime, caused by the uneven distribution of mass. The most extreme example of this curvature of spacetime is a black hole, from which nothing\u2014not even light\u2014can escape once past the black hole's event horizon."}}, {"canonical_name": "Sun's longitudes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sun's_longitudes", "book_id": "kosmos_humboldt_1845", "name": "Sun's longitudes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Sun's longitudes"], "contexts": ["astronomical measurement"]}, {"entity_id": "sun\u2019s_longitude", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sun\u2019s longitude", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sun\u2019s longitude"], "contexts": ["calculated from moon"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Sun's longitudes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sun\u2019s longitude", "similarity": 0.966}], "id": 5874, "stable_key": "clu_897e6f8557932b78", "ground_truth": {"modern_name": "Heliocentric longitude", "confidence": "high", "type": "concept", "note": "The context of the Sun's longitudes, especially in early modern astronomy, points to its position or angular distance within the solar system, often measured from a heliocentric perspective or related calculations."}}, {"canonical_name": "silicate of magnesia", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "silicate_of_magnesia", "book_id": "kosmos_humboldt_1845", "name": "silicate of magnesia", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["silicate of magnesia"], "contexts": ["compound found in cosmical bodies"]}, {"entity_id": "alu-minato_de_magnesia", "book_id": "coloquios_da_orta_1563", "name": "alu-minato de magnesia", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["alu-minato de magnesia"], "contexts": ["chemical composition"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "silicate of magnesia", "target_book": "coloquios_da_orta_1563", "target_name": "alu-minato de magnesia", "similarity": 0.895}], "id": 5875, "stable_key": "clu_ab20b522133988fb", "ground_truth": {"modern_name": "magnesium silicate", "confidence": "high", "type": "chemical", "note": "A compound containing magnesium and silicon, likely referring to a mineral or a specific chemical formulation.", "wikidata_id": "Q17374115", "wikidata_description": "chemical compound"}}, {"canonical_name": "Ispahan", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ispahan", "book_id": "kosmos_humboldt_1845", "name": "Ispahan", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Ispahan"], "contexts": ["city where light was observed"]}, {"entity_id": "ispahan", "book_id": "coloquios_da_orta_1563", "name": "Ispahan", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Ispahan"], "contexts": ["city where Avicenna served later"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Ispahan", "target_book": "coloquios_da_orta_1563", "target_name": "Ispahan", "similarity": 1.0}], "id": 5876, "stable_key": "clu_ae65a0a49781bc6c", "ground_truth": {"modern_name": "Isfahan", "confidence": "high", "type": "place", "country": "Iran", "wikidata_id": "Q42053", "wikidata_description": "city in Isfahan Province, Iran", "wikipedia_extract": "The Isfahan School (Persian:  \u0645\u0643\u062a\u0628 \u0627\u0635\u0641\u0647\u0627\u0646 ) is a school of Islamic philosophy. It was founded by Mir Damad and reached its fullest development in the work of Mulla Sadra. The name was coined by Seyyed Hossein Nasr and Henry Corbin. Because of the attention of Shah Abbas during the Safavid dynasty in Iran to intellectual tradition in Islam, Isfahan became a famous academic city and the intellectual center of Iran at the time, along with the cities of Ray and Shiraz. This school of thought began to develop once Iran was economically and politically stable. The Safavid court also provided funding for the arts, which also contributed to the development.", "wikipedia_url": "https://en.wikipedia.org/wiki/School_of_Isfahan"}}, {"canonical_name": "Mary Somerville", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mary_somerville", "book_id": "kosmos_humboldt_1845", "name": "Mary Somerville", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Mary Somerville"], "contexts": ["writer on physical sciences"]}, {"entity_id": "mary_somerville", "book_id": "connexion_physical_sciences_somerville_1858", "name": "MARY SOMERVILLE", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["MARY SOMERVILLE"], "contexts": ["authoress of scientific works"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Mary Somerville", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "MARY SOMERVILLE", "similarity": 0.874}], "id": 5877, "stable_key": "clu_4b02f4b608be2a23", "ground_truth": {"modern_name": "Mary Somerville", "confidence": "high", "type": "person", "birth_year": 1780, "death_year": 1872, "description": "Scottish scientist and writer on physical sciences"}}, {"canonical_name": "1831", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "1831", "book_id": "kosmos_humboldt_1845", "name": "1831", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["1831"], "contexts": ["year of anomalous twilight augmentation"]}, {"entity_id": "1831", "book_id": "connexion_physical_sciences_somerville_1858", "name": "1831", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["1831"], "contexts": ["year of a meteoric shower"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "1831", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "1831", "similarity": 1.0}], "id": 5878, "stable_key": "clu_7c2b852f84f99399", "ground_truth": {"modern_name": "1831", "confidence": "high", "type": "concept", "note": "This refers to the year 1831, likely in the context of scientific discoveries or observations.", "wikidata_id": "Q21084427", "wikidata_description": "Parliament of the United Kingdom, 1831-1832"}}, {"canonical_name": "quantity of matter", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "quantity_of_matter", "book_id": "kosmos_humboldt_1845", "name": "quantity of matter", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["quantity of matter"], "contexts": ["amount of substance"]}, {"entity_id": "quantity_of_matter", "book_id": "connexion_physical_sciences_somerville_1858", "name": "quantity of matter", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["quantity of matter"], "contexts": ["measure of substance in an object"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "quantity of matter", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "quantity of matter", "similarity": 1.0}], "id": 5879, "stable_key": "clu_641a4764da3d829c", "ground_truth": {"modern_name": "Mass", "confidence": "high", "type": "concept", "note": "The phrase 'quantity of matter' was a precursor to the modern concept of mass in physics."}}, {"canonical_name": "second", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "second", "book_id": "kosmos_humboldt_1845", "name": "second", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["second"], "contexts": ["unit of angular measurement"]}, {"entity_id": "second", "book_id": "first_principles_spencer_1862", "name": "second", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["second"], "contexts": ["ordinal number"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "second", "target_book": "first_principles_spencer_1862", "target_name": "second", "similarity": 1.0}], "id": 5880, "stable_key": "clu_0d09c0419e7337e0", "ground_truth": {"modern_name": "second", "confidence": "high", "type": "concept", "note": "Refers to the unit of time, the second, or an ordinal number indicating order."}}, {"canonical_name": "Cephei", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cephei", "book_id": "kosmos_humboldt_1845", "name": "Cephei", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Cephei"], "contexts": ["star"]}, {"entity_id": "\u03b4_cephei", "book_id": "connexion_physical_sciences_somerville_1858", "name": "\u03b4 Cephei", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["\u03b4 Cephei"], "contexts": ["star with variable light"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Cephei", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "\u03b4 Cephei", "similarity": 0.869}], "id": 5881, "stable_key": "clu_adaabbad5896052c", "ground_truth": {"modern_name": "Delta Cephei", "confidence": "high", "type": "object", "note": "Delta Cephei is a star and the prototype of a class of pulsating variable stars known as Cepheid variables.", "wikidata_id": "Q10451997", "wikidata_description": "type of variable star", "wikipedia_url": "https://en.wikipedia.org/wiki/Classical%20Cepheid%20variable"}}, {"canonical_name": "volcanic processes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "volcanic_processes", "book_id": "kosmos_humboldt_1845", "name": "volcanic processes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["volcanic processes"], "contexts": ["phenomena related to volcanoes"]}, {"entity_id": "volcanic_phenomena", "book_id": "connexion_physical_sciences_somerville_1858", "name": "volcanic phenomena", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["volcanic phenomena"], "contexts": ["related"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "volcanic processes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "volcanic phenomena", "similarity": 0.913}], "id": 5882, "stable_key": "clu_8415cb4ad8108c86-2", "ground_truth": {"modern_name": "Volcanic activity", "confidence": "high", "type": "concept", "wikidata_id": "Q505748", "wikidata_description": "phenomena and processes associated with the action of volcanos, geysers and fumaroles", "wikipedia_url": "https://en.wikipedia.org/wiki/Volcanism", "wikipedia_extract": "Volcanism, vulcanism, volcanicity, or volcanic activity is the phenomenon where solids, liquids, gases, and their mixtures erupt to the surface of a solid-surface astronomical body such as a planet or a moon. It is caused by the presence of a heat source, usually internally generated, inside the body; the heat is generated by various processes, such as radioactive decay or tidal heating. This heat partially melts solid material in the body or turns material into gas. The mobilized material rises through the body's interior and may break through the solid surface. For volcanism to occur, the temperature of the mantle must have risen to about half its melting point. At this point, the mantle's viscosity will have dropped to about 1021 Pascal-seconds."}}, {"canonical_name": "Volterra", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "volterra", "book_id": "kosmos_humboldt_1845", "name": "Volterra", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Volterra"], "contexts": ["city in Tuscany"]}, {"entity_id": "volterra", "book_id": "ricettario_fiorentino_1597", "name": "Volterra", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Volterra"], "contexts": ["lagoons of"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Volterra", "target_book": "ricettario_fiorentino_1597", "target_name": "Volterra", "similarity": 1.0}], "id": 5883, "stable_key": "clu_210b715c774baa68", "ground_truth": {"modern_name": "Volterra", "confidence": "high", "type": "place", "country": "Italy", "note": "Both 'Volterrano' and 'Volterra' refer to the city of Volterra in Tuscany, Italy, known for its alum deposits.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "Volterrano Volterrani (5 October 1891 \u2013 15 March 1963) was an Italian sculptor. His work was part of the sculpture event in the art competition at the 1936 Summer Olympics.", "wikipedia_url": "https://en.wikipedia.org/wiki/Volterrano_Volterrani"}}, {"canonical_name": "shafts", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "shafts", "book_id": "kosmos_humboldt_1845", "name": "shafts", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["shafts"], "contexts": ["deep vertical passages"]}, {"entity_id": "shafts", "book_id": "connexion_physical_sciences_somerville_1858", "name": "shafts", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["shafts"], "contexts": ["vertical passages in mines and wells"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "shafts", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "shafts", "similarity": 1.0}], "id": 5884, "stable_key": "clu_c3cd0d6d5782fea7", "ground_truth": {"modern_name": "Shafts", "confidence": "high", "type": "object", "note": "Refers to deep vertical passages, often in mining or geological contexts, as well as more abstract passages or conduits."}}, {"canonical_name": "law of the increase", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "law_of_the_increase", "book_id": "kosmos_humboldt_1845", "name": "law of the increase", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["law of the increase"], "contexts": ["rule governing a gradual rise"]}, {"entity_id": "law_of_increase", "book_id": "connexion_physical_sciences_somerville_1858", "name": "law of increase", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["law of increase"], "contexts": ["principle governing temperature rise with depth"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "law of the increase", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "law of increase", "similarity": 0.99}], "id": 5885, "stable_key": "clu_9fcc2fa87e40af14", "ground_truth": {"modern_name": "Law of increasing temperature with depth", "confidence": "high", "type": "concept", "note": "Refers to the principle that temperature increases with increasing depth within the Earth."}}, {"canonical_name": "center of the Earth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "center_of_the_earth", "book_id": "kosmos_humboldt_1845", "name": "center of the Earth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["center of the Earth"], "contexts": ["innermost point of the planet"]}, {"entity_id": "earth's_centre_of_gravity", "book_id": "first_principles_spencer_1862", "name": "Earth's centre of gravity", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Earth's centre of gravity"], "contexts": ["focus of elliptical motion"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "center of the Earth", "target_book": "first_principles_spencer_1862", "target_name": "Earth's centre of gravity", "similarity": 0.938}], "id": 5886, "stable_key": "clu_d31dce806f30d925", "ground_truth": {"modern_name": "Center of the Earth", "confidence": "high", "type": "concept", "note": "Refers to the innermost part of the Earth, or its center of gravity in a more abstract physical sense.", "wikidata_id": "Q103812450", "wikidata_description": "park in Greece"}}, {"canonical_name": "volcanic phenomena", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "volcanic_phenomena", "book_id": "kosmos_humboldt_1845", "name": "volcanic phenomena", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["volcanic phenomena"], "contexts": ["events related to volcanoes"]}, {"entity_id": "geological_phenomena", "book_id": "connexion_physical_sciences_somerville_1858", "name": "geological phenomena", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["geological phenomena"], "contexts": ["observable features of Earth's crust"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "volcanic phenomena", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "geological phenomena", "similarity": 0.883}], "id": 5887, "stable_key": "clu_8415cb4ad8108c86-3", "ground_truth": {"modern_name": "Volcanic activity", "confidence": "high", "type": "concept", "wikidata_id": "Q505748", "wikidata_description": "phenomena and processes associated with the action of volcanos, geysers and fumaroles", "wikipedia_url": "https://en.wikipedia.org/wiki/Volcanism", "wikipedia_extract": "Volcanism, vulcanism, volcanicity, or volcanic activity is the phenomenon where solids, liquids, gases, and their mixtures erupt to the surface of a solid-surface astronomical body such as a planet or a moon. It is caused by the presence of a heat source, usually internally generated, inside the body; the heat is generated by various processes, such as radioactive decay or tidal heating. This heat partially melts solid material in the body or turns material into gas. The mobilized material rises through the body's interior and may break through the solid surface. For volcanism to occur, the temperature of the mantle must have risen to about half its melting point. At this point, the mantle's viscosity will have dropped to about 1021 Pascal-seconds."}}, {"canonical_name": "dry land", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dry_land", "book_id": "kosmos_humboldt_1845", "name": "dry land", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["dry land"], "contexts": ["mountain chains and high plains"]}, {"entity_id": "dry_land", "book_id": "connexion_physical_sciences_somerville_1858", "name": "dry land", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["dry land"], "contexts": ["comparative extent on the globe"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "dry land", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "dry land", "similarity": 1.0}], "id": 5888, "stable_key": "clu_b5c6f00a29ce5481-2", "ground_truth": {"mo