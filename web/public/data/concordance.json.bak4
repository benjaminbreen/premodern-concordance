arrilla"], "contexts": ["plant discussed for medicinal use"]}, {"entity_id": "gargaparilla", "book_id": "historia_medicinal_monardes_1574", "name": "gargaparilla", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["gargaparilla"], "contexts": ["plant whose water is compared", "plant used as medicine"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "parpaparrilla", "target_book": "historia_medicinal_monardes_1574", "target_name": "gargaparilla", "similarity": 0.88}], "id": 4048, "stable_key": "clu_0560c068fb68cd78", "ground_truth": {"modern_name": "Smilax aspera", "confidence": "high", "type": "plant", "linnaean": "Smilax aspera Linnaeus", "family": "Smilacaceae", "note": "The spelling variations and context suggest Smilax aspera, also known as thorny smilax or rough smilax, which was historically used medicinally.", "wikidata_id": "Q161119", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Smilax%20aspera"}}, {"canonical_name": "capullos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "capul\u00ed", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "capul\u00ed", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["capul\u00ed"], "contexts": ["comparison for cacapolton leaves"]}, {"entity_id": "cabepuelas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "cabepuelas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cabepuelas"], "contexts": ["plant part shape"]}, {"entity_id": "capullos", "book_id": "historia_medicinal_monardes_1574", "name": "capullos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["capullos"], "contexts": ["buds of the plant"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "capul\u00ed", "target_book": "historia_medicinal_monardes_1574", "target_name": "capullos", "similarity": 0.912}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cabepuelas", "target_book": "historia_medicinal_monardes_1574", "target_name": "capullos", "similarity": 0.897}], "id": 4049, "stable_key": "clu_fb86bf59d6705a46", "ground_truth": {"modern_name": "Capulin cherry", "confidence": "high", "type": "plant", "linnaean": "Prunus salicifolia", "family": "Rosaceae", "note": "The context of buds ('capullos') and association with American flora (Hernandez) points to the Capulin cherry, a species of Prunus.", "wikidata_id": "Q2667462", "wikidata_description": "species of plant"}}, {"canonical_name": "odor\u00edfera", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "odorifera", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "odorifera", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["odorifera"], "contexts": ["quality of being fragrant"]}, {"entity_id": "odor\u00edfera", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "odor\u00edfera", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["odor\u00edfera"], "contexts": ["fragrant quality of the root"]}, {"entity_id": "odor\u00edfera", "book_id": "coloquios_da_orta_1563", "name": "odor\u00edfera", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["odor\u00edfera"], "contexts": ["having a pleasant smell", "quality of a thing"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "odorifera", "target_book": "coloquios_da_orta_1563", "target_name": "odor\u00edfera", "similarity": 0.975}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "odor\u00edfera", "target_book": "coloquios_da_orta_1563", "target_name": "odor\u00edfera", "similarity": 1.0}], "id": 4050, "stable_key": "clu_bc22b678a3b3bd5f", "ground_truth": {"modern_name": "fragrant", "confidence": "high", "type": "concept", "wikidata_id": "Q15043636", "wikidata_description": "chemical substance that stimulates the sense of smell and is used for communication in animals, for example as a pheromone"}}, {"canonical_name": "dolores frios", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "dolores_nacidos_de_causa_fria", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "dolores nacidos de causa fria", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["dolores nacidos de causa fria"], "contexts": ["pains from a cold cause"]}, {"entity_id": "dolores_frios", "book_id": "historia_medicinal_monardes_1574", "name": "dolores frios", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 3, "variants": ["dolores frios", "dolor de frio", "dolores frios y ventosos"], "contexts": ["cold pains treated by the water", "pain caused by cold"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "dolores nacidos de causa fria", "target_book": "historia_medicinal_monardes_1574", "target_name": "dolores frios", "similarity": 0.884}], "id": 4051, "stable_key": "clu_2e1ee4228b495452", "ground_truth": {"modern_name": "Cold sweats", "confidence": "high", "type": "disease", "description": "A symptom characterized by cold, clammy perspiration, often associated with illness.", "note": "This cluster includes terms referring to cold pains and cold sweats in Spanish and English.", "wikipedia_extract": "Sweating sickness, also known as the sweats, English sweating sickness, English sweat or sudor anglicus in Latin, was a mysterious and contagious disease that struck England and later continental Europe in a series of epidemics beginning in 1485. Other major outbreaks of the English sweating sickness occurred in 1508, 1517, and 1528, with the last outbreak in 1551, after which the disease apparently vanished. The onset of symptoms was sudden, and death or recovery often occurred within 8\u201310 hours. Sweating sickness epidemics were unique compared with other disease outbreaks of the time: whereas other epidemics were typically urban and long-lasting, cases of sweating sickness spiked and receded very quickly, significantly affecting rural populations. Its cause remains unknown, although it has been suggested that an unknown species of hantavirus was responsible. John Caius was a physician in Shrewsbury in 1551, when an outbreak occurred, and he described the symptoms and signs of the disease in A Boke or Counseill Against the Disease Commonly Called the Sweate, or Sweatyng Sicknesse (1552), which is the main historical source of knowledge of the disease."}}, {"canonical_name": "rose", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "rose", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "rose", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["rose"], "contexts": ["flower with white petals"]}, {"entity_id": "rose", "book_id": "ricettario_fiorentino_1597", "name": "rose", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["rose"], "contexts": ["flower mentioned in the passage", "herb used in sugar preparations"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "rose", "target_book": "ricettario_fiorentino_1597", "target_name": "rose", "similarity": 1.0}], "id": 4052, "stable_key": "clu_683b94c0b7528ea5-2", "ground_truth": {"modern_name": "rose", "confidence": "high", "type": "plant", "linnaean": "Rosa L.", "family": "Rosaceae", "note": "While 'Rosa' can refer to the genus, the context of 'rose' in James's 'Principles of Psychology' might also allude to its use in metaphorical or experimental contexts, but the primary botanical identification is the genus.", "wikidata_id": "Q34687", "wikidata_description": "genus of plants"}}, {"canonical_name": "flores cordeaes", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "flores_cordirles", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Flores cordirles", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Flores cordirles"], "contexts": ["ingredient in syrup"]}, {"entity_id": "flores_cordeaes", "book_id": "polyanthea_medicinal", "name": "flores cordeaes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["flores cordeaes", "florescordeaes"], "contexts": ["flowers for decoction", "ingredients in a drink"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Flores cordirles", "target_book": "polyanthea_medicinal", "target_name": "flores cordeaes", "similarity": 0.9}], "id": 4053, "stable_key": "clu_245794313ada88ce", "ground_truth": {"modern_name": "Cordia flowers", "confidence": "medium", "type": "plant", "note": "The term 'Flores cordeaes' likely refers to flowers from plants in the genus Cordia, which have medicinal uses. Specific species is uncertain without further context."}}, {"canonical_name": "venenoso", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "venenossas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "venenossas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["venenossas"], "contexts": ["poisonous substances"]}, {"entity_id": "venenoso", "book_id": "polyanthea_medicinal", "name": "venenoso", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["venenoso"], "contexts": ["poisonous", "quality of being poisonous"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "venenossas", "target_book": "polyanthea_medicinal", "target_name": "venenoso", "similarity": 0.921}], "id": 4054, "stable_k