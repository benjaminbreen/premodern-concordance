0f4le bor\u00e9al", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "h\u00e9misph\u00e8re bor\u00e9al", "similarity": 0.909}, {"source_book": "epoques_nature_buffon_1778", "source_name": "p\u00f4le bor\u00e9al", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Mer Polaire bor\u00e9ale", "similarity": 0.907}], "id": 3363, "stable_key": "clu_2a0a2de3db9015e0", "ground_truth": {"modern_name": "North Pole", "confidence": "high", "type": "place", "wikidata_id": "Q79494", "wikidata_description": "city in Alaska, USA", "wikipedia_url": "https://en.wikipedia.org/wiki/North%20Pole%2C%20Alaska"}}, {"canonical_name": "marmo", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "marbre", "book_id": "epoques_nature_buffon_1778", "name": "marbre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["marbre"], "contexts": ["material for comparison with stone", "metamorphosed calcareous rock"]}, {"entity_id": "marmo", "book_id": "ricettario_fiorentino_1597", "name": "marmo", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["marmo"], "contexts": ["type of salt, less effective than sale gemma", "marble for drying"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "marbre", "target_book": "ricettario_fiorentino_1597", "target_name": "marmo", "similarity": 0.954}], "id": 3364, "stable_key": "clu_aba4f89f40d67b54-3", "ground_truth": {"modern_name": "Marble", "confidence": "high", "type": "mineral", "note": "Contexts suggest both the rock and potentially a salt derived from it.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Marble", "wikipedia_extract": "Marble is a metamorphic rock consisting of carbonate minerals (most commonly calcite  (CaCO3) or dolomite (CaMg(CO3)2) that have recrystallized under the influence of heat and pressure. It has a crystalline texture, and is typically not foliated (layered), although there are exceptions. In geology, the term marble refers to metamorphosed limestone, but its use in stonemasonry more broadly encompasses unmetamorphosed limestone. Pure white marble arises from very clean limestone or rock also called dolomite. However, its signature veins and swirls result from impurities like clay, sand, iron oxides, or chert originally present in the protolith\u2014magnesium-rich varieties may show green tones due to serpentine. These impurities are redistributed and recrystallized during metamorphism."}}, {"canonical_name": "M.", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "m_", "book_id": "epoques_nature_buffon_1778", "name": "M.", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["M."], "contexts": ["initial of a person mentioned", "author of an excellent work"]}, {"entity_id": "m_", "book_id": "connexion_physical_sciences_somerville_1858", "name": "M.", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["M."], "contexts": ["conducted experiments on heat transmission", "individual mentioned in relation to pressure"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "M.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "M.", "similarity": 1.0}], "id": 3365, "stable_key": "clu_dd09ef43ef1ea457", "ground_truth": {"modern_name": "initial M.", "confidence": "medium", "type": "person", "description": "initial of a person conducting heat experiments", "note": "The context suggests a person, possibly Mary Somerville, given her work in physical sciences. However, 'M.' alone is ambiguous without more context.", "wikidata_id": "Q135972420", "wikidata_description": "19th century Irish-New Zealand grocer in Auckland (1826\u20131902)"}}, {"canonical_name": "aimant\u00e9e", "category": "SUBSTANCE", "subcateg