s": [{"source_book": "principles_of_psychology_james_1890", "source_name": "compound", "target_book": "first_principles_spencer_1862", "target_name": "compounds", "similarity": 0.927}, {"source_book": "principles_of_psychology_james_1890", "source_name": "compounds", "target_book": "first_principles_spencer_1862", "target_name": "compounds", "similarity": 1.0}], "id": 4844, "stable_key": "clu_68db0f52ad8746cc", "ground_truth": {"modern_name": null, "confidence": "high", "type": "chemical", "wikidata_id": "Q11173", "wikidata_description": "pure chemical substance consisting of two or more different chemical elements", "wikipedia_url": "https://en.wikipedia.org/wiki/Chemical%20compound", "wikipedia_extract": "A chemical compound is a chemical substance composed of many identical molecules (or molecular entities) containing atoms from more than one chemical element held together by chemical bonds. A molecule consisting of atoms of only one element is therefore not a compound. A compound can be transformed into a different substance by a chemical reaction, which may involve interactions with other substances. In this process, bonds between atoms may be broken or new bonds formed or both. There are four major types of compounds, distinguished by how the constituent atoms are bonded together. Molecular compounds are held together by covalent bonds, ionic compounds are held together by ionic bonds, intermetallic compounds are held together by metallic bonds, and coordination complexes are held together by coordinate covalent bonds."}}, {"canonical_name": "coexistence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "coexistence", "book_id": "principles_of_psychology_james_1890", "name": "coexistence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["coexistence"], "contexts": ["relationship of things existing together"]}, {"entity_id": "co-existence", "book_id": "first_principles_spencer_1862", "name": "co-existence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["co-existence"], "contexts": ["state of existing together"]}, {"entity_id": "co-existences", "book_id": "first_principles_spencer_1862", "name": "co-existences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["co-existences"], "contexts": ["relations of existing together"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "coexistence", "target_book": "first_principles_spencer_1862", "target_name": "co-existence", "similarity": 0.975}, {"source_book": "principles_of_psychology_james_1890", "source_name": "coexistence", "target_book": "first_principles_spencer_1862", "target_name": "co-existences", "similarity": 0.939}], "id": 4845, "stable_key": "clu_af282271de5c950b", "ground_truth": {"modern_name": null, "confidence": "high", "type": "concept"}}, {"canonical_name": "design", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "design", "book_id": "principles_of_psychology_james_1890", "name": "design", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["design"], "contexts": ["purposeful planning or intention"]}, {"entity_id": "design", "book_id": "connexion_physical_sciences_somerville_1858", "name": "design", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["design"], "contexts": ["purposeful arrangement of parts", "purposeful arrangement in creation"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "design", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "design", "similarity": 1.0}], "id": 4846, "stable_key": "clu_96b82c0a2f896c05", "ground_truth": {"modern_name": "design", "confidence": "high", "type": "concept", "wikidata_id": "Q82604", "wikidata_description": "creation of a plan or convention for the construction of an object or a system; process of creation; act of creativity and innovation", "wikipedia_url": "https://en.wikipedia.org/wiki/Design", "wikipedia_extract": "A design is the concept or proposal for an object, process, or system. The word design refers to something that is or has been intentionally created by a thinking agent, and is sometimes used to refer to the inherent nature of something \u2013 its design. The verb to design expresses the process of developing a design. In some cases, the direct construction of an object without an explicit prior plan may also be considered to be a design, such as in arts and crafts. A design is expected to have a purpose within a specific context, typically aiming to satisfy certain goals and constraints while taking into account aesthetic, functional and experiential considerations. Traditional examples of designs are architectural and engineering drawings, circuit diagrams, sewing patterns, and less tangible artefacts such as business process models."}}, {"canonical_name": "seconds", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "seconds", "book_id": "principles_of_psychology_james_1890", "name": "seconds", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["seconds"], "contexts": ["unit of time"]}, {"entity_id": "seconds", "book_id": "connexion_physical_sciences_somerville_1858", "name": "seconds", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["seconds"], "contexts": ["subdivision of a minute", "unit of time/angle"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "seconds", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "seconds", "similarity": 1.0}], "id": 4847, "stable_key": "clu_3ab2a4e502385c0c", "ground_truth": {"modern_name": "seconds", "confidence": "high", "type": "concept"}}, {"canonical_name": "nervous action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "nervous_action", "book_id": "principles_of_psychology_james_1890", "name": "nervous action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["nervous action"], "contexts": ["change in nervous centre"]}, {"entity_id": "nervous_action", "book_id": "first_principles_spencer_1862", "name": "nervous action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["nervous action"], "contexts": ["fundamental law of physiological processes", "physiological process in the nervous system"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "nervous action", "target_book": "first_principles_spencer_1862", "target_name": "nervous action", "similarity": 1.0}], "id": 4848, "stable_key": "clu_8cab550f48a87211", "ground_truth": {"modern_name": "Nerve activity", "confidence": "high", "type": "concept"}}, {"canonical_name": "phases", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "phase", "book_id": "principles_of_psychology_james_1890", "name": "phase", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["phase"], "contexts": ["stage or aspect of a process"]}, {"entity_id": "phases", "book_id": "connexion_physical_sciences_somerville_1858", "name": "phases", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["phases"], "contexts": ["state of oscillation in a wave", "in comets"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "phase", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "phases", "similarity": 0.904}], "id": 4849, "stable_key": "clu_dfe2dcae90094617", "ground_truth": {"modern_name": "phase", "confidence": "high", "type": "concept"}}, {"canonical_name": "Chapter X.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "chapter_x", "book_id": "principles_of_psychology_james_1890", "name": "Chapter X", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Chapter X"], "contexts": ["reference to a specific chapter"]}, {"entity_id": "chapter_x_", "book_id": "first_principles_spencer_1862", "name": "Chapter X.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Chapter X.", "CHAPTER X."], "contexts": ["chapter title", "reference to a chapter in a work"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Chapter X", "target_book": "first_principles_spencer_1862", "target_name": "Chapter X.", "similarity": 0.943}], "id": 4850, "stable_key": "clu_9376b79e1f1d73b7", "ground_truth": {"modern_name": "Chapter reference", "confidence": "high", "type": "concept", "note": "Refers to specific chapters within books.", "wikidata_id": "Q77262860", "wikidata_description": "print in the National Gallery of Art (NGA 216558)"}}, {"canonical_name": "conflict", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "conflict", "book_id": "principles_of_psychology_james_1890", "name": "conflict", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["conflict"], "contexts": ["opposition or struggle"]}, {"entity_id": "conflict", "book_id": "first_principles_spencer_1862", "name": "conflict", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["conflict"], "contexts": ["a state of opposition or disagreement", "disagreement or struggle"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "conflict", "target_book": "first_principles_spencer_1862", "target_name": "conflict", "similarity": 1.0}], "id": 4851, "stable_key": "clu_a1d0cc070143b7a4", "ground_truth": {"modern_name": "Conflict", "confidence": "high", "type": "concept", "note": "Represents opposition or struggle, a general concept.", "wikidata_id": "Q211067", "wikidata_description": "situation occurring when an individual or organization is involved in multiple interests, one of which could possibly corrupt the motivation", "wikipedia_url": "https://en.wikipedia.org/wiki/Conflict%20of%20interest", "wikipedia_extract": "A conflict of interest (COI) is a situation in which a person or organization is involved in multiple interests, financial or otherwise, and serving one interest could involve working against another. Typically, this relates to situations in which the personal interest of an individual or organization might adversely affect a duty owed to make decisions for the benefit of a third party. An \"interest\" is a commitment, obligation, duty or goal associated with a specific social role or practice. By definition, a \"conflict of interest\" occurs if, within a particular decision-making context, an individual is subject to two coexisting interests that are in direct conflict with each other (\"competing interests\"). This is important because under these circumstances, the decision-making process can be disrupted or compromised, affecting the integrity or reliability of the outcomes. Typically, a conflict of interest arises when an individual occupies two social roles simultaneously, generating opposing benefits or loyalties."}}, {"canonical_name": "Tuileries", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tuileries", "book_id": "principles_of_psychology_james_1890", "name": "Tuileries", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Tuileries"], "contexts": ["Parisian palace and gardens"]}, {"entity_id": "tuileries", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Tuileries", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Tuileries"], "contexts": ["gardens with decimal time clock", "location with a clock"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Tuileries", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Tuileries", "similarity": 1.0}], "id": 4852, "stable_key": "clu_780cbc727bb03822", "ground_truth": {"modern_name": "Tuileries Garden", "confidence": "high", "type": "place", "country": "France", "note": "Refers to the Tuileries Garden in Paris, known for its historical significance and public spaces.", "wikidata_id": "Q818517", "wikidata_description": "public garden in Paris, France", "wikipedia_url": "https://en.wikipedia.org/wiki/Tuileries_Garden", "wikipedia_extract": "The Tuileries Garden (French: Jardin des Tuileries, IPA: [\u0292a\u0281d\u025b\u0303 de t\u0265il\u0281i]) is a public garden between the Louvre and the Place de la Concorde in the 1st arrondissement of Paris, France. Created by Catherine de' Medici as the garden of the Tuileries Palace in 1564, it was opened to the public in 1667 and became a public park after the French Revolution. Since the 19th century, it has been a place for Parisians to celebrate, meet, stroll and relax. Covering an area of 25.5 hectares (63 acres), it is one of the most iconic parks in Paris. During the 2024 Summer Olympics and Paralympics, it was the site of the Olympic and Paralympic cauldron. The Italian Garden of Catherine de' Medici (16th century) In July 1559, after the accidental death of her husband, Henry II, Queen Catherine de' Medici decided to leave her residence of the H\u00f4tel des Tournelles, at the eastern part of Paris, near the Bastille."}}, {"canonical_name": "nervous impressions", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "nervous_impressions", "book_id": "principles_of_psychology_james_1890", "name": "nervous impressions", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nervous impressions"], "contexts": ["signals transmitted by nerves"]}, {"entity_id": "nervous_impressions", "book_id": "first_principles_spencer_1862", "name": "nervous impressions", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["nervous impressions"], "contexts": ["signals transmitted by nerves"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "nervous impressions", "target_book": "first_principles_spencer_1862", "target_name": "nervous impressions", "similarity": 1.0}], "id": 4853, "stable_key": "clu_680efa82c7f6c6b6", "ground_truth": {"modern_name": "Nervous impulse", "confidence": "high", "type": "concept", "note": "Early modern term for signals transmitted by nerves.", "wikidata_id": "Q3150791", "wikidata_description": ""}}, {"canonical_name": "galvanism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "galvanism", "book_id": "kosmos_humboldt_1845", "name": "galvanism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["galvanism"], "contexts": ["recent scientific discovery", "electrical phenomenon"]}, {"entity_id": "galvanism", "book_id": "connexion_physical_sciences_somerville_1858", "name": "galvanism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["galvanism"], "contexts": ["phenomena related to electricity"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "galvanism", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "galvanism", "similarity": 1.0}], "id": 4854, "stable_key": "clu_e45cd0d1e891ec9e", "ground_truth": {"modern_name": "Galvanism", "confidence": "high", "type": "concept", "note": "Historical term for the study of electricity, particularly animal electricity.", "wikidata_id": "Q1492797", "wikidata_description": "early study of the electrical properties of animal tissue"}}, {"canonical_name": "tropical regions", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tropical_regions", "book_id": "kosmos_humboldt_1845", "name": "tropical regions", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["tropical Regions", "tropical regions"], "contexts": ["geographic area near equator", "warm regions near equator"]}, {"entity_id": "tropical_parts_of_the_earth", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tropical parts of the earth", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["tropical parts of the earth"], "contexts": ["regions with distinct dry and rainy seasons"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "tropical regions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tropical parts of the earth", "similarity": 0.921}], "id": 4855, "stable_key": "clu_56d1ba8bad50e5c6", "ground_truth": {"modern_name": "Tropical regions", "confidence": "high", "type": "place", "country": "Global"}}, {"canonical_name": "Iris", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "iris", "book_id": "kosmos_humboldt_1845", "name": "Iris", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Iris"], "contexts": ["primary planet in the solar system", "asteroid planet discovered by Mr. Hind"]}, {"entity_id": "\u00edris", "book_id": "coloquios_da_orta_1563", "name": "\u00edris", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["\u00edris"], "contexts": ["rainbow, comparison for fruit color"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Iris", "target_book": "coloquios_da_orta_1563", "target_name": "\u00edris", "similarity": 0.674}], "id": 4856, "stable_key": "clu_6c7b5a0487522eaf", "ground_truth": {"modern_name": "Iris", "confidence": "high", "type": "object", "note": "The term 'Iris' can refer to the part of the eye, a flower, or the Greek goddess. Contextually, it refers to the eye structure and a comparison for color.", "wikidata_id": "Q156901", "wikidata_description": "genus of plants in the order Iridaceae", "wikipedia_url": "https://en.wikipedia.org/wiki/Iris%20%28plant%29", "wikipedia_extract": "Iris is a flowering plant genus of 310 accepted species with showy flowers. As well as being the scientific name, iris is also widely used as a common name for all Iris species, as well as some belonging to other closely related genera. A common name for some species is flags, while the plants of the subgenus Scorpiris are widely known as junos, particularly in horticulture. It is a popular garden flower. The often-segregated, monotypic genera Belamcanda (blackberry lily, I. domestica), Hermodactylus (snake's head iris, I."}}, {"canonical_name": "vines", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "vines", "book_id": "kosmos_humboldt_1845", "name": "vines", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["vines"], "contexts": ["plants yielding grapes", "yielding potable wines"]}, {"entity_id": "vine", "book_id": "connexion_physical_sciences_somerville_1858", "name": "vine", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["vine"], "contexts": ["climbing plant, often bearing grapes"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "vines", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "vine", "similarity": 0.902}], "id": 4857, "stable_key": "clu_ff926b990942b265-2", "ground_truth": {"modern_name": "Vine", "confidence": "high", "type": "plant", "note": "While 'vine' can refer to many climbing plants, the context of 'yielding grapes' strongly suggests the grapevine.", "wikidata_id": "Q30046", "wikidata_description": "species of flowering plant in the grape vine family Vitaceae", "wikipedia_url": "https://en.wikipedia.org/wiki/Vitis%20vinifera", "linnaean": "Vitis vinifera", "family": "Vitaceae", "wikipedia_extract": "Vitis vinifera, the common grape vine, is a species of flowering plant, native to the Mediterranean region, Central Europe, and southwestern Asia, from Morocco and Portugal north to southern Germany and east to northern Iran. As of 2012, there were between 5,000 and 10,000 varieties of Vitis vinifera grapes though only a few are of commercial significance for wine and table grape production. The wild grape is sometimes classified as Vitis vinifera var. sylvestris (in some classifications considered Vitis sylvestris), with Vitis vinifera var vinifera restricted to cultivated forms. Domesticated vines have hermaphrodite flowers, but V. vinifera var."}}, {"canonical_name": "Victor Jacquemont", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "victor_jacquemont", "book_id": "kosmos_humboldt_1845", "name": "Victor Jacquemont", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Victor Jacquemont"], "contexts": ["confirmed snow-line differences in Himalaya", "traveler who examined Himalaya"]}, {"entity_id": "victor_jacquemont", "book_id": "coloquios_da_orta_1563", "name": "Victor Jacquemont", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Victor Jacquemont"], "contexts": ["French traveler who found the costus plant"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Victor Jacquemont", "target_book": "coloquios_da_orta_1563", "target_name": "Victor Jacquemont", "similarity": 1.0}], "id": 4858, "stable_key": "clu_83305ee29863b1d6", "ground_truth": {"modern_name": "Victor Jacquemont", "confidence": "high", "type": "person", "birth_year": 1801, "death_year": 1832, "description": "French botanist and traveler; discovered Costus speciosus in Goa.", "note": "The text 'coloquios_da_orta_1563' is likely a misattribution or an error, as Victor Jacquemont lived much later than 1563. His association with the Costus plant is well-documented."}}, {"canonical_name": "intellectual development", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "intellectual_development", "book_id": "kosmos_humboldt_1845", "name": "intellectual development", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["intellectual development"], "contexts": ["human development influenced by language", "growth of mental abilities"]}, {"entity_id": "intellectual_development", "book_id": "first_principles_spencer_1862", "name": "intellectual development", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["intellectual development"], "contexts": ["advancement of cognitive abilities"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "intellectual development", "target_book": "first_principles_spencer_1862", "target_name": "intellectual development", "similarity": 1.0}], "id": 4859, "stable_key": "clu_c1d6e4c54f2fab6a", "ground_truth": {"modern_name": "Intellectual development", "confidence": "high", "type": "concept"}}, {"canonical_name": "Tr.", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tr_", "book_id": "kosmos_humboldt_1845", "name": "Tr.", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Tr."], "contexts": ["translator of the passage"]}, {"entity_id": "trat_2_", "book_id": "polyanthea_medicinal", "name": "Trat.2.", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Trat.2."], "contexts": ["reference to a treatise"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Tr.", "target_book": "polyanthea_medicinal", "target_name": "Trat.2.", "similarity": 0.881}], "id": 4860, "stable_key": "clu_a02b501ba18a74d0", "ground_truth": {"modern_name": "Translator", "confidence": "medium", "type": "concept", "note": "The abbreviation 'Tr.' or 'Trat.' in early modern texts often refers to a translator or a treatise. Given the context of 'translator of the passage', 'Translator' is the most likely referent.", "wikidata_id": "Q333634", "wikidata_description": "person who translates written text from one language to another", "wikipedia_url": "https://en.wikipedia.org/wiki/Translator"}}, {"canonical_name": "radiating heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "radiating_heat", "book_id": "kosmos_humboldt_1845", "name": "radiating heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["radiating heat"], "contexts": ["transfer of heat through electromagnetic waves", "energy transfer"]}, {"entity_id": "rays_of_heat", "book_id": "connexion_physical_sciences_somerville_1858", "name": "rays of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["rays of heat"], "contexts": ["emitted from substances"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "radiating heat", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "rays of heat", "similarity": 0.912}], "id": 4861, "stable_key": "clu_64c41c0b0bc4ad37-2", "ground_truth": {"modern_name": "Thermal radiation", "confidence": "high", "type": "concept", "wikidata_id": "Q58469017", "wikidata_description": "scholarly article in Physical Review B, vol. 75 no. 20, May 2007"}}, {"canonical_name": "Florida", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "florida", "book_id": "kosmos_humboldt_1845", "name": "Florida", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Florida"], "contexts": ["region near Gulf Stream origin", "state in southeastern United States"]}, {"entity_id": "florida", "book_id": "coloquios_da_orta_1563", "name": "Florida", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Florida"], "contexts": ["region where guaiacam grows"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Florida", "target_book": "coloquios_da_orta_1563", "target_name": "Florida", "similarity": 1.0}], "id": 4862, "stable_key": "clu_07ed656e994751bf", "ground_truth": {"modern_name": "Florida", "confidence": "high", "type": "place", "country": "United States", "wikidata_id": "Q2255913", "wikidata_description": "city in the province of Buenos Aires in Argentina", "wikipedia_url": "https://en.wikipedia.org/wiki/Florida%2C%20Buenos%20Aires"}}, {"canonical_name": "M. Bouvard", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "m__bouvard", "book_id": "kosmos_humboldt_1845", "name": "M. Bouvard", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["M. Bouvard"], "contexts": ["paved way for Neptune's discovery", "corrected astronomical calculations"]}, {"entity_id": "m__bouvard", "book_id": "connexion_physical_sciences_somerville_1858", "name": "M. Bouvard", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["M. Bouvard"], "contexts": ["scientist who studied atmospheric oscillations"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "M. Bouvard", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "M. Bouvard", "similarity": 1.0}], "id": 4863, "stable_key": "clu_1cbe44f9e7f2fab8", "ground_truth": {"modern_name": "Alexis Bouvard", "confidence": "high", "type": "person", "birth_year": 1767, "death_year": 1843, "description": "French astronomer, calculated planetary tables, aided Neptune discovery.", "wikidata_id": "Q318601", "wikidata_description": "French astronomer (1767-1843)", "wikipedia_url": "https://en.wikipedia.org/wiki/Alexis%20Bouvard", "wikipedia_extract": "Alexis Bouvard (French pronunciation: [al\u025bksi buva\u0281], 27 June 1767 \u2013 7 June 1843) was a French astronomer. He is particularly noted for his careful observations of the irregularities in the motion of Uranus and his hypothesis of the existence of an eighth planet in the Solar System. Born in Contamines, Duchy of Savoy, Bouvard's achievements included the discovery of eight comets and the compilation of astronomical tables of Jupiter, Saturn and Uranus. While the former two tables were eminently successful, the latter showed substantial discrepancies with subsequent observations. This led Bouvard to hypothesise the existence of an eighth planet responsible for the irregularities in Uranus' orbit. The position of Neptune was subsequently calculated from Bouvard's observations by Urbain Le Verrier after his death."}}, {"canonical_name": "Vico", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "vico", "book_id": "kosmos_humboldt_1845", "name": "Vico", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Vico"], "contexts": ["saw satellites at Rome", "author on satellites of Saturn"]}, {"entity_id": "vico", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Vico", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Vico"], "contexts": ["astronomer who discovered a comet"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Vico", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Vico", "similarity": 1.0}], "id": 4864, "stable_key": "clu_caa7269703152654", "ground_truth": {"modern_name": "Angelo Secchi", "confidence": "medium", "type": "person", "birth_year": 1818, "death_year": 1878, "description": "Italian Jesuit astronomer, director of Vatican Observatory, studied solar and stellar spectra.", "note": "The context 'saw satellites at Rome' and 'astronomer who discovered a comet' strongly points to Secchi, especially given the 'Vico' in the original text might be a misreading or alternative name associated with his observations or publications. However, 'Vico' itself is an unrelated philosopher. The texts mention 'Vico' twice, which could indicate a misprint of a different astronomer or a reference to a publication by Vico discussing astronomical observations, though unlikely. Angelo Secchi is a much stronger candidate for astronomical observations and discoveries in Rome during the period. Without further context to definitively link 'Vico' to a comet discovery, Secchi is the best fit for the astronomical activity described.", "wikidata_id": "Q312416", "wikidata_description": "Italian astronomer", "wikipedia_url": "https://en.wikipedia.org/wiki/Angelo%20Secchi", "wikipedia_extract": "Angelo Secchi  (Italian pronunciation: [\u02c8and\u0292elo \u02c8sekki]; 28 June 1818 \u2013 26 February 1878) was an Italian Catholic priest and astronomer from the Italian region of Emilia. He was director of the observatory at the Pontifical Gregorian University (then called the Roman College) for 28 years. He was a pioneer in astronomical spectroscopy, and was one of the first scientists to state authoritatively that the Sun is a star. Secchi was born in Reggio Emilia, where he studied at the Jesuit gymnasium. At the age of 16, he entered the Jesuit Order in Rome. He continued his studies at the Roman College, and demonstrated great scientific ability."}}, {"canonical_name": "period of revolution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "period_of_revolution", "book_id": "kosmos_humboldt_1845", "name": "period of revolution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["period of revolution"], "contexts": ["time for one orbit"]}, {"entity_id": "period_of_its_revolution", "book_id": "connexion_physical_sciences_somerville_1858", "name": "period of its revolution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["period of its revolution"], "contexts": ["time for one orbit"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "period of revolution", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "period of its revolution", "similarity": 0.921}], "id": 4865, "stable_key": "clu_826e127f16e5fbce-3", "ground_truth": {"modern_name": "Orbital Period", "confidence": "high", "type": "concept", "wikidata_id": "Q112118425", "wikidata_description": "scholarly article", "note": "In the context of celestial bodies, 'revolutions' refers to the time it takes for one body to complete an orbit around another. This is directly related to the concept of orbital period."}}, {"canonical_name": "Valz", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "valz", "book_id": "kosmos_humboldt_1845", "name": "Valz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Valz"], "contexts": ["astronomer who noticed comet changes", "author on the comet of 1618"]}, {"entity_id": "valz", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Valz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Valz"], "contexts": ["astronomer who observed comet light"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Valz", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Valz", "similarity": 1.0}], "id": 4866, "stable_key": "clu_ed0afce53f1f2c10", "ground_truth": {"modern_name": "Camille Flammarion", "confidence": "medium", "type": "person", "birth_year": 1842, "death_year": 1925, "description": "French astronomer and author, known for popularizing astronomy and comet studies.", "note": "The name 'Valz' (likely Giovanni Battista Valz) is a known astronomer, but the descriptions 'astronomer who noticed comet changes' and 'astronomer who observed comet light' align better with the popularizing astronomical work of Camille Flammarion, who was active in the later part of the 19th century and extensively wrote about comets. Giovanni Battista Valz was active earlier and his primary contributions were orbital calculations. Given the context of Humboldt's 'Kosmos' and Somerville's works which were published or widely read in the mid-to-late 19th century, Flammarion is a more likely referent for a person discussed in such a context for popularizing comet observations.", "wikidata_id": "Q295524", "wikidata_description": "French astronomer and author (1842\u20131925)"}}, {"canonical_name": "Euripides", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "euripides", "book_id": "kosmos_humboldt_1845", "name": "Euripides", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Euripides"], "contexts": ["ancient Greek playwright"]}, {"entity_id": "euripedes", "book_id": "polyanthea_medicinal", "name": "Euripedes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Euripedes"], "contexts": ["ancient Greek physician"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Euripides", "target_book": "polyanthea_medicinal", "target_name": "Euripedes", "similarity": 0.878}], "id": 4867, "stable_key": "clu_b89d3ae19214f95e", "ground_truth": {"modern_name": "Euripides", "confidence": "high", "type": "person", "birth_year": -480, "death_year": -406, "description": "Ancient Greek tragedian, sometimes misattributed as a physician.", "note": "While primarily known as a playwright, the context 'ancient Greek physician' suggests a potential conflation or erroneous reference in some texts.", "wikidata_id": "Q48305", "wikidata_description": "Classical Athenian playwright", "wikipedia_url": "https://en.wikipedia.org/wiki/Euripides", "wikipedia_extract": "Euripides (; Ancient Greek: E\u1f50\u03c1\u03b9\u03c0\u03af\u03b4\u03b7\u03c2, romanized: Eur\u012bp\u00edd\u0113s, pronounced [eu\u032f.ri\u02d0.p\u00ed.d\u025b\u02d0s]; c. 480 \u2013 c. 406 BC) was a Greek tragedian of classical Athens. Along with Aeschylus and Sophocles, he is one of the three authors of Greek tragedy for whom any plays have survived in full. Some ancient scholars attributed ninety-five plays to him, but the Suda says it was ninety-two at most. Nineteen plays attributed to Euripides have survived more or less complete, although one of these (Rhesus) is often considered not to be genuinely his work."}}, {"canonical_name": "Palmer", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "palmer", "book_id": "kosmos_humboldt_1845", "name": "Palmer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Palmer"], "contexts": ["observed shooting stars in North America", "reported on shooting stars in New Haven"]}, {"entity_id": "palmario", "book_id": "polyanthea_medicinal", "name": "Palmario", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Palmario"], "contexts": ["referenced for his arguments"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Palmer", "target_book": "polyanthea_medicinal", "target_name": "Palmario", "similarity": 0.88}], "id": 4868, "stable_key": "clu_4b22dc81f9c15fad", "ground_truth": {"modern_name": "John Palmer", "confidence": "medium", "type": "person", "description": "Observer of shooting stars in North America", "note": "Multiple individuals named John Palmer existed. The context suggests a natural philosopher or astronomer.", "wikidata_id": "Q102361828", "wikidata_description": "English priest, chaplain to Elizabeth I, and archdeacon of Ely (died 1614)"}}, {"canonical_name": "Cygni", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cygni", "book_id": "kosmos_humboldt_1845", "name": "Cygni", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Cygni"], "contexts": ["star", "constellation Cygnus"]}, {"entity_id": "\u03b1_cygni", "book_id": "connexion_physical_sciences_somerville_1858", "name": "\u03b1 Cygni", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["\u03b1 Cygni"], "contexts": ["second magnitude star"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Cygni", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "\u03b1 Cygni", "similarity": 0.865}], "id": 4869, "stable_key": "clu_2e5b5e3ef3ff6723", "ground_truth": {"modern_name": "Deneb", "confidence": "high", "type": "place", "country": "Unknown", "wikidata_id": "Q3022426", "wikidata_description": "genus of mammals (fossil)", "wikipedia_url": "https://en.wikipedia.org/wiki/Denebola%20%28mammal%29"}}, {"canonical_name": "Dunkirk", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "dunkirk", "book_id": "kosmos_humboldt_1845", "name": "Dunkirk", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Dunkirk"], "contexts": ["location of pendulum observations", "location for hemisphere comparison"]}, {"entity_id": "dunkirk", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Dunkirk", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Dunkirk"], "contexts": ["northern French city"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Dunkirk", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Dunkirk", "similarity": 1.0}], "id": 4870, "stable_key": "clu_9cbafe6044cef123", "ground_truth": {"modern_name": "Dunkirk", "confidence": "high", "type": "place", "country": "France", "wikipedia_extract": "Dunkirk (UK:  dun-KURK; US:  DUN-kurk; French: Dunkerque [d\u0153\u0303k\u025b\u0281k] ; Picard: Dunk\u00e8ke; West Flemish: Duunkerke; Dutch: Duinkerke or Duinkerken) is a major port city in the department of Nord in northern France. It lies on the North Sea, 10 kilometres (6.2 mi) from the Belgian border. It has the third-largest French harbour. The population of the commune in 2019 was 86,279. The name of Dunkirk derives from West Flemish dun(e) 'dune' or 'dun' and kerke 'church', thus 'church in the dunes'. A smaller town 25 km (15 miles) farther up the Flemish coast originally shared the same name, but it was later renamed Oostduinkerke ('East Dunkirk') in order to avoid confusion.", "wikipedia_url": "https://en.wikipedia.org/wiki/Dunkirk"}}, {"canonical_name": "molten masses", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "molten_masses", "book_id": "kosmos_humboldt_1845", "name": "molten masses", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["molten masses"], "contexts": ["liquefied rock from Earth's interior", "liquefied rock"]}, {"entity_id": "molten_matter", "book_id": "first_principles_spencer_1862", "name": "molten matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["molten matter"], "contexts": ["matter in a liquid state due to heat"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "molten masses", "target_book": "first_principles_spencer_1862", "target_name": "molten matter", "similarity": 0.937}], "id": 4871, "stable_key": "clu_92eb7d38531337ca", "ground_truth": {"modern_name": "Molten rock", "confidence": "high", "type": "mineral", "wikidata_id": "Q59092322", "wikidata_description": "scientific article published in Nature"}}, {"canonical_name": "Magnet. der Erde", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "magnet__der_erde", "book_id": "kosmos_humboldt_1845", "name": "Magnet. der Erde", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Magnet. der Erde"], "contexts": ["book on Earth's magnetism", "publication on Earth's magnetism"]}, {"entity_id": "earth\u2019s_magnetism", "book_id": "connexion_physical_sciences_somerville_1858", "name": "earth\u2019s magnetism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["earth\u2019s magnetism"], "contexts": ["magnetic field of the Earth"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Magnet. der Erde", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "earth\u2019s magnetism", "similarity": 0.899}], "id": 4872, "stable_key": "clu_2cae0888b5b60d3b", "ground_truth": {"modern_name": "Earth's magnetic field", "confidence": "high", "type": "concept", "wikidata_id": "Q60703027", "wikidata_description": "", "note": "'Magnetism terrestre' directly translates to terrestrial magnetism, referring to the Earth's magnetic field. 'Planetary magnetism' extends this concept to other celestial bodies."}}, {"canonical_name": "attract", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "attract", "book_id": "kosmos_humboldt_1845", "name": "attract", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["attract"], "contexts": ["draw towards"]}, {"entity_id": "attracted", "book_id": "connexion_physical_sciences_somerville_1858", "name": "attracted", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["attracted"], "contexts": ["pulled by a force"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "attract", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "attracted", "similarity": 0.944}], "id": 4873, "stable_key": "clu_554e663d3709a3a4-3", "ground_truth": {"modern_name": "attraction", "confidence": "high", "type": "concept", "wikidata_id": "Q1144661", "wikidata_description": "mechanical device or structure that moves people to create enjoyment", "wikipedia_url": "https://en.wikipedia.org/wiki/Amusement%20ride", "note": "The term 'attractive' in early modern texts often referred to a perceived virtue or force, akin to modern concepts of magnetism or gravity, or biological 'attraction'."}}, {"canonical_name": "terrestrial phenomena", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "terrestrial_phenomena", "book_id": "kosmos_humboldt_1845", "name": "terrestrial phenomena", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["terrestrial phenomena"], "contexts": ["phenomena related to Earth", "phenomena occurring on Earth"]}, {"entity_id": "terrestrial_phenomena", "book_id": "connexion_physical_sciences_somerville_1858", "name": "terrestrial phenomena", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["terrestrial phenomena"], "contexts": ["phenomena occurring on Earth"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "terrestrial phenomena", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "terrestrial phenomena", "similarity": 1.0}], "id": 4874, "stable_key": "clu_fa49f3bda28df868", "ground_truth": {"modern_name": "terrestrial phenomena", "confidence": "high", "type": "concept"}}, {"canonical_name": "cirrous clouds", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cirrous_clouds", "book_id": "kosmos_humboldt_1845", "name": "cirrous clouds", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["cirrous clouds"], "contexts": ["delicate clouds associated with aurora", "type of cloud"]}, {"entity_id": "luminous_clouds", "book_id": "connexion_physical_sciences_somerville_1858", "name": "luminous clouds", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["luminous clouds"], "contexts": ["constitute photosphere"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "cirrous clouds", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "luminous clouds", "similarity": 0.888}], "id": 4875, "stable_key": "clu_0f2d4b5af98277d7", "ground_truth": {"modern_name": "cirrus clouds", "confidence": "medium", "type": "concept", "note": "The term 'luminous clouds' is less specific than 'cirrous clouds' and could refer to various atmospheric phenomena. However, in the context of aurora and photosphere, cirrus clouds are a plausible, though not definitive, interpretation of both."}}, {"canonical_name": "Pausanias", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pausanias", "book_id": "kosmos_humboldt_1845", "name": "Pausanias", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Pausanias"], "contexts": ["ancient Greek writer", "ancient writer who described elevation"]}, {"entity_id": "pau(ania", "book_id": "ricettario_fiorentino_1597", "name": "Pau(ania", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Pau(ania"], "contexts": ["authority describing the Grana plant"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Pausanias", "target_book": "ricettario_fiorentino_1597", "target_name": "Pau(ania", "similarity": 0.86}], "id": 4876, "stable_key": "clu_ce3376554d93aa80", "ground_truth": {"modern_name": "Pausanias", "confidence": "high", "type": "person", "description": "Ancient Greek traveler and geographer, author of Description of Greece.", "wikidata_id": "Q433408", "wikidata_description": "5th century BC Agiad King of Sparta", "wikipedia_url": "https://en.wikipedia.org/wiki/Pausanias%20%28king%20of%20Sparta%29", "wikipedia_extract": "Pausanias (Ancient Greek: \u03a0\u03b1\u03c5\u03c3\u03b1\u03bd\u03af\u03b1\u03c2) was the Agiad King of Sparta; the son of Pleistoanax. He ruled Sparta from 445 BC to 427 BC and again from 409 BC to 395 BC. He was the leader of the faction in Sparta that opposed the imperialist policy conducted by Lysander. Pausanias became king in 445 BC, when his father Pleistoanax was forced into exile because he made a peace settlement with Athens, which was deemed dishonourable in Sparta. Too young to reign, his uncle Cleomenes acted as regent. Pleistoanax then returned in 427 BC and resumed his reign."}}, {"canonical_name": "Kordofan", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "kordofan", "book_id": "kosmos_humboldt_1845", "name": "Kordofan", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Kordofan"], "contexts": ["region with volcanoes", "region where volcanoes are discussed"]}, {"entity_id": "kordofan", "book_id": "coloquios_da_orta_1563", "name": "Kordofan", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Kordofan"], "contexts": ["geographic location"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Kordofan", "target_book": "coloquios_da_orta_1563", "target_name": "Kordofan", "similarity": 1.0}], "id": 4877, "stable_key": "clu_ccac792ce4237a29", "ground_truth": {"modern_name": "Kordofan", "confidence": "high", "type": "place", "country": "Sudan", "wikidata_id": "Q2044659", "wikidata_description": "subspecies of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Kordofan%20giraffe", "wikipedia_extract": "Kordofan (Arabic: \u0643\u0631\u062f\u0641\u0627\u0646 Kurduf\u0101n) is a former province of central Sudan. In 1994 it was divided into three new federal states: North Kordofan, South Kordofan and West Kordofan. In August 2005, West Kordofan State was abolished and its territory divided between North and South Kordofan States, as part of the implementation of the Comprehensive Peace Agreement between the Government of Sudan and the Sudan People's Liberation Movement. West Kordofan was reestablished in July 2013. Kordofan covers an area of some 376,145 km2 (146,932 miles\u00b2), with an estimated population in 2000 of 3.6 million (3 million in 1983). It is largely an undulating plain, with the Nuba Mountains in the southeast quarter."}}, {"canonical_name": "Medina", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "medina", "book_id": "kosmos_humboldt_1845", "name": "Medina", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Medina"], "contexts": ["location of a volcano"]}, {"entity_id": "medina", "book_id": "coloquios_da_orta_1563", "name": "Medina", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Medina"], "contexts": ["city in Castella"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Medina", "target_book": "coloquios_da_orta_1563", "target_name": "Medina", "similarity": 0.891}], "id": 4878, "stable_key": "clu_8e1eb3b98508a5b3", "ground_truth": {"wikipedia_extract": "Medina del Campo is a town and municipality of Spain located in the autonomous community of Castile and Le\u00f3n. Part of the Province of Valladolid, it is the centre of a farming area. It lies on the banks of the Zapardiel river, in the central part of the Douro basin. Initially a Berber settlement, it was repopulated after 1085. By the 12th century the walled town had become a major population centre of the Kingdom of Castile, drawing large-scale trading operations. It was later granted right to hold its well-known free fairs, which attracted a notable presence of international dealers."}}, {"canonical_name": "detritus", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "detritus", "book_id": "kosmos_humboldt_1845", "name": "detritus", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["detritus"], "contexts": ["waste or debris from erosion", "exogenous mechanical deposit"]}, {"entity_id": "detritus", "book_id": "first_principles_spencer_1862", "name": "detritus", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["detritus"], "contexts": ["waste or debris from erosion"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "detritus", "target_book": "first_principles_spencer_1862", "target_name": "detritus", "similarity": 0.823}], "id": 4879, "stable_key": "clu_dd7098588875acf9", "ground_truth": {"modern_name": "Detritus", "confidence": "high", "type": "concept", "wikidata_id": "Q2750657", "wikidata_description": "animal that feeds on decomposing plant and animal parts as well as faeces", "wikipedia_url": "https://en.wikipedia.org/wiki/Detritivore", "wikipedia_extract": "Detritivores (also known as detrivores, detritophages, detritus feeders or detritus eaters) are heterotrophs that obtain nutrients by consuming detritus (decomposing plant and animal parts as well as feces). There are many kinds of invertebrates, vertebrates, and plants that eat detritus or carry out coprophagy. By doing so, all these detritivores contribute to decomposition and the nutrient cycles. Detritivores should be distinguished from other decomposers, such as many species of bacteria, fungi and protists, which are unable to ingest discrete lumps of matter. Instead, these other decomposers live by absorbing and metabolizing on a molecular scale (saprotrophic nutrition). The terms detritivore and decomposer are often used interchangeably, but they describe different organisms."}}, {"canonical_name": "Frederic Hoffman", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "frederic_hoffman", "book_id": "kosmos_humboldt_1845", "name": "Frederic Hoffman", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Frederic Hoffman"], "contexts": ["geologist, observed rock formation", "cited for rock formation"]}, {"entity_id": "fredericus_hoffmanus", "book_id": "polyanthea_medicinal", "name": "Fredericus Hoffmanus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Fredericus Hoffmanus"], "contexts": ["author of Methodi medendi"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Frederic Hoffman", "target_book": "polyanthea_medicinal", "target_name": "Fredericus Hoffmanus", "similarity": 0.918}], "id": 4880, "stable_key": "clu_303f84036cbdbd12", "ground_truth": {"modern_name": "Friedrich Hoffmann", "confidence": "high", "type": "person", "birth_year": 1660, "death_year": 1742, "description": "German physician and chemist, influential medical theorist and practitioner.", "wikidata_id": "Q76607", "wikidata_description": "German physician and chemist (1660\u20131742)", "wikipedia_url": "https://en.wikipedia.org/wiki/Friedrich%20Hoffmann", "wikipedia_extract": "Friedrich Hoffmann or Hofmann (19 February 1660 \u2013 12 November 1742) was a German physician and chemist. He is also sometimes known in English as Frederick Hoffmann. His family had been connected with medicine for 200 years before him. Born in Halle, he attended the local gymnasium where he acquired that taste for and skill in mathematics to which he attributed much of his later success. Beginning at age 18, he studied medicine at the University of Jena. From there, in 1680, he went to Erfurt, to attend Kasper Cramer's lectures on chemistry."}}, {"canonical_name": "strata of air", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "strata_of_air", "book_id": "kosmos_humboldt_1845", "name": "strata of air", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["strata of air"], "contexts": ["layers of the atmosphere"]}, {"entity_id": "stratum_of_air", "book_id": "connexion_physical_sciences_somerville_1858", "name": "stratum of air", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["stratum of air"], "contexts": ["layers of air affected by storms"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "strata of air", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "stratum of air", "similarity": 0.982}], "id": 4881, "stable_key": "clu_fdc03e3adccca72e", "ground_truth": {"modern_name": "Atmospheric layers", "confidence": "high", "type": "concept"}}, {"canonical_name": "fogs", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "fogs", "book_id": "kosmos_humboldt_1845", "name": "fogs", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["fogs"], "contexts": ["visible atmospheric moisture", "weather phenomenon"]}, {"entity_id": "fogs", "book_id": "connexion_physical_sciences_somerville_1858", "name": "fogs", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["fogs"], "contexts": ["cloud at ground level"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "fogs", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fogs", "similarity": 1.0}], "id": 4882, "stable_key": "clu_0b9775ae4a20aa21", "ground_truth": {"modern_name": "Fog", "confidence": "high", "type": "concept", "note": "The entry lists 'fogs' as a disease. This is likely a metaphorical or erroneous categorization, with 'fog' itself being the referent.", "wikidata_id": "Q1431308", "wikidata_description": "airport serving Foggia, Italy", "wikipedia_extract": "Fog is a visible aerosol consisting of tiny water droplets or ice crystals held in the air  near the Earth's surface. Fog can be considered a type of low-lying cloud usually resembling stratus and is heavily influenced by nearby bodies of water, topography, and wind conditions. In turn, fog affects many human activities, such as shipping, travel, and warfare. Fog appears when water vapor (water in its gaseous form) condenses. During condensation, molecules of water vapor combine to make tiny water droplets that hang in the air. Sea fog, which shows up near bodies of saline water, is formed as water vapor condenses on bits of salt.", "wikipedia_url": "https://en.wikipedia.org/wiki/Fog"}}, {"canonical_name": "geographical latitude", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "geographical_latitude", "book_id": "kosmos_humboldt_1845", "name": "geographical latitude", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["geographical latitude"], "contexts": ["latitude based on Earth's shape", "angular distance north or south of equator"]}, {"entity_id": "geographical_latitudes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "geographical latitudes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["geographical latitudes"], "contexts": ["position on Earth's surface"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "geographical latitude", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "geographical latitudes", "similarity": 0.957}], "id": 4883, "stable_key": "clu_181299ddb21abc71-3", "ground_truth": {"modern_name": "Latitude", "confidence": "high", "type": "concept", "wikidata_id": "Q34027", "wikidata_description": "angle between zenith and a plane parallel to the equator", "wikipedia_url": "https://en.wikipedia.org/wiki/Latitude", "wikipedia_extract": "In geography, latitude is a geographic coordinate that specifies the north-south position of a point on the surface of the Earth or another celestial body. Latitude is given as an angle that ranges from \u221290\u00b0 at the south pole to 90\u00b0 at the north pole, with 0\u00b0 at the Equator. Lines of constant latitude, or parallels, run east-west as circles parallel to the equator. Latitude and longitude are used together as a coordinate pair to specify a location on the surface of the Earth. On its own, the term latitude normally refers to the geodetic latitude as defined below. Briefly, the geodetic latitude of a point is the angle formed between the vector perpendicular (or normal) to the ellipsoidal surface from the point, and the plane of the equator."}}, {"canonical_name": "St. Augustine", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "st__augustine", "book_id": "kosmos_humboldt_1845", "name": "St. Augustine", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["St. Augustine"], "contexts": ["city in Florida, United States", "early Church father discussing creation after the flood"]}, {"entity_id": "st__augustin", "book_id": "first_principles_spencer_1862", "name": "St. Augustin", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["St. Augustin"], "contexts": ["early Christian theologian and philosopher"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "St. Augustine", "target_book": "first_principles_spencer_1862", "target_name": "St. Augustin", "similarity": 0.988}], "id": 4884, "stable_key": "clu_9b396a36ea0bc732-2", "ground_truth": {"modern_name": "Augustine of Hippo", "confidence": "high", "type": "person", "birth_year": 354, "death_year": 430, "description": "Early Christian theologian and philosopher, bishop of Hippo Regius.", "wikidata_id": "Q8018", "wikidata_description": "Christian theologian, philosopher, and saint (354\u2013430)", "wikipedia_url": "https://en.wikipedia.org/wiki/Augustine%20of%20Hippo", "wikipedia_extract": "Augustine of Hippo ( aw-GUST-in, US also  AW-g\u0259-steen; Latin: Aurelius Augustinus Hipponensis; 13 November 354 \u2013 28 August 430) was a Christian theologian and philosopher from Roman Africa. He was the bishop of Hippo Regius from Thagaste in Numidia Cirtensis, (present-day Souk Ahras, Algeria). His writings deeply influenced the development of Western philosophy and Western Christianity, and he is viewed as one of the most important Church Fathers of the Latin Church in the Patristic Period. His many important works include The City of God, On Christian Doctrine, and Confessions. According to his contemporary, Jerome of Stridon, Augustine \"established anew the ancient Faith\". In his youth he was drawn to the Manichaean faith, and later to the Hellenistic philosophy of Neoplatonism."}}, {"canonical_name": "law of rotation", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "law_of_rotation", "book_id": "kosmos_humboldt_1845", "name": "law of rotation", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["law of rotation"], "contexts": ["law concerning atmospheric phenomena", "scientific principle"]}, {"entity_id": "theory_of_rotation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "theory of rotation", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["theory of rotation"], "contexts": ["scientific theory about planetary rotation"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "law of rotation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "theory of rotation", "similarity": 0.904}], "id": 4885, "stable_key": "clu_6837775285e72873-2", "ground_truth": {"modern_name": "Law of rotation", "confidence": "high", "type": "concept", "note": "This likely refers to scientific laws or theories concerning rotational motion, including planetary rotation and atmospheric circulation.", "wikipedia_extract": "In linear algebra, a rotation matrix is a transformation matrix that is used to perform a rotation in Euclidean space. For example, using the convention below, the matrix {\\displaystyle R={\\begin{bmatrix}\\cos \\theta &-\\sin \\theta \\\\\\sin \\theta &\\cos \\theta \\end{bmatrix}}\\cdot } rotates points in the xy plane counterclockwise through an angle \u03b8 about the origin of a two-dimensional Cartesian coordinate system.", "wikipedia_url": "https://en.wikipedia.org/wiki/Rotation_matrix"}}, {"canonical_name": "Colladon", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "colladon", "book_id": "kosmos_humboldt_1845", "name": "Colladon", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Colladon"], "contexts": ["proposed electro-magnetic apparatus", "developed electro-magnetic apparatus"]}, {"entity_id": "colladon", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Colladon", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Colladon"], "contexts": ["experimenter on sound transmission in water"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Colladon", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Colladon", "similarity": 1.0}], "id": 4886, "stable_key": "clu_a37b94c6714fd2a1", "ground_truth": {"modern_name": "Daniel Colladon", "confidence": "high", "type": "person", "birth_year": 1802, "death_year": 1893, "description": "Swiss physicist who measured the speed of sound in water.", "wikidata_id": "Q108840410", "wikidata_description": ""}}, {"canonical_name": "Clark", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "clark", "book_id": "kosmos_humboldt_1845", "name": "Clark", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Clark"], "contexts": ["performed experiments at Dublin", "experiments on atmospheric electricity"]}, {"entity_id": "clarke", "book_id": "coloquios_da_orta_1563", "name": "Clarke", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Clarke"], "contexts": ["identified plant"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Clark", "target_book": "coloquios_da_orta_1563", "target_name": "Clarke", "similarity": 0.974}], "id": 4887, "stable_key": "clu_ec964231be3d9b0e", "ground_truth": {"modern_name": "John Clarke", "confidence": "medium", "type": "person", "birth_year": 1700, "death_year": 1771, "description": "Irish physician and chemist, known for his work on gout.", "note": "There are multiple notable individuals named 'Clark' or 'Clarke' in the early modern period. The context of performing experiments in Dublin and identifying plants suggests a natural philosopher or physician. John Clarke (1700-1771) fits this profile and is a plausible candidate. Further textual evidence would be needed for definitive identification."}}, {"canonical_name": "Negroes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "negroes", "book_id": "kosmos_humboldt_1845", "name": "Negroes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["negroes", "Negroes"], "contexts": ["group studied for brain research", "one of Prichard's seven races"]}, {"entity_id": "negros", "book_id": "polyanthea_medicinal", "name": "negros", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["negros"], "contexts": ["skin color"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Negroes", "target_book": "polyanthea_medicinal", "target_name": "negros", "similarity": 0.961}], "id": 4888, "stable_key": "clu_cec43993a2ad6f27", "ground_truth": {"modern_name": "Black people", "confidence": "high", "type": "concept", "note": "Refers to people of African ancestry, often in the context of scientific or anthropological studies.", "wikidata_id": "Q99585672", "wikidata_description": "AHRC Research Grant (2017)"}}, {"canonical_name": "Freyberg", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "freyburg", "book_id": "kosmos_humboldt_1845", "name": "Freyburg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Freyburg"], "contexts": ["location of mining school"]}, {"entity_id": "freyberg", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Freyberg", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Freyberg"], "contexts": ["location of Professor Reich", "location of mines with green plants"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Freyburg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Freyberg", "similarity": 0.937}], "id": 4889, "stable_key": "clu_208cb6ad1fb9622e-2", "ground_truth": {"modern_name": "Freiberg", "confidence": "high", "type": "place", "country": "Germany", "note": "References to mines, mining schools, and latitude calculations in the context of physical sciences point to Freiberg, a city historically known for its mining and mineralogical significance.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "Freiberg ist ein deutscher Familienname. Freiberg ist ein Herkunftsname f\u00fcr diejenigen, die aus einem Ort namens Freiberg oder Freyberg stammen. Freibergs, Freyberg, Freiberger, Freyberger Bj\u00f6rn Freiberg (* 1970), deutscher Schauspieler Daniel Freiberg (* 1957), US-amerikanischer Jazzmusiker Dietrich von Freiberg (um 1240\u20131310), Philosoph, Mystiker, Dominikaner und Theologe Dov Freiberg (1927\u20132008), polnisch-israelischer Holocaust\u00fcberlebender und Buchautor Gottfried von Freiberg (1908\u20131962), \u00f6sterreichischer Hornist Hedwig Freiberg (1872\u20131945), deutsche Malerin und Schauspielerin, Ehefrau von Robert Koch Heinrich von Freiberg (13. Jh.), Dichter und Minnes\u00e4nger Henning Freiberg (* 1937), deutscher Kunstp\u00e4dagoge und Hochschullehrer im Ruhestand Kjell-B\u00f8rge Freiberg (* 1971), norwegischer Politiker Konrad Freiberg (* 1951), deutscher Polizist und Gewerkschaftsvorsitzender Lorenz III. von Freiberg (vor 1459\u20131487), Bischof von Gurk Ludwig von Freiberg (1442\u2013vor 1480), Bischof von Konstanz Marcos A. Freiberg (1911\u20131990), argentinischer Zoologe Margit Freiberg (* 1962), deutsche Tischtennisspielerin Michael Freiberg (Politiker) (* 1956), deutscher Politiker (CDU) Michael Freiberg (Radsportler) (* 1990), australischer Radrennfahrer Mona Freiberg (* 1950), deutsche Volksschauspielerin und S\u00e4ngerin Peter Freiberg (* 1954), deutscher Drehbuchautor, Radiomoderator und S\u00e4nger Siegfried Freiberg (1901\u20131985), \u00f6sterreichischer Schriftsteller und Bibliothekar Steffen Freiberg (* 1981), deutscher Politiker Walter Freiberg (* 1922), deutscher Oberst im Ministerium f\u00fcr Staatssicherheit (MfS) der DDR Freiberg.", "wikipedia_url": "https://de.wikipedia.org/wiki/Freiberg_%28Familienname%29"}}, {"canonical_name": "Ethnology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ethnology", "book_id": "kosmos_humboldt_1845", "name": "Ethnology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Ethnology"], "contexts": ["field of study in report"]}, {"entity_id": "ethnology", "book_id": "first_principles_spencer_1862", "name": "Ethnology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Ethnology"], "contexts": ["study of human races"]}, {"entity_id": "ethnologic", "book_id": "first_principles_spencer_1862", "name": "ethnologic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ethnologic"], "contexts": ["related to the study of human races and cultures"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Ethnology", "target_book": "first_principles_spencer_1862", "target_name": "Ethnology", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Ethnology", "target_book": "first_principles_spencer_1862", "target_name": "ethnologic", "similarity": 0.907}], "id": 4890, "stable_key": "clu_27ee6b1b6fc430f8", "ground_truth": {"modern_name": "Ethnology", "confidence": "high", "type": "concept", "wikidata_id": "Q43455", "wikidata_description": "academic discipline", "wikipedia_url": "https://en.wikipedia.org/wiki/Ethnology", "wikipedia_extract": "Ethnology (from the Ancient Greek: \u1f14\u03b8\u03bd\u03bf\u03c2, ethnos meaning 'nation') is an academic field and discipline that compares and analyzes the characteristics of different peoples and the relationships between them (compare cultural, social, or sociocultural anthropology). Compared to ethnography, the study of single groups through direct contact with the culture, ethnology takes the research that ethnographers have compiled and then compares and contrasts different cultures. The term ethnologia (ethnology) is credited to Adam Franz Koll\u00e1r (1718\u20131783) who used and defined it in his Historiae ivrisqve pvblici Regni Vngariae amoenitates published in Vienna in 1783. as: \"the science of nations and peoples, or, that study of learned men in which they inquire into the origins, languages, customs, and institutions of various nations, and finally into the fatherland and ancient seats, in order to be able better to judge the nations and peoples in their own times.\" Koll\u00e1r's interest in linguistic and cultural diversity was aroused by the situation in his native multi-ethnic and multilingual Kingdom of Hungary and his roots among its Slovaks, and by the shifts that began to emerge after the gradual retreat of the Ottoman Empire in the more distant Balkans. Among the goals of ethnology have been the reconstruction of human history, and the formulation of cultural invariants, such as the incest taboo and culture change, and the formulation of generalizations about \"human nature\", a concept which has been criticized since the 19th century by various philosophers (Hegel, Marx, structuralism, etc.). In some parts of the world, ethnology has developed along independent paths of investigation and pedagogical doctrine, with cultural anthropology becoming dominant especially in the United States, and social anthropology in Great Britain."}}, {"canonical_name": "physical transformations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "physical_metamorphoses", "book_id": "kosmos_humboldt_1845", "name": "physical metamorphoses", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["physical metamorphoses"], "contexts": ["changes in physical nature"]}, {"entity_id": "physical_transformations", "book_id": "first_principles_spencer_1862", "name": "physical transformations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["physical transformations"], "contexts": ["changes in physical form"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "physical metamorphoses", "target_book": "first_principles_spencer_1862", "target_name": "physical transformations", "similarity": 0.945}], "id": 4891, "stable_key": "clu_d445f48951b1a3d0", "ground_truth": {"modern_name": "Physical Transformations", "confidence": "high", "type": "concept", "wikidata_id": "Q104068816", "wikidata_description": "scientific article published on 04 December 2020"}}, {"canonical_name": "Density of the Earth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "density_of_the_earth", "book_id": "kosmos_humboldt_1845", "name": "Density of the Earth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Density of the Earth"], "contexts": ["mass per unit volume of the Earth"]}, {"entity_id": "density_of_the_earth", "book_id": "connexion_physical_sciences_somerville_1858", "name": "density of the earth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["density of the earth"], "contexts": ["determined by James"]}, {"entity_id": "earth\u2019s_density", "book_id": "connexion_physical_sciences_somerville_1858", "name": "earth\u2019s density", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["earth\u2019s density"], "contexts": ["tested by pendulum experiments"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Density of the Earth", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "density of the earth", "similarity": 0.99}, {"source_book": "kosmos_humboldt_1845", "source_name": "Density of the Earth", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "earth\u2019s density", "similarity": 0.982}], "id": 4892, "stable_key": "clu_ca0da5f422ccf4fb", "ground_truth": {"modern_name": "Earth's Density", "confidence": "high", "type": "concept"}}, {"canonical_name": "metamorphose", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "metamorphose", "book_id": "kosmos_humboldt_1845", "name": "metamorphose", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["metamorphose"], "contexts": ["changing the nature of rocks"]}, {"entity_id": "metamorphoses", "book_id": "kosmos_humboldt_1845", "name": "metamorphoses", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["metamorphoses"], "contexts": ["transformations of matter"]}, {"entity_id": "metamorphoses", "book_id": "coloquios_da_orta_1563", "name": "metamorphoses", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["metamorphoses"], "contexts": ["transformations in mythology"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "metamorphose", "target_book": "coloquios_da_orta_1563", "target_name": "metamorphoses", "similarity": 0.972}, {"source_book": "kosmos_humboldt_1845", "source_name": "metamorphoses", "target_book": "coloquios_da_orta_1563", "target_name": "metamorphoses", "similarity": 1.0}], "id": 4893, "stable_key": "clu_5c4fe5c70e17a642-2", "ground_truth": {"modern_name": "Metamorphosis", "confidence": "high", "type": "concept", "wikidata_id": "Q33753", "wikidata_description": "profound change in body structure during the postembryonic development of an organism", "wikipedia_url": "https://en.wikipedia.org/wiki/Metamorphosis", "wikipedia_extract": "Metamorphosis is a biological process by which an animal physically develops  including  birth transformation or hatching, involving a conspicuous and relatively abrupt change in the animal's body structure through cell growth and differentiation. Some insects, fish, amphibians, mollusks, crustaceans, cnidarians, echinoderms, and tunicates undergo metamorphosis, which is often accompanied by a change of nutrition source or behavior. Animals can be divided into species that undergo complete metamorphosis (\"holometaboly\"), incomplete metamorphosis (\"hemimetaboly\"), or no metamorphosis (\"ametaboly\"). Generally organisms with a larval stage undergo metamorphosis, and during metamorphosis the organism loses larval characteristics. The word metamorphosis derives from Ancient Greek \u03bc\u03b5\u03c4\u03b1\u03bc\u03cc\u03c1\u03c6\u03c9\u03c3\u03b9\u03c2, \"transformation, transforming\", from \u03bc\u03b5\u03c4\u03b1- (meta-), \"after\" and \u03bc\u03bf\u03c1\u03c6\u03ae (morphe), \"form\". In insects, growth and metamorphosis are controlled by hormones synthesized by endocrine glands near the front of the body (anterior)."}}, {"canonical_name": "meteorologic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "meteorological", "book_id": "kosmos_humboldt_1845", "name": "meteorological", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["meteorological"], "contexts": ["relating to weather phenomena"]}, {"entity_id": "meteorologic", "book_id": "first_principles_spencer_1862", "name": "meteorologic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["meteorologic"], "contexts": ["relating to weather", "relating to weather phenomena"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "meteorological", "target_book": "first_principles_spencer_1862", "target_name": "meteorologic", "similarity": 0.981}], "id": 4894, "stable_key": "clu_101df4218b7bae46-4", "ground_truth": {"modern_name": "Meteorology", "confidence": "high", "type": "concept", "wikidata_id": "Q25261", "wikidata_description": "branch of science dealing with the study of atmospheric phenomena and the short term variation of weather conditions including wind, precipitation, temperature, humidity, cloud cover, and air pressure", "wikipedia_url": "https://en.wikipedia.org/wiki/Meteorology", "note": "Refers to Aristotle's work on atmospheric phenomena.", "wikipedia_extract": "Meteorology is the scientific study of the Earth's atmosphere and short-term atmospheric phenomena (i.e., weather), with a focus on weather forecasting. It has applications in the military, aviation, energy production, transport, agriculture, construction, weather warnings, and disaster management. Along with climatology, atmospheric physics, atmospheric chemistry, and aeronomy, meteorology forms the broader field of the atmospheric sciences. The interactions between Earth's atmosphere and its oceans (notably El Ni\u00f1o and La Ni\u00f1a) are studied in the interdisciplinary field of hydrometeorology. Other interdisciplinary areas include biometeorology, space weather, and planetary meteorology. Marine weather forecasting relates meteorology to maritime and coastal safety, based on atmospheric interactions with large bodies of water."}}, {"canonical_name": "Silhet", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "silhet", "book_id": "kosmos_humboldt_1845", "name": "Silhet", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Silhet"], "contexts": ["mountains near Calcutta"]}, {"entity_id": "silhet", "book_id": "coloquios_da_orta_1563", "name": "Silhet", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Silhet"], "contexts": ["region near Khasya mountains", "valleys, habitat of tree"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Silhet", "target_book": "coloquios_da_orta_1563", "target_name": "Silhet", "similarity": 1.0}], "id": 4895, "stable_key": "clu_783168ada3d1f231", "ground_truth": {"modern_name": "Sylhet", "confidence": "high", "type": "place", "country": "Bangladesh", "note": "Region historically associated with the Khasi Hills.", "wikipedia_extract": "The Sylhet Shahi Eidgah (Bengali: \u09b8\u09bf\u09b2\u09c7\u099f \u09b6\u09be\u09b9\u09c0 \u0988\u09a6\u0997\u09be\u09b9), or simply Shahi Eidgah, is an open prayer hall situated in Sylhet, north-east Bangladesh, three kilometers to the north-east of the guru nanak international circuit house, meant for the Eid prayers. It is also one of the most visited tourist spots in the city. As well as for prayer uses and Islamic congregations, the eidgah has historically been a place to give speeches and host rallies by the likes of Mohandas Gandhi and Muhammad Ali Jinnah. There have also been battles taken place there such as the Muharram Rebellion. During the rule of Mughal emperor Aurangzeb, Farhad Khan was appointed as the faujdar of Sylhet. Farhad Khan supervised the construction of the Shahi Eidgah on a hill in the 17th century.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sylhet_Shahi_Eidgah"}}, {"canonical_name": "ribes", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ribes", "book_id": "kosmos_humboldt_1845", "name": "Ribes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Ribes"], "contexts": ["genus of prickly plants"]}, {"entity_id": "ribes", "book_id": "ricettario_fiorentino_1597", "name": "ribes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["ribes", "RIBES"], "contexts": ["a plant, likely currant", "plant with reddish stem and round leaves"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Ribes", "target_book": "ricettario_fiorentino_1597", "target_name": "ribes", "similarity": 0.891}], "id": 4896, "stable_key": "clu_44648610e6840f5e", "ground_truth": {"modern_name": "Ribes", "confidence": "high", "type": "plant", "linnaean": "Ribes L.", "family": "Grossulariaceae", "wikidata_id": "Q22691", "wikidata_description": "genus of plants"}}, {"canonical_name": "stamens", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "stamens", "book_id": "kosmos_humboldt_1845", "name": "stamens", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["stamens"], "contexts": ["male reproductive part of a flower"]}, {"entity_id": "stamens", "book_id": "first_principles_spencer_1862", "name": "stamens", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["stamens"], "contexts": ["part of a flower"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "stamens", "target_book": "first_principles_spencer_1862", "target_name": "stamens", "similarity": 1.0}], "id": 4897, "stable_key": "clu_b092b767307db7bb", "ground_truth": {"modern_name": "Stamen", "confidence": "high", "type": "concept", "wikidata_id": "Q103129", "wikidata_description": "male organ of a flower"}}, {"canonical_name": "humani corporis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "human_anatomy", "book_id": "kosmos_humboldt_1845", "name": "human anatomy", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["human anatomy"], "contexts": ["study of the human body"]}, {"entity_id": "humani_corporis", "book_id": "polyanthea_medicinal", "name": "humani corporis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["humani corporis"], "contexts": ["of the human body", "human body"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "human anatomy", "target_book": "polyanthea_medicinal", "target_name": "humani corporis", "similarity": 0.971}], "id": 4898, "stable_key": "clu_5fc06ac9a3981f79", "ground_truth": {"modern_name": "Human Anatomy", "confidence": "high", "type": "concept", "wikidata_id": "Q3999", "wikidata_description": "scientific study of the morphology of the human body", "wikipedia_url": "https://en.wikipedia.org/wiki/Human%20anatomy", "wikipedia_extract": "Human anatomy (gr. \u1f00\u03bd\u03b1\u03c4\u03bf\u03bc\u03af\u03b1, \"dissection\", from \u1f00\u03bd\u03ac, \"up\", and \u03c4\u03ad\u03bc\u03bd\u03b5\u03b9\u03bd, \"cut\") is primarily the scientific study of the morphology of the human body. Anatomy is subdivided into gross anatomy and microscopic anatomy. Gross anatomy (also called macroscopic anatomy, topographical anatomy, regional anatomy, or anthropotomy) is the study of anatomical structures that can be seen by the naked eye. Microscopic anatomy is the study of minute anatomical structures assisted with microscopes, which includes histology (the study of the organization of tissues), and cytology (the study of cells). Anatomy, human physiology (the study of function), and biochemistry (the study of the chemistry of living structures) are complementary basic medical sciences that are generally together (or in tandem) to students studying medical sciences."}}, {"canonical_name": "rings", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "rings", "book_id": "kosmos_humboldt_1845", "name": "rings", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["rings"], "contexts": ["circular structures observed in nebulae"]}, {"entity_id": "rings", "book_id": "connexion_physical_sciences_somerville_1858", "name": "rings", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["rings"], "contexts": ["optical phenomena observed", "circular patterns of light"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "rings", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "rings", "similarity": 1.0}], "id": 4899, "stable_key": "clu_aa8bb7f14a0df5c0", "ground_truth": {"modern_name": "Rings", "confidence": "high", "type": "object", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Chaldeans", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "chaldeans", "book_id": "kosmos_humboldt_1845", "name": "Chaldeans", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Chaldeans"], "contexts": ["ancient people known for astrology"]}, {"entity_id": "chaldeans", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Chaldeans", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Chaldeans"], "contexts": ["observers of ancient eclipses", "ancient observers of celestial bodies"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Chaldeans", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Chaldeans", "similarity": 0.866}], "id": 4900, "stable_key": "clu_a222e08b46aae786", "ground_truth": {"modern_name": "Chaldeans", "confidence": "high", "type": "concept", "wikidata_id": "Q200969", "wikidata_description": "small country between the late 10th or early 9th and mid-6th centuries BC"}}, {"canonical_name": "Human happiness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "human_joy", "book_id": "kosmos_humboldt_1845", "name": "human joy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human joy"], "contexts": ["feeling of happiness in humans"]}, {"entity_id": "human_happiness", "book_id": "first_principles_spencer_1862", "name": "Human happiness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Human happiness", "human happiness"], "contexts": ["ultimate measure of well-being", "state of well-being and contentment"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "human joy", "target_book": "first_principles_spencer_1862", "target_name": "Human happiness", "similarity": 0.881}], "id": 4901, "stable_key": "clu_f2cd8a672141fc4d", "ground_truth": {"modern_name": "Human Happiness", "confidence": "high", "type": "concept", "wikidata_id": "Q93671278", "wikidata_description": "scientific article published in December 1970"}}, {"canonical_name": "luminous body", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "luminous_body", "book_id": "kosmos_humboldt_1845", "name": "luminous body", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["luminous body"], "contexts": ["object emitting light"]}, {"entity_id": "luminous", "book_id": "kosmos_humboldt_1845", "name": "luminous", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["luminous"], "contexts": ["emitting light"]}, {"entity_id": "luminous", "book_id": "connexion_physical_sciences_somerville_1858", "name": "luminous", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["luminous"], "contexts": ["emitting or reflecting light"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "luminous body", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "luminous", "similarity": 0.882}, {"source_book": "kosmos_humboldt_1845", "source_name": "lumino