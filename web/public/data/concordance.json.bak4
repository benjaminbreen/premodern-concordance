: "connexion_physical_sciences_somerville_1858", "name": "Alum", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 9, "variants": ["Alum", "alum"], "contexts": ["mineral dissolved in water for crystallization", "transmits light, stops heat"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Alum", "target_book": "kosmos_humboldt_1845", "target_name": "aluminous", "similarity": 0.913}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Alum", "target_book": "polyanthea_medicinal", "target_name": "aluminis", "similarity": 0.908}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Alum", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Alum", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "aluminous", "target_book": "polyanthea_medicinal", "target_name": "aluminis", "similarity": 0.949}, {"source_book": "kosmos_humboldt_1845", "source_name": "aluminous", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Alum", "similarity": 0.913}, {"source_book": "polyanthea_medicinal", "source_name": "aluminis", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Alum", "similarity": 0.908}], "id": 533, "stable_key": "clu_8e60ff9c186fcac6", "ground_truth": {"modern_name": "Alum", "confidence": "high", "type": "mineral", "wikidata_id": "Q421857", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Aluminium%20sulfate", "wikipedia_extract": "Aluminium sulfate is a salt with the formula Al2(SO4)3. It is soluble in water and is mainly used as a coagulating agent (promoting particle collision by neutralizing charge) in the purification of drinking water and wastewater treatment plants, and also in paper manufacturing. The anhydrous form occurs naturally as a rare mineral millosevichite, found for example in volcanic environments and on burning coal-mining waste dumps. Aluminium sulfate is rarely, if ever, encountered as the anhydrous salt. It forms a number of different hydrates, of which the hexadecahydrate Al2(SO4)3\u00b716H2O and octadecahydrate Al2(SO4)3\u00b718H2O are the most common. The heptadecahydrate, whose formula can be written as [Al(H2O)6]2(SO4)3\u00b75H2O, occurs naturally as the mineral alunogen."}}, {"canonical_name": "Folio", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 16, "members": [{"entity_id": "flax", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Flax", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Flax"], "contexts": ["plant used for charcoal in gunpowder"]}, {"entity_id": "leaf", "book_id": "english_physician_1652", "name": "Leaf", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Leaf"], "contexts": ["part of a plant"]}, {"entity_id": "folio", "book_id": "ricettario_fiorentino_1597", "name": "Folio", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 11, "variants": ["Folio", "Folio indo", "Folio j", "Folio vero", "folio"], "contexts": ["leaf for syrup", "leaf ingredient in a preparation"]}, {"entity_id": "leaf", "book_id": "first_principles_spencer_1862", "name": "leaf", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["leaf"], "contexts": ["part of a plant", "part of a plant affected by weight"]}, {"entity_id": "foliage", "book_id": "first_principles_spencer_1862", "name": "foliage", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["foliage"], "contexts": ["mixed mass on branches"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Flax", "target_book": "ricettario_fiorentino_1597", "target_name": "Folio", "similarity": 0.883}, {"source_book": "english_physician_1652", "source_name": "Leaf", "target_book": "first_principles_spencer_1862", "target_name": "leaf", "similarity": 0.998}, {"source_book": "english_physician_1652", "source_name": "Leaf", "target_book": "first_principles_spencer_1862", "target_name": "foliage", "similarity": 0.923}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Folio", "target_book": "first_principles_spencer_1862", "target_name": "foliage", "similarity": 0.907}], "id": 534, "stable_key": "clu_1b25b98a5bbc50f3", "ground_truth": {"modern_name": "Leaf", "confidence": "high", "type": "plant", "description": "The part of a plant attached to a stem or branch.", "wikipedia_extract": "A leaf (pl.: leaves) is a principal appendage of the stem of a vascular plant, usually borne laterally above ground and specialized for photosynthesis. Leaves are collectively called foliage, as in \"autumn foliage\", while the leaves, stem, flower, and fruit collectively form the shoot system. In most leaves, the primary photosynthetic tissue is the palisade mesophyll and is located on the upper side of the blade or lamina of the leaf, but in some species, including the mature foliage of Eucalyptus, palisade mesophyll is present on both sides and the leaves are said to be isobilateral. The leaf is an integral part of the stem system, and most leaves are flattened and have distinct upper (adaxial) and lower (abaxial) surfaces that differ in color, hairiness, the number of stomata (pores that intake and output gases), the amount and structure of epicuticular wax, and other features. Leaves are mostly green in color due to the presence of a compound called chlorophyll which is essential for photosynthesis as it absorbs light energy from the Sun. A leaf with lighter-colored or white patches or edges is called a variegated leaf."}}, {"canonical_name": "conceptions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 16, "members": [{"entity_id": "conceptions", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "conceptions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["conceptions"], "contexts": ["perfect ideas or forms"]}, {"entity_id": "conception", "book_id": "english_physician_1652", "name": "Conception", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Conception", "Conction"], "contexts": ["hindered by herb", "process of becoming pregnant"]}, {"entity_id": "conceptions", "book_id": "principles_of_psychology_james_1890", "name": "conceptions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["conceptions", "Conceptions"], "contexts": ["mental grasp of ideas", "mental representations of objects"]}, {"entity_id": "conceptions", "book_id": "first_principles_spencer_1862", "name": "conceptions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["conceptions"], "contexts": ["mental representations of actualities", "mental representations or ideas"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "conceptions", "target_book": "english_physician_1652", "target_name": "Conception", "similarity": 0.886}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "conceptions", "target_book": "principles_of_psychology_james_1890", "target_name": "conceptions", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "conceptions", "target_book": "first_principles_spencer_1862", "target_name": "conceptions", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Conception", "target_book": "principles_of_psychology_james_1890", "target_name": "conceptions", "similarity": 0.886}, {"source_book": "english_physician_1652", "source_name": "Conception", "target_book": "first_principles_spencer_1862", "target_name": "conceptions", "similarity": 0.886}, {"source_book": "principles_of_psychology_james_1890", "source_name": "conceptions", "target_book": "first_principles_spencer_1862", "target_name": "conceptions", "similarity": 1.0}], "id": 535, "stable_key": "clu_816af673477a2afe-2", "ground_truth": {"modern_name": "Conception", "confidence": "high", "type": "concept", "note": "This cluster refers to both the biological process of pregnancy and the philosophical/psychological process of forming an idea or understanding.", "wikidata_id": "Q1880", "wikidata_description": "city in Chile", "wikipedia_url": "https://en.wikipedia.org/wiki/Concepci%C3%B3n%2C%20Chile", "wikipedia_extract": "Concepci\u00f3n (Spanish pronunciation: [konse\u03b2\u02c8sjon] ; originally: Concepci\u00f3n de la Madre Sant\u00edsima de la Luz, \"Conception of the Blessed Mother of Light\") is a city and commune in south-central Chile, and the geographical and demographic core of the Greater Concepci\u00f3n metropolitan area, it is the second largest city in Chile by urban area and one of the three major conurbations in the country. It has a significant impact on domestic trade being part of the most heavily industrialized region in the country. It is the seat of the Concepci\u00f3n Province and the capital of the Biob\u00edo Region. It sits about 500 km south of the nation's capital, Santiago. The city was first settled in the Bay of Concepci\u00f3n, in the zone that would later become the commune of Penco, now part of the Concepci\u00f3n conurbation. The city's demonym, penquista, comes from the place of its original foundation."}}, {"canonical_name": "lim\u00f3n", "category": "PLANT", "subcategory": "TREE", "book_count": 4, "total_mentions": 16, "members": [{"entity_id": "lime-tree", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Lime-tree", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Lime-tree"], "contexts": ["type of tree"]}, {"entity_id": "lim\u00f3n", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "lim\u00f3n", "category": "PLANT", "subcategory": "TREE", "count": 11, "variants": ["lim\u00f3n", "Lim\u00f3n"], "contexts": ["lemon tree, used for leaf comparison", "leaves compared to lemon tree"]}, {"entity_id": "lymon", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "lymon", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["lymon"], "contexts": ["tree similar in height to quauhiyetl"]}, {"entity_id": "limon", "book_id": "relation_historique_humboldt_vol3_1825", "name": "limon", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["limon"], "contexts": ["sediment deposited by floods", "lemon tree"]}, {"entity_id": "limon", "book_id": "historia_medicinal_monardes_1574", "name": "Limon", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Limon"], "contexts": ["tree used for comparison of plant size"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lime-tree", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "lim\u00f3n", "similarity": 0.904}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lime-tree", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "limon", "similarity": 0.885}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lime-tree", "target_book": "historia_medicinal_monardes_1574", "target_name": "Limon", "similarity": 0.9}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "lim\u00f3n", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "limon", "similarity": 0.923}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "lim\u00f3n", "target_book": "historia_medicinal_monardes_1574", "target_name": "Limon", "similarity": 0.968}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "lymon", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "limon", "similarity": 0.897}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "lymon", "target_book": "historia_medicinal_monardes_1574", "target_name": "Limon", "similarity": 0.895}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "limon", "target_book": "historia_medicinal_monardes_1574", "target_name": "Limon", "similarity": 0.926}], "id": 536, "stable_key": "clu_6b783464a5d098b9", "ground_truth": {"modern_name": "lime", "confidence": "high", "type": "plant", "linnaean": "Tilia L.", "family": "Malvaceae", "note": "The term 'limon' and 'lime-tree' in early modern texts can refer to citrus limes or lime trees. Given the context of 'tree', 'lime-tree' points to Tilia.", "wikidata_id": "Q127849", "wikidata_description": "genus of plants"}}, {"canonical_name": "green", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 16, "members": [{"entity_id": "green", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "green", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["green"], "contexts": ["color perceived through glass"]}, {"entity_id": "green", "book_id": "principles_of_psychology_james_1890", "name": "green", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["Green", "green"], "contexts": ["color perceived by the psychologist", "turn to for psychology"]}, {"entity_id": "green", "book_id": "kosmos_humboldt_1845", "name": "green", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["green"], "contexts": ["color"]}, {"entity_id": "green", "book_id": "connexion_physical_sciences_somerville_1858", "name": "green", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 9, "variants": ["green"], "contexts": ["colour in the spectrum", "color of the spectrum"]}, {"entity_id": "yellow_green", "book_id": "connexion_physical_sciences_somerville_1858", "name": "yellow green", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["yellow green"], "contexts": ["color of light"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "green", "target_book": "principles_of_psychology_james_1890", "target_name": "green", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "green", "target_book": "kosmos_humboldt_1845", "target_name": "green", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "green", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "green", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "green", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "yellow green", "similarity": 0.925}, {"source_book": "principles_of_psychology_james_1890", "source_name": "green", "target_book": "kosmos_humboldt_1845", "target_name": "green", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "green", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "green", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "green", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "yellow green", "similarity": 0.925}, {"source_book": "kosmos_humboldt_1845", "source_name": "green", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "green", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "green", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "yellow green", "similarity": 0.925}], "id": 537, "stable_key": "clu_f5885a64dce56b6d", "ground_truth": {"modern_name": "color green", "confidence": "high", "type": "concept", "wikidata_id": "Q3133", "wikidata_description": "additive primary color, visible between blue and yellow", "wikipedia_url": "https://en.wikipedia.org/wiki/Green", "wikipedia_extract": "Green is the color between cyan and yellow on the visible spectrum. It is evoked by light which has a dominant wavelength of roughly 495\u2013570 nm. In subtractive color systems, used in painting and color printing, it is created by a combination of yellow and cyan; in the RGB color model, used on television and computer screens, it is one of the additive primary colors, along with red and blue, which are mixed in different combinations to create all other colors. By far the largest contributor to green in nature is chlorophyll, the chemical by which plants photosynthesize and convert sunlight into chemical energy. Many creatures have adapted to their green environments by taking on a green hue themselves as camouflage. Several minerals have a green color, including the emerald, which is colored green by its chromium content."}}, {"canonical_name": "Am\u00e9rique m\u00e9ridionale", "category": "PLACE", "subcategory": "REGION", "book_count": 4, "total_mentions": 16, "members": [{"entity_id": "am\u00e9rique_m\u00e9ridionale", "book_id": "epoques_nature_buffon_1778", "name": "Am\u00e9rique m\u00e9ridionale", "category": "PLACE", "subcategory": "REGION", "count": 12, "variants": ["Am\u00e9rique m\u00e9ridionale"], "contexts": ["southern part of the Americas", "part of America separated from Africa"]}, {"entity_id": "central_america", "book_id": "origin_of_species_darwin_1859", "name": "Central America", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Central America"], "contexts": ["region with distinct marine faunas"]}, {"entity_id": "central_america", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Central America", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Central America"], "contexts": ["region with monsoons"]}, {"entity_id": "central_america", "book_id": "first_principles_spencer_1862", "name": "Central America", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Central America"], "contexts": ["geographical region", "geographic region undergoing subsidence"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Am\u00e9rique m\u00e9ridionale", "target_book": "origin_of_species_darwin_1859", "target_name": "Central America", "similarity": 0.894}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Am\u00e9rique m\u00e9ridionale", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Central America", "similarity": 0.894}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Am\u00e9rique m\u00e9ridionale", "target_book": "first_principles_spencer_1862", "target_name": "Central America", "similarity": 0.894}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Central America", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Central America", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Central America", "target_book": "first_principles_spencer_1862", "target_name": "Central America", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Central America", "target_book": "first_principles_spencer_1862", "target_name": "Central America", "similarity": 1.0}], "id": 538, "stable_key": "clu_79cbdf2484b869b5", "ground_truth": {"modern_name": "Central America", "confidence": "high", "type": "place", "country": "Multiple countries", "wikidata_id": "Q388032", "wikidata_description": "species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Geoffroy%27s%20spider%20monkey", "wikipedia_extract": "Geoffroy's spider monkey (Ateles geoffroyi), also known as the black-handed spider monkey or the Central American spider monkey, is a species of spider monkey, a type of New World monkey, from Central America, parts of Mexico and possibly a small portion of Colombia. There are at least five subspecies. Some primatologists classify the black-headed spider monkey (A. fusciceps), found in Panama, Colombia, and Ecuador as the same species as Geoffroy's spider monkey. It is one of the largest New World monkeys, often weighing as much as 9 kg (20 lb). Its arms are significantly longer than its legs, and its prehensile tail can support the entire weight of the monkey and is used as an extra limb."}}, {"canonical_name": "valeriana", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 16, "members": [{"entity_id": "garden_valerian", "book_id": "english_physician_1652", "name": "Garden Valerian", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Garden Valerian", "Garden Valcrian"], "contexts": ["plant with a thick root", "herb with warming faculty"]}, {"entity_id": "valeriana", "book_id": "coloquios_da_orta_1563", "name": "Valeriana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Valeriana"], "contexts": ["plant genus", "genus of a plant"]}, {"entity_id": "valeriana", "book_id": "ricettario_fiorentino_1597", "name": "Valeriana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Valeriana", "valeriana"], "contexts": ["plant with two varieties", "fragrant root for pounding"]}, {"entity_id": "valeriana", "book_id": "polyanthea_medicinal", "name": "valeriana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["valeriana", "Valeriana", "valeria"], "contexts": ["herb used for treatment", "roots used in a remedy"]}, {"entity_id": "valeriana_agre\u017fte", "book_id": "polyanthea_medicinal", "name": "Valeriana agre\u017fte", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Valeriana agre\u017fte"], "contexts": ["wild valerian, used in remedy"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Garden Valerian", "target_book": "coloquios_da_orta_1563", "target_name": "Valeriana", "similarity": 0.893}, {"source_book": "english_physician_1652", "source_name": "Garden Valerian", "target_book": "ricettario_fiorentino_1597", "target_name": "Valeriana", "similarity": 0.893}, {"source_book": "coloquios_da_orta_1563", "source_name": "Valeriana", "target_book": "ricettario_fiorentino_1597", "target_name": "Valeriana", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Valeriana", "target_book": "polyanthea_medicinal", "target_name": "valeriana", "similarity": 0.887}, {"source_book": "coloquios_da_orta_1563", "source_name": "Valeriana", "target_book": "polyanthea_medicinal", "target_name": "Valeriana agre\u017fte", "similarity": 0.881}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Valeriana", "target_book": "polyanthea_medicinal", "target_name": "valeriana", "similarity": 0.887}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Valeriana", "target_book": "polyanthea_medicinal", "target_name": "Valeriana agre\u017fte", "similarity": 0.881}], "id": 539, "stable_key": "clu_529b162c660ced81", "ground_truth": {"modern_name": "valerian", "confidence": "high", "type": "plant", "linnaean": "Valeriana spp.", "family": "Caprifoliaceae", "description": "A plant genus, with roots valued for medicinal and sedative properties.", "wikipedia_extract": "Valeriana is a genus of flowering plants in the family Caprifoliaceae, members of which may be commonly known as valerians. It contains many species, including the garden valerian, Valeriana officinalis. Valeriana has centers of diversity in Eurasia and South America (especially in the Andes), and is represented by native species on all continents except Antarctica. Some species have been introduced to parts of the world outside their native range, including Valeriana rubra in the western United States and Valeriana macrosiphon in Western Australia. The genus was named by Carl Linnaeus after the Roman emperor Publius Licinius Valerianus who was said to use the plant as medicine. The emperor's personal name comes from Valeria and the Latin verb valeo which means \"to be strong\". 32 previously recognized genera, including Centranthus, Fedia, and Plectritis, are now considered synonyms of Valeriana."}}, {"canonical_name": "queymaduras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 4, "total_mentions": 16, "members": [{"entity_id": "burnt", "book_id": "english_physician_1652", "name": "burnt", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["burnt"], "contexts": ["places treated with crab juice", "injury from fire"]}, {"entity_id": "quemaduras", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "quemaduras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["quemaduras"], "contexts": ["burns", "burns treated with plant"]}, {"entity_id": "burns", "book_id": "principles_of_psychology_james_1890", "name": "burns", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["burns"], "contexts": ["tissue damage from heat"]}, {"entity_id": "burn", "book_id": "principles_of_psychology_james_1890", "name": "burn", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["burn"], "contexts": ["tissue damage from heat"]}, {"entity_id": "queymaduras", "book_id": "polyanthea_medicinal", "name": "queymaduras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 9, "variants": ["queymaduras", "Queimaduras", "queimaduras", "queymadura", "queymaduras do fogo"], "contexts": ["burns", "burns, treated with remedies"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "burnt", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "quemaduras", "similarity": 0.924}, {"source_book": "english_physician_1652", "source_name": "burnt", "target_book": "principles_of_psychology_james_1890", "target_name": "burns", "similarity": 0.945}, {"source_book": "english_physician_1652", "source_name": "burnt", "target_book": "principles_of_psychology_james_1890", "target_name": "burn", "similarity": 0.957}, {"source_book": "english_physician_1652", "source_name": "burnt", "target_boo