nciples_of_psychology_james_1890", "target_name": "pleasure", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "pleasure", "target_book": "kosmos_humboldt_1845", "target_name": "enjoyment", "similarity": 0.905}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "pleasure", "target_book": "first_principles_spencer_1862", "target_name": "pleasures", "similarity": 0.952}, {"source_book": "principles_of_psychology_james_1890", "source_name": "pleasure", "target_book": "kosmos_humboldt_1845", "target_name": "enjoyment", "similarity": 0.905}, {"source_book": "principles_of_psychology_james_1890", "source_name": "pleasure", "target_book": "first_principles_spencer_1862", "target_name": "pleasures", "similarity": 0.952}, {"source_book": "kosmos_humboldt_1845", "source_name": "enjoyment", "target_book": "first_principles_spencer_1862", "target_name": "pleasures", "similarity": 0.891}], "id": 594, "stable_key": "clu_996033f6f4d0407f", "ground_truth": {"modern_name": "Pleasure", "confidence": "high", "type": "concept", "wikidata_id": "Q208195", "wikidata_description": "broad class of mental states that humans and other animals experience as positive, enjoyable, or worth seeking", "wikipedia_url": "https://en.wikipedia.org/wiki/Pleasure", "wikipedia_extract": "Pleasure is experience that feels good, that involves the enjoyment of something. It contrasts with pain or suffering, which are forms of feeling bad. It is closely related to value, desire and action: humans and other conscious animals find pleasure enjoyable, positive or worthy of seeking. A great variety of activities may be experienced as pleasurable, like eating, having sex, listening to music or playing games. Pleasure is part of various other mental states such as ecstasy, euphoria and flow. Happiness and well-being are closely related to pleasure but not identical with it."}}, {"canonical_name": "magnetic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 12, "members": [{"entity_id": "magnetical", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Magnetical", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Magnetical"], "contexts": ["relating to magnetism"]}, {"entity_id": "magnetic", "book_id": "kosmos_humboldt_1845", "name": "magnetic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["magnetic"], "contexts": ["related to magnetism", "relating to magnetism"]}, {"entity_id": "magnetic", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["magnetic"], "contexts": ["property related to magnetism", "related to magnetism"]}, {"entity_id": "magnetic", "book_id": "first_principles_spencer_1862", "name": "magnetic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic"], "contexts": ["relating to magnetism"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Magnetical", "target_book": "kosmos_humboldt_1845", "target_name": "magnetic", "similarity": 0.887}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Magnetical", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic", "similarity": 0.887}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Magnetical", "target_book": "first_principles_spencer_1862", "target_name": "magnetic", "similarity": 0.887}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic", "target_book": "first_principles_spencer_1862", "target_name": "magnetic", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "magnetic", "target_book": "first_principles_spencer_1862", "target_name": "magnetic", "similarity": 1.0}], "id": 595, "stable_key": "clu_6a02f508eda7b925-2", "ground_truth": {"modern_name": "magnetism", "confidence": "high", "type": "concept", "wikidata_id": "Q3294789", "wikidata_description": "class of physical phenomena", "wikipedia_url": "https://en.wikipedia.org/wiki/Magnetism", "wikipedia_extract": "Magnetism is the class of physical attributes that occur through a magnetic field, which allows objects to attract or repel each other. Because both electric currents and magnetic moments of elementary particles give rise to a magnetic field, magnetism is one of two aspects of electromagnetism. The most familiar effects occur in ferromagnetic materials, which are strongly attracted by magnetic fields and can be magnetized to become permanent magnets, producing magnetic fields themselves. Demagnetizing a magnet is also possible. Only a few substances are ferromagnetic; the most common ones are iron, cobalt, nickel, and their alloys. All substances exhibit some type of magnetism."}}, {"canonical_name": "rhinoc\u00e9ros", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 4, "total_mentions": 12, "members": [{"entity_id": "rhinoceros", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Rhinoceros", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Rhinoceros"], "contexts": ["animal with a single sex"]}, {"entity_id": "rhinoc\u00e9ros", "book_id": "epoques_nature_buffon_1778", "name": "rhinoc\u00e9ros", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 5, "variants": ["rhinoc\u00e9ros"], "contexts": ["animal whose skeletons are found in Siberia", "mammals found in northern lands"]}, {"entity_id": "rhinoceros", "book_id": "origin_of_species_darwin_1859", "name": "rhinoceros", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 4, "variants": ["rhinoceros"], "contexts": ["large herbivorous mammal", "large mammal, not destroyed by beasts of prey"]}, {"entity_id": "rhinoceros", "book_id": "kosmos_humboldt_1845", "name": "rhinoceros", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["rhinoceros"], "contexts": ["extant animal found as fossil"]}, {"entity_id": "rhinoceroses", "book_id": "kosmos_humboldt_1845", "name": "rhinoceroses", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["rhinoceroses"], "contexts": ["extant large mammal"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Rhinoceros", "target_book": "epoques_nature_buffon_1778", "target_name": "rhinoc\u00e9ros", "similarity": 0.74}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Rhinoceros", "target_book": "origin_of_species_darwin_1859", "target_name": "rhinoceros", "similarity": 0.736}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Rhinoceros", "target_book": "kosmos_humboldt_1845", "target_name": "rhinoceros", "similarity": 0.736}, {"source_book": "epoques_nature_buffon_1778", "source_name": "rhinoc\u00e9ros", "target_book": "origin_of_species_darwin_1859", "target_name": "rhinoceros", "similarity": 0.954}, {"source_book": "epoques_nature_buffon_1778", "source_name": "rhinoc\u00e9ros", "target_book": "kosmos_humboldt_1845", "target_name": "rhinoceros", "similarity": 0.954}, {"source_book": "epoques_nature_buffon_1778", "source_name": "rhinoc\u00e9ros", "target_book": "kosmos_humboldt_1845", "target_name": "rhinoceroses", "similarity": 0.96}, {"source_book": "origin_of_species_darwin_1859", "source_name": "rhinoceros", "target_book": "kosmos_humboldt_1845", "target_name": "rhinoceros", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "rhinoceros", "target_book": "kosmos_humboldt_1845", "target_name": "rhinoceroses", "similarity": 0.921}], "id": 596, "stable_key": "clu_238711e18f3401cf", "ground_truth": {"modern_name": "Rhinoceros", "confidence": "high", "type": "animal", "wikidata_id": "Q134657", "wikidata_description": "genus of mammals", "wikipedia_url": "https://en.wikipedia.org/wiki/Rhinoceros%20%28genus%29", "wikipedia_extract": "A rhinoceros ( ry-NOSS-\u0259-r\u0259ss; from Ancient Greek  \u1fe5\u03b9\u03bd\u03cc\u03ba\u03b5\u03c1\u03c9\u03c2 (rhin\u00f3ker\u014ds) 'nose-horned'; from  \u1fe5\u03af\u03c2 (rhis) 'nose' and  \u03ba\u03ad\u03c1\u03b1\u03c2 (k\u00e9ras) 'horn'; pl.: rhinoceros or rhinoceroses), commonly abbreviated to rhino, is a member of any of the five extant species (or numerous extinct species) of odd-toed ungulates (perissodactyls) in the family Rhinocerotidae. It is the only living family in the superfamily Rhinocerotoidea (whose members are also sometimes called rhinoceroses). Two of the extant species are native to Africa, and three to South and Southeast Asia. Rhinoceroses are some of the largest remaining megafauna: all weigh over half a tonne in adulthood. They have a herbivorous diet, small brains 400\u2013600 g (14\u201321 oz) for mammals of their size, one or two horns, and a thick 1.5\u20135 cm (0.59\u20131.97 in), protective skin formed from layers of collagen positioned in a lattice structure. They generally eat leafy material, although their ability to ferment food in their hindgut allows them to subsist on more fibrous plant matter when necessary.", "note": "While 'abada' can refer to a rhinoceros in Portuguese, the context of being sent as a gift might also suggest other exotic animals. However, rhinoceros horn was a known medicinal substance."}}, {"canonical_name": "Huxley", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 12, "members": [{"entity_id": "huxley", "book_id": "epoques_nature_buffon_1778", "name": "Huxley", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Huxley"], "contexts": ["summarized organism's role in rock formation"]}, {"entity_id": "huxley", "book_id": "origin_of_species_darwin_1859", "name": "Huxley", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Huxley"], "contexts": ["high authority consulted on hermaphrodites", "Professor who drew insect development"]}, {"entity_id": "huxley", "book_id": "principles_of_psychology_james_1890", "name": "Huxley", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Huxley"], "contexts": ["author of 'Elementary Lessons in Physiology'", "scholar who gave publicity to a doctrine"]}, {"entity_id": "huxley", "book_id": "first_principles_spencer_1862", "name": "Huxley", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Huxley"], "contexts": ["Professor, lectured on persistent types", "Professor who shared a scientific fact"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Huxley", "target_book": "origin_of_species_darwin_1859", "target_name": "Huxley", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Huxley", "target_book": "principles_of_psychology_james_1890", "target_name": "Huxley", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Huxley", "target_book": "first_principles_spencer_1862", "target_name": "Huxley", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Huxley", "target_book": "principles_of_psychology_james_1890", "target_name": "Huxley", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Huxley", "target_book": "first_principles_spencer_1862", "target_name": "Huxley", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Huxley", "target_book": "first_principles_spencer_1862", "target_name": "Huxley", "similarity": 1.0}], "id": 597, "stable_key": "clu_a3aa79a43c86426d", "ground_truth": {"modern_name": "Thomas Henry Huxley", "confidence": "high", "type": "person", "birth_year": 1825, "death_year": 1895, "description": "English biologist, prominent defender of Darwin's theory", "