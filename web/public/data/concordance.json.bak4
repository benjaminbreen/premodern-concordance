te of being engaged or energetic", "action or process"]}, {"entity_id": "activity", "book_id": "first_principles_spencer_1862", "name": "activity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["activity"], "contexts": ["state of being active"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "activity", "target_book": "first_principles_spencer_1862", "target_name": "activity", "similarity": 1.0}], "id": 4123, "stable_key": "clu_dbc5222319095b48", "ground_truth": {"modern_name": "activity", "confidence": "high", "type": "concept"}}, {"canonical_name": "THINGS", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "things", "book_id": "principles_of_psychology_james_1890", "name": "THINGS", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["things", "THINGS"], "contexts": ["perceived entities", "objects of awareness"]}, {"entity_id": "cosas", "book_id": "historia_medicinal_monardes_1574", "name": "cosas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cosas"], "contexts": ["Delascofasquetraen"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "THINGS", "target_book": "historia_medicinal_monardes_1574", "target_name": "cosas", "similarity": 0.919}], "id": 4124, "stable_key": "clu_46f89b2763cfac88", "ground_truth": {"modern_name": "things", "confidence": "high", "type": "concept", "note": "This is a very broad term for perceived entities in early modern philosophy and science, often referring to any object of thought or perception. 'Cosas' is the Spanish equivalent.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "electric currents", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "electric_currents", "book_id": "principles_of_psychology_james_1890", "name": "electric currents", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["electric currents"], "contexts": ["flow of electrical charge"]}, {"entity_id": "electro-currents", "book_id": "connexion_physical_sciences_somerville_1858", "name": "electro-currents", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["electro-currents"], "contexts": ["flow of electric charge"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "electric currents", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electro-currents", "similarity": 0.961}], "id": 4125, "stable_key": "clu_3e29b30f3c29017d", "ground_truth": {"modern_name": "electric current", "confidence": "high", "type": "concept", "note": "While 'electric currents' implies a substance, in the context of 19th-century scientific writing, it refers to the phenomenon or concept of electricity in motion.", "wikidata_id": "Q11651", "wikidata_description": "flow of electric charge"}}, {"canonical_name": "motor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "motor", "book_id": "principles_of_psychology_james_1890", "name": "motor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["motor"], "contexts": ["relating to movement"]}, {"entity_id": "motores", "book_id": "polyanthea_medicinal", "name": "motores", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["motores"], "contexts": ["bodily forces"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "motor", "target_book": "polyanthea_medicinal", "target_name": "motores", "similarity": 0.891}], "id": 4126, "stable_key": "clu_3fb2886edfe93786", "ground_truth": {"modern_name": "motor functions", "confidence": "high", "type": "concept", "note": "In the context of James's 'Principles of Psychology', 'motor' refers to the capacity for movement or action, contrasting with sensory functions.", "wikidata_id": "Q2996165", "wikidata_description": "regulation of movement in organisms that possess a nervous system"}}, {"canonical_name": "left hand", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "left_hand", "book_id": "principles_of_psychology_james_1890", "name": "left hand", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["left hand"], "contexts": ["hand on the left side", "part of the body used for grasping"]}, {"entity_id": "bra\u00e7o_esquerdo", "book_id": "polyanthea_medicinal", "name": "bra\u00e7o esquerdo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bra\u00e7o esquerdo"], "contexts": ["location for bloodletting"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "left hand", "target_book": "polyanthea_medicinal", "target_name": "bra\u00e7o esquerdo", "similarity": 0.937}], "id": 4127, "stable_key": "clu_00b6a7e05dfb8b40", "ground_truth": {"modern_name": "left hand", "confidence": "high", "type": "concept", "note": "Refers to the anatomical left hand, with a specific medical context in early modern texts for procedures like bloodletting."}}, {"canonical_name": "voluntary", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "voluntary", "book_id": "principles_of_psychology_james_1890", "name": "voluntary", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["voluntary"], "contexts": ["actions initiated by conscious will", "course of ideas guided by purpose"]}, {"entity_id": "voluntarias", "book_id": "polyanthea_medicinal", "name": "voluntarias", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["voluntarias"], "contexts": ["voluntary"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "voluntary", "target_book": "polyanthea_medicinal", "target_name": "voluntarias", "similarity": 0.913}], "id": 4128, "stable_key": "clu_8d9d4e0a1351aa68-3", "ground_truth": {"modern_name": "volition", "confidence": "high", "type": "concept", "wikidata_id": "Q1441519", "wikidata_description": "cognitive process by which an individual decides on and commits to a particular course of action", "wikipedia_url": "https://en.wikipedia.org/wiki/Volition%20%28psychology%29", "wikipedia_extract": "Volition, also known as will or conation, is the cognitive process by which an individual decides on and commits to a particular course of action. It is defined as purposive striving and is one of the primary human psychological functions. Others include affect (feeling or emotion), motivation (goals and expectations), and cognition (thinking). Volitional processes can be applied consciously or they can be automatized as habits over time. Most modern conceptions of volition address it as a process of conscious action control which becomes automatized (e.g. see Heckhausen and Kuhl; Gollwitzer; Boekaerts and Corno)."}}, {"canonical_name": "tissue", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "tissue", "book_id": "principles_of_psychology_james_1890", "name": "tissue", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["tissue"], "contexts": ["material structure undergoing change", "basic structural material of the body"]}, {"entity_id": "tissue", "book_id": "first_principles_spencer_1862", "name": "tissue", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["tissue"], "contexts": ["fundamental material of organs"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "tissue", "target_book": "first_principles_spencer_1862", "target_name": "tissue", "similarity": 1.0}], "id": 4129, "stable_key": "clu_8ebf1eb5869506c2", "ground_truth": {"modern_name": "Tissue", "confidence": "high", "type": "concept", "note": "While 'tissue' can refer to various materials, in the context of 19th-century science and psychology, it primarily refers to biological tissue.", "wikidata_id": "Q40397", "wikidata_description": "cellular organizational level intermediate between cells and a complete organism; cells that are grouped together with a common function"}}, {"canonical_name": "alphabet", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "alphabet", "book_id": "principles_of_psychology_james_1890", "name": "alphabet", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["alphabet"], "contexts": ["can be repeated with attention elsewhere", "set of letters in order"]}, {"entity_id": "letters_of_the_alphabet", "book_id": "connexion_physical_sciences_somerville_1858", "name": "letters of the alphabet", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["letters of the alphabet"], "contexts": ["basic units of written language"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "alphabet", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "letters of the alphabet", "similarity": 0.899}], "id": 4130, "stable_key": "clu_067c25faba87a79f", "ground_truth": {"modern_name": "Alphabet", "confidence": "high", "type": "concept"}}, {"canonical_name": "neural action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "neural_action", "book_id": "principles_of_psychology_james_1890", "name": "neural action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["neural action"], "contexts": ["activity of nerves", "laws governing nerve activity"]}, {"entity_id": "cerebral_action", "