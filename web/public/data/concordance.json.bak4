 "medecine_experimentale_bernard_1865", "name": "fer", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["fer"], "contexts": ["metal found in the body"]}, {"entity_id": "ferrum", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "ferrum", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["ferrum"], "contexts": ["Latin for iron"]}, {"entity_id": "fer", "book_id": "epoques_nature_buffon_1778", "name": "fer", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["fer"], "contexts": ["mati\u00e8re solide qui serait lumineuse si p\u00e9n\u00e9tr\u00e9e par le feu", "common metal"]}, {"entity_id": "fer", "book_id": "relation_historique_humboldt_vol3_1825", "name": "fer", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["fer"], "contexts": ["metal found in chain", "metal found in mounds"]}, {"entity_id": "ferri", "book_id": "kosmos_humboldt_1845", "name": "ferri", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["ferri"], "contexts": ["Latin for iron"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "fer", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "ferrum", "similarity": 0.953}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "fer", "target_book": "epoques_nature_buffon_1778", "target_name": "fer", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "fer", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "fer", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "fer", "target_book": "kosmos_humboldt_1845", "target_name": "ferri", "similarity": 0.945}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "ferrum", "target_book": "epoques_nature_buffon_1778", "target_name": "fer", "similarity": 0.953}, {"source_book": "pseudodoxia_epidemica_browne_16