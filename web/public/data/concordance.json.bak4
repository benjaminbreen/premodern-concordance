n\u00e0", "Mann\u00e1", "mann\u00e1"], "contexts": ["substance used in preparation", "purgative substance"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "manna", "target_book": "coloquios_da_orta_1563", "target_name": "mann\u00e1", "similarity": 0.743}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "manna", "target_book": "coloquios_da_orta_1563", "target_name": "manna", "similarity": 0.8}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "manna", "target_book": "ricettario_fiorentino_1597", "target_name": "manna", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "manna", "target_book": "polyanthea_medicinal", "target_name": "mann\u00e0", "similarity": 0.61}, {"source_book": "coloquios_da_orta_1563", "source_name": "mann\u00e1", "target_book": "ricettario_fiorentino_1597", "target_name": "manna", "similarity": 0.743}, {"source_book": "coloquios_da_orta_1563", "source_name": "mann\u00e1", "target_book": "polyanthea_medicinal", "target_name": "mann\u00e0", "similarity": 0.684}, {"source_book": "coloquios_da_orta_1563", "source_name": "manna", "target_book": "ricettario_fiorentino_1597", "target_name": "manna", "similarity": 0.8}, {"source_book": "coloquios_da_orta_1563", "source_name": "manna", "target_book": "polyanthea_medicinal", "target_name": "mann\u00e0", "similarity": 0.808}, {"source_book": "ricettario_fiorentino_1597", "source_name": "manna", "target_book": "polyanthea_medicinal", "target_name": "mann\u00e0", "similarity": 0.61}], "id": 420, "stable_key": "clu_b78d468d22e6058f", "ground_truth": {"modern_name": "manna", "confidence": "high", "type": "substance", "description": "A sweet, exudate substance from certain trees or plants.", "wikipedia_extract": "Manna (Hebrew: \u05de\u05b8\u05df, romanized: m\u0101n, Greek: \u03bc\u03ac\u03bd\u03bd\u03b1; Arabic: \u0627\u064e\u0644\u0652\u0645\u064e\u0646\u064f\u0651), sometimes or archaically spelled mana, is described in the Bible and the Quran as an edible substance that God bestowed upon the Israelites while they were wandering the desert during the 40-year period that followed the Exodus and preceded the conquest of Canaan. In the Hebrew Bible, manna is described twice: once in Exodus 16:1\u201336 with the full narrative surrounding it, and once again in Numbers 11:1\u20139 as a part of a separate narrative. In the description in the Book of Exodus, manna is described as being \"a fine, flake-like thing\" like the frost on the ground. It is described in the Book of Numbers as arriving with the dew during the night. Exodus adds that it had to be collected before it was melted by the heat of the Sun, and that it was like a coriander seed in size, but white in colour. Numbers describes it as having the appearance of bdellium, adding that the Israelites ground it and pounded it into cakes, which were then baked, resulting in something that tasted like cakes baked with oil."}}, {"canonical_name": "garganta", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 34, "members": [{"entity_id": "garganta", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "garganta", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["garganta"], "contexts": ["burns the throat", "part of the throat affected by tobacco"]}, {"entity_id": "garganta", "book_id": "historia_medicinal_monardes_1574", "name": "garganta", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["garganta"], "contexts": ["throat part"]}, {"entity_id": "garganta", "book_id": "coloquios_da_orta_1563", "name": "garganta", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["garganta"], "contexts": ["body part"]}, {"entity_id": "garganta", "book_id": "polyanthea_medicinal", "name": "garganta", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 28, "variants": ["garganta", "Garganta"], "contexts": ["body part", "part of the throat"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "garganta", "target_book": "historia_medicinal_monardes_1574", "target_name": "garganta", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "garganta", "target_book": "coloquios_da_orta_1563", "target_name": "garganta", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "garganta", "target_book": "polyanthea_medicinal", "target_name": "garganta", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "garganta", "target_book": "coloquios_da_orta_1563", "target_name": "garganta", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "garganta", "target_book": "polyanthea_medicinal", "target_name": "garganta", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "garganta", "target_book": "polyanthea_medicinal", "target_name": "garganta", "similarity": 1.0}], "id": 421, "stable_key": "clu_52b61830d202061f", "ground_truth": {"modern_name": "Throat", "confidence": "high", "type": "concept", "note": "'Garganta' is the direct translation of 'throat' in Portuguese and Spanish, referring to the anatomical region.", "wikidata_id": "Q1783924", "wikidata_description": "organ system cancer in the head or neck region", "wikipedia_url": "https://en.wikipedia.org/wiki/Head%20and%20neck%20cancer", "wikipedia_extract": "Head and neck cancer is a general term encompassing multiple cancers that can develop in the head and neck region. These include cancers of the mouth, tongue, gums and lips (oral cancer), voice box (laryngeal), throat (nasopharyngeal, oropharyngeal, hypopharyngeal), salivary glands, nose and sinuses. Head and neck cancer can present a wide range of symptoms depending on where the cancer developed. These can include an ulcer in the mouth that does not heal, changes in the voice, difficulty swallowing, red or white patches in the mouth, and a neck lump. The majority of head and neck cancer is caused by the use of alcohol or tobacco (including smokeless tobacco). An increasing number of cases are caused by the human papillomavirus (HPV).", "description": "The anatomical part of the neck including the gullet."}}, {"canonical_name": "astronomy", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 4, "total_mentions": 33, "members": [{"entity_id": "astronomy", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Astronomy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Astronomy"], "contexts": ["study of celestial bodies", "study of celestial objects and space"]}, {"entity_id": "astronomy", "book_id": "kosmos_humboldt_1845", "name": "Astronomy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["Astronomy", "astronomy"], "contexts": ["science of stars and space", "study of celestial bodies and space"]}, {"entity_id": "astronomy", "book_id": "connexion_physical_sciences_somerville_1858", "name": "astronomy", "category": "CONCEPT", "subcategory": "THEORY", "count": 14, "variants": ["astronomy", "Astronomy"], "contexts": ["science of celestial objects and space", "study of celestial objects and phenomena"]}, {"entity_id": "astronomy", "book_id": "first_principles_spencer_1862", "name": "Astronomy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["Astronomy", "astronomy"], "contexts": ["organized body of observations about heavens", "science of celestial objects and phenomena"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Astronomy", "target_book": "kosmos_humboldt_1845", "target_name": "Astronomy", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Astronomy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "astronomy", "similarity": 0.941}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Astronomy", "target_book": "first_principles_spencer_1862", "target_name": "Astronomy", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Astronomy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "astronomy", "similarity": 0.941}, {"source_book": "kosmos_humboldt_1845", "source_name": "Astronomy", "target_book": "first_principles_spencer_1862", "target_name": "Astronomy", "similarity": 1.0}], "id": 422, "stable_key": "clu_fd60ba24ea5dfe10", "ground_truth": {"modern_name": "Astronomy", "confidence": "high", "type": "concept", "wikidata_id": "Q333", "wikidata_description": "natural science studying celestial objects and phenomena in the cosmos", "wikipedia_url": "https://en.wikipedia.org/wiki/Astronomy", "note": "While 'astronomical' can refer to the study of celestial bodies, in the context of surveying and mapping, it more broadly implies methods or operations related to celestial observation for measurement.", "wikipedia_extract": "Astronomy is a natural science that studies celestial objects and the phenomena that occur in the cosmos. It uses mathematics, physics, and chemistry to explain their origin and their overall evolution. Objects of interest include planets, moons, stars, nebulae, galaxies, meteoroids, asteroids, and comets. Relevant phenomena include supernova explosions, gamma ray bursts, quasars, blazars, pulsars, and cosmic microwave background radiation. More generally, astronomy studies everything that originates beyond Earth's atmosphere. Cosmology is the branch of astronomy that studies the universe as a whole."}}, {"canonical_name": "Ruptures", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 4, "total_mentions": 33, "members": [{"entity_id": "ruptures", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ruptures", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Ruptures"], "contexts": ["a medical condition"]}, {"entity_id": "ruptures", "book_id": "english_physician_1652", "name": "Ruptures", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 30, "variants": ["Ruptures", "Fractures", "Rupture"], "contexts": ["condition consolidated by Bifoyl", "condition helped by Bistort"]}, {"entity_id": "rupturas", "book_id": "historia_medicinal_monardes_1574", "name": "rupturas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["rupturas"], "contexts": ["ruptures"]}, {"entity_id": "fracturas", "book_id": "polyanthea_medicinal", "name": "fracturas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["fracturas"], "contexts": ["fractures"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ruptures", "target_book": "english_physician_1652", "target_name": "Ruptures", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ruptures", "target_book": "historia_medicinal_monardes_1574", "target_name": "rupturas", "similarity": 0.95}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ruptures", "target_book": "polyanthea_medicinal", "target_name": "fracturas", "similarity": 0.956}, {"source_book": "english_physician_1652", "source_name": "Ruptures", "target_book": "historia_medicinal_monardes_1574", "target_name": "rupturas", "similarity": 0.95}, {"source_book": "english_physician_1652", "source_name": "Ruptures", "target_book": "polyanthea_medicinal", "target_name": "fracturas", "similarity": 0.956}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "rupturas", "target_book": "polyanthea_medicinal", "target_name": "fracturas", "similarity": 0.91}], "id": 423, "stable_key": "clu_e2a4d2df90bb4a77", "ground_truth": {"modern_name": "Hernia", "confidence": "high", "type": "disease", "modern_term": "Hernia", "note": "While 'ruptures' can refer to other breakages, in a medical context during this period, it strongly points to hernia. 'Fracturas' is a separate term for bone breaks.", "wikidata_id": "Q2163245", "wikidata_description": "diaphragm disease characterized by the lack of development of all or part of the diaphragm, which results in an abnormal opening that allows the stomach and intestines to move into the chest cavity and crowd the heart and lungs", "wikipedia_url": "", "wikipedia_extract": ""}}, {"canonical_name": "goma", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 33, "members": [{"entity_id": "goma", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "goma", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 9, "variants": ["goma"], "contexts": ["gum", "yellow and golden resin collected"]}, {"entity_id": "goma_arabiga", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "goma arabiga", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["goma arabiga"], "contexts": ["gum produced by acassia", "gum from acacia"]}, {"entity_id": "goma", "book_id": "historia_medicinal_monardes_1574", "name": "goma", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["goma", "Goma", "gomas"], "contexts": ["gum or resin", "gum from a certain herb"]}, {"entity_id": "goma", "book_id": "coloquios_da_orta_1563", "name": "goma", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 14, "variants": ["goma", "gomma"], "contexts": ["resin from a plant", "substance extracted from tree"]}, {"entity_id": "goma_arabia", "book_id": "polyanthea_medicinal", "name": "goma arabia", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["goma arabia"], "contexts": ["ingredient in a remedy for diabetes", "used in trociscos"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "goma", "target_book": "historia_medicinal_monardes_1574", "target_name": "goma", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "goma", "target_book": "coloquios_da_orta_1563", "target_name": "goma", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "goma arabiga", "target_book": "historia_medicinal_monardes_1574", "target_name": "goma", "similarity": 0.91}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "goma arabiga", "target_book": "coloquios_da_orta_1563", "target_name": "goma", "similarity": 0.91}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "goma arabiga", "target_book": "polyanthea_medicinal", "target_name": "goma arabia", "similarity": 0.921}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "goma", "target_book": "coloquios_da_orta_1563", "target_name": "goma", "similarity": 1.0}], "id": 424, "stable_key": "clu_5dd57783707efc5f", "ground_truth": {"modern_name": "goma", "confidence": "medium", "type": "plant", "note": "The term 'goma' (gum/resin) in early modern texts often refers to a class of substances from various plants rather than a single specific species. Further context from the source texts would be needed for a more precise identification."}}, {"canonical_name": "hydrog\u00e8ne sulfur\u00e9", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 33, "members": [{"entity_id": "hydrog\u00e8ne_sulfur\u00e9", "book_id": "relation_historique_humboldt_vol3_1825", "name": "hydrog\u00e8ne sulfur\u00e9", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 20, "variants": ["hydrog\u00e8ne sulfur\u00e9", "hydrog\u00e8ne", "hydrog\u00e8ne condens\u00e9"], "contexts": ["substance in the hot springs water", "decomposes oxygen and nitrogen mixture"]}, {"entity_id": "sulphureted_hydrogen_gas", "book_id": "kosmos_humboldt_1845", "name": "sulphureted hydrogen gas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["sulphureted hydrogen gas"], "contexts": ["gas ejected from subterranean forces", "gas ejected from volcanoes"]}, {"entity_id": "sulphureted_hydrogen", "book_id": "kosmos_humboldt_1845", "name": "sulphureted hydrogen", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["sulphureted hydrogen"], "contexts": ["gaseous compound of sulphur", "gas generated by volcanoes"]}, {"entity_id": "sulphuretted_hydrogen_gas", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Sulphuretted hydrogen gas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["sulphuretted hydrogen gas", "Sulphuretted hydrogen gas"], "contexts": ["compound of sulphur and hydrogen", "gas with known constituent parts"]}, {"entity_id": "phosphuretted_hydrogen", "book_id": "first_principles_spencer_1862", "name": "phosphuretted hydrogen", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["phosphuretted hydrogen"], "contexts": ["inorganic compound more decomposable than some organic"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "hydrog\u00e8ne sulfur\u00e9", "target_book": "kosmos_humboldt_1845", "target_name": "sulphureted hydrogen gas", "similarity": 0.917}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "hydrog\u00e8ne sulfur\u00e9", "target_book": "kosmos_humboldt_1845", "target_name": "sulphureted hydrogen", "similarity": 0.94}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "hydrog\u00e8ne sulfur\u00e9", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Sulphuretted hydrogen gas", "similarity": 0.915}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "hydrog\u00e8ne sulfur\u00e9", "target_book": "first_principles_spencer_1862", "target_name": "phosphuretted hydrogen", "similarity": 0.885}, {"source_book": "kosmos_humboldt_1845", "source_name": "sulphureted hydrogen gas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Sulphuretted hydrogen gas", "similarity": 0.991}, {"source_book": "kosmos_humboldt_1845", "source_name": "sulphureted hydrogen gas", "target_book": "first_principles_spencer_1862", "target_name": "phosphuretted hydrogen", "similarity": 0.901}, {"source_book": "kosmos_humboldt_1845", "source_name": "sulphureted hydrogen", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Sulphuretted hydrogen gas", "similarity": 0.957}, {"source_book": "kosmos_humboldt_1845", "source_name": "sulphureted hydrogen", "target_book": "first_principles_spencer_1862", "target_name": "phosphuretted hydrogen", "similarity": 0.941}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Sulphuretted hydrogen gas", "target_book": "first_principles_spencer_1862", "target_name": "phosphuretted hydrogen", "similarity": 0.906}], "id": 425, "stable_key": "clu_7b2b155006aa7590", "ground_truth": {"modern_name": "Hydrogen sulfide", "confidence": "high", "type": "chemical", "note": "The French term 'hydrog\u00e8ne sulfur\u00e9' directly translates to 'sulfurated hydrogen,' which is hydrogen sulfide. 'Phosphuretted hydrogen' is a different compound but appears in close proximity.", "wikidata_id": "Q170591", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Hydrogen%20sulfide", "wikipedia_extract": "Hydrogen sulfide (preferred IUPAC name and American English) or hydrogen sulphide (Commonwealth English) is a chemical compound with the formula H2S. It is a colorless hydrogen chalcogenide gas, and is toxic, corrosive, and flammable. Trace amounts in ambient atmosphere have a characteristic foul odor of rotten eggs. Swedish chemist Carl Wilhelm Scheele is credited with having discovered the chemical composition of purified hydrogen sulfide in 1777. Hydrogen sulfide is toxic to humans and most other animals by inhibiting cellular respiration in a manner similar to hydrogen cyanide. When it is inhaled or its salts are ingested in high amounts, damage to organs occurs rapidly with symptoms ranging from breathing difficulties to convulsions and death."}}, {"canonical_name": "Canada", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 4, "total_mentions": 32, "members": [{"entity_id": "canada", "book_id": "epoques_nature_buffon_1778", "name": "Canada", "category": "PLACE", "subcategory": "COUNTRY", "count": 13, "variants": ["Canada"], "contexts": ["North American region with elephant remains", "North American country"]}, {"entity_id": "canada", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Canada", "category": "PLACE", "subcategory": "COUNTRY", "count": 13, "variants": ["Canada"], "contexts": ["place where quippos are found", "country with English population"]}, {"entity_id": "canada", "book_id": "kosmos_humboldt_1845", "name": "Canada", "category": "PLACE", "subcategory": "COUNTRY", "count": 5, "variants": ["Canada"], "contexts": ["country where Toronto is located", "proposed location for magnetic stations"]}, {"entity_id": "canada", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Canada", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Canada"], "contexts": ["country with chilly winds affecting Asia and America"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Canada", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Canada", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Canada", "target_book": "kosmos_humboldt_1845", "target_name": "Canada", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Canada", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Canada", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Canada", "target_book": "kosmos_humboldt_1845", "target_name": "Canada", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Canada", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Canada", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Canada", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Canada", "similarity": 1.0}], "id": 426, "stable_key": "clu_bac6e0af3b782c07", "ground_truth": {"modern_name": "Canada", "confidence": "high", "type": "place", "country": "Canada", "wikidata_id": "Q16", "wikidata_description": "country in North America", "wikipedia_url": "https://en.wikipedia.org/wiki/Canada", "wikipedia_extract": "Canada is a country in North America. Its ten provinces and three territories extend from the Atlantic Ocean to the Pacific Ocean and northward into the Arctic Ocean, making it the second-largest country by total area, with the longest coastline of any country. Its border with the United States is the longest international land border. The country is characterized by a wide range of both meteorologic and geological regions. With a population of over 41 million, it has widely varying population densities, with the majority residing in its urban areas and large areas being sparsely populated. Canada's capital is Ottawa and its three largest metropolitan areas are Toronto, Montreal, and Vancouver."}}, {"canonical_name": "Aetna", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 32, "members": [{"entity_id": "etna", "book_id": "epoques_nature_buffon_1778", "name": "Etna", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Etna"], "contexts": ["volcano with specific vapor composition"]}, {"entity_id": "etna", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Etna", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Etna"], "contexts": ["volcanic mountain", "volcano in Sicily"]}, {"entity_id": "aetna", "book_id": "kosmos_humboldt_1845", "name": "Aetna", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 23, "variants": ["AEtna", "Aetna"], "contexts": ["mountain elevation data", "volcano in Sicily"]}, {"entity_id": "etna", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Etna", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Etna"], "contexts": ["mountain measured for height", "volcano with measurements"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Etna", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Etna", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Etna", "target_book": "kosmos_humboldt_1845", "target_name": "Aetna", "similarity": 0.898}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Etna", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Etna", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Etna", "target_book": "kosmos_humboldt_1845", "target_name": "Aetna", "similarity": 0.898}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Etna", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Etna", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Aetna", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Etna", "similarity": 0.898}], "id": 427, "stable_key": "clu_e2dffcf2b8f9f9e7", "ground_truth": {"modern_name": "Mount Etna", "confidence": "high", "type": "place", "country": "Italy", "note": "The spellings 'Etna' and 'Aetna' consistently refer to the prominent volcanic mountain in Sicily."}}, {"canonical_name": "cacao", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 32, "members": [{"entity_id": "cacao", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "cacao", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 18, "variants": ["cacao"], "contexts": ["plant used for chocolate", "seed used for beverage"]}, {"entity_id": "cacao", "book_id": "relation_historique_humboldt_vol3_1825", "name": "cacao", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 12, "variants": ["CACAO", "Cacao", "cacao"], "contexts": ["product traded on the boat", "product for European trade"]}, {"entity_id": "cacao", "book_id": "kosmos_humboldt_1845", "name": "cacao", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cacao"], "contexts": ["plant requiring hot climate"]}, {"entity_id": "cacao", "book_id": "historia_medicinal_monardes_1574", "name": "Cacao", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Cacao"], "contexts": ["fruit used as currency by Indians"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cacao", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "cacao", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cacao", "target_book": "kosmos_humboldt_1845", "target_name": "cacao", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cacao", "target_book": "historia_medicinal_monardes_1574", "target_name": "Cacao", "similarity": 0.901}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "cacao", "target_book": "kosmos_humboldt_1845", "target_name": "cacao", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "cacao", "target_book": "historia_medicinal_monardes_1574", "target_name": "Cacao", "similarity": 0.901}, {"source_book": "kosmos_humboldt_1845", "source_name": "cacao", "target_book": "historia_medicinal_monardes_1574", "target_name": "Cacao", "similarity": 0.901}], "id": 428, "stable_key": "clu_7234c73e9a71e513", "ground_truth": {"modern_name": "Cacao", "confidence": "high", "type": "plant", "linnaean": "Theobroma cacao Linnaeus", "family": "Malvaceae", "wikidata_id": "Q42385", "wikidata_description": "tree native to tropical South America producing cocoa beans - the source plant of cacao and chocolate", "wikipedia_url": "https://en.wikipedia.org/wiki/Theobroma%20cacao", "wikipedia_extract": "Theobroma cacao (cacao tree or cocoa tree) is a small (6\u201312 m (20\u201339 ft) tall) evergreen tree in the Malvaceae family. Its seeds\u2014cocoa beans\u2014are used to make chocolate liquor, cocoa solids, cocoa butter and chocolate. Although the tree is native to the tropics of the Americas, the largest producer of cocoa beans in 2022 was Ivory Coast. The plants leaves are alternate, entire, unlobed, 10\u201350 cm (4\u201320 in) long and 5\u201310 cm (2\u20134 in) broad. The flowers are produced in clusters directly on the trunk and older branches; this is known as cauliflory. The flowers are small, 1\u20132 cm (3\u20448\u201313\u204416 in) diameter, with pink calyx."}}, {"canonical_name": "plan\u00e8tes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 4, "total_mentions": 32, "members": [{"entity_id": "plan\u00e8te", "book_id": "medecine_experimentale_bernard_1865", "name": "plan\u00e8te", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["plan\u00e8te"], "contexts": ["celestial body"]}, {"entity_id": "plan\u00e8tes", "book_id": "epoques_nature_buffon_1778", "name": "plan\u00e8tes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 16, "variants": ["plan\u00e8tes", "PLAN\u00c8TES"], "contexts": ["celestial bodies, distinguished from stars", "planets in the solar system"]}, {"entity_id": "planets", "book_id": "kosmos_humboldt_1845", "name": "planets", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 10, "variants": ["planets", "Planets"], "contexts": ["celestial bodies agglomerated into rings of vapor", "celestial bodies orbiting stars"]}, {"entity_id": "plan\u00e8tes", "book_id": "medecine_experimentale_bernard_1865", "name": "plan\u00e8tes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["plan\u00e8tes"], "contexts": ["celestial bodies observed in astronomy", "celestial bodies orbiting a star"]}, {"entity_id": "planetary_bodies", "book_id": "kosmos_humboldt_1845", "name": "planetary bodies", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["planetary bodies"], "contexts": ["celestial objects orbiting a star", "celestial bodies orbiting a star"]}, {"entity_id": "planetas", "book_id": "historia_medicinal_monardes_1574", "name": "planetas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["planetas"], "contexts": ["celestial bodies, the planets"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "plan\u00e8te", "target_book": "epoques_nature_buffon_1778", "target_name": "plan\u00e8tes", "similarity": 0.926}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "plan\u00e8te", "target_book": "kosmos_humboldt_1845", "target_name": "planets", "similarity": 0.912}, {"source_book": "epoques_nature_buffon_1778", "source_name": "plan\u00e8tes", "target_book": "kosmos_humboldt_1845", "target_name": "planets", "similarity": 0.974}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "plan\u00e8tes", "target_book": "kosmos_humboldt_1845", "target_name": "planetary bodies", "similarity": 0.897}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "plan\u00e8tes", "target_book": "historia_medicinal_monardes_1574", "target_name": "planetas", "similarity": 0.973}, {"source_book": "kosmos_humboldt_1845", "source_name": "planetary bodies", "target_book": "historia_medicinal_monardes_1574", "target_name": "planetas", "similarity": 0.925}], "id": 429, "stable_key": "clu_1a0846727fc3ef3f", "ground_truth": {"modern_name": "planet", "confidence": "high", "type": "concept", "wikidata_id": "Q634", "wikidata_description": "celestial body directly orbiting a star or stellar remnant"}}, {"canonical_name": "Convulsions", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 4, "total_mentions": 31, "members": [{"entity_id": "ph\u00e9nom\u00e8nes_convulsifs", "book_id": "medecine_experimentale_bernard_1865", "name": "ph\u00e9nom\u00e8nes convulsifs", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["ph\u00e9nom\u00e8nes convulsifs"], "contexts": ["sudden, involuntary muscle contractions", "convulsive symptoms due to water imbalance"]}, {"entity_id": "convulsions", "book_id": "english_physician_1652", "name": "Convulsions", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 23, "variants": ["Convulsions", "Convulsion", "convulsions"], "contexts": ["affect sinews", "condition helped by oil"]}, {"entity_id": "movimentos_convulfivos", "book_id": "polyanthea_medicinal", "name": "movimentos convulfivos", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 5, "variants": ["movimentos convulfivos", "movimentos convulsivos"], "contexts": ["convulsive movements", "symptom of spasms"]}, {"entity_id": "convulsions", "book_id": "first_principles_spencer_1862", "name": "convulsions", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["convulsions"], "contexts": ["involuntary muscle contractions"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "ph\u00e9nom\u00e8nes convulsifs", "target_book": "english_physician_1652", "target_name": "Convulsions", "similarity": 0.915}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "ph\u00e9nom\u00e8nes convulsifs", "target_book": "polyanthea_medicinal", "target_name": "movimentos convulfivos", "similarity": 0.891}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "ph\u00e9nom\u00e8nes convulsifs", "target_book": "first_principles_spencer_1862", "target_name": "convulsions", "similarity": 0.953}, {"source_book": "english_physician_1652", "source_name": "Convulsions", "target_book": "polyanthea_medicinal", "target_name": "movimentos convulfivos", "similarity": 0.904}, {"source_book": "english_physician_1652", "source_name": "Convulsions", "target_book": "first_principles_spencer_1862", "target_name": "convulsions", "similarity": 0.935}], "id": 430, "stable_key": "clu_b0675fac2a12f7b8", "ground_truth": {"modern_name": "Convulsions", "confidence": "high", "type": "disease", "modern_term": "Convulsions", "wikidata_id": "Q6279182", "wikidata_description": "disease, disturbance of cortical function due to a sudden, abnormal, exin cells.", "wikipedia_url": "https://en.wikipedia.org/wiki/Seizure", "note": "In early modern medical texts, 'fits' was a common term for sudden episodes of illness, often referring to seizures.", "wikipedia_extract": "A seizure is a sudden disruption of brain activity caused by excessive, synchronized neuronal firing that results in changes in behavior. This neurological condition is common, affecting approximately 50 million individuals around the world. Depending on the regions of the brain involved, seizures can lead to changes in movement, sensation, behavior, awareness, or consciousness. Symptoms vary widely. Some seizures involve subtle changes, such as brief lapses in attention or awareness (as seen in absence seizures), while others cause generalized convulsions with loss of consciousness (tonic\u2013clonic seizures). Most seizures last less than two minutes and are followed by a postictal period of confusion, fatigue, or other symptoms.", "description": "A medical condition characterized by sudden, involuntary muscle contractions."}}, {"canonical_name": "conception", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 31, "members": [{"entity_id": "conception", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "conception", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["conception"], "contexts": ["process of becoming pregnant"]}, {"entity_id": "conception", "book_id": "origin_of_species_darwin_1859", "name": "conception", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["conception"], "contexts": ["process of becoming pregnant"]}, {"entity_id": "conception", "book_id": "principles_of_psychology_james_1890", "name": "conception", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 25, "variants": ["conception", "CONCEPTION", "Conception"], "contexts": ["sense of sameness, abstract ideas", "mental grasp of an idea"]}, {"entity_id": "conception", "book_id": "first_principles_spencer_1862", "name": "conception", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["conception"], "contexts": ["mental representation or understanding of an object", "mental representation of an idea"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "conception", "target_book": "origin_of_species_darwin_1859", "target_name": "conception", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "conception", "target_book": "principles_of_psychology_james_1890", "target_name": "conception", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "conception", "target_book": "first_principles_spencer_1862", "target_name": "conception", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "conception", "target_book": "principles_of_psychology_james_1890", "target_name": "conception", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "conception", "target_book": "first_principles_spencer_1862", "target_name": "conception", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "conception", "target_book": "first_principles_spencer_1862", "target_name": "conception", "similarity": 1.0}], "id": 431, "stable_key": "clu_816af673477a2afe", "ground_truth": {"modern_name": "Conception", "confidence": "high", "type": "concept", "note": "This cluster refers to both the biological process of pregnancy and the philosophical/psychological process of forming an idea or understanding.", "wikidata_id": "Q1880", "wikidata_description": "city in Chile", "wikipedia_url": "https://en.wikipedia.org/wiki/Concepci%C3%B3n%2C%20Chile", "wikipedia_extract": "Concepci\u00f3n (Spanish pronunciation: [konse\u03b2\u02c8sjon] ; originally: Concepci\u00f3n de la Madre Sant\u00edsima de la Luz, \"Conception of the Blessed Mother of Light\") is a city and commune in south-central Chile, and the geographical and demographic core of the Greater Concepci\u00f3n metropolitan area, it is the second largest city in Chile by urban area and one of the three major conurbations in the country. It has a significant impact on domestic trade being part of the most heavily industrialized region in the country. It is the seat of the Concepci\u00f3n Province and the capital of the Biob\u00edo Region. It sits about 500 km south of the nation's capital, Santiago. The city was first settled in the Bay of Concepci\u00f3n, in the zone that would later become the commune of Penco, now part of the Concepci\u00f3n conurbation. The city's demonym, penquista, comes from the place of its original foundation."}}, {"canonical_name": "Livro", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 4, "total_mentions": 31, "members": [{"entity_id": "book", "book_id": "english_physician_1652", "name": "Book", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["Book", "Books"], "contexts": ["referred to for further information", "source of information"]}, {"entity_id": "book", "book_id": "principles_of_psychology_james_1890", "name": "book", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 5, "variants": ["book"], "contexts": ["bound collection of pages", "object placed under the armpit"]}, {"entity_id": "books", "book_id": "principles_of_psychology_james_1890", "name": "books", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["books"], "contexts": ["written works for reading"]}, {"entity_id": "livro", "book_id": "coloquios_da_orta_1563", "name": "Livro", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 17, "variants": ["Livro", "livras", "livro", "livros", "livros antigos", "livros impressos", "livros impressos xylographicas", "livros modernos"], "contexts": ["reference to a book", "cited work by Duarte Barbosa"]}, {"entity_id": "livro", "book_id": "polyanthea_medicinal", "name": "Livro", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 5, "variants": ["Livro", "livro", "livros"], "contexts": ["A book, referring to Polyanthea", "written work"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Book", "target_book": "principles_of_psychology_james_1890", "target_name": "book", "similarity": 0.997}, {"source_book": "english_physician_1652", "source_name": "Book", "target_book": "principles_of_psychology_james_1890", "target_name": "books", "similarity": 0.918}, {"source_book": "english_physician_1652", "source_name": "Book", "target_book": "coloquios_da_orta_1563", "target_name": "Livro", "similarity": 0.99}, {"source_book": "english_physician_1652", "source_name": "Book", "target_book": "polyanthea_medicinal", "target_name": "Livro", "similarity": 0.99}, {"source_book": "principles_of_psychology_james_1890", "source_name": "book", "target_book": "coloquios_da_orta_1563", "target_name": "Livro", "similarity": 0.99}, {"source_book": "principles_of_psychology_james_1890", "source_name": "book", "target_book": "polyanthea_medicinal", "target_name": "Livro", "similarity": 0.99}, {"source_book": "principles_of_psychology_james_1890", "source_name": "books", "target_book": "coloquios_da_orta_1563", "target_name": "Livro", "similarity": 0.92}, {"source_book": "principles_of_psychology_james_1890", "source_name": "books", "target_book": "polyanthea_medicinal", "target_name": "Livro", "similarity": 0.92}, {"source_book": "coloquios_da_orta_1563", "source_name": "Livro", "target_book": "polyanthea_medicinal", "target_name": "Livro", "similarity": 1.0}], "id": 432, "stable_key": "clu_54b9d61bd9f0fd5b", "ground_truth": {"modern_name": "Book", "confidence": "high", "type": "object", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Book", "note": "'lib.' is a common abbreviation for 'liber', the Latin word for book. 'lib. lo' likely refers to a specific book or section.", "wikipedia_extract": "A book is a written work of substantial length created by one or more authors. They can be distributed in various forms such as printed books, audiobooks, and electronic books (ebooks). Books are broadly classified into fiction, containing invented narrative or other imaginary content; and non-fiction, containing content intended as factual truth. The term may also refer to the physical or electronic object containing such a work. Modern books are typically printed in a codex format, composed of many pages bound together and protected by a cover. Before the wide adoption of the modern printing press, codices were used to create handwritten manuscripts."}}, {"canonical_name": "entranhas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 31, "members": [{"entity_id": "entrails", "book_id": "english_physician_1652", "name": "Entrails", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Entrails", "Intrails"], "contexts": ["internal organs of digestion"]}, {"entity_id": "entrails", "book_id": "principles_of_psychology_james_1890", "name": "entrails", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["entrails"], "contexts": ["internal organs providing sensation"]}, {"entity_id": "entr\u00edas", "book_id": "historia_medicinal_monardes_1574", "name": "entr\u00edas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["entr\u00edas", "entra\u00f1as"], "contexts": ["misspelling of entrails", "body part, intestines"]}, {"entity_id": "entranhas", "book_id": "polyanthea_medicinal", "name": "entranhas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 26, "variants": ["entranhas", "entrails", "entranhas dam\u00e1y", "entranhas naturaes"], "contexts": ["entrails", "internal organs"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Entrails", "target_book": "principles_of_psychology_james_1890", "target_name": "entrails", "similarity": 0.981}, {"source_book": "english_physician_1652", "source_name": "Entrails", "target_book": "polyanthea_medicinal", "target_name": "entranhas", "similarity": 0.919}, {"source_book": "principles_of_psychology_james_1890", "source_name": "entrails", "target_book": "polyanthea_medicinal", "target_name": "entranhas", "similarity": 0.936}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "entr\u00edas", "target_book": "polyanthea_medicinal", "target_name": "entranhas", "similarity": 0.901}], "id": 433, "stable_key": "clu_87dbf005603f2b82", "ground_truth": {"modern_name": "entrails", "confidence": "high", "type": "substance", "description": "The internal organs, especially of digestion.", "wikipedia_extract": "The gastrointestinal tract (also called the GI tract, digestive tract, and the alimentary canal) is the tract or passageway of the digestive system that leads from the mouth to the anus. The tract is one of the largest of the body's systems. The GI tract contains all the major organs of the digestive system, in humans and other animals, including the esophagus, stomach, and intestines. Food taken in through the mouth is digested to extract nutrients and absorb energy, and the waste expelled at the anus as feces. Gastrointestinal is an adjective meaning of or pertaining to the stomach and intestines. Most animals have a \"through-gut\" or complete digestive tract."}}, {"canonical_name": "sarna", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 4, "total_mentions": 31, "members": [{"entity_id": "sarna", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "sarna", "category": "DISEASE", "subcategory": "CHRONIC", "count": 21, "variants": ["sarna"], "contexts": ["scabies", "skin condition treated with coraron"]}, {"entity_id": "sarna", "book_id": "historia_medicinal_monardes_1574", "name": "sarna", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["sarna"], "contexts": ["skin disease"]}, {"entity_id": "sarna", "book_id": "coloquios_da_orta_1563", "name": "sarna", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["sarna", "sarna de Castella"], "contexts": ["skin condition", "skin condition mentioned by Ainslie"]}, {"entity_id": "sarna", "book_id": "polyanthea_medicinal", "name": "Sarna", "category": "DISEASE", "subcategory": "CHRONIC", "count": 5, "variants": ["Sarna", "Sarna antiga", "sarna"], "contexts": ["severe skin condition", "skin disease, scabies"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "sarna", "target_book": "historia_medicinal_monardes_1574", "target_name": "sarna", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "sarna", "target_book": "coloquios_da_orta_1563", "target_name": "sarna", "similarity": 0.853}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "sarna", "target_book": "polyanthea_medicinal", "target_name": "Sarna", "similarity": 0.729}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "sarna", "target_book": "coloquios_da_orta_1563", "target_name": "sarna", "similarity": 0.853}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "sarna", "target_book": "polyanthea_medicinal", "target_name": "Sarna", "similarity": 0.729}, {"source_book": "coloquios_da_orta_1563", "source_name": "sarna", "target_book": "polyanthea_medicinal", "target_name": "Sarna", "similarity": 0.696}], "id": 434, "stable_key": "clu_fba14b53dda3486d", "ground_truth": {"modern_name": "Scabies", "confidence": "high", "type": "disease", "modern_term": "Scabies", "wikidata_id": "Q167178", "wikidata_description": "human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Scabies", "note": "The early modern term 'itch' encompassed both the symptom of itching and specific conditions like scabies. Given the context of skin conditions and affections, scabies is the most likely specific disease referent.", "wikipedia_extract": "Scabies (, SKAY-beez; also sometimes known as the seven-year itch) is a contagious human skin infestation by the tiny (0.2\u20130.45 mm) mite Sarcoptes scabiei, variety hominis. The word is from Latin: scabere, lit. 'to scratch'. It is a particular public health problem in crowded settings such as care homes, schools, refugee camps, prisons, and hospitals. The most common symptoms are severe itchiness and a pimple-like rash. Occasionally, tiny burrows may appear on the skin from eggs that are about to hatch."}}, {"canonical_name": "Panno", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 4, "total_mentions": 31, "members": [{"entity_id": "pa\u00f1o", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "pa\u00f1o", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["pa\u00f1o"], "contexts": ["skin discoloration on face", "cloth"]}, {"entity_id": "pano", "book_id": "coloquios_da_orta_1563", "name": "pano", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["pano"], "contexts": ["cloth"]}, {"entity_id": "panno", "book_id": "ricettario_fiorentino_1597", "name": "panno", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 5, "variants": ["panno", "pannello", "panno fino"], "contexts": ["cloth used for pressing", "cloth for straining"]}, {"entity_id": "panno", "book_id": "polyanthea_medicinal", "name": "Panno", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 23, "variants": ["Panno", "fios de panno", "panninho", "panno", "panno afpero", "panno de linho", "panno de linho ralo", "panno delinho novo", "pannobem tapado", "pannodelinhonovo", "pannos de l\u00e1a", "tiras de panno de linhonovo"], "contexts": ["cloth used for application", "cloth for straining"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "pa\u00f1o", "target_book": "coloquios_da_orta_1563", "target_name": "pano", "similarity": 0.769}, {"source_book": "coloquios_da_orta_1563", "source_name": "pano", "target_book": "ricettario_fiorentino_1597", "target_name": "panno", "similarity": 0.895}, {"source_book": "coloquios_da_orta_1563", "source_name": "pano", "target_book": "polyanthea_medicinal", "target_name": "Panno", "similarity": 0.886}, {"source_book": "ricettario_fiorentino_1597", "source_name": "panno", "target_book": "polyanthea_medicinal", "target_name": "Panno", "similarity": 0.98}], "id": 435, "stable_key": "clu_2c2d79010fdb5f98", "ground_truth": {"modern_name": "Clothing", "confidence": "high", "type": "object", "wikidata_id": "Q11460", "wikidata_description": "covering worn on the body", "wikipedia_url": "https://en.wikipedia.org/wiki/Clothing", "wikipedia_extract": "Clothing (also known as clothes, garments, dress, apparel, or attire) is any item worn on a human body. Typically, clothing is made of fabrics or textiles, but over time it has included garments made from animal skin and other thin sheets of materials and natural products found in the environment, put together. The wearing of clothing is mostly restricted to humans and is a feature of all human societies. The amount and type of clothing worn depends on gender, body type, social factors, and geographic considerations. Garments cover the body, footwear covers the feet, gloves cover the hands, hats and headgear cover the head, and underwear covers the intimate parts. Clothing serves many purposes: it can serve as protection from the elements, rough surfaces, sharp stones, rash-causing plants, and insect bites, by providing a barrier between the skin and the environment."}}, {"canonical_name": "Farelos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 31, "members": [{"entity_id": "c\u00e9r\u00e9ales", "book_id": "relation_historique_humboldt_vol3_1825", "name": "c\u00e9r\u00e9ales", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["c\u00e9r\u00e9ales", "c\u00e9r\u00e9ale", "c\u00e9r\u00e9ales d'Europe"], "contexts": ["grains cultivated in Europe", "grain crops"]}, {"entity_id": "cereals", "book_id": "kosmos_humboldt_1845", "name": "cereals", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cereals"], "contexts": ["grains that grow at high altitudes"]}, {"entity_id": "farelos", "book_id": "polyanthea_medicinal", "name": "Farelos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 23, "variants": ["Farelos", "farellos", "farelos", "faretos"], "contexts": ["ingredient in a wash", "bran for facilitating digestion"]}, {"entity_id": "cereals", "book_id": "first_principles_spencer_1862", "name": "cereals", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cereals"], "contexts": ["conventional divisions established by agriculture"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "c\u00e9r\u00e9ales", "target_book": "kosmos_humboldt_1845", "target_name": "cereals", "similarity": 0.948}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "c\u00e9r\u00e9ales", "target_book": "polyanthea_medicinal", "target_name": "Farelos", "similarity": 0.903}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "c\u00e9r\u00e9ales", "target_book": "first_principles_spencer_1862", "target_name": "cereals", "similarity": 0.948}, {"source_book": "kosmos_humboldt_1845", "source_name": "cereals", "target_book": "polyanthea_medicinal", "target_name": "Farelos", "similarity": 0.904}, {"source_book": "kosmos_humboldt_1845", "source_name": "cereals", "target_book": "first_principles_spencer_1862", "target_name": "cereals", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Farelos", "target_book": "first_principles_spencer_1862", "target_name": "cereals", "similarity": 0.904}], "id": 436, "stable_key": "clu_4b64b12bcd63c568", "ground_truth": {"modern_name": "bran", "confidence": "high", "type": "substance", "description": "Outer coating of cereal grains, used as food or in preparations.", "wikipedia_extract": "Bran, also known as miller's bran, is the component of a cereal grain consisting of the hard layers \u2013 the combined aleurone and pericarp \u2013 surrounding the endosperm. Corn (maize) bran also includes the pedicel (tip cap). Along with the germ, it is an integral part of whole grains, and is often produced as a byproduct of milling in the production of refined grains. Bran is highly nutritious, but is difficult to digest due to its high fiber content; its high fat content also reduces its shelf life as the oils/fats are prone to becoming rancid. As such, it is typically removed from whole grain during the refining process \u2013 e.g. in processing wheat grain into white flour, or refining brown rice into white rice. Bran is present in cereal grain, including rice, corn (maize), wheat, oats, barley, rye, and millet."}}, {"canonical_name": "mer", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 30, "members": [{"entity_id": "mer", "book_id": "epoques_nature_buffon_1778", "name": "mer", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 20, "variants": ["mer"], "contexts": ["large body of saltwater", "sea"]}, {"entity_id": "mer", "book_id": "relation_historique_humboldt_vol3_1825", "name": "mer", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["mer"], "contexts": ["large body of saltwater", "body of saltwater"]}, {"entity_id": "mar", "book_id": "historia_medicinal_monardes_1574", "name": "mar", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["mar", "Mar"], "contexts": ["sea", "sea, where the tree grows near"]}, {"entity_id": "mar", "book_id": "coloquios_da_orta_1563", "name": "mar", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["mar"], "contexts": ["location of origin for substances", "sea"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "mer", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "mer", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mer", "target_book": "historia_medicinal_monardes_1574", "target_name": "mar", "similarity": 0.889}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mer", "target_book": "coloquios_da_orta_1563", "target_name": "mar", "similarity": 0.889}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mer", "target_book": "historia_medicinal_monardes_1574", "target_name": "mar", "similarity": 0.889}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mer", "target_book": "coloquios_da_orta_1563", "target_name": "mar", "similarity": 0.889}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "mar", "target_book": "coloquios_da_orta_1563", "target_name": "mar", "similarity": 1.0}], "id": 437, "stable_key": "clu_7cf0aa9a9b3ff251", "ground_truth": {"modern_name": "sea", "confidence": "high", "type": "place", "wikidata_id": "Q165", "wikidata_description": "city in and county seat of King County, State of Washington, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Sea", "wikipedia_extract": "A sea is a large body of salt water. There are particular seas and the sea. The sea commonly refers to the ocean, the interconnected body of seawaters that spans most of Earth. Particular seas are either marginal seas, second-order sections of the oceanic sea (e.g. the Mediterranean Sea), or certain large, nearly landlocked bodies of water. The salinity of water bodies varies widely, being lower near the surface and the mouths of large rivers and higher in the depths of the ocean; however, the relative proportions of dissolved salts vary little across the oceans."}}, {"canonical_name": "organ", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 29, "members": [{"entity_id": "organe", "book_id": "medecine_experimentale_bernard_1865", "name": "organe", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 6, "variants": ["organe"], "contexts": ["part of the body with a specific function", "body part with specific function"]}, {"entity_id": "organ", "book_id": "origin_of_species_darwin_1859", "name": "organ", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 13, "variants": ["organ"], "contexts": ["functional unit of the body", "part of an organism with a specific function"]}, {"entity_id": "organ", "book_id": "principles_of_psychology_james_1890", "name": "organ", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 8, "variants": ["organ"], "contexts": ["general term for body part", "a distinct part of the body with a specific function"]}, {"entity_id": "organ", "book_id": "first_principles_spencer_1862", "name": "organ", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["organ"], "contexts": ["functional part of a body", "general structure evolution parallels organ evolution"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "organe", "target_book": "origin_of_species_darwin_1859", "target_name": "organ", "similarity": 0.994}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "organe", "target_book": "principles_of_psychology_james_1890", "target_name": "organ", "similarity": 0.994}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "organe", "target_book": "first_principles_spencer_1862", "target_name": "organ", "similarity": 0.994}, {"source_book": "origin_of_species_darwin_1859", "source_name": "organ", "target_book": "principles_of_psychology_james_1890", "target_name": "organ", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "organ", "target_book": "first_principles_spencer_1862", "target_name": "organ", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "organ", "target_book": "first_principles_spencer_1862", "target_name": "organ", "similarity": 1.0}], "id": 438, "stable_key": "clu_5d0978055f91e336", "ground_truth": {"modern_name": "organ", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Organ_%28biology%29", "wikipedia_extract": "In a multicellular organism, an organ is a collection of tissues joined in a structural unit to serve a common function. In the hierarchy of life, an organ lies between tissue and an organ system. Tissues are formed from same type cells to act together in a function. Tissues of different types combine to form an organ which has a specific function. The intestinal wall for example is formed by epithelial tissue and smooth muscle tissue. Two or more organs working together in the execution of a specific body function form an organ system, also called a biological system or body system."}}, {"canonical_name": "poissons", "category": "ANIMAL", "subcategory": "FISH", "book_count": 4, "total_mentions": 28, "members": [{"entity_id": "poissons", "book_id": "medecine_experimentale_bernard_1865", "name": "poissons", "category": "ANIMAL", "subcategory": "FISH", "count": 3, "variants": ["poissons"], "contexts": ["aquatic vertebrates", "animals living under considerable pressure"]}, {"entity_id": "poissons", "book_id": "epoques_nature_buffon_1778", "name": "poissons", "category": "ANIMAL", "subcategory": "FISH", "count": 19, "variants": ["Poissons", "poissons"], "contexts": ["aquatic vertebrate animals", "fossil fish"]}, {"entity_id": "pescados", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "pescados", "category": "ANIMAL", "subcategory": "FISH", "count": 2, "variants": ["pescados"], "contexts": ["fish", "fish mentioned in the passage"]}, {"entity_id": "poissons", "book_id": "relation_historique_humboldt_vol3_1825", "name": "poissons", "category": "ANIMAL", "subcategory": "FISH", "count": 4, "variants": ["poissons", "poisson"], "contexts": ["fossil fish", "fishes found in limestone"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "poissons", "target_book": "epoques_nature_buffon_1778", "target_name": "poissons", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "poissons", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "pescados", "similarity": 0.981}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "poissons", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "poissons", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "poissons", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "pescados", "similarity": 0.981}, {"source_book": "epoques_nature_buffon_1778", "source_name": "poissons", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "poissons", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "pescados", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "poissons", "similarity": 0.981}], "id": 439, "stable_key": "clu_8c03acdca0669a4e", "ground_truth": {"modern_name": "Fish", "confidence": "high", "type": "animal", "note": "The term clearly refers to aquatic vertebrate animals.", "wikidata_id": "Q152", "wikidata_description": "vertebrate animal that lives in water and (typically) has gills", "wikipedia_url": "https://en.wikipedia.org/wiki/Fish"}}, {"canonical_name": "Centrifugal force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 28, "members": [{"entity_id": "force_centrifuge", "book_id": "epoques_nature_buffon_1778", "name": "force centrifuge", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["force centrifuge"], "contexts": ["outward force from rotation", "force pushing outward from center"]}, {"entity_id": "la_force_centrifuge", "book_id": "epoques_nature_buffon_1778", "name": "la force centrifuge", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["la force centrifuge"], "contexts": ["force pushing away from center"]}, {"entity_id": "centrifugal_force", "book_id": "kosmos_humboldt_1845", "name": "centrifugal force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["centrifugal force"], "contexts": ["force causing compression"]}, {"entity_id": "centrifugal_force", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Centrifugal force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 19, "variants": ["Centrifugal force", "centrifugal force"], "contexts": ["force preventing moon's descent to earth", "outward force from rotation"]}, {"entity_id": "centrifugal_force", "book_id": "first_principles_spencer_1862", "name": "centrifugal force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["centrifugal force"], "contexts": ["outward force due to rotation"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "force centrifuge", "target_book": "kosmos_humboldt_1845", "target_name": "centrifugal force", "similarity": 0.905}, {"source_book": "epoques_nature_buffon_1778", "source_name": "force centrifuge", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Centrifugal force", "similarity": 0.904}, {"source_book": "epoques_nature_buffon_1778", "source_name": "force centrifuge", "target_book": "first_principles_spencer_1862", "target_name": "centrifugal force", "similarity": 0.905}, {"source_book": "epoques_nature_buffon_1778", "source_name": "la force centrifuge", "target_book": "kosmos_humboldt_1845", "target_name": "centrifugal force", "similarity": 0.918}, {"source_book": "epoques_nature_buffon_1778", "source_name": "la force centrifuge", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Centrifugal force", "similarity": 0.918}, {"source_book": "epoques_nature_buffon_1778", "source_name": "la force centrifuge", "target_book": "first_principles_spencer_1862", "target_name": "centrifugal force", "similarity": 0.918}, {"source_book": "kosmos_humboldt_1845", "source_name": "centrifugal force", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Centrifugal force", "similarity": 0.983}, {"source_book": "kosmos_humboldt_1845", "source_name": "centrifugal force", "target_book": "first_principles_spencer_1862", "target_name": "centrifugal force", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Centrifugal force", "target_book": "first_principles_spencer_1862", "target_name": "centrifugal force", "similarity": 0.983}], "id": 440, "stable_key": "clu_5127ad9d99844b2c", "ground_truth": {"modern_name": "Centrifugal force", "confidence": "high", "type": "concept", "wikidata_id": "Q178733", "wikidata_description": "type of inertial force", "wikipedia_url": "https://en.wikipedia.org/wiki/Centrifugal%20force", "wikipedia_extract": "In Newtonian mechanics, a centrifugal force is a kind of fictitious force (or inertial force) that appears to act on all objects when viewed in a rotating frame of reference. It appears to be directed perpendicularly from the axis of rotation of the frame. The magnitude of the centrifugal force F on an object of mass m at the perpendicular distance \u03c1 from the axis of a rotating frame of reference with angular velocity \u03c9 is The concept of centrifugal force simplifies the analysis of rotating devices by adopting a co-rotating frame of reference, such as in centrifuges, centrifugal pumps, centrifugal governors, and centrifugal clutches, and in centrifugal railways, planetary orbits and banked curves. The same centrifugal effect observed on rotating devices can be analyzed in an inertial reference frame as a consequence of inertia and the physical forces without invoking a centrifugal force. From 1659, the Neo-Latin term vi centrifuga ('centrifugal force') is attested in Christiaan Huygens' notes and letters. In Latin centrum means 'center' and \u2011fugus (from fugi\u014d) means 'fleeing, avoiding'."}}, {"canonical_name": "Universe", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 28, "members": [{"entity_id": "univers", "book_id": "epoques_nature_buffon_1778", "name": "univers", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["univers"], "contexts": ["universe", "the universe expanded by human understanding"]}, {"entity_id": "universe", "book_id": "kosmos_humboldt_1845", "name": "universe", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["universe"], "contexts": ["containing forces and laws", "order and harmony pervading the universe"]}, {"entity_id": "universal_space", "book_id": "kosmos_humboldt_1845", "name": "universal space", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["universal space"], "contexts": ["vast expanse beyond Earth", "hypothesized location of magnetic attraction"]}, {"entity_id": "universe", "book_id": "connexion_physical_sciences_somerville_1858", "name": "universe", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Universe", "universe"], "contexts": ["all of space and time", "all existing matter and space"]}, {"entity_id": "universe", "book_id": "first_principles_spencer_1862", "name": "Universe", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 11, "variants": ["universe", "Universe"], "contexts": ["all of existence", "the entirety of existence"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "univers", "target_book": "kosmos_humboldt_1845", "target_name": "universe", "similarity": 0.981}, {"source_book": "epoques_nature_buffon_1778", "source_name": "univers", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "universe", "similarity": 0.981}, {"source_book": "epoques_nature_buffon_1778", "source_name": "univers", "target_book": "first_principles_spencer_1862", "target_name": "Universe", "similarity": 0.972}, {"source_book": "kosmos_humboldt_1845", "source_name": "universe", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "universe", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "universe", "target_book": "first_principles_spencer_1862", "target_name": "Universe", "similarity": 0.981}, {"source_book": "kosmos_humboldt_1845", "source_name": "universal space", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "universe", "similarity": 0.885}, {"source_book": "kosmos_humboldt_1845", "source_name": "universal space", "target_book": "first_principles_spencer_1862", "target_name": "Universe", "similarity": 0.89}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "universe", "target_book": "first_principles_spencer_1862", "target_name": "Universe", "similarity": 0.981}], "id": 441, "stable_key": "clu_e9763e9361d8c6c1", "ground_truth": {"modern_name": "Universe", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Suisse", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 4, "total_mentions": 28, "members": [{"entity_id": "switzerland", "book_id": "origin_of_species_darwin_1859", "name": "Switzerland", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Switzerland"], "contexts": ["location of ant observations", "location where slaves and masters work together"]}, {"entity_id": "suisse", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Suisse", "category": "PLACE", "subcategory": "COUNTRY", "count": 15, "variants": ["Suisse"], "contexts": ["country in Europe", "country with Alps"]}, {"entity_id": "switzerland", "book_id": "kosmos_humboldt_1845", "name": "Switzerland", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Switzerland"], "contexts": ["country visited"]}, {"entity_id": "switzerland", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Switzerland", "category": "PLACE", "subcategory": "COUNTRY", "count": 8, "variants": ["Switzerland"], "contexts": ["country with lofty mountain peaks", "country where bise wind is found"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Switzerland", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Suisse", "similarity": 0.959}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Switzerland", "target_book": "kosmos_humboldt_1845", "target_name": "Switzerland", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Switzerland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Switzerland", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Suisse", "target_book": "kosmos_humboldt_1845", "target_name": "Switzerland", "similarity": 0.959}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Suisse", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Switzerland", "similarity": 0.959}, {"source_book": "kosmos_humboldt_1845", "source_name": "Switzerland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Switzerland", "similarity": 1.0}], "id": 442, "stable_key": "clu_988c30ace4f586da", "ground_truth": {"modern_name": "Switzerland", "confidence": "high", "type": "place", "description": "European country known for the Alps.", "wikipedia_extract": "Switzerland, officially the Swiss Confederation, is a landlocked country located at the intersection of Central, Western, and Southern Europe. It is bordered by Germany to the north, France to the west, Austria and Liechtenstein to the east, and Italy to the south. Switzerland is geographically divided among the Swiss Alps, the Swiss Plateau, and the Jura mountains; the Alps cover most of the country's territory, whereas the majority of its 9 million people are concentrated on the plateau, which hosts many of the largest cities and economic centres, including Zurich, Geneva, Basel, Bern, Lausanne, Winterthur, and Lucerne. Switzerland is a federal republic composed of 26 cantons, with Bern serving as the federal city and the seat of the national government. The country encompasses four principal linguistic and cultural regions\u2014German, French, Italian, and Romansh\u2014reflecting a long-standing tradition of multilingualism and cultural pluralism. Swiss national identity nonetheless remains fairly cohesive, rooted in a shared historical background, common values such as federalism and direct democracy, and Alpine symbolism."}}, {"canonical_name": "language", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 28, "members": [{"entity_id": "language", "book_id": "origin_of_species_darwin_1859", "name": "language", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["language"], "contexts": ["system of communication with dialects", "system of communication"]}, {"entity_id": "language", "book_id": "principles_of_psychology_james_1890", "name": "language", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["Language", "language"], "contexts": ["faculty of communication", "mental faculty involving distinct powers"]}, {"entity_id": "language", "book_id": "kosmos_humboldt_1845", "name": "language", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Language", "language"], "contexts": ["system of communication", "attribute that binds the human race"]}, {"entity_id": "language", "book_id": "first_principles_spencer_1862", "name": "language", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["Language", "language"], "contexts": ["system of communication", "development from simple to complex"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "language", "target_book": "principles_of_psychology_james_1890", "target_name": "language", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "language", "target_book": "kosmos_humboldt_1845", "target_name": "language", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "language", "target_book": "first_principles_spencer_1862", "target_name": "language", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "language", "target_book": "kosmos_humboldt_1845", "target_name": "language", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "language", "target_book": "first_principles_spencer_1862", "target_name": "language", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "language", "target_book": "first_principles_spencer_1862", "target_name": "language", "similarity": 1.0}], "id": 443, "stable_key": "clu_5316bc47b10306f2", "ground_truth": {"modern_name": "Language", "confidence": "high", "type": "concept", "wikidata_id": "Q34770", "wikidata_description": "particular system of communication, often named for the region or peoples that use it"}}, {"canonical_name": "Polipodio", "category": "PLANT", "subcategory": "ROOT", "book_count": 4, "total_mentions": 28, "members": [{"entity_id": "polipodio", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "polipodio", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["polipodio"], "contexts": ["plant with similar leaves"]}, {"entity_id": "polipodio", "book_id": "coloquios_da_orta_1563", "name": "polipodio", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["polipodio"], "contexts": ["herb mentioned as food", "plant with leaves similar to a sensitive herb"]}, {"entity_id": "polipodio", "book_id": "ricettario_fiorentino_1597", "name": "Polipodio", "category": "PLANT", "subcategory": "ROOT", "count": 14, "variants": ["Polipodio", "Polipodio quercino", "Polpodio", "Polypodio", "polipodio"], "contexts": ["fern used in purgatives", "herb used in a syrup"]}, {"entity_id": "polipo", "book_id": "ricettario_fiorentino_1597", "name": "polipo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["polipo"], "contexts": ["plant ingredient in a preparation"]}, {"entity_id": "polipodio", "book_id": "polyanthea_medicinal", "name": "polipodio", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 10, "variants": ["polipodio", "Polipodiode Carvalho", "polipodio deCarvalho", "polipodio decarvalho", "polipodiode carvalho", "polypodio"], "contexts": ["herb used in decoctions", "herb used in purgative apozemas"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "polipodio", "target_book": "coloquios_da_orta_1563", "target_name": "polipodio", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "polipodio", "target_book": "ricettario_fiorentino_1597", "target_name": "Polipodio", "similarity": 0.881}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "polipodio", "target_book": "ricettario_fiorentino_1597", "target_name": "polipo", "similarity": 0.884}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "polipodio", "target_book": "polyanthea_medicinal", "target_name": "polipodio", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "polipodio", "target_book": "ricettario_fiorentino_1597", "target_name": "Polipodio", "similarity": 0.881}, {"source_book": "coloquios_da_orta_1563", "source_name": "polipodio", "target_book": "ricettario_fiorentino_1597", "target_name": "polipo", "similarity": 0.884}, {"source_book": "coloquios_da_orta_1563", "source_name": "polipodio", "target_book": "polyanthea_medicinal", "target_name": "polipodio", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Polipodio", "target_book": "polyanthea_medicinal", "target_name": "polipodio", "similarity": 0.881}, {"source_book": "ricettario_fiorentino_1597", "source_name": "polipo", "target_book": "polyanthea_medicinal", "target_name": "polipodio", "similarity": 0.884}], "id": 444, "stable_key": "clu_943d3d3126e29e18", "ground_truth": {"modern_name": "Polypody", "confidence": "high", "type": "plant", "description": "A fern with purgative properties, used in various medicinal preparations.", "note": "Likely referring to species in the genus Polypodium.", "wikipedia_extract": "Polypodium is a genus of ferns in the family Polypodiaceae, subfamily Polypodioideae, according to the Pteridophyte Phylogeny Group classification of 2016 (PPG I). The genus is widely distributed throughout the world, with the highest species diversity in the tropics. The name is derived from Ancient Greek poly (\"many\") + podion (\"little foot\"), on account of the foot-like appearance of the rhizome and its branches. They are commonly called polypodies or rockcap ferns, but for many species unique vernacular names exist. They are terrestrial or epiphytic ferns, with a creeping, densely hairy or scaly rhizome bearing fronds at intervals along its length. The species differ in size and general appearance and in the character of the fronds, which are evergreen, persisting for 1\u20132 years, pinnate or pinnatifid (rarely simple entire), and from 10 to 80 cm or more long."}}, {"canonical_name": "Strabo", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 4, "total_mentions": 27, "members": [{"entity_id": "strabo", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Strabo", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Strabo"], "contexts": ["ancient geographer and historian", "ancient geographer, cited as source"]}, {"entity_id": "strabo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Strabo", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Strabo", "Strabon"], "contexts": ["ancient geographer"]}, {"entity_id": "strabo", "book_id": "kosmos_humboldt_1845", "name": "Strabo", "category": "PERSON", "subcategory": "AUTHORITY", "count": 20, "variants": ["Strabo"], "contexts": ["ancient geographer", "ancient Greek geographer"]}, {"entity_id": "strab\u00e3o", "book_id": "coloquios_da_orta_1563", "name": "Strab\u00e3o", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Strab\u00e3o"], "contexts": ["version of Megasthenes' Indica", "ancient geographer"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Strabo", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Strabo", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Strabo", "target_book": "kosmos_humboldt_1845", "target_name": "Strabo", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Strabo", "target_book": "coloquios_da_orta_1563", "target_name": "Strab\u00e3o", "similarity": 0.881}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Strabo", "target_book": "kosmos_humboldt_1845", "target_name": "Strabo", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Strabo", "target_book": "coloquios_da_orta_1563", "target_name": "Strab\u00e3o", "similarity": 0.881}, {"source_book": "kosmos_humboldt_1845", "source_name": "Strabo", "target_book": "coloquios_da_orta_1563", "target_name": "Strab\u00e3o", "similarity": 0.881}], "id": 445, "stable_key": "clu_686737bee92eb767", "ground_truth": {"modern_name": "Strabo", "confidence": "high", "type": "person", "description": "Ancient Greek geographer, historian, and philosopher.", "wikipedia_extract": "Strabo (; Greek: \u03a3\u03c4\u03c1\u03ac\u03b2\u03c9\u03bd, romanized: Str\u00e1b\u014dn; 64 or 63 BC \u2013 c.\u200924 AD) was an ancient Greek geographer who lived in Asia Minor during the transitional period of the Roman Republic into the Roman Empire. He is best known for his work Geographica, which presented a descriptive history of people and places from different regions of the world known during his lifetime. Additionally, Strabo authored historical works, but only fragments and quotations of these survive in the writings of other authors. Strabo was born to an affluent family from Amaseia in Pontus in around 64 BC. His family had been involved in politics since at least the reign of Mithridates V. Strabo was related to Dorylaeus on his mother's side."}}, {"canonical_name": "Winter", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 27, "members": [{"entity_id": "winter", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Winter", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Winter"], "contexts": ["season when maggots lodge in cells"]}, {"entity_id": "winter", "book_id": "english_physician_1652", "name": "Winter", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 23, "variants": ["Winter", "Winter Frosts"], "contexts": ["season affecting the herb's leaves", "season leaving behind phlegm"]}, {"entity_id": "winter", "book_id": "origin_of_species_darwin_1859", "name": "winter", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["winter"], "contexts": ["coldest season of the year"]}, {"entity_id": "winter", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Winter", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["winter", "Winter"], "contexts": ["coldest season affecting moisture", "atmospheric electricity in"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Winter", "target_book": "english_physician_1652", "target_name": "Winter", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Winter", "target_book": "origin_of_species_darwin_1859", "target_name": "winter", "similarity": 0.964}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Winter", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Winter", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Winter", "target_book": "origin_of_species_darwin_1859", "target_name": "winter", "similarity": 0.964}, {"source_book": "english_physician_1652", "source_name": "Winter", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Winter", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "winter", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Winter", "similarity": 0.964}], "id": 446, "stable_key": "clu_6832f9e0358510b9", "ground_truth": {"modern_name": "Winter", "confidence": "high", "type": "concept", "wikidata_id": "Q852660", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Withania%20somnifera", "wikipedia_extract": "Withania somnifera, known commonly as ashwagandha, is an evergreen shrub in the Solanaceae family that is native to the Middle East and North Africa, other African regions, southern Europe, Indian subcontinent, and across Southeast Asia. Several other species in the genus Withania are morphologically similar. Other common names include Indian ginseng and winter cherry. W. somnifera is a short shrub 35\u201375 cm (14\u201330 in) tall with tomentose branches, dull green elliptic leaves up to 10\u201312 cm (3.9\u20134.7 in) long, small green bell-shaped flowers, and orange-red ripe fruit. It is affected by various pests and diseases in India, which can damage plant health and reduce its secondary metabolite content."}}, {"canonical_name": "sight", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 27, "members": [{"entity_id": "sight", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "sight", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sight"], "contexts": ["faculty of vision"]}, {"entity_id": "sight", "book_id": "english_physician_1652", "name": "sight", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 13, "variants": ["Sight", "sight"], "contexts": ["sense affected by eye conditions", "dimness of sight helped by Angelica"]}, {"entity_id": "sight", "book_id": "principles_of_psychology_james_1890", "name": "sight", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["sight"], "contexts": ["sense of vision", "sensory input"]}, {"entity_id": "sight", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sight", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sight"], "