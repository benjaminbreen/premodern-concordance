t_1845", "source_name": "mineralogical strata", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "strata", "similarity": 0.922}], "id": 548, "stable_key": "clu_35d7015ed081a767", "ground_truth": {"modern_name": "Strata", "confidence": "high", "type": "concept", "wikidata_id": "Q102290824", "wikidata_description": "0266-2442 | United Kingdom | Anglo-Israel Archaeological Society"}}, {"canonical_name": "Fruit", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 16, "members": [{"entity_id": "fruit", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Fruit", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Fruit"], "contexts": ["from the forbidden tree"]}, {"entity_id": "fruit", "book_id": "english_physician_1652", "name": "Fruit", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 13, "variants": ["Fruit", "Fruit Trees", "Fruits"], "contexts": ["part of the Bramble plant", "part of Briony used for sores"]}, {"entity_id": "fruit", "book_id": "principles_of_psychology_james_1890", "name": "fruit", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["fruit"], "contexts": ["sweet and fleshy product of a tree"]}, {"entity_id": "fruit", "book_id": "first_principles_spencer_1862", "name": "fruit", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["fruit"], "contexts": ["seed-bearing structure of a plant"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Fruit", "target_book": "english_physician_1652", "target_name": "Fruit", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fruit", "target_book": "first_principles_spencer_1862", "target_name": "fruit", "similarity": 1.0}], "id": 549, "stable_key": "clu_abf4c8815f72cf52", "ground_truth": {"modern_name": "fruit", "confidence": "high", "type": "plant", "note": "The term 'frutas'/'fruits' is general and refers to the edible product of plants, not a specific species.", "wikidata_id": "Q3314483", "wikidata_description": "typically sweet and/or sour, edible part/s of a plant that resembles seed-bearing fruit", "wikipedia_url": "https://en.wikipedia.org/wiki/Fruit", "wikipedia_extract": "In botany, a fruit is the seed-bearing structure in flowering plants (angiosperms) that is formed from the ovary after flowering. Fruits are the means by which angiosperms disseminate their seeds. Edible fruits in particular have long propagated using the movements of humans and other animals in a symbiotic relationship that is the means for seed dispersal for the one group and nutrition for the other; humans, and many other animals, have become dependent on fruits as a source of food. Consequently, fruits account for a substantial fraction of the world's agricultural output, and some (such as the apple and the pomegranate) have acquired extensive cultural and symbolic meanings. In common language and culinary usage, fruit normally means the seed-associated fleshy structures (or produce) of plants that typically are sweet (or sour) and edible in the raw state, such as apples, bananas, grapes, lemons, oranges, and strawberries. In botanical usage, the term fruit also includes many structures that are not commonly called as such in everyday language, such as nuts, bean pods, corn kernels, tomatoes, and wheat grains."}}, {"canonical_name": "Descartes", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 15, "members": [{"entity_id": "descartes", "book_id": "medecine_experimentale_bernard_1865", "name": "Descartes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Descartes"], "contexts": ["philosopher who stated truths are mind's feeling", "philosopher advocating evidence and demonstration"]}, {"entity_id": "des_cartes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Des Cartes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Des Cartes"], "contexts": ["philosopher who discussed attraction"]}, {"entity_id": "descartes", "book_id": "principles_of_psychology_james_1890", "name": "Descartes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["Descartes"], "contexts": ["philosopher on mind-body", "philosopher who conceived nervous mechanism"]}, {"entity_id": "descartes", "book_id": "kosmos_humboldt_1845", "name": "Descartes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Descartes"], "contexts": ["philosopher and scientist", "planned work 'Monde'"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Descartes", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Des Cartes", "similarity": 0.499}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Descartes", "target_book": "principles_of_psychology_james_1890", "target_name": "Descartes", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Descartes", "target_book": "kosmos_humboldt_1845", "target_name": "Descartes", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Des Cartes", "target_book": "principles_of_psychology_james_1890", "target_name": "Descartes", "similarity": 0.499}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Des Cartes", "target_book": "kosmos_humboldt_1845", "target_name": "Descartes", "similarity": 0.499}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Descartes", "target_book": "kosmos_humboldt_1845", "target_name": "Descartes", "similarity": 1.0}], "id": 550, "stable_key": "clu_06161fe90c16527d", "ground_truth": {"modern_name": "Ren\u00e9 Descartes", "confidence": "high", "type": "person", "birth_year": 1596, "death_year": 1650, "description": "French philosopher, mathematician, and scientist, influential in mind-body dualism.", "wikidata_id": "Q9191", "wikidata_description": "French philosopher, mathematician, and scientist (1596\u20131650)", "wikipedia_url": "https://en.wikipedia.org/wiki/Ren\u00e9_Descartes", "wikipedia_extract": "Ren\u00e9 Descartes ( day-KART, also  DAY-kart; French: [\u0281\u0259ne deka\u0281t] ; 31 March 1596 \u2013 11 February 1650) was a French philosopher, scientist, and mathematician, widely considered a seminal figure in the emergence of modern philosophy and science. Mathematics was paramount to his method of inquiry, and he connected the previously separate fields of geometry and algebra into analytic geometry. Refusing to accept the authority of previous philosophers, Descartes frequently set his views apart from the philosophers who preceded him. In the opening section of the Passions of the Soul, an early modern treatise on emotions, Descartes goes so far as to assert that he will write on this topic \"as if no one had written on these matters before.\" His best known philosophical statement is \"cogito, ergo sum\" (\"I think, therefore I am,\" French: \"Je pense, donc je suis\"). Descartes has often been called the father of modern philosophy, and he is largely seen as responsible for the increased attention given to epistemology in the 17th century. He was one of the key figures in the Scientific Revolution, and his Meditations on First Philosophy and other philosophical works continue to be studied."}}, {"canonical_name": "Lead", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 4, "total_mentions": 15, "members": [{"entity_id": "lead", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Lead", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["lead", "Lead"], "contexts": ["heavy metallic element", "heavy metal"]}, {"entity_id": "lead", "book_id": "english_physician_1652", "name": "lead", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["lead"], "contexts": ["material of mortar"]}, {"entity_id": "lead", "book_id": "kosmos_humboldt_1845", "name": "lead", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["lead"], "contexts": ["material used in experiments", "metal found in volcanic products"]}, {"entity_id": "lead", "book_id": "connexion_physical_sciences_somerville_1858", "name": "lead", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["lead"], "contexts": ["material for weighing experiment", "material for making pipes"]}, {"entity_id": "carbonate_of_lead", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Carbonate of lead", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Carbonate of lead"], "contexts": ["high refractive power, transmits less heat"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lead", "target_book": "english_physician_1652", "target_name": "lead", "similarity": 0.974}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lead", "target_book": "kosmos_humboldt_1845", "target_name": "lead", "similarity": 0.974}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lead", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lead", "similarity": 0.974}, {"source_book": "english_physician_1652", "source_name": "lead", "target_book": "kosmos_humboldt_1845", "target_name": "lead", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "lead", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lead", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "lead", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Carbonate of lead", "similarity": 0.91}, {"source_book": "kosmos_humboldt_1845", "source_name": "lead", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lead", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "lead", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Carbonate of lead", "similarity": 0.91}], "id": 551, "stable_key": "clu_ea95925f58d26a3a", "ground_truth": {"modern_name": "Lead", "confidence": "high", "type": "mineral", "note": "Includes 'Carbonate of lead' which is a specific compound of lead, but the primary referent is the element lead.", "wikidata_id": "Q708", "wikidata_description": "chemical element with symbol Pb and atomic number 82", "wikipedia_url": "https://en.wikipedia.org/wiki/Lead", "wikipedia_extract": "Lead ( ) is a chemical element with the symbol Pb (from the Latin plumbum) and atomic number 82. It is a heavy metal, denser than most common materials. Lead is soft, malleable, and has a relatively low melting point. When freshly cut or melted, it appears shiny silvery with a bluish tint, but tarnishes to dull gray on exposure to air. Lead has the highest atomic number of any stable element, and three of its isotopes are endpoints of major nuclear decay chains of heavier elements. Lead is a relatively unreactive post-transition metal.", "description": "A heavy, soft, bluish-grey metal, known for its toxicity."}}, {"canonical_name": "charbon", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 4, "total_mentions": 15, "members": [{"entity_id": "charbon", "book_id": "epoques_nature_buffon_1778", "name": "charbon", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 8, "variants": ["charbon"], "contexts": ["fossil fuel", "sedimentary rock formed from plants"]}, {"entity_id": "carb\u00f3n", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "carb\u00f3n", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["carb\u00f3n"], "contexts": ["charcoal powder used on Tauacos"]}, {"entity_id": "carv\u00e3o", "book_id": "coloquios_da_orta_1563", "name": "carv\u00e3o", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["carv\u00e3o"], "contexts": ["substance that diamond is"]}, {"entity_id": "carva\u00f3", "book_id": "polyanthea_medicinal", "name": "carva\u00f3", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["carva\u00f3", "carvab", "carv\u00e3o"], "contexts": ["fuel for fire", "substance exhaling poisonous quality"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "charbon", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "carb\u00f3n", "similarity": 0.937}, {"source_book": "epoques_nature_buffon_1778", "source_name": "charbon", "target_book": "coloquios_da_orta_1563", "target_name": "carv\u00e3o", "similarity": 0.914}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "carb\u00f3n", "target_book": "coloquios_da_orta_1563", "target_name": "carv\u00e3o", "similarity": 0.946}, {"source_book": "coloquios_da_orta_1563", "source_name": "carv\u00e3o", "target_book": "polyanthea_medicinal", "target_name": "carva\u00f3", "similarity": 0.818}], "id": 552, "stable_key": "clu_67b725cd62a0a80a", "ground_truth": {"modern_name": "charcoal", "confidence": "high", "type": "mineral", "wikidata_id": "Q177463", "wikidata_description": "fuel"}}, {"canonical_name": "Auvergne", "category": "PLACE", "subcategory": "REGION", "book_count": 4, "total_mentions": 15, "members": [{"entity_id": "auvergne", "book_id": "epoques_nature_buffon_1778", "name": "Auvergne", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Auvergne"], "contexts": ["region in France with mountains", "historical region in France"]}, {"entity_id": "auvergne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Auvergne", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Auvergne"], "contexts": ["region in France"]}, {"entity_id": "auvergne", "book_id": "kosmos_humboldt_1845", "name": "Auvergne", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Auvergne"], "contexts": ["region in France", "region with come-shaped volcanic summits"]}, {"entity_id": "auvergne", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Auvergne", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Auvergne"], "contexts": ["region containing Chaudes Aigues", "region with temperature measurement"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Auvergne", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Auvergne", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Auvergne", "target_book": "kosmos_humboldt_1845", "target_name": "Auvergne", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Auvergne", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Auvergne", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Auvergne", "target_book": "kosmos_humboldt_1845", "target_name": "Auvergne", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Auvergne", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Auvergne", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Auvergne", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Auvergne", "similarity": 1.0}], "id": 553, "stable_key": "clu_1e6acf86567019ff", "ground_truth": {"modern_name": "Auvergne", "confidence": "high", "type": "place", "country": "France", "wikidata_id": "Q1152", "wikidata_description": "cultural and historical region of France", "wikipedia_url": "https://en.wikipedia.org/wiki/Auvergne", "wikipedia_extract": "Auvergne (; French: [ov\u025b\u0281\u0272] ; Occitan: Auv\u00e8rnhe or Auv\u00e8rnha) is a cultural region in central France. It is now largely part of the Auvergne-Rh\u00f4ne-Alpes administrative region. Auvergne is generally regarded as conterminous with the land area of the historical Province of Auvergne, which was dissolved in 1790, and with the now-defunct administrative region of Auvergne, which existed from 1956 to 2015. The region is home to a chain of volcanoes known collectively as the \"cha\u00eene des Puys\". The volcanoes began forming about 70,000 years ago, and most have eroded, leaving plugs of hardened magma that form rounded hilltops known as puys. The last confirmed eruption occurred around 4040 BCE."}}, {"canonical_name": "Branches", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 15, "members": [{"entity_id": "branche", "book_id": "epoques_nature_buffon_1778", "name": "branche", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["branche"], "contexts": ["part of a plant for grafting"]}, {"entity_id": "branches", "book_id": "english_physician_1652", "name": "Branches", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 12, "variants": ["Branches", "Bran\u2223ches"], "contexts": ["parts of the Ladies-Bedstraw plant", "branches of the Black Bilberry plant"]}, {"entity_id": "branches", "book_id": "origin_of_species_darwin_1859", "name": "branches", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["branches"], "contexts": ["parts of a plant"]}, {"entity_id": "branches", "book_id": "principles_of_psychology_james_1890", "name": "branches", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["branches"], "contexts": ["part of a tree"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "branche", "target_book": "origin_of_species_darwin_1859", "target_name": "branches", "similarity": 0.895}, {"source_book": "epoques_nature_buffon_1778", "source_name": "branche", "target_book": "principles_of_psychology_james_1890", "target_name": "branches", "similarity": 0.895}, {"source_book": "english_physician_1652", "source_name": "Branches", "target_book": "origin_of_species_darwin_1859", "target_name": "branches", "similarity": 0.962}, {"source_book": "english_physician_1652", "source_name": "Branches", "target_book": "principles_of_psychology_james_1890", "target_name": "branches", "similarity": 0.962}, {"source_book": "origin_of_species_darwin_1859", "source_name": "branches", "target_book": "principles_of_psychology_james_1890", "target_name": "branches", "similarity": 1.0}], "id": 554, "stable_key": "clu_79057c2e40dbbfb4", "ground_truth": {"modern_name": "Branches", "confidence": "low", "type": "plant", "note": "This cluster refers to a general botanical term for a part of a plant and not a specific species."}}, {"canonical_name": "jaws", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 15, "members": [{"entity_id": "jaws", "book_id": "english_physician_1652", "name": "Jaws", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["Jaws"], "contexts": ["part of the mouth with inflammation", "body part affected by ailments"]}, {"entity_id": "jaws", "book_id": "origin_of_species_darwin_1859", "name": "jaws", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 8, "variants": ["jaws"], "contexts": ["part homologous with limbs", "mouthparts for biting"]}, {"entity_id": "jaw", "book_id": "origin_of_species_darwin_1859", "name": "jaw", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["jaw"], "contexts": ["part of the mouth"]}, {"entity_id": "jaw", "book_id": "principles_of_psychology_james_1890", "name": "jaw", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["jaw"], "contexts": ["organ of reaction"]}, {"entity_id": "jaws", "book_id": "first_principles_spencer_1862", "name": "jaws", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["jaws"], "contexts": ["bones of the mouth"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Jaws", "target_book": "origin_of_species_darwin_1859", "target_name": "jaws", "similarity": 0.979}, {"source_book": "english_physician_1652", "source_name": "Jaws", "target_book": "first_principles_spencer_1862", "target_name": "jaws", "similarity": 0.979}, {"source_book": "origin_of_species_darwin_1859", "source_name": "jaws", "target_book": "principles_of_psychology_james_1890", "target_name": "jaw", "similarity": 0.911}, {"source_book": "origin_of_species_darwin_1859", "source_name": "jaws", "target_book": "first_principles_spencer_1862", "target_name": "jaws", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "jaw", "target_book": "principles_of_psychology_james_1890", "target_name": "jaw", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "jaw", "target_book": "first_principles_spencer_1862", "target_name": "jaws", "similarity": 0.911}, {"source_book": "principles_of_psychology_james_1890", "source_name": "jaw", "target_book": "first_principles_spencer_1862", "target_name": "jaws", "similarity": 0.911}], "id": 555, "stable_key": "clu_047510438f6d02de", "ground_truth": {"modern_name": "Jaw", "confidence": "high", "type": "animal", "note": "Refers to the anatomical structure of the jaw, relevant in both medical and evolutionary contexts.", "wikidata_id": "Q3586", "wikidata_description": "province of Indonesia, on island of Java", "wikipedia_url": "https://en.wikipedia.org/wiki/East%20Java", "wikipedia_extract": "East Java (Indonesian: Jawa Timur, Javanese: \ua999\ua9ae\ua9b6\ua9ae\ua9ba\ua9a0\ua9a4\ua9c0, romanized: Jawi W\u00e9tan, Madurese: Jh\u00e2b\u00e2 T\u00e8mor) is a province of Indonesia located in the easternmost third of Java island. It has a land border only with the province of Central Java to the west; the Java Sea and the Indian Ocean border its northern and southern coasts, respectively, while the narrow Bali Strait to the east separates Java from Bali by around 2.29 kilometres (1.42 mi). Located in eastern Java, the province also includes the island of Madura (which is connected to Java by the longest bridge in Indonesia, the Suramadu Bridge), as well as the Kangean islands and other smaller island groups located further east (in the northern Bali Sea) and the Masalembu archipelago to the north. Its capital is Surabaya, the second largest city in Indonesia, a major industrial center and also a major business center. Banyuwangi is the largest regency in East Java and the largest on the island of Java. The province covers a land area of 48,036.84 square kilometres (18,547.13 sq mi), and according to the 2010 Census, there were 37,476,757 people residing there, making it Indonesia's second-most-populous province; the 2020 Census showed an increase to 40,665,696 people, while the official estimate for mid 2024 was 41,914,499 (comprising 20,848,660 males and 20,965,880 females)."}}, {"canonical_name": "Fear", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 15, "members": [{"entity_id": "fear", "book_id": "origin_of_species_darwin_1859", "name": "Fear", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Fear", "fear"], "contexts": ["emotional response to danger", "birds acquiring"]}, {"entity_id": "fear", "book_id": "principles_of_psychology_james_1890", "name": "Fear", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["Fear", "fear"], "contexts": ["emotion of apprehension", "cardinal passion of life"]}, {"entity_id": "fear", "book_id": "epoques_nature_buffon_1778", "name": "fear", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fear"], "contexts": ["emotion of apprehension"]}, {"entity_id": "fear", "book_id": "kosmos_humboldt_1845", "name": "fear", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["fear"], "contexts": ["emotional response to perceived threat", "emotion of apprehension"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Fear", "target_book": "principles_of_psychology_james_1890", "target_name": "Fear", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "fear", "target_book": "kosmos_humboldt_1845", "target_name": "fear", "similarity": 1.0}], "id": 556, "stable_key": "clu_9b305e6e53dd4854", "ground_truth": {"modern_name": "fear", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Fear", "wikipedia_extract": "Fear is an unpleasant subjective emotional state arising in response to perceived dangers or threats and which, when experienced, is typically associated with physiological and psychological changes. These changes frequently lead to behavioral reactions such as fight-or-flight responses or, in extreme cases, immobilization (freeze response). Unlike most (perhaps all) other animals, humans can experience fear in response to a present or anticipated stimulus and to imagined events. Most internalizing psychopathologies (depression, anxiety, suicidal thoughts and behaviors, and so forth) are associated with and maintained by dysfunctional, anxious, or fearful feelings and thoughts. Phobias, or exaggerated and often disabling fears, are usually similarly dysfunctional. Fear is often framed as a distinct product of evolution."}}, {"canonical_name": "Races", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 15, "members": [{"entity_id": "races", "book_id": "origin_of_species_darwin_1859", "name": "Races", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Races", "races"], "contexts": ["groups of animals or plants", "domesticated animal types"]}, {"entity_id": "races", "book_id": "first_principles_spencer_1862", "name": "Races", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["races", "Races"], "contexts": ["distinct groups within a species", "groups of people with shared characteristics"]}, {"entity_id": "races", "book_id": "epoques_nature_buffon_1778", "name": "races", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["races"], "contexts": ["constant varieties within species", "bred varieties of animals"]}, {"entity_id": "races", "book_id": "kosmos_humboldt_1845", "name": "races", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Races", "races"], "contexts": ["distinct human groups", "characteristic differences in races"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Races", "target_book": "first_principles_spencer_1862", "target_name": "Races", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "races", "target_book": "kosmos_humboldt_1845", "target_name": "races", "similarity": 1.0}], "id": 557, "stable_key": "clu_5cd8b7a9d1503026", "ground_truth": {"modern_name": "Race (biology)", "confidence": "high", "type": "concept", "note": "The concept of 'races' in early modern texts often reflects early, sometimes unscientific, categorizations of human or animal populations."}}, {"canonical_name": "nutrition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 14, "members": [{"entity_id": "nutrition", "book_id": "medecine_experimentale_bernard_1865", "name": "nutrition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["nutrition"], "contexts": ["process that engenders and conserves properties", "process of providing or obtaining food"]}, {"entity_id": "nutrition", "book_id": "principles_of_psychology_james_1890", "name": "nutrition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["nutrition"], "contexts": ["process of nourishing the body", "bodily processes of nourishment"]}, {"entity_id": "nutrition", "book_id": "kosmos_humboldt_1845", "name": "nutrition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["nutrition"], "contexts": ["process of providing nourishment"]}, {"entity_id": "nutrition", "book_id": "first_principles_spencer_1862", "name": "nutrition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["nutrition"], "contexts": ["process of nourishing the body", "process of nourishing and maintaining tissues"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "nutrition", "target_book": "principles_of_psychology_james_1890", "target_name": "nutrition", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "nutrition", "target_book": "kosmos_humboldt_1845", "target_name": "nutrition", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "nutrition", "target_book": "first_principles_spencer_1862", "target_name": "nutrition", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nutrition", "target_book": "kosmos_humboldt_1845", "target_name": "nutrition", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nutrition", "target_book": "first_principles_spencer_1862", "target_name": "nutrition", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "nutrition", "target_book": "first_principles_spencer_1862", "target_name": "nutrition", "similarity": 1.0}], "id": 558, "stable_key": "clu_17ba893672718676", "ground_truth": {"modern_name": "nutrition", "confidence": "high", "type": "concept", "wikidata_id": "Q17652193", "wikidata_description": "science that interprets the nutrients and other substances in food in relation to maintenance, growth, reproduction, health and disease of an organism", "wikipedia_url": "https://en.wikipedia.org/wiki/Nutritional%20science", "note": "The term 'nourishment' and its Portuguese equivalent 'nutr\u00edmento' directly refer to the biological process of providing or receiving sustenance, which is the modern concept of nutrition.", "wikipedia_extract": "Nutritional science (also nutrition science, sometimes short nutrition, dated trophology) is the science that studies the physiological process of nutrition (primarily human nutrition), interpreting the nutrients and other substances in food in relation to maintenance, growth, reproduction, health and disease of an organism. Before nutritional science emerged as an independent study disciplines, mainly chemists worked in this area. The chemical composition of food was examined. Macronutrients, especially protein, fat and carbohydrates, have been the focus components of the study of (human) nutrition since the 19th century. Until the discovery of vitamins and vital substances, the quality of nutrition was measured exclusively by the intake of nutritional energy. The early years of the 20th century were summarized by Kenneth John Carpenter in his Short History of Nutritional Science as \"the vitamin era\"."}}, {"canonical_name": "Respira\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 14, "members": [{"entity_id": "respiration", "book_id": "medecine_experimentale_bernard_1865", "name": "respiration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["respiration"], "contexts": ["process of breathing", "respiration, process of sugar destruction"]}, {"entity_id": "breathe", "book_id": "principles_of_psychology_james_1890", "name": "breathe", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["breathe"], "contexts": ["process of inhaling and exhaling"]}, {"entity_id": "respira\u00e7\u00e3o", "book_id": "polyanthea_medicinal", "name": "Respira\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["Respira\u00e7\u00e3o", "Respira\u00e7\u00e3o apreslada", "respira\u00e7a", "respira\u00e7\u00e3o"], "contexts": ["breathing", "bodily function"]}, {"entity_id": "breathing", "book_id": "first_principles_spencer_1862", "name": "breathing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["breathing"], "contexts": ["process of respiration"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "respiration", "target_book": "principles_of_psychology_james_1890", "target_name": "breathe", "similarity": 0.922}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "respiration", "target_book": "polyanthea_medicinal", "target_name": "Respira\u00e7\u00e3o", "similarity": 0.955}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "respiration", "target_book": "first_principles_spencer_1862", "target_name": "breathing", "similarity": 0.951}, {"source_book": "principles_of_psychology_james_1890", "source_name": "breathe", "target_book": "polyanthea_medicinal", "target_name": "Respira\u00e7\u00e3o", "similarity": 0.905}, {"source_book": "principles_of_psychology_james_1890", "source_name": "breathe", "target_book": "first_principles_spencer_1862", "target_name": "breathing", "similarity": 0.977}, {"source_book": "polyanthea_medicinal", "source_name": "Respira\u00e7\u00e3o", "target_book": "first_principles_spencer_1862", "target_name": "breathing", "similarity": 0.929}], "id": 559, "stable_key": "clu_e805813a0207e258", "ground_truth": {"modern_name": "Respiration", "confidence": "high", "type": "concept", "description": "The physiological process of breathing.", "wikipedia_extract": "Photosynthesis ( FOH-t\u0259-SINTH-\u0259-sis) is a system of biological processes by which photopigment-bearing autotrophic organisms, such as most plants, algae and cyanobacteria, convert light energy \u2014 typically from sunlight \u2014 into the chemical energy necessary to fuel their metabolism. The term photosynthesis usually refers to oxygenic photosynthesis, a process that releases oxygen as a byproduct of water splitting. Photosynthetic organisms store the converted chemical energy within the bonds of intracellular organic compounds (complex compounds containing carbon), typically carbohydrates like sugars (mainly glucose, fructose and sucrose), starches, phytoglycogen and cellulose. When needing to use this stored energy, an organism's cells then metabolize the organic compounds through cellular respiration. Photosynthesis plays a critical role in producing and maintaining the oxygen content of the Earth's atmosphere, and it supplies most of the biological energy necessary for complex life on Earth. Some organisms also perform anoxygenic photosynthesis, which does not produce oxygen.", "wikipedia_url": "https://en.wikipedia.org/wiki/Photosynthesis"}}, {"canonical_name": "Leibnitz", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 14, "members": [{"entity_id": "leibnitz", "book_id": "medecine_experimentale_bernard_1865", "name": "Leibnitz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Leibnitz"], "contexts": ["philosopher and scientist", "philosopher, scientist"]}, {"entity_id": "leibnitz", "book_id": "principles_of_psychology_james_1890", "name": "Leibnitz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["Leibnitz"], "contexts": ["philosopher who discussed perception", "philosopher and mathematician"]}, {"entity_id": "leibnitz", "book_id": "kosmos_humboldt_1845", "name": "Leibnitz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Leibnitz"], "contexts": ["philosopher on planetary volume increase", "author of 'Deutschen Schriften'"]}, {"entity_id": "leibnitz", "book_id": "first_principles_spencer_1862", "name": "Leibnitz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Leibnitz"], "contexts": ["suggested matter composed of unextended monads"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Leibnitz", "target_book": "principles_of_psychology_james_1890", "target_name": "Leibnitz", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Leibnitz", "target_book": "kosmos_humboldt_1845", "target_name": "Leibnitz", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Leibnitz", "target_book": "first_principles_spencer_1862", "target_name": "Leibnitz", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Leibnitz", "target_book": "kosmos_humboldt_1845", "target_name": "Leibnitz", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Leibnitz", "target_book": "first_principles_spencer_1862", "target_name": "Leibnitz", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Leibnitz", "target_book": "first_principles_spencer_1862", "target_name": "Leibnitz", "similarity": 1.0}], "id": 560, "stable_key": "clu_e5797ef9f672c4e7", "ground_truth": {"modern_name": "Gottfried Wilhelm Leibniz", "confidence": "high", "type": "person", "birth_year": 1646, "death_year": 1716, "description": "German philosopher, mathematician, and scientist, influential figure in rationalism.", "wikidata_id": "Q9047", "wikidata_description": "German mathematician and philosopher (1646\u20131716)", "wikipedia_url": "https://en.wikipedia.org/wiki/Gottfried%20Wilhelm%20Leibniz", "wikipedia_extract": "Gottfried Wilhelm Leibniz (or Leibnitz; 1 July 1646 [O.S. 21 June] \u2013 14 November 1716) was a German polymath active as a mathematician, philosopher, scientist, and diplomat who is credited, alongside Isaac Newton, with the creation of calculus in addition to many other branches of mathematics, such as binary arithmetic and statistics. Leibniz has been called the \"last universal genius\" due to his vast expertise across fields, which became a rarity after his lifetime with the coming of the Industrial Revolution and the spread of specialized labour. He is a prominent figure in both the history of philosophy and the history of mathematics. He wrote works on philosophy, theology, ethics, politics, law, history, philology, games, music, and other studies. Leibniz also made major contributions to physics and technology, and anticipated notions that surfaced much later in probability theory, biology, medicine, geology, psychology, linguistics and computer science."}}, {"canonical_name": "hygrom\u00e8tre \u00e0 baleine", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 4, "total_mentions": 14, "members": [{"entity_id": "hygrom\u00e8tre", "book_id": "medecine_experimentale_bernard_1865", "name": "hygrom\u00e8tre", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["hygrom\u00e8tre"], "contexts": ["instrument for measuring humidity"]}, {"entity_id": "hygrom\u00e8tre_\u00e0_baleine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "hygrom\u00e8tre \u00e0 baleine", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 9, "variants": ["hygrom\u00e8tre \u00e0 baleine", "HYGROM\u00c8TRE", "hygrom\u00e8tre", "hygrom\u00e8tre de Deluc", "hygrom\u00e8tre \u00e0 cheveu"], "contexts": ["instrument for measuring humidity", "whalebone hygrometer for humidity measurement"]}, {"entity_id": "hygrometer", "book_id": "kosmos_humboldt_1845", "name": "hygrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["hygrometer"], "contexts": ["instrument for measuring humidity"]}, {"entity_id": "hygrometer", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Hygrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["hygrometer", "Hygrometer"], "contexts": ["instrument for measuring humidity", "instrument for measuring dew-point"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "hygrom\u00e8tre", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "hygrom\u00e8tre \u00e0 baleine", "similarity": 0.891}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "hygrom\u00e8tre", "target_book": "kosmos_humboldt_1845", "target_name": "hygrometer", "similarity": 0.994}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "hygrom\u00e8tre", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Hygrometer", "similarity": 0.989}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "hygrom\u00e8tre \u00e0 baleine", "target_book": "kosmos_humboldt_1845", "target_name": "hygrometer", "similarity": 0.884}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "hygrom\u00e8tre \u00e0 baleine", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Hygrometer", "similarity": 0.885}, {"source_book": "kosmos_humboldt_1845", "source_name": "hygrometer", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Hygrometer", "similarity": 0.996}], "id": 561, "stable_key": "clu_0438fcb18de9a09d", "ground_truth": {"modern_name": "Hygrometer", "confidence": "high", "type": "object", "note": "The term 'hygrom\u00e8tre \u00e0 baleine' is a specific type of hygrometer that uses whalebone. 'Hygrometer' is the general modern term.", "wikidata_id": "Q183173", "wikidata_description": "instrument used for measuring the moisture content in the atmosphere", "wikipedia_url": "https://en.wikipedia.org/wiki/Hygrometer", "wikipedia_extract": "A hygrometer is an instrument that measures humidity: that is, how much water vapor is present. Humidity measurement instruments usually rely on measurements of some other quantities, such as temperature, pressure, mass, and mechanical or electrical changes in a substance as moisture is absorbed. By calibration and calculation, these measured quantities can be used to indicate the humidity. Modern electronic devices use the temperature of condensation (called the dew point), or they sense changes in electrical capacitance or resistance. The maximum amount of water vapor that can be present in a given volume (at saturation) varies greatly with temperature; at low temperatures a lower mass of water per unit volume can remain as vapor than at high temperatures. Thus a change in the temperature changes the relative humidity."}}, {"canonical_name": "fire", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 14, "members": [{"entity_id": "fire", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "fire", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["fire"], "contexts": ["element causing dissolution and fusion", "elemental force"]}, {"entity_id": "fire", "book_id": "principles_of_psychology_james_1890", "name": "fire", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["fire"], "contexts": ["combustion producing heat and light", "example of something not remembered"]}, {"entity_id": "fire", "book_id": "kosmos_humboldt_1845", "name": "fire", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["fire"], "contexts": ["columns from volcanic eruptions", "element associated with volcanic explosions"]}, {"entity_id": "fire", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Fire", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["Fire", "fire"], "contexts": ["used for drying photographic paper", "source of common heat"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fire", "target_book": "principles_of_psychology_james_1890", "target_name": "fire", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fire", "target_book": "kosmos_humboldt_1845", "target_name": "fire", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fire", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Fire", "similarity": 0.995}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fire", "target_book": "kosmos_humboldt_1845", "target_name": "fire", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fire", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Fire", "similarity": 0.995}, {"source_book": "kosmos_humboldt_1845", "source_name": "fire", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Fire", "similarity": 0.995}], "id": 562, "stable_key": "clu_4cb0c0ee5f7ed5e4", "ground_truth": {"modern_name": "Fire", "confidence": "high", "type": "concept", "note": "In early modern texts, 'fire' often referred to the element and its associated heat and transformative properties, not solely combustion.", "wikidata_id": "Q2044", "wikidata_description": "Italian city and commune, located in Tuscany", "wikipedia_url": "", "wikipedia_extract": ""}}, {"canonical_name": "Britain", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 4, "total_mentions": 14, "members": [{"entity_id": "britain", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Britain", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Britain"], "contexts": ["described by Caesar"]}, {"entity_id": "britain", "book_id": "origin_of_species_darwin_1859", "name": "Britain", "category": "PLACE", "subcategory": "COUNTRY", "count": 10, "variants": ["Britain"], "contexts": ["location of existing pigeon breeds", "country from Britain"]}, {"entity_id": "britain", "book_id": "principles_of_psychology_james_1890", "name": "Britain", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Britain"], "contexts": ["country of Hume, Mills, Bain's associationism"]}, {"entity_id": "britain", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Britain", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Britain"], "contexts": ["location from which comet was seen", "country proud of working classes"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Britain", "target_book": "origin_of_species_darwin_1859", "target_name": "Britain", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Britain", "target_book": "principles_of_psychology_james_1890", "target_name": "Britain", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Britain", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Britain", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Britain", "target_book": "principles_of_psychology_james_1890", "target_name": "Britain", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Britain", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Britain", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Britain", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Britain", "similarity": 1.0}], "id": 563, "stable_key": "clu_eac142b3bcc64426", "ground_truth": {"modern_name": "Great Britain", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q145", "wikidata_description": "island country in north-west Europe", "wikipedia_url": "https://en.wikipedia.org/wiki/United%20Kingdom", "wikipedia_extract": "The United Kingdom of Great Britain and Northern Ireland, commonly known as the United Kingdom (UK) or Britain, is a country in northwestern Europe, off the coast of the continental mainland. It comprises England, Scotland, Wales and Northern Ireland, with a population of over 69 million in 2024. The UK includes the island of Great Britain, the north-eastern part of the island of Ireland, and most of the smaller islands within the British Isles, covering 94,354 square miles (244,376 km2). It shares a land border with the Republic of Ireland and is surrounded by the Atlantic Ocean, the North Sea, the English Channel, the Celtic Sea and the Irish Sea, while maintaining sovereignty over the Crown Dependencies and the British Overseas Territories. The capital and largest city of England and the UK is London; Edinburgh, Cardiff and Belfast are the national capitals of Scotland, Wales and Northern Ireland. Britain has been inhabited since the Neolithic."}}, {"canonical_name": "Kamtschatka", "category": "PLACE", "subcategory": "REGION", "book_count": 4, "total_mentions": 14, "members": [{"entity_id": "kamtschatka", "book_id": "epoques_nature_buffon_1778", "name": "Kamtschatka", "category": "PLACE", "subcategory": "REGION", "count": 6, "variants": ["Kamtschatka"], "contexts": ["peninsula in the Russian Far East", "region with inland seas"]}, {"entity_id": "kamtschatka", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Kamtschatka", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Kamtschatka", "Kamlschatka"], "contexts": ["region in Siberia", "peninsula"]}, {"entity_id": "kamtschatka", "book_id": "kosmos_humboldt_1845", "name": "Kamtschatka", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Kamtschatka"], "contexts": ["peninsula with mountains", "peninsula in Russia"]}, {"entity_id": "kamt-schatka", "book_id": "kosmos_humboldt_1845", "name": "Kamt-schatka", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Kamt-schatka"], "contexts": ["peninsula east of magnetic declination line"]}, {"entity_id": "kamtschatka", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Kamtschatka", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Kamtschatka"], "contexts": ["peninsula in Russia"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Kamtschatka", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Kamtschatka", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Kamtschatka", "target_book": "kosmos_humboldt_1845", "target_name": "Kamtschatka", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Kamtschatka", "target_book": "kosmos_humboldt_1845", "target_name": "Kamt-schatka", "similarity": 0.581}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Kamtschatka", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kamtschatka", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Kamtschatka", "target_book": "kosmos_humboldt_1845", "target_name": "Kamtschatka", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Kamtschatka", "target_book": "kosmos_humboldt_1845", "target_name": "Kamt-schatka", "similarity": 0.581}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Kamtschatka", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kamtschatka", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Kamtschatka", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kamtschatka", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Kamt-schatka", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kamtschatka", "similarity": 0.581}], "id": 564, "stable_key": "clu_9e391346a27a0d2e", "ground_truth": {"modern_name": "Kamchatka Peninsula", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q993", "wikidata_description": "peninsula in Eastern Russia between the Pacific Ocean and the Sea of Okhotsk", "wikipedia_url": "https://en.wikipedia.org/wiki/Kamchatka%20Peninsula", "wikipedia_extract": "The Kamchatka Peninsula (Russian: \u043f\u043e\u043b\u0443\u043e\u0301\u0441\u0442\u0440\u043e\u0432 \u041a\u0430\u043c\u0447\u0430\u0301\u0442\u043a\u0430, romanized: polu\u00f3strov Kamch\u00e1tka, pronounced [p\u0259l\u028a\u02c8ostr\u0259f k\u0250m\u02c8t\u0361\u0255\u00e6tk\u0259], Ainu: Cupka) is a 1,250-kilometre-long (777 mi) peninsula in the Russian Far East, with an area of about 270,000 km2 (100,000 sq mi). The Sea of Okhotsk bounds the peninsula's western coastline, immediately offshore of the peninsula and below the Bering Sea runs the 9,600-metre-deep (31,496 ft) Kuril\u2013Kamchatka Trench. Its eastern coastline is the Bering Sea, part of the Pacific Ocean. The Kamchatka Peninsula, the Commander Islands, and Karaginsky Island constitute Kamchatka Krai of the Russian Federation. The majority of the 322,079 inhabitants are ethnic Russians, with about 13,000 being Koryaks (2014). More than half of the population lives in Petropavlovsk-Kamchatsky (179,526 in 2010) and nearby Yelizovo (38,980)."}}, {"canonical_name": "acid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 14, "members": [{"entity_id": "acide", "book_id": "epoques_nature_buffon_1778", "name": "acide", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["acide"], "contexts": ["acid", "acid principle"]}, {"entity_id": "acid", "book_id": "principles_of_psychology_james_1890", "name": "acid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["acid"], "contexts": ["corrosive chemical substance", "irritant substance applied to frog"]}, {"entity_id": "acid", "book_id": "connexion_physical_sciences_somerville_1858", "name": "acid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["acid"], "contexts": ["substance in solution producing positive electricity", "substance in vapour producing positive electricity"]}, {"entity_id": "acid", "book_id": "first_principles_spencer_1862", "name": "acid", "category": "SUBSTANCE", "