xion_physical_sciences_somerville_1858", "name": "ecliptic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 53, "variants": ["Ecliptic", "ecliptic"], "contexts": ["plane of Earth's orbit", "path of the sun"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "\u00e9cliptique", "target_book": "kosmos_humboldt_1845", "target_name": "ecliptic", "similarity": 0.951}, {"source_book": "epoques_nature_buffon_1778", "source_name": "\u00e9cliptique", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ecliptic", "similarity": 0.951}, {"source_book": "kosmos_humboldt_1845", "source_name": "ecliptic", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ecliptic", "similarity": 1.0}], "id": 855, "stable_key": "clu_689c728f5cd12fb7", "ground_truth": {"modern_name": "Ecliptic", "confidence": "high", "type": "concept", "note": "The ecliptic is the plane of the Earth's orbit around the Sun.", "wikidata_id": "Q25377854", "wikidata_description": "database of stars and planets that is associated with the K2 \"Second Light\" plan of the Kepler space telescope mission", "wikipedia_url": "https://en.wikipedia.org/wiki/Ecliptic%20Plane%20Input%20Catalog", "wikipedia_extract": "The Ecliptic Plane Input Catalog (or EPIC) is a publicly searchable database of stars and planets that is associated with the K2 \"Second Light\" plan of the Kepler space telescope mission. Examples of related stars include:  EPIC 201563164, EPIC 204278916, EPIC 204376071 and EPIC 249706694. Examples of related planets include: EPIC 203771098 b, EPIC 203771098 c, EPIC 206011691 c and EPIC 211945201 b. In November 2013, a new mission plan named K2 \"Second Light\" was presented for consideration. K2 would involve using Kepler's remaining capability, photometric precision of about 300 parts per million, compared with about 20 parts per million earlier, to collect data for the study of \"supernova explosions, star formation and Solar-System bodies such as asteroids and comets, ... \" and for finding and studying more exoplanets."}}, {"canonical_name": "Ha\u00efti", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 58, "members": [{"entity_id": "ha\u00efti", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Ha\u00efti", "category": "PLACE", "subcategory": "REGION", "count": 56, "variants": ["ha\u00efti", "Ha\u00efti"], "contexts": ["island", "island in the Caribbean"]}, {"entity_id": "haiti", "book_id": "kosmos_humboldt_1845", "name": "Haiti", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Haiti"], "contexts": ["island where subterranean thunder was heard"]}, {"entity_id": "haiti", "book_id": "coloquios_da_orta_1563", "name": "Haiti", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Haiti"], "contexts": ["alternative name for Espailola"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ha\u00efti", "target_book": "kosmos_humboldt_1845", "target_name": "Haiti", "similarity": 0.791}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ha\u00efti", "target_book": "coloquios_da_orta_1563", "target_name": "Haiti", "similarity": 0.791}, {"source_book": "kosmos_humboldt_1845", "source_name": "Haiti", "target_book": "coloquios_da_orta_1563", "target_name": "Haiti", "similarity": 1.0}], "id": 856, "stable_key": "clu_fe3bc77fbe07d166", "ground_truth": {"modern_name": "Haiti", "confidence": "high", "type": "place", "country": "Haiti", "wikidata_id": "Q790", "wikidata_description": "country in the Caribbean Sea", "wikipedia_url": "https://en.wikipedia.org/wiki/Haiti", "wikipedia_extract": "Haiti, officially the Republic of Haiti, is a country in the Caribbean on the island of Hispaniola in the Caribbean Sea, east of Cuba and Jamaica and south of the Bahamas. It occupies the western side of the island, which it shares with the Dominican Republic. Haiti is the third largest country in the Caribbean, and with an estimated population of 11.4 million, it is the most populous Caribbean country. The capital and largest city is Port-au-Prince. Haiti was originally inhabited by the Ta\u00edno people. In 1492, Christopher Columbus established the first European settlement in the Americas, La Navidad, on its northeastern coast."}}, {"canonical_name": "Inflamations", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 3, "total_mentions": 57, "members": [{"entity_id": "inflamations", "book_id": "english_physician_1652", "name": "Inflamations", "category": "DISEASE", "subcategory": "ACUTE", "count": 55, "variants": ["inflamations", "Inflamations"], "contexts": ["swelling and redness", "condition treated by Alder-Tree leaves"]}, {"entity_id": "inflammation", "book_id": "origin_of_species_darwin_1859", "name": "inflammation", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["inflammation"], "contexts": ["swelling and redness of tissue"]}, {"entity_id": "inflamma\u00e7\u00f5es_internas", "book_id": "polyanthea_medicinal", "name": "inflamma\u00e7\u00f5es internas", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["inflamma\u00e7\u00f5es internas"], "contexts": ["internal inflammations"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Inflamations", "target_book": "origin_of_species_darwin_1859", "target_name": "inflammation", "similarity": 0.908}, {"source_book": "english_physician_1652", "source_name": "Inflamations", "target_book": "polyanthea_medicinal", "target_name": "inflamma\u00e7\u00f5es internas", "similarity": 0.917}], "id": 857, "stable_key": "clu_4390b9f094c2b63f", "ground_truth": {"modern_name": "Inflammation", "confidence": "high", "type": "disease", "modern_term": "Inflammation", "wikidata_id": "Q14819849", "wikidata_description": "immediate defensive reaction (by vertebrate tissue) to infection or injury caused by chemical or physical agents, characterized by local vasodilation, extravasation of plasma into intercellular spaces and accumulation of white blood cells", "note": "The terms 'enflamed', 'inflama\u00e7a\u00f3', and 'inflammada' all refer to the state of being inflamed, a symptom or process of inflammation."}}, {"canonical_name": "olhos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 56, "members": [{"entity_id": "ojos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "ojos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 21, "variants": ["ojos"], "contexts": ["eyes", "body part affected by inflammation"]}, {"entity_id": "olhos", "book_id": "coloquios_da_orta_1563", "name": "olhos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["olhos"], "contexts": ["broken in illness"]}, {"entity_id": "olhos", "book_id": "polyanthea_medicinal", "name": "olhos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 34, "variants": ["olhos", "Olhos", "olho"], "contexts": ["eyes", "body part affected by fluxion"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ojos", "target_book": "coloquios_da_orta_1563", "target_name": "olhos", "similarity": 0.99}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ojos", "target_book": "polyanthea_medicinal", "target_name": "olhos", "similarity": 0.99}, {"source_book": "coloquios_da_orta_1563", "source_name": "olhos", "target_book": "polyanthea_medicinal", "target_name": "olhos", "similarity": 1.0}], "id": 858, "stable_key": "clu_e9d3c6b0cd857fa2", "ground_truth": {"modern_name": "Eyes", "confidence": "high", "type": "object", "description": "The organs of sight in humans and animals.", "wikipedia_extract": "An eye is a sensory organ that allows an organism to perceive visual information. It detects light and converts it into electro-chemical impulses in neurons (neurones). It is part of an organism's visual system. In higher organisms, the eye is a complex optical system that collects light from the surrounding environment, regulates its intensity through a diaphragm, focuses it through an adjustable assembly of lenses to form an image, converts this image into a set of electrical signals, and transmits these signals to the brain through neural pathways that connect the eye via the optic nerve to the visual cortex and other areas of the brain. Eyes with resolving power have come in ten fundamentally different forms, classified into compound eyes and non-compound eyes. Compound eyes are made up of multiple small visual units, and are common on insects and crustaceans."}}, {"canonical_name": "\u00c1sia", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 56, "members": [{"entity_id": "assia", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Assia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Assia"], "contexts": ["continent for plant transport"]}, {"entity_id": "\u00e1sia", "book_id": "coloquios_da_orta_1563", "name": "\u00c1sia", "category": "PLACE", "subcategory": "REGION", "count": 47, "variants": ["\u00c1sia", "\u00c1sia central"], "contexts": ["book title", "Work by Diogo do Couto"]}, {"entity_id": "asia", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Asia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Asia"], "contexts": ["continent where plant is transported"]}, {"entity_id": "asia", "book_id": "coloquios_da_orta_1563", "name": "Asia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["Asia", "Asia. J. Res."], "contexts": ["book by Jo\u00e3o de Barros", "region, cited in reference"]}, {"entity_id": "asiatic", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Asiatic", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Asiatic"], "contexts": ["part of the Russian empire"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Assia", "target_book": "coloquios_da_orta_1563", "target_name": "\u00c1sia", "similarity": 0.961}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Asia", "target_book": "coloquios_da_orta_1563", "target_name": "Asia", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Asia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Asiatic", "similarity": 0.955}, {"source_book": "coloquios_da_orta_1563", "source_name": "Asia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Asiatic", "similarity": 0.955}], "id": 859, "stable_key": "clu_f13b617f6c0f0df6-2", "ground_truth": {"modern_name": "Asia", "confidence": "high", "type": "place", "country": "Asia", "wikidata_id": "Q210718", "wikidata_description": "Roman province", "wikipedia_url": "https://en.wikipedia.org/wiki/Asia%20%28Roman%20province%29", "note": "Historically referred to a vast region of Asia, often encompassing South Asia and Southeast Asia.", "wikipedia_extract": "Asia (Ancient Greek: \u1f08\u03c3\u03af\u03b1) was a Roman province covering most of western Asia Minor (Anatolia, Turkey), which was created following the Roman Republic's annexation of the Attalid Kingdom in 133 BC. After the establishment of the Roman Empire by Augustus, it was the most prestigious senatorial province and was governed by a proconsul. That arrangement endured until the province was subdivided in the fourth century AD. The province was one of the richest of the Empire and was at peace for most of the Imperial period. It contained hundreds of largely self-governing Greek city-states, who competed fiercely with one another for status, through appeals to the Imperial authorities and the cultivation of prestigious cultural institutions such as festival games, religious cults, and oratory. The province of Asia originally consisted of the territories of Mysia, the Troad, Aeolis, Lydia, Ionia, Caria, and the land corridor through Pisidia to Pamphylia."}}, {"canonical_name": "Popayan", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 55, "members": [{"entity_id": "popayan", "book_id": "epoques_nature_buffon_1778", "name": "Popayan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Popayan"], "contexts": ["city where Cordilleras return east", "geographic location in South America"]}, {"entity_id": "popayan", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Popayan", "category": "PLACE", "subcategory": "CITY", "count": 47, "variants": ["Popayan", "Popajan"], "contexts": ["mountainous population center in Colombia", "city with population 171,000"]}, {"entity_id": "popayan", "book_id": "kosmos_humboldt_1845", "name": "Popayan", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Popayan"], "contexts": ["city in Colombia", "city in 1788 with specific latitude and elevation"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Popayan", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Popayan", "similarity": 0.865}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Popayan", "target_book": "kosmos_humboldt_1845", "target_name": "Popayan", "similarity": 0.865}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Popayan", "target_book": "kosmos_humboldt_1845", "target_name": "Popayan", "similarity": 1.0}], "id": 860, "stable_key": "clu_55aa952688a12997", "ground_truth": {"modern_name": "Popay\u00e1n", "confidence": "high", "type": "place", "country": "Colombia"}}, {"canonical_name": "animaux", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 54, "members": [{"entity_id": "animaux", "book_id": "medecine_experimentale_bernard_1865", "name": "animaux", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 37, "variants": ["animaux"], "contexts": ["animals as a general category", "animals"]}, {"entity_id": "animaux", "book_id": "epoques_nature_buffon_1778", "name": "animaux", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 13, "variants": ["animaux"], "contexts": ["animal life, part of earth's composition", "animals that formerly existed"]}, {"entity_id": "animaux", "book_id": "relation_historique_humboldt_vol3_1825", "name": "animaux", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["animaux"], "contexts": ["creatures consumed for meat", "animals being fattened"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "animaux", "target_book": "epoques_nature_buffon_1778", "target_name": "animaux", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "animaux", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "animaux", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "animaux", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "animaux", "similarity": 1.0}], "id": 861, "stable_key": "clu_3937c5dad79fa39f", "ground_truth": {"modern_name": "Animals", "confidence": "high", "type": "animal", "wikidata_id": "Q431", "wikidata_description": "scientific study of animals", "wikipedia_url": "https://en.wikipedia.org/wiki/Zoology"}}, {"canonical_name": "Myrrha", "category": "PLANT", "subcategory": "RESIN", "book_count": 3, "total_mentions": 54, "members": [{"entity_id": "myrrhe", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Myrrhe", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["Myrrhe"], "contexts": ["aromatic resin"]}, {"entity_id": "myrrha", "book_id": "ricettario_fiorentino_1597", "name": "Myrrha", "category": "PLANT", "subcategory": "RESIN", "count": 31, "variants": ["Myrrha", "Myrra", "Myrrba", "Myrrhatroglody", "Myrrna", "myrrha"], "contexts": ["resin with strong odor", "resin from an Arabian tree"]}, {"entity_id": "myrrha", "book_id": "polyanthea_medicinal", "name": "myrrha", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 22, "variants": ["myrrha", "Myrrha"], "contexts": ["myrrh used in a liniment", "aromatic resin"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Myrrhe", "target_book": "ricettario_fiorentino_1597", "target_name": "Myrrha", "similarity": 0.96}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Myrrha", "target_book": "polyanthea_medicinal", "target_name": "myrrha", "similarity": 0.723}], "id": 862, "stable_key": "clu_7c2be69bf5e0581f-2", "ground_truth": {"modern_name": "Myrrh", "confidence": "high", "type": "plant", "linnaean": "Commiphora myrrha", "family": "Burseraceae", "note": "Although Myrrh is a resin, it is derived from plants.", "wikidata_id": "Q1137175", "wikidata_description": "species of plant", "wikipedia_extract": "A resin is a solid or highly viscous liquid that can be converted into a polymer. Resins may be biological or synthetic in origin, but are typically harvested from plants. Resins are mixtures of organic compounds insoluble in water, predominantly terpenes. Technically, resins should not be confused with gums, which consist predominantly of water-soluble polysaccharides, although these two terms are often interchangeable in the less formal context. Common resins include pine oleoresins, amber, hashish, frankincense, myrrh and the animal-derived resin, shellac. Resins are used in varnishes, adhesives, food additives, incenses and perfumes.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cicely", "description": "A fragrant resinous substance from certain trees, used medicinally."}}, {"canonical_name": "veneno", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 54, "members": [{"entity_id": "veneno", "book_id": "historia_medicinal_monardes_1574", "name": "veneno", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 36, "variants": ["veneno", "Veneno", "Venenon", "venena", "venenados", "veneno a toda propriedad", "veneno mortifero", "veneno y ponso\u00f1a"], "contexts": ["substance against which stones are effective", "poisonous substance from a fruit pit"]}, {"entity_id": "veneno", "book_id": "coloquios_da_orta_1563", "name": "veneno", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 15, "variants": ["veneno", "venenos", "venenosas", "venenosos"], "contexts": ["poison", "condition the root is against"]}, {"entity_id": "venenosis", "book_id": "polyanthea_medicinal", "name": "venenosis", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["venenosis"], "contexts": ["poisonous conditions"]}, {"entity_id": "venenota", "book_id": "polyanthea_medicinal", "name": "venenota", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["venenota"], "contexts": ["poison"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "veneno", "target_book": "coloquios_da_orta_1563", "target_name": "veneno", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "veneno", "target_book": "polyanthea_medicinal", "target_name": "venenosis", "similarity": 0.923}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "veneno", "target_book": "polyanthea_medicinal", "target_name": "venenota", "similarity": 0.945}, {"source_book": "coloquios_da_orta_1563", "source_name": "veneno", "target_book": "polyanthea_medicinal", "target_name": "venenosis", "similarity": 0.923}, {"source_book": "coloquios_da_orta_1563", "source_name": "veneno", "target_book": "polyanthea_medicinal", "target_name": "venenota", "similarity": 0.945}], "id": 863, "stable_key": "clu_9349b37bd8b2514d", "ground_truth": {"modern_name": "Poisoning", "confidence": "high", "type": "disease", "modern_term": "Poisoning", "note": "The term 'veneno' can refer to both the poison itself and the condition of being poisoned. 'Poisoning' encompasses both meanings.", "wikidata_id": "Q387175", "wikidata_description": "human disease"}}, {"canonical_name": "Bengala", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 53, "members": [{"entity_id": "bengal", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bengal", "category": "PLACE", "subcategory": "COUNTRY", "count": 5, "variants": ["Bengal", "Bengale"], "contexts": ["presidency", "region in India"]}, {"entity_id": "bengal", "book_id": "kosmos_humboldt_1845", "name": "Bengal", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Bengal"], "contexts": ["service of Mr. Batten"]}, {"entity_id": "bengala", "book_id": "coloquios_da_orta_1563", "name": "Bengala", "category": "PLACE", "subcategory": "REGION", "count": 47, "variants": ["Bengala", "Bengal", "Bengalla", "Bengallas", "bengala"], "contexts": ["region where herva-babosa is abundant", "place of origin for substances"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bengal", "target_book": "kosmos_humboldt_1845", "target_name": "Bengal", "similarity": 0.919}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bengal", "target_book": "coloquios_da_orta_1563", "target_name": "Bengala", "similarity": 0.916}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bengal", "target_book": "coloquios_da_orta_1563", "target_name": "Bengala", "similarity": 0.982}], "id": 864, "stable_key": "clu_b195188043ebba8a", "ground_truth": {"modern_name": "Bengal", "confidence": "high", "type": "place", "description": "A region in the eastern part of the Indian subcontinent.", "wikipedia_extract": "Bengal ( ben-GAWL) is a geographical, ethnolinguistic, historically geopolitical region in South Asia, located north of the Bay of Bengal. Today, it is politically divided between the sovereign state of Bangladesh, the Indian state of West Bengal, and Karimganj district in the Indian state of Assam. The ancient Vanga Kingdom is widely regarded as the namesake of the Bengal region. The Bengali calendar dates back to the reign of Shashanka in the 7th century CE. The Pala Empire was founded in Bengal during the 8th century. The Sena dynasty and Deva dynasty ruled between the 11th and 13th centuries."}}, {"canonical_name": "Paulus \u00c6gineta", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 52, "members": [{"entity_id": "paulus_\u00e6gineta", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Paulus \u00c6gineta", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Paulus \u00c6gineta"], "contexts": ["ancient physician from \u00c6gina"]}, {"entity_id": "paulus_aegineta", "book_id": "english_physician_1652", "name": "Paulus AEgineta", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Paulus AEgineta"], "contexts": ["ancient author on Pepperwort virtues"]}, {"entity_id": "paulus_\u00e6gineta", "book_id": "polyanthea_medicinal", "name": "Paulus \u00c6gineta", "category": "PERSON", "subcategory": "AUTHORITY", "count": 50, "variants": ["Paulus \u00c6gineta", "Paul", "Paul. Eginet.", "Paul. Ginet.", "Paul. \u00c6ginet.", "Paul.Eginet", "Paul.\u00c6ginet.", "Paulo Egineta", "Paulo Gineta", "Paulo \u00c6gineta", "Paulus", "Paulus Aegineta", "Paulus Ginet.", "Paulus Gineta", "Paulus Ginetade", "Paulus Pernumia", "Paulus \u00c6ginera", "Paulus \u00c6ginet."], "contexts": ["ancient medical authority on tremors", "ancient author on medicine and coughs"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Paulus \u00c6gineta", "target_book": "english_physician_1652", "target_name": "Paulus AEgineta", "similarity": 0.9}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Paulus \u00c6gineta", "target_book": "polyanthea_medicinal", "target_name": "Paulus \u00c6gineta", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Paulus AEgineta", "target_book": "polyanthea_medicinal", "target_name": "Paulus \u00c6gineta", "similarity": 0.9}], "id": 865, "stable_key": "clu_d63729935ec47a0a", "ground_truth": {"modern_name": "Paulus of Aegina", "confidence": "high", "type": "person", "birth_year": 625, "death_year": 690, "description": "Byzantine physician and medical author.", "wikidata_id": "Q90799809", "wikidata_description": "scientific article published on 15 October 2019"}}, {"canonical_name": "Boticarios", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 3, "total_mentions": 52, "members": [{"entity_id": "boticarios", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Boticarios", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["Boticarios"], "contexts": ["apothecaries"]}, {"entity_id": "boticairos", "book_id": "coloquios_da_orta_1563", "name": "boticairos", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 18, "variants": ["boticairos", "Frades boticairos", "boticairo", "boticairos da \u00edndia", "boticairos portuguezes", "botic\u00e1rios", "bot\u00edcairos", "buticairo", "buticairos"], "contexts": ["apothecaries in Spain", "apothecaries"]}, {"entity_id": "boticarios", "book_id": "polyanthea_medicinal", "name": "Boticarios", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 33, "variants": ["Boticarios", "Boticario", "Boticario Portuguez", "BoticariodelRey", "Boticarios Galenistas", "Boticariothe"], "contexts": ["apothecaries preparing medicines", "apothecaries advised on preparation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Boticarios", "target_book": "coloquios_da_orta_1563", "target_name": "boticairos", "similarity": 0.966}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Boticarios", "target_book": "polyanthea_medicinal", "target_name": "Boticarios", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "boticairos", "target_book": "polyanthea_medicinal", "target_name": "Boticarios", "similarity": 0.966}], "id": 866, "stable_key": "clu_505e6dafb2f1e125", "ground_truth": {"modern_name": "Apothecary", "confidence": "high", "type": "person", "description": "Prepares and dispenses medicinal drugs.", "wikidata_id": "Q1131236", "wikidata_description": "historical name for a medical professional now called a pharmacist", "wikipedia_url": "https://en.wikipedia.org/wiki/Apothecary", "wikipedia_extract": "Apothecary () is an archaic English term for a medical professional who formulates and dispenses materia medicacode: lat promoted to code: la  ('medicine') to physicians, surgeons and patients. The modern terms pharmacist and, in British English, chemist have taken over this role. In some languages and regions, terms similar to \"apothecary\" have survived and denote modern pharmacies or pharmacists. Apothecaries' investigation of herbal and chemical ingredients was a precursor to the modern sciences of chemistry and pharmacology. In addition to dispensing herbs and medicine, apothecaries offered general medical advice and a range of services that are now performed by other specialist practitioners, such as surgeons and obstetricians. Apothecary shops sold ingredients and the medicines they prepared wholesale to other medical practitioners, as well as dispensing them to patients."}}, {"canonical_name": "peste", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 3, "total_mentions": 52, "members": [{"entity_id": "peste", "book_id": "historia_medicinal_monardes_1574", "name": "Peste", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["Peste", "Peiste", "peste"], "contexts": ["contagious disease", "disease Ambar can resist"]}, {"entity_id": "peste", "book_id": "coloquios_da_orta_1563", "name": "peste", "category": "DISEASE", "subcategory": "ACUTE", "count": 7, "variants": ["peste"], "contexts": ["disease mentioned in the text", "contagious disease"]}, {"entity_id": "peste", "book_id": "polyanthea_medicinal", "name": "peste", "category": "DISEASE", "subcategory": "ACUTE", "count": 41, "variants": ["Peste", "peste"], "contexts": ["plague", "a severe infectious disease"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Peste", "target_book": "coloquios_da_orta_1563", "target_name": "peste", "similarity": 0.836}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Peste", "target_book": "polyanthea_medicinal", "target_name": "peste", "similarity": 0.836}, {"source_book": "coloquios_da_orta_1563", "source_name": "peste", "target_book": "polyanthea_medicinal", "target_name": "peste", "similarity": 1.0}], "id": 867, "stable_key": "clu_ff1adb9e8ce8faf2", "ground_truth": {"modern_name": "Plague", "confidence": "high", "type": "disease", "modern_term": "Plague", "wikidata_id": "Q133780", "wikidata_description": "specific contagious and frequently fatal human disease caused by Yersinia pestis", "wikipedia_extract": "Plague is an infectious disease caused by the bacterium Yersinia pestis. Symptoms include fever, weakness, headache and black lips. Usually, this begins one to seven days after exposure. There are three forms of plague, each affecting a different part of the body and causing associated symptoms. Pneumonic plague infects the lungs, causing shortness of breath, coughing and chest pain; bubonic plague affects the lymph nodes, making them swell; and septicemic plague infects the blood and can cause tissues to turn black and die. The bubonic and septicemic forms are generally spread by flea bites or handling an infected animal, whereas pneumonic plague is generally spread between people through the air via infectious droplets.", "wikipedia_url": "https://en.wikipedia.org/wiki/Plague_(disease)", "description": "A highly contagious and often fatal infectious disease.", "note": "Covers terms related to the bubonic plague and similar epidemic diseases."}}, {"canonical_name": "feu", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 51, "members": [{"entity_id": "feu", "book_id": "medecine_experimentale_bernard_1865", "name": "feu", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["feu"], "contexts": ["phenomenon whose essence is unknown"]}, {"entity_id": "feu", "book_id": "epoques_nature_buffon_1778", "name": "feu", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 44, "variants": ["feu"], "contexts": ["agent of liquefaction", "source of heat and combustion"]}, {"entity_id": "fuego", "book_id": "historia_medicinal_monardes_1574", "name": "fuego", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["fuego", "Fuego"], "contexts": ["fire, element associated with sulphur", "heat source for cooking"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "feu", "target_book": "epoques_nature_buffon_1778", "target_name": "feu", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "feu", "target_book": "historia_medicinal_monardes_1574", "target_name": "fuego", "similarity": 0.978}, {"source_book": "epoques_nature_buffon_1778", "source_name": "feu", "target_book": "historia_medicinal_monardes_1574", "target_name": "fuego", "similarity": 0.978}], "id": 868, "stable_key": "clu_4cb0c0ee5f7ed5e4-2", "ground_truth": {"modern_name": "Fire", "confidence": "high", "type": "concept", "note": "In early modern texts, 'fire' often referred to the element and its associated heat and transformative properties, not solely combustion.", "wikidata_id": "Q2044", "wikidata_description": "Italian city and commune, located in Tuscany", "wikipedia_url": "", "wikipedia_extract": ""}}, {"canonical_name": "mulheres", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 51, "members": [{"entity_id": "femelles", "book_id": "relation_historique_humboldt_vol3_1825", "name": "femelles", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["femelles"], "contexts": ["female enslaved people"]}, {"entity_id": "mulher", "book_id": "coloquios_da_orta_1563", "name": "mulher", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["mulher"], "contexts": ["person who administered diamond"]}, {"entity_id": "mulheres", "book_id": "polyanthea_medicinal", "name": "mulheres", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 49, "variants": ["mulheres", "mulher", "mulher mo\u00e7a", "mulher prenhada", "mulheres menftruadas", "mulheres mo\u00e7as", "mulheres paridas", "mulheres pejadas", "mulheres prenhadas", "mulheres que cria\u014d", "mulheres que estiverem para parir", "mulheres ricas", "mulheres velhas", "mulheresprenhadas"], "contexts": ["women", "women, a specific patient group"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "femelles", "target_book": "polyanthea_medicinal", "target_name": "mulheres", "similarity": 0.885}, {"source_book": "coloquios_da_orta_1563", "source_name": "mulher", "target_book": "polyanthea_medicinal", "target_name": "mulheres", "similarity": 0.906}], "id": 869, "stable_key": "clu_f57ae43e14230dcc", "ground_truth": {"modern_name": "Woman", "confidence": "high", "type": "person", "description": "Female person, sometimes in roles of administration or servitude.", "wikidata_id": "Q6581072", "wikidata_description": "to be used in \"sex or gender\" (P21) to indicate that the human subject is a female or \"semantic gender\" (P10339) to indicate that a word refers to a female person", "wikipedia_url": "https://en.wikipedia.org/wiki/Female%20%28gender%29"}}, {"canonical_name": "ferro", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 51, "members": [{"entity_id": "ferro", "book_id": "coloquios_da_orta_1563", "name": "ferro", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 13, "variants": ["ferro"], "contexts": ["metal found on the island", "metal that existed in Ceyl\u00e3o"]}, {"entity_id": "ferro", "book_id": "ricettario_fiorentino_1597", "name": "ferro", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 11, "variants": ["ferro"], "contexts": ["metal from under the earth", "metal from which scales fall"]}, {"entity_id": "ferro", "book_id": "polyanthea_medicinal", "name": "ferro", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 27, "variants": ["ferro", "Ferro"], "contexts": ["tool for extraction", "heated to create fumes for a remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "ferro", "target_book": "ricettario_fiorentino_1597", "target_name": "ferro", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "ferro", "target_book": "polyanthea_medicinal", "target_name": "ferro", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "ferro", "target_book": "polyanthea_medicinal", "target_name": "ferro", "similarity": 1.0}], "id": 870, "stable_key": "clu_257cd6b5b944ec64-3", "ground_truth": {"modern_name": "iron", "confidence": "high", "type": "mineral", "wikidata_id": "Q677", "wikidata_description": "chemical element with symbol Fe and atomic number 26", "wikipedia_url": "https://en.wikipedia.org/wiki/Iron", "wikipedia_extract": "Iron is a chemical element; it has symbol Fe (from Latin  ferrum 'iron') and atomic number 26. It is a metal that belongs to the first transition series and group 8 of the periodic table. It is, by mass, the most common element on Earth, forming much of Earth's outer and inner core. It is the fourth most abundant element in the Earth's crust. In its metallic state it was mainly deposited by meteorites. Extracting usable metal from iron ores requires kilns or furnaces capable of reaching 1,500 \u00b0C (2,730 \u00b0F), about 500 \u00b0C (900 \u00b0F) higher than that required to smelt copper."}}, {"canonical_name": "remedios", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 50, "members": [{"entity_id": "rem\u00e8des", "book_id": "medecine_experimentale_bernard_1865", "name": "rem\u00e8des", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 5, "variants": ["rem\u00e8des"], "contexts": ["medicinal preparations for treatment", "substances used to treat illness"]}, {"entity_id": "rem\u00e8de", "book_id": "medecine_experimentale_bernard_1865", "name": "rem\u00e8de", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["rem\u00e8de"], "contexts": ["medical treatment or cure", "substance used to cure illness"]}, {"entity_id": "rem\u00e9dios", "book_id": "coloquios_da_orta_1563", "name": "rem\u00e9dios", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["rem\u00e9dios", "remedio"], "contexts": ["medicinal treatments", "medicine"]}, {"entity_id": "remedios", "book_id": "polyanthea_medicinal", "name": "remedios", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 41, "variants": ["remedios", "remedios compoftos", "remedios eficazes", "remedios fortes", "remedios ordinarios", "remedium", "rem\u00e9dios"], "contexts": ["Medicines derived from leaves", "medicines"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "rem\u00e8des", "target_book": "polyanthea_medicinal", "target_name": "remedios", "similarity": 0.965}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "rem\u00e8de", "target_book": "polyanthea_medicinal", "target_name": "remedios", "similarity": 0.932}, {"source_book": "coloquios_da_orta_1563", "source_name": "rem\u00e9dios", "target_book": "polyanthea_medicinal", "target_name": "remedios", "similarity": 0.931}], "id": 871, "stable_key": "clu_be279fa14119f837", "ground_truth": {"modern_name": "Medicines", "confidence": "high", "type": "concept", "description": "Substances used for therapeutic purposes to treat illness or disease.", "wikipedia_extract": "Medication (also called medicament, medicine, pharmaceutical drug, medicinal product, medicinal drug, or simply drug) is a drug used to diagnose, cure, treat, or prevent disease. Drug therapy (pharmacotherapy) is an important part of the medical field and relies on the science of pharmacology for continual advancement and on pharmacy for appropriate management. Drugs are classified in many ways. One of the key divisions is by level of control, which distinguishes prescription drugs (those that a pharmacist dispenses only on the medical prescription) from over-the-counter drugs (those that consumers can order for themselves). Medicines may be classified by mode of action, route of administration, biological system affected, or therapeutic effects. The World Health Organization keeps a list of essential medicines."}}, {"canonical_name": "Loadstone", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 50, "members": [{"entity_id": "loadstone", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Loadstone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 42, "variants": ["Loadstone"], "contexts": ["mineral with magnetic properties", "magnetic stone"]}, {"entity_id": "loadstones", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Loadstones", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["Loadstones"], "contexts": ["magnetic stones affecting needles", "laid long time in Quicksilver"]}, {"entity_id": "loadstone", "book_id": "kosmos_humboldt_1845", "name": "loadstone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["loadstone"], "contexts": ["naturally magnetic rock", "naturally magnetized iron ore"]}, {"entity_id": "loadstones", "book_id": "kosmos_humboldt_1845", "name": "loadstones", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["loadstones"], "contexts": ["natural magnets"]}, {"entity_id": "loadstone", "book_id": "connexion_physical_sciences_somerville_1858", "name": "loadstone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["loadstone"], "contexts": ["naturally paramagnetic iron ore"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Loadstone", "target_book": "kosmos_humboldt_1845", "target_name": "loadstone", "similarity": 0.962}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Loadstone", "target_book": "kosmos_humboldt_1845", "target_name": "loadstones", "similarity": 0.933}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Loadstone", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "loadstone", "similarity": 0.962}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Loadstones", "target_book": "kosmos_humboldt_1845", "target_name": "loadstone", "similarity": 0.921}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Loadstones", "target_book": "kosmos_humboldt_1845", "target_name": "loadstones", "similarity": 0.968}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Loadstones", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "loadstone", "similarity": 0.921}, {"source_book": "kosmos_humboldt_1845", "source_name": "loadstone", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "loadstone", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "loadstones", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "loadstone", "similarity": 0.955}], "id": 872, "stable_key": "clu_47fd947cbf4b00b8", "ground_truth": {"modern_name": "Lodestone", "confidence": "high", "type": "mineral", "wikidata_id": "Q3480938", "wikidata_description": "naturally magnetized mineral, magnetite variety", "wikipedia_url": "https://en.wikipedia.org/wiki/Lodestone", "wikipedia_extract": "Lodestones are naturally magnetized pieces of the mineral magnetite. They are naturally occurring magnets, which can attract iron. The property of magnetism was first discovered in antiquity through lodestones. Pieces of lodestone, suspended so they could turn, were the first magnetic compasses, and their importance to early navigation is indicated by the name lodestone, which in Middle English means \"course stone\" or \"leading stone\", from the now-obsolete meaning of lode as \"journey, way\". Lodestone is one of only a very few minerals that is found naturally magnetized. Magnetite is black or brownish-black with a black streak, with a metallic luster and a Mohs hardness of 5.5\u20136.5."}}, {"canonical_name": "frios", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 50, "members": [{"entity_id": "frio", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "frio", "category": "CONCEPT", "subcategory": "QUALITY", "count": 5, "variants": ["frio"], "contexts": ["temperature quality of plant", "cold quality"]}, {"entity_id": "fr\u00edos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "fr\u00edos", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["fr\u00edos"], "contexts": ["quality of growing places", "quality associated with fevers and cachexia"]}, {"entity_id": "frio", "book_id": "historia_medicinal_monardes_1574", "name": "frio", "category": "CONCEPT", "subcategory": "QUALITY", "count": 21, "variants": ["frio", "frios de complexi\u00f3n", "fr\u00eda", "fr\u00edo"], "contexts": ["cold", "condition Ambar can resolve"]}, {"entity_id": "frios", "book_id": "polyanthea_medicinal", "name": "frios", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 22, "variants": ["frios"], "contexts": ["sensation of cold", "cold remedies for hot/dry conditions"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "frio", "target_book": "historia_medicinal_monardes_1574", "target_name": "frio", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "frio", "target_book": "polyanthea_medicinal", "target_name": "frios", "similarity": 0.969}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "fr\u00edos", "target_book": "polyanthea_medicinal", "target_name": "frios", "similarity": 0.991}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "frio", "target_book": "polyanthea_medicinal", "target_name": "frios", "similarity": 0.969}], "id": 873, "stable_key": "clu_06ad6c064ed8b34c-4", "ground_truth": {"modern_name": "cold", "confidence": "high", "type": "concept", "wikidata_id": "Q199804", "wikidata_description": "lung disease involving long-term poor airflow", "wikipedia_url": "https://en.wikipedia.org/wiki/Chronic%20obstructive%20pulmonary%20disease", "note": "Refers to the physical sensation and thermodynamic state of low temperature, as well as its perceived qualities in historical medical contexts.", "wikipedia_extract": "Chronic obstructive pulmonary disease (COPD) is a type of progressive lung disease characterized by chronic respiratory symptoms and airflow limitation. GOLD defines COPD as a heterogeneous lung condition characterized by chronic respiratory symptoms (shortness of breath, cough, sputum production or exacerbations) due to abnormalities of the airways (bronchitis, bronchiolitis) or alveoli (emphysema) that cause persistent, often progressive, airflow obstruction. The main symptoms of COPD include shortness of breath and a cough, which may or may not produce mucus. COPD progressively worsens, with everyday activities such as walking or dressing becoming difficult. While COPD is incurable, it is preventable and treatable. The two most common types of COPD are emphysema and chronic bronchitis, and have been the two classic COPD phenotypes."}}, {"canonical_name": "cap.", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 50, "members": [{"entity_id": "cap_", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cap.", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Cap."], "contexts": ["chapter reference"]}, {"entity_id": "cap", "book_id": "coloquios_da_orta_1563", "name": "cap", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["cap"], "contexts": ["chapter"]}, {"entity_id": "cap_", "book_id": "polyanthea_medicinal", "name": "cap.", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 48, "variants": ["cap.", "Cap.", "Cap. LIII", "Cap. LXXXV.", "Cap.CIX", "Cap.CXII", "Tr.2.Cap.57.1.1", "Tr.2.Cap.58.n.3", "Tr.2.Cap.74.n. 1. p.405", "Tr.3.cap. 1 1.61 . p. 710", "Tr.3.cap.1", "Tratado II. Cap. CXXXII.", "Tratado II. Cap. LI.", "Tratado II. Cap. LVI.", "Tratado II. Cap. LXV.", "Tratado II. Cap. XXXXIII.", "Tratado II.Cap. 94. fol .", "Tratado III. Cap. IV. num. 48", "adcap.48. lib. 1.", "cap. 10.", "cap. 12", "cap. 15.", "cap. 23.", "cap. 3.mihi fol . 13.", "cap. 4.", "cap.3.mihifol.", "cap.4.", "cap.4. n. 94. p. 754", "cap.7.fol. 221.", "cap.8.", "lib. 1.cap. 10."], "contexts": ["chapter", "book chapter or section indicator"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cap.", "target_book": "coloquios_da_orta_1563", "target_name": "cap", "similarity": 0.901}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cap.", "target_book": "polyanthea_medicinal", "target_name": "cap.", "similarity": 0.982}, {"source_book": "coloquios_da_orta_1563", "source_name": "cap", "target_book": "polyanthea_medicinal", "target_name": "cap.", "similarity": 0.928}], "id": 874, "stable_key": "clu_4aaf317deaea3431", "ground_truth": {"modern_name": "chapter", "confidence": "high", "type": "object", "wikidata_id": "Q88392887", "wikidata_description": "part that a work consists of (use a more specific object if possible)"}}, {"canonical_name": "nariz", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 49, "members": [{"entity_id": "narizes", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "narizes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["narizes"], "contexts": ["nose", "blood flow from noses"]}, {"entity_id": "narizes", "book_id": "historia_medicinal_monardes_1574", "name": "narizes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["narizes"], "contexts": ["nostrils"]}, {"entity_id": "nariz", "book_id": "polyanthea_medicinal", "name": "nariz", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 44, "variants": ["nariz", "NARIS", "naris", "narize", "narizes"], "contexts": ["where flesh excrescences grow", "body part affected by spots"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "narizes", "target_book": "historia_medicinal_monardes_1574", "target_name": "narizes", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "narizes", "target_book": "polyanthea_medicinal", "target_name": "nariz", "similarity": 0.963}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "narizes", "target_book": "polyanthea_medicinal", "target_name": "nariz", "similarity": 0.963}], "id": 875, "stable_key": "clu_f1301c11ae3ddab7", "ground_truth": {"modern_name": "Nose", "confidence": "high", "type": "anatomy", "description": "The part of the face used for smelling and breathing.", "wikipedia_extract": "A nose is a sensory organ and respiratory structure in vertebrates. It consists of a nasal cavity inside the head, and an external nose on the face. The external nose houses the nostrils, or nares, a pair of tubes providing airflow through the nose for respiration. Where the nostrils pass through the nasal cavity they widen, are known as nasal fossae, and contain turbinates and olfactory mucosa. The nasal cavity also connects to the paranasal sinuses (dead-end air cavities for pressure buffering and humidification). From the nasal cavity, the nostrils continue into the pharynx, a switch track valve connecting the respiratory and digestive systems."}}, {"canonical_name": "Laplace", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 49, "members": [{"entity_id": "laplace", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Laplace", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Laplace"], "contexts": ["author of 'Essai philosophique sur les probabilit\u00e9s'"]}, {"entity_id": "laplace", "book_id": "kosmos_humboldt_1845", "name": "Laplace", "category": "PERSON", "subcategory": "SCHOLAR", "count": 26, "variants": ["Laplace"], "contexts": ["author of 'L'Exposition du Syst\u00e8me du Monde'", "scientist known for work on mechanics"]}, {"entity_id": "la_place", "book_id": "kosmos_humboldt_1845", "name": "La Place", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["La Place"], "contexts": ["mutual friend, scientist"]}, {"entity_id": "la_place", "book_id": "connexion_physical_sciences_somerville_1858", "name": "La Place", "category": "PERSON", "subcategory": "SCHOLAR", "count": 21, "variants": ["La Place"], "contexts": ["proved stability of solar system", "established principle for secular variations in orbits"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Laplace", "target_book": "kosmos_humboldt_1845", "target_name": "Laplace", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "La Place", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "La Place", "similarity": 1.0}], "id": 876, "stable_key": "clu_6ed0019a024e8252", "ground_truth": {"modern_name": "Pierre-Simon Laplace", "confidence": "high", "type": "person", "birth_year": 1749, "death_year": 1827, "description": "Mathematician and astronomer, developed probability theory.", "wikidata_id": "Q44481", "wikidata_description": "French mathematician and astronomer (1749\u20131827)", "wikipedia_url": "https://en.wikipedia.org/wiki/Pierre-Simon%20Laplace", "wikipedia_extract": "Pierre-Simon, Marquis de Laplace (; French: [pj\u025b\u0281 sim\u0254\u0303 laplas]; 23 March 1749 \u2013 5 March 1827) was a French polymath, a scholar whose work has been instrumental in the fields of physics, astronomy, mathematics,  engineering, statistics, and philosophy. He summarized and extended the work of his predecessors in his five-volume M\u00e9canique c\u00e9leste (Celestial Mechanics) (1799\u20131825). This work translated the geometric study of classical mechanics to one based on calculus, opening up a broader range of problems. Laplace also popularized and further confirmed Sir Isaac Newton's work. In statistics, the Bayesian interpretation of probability was developed mainly by Laplace. Laplace formulated Laplace's equation, and pioneered the Laplace transform which appears in many branches of mathematical physics, a field that he took a leading role in forming."}}, {"canonical_name": "nervous system", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 48, "members": [{"entity_id": "syst\u00e8me_nerveux", "book_id": "medecine_experimentale_bernard_1865", "name": "syst\u00e8me nerveux", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 9, "variants": ["syst\u00e8me nerveux"], "contexts": ["network of nerves and nerve cells", "network of nerves and cells"]}, {"entity_id": "nervous_system", "book_id": "principles_of_psychology_james_1890", "name": "nervous system", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 31, "variants": ["Nervous System", "nervous system"], "contexts": ["biological system", "network of nerves and cells"]}, {"entity_id": "nervous_systems", "book_id": "principles_of_psychology_james_1890", "name": "nervous systems", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["nervous systems"], "contexts": ["network of nerves"]}, {"entity_id": "nervous_system", "book_id": "first_principles_spencer_1862", "name": "nervous system", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 7, "variants": ["nervous system"], "contexts": ["system controlling bodily actions", "network of nerves and nerve cells"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "syst\u00e8me nerveux", "target_book": "principles_of_psychology_james_1890", "target_name": "nervous system", "similarity": 0.972}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "syst\u00e8me nerveux", "target_book": "principles_of_psychology_james_1890", "target_name": "nervous systems", "similarity": 0.966}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "syst\u00e8me nerveux", "target_book": "first_principles_spencer_1862", "target_name": "nervous system", "similarity": 0.972}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nervous system", "target_book": "first_principles_spencer_1862", "target_name": "nervous system", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nervous systems", "target_book": "first_principles_spencer_1862", "target_name": "nervous system", "similarity": 0.988}], "id": 877, "stable_key": "clu_393fae746481d9dc", "ground_truth": {"modern_name": "Nervous system", "confidence": "high", "type": "concept", "note": "This refers to the biological system responsible for transmitting signals.", "wikidata_id": "Q3339235", "wikidata_description": "disease of an anatomical entity located in the central or peripheral nervous system"}}, {"canonical_name": "glass", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count