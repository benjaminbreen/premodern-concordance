me": "Alps", "target_book": "polyanthea_medicinal", "target_name": "Alpes", "similarity": 0.897}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Alps", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Alps", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Alpes", "target_book": "polyanthea_medicinal", "target_name": "Alpes", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Alpes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Alps", "similarity": 0.897}, {"source_book": "polyanthea_medicinal", "source_name": "Alpes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Alps", "similarity": 0.897}], "id": 128, "stable_key": "clu_42b5980342290a89", "ground_truth": {"modern_name": "Alps", "confidence": "high", "type": "place", "description": "Major European mountain range, notable for its arctic fauna and flora.", "wikipedia_extract": "The Alps () are some of the highest and most extensive mountain ranges in Europe, stretching approximately 1,200 km (750 mi) across eight Alpine countries (from west to east): Monaco, France, Switzerland, Italy, Liechtenstein, Germany, Austria, Slovenia, and Hungary. The Alpine arch extends from Nice on the western Mediterranean to Trieste on the Adriatic and Vienna at the beginning of the Pannonian Basin. The mountains were formed over tens of millions of years as the African and Eurasian tectonic plates collided. Extreme shortening  caused by the event resulted in marine sedimentary rocks rising by thrusting and folding into high mountain peaks such as Mont Blanc and the Matterhorn. Mont Blanc spans the French-Italian border, and at 4,809 m (15,778 ft) is the highest mountain in the Alps. The Alpine region area contains 82 peaks higher than 4,000 m (13,000 ft)."}}, {"canonical_name": "quarz", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 5, "total_mentions": 36, "members": [{"entity_id": "quartz", "book_id": "epoques_nature_buffon_1778", "name": "quartz", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["quartz"], "contexts": ["crystalline mineral", "mineral found in rocks"]}, {"entity_id": "quarz", "book_id": "relation_historique_humboldt_vol3_1825", "name": "quarz", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 15, "variants": ["quarz"], "contexts": ["grains suspended in the atmosphere", "mineral found in veins"]}, {"entity_id": "quartz", "book_id": "kosmos_humboldt_1845", "name": "quartz", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 9, "variants": ["quartz"], "contexts": ["heterogeneous substance in pendulum experiments", "round blocks"]}, {"entity_id": "quartz", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Quartz", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["Quartz", "quartz"], "contexts": ["positive crystal with one optic axis", "crystal with optical properties"]}, {"entity_id": "quartz", "book_id": "first_principles_spencer_1862", "name": "quartz", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["quartz"], "contexts": ["hard crystalline mineral", "mineral component of granite"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "quartz", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "quarz", "similarity": 0.955}, {"source_book": "epoques_nature_buffon_1778", "source_name": "quartz", "target_book": "kosmos_humboldt_1845", "target_name": "quartz", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "quartz", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Quartz", "similarity": 0.978}, {"source_book": "epoques_nature_buffon_1778", "source_name": "quartz", "target_book": "first_principles_spencer_1862", "target_name": "quartz", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "quarz", "target_book": "kosmos_humboldt_1845", "target_name": "quartz", "similarity": 0.955}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "quarz", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Quartz", "similarity": 0.942}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "quarz", "target_book": "first_principles_spencer_1862", "target_name": "quartz", "similarity": 0.955}, {"source_book": "kosmos_humboldt_1845", "source_name": "quartz", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Quartz", "similarity": 0.978}, {"source_book": "kosmos_humboldt_1845", "source_name": "quartz", "target_book": "first_principles_spencer_1862", "target_name": "quartz", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Quartz", "target_book": "first_principles_spencer_1862", "target_name": "quartz", "similarity": 0.978}], "id": 129, "stable_key": "clu_8f456b48926d6796", "ground_truth": {"modern_name": "Quartz", "confidence": "high", "type": "mineral", "wikidata_id": "Q43010", "wikidata_description": "mineral made of silicon and oxygen", "wikipedia_url": "https://en.wikipedia.org/wiki/Quartz", "note": "The term 'quarz' is a variant spelling. 'quartzose' refers to material composed of quartz.", "wikipedia_extract": "Quartz is a hard mineral composed of silica (silicon dioxide). Its atoms are linked in a continuous framework of SiO4 silicon\u2013oxygen tetrahedra, with each oxygen atom being shared between two tetrahedra, giving an overall chemical formula of SiO2. Therefore, quartz is classified structurally as a framework silicate mineral and compositionally as an oxide mineral. Quartz is the second most common mineral or mineral group in Earth's lithosphere, comprising about 12% by mass. Quartz exists in two forms, the normal \u03b1-quartz and the high-temperature \u03b2-quartz, both of which are chiral. The transformation from \u03b1-quartz to \u03b2-quartz takes place abruptly at 573 \u00b0C (846 K; 1,063 \u00b0F)."}}, {"canonical_name": "materia", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 5, "total_mentions": 35, "members": [{"entity_id": "mati\u00e8re", "book_id": "medecine_experimentale_bernard_1865", "name": "mati\u00e8re", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["mati\u00e8re"], "contexts": ["physical substance", "outside of matter"]}, {"entity_id": "mati\u00e8re", "book_id": "epoques_nature_buffon_1778", "name": "mati\u00e8re", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 9, "variants": ["mati\u00e8re"], "contexts": ["fundamental constituent of the universe", "fundamental stuff of the universe"]}, {"entity_id": "materia", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "materia", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["materia"], "contexts": ["matter in wounds cleaned by oil", "pus or exudate"]}, {"entity_id": "materia", "book_id": "historia_medicinal_monardes_1574", "name": "materia", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["materia"], "contexts": ["bodily substance"]}, {"entity_id": "materia", "book_id": "polyanthea_medicinal", "name": "materia", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 17, "variants": ["materia", "materia azeda", "materia fuligino\u017fa", "materia fumofa", "materiada", "materias cruas", "materias virulentas", "materias vi\u017fco\u017fas"], "contexts": ["subject matter", "substance to be evacuated"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "mati\u00e8re", "target_book": "epoques_nature_buffon_1778", "target_name": "mati\u00e8re", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_