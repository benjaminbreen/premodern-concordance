"category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "musica", "book_id": "polyanthea_medicinal", "name": "musica", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["musica"], "contexts": ["remedy for tarantula bites"]}, {"entity_id": "musical_instruments", "book_id": "connexion_physical_sciences_somerville_1858", "name": "musical instruments", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 4, "variants": ["musical instruments"], "contexts": ["various musical instruments produce sound", "imitating articulation"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "musica", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "musical instruments", "similarity": 0.881}], "id": 3841, "stable_key": "clu_6574ee2b803b2077", "ground_truth": {"modern_name": "Musical instruments", "confidence": "high", "type": "object", "wikidata_id": "Q67429143", "wikidata_description": "curatorial department of The Metropolitan Museum of Art in New York, USA"}}, {"canonical_name": "Kepler\u2019s law", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "kepler\u2019s_law", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Kepler\u2019s law", "category": "CONCEPT", "subcategory": "THEORY", "count": 4, "variants": ["Kepler\u2019s law"], "contexts": ["law relating planetary orbits and periods", "law relating planetary orbital periods and distances"]}, {"entity_id": "kepler\u2019s_laws", "book_id": "first_principles_spencer_1862", "name": "Kepler\u2019s laws", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["Kepler\u2019s laws"], "contexts": ["laws describing planetary motion"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Kepler\u2019s law", "target_book": "first_principles_spencer_1862", "target_name": "Kepler\u2019s laws", "similarity": 0.934}], "id": 3842, "stable_key": "clu_f140219e8f3d1ced", "ground_truth": {"modern_name": "Kepler's laws", "confidence": "high", "type": "concept", "wikidata_id": "Q83219", "wikidata_description": "\u0938\u0942\u0930\u094d\u092f \u0915\u0947 \u091a\u093e\u0930\u094b\u0902 \u0913\u0930 \u0917\u094d\u0930\u0939\u094b\u0902 \u0915\u0940 \u0917\u0924\u093f \u0915\u093e \u0935\u0930\u094d\u0923\u0928 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915 \u0928\u093f\u092f\u092e", "wikipedia_url": "https://en.wikipedia.org/wiki/Kepler%27s%20laws%20of%20planetary%20motion", "wikipedia_extract": "In astronomy, Kepler's laws of planetary motion give good approximations for the orbits of planets around the Sun. They were published by Johannes Kepler from 1608-1621 in three works Astronomia nova, Harmonice Mundi and Epitome Astronomiae Copernicanae. The laws were based on Kepler's concept of solar fibrils adapted to the accurate astronomical data of Tycho Brahe. These laws replaced the circular orbits and epicycles of Copernicus's heliostatic model of the planets with a heliocentric model that described elliptical orbits with planetary velocities that vary accordingly. The three laws state that: The orbit of a planet is an ellipse with the Sun at one of the two foci. A line segment joining a planet and the Sun sweeps out equal areas during equal intervals of time."}}, {"canonical_name": "planetary motions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "planetary_motions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "planetary motions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["planetary motions"], "contexts": ["movements of planets", "estimated from venial point"]}, {"entity_id": "astronomical_motion", "book_id": "first_principles_spencer_1862", "name": "astronomical motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["astronomical motion"], "contexts": ["origin of tides"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "planetary motions", "target_book": "first_principles_spencer_1862", "target_name": "astronomical motion", "similarity": 0.897}], "id": 3843, "stable_key": "clu_15c6dd1c1e3e884e", "ground_truth": {"modern_name": "Planetary motion", "confidence": "high", "type": "concept", "wikidata_id": "Q125378310", "wikidata_description": "scientific article published in 2013"}}, {"canonical_name": "planetary orbits", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "planetary_orbits", "book_id": "connexion_physical_sciences_somerville_1858", "name": "planetary orbits", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["planetary orbits"], "contexts": ["paths of planets around a star", "excentricity measured"]}, {"entity_id": "orbit-plane", "book_id": "first_principles_spencer_1862", "name": "orbit-plane", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["orbit-plane"], "contexts": ["plane of a celestial body's orbit"]}, {"entity_id": "planetary_axes", "book_id": "first_principles_spencer_1862", "name": "planetary axes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["planetary axes"], "contexts": ["rotation axes of planets"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "planetary orbits", "target_book": "first_principles_spencer_1862", "target_name": "orbit-plane", "similarity": 0.911}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "planetary orbits", "target_book": "first_principles_spencer_1862", "target_name": "planetary axes", "similarity": 0.88}], "id": 3844, "stable_key": "clu_f34de6e7a46eab57", "ground_truth": {"modern_name": "Planetary orbit", "confidence": "high", "type": "concept", "note": "The term 'planetary axes' in this context likely refers to the orbital plane or axis of rotation of celestial bodies, rather than physical axes.", "wikidata_id": "Q68481392", "wikidata_description": "scholarly article"}}, {"canonical_name": "Greek", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "greek", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Greek", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Greek"], "contexts": ["ancient Indo-European language", "ancient civilization and language"]}, {"entity_id": "greek", "book_id": "first_principles_spencer_1862", "name": "Greek", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Greek"], "contexts": ["civilization period", "ancient civilization known for art"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Greek", "target_book": "first_principles_spencer_1862", "target_name": "Greek", "similarity": 1.0}], "id": 3845, "stable_key": "clu_451098d60ff27967-3", "ground_truth": {"modern_name": "Greece", "confidence": "high", "type": "place", "description": "Southeastern European country, cradle of Western civilization and ancient knowledge.", "note": "Includes references to the Greek language and people.", "wikipedia_extract": "Greece, officially the Hellenic Republic, is a country in Southeast Europe. Located on the southern tip of the Balkan peninsula, it shares land borders with Albania to the northwest, North Macedonia and Bulgaria to the north, and Turkey to the east. The Aegean Sea lies to the east of the mainland, the Ionian Sea to the west, and the Sea of Crete and the Mediterranean Sea to the south. Greece has the longest coastline on the Mediterranean basin, spanning thousands of islands and nine traditional geographic regions. It has a population of over 10 million. Athens is the nation's capital and largest city, followed by Thessaloniki and Patras."}}, {"canonical_name": "dancing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "dancing", "book_id": "connexion_physical_sciences_somerville_1858", "name": "dancing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dancing"], "contexts": ["rhythmic movement"]}, {"entity_id": "dancing", "book_id": "first_principles_spencer_1862", "name": "dancing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Dancing", "dancing"], "contexts": ["art form originating from rhythm in motion", "art form"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "dancing", "target_book": "first_principles_spencer_1862", "target_name": "dancing", "similarity": 1.0}], "id": 3846, "stable_key": "clu_6168adc466d86210", "ground_truth": {"modern_name": "dancing", "confidence": "high", "type": "concept", "wikipedia_extract": "Dance is an art form, consisting of sequences of body movements with aesthetic and often symbolic value, either improvised or purposefully selected. Dance can be categorized and described by its choreography, by its repertoire of movements or by its historical period or place of origin. Dance is typically performed with musical accompaniment, and sometimes with the dancer simultaneously using a musical instrument themselves. Two common types of group dance are theatrical and participatory dance. Both types of dance may have special functions, whether social, ceremonial, competitive, erotic, martial, sacred or liturgical. Dance is not solely restricted to performance, as dance is used as a form of exercise and occasionally training for other sports and activities."}}, {"canonical_name": "incandescence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "incandescence_g\u00e9n\u00e9rale", "book_id": "epoques_nature_buffon_1778", "name": "incandescence g\u00e9n\u00e9rale", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["incandescence g\u00e9n\u00e9rale"], "contexts": ["theory of general incandescence of planets"]}, {"entity_id": "incandescence", "book_id": "first_principles_spencer_1862", "name": "incandescence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["incandescence"], "contexts": ["state of glowing with heat", "glowing from heat"]}, {"entity_id": "incandescence", "book_id": "epoques_nature_buffon_1778", "name": "incandescence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["incandescence"], "contexts": ["incandescence"]}, {"entity_id": "incandescent", "book_id": "first_principles_spencer_1862", "name": "incandescent", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["incandescent"], "contexts": ["glowing with heat"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "incandescence g\u00e9n\u00e9rale", "target_book": "first_principles_spencer_1862", "target_name": "incandescence", "similarity": 0.901}, {"source_book": "epoques_nature_buffon_1778", "source_name": "incandescence", "target_book": "first_principles_spencer_1862", "target_name": "incandescent", "similarity": 0.907}], "id": 3847, "stable_key": "clu_d6cb58dd1b2eccdd", "ground_truth": {"modern_name": "Incandescence", "confidence": "high", "type": "concept", "wikidata_id": "Q877096", "wikidata_description": "emission of electromagnetic radiation (including visible light) from a hot body as a result of its temperature", "wikipedia_url": "https://en.wikipedia.org/wiki/Incandescence"}}, {"canonical_name": "m\u00e9dicos indios", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "m\u00e9dicos_indios", "book_id": "quatro_libr