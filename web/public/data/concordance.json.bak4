ts": ["origin of bat species", "relating to North America"]}, {"entity_id": "north-american", "book_id": "first_principles_spencer_1862", "name": "North-American", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["North-American"], "contexts": ["geographic origin of certain tongues"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Am\u00e9rique", "target_book": "origin_of_species_darwin_1859", "target_name": "North American", "similarity": 0.927}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Am\u00e9rique", "target_book": "first_principles_spencer_1862", "target_name": "North-American", "similarity": 0.928}, {"source_book": "origin_of_species_darwin_1859", "source_name": "North American", "target_book": "first_principles_spencer_1862", "target_name": "North-American", "similarity": 0.993}], "id": 1834, "stable_key": "clu_3761b80cf6d4e89d-2", "ground_truth": {"modern_name": "North America", "confidence": "high", "type": "place", "country": "North America", "wikidata_id": "Q502117", "wikidata_description": "1940 bomber aircraft family", "wikipedia_url": "https://en.wikipedia.org/wiki/North%20American%20B-25%20Mitchell", "wikipedia_extract": "The North American B-25 Mitchell is an American medium bomber that was introduced in 1941 and named in honor of Brigadier General William \"Billy\" Mitchell, a pioneer of U.S. military aviation. Used by many Allied air forces, the B-25 served in every theater of World War II, and after the war ended, many remained in service, operating across four decades. Produced in numerous variants, nearly 10,000 B-25s were built. It was the most-produced American medium bomber and the third-most-produced American bomber overall. These included several limited models such as the F-10 reconnaissance aircraft, the AT-24 crew trainer, and the United States Marine Corps' PBJ-1 patrol bomber."}}, {"canonical_name": "fibrine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "fibrine", "book_id": "medecine_experimentale_bernard_1865", "name": "fibrine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["fibrine"], "contexts": ["substance that coagulates"]}, {"entity_id": "fibrine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "fibrine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["fibrine"], "contexts": ["fibrin suspended in plant milk", "component of plant sap, nutritive property"]}, {"entity_id": "fibrine", "book_id": "first_principles_spencer_1862", "name": "Fibrine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Fibrine"], "contexts": ["intricate organic compound with many atoms"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "fibrine", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "fibrine", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "fibrine", "target_book": "first_principles_spencer_1862", "target_name": "Fibrine", "similarity": 0.995}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "fibrine", "target_book": "first_principles_spencer_1862", "target_name": "Fibrine", "similarity": 0.995}], "id": 1835, "stable_key": "clu_8b0d4c007f0d1c6b", "ground_truth": {"modern_name": "fibrin", "confidence": "high", "type": "chemical", "wikidata_id": "Q101562273", "wikidata_description": "chemical compound"}}, {"canonical_name": "rationality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "rationalisme", "book_id": "medecine_experimentale_bernard_1865", "name": "rationalisme", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["rationalisme"], "contexts": ["approach to scientific facts"]}, {"entity_id": "rationality", "book_id": "principles_of_psychology_james_1890", "name": "rationality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["rationality"], "contexts": ["quality of being reasonable", "quality of being logical or reasonable"]}, {"entity_id": "rationalism", "book_id": "first_principles_spencer_1862", "name": "rationalism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["rationalism"], "contexts": ["intellectual movement emphasizing reason"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "rationalisme", "target_book": "principles_of_psychology_james_1890", "target_name": "rationality", "similarity": 0.894}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "rationalisme", "target_book": "first_principles_spencer_1862", "target_name": "rationalism", "similarity": 0.993}, {"source_book": "principles_of_psychology_james_1890", "source_name": "rationality", "target_book": "first_principles_spencer_1862", "target_name": "rationalism", "similarity": 0.912}], "id": 1836, "stable_key": "clu_64d8a64bd668f3ab-2", "ground_truth": {"modern_name": "rationality", "confidence": "high", "type": "concept", "wikidata_id": "Q938185", "wikidata_description": "quality of being agreeable to reason"}}, {"canonical_name": "Superstition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "superstition", "book_id": "medecine_experimentale_bernard_1865", "name": "superstition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["superstition"], "contexts": ["irrational belief or practice"]}, {"entity_id": "superstition", "book_id": "english_physician_1652", "name": "Superstition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Superstition"], "contexts": ["reason for herb naming", "monster obscuring knowledge"]}, {"entity_id": "superstition", "book_id": "first_principles_spencer_1862", "name": "superstition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["superstition"], "contexts": ["irrational belief"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "superstition", "target_book": "english_physician_1652", "target_name": "Superstition", "similarity": 0.99}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "superstition", "target_book": "first_principles_spencer_1862", "target_name": "superstition", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Superstition", "target_book": "first_principles_spencer_1862", "target_name": "superstition", "similarity": 0.99}], "id": 1837, "stable_key": "clu_73ebd8033e52f89b", "ground_truth": {"modern_name": "Superstition", "confidence": "high", "type": "concept", "wikidata_id": "Q133182", "wikidata_description": "belief in irrational supernatural causality", "wikipedia_url": "https://en.wikipedia.org/wiki/Superstition", "wikipedia_extract": "A superstition is any belief or practice considered by non-practitioners to be irrational or supernatural. It is commonly applied to beliefs and practices surrounding luck, fate, magic, amulets, astrology, fortune telling, spirits, and certain paranormal entities, particularly the belief that future events can be foretold by specific unrelated prior events. The word superstition is also used to refer to a religion not practiced by the majority of a given society regardless of whether the prevailing religion contains alleged superstitions or to all religions by the antireligious. Definitions of the term vary, but superstitions are commonly described as irrational beliefs at odds with scientific knowledge of the world. Stuart Vyse proposes that a superstition's \"presumed mechanism of action is inconsistent with our understanding of the physical world\", with Jane Risen adding that these beliefs are not merely scientifically wrong but impossible. Similarly, Lysann Damisch defines superstition as \"irrational  beliefs that an object, action, or circumstance that is not logically related to a course of events influences its outcome.\" Dale Martin says that superstitions \"presuppose an erroneous understanding about cause and effect, that have been rejected by modern science.\" The Oxford English Dictionary describes them as \"irrational, unfounded\", Merriam-Webster as \"a false conception about causation or belief or practice\", and the Cambridge Dictionary as \"sans grounding in human reason or scientific knowledge\"."}}, {"canonical_name": "human reason", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "raison_humaine", "book_id": "medecine_experimentale_bernard_1865", "name": "raison humaine", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["raison humaine"], "contexts": ["human capacity for thought"]}, {"entity_id": "human_reason", "book_id": "origin_of_species_darwin_1859", "name": "human reason", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human reason"], "contexts": ["capacity for logical thought"]}, {"entity_id": "human_reason", "book_id": "connexion_physical_sciences_somerville_1858", "name": "human reason", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["human reason"], "contexts": ["instrument for demonstrating existence", "instrument for demonstration and analysis"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "raison humaine", "target_book": "origin_of_species_darwin_1859", "target_name": "human reason", "similarity": 0.967}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "raison humaine", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "human reason", "similarity": 0.967}, {"source_book": "origin_of_species_darwin_1859", "source_name": "human reason", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "human reason", "similarity": 1.0}], "id": 1838, "stable_key": "clu_e7b4b42afb83b1bd", "ground_truth": {"modern_name": "human reason", "confidence": "high", "type": "concept", "wikidata_id": "Q52287144", "wikidata_description": "scientific article published in July 1982"}}, {"canonical_name": "electrical phenomena", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "ph\u00e9nom\u00e8nes_\u00e9lectriques", "book_id": "medecine_experimentale_bernard_1865", "name": "ph\u00e9nom\u00e8nes \u00e9lectriques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ph\u00e9nom\u00e8nes \u00e9lectriques"], "contexts": ["electrical phenomena"]}, {"entity_id": "electric_phenomena", "book_id": "kosmos_humboldt_1845", "name": "electric phenomena", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["electric phenomena"], "contexts": ["phenomena related to electricity"]}, {"entity_id": "electrical_phenomena", "book_id": "connexion_physical_sciences_somerville_1858", "name": "electrical phenomena", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["electrical phenomena"], "contexts": ["observable effects of electricity", "phenomena related to electricity"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "ph\u00e9nom\u00e8nes \u00e9lectriques", "target_book": "kosmos_humboldt_1845", "target_name": "electric phenomena", "similarity": 0.972}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "ph\u00e9nom\u00e8nes \u00e9lectriques", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electrical phenomena", "similarity": 0.969}, {"source_book": "kosmos_humboldt_1845", "source_name": "electric phenomena", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electrical phenomena", "similarity": 0.99}], "id": 1839, "stable_key": "clu_a27d0dfa3eef68e2", "ground_truth": {"modern_name": "Electrical phenomena", "confidence": "high", "type": "concept", "wikidata_id": "Q3405599", "wikidata_description": "physical phenomenon involving electricity", "wikipedia_url": "https://en.wikipedia.org/wiki/List%20of%20electrical%20phenomena", "wikipedia_extract": "This is a list of electrical phenomena. Electrical phenomena are a somewhat arbitrary division of electromagnetic phenomena. Biefeld\u2013Brown effect \u2014 Thought by the person who coined the name, Thomas Townsend Brown, to be an anti-gravity effect, it is generally attributed to electrohydrodynamics (EHD) or sometimes electro-fluid-dynamics, a counterpart to the well-known magneto-hydrodynamics. Bioelectrogenesis \u2014 The generation of electricity by living organisms. Capacitive coupling \u2014 Transfer of energy within an electrical network or between distant networks by means of displacement current. Contact electrification \u2014 The phenomenon of electrification by contact."}}, {"canonical_name": "Columella", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "columella", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Columella", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Columella"], "contexts": ["Roman writer on agriculture", "ancient writer on agriculture"]}, {"entity_id": "columela", "book_id": "historia_medicinal_monardes_1574", "name": "Columela", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Columela"], "contexts": ["ancient authority on plants and medicine"]}, {"entity_id": "columella", "book_id": "coloquios_da_orta_1563", "name": "Columella", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Columella"], "contexts": ["ancient author"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Columella", "target_book": "historia_medicinal_monardes_1574", "target_name": "Columela", "similarity": 0.882}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Columella", "target_book": "coloquios_da_orta_1563", "target_name": "Columella", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Columela", "target_book": "coloquios_da_orta_1563", "target_name": "Columella", "similarity": 0.882}], "id": 1840, "stable_key": "clu_7415d47257b2641d", "ground_truth": {"modern_name": "Columella", "confidence": "high", "type": "person", "birth_year": 4, "death_year": 70, "description": "Roman writer on agriculture, author of De Re Rustica"}}, {"canonical_name": "Apostles", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "apostles", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Apostles", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Apostles"], "contexts": ["miracles counterfeited by the subject", "religious figures used for plant names"]}, {"entity_id": "ap\u00f4tres", "book_id": "relation_historique_humboldt_vol3_1825", "name": "ap\u00f4tres", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["ap\u00f4tres"], "contexts": ["characters in procession"]}, {"entity_id": "apostles", "book_id": "first_principles_spencer_1862", "name": "apostles", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["apostles"], "contexts": ["religious subject in art"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Apostles", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "ap\u00f4tres", "similarity": 0.955}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Apostles", "target_book": "first_principles_spencer_1862", "target_name": "apostles", "similarity": 0.996}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "ap\u00f4tres", "target_book": "first_principles_spencer_1862", "target_name": "apostles", "similarity": 0.96}], "id": 1841, "stable_key": "clu_a57b69c301b7daae", "ground_truth": {"modern_name": "Apostles", "confidence": "high", "type": "person", "description": "Disciples of Jesus Christ, significant religious figures in Christianity.", "wikidata_id": "Q16167540", "wikidata_description": "Twelve marble sculptures located in the Church of San Pietro in Oliveto"}}, {"canonical_name": "Ferrara", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "ferrara", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ferrara", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Ferrara"], "contexts": ["Italian city, seat of Duke Alphonsus", "territory where misseltoe was absent"]}, {"entity_id": "ferrara", "book_id": "coloquios_da_orta_1563", "name": "Ferrara", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Ferrara"], "contexts": ["city where a lie was told"]}, {"entity_id": "ferrara", "book_id": "polyanthea_medicinal", "name": "Ferrara", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Ferrara"], "contexts": ["city associated with the Duke"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ferrara", "target_book": "coloquios_da_orta_1563", "target_name": "Ferrara", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ferrara", "target_book": "polyanthea_medicinal", "target_name": "Ferrara", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Ferrara", "target_book": "polyanthea_medicinal", "target_name": "Ferrara", "similarity": 1.0}], "id": 1842, "stable_key": "clu_dac12304fb30d629", "ground_truth": {"wikipedia_extract": "Ferrara (; Italian: [fer\u02c8ra\u02d0ra] ; Emilian: Fr\u00e0ra [\u02c8fra\u02d0ra]) is a city and comune (municipality) in Emilia-Romagna, Northern Italy, capital of the province of Ferrara. As of 2016, it had 132,009 inhabitants. It is situated 44 kilometres (27 miles) northeast of Bologna, on the Po di Volano, a branch channel of the main stream of the Po River, located 5 km (3 miles) north. The town has broad streets and numerous palaces dating from the Renaissance, when it hosted the court of the House of Este. For its beauty and cultural importance, it has been designated by UNESCO as a World Heritage Site. The first documented settlements in the area of the present-day Province of Ferrara date from the 6th century BC."}}, {"canonical_name": "Emerald", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "emerald", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Emerald", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Emerald"], "contexts": ["stone that breaks during copulation", "gem"]}, {"entity_id": "emerald", "book_id": "kosmos_humboldt_1845", "name": "emerald", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["emerald"], "contexts": ["stone from which obelists were cut"]}, {"entity_id": "emerald", "book_id": "connexion_physical_sciences_somerville_1858", "name": "emerald", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["emerald"], "contexts": ["negative crystal with two optic axes"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Emerald", "target_book": "kosmos_humboldt_1845", "target_name": "emerald", "similarity": 0.98}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Emerald", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "emerald", "similarity": 0.98}, {"source_book": "kosmos_humboldt_1845", "source_name": "emerald", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "emerald", "similarity": 1.0}], "id": 1843, "stable_key": "clu_f15edf28cbbd7160-2", "ground_truth": {"modern_name": "Emerald", "confidence": "high", "type": "mineral", "wikidata_id": "Q43513", "wikidata_description": "city in and county seat of King County, State of Washington, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Emerald", "wikipedia_extract": "Emerald is a gemstone and a variety of the mineral beryl (Be3Al2(SiO3)6) colored green by trace amounts of chromium or sometimes vanadium. Beryl has a hardness of 7.5\u20138 on the Mohs scale. Most emeralds have many inclusions, so their toughness (resistance to breakage) is classified as generally poor. Emerald is a cyclosilicate. It occurs mainly in association with quartz, muscovite, albite, schorl, microcline, fluorite, smoky quartz and elbaite. The word \"emerald\" is derived (via Old French: esmeraude and Middle English: emeraude), from Vulgar Latin: esmaralda/esmaraldus, a variant of Latin smaragdus, which was via Ancient Greek: \u03c3\u03bc\u03ac\u03c1\u03b1\u03b3\u03b4\u03bf\u03c2 (sm\u00e1ragdos; \"green gem\")."}}, {"canonical_name": "fallar", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "fall", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Fall", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Fall"], "contexts": ["event of human and angelic sin"]}, {"entity_id": "fallar", "book_id": "polyanthea_medicinal", "name": "fallar", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["fallar"], "contexts": ["speaking"]}, {"entity_id": "falling", "book_id": "connexion_physical_sciences_somerville_1858", "name": "falling", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["falling"], "contexts": ["action causing loss of paramagnetism"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Fall", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "falling", "similarity": 0.853}, {"source_book": "polyanthea_medicinal", "source_name": "fallar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "falling", "similarity": 0.914}], "id": 1844, "stable_key": "clu_58624fdf5ba87599", "ground_truth": {"modern_name": "Fall", "confidence": "high", "type": "concept", "note": "The context spans religious (sin), physical (falling), and abstract (loss of paramagnetism) meanings of 'fall'.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "", "wikipedia_extract": ""}}, {"canonical_name": "faculty", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "faculty", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "faculty", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["faculty"], "contexts": ["inherent power or capacity"]}, {"entity_id": "faculty", "book_id": "principles_of_psychology_james_1890", "name": "faculty", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["faculty"], "contexts": ["mental capacity or power", "source of perception"]}, {"entity_id": "faculty", "book_id": "first_principles_spencer_1862", "name": "faculty", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["faculty"], "contexts": ["mental ability or capacity"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "faculty", "target_book": "principles_of_psychology_james_1890", "target_name": "faculty", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "faculty", "target_book": "first_principles_spencer_1862", "target_name": "faculty", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "faculty", "target_book": "first_principles_spencer_1862", "target_name": "faculty", "similarity": 1.0}], "id": 1845, "stable_key": "clu_06058e044ea4d434", "ground_truth": {"modern_name": "Faculty", "confidence": "high", "type": "concept", "note": "In early modern philosophy and medicine, 'faculty' referred to an inherent power or capacity of an organ or the mind.", "wikipedia_extract": "A faculty or academic division is an academic and administrative unit within a university or college comprising one subject area or a group of related subject areas, possibly also delimited by level (e.g. undergraduate). In North America, academic divisions are sometimes titled colleges, schools, or departments, with universities occasionally using a mixture of terminology, e.g., Harvard University has a Faculty of Arts and Sciences and a Law School. The medieval University of Bologna, which served as a model for most of the later medieval universities in Europe, had four faculties: students began at the Faculty of Arts, graduates from which could then continue at the higher Faculties of Theology, Law, and Medicine. The privilege to establish these four faculties was usually part of medieval universities' charters, but not every university could do so in practice. The Faculty of Arts took its name from the seven liberal arts: the trivium (grammar, rhetoric, dialectics) and the quadrivium (arithmetic, music, geometry and astronomy).", "wikipedia_url": "https://en.wikipedia.org/wiki/Faculty_(division)"}}, {"canonical_name": "traditions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "tradition", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Tradition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Tradition"], "contexts": ["passing down of beliefs and practices"]}, {"entity_id": "tradition", "book_id": "english_physician_1652", "name": "Tradition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Tradition"], "contexts": ["linked to superstition in naming"]}, {"entity_id": "traditions", "book_id": "first_principles_spencer_1862", "name": "traditions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["traditions"], "contexts": ["customs passed down"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Tradition", "target_book": "english_physician_1652", "target_name": "Tradition", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Tradition", "target_book": "first_principles_spencer_1862", "target_name": "traditions", "similarity": 0.887}, {"source_book": "english_physician_1652", "source_name": "Tradition", "target_book": "first_principles_spencer_1862", "target_name": "traditions", "similarity": 0.887}], "id": 1846, "stable_key": "clu_bf98cfb034384c2c", "ground_truth": {"modern_name": "Tradition", "confidence": "high", "type": "concept"}}, {"canonical_name": "actions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "actions", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Actions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Actions"], "contexts": ["things done or performed"]}, {"entity_id": "actions", "book_id": "principles_of_psychology_james_1890", "name": "actions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["actions"], "contexts": ["things done"]}, {"entity_id": "actions", "book_id": "first_principles_spencer_1862", "name": "actions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["actions"], "contexts": ["things done or performed", "conduct necessitated by surrounding conditions"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Actions", "target_book": "principles_of_psychology_james_1890", "target_name": "actions", "similarity": 0.966}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Actions", "target_book": "first_principles_spencer_1862", "target_name": "actions", "similarity": 0.966}, {"source_book": "principles_of_psychology_james_1890", "source_name": "actions", "target_book": "first_principles_spencer_1862", "target_name": "actions", "similarity": 1.0}], "id": 1847, "stable_key": "clu_6d2387e9d4561b8c-2", "ground_truth": {"modern_name": "action", "confidence": "high", "type": "concept", "wikidata_id": "Q2634111", "wikidata_description": "Dutch multinational variety store chain", "note": "Refers to deliberate actions or behaviors rather than just general acts."}}, {"canonical_name": "proportion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "proportion", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "proportion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["proportion"], "contexts": ["relationship between quantities"]}, {"entity_id": "proportion", "book_id": "polyanthea_medicinal", "name": "proportion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["proportion", "proporcional"], "contexts": ["principle of interaction", "proportional, reasoning in medicine"]}, {"entity_id": "proportion", "book_id": "first_principles_spencer_1862", "name": "proportion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["proportion"], "contexts": ["relationship between quantities"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "proportion", "target_book": "polyanthea_medicinal", "target_name": "proportion", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "proportion", "target_book": "first_principles_spencer_1862", "target_name": "proportion", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "proportion", "target_book": "first_principles_spencer_1862", "target_name": "proportion", "similarity": 1.0}], "id": 1848, "stable_key": "clu_5096f35b4a8d7560", "ground_truth": {"modern_name": "proportion", "confidence": "high", "type": "concept", "wikidata_id": "Q47694", "wikidata_description": "principle of architectural theory that describes the relationships between elements of a design", "wikipedia_url": "https://en.wikipedia.org/wiki/Proportion%20%28architecture%29", "wikipedia_extract": "Proportion is a central principle of architectural theory and an important connection between mathematics and art. It is the visual effect of the relationship of the various objects and spaces that make up a structure to one another and to the whole. These relationships are often governed by multiples of a standard unit of length known as a \"module\". Proportion in architecture was discussed by Vitruvius, Leon Battista Alberti, Andrea Palladio, and Le Corbusier among others. In classical architecture, the module was established as the radius of the lower shaft of a classical column, with proportions expressed as a fraction or multiple of that module. Architecture in Roman antiquity was rarely documented except in Vitruvius' treatise De architectura."}}, {"canonical_name": "Hercra", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "heraiscus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Heraiscus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Heraiscus"], "contexts": ["famous scholar of former ages"]}, {"entity_id": "hercra", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Hercra", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Hercra", "Hcrcra"], "contexts": ["historian of the Indies", "author of historical work"]}, {"entity_id": "herne\u017fto", "book_id": "polyanthea_medicinal", "name": "Herne\u017fto", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Herne\u017fto"], "contexts": ["author of tract on antimony"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Heraiscus", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Hercra", "similarity": 0.853}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hercra", "target_book": "polyanthea_medicinal", "target_name": "Herne\u017fto", "similarity": 0.864}], "id": 1849, "stable_key": "clu_3bca53ec2d3e8d4a", "ground_truth": {"modern_name": "Hercra", "confidence": "medium", "type": "person", "description": "Ancient scholar, possibly an historian or alchemist.", "note": "The identification of 'Hercra' and 'Herne\u017fto' with 'Heraiscus' is speculative based on phonetic similarity in historical texts.", "wikidata_id": "Q108624022", "wikidata_description": "Neoplatonist philosopher in Egypt"}}, {"canonical_name": "bitumen", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "bitumen", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Bitumen", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Bitumen"], "contexts": ["tar-like substance"]}, {"entity_id": "bitumen", "book_id": "kosmos_humboldt_1845", "name": "bitumen", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["bitumen"], "contexts": ["product of coal distillation", "substance in volcanic phenomena"]}, {"entity_id": "bitumen", "book_id": "historia_medicinal_monardes_1574", "name": "Bitumen", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Bitumen"], "contexts": ["substance that flows from springs"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bitumen", "target_book": "kosmos_humboldt_1845", "target_name": "bitumen", "similarity": 0.994}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bitumen", "target_book": "historia_medicinal_monardes_1574", "target_name": "Bitumen", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "bitumen", "target_book": "historia_medicinal_monardes_1574", "target_name": "Bitumen", "similarity": 0.994}], "id": 1850, "stable_key": "clu_1765d1b08508ec03-2", "ground_truth": {"modern_name": "Bitumen", "confidence": "high", "type": "mineral", "wikidata_id": "Q167510", "wikidata_description": "form of petroleum primarily used in road construction", "wikipedia_extract": "Shilajit (Sanskrit: \u0936\u093f\u0932\u093e\u091c\u093f\u0924\u094d) or Shilajatu (\u0936\u093f\u0932\u093e\u091c\u0924\u0941; lit. mountain/rock bitumen/lac), is an organic-mineral product of predominantly biological origin, formed at high altitudes on stony mountains, in sheltered crevices and caves. It is a blackish-brown powder or an exudate emerging between high mountain rocks, often found in the Altai Mountains, the Caucasus Mountains, the Himalayas (especially in India, Pakistan, Nepal, and the Tibetan Plateau), the Karakoram, the Pamir Mountains (primarily in Gorno-Badakhshan, Tajikistan), and countrywise in Afghanistan, Bhutan, Georgia, India (regions of Himachal Pradesh and Uttarakhand), Iran, Kyrgyzstan, Mongolia, Nepal, Russia, Central Asia and Africa. People living in these areas use shilajit in folk and non-traditional (alternative) medicine (Ayurveda, Chinese, Tibetan). Shilajit is sold both in dry extract form and in dietary supplements, but there is limited evidence that shilajit has any beneficial effects on human health. Some sources have been found in studies to contain hazardous heavy metals, including lead.", "wikipedia_url": "https://en.wikipedia.org/wiki/Bitumen"}}, {"canonical_name": "Evangelho", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "gospel", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Gospel", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Gospel"], "contexts": ["Christian teachings"]}, {"entity_id": "gospel", "book_id": "english_physician_1652", "name": "Gospel", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Gospel"], "contexts": ["religious doctrine"]}, {"entity_id": "evangelho", "book_id": "polyanthea_medicinal", "name": "Evangelho", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Evangelho"], "contexts": ["religious text", "Gospel, where the story is told"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gospel", "target_book": "english_physician_1652", "target_name": "Gospel", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gospel", "target_book": "polyanthea_medicinal", "target_name": "Evangelho", "similarity": 0.918}, {"source_book": "english_physician_1652", "source_name": "Gospel", "target_book": "polyanthea_medicinal", "target_name": "Evangelho", "similarity": 0.918}], "id": 1851, "stable_key": "clu_fde5f7b4a8a3ff74", "ground_truth": {"modern_name": "Gospel", "confidence": "high", "type": "text", "note": "The Portuguese term 'Evangelho' directly translates to 'Gospel' and is used interchangeably with the English term in the provided contexts.", "wikidata_id": "Q18055855", "wikidata_description": "protein-coding gene in the species Homo sapiens", "wikipedia_extract": "The Gospel of Thomas (also known as the Coptic Gospel of Thomas) is a non-canonical sayings gospel. It was discovered near Nag Hammadi, Egypt, in 1945 among a group of books known as the Nag Hammadi library. Scholars speculate the works were buried in response to a letter from Bishop Athanasius declaring a strict canon of Christian scripture. Most scholars place the composition during the second century, while some have proposed dates as late as 250 AD and others have traced its signs of origins back to 60 AD. Some scholars have seen it as evidence of the existence of a \"Q source\" that might have been similar in its form as a collection of sayings of Jesus, without any accounts of his deeds or his life and death, referred to as a sayings gospel, though most conclude that Thomas depends on or harmonizes the Synoptics. The Coptic-language text, the second of seven contained in what scholars have designated as Nag Hammadi Codex II, comprises 114 sayings attributed to Jesus.", "wikipedia_url": "https://en.wikipedia.org/wiki/Gospel_of_Thomas"}}, {"canonical_name": "Heraclito", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "heraclitus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Heraclitus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Heraclitus"], "contexts": ["ancient philosopher who held the Sun was no bigger than it appeared"]}, {"entity_id": "heraclitus", "book_id": "principles_of_psychology_james_1890", "name": "Heraclitus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Heraclitus"], "contexts": ["ancient philosopher, river analogy"]}, {"entity_id": "heraclito", "book_id": "polyanthea_medicinal", "name": "Heraclito", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Heraclito", "Heraclio"], "contexts": ["ancient philosopher", "Emperor during a plague in Rome"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Heraclitus", "target_book": "principles_of_psychology_james_1890", "target_name": "Heraclitus", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Heraclitus", "target_book": "polyanthea_medicinal", "target_name": "Heraclito", "similarity": 0.977}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Heraclitus", "target_book": "polyanthea_medicinal", "target_name": "Heraclito", "similarity": 0.977}], "id": 1852, "stable_key": "clu_7c37d109d40f72d2", "ground_truth": {"modern_name": "Heraclitus", "confidence": "high", "type": "person", "birth_year": -535, "death_year": -475, "description": "Pre-Socratic Greek philosopher, known for flux and fire.", "wikidata_id": "Q41155", "wikidata_description": "Greek philosopher (late 6th/early 5th-century BC)", "wikipedia_url": "https://en.wikipedia.org/wiki/Heraclitus", "wikipedia_extract": "Heraclitus (; Ancient Greek: \u1f29\u03c1\u03ac\u03ba\u03bb\u03b5\u03b9\u03c4\u03bf\u03c2, romanized: H\u0113r\u00e1kleitos; fl. c. 500 BC) was an ancient Greek pre-Socratic philosopher from the city of Ephesus, which was then part of the Persian Empire. He exerts a wide influence on Western philosophy, both ancient and modern, through the works of such authors as Plato, Aristotle, Georg Wilhelm Friedrich Hegel, Friedrich Nietzsche, and Martin Heidegger. Little is known of Heraclitus's life. He wrote a single work, of which only fragments survive."}}, {"canonical_name": "axis of the earth\u2019s rotation", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "axis_of_the_earth", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Axis of the Earth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Axis of the Earth"], "contexts": ["imaginary line through Earth's poles"]}, {"entity_id": "axis_of_the_earth\u2019s_rotation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "axis of the earth\u2019s rotation", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["axis of the earth\u2019s rotation"], "contexts": ["imaginary line through Earth's center", "line around which Earth spins"]}, {"entity_id": "earth's_axis", "book_id": "first_principles_spencer_1862", "name": "Earth's axis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Earth's axis"], "contexts": ["rotation of the Earth around it"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Axis of the Earth", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "axis of the earth\u2019s rotation", "similarity": 0.932}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Axis of the Earth", "target_book": "first_principles_spencer_1862", "target_name": "Earth's axis", "similarity": 0.985}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "axis of the earth\u2019s rotation", "target_book": "first_principles_spencer_1862", "target_name": "Earth's axis", "similarity": 0.946}], "id": 1853, "stable_key": "clu_add08884aac7a4ad", "ground_truth": {"modern_name": "Earth's axis", "confidence": "high", "type": "concept"}}, {"canonical_name": "star", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "star", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Star", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Star"], "contexts": ["celestial body used for navigation"]}, {"entity_id": "star", "book_id": "principles_of_psychology_james_1890", "name": "star", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["star"], "contexts": ["celestial object observed"]}, {"entity_id": "star", "book_id": "connexion_physical_sciences_somerville_1858", "name": "star", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["star"], "contexts": ["celestial body", "distant luminous celestial body"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Star", "target_book": "principles_of_psychology_james_1890", "target_name": "star", "similarity": 0.992}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Star", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "star", "similarity": 0.992}, {"source_book": "principles_of_psychology_james_1890", "source_name": "star", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "star", "similarity": 1.0}], "id": 1854, "stable_key": "clu_11ff6525fdc73f90", "ground_truth": {"modern_name": "Star", "confidence": "high", "type": "concept", "note": "While stars are astronomical objects (celestial bodies), in the context of early modern texts, they often function as navigational aids or subjects of philosophical/scientific observation, hence a 'concept' categorization is appropriate.", "wikidata_id": "Q37529922", "wikidata_description": "family name"}}, {"canonical_name": "attractive", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "attractive", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "attractive", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["attractive"], "contexts": ["having the power to attract"]}, {"entity_id": "attractive", "book_id": "english_physician_1652", "name": "attractive", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["attractive", "Attractive"], "contexts": ["bodily virtue", "quality of drawing out impurities"]}, {"entity_id": "atractiva", "book_id": "historia_medicinal_monardes_1574", "name": "Atractiva", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Atractiva"], "contexts": ["attractive virtue"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "attractive", "target_book": "english_physician_1652", "target_name": "attractive", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "attractive", "target_book": "historia_medicinal_monardes_1574", "target_name": "Atractiva", "similarity": 0.926}, {"source_book": "english_physician_1652", "source_name": "attractive", "target_book": "historia_medicinal_monardes_1574", "target_name": "Atractiva", "similarity": 0.926}], "id": 1855, "stable_key": "clu_554e663d3709a3a4-2", "ground_truth": {"modern_name": "attraction", "confidence": "high", "type": "concept", "wikidata_id": "Q1144661", "wikidata_description": "mechanical device or structure that moves people to create enjoyment", "wikipedia_url": "https://en.wikipedia.org/wiki/Amusement%20ride", "note": "The term 'attractive' in early modern texts often referred to a perceived virtue or force, akin to modern concepts of magnetism or gravity, or biological 'attraction'."}}, {"canonical_name": "inward Wounds", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "wounds", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "wounds", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["wounds"], "contexts": ["injuries healed by ointments and nature"]}, {"entity_id": "inward_wounds", "book_id": "english_physician_1652", "name": "inward Wounds", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["inward Wounds", "inward Ulcers"], "contexts": ["injuries to internal body parts", "sores within the body"]}, {"entity_id": "wounds", "book_id": "principles_of_psychology_james_1890", "name": "wounds", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["wounds"], "contexts": ["injury to the body"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "wounds", "target_book": "english_physician_1652", "target_name": "inward Wounds", "similarity": 0.968}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "wounds", "target_book": "principles_of_psychology_james_1890", "target_name": "wounds", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "inward Wounds", "target_book": "principles_of_psychology_james_1890", "target_name": "wounds", "similarity": 0.968}], "id": 1856, "stable_key": "clu_4d24d3725b154b24", "ground_truth": {"modern_name": "Wounds", "confidence": "high", "type": "disease", "description": "An injury to living tissue, typically involving a break in the skin.", "note": "Includes various types of wounds like 'green Wounds' and 'inward Wounds'. 'Contus\u00f5es' (bruises) are also a form of wound.", "wikipedia_extract": "A wound is any disruption of or damage to living tissue, such as skin, mucous membranes, or organs. Wounds can either be the sudden result of direct trauma (mechanical, thermal, chemical), or can develop slowly over time due to underlying disease processes such as diabetes mellitus, venous/arterial insufficiency, or immunologic disease. Wounds can vary greatly in their appearance depending on wound location, injury mechanism, depth of injury, timing of onset (acute vs chronic), and wound sterility, among other factors. Treatment strategies for wounds will vary based on the classification of the wound, therefore it is essential that wounds be thoroughly evaluated by a healthcare professional for proper management. In normal physiology, all wounds will undergo a series of steps collectively known as the wound healing process, which include hemostasis, inflammation, proliferation, and tissue remodeling. Age, tissue oxygenation, stress, underlying medical conditions, and certain medications are just a few of the many factors known to affect the rate of wound healing."}}, {"canonical_name": "nitrous oxide", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "nitrous", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "nitrous", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nitrous"], "contexts": ["exhalations in clouds"]}, {"entity_id": "nitrous_oxide", "book_id": "principles_of_psychology_james_1890", "name": "nitrous oxide", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["nitrous oxide"], "contexts": ["gas used as an anesthetic", "anesthetic agent causing loss of discrimination"]}, {"entity_id": "nitrous_oxide", "book_id": "first_principles_spencer_1862", "name": "nitrous oxide", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nitrous oxide"], "contexts": ["gas causing exhilaration"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "nitrous", "target_book": "principles_of_psychology_james_1890", "target_name": "nitrous oxide", "similarity": 0.908}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "nitrous", "target_book": "first_principles_spencer_1862", "target_name": "nitrous oxide", "similarity": 0.908}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nitrous oxide", "target_book": "first_principles_spencer_1862", "target_name": "nitrous oxide", "similarity": 1.0}], "id": 1857, "stable_key": "clu_a07829510d7132c7-2", "ground_truth": {"modern_name": "Nitrous oxide", "confidence": "high", "type": "chemical", "note": "While 'nitrogen gas' is mentioned, the context of affecting consciousness and 'nitrous acid gas' points strongly to nitrous oxide (N2O).", "wikidata_id": "Q905750", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Nitrous%20oxide", "wikipedia_extract": "Nitrous oxide (dinitrogen oxide or dinitrogen monoxide), commonly known as laughing gas, nitrous, or historically as factitious air, among others, is a chemical compound, an oxide of nitrogen with the formula N2O. At room temperature, it is a colourless non-flammable gas, and has a slightly sweet scent and taste. At elevated temperatures, nitrous oxide is a powerful oxidiser similar to molecular oxygen. Nitrous oxide has significant medical uses, especially in surgery and dentistry, for its anaesthetic and pain-reducing effects, and it is on the World Health Organization's List of Essential Medicines. Its colloquial name, \"laughing gas\", coined by Humphry Davy, describes the euphoric effects upon inhaling it, which cause it to be used as a recreational drug inducing a brief \"high\". When abused chronically, it may cause neurological damage through inactivation of vitamin B12."}}, {"canonical_name": "b\u00f3rax", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "borax", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Borax", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Borax"], "contexts": ["mineral used in gunpowder formulations"]}, {"entity_id": "borax", "book_id": "english_physician_1652", "name": "Borax", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Borax"], "contexts": ["powder mixed with juice for cleansing"]}, {"entity_id": "b\u00f3rax", "book_id": "coloquios_da_orta_1563", "name": "b\u00f3rax", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["b\u00f3rax"], "contexts": ["substance used for gold and metals", "substance"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Borax", "target_book": "english_physician_1652", "target_name": "Borax", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Borax", "target_book": "coloquios_da_orta_1563", "target_name": "b\u00f3rax", "similarity": 0.751}, {"source_book": "english_physician_1652", "source_name": "Borax", "target_book": "coloquios_da_orta_1563", "target_name": "b\u00f3rax", "similarity": 0.751}], "id": 1858, "stable_key": "clu_b3b246848f53b7cd", "ground_truth": {"modern_name": "borax", "confidence": "high", "type": "mineral", "description": "Soft white crystalline mineral, a salt of boric acid.", "wikipedia_extract": "Borax (also referred to as sodium borate, tincal  and tincar ) is a salt (ionic compound) normally encountered as a hydrated borate of sodium, with the chemical formula Na2H20B4O17. Borax mineral is a crystalline borate mineral that occurs in only a few places worldwide in quantities that enable it to be mined economically. Borax can be dehydrated by heating into other forms with less water of hydration. The anhydrous form of borax can also be obtained from the decahydrate or other hydrates by heating and then grinding the resulting glasslike solid into a powder. It is a white crystalline solid that dissolves in water to make a basic solution due to the tetraborate anion. Borax is commonly available in powder or granular form and has many industrial and household uses, including as a pesticide, as a metal soldering flux, as a component of glass, enamel, and pottery glazes, for tanning of skins and hides, for artificial aging of wood, as a preservative against wood fungus, as a food additive, and as a pharmaceutic alkalizer."}}, {"canonical_name": "rubino", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "ruby", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ruby", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Ruby"], "contexts": ["gem"]}, {"entity_id": "ruby", "book_id": "kosmos_humboldt_1845", "name": "ruby", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["ruby"], "contexts": ["mineral purposely produced"]}, {"entity_id": "rubino", "book_id": "ricettario_fiorentino_1597", "name": "rubino", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["rubino", "Rubini"], "contexts": ["precious stone", "gemstones to be ground"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ruby", "target_book": "kosmos_humboldt_1845", "target_name": "ruby", "similarity": 0.931}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ruby", "target_book": "ricettario_fiorentino_1597", "target_name": "rubino", "similarity": 0.897}, {"source_book": "kosmos_humboldt_1845", "source_name": "ruby", "target_book": "ricettario_fiorentino_1597", "target_name": "rubino", "similarity": 0.939}], "id": 1859, "stable_key": "clu_a90b385c48351aac-2", "ground_truth": {"modern_name": "Ruby", "confidence": "high", "type": "mineral", "wikidata_id": "Q43088", "wikidata_description": "variety of corundum, mineral, gemstone", "note": "'Rubim' is the Portuguese for ruby, and 'rame' (in this context, likely a misspelling or variant of 'rubi') and 'precious stone' point to the gem.  The metal context is less likely given the gem identification."}}, {"canonical_name": "Dyarrhea", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "diarhea", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Diarhea", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["Diarhea"], "contexts": ["medical condition with frequent occurrence"]}, {"entity_id": "dyarrhea", "book_id": "polyanthea_medicinal", "name": "Dyarrhea", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["Dyarrhea", "as Diarrheas"], "contexts": ["diarrhea", "appropriate and effective for curing diarrheas"]}, {"entity_id": "diarrh\u0153a", "book_id": "first_principles_spencer_1862", "name": "diarrh\u0153a", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["diarrh\u0153a"], "contexts": ["frequent loose bowel movements"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Diarhea", "target_book": "polyanthea_medicinal", "target_name": "Dyarrhea", "similarity": 0.975}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Diarhea", "target_book": "first_principles_spencer_1862", "target_name": "diarrh\u0153a", "similarity": 0.961}, {"source_book": "polyanthea_medicinal", "source_name": "Dyarrhea", "target_book": "first_principles_spencer_1862", "target_name": "diarrh\u0153a", "similarity": 0.963}], "id": 1860, "stable_key": "clu_826da343cc3ead94", "ground_truth": {"modern_name": "diarrhea", "confidence": "high", "type": "disease", "modern_term": "diarrhea", "wikidata_id": "Q4293116", "wikidata_description": "Human disease", "wikipedia_extract": "Diarrhea (American English), also spelled diarrhoea or diarrh\u0153a (British English), is the condition of having at least three loose, liquid, or watery bowel movements in a day. It often lasts for a few days and can result in dehydration due to fluid loss. Signs of dehydration often begin with loss of the normal stretchiness of the skin and irritable behaviour. This can progress to decreased urination, loss of skin color, a fast heart rate, and a decrease in responsiveness as it becomes more severe. Loose but non-watery stools in babies who are exclusively breastfed, however, are normal. The most common cause is an infection of the intestines due to a virus, bacterium, or parasite\u2014a condition also known as gastroenteritis.", "wikipedia_url": "https://en.wikipedia.org/wiki/Diarrhea"}}, {"canonical_name": "Lightning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "lightning", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Lightning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Lightning"], "contexts": ["electrical discharge from storm"]}, {"entity_id": "lightning", "book_id": "english_physician_1652", "name": "Lightning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Lightning"], "contexts": ["natural phenomenon", "natural phenomenon to be protected from"]}, {"entity_id": "lightning", "book_id": "first_principles_spencer_1862", "name": "lightning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["lightning"], "contexts": ["electrical discharge in atmosphere"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lightning", "target_book": "english_physician_1652", "target_name": "Lightning", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lightning", "target_book": "first_principles_spencer_1862", "target_name": "lightning", "similarity": 0.973}, {"source_book": "english_physician_1652", "source_name": "Lightning", "target_book": "first_principles_spencer_1862", "target_name": "lightning", "similarity": 0.973}], "id": 1861, "stable_key": "clu_d7011af173908b27", "ground_truth": {"modern_name": "lightning", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "fly", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "fly", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Fly", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["Fly"], "contexts": ["common winged insect"]}, {"entity_id": "fly", "book_id": "origin_of_species_darwin_1859", "name": "fly", "category": "ANIMAL", "subcategory": "INSECT", "count": 2, "variants": ["fly"], "contexts": ["insect that deposits hundreds of eggs", "insect that lays eggs in animal navels"]}, {"entity_id": "fly", "book_id": "principles_of_psychology_james_1890", "name": "fly", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["fly"], "contexts": ["insect studied by entomologist"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Fly", "target_book": "origin_of_species_darwin_1859", "target_name": "fly", "similarity": 0.992}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Fly", "target_book": "principles_of_psychology_james_1890", "target_name": "fly", "similarity": 0.992}, {"source_book": "origin_of_species_darwin_1859", "source_name": "fly", "target_book": "principles_of_psychology_james_1890", "target_name": "fly", "similarity": 1.0}], "id": 1862, "stable_key": "clu_40d9fa245d9a5b18", "ground_truth": {"modern_name": "Fly", "confidence": "low", "type": "animal", "note": "The context 'creatures that produce pearls' is highly unusual for flies and suggests a possible misidentification or specific folklore. The 'moUuscos' is likely an OCR error for 'mosquitos' or similar insect, but given the context of pearls, it's highly ambiguous.", "wikidata_id": "Q166111", "wikidata_description": "species of insect in the class \"Muscidae\", sort of fly", "wikipedia_extract": "Flies are insects of the order Diptera, the name being derived from Ancient Greek  \u03b4\u03b9- (di-) 'two' and  \u03c0\u03c4\u03b5\u03c1\u03cc\u03bd (pteron) 'wing'. Insects of this order use only a single pair of wings to fly, the hindwings having evolved into advanced mechanosensory organs known as halteres, which act as high-speed sensors of rotational movement and allow dipterans to perform advanced aerobatics. Diptera is a large order containing more than 150,000 species including horse-flies, crane flies, hoverflies, mosquitoes and others. Flies have a mobile head, with a pair of large compound eyes, and mouthparts designed for piercing and sucking (mosquitoes, black flies and robber flies), or for lapping and sucking in the other groups. Their wing arrangement gives them great manoeuvrability in flight, and claws and pads on their feet enable them to cling to smooth surfaces. Flies undergo complete metamorphosis; the eggs are often laid on the larval food-source and the larvae, which lack true limbs, develop in a protected environment, often inside their food source.", "wikipedia_url": "https://en.wikipedia.org/wiki/Housefly"}}, {"canonical_name": "sleep", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "sleep", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "sleep", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["sleep"], "contexts": ["state of unconsciousness"]}, {"entity_id": "falling_asleep", "book_id": "principles_of_psychology_james_1890", "name": "falling asleep", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["falling asleep"], "contexts": ["transition state to sleep"]}, {"entity_id": "sleep", "book_id": "first_principles_spencer_1862", "name": "sleep", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["sleep"], "contexts": ["state of rest and reduced activity", "lowering of functional activity"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sleep", "target_book": "principles_of_psychology_james_1890", "target_name": "falling asleep", "similarity": 0.918}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sleep", "target_book": "first_principles_spencer_1862", "target_name": "sleep", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "falling asleep", "target_book": "first_principles_spencer_1862", "target_name": "sleep", "similarity": 0.918}], "id": 1863, "stable_key": "clu_ac5c32c5cbfd0002", "ground_truth": {"modern_name": "sleep", "confidence": "high", "type": "concept", "note": "While sleep is a biological state, in the context of these texts, it functions as a concept being discussed or contrasted.", "wikidata_id": "Q35831", "wikidata_description": "naturally recurring resting state of mind and body", "wikipedia_url": "https://en.wikipedia.org/wiki/Sleep", "wikipedia_extract": "Sleep is a state of reduced mental and physical activity in which consciousness is altered and certain sensory activity is inhibited. During sleep, there is a marked decrease in muscle activity and interactions with the surrounding environment. While sleep differs from wakefulness in terms of the ability to react to stimuli, it still involves active brain patterns, making it more reactive than a coma or disorders of consciousness. Sleep occurs in repeating periods, during which the body alternates between two distinct modes: rapid eye movement sleep (REM) and non-REM sleep. Although REM stands for \"rapid eye movement\", this mode of sleep has many other aspects, including virtual paralysis of the body. Dreams are a succession of images, ideas, emotions, and sensations that usually occur involuntarily in the mind during certain stages of sleep."}}, {"canonical_name": "fore-legs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "fore-legs", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "fore-legs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["fore-legs"], "contexts": ["front limbs of animals"]}, {"entity_id": "fore_leg", "book_id": "origin_of_species_darwin_1859", "name": "fore leg", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["fore leg"], "contexts": ["part of horse"]}, {"entity_id": "fore-limbs", "book_id": "origin_of_species_darwin_1859", "name": "fore-limbs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["fore-limbs"], "contexts": ["limbs used for locomotion and manipulation"]}, {"entity_id": "fore-limb", "book_id": "principles_of_psychology_james_1890", "name": "fore-limb", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["fore-limb"], "contexts": ["front limb of an animal"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fore-legs", "target_book": "origin_of_species_darwin_1859", "target_name": "fore leg", "similarity": 0.943}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fore-legs", "target_book": "origin_of_species_darwin_1859", "target_name": "fore-limbs", "similarity": 0.946}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fore-legs", "target_book": "principles_of_psychology_james_1890", "target_name": "fore-limb", "similarity": 0.897}, {"source_book": "origin_of_species_darwin_1859", "source_name": "fore leg", "target_book": "principles_of_psychology_james_1890", "target_name": "fore-limb", "similarity": 0.928}, {"source_book": "origin_of_species_darwin_1859", "source_name": "fore-limbs", "target_book": "principles_of_psychology_james_1890", "target_name": "fore-limb", "similarity": 0.955}], "id": 1864, "stable_key": "clu_a9c1b7c14a6480df", "ground_truth": {"modern_name": "Forelimbs", "confidence": "high", "type": "concept", "wikidata_id": "Q14912045", "wikidata_description": "The process in which the anatomical structures of the forelimb are generated and organized. The forelimbs are the front limbs of an animal, e.g. the arms of a human."}}, {"canonical_name": "Swine", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "swine", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Swine", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Swine"], "contexts": ["animals that terrify elephants"]}, {"entity_id": "swine", "book_id": "english_physician_1652", "name": "Swine", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Swine"], "contexts": ["animal fattened by Beech", "animals fattened in various places"]}, {"entity_id": "swine", "book_id": "kosmos_humboldt_1845", "name": "swine", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["swine"], "contexts": ["domesticated pig animals"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Swine", "target_book": "english_physician_1652", "target_name": "Swine", "similarity": 0.757}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Swine", "target_book": "kosmos_humboldt_1845", "target_name": "swine", "similarity": 0.869}], "id": 1865, "stable_key": "clu_8e14846962f338c7-3", "ground_truth": {"modern_name": "Pigs", "confidence": "medium", "type": "animal", "note": "The term 'porcos' is clearly pigs. 'Porpoces' could refer to porpoises, and 'por\u00e7ovejos' is unclear but potentially a misspelling or regional term. However, the context of gall presence for medicinal use often involved domestic animals like pigs.", "wikidata_id": "Q58697", "wikidata_description": "omnivore species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Wild%20boar", "wikipedia_extract": "The wild boar (Sus scrofa), also known as the wild swine, common wild pig, Eurasian wild pig, or simply wild pig, is a suid native to much of Eurasia and North Africa, and has been introduced to the Americas and Oceania. The species is now one of the widest-ranging mammals in the world, as well as the most widespread suiform. It has been assessed as least concern on the IUCN Red List due to its wide range, high numbers, and adaptability to a diversity of habitats. It has become an invasive species in part of its introduced range. Wild boars probably originated in Southeast Asia during the Early Pleistocene and outcompeted other suid species as they spread throughout the Old World. As of 2005, up to 16 subspecies are recognized, which are divided into four regional groupings based on skull height and lacrimal bone length."}}, {"canonical_name": "production", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "production", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "production", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["production"], "contexts": ["act of creating something"]}, {"entity_id": "productions", "book_id": "origin_of_species_darwin_1859", "name": "productions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["productions"], "contexts": ["organisms or products"]}, {"entity_id": "production", "book_id": "origin_of_species_darwin_1859", "name": "production", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["production"], "contexts": ["creation or emergence of new forms"]}, {"entity_id": "production", "book_id": "first_principles_spencer_1862", "name": "production", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["production"], "contexts": ["creation of goods and services"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "production", "target_book": "origin_of_species_darwin_1859", "target_name": "productions", "similarity": 0.848}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "production", "target_book": "origin_of_species_darwin_1859", "target_name": "production", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "production", "target_book": "first_principles_spencer_1862", "target_name": "production", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "productions", "target_book": "first_principles_spencer_1862", "target_name": "production", "similarity": 0.848}, {"source_book": "origin_of_species_darwin_1859", "source_name": "production", "target_book": "first_principles_spencer_1862", "target_name": "production", "similarity": 1.0}], "id": 1866, "stable_key": "clu_bad821252aacd6c5", "ground_truth": {"modern_name": "Production", "confidence": "high", "type": "concept", "wikidata_id": "Q11398090", "wikidata_description": "intentional activity during which something comes into being and gains its characteristics"}}, {"canonical_name": "Alexander the GREAT TYRANT", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "alexander_the_great", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Alexander the Great", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Alexander the Great"], "contexts": ["historical figure who put collar on deer"]}, {"entity_id": "alexander_the_great_tyrant", "book_id": "english_physician_1652", "name": "Alexander the GREAT TYRANT", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Alexander the GREAT TYRANT", "Alexander"], "contexts": ["gave writings to Aristotle", "name associated with herb and dish"]}, {"entity_id": "alexander_the_great", "book_id": "principles_of_psychology_james_1890", "name": "Alexander the Great", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Alexander the Great"], "contexts": ["historical figure with eventful life"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Alexander the Great", "target_book": "principles_of_psychology_james_1890", "target_name": "Alexander the Great", "similarity": 0.904}, {"source_book": "english_physician_1652", "source_name": "Alexander the GREAT TYRANT", "target_book": "principles_of_psychology_james_1890", "target_name": "Alexander the Great", "similarity": 0.925}], "id": 1867, "stable_key": "clu_2466e80f7fa79a3a-2", "ground_truth": {"modern_name": "Alexander the Great", "confidence": "high", "type": "person", "birth_year": -356, "death_year": -323, "description": "Macedonian king, conqueror, and historical figure.", "wikidata_id": "Q8409", "wikidata_description": "king of Macedonia and conqueror of Achaemenid Persia (356\u2013323 BC)", "wikipedia_url": "https://en.wikipedia.org/wiki/Alexander%20the%20Great", "wikipedia_extract": "Alexander III of Macedon (Ancient Greek: \u1f08\u03bb\u03ad\u03be\u03b1\u03bd\u03b4\u03c1\u03bf\u03c2, romanized: Al\u00e9xandros; 20/21 July 356 BC \u2013 10/11 June 323 BC), most commonly known as Alexander the Great, was king of the ancient Greek kingdom of Macedon. He succeeded his father Philip II to the throne in 336 BC at the age of 20, and spent most of his reign conducting a lengthy military campaign throughout Asia and Egypt. By the age of 30, he had created one of the largest empires in history, stretching from Greece to northwestern India. He was undefeated in battle and is widely considered to be one of history's greatest and most successful military commanders. Born in Pella, Macedon, Alexander was tutored by philosopher and polymath Aristotle until the age of 16. In 335 BC, shortly after assuming the throne of Macedon, he launched a campaign in the Balkans and reasserted control over Thrace and parts of Illyria before marching on the city of Thebes, which was subsequently destroyed."}}, {"canonical_name": "chaleur int\u00e9rieure de la terre", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "chaleur_int\u00e9rieure_de_la_terre", "book_id": "epoques_nature_buffon_1778", "name": "chaleur int\u00e9rieure de la terre", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["chaleur int\u00e9rieure de la terre"], "contexts": ["residual heat within the earth", "internal heat of the Earth"]}, {"entity_id": "internal_heat_of_the_earth", "book_id": "kosmos_humboldt_1845", "name": "Internal Heat of the Earth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Internal Heat of the Earth"], "contexts": ["heat originating from within the Earth"]}, {"entity_id": "internal_heat_of_the_earth", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Internal Heat of the Earth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Internal Heat of the Earth"], "contexts": ["heat originating from within Earth"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "chaleur int\u00e9rieure de la terre", "target_book": "kosmos_humboldt_1845", "target_name": "Internal Heat of the Earth", "similarity": 0.944}, {"source_book": "epoques_nature_buffon_1778", "source_name": "chaleur int\u00e9rieure de la terre", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Internal Heat of the Earth", "similarity": 0.944}, {"source_book": "kosmos_humboldt_1845", "source_name": "Internal Heat of the Earth", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Internal Heat of the Earth", "similarity": 1.0}], "id": 1868, "stable_key": "clu_6c7e4c42ea63e8dd", "ground_truth": {"modern_name": "Internal Heat of the Earth", "confidence": "high", "type": "concept"}}, {"canonical_name": "plomb", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "plomb", "book_id": "epoques_nature_buffon_1778", "name": "plomb", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["plomb"], "contexts": ["heavy metal", "metal, most vitrescible of all metals"]}, {"entity_id": "minerais_de_plomb", "book_id": "relation_historique_humboldt_vol3_1825", "name": "minerais de plomb", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["minerais de plomb"], "contexts": ["found in limestone with gryph\u00e9es"]}, {"entity_id": "plombe", "book_id": "ricettario_fiorentino_1597", "name": "plombe", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["plombe"], "contexts": ["lead, a metal"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "plomb", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "minerais de plomb", "similarity": 0.929}, {"source_book": "epoques_nature_buffon_1778", "source_name": "plomb", "target_book": "ricettario_fiorentino_1597", "target_name": "plombe", "similarity": 0.971}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "minerais de plomb", "target_book": "ricettario_fiorentino_1597", "target_name": "plombe", "similarity": 0.893}], "id": 1869, "stable_key": "clu_32141f4b0c561475", "ground_truth": {"modern_name": "Lead", "confidence": "high", "type": "mineral", "wikidata_id": "Q708", "wikidata_description": "chemical element with symbol Pb and atomic number 82", "wikipedia_url": "https://en.wikipedia.org/wiki/Lead"}}, {"canonical_name": "terres argileuses", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "terres_argileuses", "book_id": "epoques_nature_buffon_1778", "name": "terres argileuses", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["terres argileuses"], "contexts": ["layers found above coal mines", "clay-rich soils deposited by the sea"]}, {"entity_id": "argillaceous_earth", "book_id": "origin_of_species_darwin_1859", "name": "argillaceous earth", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["argillaceous earth"], "contexts": ["clay-rich soil material"]}, {"entity_id": "terrain_calcaire", "book_id": "relation_historique_humboldt_vol3_1825", "name": "terrain calcaire", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["terrain calcaire"], "contexts": ["limestone terrain"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "terres argileuses", "target_book": "origin_of_species_darwin_1859", "target_name": "argillaceous earth", "similarity": 0.929}, {"source_book": "epoques_nature_buffon_1778", "source_name": "terres argileuses", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "terrain calcaire", "similarity": 0.897}], "id": 1870, "stable_key": "clu_7ff1143f6fac33cf-4", "ground_truth": {"modern_name": "Clay", "confidence": "high", "type": "mineral", "wikidata_id": "Q164192", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Claytonia", "note": "Argile and argilla are historical terms for clay.", "wikipedia_extract": "Claytonia (spring beauty) is a genus of flowering plants native to Asia, North America, and Central America. The vitamin-rich leaves can be eaten raw or cooked, and the tubers can be prepared like potatoes. The plants are somewhat fleshy and only a few centimeters in height. The flower heads are about 2.5 cm (1 inch) in diameter. The genus was formerly included in the purslane family (Portulacaceae), but with the adoption of the APG IV system, in 2009 it was moved to the family Montiaceae. A number of the species were formerly treated in the related genus Montia."}}, {"canonical_name": "Astrea", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "astre", "book_id": "epoques_nature_buffon_1778", "name": "astre", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["astre"], "contexts": ["celestial body, star"]}, {"entity_id": "astre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "astre", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["astre"], "contexts": ["celestial body, likely the moon"]}, {"entity_id": "astrea", "book_id": "kosmos_humboldt_1845", "name": "Astrea", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Astrea"], "contexts": ["primary planet in the solar system", "asteroid planet discovered by Hencke"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "astre", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "astre", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "astre", "target_book": "kosmos_humboldt_1845", "target_name": "Astrea", "similarity": 0.89}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "astre", "target_book": "kosmos_humboldt_1845", "target_name": "Astrea", "similarity": 0.89}], "id": 1871, "stable_key": "clu_1f192b291e12d6e8-2", "ground_truth": {"modern_name": "Moon", "confidence": "high", "type": "object", "note": "The term 'lune' was used in some contexts to refer to the moon, particularly in older texts or when discussing its astronomical or astrological significance. 'Luna' is the Latin word for moon.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Moon", "wikipedia_extract": "The Moon is the only natural satellite of Earth. It orbits around Earth at an average distance of 384,399 kilometres (238,854 mi), a distance roughly 30 times the width of Earth. It completes an orbit (lunar month) in relation to Earth and the Sun (synodically) every 29.5 days. The Moon and Earth are bound by gravitational attraction, which is stronger on the sides facing each other. The resulting tidal forces are the main driver of Earth's tides, and have pulled the Moon to always face Earth with the same near side. This tidal locking effectively synchronizes the Moon's rotation period (lunar day) to its orbital period (lunar month)."}}, {"canonical_name": "Bitumines", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "mati\u00e8res_bitumineuses", "book_id": "epoques_nature_buffon_1778", "name": "mati\u00e8res bitumineuses", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["mati\u00e8res bitumineuses"], "contexts": ["organic compounds containing bitumen"]}, {"entity_id": "bitumineuse", "book_id": "relation_historique_humboldt_vol3_1825", "name": "bitumineuse", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["bitumineuse"], "contexts": ["containing bitumen"]}, {"entity_id": "bitumines", "book_id": "historia_medicinal_monardes_1574", "name": "Bitumines", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Bitumines"], "contexts": ["substances from which Ambar originates", "substance from which amber originates"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "mati\u00e8res bitumineuses", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "bitumineuse", "similarity": 0.892}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mati\u00e8res bitumineuses", "target_book": "historia_medicinal_monardes_1574", "target_name": "Bitumines", "similarity": 0.9}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "bitumineuse", "target_book": "historia_medicinal_monardes_1574", "target_name": "Bitumines", "similarity": 0.907}], "id": 1872, "stable_key": "clu_1765d1b08508ec03-3", "ground_truth": {"modern_name": "Bitumen", "confidence": "high", "type": "mineral", "wikidata_id": "Q167510", "wikidata_description": "form of petroleum primarily used in road construction", "wikipedia_extract": "Shilajit (Sanskrit: \u0936\u093f\u0932\u093e\u091c\u093f\u0924\u094d) or Shilajatu (\u0936\u093f\u0932\u093e\u091c\u0924\u0941; lit. mountain/rock bitumen/lac), is an organic-mineral product of predominantly biological origin, formed at high altitudes on stony mountains, in sheltered crevices and caves. It is a blackish-brown powder or an exudate emerging between high mountain rocks, often found in the Altai Mountains, the Caucasus Mountains, the Himalayas (especially in India, Pakistan, Nepal, and the Tibetan Plateau), the Karakoram, the Pamir Mountains (primarily in Gorno-Badakhshan, Tajikistan), and countrywise in Afghanistan, Bhutan, Georgia, India (regions of Himachal Pradesh and Uttarakhand), Iran, Kyrgyzstan, Mongolia, Nepal, Russia, Central Asia and Africa. People living in these areas use shilajit in folk and non-traditional (alternative) medicine (Ayurveda, Chinese, Tibetan). Shilajit is sold both in dry extract form and in dietary supplements, but there is limited evidence that shilajit has any beneficial effects on human health. Some sources have been found in studies to contain hazardous heavy metals, including lead.", "wikipedia_url": "https://en.wikipedia.org/wiki/Bitumen"}}, {"canonical_name": "grain", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "grains", "book_id": "epoques_nature_buffon_1778", "name": "grains", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["grains"], "contexts": ["grains"]}, {"entity_id": "grain", "book_id": "relation_historique_humboldt_vol3_1825", "name": "grain", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["grain", "grains"], "contexts": ["measure of agricultural yield", "small particles"]}, {"entity_id": "grains", "book_id": "first_principles_spencer_1862", "name": "grains", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["grains"], "contexts": ["unit of weight"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "grains", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "grain", "similarity": 0.965}, {"source_book": "epoques_nature_buffon_1778", "source_name": "grains", "target_book": "first_principles_spencer_1862", "target_name": "grains", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "grain", "target_book": "first_principles_spencer_1862", "target_name": "grains", "similarity": 0.965}], "id": 1873, "stable_key": "clu_28b15e332fe46752-2", "ground_truth": {"modern_name": "grain", "confidence": "high", "type": "concept", "wikipedia_extract": "A grain is a small, hard, dry fruit (caryopsis) \u2013 with or without an attached hull layer \u2013 harvested for human or animal consumption. A grain crop is a grain-producing plant. The two main types of commercial grain crops are cereals and legumes. After being harvested, dry grains are more durable than other staple foods, such as starchy fruits (plantains, breadfruit, etc.) and tubers (sweet potatoes, cassava, and more). This durability has made grains well suited to industrial agriculture, since they can be mechanically harvested, transported by rail or ship, stored for long periods in silos, and milled for flour or pressed for oil. Thus, the grain market is a major global agricultural market that includes crops such as maize, rice, soybeans, wheat and other grains.", "wikipedia_url": "https://en.wikipedia.org/wiki/Grain"}}, {"canonical_name": "basins", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "bassins", "book_id": "epoques_nature_buffon_1778", "name": "bassins", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["bassins"], "contexts": ["depressions holding water"]}, {"entity_id": "basins", "book_id": "kosmos_humboldt_1845", "name": "basins", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["basins"], "contexts": ["drainage areas of rivers", "depressions in the Earth's surface"]}, {"entity_id": "pools", "book_id": "connexion_physical_sciences_somerville_1858", "name": "pools", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["pools"], "contexts": ["small bodies of still water"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "bassins", "target_book": "kosmos_humboldt_1845", "target_name": "basins", "similarity": 0.949}, {"source_book": "epoques_nature_buffon_1778", "source_name": "bassins", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "pools", "similarity": 0.903}, {"source_book": "kosmos_humboldt_1845", "source_name": "basins", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "pools", "similarity": 0.883}], "id": 1874, "stable_key": "clu_729654949a459a1e", "ground_truth": {"modern_name": "Basin", "confidence": "high", "type": "place", "country": "Global", "note": "This can refer to geological basins, bodies of water, or drainage areas. Given the contexts, 'Basin' is the most appropriate general modern term.", "wikidata_id": "Q37007973", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Basin%20%28surname%29"}}, {"canonical_name": "c\u00f4tes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "c\u00f4tes", "book_id": "epoques_nature_buffon_1778", "name": "c\u00f4tes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["c\u00f4tes"], "contexts": ["land bordering the sea"]}, {"entity_id": "c\u00f4tes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "c\u00f4tes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["c\u00f4tes"], "contexts": ["land bordering the sea"]}, {"entity_id": "coasts", "book_id": "kosmos_humboldt_1845", "name": "coasts", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["coasts"], "contexts": ["land bordering the sea"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "c\u00f4tes", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "c\u00f4tes", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "c\u00f4tes", "target_book": "kosmos_humboldt_1845", "target_name": "coasts", "similarity": 0.96}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "c\u00f4tes", "target_book": "kosmos_humboldt_1845", "target_name": "coasts", "similarity": 0.96}], "id": 1875, "stable_key": "clu_8dfaf03ebf057298-2", "ground_truth": {"modern_name": "Coastline", "confidence": "high", "type": "place", "note": "This refers to the general geographical feature of land bordering the sea.", "wikidata_id": "Q1701967", "wikidata_description": "outline of the coast"}}, {"canonical_name": "tendon d\u2019animal", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "tendon_d\u2019animal", "book_id": "epoques_nature_buffon_1778", "name": "tendon d\u2019animal", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["tendon d\u2019animal"], "contexts": ["animal tissue used for cord"]}, {"entity_id": "tendon", "book_id": "english_physician_1652", "name": "Tendon", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Tendon"], "contexts": ["connective tissue"]}, {"entity_id": "tendon", "book_id": "principles_of_psychology_james_1890", "name": "tendon", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["tendon"], "contexts": ["connective tissue attaching muscle to bone"]}, {"entity_id": "tendons", "book_id": "principles_of_psychology_james_1890", "name": "tendons", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["tendons"], "contexts": ["connective tissue attaching muscle to bone"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "tendon d\u2019animal", "target_book": "principles_of_psychology_james_1890", "target_name": "tendon", "similarity": 0.95}, {"source_book": "epoques_nature_buffon_1778", "source_name": "tendon d\u2019animal", "target_book": "principles_of_psychology_james_1890", "target_name": "tendons", "similarity": 0.885}, {"source_book": "english_physician_1652", "source_name": "Tendon", "target_book": "principles_of_psychology_james_1890", "target_name": "tendon", "similarity": 0.562}], "id": 1876, "stable_key": "clu_227b8948c7690e33", "ground_truth": {"wikipedia_extract": "A tendon or sinew is a tough band of dense fibrous connective tissue that connects muscle to bone. It sends the mechanical forces of muscle contraction to the skeletal system, while withstanding tension. Tendons, like ligaments, are made of collagen. The difference is that ligaments connect bone to bone, while tendons connect muscle to bone. There are about 4,000 tendons in the adult human body. A tendon is made of dense regular connective tissue, whose main cellular components are special fibroblasts called tendon cells (tenocytes)."}}, {"canonical_name": "sauvages", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "sauvages", "book_id": "epoques_nature_buffon_1778", "name": "sauvages", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["sauvages"], "contexts": ["indigenous peoples living in natural state"]}, {"entity_id": "sauvage", "book_id": "epoques_nature_buffon_1778", "name": "sauvage", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["sauvage"], "contexts": ["uncivilized individuals"]}, {"entity_id": "sauvages", "book_id": "relation_historique_humboldt_vol3_1825", "name": "sauvages", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["sauvages"], "contexts": ["indigenous people"]}, {"entity_id": "savants", "book_id": "principles_of_psychology_james_1890", "name": "savants", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["savants"], "contexts": ["learned individuals or scholars"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "sauvages", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "sauvages", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "sauvages", "target_book": "principles_of_psychology_james_1890", "target_name": "savants", "similarity": 0.886}, {"source_book": "epoques_nature_buffon_1778", "source_name": "sauvage", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "sauvages", "similarity": 0.954}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "sauvages", "target_book": "principles_of_psychology_james_1890", "target_name": "savants", "similarity": 0.886}], "id": 1877, "stable_key": "clu_09c7ed5ca8504aa2", "ground_truth": {"modern_name": "Indigenous peoples / Savants", "confidence": "medium", "type": "person", "description": "Indigenous peoples contrasted with learned scholars.", "note": "The term 'sauvages' historically refers to indigenous peoples, while 'savants' refers to learned individuals. The cluster appears to contain two distinct but contrasting concepts."}}, {"canonical_name": "Quebec", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "qu\u00e9bec", "book_id": "epoques_nature_buffon_1778", "name": "Qu\u00e9bec", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Qu\u00e9bec"], "contexts": ["city in Canada"]}, {"entity_id": "qu\u00e9bec", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Qu\u00e9bec", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Qu\u00e9bec"], "contexts": ["city"]}, {"entity_id": "quebec", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Quebec", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Quebec"], "contexts": ["city with warm summers and severe winters", "city with temperature extremes"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Qu\u00e9bec", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Qu\u00e9bec", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Qu\u00e9bec", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Quebec", "similarity": 0.903}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Qu\u00e9bec", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Quebec", "similarity": 0.903}], "id": 1878, "stable_key": "clu_9f2aa4aef878620b", "ground_truth": {"modern_name": "Quebec City", "confidence": "high", "type": "place", "country": "Canada", "wikipedia_extract": "Quebec (French: Qu\u00e9bec) is Canada's largest province by area. Located in Central Canada, it is the only Francophone-majority province in the country, being home to Qu\u00e9b\u00e9cois French. It shares borders with the provinces of Ontario to the west, Newfoundland and Labrador to the northeast, New Brunswick to the southeast and a coastal border with the territory of Nunavut. In the south, it shares a border with the United States. Quebec has a population of around 8 million, making it Canada's second-most populous province only behind Ontario. Between 1534 and 1763, what is now Quebec was the French colony of Canada and was the most developed colony in New France.", "wikipedia_url": "https://en.wikipedia.org/wiki/Quebec"}}, {"canonical_name": "Pacem", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "peace", "book_id": "epoques_nature_buffon_1778", "name": "peace", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["peace"], "contexts": ["state of tranquility and absence of conflict"]}, {"entity_id": "pacem", "book_id": "coloquios_da_orta_1563", "name": "Pacem", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Pacem"], "contexts": ["port and kingdom in Sumatra", "place or concept"]}, {"entity_id": "peace", "book_id": "first_principles_spencer_1862", "name": "peace", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["peace"], "contexts": ["absence of war"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "peace", "target_book": "coloquios_da_orta_1563", "target_name": "Pacem", "similarity": 0.941}, {"source_book": "epoques_nature_buffon_1778", "source_name": "peace", "target_book": "first_principles_spencer_1862", "target_name": "peace", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Pacem", "target_book": "first_principles_spencer_1862", "target_name": "peace", "similarity": 0.941}], "id": 1879, "stable_key": "clu_bc94c16be269f03c", "ground_truth": {"modern_name": "Peace", "confidence": "high", "type": "concept", "note": "The context 'absence of war' strongly suggests the concept of peace, not a geographical place.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Peace", "wikipedia_extract": "Peace is a state of harmony in the absence of hostility and violence. In a societal sense, peace is commonly used to mean a lack of conflict (such as war) and freedom from fear of violence between individuals or groups. Promotion of peace is a core tenet of many philosophies, religions, and ideologies, many of which consider it a core tenet of their philosophy. Some examples are: religions such as Buddhism and Christianity, important figures like Gandhi, and throughout literature like \"Perpetual Peace: A Philosophical Sketch\" by Immanuel Kant, \"The Art of Peace\" by Morihei Ueshiba, or ideologies that strictly adhere to it such as Pacifism within a sociopolitical scope. It is a frequent subject of symbolism and features prominently in art and other cultural traditions. The representation of peace has taken many shapes, with a variety of symbols pertaining to it based on culture, context, and history; each with their respective symbolism whose nature can be very complex."}}, {"canonical_name": "Marshes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "marshes", "book_id": "english_physician_1652", "name": "Marshes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Marshes"], "contexts": ["habitat for a sort of Bifoyl", "habitat of insects"]}, {"entity_id": "marshes", "book_id": "kosmos_humboldt_1845", "name": "marshes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["marshes"], "contexts": ["wetland areas"]}, {"entity_id": "marshes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "marshes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["marshes"], "contexts": ["wetland areas"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Marshes", "target_book": "kosmos_humboldt_1845", "target_name": "marshes", "similarity": 0.986}, {"source_book": "english_physician_1652", "source_name": "Marshes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "marshes", "similarity": 0.986}, {"source_book": "kosmos_humboldt_1845", "source_name": "marshes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "marshes", "similarity": 1.0}], "id": 1880, "stable_key": "clu_9f7b15831d727b40", "ground_truth": {"modern_name": "Wetlands", "confidence": "high", "type": "place", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "A Wetlands is a distinct semi-aquatic ecosystem whose groundcovers are flooded or saturated in water, either permanently, for years or decades, or only seasonally. Flooding results in oxygen-poor (anoxic) processes taking place, especially in the soils. Wetlands form a transitional zone between waterbodies and dry lands, and are different from other terrestrial or aquatic ecosystems due to their vegetation's roots having adapted to oxygen-poor waterlogged soils. They are considered among the most biologically diverse of all ecosystems, serving as habitats to a wide range of aquatic and semi-aquatic plants and animals, with often improved water quality due to plant removal of excess nutrients such as nitrates and phosphorus. Wetlands exist on every continent, except Antarctica. The water in wetlands is either freshwater, brackish or saltwater.", "wikipedia_url": "https://en.wikipedia.org/wiki/Wetland"}}, {"canonical_name": "Virgins", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "virgins", "book_id": "english_physician_1652", "name": "Virgins", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Virgins"], "contexts": ["young unmarried women", "group angered by Mars' effects"]}, {"entity_id": "virgines", "book_id": "polyanthea_medicinal", "name": "virgines", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["virgines"], "contexts": ["young women"]}, {"entity_id": "virgins", "book_id": "first_principles_spencer_1862", "name": "virgins", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["virgins"], "contexts": ["religious subject in art"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Virgins", "target_book": "polyanthea_medicinal", "target_name": "virgines", "similarity": 0.932}, {"source_book": "english_physician_1652", "source_name": "Virgins", "target_book": "first_principles_spencer_1862", "target_name": "virgins", "similarity": 0.924}, {"source_book": "polyanthea_medicinal", "source_name": "virgines", "target_book": "first_principles_spencer_1862", "target_name": "virgins", "similarity": 0.992}], "id": 1881, "stable_key": "clu_d661d2bf881c1fc4", "ground_truth": {"modern_name": "Virgins", "confidence": "medium", "type": "person", "description": "Young, unmarried females, often with religious or social connotations.", "note": "The term 'Virgins' in this context likely refers to young, unmarried women, but could also have specific religious or social connotations depending on the text's focus. The Wikidata search term is chosen to cover the broader concept.", "wikidata_id": "Q170538", "wikidata_description": "state of a person who has never engaged in sexual intercourse"}}, {"canonical_name": "hairs", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "hairs", "book_id": "english_physician_1652", "name": "hairs", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["hairs"], "contexts": ["on the eyelids", "on Vipers Buglofs stalks"]}, {"entity_id": "cabelluda", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "cabelluda", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cabelluda"], "contexts": ["describes a tree with hairy flowers"]}, {"entity_id": "hair_of_plant", "book_id": "principles_of_psychology_james_1890", "name": "hair of plant", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["hair of plant"], "contexts": ["plant structure resembling hair"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "hairs", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "cabelluda", "similarity": 0.901}, {"source_book": "english_physician_1652", "source_name": "hairs", "target_book": "principles_of_psychology_james_1890", "target_name": "hair of plant", "similarity": 0.927}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cabelluda", "target_book": "principles_of_psychology_james_1890", "target_name": "hair of plant", "similarity": 0.903}], "id": 1882, "stable_key": "clu_e92e39da067d00e0", "ground_truth": {"modern_name": "Trichome", "confidence": "high", "type": "plant", "note": "Early modern texts often referred to plant structures resembling hair as 'hairs'. Trichomes are the scientific term for these structures.", "wikidata_id": "Q1125215", "wikidata_description": "fine hair-like growth on plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Trichome", "wikipedia_extract": "Trichomes (; from Ancient Greek  \u03c4\u03c1\u03af\u03c7\u03c9\u03bc\u03b1 (tr\u00edkh\u014dma) 'hair') are fine outgrowths or appendages on plants, algae, lichens, and certain protists. They are of diverse structure and function. Examples are hairs, glandular hairs, scales, and papillae. A covering of any kind of hair on a plant is an indumentum, and the surface bearing them is said to be pubescent. Certain, usually filamentous, algae have the terminal cell produced into an elongate hair-like structure called a trichome. The same term is applied to such structures in some cyanobacteria, such as Spirulina and Oscillatoria."}}, {"canonical_name": "Madness", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "madness", "book_id": "english_physician_1652", "name": "Madness", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["Madness"], "contexts": ["dwels where Reason does not", "disease listed with numbers"]}, {"entity_id": "loucura", "book_id": "coloquios_da_orta_1563", "name": "loucura", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["loucura"], "contexts": ["affliction combatted by diamond"]}, {"entity_id": "locura", "book_id": "polyanthea_medicinal", "name": "locura", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["locura"], "contexts": ["illness treated by Quintilio's powders"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Madness", "target_book": "coloquios_da_orta_1563", "target_name": "loucura", "similarity": 0.955}, {"source_book": "english_physician_1652", "source_name": "Madness", "target_book": "polyanthea_medicinal", "target_name": "locura", "similarity": 0.947}, {"source_book": "coloquios_da_orta_1563", "source_name": "loucura", "target_book": "polyanthea_medicinal", "target_name": "locura", "similarity": 0.982}], "id": 1883, "stable_key": "clu_e678f91416cf2cc6", "ground_truth": {"modern_name": "Mania", "confidence": "high", "type": "disease", "description": "A mental disorder characterized by elevated mood, energy, and excitement.", "note": "Includes broader historical concepts of madness and mental derangement.", "wikipedia_extract": "Mania ( MAIN-ee-yah; also known as manic syndrome) is a psychiatric behavioral syndrome defined as a state of abnormally elevated arousal, affect, and energy level. During a manic episode, an individual will experience rapidly changing emotions and moods, highly influenced by surrounding stimuli. Although mania is often conceived of as a \"mirror image\" to depression, the heightened mood can be dysphoric as well as euphoric. As the mania intensifies, irritability can be more pronounced and result in anxiety or anger. The symptoms of mania include elevated mood (either euphoric or irritable), flight of ideas, pressure of speech, increased energy, decreased \"need\" and desire for sleep, and hyperactivity. They are most plainly evident in fully developed hypomanic states, however, in full-blown mania, these symptoms become progressively exacerbated."}}, {"canonical_name": "Digestive", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "digestive", "book_id": "english_physician_1652", "name": "Digestive", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Digestive"], "contexts": ["bodily virtue"]}, {"entity_id": "digestiou", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "digestiou", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["digestiou"], "contexts": ["process aided by fruit"]}, {"entity_id": "digestivo", "book_id": "coloquios_da_orta_1563", "name": "digestivo", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["digestivo"], "contexts": ["aiding digestion"]}, {"entity_id": "digestiva", "book_id": "coloquios_da_orta_1563", "name": "digestiva", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["digestiva"], "contexts": ["medicinal property of tamarind pulp"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Digestive", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "digestiou", "similarity": 0.925}, {"source_book": "english_physician_1652", "source_name": "Digestive", "target_book": "coloquios_da_orta_1563", "target_name": "digestivo", "similarity": 0.938}, {"source_book": "english_physician_1652", "source_name": "Digestive", "target_book": "coloquios_da_orta_1563", "target_name": "digestiva", "similarity": 0.93}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "digestiou", "target_book": "coloquios_da_orta_1563", "target_name": "digestivo", "similarity": 0.936}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "digestiou", "target_book": "coloquios_da_orta_1563", "target_name": "digestiva", "similarity": 0.925}], "id": 1884, "stable_key": "clu_66e6a252c823851d-2", "ground_truth": {"modern_name": "digestion", "confidence": "high", "type": "concept", "wikidata_id": "Q11978", "wikidata_description": "biological process of breaking down food and other matter", "wikipedia_url": "https://en.wikipedia.org/wiki/Maltodextrin", "wikipedia_extract": "Maltodextrin is a name shared by two different families of chemicals. Both families are glucose polymers (also called dextrose polymers or dextrins), but have little chemical or nutritional similarity. The digestible maltodextrins (or simply maltodextrins) are  manufactured as white solids derived from chemical processing of plant starches. They are used as food additives, which are digested rapidly, providing glucose as food energy. They are generally recognized as safe (GRAS) for food and beverage manufacturing in numerous products. Due to their rapid production of glucose, digestible maltodextrins are potential risks for people with diabetes.", "description": "The process of breaking down food for absorption by the body.", "note": "Can refer to the physiological process or a chemical preparation."}}, {"canonical_name": "people", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "people", "book_id": "english_physician_1652", "name": "People", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["People"], "contexts": ["general population"]}, {"entity_id": "people", "book_id": "kosmos_humboldt_1845", "name": "people", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["people"], "contexts": ["human beings"]}, {"entity_id": "people", "book_id": "first_principles_spencer_1862", "name": "people", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["people"], "contexts": ["human beings collectively", "population of a society"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "People", "target_book": "kosmos_humboldt_1845", "target_name": "people", "similarity": 0.994}, {"source_book": "english_physician_1652", "source_name": "People", "target_book": "first_principles_spencer_1862", "target_name": "people", "similarity": 0.994}, {"source_book": "kosmos_humboldt_1845", "source_name": "people", "target_book": "first_principles_spencer_1862", "target_name": "people", "similarity": 1.0}], "id": 1885, "stable_key": "clu_cefa23862f235c7f", "ground_truth": {"modern_name": "people", "confidence": "high", "type": "concept", "note": "The terms 'people' and 'persons' in these contexts refer to humans in a general sense, not specific individuals or groups of identifiable persons.", "wikidata_id": "Q15978631", "wikidata_description": "species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Homo%20sapiens"}}, {"canonical_name": "tristezas", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "sadness_of_the_spirits", "book_id": "english_physician_1652", "name": "sadness of the Spirits", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["sadness of the Spirits"], "contexts": ["low spirits or depression"]}, {"entity_id": "tristezas", "book_id": "historia_medicinal_monardes_1574", "name": "tristezas", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["tristezas", "tristeza"], "contexts": ["symptom of sadness", "sadness dispelled by gold coin"]}, {"entity_id": "tristeza", "book_id": "coloquios_da_orta_1563", "name": "tristeza", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["tristeza"], "contexts": ["effect of bangue on the person"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "sadness of the Spirits", "target_book": "historia_medicinal_monardes_1574", "target_name": "tristezas", "similarity": 0.931}, {"source_book": "english_physician_1652", "source_name": "sadness of the Spirits", "target_book": "coloquios_da_orta_1563", "target_name": "tristeza", "similarity": 0.932}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "tristezas", "target_book": "coloquios_da_orta_1563", "target_name": "tristeza", "similarity": 0.997}], "id": 1886, "stable_key": "clu_2356c4fedf30fafa", "ground_truth": {"modern_name": "Depression", "confidence": "high", "type": "disease", "modern_term": "Major depressive disorder", "note": "In early modern texts, 'depression of spirits' was a common descriptor for low mood and melancholy, which corresponds to modern understandings of depression.", "wikidata_id": "Q209190", "wikidata_description": "region of the atmosphere in which atmospheric pressure is lower than that of surrounding regions", "wikipedia_extract": "The Great Depression was a severe global economic downturn from 1929 to 1939. The period was characterized by high rates of unemployment and poverty, drastic reductions in industrial production and international trade, and widespread bank and business failures around the world. The economic contagion began in 1929 in the United States, the largest economy in the world, with the devastating Wall Street crash of 1929 often considered the beginning of the Depression. Among the countries with the most unemployed were the U.S., the United Kingdom, and Germany. The Depression was preceded by a period of industrial growth and social development known as the \"Roaring Twenties\". Much of the profit generated by the boom was invested in speculation, such as on the stock market, contributing to growing wealth inequality.", "wikipedia_url": "https://en.wikipedia.org/wiki/Great_Depression"}}, {"canonical_name": "grief", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "grief", "book_id": "english_physician_1652", "name": "grief", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["grief"], "contexts": ["inveterate condition treated by Pepperwort"]}, {"entity_id": "grief", "book_id": "principles_of_psychology_james_1890", "name": "grief", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["grief"], "contexts": ["emotional state experienced by the self", "intense emotional suffering"]}, {"entity_id": "sorrow", "book_id": "kosmos_humboldt_1845", "name": "sorrow", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["sorrow"], "contexts": ["shaking the heart"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "grief", "target_book": "principles_of_psychology_james_1890", "target_name": "grief", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "grief", "target_book": "kosmos_humboldt_1845", "target_name": "sorrow", "similarity": 0.936}, {"source_book": "principles_of_psychology_james_1890", "source_name": "grief", "target_book": "kosmos_humboldt_1845", "target_name": "sorrow", "similarity": 0.936}], "id": 1887, "stable_key": "clu_77335151757a4af4", "ground_truth": {"modern_name": "Grief", "confidence": "high", "type": "disease", "modern_term": "Grief reaction", "note": "The descriptions 'emotional state experienced by the self' and 'shaking the heart' strongly align with the concept of grief, which can be a significant emotional experience with physiological manifestations.", "wikidata_id": "Q1026040", "wikidata_description": "reaction to loss of someone or something close or important", "wikipedia_url": "https://en.wikipedia.org/wiki/Grief", "wikipedia_extract": "Grief is the response to the loss of something deemed important, in particular the death of a person or animal to which a bond or affection was formed. Although conventionally focused on the emotional response to loss, grief also has physical, cognitive, behavioral, social, cultural, spiritual, political and philosophical dimensions. While the terms are often used interchangeably, bereavement refers to the state of loss, while grief is the reaction to that loss. The grief associated with death is familiar to most people, but individuals grieve in connection with a variety of losses throughout their lives, such as unemployment, ill health or the end of a relationship. Loss can be categorized as either physical or abstract; physical loss is related to something that the individual can touch or measure, such as losing a spouse through death, while other types of loss are more abstract, possibly relating to aspects of a person's social interactions. Modern research has moved beyond rigid stage-based models, such as K\u00fcbler-Ross's five stages, toward more flexible frameworks."}}, {"canonical_name": "persons", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "persons", "book_id": "english_physician_1652", "name": "persons", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["persons"], "contexts": ["Chollerick persons"]}, {"entity_id": "persons", "book_id": "principles_of_psychology_james_1890", "name": "persons", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["persons"], "contexts": ["human individuals involved in an event", "individuals encountered"]}, {"entity_id": "persons", "book_id": "first_principles_spencer_1862", "name": "persons", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["persons"], "contexts": ["human beings"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "persons", "target_book": "principles_of_psychology_james_1890", "target_name": "persons", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "persons", "target_book": "first_principles_spencer_1862", "target_name": "persons", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "persons", "target_book": "first_principles_spencer_1862", "target_name": "persons", "similarity": 1.0}], "id": 1888, "stable_key": "clu_2e77d4624a411628", "ground_truth": {"modern_name": "people", "confidence": "high", "type": "concept", "note": "The terms 'people' and 'persons' in these contexts refer to humans in a general sense, not specific individuals or groups of identifiable persons.", "wikidata_id": "Q15978631", "wikidata_description": "species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Homo%20sapiens"}}, {"canonical_name": "Salt-water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "salt_water", "book_id": "english_physician_1652", "name": "Salt water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Salt water"], "contexts": ["water that Scurvy-grass feeds upon"]}, {"entity_id": "salt-water", "book_id": "origin_of_species_darwin_1859", "name": "Salt-water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["salt-water", "Salt-water"], "contexts": ["seeds in", "saline water"]}, {"entity_id": "salt_water", "book_id": "connexion_physical_sciences_somerville_1858", "name": "salt water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["salt water"], "contexts": ["contact with earth generates positive electricity"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Salt water", "target_book": "origin_of_species_darwin_1859", "target_name": "Salt-water", "similarity": 0.953}, {"source_book": "english_physician_1652", "source_name": "Salt water", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "salt water", "similarity": 0.983}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Salt-water", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "salt water", "similarity": 0.957}], "id": 1889, "stable_key": "clu_6ce91532ead772a6", "ground_truth": {"modern_name": "Saltwater", "confidence": "high", "type": "concept", "wikidata_id": "Q182599", "wikidata_description": "species of reptile"}}, {"canonical_name": "inflamma\u00e7oens dos olhos", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "inflamations_in_the_eyes", "book_id": "english_physician_1652", "name": "Inflamations in the Eyes", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["Inflamations in the Eyes"], "contexts": ["condition taken away by oil and quince"]}, {"entity_id": "inflamaciones_de_los_ojos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "inflamaciones de los ojos", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["inflamaciones de los ojos"], "contexts": ["goma cures eye inflammations"]}, {"entity_id": "inflamma\u00e7oens_dos_olhos", "book_id": "polyanthea_medicinal", "name": "inflamma\u00e7oens dos olhos", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["inflamma\u00e7oens dos olhos"], "contexts": ["chapter title about eye inflammations", "inflammation of the eyes"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Inflamations in the Eyes", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "inflamaciones de los ojos", "similarity": 0.956}, {"source_book": "english_physician_1652", "source_name": "Inflamations in the Eyes", "target_book": "polyanthea_medicinal", "target_name": "inflamma\u00e7oens dos olhos", "similarity": 0.898}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "inflamaciones de los ojos", "target_book": "polyanthea_medicinal", "target_name": "inflamma\u00e7oens dos olhos", "similarity": 0.889}], "id": 1890, "stable_key": "clu_c5f6aafc0160d062-2", "ground_truth": {"modern_name": "Eye inflammation", "confidence": "high", "type": "disease", "modern_term": "Ocular inflammation", "wikidata_id": "Q2971524", "wikidata_description": "human disease"}}, {"canonical_name": "redness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "reddish", "book_id": "english_physician_1652", "name": "reddish", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["reddish"], "contexts": ["colour of Vipers Buglofs buds"]}, {"entity_id": "redness", "book_id": "principles_of_psychology_james_1890", "name": "redness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["redness"], "contexts": ["quality of being red"]}, {"entity_id": "redness", "book_id": "connexion_physical_sciences_somerville_1858", "name": "redness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["redness"], "contexts": ["color indicating high temperature"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "reddish", "target_book": "principles_of_psychology_james_1890", "target_name": "redness", "similarity": 0.886}, {"source_book": "english_physician_1652", "source_name": "reddish", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "redness", "similarity": 0.886}, {"source_book": "principles_of_psychology_james_1890", "source_name": "redness", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "redness", "similarity": 1.0}], "id": 1891, "stable_key": "clu_27697870422f1797", "ground_truth": {"modern_name": "Redness", "confidence": "high", "type": "concept", "wikidata_id": "Q1166142", "wikidata_description": "symptom", "wikipedia_url": "https://en.wikipedia.org/wiki/Erythema", "wikipedia_extract": "Erythema (Ancient Greek: \u1f10\u03c1\u03cd\u03b8\u03b7\u03bc\u03b1, from Greek  erythros 'red') is redness of the skin or mucous membranes, caused by hyperemia (increased blood flow) in superficial capillaries. It occurs with any skin injury, infection, or inflammation. Examples of erythema not associated with pathology include nervous blushes. It can be caused by infection, massage, electrical treatment, acne medication, allergies, psoriasis, mast cell activation syndrome (MCAS), exercise, solar radiation (sunburn), photosensitization, acute radiation syndrome, mercury toxicity, blister agents, niacin administration, or waxing and tweezing of the hairs\u2014any of which can cause the affected capillaries to dilate, resulting in redness. Erythema is a common side effect of radiotherapy treatment due to patient exposure to ionizing radiation. Erythema disappears on finger pressure (blanching), whereas purpura or bleeding in the skin and pigmentation do not."}}, {"canonical_name": "dissolve", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "dissolves", "book_id": "english_physician_1652", "name": "Dissolves", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Dissolves"], "contexts": ["to break down or liquefy"]}, {"entity_id": "disoluere", "book_id": "ricettario_fiorentino_1597", "name": "Disoluere", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Disoluere"], "contexts": ["process of dissolving"]}, {"entity_id": "dissolve", "book_id": "polyanthea_medicinal", "name": "dissolve", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["dissolve", "disolvendo"], "contexts": ["action of mercury on humors", "medical manipulation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Dissolves", "target_book": "polyanthea_medicinal", "target_name": "dissolve", "similarity": 0.891}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Disoluere", "target_book": "polyanthea_medicinal", "target_name": "dissolve", "similarity": 0.906}], "id": 1892, "stable_key": "clu_66604fd0dff01882", "ground_truth": {"modern_name": "dissolution", "confidence": "high", "type": "concept", "wikidata_id": "Q3133701", "wikidata_description": "process of a solute dissolving in a solvent", "wikipedia_url": "https://en.wikipedia.org/wiki/Pralaya", "wikipedia_extract": "Pralaya (Sanskrit: \u092a\u094d\u0930\u0932\u092f, romanized: Pralaya, lit. 'Destruction') is a concept in Hindu eschatology. Generally referring to four different phenomena, it is most commonly used to indicate the event of the dissolution of the entire universe that follows a kalpa (a period of 4.32 billion years) called the Brahmapralaya. Pralaya also refers to Nityapralaya, the continuous destruction of all animate and inanimate beings that occurs on a daily basis, Prakritapralaya, the great flood produced by Prakriti (Nature) that ends all of creation after the completion of 1,000 Chaturyuga (four-age) cycles, and Atyantikapralaya, the dissolution of one's Atman (Self) due to its union with Brahman (Ultimate Reality). A concept that has been referenced in literature since the Upanishads, the concept of pralaya has been widely discussed in Hindu cosmology as well as philosophy. Hindu cosmology posits an endless cycle of the periodic creation and destruction of the universe."}}, {"canonical_name": "Staffordshire", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "staffordshire", "book_id": "origin_of_species_darwin_1859", "name": "Staffordshire", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Staffordshire"], "contexts": ["location of investigation", "location where insects affect birds"]}, {"entity_id": "staffordshire", "book_id": "kosmos_humboldt_1845", "name": "Staffordshire", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Staffordshire"], "contexts": ["county in England"]}, {"entity_id": "staffordshire", "book_id": "first_principles_spencer_1862", "name": "Staffordshire", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Staffordshire"], "contexts": ["pottery-manufacture"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Staffordshire", "target_book": "kosmos_humboldt_1845", "target_name": "Staffordshire", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Staffordshire", "target_book": "first_principles_spencer_1862", "target_name": "Staffordshire", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Staffordshire", "target_book": "first_principles_spencer_1862", "target_name": "Staffordshire", "similarity": 1.0}], "id": 1893, "stable_key": "clu_81acb50f7318423f", "ground_truth": {"modern_name": "Staffordshire", "confidence": "high", "type": "place", "country": "United Kingdom", "wikipedia_extract": "Cheadle is a market town and civil parish in the Staffordshire Moorlands District of Staffordshire, England. It is located between Uttoxeter, Leek, Ashbourne and Stoke-on-Trent. Dating back to Anglo-Saxon times, it lies within the historic Staffordshire Hundred of Totmonslow. In 2011 the parish had a population of 12,165. Cheadle is first attested in the Domesday Book of 1086, in the forms Celle and Cedla. The first part of the name comes from the Common Brittonic word which survives in modern Welsh as coed (\"woodland\"), and was thus once a place-name meaning \"wood\".", "wikipedia_url": "https://en.wikipedia.org/wiki/Cheadle,_Staffordshire"}}, {"canonical_name": "organic world", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "organic_world", "book_id": "origin_of_species_darwin_1859", "name": "organic world", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["organic world"], "contexts": ["the realm of living organisms"]}, {"entity_id": "organic_world", "book_id": "principles_of_psychology_james_1890", "name": "organic world", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic world"], "contexts": ["living organisms and their properties"]}, {"entity_id": "organic_world", "book_id": "kosmos_humboldt_1845", "name": "organic world", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic world"], "contexts": ["the realm of living things"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "organic world", "target_book": "principles_of_psychology_james_1890", "target_name": "organic world", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "organic world", "target_book": "kosmos_humboldt_1845", "target_name": "organic world", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "organic world", "target_book": "kosmos_humboldt_1845", "target_name": "organic world", "similarity": 1.0}], "id": 1894, "stable_key": "clu_72ee84fa272d155d", "ground_truth": {"modern_name": "organic world", "confidence": "high", "type": "concept"}}, {"canonical_name": "inhabitants", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "inhabitants", "book_id": "origin_of_species_darwin_1859", "name": "inhabitants", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["inhabitants"], "contexts": ["organisms living in a place", "whenever their inhabitants met"]}, {"entity_id": "habitans", "book_id": "relation_historique_humboldt_vol3_1825", "name": "habitans", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["habitans"], "contexts": ["inhabitants"]}, {"entity_id": "inhabitants", "book_id": "first_principles_spencer_1862", "name": "inhabitants", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["inhabitants"], "contexts": ["residents of a place"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "inhabitants", "target