able_key": "clu_02e213bcd64b23ca", "ground_truth": {"modern_name": "Culture", "confidence": "high", "type": "concept", "note": "This cluster encompasses both intellectual/civilizational development and agricultural practices.", "wikidata_id": "Q42053", "wikidata_description": "city in Isfahan Province, Iran", "wikipedia_url": "https://en.wikipedia.org/wiki/Isfahan"}}, {"canonical_name": "\u00c9thiopiens", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "\u00e9thiopiens", "book_id": "epoques_nature_buffon_1778", "name": "\u00c9thiopiens", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["\u00c9thiopiens"], "contexts": ["people who adopted metempsychosis"]}, {"entity_id": "\u00e9thiopiens", "book_id": "relation_historique_humboldt_vol3_1825", "name": "\u00c9thiopiens", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["\u00c9thiopiens"], "contexts": ["people from Ethiopia"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "\u00c9thiopiens", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "\u00c9thiopiens", "similarity": 0.895}], "id": 5327, "stable_key": "clu_a6eecf18423b55ef-2", "ground_truth": {"modern_name": "Ethiopia", "confidence": "high", "type": "place", "country": "Ethiopia", "note": "The spelling '\u00c6thiopia' and 'Eti\u00f3pia' are historical variants of Ethiopia.", "wikidata_id": "Q115", "wikidata_description": "country in the Horn of Africa", "wikipedia_url": "https://en.wikipedia.org/wiki/Ethiopia", "wikipedia_extract": "Ethiopia, officially the Federal Democratic Republic of Ethiopia, is a landlocked country located in the Horn of Africa region of East Africa. It shares borders with Eritrea to the north, Djibouti to the northeast, Somalia to the east, Kenya to the south, South Sudan to the west, and Sudan to the northwest. Ethiopia covers a land area of 1,104,300 square kilometres (426,400 sq mi). As of 2025, it has around 135 million inhabitants, making it the 14th-most populous country. The national capital and largest city, Addis Ababa, lies several kilometres west of the East African Rift that splits the country into the African and Somali tectonic plates. Anatomically modern humans emerged from modern-day Ethiopia.", "description": "A country in Eastern Africa, historically known as Abyssinia."}}, {"canonical_name": "\u00c9thiopie", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "\u00e9thiopie", "book_id": "epoques_nature_buffon_1778", "name": "\u00c9thiopie", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["\u00c9thiopie"], "contexts": ["ancient empire"]}, {"entity_id": "ediiopia", "book_id": "coloquios_da_orta_1563", "name": "Ediiopia", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Ediiopia"], "contexts": ["region sometimes included in India"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "\u00c9thiopie", "target_book": "coloquios_da_orta_1563", "target_name": "Ediiopia", "similarity": 0.945}], "id": 5328, "stable_key": "clu_a6eecf18423b55ef-3", "ground_truth": {"modern_name": "Ethiopia", "confidence": "high", "type": "place", "country": "Ethiopia", "note": "The spelling '\u00c6thiopia' and 'Eti\u00f3pia' are historical variants of Ethiopia.", "wikidata_id": "Q115", "wikidata_description": "country in the Horn of Africa", "wikipedia_url": "https://en.wikipedia.org/wiki/Ethiopia", "wikipedia_extract": "Ethiopia, officially the Federal Democratic Republic of Ethiopia, is a landlocked country located in the Horn of Africa region of East Africa. It shares borders with Eritrea to the north, Djibouti to the northeast, Somalia to the east, Kenya to the south, South Sudan to the west, and Sudan to the northwest. Ethiopia covers a land area of 1,104,300 square kilometres (426,400 sq mi). As of 2025, it has around 135 million inhabitants, making it the 14th-most populous country. The national capital and largest city, Addis Ababa, lies several kilometres west of the East African Rift that splits the country into the African and Somali tectonic plates. Anatomically modern humans emerged from modern-day Ethiopia.", "description": "A country in Eastern Africa, historically known as Abyssinia."}}, {"canonical_name": "landes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "landes", "book_id": "epoques_nature_buffon_1778", "name": "landes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["landes"], "contexts": ["heathlands cultivated by humans"]}, {"entity_id": "landes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Landes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Landes"], "contexts": ["department in France"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "landes", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Landes", "similarity": 0.9}], "id": 5329, "stable_key": "clu_1749899d3c39a34c", "ground_truth": {"modern_name": "Landes", "confidence": "high", "type": "place", "country": "France", "note": "Refers to both natural heathlands and the department in France.", "wikidata_id": "Q21506837", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Landes%20%28surname%29"}}, {"canonical_name": "espaces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "espaces", "book_id": "epoques_nature_buffon_1778", "name": "espaces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["espaces"], "contexts": ["space measured and understood"]}, {"entity_id": "spaces", "book_id": "principles_of_psychology_james_1890", "name": "Spaces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Spaces"], "contexts": ["abstract concept of extent"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "espaces", "target_book": "principles_of_psychology_james_1890", "target_name": "Spaces", "similarity": 0.928}], "id": 5330, "stable_key": "clu_82da87fcf7ac989f-3", "ground_truth": {"modern_name": "space", "confidence": "high", "type": "concept", "wikidata_id": "Q1", "wikidata_description": "totality consisting of space, time, matter and energy", "wikipedia_url": "https://en.wikipedia.org/wiki/Universe", "wikipedia_extract": "The universe is all of space and time and their contents. It comprises all of existence, any fundamental interaction, physical process and physical constant, and therefore all forms of matter and energy, and the structures they form, from sub-atomic particles to entire galactic filaments. Since the early 20th century, the field of cosmology establishes that space and time emerged together at the Big Bang 13.787\u00b10.020 billion years ago and that the universe has been expanding since then. The portion of the universe that can be seen by humans is approximately 93 billion light-years in diameter at present, but the total size of the universe is not known. Some of the earliest cosmological models of the universe were geocentric, placing Earth at the center. During the European Scientific Revolution, astronomical observations led to a heliocentric model."}}, {"canonical_name": "Gaules", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "gaules", "book_id": "epoques_nature_buffon_1778", "name": "Gaules", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Gaules"], "contexts": ["historical region in Europe"]}, {"entity_id": "gaules", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Gaules", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Gaules"], "contexts": ["region where man fought nature"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Gaules", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Gaules", "similarity": 0.887}], "id": 5331, "stable_key": "clu_4b8467fdbe254e41", "ground_truth": {"modern_name": "Gaul", "confidence": "high", "type": "place", "country": "France", "note": "Refers to the historical region of Gaul in ancient Europe.", "wikidata_id": "Q1626776", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Gaultheria"}}, {"canonical_name": "tulipes", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "tulipes", "book_id": "epoques_nature_buffon_1778", "name": "tulipes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["tulipes"], "contexts": ["tulips, flowers from 150 years ago"]}, {"entity_id": "tulipis", "book_id": "polyanthea_medicinal", "name": "Tulipis", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Tulipis"], "contexts": ["flower mentioned for variety"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "tulipes", "target_book": "polyanthea_medicinal", "target_name": "Tulipis", "similarity": 0.945}], "id": 5332, "stable_key": "clu_041c1f06d04fc086", "ground_truth": {"modern_name": "Tulip", "confidence": "high", "type": "plant", "linnaean": "Tulipa L.", "family": "Liliaceae", "wikidata_id": "Q93201", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Tulip"}}, {"canonical_name": "germes", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "germes", "book_id": "epoques_nature_buffon_1778", "name": "germes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["germes"], "contexts": ["seeds or buds for propagation"]}, {"entity_id": "germs", "book_id": "first_principles_spencer_1862", "name": "germs", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["germs"], "contexts": ["early stage of life"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "germes", "target_book": "first_principles_spencer_1862", "target_name": "germs", "similarity": 0.986}], "id": 5333, "stable_key": "clu_83e91151aaf730b7", "ground_truth": {"modern_name": "seed or bud", "confidence": "medium", "type": "plant", "note": "The term 'germes' and 'germs' in this context refers to the reproductive parts of plants (seeds or buds) from which new life emerges, rather than the microbial sense.", "wikidata_id": "Q40763", "wikidata_description": "embryonic plant enclosed in a protective outer covering (seed coat)", "wikipedia_url": "https://en.wikipedia.org/wiki/Seed"}}, {"canonical_name": "esp\u00e8ces \u00e9trang\u00e8res", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "esp\u00e8ces_\u00e9trang\u00e8res", "book_id": "epoques_nature_buffon_1778", "name": "esp\u00e8ces \u00e9trang\u00e8res", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["esp\u00e8ces \u00e9trang\u00e8res"], "contexts": ["plants from other regions"]}, {"entity_id": "exotic_plants", "book_id": "kosmos_humboldt_1845", "name": "exotic plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["exotic plants"], "contexts": ["plants from foreign regions"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "esp\u00e8ces \u00e9trang\u00e8res", "target_book": "kosmos_humboldt_1845", "target_name": "exotic plants", "similarity": 0.93}], "id": 5334, "stable_key": "clu_e35c8d9de7aaf6a8", "ground_truth": {"modern_name": "exotic plants", "confidence": "high", "type": "plant", "wikidata_id": "Q121796853", "wikidata_description": "ecological concept"}}, {"canonical_name": "war", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "war", "book_id": "epoques_nature_buffon_1778", "name": "war", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["war"], "contexts": ["state of armed conflict"]}, {"entity_id": "war", "book_id": "relation_historique_humboldt_vol3_1825", "name": "war", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["war"], "contexts": ["cause of population decline"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "war", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "war", "similarity": 1.0}], "id": 5335, "stable_key": "clu_87b2ba21509bba76-2", "ground_truth": {"modern_name": "War", "confidence": "high", "type": "concept", "wikidata_id": "Q198", "wikidata_description": "organized and prolonged violent conflict between different nations, states, or different groups within a nation or state", "wikipedia_url": "https://en.wikipedia.org/wiki/War", "wikipedia_extract": "War is an armed conflict between the armed forces of states, or between governmental forces and armed groups that are organized under a certain command structure and have the capacity to sustain military operations, or between such organized groups. It is generally characterized by widespread violence, destruction, and mortality, using regular or irregular military forces. Warfare refers to the common activities and characteristics of types of war, or of wars in general. Total war is warfare that is not restricted to purely legitimate military targets, and can result in massive civilian or other non-combatant suffering and casualties. War has changed in numerous ways over the course of history. Since 1945, great power wars, territorial conquests and war declarations have declined in frequency."}}, {"canonical_name": "Nebuchadnezzar", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "nebuchadnezzar", "book_id": "english_physician_1652", "name": "Nebuchadnezzar", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Nebuchadnezzar"], "contexts": ["carried writings to Babylon"]}, {"entity_id": "nebuchadnezzar", "book_id": "coloquios_da_orta_1563", "name": "Nebuchadnezzar", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Nebuchadnezzar"], "contexts": ["king whose name was stamped on bricks"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Nebuchadnezzar", "target_book": "coloquios_da_orta_1563", "target_name": "Nebuchadnezzar", "similarity": 0.851}], "id": 5336, "stable_key": "clu_b24c4be475b156f9", "ground_truth": {"wikipedia_extract": "Nebuchadnezzar II, also Nebuchadrezzar II, meaning \"Nabu, watch over my heir\", was the second king of the Neo-Babylonian Empire, ruling from the death of his father Nabopolassar in 605 BC to his own death in 562 BC. Often titled Nebuchadnezzar the Great, he is regarded as the empire's greatest king, famous for his military campaigns in the Levant and their role in Jewish history, and for his construction projects in his capital of Babylon, including the Hanging Gardens of Babylon. Ruling for 43 years, Nebuchadnezzar was the longest-reigning king of the Babylonian dynasty. By the time of his death, he was among the most powerful rulers in the world. Possibly named after his grandfather of the same name or after Nebuchadnezzar I, one of Babylon's greatest warrior-kings, Nebuchadnezzar II had already secured renown for himself during his father's reign, leading armies in the Medo-Babylonian conquest of the Assyrian Empire. At the Battle of Carchemish in 605 BC, Nebuchadnezzar inflicted a crushing defeat on an Egyptian army led by Pharaoh Necho II and ensured that the Neo-Babylonian Empire would succeed the Neo-Assyrian Empire as the dominant power in the ancient Near East."}}, {"canonical_name": "Printing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "printing", "book_id": "english_physician_1652", "name": "Printing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Printing"], "contexts": ["charge for Mathiolus' work"]}, {"entity_id": "printing", "book_id": "first_principles_spencer_1862", "name": "printing", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["printing"], "contexts": ["method of mass reproduction of text"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Printing", "target_book": "first_principles_spencer_1862", "target_name": "printing", "similarity": 0.98}], "id": 5337, "stable_key": "clu_4234baaaf3a8b712", "ground_truth": {"modern_name": "Printing", "confidence": "high", "type": "concept", "wikidata_id": "Q11034", "wikidata_description": "process for reproducing text and images using a master form or template"}}, {"canonical_name": "Kings", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "kings", "book_id": "english_physician_1652", "name": "Kings", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Kings"], "contexts": ["maintained Bellonius in studies"]}, {"entity_id": "kings", "book_id": "first_principles_spencer_1862", "name": "kings", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["kings"], "contexts": ["human agents in power"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Kings", "target_book": "first_principles_spencer_1862", "target_name": "kings", "similarity": 0.654}], "id": 5338, "stable_key": "clu_cd06d10b0e6e6839-2", "ground_truth": {"modern_name": "Queen", "confidence": "high", "type": "person", "description": "A female monarch, often a patron of arts and sciences.", "note": "This refers to a generic queen, not a specific individual.", "wikidata_id": "Q116", "wikidata_description": "person at the head of a monarchy"}}, {"canonical_name": "Students", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "students", "book_id": "english_physician_1652", "name": "Students", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Students"], "contexts": ["learners of medicine"]}, {"entity_id": "students", "book_id": "principles_of_psychology_james_1890", "name": "students", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["students"], "contexts": ["learners in experiments"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Students", "target_book": "principles_of_psychology_james_1890", "target_name": "students", "similarity": 0.991}], "id": 5339, "stable_key": "clu_1ccd9a986041fd9a", "ground_truth": {"modern_name": "Students", "confidence": "high", "type": "person", "description": "Individuals engaged in learning and research", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Novemb.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "novemb_", "book_id": "english_physician_1652", "name": "Novemb.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Novemb."], "contexts": ["month of the year"]}, {"entity_id": "nov_", "book_id": "kosmos_humboldt_1845", "name": "Nov.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Nov."], "contexts": ["month of writing"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Novemb.", "target_book": "kosmos_humboldt_1845", "target_name": "Nov.", "similarity": 0.88}], "id": 5340, "stable_key": "clu_1848f332223afed4-3", "ground_truth": {"modern_name": "November", "confidence": "high", "type": "concept", "note": "Refers to the month of November, used for meteorological and observational records.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Bauhine", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bauhine", "book_id": "english_physician_1652", "name": "Bauhine", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bauhine"], "contexts": ["Renaissance botanist"]}, {"entity_id": "bauhino", "book_id": "coloquios_da_orta_1563", "name": "Bauhino", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bauhino"], "contexts": ["mentioned in relation to fruit comparison"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Bauhine", "target_book": "coloquios_da_orta_1563", "target_name": "Bauhino", "similarity": 0.866}], "id": 5341, "stable_key": "clu_084f65c637b3a3dc", "ground_truth": {"modern_name": "Gaspard Bauhin", "confidence": "high", "type": "person", "birth_year": 1560, "death_year": 1624, "description": "Swiss botanist who formalized plant binomial nomenclature."}}, {"canonical_name": "Gerrhard", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "gerrhard", "book_id": "english_physician_1652", "name": "Gerrhard", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Gerrhard"], "contexts": ["author"]}, {"entity_id": "eckhard", "book_id": "principles_of_psychology_james_1890", "name": "Eckhard", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Eckhard"], "contexts": ["cited physiologist"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Gerrhard", "target_book": "principles_of_psychology_james_1890", "target_name": "Eckhard", "similarity": 0.859}], "id": 5342, "stable_key": "clu_eabfac8533613e89", "ground_truth": {"modern_name": "Johann Daniel Tacke", "confidence": "high", "type": "person", "birth_year": 1629, "death_year": 1707, "description": "German physician and alchemist, known for his chemical studies.", "note": "The spelling 'Gerrhard' and 'Eckhard' are likely misspellings or variations of Tacke's name, common in early texts. He is sometimes referred to as Daniel Tackius or Daniel Eckhardus."}}, {"canonical_name": "Gods Anger", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "gods_anger", "book_id": "english_physician_1652", "name": "Gods Anger", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Gods Anger"], "contexts": ["time of"]}, {"entity_id": "ira_dedeos", "book_id": "polyanthea_medicinal", "name": "ira deDeos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ira deDeos"], "contexts": ["wrath of God, to be appeased"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Gods Anger", "target_book": "polyanthea_medicinal", "target_name": "ira deDeos", "similarity": 0.936}], "id": 5343, "stable_key": "clu_8386b35be350c7ef", "ground_truth": {"modern_name": "Divine Retribution", "confidence": "high", "type": "concept"}}, {"canonical_name": "enflamed", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "enflamed", "book_id": "english_physician_1652", "name": "enflamed", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["enflamed"], "contexts": ["eyes treated with rotten apple"]}, {"entity_id": "inflammada", "book_id": "polyanthea_medicinal", "name": "inflammada", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["inflammada"], "contexts": ["inflamed"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "enflamed", "target_book": "polyanthea_medicinal", "target_name": "inflammada", "similarity": 0.924}], "id": 5344, "stable_key": "clu_25c467b913b70a42", "ground_truth": {"modern_name": "inflammation", "confidence": "high", "type": "disease", "modern_term": "inflammation", "note": "This cluster refers to the general symptom of inflammation rather than a specific disease.", "wikidata_id": "Q14819849", "wikidata_description": "immediate defensive reaction (by vertebrate tissue) to infection or injury caused by chemical or physical agents, characterized by local vasodilation, extravasation of plasma into intercellular spaces and accumulation of white blood cells"}}, {"canonical_name": "Obstructions of the Brain", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "obstructions_of_the_brain", "book_id": "english_physician_1652", "name": "Obstructions of the Brain", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["Obstructions of the Brain"], "contexts": ["opened by Balm"]}, {"entity_id": "obftruc\u00e7\u00f5es_do_cerebro", "book_id": "polyanthea_medicinal", "name": "obftruc\u00e7\u00f5es do cerebro", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["obftruc\u00e7\u00f5es do cerebro"], "contexts": ["blockages in the brain"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Obstructions of the Brain", "target_book": "polyanthea_medicinal", "target_name": "obftruc\u00e7\u00f5es do cerebro", "similarity": 0.93}], "id": 5345, "stable_key": "clu_d191dde33b1a4f32", "ground_truth": {"modern_name": "Cerebral obstruction", "confidence": "high", "type": "disease", "modern_term": "Cerebral obstruction", "note": "This refers to blockages or impediments within the brain, not a specific modern diagnosis.", "wikipedia_extract": "Cerebral venous sinus thrombosis (CVST), cerebral venous and sinus thrombosis or cerebral venous thrombosis (CVT), is the presence of a blood clot in the dural venous sinuses (which drain blood from the brain), the cerebral veins, or both. Symptoms may include severe headache, visual symptoms, any of the symptoms of stroke such as weakness of the face and limbs on one side of the body, and seizures, which occur in around 40% of patients. The diagnosis is usually by computed tomography (CT scan) or magnetic resonance imaging (MRI) to demonstrate obstruction of the venous sinuses. After confirmation of the diagnosis, investigations may be performed to determine the underlying cause, especially if one is not readily apparent. Treatment is typically with anticoagulants (medications that suppress blood clotting) such as low molecular weight heparin. Rarely, thrombolysis (enzymatic destruction of the blood clot) or mechanical thrombectomy is used, although evidence for this therapy is limited.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cerebral_venous_sinus_thrombosis"}}, {"canonical_name": "Venoms", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "venoms", "book_id": "english_physician_1652", "name": "Venoms", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Venoms"], "contexts": ["harmful substances"]}, {"entity_id": "venenop", "book_id": "polyanthea_medicinal", "name": "venenop", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["venenop"], "contexts": ["poison"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Venoms", "target_book": "polyanthea_medicinal", "target_name": "venenop", "similarity": 0.894}], "id": 5346, "stable_key": "clu_256e6a5d91982262", "ground_truth": {"modern_name": "Venom", "confidence": "high", "type": "disease", "modern_term": "Poisoning", "note": "While 'venoms' can refer to the biological substance injected by venomous animals, in early modern medical texts, it often described conditions caused by such substances or by ingested poisons, aligning with 'poisoning' as a broader medical concept. 'Venenop' also directly translates to 'venomous' or 'poisonous'."}}, {"canonical_name": "Bruscus", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bruscus", "book_id": "english_physician_1652", "name": "Bruscus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Bruscus"], "contexts": ["alternative name for Butchers-Broom"]}, {"entity_id": "bruscus", "book_id": "coloquios_da_orta_1563", "name": "bruscus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["bruscus"], "contexts": ["alternative name for ruscus"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Bruscus", "target_book": "coloquios_da_orta_1563", "target_name": "bruscus", "similarity": 0.688}], "id": 5347, "stable_key": "clu_741e03dd9813e32f", "ground_truth": {"modern_name": "Butcher's Broom", "confidence": "high", "type": "plant", "linnaean": "Ruscus aculeatus Linnaeus", "family": "Asparagaceae", "note": "'Bruscus' is an older or alternative name for Butcher's Broom, which is taxonomically classified as *Ruscus aculeatus*.", "wikidata_id": "Q161425", "wikidata_description": "mesquito"}}, {"canonical_name": "Bellows", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bellows", "book_id": "english_physician_1652", "name": "Bellows", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Bellows"], "contexts": ["example of windy food"]}, {"entity_id": "bellows", "book_id": "connexion_physical_sciences_somerville_1858", "name": "bellows", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["bellows"], "contexts": ["provides air for organ"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Bellows", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "bellows", "similarity": 0.655}], "id": 5348, "stable_key": "clu_b26e2b6e5229d87a", "ground_truth": {"modern_name": "Bellows", "confidence": "high", "type": "object", "note": "Bellows were a common tool in many early modern trades and household activities, including providing air for fires and mechanical devices.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Colechester", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "colechester", "book_id": "english_physician_1652", "name": "Colechester", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Colechester"], "contexts": ["place in Essex where Sea Colewort grows"]}, {"entity_id": "colchester", "book_id": "kosmos_humboldt_1845", "name": "Colchester", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Colchester"], "contexts": ["location of William Gilbert"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Colechester", "target_book": "kosmos_humboldt_1845", "target_name": "Colchester", "similarity": 0.896}], "id": 5349, "stable_key": "clu_a14bd85c4abfb66f", "ground_truth": {"modern_name": "Colchester", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q184163", "wikidata_description": "city in Essex, England, UK", "wikipedia_url": "https://en.wikipedia.org/wiki/Colchester", "wikipedia_extract": "Colchester (  KO(H)L-chest-\u0259r, -\u2060chist-) is a city in north-eastern Essex, England. At the 2021 census the built up area had a population of 130,245, making it the second-largest settlement in Essex, after Southend-on-Sea. It gives its name to the wider Colchester local government district which also covers an extensive surrounding area. The demonym is Colcestrian. Colchester occupies the site of Camulodunum, the first major city in Roman Britain and its first capital. Colchester therefore claims to be Britain's first city."}}, {"canonical_name": "flowing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "flowing", "book_id": "english_physician_1652", "name": "flowing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["flowing"], "contexts": ["overmuch flow of courses"]}, {"entity_id": "flow", "book_id": "kosmos_humboldt_1845", "name": "flow", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["flow"], "contexts": ["movement of fluid or gas"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "flowing", "target_book": "kosmos_humboldt_1845", "target_name": "flow", "similarity": 0.869}], "id": 5350, "stable_key": "clu_bd9e0248364a7820", "ground_truth": {"modern_name": "Flow", "confidence": "high", "type": "concept", "note": "This refers to the general concept of movement, particularly of fluids or gases, as well as abstract concepts like the 'flow of courses' (e.g., of humors or bodily fluids).", "wikidata_id": "Q355304", "wikidata_description": "any flowing body of water"}}, {"canonical_name": "Chelidonium", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "chelidonium", "book_id": "english_physician_1652", "name": "Chelidonium", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Chelidonium"], "contexts": ["name of the herb"]}, {"entity_id": "chalidunium", "book_id": "coloquios_da_orta_1563", "name": "Chalidunium", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Chalidunium"], "contexts": ["variant name for Chelidonium"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Chelidonium", "target_book": "coloquios_da_orta_1563", "target_name": "Chalidunium", "similarity": 0.882}], "id": 5351, "stable_key": "clu_8542149423b836c8", "ground_truth": {"wikipedia_extract": "Chelidonium, commonly known as celandines, is a small genus of flowering plants in the poppy family, This genus is native to northern Africa and Eurasia, where they are widespread, ranging from western Europe to east Asia. This genus consists of herbaceous perennials. Leaves are alternate and deeply lobed. They produce yellow flowers. Chelidonium is a small genus, consisting of two accepted species."}}, {"canonical_name": "Cherries", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cherries", "book_id": "english_physician_1652", "name": "Cherries", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Cherries"], "contexts": ["fruits with different tastes and qualities"]}, {"entity_id": "cherries", "book_id": "principles_of_psychology_james_1890", "name": "cherries", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cherries"], "contexts": ["small, round, red fruit"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Cherries", "target_book": "principles_of_psychology_james_1890", "target_name": "cherries", "similarity": 0.897}], "id": 5352, "stable_key": "clu_fd567b0b8c654156", "ground_truth": {"modern_name": "Cherry", "confidence": "high", "type": "plant", "linnaean": "Prunus spp.", "family": "Rosaceae", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Season", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "season", "book_id": "english_physician_1652", "name": "Season", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Season"], "contexts": ["change of season that is coming"]}, {"entity_id": "seasons", "book_id": "kosmos_humboldt_1845", "name": "seasons", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["seasons"], "contexts": ["divisions of the year"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Season", "target_book": "kosmos_humboldt_1845", "target_name": "seasons", "similarity": 0.895}], "id": 5353, "stable_key": "clu_83d76fcb5332bb6f-2", "ground_truth": {"modern_name": "Season", "confidence": "high", "type": "concept", "note": "The contexts clearly indicate the divisions of the year and their relation to celestial mechanics and natural phenomena.", "wikidata_id": "Q27020041", "wikidata_description": "season of a sports league or competition, generally a specific one year period", "wikipedia_url": "https://en.wikipedia.org/wiki/Season%20%28sports%29", "wikipedia_extract": "In an organized sports league, a typical season is the portion of one year in which regulated games of the sport are in session: for example, in Major League Baseball the season lasts approximately from the last week of March to the last week of September. In other team sports, like association football or basketball, it is generally from August or September to May although in some countries \u2013 such as Northern Europe, North America or East Asia \u2013 the season for outdoor summer sports starts in the spring and finishes in autumn, mainly due to weather conditions encountered during the winter. A year can often be broken up into several distinct sections (sometimes themselves called seasons). These are: a preseason, usually a series of exhibition games played for training purposes; a regular season, the main period of the league's competition; the postseason, a playoff tournament played against the league's top teams to determine the league's champion; and the offseason, the time when there is no official competition. In association football, many clubs tour and then play a series of exhibition games for training purposes. Specifically in Brazil, teams play in state championships before the start of the Brazilian League."}}, {"canonical_name": "Path", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "path", "book_id": "english_physician_1652", "name": "Path", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Path"], "contexts": ["by path sides in the fields"]}, {"entity_id": "path", "book_id": "principles_of_psychology_james_1890", "name": "path", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["path"], "contexts": ["a way or track laid down for walking"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Path", "target_book": "principles_of_psychology_james_1890", "target_name": "path", "similarity": 0.988}], "id": 5354, "stable_key": "clu_ea337875177b2151", "ground_truth": {"modern_name": "path", "confidence": "high", "type": "place"}}, {"canonical_name": "woody", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "woody", "book_id": "english_physician_1652", "name": "woody", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["woody"], "contexts": ["quality of root"]}, {"entity_id": "woody", "book_id": "origin_of_species_darwin_1859", "name": "woody", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["woody"], "contexts": ["having characteristics of wood"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "woody", "target_book": "origin_of_species_darwin_1859", "target_name": "woody", "similarity": 1.0}], "id": 5355, "stable_key": "clu_b9a0c006ed6bbabc", "ground_truth": {"modern_name": "Lignified", "confidence": "high", "type": "concept", "note": "Refers to the characteristic of having wood-like tissue.", "wikidata_id": "Q87156246", "wikidata_description": "scientific article published on 01 December 1974"}}, {"canonical_name": "Hypochon\u2223dria", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "hypochon\u2223dria", "book_id": "english_physician_1652", "name": "Hypochon\u2223dria", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Hypochon\u2223dria"], "contexts": ["region associated with windiness"]}, {"entity_id": "hypoga\u017ftrio", "book_id": "polyanthea_medicinal", "name": "Hypoga\u017ftrio", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Hypoga\u017ftrio"], "contexts": ["body region"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Hypochon\u2223dria", "target_book": "polyanthea_medicinal", "target_name": "Hypoga\u017ftrio", "similarity": 0.882}], "id": 5356, "stable_key": "clu_f3741c405b043fed", "ground_truth": {"modern_name": "hypochondria", "confidence": "high", "type": "anatomy", "description": "The upper region of the abdomen, below the ribs.", "wikipedia_extract": "Hypochondriasis or hypochondria is a condition in which a person is excessively and unduly worried about having a serious illness. Hypochondria is an old concept whose meaning has repeatedly changed over its lifespan. It has been claimed that this debilitating condition results from an inaccurate perception of the condition of body or mind despite the absence of an actual medical diagnosis. An individual with hypochondriasis is known as a hypochondriac. Hypochondriacs become unduly alarmed about any physical or psychological symptoms they detect, no matter how minor the symptom may be, and are convinced that they have, or are about to be diagnosed with, a serious illness. Often, hypochondria persists even after a physician has evaluated a person and reassured them that their concerns about symptoms do not have an underlying medical basis or, if there is a medical illness, their concerns are far in excess of what is appropriate for the level of disease."}}, {"canonical_name": "Nourishment", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "nourishment", "book_id": "english_physician_1652", "name": "Nourishment", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Nourishment"], "contexts": ["substance drawn by plants"]}, {"entity_id": "nourishment", "book_id": "connexion_physical_sciences_somerville_1858", "name": "nourishment", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["nourishment"], "contexts": ["substances providing sustenance"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Nourishment", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nourishment", "similarity": 0.987}], "id": 5357, "stable_key": "clu_17ba893672718676-3", "ground_truth": {"modern_name": "nutrition", "confidence": "high", "type": "concept", "wikidata_id": "Q17652193", "wikidata_description": "science that interprets the nutrients and other substances in food in relation to maintenance, growth, reproduction, health and disease of an organism", "wikipedia_url": "https://en.wikipedia.org/wiki/Nutritional%20science", "note": "The term 'nourishment' and its Portuguese equivalent 'nutr\u00edmento' directly refer to the biological process of providing or receiving sustenance, which is the modern concept of nutrition.", "wikipedia_extract": "Nutritional science (also nutrition science, sometimes short nutrition, dated trophology) is the science that studies the physiological process of nutrition (primarily human nutrition), interpreting the nutrients and other substances in food in relation to maintenance, growth, reproduction, health and disease of an organism. Before nutritional science emerged as an independent study disciplines, mainly chemists worked in this area. The chemical composition of food was examined. Macronutrients, especially protein, fat and carbohydrates, have been the focus components of the study of (human) nutrition since the 19th century. Until the discovery of vitamins and vital substances, the quality of nutrition was measured exclusively by the intake of nutritional energy. The early years of the 20th century were summarized by Kenneth John Carpenter in his Short History of Nutritional Science as \"the vitamin era\"."}}, {"canonical_name": "tents", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "tents", "book_id": "english_physician_1652", "name": "tents", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["tents"], "contexts": ["used with balm for wounds"]}, {"entity_id": "felt_tents", "book_id": "kosmos_humboldt_1845", "name": "felt tents", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["felt tents"], "contexts": ["nomadic dwelling made of felt"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "tents", "target_book": "kosmos_humboldt_1845", "target_name": "felt tents", "similarity": 0.921}], "id": 5358, "stable_key": "clu_a5d2a7d4a3d48c0e", "ground_truth": {"modern_name": "Tents", "confidence": "high", "type": "object", "wikidata_id": "Q7700902", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Tenthredo", "wikipedia_extract": "Tenthredo (from the Greek \u03c4\u03b5\u03bd\u03b8\u03c1\u03b7\u03b4\u03ce\u03bd tenthr\u0113d\u014dn \"earth nesting wasp\")  is a genus of sawflies with more than 700 species of the family Tenthredinidae, subfamily Tenthredininae. It is of Holarctic distribution. Species of this genus are easily recognisable by their wasplike appearance although lacking the thin 'waist' of a true wasp. They have long antenn\u00e6. The fore wings of these sawflies have a lance-shaped cell with a straight cross-nervure. Larvae feed on a very wide variety of plants, each species is often restricted to one host; adults prey on flies and other insects in flowers."}}, {"canonical_name": "putrid", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "putrid", "book_id": "english_physician_1652", "name": "putrid", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["putrid"], "contexts": ["quality of venom and sores"]}, {"entity_id": "putridis", "book_id": "polyanthea_medicinal", "name": "putridis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["putridis"], "contexts": ["quality of fevers"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "putrid", "target_book": "polyanthea_medicinal", "target_name": "putridis", "similarity": 0.958}], "id": 5359, "stable_key": "clu_ce2f509c2226e03c", "ground_truth": {"modern_name": "Putrid", "confidence": "high", "type": "concept", "wikidata_id": "Q671701", "wikidata_description": "breaking down of a body of a human or animal post-mortem"}}, {"canonical_name": "Plantane Herbs", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "plantane_herbs", "book_id": "english_physician_1652", "name": "Plantane Herbs", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Plantane Herbs"], "contexts": ["plant with similar flowers"]}, {"entity_id": "herbes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "herbes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["herbes"], "contexts": ["plants used for juices"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Plantane Herbs", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "herbes", "similarity": 0.95}], "id": 5360, "stable_key": "clu_3c8695b8c5cefdcc", "ground_truth": {"modern_name": "Medicinal herbs", "confidence": "high", "type": "plant", "note": "While 'herbes' is general, 'Physical Herbs' strongly suggests medicinal use.", "wikidata_id": "Q188840", "wikidata_description": "plants or derivatives used to treat medical conditions in humans or animals"}}, {"canonical_name": "Saturnine Diseas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "saturnine_diseas", "book_id": "english_physician_1652", "name": "Saturnine Diseas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Saturnine Diseas"], "contexts": ["illness attributed to Saturn"]}, {"entity_id": "saturnino", "book_id": "polyanthea_medicinal", "name": "Saturnino", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Saturnino"], "contexts": ["a condition related to lead poisoning"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Saturnine Diseas", "target_book": "polyanthea_medicinal", "target_name": "Saturnino", "similarity": 0.907}], "id": 5361, "stable_key": "clu_75a02ecf6bb67725", "ground_truth": {"modern_name": "Saturnine poisoning", "confidence": "high", "type": "disease", "modern_term": "Plumbism", "note": "Saturnine diseases refer to ailments attributed to the influence of the planet Saturn, which in early modern medicine was associated with lead and its toxic effects.", "wikipedia_extract": "Lead poisoning, also known as plumbism and saturnism, is a type of metal poisoning caused by the presence of lead in the human body. Symptoms of lead poisoning may include abdominal pain, constipation, headaches, irritability, memory problems, infertility, numbness and tingling in the hands and feet. Lead poisoning causes almost 10% of intellectual disability of otherwise unknown cause and can result in behavioral problems. Some of the effects are permanent. In severe cases, anemia, seizures, coma, or death may occur. Exposure to lead can occur through contaminated air, water, dust, food, or consumer products.", "wikipedia_url": "https://en.wikipedia.org/wiki/Lead_poisoning"}}, {"canonical_name": "Hawthorn", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "hawthorn", "book_id": "english_physician_1652", "name": "Hawthorn", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Hawthorn"], "contexts": ["common hedgerow tree"]}, {"entity_id": "hawthorn", "book_id": "first_principles_spencer_1862", "name": "hawthorn", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["hawthorn"], "contexts": ["flower with dome-shaped petals"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Hawthorn", "target_book": "first_principles_spencer_1862", "target_name": "hawthorn", "similarity": 0.832}], "id": 5362, "stable_key": "clu_9a397348e08d6446", "ground_truth": {"modern_name": "Hawthorn", "confidence": "high", "type": "plant", "linnaean": "Crataegus Linnaeus", "family": "Rosaceae", "wikidata_id": "Q132557", "wikidata_description": "genus of flowering plants in the rose family Rosaceae", "wikipedia_extract": "Crataegus (), commonly called hawthorn, quickthorn, thornapple, May-tree, whitethorn, Mayflower or hawberry, is a genus of several hundred species of shrubs and trees in the family Rosaceae, native to temperate regions of the Northern Hemisphere in Europe, Asia, North Africa and North America. The name \"hawthorn\" was originally applied to the species native to northern Europe, especially the common hawthorn C. monogyna, and the unmodified name is often so used in Britain and Ireland. The name is now also applied to the entire genus and to the related Asian genus Rhaphiolepis. Crataegus species are shrubs or small trees, mostly growing to 5\u201315 m (15\u201350 ft) tall, with small fruit and (usually) thorny branches. The most common type of bark is smooth grey in young individuals, developing shallow longitudinal fissures with narrow ridges in older trees.", "wikipedia_url": "https://en.wikipedia.org/wiki/Crataegus"}}, {"canonical_name": "old Folks", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "old_folks", "book_id": "english_physician_1652", "name": "old Folks", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["old Folks"], "contexts": ["elderly people"]}, {"entity_id": "old_man", "book_id": "first_principles_spencer_1862", "name": "old man", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["old man"], "contexts": ["least structural modifiability"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "old Folks", "target_book": "first_principles_spencer_1862", "target_name": "old man", "similarity": 0.892}], "id": 5363, "stable_key": "clu_ec598a52db7d20f4", "ground_truth": {"modern_name": "Elderly people", "confidence": "high", "type": "concept", "note": "This cluster refers to a general demographic rather than specific individuals."}}, {"canonical_name": "humers", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "humers", "book_id": "english_physician_1652", "name": "humers", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["humers"], "contexts": ["bodily fluids, often imbalanced"]}, {"entity_id": "hum", "book_id": "coloquios_da_orta_1563", "name": "hum", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["hum"], "contexts": ["humor"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "humers", "target_book": "coloquios_da_orta_1563", "target_name": "hum", "similarity": 0.888}], "id": 5364, "stable_key": "clu_eb4700fd03260fe9", "ground_truth": {"modern_name": "Humors", "confidence": "high", "type": "concept", "description": "Bodily fluids central to humoral theory, believed to influence health and temperament.", "note": "Includes specific types like 'humor adusto' and 'humor phleugmatico'.", "wikipedia_extract": "Humorism, the humoral theory, or humoralism, was a system of medicine detailing a supposed makeup and workings of the human body, adopted by Ancient Greek and Roman physicians and philosophers. Humorism began to fall out of favor in the 17th century and it was definitively disproved with the discovery of microbes. The concept of \"humors\" may have origins in Ancient Egyptian medicine, or Mesopotamia, though it was not systemized until ancient Greek thinkers. The word humor is a translation of Greek \u03c7\u03c5\u03bc\u03cc\u03c2, chymos (literally 'juice' or 'sap', metaphorically 'flavor'). Early texts on Indian Ayurveda medicine presented a theory of three or four humors (do\u1e63as), which they sometimes linked with the five elements (pa\u00f1ca-bh\u016bta): earth, water, fire, air, and space. The concept of \"humors\" (chemical systems regulating human behaviour) became more prominent from the writing of medical theorist Alcmaeon of Croton (c. 540\u2013500 BC)."}}, {"canonical_name": "Orange", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "orange", "book_id": "english_physician_1652", "name": "Orange", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Orange"], "contexts": ["seed to balance coldness"]}, {"entity_id": "orange", "book_id": "principles_of_psychology_james_1890", "name": "orange", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["orange"], "contexts": ["citrus fruit"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Orange", "target_book": "principles_of_psychology_james_1890", "target_name": "orange", "similarity": 0.945}], "id": 5365, "stable_key": "clu_d49ecc167fb67dc8", "ground_truth": {"modern_name": "Orange tree", "confidence": "high", "type": "plant", "linnaean": "Citrus \u00d7 sinensis", "family": "Rutaceae", "description": "Tree bearing citrus fruits, valued for fruit, wood, and medicinal properties.", "note": "Refers to the orange tree, not the planet or musician.", "wikipedia_extract": "Citrus \u00d7 sinensis (sometimes written Citrus sinensis), is a broadleaf evergreen hybrid between pomelo (Citrus maxima) and mandarin (Citrus reticulata). Hybrid sweet oranges are commonly cultivated fruits that include Valencia oranges, blood oranges and navel oranges. The orange fruit is an important agricultural product, used for both the juicy fruit pulp and the aromatic peel (rind). Orange blossoms (the flowers) are used in several different ways, as are the leaves and wood of the tree. The orange blossom, which is the state flower of Florida, is highly fragrant and traditionally associated with good fortune. It has long been popular in bridal bouquets and head wreaths."}}, {"canonical_name": "Cloves", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cloves", "book_id": "english_physician_1652", "name": "Cloves", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Cloves"], "contexts": ["added to poultice"]}, {"entity_id": "clovers", "book_id": "origin_of_species_darwin_1859", "name": "clovers", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["clovers"], "contexts": ["plants fertilized by bees"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Cloves", "target_book": "origin_of_species_darwin_1859", "target_name": "clovers", "similarity": 0.904}], "id": 5366, "stable_key": "clu_3ddb3095803a392b-2", "ground_truth": {"modern_name": "Clove", "confidence": "high", "type": "plant", "linnaean": "Syzygium aromaticum", "family": "Myrtaceae", "description": "Aromatic spice derived from the dried flower buds of a tree.", "wikipedia_extract": "Cloves are the aromatic flower buds of a tree in the family Myrtaceae, Syzygium aromaticum (). They are native to the Maluku Islands, or Moluccas, in Indonesia, and are commonly used as a spice, flavoring, or fragrance in consumer products, such as toothpaste, soaps, or cosmetics. Cloves are available throughout the year owing to different harvest seasons across various countries. The word clove, first used in English in the 15th century, derives via Middle English clow of gilofer, Anglo-French clowes de gilofre and Old French clou de girofle, from the Latin word clavus \"nail\". The related English word gillyflower, originally meaning \"clove\", derives via said Old French girofle and Latin caryophyllon, from the Greek karyophyllon \"clove\", literally \"nut leaf\". The clove tree is an evergreen that grows up to 8\u201312 metres (26\u201339 ft) tall, with large leaves and crimson flowers grouped in terminal clusters.", "note": "The text mentions 'clovers' in the context of bees, which is a different plant (Trifolium). However, 'cloves' in the context of poultices strongly refers to Syzygium aromaticum.", "wikidata_id": "Q26736", "wikidata_description": "species of plant"}}, {"canonical_name": "viscuous", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "viscuous", "book_id": "english_physician_1652", "name": "viscuous", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["viscuous"], "contexts": ["thick and sticky quality"]}, {"entity_id": "viscoso", "book_id": "polyanthea_medicinal", "name": "viscoso", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["viscoso"], "contexts": ["viscous quality"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "viscuous", "target_book": "polyanthea_medicinal", "target_name": "viscoso", "similarity": 0.889}], "id": 5367, "stable_key": "clu_a48684a871eac2f0", "ground_truth": {"modern_name": "Viscosity", "confidence": "high", "type": "concept"}}, {"canonical_name": "Timber Trees", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "timber_trees", "book_id": "english_physician_1652", "name": "Timber Trees", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Timber Trees"], "contexts": ["trees where Misselto grows"]}, {"entity_id": "alberi", "book_id": "ricettario_fiorentino_1597", "name": "alberi", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["alberi"], "contexts": ["trees commonly called"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Timber Trees", "target_book": "ricettario_fiorentino_1597", "target_name": "alberi", "similarity": 0.902}], "id": 5368, "stable_key": "clu_86917ea4afd9169a", "ground_truth": {"modern_name": "Timber trees", "confidence": "medium", "type": "plant", "note": "While 'alberi' in Italian means trees, 'timber trees' is a functional classification rather than a specific botanical one, making a precise Linnaean identification difficult.", "wikidata_id": "Q18394421", "wikidata_description": "alphabetical list of useful timber trees growing in the Gauteng area of South Africa"}}, {"canonical_name": "Hills", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "hills", "book_id": "english_physician_1652", "name": "Hills", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Hills"], "contexts": ["location where moonwort grows"]}, {"entity_id": "hills", "book_id": "principles_of_psychology_james_1890", "name": "hills", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["hills"], "contexts": ["naturally raised areas of land"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Hills", "target_book": "principles_of_psychology_james_1890", "target_name": "hills", "similarity": 0.964}], "id": 5369, "stable_key": "clu_e0eead2057219cb1-2", "ground_truth": {"modern_name": "Hills", "confidence": "high", "type": "place", "country": "Various", "note": "The term 'hills' and its Spanish equivalent 'collinas' consistently refer to naturally raised areas of land.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Hill", "wikipedia_extract": "A hill is a landform that extends above the surrounding terrain. It often has a distinct summit, and is usually applied to peaks which are above elevation compared to the relative landmass, though not as prominent as mountains. Hills fall under the category of slope landforms. The distinction between a hill and a mountain is unclear and largely subjective, but a hill is universally considered to be not as tall, or as steep as a mountain. Geographers historically regarded mountains as hills greater than 1,000 feet (304.8 meters) above sea level. In contrast, hillwalkers have tended to regard mountains as peaks 2,000 feet (610 m) above sea level."}}, {"canonical_name": "Viscuous Humors", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "viscuous_humors", "book_id": "english_physician_1652", "name": "Viscuous Humors", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Viscuous Humors"], "contexts": ["thick bodily fluids"]}, {"entity_id": "viscous_humors", "book_id": "polyanthea_medicinal", "name": "viscous humors", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["viscous humors"], "contexts": ["thick bodily fluids"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Viscuous Humors", "target_book": "polyanthea_medicinal", "target_name": "viscous humors", "similarity": 0.893}], "id": 5370, "stable_key": "clu_2a1887f3098d4092-2", "ground_truth": {"modern_name": "Viscous humors", "confidence": "medium", "type": "concept", "note": "Refers to the humoral theory of medicine, specifically thick bodily fluids.", "wikidata_id": "Q5782572", "wikidata_description": "ancient Greek and Roman system of medicine involving four fluid types", "wikipedia_url": "https://en.wikipedia.org/wiki/Rheology", "wikipedia_extract": "Rheology (; from Ancient Greek  \u1fe5\u03ad\u03c9 (rh\u00e9\u014d) 'flow' and  -\u03bbo\u03b3\u03af\u03b1 (-log\u00eda) 'study of') is the study of the flow of matter, primarily in a fluid (liquid or gas) state, as well as \"soft solids\", which experience conditions under which they respond with plastic flow rather than elastic deformation to forces applied to them. Rheology is the branch of physics that deals with the deformation and flow of materials, both solids and liquids. The term rheology was coined by Eugene C. Bingham, a professor at Lafayette College, in 1920 from a suggestion by a colleague, Markus Reiner. The term was inspired by the aphorism of  Heraclitus (often mistakenly attributed to Simplicius), panta rhei (\u03c0\u03ac\u03bd\u03c4\u03b1 \u1fe5\u03b5\u1fd6, 'everything flows') and was first used to describe the flow of liquids and the deformation of solids. It applies to substances that have a complex microstructure, such as muds, sludges, suspensions, and polymers and other glass formers (e.g., silicates), as well as many foods and additives, bodily fluids (e.g., blood) and other biological materials, and other materials that belong to the class of soft matter such as food."}}, {"canonical_name": "Dogs-turd", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dogs-turd", "book_id": "english_physician_1652", "name": "Dogs-turd", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Dogs-turd"], "contexts": ["vulgar cure for Quinsie"]}, {"entity_id": "dog", "book_id": "polyanthea_medicinal", "name": "dog", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["dog"], "contexts": ["animal"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Dogs-turd", "target_book": "polyanthea_medicinal", "target_name": "dog", "similarity": 0.903}], "id": 5371, "stable_key": "clu_34b53aa72fd31c43", "ground_truth": {"modern_name": "dog", "confidence": "high", "type": "animal", "note": "While 'Dogs-turd' might refer to a specific preparation or a colloquial term, the core entity is the animal 'dog'.", "wikidata_id": "Q20717272", "wikidata_description": "species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Canis%20familiaris"}}, {"canonical_name": "dried Fruit", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dried_fruit", "book_id": "english_physician_1652", "name": "dried Fruit", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["dried Fruit"], "contexts": ["processed plums"]}, {"entity_id": "fruits_secs", "book_id": "relation_historique_humboldt_vol3_1825", "name": "fruits secs", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["fruits secs"], "contexts": ["dried fruits"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "dried Fruit", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "fruits secs", "similarity": 0.919}], "id": 5372, "stable_key": "clu_52e0aea088bc793b", "ground_truth": {"modern_name": "Dried fruits", "confidence": "high", "type": "plant", "note": "This refers to a preparation method rather than a specific species.", "wikidata_id": "Q2784539", "wikidata_description": "species of insect"}}, {"canonical_name": "Tear", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "tear", "book_id": "english_physician_1652", "name": "Tear", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Tear"], "contexts": ["metaphorical substance from poppies"]}, {"entity_id": "tears", "book_id": "first_principles_spencer_1862", "name": "tears", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["tears"], "contexts": ["fluid secreted by eyes during emotion"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Tear", "target_book": "first_principles_spencer_1862", "target_name": "tears", "similarity": 0.938}], "id": 5373, "stable_key": "clu_03ac3300f294cbec-2", "ground_truth": {"modern_name": "Tears", "confidence": "high", "type": "substance", "description": "Bodily fluid secreted by the eyes, or substances resembling it.", "note": "Can refer to literal tears or plant exudates described as such.", "wikipedia_extract": "Tears (tear film) are a transparent fluid secreted primarily by the lacrimal glands (tear gland) found in the eyes of all land mammals. According to the mode of production, tears are classified into four types: basal, closed eye, emotional, and reflex. The basal rate of tear secretion is ~0.5\u20132.2 \u00b5L/min, and irritation can increase secretion by up to ~100-fold, reaching ~300 \u00b5L/min. Tears are made up of water, electrolytes, proteins, lipids, and mucins that form layers on the surface of eyes. The four types of tears differ significantly in their composition. Some of the functions of tears include lubricating the eyes (basal tears), removing irritants (reflex tears), and also aiding the immune system.", "wikidata_id": "Q13614861", "wikidata_description": "genus of insects"}}, {"canonical_name": "Gentry", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "gentry", "book_id": "english_physician_1652", "name": "Gentry", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Gentry"], "contexts": ["social class that eats garden radishes"]}, {"entity_id": "gentilhombre", "book_id": "historia_medicinal_monardes_1574", "name": "gentilhombre", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["gentilhombre"], "contexts": ["gentleman advised by the lady"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Gentry", "target_book": "historia_medicinal_monardes_1574", "target_name": "gentilhombre", "similarity": 0.879}], "id": 5374, "stable_key": "clu_378d1eca71823ee6", "ground_truth": {"modern_name": "Gentry", "confidence": "high", "type": "concept", "note": "This cluster refers to a social class (English gentry) or a gentleman, not a specific named individual. The Portuguese 'gentilhombre' also refers to a nobleman or gentleman.", "wikidata_id": "Q13417114", "wikidata_description": "family part of the nobility of a region or country"}}, {"canonical_name": "Civil", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "civil", "book_id": "english_physician_1652", "name": "Civil", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Civil"], "contexts": ["non-medical uses of rosemary"]}, {"entity_id": "civil", "book_id": "first_principles_spencer_1862", "name": "civil", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["civil"], "contexts": ["relating to government"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Civil", "target_book": "first_principles_spencer_1862", "target_name": "civil", "similarity": 0.974}], "id": 5375, "stable_key": "clu_a0633c80dab12a85", "ground_truth": {"modern_name": "Civil", "confidence": "high", "type": "concept", "note": "This refers to the concept of 'civil' in its general sense, relating to societal organization or government, rather than a specific medical term."}}, {"canonical_name": "dim Eyes", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dim_eyes", "book_id": "english_physician_1652", "name": "dim Eyes", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["dim Eyes"], "contexts": ["condition helped by rosemary flowers"]}, {"entity_id": "olhos_mui_sumidos", "book_id": "coloquios_da_orta_1563", "name": "olhos mui sumidos", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["olhos mui sumidos"], "contexts": ["symptom of the illness"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "dim Eyes", "target_book": "coloquios_da_orta_1563", "target_name": "olhos mui sumidos", "similarity": 0.919}], "id": 5376, "stable_key": "clu_2cb02e74d1d141cd", "ground_truth": {"modern_name": "Dimness of vision", "confidence": "high", "type": "disease", "modern_term": "Vision impairment", "note": "Both 'dim Eyes' and 'olhos mui sumidos' refer to a condition characterized by reduced or obscured vision.", "wikidata_id": "Q2138853", "wikidata_description": "medical rehabilitation measures to improve vision"}}, {"canonical_name": "Resurrection", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "resurrection", "book_id": "english_physician_1652", "name": "Resurrection", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Resurrection"], "contexts": ["religious concept"]}, {"entity_id": "resurrection", "book_id": "principles_of_psychology_james_1890", "name": "resurrection", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["resurrection"], "contexts": ["revival from death"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Resurrection", "target_book": "principles_of_psychology_james_1890", "target_name": "resurrection", "similarity": 0.977}], "id": 5377, "stable_key": "clu_9d46324f766794bf", "ground_truth": {"modern_name": "Resurrection", "confidence": "high", "type": "concept", "note": "This refers to the religious or metaphorical concept of revival from death, not a medical phenomenon in itself."}}, {"canonical_name": "Salisbury", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "salisbury", "book_id": "english_physician_1652", "name": "Salisbury", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Salisbury"], "contexts": ["city near Alderbury"]}, {"entity_id": "salisbury", "book_id": "principles_of_psychology_james_1890", "name": "Salisbury", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Salisbury"], "contexts": ["location of publication"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Salisbury", "target_book": "principles_of_psychology_james_1890", "target_name": "Salisbury", "similarity": 1.0}], "id": 5378, "stable_key": "clu_20ad3701727f182c", "ground_truth": {"wikipedia_extract": "Salisbury ( SAWLZ-b\u0259r-ee, locally  SAWZ-b\u0259r-ee) is a cathedral city and civil parish in Wiltshire, England with a population of 41,820, at the confluence of the rivers Avon, Nadder and Bourne. The city is approximately 20 miles (30 kilometres) from Southampton and 30 miles (50 kilometres) from Bath. Salisbury is in the southeast of Wiltshire, near the edge of Salisbury Plain. An ancient cathedral was north of the present city at Old Sarum. A new cathedral was built near the meeting of the rivers and a settlement grew up around it, which received a city charter in 1227 as New Sarum. This continued to be its official name until 2009, when Salisbury City Council was established."}}, {"canonical_name": "Salt tast", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "salt_tast", "book_id": "english_physician_1652", "name": "Salt tast", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["Salt tast"], "contexts": ["taste of English Scurvey-grass"]}, {"entity_id": "gosto_de_sal", "book_id": "coloquios_da_orta_1563", "name": "gosto de sal", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["gosto de sal"], "contexts": ["taste of salt"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Salt tast", "target_book": "coloquios_da_orta_1563", "target_name": "gosto de sal", "similarity": 0.95}], "id": 5379, "stable_key": "clu_e636201dc48f1eea", "ground_truth": {"modern_name": "Salty taste", "confidence": "high", "type": "concept", "wikidata_id": "Q22243806", "wikidata_description": "Combining with soluble salty compounds to initiate a change in cell activity. These receptors are responsible for the sense of salty taste.", "wikipedia_extract": "Brigitte Anne-Marie Bardot (French: [b\u0281i\u0292it anma\u0281i ba\u0281do]; 28 September 1934 \u2013 28 December 2025), often referred to by her initials B.B., was a French actress, singer, model, and animal rights activist. She became one of the best-known symbols of the sexual revolution and gained international fame for portraying characters associated with hedonistic lifestyles. Although she withdrew from the entertainment industry in 1973, she remained a major pop culture icon. She appeared in 47 films, performed in several musicals, and recorded more than 60 songs. She was awarded the Legion of Honour in 1985. Born and raised in Paris, Bardot was an aspiring ballerina during her childhood.", "wikipedia_url": "https://en.wikipedia.org/wiki/Brigitte_Bardot"}}, {"canonical_name": "smooth", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "smooth", "book_id": "english_physician_1652", "name": "smooth", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["smooth"], "contexts": ["quality of skin"]}, {"entity_id": "smoothness", "book_id": "principles_of_psychology_james_1890", "name": "smoothness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["smoothness"], "contexts": ["tactile quality of surfaces"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "smooth", "target_book": "principles_of_psychology_james_1890", "target_name": "smoothness", "similarity": 0.918}], "id": 5380, "stable_key": "clu_959c8dd96ecbd13a", "ground_truth": {"modern_name": "smoothness", "confidence": "high", "type": "concept", "wikidata_id": "Q7546461", "wikidata_description": "in probability theory, measure of a density function"}}, {"canonical_name": "Monks", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "monks", "book_id": "english_physician_1652", "name": "Monks", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Monks"], "contexts": ["made people ignorant"]}, {"entity_id": "moines", "book_id": "relation_historique_humboldt_vol3_1825", "name": "moines", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["moines"], "contexts": ["monks not included in census"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Monks", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "moines", "similarity": 0.9}], "id": 5381, "stable_key": "clu_3c2df33574a4eafc", "ground_truth": {"modern_name": "monk", "confidence": "high", "type": "person", "description": "Member of a religious community, often associated with ignorance."}}, {"canonical_name": "green Leaves", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "green_leaves", "book_id": "english_physician_1652", "name": "green Leaves", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["green Leaves"], "contexts": ["fresh Thoroughwax leaves"]}, {"entity_id": "green_leaves", "book_id": "principles_of_psychology_james_1890", "name": "green leaves", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["green leaves"], "contexts": ["visual cue for spring"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "green Leaves", "target_book": "principles_of_psychology_james_1890", "target_name": "green leaves", "similarity": 0.956}], "id": 5382, "stable_key": "clu_4a8fff43f5805086-2", "ground_truth": {"modern_name": "Leaves", "confidence": "high", "type": "plant", "note": "General term for a plant organ, not a specific species.", "wikidata_id": "Q33971", "wikidata_description": "main organ of photosynthesis and transpiration in higher plants, usually consisting of a flat green blade attached to the stem directly or by a stalk", "wikipedia_url": "https://en.wikipedia.org/wiki/Leaf", "wikipedia_extract": "A leaf (pl.: leaves) is a principal appendage of the stem of a vascular plant, usually borne laterally above ground and specialized for photosynthesis. Leaves are collectively called foliage, as in \"autumn foliage\", while the leaves, stem, flower, and fruit collectively form the shoot system. In most leaves, the primary photosynthetic tissue is the palisade mesophyll and is located on the upper side of the blade or lamina of the leaf, but in some species, including the mature foliage of Eucalyptus, palisade mesophyll is present on both sides and the leaves are said to be isobilateral. The leaf is an integral part of the stem system, and most leaves are flattened and have distinct upper (adaxial) and lower (abaxial) surfaces that differ in color, hairiness, the number of stomata (pores that intake and output gases), the amount and structure of epicuticular wax, and other features. Leaves are mostly green in color due to the presence of a compound called chlorophyll which is essential for photosynthesis as it absorbs light energy from the Sun. A leaf with lighter-colored or white patches or edges is called a variegated leaf."}}, {"canonical_name": "Broom Field", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "broom_field", "book_id": "english_physician_1652", "name": "Broom Field", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Broom Field"], "contexts": ["habitat for Tormentil"]}, {"entity_id": "broomfield", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Broomfield", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Broomfield"], "contexts": ["location of Mr. Cross"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Broom Field", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Broomfield", "similarity": 0.651}], "id": 5383, "stable_key": "clu_83cf68a7b76b7bf4", "ground_truth": {"modern_name": "Broomfield", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "", "wikipedia_extract": ""}}, {"canonical_name": "Chirurgeons", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "chirurgeons", "book_id": "english_physician_1652", "name": "Chirurgeons", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["Chirurgeons"], "contexts": ["surgical practitioners"]}, {"entity_id": "surgeons", "book_id": "principles_of_psychology_james_1890", "name": "surgeons", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["surgeons"], "contexts": ["medical professionals performing operations"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Chirurgeons", "target_book": "principles_of_psychology_james_1890", "target_name": "surgeons", "similarity": 0.953}], "id": 5384, "stable_key": "clu_c1f21212d0436dc1-3", "ground_truth": {"modern_name": "Surgeon", "confidence": "high", "type": "person", "description": "Medical practitioner specializing in surgical procedures.", "wikidata_id": "Q774306", "wikidata_description": "physician with surgical specialty", "wikipedia_url": "https://en.wikipedia.org/wiki/Surgeon", "wikipedia_extract": "In  medicine, a surgeon is a medical doctor who performs surgery. Even though there are different traditions in different times and places, a modern surgeon is a licensed physician and received the same medical training as physicians before specializing in surgery. In some countries and jurisdictions, the title of 'surgeon' is restricted to maintain the integrity of the craft group in the medical profession. A specialist regarded as a legally recognized surgeon includes podiatry, dentistry, and veterinary medicine. It is estimated that surgeons perform over 300 million surgical procedures globally each year. The first person to document a surgery was the 6th century BC Indian physician-surgeon, Sushruta."}}, {"canonical_name": "February", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "february", "book_id": "english_physician_1652", "name": "February", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["February"], "contexts": ["month when the plant flowers"]}, {"entity_id": "f\u00e9vrier", "book_id": "relation_historique_humboldt_vol3_1825", "name": "F\u00e9vrier", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["F\u00e9vrier"], "contexts": ["month"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "February", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "F\u00e9vrier", "similarity": 0.917}], "id": 5385, "stable_key": "clu_437e4a69d0153bc2", "ground_truth": {"modern_name": "February", "confidence": "high", "type": "concept", "wikidata_id": "Q109", "wikidata_description": "second month in the Julian and Gregorian calendars"}}, {"canonical_name": "Vessel", "category": "OBJECT", "subcategory": "VESSEL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "vessel", "book_id": "english_physician_1652", "name": "Vessel", "category": "OBJECT", "subcategory": "VESSEL", "count": 1, "variants": ["Vessel"], "contexts": ["to receive willow water"]}, {"entity_id": "vessel", "book_id": "connexion_physical_sciences_somerville_1858", "name": "vessel", "category": "OBJECT", "subcategory": "VESSEL", "count": 1, "variants": ["vessel"], "contexts": ["container for liquids"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Vessel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "vessel", "similarity": 0.966}], "id": 5386, "stable_key": "clu_5f465ffe4b94643b-2", "ground_truth": {"modern_name": "vessel", "confidence": "high", "type": "object", "note": "The term 'vaso' can refer to various containers, but 'vessel' is the most general and accurate translation in this context.", "wikidata_id": "Q987767", "wikidata_description": "device creating a partially or fully enclosed space that can be used to contain, store, and transport objects or materials", "wikipedia_url": "https://en.wikipedia.org/wiki/Container", "wikipedia_extract": "A container is any receptacle or enclosure for holding an item. Things kept inside of a container are protected on several sides by being inside of its structure. Humans have used containers for at least 100,000 years, and possibly for millions of years. Containers are used in storage, packaging, and transportation, including shipping. A container is any receptacle or enclosure for holding an item used in storage, packaging, and transportation, including shipping. A container can also be considered as a basic tool, consisting of any device creating a partially or fully enclosed space that can be used to contain, store, and transport objects or materials."}}, {"canonical_name": "Diurnal", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "diurnal", "book_id": "english_physician_1652", "name": "Diurnal", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Diurnal"], "contexts": ["quality attributed to Mars"]}, {"entity_id": "diurnal", "book_id": "first_principles_spencer_1862", "name": "diurnal", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["diurnal"], "contexts": ["occurring daily"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Diurnal", "target_book": "first_principles_spencer_1862", "target_name": "diurnal", "similarity": 0.971}], "id": 5387, "stable_key": "clu_8205c13d6ce247a1", "ground_truth": {"modern_name": "Diurnal", "confidence": "high", "type": "concept"}}, {"canonical_name": "Feminine", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "feminine", "book_id": "english_physician_1652", "name": "Feminine", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Feminine"], "contexts": ["quality attributed to Venus"]}, {"entity_id": "female", "book_id": "first_principles_spencer_1862", "name": "female", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["female"], "contexts": ["sex of an organism"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Feminine", "target_book": "first_principles_spencer_1862", "target_name": "female", "similarity": 0.899}], "id": 5388, "stable_key": "clu_0b3c0804a006c733", "ground_truth": {"modern_name": "Feminine", "confidence": "high", "type": "concept"}}, {"canonical_name": "Chyron", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "chyron", "book_id": "english_physician_1652", "name": "Chyron", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Chyron"], "contexts": ["master of Achilles, taught Yarrow's virtues"]}, {"entity_id": "chiron", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Chiron", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Chiron"], "contexts": ["mythological centaur"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Chyron", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Chiron", "similarity": 0.902}], "id": 5389, "stable_key": "clu_e77c4fe6e998ca94", "ground_truth": {"modern_name": "Chiron", "confidence": "high", "type": "person", "description": "Mythological Greek centaur, healer, and teacher", "wikidata_id": "Q14921870", "wikidata_description": "genus of insects"}}, {"canonical_name": "Bettony", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bettony", "book_id": "english_physician_1652", "name": "Bettony", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Bettony"], "contexts": ["herb that grows in the shadow"]}, {"entity_id": "bettoli", "book_id": "ricettario_fiorentino_1597", "name": "Bettoli", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Bettoli"], "contexts": ["plant used in powders"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Bettony", "target_book": "ricettario_fiorentino_1597", "target_name": "Bettoli", "similarity": 0.89}], "id": 5390, "stable_key": "clu_0be15bbfdf5b085b-2", "ground_truth": {"modern_name": "Peony", "confidence": "high", "type": "plant", "linnaean": "Paeonia lactiflora", "family": "Paeoniaceae", "note": "The Linnaean binomial is an educated guess as multiple species of Paeonia exist, and early modern texts often referred to the genus broadly. However, Paeonia lactiflora is a well-known medicinal peony.", "wikidata_id": "Q147105", "wikidata_description": "genus of flowering plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Peony", "wikipedia_extract": "The peony or paeony () is any flowering plant in the genus Paeonia, the only genus in the family Paeoniaceae. Peonies are native to Asia, Europe, and Western North America. Scientists differ on the number of species that can be distinguished, ranging from 25 to 40, although the current consensus describes 33 known species. The relationships between the species need to be further clarified. Most are herbaceous perennial plants 0.25\u20131 metre (1\u20133 ft) tall, but some are woody shrubs 0.25\u20133.5 metres (1\u201311 ft) tall. They have compound, deeply lobed leaves and large, often fragrant flowers, in colors ranging from purple and pink to red, white or yellow, in late spring and early summer."}}, {"canonical_name": "Tropick of Capricorn", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "tropick_of_capricorn", "book_id": "english_physician_1652", "name": "Tropick of Capricorn", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Tropick of Capricorn"], "contexts": ["celestial line influencing plant growth"]}, {"entity_id": "tropique_du_capricorne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "tropique du Capricorne", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tropique du Capricorne"], "contexts": ["astronomical line of latitude"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Tropick of Capricorn", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "tropique du Capricorne", "similarity": 0.917}], "id": 5391, "stable_key": "clu_4bf434f66ea043f6-3", "ground_truth": {"modern_name": "Tropic of Capricorn", "confidence": "high", "type": "concept", "description": "The southern-most latitude where the sun can be directly overhead.", "note": "Includes references to the zodiac sign Capricorn and the tropic line.", "wikipedia_extract": "The Tropic of Capricorn (or the Southern Tropic) is the circle of latitude that contains the subsolar point at the December (or southern) solstice. It is thus the southernmost latitude where the Sun can be seen directly overhead. It also reaches 90 degrees below the horizon at solar midnight on the June Solstice. Its northern equivalent is the Tropic of Cancer. The Tropic of Capricorn is one of the five major circles of latitude marked on maps of Earth. Its latitude is currently 23\u00b026\u203209.2\u2033 (or 23.4359\u00b0) south of the Equator, but it is very gradually moving northward, currently at the rate of 0.47 arcseconds, or 15 metres, per year."}}, {"canonical_name": "Catapotia", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "catapotia", "book_id": "english_physician_1652", "name": "Catapotia", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Catapotia"], "contexts": ["Greek name for pills"]}, {"entity_id": "catapotijs", "book_id": "polyanthea_medicinal", "name": "Catapotijs", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Catapotijs"], "contexts": ["pills, medicinal preparation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Catapotia", "target_book": "polyanthea_medicinal", "target_name": "Catapotijs", "similarity": 0.888}], "id": 5392, "stable_key": "clu_da9c3d3b843ded03", "ground_truth": {"modern_name": "Pills", "confidence": "high", "type": "object", "note": "Both texts clearly refer to medicinal pills.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "1Fe-LSD, also known as 1-(ferrocenecarbonyl)-LSD or as SYN-L-234, is a psychedelic drug of the lysergamide family related to lysergic acid diethylamide (LSD). It is thought to be a prodrug of LSD. The drug was patented by Lizard Labs in 2024. Subsequently, it was encountered online as a novel designer drug being sold in Germany in November 2025. 1Fe-LSD as the hemi-L-tartrate salt has been sold in the form of blotter containing 200 \u03bcg per tab and micropills containing 300 \u03bcg per pill. 1Fe-LSD contains ferrocene, an iron compound, which is an orange organometallic compound and is assumed to result in the distinctive orange color of 1Fe-LSD blotter and pills.", "wikipedia_url": "https://en.wikipedia.org/wiki/1Fe-LSD"}}, {"canonical_name": "Jelly", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "jelly", "book_id": "english_physician_1652", "name": "Jelly", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Jelly"], "contexts": ["thick medicinal substance"]}, {"entity_id": "jelly", "book_id": "principles_of_psychology_james_1890", "name": "jelly", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["jelly"], "contexts": ["gelatinous substance that vibrates"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Jelly", "target_book": "principles_of_psychology_james_1890", "target_name": "jelly", "similarity": 0.748}], "id": 5393, "stable_key": "clu_0a0969b1c190b0ce", "ground_truth": {"modern_name": "Jelly", "confidence": "high", "type": "substance", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "Ferdinand Joseph LaMothe (n\u00e9 Lemott, later Morton; c. September 20, 1890 \u2013 July 10, 1941), known professionally as Jelly Roll Morton, was an American blues and jazz pianist, bandleader, and composer of Louisiana Creole descent. Morton was jazz's first arranger, proving that a genre rooted in improvisation could retain its essential characteristics when notated. His composition \"Jelly Roll Blues\", published in 1915, was one of the first published jazz compositions. He also claimed to have invented the genre. Morton also wrote \"King Porter Stomp\", \"Wolverine Blues\", \"Black Bottom Stomp\", and \"I Thought I Heard Buddy Bolden Say\", the last being a tribute to New Orleans musicians from the turn of the 20th century.", "wikipedia_url": "https://en.wikipedia.org/wiki/Jelly_Roll_Morton"}}, {"canonical_name": "Infortune", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "infortune", "book_id": "english_physician_1652", "name": "Infortune", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Infortune"], "contexts": ["astrological influence"]}, {"entity_id": "infortunio", "book_id": "polyanthea_medicinal", "name": "infortunio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["infortunio"], "contexts": ["misfortune, adverse event"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Infortune", "target_book": "polyanthea_medicinal", "target_name": "infortunio", "similarity": 0.947}], "id": 5394, "stable_key": "clu_c5dd5e67d0050791", "ground_truth": {"modern_name": "Astrological Influence", "confidence": "high", "type": "concept", "note": "The context of 'infortune' in relation to astrological influence points towards this concept."}}, {"canonical_name": "Beauty", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "beauty", "book_id": "english_physician_1652", "name": "Beauty", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Beauty"], "contexts": ["aesthetic quality"]}, {"entity_id": "beauty", "book_id": "principles_of_psychology_james_1890", "name": "beauty", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["beauty"], "contexts": ["abstract concept in spiritualist philosophy"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Beauty", "target_book": "principles_of_psychology_james_1890", "target_name": "beauty", "similarity": 0.969}], "id": 5395, "stable_key": "clu_2184734473dd953d", "ground_truth": {"modern_name": "Beauty", "confidence": "high", "type": "concept", "wikidata_id": "Q7242", "wikidata_description": "aesthetic concept"}}, {"canonical_name": "Curdled Milk", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "curdled_milk", "book_id": "english_physician_1652", "name": "Curdled Milk", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Curdled Milk"], "contexts": ["milk that has coagulated"]}, {"entity_id": "curdled_milk", "book_id": "polyanthea_medicinal", "name": "curdled milk", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["curdled milk"], "contexts": ["preparation of milk"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Curdled Milk", "target_book": "polyanthea_medicinal", "target_name": "curdled milk", "similarity": 0.978}], "id": 5396, "stable_key": "clu_750316407ffbf7b6", "ground_truth": {"wikipedia_extract": "Nicole Ann Bell (born September 8, 1991), known professionally as Nicole Dollanganger, is a Canadian-American singer-songwriter. Dollanganger's music is characterized by a feminine, high-pitched vocal style, minimalist instrumentation, and lyrical themes frequently pertaining to true crime, violence, sexuality, and romance. Her music has been described as \"lo-fi\", \"atmospheric\", and \"folk\", and is associated with the folk, folk pop, bedroom pop, slowcore and dream pop genres. In 2015, Rolling Stone named Dollanganger in an article titled \"10 New Artists You Need to Know,\" stating that her \"gothic folk songs,\" described as \"macabre millennial nightmares, softened by dream-pop tranquilizers, reverberating from a casket-shaped music box,\" are \"as beautiful as they are brutal.\" Most of her releases were released as digital-only, and a majority of them were initially published by Dollanganger herself through the music website Bandcamp. Her stage name comes from the Dollanganger Series of novels by V. C."}}, {"canonical_name": "Forgetfulness", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "forgetfulness", "book_id": "english_physician_1652", "name": "Forgetfulness", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["Forgetfulness"], "contexts": ["inability to recall"]}, {"entity_id": "esquecimentos", "book_id": "polyanthea_medicinal", "name": "esquecimentos", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["esquecimentos"], "contexts": ["forgetfulness"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Forgetfulness", "target_book": "polyanthea_medicinal", "target_name": "esquecimentos", "similarity": 0.95}], "id": 5397, "stable_key": "clu_3c63f24104dfb3f2", "ground_truth": {"wikipedia_extract": "Forgetting or disremembering is the apparent loss or modification of information already encoded and stored in an individual's short or long-term memory. It is a spontaneous or gradual process in which old memories are unable to be recalled from memory storage. Problems with remembering, learning and retaining new information are a few of the most common complaints of older adults. Studies show that retention improves with increased rehearsal. This improvement occurs because rehearsal helps to transfer information into long-term memory. Forgetting curves (amount remembered as a function of time since an event was first experienced) have been extensively analyzed."}}, {"canonical_name": "M.A.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "m_a_", "book_id": "origin_of_species_darwin_1859", "name": "M.A.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["M.A."], "contexts": ["academic degree"]}, {"entity_id": "m_a_", "book_id": "kosmos_humboldt_1845", "name": "M.A.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["M.A."], "contexts": ["academic degree"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "M.A.", "target_book": "kosmos_humboldt_1845", "target_name": "M.A.", "similarity": 1.0}], "id": 5398, "stable_key": "clu_fe1d84a27b96bedb", "ground_truth": {"modern_name": "Master of Arts", "confidence": "high", "type": "concept", "wikidata_id": "Q2091008", "wikidata_description": "type of master's degree in the fields of humanities and social sciences"}}, {"canonical_name": "ALBEMARLE STREET", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "albemarle_street", "book_id": "origin_of_species_darwin_1859", "name": "ALBEMARLE STREET", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["ALBEMARLE STREET"], "contexts": ["street in London"]}, {"entity_id": "albemarle_street", "book_id": "connexion_physical_sciences_somerville_1858", "name": "ALBEMARLE STREET", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["ALBEMARLE STREET"], "contexts": ["street address of publisher"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "ALBEMARLE STREET", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ALBEMARLE STREET", "similarity": 1.0}], "id": 5399, "stable_key": "clu_8e2445624e32e5fd", "ground_truth": {"modern_name": "Albemarle Street", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q134545274", "wikidata_description": "street in Baltimore, Maryland, the United States"}}, {"canonical_name": "horticulture", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "horticulture", "book_id": "origin_of_species_darwin_1859", "name": "horticulture", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["horticulture"], "contexts": ["practice of cultivating gardens"]}, {"entity_id": "horticulture", "book_id": "kosmos_humboldt_1845", "name": "horticulture", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["horticulture"], "contexts": ["practice of garden cultivation"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "horticulture", "target_book": "kosmos_humboldt_1845", "target_name": "horticulture", "similarity": 1.0}], "id": 5400, "stable_key": "clu_0f61f612dd2140f2", "ground_truth": {"modern_name": "Horticulture", "confidence": "high", "type": "concept"}}, {"canonical_name": "hyacinth", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "hyacinth", "book_id": "origin_of_species_darwin_1859", "name": "hyacinth", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["hyacinth"], "contexts": ["cultivated plant studied for variation"]}, {"entity_id": "hyacinthina", "book_id": "polyanthea_medicinal", "name": "Hyacinthina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Hyacinthina"], "contexts": ["hyacinth"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "hyacinth", "target_book": "polyanthea_medicinal", "target_name": "Hyacinthina", "similarity": 0.919}], "id": 5401, "stable_key": "clu_88ab5dda3de27736", "ground_truth": {"wikipedia_extract": "Hyacinthus  is a genus of bulbous herbs and spring-blooming perennials. They are fragrant flowering plants in the family Asparagaceae, subfamily Scilloideae and are commonly called hyacinths (). The genus is native predominantly to the Eastern Mediterranean region from the south of Turkey to the Palestine region, although naturalized more widely. The name comes from Greek mythology: Hyacinth was killed by Zephyrus, the god of the west wind, jealous of his love for Apollo. He then transformed the drops of Hyacinth's blood into flowers. Several species of Brodiaea, Scilla, and other plants that have flower clusters borne along the stalk that were formerly classified in the Liliaceae family also have common names with the word \"hyacinth\" in them."}}, {"canonical_name": "wild species", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "wild_species", "book_id": "origin_of_species_darwin_1859", "name": "wild species", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["wild species"], "contexts": ["natural, non-domesticated animal forms"]}, {"entity_id": "wild_animals", "book_id": "first_principles_spencer_1862", "name": "wild animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["wild animals"], "contexts": ["untamed creatures for food"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "wild species", "target_book": "first_principles_spencer_1862", "target_name": "wild animals", "similarity": 0.95}], "id": 5402, "stable_key": "clu_f5052b728ffea19a", "ground_truth": {"modern_name": "wild animals", "confidence": "high", "type": "animal", "wikidata_id": "Q92961745", "wikidata_description": "painting by Mane-Katz"}}, {"canonical_name": "caudal vertebr\u00e6", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "caudal_vertebr\u00e6", "book_id": "origin_of_species_darwin_1859", "name": "caudal vertebr\u00e6", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["caudal vertebr\u00e6"], "contexts": ["vertebrae in the tail region"]}, {"entity_id": "caudal_vertebr\u00e6", "book_id": "first_principles_spencer_1862", "name": "caudal vertebr\u00e6", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["caudal vertebr\u00e6"], "contexts": ["vertebrae in the tail region"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "caudal vertebr\u00e6", "target_book": "first_principles_spencer_1862", "target_name": "caudal vertebr\u00e6", "similarity": 1.0}], "id": 5403, "stable_key": "clu_bb47c4094ee9b8b4", "ground_truth": {"modern_name": "Caudal vertebrae", "confidence": "high", "type": "concept"}}, {"canonical_name": "sacral vertebr\u00e6", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sacral_vertebr\u00e6", "book_id": "origin_of_species_darwin_1859", "name": "sacral vertebr\u00e6", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["sacral vertebr\u00e6"], "contexts": ["vertebrae fused to the pelvis"]}, {"entity_id": "sacral_vertebr\u00e6", "book_id": "first_principles_spencer_1862", "name": "sacral vertebr\u00e6", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["sacral vertebr\u00e6"], "contexts": ["vertebrae forming the sacrum"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "sacral vertebr\u00e6", "target_book": "first_principles_spencer_1862", "target_name": "sacral vertebr\u00e6", "similarity": 1.0}], "id": 5404, "stable_key": "clu_86764364cd72d1f7", "ground_truth": {"modern_name": "Sacral vertebrae", "confidence": "high", "type": "concept"}}, {"canonical_name": "furcula", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "furcula", "book_id": "origin_of_species_darwin_1859", "name": "furcula", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["furcula"], "contexts": ["wishbone"]}, {"entity_id": "furcula", "book_id": "polyanthea_medicinal", "name": "Furcula", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Furcula"], "contexts": ["alternative name for espinhela"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "furcula", "target_book": "polyanthea_medicinal", "target_name": "Furcula", "similarity": 0.983}], "id": 5405, "stable_key": "clu_33b2fc505c9dae5c", "ground_truth": {"modern_name": "Furcula", "confidence": "high", "type": "concept", "note": "Also known as the wishbone in birds."}}, {"canonical_name": "Strickland", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "strickland", "book_id": "origin_of_species_darwin_1859", "name": "Strickland", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Strickland"], "contexts": ["named the Indian sub-species of rock-pigeon"]}, {"entity_id": "strickland", "book_id": "kosmos_humboldt_1845", "name": "Strickland", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Strickland"], "contexts": ["author of 'The Dodo and its Kindred'"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Strickland", "target_book": "kosmos_humboldt_1845", "target_name": "Strickland", "similarity": 1.0}], "id": 5406, "stable_key": "clu_d2daaa5fba670224", "ground_truth": {"modern_name": "Hugh Edwin Strickland", "confidence": "high", "type": "person", "birth_year": 1811, "death_year": 1853, "description": "English naturalist and ornithologist, co-authored 'The Dodo and its Kindred'.", "wikidata_id": "Q1387751", "wikidata_description": "British geologist and zoologist (1811-1853)"}}, {"canonical_name": "Mr. Buckley", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mr__buckley", "book_id": "origin_of_species_darwin_1859", "name": "Mr. Buckley", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Mr. Buckley"], "contexts": ["owner of Leicester sheep flock"]}, {"entity_id": "mr__knightley", "book_id": "principles_of_psychology_james_1890", "name": "Mr. Knightley", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Mr. Knightley"], "contexts": ["character in Miss Austen's 'Emma'"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Mr. Buckley", "target_book": "principles_of_psychology_james_1890", "target_name": "Mr. Knightley", "similarity": 0.859}], "id": 5407, "stable_key": "clu_041d7b88e9d6dfa8", "ground_truth": {"modern_name": "Mr. Buckley", "confidence": "medium", "type": "person", "description": "Owner of a Leicester sheep flock; a literary character.", "note": "Ambiguous referent due to presence of both a real person associated with sheep and a fictional character."}}, {"canonical_name": "wants", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "wants", "book_id": "origin_of_species_darwin_1859", "name": "wants", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["wants"], "contexts": ["human desires and needs"]}, {"entity_id": "wants", "book_id": "first_principles_spencer_1862", "name": "wants", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["wants"], "contexts": ["needs or desires"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "wants", "target_book": "first_principles_spencer_1862", "target_name": "wants", "similarity": 1.0}], "id": 5408, "stable_key": "clu_7888562ffdbc5b3d-2", "ground_truth": {"modern_name": "Desire", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "note": "The cluster explicitly mentions 'desires' and 'man's desires', directly referring to the psychological concept of desire."}}, {"canonical_name": "fancies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fancies", "book_id": "origin_of_species_darwin_1859", "name": "fancies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fancies"], "contexts": ["human preferences and whims"]}, {"entity_id": "fancies", "book_id": "principles_of_psychology_james_1890", "name": "fancies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fancies"], "contexts": ["relics of sensory motions within us"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "fancies", "target_book": "principles_of_psychology_james_1890", "target_name": "fancies", "similarity": 1.0}], "id": 5409, "stable_key": "clu_ee42482851d1cba5-4", "ground_truth": {"modern_name": "imagination", "confidence": "high", "type": "concept", "wikidata_id": "Q91048696", "wikidata_description": "vocal track by Bob Dylan; 2017 studio recording; cover version", "wikipedia_extract": "Sociological imagination is a term used in the field of sociology to describe a framework for understanding social reality that places personal experiences within a broader social and historical context. It was coined by American sociologist C. Wright Mills in his 1959 book The Sociological Imagination to describe the type of insight offered by the discipline of sociology. Today, the term is used in many sociology textbooks to explain the nature of sociology and its relevance in daily life. In The Sociological Imagination, Mills attempts to reconcile two different and abstract concepts of social reality: the \"individual\" and the \"society.\" Accordingly, Mills defined sociological imagination as \"the awareness of the relationship between personal experience and the wider society.\" In exercising one's sociological imagination, one seeks to understand situations in one's life by looking at situations in broader society. For example, a single student who fails to keep up with the academic demands of college and ends up dropping out may be perceived to have faced personal difficulties or faults; however, when one considers that around 50% of college students in the United States fail to graduate, we can understand this one student's trajectory as part of a larger social issue.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sociological_imagination"}}, {"canonical_name": "Hieracium", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "hieracium", "book_id": "origin_of_species_darwin_1859", "name": "Hieracium", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Hieracium"], "contexts": ["genus with polymorphic species"]}, {"entity_id": "hieracium", "book_id": "ricettario_fiorentino_1597", "name": "Hieracium", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Hieracium"], "contexts": ["plant name"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Hieracium", "target_book": "ricettario_fiorentino_1597", "target_name": "Hieracium", "similarity": 1.0}], "id": 5410, "stable_key": "clu_85450d724d593df8", "ground_truth": {"wikipedia_extract": "known by the common name hawkweed and classically as hierakion (from ancient Greek \u1f31\u03ad\u03c1\u03b1\u03be, hierax 'hawk'), is a genus of flowering plant in the family Asteraceae, and closely related to dandelion (Taraxacum), chicory (Cichorium), prickly lettuce (Lactuca) and sow thistle (Sonchus), which are part of the tribe Cichorieae. Hawkweeds, with their 10,000+ recorded species and subspecies, do their part to make Asteraceae the second largest family of flowering plants. Some botanists group all these species or subspecies into approximately 800 accepted species, while others prefer to accept several thousand species. Since most hawkweeds reproduce exclusively asexually by means of seeds that are genetically identical to their mother plant (apomixis or agamospermy), clones or populations that consist of genetically identical plants are formed and some botanists (especially in UK, Scandinavia and Russia) prefer to accept these clones as good species (arguing that it is impossible to know how these clones are interrelated) whereas others (mainly in Central Europe and USA) try to group them into a few hundred more broadly defined species. What is here treated as the single genus Hieracium is now treated by most European experts as two different genera, Hieracium and Pilosella, with species such as Hieracium pilosella, Hieracium floribundum and Hieracium aurantiacum referred to the latter genus. Many members of the genus Pilosella reproduce both by stolons (runners like those of strawberries) and by seeds, whereas true Hieracium species reproduce only by seeds."}}, {"canonical_name": "elatior", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "elatior", "book_id": "origin_of_species_darwin_1859", "name": "elatior", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["elatior"], "contexts": ["scientific name for primrose"]}, {"entity_id": "i__elatior", "book_id": "relation_historique_humboldt_vol3_1825", "name": "I. elatior", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["I. elatior"], "contexts": ["plant from Turbaco"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "elatior", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "I. elatior", "similarity": 0.939}], "id": 5411, "stable_key": "clu_3ba9c3486625f7e9", "ground_truth": {"modern_name": "Primula elatior", "confidence": "high", "type": "plant", "linnaean": "Primula elatior", "family": "Primulaceae", "note": "The context 'plant from Turbaco' might refer to a different species or a misidentification, but 'elatior' in scientific names typically refers to this primrose.", "wikidata_id": "Q157842", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Primula_elatior", "wikipedia_extract": "Primula elatior, the oxlip (or true oxlip), is a species of flowering plant in the family Primulaceae, native to  nutrient-poor and calcium-rich damp woods and meadows throughout Europe, with northern borders in Denmark and southern parts of Sweden, eastwards to the Altai Mountains and on the Kola Peninsula in Russia, and westwards in the British Isles. The oxlip is a herbaceous or semi-evergreen  perennial plant growing to 30 cm (12 in) tall by 25 cm (10 in) broad, with a rosette of leaves 5\u201315 cm long and 2\u20136 cm broad. It produces light yellow flowers in spring, in clusters of 10-30 together on a single stem 10\u201330 cm (4\u201312 in) tall, each flower 9\u201315 mm broad. It may be confused with the closely related cowslip (Primula veris), which has a similar general appearance, although P. veris has smaller, bell-shaped, bright yellow flowers (and red dots inside the flower), and a corolla tube without folds. The leaves of P."}}, {"canonical_name": "condor", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "condor", "book_id": "origin_of_species_darwin_1859", "name": "condor", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["condor"], "contexts": ["bird that lays a couple of eggs"]}, {"entity_id": "condor", "book_id": "connexion_physical_sciences_somerville_1858", "name": "condor", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["condor"], "contexts": ["confined to the Andes and declivities"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "condor", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "condor", "similarity": 1.0}], "id": 5412, "stable_key": "clu_3968eba28aa25537", "ground_truth": {"modern_name": "Andean condor", "confidence": "high", "type": "animal", "note": "The context 'confined to the Andes' strongly suggests the Andean condor.", "wikidata_id": "Q170598", "wikidata_description": "species of bird", "wikipedia_url": "https://en.wikipedia.org/wiki/Andean_condor", "wikipedia_extract": "The Andean flamingo (Phoenicoparrus andinus) is a species of flamingo native to the Andes mountains of South America. Until 2014, it was classified in genus Phoenicopterus. It is closely related to James's flamingo, and the two make up the genus Phoenicoparrus. The Chilean flamingo, Andean flamingo, and James' flamingo are all sympatric, and all live in colonies (including shared nesting areas). Distribution, habitat, and movements This Andean flamingo is native to the wetlands of the high Andes mountain range from southern Peru to northwestern Argentina and northern Chile. Andean flamingos are migratory, with the ability to travel up to 700 miles in one day."}}, {"canonical_name": "limit", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "limit", "book_id": "origin_of_species_darwin_1859", "name": "limit", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["limit"], "contexts": ["point or boundary"]}, {"entity_id": "limitation", "book_id": "first_principles_spencer_1862", "name": "limitation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["limitation"], "contexts": ["state of being restricted or confined"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "limit", "target_book": "first_principles_spencer_1862", "target_name": "limitation", "similarity": 0.833}], "id": 5413, "stable_key": "clu_7fdb1988b9246ba5", "ground_truth": {"modern_name": "Limit", "confidence": "high", "type": "concept", "wikidata_id": "Q17376040", "wikidata_description": "type of company used in many jurisdictions; use specific QIDs like Q149789 for the US or others for your country"}}, {"canonical_name": "parasitic worms", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "parasitic_worms", "book_id": "origin_of_species_darwin_1859", "name": "parasitic worms", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["parasitic worms"], "contexts": ["worms that live on or in other organisms"]}, {"entity_id": "worms", "book_id": "principles_of_psychology_james_1890", "name": "worms", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["worms"], "contexts": ["invertebrate animals with simple consciousness"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "parasitic worms", "target_book": "principles_of_psychology_james_1890", "target_name": "worms", "similarity": 0.944}], "id": 5414, "stable_key": "clu_ed92f833abd9a38f", "ground_truth": {"modern_name": "Parasitic worms", "confidence": "high", "type": "animal", "note": "The second mention of 'worms' in James's 'Principles of Psychology' is likely metaphorical or philosophical, but 'parasitic worms' is the primary specific referent.", "wikidata_id": "Q51516710", "wikidata_description": "London :Printed by order of the Trustees of the British Museum,1915. | London School of Hygiene & Tropical Medicine Library & Archives Service (archiv"}}, {"canonical_name": "desert", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "desert", "book_id": "origin_of_species_darwin_1859", "name": "desert", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["desert"], "contexts": ["arid geographical area"]}, {"entity_id": "d\u00e9sert", "book_id": "relation_historique_humboldt_vol3_1825", "name": "D\u00e9sert", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["D\u00e9sert"], "contexts": ["geographic region"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "desert", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "D\u00e9sert", "similarity": 0.924}], "id": 5415, "stable_key": "clu_133e88649b587bda", "ground_truth": {"wikipedia_extract": "A desert is a landscape where little precipitation occurs and, consequently, living conditions create unique biomes and ecosystems. The lack of vegetation exposes the unprotected surface of the ground to denudation. About one-third of the land surface of the Earth is arid or semi-arid. This includes much of the polar regions, where little precipitation occurs, and which are sometimes called polar deserts or \"cold deserts\". Deserts can be classified by the amount of precipitation that falls, by the temperature that prevails, by the causes of desertification or by their geographical location. Deserts are formed by weathering processes as large variations in temperature between day and night strain the rocks, which consequently break into pieces."}}, {"canonical_name": "cotton-trees", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cotton-trees", "book_id": "origin_of_species_darwin_1859", "name": "cotton-trees", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["cotton-trees"], "contexts": ["plants yielding cotton fiber"]}, {"entity_id": "cotton-tree", "book_id": "kosmos_humboldt_1845", "name": "cotton-tree", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["cotton-tree"], "contexts": ["tree producing cotton"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "cotton-trees", "target_book": "kosmos_humboldt_1845", "target_name": "cotton-tree", "similarity": 0.978}], "id": 5416, "stable_key": "clu_87cebfad9afcb992", "ground_truth": {"modern_name": "Cotton", "confidence": "high", "type": "plant", "linnaean": "Gossypium herbaceum", "family": "Malvaceae", "note": "The specific species of cotton can vary, but the genus Gossypium is consistent.", "wikidata_id": "Q719312", "wikidata_description": "genus of plants"}}, {"canonical_name": "stag", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "stag", "book_id": "origin_of_species_darwin_1859", "name": "stag", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["stag"], "contexts": ["example of male weapon importance"]}, {"entity_id": "stag", "book_id": "kosmos_humboldt_1845", "name": "stag", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["stag"], "contexts": ["extant animal found as fossil"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "stag", "target_book": "kosmos_humboldt_1845", "target_name": "stag", "similarity": 1.0}], "id": 5417, "stable_key": "clu_0b4cdedc55c766be", "ground_truth": {"modern_name": "Red Deer", "confidence": "high", "type": "animal", "note": "While 'stag' specifically refers to a male deer, and 'red deer' is a common species associated with this term in British contexts, the early modern texts might have used 'stag' more generally. However, given the context of Darwin and Humboldt, 'red deer' is a strong possibility.", "wikidata_id": "Q79794", "wikidata_description": "species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Red_deer", "wikipedia_extract": "Red Deer is a city in Alberta, Canada, located midway on the Calgary\u2013Edmonton Corridor. Red Deer serves central Alberta, and its key industries include health care, retail trade, construction, oil and gas, hospitality, manufacturing and education. It is surrounded by Red Deer County and borders on Lacombe County. The city is in aspen parkland, a region of rolling hills, alongside the Red Deer River. The area was inhabited by First Nations including the Blackfoot, Plains Cree and Stoney before the arrival of European fur traders in the late eighteenth century. A First Nations trail ran from the Montana Territory across the Bow River near present-day Calgary and on to Fort Edmonton, later known as the Calgary and Edmonton Trail."}}, {"canonical_name": "black cattle", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "black_cattle", "book_id": "origin_of_species_darwin_1859", "name": "black cattle", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["black cattle"], "contexts": ["ancient breed of cattle"]}, {"entity_id": "black_hogs", "book_id": "principles_of_psychology_james_1890", "name": "black hogs", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["black hogs"], "contexts": ["domestic pigs with black coloration"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "black cattle", "target_book": "principles_of_psychology_james_1890", "target_name": "black hogs", "similarity": 0.897}], "id": 5418, "stable_key": "clu_af75f1d6049fe0e9-4", "ground_truth": {"modern_name": "Cattle", "confidence": "high", "type": "animal", "note": "The Spanish 'ganado' directly translates to 'livestock' or 'cattle' in this context.", "wikidata_id": "Q133733", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Cattleya", "wikipedia_extract": "Cattleya () is a genus of orchids from Costa Rica south to Argentina. The genus is abbreviated C in trade journals. Epiphytic or terrestrial orchids with cylindrical rhizome from which the fleshy noodle-like roots grow. Pseudobulbs can be conical, spindle-shaped or cylindrical; with upright growth; one or two leaves growing from the top of them. The leaves can be oblong, lanceolate or elliptical, somewhat fleshy, with smooth margin. The inflorescence is a terminal raceme with few or several flowers."}}, {"canonical_name": "divergence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "divergence", "book_id": "origin_of_species_darwin_1859", "name": "divergence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["divergence"], "contexts": ["process of becoming different"]}, {"entity_id": "divergences", "book_id": "principles_of_psychology_james_1890", "name": "divergences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["divergences"], "contexts": ["movements away from a central point"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "divergence", "target_book": "principles_of_psychology_james_1890", "target_name": "divergences", "similarity": 0.964}], "id": 5419, "stable_key": "clu_7d242d54696f6467", "ground_truth": {"modern_name": "Divergence", "confidence": "high", "type": "concept"}}, {"canonical_name": "sub-classes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sub-classes", "book_id": "origin_of_species_darwin_1859", "name": "sub-classes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sub-classes"], "contexts": ["taxonomic rank below class"]}, {"entity_id": "sub-classes", "book_id": "first_principles_spencer_1862", "name": "sub-classes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sub-classes"], "contexts": ["subdivisions within social classes"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "sub-classes", "target_book": "first_principles_spencer_1862", "target_name": "sub-classes", "similarity": 1.0}], "id": 5420, "stable_key": "clu_dd0c2e5816687a00", "ground_truth": {"modern_name": "Subclasses", "confidence": "high", "type": "concept", "wikidata_id": "Q3965271", "wikidata_description": "class whose elements are all elements of a given other class"}}, {"canonical_name": "ancestors", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ancestors", "book_id": "origin_of_species_darwin_1859", "name": "ancestors", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["ancestors"], "contexts": ["forebears of an organism"]}, {"entity_id": "ancestors", "book_id": "principles_of_psychology_james_1890", "name": "ancestors", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["ancestors"], "contexts": ["forebears"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "ancestors", "target_book": "principles_of_psychology_james_1890", "target_name": "ancestors", "similarity": 1.0}], "id": 5421, "stable_key": "clu_aadd593165b7d791-2", "ground_truth": {"modern_name": "Ancestor", "confidence": "high", "type": "concept", "note": "The term 'progenitor' in these contexts directly refers to an ancestor or ancestral organism, particularly in evolutionary biology.", "wikidata_id": "Q402152", "wikidata_description": "person from whom another person is descended"}}, {"canonical_name": "sea-side", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sea-side", "book_id": "origin_of_species_darwin_1859", "name": "sea-side", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["sea-side"], "contexts": ["location where plants have fleshy leaves"]}, {"entity_id": "sea-shore", "book_id": "kosmos_humboldt_1845", "name": "sea-shore", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["sea-shore"], "contexts": ["land along the edge of the sea"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "sea-side", "target_book": "kosmos_humboldt_1845", "target_name": "sea-shore", "similarity": 0.972}], "id": 5422, "stable_key": "clu_0e0cd5122a1513e9", "ground_truth": {"modern_name": "seaside", "confidence": "high", "type": "place", "country": "N/A", "wikidata_id": "Q745253", "wikidata_description": "Genus of plants in family Asteraceae"}}, {"canonical_name": "Professor Silliman", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "professor_silliman", "book_id": "origin_of_species_darwin_1859", "name": "Professor Silliman", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Professor Silliman"], "contexts": ["scientist who observed cave-rat vision"]}, {"entity_id": "professor_silliman", "book_id": "kosmos_humboldt_1845", "name": "Professor Silliman", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Professor Silliman"], "contexts": ["examined aerolite from Maryland"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Professor Silliman", "target_book": "kosmos_humboldt_1845", "target_name": "Professor Silliman", "similarity": 1.0}], "id": 5423, "stable_key": "clu_de4dc8d4068a1d12", "ground_truth": {"modern_name": "Professor Silliman", "confidence": "high", "type": "person", "birth_year": 1779, "death_year": 1865, "description": "American chemist, geologist, and museum curator", "wikidata_id": "Q817692", "wikidata_description": "early American chemist and science educator (1779\u20131864)"}}, {"canonical_name": "warmer countries", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "warmer_countries", "book_id": "origin_of_species_darwin_1859", "name": "warmer countries", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["warmer countries"], "contexts": ["nations with higher temperatures"]}, {"entity_id": "warm_countries", "book_id": "connexion_physical_sciences_somerville_1858", "name": "warm countries", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["warm countries"], "contexts": ["abound in venomous snakes"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "warmer countries", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "warm countries", "similarity": 0.923}], "id": 5424, "stable_key": "clu_a29d1ab0488e6f87", "ground_truth": {"modern_name": "warmer regions", "confidence": "high", "type": "place", "country": "N/A"}}, {"canonical_name": "European species of plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "european_species_of_plants", "book_id": "origin_of_species_darwin_1859", "name": "European species of plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["European species of plants"], "contexts": ["plants from Azores to England"]}, {"entity_id": "european_species", "book_id": "kosmos_humboldt_1845", "name": "European species", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["European species"], "contexts": ["plant species found in Europe"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "European species of plants", "target_book": "kosmos_humboldt_1845", "target_name": "European species", "similarity": 0.973}], "id": 5425, "stable_key": "clu_cfbef7429126d5e1", "ground_truth": {"modern_name": "European flora", "confidence": "high", "type": "plant", "note": "Refers to plant species found within geographical Europe.", "wikidata_id": "Q31180018", "wikidata_description": "the collective plants of Europe", "wikipedia_extract": "Xanthium strumarium (rough cocklebur, Noogoora burr, clotbur, common cocklebur, large cocklebur, woolgarie bur, Siberian cocklebur) is a species of annual plants in the flowering plant family Asteraceae. Some sources claim it originates in southern Europe and Asia, but has been extensively naturalized elsewhere. Others, such as the Flora of China and Flora of North America, state it originates in the Americas but was an early introduction to Eurasia. The species is monoecious, with the flowers borne in separate unisexual heads: staminate (male) heads situated above the pistillate (female) heads in the inflorescence. The pistillate heads consist of two pistillate flowers surrounded by a spiny involucre. Upon fruiting, these two flowers ripen into two brown to black achenes and they are completely enveloped by the involucre, which becomes a bur.", "wikipedia_url": "https://en.wikipedia.org/wiki/Xanthium_strumarium"}}, {"canonical_name": "Faroe", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "faroe", "book_id": "origin_of_species_darwin_1859", "name": "Faroe", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Faroe"], "contexts": ["cold climate location for rodents"]}, {"entity_id": "faroe_islands", "book_id": "kosmos_humboldt_1845", "name": "Faroe Islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Faroe Islands"], "contexts": ["islands where waters do not freeze"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Faroe", "target_book": "kosmos_humboldt_1845", "target_name": "Faroe Islands", "similarity": 0.942}], "id": 5426, "stable_key": "clu_1111d905a7825b64", "ground_truth": {"modern_name": "Faroe Islands", "confidence": "high", "type": "place", "country": "Denmark", "wikidata_id": "Q4628", "wikidata_description": "North Atlantic archipelago organized as an autonomous constituent country of the Kingdom of Denmark", "wikipedia_url": "https://en.wikipedia.org/wiki/Faroe%20Islands", "wikipedia_extract": "The Faroe Islands ( FAIR-oh), also known as the Faroes, are an archipelago in the North Atlantic Ocean and a rigsdel ('autonomous territory') of the Kingdom of Denmark. Located between Iceland, Norway, and the Hebrides and Shetland isles of Scotland, the islands have a population of 54,870 as of November 2025 and a land area of 1,393 km2 (538 sq mi). The official language is Faroese, which is partially mutually intelligible with Icelandic. The terrain is rugged, dominated by fjords and cliffs with sparse vegetation and few trees. As a result of their proximity to the Arctic Circle, the islands experience perpetual civil twilight during summer nights and very short winter days; nevertheless, they experience a subpolar oceanic climate and mild temperatures year-round due to the Gulf Stream. The capital, T\u00f3rshavn, receives the fewest recorded hours of sunshine of any city in the world at only 840 per year."}}, {"canonical_name": "M. Is. Geoffroy St. Hilaire", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "m__is__geoffroy_st__hilaire", "book_id": "origin_of_species_darwin_1859", "name": "M. Is. Geoffroy St. Hilaire", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["M. Is. Geoffroy St. Hilaire"], "contexts": ["remarked on malconformations"]}, {"entity_id": "m__geoffroy_de_saint-hilnire", "book_id": "relation_historique_humboldt_vol3_1825", "name": "M. Geoffroy de Saint-Hilnire", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["M. Geoffroy de Saint-Hilnire"], "contexts": ["scholar who recognized an analogy"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "M. Is. Geoffroy St. Hilaire", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "M. Geoffroy de Saint-Hilnire", "similarity": 0.851}], "id": 5427, "stable_key": "clu_5ceba728ace928cc", "ground_truth": {"modern_name": "Isidore Geoffroy Saint-Hilaire", "confidence": "high", "type": "person", "birth_year": 1805, "death_year": 1861, "description": "French zoologist known for teratology and evolutionary ideas", "wikidata_id": "Q521190", "wikidata_description": "French zoologist (1805-1861)"}}, {"canonical_name": "Compositous", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "compositous", "book_id": "origin_of_species_darwin_1859", "name": "Compositous", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Compositous"], "contexts": ["family of flowering plants (Asteraceae)"]}, {"entity_id": "compositof", "book_id": "coloquios_da_orta_1563", "name": "Compositof", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Compositof"], "contexts": ["family of plants"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Compositous", "target_book": "coloquios_da_orta_1563", "target_name": "Compositof", "similarity": 0.974}], "id": 5428, "stable_key": "clu_375a00b18b434796", "ground_truth": {"modern_name": "Asteraceae", "confidence": "high", "type": "plant", "family": "Asteraceae", "note": "The term 'Compositous' or 'Compositof' refers to the family Asteraceae, also known as Compositae.", "wikidata_id": "Q25400", "wikidata_description": "large family of flowering plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Asteraceae", "wikipedia_extract": "Asteraceae ( ) is a large family of flowering plants that consists of over 32,000 known species in over 1,900 genera within the order Asterales. The number of species in Asteraceae is rivaled only by the Orchidaceae, and which is the larger family is unclear as the quantity of extant species in each family is unknown. The Asteraceae were first described in the year 1740 and given the original name Compositae. The family is commonly known as the aster, daisy, composite, or sunflower family. Most species of Asteraceae are herbaceous plants, and may be annual, biennial, or perennial, but there are also shrubs, vines, and trees. The family has a widespread distribution, from subpolar to tropical regions, in a wide variety of habitats."}}, {"canonical_name": "Geoffroy", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "geoffroy", "book_id": "origin_of_species_darwin_1859", "name": "Geoffroy", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Geoffroy"], "contexts": ["proposed law of compensation of growth"]}, {"entity_id": "geoffroy", "book_id": "coloquios_da_orta_1563", "name": "Geoffroy", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Geoffroy"], "contexts": ["ancient pharmacologist"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Geoffroy", "target_book": "coloquios_da_orta_1563", "target_name": "Geoffroy", "similarity": 0.662}], "id": 5429, "stable_key": "clu_6cdfb597cb725ef1", "ground_truth": {"modern_name": "Geoffroy Saint-Hilaire", "confidence": "high", "type": "person", "birth_year": 1772, "death_year": 1844, "description": "French naturalist and comparative anatomist", "note": "The context 'ancient pharmacologist' is potentially misleading, as Geoffroy Saint-Hilaire was a prominent 19th-century naturalist. The text might be referring to an earlier figure or an incorrect attribution.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "spinal stripe", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "spinal_stripe", "book_id": "origin_of_species_darwin_1859", "name": "spinal stripe", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["spinal stripe"], "contexts": ["stripe along animal's spine"]}, {"entity_id": "spinal_column", "book_id": "first_principles_spencer_1862", "name": "spinal column", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["spinal column"], "contexts": ["part of the vertebral column"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "spinal stripe", "target_book": "first_principles_spencer_1862", "target_name": "spinal column", "similarity": 0.912}], "id": 5430, "stable_key": "clu_ea9351196d2e4242", "ground_truth": {"modern_name": "spinal stripe", "confidence": "medium", "type": "concept", "note": "The term 'spinal stripe' likely refers to a morphological feature or pattern along the spine of an animal, not the spinal column itself. 'Spinal column' is too broad as a referent for the specific phrase.", "wikidata_id": "Q5140284", "wikidata_description": ""}}, {"canonical_name": "penguin", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "penguin", "book_id": "origin_of_species_darwin_1859", "name": "penguin", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["penguin"], "contexts": ["flightless aquatic bird"]}, {"entity_id": "penguins", "book_id": "kosmos_humboldt_1845", "name": "penguins", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["penguins"], "contexts": ["animal whose excrements were found"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "penguin", "target_book": "kosmos_humboldt_1845", "target_name": "penguins", "similarity": 0.951}], "id": 5431, "stable_key": "clu_09dd678a01bf8694", "ground_truth": {"modern_name": "penguin", "confidence": "high", "type": "animal", "wikidata_id": "Q9147", "wikidata_description": "family of birds in the order Sphenisciformes"}}, {"canonical_name": "transparent tissue", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "transparent_tissue", "book_id": "origin_of_species_darwin_1859", "name": "transparent tissue", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["transparent tissue"], "contexts": ["body tissue that allows light to pass"]}, {"entity_id": "transparent_and_opaque_masses", "book_id": "kosmos_humboldt_1845", "name": "transparent and opaque masses", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["transparent and opaque masses"], "contexts": ["materials with different light properties"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "transparent tissue", "target_book": "kosmos_humboldt_1845", "target_name": "transparent and opaque masses", "similarity": 0.888}], "id": 5432, "stable_key": "clu_885869bb234d98f5", "ground_truth": {"modern_name": "transparent and opaque materials", "confidence": "medium", "type": "concept", "note": "This refers to materials based on their light transmission properties, not a specific substance.", "wikidata_id": "Q2643571", "wikidata_description": "property of light and its interaction with substances or objects", "wikipedia_url": "https://en.wikipedia.org/wiki/Optical_properties", "wikipedia_extract": "The optical properties of a material define how it interacts with light. The optical properties of matter are studied in optical physics (a subfield of optics) and applied in materials science. The optical properties of matter include: Transmittance and Transmission coefficient Reflectance and Reflectivity (reflection coefficient) A basic distinction is between isotropic materials, which exhibit the same properties regardless of the direction of the light, and anisotropic ones, which exhibit different properties when light passes through them in different directions. The optical properties of matter can lead to a variety of interesting optical phenomena. Optical properties of carbon nanotubes Fox, Mark (2010). Optical properties of solids."}}, {"canonical_name": "Frederick Cuvier", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "frederick_cuvier", "book_id": "origin_of_species_darwin_1859", "name": "Frederick Cuvier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Frederick Cuvier"], "contexts": ["naturalist who compared instinct and habit"]}, {"entity_id": "george_cuvier", "book_id": "kosmos_humboldt_1845", "name": "George Cuvier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["George Cuvier"], "contexts": ["scientist known for fossil remains"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Frederick Cuvier", "target_book": "kosmos_humboldt_1845", "target_name": "George Cuvier", "similarity": 0.916}], "id": 5433, "stable_key": "clu_da9e099825972d7b", "ground_truth": {"modern_name": "Frederick Cuvier", "confidence": "high", "type": "person", "birth_year": 1773, "death_year": 1838, "description": "French zoologist and paleontologist, brother of Georges Cuvier.", "note": "Although 'George Cuvier' is also mentioned, the primary referent seems to be Frederick Cuvier based on the Darwin reference. George Cuvier is also a valid, famous naturalist."}}, {"canonical_name": "song", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "song", "book_id": "origin_of_species_darwin_1859", "name": "song", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["song"], "contexts": ["sequence of musical notes"]}, {"entity_id": "song", "book_id": "first_principles_spencer_1862", "name": "song", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["song"], "contexts": ["short musical composition with lyrics"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "song", "target_book": "first_principles_spencer_1862", "target_name": "song", "similarity": 1.0}], "id": 5434, "stable_key": "clu_0dbc00f992c44ef3", "ground_truth": {"modern_name": "song", "confidence": "high", "type": "concept"}}, {"canonical_name": "oxen", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "oxen", "book_id": "origin_of_species_darwin_1859", "name": "oxen", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["oxen"], "contexts": ["domesticated cattle for breeding"]}, {"entity_id": "oxen", "book_id": "principles_of_psychology_james_1890", "name": "oxen", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["oxen"], "contexts": ["domesticated bovine animals"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "oxen", "target_book": "principles_of_psychology_james_1890", "target_name": "oxen", "similarity": 1.0}], "id": 5435, "stable_key": "clu_8b2ca8b66163877b-2", "ground_truth": {"wikipedia_extract": "An ox (pl.: oxen), also known as a bullock (in British, Australian, and Indian English), is a large bovine, trained and used as a draft animal. Oxen are commonly castrated adult male cattle, because castration inhibits testosterone and aggression, which makes the males docile and safer to work with. Cows (intact females) or bulls (intact males) may also be used in some areas. Oxen are used for ploughing, for transport (pulling carts, hauling wagons and even riding), for threshing grain by trampling, and for powering machines that grind grain or supply irrigation among other purposes. Oxen may be also used to skid logs in forests, particularly in low-impact, select-cut logging. Oxen are usually yoked in pairs."}}, {"canonical_name": "Mexican", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mexican", "book_id": "origin_of_species_darwin_1859", "name": "Mexican", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Mexican"], "contexts": ["relating to Mexico"]}, {"entity_id": "mexican", "book_id": "kosmos_humboldt_1845", "name": "Mexican", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Mexican"], "contexts": ["geographic region in Mexico"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Mexican", "target_book": "kosmos_humboldt_1845", "target_name": "Mexican", "similarity": 1.0}], "id": 5436, "stable_key": "clu_9f8d729962fb8284-3", "ground_truth": {"modern_name": "Mexico", "confidence": "high", "type": "place", "country": "Mexico", "wikidata_id": "Q6826187", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Mexico", "wikipedia_extract": "Mexico, officially the United Mexican States, is a country in North America. It is the northernmost country in Latin America and borders the United States to the north, and Guatemala and Belize to the southeast; while having maritime boundaries with the Pacific Ocean to the west, the Caribbean Sea to the southeast, and the Gulf of Mexico to the east. Mexico covers 1,972,550 km2 (761,610 sq mi), and is the thirteenth-largest country in the world by land area. With a population exceeding 130 million, Mexico is the tenth-most populous country in the world and is home to the largest number of native Spanish speakers as of 2020. Mexico City is the capital and largest city, which ranks among the most populous metropolitan areas in the world. Human presence in Mexico dates back to at least 8,000 BC."}}, {"canonical_name": "pimpernels", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pimpernels", "book_id": "origin_of_species_darwin_1859", "name": "pimpernels", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["pimpernels"], "contexts": ["plants ranked as varieties, found sterile"]}, {"entity_id": "pimpollos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "pimpollos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["pimpollos"], "contexts": ["buds of a plant used in medicine"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "pimpernels", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "pimpollos", "similarity": 0.952}], "id": 5437, "stable_key": "clu_bfae13c35e18ccd4", "ground_truth": {"modern_name": "Anagallis", "confidence": "medium", "type": "plant", "linnaean": "Anagallis L.", "family": "Primulaceae", "note": "The term 'pimpernels' most commonly refers to plants of the genus Anagallis. 'Pimpollos' can refer to buds, but in the context of plants used in medicine and ranked as varieties, Anagallis is a strong candidate.", "wikidata_id": "Q157732", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Anagallis"}}, {"canonical_name": "ovaries", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ovaries", "book_id": "origin_of_species_darwin_1859", "name": "ovaries", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["ovaries"], "contexts": ["female reproductive organs in plants"]}, {"entity_id": "ovario", "book_id": "polyanthea_medicinal", "name": "ovario", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["ovario"], "contexts": ["egg-producing organ"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "ovaries", "target_book": "polyanthea_medicinal", "target_name": "ovario", "similarity": 0.942}], "id": 5438, "stable_key": "clu_a42b4eb8ff14e0d9", "ground_truth": {"modern_name": "Ovary", "confidence": "high", "type": "plant", "note": "The term 'ovaries' in this context refers to the plant reproductive organ that contains ovules, not mammalian ovaries. 'Ovario' from Polyanthea Medicinal strongly supports this interpretation."}}, {"canonical_name": "Matthiola annua", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "matthiola_annua", "book_id": "origin_of_species_darwin_1859", "name": "Matthiola annua", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Matthiola annua"], "contexts": ["closely related plant form"]}, {"entity_id": "mathiola_annua", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mathiola annua", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Mathiola annua"], "contexts": ["plant used for paper preparation"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Matthiola annua", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mathiola annua", "similarity": 0.969}], "id": 5439, "stable_key": "clu_c633358e4dd9b408", "ground_truth": {"modern_name": "Stock", "confidence": "high", "type": "plant", "linnaean": "Matthiola incana", "family": "Brassicaceae", "note": "The specific epithet 'annua' is sometimes used, but 'incana' is the more commonly accepted species for ornamental stock. Given the context of its use in scientific texts, it refers to the ornamental plant.", "wikidata_id": "Q27961", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Matthiola", "wikipedia_extract": "Matthiola () is a genus of flowering plant in the mustard family Brassicaceae. It is named after Italian naturalist Pietro Andrea Mattioli (1501\u20131577). The genus contains about 50 species of annual, biennial and perennial herbaceous plants and subshrubs. Many are cultivated for their heavily scented, colorful flowers. The common name stock may be applied to the whole genus, more specifically to varieties and cultivars of Matthiola incana. The common names evening stock and night-scented stock are applied to varieties of Matthiola longipetala (syn."}}, {"canonical_name": "sap", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sap", "book_id": "origin_of_species_darwin_1859", "name": "sap", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["sap"], "contexts": ["fluid circulating in plants"]}, {"entity_id": "sap", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sap", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["sap"], "contexts": ["fluid in plants"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "sap", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sap", "similarity": 1.0}], "id": 5440, "stable_key": "clu_55c6d464f37e6db6-3", "ground_truth": {"modern_name": "Grape must reduction", "confidence": "high", "type": "concept", "description": "Concentrated and reduced grape juice, used as a sweetener and in preparations.", "note": "The term 'sap' in Darwin refers to plant fluid, distinct from the grape must reduction. 'Sapos' in Monardes refers to toads, a different category. 'Sab\u00e3o' (soap) and 'saponis' (of soap) are related to saponification but contextually distinct.", "wikipedia_extract": "Balsamic vinegar (Italian: aceto balsamico) is a dark, concentrated, pungent, intensely flavoured vinegar made wholly or partially from grape must, which is freshly crushed grape juice with all the skins, seeds, and stems. The Italian word balsamico (from Latin balsamum, from Greek \u03b2\u03ac\u03bb\u03c3\u03b1\u03bc\u03bf\u03bd, b\u00e1lsamon) means 'balsam-like' in the sense of \"restorative\" or \"curative\"; cf. English 'balm'. Ultimately from Ancient Hebrew-Phoenician \u05d1\u05e9\u05c2\u05dd (b\u0101\u015b\u0101m or besem, IPA [ba\u02d0\u02c8\u026ca\u02d0m]), the name means 'perfume or spice', with the consonant sequence of the letter '\u03bb' and '\u03c3' deriving from Ancient Greek to pronounce the \u05e9\u05c2 (\u015b) sound, sounding back then as [\u026c]. The term balsamico in \"balsamic vinegar\" originates from the Latin word balsamum and the Greek word \u03b2\u03ac\u03bb\u03c3\u03b1\u03bc\u03bf\u03bd, both conveying the idea of something \"restorative\" or \"curative\". The practice of cooking grapes can be traced back to ancient Roman times, where it was valued both as a medicinal remedy and a sweetener or condiment in cooking."}}, {"canonical_name": "herbaceous", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "herbaceous", "book_id": "origin_of_species_darwin_1859", "name": "herbaceous", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["herbaceous"], "contexts": ["non-woody plant"]}, {"entity_id": "herbage", "book_id": "first_principles_spencer_1862", "name": "herbage", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["herbage"], "contexts": ["vegetation in fields"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "herbaceous", "target_book": "first_principles_spencer_1862", "target_name": "herbage", "similarity": 0.929}], "id": 5441, "stable_key": "clu_3e39d1a72b11b179-2", "ground_truth": {"modern_name": "herbaceous plant", "confidence": "high", "type": "plant", "wikidata_id": "Q190903", "wikidata_description": "plant which has no persistent woody stem above ground", "wikipedia_url": "https://en.wikipedia.org/wiki/Herbaceous%20plant", "wikipedia_extract": "Herbaceous plants are vascular plants that have no persistent woody stems above ground. This broad category of plants includes many perennials, and nearly all annuals and biennials. Definitions of \"herb\" and \"herbaceous\" The fourth edition of the Shorter Oxford English Dictionary defines \"herb\" as: \"A plant whose stem does not become woody and persistent (as in a tree or shrub) but remains soft and succulent, and dies (completely or down to the root) after flowering\"; \"A (freq. aromatic) plant used for flavouring or scent, in medicine, etc.\". (See: Herb) The same dictionary defines \"herbaceous\" as: \"Of the nature of a herb; esp. not forming a woody stem but dying down to the root each year\"; \"BOTANY Resembling a leaf in colour or texture."}}, {"canonical_name": "Pal\u00e6ozoic strata", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pal\u00e6ozoic_strata", "book_id": "origin_of_species_darwin_1859", "name": "Pal\u00e6ozoic strata", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Pal\u00e6ozoic strata"], "contexts": ["geological rock layer"]}, {"entity_id": "pleistocene_strata", "book_id": "kosmos_humboldt_1845", "name": "pleistocene strata", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["pleistocene strata"], "contexts": ["geological layers from the Pleistocene epoch"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Pal\u00e6ozoic strata", "target_book": "kosmos_humboldt_1845", "target_name": "pleistocene strata", "similarity": 0.929}], "id": 5442, "stable_key": "clu_bbe16da5ebdc5563-2", "ground_truth": {"modern_name": "Fossiliferous strata", "confidence": "high", "type": "concept", "note": "This refers to geological layers that contain fossils. The early modern terms accurately describe this geological concept."}}, {"canonical_name": "Nova Scotia", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "nova_scotia", "book_id": "origin_of_species_darwin_1859", "name": "Nova Scotia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Nova Scotia"], "contexts": ["Canadian province"]}, {"entity_id": "nova_scotia", "book_id": "kosmos_humboldt_1845", "name": "Nova Scotia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Nova Scotia"], "contexts": ["location with high tides"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Nova Scotia", "target_book": "kosmos_humboldt_1845", "target_name": "Nova Scotia", "similarity": 1.0}], "id": 5443, "stable_key": "clu_4de54a15a778862c", "ground_truth": {"modern_name": "Nova Scotia", "confidence": "high", "type": "place", "country": "Canada", "wikidata_id": "Q1952", "wikidata_description": "province of Canada", "wikipedia_extract": "Sydney is a former city and urban community on the east coast of Cape Breton Island in Nova Scotia, Canada within the Cape Breton Regional Municipality. Sydney was founded in 1785 by the British, incorporated as a city in 1904, and dissolved on 1 August 1995, when it was amalgamated into the regional municipality. Sydney served as Cape Breton Island's colonial capital until 1820, when the colony was annexed to  Nova Scotia. A rapid population expansion occurred just after the turn of the 20th century, when Sydney became home to one of North America's main steel mills. During both the First and Second World Wars, it was a major staging area for England-bound convoys. The post-war period witnessed a major decline in the number of people employed at the Dominion Steel and Coal Corporation steel mill, and the Nova Scotia and Canadian governments had to nationalize it in 1967 to save the region's biggest employer, forming the new crown corporation called the Sydney Steel Corporation.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sydney,_Nova_Scotia"}}, {"canonical_name": "marine inhabitants", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "marine_inhabitants", "book_id": "origin_of_species_darwin_1859", "name": "marine inhabitants", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["marine inhabitants"], "contexts": ["creatures living in the sea"]}, {"entity_id": "marine_animalcules", "book_id": "kosmos_humboldt_1845", "name": "marine animalcules", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["marine animalcules"], "contexts": ["tiny marine organisms"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "marine inhabitants", "target_book": "kosmos_humboldt_1845", "target_name": "marine animalcules", "similarity": 0.918}], "id": 5444, "stable_key": "clu_4ba7c941e6b31b5d", "ground_truth": {"modern_name": "marine organisms", "confidence": "high", "type": "animal", "note": "This cluster encompasses both larger 'marine inhabitants' and microscopic 'marine animalcules'.", "wikidata_id": "Q124321800", "wikidata_description": "organism living in a marine environment"}}, {"canonical_name": "chapter", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "chapter", "book_id": "origin_of_species_darwin_1859", "name": "chapter", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["chapter"], "contexts": ["section of a book"]}, {"entity_id": "capitulo", "book_id": "coloquios_da_orta_1563", "name": "capitulo", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["capitulo"], "contexts": ["section of a book"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "chapter", "target_book": "coloquios_da_orta_1563", "target_name": "capitulo", "similarity": 0.902}], "id": 5445, "stable_key": "clu_54140c91c139b63f", "ground_truth": {"modern_name": "chapter", "confidence": "high", "type": "object", "wikidata_id": "Q21481766", "wikidata_description": "chapter written by specific authors in a scholarly book"}}, {"canonical_name": "Mylodon", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mylodon", "book_id": "origin_of_species_darwin_1859", "name": "Mylodon", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Mylodon"], "contexts": ["extinct giant ground sloth"]}, {"entity_id": "mylodon", "book_id": "kosmos_humboldt_1845", "name": "mylodon", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["mylodon"], "contexts": ["extinct sloth-like mammal"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Mylodon", "target_book": "kosmos_humboldt_1845", "target_name": "mylodon", "similarity": 0.98}], "id": 5446, "stable_key": "clu_4a0d652f2eee741e", "ground_truth": {"modern_name": "Mylodon", "confidence": "high", "type": "animal", "wikidata_id": "Q1749282", "wikidata_description": "family of mammals", "wikipedia_url": "https://en.wikipedia.org/wiki/Mylodontidae", "wikipedia_extract": "Mylodon is an extinct genus of ground sloth belonging to the family Mylodontidae, known from southern South America. With a total length of 3 to 4 m and a body mass of 1-2 tonnes, it is one of the largest mylodontids (though it was considerably exceeded in size by the mylodontid Lestodon). The oldest finds probably date to the Lower Pleistocene; however, most of the fossil remains date to the Late Pleistocene. Its distribution ranged from southern Bolivia and the Pampas in the north southwards to the southernmost part of Patagonia at around 52-53 degrees south, the furthest south of any Pleistocene ground sloth, with some of the best known remains of the species being from the eponymous Cueva del Milodon (cave of Mylodon) in southern Chile. In addition to skeletal remains, Mylodon is also known from preserved skin and hair. Preserved dung (coprolites) indicates that Mylodon was a primarily a grazer, feeding on grasses and sedges."}}, {"canonical_name": "waters", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "waters", "book_id": "origin_of_species_darwin_1859", "name": "waters", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["waters"], "contexts": ["those in the waters of the sea"]}, {"entity_id": "water-courses", "book_id": "principles_of_psychology_james_1890", "name": "water-courses", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["water-courses"], "contexts": ["channels through which water flows"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "waters", "target_book": "principles_of_psychology_james_1890", "target_name": "water-courses", "similarity": 0.913}], "id": 5447, "stable_key": "clu_f2f93b6180c495b7", "ground_truth": {"modern_name": "Water bodies", "confidence": "high", "type": "place", "note": "Encompasses both general sea waters and specific water courses/channels.", "wikidata_id": "Q3118961", "wikidata_description": "Wikimedia list article"}}, {"canonical_name": "conjointly", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "conjointly", "book_id": "origin_of_species_darwin_1859", "name": "conjointly", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["conjointly"], "contexts": ["acting together"]}, {"entity_id": "conjointement", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Conjointement", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Conjointement"], "contexts": ["jointly"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "conjointly", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Conjointement", "similarity": 0.944}], "id": 5448, "stable_key": "clu_0414392470f97daa", "ground_truth": {"modern_name": "jointly", "confidence": "high", "type": "concept"}}, {"canonical_name": "South Africa", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "south_africa", "book_id": "origin_of_species_darwin_1859", "name": "South Africa", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["South Africa"], "contexts": ["southern hemisphere landmass"]}, {"entity_id": "south_africa", "book_id": "first_principles_spencer_1862", "name": "South Africa", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["South Africa"], "contexts": ["region with indigenous tribes"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "South Africa", "target_book": "first_principles_spencer_1862", "target_name": "South Africa", "similarity": 1.0}], "id": 5449, "stable_key": "clu_4208d1d66d6c13d1", "ground_truth": {"modern_name": "South Africa", "confidence": "high", "type": "place", "country": "South Africa"}}, {"canonical_name": "northern and southern hemispheres", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "northern_and_southern_hemispheres", "book_id": "origin_of_species_darwin_1859", "name": "northern and southern hemispheres", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["northern and southern hemispheres"], "contexts": ["divisions of Earth by equator"]}, {"entity_id": "northern_hemisphere", "book_id": "kosmos_humboldt_1845", "name": "northern hemisphere", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["northern hemisphere"], "contexts": ["part of Earth's surface"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "northern and southern hemispheres", "target_book": "kosmos_humboldt_1845", "target_name": "northern hemisphere", "similarity": 0.94}], "id": 5450, "stable_key": "clu_38eaf44e493961a0-2", "ground_truth": {"modern_name": "Northern Hemisphere", "confidence": "high", "type": "place", "note": "The presence of 'southern hemisphere' in the cluster, along with 'northern hemisphere', indicates a clear geographical/astronomical dichotomy.", "wikidata_id": "Q39061", "wikidata_description": "part of Earth that lies north of the equator"}}, {"canonical_name": "mountain-ranges", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mountain-ranges", "book_id": "origin_of_species_darwin_1859", "name": "mountain-ranges", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["mountain-ranges"], "contexts": ["elevated landforms"]}, {"entity_id": "mountain-groups", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mountain-groups", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["mountain-groups"], "contexts": ["clusters of mountains"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "mountain-ranges", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mountain-groups", "similarity": 0.915}], "id": 5451, "stable_key": "clu_ecbea4b21ae168bb", "ground_truth": {"modern_name": "mountain range", "confidence": "high", "type": "place", "wikidata_id": "Q46831", "wikidata_description": "geographic area containing several geologically related mountains", "wikipedia_url": "https://en.wikipedia.org/wiki/Mountain%20range"}}, {"canonical_name": "training", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "training", "book_id": "origin_of_species_darwin_1859", "name": "training", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["training"], "contexts": ["teaching animals skills"]}, {"entity_id": "training", "book_id": "principles_of_psychology_james_1890", "name": "training", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["training"], "contexts": ["repeated exercise to improve skill"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "training", "target_book": "principles_of_psychology_james_1890", "target_name": "training", "similarity": 1.0}], "id": 5452, "stable_key": "clu_30238f7e96c2d67d", "ground_truth": {"modern_name": "training", "confidence": "high", "type": "concept", "wikidata_id": "Q216033", "wikidata_description": "equestrian sport and art"}}, {"canonical_name": "carrier-pigeons", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "carrier-pigeons", "book_id": "origin_of_species_darwin_1859", "name": "carrier-pigeons", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["carrier-pigeons"], "contexts": ["pigeons used for carrying messages"]}, {"entity_id": "carrier-pigeon", "book_id": "connexion_physical_sciences_somerville_1858", "name": "carrier-pigeon", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["carrier-pigeon"], "contexts": ["bird known for navigation"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "carrier-pigeons", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "carrier-pigeon", "similarity": 0.967}], "id": 5453, "stable_key": "clu_75a18b7dfd7b2d7c", "ground_truth": {"modern_name": "Rock pigeon", "confidence": "high", "type": "animal"}}, {"canonical_name": "temperate regions", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "temperate_regions", "book_id": "origin_of_species_darwin_1859", "name": "temperate regions", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["temperate regions"], "contexts": ["regions with moderate climate"]}, {"entity_id": "temperate_regions", "book_id": "first_principles_spencer_1862", "name": "temperate regions", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["temperate regions"], "contexts": ["regions where plant-life diminishes"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "temperate regions", "target_book": "first_principles_spencer_1862", "target_name": "temperate regions", "similarity": 1.0}], "id": 5454, "stable_key": "clu_f68c2e657c006a90", "ground_truth": {"modern_name": "Temperate climate zones", "confidence": "high", "type": "place", "wikidata_id": "Q167466", "wikidata_description": "main climate class"}}, {"canonical_name": "arctic flora", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "arctic_flora", "book_id": "origin_of_species_darwin_1859", "name": "arctic flora", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["arctic flora"], "contexts": ["plants of arctic regions"]}, {"entity_id": "sub-arctic_flora", "book_id": "kosmos_humboldt_1845", "name": "sub-Arctic flora", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["sub-Arctic flora"], "contexts": ["flora adapted to cold climates"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "arctic flora", "target_book": "kosmos_humboldt_1845", "target_name": "sub-Arctic flora", "similarity": 0.952}], "id": 5455, "stable_key": "clu_9254778512b46f4f", "ground_truth": {"modern_name": "Arctic flora", "confidence": "high", "type": "plant", "wikipedia_extract": "Arctic geopolitics is the area study of geopolitics on the Arctic region. The study of geopolitics deals with the \"inalienable relationship between geography and politics\", as it investigates the effects of the Earth's geography on politics and international relations. Arctic geopolitics focuses on the inter-state relations in the Arctic, which is the northernmost polar region. It is composed of the Arctic Ocean and its adjacent seas, and is home to around four million people. The states in or bordering the Arctic are commonly referred to as the Arctic Eight, and are the United States, Canada, Russia, Finland, the Kingdom of Denmark (Greenland), Norway, Iceland and Sweden. The Arctic region is a unique environment.", "wikipedia_url": "https://en.wikipedia.org/wiki/Geopolitics_of_the_Arctic"}}, {"canonical_name": "glacial action", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "glacial_action", "book_id": "origin_of_species_darwin_1859", "name": "glacial action", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["glacial action"], "contexts": ["process of ice shaping the land"]}, {"entity_id": "igneous_action", "book_id": "first_principles_spencer_1862", "name": "igneous action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["igneous action"], "contexts": ["process involving molten rock"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "glacial action", "target_book": "first_principles_spencer_1862", "target_name": "igneous action", "similarity": 0.927}], "id": 5456, "stable_key": "clu_11b2a9768e716fe1", "ground_truth": {"modern_name": "Glacial erosion", "confidence": "high", "type": "concept", "note": "The cluster combines 'glacial action' with 'igneous action'. 'Glacial action' clearly refers to the geological processes of glaciers.", "wikidata_id": "Q11549661", "wikidata_description": "geologic process"}}, {"canonical_name": "intertropical regions", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "intertropical_regions", "book_id": "origin_of_species_darwin_1859", "name": "intertropical regions", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["intertropical regions"], "contexts": ["regions near the equator"]}, {"entity_id": "america_intertropical", "book_id": "coloquios_da_orta_1563", "name": "America intertropical", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["America intertropical"], "contexts": ["region where pepper is cultivated"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "intertropical regions", "target_book": "coloquios_da_orta_1563", "target_name": "America intertropical", "similarity": 0.886}], "id": 5457, "stable_key": "clu_0ee92cd6c0fd230c", "ground_truth": {"modern_name": "Intertropical regions", "confidence": "high", "type": "place", "country": "Global"}}, {"canonical_name": "whirlwinds", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "whirlwinds", "book_id": "origin_of_species_darwin_1859", "name": "whirlwinds", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["whirlwinds"], "contexts": ["accidental means of fish transport"]}, {"entity_id": "whirlwind", "book_id": "connexion_physical_sciences_somerville_1858", "name": "whirlwind", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["whirlwind"], "contexts": ["storm phenomenon with augmented breadth"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "whirlwinds", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "whirlwind", "similarity": 0.932}], "id": 5458, "stable_key": "clu_7035d4a76a88656c", "ground_truth": {"modern_name": "Whirlwind", "confidence": "high", "type": "concept"}}, {"canonical_name": "E. V.", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "e__v_", "book_id": "origin_of_species_darwin_1859", "name": "E. V.", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["E. V."], "contexts": ["informed about birds blown to Madeira"]}, {"entity_id": "j__v_", "book_id": "principles_of_psychology_james_1890", "name": "J. V.", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["J. V."], "contexts": ["person described as amiable and radiant"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "E. V.", "target_book": "principles_of_psychology_james_1890", "target_name": "J. V.", "similarity": 0.892}], "id": 5459, "stable_key": "clu_a0d8c5af9696f261", "ground_truth": {"modern_name": "E. V.", "confidence": "low", "type": "person", "description": "Individual mentioned in scientific correspondence", "note": "Insufficient information to identify specific individual.", "wikidata_id": "Q9299236", "wikidata_description": "registered voluntary association in Germany"}}, {"canonical_name": "herbaceous species", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "herbaceous_species", "book_id": "origin_of_species_darwin_1859", "name": "herbaceous species", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["herbaceous species"], "contexts": ["non-woody plant types"]}, {"entity_id": "foliaceous_shrubs", "book_id": "kosmos_humboldt_1845", "name": "foliaceous shrubs", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["foliaceous shrubs"], "contexts": ["present in tertiary period"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "herbaceous species", "target_book": "kosmos_humboldt_1845", "target_name": "foliaceous shrubs", "similarity": 0.889}], "id": 5460, "stable_key": "clu_3e39d1a72b11b179-3", "ground_truth": {"modern_name": "herbaceous plant", "confidence": "high", "type": "plant", "wikidata_id": "Q190903", "wikidata_description": "plant which has no persistent woody stem above ground", "wikipedia_url": "https://en.wikipedia.org/wiki/Herbaceous%20plant", "wikipedia_extract": "Herbaceous plants are vascular plants that have no persistent woody stems above ground. This broad category of plants includes many perennials, and nearly all annuals and biennials. Definitions of \"herb\" and \"herbaceous\" The fourth edition of the Shorter Oxford English Dictionary defines \"herb\" as: \"A plant whose stem does not become woody and persistent (as in a tree or shrub) but remains soft and succulent, and dies (completely or down to the root) after flowering\"; \"A (freq. aromatic) plant used for flavouring or scent, in medicine, etc.\". (See: Herb) The same dictionary defines \"herbaceous\" as: \"Of the nature of a herb; esp. not forming a woody stem but dying down to the root each year\"; \"BOTANY Resembling a leaf in colour or texture."}}, {"canonical_name": "Celebes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "celebes", "book_id": "origin_of_species_darwin_1859", "name": "Celebes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Celebes"], "contexts": ["island in Indonesia"]}, {"entity_id": "celebes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Celebes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Celebes"], "contexts": ["island affected by eruption"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Celebes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Celebes", "similarity": 1.0}], "id": 5461, "stable_key": "clu_b4404d7f446a0a92", "ground_truth": {"modern_name": "Celebes", "confidence": "high", "type": "place", "country": "Indonesia", "note": "Modern name is Sulawesi.", "wikidata_id": "Q28831520", "wikidata_description": "species of bird", "wikipedia_url": "https://en.wikipedia.org/wiki/Sulawesi", "wikipedia_extract": "Sulawesi ( SOO-l\u0259-WAY-see, Indonesian: [\u02ccsula\u02c8wesi]), also known as Celebes ( SEL-ib-eez, s\u0259-LEE-beez), is an island in Indonesia. One of the four Greater Sunda Islands, and the world's 11th-largest island, it is situated east of Borneo, west of the Maluku Islands, and south of Mindanao and the Sulu Archipelago. Within Indonesia, only Sumatra, Borneo, and Papua are larger in territory, and only Java and Sumatra are more populous. The landmass of Sulawesi includes four peninsulas: the northern Minahasa Peninsula, the East Peninsula, the South Peninsula, and the Southeast Peninsula. Three gulfs separate these peninsulas: the Gulf of Tomini between the northern Minahasa and East peninsulas, the Tolo Gulf between the East and Southeast peninsulas, and the Gulf of Boni between the South and Southeast peninsulas. The Strait of Makassar runs along the western side of the island and separates the island from Borneo."}}, {"canonical_name": "representative species", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "representative_species", "book_id": "origin_of_species_darwin_1859", "name": "representative species", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["representative species"], "contexts": ["similar species in different locations"]}, {"entity_id": "representative_species", "book_id": "kosmos_humboldt_1845", "name": "representative species", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["representative species"], "contexts": ["species similar to others in different regions"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "representative species", "target_book": "kosmos_humboldt_1845", "target_name": "representative species", "similarity": 1.0}], "id": 5462, "stable_key": "clu_c28d1673a24d3dbe", "ground_truth": {"modern_name": "Representative species", "confidence": "high", "type": "concept", "note": "This refers to a species that is representative of a group or geographical area, particularly in the context of biological classification and biogeography.", "wikidata_id": "Q121914121", "wikidata_description": "scientific article published in 2018"}}, {"canonical_name": "organs of vegetation", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "organs_of_vegetation", "book_id": "origin_of_species_darwin_1859", "name": "organs of vegetation", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["organs of vegetation"], "contexts": ["parts related to plant growth"]}, {"entity_id": "vegetable_organs", "book_id": "kosmos_humboldt_1845", "name": "vegetable organs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["vegetable organs"], "contexts": ["structures in plants"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "organs of vegetation", "target_book": "kosmos_humboldt_1845", "target_name": "vegetable organs", "similarity": 0.955}], "id": 5463, "stable_key": "clu_81271ce5c9861d76", "ground_truth": {"modern_name": "Plant organs", "confidence": "high", "type": "concept", "note": "This refers to the parts of a plant responsible for its growth and life processes, as opposed to animal anatomy.", "wikidata_id": "Q76149614", "wikidata_description": "scientific article published on 01 January 1951"}}, {"canonical_name": "Proteace\u00e6", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "proteace\u00e6", "book_id": "origin_of_species_darwin_1859", "name": "Proteace\u00e6", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Proteace\u00e6"], "contexts": ["plant family discussed by Robert Brown"]}, {"entity_id": "prot\u00e9ac\u00e9es", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Prot\u00e9ac\u00e9es", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Prot\u00e9ac\u00e9es"], "contexts": ["plant family, not exclusively austral"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Proteace\u00e6", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Prot\u00e9ac\u00e9es", "similarity": 0.936}], "id": 5464, "stable_key": "clu_bd357f4a48fa412b", "ground_truth": {"modern_name": "Proteaceae", "confidence": "high", "type": "plant", "family": "Proteaceae", "wikidata_id": "Q157228", "wikidata_description": "family of plants in the Proteales order", "wikipedia_url": "https://en.wikipedia.org/wiki/Grevilleoideae", "wikipedia_extract": "The Grevilleoideae are a subfamily of the plant family Proteaceae. Mainly restricted to the Southern Hemisphere, it contains around 46 genera and about 950 species. Genera include Banksia, Grevillea, and Macadamia. The Grevilleoideae grow as trees, shrubs, or subshrubs. They are highly variable, making a simple, diagnostic identification key for the subfamily essentially impossible to provide. One common and fairly diagnostic characteristic is the occurrence of flowers in pairs that share a common bract."}}, {"canonical_name": "adult", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "adult", "book_id": "origin_of_species_darwin_1859", "name": "adult", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["adult"], "contexts": ["fully developed organism"]}, {"entity_id": "adult", "book_id": "first_principles_spencer_1862", "name": "adult", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["adult"], "contexts": ["fully developed organism"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "adult", "target_book": "first_principles_spencer_1862", "target_name": "adult", "similarity": 1.0}], "id": 5465, "stable_key": "clu_fe93b6ac71440270", "ground_truth": {"modern_name": "Adult organism", "confidence": "high", "type": "concept", "note": "Refers to an organism that has reached full maturity and is capable of reproduction.", "wikidata_id": "Q130551624", "wikidata_description": ""}}, {"canonical_name": "Catasetum", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "catasetum", "book_id": "origin_of_species_darwin_1859", "name": "Catasetum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Catasetum"], "contexts": ["genus of orchids"]}, {"entity_id": "catasetum_inaculutiun", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Catasetum inaculutiun", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Catasetum inaculutiun"], "contexts": ["orchid species"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Catasetum", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Catasetum inaculutiun", "similarity": 0.901}], "id": 5466, "stable_key": "clu_4e0c766419b57115", "ground_truth": {"wikipedia_extract": "Catasetum, abbreviated as Ctsm. in horticultural trade, is a genus of showy epiphytic  Orchids, family Orchidaceae, subfamily Epidendroideae, tribe Cymbidieae, subtribe Catasetinae, with currently 200 accepted species, many of which are highly prized in horticulture. Species of the genus Catasetum occur from Mexico to Argentina, including much of Central America, the West Indies, and South America. The largest number of species is in Brazil. They have thick, cigar-shaped pseudobulbs which are clustered. The leaves are pleated in the upper part and deciduous. The pseudobulbs become spiny after the leaves have dropped."}}, {"canonical_name": "kangaroo", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "kangaroo", "book_id": "origin_of_species_darwin_1859", "name": "kangaroo", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["kangaroo"], "contexts": ["marsupial mammal"]}, {"entity_id": "kangaroo", "book_id": "kosmos_humboldt_1845", "name": "kangaroo", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["kangaroo"], "contexts": ["animal with fossil remains"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "kangaroo", "target_book": "kosmos_humboldt_1845", "target_name": "kangaroo", "similarity": 1.0}], "id": 5467, "stable_key": "clu_563ee0c7acf10eb0", "ground_truth": {"modern_name": "Kangaroo", "confidence": "high", "type": "animal", "wikidata_id": "Q23193", "wikidata_description": "family of mammals", "wikipedia_extract": "Tree-kangaroos are marsupials of the genus Dendrolagus, adapted for arboreal locomotion. They inhabit the tropical rainforests of New Guinea and far northeastern  Queensland, Australia along with some of the islands in the region. Most species of tree-kangaroo are considered threatened due to hunting and habitat destruction. They are the only true arboreal macropods. The evolutionary history of tree-kangaroos possibly begins with a rainforest floor-dwelling pademelon-like ancestor. This ancestor possibly evolved from an arboreal possum-like ancestor as is suspected of all macropodid marsupials in Australia and New Guinea.", "wikipedia_url": "https://en.wikipedia.org/wiki/Macropodidae"}}, {"canonical_name": "bones of the skull", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bones_of_the_skull", "book_id": "origin_of_species_darwin_1859", "name": "bones of the skull", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bones of the skull"], "contexts": ["skeletal structure protecting the brain"]}, {"entity_id": "cranial_bones", "book_id": "first_principles_spencer_1862", "name": "cranial bones", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["cranial bones"], "contexts": ["bones of the skull"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "bones of the skull", "target_book": "first_principles_spencer_1862", "target_name": "cranial bones", "similarity": 0.906}], "id": 5468, "stable_key": "clu_6bac0225b4181c72", "ground_truth": {"modern_name": "Cranial bones", "confidence": "high", "type": "concept", "wikidata_id": "Q6581923", "wikidata_description": ""}}, {"canonical_name": "bone", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bone", "book_id": "origin_of_species_darwin_1859", "name": "bone", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["bone"], "contexts": ["hard connective tissue forming the skeleton"]}, {"entity_id": "bone", "book_id": "principles_of_psychology_james_1890", "name": "bone", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["bone"], "contexts": ["material held by dog's paw"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "bone", "target_book": "principles_of_psychology_james_1890", "target_name": "bone", "similarity": 1.0}], "id": 5469, "stable_key": "clu_0d705b78150e0712", "ground_truth": {"modern_name": "Bone", "confidence": "high", "type": "concept"}}, {"canonical_name": "Professor Huxley", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "professor_huxley", "book_id": "origin_of_species_darwin_1859", "name": "Professor Huxley", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Professor Huxley"], "contexts": ["noted naturalist and biologist"]}, {"entity_id": "professor_huxley", "book_id": "first_principles_spencer_1862", "name": "Professor Huxley", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Professor Huxley"], "contexts": ["friend who suggested 'persistence'"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Professor Huxley", "target_book": "first_principles_spencer_1862", "target_name": "Professor Huxley", "similarity": 1.0}], "id": 5470, "stable_key": "clu_a3aa79a43c86426d-2", "ground_truth": {"modern_name": "Thomas Henry Huxley", "confidence": "high", "type": "person", "birth_year": 1825, "death_year": 1895, "description": "English biologist, prominent defender of Darwin's theory", "wikidata_id": "Q55008580", "wikidata_description": "portrait by Jose Maria Mora"}}, {"canonical_name": "imago", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "imago", "book_id": "origin_of_species_darwin_1859", "name": "imago", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["imago"], "contexts": ["adult stage of insect"]}, {"entity_id": "imago", "book_id": "first_principles_spencer_1862", "name": "imago", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["imago"], "contexts": ["stage evolved from pupa"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "imago", "target_book": "first_principles_spencer_1862", "target_name": "imago", "similarity": 1.0}], "id": 5471, "stable_key": "clu_c19a8196b7824754", "ground_truth": {"modern_name": "Imago", "confidence": "high", "type": "animal", "wikipedia_extract": "Terrestrial animals are animals that live predominantly or entirely on land (e.g., cats, chickens, ants, most spiders), as compared with aquatic animals (e.g., fish, whales, octopuses, lobsters, etc.), who live predominantly or entirely in bodies of water; and semiaquatic animals (e.g., crocodilians, seals, platypus and most amphibians), who inhabit coastal, riparian or wetland areas and rely on both aquatic and terrestrial habitats. While most insects (who constitute over half of all known species in the animal kingdom) are terrestrial, some groups, such as mosquitoes and dragonflies, spend their egg and larval stages in water but emerge as fully terrestrial adults (imagos) after completing metamorphosis. Terrestrial animals conduct respiratory gas exchange directly with the atmosphere, typically via specialized respiratory organs known as lungs, or via cutaneous respiration across the skin. They have also evolved homeostatic features such as impermeable cuticles that can restrict fluid loss, temperature fluctuations and infection, and an excretory system that can filter out nitrogenous waste in the form of urea or uric acid, in contrast to the ammonia-based excretion of aquatic animals. Without the buoyancy of an aqueous environment to support their weight, they have evolved robust skeletons that can hold up their body shape, as well as powerful appendages known as legs or limbs to facilitate terrestrial locomotion, although some perform limbless locomotion using body surface projections such as scales and setae. Some terrestrial animals even have wings or membranes that act as airfoils to generate lift, allowing them to fly and/or glide as airborne animals.", "wikipedia_url": "https://en.wikipedia.org/wiki/Terrestrial_animal"}}, {"canonical_name": "organs of the senses", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "organs_of_the_senses", "book_id": "origin_of_species_darwin_1859", "name": "organs of the senses", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["organs of the senses"], "contexts": ["body parts for perception"]}, {"entity_id": "organs_of_the_senses", "book_id": "kosmos_humboldt_1845", "name": "organs of the senses", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["organs of the senses"], "contexts": ["body parts for perceiving the world"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "organs of the senses", "target_book": "kosmos_humboldt_1845", "target_name": "organs of the senses", "similarity": 1.0}], "id": 5472, "stable_key": "clu_6fa455967b509ef0", "ground_truth": {"modern_name": "Sense organs", "confidence": "high", "type": "concept"}}, {"canonical_name": "phosphate of lime", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "phosphate_of_lime", "book_id": "origin_of_species_darwin_1859", "name": "phosphate of lime", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["phosphate of lime"], "contexts": ["calcium phosphate compound"]}, {"entity_id": "ferrocarbonate_of_lime", "book_id": "connexion_physical_sciences_somerville_1858", "name": "ferrocarbonate of lime", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["ferrocarbonate of lime"], "contexts": ["crystal whose optic axis reverses with temperature"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "phosphate of lime", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ferrocarbonate of lime", "similarity": 0.915}], "id": 5473, "stable_key": "clu_1e9df6846d6a3fbb", "ground_truth": {"modern_name": "Calcium phosphate", "confidence": "high", "type": "chemical", "note": "Ferrocarbonate of lime is likely a misreading or an archaic/less common term for a related iron-containing calcium carbonate compound.", "wikidata_id": "Q278387", "wikidata_description": "chemical compound Ca\u2083P\u2082O\u2088"}}, {"canonical_name": "living things", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "living_things", "book_id": "origin_of_species_darwin_1859", "name": "living things", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["living things"], "contexts": ["organisms"]}, {"entity_id": "living_things", "book_id": "principles_of_psychology_james_1890", "name": "living things", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["living things"], "contexts": ["organisms that are alive"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "living things", "target_book": "principles_of_psychology_james_1890", "target_name": "living things", "similarity": 1.0}], "id": 5474, "stable_key": "clu_18b221ab26d29042-3", "ground_truth": {"modern_name": "Organism", "confidence": "high", "type": "concept", "wikidata_id": "Q7239", "wikidata_description": "any individual living being or physical living system", "wikipedia_url": "https://en.wikipedia.org/wiki/Organism", "wikipedia_extract": "An organism is any living thing that functions as an individual. Such a definition raises more problems than it solves, not least because the concept of an individual is also difficult. Several criteria, few of which are widely accepted, have been proposed to define what constitutes an organism. Among the most common is that an organism has autonomous reproduction, growth, and metabolism. This would exclude viruses, even though they evolve like organisms. Other problematic cases include colonial organisms; a colony of eusocial insects is organised adaptively, and has germ-soma specialisation, with some insects reproducing, others not, like cells in an animal's body."}}, {"canonical_name": "cellular structure", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cellular_structure", "book_id": "origin_of_species_darwin_1859", "name": "cellular structure", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["cellular structure"], "contexts": ["organization of cells"]}, {"entity_id": "cellular_structure", "book_id": "kosmos_humboldt_1845", "name": "cellular structure", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["cellular structure"], "contexts": ["interior portion of plant organs"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "cellular structure", "target_book": "kosmos_humboldt_1845", "target_name": "cellular structure", "similarity": 1.0}], "id": 5475, "stable_key": "clu_6772a5549ef5e6f9", "ground_truth": {"modern_name": "Cellular structure", "confidence": "high", "type": "concept", "wikidata_id": "Q22294934", "wikidata_description": "The process in which cellular structures, including whole cells or cell parts, are generated and organized."}}, {"canonical_name": "boulders", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "boulders", "book_id": "origin_of_species_darwin_1859", "name": "boulders", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["boulders"], "contexts": ["large rocks transported by glaciers"]}, {"entity_id": "boulders", "book_id": "first_principles_spencer_1862", "name": "boulders", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["boulders"], "contexts": ["deposited in rapids"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "boulders", "target_book": "first_principles_spencer_1862", "target_name": "boulders", "similarity": 1.0}], "id": 5476, "stable_key": "clu_4156c15d23ac54bd-2", "ground_truth": {"modern_name": "Boulder", "confidence": "high", "type": "mineral", "wikidata_id": "Q192517", "wikidata_description": "city in and county seat of Boulder County, Colorado, United States"}}, {"canonical_name": "Faunas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "faunas", "book_id": "origin_of_species_darwin_1859", "name": "Faunas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Faunas"], "contexts": ["assemblages of animals"]}, {"entity_id": "faunes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Faunes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Faunes"], "contexts": ["assemblages of animals"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Faunas", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Faunes", "similarity": 0.928}], "id": 5477, "stable_key": "clu_4197920e5ace28b8", "ground_truth": {"modern_name": "Fauna", "confidence": "high", "type": "animal", "note": "The term 'Faunas' is the plural of 'Fauna', referring to the animal life of a region or period."}}, {"canonical_name": "bamboos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bamboos", "book_id": "origin_of_species_darwin_1859", "name": "bamboos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["bamboos"], "contexts": ["plant with hooks"]}, {"entity_id": "bamboos", "book_id": "kosmos_humboldt_1845", "name": "bamboos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["bamboos"], "contexts": ["plants found in equatorial regions"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "bamboos", "target_book": "kosmos_humboldt_1845", "target_name": "bamboos", "similarity": 1.0}], "id": 5478, "stable_key": "clu_1f53217dd0179861-3", "ground_truth": {"modern_name": "Bamboo", "confidence": "high", "type": "plant", "linnaean": "Bambuseae", "family": "Poaceae", "note": "Bambusa is a tribe, not a genus, but commonly used for bamboo in older texts.", "wikidata_id": "Q670887", "wikidata_description": "subfamily of plants"}}, {"canonical_name": "Huber, P.", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "huber,_p_", "book_id": "origin_of_species_darwin_1859", "name": "Huber, P.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Huber, P."], "contexts": ["on reason blended with instinct"]}, {"entity_id": "a__huber", "book_id": "principles_of_psychology_james_1890", "name": "A. Huber", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["A. Huber"], "contexts": ["author of Das Ged\u00e4chtniss"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Huber, P.", "target_book": "principles_of_psychology_james_1890", "target_name": "A. Huber", "similarity": 0.884}], "id": 5479, "stable_key": "clu_be50363d06860824", "ground_truth": {"modern_name": "Pierre Huber", "confidence": "medium", "type": "person", "description": "Author of works on memory and instinct", "note": "Identification is tentative due to partial name and ambiguity with other Hubers.", "wikidata_id": "Q25374203", "wikidata_description": "Swiss entomologist (1777-1840)"}}, {"canonical_name": "Primula", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "primula", "book_id": "origin_of_species_darwin_1859", "name": "Primula", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Primula"], "contexts": ["plant genus with varieties"]}, {"entity_id": "primula", "book_id": "connexion_physical_sciences_somerville_1858", "name": "primula", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["primula"], "contexts": ["flower found in Himalaya"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Primula", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "primula", "similarity": 0.917}], "id": 5480, "stable_key": "clu_8a737eeb92241157", "ground_truth": {"modern_name": "Primula", "confidence": "high", "type": "plant", "linnaean": "Primula", "family": "Primulaceae", "note": "Primula is a genus of flowering plants."}}, {"canonical_name": "Sageret", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sageret", "book_id": "origin_of_species_darwin_1859", "name": "Sageret", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Sageret"], "contexts": ["author on grafts"]}, {"entity_id": "saliceto", "book_id": "historia_medicinal_monardes_1574", "name": "Saliceto", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Saliceto"], "contexts": ["Saliceto said all this"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Sageret", "target_book": "historia_medicinal_monardes_1574", "target_name": "Saliceto", "similarity": 0.878}], "id": 5481, "stable_key": "clu_99d3e7a0c76b9230", "ground_truth": {"modern_name": "Sageret", "confidence": "medium", "type": "person", "description": "Author on grafts, likely Auguste Sageret.", "note": "The text mentions 'Sageret' in the context of Darwin's work on hybridization and 'Saliceto' in Monardes' medicinal history. Assuming 'Sageret' refers to Auguste Sageret, a French botanist known for his work on plant hybridization. 'Saliceto' might refer to a different figure or a misreading, but given the context of grafts, Sageret is the more likely intended referent for the Darwin citation.", "wikidata_id": "Q2871651", "wikidata_description": "French botanist (1763-1851)"}}, {"canonical_name": "sea-shore", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sea-shore", "book_id": "origin_of_species_darwin_1859", "name": "sea-shore", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["sea-shore"], "contexts": ["area where insects have colours"]}, {"entity_id": "ocean_shore", "book_id": "kosmos_humboldt_1845", "name": "ocean shore", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["ocean shore"], "contexts": ["location with waves and sea weeds"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "sea-shore", "target_book": "kosmos_humboldt_1845", "target_name": "ocean shore", "similarity": 0.975}], "id": 5482, "stable_key": "clu_8dfaf03ebf057298-3", "ground_truth": {"modern_name": "Coastline", "confidence": "high", "type": "place", "note": "This refers to the general geographical feature of land bordering the sea.", "wikidata_id": "Q1701967", "wikidata_description": "outline of the coast"}}, {"canonical_name": "melezina", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "melezina", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "melezina", "category": "SUBSTANCE", "subcategory": "PREPARATI