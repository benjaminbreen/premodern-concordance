ory": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["fiebres quartanas"], "contexts": ["fever type treated by Chilapatli", "fevers that return every four days"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "fi\u00e8vre quarte", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "fiebres quartanas", "similarity": 0.934}], "id": 4342, "stable_key": "clu_c2be2938b4f02c36", "ground_truth": {"modern_name": "Quartan fever", "confidence": "high", "type": "disease", "modern_term": "Quartan malaria", "wikidata_id": "Q18554742", "wikidata_description": "malaria caused by a parasite Plasmodium malariae, which is marked by recurrence of paroxysms at 72-hour intervals", "wikipedia_url": "https://en.wikipedia.org/wiki/Quartan%20fever"}}, {"canonical_name": "De l'Isle", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "de_l'isle", "book_id": "relation_historique_humboldt_vol3_1825", "name": "De l'Isle", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["De l'Isle", "M. de l'Isle"], "contexts": ["early geographer", "papers containing Boudier's observations"]}, {"entity_id": "delisle", "book_id": "kosmos_humboldt_1845", "name": "Delisle", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Delisle"], "contexts": ["scholar on Earth's circumference statements"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "De l'Isle", "target_book": "kosmos_humboldt_1845", "target_name": "Delisle", "similarity": 0.531}], "id": 4343, "stable_key": "clu_19a57eea5eaa1de4-2", "ground_truth": {"modern_name": "Joseph von Fraunhofer", "confidence": "low", "type": "person", "birth_year": 1787, "death_year": 1826, "description": "German physicist, optician, and scientific instrument maker", "note": "The references to 'Dollond' and 'De l'Isle' (Delisle) point towards optics and instrument making, areas strongly associated with Fraunhofer. 'Dorta' is less clear but the cluster also includes observations in Brazil, which aligns with Humboldt's context. However, there are also references to 'Dorta' as an early geographer and maker of thermometers, which is not a strong match for Fraunhofer. Without more context linking 'Dorta' directly to the others or to Fraunhofer's specific work, the identification is uncertain.", "wikidata_id": "Q100483762", "wikidata_description": "street in Magdeburg, Saxony-Anhalt, Germany"}}, {"canonical_name": "Zoology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "zoologique", "book_id": "medecine_experimentale_bernard_1865", "name": "zoologique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["zoologique"], "contexts": ["viewpoint in biology concerning animals"]}, {"entity_id": "zoology", "book_id": "first_principles_spencer_1862", "name": "Zoology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Zoology"], "contexts": ["scientific study of animals", "branch of science studying animals"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "zoologique", "target_book": "first_principles_spencer_1862", "target_name": "Zoology", "similarity": 0.898}], "id": 4344, "stable_key": "clu_dbd6395a39b597ec-2", "ground_truth": {"modern_name": "Zoology", "confidence": "high", "type": "concept", "note": "The term 'zoology' consistently refers to the scientific study of animals."}}, {"canonical_name": "tubulos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tubes", "book_id": "medecine_experimentale_bernard_1865", "name": "tubes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["tubes"], "contexts": ["hollow structures for transport"]}, {"entity_id": "tubulos", "book_id": "polya