ernard_1865", "source_name": "induction", "target_book": "kosmos_humboldt_1845", "target_name": "induction", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "induction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Induction", "similarity": 0.994}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "induction", "target_book": "first_principles_spencer_1862", "target_name": "induction", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "induction", "target_book": "kosmos_humboldt_1845", "target_name": "induction", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "induction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Induction", "similarity": 0.994}, {"source_book": "principles_of_psychology_james_1890", "source_name": "induction", "target_book": "first_principles_spencer_1862", "target_name": "induction", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "induction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Induction", "similarity": 0.994}, {"source_book": "kosmos_humboldt_1845", "source_name": "induction", "target_book": "first_principles_spencer_1862", "target_name": "induction", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Induction", "target_book": "first_principles_spencer_1862", "target_name": "induction", "similarity": 0.994}], "id": 109, "stable_key": "clu_56f3ffe1429317ad", "ground_truth": {"modern_name": "Induction", "confidence": "high", "type": "concept", "wikidata_id": "Q484511", "wikidata_description": "method of reasoning in which a body of observations is synthesized to hypothesize a general principle", "wikipedia_url": "https://en.wikipedia.org/wiki/Inductive%20reasoning", "wikipedia_extract": "Inductive reasoning refers to a variety of methods of reasoning in which the conclusion of an argument is supported not with deductive certainty, but at best with some degree of probability. Unlike deductive reasoning (such as mathematical induction), where the conclusion is certain, given the premises are correct, inductive reasoning produces conclusions that are at best probable, given the evidence provided. The types of inductive reasoning include generalization, prediction, statistical syllogism, argument from analogy, and causal inference. There are also differences in how their results are regarded. A generalization (more accurately, an inductive generalization) proceeds from premises about a sample to a conclusion about the population. The observation obtained from this sample is projected onto the broader population."}}, {"canonical_name": "muscles", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 5, "total_mentions": 43, "members": [{"entity_id": "muscles", "book_id": "medecine_experimentale_bernard_1865", "name": "muscles", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["muscles"], "contexts": ["body tissues responsible for movement", "tissue retaining normal contractility"]}, {"entity_id": "muscles", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "muscles", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["muscles"], "contexts": ["body tissues for movement"]}, {"entity_id": "muscles", "book_id": "origin_of_species_darwin_1859", "name": "muscles", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["muscles"], "contexts": ["body tissues for movement", "tissues for movement"]}, {"entity_id": "muscles", "book_id": "principles_of_psychology_james_1890", "name": "muscles", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 28, "variants": ["muscles"], "contexts": ["body tissues for movement", "body parts for movement"]}, {"entity_id": "muscles", "book_id": "first_principles_spencer_1862", "name": "muscles", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 8, "variants": ["muscles"], "contexts": ["tissues that enable movement", "tissues responsible for movement"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "muscles", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "muscles", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "muscles", "target_book": "origin_of_species_darwin_1859", "target_name": "muscles", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "muscles", "target_book": "principles_of_psychology_james_1890", "target_name": "muscles", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "muscles", "target_book": "first_principles_spencer_1862", "target_name": "muscles", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "muscles", "target_book": "origin_of_species_darwin_1859", "target_name": "muscles", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "muscles", "target_book": "principles_of_psychology_james_1890", "target_name": "muscles", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "muscles", "target_book": "first_principles_spencer_1862", "target_name": "muscles", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "muscles", "target_book": "principles_of_psychology_james_1890", "target_name": "muscles", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "muscles", "target_book": "first_principles_spencer_1862", "target_name": "muscles", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "muscles", "target_book": "first_principles_spencer_1862", "target_name": "muscles", "similarity": 1.0}], "id": 110, "stable_key": "clu_df97001aeee63633-2", "ground_truth": {"modern_name": "Muscles", "confidence": "high", "type": "concept", "wikidata_id": "Q7365", "wikidata_description": "contractile soft tissue of animals", "wikipedia_url": "https://en.wikipedia.org/wiki/Muscle", "note": "The early modern term 'mufculos' (or 'mufculofus') is a Latinate form referring to muscles, especially in anatomical contexts. The OCR variant 'mucous' is likely a misreading or a contextually distinct usage if it refers to a bodily fluid, but the overwhelming number of occurrences point to anatomical muscles.", "wikipedia_extract": "Muscle is a specialised soft tissue, one of the four basic types of animal tissues. There are three types of muscle tissues in vertebrates:- skeletal muscle tissue, cardiac muscle tissue, and smooth muscle tissue. Muscle tissue gives skeletal muscles the ability to contract and relax. Muscle tissue contains special contractile proteins called actin and myosin which interact to cause movement. Among many other muscle proteins present are two regulatory proteins, troponin and tropomyosin. Muscle is formed during embryonic development, in a process known as myogenesis."}}, {"canonical_name": "Java", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 5, "total_mentions": 43, "members": [{"entity_id": "java", "book_id": "origin_of_species_darwin_1859", "name": "Java", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Java"], "contexts": ["island in Indonesia", "location of plants"]}, {"entity_id": "java", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Java", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 10, "variants": ["Java"], "contexts": ["island in Indonesia", "island with population data"]}, {"entity_id": "java", "book_id": "kosmos_humboldt_1845", "name": "Java", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Java"], "contexts": ["island in Indonesia", "location of experiments"]}, {"entity_id": "java", "book_id": "coloquios_da_orta_1563", "name": "Java", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 22, "variants": ["Java"], "contexts": ["island mentioned in Varthema's account", "island name"]}, {"entity_id": "java", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Java", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Java"], "contexts": ["island affected by eruption", "geographic location of the ship"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Java", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Java", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Java", "target_book": "kosmos_humboldt_1845", "target_name": "Java", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Java", "target_book": "coloquios_da_orta_1563", "target_name": "Java", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Java", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Java", "similarity": 0.691}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Java", "target_book": "kosmos_humboldt_1845", "target_name": "Java", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Java", "target_book": "coloquios_da_orta_1563", "target_name": "Java", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Java", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Java", "similarity": 0.691}, {"source_book": "kosmos_humboldt_1845", "source_name": "Java", "target_book": "coloquios_da_orta_1563", "target_name": "Java", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Java", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Java", "similarity": 0.691}, {"source_book": "coloquios_da_orta_1563", "source_name": "Java", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Java", "similarity": 0.691}], "id": 111, "stable_key": "clu_2ee9f5d47aa64034", "ground_truth": {"modern_name": "Java", "confidence": "high", "type": "place", "description": "A major island in Indonesia, historically significant for trade and exploration.", "note": "Distinguished from the Javary river in Brazil.", "wikipedia_extract": "Java is one of the Greater Sunda Islands in the South East Asian country of Indonesia. It is bordered by the Indian Ocean to the south and the Java Sea (a part of Pacific Ocean) to the north. With a population of 156.9 million people (including Madura) in mid 2024, projected to have risen to 158 million by mid-2025, Java is the world's most populous island, home to approximately 56% of the Indonesian population while constituting only 7% of its land area. Indonesia's capital city, Jakarta, is on Java's northwestern coast. Many of the best known events in Indonesian history took place on Java. It was the centre of powerful Hindu-Buddhist empires, the Islamic sultanates, and the core of the colonial Dutch East Indies."}}, {"canonical_name": "\u00edndias", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 5, "total_mentions": 43, "members": [{"entity_id": "indiens", "book_id": "epoques_nature_buffon_1778", "name": "Indiens", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Indiens"], "contexts": ["people near the first learned people", "people who adopted metempsychosis"]}, {"entity_id": "\u00edndias", "book_id": "coloquios_da_orta_1563", "name": "\u00edndias", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 35, "variants": ["\u00edndias", "Western \u00cdndias", "\u00cdndias", "\u00cdndias Occidentaes", "\u00cdndias occidentaes", "\u00edndia major", "\u00edndia nugor", "\u00edndias Ocidentales", "\u00edndias chamadas occidentaes", "\u00edndias mais orientaes", "\u00edndias occidentaes", "\u00edndias ocddentaes", "\u00edndias ocidentaes", "\u00edndias orientaes"], "contexts": ["people who called the goma lac", "places referred to as yours"]}, {"entity_id": "indian", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Indian", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Indian"], "contexts": ["referring to Indian lunar tables"]}, {"entity_id": "indias", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Indias", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Indias", "INDIAS"], "contexts": ["region where Spaniards encountered the tree", "geographical region, likely the Americas"]}, {"entity_id": "indes_occidentales", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Indes occidentales", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Indes occidentales"], "contexts": ["West Indies"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Indiens", "target_book": "coloquios_da_orta_1563", "target_name": "\u00edndias", "similarity": 0.935}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Indiens", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Indian", "similarity": 0.953}, {"source_book": "coloquios_da_orta_1563", "source_name": "\u00edndias", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Indian", "similarity": 0.939}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Indias", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Indes occidentales", "similarity": 0.913}], "id": 112, "stable_key": "clu_9262792cdc091e14", "ground_truth": {"modern_name": "Indies", "confidence": "high", "type": "place", "country": "Multiple", "note": "Refers to the East Indies and/or the West Indies, depending on context.", "wikidata_id": "Q213137", "wikidata_description": "region encompassing South (Em(Indian subcontinent) and Southeast Asia", "wikipedia_url": "https://en.wikipedia.org/wiki/East%20Indies", "wikipedia_extract": "The East Indies (or simply the Indies) is a term used in historical narratives of the Age of Discovery. The Indies broadly referred to various lands in the East or the Eastern Hemisphere, particularly the islands and mainlands found in and around the Indian Ocean by Portuguese explorers, soon after the Cape Route was discovered. In a narrow sense, the term was used to refer to the Malay Archipelago, which today comprises the Philippine Archipelago, Indonesian Archipelago, Borneo, and New Guinea. Historically, the term was used in the Age of Discovery to refer to the coasts of the landmasses comprising the Indian subcontinent and the Indochinese Peninsula along with the Malay Archipelago. During the era of European colonization, territories of the Spanish Empire in Asia were known as the Spanish East Indies for 333 years before the American conquest and later the independence of the Philippines. Dutch occupied colonies in the area were known for about 300 years as the Dutch East Indies until Indonesian independence."}}, {"canonical_name": "Pyr\u00e9n\u00e9es", "category": "PLACE", "subcategory": "REGION", "book_count": 5, "total_mentions": 43, "members": [{"entity_id": "pyrenees", "book_id": "origin_of_species_darwin_1859", "name": "Pyrenees", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Pyrenees"], "contexts": ["mountain range in Europe", "southern limit of arctic fauna and flora"]}, {"entity_id": "pyr\u00e9n\u00e9es", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pyr\u00e9n\u00e9es", "category": "PLACE", "subcategory": "REGION", "count": 24, "variants": ["Pyr\u00e9n\u00e9es", "Pyren\u0153en", "Pyr\u00e9"], "contexts": ["mountain range", "mountain range name"]}, {"entity_id": "pyrenes", "book_id": "kosmos_humboldt_1845", "name": "Pyrenes", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Pyrenes"], "contexts": ["mountain range with geological formations"]}, {"entity_id": "pyrenees", "book_id": "kosmos_humboldt_1845", "name": "Pyrenees", "category": "PLACE", "subcategory": "REGION", "count": 8, "variants": ["Pyrenees"], "contexts": ["mountain range", "mountain range with limestone transformation"]}, {"entity_id": "pirineos", "book_id": "historia_medicinal_monardes_1574", "name": "Pirineos", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Pirineos"], "contexts": ["mountains that fill with snow in winter"]}, {"entity_id": "pyr\u00e9n\u00e9es", "book_id": "epoques_nature_buffon_1778", "name": "Pyr\u00e9n\u00e9es", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Pyr\u00e9n\u00e9es"], "contexts": ["mountain range between Spain and France", "mountain range"]}, {"entity_id": "pyrineos", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pyrineos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Pyrineos"], "contexts": ["mountain range"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Pyrenees", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Pyr\u00e9n\u00e9es", "similarity": 0.967}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Pyrenees", "target_book": "kosmos_humboldt_1845", "target_name": "Pyrenes", "similarity": 0.981}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pyr\u00e9n\u00e9es", "target_book": "kosmos_humboldt_1845", "target_name": "Pyrenes", "similarity": 0.942}, {"source_book": "kosmos_humboldt_1845", "source_name": "Pyrenees", "target_book": "historia_medicinal_monardes_1574", "target_name": "Pirineos", "similarity": 0.891}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Pyr\u00e9n\u00e9es", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Pyrineos", "similarity": 0.946}], "id": 113, "stable_key": "clu_dc5259ff7bbab9a7", "ground_truth": {"modern_name": "Pyrenees", "confidence": "high", "type": "place", "country": "France, Spain, Andorra", "wikidata_id": "Q12709", "wikidata_description": "French department in the region of Occitania", "wikipedia_url": "https://en.wikipedia.org/wiki/Pyr%C3%A9n%C3%A9es-Orientales", "wikipedia_extract": "Pyr\u00e9n\u00e9es-Orientales (French: [pi\u0281ene \u0254\u0281j\u0251\u0303tal] ; Catalan: Pirineus Orientals [pi\u027ei\u02c8n\u025bwz u\u027ei\u0259n\u02c8tals]; Occitan: Piren\u00e8us Orientals [pi\u027ee\u02c8n\u025bwz u\u027ejen\u02c8tals]; lit. 'Eastern Pyrenees'), also known as Northern Catalonia, is a department of the region of Occitania, Southern France, adjacent to the northern Spanish frontier and the Mediterranean Sea. It borders the departments of Ari\u00e8ge to the northwest and Aude to the north, the Mediterranean Sea to the east and the Spanish province of Girona in Catalonia to the south and the country of Andorra to the west. It also surrounds the tiny Spanish exclave of Ll\u00edvia, and thus has two distinct borders with Spain. In 2019, it had a population of 479,979. Some parts of the Pyr\u00e9n\u00e9es-Orientales (like the Cerdagne) are part of the Iberian Peninsula."}}, {"canonical_name": "Berlin", "category": "PLACE", "subcategory": "CITY", "book_count": 5, "total_mentions": 42, "members": [{"entity_id": "berlin", "book_id": "medecine_experimentale_bernard_1865", "name": "Berlin", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Berlin"], "contexts": ["city with a professor of microscopic pathology", "location of handbook publication"]}, {"entity_id": "berlin", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Berlin", "category": "PLACE", "subcategory": "CITY", "count": 14, "variants": ["Berlin"], "contexts": ["capital of Germany", "city for barometric leveling"]}, {"entity_id": "berlin", "book_id": "principles_of_psychology_james_1890", "name": "Berlin", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Berlin"], "contexts": ["location of publication"]}, {"entity_id": "berlin", "book_id": "kosmos_humboldt_1845", "name": "Berlin", "category": "PLACE", "subcategory": "CITY", "count": 18, "variants": ["Berlin"], "contexts": ["city where lectures were delivered", "location of lectures and assembly"]}, {"entity_id": "berlin", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Berlin", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Berlin"], "contexts": ["location for parallax observation", "city where Neptune was found"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Berlin", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Berlin", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Berlin", "target_book": "principles_of_psychology_james_1890", "target_name": "Berlin", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Berlin", "target_book": "kosmos_humboldt_1845", "target_name": "Berlin", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Berlin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Berlin", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Berlin", "target_book": "principles_of_psychology_james_1890", "target_name": "Berlin", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Berlin", "target_book": "kosmos_humboldt_1845", "target_name": "Berlin", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Berlin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Berlin", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Berlin", "target_book": "kosmos_humboldt_1845", "target_name": "Berlin", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Berlin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Berlin", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Berlin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Berlin", "similarity": 1.0}], "id": 114, "stable_key": "clu_0850f731ddc2008b", "ground_truth": {"modern_name": "Berlin", "confidence": "high", "type": "place", "description": "Capital city of Germany, a location of scientific and cultural significance.", "wikipedia_extract": "Berlin is the capital of Germany, as well as its largest city by both area and population. With 3.7 million inhabitants, it has the highest population within its city limits of any city in the European Union. The city is also one of the states of Germany, being the third-smallest state in the country by area. Berlin is surrounded by the state of Brandenburg, and Brandenburg's capital Potsdam is nearby. The urban area of Berlin has a population of over 4.6 million, making it the most populous in Germany. The Berlin-Brandenburg capital region has around 6.2 million inhabitants and is Germany's second-largest metropolitan region after the Rhine-Ruhr region, as well as the fifth-biggest metropolitan region by GDP in the European Union."}}, {"canonical_name": "Cairo", "category": "PLACE", "subcategory": "CITY", "book_count": 5, "total_mentions": 42, "members": [{"entity_id": "cairo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "cairo", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["cairo"], "contexts": ["Cairo"]}, {"entity_id": "caire", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Caire", "category": "PLACE", "subcategory": "CITY", "count": 11, "variants": ["Caire", "Cairi", "Kaire"], "contexts": ["location of subsidiary canals", "city with low barometric variations"]}, {"entity_id": "cairo", "book_id": "kosmos_humboldt_1845", "name": "Cairo", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Cairo"], "contexts": ["capital city of Egypt"]}, {"entity_id": "cairo", "book_id": "coloquios_da_orta_1563", "name": "Cairo", "category": "PLACE", "subcategory": "CITY", "count": 28, "variants": ["Cairo", "cairo"], "contexts": ["city where substance is transported overland", "city on the Nile"]}, {"entity_id": "cairo", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cairo", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Cairo"], "contexts": ["location of Ibn Junis' observations"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cairo", "target_book": "kosmos_humboldt_1845", "target_name": "Cairo", "similarity": 0.815}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cairo", "target_book": "coloquios_da_orta_1563", "target_name": "Cairo", "similarity": 0.815}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cairo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cairo", "similarity": 0.815}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Caire", "target_book": "kosmos_humboldt_1845", "target_name": "Cairo", "similarity": 0.989}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Caire", "target_book": "coloquios_da_orta_1563", "target_name": "Cairo", "similarity": 0.989}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Caire", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cairo", "similarity": 0.989}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cairo", "target_book": "coloquios_da_orta_1563", "target_name": "Cairo", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cairo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cairo", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Cairo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cairo", "similarity": 1.0}], "id": 115, "stable_key": "clu_a7e67c564f671201", "ground_truth": {"modern_name": "Cairo", "confidence": "high", "type": "place", "description": "Capital city of Egypt, located on the Nile River.", "wikipedia_extract": "Cairo is the capital and largest city of Egypt and the Cairo Governorate. It is home to more than 10.5 million people. It is also part of the largest urban agglomeration in Africa, the Arab world, and the Middle East. The Greater Cairo metropolitan area is one of the largest in the world by population with over 22 million people. Areas of what would become Cairo were inhabited from pre-dynastic and early-dynastic ancient Egypt c. 6000 years ago, as the Giza pyramid complex and the ancient cities of Memphis and Heliopolis are today within the city. Located near the Nile Delta, the predecessor city was Fustat following Babylon."}}, {"canonical_name": "pendulum", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 5, "total_mentions": 41, "members": [{"entity_id": "pendule", "book_id": "epoques_nature_buffon_1778", "name": "pendule", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["pendule"], "contexts": ["instrument used for experiments"]}, {"entity_id": "pendule", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pendule", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["pendule"], "contexts": ["used for observations", "instrument for measuring oscillations"]}, {"entity_id": "pendulum", "book_id": "principles_of_psychology_james_1890", "name": "pendulum", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["pendulum"], "contexts": ["device for time measurement", "object that swings back and forth"]}, {"entity_id": "pendulum", "book_id": "kosmos_humboldt_1845", "name": "Pendulum", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 11, "variants": ["Pendulum", "pendulum"], "contexts": ["instrument for measuring density and geological constitution", "instrument for measuring time/gravity"]}, {"entity_id": "pendulum", "book_id": "connexion_physical_sciences_somerville_1858", "name": "pendulum", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 24, "variants": ["Pendulum", "pendulum"], "contexts": ["device for measuring time/gravity", "used to determine Earth's figure"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "pendule", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "pendule", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "pendule", "target_book": "principles_of_psychology_james_1890", "target_name": "pendulum", "similarity": 0.943}, {"source_book": "epoques_nature_buffon_1778", "source_name": "pendule", "target_book": "kosmos_humboldt_1845", "target_name": "Pendulum", "similarity": 0.883}, {"source_book": "epoques_nature_buffon_1778", "source_name": "pendule", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "pendulum", "similarity": 0.943}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pendule", "target_book": "principles_of_psychology_james_1890", "target_name": "pendulum", "similarity": 0.943}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pendule", "target_book": "kosmos_humboldt_1845", "target_name": "Pendulum", "similarity": 0.883}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pendule", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "pendulum", "similarity": 0.943}, {"source_book": "principles_of_psychology_james_1890", "source_name": "pendulum", "target_book": "kosmos_humboldt_1845", "target_name": "Pendulum", "similarity": 0.953}, {"source_book": "principles_of_psychology_james_1890", "source_name": "pendulum", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "pendulum", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Pendulum", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "pendulum", "similarity": 0.953}], "id": 116, "stable_key": "clu_798888e8c08c1a79", "ground_truth": {"modern_name": "Pendulum", "confidence": "high", "type": "OBJECT", "description": "A weight suspended from a fixed point, swinging freely.", "wikipedia_extract": "A pendulum is a device made of a weight suspended from a pivot so that it can swing freely. When a pendulum is displaced sideways from its resting, equilibrium position, it is subject to a restoring force due to gravity that will accelerate it back toward the equilibrium position. When released, the restoring force acting on the pendulum's mass causes it to oscillate about the equilibrium position, swinging back and forth. The time for one complete cycle, a left swing and a right swing, is called the period. The period depends on the length of the pendulum and also to a slight degree on the amplitude, the width of the pendulum's swing. The SI unit of the period of a pendulum is the second (s).", "note": "The term 'pendulum-strokes' likely refers to the oscillations or beats of a pendulum, particularly in the context of measuring time or the physical principles governing its movement.", "wikidata_id": "Q829360", "wikidata_description": "idealized concept of a pendulum"}}, {"canonical_name": "fumo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 5, "total_mentions": 40, "members": [{"entity_id": "fum\u00e9e", "book_id": "epoques_nature_buffon_1778", "name": "fum\u00e9e", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["fum\u00e9e"], "contexts": ["product of combustion"]}, {"entity_id": "fumo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "fumo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["fumo"], "contexts": ["vapor of axuchiatl"]}, {"entity_id": "smoke", "book_id": "kosmos_humboldt_1845", "name": "smoke", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["smoke"], "contexts": ["particulate matter from combustion", "gaseous emission"]}, {"entity_id": "humo", "book_id": "historia_medicinal_monardes_1574", "name": "humo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["humo", "humos"], "contexts": ["smoke from tobacco", "smoke from a tree"]}, {"entity_id": "fumo", "book_id": "polyanthea_medicinal", "name": "fumo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 32, "variants": ["fumo", "Fumo", "fumo da chamin\u00e8", "fumos", "fumus"], "contexts": ["fumigation", "smoke, used in drying milk"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "fum\u00e9e", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "fumo", "similarity": 0.975}, {"source_book": "epoques_nature_buffon_1778", "source_name": "fum\u00e9e", "target_book": "kosmos_humboldt_1845", "target_name": "smoke", "similarity": 0.931}, {"source_book": "epoques_nature_buffon_1778", "source_name": "fum\u00e9e", "target_book": "historia_medicinal_monardes_1574", "target_name": "humo", "similarity": 0.954}, {"source_book": "epoques_nature_buffon_1778", "source_name": "fum\u00e9e", "target_book": "polyanthea_medicinal", "target_name": "fumo", "similarity": 0.975}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "fumo", "target_book": "kosmos_humboldt_1845", "target_name": "smoke", "similarity": 0.953}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "fumo", "target_book": "historia_medicinal_monardes_1574", "target_name": "humo", "similarity": 0.959}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "fumo", "target_book": "polyanthea_medicinal", "target_name": "fumo", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "smoke", "target_book": "historia_medicinal_monardes_1574", "target_name": "humo", "similarity": 0.917}, {"source_book": "kosmos_humboldt_1845", "source_name": "smoke", "target_book": "polyanthea_medicinal", "target_name": "fumo", "similarity": 0.953}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "humo", "target_book": "polyanthea_medicinal", "target_name": "fumo", "similarity": 0.959}], "id": 117, "stable_key": "clu_b8cd9a6075a5a5ba", "ground_truth": {"modern_name": "smoke", "confidence": "high", "type": "concept", "wikidata_id": "Q662860", "wikidata_description": "breathing in smoke after burning a substance and inhaling, done in order to be tasted and absorbed into the bloodstream", "wikipedia_url": "https://en.wikipedia.org/wiki/Smoking", "wikipedia_extract": "Smoking is a human behavior which involves the combustion of a substance, usually plant material, and the inhalation of resulting fumes. Today, smoking is mostly practiced by rolling the dried leaves of the tobacco plant into a cigarette. Other forms of tobacco smoking include the use of a smoking tobacco with a pipe or cigar, or using a bong. Cigarette smokers almost always inhale the smoke; most pipe and cigar smokers do not inhale. Smoking is primarily practiced as a route of administration for psychoactive chemicals because the active substances within the burnt, dried plant leaves (or other chemical) can vaporize into a gaseous state and be delivered into the respiratory tract, where they are rapidly absorbed into the bloodstream through the lungs and can reach the central nervous system. In the case of tobacco smoking, these active substances are a mixture of aerosol particles that include the pharmacologically active alkaloid nicotine, which stimulates the nicotinic acetylcholine receptors in the brain, and other non-psychoactive chemicals that result from combustion."}}, {"canonical_name": "Wind", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 40, "members": [{"entity_id": "wind", "book_id": "english_physician_1652", "name": "Wind", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 29, "variants": ["wind", "Wind"], "contexts": ["expelled by herb", "quality causing pains and torments"]}, {"entity_id": "wind", "book_id": "origin_of_species_darwin_1859", "name": "wind", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["wind"], "contexts": ["movement of air", "natural force for pollen dispersal"]}, {"entity_id": "wind", "book_id": "kosmos_humboldt_1845", "name": "wind", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["wind"], "contexts": ["force causing earth shocks", "movement of air"]}, {"entity_id": "wind", "book_id": "polyanthea_medicinal", "name": "wind", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["wind"], "contexts": ["environmental factor"]}, {"entity_id": "wind", "book_id": "first_principles_spencer_1862", "name": "wind", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["wind"], "contexts": ["movement of air", "uniform force causing segregation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Wind", "target_book": "origin_of_species_darwin_1859", "target_name": "wind", "similarity": 0.984}, {"source_book": "english_physician_1652", "source_name": "Wind", "target_book": "kosmos_humboldt_1845", "target_name": "wind", "similarity": 0.984}, {"source_book": "english_physician_1652", "source_name": "Wind", "target_book": "polyanthea_medicinal", "target_name": "wind", "similarity": 0.984}, {"source_book": "english_physician_1652", "source_name": "Wind", "target_book": "first_principles_spencer_1862", "target_name": "wind", "similarity": 0.984}, {"source_book": "origin_of_species_darwin_1859", "source_name": "wind", "target_book": "kosmos_humboldt_1845", "target_name": "wind", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "wind", "target_book": "polyanthea_medicinal", "target_name": "wind", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "wind", "target_book": "first_principles_spencer_1862", "target_name": "wind", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "wind", "target_book": "polyanthea_medicinal", "target_name": "wind", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "wind", "target_book": "first_principles_spencer_1862", "target_name": "wind", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "wind", "target_book": "first_principles_spencer_1862", "target_name": "wind", "similarity": 1.0}], "id": 118, "stable_key": "clu_19d58f0aae4b17ba", "ground_truth": {"modern_name": "Wind", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Wind", "note": "The terms 'southerly winds' and 'spring east winds' describe specific types of winds. The most general modern referent is 'winds'.", "wikipedia_extract": "Wind is the natural movement of air or other gases relative to a planet's surface. Winds occur on a range of scales, from thunderstorm flows lasting tens of minutes, to local breezes generated by heating of land surfaces and lasting a few hours, to global winds resulting from the difference in absorption of solar energy between the climate zones on Earth. The study of wind is called anemology. The two main causes of large-scale atmospheric circulation are the differential heating between the equator and the poles, and the rotation of the planet, which is called the Coriolis effect. Within the tropics and subtropics, thermal low circulations over terrain and high plateaus can drive monsoon circulations. In coastal areas the sea breeze/land breeze cycle can define local winds; in areas that have variable terrain, mountain and valley breezes can prevail."}}, {"canonical_name": "eye", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 39, "members": [{"entity_id": "eye", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "eye", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["eye"], "contexts": ["organ receiving poison", "organ of sight"]}, {"entity_id": "eye", "book_id": "origin_of_species_darwin_1859", "name": "Eye", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 11, "variants": ["eye", "Eye"], "contexts": ["organ of sight", "organ for sight with complex contrivances"]}, {"entity_id": "eye", "book_id": "principles_of_psychology_james_1890", "name": "eye", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 22, "variants": ["eye"], "contexts": ["organ of sight", "body part where cinder enters"]}, {"entity_id": "eye", "book_id": "kosmos_humboldt_1845", "name": "eye", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["eye"], "contexts": ["organ of sight"]}, {"entity_id": "eye", "book_id": "connexion_physical_sciences_somerville_1858", "name": "eye", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["eye"], "contexts": ["organ of sight"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "eye", "target_book": "origin_of_species_darwin_1859", "target_name": "Eye", "similarity": 0.994}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "eye", "target_book": "principles_of_psychology_james_1890", "target_name": "eye", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "eye", "target_book": "kosmos_humboldt_1845", "target_name": "eye", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "eye", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "eye", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Eye", "target_book": "principles_of_psychology_james_1890", "target_name": "eye", "similarity": 0.994}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Eye", "target_book": "kosmos_humboldt_1845", "target_name": "eye", "similarity": 0.994}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Eye", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "eye", "similarity": 0.994}, {"source_book": "principles_of_psychology_james_1890", "source_name": "eye", "target_book": "kosmos_humboldt_1845", "target_name": "eye", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "eye", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "eye", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "eye", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "eye", "similarity": 1.0}], "id": 119, "stable_key": "clu_f407d4f32f9232a2", "ground_truth": {"modern_name": "Eye", "confidence": "high", "type": "object", "wikidata_id": "Q7364", "wikidata_description": "organ that detects light and converts it into electro-chemical impulses in neurons", "wikipedia_url": "https://en.wikipedia.org/wiki/Eye", "note": "While 'eyes' can refer to a part of an animal, the contexts and the general usage in natural philosophy lean towards the organ of sight as an object of study rather than the animal itself.", "wikipedia_extract": "An eye is a sensory organ that allows an organism to perceive visual information. It detects light and converts it into electro-chemical impulses in neurons (neurones). It is part of an organism's visual system. In higher organisms, the eye is a complex optical system that collects light from the surrounding environment, regulates its intensity through a diaphragm, focuses it through an adjustable assembly of lenses to form an image, converts this image into a set of electrical signals, and transmits these signals to the brain through neural pathways that connect the eye via the optic nerve to the visual cortex and other areas of the brain. Eyes with resolving power have come in ten fundamentally different forms, classified into compound eyes and non-compound eyes. Compound eyes are made up of multiple small visual units, and are common on insects and crustaceans."}}, {"canonical_name": "Mediterranean", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 5, "total_mentions": 39, "members": [{"entity_id": "mediterranean", "book_id": "origin_of_species_darwin_1859", "name": "Mediterranean", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Mediterranean"], "contexts": ["sea and surrounding region", "sea with a unique species"]}, {"entity_id": "mediterranean", "book_id": "kosmos_humboldt_1845", "name": "Mediterranean", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 18, "variants": ["Mediterranean"], "contexts": ["sea between Europe and Africa", "sea mentioned in passage"]}, {"entity_id": "mediterranean_sea", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mediterranean Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Mediterranean Sea"], "contexts": ["sea area compared to Sahara"]}, {"entity_id": "m\u00e9diterran\u00e9e_orientale", "book_id": "epoques_nature_buffon_1778", "name": "M\u00e9diterran\u00e9e orientale", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["M\u00e9diterran\u00e9e orientale"], "contexts": ["eastern part of the Mediterranean Sea"]}, {"entity_id": "mediterr\u00e2neo", "book_id": "coloquios_da_orta_1563", "name": "Mediterr\u00e2neo", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Mediterr\u00e2neo", "M\u00e9diter\u00e2neo", "mediterr\u00e2nicos"], "contexts": ["sea with commercial cities trading spices", "sea navigated by merchants"]}, {"entity_id": "mediterranean", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mediterranean", "category": "PLACE", "subcategory": "REGION", "count": 8, "variants": ["Mediterranean"], "contexts": ["sea with imperceptible tides", "sea where gale occurred"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Mediterranean", "target_book": "kosmos_humboldt_1845", "target_name": "Mediterranean", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Mediterranean", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mediterranean Sea", "similarity": 0.974}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mediterranean", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mediterranean Sea", "similarity": 0.974}, {"source_book": "epoques_nature_buffon_1778", "source_name": "M\u00e9diterran\u00e9e orientale", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mediterranean", "similarity": 0.883}, {"source_book": "coloquios_da_orta_1563", "source_name": "Mediterr\u00e2neo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mediterranean", "similarity": 0.9}], "id": 120, "stable_key": "clu_65745ddfaecb6834", "ground_truth": {"modern_name": "Mediterranean Sea", "confidence": "high", "type": "place", "country": "Multiple", "wikidata_id": "Q72499", "wikidata_description": "loosely defined region of lands around the Mediterranean Sea", "wikipedia_url": "https://en.wikipedia.org/wiki/Mediterranean%20basin", "wikipedia_extract": "In biogeography, the Mediterranean basin ( MED-ih-t\u0259-RAY-nee-\u0259n), also known as the Mediterranean region or sometimes Mediterranea, is the region of lands around the Mediterranean Sea that mostly have a Mediterranean climate, with mild to cool, rainy winters and warm to hot, dry summers, which supports characteristic Mediterranean forests, woodlands, and scrub vegetation. The Mediterranean basin covers portions of three continents: Africa, Asia, and Europe. It is not the same as the drainage basin of the Mediterranean Sea; the drainage basin is larger, as rivers including the Nile and Rh\u00f4ne reach further into Africa and Europe. Conversely, the Mediterranean basin includes regions not in the drainage basin, such as Iraq, Jordan, and Portugal. It has a varied and contrasting topography. The Mediterranean region offers a varied landscape of high mountains, rocky shores, impenetrable scrub, semi-arid steppes, coastal wetlands, sandy beaches and a myriad of islands of various shapes and sizes dotted amidst the clear blue sea."}}, {"canonical_name": "ether", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 5, "total_mentions": 38, "members": [{"entity_id": "\u00e9ther", "book_id": "medecine_experimentale_bernard_1865", "name": "\u00e9ther", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["\u00e9ther"], "contexts": ["chemical injected into intestines", "activates absorption"]}, {"entity_id": "ether", "book_id": "principles_of_psychology_james_1890", "name": "ether", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Ether", "ether"], "contexts": ["lengthens reaction time", "anaesthetic substance"]}, {"entity_id": "ether", "book_id": "kosmos_humboldt_1845", "name": "ether", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["ether"], "contexts": ["translucent illuminated substance beyond openings"]}, {"entity_id": "ether", "book_id": "connexion_physical_sciences_somerville_1858", "name": "ether", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 25, "variants": ["ether", "Ether"], "contexts": ["medium for light vibrations", "hypothetical medium for light"]}, {"entity_id": "ether", "book_id": "first_principles_spencer_1862", "name": "ether", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 8, "variants": ["ether"], "contexts": ["hypothesized medium for heat, light, gravitation", "hypothetical medium for force transmission"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "\u00e9ther", "target_book": "principles_of_psychology_james_1890", "target_name": "ether", "similarity": 0.991}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "\u00e9ther", "target_book": "kosmos_humboldt_1845", "target_name": "ether", "similarity": 0.991}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "\u00e9ther", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ether", "similarity": 0.991}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "\u00e9ther", "target_book": "first_principles_spencer_1862", "target_name": "ether", "similarity": 0.991}, {"source_book": "principles_of_psychology_james_1890", "source_name": "ether", "target_book": "kosmos_humboldt_1845", "target_name": "ether", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "ether", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ether", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "ether", "target_book": "first_principles_spencer_1862", "target_name": "ether", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "ether", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ether", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "ether", "target_book": "first_principles_spencer_1862", "target_name": "ether", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name"