odern_name": "Francisco Jos\u00e9 de Caldas", "confidence": "high", "type": "person", "birth_year": 1768, "death_year": 1816, "description": "Colombian scientist, botanist, geographer, and journalist", "wikidata_id": "Q1442069", "wikidata_description": "Neogranadine lawyer and scientist (1768-1816)"}}, {"canonical_name": "Calcutta", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "calcutta", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Calcutta", "category": "PLACE", "subcategory": "CITY", "count": 13, "variants": ["Calcutta"], "contexts": ["city in India", "destination from London"]}, {"entity_id": "calcutta", "book_id": "kosmos_humboldt_1845", "name": "Calcutta", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Calcutta"], "contexts": ["city in India"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Calcutta", "target_book": "kosmos_humboldt_1845", "target_name": "Calcutta", "similarity": 1.0}], "id": 2589, "stable_key": "clu_a6ff644461391077", "ground_truth": {"modern_name": "Kolkata", "confidence": "high", "type": "place", "country": "India"}}, {"canonical_name": "phonolithe", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "phonolithe", "book_id": "relation_historique_humboldt_vol3_1825", "name": "phonolithe", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 12, "variants": ["phonolithe", "PHONOLITHE", "Phonolite", "phonolite", "phonolithes"], "contexts": ["rock formation between Otuz and Cerro de Flores", "rock formation in Venezuela"]}, {"entity_id": "phonolithe", "book_id": "kosmos_humboldt_1845", "name": "phonolithe", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["phonolithe"], "contexts": ["endogenous rock type", "porphyritic slate rock"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "phonolithe", "target_book": "kosmos_humboldt_1845", "target_name": "phonolithe", "similarity": 1.0}], "id": 2590, "stable_key": "clu_f406cd10c37c7219", "ground_truth": {"modern_name": "Phonolite", "confidence": "high", "type": "mineral", "wikidata_id": "Q1257550", "wikidata_description": "intermediate igneous rock; chenotype (younger) outpouring equivalent of alkaline syenite", "wikipedia_extract": "Phonolite is an uncommon shallow intrusive or extrusive rock, of intermediate chemical composition between felsic and mafic, with texture ranging from aphanitic (fine-grained) to porphyritic (mixed fine- and coarse-grained). Phonolite is a variation of the igneous rock trachyte that contains nepheline or leucite rather than quartz. It has an unusually high (12% or more) Na2O + K2O content, defining its position in the TAS classification of igneous rocks. Its coarse grained (phaneritic) intrusive equivalent is nepheline syenite. Phonolite is typically fine grained and compact. The name phonolite comes from the Ancient Greek meaning \"sounding stone\" due to the metallic sound it produces if an unfractured plate is hit; hence, the English name clinkstone is given as a synonym.", "wikipedia_url": "https://en.wikipedia.org/wiki/Phonolite"}}, {"canonical_name": "Freycinet", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "freycinet", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Freycinet", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 11, "variants": ["Freycinet", "Freycioet"], "contexts": ["early modern scholar", "author of scientific observations"]}, {"entity_id": "freycinet", "book_id": "kosmos_humboldt_1845", "name": "Freycinet", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Freycinet"], "contexts": ["provided pendulum experiment results", "researcher on pendulum oscillations"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Freycinet", "target_book": "kosmos_humboldt_1845", "target_name": "Freycinet", "similarity": 0.722}], "id": 2591, "stable_key": "clu_cf4ad0059e066ce9", "ground_truth": {"modern_name": "Louis de Freycinet", "confidence": "high", "type": "person", "birth_year": 1779, "death_year": 1842, "description": "French explorer and scientist, known for voyages and scientific contributions."}}, {"canonical_name": "population", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "population", "book_id": "relation_historique_humboldt_vol3_1825", "name": "population", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["population", "Total de la population fixe", "population fixe", "population totale"], "contexts": ["number of inhabitants", "population"]}, {"entity_id": "population", "book_id": "first_principles_spencer_1862", "name": "population", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["population"], "contexts": ["number of inhabitants in an area", "all the inhabitants of a particular place"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "population", "target_book": "first_principles_spencer_1862", "target_name": "population", "similarity": 1.0}], "id": 2592, "stable_key": "clu_e2b11199cb50647d", "ground_truth": {"modern_name": "Population", "confidence": "high", "type": "concept", "wikidata_id": "Q2625603", "wikidata_description": "ensemble of individuals of a species in an area, or their number"}}, {"canonical_name": "Mansel", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "hassel", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Hassel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Hassel", "M. Hassel"], "contexts": ["Author of statistical tables on Russia", "author