eptibility", "similarity": 0.954}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "sensibilit\u00e9", "target_book": "first_principles_spencer_1862", "target_name": "sensibility", "similarity": 0.995}, {"source_book": "principles_of_psychology_james_1890", "source_name": "perceptibility", "target_book": "first_principles_spencer_1862", "target_name": "sensibility", "similarity": 0.955}], "id": 1472, "stable_key": "clu_97cf455fec4e6ae9", "ground_truth": {"modern_name": "perceptibility", "confidence": "high", "type": "concept", "note": "This refers to the capacity to be perceived or sensed, a concept related to sensory input and awareness."}}, {"canonical_name": "pathologique", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "pathologique", "book_id": "medecine_experimentale_bernard_1865", "name": "pathologique", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["pathologique"], "contexts": ["relating to disease", "relating to disease or abnormal conditions"]}, {"entity_id": "human_pathology", "book_id": "principles_of_psychology_james_1890", "name": "human pathology", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["human pathology"], "contexts": ["study of human diseases"]}, {"entity_id": "pathologicis", "book_id": "polyanthea_medicinal", "name": "Pathologicis", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Pathologicis"], "contexts": ["related to pathology"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "pathologique", "target_book": "principles_of_psychology_james_1890", "target_name": "human pathology", "similarity": 0.912}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "pathologique", "target_book": "polyanthea_medicinal", "target_name": "Pathologicis", "similarity": 0.945}], "id": 1473, "stable_key": "clu_e108ca61d2ec3a56", "ground_truth": {"modern_name": "Pathology", "confidence": "high", "type": "concept", "note": "The term 'Pathological cases' refers to the study of diseases and abnormal conditions, which is the domain of pathology."}}, {"canonical_name": "exp\u00e9rimentateurs", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "exp\u00e9rimentateurs", "book_id": "medecine_experimentale_bernard_1865", "name": "exp\u00e9rimentateurs", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 5, "variants": ["exp\u00e9rimentateurs"], "contexts": ["individuals conducting experiments", "skilled and exact experimenters"]}, {"entity_id": "experimentalists", "book_id": "origin_of_species_darwin_1859", "name": "experimentalists", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["experimentalists"], "contexts": ["individuals conducting experiments"]}, {"entity_id": "experimenters", "book_id": "principles_of_psychology_james_1890", "name": "experimenters", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["experimenters"], "contexts": ["individuals conducting experiments"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "exp\u00e9rimentateurs", "target_book": "origin_of_species_darwin_1859", "target_name": "experimentalists", "similarity": 0.955}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "exp\u00e9rimentateurs", "target_book": "principles_of_psychology_james_1890", "target_name": "experimenters", "similarity": 0.967}, {"source_book": "origin_of_species_darwin_1859", "source_name": "experimentalists", "target_book": "principles_of_psychology_james_1890", "target_name": "experimenters", "similarity": 0.96}], "id": 1474, "stable_key": "clu_e4f0d1301ac3e60c", "ground_truth": {"wikipedia_extract": "Experimentalism is the philosophical belief that the way to truth is through experiments and empiricism. It is also associated with instrumentalism, the belief that truth should be evaluated based upon its demonstrated usefulness. Experimentalism is considered a theory of knowledge that emphasizes direct action and scientific control as well as methods and consequences. Experimentalism is referred to as John Dewey's version of pragmatism. The theory, which he also called as practicalism, holds that the pattern for knowledge should be modern science and modern scientific methods. Dewey explained that philosophy involves the critical evaluation of belief and that the concept's function is practical."}}, {"canonical_name": "fibres musculaires", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "fibres_musculaires", "book_id": "medecine_experimentale_bernard_1865", "name": "fibres musculaires", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["fibres musculaires"], "contexts": ["tissue responsible for muscle contraction", "components of muscle tissue"]}, {"entity_id": "fibre_musculaire", "book_id": "medecine_experimentale_bernard_1865", "name": "fibre musculaire", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["fibre musculaire"], "contexts": ["contractile tissue in muscles"]}, {"entity_id": "muscular_fibres", "book_id": "principles_of_psychology_james_1890", "name": "muscular fibres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["muscular fibres"], "contexts": ["basic units of muscle tissue"]}, {"entity_id": "muscular_fibres", "book_id": "first_principles_spencer_1862", "name": "muscular fibres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["muscular fibres"], "contexts": ["fibers within muscles"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "fibres musculaires", "target_book": "principles_of_psychology_james_1890", "target_name": "muscular fibres", "similarity": 0.973}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "fibres musculaires", "target_book": "first_principles_spencer_1862", "target_name": "muscular fibres", "similarity": 0.973}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "fibre musculaire", "target_book": "principles_of_psychology_james_1890", "target_name": "muscular fibres", "similarity": 0.965}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "fibre musculaire", "target_book": "first_principles_spencer_1862", "target_name": "muscular fibres", "similarity": 0.965}, {"source_book": "principles_of_psychology_james_1890", "source_name": "muscular fibres", "target_book": "first_principles_spencer_1862", "target_name": "muscular fibres", "similarity": 1.0}], "id": 1475, "stable_key": "clu_dc348dd3381433fd", "ground_truth": {"modern_name": "Muscle fibers", "confidence": "high", "type": "concept", "note": "The descriptions 'basic units of muscle tissue' and 'fibers within muscles' directly correspond to the biological term 'muscle fibers'."}}, {"canonical_name": "empiriquement", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "empiriquement", "book_id": "medecine_experimentale_bernard_1865", "name": "empiriquement", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 3, "variants": ["empiriquement"], "contexts": ["method of acquiring knowledge through observation", "based on observation and experience"]}, {"entity_id": "empirical", "book_id": "origin_of_species_darwin_1859", "name": "empirical", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["empirical"], "contexts": ["based on observation and experience"]}, {"entity_id": "empirical", "book_id": "principles_of_psychology_james_1890", "name": "empirical", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["empirical"], "contexts": ["based on observation and experience", "relating to experience and observation"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "empiriquement", "target_book": "origin_of_species_darwin_1859", "target_name": "empirical", "similarity": 0.923}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "empiriquement", "target_book": "principles_of_psychology_james_1890", "target_name": "empirical", "similarity": 0.923}, {"source_book": "origin_of_species_darwin_1859", "source_name": "empirical", "target_book": "principles_of_psychology_james_1890", "target_name": "empirical", "similarity": 1.0}], "id": 1476, "stable_key": "clu_89893e40f8270dde", "ground_truth": {"modern_name": "empirical", "confidence": "high", "type": "concept", "wikidata_id": "Q336", "wikidata_description": "systematic endeavor that builds and organizes knowledge, and the set of knowledge produced by this system"}}, {"canonical_name": "Pascal", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "pascal", "book_id": "medecine_experimentale_bernard_1865", "name": "Pascal", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Pascal"], "contexts": ["made barometric observation on a tower", "scholar who spoke paradoxically about seeking the search"]}, {"entity_id": "pascal", "book_id": "principles_of_psychology_james_1890", "name": "Pascal", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Pascal"], "contexts": ["individual with capacity for deep absorption", "person with capacity for deep absorption"]}, {"entity_id": "pascal", "book_id": "polyanthea_medicinal", "name": "Pascal", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Pascal"], "contexts": ["cited authority on vertigo", "cited for treating diseases"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Pascal", "target_book": "principles_of_psychology_james_1890", "target_name": "Pascal", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Pascal", "target_book": "polyanthea_medicinal", "target_name": "Pascal", "similarity": 0.793}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Pascal", "target_book": "polyanthea_medicinal", "target_name": "Pascal", "similarity": 0.793}], "id": 1477, "stable_key": "clu_136edb856286d774", "ground_truth": {"modern_name": "Blaise Pascal", "confidence": "high", "type": "person", "birth_year": 1623, "death_year": 1662, "description": "French mathematician, physicist, inventor, writer, philosopher, and theologian", "wikidata_id": "Q1290", "wikidata_description": "French mathematician, physicist, inventor, writer, and Christian philosopher (1623\u20131662)"}}, {"canonical_name": "l'esprit", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "l'esprit", "book_id": "medecine_experimentale_bernard_1865", "name": "l'esprit", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["l'esprit"], "contexts": ["mind, seat of thought and ideas", "mind's natural progression"]}, {"entity_id": "spirit", "book_id": "principles_of_psychology_james_1890", "name": "spirit", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["spirit"], "contexts": ["non-material essence or soul", "abstract concept in spiritualist philosophy"]}, {"entity_id": "spirit", "book_id": "first_principles_spencer_1862", "name": "Spirit", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["spirit", "Spirit"], "contexts": ["non-physical substance, potential cause of sensory impressions", "antithetical conception to Matter"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "l'esprit", "target_book": "principles_of_psychology_james_1890", "target_name": "spirit", "similarity": 0.924}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "l'esprit", "target_book": "first_principles_spencer_1862", "target_name": "Spirit", "similarity": 0.923}, {"source_book": "principles_of_psychology_james_1890", "source_name": "spirit", "target_book": "first_principles_spencer_1862", "target_name": "Spirit", "similarity": 0.963}], "id": 1478, "stable_key": "clu_6d1f0035bef709d1", "ground_truth": {"modern_name": "Spirit", "confidence": "high", "type": "concept", "note": "Covers philosophical, religious, and scientific (e.g., breath) connotations of 'spirit' across languages.", "wikidata_id": "Q9174", "wikidata_description": "social-cultural system", "wikipedia_url": "https://en.wikipedia.org/wiki/Religion", "wikipedia_extract": "Religion is a range of social-cultural systems, including designated behaviors and practices, ethics, morals, beliefs, worldviews, texts, sanctified places, prophecies, or organizations, that generally relate humanity to supernatural, transcendental, and spiritual elements\u2014although there is no scholarly consensus over what precisely constitutes a religion. It is an essentially contested concept. Different religions may or may not contain various elements ranging from the divine, sacredness, faith, and a supernatural being or beings. The origin of religious belief is an open question, with possible explanations including awareness of individual death, a sense of community, and dreams. Religions have sacred histories, narratives, and mythologies, preserved in oral traditions, sacred texts, symbols, and holy places, that may attempt to explain the origin of life, the universe, and other phenomena. Religious practice may include rituals, sermons, commemoration or veneration (of deities or saints), sacrifices, festivals, feasts, trances, initiations, matrimonial and funerary services, meditation, prayer, music, art, dance, or public service."}}, {"canonical_name": "Duodeno", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "duodenum", "book_id": "medecine_experimentale_bernard_1865", "name": "duodenum", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["duodenum"], "contexts": ["first part of the small intestine"]}, {"entity_id": "duodenum", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "duodenum", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["duodenum"], "contexts": ["upper part of the small intestine"]}, {"entity_id": "duodeno", "book_id": "polyanthea_medicinal", "name": "Duodeno", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["Duodeno", "Duodenum", "duodeno"], "contexts": ["duodenum, part of the small intestine", "first part of the small intestine"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "duodenum", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "duodenum", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "duodenum", "target_book": "polyanthea_medicinal", "target_name": "Duodeno", "similarity": 0.933}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "duodenum", "target_book": "polyanthea_medicinal", "target_name": "Duodeno", "similarity": 0.933}], "id": 1479, "stable_key": "clu_280acf3a5b00c1d7", "ground_truth": {"modern_name": "Duodenum", "confidence": "high", "type": "concept", "wikidata_id": "Q18556187", "wikidata_description": "Human disease"}}, {"canonical_name": "Antiquity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "antiquity", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Antiquity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Antiquity"], "contexts": ["ancient times and traditions", "respect for ancient times"]}, {"entity_id": "antiqu