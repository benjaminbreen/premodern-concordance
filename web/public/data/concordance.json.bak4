9, "members": [{"entity_id": "rapidity", "book_id": "principles_of_psychology_james_1890", "name": "rapidity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["rapidity"], "contexts": ["speed of action"]}, {"entity_id": "velocity", "book_id": "kosmos_humboldt_1845", "name": "velocity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["velocity"], "contexts": ["speed of light transmission", "speed of motion"]}, {"entity_id": "velocity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "velocity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["velocity", "Velocity"], "contexts": ["speed of movement", "speed and direction of motion"]}, {"entity_id": "velocity", "book_id": "first_principles_spencer_1862", "name": "velocity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["velocity"], "contexts": ["rate of movement", "speed and direction of movement"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "rapidity", "target_book": "kosmos_humboldt_1845", "target_name": "velocity", "similarity": 0.888}, {"source_book": "principles_of_psychology_james_1890", "source_name": "rapidity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "velocity", "similarity": 0.888}, {"source_book": "principles_of_psychology_james_1890", "source_name": "rapidity", "target_book": "first_principles_spencer_1862", "target_name": "velocity", "similarity": 0.888}, {"source_book": "kosmos_humboldt_1845", "source_name": "velocity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "velocity", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "velocity", "target_book": "first_principles_spencer_1862", "target_name": "velocity", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "velocity", "target_book": "first_principles_spencer_1862", "target_name": "velocity", "similarity": 1.0}], "id": 503, "stable_key": "clu_8f09c786986e913d", "ground_truth": {"modern_name": "velocity", "confidence": "high", "type": "concept", "wikidata_id": "Q1144560", "wikidata_description": "quantity of process intensivity (mathematics)", "wikipedia_url": "https://en.wikipedia.org/wiki/Rate%20%28mathematics%29", "wikipedia_extract": "In mathematics, a rate is the quotient of two quantities, often represented as a fraction. If the divisor (or fraction denominator) in the rate is equal to one expressed as a single unit, and if it is assumed that this quantity can be changed systematically (i.e., is an independent variable), then the dividend (the fraction numerator) of the rate expresses the corresponding rate of change in the other (dependent) variable. In some cases, it may be regarded as a change to a value, which is caused by a change of a value in respect to another value. For example, acceleration is a change in velocity with respect to time. Temporal rate is a common type of rate, in which the denominator is a time duration (\"per unit of time\"), such as in speed, heart rate, and flux. In fact, often rate is a synonym of rhythm or frequency, a count per second (i.e., hertz); e.g., radio frequencies or sample rates."}}, {"canonical_name": "circle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 19, "members": [{"entity_id": "circle", "book_id": "kosmos_humboldt_1845", "name": "circle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["circle"], "contexts": ["area of interest"]}, {"entity_id": "circulo", "book_id": "polyanthea_medicinal", "name": "circulo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["circulo"], "contexts": ["circle"]}, {"entity_id": "circle", "book_id": "connexion_physical_sciences_somerville_1858", "name": "circle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 13, "variants": ["circle"], "contexts": ["geometric shape with uniform distance from center", "round geometric shape"]}, {"entity_id": "circles", "book_id": "connexion_physical_sciences_somerville_1858", "name": "circles", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["circles"], "contexts": ["geometric shape of orbits", "geometric shape described by particles"]}, {"entity_id": "circle", "book_id": "first_principles_spencer_1862", "name": "circle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["circle"], "contexts": ["geometric shape with all points equidistant"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "circle", "target_book": "polyanthea_medicinal", "target_name": "circulo", "similarity": 0.97}, {"source_book": "kosmos_humboldt_1845", "source_name": "circle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "circle", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "circle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "circles", "similarity": 0.89}, {"source_book": "kosmos_humboldt_1845", "source_name": "circle", "target_book": "first_principles_spencer_1862", "target_name": "circle", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "circulo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "circle", "similarity": 0.97}, {"source_book": "polyanthea_medicinal", "source_name": "circulo", "target_book": "first_principles_spencer_1862", "target_name": "circle", "similarity": 0.97}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "circle", "target_book": "first_principles_spencer_1862", "target_name": "circle", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "circles", "target_book": "first_principles_spencer_1862", "target_name": "circle", "similarity": 0.89}], "id": 504, "stable_key": "clu_05edfdbce5f8ed73", "ground_truth": {"modern_name": "Circle", "confidence": "high", "type": "concept", "wikidata_id": "Q6346", "wikidata_description": "capital city of the U.S. state of Indiana and the seat of Marion County", "wikipedia_url": "https://en.wikipedia.org/wiki/Indianapolis", "wikipedia_extract": "Indianapolis (  IN-dee-\u0259-NAP-\u0259-lis), colloquially known as Indy, is the capital and most populous city of the U.S. state of Indiana and the county seat of Marion County. Indianapolis is situated in the state's central till plain region along the west fork of the White River. The city's official slogan, \"Crossroads of America\", reflects its historic importance as a transportation hub and its relative proximity to other major North American markets. According to the 2020 census, the Indianapolis proper had population 887,642. Indianapolis is the 16th-most populous city in the United States and the fourth-most populous state capital."}}, {"canonical_name": "pulmonum", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 19, "members": [{"entity_id": "pulmon", "book_id": "historia_medicinal_monardes_1574", "name": "Pulmon", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Pulmon", "pulmon"], "contexts": ["lung", "lung, an organ"]}, {"entity_id": "pulm\u00e3o", "book_id": "coloquios_da_orta_1563", "name": "pulm\u00e3o", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["pulm\u00e3o"], "contexts": ["body part"]}, {"entity_id": "polmone", "book_id": "ricettario_fiorentino_1597", "name": "polmone", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["polmone"], "contexts": ["lung, part of the body", "lung, organ for preparation"]}, {"entity_id": "pulmonum", "book_id": "polyanthea_medicinal", "name": "pulmonum", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 14, "variants": ["pulmonum", "Pulmo", "Pulmonis", "polmone", "pulmo", "pulmon.", "pulmonem", "pulmones", "pulmonis"], "contexts": ["lungs", "lung"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Pulmon", "target_book": "coloquios_da_orta_1563", "target_name": "pulm\u00e3o", "similarity": 0.975}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Pulmon", "target_book": "ricettario_fiorentino_1597", "target_name": "polmone", "similarity": 0.943}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Pulmon", "target_book": "polyanthea_medicinal", "target_name": "pulmonum", "similarity": 0.974}, {"source_book": "coloquios_da_orta_1563", "source_name": "pulm\u00e3o", "target_book": "ricettario_fiorentino_1597", "target_name": "polmone", "similarity": 0.932}, {"source_book": "coloquios_da_orta_1563", "source_name": "pulm\u00e3o", "target_book": "polyanthea_medicinal", "target_name": "pulmonum", "similarity": 0.969}, {"source_book": "ricettario_fiorentino_1597", "source_name": "polmone", "target_book": "polyanthea_medicinal", "target_name": "pulmonum", "similarity": 0.933}], "id": 505, "stable_key": "clu_cf8fefd918df9a51", "ground_truth": {"modern_name": "lung", "confidence": "high", "type": "anatomy", "description": "The respiratory organ in the chest of humans and animals.", "wikipedia_extract": "The lungs are the primary organs of the respiratory system in many animals, including humans. In mammals and most other tetrapods, two lungs are located near the backbone on either side of the heart. Their function in the respiratory system is to extract oxygen from the atmosphere and transfer it into the bloodstream, and to release carbon dioxide from the bloodstream into the atmosphere, in a process of gas exchange. Respiration is driven by different muscular systems in different species. Mammals, reptiles and birds use their musculoskeletal systems to support and foster breathing. In early tetrapods, air was driven into the lungs by the pharyngeal muscles via buccal pumping, a mechanism still seen in amphibians."}}, {"canonical_name": "Bouguer", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 19, "members": [{"entity_id": "bouguer", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bouguer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 11, "variants": ["Bouguer", "Bougner"], "contexts": ["geodesist and astronomer", "academician who observed atmospheric tides"]}, {"entity_id": "bonguer", "book_id": "kosmos_humboldt_1845", "name": "Bonguer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bonguer"], "contexts": ["had slight difference with La Condamine"]}, {"entity_id": "bouguer", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bouguer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Bouguer"], "contexts": ["observer of gravitational anomaly", "measured degrees of the meridian"]}, {"entity_id": "bouguer", "book_id": "kosmos_humboldt_1845", "name": "Bouguer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Bouguer"], "contexts": ["erected monument at equator", "returned to Europe in June 1744"]}, {"entity_id": "budeu", "book_id": "coloquios_da_orta_1563", "name": "Budeu", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Budeu"], "contexts": ["referenced for currency calculation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bouguer", "target_book": "kosmos_humboldt_1845", "target_name": "Bonguer", "similarity": 0.866}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bouguer", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bouguer", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bonguer", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bouguer", "similarity": 0.866}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bouguer", "target_book": "coloquios_da_orta_1563", "target_name": "Budeu", "similarity": 0.85}], "id": 506, "stable_key": "clu_132888d436aef018", "ground_truth": {"modern_name": "Pierre Bouguer", "confidence": "high", "type": "person", "birth_year": 1698, "death_year": 1758, "description": "French geodesist, astronomer, and cartographer.", "note": "Variant spellings like 'Budeu' and 'Boulin' likely refer to him given the context of exploration and scientific works.", "wikidata_id": "Q11065", "wikidata_description": "French astronomer and mathematician (1698-1758)", "wikipedia_url": "https://en.wikipedia.org/wiki/Pierre%20Bouguer", "wikipedia_extract": "Pierre Bouguer (French: [bu\u02c8ge]) (16 February 1698, Le Croisic, Province of Brittany \u2013 15 August 1758, Paris) was a French mathematician, geophysicist, geodesist, and astronomer. He is also known as \"the father of naval architecture\". Bouguer's father, Jean Bouguer, one of the best hydrographers of his time, was Regius Professor of hydrography at Le Croisic in lower Brittany, and author of a treatise on navigation. He taught his sons Pierre and Jan at their home, where he also taught private students. In 1714, at the age of 16, Pierre was appointed to succeed his deceased father as professor of hydrography. In 1727 he gained the prize given by the French Academy of Sciences for his paper On the masting of ships, beating Leonhard Euler; and two other prizes, one for his dissertation On the best method of observing the altitude of stars at sea, the other for his paper On the best method of observing the variation of the compass at sea."}}, {"canonical_name": "Her\u00f3doto", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 4, "total_mentions": 18, "members": [{"entity_id": "herodotus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Herodotus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 5, "variants": ["Herodotus"], "contexts": ["ancient historian", "ancient historian, father of history"]}, {"entity_id": "h\u00e9rodote", "book_id": "relation_historique_humboldt_vol3_1825", "name": "H\u00e9rodote", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["H\u00e9rodote"], "contexts": ["ancient Greek historian", "ancient historian"]}, {"entity_id": "herodotus", "book_id": "kosmos_humboldt_1845", "name": "Herodotus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Herodotus"], "contexts": ["ancient Greek historian", "described Scythia as free from earthquakes"]}, {"entity_id": "her\u00f3doto", "book_id": "coloquios_da_orta_1563", "name": "Her\u00f3doto", "category": "PERSON", "subcategory": "AUTHORITY", "count": 8, "variants": ["Her\u00f3doto"], "contexts": ["ancient historian mentioning Scythas and hemp", "Ancient writer of fables"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Herodotus", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "H\u00e9rodote", "similarity": 0.877}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Herodotus", "target_book": "kosmos_humboldt_1845", "target_name": "Herodotus", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Herodotus", "target_book": "coloquios_da_orta_1563", "target_name": "Her\u00f3doto", "similarity": 0.856}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "H\u00e9rodote", "target_book": "kosmos_humboldt_1845", "target_name": "Herodotus", "similarity": 0.877}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "H\u00e9rodote", "target_book": "coloquios_da_orta_1563", "target_name": "Her\u00f3doto", "similarity": 0.901}, {"source_book": "kosmos_humboldt_1845", "source_name": "Herodotus", "target_book": "coloquios_da_orta_1563", "target_name": "Her\u00f3doto", "similarity": 0.856}], "id": 507, "stable_key": "clu_cdb6e2dede7f0433", "ground_truth": {"modern_name": "Herodotus", "confidence": "high", "type": "person", "birth_year": -484, "death_year": -425, "description": "Ancient Greek historian, known as the 'Father of History'.", "wikidata_id": "Q26825", "wikidata_description": "Greek historian and geographer (c.484\u2013c.425 BC)", "wikipedia_url": "https://en.wikipedia.org/wiki/Herodotus", "wikipedia_extract": "Herodotus (Ancient Greek: \u1f29\u03c1\u03cc\u03b4\u03bf\u03c4\u03bf\u03c2, romanized: H\u0113r\u00f3dotos; c. 484 \u2013 c. 425 BC) was a Greek historian and geographer from the Greek city of Halicarnassus (now Bodrum, Turkey), under Persian control in the 5th century BC, and a later citizen of Thurii in modern Calabria, Italy. He wrote the Histories, a detailed account of the Greco-Persian Wars, among other subjects such as the rise of the Achaemenid dynasty of Cyrus. He has been described as \"The Father of History\", a title conferred on him by the ancient Roman orator Cicero. The Histories primarily cover the lives of prominent kings and famous battles such as Marathon, Thermopylae, Artemisium, Salamis, Plataea, and Mycale."}}, {"canonical_name": "Tutia", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 4, "total_mentions": 18, "members": [{"entity_id": "tutiae", "book_id": "english_physician_1652", "name": "Tutiae", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Tutiae", "Tutia"], "contexts": ["zinc oxide used in medicine", "preparation used with distilled water"]}, {"entity_id": "tutia", "book_id": "coloquios_da_orta_1563", "name": "Tutia", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 8, "variants": ["Tutia", "TuTiA", "tutia"], "contexts": ["type of espodio", "mineral substance, likely zinc oxide"]}, {"entity_id": "tuzia", "book_id": "ricettario_fiorentino_1597", "name": "Tuzia", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["Tuzia", "Tuzia di", "tuzia"], "contexts": ["mineral substance used by apothecaries", "plant mentioned in ancient texts"]}, {"entity_id": "tutia", "book_id": "polyanthea_medicinal", "name": "tutia", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["tutia"], "contexts": ["tutty", "tutty used in an ointment"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Tutiae", "target_book": "coloquios_da_orta_1563", "target_name": "Tutia", "similarity": 0.962}, {"source_book": "english_physician_1652", "source_name": "Tutiae", "target_book": "ricettario_fiorentino_1597", "target_name": "Tuzia", "similarity": 0.914}, {"source_book": "english_physician_1652", "source_name": "Tutiae", "target_book": "polyanthea_medicinal", "target_name": "tutia", "similarity": 0.947}, {"source_book": "coloquios_da_orta_1563", "source_name": "Tutia", "target_book": "ricettario_fiorentino_1597", "target_name": "Tuzia", "similarity": 0.913}, {"source_book": "coloquios_da_orta_1563", "source_name": "Tutia", "target_book": "polyanthea_medicinal", "target_name": "tutia", "similarity": 0.977}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Tuzia", "target_book": "polyanthea_medicinal", "target_name": "tutia", "similarity": 0.893}], "id": 508, "stable_key": "clu_76de62d5515813ad", "ground_truth": {"modern_name": "Zinc Oxide", "confidence": "high", "type": "mineral", "wikidata_id": "Q126603440", "wikidata_description": "chemical compound"}}, {"canonical_name": "Wollaston", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 18, "members": [{"entity_id": "wollaston", "book_id": "origin_of_species_darwin_1859", "name": "Wollaston", "category": "PERSON", "subcategory": "SCHOLAR", "count": 9, "variants": ["Mr. Wollaston", "Wollaston"], "contexts": ["observed fossil land-shells in Madeira", "convinced sea residence affects insect colours"]}, {"entity_id": "d''_wollaston", "book_id": "relation_historique_humboldt_vol3_1825", "name": "D'' Wollaston", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["D'' Wollaston", "M. Wollaston"], "contexts": ["scientist associated with a property", "physicist consulted on phenomenon"]}, {"entity_id": "wollaston", "book_id": "kosmos_humboldt_1845", "name": "Wollaston", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Wollaston"], "contexts": ["scientist discussing atmosphere limit"]}, {"entity_id": "wollaston", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Wollaston", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Wollaston"], "contexts": ["discoverer of photographic rays", "discovered dark lines in spectrum"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Wollaston", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "D'' Wollaston", "similarity": 0.925}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Wollaston", "target_book": "kosmos_humboldt_1845", "target_name": "Wollaston", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Wollaston", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Wollaston", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "D'' Wollaston", "target_book": "kosmos_humboldt_1845", "target_name": "Wollaston", "similarity": 0.925}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "D'' Wollaston", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Wollaston", "similarity": 0.925}, {"source_book": "kosmos_humboldt_1845", "source_name": "Wollaston", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Wollaston", "similarity": 1.0}], "id": 509, "stable_key": "clu_c4629c27868931e7", "ground_truth": {"modern_name": "William Hyde Wollaston", "confidence": "high", "type": "person", "birth_year": 1766, "death_year": 1828, "description": "Chemist and mineralogist known for chemical discoveries.", "wikidata_id": "Q312975", "wikidata_description": "English chemist and physicist (1766\u20131828)", "wikipedia_url": "https://en.wikipedia.org/wiki/William%20Hyde%20Wollaston", "wikipedia_extract": "William Hyde Wollaston  (; 6 August 1766 \u2013 22 December 1828) was an English chemist and physicist who is famous for discovering the chemical elements palladium and rhodium. He also developed a way to process platinum ore into malleable ingots, patented the camera lucida, and made contributions in electricity and spectroscopy. He was born in East Dereham in Norfolk, the son of the Francis Wollaston (1737\u20131815), a noted amateur astronomer, and his wife Althea Hyde. He was one of 17 children, but the family was financially well-off and he enjoyed an intellectually stimulating environment. He was educated privately (and remotely) at Charterhouse School from 1774 to 1778 then studied Sciences at Gonville and Caius College, Cambridge. In 1793 he obtained his doctorate (MD) in medicine from Cambridge University, and was a Fellow of his college from 1787 to 1828."}}, {"canonical_name": "Tripas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 18, "members": [{"entity_id": "tripas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "tripas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 7, "variants": ["tripas"], "contexts": ["intestinal pain and cramps", "intestines"]}, {"entity_id": "tripas", "book_id": "historia_medicinal_monardes_1574", "name": "tripas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Tripas", "tripas"], "contexts": ["intestines"]}, {"entity_id": "tripas", "book_id": "coloquios_da_orta_1563", "name": "tripas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["tripas"], "contexts": ["intestines"]}, {"entity_id": "tripas", "book_id": "polyanthea_medicinal", "name": "Tripas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 8, "variants": ["Tripas", "tripa", "tripas"], "contexts": ["intestines", "intestines, part of the body"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "tripas", "target_book": "historia_medicinal_monardes_1574", "target_name": "tripas", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "tripas", "target_book": "coloquios_da_orta_1563", "target_name": "tripas", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "tripas", "target_book": "polyanthea_medicinal", "target_name": "Tripas", "similarity": 0.841}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "tripas", "target_book": "coloquios_da_orta_1563", "target_name": "tripas", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "tripas", "target_book": "polyanthea_medicinal", "target_name": "Tripas", "similarity": 0.841}, {"source_book": "coloquios_da_orta_1563", "source_name": "tripas", "target_book": "polyanthea_medicinal", "target_name": "Tripas", "similarity": 0.841}], "id": 510, "stable_key": "clu_09b1984512807aa6", "ground_truth": {"modern_name": "Intestines", "confidence": "high", "type": "anatomy", "description": "The part of the digestive system in animals.", "note": "Refers to the anatomical organs.", "wikipedia_extract": "The gastrointestinal tract (also called the GI tract, digestive tract, and the alimentary canal) is the tract or passageway of the digestive system that leads from the mouth to the anus. The tract is one of the largest of the body's systems. The GI tract contains all the major organs of the digestive system, in humans and other animals, including the esophagus, stomach, and intestines. Food taken in through the mouth is digested to extract nutrients and absorb energy, and the waste expelled at the anus as feces. Gastrointestinal is an adjective meaning of or pertaining to the stomach and intestines. Most animals have a \"through-gut\" or complete digestive tract.", "wikidata_id": "Q9639", "wikidata_description": "alimentary canal of an animal through which food passes after having passed all stomachs"}}, {"canonical_name": "Oviedo", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 18, "members": [{"entity_id": "oviedo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Oviedo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Oviedo"], "contexts": ["Captain Oviedo in the Chronicle"]}, {"entity_id": "oviedo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Oviedo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Oviedo"], "contexts": ["author of 'Bisl. nat. des Ind.'"]}, {"entity_id": "oviedo", "book_id": "kosmos_humboldt_1845", "name": "Oviedo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Oviedo"], "contexts": ["calls Sargasso Sea 'sea-weed meadows'", "describes weed of the Gulf Stream"]}, {"entity_id": "oviedo", "book_id": "coloquios_da_orta_1563", "name": "Oviedo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 14, "variants": ["Oviedo", "Gon\u00e7alo de Oviedo", "Oviedo (Gon\u00e7alo de)"], "contexts": ["source of information for Orta", "celebrated cinnamon from America"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Oviedo", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Oviedo", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Oviedo", "target_book": "kosmos_humboldt_1845", "target_name": "Oviedo", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Oviedo", "target_book": "coloquios_da_orta_1563", "target_name": "Oviedo", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oviedo", "target_book": "kosmos_humboldt_1845", "target_name": "Oviedo", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oviedo", "target_book": "coloquios_da_orta_1563", "target_name": "Oviedo", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Oviedo", "target_book": "coloquios_da_orta_1563", "target_name": "Oviedo", "similarity": 1.0}], "id": 511, "stable_key": "clu_e32e7c9293b1586c", "ground_truth": {"modern_name": "Oviedo", "confidence": "high", "type": "person", "description": "A source of information and author of natural history works.", "note": "Refers to Gonzalo Fern\u00e1ndez de Oviedo y Vald\u00e9s.", "wikipedia_extract": "Oviedo (Spanish: [o\u02c8\u03b2je\u00f0o] ) or Uvi\u00e9u (Asturian: [u\u02c8\u03b2jew]) is the capital city of the Principality of Asturias in northern Spain and the administrative and commercial centre of the region. With a population of 220,027, it is also the 2nd-largest city in Asturias. Oviedo is located approximately 24 km (15 mi) southwest of Gij\u00f3n and 23 km (14 mi) southeast of Avil\u00e9s, both of which lie on the shoreline of the Bay of Biscay. Oviedo's proximity to the ocean of less than 30 kilometres (19 mi) in combination with its elevated position with areas of the city more than 300 metres above sea level causes the city to have a maritime climate, even though it does not sit directly on the shore. The Kingdom of Asturias began in 720, with the Visigothic aristocrat Pelagius's (685\u2013737) revolt against the Muslims who at the time were occupying most of the Iberian Peninsula. The Moorish invasion that began in 711 had taken control of most of the peninsula, until the revolt in the northern mountains by Pelagius."}}, {"canonical_name": "Franklin", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 18, "members": [{"entity_id": "franklin", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Franklin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["Franklin", "Franzini", "Franzinl"], "contexts": ["captain who made discoveries", "captain who made observations"]}, {"entity_id": "franklin", "book_id": "principles_of_psychology_james_1890", "name": "Franklin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Franklin"], "contexts": ["scientist associated with lightning"]}, {"entity_id": "franklin", "book_id": "kosmos_humboldt_1845", "name": "Franklin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["Franklin"], "contexts": ["scientist whose ideas were germinated by Halley's", "observed clouds near American north pole"]}, {"entity_id": "john_franklin", "book_id": "kosmos_humboldt_1845", "name": "John Franklin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["John Franklin"], "contexts": ["author of 'Narrative of a Journey'"]}, {"entity_id": "franklin", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Franklin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Franklin"], "contexts": ["snatched thunderbolt from heaven", "honored with a medal"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Franklin", "target_book": "principles_of_psychology_james_1890", "target_name": "Franklin", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Franklin", "target_book": "kosmos_humboldt_1845", "target_name": "Franklin", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Franklin", "target_book": "kosmos_humboldt_1845", "target_name": "John Franklin", "similarity": 0.871}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Franklin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Franklin", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Franklin", "target_book": "kosmos_humboldt_1845", "target_name": "Franklin", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Franklin", "target_book": "kosmos_humboldt_1845", "target_name": "John Franklin", "similarity": 0.871}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Franklin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Franklin", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Franklin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Franklin", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "John Franklin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Franklin", "similarity": 0.871}], "id": 512, "stable_key": "clu_2cf3c3e8d3cb3b35", "ground_truth": {"modern_name": "Benjamin Franklin", "confidence": "high", "type": "person", "birth_year": 1706, "death_year": 1790, "description": "Polymath and Founding Father known for electricity experiments.", "note": "While 'John Franklin' is mentioned, the context of lightning points strongly to Benjamin Franklin. The term 'Franklin' alone often refers to him in scientific contexts of the period.", "wikidata_id": "Q34969", "wikidata_description": "American polymath and statesman (1706\u20131790)", "wikipedia_url": "https://en.wikipedia.org/wiki/Benjamin%20Franklin", "wikipedia_extract": "Benjamin Franklin (January 17, 1706 [O.S. January 6, 1705] \u2013 April 17, 1790) was an American polymath: a writer, scientist, inventor, statesman, diplomat, printer, publisher and political philosopher. Among the most influential intellectuals of his time, Franklin was one of the Founding Fathers of the United States; a drafter and signer of the Declaration of Independence; and the first postmaster general. Born in the Province of Massachusetts Bay, Franklin became a successful newspaper editor and printer in Philadelphia, the leading city in the colonies, publishing The Pennsylvania Gazette at age 23. He became wealthy publishing this and Poor Richard's Almanack, which he wrote under the pseudonym \"Richard Saunders\". After 1767, he was associated with the Pennsylvania Chronicle, a newspaper known for its revolutionary sentiments and criticisms of the policies of the British Parliament and the Crown."}}, {"canonical_name": "Centre of gravity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 18, "members": [{"entity_id": "centre_of_gravity", "book_id": "principles_of_psychology_james_1890", "name": "centre of gravity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["centre of gravity"], "contexts": ["point of balance in physics"]}, {"entity_id": "center_of_gravity", "book_id": "kosmos_humboldt_1845", "name": "center of gravity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["center of gravity"], "contexts": ["point of balance for orbiting bodies", "point where weight is balanced"]}, {"entity_id": "centre_of_gravity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Centre of gravity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["Centre of gravity", "centre of gravity"], "contexts": ["point where gravity acts", "point of gravitational balance"]}, {"entity_id": "centre_of_gravity", "book_id": "first_principles_spencer_1862", "name": "centre of gravity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["centre of gravity"], "contexts": ["destination of Earth's substance motion", "point towards which matter is drawn"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "centre of gravity", "target_book": "kosmos_humboldt_1845", "target_name": "center of gravity", "similarity": 0.997}, {"source_book": "principles_of_psychology_james_1890", "source_name": "centre of gravity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Centre of gravity", "similarity": 0.993}, {"source_book": "principles_of_psychology_james_1890", "source_name": "centre of gravity", "target_book": "first_principles_spencer_1862", "target_name": "centre of gravity", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "center of gravity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Centre of gravity", "similarity": 0.987}, {"source_book": "kosmos_humboldt_1845", "source_name": "center of gravity", "target_book": "first_principles_spencer_1862", "target_name": "centre of gravity", "similarity": 0.997}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Centre of gravity", "target_book": "first_principles_spencer_1862", "target_name": "centre of gravity", "similarity": 0.993}], "id": 513, "stable_key": "clu_2e1b6cbc76d76f33", "ground_truth": {"modern_name": "Center of gravity", "confidence": "high", "type": "concept", "wikidata_id": "Q1110236", "wikidata_description": "military concept", "wikipedia_url": "https://en.wikipedia.org/wiki/Center%20of%20gravity%20%28military%29", "wikipedia_extract": "Center of gravity (COG) is a military concept referring to the primary source of strength, balance, or stability necessary for a force to maintain combat operations. Centers of gravity can be physical, moral, or both, and exist for all belligerents at all tactical, strategic, and operational levels of war simultaneously. COGs play a central role in military planning, though exact definition has been elusive, with interpretations varying substantially over time, across forces, and between theorists. Generally, a COG can be thought of as an essential part of a combatant's warfighting system, interference with which would result in disproportionate impact on their combat effectiveness. The concept was first developed by Carl von Clausewitz, a Prussian military theorist, in his work On War. After the end of the Vietnam War, interest in the idea was revitalized, resulting in several competing conceptualizations."}}, {"canonical_name": "Bones", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 18, "members": [{"entity_id": "bones", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Bones", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Bones", "bones"], "contexts": ["skeletal structures", "structures formed in embryonic development"]}, {"entity_id": "bones", "book_id": "english_physician_1652", "name": "Bones", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 14, "variants": ["Bones", "Bone"], "contexts": ["rigid connective tissue forming skeleton", "part covered with flesh by Angelica"]}, {"entity_id": "bones", "book_id": "kosmos_humboldt_1845", "name": "bones", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bones"], "contexts": ["hard tissue forming the skeleton"]}, {"entity_id": "bones", "book_id": "first_principles_spencer_1862", "name": "bones", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bones"], "contexts": ["skeletal structures with articular surfaces"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bones", "target_book": "english_physician_1652", "target_name": "Bones", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "bones", "target_book": "first_principles_spencer_1862", "target_name": "bones", "similarity": 1.0}], "id": 514, "stable_key": "clu_107b6d38dc64ea4c", "ground_truth": {"modern_name": "Bones", "confidence": "high", "type": "object", "wikidata_id": "Q265868", "wikidata_description": "rigid organ that constitutes part of the endoskeleton of vertebrates", "wikipedia_url": "https://en.wikipedia.org/wiki/Bone", "wikipedia_extract": "A bone is a rigid organ that constitutes part of the skeleton in most vertebrate animals. Bones protect the organs of the body, produce red and white blood cells, store minerals, help regulate acid-base homeostasis, provide structure and support for the body, and enable mobility and hearing. Bones come in a variety of shapes and sizes and have complex internal and external structures. Bone tissue (also known as osseous tissue or bone in the uncountable) is a form of hard tissue, specialised connective tissue that is mineralized and has an intercellular honeycomb-like matrix, which helps to give the bone rigidity. Bone tissue is made up of different types of bone cells: osteoblasts and osteocytes (bone formation and mineralisation); osteoclasts (bone resorption); modified or flattened osteoblasts (lining cells that form a protective layer on the bone surface). The mineralised matrix of bone tissue has an organic component of mainly ossein, a form of collagen, and an inorganic component of bone mineral, made up of various salts.", "note": "The context indicates the anatomical meaning of bones, not their mineral composition as a substance."}}, {"canonical_name": "truth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 17, "members": [{"entity_id": "truth", "book_id": "medecine_experimentale_bernard_1865", "name": "truth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["truth"], "contexts": ["abstract concept of reality or fact"]}, {"entity_id": "truth", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "truth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["Truth", "truth"], "contexts": ["conformity to fact or reality", "fundamental reality or accuracy"]}, {"entity_id": "truth", "book_id": "principles_of_psychology_james_1890", "name": "truth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["truth"], "contexts": ["conformity with fact or reality", "conformity to fact or reality"]}, {"entity_id": "truth", "book_id": "first_principles_spencer_1862", "name": "truth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["truth"], "contexts": ["accuracy of beliefs and convictions", "accurate correspondence guiding successful action"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "truth", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "truth", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "truth", "target_book": "principles_of_psychology_james_1890", "target_name": "truth", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "truth", "target_book": "first_principles_spencer_1862", "target_name": "truth", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "truth", "target_book": "principles_of_psychology_james_1890", "target_name": "truth", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "truth", "target_book": "first_principles_spencer_1862", "target_name": "truth", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "truth", "target_book": "first_principles_spencer_1862", "target_name": "truth", "similarity": 1.0}], "id": 515, "stable_key": "clu_25788fd02e0c7e13", "ground_truth": {"modern_name": "truth", "confidence": "high", "type": "concept", "wikidata_id": "Q109001687", "wikidata_description": "social networking service created by Trump Media & Technology Group"}}, {"canonical_name": "Coralli rofsi", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 4, "total_mentions": 17, "members": [{"entity_id": "coral", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Coral", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["Coral"], "contexts": ["fragile mineral substance", "mentioned in a sidenote about transformation"]}, {"entity_id": "corall", "book_id": "english_physician_1652", "name": "Corall", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Corall", "Coral"], "contexts": ["red precious material from the sea", "powdered, used in medicine"]}, {"entity_id": "coral", "book_id": "coloquios_da_orta_1563", "name": "coral", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["coral"], "contexts": ["coral, an ingredient"]}, {"entity_id": "coralli_rofsi", "book_id": "ricettario_fiorentino_1597", "name": "Coralli rofsi", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 9, "variants": ["Coralli rofsi", "Coralli", "Coralli rofs\u00ec", "corallina", "corallo"], "contexts": ["red corals", "red coral used in powders"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Coral", "target_book": "english_physician_1652", "target_name": "Corall", "similarity": 0.969}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Coral", "target_book": "coloquios_da_orta_1563", "target_name": "coral", "similarity": 0.966}, {"source_book": "english_physician_1652", "source_name": "Corall", "target_book": "coloquios_da_orta_1563", "target_name": "coral", "similarity": 0.933}, {"source_book": "english_physician_1652", "source_name": "Corall", "target_book": "ricettario_fiorentino_1597", "target_name": "Coralli rofsi", "similarity": 0.883}], "id": 516, "stable_key": "clu_8c3b6297f1e602af", "ground_truth": {"modern_name": "Red Coral", "confidence": "high", "type": "mineral", "note": "Coralli rofsi refers to red coral, a precious mineral harvested from the sea, often used in historical medicine and jewelry."}}, {"canonical_name": "Naples", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 17, "members": [{"entity_id": "naples", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Naples", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Naples"], "contexts": ["city of Baptista Porta"]}, {"entity_id": "naples", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Naples", "category": "PLACE", "subcategory": "CITY", "count": 8, "variants": ["Naples"], "contexts": ["city where Don Carlos reigned", "city in Italy"]}, {"entity_id": "naples", "book_id": "kosmos_humboldt_1845", "name": "Naples", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Naples"], "contexts": ["excursion to Naples", "location with similar latitude to New York"]}, {"entity_id": "naples", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Naples", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Naples"], "contexts": ["city where Mr. Peters discovered a comet", "comet discovered from"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Naples", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Naples", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Naples", "target_book": "kosmos_humboldt_1845", "target_name": "Naples", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Naples", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Naples", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Naples", "target_book": "kosmos_humboldt_1845", "target_name": "Naples", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Naples", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Naples", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Naples", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Naples", "similarity": 1.0}], "id": 517, "stable_key": "clu_dad8e25a6099f87d", "ground_truth": {"modern_name": "Naples", "confidence": "high", "type": "place", "description": "A major city in southern Italy, historically significant for its kingdom.", "wikipedia_extract": "Naples is the regional capital of Campania, Italy. With a population of 908,082 within the city's administrative limits (as of 2025), it is the largest city in southern Italy and the third-largest city of Italy after Rome and Milan, while its province-level municipality is the third most populous metropolitan city in Italy with a population of 2,958,410 residents. Its metropolitan area, the seventh most populous in the European Union, stretches beyond the boundaries of the city wall for approximately 30 kilometres (20 miles). Naples also plays a key role in international diplomacy, being home to NATO's Allied Joint Force Command Naples and the Parliamentary Assembly of the Mediterranean. Founded by Greeks in the first millennium BCE, Naples is one of the oldest continuously inhabited urban areas in the world. In the eighth century BCE, a colony known as Parthenope (Ancient Greek: \u03a0\u03b1\u03c1\u03b8\u03b5\u03bd\u03cc\u03c0\u03b7) was established on the Pizzofalcone hill."}}, {"canonical_name": "Nitro", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 4, "total_mentions": 17, "members": [{"entity_id": "nitre", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Nitre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Nitre"], "contexts": ["key ingredient in gunpowder"]}, {"entity_id": "nitre", "book_id": "english_physician_1652", "name": "Nitre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["Nitre"], "contexts": ["taken with Balm leaves", "saltpeter used in remedies"]}, {"entity_id": "nitro", "book_id": "ricettario_fiorentino_1597", "name": "Nitro", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["Nitro", "NITRO", "Nitro bianco", "nitro"], "contexts": ["fossilized saltpeter", "substance found in lagoons"]}, {"entity_id": "nitre", "book_id": "connexion_physical_sciences_somerville_1858", "name": "nitre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["nitre"], "contexts": ["combustion produces red lines in spectrum", "crystal exhibiting colored rings"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Nitre", "target_book": "english_physician_1652", "target_name": "Nitre", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Nitre", "target_book": "ricettario_fiorentino_1597", "target_name": "Nitro", "similarity": 0.923}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Nitre", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nitre", "similarity": 0.99}, {"source_book": "english_physician_1652", "source_name": "Nitre", "target_book": "ricettario_fiorentino_1597", "target_name": "Nitro", "similarity": 0.923}, {"source_book": "english_physician_1652", "source_name": "Nitre", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nitre", "similarity": 0.99}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Nitro", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nitre", "similarity": 0.91}], "id": 518, "stable_key": "clu_e9edfb855c12c045", "ground_truth": {"modern_name": "Saltpeter", "confidence": "high", "type": "mineral", "wikidata_id": "Q11183742", "wikidata_description": "mineral form of potassium nitrate", "wikipedia_url": "https://en.wikipedia.org/wiki/Niter", "wikipedia_extract": "Niter or nitre is the mineral form of potassium nitrate, KNO3. It is a soft, white, highly soluble mineral found primarily in arid climates or cave deposits. Potassium and other nitrates are of great importance for use in fertilizers and, historically, gunpowder. Much of the world's demand is now met by synthetically produced nitrates, though the natural mineral is still mined and is still of significant commercial value. Historically, the term niter was not well differentiated from natron, both of which have been very vaguely defined but generally refer to compounds of sodium or potassium combined with carbonate or nitrate ions. Niter is a colorless to white mineral crystallizing in the orthorhombic crystal system.", "note": "The spelling 'falitre' is an archaic Portuguese form of saltpeter."}}, {"canonical_name": "temperamento quente", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 4, "total_mentions": 17, "members": [{"entity_id": "hot_and_sharp_humors", "book_id": "english_physician_1652", "name": "hot and sharp humors", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["hot and sharp humors"], "contexts": ["humoral theory concept"]}, {"entity_id": "humores_calientes", "book_id": "historia_medicinal_monardes_1574", "name": "humores calientes", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["humores calientes"], "contexts": ["hot humors causing stomach issues"]}, {"entity_id": "humor_quente", "book_id": "coloquios_da_orta_1563", "name": "humor quente", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["humor quente"], "contexts": ["hot humor, dangerous in illness"]}, {"entity_id": "temperamento_quente", "book_id": "polyanthea_medicinal", "name": "temperamento quente", "category": "CONCEPT", "subcategory": "QUALITY", "count": 11, "variants": ["temperamento quente", "temperamento calido", "temperamento dos ares", "temperamento frio", "temperamento lecco", "temperamento muyto quente", "temperamentoda", "temperamentomuy nao", "temperamentos"], "contexts": ["hot temperament", "Bodily quality"]}, {"entity_id": "humor_quente", "book_id": "polyanthea_medicinal", "name": "humor quente", "category": "CONCEPT", "subcategory": "QUALITY", "count": 3, "variants": ["humor quente"], "contexts": ["a hot humor", "hot humor"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "hot and sharp humors", "target_book": "historia_medicinal_monardes_1574", "target_name": "humores calientes", "similarity": 0.908}, {"source_book": "english_physician_1652", "source_name": "hot and sharp humors", "target_book": "coloquios_da_orta_1563", "target_name": "humor quente", "similarity": 0.881}, {"source_book": "english_physician_1652", "source_name": "hot and sharp humors", "target_book": "polyanthea_medicinal", "target_name": "humor quente", "similarity": 0.881}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "humores calientes", "target_book": "coloquios_da_orta_1563", "target_name": "humor quente", "similarity": 0.956}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "humores calientes", "target_book": "polyanthea_medicinal", "target_name": "temperamento quente", "similarity": 0.894}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "humores calientes", "target_book": "polyanthea_medicinal", "target_name": "humor quente", "similarity": 0.956}, {"source_book": "coloquios_da_orta_1563", "source_name": "humor quente", "target_book": "polyanthea_medicinal", "target_name": "humor quente", "similarity": 1.0}], "id": 519, "stable_key": "clu_e8c5c457df271b53", "ground_truth": {"modern_name": "Hot temperament", "confidence": "high", "type": "concept"}}, {"canonical_name": "Cambridge", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 17, "members": [{"entity_id": "cambridge", "book_id": "origin_of_species_darwin_1859", "name": "Cambridge", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Cambridge"], "contexts": ["location of Professor Miller", "uniform county with many plants"]}, {"entity_id": "cambridge", "book_id": "principles_of_psychology_james_1890", "name": "Cambridge", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Cambridge"], "contexts": ["city mentioned in distance example"]}, {"entity_id": "cambridge", "book_id": "kosmos_humboldt_1845", "name": "Cambridge", "category": "PLACE", "subcategory": "CITY", "count": 8, "variants": ["Cambridge"], "contexts": ["location of Elzevir edition publication", "location of an edition of Varenius's work"]}, {"entity_id": "cambridge", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cambridge", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Cambridge"], "contexts": ["location of Mr. Willis", "location of Professor Challis"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Cambridge", "target_book": "principles_of_psychology_james_1890", "target_name": "Cambridge", "similarity": 0.868}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Cambridge", "target_book": "kosmos_humboldt_1845", "target_name": "Cambridge", "similarity": 0.868}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Cambridge", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cambridge", "similarity": 0.868}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Cambridge", "target_book": "kosmos_humboldt_1845", "target_name": "Cambridge", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Cambridge", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cambridge", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cambridge", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cambridge", "similarity": 1.0}], "id": 520, "stable_key": "clu_71e61914ce24c548", "ground_truth": {"wikipedia_extract": "Cambridge (  KAYM-brij) is a city and non-metropolitan district in the county of Cambridgeshire, England. It is the county town of Cambridgeshire and is located on the River Cam, 55 miles (89 km) north of London. As of the 2021 United Kingdom census, the population of the City of Cambridge was 145,700; the population of the wider built-up area (which extends outside the city council area) was 181,137. There is archaeological evidence of settlement in the area as early as the Bronze Age, and Cambridge became an important trading centre during the Roman and Viking eras. The first town charters were granted in the 12th century, although modern city status was not officially conferred until 1951. The city is well known as the home of the University of Cambridge, which was founded in 1209 and consistently ranks among the best universities in the world."}}, {"canonical_name": "resina", "category": "PLANT", "subcategory": "RESIN", "book_count": 4, "total_mentions": 17, "members": [{"entity_id": "resina", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "resina", "category": "PLANT", "subcategory": "RESIN", "count": 14, "variants": ["resina"], "contexts": ["medicinal resin", "resinous flavor"]}, {"entity_id": "resin", "book_id": "kosmos_humboldt_1845", "name": "resin", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["resin"], "contexts": ["sticky substance from trees"]}, {"entity_id": "rementina", "book_id": "ricettario_fiorentino_1597", "name": "Rementina", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["Rementina"], "contexts": ["resin used in preparation"]}, {"entity_id": "resins", "book_id": "connexion_physical_sciences_somerville_1858", "name": "resins", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["resins"], "contexts": ["plant exudates with optical properties"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "resina", "target_book": "kosmos_humboldt_1845", "target_name": "resin", "similarity": 0.978}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "resina", "target_book": "ricettario_fiorentino_1597", "target_name": "Rementina", "similarity": 0.895}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "resina", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "resins", "similarity": 0.928}, {"source_book": "kosmos_humboldt_1845", "source_name": "resin", "target_book": "ricettario_fiorentino_1597", "target_name": "Rementina", "similarity": 0.882}, {"source_book": "kosmos_humboldt_1845", "source_name": "resin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "resins", "similarity": 0.944}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Rementina", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "resins", "similarity": 0.889}], "id": 521, "stable_key": "clu_9fa611b2cc4f513a", "ground_truth": {"modern_name": "Resin", "confidence": "high", "type": "plant", "note": "The term 'Rementina' seems to be a specific historical name for a resinous substance, possibly a particular type of resin used in Florentine pharmacopoeia.", "wikidata_id": "Q145205", "wikidata_description": "solid or highly viscous substance, of plant or synthetic origin, which can be polymerized into a solid", "wikipedia_url": "https://en.wikipedia.org/wiki/Resin", "wikipedia_extract": "A resin is a solid or highly viscous liquid that can be converted into a polymer. Resins may be biological or synthetic in origin, but are typically harvested from plants. Resins are mixtures of organic compounds insoluble in water, predominantly terpenes. Technically, resins should not be confused with gums, which consist predominantly of water-soluble polysaccharides, although these two terms are often interchangeable in the less formal context. Common resins include pine oleoresins, amber, hashish, frankincense, myrrh and the animal-derived resin, shellac. Resins are used in varnishes, adhesives, food additives, incenses and perfumes."}}, {"canonical_name": "Constantinopla", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 17, "members": [{"entity_id": "constantinopla", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "constantinopla", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["constantinopla"], "contexts": ["city where chocolate is known"]}, {"entity_id": "constantinople", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Constantinople", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Constantinople"], "contexts": ["city where slave trade occurs"]}, {"entity_id": "constantinopla", "book_id": "coloquios_da_orta_1563", "name": "Constantinopla", "category": "PLACE", "subcategory": "CITY", "count": 13, "variants": ["Constantinopla", "Constantinopola"], "contexts": ["city mentioned in the text", "city, also called Rome"]}, {"entity_id": "constantinopla", "book_id": "polyanthea_medicinal", "name": "Constantinopla", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Constantinopla", "Constantinoplahouve"], "contexts": ["city where plagues occurred", "city where plague caused delusions"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "constantinopla", "target_book": "coloquios_da_orta_1563", "target_name": "Constantinopla", "similarity": 0.788}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "constantinopla", "target_book": "polyanthea_medicinal", "target_name": "Constantinopla", "similarity": 0.788}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Constantinople", "target_book": "coloquios_da_orta_1563", "target_name": "Constantinopla", "similarity": 0.984}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Constantinople", "target_book": "polyanthea_medicinal", "target_name": "Constantinopla", "similarity": 0.984}, {"source_book": "coloquios_da_orta_1563", "source_name": "Constantinopla", "target_book": "polyanthea_medicinal", "target_name": "Constantinopla", "similarity": 1.0}], "id": 522, "stable_key": "clu_2509c4f87f383dd7", "ground_truth": {"modern_name": "Constantinople", "confidence": "high", "type": "place", "description": "Historic city, formerly the capital of the Byzantine and Ottoman Empires.", "wikipedia_extract": "Constantinople (see other names) was a historical city located on the Bosporus, which served as the capital of the Roman, Byzantine, Latin, and Ottoman empires between its consecration in 330 and the formal abolition of the Ottoman sultanate in 1922. Constantinople was founded in 324, initially as New Rome, during the reign of Constantine the Great on the site of the existing settlement of Byzantium and in 330 became the capital of the Roman Empire. Following the collapse of the Western Roman Empire in the late 5th century, Constantinople remained the capital of the  Eastern Roman Empire (also known as the Byzantine Empire; 330\u20131204 and 1261\u20131453), the Latin Empire (1204\u20131261), and the Ottoman Empire (1453\u20131922). In the aftermath of the Turkish War of Independence, the Turkish capital moved to Ankara. The city was officially renamed Istanbul on 28 March 1930. As of December 2025, it is the most populous city in Europe, with a population of more than 16 million residents, straddling the Bosporus Strait and lying in both Europe and Asia, and is the financial beneficiary of Turkey."}}, {"canonical_name": "nitrogen", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 17, "members": [{"entity_id": "nitro", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "nitro", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nitro"], "contexts": ["substance related to saltpeter"]}, {"entity_id": "nitrogen", "book_id": "kosmos_humboldt_1845", "name": "nitrogen", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 7, "variants": ["nitrogen"], "contexts": ["chemical element in the atmosphere", "component of the atmosphere"]}, {"entity_id": "nitrogenous", "book_id": "kosmos_humboldt_1845", "name": "nitrogenous", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nitrogenous"], "contexts": ["content of swimming bladders"]}, {"entity_id": "nitrogen", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Nitrogen", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["Nitrogen", "nitrogen"], "contexts": ["component gas of the atmosphere", "element in atmosphere consumed by plants"]}, {"entity_id": "nitrogen", "book_id": "first_principles_spencer_1862", "name": "nitrogen", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["nitrogen"], "contexts": ["small quantities in plants", "element in Fibrine composition"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "nitro", "target_book": "kosmos_humboldt_1845", "target_name": "nitrogen", "similarity": 0.902}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "nitro", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Nitrogen", "similarity": 0.902}, {"source_book": "kosmos_humboldt_1845", "source_name": "nitrogen", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Nitrogen", "similarity": 0.995}, {"source_book": "kosmos_humboldt_1845", "source_name": "nitrogen", "target_book": "first_principles_spencer_1862", "target_name": "nitrogen", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "nitrogenous", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Nitrogen", "similarity": 0.933}, {"source_book": "kosmos_humboldt_1845", "source_name": "nitrogenous", "target_book": "first_principles_spencer_1862", "target_name": "nitrogen", "similarity": 0.94}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Nitrogen", "target_book": "first_principles_spencer_1862", "target_name": "nitrogen", "similarity": 0.995}], "id": 523, "stable_key": "clu_04324929190b48