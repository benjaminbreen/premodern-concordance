_principles_spencer_1862", "target_name": "bodily movement", "similarity": 0.917}], "id": 6102, "stable_key": "clu_cd4b8d244151bb08", "ground_truth": {"modern_name": "Motion", "confidence": "high", "type": "concept", "note": "The phrases 'motions of bodies' and 'bodily movement' describe the physical concept of motion.", "wikidata_id": "Q79782", "wikidata_description": "change in position of an object over time; a body is said to be in motion if it changes its position or orientation with respect to its immediate surroundings", "wikipedia_url": "https://en.wikipedia.org/wiki/Motion"}}, {"canonical_name": "absorbed heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "absorbed_heat", "book_id": "connexion_physical_sciences_somerville_1858", "name": "absorbed heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["absorbed heat"], "contexts": ["heat used for phase change"]}, {"entity_id": "absorption_of_heat", "book_id": "first_principles_spencer_1862", "name": "absorption of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["absorption of heat"], "contexts": ["process of taking in thermal energy"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "absorbed heat", "target_book": "first_principles_spencer_1862", "target_name": "absorption of heat", "similarity": 0.912}], "id": 6103, "stable_key": "clu_adb1fddb8bf57027", "ground_truth": {"modern_name": "Heat absorption", "confidence": "high", "type": "concept", "wikidata_id": "Q127092433", "wikidata_description": "scholarly article"}}, {"canonical_name": "deoxidation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "deoxidation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "deoxidation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["deoxidation"], "contexts": ["removal of oxygen"]}, {"entity_id": "de-oxidation", "book_id": "first_principles_spencer_1862", "name": "de-oxidation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["de-oxidation"], "contexts": ["process of vegetal life"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "deoxidation", "target_book": "first_principles_spencer_1862", "target_name": "de-oxidation", "similarity": 0.983}], "id": 6104, "stable_key": "clu_42d0bf48bc2ae1f9-2", "ground_truth": {"modern_name": "Oxidation", "confidence": "high", "type": "concept", "wikidata_id": "Q484152", "wikidata_description": "number that describes degree of oxidation of an atom in a chemical compound; the hypothetical charge that an atom would have if all bonds to atoms of different elements were fully ionic", "wikipedia_url": "https://en.wikipedia.org/wiki/Oxidation_state", "wikipedia_extract": "In chemistry, the oxidation state, or oxidation number, is the hypothetical charge of an atom if all of its bonds to other atoms are fully ionic. It describes the degree of oxidation (loss of electrons) of an atom in a chemical compound. Conceptually, the oxidation state may be positive, negative or zero. Beside nearly-pure ionic bonding, many covalent bonds exhibit a strong ionicity, making oxidation state a useful predictor of charge. The oxidation state of an atom does not represent the \"real\" charge on that atom, or any other actual atomic property. This is particularly true of high oxidation states, where the ionization energy required to produce a multiply positive ion is far greater than the energies available in chemical reactions."}}, {"canonical_name": "temporary magnet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "temporary_magnet", "book_id": "connexion_physical_sciences_somerville_1858", "name": "temporary magnet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["temporary magnet"], "contexts": ["magnet that loses magnetism"]}, {"entity_id": "permanent_magnet", "book_id": "first_principles_spencer_1862", "name": "permanent magnet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["permanent magnet"], "contexts": ["rotation generates electric currents"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "temporary magnet", "target_book": "first_principles_spencer_1862", "target_name": "permanent magnet", "similarity": 0.912}], "id": 6105, "stable_key": "clu_796ca063ac9823d7", "ground_truth": {"modern_name": "Temporary magnet", "confidence": "high", "type": "object"}}, {"canonical_name": "decennial period", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "decennial_period", "book_id": "connexion_physical_sciences_somerville_1858", "name": "decennial period", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["decennial period"], "contexts": ["ten-year cycle of magnetic activity"]}, {"entity_id": "decennial", "book_id": "first_principles_spencer_1862", "name": "decennial", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["decennial"], "contexts": ["occurring every ten years"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "decennial period", "target_book": "first_principles_spencer_1862", "target_name": "decennial", "similarity": 0.917}], "id": 6106, "stable_key": "clu_aad114e7ef60b1e7", "ground_truth": {"modern_name": "Decade", "confidence": "high", "type": "concept", "wikidata_id": "Q39911", "wikidata_description": "period of 10 years", "wikipedia_url": "https://en.wikipedia.org/wiki/Decade", "wikipedia_extract": "A decade (from Ancient Greek: \u03b4\u03b5\u03ba\u03ac\u03c2, dekas, lit. 'group of 10') is a period of 10 years. It may also be called a decennium (from Latin: decennium, lit. 'ten-year'). Decades may describe any ten-year period, such as those of a person's life, or refer to specific groupings of calendar years. Any period of ten years is a 'decade' or 'decennium'."}}, {"canonical_name": "fluid masses", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fluid_masses", "book_id": "connexion_physical_sciences_somerville_1858", "name": "fluid masses", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["fluid masses"], "contexts": ["gaseous or plasma-like material"]}, {"entity_id": "masses_of_matter", "book_id": "first_principles_spencer_1862", "name": "Masses of matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Masses of matter"], "contexts": ["collections of physical substance"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "fluid masses", "target_book": "first_principles_spencer_1862", "target_name": "Masses of matter", "similarity": 0.909}], "id": 6107, "stable_key": "clu_5f2d5ee83971533b-2", "ground_truth": {"modern_name": "Mass", "confidence": "high", "type": "concept", "note": "Refers to the physical property of matter or collections of matter.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Mass", "wikipedia_extract": "Mass is an intrinsic property of a body. In modern physics, it is generally defined as the strength of an object's gravitational attraction to other bodies - as measured by an observer moving along at the same speed. It was traditionally believed to be related to the quantity of matter in a body, until the discovery of the atom and particle physics. It was found that different atoms and different elementary particles, theoretically with the same amount of matter, have nonetheless different masses. Mass in modern physics has multiple definitions which are conceptually distinct, but physically equivalent. Mass can be experimentally defined as a measure of the body's inertia, meaning the resistance to acceleration (change of velocity) when a net force is applied."}}, {"canonical_name": "void", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "void", "book_id": "connexion_physical_sciences_somerville_1858", "name": "void", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["void"], "contexts": ["empty space devoid of matter"]}, {"entity_id": "void", "book_id": "first_principles_spencer_1862", "name": "void", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["void"], "contexts": ["empty space"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "void", "target_book": "first_principles_spencer_1862", "target_name": "void", "similarity": 1.0}], "id": 6108, "stable_key": "clu_cc066da863533a5f-2", "ground_truth": {"modern_name": "vacuum", "confidence": "high", "type": "concept", "note": "The term 'va\u0301sos' appears to be a corruption or variant of 'vasos' (vessels), which in a medical context could refer to blood vessels or lymphatics, or it might be a misreading of 'vacuo' or a related concept. However, the dominant context for 'vacuo' and 'in vacuo' points strongly to the physical concept of a vacuum.", "wikidata_id": "Q101674", "wikidata_description": "device that uses air to suck up dirt and other substances", "wikipedia_url": "https://en.wikipedia.org/wiki/Vacuum%20cleaner", "wikipedia_extract": "A vacuum (pl.: vacuums or vacua) is  space devoid of matter. The word is derived from the Latin adjective vacuus (neuter vacuum) meaning \"vacant\" or \"void\". An approximation to such vacuum is a region with a gaseous pressure much less than atmospheric pressure. Physicists often discuss ideal test results that would occur in a perfect vacuum, which they sometimes simply call \"vacuum\" or free space, and use the term partial vacuum to refer to an actual imperfect vacuum as one might have in a laboratory or in space. In engineering and applied physics on the other hand, vacuum refers to any space in which the pressure is considerably lower than atmospheric pressure. The Latin term in vacuo is used to describe an object that is surrounded by a vacuum."}}, {"canonical_name": "laws of planetary motions", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "laws_of_planetary_motions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "laws of planetary motions", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["laws of planetary motions"], "contexts": ["describing celestial body movement"]}, {"entity_id": "laws_of_motion", "book_id": "first_principles_spencer_1862", "name": "laws of motion", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["laws of motion"], "contexts": ["fundamental principles of mechanics"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "laws of planetary motions", "target_book": "first_principles_spencer_1862", "target_name": "laws of motion", "similarity": 0.897}], "id": 6109, "stable_key": "clu_3fb3f61b54e39506", "ground_truth": {"modern_name": "Laws of planetary motion", "confidence": "high", "type": "concept"}}, {"canonical_name": "sponges", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sponges", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sponges", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["sponges"], "contexts": ["aquatic invertebrates"]}, {"entity_id": "sponges", "book_id": "first_principles_spencer_1862", "name": "sponges", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["sponges"], "contexts": ["marine invertebrates"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "sponges", "target_book": "first_principles_spencer_1862", "target_name": "sponges", "similarity": 1.0}], "id": 6110, "stable_key": "clu_64f7ecb494b2718f-2", "ground_truth": {"modern_name": "Sponge", "confidence": "high", "type": "animal", "note": "Refers to sponges as organisms, aquatic invertebrates, and marine invertebrates. One context mentions a sponge swelling in the stomach, possibly referring to a medicinal preparation or a misidentification.", "wikidata_id": "Q18960", "wikidata_description": "phylum of animals", "wikipedia_extract": "Sponges or sea sponges are primarily marine invertebrates of the animal phylum Porifera (; meaning 'pore bearer'). They are sessile filter feeders that are bound to the seabed, and are one of the most ancient members of macrobenthos, with many historical species being important reef-building organisms. Sponges are multicellular organisms consisting of jelly-like mesohyl sandwiched between two thin layers of cells, and usually have tube-like bodies full of pores and channels that allow water to circulate through them. They have unspecialized cells that can transform into other types and that often migrate between the main cell layers and the mesohyl in the process. They do not have complex nervous, digestive or circulatory systems. Instead, most rely on maintaining a constant water flow through their bodies to obtain food and oxygen and to remove wastes, usually via flagella movements of the so-called \"collar cells\".", "wikipedia_url": "https://en.wikipedia.org/wiki/Sponge"}}, {"canonical_name": "lunar attraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "lunar_attraction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "lunar attraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["lunar attraction"], "contexts": ["effects on equinoctial points"]}, {"entity_id": "lunar_attraction", "book_id": "first_principles_spencer_1862", "name": "lunar attraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["lunar attraction"], "contexts": ["force causing tides and precession"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "lunar attraction", "target_book": "first_principles_spencer_1862", "target_name": "lunar attraction", "similarity": 1.0}], "id": 6111, "stable_key": "clu_43b4d96b8d3190ae", "ground_truth": {"modern_name": "Lunar attraction", "confidence": "high", "type": "concept"}}, {"canonical_name": "electric heat", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "electric_heat", "book_id": "connexion_physical_sciences_somerville_1858", "name": "electric heat", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["electric heat"], "contexts": ["electric heat tested by"]}, {"entity_id": "artificial_heat", "book_id": "first_principles_spencer_1862", "name": "artificial heat", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["artificial heat"], "contexts": ["heat generated by human means"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "electric heat", "target_book": "first_principles_spencer_1862", "target_name": "artificial heat", "similarity": 0.9}], "id": 6112, "stable_key": "clu_16d317624be8a60e", "ground_truth": {"modern_name": "Artificial heat", "confidence": "high", "type": "concept", "note": "The term 'electric heat' in the context of Somerville (1858) and Spencer (1862) refers to heat generated by non-natural, human-made processes, which can include electrical means, but also other forms of artificial generation. 'Artificial heat' is a more encompassing and appropriate modern term.", "wikidata_id": "Q28128222", "wikidata_description": "state of high relative temperature, often said about body temperature, weather or objects"}}, {"canonical_name": "Metallic surfaces", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "metallic_surfaces", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Metallic surfaces", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Metallic surfaces"], "contexts": ["surfaces reflecting polarized light"]}, {"entity_id": "metallic_surfaces", "book_id": "first_principles_spencer_1862", "name": "metallic surfaces", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["metallic surfaces"], "contexts": ["surfaces of metals"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Metallic surfaces", "target_book": "first_principles_spencer_1862", "target_name": "metallic surfaces", "similarity": 0.987}], "id": 6113, "stable_key": "clu_5f27c3e1cbf85369", "ground_truth": {"modern_name": "Metal surfaces", "confidence": "high", "type": "mineral", "note": "The term 'Metallic surfaces' directly refers to the surfaces of metals, a material category.", "wikidata_id": "Q124609714", "wikidata_description": "US patent 11377568"}}, {"canonical_name": "undulating column of air", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "undulating_column_of_air", "book_id": "connexion_physical_sciences_somerville_1858", "name": "undulating column of air", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["undulating column of air"], "contexts": ["wave-like air movement"]}, {"entity_id": "columns_of_air", "book_id": "first_principles_spencer_1862", "name": "columns of air", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["columns of air"], "contexts": ["air in a confined space"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "undulating column of air", "target_book": "first_principles_spencer_1862", "target_name": "columns of air", "similarity": 0.909}], "id": 6114, "stable_key": "clu_49cc71e923faef62", "ground_truth": {"modern_name": "Air column", "confidence": "high", "type": "concept", "note": "This refers to a confined body or movement of air, described as undulating, which is a physical concept in acoustics and fluid dynamics."}}, {"canonical_name": "vibrations in the air", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "vibrations_in_the_air", "book_id": "connexion_physical_sciences_somerville_1858", "name": "vibrations in the air", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vibrations in the air"], "contexts": ["passing over Pan's pipes"]}, {"entity_id": "aerial_vibrations", "book_id": "first_principles_spencer_1862", "name": "aerial vibrations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["aerial vibrations"], "contexts": ["waves in the air"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "vibrations in the air", "target_book": "first_principles_spencer_1862", "target_name": "aerial vibrations", "similarity": 0.968}], "id": 6115, "stable_key": "clu_b7a8a9d35ba69b8b", "ground_truth": {"modern_name": "Sound waves", "confidence": "high", "type": "concept", "note": "The context of 'vibrations in the air' and 'aerial vibrations' passing over 'Pan's pipes' strongly suggests the concept of sound waves, which are mechanical waves traveling through a medium like air.", "wikidata_id": "Q3882459", "wikidata_description": "longitudinal wave that propagates by means of adiabatic compression and decompression;travels with the speed of sound which depends on the medium they're passing through"}}, {"canonical_name": "Protoxides of metals", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "protoxides_of_metals", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Protoxides of metals", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Protoxides of metals"], "contexts": ["metal compounds with crystals"]}, {"entity_id": "protoxides", "book_id": "first_principles_spencer_1862", "name": "protoxides", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["protoxides"], "contexts": ["oxides with one atom of oxygen"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Protoxides of metals", "target_book": "first_principles_spencer_1862", "target_name": "protoxides", "similarity": 0.913}], "id": 6116, "stable_key": "clu_df03be0aa61dc3ee", "ground_truth": {"modern_name": "Metal oxides", "confidence": "high", "type": "chemical", "note": "Protoxides are a specific type of metal oxide, with 'metal oxides' being the broader modern category.", "wikidata_id": "Q1795231", "wikidata_description": "binary chemical compound of a metallic element and oxygen", "wikipedia_url": "https://fr.wikipedia.org/wiki/Oxyde_m%C3%A9tallique", "wikipedia_extract": "Un oxyde m\u00e9tallique est un compos\u00e9 chimique de l'oxyg\u00e8ne et d'un m\u00e9tal. En raison de la diff\u00e9rence d'\u00e9lectron\u00e9gativit\u00e9 entre les m\u00e9taux (\u00e9lectropositifs) et l'oxyg\u00e8ne (fortement \u00e9lectron\u00e9gatif), ces compos\u00e9s sont pour la plupart ioniques (constitu\u00e9s d'anions oxyde et de cations m\u00e9talliques) ou du moins fortement polaires. Un grand nombre d'oxydes m\u00e9talliques, \u00e0 l'exception notable de ceux des m\u00e9taux alcalins, sont connus sous la forme de min\u00e9raux. La corrosion des m\u00e9taux expos\u00e9s \u00e0 l'air les transforme aussi g\u00e9n\u00e9ralement en oxydes (mais aussi en hydroxydes, parfois en sulfures ou en carbonates). Les oxydes m\u00e9talliques, pr\u00e9sents dans les minerais, sont la mati\u00e8re premi\u00e8re de la m\u00e9tallurgie : c'est \u00e0 partir d'oxydes que sont \u00e9labor\u00e9s les m\u00e9taux. Les oxydes m\u00e9talliques donnent de la couleur aux poteries, le verre, aux fus\u00e9es de feu d'artifice ou aux \u00e9maux."}}, {"canonical_name": "luminous ether", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "luminous_ether", "book_id": "connexion_physical_sciences_somerville_1858", "name": "luminous ether", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["luminous ether"], "contexts": ["hypothetical medium for light"]}, {"entity_id": "luminiferous_ether", "book_id": "first_principles_spencer_1862", "name": "luminiferous ether", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["luminiferous ether"], "contexts": ["hypothetical medium for light"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "luminous ether", "target_book": "first_principles_spencer_1862", "target_name": "luminiferous ether", "similarity": 0.972}], "id": 6117, "stable_key": "clu_4aacd6130070b8e1-4", "ground_truth": {"modern_name": "luminiferous aether", "confidence": "high", "type": "concept", "note": "Historically, this referred to a hypothetical medium for light and electromagnetic waves. It was later superseded by the concept of spacetime.", "wikidata_id": "Q208702", "wikidata_description": "postulated medium for the propagation of light"}}, {"canonical_name": "Table-lands", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "table-lands", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Table-lands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Table-lands"], "contexts": ["high table-lands influence on atmosphere"]}, {"entity_id": "table-lands", "book_id": "first_principles_spencer_1862", "name": "table-lands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["table-lands"], "contexts": ["elevated flat areas of land"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Table-lands", "target_book": "first_principles_spencer_1862", "target_name": "table-lands", "similarity": 0.97}], "id": 6118, "stable_key": "clu_d9271896ee0ca885", "ground_truth": {"modern_name": "plateau", "confidence": "high", "type": "place", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "law of motion", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "law_of_motion", "book_id": "connexion_physical_sciences_somerville_1858", "name": "law of motion", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["law of motion"], "contexts": ["principles governing movement"]}, {"entity_id": "law_of_direction_of_motion", "book_id": "first_principles_spencer_1862", "name": "law of direction of Motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["law of direction of Motion"], "contexts": ["principle governing motion's direction"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "law of motion", "target_book": "first_principles_spencer_1862", "target_name": "law of direction of Motion", "similarity": 0.912}], "id": 6119, "stable_key": "clu_a174657e17a4f4db-2", "ground_truth": {"modern_name": "laws of motion", "confidence": "high", "type": "concept", "note": "The cluster explicitly mentions 'law of motion' and 'law of direction of Motion', directly referring to Newton's laws of motion or similar principles governing movement.", "wikidata_id": "Q38433", "wikidata_description": "classical formulation of Mechanics by Isaac Newton"}}, {"canonical_name": "transits", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "transits", "book_id": "connexion_physical_sciences_somerville_1858", "name": "transits", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["transits"], "contexts": ["celestial event"]}, {"entity_id": "transit", "book_id": "first_principles_spencer_1862", "name": "transit", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["transit"], "contexts": ["act of passing through or across"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "transits", "target_book": "first_principles_spencer_1862", "target_name": "transit", "similarity": 0.93}], "id": 6120, "stable_key": "clu_f406c23b6d14b912", "ground_truth": {"modern_name": "transit (astronomy)", "confidence": "high", "type": "concept", "note": "The context of celestial bodies and passing around a central point strongly suggests astronomical transits, such as the transit of a planet across the face of the sun."}}]}