"zirconium"], "contexts": ["element sometimes found in granite"]}, {"entity_id": "zircon", "book_id": "connexion_physical_sciences_somerville_1858", "name": "zircon", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["zircon"], "contexts": ["positive crystal with one optic axis"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "zirconium", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "zircon", "similarity": 0.965}], "id": 5920, "stable_key": "clu_3628a267d63361a7", "ground_truth": {"modern_name": "zirconium", "confidence": "high", "type": "mineral", "note": "The term 'zircon' can refer to the mineral zircon or the element zirconium. Given the context of chemical actions, zirconium as an element is a plausible referent.", "wikidata_id": "Q178928", "wikidata_description": "mineral belonging to the group of nesosilicates"}}, {"canonical_name": "chemical experiments", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "chemical_experiments", "book_id": "kosmos_humboldt_1845", "name": "chemical experiments", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["chemical experiments"], "contexts": ["used to study rock transformation"]}, {"entity_id": "chemical_experiment", "book_id": "first_principles_spencer_1862", "name": "chemical experiment", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["chemical experiment"], "contexts": ["experiment involving chemical reactions"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "chemical experiments", "target_book": "first_principles_spencer_1862", "target_name": "chemical experiment", "similarity": 0.899}], "id": 5921, "stable_key": "clu_12d368c012c68d44", "ground_truth": {"modern_name": "chemical experiment", "confidence": "high", "type": "concept", "wikidata_id": "Q60234794", "wikidata_description": "chemistry classroom experiments"}}, {"canonical_name": "peroxyd of iron", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "peroxyd_of_iron", "book_id": "kosmos_humboldt_1845", "name": "peroxyd of iron", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["peroxyd of iron"], "contexts": ["coloring agent for silica"]}, {"entity_id": "peroxide_and_protoxide_of_iron", "book_id": "connexion_physical_sciences_somerville_1858", "name": "peroxide and protoxide of iron", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["peroxide and protoxide of iron"], "contexts": ["components of loadstone"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "peroxyd of iron", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "peroxide and protoxide of iron", "similarity": 0.906}], "id": 5922, "stable_key": "clu_557509d95a927d52", "ground_truth": {"modern_name": "Iron oxides", "confidence": "high", "type": "chemical", "note": "The early modern terms 'peroxyd of iron' and 'protoxide of iron' refer to different oxidation states of iron, collectively understood today as iron oxides."}}, {"canonical_name": "red oxyd of iron", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "red_oxyd_of_iron", "book_id": "kosmos_humboldt_1845", "name": "red oxyd of iron", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["red oxyd of iron"], "contexts": ["mineral form of iron"]}, {"entity_id": "oxide_of_iron", "book_id": "connexion_physical_sciences_somerville_1858", "name": "oxide of iron", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["oxide of iron"], "contexts": ["compound losing magnetism at dull red heat"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "red oxyd of iron", "target_book": "