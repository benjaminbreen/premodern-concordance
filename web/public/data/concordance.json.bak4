: 0.894}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "man", "target_book": "origin_of_species_darwin_1859", "target_name": "male", "similarity": 0.911}], "id": 1106, "stable_key": "clu_82b1e1573626b441", "ground_truth": {"modern_name": "Human male", "confidence": "high", "type": "concept", "note": "The cluster encompasses discussions of 'man', 'Male', and 'male' in the context of biological sex and the human species.", "wikidata_id": "Q6581097", "wikidata_description": "to be used in \"sex or gender\" (P21) to indicate that the human subject is a male or \"semantic gender\" (P10339) to indicate that a word refers to a male person"}}, {"canonical_name": "Indie", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "indies", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Indies", "category": "PLACE", "subcategory": "COUNTRY", "count": 6, "variants": ["Indies"], "contexts": ["destination for northern passage", "historical term for Asia"]}, {"entity_id": "indie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Indie", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Indie"], "contexts": ["rich part of the world"]}, {"entity_id": "indie", "book_id": "ricettario_fiorentino_1597", "name": "Indie", "category": "PLACE", "subcategory": "COUNTRY", "count": 8, "variants": ["Indie", "India", "india", "\u00ccndia"], "contexts": ["the Indies", "region of origin for aloe wood"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Indies", "target_book": "ricettario_fiorentino_1597", "target_name": "Indie", "similarity": 0.974}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Indie", "target_book": "ricettario_fiorentino_1597", "target_name": "Indie", "similarity": 0.881}], "id": 1107, "stable_key": "clu_f13b617f6c0f0df6-3", "ground_truth": {"modern_name": "Asia", "confidence": "high", "type": "place", "country": "Asia", "wikidata_id": "Q210718", "wikidata_description": "Roman province", "wikipedia_url": "https://en.wikipedia.org/wiki/Asia%20%28Roman%20province%29", "note": "Historically referred to a vast region of Asia, often encompassing South Asia and Southeast Asia.", "wikipedia_extract": "Asia (Ancient Greek: \u1f08\u03c3\u03af\u03b1) was a Roman province covering most of western Asia Minor (Anatolia, Turkey), which was created following the Roman Republic's annexation of the Attalid Kingdom in 133 BC. After the establishment of the Roman Empire by Augustus, it was the most prestigious senatorial province and was governed by a proconsul. That arrangement endured until the province was subdivided in the fourth century AD. The province was one of the richest of the Empire and was at peace for most of the Imperial period. It contained hundreds of largely self-governing Greek city-states, who competed fiercely with one another for status, through appeals to the Imperial authorities and the cultivation of prestigious cultural institutions such as festival games, religious cults, and oratory. The province of Asia originally consisted of the territories of Mysia, the Troad, Aeolis, Lydia, Ionia, Caria, and the land corridor through Pisidia to Pamphylia."}}, {"canonical_name": "Iceland", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "islande", "book_id": "epoques_nature_buffon_1778", "name": "Islande", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Islande"], "contexts": ["island with volcanoes indicating subsidence", "continent with a submerged landmass"]}, {"entity_id": "iceland", "book_id": "kosmos_humboldt_1845", "name": "Iceland", "category": "PLACE", "subcategory": "COUNTRY", "count": 12, "variants": ["Iceland"], "contexts": ["location of Thienemann's observations", "location with frequent lights"]}, {"entity_id": "iceland", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Iceland", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Iceland"], "contexts": ["island country in the North Atlantic"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Islande", "target_book": "kosmos_humboldt_1845", "target_name": "Iceland", "similarity": 0.904}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Islande", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Iceland", "similarity": 0.904}, {"source_book": "kosmos_humboldt_1845", "source_name": "Iceland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Iceland", "similarity": 1.0}], "id": 1108, "stable_key": "clu_2908d8e67bd220a9", "ground_truth": {"modern_name": "Iceland", "confidence": "high", "type": "place", "country": "Iceland"}}, {"canonical_name": "bitume", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "bitume", "book_id": "epoques_nature_buffon_1778", "name": "bitume", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["bitume"], "contexts": ["oily substance derived from plants/animals", "tar-like substance in water"]}, {"entity_id": "bitume", "book_id": "relation_historique_humboldt_vol3_1825", "name": "bitume", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["bitume", "bitume solide terreux"], "contexts": ["substance mixed with clay", "tar-like substance"]}, {"entity_id": "bitume", "book_id": "ricettario_fiorentino_1597", "name": "Bitume", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["bitume", "Bitume"], "contexts": ["substance amber is thought to be", "fragrant substance"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "bitume", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "bitume", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "bitume", "target_book": "ricettario_fiorentino_1597", "target_name": "Bitume", "similarity": 0.994}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "bitume", "target_book": "ricettario_fiorentino_1597", "target_name": "Bitume", "similarity": 0.994}], "id": 1109, "stable_key": "clu_1765d1b08508ec03", "ground_truth": {"modern_name": "Bitumen", "confidence": "high", "type": "mineral", "wikidata_id": "Q167510", "wikidata_description": "form of petroleum primarily used in road construction", "wikipedia_extract": "Shilajit (Sanskrit: \u0936\u093f\u0932\u093e\u091c\u093f\u0924\u094d) or Shilajatu (\u0936\u093f\u0932\u093e\u091c\u0924\u0941; lit. mountain/rock bitumen/lac), is an organic-mineral product of predominantly biological origin, formed at high altitudes on stony mountains, in sheltered crevices and caves. It is a blackish-brown powder or an exudate emerging between high mountain rocks, often found in the Altai Mountains, the Caucasus Mountains, the Himalayas (especially in India, Pakistan, Nepal, and the Tibetan Plateau), the Karakoram, the Pamir Mountains (primarily in Gorno-Badakhshan, Tajikistan), and countrywise in Afghanistan, Bhutan, Georgia, India (regions of Himachal Pradesh and Uttarakhand), Iran, Kyrgyzstan, Mongolia, Nepal, Russia, Central Asia and Africa. People living in these areas use shilajit in folk and non-traditional (alternative) medicine (Ayurveda, Chinese, Tibetan). Shilajit is sold both in dry extract form and in dietary supplements, but there is limited evidence that shilajit has any beneficial effects on human health. Some sources have been found in studies to contain hazardous heavy metals, including lead.", "wikipedia_url": "https://en.wikipedia.org/wiki/Bitumen"}}, {"canonical_name": "schiste argileux", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "schiste", "book_id": "epoques_nature_buffon_1778", "name": "schiste", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["schiste"], "contexts": ["metamorphosed clay rock", "shale layers"]}, {"entity_id": "schiste_argileux", "book_id": "relation_historique_humboldt_vol3_1825", "name": "schiste argileux", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["schiste argileux"], "contexts": ["type of schist formation", "type of rock"]}, {"entity_id": "schiste_aliunineux", "book_id": "relation_historique_humboldt_vol3_1825", "name": "schiste aliunineux", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["schiste aliunineux"], "contexts": ["type of schist formation"]}, {"entity_id": "argillaceous_schist", "book_id": "kosmos_humboldt_1845", "name": "argillaceous schist", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["argillaceous schist"], "contexts": ["schist derived from clayey material", "clay-rich rock"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "schiste", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "schiste argileux", "similarity": 0.902}, {"source_book": "epoques_nature_buffon_1778", "source_name": "schiste", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "schiste aliunineux", "similarity": 0.89}, {"source_book": "epoques_nature_buffon_1778", "source_name": "schiste", "target_book": "kosmos_humboldt_1845", "target_name": "argillaceous schist", "similarity": 0.882}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "schiste argileux", "target_book": "kosmos_humboldt_1845", "target_name": "argillaceous schist", "similarity": 0.927}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "schiste aliunineux", "target_book": "kosmos_humboldt_1845", "target_name": "argillaceous schist", "similarity": 0.891}], "id": 1110, "stable_key": "clu_313fedebe95a5322", "ground_truth": {"modern_name": "Argillaceous schist", "confidence": "high", "type": "mineral"}}, {"canonical_name": "Ancien Continent", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "ancien_continent", "book_id": "epoques_nature_buffon_1778", "name": "ancien continent", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["ancien continent"], "contexts": ["Europe, Asia, and Africa", "geographical term for Europe, Asia, Africa"]}, {"entity_id": "ancien_continent", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Ancien Continent", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 10, "variants": ["Ancien Continent", "Ancien", "Ancien-Continent", "Ancien-Monde", "ancien continent", "l'ancien continent"], "contexts": ["refers to the Old World", "referring to Europe and Asia"]}, {"entity_id": "old_continent", "book_id": "kosmos_humboldt_1845", "name": "Old Continent", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Old Continent", "old continent"], "contexts": ["historical term for Europe, Asia, Africa", "Europe"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "ancien continent", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Ancien Continent", "similarity": 0.944}, {"source_book": "epoques_nature_buffon_1778", "source_name": "ancien continent", "target_book": "kosmos_humboldt_1845", "target_name": "Old Continent", "similarity": 0.928}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ancien Continent", "target_book": "kosmos_humboldt_1845", "target_name": "Old Continent", "similarity": 0.966}], "id": 1111, "stable_key": "clu_448222932668ac69", "ground_truth": {"modern_name": "Old World", "confidence": "high", "type": "place", "country": "Global", "wikidata_id": "Q46871", "wikidata_description": "species of plant"}}, {"canonical_name": "Aries", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "aries", "book_id": "english_physician_1652", "name": "Aries", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["Aries"], "contexts": ["zodiac sign associated with Mars and head", "zodiac sign associated with Betony"]}, {"entity_id": "aries", "book_id": "polyanthea_medicinal", "name": "Aries", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Aries"], "contexts": ["zodiac sign"]}, {"entity_id": "aries", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Aries", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Aries"], "contexts": ["constellation marking the beginning of spring", "constellation for celestial reference"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Aries", "target_book": "polyanthea_medicinal", "target_name": "Aries", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Aries", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Aries", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Aries", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Aries", "similarity": 1.0}], "id": 1112, "stable_key": "clu_9da9d08cab7f656a", "ground_truth": {"modern_name": "Aries", "confidence": "high", "type": "concept", "description": "A zodiacal constellation associated with the month of April.", "wikipedia_extract": "Aries  is one of the constellations of the zodiac. It is located in the Northern celestial hemisphere between Pisces to the west and Taurus to the east. The name Aries is Latin for ram. Its traditional astrological symbol is  (\u2648\ufe0e). It is one of the 48 constellations described by the 2nd century astronomer Ptolemy, and remains one of the 88 modern constellations. It is a mid-sized constellation ranking 39th in overall size, with an area of 441 square degrees (1.1% of the celestial sphere)."}}, {"canonical_name": "avenca", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "avens", "book_id": "english_physician_1652", "name": "Avens", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Avens"], "contexts": ["plant with medicinal properties"]}, {"entity_id": "avenca", "book_id": "coloquios_da_orta_1563", "name": "avenca", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["avenca"], "contexts": ["herb used in medicine"]}, {"entity_id": "avenca", "book_id": "polyanthea_medicinal", "name": "avenca", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 13, "variants": ["avenca", "Avenca"], "contexts": ["herb used in decoction", "ingredient in decoction"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Avens", "target_book": "coloquios_da_orta_1563", "target_name": "avenca", "similarity": 0.882}, {"source_book": "english_physician_1652", "source_name": "Avens", "target_book": "polyanthea_medicinal", "target_name": "avenca", "similarity": 0.882}, {"source_book": "coloquios_da_orta_1563", "source_name": "avenca", "target_book": "polyanthea_medicinal", "target_name": "avenca", "similarity": 1.0}], "id": 1113, "stable_key": "clu_3bc6aca06bc0e821", "ground_truth": {"modern_name": "maidenhair fern", "confidence": "high", "type": "plant", "linnaean": "Adiantum spp.", "family": "Pteridaceae", "description": "A delicate fern genus, historically used in herbal remedies.", "note": "The English 'Avens' is a different plant (Geum spp.), but the contexts here strongly point to Avenca (maidenhair fern).", "wikipedia_extract": "Adiantum (), the maidenhair fern (not to be confused with the similar-looking maidenhair spleenwort fern), is a genus of about 250 species of ferns in the subfamily Vittarioideae of the family Pteridaceae, though some researchers place it in its own family, Adiantaceae. The genus name comes from Greek, meaning \"unwetted\", referring to the fronds' ability to shed water without becoming wet. They are distinctive in appearance, with dark, often black stipes and rachises, and bright green, often delicately cut leaf tissue. The sori are borne submarginally, and are covered by reflexed flaps of leaf tissue which resemble indusia. Dimorphism between sterile and fertile fronds is generally subtle. They generally prefer humus-rich, moist, well-drained sites, ranging from bottomland soils to vertical rock walls."}}, {"canonical_name": "Sicily", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "sicilia", "book_id": "english_physician_1652", "name": "Sicilia", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Sicilia"], "contexts": ["island where Hybla is located"]}, {"entity_id": "sicily", "book_id": "kosmos_humboldt_1845", "name": "Sicily", "category": "PLACE", "subcategory": "COUNTRY", "count": 13, "variants": ["Sicily"], "contexts": ["location where a comet was discovered", "southern Italian island"]}, {"entity_id": "sicilia", "book_id": "coloquios_da_orta_1563", "name": "Sicilia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Sicilia"], "contexts": ["island where anacardo was introduced"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Sicilia", "target_book": "kosmos_humboldt_1845", "target_name": "Sicily", "similarity": 0.903}, {"source_book": "english_physician_1652", "source_name": "Sicilia", "target_book": "coloquios_da_orta_1563", "target_name": "Sicilia", "similarity": 0.937}], "id": 1114, "stable_key": "clu_13aa74a4c5872a8c", "ground_truth": {"modern_name": "Sicily", "confidence": "high", "type": "place", "country": "Italy", "note": "The reference to Hybla, an ancient city in Sicily, and its Mediterranean location firmly identifies this island.", "wikidata_id": "Q1460", "wikidata_description": "island in the Mediterranean, region of Italy", "wikipedia_url": "https://en.wikipedia.org/wiki/Sicily", "wikipedia_extract": "Sicily (Italian and Sicilian: Sicilia) is an island in the central Mediterranean Sea and one of the twenty regions of Italy, situated south of the Italian Peninsula in continental Europe. With 4.7 million inhabitants, including 1.2 million in and around the capital city of Palermo, it is both the largest and most populous island in the Mediterranean Sea. Sicily's namesake is the Sicels, who inhabited the eastern part of the island during the Iron Age. Sicily has a rich and unique culture in arts, music, literature, cuisine, and architecture. Its most prominent landmark is Mount Etna, the tallest active volcano in Europe, and one of the most active in the world, currently 3,403 m (11,165 ft) high. The island has a typical Mediterranean climate."}}, {"canonical_name": "organisms", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "organisms", "book_id": "origin_of_species_darwin_1859", "name": "organisms", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 9, "variants": ["organisms"], "contexts": ["living beings", "living beings that change over time"]}, {"entity_id": "animal_organisms", "book_id": "kosmos_humboldt_1845", "name": "animal organisms", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["animal organisms"], "contexts": ["living creatures on Earth"]}, {"entity_id": "organisms", "book_id": "first_principles_spencer_1862", "name": "organisms", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["organisms"], "contexts": ["living beings", "living beings, plants and animals"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "organisms", "target_book": "kosmos_humboldt_1845", "target_name": "animal organisms", "similarity": 0.983}, {"source_book": "origin_of_species_darwin_1859", "source_name": "organisms", "target_book": "first_principles_spencer_1862", "target_name": "organisms", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "animal organisms", "target_book": "first_principles_spencer_1862", "target_name": "organisms", "similarity": 0.983}], "id": 1115, "stable_key": "clu_29d6365afb3ef2e3", "ground_truth": {"modern_name": "organisms", "confidence": "high", "type": "concept", "wikidata_id": "Q55983715", "wikidata_description": "organisms which have been assigned common names in addition to their taxon name"}}, {"canonical_name": "Galapagos Archipelago", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "galapagos_archipelago", "book_id": "origin_of_species_darwin_1859", "name": "Galapagos Archipelago", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["Galapagos archipelago", "Galapagos Archipelago"], "contexts": ["islands with distinct bird populations", "archipelago with endemic birds"]}, {"entity_id": "galapagos", "book_id": "origin_of_species_darwin_1859", "name": "Galapagos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Galapagos"], "contexts": ["islands related to America", "birds of"]}, {"entity_id": "galapagos_islands", "book_id": "origin_of_species_darwin_1859", "name": "Galapagos Islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Galapagos Islands"], "contexts": ["islands with peculiar land-birds and marine birds", "islands with reptiles and unique plants"]}, {"entity_id": "\u00eeles_galapagos", "book_id": "relation_historique_humboldt_vol3_1825", "name": "\u00eeles Galapagos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["\u00eeles Galapagos"], "contexts": ["Galapagos Islands"]}, {"entity_id": "galapagos", "book_id": "kosmos_humboldt_1845", "name": "Galapagos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Galapagos"], "contexts": ["volcanic island with augmented gravitation"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Galapagos Archipelago", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "\u00eeles Galapagos", "similarity": 0.973}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Galapagos Archipelago", "target_book": "kosmos_humboldt_1845", "target_name": "Galapagos", "similarity": 0.938}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Galapagos", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "\u00eeles Galapagos", "similarity": 0.944}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Galapagos", "target_book": "kosmos_humboldt_1845", "target_name": "Galapagos", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Galapagos Islands", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "\u00eeles Galapagos", "similarity": 0.99}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Galapagos Islands", "target_book": "kosmos_humboldt_1845", "target_name": "Galapagos", "similarity": 0.945}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "\u00eeles Galapagos", "target_book": "kosmos_humboldt_1845", "target_name": "Galapagos", "similarity": 0.944}], "id": 1116, "stable_key": "clu_c0b5abaa1396920f", "ground_truth": {"modern_name": "Galapagos Archipelago", "confidence": "high", "type": "place", "description": "A volcanic archipelago in the Pacific Ocean.", "wikipedia_extract": "The Gal\u00e1pagos Islands (Spanish: Islas Gal\u00e1pagos) are an archipelago of volcanic islands in the Eastern Pacific, located around the equator, 485 nautical miles (898 km; 558 mi) west of the mainland of South America. They form the Gal\u00e1pagos Province of the Republic of Ecuador, with a population of slightly over 33,000 (2020). The province is divided into the cantons of San Crist\u00f3bal, Santa Cruz, and Isabela, the three most populated islands in the chain. The Gal\u00e1pagos are famous for their large number of endemic species, which were studied by Charles Darwin in the 1830s and inspired his theory of evolution by means of natural selection. All of these islands are protected as part of Ecuador's Gal\u00e1pagos National Park and Marine Reserve. There is no firm evidence that Polynesians or the Indigenous peoples of South America reached the islands before their accidental discovery by Bishop Tom\u00e1s de Berlanga in 1535."}}, {"canonical_name": "vertebr\u00e6", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "vertebr\u00e6", "book_id": "origin_of_species_darwin_1859", "name": "vertebr\u00e6", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["vertebr\u00e6"], "contexts": ["bones of the spinal column", "bones forming the spinal column"]}, {"entity_id": "vertebras", "book_id": "polyanthea_medicinal", "name": "vertebras", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["vertebras", "vertebras do peyto"], "contexts": ["body part", "bones of the spine"]}, {"entity_id": "vertebr\u00e6", "book_id": "first_principles_spencer_1862", "name": "vertebr\u00e6", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["vertebr\u00e6"], "contexts": ["bones of the spinal column", "modifications of tissue bounding the canal"]}, {"entity_id": "vertebra", "book_id": "first_principles_spencer_1862", "name": "vertebra", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["vertebra"], "contexts": ["segment of the vertebral column"]}, {"entity_id": "vertebrae", "book_id": "first_principles_spencer_1862", "name": "vertebrae", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["vertebrae"], "contexts": ["bones of the spinal column"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "vertebr\u00e6", "target_book": "polyanthea_medicinal", "target_name": "vertebras", "similarity": 0.979}, {"source_book": "origin_of_species_darwin_1859", "source_name": "vertebr\u00e6", "target_book": "first_principles_spencer_1862", "target_name": "vertebr\u00e6", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "vertebr\u00e6", "target_book": "first_principles_spencer_1862", "target_name": "vertebra", "similarity": 0.966}, {"source_book": "origin_of_species_darwin_1859", "source_name": "vertebr\u00e6", "target_book": "first_principles_spencer_1862", "target_name": "vertebrae", "similarity": 0.988}, {"source_book": "polyanthea_medicinal", "source_name": "vertebras", "target_book": "first_principles_spencer_1862", "target_name": "vertebr\u00e6", "similarity": 0.979}, {"source_book": "polyanthea_medicinal", "source_name": "vertebras", "target_book": "first_principles_spencer_1862", "target_name": "vertebra", "similarity": 0.975}, {"source_book": "polyanthea_medicinal", "source_name": "vertebras", "target_book": "first_principles_spencer_1862", "target_name": "vertebrae", "similarity": 0.981}], "id": 1117, "stable_key": "clu_55104853da3f3649", "ground_truth": {"modern_name": "Vertebrae", "confidence": "high", "type": "concept", "note": "While 'vertebrae' refers to a specific anatomical structure, in the contexts provided, it functions as a concept related to anatomy and the structure of the body. The plurality indicates the general category rather than a single instance.", "wikidata_id": "Q3556237", "wikidata_description": "genus of algae"}}, {"canonical_name": "German", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "german", "book_id": "origin_of_species_darwin_1859", "name": "German", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["German"], "contexts": ["nationality of author"]}, {"entity_id": "german", "book_id": "principles_of_psychology_james_1890", "name": "German", "category": "PLACE", "subcategory": "COUNTRY", "count": 10, "variants": ["German"], "contexts": ["nationality of an author", "origin of philosophy and terminology"]}, {"entity_id": "german", "book_id": "kosmos_humboldt_1845", "name": "German", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["German"], "contexts": ["public the author offers work to", "nationality of plants"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "German", "target_book": "principles_of_psychology_james_1890", "target_name": "German", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "German", "target_book": "kosmos_humboldt_1845", "target_name": "German", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "German", "target_book": "kosmos_humboldt_1845", "target_name": "German", "similarity": 1.0}], "id": 1118, "stable_key": "clu_b8b6e936d75a95ce-3", "ground_truth": {"modern_name": "Germany", "confidence": "high", "type": "place", "description": "A European country, associated with philosophical movements and scientific debates.", "note": "Includes references to both the country and its nationality.", "wikipedia_extract": "Germany, officially the Federal Republic of Germany, is a country in Western and Central Europe. It lies between the Baltic Sea and the North Sea to the north with the Alps to the south. Its sixteen constituent states have a total population of over 82 million, making it the most populous member state of the European Union. Germany borders Denmark to the north; Poland and the Czech Republic to the east; Austria and Switzerland to the south; and France, Luxembourg, Belgium, and the Netherlands to the west. The nation's capital and most populous city is Berlin and its main financial centre is Frankfurt; the largest urban area is the Ruhr. Settlement in the territory of modern Germany began in the Lower Paleolithic, with various tribes inhabiting it from the Neolithic onward, chiefly the Celts, and Germanic tribes inhabiting the north."}}, {"canonical_name": "reumas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "reumas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "reumas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 6, "variants": ["reumas"], "contexts": ["rheumatism", "rheumatism corrected by salsafrax"]}, {"entity_id": "reumas", "book_id": "historia_medicinal_monardes_1574", "name": "reumas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 8, "variants": ["Reumas", "reumas"], "contexts": ["condition that resin helps", "rheumatism treated by the water"]}, {"entity_id": "reumati\u017fmo", "book_id": "polyanthea_medicinal", "name": "Reumati\u017fmo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Reumati\u017fmo"], "contexts": ["disease of the same genus as sciatica"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "reumas", "target_book": "historia_medicinal_monardes_1574", "target_name": "reumas", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "reumas", "target_book": "polyanthea_medicinal", "target_name": "Reumati\u017fmo", "similarity": 0.895}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "reumas", "target_book": "polyanthea_medicinal", "target_name": "Reumati\u017fmo", "similarity": 0.895}], "id": 1119, "stable_key": "clu_21f31330dae8802f-2", "ground_truth": {"modern_name": "Rheumatism", "confidence": "high", "type": "disease", "modern_term": "Rheumatism", "wikidata_id": "Q684924", "wikidata_description": "human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Rheumatism", "wikipedia_extract": "Rheumatism  (from the Ancient Greek \u1fe5\u03b5\u1fe6\u03bc\u03b1, rhe\u00fbma) or rheumatic disorders are conditions causing chronic, often intermittent pain affecting the joints or connective tissue. Rheumatism does not designate any specific disorder, but covers at least 200 different conditions, including arthritis and  \"non-articular rheumatism\", also known as \"regional pain syndrome\" or \"soft tissue rheumatism\". There is a close overlap between the term soft tissue disorder and rheumatism. Sometimes the term \"soft tissue rheumatic disorders\" is used to describe these conditions. The term \"Rheumatic Diseases\" is used in MeSH to refer to connective tissue disorders. The branch of medicine devoted to the diagnosis and therapy of rheumatism is called rheumatology.", "description": "Inflammatory condition causing pain and stiffness in joints."}}, {"canonical_name": "aves", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "aves", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "aves", "category": "ANIMAL", "subcategory": "BIRD", "count": 5, "variants": ["aves"], "contexts": ["birds", "birds, specifically a type of bird"]}, {"entity_id": "aves", "book_id": "coloquios_da_orta_1563", "name": "aves", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 6, "variants": ["aves"], "contexts": ["Birds", "birds that produce amber"]}, {"entity_id": "aves", "book_id": "polyanthea_medicinal", "name": "aves", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["Aves", "aves"], "contexts": ["birds", "poultry to avoid"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "aves", "target_book": "coloquios_da_orta_1563", "target_name": "aves", "similarity": 0.92}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "aves", "target_book": "polyanthea_medicinal", "target_name": "aves", "similarity": 0.92}, {"source_book": "coloquios_da_orta_1563", "source_name": "aves", "target_book": "polyanthea_medicinal", "target_name": "aves", "similarity": 1.0}], "id": 1120, "stable_key": "clu_0ef9fe73f17e29e3", "ground_truth": {"modern_name": "Birds", "confidence": "high", "type": "animal", "description": "Feathered vertebrates, including poultry and those producing ambergris.", "wikipedia_extract": "Birds are a group of warm-blooded theropod dinosaurs constituting the class Aves, characterised by feathers, toothless beaked jaws, the laying of hard-shelled eggs, a high metabolic rate, a four-chambered heart, and a strong yet lightweight skeleton. Birds live worldwide and range in size from the 5.5 cm (2.2 in) bee hummingbird to the 2.8 m (9 ft 2 in) common ostrich. There are over 11,000 living species and they are split into 44 orders. More than half are passerine or \"perching\" birds. Birds have wings whose development varies according to species; the only known groups without wings are the extinct moa and elephant birds. Wings, which are modified forelimbs, gave birds the ability to fly, although further evolution has led to the loss of flight in some birds, including ratites, penguins, and diverse endemic island species."}}, {"canonical_name": "Sancto Domingo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "santo_domingo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "santo Domingo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["santo Domingo"], "contexts": ["convent location"]}, {"entity_id": "santo_domingo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Santo Domingo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Santo Domingo"], "contexts": ["location with population count", "archbishopric"]}, {"entity_id": "sancto_domingo", "book_id": "historia_medicinal_monardes_1574", "name": "Sancto Domingo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 11, "variants": ["Sancto Domingo", "Don Domingo", "Sancdto Domingo", "Sando Domingo", "Santo Domingo", "Santo Domirz", "S\u00e1cto Domingo"], "contexts": ["location where Guayaci tree is abundant", "location of a Guayaci tree"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "santo Domingo", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Santo Domingo", "similarity": 0.965}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "santo Domingo", "target_book": "historia_medicinal_monardes_1574", "target_name": "Sancto Domingo", "similarity": 0.954}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Santo Domingo", "target_book": "historia_medicinal_monardes_1574", "target_name": "Sancto Domingo", "similarity": 0.917}], "id": 1121, "stable_key": "clu_2b02b8216a10fc1d-2", "ground_truth": {"modern_name": "Santo Domingo", "confidence": "high", "type": "place", "country": "Dominican Republic", "note": "The cluster includes references to 'Sancto Domingo' and 'S. Domingos', clearly pointing to the city, which was a significant colonial center and a source of botanical materials.", "wikidata_id": "Q55591", "wikidata_description": "municipality of the Philippines in the province of Nueva Ecija", "wikipedia_url": "https://en.wikipedia.org/wiki/Santo%20Domingo%2C%20Nueva%20Ecija", "wikipedia_extract": "Santo Domingo, officially the Municipality of Santo Domingo (Ilocano: Ili ti Santo Domingo; Pangasinan: Baley na Santo Domingo;Tagalog: Bayan ng Santo Domingo), is a municipality in the province of Nueva Ecija, Philippines. According to the 2024 census, it has a population of 63,750 people. The town is named after Saint Dominic, its patron saint. During the last quarter of the 17th century, Ilocos and Bulacan natives and Tagalogs from Cabanatuan migrated to Santo Domingo. They found in the settlement buri palms. Therefore, these people called the site, Pulong Buli."}}, {"canonical_name": "cap de Horn", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "cap_de_horn", "book_id": "relation_historique_humboldt_vol3_1825", "name": "cap de Horn", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 13, "variants": ["Cap de Horn", "cap de Horn"], "contexts": ["geographical point", "geographic point for navigation route"]}, {"entity_id": "cape_horn", "book_id": "kosmos_humboldt_1845", "name": "Cape Horn", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cape Horn"], "contexts": ["southern tip of South America"]}, {"entity_id": "cape_horn", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cape Horn", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cape Horn"], "contexts": ["southern tip of South America"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "cap de Horn", "target_book": "kosmos_humboldt_1845", "target_name": "Cape Horn", "similarity": 0.911}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "cap de Horn", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cape Horn", "similarity": 0.911}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cape Horn", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cape Horn", "similarity": 1.0}], "id": 1122, "stable_key": "clu_889a6e1389ae18d4", "ground_truth": {"modern_name": "Cape Horn", "confidence": "high", "type": "place", "country": "Chile", "wikidata_id": "Q5034867", "wikidata_description": "unincorporated community in Placer County, California"}}, {"canonical_name": "bananes", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "bananes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "bananes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 12, "variants": ["bananes"], "contexts": ["foodstuff", "fruit grown in the country"]}, {"entity_id": "banana", "book_id": "kosmos_humboldt_1845", "name": "banana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["banana"], "contexts": ["plant family in tropical regions", "plant requiring hot climate"]}, {"entity_id": "banana", "book_id": "connexion_physical_sciences_somerville_1858", "name": "banana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["banana"], "contexts": ["tropical fruit-bearing plant"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "bananes", "target_book": "kosmos_humboldt_1845", "target_name": "banana", "similarity": 0.921}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "bananes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "banana", "similarity": 0.921}, {"source_book": "kosmos_humboldt_1845", "source_name": "banana", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "banana", "similarity": 1.0}], "id": 1123, "stable_key": "clu_e7c0c40cde7c9fa1", "ground_truth": {"modern_name": "Bananas", "confidence": "low", "type": "plant", "description": "Tropical fruit-bearing plants.", "note": "The mention of 'beans' in the Darwin context seems an outlier and likely a misattribution or a secondary example. The dominant context is 'bananes'.", "wikipedia_extract": "A banana is an elongated, edible fruit\u2014botanically a berry\u2014produced by several kinds of large treelike herbaceous flowering plants in the genus Musa. In some countries, cooking bananas are called plantains, distinguishing them from dessert bananas. The fruit is variable in size, color and firmness, but is usually elongated and curved, with soft flesh rich in starch covered with a peel, which may have a variety of colors when ripe. It grows upward in clusters near the top of the plant. Almost all modern edible seedless (parthenocarp) cultivated bananas come from two wild species \u2013 Musa acuminata and Musa balbisiana, or their hybrids. Musa species are native to tropical Indomalaya and Australia; they were probably domesticated in New Guinea."}}, {"canonical_name": "men", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "men", "book_id": "principles_of_psychology_james_1890", "name": "men", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 7, "variants": ["men"], "contexts": ["humans with most complex nervous systems", "humans with hardly any lower brain centers"]}, {"entity_id": "men", "book_id": "kosmos_humboldt_1845", "name": "men", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["men"], "contexts": ["burned bones found in fire-heaps", "human beings"]}, {"entity_id": "men", "book_id": "first_principles_spencer_1862", "name": "men", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 6, "variants": ["men"], "contexts": ["human beings", "human beings in general"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "men", "target_book": "kosmos_humboldt_1845", "target_name": "men", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "men", "target_book": "first_principles_spencer_1862", "target_name": "men", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "men", "target_book": "first_principles_spencer_1862", "target_name": "men", "similarity": 1.0}], "id": 1124, "stable_key": "clu_00c2ba3d134db369", "ground_truth": {"modern_name": "Humans", "confidence": "high", "type": "concept", "note": "While 'men' historically referred to males, in these broader scientific contexts (psychology, natural philosophy), it is used to denote humankind or human beings in general."}}, {"canonical_name": "Phil. Trans.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "philos__trans_", "book_id": "principles_of_psychology_james_1890", "name": "Philos. Trans.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Philos. Trans."], "contexts": ["publication reference"]}, {"entity_id": "phil__trans_", "book_id": "kosmos_humboldt_1845", "name": "Phil. Trans.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["Phil. Trans."], "contexts": ["scientific journal publishing astronomical observations", "publication of the Royal Society"]}, {"entity_id": "philos__trans_", "book_id": "kosmos_humboldt_1845", "name": "Philos. Trans.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Philos. Trans."], "contexts": ["publication for astronomical data", "publication of the Royal Society"]}, {"entity_id": "phil__trans_", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Phil. Trans.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Phil. Trans."], "contexts": ["publication title"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Philos. Trans.", "target_book": "kosmos_humboldt_1845", "target_name": "Phil. Trans.", "similarity": 0.888}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Philos. Trans.", "target_book": "kosmos_humboldt_1845", "target_name": "Philos. Trans.", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Philos. Trans.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Phil. Trans.", "similarity": 0.888}, {"source_book": "kosmos_humboldt_1845", "source_name": "Phil. Trans.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Phil. Trans.", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Philos. Trans.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Phil. Trans.", "similarity": 0.888}], "id": 1125, "stable_key": "clu_0543de890d70bb10-2", "ground_truth": {"modern_name": "Philosophical Transactions of the Royal Society", "confidence": "high", "type": "text", "wikidata_id": "Q913162", "wikidata_description": "British scientific journal published by the Royal Society", "wikipedia_url": "https://en.wikipedia.org/wiki/Philosophical%20Transactions%20of%20the%20Royal%20Society", "note": "This refers to the scientific journal published by the Royal Society.", "wikipedia_extract": "Philosophical Transactions of the Royal Society is a scientific journal published by the Royal Society. In its earliest days, it was a private venture of the Royal Society's secretary. It was established in 1665, making it the second journal in the world exclusively devoted to science, after the Journal des s\u00e7avans, and therefore also the world's longest-running scientific journal. It became an official society publication in 1752. The use of the word philosophical in the title refers to natural philosophy, which was the equivalent of what would now be generally called science. In 1887 the journal expanded and divided into two separate publications, one serving the physical sciences (Philosophical Transactions of the Royal Society A: Mathematical, Physical and Engineering Sciences) and the other focusing on the life sciences (Philosophical Transactions of the Royal Society B: Biological Sciences)."}}, {"canonical_name": "Doctor", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "french_doctor", "book_id": "principles_of_psychology_james_1890", "name": "French doctor", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["French doctor"], "contexts": ["professed spirit control in trance phenomena"]}, {"entity_id": "doctor", "book_id": "historia_medicinal_monardes_1574", "name": "Doctor", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 13, "variants": ["Doctor", "Doctores"], "contexts": ["physician discussing patient care", "physician waiting for a patient"]}, {"entity_id": "dr_", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Dr.", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Dr."], "contexts": ["title of a medical professional"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "French doctor", "target_book": "historia_medicinal_monardes_1574", "target_name": "Doctor", "similarity": 0.856}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Doctor", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Dr.", "similarity": 0.967}], "id": 1126, "stable_key": "clu_0601e93830bed225", "ground_truth": {"modern_name": "doctor", "confidence": "high", "type": "person", "description": "Title for a medical professional or physician", "wikidata_id": "Q39631", "wikidata_description": "professional who practices medicine", "wikipedia_url": "https://en.wikipedia.org/wiki/Medical%20doctor"}}, {"canonical_name": "elasticity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "elasticity", "book_id": "principles_of_psychology_james_1890", "name": "elasticity", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["elasticity"], "contexts": ["property of returning to shape"]}, {"entity_id": "elastic_forces", "book_id": "kosmos_humboldt_1845", "name": "elastic forces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["elastic forces"], "contexts": ["forces that can return to original shape", "forces related to tension and compression"]}, {"entity_id": "elasticity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "elasticity", "category": "CONCEPT", "subcategory":