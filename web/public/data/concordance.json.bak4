: ["phrenological faculty for morality", "social affection arising from transferred pleasure"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "conscientes", "target_book": "principles_of_psychology_james_1890", "target_name": "Conscientiousness", "similarity": 0.893}, {"source_book": "english_physician_1652", "source_name": "Consci\u2223ence", "target_book": "principles_of_psychology_james_1890", "target_name": "Conscientiousness", "similarity": 0.901}], "id": 1821, "stable_key": "clu_23d7b68f9f0ef1f6", "ground_truth": {"modern_name": "Conscience", "confidence": "high", "type": "concept", "note": "Refers to the faculty of moral judgment or awareness."}}, {"canonical_name": "philosophie naturelle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "philosophie_naturelle", "book_id": "medecine_experimentale_bernard_1865", "name": "philosophie naturelle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["philosophie naturelle"], "contexts": ["study of the natural world"]}, {"entity_id": "philosophie_naturelle", "book_id": "epoques_nature_buffon_1778", "name": "philosophie naturelle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["philosophie naturelle"], "contexts": ["study of the natural world"]}, {"entity_id": "philosophie_naturelle", "book_id": "relation_historique_humboldt_vol3_1825", "name": "philosophie naturelle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["philosophie naturelle"], "contexts": ["natural philosophy", "field of study"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "philosophie naturelle", "target_book": "epoques_nature_buffon_1778", "target_name": "philosophie naturelle", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "philosophie naturelle", "target_book": "relatio