TANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["colirio"], "contexts": ["preparation applied to eyes"]}, {"entity_id": "col\u00edrio", "book_id": "coloquios_da_orta_1563", "name": "col\u00edrio", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["col\u00edrio"], "contexts": ["an eye medicine"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "colirio", "target_book": "coloquios_da_orta_1563", "target_name": "col\u00edrio", "similarity": 0.877}], "id": 5495, "stable_key": "clu_00ba2f2b7c4d2f57", "ground_truth": {"modern_name": "Eyedrop preparation", "confidence": "high", "type": "object", "note": "Colirio (colyrio) refers to an ophthalmic preparation, often a liquid or semi-solid, intended for application to the eyes.", "wikidata_id": "Q552308", "wikidata_description": "saline-containing liquid drug administered through the eye", "wikipedia_url": "https://en.wikipedia.org/wiki/Eye%20drop"}}, {"canonical_name": "enfermedades de los ri\u00f1ones", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "enfermedades_de_los_ri\u00f1ones", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "enfermedades de los ri\u00f1ones", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["enfermedades de los ri\u00f1ones"], "contexts": ["kidney diseases treated by salsafrax"]}, {"entity_id": "enfermedades_de_los_ri\u00f1ones", "book_id": "historia_medicinal_monardes_1574", "name": "enfermedades de los ri\u00f1ones", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["enfermedades de los ri\u00f1ones"], "contexts": ["kidney diseases"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "enfermedades de los ri\u00f1ones", "target_book": "historia_medicinal_monardes_1574", "target_name": "enfermedades de los ri\u00f1ones", "similarity": 1.0}], "id": 5496, "stable_key": "clu_df7b4ffa9eb67a1c", "ground_truth": {"modern_name": "Kidney diseases", "confidence": "high", "type": "disease", "modern_term": "Kidney diseases", "wikidata_id": "Q1054718", "wikidata_description": "urinary system disease that is located in the kidney", "wikipedia_url": "https://en.wikipedia.org/wiki/Kidney%20disease"}}, {"canonical_name": "pacientes", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pacientes", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "pacientes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["pacientes"], "contexts": ["individuals receiving medical care"]}, {"entity_id": "paciente", "book_id": "coloquios_da_orta_1563", "name": "PACIENTE", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["PACIENTE"], "contexts": ["interlocutor in a dialogue"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "pacientes", "target_book": "coloquios_da_orta_1563", "target_name": "PACIENTE", "similarity": 0.932}], "id": 5497, "stable_key": "clu_15caacfb2a3d3fbe", "ground_truth": {"modern_name": "patients", "confidence": "high", "type": "concept", "note": "This term refers to individuals receiving medical care or participants in dialogues about medicine. It is a general concept.", "wikidata_id": "Q181600", "wikidata_description": "person who takes a medical treatment or is subject of a case study", "wikipedia_url": "https://en.wikipedia.org/wiki/Patient"}}, {"canonical_name": "barbaros", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "barbaros", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "barbaros", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["barbaros"], "contexts": ["uncivilized people"]}, {"entity_id": "barbarian", "book_id": "first_principles_spencer_1862", "name": "barbarian", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["barbarian"], "contexts": ["term for a foreigner or uncivilized person"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "barbaros", "target_book": "first_principles_spencer_1862", "target_name": "barbarian", "similarity": 0.93}], "id": 5498, "stable_key": "clu_24db185d6f16ccb3", "ground_truth": {"modern_name": "foreigners", "confidence": "medium", "type": "concept", "note": "The term 'barbaros' in early modern texts often referred to those perceived as uncivilized or non-European, encompassing a range of meanings including foreigners and those from different cultures. 'Barbarian' carries a similar historical weight.", "wikidata_id": "Q473741", "wikidata_description": "person not having citizenship in a country", "wikipedia_url": "https://en.wikipedia.org/wiki/Alien%20%28law%29"}}, {"canonical_name": "medico doctos", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "medico_doctos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "medico doctos", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["medico doctos"], "contexts": ["learned medical practitioner"]}, {"entity_id": "docto", "book_id": "polyanthea_medicinal", "name": "Docto", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["Docto"], "contexts": ["experienced physician"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "medico doctos", "target_book": "polyanthea_medicinal", "target_name": "Docto", "similarity": 0.887}], "id": 5499, "stable_key": "clu_fb44f17ea5c0b9fc-2", "ground_truth": {"modern_name": "Doctor", "confidence": "high", "type": "person", "description": "A medical practitioner or physician", "wikidata_id": "Q39631", "wikidata_description": "professional who practices medicine", "wikipedia_url": "https://en.wikipedia.org/wiki/Medical%20doctor", "note": "The term 'Praticos' is a plural noun in Portuguese/Spanish, referring to experienced individuals or practitioners.", "wikipedia_extract": "A medical doctor, also known as a physician (American and Canadian English) or medical practitioner (British English), is a health professional who practices medicine. Medicine aims to promote, maintain or restore health through the study, diagnosis, prognosis and treatment of disease, injury, and other physical and mental conditions. Doctors may focus on certain disease categories, types of patients, and methods of treatment, known as specialities. Others work in general practice, providing continuing and comprehensive medical care to individuals, families. Medical practice requires both thorough knowledge of the medical sciences\u2014such as anatomy, physiology, diseases, and their treatment\u2014and strong competence in applying this knowledge in practice, which forms the art or craft of the profession. Both the role of doctors and the meaning of the word itself vary around the world."}}, {"canonical_name": "Chupiren", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "chupiren", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Chupiren", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Chupiren"], "contexts": ["place where the plant is called"]}, {"entity_id": "chuparipari", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Chuparipari", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Chuparipari"], "contexts": ["location of native alum"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Chupiren", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Chuparipari", "similarity": 0.89}], "id": 5500, "stable_key": "clu_0bb3b7d04618ea59", "ground_truth": {"modern_name": "Chupiren", "confidence": "high", "type": "place", "country": "Mexico", "note": "While 'Chuparipari' in Humboldt's work might refer to a different, though possibly related, location or indigenous group, 'Chupiren' in Hern\u00e1ndez's text specifically denotes a location associated with a plant."}}, {"canonical_name": "mordeduras de fieras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mordeduras_de_fieras", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "mordeduras de fieras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["mordeduras de fieras"], "contexts": ["bites from wild animals"]}, {"entity_id": "mordeduras_de_bichos_venenosos", "book_id": "polyanthea_medicinal", "name": "mordeduras de bichos venenosos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["mordeduras de bichos venenosos"], "contexts": ["bites of venomous creatures"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "mordeduras de fieras", "target_book": "polyanthea_medicinal", "target_name": "mordeduras de bichos venenosos", "similarity": 0.883}], "id": 5501, "stable_key": "clu_f21fca713d02d2a8", "ground_truth": {"modern_name": "animal bites", "confidence": "high", "type": "disease", "modern_term": "animal bites", "note": "This cluster covers bites from wild animals and venomous creatures, both falling under the general category of animal bites, which can lead to various medical conditions.", "wikidata_id": "Q54911704", "wikidata_description": "injuries inflicted by the teeth or poisoning caused by venoms of animals"}}, {"canonical_name": "casta\u00f1o", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "casta\u00f1o", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "casta\u00f1o", "category": "PLANT", "subcategory": 