{"entity_id": "robertus_boyle", "book_id": "polyanthea_medicinal", "name": "Robertus Boyle", "category": "PERSON", "subcategory": "SCHOLAR", "count": 8, "variants": ["Robertus Boyle", "Roberaus Boyle", "Roberto Boyle"], "contexts": ["author of Tenramina Physica", "author of 'de utilitate naturalis philosophiae'"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Charles Boyle", "target_book": "polyanthea_medicinal", "target_name": "Robertus Boyle", "similarity": 0.851}], "id": 2985, "stable_key": "clu_65c29e73e1708fdd", "ground_truth": {"modern_name": "Robert Boyle", "confidence": "high", "type": "person", "birth_year": 1627, "death_year": 1691, "description": "Anglo-Irish chemist, physicist, and philosopher, pioneer of experimental science.", "wikidata_id": "Q43393", "wikidata_description": "Anglo-Irish natural philosopher, chemist, physicist, and inventor"}}, {"canonical_name": "\u03b1 Lyr\u00e6", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "a_lyrae", "book_id": "kosmos_humboldt_1845", "name": "a Lyrae", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["a Lyrae"], "contexts": ["fixed star for light travel time measurement"]}, {"entity_id": "\u03b1_lyr\u00e6", "book_id": "connexion_physical_sciences_somerville_1858", "name": "\u03b1 Lyr\u00e6", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["\u03b1 Lyr\u00e6"], "contexts": ["star that will become polar star", "first magnitude star"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "a Lyrae", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "\u03b1 Lyr\u00e6", "similarity": 0.922}], "id": 2986, "stable_key": "clu_ce0bc094e5198ea0", "ground_truth": {"modern_name": "Alpha Lyrae", "confidence": "high", "type": "place", "wikidata_id": "Q3427", "wikidata_description": "star in the constellation Lyra", "wikipedia_extract": "A pole star is a visible star that is approximately aligned with the axis of rotation of an astronomical body; that is, a star whose apparent position is close to one of the celestial poles. On Earth, a pole star would lie directly overhead when viewed from the North or the South Pole. Currently, Earth's pole stars are Polaris (Alpha Ursae Minoris), a bright magnitude 2 star aligned approximately with its northern axis that serves as a pre-eminent star in celestial navigation, and a much dimmer magnitude 5.5 star on its southern axis, Polaris Australis (Sigma Octantis). From around 1700 BC until just after 300 AD, Kochab (Beta Ursae Minoris) and Pherkad (Gamma Ursae Minoris) were twin northern pole stars, though neither was as close to the pole as Polaris is now. In classical antiquity, Beta Ursae Minoris (Kochab) was closer to the celestial north pole than Alpha Ursae Minoris. While there was no naked-eye star close to the pole, the midpoint between Alpha and Beta Ursae Minoris was reasonably close to the pole, and it appears that the entire constellation of Ursa Minor, in antiquity known as Cynosura (Greek \u039a\u03c5\u03bd\u03cc\u03c3\u03bf\u03c5\u03c1\u03b1 \"dog's tail\"), was used as indicating the northern direction for the purposes of navigation by the Phoenicians.", "wikipedia_url": "https://en.wikipedia.org/wiki/Vega"}}, {"canonical_name": "dispersion of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "propagation_of_light", "book_id": "kosmos_humboldt_1845", "name": "propagation of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["propagation of light"], "contexts": ["fundamental physical process"]}, {"entity_id": "dispersion_of_light", "book_id": "connexion_physical_sciences_somerville_1858", "name": "dispersion of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["Dispersion of Light", "dispersion of light"], "contexts": ["splitting of light into colours", "according to undulatory theory"]}, {"entity_id": "propagation_of_light", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Propagation of Light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Propagation of Light"], "contexts": ["how light travels", "how light travels through space"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "propagation of light", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "dispersion of light", "similarity": 0.941}, {"source_book": "kosmos_humboldt_1845", "source_name": "propagation of light", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Propagation of Light", "similarity": 0.948}], "id": 2987, "stable_key": "clu_da9fe01ec0d7dad7", "ground_truth": {"modern_name": "dispersion of light", "confidence": "high", "type": "concept", "wikidata_id": "Q33430175", "wikidata_description": "scientific article"}}, {"canonical_name": "Professor Forbes", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "professor_e__forbes", "book_id": "kosmos_humboldt_1845", "name": "Professor E. Forbes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Professor E. Forbes"], "contexts": ["co-author of 'Travels in Lycia'"]}, {"entity_id": "professor_forbes", "book_id": "kosmos_humboldt_1845", "name": "Professor Forbes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Professor Forbes"], "contexts": ["remarks on distribution of faunas and floras"]}, {"entity_id": "forbes,_professor_e_", "book_id": "kosmos_humboldt_1845", "name": "Forbes, Professor E.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Forbes, Professor E."], "contexts": ["researcher on travels and islands"]}, {"entity_id": "forbes,_professor_j_", "book_id": "kosmos_humboldt_1845", "name": "Forbes, Professor J.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Forbes, Professor J."], "contexts": ["researcher on seismometers and flora"]}, {"entity_id": "professor_forbes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Professor Forbes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Professor Forbes"], "contexts": ["scientist who studied solar eclipse", "of Edinburgh, prosecuted subject with success"]}, {"entity_id": "forbes,_professor", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Forbes, Professor", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Forbes, Professor"], "contexts": ["scientist making temperature observations"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Professor E. Forbes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Professor Forbes", "similarity": 0.927}, {"source_book": "kosmos_humboldt_1845", "source_name": "Professor E. Forbes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Forbes, Professor", "similarity": 0.887}, {"source_book": "kosmos_humboldt_1845", "source_name": "Professor Forbes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Professor Forbes", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Professor Forbes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Forbes, Professor", "similarity": 0.932}, {"source_book": "kosmos_humboldt_1845", "source_name": "Forbes, Professor E.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Forbes, Professor", "similarity": 0.909}, {"source_book": "kosmos_humboldt_1845", "source_name": "Forbes, Professor J.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Professor Forbes", "similarity": 0.895}, {"source_book": "kosmos_humboldt_1845", "source_name": "Forbes, Professor J.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Forbes, Professor", "similarity": 0.921}], "id": 2988, "stable_key": "clu_0263d31e3ab78655-4", "ground_truth": {"modern_name": "Edward Forbes", "confidence": "high", "type": "person", "description": "A naturalist and geologist, known for his conclusions on biogeography.", "note": "Distinguished from Forbes Winslow, a different author.", "wikipedia_extract": "Edward Forbes FRS, FGS (12 February 1815 \u2013 18 November 1854) was a Manx naturalist. In 1846, he proposed that the distributions of montane plants and animals had been compressed downslope, and some oceanic islands connected to the mainland, during the recent ice age. This mechanism, which was the first natural explanation to explain the distributions of the same species on now-isolated islands and mountain tops, was discovered independently by Charles Darwin, who credited Forbes with the idea. He also incorrectly deduced the so-called azoic hypothesis, that life under the sea would decline to the point that no life forms could exist below a certain depth. Forbes was born at Douglas in the Isle of Man. His father was a well-to-do banker.", "birth_year": 1815, "death_year": 1854}}, {"canonical_name": "co\u017ftras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "co\u017ftica", "book_id": "historia_medicinal_monardes_1574", "name": "co\u017ftica", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["co\u017ftica", "cotica"], "contexts": ["condition treated with hair", "condition cured by sulphur and egg"]}, {"entity_id": "co\u017ftras", "book_id": "polyanthea_medicinal", "name": "co\u017ftras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 7, "variants": ["co\u017ftras", "Co\u017ftras", "cof tras", "costras"], "contexts": ["condition treated by unguent", "skin ailment treated by unguent"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "co\u017ftica", "target_book": "polyanthea_medicinal", "target_name": "co\u017ftras", "similarity": 0.887}], "id": 2989, "stable_key": "clu_c15ea6ea5000c8d8", "ground_truth": {"modern_name": "Scabs", "confidence": "high", "type": "disease", "modern_term": "Scabs"}}, {"canonical_name": "mel\u00f5es", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "melones", "book_id": "historia_medicinal_monardes_1574", "name": "Melones", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Melones"], "contexts": ["fruit of Charranfol\u00ed, melon-shaped", "fruit recommended for cooling"]}, {"entity_id": "mel\u00f5es", "book_id": "coloquios_da_orta_1563", "name": "mel\u00f5es", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["mel\u00f5es", "mel\u00f5es da \u00edndia", "mel\u00f5es de Portugal"], "contexts": ["melons, a food item", "fruit that rots and causes fevers"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Melones", "target_book": "coloquios_da_orta_1563", "target_name": "mel\u00f5es", "similarity": 0.944}], "id": 2990, "stable_key": "clu_06302735ae2c1655", "ground_truth": {"modern_name": "Melon", "confidence": "high", "type": "plant", "linnaean": "Cucumis melo L.", "family": "Cucurbitaceae"}}, {"canonical_name": "saramp\u00e3os", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "sarampio", "book_id": "historia_medicinal_monardes_1574", "name": "Sarampio", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Sarampio"], "contexts": ["name for the disease"]}, {"entity_id": "saramp\u00e3os", "book_id": "polyanthea_medicinal", "name": "saramp\u00e3os", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 8, "variants": ["saramp\u00e3os", "Sarampa\u00f5", "sarampao", "saramp\u00e3o"], "contexts": ["measles", "disease treated with Bezoartic cordial"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Sarampio", "target_book": "polyanthea_medicinal", "target_name": "saramp\u00e3os", "similarity": 0.891}], "id": 2991, "stable_key": "clu_cc6dc383eec04988", "ground_truth": {"modern_name": "Measles", "confidence": "high", "type": "disease", "description": "A highly contagious infectious disease causing fever and rash.", "note": "Refers to the eruptive fever known as measles.", "wikipedia_extract": "Measles (probably from Middle Dutch or Middle High German masel(e), meaning \"blemish, blood blister\") is a highly contagious, vaccine-preventable infectious disease caused by measles virus. Other names include morbilli, rubeola, 9-day measles, red measles, and English measles. Symptoms usually develop 10\u201312 days after exposure to an infected person and last 7\u201310 days. Initial symptoms typically include fever, often greater than 40 \u00b0C (104 \u00b0F), cough, runny nose, and inflamed eyes. Small white spots known as Koplik spots may form inside the mouth two or three days after the start of symptoms. A red, flat rash which usually starts on the face and then spreads to the rest of the body typically begins three to five days after the start of symptoms."}}, {"canonical_name": "vi\u017fta", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "vi\u017fco\u017fos", "book_id": "historia_medicinal_monardes_1574", "name": "vi\u017fco\u017fos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["vi\u017fco\u017fos"], "contexts": ["type of humors evacuated by the root"]}, {"entity_id": "vi\u017fta", "book_id": "polyanthea_medicinal", "name": "vi\u017fta", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["vi\u017fta"], "contexts": ["sight affected by sores", "sight, which can be lost or restored"]}, {"entity_id": "vi\u017fco\u017fos", "book_id": "polyanthea_medicinal", "name": "vi\u017fco\u017fos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["vi\u017fco\u017fos"], "contexts": ["describing humors causing paralysis", "viscous quality"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "vi\u017fco\u017fos", "target_book": "polyanthea_medicinal", "target_name": "vi\u017fta", "similarity": 0.893}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "vi\u017fco\u017fos", "target_book": "polyanthea_medicinal", "target_name": "vi\u017fco\u017fos", "similarity": 1.0}], "id": 2992, "stable_key": "clu_2a1887f3098d4092", "ground_truth": {"modern_name": "Viscous humors", "confidence": "medium", "type": "concept", "note": "Refers to the humoral theory of medicine, specifically thick bodily fluids.", "wikidata_id": "Q5782572", "wikidata_description": "ancient Greek and Roman system of medicine involving four fluid types", "wikipedia_url": "https://en.wikipedia.org/wiki/Rheology", "wikipedia_extract": "Rheology (; from Ancient Greek  \u1fe5\u03ad\u03c9 (rh\u00e9\u014d) 'flow' and  -\u03bbo\u03b3\u03af\u03b1 (-log\u00eda) 'study of') is the study of the flow of matter, primarily in a fluid (liquid or gas) state, as well as \"soft solids\", which experience conditions under which they respond with plastic flow rather than elastic deformation to forces applied to them. Rheology is the branch of physics that deals with the deformation and flow of materials, both solids and liquids. The term rheology was coined by Eugene C. Bingham, a professor at Lafayette College, in 1920 from a suggestion by a colleague, Markus Reiner. The term was inspired by the aphorism of  Heraclitus (often mistakenly attributed to Simplicius), panta rhei (\u03c0\u03ac\u03bd\u03c4\u03b1 \u1fe5\u03b5\u1fd6, 'everything flows') and was first used to describe the flow of liquids and the deformation of solids. It applies to substances that have a complex microstructure, such as muds, sludges, suspensions, and polymers and other glass formers (e.g., silicates), as well as many foods and additives, bodily fluids (e.g., blood) and other biological materials, and other materials that belong to the class of soft matter such as food."}}, {"canonical_name": "quotidianas", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "cotid\u00edanas", "book_id": "historia_medicinal_monardes_1574", "name": "Cotid\u00edanas", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["Cotid\u00edanas"], "contexts": ["daily fevers"]}, {"entity_id": "quotidianas", "book_id": "polyanthea_medicinal", "name": "quotidianas", "category": "DISEASE", "subcategory": "ACUTE", "count": 8, "variants": ["quotidianas", "quotidiana", "quotidiana continua", "quotidiane"], "contexts": ["quotidian fevers", "fever type, 'quotidians'"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Cotid\u00edanas", "target_book": "polyanthea_medicinal", "target_name": "quotidianas", "similarity": 0.937}], "id": 2993, "stable_key": "clu_140fbc177967fe05", "ground_truth": {"modern_name": "Quotidian fever", "confidence": "high", "type": "disease", "description": "A type of fever that recurs daily.", "wikipedia_extract": "Fever or pyrexia in humans is a symptom of an anti-infection defense mechanism that appears with body temperature exceeding the normal range caused by an increase in the body's temperature set point in the hypothalamus. There is no single agreed-upon upper limit for normal temperature: sources use values ranging between 37.2 and 38.3 \u00b0C (99.0 and 100.9 \u00b0F) in humans. The increase in set point triggers increased muscle contractions and causes a feeling of cold or chills. This results in greater heat production and efforts to conserve heat. When the set point temperature returns to normal, a person feels hot, becomes flushed, and may begin to sweat. Rarely a fever may trigger a febrile seizure, with this being more common in young children."}}, {"canonical_name": "Palestina", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "palestina", "book_id": "coloquios_da_orta_1563", "name": "Palestina", "category": "PLACE", "subcategory": "REGION", "count": 8, "variants": ["Palestina", "Pales-tina"], "contexts": ["region where benjuy is traded", "place where mungo is found"]}, {"entity_id": "palestina", "book_id": "polyanthea_medicinal", "name": "Palestina", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Palestina"], "contexts": ["place where miracle did not occur"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Palestina", "target_book": "polyanthea_medicinal", "target_name": "Palestina", "similarity": 0.948}], "id": 2994, "stable_key": "clu_e2adec3c9feb0437", "ground_truth": {"modern_name": "Palestine", "confidence": "high", "type": "place", "description": "Geographic region in the Middle East, historically significant for trade and religious importance.", "wikipedia_extract": "Palestine, officially the State of Palestine, is a country in West Asia. It encompasses the Israeli-occupied West Bank, including East Jerusalem, and the Gaza Strip, collectively known as the Palestinian territories. The territories share the vast majority of their borders with Israel, with the West Bank bordering Jordan to the east and the Gaza Strip bordering Egypt to the southwest. It has a total land area of 6,020 square kilometres (2,320 sq mi) while its population exceeds five million. Its proclaimed capital is Jerusalem, while Ramallah serves as its de facto administrative center. Gaza was its largest city prior to evacuations in 2023."}}, {"canonical_name": "seda", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "seda", "book_id": "coloquios_da_orta_1563", "name": "seda", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 8, "variants": ["seda", "seda da china", "seda solta", "seda tecida"], "contexts": ["fibrous material from silkworms", "textile material traded"]}, {"entity_id": "seda", "book_id": "polyanthea_medicinal", "name": "seda", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["seda"], "contexts": ["silk"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "seda", "target_book": "polyanthea_medicinal", "target_name": "seda", "similarity": 1.0}], "id": 2995, "stable_key": "clu_75c5859898e54609", "ground_truth": {"modern_name": "Silk", "confidence": "high", "type": "animal", "note": "While silk is a product, it originates from silkworms. The context 'fibrous material from silkworms' confirms this origin, and the term 'seda' directly translates to silk. Therefore, classifying it as 'animal' in terms of origin is appropriate within this historical context of natural philosophy.", "wikidata_id": "Q134747", "wikidata_description": "insect from the moth family", "wikipedia_url": "https://en.wikipedia.org/wiki/Bombyx%20mori"}}, {"canonical_name": "tamalapatra", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "tamalapatra", "book_id": "coloquios_da_orta_1563", "name": "tamalapatra", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["tamalapatra", "Tamalapatra", "tamala pattra", "tamalapatrae", "tamcdapatra"], "contexts": ["Indian name for folio indo", "Indian name for 'folio indo', meaning leaf of tamala"]}, {"entity_id": "tamal\u00e0batro", "book_id": "ricettario_fiorentino_1597", "name": "Tamal\u00e0batro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Tamal\u00e0batro"], "contexts": ["plant for syrup"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "tamalapatra", "target_book": "ricettario_fiorentino_1597", "target_name": "Tamal\u00e0batro", "similarity": 0.884}], "id": 2996, "stable_key": "clu_f61062d36b13f479", "ground_truth": {"modern_name": "Cinnamomum tamala", "confidence": "high", "type": "plant", "linnaean": "Cinnamomum tamala Nees & Eberm.", "family": "Lauraceae", "note": "Also known as Indian Cassia or Tezpatl in Mesoamerica. The context suggests it's a spice leaf from India.", "wikidata_id": "Q1661611", "wikidata_description": "species of plant"}}, {"canonical_name": "Margarita", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "margarita", "book_id": "coloquios_da_orta_1563", "name": "Margarita", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 8, "variants": ["margarita", "Margarita"], "contexts": ["topic related to alj\u00f4far", "Latin name for small pearl"]}, {"entity_id": "margarita", "book_id": "polyanthea_medicinal", "name": "Margarita", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Margarita"], "contexts": ["pearl, used in medicine"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Margarita", "target_book": "polyanthea_medicinal", "target_name": "Margarita", "similarity": 1.0}], "id": 2997, "stable_key": "clu_8b527c0d02d86d1c", "ground_truth": {"modern_name": "pearl", "confidence": "high", "type": "mineral", "description": "A hard, glistening object produced within the soft tissue of a living shelled mollusk.", "wikipedia_extract": "A pearl is a hard, glistening object produced within the soft tissue (specifically the mantle) of a living shelled mollusk or another animal, such as fossil  conulariids. Just like the shell of a mollusk, a pearl is composed of calcium carbonate (mainly aragonite or a mixture of aragonite and calcite) in minute crystalline form, which has deposited in concentric layers. More commercially valuable pearls are perfectly round and smooth, but many other shapes, known as baroque pearls, can occur. The finest quality of natural pearls have been highly valued as gemstones and objects of beauty for many centuries. Because of this, pearl has become a metaphor for something rare, fine, admirable, and valuable. The most valuable pearls occur spontaneously in the wild but are extremely rare."}}, {"canonical_name": "fumaria", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "fumaria", "book_id": "coloquios_da_orta_1563", "name": "Fumaria", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Fumaria", "Fuma"], "contexts": ["plant species Orta might have seen", "botanical name"]}, {"entity_id": "fumaria", "book_id": "polyanthea_medicinal", "name": "fumaria", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["fumaria", "Fumaria"], "contexts": ["ingredient in syrups", "fumitory used in a decoction"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Fumaria", "target_book": "polyanthea_medicinal", "target_name": "fumaria", "similarity": 0.844}], "id": 2998, "stable_key": "clu_fe621e1c883ab6b5", "ground_truth": {"modern_name": "Fumaria officinalis", "confidence": "high", "type": "plant", "linnaean": "Fumaria officinalis Linnaeus", "family": "Fumariaceae", "wikidata_id": "Q157618", "wikidata_description": "species of plant"}}, {"canonical_name": "menta", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "menta_romana", "book_id": "coloquios_da_orta_1563", "name": "menta romana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["menta romana", "menta"], "contexts": ["herb used as false costus", "Roman mint, medicinal herb"]}, {"entity_id": "menta", "book_id": "ricettario_fiorentino_1597", "name": "menta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["menta", "Menta", "Menta domestica"], "contexts": ["mint, an ingredient in a syrup", "mint herb"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "menta romana", "target_book": "ricettario_fiorentino_1597", "target_name": "menta", "similarity": 0.909}], "id": 2999, "stable_key": "clu_20a33a4ebc3e9622", "ground_truth": {"modern_name": "Mentha", "confidence": "high", "type": "plant", "linnaean": "Mentha Linnaeus", "family": "Lamiaceae", "note": "The specific mention of 'menta romana' suggests Mentha suaveolens or another Roman mint variety, but 'Mentha' is a safe general classification.", "wikidata_id": "Q47859", "wikidata_description": "genus of plants"}}, {"canonical_name": "sabugueyro", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "sabugueiro", "book_id": "coloquios_da_orta_1563", "name": "sabugueiro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["sabugueiro"], "contexts": ["tree compared to casto tree", "elder tree"]}, {"entity_id": "sabugueyro", "book_id": "polyanthea_medicinal", "name": "sabugueyro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["sabugueyro", "Sabugueyro"], "contexts": ["elder tree, its leaves used as remedy", "plant used in medicine"]}, {"entity_id": "sabugueiro", "book_id": "polyanthea_medicinal", "name": "Sabugueiro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Sabugueiro"], "contexts": ["elder tree"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "sabugueiro", "target_book": "polyanthea_medicinal", "target_name": "sabugueyro", "similarity": 0.888}, {"source_book": "coloquios_da_orta_1563", "source_name": "sabugueiro", "target_book": "polyanthea_medicinal", "target_name": "Sabugueiro", "similarity": 0.831}], "id": 3000, "stable_key": "clu_85a6edf33947b98f", "ground_truth": {"modern_name": "Elder", "confidence": "high", "type": "PLANT", "linnaean": "Sambucus nigra", "family": "Viburnaceae", "description": "Shrub or tree with medicinal uses for its leaves and fruit.", "note": "Also known as 'sabugueyro' or 'sabugueiro'.", "wikipedia_extract": "Sambucus nigra is a species complex of flowering plants in the family Viburnaceae native to most of Europe. Common names include elder, elderberry, black elder, European elder,  European elderberry, and European black elderberry. It grows in a variety of conditions including both wet and dry fertile soils, primarily in sunny locations. The plant is widely grown as an  ornamental shrub or small tree. Both the flowers and the berries have a long tradition of culinary use, primarily for cordial and wine. Although the plant is commonly used in dietary supplements and traditional medicine, there is no  scientific evidence that it provides any significant health benefit."}}, {"canonical_name": "goma", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "goma_ar\u00e1bica", "book_id": "coloquios_da_orta_1563", "name": "goma ar\u00e1bica", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["goma ar\u00e1bica"], "contexts": ["substance sometimes used to falsify alo\u00e9s", "gum arabic"]}, {"entity_id": "goma", "book_id": "polyanthea_medicinal", "name": "goma", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["goma", "goma arabica", "goma elemi", "gomo", "gumo"], "contexts": ["ingredient in an emplaster", "gum used in a broth"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "goma ar\u00e1bica", "target_book": "polyanthea_medicinal", "target_name": "goma", "similarity": 0.893}], "id": 3001, "stable_key": "clu_bc76289031ff821c", "ground_truth": {"modern_name": "Gum arabic", "confidence": "high", "type": "plant", "linnaean": "Senegalia senegal", "family": "Fabaceae", "note": "While 'goma' can refer to any gum, 'goma ar\u00e1bica' specifically points to Gum arabic. The context of it being an ingredient in an emplaster and sometimes used to falsify aloes strongly suggests this."}}, {"canonical_name": "mitridato", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "mitridato", "book_id": "coloquios_da_orta_1563", "name": "mitridato", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["mitridato", "mithridatos"], "contexts": ["composition including amomum", "compound medicines"]}, {"entity_id": "mitridato", "book_id": "polyanthea_medicinal", "name": "mitridato", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 7, "variants": ["mitridato", "Mitridates", "Mitridato", "Mitridatos", "mithridatis", "mitridatis"], "contexts": ["ingredient in a preparation", "added to chicken broth remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "mitridato", "target_book": "polyanthea_medicinal", "target_name": "mitridato", "similarity": 1.0}], "id": 3002, "stable_key": "clu_a201c39c357956e9", "ground_truth": {"modern_name": "Methridate", "confidence": "high", "type": "preparation", "description": "A complex historical antidote or medicinal compound."}}, {"canonical_name": "Eupatorio", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "eupator\u00edo", "book_id": "coloquios_da_orta_1563", "name": "eupator\u00edo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["eupator\u00edo", "eupatorio"], "contexts": ["herb with doubtful knowledge", "plant name"]}, {"entity_id": "eupatorio", "book_id": "ricettario_fiorentino_1597", "name": "Eupatorio", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["Eupatorio", "Eufatorio"], "contexts": ["herb used in decoctions", "ingredient in decoction"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "eupator\u00edo", "target_book": "ricettario_fiorentino_1597", "target_name": "Eupatorio", "similarity": 0.826}], "id": 3003, "stable_key": "clu_5641acde14bebd77", "ground_truth": {"modern_name": "Eupatorium", "confidence": "high", "type": "plant", "family": "Asteraceae", "description": "A genus of flowering plants, some species used in traditional medicine.", "wikipedia_extract": "Eupatorium is a genus of flowering plants in the family Asteraceae, containing from 36 to 60 species depending on the classification system. Most are herbaceous perennials growing to 0.5\u20133 m (1.6\u20139.8 ft) tall. A few are shrubs. The genus is native to temperate regions of the Northern Hemisphere. The type species of the genus Eupatorium cannabinum, which is also the sole European species, is known as hemp-agrimony. Most in North America are commonly called boneset, thoroughwort or snakeroot."}}, {"canonical_name": "Estanho", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "estanho", "book_id": "coloquios_da_orta_1563", "name": "estanho", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["estanho", "estanno"], "contexts": ["commodity weighed in Malaca", "tin"]}, {"entity_id": "estanho", "book_id": "polyanthea_medicinal", "name": "Estanho", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["estanho", "Estanho"], "contexts": ["metal used in a remedy for diabetes", "metal used in preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "estanho", "target_book": "polyanthea_medicinal", "target_name": "Estanho", "similarity": 0.858}], "id": 3004, "stable_key": "clu_912a609c74d65914-2", "ground_truth": {"modern_name": "Tin", "confidence": "high", "type": "mineral", "wikidata_id": "Q1096", "wikidata_description": "chemical element with symbol Sn and atomic number 50"}}, {"canonical_name": "gengivas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "gingivas", "book_id": "coloquios_da_orta_1563", "name": "gingivas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["gingivas", "gengivas"], "contexts": ["part of the mouth", "body part affected by relaxa\u00e7am"]}, {"entity_id": "gengivas", "book_id": "polyanthea_medicinal", "name": "gengivas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 7, "variants": ["gengivas"], "contexts": ["gums, a body part", "gums"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "gingivas", "target_book": "polyanthea_medicinal", "target_name": "gengivas", "similarity": 0.887}], "id": 3005, "stable_key": "clu_8683e6aac449d9fa", "ground_truth": {"modern_name": "Gums (anatomy)", "confidence": "high", "type": "anatomy", "note": "The context clearly indicates the anatomical feature of the mouth.", "wikidata_id": "Q104280", "wikidata_description": "human mouth anatomy"}}, {"canonical_name": "cato", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "cato", "book_id": "coloquios_da_orta_1563", "name": "cato", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["cato"], "contexts": ["name for cate in Malaca", "name for catechu"]}, {"entity_id": "cato", "book_id": "polyanthea_medicinal", "name": "cato", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["Cato", "cato"], "contexts": ["ancient authority on remedies", "ancient authority mentioned"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "cato", "target_book": "polyanthea_medicinal", "target_name": "cato", "similarity": 0.437}], "id": 3006, "stable_key": "clu_03a3cfdf8602e8dc", "ground_truth": {"modern_name": "Catechu", "confidence": "high", "type": "chemical", "wikidata_id": "Q2046743", "wikidata_description": "extract of acacia trees used variously as a food additive, astringent, tannin, and dye"}}, {"canonical_name": "espargos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "esparegos", "book_id": "coloquios_da_orta_1563", "name": "esparegos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["esparegos"], "contexts": ["herb from terra firme"]}, {"entity_id": "espargos", "book_id": "polyanthea_medicinal", "name": "espargos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["espargos", "esparagos", "esparrago"], "contexts": ["asparagus, root used in preparation", "food with deobstructing properties"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "esparegos", "target_book": "polyanthea_medicinal", "target_name": "espargos", "similarity": 0.893}], "id": 3007, "stable_key": "clu_e95dbad60ce0c8bf", "ground_truth": {"modern_name": "Asparagus", "confidence": "high", "type": "PLANT", "linnaean": "Asparagus officinalis", "family": "Asparagaceae", "description": "A plant whose roots and shoots are used as food and medicine.", "wikipedia_extract": "Asparagus (Asparagus officinalis) or garden asparagus is a perennial flowering plant species in the genus Asparagus native to Eurasia. Widely cultivated as a vegetable crop, its young shoots are used as a spring vegetable. Asparagus is an herbaceous, perennial plant growing typically to 100\u2013150 centimetres (3\u20135 feet) tall, with stout stems with much-branched, feathery foliage. It has been known to grow as long as 3.5 metres (11 ft). The 'leaves' are needle-like cladodes (modified stems) in the axils of scale leaves; they are 6\u201332 millimetres (1\u20444\u20131+1\u20444 inches) long and 1 mm (1\u204432 in) broad, and clustered in fours, up to 15, together, in a rose-like shape. The root system, often referred to as a 'crown', is adventitious; the root type is fasciculated."}}, {"canonical_name": "grama", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "grama", "book_id": "coloquios_da_orta_1563", "name": "grama", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["grama"], "contexts": ["plant for comparison of growth habit"]}, {"entity_id": "grama", "book_id": "polyanthea_medicinal", "name": "grama", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["grama"], "contexts": ["herb used in remedy", "couch grass, root used in preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "grama", "target_book": "polyanthea_medicinal", "target_name": "grama", "similarity": 1.0}], "id": 3008, "stable_key": "clu_c7c6d74c1727590d", "ground_truth": {"modern_name": "Couch grass", "confidence": "high", "type": "plant", "linnaean": "Elymus repens", "family": "Poaceae"}}, {"canonical_name": "Cufcuta", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "cufcuta", "book_id": "ricettario_fiorentino_1597", "name": "Cufcuta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["Cufcuta", "Cufcqta", "Cufuta", "Culcuta", "Cuscuta"], "contexts": ["plant similar to Epithymo", "herb used in decoctions"]}, {"entity_id": "cufcuta", "book_id": "polyanthea_medicinal", "name": "cufcuta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cufcuta"], "contexts": ["cuscuta used in a syrup"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Cufcuta", "target_book": "polyanthea_medicinal", "target_name": "cufcuta", "similarity": 0.985}], "id": 3009, "stable_key": "clu_ee38b5113b369343", "ground_truth": {"modern_name": "Cuscuta", "confidence": "high", "type": "plant", "linnaean": "Cuscuta spp.", "family": "Convolvulaceae", "description": "A genus of parasitic plants, commonly known as dodder or strangle-vine.", "wikipedia_extract": "Cuscuta (), commonly known as dodder or amarbel, is a genus of over 201 species of yellow, orange, or red (rarely green) parasitic plants. Formerly treated as the only genus in the family Cuscutaceae, it now is accepted as belonging in the morning glory family, Convolvulaceae, on the basis of the work of the Angiosperm Phylogeny Group. The genus is found throughout the temperate and tropical regions of the world, with the greatest species diversity in subtropical and tropical regions; the genus becomes rare in cool temperate climates, with only four species native to northern Europe. Folk names include strangle tare, strangleweed, scaldweed, beggarweed, lady's laces, fireweed, wizard's net, devil's guts, devil's hair, devil's ringlet, goldthread, hailweed, hairweed, hellbine, love vine, pull-down, angel hair, and witch's hair. Cuscuta can be identified by its thin stems appearing leafless, with the leaves reduced to minute scales. In these respects it closely resembles the similarly parasitic, but unrelated genus, Cassytha."}}, {"canonical_name": "linimento", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "linimenti", "book_id": "ricettario_fiorentino_1597", "name": "linimenti", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["linimenti"], "contexts": ["liniments, a type of compound medicine"]}, {"entity_id": "linimento", "book_id": "polyanthea_medicinal", "name": "linimento", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 8, "variants": ["linimento", "hum linimento", "linimento das almorreymas", "linimento magistral"], "contexts": ["liniment named number 4 for itching", "medicinal ointment"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "linimenti", "target_book": "polyanthea_medicinal", "target_name": "linimento", "similarity": 0.927}], "id": 3010, "stable_key": "clu_258f40b47fba7eec", "ground_truth": {"modern_name": "Liniment", "confidence": "high", "type": "substance", "description": "A liquid or semi-liquid preparation rubbed on the skin as an anodyne or embrocation.", "wikipedia_extract": "Liniment (from Latin: linere, meaning \"to smear, anoint\"), also called embrocation and heat rub, is a medicated topical preparation for application to the skin. Some liniments have a viscosity similar to that of water; others are lotion or balm; still, others are in transdermal patches, soft solid sticks, and sprays. Liniment usually is rubbed into the skin, which the active ingredients penetrate. Liniments are typically sold to relieve pain and stiffness, such as from muscular aches and strains, and arthritis. These are typically formulated from alcohol, acetone, or similar quickly evaporating solvents and contain counterirritant aromatic chemical compounds, such as methyl salicylate, benzoin resin, menthol, and capsaicin. They produce a feeling of warmth within the muscle of the area they are applied to, typically acting as rubefacients via a counterirritant effect."}}, {"canonical_name": "Cicuta", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "cicuta", "book_id": "ricettario_fiorentino_1597", "name": "Cicuta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Cicuta"], "contexts": ["herb used in preparation"]}, {"entity_id": "cicuta", "book_id": "polyanthea_medicinal", "name": "Cicuta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["Cicuta", "cicuta"], "contexts": ["substance with narcotic qualities", "leaves used in an ointment"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Cicuta", "target_book": "polyanthea_medicinal", "target_name": "Cicuta", "similarity": 1.0}], "id": 3011, "stable_key": "clu_db10a119543641cb", "ground_truth": {"modern_name": "Hemlock", "confidence": "high", "type": "plant", "linnaean": "Conium maculatum", "family": "Apiaceae", "note": "Cicuta is the Latin name for hemlock, which can refer to different species, but Conium maculatum is the most common."}}, {"canonical_name": "circula\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "circula\u00e7\u00e3o", "book_id": "polyanthea_medicinal", "name": "circula\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["circula\u00e7\u00e3o", "circula\u00e7\u00e3odo \u017fangue", "fua circula\u00e7ao"], "contexts": ["bodily process", "movement of blood"]}, {"entity_id": "circulation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "circulation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["circulation"], "contexts": ["movement of air or fluids"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "circula\u00e7\u00e3o", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "circulation", "similarity": 0.948}], "id": 3012, "stable_key": "clu_c7d7a639aa204abf", "ground_truth": {"modern_name": "Circulation", "confidence": "high", "type": "concept", "wikidata_id": "Q578091", "wikidata_description": "journal"}}, {"canonical_name": "acceleration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "acceleration", "book_id": "connexion_physical_sciences_somerville_1858", "name": "acceleration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["Acceleration", "acceleration"], "contexts": ["increase in speed", "increase in Moon's orbital speed"]}, {"entity_id": "accelerations", "book_id": "first_principles_spencer_1862", "name": "accelerations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["accelerations"], "contexts": ["increase in velocity of motion"]}, {"entity_id": "acceleration", "book_id": "first_principles_spencer_1862", "name": "acceleration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["acceleration"], "contexts": ["change in velocity over time"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "acceleration", "target_book": "first_principles_spencer_1862", "target_name": "accelerations", "similarity": 0.937}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "acceleration", "target_book": "first_principles_spencer_1862", "target_name": "acceleration", "similarity": 1.0}], "id": 3013, "stable_key": "clu_07dd5023360d94f7", "ground_truth": {"modern_name": "Acceleration", "confidence": "high", "type": "concept", "wikidata_id": "Q11376", "wikidata_description": "rate at which the magnitude and/or direction of velocity changes with time"}}, {"canonical_name": "particles", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "particles", "book_id": "connexion_physical_sciences_somerville_1858", "name": "particles", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 7, "variants": ["particles"], "contexts": ["tiny constituent parts of matter", "minute portions of matter"]}, {"entity_id": "particles", "book_id": "first_principles_spencer_1862", "name": "particles", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["particles"], "contexts": ["fundamental components of matter", "disarranged around collision point"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "particles", "target_book": "first_principles_spencer_1862", "target_name": "particles", "similarity": 1.0}], "id": 3014, "stable_key": "clu_6ba578a1af152fd9", "ground_truth": {"modern_name": "Particles", "confidence": "high", "type": "concept", "note": "Refers to fundamental components of matter, not necessarily subatomic particles in the modern sense but rather small indivisible units as understood at the time.", "wikidata_id": "Q184943", "wikidata_description": "typically short and indeclinable word with a grammatical function but no clear part of speech"}}, {"canonical_name": "current", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "current", "book_id": "connexion_physical_sciences_somerville_1858", "name": "current", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["current"], "contexts": ["uninterrupted flow of electricity", "flow of electrical charge"]}, {"entity_id": "current_of_electricity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "current of electricity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["current of electricity"], "contexts": ["flow of electrical charge", "flow of electric charge"]}, {"entity_id": "current_of_electricity", "book_id": "first_principles_spencer_1862", "name": "current of Electricity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["current of Electricity"], "contexts": ["generates magnetism in soft iron"]}, {"entity_id": "electric_current", "book_id": "first_principles_spencer_1862", "name": "electric current", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["electric current"], "contexts": ["results from chemical affinities, effects decomposition"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "current", "target_book": "first_principles_spencer_1862", "target_name": "electric current", "similarity": 0.884}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "current of electricity", "target_book": "first_principles_spencer_1862", "target_name": "current of Electricity", "similarity": 0.993}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "current of electricity", "target_book": "first_principles_spencer_1862", "target_name": "electric current", "similarity": 0.932}], "id": 3015, "stable_key": "clu_23777a8ace3df4fe-3", "ground_truth": {"modern_name": "Electric current", "confidence": "high", "type": "concept", "note": "The context 'inducing state upon matter' points towards electrical phenomena, distinguishing it from purely oceanic or hydraulic currents.", "wikidata_id": "Q11651", "wikidata_description": "flow of electric charge", "wikipedia_url": "https://en.wikipedia.org/wiki/Electric%20current", "wikipedia_extract": "An electric current is a flow of charged particles, such as electrons or ions, moving through an electrical conductor or space. It is defined as the net rate of flow of electric charge through a surface. The moving particles are called charge carriers, which may be one of several types of particles, depending on the conductor. In electric circuits the charge carriers are often electrons moving through a wire. In semiconductors they can be electrons or holes. In an electrolyte the charge carriers are ions, while in plasma, an ionized gas, they are ions and electrons."}}, {"canonical_name": "European", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "european", "book_id": "connexion_physical_sciences_somerville_1858", "name": "European", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["European"], "contexts": ["relating to Europe", "part of the isogeothermal line"]}, {"entity_id": "european", "book_id": "first_principles_spencer_1862", "name": "European", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["European"], "contexts": ["person of European descent", "human racial group"]}, {"entity_id": "europeans", "book_id": "first_principles_spencer_1862", "name": "Europeans", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Europeans"], "contexts": ["people from Europe"]}], "edges": [{"so