leza_hernandez_1615", "name": "cabra", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["cabra"], "contexts": ["goat, used for comparison of appendages"]}, {"entity_id": "cabras", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "cabras", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["cabras"], "contexts": ["animals where stones are found"]}, {"entity_id": "cabras", "book_id": "historia_medicinal_monardes_1574", "name": "cabras", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 13, "variants": ["cabras", "Cabra", "Cabra monte", "Cabras", "Cabras manteles", "Cabras montelas", "cabra", "cabron"], "contexts": ["goats from which stones are extracted", "goats"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cabra", "target_book": "historia_medicinal_monardes_1574", "target_name": "cabras", "similarity": 0.924}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cabras", "target_book": "historia_medicinal_monardes_1574", "target_name": "cabras", "similarity": 1.0}], "id": 2546, "stable_key": "clu_7142bee1ba45439b", "ground_truth": {"modern_name": "goat", "confidence": "high", "type": "animal", "wikidata_id": "Q45320358", "wikidata_description": "species of mammal"}}, {"canonical_name": "Potosi", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "potosi", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Potosi", "category": "PLACE", "subcategory": "CITY", "count": 14, "variants": ["Potosi"], "contexts": ["city in South America", "city in Bolivia"]}, {"entity_id": "potosi", "book_id": "kosmos_humboldt_1845", "name": "Potosi", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Potosi"], "contexts": ["town with causeway"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Potosi", "target_book": "kosmos_humboldt_1845", "target_name": "Potosi", "similarity": 1.0}], "id": 2547, "stable_key": "clu_1e5edf8639026d87", "ground_truth": {"modern_name": "Potos\u00ed", "confidence": "high", "type": "place", "country": "Bolivia", "wikidata_id": "Q378135", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Potos%C3%AD", "wikipedia_extract": "Potos\u00ed, known as Villa Imperial de Potos\u00ed in the colonial period, is the capital city and a municipality of the Department of Potos\u00ed in Bolivia. It is one of the highest cities in the world at a nominal 4,067 m (13,343 ft). Diego Huallpa, an indigenous prospector, is traditionally credited with the discovery of the Cerro Rico in 1545, which led to the founding and rapid growth of Potos\u00ed due to its extraordinary silver wealth. For centuries, it was the location of the Spanish colonial silver mint. A considerable amount of the city's colonial architecture has been preserved in the historic center of the city, which\u2014along with the globally important Cerro Rico de Potos\u00ed\u2014are part of a designated UNESCO World Heritage Site. Potos\u00ed lies at the foot of the Cerro de Potos\u00ed\u2014sometimes referred to as the Cerro Rico (\"rich mountain\")\u2014a mountain popularly conceived of as being \"made of\" silver ore that dominates the city."}}, {"canonical_name": "Maniquarez", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "maniquarez", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Maniquarez", "category": "PLACE", "subcategory": "CITY", "count": 14, "variants": ["Maniquarez"], "contexts": ["schistose cordillera where alum mine might be", "village near Laguna chica"]}, {"entity_id": "maniquarez", "book_id": "kosmos_humboldt_1845", "name": "Maniquarez", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Maniquarez"], "contexts": ["peninsula with mica slate rocks"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Maniquarez", "target_book": "kosmos_humboldt_1845", "target_name": "Maniquarez", "similarity": 0.867}], "id": 2548, "stable_key": "clu_71f712456b457f28", "ground_truth": {"modern_name": "Manicuare", "confidence": "high", "type": "place", "country": "Venezuela", "note": "The spelling varies slightly between Maniquarez and Manicuare, but Manicuare is the modern and geographically recognized name for the peninsula."}}, {"canonical_name": "Pasto", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "pasto", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pasto", "category": "PLACE", "subcategory": "CITY", "count": 12, "variants": ["Pasto"], "contexts": ["mountainous population center in Colombia", "city serving southern missions"]}, {"entity_id": "pasto", "book_id": "kosmos_humboldt_1845", "name": "Pasto", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Pasto"], "contexts": ["part of a mountain chain", "volcano in South America"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pasto", "target_book": "kosmos_humboldt_1845", "target_name": "Pasto", "similarity": 1.0}], "id": 2549, "stable_key": "clu_7f865827b551ac4f", "ground_truth": {"modern_name": "Pasto", "confidence": "high", "type": "place", "country": "Colombia", "wikipedia_extract": "Pashto (, PASH-toh; \u067e\u069a\u062a\u0648, P\u0259x\u030ct\u00f3, [p\u0259\u0282\u02c8to, p\u028ax\u02c8to, p\u0259\u0283\u02c8to, p\u0259\u00e7\u02c8to]) is an eastern Iranian language in the Indo-European language family, natively spoken in northwestern Pakistan and  southern and eastern Afghanistan. It has official status in Afghanistan. It is known in historical Persian literature as Afghani (\u0627\u0641\u063a\u0627\u0646\u06cc, Afgh\u0101ni). Spoken as a native language mostly by ethnic Pashtuns, it is one of the two official languages of Afghanistan alongside Dari, and it is spoken as the second-largest provincial language in Pakistan, spoken mainly in Khyber Pakhtunkhwa and the northern districts of Balochistan. Likewise, it is the primary language of the Pashtun diaspora around the world. The total number of Pashto-speakers is at least 40 million, although some estimates place it as high as 60 million.", "wikipedia_url": "https://en.wikipedia.org/wiki/Pashto"}}, {"canonical_name": "Antisana", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "antisana", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Antisana", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 11, "variants": ["Antisana", "Antimano", "Antimauo"], "contexts": ["snowy peak in Cordillera Oriental", "mountain height"]}, {"entity_id": "antisana", "book_id": "kosmos_humboldt_1845", "name": "Antisana", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Antisana"], "contexts": ["specific high point on the Andes", "mountain with significant elevation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Antisana", "target_book": "kosmos_humboldt_1845", "target_name": "Antisana", "similarity": 1.0}], "id": 2550, "stable_key": "clu_7adc7bc7ba781344", "ground_truth": {"modern_name": "Antisana", "confidence": "high", "type": "place", "country": "Ecuador", "wikidata_id": "Q4742194", "wikidata_description": "a protected area in Ecuador situated in the Napo Province, Quijos Canton and Archidona Canton", "wikipedia_url": "https://en.wikipedia.org/wiki/Antisana_Ecological_Reserve", "wikipedia_extract": "Antisana Ecological Reserve (Spanish: Reserva Ecol\u00f3gica Antisana) is a protected area in Ecuador situated in the Napo Province, Quijos Canton and Archidona Canton. Rare animals and plants found in or near the reserve include: White-fronted spider monkey (Ateles belzebuth) \u2013 Endangered Northern pudu (Pudu mephistophiles) \u2013 Vulnerable Mountain tapir (Tapirus pinchaque) \u2013 Endangered Spectacled bear (\"Tremarctos ornatus\") \u2013 Vulnerable Oncilla (Leopardus tigrinus) \u2013 Vulnerable Bush dog (Speothos venaticus) \u2013 Near Threatened Wattled guan (Aburria aburri) \u2013 Near Threatened Fuegian snipe (Gallinago stricklandii) \u2013 Near Threatened Andean condor (Vultur gryphus) \u2013 Near Threatened Spot-winged parrotlet (Touit stictopterus) \u2013 Vulnerable Greater scythebill (Campylorhamphus pucherani) \u2013 Near Threatened Southeastern giant antpitta, Grallaria gigantea gigantea \u2013 Vulnerable Giant conebill (Oreomanes fraseri) \u2013 Near Threatened Napo plump toad (Osornophryne antisana) \u2013 Endangered Senecio antisanae / Senecio iscoensis (= Aetheolaena senecioides?) \u2013 Data Deficient Other notable flora and fauna of the park are, for example: Silvery grebe (Podiceps occipitalis) Black-faced ibis (Theristicus melanopis) www.enjoyecuador.net / Antisana Ecological Reserve (Spanish) www.ambiente.gov."}}, {"canonical_name": "M\u00e9t\u00e9orologie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "m\u00e9t\u00e9orologie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "M\u00e9t\u00e9orologie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["M\u00e9t\u00e9orologie", "m\u00e9t\u00e9orologie"], "contexts": ["work from which observations were borrowed", "study of weather and climate"]}, {"entity_id": "meteorologie", "book_id": "kosmos_humboldt_1845", "name": "Meteorologie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Meteorologie"], "contexts": ["publication by Martins", "book title"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "M\u00e9t\u00e9orologie", "target_book": "kosmos_humboldt_1845", "target_name": "Meteorologie", "similarity": 0.935}], "id": 2551, "stable_key": "clu_101df4218b7bae46", "ground_truth": {"modern_name": "Meteorology", "confidence": "high", "type": "concept", "wikidata_id": "Q25261", "wikidata_description": "branch of science dealing with the study of atmospheric phenomena and the short term variation of weather conditions including wind, precipitation, temperature, humidity, cloud cover, and air pressure", "wikipedia_url": "https://en.wikipedia.org/wiki/Meteorology", "note": "Refers to Aristotle's work on atmospheric phenomena.", "wikipedia_extract": "Meteorology is the scientific study of the Earth's atmosphere and short-term atmospheric phenomena (i.e., weather), with a focus on weather forecasting. It has applications in the military, aviation, energy production, transport, agriculture, construction, weather warnings, and disaster management. Along with climatology, atmospheric physics, atmospheric chemistry, and aeronomy, meteorology forms the broader field of the atmospheric sciences. The interactions between Earth's atmosphere and its oceans (notably El Ni\u00f1o and La Ni\u00f1a) are studied in the interdisciplinary field of hydrometeorology. Other interdisciplinary areas include biometeorology, space weather, and planetary meteorology. Marine weather forecasting relates meteorology to maritime and coastal safety, based on atmospheric interactions with large bodies of water."}}, {"canonical_name": "Sweden", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "su\u00e8de", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Su\u00e8de", "category": "PLACE", "subcategory": "COUNTRY", "count": 7, "variants": ["Su\u00e8de"], "contexts": ["country", "country with population data"]}, {"entity_id": "sweden", "book_id": "kosmos_humboldt_1845", "name": "Sweden", "category": "PLACE", "subcategory": "COUNTRY", "count": 8, "variants": ["Sweden"], "contexts": ["country where instruments were distributed", "coast where earthquake was felt"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Su\u00e8de", "target_book": "kosmos_humboldt_1845", "target_name": "Sweden", "similarity": 0.931}], "id": 2552, "stable_key": "clu_bc61cbe1070abd90", "ground_truth": {"modern_name": "Sweden", "confidence": "high", "type": "place", "country": "Sweden", "note": "'Su\u00e8de' is the French name for Sweden.", "wikidata_id": "Q34", "wikidata_description": "country in Northern Europe", "wikipedia_extract": "Sweden, formally the Kingdom of Sweden, is a Nordic country located on the Scandinavian Peninsula in Northern Europe. It borders Norway to the west and north, and Finland to the east. At 450,295 square kilometres (173,860 sq mi), Sweden is the largest Nordic country by both area and population, and is the fifth-largest country in Europe. Its capital and largest city is Stockholm. Sweden has a population of 10.6 million, and a low population density of 25.5 inhabitants per square kilometre (66/sq mi); 88% of Swedes reside in urban areas. They are mostly in the central and southern half of the country.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sweden"}}, {"canonical_name": "Foglie", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "feuilles", "book_id": "relation_historique_humboldt_vol3_1825", "name": "feuilles", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["feuilles", "feuillage"], "contexts": ["plant matter falling from trees", "parts of plants that remain attached to the trunk"]}, {"entity_id": "foglie", "book_id": "ricettario_fiorentino_1597", "name": "Foglie", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 11, "variants": ["Foglie", "Fofflie", "Foglie d'Afs\u00e9zio", "Foglie d'Iuta", "Foglie d'sUoro", "Foglie d; mortine", "Foglie dMTUtaf. ce.", "Foglie di pcrfa", "foglie", "foglie bianch"], "contexts": ["part of the poppy plant", "leaves from which juices are extracted"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "feuilles", "target_book": "ricettario_fiorentino_1597", "target_name": "Foglie", "similarity": 0.947}], "id": 2553, "stable_key": "clu_9a7fd96f2f186b3b-2", "ground_truth": {"modern_name": "Leaf", "confidence": "high", "type": "plant", "description": "The part of a plant attached to a stem or branch.", "wikipedia_extract": "A leaf (pl.: leaves) is a principal appendage of the stem of a vascular plant, usually borne laterally above ground and specialized for photosynthesis. Leaves are collectively called foliage, as in \"autumn foliage\", while the leaves, stem, flower, and fruit collectively form the shoot system. In most leaves, the primary photosynthetic tissue is the palisade mesophyll and is located on the upper side of the blade or lamina of the leaf, but in some species, including the mature foliage of Eucalyptus, palisade mesophyll is present on both sides and the leaves are said to be isobilateral. The leaf is an integral part of the stem system, and most leaves are flattened and have distinct upper (adaxial) and lower (abaxial) surfaces that differ in color, hairiness, the number of stomata (pores that intake and output gases), the amount and structure of epicuticular wax, and other features. Leaves are mostly green in color due to the presence of a compound called chlorophyll which is essential for photosynthesis as it absorbs light energy from the Sun. A leaf with lighter-colored or white patches or edges is called a variegated leaf."}}, {"canonical_name": "Gustav Rose", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "gustave_rose", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Gustave Rose", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Gustave Rose"], "contexts": ["researcher involved in barometric measurements"]}, {"entity_id": "gustav_rose", "book_id": "kosmos_humboldt_1845", "name": "Gustav Rose", "category": "PERSON", "subcategory": "SCHOLAR", "count": 14, "variants": ["Gustav Rose"], "contexts": ["companion on scientific journey", "author of travelogue"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Gustave Rose", "target_book": "kosmos_humboldt_1845", "target_name": "Gustav Rose", "similarity": 0.973}], "id": 2554, "stable_key": "clu_16d5115156ec058a", "ground_truth": {"modern_name": "Gustav Rose", "confidence": "high", "type": "person", "birth_year": 1794, "death_year": 1873, "description": "German mineralogist and geologist, associated with Humboldt.", "wikidata_id": "Q64561", "wikidata_description": "German mineralogist and university teacher (1798-1873)", "wikipedia_url": "https://en.wikipedia.org/wiki/Gustav%20Rose", "wikipedia_extract": "Prof Gustavus (\"Gustav\") Rose FRSFor HFRSE (18 March 1798 \u2013 15 July 1873) was a German mineralogist who was a native of Berlin. He was President of the German Geological Society from 1863 to 1873. He was born in Berlin the son of pharmacologist Valentin Rose. Rose was a graduate of the University of Berlin, where he was a student of mineralogist Christian Samuel Weiss (1780\u20131856). He also studied under Swedish physical chemist J\u00f6ns Jakob Berzelius (1779\u20131848) in Stockholm. While studying with Berzelius, Rose met German chemist Eilhard Mitscherlich (1794\u20131863), with whom he maintained a lifelong friendship."}}, {"canonical_name": "perceptions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "perceptions", "book_id": "principles_of_psychology_james_1890", "name": "perceptions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 13, "variants": ["perceptions"], "contexts": ["engendered by association of ideas", "grouping of sensations"]}, {"entity_id": "tactual_perceptions", "book_id": "first_principles_spencer_1862", "name": "tactual perceptions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["tactual perceptions"], "contexts": ["perceptions gained through touch", "perceptions received through touch"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "perceptions", "target_book": "first_principles_spencer_1862", "target_name": "tactual perceptions", "similarity": 0.887}], "id": 2555, "stable_key": "clu_00b290e22a7acc10-2", "ground_truth": {"modern_name": "Perception", "confidence": "high", "type": "concept", "wikidata_id": "Q160402", "wikidata_description": "organization, identification, and interpretation of sensory information in order to represent and understand the environment in the brain", "note": "While 'perceiving subject' refers to the entity doing the perceiving, the core concept being discussed across both instances is the act or process of perceiving."}}, {"canonical_name": "emotion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "emotion", "book_id": "principles_of_psychology_james_1890", "name": "emotion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["emotion"], "contexts": ["sea of feeling", "feeling or mood"]}, {"entity_id": "emotion", "book_id": "first_principles_spencer_1862", "name": "emotion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["emotion"], "contexts": ["strong feeling", "subjective experience of feeling"]}, {"entity_id": "emotional", "book_id": "first_principles_spencer_1862", "name": "emotional", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["emotional"], "contexts": ["relating to emotions"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "emotion", "target_book": "first_principles_spencer_1862", "target_name": "emotion", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "emotion", "target_book": "first_principles_spencer_1862", "target_name": "emotional", "similarity": 0.931}], "id": 2556, "stable_key": "clu_a5707314b67e2cd7-3", "ground_truth": {"modern_name": "emotions", "confidence": "high", "type": "concept", "wikidata_id": "Q208166", "wikidata_description": "personality disorder characterized by variability of moods and unstable relationships", "wikipedia_url": "https://en.wikipedia.org/wiki/Borderline%20personality%20disorder", "wikipedia_extract": "Borderline personality disorder (BPD) is a personality disorder characterized by a pervasive, long-term pattern of significant interpersonal relationship instability, acute fear of abandonment, and intense emotional outbursts. People with BPD frequently exhibit self-harming behaviours and engage in risky activities, primarily caused by difficulties in regulating emotions. Symptoms such as dissociation, a pervasive sense of emptiness, and distorted sense of self are prevalent. Onset of symptoms can be triggered by events others perceive as normal, with the disorder typically manifesting in early adulthood and persisting across diverse contexts. BPD is often comorbid with substance use disorders, depressive disorders, and eating disorders. Studies estimate up to 10 percent of people with BPD die by suicide."}}, {"canonical_name": "integration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "integration", "book_id": "principles_of_psychology_james_1890", "name": "integration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["integration"], "contexts": ["process of compounding units of feeling", "process of combining into a whole"]}, {"entity_id": "integration", "book_id": "first_principles_spencer_1862", "name": "integration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["integration"], "contexts": ["combining elements into a whole", "process of combining or uniting"]}, {"entity_id": "integrations", "book_id": "first_principles_spencer_1862", "name": "integrations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["integrations"], "contexts": ["fusion or unification of parts"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "integration", "target_book": "first_principles_spencer_1862", "target_name": "integration", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "integration", "target_book": "first_principles_spencer_1862", "target_name": "integrations", "similarity": 0.873}], "id": 2557, "stable_key": "clu_348a4ea4c7873acc", "ground_truth": {"modern_name": "Integration", "confidence": "high", "type": "concept", "wikidata_id": "Q10536146", "wikidata_description": "process of social integration of immigrants or immigrated persons", "wikipedia_url": "https://en.wikipedia.org/wiki/Integration%20of%20immigrants", "wikipedia_extract": "The integration of immigrants, or migrant integration, is primarily the process of socioeconomic integration of immigrants and their descendants into a society through emancipatory and collective care values of the host country. Secondarily, it involves the gradual access to equal opportunities with other residents in terms of community duties and political participation. Central aspects of socioeconomic integration include overcoming barriers related to language, education, labour market participation, and identification with social values and the host country. The topic covers both the individual affairs of immigrants in their everyday lives and the socio-cultural phenomena of the host society. Social discourse about the integration of immigrants has often not only been about immigrants themselves (first-generation migrants, \"foreigner integration\" in the narrower sense), but also about the integration of the future generation(s), who are usually already naturalized or born as citizens, the \"integration of people with a migration background\" or \"with an immigration history\". Special cases of group-specific integration include the integration of linguistic, cultural or ethnic minorities who immigrated a long time ago."}}, {"canonical_name": "prism", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "prism", "book_id": "principles_of_psychology_james_1890", "name": "prism", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["prism"], "contexts": ["optical instrument used in experiments", "optical device to alter light path"]}, {"entity_id": "prism", "book_id": "connexion_physical_sciences_somerville_1858", "name": "prism", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 11, "variants": ["prism"], "contexts": ["used for light decomposition", "optical instrument for dispersion"]}, {"entity_id": "prisms", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Prisms", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Prisms", "prisms"], "contexts": ["optical instruments for light dispersion", "optical instruments for spectrum analysis"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "prism", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "prism", "similarity": 0.831}, {"source_book": "principles_of_psychology_james_1890", "source_name": "prism", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Prisms", "similarity": 0.944}], "id": 2558, "stable_key": "clu_a2e677644afe063c", "ground_truth": {"modern_name": "Prism", "confidence": "high", "type": "object", "wikidata_id": "Q165896", "wikidata_description": "transparent optical element with flat, polished surfaces that refract light", "wikipedia_url": "https://en.wikipedia.org/wiki/Prism%20%28optics%29", "wikipedia_extract": "An optical prism is a transparent optical element with flat, polished surfaces that are designed to refract light. At least one surface must be angled\u2014elements with only two parallel surfaces are windows, not prisms. The most familiar type of optical prism is the triangular prism, which has a triangular base and rectangular sides. Not all optical prisms are geometric prisms, and not all geometric prisms would count as an optical prism. Prisms can be made from any material that is transparent to the wavelengths for which they are designed. Typical materials include glass, acrylic and fluorite."}}, {"canonical_name": "yellow", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "yellow", "book_id": "principles_of_psychology_james_1890", "name": "yellow", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["yellow"], "contexts": ["color perceived from combined lights"]}, {"entity_id": "yellow", "book_id": "connexion_physical_sciences_somerville_1858", "name": "yellow", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 14, "variants": ["yellow"], "contexts": ["colour in the spectrum", "color reflected by yellow cloth"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "yellow", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "yellow", "similarity": 1.0}], "id": 2559, "stable_key": "clu_006fa2c6e40ba6aa", "ground_truth": {"modern_name": "Yellow", "confidence": "high", "type": "chemical", "note": "Refers to the color yellow, often discussed in optics and perception.", "wikidata_id": "Q1148004", "wikidata_description": "mosquito species, a vector for diseases including yellow fever and Zika fever"}}, {"canonical_name": "cranium", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "cranium", "book_id": "principles_of_psychology_james_1890", "name": "cranium", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["cranium"], "contexts": ["skull enclosing the brain"]}, {"entity_id": "cranium", "book_id": "polyanthea_medicinal", "name": "cranium", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 14, "variants": ["cranium", "Craneo", "cranio"], "contexts": ["skull", "part of the head"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "cranium", "target_book": "polyanthea_medicinal", "target_name": "cranium", "similarity": 1.0}], "id": 2560, "stable_key": "clu_cd907ba871fb2c47", "ground_truth": {"modern_name": "Cranium", "confidence": "high", "type": "object", "note": "Anatomical term for the skull.", "wikidata_id": "Q13147", "wikidata_description": "bony or cartilaginous structure that forms the skeleton of head in vertebrates"}}, {"canonical_name": "Sir Humphry Davy", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "sir_humphrey_davy", "book_id": "kosmos_humboldt_1845", "name": "Sir Humphrey Davy", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Sir Humphrey Davy"], "contexts": ["invited to subterranean expedition", "discovered metals acting on Earth's crust"]}, {"entity_id": "davy,_sir_humphrey", "book_id": "kosmos_humboldt_1845", "name": "Davy, Sir Humphrey", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Davy, Sir Humphrey"], "contexts": ["proposed hypothesis on volcanic phenomena"]}, {"entity_id": "sir_humphry_davy", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Sir Humphry Davy", "category": "PERSON", "subcategory": "SCHOLAR", "count": 10, "variants": ["Sir Humphry Davy"], "contexts": ["pioneer of photographic pictures", "produced profiles on prepared surfaces"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Sir Humphrey Davy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Sir Humphry Davy", "similarity": 0.992}, {"source_book": "kosmos_humboldt_1845", "source_name": "Davy, Sir Humphrey", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Sir Humphry Davy", "similarity": 0.936}], "id": 2561, "stable_key": "clu_5026748bdb62d20f-2", "ground_truth": {"modern_name": "Humphry Davy", "confidence": "high", "type": "person", "birth_year": 1778, "death_year": 1829, "description": "Chemist and inventor, pioneer in electrochemistry and photography.", "wikidata_id": "Q5941768", "wikidata_description": "British baronet and physician (1862\u20131944)", "wikipedia_url": "https://en.wikipedia.org/wiki/Humphry%20Rolleston", "wikipedia_extract": "Sir Humphry Davy Rolleston, 1st Baronet,  (21 June 1862 \u2013 23 September 1944) was a prominent English physician. Rolleston was the son of George Rolleston (Linacre Professor of Physiology at Oxford) and Grace Davy, daughter of John Davy and niece of Sir Humphry Davy, Bt (chemist). He was educated at Marlborough College, proceeded to St John's College, Cambridge and graduated in Natural Sciences in 1886. After clinical training at St Bartholomew's Hospital, London he qualified MB (Cambridge) in 1888 and MD in 1892. In 1891 he became Physician at St George's Hospital, Hyde Park Corner, London and continued there until 1919. This period, however, was interrupted by his service during the Second Boer War, where he served with the Imperial Yeomanry Hospital, Pretoria."}}, {"canonical_name": "lightning", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "flash_of_lightning", "book_id": "kosmos_humboldt_1845", "name": "flash of lightning", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["flash of lightning"], "contexts": ["sudden electrical discharge"]}, {"entity_id": "lightning", "book_id": "connexion_physical_sciences_somerville_1858", "name": "lightning", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 14, "variants": ["Lightning", "lightning"], "contexts": ["powerful electrical discharge in atmosphere", "electrical discharge in atmosphere"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "flash of lightning", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lightning", "similarity": 0.943}], "id": 2562, "stable_key": "clu_89a297b4a3b6992e", "ground_truth": {"modern_name": "lightning", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "p\u00e1o da China", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "p\u00e1o_da_china", "book_id": "coloquios_da_orta_1563", "name": "p\u00e1o da China", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["p\u00e1o da China", "pao da China", "pau da China"], "contexts": ["wood of China, likely referring to cinnamon", "wood from China, likely guaiacum"]}, {"entity_id": "paodachina", "book_id": "polyanthea_medicinal", "name": "paodaChina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["paodaChina"], "contexts": ["plant used in medicinal preparations"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "p\u00e1o da China", "target_book": "polyanthea_medicinal", "target_name": "paodaChina", "similarity": 0.853}], "id": 2563, "stable_key": "clu_70c667b12729e4f4", "ground_truth": {"modern_name": "p\u00e1o da China", "confidence": "high", "type": "plant", "description": "Wood from China, likely referring to cinnamon or guaiacum.", "note": "Portuguese term for a medicinal wood.", "wikipedia_extract": "The cash or qian was a type of coin of China and the Sinosphere, used from the 4th century BC until the 20th century, characterised by their round outer shape and a square center hole (Chinese: \u65b9\u7a7f; pinyin: f\u0101ng chu\u0101n; Jyutping: fong1 cyun1; Pe\u030dh-\u014de-j\u012b: hong-chhoan). Originally cast during the Warring States period, these coins continued to be used for the entirety of Imperial China. The last Chinese cash coins were cast in 1912, the first year of the Republic of China. Generally most cash coins were made from copper or bronze alloys, with iron, lead, and zinc coins occasionally used less often throughout Chinese history. Rare silver and gold cash coins were also produced. During most of their production, cash coins were cast, but during the late Qing dynasty, machine-struck cash coins began to be made."}}, {"canonical_name": "Assa f\u00e9tida", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "assa_f\u00e9tida", "book_id": "coloquios_da_orta_1563", "name": "Assa f\u00e9tida", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 13, "variants": ["ASSA F\u00c9TIDA", "assa f\u00e9tida", "Assa f\u00e9tida"], "contexts": ["plant to be discussed", "name of a plant"]}, {"entity_id": "assa_fetida", "book_id": "ricettario_fiorentino_1597", "name": "ASSA FETIDA", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Assa fetida", "ASSA FETIDA"], "contexts": ["fragrant resin", "plant producing fetid resin"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Assa f\u00e9tida", "target_book": "ricettario_fiorentino_1597", "target_name": "ASSA FETIDA", "similarity": 0.752}], "id": 2564, "stable_key": "clu_b4afad0e4a192623", "ground_truth": {"modern_name": "asafoetida", "confidence": "high", "type": "plant", "linnaean": "Ferula assa-foetida", "family": "Apiaceae", "note": "The term 'Assa f\u00e9tida' clearly refers to the pungent resin obtained from the roots of Ferula species, commonly known as asafoetida."}}, {"canonical_name": "oliveira", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "oliveira", "book_id": "coloquios_da_orta_1563", "name": "oliveira", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 10, "variants": ["oliveira", "olivastro", "oliveiras"], "contexts": ["tree size comparison", "tree comparison"]}, {"entity_id": "oliveyra", "book_id": "polyanthea_medicinal", "name": "oliveyra", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["oliveyra", "Oliveyra", "olivera"], "contexts": ["signer of document", "author of the text"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "oliveira", "target_book": "polyanthea_medicinal", "target_name": "oliveyra", "similarity": 0.947}], "id": 2565, "stable_key": "clu_a9dd0ce84803661e", "ground_truth": {"modern_name": "olive tree", "confidence": "high", "type": "plant", "linnaean": "Olea europaea", "family": "Oleaceae", "description": "Tree producing olives and olive oil, valued for its fruit and oil.", "wikipedia_extract": "The olive (botanical name Olea europaea, \"European olive\") is a species of subtropical evergreen tree in the family Oleaceae. Originating in Asia Minor, it is abundant throughout the Mediterranean Basin, with wild subspecies in Africa and western Asia; modern cultivars are traced primarily to the Near East, Aegean Sea, and Strait of Gibraltar. The olive is the type species for its genus, Olea, and lends its name to the Oleaceae plant family, which includes lilac, jasmine, forsythia, and ash. The olive fruit is classed botanically as a drupe, similar in structure and function to the cherry or peach. The term oil\u2014now used to describe any viscous water-insoluble liquid\u2014was originally synonymous with olive oil, the liquid fat derived from olives. The olive has deep historical, economic, and cultural significance in the Mediterranean."}}, {"canonical_name": "azeite", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "azeite", "book_id": "coloquios_da_orta_1563", "name": "azeite", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 10, "variants": ["azeite"], "contexts": ["oil", "oil made from cinnamon"]}, {"entity_id": "azeite", "book_id": "polyanthea_medicinal", "name": "azeite", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 5, "variants": ["azeite"], "contexts": ["oil, some cannot eat", "oil, likely olive oil"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "azeite", "target_book": "polyanthea_medicinal", "target_name": "azeite", "similarity": 1.0}], "id": 2566, "stable_key": "clu_07275e11ee88d3c1", "ground_truth": {"modern_name": "Olive oil", "confidence": "high", "type": "chemical", "note": "'Azeyte ordinario' and 'azeytes' in these texts refer to common oils, most frequently olive oil, used in preparations and ointments.", "wikidata_id": "Q2641560", "wikidata_description": "Process of extracting oil from olives", "wikipedia_url": "https://en.wikipedia.org/wiki/Olive%20oil%20extraction", "wikipedia_extract": "Olive oil is a vegetable oil obtained by pressing whole olives (the fruit of Olea europaea, a traditional tree crop of the Mediterranean Basin) and extracting the oil. It is commonly used in cooking for frying foods, as a condiment, or as a salad dressing. It can also be found in some cosmetics, pharmaceuticals, soaps, and fuels for traditional oil lamps. It also has additional uses in some religions. The olive is one of three core food plants in Mediterranean cuisine, with wheat and grapes. Olive trees have been cultivated around the Mediterranean since the 8th millennium BC."}}, {"canonical_name": "Greguos", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "greguos", "book_id": "coloquios_da_orta_1563", "name": "Greguos", "category": "PERSON", "subcategory": "AUTHORITY", "count": 9, "variants": ["Greguos", "Greguo"], "contexts": ["people who used other medicines", "ancient Greek authorities"]}, {"entity_id": "gregos", "book_id": "polyanthea_medicinal", "name": "Gregos", "category": "PERSON", "subcategory": "AUTHORITY", "count": 6, "variants": ["Gregos", "Greg"], "contexts": ["ancient Greeks who named medical conditions", "ancient Greek medical authorities"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Greguos", "target_book": "polyanthea_medicinal", "target_name": "Gregos", "similarity": 0.878}], "id": 2567, "stable_key": "clu_45dfb96b151fad94-2", "ground_truth": {"modern_name": "Greeks", "confidence": "high", "type": "person", "description": "Ancient Mediterranean people and civilization.", "note": "Refers to the people of ancient Greece, known for their contributions to philosophy, science, and medicine.", "wikidata_id": "Q25688688", "wikidata_description": "people of ancient Greece"}}, {"canonical_name": "Acoro", "category": "PLANT", "subcategory": "ROOT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "a\u00e7oro", "book_id": "coloquios_da_orta_1563", "name": "a\u00e7oro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["a\u00e7oro"], "contexts": ["plant used in place of amomum", "plant name"]}, {"entity_id": "acoro", "book_id": "ricettario_fiorentino_1597", "name": "Acoro", "category": "PLANT", "subcategory": "ROOT", "count": 8, "variants": ["acoro", "Acoro"], "contexts": ["plant with leaves and roots like iris", "plant related to calamo aromatico"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "a\u00e7oro", "target_book": "ricettario_fiorentino_1597", "target_name": "Acoro", "similarity": 0.675}], "id": 2568, "stable_key": "clu_a72999d0991bcbf4", "ground_truth": {"modern_name": "sweet flag", "confidence": "high", "type": "plant", "linnaean": "Acorus calamus Linnaeus", "family": "Acoraceae", "note": "The spellings 'a\u00e7oro' and 'Acoro' are consistent with the plant Acorus calamus."}}, {"canonical_name": "pao de Aguila", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "p\u00e1o_de_aguila", "book_id": "coloquios_da_orta_1563", "name": "p\u00e1o de aguila", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["p\u00e1o de aguila", "pau de aguila"], "contexts": ["Portuguese name for aloes wood", "wood product"]}, {"entity_id": "pao_de_aguila", "book_id": "polyanthea_medicinal", "name": "pao de Aguila", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 12, "variants": ["pao de Aguila", "PaodeAguila", "paode Aguila", "paode aguila", "paodeAguila", "p\u00e0o de Aguila", "p\u00e3o de Aguila", "p\u00e3odeAguila", "p\u00f2 de p\u00e1ode Aguila"], "contexts": ["ingredient in tobacco", "ingredient in a remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "p\u00e1o de aguila", "target_book": "polyanthea_medicinal", "target_name": "pao de Aguila", "similarity": 0.954}], "id": 2569, "stable_key": "clu_032b40c540f04fcf", "ground_truth": {"modern_name": "aloes wood", "confidence": "high", "type": "plant", "description": "Fragrant wood used as incense and in traditional medicine.", "note": "Also known as agarwood or oud.", "wikipedia_extract": "Agarwood, aloeswood, eaglewood, gaharuwood, commonly referred to as oud or oudh (from Arabic: \u0639\u0648\u062f, romanized: \u02bf\u016bd, pronounced [\u0295u\u02d0d]), is a fragrant, dark and resinous wood used in incense, perfume, and small hand carvings. It forms in the heartwood of Aquilaria trees after they become infected with a type of Phaeoacremonium mold, P. parasitica. The tree defensively secretes a resin to combat the fungal infestation. Prior to becoming infected, the heartwood mostly lacks scent, and is relatively light and pale in colouration. However, as the infection advances and the tree produces its fragrant resin as a final option of defense, the heartwood becomes very dense, dark, and saturated with resin. This product is harvested, and most famously referred to in cosmetics under the scent names of oud, oodh or aguru; however, it is also called aloes (not to be confused with the succulent plant genus Aloe), agar (this name, as well, is not to be confused with the edible, algae-derived thickening agent agar agar), as well as gaharu or jinko."}}, {"canonical_name": "marmelada", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "marmelada", "book_id": "coloquios_da_orta_1563", "name": "marmelada", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["marmelada"], "contexts": ["sweet preserve made from fruit"]}, {"entity_id": "marmelada", "book_id": "polyanthea_medicinal", "name": "marmelada", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 14, "variants": ["marmelada", "marmelada crua", "marmelada de\u00e7umos"], "contexts": ["marmalade used as a binder", "conserve made from quince"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "marmelada", "target_book": "polyanthea_medicinal", "target_name": "marmelada", "similarity": 1.0}], "id": 2570, "stable_key": "clu_c0352f6d1253f493", "ground_truth": {"modern_name": "marmalade", "confidence": "high", "type": "object", "description": "Sweet preserve, typically made from fruit juice and rind.", "wikipedia_extract": "Marmalade is a sweet, tangy fruit preserve made from the juice and peel of citrus fruits boiled with sugar and water. The well-known version is made from bitter orange, but other citrus fruits such as lemons and limes can also be used. The bitter orange is mostly used in marmalade because of its high pectin content, which gives a thick consistency to its marmalade. In addition, the balance of acid and pectin is needed for consistency. Fruits with low pectin have it added to make the marmalade. Historically, the term marmalade was often used for non-citrus preserves."}}, {"canonical_name": "Afaro", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "afaro", "book_id": "ricettario_fiorentino_1597", "name": "Afaro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 10, "variants": ["Afaro", "Af^ro", "Afarb", "Af\u00e0ro", "afaro"], "contexts": ["root collected whole", "spice, likely saffron"]}, {"entity_id": "a_faro", "book_id": "ricettario_fiorentino_1597", "name": "A faro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["A faro"], "contexts": ["ingredient in a preparation", "saffron"]}, {"entity_id": "afar\u00f2", "book_id": "ricettario_fiorentino_1597", "name": "Afar\u00f2", "category": "PLANT", "subcategory": "ROOT", "count": 1, "variants": ["Afar\u00f2"], "contexts": ["root from the spice trade"]}, {"entity_id": "afaro", "book_id": "polyanthea_medicinal", "name": "Afaro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Afaro"], "contexts": ["root used in emetic preparation", "herb"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Afaro", "target_book": "polyanthea_medicinal", "target_name": "Afaro", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "A faro", "target_book": "polyanthea_medicinal", "target_name": "Afaro", "similarity": 0.667}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Afar\u00f2", "target_book": "polyanthea_medicinal", "target_name": "Afaro", "similarity": 0.613}], "id": 2571, "stable_key": "clu_a4b1eb3191537d7d", "ground_truth": {"modern_name": "saffron", "confidence": "high", "type": "plant", "linnaean": "Crocus sativus", "family": "Iridaceae", "description": "Spice derived from the stigmas of Crocus flowers, used for color and flavor.", "wikipedia_extract": "Crocus sativus, commonly known as saffron crocus or autumn crocus, is a species of flowering plant in the iris family Iridaceae. A cormous autumn-flowering cultivated perennial, unknown in the wild, it is best known for the culinary use of its floral stigmas as the spice saffron. Human cultivation of saffron crocus and the trade and use of saffron have endured for more than 3,500 years and span different cultures, continents, and civilizations. The plant is most commonly known as the saffron crocus. The alternative name autumn crocus is also used for species in the Colchicum genus, which are not closely related but strongly resemble the true crocuses; in particular, the superficially similar species Colchicum autumnale is sometimes even referred to as meadow saffron. However, the true crocuses have three stamens and one style supporting three long stigmas, while colchicums have six stamens and three styles; and belong to a different family, Colchicaceae."}}, {"canonical_name": "agrimonia", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "agrimonia", "book_id": "ricettario_fiorentino_1597", "name": "Agrimonia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Agrimonia"], "contexts": ["plant commonly called Agrimonia"]}, {"entity_id": "agrimonia", "book_id": "polyanthea_medicinal", "name": "agrimonia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["agrimonia"], "contexts": ["herb used in a medicinal preparation", "ingredient in a medicinal preparation"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Agrimonia", "target_book": "polyanthea_medicinal", "target_name": "agrimonia", "similarity": 0.731}], "id": 2572, "stable_key": "clu_9a7fc84ad3bf4737", "ground_truth": {"modern_name": "Agrimony", "confidence": "high", "type": "plant", "linnaean": "Agrimonia eupatoria", "family": "Rosaceae", "description": "An herb with yellow flowers, historically used in medicine.", "wikipedia_extract": "Agrimonia eupatoria is a species of agrimony that is often referred to as common agrimony, church steeples or sticklewort. The whole plant is dark green with numerous soft hairs. The soft hairs aid in the plant's seed pods sticking to any animal or person coming in contact with the plant. The flower spikes have a spicy odor like apricots. In the language of flowers, agrimony means thankfulness or gratitude. Agrimonia eupatoria is a foodplant for the caterpillars of the snout moth Endotricha flammealis."}}, {"canonical_name": "Magnetism", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "magnetic_bodies", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Magnetic bodies", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Magnetic Bodies", "Magnetic bodies"], "contexts": ["on Magnetic Bodies", "difference in power"]}, {"entity_id": "magnetism", "book_id": "first_principles_spencer_1862", "name": "Magnetism", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 12, "variants": ["Magnetism", "magnetism"], "contexts": ["formerly distinct imponderable", "sub-science integrated with others"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Magnetic bodies", "target_book": "first_principles_spencer_1862", "target_name": "Magnetism", "similarity": 0.885}], "id": 2573, "stable_key": "clu_d9f20d93894983f9", "ground_truth": {"modern_name": "Magnetism", "confidence": "high", "type": "concept", "wikidata_id": "Q3294789", "wikidata_description": "class of physical phenomena", "wikipedia_url": "https://en.wikipedia.org/wiki/Magnetism"}}, {"canonical_name": "th\u00e9orie", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "th\u00e9orie", "book_id": "medecine_experimentale_bernard_1865", "name": "th\u00e9orie", "category": "CONCEPT", "subcategory": "THEORY", "count": 13, "variants": ["th\u00e9orie"], "contexts": ["abstract framework for understanding phenomena", "scientific theory"]}, {"entity_id": "th\u00e9orie", "book_id": "epoques_nature_buffon_1778", "name": "th\u00e9orie", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["th\u00e9orie"], "contexts": ["explanation of global cooling and population"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "th\u00e9orie", "target_book": "epoques_nature_buffon_1778", "target_name": "th\u00e9orie", "similarity": 1.0}], "id": 2574, "stable_key": "clu_4000185648709cf2", "ground_truth": {"modern_name": "Theory", "confidence": "high", "type": "concept", "wikidata_id": "Q3239681", "wikidata_description": "explanation of some aspect of the natural world which can be tested and corroborated", "wikipedia_url": "https://en.wikipedia.org/wiki/Scientific%20theory"}}, {"canonical_name": "th\u00e9ories", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "th\u00e9ories", "book_id": "medecine_experimentale_bernard_1865", "name": "th\u00e9ories", "category": "CONCEPT", "subcategory": "THEORY", "count": 11, "variants": ["th\u00e9ories"], "contexts": ["scientific theories", "frameworks of explanation"]}, {"entity_id": "theories", "book_id": "principles_of_psychology_james_1890", "name": "theories", "category": "CONCEPT", "subcategory": "THEORY", "count": 3, "variants": ["theories"], "contexts": ["engendered by association of ideas", "explanations of phenomena"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "th\u00e9ories", "target_book": "principles_of_psychology_james_1890", "target_name": "theories", "similarity": 0.959}], "id": 2575, "stable_key": "clu_d73dba3c096265f6-2", "ground_truth": {"modern_name": "theory", "confidence": "high", "type": "concept", "description": "An abstract explanation or system of ideas for understanding phenomena.", "note": "'Theoriques' is the French plural of theoretical.", "wikipedia_extract": "A theory is, in general, any hypothesis or set of ideas about something, formed in any number of ways through any sort of reasoning for any sort of reason. When applied to intellectual or academic situations, it is considered a systematic and rational form of abstract thinking about a phenomenon, or the conclusions derived from such thinking. It involves contemplative and logical reasoning, often supported by processes such as observation, experimentation, and research. Theories can be scientific, falling within the realm of empirical and testable knowledge, or they may belong to non-scientific disciplines, such as philosophy, art, or sociology. In some cases, theories may exist independently of any formal discipline. In modern science, the term \"theory\" refers to scientific theories, a well-confirmed type of explanation of nature, made in a way consistent with the scientific method, and fulfilling the criteria required by modern science."}}, {"canonical_name": "azote", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "azote", "book_id": "medecine_experimentale_bernard_1865", "name": "azote", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["azote"], "contexts": ["element dissolved in organic liquids", "gas in the air"]}, {"entity_id": "azote", "book_id": "relation_historique_humboldt_vol3_1825", "name": "azote", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 11, "variants": ["azote", "azote pur", "gaz azote"], "contexts": ["gas likely contained in thermal spring bubbles", "mixed with oxygen"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "azote", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "azote", "similarity": 1.0}], "id": 2576, "stable_key": "clu_2c96b7af77424950", "ground_truth": {"modern_name": "Nitrogen", "confidence": "high", "type": "chemical", "note": "Also referred to as azote, an older name for nitrogen.", "wikidata_id": "Q14914558", "wikidata_description": "the chemical reactions and pathways involving organic or inorganic compounds that contain nitrogen"}}, {"canonical_name": "unconscious", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "inconsciente", "book_id": "medecine_experimentale_bernard_1865", "name": "inconsciente", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["inconsciente"], "contexts": ["unaware, not conscious"]}, {"entity_id": "unconscious", "book_id": "principles_of_psychology_james_1890", "name": "unconscious", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 13, "variants": ["unconscious", "UNCONSCIOUS"], "contexts": ["mental processes outside awareness", "lack of awareness"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "inconsciente", "target_book": "principles_of_psychology_james_1890", "target_name": "unconscious", "similarity": 0.886}], "id": 2577, "stable_key": "clu_a20c2ca384074742", "ground_truth": {"modern_name": "Unconscious", "confidence": "high", "type": "concept", "note": "Refers to the psychological concept of mental processes outside conscious awareness.", "wikidata_id": "Q192105", "wikidata_description": "group of psychic characters and processes that are reflected in behaviour, even though not shown in the conciousness", "wikipedia_url": "https://en.wikipedia.org/wiki/Unconscious%20mind"}}, {"canonical_name": "Quicksilver", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "quicksilver", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Quicksilver", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["Quicksilver"], "contexts": ["mercury, a liquid metal", "liquid metal in which crystal swims"]}, {"entity_id": "quick-silver", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Quick-silver", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Quick-silver", "quick-silver"], "contexts": ["metallic element, mercury", "mercury, added to gunpowder for force"]}, {"entity_id": "quick_silver", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Quick silver", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Quick silver"], "contexts": ["mercury", "mineral observed in mines"]}, {"entity_id": "quicksilver", "book_id": "connexion_physical_sciences_somerville_1858", "name": "quicksilver", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["quicksilver"], "contexts": ["dense metallic liquid", "liquid metal that would freeze on Mars"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Quicksilver", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "quicksilver", "similarity": 0.955}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Quick-silver", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "quicksilver", "similarity": 0.956}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Quick silver", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "quicksilver", "similarity": 0.931}], "id": 2578, "stable_key": "clu_7b4c22977030f8b9-3", "ground_truth": {"modern_name": "Quicksilver", "confidence": "high", "type": "chemical", "wikidata_id": "Q925", "wikidata_description": "chemical element with symbol Hg and atomic number 80", "wikipedia_extract": "Quicksilver is a 2024 romantasy novel by British author Callie Hart, the first in her Fae & Alchemy trilogy. Hart self-published the book in June 2024 after declining her literary agent's request for substantial revisions. Initial sales were modest, but the book found an audience after Hart sent copies to BookTok creators on TikTok, generating over three million views within two months. The viral attention sparked a 10-bidder auction for publishing rights. Forever, an imprint of Grand Central Publishing, won the auction, releasing a traditional edition on December 3, 2024 that debuted at number one on The New York Times Best Seller list. That same week, Netflix acquired film adaptation rights for seven figures.", "wikipedia_url": "https://en.wikipedia.org/wiki/Quicksilver_(Hart_novel)", "note": "'Azougue' and 'Azogue' are archaic terms for mercury, commonly used in Iberian languages."}}, {"canonical_name": "Quartan Agues", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "quartane_ague", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Quartane Ague", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["Quartane Ague"], "contexts": ["Type of fever"]}, {"entity_id": "quartan_agues", "book_id": "english_physician_1652", "name": "Quartan Agues", "category": "DISEASE", "subcategory": "ACUTE", "count": 13, "variants": ["Quartan Agues", "Quartan", "Quartan Ague", "Quartane Agues", "Quar\u2223tanes"], "contexts": ["fever cured by sympathy to Saturn", "ague removed by the herb"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Quartane Ague", "target_book": "english_physician_1652", "target_name": "Quartan Agues", "similarity": 0.886}], "id": 2579, "stable_key": "clu_e20c8d504156d1d1", "ground_truth": {"modern_name": "Quartan fever", "confidence": "high", "type": "disease", "description": "A type of malaria characterized by fevers occurring every fourth day.", "wikipedia_extract": "Quartan fever is one of the four types of malaria which can be contracted by humans. It is specifically caused by the Plasmodium malariae species, one of the six species of the protozoan genus Plasmodium. Quartan fever is a form of malaria where an onset of fever occurs in an interval of three to four days, hence the name \"quartan\". It is transmitted by bites of infected female mosquitoes of the genus Anopheles. Symptoms include fevers which range from approximately 40\u201341 \u00b0C (104\u2013106 \u00b0F) and occur periodically in 72 hour intervals. Although cases of malaria have occurred throughout the world, quartan fever typically occurs in the subtropics."}}, {"canonical_name": "lacca", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "lacca", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Lacca", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Lacca"], "contexts": ["juice concrete drawing not at all"]}, {"entity_id": "lacca", "book_id": "coloquios_da_orta_1563", "name": "lacca", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 13, "variants": ["lacca", "laca"], "contexts": ["animal product from insect on tree branches", "animal product formed by insect on plant"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lacca", "target_book": "coloquios_da_orta_1563", "target_name": "lacca", "similarity": 0.814}], "id": 2580, "stable_key": "clu_a14943995e24e599", "ground_truth": {"modern_name": "Shellac", "confidence": "high", "type": "chemical", "note": "Shellac is a processed resin produced by the lac insect. The description 'processed lacca by fusion' and 'resin used in varnish' directly aligns with shellac.", "wikidata_id": "Q72507464", "wikidata_description": "chemical compound"}}, {"canonical_name": "Countries", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "countries", "book_id": "english_physician_1652", "name": "Countries", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 11, "variants": ["Countries"], "contexts": ["geographic locations where herbs grow", "divers countries of this Nation"]}, {"entity_id": "countries", "book_id": "origin_of_species_darwin_1859", "name": "countries", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["countries"], "contexts": ["geographic locations", "locations with domesticated animals"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Countries", "target_book": "origin_of_species_darwin_1859", "target_name": "countries", "similarity": 0.981}], "id": 2581, "stable_key": "clu_11ee66e3865f1caa", "ground_truth": {"modern_name": "Countries", "confidence": "high", "type": "place", "wikidata_id": "Q6256", "wikidata_description": "distinct territorial body or political entity"}}, {"canonical_name": "transpira\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "sweating", "book_id": "english_physician_1652", "name": "sweating", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["sweating"], "contexts": ["expulsion method for disease", "bodily process to expel venom"]}, {"entity_id": "transpira\u00e7\u00e3o", "book_id": "polyanthea_medicinal", "name": "transpira\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 12, "variants": ["transpira\u00e7\u00e3o", "tranfpira\u00e7ao", "transpira\u00e7ao", "tran\u017fpiratio", "tran\u017fpira\u00e7\u00e3o", "tran\u017fpirem"], "contexts": ["bodily process", "bodily process, opening pores for"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "sweating", "target_book": "polyanthea_medicinal", "target_name": "transpira\u00e7\u00e3o", "similarity": 0.929}], "id": 2582, "stable_key": "clu_958fc371295918b8", "ground_truth": {"modern_name": "Perspiration", "confidence": "high", "type": "concept", "wikidata_id": "Q3503092", "wikidata_description": "substance secreted by sweat gland", "wikipedia_url": "https://en.wikipedia.org/wiki/Perspiration", "wikipedia_extract": "Perspiration, also known as sweat, is the fluid secreted by sweat glands in the skin of mammals. Two types of sweat glands can be found in humans: eccrine glands and apocrine glands. The eccrine sweat glands are distributed over much of the body and are responsible for secreting the watery, brackish sweat most often triggered by excessive body temperature. Apocrine sweat glands are restricted to the armpits and a few other areas of the body and produce an odorless, oily, opaque secretion which then gains its characteristic odor from bacterial decomposition. In humans, sweating is primarily a means of thermoregulation, which is achieved by the water-rich secretion of the eccrine glands. Maximum sweat rates of an adult can be up to 2\u20134 litres (0.5\u20131 US gal) per hour or 10\u201314 litres (2.5\u20133.5 US gal) per day, but is less in children prior to puberty."}}, {"canonical_name": "Geographical distribution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "geographical_distribution", "book_id": "origin_of_species_darwin_1859", "name": "Geographical distribution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 10, "variants": ["Geographical distribution", "geographical distribution", "GEOGRAPHICAL DISTRIBUTION"], "contexts": ["study of species locations", "spatial arrangement of organisms"]}, {"entity_id": "geographical_distribution", "book_id": "kosmos_humboldt_1845", "name": "geographical distribution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["geographical distribution"], "contexts": ["influence on cultivated plants", "spread of types across the Earth"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Geographical distribution", "target_book": "kosmos_humboldt_1845", "target_name": "geographical distribution", "similarity": 0.968}], "id": 2583, "stable_key": "clu_1b6dfc0941e33195", "ground_truth": {"modern_name": "Biogeography", "confidence": "high", "type": "concept", "note": "While 'Geographical distribution' is the literal translation, 'Biogeography' is the more precise modern scientific term for this concept."}}, {"canonical_name": "instincts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "instincts", "book_id": "origin_of_species_darwin_1859", "name": "instincts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 10, "variants": ["instincts"], "contexts": ["innate behavioral patterns", "innate behavioral patterns in animals"]}, {"entity_id": "instincts", "book_id": "principles_of_psychology_james_1890", "name": "Instincts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["instincts", "Instincts"], "contexts": ["native tendencies to reaction", "innate behavioral patterns"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "instincts", "target_book": "principles_of_psychology_james_1890", "target_name": "Instincts", "similarity": 0.933}], "id": 2584, "stable_key": "clu_a76d4c90e69b981a-3", "ground_truth": {"modern_name": "Instinct", "confidence": "high", "type": "concept", "wikidata_id": "Q18237", "wikidata_description": "inherent inclination of a living organism"}}, {"canonical_name": "hinchazones", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "hinchazones", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "hinchazones", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 7, "variants": ["hinchazones"], "contexts": ["swelling", "swellings repelled by the seed"]}, {"entity_id": "hinchazones", "book_id": "historia_medicinal_monardes_1574", "name": "hinchazones", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 7, "variants": ["hinchazones", "hincha", "hinchazon", "inhinchaz\u00f3nes"], "contexts": ["