ae59", "ground_truth": {"modern_name": "Diarrhea", "confidence": "high", "type": "disease", "modern_term": "Diarrhea", "note": "'Fluxo de vientre' directly translates to 'flux of the belly' and is a historical term for diarrhea or dysentery.", "wikidata_id": "Q4293116", "wikidata_description": "Human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Microvillous%20inclusion%20disease"}}, {"canonical_name": "M. Arago", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "m__arago", "book_id": "relation_historique_humboldt_vol3_1825", "name": "M. Arago", "category": "PERSON", "subcategory": "SCHOLAR", "count": 9, "variants": ["M. Arago"], "contexts": ["observer in Spain and France", "published barometer variation tables"]}, {"entity_id": "m__arago", "book_id": "connexion_physical_sciences_somerville_1858", "name": "M. Arago", "category": "PERSON", "subcategory": "SCHOLAR", "count": 8, "variants": ["M. Arago"], "contexts": ["experimenter on magnetism", "suggested experiment on light velocity"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "M. Arago", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "M. Arago", "similarity": 1.0}], "id": 2486, "stable_key": "clu_ad2a90f941b69da9", "ground_truth": {"modern_name": "Dominique Fran\u00e7ois Jean Arago", "confidence": "high", "type": "person", "birth_year": 1786, "death_year": 1853, "description": "French physicist, astronomer, and politician, known for magnetism and light.", "note": "The initials 'M.' are common for addressing gentlemen in this period. Arago was a prominent figure in science during the early 19th century."}}, {"canonical_name": "salses", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "salses", "book_id": "relation_historique_humboldt_vol3_1825", "name": "salses", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 4, "variants": ["Salses", "salses"], "contexts": ["phenomenon observed in the forest", "phenomenon observed by the author"]}, {"entity_id": "salses", "book_id": "kosmos_humboldt_1845", "name": "salses", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 13, "variants": ["salses", "Salses"], "contexts": ["mud volcanoes or saline springs", "mud volcanoes"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "salses", "target_book": "kosmos_humboldt_1845", "target_name": "salses", "similarity": 1.0}], "id": 2487, "stable_key": "clu_01e47070bcbbf972", "ground_truth": {"modern_name": "Salses", "confidence": "high", "type": "place", "country": "Trinidad and Tobago, Venezuela, etc.", "note": "Refers to mud volcanoes or saline springs, often associated with geological activity.", "wikidata_id": "Q193457", "wikidata_description": "landform created by the eruption of mud or slurries, water and gases", "wikipedia_extract": "The Fronde (French pronunciation: [f\u0281\u0254\u0303d] ) was a series of civil wars in the Kingdom of France between 1648 and 1653, occurring in the midst of the Franco-Spanish War, which had begun in 1635. The government of the young King Louis XIV confronted the combined opposition of the princes, the nobility, the noble regional court assemblies (parlements), as well as much of the French population, and managed to subdue them all. The dispute started when the government of France issued seven fiscal edicts, six of which were to increase taxation. The parlements resisted, questioned the constitutionality of the king's actions, and sought to check his powers. The Fronde was divided into two campaigns, the Parlementary Fronde and the Fronde of the Princes. The timing of the outbreak of the Parlementary Fronde, directly after the Peace of Westphalia (1648) that ended the Thirty Years' War, was significant.", "wikipedia_url": "https://en.wikipedia.org/wiki/The_Fronde"}}, {"canonical_name": "Schumacher", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "schumacher", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Schumacher", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Schumacher"], "contexts": ["published 'Astronomische Nachrichten'", "scholar cited for astronomical notices"]}, {"entity_id": "schumacher", "book_id": "kosmos_humboldt_1845", "name": "Schumacher", "category": "PERSON", "subcategory": "SCHOLAR", "count": 15, "variants": ["Schumacher"], "contexts": ["editor of 'Jahrbuch' and 'Astron. Nachr.'", "editor of astronomical publications"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Schumacher", "target_book": "kosmos_humboldt_1845", "target_name": "Schumacher", "similarity": 1.0}], "id": 2488, "stable_key": "clu_5cf828554ae066fd", "ground_truth": {"modern_name": "Heinrich Christian Schumacher", "confidence": "high", "type": "person", "birth_year": 1780, "death_year": 1850, "description": "Danish astronomer and geodesist, founder of 'Astronomische Nachrichten'.", "wikidata_id": "Q63140", "wikidata_description": "German-Danish astronomer (1780-1850)"}}, {"canonical_name": "Crawfiird", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "crawfard", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Crawfard", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Crawfard"], "contexts": ["author of Ind. Archipel"]}, {"entity_id": "crawfiird", "book_id": "coloquios_da_orta_1563", "name": "Crawfiird", "category": "PERSON", "subcategory": "SCHOLAR", "count": 16, "variants": ["Crawfiird", "Craw^rd", "Crawf\u00edird", "Craw\u00c3ird", "Craw\u00edurd", "Crayrfurd"], "contexts": ["author of a dictionary", "author of dictionary"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Crawfard", "target_book": "coloquios_da_orta_1563", "target_name": "Crawfiird", "similarity": 0.939}], "id": 2489, "stable_key": "clu_d903db1a4e86f34e", "ground_truth": {"modern_name": "John Crawfurd", "confidence": "high", "type": "person", "birth_year": 1783, "death_year": 1868, "description": "Scottish physician, ethnologist, and colonial administrator in Asia.", "wikidata_id": "Q76133855", "wikidata_description": "Peerage person ID=554576"}}, {"canonical_name": "Revue Philosophique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "revue_philosophique", "book_id": "principles_of_psychology_james_1890", "name": "Revue Philosophique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 16, "variants": ["Revue Philosophique"], "contexts": ["cited philosophical review", "journal publishing Hierzen's account"]}, {"entity_id": "philosophical_magazine", "book_id": "first_principles_spencer_1862", "name": "Philosophical Magazine", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Philosophical Magazine"], "contexts": ["scientific publication"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Revue Philosophique", "target_book": "first_principles_spencer_1862", "target_name": "Philosophical Magazine", "similarity": 0.904}], "id": 2490, "stable_key": "clu_44d4ba117e241272", "ground_truth": {"modern_name": "Revue Philosophique", "confidence": "medium", "type": "text", "note": "The members list includes both 'Revue Philosophique' and 'Philosophical Magazine'. While both are scientific publications, they are distinct entities. Without more context, it's difficult to definitively assign a single 'modern_name' to the cluster. 'Revue Philosophique' is given higher precedence due to its greater frequency in the provided data.", "wikidata_id": "Q3428762", "wikidata_description": "philosophical journal"}}, {"canonical_name": "conscious", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "conscious", "book_id": "principles_of_psychology_james_1890", "name": "conscious", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 13, "variants": ["conscious"], "contexts": ["having awareness", "mental states of awareness"]}, {"entity_id": "consciously", "book_id": "principles_of_psychology_james_1890", "name": "consciously", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["consciously"], "contexts": ["with conscious awareness", "awareness of mental states"]}, {"entity_id": "conscious", "book_id": "first_principles_spencer_1862", "name": "conscious", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["conscious"], "contexts": ["aware of sensations", "aware of one's surroundings and existence"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "conscious", "target_book": "first_principles_spencer_1862", "target_name": "conscious", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "consciously", "target_book": "first_principles_spencer_1862", "target_name": "conscious", "similarity": 0.917}], "id": 2491, "stable_key": "clu_fad1e6499454b3ca-2", "ground_truth": {"modern_name": "consciousness", "confidence": "high", "type": "concept", "note": "The overwhelming number of occurrences of 'consciousness' and related terms in William James's work firmly identifies this cluster.", "wikidata_id": "Q4313500", "wikidata_description": "medical condition that inhibits consciousness, sprituality", "wikipedia_url": "https://en.wikipedia.org/wiki/Disorder%20of%20consciousness", "wikipedia_extract": "Consciousness is being aware of something internal to one's self or being conscious of states or objects in one's external environment. It has been the topic of extensive explanations, analyses, and debate among philosophers, scientists, and theologians for millennia. There is no consensus on what exactly needs to be studied, or even if consciousness can be considered a scientific concept. In some explanations, it is synonymous with mind, while in others it is considered an aspect of it. In the past, consciousness meant one's \"inner life\": the world of introspection, private thought, imagination, and volition. Today, it often includes any kind of cognition, experience, feeling, or perception."}}, {"canonical_name": "amentia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "dementia", "book_id": "principles_of_psychology_james_1890", "name": "dementia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["dementia"], "contexts": ["loss of cognitive function"]}, {"entity_id": "amentia", "book_id": "polyanthea_medicinal", "name": "amentia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 15, "variants": ["amentia", "Amencia", "Amentia", "Am\u00e9cia", "amentiam"], "contexts": ["state of madness or foolishness", "a condition of lack of mind"]}, {"entity_id": "dementia", "book_id": "polyanthea_medicinal", "name": "dementia", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["dementia"], "contexts": ["a condition of mental impairment"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "dementia", "target_book": "polyanthea_medicinal", "target_name": "amentia", "similarity": 0.914}, {"source_book": "principles_of_psychology_james_1890", "source_name": "dementia", "target_book": "polyanthea_medicinal", "target_name": "dementia", "similarity": 0.917}], "id": 2492, "stable_key": "clu_aae998364b1d21be", "ground_truth": {"modern_name": "Dementia", "confidence": "high", "type": "disease", "modern_term": "Dementia", "wikidata_id": "Q41112", "wikidata_description": "psychotic disorder characterized by emotional responsiveness and disintegration of thought process"}}, {"canonical_name": "limestone", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "limestone", "book_id": "kosmos_humboldt_1845", "name": "limestone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 16, "variants": ["limestone"], "contexts": ["sedimentary rock composed of calcium carbonate", "strata formed by precipitation"]}, {"entity_id": "limestone", "book_id": "connexion_physical_sciences_somerville_1858", "name": "limestone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["limestone"], "contexts": ["common sedimentary rock"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "limestone", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "limestone", "similarity": 1.0}], "id": 2493, "stable_key": "clu_9450093264b9d9a3-3", "ground_truth": {"modern_name": "Limestone", "confidence": "high", "type": "mineral", "wikidata_id": "Q23757", "wikidata_description": "sedimentary rocks made of the chemical substance calcium carbonate", "wikipedia_url": "https://en.wikipedia.org/wiki/Limestone", "wikipedia_extract": "Limestone is a type of carbonate sedimentary rock which is the main source of the material lime. It is composed mostly of the minerals calcite and aragonite, which are different crystal forms of calcium carbonate CaCO3. Limestone forms when these minerals precipitate out of water containing dissolved calcium. This can take place through both biological and nonbiological processes, though biological processes, such as the accumulation of corals and shells in the sea, have likely been more important for the last 540 million years. Limestone often contains fossils which provide scientists with information on ancient environments and on the evolution of life. About 20% to 25% of sedimentary rock is carbonate rock, and most of this is limestone."}}, {"canonical_name": "globe", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "globe", "book_id": "kosmos_humboldt_1845", "name": "globe", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 7, "variants": ["globe"], "contexts": ["Earth as a physical entity", "every region of the globe"]}, {"entity_id": "globe", "book_id": "connexion_physical_sciences_somerville_1858", "name": "globe", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 5, "variants": ["globe"], "contexts": ["spherical representation of the earth", "Earth, location of temperature vicissitudes"]}, {"entity_id": "terrestrial_globe", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Terrestrial globe", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 5, "variants": ["terrestrial globe", "Terrestrial globe"], "contexts": ["conductor due to moisture", "paramagnetic celestial body"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "globe", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "globe", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "globe", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Terrestrial globe", "similarity": 0.916}], "id": 2494, "stable_key": "clu_c58931db554edb82", "ground_truth": {"modern_name": "Globe", "confidence": "high", "type": "object"}}, {"canonical_name": "Melancolicos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "melantholicos", "book_id": "historia_medicinal_monardes_1574", "name": "melantholicos", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["melantholicos", "melancholic\u00f3"], "contexts": ["bad sustenance quality", "humor related to melancholy"]}, {"entity_id": "melancolicos", "book_id": "polyanthea_medicinal", "name": "Melancolicos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 15, "variants": ["Melancolicos", "melancolicos"], "contexts": ["melancholic humors", "disease of melancholy"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "melantholicos", "target_book": "polyanthea_medicinal", "target_name": "Melancolicos", "similarity": 0.886}], "id": 2495, "stable_key": "clu_7d248a29ed03dcd8", "ground_truth": {"modern_name": "melancholic", "confidence": "high", "type": "concept", "description": "Relating to or characterized by melancholy; a humoral imbalance.", "note": "Refers to both a temperament and a humoral state.", "wikipedia_extract": "Melancholia or melancholy (Ancient Greek: \u03bc\u03b5\u03bb\u03b1\u03b3\u03c7\u03bf\u03bb\u03af\u03b1, romanized: melanchol\u00eda; from \u03bc\u03ad\u03bb\u03b1\u03b9\u03bd\u03b1 \u03c7\u03bf\u03bb\u03ae, m\u00e9laina chol\u1e17, 'black bile') is a concept found throughout ancient, medieval, and premodern medicine in Europe that describes a condition characterized by markedly depressed mood, bodily complaints, and sometimes hallucinations and delusions. Besides a pathological condition, melancholy could also refer to a mood or temperament and at times it was even used as a description of the human condition in general. Melancholy (or more precisely the 'black bile', from which melancholy derives its name) was regarded as one of the four temperaments matching the four humours. Until the 18th century, doctors and other scholars classified melancholic conditions as such by their perceived common cause \u2013 an excess of a notional fluid known as \"black bile\", which was commonly linked to the spleen. Hippocrates and other ancient physicians described melancholia as a distinct disease with mental and physical symptoms, including persistent fears and despondencies, poor appetite, abulia, sleeplessness, irritability, and agitation. Later, fixed delusions were added by Galen and other physicians to the list of symptoms."}}, {"canonical_name": "Trincavelus", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "trimegisto", "book_id": "historia_medicinal_monardes_1574", "name": "Trimegisto", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Trimegisto", "Trimegis"], "contexts": ["attributed earth as mother of metals", "figure associated with principles and origin"]}, {"entity_id": "trincavelus", "book_id": "polyanthea_medicinal", "name": "Trincavelus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 15, "variants": ["Trincavelus", "Trincav", "Trincav.", "Trincavel.", "Trincavello", "Trincavelo"], "contexts": ["author of Consilia Medica", "cited in lib. 25"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Trimegisto", "target_book": "polyanthea_medicinal", "target_name": "Trincavelus", "similarity": 0.851}], "id": 2496, "stable_key": "clu_cf195465ce8e838a", "ground_truth": {"modern_name": "Trismegistus", "confidence": "high", "type": "person", "description": "Mythical alchemist and philosopher, attributed with Hermetic texts.", "note": "The name 'Trincavelus' appears to be a corruption or variation of 'Trismegistus'.", "wikidata_id": "Q192358", "wikidata_description": "purported author of the Hermetic Corpus"}}, {"canonical_name": "Aecio", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "aecio", "book_id": "coloquios_da_orta_1563", "name": "Aecio", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 7, "variants": ["Aecio"], "contexts": ["ancient authority who spoke about amber", "ancient medical authority"]}, {"entity_id": "ae\u00e7io", "book_id": "coloquios_da_orta_1563", "name": "Ae\u00e7io", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Ae\u00e7io"], "contexts": ["ancient medical authority", "Greek physician"]}, {"entity_id": "aecio", "book_id": "polyanthea_medicinal", "name": "Aecio", "category": "PERSON", "subcategory": "AUTHORITY", "count": 8, "variants": ["Aecio"], "contexts": ["ancient medical authority", "cited medical authority"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Aecio", "target_book": "polyanthea_medicinal", "target_name": "Aecio", "similarity": 0.741}, {"source_book": "coloquios_da_orta_1563", "source_name": "Ae\u00e7io", "target_book": "polyanthea_medicinal", "target_name": "Aecio", "similarity": 0.678}], "id": 2497, "stable_key": "clu_985e297f91914ed3-2", "ground_truth": {"modern_name": "Aetius of Amida", "confidence": "high", "type": "person", "birth_year": 502, "death_year": 575, "description": "Byzantine medical writer, compiled influential medical encyclopedia.", "wikidata_id": "Q381956", "wikidata_description": "early 6th-century Byzantine physician", "wikipedia_url": "https://en.wikipedia.org/wiki/A%C3%ABtius%20of%20Amida", "wikipedia_extract": "A\u00ebtius of Amida (; Ancient Greek: \u1f08\u03ad\u03c4\u03b9\u03bf\u03c2 \u1f08\u03bc\u03b9\u03b4\u03b7\u03bd\u03cc\u03c2; Latin: A\u00ebtius Amidenus; fl. mid-5th century to mid-6th century) was a Byzantine Greek physician and medical writer, particularly distinguished by the extent of his erudition. His birth and death years are not known, but his writings appear to date from the end of the 5th century or the beginning of the 6th. A\u00ebtius was probably a Christian. If so, he would be among the earliest recorded Greek Christian physicians. He is sometimes confused with A\u00ebtius of Antioch, a famous Arian who lived in the time of the Emperor Julian."}}, {"canonical_name": "linho", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "linho", "book_id": "coloquios_da_orta_1563", "name": "linho", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["linho", "linho commum"], "contexts": ["commodity mentioned in relation to weights", "plant material found on the island"]}, {"entity_id": "linho", "book_id": "polyanthea_medicinal", "name": "linho", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["linho", "linho canhamo", "linhonovo"], "contexts": ["material for a linen cloth", "linen cloths used to absorb blood"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "linho", "target_book": "polyanthea_medicinal", "target_name": "linho", "similarity": 1.0}], "id": 2498, "stable_key": "clu_72f73bd2a259dae3", "ground_truth": {"modern_name": "Flax", "confidence": "high", "type": "plant", "linnaean": "Linum usitatissimum", "family": "Linaceae", "description": "A plant cultivated for its fiber (linen) and seeds (linseed).", "wikipedia_extract": "Flax, also known as common flax or linseed, is a flowering plant, Linum usitatissimum, in the family Linaceae. It is cultivated as a food and fiber crop in regions of the world with temperate climates. In 2022, France produced 75% of the world's supply of flax. Textiles made from flax are known in English as linen and are traditionally used for bed sheets, underclothes, and table linen. Its oil is known as linseed oil. In addition to referring to the plant, the word \"flax\" may refer to the unspun fibers of the flax plant."}}, {"canonical_name": "Cidade", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "cidade", "book_id": "coloquios_da_orta_1563", "name": "cidade", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["cidade"], "contexts": ["location of the epidemic", "city"]}, {"entity_id": "cidade", "book_id": "polyanthea_medicinal", "name": "Cidade", "category": "PLACE", "subcategory": "CITY", "count": 15, "variants": ["Cidade", "Cidades"], "contexts": ["city where remedies are falsified", "city"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "cidade", "target_book": "polyanthea_medicinal", "target_name": "Cidade", "similarity": 0.945}], "id": 2499, "stable_key": "clu_2708c5314bc0a588-2", "ground_truth": {"modern_name": "City", "confidence": "high", "type": "place", "wikidata_id": "", "wikidata_description": "capital and most populous city in France", "wikipedia_url": "https://en.wikipedia.org/wiki/Paris", "wikipedia_extract": "Paris is the capital and largest city of France, with an estimated city population of 2,047,602 in an area of 105.4 km2 (40.7 sq mi), and a metropolitan population of 13,239,090 as of January 2026. Located on the river Seine in the centre of the \u00cele-de-France region, it is the largest metropolitan area and fourth-most populous city in the European Union (EU). Nicknamed the City of Light, partly because of its role in the Age of Enlightenment, Paris has been one of the world's major centres of finance, diplomacy, commerce, culture, fashion, and gastronomy since the 17th century. Administratively, Paris is divided into twenty arrondissements (districts), each having their own cultural identity. Haussmann's renovation of Paris, which created new boulevards, parks, and public works, gave birth to a modern city known as the \"capital of the 19th century\". Paris is a major railway, motorway, and air-transport hub; in 2024 Charles de Gaulle Airport was the EU's busiest airport.", "note": "This is a generic term. The specific city would depend on the context of the text."}}, {"canonical_name": "nutation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "nutation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "nutation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 15, "variants": ["nutation", "Nutation"], "contexts": ["wobble in orbital axis", "slight irregularity in Earth's precession"]}, {"entity_id": "nutation", "book_id": "first_principles_spencer_1862", "name": "nutation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["nutation"], "contexts": ["wobble in Earth's axial tilt", "wobbling motion of Earth's axis"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "nutation", "target_book": "first_principles_spencer_1862", "target_name": "nutation", "similarity": 1.0}], "id": 2500, "stable_key": "clu_1ffde4b8d93348d4", "ground_truth": {"modern_name": "Nutation", "confidence": "high", "type": "concept", "note": "The 'wobble in Earth's axial tilt' is a specific astronomical phenomenon.", "wikidata_id": "Q190009", "wikidata_description": "type of motion in astronomy. A component of the rotating motion of a planet under the influence of gravitational pull by moons, other planets or the central star", "wikipedia_url": "https://en.wikipedia.org/wiki/Astronomical_nutation", "wikipedia_extract": "Honda has produced the following cars, SUVs, and light trucks. During the late 1980s and early 1990s, Honda collaborated with Rover in the development and marketing of the Honda Concerto, Rover 200, 400, 600 and 800. The 800 was called the Sterling in the US. Honda partnered with Isuzu in the 1990s to produce the Passport and the Acura SLX."}}, {"canonical_name": "Undulations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "undulations", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Undulations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["undulations", "Undulations"], "contexts": ["interference of waves", "wave-like movements"]}, {"entity_id": "undulation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "undulation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["undulation"], "contexts": ["wave-like motion", "wave-like motion of light"]}, {"entity_id": "undulations", "book_id": "first_principles_spencer_1862", "name": "undulations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["undulations"], "contexts": ["wave-like movements of particles", "caused by rising fish, die away on water surface"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Undulations", "target_book": "first_principles_spencer_1862", "target_name": "undulations", "similarity": 0.955}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "undulation", "target_book": "first_principles_spencer_1862", "target_name": "undulations", "similarity": 0.916}], "id": 2501, "stable_key": "clu_d1cb2af2279ee9cf", "ground_truth": {"modern_name": "wave motion", "confidence": "high", "type": "concept", "wikidata_id": "Q26008", "wikidata_description": "peer-reviewed scientific journal"}}, {"canonical_name": "Feavers", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "feavers", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Feavers", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["Feavers"], "contexts": ["medical condition"]}, {"entity_id": "feavers", "book_id": "english_physician_1652", "name": "Feavers", "category": "DISEASE", "subcategory": "ACUTE", "count": 15, "variants": ["Feavers", "Feaver", "Fever", "feavers"], "contexts": ["condition treated with barley preparations", "hot distempers of the body"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Feavers", "target_book": "english_physician_1652", "target_name": "Feavers", "similarity": 1.0}], "id": 2502, "stable_key": "clu_6223dcf2803ef3cf-4", "ground_truth": {"modern_name": "Fever", "confidence": "high", "type": "disease", "modern_term": "Fever", "wikidata_id": "Q38933", "wikidata_description": "common medical sign characterized by elevated body temperature", "wikipedia_url": "https://en.wikipedia.org/wiki/Fever", "wikipedia_extract": "Fever or pyrexia in humans is a symptom of an anti-infection defense mechanism that appears with body temperature exceeding the normal range caused by an increase in the body's temperature set point in the hypothalamus. There is no single agreed-upon upper limit for normal temperature: sources use values ranging between 37.2 and 38.3 \u00b0C (99.0 and 100.9 \u00b0F) in humans. The increase in set point triggers increased muscle contractions and causes a feeling of cold or chills. This results in greater heat production and efforts to conserve heat. When the set point temperature returns to normal, a person feels hot, becomes flushed, and may begin to sweat. Rarely a fever may trigger a febrile seizure, with this being more common in young children.", "description": "An acute illness characterized by elevated body temperature and potential delirium."}}, {"canonical_name": "Ecosse", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "\u00e9cosse", "book_id": "epoques_nature_buffon_1778", "name": "\u00c9cosse", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["\u00c9cosse"], "contexts": ["landmass adjacent to Greenland", "land between Norway and Greenland"]}, {"entity_id": "ecosse", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Ecosse", "category": "PLACE", "subcategory": "COUNTRY", "count": 13, "variants": ["Ecosse"], "contexts": ["country with a canal connecting seas", "region with a gorge"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "\u00c9cosse", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Ecosse", "similarity": 0.813}], "id": 2503, "stable_key": "clu_3476647053407601", "ground_truth": {"modern_name": "Scotland", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q22", "wikidata_description": "country in north-west Europe, part of the United Kingdom", "wikipedia_url": "https://en.wikipedia.org/wiki/Scotland"}}, {"canonical_name": "Dissolution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "dissolution", "book_id": "epoques_nature_buffon_1778", "name": "dissolution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dissolution"], "contexts": ["process of breaking down solid matter"]}, {"entity_id": "dissolution", "book_id": "first_principles_spencer_1862", "name": "Dissolution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 15, "variants": ["dissolution", "Dissolution"], "contexts": ["process of decay or breaking down", "destructive change opposite to evolution"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "dissolution", "target_book": "first_principles_spencer_1862", "target_name": "Dissolution", "similarity": 0.98}], "id": 2504, "stable_key": "clu_c39e8dad164d5750", "ground_truth": {"modern_name": "Dissolution", "confidence": "high", "type": "concept", "wikidata_id": "Q3133701", "wikidata_description": "process of a solute dissolving in a solvent", "wikipedia_url": "https://en.wikipedia.org/wiki/Dissolution%20%28chemistry%29"}}, {"canonical_name": "Zodiacal light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "lumi\u00e8re_zodiacale", "book_id": "epoques_nature_buffon_1778", "name": "Lumi\u00e8re zodiacale", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Lumi\u00e8re zodiacale"], "contexts": ["astronomical phenomenon discussed"]}, {"entity_id": "zodiacal_light", "book_id": "kosmos_humboldt_1845", "name": "Zodiacal light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 15, "variants": ["Zodiacal Light", "zodiacal light", "Zodiacal light"], "contexts": ["pyramidal light phenomenon", "luminous phenomenon in the sky"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Lumi\u00e8re zodiacale", "target_book": "kosmos_humboldt_1845", "target_name": "Zodiacal light", "similarity": 0.932}], "id": 2505, "stable_key": "clu_49f66bb116db6f5e", "ground_truth": {"modern_name": "Zodiacal light", "confidence": "high", "type": "concept", "wikidata_id": "Q127775633", "wikidata_description": "scholarly article"}}, {"canonical_name": "Bark", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "bark", "book_id": "english_physician_1652", "name": "Bark", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 15, "variants": ["Bark", "Barke", "Barks"], "contexts": ["part of the plant used medicinally", "part of the Alder-Tree used medicinally"]}, {"entity_id": "bark", "book_id": "kosmos_humboldt_1845", "name": "bark", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["bark"], "contexts": ["outer layer of a tree trunk"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Bark", "target_book": "kosmos_humboldt_1845", "target_name": "bark", "similarity": 0.993}], "id": 2506, "stable_key": "clu_afdfaa85f58d4c0c", "ground_truth": {"modern_name": "Bark", "confidence": "high", "type": "plant", "note": "Refers to the outer layer of a tree, often used medicinally.", "wikidata_id": "Q184453", "wikidata_description": "plant tissue outside the vascular cambium or the xylem; in older trees may be divided into dead outer bark and living inner bark, which consists of secondary phloem. external parenchymal tissue, located just below the epidermis of the stem"}}, {"canonical_name": "Sussex", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "sussex", "book_id": "english_physician_1652", "name": "Sussex", "category": "PLACE", "subcategory": "REGION", "count": 15, "variants": ["Sussex"], "contexts": ["county where a student lived", "county where Dog-wood is called"]}, {"entity_id": "sussex", "book_id": "origin_of_species_darwin_1859", "name": "Sussex", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Sussex"], "contexts": ["location of ant nest observations"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Sussex", "target_book": "origin_of_species_darwin_1859", "target_name": "Sussex", "similarity": 1.0}], "id": 2507, "stable_key": "clu_bf41bc8547d7c187", "ground_truth": {"modern_name": "Sussex", "confidence": "high", "type": "place", "description": "A county in England, mentioned for local flora and fauna observations.", "wikipedia_extract": "Sussex (/\u02c8s\u028cs\u026aks/;  from the Old English S\u016b\u00feseaxe; lit.\u2009'South Saxons'; 'Sussex') is an area of South East England that was historically a kingdom and, later, a county. The current ceremonial counties of East Sussex and West Sussex cover approximately the same area. The two ceremonial counties border Surrey to the north, Kent to the north-east, the English Channel to the south, and Hampshire to the west. Sussex contains the city of Brighton and Hove and its wider city region, part of the South Downs National Park and the national landscape of the High Weald, and Chichester Harbour. Its coastline is 137 miles (220 km) long. The Kingdom of Sussex emerged in the fifth century in the area that had previously been inhabited by the Regni tribe in the Romano-British period."}}, {"canonical_name": "Gums", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "gums", "book_id": "english_physician_1652", "name": "Gums", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 15, "variants": ["Gums"], "contexts": ["part of the mouth fastened by plantain", "sores of the mouth or gums"]}, {"entity_id": "gums", "book_id": "connexion_physical_sciences_somerville_1858", "name": "gums", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["gums"], "contexts": ["sticky substances from plants"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Gums", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gums", "similarity": 0.698}], "id": 2508, "stable_key": "clu_55ad93fe44d357a8", "ground_truth": {"modern_name": "Gums", "confidence": "medium", "type": "concept", "note": "Can refer to oral tissue or plant exudates, context dependent.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Womb", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "womb", "book_id": "english_physician_1652", "name": "Womb", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 13, "variants": ["Womb", "Wombs"], "contexts": ["universal medicine for the womb", "body part helped by oil"]}, {"entity_id": "womb", "book_id": "origin_of_species_darwin_1859", "name": "womb", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["womb"], "contexts": ["fetus's head shape affected by pressure", "organ where fetus develops"]}, {"entity_id": "mother\u2019s_womb", "book_id": "origin_of_species_darwin_1859", "name": "mother\u2019s womb", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["mother\u2019s womb"], "contexts": ["uterus where fetus develops"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Womb", "target_book": "origin_of_species_darwin_1859", "target_name": "womb", "similarity": 0.995}, {"source_book": "english_physician_1652", "source_name": "Womb", "target_book": "origin_of_species_darwin_1859", "target_name": "mother\u2019s womb", "similarity": 0.95}], "id": 2509, "stable_key": "clu_7b4e9f9abb5f8eb2", "ground_truth": {"modern_name": "Uterus", "confidence": "high", "type": "concept", "note": "The Latin term 'uter' clearly refers to the uterus, the female reproductive organ. The variations 'uter' and 'uterus' solidify this identification.", "wikidata_id": "Q9612", "wikidata_description": "major female hormone-responsive reproductive sex organ of most mammals including humans"}}, {"canonical_name": "Astrology", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "astrology", "book_id": "english_physician_1652", "name": "Astrology", "category": "CONCEPT", "subcategory": "THEORY", "count": 13, "variants": ["Astrology", "Astrological", "Astrologie"], "contexts": ["study of celestial influences", "study of celestial influences on disease"]}, {"entity_id": "astrologia", "book_id": "coloquios_da_orta_1563", "name": "Astrologia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Astrologia", "Astr\u00f3nomo", "astrologia"], "contexts": ["implied medical theory", "study of celestial influence"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Astrology", "target_book": "coloquios_da_orta_1563", "target_name": "Astrologia", "similarity": 0.993}], "id": 2510, "stable_key": "clu_90f086348564f396", "ground_truth": {"modern_name": "Astrology", "confidence": "high", "type": "concept", "wikidata_id": "Q34362", "wikidata_description": "ensemble of traditions, beliefs and divinations that interpret the positions of the planets and other celestial bodies; along with their correlation with terrestrial events", "note": "The context 'zodiac sign influencing body parts' clearly points to astrological signs. The broader meaning 'indicator or cue' is secondary in this medical/scientific context."}}, {"canonical_name": "Venom", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "venom", "book_id": "english_physician_1652", "name": "Venom", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 13, "variants": ["Venom"], "contexts": ["substance expelled by the herb", "substance borrage helps resist and expel"]}, {"entity_id": "venen", "book_id": "polyanthea_medicinal", "name": "venen", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["venen"], "contexts": ["poison", "venom"]}, {"entity_id": "venom", "book_id": "polyanthea_medicinal", "name": "venom", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["venom"], "contexts": ["poisonous substance"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Venom", "target_book": "polyanthea_medicinal", "target_name": "venen", "similarity": 0.94}, {"source_book": "english_physician_1652", "source_name": "Venom", "target_book": "polyanthea_medicinal", "target_name": "venom", "similarity": 0.888}], "id": 2511, "stable_key": "clu_0889a7fce663c336-2", "ground_truth": {"modern_name": "Venomous Animals", "confidence": "high", "type": "animal", "description": "Creatures capable of inflicting harm through venomous bites or stings.", "wikipedia_extract": "The following is a list of poisonous animals, which are animals that passively deliver toxins (called poison) to their victims upon contact such as through inhalation, absorption through the skin, or after being ingested. They are often distinguished from venomous animals, which actively inject their toxins (called venom) into their victims through a venom apparatus such as fangs or a stinger. The only difference between poisonous animals and venomous animals is how they deliver the toxins. This list deals exclusively with poisonous animals. This list is a partial list of animals that are poisonous to humans and other animals in that their flesh is toxic if consumed, or in some cases if they are touched: Some of these toads are \"milked\" for their bufotoxins."}}, {"canonical_name": "sexual selection", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "sexual_selection", "book_id": "origin_of_species_darwin_1859", "name": "sexual selection", "category": "CONCEPT", "subcategory": "THEORY", "count": 15, "variants": ["sexual selection", "Sexual Selection"], "contexts": ["selection based on mating success", "mechanism for evolutionary change"]}, {"entity_id": "sexual_selection", "book_id": "principles_of_psychology_james_1890", "name": "sexual selection", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["sexual selection"], "contexts": ["selection based on mate choice"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "sexual selection", "target_book": "principles_of_psychology_james_1890", "target_name": "sexual selection", "similarity": 1.0}], "id": 2512, "stable_key": "clu_ab425cc4fd06b426", "ground_truth": {"modern_name": "Sexual selection", "confidence": "high", "type": "concept"}}, {"canonical_name": "Agassiz", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "agassiz", "book_id": "origin_of_species_darwin_1859", "name": "Agassiz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 8, "variants": ["Agassiz"], "contexts": ["remarked on blind fish", "pal\u00e6ontologist arguing against transmutation"]}, {"entity_id": "agassiz", "book_id": "kosmos_humboldt_1845", "name": "Agassiz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 8, "variants": ["Agassiz"], "contexts": ["author of work on fossil fishes", "ichthyologist and paleontologist"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Agassiz", "target_book": "kosmos_humboldt_1845", "target_name": "Agassiz", "similarity": 1.0}], "id": 2513, "stable_key": "clu_7ec86da399fb877b", "ground_truth": {"modern_name": "Louis Agassiz", "confidence": "high", "type": "person", "description": "Swiss-born naturalist, geologist, and paleontologist.", "wikipedia_extract": "Jean Louis Rodolphe Agassiz  ( AG-\u0259-see; French: [a\u0261asi]; May 28, 1807 \u2013 December 14, 1873) was a Swiss-born American biologist and geologist who is recognized as a scholar of Earth's natural history. Spending his early life in Switzerland, he received a PhD at Erlangen and a medical degree in Munich. After studying with Georges Cuvier and Alexander von Humboldt in Paris, Agassiz was appointed professor of natural history at the University of Neuch\u00e2tel. He emigrated to the United States in 1847 after visiting Harvard University. He went on to become professor of zoology and geology at Harvard, to head its Lawrence Scientific School, and to found its Museum of Comparative Zoology. Agassiz is known for observational data gathering and analysis."}}, {"canonical_name": "tallos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "tallos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "tallos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 15, "variants": ["tallos"], "contexts": ["stems", "part of the plant"]}, {"entity_id": "tallo", "book_id": "historia_medicinal_monardes_1574", "name": "tallo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["tallo"], "contexts": ["part of the plant"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "tallos", "target_book": "historia_medicinal_monardes_1574", "target_name": "tallo", "similarity": 0.891}], "id": 2514, "stable_key": "clu_af8741b9ba9c3b2c", "ground_truth": {"modern_name": "Stem", "confidence": "high", "type": "plant", "note": "The term 'tallos'/'tallo' refers to the stem of a plant in Spanish and Portuguese. It is a general botanical term.", "wikidata_id": "Q134267", "wikidata_description": "structural axis of a vascular plant, supporting leaves, flowers and fruits", "wikipedia_url": "https://en.wikipedia.org/wiki/Plant%20stem"}}, {"canonical_name": "mayz", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "mayz", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "mayz", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["mayz"], "contexts": ["corn", "staple grain, corn"]}, {"entity_id": "mayz", "book_id": "historia_medicinal_monardes_1574", "name": "Mayz", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Mayz"], "contexts": ["leaves fed to fatten worms", "grain, nutritious and healthy"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "mayz", "target_book": "historia_medicinal_monardes_1574", "target_name": "Mayz", "similarity": 0.968}], "id": 2515, "stable_key": "clu_a316e695b7f19b45", "ground_truth": {"modern_name": "Maize", "confidence": "high", "type": "plant", "linnaean": "Zea mays Linnaeus", "family": "Poaceae", "wikidata_id": "Q11575", "wikidata_description": "species of grass cultivated as a food crop", "wikipedia_url": "https://en.wikipedia.org/wiki/Maize"}}, {"canonical_name": "Lacre", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "lacre", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Lacre", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Lacre"], "contexts": ["sealing wax made from gum and turpentine"]}, {"entity_id": "lacre", "book_id": "coloquios_da_orta_1563", "name": "Lacre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 15, "variants": ["lacre", "Lacre", "LACRE"], "contexts": ["substance that comes from Peg\u00fa", "used for sealing letters"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Lacre", "target_book": "coloquios_da_orta_1563", "target_name": "Lacre", "similarity": 0.797}], "id": 2516, "stable_key": "clu_a9f6640c2d94d1c5", "ground_truth": {"modern_name": "Lacquer", "confidence": "high", "type": "chemical", "note": "The context suggests a substance used for sealing, which aligns with lacquer or shellac, often derived from resins. 'Lacre' in Portuguese specifically refers to sealing wax, which could be made from resins, pigments, and fillers.", "wikidata_id": "Q28933284", "wikidata_description": "species of poisonous plant used to produce urushiol-based lacquer", "wikipedia_url": "https://en.wikipedia.org/wiki/Toxicodendron%20vernicifluum"}}, {"canonical_name": "Santa Marta", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "santa_marta", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Santa Marta", "category": "PLACE", "subcategory": "CITY", "count": 15, "variants": ["Santa Marta", "San Mateo"], "contexts": ["city with population 62,000", "city in Colombia"]}, {"entity_id": "santa_marta", "book_id": "kosmos_humboldt_1845", "name": "Santa Marta", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Santa Marta"], "contexts": ["location of subterranean thunder"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Santa Marta", "target_book": "kosmos_humboldt_1845", "target_name": "Santa Marta", "similarity": 1.0}], "id": 2517, "stable_key": "clu_53a307ca784da248", "ground_truth": {"modern_name": "Santa Marta", "confidence": "high", "type": "place", "country": "Colombia", "wikidata_id": "Q1629459", "wikidata_description": "municipality in the province of Badajoz, Spain", "wikipedia_url": "https://en.wikipedia.org/wiki/Santa_Marta%2C_Extremadura", "wikipedia_extract": "Santa Marta is a municipality (population 4,157) in the Spanish province of Badajoz, in the autonomous community of Extremadura."}}, {"canonical_name": "Callao", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "callao", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Callao", "category": "PLACE", "subcategory": "CITY", "count": 15, "variants": ["Callao", "Callao de Lima"], "contexts": ["port city near Lima", "port with hourly variations"]}, {"entity_id": "callao", "book_id": "kosmos_humboldt_1845", "name": "Callao", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Callao"], "contexts": ["port city experiencing earthquake"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Callao", "target_book": "kosmos_humboldt_1845", "target_name": "Callao", "similarity": 1.0}], "id": 2518, "stable_key": "clu_44d9068467cd582e", "ground_truth": {"modern_name": "Callao", "confidence": "high", "type": "place", "country": "Peru", "wikidata_id": "Q105037", "wikidata_description": "city \u200b\u200band main seaport of Peru", "wikipedia_url": "https://en.wikipedia.org/wiki/Callao", "wikipedia_extract": "Callao (Spanish pronunciation: [ka\u02c8\u029da.o]) is a seaside city and constitutional province in Peru. Located next to the Pacific Ocean, it forms part of the Lima metropolitan area alongside Lima province. Its autonomous status dates back to 1836, when it was declared a Littoral Province of the Peru\u2013Bolivian Confederation, after which it was declared a Constitutional Province by the government of Ram\u00f3n Castilla in 1857. Callao is Peru's chief seaport and home to its main airport, Jorge Ch\u00e1vez International Airport. Founded in 1537 by the Spaniards, the city has a long naval history as one of the main ports in Spanish America and the Pacific, having been a vital Spanish town of the Viceroyalty of Peru. Central Callao is about 15 km (9.3 mi) west of the Historic Centre of Lima."}}, {"canonical_name": "Calcaire de transition", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "calcaire_de_transition", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Calcaire de transition", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 15, "variants": ["Calcaire de transition", "Schiste de transition", "calcaire de transition", "granit\u00e9s de transition", "roches de transition", "schiste de transition", "schistes de transition", "terrain de transition"], "contexts": ["type of rock", "type of limestone"]}, {"entity_id": "transition_limestone", "book_id": "kosmos_humboldt_1845", "name": "transition limestone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["transition limestone"], "contexts": ["geological formation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Calcaire de transition", "target_book": "kosmos_humboldt_1845", "target_name": "transition limestone", "similarity": 0.914}], "id": 2519, "stable_key": "clu_4f72b2b6d6c3ed1b", "ground_truth": {"modern_name": "Transition limestone", "confidence": "medium", "type": "mineral", "note": "An older geological term likely referring to rocks of the Silurian and Devonian periods. 'Calcaire de transition' is French for transition limestone.", "wikipedia_extract": "The Midyat Limestone is located in the Midyat Group dominates the surface geology of the anticlinal structures of the Mardin High of southeastern Turkey. This Eocene aged light yellowish marly chalk was formed in a marine depositional environment near the continental shelf. Fossils such as echinoids and nummulites can be seen in the different sections of this limestone formation which can have a thickness between 300 and 400 meters. In the few areas that have exposed Cretaceous rocks, there is a transitional layer known as the Gercus, which separates the younger Eocene limestone. This transitional layer consists of  red sandy gypsum bearing beds interbedded with marl and limestone. Exposed areas of the older Cretaceous Germav Formation can be seen in small areas of the Mardin High.", "wikipedia_url": "https://en.wikipedia.org/wiki/Midyat_Limestone"}}, {"canonical_name": "Macao", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "macao", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Macao", "category": "PLACE", "subcategory": "CITY", "count": 14, "variants": ["Macao"], "contexts": ["city near the limit of the torrid zone", "location of observations in 1814"]}, {"entity_id": "macao", "book_id": "kosmos_humboldt_1845", "name": "Macao", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Macao"], "contexts": ["village near Rio Assu", "destination of voyage"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Macao", "target_book": "kosmos_humboldt_1845", "target_name": "Macao", "similarity": 1.0}], "id": 2520, "stable_key": "clu_55500a350f6f618c", "ground_truth": {"modern_name": "Macao", "confidence": "high", "type": "place", "country": "China", "note": "The text mentions 'village near Rio Assu', which might be a different location or a less precise geographical reference, but the primary and overwhelming context for Macao points to the famous Portuguese settlement.", "wikidata_id": "Q14773", "wikidata_description": "city and special administrative region of China", "wikipedia_extract": "The Guangdong\u2013Hong Kong\u2013Macao Greater Bay Area, commonly referred to as the Greater Bay Area (GBA), is a megalopolis, consisting of nine cities and two special administrative regions in South China. It is envisioned by Chinese government planners as an integrated economic area aimed at taking a leading role globally by 2035. It is the largest and most populated urban area in the world. The GBA\u2014with a total population of approximately 86 million people\u2014includes nine mega cities of Guangdong province: Guangzhou, Shenzhen, Zhuhai, Foshan, Dongguan, Zhongshan, Jiangmen, Huizhou, and Zhaoqing as well as two special administrative regions, Hong Kong, and Macao (Macau). Hong Kong, Guangzhou, and Shenzhen have been described among the world's 50 \"superstar cities\". Surrounding the Pearl River Delta with a total area of 56,000 km2 (comparable in size to Croatia), it is the largest and the richest economic region in South China.", "wikipedia_url": "https://en.wikipedia.org/wiki/Macau"}}, {"canonical_name": "d\u00e9clinaison magn\u00e9tique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "d\u00e9clinaison_magn\u00e9tique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "d\u00e9clinaison magn\u00e9tique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["d\u00e9clinaison magn\u00e9tique", "Inclinaison magn\u00e9tique", "d\u00e9clinaison", "d\u00e9clinaison du soleil", "d\u00e9clinaisons magn\u00e9tiques"], "contexts": ["magnetic variation", "magnetic declination"]}, {"entity_id": "magnetic_declination", "book_id": "kosmos_humboldt_1845", "name": "Magnetic declination", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["magnetic declination", "Magnetic declination"], "contexts": ["variation in magnetic compass direction", "angle between magnetic and geographic north"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "d\u00e9clinaison magn\u00e9tique", "target_book": "kosmos_humboldt_1845", "target_name": "Magnetic declination", "similarity": 0.901}], "id": 2521, "stable_key": "clu_3b8f69bf7ed480fd", "ground_truth": {"modern_name": "Magnetic declination", "confidence": "high", "type": "concept", "wikidata_id": "Q127448891", "wikidata_description": "scholarly article"}}, {"canonical_name": "cerebellum", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "cerebellum", "book_id": "principles_of_psychology_james_1890", "name": "cerebellum", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 7, "variants": ["cerebellum", "Cerebellum"], "contexts": ["brain region for motor control", "part of the hindbrain"]}, {"entity_id": "cerebrum", "book_id": "principles_of_psychology_james_1890", "name": "cerebrum", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 7, "variants": ["cerebrum"], "contexts": ["main part of the brain for thought", "brain region for higher functions"]}, {"entity_id": "cerebrum", "book_id": "first_principles_spencer_1862", "name": "cerebrum", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["cerebrum"], "contexts": ["largest part of the brain", "part of the brain"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "cerebellum", "target_book": "first_principles_spencer_1862", "target_name": "cerebrum", "similarity": 0.969}, {"source_book": "principles_of_psychology_james_1890", "source_name": "cerebrum", "target_book": "first_principles_spencer_1862", "target_name": "cerebrum", "similarity": 1.0}], "id": 2522, "stable_key": "clu_1095a32778662931", "ground_truth": {"modern_name": "Cerebrum and Cerebellum", "confidence": "medium", "type": "concept", "note": "The cluster contains both 'cerebellum' and 'cerebrum', suggesting the early modern text might be discussing both or using them interchangeably in a broad sense of 'brain'."}}, {"canonical_name": "Argelander", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "argelander", "book_id": "kosmos_humboldt_1845", "name": "Argelander", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Argelander"], "contexts": ["calculated comet period", "made observations on star congregation"]}, {"entity_id": "argelander", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Argelander", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Argelander"], "contexts": ["astronomer who computed comet periods", "ascertained period of \u03b2 Lyr\u00e6"]}, {"entity_id": "m__argelander", "book_id": "connexion_physical_sciences_somerville_1858", "name": "M. Argelander", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["M. Argelander"], "contexts": ["computed comet's period", "calculated star magnitude depends on distance"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Argelander", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Argelander", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Argelander", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "M. Argelander", "similarity": 0.854}], "id": 2523, "stable_key": "clu_5e09d086d413b9ce", "ground_truth": {"modern_name": "Friedrich Wilhelm Argelander", "confidence": "high", "type": "person", "birth_year": 1799, "death_year": 1875, "description": "Astronomer known for cataloging stars and calculating comet periods.", "wikidata_id": "Q58685", "wikidata_description": "German astronomer (1799\u20131875)"}}, {"canonical_name": "Violet", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "violet", "book_id": "kosmos_humboldt_1845", "name": "violet", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["violet"], "contexts": ["color"]}, {"entity_id": "violet", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Violet", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 15, "variants": ["Violet", "violet"], "contexts": ["colour with most refrangibility", "color reflecting violet rays"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "violet", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Violet", "similarity": 0.952}], "id": 2524, "stable_key": "clu_ccd43405cbe2f460", "ground_truth": {"modern_name": "Violet (color)", "confidence": "high", "type": "concept", "wikidata_id": "Q428124", "wikidata_description": "color between blue and ultraviolet in the electromagnetic spectrum"}}, {"canonical_name": "vento\u017fas \u017farjadas", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "ventolos", "book_id": "historia_medicinal_monardes_1574", "name": "ventolos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["ventolos", "vento\u00edas"], "contexts": ["misspelling in errata", "correction in errata"]}, {"entity_id": "ventosas", "book_id": "historia_medicinal_monardes_1574", "name": "ventosas", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["ventosas"], "contexts": ["windy or gaseous quality causing illness"]}, {"entity_id": "vento\u017fas_\u017farjadas", "book_id": "polyanthea_medicinal", "name": "vento\u017fas \u017farjadas", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 10, "variants": ["vento\u017fas \u017farjadas", "ventolas feccas", "vento\u017fa \u017farjada", "vento\u017fas farjadas", "vento\u017fas \u017feccas"], "contexts": ["medical device", "cupping glasses, medical instrument"]}, {"entity_id": "ventosa", "book_id": "polyanthea_medicinal", "name": "ventosa", "category": "CONCEPT", "subcategory": "QUALITY", "count": 3, "variants": ["ventosa"], "contexts": ["used on the stomach for flatulence", "windy part"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "ventolos", "target_book": "polyanthea_medicinal", "target_name": "vento\u017fas \u017farjadas", "similarity": 0.884}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "ventolos", "target_book": "polyanthea_medicinal", "target_name": "ventosa", "similarity": 0.898}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "ventosas", "target_book": "polyanthea_medicinal", "target_name": "vento\u017fas \u017farjadas", "similarity": 0.899}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "ventosas", "target_book": "polyanthea_medicinal", "target_name": "ventosa", "similarity": 0.932}], "id": 2525, "stable_key": "clu_3f0fec9281634f20", "ground_truth": {"modern_name": "Flatulence", "confidence": "high", "type": "concept", "note": "The term 'ventosa' in early modern Portuguese and Spanish medical texts referred to a windy or gaseous condition, particularly affecting the stomach, and is directly translatable to flatulence.", "wikidata_id": "Q160184", "wikidata_description": "bodily function of expelling intestinal gas out of the anus", "wikipedia_url": "https://en.wikipedia.org/wiki/Flatulence", "wikipedia_extract": "Flatulence is the expulsion of gas from the intestines via the anus, commonly referred to as farting. \"Flatus\" is the medical word for gas generated in the stomach or bowels. A proportion of intestinal gas may be swallowed environmental air; hence, flatus is not entirely generated in the stomach or bowels. The scientific study of this area of medicine is termed flatology. Passing gas is a normal bodily process. Flatus is brought to the rectum and pressurized by muscles in the intestines."}}, {"canonical_name": "Medicos Antigos", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "medicos_antiguos", "book_id": "historia_medicinal_monardes_1574", "name": "medicos antiguos", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["medicos antiguos"], "contexts": ["ancient medical authorities", "ancient physicians mentioned"]}, {"entity_id": "medicos_antigos", "book_id": "polyanthea_medicinal", "name": "Medicos Antigos", "category": "PERSON", "subcategory": "AUTHORITY", "count": 14, "variants": ["Medicos Antigos", "Medico antigo", "Medicos antigos", "medicos antigos"], "contexts": ["ancient physicians", "ancient medical authorities"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "medicos antiguos", "target_book": "polyanthea_medicinal", "target_name": "Medicos Antigos", "similarity": 0.943}], "id": 2526, "stable_key": "clu_7eab983f675a22fa", "ground_truth": {"modern_name": "Ancient Physicians", "confidence": "high", "type": "concept", "wikidata_id": "Q94309101", "wikidata_description": ""}}, {"canonical_name": "Hieronymo Montuo", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "hieronymo_monruo", "book_id": "historia_medicinal_monardes_1574", "name": "Hieronymo Monruo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Hieronymo Monruo"], "contexts": ["learned man in Medicine"]}, {"entity_id": "hieronymo_montuo", "book_id": "polyanthea_medicinal", "name": "Hieronymo Montuo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 15, "variants": ["Hieronymo Montuo", "Hie-ronymus Mercurialis", "Hieronym. Mercorialis", "Hieronym. Mercur.", "Hieronym. Mercurialis", "Hieronym. Mon.", "Hieronym. Sorian.", "Hieronymo Mercurial", "Hieronymo Soriano", "Hieronymus Ca.", "Hieronymus Mercurialis", "Hieronymus Montaus", "Hieronymus Montuus", "Jeronymo Mercurial"], "contexts": ["referred to Valeriano's statement", "refers to a case of conception and birth"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Hieronymo Monruo", "target_book": "polyanthea_medicinal", "target_name": "Hieronymo Montuo", "similarity": 0.888}], "id": 2527, "stable_key": "clu_433436686adff372-2", "ground_truth": {"modern_name": "Girolamo Mercuriale", "confidence": "high", "type": "person", "birth_year": 1530, "death_year": 1606, "description": "Italian physician, philosopher, and botanist; author of De Arte Gymnastica.", "wikidata_id": "Q129011568", "wikidata_description": "scholarly article", "wikipedia_extract": "Girolamo Mercuriale or Mercuriali (Italian: Geronimo Mercuriali; Latin: Hieronymus Mercurialis, Hyeronimus Mercurialis) (September 30, 1530 \u2013 November 8, 1606) was an Italian philologist and physician, most famous for his work De Arte Gymnastica. Born in the city of Forl\u00ec, the son of Giovanni Mercuriali, also a doctor, he was educated at Bologna, Padua and Venice, where he received his doctorate in 1555. Settling in Forli, he was sent on a political mission to Rome. The pope at the time was Paul IV. In Rome, he made favorable contacts and had free access to the great libraries where, with sweeping enthusiasm, he studied the classical and medical literature of the Greeks and Romans. His studies of the attitudes of the ancients toward diet, exercise, and hygiene and the use of natural methods for the cure of disease culminated in the publication of his De Arte Gymnastica(Venice, 1569).", "note": "The spelling 'Monruo' and 'Montuo' are likely transcriptions/misspellings of Girolamo Mercuriale, a prominent physician and scholar referenced in similar contexts."}}, {"canonical_name": "Raiz da China", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "raiz_da_china", "book_id": "coloquios_da_orta_1563", "name": "Raiz da China", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["Raiz da China", "RAIZ DA CHINA", "Raiz da china", "rai^ da China", "raiff da China", "raii da China"], "contexts": ["medicinal root", "root used for kidney and bladder ailments"]}, {"entity_id": "raiz_da_china", "book_id": "polyanthea_medicinal", "name": "raiz da China", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["raiz da China", "raiz daChina", "raizdaChina", "ra\u00edzdaChina"], "contexts": ["China root, used in remedies", "root with singular virtue for bladder sores"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Raiz da China", "target_book": "polyanthea_medicinal", "target_name": "raiz da China", "similarity": 0.91}], "id": 2528, "stable_key": "clu_81d169e8abf0cc91", "ground_truth": {"modern_name": "Smilax glabra", "confidence": "high", "type": "plant", "linnaean": "Smilax glabra Roxb.", "family": "Smilacaceae", "note": "Often identified as 'China root' in English sources, which historically referred to various Smilax species.", "wikidata_id": "Q3658986", "wikidata_description": "species of plant"}}, {"canonical_name": "D. Pedro Antonio de Noronha", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "d__garcia_de_noronha", "book_id": "coloquios_da_orta_1563", "name": "D. Garcia de Noronha", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["D. Garcia de Noronha", "D. Affonso de Noronha"], "contexts": ["involved in a peace treaty", "first viceroy who died in India"]}, {"entity_id": "d__pedro_antonio_de_noronha", "book_id": "polyanthea_medicinal", "name": "D. Pedro Antonio de Noronha", "category": "PERSON", "subcategory": "PATRON", "count": 13, "variants": ["D. Pedro Antonio de Noronha", "D. PEDRO ANTONIO DE NORONHA", "D. Pedro de Noronha", "Dom Pedro de Noronha"], "contexts": ["dedicatee of the book", "Marquez, e Senhor de Angeja"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "D. Garcia de Noronha", "target_book": "polyanthea_medicinal", "target_name": "D. Pedro Antonio de Noronha", "similarity": 0.861}], "id": 2529, "stable_key": "clu_117036e84b48fdee", "ground_truth": {"modern_name": "D. Pedro Antonio de Noronha", "confidence": "high", "type": "person", "description": "Portuguese nobleman, likely a patron or dedicatee.", "note": "The text contains both 'D. Garcia de Noronha' and 'D. Pedro Antonio de Noronha', suggesting a possible clerical error or confusion in the source text regarding the specific individual.", "wikidata_id": "Q10347316", "wikidata_description": ""}}, {"canonical_name": "Hydrogen", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "hydrogenis", "book_id": "kosmos_humboldt_1845", "name": "hydrogenis", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["hydrogenis"], "contexts": ["chemical element, hydrogen"]}, {"entity_id": "hydrogen", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Hydrogen", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 8, "variants": ["Hydrogen", "hydrogen"], "contexts": ["element in water compound", "element, part of water and other compounds"]}, {"entity_id": "hydrogen", "book_id": "kosmos_humboldt_1845", "name": "hydrogen", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["hydrogen"], "contexts": ["gas found in mud volcanoes", "chemical element mixed with naphtha"]}, {"entity_id": "hydrogen_gas", "book_id": "connexion_physical_sciences_somerville_1858", "name": "hydrogen gas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["hydrogen gas"], "contexts": ["element that combines with oxygen", "gas mixed with air"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "hydrogenis", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Hydrogen", "similarity": 0.922}, {"source_book": "kosmos_humboldt_1845", "source_name": "hydrogen", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "hydrogen gas", "similarity": 0.926}], "id": 2530, "stable_key": "clu_3b569751cb7e591c-2", "ground_truth": {"modern_name": "Hydrogen", "confidence": "high", "type": "chemical", "wikidata_id": "Q556", "wikidata_description": "chemical element with symbol H and atomic number 1", "wikipedia_url": "https://en.wikipedia.org/wiki/Hydrogen", "wikipedia_extract": "Hydrogen is a chemical element; it has the symbol H and atomic number 1. It is the lightest and most abundant chemical element in the universe, constituting about 75% of all normal matter. Under standard conditions, hydrogen is a gas of diatomic molecules with the formula H2, called dihydrogen, or sometimes hydrogen gas, molecular hydrogen, or simply hydrogen. Dihydrogen is colorless, odorless, non-toxic, and highly combustible. Stars, including the Sun, mainly consist of hydrogen in a plasma state, while on Earth, hydrogen is found as the gas H2 (dihydrogen) and in molecules, such as in water and organic compounds. The most common isotope of hydrogen, 1H, consists of one proton, one electron, and no neutrons."}}, {"canonical_name": "v\u00e9rit\u00e9", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "v\u00e9rit\u00e9", "book_id": "medecine_experimentale_bernard_1865", "name": "v\u00e9rit\u00e9", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 13, "variants": ["v\u00e9rit\u00e9"], "contexts": ["the state of being true", "fundamental reality or fact"]}, {"entity_id": "v\u00e9rit\u00e9", "book_id": "epoques_nature_buffon_1778", "name": "v\u00e9rit\u00e9", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["v\u00e9rit\u00e9"], "contexts": ["state of being true"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "v\u00e9rit\u00e9", "target_book": "epoques_nature_buffon_1778", "target_name": "v\u00e9rit\u00e9", "similarity": 1.0}], "id": 2531, "stable_key": "clu_994f48423c3e1474", "ground_truth": {"modern_name": "Truth", "confidence": "high", "type": "concept", "wikidata_id": "Q109001687", "wikidata_description": "social networking service created by Trump Media & Technology Group", "wikipedia_url": "https://en.wikipedia.org/wiki/Truth%20Social"}}, {"canonical_name": "eaux", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "eaux", "book_id": "medecine_experimentale_bernard_1865", "name": "eaux", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["eaux"], "contexts": ["environmental influence considered by ancient medicine"]}, {"entity_id": "eaux", "book_id": "epoques_nature_buffon_1778", "name": "eaux", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 14, "variants": ["eaux"], "contexts": ["waters covering the earth", "waters"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "eaux", "target_book": "epoques_nature_buffon_1778", "target_name": "eaux", "similarity": 1.0}], "id": 2532, "stable_key": "clu_0384c8c9ee00c245", "ground_truth": {"modern_name": "Waters", "confidence": "high", "type": "concept", "note": "The term 'eaux' (French for waters) in an early modern medical context often refers to water as a fundamental element or environmental influence, rather than a specific chemical compound.", "wikidata_id": "Q283", "wikidata_description": "chemical compound whose molecules are formed by two hydrogen atoms and one oxygen atom", "wikipedia_url": "https://en.wikipedia.org/wiki/Water"}}, {"canonical_name": "contravenenos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "contre-poisons", "book_id": "medecine_experimentale_bernard_1865", "name": "contre-poisons", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["contre-poisons"], "contexts": ["substances counteracting poisons"]}, {"entity_id": "contravenenos", "book_id": "polyanthea_medicinal", "name": "contravenenos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 14, "variants": ["contravenenos", "contra venenos", "contra-venenos", "contraveneno"], "contexts": ["antidotes", "substances counteracting poisons"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "contre-poisons", "target_book": "polyanthea_medicinal", "target_name": "contravenenos", "similarity": 0.922}], "id": 2533, "stable_key": "clu_15699317c74212e1", "ground_truth": {"modern_name": "antidote", "confidence": "high", "type": "concept", "wikidata_id": "Q194168", "wikidata_description": "substance that can counteract a form of poisoning", "wikipedia_url": "https://en.wikipedia.org/wiki/Antidote"}}, {"canonical_name": "ber", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "beril", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Beril", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Beril"], "contexts": ["mineral with attractive quality"]}, {"entity_id": "ber", "book_id": "coloquios_da_orta_1563", "name": "ber", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 14, "variants": ["ber", "Ber"], "contexts": ["Fruit name in Decam", "location mentioned in passage"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Beril", "target_book": "coloquios_da_orta_1563", "target_name": "ber", "similarity": 0.904}], "id": 2534, "stable_key": "clu_f5830b1002c6a7c2", "ground_truth": {"modern_name": "beryl", "confidence": "high", "type": "mineral", "wikidata_id": "Q569", "wikidata_description": "chemical element with symbol Be and atomic number 4", "wikipedia_url": "https://en.wikipedia.org/wiki/Beryllium", "wikipedia_extract": "Beryl ( BERR-\u0259l) is a mineral composed of beryllium aluminium silicate with the chemical formula Be3Al2(SiO3)6. Well-known varieties of beryl include emerald and aquamarine. Naturally occurring  hexagonal crystals of beryl can be up to several meters in size, but terminated crystals are relatively rare. Pure beryl is colorless, but it is frequently tinted by impurities; possible colors are green, blue, yellow, pink, and red (the rarest). It is an ore source of beryllium. The word beryl \u2013 Middle English: beril \u2013 is borrowed, via Old French: beryl and Latin: beryllus, from Ancient Greek \u03b2\u03ae\u03c1\u03c5\u03bb\u03bb\u03bf\u03c2 b\u1e17ryllos, which referred to various blue-green stones, from Prakrit veru\u1e37iya, ve\u1e37uriya 'beryl' which is ultimately of Dravidian origin, maybe from the name of Belur or Velur, a town in Karnataka, southern India."}}, {"canonical_name": "vapeurs", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "vapeurs", "book_id": "epoques_nature_buffon_1778", "name": "vapeurs", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 8, "variants": ["vapeurs"], "contexts": ["gases from earth's interior", "gaseous form of matter"]}, {"entity_id": "vapeurs_aqueuses", "book_id": "epoques_nature_buffon_1778", "name": "vapeurs aqueuses", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["vapeurs aqueuses"], "contexts": ["water in gaseous form"]}, {"entity_id": "vapeurs_aqueuses", "book_id": "relation_historique_humboldt_vol3_1825", "name": "vapeurs aqueuses", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["vapeurs aqueuses", "vapeur aqueuse", "vapeurs", "vapeurs acides", "vapeurs acidul\u00e9es", "vapeurs v\u00e9>iculaires"], "contexts": ["vapors prevented from escaping by pellicle", "visible vaporous substances"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "vapeurs", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "vapeurs aqueuses", "similarity": 0.936}, {"source_book": "epoques_nature_buffon_1778", "source_name": "vapeurs aqueuses", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "vapeurs aqueuses", "similarity": 1.0}], "id": 2535, "stable_key": "clu_5edb552d7b955a80", "ground_truth": {"modern_name": "vapor", "confidence": "high", "type": "concept", "note": "Encompasses both gaseous water and gases from the earth.", "wikidata_id": "Q255722", "wikidata_description": "a substance in the gas phase at a temperature lower than its critical point", "wikipedia_url": "https://en.wikipedia.org/wiki/Vapor"}}, {"canonical_name": "zone temp\u00e9r\u00e9e", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "contr\u00e9es_temp\u00e9r\u00e9es", "book_id": "epoques_nature_buffon_1778", "name": "contr\u00e9es temp\u00e9r\u00e9es", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["contr\u00e9es temp\u00e9r\u00e9es"], "contexts": ["temperate regions"]}, {"entity_id": "r\u00e9gions_temp\u00e9r\u00e9es", "book_id": "epoques_nature_buffon_1778", "name": "r\u00e9gions temp\u00e9r\u00e9es", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["r\u00e9gions temp\u00e9r\u00e9es"], "contexts": ["climate zones between tropics and polar regions"]}, {"entity_id": "zone_temp\u00e9r\u00e9e", "book_id": "relation_historique_humboldt_vol3_1825", "name": "zone temp\u00e9r\u00e9e", "category": "PLACE", "subcategory": "REGION", "count": 13, "variants": ["zone temp\u00e9r\u00e9e"], "contexts": ["geographic region between tropics and polar circles", "climatic zone"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "contr\u00e9es temp\u00e9r\u00e9es", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "zone temp\u00e9r\u00e9e", "similarity": 0.902}, {"source_book": "epoques_nature_buffon_1778", "source_name": "r\u00e9gions temp\u00e9r\u00e9es", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "zone temp\u00e9r\u00e9e", "similarity": 0.919}], "id": 2536, "stable_key": "clu_ca5027614dab7820", "ground_truth": {"modern_name": "Temperate Zone", "confidence": "high", "type": "place", "country": "Global", "wikidata_id": "Q167466", "wikidata_description": "main climate class", "wikipedia_url": "https://en.wikipedia.org/wiki/Temperate%20climate"}}, {"canonical_name": "Nouveau-Mexique", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "nouveau_mexique", "book_id": "epoques_nature_buffon_1778", "name": "nouveau Mexique", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["nouveau Mexique"], "contexts": ["northern part of the Cordilleras"]}, {"entity_id": "nouveau-mexique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Nouveau-Mexique", "category": "PLACE", "subcategory": "REGION", "count": 14, "variants": ["Nouveau-Mexique"], "contexts": ["location with savannas", "region in North America"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "nouveau Mexique", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Nouveau-Mexique", "similarity": 0.815}], "id": 2537, "stable_key": "clu_f146ff5bb67e6c97", "ground_truth": {"modern_name": "New Mexico", "confidence": "high", "type": "place", "country": "United States", "wikidata_id": "Q7010253", "wikidata_description": "historic place register operated by the state government of New Mexico", "wikipedia_url": "https://en.wikipedia.org/wiki/New%20Mexico%20State%20Register%20of%20Cultural%20Properties"}}, {"canonical_name": "New Continent", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "nouveau_continent", "book_id": "epoques_nature_buffon_1778", "name": "nouveau continent", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["nouveau continent"], "contexts": ["referring to the Americas"]}, {"entity_id": "new_continent", "book_id": "kosmos_humboldt_1845", "name": "New Continent", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 14, "variants": ["New Continent"], "contexts": ["continent with lofty mountains", "referring to America"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "nouveau continent", "target_book": "kosmos_humboldt_1845", "target_name": "New Continent", "similarity": 0.908}], "id": 2538, "stable_key": "clu_681342a31cb797c0-2", "ground_truth": {"modern_name": "The Americas", "confidence": "high", "type": "place", "note": "The term 'Nouveau-Continent' and 'New Continent' clearly refer to the Americas in the context of exploration and geography.", "wikidata_id": "Q25398978", "wikidata_description": "genus of fishes"}}, {"canonical_name": "Meadows", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "meadows", "book_id": "english_physician_1652", "name": "Meadows", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 14, "variants": ["Meadows", "Meadowes"], "contexts": ["habitat for Ladies-Bedstraw", "natural habitat for plants"]}, {"entity_id": "meadows", "book_id": "connexion_physical_sciences_somerville_1858", "name": "meadows", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["meadows"], "contexts": ["grasslands often near water"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Meadows", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "meadows", "similarity": 0.936}], "id": 2539, "stable_key": "clu_b3235b8f2e7b13e9", "ground_truth": {"modern_name": "Meadow", "confidence": "high", "type": "place", "wikidata_id": "Q25062", "wikidata_description": "species of plant in the Rutaceae family"}}, {"canonical_name": "tormentilla", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "tormentil", "book_id": "english_physician_1652", "name": "Tormentil", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Tormentil"], "contexts": ["plant with reddish branches and yellow flowers", "herb with medicinal properties"]}, {"entity_id": "tormentilla", "book_id": "polyanthea_medicinal", "name": "tormentilla", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 12, "variants": ["tormentilla", "Tormentila", "tormen"], "contexts": ["used in ointment", "tormentil used in unguent"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Tormentil", "target_book": "polyanthea_medicinal", "target_name": "tormentilla", "similarity": 0.937}], "id": 2540, "stable_key": "clu_67693777b11bbac8", "ground_truth": {"modern_name": "Tormentil", "confidence": "high", "type": "plant", "linnaean": "Potentilla erecta", "family": "Rosaceae", "description": "A herbaceous perennial plant with medicinal properties, used in ointments.", "note": "Includes variations in Spanish and English.", "wikipedia_extract": "Potentilla erecta (syn. Tormentilla erecta, Potentilla laeta, Potentilla tormentilla, known as the (common) tormentil, septfoil or erect cinquefoil ) is a herbaceous perennial plant belonging to the rose family (Rosaceae). Potentilla erecta is a low, clump-forming plant with slender, procumbent to arcuately upright stalks, growing 10\u201330 centimetres (3.9\u201311.8 in) tall and with non-rooting runners. It grows wild predominantly in Europe and western Asia[1], mostly on acid soils and in a wide variety of habitats such as mountains, heaths, meadows, sandy soils and dunes. This plant flowers from May to August/September. There is one yellow, 7\u201311 millimetres (0.28\u20130.43 in) wide flower, growing at the tip of a long stalk."}}, {"canonical_name": "Pistil", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "pistil", "book_id": "origin_of_species_darwin_1859", "name": "Pistil", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["pistil", "Pistil"], "contexts": ["female reproductive part of a flower", "female reproductive organ of a flower"]}, {"entity_id": "pistils", "book_id": "origin_of_species_darwin_1859", "name": "pistils", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["pistils"], "contexts": ["female reproductive part of a flower", "female reproductive organs of a flower"]}, {"entity_id": "pistil", "book_id": "first_principles_spencer_1862", "name": "pistil", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["pistil"], "contexts": ["part of a flower"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Pistil", "target_book": "first_principles_spencer_1862", "target_name": "pistil", "similarity": 0.793}, {"source_book": "origin_of_species_darwin_1859", "source_name": "pistils", "target_book": "first_principles_spencer_1862", "target_name": "pistil", "similarity": 0.915}], "id": 2541, "stable_key": "clu_7bcdc7eeab8e5740", "ground_truth": {"modern_name": "Pistil", "confidence": "high", "type": "plant", "family": "N/A", "note": "One instance of 'pith' is likely an OCR or transcription error given the strong context of 'pistil' and its plural.", "wikidata_id": "Q108226839", "wikidata_description": "species of fungi in the genus Pistillaria", "wikipedia_extract": "Gynoecium (; from Ancient Greek  \u03b3\u03c5\u03bd\u03ae (gun\u1e17) 'woman, female' and  \u03bf\u1f36\u03ba\u03bf\u03c2 (o\u00eekos) 'house', pl. gynoecia) is most commonly used as a collective term for the parts of a flower that produce ovules and ultimately develop into the fruit and seeds. The gynoecium is the innermost whorl of a flower; it consists of (one or more) pistils and is typically surrounded by the pollen-producing reproductive organs, the stamens, collectively called the androecium. The gynoecium is often referred to as the \"female\" portion of the flower, although rather than directly producing female gametes (i.e. egg cells), the gynoecium produces megaspores, each of which develops into a female gametophyte which then produces egg cells. The term gynoecium is also used by botanists to refer to a cluster of archegonia and any associated modified leaves or stems present on a gametophyte shoot in mosses, liverworts, and hornworts. The corresponding terms for the male parts of those plants are clusters of antheridia within the androecium. Flowers that bear a gynoecium but no stamens are called pistillate or carpellate."}}, {"canonical_name": "Antarctic Ocean", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "south_arctic_ocean", "book_id": "kosmos_humboldt_1845", "name": "South Arctic Ocean", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["South Arctic Ocean"], "contexts": ["ocean where Diatomaceae died", "location of Diatomaceae"]}, {"entity_id": "antarctic_seas", "book_id": "kosmos_humboldt_1845", "name": "Antarctic Seas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Antarctic Seas"], "contexts": ["region for naval expedition"]}, {"entity_id": "arctic_seas", "book_id": "kosmos_humboldt_1845", "name": "Arctic seas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Arctic seas"], "contexts": ["seas in the Arctic region"]}, {"entity_id": "antarctic_ocean", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Antarctic Ocean", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Antarctic Ocean"], "contexts": ["origin of tides", "origin of tidal wave"]}, {"entity_id": "arctic_seas", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Arctic Seas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Arctic seas", "Arctic Seas"], "contexts": ["seas around the North Pole", "ocean north of the Arctic Circle"]}, {"entity_id": "antarctic_seas", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Antarctic seas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Antarctic seas"], "contexts": ["seas raising tides by sun and moon action"]}, {"entity_id": "arctic_sea", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Arctic Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Arctic Sea"], "contexts": ["sea in the Arctic region"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "South Arctic Ocean", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Antarctic Ocean", "similarity": 0.905}, {"source_book": "kosmos_humboldt_1