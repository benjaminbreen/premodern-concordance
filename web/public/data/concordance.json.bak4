sciences_somerville_1858", "target_name": "consideration", "similarity": 1.0}], "id": 4140, "stable_key": "clu_05024d9211750887", "ground_truth": {"modern_name": "consideration", "confidence": "high", "type": "concept"}}, {"canonical_name": "candle-flame", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "candle-flame", "book_id": "principles_of_psychology_james_1890", "name": "candle-flame", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["candle-flame"], "contexts": ["source of light and heat"]}, {"entity_id": "candle", "book_id": "connexion_physical_sciences_somerville_1858", "name": "candle", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["candle"], "contexts": ["source of light for observation", "source of light for experiment"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "candle-flame", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "candle", "similarity": 0.937}], "id": 4141, "stable_key": "clu_6a0103b8c610fa34", "ground_truth": {"modern_name": "candle", "confidence": "high", "type": "object", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "hope", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "hope", "book_id": "principles_of_psychology_james_1890", "name": "hope", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["hope"], "contexts": ["a phrenological faculty", "cardinal passion of life"]}, {"entity_id": "hopes", "book_id": "principles_of_psychology_james_1890", "name": "hopes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hopes"], "contexts": ["desires for future outcomes"]}, {"entity_id": "hope", "book_id": "kosmos_humboldt_1845", "name": "hope", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hope"], "contexts": ["feeling of expectation and desire"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "hope", "target_book": "kosmos_humboldt_1845", "target_name": "hope", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hopes", "target_book": "kosmos_humboldt_1845", "target_name": "hope", "similarity": 0.946}], "id": 4142, "stable_key": "clu_2090395b468c950e", "ground_truth": {"modern_name": "Hope", "confidence": "high", "type": "concept", "note": "The context 'phrenological faculty' strongly suggests the psychological concept of hope, also explicitly mentioned as 'feeling of expectation and desire'.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/J-Hope", "wikipedia_extract": "Jung Ho-seok (Korean: \uc815\ud638\uc11d; born February 18, 1994), known professionally as J-Hope (\uc81c\uc774\ud649; stylized in lower case), is a South Korean rapper, singer, songwriter, dancer, and record producer. He made his debut as a member of South Korean boy band BTS in 2013, under Big Hit Entertainment. J-Hope released his first solo mixtape, Hope World, in 2018. It was received positively by critics and peaked at number 38 on the US Billboard 200, the highest-charting album by a Korean solo artist at the time. He became the first member of BTS to enter the Billboard Hot 100 as a soloist in 2019, when his single \"Chicken Noodle Soup\", featuring singer Becky G, debuted at number 81. In 2022, J-Hope released his debut studio album Jack in the Box."}}, {"canonical_name": "Valentin", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "valentin", "book_id": "principles_of_psychology_james_1890", "name": "Valentin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Valentin"], "contexts": ["cited physiologist", "author of Physiology text"]}, {"entity_id": "valentin", "book_id": "polyanthea_medicinal", "name": "Valentin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Valentin", "Valentinus"], "contexts": ["mentioned in relation to antimony", "early modern scholar"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Valentin", "target_book": "polyanthea_medicinal", "target_name": "Valentin", "similarity": 1.0}], "id": 4143, "stable_key": "clu_1bb89e634e188a2d", "ground_truth": {"modern_name": "Bafilio Valentino", "confidence": "high", "type": "person", "description": "Early modern scholar and physiologist, author on antimony."}}, {"canonical_name": "melody", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "melody", "book_id": "principles_of_psychology_james_1890", "name": "melody", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["melody"], "contexts": ["sequence of musical notes"]}, {"entity_id": "melody", "book_id": "first_principles_spencer_1862", "name": "melody", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["melody"], "contexts": ["musical composition", "sequence of musical notes"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "melody", "target_book": "first_principles_spencer_1862", "target_name": "melody", "similarity": 1.0}], "id": 4144, "stable_key": "clu_50237c451963b635", "ground_truth": {"modern_name": "Melody", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "female given name", "wikipedia_extract": "A melody (from Greek  \u03bc\u03b5\u03bb\u1ff3\u03b4\u03af\u03b1 (mel\u014did\u00eda) 'singing, chanting'), also tune, voice, or line, is a linear succession of musical tones that the listener perceives as a single entity. In its most literal sense, a melody is a combination of pitch and rhythm, while more figuratively, the term can include other musical elements such as tonal color. It is the foreground to the background accompaniment. A line or part need not be a foreground melody. Melodies often consist of one or more musical phrases or motifs, and are usually repeated throughout a composition in various forms. Melodies may also be described by their melodic motion or the pitches or the intervals between pitches (predominantly conjunct or disjunct or with further restrictions), pitch range, tension and release, continuity and coherence, cadence, and shape."}}, {"canonical_name": "auditory nerve", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "auditory_nerve", "book_id": "principles_of_psychology_james_1890", "name": "auditory nerve", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["auditory nerve"], "contexts": ["nerve transmitting sound signals", "nerve for hearing"]}, {"entity_id": "auditory_nerves", "book_id": "connexion_physical_sciences_somerville_1858", "name": "auditory nerves", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["auditory nerves"], "contexts": ["nerves transmitting sound signals", "nerves that transmit sound signals"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "auditory nerve", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "auditory nerves", "similarity": 0.976}], "id": 4145, "stable_key": "clu_b7b628a09e841e74", "ground_truth": {"modern_name": "Auditory nerve", "confidence": "high", "type": "concept"}}, {"canonical_name": "Mr. Ballard", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "mr__ballard", "book_id": "principles_of_psychology_james_1890", "name": "Mr. Ballard", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Mr. Ballard"], "contexts": ["deaf-mute instructor", "deaf-mute instructor at National College"]}, {"entity_id": "mr__hall", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mr. Hall", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Mr. Hall"], "contexts": ["gentleman who constructed early achromatic telescope"]}, {"entity_id": "mr__barlow", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mr. Barlow", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Mr. Barlow"], "contexts": ["proposed theory of electric currents"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Mr. Ballard", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mr. Hall", "similarity": 0.863}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Mr. Ballard", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mr. Barlow", "similarity": 0.856}], "id": 4146, "stable_key": "clu_bf043de0a3763303", "ground_truth": {"modern_name": "William Barlow", "confidence": "medium", "type": "person", "birth_year": 1803, "death_year": 1860, "description": "English inventor of achromatic telescope", "note": "Multiple individuals named Mr. Ballard, Hall, or Barlow are mentioned. William Barlow is the most likely referent given the context of telescope construction. James's 'Principles of Psychology' could also refer to different figures or a general archetype.", "wikidata_id": "Q8005070", "wikidata_description": "English bishop of Chichester"}}, {"canonical_name": "enemy", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "enemy", "book_id": "principles_of_psychology_james_1890", "name": "enemy", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["enemy"], "contexts": ["person causing alarm", "opponent or adversary"]}, {"entity_id": "enemies", "book_id": "principles_of_p