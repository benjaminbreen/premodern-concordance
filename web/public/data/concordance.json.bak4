_275d933ddcfa49f7-4", "ground_truth": {"modern_name": "scientific experiment", "confidence": "high", "type": "concept", "note": "This cluster refers to the general concept and practice of conducting experiments for scientific inquiry.", "wikidata_id": "Q101965", "wikidata_description": "scientific procedure carried out to support, refute, or validate a hypothesis", "wikipedia_url": "https://en.wikipedia.org/wiki/Experiment", "wikipedia_extract": "An experiment is a procedure carried out to support or refute a hypothesis, or determine the efficacy or likelihood of something previously untried. Experiments provide insight into cause-and-effect by demonstrating what outcome occurs when a particular factor is manipulated. Experiments vary greatly in goal and scale but always rely on repeatable procedure and logical analysis of the results. There also exist  natural experimental studies. A child may carry out basic experiments to understand how things fall to the ground, while teams of scientists may take years of systematic investigation to advance their understanding of a phenomenon. Experiments and other types of hands-on activities are very important to student learning in the science classroom."}}, {"canonical_name": "m\u00e9taphysicien", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "m\u00e9taphysicien", "book_id": "medecine_experimentale_bernard_1865", "name": "m\u00e9taphysicien", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["m\u00e9taphysicien"], "contexts": ["philosopher dealing with abstract reality"]}, {"entity_id": "metaphysicians", "book_id": "origin_of_species_darwin_1859", "name": "metaphysicians", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["metaphysicians"], "contexts": ["philosophers studying fundamental reality"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "m\u00e9taphysicien", "target_book": "origin_of_species_darwin_1859", "target_name": "metaphysicians", "similarity": 0.902}], "id": 5064, "stable_key": "clu_b4eec2d5fe49a958", "ground_truth": {"modern_name": "metaphysics", "confidence": "high", "type": "concept", "wikidata_id": "Q35277", "wikidata_description": "branch of philosophy dealing with the nature, structure, components and fundamental principles of reality", "wikipedia_url": "https://en.wikipedia.org/wiki/Metaphysics"}}, {"canonical_name": "objective", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "objective", "book_id": "medecine_experimentale_bernard_1865", "name": "objective", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["objective"], "contexts": ["based on facts, not feelings"]}, {"entity_id": "objective", "book_id": "principles_of_psychology_james_1890", "name": "OBJECTIVE", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["OBJECTIVE"], "contexts": ["designations for things producing excitement"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "objective", "target_book": "principles_of_psychology_james_1890", "target_name": "OBJECTIVE", "similarity": 0.916}], "id": 5065, "stable_key": "clu_8938b63106538f60", "ground_truth": {"modern_name": "objective", "confidence": "high", "type": "concept", "wikidata_id": "Q206330", "wikidata_description": "central philosophical concept, related to reality and truth", "wikipedia_url": "https://en.wikipedia.org/wiki/Objectivity%20%28philosophy%29"}}, {"canonical_name": "S\u00e9narmont", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "s\u00e9narmont", "book_id": "medecine_experimentale_bernard_1865", "name": "S\u00e9narmont", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["S\u00e9narmont"], "contexts": ["subject of an eulo