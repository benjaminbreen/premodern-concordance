tegory": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["Red light", "red light"], "contexts": ["specific color of light used in experiment", "light of specific wavelength"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "red light", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "red light", "similarity": 1.0}], "id": 3466, "stable_key": "clu_47a6010ac77913d1-2", "ground_truth": {"modern_name": "Red Light", "confidence": "high", "type": "concept", "wikidata_id": "Q20266704", "wikidata_description": "painting by Francis Piatek"}}, {"canonical_name": "religious sentiment", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "religious_feeling", "book_id": "principles_of_psychology_james_1890", "name": "religious feeling", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["religious feeling"], "contexts": ["sense of spiritual belief"]}, {"entity_id": "religious_sentiment", "book_id": "first_principles_spencer_1862", "name": "religious sentiment", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["religious sentiment"], "contexts": ["products of the religious sentiment", "emotional aspect of religious belief"]}, {"entity_id": "religious_feeling", "book_id": "first_principles_spencer_1862", "name": "religious feeling", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["religious feeling"], "contexts": ["emotional response to religious ideas"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "religious feeling", "target_book": "first_principles_spencer_1862", "target_name": "religious sentiment", "similarity": 0.928}, {"source_book": "principles_of_psychology_james_1890", "source_name": "religious feeling", "target_book": "first_principles_spencer_1862", "target_name": "religious feeling", "similarity": 1.0}], "id": 3467, "stable_key": "clu_6f4267631046fd86", "ground_truth": {"modern_name": "religious sentiment", "confidence": "high", "type": "concept"}}, {"canonical_name": "Coma", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "coma", "book_id": "principles_of_psychology_james_1890", "name": "coma", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["coma"], "contexts": ["prolonged state of unconsciousness"]}, {"entity_id": "coma", "book_id": "polyanthea_medicinal", "name": "Coma", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["Coma", "Coma fomnolento", "Coma vigil"], "contexts": ["a type of harmful sleep", "a state of prolonged sleep or lethargy"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "coma", "target_book": "polyanthea_medicinal", "target_name": "Coma", "similarity": 0.714}], "id": 3468, "stable_key": "clu_138a89644eb67b6c", "ground_truth": {"modern_name": "Coma", "confidence": "high", "type": "disease", "description": "A state of prolonged, unnatural sleep or unconsciousness.", "note": "A medical condition characterized by deep unconsciousness.", "wikipedia_extract": "A coma is a prolonged state of deep unconsciousness in which a person cannot be awakened, fails to respond normally to painful stimuli, light, or sound, lacks a normal sleep-wake cycle and does not initiate voluntary actions. The person may experience respiratory and circulatory problems due to the body's inability to maintain normal bodily functions. People in a coma often require extensive medical care to maintain their health and prevent complications such as pneumonia or blood clots. Coma patients exhibit a complete absence of wakefulness and are unable to consciously feel, speak or move. Comas can be the result of natural causes, or can be medically induced, for example, during general anesthesia. Clinically, a coma can be defined as the consistent inability to follow a one-step command."}}, {"canonical_name": "piano-forte", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "piano-key", "book_id": "principles_of_psychology_james_1890", "name": "piano-key", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["piano-key"], "contexts": ["object producing sound when struck"]}, {"entity_id": "piano", "book_id": "principles_of_psychology_james_1890", "name": "piano", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["piano"], "contexts": ["instrument for producing overtones"]}, {"entity_id": "piano-forte", "book_id": "connexion_physical_sciences_somerville_1858", "name": "piano-forte", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["piano-forte"], "contexts": ["keyboard musical instrument", "musical instrument with strings"]}, {"entity_id": "piano", "book_id": "connexion_physical_sciences_somerville_1858", "name": "piano", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["piano"], "contexts": ["musical instrument"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "piano-key", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "piano-forte", "similarity": 0.884}, {"source_book": "principles_of_psychology_james_1890", "source_name": "piano-key", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "piano", "similarity": 0.889}, {"source_book": "principles_of_psychology_james_1890", "source_name": "piano", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "piano-forte", "similarity": 0.951}, {"source_book": "principles_of_psychology_james_1890", "source_name": "piano", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "piano", "similarity": 1.0}], "id": 3469, "stable_key": "clu_dae7a049963f3f46", "ground_truth": {"modern_name": "pianoforte", "confidence": "high", "type": "object"}}, {"canonical_name": "Mitchell", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "weir_mitchell", "book_id": "principles_of_psychology_james_1890", "name": "Weir Mitchell", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Dr. Weir Mitchell", "Weir Mitchell"], "contexts": ["republished case of Mary Reynolds", "physician who examined Mr. Bourne"]}, {"entity_id": "mitchell", "book_id": "kosmos_humboldt_1845", "name": "Mitchell", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Mitchell"], "contexts": ["devised torsion balance apparatus", "author cited in footnote"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Weir Mitchell", "target_book": "kosmos_humboldt_1845", "target_name": "Mitchell", "similarity": 0.886}], "id": 3470, "stable_key": "clu_d1f0d9304544024a", "ground_truth": {"modern_name": "S. Weir Mitchell", "confidence": "high", "type": "person", "birth_year": 1829, "death_year": 1914, "description": "American physician, novelist, and neurologist", "wikidata_id": "Q1283916", "wikidata_description": "American physician (1829\u20131914)"}}, {"canonical_name": "R. Brown", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "t__brown", "book_id": "principles_of_psychology_james_1890", "name": "T. Brown", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["T. Brown"], "contexts": ["author of Lectures on the Philosophy of the Human Mind"]}, {"entity_id": "r__brown", "book_id": "coloquios_da_orta_1563", "name": "R. Brown", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["R. Brown", "Roberto Brown"], "contexts": ["cited in relation to Zaire expedition", "authority on plant origins"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "T. Brown", "target_book": "coloquios_da_orta_1563", "target_name": "R. Brown", "similarity": 0.911}], "id": 3471, "stable_key": "clu_f9b98e9ed504c3f2", "ground_truth": {"modern_name": "Robert Brown", "confidence": "medium", "type": "person", "birth_year": 1773, "death_year": 1858, "description": "Scottish philosopher and geologist", "note": "The context 'cited in relation to Zaire expedition' might refer to the explorer Robert Brown, but 'author of Lectures on the Philosophy of the Human Mind' strongly points to the Scottish philosopher. Given the association with 'principles_of_psychology', the philosopher is the more likely referent. The text 'coloquios_da_orta_1563' seems misplaced for this identification."}}, {"canonical_name": "symbolic conceptions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "symbolic_conception", "book_id": "principles_of_psychology_james_1890", "name": "symbolic conception", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["symbolic conception"], "contexts": ["representation through symbols"]}, {"entity_id": "symbolic_concept", "book_id": "principles_of_psychology_james_1890", "name": "symbolic concept", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["symbolic concept"], "contexts": ["concept represented by symbols"]}, {"entity_id": "symbolic_conceptions", "book_id": "first_principles_spencer_1862", "name": "symbolic conceptions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["symbolic conceptions"], "contexts": ["abstract mental representations", "inadequate mental representations of complex objects"]}, {"entity_id": "symbolic_conception", "book_id": "first_principles_spencer_1862", "name": "symbolic conception", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["symbolic c