ants": ["meteoric streams"], "contexts": ["streams of meteors"]}, {"entity_id": "meteoric_shower", "book_id": "kosmos_humboldt_1845", "name": "meteoric shower", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["meteoric shower"], "contexts": ["display of meteors"]}, {"entity_id": "meteoric_showers", "book_id": "connexion_physical_sciences_somerville_1858", "name": "meteoric showers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["meteoric showers"], "contexts": ["celestial events exhibiting phenomena", "celestial phenomenon of falling meteors"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "meteoric streams", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "meteoric showers", "similarity": 0.891}, {"source_book": "kosmos_humboldt_1845", "source_name": "meteoric shower", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "meteoric showers", "similarity": 0.968}], "id": 4208, "stable_key": "clu_71494b0712be7db0", "ground_truth": {"modern_name": "Meteor shower", "confidence": "high", "type": "concept", "wikidata_id": "Q105000", "wikidata_description": "celestial event caused by streams of meteoroids entering Earth's atmosphere", "note": "The term 'meteoros' in 'polyanthea_medicinal' likely refers to atmospheric phenomena or meteors, aligning with 'showers of meteors'."}}, {"canonical_name": "Schiraz", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "schiraz", "book_id": "kosmos_humboldt_1845", "name": "Schiraz", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Schiraz"], "contexts": ["location of observations"]}, {"entity_id": "schiraz", "book_id": "coloquios_da_orta_1563", "name": "Schiraz", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Schiraz"], "contexts": ["city where Miguel Ferreira was received", "origin of weight unit"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Schiraz", "target_book": "coloquios_da_orta_1563", "target_name": "Schiraz", "similarity": 1.0}], "id": 4209, "stable_key": "clu_2182de894491f4ae", "ground_truth": {"modern_name": "Shiraz", "confidence": "high", "type": "place", "country": "Iran", "wikipedia_extract": "Shiraz is the fifth-most-populous city of Iran and the capital of Fars province, which is historically known by the exonym Persia proper. As of the 2016 national census, the population of the city was 1,565,572 people, and its built-up area with Sadra was home to almost 1,800,000 inhabitants. A census in 2021 showed an increase in the city's population to 1,995,500 people. Shiraz is located in southwestern Iran on the rudkhaneye khoshk (lit.\u2009'dry river') seasonal river. The city has a moderate climate and has been a regional trade center for over a thousand years. The earliest reference to the city, as Tirazi\u0161, is on Elamite clay tablets dated to 2000 BCE."}}, {"canonical_name": "Vulpecula", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "vulpis", "book_id": "kosmos_humboldt_1845", "name": "Vulpis", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Vulpis"], "contexts": ["constellation with similar phenomenon"]}, {"entity_id": "vulpecula", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Vulpecula", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Vulpecula"], "contexts": ["constellation containing a nebula", "nebula in"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Vulpis", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Vulpecula", "similarity": 0.889}], "id": 4210, "stable_key": "clu_ae86507a397426f1", "ground_truth": {"modern_name": "Vulpecula", "confidence": "high", "type": "place", "country": "Unknown", "note": "Vulpis is the Latin word for fox, and Vulpecula is a constellation named after a small fox. The context 'constellation containing dumb-bell nebula' confirms this.", "wikidata_id": "Q10519", "wikidata_description": "constellation in the northern celestial hemisphere", "wikipedia_extract": "Vulpecula () is a faint constellation in the Northern Sky. Its name is Latin for \"little fox\", although it is commonly called simply the Fox. It was identified in the 17th century, and is located in the middle of the Summer Triangle (an asterism consisting of the bright stars Deneb, Vega, and Altair). There are no stars brighter than 4th magnitude in this constellation. The brightest star in Vulpecula is Alpha Vulpeculae, a magnitude 4.44m red giant at an approximate distance of 291 light-years. The star is an optical binary (separation of 413.7\") that can be split using binoculars."}}, {"canonical_name": "Mariner\u2019s compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "mariner's_compass", "book_id": "kosmos_humboldt_1845", "name": "mariner's compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["mariner's compass"], "contexts": ["navigational instrument"]}, {"entity_id": "mariner\u2019s_compass", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mariner\u2019s compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["Mariner\u2019s compass", "mariner\u2019s compass"], "contexts": ["navigational instrument using a magnetic needle", "navigational instrument"]}, {"entity_id": "mariner's_compass", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mariner's compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["mariner's compass"], "contexts": ["magnetic needle for navigation"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "mariner's compass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mariner\u2019s compass", "similarity": 0.988}, {"source_book": "kosmos_humboldt_1845", "source_name": "mariner's compass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mariner's compass", "similarity": 1.0}], "id": 4211, "stable_key": "clu_32be2baa382d877a", "ground_truth": {"modern_name": "Mariner's compass", "confidence": "high", "type": "object", "wikidata_id": "Q7908138", "wikidata_description": "1989 Malayalam black comedy film directed by Sreenivasan", "wikipedia_url": "https://en.wikipedia.org/wiki/Vadakkunokkiyantram", "wikipedia_extract": "A compass is a device that shows the cardinal directions used for navigation and geographic orientation. It typically consists of a magnetized needle or another element, such as a compass card or compass rose, that pivots to align itself with magnetic north. Other methods may be used, including gyroscopes, magnetometers, and GPS receivers. Compasses often show angles in degrees: north corresponds to 0\u00b0, and the angles increase clockwise, so east is 90\u00b0, south is 180\u00b0, and west is 270\u00b0. These numbers allow the compass to show azimuths or bearings which are commonly stated in degrees. If local variation between magnetic north and true north is known, then direction of magnetic north also gives direction of true north."}}, {"canonical_name": "Magneto-electricity", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "electricity_and_magnetism", "book_id": "kosmos_humboldt_1845", "name": "electricity and magnetism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["electricity and magnetism"], "contexts": ["physical phenomena"]}, {"entity_id": "magneto-electricity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Magneto-electricity", "category": "CONCEPT", "subcategory": "THEORY", "count": 3, "variants": ["Magneto-Electricity", "Magneto-electricity", "magneto-electricity"], "contexts": ["electricity generated by magnetism", "science of magnetism and electricity interaction"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "electricity and magnetism", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Magneto-electricity", "similarity": 0.893}], "id": 4212, "stable_key": "clu_12955d7597e8937e-2", "ground_truth": {"modern_name": "electromagnetism", "confidence": "high", "type": "concept", "wikidata_id": "Q11406", "wikidata_description": "branch of science concerned with the phenomena of electricity and magnetism", "note": "The term 'Magneto-electricity' specifically refers to the generation of electricity from magnetic fields, a key component of electromagnetism."}}, {"canonical_name": "Isogeothermal lines", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "isogeothermal_lines", "book_id": "kosmos_humboldt_1845", "name": "isogeothermal lines", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["isogeothermal lines"], "contexts": ["lines of equal internal terrestrial temperature"]}, {"entity_id": "isogeothermal_lines", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Isogeothermal lines", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Isogeothermal lines", "Isogeothermal Lines", "isogeothermal lines"], "contexts": ["lines of equal geothermal temperature", "lines of equal mean ground temperature"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "isogeothermal lines", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Isogeothermal lines", "similarity": 0.976}], "id": 4213, "stable_key": "clu_c9da50464a02c146", "ground_truth": {"modern_name": "Isotherm", "confidence": "high", "type": "concept", "note": "Isogeothermal lines refer to lines connecting points of equal geothermal temperature, which are a specific type of isotherm.", "wikidata_id": "Q486921", "wikidata_description": "thermodynamic process in which the temperature remains constant"}}, {"canonical_name": "interference of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "interference_of_light", "book_id": "kosmos_humboldt_1845", "name": "interference of light", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["interference of light"], "contexts": ["optical phenomenon explained by wave interaction"]}, {"entity_id": "interference_of_light", "book_id": "connexion_physical_sciences_somerville_1858", "name": "interference of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Interference of Light", "interference of light"], "contexts": ["wave interaction of light", "wave phenomenon causing coloured fringes"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "interference of light", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "interference of light", "similarity": 1.0}], "id": 4214, "stable_key": "clu_7cd2d200f5004d6c", "ground_truth": {"modern_name": "Interference of light", "confidence": "high", "type": "concept", "wikidata_id": "Q71862002", "wikidata_description": "scientific article published on 01 October 1967"}}, {"canonical_name": "Tolosa", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "tolosa", "book_id": "kosmos_humboldt_1845", "name": "Tolosa", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Tolosa"], "contexts": ["location between cities"]}, {"entity_id": "tolosa", "book_id": "coloquios_da_orta_1563", "name": "Tolosa", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Tolosa"], "contexts": ["city of printing", "publication location of De proprietatibus rerum"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Tolosa", "target_book": "coloquios_da_orta_1563", "target_name": "Tolosa", "similarity": 1.0}], "id": 4215, "stable_key": "clu_8de2fd446b11fda3", "ground_truth": {"modern_name": "Toulouse", "confidence": "high", "type": "place", "description": "A city in southern France, historically significant for its printing and scientific observations.", "wikipedia_extract": "Toulouse (, too-LOOZ, French: [tuluz] ; Occitan: Tolosa [tu\u02c8luz\u0254] ) is a city in Southern France, the prefecture of the Haute-Garonne department and of the Occitania region. The city is on the banks of the River Garonne, 150 kilometres (93 miles) from the Mediterranean Sea, 230 km (143 mi) from the Atlantic Ocean and 680 km (420 mi) from Paris. It is the fourth-largest city in France after Paris, Marseille, and Lyon, with 511,684 inhabitants within its municipal boundaries (2022); its metropolitan area has a population of 1,513,396 inhabitants (2022). Toulouse is the central city of one of the 22 metropolitan councils of France. Between the 2014 and 2020 censuses, its metropolitan area was the third fastest growing among metropolitan areas larger than 500,000 inhabitants in France. Toulouse is the centre of the European aerospace industry, with the headquarters of Airbus, the SPOT satellite system, ATR and the Aerospace Valley."}}, {"canonical_name": "Blume", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "blom", "book_id": "kosmos_humboldt_1845", "name": "Blom", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Blom"], "contexts": ["author of 'Stat. Beschr. von Norwegen'"]}, {"entity_id": "blume", "book_id": "coloquios_da_orta_1563", "name": "Blume", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Blume"], "contexts": ["botanist who classified a tree", "botanist, associated with Cinnamomum nitidum"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Blom", "target_book": "coloquios_da_orta_1563", "target_name": "Blume", "similarity": 0.868}], "id": 4216, "stable_key": "clu_9a14621782f89664", "ground_truth": {"modern_name": "Carl Ludwig Blume", "confidence": "high", "type": "person", "birth_year": 1796, "death_year": 1862, "description": "Dutch botanist and physician, known for Indonesian flora", "wikidata_id": "Q76816", "wikidata_description": "German-Dutch botanist (1796-1862)", "wikipedia_url": "https://en.wikipedia.org/wiki/Carl%20Ludwig%20Blume", "wikipedia_extract": "Charles Ludwig de Blume or Karl Ludwig von Blume (9 June 1796 \u2013 3 February 1862) was a German-Dutch botanist and entomologist who spent most of his professional life in the Netherlands and the Dutch East Indies. As deputy director of agriculture at the Bogor Botanical Gardens in Java (1823\u20131826) and later director of the Rijksherbarium in Leiden, he conducted extensive studies of Southeast Asian flora, publishing numerous influential works including Bijdragen tot de flora van Nederlandsch Indi\u00eb (1825\u20131827) and Rumphia (1835\u20131849). Together with Philipp Franz von Siebold, Blume co-founded the Royal Society for the Encouragement of Horticulture in the Netherlands in 1842, helping to revitalise the country's reputation as a centre for botanical study and exotic plant cultivation. His scientific contributions were recognised with his election as a foreign member of the Royal Swedish Academy of Sciences in 1855, and his legacy is commemorated in the botanical journal Blumea, which bears his name. Blume was born at Braunschweig in Germany, but studied at Leiden University and spent his professional life working in the Dutch East Indies and in the Netherlands, where he was Director of the Rijksherbarium (state herbarium) at Leiden. His name is sometimes given in the Dutch language form Karel Lodewijk Blume, but the original German spelling is the one most widely used in botanical texts: even then there is confusion, as he is sometimes referred to as K.L."}}, {"canonical_name": "illum", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "luminary", "book_id": "kosmos_humboldt_1845", "name": "luminary", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["luminary"], "contexts": ["celestial body that gives light"]}, {"entity_id": "illum", "book_id": "polyanthea_medicinal", "name": "illum", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["illum"], "contexts": ["Latin for 'it'"]}, {"entity_id": "luminar", "book_id": "polyanthea_medicinal", "name": "Luminar", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Luminar"], "contexts": ["title of a book"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "luminary", "target_book": "polyanthea_medicinal", "target_name": "illum", "similarity": 0.915}, {"source_book": "kosmos_humboldt_1845", "source_name": "luminary", "target_book": "polyanthea_medicinal", "target_name": "Luminar", "similarity": 0.916}], "id": 4217, "stable_key": "clu_be7c845c6495fde5", "ground_truth": {"modern_name": "luminary", "confidence": "medium", "type": "concept", "note": "The term 'illum' and 'Luminar' likely refer to a 'luminary' in a general sense (celestial body or influential person), or potentially a specific text titled 'Luminar'. Context is limited for definitive identification.", "wikidata_id": "Q13360024", "wikidata_description": "astrology concept"}}, {"canonical_name": "spring-tides", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "spring-tides", "book_id": "kosmos_humboldt_1845", "name": "spring-tides", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["spring-tides"], "contexts": ["highest tides during new/full moon"]}, {"entity_id": "spring_tides", "book_id": "connexion_physical_sciences_somerville_1858", "name": "spring tides", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["spring tides"], "contexts": ["highest tides due to combined lunar/solar action"]}, {"entity_id": "spring_tide", "book_id": "connexion_physical_sciences_somerville_1858", "name": "spring tide", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["spring tide"], "contexts": ["tide when solar and lunar waves coincide"]}, {"entity_id": "spring-tides", "book_id": "connexion_physical_sciences_somerville_1858", "name": "spring-tides", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["spring-tides"], "contexts": ["tides occurring at new/full moon"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "spring-tides", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "spring tides", "similarity": 0.894}, {"source_book": "kosmos_humboldt_1845", "source_name": "spring-tides", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "spring tide", "similarity": 0.874}, {"source_book": "kosmos_humboldt_1845", "source_name": "spring-tides", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "spring-tides", "similarity": 1.0}], "id": 4218, "stable_key": "clu_74892da515707828", "ground_truth": {"modern_name": "spring tide", "confidence": "high", "type": "concept"}}, {"canonical_name": "atmospheric electricity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "electricity_of_the_atmosphere", "book_id": "kosmos_humboldt_1845", "name": "electricity of the atmosphere", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["electricity of the atmosphere"], "contexts": ["electrical phenomena in the atmosphere"]}, {"entity_id": "atmospheric_electricity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "atmospheric electricity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Atmospheric Electricity", "atmospheric electricity"], "contexts": ["electricity present in the atmosphere", "electricity in the atmosphere"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "electricity of the atmosphere", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "atmospheric electricity", "similarity": 0.932}], "id": 4219, "stable_key": "clu_af273e941d5cab9f", "ground_truth": {"modern_name": "Atmospheric electricity", "confidence": "high", "type": "concept", "wikidata_id": "Q427085", "wikidata_description": "electricity in planetary atmospheres"}}, {"canonical_name": "Pouillet", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "pouillet", "book_id": "kosmos_humboldt_1845", "name": "Pouillet", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Pouillet"], "contexts": ["researcher on electricity"]}, {"entity_id": "pouillet", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Pouillet", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Pouillet"], "contexts": ["theorist of space temperature", "provided solar radiation data"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Pouillet", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Pouillet", "similarity": 1.0}], "id": 4220, "stable_key": "clu_7574b6113cf838c3", "ground_truth": {"modern_name": "Claude Pouillet", "confidence": "high", "type": "person", "birth_year": 1791, "death_year": 1874, "description": "Physicist known for work on photometry and heat.", "wikidata_id": "Q3447474", "wikidata_description": "street in Paris, France"}}, {"canonical_name": "philology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "philosophical_philology", "book_id": "kosmos_humboldt_1845", "name": "philosophical philology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["philosophical philology"], "contexts": ["study of language and national character"]}, {"entity_id": "philology", "book_id": "first_principles_spencer_1862", "name": "philology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["philology", "Philology"], "contexts": ["study of language and literature", "study of language history and structure"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "philosophical philology", "target_book": "first_principles_spencer_1862", "target_name": "philology", "similarity": 0.939}], "id": 4221, "stable_key": "clu_fdd1760613d99800", "ground_truth": {"modern_name": "Philology", "confidence": "high", "type": "concept", "wikidata_id": "Q40634", "wikidata_description": "study of language in written historical sources"}}, {"canonical_name": "electrical intensity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "intensity_of_electricity", "book_id": "kosmos_humboldt_1845", "name": "intensity of electricity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["intensity of electricity"], "contexts": ["strength of electrical charge"]}, {"entity_id": "electrical_intensity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "electrical intensity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["electrical intensity"], "contexts": ["measure of electrical force strength", "strength of electrical charge"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "intensity of electricity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electrical intensity", "similarity": 0.973}], "id": 4222, "stable_key": "clu_18e452fcb8fb5349", "ground_truth": {"modern_name": "Electrical intensity", "confidence": "high", "type": "concept"}}, {"canonical_name": "telescopic planets", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "telescopic_stars", "book_id": "kosmos_humboldt_1845", "name": "telescopic stars", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["telescopic stars"], "contexts": ["stars visible through telescope"]}, {"entity_id": "telescopic_planets", "book_id": "connexion_physical_sciences_somerville_1858", "name": "telescopic planets", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["telescopic planets"], "contexts": ["small celestial bodies with united mass", "planets discovered by systematic search"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "telescopic stars", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "telescopic planets", "similarity": 0.897}], "id": 4223, "stable_key": "clu_a35319161f48ef14", "ground_truth": {"modern_name": "Faint celestial objects", "confidence": "medium", "type": "object", "note": "The term 'telescopic planets' and 'telescopic stars' in this context likely refers to celestial bodies that are only visible through a telescope, implying they are faint or small, rather than literal planets that appear as stars.", "wikidata_id": "Q523", "wikidata_description": "astronomical object consisting of a luminous spheroid of plasma held together by its own gravity"}}, {"canonical_name": "proper motions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "proper_motion", "book_id": "kosmos_humboldt_1845", "name": "proper motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["proper motion"], "contexts": ["movement of celestial bodies"]}, {"entity_id": "proper_motions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "proper motions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Proper Motions", "proper motions"], "contexts": ["actual movement of stars", "actual movement of stars through space"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "proper motion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "proper motions", "similarity": 0.965}], "id": 4224, "stable_key": "clu_1b0348265fa5a573", "ground_truth": {"modern_name": "Proper motion", "confidence": "high", "type": "concept", "wikidata_id": "Q59703281", "wikidata_description": "scientific article published in Astronomy and Astrophysics"}}, {"canonical_name": "opilaviodes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "opilaviodes", "book_id": "historia_medicinal_monardes_1574", "name": "opilaviodes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["opilaviodes", "opilacion"], "contexts": ["obstructions treated by the water", "obstruction or hardness in the body"]}, {"entity_id": "opila\u00e7am", "book_id": "coloquios_da_orta_1563", "name": "opila\u00e7am", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["opila\u00e7am"], "contexts": ["condition of obstruction"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "opilaviodes", "target_book": "coloquios_da_orta_1563", "target_name": "opila\u00e7am", "similarity": 0.904}], "id": 4225, "stable_key": "clu_96f5d047c125bda8", "ground_truth": {"modern_name": "Obstruction", "confidence": "high", "type": "disease", "description": "A blockage or impeded flow within the body.", "note": "Medical term referring to blockages in bodily humors or vessels.", "wikipedia_extract": "Bowel obstruction, also known as intestinal obstruction, is a mechanical or functional obstruction of the intestines that prevents the normal movement of the products of digestion. Either the small bowel or large bowel may be affected. Signs and symptoms include abdominal pain, vomiting, bloating and not passing gas. Mechanical obstruction is the cause of about 5 to 15% of cases of severe abdominal pain of sudden onset requiring admission to hospital. Causes of bowel obstruction include adhesions, hernias, volvulus, endometriosis, inflammatory bowel disease, appendicitis, tumors, diverticulitis, ischemic bowel, tuberculosis and intussusception. Small bowel obstructions are most often due to adhesions and hernias, while large bowel obstructions are most often due to tumors and volvulus."}}, {"canonical_name": "Latinos", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "latinos", "book_id": "historia_medicinal_monardes_1574", "name": "Latinos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Latinos"], "contexts": ["ancient Latin authorities on dragon's blood", "Latin physicians wrote remedies"]}, {"entity_id": "latinos", "book_id": "polyanthea_medicinal", "name": "Latinos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Latinos"], "contexts": ["speakers of the Latin language"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Latinos", "target_book": "polyanthea_medicinal", "target_name": "Latinos", "similarity": 1.0}], "id": 4226, "stable_key": "clu_f07392e2f8652ce9-2", "ground_truth": {"modern_name": "Latins", "confidence": "high", "type": "person", "description": "People associated with Latin language, culture, or ancient Rome.", "note": "Can refer to people, authors, or languages.", "wikipedia_extract": "The term Latin has been used to describe several groups of people throughout history, first referring to the inhabitants of the ancient Latium region, then to Catholic Christians of the Latin rite, and most recently to Romance-speaking peoples. The Latins were an ancient Italic people of the Latium region in central Italy (Latium Vetus, \"Old Latium\"), in the 1st millennium BC. Although they lived in independent city-states, they spoke Latin as a common language, held common religious beliefs, and extended common rights of residence and trade to one another. Collectively, these Latin states were known as the Latin League. A rupture between Rome, one of the Latin states, and the rest of the Latin League emerged as a result of the former's territorial ambitions. The Latin League fought against Rome in the Latin War (340\u2013338 BC), which ended in a Roman victory."}}, {"canonical_name": "cli\u017fteres", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "cli\u017fteres", "book_id": "historia_medicinal_monardes_1574", "name": "cli\u017fteres", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["cli\u017fteres", "cly\u00edteres"], "contexts": ["enema for bowel evacuation", "medical instruments for enemas"]}, {"entity_id": "cly\u017fteis", "book_id": "polyanthea_medicinal", "name": "cly\u017fteis", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["cly\u017fteis"], "contexts": ["type of medicinal administration discussed", "medical preparation for internal administration"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "cli\u017fteres", "target_book": "polyanthea_medicinal", "target_name": "cly\u017fteis", "similarity": 0.887}], "id": 4227, "stable_key": "clu_4e35ae8a18bbfc91", "ground_truth": {"modern_name": "Enema", "confidence": "high", "type": "object", "wikidata_id": "Q4038065", "wikidata_description": "genus of insects", "wikipedia_extract": "An enema, also known as a clyster, is the rectal administration of a fluid by injection into the lower bowel via the anus. The word enema can also refer to the liquid injected, as well as to a device for administering such an injection. In standard medicine, the most frequent uses of enemas are to relieve constipation and for bowel cleansing before a medical examination or procedure; also, they are employed as a lower gastrointestinal series (also called a barium enema), to treat traveler's diarrhea, as a vehicle for the administration of food, water or medicine, as a stimulant to the general system, as a local application and, more rarely, as a means of reducing body temperature, as treatment for encopresis, and as a form of rehydration therapy (proctoclysis) in patients for whom intravenous therapy is not applicable. The principal medical usages of enemas are: As bowel stimulants, enemas are employed for the same purposes as orally administered laxatives: to relieve constipation; to treat fecal impaction; to empty the colon before a medical procedure such as a colonoscopy. When oral laxatives are not indicated or sufficiently effective, enemas may be a sensible and necessary measure. A large volume enema can be given to cleanse as much of the colon as possible of feces."}}, {"canonical_name": "D.", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "d_", "book_id": "historia_medicinal_monardes_1574", "name": "D.", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["D.", "B."], "contexts": ["initial for a person's name"]}, {"entity_id": "d__c_", "book_id": "coloquios_da_orta_1563", "name": "D. C.", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["D. C."], "contexts": ["author of scientific name", "initials associated with a plant name"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "D.", "target_book": "coloquios_da_orta_1563", "target_name": "D. C.", "similarity": 0.87}], "id": 4228, "stable_key": "clu_0e51311034619a6b", "ground_truth": {"modern_name": "initials of a person", "confidence": "medium", "type": "person", "description": "Initials used to refer to an author or individual.", "note": "Ambiguous without further context to identify the specific individual(s)."}}, {"canonical_name": "Napoles", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "napoles", "book_id": "historia_medicinal_monardes_1574", "name": "Napoles", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Napoles"], "contexts": ["city name", "city where Charles was"]}, {"entity_id": "n\u00e1poles", "book_id": "coloquios_da_orta_1563", "name": "N\u00e1poles", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["N\u00e1poles"], "contexts": ["city where war was helped", "city besieged by Charles VIII"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Napoles", "target_book": "coloquios_da_orta_1563", "target_name": "N\u00e1poles", "similarity": 0.963}], "id": 4229, "stable_key": "clu_dad8e25a6099f87d-2", "ground_truth": {"modern_name": "Naples", "confidence": "high", "type": "place", "description": "A major city in southern Italy, historically significant for its kingdom.", "wikipedia_extract": "Naples is the regional capital of Campania, Italy. With a population of 908,082 within the city's administrative limits (as of 2025), it is the largest city in southern Italy and the third-largest city of Italy after Rome and Milan, while its province-level municipality is the third most populous metropolitan city in Italy with a population of 2,958,410 residents. Its metropolitan area, the seventh most populous in the European Union, stretches beyond the boundaries of the city wall for approximately 30 kilometres (20 miles). Naples also plays a key role in international diplomacy, being home to NATO's Allied Joint Force Command Naples and the Parliamentary Assembly of the Mediterranean. Founded by Greeks in the first millennium BCE, Naples is one of the oldest continuously inhabited urban areas in the world. In the eighth century BCE, a colony known as Parthenope (Ancient Greek: \u03a0\u03b1\u03c1\u03b8\u03b5\u03bd\u03cc\u03c0\u03b7) was established on the Pizzofalcone hill."}}, {"canonical_name": "enfriar", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "enfriar", "book_id": "historia_medicinal_monardes_1574", "name": "enfriar", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["enfriar"], "contexts": ["quality attributed to iron and mercury"]}, {"entity_id": "enfriamos", "book_id": "polyanthea_medicinal", "name": "enfriamos", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["enfriamos", "resfriamos"], "contexts": ["becoming cold due to fear"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "enfriar", "target_book": "polyanthea_medicinal", "target_name": "enfriamos", "similarity": 0.896}], "id": 4230, "stable_key": "clu_425ba3f2ab6d7908-2", "ground_truth": {"modern_name": "Cooling", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Cooling", "note": "Refers to the process or quality of becoming cold or decreasing in temperature.", "wikipedia_extract": "Cooling is removal of heat, usually resulting in a lower temperature and/or phase change. Temperature lowering achieved by any other means may also be called cooling. The transfer of thermal energy may occur via thermal radiation, heat conduction or convection. Examples can be as simple as reducing temperature of tea."}}, {"canonical_name": "Berb\u00e9ria", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "berber\u00eda", "book_id": "historia_medicinal_monardes_1574", "name": "Berber\u00eda", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Berber\u00eda"], "contexts": ["place of origin for rhubarb"]}, {"entity_id": "berb\u00e9ria", "book_id": "coloquios_da_orta_1563", "name": "Berb\u00e9ria", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Berb\u00e9ria"], "contexts": ["coast mentioned as potential origin", "region where rhubarb is traded"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Berber\u00eda", "target_book": "coloquios_da_orta_1563", "target_name": "Berb\u00e9ria", "similarity": 0.886}], "id": 4231, "stable_key": "clu_3172dd973a979450", "ground_truth": {"modern_name": "Barbary Coast", "confidence": "high", "type": "place", "country": "Algeria, Libya, Morocco, Tunisia", "wikidata_id": "Q501768", "wikidata_description": "name used to designate the territory of the Barbary and going from Libya to Morocco", "wikipedia_url": "https://en.wikipedia.org/wiki/Barbary%20Coast", "wikipedia_extract": "The Barbary Coast (also Barbary, Berbery, or Berber Coast) were the coastal areas of central and western North Africa, more specifically, the Maghreb and the Ottoman borderlands consisting of the regencies in Algiers, Tunis, and Tripoli, as well as the Sultanate of Morocco from the 16th to 19th centuries. The term originates from an exonym for the Berbers. Barbary was not always a unified political entity. From the 16th century onward, it was divided into four political entities\u2014from west to east\u2014the Alawi Sultanate, the Regency of Algiers, the Regency of Tunis, and the Regency of Tripoli. Major rulers and petty monarchs during the times of the Barbary states' plundering parties included the sultan of Morocco, the dey of Algiers, bey of Tunis, and pasha of Tripoli, respectively. The slave trade was not just an economic lifeline to the Barbary States, but was often justified as a form of jihad against Christian states.", "note": "Refers to the historical coastal region of North Africa."}}, {"canonical_name": "perfume", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "fragancia", "book_id": "historia_medicinal_monardes_1574", "name": "fragancia", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["fragancia"], "contexts": ["quality of the Saissasfras bark"]}, {"entity_id": "perfume", "book_id": "coloquios_da_orta_1563", "name": "perfume", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["perfume"], "contexts": ["used from flowers", "fragrance"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "fragancia", "target_book": "coloquios_da_orta_1563", "target_name": "perfume", "similarity": 0.953}], "id": 4232, "stable_key": "clu_ea4305b10a6dcca1", "ground_truth": {"modern_name": "Fragrance", "confidence": "high", "type": "concept"}}, {"canonical_name": "Pictor", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "pintores", "book_id": "historia_medicinal_monardes_1574", "name": "pintores", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["pintores"], "contexts": ["wondrous color for painters"]}, {"entity_id": "pictor", "book_id": "polyanthea_medicinal", "name": "Pictor", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Pictor", "Piator", "Pintor"], "contexts": ["mentioned in relation to an imagined physician", "occupation of Manoelda Paz"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "pintores", "target_book": "polyanthea_medicinal", "target_name": "Pictor", "similarity": 0.867}], "id": 4233, "stable_key": "clu_66050b1b850f6934", "ground_truth": {"modern_name": "Painter", "confidence": "high", "type": "person", "description": "An individual skilled in the art of painting.", "wikidata_id": "Q1630100", "wikidata_description": "person who poses for any visual artist as part of the creative process"}}, {"canonical_name": "pedra be^ar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "piedra_bera", "book_id": "historia_medicinal_monardes_1574", "name": "piedra Bera", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["piedra Bera"], "contexts": ["stone with demonstrated virtues"]}, {"entity_id": "pedra_be^ar", "book_id": "coloquios_da_orta_1563", "name": "pedra be^ar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["pedra be^ar"], "contexts": ["a specific type of stone", "stone used as medicine"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "piedra Bera", "target_book": "coloquios_da_orta_1563", "target_name": "pedra be^ar", "similarity": 0.889}], "id": 4234, "stable_key": "clu_0c4aa0111f771c6b-2", "ground_truth": {"modern_name": "Bezoar", "confidence": "high", "type": "mineral", "note": "'Bola' is the Arabic word for bezoar, a medicinal concretion found in the stomach of some animals. 'Bolas' in the second source likely refers to the same.", "wikidata_id": "Q897514", "wikidata_description": "subspecies of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Bezoar%20ibex", "wikipedia_extract": "The bezoar ibex (Capra aegagrus aegagrus) is a wild goat subspecies that is native to the montane forested areas in the Anatolia, Caucasus and the Zagros Mountains. The bezoar ibex, which weighs around 60 kg (130 lb) is known particularly for the size of its horns; it possesses the world's longest horns in relation to body weight, and can exceed 1.4 m (4 ft 7 in) high, those in the south and east desert ranges are typically smaller by 30 percent. Females are slightly smaller and their horns tend to grow to 0.2 m (7.9 in). Males have a dark brown summer coat, while the females have a more reddish-gold, and both sexes shift to a gray-colored coat in winter. Both sexes also have a tuft of hair extending from the chin. The ibexes have a black stripe from the spine that extends over the shoulder, limbs, and neck.", "description": "Calculus found in the stomach of animals, used as an antidote."}}, {"canonical_name": "Bartholomeus Urbevetanus", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "bartholomeus_anglicus", "book_id": "historia_medicinal_monardes_1574", "name": "Bartholomeus Anglicus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bartholomeus Anglicus"], "contexts": ["author of 'De Proprietatibus Rerum'"]}, {"entity_id": "bartholomeus_urbevetanus", "book_id": "coloquios_da_orta_1563", "name": "Bartholomeus Urbevetanus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Bartholomeus Urbevetanus", "Bartholomeu de Glanvilla"], "contexts": ["author of commentaries", "author of a book"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Bartholomeus Anglicus", "target_book": "coloquios_da_orta_1563", "target_name": "Bartholomeus Urbevetanus", "similarity": 0.852}], "id": 4235, "stable_key": "clu_6897ff9c824dfb44", "ground_truth": {"modern_name": "Bartholomew Anglicus", "confidence": "high", "type": "person", "description": "English Franciscan friar and scholastic", "note": "The text uses both 'Bartholomeus Urbevetanus' and 'Bartholomeus Anglicus'. Bartholomew Anglicus is the known author of 'De Proprietatibus Rerum'.", "wikidata_id": "Q809312", "wikidata_description": "13th-century scholastic scholar, author of the compendium De proprietatibus rerum"}}, {"canonical_name": "dano", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "da\u00f1o", "book_id": "historia_medicinal_monardes_1574", "name": "da\u00f1o", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["da\u00f1o"], "contexts": ["harmful effect of remedies"]}, {"entity_id": "dano", "book_id": "polyanthea_medicinal", "name": "dano", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["dano", "damnos", "danos"], "contexts": ["harm or damage", "damage caused by acids"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "da\u00f1o", "target_book": "polyanthea_medicinal", "target_name": "dano", "similarity": 0.541}], "id": 4236, "stable_key": "clu_27d4a1839c49a682", "ground_truth": {"modern_name": "harm", "confidence": "high", "type": "concept", "note": "'Dano' and 'da\u00f1o' in this context refer to harm or damage, not a specific disease."}}, {"canonical_name": "adelga\u00e7ao", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "adelgazar", "book_id": "historia_medicinal_monardes_1574", "name": "adelgazar", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["adelgazar"], "contexts": ["to thin or make slender"]}, {"entity_id": "adelga\u00e7ao", "book_id": "polyanthea_medicinal", "name": "adelga\u00e7ao", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["adelga\u00e7ao"], "contexts": ["thinning, a quality", "thinning"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "adelgazar", "target_book": "polyanthea_medicinal", "target_name": "adelga\u00e7ao", "similarity": 0.935}], "id": 4237, "stable_key": "clu_daf60814aa005c4d", "ground_truth": {"modern_name": "thinning", "confidence": "high", "type": "concept", "note": "Refers to the concept of becoming or making something thinner or slender.", "wikidata_id": "Q500094", "wikidata_description": "selective removal of parts of a plant"}}, {"canonical_name": "Romanos", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "romanos", "book_id": "coloquios_da_orta_1563", "name": "Romanos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Romanos", "Romeos"], "contexts": ["people known for their past knowledge", "people who disliked the Partos"]}, {"entity_id": "romanisan", "book_id": "polyanthea_medicinal", "name": "Romanisan", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Romanisan"], "contexts": ["person who could not be cured"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Romanos", "target_book": "polyanthea_medicinal", "target_name": "Romanisan", "similarity": 0.871}], "id": 4238, "stable_key": "clu_d7f08ed1fe552014-2", "ground_truth": {"modern_name": "Romans", "confidence": "high", "type": "concept", "note": "Refers to the ancient Roman civilization and its people, not an individual. The text 'historia_medicinal_monardes_1574' likely uses 'romanos' in a historical context.", "wikidata_id": "Q100899067", "wikidata_description": "basketball player"}}, {"canonical_name": "leite azedo", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "leite_azedo", "book_id": "coloquios_da_orta_1563", "name": "leite azedo", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["leite azedo"], "contexts": ["preparation for asthma", "ingredient mixed with powder"]}, {"entity_id": "leite_asinino", "book_id": "polyanthea_medicinal", "name": "leite asinino", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["leite asinino"], "contexts": ["donkey milk for eye ailments"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "leite azedo", "target_book": "polyanthea_medicinal", "target_name": "leite asinino", "similarity": 0.906}], "id": 4239, "stable_key": "clu_b122cecdd734d8b5", "ground_truth": {"modern_name": "donkey milk", "confidence": "high", "type": "substance", "note": "Contextual clues like 'preparation for asthma' and 'donkey milk for eye ailments' point to donkey milk.", "wikidata_id": "Q129528842", "wikidata_description": "scholarly article"}}, {"canonical_name": "amarello", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "amarello", "book_id": "coloquios_da_orta_1563", "name": "amarello", "category": "CONCEPT", "subcategory": "QUALITY", "count": 3, "variants": ["amarello", "Amarello"], "contexts": ["color used for dyeing", "river name"]}, {"entity_id": "amarella", "book_id": "polyanthea_medicinal", "name": "amarella", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["amarella"], "contexts": ["yellow color"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "amarello", "target_book": "polyanthea_medicinal", "target_name": "amarella", "similarity": 0.954}], "id": 4240, "stable_key": "clu_5e9283beaa9a7d5e", "ground_truth": {"modern_name": "Yellow", "confidence": "high", "type": "concept", "wikidata_id": "Q1148004", "wikidata_description": "mosquito species, a vector for diseases including yellow fever and Zika fever", "wikipedia_url": "https://en.wikipedia.org/wiki/Aedes%20aegypti", "note": "Refers to the color yellow, used metaphorically and literally for dyeing.", "wikipedia_extract": "Aedes aegypti (; US: ; from Ancient Greek  \u03b1\u03b7\u03b4\u03ae\u03c2 (a\u0113d\u1e17s) 'unpleasant' and Latin  aegypt\u012b 'Egyptian') \u2013 sometimes called the Egyptian mosquito, dengue mosquito, or yellow fever mosquito \u2013 is a mosquito that spreads diseases such as dengue fever, yellow fever, and chikungunya. The mosquito can be recognized by black and white markings on its legs and a marking in the form of a lyre on the upper surface of its thorax. The mosquito is native to north Africa, but is now a common invasive species that has spread to tropical, subtropical, and temperate regions throughout the world. Aedes aegypti is a 4-to-7-millimetre-long (5\u204432 to 35\u2044128 in), dark mosquito which can be recognized by white markings on its legs and a marking in the form of a lyre on the upper surface of its thorax. Females are larger than males. Microscopically females possess small palps tipped with silver or white scales, and their antennae have sparse short hairs, whereas those of males are feathery."}}, {"canonical_name": "D. Jo\u00e3o de Castro", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "d__jo\u00e3o_de_castro", "book_id": "coloquios_da_orta_1563", "name": "D. Jo\u00e3o de Castro", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["D. Jo\u00e3o de Castro"], "contexts": ["second viceroy who died in India", "author of travelogue"]}, {"entity_id": "d__joaode_castro", "book_id": "polyanthea_medicinal", "name": "D. Joaode Castro", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["D. Joaode Castro"], "contexts": ["person who experienced throat issues"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "D. Jo\u00e3o de Castro", "target_book": "polyanthea_medicinal", "target_name": "D. Joaode Castro", "similarity": 0.606}], "id": 4241, "stable_key": "clu_808e2f8b878e400d", "ground_truth": {"modern_name": "Jo\u00e3o de Castro", "confidence": "high", "type": "person", "birth_year": 1500, "death_year": 1548, "description": "Viceroy of Portuguese India, known for scientific and medical interests.", "wikidata_id": "Q1352529", "wikidata_description": "Portuguese explorer"}}, {"canonical_name": "abada", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "abada", "book_id": "coloquios_da_orta_1563", "name": "abada", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["Abada", "abada"], "contexts": ["animal sent as a gift", "name for rhinoceros"]}, {"entity_id": "abada", "book_id": "polyanthea_medicinal", "name": "Abada", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Abada"], "contexts": ["animal product, likely a type of animal"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "abada", "target_book": "polyanthea_medicinal", "target_name": "Abada", "similarity": 0.984}], "id": 4242, "stable_key": "clu_238711e18f3401cf-2", "ground_truth": {"modern_name": "Rhinoceros", "confidence": "high", "type": "animal", "wikidata_id": "Q134657", "wikidata_description": "genus of mammals", "wikipedia_url": "https://en.wikipedia.org/wiki/Rhinoceros%20%28genus%29", "wikipedia_extract": "A rhinoceros ( ry-NOSS-\u0259-r\u0259ss; from Ancient Greek  \u1fe5\u03b9\u03bd\u03cc\u03ba\u03b5\u03c1\u03c9\u03c2 (rhin\u00f3ker\u014ds) 'nose-horned'; from  \u1fe5\u03af\u03c2 (rhis) 'nose' and  \u03ba\u03ad\u03c1\u03b1\u03c2 (k\u00e9ras) 'horn'; pl.: rhinoceros or rhinoceroses), commonly abbreviated to rhino, is a member of any of the five extant species (or numerous extinct species) of odd-toed ungulates (perissodactyls) in the family Rhinocerotidae. It is the only living family in the superfamily Rhinocerotoidea (whose members are also sometimes called rhinoceroses). Two of the extant species are native to Africa, and three to South and Southeast Asia. Rhinoceroses are some of the largest remaining megafauna: all weigh over half a tonne in adulthood. They have a herbivorous diet, small brains 400\u2013600 g (14\u201321 oz) for mammals of their size, one or two horns, and a thick 1.5\u20135 cm (0.59\u20131.97 in), protective skin formed from layers of collagen positioned in a lattice structure. They generally eat leafy material, although their ability to ferment food in their hindgut allows them to subsist on more fibrous plant matter when necessary.", "note": "While 'abada' can refer to a rhinoceros in Portuguese, the context of being sent as a gift might also suggest other exotic animals. However, rhinoceros horn was a known medicinal substance."}}, {"canonical_name": "conde de Redondo", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "conde_de_redondo", "book_id": "coloquios_da_orta_1563", "name": "conde de Redondo", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["conde de Redondo"], "contexts": ["recipient of ode", "Viceroy of India"]}, {"entity_id": "senhor_conde_do_redondo", "book_id": "polyanthea_medicinal", "name": "Senhor Conde do Redondo", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Senhor Conde do Redondo"], "contexts": ["patron of remedy making"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "conde de Redondo", "target_book": "polyanthea_medicinal", "target_name": "Senhor Conde do Redondo", "similarity": 0.93}], "id": 4243, "stable_key": "clu_51ed3d27aec7a9db", "ground_truth": {"modern_name": "Count of Redondo", "confidence": "high", "type": "person", "description": "Noble patron associated with remedy making", "note": "Specific individual not readily identifiable without more context.", "wikidata_id": "Q9843838", "wikidata_description": "noble title in the Kingdom of Portugal", "wikipedia_extract": "Count of Redondo (Portuguese: Conde de Redondo) was a Portuguese title of nobility created by a royal decree, in 1481, by King Manuel I of Portugal, and granted to D. Vasco Coutinho, the son of Fernando Coutinho, Marshall of Portugal. Duarte de Castelo Branco, 7th Count of Redondo Francisco de Castelo Branco, 8th Count of Redondo Fern\u00e3o de Sousa de Castelo Branco Coutinho e Meneses, 10th Count of Redondo Tom\u00e9 de Sousa Coutinho Castelo Branco e Meneses, 11th Count of Redondo Fernando de Sousa Coutinho, 12th Count of Redondo Tom\u00e9 Xavier de Sousa Coutinho de Castelo Branco e Meneses, 13th Count of Redondo, 1st Marquis of Borba Fernando Maria de Sousa Coutinho, 14th Count of Redondo, 2nd Marquis of Borba Jos\u00e9 Lu\u00eds Gonzaga de Sousa Coutinho Castelo Branco e Meneses, 15th Count of Redondo Fernando Lu\u00eds de Sousa Coutinho Castelo Branco e Meneses, 16th Count of Redondo, 3rd Marquis of Borba Fernando Jos\u00e9 Lu\u00eds Burnay de Sousa Coutinho, 17th Count of Redondo (1883\u20131945); Ant\u00f3nio Lu\u00eds Carvalho de Sousa Coutinho, 18th Count of Redondo (1925-2007); 7th Marquis of Valen\u00e7a, 4th Marquis of Borba, 15th Count of Vimioso, 8th Count of Soure; Fernando Patr\u00edcio de Portugal de Sousa Coutinho, 19th Count of Redondo (1956), 8th Marquis of Valen\u00e7a, 6th Marquis of Borba, 16th Count of Vimioso, 9th Count of Soure? The family owned a number of properties throughout Portugal. Amongst the more well-known properties are the Palace of the Counts of Redondo in Lisbon, and the Quinta do Rel\u00f3gio in Sintra."}}, {"canonical_name": "pao", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "pao", "book_id": "coloquios_da_orta_1563", "name": "pao", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["pao"], "contexts": ["wood from a tree", "wood mentioned by Galen"]}, {"entity_id": "paopo", "book_id": "polyanthea_medicinal", "name": "paopo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["paopo"], "contexts": ["substance for mixing"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "pao", "target_book": "polyanthea_medicinal", "target_name": "paopo", "similarity": 0.895}], "id": 4244, "stable_key": "clu_f4d7047a334bf429-2", "ground_truth": {"modern_name": "Wood", "confidence": "high", "type": "mineral", "note": "While 'wood' is organic, the early modern texts refer to its material properties and sometimes fossilized forms, aligning with a substance classification. The context of 'bois fossile' further supports this.", "wikidata_id": "Q287", "wikidata_description": "fibrous material from trees or other plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Wood", "wikipedia_extract": "Wood is a structural tissue/material found as xylem in the stems and roots of trees and other woody plants. Being a natural material, it is characterized as an organic material \u2013 a natural composite of cellulosic fibers that are strong in tension and embedded in a matrix of lignin and hemicelluloses that resists compression. Wood is sometimes defined as only the secondary xylem in the stems of trees, or more broadly to include the same type of tissue elsewhere, such as in the roots of trees or shrubs. In a living tree, it performs a mechanical-support function, enabling woody plants to grow large or to stand up by themselves. It also conveys water and nutrients among the leaves, other growing tissues, and the roots. Wood may also refer to other plant materials with comparable properties, and to material engineered from wood, woodchips, or fibers.", "description": "Organic material from trees, used for various purposes including medicine."}}, {"canonical_name": "breu", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "breu", "book_id": "coloquios_da_orta_1563", "name": "breu", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["breu"], "contexts": ["substance for heating ships", "pitch, used for ships"]}, {"entity_id": "breu", "book_id": "polyanthea_medicinal", "name": "breu", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["breu"], "contexts": ["substance with a strong smell"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "breu", "target_book": "polyanthea_medicinal", "target_name": "breu", "similarity": 0.53}], "id": 4245, "stable_key": "clu_1f2593cf666dfa86-3", "ground_truth": {"modern_name": "pitch", "confidence": "high", "type": "substance", "description": "A thick, sticky, dark substance obtained from resin.", "note": "'pezze' context might refer to pieces of cloth or material.", "wikipedia_extract": "Pez (English: , German: [pe\u02d0ts]; stylised as PEZ, officially Pfefferminz, German for peppermint) is the brand name of an Austrian candy and associated manual candy dispensers. The candy is a pressed, dry, straight-edged, curved-corner block 15 mm (5\u20448 inch) long, 8 mm (5\u204416 inch) wide and 5 mm (3\u204416 inch) high, with each Pez dispenser holding 12 candy pieces. Pez was invented in Austria and later exported worldwide. The all-uppercase spelling of the logo echoes the trademark's style on the packaging and the dispensers, with the logo drawn in perspective and giving the appearance that the letters are built out of 44 brick-like Pez mints (14 bricks in the P and 15 in each of the E and Z). Despite the widespread recognition and popularity of the Pez dispenser, the company considers itself to be primarily a candy company, stating that \"[t]oday, billions of PEZ candies are consumed annually in the U.S.A. alone\". Pez dispensers are a part of popular culture in many nations, an example being \"Soul Candy\" in the Japanese manga series Bleach.", "wikidata_id": "Q840692", "wikidata_description": "mixture of aromatic organic compounds, black, tar-like, super viscous liquid"}}, {"canonical_name": "almagre", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "almagre", "book_id": "coloquios_da_orta_1563", "name": "almagre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["almagre", "alma"], "contexts": ["red earth used for comparison", "Arabic name for diamond"]}, {"entity_id": "almagra", "book_id": "polyanthea_medicinal", "name": "almagra", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["almagra"], "contexts": ["mixed with aypo juice to dry milk", "red ochre"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "almagre", "target_book": "polyanthea_medicinal", "target_name": "almagra", "similarity": 0.961}], "id": 4246, "stable_key": "clu_924ed609c374e399", "ground_truth": {"modern_name": "red ochre", "confidence": "high", "type": "mineral", "note": "A natural clay earth pigment, rich in iron oxide.", "wikidata_id": "Q16963274", "wikidata_description": "award for lifetime achievement by Aboriginal and Torres Strait Islander artist"}}, {"canonical_name": "coco das Maldivas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "coco_das_maldivas", "book_id": "coloquios_da_orta_1563", "name": "coco das Maldivas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["coco das Maldivas", "Coquo das Maldivas"], "contexts": ["marine production with antidotal properties", "topic of colloquy"]}, {"entity_id": "cocos_demaldiva", "book_id": "polyanthea_medicinal", "name": "Cocos deMaldiva", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Cocos deMaldiva", "cocos de Maldiva"], "contexts": ["fruit from Maldives", "coconuts of Maldives"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "coco das Maldivas", "target_book": "polyanthea_medicinal", "target_name": "Cocos deMaldiva", "similarity": 0.892}], "id": 4247, "stable_key": "clu_e0f565f1574f0bcd-2", "ground_truth": {"modern_name": "Coconut", "confidence": "high", "type": "plant", "family": "Arecaceae", "wikidata_id": "Q13187", "wikidata_description": "species of plant", "wikipedia_extract": "The coconut (Cocos nucifera) is a member of the palm family (Arecaceae) and the only living species of the genus Cocos. The term \"coconut\" (or the archaic \"cocoanut\") can denote the whole coconut palm tree or the large hard fruit. Originally native to Central Indo-Pacific, they are ubiquitous in coastal tropical regions. The coconut tree provides food, fuel, cosmetics, folk medicine and building materials. The inner flesh of the mature fruit forms a regular part of the diets of many people in the tropics and subtropics. Coconut endosperm contains a large quantity of a liquid, \"coconut water\".", "wikipedia_url": "https://en.wikipedia.org/wiki/Coconut", "linnaean": "Cocos nucifera Linnaeus"}}, {"canonical_name": "Ungr\u00eda", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "ungr\u00eda", "book_id": "coloquios_da_orta_1563", "name": "Ungr\u00eda", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Ungr\u00eda", "Hungria"], "contexts": ["European country"]}, {"entity_id": "ungria", "book_id": "polyanthea_medicinal", "name": "Ungria", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Ungria"], "contexts": ["used in water for application", "origin of Queen's water"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Ungr\u00eda", "target_book": "polyanthea_medicinal", "target_name": "Ungria", "similarity": 0.985}], "id": 4248, "stable_key": "clu_b63000866b1d1d2a", "ground_truth": {"modern_name": "Hungary", "confidence": "high", "type": "place", "country": "Hungary"}}, {"canonical_name": "cinabrio", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "cinabrio", "book_id": "coloquios_da_orta_1563", "name": "cinabrio", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["cinabrio"], "contexts": ["cinnabar, source of vermilion", "mineral substance, cinnabar"]}, {"entity_id": "cinabro", "book_id": "ricettario_fiorentino_1597", "name": "cinabro", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["cinabro"], "contexts": ["mineral, color comparison for sandaracha", "coloring substance, mercury sulfide"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "cinabrio", "target_book": "ricettario_fiorentino_1597", "target_name": "cinabro", "similarity": 0.902}], "id": 4249, "stable_key": "clu_cadd2d341116b4b8", "ground_truth": {"modern_name": "Cinnabar", "confidence": "high", "type": "mineral", "note": "Cinnabar is mercury sulfide, used as a source of vermilion."}}, {"canonical_name": "p\u00f3lvora", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "p\u00f3lvora", "book_id": "coloquios_da_orta_1563", "name": "p\u00f3lvora", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["p\u00f3lvora"], "contexts": ["gunpowder", "explosive substance used in warfare"]}, {"entity_id": "polvora", "book_id": "polyanthea_medicinal", "name": "polvora", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["polvora"], "contexts": ["powdered substance", "explosive substance"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "p\u00f3lvora", "target_book": "polyanthea_medicinal", "target_name": "polvora", "similarity": 0.777}], "id": 4250, "stable_key": "clu_b3cc1648577c715f", "ground_truth": {"wikipedia_extract": "P\u00f3lvora (born July 19, 1979) is the ring name of a Mexican Luchador Enmascarado, or masked professional wrestler best known for his work in the Mexican professional wrestling promotion Consejo Mundial de Lucha Libre (CMLL). P\u00f3lvora's real name is not a matter of public record, as is often the case with masked wrestlers in Mexico where their private lives are kept a secret from the wrestling fans. His name is the Spanish term for Gunpowder. P\u00f3lvora's brother is also a professional wrestler, under the ring name Inquisidor. P\u00f3lvora made his professional wrestling debut in 2000, mainly teaming with his brother Vaquero on the Mexican independent circuit By 2005 both P\u00f3lvora and Vaquero began working for Consejo Mundial de Lucha Libre (CMLL), mainly on the promotions minor shows or in the opening match of their big shows from Arena M\u00e9xico. On June 22, 2008 P\u00f3lvora and Vaquero participated in a tournament for the vacant CMLL Arena Coliseo Tag Team Championship, but lost in the opening round to Mictl\u00e1n and Fabian el Gitano."}}, {"canonical_name": "reino", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "reino", "book_id": "coloquios_da_orta_1563", "name": "reino", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["reino", "Reino"], "contexts": ["kingdom whose ships were loaded", "destination for drugs"]}, {"entity_id": "regno", "book_id": "ricettario_fiorentino_1597", "name": "Regno", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Regno"], "contexts": ["the Kingdom", "origin of yellow earth"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "reino", "target_book": "ricettario_fiorentino_1597", "target_name": "Regno", "similarity": 0.939}], "id": 4251, "stable_key": "clu_247a9aead24f3078", "ground_truth": {"modern_name": "kingdom", "confidence": "high", "type": "place", "description": "A territory ruled by a king or queen.", "note": "Includes references to specific kingdoms and generic 'kingdom' as a political entity.", "wikipedia_extract": "The United Kingdom is a country located off the north-western coast of continental Europe. It comprises England, Scotland, Wales and Northern Ireland. With a total area of approximately 244,376 square kilometres (94,354 sq mi), the UK occupies the major part of the British Isles archipelago and includes the island of Great Britain, the north-eastern one-sixth of the island of Ireland and many smaller surrounding islands. It is the world's 7th largest island country. The mainland areas lie between latitudes 49\u00b0N and 59\u00b0N (the Shetland Islands reach to nearly 61\u00b0N), and longitudes 8\u00b0W to 2\u00b0E. The Royal Observatory, Greenwich, in south-east London, is the defining point of the Prime Meridian."}}, {"canonical_name": "Dom Fernando", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "dom_fernando", "book_id": "coloquios_da_orta_1563", "name": "Dom Fernando", "category": "PERSON", "subcategory": "PATRON", "count": 2, "variants": ["Dom Fernando"], "contexts": ["king of Naples", "nickname for King Ferdinand II"]}, {"entity_id": "dom_fernando", "book_id": "polyanthea_medicinal", "name": "Dom Fernando", "category": "PERSON", "subcategory": "PATRON", "count": 2, "variants": ["Dom Fernando", "Fernando"], "contexts": ["Regedor mentioned in an anecdote", "Cardinal, brother of Cosme de Medicis"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Dom Fernando", "target_book": "polyanthea_medicinal", "target_name": "Dom Fernando", "similarity": 1.0}], "id": 4252, "stable_key": "clu_fd041cd2b8b04193", "ground_truth": {"modern_name": "Ferdinand I, Holy Roman Emperor", "confidence": "high", "type": "person", "birth_year": 1503, "death_year": 1564, "description": "King of Bohemia and Hungary, later Holy Roman Emperor.", "note": "The text refers to 'Dom Fernando' as King of Naples, which historically could refer to several rulers. Given the 16th-century context (coloquios_da_orta_1563), Ferdinand I of Habsburg (who was King of Hungary) is the most likely figure, especially as the anecdote involves a 'Regedor'.", "wikidata_id": "Q150611", "wikidata_description": "Holy Roman Emperor of the Habsburg dynasty and king of Bohemia, Croatia and Hungary (1503\u20131564)"}}, {"canonical_name": "claradeovo", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "clara_de_ovo", "book_id": "coloquios_da_orta_1563", "name": "clara de ovo", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["clara de ovo"], "contexts": ["mixed with falcon plaster ingredients"]}, {"entity_id": "claradeovo", "book_id": "polyanthea_medicinal", "name": "claradeovo", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["claradeovo", "clara deovo fre\u017fca"], "contexts": ["egg white", "fresh egg white, animal product"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "clara de ovo", "target_book": "polyanthea_medicinal", "target_name": "claradeovo", "similarity": 0.81}], "id": 4253, "stable_key": "clu_bd2505d4c78bf6a5", "ground_truth": {"modern_name": "egg white", "confidence": "high", "type": "substance", "note": "Direct translation of the Portuguese terms and context of medical preparations confirm this is egg white.", "wikidata_id": "Q796758", "wikidata_description": "clear liquid contained within an egg", "wikipedia_url": "https://en.wikipedia.org/wiki/Egg%20white"}}, {"canonical_name": "boy", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "boy", "book_id": "coloquios_da_orta_1563", "name": "boy", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["boy"], "contexts": ["blood of a boy mixed in medicine"]}, {"entity_id": "boy", "book_id": "polyanthea_medicinal", "name": "boy", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["boy"], "contexts": ["source of gall bladder stone", "animal product used for water"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "boy", "target_book": "polyanthea_medicinal", "target_name": "boy", "similarity": 1.0}], "id": 4254, "stable_key": "clu_50b3b5aaf4dc3307", "ground_truth": {"modern_name": "Ox", "confidence": "high", "type": "animal", "linnaean": "Bos taurus", "family": "Bovidae", "description": "Animal whose gall bladder stone and blood were used in medicine.", "note": "'Boy' in this context refers to an ox or bull, not a human child, especially when referring to 'fel de boy' (ox gall) or animal products.", "wikipedia_extract": "Cattle (Bos taurus) are large, domesticated, bovid ungulates widely kept as livestock. They are prominent modern members of the subfamily Bovinae and the most widespread species of the genus Bos. Mature female cattle are called cows and mature males are called bulls. Taurine cattle are widely distributed across Europe and temperate areas of Asia, the Americas, and Australia. Zebus are found mainly in India and tropical areas of Asia, America, and Australia. Sanga cattle are found primarily in sub-Saharan Africa."}}, {"canonical_name": "cheyro\u017fo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "cheirosa", "book_id": "coloquios_da_orta_1563", "name": "cheirosa", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["cheirosa"], "contexts": ["quality of a substance"]}, {"entity_id": "cheyro\u017fo", "book_id": "polyanthea_medicinal", "name": "cheyro\u017fo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["cheyro\u017fo", "cheyros"], "contexts": ["fragrant", "smell of roses"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "cheirosa", "target_book": "polyanthea_medicinal", "target_name": "cheyro\u017fo", "similarity": 0.959}], "id": 4255, "stable_key": "clu_f4cec96bd730926b", "ground_truth": {"modern_name": "Scent", "confidence": "high", "type": "concept", "description": "A distinctive smell, especially a pleasant one.", "note": "Refers to smell or odor, and adjectives describing it, used to assess quality or describe something.", "wikipedia_extract": "An odor (American English) or odour (Commonwealth English; see spelling differences) is a smell or a scent caused by one or more volatilized chemical compounds generally found in low concentrations that humans and many animals can perceive via their olfactory system. While smell can refer to pleasant and unpleasant odors, the terms scent, aroma, and fragrance are usually reserved for pleasant-smelling odors and are frequently used in the food and cosmetic industry to describe floral scents or to refer to perfumes. The perception of odors, or sense of smell, is mediated by the olfactory nerve. The olfactory receptor (OR) cells are neurons present in the olfactory epithelium, which is a small patch of tissue at the back of the nasal cavity. There are millions of olfactory receptor neurons that act as sensory signaling cells. Each neuron has cilia in direct contact with the air."}}, {"canonical_name": "Sabao", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "sab\u00e3o", "book_id": "coloquios_da_orta_1563", "name": "sab\u00e3o", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["sab\u00e3o"], "contexts": ["substance sold with opium and bangue"]}, {"entity_id": "sabao", "book_id": "polyanthea_medicinal", "name": "Sabao", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["Sabao", "sabao", "saba\u00f5"], "contexts": ["ingredient in caustic", "soap"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "sab\u00e3o", "target_book": "polyanthea_medicinal", "target_name": "Sabao", "similarity": 0.531}], "id": 4256, "stable_key": "clu_55c6d464f37e6db6-2", "ground_truth": {"modern_name": "Grape must reduction", "confidence": "high", "type": "concept", "description": "Concentrated and reduced grape juice, used as a sweetener and in preparations.", "note": "The term 'sap' in Darwin refers to plant fluid, distinct from the grape must reduction. 'Sapos' in Monardes refers to toads, a different category. 'Sab\u00e3o' (soap) and 'saponis' (of soap) are related to saponification but contextually distinct.", "wikipedia_extract": "Balsamic vinegar (Italian: aceto balsamico) is a dark, concentrated, pungent, intensely flavoured vinegar made wholly or partially from grape must, which is freshly crushed grape juice with all the skins, seeds, and stems. The Italian word balsamico (from Latin balsamum, from Greek \u03b2\u03ac\u03bb\u03c3\u03b1\u03bc\u03bf\u03bd, b\u00e1lsamon) means 'balsam-like' in the sense of \"restorative\" or \"curative\"; cf. English 'balm'. Ultimately from Ancient Hebrew-Phoenician \u05d1\u05e9\u05c2\u05dd (b\u0101\u015b\u0101m or besem, IPA [ba\u02d0\u02c8\u026ca\u02d0m]), the name means 'perfume or spice', with the consonant sequence of the letter '\u03bb' and '\u03c3' deriving from Ancient Greek to pronounce the \u05e9\u05c2 (\u015b) sound, sounding back then as [\u026c]. The term balsamico in \"balsamic vinegar\" originates from the Latin word balsamum and the Greek word \u03b2\u03ac\u03bb\u03c3\u03b1\u03bc\u03bf\u03bd, both conveying the idea of something \"restorative\" or \"curative\". The practice of cooking grapes can be traced back to ancient Roman times, where it was valued both as a medicinal remedy and a sweetener or condiment in cooking."}}, {"canonical_name": "Rocha", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "roch_h\u00e1", "book_id": "coloquios_da_orta_1563", "name": "roch h\u00e1", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["roch h\u00e1"], "contexts": ["chess piece, tiger"]}, {"entity_id": "rocha", "book_id": "polyanthea_medicinal", "name": "Rocha", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Rocha"], "contexts": ["approver", "signer of official documents"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "roch h\u00e1", "target_book": "polyanthea_medicinal", "target_name": "Rocha", "similarity": 0.881}], "id": 4257, "stable_key": "clu_48756322284cfae8", "ground_truth": {"modern_name": "Rocha", "confidence": "low", "type": "person", "description": "Approver or reviewer of texts.", "note": "The context 'chess piece, tiger' and 'approver' is highly ambiguous. 'Rocha' could be a surname, a place, or even a metaphorical reference. Without further context, a definitive identification is impossible.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Estado da India", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "estado_da_\u00edndia", "book_id": "coloquios_da_orta_1563", "name": "Estado da \u00edndia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Estado da \u00edndia"], "contexts": ["territory mentioned in a document"]}, {"entity_id": "estado_da_india", "book_id": "polyanthea_medicinal", "name": "Estado da India", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Estado da India"], "contexts": ["State of India", "Portuguese territory in India"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Estado da \u00edndia", "target_book": "polyanthea_medicinal", "target_name": "Estado da India", "similarity": 0.765}], "id": 4258, "stable_key": "clu_f8b2465e4149f46f", "ground_truth": {"modern_name": "Portuguese India", "confidence": "high", "type": "place", "country": "India", "wikidata_id": "Q323904", "wikidata_description": "Portuguese colonies in South Asia (1505\u20131961)"}}, {"canonical_name": "Rainha", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "rainha", "book_id": "coloquios_da_orta_1563", "name": "rainha", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["rainha"], "contexts": ["queen, our lady"]}, {"entity_id": "rainha", "book_id": "polyanthea_medicinal", "name": "Rainha", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["Rainha"], "contexts": ["associated with caldas", "Queen, lady-in-waiting's mistress"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "rainha", "target_book": "polyanthea_medicinal", "target_name": "Rainha", "similarity": 0.664}], "id": 4259, "stable_key": "clu_cd06d10b0e6e6839", "ground_truth": {"modern_name": "Queen", "confidence": "high", "type": "person", "description": "A female monarch, often a patron of arts and sciences.", "note": "This refers to a generic queen, not a specific individual.", "wikidata_id": "Q116", "wikidata_description": "person at the head of a monarchy"}}, {"canonical_name": "Areteus", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "aret\u00e9o", "book_id": "coloquios_da_orta_1563", "name": "Aret\u00e9o", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Aret\u00e9o"], "contexts": ["ancient physician who studied cholera"]}, {"entity_id": "areteus", "book_id": "polyanthea_medicinal", "name": "Areteus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Areteus"], "contexts": ["ancient medical authority", "author on Cachexia"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Aret\u00e9o", "target_book": "polyanthea_medicinal", "target_name": "Areteus", "similarity": 0.919}], "id": 4260, "stable_key": "clu_c7fb94ee34ab15c9", "ground_truth": {"modern_name": "Aretaeus of Cappadocia", "confidence": "high", "type": "person", "description": "Ancient Greek physician known for his work on diseases.", "wikidata_id": "Q505931", "wikidata_description": "2nd century Greek physician"}}, {"canonical_name": "Antidotarios", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "antidotorum", "book_id": "coloquios_da_orta_1563", "name": "Antidotorum", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Antidotorum"], "contexts": ["title of a book"]}, {"entity_id": "antidotarios", "book_id": "polyanthea_medicinal", "name": "Antidotarios", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["Antidotarios", "Antidotarium"], "contexts": ["books of remedies", "collection of antidotes"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Antidotorum", "target_book": "polyanthea_medicinal", "target_name": "Antidotarios", "similarity": 0.881}], "id": 4261, "stable_key": "clu_9a75527b8fa6fd80", "ground_truth": {"modern_name": "Antidotary", "confidence": "high", "type": "text"}}, {"canonical_name": "manjar branco", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "manjar_branco", "book_id": "coloquios_da_orta_1563", "name": "manjar branco", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["manjar branco"], "contexts": ["food used for comparison of texture and taste"]}, {"entity_id": "manjar_branco", "book_id": "polyanthea_medicinal", "name": "manjar branco", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["manjar branco"], "contexts": ["white dish, a food preparation", "food for the sick"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "manjar branco", "target_book": "polyanthea_medicinal", "target_name": "manjar branco", "similarity": 1.0}], "id": 4262, "stable_key": "clu_eddb65856ea303de", "ground_truth": {"wikipedia_extract": "Manjar branco is a pure white Brazilian coconut pudding similar to blancmange. It is identical to the Puerto Rican tembleque. In Brazil manjar branco is made in a ring (Savarin) mold and is served with a sauce made of pitted prunes poached in port wine. Commercial mixes for manjar branco and tembleque are available in Brazil, the U.S., and in other Latin American countries. In order to improve the texture and taste, unsweetened shredded coconut may be added to the mix. Manjar branco in Portugal usually refers to blancmange, but the manjar branco of Coimbra is an unusual dessert made from chicken breast, milk, sugar, rice flour, orange zest, and salt."}}, {"canonical_name": "braccio", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "bra\u00e7a", "book_id": "coloquios_da_orta_1563", "name": "bra\u00e7a", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["bra\u00e7a"], "contexts": ["unit of measurement"]}, {"entity_id": "braccio", "book_id": "ricettario_fiorentino_1597", "name": "braccio", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["braccio", "braccia"], "contexts": ["unit of measurement for height", "unit of measurement"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "bra\u00e7a", "target_book": "ricettario_fiorentino_1597", "target_name": "braccio", "similarity": 0.919}], "id": 4263, "stable_key": "clu_0e6f69ea91eb1818", "ground_truth": {"modern_name": "Braccio (unit of length)", "confidence": "high", "type": "object", "note": "An Italian unit of length, approximately 0.63 meters."}}, {"canonical_name": "Soria", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "soria", "book_id": "coloquios_da_orta_1563", "name": "Soria", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Soria"], "contexts": ["country where Muse are from"]}, {"entity_id": "soria", "book_id": "ricettario_fiorentino_1597", "name": "Soria", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Soria"], "contexts": ["country of origin for oriental balm", "country where Cippero root originates"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Soria", "target_book": "ricettario_fiorentino_1597", "target_name": "Soria", "similarity": 1.0}], "id": 4264, "stable_key": "clu_af5d5692906229a6", "ground_truth": {"modern_name": "Soria", "confidence": "high", "type": "place", "country": "Spain", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Mulerus", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "muuer", "book_id": "coloquios_da_orta_1563", "name": "MuUer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["MuUer"], "contexts": ["editor of Geogr. Gr. Minores"]}, {"entity_id": "mulerus", "book_id": "polyanthea_medicinal", "name": "Mulerus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Mulerus", "Mulero"], "contexts": ["author of Miracula Chymica", "author of chemical miracles"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "MuUer", "target_book": "polyanthea_medicinal", "target_name": "Mulerus", "similarity": 0.869}], "id": 4265, "stable_key": "clu_15a9389bd4dc2ff9", "ground_truth": {"modern_name": "Mulerus", "confidence": "high", "type": "person", "description": "Editor and author in medicine and science."}}, {"canonical_name": "Libra", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "libra", "book_id": "coloquios_da_orta_1563", "name": "libra", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["libra"], "contexts": ["unit of weight"]}, {"entity_id": "libra", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Libra", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["Libra"], "contexts": ["constellation where conjunction took place", "constellation with planetary conjunction"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "libra", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Libra", "similarity": 0.71}], "id": 4266, "stable_key": "clu_a05771fd2662a747", "ground_truth": {"modern_name": "Libra", "confidence": "high", "type": "concept", "note": "Refers to both a unit of weight (pound) and a constellation."}}, {"canonical_name": "Universidade de Coimbra", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "universidade_de_coimbra", "book_id": "coloquios_da_orta_1563", "name": "Universidade de Coimbra", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Universidade de Coimbra"], "contexts": ["university in Portugal"]}, {"entity_id": "universidade_de_coimbra", "book_id": "polyanthea_medicinal", "name": "Universidade de Coimbra", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Universidade de Coimbra"], "contexts": ["university where Antonio Mendes taught", "institution where Padre Luis taught"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Universidade de Coimbra", "target_book": "polyanthea_medicinal", "target_name": "Universidade de Coimbra", "similarity": 1.0}], "id": 4267, "stable_key": "clu_0f5cc4eb8ef2ff31", "ground_truth": {"wikipedia_extract": "The University of Coimbra (UC) is a public research university in Coimbra, Portugal. Officially chartered by King Denis on March 1, 1290, and recognised by Pope Nicholas IV on August 9, 1290, it is the oldest university in Portugal and one of the world's oldest in continuous operations, having begun operations in Lisbon before moving permanently to Coimbra in 1537. It had an influential role in the development of higher education in the Portuguese-speaking countries, and in their history. Due to its historic influence, architecture, unique culture and traditions, it was declared in 2013 a World Heritage Site by UNESCO. The university is organized into eight faculties, granting bachelor's (licenciatura), master's (mestrado) and doctorate (doutoramento) degrees in nearly all major fields. It lends its name to the Coimbra Group of European research universities founded in 1985, of which it was a founding member."}}, {"canonical_name": "abelha", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "abelha", "book_id": "coloquios_da_orta_1563", "name": "abelha", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["abelha"], "contexts": ["bee that makes honey"]}, {"entity_id": "abelha", "book_id": "polyanthea_medicinal", "name": "abelha", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["abelha", "abelhas"], "contexts": ["bee, source of venom", "bee sting treatment"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "abelha", "target_book": "polyanthea_medicinal", "target_name": "abelha", "similarity": 1.0}], "id": 4268, "stable_key": "clu_d4fc73cfc12a6626", "ground_truth": {"wikipedia_extract": "Jo\u00e3o Batista Lopes Abelha (born 3 January 1958), simply known as Abelha, is a Brazilian former professional footballer and manager who played as a goalkeeper. Abelha began his career at Ferrovi\u00e1ria, a club in the city where he was born. In 1984 he transferred to Flamengo where he won the Guanabara Cup. He arrived at S\u00e3o Paulo to compete for a position with Barbirotto, but was unsuccessful, and then played for S\u00e3o Bento, Inter de Limeira, Botafogo de Ribeir\u00e3o Preto, ABC, Honda Hamamatsu and S\u00e3o Bento, his last club in 1992. Living in Japan, he began his career as a goalkeeper coach in 1994, assisting Paulo Roberto Falc\u00e3o on the Japan national football team. He managed S\u00e3o Bento for the first time in 1997, and in 1999 he was Nelsinho Baptista's assistant at Colo-Colo."}}, {"canonical_name": "Ca\u017ftelhanos", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "ckistelhanos", "book_id": "coloquios_da_orta_1563", "name": "Ckistelhanos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Ckistelhanos"], "contexts": ["people from Castile"]}, {"entity_id": "ca\u017ftelhanos", "book_id": "polyanthea_medicinal", "name": "Ca\u017ftelhanos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Ca\u017ftelhanos", "Caftelhanos"], "contexts": ["Spaniards", "Castilians, referring to Spanish people"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Ckistelhanos", "target_book": "polyanthea_medicinal", "target_name": "Ca\u017ftelhanos", "similarity": 0.896}], "id": 4269, "stable_key": "clu_377e775f1501d94e", "ground_truth": {"modern_name": "Castilians", "confidence": "high", "type": "concept", "note": "Refers to people from the historical region of Castile.", "wikidata_id": "Q217196", "wikidata_description": "former country"}}, {"canonical_name": "bolotas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "bolota", "book_id": "coloquios_da_orta_1563", "name": "bolota", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["bolota"], "contexts": ["acorn-like fruit"]}, {"entity_id": "bolotas", "book_id": "polyanthea_medicinal", "name": "bolotas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["bolotas", "bolotas fec.cas"], "contexts": ["acorns used in broth", "acorn shells used in preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "bolota", "target_book": "polyanthea_medicinal", "target_name": "bolotas", "similarity": 0.936}], "id": 4270, "stable_key": "clu_b38caea014d6cee2", "ground_truth": {"modern_name": "Acorns", "confidence": "medium", "type": "plant", "family": "Fagaceae", "description": "Fruits of oak trees, used in preparations and as food.", "note": "The mention of 'bolla' (myrrh) and 'bolandas' (items from Africa) suggests potential semantic drift or confusion in the historical texts.", "wikipedia_extract": "This glossary of botanical terms is a list of definitions of terms and concepts relevant to botany and plants in general. Terms of plant morphology are included here as well as at the more specific Glossary of plant morphology and Glossary of leaf morphology. For other related terms, see Glossary of phytopathology, Glossary of lichen terms, and List of Latin and Greek words commonly used in systematic names. Surface of an organ facing away from the organ's axis, e.g. the lower surface of a lateral organ such as a leaf or petal. Contrast adaxial. To abandon development of a structure or organ."}}, {"canonical_name": "agulha", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "agulha", "book_id": "coloquios_da_orta_1563", "name": "agulha", "category": "OBJECT", "subcategory": "TOOL", "count": 1, "variants": ["agulha"], "contexts": ["needle used in poisoning test"]}, {"entity_id": "agulha", "book_id": "polyanthea_medicinal", "name": "agulha", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["agulha"], "contexts": ["surgical instrument for eye treatment", "surgical needle"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "agulha", "target_book": "polyanthea_medicinal", "target_name": "agulha", "similarity": 0.677}], "id": 4271, "stable_key": "clu_7200c00343efb8f4-3", "ground_truth": {"modern_name": "Needle", "confidence": "high", "type": "object", "wikidata_id": "Q102004561", "wikidata_description": "stout, sharp-pointed piece of metal, wood, or other material, or sharp projection on an object", "note": "Contexts suggest both general needles and surgical needles."}}, {"canonical_name": "talparias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "taiparias", "book_id": "coloquios_da_orta_1563", "name": "taiparias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["taiparias"], "contexts": ["disease prevalent in the new land"]}, {"entity_id": "talparias", "book_id": "polyanthea_medicinal", "name": "talparias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["talparias"], "contexts": ["ulcers, dissolved by mercury", "tumors or swellings"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "taiparias", "target_book": "polyanthea_medicinal", "target_name": "talparias", "similarity": 0.9}], "id": 4272, "stable_key": "clu_e46c17123aad44b4-4", "ground_truth": {"modern_name": "Syphilis", "confidence": "high", "type": "disease", "modern_term": "Syphilis", "note": "The term 'mala Franc^os' or 'mal Frances' was a common historical name for syphilis, meaning 'French evil'.", "wikidata_id": "Q18966640", "wikidata_description": "human disease", "description": "A sexually transmitted infection caused by the bacterium Treponema pallidum.", "wikipedia_extract": "Syphilis () is a sexually transmitted infection caused by the bacterium Treponema pallidum subspecies pallidum. The signs and symptoms depend on the stage it presents: primary, secondary, latent or tertiary. The primary stage classically presents with a single chancre (a firm, painless, non-itchy skin ulceration usually between 1 cm and 2 cm in diameter), though there may be multiple sores. In secondary syphilis, a diffuse rash occurs, which frequently involves the palms of the hands and soles of the feet. There may also be sores in the mouth or vagina. Latent syphilis has no symptoms and can last years."}}, {"canonical_name": "leycen\u00e7os", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "leicen\u00e7os", "book_id": "coloquios_da_orta_1563", "name": "leicen\u00e7os", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["leicen\u00e7os"], "contexts": ["skin eruptions, possibly erysipelas"]}, {"entity_id": "leycen\u00e7os", "book_id": "polyanthea_medicinal", "name": "leycen\u00e7os", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["leycen\u00e7os"], "contexts": ["skin eruption", "ulcers, a consequence of thick milk"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "leicen\u00e7os", "target_book": "polyanthea_medicinal", "target_name": "leycen\u00e7os", "similarity": 0.953}], "id": 4273, "stable_key": "clu_df580017dfcd6d74-2", "ground_truth": {"modern_name": "Erysipelas", "confidence": "high", "type": "disease", "description": "A bacterial skin infection, often on the face or legs.", "note": "Includes 'Erofulas' which is likely a misspelling or related condition.", "wikipedia_extract": "Erysipelas () is a relatively common bacterial infection of the superficial layer of the skin (upper dermis), extending to the superficial lymphatic vessels within the skin, characterized by a raised, well-defined, tender, bright-red rash, typically on the face or legs, but which can occur anywhere on the skin. It is a form of cellulitis and is potentially serious. Erysipelas is usually caused by the bacterium Streptococcus pyogenes, also known as group A, \u03b2-hemolytic streptococci, which enters the body through a break in the skin, such as a scratch or an insect bite. It is more superficial than cellulitis and is typically more raised and demarcated. The term comes from the Greek \u1f10\u03c1\u03c5\u03c3\u03af\u03c0\u03b5\u03bb\u03b1\u03c2 (erys\u00edpelas), meaning red skin. In animals, erysipelas is a disease caused by infection with the bacterium Erysipelothrix rhusiopathiae.", "modern_term": "erysipelas", "wikidata_id": "Q207092", "wikidata_description": "human disease"}}, {"canonical_name": "cumo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "\u00e7umo", "book_id": "coloquios_da_orta_1563", "name": "\u00e7umo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["\u00e7umo"], "contexts": ["meaning of tabaxir"]}, {"entity_id": "cumo", "book_id": "polyanthea_medicinal", "name": "cumo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["cumo", "cumbos", "cumos"], "contexts": ["incense for rubbing", "plant part, mixed with milk"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "\u00e7umo", "target_book": "polyanthea_medicinal", "target_name": "cumo", "similarity": 0.806}], "id": 4274, "stable_key": "clu_29ad4367dd9df421", "ground_truth": {"modern_name": "bamboo sap", "confidence": "medium", "type": "plant", "note": "The context 'tabaxir' strongly suggests tabasheer, a siliceous deposit from bamboo, which is botanically a plant product.", "wikidata_id": "Q1642659", "wikidata_description": "substance obtained from babmoo"}}, {"canonical_name": "parteyras", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "parteiras", "book_id": "coloquios_da_orta_1563", "name": "parteiras", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["parteiras"], "contexts": ["midwives"]}, {"entity_id": "parteyras", "book_id": "polyanthea_medicinal", "name": "parteyras", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 3, "variants": ["parteyras", "Parteiras", "Parteyras"], "contexts": ["midwives, causing head issues in newborns", "medical practitioner"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "parteiras", "target_book": "polyanthea_medicinal", "target_name": "parteyras", "similarity": 0.919}], "id": 4275, "stable_key": "clu_07f25d0376594a87", "ground_truth": {"modern_name": "midwife", "confidence": "high", "type": "person", "description": "Practitioner assisting in childbirth, sometimes causing newborn head issues.", "wikidata_id": "Q185196", "wikidata_description": "medical professional who practices obstetrics as a health science", "wikipedia_url": "https://en.wikipedia.org/wiki/Midwife", "wikipedia_extract": "A midwife (pl.: midwives) is a health professional who cares for mothers and newborns around childbirth, a specialisation known as midwifery. The education and training for a midwife concentrates extensively on the care of women throughout their lifespan; concentrating on being experts in what is normal and identifying conditions that need further evaluation. In most countries, midwives are recognised as skilled healthcare providers. Midwives are trained to recognise variations from the normal progress of labour and understand how to deal with deviations from normal. They may intervene in high risk situations such as breech births, twin births, using non-invasive techniques. For complications related to pregnancy and birth that are beyond the midwife's scope of practice, including surgical and instrumental deliveries, they refer their patients to physicians or surgeons."}}, {"canonical_name": "Arabbi", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "arabbi", "book_id": "ricettario_fiorentino_1597", "name": "Arabbi", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Arabbi", "A rabi", "Arab"], "contexts": ["called amber carabe", "Arabs"]}, {"entity_id": "arab", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Arab", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Arab"], "contexts": ["person from Arab world"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Arabbi", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Arab", "similarity": 0.94}], "id": 4276, "stable_key": "clu_4acc2f54a4ccf012", "ground_truth": {"modern_name": "Arab scholars", "confidence": "high", "type": "person", "description": "Scholars from the Arab world, known for astronomy and medicine."}}, {"canonical_name": "fale", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "fale", "book_id": "ricettario_fiorentino_1597", "name": "fale", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["fale"], "contexts": ["fossil substance from metal veins", "mineral prepared by art"]}, {"entity_id": "fale", "book_id": "polyanthea_medicinal", "name": "fale", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["fale"], "contexts": ["salt"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "fale", "target_book": "polyanthea_medicinal", "target_name": "fale", "similarity": 1.0}], "id": 4277, "stable_key": "clu_3b76b970cb7a27ff", "ground_truth": {"modern_name": "calamine", "confidence": "high", "type": "mineral", "note": "The description 'fossil substance from metal veins' and the association with 'salt' in early modern texts often refers to calamine, a zinc ore.", "wikidata_id": "Q408008", "wikidata_description": "sorosilicate mineral"}}, {"canonical_name": "Vifco di quercia", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "vifco_di_quercia", "book_id": "ricettario_fiorentino_1597", "name": "Vifco di quercia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Vifco di quercia", "Vifco quercino"], "contexts": ["oak mistletoe", "oak mistletoe used in preparations"]}, {"entity_id": "vi\u017fco_quercino", "book_id": "polyanthea_medicinal", "name": "vi\u017fco quercino", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["vi\u017fco quercino", "Vi\u017fco quercedo"], "contexts": ["mistletoe, used in remedies", "powder ingredient"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Vifco di quercia", "target_book": "polyanthea_medicinal", "target_name": "vi\u017fco quercino", "similarity": 0.914}], "id": 4278, "stable_key": "clu_ce7e0cdc36b852c0-2", "ground_truth": {"modern_name": "Mistletoe", "confidence": "high", "type": "plant", "linnaean": "Viscum album Linnaeus", "family": "Santalaceae", "wikidata_id": "Q144940", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Viscum%20album", "wikipedia_extract": "Mistletoe is the common name for obligate hemiparasitic plants in the order Santalales. They are attached to their host tree or shrub by a structure called the haustorium, through which they extract water and nutrients from the host plant. There are hundreds of species which mostly live in tropical regions. The name mistletoe originally referred to the species Viscum album (European mistletoe, of the family Santalaceae in the order Santalales); it is the only species native to the British Isles and much of Europe. A related species with red fruits, rather than white, Viscum cruciatum, occurs in Southwest Spain and Southern Portugal, as well as in Morocco in North Africa and in southern Africa. There is also a wide variety of species in Australia.", "note": "The primary referent is likely Viscum album, with 'quercino' indicating association with oak."}}, {"canonical_name": "olio d'antimonio", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "olio_d'antimonio", "book_id": "ricettario_fiorentino_1597", "name": "olio d'antimonio", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["olio d'antimonio"], "contexts": ["oil of antimony, a distilled product", "distilled oil from antimony"]}, {"entity_id": "oleode_antimonio", "book_id": "polyanthea_medicinal", "name": "oleode Antimonio", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["oleode Antimonio"], "contexts": ["mixed with mercury oil"]}, {"entity_id": "antimony_oil", "book_id": "polyanthea_medicinal", "name": "Antimony oil", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Antimony oil"], "contexts": ["oil that is very beneficial"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "olio d'antimonio", "target_book": "polyanthea_medicinal", "target_name": "oleode Antimonio", "similarity": 0.903}, {"source_book": "ricettario_fiorentino_1597", "source_name": "olio d'antimonio", "target_book": "polyanthea_medicinal", "target_name": "Antimony oil", "similarity": 0.912}], "id": 4279, "stable_key": "clu_157c6ffe199c26c2-4", "ground_truth": {"modern_name": "Antimony", "confidence": "high", "type": "mineral", "wikidata_id": "Q1099", "wikidata_description": "chemical element with symbol Sb and atomic number of 51", "wikipedia_extract": "Antimony potassium tartrate, also known as potassium antimonyl tartrate, potassium antimontarterate, or tartar emetic, has the formula K2Sb2(C4H2O6)2. The compound has long been known as a powerful emetic, and was used in the treatment of schistosomiasis and leishmaniasis. It is used as a resolving agent. It typically is obtained as a hydrate. The first treatment application against trypanosomiasis was tested in 1906, and the compound's use to treat other tropical diseases was researched. The treatment of leishmania with antimony potassium tartrate started in 1913.", "wikipedia_url": "https://en.wikipedia.org/wiki/Antimony", "note": "This likely refers to a distilled preparation containing antimony compounds.", "description": "A metallic element, often prepared and used in alchemical and medicinal contexts."}}, {"canonical_name": "acqua rola", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "acqua_rola", "book_id": "ricettario_fiorentino_1597", "name": "acqua rola", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Acqua Rola", "acqua rola"], "contexts": ["rose water", "rose water, a common solvent and ingredient"]}, {"entity_id": "aguarolada", "book_id": "polyanthea_medicinal", "name": "aguaRolada", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["aguaRolada", "agua rolada"], "contexts": ["rolled water used in a preparation", "rolled water"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "acqua rola", "target_book": "polyanthea_medicinal", "target_name": "aguaRolada", "similarity": 0.925}], "id": 4280, "stable_key": "clu_92b7459405e05123", "ground_truth": {"modern_name": "rose water", "confidence": "high", "type": "chemical", "note": "While 'rolled water' is mentioned, the primary and more common referent in early modern texts is rose water.", "wikidata_id": "Q900450", "wikidata_description": "flavoured water made by steeping rose petals in water", "wikipedia_url": "https://en.wikipedia.org/wiki/Rose_water", "wikipedia_extract": "A rose is either a woody perennial flowering plant of the genus Rosa (), in the family Rosaceae (), or the flower it bears. There are over three hundred species and tens of thousands of cultivars. They form a group of plants that can be erect shrubs, climbing, or trailing, with stems that are often armed with sharp prickles. Their flowers vary in size and shape and are usually large and showy, in colours ranging from white through pinks, reds, oranges and yellows. Most species are native to Asia, with smaller numbers native to Europe, North America, and Northwest Africa. Species, cultivars and hybrids are all widely grown for their beauty and often are fragrant."}}, {"canonical_name": "Vermiculare", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "vermiculare", "book_id": "ricettario_fiorentino_1597", "name": "Vermiculare", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Vermiculare"], "contexts": ["ingredient in an ointment", "plant mentioned in a list"]}, {"entity_id": "vermicular", "book_id": "polyanthea_medicinal", "name": "Vermicular", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Vermicular"], "contexts": ["herb superior to others for scorbutic affections", "herb, medicinal plant"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Vermiculare", "target_book": "polyanthea_medicinal", "target_name": "Vermicular", "similarity": 0.989}], "id": 4281, "stable_key": "clu_dfadf14de73a4173", "ground_truth": {"modern_name": "Vervain", "confidence": "high", "type": "plant", "linnaean": "Verbena officinalis", "family": "Verbenaceae", "note": "The term 'vermiculare' likely refers to plants in the genus Verbena, commonly known as vervain. While the specific species isn't definitively stated, Verbena officinalis is the most common medicinal vervain."}}, {"canonical_name": "figa", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "ficine", "book_id": "ricettario_fiorentino_1597", "name": "ficine", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["ficine"], "contexts": ["a plant's pulp"]}, {"entity_id": "figa", "book_id": "polyanthea_medicinal", "name": "figa", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["figa"], "contexts": ["liver", "liver ailments cured by well water"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "ficine", "target_book": "polyanthea_medicinal", "target_name": "figa", "similarity": 0.899}], "id": 4282, "stable_key": "clu_71a9475b5dd92989", "ground_truth": {"modern_name": "Fig", "confidence": "high", "type": "plant", "linnaean": "Ficus carica", "family": "Moraceae", "note": "'Figa' and 'ficine' clearly refer to the fig fruit and tree, Ficus carica.", "wikidata_id": "Q1759071", "wikidata_description": "genus of insects"}}, {"canonical_name": "Pastilhas", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "pastilli", "book_id": "ricettario_fiorentino_1597", "name": "pastilli", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["pastilli"], "contexts": ["Latin term for trochisci"]}, {"entity_id": "pastilhas", "book_id": "polyanthea_medicinal", "name": "Pastilhas", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["Pastilhas", "Pastilhas contra camaras", "pastilhas"], "contexts": ["form of medicine", "medicinal preparations discussed"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "pastilli", "target_book": "polyanthea_medicinal", "target_name": "Pastilhas", "similarity": 0.952}], "id": 4283, "stable_key": "clu_8ab77c33268a3438", "ground_truth": {"modern_name": "Pills", "confidence": "high", "type": "substance", "description": "Dosage forms of medicine, often compounded.", "wikipedia_extract": "The combined oral contraceptive pill (COCP), often referred to as the birth control pill or colloquially as \"the pill\", is a type of birth control that is designed to be taken orally by women. It is the oral form of combined hormonal contraception. The pill contains two important hormones: a progestin (a synthetic form of the hormone progestogen/progesterone) and estrogen (usually ethinylestradiol or 17\u03b2 estradiol). When taken correctly, it alters the menstrual cycle to eliminate ovulation and prevent pregnancy. Combined oral contraceptive pills were first approved for contraceptive use in the United States in 1960, and remain a very popular form of birth control. They are used by more than 100 million women worldwide  including about 9 million women in the United States."}}, {"canonical_name": "feffo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "fefta", "book_id": "ricettario_fiorentino_1597", "name": "Fefta", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Fefta"], "contexts": ["medical preparation name"]}, {"entity_id": "feffo", "book_id": "polyanthea_medicinal", "name": "feffo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["feffo"], "contexts": ["rectum", "affected by water"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Fefta", "target_book": "polyanthea_medicinal", "target_name": "feffo", "similarity": 0.915}], "id": 4284, "stable_key": "clu_b297925a42c8f144", "ground_truth": {"modern_name": "Scrofula", "confidence": "high", "type": "disease", "modern_term": "Scrofula", "note": "'Fefta' and 'feffo' are likely archaic or variant spellings/pronunciations of 'scrofula', a disease that historically had various names and manifestations. Contexts referencing preparations and body parts align with this interpretation.", "wikidata_id": "Q4678337", "wikidata_description": "human medical condition"}}, {"canonical_name": "plumbea", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "plumbea", "book_id": "polyanthea_medicinal", "name": "plumbea", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["plumbea"], "contexts": ["lead, to be avoided in vessels", "lead, used in vessels"]}, {"entity_id": "plumbago", "book_id": "connexion_physical_sciences_somerville_1858", "name": "plumbago", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["plumbago"], "contexts": ["reflected light shows elliptical polarization", "renders non-conductor conducting for metal"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "plumbea", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "plumbago", "similarity": 0.903}], "id": 4285, "stable_key": "clu_ea95925f58d26a3a-3", "ground_truth": {"modern_name": "Lead", "confidence": "high", "type": "mineral", "note": "Includes 'Carbonate of lead' which is a specific compound of lead, but the primary referent is the element lead.", "wikidata_id": "Q708", "wikidata_description": "chemical element with symbol Pb and atomic number 82", "wikipedia_url": "https://en.wikipedia.org/wiki/Lead", "wikipedia_extract": "Lead ( ) is a chemical element with the symbol Pb (from the Latin plumbum) and atomic number 82. It is a heavy metal, denser than most common materials. Lead is soft, malleable, and has a relatively low melting point. When freshly cut or melted, it appears shiny silvery with a bluish tint, but tarnishes to dull gray on exposure to air. Lead has the highest atomic number of any stable element, and three of its isotopes are endpoints of major nuclear decay chains of heavier elements. Lead is a relatively unreactive post-transition metal.", "description": "A heavy, soft, bluish-grey metal, known for its toxicity."}}, {"canonical_name": "rectificar", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "rectificar", "book_id": "polyanthea_medicinal", "name": "rectificar", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["rectificar", "Rectificar"], "contexts": ["purifying by redistillation", "chemical process of preparing medicines"]}, {"entity_id": "correction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "correction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["correction"], "contexts": ["adjustment to a value", "adjustment to data"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "rectificar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "correction", "similarity": 0.896}], "id": 4286, "stable_key": "clu_1bf2a0033b3b99b6", "ground_truth": {"modern_name": "Rectification", "confidence": "high", "type": "concept", "note": "The term 'rectificar' in the context of scientific texts, especially with 'purifying by redistillation' and 'correction' related to values, points to the chemical process of rectification."}}, {"canonical_name": "Lerius", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "lelius", "book_id": "polyanthea_medicinal", "name": "Lelius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Lelius"], "contexts": ["author of conf. med."]}, {"entity_id": "lerius", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Lerius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Lerius"], "contexts": ["early navigator", "early navigator comparing sea to meadows"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Lelius", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Lerius", "similarity": 0.883}], "id": 4287, "stable_key": "clu_e53b535868cedaf0", "ground_truth": {"modern_name": "Gerardus Mercator", "confidence": "medium", "type": "person", "birth_year": 1512, "death_year": 1594, "description": "Flemish cartographer and geographer, influential in mapmaking.", "note": "The name 'Lerius' or 'Lelius' is likely a misspelling or archaic variant of 'Mercator'. The context of 'early navigator' and 'author of conf. med.' (likely referring to 'confessio' or 'configurationes', relevant to cartography) supports this identification, though direct textual evidence is missing."}}, {"canonical_name": "terrestrial gravitation", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "terrestrial_gravitation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "terrestrial gravitation", "category": "CONCEPT", "subcategory": "THEORY", "count": 3, "variants": ["terrestrial gravitation", "Terrestrial Gravitation"], "contexts": ["force of gravity on Earth", "gravitation on Earth"]}, {"entity_id": "terrestrial_gravitation", "book_id": "first_principles_spencer_1862", "name": "terrestrial gravitation", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["terrestrial gravitation"], "contexts": ["force pulling objects to Earth"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "terrestrial gravitation", "target_book": "first_principles_spencer_1862", "target_name": "terrestrial gravitation", "similarity": 1.0}], "id": 4288, "stable_key": "clu_4af905639d656f13-3", "ground_truth": {"modern_name": "Gravity", "confidence": "high", "type": "concept", "wikidata_id": "Q11412", "wikidata_description": "fundamental interaction affecting all matter", "wikipedia_url": "https://en.wikipedia.org/wiki/Gravity", "note": "Early modern texts often referred to 'terrestrial attraction' or 'earth's attraction' when discussing gravity, particularly in relation to Isaac Newton's work.", "wikipedia_extract": "In physics, gravity (from Latin  gravitas 'weight'), also known as gravitation or a gravitational interaction, is a fundamental interaction, which may be described as the force that draws material objects towards each other. The gravitational attraction between clouds of primordial hydrogen and clumps of dark matter in the early universe caused the hydrogen gas to coalesce, eventually condensing and fusing to form stars. At larger scales this resulted in galaxies and clusters, so gravity is a primary driver for the large-scale structures in the universe. Gravity has an infinite range, although its effects become weaker as objects get farther away. Gravity is described by the general theory of relativity, proposed by Albert Einstein in 1915, which describes gravity in terms of the curvature of spacetime, caused by the uneven distribution of mass. The most extreme example of this curvature of spacetime is a black hole, from which nothing\u2014not even light\u2014can escape once past the black hole's event horizon."}}, {"canonical_name": "celestial body", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "celestial_body", "book_id": "connexion_physical_sciences_somerville_1858", "name": "celestial body", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["celestial body"], "contexts": ["object in outer space", "object in space"]}, {"entity_id": "heavenly_bodies", "book_id": "first_principles_spencer_1862", "name": "heavenly bodies", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["heavenly bodies"], "contexts": ["celestial objects like planets and stars"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "celestial body", "target_book": "first_principles_spencer_1862", "target_name": "heavenly bodies", "similarity": 0.956}], "id": 4289, "stable_key": "clu_ab4d7470088509bb", "ground_truth": {"modern_name": "celestial body", "confidence": "high", "type": "object", "note": "Contexts like 'object in outer space' and 'celestial objects like planets and stars' clearly indicate astronomical entities.", "wikidata_id": "Q1519541", "wikidata_description": "natural object visible in the sky to the naked eye"}}, {"canonical_name": "vacuo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "vacuo", "book_id": "connexion_physical_sciences_somerville_1858", "name": "vacuo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["vacuo"], "contexts": ["space devoid of matter", "state of being empty of matter"]}, {"entity_id": "in_vacuo", "book_id": "first_principles_spencer_1862", "name": "in vacuo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["in vacuo"], "contexts": ["in a vacuum, absence of matter"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "vacuo", "target_book": "first_principles_spencer_1862", "target_name": "in vacuo", "similarity": 0.898}], "id": 4290, "stable_key": "clu_cc066da863533a5f", "ground_truth": {"modern_name": "vacuum", "confidence": "high", "type": "concept", "note": "The term 'va\u0301sos' appears to be a corruption or variant of 'vasos' (vessels), which in a medical context could refer to blood vessels or lymphatics, or it might be a misreading of 'vacuo' or a related concept. However, the dominant context for 'vacuo' and 'in vacuo' points strongly to the physical concept of a vacuum.", "wikidata_id": "Q101674", "wikidata_description": "device that uses air to suck up dirt and other substances", "wikipedia_url": "https://en.wikipedia.org/wiki/Vacuum%20cleaner", "wikipedia_extract": "A vacuum (pl.: vacuums or vacua) is  space devoid of matter. The word is derived from the Latin adjective vacuus (neuter vacuum) meaning \"vacant\" or \"void\". An approximation to such vacuum is a region with a gaseous pressure much less than atmospheric pressure. Physicists often discuss ideal test results that would occur in a perfect vacuum, which they sometimes simply call \"vacuum\" or free space, and use the term partial vacuum to refer to an actual imperfect vacuum as one might have in a laboratory or in space. In engineering and applied physics on the other hand, vacuum refers to any space in which the pressure is considerably lower than atmospheric pressure. The Latin term in vacuo is used to describe an object that is surrounded by a vacuum."}}, {"canonical_name": "conducting wire", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "conducting_wire", "book_id": "connexion_physical_sciences_somerville_1858", "name": "conducting wire", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["conducting wire"], "contexts": ["connects tin foil for electrical union", "wire that conducts electricity"]}, {"entity_id": "conducting_wire", "book_id": "first_principles_spencer_1862", "name": "conducting wire", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["conducting wire"], "contexts": ["witnesses transformation of electricity to heat"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "conducting wire", "target_book": "first_principles_spencer_1862", "target_name": "conducting wire", "similarity": 1.0}], "id": 4291, "stable_key": "clu_8a67b2a4d45865cf", "ground_truth": {"modern_name": "Electrical conductor", "confidence": "high", "type": "object", "wikidata_id": "Q124291", "wikidata_description": "material that allows the flow of electrical current"}}, {"canonical_name": "Hercules", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "hercules", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Hercules", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["Hercules"], "contexts": ["point towards which stars tend", "constellation containing a nebula"]}, {"entity_id": "hercules", "book_id": "first_principles_spencer_1862", "name": "Hercules", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Hercules"], "contexts": ["constellation in the night sky"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Hercules", "target_book": "first_principles_spencer_1862", "target_name": "Hercules", "similarity": 1.0}], "id": 4292, "stable_key": "clu_d96cb6710d745aab", "ground_truth": {"modern_name": "Hercules", "confidence": "high", "type": "animal", "note": "The context 'constellation in the night sky' strongly points to the astronomical constellation, which is often personified, rather than a specific animal. However, given the 'animal' type specified, it's likely referencing the mythological hero whose constellation bears his name. If the intent was the constellation itself, the type would be 'concept' or 'place'."}}, {"canonical_name": "Mr. Babbage", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "mr__babbage", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mr. Babbage", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Mr. Babbage"], "contexts": ["views on volcanic action and internal heat", "scientist discussing earth crust contraction and heat radiation"]}, {"entity_id": "babbage", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Babbage", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Babbage"], "contexts": ["mentioned in footnotes"]}, {"entity_id": "babbage", "book_id": "first_principles_spencer_1862", "name": "Babbage", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Babbage"], "contexts": ["drew attention to segregation of units"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Mr. Babbage", "target_book": "first_principles_spencer_1862", "target_name": "Babbage", "similarity": 0.877}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Babbage", "target_book": "first_principles_spencer_1862", "target_name": "Babbage", "similarity": 1.0}], "id": 4293, "stable_key": "clu_0ac5acf7d43f8314", "ground_truth": {"modern_name": "Charles Babbage", "confidence": "high", "type": "person", "birth_year": 1791, "death_year": 1871, "description": "English mathematician and inventor, pioneer of computing.", "wikidata_id": "Q46633", "wikidata_description": "English mathematician, philosopher, and engineer (1791\u20131871)"}}, {"canonical_name": "Mechanical engines", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "mechanical_engines", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mechanical engines", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["mechanical engines", "Mechanical engines"], "contexts": ["engines that produce mechanical force", "incapable of generating force"]}, {"entity_id": "engines", "book_id": "connexion_physical_sciences_somerville_1858", "name": "engines", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["engines"], "contexts": ["devices incapable of generating force"]}, {"entity_id": "engines", "book_id": "first_principles_spencer_1862", "name": "engines", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count