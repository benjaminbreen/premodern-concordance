{"modern_name": "State of nature", "confidence": "high", "type": "concept", "wikidata_id": "Q1130390", "wikidata_description": "hypothetical conditions of human life before society"}}, {"canonical_name": "Alexandrie", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "alexandrie", "book_id": "epoques_nature_buffon_1778", "name": "Alexandrie", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Alexandrie"], "contexts": ["location of an ancient school"]}, {"entity_id": "alexandrie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Alexandrie", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Alexandrie", "Alexandria"], "contexts": ["city", "city vis-\u00e0-vis Portsmouth"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Alexandrie", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Alexandrie", "similarity": 1.0}], "id": 4485, "stable_key": "clu_be5afd24917fd425", "ground_truth": {"modern_name": "Alexandria", "confidence": "high", "type": "place", "country": "Egypt", "wikidata_id": "Q87", "wikidata_description": "port city on the Mediterranean coast of Egypt", "wikipedia_url": "https://en.wikipedia.org/wiki/Alexandria"}}, {"canonical_name": "savoir", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "savoir", "book_id": "epoques_nature_buffon_1778", "name": "savoir", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["savoir"], "contexts": ["knowledge and understanding"]}, {"entity_id": "wissen", "book_id": "principles_of_psychology_james_1890", "name": "wissen", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["wissen"], "contexts": ["German word for knowledge"]}, {"entity_id": "savoir", "book_id": "principles_of_psychology_james_1890", "name": "savoir", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["savoir"], "contexts": ["French word for knowledge"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "savoir", "target_book": "principles_of_psychology_james_1890", "target_name": "wissen", "similarity": 0.951}, {"source_book": "epoques_nature_buffon_1778", "source_name": "savoir", "target_book": "principles_of_psychology_james_1890", "target_name": "savoir", "similarity": 1.0}], "id": 4486, "stable_key": "clu_a6dfc67d01cf84f7", "ground_truth": {"modern_name": "knowledge", "confidence": "high", "type": "concept", "note": "Includes French 'savoir' and German 'wissen', both meaning knowledge.", "wikidata_id": "Q192060", "wikidata_description": "process of creating, sharing, using and managing the knowledge and information of an organization", "wikipedia_url": "https://en.wikipedia.org/wiki/Knowledge%20management"}}, {"canonical_name": "quadruped", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "quadrup\u00e8des", "book_id": "epoques_nature_buffon_1778", "name": "quadrup\u00e8des", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["quadrup\u00e8des"], "contexts": ["four-legged animals"]}, {"entity_id": "quadruped", "book_id": "origin_of_species_darwin_1859", "name": "quadruped", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["quadruped"], "contexts": ["animal with hair", "four-legged animal in selection examples"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "quadrup\u00e8des", "target_book": "origin_of_species_darwin_1859", "target_name": "quadruped", "similarity": 0.93}], "id": 4487, "stable_key": "clu_34db8e89aa55a8b0", "ground_truth": {"modern_name": "quadruped", "confidence": "high", "type": "animal", "wikidata_id": "Q777371", "wikidata_description": "animal whose locomotion uses four limbs (quadrupedalism)"}}, {"canonical_name": "Otahiti", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "otahiti", "book_id": "epoques_nature_buffon_1778", "name": "Otahiti", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Otahiti"], "contexts": ["island where chicken and pig were found"]}, {"entity_id": "otahiti", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Otahiti", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Otahiti"], "contexts": ["island in the Pacific", "place where sugarcane cultivation became common"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Otahiti", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Otahiti", "similarity": 0.824}], "id": 4488, "stable_key": "clu_487ec86b36356bfe", "ground_truth": {"modern_name": "Tahiti", "confidence": "high", "type": "place", "country": "France", "wikidata_id": "Q5230686", "wikidata_description": "genus of plants"}}, {"canonical_name": "Retentive", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "retentive", "book_id": "english_physician_1652", "name": "Retentive", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Retentive", "Retentive Faculty"], "contexts": ["bodily virtue", "bodily function of retention"]}, {"entity_id": "retentiva", "book_id": "historia_medicinal_monardes_1574", "name": "Retentiva", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Retentiva"], "contexts": ["retentive virtue"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Retentive", "target_book": "historia_medicinal_monardes_1574", "target_name": "Retentiva", "similarity": 0.92}], "id": 4489, "stable_key": "clu_977d1dfa59c7c2f6", "ground_truth": {"modern_name": "Retentive", "confidence": "high", "type": "concept", "description": "A bodily virtue or function related to the power of retention.", "wikipedia_extract": "Anal retentiveness is a personality trait that is characterized by excessive concern with details. The concept originated in Freudian psychoanalytic theory, where one aspect of the anal stage of psychosexual development is pleasure in the retention of feces. Fixation in this stage can potentially result in a personality marked by frugality, obstinacy and orderliness. Despite its psychoanalytic roots and the literal meaning of the words, in common usage the term generally refers merely to certain kinds of obsessive behaviour. In Freudian psychology, the anal stage is said to follow the oral stage of infant or early-childhood development, and occurs from around the age of eighteen months to three years old. The infant's attention moves from oral stimulation to anal stimulation, usually synchronous with learning to control its excretory functions.", "wikipedia_url": "https://en.wikipedia.org/wiki/Anal_retentiveness"}}, {"canonical_name": "Bacchus", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "bacchus", "book_id": "english_physician_1652", "name": "Bacchus", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Bacchus", "Bacchinus"], "contexts": ["god to whom vine was dedicated", "commends Chamomel syrup"]}, {"entity_id": "bacchus", "book_id": "polyanthea_medicinal", "name": "Bacchus", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Bacchus"], "contexts": ["god of wine"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Bacchus", "target_book": "polyanthea_medicinal", "target_name": "Bacchus", "similarity": 1.0}], "id": 4490, "stable_key": "clu_c3ef53cb5a789b01", "ground_truth": {"modern_name": "Bacchus", "confidence": "high", "type": "person", "description": "Roman god of wine, fertility, and revelry.", "note": "This refers to the mythological deity, not a historical person.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Bacchus", "wikipedia_extract": ""}}, {"canonical_name": "Kidney Bean", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "kidney_bean", "book_id": "english_physician_1652", "name": "Kidney Bean", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Kidney Bean", "Kidneywort"], "contexts": ["alternative name for French Bean", "plant with thick, flat, round leaves"]}, {"entity_id": "kidney-bean", "book_id": "origin_of_species_darwin_1859", "name": "kidney-bean", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["kidney-bean"], "contexts": ["plant used as an example in acclimatisation debate"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Kidney Bean", "target_book": "origin_of_species_darwin_1859", "target_name": "kidney-bean", "similarity": 0.832}], "id": 4491, "stable_key": "clu_86a4d5776b8ba0e7", "ground_truth": {"modern_name": "Kidney Bean", "confidence": "high", "type": "plant", "linnaean": "Phaseolus vulgaris", "family": "Fabaceae", "wikidata_id": "Q1077410", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Lablab", "wikipedia_extract": "Lablab purpureus is a species of bean in the family Fabaceae. It is native to sub-Saharan Africa and it is cultivated throughout the tropics for food. English language common names include hyacinth bean, lablab-bean bonavist bean/pea, dolichos bean, seim or sem bean, lablab bean, Egyptian kidney bean, Indian bean, bataw and Australian pea. Lablab is a monotypic genus. The name lablab which is also capitalized as its genus name is given by Robert Sweet from the previous name of Dolichos lablab by Carl Linnaeus, its epithet comes from Arabic: \u0644\u064e\u0628\u0652\u0644\u064e\u0627\u0628, romanized: labl\u0101b. According to the British biologist and taxonomist Bernard Verdcourt, there are two cultivated subspecies of Lablab purpureus (L.) Sweet: Lablab purpureus subsp."}}, {"canonical_name": "Noli me Tangere", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "noli_me_tangere", "book_id": "english_physician_1652", "name": "Noli me Tangere", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["Noli me Tangere", "Nolime tangere"], "contexts": ["aggressive spreading ulcer", "disease name with reference"]}, {"entity_id": "noli_me_tangere", "book_id": "polyanthea_medicinal", "name": "Noli me tangere", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Noli me tangere"], "contexts": ["a type of cancerous sore"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Noli me Tangere", "target_book": "polyanthea_medicinal", "target_name": "Noli me tangere", "similarity": 0.949}], "id": 4492, "stable_key": "clu_d19290315bcacdea", "ground_truth": {"wikipedia_extract": "Noli me tangere ('touch me not') is the Latin version of a phrase spoken, according to John 20:17, by Jesus to Mary Magdalene when she recognized him after His resurrection. The original Koine Greek phrase is \u039c\u03ae \u03bc\u03bf\u03c5 \u1f05\u03c0\u03c4\u03bf\u03c5 (m\u1e17 mou h\u00e1ptou). The biblical scene has been portrayed in numerous works of Christian art from Late Antiquity to the present. The phrase has also been used in literature, and later in a variation by military units since the late 18th century. According to Maurice Zundel (1897\u20131975), in asking Mary Magdalene not to touch him, Jesus indicates that once the resurrection is accomplished, the link between human beings and his person must no longer be physical, but must be a bond of heart to heart. \"He must establish this gap, she must understand that the only possible way is faith, that the hands can not reach the person and that it is from within, from within only, that the we can approach Him.\" Likewise, later, when Thomas reached out to touch the wounds of Jesus, Christ declares: \"blessed are those who have not seen and yet have believed\" [John 20:29] because \"He knows it is useless.\" Christians of Western Catholic tradition, namely Catholics, Lutherans, and Anglicans, would say this statement is to be received in relation to the Ascension of Jesus. That is, because he had not yet ascended to the right hand of God, it was more of a \"not yet\" statement rather than a \"never\" cling to me."}}, {"canonical_name": "White Roses", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "white_roses", "book_id": "english_physician_1652", "name": "White Roses", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["White Roses", "white Flowers"], "contexts": ["type of rose with cooling properties", "of a sort of Vipers Buglofs"]}, {"entity_id": "flores_blancas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "flores blancas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["flores blancas"], "contexts": ["white flowers"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "White Roses", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "flores blancas", "similarity": 0.907}], "id": 4493, "stable_key": "clu_6bcaa60d5ae669ce", "ground_truth": {"modern_name": "white rose", "confidence": "high", "type": "plant", "linnaean": "Rosa alba", "family": "Rosaceae", "note": "While 'flores blancas' is generic, 'White Roses' in an English medical context from 1652 strongly suggests Rosa alba.", "wikidata_id": "Q237726", "wikidata_description": "Italian portrait painter and pastellist (1675\u20131757)", "wikipedia_url": "https://en.wikipedia.org/wiki/Rosalba%20Carriera"}}, {"canonical_name": "Dukes", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "dukes", "book_id": "english_physician_1652", "name": "Dukes", "category": "PERSON", "subcategory": "PATRON", "count": 2, "variants": ["Dukes"], "contexts": ["supported Mathiolus' work", "supported the art"]}, {"entity_id": "dukes", "book_id": "first_principles_spencer_1862", "name": "dukes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["dukes"], "contexts": ["high-ranking noble title"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Dukes", "target_book": "first_principles_spencer_1862", "target_name": "dukes", "similarity": 0.748}], "id": 4494, "stable_key": "clu_f9b23bd3d23c0dce", "ground_truth": {"modern_name": "Dukes", "confidence": "high", "type": "concept", "note": "Refers to the noble title 'Duke', not a specific person.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "English Tongue", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "english_tongue", "book_id": "english_physician_1652", "name": "English Tongue", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["English Tongue"], "contexts": ["written so much of it in the English Tongue", "language used for writing"]}, {"entity_id": "english_language", "book_id": "first_principles_spencer_1862", "name": "English language", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["English language"], "contexts": ["specific language with complex subdivisions"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "English Tongue", "target_book": "first_principles_spencer_1862", "target_name": "English language", "similarity": 0.915}], "id": 4495, "stable_key": "clu_d4bd7a2fb10d4994-2", "ground_truth": {"modern_name": "English language", "confidence": "high", "type": "concept", "note": "Refers to the English language as a linguistic and cultural entity.", "wikidata_id": "Q1860", "wikidata_description": "West Germanic language", "wikipedia_url": "https://en.wikipedia.org/wiki/English%20language", "wikipedia_extract": "English is a West Germanic language that emerged in early medieval England and has since become a global lingua franca. The namesake of the language is the Angles, one of the Germanic peoples who migrated to Britain after the end of Roman rule. English is the most spoken language in the world, primarily due to the global influences of the former British Empire (succeeded by the Commonwealth of Nations) and the United States. It is the most widely learned second language in the world, with more second-language speakers than native speakers. However, English is only the third-most spoken native language, after Mandarin Chinese and Spanish. English is either the official language, or one of the official languages, in 57 sovereign states and 30 dependent territories, making it the most geographically widespread language in the world."}}, {"canonical_name": "Skins", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "skins", "book_id": "english_physician_1652", "name": "Skins", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Skins"], "contexts": ["eye condition", "used to wrap affected area after Pepperwort"]}, {"entity_id": "pelle", "book_id": "coloquios_da_orta_1563", "name": "pelle", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["pelle"], "contexts": ["skin of the rhinoceros"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Skins", "target_book": "coloquios_da_orta_1563", "target_name": "pelle", "similarity": 0.909}], "id": 4496, "stable_key": "clu_09153cd528a240de", "ground_truth": {"modern_name": "skin", "confidence": "low", "type": "animal", "note": "The context 'eye condition' for 'Skins' and 'pelle' (skin) in Portuguese suggests a potential misinterpretation or a specific medical term related to the eye that is not immediately obvious. 'Rhino skin' is also mentioned, but the primary association is ambiguous.", "wikidata_id": "Q272206", "wikidata_description": "family of reptiles (Reptilia)", "wikipedia_url": "https://en.wikipedia.org/wiki/Skink"}}, {"canonical_name": "Fits", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "fits", "book_id": "english_physician_1652", "name": "Fits", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["Fits"], "contexts": ["episodes of illness", "of agues, altered by remedy"]}, {"entity_id": "fits", "book_id": "first_principles_spencer_1862", "name": "fits", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["fits"], "contexts": ["sudden episodes of symptoms"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Fits", "target_book": "first_principles_spencer_1862", "target_name": "fits", "similarity": 0.969}], "id": 4497, "stable_key": "clu_b0675fac2a12f7b8-4", "ground_truth": {"modern_name": "Convulsions", "confidence": "high", "type": "disease", "modern_term": "Convulsions", "wikidata_id": "Q6279182", "wikidata_description": "disease, disturbance of cortical function due to a sudden, abnormal, exin cells.", "wikipedia_url": "https://en.wikipedia.org/wiki/Seizure", "note": "In early modern medical texts, 'fits' was a common term for sudden episodes of illness, often referring to seizures.", "wikipedia_extract": "A seizure is a sudden disruption of brain activity caused by excessive, synchronized neuronal firing that results in changes in behavior. This neurological condition is common, affecting approximately 50 million individuals around the world. Depending on the regions of the brain involved, seizures can lead to changes in movement, sensation, behavior, awareness, or consciousness. Symptoms vary widely. Some seizures involve subtle changes, such as brief lapses in attention or awareness (as seen in absence seizures), while others cause generalized convulsions with loss of consciousness (tonic\u2013clonic seizures). Most seizures last less than two minutes and are followed by a postictal period of confusion, fatigue, or other symptoms.", "description": "A medical condition characterized by sudden, involuntary muscle contractions."}}, {"canonical_name": "Buds", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "buds", "book_id": "english_physician_1652", "name": "Buds", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Buds"], "contexts": ["part of the Bramble plant", "part of the Black Poplar tree"]}, {"entity_id": "buds", "book_id": "origin_of_species_darwin_1859", "name": "buds", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["buds"], "contexts": ["undeveloped plant shoots"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Buds", "target_book": "origin_of_species_darwin_1859", "target_name": "buds", "similarity": 0.915}], "id": 4498, "stable_key": "clu_2717b588cb23cab0", "ground_truth": {"modern_name": "Buds", "confidence": "high", "type": "plant", "note": "Buds are a universal plant structure, so the specific plant is not determinative of the general term.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Birds-Nest", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "birds-nest", "book_id": "english_physician_1652", "name": "Birds-Nest", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Birds-Nest"], "contexts": ["shape of flower cluster", "shape of the umbel"]}, {"entity_id": "nests_of_birds", "book_id": "origin_of_species_darwin_1859", "name": "nests of birds", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["nests of birds"], "contexts": ["structures built by birds"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Birds-Nest", "target_book": "origin_of_species_darwin_1859", "target_name": "nests of birds", "similarity": 0.914}], "id": 4499, "stable_key": "clu_9c75b2fd56d00a7d", "ground_truth": {"modern_name": "Bird's nest", "confidence": "high", "type": "object", "note": "Refers to actual nests built by birds or structures that resemble them.", "wikidata_id": "Q30056", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Daucus%20carota", "wikipedia_extract": "Daucus carota, whose common names include wild carrot, European wild carrot, bird's nest, bishop's lace, carrot flower, and Queen Anne's lace (North America), is a flowering plant in the family Apiaceae. It is native to temperate regions of the Old World with a number of regional subspecies, and is naturalised widely elsewhere. Carrots cultivated as a food crop are cultivars of the domesticated subspecies Daucus carota subsp. sativus. The wild carrot is a herbaceous, somewhat variable biennial plant that grows to 30\u2013100 cm (1\u20133 ft), rarely 120 cm (4 ft) tall, and is roughly hairy, with a stiff, solid stem. The leaves are tripinnate, finely divided and lacy, and overall triangular in shape."}}, {"canonical_name": "Hemp", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "hemp", "book_id": "english_physician_1652", "name": "Hemp", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Hemp"], "contexts": ["well-known plant for housewives", "plant with medicinal properties"]}, {"entity_id": "hemp", "book_id": "origin_of_species_darwin_1859", "name": "hemp", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["hemp"], "contexts": ["seed that germinated after bird digestion"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Hemp", "target_book": "origin_of_species_darwin_1859", "target_name": "hemp", "similarity": 0.989}], "id": 4500, "stable_key": "clu_ea28339d2a647a07", "ground_truth": {"modern_name": "Hemp", "confidence": "high", "type": "plant", "linnaean": "Cannabis sativa", "family": "Cannabaceae", "wikidata_id": "Q26726", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Cannabis%20sativa", "wikipedia_extract": "Cannabis sativa is an annual herbaceous flowering plant. The species was first classified by Carl Linnaeus in 1753. The specific epithet sativa means 'cultivated'. Indigenous to Eastern Asia, the plant is now of cosmopolitan distribution due to widespread cultivation. It has been cultivated throughout recorded history and used as a source of industrial fiber, seed oil, food, and medicine. It is also used as a recreational drug and for religious and spiritual purposes."}}, {"canonical_name": "yellow", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "yellow", "book_id": "english_physician_1652", "name": "yellow", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["yellow"], "contexts": ["comparison to another plant", "color descriptor"]}, {"entity_id": "yellowness", "book_id": "principles_of_psychology_james_1890", "name": "yellowness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["yellowness"], "contexts": ["quality of being yellow"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "yellow", "target_book": "principles_of_psychology_james_1890", "target_name": "yellowness", "similarity": 0.881}], "id": 4501, "stable_key": "clu_5e9283beaa9a7d5e-2", "ground_truth": {"modern_name": "Yellow", "confidence": "high", "type": "concept", "wikidata_id": "Q1148004", "wikidata_description": "mosquito species, a vector for diseases including yellow fever and Zika fever", "wikipedia_url": "https://en.wikipedia.org/wiki/Aedes%20aegypti", "note": "Refers to the color yellow, used metaphorically and literally for dyeing.", "wikipedia_extract": "Aedes aegypti (; US: ; from Ancient Greek  \u03b1\u03b7\u03b4\u03ae\u03c2 (a\u0113d\u1e17s) 'unpleasant' and Latin  aegypt\u012b 'Egyptian') \u2013 sometimes called the Egyptian mosquito, dengue mosquito, or yellow fever mosquito \u2013 is a mosquito that spreads diseases such as dengue fever, yellow fever, and chikungunya. The mosquito can be recognized by black and white markings on its legs and a marking in the form of a lyre on the upper surface of its thorax. The mosquito is native to north Africa, but is now a common invasive species that has spread to tropical, subtropical, and temperate regions throughout the world. Aedes aegypti is a 4-to-7-millimetre-long (5\u204432 to 35\u2044128 in), dark mosquito which can be recognized by white markings on its legs and a marking in the form of a lyre on the upper surface of its thorax. Females are larger than males. Microscopically females possess small palps tipped with silver or white scales, and their antennae have sparse short hairs, whereas those of males are feathery."}}, {"canonical_name": "Pope", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pope", "book_id": "english_physician_1652", "name": "Pope", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Pope"], "contexts": ["mentioned in relation to St. Peter", "selfish and associated with Imps"]}, {"entity_id": "pope", "book_id": "principles_of_psychology_james_1890", "name": "Pope", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Pope"], "contexts": ["author of Martinus Scriblerus"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Pope", "target_book": "principles_of_psychology_james_1890", "target_name": "Pope", "similarity": 0.766}], "id": 4502, "stable_key": "clu_1e5a6ee3add1dc91-3", "ground_truth": {"modern_name": "Pope", "confidence": "high", "type": "person", "description": "Head of the Catholic Church, associated with folk remedies", "wikidata_id": "Q25382", "wikidata_description": "species of bird", "wikipedia_url": "https://en.wikipedia.org/wiki/Eurasian%20bullfinch", "note": "The term 'Pontifice' (and its variations) could refer to the Pope or be used metaphorically for a paternal figure. Context is key.", "wikipedia_extract": "The Eurasian bullfinch, common bullfinch or bullfinch (Pyrrhula pyrrhula) is a small passerine bird in the finch family, Fringillidae. In Anglophone Europe it is known simply as the bullfinch (English regional, Shropshire: plum bird), as it is the original bird to bear the name bullfinch. The Eurasian bullfinch was formally described in 1758 by Linnaeus in the 10th edition of his Systema Naturae under the binomial name Loxia pyrrhula. It is now placed in the genus Pyrrhula that was introduced in 1760 by the French zoologist Mathurin Jacques Brisson. The Latin word pyrrhula comes from the Greek \u03c0\u03c5\u03c1\u03c1\u03cc\u03c2 (a flame-coloured bird, from \u03c0\u03c5\u03c1\u03c1\u03cc\u03c2 'flame-coloured', from \u03c0\u03c5\u03c1 'fire': Pyrrha), a 'worm eating bird' that is mentioned by Aristotle. The Latin name pyrrhula for the Eurasian bullfinch had been used in 1555 by the Swiss naturalist Conrad Gessner in his Historiae animalium."}}, {"canonical_name": "Beef", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "beef", "book_id": "english_physician_1652", "name": "Beef", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Beef"], "contexts": ["used in a brine preparation", "meat used as a cooking reference"]}, {"entity_id": "beef", "book_id": "principles_of_psychology_james_1890", "name": "Beef", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Beef"], "contexts": ["meat from cattle"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Beef", "target_book": "principles_of_psychology_james_1890", "target_name": "Beef", "similarity": 0.809}], "id": 4503, "stable_key": "clu_af75f1d6049fe0e9-3", "ground_truth": {"modern_name": "Cattle", "confidence": "high", "type": "animal", "note": "The Spanish 'ganado' directly translates to 'livestock' or 'cattle' in this context.", "wikidata_id": "Q133733", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Cattleya", "wikipedia_extract": "Cattleya () is a genus of orchids from Costa Rica south to Argentina. The genus is abbreviated C in trade journals. Epiphytic or terrestrial orchids with cylindrical rhizome from which the fleshy noodle-like roots grow. Pseudobulbs can be conical, spindle-shaped or cylindrical; with upright growth; one or two leaves growing from the top of them. The leaves can be oblong, lanceolate or elliptical, somewhat fleshy, with smooth margin. The inflorescence is a terminal raceme with few or several flowers."}}, {"canonical_name": "wild Roses", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "wild_roses", "book_id": "english_physician_1652", "name": "wild Roses", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Wild Roses", "wild Roses"], "contexts": ["type of rose", "nature compared to manured roses"]}, {"entity_id": "wild_rose", "book_id": "origin_of_species_darwin_1859", "name": "wild rose", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["wild rose"], "contexts": ["species of rose"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "wild Roses", "target_book": "origin_of_species_darwin_1859", "target_name": "wild rose", "similarity": 0.935}], "id": 4504, "stable_key": "clu_10d5542c8118b879", "ground_truth": {"modern_name": "Wild rose", "confidence": "high", "type": "plant", "linnaean": "Rosa spp.", "family": "Rosaceae", "note": "Refers to various species of wild roses, not a single specific Linnaean binomial.", "wikidata_id": "Q218368", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Rosa%20acicularis", "wikipedia_extract": "Rosa acicularis is a flowering plant in the Rosaceae family. It is commonly known as the prickly wild rose, prickly rose, bristly rose, wild rose or Arctic rose. It is a species of wild rose with a Holarctic distribution in northern regions of Asia, Europe, and North America. Rosa acicularis is a deciduous shrub growing 1\u20133 m tall. The leaves are pinnate, 7\u201314 cm long, with three to seven leaflets. The leaflets are ovate, with serrate (toothed) margins."}}, {"canonical_name": "Spring Water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "spring_water", "book_id": "english_physician_1652", "name": "Spring Water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Spring Water"], "contexts": ["water used for infusion", "water used for decoction"]}, {"entity_id": "spring_water", "book_id": "kosmos_humboldt_1845", "name": "spring water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["spring water"], "contexts": ["water from a natural spring"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Spring Water", "target_book": "kosmos_humboldt_1845", "target_name": "spring water", "similarity": 0.972}], "id": 4505, "stable_key": "clu_b0776fa39a170a48", "ground_truth": {"modern_name": "Spring water", "confidence": "high", "type": "substance", "wikidata_id": "Q158996", "wikidata_description": "species of plant", "wikipedia_extract": "Humic substances (HS) are relatively recalcitrant colored organic compounds naturally formed during long-term decomposition and transformation of biomass residues. The color of humic substances varies from bright yellow to light or dark brown leading to black. The term comes from humus, which in turn comes from the Latin word humus, meaning \"soil, earth\". Humic substances constitute the majority of organic matter in soil, peat, coal, and sediments, and are important components of dissolved natural organic matter (NOM) in lakes (especially dystrophic lakes), rivers, and sea water. Humic substances account for 50 \u2013 90% of cation exchange capacity in soils. \"Humic substances\" is an umbrella term covering humic acid, fulvic acid, and humin, which differ in solubility.", "wikipedia_url": "https://en.wikipedia.org/wiki/Humic_substance"}}, {"canonical_name": "Barberry", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "barberry", "book_id": "english_physician_1652", "name": "Barberry", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Barberry"], "contexts": ["shrub with medicinal properties"]}, {"entity_id": "barberry", "book_id": "origin_of_species_darwin_1859", "name": "Barberry", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Barberry", "barberry"], "contexts": ["genus with insect-assisted stamen spring", "flowers of"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Barberry", "target_book": "origin_of_species_darwin_1859", "target_name": "Barberry", "similarity": 1.0}], "id": 4506, "stable_key": "clu_6096432d2de7be89", "ground_truth": {"modern_name": "barberry", "confidence": "high", "type": "plant", "linnaean": "Berberis vulgaris", "family": "Berberidaceae", "description": "Shrub with tart red berries, used in traditional medicine and as an ingredient.", "wikipedia_extract": "Berberis vulgaris, also known as common barberry, European barberry or simply barberry, is a shrub in the genus Berberis native to the Old World. It produces edible but sharply acidic berries, which people in many countries eat as a tart and refreshing fruit. It is a deciduous shrub growing up to 4 metres (13 feet) high. The leaves are small, oval, 2\u20135 centimetres (3\u20444\u20132 inches) long and 1\u20132 cm (1\u20442\u20133\u20444 in) broad, with a serrated margin; they are borne in clusters of 2\u20135 together, subtended by a three-branched spine 3\u20138 millimetres (1\u20448\u20135\u204416 in) long. The flowers are yellow, 4\u20136 mm (1\u20448\u20131\u20444 in) across, produced on 3\u20136 cm (1+1\u20448\u20132+3\u20448 in) long panicles in late spring. The fruit is an oblong red berry 7\u201310 mm (1\u20444\u20133\u20448 in) long and 3\u20135 mm (1\u20448\u20133\u204416 in) broad, ripening in late summer or autumn."}}, {"canonical_name": "dolores viejos", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "old_pains", "book_id": "english_physician_1652", "name": "old pains", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["old pains"], "contexts": ["chronic discomfort"]}, {"entity_id": "dolores_viejos", "book_id": "historia_medicinal_monardes_1574", "name": "dolores viejos", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["dolores viejos"], "contexts": ["old pains", "old head pains"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "old pains", "target_book": "historia_medicinal_monardes_1574", "target_name": "dolores viejos", "similarity": 0.911}], "id": 4507, "stable_key": "clu_731ac1ce2f972d3f", "ground_truth": {"modern_name": "Chronic pain", "confidence": "high", "type": "disease", "modern_term": "Chronic pain", "note": "The phrases 'old pains' and 'dolores viejos' describe persistent, long-lasting discomfort, aligning with the modern concept of chronic pain."}}, {"canonical_name": "gallons", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "gallons", "book_id": "english_physician_1652", "name": "Gallons", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Gallons"], "contexts": ["unit of volume"]}, {"entity_id": "gallons", "book_id": "relation_historique_humboldt_vol3_1825", "name": "gallons", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["gallons"], "contexts": ["unit of volume for syrup", "unit of liquid measure"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Gallons", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "gallons", "similarity": 0.983}], "id": 4508, "stable_key": "clu_977712d1c26397a7", "ground_truth": {"wikipedia_extract": "The gallon is a unit of volume in British imperial units and United States customary units. The imperial gallon (imp gal) is defined as 4.54609 litres, and is or was used in the United Kingdom and its former colonies, including Ireland, Canada, Australia, New Zealand, India, South Africa, Malaysia and some Caribbean countries, while the US gallon (US gal) is defined as 231 cubic inches (3.785411784 L), and is used in the United States and some Latin American and Caribbean countries. There are four gills in a pint, two pints in a quart, and four quarts (quarter gallons) in a gallon, with the imperial gill being divided into five imperial fluid ounces and the US gill being divided into four US fluid ounces: this, and a slight difference in the sizes of the imperial fluid ounce and the US fluid ounce, give different sizes for the imperial gallon and US gallon. The IEEE standard symbol for both the imperial and US gallons is gal, not to be confused with the gal (symbol: Gal), a CGS unit of acceleration. The gallon currently has two definitions, in the imperial system and in the US customary system. Historically, there were many definitions and redefinitions: see \u00a7 Sizes of gallons for details."}}, {"canonical_name": "Spaniards", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "spaniards", "book_id": "english_physician_1652", "name": "Spaniards", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Spaniards"], "contexts": ["use columbine root for kidney stones"]}, {"entity_id": "spaniard", "book_id": "origin_of_species_darwin_1859", "name": "Spaniard", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Spaniard"], "contexts": ["person from Spain"]}, {"entity_id": "spaniards", "book_id": "origin_of_species_darwin_1859", "name": "Spaniards", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Spaniards"], "contexts": ["introduced horses to South America"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Spaniards", "target_book": "origin_of_species_darwin_1859", "target_name": "Spaniard", "similarity": 0.944}, {"source_book": "english_physician_1652", "source_name": "Spaniards", "target_book": "origin_of_species_darwin_1859", "target_name": "Spaniards", "similarity": 1.0}], "id": 4509, "stable_key": "clu_1a1025ae12988339", "ground_truth": {"modern_name": "Spaniards", "confidence": "high", "type": "concept", "note": "While 'Spaniards' refers to people from Spain, the context here points to a collective identity and their actions/introductions, rather than specific individuals. It functions as a conceptual grouping in historical narratives.", "wikidata_id": "Q29", "wikidata_description": "country in southwestern Europe with territories in Africa", "wikipedia_url": "https://en.wikipedia.org/wiki/Spain", "wikipedia_extract": "Spain, officially the Kingdom of Spain, is a country in Southern and Western Europe with territories in North Africa. Featuring the southernmost point of continental Europe, it is the largest country in Southern Europe and the fourth-most populous European Union (EU) member state. Spanning the majority of the Iberian Peninsula, its territory also includes the Canary Islands, in the Eastern Atlantic Ocean; the Balearic Islands, in the Western Mediterranean Sea; and the autonomous cities of Ceuta and Melilla, in mainland Africa. Peninsular Spain is bordered to the north by France, Andorra, and the Bay of Biscay; to the east and south by the Mediterranean Sea and Gibraltar; and to the west by Portugal and the Atlantic Ocean. Spain's capital and largest city is Madrid; other major urban areas include Barcelona, Valencia, Seville, Zaragoza, M\u00e1laga, Murcia, and Palma de Mallorca. In early antiquity, the Iberian Peninsula was inhabited by Celts, Iberians, and other pre-Roman peoples."}}, {"canonical_name": "morphea", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "morphews", "book_id": "english_physician_1652", "name": "Morphews", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Morphews"], "contexts": ["skin condition"]}, {"entity_id": "morphea", "book_id": "polyanthea_medicinal", "name": "morphea", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["Morphea", "morphea"], "contexts": ["skin condition differing from Ictericia", "skin ailment treated by unguent"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Morphews", "target_book": "polyanthea_medicinal", "target_name": "morphea", "similarity": 0.902}], "id": 4510, "stable_key": "clu_e9892108b00360c5", "ground_truth": {"modern_name": "Morphea", "confidence": "high", "type": "disease", "modern_term": "Morphea", "note": "The spelling variations ('Morphews', 'morphea') and the context of a skin condition strongly indicate this dermatological term.", "wikidata_id": "Q3324389", "wikidata_description": "human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Morphea", "wikipedia_extract": "Morphea is a form of scleroderma that mainly involves isolated patches of hardened skin on the face, hands, and feet, or anywhere else on the body, usually with no internal organ involvement. However, in Deep Morphea inflammation and sclerosis can be found in the deep dermis, panniculus, fascia, superficial muscle and bone. Morphea most often presents as macules or plaques a few centimeters in diameter, but also may occur as bands or in guttate lesions or nodules. Morphea is a thickening and hardening of the skin and subcutaneous tissues from excessive collagen deposition. Morphea includes specific conditions ranging from very small plaques only involving the skin to widespread disease causing functional and cosmetic deformities. Morphea discriminates from systemic sclerosis by its supposed lack of internal organ involvement."}}, {"canonical_name": "Banco", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "banks", "book_id": "english_physician_1652", "name": "Banks", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Banks"], "contexts": ["natural habitat for plants"]}, {"entity_id": "banco", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Banco", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Banco"], "contexts": ["location with phonolitic and granitic rocks", "north of Penon de Rosa"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Banks", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Banco", "similarity": 0.897}], "id": 4511, "stable_key": "clu_87514a720035e514", "ground_truth": {"modern_name": "Bank", "confidence": "medium", "type": "place", "country": "Various", "note": "The context of 'Banco' with phonolitic and granitic rocks suggests a geological formation or a specific named place known for its geology. 'Banks' in the English physician's text, related to natural habitats for plants, points to land formations along rivers or bodies of water. The term is ambiguous but 'bank' as a geographical feature is the most probable overlap.", "wikipedia_extract": "Banco do Brasil S.A. (pronounced [\u02c8b\u0250\u0303ku du b\u027ea\u02c8ziw], lit. 'Bank of Brazil') is a Brazilian financial services company headquartered in Bras\u00edlia, Brazil. The oldest bank in Brazil, and among the oldest banks in continuous operation in the world, it was founded by John VI, King of Portugal, on Wednesday, 12 October 1808. It is the second largest banking institution in Brazil, as well as the second largest in Latin America. Banco do Brasil is controlled by the Brazilian government and is listed at the B3 stock exchange in S\u00e3o Paulo.", "wikipedia_url": "https://en.wikipedia.org/wiki/Banco_do_Brasil"}}, {"canonical_name": "drones", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "drones", "book_id": "english_physician_1652", "name": "Drones", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Drones"], "contexts": ["male bees"]}, {"entity_id": "drones", "book_id": "origin_of_species_darwin_1859", "name": "drones", "category": "ANIMAL", "subcategory": "INSECT", "count": 2, "variants": ["drones"], "contexts": ["male bees", "male bees produced in large numbers"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Drones", "target_book": "origin_of_species_darwin_1859", "target_name": "drones", "similarity": 0.832}], "id": 4512, "stable_key": "clu_3e31d9ae73b73de7", "ground_truth": {"modern_name": "Drone bee", "confidence": "high", "type": "animal", "note": "Specifically refers to the male bee.", "wikipedia_extract": "A honey bee (also spelled honeybee) is a eusocial flying insect from the genus Apis of the largest bee family, Apidae. Honey bees are known for their construction of perennial nests within cavities (i.e. beehives) containing hexagonal cells made of secreted wax, their large colony sizes, and their routine regurgitation of digested carbohydrates as surplus food storage in the form of honey, the lattermost of which distinguishes their hives as a prized foraging target of many mellivorous animals including honey badgers, bears and human hunter-gatherers. Although honey bees represent only a small fraction of the roughly 20,000 known species of bees, they are the bee clade most familiar to humans and are also the most valuable beneficial insects to agriculture and horticulture. The best-known honey bee species is the western honey bee (Apis mellifera), which was domesticated and farmed (i.e. beekeeping) for honey production and crop pollination.", "wikipedia_url": "https://en.wikipedia.org/wiki/Honey_bee"}}, {"canonical_name": "Feminine parts", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "feminine_parts", "book_id": "english_physician_1652", "name": "Feminine parts", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Feminine parts"], "contexts": ["female reproductive organs"]}, {"entity_id": "fementhe", "book_id": "polyanthea_medicinal", "name": "fementhe", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["fementhe"], "contexts": ["semen"]}, {"entity_id": "partes_uterinas", "book_id": "polyanthea_medicinal", "name": "partes uterinas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["partes uterinas"], "contexts": ["parts related to the uterus"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Feminine parts", "target_book": "polyanthea_medicinal", "target_name": "fementhe", "similarity": 0.915}, {"source_book": "english_physician_1652", "source_name": "Feminine parts", "target_book": "polyanthea_medicinal", "target_name": "partes uterinas", "similarity": 0.889}], "id": 4513, "stable_key": "clu_fbe21211f6ec1358", "ground_truth": {"modern_name": "Female reproductive system", "confidence": "medium", "type": "concept", "note": "The terms 'Feminine parts', 'fementhe', and 'partes uterinas' all point to anatomical structures and concepts related to female reproduction. 'Fementhe' is likely a variant or corruption. 'Female reproductive system' is a broader and more accurate modern concept.", "wikidata_id": "Q648065", "wikidata_description": "diminished or absent ability of a female to achieve conception", "wikipedia_url": "https://en.wikipedia.org/wiki/Female%20infertility", "wikipedia_extract": "Female infertility refers to infertility in women, which is the inability to conceive after sexual intercourse. It affects an estimated 48 million women, globally. Female infertility varies widely by region, The highest rates of female infertility are found in Eastern Europe and South Central Asia, followed by South Asia, Sub-Saharan Africa, and Middle East and North Africa. Female infertility rates are lowest in East Asia and Latin America. Fertility is affected by a variety of factors, including hormones, nutritional status, disease, and malformations of the uterus. Infertility affects women from around the world, and the social stigmas affecting infertile women may vary from region to region."}}, {"canonical_name": "flash of lightning", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "blastings_by_lightning", "book_id": "english_physician_1652", "name": "Blastings by Lightning", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Blastings by Lightning"], "contexts": ["treated with oil of roses"]}, {"entity_id": "flash_of_lightning", "book_id": "connexion_physical_sciences_somerville_1858", "name": "flash of lightning", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["flash of lightning"], "contexts": ["sudden electrical discharge", "caused by discharge between clouds"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Blastings by Lightning", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "flash of lightning", "similarity": 0.897}], "id": 4514, "stable_key": "clu_712d8d97bd2c0331", "ground_truth": {"modern_name": "Lightning strike", "confidence": "high", "type": "disease", "modern_term": "Lightning strike", "wikipedia_extract": "A lightning strike or lightning bolt is a lightning event in which an electric discharge takes place between the atmosphere and the ground. Most originate in a cumulonimbus cloud and terminate on the ground, called cloud-to-ground (CG) lightning. A less common type of strike, ground-to-cloud (GC) lightning, is upward-propagating lightning initiated from a tall grounded object and reaching into the clouds. About 25% of all lightning events worldwide are strikes between the atmosphere and earth-bound objects. Most are intracloud (IC) lightning and cloud-to-cloud (CC), where discharges only occur high in the atmosphere. Lightning strikes the average commercial aircraft at least once a year, but modern engineering and design means this is rarely a problem."}}, {"canonical_name": "olor horrible", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "evil_smel", "book_id": "english_physician_1652", "name": "evil smel", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["evil smel"], "contexts": ["symptom from gums"]}, {"entity_id": "olor_horrible", "book_id": "historia_medicinal_monardes_1574", "name": "olor horrible", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["olor horrible", "sabor horrible"], "contexts": ["horrible smell from stomach", "horrible taste from stomach"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "evil smel", "target_book": "historia_medicinal_monardes_1574", "target_name": "olor horrible", "similarity": 0.921}], "id": 4515, "stable_key": "clu_89f270e0303bd88a", "ground_truth": {"modern_name": "Bad breath", "confidence": "high", "type": "disease", "modern_term": "Halitosis", "note": "While \"olor horrible\" is a descriptive symptom, \"halitosis\" is the modern medical term for an offensive smell from the mouth or nose, fitting the context of gums and stomach smells.", "wikidata_id": "Q16408", "wikidata_description": "presence of unpleasant odors in exhaled breath", "wikipedia_url": "https://en.wikipedia.org/wiki/Bad%20breath", "wikipedia_extract": "Bad breath, also known as halitosis, is a symptom in which a noticeably unpleasant breath odour is present. It can result in anxiety among those affected. It is also associated with depression and symptoms of obsessive compulsive disorder. The concerns of bad breath may be divided into genuine and non-genuine cases. Of those who have genuine bad breath, about 85% of cases come from inside the mouth. The remaining cases are believed to be due to disorders in the nose, sinuses, throat, lungs, esophagus, or stomach."}}, {"canonical_name": "Tobacco", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tobacco", "book_id": "english_physician_1652", "name": "Tobacco", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Tobacco"], "contexts": ["plant smoked like rosemary leaves"]}, {"entity_id": "tobacco", "book_id": "origin_of_species_darwin_1859", "name": "Tobacco", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Tobacco", "tobacco"], "contexts": ["plant variety with fertility differences", "crossed varieties"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Tobacco", "target_book": "origin_of_species_darwin_1859", "target_name": "Tobacco", "similarity": 1.0}], "id": 4516, "stable_key": "clu_67dc6d274a9f9d8a-2", "ground_truth": {"modern_name": "Tobacco", "confidence": "high", "type": "plant", "linnaean": "Nicotiana tabacum", "family": "Solanaceae", "description": "Plant species of the genus Nicotiana, widely cultivated for its leaves.", "note": "Includes the term 'tabaxir', which refers to a siliceous deposit from bamboo, but contextually relates to the broader discussion of medicinal plant substances.", "wikipedia_extract": "Nicotiana tabacum, or cultivated tobacco, is an annually grown herbaceous plant of the genus Nicotiana. N. tabacum is the most commonly grown species in the genus Nicotiana, as the plant's leaves are commercially harvested to be processed into tobacco for human use. The plant is tropical in origin, is commonly grown throughout the world, and is often found in cultivation. It grows to heights between 1 and 2 metres (3.3 and 6.6 ft). Research is ongoing into its ancestry among wild Nicotiana species, but it is believed to be a hybrid of Nicotiana sylvestris, N. tomentosiformis, and possibly N. otophora. It is an annual plant that grows 1 to 3 metres (3 to 10 feet) high and is sticky haired on all parts."}}, {"canonical_name": "Venemous", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "venemous", "book_id": "english_physician_1652", "name": "Venemous", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Venemous"], "contexts": ["poisonous substances"]}, {"entity_id": "venenoso", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "venenoso", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["venenoso"], "contexts": ["poisonous substance on arrows"]}, {"entity_id": "venenosas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "venenosas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["venenosas"], "contexts": ["poisonous wounds"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Venemous", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "venenoso", "similarity": 0.93}, {"source_book": "english_physician_1652", "source_name": "Venemous", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "venenosas", "similarity": 0.928}], "id": 4517, "stable_key": "clu_ffe0a4344859441d-3", "ground_truth": {"modern_name": "Poisons", "confidence": "high", "type": "chemical", "wikidata_id": "Q114953", "wikidata_description": "toxic effect of a biological or chemical agent"}}, {"canonical_name": "Agrippa", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "agrippa", "book_id": "english_physician_1652", "name": "Agrippa", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Agrippa"], "contexts": ["early modern author"]}, {"entity_id": "agrippa", "book_id": "polyanthea_medicinal", "name": "Agrippa", "category": "PERSON", "subcategory": "PATRON", "count": 2, "variants": ["Agrippa"], "contexts": ["King of Judea, composed an ointment", "King of Judea composed an ointment"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Agrippa", "target_book": "polyanthea_medicinal", "target_name": "Agrippa", "similarity": 0.72}], "id": 4518, "stable_key": "clu_e187e4f6e17bc4e4", "ground_truth": {"modern_name": "Agrippa", "confidence": "low", "type": "person", "description": "Early modern author, King of Judea, composed an ointment.", "note": "This is highly ambiguous. Without further context, it's impossible to definitively identify which 'Agrippa' is being referred to. It could be Agrippa the Younger (known for his ointment), or another figure named Agrippa mentioned in early modern texts. The mention of 'King of Judea' is particularly confusing as most prominent Agrippas are not associated with this title.", "wikidata_id": "Q313419", "wikidata_description": "king of Chalcis (Syria) from Herodian dynasty (28-100)", "wikipedia_url": "https://en.wikipedia.org/wiki/Herod%20Agrippa%20II", "wikipedia_extract": "Herod Agrippa II (Roman name: Marcus Julius Agrippa, Hebrew: \u05d0\u05d2\u05e8\u05d9\u05e4\u05e1; AD 27/28 \u2013 c. 92 or 100), sometimes shortened to Agrippa II or Agrippa, was the last ruler from the Herodian dynasty, reigning over territories outside of Judea as a Roman client. Agrippa II fled Jerusalem in 66, fearing the Jewish uprising, and he supported the Roman side in the First Jewish\u2013Roman War. Herod Agrippa II was the son of the first and better-known Herod Agrippa and the brother of Berenice, Mariamne, and Drusilla (second wife of the Roman procurator Antonius Felix). He was educated at the court of the emperor Claudius, and at the time of his father's death he was 17 years old. Claudius therefore kept him at Rome and sent Cuspius Fadus as procurator of the Roman province of Judaea."}}, {"canonical_name": "sar^aparrilla", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "sarsaparilla", "book_id": "english_physician_1652", "name": "Sarsaparilla", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Sarsaparilla"], "contexts": ["herb used for French Pox"]}, {"entity_id": "sar^aparrilla", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "sar^aparrilla", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["sar^aparrilla"], "contexts": ["Spanish name for the plant", "nobilissima planta called mecapatli by Mexicans"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Sarsaparilla", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "sar^aparrilla", "similarity": 0.899}], "id": 4519, "stable_key": "clu_35784842702ca82e", "ground_truth": {"modern_name": "sarsaparilla", "confidence": "high", "type": "plant", "linnaean": "Smilax ornata", "family": "Smilacaceae", "note": "The context of treating 'French Pox' (syphilis) and the Spanish name strongly point to sarsaparilla.", "wikidata_id": "Q1117102", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Smilax%20regelii"}}, {"canonical_name": "cantari", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cantaras", "book_id": "coloquios_da_orta_1563", "name": "cantaras", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["cantaras"], "contexts": ["illness treated by herpas"]}, {"entity_id": "cantari", "book_id": "polyanthea_medicinal", "name": "cantari", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["cantari", "cantari\u00addas"], "contexts": ["medical condition, likely cantharides poisoning", "blisters, likely from cantharides"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "cantaras", "target_book": "polyanthea_medicinal", "target_name": "cantari", "similarity": 0.943}], "id": 4520, "stable_key": "clu_42cbe44edea3892e", "ground_truth": {"modern_name": "cantharidism", "confidence": "high", "type": "disease", "modern_term": "cantharidism", "note": "The terms 'cantari' and 'cantaras' in a medical context, particularly with the mention of treatment by 'herpas' (likely referring to cantharides), strongly suggest cantharidism (poisoning from blister beetles).", "wikipedia_extract": "Morgan le Fay (; Welsh and Cornish: Morgen; Modern French: F\u00e9e Morgane), alternatively known as Morgan[n]a, Morgain[a/e], Morgant[e], Morg[a]ne, Morgayn[e], Morgein[e], and Morgue[in] among other names and spellings, is a powerful and ambiguous enchantress from the legend of King Arthur, in which most often she and he are siblings. According to the different authors, she is a fairy or a human; beneficial or harmful; either a sister, half-sister, or unrelated to Arthur. A significant aspect in many of Morgan's medieval and later iterations is the unpredictable duality of her nature, with potential for both good and evil. Her character may have originated from Welsh mythology as well as from other ancient and medieval myths and historical figures. Early appearances of Morgan in Arthurian literature do not elaborate her character beyond her role as a goddess, a fay, a witch, or a sorceress, generally benevolent and connected to Arthur as his magical saviour and protector. The earliest documented account, by Geoffrey of Monmouth in Vita Merlini (written c.", "wikipedia_url": "https://en.wikipedia.org/wiki/Morgan_le_Fay"}}, {"canonical_name": "barba", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "beard", "book_id": "english_physician_1652", "name": "Beard", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Beard"], "contexts": ["body part where hair grows"]}, {"entity_id": "barba", "book_id": "polyanthea_medicinal", "name": "barba", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["barba"], "contexts": ["hair of the beard", "beard"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Beard", "target_book": "polyanthea_medicinal", "target_name": "barba", "similarity": 0.892}], "id": 4521, "stable_key": "clu_1b6adcf0fea54af5", "ground_truth": {"wikipedia_extract": "Barba (which means \"beard\" in Spanish, Portuguese and Italian) is a surname. Notable people with the surname include: Antonella Barba (born 1986), U.S. singer and contestant on American Idol Angelo Barba (born 1958), Filipino politician Ben Barba (born 1989), Australian rugby footballer Eugenio Barba (born 1936), Italian author and director Federico Barba (born 1993), Italian footballer Fidel LaBarba (1905\u20131981), U.S. boxer and sportswriter Javier Barba, lead guitar of Mexican rock band Los Depas Juan Barbas (born 1959), Argentine footballer Paul Barb\u0103 Neagr\u0103 (1929\u20132009), Romanian film director Porfirio Barba-Jacob, pseudonym of Miguel \u00c1ngel Osorio Ben\u00edtez, Colombian poet Victoria Barb\u0103 (1926\u20132020), Moldovan animated film director Barba (footballer) (born 1999), full name Jo\u00e3o Pedro de Giuli, Brazilian footballer Rafael Barba, (Ra\u00fal Esparza) appearing on Law & Order: Special Victims Unit Barbapapa, the title character, and name of the \"species\" of said character, of a series of children's books The Barba River, a tributary of the Vologne in the French Vosges Barba as the Latin root of the word \"beard\" Barba is the last palace dungeon of the sixth dungeon in Zelda II: The Adventure of Link. He is a serpent. When Nintendo released Zelda II in Europe and America, they called the palace boss Barba, but this has since been retconned as Volvagia, which is his original name in the Japanese version of Zelda II."}}, {"canonical_name": "Greene", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "greens", "book_id": "english_physician_1652", "name": "Greens", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Greens"], "contexts": ["open grassy areas"]}, {"entity_id": "greene", "book_id": "principles_of_psychology_james_1890", "name": "Greene", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Greene"], "contexts": ["town in Rhode Island", "location of land purchase"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Greens", "target_book": "principles_of_psychology_james_1890", "target_name": "Greene", "similarity": 0.907}], "id": 4522, "stable_key": "clu_1d152df0a29cc297", "ground_truth": {"modern_name": "Green spaces", "confidence": "medium", "type": "concept", "note": "The dual context of 'open grassy areas' and a 'town in Rhode Island' suggests 'green spaces' as a general concept, but also potentially a specific place. 'Greene' as a town in Rhode Island is a possible referent, but 'green spaces' better captures the descriptive context.", "wikidata_id": "Q11607807", "wikidata_description": "term of city planning in Japan"}}, {"canonical_name": "ligamentos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ligaments", "book_id": "english_physician_1652", "name": "Ligaments", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Ligaments"], "contexts": ["body part bound by disease"]}, {"entity_id": "ligamentos", "book_id": "polyanthea_medicinal", "name": "ligamentos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["ligamentos", "ligamento"], "contexts": ["connecting ribs to spine", "connecting uterus and intestine"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Ligaments", "target_book": "polyanthea_medicinal", "target_name": "ligamentos", "similarity": 0.929}], "id": 4523, "stable_key": "clu_7a0d9cc1f5667e40", "ground_truth": {"modern_name": "Ligaments", "confidence": "high", "type": "concept", "note": "'Ligamentos' refers to ligaments. 'Limbs' and 'Ligaments' in the English text confirm this anatomical reference.", "wikipedia_extract": "A ligament is a type of fibrous connective tissue in the body that connects bones to other bones. It also connects flight feathers to bones, in dinosaurs and birds. All 30,000 species of amniotes (land animals with internal bones) have ligaments. It is also known as articular ligament, articular larua, fibrous ligament, or true ligament. Ligaments are similar to tendons and fasciae as they are all made of connective tissue. The differences among them are in the connections that they make: ligaments connect one bone to another bone, tendons connect muscle to bone, and fasciae connect muscles to other muscles.", "wikipedia_url": "https://en.wikipedia.org/wiki/Ligament"}}, {"canonical_name": "bath", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "baths", "book_id": "english_physician_1652", "name": "baths", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["baths"], "contexts": ["a method of bathing"]}, {"entity_id": "bath", "book_id": "principles_of_psychology_james_1890", "name": "bath", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Bath", "bath"], "contexts": ["city where Miss Hawkins is from", "act or place of washing"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "baths", "target_book": "principles_of_psychology_james_1890", "target_name": "bath", "similarity": 0.935}], "id": 4524, "stable_key": "clu_6a1fb32b5311c579", "ground_truth": {"modern_name": "Bathing", "confidence": "high", "type": "concept", "note": "The context 'a method of bathing' clearly points to the act of bathing. The 'city where Miss Hawkins is from' is likely a specific instance of a place associated with bathing, but the core concept is 'bathing'."}}, {"canonical_name": "shadows", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "shadow", "book_id": "english_physician_1652", "name": "shadow", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["shadow"], "contexts": ["natural element affecting plant growth"]}, {"entity_id": "shadows", "book_id": "connexion_physical_sciences_somerville_1858", "name": "shadows", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["shadows"], "contexts": ["absence of light due to obstruction", "coloured fringes bordering shadows"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "shadow", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "shadows", "similarity": 0.936}], "id": 4525, "stable_key": "clu_e28dca4597ba868d", "ground_truth": {"wikipedia_extract": "A shadow is a dark area on a surface where light from a light source is blocked by an object. In contrast, shade occupies the three-dimensional volume behind an object with light in front of it. The cross-section of a shadow is a two-dimensional silhouette, or a reverse projection of the object blocking the light. A point source of light casts only a simple shadow, called an \"umbra\". For a non-point or \"extended\" source of light, the shadow is divided into the umbra, penumbra, and antumbra. The wider the light source, the more blurred the shadow becomes."}}, {"canonical_name": "types", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "types", "book_id": "origin_of_species_darwin_1859", "name": "types", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["types"], "contexts": ["categories of organisms", "categories of biological forms"]}, {"entity_id": "type", "book_id": "first_principles_spencer_1862", "name": "type", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["type"], "contexts": ["a distinct kind or category"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "types", "target_book": "first_principles_spencer_1862", "target_name": "type", "similarity": 0.936}], "id": 4526, "stable_key": "clu_a5eef504a4e423fc", "ground_truth": {"modern_name": "type", "confidence": "high", "type": "concept", "note": "In early modern scientific texts, 'type' often referred to a distinct kind, category, or species, especially in biology before formal Linnaean taxonomy was universally adopted or when discussing variations within species.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "oceanic islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "oceanic_islands", "book_id": "origin_of_species_darwin_1859", "name": "oceanic islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["oceanic islands"], "contexts": ["islands in the ocean"]}, {"entity_id": "sea_islands", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Sea islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Sea islands"], "contexts": ["islands in the sea"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "oceanic islands", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Sea islands", "similarity": 0.951}], "id": 4527, "stable_key": "clu_3ce88ac8416b3ac4", "ground_truth": {"modern_name": "oceanic islands", "confidence": "high", "type": "place", "wikidata_id": "Q127183048", "wikidata_description": "scholarly article"}}, {"canonical_name": "Origin of Species", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "origin_of_species", "book_id": "origin_of_species_darwin_1859", "name": "Origin of Species", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["origin of species", "Origin of Species"], "contexts": ["mystery of biological diversity", "title of a scientific work"]}, {"entity_id": "the_origin_of_species", "book_id": "first_principles_spencer_1862", "name": "The Origin of Species", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["The Origin of Species"], "contexts": ["Darwin's influential work"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Origin of Species", "target_book": "first_principles_spencer_1862", "target_name": "The Origin of Species", "similarity": 0.938}], "id": 4528, "stable_key": "clu_4edbaa8eb2a08da6", "ground_truth": {"modern_name": "On the Origin of Species", "confidence": "high", "type": "text", "note": "The cluster refers to Darwin's 'On the Origin of Species' and also a less well-known work by Herbert Spencer with a similar title. Darwin's work is the primary referent given the context.", "wikidata_id": "Q20124", "wikidata_description": "treatise on natural selection, written by Charles Darwin", "wikipedia_url": "https://en.wikipedia.org/wiki/On%20the%20Origin%20of%20Species", "wikipedia_extract": "On the Origin of Species by Means of Natural Selection, or the Preservation of Favoured Races in the Struggle for Life is a work of scientific literature by Charles Darwin that is considered to be the foundation of evolutionary biology. It was published on 24 November 1859. Darwin's book introduced the scientific theory that populations evolve over the course of generations through a process of natural selection, although Lamarckism was also included as a mechanism of lesser importance. The book presented a body of evidence that the diversity of life arose by common descent through a branching pattern of evolution. Darwin included evidence that he had collected on the Beagle expedition in the 1830s and his subsequent findings from research, correspondence, and experimentation. Various evolutionary ideas had already been proposed to explain new findings in biology."}}, {"canonical_name": "sex", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "sex", "book_id": "origin_of_species_darwin_1859", "name": "sex", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["sex"], "contexts": ["biological distinction between male and female", "biological classification of individuals"]}, {"entity_id": "sex", "book_id": "first_principles_spencer_1862", "name": "sex", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["sex"], "contexts": ["biological distinction between male and female"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "sex", "target_book": "first_principles_spencer_1862", "target_name": "sex", "similarity": 1.0}], "id": 4529, "stable_key": "clu_6038c51f34c9ca3a-2", "ground_truth": {"modern_name": "sex", "confidence": "high", "type": "concept"}}, {"canonical_name": "beaks", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "beaks", "book_id": "origin_of_species_darwin_1859", "name": "beaks", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["beaks"], "contexts": ["part of pigeon anatomy", "mouthparts of birds"]}, {"entity_id": "bey\u00e7os", "book_id": "polyanthea_medicinal", "name": "bey\u00e7os", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bey\u00e7os"], "contexts": ["body part"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "beaks", "target_book": "polyanthea_medicinal", "target_name": "bey\u00e7os", "similarity": 0.887}], "id": 4530, "stable_key": "clu_07fe7c5a26f11b17", "ground_truth": {"modern_name": "beak", "confidence": "high", "type": "animal", "note": "While 'beak' is a part of an animal, the cluster is tagged as 'SUBSTANCE' and 'ANATOMY'. Given the context of pigeons, it refers to the anatomical feature.", "wikidata_id": "Q31528", "wikidata_description": "external anatomical structure found in birds, non-avian dinosaurs and some mammals", "wikipedia_url": "https://en.wikipedia.org/wiki/Beak", "wikipedia_extract": "The beak or bill is an external rostrum structure found mostly in birds. A beak is used for pecking, grasping, and holding (in probing for food, eating, manipulating and carrying objects, killing prey, or fighting), preening, courtship, and feeding young. The terms beak and rostrum are also used to refer to a similar mouth part in some ornithischians, pterosaurs, cetaceans, dicynodonts, rhynchosaurs, anuran tadpoles, monotremes (i.e. echidnas and platypuses, which have a bill-like structure), sirens, pufferfish, billfishes, and cephalopods. Although beaks vary significantly in size, shape, color and texture, they share a similar underlying structure. Two bony projections\u2013the upper and lower mandibles\u2013are covered with a thin keratinized layer of epidermis known as the rhamphotheca."}}, {"canonical_name": "feline animal", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "feline_animal", "book_id": "origin_of_species_darwin_1859", "name": "feline animal", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["feline animal"], "contexts": ["presence affects flower frequency", "animal that preys on mice"]}, {"entity_id": "marsupial_animals", "book_id": "kosmos_humboldt_1845", "name": "marsupial animals", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["marsupial animals"], "contexts": ["mammals with pouches"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "feline animal", "target_book": "kosmos_humboldt_1845", "target_name": "marsupial animals", "similarity": 0.916}], "id": 4531, "stable_key": "clu_9b6b125f104d2140", "ground_truth": {"modern_name": "feline", "confidence": "high", "type": "animal", "note": "The cluster contains 'feline animal' and 'marsupial animals'. The primary referent appears to be 'feline animal'.", "wikidata_id": "Q25265", "wikidata_description": "family of mammals in the order of carnivorans"}}, {"canonical_name": "beasts of prey", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "beasts_of_prey", "book_id": "origin_of_species_darwin_1859", "name": "beasts of prey", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["beasts of prey"], "contexts": ["predators in the ecosystem", "animals that hunt other animals for food"]}, {"entity_id": "beasts_of_prey", "book_id": "first_principles_spencer_1862", "name": "beasts of prey", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["beasts of prey"], "contexts": ["carnivorous animals that hunt"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "beasts of prey", "target_book": "first_principles_spencer_1862", "target_name": "beasts of prey", "similarity": 1.0}], "id": 4532, "stable_key": "clu_7d72530130ad7be4", "ground_truth": {"modern_name": "predator", "confidence": "high", "type": "animal", "note": "Refers to animals that hunt other animals for food."}}, {"canonical_name": "rat", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "rat", "book_id": "origin_of_species_darwin_1859", "name": "rat", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["rat"], "contexts": ["rodent species", "transported by man, wide range"]}, {"entity_id": "rat", "book_id": "principles_of_psychology_james_1890", "name": "rat", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["rat"], "contexts": ["patient's self-identification"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "rat", "target_book": "principles_of_psychology_james_1890", "target_name": "rat", "similarity": 1.0}], "id": 4533, "stable_key": "clu_d32df2bd1df34ea8", "ground_truth": {"modern_name": "rat", "confidence": "high", "type": "animal", "wikidata_id": "Q184224", "wikidata_description": "species of mammal"}}, {"canonical_name": "immigration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "immigration", "book_id": "origin_of_species_darwin_1859", "name": "immigration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["immigration"], "contexts": ["movement of organisms into new areas", "arrival of new species"]}, {"entity_id": "immigration", "book_id": "first_principles_spencer_1862", "name": "immigration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["immigration"], "contexts": ["movement of people into a country"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "immigration", "target_book": "first_principles_spencer_1862", "target_name": "immigration", "similarity": 1.0}], "id": 4534, "stable_key": "clu_781e26a160ea8a2b", "ground_truth": {"modern_name": "Immigration", "confidence": "high", "type": "concept", "note": "The contexts clearly refer to both biological dispersal and human migration, both understood as 'immigration' in modern terms.", "wikidata_id": "Q131288", "wikidata_description": "movement of people into another country or region to which they are not native", "wikipedia_url": "https://en.wikipedia.org/wiki/Immigration", "wikipedia_extract": "Immigration is the international movement of people to a destination country of which they are not usual residents or where they do not possess nationality in order to settle as permanent residents. Commuters, tourists, and other short-term stays in a destination country do not fall under the definition of immigration or migration; seasonal labour immigration is sometimes included, however. Economically, research suggests that migration can be beneficial both to the receiving and sending countries. The academic literature provides mixed findings for the relationship between immigration and crime worldwide. Research shows that country of origin matters for speed and depth of immigrant assimilation, but that there is considerable assimilation overall for both first- and second-generation immigrants. Discrimination based on nationality is legal in most countries."}}, {"canonical_name": "salmon", "category": "ANIMAL", "subcategory": "FISH", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "salmon", "book_id": "origin_of_species_darwin_1859", "name": "salmon", "category": "ANIMAL", "subcategory": "FISH", "count": 2, "variants": ["salmon"], "contexts": ["fish with hooked jaw", "fish with hooked jaws in males"]}, {"entity_id": "salmon", "book_id": "kosmos_humboldt_1845", "name": "salmon", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["salmon"], "contexts": ["fish whose blood contains animalcules"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "salmon", "target_book": "kosmos_humboldt_1845", "target_name": "salmon", "similarity": 1.0}], "id": 4535, "stable_key": "clu_3a5dfc47dca56522", "ground_truth": {"modern_name": "Salmon", "confidence": "high", "type": "animal", "wikipedia_extract": "Salmon (; pl.: salmon) are any of several commercially important species of euryhaline ray-finned fish from the genera Salmo and Oncorhynchus of the family Salmonidae, native to tributaries of the North Atlantic (Salmo) and North Pacific (Oncorhynchus) basins. Salmon is a colloquial or common name used for fish in this group, but is not a scientific name. Other closely related fish in the same family include trout, char, grayling, whitefish, lenok and taimen, all coldwater fish of the subarctic and cooler temperate regions with some sporadic endorheic populations in Central Asia. Salmon are typically anadromous: they hatch in the shallow gravel beds of freshwater headstreams and spend their juvenile years in rivers, lakes and freshwater wetlands, migrate to the ocean as adults and live like sea fish, then return to their freshwater birthplace to reproduce. However, populations of several species are restricted to fresh waters (i.e. landlocked) throughout their lives. Folklore has it that the fish return to the exact stream where they themselves hatched to spawn, and tracking studies have shown this to be mostly true."}}, {"canonical_name": "Cetacea", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cetacea", "book_id": "origin_of_species_darwin_1859", "name": "Cetacea", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Cetacea"], "contexts": ["order of marine mammals (whales)", "order of marine mammals including whales"]}, {"entity_id": "cetacea", "book_id": "kosmos_humboldt_1845", "name": "Cetacea", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Cetacea"], "contexts": ["large marine mammals"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Cetacea", "target_book": "kosmos_humboldt_1845", "target_name": "Cetacea", "similarity": 0.696}], "id": 4536, "stable_key": "clu_22efaac19483dbcd", "ground_truth": {"modern_name": "Cetacea", "confidence": "high", "type": "animal", "note": "This is a direct taxonomic classification.", "wikidata_id": "Q160", "wikidata_description": "infraorder of marine mammals", "wikipedia_url": "https://en.wikipedia.org/wiki/Cetacean", "wikipedia_extract": "Cetaceans () are marine mammals belonging to the infraorder Cetacea, a secondarily aquatic clade under the order Artiodactyla that include whales, dolphins, porpoises and extinct groups such as Basilosaurus. Most cetaceans live in marine environments, particularly the pelagic zone, but some reside solely in brackish or fresh water. Having a cosmopolitan distribution, they can be found in some rivers and all of Earth's oceans. Many species migrate seasonally over vast ranges for food advantages. Key characteristics of cetaceans are their fully aquatic life cycle, streamlined, fish-like body shape, the need to periodically surface and breath air, and exclusively carnivorous diet. All extant cetaceans are capable of echolocation."}}, {"canonical_name": "Hearne", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "hearne", "book_id": "origin_of_species_darwin_1859", "name": "Hearne", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Hearne"], "contexts": ["observer of black bear behavior", "on habits of bears"]}, {"entity_id": "hearne", "book_id": "kosmos_humboldt_1845", "name": "Hearne", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Hearne"], "contexts": ["reported sound from Aurora"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Hearne", "target_book": "kosmos_humboldt_1845", "target_name": "Hearne", "similarity": 1.0}], "id": 4537, "stable_key": "clu_21a5af7607eed668", "ground_truth": {"modern_name": "Samuel Hearne", "confidence": "high", "type": "person", "birth_year": 1745, "death_year": 1792, "description": "British explorer and naturalist, observed black bears and aurora sounds.", "wikidata_id": "Q715285", "wikidata_description": "British explorer"}}, {"canonical_name": "Asclepias", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "asclepias", "book_id": "origin_of_species_darwin_1859", "name": "Asclepias", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Asclepias"], "contexts": ["genus with pollen-grain contrivance", "pollen of"]}, {"entity_id": "asclepideof", "book_id": "coloquios_da_orta_1563", "name": "Asclepideof", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Asclepideof"], "contexts": ["family of plants"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Asclepias", "target_book": "coloquios_da_orta_1563", "target_name": "Asclepideof", "similarity": 0.916}], "id": 4538, "stable_key": "clu_e1b8ecc5d3f94f44", "ground_truth": {"modern_name": "Milkweed", "confidence": "high", "type": "plant", "linnaean": "Asclepias", "family": "Apocynaceae", "wikidata_id": "Q311131", "wikidata_description": "species of flowering plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Asclepias%20tuberosa", "wikipedia_extract": "Asclepias tuberosa, commonly known as butterfly weed, is a species of milkweed native to eastern and southwestern North America. It is commonly known as butterfly weed because of the butterflies that are attracted to the plant by its color and its copious production of nectar. It is a perennial plant growing to 0.3\u20131 m (1\u20133+1\u20442 ft) tall. The leaves are spirally arranged, lanceolate, 3\u201312 cm (1+1\u20444\u20134+3\u20444 in) long, and 2\u20133 cm (3\u20444\u20131+1\u20444 in) broad. From April to September, in the upper axils, 7.5 cm (3 in)\u2013wide umbels of orange, yellow or red flowers 1.5 cm (1\u20442 in) wide appear. They each have five petals and five sepals."}}, {"canonical_name": "mental powers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mental_powers", "book_id": "origin_of_species_darwin_1859", "name": "mental powers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["mental powers"], "contexts": ["primary cognitive abilities", "faculties of the mind"]}, {"entity_id": "cognitive_powers", "book_id": "principles_of_psychology_james_1890", "name": "cognitive powers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cognitive powers"], "contexts": ["abilities for knowing"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "mental powers", "target_book": "principles_of_psychology_james_1890", "target_name": "cognitive powers", "similarity": 0.922}], "id": 4539, "stable_key": "clu_b93ab2022232e785-4", "ground_truth": {"modern_name": "Mental Faculties", "confidence": "high", "type": "concept", "note": "Refers to the innate powers or capacities of the mind, a significant concept in psychology and philosophy of mind."}}, {"canonical_name": "bodily structure", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "bodily_structure", "book_id": "origin_of_species_darwin_1859", "name": "bodily structure", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["bodily structure"], "contexts": ["physical form of the body", "physical form of organisms"]}, {"entity_id": "bodily_constitution", "book_id": "first_principles_spencer_1862", "name": "bodily constitution", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bodily constitution"], "contexts": ["physical makeup of an organism"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "bodily structure", "target_book": "first_principles_spencer_1862", "target_name": "bodily constitution", "similarity": 0.973}], "id": 4540, "stable_key": "clu_e8cd25e2c4eedbf9", "ground_truth": {"modern_name": "Body constitution", "confidence": "high", "type": "concept", "wikidata_id": "Q66771588", "wikidata_description": "physical characteristics of the body"}}, {"canonical_name": "butterfly", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "butterfly", "book_id": "origin_of_species_darwin_1859", "name": "butterfly", "category": "ANIMAL", "subcategory": "INSECT", "count": 2, "variants": ["butterfly"], "contexts": ["flying insect", "insect with larval and adult stages"]}, {"entity_id": "butterfly", "book_id": "first_principles_spencer_1862", "name": "butterfly", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["butterfly"], "contexts": ["example of longitudinal union in Annulosa"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "butterfly", "target_book": "first_principles_spencer_1862", "target_name": "butterfly", "similarity": 0.899}], "id": 4541, "stable_key": "clu_952fba4c6dbe03cd", "ground_truth": {"modern_name": "Butterfly", "confidence": "high", "type": "animal", "wikidata_id": "Q11946202", "wikidata_description": "group of insects in the order Lepidoptera", "wikipedia_extract": "Animals are multicellular, eukaryotic organisms belonging to the biological kingdom Animalia (). With few exceptions, animals consume organic material, breathe oxygen, have myocytes and are able to move, can reproduce sexually, and grow from a hollow sphere of cells, the blastula, during embryonic development. Animals form a clade, meaning that they arose from a single common ancestor. Over 1.5 million living animal species have been described, of which around 1.05 million are insects, over 85,000 are molluscs, and around 65,000 are vertebrates. It has been estimated there are as many as 7.77 million animal species on Earth. Animal body lengths range from 8.5 \u03bcm (0.00033 in) to 33.6 m (110 ft).", "wikipedia_url": "https://en.wikipedia.org/wiki/Animal"}}, {"canonical_name": "vermilion", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "vermilion", "book_id": "origin_of_species_darwin_1859", "name": "vermilion", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["vermilion"], "contexts": ["red pigment used to color wax", "coloured wax used in experiment"]}, {"entity_id": "vermilion", "book_id": "connexion_physical_sciences_somerville_1858", "name": "vermilion", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["vermilion"], "contexts": ["red pigment from mercury sulfide"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "vermilion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "vermilion", "similarity": 0.879}], "id": 4542, "stable_key": "clu_d4dad0976fea89e3", "ground_truth": {"modern_name": "Vermilion", "confidence": "high", "type": "chemical", "note": "'Vernucolo' is a recognizable variant for vermilion, a red pigment (cinnabar, mercury sulfide) often used in early modern medicine and art. The context 'vermilion, a red pigment' and the association with poisons (as cinnabar can be toxic) fit well.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Lamarck", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "lamarck", "book_id": "origin_of_species_darwin_1859", "name": "Lamarck", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Lamarck"], "contexts": ["theorist of inheritance of acquired characteristics", "first called attention to distinction"]}, {"entity_id": "lamark", "book_id": "coloquios_da_orta_1563", "name": "Lamark", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Lamark"], "contexts": ["botanist who established a particular species"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Lamarck", "target_book": "coloquios_da_orta_1563", "target_name": "Lamark", "similarity": 0.841}], "id": 4543, "stable_key": "clu_6a9c0688052387e8", "ground_truth": {"modern_name": "Jean-Baptiste Lamarck", "confidence": "high", "type": "person", "birth_year": 1744, "death_year": 1829, "description": "French naturalist, inheritance of acquired characteristics theorist", "wikidata_id": "Q654959", "wikidata_description": "genus of plants"}}, {"canonical_name": "Passiflora", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "passiflora", "book_id": "origin_of_species_darwin_1859", "name": "Passiflora", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Passiflora"], "contexts": ["plant genus mentioned in fertilization experiments", "plant mentioned with page number"]}, {"entity_id": "passiflora_glabrala", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Passiflora glabrala", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Passiflora glabrala"], "contexts": ["plant from Turbaco"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Passiflora", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Passiflora glabrala", "similarity": 0.888}], "id": 4544, "stable_key": "clu_a64a3d456d81ead3", "ground_truth": {"wikipedia_extract": "Passiflora, known also as the passion flowers or passion vines, is a genus of about 550 species of flowering plants, and the type genus of the family Passifloraceae. Passiflora species are widely cultivated for their striking flowers, flavorful fruits, traditional medicinal uses, and roles in dietary supplements and ayahuasca analogs, with several ornamental hybrids earning Royal Horticultural Society awards. The genus mostly produces tendril-bearing vines, as well as some shrubs and trees. The plants can be woody or herbaceous. The flowers are regular and usually showy, with a distinctive corona. There can be as many as eight concentric coronal series, as in the case of P. xiikzodz. and P. alata."}}, {"canonical_name": "Dianthus", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "dianthus", "book_id": "origin_of_species_darwin_1859", "name": "Dianthus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Dianthus"], "contexts": ["genus of flowering plants", "genus with readily crossable species"]}, {"entity_id": "dianthus_caryophyllus", "book_id": "coloquios_da_orta_1563", "name": "Dianthus caryophyllus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Dianthus caryophyllus"], "contexts": ["plant cultivated in China"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Dianthus", "target_book": "coloquios_da_orta_1563", "target_name": "Dianthus caryophyllus", "similarity": 0.888}], "id": 4545, "stable_key": "clu_d222a75e333636e3", "ground_truth": {"modern_name": "Carnation", "confidence": "high", "type": "plant", "linnaean": "Dianthus caryophyllus", "family": "Caryophyllaceae", "wikidata_id": "Q156099", "wikidata_description": "genus of flowering plants"}}, {"canonical_name": "Nicotiana", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "nicotiana", "book_id": "origin_of_species_darwin_1859", "name": "Nicotiana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Nicotiana"], "contexts": ["genus with many crossed species", "crossed varieties of, species sterile"]}, {"entity_id": "nicotina", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Nicotina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Nicotina"], "contexts": ["French name for the plant"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Nicotiana", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "Nicotina", "similarity": 0.965}], "id": 4546, "stable_key": "clu_2f8cd833483a56b2", "ground_truth": {"modern_name": "Tobacco", "confidence": "high", "type": "plant", "linnaean": "Nicotiana L.", "family": "Solanaceae", "note": "The cluster includes the genus name 'Nicotiana' and a misspelling 'Nicotina', both referring to the tobacco plant genus.", "wikidata_id": "Q851829", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Nicotiana"}}, {"canonical_name": "capsule", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "capsule", "book_id": "origin_of_species_darwin_1859", "name": "capsule", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["capsule"], "contexts": ["seed-bearing structure in plants", "part of a plant containing seeds"]}, {"entity_id": "capsule", "book_id": "first_principles_spencer_1862", "name": "capsule", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["capsule"], "contexts": ["part of a flower"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "capsule", "target_book": "first_principles_spencer_1862", "target_name": "capsule", "similarity": 1.0}], "id": 4547, "stable_key": "clu_efb009dc148452c6", "ground_truth": {"modern_name": "Capsule (botany)", "confidence": "high", "type": "plant", "note": "Refers to the dry fruit of a flowering plant, typically dehiscent.", "wikipedia_extract": "This glossary of botanical terms is a list of definitions of terms and concepts relevant to botany and plants in general. Terms of plant morphology are included here as well as at the more specific Glossary of plant morphology and Glossary of leaf morphology. For other related terms, see Glossary of phytopathology, Glossary of lichen terms, and List of Latin and Greek words commonly used in systematic names. Prefix meaning \"position away from\". Surface of an organ facing away from the organ's axis, e.g. the lower surface of a lateral organ such as a leaf or petal.", "wikipedia_url": "https://en.wikipedia.org/wiki/Glossary_of_botanical_terms"}}, {"canonical_name": "Anglesea", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "anglesea", "book_id": "origin_of_species_darwin_1859", "name": "Anglesea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Anglesea"], "contexts": ["location of a geological downthrow", "little island with many plants"]}, {"entity_id": "anglesea", "book_id": "kosmos_humboldt_1845", "name": "Anglesea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Anglesea"], "contexts": ["island where garnets form"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Anglesea", "target_book": "kosmos_humboldt_1845", "target_name": "Anglesea", "similarity": 1.0}], "id": 4548, "stable_key": "clu_3ba11fa3c91c1ac7", "ground_truth": {"modern_name": "Anglesey", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q168159", "wikidata_description": "island in north-west Wales, UK", "wikipedia_url": "https://en.wikipedia.org/wiki/Anglesey", "wikipedia_extract": "Anglesey ( ANG-g\u0259l-see; Welsh: Ynys M\u00f4n [\u02c8\u0259n\u0268s \u02c8mo\u02d0n]) is an island off the north-west coast of Wales. It forms the bulk of the county known as the Isle of Anglesey, which also includes Holy Island (Ynys Gybi) and some islets and skerries. The county borders Gwynedd across the Menai Strait to the southeast, and is otherwise surrounded by the Irish Sea. Holyhead is the largest town, and the administrative centre is Llangefni. The Isle of Anglesey has an area of 275 square miles (712 km2) and had a population of 69,097 in 2024. After Holyhead, located on Holy Island, the largest settlements are Llangefni in the centre of Anglesey and Amlwch on the northern coast."}}, {"canonical_name": "tertiary", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tertiary", "book_id": "origin_of_species_darwin_1859", "name": "tertiary", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["tertiary"], "contexts": ["geological time period", "geological period"]}, {"entity_id": "tertiary", "book_id": "kosmos_humboldt_1845", "name": "tertiary", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tertiary"], "contexts": ["geological period"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "tertiary", "target_book": "kosmos_humboldt_1845", "target_name": "tertiary", "similarity": 1.0}], "id": 4549, "stable_key": "clu_cd4609353a51c51f-2", "ground_truth": {"modern_name": "Tertiary Period", "confidence": "high", "type": "concept", "wikidata_id": "Q188645", "wikidata_description": "obsolete term for the geological period 66\u20132.58 million years ago", "wikipedia_url": "https://en.wikipedia.org/wiki/Tertiary%20period", "note": "Refers to the geological period, specifically the Neogene and Paleogene periods in modern classification.", "wikipedia_extract": "The Tertiary ( TUR-sh\u0259r-ee, US also  TUR-shee-err-ee) is an obsolete geologic period spanning 66 million to 2.6 or 1.8 million years ago. The period began with the extinction of the non-avian dinosaurs in the Cretaceous\u2013Paleogene extinction event, at the start of the Cenozoic Era, and extended to the beginning of the Quaternary glaciation at the end of the Pliocene Epoch. The Tertiary has not been recognised by the International Commission on Stratigraphy (ICS) since the late 1980s, with the timespan of the Tertiary now being split into the earlier Paleogene and the more recent Neogene periods, though the Tertiary continues to be used in some scientific publications. The term Tertiary was first used by Giovanni Arduino during the mid-18th century. He classified geologic time into primitive (or primary), secondary, and tertiary periods based on observations of geology in Northern Italy. Later a fourth period, the Quaternary, was applied."}}, {"canonical_name": "extinct species", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "extinct_species", "book_id": "origin_of_species_darwin_1859", "name": "extinct species", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["extinct species"], "contexts": ["species no longer living", "species that no longer exist"]}, {"entity_id": "extinct_beings", "book_id": "connexion_physical_sciences_somerville_1858", "name": "extinct beings", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["extinct beings"], "contexts": ["organisms no longer living"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "extinct species", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "extinct beings", "similarity": 0.936}], "id": 4550, "stable_key": "clu_9c423bb5d23bc922", "ground_truth": {"modern_name": "Extinct species", "confidence": "high", "type": "concept", "note": "Refers to species that no longer exist, a concept discussed in natural history and evolutionary texts.", "wikidata_id": "Q1385098", "wikidata_description": "fading of non-reinforced conditioned response over time", "wikipedia_url": "https://en.wikipedia.org/wiki/Extinction%20%28psychology%29"}}, {"canonical_name": "Trigonia", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "trigonia", "book_id": "origin_of_species_darwin_1859", "name": "Trigonia", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Trigonia"], "contexts": ["genus of shells in secondary formations", "animal genus"]}, {"entity_id": "trigonia", "book_id": "kosmos_humboldt_1845", "name": "trigonia", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["trigonia"], "contexts": ["fossil bivalve mollusk"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Trigonia", "target_book": "kosmos_humboldt_1845", "target_name": "trigonia", "similarity": 0.632}], "id": 4551, "stable_key": "clu_4c0e75f16c9cbb44", "ground_truth": {"modern_name": "Trigonia", "confidence": "high", "type": "animal", "wikidata_id": "Q2835589", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Trigonia_%28plant%29", "wikipedia_extract": "Vanbreenia is an extinct genus of toothed whale from the Miocene epoch, containing only the species Vanbreenia trigonia. Its fossils have been found in the Miste area of Winterswijk in the Netherlands. Vanbreenia was named after Dr. P.J.H. van Bree from the Zoological Museum Amsterdam. Its grammatical gender (in Latin) is feminine."}}, {"canonical_name": "Martens", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "martens", "book_id": "origin_of_species_darwin_1859", "name": "Martens", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Martens"], "contexts": ["conducted similar experiments", "experiment on seeds"]}, {"entity_id": "marty", "book_id": "principles_of_psychology_james_1890", "name": "Marty", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Marty"], "contexts": ["critic of Wundt's apperception"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Martens", "target_book": "principles_of_psychology_james_1890", "target_name": "Marty", "similarity": 0.896}], "id": 4552, "stable_key": "clu_f8cbe9fe8ad8cdf8", "ground_truth": {"modern_name": "Friedrich Martens", "confidence": "medium", "type": "person", "birth_year": 1842, "death_year": 1911, "description": "German physicist and meteorologist, conducted atmospheric experiments.", "note": "The mention of 'Marty' alongside 'Martens' might suggest a misreading or a different individual, but given the context of 'experiments' and scientific discourse, Friedrich Martens is a plausible, though not definitively confirmed, referent. The context 'critic of Wundt's apperception' is not directly linked to Martens' known work and might refer to a different individual if the name 'Marty' is accurate."}}, {"canonical_name": "Gmelin", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "gmelin", "book_id": "origin_of_species_darwin_1859", "name": "Gmelin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Gmelin"], "contexts": ["concluded independent creation of species", "on distribution"]}, {"entity_id": "gley", "book_id": "principles_of_psychology_james_1890", "name": "Gley", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Gley"], "contexts": ["researcher on physiological changes during work"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Gmelin", "target_book": "principles_of_psychology_james_1890", "target_name": "Gley", "similarity": 0.853}], "id": 4553, "stable_key": "clu_965640a9cd6074ff", "ground_truth": {"modern_name": "Leopold Gmelin", "confidence": "medium", "type": "person", "birth_year": 1788, "death_year": 1853, "description": "German chemist, known for color index and chemical research.", "note": "The context of 'independent creation of species' points to a different Gmelin (Johann Georg Gmelin) or a misattribution. Leopold Gmelin is primarily a chemist. The 'physiological changes during work' is too general. Given the ambiguity and potential for multiple Gmelins, confidence is medium.", "wikidata_id": "Q23776845", "wikidata_description": "Architect, Art Historian"}}, {"canonical_name": "Malacca", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "malacca", "book_id": "origin_of_species_darwin_1859", "name": "Malacca", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Malacca"], "contexts": ["peninsula in Southeast Asia", "peninsula with plant distribution"]}, {"entity_id": "malacca", "book_id": "kosmos_humboldt_1845", "name": "Malacca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Malacca"], "contexts": ["peninsula mentioned in passage"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Malacca", "target_book": "kosmos_humboldt_1845", "target_name": "Malacca", "similarity": 0.89}], "id": 4554, "stable_key": "clu_77ab260ff5e4cfce-2", "ground_truth": {"modern_name": "Malabar Coast", "confidence": "high", "type": "place", "description": "Region in southwestern India.", "wikipedia_extract": "The Malabar Coast (Malayalam: [m\u0250l\u0250ba\u02d0r]) is the southwestern region of the Indian subcontinent. It generally refers to the western coastline of India stretching from Konkan to Kanyakumari. Geographically, it comprises one of the wettest regions of the subcontinent, which includes the southern tip of Goa, Kanara region of Karnataka, all of Kerala and Kanyakumari region of Tamil Nadu. Kuttanad, which is the point of the lowest elevation in India, lies on the Malabar Coast. Kuttanad, also known as The Rice Bowl of Kerala, is among the few places in the world where cultivation takes place below sea level. The peak of Anamudi, which is also the point of highest elevation in India outside the Himalayas, lies parallel to the Malabar Coast on the Western Ghats."}}, {"canonical_name": "Valenciennes", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "valenciennes", "book_id": "origin_of_species_darwin_1859", "name": "Valenciennes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Valenciennes"], "contexts": ["cited for fish adaptation to fresh water", "on fresh-water fish"]}, {"entity_id": "valenciennes", "book_id": "kosmos_humboldt_1845", "name": "Valenciennes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Valenciennes"], "contexts": ["naturalist"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Valenciennes", "target_book": "kosmos_humboldt_1845", "target_name": "Valenciennes", "similarity": 1.0}], "id": 4555, "stable_key": "clu_9605a3a1c9f4902e", "ground_truth": {"modern_name": "Achille Valenciennes", "confidence": "high", "type": "person", "birth_year": 1794, "death_year": 1863, "description": "French zoologist, specialized in ichthyology and carcinology.", "wikidata_id": "Q340257", "wikidata_description": "French zoologist, ichthyologist, and malacologist (1794\u20131865)", "wikipedia_url": "https://en.wikipedia.org/wiki/Achille%20Valenciennes", "wikipedia_extract": "Achille Valenciennes (9 August 1794 \u2013 13 April 1865) was a French zoologist. Valenciennes was born in Paris, and studied under Georges Cuvier. His study of parasitic worms in humans made an important contribution to the study of parasitology. He also carried out diverse systematic classifications, linking fossil and current species. He worked with Cuvier on the 22-volume \"Histoire Naturelle des Poissons\" (Natural History of Fish) (1828\u20131848), carrying on alone after Cuvier died in 1832. In 1832, he succeeded Henri Marie Ducrotay de Blainville (1777\u20131850) as chair of Histoire naturelle des mollusques, des vers et des zoophytes at the Mus\u00e9um national d'histoire naturelle."}}, {"canonical_name": "water-birds", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "water-birds", "book_id": "origin_of_species_darwin_1859", "name": "water-birds", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["water-birds"], "contexts": ["transport seeds of fresh-water plants", "birds adapted for water"]}, {"entity_id": "aquatic_birds", "book_id": "kosmos_humboldt_1845", "name": "aquatic birds", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["aquatic birds"], "contexts": ["birds frequenting river spots"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "water-birds", "target_book": "kosmos_humboldt_1845", "target_name": "aquatic birds", "similarity": 0.954}], "id": 4556, "stable_key": "clu_eea68cdec2772b1d", "ground_truth": {"modern_name": "Waterfowl", "confidence": "high", "type": "animal", "note": "The term 'water-birds' and 'aquatic birds' are synonymous and refer to birds that live on or near water.", "wikidata_id": "Q21651", "wikidata_description": "order of birds", "wikipedia_url": "https://en.wikipedia.org/wiki/Anseriformes", "wikipedia_extract": "Anseriformes is an order of birds   also known as waterfowl that comprises about 180 living species of birds in three families: Anhimidae (three species of screamers), Anseranatidae (the magpie goose), and Anatidae, the largest family, which includes over 170 species of waterfowl, among them the ducks, geese, and swans. Most modern species in the order are highly adapted for an aquatic existence at the water surface. With the exception of screamers, males have penises, a trait that has been lost in the Neoaves, the clade consisting of all other modern birds except the galliformes and paleognaths. Due to their aquatic nature, most species are web-footed. Anseriformes are one of only two types of modern bird to be confirmed present during the Mesozoic alongside the other dinosaurs, and in fact were among the very few birds to survive their extinction, along with their cousins, the Galliformes. These two groups only occupied two ecological niches during the Mesozoic, living in water and on the ground, while the toothed Enantiornithes were the dominant birds that ruled the trees and air."}}, {"canonical_name": "Potamogeton", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "potamogeton", "book_id": "origin_of_species_darwin_1859", "name": "Potamogeton", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Potamogeton"], "contexts": ["genus of aquatic plants", "aquatic plant genus"]}, {"entity_id": "potamoget\u00f3n", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Potamoget\u00f3n", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Potamoget\u00f3n"], "contexts": ["plant called Potamogeton by Greeks"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Potamogeton", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "Potamoget\u00f3n", "similarity": 0.976}], "id": 4557, "stable_key": "clu_69cc04b1bf55e3c5", "ground_truth": {"modern_name": "Pondweed", "confidence": "high", "type": "plant", "linnaean": "Potamogeton L.", "family": "Potamogetonaceae", "note": "Refers to the genus of aquatic plants known as pondweeds.", "wikidata_id": "Q161728", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Potamogeton"}}, {"canonical_name": "Robert Brown", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "robert_brown", "book_id": "origin_of_species_darwin_1859", "name": "Robert Brown", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Robert Brown"], "contexts": ["botanist quoted on organ importance", "botanist known for work on plant classification"]}, {"entity_id": "robert_brown", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Robert Brown", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Robert Brown"], "contexts": ["botanist who studied Australian vegetation"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Robert Brown", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Robert Brown", "similarity": 1.0}], "id": 4558, "stable_key": "clu_f9b98e9ed504c3f2-2", "ground_truth": {"modern_name": "Robert Brown", "confidence": "medium", "type": "person", "birth_year": 1773, "death_year": 1858, "description": "Scottish philosopher and geologist", "note": "The context 'cited in relation to Zaire expedition' might refer to the explorer Robert Brown, but 'author of Lectures on the Philosophy of the Human Mind' strongly points to the Scottish philosopher. Given the association with 'principles_of_psychology', the philosopher is the more likely referent. The text 'coloquios_da_orta_1563' seems misplaced for this identification."}}, {"canonical_name": "florets", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "florets", "book_id": "origin_of_species_darwin_1859", "name": "florets", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["florets"], "contexts": ["small flowers within a larger inflorescence", "male florets with rudimentary pistils"]}, {"entity_id": "floreci", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "floreci", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["floreci"], "contexts": ["little flowers white"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "florets", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "floreci", "similarity": 0.948}], "id": 4559, "stable_key": "clu_c13a8daef0d231b8", "ground_truth": {"modern_name": "Floret", "confidence": "high", "type": "plant", "note": "Refers to the small individual flowers that make up a larger inflorescence, a common botanical term.", "wikidata_id": "Q106358610", "wikidata_description": "family name"}}, {"canonical_name": "Negro", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "negro", "book_id": "origin_of_species_darwin_1859", "name": "Negro", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Negro"], "contexts": ["group of people mentioned in a hypothetical classification", "racial classification, referring to Black people"]}, {"entity_id": "negra", "book_id": "historia_medicinal_monardes_1574", "name": "negra", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["negra"], "contexts": ["black woman with old wounds"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Negro", "target_book": "historia_medicinal_monardes_1574", "target_name": "negra", "similarity": 0.966}], "id": 4560, "stable_key": "clu_8f74ad5c2698feef-2", "ground_truth": {"modern_name": "People of African descent", "confidence": "high", "type": "person", "description": "People of African descent, often used in historical colonial contexts.", "note": "The term 'negro'/'negra' is a historical term for people of African descent and can carry offensive connotations. The context of its usage in these early modern texts varies, sometimes referring to general populations, and other times to enslaved individuals or specific physical descriptions.", "wikidata_id": "Q99585672", "wikidata_description": "AHRC Research Grant (2017)"}}, {"canonical_name": "embryonic", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "embryonic", "book_id": "origin_of_species_darwin_1859", "name": "embryonic", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["embryonic"], "contexts": ["relating to early development", "relating to the early stage of development"]}, {"entity_id": "embryonic_mass", "book_id": "first_principles_spencer_1862", "name": "embryonic mass", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["embryonic mass"], "contexts": ["mass where intestine forms"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "embryonic", "target_book": "first_principles_spencer_1862", "target_name": "embryonic mass", "similarity": 0.906}], "id": 4561, "stable_key": "clu_b75ef70fe04208d1", "ground_truth": {"modern_name": "Embryonic", "confidence": "high", "type": "concept", "wikidata_id": "Q14820051", "wikidata_description": "the process whose specific outcome is the progression of an embryo from its formation until the end of its embryonic life stage. The end of the embryonic stage is organism-specific. For example, for mammals, the process would begin with zygote format", "wikipedia_url": "https://en.wikipedia.org/wiki/Embryonic%20development"}}, {"canonical_name": "Anagallis", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "anagallis", "book_id": "origin_of_species_darwin_1859", "name": "Anagallis", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Anagallis"], "contexts": ["genus of flowering plants", "sterility of"]}, {"entity_id": "anagallis", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Anagallis", "category": "PLANT", "subcategory": "HERB", "count": 1, "variants": ["Anagallis"], "contexts": ["herb with similar leaves"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Anagallis", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "Anagallis", "similarity": 0.768}], "id": 4562, "stable_key": "clu_fd074fbc132866ea", "ground_truth": {"modern_name": "Pimpernel", "confidence": "high", "type": "plant", "linnaean": "Anagallis L.", "family": "Primulaceae", "note": "Refers to the genus of flowering plants known as pimpernels.", "wikidata_id": "Q157732", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Anagallis"}}, {"canonical_name": "cultivated plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cultivated_plants", "book_id": "origin_of_species_darwin_1859", "name": "cultivated plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cultivated plants"], "contexts": ["plants grown by humans"]}, {"entity_id": "cultivated_plant", "book_id": "first_principles_spencer_1862", "name": "cultivated plant", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cultivated plant"], "contexts": ["plant grown by humans"]}, {"entity_id": "cultivated_plants", "book_id": "first_principles_spencer_1862", "name": "cultivated plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cultivated plants"], "contexts": ["plants grown by humans"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "cultivated plants", "target_book": "first_principles_spencer_1862", "target_name": "cultivated plant", "similarity": 0.972}, {"source_book": "origin_of_species_darwin_1859", "source_name": "cultivated plants", "target_book": "first_principles_spencer_1862", "target_name": "cultivated plants", "similarity": 1.0}], "id": 4563, "stable_key": "clu_9a41d7a546d0e9c2", "ground_truth": {"modern_name": "cultivated plants", "confidence": "high", "type": "plant", "wikidata_id": "Q2988930", "wikidata_description": "study of the theory and practice of the science that identifies, describes, classifies, and names cultigens\u2014those plants whose origin or selection is primarily due to intentional human activity;one part of the study of horticultural botany", "wikipedia_url": "https://en.wikipedia.org/wiki/Cultivated%20plant%20taxonomy", "wikipedia_extract": "Cultivated plant taxonomy is the study of the theory and practice of the science that identifies, describes, classifies, and names cultigens\u2014those plants whose origin or selection is primarily due to intentional human activity. Cultivated plant taxonomists do, however, work with all kinds of plants in cultivation. Cultivated plant taxonomy is one part of the study of horticultural botany which is mostly carried out in botanical gardens, large nurseries, universities, or government departments. Areas of special interest for the cultivated plant taxonomist include: searching for and recording new plants suitable for cultivation (plant hunting); communicating with and advising the general public on matters concerning the classification and nomenclature of cultivated plants and carrying out original research on these topics; describing the cultivated plants of particular regions (horticultural floras); maintaining databases, herbaria and other information about cultivated plants. Much of the work of the cultivated plant taxonomist is concerned with the naming of plants as prescribed by two plant nomenclatural Codes. The provisions of the International Code of Nomenclature for algae, fungi, and plants (Botanical Code) serve primarily scientific ends and the objectives of the scientific community, while those of the International Code of Nomenclature for Cultivated Plants (Cultivated Plant Code) are designed to serve both scientific and utilitarian ends by making provision for the names of plants used in commerce\u2014the cultigens that have arisen in agriculture, forestry and horticulture."}}, {"canonical_name": "Horner", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "horner", "book_id": "origin_of_species_darwin_1859", "name": "Horner", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Horner"], "contexts": ["researcher on ancient Egyptian civilization"]}, {"entity_id": "horner", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Horner", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Horner"], "contexts": ["observers on Krusenstern's voyage", "early modern scholar"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Horner", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Horner", "similarity": 1.0}], "id": 4564, "stable_key": "clu_0f35ac2f994b6452", "ground_truth": {"modern_name": "Johann Friedrich Horner", "confidence": "medium", "type": "person", "birth_year": 1774, "death_year": 1834, "description": "Swiss ophthalmologist and surgeon, known for Horner's syndrome.", "note": "Multiple individuals named Horner existed. Johann Friedrich Horner is a plausible, but not definitive, match given the historical context.", "wikidata_id": "Q123315", "wikidata_description": "Swiss ophthalmologist (1831-1886)", "wikipedia_url": "https://en.wikipedia.org/wiki/Johann%20Friedrich%20Horner", "wikipedia_extract": "Johann Friedrich Horner (27 March 1831 \u2013 20 December 1886) was an ophthalmologist based at the University of Zurich, Switzerland. Horner was born in Zurich. After receiving his medical degree from the University of Zurich in 1854, he continued his studies in Vienna, where he learned ophthalmoscopy from Eduard J\u00e4ger von Jaxtthal (1818\u20131884), and in Berlin, where he served as an assistant to ophthalmologist Albrecht von Graefe (1828\u20131870). It was during this time that Horner decided to become an ophthalmologist himself. He returned to Zurich in 1856, and later opened his own eye clinic named \"Hottinghof\". Horner became a full professor of ophthalmology in 1873."}}, {"canonical_name": "bones of the face", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "bones_of_the_face", "book_id": "origin_of_species_darwin_1859", "name": "bones of the face", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bones of the face"], "contexts": ["skeletal structures of the facial region"]}, {"entity_id": "facial_bones", "book_id": "first_principles_spencer_1862", "name": "facial bones", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["facial bones"], "contexts": ["bones of the face"]}, {"entity_id": "muscles_of_the_face", "book_id": "first_principles_spencer_1862", "name": "muscles of the face", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["muscles of the face"], "contexts": ["facial musculature"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "bones of the face", "target_book": "first_principles_spencer_1862", "target_name": "facial bones", "similarity": 0.971}, {"source_book": "origin_of_species_darwin_1859", "source_name": "bones of the face", "target_book": "first_principles_spencer_1862", "target_name": "muscles of the face", "similarity": 0.917}], "id": 4565, "stable_key": "clu_003b3d81f1513cf2", "ground_truth": {"modern_name": "facial bones", "confidence": "high", "type": "concept", "wikidata_id": "Q1068553", "wikidata_description": "consists of a part of the skull that is derived from the pharyngeal arches", "wikipedia_url": "https://en.wikipedia.org/wiki/Facial%20skeleton", "wikipedia_extract": "The facial skeleton comprises the facial bones that may attach to build a portion of the skull. The remainder of the skull is the neurocranium. In human anatomy and development, the facial skeleton is sometimes called the membranous viscerocranium, which comprises the mandible and dermatocranial elements that are not part of the braincase. In the human skull, the facial skeleton consists of fourteen bones in the face: Elements of the cartilaginous viscerocranium (i.e., splanchnocranial elements), such as the hyoid bone, are sometimes considered part of the facial skeleton. The ethmoid bone (or a part of it) and also the sphenoid bone are sometimes included, but otherwise considered part of the neurocranium. Because the maxillary bones are fused, they are often collectively listed as only one bone."}}, {"canonical_name": "disposition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "disposition", "book_id": "origin_of_species_darwin_1859", "name": "disposition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["disposition"], "contexts": ["temperament or character"]}, {"entity_id": "disposition", "book_id": "principles_of_psychology_james_1890", "name": "disposition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["disposition"], "contexts": ["a person's inherent qualities of mind and character", "person's inherent qualities of mind"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "disposition", "target_book": "principles_of_psychology_james_1890", "target_name": "disposition", "similarity": 1.0}], "id": 4566, "stable_key": "clu_bad284da69dbfbf1", "ground_truth": {"modern_name": "disposition", "confidence": "high", "type": "concept"}}, {"canonical_name": "Turan", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "turan", "book_id": "origin_of_species_darwin_1859", "name": "Turan", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Turan"], "contexts": ["region sending rare birds"]}, {"entity_id": "turan", "book_id": "kosmos_humboldt_1845", "name": "Turan", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Turan"], "contexts": ["region giving name to a race", "region named after a race"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Turan", "target_book": "kosmos_humboldt_1845", "target_name": "Turan", "similarity": 1.0}], "id": 4567, "stable_key": "clu_c738781dad31db23", "ground_truth": {"modern_name": "Tur\u00e1n", "confidence": "high", "type": "place", "country": "Uzbekistan, Kazakhstan, Turkmenistan, Iran, Afghanistan", "note": "Turan is a historical and geographical region in Central Asia, often associated with Turkic peoples. Its inclusion in scientific texts like Darwin's and Humboldt's suggests a reference to its geography or the species originating from it."}}, {"canonical_name": "dray and race horse", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "dray_and_race_horse", "book_id": "origin_of_species_darwin_1859", "name": "dray and race horse", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["dray and race horse"], "contexts": ["different breeds of horse"]}, {"entity_id": "dray-horse", "book_id": "origin_of_species_darwin_1859", "name": "dray-horse", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["dray-horse"], "contexts": ["breed of horse"]}, {"entity_id": "dray-horses", "book_id": "principles_of_psychology_james_1890", "name": "dray-horses", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["dray-horses"], "contexts": ["working horses"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "dray and race horse", "target_book": "principles_of_psychology_james_1890", "target_name": "dray-horses", "similarity": 0.912}, {"source_book": "origin_of_species_darwin_1859", "source_name": "dray-horse", "target_book": "principles_of_psychology_james_1890", "target_name": "dray-horses", "similarity": 0.963}], "id": 4568, "stable_key": "clu_81fc6756efc92630", "ground_truth": {"modern_name": "Horses", "confidence": "high", "type": "animal", "note": "Covers various breeds of horses, including those used for work (dray) and sport (race).", "wikidata_id": "Q726", "wikidata_description": "domesticated four-footed mammal from the equine family", "wikipedia_url": "https://en.wikipedia.org/wiki/Horse", "wikipedia_extract": "The horse (Equus ferus caballus) is a domesticated, one-toed, hoofed mammal. It belongs to the taxonomic family Equidae and is one of two extant subspecies of Equus ferus. The horse has evolved over the past 45 to 55 million years from a small multi-toed creature, Eohippus, into the large single-toed animal of today, originally in North America. Humans began domesticating horses around 4000 BCE in Central Asia, and their domestication is believed to have been widespread by 3000 BCE. Horses in the subspecies caballus are domesticated, although some domesticated populations live in the wild as feral horses. These feral populations are not true wild horses, which are horses that have never been domesticated."}}, {"canonical_name": "young", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "young", "book_id": "origin_of_species_darwin_1859", "name": "young", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["young"], "contexts": ["offspring of animals"]}, {"entity_id": "young_animals", "book_id": "principles_of_psychology_james_1890", "name": "young animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["young animals"], "contexts": ["immature animal subjects"]}, {"entity_id": "young", "book_id": "principles_of_psychology_james_1890", "name": "young", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["young"], "contexts": ["species interested in its own young"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "young", "target_book": "principles_of_psychology_james_1890", "target_name": "young animals", "similarity": 0.954}, {"source_book": "origin_of_species_darwin_1859", "source_name": "young", "target_book": "principles_of_psychology_james_1890", "target_name": "young", "similarity": 1.0}], "id": 4569, "stable_key": "clu_4fabc65b2404d9c9", "ground_truth": {"modern_name": "Young animal", "confidence": "high", "type": "animal", "note": "Refers to immature individuals of animal species.", "wikidata_id": "Q11345409", "wikidata_description": ""}}, {"canonical_name": "drought", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "drought", "book_id": "origin_of_species_darwin_1859", "name": "drought", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["drought"], "contexts": ["prolonged period of abnormally low rainfall"]}, {"entity_id": "drought", "book_id": "first_principles_spencer_1862", "name": "drought", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["drought"], "contexts": ["prolonged period of abnormally low rainfall"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "drought", "target_book": "first_principles_spencer_1862", "target_name": "drought", "similarity": 1.0}], "id": 4570, "stable_key": "clu_6f08b9a81e11097a", "ground_truth": {"modern_name": "Drought", "confidence": "high", "type": "concept", "note": "Drought is a meteorological phenomenon, not a disease, but can have severe consequences for living organisms.", "wikidata_id": "Q12142810", "wikidata_description": "the ability to which a plant maintains its biomass production during arid or drought conditions", "wikipedia_url": "https://en.wikipedia.org/wiki/Drought%20tolerance", "wikipedia_extract": "In botany, drought tolerance is the ability by which a plant maintains its biomass production during arid or drought conditions. Some plants are naturally adapted to dry conditions, surviving with protection mechanisms such as desiccation tolerance, detoxification, or repair of xylem embolism. Other plants, specifically crops like corn, wheat, and rice, have become increasingly tolerant to drought with new varieties created via genetic engineering. From an evolutionary perspective, the type of mycorrhizal associations formed in the roots of plants can determine how fast plants can adapt to drought. The plants behind drought tolerance are complex and involve many pathways which allows plants to respond to specific sets of conditions at any given time. Some of these interactions include stomatal conductance, carotenoid degradation and anthocyanin accumulation, the intervention of osmoprotectants (such as sucrose, glycine, and proline), ROS-scavenging enzymes."}}, {"canonical_name": "tropical climates", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tropical_climate", "book_id": "origin_of_species_darwin_1859", "name": "tropical climate", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["tropical climate"], "contexts": ["climate near the equator"]}, {"entity_id": "tropical_climates", "book_id": "kosmos_humboldt_1845", "name": "tropical climates", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["tropical climates"], "contexts": ["regions with high temperatures", "climates with shallow invariable temperature stratum"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "tropical climate", "target_book": "kosmos_humboldt_1845", "target_name": "tropical climates", "similarity": 0.98}], "id": 4571, "stable_key": "clu_64eba7a2fd8d9004-3", "ground_truth": {"modern_name": "Tropics", "confidence": "high", "type": "place", "country": "Global", "wikidata_id": "Q42530", "wikidata_description": "region of the Earth surrounding the equator", "wikipedia_url": "https://en.wikipedia.org/wiki/Tropics", "wikipedia_extract": "The tropics are the region of Earth surrounding the equator, where the Sun may shine directly overhead. This contrasts with the temperate or polar regions of Earth, where the Sun can never be directly overhead. Because of Earth's axial tilt, the width of the tropics (in latitude) is twice the tilt. The tropics are also referred to as the tropical zone and the torrid zone (see geographical zone). Due to the sun's high angle throughout the year, the tropics receive the most solar energy over the course of the year, and consequently have the highest temperatures on the planet. Even when not directly overhead, the sun is still close to overhead throughout the year, therefore the tropics also have the lowest seasonal variation on the planet; \"winter\" and \"summer\" lose their temperature contrast."}}, {"canonical_name": "Herr M.", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mr__h__c_", "book_id": "origin_of_species_darwin_1859", "name": "Mr. H. C.", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Mr. H. C."], "contexts": ["made analogous observations"]}, {"entity_id": "herr_m_", "book_id": "principles_of_psychology_james_1890", "name": "Herr M.", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Herr M.", "M."], "contexts": ["described head-muscle tightening", "describes tightening of head-muscles"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Mr. H. C.", "target_book": "principles_of_psychology_james_1890", "target_name": "Herr M.", "similarity": 0.93}], "id": 4572, "stable_key": "clu_d5d9c1cc17616213", "ground_truth": {"modern_name": "Herr M.", "confidence": "low", "type": "person", "description": "Individual whose observations were cited in scientific texts", "note": "Likely a pseudonym or abbreviation, precise identity is not determinable from the provided context.", "wikidata_id": "Q55023302", "wikidata_description": "operatic character in the opera Neues vom Tage by Paul Hindemith"}}, {"canonical_name": "Falklands", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "falklands", "book_id": "origin_of_species_darwin_1859", "name": "Falklands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Falklands"], "contexts": ["southern location for rodents"]}, {"entity_id": "falkland_island", "book_id": "origin_of_species_darwin_1859", "name": "Falkland Island", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Falkland Island"], "contexts": ["geographic location"]}, {"entity_id": "falkland_islands", "book_id": "kosmos_humboldt_1845", "name": "Falkland Islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Falkland Islands"], "contexts": ["alternative name for Malouines"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Falklands", "target_book": "kosmos_humboldt_1845", "target_name": "Falkland Islands", "similarity": 0.959}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Falkland Island", "target_book": "kosmos_humboldt_1845", "target_name": "Falkland Islands", "similarity": 0.989}], "id": 4573, "stable_key": "clu_d05ccdb867dabe86", "ground_truth": {"modern_name": "Falkland Islands", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q5535263", "wikidata_description": "Overview of the geography of the Falkland Islands"}}, {"canonical_name": "atmosph\u00e9re tropicale", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "atmosph\u00e9re_tropicale", "book_id": "relation_historique_humboldt_vol3_1825", "name": "atmosph\u00e9re tropicale", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["atmosph\u00e9re tropicale", "zone tropicale"], "contexts": ["air in the tropics", "region around the equator"]}, {"entity_id": "tropical_climate", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tropical climate", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tropical climate"], "contexts": ["climate suitable for tropical plants"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "atmosph\u00e9re tropicale", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tropical climate", "similarity": 0.924}], "id": 4574, "stable_key": "clu_14481ee3a155cd63", "ground_truth": {"modern_name": "tropical climate", "confidence": "high", "type": "concept", "wikidata_id": "Q135712", "wikidata_description": "climate in the tropical region", "wikipedia_url": "https://en.wikipedia.org/wiki/Tropical%20climate", "wikipedia_extract": "Tropical climate is the first of the five major climate groups in the K\u00f6ppen climate classification identified with the letter A. Tropical climates are defined by a monthly average temperature of 18 \u00b0C (64 \u00b0F) or higher in the coolest month, featuring hot temperatures and high humidity all year-round. Annual precipitation is often abundant in tropical climates, and shows a seasonal rhythm but may have seasonal dryness to varying degrees. There are normally only two seasons in tropical climates, a wet (rainy/monsoon) season and a dry season. The annual temperature range in tropical climates is normally very small. Sunlight is intense in these climates."}}, {"canonical_name": "homology", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "homology", "book_id": "origin_of_species_darwin_1859", "name": "homology", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["homology"], "contexts": ["similarity due to shared ancestry"]}, {"entity_id": "homologies", "book_id": "origin_of_species_darwin_1859", "name": "homologies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["homologies"], "contexts": ["similarities due to shared ancestry"]}, {"entity_id": "homologies", "book_id": "first_principles_spencer_1862", "name": "homologies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["homologies"], "contexts": ["structural similarities between species"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "homology", "target_book": "first_principles_spencer_1862", "target_name": "homologies", "similarity": 0.912}, {"source_book": "origin_of_species_darwin_1859", "source_name": "homologies", "target_book": "first_principles_spencer_1862", "target_name": "homologies", "similarity": 1.0}], "id": 4575, "stable_key": "clu_f068a0813701e7ee", "ground_truth": {"modern_name": "homology", "confidence": "high", "type": "concept", "wikidata_id": "Q5891438", "wikidata_description": "when two concepts are separated by time but share similarities", "wikipedia_url": "https://en.wikipedia.org/wiki/Homology%20%28anthropology%29"}}, {"canonical_name": "Western China", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "eastern_china", "book_id": "origin_of_species_darwin_1859", "name": "Eastern China", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Eastern China"], "contexts": ["Eastern China"]}, {"entity_id": "western_china", "book_id": "kosmos_humboldt_1845", "name": "Western China", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Western China"], "contexts": ["region where meteorite fell", "geographic location"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Eastern China", "target_book": "kosmos_humboldt_1845", "target_name": "Western China", "similarity": 0.896}], "id": 4576, "stable_key": "clu_34d0d9eb2be4f69c-3", "ground_truth": {"modern_name": "China", "confidence": "high", "type": "place", "country": "China", "wikidata_id": "Q148", "wikidata_description": "country in East Asia", "wikipedia_url": "https://en.wikipedia.org/wiki/Demographics_of_China", "wikipedia_extract": "The People's Republic of China is the second most-populous country in the world with a population exceeding 1.4 billion, only surpassed by India. China was the world's most populous country until being surpassed by India in 2023. In 2025, China's population officially stood at 1.404 billion, which was three million less than the previous year, with the lowest recorded birthrate since at least the proclamation of the People's Republic of China in 1949. China's population has a relatively small youth component, partially a result of the strict enforcement of China's one-child policy that was in effect from 1979 until 2015, which limited urban families to one child and rural families to two. As of 2022, Chinese state media reported the country's total fertility rate to be 1.09, one of the lowest in the world alongside South Korea, Taiwan, Hong Kong and Singapore. Since 2022, deaths have outstripped births in the country.", "description": "Country of origin for various plants, spices, and historical goods."}}, {"canonical_name": "transition formations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "transitional_forms", "book_id": "origin_of_species_darwin_1859", "name": "transitional forms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["transitional forms"], "contexts": ["intermediate evolutionary stages"]}, {"entity_id": "transition_formations", "book_id": "kosmos_humboldt_1845", "name": "transition formations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["transition formations"], "contexts": ["geological formation designation", "geological time period"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "transitional forms", "target_book": "kosmos_humboldt_1845", "target_name": "transition formations", "similarity": 0.923}], "id": 4577, "stable_key": "clu_767664ab93b2fbc0", "ground_truth": {"modern_name": "transitional forms", "confidence": "high", "type": "concept", "wikidata_id": "Q28744670", "wikidata_description": "scientific article (publication date: 22 November 2011)"}}, {"canonical_name": "fore-arm", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "fore-arm", "book_id": "origin_of_species_darwin_1859", "name": "fore-arm", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["fore-arm"], "contexts": ["part of the arm"]}, {"entity_id": "forearm", "book_id": "origin_of_species_darwin_1859", "name": "forearm", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["forearm"], "contexts": ["part of the arm below the elbow"]}, {"entity_id": "forearm", "book_id": "principles_of_psychology_james_1890", "name": "forearm", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["forearm"], "contexts": ["part of arm involved in piano playing"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "fore-arm", "target_book": "principles_of_psychology_james_1890", "target_name": "forearm", "similarity": 0.93}, {"source_book": "origin_of_species_darwin_1859", "source_name": "forearm", "target_book": "principles_of_psychology_james_1890", "target_name": "forearm", "similarity": 1.0}], "id": 4578, "stable_key": "clu_ae1edb4a3397d4fa", "ground_truth": {"modern_name": "forearm", "confidence": "high", "type": "concept", "wikidata_id": "Q228537", "wikidata_description": "region of the upper limb between the elbow and the wrist"}}, {"canonical_name": "hind-legs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "hind-legs", "book_id": "origin_of_species_darwin_1859", "name": "hind-legs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["hind-legs"], "contexts": ["legs at the back"]}, {"entity_id": "hind_legs", "book_id": "principles_of_psychology_james_1890", "name": "hind legs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["hind legs"], "contexts": ["rear limbs of an animal"]}, {"entity_id": "hind_foot", "book_id": "principles_of_psychology_james_1890", "name": "hind foot", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["hind foot"], "contexts": ["foot of the rear limb"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "hind-legs", "target_book": "principles_of_psychology_james_1890", "target_name": "hind legs", "similarity": 0.987}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hind-legs", "target_book": "principles_of_psychology_james_1890", "target_name": "hind foot", "similarity": 0.92}], "id": 4579, "stable_key": "clu_0420081221170247", "ground_truth": {"modern_name": "Hind limbs", "confidence": "high", "type": "concept", "wikidata_id": "Q5766112", "wikidata_description": "in animal anatomy", "wikipedia_url": "https://en.wikipedia.org/wiki/Hindlimb", "wikipedia_extract": "A hindlimb or back limb is one of the paired articulated appendages (limbs) attached on the caudal (posterior) end of a terrestrial tetrapod vertebrate's torso. With reference to quadrupeds, the term hindleg or back leg is often used instead. In bipedal animals with an upright posture (e.g. humans and some primates), the term lower limb is often used. It is located on the limb of an animal. Hindlimbs are present in a large number of quadrupeds."}}, {"canonical_name": "Mollusks", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mollusca", "book_id": "origin_of_species_darwin_1859", "name": "Mollusca", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Mollusca"], "contexts": ["water-breathing classes adapted to land"]}, {"entity_id": "mollusks", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mollusks", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Mollusks"], "contexts": ["animals of shells", "distinct species of"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Mollusca", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mollusks", "similarity": 0.959}], "id": 4580, "stable_key": "clu_36288d7aba1ba529-2", "ground_truth": {"modern_name": "Mollusks", "confidence": "high", "type": "animal", "description": "Invertebrate animals with soft bodies, often protected by a shell.", "wikipedia_extract": "Mollusca is a phylum of protostomic invertebrate animals, whose members are known as molluscs or mollusks (). 86,600 extant species of molluscs are recognized, making it the second-largest animal phylum after Arthropoda. The number of additional fossil species is estimated between 60,000 and 100,000, and the proportion of undescribed species is very high. Many taxa remain poorly studied. Molluscs are the largest marine phylum, comprising about 23% of all the named marine organisms. They are highly diverse, not just in size and anatomical structure, but also in behavior and habitat, as numerous groups are freshwater and even terrestrial species. The phylum is typically divided into 7 or 8 taxonomic classes, of which two are entirely extinct."}}, {"canonical_name": "alimentary canal", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "alimentary_canal", "book_id": "origin_of_species_darwin_1859", "name": "alimentary canal", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["alimentary canal"], "contexts": ["tube for digestion and excretion"]}, {"entity_id": "alimentary_canal", "book_id": "first_principles_spencer_1862", "name": "alimentary canal", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["alimentary canal"], "contexts": ["development from mucous layer", "upper portion developing lungs"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "alimentary canal", "target_book": "first_principles_spencer_1862", "target_name": "alimentary canal", "similarity": 1.0}], "id": 4581, "stable_key": "clu_190599d239958141-2", "ground_truth": {"modern_name": "Digestive system", "confidence": "high", "type": "concept", "wikidata_id": "Q2300099", "wikidata_description": "disease involving the gastrointestinal tract", "wikipedia_url": "https://en.wikipedia.org/wiki/Gastrointestinal%20disease", "wikipedia_extract": "Gastrointestinal diseases (abbrev. GI diseases or GI illnesses) refer to diseases involving the gastrointestinal tract, namely the esophagus, stomach, small intestine, large intestine and rectum; and the accessory organs of digestion, the liver, gallbladder, and pancreas. The oral cavity is part of the gastrointestinal system and as such the presence of alterations in this district can be the first sign of both systemic and gastrointestinal diseases. By far the most common oral conditions are plaque-induced diseases (e.g., gingivitis, periodontitis, dental caries). Oral symptoms can be similar to lesions occurring elsewhere in the digestive tract, with a pattern of swelling, inflammation, ulcers, and fissures. If these signs are present, then patients are more likely to also have anal and esophageal lesions and experience other extra-intestinal disease manifestations.", "note": "Refers to the anatomical and functional system responsible for digestion."}}, {"canonical_name": "hind-limb", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "hind_limbs", "book_id": "origin_of_species_darwin_1859", "name": "hind limbs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["hind limbs"], "contexts": ["affected by exercising in mountains"]}, {"entity_id": "hind-limb", "book_id": "principles_of_psychology_james_1890", "name": "hind-limb", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["hind-limb"], "contexts": ["rear limb of an animal", "rear leg of an animal"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "hind limbs", "target_book": "principles_of_psychology_james_1890", "target_name": "hind-limb", "similarity": 0.924}], "id": 4582, "stable_key": "clu_0420081221170247-2", "ground_truth": {"modern_name": "Hind limbs", "confidence": "high", "type": "concept", "wikidata_id": "Q5766112", "wikidata_description": "in animal anatomy", "wikipedia_url": "https://en.wikipedia.org/wiki/Hindlimb", "wikipedia_extract": "A hindlimb or back limb is one of the paired articulated appendages (limbs) attached on the caudal (posterior) end of a terrestrial tetrapod vertebrate's torso. With reference to quadrupeds, the term hindleg or back leg is often used instead. In bipedal animals with an upright posture (e.g. humans and some primates), the term lower limb is often used. It is located on the limb of an animal. Hindlimbs are present in a large number of quadrupeds."}}, {"canonical_name": "subsistence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "subsistence", "book_id": "origin_of_species_darwin_1859", "name": "subsistence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["subsistence"], "contexts": ["struggle for survival"]}, {"entity_id": "subsistence", "book_id": "first_principles_spencer_1862", "name": "subsistence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["subsistence"], "contexts": ["means of maintaining life", "means of supporting life"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "subsistence", "target_book": "first_principles_spencer_1862", "target_name": "subsistence", "similarity": 1.0}], "id": 4583, "stable_key": "clu_ebde03a8e3388124", "ground_truth": {"modern_name": "Subsistence", "confidence": "high", "type": "concept", "note": "In these contexts, it refers to the ability of an organism to maintain its existence and to reproduce.", "wikidata_id": "Q2787508", "wikidata_description": "farming which meets the basic needs of the farmer and family", "wikipedia_extract": "The iron law of wages is a proposed law of economics that asserts that real wages always tend, in the long run, toward the minimum wage necessary to sustain the life of the worker. The theory was first named by Ferdinand Lassalle in the mid-nineteenth century. Karl Marx and Friedrich Engels attribute the doctrine to Lassalle (notably in Marx's 1875 Critique of the Gotha Program), the idea to Thomas Malthus's (1798) An Essay on the Principle of Population, and the terminology to Goethe's \"great, eternal iron laws\" in Das G\u00f6ttliche. It was coined in reference to the views of classical economists such as David Ricardo's law of rent, and the competing population theory of Thomas Malthus. It held that the market price of labor (which tends toward the minimum required for the subsistence of the laborers) would always, or almost always, reduce as the working population increased and vice versa. Ricardo believed that this happened only under particular conditions.", "wikipedia_url": "https://en.wikipedia.org/wiki/Iron_law_of_wages"}}, {"canonical_name": "ichneumon", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ichneumon", "book_id": "origin_of_species_darwin_1859", "name": "ichneumon", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["ichneumon"], "contexts": ["insect with an ovipositor"]}, {"entity_id": "ichneumon", "book_id": "coloquios_da_orta_1563", "name": "ichneumon", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["ichneumon", "Ichneumon"], "contexts": ["name used in some books for the animal", "animal name"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "ichneumon", "target_book": "coloquios_da_orta_1563", "target_name": "ichneumon", "similarity": 0.862}], "id": 4584, "stable_key": "clu_fb51831329bfc07e", "ground_truth": {"modern_name": "Ichneumon wasp", "confidence": "high", "type": "animal", "note": "The 'ichneumon' in early modern texts could refer to several animals, but in the context of insect anatomy (ovipositor) and biological discussions, the ichneumon wasp (family Ichneumonidae) is the most likely referent.", "wikidata_id": "Q1138186", "wikidata_description": "family of insects"}}, {"canonical_name": "queen-bee", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "queen-bee", "book_id": "origin_of_species_darwin_1859", "name": "queen-bee", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["queen-bee"], "contexts": ["fertile female bee"]}, {"entity_id": "queen_bee", "book_id": "origin_of_species_darwin_1859", "name": "queen bee", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["queen bee"], "contexts": ["fertile female bee in a colony"]}, {"entity_id": "queen-bee", "book_id": "first_principles_spencer_1862", "name": "queen-bee", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["queen-bee"], "contexts": ["reproductive female bee"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "queen-bee", "target_book": "first_principles_spencer_1862", "target_name": "queen-bee", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "queen bee", "target_book": "first_principles_spencer_1862", "target_name": "queen-bee", "similarity": 0.986}], "id": 4585, "stable_key": "clu_654c260d1e8e84df", "ground_truth": {"modern_name": "Queen bee", "confidence": "high", "type": "animal", "wikidata_id": "Q770569", "wikidata_description": "German comedy musical group", "wikipedia_extract": "A queen bee is typically an adult, mated female (gyne) that lives in a colony or hive of honey bees. With fully developed reproductive organs, the queen is usually the mother of most, if not all, of the bees in the beehive. Queens are developed from larvae selected by worker bees and specially fed in order to become sexually mature. There is normally only one adult, mated queen in a hive, in which case the bees will usually follow and fiercely protect her. The term \"queen bee\" can be more generally applied to any dominant reproductive female in a colony of a eusocial bee species other than honey bees. However, as in the Brazilian stingless bee (Schwarziana quadripunctata), a single nest may have multiple queens or even dwarf queens, ready to replace a dominant queen in case of a sudden death.", "wikipedia_url": "https://de.wikipedia.org/wiki/Queen_Bee"}}, {"canonical_name": "mental actions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mental_actions", "book_id": "origin_of_species_darwin_1859", "name": "mental actions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mental actions"], "contexts": ["operations of the mind"]}, {"entity_id": "mental_action", "book_id": "first_principles_spencer_1862", "name": "mental action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mental action"], "contexts": ["activity of the mind"]}, {"entity_id": "mental_actions", "book_id": "first_principles_spencer_1862", "name": "mental actions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mental actions"], "contexts": ["processes of the mind"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "mental actions", "target_book": "first_principles_spencer_1862", "target_name": "mental action", "similarity": 0.964}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mental actions", "target_book": "first_principles_spencer_1862", "target_name": "mental actions", "similarity": 1.0}], "id": 4586, "stable_key": "clu_1bb98608b421eea6", "ground_truth": {"modern_name": "Mental processes", "confidence": "high", "type": "concept", "wikidata_id": "Q127877018", "wikidata_description": "scholarly article"}}, {"canonical_name": "process", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "process", "book_id": "origin_of_species_darwin_1859", "name": "process", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["process"], "contexts": ["series of actions or steps"]}, {"entity_id": "processes", "book_id": "principles_of_psychology_james_1890", "name": "processes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["processes"], "contexts": ["activities within the brain"]}, {"entity_id": "process", "book_id": "principles_of_psychology_james_1890", "name": "process", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["process"], "contexts": ["neural activity or function"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "process", "target_book": "principles_of_psychology_james_1890", "target_name": "processes", "similarity": 0.853}, {"source_book": "origin_of_species_darwin_1859", "source_name": "process", "target_book": "principles_of_psychology_james_1890", "target_name": "process", "similarity": 1.0}], "id": 4587, "stable_key": "clu_53ed9faba9caa23e", "ground_truth": {"modern_name": "process", "confidence": "high", "type": "concept", "wikidata_id": "Q6661985", "wikidata_description": "any process that uses a computer program to enter data and summarise, analyse or otherwise convert data into usable information", "wikipedia_url": "https://en.wikipedia.org/wiki/Data%20processing", "wikipedia_extract": "Data processing is the collection and manipulation of digital data to produce meaningful information. Data processing is a form of information processing, which is the modification (processing) of information in any manner detectable by an observer. Data processing may involve various processes, including: Validation \u2013 Ensuring that supplied data is correct and relevant. Sorting \u2013 \"arranging items in some sequence and/or in different sets.\" Summarization (statistical) or (automatic) \u2013 reducing detailed data to its main points. Aggregation \u2013 combining multiple pieces of data. Analysis \u2013 the \"collection, organization, analysis, interpretation and presentation of data.\" Reporting \u2013 list detail or summary data or computed information."}}, {"canonical_name": "union", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "union", "book_id": "origin_of_species_darwin_1859", "name": "union", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["union"], "contexts": ["joining of reproductive cells"]}, {"entity_id": "union", "book_id": "first_principles_spencer_1862", "name": "union", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["union"], "contexts": ["the act of joining together", "act of joining together"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "union", "target_book": "first_principles_spencer_1862", "target_name": "union", "similarity": 1.0}], "id": 4588, "stable_key": "clu_9256c793a7846e12", "ground_truth": {"modern_name": "union", "confidence": "high", "type": "concept", "wikidata_id": "Q178790", "wikidata_description": "organization of workers with common goals", "wikipedia_url": "https://en.wikipedia.org/wiki/Trade%20union", "wikipedia_extract": "A trade union (British English) or labor union (American English), often simply referred to as a union, is an organization of workers whose purpose is to maintain or improve the conditions of their employment, such as attaining better wages and benefits, improving working conditions and safety standards, establishing complaint procedures, developing rules governing the status of employees (including rules on promotions and just-cause conditions for termination), and protecting and increasing the bargaining power of workers. Trade unions typically fund their head office and legal team functions through regularly imposed fees called union dues. The union representatives in the workforce are usually made up of workplace volunteers who are often appointed by members through internal democratic elections. The trade union, through an elected leadership and bargaining committee, bargains with the employer on behalf of its members, known as the rank and file, and negotiates labour contracts (collective bargaining agreements) with employers. Unions may organize a particular section of skilled or unskilled workers (craft unionism), a cross-section of workers from various trades (general unionism), or an attempt to organize all workers within a particular industry (industrial unionism). The agreements negotiated by a union are binding on the rank-and-file members and the employer, and in some cases on other non-member workers."}}, {"canonical_name": "North Cape", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "north_cape", "book_id": "origin_of_species_darwin_1859", "name": "North Cape", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["North Cape"], "contexts": ["northernmost point of mainland Europe"]}, {"entity_id": "north_cape", "book_id": "kosmos_humboldt_1845", "name": "North Cape", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["North Cape"], "contexts": ["location of Lotur and Bravais", "northernmost point of mainland Europe"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "North Cape", "target_book": "kosmos_humboldt_1845", "target_name": "North Cape", "similarity": 1.0}], "id": 4589, "stable_key": "clu_a89f7ca041d3c234", "ground_truth": {"modern_name": "North Cape", "confidence": "high", "type": "place", "country": "Norway", "wikidata_id": "Q4069", "wikidata_description": "cape on the island of Mager\u00f8ya in Northern Norway"}}, {"canonical_name": "terrestrial", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "terrestrial", "book_id": "origin_of_species_darwin_1859", "name": "terrestrial", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["terrestrial"], "contexts": ["relating to land"]}, {"entity_id": "terrestrial", "book_id": "kosmos_humboldt_1845", "name": "terrestrial", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["terrestrial"], "contexts": ["relating to the Earth", "relating to Earth"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "terrestrial", "target_book": "kosmos_humboldt_1845", "target_name": "terrestrial", "similarity": 1.0}], "id": 4590, "stable_key": "clu_1b2182c00abdf494", "ground_truth": {"modern_name": "terrestrial", "confidence": "high", "type": "concept", "wikidata_id": "Q110810720", "wikidata_description": "grammatical gender of the fictional Valyrian language family"}}, {"canonical_name": "antarctic regions", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "antarctic_regions", "book_id": "origin_of_species_darwin_1859", "name": "antarctic regions", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["antarctic regions"], "contexts": ["polar region around South Pole"]}, {"entity_id": "antarctic", "book_id": "origin_of_species_darwin_1859", "name": "antarctic", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["antarctic"], "contexts": ["southern polar region"]}, {"entity_id": "antarctic", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Antarctic", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Antarctic"], "contexts": ["southern polar region"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "antarctic regions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Antarctic", "similarity": 0.936}, {"source_book": "origin_of_species_darwin_1859", "source_name": "antarctic", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Antarctic", "similarity": 0.975}], "id": 4591, "stable_key": "clu_ade0ff89afab4fe5", "ground_truth": {"modern_name": "Antarctic region", "confidence": "high", "type": "place", "wikidata_id": "Q1555938", "wikidata_description": "polar region around Earth's South Pole", "wikipedia_url": "https://en.wikipedia.org/wiki/Antarctic", "wikipedia_extract": "The Antarctic (, US also ; commonly ) is the polar region of Earth that surrounds the South Pole, lying within the Antarctic Circle. It is diametrically opposite of the Arctic region around the North Pole. The Antarctic comprises the continent of Antarctica, the Kerguelen Plateau, and other island territories located on the Antarctic Plate or south of the Antarctic Convergence. The Antarctic region includes the ice shelves, waters, and all the island territories in the Southern Ocean situated south of the Antarctic Convergence, a zone approximately 32 to 48 km (20 to 30 mi) wide and varying in latitude seasonally. The region covers some 20 percent of the Southern Hemisphere, of which 5.5 percent (14 million km2) is the surface area of the Antarctica continent itself. All of the land and ice shelves south of 60\u00b0S latitude are administered under the Antarctic Treaty System."}}, {"canonical_name": "volcanic masses", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "volcanic", "book_id": "origin_of_species_darwin_1859", "name": "volcanic", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["volcanic"], "contexts": ["relating to volcanoes"]}, {"entity_id": "volcanic_masses", "book_id": "kosmos_humboldt_1845", "name": "volcanic masses", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["volcanic masses"], "contexts": ["dense geological material", "material from volcanic eruptions"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "volcanic", "target_book": "kosmos_humboldt_1845", "target_name": "volcanic masses", "similarity": 0.926}], "id": 4592, "stable_key": "clu_1db14945b8a483d4-2", "ground_truth": {"modern_name": "Volcanic rocks", "confidence": "high", "type": "mineral", "note": "The terms 'roches volcaniques', 'volcanic eruptive rocks', and 'volcanic rock' all refer to the same category of geological material.", "wikidata_id": "Q57846654", "wikidata_description": "scholarly article by R. Hekinian et al published 1976 in Contributions to Mineralogy and Petrology"}}, {"canonical_name": "pebble", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pebble", "book_id": "origin_of_species_darwin_1859", "name": "pebble", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["pebble"], "contexts": ["small stone found in earth"]}, {"entity_id": "pebble", "book_id": "principles_of_psychology_james_1890", "name": "pebble", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["pebble"], "contexts": ["small stone", "small stone found on the shore"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "pebble", "target_book": "principles_of_psychology_james_1890", "target_name": "pebble", "similarity": 1.0}], "id": 4593, "stable_key": "clu_1d5896801355db41", "ground_truth": {"modern_name": "Pebble", "confidence": "high", "type": "mineral", "wikidata_id": "Q29726105", "wikidata_description": "protein-coding gene in the species Drosophila melanogaster"}}, {"canonical_name": "British Channel", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "british_channel", "book_id": "origin_of_species_darwin_1859", "name": "British Channel", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["British Channel"], "contexts": ["body of water separating islands"]}, {"entity_id": "british_channel", "book_id": "connexion_physical_sciences_somerville_1858", "name": "British Channel", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["British Channel"], "contexts": ["narrow sea channel with high tides", "height of tides"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "British Channel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "British Channel", "similarity": 1.0}], "id": 4594, "stable_key": "clu_efd9965fbe8aa495", "ground_truth": {"modern_name": "English Channel", "confidence": "high", "type": "place", "country": "United Kingdom, France", "wikidata_id": "Q24645904", "wikidata_description": "watercourse in the United Kingdom", "wikipedia_extract": "The Channel Islands are an archipelago in the English Channel, off the French coast of Normandy. They are divided into two Crown Dependencies: the Bailiwick of Jersey, which is the largest of the islands; and the Bailiwick of Guernsey, consisting of Guernsey, Alderney, Sark, Herm and some smaller islands. Historically, they are the remnants of the Duchy of Normandy. Although they are not part of the United Kingdom, the UK is responsible for the defence and international relations of the islands as it is for the other Crown Dependency, the Isle of Man, and the British Overseas Territories. The Crown Dependencies are neither members of the Commonwealth of Nations, nor part of the European Union. They have a total population of about 171,916, and the bailiwicks' capitals, Saint Helier and Saint Peter Port, have populations of 33,500 and 18,207 respectively.", "wikipedia_url": "https://en.wikipedia.org/wiki/Channel_Islands"}}, {"canonical_name": "Sculpture", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "sculpture", "book_id": "origin_of_species_darwin_1859", "name": "sculpture", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sculpture"], "contexts": ["surface markings on organisms"]}, {"entity_id": "sculpture", "book_id": "first_principles_spencer_1862", "name": "Sculpture", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Sculpture"], "contexts": ["art form derived from mural decoration", "artistic discipline"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "sculpture", "target_book": "first_principles_spencer_1862", "target_name": "Sculpture", "similarity": 0.909}], "id": 4595, "stable_key": "clu_a16b30f895f21314", "ground_truth": {"modern_name": "Sculpture", "confidence": "high", "type": "concept", "wikidata_id": "Q860861", "wikidata_description": "three-dimensional work of art", "wikipedia_url": "https://fr.wikipedia.org/wiki/Sculpture_%28%C5%93uvre_d%27art%29"}}, {"canonical_name": "appendix", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "appendage", "book_id": "origin_of_species_darwin_1859", "name": "appendage", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["appendage"], "contexts": ["a projecting part of the body"]}, {"entity_id": "appendix", "book_id": "first_principles_spencer_1862", "name": "appendix", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["appendix"], "contexts": ["part of the heart"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "appendage", "target_book": "first_principles_spencer_1862", "target_name": "appendix", "similarity": 0.918}], "id": 4596, "stable_key": "clu_83badfb76708d51f", "ground_truth": {"modern_name": "appendage", "confidence": "high", "type": "concept", "wikidata_id": "Q13415392", "wikidata_description": "external body part, or natural prolongation, that protrudes from an organism's body (in vertebrate biology, an example would be a vertebrate's limbs); any of the homologous body parts that may extend from a body segment"}}, {"canonical_name": "swimming", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "swimming", "book_id": "origin_of_species_darwin_1859", "name": "swimming", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["swimming"], "contexts": ["method of locomotion in water"]}, {"entity_id": "swimming", "book_id": "principles_of_psychology_james_1890", "name": "swimming", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["swimming"], "contexts": ["mode of aquatic locomotion"]}, {"entity_id": "swim", "book_id": "principles_of_psychology_james_1890", "name": "swim", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["swim"], "contexts": ["action learned with interruptions"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "swimming", "target_book": "principles_of_psychology_james_1890", "target_name": "swimming", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "swimming", "target_book": "principles_of_psychology_james_1890", "target_name": "swim", "similarity": 0.964}], "id": 4597, "stable_key": "clu_6649bd52ba12ee43", "ground_truth": {"modern_name": "swimming", "confidence": "high", "type": "concept", "wikidata_id": "Q31920", "wikidata_description": "water-based sport", "wikipedia_url": "https://en.wikipedia.org/wiki/Swimming%20%28sport%29", "wikipedia_extract": "Swimming is an individual or team racing sport that requires the use of one's entire body to move through water. The sport takes place in pools or open water (e.g., in a sea or lake). Competitive swimming is one of the most popular Olympic sports, with varied distance events in butterfly, backstroke, breaststroke, freestyle, and individual medley. In addition to these individual events, four swimmers can take part in either a freestyle or medley relay. A medley relay consists of four swimmers who will each swim a different stroke, ordered as backstroke, breaststroke, butterfly and freestyle. Swimming each stroke requires a set of specific techniques; in competition, there are distinct regulations concerning the acceptable form for each individual stroke."}}, {"canonical_name": "respiratory muscles", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "respiratory_organs", "book_id": "kosmos_humboldt_1845", "name": "respiratory organs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["respiratory organs"], "contexts": ["organs for gas exchange"]}, {"entity_id": "respiratory_muscles", "book_id": "first_principles_spencer_1862", "name": "respiratory muscles", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["respiratory muscles"], "contexts": ["muscles involved in breathing"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "respiratory organs", "target_book": "first_principles_spencer_1862", "target_name": "respiratory muscles", "similarity": 0.912}], "id": 4598, "stable_key": "clu_aafb5e2db29fa79e", "ground_truth": {"modern_name": "Respiratory organs", "confidence": "high", "type": "concept", "note": "While 'breathing organ' and 'respiratory organs' refer to anatomical structures, the cluster context suggests a conceptual grouping rather than a single specific organ.", "wikidata_id": "Q42183538", "wikidata_description": "respiratory system manifestations of diseases of the respiratory tract or of other organs"}}, {"canonical_name": "American islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "american_islands", "book_id": "origin_of_species_darwin_1859", "name": "American islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["American islands"], "contexts": ["islands with plants and animals related to mainland"]}, {"entity_id": "\u00eeles_de_l'am\u00e9rique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "\u00eeles de l'Am\u00e9rique", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["\u00eeles de l'Am\u00e9rique"], "contexts": ["islands of America"]}, {"entity_id": "\u00eeles_d'am\u00e9rique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "\u00eeles d'Am\u00e9rique", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["\u00eeles d'Am\u00e9rique"], "contexts": ["islands exporting sugar"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "American islands", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "\u00eeles de l'Am\u00e9rique", "similarity": 0.951}, {"source_book": "origin_of_species_darwin_1859", "source_name": "American islands", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "\u00eeles d'Am\u00e9rique", "similarity": 0.948}], "id": 4599, "stable_key": "clu_45f865282c3a0a3f", "ground_truth": {"modern_name": "islands of America", "confidence": "high", "type": "place", "country": "Americas"}}, {"canonical_name": "Gould, Mr.", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "gould,_mr_", "book_id": "origin_of_species_darwin_1859", "name": "Gould, Mr.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Gould, Mr."], "contexts": ["on colours of birds"]}, {"entity_id": "bond,_mr_", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bond, Mr.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bond, Mr."], "contexts": ["discovered Saturn's satellite, resolved nebula"]}, {"entity_id": "dunlop,_mr_", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Dunlop, Mr.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Dunlop, Mr."], "contexts": ["double star revolution calculation"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Gould, Mr.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bond, Mr.", "similarity": 0.852}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Gould, Mr.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Dunlop, Mr.", "similarity": 0.85}], "id": 4600, "stable_key": "clu_63f301aa95c76d14", "ground_truth": {"modern_name": "John Gould", "confidence": "high", "type": "person", "birth_year": 1804, "death_year": 1881, "description": "Ornithologist known for detailed bird illustrations", "note": "While 'Gould, Mr.' is present, the context 'colours of birds' strongly suggests John Gould, a prominent ornithologist of the period. The other members are likely misinterpretations or errors in the source texts or OCR."}}, {"canonical_name": "clauos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "clauos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "clauos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["clauos"], "contexts": ["clove flowers, transformed from flowers", "flavor compared to cloves"]}, {"entity_id": "clauos", "book_id": "historia_medicinal_monardes_1574", "name": "Clauos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Clauos"], "contexts": ["cloves"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "sour