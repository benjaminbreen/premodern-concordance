ennsylvania", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Pennsylvania"], "contexts": ["wilderness where woman inhabited", "state where Norristown is located"]}, {"entity_id": "pennsylvania", "book_id": "kosmos_humboldt_1845", "name": "Pennsylvania", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Pennsylvania"], "contexts": ["location where phenomenon observed"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Pennsylvania", "target_book": "kosmos_humboldt_1845", "target_name": "Pennsylvania", "similarity": 0.817}], "id": 4135, "stable_key": "clu_77ab25463f404882", "ground_truth": {"modern_name": "Pennsylvania", "confidence": "high", "type": "place", "country": "United States", "wikidata_id": "Q1400", "wikidata_description": "state of the United States of America", "wikipedia_url": "https://en.wikipedia.org/wiki/Pennsylvania", "wikipedia_extract": "Pennsylvania, officially the Commonwealth of Pennsylvania, is a state located in the Mid-Atlantic, Northeastern, Appalachian, and Great Lakes regions of the United States. It borders Delaware to its southeast, Maryland to its south, forming the Mason-Dixon Line, West Virginia to its southwest, Ohio to its west, the Canadian province of Ontario to its northwest via Lake Erie, New York to its north, and the Delaware River and New Jersey to its east. Pennsylvania's most populous city is Philadelphia, and the state capital is Harrisburg. Among all US states, Pennsylvania is the fifth-most populous with over 13 million residents as of the 2020 United States census, the ninth-highest by population density, and the 33rd-largest by land area. The largest metropolitan statistical area is the Philadelphia metropolitan area in southeastern Pennsylvania, also known as the Delaware Valley and centered on Philadelphia, the sixth-most populous U.S. city. Pennsylvania's second-largest metropolitan area, Greater Pittsburgh, is centered in and around Pittsburgh, the commonwealth's second-largest city."}}, {"canonical_name": "childhood", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "childhood", "book_id": "principles_of_psychology_james_1890", "name": "childhood", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["childhood"], "contexts": ["early stage of human life", "early stage of life"]}, {"entity_id": "childhood", "book_id": "first_principles_spencer_1862", "name": "childhood", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["childhood"], "contexts": ["period of early life"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "childhood", "target_book": "first_principles_spencer_1862", "target_name": "childhood", "similarity": 1.0}], "id": 4136, "stable_key": "clu_efc97a5950f5c1bb", "ground_truth": {"modern_name": "Childhood", "confidence": "high", "type": "concept", "wikidata_id": "Q3241451", "wikidata_description": "condition where excess body fat negatively affects a child's health or well-being"}}, {"canonical_name": "operations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "operations", "book_id": "principles_of_psychology_james_1890", "name": "operations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["operations"], "contexts": ["actions performed on things", "actions or processes of the mind"]}, {"entity_id": "operationem", "book_id": "polyanthea_medicinal", "name": "operationem", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["operationem"], "contexts": ["the effect of a medicine"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "operations", "target_book": "polyanthea_medicinal", "target_name": "operationem", "similarity": 0.89}], "id": 4137, "stable_key": "clu_57