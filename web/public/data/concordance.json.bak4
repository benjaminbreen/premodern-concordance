": {"modern_name": "Germany", "confidence": "high", "type": "place", "country": "Germany", "wikidata_id": "Q183", "wikidata_description": "country in Central Europe", "wikipedia_url": "https://en.wikipedia.org/wiki/Germany"}}, {"canonical_name": "comets", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 36, "members": [{"entity_id": "com\u00e8te", "book_id": "epoques_nature_buffon_1778", "name": "com\u00e8te", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["com\u00e8te"], "contexts": ["comet", "celestial body causing motion"]}, {"entity_id": "comet", "book_id": "kosmos_humboldt_1845", "name": "comet", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["comet"], "contexts": ["type of inclination for Pallas", "celestial body with tail"]}, {"entity_id": "comets", "book_id": "connexion_physical_sciences_somerville_1858", "name": "comets", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 27, "variants": ["comets", "Comets"], "contexts": ["celestial bodies with elliptical orbits", "icy celestial bodies"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "com\u00e8te", "target_book": "kosmos_humboldt_1845", "target_name": "comet", "similarity": 0.941}, {"source_book": "epoques_nature_buffon_1778", "source_name": "com\u00e8te", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "comets", "similarity": 0.899}, {"source_book": "kosmos_humboldt_1845", "source_name": "comet", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "comets", "similarity": 0.946}], "id": 917, "stable_key": "clu_b973d25e8b83a792", "ground_truth": {"modern_name": "comets", "confidence": "high", "type": "concept", "note": "While comets are celestial bodies and not animals, the term 'animal' was sometimes used more broadly in early modern texts to refer to any moving entity or creature. However, classifying them as a 'concept' or 'celestial body' is more accurate in modern terminology. Given the options, 'concept' fits best for a recurring celestial phenomenon studied in natural philosophy.", "wikidata_id": "Q23772858", "wikidata_description": "family name"}}, {"canonical_name": "inheritance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 36, "members": [{"entity_id": "h\u00e9r\u00e9dit\u00e9", "book_id": "epoques_nature_buffon_1778", "name": "h\u00e9r\u00e9dit\u00e9", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["h\u00e9r\u00e9dit\u00e9"], "contexts": ["manifests in plants and animals"]}, {"entity_id": "inheritance", "book_id": "origin_of_species_darwin_1859", "name": "inheritance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 34, "variants": ["inheritance", "Inheritance"], "contexts": ["transmission of traits", "transmission of traits from parents"]}, {"entity_id": "herencia", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "herencia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["herencia"], "contexts": ["knowledge passed down by inheritance"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "h\u00e9r\u00e9dit\u00e9", "target_book": "origin_of_species_darwin_1859", "target_name": "inheritance", "similarity": 0.962}, {"source_book": "epoques_nature_buffon_1778", "source_name": "h\u00e9r\u00e9dit\u00e9", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "herencia", "similarity": 0.952}, {"source_book": "origin_of_species_darwin_1859", "source_name": "inheritance", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "herencia", "similarity": 0.938}], "id": 918, "stable_key": "clu_406f2fd5c2822117", "ground_truth": {"modern_name": "inheritance", "confidence": "high", "type": "concept", "wikidata_id": "Q200303", "wikidata_description": "practice of passing on property, position, or office upon the death, resignation, or stepping down of individuals", "wikipedia_url": "https://en.wikipedia.org/wiki/Inheritance"}}, {"canonical_name": "sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 36, "members": [{"entity_id": "sea", "book_id": "origin_of_species_darwin_1859", "name": "sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["sea"], "contexts": ["large body of saltwater", "agent of sediment transport"]}, {"entity_id": "sea", "book_id": "kosmos_humboldt_1845", "name": "sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 27, "variants": ["Sea", "sea"], "contexts": ["liquid envelope of the planet", "liquid envelope of the earth"]}, {"entity_id": "sea", "book_id": "first_principles_spencer_1862", "name": "sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["sea"], "contexts": ["source of vapour", "large body of saltwater"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "sea", "target_book": "kosmos_humboldt_1845", "target_name": "sea", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "sea", "target_book": "first_principles_spencer_1862", "target_name": "sea", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "sea", "target_book": "first_principles_spencer_1862", "target_name": "sea", "similarity": 1.0}], "id": 919, "stable_key": "clu_7cf0aa9a9b3ff251-2", "ground_truth": {"modern_name": "sea", "confidence": "high", "type": "place", "wikidata_id": "Q165", "wikidata_description": "city in and county seat of King County, State of Washington, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Sea", "wikipedia_extract": "A sea is a large body of salt water. There are particular seas and the sea. The sea commonly refers to the ocean, the interconnected body of seawaters that spans most of Earth. Particular seas are either marginal seas, second-order sections of the oceanic sea (e.g. the Mediterranean Sea), or certain large, nearly landlocked bodies of water. The salinity of water bodies varies widely, being lower near the surface and the mouths of large rivers and higher in the depths of the ocean; however, the relative proportions of dissolved salts vary little across the oceans."}}, {"canonical_name": "orbit", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 36, "members": [{"entity_id": "orbit", "book_id": "kosmos_humboldt_1845", "name": "orbit", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["orbit"], "contexts": ["path of a celestial body", "path of celestial body around another"]}, {"entity_id": "orbit", "book_id": "connexion_physical_sciences_somerville_1858", "name": "orbit", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 26, "variants": ["Orbit", "orbit"], "contexts": ["path of celestial body", "path of a celestial body"]}, {"entity_id": "orbits", "book_id": "connexion_physical_sciences_somerville_1858", "name": "orbits", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Orbits", "orbits"], "contexts": ["paths of celestial bodies", "curved paths of celestial bodies"]}, {"entity_id": "orbit", "book_id": "first_principles_spencer_1862", "name": "orbit", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["orbit"], "contexts": ["path of celestial body"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "orbit", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "orbit", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "orbit", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "orbits", "similarity": 0.893}, {"source_book": "kosmos_humboldt_1845", "source_name": "orbit", "target_book": "first_principles_spencer_1862", "target_name": "orbit", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "orbit", "target_book": "first_principles_spencer_1862", "target_name": "orbit", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "orbits", "target_book": "first_principles_spencer_1862", "target_name": "orbit", "similarity": 0.893}], "id": 920, "stable_key": "clu_4ae8b48fa1ff14a5", "ground_truth": {"modern_name": "Orbital mechanics", "confidence": "high", "type": "concept", "note": "The term 'orbit' in early modern scientific texts refers to the path of celestial bodies, which is a fundamental concept in orbital mechanics.", "wikidata_id": "Q842433", "wikidata_description": "field of classical mechanics concerned with the motion of spacecraft", "wikipedia_url": "https://en.wikipedia.org/wiki/Orbital%20mechanics", "wikipedia_extract": "Orbital mechanics or astrodynamics is the application of ballistics and celestial mechanics to rockets, satellites, and other spacecraft. The motion of these objects is usually calculated from laws of motion and of universal gravitation derived by Isaac Newton. Astrodynamics is a core discipline within space-mission design and control. Celestial mechanics treats more broadly the orbit dynamics of systems under the influence of gravity, including both spacecraft and natural astronomical bodies such as star systems, planets, moons, and comets. Orbital mechanics focuses on spacecraft trajectories, including orbital maneuvers, orbital plane changes, and interplanetary transfers, and is used by mission planners to predict the results of propulsive maneuvers. General relativity is a more exact theory than Newton's laws for calculating orbits, and it is sometimes necessary to use it for greater accuracy or in high-gravity situations (e.g."}}, {"canonical_name": "satellites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 35, "members": [{"entity_id": "satellites", "book_id": "epoques_nature_buffon_1778", "name": "satellites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["satellites"], "contexts": ["celestial bodies orbiting planets"]}, {"entity_id": "satellites", "book_id": "connexion_physical_sciences_somerville_1858", "name": "satellites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 25, "variants": ["satellites", "Satellites"], "contexts": ["celestial bodies orbiting planets", "bodies orbiting planets"]}, {"entity_id": "satellite", "book_id": "connexion_physical_sciences_somerville_1858", "name": "satellite", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["satellite"], "contexts": ["celestial body orbiting a planet", "body orbiting a planet"]}, {"entity_id": "satellites", "book_id": "first_principles_spencer_1862", "name": "satellites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["satellites"], "contexts": ["celestial bodies orbiting planets", "celestial bodies orbiting a planet"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "satellites", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "satellites", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "satellites", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "satellite", "similarity": 0.969}, {"source_book": "epoques_nature_buffon_1778", "source_name": "satellites", "target_book": "first_principles_spencer_1862", "target_name": "satellites", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "satellites", "target_book": "first_principles_spencer_1862", "target_name": "satellites", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "satellite", "target_book": "first_principles_spencer_1862", "target_name": "satellites", "similarity": 0.969}], "id": 921, "stable_key": "clu_a18d38f2a9e7f8c4", "ground_truth": {"modern_name": "satellites", "confidence": "high", "type": "concept", "note": "Similar to comets, satellites are celestial bodies, not animals. The term 'concept' is the most fitting modern classification for celestial bodies that orbit other celestial bodies.", "wikidata_id": "Q2537", "wikidata_description": "celestial body that orbits a planet or other smaller body in turn directly orbiting a star", "wikipedia_url": "https://en.wikipedia.org/wiki/Natural%20satellite"}}, {"canonical_name": "Guayaquil", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 35, "members": [{"entity_id": "guayaquil", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Guayaquil", "category": "PLACE", "subcategory": "CITY", "count": 28, "variants": ["Guayaquil", "Guayuaquil"], "contexts": ["port city in Ecuador", "port on the Pacific coast"]}, {"entity_id": "guayaquil", "book_id": "kosmos_humboldt_1845", "name": "Guayaquil", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Guayaquil"], "contexts": ["city in Ecuador", "station in the tropics"]}, {"entity_id": "guayaquil", "book_id": "historia_medicinal_monardes_1574", "name": "Guayaquil", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Guayaquil"], "contexts": ["a city in Peru", "a river name"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Guayaquil", "target_book": "kosmos_humboldt_1845", "target_name": "Guayaquil", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Guayaquil", "target_book": "historia_medicinal_monardes_1574", "target_name": "Guayaquil", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Guayaquil", "target_book": "historia_medicinal_monardes_1574", "target_name": "Guayaquil", "similarity": 1.0}], "id": 922, "stable_key": "clu_67d123bd3a195d24", "ground_truth": {"modern_name": "Guayaquil", "confidence": "high", "type": "place", "description": "Major port city in Ecuador on the Pacific coast.", "wikipedia_extract": "Guayaquil (Spanish pronunciation: [\u0261wa\u029da\u02c8kil] ), officially Santiago de Guayaquil, is the largest city in Ecuador and also the nation's economic capital and main port. The city is the capital of Guayas Province and the seat of Guayaquil Canton. The city is located on the west bank of the Guayas River, which flows into the Pacific Ocean at the Gulf of Guayaquil. With a population of 2,746,403 inhabitants, it is the most populous city in the country, and the fifth largest in the Andean Community. However, its urban fabric extends beyond its official urban parishes, encompassing nearby cities and parishes; thus, the Guayaquil metropolitan area reaches a population of 3,618,450, making it the most populous urban agglomeration in the nation, and also the fifth in the Andean Community. As the largest city, it is one of the two main development poles of the country\u2014alongside Quito, the national capital\u2014hosting Ecuador\u2019s main business, financial, cultural, and sports institutions."}}, {"canonical_name": "Moon", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 3, "total_mentions": 34, "members": [{"entity_id": "moon", "book_id": "english_physician_1652", "name": "Moon", "category": "CONCEPT", "subcategory": "THEORY", "count": 32, "variants": ["Moon"], "contexts": ["celestial body that can cause stopping of urine", "planet influencing bodily functions"]}, {"entity_id": "luna", "book_id": "coloquios_da_orta_1563", "name": "luna", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["luna"], "contexts": ["moon phase affecting pearl quality"]}, {"entity_id": "luna", "book_id": "ricettario_fiorentino_1597", "name": "Luna", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Luna"], "contexts": ["moon influence on heating"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Moon", "target_book": "coloquios_da_orta_1563", "target_name": "luna", "similarity": 0.918}, {"source_book": "english_physician_1652", "source_name": "Moon", "target_book": "ricettario_fiorentino_1597", "target_name": "Luna", "similarity": 0.928}, {"source_book": "coloquios_da_orta_1563", "source_name": "luna", "target_book": "ricettario_fiorentino_1597", "target_name": "Luna", "similarity": 0.968}], "id": 923, "stable_key": "clu_41f0ebb7878aae72", "ground_truth": {"modern_name": "Moon", "confidence": "high", "type": "concept", "note": "Although 'moon' can refer to a celestial body, in this scientific context, it refers to Earth's Moon, a concept in astronomy and physical sciences.", "wikidata_description": "family name"}}, {"canonical_name": "Higado", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 34, "members": [{"entity_id": "higado", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "higado", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["higado"], "contexts": ["an organ affected by hot imbalance", "organ in the body"]}, {"entity_id": "higado", "book_id": "historia_medicinal_monardes_1574", "name": "Higado", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 17, "variants": ["Higado", "Higa", "hidago", "higado"], "contexts": ["an organ in the body", "liver organ"]}, {"entity_id": "higado", "book_id": "polyanthea_medicinal", "name": "higado", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["higado"], "contexts": ["organ affected by heat"]}, {"entity_id": "h\u00edgado", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "h\u00edgado", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 10, "variants": ["h\u00edgado"], "contexts": ["organ, liver", "inflames the blood of the liver"]}, {"entity_id": "alhigado", "book_id": "historia_medicinal_monardes_1574", "name": "alhigado", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["alhigado"], "contexts": ["related to the liver"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "higado", "target_book": "historia_medicinal_monardes_1574", "target_name": "Higado", "similarity": 0.992}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "higado", "target_book": "polyanthea_medicinal", "target_name": "higado", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Higado", "target_book": "polyanthea_medicinal", "target_name": "higado", "similarity": 0.992}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "h\u00edgado", "target_book": "historia_medicinal_monardes_1574", "target_name": "alhigado", "similarity": 0.935}], "id": 924, "stable_key": "clu_f8e390acf3914c7b", "ground_truth": {"modern_name": "liver", "confidence": "high", "type": "substance", "description": "A large organ in the abdomen responsible for many metabolic functions.", "wikipedia_extract": "The liver is a major metabolic organ exclusively found in vertebrates, which performs many essential biological functions such as detoxification of the organism, and the synthesis of various proteins and various other biochemicals necessary for digestion and growth. In humans, it is located in the right upper quadrant of the abdomen, below the diaphragm and mostly shielded by the lower right rib cage. Its other metabolic roles include carbohydrate metabolism, the production of a number of hormones, conversion and storage of nutrients such as glucose and glycogen, and the decomposition of red blood cells. Anatomical and medical terminology often use the prefix hepat- from \u1f21\u03c0\u03b1\u03c4\u03bf-, from the Greek word for liver, such as hepatology, and hepatitis. The liver is also an accessory digestive organ that produces bile, an alkaline fluid containing cholesterol and bile acids,  which emulsifies and aids the breakdown of dietary fat. The gallbladder, a small hollow pouch that sits just under the right lobe of liver, stores and concentrates the bile produced by the liver, which is later excreted to the duodenum to help with digestion."}}, {"canonical_name": "naturalists", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 33, "members": [{"entity_id": "naturalistes", "book_id": "medecine_experimentale_bernard_1865", "name": "naturalistes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["naturalistes"], "contexts": ["naturalists", "scholars of nature"]}, {"entity_id": "naturalists", "book_id": "origin_of_species_darwin_1859", "name": "naturalists", "category": "PERSON", "subcategory": "SCHOLAR", "count": 29, "variants": ["naturalists", "Naturalists"], "contexts": ["scientists studying nature", "people who study nature"]}, {"entity_id": "naturalists", "book_id": "first_principles_spencer_1862", "name": "naturalists", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Naturalists", "naturalists"], "contexts": ["scientists studying nature", "scientists who study nature"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "naturalistes", "target_book": "origin_of_species_darwin_1859", "target_name": "naturalists", "similarity": 0.968}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "naturalistes", "target_book": "first_principles_spencer_1862", "target_name": "naturalists", "similarity": 0.968}, {"source_book": "origin_of_species_darwin_1859", "source_name": "naturalists", "target_book": "first_principles_spencer_1862", "target_name": "naturalists", "similarity": 1.0}], "id": 925, "stable_key": "clu_cce57dd83d614006", "ground_truth": {"modern_name": "Naturalist", "confidence": "high", "type": "person", "description": "Scientists who study the natural world and its phenomena.", "note": "This refers to a category of individuals, not a specific person.", "wikidata_id": "Q18805", "wikidata_description": "person who studies and knows a lot about plants, animals and natural history (esp in the field)", "wikipedia_extract": "Sir David Frederick Attenborough (; born 8 May 1926) is a British broadcaster, biologist, natural historian and writer. First becoming prominent as host of Zoo Quest in 1954, his filmography as a writer, presenter and narrator has spanned eight decades; it includes the nine nature documentary series forming The Life Collection, Natural World, Wildlife on One, the Planet Earth franchise, The Blue Planet and Blue Planet II. He is the only person to have won BAFTA Awards in black-and-white, colour, high-definition, 3D and 4K resolution. Over his life he has collected dozens of honorary degrees and awards, including three Emmy Awards for Outstanding Narration and one Emmy Award for Outstanding Daytime Personality - Non-Daily. Attenborough was a senior manager at the BBC, having served as controller of BBC Two and director of programming for BBC Television in the 1960s and 1970s. While Attenborough's earlier work focused primarily on the wonders of the natural world, his later work has been more vocal in support of environmental causes.", "wikipedia_url": "https://en.wikipedia.org/wiki/Naturalist"}}, {"canonical_name": "\u00e9quateur", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 33, "members": [{"entity_id": "\u00e9quateur", "book_id": "epoques_nature_buffon_1778", "name": "\u00e9quateur", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 18, "variants": ["\u00c9QUATEUR", "\u00e9quateur"], "contexts": ["imaginary line around Earth's center", "imaginary line dividing Earth"]}, {"entity_id": "l\u2019\u00e9quateur", "book_id": "epoques_nature_buffon_1778", "name": "l\u2019\u00e9quateur", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["l\u2019\u00e9quateur"], "contexts": ["Earth's equatorial line", "equator"]}, {"entity_id": "terres_de_l\u2019\u00e9quateur", "book_id": "epoques_nature_buffon_1778", "name": "terres de l\u2019\u00e9quateur", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["terres de l\u2019\u00e9quateur"], "contexts": ["lands of the equator"]}, {"entity_id": "\u00e9quateur", "book_id": "relation_historique_humboldt_vol3_1825", "name": "\u00e9quateur", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["\u00e9quateur"], "contexts": ["geographical line", "imaginary line dividing Earth"]}, {"entity_id": "equador", "book_id": "coloquios_da_orta_1563", "name": "equador", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["equador"], "contexts": ["region where thunderstorms were frequent", "geographic region"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "\u00e9quateur", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "\u00e9quateur", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "\u00e9quateur", "target_book": "coloquios_da_orta_1563", "target_name": "equador", "similarity": 0.984}, {"source_book": "epoques_nature_buffon_1778", "source_name": "l\u2019\u00e9quateur", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "\u00e9quateur", "similarity": 0.99}, {"source_book": "epoques_nature_buffon_1778", "source_name": "l\u2019\u00e9quateur", "target_book": "coloquios_da_orta_1563", "target_name": "equador", "similarity": 0.978}, {"source_book": "epoques_nature_buffon_1778", "source_name": "terres de l\u2019\u00e9quateur", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "\u00e9quateur", "similarity": 0.95}, {"source_book": "epoques_nature_buffon_1778", "source_name": "terres de l\u2019\u00e9quateur", "target_book": "coloquios_da_orta_1563", "target_name": "equador", "similarity": 0.937}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "\u00e9quateur", "target_book": "coloquios_da_orta_1563", "target_name": "equador", "similarity": 0.984}], "id": 926, "stable_key": "clu_f43f4c2359bdca2b-2", "ground_truth": {"modern_name": "Equator", "confidence": "high", "type": "concept", "wikidata_id": "Q983", "wikidata_description": "sovereign state in Africa", "wikipedia_url": "https://en.wikipedia.org/wiki/Equatorial%20Guinea", "wikipedia_extract": "Equatorial Guinea, officially the Republic of Equatorial Guinea, is a country on the west coast of Central Africa. It has an area of 28,000 square kilometres (11,000 sq mi). Formerly the colony of Spanish Guinea, its post-independence name refers to its location both near the Equator and in the African region of Guinea. As of 2025, the country has a population of 1,853,559, over 85% of whom are members of the Fang people, the country's dominant ethnic group. The Bubi people, indigenous to Bioko, are the second largest group at approximately 6.5% of the population. Its capital is Ciudad de la Paz, replacing former capital Malabo in 2026, while its largest city is Bata."}}, {"canonical_name": "Rhafis", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 33, "members": [{"entity_id": "rhazis", "book_id": "english_physician_1652", "name": "Rhazis", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Rhazis"], "contexts": ["medieval Persian physician"]}, {"entity_id": "rafis", "book_id": "historia_medicinal_monardes_1574", "name": "Rafis", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Rafis"], "contexts": ["ancient authority who classified iron", "medical authority"]}, {"entity_id": "rhafis", "book_id": "polyanthea_medicinal", "name": "Rhafis", "category": "PERSON", "subcategory": "AUTHORITY", "count": 29, "variants": ["Rhafis", "Rhaf", "Rhas", "Rhas.", "Rhasis", "Rhazes", "Rha\u017fis"], "contexts": ["cited ancient/medieval authority", "ancient medical authority"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Rhazis", "target_book": "polyanthea_medicinal", "target_name": "Rhafis", "similarity": 0.862}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Rafis", "target_book": "polyanthea_medicinal", "target_name": "Rhafis", "similarity": 0.872}], "id": 927, "stable_key": "clu_b19d9e30ccd3f3e9", "ground_truth": {"modern_name": "Rhazes", "confidence": "high", "type": "person", "birth_year": 865, "death_year": 925, "description": "Persian polymath, physician, and alchemist, influential in medieval medicine.", "note": "The variations 'Rhazis', 'Rafis', and 'Rhafis' all refer to the famous Persian physician.", "wikidata_id": "Q169234", "wikidata_description": "Persian polymath, physician, chemist and philosopher (854-925)", "wikipedia_url": "https://en.wikipedia.org/wiki/Abu%20Bakr%20al-Razi", "wikipedia_extract": "Ab\u016b Bakr al-R\u0101z\u012b, also known as Rhazes (full name: \u0623\u0628\u0648 \u0628\u06a9\u0631 \u0645\u062d\u0645\u062f \u0628\u0646 \u0632\u06a9\u0631\u06cc\u0627\u0621 \u0627\u0644\u0631\u0627\u0632\u064a, Ab\u016b Bakr Mu\u1e25ammad ibn Zakariyy\u0101\u02be al-R\u0101z\u012b), 864 or 865 \u2013 925 or 935 CE, was a Persian physician, philosopher and alchemist who lived during the Islamic Golden Age. He is widely regarded as one of the most important figures in the history of medicine, and also wrote on logic, astronomy and grammar. He is also known for his criticism of religion, especially with regard to the concepts of prophethood and revelation. However, the religio-philosophical aspects of his thought, which also included a belief in five \"eternal principles\", are fragmentary and only reported by authors who were often hostile to him. A comprehensive thinker, al-Razi made fundamental and enduring contributions to various fields, which he recorded in over 200 manuscripts, and is particularly remembered for numerous advances in medicine through his observations and discoveries. An early proponent of experimental medicine, he became a successful doctor, and served as chief physician of Baghdad and Ray hospitals."}}, {"canonical_name": "Intestinos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 33, "members": [{"entity_id": "intestinos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "intestinos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["intestinos"], "contexts": ["part of the digestive system", "part of the body where the herb is applied"]}, {"entity_id": "intestinos", "book_id": "polyanthea_medicinal", "name": "Intestinos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 17, "variants": ["Intestinos", "intestinos"], "contexts": ["body part", "digestive organs"]}, {"entity_id": "inte\u017ftinos", "book_id": "polyanthea_medicinal", "name": "inte\u017ftinos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 11, "variants": ["inte\u017ftinos"], "contexts": ["intestines", "intestines connected to stomach"]}, {"entity_id": "intestines", "book_id": "first_principles_spencer_1862", "name": "intestines", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["intestines"], "contexts": ["part of the digestive tract", "part of digestive tract"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "intestinos", "target_book": "polyanthea_medicinal", "target_name": "Intestinos", "similarity": 0.992}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "intestinos", "target_book": "polyanthea_medicinal", "target_name": "inte\u017ftinos", "similarity": 0.962}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "intestinos", "target_book": "first_principles_spencer_1862", "target_name": "intestines", "similarity": 0.989}, {"source_book": "polyanthea_medicinal", "source_name": "Intestinos", "target_book": "first_principles_spencer_1862", "target_name": "intestines", "similarity": 0.985}, {"source_book": "polyanthea_medicinal", "source_name": "inte\u017ftinos", "target_book": "first_principles_spencer_1862", "target_name": "intestines", "similarity": 0.967}], "id": 928, "stable_key": "clu_09b1984512807aa6-2", "ground_truth": {"modern_name": "Intestines", "confidence": "high", "type": "anatomy", "description": "The part of the digestive system in animals.", "note": "Refers to the anatomical organs.", "wikipedia_extract": "The gastrointestinal tract (also called the GI tract, digestive tract, and the alimentary canal) is the tract or passageway of the digestive system that leads from the mouth to the anus. The tract is one of the largest of the body's systems. The GI tract contains all the major organs of the digestive system, in humans and other animals, including the esophagus, stomach, and intestines. Food taken in through the mouth is digested to extract nutrients and absorb energy, and the waste expelled at the anus as feces. Gastrointestinal is an adjective meaning of or pertaining to the stomach and intestines. Most animals have a \"through-gut\" or complete digestive tract.", "wikidata_id": "Q9639", "wikidata_description": "alimentary canal of an animal through which food passes after having passed all stomachs"}}, {"canonical_name": "Ambar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 33, "members": [{"entity_id": "ambar", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "ambar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["ambar"], "contexts": ["substance expelled from mouth"]}, {"entity_id": "ambar", "book_id": "historia_medicinal_monardes_1574", "name": "Ambar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 22, "variants": ["Ambar", "AMBAR GRIS", "Ambai", "Ambar Gris", "Ambar gris", "ambar"], "contexts": ["used to make beads", "ambergris"]}, {"entity_id": "\u00e2mbar", "book_id": "coloquios_da_orta_1563", "name": "\u00e2mbar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 10, "variants": ["\u00e2mbar", "\u00e2mbar amarello", "\u00e2mbares"], "contexts": ["substance discussed", "substance from whales"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ambar", "target_book": "historia_medicinal_monardes_1574", "target_name": "Ambar", "similarity": 0.83}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ambar", "target_book": "coloquios_da_orta_1563", "target_name": "\u00e2mbar", "similarity": 0.555}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Ambar", "target_book": "coloquios_da_orta_1563", "target_name": "\u00e2mbar", "similarity": 0.624}], "id": 929, "stable_key": "clu_041049064e6f8a49", "ground_truth": {"modern_name": "Ambergris", "confidence": "high", "type": "substance", "note": "The term 'Ambar' or '\u00e2mbar' in early modern Portuguese and Spanish texts most commonly refers to ambergris, a waxy substance produced in the digestive system of sperm whales, used in perfumery and medicine. While 'amber' (fossilized resin) also exists, its uses and contexts in early modern medicinal texts point more strongly to ambergris.", "wikidata_id": "Q188774", "wikidata_description": "substance produced in the digestive system of sperm whales", "wikipedia_url": "https://en.wikipedia.org/wiki/Ambergris", "wikipedia_extract": "Ambergris ( or ; Latin: ambra grisea; Old French: ambre gris), ambergrease, or grey amber is a solid, waxy, flammable substance of a dull grey or blackish colour produced in the digestive system of sperm whales. Freshly produced ambergris has a marine, fecal odor. It acquires a sweet, earthy scent as it ages, commonly likened to the fragrance of isopropyl alcohol without the vaporous chemical astringency. Ambergris has been highly valued by perfume makers as a fixative that allows the scent to last much longer, although it has been mostly replaced by synthetic ambroxide. It is sometimes used in cooking. Dogs are attracted to the smell of ambergris and are sometimes used by ambergris searchers."}}, {"canonical_name": "Vesuvius", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 33, "members": [{"entity_id": "vesuvius", "book_id": "kosmos_humboldt_1845", "name": "Vesuvius", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 23, "variants": ["Vesuvius"], "contexts": ["volcano height for comparison", "volcano used for distance comparison"]}, {"entity_id": "mount_vesuvius", "book_id": "kosmos_humboldt_1845", "name": "Mount Vesuvius", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Mount Vesuvius"], "contexts": ["volcano with changing elevation", "volcano with eruption in 1822"]}, {"entity_id": "mons_vesuvius", "book_id": "kosmos_humboldt_1845", "name": "Mons Vesuvius", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Mons Vesuvius"], "contexts": ["Latin name for Vesuvius"]}, {"entity_id": "vesuvios", "book_id": "polyanthea_medicinal", "name": "Vesuvios", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Vesuvios"], "contexts": ["volcano, used metaphorically for fever", "volcanic mountain"]}, {"entity_id": "vesuvius", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Vesuvius", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Vesuvius"], "contexts": ["volcano with historical record of eruption", "volcanic mountain"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Vesuvius", "target_book": "polyanthea_medicinal", "target_name": "Vesuvios", "similarity": 0.988}, {"source_book": "kosmos_humboldt_1845", "source_name": "Vesuvius", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Vesuvius", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mount Vesuvius", "target_book": "polyanthea_medicinal", "target_name": "Vesuvios", "similarity": 0.947}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mount Vesuvius", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Vesuvius", "similarity": 0.964}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mons Vesuvius", "target_book": "polyanthea_medicinal", "target_name": "Vesuvios", "similarity": 0.931}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mons Vesuvius", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Vesuvius", "similarity": 0.941}, {"source_book": "polyanthea_medicinal", "source_name": "Vesuvios", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Vesuvius", "similarity": 0.988}], "id": 930, "stable_key": "clu_1bbd5de4dbf9d680", "ground_truth": {"modern_name": "Mount Vesuvius", "confidence": "high", "type": "place", "country": "Italy"}}, {"canonical_name": "Ofofago", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 32, "members": [{"entity_id": "oesophagus", "book_id": "origin_of_species_darwin_1859", "name": "oesophagus", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["oesophagus"], "contexts": ["upper part expanded by turbit", "tube connecting mouth to stomach"]}, {"entity_id": "ofofago", "book_id": "polyanthea_medicinal", "name": "Ofofago", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 26, "variants": ["Ofofago", "Oefopbagus", "Ofophago", "Olofago", "O\u017fophagode", "ofofago", "oofago", "o\u017fophago"], "contexts": ["esophagus", "tube for swallowing"]}, {"entity_id": "\u0153sophagus", "book_id": "first_principles_spencer_1862", "name": "\u0153sophagus", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["\u0153sophagus"], "contexts": ["tube for swallowing food"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "oesophagus", "target_book": "polyanthea_medicinal", "target_name": "Ofofago", "similarity": 0.904}, {"source_book": "origin_of_species_darwin_1859", "source_name": "oesophagus", "target_book": "first_principles_spencer_1862", "target_name": "\u0153sophagus", "similarity": 0.963}, {"source_book": "polyanthea_medicinal", "source_name": "Ofofago", "target_book": "first_principles_spencer_1862", "target_name": "\u0153sophagus", "similarity": 0.905}], "id": 931, "stable_key": "clu_702dd0df973e4185", "ground_truth": {"modern_name": "Esophagus", "confidence": "high", "type": "anatomy", "note": "The cluster includes variations like 'oesophagus' and 'Ofofago', which are historical spellings of the modern anatomical term.", "wikidata_id": "Q173710", "wikidata_description": "vertebrate organ through which food passes to the stomach", "wikipedia_url": "https://en.wikipedia.org/wiki/Esophagus", "wikipedia_extract": "The esophagus (American English) or oesophagus (British English) ( ) is an organ in vertebrates through which food passes, aided by peristaltic contractions, from the pharynx to the stomach. The esophagus is a fibromuscular tube, about 25 cm (10 in) long in adult humans, that travels behind the trachea and heart, passes through the diaphragm, and empties into the uppermost region of the stomach. During swallowing, the epiglottis tilts backwards to prevent food from going down the larynx and lungs. The word esophagus is from Ancient Greek \u03bf\u1f30\u03c3\u03bf\u03c6\u03ac\u03b3\u03bf\u03c2 (oisoph\u00e1gos), from \u03bf\u1f34\u03c3\u03c9 (o\u00eds\u014d), future form of \u03c6\u03ad\u03c1\u03c9 (ph\u00e9r\u014d, \"I carry\") + \u1f14\u03c6\u03b1\u03b3\u03bf\u03bd (\u00e9phagon, \"I ate\"). The wall of the esophagus from the lumen outwards consists of mucosa, submucosa (connective tissue), layers of muscle fibers between layers of fibrous tissue, and an outer layer of connective tissue. The mucosa is a stratified squamous epithelium of around three layers of squamous cells, which contrasts to the single layer of columnar cells of the stomach."}}, {"canonical_name": "caf\u00e9", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 32, "members": [{"entity_id": "caf\u00e9", "book_id": "relation_historique_humboldt_vol3_1825", "name": "caf\u00e9", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 30, "variants": ["CAF\u00c9", "caf\u00e9", "Caf\u00e9"], "contexts": ["precious production from Caracas", "cultivated plant for export"]}, {"entity_id": "coffee", "book_id": "kosmos_humboldt_1845", "name": "coffee", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["coffee"], "contexts": ["plant requiring hot climate"]}, {"entity_id": "coffee", "book_id": "first_principles_spencer_1862", "name": "coffee", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["coffee"], "contexts": ["beverage plant"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "caf\u00e9", "target_book": "kosmos_humboldt_1845", "target_name": "coffee", "similarity": 0.947}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "caf\u00e9", "target_book": "first_principles_spencer_1862", "target_name": "coffee", "similarity": 0.947}, {"source_book": "kosmos_humboldt_1845", "source_name": "coffee", "target_book": "first_principles_spencer_1862", "target_name": "coffee", "similarity": 1.0}], "id": 932, "stable_key": "clu_389c828435d0cf65", "ground_truth": {"modern_name": "Coffee", "confidence": "high", "type": "plant", "linnaean": "Coffea L.", "family": "Rubiaceae", "wikidata_id": "Q156354", "wikidata_description": "genus of flowering plants in the family Rubiaceae", "wikipedia_url": "https://en.wikipedia.org/wiki/Coffea", "wikipedia_extract": "Coffea is a genus of flowering plants in the family Rubiaceae. Coffea species are shrubs or small trees native to tropical and southern Africa and tropical Asia. The seeds of some species, called coffee beans, are used to flavor various beverages and products. The fruits, like the seeds, contain a large amount of caffeine, and have a distinct sweet taste. The plant ranks as one of the world's most valuable and widely traded commodity crops and is an important export product of several countries, including those in Central and South America, the Caribbean and Africa. The coffee trade relies heavily on two of the over 120 species, Coffea arabica (commonly known simply as \"Arabica\"), which accounts for 60\u201380% of the world's coffee production, and Coffea canephora (known as \"Robusta\"), which accounts for about 20\u201340%."}}, {"canonical_name": "Kant", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 32, "members": [{"entity_id": "kant", "book_id": "principles_of_psychology_james_1890", "name": "Kant", "category": "PERSON", "subcategory": "SCHOLAR", "count": 24, "variants": ["Kant"], "contexts": ["philosopher of causation", "philosopher influential in epistemology"]}, {"entity_id": "kant", "book_id": "kosmos_humboldt_1845", "name": "Kant", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Kant"], "contexts": ["author of Metaphysische Anfangsgrunde der Naturwissenschaft", "philosopher cited for Metaphysical Principles"]}, {"entity_id": "kant", "book_id": "first_principles_spencer_1862", "name": "Kant", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Kant"], "contexts": ["philosopher influencing psychology", "philosopher who theorized about space and time"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Kant", "target_book": "kosmos_humboldt_1845", "target_name": "Kant", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Kant", "target_book": "first_principles_spencer_1862", "target_name": "Kant", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Kant", "target_book": "first_principles_spencer_1862", "target_name": "Kant", "similarity": 1.0}], "id": 933, "stable_key": "clu_7081319ead355ce9", "ground_truth": {"modern_name": "Immanuel Kant", "confidence": "high", "type": "person", "birth_year": 1724, "death_year": 1804, "description": "Prussian philosopher, central figure in modern philosophy."}}, {"canonical_name": "Tides", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 32, "members": [{"entity_id": "tides", "book_id": "kosmos_humboldt_1845", "name": "Tides", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["tides", "Tides"], "contexts": ["oceanic movements", "propagation causes sea movement"]}, {"entity_id": "tides", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Tides", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 21, "variants": ["tides", "Tides"], "contexts": ["rise and fall of sea levels", "rise and fall of sea surface"]}, {"entity_id": "tide", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tide", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["tide"], "contexts": ["raised in the Atlantic", "rise and fall of sea levels"]}, {"entity_id": "tides", "book_id": "first_principles_spencer_1862", "name": "tides", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["tides"], "contexts": ["oceanic phenomenon influenced by moon and sun", "aqueous agency originating from astronomical motion"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Tides", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Tides", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "tide", "target_book": "first_principles_spencer_1862", "target_name": "tides", "similarity": 0.913}], "id": 934, "stable_key": "clu_44fc1650813f3fae", "ground_truth": {"modern_name": "Tides", "confidence": "high", "type": "concept", "note": "The cluster explicitly mentions 'Tides' and 'tide' in contexts related to oceanic movements and sea levels, directly corresponding to the modern concept of tides.", "wikidata_id": "Q7800866", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Tidestromia", "wikipedia_extract": "Tidestromia is a genus with about six or seven species of annual or subshrub perennial plants native to desert and semi-arid regions of the western United States, Mexico and tropical America in the family Amaranthaceae. A common name of some species is honeysweet. The stems are reddish and contrast conspicuously with the silvery leaves. This genus is named for the botanist Ivar Tidestrom. Tidestromia carnosa - fleshy honeysweet Tidestromia gemmata - TransPecos honeysweet Tidestromia lanuginosa - woolly tidestromia Tidestromia oblongifolia - Arizona honeysweet Tidestromia suffruticosa - shrubby honeysweet Everitt, J.H.; Lonard, R.L.; Little, C.R. (2007)."}}, {"canonical_name": "Cordilleras", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 31, "members": [{"entity_id": "cordill\u00e8res", "book_id": "epoques_nature_buffon_1778", "name": "Cordill\u00e8res", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Cordill\u00e8res"], "contexts": ["mountain range in America"]}, {"entity_id": "cordill\u00e8re", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cordill\u00e8re", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["Cordill\u00e8re"], "contexts": ["steep slope of a granite mountain range", "mountain range forming water divide"]}, {"entity_id": "cordilleras", "book_id": "kosmos_humboldt_1845", "name": "Cordilleras", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 21, "variants": ["Cordilleras"], "contexts": ["mountainous region with woody valleys", "mountain range with deep valleys"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Cordill\u00e8res", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Cordill\u00e8re", "similarity": 0.959}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Cordill\u00e8res", "target_book": "kosmos_humboldt_1845", "target_name": "Cordilleras", "similarity": 0.899}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cordill\u00e8re", "target_book": "kosmos_humboldt_1845", "target_name": "Cordilleras", "similarity": 0.909}], "id": 935, "stable_key": "clu_0e4d3f8484389e2c-4", "ground_truth": {"modern_name": "Andes", "confidence": "high", "type": "place", "country": "South America", "wikidata_id": "Q10411246", "wikidata_description": "genus of insects", "note": "The term 'Cordilleras' or 'Cordill\u00e8res' historically referred to this mountain range."}}, {"canonical_name": "Trementina", "category": "PLANT", "subcategory": "RESIN", "book_count": 3, "total_mentions": 31, "members": [{"entity_id": "trementina", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "trementina", "category": "PLANT", "subcategory": "RESIN", "count": 9, "variants": ["Trementina", "trementina"], "contexts": ["ingredient in Indian oil preparation", "resin harvested in Spain"]}, {"entity_id": "trementina", "book_id": "coloquios_da_orta_1563", "name": "trementina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["trementina"], "contexts": ["turpentine", "resin with similar virtue"]}, {"entity_id": "trementina", "book_id": "ricettario_fiorentino_1597", "name": "Trementina", "category": "PLANT", "subcategory": "RESIN", "count": 20, "variants": ["Trementina", "Trementina Venetiana", "Trementina lanata", "trementina"], "contexts": ["plant resin, turpentine", "resin, likely turpentine"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "trementina", "target_book": "coloquios_da_orta_1563", "target_name": "trementina", "similarity": 0.794}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "trementina", "target_book": "ricettario_fiorentino_1597", "target_name": "Trementina", "similarity": 0.989}, {"source_book": "coloquios_da_orta_1563", "source_name": "trementina", "target_book": "ricettario_fiorentino_1597", "target_name": "Trementina", "similarity": 0.775}], "id": 936, "stable_key": "clu_71946b7bbddd7ee4", "ground_truth": {"modern_name": "Turpentine", "confidence": "high", "type": "plant", "family": "Pinaceae", "note": "The term 'trementina' historically referred to turpentine, often derived from various coniferous trees.", "wikidata_id": "Q63045", "wikidata_description": "species of plant native to the Mediterranean region", "wikipedia_url": "https://en.wikipedia.org/wiki/Pistacia%20terebinthus", "wikipedia_extract": "Pistacia terebinthus, also called the terebinth,  is a deciduous shrub species of the genus Pistacia, native to the Mediterranean region from the western regions of Morocco and Portugal to Greece and western and southeastern Turkey. At one time terebinths growing on the eastern shores of the Mediterranean Sea  were regarded as a separate species, Pistacia palaestina, but these are now considered to be a synonym of P. terebinthus. The terebinth is a deciduous flowering plant belonging to the cashew family, Anacardiaceae; a small tree or large shrub, it grows to 10 m (33 ft) tall. The leaves are compound, 10\u201320 cm (3.9\u20137.9 in) long, odd pinnate with five to eleven opposite glossy oval leaflets, the leaflets 2\u20136 cm (0.79\u20132.36 in) long and 1\u20133 cm (0.39\u20131.18 in) broad. The flowers are reddish-purple, appearing with the new leaves in early spring.", "linnaean": "Pinus"}}, {"canonical_name": "oxygen", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 31, "members": [{"entity_id": "oxygenous", "book_id": "kosmos_humboldt_1845", "name": "oxygenous", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["oxygenous"], "contexts": ["content of swimming bladders"]}, {"entity_id": "oxygen", "book_id": "connexion_physical_sciences_somerville_1858", "name": "oxygen", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 22, "variants": ["oxygen", "Oxygen"], "contexts": ["element in protoxides", "element in water compound"]}, {"entity_id": "oxygen", "book_id": "first_principles_spencer_1862", "name": "oxygen", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 8, "variants": ["oxygen"], "contexts": ["chemical element involved in combustion", "gas released by plants"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "oxygenous", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "oxygen", "similarity": 0.96}, {"source_book": "kosmos_humboldt_1845", "source_name": "oxygenous", "target_book": "first_principles_spencer_1862", "target_name": "oxygen", "similarity": 0.96}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "oxygen", "target_book": "first_principles_spencer_1862", "target_name": "oxygen", "similarity": 1.0}], "id": 937, "stable_key": "clu_b365fc40f2e8aba7", "ground_truth": {"modern_name": "oxygen", "confidence": "high", "type": "chemical", "wikidata_id": "Q629", "wikidata_description": "chemical element with symbol O and atomic number 8"}}, {"canonical_name": "modification", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 30, "members": [{"entity_id": "modification", "book_id": "origin_of_species_darwin_1859", "name": "modification", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 26, "variants": ["modification"], "contexts": ["change in form or structure", "change in biological forms over time"]}, {"entity_id": "modifications", "book_id": "origin_of_species_darwin_1859", "name": "modifications", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["modifications"], "contexts": ["changes in organisms over time", "changes over time"]}, {"entity_id": "modifications", "book_id": "principles_of_psychology_james_1890", "name": "modifications", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["modifications"], "contexts": ["changes or alterations"]}, {"entity_id": "modifications", "book_id": "first_principles_spencer_1862", "name": "modifications", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["modifications"], "contexts": ["changes in form"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "modification", "target_book": "principles_of_psychology_james_1890", "target_name": "modifications", "similarity": 0.934}, {"source_book": "origin_of_species_darwin_1859", "source_name": "modification", "target_book": "first_principles_spencer_1862", "target_name": "modifications", "similarity": 0.934}, {"source_book": "origin_of_species_darwin_1859", "source_name": "modifications", "target_book": "principles_of_psychology_james_1890", "target_name": "modifications", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "modifications", "target_book": "first_principles_spencer_1862", "target_name": "modifications", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "modifications", "target_book": "first_principles_spencer_1862", "target_name": "modifications", "similarity": 1.0}], "id": 938, "stable_key": "clu_f61cf96cef849460-2", "ground_truth": {"modern_name": "Evolution", "confidence": "high", "type": "concept", "note": "The overwhelming frequency of 'Evolution' in Spencer's and James's works, along with the contexts 'biological change' and 'development across animal species,' clearly points to the scientific concept of evolution.", "wikidata_id": "Q4038411", "wikidata_description": "monthly scientific journal", "wikipedia_url": "https://en.wikipedia.org/wiki/Evolution", "wikipedia_extract": "Evolution is the change in the heritable characteristics of biological populations over successive generations. It occurs when evolutionary processes such as genetic drift and natural selection act on genetic variation, resulting in certain characteristics becoming more or less common within a population over successive generations. The process of evolution has given rise to biodiversity at every level of biological organisation. The scientific theory of evolution by natural selection was conceived independently by two British naturalists, Charles Darwin and Alfred Russel Wallace, in the mid-19th century as an explanation for why organisms are adapted to their physical and biological environments. The theory was first set out in detail in Darwin's book On the Origin of Species. Evolution by natural selection is established by observable facts about living organisms: (1) more offspring are often produced than can possibly survive; (2) traits vary among individuals with respect to their morphology, physiology, and behaviour; (3) different traits confer different rates of survival and reproduction (differential fitness); and (4) traits can be passed from generation to generation (heritability of fitness)."}}, {"canonical_name": "gengibre", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 30, "members": [{"entity_id": "gengibre", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "gengibre", "category": "PLANT", "subcategory": "ROOT", "count": 4, "variants": ["gengibre", "GENGIBRE"], "contexts": ["plant with similar leaves to gengibre macho", "common name for ginger"]}, {"entity_id": "gengibre", "book_id": "historia_medicinal_monardes_1574", "name": "Gengibre", "category": "PLANT", "subcategory": "ROOT", "count": 5, "variants": ["Gengibre"], "contexts": ["green ginger brought from there", "a plant root"]}, {"entity_id": "gengibre", "book_id": "polyanthea_medicinal", "name": "gengibre", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 21, "variants": ["gengibre", "gengi", "gengi bre", "gengivre", "gingibre"], "contexts": ["ingredient in a wine remedy", "ginger used in collyrium"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "gengibre", "target_book": "historia_medicinal_monardes_1574", "target_name": "Gengibre", "similarity": 0.865}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "gengibre", "target_book": "polyanthea_medicinal", "target_name": "gengibre", "similarity": 0.882}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Gengibre", "target_book": "polyanthea_medicinal", "target_name": "gengibre", "similarity": 0.794}], "id": 939, "stable_key": "clu_427dbe98d053f861", "ground_truth": {"modern_name": "Ginger", "confidence": "high", "type": "plant", "linnaean": "Zingiber officinale Roscoe", "family": "Zingiberaceae", "wikidata_id": "Q35625", "wikidata_description": "plant species", "wikipedia_extract": "Modern ginger beer is a sweetened and carbonated, usually non-alcoholic beverage, a type of soft drink. Historically it was a type of beer brewed by the natural fermentation of prepared ginger spice, yeast and sugar. Modern ginger beers are often manufactured rather than brewed, frequently with flavour and colour additives, with artificial carbonation. The related ginger ales also are not brewed. Ginger beer is still produced at home using a type of symbiotic colony of yeast and Lactobacillus bacteria (SCOBY) known as a \"ginger beer plant\", or from a \"ginger bug\" starter created from fermenting ginger, sugar, and water. Brewed ginger beer originated in Yorkshire in England in the mid-18th century and became popular throughout Britain, the United States, Ireland, South Africa, the Caribbean and Canada, reaching a peak of popularity in the early 20th century.", "wikipedia_url": "https://en.wikipedia.org/wiki/Ginger_beer", "description": "A spicy rhizome used in medicine, cooking, and as a spice."}}, {"canonical_name": "Valencia", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 30, "members": [{"entity_id": "valencia", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Valencia", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Valencia"], "contexts": ["city where plant is used for adornment"]}, {"entity_id": "valencia", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Valencia", "category": "PLACE", "subcategory": "CITY", "count": 19, "variants": ["Valencia", "Valence"], "contexts": ["lake mentioned in map description", "place name in Venezuela"]}, {"entity_id": "nueva_valencia", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Nueva Valencia", "category": "PLACE", "subcategory": "CITY", "count": 7, "variants": ["Nueva Valencia", "Nueva-Valencia"], "contexts": ["city in Caracas province", "city in Venezuela"]}, {"entity_id": "valen-cia", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Valen-cia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Valen-cia", "Valenciana"], "contexts": ["lake in Venezuela", "mine de Valenciana"]}, {"entity_id": "nueva_valencia", "book_id": "kosmos_humboldt_1845", "name": "Nueva Valencia", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Nueva Valencia"], "contexts": ["city near Trincheras hot springs"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Valencia", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Valencia", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Valencia", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Nueva Valencia", "similarity": 0.897}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Valencia", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Valen-cia", "similarity": 0.554}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Valencia", "target_book": "kosmos_humboldt_1845", "target_name": "Nueva Valencia", "similarity": 0.897}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Valencia", "target_book": "kosmos_humboldt_1845", "target_name": "Nueva Valencia", "similarity": 0.897}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Nueva Valencia", "target_book": "kosmos_humboldt_1845", "target_name": "Nueva Valencia", "similarity": 1.0}], "id": 940, "stable_key": "clu_676f40663631234c", "ground_truth": {"modern_name": "Valencia", "confidence": "high", "type": "place", "country": "Venezuela", "note": "The presence of 'Nueva Valencia' and context of Caracas province strongly points to the Venezuelan city.", "wikidata_id": "Q54880", "wikidata_description": "city in Carabobo State, Venezuela", "wikipedia_url": "https://en.wikipedia.org/wiki/Valencia%2C%20Venezuela", "wikipedia_extract": "Valencia (Spanish pronunciation: [ba\u02c8lensja]) is the capital city of Carabobo State and the third-largest city in Venezuela. The city is an economic hub that contains Venezuela's top industries and manufacturing companies. It is also the largest city in the Valencia-Maracay metropolitan region, which with a population of about 4.5 million is the country's second largest after that of Caracas. Caracas lies some 172 kilometres (107 miles) away to the east. The area was already inhabited in the fourth millennium BC. The inhabitants were mainly hunters and gatherers who might have already developed some elementary forms of agriculture."}}, {"canonical_name": "remedio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 30, "members": [{"entity_id": "remedio", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "remedio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["remedio"], "contexts": ["remedy"]}, {"entity_id": "remedio", "book_id": "historia_medicinal_monardes_1574", "name": "remedio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["remedio", "remedios chirurgicales"], "contexts": ["cure or treatment", "remedy"]}, {"entity_id": "remedio", "book_id": "polyanthea_medicinal", "name": "remedio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 25, "variants": ["remedio", "remedios mornos", "remediospurgativos"], "contexts": ["A cure or treatment", "treatment or cure"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "remedio", "target_book": "historia_medicinal_monardes_1574", "target_name": "remedio", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "remedio", "target_book": "polyanthea_medicinal", "target_name": "remedio", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "remedio", "target_book": "polyanthea_medicinal", "target_name": "remedio", "similarity": 1.0}], "id": 941, "stable_key": "clu_090a45ce1e9d3684", "ground_truth": {"modern_name": "Remedy", "confidence": "high", "type": "concept", "description": "A medicine or treatment for a disease or injury.", "note": "'Remedio' is the Spanish/Portuguese word for remedy.", "wikipedia_extract": "Remedio is an Israeli cybersecurity company based in Tel Aviv. Founded in 2019 by cybersecurity entrepreneurs Tal Kollender, Gilad Raz, and Yakov Kogan, the company develops an AI-driven platform for device posture management, automated configuration hardening, and risk remediation. Remedio began in 2019 under the name GYTPOL, founded by Tal Kollender (CEO), Gilad Raz, and Yakov Kogan. That same year, Israel Aerospace Industries (IAI) became the company\u2019s first customer. GYTPOL\u2019s platform addressed the problem of hidden misconfigurations on enterprise endpoints. Check Point Software Technologies, a multinational cybersecurity company, was its first cybersecurity customer."}}, {"canonical_name": "Russie", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 29, "members": [{"entity_id": "russie", "book_id": "medecine_experimentale_bernard_1865", "name": "Russie", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Russie"], "contexts": ["country building large physiological institutes"]}, {"entity_id": "russie", "book_id": "epoques_nature_buffon_1778", "name": "Russie", "category": "PLACE", "subcategory": "COUNTRY", "count": 7, "variants": ["Russie"], "contexts": ["location where ivory is found", "Russia"]}, {"entity_id": "russie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Russie", "category": "PLACE", "subcategory": "COUNTRY", "count": 21, "variants": ["Russie", "Russie ' europ\u00e9enne", "Russie europ\u00e9enne"], "contexts": ["country west of the Urals", "country used for territorial comparison"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Russie", "target_book": "epoques_nature_buffon_1778", "target_name": "Russie", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Russie", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Russie", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Russie", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Russie", "similarity": 1.0}], "id": 942, "stable_key": "clu_b4dcc04fddbbb994", "ground_truth": {"modern_name": "Russia", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q159", "wikidata_description": "country in Eastern Europe and Northern Asia", "wikipedia_url": "https://en.wikipedia.org/wiki/Russia"}}, {"canonical_name": "Gall", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 29, "members": [{"entity_id": "gall", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Gall", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 9, "variants": ["Gall", "gall"], "contexts": ["mundificative substance", "organ for storing bile"]}, {"entity_id": "gall_of_a_man", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "gall of a man", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["gall of a man"], "contexts": ["organ where triangular stones are found"]}, {"entity_id": "gall", "book_id": "english_physician_1652", "name": "Gall", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 15, "variants": ["Gall", "Gaul"], "contexts": ["bile, fluid produced by the liver", "organ affected by obstructions"]}, {"entity_id": "gall", "book_id": "principles_of_psychology_james_1890", "name": "gall", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["gall", "Gall"], "contexts": ["founder of phrenology", "co-founder of phrenology"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gall", "target_book": "english_physician_1652", "target_name": "Gall", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gall", "target_book": "principles_of_psychology_james_1890", "target_name": "gall", "similarity": 0.586}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "gall of a man", "target_book": "english_physician_1652", "target_name": "Gall", "similarity": 0.897}, {"source_book": "english_physician_1652", "source_name": "Gall", "target_book": "principles_of_psychology_james_1890", "target_name": "gall", "similarity": 0.586}], "id": 943, "stable_key": "clu_bf373224f813fc6b-2", "ground_truth": {"modern_name": "Bile", "confidence": "high", "type": "chemical", "note": "The term 'gall' in early modern texts often referred to bile, a fluid produced by the liver, but could also refer to the gallbladder itself or gallstones.", "wikidata_id": "Q208006", "wikidata_description": "central district and city in Bilecik Province, Turkey", "wikipedia_url": "https://en.wikipedia.org/wiki/Bilecik", "wikipedia_extract": "Bilecik is a city in northwestern Anatolia, Turkey. It is the seat of Bilecik Province and Bilecik District. Its population is 74,457 (2021). The mayor is Melek M\u0131zrak Suba\u015f\u0131 (CHP). The town is famous for its numerous restored Turkish houses. It is increasingly becoming more attractive to tourists.", "description": "A humor of the body, associated with illness and bodily functions."}}, {"canonical_name": "lethargo", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 3, "total_mentions": 29, "members": [{"entity_id": "lithargia", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Lithargia", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["Lithargia"], "contexts": ["medical condition related to oblivion"]}, {"entity_id": "lethargy", "book_id": "english_physician_1652", "name": "Lethargy", "category": "DISEASE", "subcategory": "CHRONIC", "count": 10, "variants": ["Lethargy", "Lethargie"], "contexts": ["condition treated with Brooklime mixture", "state of abnormal drowsiness"]}, {"entity_id": "lethargo", "book_id": "polyanthea_medicinal", "name": "lethargo", "category": "DISEASE", "subcategory": "CHRONIC", "count": 18, "variants": ["lethargo", "Letargo", "Letargos", "Letharg.", "Lethargo", "Lethargos", "letargo", "lethargicos", "lethargum", "lethargy"], "contexts": ["a condition of excessive sleepiness", "a somnolent condition"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lithargia", "target_book": "english_physician_1652", "target_name": "Lethargy", "similarity": 0.888}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lithargia", "target_book": "polyanthea_medicinal", "target_name": "lethargo", "similarity": 0.884}, {"source_book": "english_physician_1652", "source_name": "Lethargy", "target_book": "polyanthea_medicinal", "target_name": "lethargo", "similarity": 0.976}], "id": 944, "stable_key": "clu_6f606076a31d6cd6", "ground_truth": {"modern_name": "Lethargy", "confidence": "high", "type": "disease", "modern_term": "Lethargy", "note": "The description points to profound lethargy in febrile patients, aligning with the modern understanding of lethargy as a symptom or condition of excessive tiredness and sluggishness, often associated with illness.", "wikidata_id": "Q15637420", "wikidata_description": "state of tiredness, weariness, fatigue, or lack of energy", "wikipedia_url": "https://en.wikipedia.org/wiki/Lethargy", "wikipedia_extract": "Lethargy is a state of tiredness, sleepiness, weariness, fatigue, sluggishness, or lack of energy. It can be accompanied by depression, decreased motivation, or apathy. Lethargy can be a normal response to inadequate sleep, overexertion, overworking, stress, lack of exercise, improper nutrition, drug abuse, boredom, or a symptom of an underlying illness or disorder. It may also be a side effect of medication or caused by an interaction between medications and alcohol. It may also be an altered level of consciousness. When part of a normal response, lethargy often resolves with rest, adequate sleep, decreased stress, physical exercise, and good nutrition.", "description": "A medical condition characterized by abnormal drowsiness or sleepiness."}}, {"canonical_name": "Cayenne", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 29, "members": [{"entity_id": "cayenne", "book_id": "epoques_nature_buffon_1778", "name": "Cayenne", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Cayenne"], "contexts": ["river in Guyane", "city where lime is transported for building"]}, {"entity_id": "cayenne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cayenne", "category": "PLACE", "subcategory": "CITY", "count": 22, "variants": ["Cayenne"], "contexts": ["capital of French Guiana", "region south of which plains extend"]}, {"entity_id": "cayenne", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cayenne", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Cayenne"], "contexts": ["location of pendulum observation", "location for pendulum variation"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Cayenne", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Cayenne", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Cayenne", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cayenne", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cayenne", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cayenne", "similarity": 1.0}], "id": 945, "stable_key": "clu_9a799d4a551aa66c", "ground_truth": {"modern_name": "Cayenne", "confidence": "high", "type": "place", "country": "France", "note": "Cayenne is the capital of French Guiana, a territory often referenced in historical scientific and geographic accounts.", "wikidata_id": "Q44401", "wikidata_description": "commune and capital city of French Guiana"}}, {"canonical_name": "Nose", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 29, "members": [{"entity_id": "nose", "book_id": "english_physician_1652", "name": "Nose", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 21, "variants": ["Nose"], "contexts": ["body part from which bleeding is stanched", "body part, plant juice helps breath"]}, {"entity_id": "nose", "book_id": "principles_of_psychology_james_1890", "name": "nose", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 7, "variants": ["nose"], "contexts": ["organ for smelling and breathing", "part of the face"]}, {"entity_id": "nose", "book_id": "polyanthea_medicinal", "name": "nose", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["nose"], "contexts": ["part of the face"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Nose", "target_book": "principles_of_psychology_james_1890", "target_name": "nose", "similarity": 0.98}, {"source_book": "english_physician_1652", "source_name": "Nose", "target_book": "polyanthea_medicinal", "target_name": "nose", "similarity": 0.98}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nose", "target_book": "polyanthea_medicinal", "target_name": "nose", "similarity": 1.0}], "id": 946, "stable_key": "clu_f1301c11ae3ddab7-2", "ground_truth": {"modern_name": "Nose", "confidence": "high", "type": "anatomy", "description": "The part of the face used for smelling and breathing.", "wikipedia_extract": "A nose is a sensory organ and respiratory structure in vertebrates. It consists of a nasal cavity inside the head, and an external nose on the face. The external nose houses the nostrils, or nares, a pair of tubes providing airflow through the nose for respiration. Where the nostrils pass through the nasal cavity they widen, are known as nasal fossae, and contain turbinates and olfactory mucosa. The nasal cavity also connects to the paranasal sinuses (dead-end air cavities for pressure buffering and humidification). From the nasal cavity, the nostrils continue into the pharynx, a switch track valve connecting the respiratory and digestive systems."}}, {"canonical_name": "Cape of Good Hope", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 29, "members": [{"entity_id": "cape_of_good_hope", "book_id": "origin_of_species_darwin_1859", "name": "Cape of Good Hope", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Cape of Good Hope"], "contexts": ["region with uncivilised man", "region with many plant species"]}, {"entity_id": "cape_of_good_hope", "book_id": "kosmos_humboldt_1845", "name": "Cape of Good Hope", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 12, "variants": ["Cape of Good Hope"], "contexts": ["location of correspondent", "location where John Herschel saw satellites"]}, {"entity_id": "cape_of_good_hope", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cape of Good Hope", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["Cape of Good Hope"], "contexts": ["location for parallax observation", "southern tip of Africa"]}, {"entity_id": "good_hope,_the_cape_of", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Good Hope, the Cape of", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Good Hope, the Cape of"], "contexts": ["icebergs drifted to"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Cape of Good Hope", "target_book": "kosmos_humboldt_1845", "target_name": "Cape of Good Hope", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Cape of Good Hope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cape of Good Hope", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Cape of Good Hope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Good Hope, the Cape of", "similarity": 0.933}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cape of Good Hope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cape of Good Hope", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cape of Good Hope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Good Hope, the Cape of", "similarity": 0.933}], "id": 947, "stable_key": "clu_8489b5cddb68c745", "ground_truth": {"modern_name": "Cape of Good Hope", "confidence": "high", "type": "place", "country": "South Africa", "wikidata_id": "Q370736", "wikidata_description": "Dutch and British colony in Southern Africa", "wikipedia_url": "https://en.wikipedia.org/wiki/Cape%20Colony", "wikipedia_extract": "The Cape Colony (Dutch: Kaapkolonie), also known as the Cape of Good Hope, was a British colony in present-day South Africa named after the Cape of Good Hope. It existed from 1795 to 1802, and again from 1806 to 1910, when it united with three other colonies to form the Union of South Africa, then became the Cape Province, which existed even after 1961, when South Africa had become a republic, albeit temporarily outside the Commonwealth of Nations (1961\u201394). The British colony was preceded by an earlier corporate colony that became an original Dutch colony of the same name, which was established in 1652 by the Dutch East India Company (VOC). The Cape was under VOC rule from 1652 to 1795 and under rule of the Napoleonic Batavia Republic from 1803 to 1806. The VOC lost the colony to Great Britain following the 1795 Battle of Muizenberg, but it was ceded to the Batavia Republic following the 1802 Treaty of Amiens. It was re-occupied by the British following the Battle of Blaauwberg in 1806, and British possession affirmed with the Anglo-Dutch Treaty of 1814."}}, {"canonical_name": "Religiofo", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 29, "members": [{"entity_id": "religioso", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Religioso", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Religioso"], "contexts": ["religious person"]}, {"entity_id": "religiosos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "religiosos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["religiosos"], "contexts": ["religious individuals"]}, {"entity_id": "religieuses", "book_id": "relation_historique_humboldt_vol3_1825", "name": "religieuses", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["religieuses", "religieux"], "contexts": ["nuns not included in census", "extinguished subterranean fire with holy water"]}, {"entity_id": "religiofo", "book_id": "polyanthea_medicinal", "name": "Religiofo", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 25, "variants": ["Religiofo", "Religiofo Cartuxo", "Religiofo Pauli\u017fta", "Religiofo Trino", "Religiofo do Carmo", "Religiofos", "Religiofos Trinos", "Religiofos de Sao Bernardo", "Religiosa", "Religiosos", "Religiosos Trinos", "Religio\u017fo"], "contexts": ["religious figure who assisted the dying", "religious individual"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Religioso", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "religieuses", "similarity": 0.918}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Religioso", "target_book": "polyanthea_medicinal", "target_name": "Religiofo", "similarity": 0.941}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "religiosos", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "religieuses", "similarity": 0.956}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "religiosos", "target_book": "polyanthea_medicinal", "target_name": "Religiofo", "similarity": 0.951}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "religieuses", "target_book": "polyanthea_medicinal", "target_name": "Religiofo", "similarity": 0.928}], "id": 948, "stable_key": "clu_60d12676babc48f0", "ground_truth": {"modern_name": "Nun", "confidence": "medium", "type": "person", "description": "Religious woman, often in a monastic order, providing care.", "note": "The term 'Religiofo' (and its plural 'religieuses') can refer to any religious person, but in the context of assisting the dying and monastic communities, 'nun' is the most likely specific referent for female religious.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "incenso", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 29, "members": [{"entity_id": "incenso", "book_id": "coloquios_da_orta_1563", "name": "incenso", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 11, "variants": ["incenso", "Encenso", "encenso"], "contexts": ["ingredient in falcon plaster", "restricted drug traded with China"]}, {"entity_id": "incenso", "book_id": "ricettario_fiorentino_1597", "name": "Incenso", "category": "PLANT", "subcategory": "RESIN", "count": 11, "variants": ["Incenso", "incenso", "INCENSO"], "contexts": ["fragrant resin", "incense, a fragrant resin"]}, {"entity_id": "incenso", "book_id": "polyanthea_medicinal", "name": "Incenso", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["incenso", "Incenso"], "contexts": ["aromatic resin used in medicine", "incense, a resin"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "incenso", "target_book": "ricettario_fiorentino_1597", "target_name": "Incenso", "similarity": 0.481}, {"source_book": "coloquios_da_orta_1563", "source_name": "incenso", "target_book": "polyanthea_medicinal", "target_name": "Incenso", "similarity": 0.715}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Incenso", "target_book": "polyanthea_medicinal", "target_name": "Incenso", "similarity": 0.672}], "id": 949, "stable_key": "clu_b4c07ea1cafd6b2b", "ground_truth": {"modern_name": "Frankincense", "confidence": "high", "type": "plant", "linnaean": "Boswellia sacra", "family": "Burseraceae", "note": " 'Incenso' in early modern Portuguese and Italian texts typically refers to frankincense, derived from Boswellia species.", "wikidata_id": "Q133964", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Boswellia%20sacra", "wikipedia_extract": "Boswellia sacra, also known as Boswellia carteri and others, and commonly called the frankincense tree or the olibanum tree, is a tree in the genus Boswellia, in the Burseraceae family, from which frankincense, a resinous dried sap, is harvested. The olibanum tree is a plant native to the countries of Oman and Yemen, in the south of the Arabian Peninsula, and to Somalia and Ethiopia, in the Horn of Africa. In 2012, it was replanted in Israel in the Middle East, 1,500 years after dying out there. The Boswellia sacra species is a small deciduous tree that grows to a height of 2 to 8 m (6 ft 7 in to 26 ft 3 in), with one or more trunks. The bark has the texture of paper and can be easily removed. The tree has compound leaves and an odd number of leaflets that grow opposite to one another; the small, yellow-white flowers are gathered in axillary clusters composed of five petals, ten stamens, and a cup with five teeth; new leaves feature a downy covering.", "description": "Resinous tree producing aromatic incense, also used medicinally."}}, {"canonical_name": "pathologie", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 3, "total_mentions": 28, "members": [{"entity_id": "pathologie", "book_id": "medecine_experimentale_bernard_1865", "name": "pathologie", "category": "CONCEPT", "subcategory": "THEORY", "count": 26, "variants": ["pathologie"], "contexts": ["study of diseases", "the study of diseases"]}, {"entity_id": "pathology", "book_id": "kosmos_humboldt_1845", "name": "pathology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["pathology"], "contexts": ["study of disease"]}, {"entity_id": "pathology", "book_id": "first_principles_spencer_1862", "name": "Pathology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Pathology"], "contexts": ["study of the causes and effects of diseases"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "pathologie", "target_book": "kosmos_humboldt_1845", "target_name": "pathology", "similarity": 0.985}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "pathologie", "target_book": "first_principles_spencer_1862", "target_name": "Pathology", "similarity": 0.956}, {"source_book": "kosmos_humboldt_1845", "source_name": "pathology", "target_book": "first_principles_spencer_1862", "target_name": "Pathology", "similarity": 0.977}], "id": 950, "stable_key": "clu_1e1c77e80e01beae", "ground_truth": {"modern_name": "Pathology", "confidence": "high", "type": "concept", "wikidata_id": "Q7208", "wikidata_description": "study and diagnosis of disease"}}, {"canonical_name": "organism", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 28, "members": [{"entity_id": "animal_vivant", "book_id": "medecine_experimentale_bernard_1865", "name": "animal vivant", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["animal vivant"], "contexts": ["source of pancreatic juice"]}, {"entity_id": "organisms", "book_id": "kosmos_humboldt_1845", "name": "organisms", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["organisms"], "contexts": ["living beings in nature", "ancient and recent organisms"]}, {"entity_id": "organism", "book_id": "first_principles_spencer_1862", "name": "organism", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 23, "variants": ["organism"], "contexts": ["a living biological entity", "changes fitted to meet environmental changes"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "animal vivant", "target_book": "first_principles_spencer_1862", "target_name": "organism", "similarity": 0.953}, {"source_book": "kosmos_humboldt_1845", "source_name": "organisms", "target_book": "first_principles_spencer_1862", "target_name": "organism", "similarity": 0.972}], "id": 951, "stable_key": "clu_d82ee4e6a6464009", "ground_truth": {"modern_name": "Organism", "confidence": "high", "type": "concept", "wikidata_id": "Q55983715", "wikidata_description": "organisms which have been assigned common names in addition to their taxon name"}}, {"canonical_name": "cognition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 28, "members": [{"entity_id": "cognition", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "cognition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cognition"], "contexts": ["mental process of knowing"]}, {"entity_id": "cognition", "book_id": "principles_of_psychology_james_1890", "name": "cognition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["Cognition", "cognition"], "contexts": ["faculty of knowing and understanding", "mental process of acquiring knowledge"]}, {"entity_id": "cognitions", "book_id": "principles_of_psychology_james_1890", "name": "cognitions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["cognitions"], "contexts": ["mental phenomena", "mental acts of knowing"]}, {"entity_id": "cognition", "book_id": "first_principles_spencer_1862", "name": "cognition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["cognition"], "contexts": ["process of acquiring knowledge", "the process of knowing"]}, {"entity_id": "cognitions", "book_id": "first_principles_spencer_1862", "name": "cognitions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["cognitions"], "contexts": ["mental representations of reality", "mental contents or products of thinking"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "cognition", "target_book": "principles_of_psychology_james_1890", "target_name": "cognition", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "cognition", "target_book": "principles_of_psychology_james_1890", "target_name": "cognitions", "similarity": 0.954}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "cognition", "target_book": "first_principles_spencer_1862", "target_name": "cognition", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "cognition", "target_book": "first_principles_spencer_1862", "target_name": "cognitions", "similarity": 0.954}, {"source_book": "principles_of_psychology_james_1890", "source_name": "cognition", "target_book": "first_principles_spencer_1862", "target_name": "cognition", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "cognition", "target_book": "first_principles_spencer_1862", "target_name": "cognitions", "similarity": 0.954}, {"source_book": "principles_of_psychology_james_1890", "source_name": "cognitions", "target_book": "first_principles_spencer_1862", "target_name": "cognition", "similarity": 0.954}, {"source_book": "principles_of_psychology_james_1890", "source_name": "cognitions", "target_book": "first_principles_spencer_1862", "target_name": "cognitions", "similarity": 1.0}], "id": 952, "stable_key": "clu_2deccffb9da4d316", "ground_truth": {"modern_name": "cognition", "confidence": "high", "type": "concept", "wikidata_id": "Q3065932", "wikidata_description": "disease of mental health that affects cognitive functions including memory processing, perception and problem solving", "wikipedia_url": "https://en.wikipedia.org/wiki/Neurocognitive%20disorder", "note": "Early modern concepts of 'intellectual powers' encompassed reasoning, memory, perception, and understanding, aligning with modern cognitive science.", "wikipedia_extract": "Neurocognitive disorders (NCDs), also known as cognitive disorders (CDs), are a category of mental health disorders that primarily affect cognitive abilities including learning, memory, perception, and problem-solving. Neurocognitive disorders include delirium, mild neurocognitive disorders, and major neurocognitive disorder (also known as dementia). They are defined by deficits in cognitive ability that are acquired (as opposed to developmental), typically represent decline, and may have an underlying brain pathology. The DSM-5 defines six key domains of cognitive function: executive function, learning and memory, perceptual-motor function, language, complex attention, and social cognition. Although Alzheimer's disease accounts for the majority of cases of neurocognitive disorders, there are various medical conditions that affect mental functions such as memory, thinking, and the ability to reason, including frontotemporal degeneration, Huntington's disease, dementia with Lewy bodies, traumatic brain injury (TBI), Parkinson's disease, prion disease, and dementia/neurocognitive issues due to HIV infection. Neurocognitive disorders are diagnosed as mild and major based on the severity of their symptoms."}}, {"canonical_name": "Paraguay", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 28, "members": [{"entity_id": "paraguay", "book_id": "epoques_nature_buffon_1778", "name": "Paraguay", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Paraguay"], "contexts": ["geographic location in South America"]}, {"entity_id": "paraguay", "book_id": "origin_of_species_darwin_1859", "name": "Paraguay", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Paraguay"], "contexts": ["location with specific fly affecting animals", "location where cattle are destroyed"]}, {"entity_id": "paraguay", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Paraguay", "category": "PLACE", "subcategory": "COUNTRY", "count": 25, "variants": ["Paraguay"], "contexts": ["province in the first category of census", "territory with boundary commissions"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Paraguay", "target_book": "origin_of_species_darwin_1859", "target_name": "Paraguay", "similarity": 0.886}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Paraguay", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Paraguay", "similarity": 0.886}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Paraguay", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Paraguay", "similarity": 1.0}], "id": 953, "stable_key": "clu_32b4a9316825aff0", "ground_truth": {"modern_name": "Paraguay", "confidence": "high", "type": "place", "description": "A country in South America, historically a province.", "wikipedia_extract": "Paraguay (Guarani: Paragu\u00e1i), officially the Republic of Paraguay, is a landlocked country located in the central region of South America. It borders Bolivia to the northwest and north, Brazil to the northeast and east, and Argentina to the southeast, south, and west. Paraguay has access to the Atlantic Ocean via the Paran\u00e1\u2013Paraguay Waterway. The country is governed as a unitary presidential republic composed of a capital district and seventeen departments. Its capital and largest city is Asunci\u00f3n. The indigenous Guaran\u00ed had been living in eastern Paraguay for at least a millennium before the arrival of Spanish conquistadores in 1524."}}, {"canonical_name": "S\u00e3o Domingos", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 28, "members": [{"entity_id": "s__domingo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "S. Domingo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["S. Domingo"], "contexts": ["island where china plant grows", "island where trees are found"]}, {"entity_id": "s__domingos", "book_id": "coloquios_da_orta_1563", "name": "S. Domingos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["S. Domingos", "Sam Domingos"], "contexts": ["source of Cassia fistula", "island where first tree was created"]}, {"entity_id": "s\u00e3o_domingos", "book_id": "polyanthea_medicinal", "name": "S\u00e3o Domingos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 11, "variants": ["S\u00e3o Domingos", "S. Domingos", "SaoDomingos", "Sa\u00f3 Domingos", "S\u00e2o Domingos"], "contexts": ["location of an apothecary", "location of apothecaries"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "S. Domingo", "target_book": "coloquios_da_orta_1563", "target_name": "S. Domingos", "similarity": 0.972}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "S. Domingo", "target_book": "polyanthea_medicinal", "target_name": "S\u00e3o Domingos", "similarity": 0.948}, {"source_book": "coloquios_da_orta_1563", "source_name": "S. Domingos", "target_book": "polyanthea_medicinal", "target_name": "S\u00e3o Domingos", "similarity": 0.958}], "id": 954, "stable_key": "clu_2b02b8216a10fc1d", "ground_truth": {"modern_name": "Santo Domingo", "confidence": "high", "type": "place", "country": "Dominican Republic", "note": "The cluster includes references to 'Sancto Domingo' and 'S. Domingos', clearly pointing to the city, which was a significant colonial center and a source of botanical materials.", "wikidata_id": "Q55591", "wikidata_description": "municipality of the Philippines in the province of Nueva Ecija", "wikipedia_url": "https://en.wikipedia.org/wiki/Santo%20Domingo%2C%20Nueva%20Ecija", "wikipedia_extract": "Santo Domingo, officially the Municipality of Santo Domingo (Ilocano: Ili ti Santo Domingo; Pangasinan: Baley na Santo Domingo;Tagalog: Bayan ng Santo Domingo), is a municipality in the province of Nueva Ecija, Philippines. According to the 2024 census, it has a population of 63,750 people. The town is named after Saint Dominic, its patron saint. During the last quarter of the 17th century, Ilocos and Bulacan natives and Tagalogs from Cabanatuan migrated to Santo Domingo. They found in the settlement buri palms. Therefore, these people called the site, Pulong Buli."}}, {"canonical_name": "Hodgson", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 28, "members": [{"entity_id": "hodgson", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Hodgson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Hodgson"], "contexts": ["measurer of mountain heights", "measurer of mountain height"]}, {"entity_id": "hodgson", "book_id": "principles_of_psychology_james_1890", "name": "Hodgson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 22, "variants": ["Dr. Hodgson", "Hodgson", "Mr. Hodgson"], "contexts": ["philosopher and psychologist", "quoted author"]}, {"entity_id": "hodgson", "book_id": "kosmos_humboldt_1845", "name": "Hodgson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Hodgson"], "contexts": ["cited in Asiat. Res. for measurement", "provided observations on snow line"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hodgson", "target_book": "principles_of_psychology_james_1890", "target_name": "Hodgson", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hodgson", "target_book": "kosmos_humboldt_1845", "target_name": "Hodgson", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Hodgson", "target_book": "kosmos_humboldt_1845", "target_name": "Hodgson", "similarity": 1.0}], "id": 955, "stable_key": "clu_93709913616b3d81", "ground_truth": {"modern_name": "Hodgson", "confidence": "medium", "type": "person", "description": "Philosopher, psychologist, and measurer of mountain heights.", "note": "The context suggests a scholar named Hodgson, likely connected to psychological or scientific research. Without more context, a specific individual is hard to pinpoint, but figures like Brian Hodgson were prominent in related fields.", "wikidata_id": "Q3317194", "wikidata_description": "genus of plants"}}, {"canonical_name": "Encke", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 28, "members": [{"entity_id": "encke", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Encke", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Encke"], "contexts": ["collaborator in magnetic inclination measurement"]}, {"entity_id": "encke", "book_id": "kosmos_humboldt_1845", "name": "Encke", "category": "PERSON", "subcategory": "SCHOLAR", "count": 12, "variants": ["Encke"], "contexts": ["comet with short period of revolution", "comet discoverer"]}, {"entity_id": "encke", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Encke", "category": "PERSON", "subcategory": "SCHOLAR", "count": 15, "variants": ["Encke"], "contexts": ["associated with a comet", "professor who refined sun's parallax"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Encke", "target_book": "kosmos_humboldt_1845", "target_name": "Encke", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Encke", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Encke", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Encke", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Encke", "similarity": 1.0}], "id": 956, "stable_key": "clu_b0c6fb3728755c4b", "ground_truth": {"modern_name": "Johann Franz Encke", "confidence": "high", "type": "person", "birth_year": 1791, "death_year": 1865, "description": "German astronomer, discoverer of Encke's Comet", "wikidata_id": "Q57294", "wikidata_description": "German astronomer (1791\u20131865)", "wikipedia_url": "https://en.wikipedia.org/wiki/Johann%20Franz%20Encke", "wikipedia_extract": "Johann Franz Encke (German pronunciation: [\u02c8jo\u02d0han \u02c8f\u0281ants \u02c8\u025b\u014bk\u0259]; 23 September 1791 \u2013 26 August 1865) was a German astronomer. Among his activities, he worked on the calculation of the periods of comets and asteroids, measured the distance from the Earth to the Sun, and made observations of the planet Saturn. Encke was born in Hamburg, where his father was the Pastor at St. James' Church, Hamburg. He was the youngest of eight children, and at the time his father died, when he was four years old, the family was in straitened circumstances. Thanks to the financial assistance of a teacher, he was able to be educated at the Gelehrtenschule des Johanneums."}}, {"canonical_name": "carbonic acid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 28, "members": [{"entity_id": "carbonic_acid", "book_id": "kosmos_humboldt_1845", "name": "carbonic acid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 17, "variants": ["carbonic acid"], "contexts": ["gas in the atmosphere", "gas in higher strata of air"]}, {"entity_id": "carbonic_acid", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Carbonic acid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["carbonic acid", "Carbonic acid"], "contexts": ["trace gas in the atmosphere", "chemical compound decomposed by plants"]}, {"entity_id": "carbonic_acid", "book_id": "first_principles_spencer_1862", "name": "carbonic acid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 8, "variants": ["carbonic acid"], "contexts": ["environmental factor for plant vitality", "chemical compound formed during combustion"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "carbonic acid", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Carbonic acid", "similarity": 0.978}, {"source_book": "kosmos_humboldt_1845", "source_name": "carbonic acid", "target_book": "first_principles_spencer_1862", "target_name": "carbonic acid", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Carbonic acid", "target_book": "first_principles_spencer_1862", "target_name": "carbonic acid", "similarity": 0.978}], "id": 957, "stable_key": "clu_bbeda28236ac803e", "ground_truth": {"modern_name": "Carbonic acid", "confidence": "high", "type": "chemical", "wikidata_id": "Q104334", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Carbonic%20acid", "wikipedia_extract": "Carbonic acid is a chemical compound with the chemical formula H2CO3. The molecule rapidly converts to water and carbon dioxide in the presence of water. In contrast to early-twentieth century textbooks, numerous studies conducted since ca. 1990 identified H2CO3 as a real molecule with a distinct Raman spectrum and with a first-order life-time of ca. 20 ms at 37 \u00b0C. Solid anhydrous carbonic acid has also been isolated."}}, {"canonical_name": "reasoning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 27, "members": [{"entity_id": "reasoning", "book_id": "medecine_experimentale_bernard_1865", "name": "reasoning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["reasoning"], "contexts": ["process of thinking logically"]}, {"entity_id": "reasoning", "book_id": "principles_of_psychology_james_1890", "name": "reasoning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 20, "variants": ["reasoning", "Reasoning"], "contexts": ["Soul's faculty", "mental process of forming conclusions"]}, {"entity_id": "reasonings", "book_id": "principles_of_psychology_james_1890", "name": "reasonings", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["reasonings"], "contexts": ["mental phenomena", "process of logical deduction"]}, {"entity_id": "reasoning", "book_id": "kosmos_humboldt_1845", "name": "reasoning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["reasoning"], "contexts": ["substitutes reasoning for assumption"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "reasoning", "target_book": "principles_of_psychology_james_1890", "target_name": "reasoning", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "reasoning", "target_book": "principles_of_psychology_james_1890", "target_name": "reasonings", "similarity": 0.938}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "reasoning", "target_book": "kosmos_humboldt_1845", "target_name": "reasoning", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "reasoning", "target_book": "kosmos_humboldt_1845", "target_name": "reasoning", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "reasonings", "target_book": "kosmos_humboldt_1845", "target_name": "reasoning", "similarity": 0.938}], "id": 958, "stable_key": "clu_0c3e2592e19c301c", "ground_truth": {"modern_name": "reasoning", "confidence": "high", "type": "concept", "wikidata_id": "Q2555318", "wikidata_description": "subfield of computer science and logic", "wikipedia_url": "https://en.wikipedia.org/wiki/Automated%20reasoning", "wikipedia_extract": "In computer science, in particular in knowledge representation and reasoning and metalogic, the area of automated reasoning is dedicated to understanding different aspects of reasoning. The study of automated reasoning helps produce computer programs that allow computers to reason completely, or nearly completely, automatically. Although automated reasoning is considered a sub-field of artificial intelligence, it also has connections with theoretical computer science and philosophy. The most developed subareas of automated reasoning are automated theorem proving (and the less automated but more pragmatic subfield of interactive theorem proving) and automated proof checking (viewed as guaranteed correct reasoning under fixed assumptions). Extensive work has also been done in reasoning by analogy using induction and abduction. Other important topics include reasoning under uncertainty and non-monotonic reasoning."}}, {"canonical_name": "Society", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 27, "members": [{"entity_id": "soci\u00e9t\u00e9", "book_id": "epoques_nature_buffon_1778", "name": "soci\u00e9t\u00e9", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["soci\u00e9t\u00e9"], "contexts": ["organized community of people", "community, organized group of people"]}, {"entity_id": "society", "book_id": "epoques_nature_buffon_1778", "name": "society", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["society"], "contexts": ["organized community of people"]}, {"entity_id": "society", "book_id": "principles_of_psychology_james_1890", "name": "society", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["society"], "contexts": ["group of people living together"]}, {"entity_id": "society", "book_id": "first_principles_spencer_1862", "name": "Society", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 22, "variants": ["Society", "society"], "contexts": ["complex conditions arising from social interaction", "human collective organization and its conditions"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "soci\u00e9t\u00e9", "target_book": "principles_of_psychology_james_1890", "target_name": "society", "similarity": 0.892}, {"source_book": "epoques_nature_buffon_1778", "source_name": "soci\u00e9t\u00e9", "target_book": "first_principles_spencer_1862", "target_name": "Society", "similarity": 0.923}, {"source_book": "epoques_nature_buffon_1778", "source_name": "society", "target_book": "principles_of_psychology_james_1890", "target_name": "society", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "society", "target_book": "first_principles_spencer_1862", "target_name": "Society", "similarity": 0.944}, {"source_book": "principles_of_psychology_james_1890", "source_name": "society", "target_book": "first_principles_spencer_1862", "target_name": "Society", "similarity": 0.944}], "id": 959, "stable_key": "clu_62e3211bdf20bafe", "ground_truth": {"modern_name": "Society", "confidence": "high", "type": "concept", "wikidata_id": "Q829080", "wikidata_description": "mission-driven organization seeking to further a particular profession", "wikipedia_url": "https://en.wikipedia.org/wiki/Professional%20association", "wikipedia_extract": "A professional association (also called  a professional body, professional organization, or professional society) is a group that usually seeks to further a particular profession, the interests of individuals and organisations engaged in that profession, and the public interest. In the United States, such an association is typically a nonprofit business league for tax purposes. In the UK, they may take a variety of legal forms. The roles of professional associations have been variously defined: \"A group of people in a learned occupation who are entrusted with maintaining control or oversight of the legitimate practice of the occupation;\" also a body acting \"to safeguard the public interest;\" organizations which \"represent the interest of the professional practitioners,\" and so \"act to maintain their own privileged and powerful position as a controlling body.\" Professional associations are ill defined although often have commonality in purpose and activities. In the UK the Science Council defines a professional body as \"an organisation with individual members practicing a profession or occupation in which the organisation maintains an oversight of the knowledge, skills, conduct and practice of that profession or occupation\". The Quality Assurance Agency distinguishes between statutory bodies and regulators that \"have powers mandated by Parliament to regulate a profession or group of professions and protect the use of professional titles\" and professional bodies that \"are independent membership organisations that oversee the activities of a particular profession and represent the interests of [their] members\" and which \"may offer registration or certification of unregulated occupations on a voluntary basis.\" Many professional bodies are involved in accrediting degrees, defining and examining the skills and competencies necessary to practice, and granting professional certifications to indicate that a person is qualified in the subject area."}}, {"canonical_name": "Gonorrheas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 27, "members": [{"entity_id": "gonorrhea", "book_id": "english_physician_1652", "name": "Gonorrhea", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 6, "variants": ["Gonorrhea", "Gonorrea"], "contexts": ["condition treated by plantain externally", "running of the reins"]}, {"entity_id": "gonorrhoea", "book_id": "coloquios_da_orta_1563", "name": "gonorrhoea", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["gonorrhoea", "gonorrhceas"], "contexts": ["disease treated with cubebs", "disease treated with application"]}, {"entity_id": "gonorrheas", "book_id": "polyanthea_medicinal", "name": "Gonorrheas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 18, "variants": ["Gonorrheas", "Gonerreas", "Gonorrh.", "Gonorshea", "gangrenas", "gangreno\u017fas", "gonorrhea", "gorrhea"], "contexts": ["sexually transmitted infection", "condition involving purgings through the urinary tract"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Gonorrhea", "target_book": "coloquios_da_orta_1563", "target_name": "gonorrhoea", "similarity": 0.977}, {"source_book": "english_physician_1652", "source_name": "Gonorrhea", "target_book": "polyanthea_medicinal", "target_name": "Gonorrheas", "similarity": 0.984}, {"source_book": "coloquios_da_orta_1563", "source_name": "gonorrhoea", "target_book": "polyanthea_medicinal", "target_name": "Gonorrheas", "similarity": 0.987}], "id": 960, "stable_key": "clu_054c0b1aa3161b08", "ground_truth": {"modern_name": "Gonorrhea", "confidence": "high", "type": "disease", "description": "A sexually transmitted infection involving purulent discharge from the urinary tract.", "wikipedia_extract": "Gonorrhea or gonorrhoea, colloquially known as the clap, is a sexually transmitted infection (STI) caused by the bacterium Neisseria gonorrhoeae. Infection may involve the genitals, mouth, or rectum. Gonorrhea is spread through sexual contact with an infected person, or from a mother to a child during birth. Infected males may experience pain or burning with urination, discharge from the penis, or testicular pain. Infected females may experience burning with urination, vaginal discharge, vaginal bleeding between periods, or pelvic pain. Complications in females include pelvic inflammatory disease and in males include inflammation of the epididymis."}}, {"canonical_name": "Tom. III", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 27, "members": [{"entity_id": "chap__3", "book_id": "english_physician_1652", "name": "Chap. 3", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Chap. 3", "Chap. 4"], "contexts": ["chapter title"]}, {"entity_id": "tom__iii", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tom. III", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 24, "variants": ["Tom. III", "Tom II", "Tom. 1", "Tom. I", "Tom. II", "Vol. III"], "contexts": ["volume reference", "reference to a volume"]}, {"entity_id": "tomo_3_", "book_id": "polyanthea_medicinal", "name": "tomo 3.", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["tomo 3."], "contexts": ["volume 3"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Chap. 3", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Tom. III", "similarity": 0.896}, {"source_book": "english_physician_1652", "source_name": "Chap. 3", "target_book": "polyanthea_medicinal", "target_name": "tomo 3.", "similarity": 0.901}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tom. III", "target_book": "polyanthea_medicinal", "target_name": "tomo 3.", "similarity": 0.915}], "id": 961, "stable_key": "clu_a37909fa173c7b4c", "ground_truth": {"modern_name": "Volume 3", "confidence": "high", "type": "object", "wikidata_id": "Q1238720", "wikidata_description": "book in a series, typically identified sequentially (e.g. Volume 3)", "wikipedia_url": "https://en.wikipedia.org/wiki/Volume%20%28bibliography%29", "wikipedia_extract": "A volume is a physical book. It may be printed or handwritten. The term is commonly used to identify a single book that is part of a larger collection. Volumes are typically identified sequentially with Roman or Arabic numerals, e.g. \"volume III\" or \"volume 3\", commonly abbreviated to \"Vol.\". Volumes may be published directly, or they may be created out of multiple bound issues."}}, {"canonical_name": "urina", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 27, "members": [{"entity_id": "passages_of_urine", "book_id": "english_physician_1652", "name": "Passages of Urine", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Passages of Urine", "passages of Urine"], "contexts": ["urinary tract cleansed by fern root decoction", "body part where decoctions are useful"]}, {"entity_id": "urina", "book_id": "historia_medicinal_monardes_1574", "name": "urina", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["urina"], "contexts": ["urine treated by the water", "bodily fluid, its flow is affected by remedies"]}, {"entity_id": "urina", "book_id": "polyanthea_medicinal", "name": "urina", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 22, "variants": ["urina", "urinam", "urinas", "urine"], "contexts": ["urine, its burning is avoided", "urine, bodily fluid"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Passages of Urine", "target_book": "historia_medicinal_monardes_1574", "target_name": "urina", "similarity": 0.914}, {"source_book": "english_physician_1652", "source_name": "Passages of Urine", "target_book": "polyanthea_medicinal", "target_name": "urina", "similarity": 0.914}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "urina", "target_book": "polyanthea_medicinal", "target_name": "urina", "similarity": 1.0}], "id": 962, "stable_key": "clu_482dca226cbb3fbe", "ground_truth": {"modern_name": "Urine", "confidence": "high", "type": "substance", "description": "A bodily fluid produced by the kidneys and excreted from the body.", "note": "Refers to the bodily fluid itself and the passages through which it travels.", "wikipedia_extract": "Urine, excreted by the kidneys, is a liquid containing excess water and water-soluble nitrogen-rich by-products of metabolism including urea, uric acid, and creatinine, which must be cleared from the bloodstream. Urinalysis detects these nitrogenous wastes in mammals. In placental mammals, urine travels from the kidneys via the ureters to the bladder and exits the urethra through the penis or vulva during urination. Other vertebrates excrete urine through the cloaca. Urine plays an important role in the earth's nitrogen cycle. In balanced ecosystems, urine fertilizes the soil and thus helps plants to grow."}}, {"canonical_name": "opio", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 27, "members": [{"entity_id": "opio", "book_id": "historia_medicinal_monardes_1574", "name": "Opio", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Opio"], "contexts": ["drug derived from poppy", "substance identified by an Indian"]}, {"entity_id": "opio", "book_id": "coloquios_da_orta_1563", "name": "opio", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["opio", "Opio"], "contexts": ["drug produced and traded", "drug consumed and traded"]}, {"entity_id": "opio", "book_id": "polyanthea_medicinal", "name": "opio", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 21, "variants": ["opio", "Opio", "opia"], "contexts": ["opium, a plant substance", "a narcotic medicine"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Opio", "target_book": "coloquios_da_orta_1563", "target_name": "opio", "similarity": 0.996}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Opio", "target_book": "polyanthea_medicinal", "target_name": "opio", "similarity": 0.996}, {"source_book": "coloquios_da_orta_1563", "source_name": "opio", "target_book": "polyanthea_medicinal", "target_name": "opio", "similarity": 1.0}], "id": 963, "stable_key": "clu_b43b3850238a25ac-2", "ground_truth": {"modern_name": "opium", "confidence": "high", "type": "plant", "linnaean": "Papaver somniferum", "family": "Papaveraceae", "description": "Narcotic drug derived from the opium poppy, used medically and recreationally.", "wikipedia_extract": "Papaver somniferum, commonly known as the opium poppy or breadseed poppy, is a species of flowering plant in the family Papaveraceae. It is the species of plant from which both opium and poppy seeds are derived and is also a valuable ornamental plant grown in gardens. Its native range is the western Mediterranean region, but has since been obscured by widespread introduction and cultivation since ancient times to the present day. It is now naturalised across much of the world with temperate climates. Papaver somniferum is an annual herb growing to about 100 centimetres (40 inches) tall. The plant is strongly glaucous, giving a greyish-green appearance, and the stem and leaves bear a sparse distribution of coarse hairs."}}, {"canonical_name": "Silver", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 26, "members": [{"entity_id": "silver", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Silver", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 8, "variants": ["Silver"], "contexts": ["metal", "mineral observed in mines"]}, {"entity_id": "silver", "book_id": "polyanthea_medicinal", "name": "silver", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["silver"], "contexts": ["metal mentioned in remedies"]}, {"entity_id": "silver", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Silver", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 17, "variants": ["silver", "Silver"], "contexts": ["element used to color glass yellow", "reduced on paper after chemical action"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Silver", "target_book": "polyanthea_medicinal", "target_name": "silver", "similarity": 0.985}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Silver", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Silver", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "silver", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Silver", "similarity": 0.985}], "id": 964, "stable_key": "clu_77c1f983073fc29a-2", "ground_truth": {"modern_name": "Silver", "confidence": "high", "type": "mineral", "wikidata_id": "Q1090", "wikidata_description": "allotrope of carbon, mineral, substance", "wikipedia_url": "", "wikipedia_extract": "", "note": "The mention of 'Platinum' alongside 'prata' (Portuguese for silver) is likely an anachronism or a misinterpretation within the text, as platinum was not widely recognized or used in European medicine until much later. Given the overwhelming context of 'prata' and its historical use as silver, this is the most probable referent."}}, {"canonical_name": "Senne", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 26, "members": [{"entity_id": "senna", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Senna", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Senna"], "contexts": ["herb for medicinal use", "plant with purging virtues"]}, {"entity_id": "senna", "book_id": "english_physician_1652", "name": "Senna", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Senna"], "contexts": ["herb used in learned receipts"]}, {"entity_id": "senne", "book_id": "polyanthea_medicinal", "name": "Senne", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 23, "variants": ["Senne", "Sena", "Sene", "sene", "senn", "senne", "senn\u00e9"], "contexts": ["used in purgative pills", "herb used as a purgative"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Senna", "target_book": "english_physician_1652", "target_name": "Senna", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Senna", "target_book": "polyanthea_medicinal", "target_name": "Senne", "similarity": 0.888}, {"source_book": "english_physician_1652", "source_name": "Senna", "target_book": "polyanthea_medicinal", "target_name": "Senne", "similarity": 0.888}], "id": 965, "stable_key": "clu_60821cd85c0ca13c", "ground_truth": {"modern_name": "senna", "confidence": "high", "type": "plant", "linnaean": "Senna alexandrina", "family": "Fabaceae", "description": "A plant whose leaves and pods are used as a laxative.", "wikipedia_extract": "Senna alexandrina (Alexandrian senna, in Arabic \u0639\u0634\u0631\u062c or \u0639\u0634\u0631\u0642 or \u0633\u0646\u0627\u0645\u0643\u064a and see below) is an ornamental plant in the genus Senna. It is used in herbalism. It grows natively in upper Egypt, especially in the Nubian region, and near Khartoum (Sudan), where it is cultivated commercially. It is also grown elsewhere, notably in India and Somalia. Not native to the USSR, it was farmed in southern Kazakhstan for medicine. Alexandrian Senna is a shrubby plant that reaches 0.5\u20131 metres (20\" to 40\"), rarely two metres (6') in height with a branched, pale-green erect stem and long spreading branches bearing four or five pairs of leaves."}}, {"canonical_name": "Crocus metallorum", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 26, "members": [{"entity_id": "crocus_metallorum", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Crocus Metallorum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Crocus Metallorum"], "contexts": ["substance attracts not at all", "preparation that kindles like gunpowder"]}, {"entity_id": "crocus_metallorum", "book_id": "english_physician_1652", "name": "Crocus Metallorum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Crocus Metallorum"], "contexts": ["preparation used in learned receipts", "preparation used in infusion"]}, {"entity_id": "crocus_metallorum", "book_id": "polyanthea_medicinal", "name": "Crocus metallorum", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 22, "variants": ["Crocus metallorum", "Croci metallorum", "Crocus Metallorum", "Crocus de metallorum", "croci metallorum", "crocus metallorum"], "contexts": ["common name for prepared Antimonio", "emetic medicine for plague"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Crocus Metallorum", "target_book": "english_physician_1652", "target_name": "Crocus Metallorum", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Crocus Metallorum", "target_book": "polyanthea_medicinal", "target_name": "Crocus metallorum", "similarity": 0.797}, {"source_book": "english_physician_1652", "source_name": "Crocus Metallorum", "target_book": "polyanthea_medicinal", "target_name": "Crocus metallorum", "similarity": 0.797}], "id": 966, "stable_key": "clu_f7ec8b629e5913d8", "ground_truth": {"modern_name": "Crocus metallorum", "confidence": "high", "type": "chemical", "note": "This is a historical term for a preparation of antimony, often antimony trisulfide."}}, {"canonical_name": "Fistula's", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 26, "members": [{"entity_id": "fistula", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Fistula", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Fistula"], "contexts": ["medical condition involving emission of sound/voice"]}, {"entity_id": "fistula's", "book_id": "english_physician_1652", "name": "Fistula's", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 19, "variants": ["Fistula's", "Fistula", "Fistulaus", "Fistulous", "Fistulous Cankers"], "contexts": ["condition cleansed by juice", "medical condition treated with juice"]}, {"entity_id": "fistula", "book_id": "polyanthea_medicinal", "name": "fistula", "category": "DISEASE", "subcategory": "CHRONIC", "count": 6, "variants": ["fistula", "Fistula"], "contexts": ["medical condition", "abnormal passage or duct"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Fistula", "target_book": "english_physician_1652", "target_name": "Fistula's", "similarity": 0.953}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Fistula", "target_book": "polyanthea_medicinal", "target_name": "fistula", "similarity": 0.844}], "id": 967, "stable_key": "clu_b5b2dcd688b338fa", "ground_truth": {"modern_name": "Fistula", "confidence": "high", "type": "disease", "description": "An abnormal passage or duct in the body, often leading to disease.", "wikipedia_extract": "In anatomy, a fistula (pl.: fistulas or fistulae ; from Latin fistula, \"tube, pipe\") is an abnormal connection (i.e. tube) joining two hollow spaces (technically, two epithelialized surfaces), such as blood vessels, intestines, or other hollow organs to each other, often resulting in an abnormal flow of fluid from one space to the other. An anal fistula connects the anal canal to the perianal skin. An anovaginal or rectovaginal fistula is a hole joining the anus or rectum to the vagina. A colovaginal fistula joins the  space in the colon to that in the vagina. A urinary tract fistula is an abnormal opening in the urinary tract or an abnormal connection between the urinary tract and another organ. An abnormal communication (i.e. hole or tube) between the bladder and the uterus is called a vesicouterine fistula, while if it is between the bladder and the vagina it is known as a vesicovaginal fistula, and if between the urethra and the vagina: a urethrovaginal fistula."}}, {"canonical_name": "mass", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 26, "members": [{"entity_id": "masse", "book_id": "epoques_nature_buffon_1778", "name": "masse", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["masse"], "contexts": ["mass", "amount of matter in an object"]}, {"entity_id": "mass", "book_id": "kosmos_humboldt_1845", "name": "mass", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["mass"], "contexts": ["quantity of matter", "measure of matter in celestial bodies"]}, {"entity_id": "mass", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mass", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 15, "variants": ["Mass", "mass"], "contexts": ["measure of matter", "quantity of matter in an object"]}, {"entity_id": "masses", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Masses", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["masses", "Masses"], "contexts": ["quantity of matter", "quantity of matter in stars"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "masse", "target_book": "kosmos_humboldt_1845", "target_name": "mass", "similarity": 0.926}, {"source_book": "epoques_nature_buffon_1778", "source_name": "masse", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mass", "similarity": 0.926}, {"source_book": "epoques_nature_buffon_1778", "source_name": "masse", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Masses", "similarity": 0.867}, {"source_book": "kosmos_humboldt_1845", "source_name": "mass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mass", "similarity": 1.0}], "id": 968, "stable_key": "clu_c7d546b8c1d4eb42", "ground_truth": {"modern_name": "Mass", "confidence": "high", "type": "concept"}}, {"canonical_name": "Oximel", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 26, "members": [{"entity_id": "oximel", "book_id": "english_physician_1652", "name": "Oximel", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Oximel"], "contexts": ["mixture of honey and vinegar"]}, {"entity_id": "oximel", "book_id": "coloquios_da_orta_1563", "name": "oximel", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["oximel"], "contexts": ["preparation with seeds"]}, {"entity_id": "oximel", "book_id": "polyanthea_medicinal", "name": "Oximel", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 23, "variants": ["Oximel", "oximel", "oximel esquilitico"], "contexts": ["simple oxymel mixture", "mixture of honey and vinegar"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Oximel", "target_book": "coloquios_da_orta_1563", "target_name": "oximel", "similarity": 0.991}, {"source_book": "english_physician_1652", "source_name": "Oximel", "target_book": "polyanthea_medicinal", "target_name": "Oximel", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "oximel", "target_book": "polyanthea_medicinal", "target_name": "Oximel", "similarity": 0.991}], "id": 969, "stable_key": "clu_96bdc727a8f8a41a", "ground_truth": {"modern_name": "Oxymel", "confidence": "high", "type": "chemical", "description": "A medicinal preparation of honey and vinegar.", "wikipedia_extract": "Oxymel (from Latin 'acid and honey', from Ancient Greek  \u1f40\u03be\u03cd\u03c2 'acid' and  \u03bc\u03ad\u03bb\u03b9 'honey') is a mixture of honey and vinegar, historically used as a medicine. Its name is often found in Renaissance (and later) pharmacopoeiae in Late Latin form as either a countable or uncountable noun. As a countable noun, it is spelled variously as (singular) oxymellus and oxymellis, and Oxymelli. Fit vinum ex aceto & melle quod oxymel vocaverunt voce Graecanica. Nam o\u03be(?) dicitur Graecis acetu & \u03bc\u03af\u03bb mel. Fit autem oxymel hoc modo."}}, {"canonical_name": "pimenta longa", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 26, "members": [{"entity_id": "pimienta_larga", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "pimienta larga", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["pimienta larga", "Pimienta larga"], "contexts": ["long pepper plant", "plant with long pepper"]}, {"entity_id": "pimenta_longa", "book_id": "coloquios_da_orta_1563", "name": "pimenta longa", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["pimenta longa", "PIMENTA LONGA", "pimenta longua"], "contexts": ["topic of colloquy", "Long pepper, a spice"]}, {"entity_id": "pimenta_longa", "book_id": "polyanthea_medicinal", "name": "pimenta longa", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["pimenta longa"], "contexts": ["spice for pill preparation", "ingredient in pills"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "pimienta larga", "target_book": "coloquios_da_orta_1563", "target_name": "pimenta longa", "similarity": 0.91}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "pimienta larga", "target_book": "polyanthea_medicinal", "target_name": "pimenta longa", "similarity": 0.91}, {"source_book": "coloquios_da_orta_1563", "source_name": "pimenta longa", "target_book": "polyanthea_medicinal", "target_name": "pimenta longa", "similarity": 1.0}], "id": 970, "stable_key": "clu_02aab75d35aedbe4", "ground_truth": {"modern_name": "Long Pepper", "confidence": "high", "type": "plant", "description": "A spice, a dried berry of the Piper longum plant.", "wikipedia_extract": "Long pepper (Piper longum),  sometimes called Indian long pepper or pippali, is a flowering vine in the family Piperaceae, cultivated for its fruit, which is usually dried and used as a spice and seasoning. Long pepper has a taste similar to, but sweeter and more pungent than, that of its close relative Piper nigrum \u2013 from which black, green and white pepper are obtained. The fruit of the pepper consists of many minuscule fruits \u2013 each about the size of a poppy seed \u2013 embedded in the surface of a flower spike that closely resembles a hazel tree catkin. Like Piper nigrum, the fruits contain the compound piperine, which contributes to their pungency. Another species of long pepper, Piper retrofractum, is native to Java, Indonesia. The fruits of this plant are often confused with chili peppers, which belong to the genus Capsicum, originally from the Americas."}}, {"canonical_name": "Sib\u00e9rie", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 26, "members": [{"entity_id": "sib\u00e9rie", "book_id": "epoques_nature_buffon_1778", "name": "Sib\u00e9rie", "category": "PLACE", "subcategory": "REGION", "count": 16, "variants": ["Sib\u00e9rie"], "contexts": ["region where elephant skeletons are found", "location where ivory is found"]}, {"entity_id": "siberia,_eastern", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Siberia, Eastern", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Siberia, Eastern"], "contexts": ["depression of barometer observed in"]}, {"entity_id": "sib\u00e9rie_m\u00e9ridionale", "book_id": "epoques_nature_buffon_1778", "name": "Sib\u00e9rie m\u00e9ridionale", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Sib\u00e9rie m\u00e9ridionale"], "contexts": ["part of elevated region in Asia"]}, {"entity_id": "sib\u00e9rie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sib\u00e9rie", "category": "PLACE", "subcategory": "REGION", "count": 8, "variants": ["Sib\u00e9rie"], "contexts": ["region in Russian Empire", "region with sugar consumption"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Sib\u00e9rie", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Siberia, Eastern", "similarity": 0.911}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Sib\u00e9rie m\u00e9ridionale", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Sib\u00e9rie", "similarity": 0.935}], "id": 971, "stable_key": "clu_e6f85768c9b24594", "ground_truth": {"modern_name": "Siberia", "confidence": "high", "type": "place", "description": "A vast geographical region within the Russian Empire.", "wikipedia_extract": "Siberia ( sy-BEER-ee-\u0259; Russian: \u0421\u0438\u0431\u0438\u0440\u044c, romanized: Sibir', IPA: [s\u02b2\u026a\u02c8b\u02b2ir\u02b2] ), also known as Asian Russia, is an extensive geographical region comprising all of North Asia, from the Ural Mountains in the west (with the Ural River usually forming the southernmost portion of its western boundary) to the Pacific Ocean in the east. It has formed a part of the sovereign territory of Russia and its predecessor states since the lengthy conquest of Siberia, which began with the fall of the Khanate of Sibir in 1582 and concluded with the annexation of Chukotka in 1778. Siberia is vast and sparsely populated, covering an area of over 13.1 million square kilometres (5,100,000 mi2) \u2013 about three-quarters of Russia's total area, but home to roughly a quarter of Russia's population. Novosibirsk, Krasnoyarsk, and Omsk are the largest cities in the area. Because Siberia is a geographic and historic concept and not a political entity, there is no single precise definition of its territorial borders. It is further defined as stretching from the territories within the Arctic Circle in the north to the northern borders of Kazakhstan, Mongolia, and China in the south, although the hills of north-central Kazakhstan are also commonly included."}}, {"canonical_name": "Madeira", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 25, "members": [{"entity_id": "madeira", "book_id": "origin_of_species_darwin_1859", "name": "Madeira", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 15, "variants": ["Madeira"], "contexts": ["islets with many insects", "island for distance comparison"]}, {"entity_id": "madeira", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Madeira", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["Madeira"], "contexts": ["river in South America", "river name"]}, {"entity_id": "madeira", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Madeira", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Madeira"], "contexts": ["island with peculiar flora", "vegetation of"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Madeira", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Madeira", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Madeira", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Madeira", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Madeira", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Madeira", "similarity": 1.0}], "id": 972, "stable_key": "clu_8ccaa127ff6a42cd", "ground_truth": {"modern_name": "Madeira", "confidence": "high", "type": "place", "country": "Portugal", "wikidata_id": "Q26253", "wikidata_description": "Autonomous Region of Portugal in the archipelago of Madeira", "wikipedia_url": "https://en.wikipedia.org/wiki/Madeira", "wikipedia_extract": "Madeira, officially the Autonomous Region of Madeira, is an autonomous region of Portugal, in the Atlantic Ocean about 805 km (500 miles) southwest of mainland Portugal. Together with the Azores, it is one of the two autonomous regions of Portugal and a special territory of the European Union. It is the southernmost point and region of Portugal. Madeira is an archipelago situated in the North Atlantic Ocean, in the region of Macaronesia, just under 400 kilometres (250 mi) north of the Canary Islands, Spain, 520 kilometres (320 mi) west of Morocco and 805 kilometres (500 mi) southwest of mainland Portugal. Madeira sits on the African Tectonic Plate, but is culturally, politically and ethnically associated with Europe, with its population predominantly descended from Portuguese settlers. Its population was 251,060 in 2021."}}, {"canonical_name": "astringente", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 25, "members": [{"entity_id": "astringente", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "astringente", "category": "CONCEPT", "subcategory": "QUALITY", "count": 21, "variants": ["astringente"], "contexts": ["quality attributed to the acassia tree", "quality of plant"]}, {"entity_id": "astringentes", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "astringentes", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["astringentes"], "contexts": ["quality of grains"]}, {"entity_id": "astringente", "book_id": "ricettario_fiorentino_1597", "name": "astringente", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["astringente"], "contexts": ["property of alum", "strong property of round alum"]}, {"entity_id": "astringente", "book_id": "polyanthea_medicinal", "name": "astringente", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["astringente"], "contexts": ["quality of food"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "astringente", "target_book": "ricettario_fiorentino_1597", "target_name": "astringente", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "astringente", "target_book": "polyanthea_medicinal", "target_name": "astringente", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "astringentes", "target_book": "ricettario_fiorentino_1597", "target_name": "astringente", "similarity": 0.924}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "astringentes", "target_book": "polyanthea_medicinal", "target_name": "astringente", "similarity": 0.924}, {"source_book": "ricettario_fiorentino_1597", "source_name": "astringente", "target_book": "polyanthea_medicinal", "target_name": "astringente", "similarity": 1.0}], "id": 973, "stable_key": "clu_a1a089f01ba66c75", "ground_truth": {"modern_name": "Astringent", "confidence": "high", "type": "concept", "note": "The context of properties of areca and remedies for tremors clearly indicates an astringent quality or action.", "wikidata_id": "Q378705", "wikidata_description": "chemical compound that tends to shrink or constrict body tissues", "description": "A substance that causes tissues to contract or tighten.", "wikipedia_extract": "An astringent (sometimes called adstringent) is a chemical that shrinks or constricts body tissues. The word derives from the Latin adstringere, which means \"to bind fast\". Astringency, the dry, puckering or numbing mouthfeel caused by the tannins in unripe fruits, lets the fruit mature by deterring eating. Tannins, being a kind of polyphenol, bind salivary proteins and make them precipitate and aggregate, producing a rough, \"sandpapery\", or dry sensation in the mouth. Smoking tobacco is also reported to have an astringent effect. In a scientific study, astringency was still detectable by subjects who had local anesthesia applied to their taste nerves, but not when both these and the trigeminal nerves were disabled."}}, {"canonical_name": "p\u00e9rolas", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 25, "members": [{"entity_id": "perlas", "book_id": "historia_medicinal_monardes_1574", "name": "perlas", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["Perlas", "perlas"], "contexts": ["gems brought from the Indies", "precious items from the Indies"]}, {"entity_id": "p\u00e9rolas", "book_id": "coloquios_da_orta_1563", "name": "p\u00e9rolas", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 15, "variants": ["p\u00e9rolas", "P\u00c9ROLAS", "P\u00e9rolas", "p\u00e9rolas or\u00edentaes"], "contexts": ["precious gems", "gemstones from the sea"]}, {"entity_id": "perle", "book_id": "ricettario_fiorentino_1597", "name": "perle", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["perle", "Perla", "Perle"], "contexts": ["pearls for grinding", "ingredient in a preparation"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "perlas", "target_book": "coloquios_da_orta_1563", "target_name": "p\u00e9rolas", "similarity": 0.927}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "perlas", "target_book": "ricettario_fiorentino_1597", "target_name": "perle", "similarity": 0.973}, {"source_book": "coloquios_da_orta_1563", "source_name": "p\u00e9rolas", "target_book": "ricettario_fiorentino_1597", "target_name": "perle", "similarity": 0.909}], "id": 974, "stable_key": "clu_3eb7e2110968cc39", "ground_truth": {"modern_name": "pearls", "confidence": "high", "type": "mineral", "wikidata_id": "", "wikidata_description": "family name", "note": "The term 'perlas' is the Spanish plural for pearl, and 'perla' is singular. 'Perles' in French also means pearls."}}, {"canonical_name": "Cornelius Celfus", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 25, "members": [{"entity_id": "cornelio_celso", "book_id": "historia_medicinal_monardes_1574", "name": "Cornelio Celso", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Cornelio Celso"], "contexts": ["ancient authority on medicine"]}, {"entity_id": "cornelio_celso", "book_id": "coloquios_da_orta_1563", "name": "Cornelio Celso", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Cornelio Celso", "Comelio Celso"], "contexts": ["ancient authority who calls calamus alexandrino", "ancient medical writer"]}, {"entity_id": "cornelius_celfus", "book_id": "polyanthea_medicinal", "name": "Cornelius Celfus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 21, "variants": ["Cornelius Celfus", "Cornel. Celf", "Cornel. Celf.", "Cornel. Cell.", "Cornel. Cels.", "Cornel.Cell.", "Cornelio Cello", "Cornelio Celso", "Cornelio Cel\u017fo"], "contexts": ["ancient author of de Re Medica", "author of 'deLienofis morbis'"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Cornelio Celso", "target_book": "coloquios_da_orta_1563", "target_name": "Cornelio Celso", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Cornelio Celso", "target_book": "polyanthea_medicinal", "target_name": "Cornelius Celfus", "similarity": 0.875}, {"source_book": "coloquios_da_orta_1563", "source_name": "Cornelio Celso", "target_book": "polyanthea_medicinal", "target_name": "Cornelius Celfus", "similarity": 0.875}], "id": 975, "stable_key": "clu_98af23d5641acbc3", "ground_truth": {"modern_name": "Aulus Cornelius Celsus", "confidence": "high", "type": "person", "description": "Roman encyclopedist and medical writer, author of De Medicina.", "wikipedia_extract": "Aulus Cornelius Celsus (c. 25 BC \u2013 c. 50 AD) was a Roman encyclopedist, known for his extant medical work, De Medicina, which is believed to be the only surviving section of a much larger encyclopedia. The De Medicina is a primary source on diet, pharmacy, surgery and related fields, and it is one of the best sources concerning medical knowledge in the Roman world. The lost portions of his encyclopedia likely included volumes on agriculture, law, rhetoric, and military arts. He made contributions to the classification of human skin disorders in  dermatology, such as myrmecia, and his name is often found in medical terminology regarding the skin, e.g., kerion celsi and area celsi. He is also the namesake of Paracelsus (lit. Above Celsus), a great Swiss alchemist and physician prevalent in the Medical Renaissance."}}, {"canonical_name": "aerolites", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 25, "members": [{"entity_id": "aerolites", "book_id": "kosmos_humboldt_1845", "name": "aerolites", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 12, "variants": ["aerolites"], "contexts": ["celestial bodies falling to Earth", "heterogeneous substance in pendulum experiments"]}, {"entity_id": "a\u00ebrolites", "book_id": "connexion_physical_sciences_somerville_1858", "name": "A\u00ebrolites", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["a\u00ebrolites", "A\u00ebrolites"], "contexts": ["solid masses precipitated from atmosphere", "objects of theoretical study"]}, {"entity_id": "a\u00ebrolites", "book_id": "kosmos_humboldt_1845", "name": "A\u00ebrolites", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 10, "variants": ["A\u00ebrolites", "a\u00ebrolites"], "contexts": ["meteoric stones reaching atmosphere", "meteoric stones from space"]}, {"entity_id": "aerufegi", "book_id": "coloquios_da_orta_1563", "name": "aerufegi", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["aerufegi"], "contexts": ["ingredient name from Mesu\u00e9"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "aerolites", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "A\u00ebrolites", "similarity": 0.79}, {"source_book": "kosmos_humboldt_1845", "source_name": "A\u00ebrolites", "target_book": "coloquios_da_orta_1563", "target_name": "aerufegi", "similarity": 0.908}], "id": 976, "stable_key": "clu_1accce3775f1c3ef", "ground_truth": {"modern_name": "meteorites", "confidence": "high", "type": "mineral", "note": "The term 'aerufegi' appears to be an OCR error or very obscure variant.", "wikidata_id": "Q18104262", "wikidata_description": "genus of insects"}}, {"canonical_name": "Earth", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 24, "members": [{"entity_id": "earth", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Earth", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 20, "variants": ["earth", "Earth"], "contexts": ["Earth far bigger than the Sun", "the planet Earth"]}, {"entity_id": "earth", "book_id": "english_physician_1652", "name": "Earth", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["Earth", "Earths"], "contexts": ["quality of the herb", "where plant roots draw nourishment"]}, {"entity_id": "earth", "book_id": "origin_of_species_darwin_1859", "name": "earth", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["earth"], "contexts": ["soil material adhering to bird feet"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Earth", "target_book": "english_physician_1652", "target_name": "Earth", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Earth", "target_book": "origin_of_species_darwin_1859", "target_name": "earth", "similarity": 0.969}, {"source_book": "english_physician_1652", "source_name": "Earth", "target_book": "origin_of_species_darwin_1859", "target_name": "earth", "similarity": 0.969}], "id": 977, "stable_key": "clu_359477f10a3a8db6-2", "ground_truth": {"modern_name": "Earth", "confidence": "high", "type": "mineral", "note": "The term 'terra' (Spanish/Portuguese) and 'earth' (English) refers to soil, land, or the element earth in classical and early modern contexts.", "wikidata_id": "Q36133", "wikidata_description": "natural body consisting of layers that are primarily composed of minerals", "wikipedia_url": "https://en.wikipedia.org/wiki/Soil", "country": "Global", "wikipedia_extract": "Soil, also commonly referred to as earth, is a mixture of organic matter, minerals, gases, water, and organisms that together support the life of plants and soil organisms. Some scientific definitions distinguish dirt from soil by restricting the former term specifically to displaced soil. Soil consists of a solid collection of minerals and organic matter (the soil matrix), as well as a porous phase that holds gases (the soil atmosphere) and a liquid phase that holds water and dissolved substances both organic and inorganic, in ionic or in molecular form (the soil solution). Accordingly, soil is a complex three-state system of solids, liquids, and gases. Soil is a product of several factors: the influence of climate, relief (elevation, orientation, and slope of terrain), organisms, and the soil's parent materials (original minerals) interacting over time. It continually undergoes development by way of numerous physical, chemical and biological processes, which include weathering with associated erosion."}}, {"canonical_name": "Cardano", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 24, "members": [{"entity_id": "cardan", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Cardan", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Cardan"], "contexts": ["scholar who rejected crystal formation by cold", "scholar who delivered information about Guascus' loadstone"]}, {"entity_id": "cardan", "book_id": "principles_of_psychology_james_1890", "name": "Cardan", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Cardan"], "contexts": ["philosopher and mathematician lost in thought"]}, {"entity_id": "cardano", "book_id": "polyanthea_medicinal", "name": "Cardano", "category": "PERSON", "subcategory": "SCHOLAR", "count": 16, "variants": ["Cardano", "Cardanus"], "contexts": ["referred by Rolfincio, tells a story", "philosopher and physician"]}, {"entity_id": "cardan", "book_id": "polyanthea_medicinal", "name": "Cardan", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Cardan"], "contexts": ["early modern medical author", "mentioned in relation to cures"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Cardan", "target_book": "principles_of_psychology_james_1890", "target_name": "Cardan", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Cardan", "target_book": "polyanthea_medicinal", "target_name": "Cardano", "similarity": 0.954}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Cardan", "target_book": "polyanthea_medicinal", "target_name": "Cardan", "similarity": 0.689}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Cardan", "target_book": "polyanthea_medicinal", "target_name": "Cardano", "similarity": 0.954}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Cardan", "target_book": "polyanthea_medicinal", "target_name": "Cardan", "similarity": 0.689}], "id": 978, "stable_key": "clu_904d92c8ba24e6bc", "ground_truth": {"modern_name": "Gerolamo Cardano", "confidence": "high", "type": "person", "birth_year": 1501, "death_year": 1576, "description": "Italian polymath, physician, mathematician, astrologer, and gambler.", "wikidata_id": "Q184530", "wikidata_description": "Italian Renaissance mathematician, physician, astrologer (1501-1576)", "wikipedia_url": "https://en.wikipedia.org/wiki/Gerolamo%20Cardano", "wikipedia_extract": "Gerolamo Cardano (Italian: [d\u0292e\u02c8r\u0254\u02d0lamo kar\u02c8da\u02d0no]; also Girolamo or Geronimo; French: J\u00e9r\u00f4me Cardan; Latin: Hieronymus Cardanus; 24 September 1501\u2013 21 September 1576) was an Italian polymath whose interests and proficiencies ranged through those of mathematician, physician, biologist, physicist, chemist, astrologer, astronomer, philosopher, music theorist, writer, and gambler. He became one of the most influential mathematicians of the Renaissance and one of the key figures in the foundation of probability; he introduced the binomial coefficients and the binomial theorem in the Western world. He wrote more than 200 works on science. Cardano partially invented and described several mechanical devices including the combination lock, the gimbal consisting of three concentric rings allowing a supported compass or gyroscope to rotate freely, and the Cardan shaft with universal joints, which allows the transmission of rotary motion at various angles and is used in vehicles to this day. He made significant contributions to hypocycloids - published in De proportionibus, in 1570. The generating circles of these hypocycloids, later named \"Cardano circles\" or \"cardanic circles\", were used for the construction of the first high-speed printing presses."}}, {"canonical_name": "Pedro", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 24, "members": [{"entity_id": "peter", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Peter", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Peter"], "contexts": ["impatient disciple", "Biblical disciple who asked about John"]}, {"entity_id": "peter", "book_id": "principles_of_psychology_james_1890", "name": "Peter", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Peter"], "contexts": ["individual in thought experiment", "a hypothetical individual"]}, {"entity_id": "pedro", "book_id": "polyanthea_medicinal", "name": "Pedro", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 19, "variants": ["Pedro", "D. Pedro de Lencastre", "Pedro Af-", "Pedro Castello", "Pedro Fernandez", "Pedro Ferr\u00e1s", "Pedro de Barbuda", "Pedro de Caftilho", "Pedro de Castilho", "Pedro de Castro", "Pedro de Ca\u017ftilho", "PedroCefar", "PedrodaCo\u017fta", "Pedrode Barbuda"], "contexts": ["mentioned in comparison", "person with sympathetic stomach to milk"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Peter", "target_book": "principles_of_psychology_james_1890", "target_name": "Peter", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Peter", "target_book": "polyanthea_medicinal", "target_name": "Pedro", "similarity": 0.851}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Peter", "target_book": "polyanthea_medicinal", "target_name": "Pedro", "similarity": 0.851}], "id": 979, "stable_key": "clu_56e51fec943a92fb", "ground_truth": {"modern_name": "Peter", "confidence": "low", "type": "person", "description": "A common given name, often appearing in comparative contexts.", "note": "Too general to identify a specific historical figure without further context.", "wikidata_id": "", "wikidata_description": "fictional character from the Family Guy franchise", "wikipedia_url": "https://en.wikipedia.org/wiki/Peter%20Griffin", "wikipedia_extract": "Peter L\u00f6wenbr\u00e4u Griffin Sr. (n\u00e9 Justin Peter Griffin) is a fictional character and the protagonist of the American animated sitcom Family Guy. He is voiced by series creator Seth MacFarlane, and first appeared on television, along with the rest of the Griffin family, in the episode \"Death Has a Shadow\" on January 31, 1999. Peter was created and designed by MacFarlane himself. MacFarlane was asked to pitch a pilot to the Fox Broadcasting Company based on Larry & Steve, a short made by MacFarlane which featured a middle-aged character named Larry and an intellectual dog, Steve. For the series, Larry was renamed Peter."}}, {"canonical_name": "antipathia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 24, "members": [{"entity_id": "antipathies", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Antipathies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["antipathies", "Antipathies"], "contexts": ["mutual aversion or repulsion", "opposing forces between substances"]}, {"entity_id": "antipathy", "book_id": "english_physician_1652", "name": "Antipathy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["Antipathy", "Antypathy"], "contexts": ["used to cure disease", "principle of cure by opposition"]}, {"entity_id": "antipathia", "book_id": "polyanthea_medicinal", "name": "antipathia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 13, "variants": ["antipathia", "Antipathia", "antidote", "antipathias"], "contexts": ["aversion between substances", "aversion or opposition"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Antipathies", "target_book": "english_physician_1652", "target_name": "Antipathy", "similarity": 0.96}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Antipathies", "target_book": "polyanthea_medicinal", "target_name": "antipathia", "similarity": 0.971}, {"source_book": "english_physician_1652", "source_name": "Antipathy", "target_book": "polyanthea_medicinal", "target_name": "antipathia", "similarity": 0.956}], "id": 980, "stable_key": "clu_d8107a3cebbcd509", "ground_truth": {"modern_name": "Antipathy", "confidence": "high", "type": "concept", "wikidata_id": "Q581459", "wikidata_description": "dislike for something or somebody", "wikipedia_url": "https://en.wikipedia.org/wiki/Antipathy", "wikipedia_extract": "Antipathy is a dislike for something or somebody, the opposite of sympathy. While antipathy may be induced by experience, it sometimes exists without a rational cause-and-effect explanation being present to the individuals involved. Thus, the origin of antipathy has been subject to various philosophical and psychological explanations, which some people find convincing and others regard as highly speculative. The exploration of a philosophical aspect for antipathy has been found in an essay by John Locke, an early modern  17th century philosopher. Interpersonal antipathy is often irrationally ascribed to mannerisms or certain physical characteristics, which are perceived as signs for character traits (e.g., close, deep set eyes as a sign for dullness or cruelty). Further, the negative feeling sometimes takes place rapidly and without reasoning, functioning below the level of attention, thus resembling an automatic process."}}, {"canonical_name": "gypse", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 24, "members": [{"entity_id": "gypsum", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Gypsum", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Gypsum"], "contexts": ["ingredient for dishes"]}, {"entity_id": "gypse", "book_id": "relation_historique_humboldt_vol3_1825", "name": "gypse", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 15, "variants": ["gypse"], "contexts": ["gypsum mineral", "type of rock"]}, {"entity_id": "gypses", "book_id": "relation_historique_humboldt_vol3_1825", "name": "gypses", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["gypses"], "contexts": ["gypsum mineral"]}, {"entity_id": "gypsum", "book_id": "kosmos_humboldt_1845", "name": "gypsum", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["gypsum"], "contexts": ["mineral beds formed from fluids", "product of anhydrite absorption of water"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gypsum", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "gypses", "similarity": 0.885}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gypsum", "target_book": "kosmos_humboldt_1845", "target_name": "gypsum", "similarity": 0.977}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "gypse", "target_book": "kosmos_humboldt_1845", "target_name": "gypsum", "similarity": 0.915}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "gypses", "target_book": "kosmos_humboldt_1845", "target_name": "gypsum", "similarity": 0.922}], "id": 981, "stable_key": "clu_1912aecbbb0020f3", "ground_truth": {"modern_name": "Gypsum", "confidence": "high", "type": "mineral", "wikidata_id": "Q82658", "wikidata_description": "mineral, calcium sulfate with bounded water", "wikipedia_url": "https://en.wikipedia.org/wiki/Gypsum", "wikipedia_extract": "Gypsum is a soft sulfate mineral composed of calcium sulfate dihydrate, with the chemical formula CaSO4\u00b72H2O. It is widely mined and is used as a fertilizer and as the main constituent in many forms of plaster, drywall and blackboard or sidewalk chalk. Gypsum also crystallizes as translucent crystals of selenite. It forms as an evaporite mineral and as a hydration product of anhydrite. The Mohs scale of mineral hardness defines gypsum as hardness value 2 based on scratch hardness comparison. Fine-grained white or lightly tinted forms of gypsum known as alabaster have been used for sculpture by many cultures including Ancient Egypt, Mesopotamia, Ancient Rome, the Byzantine Empire, and the Nottingham alabasters of Medieval England.", "note": "The term 'gesso' in this context refers to gypsum, a mineral commonly used in medicinal preparations and sometimes for adulteration."}}, {"canonical_name": "New Zealand", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 24, "members": [{"entity_id": "new_zealand", "book_id": "origin_of_species_darwin_1859", "name": "New Zealand", "category": "PLACE", "subcategory": "COUNTRY", "count": 17, "variants": ["New Zealand"], "contexts": ["country whose trees were tabulated", "country with endemic productions"]}, {"entity_id": "new_zealand", "book_id": "kosmos_humboldt_1845", "name": "New Zealand", "category": "PLACE", "subcategory": "COUNTRY", "count": 6, "variants": ["New Zealand"], "contexts": ["location of bird bones", "island nation mentioned in passage"]}, {"entity_id": "new_zealand", "book_id": "connexion_physical_sciences_somerville_1858", "name": "New Zealand", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["New Zealand"], "contexts": ["geographic location east of South Pole"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "New Zealand", "target_book": "kosmos_humboldt_1845", "target_name": "New Zealand", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "New Zealand", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "New Zealand", "similarity": 0.844}, {"source_book": "kosmos_humboldt_1845", "source_name": "New Zealand", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "New Zealand", "similarity": 0.844}], "id": 982, "stable_key": "clu_9c012e6ff069253b", "ground_truth": {"modern_name": "New Zealand", "confidence": "high", "type": "place", "country": "New Zealand", "wikidata_id": "Q664", "wikidata_description": "island country in the southwest Pacific Ocean", "wikipedia_url": "https://en.wikipedia.org/wiki/New%20Zealand", "wikipedia_extract": "New Zealand is an island country in the southwestern Pacific Ocean. It consists of two main landmasses\u2014the North Island (Te Ika-a-M\u0101ui) and the South Island (Te Waipounamu)\u2014and over 600 smaller islands. It is the sixth-largest island country by area and lies east of Australia across the Tasman Sea and south of the islands of New Caledonia, Fiji, and Tonga. The country's varied topography and sharp mountain peaks, including the Southern Alps (K\u0101 Tiritiri o te Moana), owe much to tectonic uplift and volcanic eruptions. New Zealand's capital city is Wellington, and its most populous city is Auckland. The islands of New Zealand were the last large habitable land to be settled by humans."}}, {"canonical_name": "miel", "category": "ANIMAL", "subcategory": "PRODUCT", "book_count": 3, "total_mentions": 24, "members": [{"entity_id": "honey", "book_id": "origin_of_species_darwin_1859", "name": "honey", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 8, "variants": ["honey"], "contexts": ["product stored in bee cells", "substance stored by bees"]}, {"entity_id": "miel", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "miel", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 14, "variants": ["miel"], "contexts": ["sweet substance produced by bees or from plants", "sweet liquid product"]}, {"entity_id": "miel", "book_id": "relation_historique_humboldt_vol3_1825", "name": "miel", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 2, "variants": ["miel"], "contexts": ["product derived from sugar", "delightful scent from the island"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "honey", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "miel", "similarity": 0.914}, {"source_book": "origin_of_species_darwin_1859", "source_name": "honey", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "miel", "similarity": 0.914}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "miel", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "miel", "similarity": 1.0}], "id": 983, "stable_key": "clu_2e38479dd533024a", "ground_truth": {"modern_name": "Honey", "confidence": "high", "type": "chemical", "wikidata_id": "Q30034", "wikidata_description": "species of insect", "wikipedia_url": "https://en.wikipedia.org/wiki/Western%20honey%20bee"}}, {"canonical_name": "Plata", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 24, "members": [{"entity_id": "plata", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "plata", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["plata"], "contexts": ["silver, a precious metal", "ornamental metal"]}, {"entity_id": "plata", "book_id": "historia_medicinal_monardes_1574", "name": "Plata", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 19, "variants": ["Plata", "plata"], "contexts": ["silver, a metal", "silver"]}, {"entity_id": "platina", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Platina", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Platina", "platina"], "contexts": ["incandescent metal for heat source", "incandescent material for heat source"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "plata", "target_book": "historia_medicinal_monardes_1574", "target_name": "Plata", "similarity": 0.93}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "plata", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Platina", "similarity": 0.923}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Plata", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Platina", "similarity": 0.963}], "id": 984, "stable_key": "clu_29bc88ddbd489182-2", "ground_truth": {"modern_name": null, "confidence": "high", "type": "mineral", "note": "While 'Plata' can mean silver, the context of 'platine' and 'Platina' strongly indicates platinum, a distinct precious metal.", "wikidata_id": "Q880", "wikidata_description": "chemical element with symbol Pt and atomic number 78", "wikipedia_url": "https://en.wikipedia.org/wiki/Platinum", "wikipedia_extract": "Platinum is a chemical element; it has symbol Pt and atomic number 78. It is a dense, malleable, ductile, highly unreactive, precious, silverish-white transition metal. Its name originates from Spanish platina, a diminutive of plata \"silver\". Platinum is a member of the platinum group of elements and group 10 of the periodic table of elements. It has six naturally occurring isotopes. It is one of the rarer elements in Earth's crust, with an average abundance of approximately 5 \u03bcg/kg."}}, {"canonical_name": "laranja", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 24, "members": [{"entity_id": "naranjas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "naranjas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["naranjas"], "contexts": ["fruit with strong flavor and odor", "fruit used to flavor mag\u00fcey wine"]}, {"entity_id": "laranja", "book_id": "coloquios_da_orta_1563", "name": "laranja", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["laranja", "Laranjas", "larangeira", "laranjas", "laranjeira", "laranjeiras", "naranja"], "contexts": ["fruit, orange", "fruit, juice used in medicine"]}, {"entity_id": "flor_de_laranja", "book_id": "polyanthea_medicinal", "name": "flor de laranja", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["flor de laranja", "flor de laran"], "contexts": ["flower used to make scented water", "orange blossom water"]}, {"entity_id": "laranjas", "book_id": "polyanthea_medicinal", "name": "Laranjas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Laranjas", "laranjas"], "contexts": ["fruit used to treat coughs", "fruit used as remedy"]}, {"entity_id": "laranja", "book_id": "polyanthea_medicinal", "name": "laranja", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["laranja"], "contexts": ["orange used for flowers", "size comparison for bladder stone"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "naranjas", "target_book": "coloquios_da_orta_1563", "target_name": "laranja", "similarity": 0.928}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "naranjas", "target_book": "polyanthea_medicinal", "target_name": "Laranjas", "similarity": 0.967}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "naranjas", "target_book": "polyanthea_medicinal", "target_name": "laranja", "similarity": 0.928}, {"source_book": "coloquios_da_orta_1563", "source_name": "laranja", "target_book": "polyanthea_medicinal", "target_name": "flor de laranja", "similarity": 0.916}, {"source_book": "coloquios_da_orta_1563", "source_name": "laranja", "target_book": "polyanthea_medicinal", "target_name": "Laranjas", "similarity": 0.956}, {"source_book": "coloquios_da_orta_1563", "source_name": "laranja", "target_book": "polyanthea_medicinal", "target_name": "laranja", "similarity": 1.0}], "id": 985, "stable_key": "clu_477bd166880efa98", "ground_truth": {"modern_name": "orange", "confidence": "high", "type": "plant", "linnaean": "Citrus \u00d7 sinensis", "family": "Rutaceae", "description": "A citrus fruit and its parts, used in food and medicine.", "note": "Includes mentions of both sweet and sour oranges, as well as blossoms.", "wikipedia_extract": "Citrus \u00d7 sinensis (sometimes written Citrus sinensis), is a broadleaf evergreen hybrid between pomelo (Citrus maxima) and mandarin (Citrus reticulata). Hybrid sweet oranges are commonly cultivated fruits that include Valencia oranges, blood oranges and navel oranges. The orange fruit is an important agricultural product, used for both the juicy fruit pulp and the aromatic peel (rind). Orange blossoms (the flowers) are used in several different ways, as are the leaves and wood of the tree. The orange blossom, which is the state flower of Florida, is highly fragrant and traditionally associated with good fortune. It has long been popular in bridal bouquets and head wreaths."}}, {"canonical_name": "esmeralda", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 24, "members": [{"entity_id": "esmeralda", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "esmeralda", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["esmeralda"], "contexts": ["emerald"]}, {"entity_id": "esmeralda", "book_id": "coloquios_da_orta_1563", "name": "esmeralda", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 16, "variants": ["esmeralda", "esmeraldas", "esmeraldas do Peru", "esmeraldas occidentaes", "esmeraldas orientaes"], "contexts": ["gemstone", "type of gemstone"]}, {"entity_id": "esmeralda", "book_id": "polyanthea_medicinal", "name": "Esmeralda", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["Esmeralda", "elmeraldas", "esmeralda", "esmeraldas", "e\u017fmeraldas"], "contexts": ["powdered emerald attracts poison", "gemstone with occult virtue"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "esmeralda", "target_book": "coloquios_da_orta_1563", "target_name": "esmeralda", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "esmeralda", "target_book": "polyanthea_medicinal", "target_name": "Esmeralda", "similarity": 0.993}, {"source_book": "coloquios_da_orta_1563", "source_name": "esmeralda", "target_book": "polyanthea_medicinal", "target_name": "Esmeralda", "similarity": 0.993}], "id": 986, "stable_key": "clu_f15edf28cbbd7160", "ground_truth": {"modern_name": "Emerald", "confidence": "high", "type": "mineral", "wikidata_id": "Q43513", "wikidata_description": "city in and county seat of King County, State of Washington, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Emerald", "wikipedia_extract": "Emerald is a gemstone and a variety of the mineral beryl (Be3Al2(SiO3)6) colored green by trace amounts of chromium or sometimes vanadium. Beryl has a hardness of 7.5\u20138 on the Mohs scale. Most emeralds have many inclusions, so their toughness (resistance to breakage) is classified as generally poor. Emerald is a cyclosilicate. It occurs mainly in association with quartz, muscovite, albite, schorl, microcline, fluorite, smoky quartz and elbaite. The word \"emerald\" is derived (via Old French: esmeraude and Middle English: emeraude), from Vulgar Latin: esmaralda/esmaraldus, a variant of Latin smaragdus, which was via Ancient Greek: \u03c3\u03bc\u03ac\u03c1\u03b1\u03b3\u03b4\u03bf\u03c2 (sm\u00e1ragdos; \"green gem\")."}}, {"canonical_name": "Londres", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 24, "members": [{"entity_id": "londres", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Londres", "category": "PLACE", "subcategory": "CITY", "count": 19, "variants": ["Londres", "Lond"], "contexts": ["city for financial transactions", "city where documents were presented"]}, {"entity_id": "londres", "book_id": "coloquios_da_orta_1563", "name": "Londres", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Londres"], "contexts": ["city where Isaac Judaeus' works were published", "city where spice price was high"]}, {"entity_id": "londres", "book_id": "polyanthea_medicinal", "name": "Londres", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Londres"], "contexts": ["city where observation was made"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Londres", "target_book": "coloquios_da_orta_1563", "target_name": "Londres", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Londres", "target_book": "polyanthea_medicinal", "target_name": "Londres", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Londres", "target_book": "polyanthea_medicinal", "target_name": "Londres", "similarity": 1.0}], "id": 987, "stable_key": "clu_a99df22ea91362d2-2", "ground_truth": {"modern_name": "London", "confidence": "high", "type": "place", "description": "Capital city of England, often mentioned as a place of publication.", "wikipedia_extract": "London is the capital and largest city of both England and the United Kingdom, with a population of 9.1 million people in 2024. Its wider metropolitan area is the largest in Western Europe, with a population of 15.1 million. London stands on the River Thames in southeast England, at the head of a 50-mile (80 km) tidal estuary down to the North Sea, and has been a major settlement for nearly 2,000 years. Its ancient core and financial centre, the City of London, was founded by the Romans as Londinium and has retained its medieval boundaries. The City of Westminster, to the west of the City of London, for centuries has been as the site of the national government and parliament. London grew rapidly in the 19th century, becoming the world's largest city at the time."}}, {"canonical_name": "Teneriffe", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 24, "members": [{"entity_id": "t\u00e9n\u00e9riffe", "book_id": "relation_historique_humboldt_vol3_1825", "name": "T\u00e9n\u00e9riffe", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["T\u00e9n\u00e9riffe"], "contexts": ["location with lava promontories", "location south of which sandstone is found"]}, {"entity_id": "teneriffe", "book_id": "kosmos_humboldt_1845", "name": "Teneriffe", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Teneriffe"], "contexts": ["location of observations", "location of a volcano"]}, {"entity_id": "peak_of_teneriffe", "book_id": "kosmos_humboldt_1845", "name": "Peak of Teneriffe", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["Peak of Teneriffe"], "contexts": ["mountainous location with natural impressions", "volcanic mountain summit"]}, {"entity_id": "peak_of_teneriffe", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Peak of Teneriffe", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Peak of Teneriffe"], "contexts": ["location with prevailing west winds", "location of high-altitude heat measurement"]}, {"entity_id": "teneriffe", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Teneriffe", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Teneriffe"], "contexts": ["location of observation on a peak", "volcano with successive zones of vegetation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "T\u00e9n\u00e9riffe", "target_book": "kosmos_humboldt_1845", "target_name": "Teneriffe", "similarity": 0.801}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "T\u00e9n\u00e9riffe", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Teneriffe", "similarity": 0.801}, {"source_book": "kosmos_humboldt_1845", "source_name": "Teneriffe", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Peak of Teneriffe", "similarity": 0.891}, {"source_book": "kosmos_humboldt_1845", "source_name": "Teneriffe", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Teneriffe", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Peak of Teneriffe", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Peak of Teneriffe", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Peak of Teneriffe", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Teneriffe", "similarity": 0.891}], "id": 988, "stable_key": "clu_4e4a9b5bbbf485b7", "ground_truth": {"modern_name": "Tenerife", "confidence": "high", "type": "place", "country": "Spain", "wikidata_id": "Q40846", "wikidata_description": "largest island of the Canary Islands", "wikipedia_url": "https://en.wikipedia.org/wiki/Tenerife", "wikipedia_extract": "Tenerife ( TEN-\u0259-REEF-(ay); Spanish: [tene\u02c8\u027eife] ; formerly spelled Teneriffe) is the largest and most-populous island of the Canary Islands, an autonomous community of Spain. With a land area of 2,034.38 km2 (785.48 mi2) and a population of 972,018 inhabitants as of January 2026, it is the most-populous island in Spain and the entire Macaronesia region. Tenerife is also home to 42.7% of the total population of the archipelago. More than seven million tourists (7,384,707 in 2024) visit Tenerife each year, making it by far the most visited island in the archipelago. It is one of the most important tourist destinations in Spain and the world, hosting one of the world's largest carnivals, the Carnival of Santa Cruz de Tenerife. The capital of the island, Santa Cruz de Tenerife, is also the seat of the island council (cabildo insular)."}}, {"canonical_name": "f\u00edsica", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 24, "members": [{"entity_id": "physique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Physique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Physique"], "contexts": ["field of study"]}, {"entity_id": "physique", "book_id": "kosmos_humboldt_1845", "name": "Physique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Physique"], "contexts": ["Pectet's physics work", "title of Pectet's work"]}, {"entity_id": "f\u00edsica", "book_id": "coloquios_da_orta_1563", "name": "f\u00edsica", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 21, "variants": ["f\u00edsica", "fisica"], "contexts": ["Medicine or medical practice", "the study of nature and medicine"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Physique", "target_book": "kosmos_humboldt_1845", "target_name": "Physique", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Physique", "target_book": "coloquios_da_orta_1563", "target_name": "f\u00edsica", "similarity": 0.942}], "id": 989, "stable_key": "clu_d54499592f6f2116", "ground_truth": {"modern_name": "Physics", "confidence": "high", "type": "concept", "wikidata_id": "Q413", "wikidata_description": "study of matter and its motion, along with related concepts such as energy and force", "wikipedia_url": "https://en.wikipedia.org/wiki/Physics"}}, {"canonical_name": "Mica", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 24, "members": [{"entity_id": "mica", "book_id": "kosmos_humboldt_1845", "name": "mica", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 9, "variants": ["mica"], "contexts": ["mineral decomposing in granites and porphyries", "simple mineral in composite rocks"]}, {"entity_id": "mica", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mica", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 12, "variants": ["Mica", "mica"], "contexts": ["crystal for polarized light phenomena", "crystal exhibiting colored images with polarized light"]}, {"entity_id": "mica", "book_id": "first_principles_spencer_1862", "name": "mica", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["mica"], "contexts": ["silicate mineral", "mineral component of granite"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "mica", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mica", "similarity": 0.793}, {"source_book": "kosmos_humboldt_1845", "source_name": "mica", "target_book": "first_principles_spencer_1862", "target_name": "mica", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Mica", "target_book": "first_principles_spencer_1862", "target_name": "mica", "similarity": 0.793}], "id": 990, "stable_key": "clu_7b87f0eab1924bb2", "ground_truth": {"modern_name": "Mica", "confidence": "high", "type": "mineral", "wikidata_id": "Q114675", "wikidata_description": "group of phyllosilicate minerals", "wikipedia_url": "https://en.wikipedia.org/wiki/Mica", "wikipedia_extract": "Micas ( MY-k\u0259z) are a group of silicate minerals whose outstanding physical characteristic is that individual mica crystals can easily be split into fragile elastic plates. This characteristic is described as perfect basal cleavage. Mica is common in igneous and metamorphic rock and is occasionally found as small flakes in sedimentary rock. It is particularly prominent in many granites, pegmatites, and schists, and \"books\" (large individual crystals) of mica several feet across have been found in some pegmatites. Micas are used in products such as drywalls, paints, and fillers, especially in parts for automobiles, roofing, and in electronics. The mineral is used in cosmetics and food to add \"shimmer\" or \"frost\"."}}, {"canonical_name": "physicien", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 23, "members": [{"entity_id": "physicien", "book_id": "medecine_experimentale_bernard_1865", "name": "physicien", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 20, "variants": ["physicien"], "contexts": ["practitioner who experiments on phenomena", "practitioner of physics"]}, {"entity_id": "physicist", "book_id": "kosmos_humboldt_1845", "name": "physicist", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["physicist"], "contexts": ["scientist studying physics"]}, {"entity_id": "physicist", "book_id": "first_principles_spencer_1862", "name": "physicist", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 2, "variants": ["physicist", "Physicist"], "contexts": ["scientist studying physics", "practitioner of physics"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "physicien", "target_book": "kosmos_humboldt_1845", "target_name": "physicist", "similarity": 0.975}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "physicien", "target_book": "first_principles_spencer_1862", "target_name": "physicist", "similarity": 0.906}, {"source_book": "kosmos_humboldt_1845", "source_name": "physicist", "target_book": "first_principles_spencer_1862", "target_name": "physicist", "similarity": 0.927}], "id": 991, "stable_key": "clu_568d02ecb976fd7f", "ground_truth": {"modern_name": "physicist", "confidence": "high", "type": "person", "description": "A scientist who studies the fundamental constituents and behavior of matter and energy.", "note": "The term 'physiciens' and 'physicists' in the context of Humboldt's work, especially in 'Kosmos', clearly refers to natural philosophers and early scientists who studied physical phenomena, which aligns with the modern concept of a physicist.", "wikidata_id": "Q169470", "wikidata_description": "scientist who does research in physics", "wikipedia_url": "https://en.wikipedia.org/wiki/Physicist", "wikipedia_extract": "A physicist is a scientist who specializes in the field of physics, which encompasses the interactions of matter and energy at all length and time scales in the physical universe. Physicists generally are interested in the root or ultimate causes of phenomena, and usually frame their understanding in mathematical terms. They work across a wide range of research fields, spanning all length scales: from sub-atomic and particle physics, through biological physics, to cosmological length scales encompassing the universe as a whole. The field generally includes two types of physicists: experimental physicists who specialize in the observation of natural phenomena and the development and analysis of experiments, and theoretical physicists who specialize in mathematical modeling of physical systems to rationalize, explain and predict natural phenomena. Physicists can apply their knowledge towards solving practical problems or to developing new technologies (also known as applied physics or engineering physics). The study and practice of physics is based on an intellectual ladder of discoveries and insights from ancient times to the present."}}, {"canonical_name": "Pestilence", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 3, "total_mentions": 23, "members": [{"entity_id": "pestilence", "book_id": "english_physician_1652", "name": "Pestilence", "category": "DISEASE", "subcategory": "ACUTE", "count": 16, "variants": ["Pestilence", "Pestilences", "Pestilent Feavers"], "contexts": ["highly infectious disease", "infection that the herb defends against"]}, {"entity_id": "pestilenciales", "book_id": "historia_medicinal_monardes_1574", "name": "pestilenciales", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["pestilenciales"], "contexts": ["pestilential fevers"]}, {"entity_id": "pestilencia", "book_id": "polyanthea_medicinal", "name": "pestilencia", "category": "DISEASE", "subcategory": "ACUTE", "count": 6, "variants": ["pestilencia", "Pestilentis febris"], "contexts": ["pestilence or plague", "plague, a widespread epidemic"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Pestilence", "target_book": "historia_medicinal_monardes_1574", "target_name": "pestilenciales", "similarity": 0.943}, {"source_book": "english_physician_1652", "source_name": "Pestilence", "target_book": "polyanthea_medicinal", "target_name": "pestilencia", "similarity": 0.984}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "pestilenciales", "target_book": "polyanthea_medicinal", "target_name": "pestilencia", "similarity": 0.931}], "id": 992, "stable_key": "clu_ff1adb9e8ce8faf2-2", "ground_truth": {"modern_name": "Plague", "confidence": "high", "type": "disease", "modern_term": "Plague", "wikidata_id": "Q133780", "wikidata_description": "specific contagious and frequently fatal human disease caused by Yersinia pestis", "wikipedia_extract": "Plague is an infectious disease caused by the bacterium Yersinia pestis. Symptoms include fever, weakness, headache and black lips. Usually, this begins one to seven days after exposure. There are three forms of plague, each affecting a different part of the body and causing associated symptoms. Pneumonic plague infects the lungs, causing shortness of breath, coughing and chest pain; bubonic plague affects the lymph nodes, making them swell; and septicemic plague infects the blood and can cause tissues to turn black and die. The bubonic and septicemic forms are generally spread by flea bites or handling an infected animal, whereas pneumonic plague is generally spread between people through the air via infectious droplets.", "wikipedia_url": "https://en.wikipedia.org/wiki/Plague_(disease)", "description": "A highly contagious and often fatal infectious disease.", "note": "Covers terms related to the bubonic plague and similar epidemic diseases."}}, {"canonical_name": "lagartos", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 23, "members": [{"entity_id": "lagarto", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "lagarto", "category": "ANIMAL", "subcategory": "REPTILE", "count": 4, "variants": ["lagarto", "LAGARTO", "Lagarto"], "contexts": ["lizard", "type of lizard"]}, {"entity_id": "lagartos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "lagartos", "category": "ANIMAL", "subcategory": "REPTILE", "count": 4, "variants": ["lagartos"], "contexts": ["lizard-like reptiles", "animal that provokes lust like axolotl"]}, {"entity_id": "lagarto", "book_id": "historia_medicinal_monardes_1574", "name": "Lagarto", "category": "ANIMAL", "subcategory": "REPTILE", "count": 3, "variants": ["Lagarto", "Lagartos"], "contexts": ["lizard, used for comparison of tail", "lizard, referring to Cayman"]}, {"entity_id": "lagartos", "book_id": "polyanthea_medicinal", "name": "lagartos", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 12, "variants": ["lagartos", "Lagartixa", "Lagarto", "lagartixa", "lagarto"], "contexts": ["lizards", "Animals that fast"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "lagarto", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lagarto", "similarity": 0.765}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "lagarto", "target_book": "polyanthea_medicinal", "target_name": "lagartos", "similarity": 0.905}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "lagartos", "target_book": "polyanthea_medicinal", "target_name": "lagartos", "similarity": 0.942}], "id": 993, "stable_key": "clu_38e92d2105bb46ef", "ground_truth": {"modern_name": "Lizard", "confidence": "high", "type": "animal", "wikidata_id": "Q164091", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Houttuynia%20cordata"}}, {"canonical_name": "Perdiz", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 23, "members": [{"entity_id": "perdiz", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "perdiz", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["perdiz"], "contexts": ["partridge"]}, {"entity_id": "perdiz", "book_id": "coloquios_da_orta_1563", "name": "perdiz", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["perdiz", "perdi^", "perdizes"], "contexts": ["partridge, a food item", "food for the sick"]}, {"entity_id": "perdiz", "book_id": "polyanthea_medicinal", "name": "Perdiz", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 19, "variants": ["Perdiz", "o dePerdiz", "perdiz"], "contexts": ["partridge", "partridge used in a broth"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "perdiz", "target_book": "coloquios_da_orta_1563", "target_name": "perdiz", "similarity": 0.861}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "perdiz", "target_book": "polyanthea_medicinal", "target_name": "Perdiz", "similarity": 0.596}, {"source_book": "coloquios_da_orta_1563", "source_name": "perdiz", "target_book": "polyanthea_medicinal", "target_name": "Perdiz", "similarity": 0.738}], "id": 994, "stable_key": "clu_e94e7b3fbf380929", "ground_truth": {"modern_name": "partridge", "confidence": "high", "type": "animal", "wikidata_id": "Q93235", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Vaccinium%20vitis-idaea", "wikipedia_extract": "A partridge is a medium-sized galliform bird in any of several genera, with a wide native distribution throughout parts of Europe, Asia and Africa. Several species have been introduced to the Americas. They are sometimes grouped in the Perdicinae subfamily of the Phasianidae (pheasants, quail, etc.). However, molecular research suggests that partridges are not a distinct taxon within the superfamily Phasianoidea, but that some species are closer to the pheasants, while others are closer to the junglefowl. Partridges are medium-sized game birds, generally intermediate in size between the larger pheasants and smaller quail; they're ground-dwelling birds that feature variable plumage colouration across species, with most tending to grey and brown. Partridges are native to Europe, Asia, Africa, and the Middle East.", "description": "A game bird, often prepared as food."}}, {"canonical_name": "enfermidade", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 23, "members": [{"entity_id": "illness", "book_id": "principles_of_psychology_james_1890", "name": "illness", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["illness"], "contexts": ["condition that enfeebles memory"]}, {"entity_id": "enfermidade", "book_id": "polyanthea_medicinal", "name": "enfermidade", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 21, "variants": ["enfermidade"], "contexts": ["Domestic enemy, miserable captivity", "A state of ill health"]}, {"entity_id": "illness", "book_id": "first_principles_spencer_1862", "name": "illness", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["illness"], "contexts": ["state of being unwell"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "illness", "target_book": "polyanthea_medicinal", "target_name": "enfermidade", "similarity": 0.985}, {"source_book": "principles_of_psychology_james_1890", "source_name": "illness", "target_book": "first_principles_spencer_1862", "target_name": "illness", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "enfermidade", "target_book": "first_principles_spencer_1862", "target_name": "illness", "similarity": 0.985}], "id": 995, "stable_key": "clu_66e9b8104ca0ed8c", "ground_truth": {"modern_name": "Illness", "confidence": "high", "type": "disease", "modern_term": "Illness", "wikidata_id": "Q3052614", "wikidata_description": "specific phobia that involves an irrational fear of contracting a disease", "note": "While 'enfermidade' can also mean sickness or infirmity, in the context of early modern medical texts, it broadly refers to a state of ill health or disease. 'Illness' is a suitable modern equivalent covering this range."}}, {"canonical_name": "Kepler", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 23, "members": [{"entity_id": "kepler", "book_id": "kosmos_humboldt_1845", "name": "Kepler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 12, "variants": ["Kepler"], "contexts": ["author of 'Epitome Astronomiae Copernicanae'", "astronomer on planetary density and volume"]}, {"entity_id": "kepler", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Kepler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["Kepler"], "contexts": ["discovered laws of planetary motion", "astronomer known for planetary laws"]}, {"entity_id": "kepler", "book_id": "first_principles_spencer_1862", "name": "Kepler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Kepler"], "contexts": ["discovered planetary motion laws", "generalizations of Kepler expressing planet motions"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Kepler", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kepler", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Kepler", "target_book": "first_principles_spencer_1862", "target_name": "Kepler", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Kepler", "target_book": "first_principles_spencer_1862", "target_name": "Kepler", "similarity": 1.0}], "id": 996, "stable_key": "clu_28851b8e21ef4f3f", "ground_truth": {"modern_name": "Johannes Kepler", "confidence": "high", "type": "person", "birth_year": 1571, "death_year": 1630, "description": "Astronomer and mathematician, known for laws of planetary motion.", "wikidata_id": "Q8963", "wikidata_description": "German mathematician and astronomer (1571\u20131630)", "wikipedia_url": "https://en.wikipedia.org/wiki/Johannes%20Kepler", "wikipedia_extract": "Johannes Kepler (27 December 1571 \u2013 15 November 1630) was a German astronomer, mathematician, astrologer, natural philosopher and music theorist. He is a key figure in the 17th-century Scientific Revolution, best known for his laws of planetary motion, and his books Astronomia nova, Harmonice Mundi, and Epitome Astronomiae Copernicanae. The variety and impact of his work made Kepler one of the founders and fathers of modern astronomy, the scientific method, natural science, and modern science. He has been described as the \"father of science fiction\" for his novel Somnium. Kepler was a mathematics teacher at a seminary school in Graz, where he became an associate of Prince Hans Ulrich von Eggenberg. Later he became an assistant to the astronomer Tycho Brahe in Prague, and eventually the imperial mathematician to Emperor Rudolf II and his two successors Matthias and Ferdinand II."}}, {"canonical_name": "physique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "physique", "book_id": "medecine_experimentale_bernard_1865", "name": "physique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 17, "variants": ["physique"], "contexts": ["physics", "established science"]}, {"entity_id": "physiques", "book_id": "medecine_experimentale_bernard_1865", "name": "physiques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["physiques"], "contexts": ["properties related to physics"]}, {"entity_id": "physique", "book_id": "epoques_nature_buffon_1778", "name": "physique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["physique"], "contexts": ["study of matter and energy", "study of nature and the universe"]}, {"entity_id": "physiques", "book_id": "epoques_nature_buffon_1778", "name": "physiques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["physiques"], "contexts": ["relating to the natural world and its phenomena"]}, {"entity_id": "physiques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "physiques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["physiques"], "contexts": ["physical problems"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "physique", "target_book": "epoques_nature_buffon_1778", "target_name": "physique", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "physique", "target_book": "epoques_nature_buffon_1778", "target_name": "physiques", "similarity": 0.931}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "physique", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "physiques", "similarity": 0.931}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "physiques", "target_book": "epoques_nature_buffon_1778", "target_name": "physique", "similarity": 0.931}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "physiques", "target_book": "epoques_nature_buffon_1778", "target_name": "physiques", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "physiques", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "physiques", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "physique", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "physiques", "similarity": 0.931}, {"source_book": "epoques_nature_buffon_1778", "source_name": "physiques", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "physiques", "similarity": 1.0}], "id": 997, "stable_key": "clu_4c58e5c3080aa844", "ground_truth": {"modern_name": "Physics", "confidence": "high", "type": "concept", "wikidata_id": "Q413", "wikidata_description": "study of matter and its motion, along with related concepts such as energy and force", "wikipedia_url": "https://en.wikipedia.org/wiki/Physics"}}, {"canonical_name": "biologie", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "biologie", "book_id": "medecine_experimentale_bernard_1865", "name": "biologie", "category": "CONCEPT", "subcategory": "THEORY", "count": 14, "variants": ["biologie"], "contexts": ["science of life and living organisms", "study of living organisms"]}, {"entity_id": "biology", "book_id": "principles_of_psychology_james_1890", "name": "biology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["biology"], "contexts": ["study of life"]}, {"entity_id": "biology", "book_id": "first_principles_spencer_1862", "name": "Biology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["biology", "Biology"], "contexts": ["study of life", "science underlying morality"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "biologie", "target_book": "principles_of_psychology_james_1890", "target_name": "biology", "similarity": 0.971}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "biologie", "target_book": "first_principles_spencer_1862", "target_name": "Biology", "similarity": 0.948}, {"source_book": "principles_of_psychology_james_1890", "source_name": "biology", "target_book": "first_principles_spencer_1862", "target_name": "Biology", "similarity": 0.971}], "id": 998, "stable_key": "clu_60c87ef9c7b5754a", "ground_truth": {"modern_name": "biology", "confidence": "high", "type": "concept", "wikidata_id": "Q15754328", "wikidata_description": "scientific journal. Official journal of the American Society for Blood and Marrow Transplantation"}}, {"canonical_name": "acide carbonique", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "acide_carbonique", "book_id": "medecine_experimentale_bernard_1865", "name": "acide carbonique", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["acide carbonique"], "contexts": ["gas in the air", "product of respiration, formed from oxygen"]}, {"entity_id": "acide_carbonique", "book_id": "epoques_nature_buffon_1778", "name": "acide carbonique", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["acide carbonique"], "contexts": ["carbonic acid"]}, {"entity_id": "acide_carbonique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "acide carbonique", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 15, "variants": ["acide carbonique", "acide", "acide ac\u00e9tique", "acide bydrochlorique", "acide oxalique"], "contexts": ["carbonic acid, released during spoilage", "gas released from alteration"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "acide carbonique", "target_book": "epoques_nature_buffon_1778", "target_name": "acide carbonique", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "acide carbonique", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "acide carbonique", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "acide carbonique", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "acide carbonique", "similarity": 1.0}], "id": 999, "stable_key": "clu_bbeda28236ac803e-2", "ground_truth": {"modern_name": "Carbonic acid", "confidence": "high", "type": "chemical", "wikidata_id": "Q104334", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Carbonic%20acid", "wikipedia_extract": "Carbonic acid is a chemical compound with the chemical formula H2CO3. The molecule rapidly converts to water and carbon dioxide in the presence of water. In contrast to early-twentieth century textbooks, numerous studies conducted since ca. 1990 identified H2CO3 as a real molecule with a distinct Raman spectrum and with a first-order life-time of ca. 20 ms at 37 \u00b0C. Solid anhydrous carbonic acid has also been isolated."}}, {"canonical_name": "Medicamentos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "m\u00e9dicaments", "book_id": "medecine_experimentale_bernard_1865", "name": "m\u00e9dicaments", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["m\u00e9dicaments"], "contexts": ["substances used for medical treatment", "substances used for treatment"]}, {"entity_id": "medicamente", "book_id": "ricettario_fiorentino_1597", "name": "medicamente", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["medicamente", "Medicamenti", "medecine", "medicamento"], "contexts": ["medicaments, compound medicines", "noble medicine preparation"]}, {"entity_id": "medicamentos", "book_id": "polyanthea_medicinal", "name": "Medicamentos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 14, "variants": ["Medicamentos", "medicament.", "medicamenta", "medicamentapa", "medicamenti", "medicamento", "medicamentos", "medicamento\u017fas", "medicamentum"], "contexts": ["medicines, remedies", "general term for remedies"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "m\u00e9dicaments", "target_book": "ricettario_fiorentino_1597", "target_name": "medicamente", "similarity": 0.98}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "m\u00e9dicaments", "target_book": "polyanthea_medicinal", "target_name": "Medicamentos", "similarity": 0.988}, {"source_book": "ricettario_fiorentino_1597", "source_name": "medicamente", "target_book": "polyanthea_medicinal", "target_name": "Medicamentos", "similarity": 0.978}], "id": 1000, "stable_key": "clu_3773fd7d57f753a1", "ground_truth": {"modern_name": "Medicine", "confidence": "high", "type": "concept", "note": "Refers to the practice of healing and remedies.", "wikidata_id": "Q12140", "wikidata_description": "substance used to diagnose, cure, treat, or prevent disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Substance_dependence", "wikipedia_extract": "Substance dependence, also known as drug dependence, is a biopsychological situation whereby an individual's functionality is dependent on the necessitated re-consumption of a psychoactive substance because of an adaptive state that has developed within the individual from psychoactive substance consumption that results in the experience of withdrawal and that necessitates the re-consumption of the drug. A drug addiction, a distinct concept from substance dependence, is defined as compulsive, out-of-control drug use, despite negative consequences. An addictive drug is a drug which is both rewarding and reinforcing. \u0394FosB, a gene transcription factor, which is now known to be a critical component and common factor in the development of virtually all forms of behavioral and drug addictions, but not dependence. The International Classification of Diseases classifies substance dependence as a mental and behavioural disorder. In the Diagnostic and Statistical Manual of Mental Disorders (DSM-5) (released in 2013), substance abuse and substance dependence were eliminated and replaced with the single diagnosis of substance use disorders."}}, {"canonical_name": "RELATIONS", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "relations", "book_id": "medecine_experimentale_bernard_1865", "name": "relations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["relations"], "contexts": ["connections between entities"]}, {"entity_id": "relations", "book_id": "principles_of_psychology_james_1890", "name": "RELATIONS", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 18, "variants": ["relations", "RELATIONS"], "contexts": ["connections between things", "connections between ideas or objects"]}, {"entity_id": "relations", "book_id": "first_principles_spencer_1862", "name": "relations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["relations"], "contexts": ["connections between successive mental phases", "connections between things"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "relations", "target_book": "principles_of_psychology_james_1890", "target_name": "RELATIONS", "similarity": 0.933}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "relations", "target_book": "first_principles_spencer_1862", "target_name": "relations", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "RELATIONS", "target_book": "first_principles_spencer_1862", "target_name": "relations", "similarity": 0.933}], "id": 1001, "stable_key": "clu_1e97e0e87301a200", "ground_truth": {"modern_name": "Relations", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Alexandre", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "alexander", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Alexander", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["Alexander"], "contexts": ["Macedonian king and conqueror", "Admiral of Alexander"]}, {"entity_id": "alexander", "book_id": "kosmos_humboldt_1845", "name": "Alexander", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 6, "variants": ["Alexander"], "contexts": ["regret applied to progress of observation", "historical figure"]}, {"entity_id": "alexandre", "book_id": "coloquios_da_orta_1563", "name": "Alexandre", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 12, "variants": ["Alexandre", "Alexander", "Alexandra", "Alexandri", "Alixandre"], "contexts": ["great conqueror", "historical figure"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Alexander", "target_book": "kosmos_humboldt_1845", "target_name": "Alexander", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Alexander", "target_book": "coloquios_da_orta_1563", "target_name": "Alexandre", "similarity": 0.873}, {"source_book": "kosmos_humboldt_1845", "source_name": "Alexander", "target_book": "coloquios_da_orta_1563", "target_name": "Alexandre", "similarity": 0.873}], "id": 1002, "stable_key": "clu_2466e80f7fa79a3a", "ground_truth": {"modern_name": "Alexander the Great", "confidence": "high", "type": "person", "birth_year": -356, "death_year": -323, "description": "Macedonian king, conqueror, and historical figure.", "wikidata_id": "Q8409", "wikidata_description": "king of Macedonia and conqueror of Achaemenid Persia (356\u2013323 BC)", "wikipedia_url": "https://en.wikipedia.org/wiki/Alexander%20the%20Great", "wikipedia_extract": "Alexander III of Macedon (Ancient Greek: \u1f08\u03bb\u03ad\u03be\u03b1\u03bd\u03b4\u03c1\u03bf\u03c2, romanized: Al\u00e9xandros; 20/21 July 356 BC \u2013 10/11 June 323 BC), most commonly known as Alexander the Great, was king of the ancient Greek kingdom of Macedon. He succeeded his father Philip II to the throne in 336 BC at the age of 20, and spent most of his reign conducting a lengthy military campaign throughout Asia and Egypt. By the age of 30, he had created one of the largest empires in history, stretching from Greece to northwestern India. He was undefeated in battle and is widely considered to be one of history's greatest and most successful military commanders. Born in Pella, Macedon, Alexander was tutored by philosopher and polymath Aristotle until the age of 16. In 335 BC, shortly after assuming the throne of Macedon, he launched a campaign in the Balkans and reasserted control over Thrace and parts of Illyria before marching on the city of Thebes, which was subsequently destroyed."}}, {"canonical_name": "porco", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "porpoces", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Porpoces", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Porpoces"], "contexts": ["animal discussed for gall presence"]}, {"entity_id": "porcos", "book_id": "coloquios_da_orta_1563", "name": "porcos", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["Porcos", "porcos"], "contexts": ["animals found in abundance", "pigs found in large quantities"]}, {"entity_id": "porco", "book_id": "polyanthea_medicinal", "name": "porco", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 14, "variants": ["porco", "Porco Efpim", "porco E\u017fpim", "porco varra\u00f3", "porcoEspim"], "contexts": ["animal meat", "animal used in a remedy for drowsiness"]}, {"entity_id": "por\u00e7ovejos", "book_id": "polyanthea_medicinal", "name": "por\u00e7ovejos", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["por\u00e7ovejos", "por\u00e7ocozido"], "contexts": ["fumes inhaled for treatment", "animal product used in remedies"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Porpoces", "target_book": "coloquios_da_orta_1563", "target_name": "porcos", "similarity": 0.928}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Porpoces", "target_book": "polyanthea_medicinal", "target_name": "porco", "similarity": 0.907}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Porpoces", "target_book": "polyanthea_medicinal", "target_name": "por\u00e7ovejos", "similarity": 0.903}, {"source_book": "coloquios_da_orta_1563", "source_name": "porcos", "target_book": "polyanthea_medicinal", "target_name": "porco", "similarity": 0.965}, {"source_book": "coloquios_da_orta_1563", "source_name": "porcos", "target_book": "polyanthea_medicinal", "target_name": "por\u00e7ovejos", "similarity": 0.907}], "id": 1003, "stable_key": "clu_8e14846962f338c7", "ground_truth": {"modern_name": "Pigs", "confidence": "medium", "type": "animal", "note": "The term 'porcos' is clearly pigs. 'Porpoces' could refer to porpoises, and 'por\u00e7ovejos' is unclear but potentially a misspelling or regional term. However, the context of gall presence for medicinal use often involved domestic animals like pigs.", "wikidata_id": "Q58697", "wikidata_description": "omnivore species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Wild%20boar", "wikipedia_extract": "The wild boar (Sus scrofa), also known as the wild swine, common wild pig, Eurasian wild pig, or simply wild pig, is a suid native to much of Eurasia and North Africa, and has been introduced to the Americas and Oceania. The species is now one of the widest-ranging mammals in the world, as well as the most widespread suiform. It has been assessed as least concern on the IUCN Red List due to its wide range, high numbers, and adaptability to a diversity of habitats. It has become an invasive species in part of its introduced range. Wild boars probably originated in Southeast Asia during the Early Pleistocene and outcompeted other suid species as they spread throughout the Old World. As of 2005, up to 16 subspecies are recognized, which are divided into four regional groupings based on skull height and lacrimal bone length."}}, {"canonical_name": "difference", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "difference", "book_id": "origin_of_species_darwin_1859", "name": "difference", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["difference"], "contexts": ["state of being unlike"]}, {"entity_id": "difference", "book_id": "principles_of_psychology_james_1890", "name": "difference", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 16, "variants": ["difference"], "contexts": ["distinction between things", "perception of dissimilarity"]}, {"entity_id": "differences", "book_id": "principles_of_psychology_james_1890", "name": "differences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["differences"], "contexts": ["distinctions between things", "type of relation between ideas"]}, {"entity_id": "difference", "book_id": "first_principles_spencer_1862", "name": "difference", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["difference"], "contexts": ["element of thought and cognition", "element of relation"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "difference", "target_book": "principles_of_psychology_james_1890", "target_name": "difference", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "difference", "target_book": "principles_of_psychology_james_1890", "target_name": "differences", "similarity": 0.937}, {"source_book": "origin_of_species_darwin_1859", "source_name": "difference", "target_book": "first_principles_spencer_1862", "target_name": "difference", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "difference", "target_book": "first_principles_spencer_1862", "target_name": "difference", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "differences", "target_book": "first_principles_spencer_1862", "target_name": "difference", "similarity": 0.937}], "id": 1004, "stable_key": "clu_259d06a3a7ff3e15", "ground_truth": {"modern_name": "Difference", "confidence": "high", "type": "concept", "wikidata_id": "Q4658963", "wikidata_description": "system of elements used to distinguish otherwise identical coats of arms belonging to members of the same family"}}, {"canonical_name": "emplastro", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "emplasto", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "emplasto", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 8, "variants": ["emplasto"], "contexts": ["medicated poultice applied to the skin", "medicinal poultice"]}, {"entity_id": "emplasto", "book_id": "historia_medicinal_monardes_1574", "name": "emplasto", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["emplasto", "emplastos"], "contexts": ["preparation applied externally", "form of application for Ambar"]}, {"entity_id": "emplastro", "book_id": "polyanthea_medicinal", "name": "emplastro", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 11, "variants": ["emplastro", "emplasto", "emplastro confortativo", "emplastro de Diafulphur", "emplastro de Diaquila\u00f0", "emplastro de Galba", "emplastros confortativos"], "contexts": ["poultice or plaster, a topical application", "medical application"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "emplasto", "target_book": "historia_medicinal_monardes_1574", "target_name": "emplasto", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "emplasto", "target_book": "polyanthea_medicinal", "target_name": "emplastro", "similarity": 0.956}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "emplasto", "target_book": "polyanthea_medicinal", "target_name": "emplastro", "similarity": 0.956}], "id": 1005, "stable_key": "clu_992a2bc24cd9ce37", "ground_truth": {"modern_name": "Plaster/Poultice", "confidence": "high", "type": "substance", "description": "A medicinal preparation applied externally to the skin.", "wikipedia_extract": "Fernando Jorge da Silva dos Santos (born 25 April 1971), commonly known by the nickname Emplastro (Portuguese pronunciation: [\u1ebd'pla\u0283t\u027eu]; \"poultice\"), is a Portuguese football fan who became a public figure for videobombing television reporters by staying close behind them. Born in Madalena, Vila Nova de Gaia, into a poor family, Santos, along with his four siblings, became orphans when he was still a child. Due to his mental development difficulties, Santos was accompanied by Gaia's CERCI since he was eight years old, and after leaving the cooperative, he worked at Panificadora Coelho in Vilar do Para\u00edso, Gaia, for fifteen years. After leaving that job for disability, he began to dedicate himself to his passion for football. His fame in the world of football began in the early 1990s when he started to appear behind television reporters, or on stadium stands covered by TV cameras, whenever there was a big football match or another major media event. He also popularized himself for the saying \"My father is Pinto da Costa and my mother is V\u00edtor Ba\u00eda\"."}}, {"canonical_name": "Tierra Firme", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "tierra_firme", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "tierra firme", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["tierra firme"], "contexts": ["province where the plant grows", "mainland"]}, {"entity_id": "tierra_firme", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tierra Firme", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Tierra Firme"], "contexts": ["region in a map title", "location of observations"]}, {"entity_id": "tierra_firme", "book_id": "historia_medicinal_monardes_1574", "name": "Tierra Firme", "category": "PLACE", "subcategory": "REGION", "count": 18, "variants": ["Tierra Firme", "Tierra Menga Firme", "Tierra firme"], "contexts": ["region where Cara\u00f1a resin is found", "mainland coast"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "tierra firme", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Tierra Firme", "similarity": 0.858}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "tierra firme", "target_book": "historia_medicinal_monardes_1574", "target_name": "Tierra Firme", "similarity": 0.653}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tierra Firme", "target_book": "historia_medicinal_monardes_1574", "target_name": "Tierra Firme", "similarity": 0.786}], "id": 1006, "stable_key": "clu_d640ac5c57ee5066", "ground_truth": {"modern_name": "Mainland", "confidence": "high", "type": "place", "description": "The principal part of a country or continent, as distinguished from islands.", "note": "Refers to the continental landmass in the Americas, as opposed to islands. Historical Spanish term for the northern coast of South America.", "wikipedia_extract": "Mainland is defined as \"relating to or forming the main part of a country or continent, not including the islands around it [regardless of status under territorial jurisdiction by an entity].\" The term is often politically, economically and/or demographically more significant than politically associated remote territories, such as exclaves or oceanic islands situated outside the continental shelf. In geography, \"mainland\" can denote the continental part of any polity or the main island within an island nation. In geopolitics, \"mainland\" is sometimes used interchangeably with terms like metropole as an antonym to overseas territories. In the sense of \"heartland\", mainland is the opposite of periphery. In some language a separate concept of \"mainland\" is missing and is replaced with a \"continental portion\". The term is relative: in Tasmania, continental Australia is the mainland, while to residents of Flinders Island, the main island of Tasmania is also \"the mainland\", though the geological Australian continent includes all the former plus the island of New Guinea and all the smaller islands (e.g. the Torres Strait Islands) in between."}}, {"canonical_name": "frog", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "frog", "book_id": "principles_of_psychology_james_1890", "name": "frog", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 19, "variants": ["Frog", "FROG", "frog"], "contexts": ["animal used for nerve-centre study", "living animal used in experiment"]}, {"entity_id": "frog", "book_id": "kosmos_humboldt_1845", "name": "frog", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["frog"], "contexts": ["animal whose blood contains animalcules"]}, {"entity_id": "frog", "book_id": "connexion_physical_sciences_somerville_1858", "name": "frog", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["frog"], "contexts": ["limbs of a dead frog", "animal used in experiments"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "frog", "target_book": "kosmos_humboldt_1845", "target_name": "frog", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "frog", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "frog", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "frog", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "frog", "similarity": 1.0}], "id": 1007, "stable_key": "clu_662718af8ba9edd4", "ground_truth": {"modern_name": "frog", "confidence": "high", "type": "animal", "description": "Amphibious animal commonly used in scientific experiments.", "wikipedia_extract": "A frog is any member of a diverse and largely semiaquatic group of short-bodied, tailless amphibian vertebrates composing the order Anura (coming from the Ancient Greek \u1f00\u03bd\u03bf\u03cd\u03c1\u03b1, literally 'without tail'). Frog species with rough skin texture due to wart-like parotoid glands tend to be called toads, but the distinction between frogs and toads is informal and purely cosmetic, and does not reflect taxonomy or evolutionary history. Frogs are widely distributed, ranging from the tropics to subarctic regions, but the greatest concentration of species diversity is in tropical rainforest and associated wetlands. They account for around 88% of extant amphibian species, and are one of the five most diverse vertebrate orders. The oldest fossil \"proto-frog\" Triadobatrachus is known from the Early Triassic of Madagascar (250 million years ago), but molecular clock dating suggests their divergence from other amphibians may extend further back to the Permian, 265 million years ago. Adult frogs have a stout body, protruding eyes, anteriorly-attached tongue, limbs folded underneath, and no tail (the \"tail\" of tailed frogs is an extension of the male cloaca)."}}, {"canonical_name": "Perihelion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "perihelion", "book_id": "kosmos_humboldt_1845", "name": "perihelion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["perihelion"], "contexts": ["point closest to the Sun in orbit"]}, {"entity_id": "perihelion", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Perihelion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 19, "variants": ["Perihelion", "perihelion"], "contexts": ["point of closest approach to the Sun", "point nearest the sun in orbit"]}, {"entity_id": "perihelion", "book_id": "first_principles_spencer_1862", "name": "perihelion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["perihelion"], "contexts": ["point closest to the sun"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "perihelion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Perihelion", "similarity": 0.904}, {"source_book": "kosmos_humboldt_1845", "source_name": "perihelion", "target_book": "first_principles_spencer_1862", "target_name": "perihelion", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Perihelion", "target_book": "first_principles_spencer_1862", "target_name": "perihelion", "similarity": 0.904}], "id": 1008, "stable_key": "clu_823ef5121e7832da", "ground_truth": {"modern_name": "Perihelion", "confidence": "high", "type": "concept", "wikidata_id": "Q622176", "wikidata_description": "precession (rotation) of the orbit of a celestial body", "wikipedia_url": "https://en.wikipedia.org/wiki/Apsidal%20precession", "wikipedia_extract": "In celestial mechanics, apsidal precession (or apsidal advance) is the precession (gradual rotation) of the line connecting the apsides (line of apsides) of an astronomical body's orbit. The apsides are the orbital points farthest (apoapsis) and closest (periapsis) from its primary body. The apsidal precession is the first time derivative of the argument of periapsis, one of the six main orbital elements of an orbit. Apsidal precession is considered positive when the orbit's axis rotates in the same direction as the orbital motion. An apsidal period is the time interval required for an orbit to precess through 360\u00b0, which takes the Earth about 112,000 years and the Moon about 8.85 years. The ancient Greek astronomer Hipparchus noted the apsidal precession of the Moon's orbit (as the revolution of the Moon's apogee with a period of approximately 8.85 years); it is corrected for in the Antikythera Mechanism (circa 80 BCE) (with the supposed value of 8.88 years per full cycle, correct to within 0.34% of current measurements)."}}, {"canonical_name": "conjun\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "conjunction", "book_id": "kosmos_humboldt_1845", "name": "conjunction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["conjunction"], "contexts": ["alignment of celestial bodies"]}, {"entity_id": "conjun\u00e7\u00e3o", "book_id": "polyanthea_medicinal", "name": "conjun\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 13, "variants": ["conjun\u00e7\u00e3o", "Conjun\u00e7a\u00f5menfal", "aconjun\u00e7a\u00f3", "conjun\u00e7a\u00f3", "conjun\u00e7\u00e3omenfal", "conjun\u00e7\u00f5es"], "contexts": ["conjunction, astrological or medical", "conjunction, possibly astrological or medical"]}, {"entity_id": "conjunction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "conjunction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["conjunction"], "contexts": ["alignment of celestial bodies"]}, {"entity_id": "conjunctions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "conjunctions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["conjunctions"], "contexts": ["epochs computed by Lalande"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "conjunction", "target_book": "polyanthea_medicinal", "target_name": "conjun\u00e7\u00e3o", "similarity": 0.923}, {"source_book": "kosmos_humboldt_1845", "source_name": "conjunction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "conjunction", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "conjunction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "conjunctions", "similarity": 0.909}, {"source_book": "polyanthea_medicinal", "source_name": "conjun\u00e7\u00e3o", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "conjunction", "similarity": 0.923}], "id": 1009, "stable_key": "clu_0f21b6495a1beb6e", "ground_truth": {"modern_name": "Conjunction", "confidence": "high", "type": "concept", "note": "The medical and astrological senses are less common in modern discourse but are historical referents."}}, {"canonical_name": "melancholicos", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "melancholico", "book_id": "historia_medicinal_monardes_1574", "name": "Melancholico", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Melancholico"], "contexts": ["humoral quality, melancholic"]}, {"entity_id": "melanc\u00f3licos", "book_id": "coloquios_da_orta_1563", "name": "melanc\u00f3licos", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["melanc\u00f3licos"], "contexts": ["temperament of elephants"]}, {"entity_id": "melancholicos", "book_id": "polyanthea_medicinal", "name": "melancholicos", "category": "CONCEPT", "subcategory": "QUALITY", "count": 19, "variants": ["melancholicos", "Melancholicos", "melancholico", "melancolico"], "contexts": ["people with melancholy", "afflictions of melancholic nature"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Melancholico", "target_book": "coloquios_da_orta_1563", "target_name": "melanc\u00f3licos", "similarity": 0.905}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Melancholico", "target_book": "polyanthea_medicinal", "target_name": "melancholicos", "similarity": 0.884}, {"source_book": "coloquios_da_orta_1563", "source_name": "melanc\u00f3licos", "target_book": "polyanthea_medicinal", "target_name": "melancholicos", "similarity": 0.96}], "id": 1010, "stable_key": "clu_0b617afab6c97504", "ground_truth": {"modern_name": "melancholic", "confidence": "high", "type": "concept", "description": "Relating to or characterized by melancholy; a humoral imbalance.", "note": "Refers to both a temperament and a humoral state.", "wikipedia_extract": "Melancholia or melancholy (Ancient Greek: \u03bc\u03b5\u03bb\u03b1\u03b3\u03c7\u03bf\u03bb\u03af\u03b1, romanized: melanchol\u00eda; from \u03bc\u03ad\u03bb\u03b1\u03b9\u03bd\u03b1 \u03c7\u03bf\u03bb\u03ae, m\u00e9laina chol\u1e17, 'black bile') is a concept found throughout ancient, medieval, and premodern medicine in Europe that describes a condition characterized by markedly depressed mood, bodily complaints, and sometimes hallucinations and delusions. Besides a pathological condition, melancholy could also refer to a mood or temperament and at times it was even used as a description of the human condition in general. Melancholy (or more precisely the 'black bile', from which melancholy derives its name) was regarded as one of the four temperaments matching the four humours. Until the 18th century, doctors and other scholars classified melancholic conditions as such by their perceived common cause \u2013 an excess of a notional fluid known as \"black bile\", which was commonly linked to the spleen. Hippocrates and other ancient physicians described melancholia as a distinct disease with mental and physical symptoms, including persistent fears and despondencies, poor appetite, abulia, sleeplessness, irritability, and agitation. Later, fixed delusions were added by Galen and other physicians to the list of symptoms."}}, {"canonical_name": "Plutarch", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "plutarchus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Plutarchus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Plutarchus"], "contexts": ["sober and learned ancient writer"]}, {"entity_id": "plutarch", "book_id": "kosmos_humboldt_1845", "name": "Plutarch", "category": "PERSON", "subcategory": "AUTHORITY", "count": 11, "variants": ["Plutarch"], "contexts": ["author of 'Vita Alex. Magni'", "ancient historian cited in footnote"]}, {"entity_id": "plutarch", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Plutarch", "category": "PERSON", "subcategory": "AUTHORITY", "count": 7, "variants": ["Plutarch"], "contexts": ["ancient Greek biographer and essayist", "Greek biographer and essayist"]}, {"entity_id": "plutarco", "book_id": "coloquios_da_orta_1563", "name": "Plutarco", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Plutarco", "Plutarcho"], "contexts": ["ancient authority who calls calamus ar\u00e1bio", "ancient writer"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Plutarchus", "target_book": "kosmos_humboldt_1845", "target_name": "Plutarch", "similarity": 0.944}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Plutarch", "target_book": "coloquios_da_orta_1563", "target_name": "Plutarco", "similarity": 0.927}], "id": 1011, "stable_key": "clu_0d5875301dc766f0", "ground_truth": {"modern_name": "Plutarch", "confidence": "high", "type": "person", "birth_year": 46, "death_year": 120, "description": "Greek biographer, historian, and essayist, author of Parallel Lives.", "wikidata_id": "Q41523", "wikidata_description": "Greek philosopher and historian (c. AD 46 \u2013 after AD 119)", "wikipedia_url": "https://en.wikipedia.org/wiki/Plutarch", "wikipedia_extract": "Plutarch (; Ancient Greek: \u03a0\u03bb\u03bf\u03cd\u03c4\u03b1\u03c1\u03c7\u03bf\u03c2, Plo\u00fatarchos, Koine Greek: [\u02c8pl\u00fa\u02d0tark\u02b0os]; before AD 50 \u2013 after 120) was a Greek and later Roman Middle Platonist philosopher, historian, biographer, essayist, and priest at the Temple of Apollo in Delphi. He is known primarily for his Parallel Lives, a series of biographies of illustrious Greeks and Romans, and Moralia, a collection of essays and speeches. Upon becoming a Roman citizen, he was possibly named Lucius Mestrius Plutarchus (\u039b\u03bf\u03cd\u03ba\u03b9\u03bf\u03c2 \u039c\u03ad\u03c3\u03c4\u03c1\u03b9\u03bf\u03c2 \u03a0\u03bb\u03bf\u03cd\u03c4\u03b1\u03c1\u03c7\u03bf\u03c2). Plutarch was born to a prominent family in the small town of Chaeronea, about 30 kilometres (19 mi) east of Delphi, in the Greek region of Boeotia. His family was long established in the town; his father was named Autobulus and his grandfather was named Lamprias. His brothers, Timon and Lamprias, are frequently mentioned in his essays and dialogues, which speak of Timon in particular in the most affectionate terms."}}, {"canonical_name": "leche", "category": "ANIMAL", "subcategory": "PRODUCT", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "milk", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "milk", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["milk"], "contexts": ["animal secretion"]}, {"entity_id": "milk", "book_id": "origin_of_species_darwin_1859", "name": "milk", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 2, "variants": ["milk"], "contexts": ["product from cows", "secreted by developed mamm\u00e6"]}, {"entity_id": "leche", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "leche", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 18, "variants": ["leche"], "contexts": ["animal milk, here referring to plant sap", "milky liquid"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "milk", "target_book": "origin_of_species_darwin_1859", "target_name": "milk", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "milk", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "leche", "similarity": 0.931}, {"source_book": "origin_of_species_darwin_1859", "source_name": "milk", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "leche", "similarity": 0.931}], "id": 1012, "stable_key": "clu_e80007bc8caf22fa", "ground_truth": {"modern_name": "Milk", "confidence": "high", "type": "chemical", "note": "The context 'animal milk, here referring to plant sap' suggests potential ambiguity or a metaphorical use, but 'milk' remains the most fitting primary referent.", "wikidata_id": "Q157184", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Astragalus%20%28plant%29"}}, {"canonical_name": "coton", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "coton", "book_id": "relation_historique_humboldt_vol3_1825", "name": "coton", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 18, "variants": ["coton", "Coton", "cotonnier"], "contexts": ["material used for bands", "plant used for fiber"]}, {"entity_id": "cotton", "book_id": "kosmos_humboldt_1845", "name": "cotton", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cotton"], "contexts": ["fibrous plant material"]}, {"entity_id": "cotton", "book_id": "first_principles_spencer_1862", "name": "cotton", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["cotton"], "contexts": ["agricultural commodity traded", "importing cotton"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "coton", "target_book": "kosmos_humboldt_1845", "target_name": "cotton", "similarity": 0.901}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "coton", "target_book": "first_principles_spencer_1862", "target_name": "cotton", "similarity": 0.901}, {"source_book": "kosmos_humboldt_1845", "source_name": "cotton", "target_book": "first_principles_spencer_1862", "target_name": "cotton", "similarity": 1.0}], "id": 1013, "stable_key": "clu_f89bc72959cc74df", "ground_truth": {"modern_name": "Cotton", "confidence": "high", "type": "plant", "linnaean": "Gossypium", "family": "Malvaceae", "wikidata_id": "Q11457", "wikidata_description": "plant fiber from the genus Gossypium", "wikipedia_url": "https://en.wikipedia.org/wiki/Cotton", "wikipedia_extract": "Cotton (from Arabic  qutn) is a soft, fluffy staple fiber that grows in a boll, or protective case, around the seeds of the cotton plants of the genus Gossypium in the mallow family Malvaceae. The fiber is almost pure cellulose, and can contain minor percentages of waxes, fats, pectins, and water. Under natural conditions, the cotton bolls will increase the dispersal of the seeds. The plant is a shrub native to tropical and subtropical regions around the world, including the Americas, Africa, Egypt and India. The greatest diversity of wild cotton species is found in Mexico, followed by Australia and Africa. Cotton was independently domesticated in the Old and New Worlds."}}, {"canonical_name": "Cordova", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "cordova", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cordova", "category": "PLACE", "subcategory": "CITY", "count": 17, "variants": ["Cordova", "Cordoba"], "contexts": ["location south of Pampas", "province in Buenos Aires"]}, {"entity_id": "c\u00f3rdova", "book_id": "coloquios_da_orta_1563", "name": "C\u00f3rdova", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["C\u00f3rdova"], "contexts": ["city in Spain"]}, {"entity_id": "cordova", "book_id": "polyanthea_medicinal", "name": "Cordova", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Cordova", "cordova"], "contexts": ["cordovan water for moistening vapors", "city known for its waters"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cordova", "target_book": "coloquios_da_orta_1563", "target_name": "C\u00f3rdova", "similarity": 0.908}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cordova", "target_book": "polyanthea_medicinal", "target_name": "Cordova", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "C\u00f3rdova", "target_book": "polyanthea_medicinal", "target_name": "Cordova", "similarity": 0.908}], "id": 1014, "stable_key": "clu_f84f7daff041f0a1", "ground_truth": {"modern_name": "C\u00f3rdoba", "confidence": "high", "type": "place", "description": "City in Spain, also a province in Argentina.", "wikipedia_extract": "C\u00f3rdoba ( KOR-d\u0259-b\u0259; Spanish: [\u02c8ko\u027e\u00f0o\u03b2a] ), or sometimes Cordova ( KOR-d\u0259-v\u0259), is a city in Andalusia, Spain, and the capital of the province of C\u00f3rdoba. With a population of 324,902 as of 2024, it is the 12th-largest city in Spain and the 3rd-largest in Andalusia. The city primarily lies on the right bank of the Guadalquivir in the south of the Iberian Peninsula. Once a Roman colony, it was taken over by the Visigothic Kingdom in the sixth century and then conquered by the Muslims in the eighth century. C\u00f3rdoba became the capital of the Emirate and then Caliphate of C\u00f3rdoba, from which the Umayyad dynasty ruled al-Andalus. Under Umayyad rule, C\u00f3rdoba was transformed into a centre of education and learning, and by the 10th century it had grown to be the second-largest city in Europe."}}, {"canonical_name": "Saussure", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "saussure", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Saussure", "category": "PERSON", "subcategory": "SCHOLAR", "count": 10, "variants": ["Saussure"], "contexts": ["scholar who experimented on soil fertility", "measurer of mountain heights"]}, {"entity_id": "saussure", "book_id": "kosmos_humboldt_1845", "name": "Saussure", "category": "PERSON", "subcategory": "SCHOLAR", "count": 9, "variants": ["Saussure"], "contexts": ["measured Mount Vesuvius elevation", "compared measurements with author"]}, {"entity_id": "mm__saussure", "book_id": "connexion_physical_sciences_somerville_1858", "name": "MM. Saussure", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["MM. Saussure"], "contexts": ["observed mine temperatures"]}, {"entity_id": "saussure", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Saussure", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Saussure"], "contexts": ["discovered red lichen in Alps"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saussure", "target_book": "kosmos_humboldt_1845", "target_name": "Saussure", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saussure", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "MM. Saussure", "similarity": 0.931}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saussure", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Saussure", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Saussure", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "MM. Saussure", "similarity": 0.931}, {"source_book": "kosmos_humboldt_1845", "source_name": "Saussure", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Saussure", "similarity": 1.0}], "id": 1015, "stable_key": "clu_5e7a91569da7c5be", "ground_truth": {"modern_name": "Horace-B\u00e9n\u00e9dict de Saussure", "confidence": "high", "type": "person", "birth_year": 1740, "death_year": 1799, "description": "Swiss geologist, meteorologist, and botanist, studied alpine environments.", "wikidata_id": "Q115525", "wikidata_description": "Genevan scientist (1740-1799)", "wikipedia_url": "https://en.wikipedia.org/wiki/Horace%20B%C3%A9n%C3%A9dict%20de%20Saussure", "wikipedia_extract": "Horace B\u00e9n\u00e9dict de Saussure (French: [\u0254\u0281as benedikt d\u0259 sosy\u0281]; 17 February 1740 \u2013 22 January 1799) was a Genevan geologist, meteorologist, physicist, mountaineer and Alpine explorer (specifically the Mont Blanc massif), often called the founder of alpinism and modern meteorology, and considered to be the first person to build a successful solar oven. Horace B\u00e9n\u00e9dict de Saussure was born 17 February 1740, in Conches, near Geneva, in the Republic of Geneva. Saussure's family were Genevan patricians. His father, Nicolas de Saussure, was an agriculturist, agronomist and author. Because his mother was \"sickly\", Saussure was brought up by his mother's sister and her husband the Genevan naturalist Charles Bonnet, who sparked Horace-B\u00e9n\u00e9dict's early interest in botany. After attending the \"Coll\u00e8ge\" of his hometown, he completed his studies at the Geneva Academy in 1759 with a dissertation on heat (Dissertatio physica de igne)."}}, {"canonical_name": "Chimborazo", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "chimborazo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Chimborazo", "category": "PLACE", "subcategory": "REGION", "count": 10, "variants": ["Chimborazo"], "contexts": ["location in South America", "mountain peak in Ecuador"]}, {"entity_id": "cimborazo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cimborazo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cimborazo"], "contexts": ["mountain name"]}, {"entity_id": "chimborazo", "book_id": "kosmos_humboldt_1845", "name": "Chimborazo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["Chimborazo"], "contexts": ["mountain elevation data", "great Colossus of the Andes"]}, {"entity_id": "chimborazo", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Chimborazo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Chimborazo"], "contexts": ["mountain for gravitational comparison"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Chimborazo", "target_book": "kosmos_humboldt_1845", "target_name": "Chimborazo", "similarity": 0.76}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Chimborazo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Chimborazo", "similarity": 0.76}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cimborazo", "target_book": "kosmos_humboldt_1845", "target_name": "Chimborazo", "similarity": 0.958}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cimborazo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Chimborazo", "similarity": 0.958}, {"source_book": "kosmos_humboldt_1845", "source_name": "Chimborazo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Chimborazo", "similarity": 1.0}], "id": 1016, "stable_key": "clu_4fb265ae640ec3da", "ground_truth": {"modern_name": "Chimborazo", "confidence": "high", "type": "place", "country": "Ecuador", "wikidata_id": "Q238492", "wikidata_description": "province of Ecuador", "wikipedia_url": "https://en.wikipedia.org/wiki/Chimborazo%20Province", "wikipedia_extract": "Chimborazo (Spanish: [t\u0283imbo\u02c8\u027easo] ) is a stratovolcano in Ecuador and the Cordillera Occidental range of the Andes. Its last known eruption is believed to have occurred around AD 550. Although not the tallest mountain in the Andes or on Earth relative to sea level, its summit is the farthest point on Earth's surface from the Earth's center due to its location along the planet's equatorial bulge. Chimborazo's height from sea level is 6,263 m (20,548 ft), well below that of Mount Everest at 8,849 m (29,032 ft). Chimborazo is the highest mountain in Ecuador and the 39th-highest peak in the entire Andes. It is a popular destination for mountaineering due to its challenging climbing routes, which involve traversing snow, ice, and rocky terrain."}}, {"canonical_name": "terra", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "terre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "terre", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["terre"], "contexts": ["the Earth", "celestial body"]}, {"entity_id": "terra", "book_id": "coloquios_da_orta_1563", "name": "terra", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["terra"], "contexts": ["impurity in anil", "land or region"]}, {"entity_id": "terre", "book_id": "ricettario_fiorentino_1597", "name": "Terre", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["terre", "Terre"], "contexts": ["earths used as simple medicines", "earths that can be mixed with Orpimento"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "terre", "target_book": "coloquios_da_orta_1563", "target_name": "terra", "similarity": 0.981}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "terre", "target_book": "ricettario_fiorentino_1597", "target_name": "Terre", "similarity": 0.982}], "id": 1017, "stable_key": "clu_f522307c9c5c037e-3", "ground_truth": {"modern_name": "Earth", "confidence": "high", "type": "place", "country": "Global", "wikidata_id": "Q36133", "wikidata_description": "natural body consisting of layers that are primarily composed of minerals", "wikipedia_url": "https://en.wikipedia.org/wiki/Soil", "wikipedia_extract": "Soil, also commonly referred to as earth, is a mixture of organic matter, minerals, gases, water, and organisms that together support the life of plants and soil organisms. Some scientific definitions distinguish dirt from soil by restricting the former term specifically to displaced soil. Soil consists of a solid collection of minerals and organic matter (the soil matrix), as well as a porous phase that holds gases (the soil atmosphere) and a liquid phase that holds water and dissolved substances both organic and inorganic, in ionic or in molecular form (the soil solution). Accordingly, soil is a complex three-state system of solids, liquids, and gases. Soil is a product of several factors: the influence of climate, relief (elevation, orientation, and slope of terrain), organisms, and the soil's parent materials (original minerals) interacting over time. It continually undergoes development by way of numerous physical, chemical and biological processes, which include weathering with associated erosion.", "note": "The term 'terra' or 'terre' in early modern texts can refer to the planet Earth, or to mineral earths used in medicine or as impurities."}}, {"canonical_name": "distance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "distance", "book_id": "principles_of_psychology_james_1890", "name": "distance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["distance"], "contexts": ["spatial separation from observer", "spatial separation"]}, {"entity_id": "distance", "book_id": "kosmos_humboldt_1845", "name": "distance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["distance"], "contexts": ["space between celestial bodies", "spatial separation between bodies"]}, {"entity_id": "distance", "book_id": "connexion_physical_sciences_somerville_1858", "name": "distance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["distance"], "contexts": ["space between two points", "space between objects"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "distance", "target_book": "kosmos_humboldt_1845", "target_name": "distance", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "distance", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "distance", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "distance", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "distance", "similarity": 1.0}], "id": 1018, "stable_key": "clu_28e00374dfdc6ae5", "ground_truth": {"modern_name": "distance", "confidence": "high", "type": "concept", "note": "The contexts provided (spatial separation, space between celestial bodies/points) strongly indicate the concept of spatial distance.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Menardo", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "mendel", "book_id": "principles_of_psychology_james_1890", "name": "Mendel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Mendel"], "contexts": ["Cited in Archiv f. Psychiatrie"]}, {"entity_id": "menardo", "book_id": "historia_medicinal_monardes_1574", "name": "Menardo", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Menardo"], "contexts": ["authority on water and summer heat"]}, {"entity_id": "menardo", "book_id": "coloquios_da_orta_1563", "name": "Menardo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 19, "variants": ["Menardo"], "contexts": ["modern author criticizing Mesue", "modern scholar cited"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Mendel", "target_book": "coloquios_da_orta_1563", "target_name": "Menardo", "similarity": 0.85}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Menardo", "target_book": "coloquios_da_orta_1563", "target_name": "Menardo", "similarity": 0.669}], "id": 1019, "stable_key": "clu_a8234cbad416a48a", "ground_truth": {"modern_name": "Charles-\u00c9mile de Menard", "confidence": "medium", "type": "person", "description": "Author of medical and botanical works, cited in psychiatric archives.", "note": "The combination of 'Menardo' and the context 'modern author criticizing Mesue' alongside psychiatric archives points to Charles-\u00c9mile de Menard, though 'Mendel' appears as a possible OCR error."}}, {"canonical_name": "Aurora", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "aurora", "book_id": "kosmos_humboldt_1845", "name": "Aurora", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 14, "variants": ["Aurora"], "contexts": ["natural light phenomenon", "celestial phenomenon"]}, {"entity_id": "aurora", "book_id": "coloquios_da_orta_1563", "name": "Aurora", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Aurora"], "contexts": ["dawn, used for pearl color comparison"]}, {"entity_id": "aurora", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Aurora", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["aurora", "Aurora"], "contexts": ["natural light display", "light resembling phenomenon"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Aurora", "target_book": "coloquios_da_orta_1563", "target_name": "Aurora", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Aurora", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Aurora", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Aurora", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Aurora", "similarity": 1.0}], "id": 1020, "stable_key": "clu_86147a708f8c6110", "ground_truth": {"modern_name": "Aurora", "confidence": "high", "type": "concept", "note": "The contexts 'natural light phenomenon', 'dawn', and 'natural light display' all refer to the phenomenon of aurora, likely celestial, or the time of dawn.", "wikidata_id": "Q132015", "wikidata_description": "municipality of the Philippines in the province of Zamboanga del Sur", "wikipedia_url": "https://en.wikipedia.org/wiki/Aurora%2C%20Zamboanga%20del%20Sur", "wikipedia_extract": "Aurora, officially the Municipality of Aurora (Cebuano: Lungsod sa Aurora; Subanen: Benwa Aurora; Maguindanaon: Inged nu Awrura, Jawi: \u0627\u064a\u06a0\u062f \u0646\u0648 \u0627\u0648\u0631\u0648\u0631; Chavacano: Municipalidad de Aurora; Tagalog: Bayan ng Aurora), is a municipality in the province of Zamboanga del Sur, Philippines. According to the 2024 census, it has a population of 52,746 people. The town was named after President Manuel L. Quezon's wife, Aurora Quezon. On July 1, 1941, the barrios of Cebuano Barracks, Parasan, and Tambulig were excised from Pagadian to form the new municipality of Aurora, then part of the undivided province Zamboanga, by virtue of Executive Order No. 353, signed by President Manuel L."}}, {"canonical_name": "dormideyras", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "dormideras", "book_id": "historia_medicinal_monardes_1574", "name": "Dormideras", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Dormideras"], "contexts": ["plant whose dried flowers resemble black seeds"]}, {"entity_id": "durmideiras", "book_id": "coloquios_da_orta_1563", "name": "durmideiras", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["durmideiras", "dormideiras", "dormideiras brancas", "dormydeyras", "durmideiras pretas"], "contexts": ["poppy plants", "white poppy plants"]}, {"entity_id": "dormideyras", "book_id": "polyanthea_medicinal", "name": "dormideyras", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 15, "variants": ["dormideyras", "Dormideiras", "dormideiras", "dormideyras brancas"], "contexts": ["ingredient in poultice for headaches", "sleep-inducing herbs"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Dormideras", "target_book": "coloquios_da_orta_1563", "target_name": "durmideiras", "similarity": 0.977}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Dormideras", "target_book": "polyanthea_medicinal", "target_name": "dormideyras", "similarity": 0.938}, {"source_book": "coloquios_da_orta_1563", "source_name": "durmideiras", "target_book": "polyanthea_medicinal", "target_name": "dormideyras", "similarity": 0.93}], "id": 1021, "stable_key": "clu_e3c5b4c04bbf88a5", "ground_truth": {"modern_name": "Poppy", "confidence": "high", "type": "plant", "linnaean": "Papaver somniferum Linnaeus", "family": "Papaveraceae", "wikidata_id": "Q967457", "wikidata_description": "common name for various plant species of the family Papaveraceae", "wikipedia_url": "https://en.wikipedia.org/wiki/Poppy", "wikipedia_extract": "A poppy is a flowering plant in the subfamily Papaveroideae of the family Papaveraceae. Poppies are herbaceous plants, often grown for their colourful flowers. One species of poppy, Papaver somniferum, is the source of the narcotic drug mixture opium, which contains powerful medicinal alkaloids such as morphine and has been used since ancient times as an analgesic and narcotic medicinal and recreational drug. It also produces edible seeds. Following the trench warfare in the poppy fields of Flanders, Belgium, during World War I, poppies, specifically the red poppy, have become a symbol of remembrance of soldiers who have died during wartime, especially in the UK, Canada, Australia, Africa and other Commonwealth realms. Poppies are herbaceous annual, biennial or short-lived perennial plants.", "description": "A flowering plant, source of opium and other medicinal compounds.", "note": "Likely refers to species of Papaver, particularly Papaver somniferum."}}, {"canonical_name": "oleo violado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "olio_violado", "book_id": "coloquios_da_orta_1563", "name": "olio violado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["olio violado"], "contexts": ["violet-infused oil"]}, {"entity_id": "olio_violato", "book_id": "ricettario_fiorentino_1597", "name": "olio violato", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["olio violato"], "contexts": ["violet oil used in preparation", "preparation made from violets"]}, {"entity_id": "oleo_violado", "book_id": "polyanthea_medicinal", "name": "oleo violado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 18, "variants": ["oleo violado", "oleo viola do"], "contexts": ["a medicinal preparation", "preparation used as medicine"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "olio violado", "target_book": "ricettario_fiorentino_1597", "target_name": "olio violato", "similarity": 0.996}, {"source_book": "coloquios_da_orta_1563", "source_name": "olio violado", "target_book": "polyanthea_medicinal", "target_name": "oleo violado", "similarity": 0.987}, {"source_book": "ricettario_fiorentino_1597", "source_name": "olio violato", "target_book": "polyanthea_medicinal", "target_name": "oleo violado", "similarity": 0.984}], "id": 1022, "stable_key": "clu_bed70f6326c13d27", "ground_truth": {"modern_name": "Violet Oil", "confidence": "high", "type": "substance", "description": "Medicinal oil infused with violets.", "note": "A pharmaceutical preparation derived from violets.", "wikipedia_extract": "Essential oils are compodes of hydrophobic volatile organic compounds, usually in liquid form, obtained from plant material. Essential oils are also known as volatile oils, ethereal oils, aetheroleum, or simply as the oil of the plant from which they were extracted, such as oil of clove. An essential oil is essential in the sense that the oil contains the fragrance or essence of the plant. The term \"essential\" used here does not indicate that it is nutritionally required in the diet, as with essential amino acid or essential fatty acid. Essential oils, according to ISO, are produced either by steam distillation, by mechanical manipulation of the rind of the fruits of the genus Citrus (also called cold pressing), or by dry distillation. Other methods, such as solvent extraction, are not accepted and, in fact, result in different perfumed products (pommades, concretes, and absolutes)."}}, {"canonical_name": "movimento", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "mouvement", "book_id": "medecine_experimentale_bernard_1865", "name": "mouvement", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["mouvement"], "contexts": ["change in position or posture", "loss of movement"]}, {"entity_id": "mouvement", "book_id": "epoques_nature_buffon_1778", "name": "mouvement", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["mouvement"], "contexts": ["movement", "the act of changing position"]}, {"entity_id": "movimento", "book_id": "polyanthea_medicinal", "name": "movimento", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["movimento", "moimentos", "movimento progre\u017f\u017fivo", "movimentoe\u017fquecido", "movimentos arbitrarios", "movimentos desordenados"], "contexts": ["physical motion", "ability to move"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "mouvement", "target_book": "epoques_nature_buffon_1778", "target_name": "mouvement", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "mouvement", "target_book": "polyanthea_medicinal", "target_name": "movimento", "similarity": 0.986}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mouvement", "target_book": "polyanthea_medicinal", "target_name": "movimento", "similarity": 0.986}], "id": 1023, "stable_key": "clu_5a055ec0f2e1bf90", "ground_truth": {"modern_name": "Movement", "confidence": "high", "type": "concept", "wikidata_id": "Q49773", "wikidata_description": "loosely organized effort by a large group of people to achieve a particular set of goals", "note": "The context 'geological process of land changing position' refers to geological movement, while 'physical motion' refers to physics. Both are encompassed by the broader concept of movement."}}, {"canonical_name": "m\u00e9taux", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "m\u00e9taux", "book_id": "medecine_experimentale_bernard_1865", "name": "m\u00e9taux", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["m\u00e9taux"], "contexts": ["naturally occurring metallic elements", "extracted materials"]}, {"entity_id": "m\u00e9taux", "book_id": "epoques_nature_buffon_1778", "name": "m\u00e9taux", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 9, "variants": ["m\u00e9taux"], "contexts": ["metallic elements", "metals"]}, {"entity_id": "m\u00e9taux", "book_id": "relation_historique_humboldt_vol3_1825", "name": "m\u00e9taux", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 9, "variants": ["m\u00e9taux", "M\u00e9taux", "min\u00e9raux", "m\u00e9talliques", "m\u00e9taux pr\u00e9cieux"], "contexts": ["exportation from Venezuela", "materials found in mountains"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "m\u00e9taux", "target_book": "epoques_nature_buffon_1778", "target_name": "m\u00e9taux", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "m\u00e9taux", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "m\u00e9taux", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "m\u00e9taux", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "m\u00e9taux", "similarity": 1.0}], "id": 1024, "stable_key": "clu_bb45f4c90b7d443d", "ground_truth": {"modern_name": "Metals", "confidence": "high", "type": "mineral", "wikidata_id": "Q11426", "wikidata_description": "element, compound, or alloy that is a good conductor of both electricity and heat", "wikipedia_url": "https://en.wikipedia.org/wiki/Metal"}}, {"canonical_name": "wax", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "wax", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Wax", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 8, "variants": ["wax", "Wax"], "contexts": ["waxy material", "soft, pliable substance"]}, {"entity_id": "wax", "book_id": "origin_of_species_darwin_1859", "name": "wax", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 11, "variants": ["wax"], "contexts": ["material used by bees for comb construction", "material used for making cells"]}, {"entity_id": "wax", "book_id": "principles_of_psychology_james_1890", "name": "wax", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["wax"], "contexts": ["material easily impressed"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Wax", "target_book": "origin_of_species_darwin_1859", "target_name": "wax", "similarity": 0.936}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Wax", "target_book": "principles_of_psychology_james_1890", "target_name": "wax", "similarity": 0.936}, {"source_book": "origin_of_species_darwin_1859", "source_name": "wax", "target_book": "principles_of_psychology_james_1890", "target_name": "wax", "similarity": 1.0}], "id": 1025, "stable_key": "clu_91585d646706f1ce", "ground_truth": {"modern_name": "wax", "confidence": "high", "type": "substance", "description": "A malleable, sticky substance secreted by bees to build their honeycomb.", "wikipedia_extract": "Waxes are a diverse class of organic compounds that are lipophilic solids that are  malleable near ambient temperatures. They include higher alkanes and lipids, typically with melting points above about 40 \u00b0C (104 \u00b0F), melting to give low viscosity liquids. Waxes are insoluble in water but soluble in nonpolar organic solvents such as hexane, benzene and chloroform. Natural waxes of various types are produced by plants and animals and occur in petroleum. Waxes are organic compounds that characteristically consist of long aliphatic alkyl chains, although aromatic compounds may also be present. Natural waxes may contain unsaturated bonds and include various functional groups such as fatty acids, primary and secondary alcohols, ketones, aldehydes and fatty acid esters."}}, {"canonical_name": "sheep", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "sheep", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Sheep", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 4, "variants": ["Sheep"], "contexts": ["have peculiar vermine", "animals that get the Rot"]}, {"entity_id": "sheep", "book_id": "origin_of_species_darwin_1859", "name": "sheep", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 13, "variants": ["Sheep", "sheep"], "contexts": ["domesticated animal", "domesticated mammals with many breeds"]}, {"entity_id": "sheep", "book_id": "first_principles_spencer_1862", "name": "sheep", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["sheep"], "contexts": ["rural inhabitants producing sheep", "domesticated ovine species"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sheep", "target_book": "origin_of_species_darwin_1859", "target_name": "sheep", "similarity": 0.991}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sheep", "target_book": "first_principles_spencer_1862", "target_name": "sheep", "similarity": 0.991}, {"source_book": "origin_of_species_darwin_1859", "source_name": "sheep", "target_book": "first_principles_spencer_1862", "target_name": "sheep", "similarity": 1.0}], "id": 1026, "stable_key": "clu_7adf69cdc4a339ea", "ground_truth": {"modern_name": "sheep", "confidence": "high", "type": "animal", "wikidata_id": "Q4628", "wikidata_description": "North Atlantic archipelago organized as an autonomous constituent country of the Kingdom of Denmark", "wikipedia_url": "https://en.wikipedia.org/wiki/Faroe%20Islands", "wikipedia_extract": "The Faroe Islands ( FAIR-oh), also known as the Faroes, are an archipelago in the North Atlantic Ocean and a rigsdel ('autonomous territory') of the Kingdom of Denmark. Located between Iceland, Norway, and the Hebrides and Shetland isles of Scotland, the islands have a population of 54,870 as of November 2025 and a land area of 1,393 km2 (538 sq mi). The official language is Faroese, which is partially mutually intelligible with Icelandic. The terrain is rugged, dominated by fjords and cliffs with sparse vegetation and few trees. As a result of their proximity to the Arctic Circle, the islands experience perpetual civil twilight during summer nights and very short winter days; nevertheless, they experience a subpolar oceanic climate and mild temperatures year-round due to the Gulf Stream. The capital, T\u00f3rshavn, receives the fewest recorded hours of sunshine of any city in the world at only 840 per year.", "description": "Reproductive body laid by female birds, reptiles, amphibians, fish, and insects.", "note": "The context for 'ovelhas' (sheep) is anomalous; it appears to refer to animals that eat a plant, not the egg itself."}}, {"canonical_name": "Berries", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "berries", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Berries", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Berries"], "contexts": ["fleshy fruit of plants"]}, {"entity_id": "berries", "book_id": "english_physician_1652", "name": "Berries", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 18, "variants": ["Berries"], "contexts": ["part of the Bay-Tree", "fruit of the Black Bilberry plant"]}, {"entity_id": "berries", "book_id": "origin_of_species_darwin_1859", "name": "berries", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["berries"], "contexts": ["fleshy fruits of plants"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Berries", "target_book": "english_physician_1652", "target_name": "Berries", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Berries", "target_book": "origin_of_species_darwin_1859", "target_name": "berries", "similarity": 0.962}, {"source_book": "english_physician_1652", "source_name": "Berries", "target_book": "origin_of_species_darwin_1859", "target_name": "berries", "similarity": 0.962}], "id": 1027, "stable_key": "clu_f9b182815230606e", "ground_truth": {"modern_name": "berry", "confidence": "high", "type": "plant", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "instinct", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "instinct", "book_id": "epoques_nature_buffon_1778", "name": "instinct", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["instinct"], "contexts": ["innate behavioral drive"]}, {"entity_id": "instinct", "book_id": "origin_of_species_darwin_1859", "name": "instinct", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 16, "variants": ["Instinct", "INSTINCT", "instinct"], "contexts": ["innate behavioral patterns", "innate behavioral patterns in animals"]}, {"entity_id": "instinct", "book_id": "principles_of_psychology_james_1890", "name": "Instinct", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Instinct"], "contexts": ["chapter topic on innate behaviors", "Innate behavioral pattern"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "instinct", "target_book": "origin_of_species_darwin_1859", "target_name": "instinct", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "instinct", "target_book": "principles_of_psychology_james_1890", "target_name": "Instinct", "similarity": 0.927}, {"source_book": "origin_of_species_darwin_1859", "source_name": "instinct", "target_book": "principles_of_psychology_james_1890", "target_name": "Instinct", "similarity": 0.927}], "id": 1028, "stable_key": "clu_a76d4c90e69b981a", "ground_truth": {"modern_name": "Instinct", "confidence": "high", "type": "concept", "wikidata_id": "Q18237", "wikidata_description": "inherent inclination of a living organism"}}, {"canonical_name": "cooling", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "cooling", "book_id": "english_physician_1652", "name": "cooling", "category": "CONCEPT", "subcategory": "QUALITY", "count": 16, "variants": ["cooling", "Cools", "cool", "coolness", "cools"], "contexts": ["temperature quality", "quality of Blites"]}, {"entity_id": "cooling", "book_id": "kosmos_humboldt_1845", "name": "cooling", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["cooling"], "contexts": ["factor in rock transformation", "process of losing heat"]}, {"entity_id": "cooling", "book_id": "connexion_physical_sciences_somerville_1858", "name": "cooling", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cooling"], "contexts": ["process of losing heat"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "cooling", "target_book": "kosmos_humboldt_1845", "target_name": "cooling", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "cooling", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "cooling", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "cooling", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "cooling", "similarity": 1.0}], "id": 1029, "stable_key": "clu_425ba3f2ab6d7908", "ground_truth": {"modern_name": "Cooling", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Cooling", "note": "Refers to the process or quality of becoming cold or decreasing in temperature.", "wikipedia_extract": "Cooling is removal of heat, usually resulting in a lower temperature and/or phase change. Temperature lowering achieved by any other means may also be called cooling. The transfer of thermal energy may occur via thermal radiation, heat conduction or convection. Examples can be as simple as reducing temperature of tea."}}, {"canonical_name": "De Candolle", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "de_candolle", "book_id": "origin_of_species_darwin_1859", "name": "De Candolle", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["De Candolle"], "contexts": ["philosophically shown organic beings compete", "founded divisions of Umbellifer\u00e6 on seed differences"]}, {"entity_id": "de_candolle", "book_id": "kosmos_humboldt_1845", "name": "De Candolle", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["De Candolle"], "contexts": ["proposed nomenclature"]}, {"entity_id": "de_candolle", "book_id": "coloquios_da_orta_1563", "name": "De Candolle", "category": "PERSON", "subcategory": "SCHOLAR", "count": 15, "variants": ["De Candolle", "A. De Candolle", "De CandoUe"], "contexts": ["author on origin of cultivated plants", "author of Orig. des plantes cultiv\u00e9es"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "De Candolle", "target_book": "kosmos_humboldt_1845", "target_name": "De Candolle", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "De Candolle", "target_book": "coloquios_da_orta_1563", "target_name": "De Candolle", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "De Candolle", "target_book": "coloquios_da_orta_1563", "target_name": "De Candolle", "similarity": 1.0}], "id": 1030, "stable_key": "clu_b382db59cf59c2f6", "ground_truth": {"modern_name": "Augustin Pyramus de Candolle", "confidence": "high", "type": "person", "description": "Swiss botanist influential in the classification of plants.", "note": "Also refers to his son, Alphonse Pyramus de Candolle.", "wikipedia_extract": "Augustin Pyramus (or Pyrame) de Candolle (UK: , US: , French: [k\u0251\u0303d\u0254l]; 4 February 1778 \u2013 9 September 1841) was a Swiss botanist. Ren\u00e9 Louiche Desfontaines launched de Candolle's botanical career by recommending him at a herbarium. Within a couple of years de Candolle had established a new genus, and he went on to document hundreds of plant families and create a new natural plant classification system. Although de Candolle's main focus was botany, he also contributed to related fields such as phytogeography, agronomy, paleontology, medical botany, and economic botany. De Candolle originated the idea of \"Nature's war\", which influenced Charles Darwin and the principle of natural selection. De Candolle recognized that multiple species may develop similar characteristics that did not appear in a common evolutionary ancestor; a phenomenon now known as convergent evolution."}}, {"canonical_name": "Biot", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "biot", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Biot", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Biot"], "contexts": ["scholar who fixed magnetic equator position"]}, {"entity_id": "biot", "book_id": "kosmos_humboldt_1845", "name": "Biot", "category": "PERSON", "subcategory": "SCHOLAR", "count": 13, "variants": ["Biot"], "contexts": ["investigated twilight phenomenon", "author of 'Trait\u00e9 d'Astronomie Physique'"]}, {"entity_id": "biot", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Biot", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Biot"], "contexts": ["discovered circular polarization", "discovered properties in liquids"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Biot", "target_book": "kosmos_humboldt_1845", "target_name": "Biot", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Biot", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Biot", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Biot", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Biot", "similarity": 1.0}], "id": 1031, "stable_key": "clu_faf7e98415c2d8ff", "ground_truth": {"modern_name": "Jean-Baptiste Biot", "confidence": "high", "type": "person", "birth_year": 1774, "death_year": 1862, "description": "French physicist, astronomer, and mathematician. Investigated polarization and magnetic equator.", "wikidata_id": "Q58328", "wikidata_description": "French scientist (1774-1862)", "wikipedia_url": "https://en.wikipedia.org/wiki/Jean-Baptiste%20Biot", "wikipedia_extract": "Jean-Baptiste Biot (; French: [\u0292\u0251\u0303 batist bjo]; 21 April 1774 \u2013 3 February 1862) was a French physicist, astronomer, and mathematician who co-discovered the Biot\u2013Savart law of magnetostatics with F\u00e9lix Savart, established the reality of meteorites, made an early balloon flight, and studied the polarization of light. The biot (a CGS unit of electrical current), the mineral biotite, and Cape Biot in eastern Greenland were named in his honour. Jean-Baptiste Biot was born in Paris on 21 April 1774 the son of Joseph Biot, a treasury official. He was educated at Lyceum Louis-le-Grand and \u00c9cole Polytechnique in 1794. Biot served in the artillery before he was appointed professor of mathematics at Beauvais in 1797. He later went on to become a professor of physics at the Coll\u00e8ge de France around 1800, and three years later was elected as a member of the French Academy of Sciences."}}, {"canonical_name": "gases", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "gases", "book_id": "kosmos_humboldt_1845", "name": "gases", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["gases"], "contexts": ["substances in gaseous state", "state of matter"]}, {"entity_id": "gases", "book_id": "connexion_physical_sciences_somerville_1858", "name": "gases", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 12, "variants": ["gases", "Gases"], "contexts": ["state of matter", "fluids that expand to fill container"]}, {"entity_id": "gases", "book_id": "first_principles_spencer_1862", "name": "gases", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["gases"], "contexts": ["combine in sunshine", "state of matter with dispersed particles"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "gases", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gases", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "gases", "target_book": "first_principles_spencer_1862", "target_name": "gases", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "gases", "target_book": "first_principles_spencer_1862", "target_name": "gases", "similarity": 1.0}], "id": 1032, "stable_key": "clu_dfa95065c8a3a1ab", "ground_truth": {"modern_name": "Gases", "confidence": "high", "type": "chemical"}}, {"canonical_name": "chemical affinity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "chemical_affinity", "book_id": "kosmos_humboldt_1845", "name": "chemical affinity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["chemical affinity"], "contexts": ["force acting on molecules", "force driving chemical reactions"]}, {"entity_id": "chemical_affinity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "chemical affinity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["chemical affinity", "Chemical Affinity"], "contexts": ["tendency of atoms to combine", "force of attraction between particles"]}, {"entity_id": "chemical_affinities", "book_id": "connexion_physical_sciences_somerville_1858", "name": "chemical affinities", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["chemical affinities"], "contexts": ["forces attracting chemical elements", "series of chemical affinities"]}, {"entity_id": "chemical_affinity", "book_id": "first_principles_spencer_1862", "name": "chemical affinity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["chemical affinity"], "contexts": ["force causing chemical combination", "general power studied by science"]}, {"entity_id": "chemical_affinities", "book_id": "first_principles_spencer_1862", "name": "chemical affinities", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["chemical affinities"], "contexts": ["attraction between different chemical units"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "chemical affinity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chemical affinity", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "chemical affinity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chemical affinities", "similarity": 0.977}, {"source_book": "kosmos_humboldt_1845", "source_name": "chemical affinity", "target_book": "first_principles_spencer_1862", "target_name": "chemical affinity", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "chemical affinity", "target_book": "first_principles_spencer_1862", "target_name": "chemical affinities", "similarity": 0.977}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "chemical affinity", "target_book": "first_principles_spencer_1862", "target_name": "chemical affinity", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "chemical affinity", "target_book": "first_principles_spencer_1862", "target_name": "chemical affinities", "similarity": 0.977}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "chemical affinities", "target_book": "first_principles_spencer_1862", "target_name": "chemical affinity", "similarity": 0.977}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "chemical affinities", "target_book": "first_principles_spencer_1862", "target_name": "chemical affinities", "similarity": 1.0}], "id": 1033, "stable_key": "clu_19774b1a781ab273", "ground_truth": {"modern_name": "Chemical affinity", "confidence": "high", "type": "concept", "wikidata_id": "Q382783", "wikidata_description": "used to describe or characterise elements' or compounds' readiness to form bonds", "wikipedia_url": "https://en.wikipedia.org/wiki/Chemical%20affinity", "wikipedia_extract": "In chemical physics and physical chemistry, chemical affinity is the electronic property by which dissimilar chemical species are capable of forming chemical compounds. Chemical affinity can also refer to the tendency of an atom or compound to combine by chemical reaction with atoms or compounds of unlike composition. The idea of affinity is extremely old. Many attempts have been made at identifying its origins. The majority of such attempts, however, except in a general manner, end in futility since \"affinities\" lie at the basis of all magic, thereby pre-dating science. Physical chemistry, however, was one of the first branches of science to study and formulate a \"theory of affinity\"."}}, {"canonical_name": "chemical action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "chemical_actions", "book_id": "kosmos_humboldt_1845", "name": "chemical actions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["chemical actions"], "contexts": ["actions related to light waves"]}, {"entity_id": "chemical_action", "book_id": "connexion_physical_sciences_somerville_1858", "name": "chemical action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["chemical action", "Chemical action"], "contexts": ["process of chemical change", "reactions between substances"]}, {"entity_id": "chemical_action", "book_id": "first_principles_spencer_1862", "name": "Chemical Action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["Chemical Action", "chemical action"], "contexts": ["occurs on daguerreotype plate", "genesis of other modes of force"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "chemical actions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chemical action", "similarity": 0.97}, {"source_book": "kosmos_humboldt_1845", "source_name": "chemical actions", "target_book": "first_principles_spencer_1862", "target_name": "Chemical Action", "similarity": 0.956}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "chemical action", "target_book": "first_principles_spencer_1862", "target_name": "Chemical Action", "similarity": 0.967}], "id": 1034, "stable_key": "clu_c3028f2e5096914d", "ground_truth": {"modern_name": "Chemical reactions", "confidence": "high", "type": "concept", "wikidata_id": "Q36534", "wikidata_description": "process that results in the interconversion of chemical species", "wikipedia_url": "https://en.wikipedia.org/wiki/Chemical%20reaction", "wikipedia_extract": "A chemical reaction is a process that leads to the chemical transformation of one set of chemical substances to another. When chemical reactions occur, the atoms are rearranged and the reaction is accompanied by an energy change as new products are generated. Classically, chemical reactions encompass changes that only involve the positions of electrons in the forming and breaking of chemical bonds between atoms, with no change to the nuclei (no change to the elements present), and can often be described by a chemical equation. Nuclear chemistry is a sub-discipline of chemistry that involves the chemical reactions of unstable and radioactive elements where both electronic and nuclear changes can occur. The substance (or substances) initially involved in a chemical reaction are called reactants or reagents. Chemical reactions are usually characterized by a chemical change, and they yield one or more products, which usually have properties different from the reactants."}}, {"canonical_name": "Jacintos", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "jacinto", "book_id": "historia_medicinal_monardes_1574", "name": "jacinto", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["jacinto"], "contexts": ["precious stone, especially against poison"]}, {"entity_id": "jacintos", "book_id": "coloquios_da_orta_1563", "name": "Jacintos", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 10, "variants": ["Jacintos", "JACINTO", "jacimko", "jacinthos", "jacinto", "jacintos"], "contexts": ["type of gemstone", "precious stones, possibly types of amethysts"]}, {"entity_id": "jacintos", "book_id": "polyanthea_medicinal", "name": "Jacintos", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 9, "variants": ["Jacintos", "Jacinto", "hyacintos", "jacintos"], "contexts": ["gemstone used in preparations", "ingredient in a medicine"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "jacinto", "target_book": "coloquios_da_orta_1563", "target_name": "Jacintos", "similarity": 0.948}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "jacinto", "target_book": "polyanthea_medicinal", "target_name": "Jacintos", "similarity": 0.948}, {"source_book": "coloquios_da_orta_1563", "source_name": "Jacintos", "target_book": "polyanthea_medicinal", "target_name": "Jacintos", "similarity": 1.0}], "id": 1035, "stable_key": "clu_f017aa33a6992651", "ground_truth": {"modern_name": "Hyacinth", "confidence": "high", "type": "mineral", "note": "Early modern texts often referred to gemstones by their common names, and 'jacinto' in Portuguese and Spanish commonly referred to the hyacinth gemstone, valued for its properties."}}, {"canonical_name": "costo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "costo", "book_id": "coloquios_da_orta_1563", "name": "costo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 18, "variants": ["costo", "Cost", "Costo", "Costus", "cost", "costi", "costus"], "contexts": ["plant mentioned in relation to theofrasto", "plant compared to cacoll\u00e1"]}, {"entity_id": "costo", "book_id": "ricettario_fiorentino_1597", "name": "COSTO", "category": "PLANT", "subcategory": "ROOT", "count": 1, "variants": ["COSTO"], "contexts": ["a white, very light root"]}, {"entity_id": "costo", "book_id": "polyanthea_medicinal", "name": "costo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["costo"], "contexts": ["spice used in a syrup"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "costo", "target_book": "ricettario_fiorentino_1597", "target_name": "COSTO", "similarity": 0.683}, {"source_book": "coloquios_da_orta_1563", "source_name": "costo", "target_book": "polyanthea_medicinal", "target_name": "costo", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "COSTO", "target_book": "polyanthea_medicinal", "target_name": "costo", "similarity": 0.683}], "id": 1036, "stable_key": "clu_b06349b300f365f6", "ground_truth": {"modern_name": "Costmary", "confidence": "medium", "type": "plant", "linnaean": "Tanacetum balsamita", "family": "Asteraceae", "description": "Aromatic herb, sometimes used medicinally.", "note": "The term 'costo' in early modern texts often referred to Costmary (Tanacetum balsamita), also known as 'alecost'.", "wikipedia_extract": "Tanacetum balsamita is a perennial temperate herb known as costmary, alecost, balsam herb, bible leaf, or mint geranium. A fragrant plant native to southern Europe and western Asia, it has been used over centuries for culinary, aromatic, and traditional medicine purposes. Costmary is a perennial with oval serrated leaves and can grow up to 2 m (6.6 ft) high. During summer, it shows small, yellow, button-shaped blossoms which appear in clusters. The English name 'costmary' stems from 'costus of Saint Mary'. Also, in other languages, it is associated with the Virgin Mary, most probably because it was thought to be a treatment for women's diseases in folk medicine."}}, {"canonical_name": "vie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 19, "members": [{"entity_id": "vie", "book_id": "medecine_experimentale_bernard_1865", "name": "vie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 17, "variants": ["vie"], "contexts": ["the state of being alive", "life"]}, {"entity_id": "vie", "book_id": "epoques_nature_buffon_1778", "name": "vie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vie"], "contexts": ["state maintained by solar heat"]}, {"entity_id": "vie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "vie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vie"], "contexts": ["fundamental state"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "vie", "target_book": "epoques_nature_buffon_1778", "target_name": "vie", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "vie", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "vie", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "vie", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "vie", "similarity": 1.0}], "id": 1037, "stable_key": "clu_5e677de0d96c3c81", "ground_truth": {"modern_name": "life", "confidence": "high", "type": "concept", "wikidata_id": "Q37221362", "wikidata_description": "family name"}}, {"canonical_name": "Vein", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 19, "members": [{"entity_id": "veins", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Veins", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 6, "variants": ["Veins", "veins"], "contexts": ["body parts leeches fasten upon", "convey spirits into brain"]}, {"entity_id": "vein", "book_id": "english_physician_1652", "name": "Vein", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 11, "variants": ["Vein", "Veins"], "contexts": ["blood vessel where bleeding is stopped", "blood vessel"]}, {"entity_id": "vein", "book_id": "polyanthea_medicinal", "name": "vein", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["vein", "veins"], "contexts": ["part of circulatory system", "blood vessels"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Veins", "target_book": "english_physician_1652", "target_name": "Vein", "similarity": 0.977}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Veins", "target_book": "polyanthea_medicinal", "target_name": "vein", "similarity": 0.971}, {"source_book": "english_physician_1652", "source_name": "Vein", "target_book": "polyanthea_medicinal", "target_name": "vein", "similarity": 0.993}], "id": 1038, "stable_key": "clu_75be46d3cedebe5c-2", "ground_truth": {"modern_name": "Veins", "confidence": "high", "type": "anatomy", "description": "Blood vessels that carry blood towards the heart.", "wikipedia_extract": "A vein () is a blood vessel in the circulatory system of humans and most other animals that carries blood towards the heart. Most veins carry deoxygenated blood from the tissues back to the heart; exceptions are those of the pulmonary and fetal circulations which carry oxygenated blood to the heart. In the systemic circulation, arteries carry oxygenated blood away from the heart, and veins return deoxygenated blood to the heart, in the deep veins. There are three sizes of veins: large, medium, and small. Smaller veins are called venules, and the smallest the post-capillary venules are microscopic that make up the veins of the microcirculation. Veins are often closer to the skin than arteries."}}, {"canonical_name": "indigo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 19, "members": [{"entity_id": "indico", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Indico", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Indico"], "contexts": ["used for painting porcelain"]}, {"entity_id": "indigo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "indigo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 12, "variants": ["indigo", "Indigo", "indigos"], "contexts": ["precious production from Caracas", "cultivated plant for export"]}, {"entity_id": "indigo", "book_id": "connexion_physical_sciences_somerville_1858", "name": "indigo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["indigo"], "contexts": ["colour in the spectrum", "color of the spectrum"]}, {"entity_id": "indigo_blue", "book_id": "connexion_physical_sciences_somerville_1858", "name": "indigo blue", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["indigo blue"], "contexts": ["color of light"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Indico", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "indigo", "similarity": 0.884}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Indico", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "indigo", "similarity": 0.884}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "indigo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "indigo", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "indigo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "indigo blue", "similarity": 0.902}], "id": 1039, "stable_key": "clu_0a24c0abe22fe447", "ground_truth": {"modern_name": "Indigo", "confidence": "high", "type": "chemical", "wikidata_id": "Q422662", "wikidata_description": "chemical compound; food additive and dye", "wikipedia_url": "https://en.wikipedia.org/wiki/Indigo%20dye", "wikipedia_extract": "Indigo dye is an organic compound with a distinctive blue color. Indigo is a natural dye obtained from the leaves of some plants of the Indigofera genus, in particular Indigofera tinctoria. Dye-bearing Indigofera plants were once common throughout the world. Blue colorants are relatively rare. Since indigo is insoluble, it is also referred to as a pigment (C.I. Pigment Blue 66, C.I.)."}}, {"canonical_name": "mace", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 19, "members": [{"entity_id": "mace", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mace", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Mace"], "contexts": ["flosculous coat of nutmeg fruit"]}, {"entity_id": "mace", "book_id": "english_physician_1652", "name": "Mace", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Mace"], "contexts": ["spice from nutmeg", "spice added to decoctions"]}, {"entity_id": "mace", "book_id": "ricettario_fiorentino_1597", "name": "mace", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 16, "variants": ["mace", "Macc", "Mace"], "contexts": ["fragrant spice for pounding", "aril of nutmeg, a spice"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mace", "target_book": "english_physician_1652", "target_name": "Mace", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mace", "target_book": "ricettario_fiorentino_1597", "target_name": "mace", "similarity": 0.856}, {"source_book": "english_physician_1652", "source_name": "Mace", "target_book": "ricettario_fiorentino_1597", "target_name": "mace", "similarity": 0.856}], "id": 1040, "stable_key": "clu_78156d0e02235fb1", "ground_truth": {"modern_name": "mace", "confidence": "high", "type": "plant", "linnaean": "Myristica fragrans", "family": "Myristicaceae", "description": "Spice from the aril of the nutmeg fruit.", "note": "Contexts for 'Ma' and 'Mayz' suggest possible confusion with maize (corn).", "wikipedia_extract": "Myristica fragrans, commonly known as the nutmeg tree, is an evergreen species indigenous to the Maluku Islands of Indonesia. This aromatic tree is economically significant as the primary source of two distinct spices: nutmeg, derived from its seed, and mace, obtained from the seed's aril. Valued for centuries in global spice trade, M. fragrans is now widely cultivated throughout tropical regions, including parts of Southeast Asia (Indonesia, Malaysia), South Asia (Kerala in India, Sri Lanka), East Asia (Guangdong and Yunnan in China, Taiwan), the Caribbean (notably Grenada), and South America. Myristica fragrans is an evergreen tree, usually 5\u201315 m (16\u201349 ft) tall, but occasionally reaching 20 m (66 ft) or even 30 m (98 ft) on Tidore. The alternately arranged leaves are dark green, 5\u201315 cm (2.0\u20135.9 in) long by 2\u20137 cm (0.8\u20132.8 in) wide with petioles about 1 cm (0.4 in) long. The species is dioecious, i.e. \"male\" or staminate flowers and \"female\" or carpellate flowers are borne on different plants, although occasional individuals produce both kinds of flower."}}, {"canonical_name": "Thibet", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 19, "members": [{"entity_id": "thibet", "book_id": "epoques_nature_buffon_1778", "name": "Thibet", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Thibet"], "contexts": ["region extending into Tartary"]}, {"entity_id": "thibet", "book_id": "kosmos_humboldt_1845", "name": "Thibet", "category": "PLACE", "subcategory": "COUNTRY", "count": 7, "variants": ["Thibet"], "contexts": ["influence of elevated plateau", "elevated plateaux"]}, {"entity_id": "thibet", "book_id": "coloquios_da_orta_1563", "name": "Thibet", "category": "PLACE", "subcategory": "REGION", "count": 11, "variants": ["Thibet"], "contexts": ["region musk arrived through", "region in Asia"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Thibet", "target_book": "kosmos_humboldt_1845", "target_name": "Thibet", "similarity": 0.91}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Thibet", "target_book": "coloquios_da_orta_1563", "target_name": "Thibet", "similarity": 0.88}, {"source_book": "kosmos_humboldt_1845", "source_name": "Thibet", "target_book": "coloquios_da_orta_1563", "target_name": "Thibet", "similarity": 0.934}], "id": 1041, "stable_key": "clu_034fb352c1237314", "ground_truth": {"modern_name": "Tibet", "confidence": "high", "type": "place", "description": "A region in Asia, also including an island.", "note": "Includes references to Tibet and Tahiti.", "wikipedia_extract": "Tibet ( ) is a region in the western part of East Asia, covering much of the Tibetan Plateau. It is the homeland of the Tibetans. Other ethnic groups also reside on the plateau, including Mongols, the Lhoba, Monpa, Qiang, Sherpa, and since the 20th century, Han and Hui peoples. Tibet is the highest region on Earth, with an average elevation of 4,380 m (14,000 ft). Lying within the Himalayas, the highest point in Tibet is Mount Everest \u2013 the highest peak on Earth, standing 8,848 m (29,000 ft) above sea level. In the 7th century, the Yarlung dynasty expanded into surrounding areas such as Amdo."}}, {"canonical_name": "Atlantic Ocean", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 19, "members": [{"entity_id": "atlantic_ocean", "book_id": "origin_of_species_darwin_1859", "name": "Atlantic Ocean", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Atlantic Ocean"], "contexts": ["ocean crossed by land-birds", "ocean between Europe and North America"]}, {"entity_id": "atlantic_ocean", "book_id": "kosmos_humboldt_1845", "name": "Atlantic Ocean", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["Atlantic Ocean"], "contexts": ["major ocean body", "location of magnetic observations"]}, {"entity_id": "atlantic_ocean", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Atlantic Ocean", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Atlantic Ocean"], "contexts": ["ocean receiving tidal waves", "ocean influencing European temperature"]}, {"entity_id": "atlantic_oceans", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Atlantic Oceans", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Atlantic Oceans"], "contexts": ["ocean"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Atlantic Ocean", "target_book": "kosmos_humboldt_1845", "target_name": "Atlantic Ocean", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Atlantic Ocean", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Atlantic Ocean", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Atlantic Ocean", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Atlantic Oceans", "similarity": 0.989}, {"source_book": "kosmos_humboldt_1845", "source_name": "Atlantic Ocean", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Atlantic Ocean", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Atlantic Ocean", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Atlantic Oceans", "similarity": 0.989}], "id": 1042, "stable_key": "clu_aee9c0b900591188-2", "ground_truth": {"modern_name": "Atlantic Ocean", "confidence": "high", "type": "place", "country": "Multiple", "wikidata_id": "Q97", "wikidata_description": "ocean between Europe, Africa and the Americas", "wikipedia_url": "https://en.wikipedia.org/wiki/Atlantic%20Ocean", "wikipedia_extract": "The Atlantic Ocean is the second largest of the world's five oceanic divisions, with an area of about 85,133,000 km2 (32,870,000 sq mi). It covers approximately 17% of Earth's surface and about 24% of its water surface area. During the Age of Discovery, it was known for separating the New World of the Americas (North America and South America) from the Old World of Afro-Eurasia (Africa, Asia, and Europe). Through its separation of Afro-Eurasia from the Americas, the Atlantic Ocean has played a central role in the development of human society, globalization, and the histories of many nations. While the Norse were the first known humans to cross the Atlantic, it was the expedition of Christopher Columbus in 1492 that proved to be the most consequential. Columbus's expedition ushered in an age of exploration and colonization of the Americas by European powers, most notably Portugal, Spain, France, and the United Kingdom."}}, {"canonical_name": "Siberia", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 19, "members": [{"entity_id": "siberia", "book_id": "origin_of_species_darwin_1859", "name": "Siberia", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Siberia"], "contexts": ["region with arctic plants", "vast geographical region of Russia"]}, {"entity_id": "siberia", "book_id": "kosmos_humboldt_1845", "name": "Siberia", "category": "PLACE", "subcategory": "COUNTRY", "count": 13, "variants": ["Siberia"], "contexts": ["destination of scientific journey", "region of barren steppes"]}, {"entity_id": "siberia", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Siberia", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Siberia"], "contexts": ["adjacent continent to Ochotzk Sea", "region with chilly winds affecting Asia and America"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Siberia", "target_book": "kosmos_humboldt_1845", "target_name": "Siberia", "similarity": 0.93}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Siberia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Siberia", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Siberia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Siberia", "similarity": 0.93}], "id": 1043, "stable_key": "clu_57aa3f97920c516c", "ground_truth": {"modern_name": "Siberia", "confidence": "high", "type": "place", "description": "A vast geographical region within the Russian Empire.", "wikipedia_extract": "Siberia ( sy-BEER-ee-\u0259; Russian: \u0421\u0438\u0431\u0438\u0440\u044c, romanized: Sibir', IPA: [s\u02b2\u026a\u02c8b\u02b2ir\u02b2] ), also known as Asian Russia, is an extensive geographical region comprising all of North Asia, from the Ural Mountains in the west (with the Ural River usually forming the southernmost portion of its western boundary) to the Pacific Ocean in the east. It has formed a part of the sovereign territory of Russia and its predecessor states since the lengthy conquest of Siberia, which began with the fall of the Khanate of Sibir in 1582 and concluded with the annexation of Chukotka in 1778. Siberia is vast and sparsely populated, covering an area of over 13.1 million square kilometres (5,100,000 mi2) \u2013 about three-quarters of Russia's total area, but home to roughly a quarter of Russia's population. Novosibirsk, Krasnoyarsk, and Omsk are the largest cities in the area. Because Siberia is a geographic and historic concept and not a political entity, there is no single precise definition of its territorial borders. It is further defined as stretching from the territories within the Arctic Circle in the north to the northern borders of Kazakhstan, Mongolia, and China in the south, although the hills of north-central Kazakhstan are also commonly included."}}, {"canonical_name": "corteza", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 19, "members": [{"entity_id": "corteza", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "corteza", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["corteza"], "contexts": ["bark of a tree", "thin and tender bark of trees"]}, {"entity_id": "corteza", "book_id": "historia_medicinal_monardes_1574", "name": "corteza", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["corteza", "Corteza de vir arbol", "cor- teza", "correza"], "contexts": ["bark used for medicine", "bark of the tree, aromatic and with good effect"]}, {"entity_id": "corteza", "book_id": "coloquios_da_orta_1563", "name": "corteza", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["corteza", "cortex"], "contexts": ["bark, specifically cinnamon bark", "Latin for bark"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "corteza", "target_book": "historia_medicinal_monardes_1574", "target_name": "corteza", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "corteza", "target_book": "coloquios_da_orta_1563", "target_name": "corteza", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "corteza", "target_book": "coloquios_da_orta_1563", "target_name": "corteza", "similarity": 1.0}], "id": 1044, "stable_key": "clu_cffa419f7f6c2b6e", "ground_truth": {"modern_name": "Cinnamon bark", "confidence": "high", "type": "plant", "linnaean": "Cinnamomum verum", "family": "Lauraceae", "note": "The term 'corteza' in the context of Monardes and Orta, known for their work on New World and Eastern medicinal plants, strongly suggests cinnamon bark, especially given its frequent medicinal use and prominence in early modern pharmacopoeias. 'Cinnamomum verum' is the most commonly recognized species."}}, {"canonical_name": "C\u00e1ssia lignea", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 19, "members": [{"entity_id": "cassia_lignea", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "cassia lignea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["CASSIA LIGNEA", "cassia lignea"], "contexts": ["a plant, also called cinnamon", "plant, same origin as cinnamon"]}, {"entity_id": "ca\u017fsia_ligna", "book_id": "historia_medicinal_monardes_1574", "name": "Ca\u017fsia ligna", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Ca\u017fsia ligna"], "contexts": ["type of cinnamon"]}, {"entity_id": "c\u00e1ssia_lignea", "book_id": "coloquios_da_orta_1563", "name": "C\u00e1ssia lignea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["c\u00e1ssia lignea", "C\u00c1SSIA LIGNEA", "C\u00e1ssia lignea"], "contexts": ["type of cassia", "spice discussed in colloquy"]}, {"entity_id": "cassialignea", "book_id": "coloquios_da_orta_1563", "name": "cassialignea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["cassialignea", "cassiaunba"], "contexts": ["spice, likely cassia", "planta com nomes em diversas linguoas"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cassia lignea", "target_book": "coloquios_da_orta_1563", "target_name": "C\u00e1ssia lignea", "similarity": 0.95}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cassia lignea", "target_book": "coloquios_da_orta_1563", "target_name": "cassialignea", "similarity": 0.807}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Ca\u017fsia ligna", "target_book": "coloquios_da_orta_1563", "target_name": "C\u00e1ssia lignea", "similarity": 0.882}], "id": 1045, "stable_key": "clu_f3e6baaf0c14937a-3", "ground_truth": {"modern_name": "Cinnamon", "confidence": "high", "type": "plant", "linnaean": "Cinnamomum verum J.Presl", "family": "Lauraceae", "note": "While 'canela' can refer to both cinnamon and cassia, the context of Moluccas Islands strongly suggests cinnamon.", "wikidata_id": "Q28165", "wikidata_description": "spice obtained from the inner bark of several tree species from the genus Cinnamomum", "wikipedia_url": "https://en.wikipedia.org/wiki/Cinnamon", "wikipedia_extract": "Cinnamon is a spice obtained from the inner bark of several tree species from the genus Cinnamomum. Cinnamon is used mainly as an aromatic condiment and flavouring additive in a wide variety of cuisines, in particular sweet and savoury dishes such as biscuits, breakfast cereals, snack foods, bagels, teas, hot chocolate, and traditional foods. The aroma and flavour of cinnamon derive from its essential oil and principal component, cinnamaldehyde, as well as numerous other constituents, including eugenol. Cinnamon is the name for several species of trees and the commercial spice products that some of them produce. All are members of the genus Cinnamomum in the family Lauraceae. Only a few Cinnamomum species are grown commercially for spice."}}, {"canonical_name": "retina", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 19, "members": [{"entity_id": "retina", "book_id": "principles_of_psychology_james_1890", "name": "retina", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 11, "variants": ["retina"], "contexts": ["light-sensitive tissue in the eye", "light-sensitive tissue at the back of the eye"]}, {"entity_id": "retin\u00e6", "book_id": "principles_of_psychology_james_1890", "name": "retin\u00e6", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["retin\u00e6"], "contexts": ["light-sensitive tissue in the eye"]}, {"entity_id": "retina", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Retina", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["retina", "Retina"], "contexts": ["light-sensitive tissue in the eye", "receives light impressions"]}, {"entity_id": "retina", "book_id": "first_principles_spencer_1862", "name": "retina", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["retina"], "contexts": ["light-sensitive tissue at the back of the eye"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "retina", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Retina", "similarity": 0.91}, {"source_book": "principles_of_psychology_james_1890", "source_name": "retina", "target_book": "first_principles_spencer_1862", "target_name": "retina", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "retin\u00e6", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Retina", "similarity": 0.882}, {"source_book": "principles_of_psychology_james_1890", "source_name": "retin\u00e6", "target_book": "first_principles_spencer_1862", "target_name": "retina", "similarity": 0.98}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Retina", "target_book": "first_principles_spencer_1862", "target_name": "retina", "similarity": 0.91}], "id": 1046, "stable_key": "clu_e4830910da92f2c3", "ground_truth": {"modern_name": "Retina", "confidence": "high", "type": "concept", "note": "While it is an anatomical structure, the texts refer to it conceptually as a light-sensitive tissue.", "wikidata_id": "Q14847777", "wikidata_description": "genus of insects"}}, {"canonical_name": "magnetic needle", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 19, "members": [{"entity_id": "magnetic_needle", "book_id": "kosmos_humboldt_1845", "name": "magnetic needle", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 12, "variants": ["magnetic needle"], "contexts": ["declination at any point on Earth", "device for indicating magnetic north"]}, {"entity_id": "vertical_needle", "book_id": "kosmos_humboldt_1845", "name": "vertical needle", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["vertical needle"], "contexts": ["instrument for magnetic measurements"]}, {"entity_id": "magnetic_needle", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic needle", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["magnetic needle"], "contexts": ["device indicating magnetic north", "instrument deflected by magnetic force"]}, {"entity_id": "magnetized_needle", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetized needle", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["magnetized needle"], "contexts": ["device used to detect magnetic fields", "influenced by voltaic science"]}, {"entity_id": "magnetic_needle", "book_id": "first_principles_spencer_1862", "name": "magnetic needle", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["magnetic needle"], "contexts": ["component of a compass"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "magnetic needle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic needle", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic needle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetized needle", "similarity": 0.964}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic needle", "target_book": "first_principles_spencer_1862", "target_name": "magnetic needle", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "vertical needle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic needle", "similarity": 0.886}, {"source_book": "kosmos_humboldt_1845", "source_name": "vertical needle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetized needle", "similarity": 0.882}, {"source_book": "kosmos_humboldt_1845", "source_name": "vertical needle", "target_book": "first_principles_spencer_1862", "target_name": "magnetic needle", "similarity": 0.886}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "magnetic needle", "target_book": "first_principles_spencer_1862", "target_name": "magnetic needle", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "magnetized needle", "target_book": "first_principles_spencer_1862", "target_name": "magnetic needle", "similarity": 0.964}], "id": 1047, "stable_key": "clu_ca0f6a9b5485d2fa", "ground_truth": {"modern_name": "magnetic needle", "confidence": "high", "type": "object", "wikidata_id": "Q129950755", "wikidata_description": "scholarly article published in April 2024", "wikipedia_extract": "Magnetic declination (also called magnetic variation) is the angle between magnetic north and true north at a particular location on the Earth's surface. The angle can change over time due to polar wandering. Magnetic north is the direction that the north end of a magnetized compass needle points, which corresponds to the direction of the Earth's magnetic field lines. True north is the direction along a meridian towards the geographic North Pole. Somewhat more formally, Bowditch defines variation as \"the angle between the magnetic and geographic meridians at any place, expressed in degrees and minutes east or west to indicate the direction of magnetic north from true north. The angle between magnetic and grid meridians is called grid magnetic angle, grid variation, or grivation.\" By convention, declination is positive when magnetic north is east of true north, and negative when it is to the west.", "wikipedia_url": "https://en.wikipedia.org/wiki/Magnetic_declination"}}, {"canonical_name": "steam", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 19, "members": [{"entity_id": "steam", "book_id": "kosmos_humboldt_1845", "name": "steam", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["steam"], "contexts": ["ejected from subterranean forces", "water vapor from volcanic activity"]}, {"entity_id": "steam", "book_id": "connexion_physical_sciences_somerville_1858", "name": "steam", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 11, "variants": ["steam", "Steam"], "contexts": ["gaseous state of water", "prevented from expanding by pressure"]}, {"entity_id": "steam", "book_id": "first_principles_spencer_1862", "name": "steam", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["steam"], "contexts": ["gaseous state of water", "gaseous water"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "steam", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "steam", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "steam", "target_book": "first_principles_spencer_1862", "target_name": "steam", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "steam", "target_book": "first_principles_spencer_1862", "target_name": "steam", "similarity": 1.0}], "id": 1048, "stable_key": "clu_e770353762c0d79a-2", "ground_truth": {"modern_name": "Steam", "confidence": "high", "type": "chemical", "wikidata_id": "Q190120", "wikidata_description": "gaseous phase of water; unlike other forms of water, water vapor is invisible", "wikipedia_url": "https://en.wikipedia.org/wiki/Water%20vapor", "wikipedia_extract": "Water vapor, water vapour, or aqueous vapor is the gaseous phase of water. It is one state of water within the hydrosphere. Water vapor can be produced from the evaporation or boiling of liquid water or from the sublimation of ice. Water vapor is transparent, like most constituents of the atmosphere. Under typical atmospheric conditions, water vapor is continuously generated by evaporation and removed by condensation. It is less dense than most of the other constituents of air and triggers convection currents that can lead to clouds and fog."}}, {"canonical_name": "ph\u00e9nom\u00e8nes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "ph\u00e9nom\u00e8nes", "book_id": "medecine_experimentale_bernard_1865", "name": "ph\u00e9nom\u00e8nes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["ph\u00e9nom\u00e8nes"], "contexts": ["phenomena", "observed phenomena"]}, {"entity_id": "phenomena", "book_id": "medecine_experimentale_bernard_1865", "name": "phenomena", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["phenomena"], "contexts": ["forms vary infinitely, transformations of forces"]}, {"entity_id": "phenomena", "book_id": "principles_of_psychology_james_1890", "name": "phenomena", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["phenomena"], "contexts": ["observable occurrences", "observable mental experiences"]}, {"entity_id": "phenomena", "book_id": "first_principles_spencer_1862", "name": "phenomena", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["phenomena"], "contexts": ["observable events or facts", "observable events"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "ph\u00e9nom\u00e8nes", "target_book": "principles_of_psychology_james_1890", "target_name": "phenomena", "similarity": 0.957}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "ph\u00e9nom\u00e8nes", "target_book": "first_principles_spencer_1862", "target_name": "phenomena", "similarity": 0.957}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "phenomena", "target_book": "principles_of_psychology_james_1890", "target_name": "phenomena", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "phenomena", "target_book": "first_principles_spencer_1862", "target_name": "phenomena", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "phenomena", "target_book": "first_principles_spencer_1862", "target_name": "phenomena", "similarity": 1.0}], "id": 1049, "stable_key": "clu_cb9e971a15875687", "ground_truth": {"modern_name": "phenomena", "confidence": "high", "type": "concept", "wikidata_id": "Q16722960", "wikidata_description": "philosophical concept"}}, {"canonical_name": "Lange", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "longet", "book_id": "medecine_experimentale_bernard_1865", "name": "Longet", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Longet"], "contexts": ["critic of Magendie's experiments", "scholar discussing scientific critique"]}, {"entity_id": "long", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Long", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Long", "Longassigne"], "contexts": ["major who explored Rocky Mountains", "leader of an expedition"]}, {"entity_id": "lange", "book_id": "principles_of_psychology_james_1890", "name": "Lange", "category": "PERSON", "subcategory": "SCHOLAR", "count": 8, "variants": ["Lange"], "contexts": ["quoted scholar on phrenology", "distinguished two types of reaction"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Longet", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Long", "similarity": 0.94}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Longet", "target_book": "principles_of_psychology_james_1890", "target_name": "Lange", "similarity": 0.878}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Long", "target_book": "principles_of_psychology_james_1890", "target_name": "Lange", "similarity": 0.915}], "id": 1050, "stable_key": "clu_baf9b5edab0f7714-2", "ground_truth": {"modern_name": "Alexander von Humboldt", "confidence": "high", "type": "person", "birth_year": 1769, "death_year": 1859, "description": "Prussian explorer and naturalist, key figure in biogeography", "wikidata_id": "Q6694", "wikidata_description": "Prussian geographer, naturalist and explorer (1769\u20131859)", "wikipedia_url": "https://en.wikipedia.org/wiki/Alexander%20von%20Humboldt", "wikipedia_extract": "Friedrich Wilhelm Heinrich Alexander von Humboldt (14 September 1769 \u2013 6 May 1859) was a German polymath, geographer, naturalist, explorer, and proponent of Romantic philosophy and science. He was the younger brother of the Prussian minister, philosopher, and linguist Wilhelm von Humboldt (1767\u20131835). Humboldt's quantitative work on botanical geography laid the foundation for the field of biogeography, while his advocacy of long-term systematic geophysical measurement pioneered modern geomagnetic and meteorological monitoring. Humboldt and Carl Ritter are both regarded as the founders of modern geography as they established it as an independent scientific discipline. Between 1799 and 1804, Humboldt travelled extensively in the Americas, exploring and describing them for the first time from a non-Spanish European scientific point of view. On these travels, along with French explorer Aim\u00e9 Bonpland, he traversed thousands of miles through some of the most difficult and little-known places on Earth, to include identifying the source of the Orinoco River and in 1802 climbing the highest mountain in Ecuador to a height of 19,286 feet, at the time a world record altitude for a Westerner.", "note": "While 'Long' and 'Lange' are the exact OCR, context strongly suggests Humboldt's exploration of the Rocky Mountains and his scientific writings."}}, {"canonical_name": "glandulas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "organes_glandulaires", "book_id": "medecine_experimentale_bernard_1865", "name": "organes glandulaires", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["organes glandulaires"], "contexts": ["glandular organs"]}, {"entity_id": "glandulas", "book_id": "polyanthea_medicinal", "name": "glandulas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 16, "variants": ["glandulas"], "contexts": ["glands in the intestines", "glands"]}, {"entity_id": "glandular_organs", "book_id": "first_principles_spencer_1862", "name": "glandular organs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["glandular organs"], "contexts": ["organs producing secretions"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "organes glandulaires", "target_book": "polyanthea_medicinal", "target_name": "glandulas", "similarity": 0.924}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "organes glandulaires", "target_book": "first_principles_spencer_1862", "target_name": "glandular organs", "similarity": 0.988}, {"source_book": "polyanthea_medicinal", "source_name": "glandulas", "target_book": "first_principles_spencer_1862", "target_name": "glandular organs", "similarity": 0.925}], "id": 1051, "stable_key": "clu_bfa73f3c2dad782c-2", "ground_truth": {"modern_name": "glands", "confidence": "high", "type": "concept", "wikidata_id": "Q9647", "wikidata_description": "type of animal organ", "wikipedia_url": "https://en.wikipedia.org/wiki/Gland", "wikipedia_extract": "A gland is a cell or an organ in an animal's body that produces and secretes different substances that the organism needs, either into the bloodstream or into a body cavity or outer surface. A gland may also function to remove unwanted substances such as urine from the body. There are two types of gland, each with a different method of secretion. Endocrine glands are ductless and secrete their products, hormones,  directly into interstitial spaces to be taken up into the bloodstream. Exocrine glands secrete their products through a duct into a body cavity or outer surface. Glands are mostly composed of epithelial tissue, and typically have a supporting framework of connective tissue, and a capsule."}}, {"canonical_name": "Authors", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "authors", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Authors", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["Authors"], "contexts": ["General term for writers", "ancient and modern sources"]}, {"entity_id": "authors", "book_id": "english_physician_1652", "name": "Authors", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 11, "variants": ["Authors", "Author"], "contexts": ["referred to as source of information", "writers on the subject"]}, {"entity_id": "authors", "book_id": "origin_of_species_darwin_1859", "name": "authors", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["authors"], "contexts": ["unspecified writers on variability", "writers on extinction of species"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Authors", "target_book": "english_physician_1652", "target_name": "Authors", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Authors", "target_book": "origin_of_species_darwin_1859", "target_name": "authors", "similarity": 0.996}, {"source_book": "english_physician_1652", "source_name": "Authors", "target_book": "origin_of_species_darwin_1859", "target_name": "authors", "similarity": 0.996}], "id": 1052, "stable_key": "clu_abf54dbc59e73af7-2", "ground_truth": {"modern_name": "Authors", "confidence": "high", "type": "concept", "note": "This cluster refers to the collective body of recognized authorities and writers in a particular field, not specific individuals.", "wikidata_id": "Q230768", "wikidata_description": "in art research, the process of determining the author of a creative work"}}, {"canonical_name": "Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "sea", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Sea"], "contexts": ["large body of water, molten in description", "waters affecting magnetic variation"]}, {"entity_id": "sea", "book_id": "english_physician_1652", "name": "Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Sea"], "contexts": ["location where Seriphium grows"]}, {"entity_id": "sea", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 14, "variants": ["sea", "Sea"], "contexts": ["body of saltwater", "large body of saltwater"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sea", "target_book": "english_physician_1652", "target_name": "Sea", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sea", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Sea", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Sea", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Sea", "similarity": 1.0}], "id": 1053, "stable_key": "clu_7cf0aa9a9b3ff251-3", "ground_truth": {"modern_name": "sea", "confidence": "high", "type": "place", "wikidata_id": "Q165", "wikidata_description": "city in and county seat of King County, State of Washington, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Sea", "wikipedia_extract": "A sea is a large body of salt water. There are particular seas and the sea. The sea commonly refers to the ocean, the interconnected body of seawaters that spans most of Earth. Particular seas are either marginal seas, second-order sections of the oceanic sea (e.g. the Mediterranean Sea), or certain large, nearly landlocked bodies of water. The salinity of water bodies varies widely, being lower near the surface and the mouths of large rivers and higher in the depths of the ocean; however, the relative proportions of dissolved salts vary little across the oceans."}}, {"canonical_name": "Seneca", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "seneca", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Seneca", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Seneca"], "contexts": ["ancient authority on philosophy and nature", "ancient philosopher, mentioned deadly drink"]}, {"entity_id": "seneca", "book_id": "kosmos_humboldt_1845", "name": "Seneca", "category": "PERSON", "subcategory": "AUTHORITY", "count": 14, "variants": ["Seneca"], "contexts": ["ancient philosopher and writer", "Roman philosopher and writer"]}, {"entity_id": "s\u00e9neca", "book_id": "coloquios_da_orta_1563", "name": "S\u00e9neca", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["S\u00e9neca"], "contexts": ["ancient philosopher"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Seneca", "target_book": "kosmos_humboldt_1845", "target_name": "Seneca", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Seneca", "target_book": "coloquios_da_orta_1563", "target_name": "S\u00e9neca", "similarity": 0.688}, {"source_book": "kosmos_humboldt_1845", "source_name": "Seneca", "target_book": "coloquios_da_orta_1563", "target_name": "S\u00e9neca", "similarity": 0.688}], "id": 1054, "stable_key": "clu_03ad3af5e4336b2c", "ground_truth": {"modern_name": "Seneca", "confidence": "high", "type": "person", "birth_year": -4, "death_year": 65, "description": "Roman Stoic philosopher, statesman, and playwright.", "wikidata_id": "Q2054", "wikidata_description": "Roman Stoic philosopher, statesman and dramatist (c. 4 BCE\u201365 CE)", "wikipedia_url": "https://en.wikipedia.org/wiki/Seneca%20the%20Younger", "wikipedia_extract": "Lucius Annaeus Seneca the Younger ( SEN-ik-\u0259; c. 4 BC \u2013 AD 65), usually known mononymously as Seneca, was a Stoic philosopher of Ancient Rome, a statesman, a dramatist, and in one work, a satirist, from the post-Augustan age of Latin literature. Seneca was born in Colonia Patricia Corduba in Hispania, and was trained in rhetoric and philosophy in Rome. His father was Seneca the Elder, his elder brother was Lucius Junius Gallio Annaeanus, and his nephew was the poet Lucan. In AD 41, Seneca was exiled to the island of Corsica under emperor Claudius, but was allowed to return in 49 to become a tutor to Nero. When Nero became emperor in 54, Seneca became his advisor and, together with the praetorian prefect Sextus Afranius Burrus, provided competent government for the first five years of Nero's reign."}}, {"canonical_name": "Cauca", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "caucasus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Caucasus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Caucasus"], "contexts": ["mythological location of punishment"]}, {"entity_id": "caucase", "book_id": "epoques_nature_buffon_1778", "name": "Caucase", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Caucase"], "contexts": ["mountain range near Persia"]}, {"entity_id": "cauca", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cauca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 16, "variants": ["Cauca"], "contexts": ["city with population 193,200", "river name"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Caucasus", "target_book": "epoques_nature_buffon_1778", "target_name": "Caucase", "similarity": 0.964}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Caucasus", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Cauca", "similarity": 0.949}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Caucase", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Cauca", "similarity": 0.941}], "id": 1055, "stable_key": "clu_e3554f060de862d1", "ground_truth": {"modern_name": "Caucasus", "confidence": "high", "type": "place", "description": "Mountain range and region of observations.", "wikipedia_extract": "The Caucasus ( KAW-k\u0259-s\u0259s) or Caucasia ( kaw-KAY-zh\u0259) is a region spanning Eastern Europe and Western Asia. It is situated between the Black Sea and the Caspian Sea, comprising parts of Southern Russia, Georgia, Armenia, and Azerbaijan. The Caucasus Mountains, including the Greater Caucasus range, have conventionally been considered as a natural barrier between Europe and Asia, bisecting the Eurasian landmass. Mount Elbrus, Europe's highest mountain, is situated in the Western Caucasus area of Russia. On the southern side, the Lesser Caucasus includes the Javakheti Plateau and the Armenian highlands. The Caucasus is divided into the North Caucasus and South Caucasus, although the Western Caucasus also exists as a distinct geographic space within the North Caucasus."}}, {"canonical_name": "Tyrol", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "tyrol", "book_id": "epoques_nature_buffon_1778", "name": "Tyrol", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Tyrol"], "contexts": ["region with Alps", "region in the Alps"]}, {"entity_id": "tyrol", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tyrol", "category": "PLACE", "subcategory": "REGION", "count": 11, "variants": ["Tyrol", "Tyrol m\u00e9ridional"], "contexts": ["region with schists", "region"]}, {"entity_id": "tyrol", "book_id": "kosmos_humboldt_1845", "name": "Tyrol", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Tyrol"], "contexts": ["region of Cascade of Conzocoli", "region with dolomite masses"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Tyrol", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Tyrol", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Tyrol", "target_book": "kosmos_humboldt_1845", "target_name": "Tyrol", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tyrol", "target_book": "kosmos_humboldt_1845", "target_name": "Tyrol", "similarity": 1.0}], "id": 1056, "stable_key": "clu_eb4fdd70ec3208f2", "ground_truth": {"modern_name": "Tyrol", "confidence": "high", "type": "place", "country": "Austria", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "The Tyrol\u2013South Tyrol\u2013Trentino Euroregion (German: Europaregion Tirol-S\u00fcdtirol-Trentino; Italian: Euregio Tirolo-Alto Adige-Trentino) is a Euroregion formed by three different regional authorities in Austria and Italy: the Austrian state of Tyrol (i.e. North and East Tyrol) and the Italian autonomous provinces of South Tyrol and Trentino. The boundaries of the association correspond to the former Princely County of Tyrol, a crown land of the Habsburg monarchy (including the former Prince-bishoprics of Trent and Brixen) which for centuries shaped life in the Alpine region. Excluded from the association due to a change of the province by the fascists, are Cortina, Livinallongo, Colle Santa Lucia, Pedemonte, Valvestino and Magasa, but they have voted in 2007/2008 to revert to the provinces of South Tyrol/Trentino, which has not yet been approved by the Italian legislature in Rome. Divided after World War I, the region retained much of its cultural integrity by its traditionally strong attachment to the land and a profound desire for self-government on both sides of the border. The long-standing cultural, social and economic ties, as much as the recognition of convergent interests based on its traditional role as transit country and its largely identical environmental conditions in the Eastern Alps, led to the creation of the Euroregion by the three provinces in 1998.", "wikipedia_url": "https://en.wikipedia.org/wiki/Tyrol\u2013South_Tyrol\u2013Trentino_Euroregion"}}, {"canonical_name": "Childbirth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "childbirth", "book_id": "english_physician_1652", "name": "Childbirth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["Childbirth", "Child-bearing", "Childbearing"], "contexts": ["hard labor in childbirth", "process of giving birth"]}, {"entity_id": "parto", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "parto", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["parto"], "contexts": ["process of childbirth", "childbirth, accelerated by herbs"]}, {"entity_id": "partos", "book_id": "polyanthea_medicinal", "name": "partos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["partos"], "contexts": ["childbirths", "childbirth"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Childbirth", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "parto", "similarity": 0.887}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "parto", "target_book": "polyanthea_medicinal", "target_name": "partos", "similarity": 0.933}], "id": 1057, "stable_key": "clu_83683cde9bed5836", "ground_truth": {"modern_name": "childbirth", "confidence": "high", "type": "concept", "wikidata_id": "Q34581", "wikidata_description": "physiological process of expelling a fetus from the pregnant human mother's uterus", "wikipedia_url": "https://en.wikipedia.org/wiki/Childbirth"}}, {"canonical_name": "scale", "category": "OBJECT", "subcategory": "TOOL", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "scale", "book_id": "english_physician_1652", "name": "Scale", "category": "OBJECT", "subcategory": "TOOL", "count": 1, "variants": ["Scale"], "contexts": ["measuring instrument"]}, {"entity_id": "scale", "book_id": "ricettario_fiorentino_1597", "name": "Scale", "category": "OBJECT", "subcategory": "TOOL", "count": 1, "variants": ["Scale"], "contexts": ["measuring instrument"]}, {"entity_id": "scale", "book_id": "polyanthea_medicinal", "name": "scale", "category": "OBJECT", "subcategory": "TOOL", "count": 16, "variants": ["scale", "Scale", "scales"], "contexts": ["an instrument for weighing", "instrument for weighing"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Scale", "target_book": "ricettario_fiorentino_1597", "target_name": "Scale", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Scale", "target_book": "polyanthea_medicinal", "target_name": "scale", "similarity": 0.974}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Scale", "target_book": "polyanthea_medicinal", "target_name": "scale", "similarity": 0.974}], "id": 1058, "stable_key": "clu_a21f70e026048f79", "ground_truth": {"modern_name": "Scale (weighing)", "confidence": "high", "type": "object", "description": "Instrument used for measuring weight.", "note": "Refers to a weighing instrument, not a biological scale.", "wikipedia_extract": "A scale or balance is a device used to measure weight or mass. These are also known as mass scales, weight scales, mass balances, massometers, and weight balances. The traditional scale consists of two plates or bowls suspended at equal distances from a fulcrum. One plate holds an object of unknown mass (or weight), while objects of known mass or weight, called weights, are added to the other plate until mechanical equilibrium is achieved and the plates level off, which happens when the masses on the two plates are equal. The perfect scale rests at neutral. A spring scale will make use of a spring of known stiffness to determine mass (or weight)."}}, {"canonical_name": "Stars", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "star", "book_id": "english_physician_1652", "name": "Star", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Star"], "contexts": ["comparison for leaf arrangement"]}, {"entity_id": "stars", "book_id": "kosmos_humboldt_1845", "name": "Stars", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 16, "variants": ["stars", "Stars"], "contexts": ["celestial bodies observed", "celestial bodies occupying space"]}, {"entity_id": "estrela", "book_id": "coloquios_da_orta_1563", "name": "estrela", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["estrela"], "contexts": ["celestial object guiding magos"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Star", "target_book": "kosmos_humboldt_1845", "target_name": "Stars", "similarity": 0.913}, {"source_book": "english_physician_1652", "source_name": "Star", "target_book": "coloquios_da_orta_1563", "target_name": "estrela", "similarity": 0.97}, {"source_book": "kosmos_humboldt_1845", "source_name": "Stars", "target_book": "coloquios_da_orta_1563", "target_name": "estrela", "similarity": 0.883}], "id": 1059, "stable_key": "clu_e10625f96dd5659c", "ground_truth": {"modern_name": "Star", "confidence": "high", "type": "object"}}, {"canonical_name": "northern hemisphere", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "southern_hemisphere", "book_id": "origin_of_species_darwin_1859", "name": "southern hemisphere", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["southern hemisphere"], "contexts": ["geographic region", "geographical region"]}, {"entity_id": "southern_hemisphere", "book_id": "kosmos_humboldt_1845", "name": "southern hemisphere", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["southern hemisphere"], "contexts": ["hemisphere with magnetic phenomena", "geographic region"]}, {"entity_id": "northern_hemisphere", "book_id": "connexion_physical_sciences_somerville_1858", "name": "northern hemisphere", "category": "PLACE", "subcategory": "REGION", "count": 9, "variants": ["northern hemisphere"], "contexts": ["half of celestial sphere north of ecliptic", "half of the Earth north of the equator"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "southern hemisphere", "target_book": "kosmos_humboldt_1845", "target_name": "southern hemisphere", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "southern hemisphere", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "northern hemisphere", "similarity": 0.938}, {"source_book": "kosmos_humboldt_1845", "source_name": "southern hemisphere", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "northern hemisphere", "similarity": 0.938}], "id": 1060, "stable_key": "clu_38eaf44e493961a0", "ground_truth": {"modern_name": "Northern Hemisphere", "confidence": "high", "type": "place", "note": "The presence of 'southern hemisphere' in the cluster, along with 'northern hemisphere', indicates a clear geographical/astronomical dichotomy.", "wikidata_id": "Q39061", "wikidata_description": "part of Earth that lies north of the equator"}}, {"canonical_name": "Coloquintida", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "coloquintida", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Coloquintida", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Coloquintida"], "contexts": ["species of Coloquintida, or wild gourd"]}, {"entity_id": "coloquintida", "book_id": "ricettario_fiorentino_1597", "name": "Coloquintida", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["Coloquintida", "Colocynth'M", "Colocynthida", "Colocyntida", "Cploquintida", "Golocynthida"], "contexts": ["colocynth", "bitter gourd used in preparations"]}, {"entity_id": "coloquintidas", "book_id": "polyanthea_medicinal", "name": "coloquintidas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["coloquintidas", "Colocynthide", "Coloquintida", "Coloquintidas", "colocynthide", "coloquinti"], "contexts": ["ingredient in plaster", "plant used in remedies"]}, {"entity_id": "polpade_coloquintidas", "book_id": "polyanthea_medicinal", "name": "polpade coloquintidas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["polpade coloquintidas"], "contexts": ["colocynth pulp used in preparations"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Coloquintida", "target_book": "ricettario_fiorentino_1597", "target_name": "Coloquintida", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Coloquintida", "target_book": "polyanthea_medicinal", "target_name": "coloquintidas", "similarity": 0.95}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Coloquintida", "target_book": "polyanthea_medicinal", "target_name": "polpade coloquintidas", "similarity": 0.89}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Coloquintida", "target_book": "polyanthea_medicinal", "target_name": "coloquintidas", "similarity": 0.95}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Coloquintida", "target_book": "polyanthea_medicinal", "target_name": "polpade coloquintidas", "similarity": 0.89}], "id": 1061, "stable_key": "clu_4493d514a26023a1", "ground_truth": {"modern_name": "Colocynth", "confidence": "high", "type": "plant", "linnaean": "Citrullus colocynthis", "family": "Cucurbitaceae", "description": "A bitter gourd plant used as an ingredient in medicinal preparations.", "note": "Includes singular and plural forms in Italian and English.", "wikipedia_extract": "Citrullus colocynthis, with many common names including colocynth, bitter apple, bitter cucumber, vine of Sodom, or wild gourd, is a poisonous desert viny plant native to the Mediterranean Basin and West Asia, especially the Levant, Turkey (especially in regions such as \u0130zmir), and Nubia. It resembles a common watermelon vine but bears small, hard fruits with a bitter pulp. The plant contains cytotoxic cucurbitacins and is thus unsafe to use as an herbal medicine. It originally bore the scientific name Colocynthis citrullus. The vine ranges from 2.4\u20133 metres (8\u201310 feet) in length. The roots are large, fleshy, and perennial, leading to a high survival rate due to the long tap root."}}, {"canonical_name": "Fidalgo", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "fidalgo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Fidalgo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 12, "variants": ["Fidalgo"], "contexts": ["led a maritime expedition", "published a map in 1816"]}, {"entity_id": "fidalgo", "book_id": "coloquios_da_orta_1563", "name": "fidalgo", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["fidalgo"], "contexts": ["nobleman"]}, {"entity_id": "fidalgo", "book_id": "polyanthea_medicinal", "name": "fidalgo", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 5, "variants": ["fidalgo", "fidalgo illuftriffimo", "fidalgos"], "contexts": ["nobleman", "nobleman whose case is described"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Fidalgo", "target_book": "coloquios_da_orta_1563", "target_name": "fidalgo", "similarity": 0.447}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Fidalgo", "target_book": "polyanthea_medicinal", "target_name": "fidalgo", "similarity": 0.447}, {"source_book": "coloquios_da_orta_1563", "source_name": "fidalgo", "target_book": "polyanthea_medicinal", "target_name": "fidalgo", "similarity": 1.0}], "id": 1062, "stable_key": "clu_b2e44fa2f0a2a715", "ground_truth": {"modern_name": "fidalgo", "confidence": "high", "type": "person", "description": "Portuguese nobleman, often involved in exploration or administration.", "note": "While 'fidalgo' refers to a social class, its use in the contexts suggests specific individuals holding such rank.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "cohesion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "cohesion", "book_id": "principles_of_psychology_james_1890", "name": "cohesion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["cohesion"], "contexts": ["force holding matter together", "concept of sticking together"]}, {"entity_id": "cohesion", "book_id": "connexion_physical_sciences_somerville_1858", "name": "cohesion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["cohesion", "Cohesion"], "contexts": ["force holding particles together", "force of attraction between particles"]}, {"entity_id": "cohesion", "book_id": "first_principles_spencer_1862", "name": "cohesion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["cohesion"], "contexts": ["physical property of matter", "tendency of parts to stick together"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "cohesion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "cohesion", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "cohesion", "target_book": "first_principles_spencer_1862", "target_name": "cohesion", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "cohesion", "target_book": "first_principles_spencer_1862", "target_name": "cohesion", "similarity": 1.0}], "id": 1063, "stable_key": "clu_9035919fe3fbb00a", "ground_truth": {"modern_name": "cohesion", "confidence": "high", "type": "concept", "wikidata_id": "Q216828", "wikidata_description": "chemical property of like molecules sticking together", "wikipedia_url": "https://en.wikipedia.org/wiki/Cohesion%20%28chemistry%29", "wikipedia_extract": "In chemistry and physics, cohesion (from Latin  cohaesi\u014d 'cohesion, unity'), also called cohesive attraction or cohesive force, is the action or property of like molecules sticking together, being mutually attractive. It is an intrinsic property of a substance that is caused by the shape and structure of its molecules, which makes the distribution of surrounding electrons irregular when molecules get close to one another, creating an electrical attraction that can maintain a macroscopic structure such as a water drop. Cohesion allows for surface tension, creating a \"solid-like\" state upon which light-weight or low-density materials can be placed. Water, for example, is strongly cohesive as each molecule may make four hydrogen bonds to other water molecules in a tetrahedral configuration. This results in a relatively strong Coulomb force between molecules. In simple terms, the polarity (a state in which a molecule is oppositely charged on its poles) of water molecules allows them to be attracted to each other."}}, {"canonical_name": "electric currents", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "currents", "book_id": "kosmos_humboldt_1845", "name": "currents", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Currents", "currents"], "contexts": ["oceanic movements", "local cause of level changes"]}, {"entity_id": "electric_currents", "book_id": "connexion_physical_sciences_somerville_1858", "name": "electric currents", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["electric currents"], "contexts": ["inducing state upon matter", "said of electric currents, whether produced by"]}, {"entity_id": "currents", "book_id": "connexion_physical_sciences_somerville_1858", "name": "currents", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Currents", "currents"], "contexts": ["oceanic flow", "flow of electric charge"]}, {"entity_id": "currents", "book_id": "first_principles_spencer_1862", "name": "currents", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["currents"], "contexts": ["flow of fluid or gas"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "currents", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electric currents", "similarity": 0.894}, {"source_book": "kosmos_humboldt_1845", "source_name": "currents", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "currents", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "currents", "target_book": "first_principles_spencer_1862", "target_name": "currents", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "electric currents", "target_book": "first_principles_spencer_1862", "target_name": "currents", "similarity": 0.894}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "currents", "target_book": "first_principles_spencer_1862", "target_name": "currents", "similarity": 1.0}], "id": 1064, "stable_key": "clu_23777a8ace3df4fe", "ground_truth": {"modern_name": "Electric current", "confidence": "high", "type": "concept", "note": "The context 'inducing state upon matter' points towards electrical phenomena, distinguishing it from purely oceanic or hydraulic currents.", "wikidata_id": "Q11651", "wikidata_description": "flow of electric charge", "wikipedia_url": "https://en.wikipedia.org/wiki/Electric%20current", "wikipedia_extract": "An electric current is a flow of charged particles, such as electrons or ions, moving through an electrical conductor or space. It is defined as the net rate of flow of electric charge through a surface. The moving particles are called charge carriers, which may be one of several types of particles, depending on the conductor. In electric circuits the charge carriers are often electrons moving through a wire. In semiconductors they can be electrons or holes. In an electrolyte the charge carriers are ions, while in plasma, an ionized gas, they are ions and electrons."}}, {"canonical_name": "Greenland", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "greenland", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Greenland", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Greenland"], "contexts": ["geographic location"]}, {"entity_id": "greenland", "book_id": "kosmos_humboldt_1845", "name": "Greenland", "category": "PLACE", "subcategory": "COUNTRY", "count": 10, "variants": ["Greenland"], "contexts": ["northernmost observation point", "location of observation"]}, {"entity_id": "west_greenland", "book_id": "kosmos_humboldt_1845", "name": "West Greenland", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["West Greenland"], "contexts": ["geographic region mentioned in passage", "region in Greenland"]}, {"entity_id": "greenland", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Greenland", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Greenland"], "contexts": ["northern coast where tidal wave was seen", "northern coast with extreme cold"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Greenland", "target_book": "kosmos_humboldt_1845", "target_name": "Greenland", "similarity": 0.887}, {"source_book": "kosmos_humboldt_1845", "source_name": "West Greenland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Greenland", "similarity": 0.911}], "id": 1065, "stable_key": "clu_7ad6acf13f371139", "ground_truth": {"modern_name": "Greenland", "confidence": "high", "type": "place", "country": "Greenland", "wikidata_id": "Q223", "wikidata_description": "autonomous territory of the Kingdom of Denmark and world's largest island", "wikipedia_url": "https://en.wikipedia.org/wiki/Greenland", "wikipedia_extract": "Greenland is an autonomous territory of the Kingdom of Denmark and is the largest of the kingdom's three constituent parts by land area, the others being Denmark proper and the Faroe Islands. Citizens of Greenland are citizens of Denmark. They are thus citizens of the European Union (EU), although Greenland is not part of the EU. It is the world's largest island and lies between the Arctic and Atlantic oceans, east of the Canadian Arctic Archipelago. It shares a small 1.2-kilometre (0.75 mi) border with Canada on Hans Island. The capital and largest city is Nuuk."}}, {"canonical_name": "chevaux", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "cheval", "book_id": "medecine_experimentale_bernard_1865", "name": "cheval", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 7, "variants": ["cheval"], "contexts": ["domestic animal used in research", "animal where facial nerve section is fatal"]}, {"entity_id": "chevaux", "book_id": "medecine_experimentale_bernard_1865", "name": "chevaux", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["chevaux"], "contexts": ["animal species studied"]}, {"entity_id": "cheval", "book_id": "epoques_nature_buffon_1778", "name": "cheval", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["cheval"], "contexts": ["domesticated mammal"]}, {"entity_id": "chevaux", "book_id": "relation_historique_humboldt_vol3_1825", "name": "chevaux", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 8, "variants": ["chevaux", "cheval"], "contexts": ["animals competing for pasture", "animals for transport and sustenance"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "cheval", "target_book": "epoques_nature_buffon_1778", "target_name": "cheval", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "cheval", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "chevaux", "similarity": 0.945}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "chevaux", "target_book": "epoques_nature_buffon_1778", "target_name": "cheval", "similarity": 0.945}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "chevaux", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "chevaux", "similarity": 1.0}], "id": 1066, "stable_key": "clu_d4797be5c7ad162b-3", "ground_truth": {"modern_name": "Horse", "confidence": "high", "type": "animal", "note": "The phrase 'agua do mar' (sea water) in the context of 'animal listed with numbers' and 'water used for healing soldiers' is a misinterpretation or OCR error. The surrounding English texts and the specific mention of 'Mare' (a mare, or female horse) strongly indicate the referent is 'horse'. The 'animal listed with numbers' context might refer to breeds or classifications, and 'female horse used in a cross' is a direct biological reference.", "wikidata_id": "", "wikidata_description": "domesticated four-footed mammal from the equine family", "wikipedia_url": "https://en.wikipedia.org/wiki/Horse", "wikipedia_extract": "The horse (Equus ferus caballus) is a domesticated, one-toed, hoofed mammal. It belongs to the taxonomic family Equidae and is one of two extant subspecies of Equus ferus. The horse has evolved over the past 45 to 55 million years from a small multi-toed creature, Eohippus, into the large single-toed animal of today, originally in North America. Humans began domesticating horses around 4000 BCE in Central Asia, and their domestication is believed to have been widespread by 3000 BCE. Horses in the subspecies caballus are domesticated, although some domesticated populations live in the wild as feral horses. These feral populations are not true wild horses, which are horses that have never been domesticated.", "linnaean": "Equus caballus", "family": "Equidae", "description": "A domesticated mammal with hooves, widely used by humans."}}, {"canonical_name": "movements", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "mouvements", "book_id": "medecine_experimentale_bernard_1865", "name": "mouvements", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["mouvements"], "contexts": ["bodily movements", "movements"]}, {"entity_id": "movements", "book_id": "principles_of_psychology_james_1890", "name": "movements", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 14, "variants": ["movements"], "contexts": ["actions of changing position", "physical actions or displacements"]}, {"entity_id": "movements", "book_id": "first_principles_spencer_1862", "name": "movements", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["movements"], "contexts": ["physical displacements"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "mouvements", "target_book": "principles_of_psychology_james_1890", "target_name": "movements", "similarity": 0.986}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "mouvements", "target_book": "first_principles_spencer_1862", "target_name": "movements", "similarity": 0.986}, {"source_book": "principles_of_psychology_james_1890", "source_name": "movements", "target_book": "first_principles_spencer_1862", "target_name": "movements", "similarity": 1.0}], "id": 1067, "stable_key": "clu_5a055ec0f2e1bf90-2", "ground_truth": {"modern_name": "Movement", "confidence": "high", "type": "concept", "wikidata_id": "Q49773", "wikidata_description": "loosely organized effort by a large group of people to achieve a particular set of goals", "note": "The context 'geological process of land changing position' refers to geological movement, while 'physical motion' refers to physics. Both are encompassed by the broader concept of movement."}}, {"canonical_name": "thoughts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "pens\u00e9es", "book_id": "medecine_experimentale_bernard_1865", "name": "pens\u00e9es", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["pens\u00e9es"], "contexts": ["mental activity of forming ideas"]}, {"entity_id": "thoughts", "book_id": "principles_of_psychology_james_1890", "name": "thoughts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 14, "variants": ["thoughts"], "contexts": ["mental activity", "mental content in Shakespeare's mind"]}, {"entity_id": "thoughts", "book_id": "first_principles_spencer_1862", "name": "thoughts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["thoughts"], "contexts": ["mental processes of thinking", "mental processes of cognition"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "pens\u00e9es", "target_book": "principles_of_psychology_james_1890", "target_name": "thoughts", "similarity": 0.961}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "pens\u00e9es", "target_book": "first_principles_spencer_1862", "target_name": "thoughts", "similarity": 0.961}, {"source_book": "principles_of_psychology_james_1890", "source_name": "thoughts", "target_book": "first_principles_spencer_1862", "target_name": "thoughts", "similarity": 1.0}], "id": 1068, "stable_key": "clu_8a26a71aa71f1ec9-2", "ground_truth": {"modern_name": "Thought", "confidence": "high", "type": "concept", "wikidata_id": "Q349047", "wikidata_description": "form created in the mind, instance of thinking"}}, {"canonical_name": "excremento", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "excr\u00e9ments", "book_id": "medecine_experimentale_bernard_1865", "name": "excr\u00e9ments", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["excr\u00e9ments"], "contexts": ["waste products eliminated from the body"]}, {"entity_id": "excremento", "book_id": "polyanthea_medicinal", "name": "excremento", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 15, "variants": ["excremento", "excrementicios", "excrementis", "excremento colerico", "excremento e\u017ftercoro\u017fo", "excrementorum", "excrementos biliofos", "excrementos biliotos", "excrementos craffos", "excrementos do estomago", "excrementos fcrofos", "excrementos ferofos", "excrementos lymphaticos", "excrementos reteudos"], "contexts": ["excrement", "excrement, bodily fluid"]}, {"entity_id": "excretory_organs", "book_id": "first_principles_spencer_1862", "name": "excretory organs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["excretory organs"], "contexts": ["organs for waste removal"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "excr\u00e9ments", "target_book": "polyanthea_medicinal", "target_name": "excremento", "similarity": 0.939}, {"source_book": "polyanthea_medicinal", "source_name": "excremento", "target_book": "first_principles_spencer_1862", "target_name": "excretory organs", "similarity": 0.883}], "id": 1069, "stable_key": "clu_b0ae97ba947f439d", "ground_truth": {"modern_name": "Excrement", "confidence": "high", "type": "concept", "note": "The term 'excremento' in Portuguese directly translates to 'excrement'. The English 'excretory organs' is a related concept.", "wikidata_id": "Q1383944", "wikidata_description": "waste materials emitted by evacuation from animal organisms"}}, {"canonical_name": "Breath", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "breath", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "breath", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["breath"], "contexts": ["air exhaled from lungs"]}, {"entity_id": "breath", "book_id": "english_physician_1652", "name": "Breath", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 12, "variants": ["breath", "Breath"], "contexts": ["bodily function, plant helps if stinking", "respiration"]}, {"entity_id": "breathing", "book_id": "principles_of_psychology_james_1890", "name": "breathing", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["breathing"], "contexts": ["process of inhaling and exhaling", "process of respiration"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "breath", "target_book": "english_physician_1652", "target_name": "Breath", "similarity": 0.989}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "breath", "target_book": "principles_of_psychology_james_1890", "target_name": "breathing", "similarity": 0.975}, {"source_book": "english_physician_1652", "source_name": "Breath", "target_book": "principles_of_psychology_james_1890", "target_name": "breathing", "similarity": 0.969}], "id": 1070, "stable_key": "clu_e9566bae2a0ef15b-2", "ground_truth": {"modern_name": "Respiration", "confidence": "high", "type": "concept", "note": "The term 'Breath' can refer to both the substance exhaled and the process.", "wikidata_id": "Q9530", "wikidata_description": "process that moves air in and out of the lungs", "wikipedia_url": "https://en.wikipedia.org/wiki/Breathing", "wikipedia_extract": "Breathing (respiration or ventilation) is the rhythmic process of moving air into (inhalation) and out of (exhalation) the lungs to enable gas exchange with the internal environment, primarily to remove carbon dioxide and take in oxygen. All aerobic organisms require oxygen for cellular respiration, which extracts energy from food and produces carbon dioxide as a waste product. External respiration (breathing) brings air to the alveoli where gases move by diffusion; the circulatory system then transports oxygen and carbon dioxide between the lungs and the tissues. In vertebrates with lungs, breathing consists of repeated cycles of inhalation and exhalation through a branched system of airways that conduct air from the nose or mouth to the alveoli. The number of respiratory cycles per minute \u2014 the respiratory or breathing rate \u2014 is a primary vital sign. Under normal conditions, depth and rate of breathing are controlled unconsciously by homeostatic mechanisms that maintain arterial partial pressures of carbon dioxide and oxygen."}}, {"canonical_name": "Fundament", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "fundament", "book_id": "english_physician_1652", "name": "Fundament", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 14, "variants": ["Fundament", "Funda\u0300ment"], "contexts": ["body part with sores", "part where imposthumes are dissolved by dill seed"]}, {"entity_id": "base", "book_id": "connexion_physical_sciences_somerville_1858", "name": "base", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["base"], "contexts": ["bottom part of a cone"]}, {"entity_id": "base", "book_id": "first_principles_spencer_1862", "name": "base", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["base"], "contexts": ["fundamental component of oxides", "component of salt atoms"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Fundament", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "base", "similarity": 0.926}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "base", "target_book": "first_principles_spencer_1862", "target_name": "base", "similarity": 0.652}], "id": 1071, "stable_key": "clu_dbdff517f846ca7a", "ground_truth": {"modern_name": "Base", "confidence": "medium", "type": "concept", "note": "The contexts suggest both anatomical (body part) and chemical/geometrical meanings. 'Base' is chosen as the most encompassing."}}, {"canonical_name": "basalte", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "basalte", "book_id": "epoques_nature_buffon_1778", "name": "basalte", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["basalte"], "contexts": ["a type of volcanic rock", "rock forming coastal ramparts"]}, {"entity_id": "basalte", "book_id": "relation_historique_humboldt_vol3_1825", "name": "basalte", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 14, "variants": ["basalte", "basaltes", "basaltes ferrugineux", "basaltic"], "contexts": ["type of volcanic rock", "rock type, not associated with Ortiz amygdaloid"]}, {"entity_id": "basalts", "book_id": "kosmos_humboldt_1845", "name": "basalts", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["basalts"], "contexts": ["extrusive igneous rock"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "basalte", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "basalte", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "basalte", "target_book": "kosmos_humboldt_1845", "target_name": "basalts", "similarity": 0.949}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "basalte", "target_book": "kosmos_humboldt_1845", "target_name": "basalts", "similarity": 0.949}], "id": 1072, "stable_key": "clu_ef11226103bcbb98", "ground_truth": {"modern_name": "Basalt", "confidence": "high", "type": "mineral", "wikidata_id": "Q18943892", "wikidata_description": "street in Langenboom, the Netherlands", "note": "The term 'Basaltes' or 'basaltic' refers to the igneous rock basalt, often described for its density and sometimes its columnar jointing."}}, {"canonical_name": "metaphysics", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "metaphysicks", "book_id": "english_physician_1652", "name": "Metaphysicks", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Metaphysicks"], "contexts": ["philosophical work"]}, {"entity_id": "metaphysics", "book_id": "principles_of_psychology_james_1890", "name": "metaphysics", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["metaphysics", "Metaphysics"], "contexts": ["discussion of fundamental elements", "branch of philosophy dealing with abstract concepts"]}, {"entity_id": "metaphysic", "book_id": "principles_of_psychology_james_1890", "name": "Metaphysic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Metaphysic"], "contexts": ["metaphysics work title", "Lotze's work on metaphysics"]}, {"entity_id": "metaphysics", "book_id": "first_principles_spencer_1862", "name": "metaphysics", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["metaphysics"], "contexts": ["branch of philosophy", "branch of philosophy concerning existence"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Metaphysicks", "target_book": "principles_of_psychology_james_1890", "target_name": "metaphysics", "similarity": 0.947}, {"source_book": "english_physician_1652", "source_name": "Metaphysicks", "target_book": "principles_of_psychology_james_1890", "target_name": "Metaphysic", "similarity": 0.939}, {"source_book": "english_physician_1652", "source_name": "Metaphysicks", "target_book": "first_principles_spencer_1862", "target_name": "metaphysics", "similarity": 0.947}, {"source_book": "principles_of_psychology_james_1890", "source_name": "metaphysics", "target_book": "first_principles_spencer_1862", "target_name": "metaphysics", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Metaphysic", "target_book": "first_principles_spencer_1862", "target_name": "metaphysics", "similarity": 0.935}], "id": 1073, "stable_key": "clu_bbdc8a4c684bab33", "ground_truth": {"modern_name": "Metaphysics", "confidence": "high", "type": "concept", "wikidata_id": "Q35277", "wikidata_description": "branch of philosophy dealing with the nature, structure, components and fundamental principles of reality", "wikipedia_url": "https://en.wikipedia.org/wiki/Metaphysics", "wikipedia_extract": "Metaphysics is the branch of philosophy that examines the basic structure of reality. It is traditionally seen as the study of mind-independent features of the world, but some theorists view it as an inquiry into the conceptual framework of human understanding. Some philosophers, including Aristotle, designate metaphysics as first philosophy to suggest that it is more fundamental than other forms of philosophical inquiry. Metaphysics encompasses a wide range of general and abstract topics. It investigates the nature of existence, the features all entities have in common, and their division into categories of being. An influential division is between particulars and universals."}}, {"canonical_name": "acucar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "acucar", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "acucar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 9, "variants": ["acucar"], "contexts": ["sweet crystalline substance", "sweetener used with tamarind"]}, {"entity_id": "acucar", "book_id": "historia_medicinal_monardes_1574", "name": "acucar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 7, "variants": ["acucar", "Acucares", "acibar", "agucar"], "contexts": ["sugar used to make syrup", "sugar"]}, {"entity_id": "a\u00e7ucar", "book_id": "coloquios_da_orta_1563", "name": "a\u00e7ucar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["a\u00e7ucar"], "contexts": ["sugar added to rose decoction"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "acucar", "target_book": "historia_medicinal_monardes_1574", "target_name": "acucar", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "acucar", "target_book": "coloquios_da_orta_1563", "target_name": "a\u00e7ucar", "similarity": 0.4}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "acucar", "target_book": "coloquios_da_orta_1563", "target_name": "a\u00e7ucar", "similarity": 0.4}], "id": 1074, "stable_key": "clu_e250c7e76f6789aa-2", "ground_truth": {"modern_name": "Sugar", "confidence": "high", "type": "substance", "description": "Sweet crystalline substance derived from plants, used as a sweetener.", "note": "Refers to the substance itself, distinct from the plant.", "wikipedia_extract": "Sugar () is a class of sweet-tasting, soluble carbohydrates, many of which are used in food. Simple sugars, also called monosaccharides, include glucose, fructose, and galactose. Compound sugars, also called disaccharides or double sugars, are molecules made of two bonded monosaccharides; common examples are sucrose (glucose + fructose), lactose (glucose + galactose), and maltose (two molecules of glucose). White sugar is almost pure sucrose. During digestion, compound sugars are hydrolysed into simple sugars. Longer chains of saccharides are not regarded as sugars, and are called oligosaccharides or polysaccharides."}}, {"canonical_name": "trigo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "trigo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "trigo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["trigo"], "contexts": ["grain, compared to maize", "grain requiring more labor than maize"]}, {"entity_id": "p\u00e2o_de_trigo", "book_id": "coloquios_da_orta_1563", "name": "p\u00e2o de trigo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["p\u00e2o de trigo"], "contexts": ["bread not given to the sick"]}, {"entity_id": "trigo", "book_id": "polyanthea_medicinal", "name": "trigo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 11, "variants": ["trigo"], "contexts": ["ingredient in a preparation", "ingredient in a remedy"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "trigo", "target_book": "coloquios_da_orta_1563", "target_name": "p\u00e2o de trigo", "similarity": 0.899}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "trigo", "target_book": "polyanthea_medicinal", "target_name": "trigo", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "p\u00e2o de trigo", "target_book": "polyanthea_medicinal", "target_name": "trigo", "similarity": 0.899}], "id": 1075, "stable_key": "clu_5f09150a4daa2570-2", "ground_truth": {"modern_name": "Wheat", "confidence": "high", "type": "plant", "linnaean": "Triticum aestivum", "family": "Poaceae", "note": "The contexts strongly suggest the common grain plant.", "wikidata_id": "Q12106", "wikidata_description": "genus of plants (focus on taxonomy here, not on agriculture)", "wikipedia_url": "https://en.wikipedia.org/wiki/Triticum", "description": "Grain used in preparations, remedies, and for weight comparisons.", "wikipedia_extract": "Common wheat (Triticum aestivum), also known as bread wheat, is a cultivated wheat species. About 95% of wheat produced worldwide is this species; it is the most widely planted of all crops by area (as of 2009) and the cereal with the highest monetary yield. Numerous forms of wheat have evolved under human selection. This diversity has led to confusion in the naming of wheats, with names based on both genetic and morphological characteristics. Bread wheat is an allohexaploid \u2013 a combination of six sets of chromosomes from different species. Of the six sets of chromosomes, four come from emmer (Triticum turgidum, itself a tetraploid) and two from Aegilops tauschii (a wild diploid goatgrass)."}}, {"canonical_name": "amarguo", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "amargor", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "amargor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["amargor"], "contexts": ["taste quality of Tlepatli's root", "taste quality of plants"]}, {"entity_id": "amarguo", "book_id": "coloquios_da_orta_1563", "name": "amarguo", "category": "CONCEPT", "subcategory": "QUALITY", "count": 7, "variants": ["amarguo", "amargo", "amargoso", "amargura", "amarid\u00e3o"], "contexts": ["bitter flavor", "taste quality"]}, {"entity_id": "amargofo", "book_id": "polyanthea_medicinal", "name": "amargofo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["amargofo", "amargofas", "amargofojo"], "contexts": ["bitter taste", "bitter substance"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "amargor", "target_book": "coloquios_da_orta_1563", "target_name": "amarguo", "similarity": 0.927}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "amargor", "target_book": "polyanthea_medicinal", "target_name": "amargofo", "similarity": 0.938}, {"source_book": "coloquios_da_orta_1563", "source_name": "amarguo", "target_book": "polyanthea_medicinal", "target_name": "amargofo", "similarity": 0.966}], "id": 1076, "stable_key": "clu_61ee8e160fb395ca", "ground_truth": {"modern_name": "bitter taste", "confidence": "high", "type": "concept", "wikidata_id": "Q1517187", "wikidata_description": "basic taste", "wikipedia_url": "https://en.wikipedia.org/wiki/Bitterness", "wikipedia_extract": "Bitterness, also known as bitter, is one of the most sensitive of tastes, and many experience it as unpleasant, sharp, or off-putting, but it is sometimes desirable and intentionally added via various bittering agents. Common bitter foods and drinks include coffee, unsweetened cocoa, South American mate, coca tea, Momordica charantia, unripe olives, citrus peel, some varieties of cheese, many plants in the Brassicaceae family, Taraxacum greens, Marrubium vulgare, wild chicory, and escarole. The ethanol in alcoholic beverages tastes bitter, as do the additional bittering ingredients found in some alcoholic beverages, including hops in beer and gentian in bitters. Quinine is also known for its bitter taste and is found in tonic water. Bitterness is of interest to those studying evolution, as well as to various health researchers as a large number of naturally occurring bitter compounds are known to be toxic. The ability to detect bitter-tasting, toxic compounds at low thresholds is thought to serve an important protective function."}}, {"canonical_name": "gota coral", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "gota_coral", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "gota coral", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["gota coral"], "contexts": ["condition treated by chilpanxochitl ointment", "affliction treated externally"]}, {"entity_id": "gota_coral", "book_id": "historia_medicinal_monardes_1574", "name": "gota coral", "category": "DISEASE", "subcategory": "CHRONIC", "count": 12, "variants": ["gota coral", "Gota Coral", "Gota corak", "Gota coral", "gota"], "contexts": ["gout, a disease", "strong and almost incurable disease"]}, {"entity_id": "gota_coral", "book_id": "coloquios_da_orta_1563", "name": "gota coral", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["gota coral"], "contexts": ["gout, treated with coconut"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "gota coral", "target_book": "historia_medicinal_monardes_1574", "target_name": "gota coral", "similarity": 0.859}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "gota coral", "target_book": "coloquios_da_orta_1563", "target_name": "gota coral", "similarity": 0.859}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "gota coral", "target_book": "coloquios_da_orta_1563", "target_name": "gota coral", "similarity": 1.0}], "id": 1077, "stable_key": "clu_88100adab4afa6a2-2", "ground_truth": {"modern_name": "Gout", "confidence": "high", "type": "disease", "modern_term": "Gout", "wikidata_id": "Q133087", "wikidata_description": "medical condition that results in recurrent pain and swelling of joints", "wikipedia_url": "https://en.wikipedia.org/wiki/Gout", "wikipedia_extract": "Gout ( GOWT) is a form of inflammatory arthritis characterized by recurrent attacks of pain in a red, tender, hot, and swollen joint, caused by the deposition of needle-shaped crystals of the monosodium salt of uric acid. Pain typically comes on rapidly, reaching maximal intensity in less than 12 hours. In about half of cases, the joint at the base of the big toe is affected (Podagra). It may also result in tophi, kidney stones, or kidney damage. Gout is due to persistently elevated levels of uric acid (urate) in the blood (hyperuricemia). This occurs from a combination of diet, other health problems, and genetic factors.", "note": "The term 'gota coral' appears to be an early modern descriptor for gout, possibly with specific regional or contextual nuances, as suggested by the mention of 'coconut' in the context of treatment. However, the core disease is gout.", "description": "A metabolic disease causing joint inflammation."}}, {"canonical_name": "civilisation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "civilisation", "book_id": "relation_historique_humboldt_vol3_1825", "name": "civilisation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["civilisation", "civilisation humaine"], "contexts": ["progress hindered by institutions", "development of society"]}, {"entity_id": "civilization", "book_id": "kosmos_humboldt_1845", "name": "civilization", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["civilization"], "contexts": ["progress carried to tropical regions", "advanced human society and culture"]}, {"entity_id": "civilization", "book_id": "first_principles_spencer_1862", "name": "civilization", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["civilization"], "contexts": ["societal development influencing phenomena frequency", "latest results of transformation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "civilisation", "target_book": "kosmos_humboldt_1845", "target_name": "civilization", "similarity": 0.975}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "civilisation", "target_book": "first_principles_spencer_1862", "target_name": "civilization", "similarity": 0.975}, {"source_book": "kosmos_humboldt_1845", "source_name": "civilization", "target_book": "first_principles_spencer_1862", "target_name": "civilization", "similarity": 1.0}], "id": 1078, "stable_key": "clu_5e5d36f20ce6ddd9", "ground_truth": {"modern_name": "Civilization", "confidence": "high", "type": "concept", "wikidata_id": "Q8432", "wikidata_description": "organized cultural society that encounters many communities, on a scale of a nation or human, as well as a system of development", "wikipedia_url": "https://en.wikipedia.org/wiki/Civilization", "wikipedia_extract": "A civilization (; also spelled civilisation in British English) is any complex society characterized by the development of the state, social stratification, urbanization, and symbolic systems of communication beyond signed or spoken languages (namely, writing systems).Civilizations are organized around densely populated settlements, divided into more or less rigid hierarchical social classes of division of labour, often with a ruling elite and subordinate urban and rural populations, which engage in intensive agriculture, mining, small-scale manufacture and trade. Civilization concentrates power, extending human control over the rest of nature, including over other human beings. Civilizations are characterized by elaborate agriculture, architecture, infrastructure, technological advancement, currency, taxation, regulation, and specialization of labour. Historically, a civilization has often been understood as a larger and \"more advanced\" culture, in implied contrast to smaller, supposedly less advanced cultures, even societies  within civilizations themselves and within their histories. Generally civilization contrasts with non-centralized tribal societies, including the cultures of nomadic pastoralists, Neolithic societies, or hunter-gatherers. The word civilization relates to the Latin civitas or 'city'."}}, {"canonical_name": "Inclination", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "inclinaison", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Inclinaison", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["inclinaison", "Inclinaison"], "contexts": ["vertical angle of magnetic needle", "magnetic measurement"]}, {"entity_id": "inclination", "book_id": "kosmos_humboldt_1845", "name": "inclination", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["inclination"], "contexts": ["angle of an orbit relative to a plane", "magnetic dip angle"]}, {"entity_id": "inclination", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Inclination", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["Inclination", "inclination"], "contexts": ["angle of orbital plane", "angle of orbit relative to plane"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Inclinaison", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Inclination", "similarity": 0.937}, {"source_book": "kosmos_humboldt_1845", "source_name": "inclination", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Inclination", "similarity": 0.815}], "id": 1079, "stable_key": "clu_63046eb1c401f8c6", "ground_truth": {"modern_name": "Inclination", "confidence": "high", "type": "concept", "note": "Refers to angles in various physical and astronomical contexts.", "wikidata_id": "Q21263963", "wikidata_description": "concept in ethics"}}, {"canonical_name": "movement", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "movement", "book_id": "princ