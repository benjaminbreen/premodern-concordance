, "total_mentions": 4, "members": [{"entity_id": "sables_calcaires", "book_id": "epoques_nature_buffon_1778", "name": "sables calcaires", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["sables calcaires"], "contexts": ["calcareous sand", "calcareous sands, a mineral substance"]}, {"entity_id": "calcareous_sandstone", "book_id": "kosmos_humboldt_1845", "name": "calcareous sandstone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["calcareous sandstone"], "contexts": ["rock type", "type of sandstone"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "sables calcaires", "target_book": "kosmos_humboldt_1845", "target_name": "calcareous sandstone", "similarity": 0.938}], "id": 3940, "stable_key": "clu_9450093264b9d9a3-4", "ground_truth": {"modern_name": "Limestone", "confidence": "high", "type": "mineral", "wikidata_id": "Q23757", "wikidata_description": "sedimentary rocks made of the chemical substance calcium carbonate", "wikipedia_url": "https://en.wikipedia.org/wiki/Limestone", "wikipedia_extract": "Limestone is a type of carbonate sedimentary rock which is the main source of the material lime. It is composed mostly of the minerals calcite and aragonite, which are different crystal forms of calcium carbonate CaCO3. Limestone forms when these minerals precipitate out of water containing dissolved calcium. This can take place through both biological and nonbiological processes, though biological processes, such as the accumulation of corals and shells in the sea, have likely been more important for the last 540 million years. Limestone often contains fossils which provide scientists with information on ancient environments and on the evolution of life. About 20% to 25% of sedimentary rock is carbonate rock, and most of this is limestone."}}, {"canonical_name": "b\u00e9lemnites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "b\u00e9lemnites", "book_id": "epoques_nature_buffon_1778", "name": "b\u00e9lemnites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["b\u00e9lemnites"], "contexts": ["belemnites fossils", "fossil remains of ancient marine animals"]}, {"entity_id": "belemnites", "book_id": "kosmos_humboldt_1845", "name": "Belemnites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["belemnites", "Belemnites"], "contexts": ["fossil cephalopod remains", "extinct marine cephalopods"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "b\u00e9lemnites", "target_book": "kosmos_humboldt_1845", "target_name": "Belemnites", "similarity": 0.935}], "id": 3941, "stable_key": "clu_bafb309142d594a4", "ground_truth": {"modern_name": "belemnite", "confidence": "high", "type": "animal", "note": "Belemnites are an extinct group of marine animals, often found as fossils. The early modern texts likely refer to these fossils rather than live animals.", "wikidata_id": "Q2894293", "wikidata_description": "extinct genus of cephalopods", "wikipedia_url": "https://en.wikipedia.org/wiki/Belemnites%20%28genus%29"}}, {"canonical_name": "nouveau monde", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "nouveau_monde", "book_id": "epoques_nature_buffon_1778", "name": "nouveau monde", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["nouveau monde"], "contexts": ["newly discovered continents", "geographical term for the Americas"]}, {"entity_id": "nueuo_mundo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "nueuo mundo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["nueuo mundo"], "contexts": ["referring to the Americas", "region of sar^aparrilla species"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "nouveau monde", "target_book": "quatro_libros_naturaleza_