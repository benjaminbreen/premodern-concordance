s": [{"entity_id": "seebeck", "book_id": "kosmos_humboldt_1845", "name": "Seebeck", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Seebeck"], "contexts": ["experiments on thermo-magnetic currents"]}, {"entity_id": "m__seebeck", "book_id": "connexion_physical_sciences_somerville_1858", "name": "M. Seebeck", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["M. Seebeck"], "contexts": ["observed heat point variation", "discovery of thermo-electricity"]}, {"entity_id": "seebeck", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Seebeck", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Seebeck"], "contexts": ["discovered thermo-electric currents", "fixed point of maximum heat, discovered heat-electricity relations"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Seebeck", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "M. Seebeck", "similarity": 0.895}, {"source_book": "kosmos_humboldt_1845", "source_name": "Seebeck", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Seebeck", "similarity": 1.0}], "id": 3494, "stable_key": "clu_c1e0d3ca7b3ec133", "ground_truth": {"modern_name": "Augustus Seebeck", "confidence": "high", "type": "person", "birth_year": 1775, "death_year": 1835, "description": "German physicist, known for thermoelectricity experiments.", "wikipedia_extract": "James Prescott Joule (; 24 December 1818 \u2013  11 October 1889) was an English physicist. Joule studied the nature of heat and discovered its relationship to mechanical work. This led to the law of conservation of energy, which in turn led to the development of the first law of thermodynamics. The SI unit of energy, the joule (J), is named after him. He worked with Lord Kelvin to develop an absolute thermodynamic temperature scale, which came to be called the Kelvin scale. Joule also made observations of magnetostriction, and he found the relationship between the current through a resistor and the heat dissipated, which is also called Joule's first law.", "wikipedia_url": "https://en.wikipedia.org/wiki/James_Prescott_Joule"}}, {"canonical_name": "aggregation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "aggregation", "book_id": "kosmos_humboldt_1845", "name": "aggregation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["aggregation"], "contexts": ["state of being collected together"]}, {"entity_id": "aggregation", "book_id": "first_principles_spencer_1862", "name": "aggregation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["aggregation"], "contexts": ["grouping together", "process of coming together"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "aggregation", "target_book": "first_principles_spencer_1862", "target_name": "aggregation", "similarity": 1.0}], "id": 3495, "stable_key": "clu_ea720247fdd61551", "ground_truth": {"modern_name": "Aggregation", "confidence": "high", "type": "concept", "wikidata_id": "Q23007394", "wikidata_description": "act of collecting together physical or conceptual objects"}}, {"canonical_name": "Matheo", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "matheo", "book_id": "historia_medicinal_monardes_1574", "name": "Matheo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Matheo", "Matheo de Gradi", "Matheo filuatico", "Matheo \u017filuatico"], "contexts": ["scholar discussing Iron's temperature", "Matheo filuatico says thus"]}, {"entity_id": "matth_", "book_id": "polyanthea_medicinal", "name": "Matth.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Matth."], "contexts": ["Biblical author, Gospel of Matthew", "author cited"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Matheo", "target_book": "polyanthea_medicinal", "target_name": "Matth.", "similarity": 0.863}], "id": 3496, "stable_key": "clu_e88896b78445c506", "ground_truth": {"modern_name": "Matthew", "confidence": "medium", "type": "person", "description": "Biblical author of the Gospel of Matthew.", "note": "The context 'scholar discussing Iron's temperature' suggests a specific author or physician. However, 'Matheo' and 'Matth.' are common abbreviations and could refer to various individuals, including the Apostle Matthew if a quote is being referenced indirectly.", "wikidata_id": "Q43600", "wikidata_description": "Christian evangelist and apostle"}}, {"canonical_name": "\u017farna", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "\u017farna", "book_id": "historia_medicinal_monardes_1574", "name": "\u017farna", "category": "DISEASE", "subcategory": "CHRONIC", "count": 3, "variants": ["\u017farna"], "contexts": ["skin disease", "skin disease cured by sulphur"]}, {"entity_id": "\u017farna", "book_id": "polyanthea_medicinal", "name": "\u017farna", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["\u017farna"], "contexts": ["scabies, a skin condition", "condition treated by unguent"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "\u017farna", "target_book": "polyanthea_medicinal", "target_name": "\u017farna", "similarity": 0.785}], "id": 3497, "stable_key": "clu_fba14b53dda3486d-3", "ground_truth": {"modern_name": "Scabies", "confidence": "high", "type": "disease", "modern_term": "Scabies", "wikidata_id": "Q167178", "wikidata_description": "human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Scabies", "note": "The early modern term 'itch' encompassed both the symptom of itching and specific conditions like scabies. Given the context of skin conditions and affections, scabies is the most likely specific disease referent.", "wikipedia_extract": "Scabies (, SKAY-beez; also sometimes known as the seven-year itch) is a contagious human skin infestation by the tiny (0.2\u20130.45 mm) mite Sarcoptes scabiei, variety hominis. The word is from Latin: scabere, lit. 'to scratch'. It is a particular public health problem in crowded settings such as care homes, schools, refugee camps, prisons, and hospitals. The most common symptoms are severe itchiness and a pimple-like rash. Occasionally, tiny burrows may appear on the skin from eggs that are about to hatch."}}, {"canonical_name": "orina", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "vrina", "book_id": "historia_medicinal_monardes_1574", "name": "vrina", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["vrina", "Vrina"], "contexts": ["urine, bodily fluid", "urine"]}, {"entity_id": "orina", "book_id": "coloquios_da_orta_1563", "name": "orina", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["orina", "orina branca", "orina vermelha", "orinas"], "contexts": ["bodily fluid", "white urine, sign of poor digestion"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "vrina", "target_book": "coloquios_da_orta_1563", "target_name": "orina", "similarity": 0.894}], "id": 3498, "stable_key": "clu_918915ccbb37ae1e", "ground_truth": {"modern_name": "urine", "confidence": "high", "type": "concept", "note": "While urine is a bodily fluid, its primary significance in early modern medicine was as a diagnostic substance, not as a therapeutic one. Thus, 'concept' is a more fitting type than 'substance'."}}, {"canonical_name": "terra figillada", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "tierra_figilata", "book_id": "historia_medicinal_monardes_1574", "name": "Tierra figilata", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Tierra figilata"], "contexts": ["sealed earth, medicinal clay"]}, {"entity_id": "terra_figillada", "book_id": "polyanthea_medicinal", "name": "terra figillada", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["terra figillada", "terra Sigillada", "terra sigillata"], "contexts": ["ingredient in wound powder", "sealed earth, used externally"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Tierra figilata", "target_book": "polyanthea_medicinal", "target_name": "terra figillada", "similarity": 0.947}], "id": 3499, "stable_key": "clu_02700fd2af7a257d", "ground_truth": {"modern_name": "terra sigillata", "confidence": "high", "type": "mineral", "note": "Also known as 'sealed earth' or medicinal clay, it was a specific type of clay tablet with a seal, used for medicinal purposes.", "wikidata_id": "Q367622", "wikidata_description": "fine red Ancient Roman pottery with glossy surface slips made in specific areas of the Roman Empire"}}, {"canonical_name": "azeitonas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "azeitonas", "book_id": "coloquios_da_orta_1563", "name": "azeitonas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["azeitonas", "azeitona"], "contexts": ["fruit, comparison", "appetite stimulant"]}, {"entity_id": "azeitonas", "book_id": "polyanthea_medicinal", "name": "azeitonas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["azeitonas"], "contexts": ["fruit, olives"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "azeitonas", "target_book": "polyanthea_medicinal", "target_name": "azeitonas", "similarity": 1.0}], "id": 3500, "stable_key": "clu_4067f309771d872b", "ground_truth": {"modern_name": "olives", "confidence": "high", "type": "plant", "linnaean": "Olea europaea", "family": "Oleaceae", "description": "The fruit of the olive tree, used for food and oil.", "wikipedia_extract": "The olive (botanical name Olea europaea, \"European olive\") is a species of subtropical evergreen tree in the family Oleaceae. Originating in Asia Minor, it is abundant throughout the Mediterranean Basin, with wild subspecies in Africa and western Asia; modern cultivars are traced primarily to the Near East, Aegean Sea, and Strait of Gibraltar. The olive is the type species for its genus, Olea, and lends its name to the Oleaceae plant family, which includes lilac, jasmine, forsythia, and ash. The olive fruit is classed botanically as a drupe, similar in structure and function to the cherry or peach. The term oil\u2014now used to describe any viscous water-insoluble liquid\u2014was originally synonymous with olive oil, the liquid fat derived from olives. The olive has deep historical, economic, and cultural significance in the Mediterranean."}}, {"canonical_name": "a\u00e7ucare rosado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "a\u00e7ucare_rosado", "book_id": "coloquios_da_orta_1563", "name": "a\u00e7ucare rosado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 5, "variants": ["a\u00e7ucare rosado", "a\u00e7ucar rosado", "a\u00e7ucare rosado de Alexandria"], "contexts": ["rose sugar preparation", "rose-infused sugar water"]}, {"entity_id": "a\u00e7ucar_rosado_de_alexan", "book_id": "polyanthea_medicinal", "name": "a\u00e7ucar Rosado de Alexan", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["a\u00e7ucar Rosado de Alexan"], "contexts": ["added to decoction for fever"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "a\u00e7ucare rosado", "target_book": "polyanthea_medicinal", "target_name": "a\u00e7ucar Rosado de Alexan", "similarity": 0.886}], "id": 3501, "stable_key": "clu_d4875862e731c782", "ground_truth": {"modern_name": "Rose sugar", "confidence": "high", "type": "substance", "description": "Sugar infused with rose petals or rose water.", "wikipedia_extract": "Redox ( RED-oks,  REE-doks, reduction\u2013oxidation or oxidation\u2013reduction) is a type of chemical reaction in which the oxidation states of the reactants change. Oxidation is the loss of electrons or an increase in the oxidation state, while reduction is the gain of electrons or a decrease in the oxidation state. The oxidation and reduction processes occur simultaneously in the chemical reaction. There are two classes of redox reactions: Electron-transfer \u2013 Only one (usually) electron flows from the atom, ion, or molecule being oxidized to the atom, ion, or molecule that is reduced. This type of redox reaction is often discussed in terms of redox couples and electrode potentials. Atom transfer \u2013 An atom transfers from one substrate to another."}}, {"canonical_name": "Babylonia", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "babylonia", "book_id": "coloquios_da_orta_1563", "name": "Babylonia", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Babylonia"], "contexts": ["location of mines", "common name for Egypt"]}, {"entity_id": "babylonia", "book_id": "polyanthea_medicinal", "name": "Babylonia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Babylonia"], "contexts": ["location of a plague"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Babylonia", "target_book": "polyanthea_medicinal", "target_name": "Babylonia", "similarity": 1.0}], "id": 3502, "stable_key": "clu_088df849a8e0335e", "ground_truth": {"modern_name": "Babylonia", "confidence": "medium", "type": "place", "description": "Ancient region in Mesopotamia; also a common name for Egypt.", "note": "The context suggests both the historical region of Babylonia and its association with Egypt.", "wikipedia_extract": "Babylonia (; Akkadian: \ud808\uddb3\ud808\udd8d\ud808\udc2d\ud808\ude8f\ud808\udda0, m\u0101t Akkad\u012b) was an ancient Akkadian-speaking state and cultural area based on the city of Babylon in central-southern Mesopotamia (present-day Iraq and parts of Syria). It emerged as an Akkadian-populated but Amorite-ruled state c.\u20091894 BC. During the reign of Hammurabi and afterwards, Babylonia was retrospectively called \"the country of Akkad\" (m\u0101t Akkad\u012b in Akkadian), a deliberate archaism in reference to the previous glory of the Akkadian Empire. It was often involved in rivalry with the linguistically related state of Assyria in Upper Mesopotamia, and with Elam to the east. Babylonia briefly became the major power in the region after Hammurabi (fl. c.\u20091792\u20131752 BC middle chronology, or c.\u20091696\u20131654 BC, short chronology) created a short-lived empire, succeeding the earlier Akkadian Empire, Third Dynasty of Ur, and Old Assyrian Empire. The Babylonian Empire rapidly fell apart after the death of Hammurabi and reverted to a small kingdom centered around the city of Babylon."}}, {"canonical_name": "rama", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "rama", "book_id": "coloquios_da_orta_1563", "name": "rama", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["rama", "Rama", "ramo"], "contexts": ["part of a plant", "Hindu deity"]}, {"entity_id": "rami", "book_id": "ricettario_fiorentino_1597", "name": "rami", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["rami", "ramo"], "contexts": ["part of a plant, branches", "part of a plant"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "rama", "target_book": "ricettario_fiorentino_1597", "target_name": "rami", "similarity": 0.887}], "id": 3503, "stable_key": "clu_73ae7b568eafe189", "ground_truth": {"modern_name": "branch", "confidence": "high", "type": "plant", "note": "The terms 'rama' and 'rami' refer to branches or twigs of a plant, a common part of botanical descriptions and medicinal preparations."}}, {"canonical_name": "droga", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "droga", "book_id": "coloquios_da_orta_1563", "name": "droga", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["droga", "Drogas de las \u00edndias"], "contexts": ["benzoin from Siam", "substance that corrupts quickly"]}, {"entity_id": "droghe", "book_id": "ricettario_fiorentino_1597", "name": "Droghe", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Droghe"], "contexts": ["drugs or medicinal substances", "herbs and spices for medicine"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "droga", "target_book": "ricettario_fiorentino_1597", "target_name": "Droghe", "similarity": 0.974}], "id": 3504, "stable_key": "clu_b2b2b0852deb8574", "ground_truth": {"modern_name": "drugs", "confidence": "high", "type": "substance", "description": "Substances, especially medicinal ones, that may be natural or synthetic.", "note": "This term encompasses both medicinal preparations and raw materials like benzoin.", "wikipedia_extract": "A drug is any chemical substance  other than a nutrient or an essential dietary ingredient, which, when administered to a living organism, produces a biological effect. Consumption of drugs can be via inhalation, injection, smoking, ingestion, absorption via a patch on the skin, suppository, or dissolution under the tongue. A pharmaceutical drug, also called a medication or medicine, is a chemical substance used to treat, cure, prevent, or diagnose a disease or to promote well-being. Traditionally drugs were obtained through extraction from medicinal plants, but more recently also by organic synthesis. Pharmaceutical drugs may be used for a limited duration, or on a regular basis for chronic disorders. Pharmaceutical drugs are often classified into drug classes\u2014groups of related drugs that have similar chemical structures, the same mechanism of action (binding to the same biological target), a related mode of action, and that are used to treat the same disease."}}, {"canonical_name": "louro", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "louro", "book_id": "coloquios_da_orta_1563", "name": "louro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["louro"], "contexts": ["tree whose leaf color is compared", "tree resembling cinnamon color"]}, {"entity_id": "louro", "book_id": "polyanthea_medicinal", "name": "louro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["louro"], "contexts": ["laurel, a plant", "laurel"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "louro", "target_book": "polyanthea_medicinal", "target_name": "louro", "similarity": 1.0}], "id": 3505, "stable_key": "clu_f885710f727800bc-3", "ground_truth": {"modern_name": "Bay Laurel", "confidence": "high", "type": "plant", "linnaean": "Laurus nobilis Linnaeus", "family": "Lauraceae", "wikidata_id": "Q26006", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Laurus_nobilis", "wikipedia_extract": "Laurus nobilis  is an aromatic evergreen tree or large shrub with green, glabrous (smooth) leaves. It is in the flowering plant family Lauraceae. According to  Muer, Jahn, & Sauerbier, the stem can be 1 metre in diameter and the tree can be as high as 20 metres. It is native to the Mediterranean region and is used as bay leaf for seasoning in cooking. Its common names include bay tree (esp. United Kingdom), bay laurel, sweet bay, true laurel, Grecian laurel, or simply laurel.", "note": "The reference to 'Laurel' in Monardes' medicinal history, and its general use in natural philosophy, points strongly to the common laurel (Laurus nobilis). The mention of 'cinnamon tree' leaf shape suggests a comparison or confusion, but the primary referent for 'laurel' remains."}}, {"canonical_name": "xilaloes", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "xilaloes", "book_id": "coloquios_da_orta_1563", "name": "xilaloes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["xilaloes", "X\u00edlaloes"], "contexts": ["a substance mentioned in a chapter", "Greek name for woody aloes"]}, {"entity_id": "xiloaloes", "book_id": "polyanthea_medicinal", "name": "xiloaloes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["xiloaloes", "xilo-aloes"], "contexts": ["aloes wood, ingredient in remedy", "ingredient in a medicinal preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "xilaloes", "target_book": "polyanthea_medicinal", "target_name": "xiloaloes", "similarity": 0.909}], "id": 3506, "stable_key": "clu_02ceebb6bfd466fb", "ground_truth": {"modern_name": "aloes wood", "confidence": "high", "type": "plant", "linnaean": "Aquilaria spp.", "family": "Thymelaeaceae", "description": "Aromatic resinous wood used in incense, perfumery, and medicine.", "note": " 'Xilaloes' and 'xiloaloes' are variations of the Greek term for aloes wood.", "wikipedia_extract": "Agarwood, aloeswood, eaglewood, gaharuwood, commonly referred to as oud or oudh (from Arabic: \u0639\u0648\u062f, romanized: \u02bf\u016bd, pronounced [\u0295u\u02d0d]), is a fragrant, dark and resinous wood used in incense, perfume, and small hand carvings. It forms in the heartwood of Aquilaria trees after they become infected with a type of Phaeoacremonium mold, P. parasitica. The tree defensively secretes a resin to combat the fungal infestation. Prior to becoming infected, the heartwood mostly lacks scent, and is relatively light and pale in colouration. However, as the infection advances and the tree produces its fragrant resin as a final option of defense, the heartwood becomes very dense, dark, and saturated with resin. This product is harvested, and most famously referred to in cosmetics under the scent names of oud, oodh or aguru; however, it is also called aloes (not to be confused with the succulent plant genus Aloe), agar (this name, as well, is not to be confused with the edible, algae-derived thickening agent agar agar), as well as gaharu or jinko."}}, {"canonical_name": "freixo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "freixo", "book_id": "coloquios_da_orta_1563", "name": "freixo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["freixo", "freixos"], "contexts": ["tree size comparison", "tree for comparison"]}, {"entity_id": "freixo", "book_id": "polyanthea_medicinal", "name": "freixo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["freixo"], "contexts": ["plant with virtue against viper venom", "ash, its leaves used as remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "freixo", "target_book": "polyanthea_medicinal", "target_name": "freixo", "similarity": 1.0}], "id": 3507, "stable_key": "clu_8feab11fa5ec1929", "ground_truth": {"modern_name": "ash tree", "confidence": "high", "type": "plant", "linnaean": "Fraxinus spp.", "family": "Oleaceae", "description": "A tree with strong wood, whose leaves have medicinal properties.", "note": " 'Freixo' is the Portuguese and Galician word for ash tree.", "wikipedia_extract": "Fraxinus (), commonly called ash, is a genus of plants in the olive and lilac family, Oleaceae, and comprises 45\u201365 species of usually medium-to-large trees, most of which are deciduous (dropping their leaves in autumn), although some subtropical species are evergreen. The genus is widespread throughout much of Europe, Asia, and North America. The leaves are usually opposite, and mostly pinnately compound (divided into leaflets in a feather-like arrangement). The seeds, known as \"keys\", are botanically fruits of the type called samara. Some species are dioecious, having male and female flowers on separate plants. Ash wood is strong and elastic, and used for the handles of tools."}}, {"canonical_name": "Carlos VIII", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "carlos_viii", "book_id": "coloquios_da_orta_1563", "name": "Carlos VIII", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["Carlos VIII"], "contexts": ["King of France who invaded Italy", "invader of Italy"]}, {"entity_id": "carlos_ix_", "book_id": "polyanthea_medicinal", "name": "Carlos IX.", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["Carlos IX."], "contexts": ["King of France during plague", "King of France"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Carlos VIII", "target_book": "polyanthea_medicinal", "target_name": "Carlos IX.", "similarity": 0.848}], "id": 3508, "stable_key": "clu_7a25d170bfb6899a", "ground_truth": {"modern_name": "Charles VIII of France", "confidence": "high", "type": "person", "birth_year": 1470, "death_year": 1498, "description": "King of France, led Italian invasion", "wikidata_id": "Q134452", "wikidata_description": "King of France from 1483 to 1498"}}, {"canonical_name": "lentisco", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "lentisco", "book_id": "coloquios_da_orta_1563", "name": "lentisco", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["lentisco"], "contexts": ["plant for comparison of leaf shape", "plant used for leaf comparison"]}, {"entity_id": "lentisco", "book_id": "ricettario_fiorentino_1597", "name": "lentisco", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["lentisco", "Lentisco", "lenti"], "contexts": ["plant from which Mastice is extracted", "source of oil"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "lentisco", "target_book": "ricettario_fiorentino_1597", "target_name": "lentisco", "similarity": 1.0}], "id": 3509, "stable_key": "clu_6b7d91afeb75cae1", "ground_truth": {"modern_name": "Lentil", "confidence": "medium", "type": "plant", "linnaean": "Lens culinaris", "family": "Fabaceae", "description": "A herbaceous annual legume plant grown for its edible seed.", "note": "Includes related terms for aquatic plants and similar-leafed plants, suggesting broader botanical interest.", "wikipedia_extract": "The lentil (Vicia lens or Lens culinaris) is an annual legume grown for its lens-shaped edible seeds or pulses, also called lentils. It is about 40 cm (16 in) tall, and the seeds grow in pods, usually with two seeds in each. Lentil seeds are used around the world for culinary purposes, most commonly in stews or soups. In cuisines of the Indian subcontinent, where lentils are a staple, split lentils (often with their hulls removed) known as dal are often cooked into a thick curry that is usually eaten with rice or roti. The English word \"lentil\" ultimately derives from the Latin lens ('lentil'). The Latin word is of classical Roman or Latin origin and may be the source of the prominent Roman family name Lentulus, just as the family name \"Cicero\" was derived from the chickpea, Cicer arietinum, and \"Fabia\" (as in Quintus Fabius Maximus) from the fava bean (Vicia faba)."}}, {"canonical_name": "Safira", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "safira", "book_id": "coloquios_da_orta_1563", "name": "Safira", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Safira", "safira"], "contexts": ["sapphire, a type of stone", "gemstone, compared to topaz"]}, {"entity_id": "safira", "book_id": "polyanthea_medicinal", "name": "Safira", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["Safira"], "contexts": ["gemstone", "sapphire, causes poisonous buboes"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Safira", "target_book": "polyanthea_medicinal", "target_name": "Safira", "similarity": 1.0}], "id": 3510, "stable_key": "clu_b7f81552a7ac24d3-2", "ground_truth": {"modern_name": "Sapphire", "confidence": "high", "type": "mineral", "wikidata_id": "Q1767374", "wikidata_description": "butterfly genus in family Lycaenidae", "note": "The spelling 'Saphire' is an archaic variation."}}, {"canonical_name": "agua de canela", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "agua_de_canela", "book_id": "coloquios_da_orta_1563", "name": "agua de canela", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["agua de canela"], "contexts": ["Used to season many dishes"]}, {"entity_id": "agua_de_canela", "book_id": "polyanthea_medicinal", "name": "agua de canela", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["agua de canela", "aguadecanela"], "contexts": ["cinnamon water for moistening vapors", "water infused with cinnamon"]}, {"entity_id": "aguade_canela", "book_id": "polyanthea_medicinal", "name": "aguade canela", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["aguade canela"], "contexts": ["added to remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "agua de canela", "target_book": "polyanthea_medicinal", "target_name": "agua de canela", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "agua de canela", "target_book": "polyanthea_medicinal", "target_name": "aguade canela", "similarity": 0.848}], "id": 3511, "stable_key": "clu_d5da2ca325fd6d22", "ground_truth": {"modern_name": "cinnamon water", "confidence": "high", "type": "substance", "description": "Water infused with the spice of cinnamon, used medicinally and for flavor.", "wikipedia_extract": "Cinnamon is a spice obtained from the inner bark of several tree species from the genus Cinnamomum. Cinnamon is used mainly as an aromatic condiment and flavouring additive in a wide variety of cuisines, in particular sweet and savoury dishes such as biscuits, breakfast cereals, snack foods, bagels, teas, hot chocolate, and traditional foods. The aroma and flavour of cinnamon derive from its essential oil and principal component, cinnamaldehyde, as well as numerous other constituents, including eugenol. Cinnamon is the name for several species of trees and the commercial spice products that some of them produce. All are members of the genus Cinnamomum in the family Lauraceae. Only a few Cinnamomum species are grown commercially for spice."}}, {"canonical_name": "Phu", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "phu", "book_id": "ricettario_fiorentino_1597", "name": "Phu", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["Phu", "Ph\u00f9"], "contexts": ["root used in preparations", "plant name, possibly Valerian"]}, {"entity_id": "phu", "book_id": "polyanthea_medicinal", "name": "Phu", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Phu"], "contexts": ["herb"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Phu", "target_book": "polyanthea_medicinal", "target_name": "Phu", "similarity": 1.0}], "id": 3512, "stable_key": "clu_49c7630b7ebeb97c", "ground_truth": {"modern_name": "Valerian", "confidence": "high", "type": "plant", "linnaean": "Valeriana officinalis", "family": "Valerianaceae", "description": "A fragrant herb with a root used in medicinal preparations.", "note": "Phu is an older name for Valerian, known for its medicinal properties.", "wikipedia_extract": "Valerian (Valeriana officinalis) is an herbaceous perennial flowering plant in the family Caprifoliaceae, native to Europe and southwestern Asia. It is the type species of the genus Valeriana. It grows up to 1.5 m (5 ft) tall, rarely to 2 m (7 ft). The stems are erect, usually unbranched, with pinnately divided leaves up to 20 cm long, the leaflets with irregularly toothed to toothless margins. The flowers are produced from June to August, and are 2.5\u20135 mm diameter with a five-lobed corolla, sweetly scented, pale pink, occasionally white, grouped in both compound and secondary clusters. Three subspecies are accepted by the Plants of the World Online (POWO) database: Valeriana officinalis subsp. officinalis \u2014 throughout most of the range Valeriana officinalis subsp. nemorensis (B.Turk) F.Martini & Soldano \u2014 Italy, northwest Balkans Valeriana officinalis subsp. tenuifolia (Vahl) Sch\u00fcbl. & G.Martens \u2014 central and northern Europe Two other subspecies, not distinguished by POWO, are accepted by some other authors: Valeriana officinalis subsp. collina \u2014 on dry chalk soils Valeriana officinalis subsp. sambucifolia \u2014 on wetter marshy sites It is native from Iceland south to Portugal, north to central Scandinavia, east to European Russia, and southeast to Iran."}}, {"canonical_name": "Ladano", "category": "PLANT", "subcategory": "RESIN", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "ladano", "book_id": "ricettario_fiorentino_1597", "name": "Ladano", "category": "PLANT", "subcategory": "RESIN", "count": 3, "variants": ["Ladano", "LADANO"], "contexts": ["substance discussed", "a resinous liquor from a plant"]}, {"entity_id": "ladano", "book_id": "polyanthea_medicinal", "name": "ladano", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["ladano"], "contexts": ["ingredient in an emplaster", "resin used in liniment"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Ladano", "target_book": "polyanthea_medicinal", "target_name": "ladano", "similarity": 0.545}], "id": 3513, "stable_key": "clu_d4213c8b4ec20d03", "ground_truth": {"modern_name": "Labdanum", "confidence": "high", "type": "plant", "linnaean": "Cistus ladanifer L.", "family": "Cistaceae", "wikidata_id": "Q789800", "wikidata_description": "species of plant"}}, {"canonical_name": "Collo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "collo", "book_id": "ricettario_fiorentino_1597", "name": "Collo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Collo"], "contexts": ["ingredient in a preparation", "neck"]}, {"entity_id": "collo", "book_id": "polyanthea_medicinal", "name": "collo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["collo", "collo da bexiga"], "contexts": ["neck area", "neck"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Collo", "target_book": "polyanthea_medicinal", "target_name": "collo", "similarity": 0.455}], "id": 3514, "stable_key": "clu_3a4e0d2f72226956", "ground_truth": {"modern_name": "Collo", "confidence": "medium", "type": "concept", "note": "This term appears in contexts of 'neck area' and as an ingredient in a preparation. The latter could refer to glue or a similar substance, but the primary context suggests the anatomical neck."}}, {"canonical_name": "aflafetida", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "afla_fetida", "book_id": "ricettario_fiorentino_1597", "name": "Afla fetida", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["Afla fetida"], "contexts": ["fetid resin from the spice trade"]}, {"entity_id": "aflafetida", "book_id": "polyanthea_medicinal", "name": "aflafetida", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["aflafetida", "Affafetida", "Aflafetida", "a\u017f\u017fafetida"], "contexts": ["plant resin used in preparation", "resin used in medicine"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Afla fetida", "target_book": "polyanthea_medicinal", "target_name": "aflafetida", "similarity": 0.504}], "id": 3515, "stable_key": "clu_7b46763b30997406", "ground_truth": {"modern_name": "Asafetida", "confidence": "high", "type": "plant", "linnaean": "Ferula assa-foetida L.", "family": "Apiaceae"}}, {"canonical_name": "Anacardina", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "anacardina", "book_id": "ricettario_fiorentino_1597", "name": "anacardina", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["anacardina"], "contexts": ["anacardine substance"]}, {"entity_id": "anacardina", "book_id": "polyanthea_medicinal", "name": "Anacardina", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 5, "variants": ["Anacardina", "Anacaruina"], "contexts": ["medicinal preparation", "a compound medicine"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "anacardina", "target_book": "polyanthea_medicinal", "target_name": "Anacardina", "similarity": 0.729}], "id": 3516, "stable_key": "clu_12456d0ab6c1dac1", "ground_truth": {"modern_name": "Anacardine", "confidence": "high", "type": "chemical", "note": "Anacardine refers to a substance derived from the cashew tree (Anacardium occidentale), specifically its irritant sap or a preparation made from it. It was known for its medicinal uses, often as an external application. The 'medicinal preparation' subcategory in the original prompt reinforces this.", "wikidata_id": "Q527648", "wikidata_description": "chemical compound"}}, {"canonical_name": "fauces", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "fauces", "book_id": "polyanthea_medicinal", "name": "fauces", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["fauces"], "contexts": ["throat, part of the body", "back of the throat"]}, {"entity_id": "fauces", "book_id": "first_principles_spencer_1862", "name": "fauces", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["fauces"], "contexts": ["part of the throat"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "fauces", "target_book": "first_principles_spencer_1862", "target_name": "fauces", "similarity": 1.0}], "id": 3517, "stable_key": "clu_51e5a9dead6611b6", "ground_truth": {"modern_name": "Pharynx", "confidence": "high", "type": "concept", "note": "The term 'fauces' in classical and early modern anatomy refers to the back of the throat, the opening from the mouth into the pharynx. While 'throat' is a general term, 'pharynx' is the more precise anatomical region.", "wikidata_id": "Q21108585", "wikidata_description": "The biological process whose specific outcome is the progression of a pharynx from an initial condition to its mature state. The pharynx is the part of the digestive system immediately posterior to the mouth."}}, {"canonical_name": "uter", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "uter", "book_id": "polyanthea_medicinal", "name": "uter", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["uter"], "contexts": ["body part, uterus", "female reproductive organ"]}, {"entity_id": "uterus", "book_id": "polyanthea_medicinal", "name": "uterus", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["uterus"], "contexts": ["female reproductive organ"]}, {"entity_id": "uterus", "book_id": "first_principles_spencer_1862", "name": "uterus", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["uterus"], "contexts": ["organ for gestation", "organ for gestation in mammals"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "uter", "target_book": "first_principles_spencer_1862", "target_name": "uterus", "similarity": 0.949}, {"source_book": "polyanthea_medicinal", "source_name": "uterus", "target_book": "first_principles_spencer_1862", "target_name": "uterus", "similarity": 1.0}], "id": 3518, "stable_key": "clu_7b4e9f9abb5f8eb2-2", "ground_truth": {"modern_name": "Uterus", "confidence": "high", "type": "concept", "note": "The Latin term 'uter' clearly refers to the uterus, the female reproductive organ. The variations 'uter' and 'uterus' solidify this identification.", "wikidata_id": "Q9612", "wikidata_description": "major female hormone-responsive reproductive sex organ of most mammals including humans"}}, {"canonical_name": "rebellion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "rebelde", "book_id": "polyanthea_medicinal", "name": "rebelde", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["rebelde"], "contexts": ["disease characteristic"]}, {"entity_id": "rebeldes", "book_id": "polyanthea_medicinal", "name": "rebeldes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["rebeldes"], "contexts": ["rebellious illnesses"]}, {"entity_id": "enfermidade_rebelde", "book_id": "polyanthea_medicinal", "name": "enfermidade rebelde", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["enfermidade rebelde"], "contexts": ["stubborn or resistant illness"]}, {"entity_id": "rebeldiadas", "book_id": "polyanthea_medicinal", "name": "rebeldiadas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["rebeldiadas"], "contexts": ["a type of illness"]}, {"entity_id": "rebellion", "book_id": "first_principles_spencer_1862", "name": "rebellion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["rebellion"], "contexts": ["an act of resistance against authority", "social disorder and uprising"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "rebelde", "target_book": "first_principles_spencer_1862", "target_name": "rebellion", "similarity": 0.96}, {"source_book": "polyanthea_medicinal", "source_name": "rebeldes", "target_book": "first_principles_spencer_1862", "target_name": "rebellion", "similarity": 0.943}, {"source_book": "polyanthea_medicinal", "source_name": "enfermidade rebelde", "target_book": "first_principles_spencer_1862", "target_name": "rebellion", "similarity": 0.914}, {"source_book": "polyanthea_medicinal", "source_name": "rebeldiadas", "target_book": "first_principles_spencer_1862", "target_name": "rebellion", "similarity": 0.909}], "id": 3519, "stable_key": "clu_a633d2d5acc8a840", "ground_truth": {"modern_name": "Refractory disease", "confidence": "high", "type": "disease", "modern_term": "Refractory disease", "note": "The terms 'rebelde', 'rebellion', and 'enfermidade rebelde' refer to illnesses that are difficult to treat or resist conventional remedies, hence 'refractory disease' is the most appropriate modern equivalent."}}, {"canonical_name": "dew", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "dew", "book_id": "connexion_physical_sciences_somerville_1858", "name": "dew", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["Dew", "dew"], "contexts": ["water condensed from air", "condensation of water vapor"]}, {"entity_id": "dew", "book_id": "first_principles_spencer_1862", "name": "dew", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["dew"], "contexts": ["water condensed from the air"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "dew", "target_book": "first_principles_spencer_1862", "target_name": "dew", "similarity": 1.0}], "id": 3520, "stable_key": "clu_abf9c8fc67703848", "ground_truth": {"modern_na