845", "name": "Milan", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Milan"], "contexts": ["city where a\u00ebrolite fell in 1660", "location of a monk struck by a stone"]}, {"entity_id": "mil\u00e3o", "book_id": "polyanthea_medicinal", "name": "Mil\u00e3o", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Mil\u00e3o"], "contexts": ["city where physicians were observed"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Milan", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Milan", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Milan", "target_book": "principles_of_psychology_james_1890", "target_name": "Milano", "similarity": 0.918}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Milan", "target_book": "kosmos_humboldt_1845", "target_name": "Milan", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Milan", "target_book": "polyanthea_medicinal", "target_name": "Mil\u00e3o", "similarity": 0.931}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Milan", "target_book": "principles_of_psychology_james_1890", "target_name": "Milano", "similarity": 0.918}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Milan", "target_book": "kosmos_humboldt_1845", "target_name": "Milan", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Milan", "target_book": "polyanthea_medicinal", "target_name": "Mil\u00e3o", "similarity": 0.931}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Milano", "target_book": "kosmos_humboldt_1845", "target_name": "Milan", "similarity": 0.918}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Milano", "target_book": "polyanthea_medicinal", "target_name": "Mil\u00e3o", "similarity": 0.882}, {"source_book": "kosmos_humboldt_1845", "source_name": "Milan", "target_book": "polyanthea_medicinal", "target_name": "Mil\u00e3o", "similarity": 0.931}], "id": 211, "stable_key": "clu_4ef7f441d45255d4", "ground_truth": {"modern_name": "Milan", "confidence": "high", "type": "place", "description": "Major city in Lombardy, northern Italy.", "wikipedia_extract": "Milan is the regional capital of Lombardy, in northern Italy, and the seat of the Metropolitan City of Milan. It is the second-most populous city in Italy after Rome, with a population of 1.38 million in 2025. The city's wider metropolitan area is the largest in Italy, and the fourth-largest in the European Union, with an estimated population of 6.1 million. Milan is considered Italy's economic capital, and its metropolitan area accounts for about 20% of the country's GDP. Founded around 590 BC by a Celtic tribe, Milan was conquered by the Romans in 222 BC, who Latinized the name of the city into Mediolanum. At the end of the fourth century, it briefly served as capital of the Western Roman Empire."}}, {"canonical_name": "arm", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 17, "members": [{"entity_id": "arms", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "arms", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["arms"], "contexts": ["upper limbs of humans"]}, {"entity_id": "womans_arm", "book_id": "english_physician_1652", "name": "Womans Arm", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Womans Arm"], "contexts": ["body part"]}, {"entity_id": "arm", "book_id": "origin_of_species_darwin_1859", "name": "arm", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["arm"], "contexts": ["part of monkey", "upper limb"]}, {"entity_id": "arm", "book_id": "principles_of_psychology_james_1890", "name": "arm", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 10, "variants": ["arm"], "contexts": ["upper limb", 