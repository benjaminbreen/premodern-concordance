"OTHER_PERSON", "count": 2, "variants": ["smith", "Smith"], "contexts": ["craftsman working with metal", "example individual"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Smith", "target_book": "origin_of_species_darwin_1859", "target_name": "F. Smith", "similarity": 0.884}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Smith", "target_book": "principles_of_psychology_james_1890", "target_name": "Smith", "similarity": 0.698}], "id": 1505, "stable_key": "clu_ecd6ab0ed8fbba80", "ground_truth": {"modern_name": "F. Smith", "confidence": "medium", "type": "person", "description": "Explorer, naturalist, and researcher mentioned in various scientific works.", "note": "Without further context, it is difficult to definitively identify which 'F. Smith' is being referred to, as there were several notable individuals with this name in the period. The description is an aggregation of possible roles based on the context provided.", "wikidata_id": "Q1375075", "wikidata_description": "British entomologist (1805\u20131879)", "wikipedia_url": "https://en.wikipedia.org/wiki/Frederick%20Smith%20%28entomologist%29"}}, {"canonical_name": "Strawberries", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "strawberries", "book_id": "english_physician_1652", "name": "Strawberries", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Strawberries", "Strawberry Plant"], "contexts": ["plant with similar creeping strings", "fruit with medicinal properties"]}, {"entity_id": "strawberry", "book_id": "origin_of_species_darwin_1859", "name": "strawberry", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["strawberry"], "contexts": ["plant that began to vary when gardeners attended"]}, {"entity_id": "strawberry", "book_id": "kosmos_humboldt_1845", "name": "strawberry", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["strawberry"], "contexts": ["plant species in Himalaya"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Strawberries", "target_book": "origin_of_species_darwin_1859", "target_name": "strawberry", "similarity": 0.926}, {"source_book": "english_physician_1652", "source_name": "Strawberries", "target_book": "kosmos_humboldt_1845", "target_name": "strawberry", "similarity": 0.926}, {"source_book": "origin_of_species_darwin_1859", "source_name": "strawberry", "target_book": "kosmos_humboldt_1845", "target_name": "strawberry", "similarity": 1.0}], "id": 1506, "stable_key": "clu_b7767aa8594ec966", "ground_truth": {"modern_name": "Strawberry", "confidence": "high", "type": "plant", "linnaean": "Fragaria x ananassa", "family": "Rosaceae", "description": "A creeping plant producing fruits with medicinal properties, subject to variation.", "note": "Common English name for the fruit and plant.", "wikipedia_extract": "The garden strawberry (or simply strawberry; Fragaria \u00d7 ananassa) is a widely grown hybrid plant cultivated worldwide for its fruit. The genus Fragaria, the strawberries, is in the rose family, Rosaceae. The fruit is appreciated for its aroma, bright red colour, juicy texture, and sweetness. It is eaten either fresh or in prepared foods such as jam, ice cream, and chocolates. Artificial strawberry flavourings and aromas are widely used in commercial products. Botanically, the strawberry is not a berry, but an aggregate accessory fruit."}}, {"canonical_name": "Rhine", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "rhine", "book_id": "english_physician_1652", "name": "Rhine", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Rhine"], "contexts": ["region of Count Frederick"]}, {"entity_id": "rhine", "book_id": "origin_of_species_darwin_1859", "name": "Rhine", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Rhine"], "contexts": ["river with evidence of land level changes", "river with geological changes"]}, {"entity_id": "rhine", "book_id": "kosmos_humboldt_1845", "name": "Rhine", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Rhine"], "contexts": ["river valley in Germany", "river forming fissures"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Rhine", "target_book": "origin_of_species_darwin_1859", "target_name": "Rhine", "similarity": 0.839}, {"source_book": "english_physician_1652", "source_name": "Rhine", "target_book": "kosmos_humboldt_1845", "target_name": "Rhine", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Rhine", "target_book": "kosmos_humboldt_1845", "target_name": "Rhine", "similarity": 0.839}], "id": 1507, "stable_key": "clu_ad9c8480e298255f", "ground_truth": {"modern_name": "Rhine River", "confidence": "high", "type": "place", "description": "Major European river, important for trade, geography, and geology.", "wikipedia_extract": "The Rhine ( RYNE) is one of the major rivers of Europe. The river begins in the Swiss canton of Graub\u00fcnden in the southeastern Swiss Alps. It forms part of the Swiss-Liechtenstein border, then part of the Swiss-Austrian border. From Lake Constance downstream, it forms part of the Swiss-German border. After that the Rhine defines much of the Franco-German border. It then flows in a mostly northerly direction through the German Rhineland."}}, {"canonical_name": "Cook", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "cook", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cook", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Cook"], "contexts": ["explorer", "captain and navigator"]}, {"entity_id": "cook", "book_id": "kosmos_humboldt_1845", "name": "Cook", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Cook"], "contexts": ["explorer of second voyage", "early voyager"]}, {"entity_id": "cook", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cook", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Cook"], "contexts": ["led first voyage for observation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cook", "target_book": "kosmos_humboldt_1845", "target_name": "Cook", "similarity": 0.791}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cook", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cook", "similarity": 0.791}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cook", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cook", "similarity": 1.0}], "id": 1508, "stable_key": "clu_f8c379c352033b06", "ground_truth": {"modern_name": "James Cook", "confidence": "high", "type": "person", "birth_year": 1728, "death_year": 1779, "description": "British explorer, navigator, cartographer, and captain in the Royal Navy.", "wikidata_id": "Q7324", "wikidata_description": "British explorer, cartographer and naval officer (1728\u20131779)"}}, {"canonical_name": "agua do mar", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "mare", "book_id": "english_physician_1652", "name": "Mare", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Mare"], "contexts": ["animal listed with numbers"]}, {"entity_id": "mare", "book_id": "origin_of_species_darwin_1859", "name": "mare", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["mare"], "contexts": ["female horse used in a cross", "female horse"]}, {"entity_id": "agua_do_mar", "book_id": "polyanthea_medicinal", "name": "agua do mar", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["agua do mar"], "contexts": ["water used for healing soldiers", "used for baths"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Mare", "target_book": "origin_of_species_darwin_1859", "target_name": "mare", "similarity": 0.637}, {"source_book": "english_physician_1652", "source_name": "Mare", "target_book": "polyanthea_medicinal", "target_name": "agua do mar", "similarity": 0.893}], "id": 1509, "stable_key": "clu_d4797be5c7ad162b-4", "ground_truth": {"modern_name": "Horse", "confidence": "high", "type": "animal", "note": "The phrase 'agua do mar' (sea water) in the context of 'animal listed with numbers' and 'water used for healing soldiers' is a misinterpretation or OCR error. The surrounding English texts and the specific mention of 'Mare' (a mare, or female horse) strongly indicate the referent is 'horse'. The 'animal listed with numbers' context might refer to breeds or classifications, and 'female horse used in a cross' is a direct biological reference.", "wikidata_id": "", "wikidata_description": "domesticated four-footed mammal from the equine family", "wikipedia_url": "https://en.wikipedia.org/wiki/Horse", "wikipedia_extract": "The horse (Equus ferus caballus) is a domesticated, one-toed, hoofed mammal. It belongs to the taxonomic family Equidae and is one of two extant subspecies of Equus ferus. The horse has evolved over the past 45 to 55 million years from a small multi-toed creature, Eohippus, into the large single-toed animal of today, originally in North America. Humans began domesticating horses around 4000 BCE in Central Asia, and their domestication is believed to have been widespread by 3000 BCE. Horses in the subspecies caballus are domesticated, although some domesticated populations live in the wild as feral horses. These feral populations are not true wild horses, which are horses that have never been domesticated.", "linnaean": "Equus caballus", "family": "Equidae", "description": "A domesticated mammal with hooves, widely used by humans."}}, {"canonical_name": "alpine", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "alpine", "book_id": "origin_of_species_darwin_1859", "name": "alpine", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Alpine", "alpine"], "contexts": ["high mountain regions", "referring to species from high mountains"]}, {"entity_id": "alpine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "alpine", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["alpine"], "contexts": ["Alpine limestone"]}, {"entity_id": "alpine", "book_id": "kosmos_humboldt_1845", "name": "Alpine", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Alpine"], "contexts": ["mountainous region"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "alpine", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "alpine", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "alpine", "target_book": "kosmos_humboldt_1845", "target_name": "Alpine", "similarity": 0.912}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "alpine", "target_book": "kosmos_humboldt_1845", "target_name": "Alpine", "similarity": 0.912}], "id": 1510, "stable_key": "clu_454b2645e6f40943", "ground_truth": {"modern_name": "Alps", "confidence": "high", "type": "place", "description": "Major European mountain range, notable for its arctic fauna and flora.", "wikipedia_extract": "The Alps () are some of the highest and most extensive mountain ranges in Europe, stretching approximately 1,200 km (750 mi) across eight Alpine countries (from west to east): Monaco, France, Switzerland, Italy, Liechtenstein, Germany, Austria, Slovenia, and Hungary. The Alpine arch extends from Nice on the western Mediterranean to Trieste on the Adriatic and Vienna at the beginning of the Pannonian Basin. The mountains were formed over tens of millions of years as the African and Eurasian tectonic plates collided. Extreme shortening  caused by the event resulted in marine sedimentary rocks rising by thrusting and folding into high mountain peaks such as Mont Blanc and the Matterhorn. Mont Blanc spans the French-Italian border, and at 4,809 m (15,778 ft) is the highest mountain in the Alps. The Alpine region area contains 82 peaks higher than 4,000 m (13,000 ft)."}}, {"canonical_name": "Fries", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "fries", "book_id": "origin_of_species_darwin_1859", "name": "Fries", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Fries"], "contexts": ["naturalist remarking on plant differences", "naturalist remarking on species clustering"]}, {"entity_id": "fries", "book_id": "kosmos_humboldt_1845", "name": "Fries", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Fries"], "contexts": ["author of 'Vorlesungen uber die Sternkunde'"]}, {"entity_id": "fryas", "book_id": "polyanthea_medicinal", "name": "Fryas", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Fryas"], "contexts": ["author of a text", "author of Compend.admir.virtut."]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Fries", "target_book": "kosmos_humboldt_1845", "target_name": "Fries", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Fries", "target_book": "polyanthea_medicinal", "target_name": "Fryas", "similarity": 0.862}, {"source_book": "kosmos_humboldt_1845", "source_name": "Fries", "target_book": "polyanthea_medicinal", "target_name": "Fryas", "similarity": 0.862}], "id": 1511, "stable_key": "clu_34dbe3755c123fbb", "ground_truth": {"modern_name": "Emil von Fries", "confidence": "medium", "type": "person", "description": "Naturalist and astronomer, author of astronomical lectures.", "note": "The exact historical figure 'Fries' is ambiguous, but given the context of naturalism and astronomy in Humboldt and Darwin's works, Emil von Fries (1846-1901), a botanist and astronomer, is a plausible candidate, although the specific astronomical text mentioned is not immediately identifiable. 'Fryas' is likely a variant spelling or OCR error."}}, {"canonical_name": "Edward Forbes", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "edward_forbes", "book_id": "origin_of_species_darwin_1859", "name": "Edward Forbes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Edward Forbes"], "contexts": ["admirable pal\u00e6ontologist", "insisted islands connected to continents"]}, {"entity_id": "professor_edward_forbes", "book_id": "kosmos_humboldt_1845", "name": "Professor Edward Forbes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Professor Edward Forbes"], "contexts": ["professor and scientific friend"]}, {"entity_id": "edward_forbes", "book_id": "kosmos_humboldt_1845", "name": "Edward Forbes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Edward Forbes"], "contexts": ["Professor discussing origin and diffusion of flora"]}, {"entity_id": "edward_forbes", "book_id": "first_principles_spencer_1862", "name": "Edward Forbes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Edward Forbes"], "contexts": ["described naturalists examining animals as skins"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Edward Forbes", "target_book": "kosmos_humboldt_1845", "target_name": "Professor Edward Forbes", "similarity": 0.919}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Edward Forbes", "target_book": "kosmos_humboldt_1845", "target_name": "Edward Forbes", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Edward Forbes", "target_book": "first_principles_spencer_1862", "target_name": "Edward Forbes", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Professor Edward Forbes", "target_book": "first_principles_spencer_1862", "target_name": "Edward Forbes", "similarity": 0.919}, {"source_book": "kosmos_humboldt_1845", "source_name": "Edward Forbes", "target_book": "first_principles_spencer_1862", "target_name": "Edward Forbes", "similarity": 1.0}], "id": 1512, "stable_key": "clu_0263d31e3ab78655-2", "ground_truth": {"modern_name": "Edward Forbes", "confidence": "high", "type": "person", "description": "A naturalist and geologist, known for his conclusions on biogeography.", "note": "Distinguished from Forbes Winslow, a different author.", "wikipedia_extract": "Edward Forbes FRS, FGS (12 February 1815 \u2013 18 November 1854) was a Manx naturalist. In 1846, he proposed that the distributions of montane plants and animals had been compressed downslope, and some oceanic islands connected to the mainland, during the recent ice age. This mechanism, which was the first natural explanation to explain the distributions of the same species on now-isolated islands and mountain tops, was discovered independently by Charles Darwin, who credited Forbes with the idea. He also incorrectly deduced the so-called azoic hypothesis, that life under the sea would decline to the point that no life forms could exist below a certain depth. Forbes was born at Douglas in the Isle of Man. His father was a well-to-do banker.", "birth_year": 1815, "death_year": 1854}}, {"canonical_name": "organic change", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "organic_change", "book_id": "origin_of_species_darwin_1859", "name": "organic change", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["organic change"], "contexts": ["alteration in living organisms", "measure of time in fossil record"]}, {"entity_id": "organic_modification", "book_id": "principles_of_psychology_james_1890", "name": "organic modification", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic modification"], "contexts": ["physical change in brain tissue"]}, {"entity_id": "organic_changes", "book_id": "first_principles_spencer_1862", "name": "organic changes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["organic changes"], "contexts": ["bodily transformations", "changes in living organisms"]}, {"entity_id": "organic_change", "book_id": "first_principles_spencer_1862", "name": "organic change", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic change"], "contexts": ["changes in tissues related to life"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "organic change", "target_book": "principles_of_psychology_james_1890", "target_name": "organic modification", "similarity": 0.906}, {"source_book": "origin_of_species_darwin_1859", "source_name": "organic change", "target_book": "first_principles_spencer_1862", "target_name": "organic changes", "similarity": 0.969}, {"source_book": "origin_of_species_darwin_1859", "source_name": "organic change", "target_book": "first_principles_spencer_1862", "target_name": "organic change", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "organic modification", "target_book": "first_principles_spencer_1862", "target_name": "organic change", "similarity": 0.906}], "id": 1513, "stable_key": "clu_f61cf96cef849460-3", "ground_truth": {"modern_name": "Evolution", "confidence": "high", "type": "concept", "note": "The overwhelming frequency of 'Evolution' in Spencer's and James's works, along with the contexts 'biological change' and 'development across animal species,' clearly points to the scientific concept of evolution.", "wikidata_id": "Q4038411", "wikidata_description": "monthly scientific journal", "wikipedia_url": "https://en.wikipedia.org/wiki/Evolution", "wikipedia_extract": "Evolution is the change in the heritable characteristics of biological populations over successive generations. It occurs when evolutionary processes such as genetic drift and natural selection act on genetic variation, resulting in certain characteristics becoming more or less common within a population over successive generations. The process of evolution has given rise to biodiversity at every level of biological organisation. The scientific theory of evolution by natural selection was conceived independently by two British naturalists, Charles Darwin and Alfred Russel Wallace, in the mid-19th century as an explanation for why organisms are adapted to their physical and biological environments. The theory was first set out in detail in Darwin's book On the Origin of Species. Evolution by natural selection is established by observable facts about living organisms: (1) more offspring are often produced than can possibly survive; (2) traits vary among individuals with respect to their morphology, physiology, and behaviour; (3) different traits confer different rates of survival and reproduction (differential fitness); and (4) traits can be passed from generation to generation (heritability of fitness)."}}, {"canonical_name": "Azara", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "azara", "book_id": "origin_of_species_darwin_1859", "name": "Azara", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Azara"], "contexts": ["scholar who studied animals in Paraguay", "on flies destroying cattle"]}, {"entity_id": "azara", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Azara", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Azara"], "contexts": ["created map of Paraguay", "geographer"]}, {"entity_id": "azara", "book_id": "historia_medicinal_monardes_1574", "name": "Azara", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Azara", "Azarauio"], "contexts": ["ancient medical authority"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Azara", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Azara", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Azara", "target_book": "historia_medicinal_monardes_1574", "target_name": "Azara", "similarity": 0.585}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Azara", "target_book": "historia_medicinal_monardes_1574", "target_name": "Azara", "similarity": 0.585}], "id": 1514, "stable_key": "clu_66f148d51f6b41dc", "ground_truth": {"modern_name": "F\u00e9lix de Azara", "confidence": "high", "type": "person", "birth_year": 1742, "death_year": 1821, "description": "Naturalist, geographer, and military engineer in South America.", "note": "While Monardes' 'Historia Medicinal' mentions ancient authorities, the strong linkage of 'Azara' with studies in Paraguay and natural history in Humboldt and Darwin's works points to F\u00e9lix de Azara.", "wikidata_id": "Q471014", "wikidata_description": "Spanish scientist (1742-1821)", "wikipedia_url": "https://en.wikipedia.org/wiki/F%C3%A9lix%20de%20Azara", "wikipedia_extract": "F\u00e9lix de Azara y Perera (18 May 1742 \u2013 20 October 1821) was a Spanish military officer, naturalist, and engineer. F\u00e9lix de Azara y Perera was born on 18 May 1746 in Barbu\u00f1ales, Aragon. He joined the army and attended a Spanish military academy. He was commissioned as an engineer, distinguishing himself on various expeditions. He spent the next thirteen years of his life in the military and rose to the rank of brigadier general in the Spanish Army. In 1777, Spain and Portugal signed the Treaty of San Ildefonso."}}, {"canonical_name": "organic forms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "organic_forms", "book_id": "origin_of_species_darwin_1859", "name": "organic forms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["organic forms"], "contexts": ["new types of living organisms", "living organisms with defined structures"]}, {"entity_id": "organic_forms", "book_id": "kosmos_humboldt_1845", "name": "organic forms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic forms"], "contexts": ["structures of plants"]}, {"entity_id": "organic_form", "book_id": "first_principles_spencer_1862", "name": "organic form", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["organic form"], "contexts": ["structure of living things", "shape of living organisms"]}, {"entity_id": "organic_forms", "book_id": "first_principles_spencer_1862", "name": "organic forms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["organic forms"], "contexts": ["shapes of living things", "shapes and structures of living things"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "organic forms", "target_book": "kosmos_humboldt_1845", "target_name": "organic forms", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "organic forms", "target_book": "first_principles_spencer_1862", "target_name": "organic form", "similarity": 0.935}, {"source_book": "origin_of_species_darwin_1859", "source_name": "organic forms", "target_book": "first_principles_spencer_1862", "target_name": "organic forms", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "organic forms", "target_book": "first_principles_spencer_1862", "target_name": "organic form", "similarity": 0.935}, {"source_book": "kosmos_humboldt_1845", "source_name": "organic forms", "target_book": "first_principles_spencer_1862", "target_name": "organic forms", "similarity": 1.0}], "id": 1515, "stable_key": "clu_8e67197c740e571e", "ground_truth": {"modern_name": "Organic form", "confidence": "high", "type": "concept", "wikidata_id": "Q7101850", "wikidata_description": "", "wikipedia_url": "https://en.wikipedia.org/wiki/Organic%20form", "wikipedia_extract": "In romantic literature, a work has organic form if the structure has originated from the materials and subjects used by the author. Using the organic metaphor, the structure is seen to grow as a plant. It stands in contrast to a mechanical form, a work which has been produced in accordance with artificial rules. The lack of rules in Shakespeare's works led some critics to claim that they lacked form; Samuel Taylor Coleridge leapt to his defence with the concept of organic form. Coleridge, an English poet, philosopher, literary critic, and founder of the Romantic movement, suggested that the concept of organic form meant that a poem or literary piece was shaped, rather than structured, from within. The use of the form allowed a piece to uniquely develop itself as it unfolded, and ultimately revealed an emphasis on the whole outcome of the piece, including the connections of each development to each other."}}, {"canonical_name": "Matteucci", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "matteuchi", "book_id": "origin_of_species_darwin_1859", "name": "Matteuchi", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Matteuchi"], "contexts": ["asserted Rays do not discharge electricity", "on electric organs of rays"]}, {"entity_id": "matteuci", "book_id": "kosmos_humboldt_1845", "name": "Matteuci", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Matteuci"], "contexts": ["provided depth measurement"]}, {"entity_id": "matteucci", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Matteucci", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Matteucci"], "contexts": ["proved intervening substance is polarized", "experiment with needle of bismuth"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Matteuchi", "target_book": "kosmos_humboldt_1845", "target_name": "Matteuci", "similarity": 0.877}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Matteuchi", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Matteucci", "similarity": 0.854}, {"source_book": "kosmos_humboldt_1845", "source_name": "Matteuci", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Matteucci", "similarity": 0.847}], "id": 1516, "stable_key": "clu_7100f4b030a955a5", "ground_truth": {"modern_name": "Carlo Matteucci", "confidence": "high", "type": "person", "birth_year": 1811, "death_year": 1868, "description": "Italian physicist, studied electricity and nervous system.", "wikidata_id": "Q280250", "wikidata_description": "Italian politician and physicist (1811\u20131868)", "wikipedia_url": "https://en.wikipedia.org/wiki/Carlo%20Matteucci", "wikipedia_extract": "Carlo Matteucci (20 June 1811 \u2013 24 June 1868) was an Italian physicist and neurophysiologist who was a pioneer in the study of bioelectricity. Carlo Matteucci was born at Forl\u00ec, in the province of Romagna, to Vincenzo Matteucci, a physician, and Chiara Folfi. He studied mathematics at the University of Bologna from 1825 to 1828, receiving his doctorate in 1829. From 1829 to 1831, he studied at the \u00c9cole Polytechnique in Paris, France. Upon returning to Italy, Matteucci studied at Bologna (1832), Florence, Ravenna (1837) and Pisa. He established himself as the head of the laboratory of the Hospital of Ravenna and became a professor of physics at the local college."}}, {"canonical_name": "strains", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "strain", "book_id": "origin_of_species_darwin_1859", "name": "strain", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["strain"], "contexts": ["sub-group within a breed"]}, {"entity_id": "strain", "book_id": "principles_of_psychology_james_1890", "name": "strain", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["strain"], "contexts": ["feeling of the strain of our inward attentiveness", "feeling of tension"]}, {"entity_id": "strains", "book_id": "first_principles_spencer_1862", "name": "strains", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["strains"], "contexts": ["forces exerted by muscles", "feeling of tension or effort"]}, {"entity_id": "strain", "book_id": "first_principles_spencer_1862", "name": "strain", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["strain"], "contexts": ["deformation caused by force"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "strain", "target_book": "principles_of_psychology_james_1890", "target_name": "strain", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "strain", "target_book": "first_principles_spencer_1862", "target_name": "strains", "similarity": 0.877}, {"source_book": "origin_of_species_darwin_1859", "source_name": "strain", "target_book": "first_principles_spencer_1862", "target_name": "strain", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "strain", "target_book": "first_principles_spencer_1862", "target_name": "strains", "similarity": 0.877}, {"source_book": "principles_of_psychology_james_1890", "source_name": "strain", "target_book": "first_principles_spencer_1862", "target_name": "strain", "similarity": 1.0}], "id": 1517, "stable_key": "clu_dab722e8c3851039", "ground_truth": {"modern_name": "Strain", "confidence": "medium", "type": "concept", "note": "Contexts suggest both biological (breed) and physical/psychological (effort) meanings."}}, {"canonical_name": "ganglia", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "ganglion", "book_id": "origin_of_species_darwin_1859", "name": "ganglion", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["ganglion"], "contexts": ["nerve cell cluster"]}, {"entity_id": "ganglia", "book_id": "principles_of_psychology_james_1890", "name": "ganglia", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["ganglia"], "contexts": ["clusters of nerve cell bodies"]}, {"entity_id": "ganglia", "book_id": "first_principles_spencer_1862", "name": "ganglia", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["ganglia"], "contexts": ["clusters of nerve cells", "nerve cell clusters"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "ganglion", "target_book": "principles_of_psychology_james_1890", "target_name": "ganglia", "similarity": 0.95}, {"source_book": "origin_of_species_darwin_1859", "source_name": "ganglion", "target_book": "first_principles_spencer_1862", "target_name": "ganglia", "similarity": 0.95}, {"source_book": "principles_of_psychology_james_1890", "source_name": "ganglia", "target_book": "first_principles_spencer_1862", "target_name": "ganglia", "similarity": 1.0}], "id": 1518, "stable_key": "clu_6e71595054f7cf6b", "ground_truth": {"modern_name": "Ganglion", "confidence": "high", "type": "concept", "wikidata_id": "Q5521151", "wikidata_description": "Human disease"}}, {"canonical_name": "Cornea", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "cornea", "book_id": "origin_of_species_darwin_1859", "name": "cornea", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["cornea"], "contexts": ["outer transparent layer of eye"]}, {"entity_id": "cornea", "book_id": "principles_of_psychology_james_1890", "name": "cornea", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["cornea"], "contexts": ["transparent outer layer of eye"]}, {"entity_id": "cornea", "book_id": "polyanthea_medicinal", "name": "Cornea", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["Cornea"], "contexts": ["third tunic of the eye", "part of the eye affected by Sugilla\u00e7a\u014d"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "cornea", "target_book": "principles_of_psychology_james_1890", "target_name": "cornea", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "cornea", "target_book": "polyanthea_medicinal", "target_name": "Cornea", "similarity": 0.963}, {"source_book": "principles_of_psychology_james_1890", "source_name": "cornea", "target_book": "polyanthea_medicinal", "target_name": "Cornea", "similarity": 0.963}], "id": 1519, "stable_key": "clu_c63737c32523f349", "ground_truth": {"modern_name": "cornea", "confidence": "high", "type": "anatomy", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Cornea", "wikipedia_extract": "The cornea is the transparent front part of the eyeball which covers the iris, pupil, and anterior chamber. Along with the anterior chamber and lens, the cornea refracts light, accounting for approximately two-thirds of the eye's total optical power. In humans, the refractive power of the cornea is approximately 43 dioptres. The cornea can be reshaped by surgical procedures such as LASIK. While the cornea contributes most of the eye's focusing power, its focus is fixed. Accommodation (the refocusing of light to better view near objects) is accomplished by changing the geometry of the lens."}}, {"canonical_name": "Marine plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "marine_productions", "book_id": "origin_of_species_darwin_1859", "name": "marine productions", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["marine productions"], "contexts": ["organisms living in the sea"]}, {"entity_id": "cellular_marine_plants", "book_id": "kosmos_humboldt_1845", "name": "cellular marine plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cellular marine plants"], "contexts": ["simple aquatic plants"]}, {"entity_id": "marine_plants", "book_id": "kosmos_humboldt_1845", "name": "marine plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["marine plants"], "contexts": ["plants found in chalk strata"]}, {"entity_id": "marine_plants", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Marine plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Marine Plants", "Marine plants"], "contexts": ["plants growing in the sea", "plants distributed in the sea"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "marine productions", "target_book": "kosmos_humboldt_1845", "target_name": "marine plants", "similarity": 0.881}, {"source_book": "origin_of_species_darwin_1859", "source_name": "marine productions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Marine plants", "similarity": 0.881}, {"source_book": "kosmos_humboldt_1845", "source_name": "cellular marine plants", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Marine plants", "similarity": 0.899}, {"source_book": "kosmos_humboldt_1845", "source_name": "marine plants", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Marine plants", "similarity": 0.989}], "id": 1520, "stable_key": "clu_c754bc95a14fd5ef", "ground_truth": {"modern_name": "Marine flora", "confidence": "medium", "type": "plant", "note": "While 'Marine plants' is the most direct, 'marine productions' and 'cellular marine plants' suggest a broader inclusion. 'Balis maritima' could be a specific species, but the cluster is broad.", "wikidata_id": "Q111240775", "wikidata_description": "plants that live in marine habitats", "wikipedia_url": "https://en.wikipedia.org/wiki/Marine%20plant", "wikipedia_extract": "Marine primary production is the chemical synthesis in the ocean of organic compounds from atmospheric or dissolved carbon dioxide. It principally occurs through the process of photosynthesis, which uses light as its source of energy, but it also occurs through chemosynthesis, which uses the oxidation or reduction of inorganic chemical compounds as its source of energy. Almost all life on Earth relies directly or indirectly on primary production. The organisms responsible for primary production are called primary producers or autotrophs. Most marine primary production is generated by a diverse collection of marine microorganisms called algae and cyanobacteria. Together these form the principal primary producers at the base of the ocean food chain and produce half of the world's oxygen."}}, {"canonical_name": "serpientes", "category": "ANIMAL", "subcategory": "REPTILE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "serpientes", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "serpientes", "category": "ANIMAL", "subcategory": "REPTILE", "count": 5, "variants": ["serpientes"], "contexts": ["creatures whose bites are treated by coztic mecapatli", "bites of snakes"]}, {"entity_id": "serpens", "book_id": "relation_historique_humboldt_vol3_1825", "name": "serpens", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["serpens"], "contexts": ["frequent animals in Turbaco"]}, {"entity_id": "serpientes", "book_id": "historia_medicinal_monardes_1574", "name": "serpientes", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["serpientes"], "contexts": ["venomous animals"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "serpientes", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "serpens", "similarity": 0.936}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "serpientes", "target_book": "historia_medicinal_monardes_1574", "target_name": "serpientes", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "serpens", "target_book": "historia_medicinal_monardes_1574", "target_name": "serpientes", "similarity": 0.936}], "id": 1521, "stable_key": "clu_dd37050e9c26b96c", "ground_truth": {"modern_name": "Snakes", "confidence": "high", "type": "animal", "note": "The term 'serpientes' is the plural of snake in Spanish and Latin, and the context of venom and bites confirms this identification.", "wikidata_id": "Q2102", "wikidata_description": "limbless, scaly, elongate reptile", "wikipedia_url": "https://en.wikipedia.org/wiki/Snake"}}, {"canonical_name": "complexi\u00f3n", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "complexi\u00f3n", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "complexi\u00f3n", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["complexi\u00f3n"], "contexts": ["quality of the root", "temperament or constitution of a substance"]}, {"entity_id": "complexiones", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "complexiones", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["complexiones"], "contexts": ["bodily humors and temperaments", "bodily constitutions"]}, {"entity_id": "complexionen", "book_id": "principles_of_psychology_james_1890", "name": "Complexionen", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Complexionen"], "contexts": ["complexions or combinations (German)"]}, {"entity_id": "complexion", "book_id": "historia_medicinal_monardes_1574", "name": "complexion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["complexion"], "contexts": ["bodily constitution"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "complexi\u00f3n", "target_book": "historia_medicinal_monardes_1574", "target_name": "complexion", "similarity": 0.987}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "complexiones", "target_book": "principles_of_psychology_james_1890", "target_name": "Complexionen", "similarity": 0.909}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "complexiones", "target_book": "historia_medicinal_monardes_1574", "target_name": "complexion", "similarity": 0.901}], "id": 1522, "stable_key": "clu_80016205a6239302", "ground_truth": {"modern_name": "Temperament", "confidence": "high", "type": "concept", "note": "The term 'complexi\u00f3n' in Spanish and Portuguese medical texts of this period refers to the humoral theory of temperaments and bodily humors, as well as a general 'constitution' or 'complexion'.", "wikidata_id": "Q80157", "wikidata_description": "term used to indicate the mixture of the innate aspects of the personality", "wikipedia_url": "https://en.wikipedia.org/wiki/Temperament"}}, {"canonical_name": "rios", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "rios", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "rios", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["rios"], "contexts": ["rivers", "rivers crossed by cats"]}, {"entity_id": "rios", "book_id": "historia_medicinal_monardes_1574", "name": "rios", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["rios", "Rios"], "contexts": ["waterways created from dry fields", "rivers, bodies of water"]}, {"entity_id": "rios", "book_id": "coloquios_da_orta_1563", "name": "rios", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["rios"], "contexts": ["geographic feature"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "rios", "target_book": "historia_medicinal_monardes_1574", "target_name": "rios", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "rios", "target_book": "coloquios_da_orta_1563", "target_name": "rios", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "rios", "target_book": "coloquios_da_orta_1563", "target_name": "rios", "similarity": 1.0}], "id": 1523, "stable_key": "clu_abebe06cf2e7ff3c-3", "ground_truth": {"modern_name": "River", "confidence": "high", "type": "place", "country": "Multiple", "note": "The term 'rivi\u00e8re' is French for 'river', and the contexts clearly refer to natural waterways. The specific location is not identifiable from the provided information.", "wikidata_id": "Q15799", "wikidata_description": "Argentine professional sports club based in Buenos Aires", "wikipedia_url": "https://en.wikipedia.org/wiki/Club%20Atl%C3%A9tico%20River%20Plate", "wikipedia_extract": "Club Atl\u00e9tico River Plate (CARP) (Spanish pronunciation: [\u02c8klu\u03b2 a\u02c8tletiko \u02c8ri\u03b2er \u02c8pleit]) is an Argentine professional sports club based in the Belgrano neighborhood of Buenos Aires. Founded in 1901, the club is named after the English-language name for the city's estuary, R\u00edo de la Plata. River's home stadium, the Monumental, is the largest in South America. River had the highest average home attendance of any association football club in the world in 2023 with 84,567. With more than 350,000 members at the end of 2023, River is one of the largest sports clubs by membership. It repeated this achievement in 2024 and 2025."}}, {"canonical_name": "nabo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "nabo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "nabo", "category": "PLANT", "subcategory": "ROOT", "count": 2, "variants": ["nabo"], "contexts": ["smells and tastes like turnip", "plant similar to another"]}, {"entity_id": "nabo", "book_id": "coloquios_da_orta_1563", "name": "nabo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["nabo", "nabos"], "contexts": ["turnip, a vegetable", "vegetable cut by a knife"]}, {"entity_id": "naboca", "book_id": "polyanthea_medicinal", "name": "naboca", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["naboca"], "contexts": ["root of pellitory"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "nabo", "target_book": "coloquios_da_orta_1563", "target_name": "nabo", "similarity": 0.853}, {"source_book": "coloquios_da_orta_1563", "source_name": "nabo", "target_book": "polyanthea_medicinal", "target_name": "naboca", "similarity": 0.91}], "id": 1524, "stable_key": "clu_f6d85d56e878359a", "ground_truth": {"modern_name": "Turnips", "confidence": "high", "type": "plant", "linnaean": "Brassica rapa subsp. rapa", "family": "Brassicaceae", "description": "A root vegetable widely cultivated and used in food and remedies.", "wikipedia_extract": "The turnip or white turnip (Brassica rapa subsp. rapa) is a root vegetable commonly grown in temperate climates worldwide for its white, fleshy taproot. Small, tender varieties are grown for human consumption, while larger varieties are grown as feed for livestock. The name turnip \u2013 used in many regions \u2013 may also be used to refer to rutabaga (or neep or swede), which is a different but related vegetable. The origin of the word turnip is uncertain, though it is hypothesised that it could be a compound of turn as in turned/rounded on a lathe and neep, derived from Latin napus, the word for the plant. According to An Universal Etymological English Dictionary (1721), turn refers to \"round napus to distinguish it from the napi, which were generally long\". The most common type of turnip is mostly white-skinned except for the upper 1 to 6 centimetres (1\u20442 to 2+1\u20442 inches)."}}, {"canonical_name": "n\u00e1os", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "naos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "naos", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["naos"], "contexts": ["ships"]}, {"entity_id": "n\u00e1os", "book_id": "coloquios_da_orta_1563", "name": "n\u00e1os", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 4, "variants": ["n\u00e1os"], "contexts": ["ships used by the Chinese", "ships used by merchants"]}, {"entity_id": "n\u00e1o", "book_id": "polyanthea_medicinal", "name": "n\u00e1o", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["n\u00e1o"], "contexts": ["stopped by Remora"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "naos", "target_book": "coloquios_da_orta_1563", "target_name": "n\u00e1os", "similarity": 0.844}, {"source_book": "coloquios_da_orta_1563", "source_name": "n\u00e1os", "target_book": "polyanthea_medicinal", "target_name": "n\u00e1o", "similarity": 0.903}], "id": 1525, "stable_key": "clu_3a6de248f6a4e5de", "ground_truth": {"modern_name": "ship", "confidence": "high", "type": "object", "note": "The Portuguese word 'n\u00e1o' or 'n\u00e1os' (plural) historically referred to a type of ship, particularly those used in trade and exploration during the early modern period."}}, {"canonical_name": "aromi", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "arromaticos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Arromaticos", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Arromaticos"], "contexts": ["aromatic substances"]}, {"entity_id": "aromi", "book_id": "ricettario_fiorentino_1597", "name": "aromi", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["aromi", "aroma"], "contexts": ["aromatic substances used in medicines", "aromatic substances used in trochisci"]}, {"entity_id": "aromas", "book_id": "polyanthea_medicinal", "name": "aromas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["aromas"], "contexts": ["fedores pare\u00e7\u00e3o aromas", "aromas"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Arromaticos", "target_book": "ricettario_fiorentino_1597", "target_name": "aromi", "similarity": 0.904}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Arromaticos", "target_book": "polyanthea_medicinal", "target_name": "aromas", "similarity": 0.882}, {"source_book": "ricettario_fiorentino_1597", "source_name": "aromi", "target_book": "polyanthea_medicinal", "target_name": "aromas", "similarity": 0.959}], "id": 1526, "stable_key": "clu_b47deeb7fdde9bf1", "ground_truth": {"modern_name": "aromas", "confidence": "high", "type": "concept", "description": "Pleasant or sweet smells; fragrances used in medicine.", "wikipedia_extract": "A fragrance compound (or fragrance) is a chemical compound with a pleasant odor. Fragrances affect only the sense of smell, whereas flavors can affect both the sense of taste and smell. Fragrances are often mixtures of individual fragrance compounds. Although many fragrances are derived from natural sources, many are synthetic. Fragrances are widely used in cosmetics and are the basis for a large industry. Stench compounds have unpleasant odors."}}, {"canonical_name": "Grana", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "grana_en_pan", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "grana en pan", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["grana en pan"], "contexts": ["dyestuff formed into tablets"]}, {"entity_id": "grana", "book_id": "historia_medicinal_monardes_1574", "name": "Grana", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Grana", "grano"], "contexts": ["dye material brought from the Indies", "seed-like object found in fake stones"]}, {"entity_id": "grana", "book_id": "ricettario_fiorentino_1597", "name": "Grana", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["grana", "Grana"], "contexts": ["dyeing substance, also called Cocco", "cochineal, a red dye"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "grana en pan", "target_book": "historia_medicinal_monardes_1574", "target_name": "Grana", "similarity": 0.899}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "grana en pan", "target_book": "ricettario_fiorentino_1597", "target_name": "Grana", "similarity": 0.899}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Grana", "target_book": "ricettario_fiorentino_1597", "target_name": "Grana", "similarity": 1.0}], "id": 1527, "stable_key": "clu_28b15e332fe46752", "ground_truth": {"modern_name": "grain", "confidence": "high", "type": "concept", "wikipedia_extract": "A grain is a small, hard, dry fruit (caryopsis) \u2013 with or without an attached hull layer \u2013 harvested for human or animal consumption. A grain crop is a grain-producing plant. The two main types of commercial grain crops are cereals and legumes. After being harvested, dry grains are more durable than other staple foods, such as starchy fruits (plantains, breadfruit, etc.) and tubers (sweet potatoes, cassava, and more). This durability has made grains well suited to industrial agriculture, since they can be mechanically harvested, transported by rail or ship, stored for long periods in silos, and milled for flour or pressed for oil. Thus, the grain market is a major global agricultural market that includes crops such as maize, rice, soybeans, wheat and other grains.", "wikipedia_url": "https://en.wikipedia.org/wiki/Grain"}}, {"canonical_name": "Se\u00f1ores", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "se\u00f1ores", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Se\u00f1ores", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Se\u00f1ores"], "contexts": ["lords, nobles"]}, {"entity_id": "se\u00f1ores", "book_id": "historia_medicinal_monardes_1574", "name": "Se\u00f1ores", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Se\u00f1ores", "se\u00f1ores"], "contexts": ["lords or gentlemen", "rulers who can be poisoned"]}, {"entity_id": "senhores", "book_id": "coloquios_da_orta_1563", "name": "senhores", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["senhores", "Senhor Deos", "seniorem"], "contexts": ["lords", "Latin for senior"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Se\u00f1ores", "target_book": "historia_medicinal_monardes_1574", "target_name": "Se\u00f1ores", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Se\u00f1ores", "target_book": "coloquios_da_orta_1563", "target_name": "senhores", "similarity": 0.97}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Se\u00f1ores", "target_book": "coloquios_da_orta_1563", "target_name": "senhores", "similarity": 0.97}], "id": 1528, "stable_key": "clu_495eacf08fdc743e", "ground_truth": {"modern_name": "Gentlemen", "confidence": "high", "type": "concept", "wikidata_id": "Q749212", "wikidata_description": "man said to have good, courteous conduct"}}, {"canonical_name": "lombrichi", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "lombr\u00edces", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "lombr\u00edces", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["lombr\u00edces"], "contexts": ["worms in the belly"]}, {"entity_id": "lombrichi", "book_id": "ricettario_fiorentino_1597", "name": "lombrichi", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["lombrichi", "Lombrichi", "Lombrich\u00e9to"], "contexts": ["earthworms, taken whole", "earthworms, washed with white wine"]}, {"entity_id": "lombri", "book_id": "polyanthea_medicinal", "name": "lombri", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["lombri"], "contexts": ["worms"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "lombr\u00edces", "target_book": "ricettario_fiorentino_1597", "target_name": "lombrichi", "similarity": 0.961}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "lombr\u00edces", "target_book": "polyanthea_medicinal", "target_name": "lombri", "similarity": 0.901}, {"source_book": "ricettario_fiorentino_1597", "source_name": "lombrichi", "target_book": "polyanthea_medicinal", "target_name": "lombri", "similarity": 0.895}], "id": 1529, "stable_key": "clu_24dd39fcfaeb1ef0", "ground_truth": {"modern_name": "Earthworms", "confidence": "high", "type": "animal", "description": "Annelid worms found in the earth, used in preparations.", "note": "Contexts refer to earthworms being used whole or washed for medicinal purposes.", "wikipedia_extract": "An earthworm is a soil-dwelling terrestrial invertebrate that belongs to the phylum Annelida. The term is the common name for the largest members of the class (or subclass, depending on the author) Oligochaeta. In classical systems, they were in the order of Opisthopora since the male pores opened posterior to the female pores, although the internal male segments are anterior to the female. Theoretical cladistic studies have placed them in the suborder Lumbricina of the order Haplotaxida, but this may change. Other slang names for earthworms include \"dew-worm\", \"rainworm\", \"nightcrawler\", and \"angleworm\" (from its use as angling hookbait). Larger terrestrial earthworms are also called megadriles (which translates to \"big worms\") as opposed to the microdriles (\"small worms\") in the semiaquatic families Tubificidae, Lumbricidae and Enchytraeidae."}}, {"canonical_name": "Levante", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "levante", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Levante", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Levante"], "contexts": ["region where similar pieces are brought from"]}, {"entity_id": "levante", "book_id": "historia_medicinal_monardes_1574", "name": "Levante", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Levante"], "contexts": ["region from which Ca\u00f1afistola used to come", "origin of Ruybarbo"]}, {"entity_id": "levante", "book_id": "ricettario_fiorentino_1597", "name": "Levante", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Levante"], "contexts": ["region producing good musk", "Eastern Mediterranean region"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Levante", "target_book": "historia_medicinal_monardes_1574", "target_name": "Levante", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Levante", "target_book": "ricettario_fiorentino_1597", "target_name": "Levante", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Levante", "target_book": "ricettario_fiorentino_1597", "target_name": "Levante", "similarity": 1.0}], "id": 1530, "stable_key": "clu_9e23489407850742", "ground_truth": {"modern_name": "Levant", "confidence": "high", "type": "place", "description": "A region in the Eastern Mediterranean or its origin of goods.", "note": "Refers to the Eastern Mediterranean region and its products.", "wikipedia_extract": "The Levant is a subregion of West Asia along the Eastern Mediterranean, that forms part of the Middle East. The term is often used in conjunction with historical or cultural references. In its narrowest sense, used in archaeology and other contexts, the Levant refers to Cyprus and land bordering the Mediterranean Sea in West Asia that includes the Syria region, Lebanon, Jordan, Palestine, Israel, and south Cilicia (Turkey). In its widest historical sense, the Levant included all the Eastern Mediterranean; extending from Greece to Egypt and Cyrenaica (Eastern Libya). The Levant represents the land bridge between Africa and Eurasia, has been described as the crossroads of West Asia, Eastern Mediterranean, and Northeast Africa, and geologically as the \"northwest of the Arabian plate\". In the 13th and 14th centuries, levante was used for Italian maritime commerce in the Eastern Mediterranean, including Greece, Anatolia, Syria-Palestine, and Egypt, that is the lands east of Venice."}}, {"canonical_name": "Melao", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "mel\u00f3n", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "mel\u00f3n", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["mel\u00f3n"], "contexts": ["root tastes like melon"]}, {"entity_id": "mel\u00e3o", "book_id": "coloquios_da_orta_1563", "name": "mel\u00e3o", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["mel\u00e3o"], "contexts": ["fruit, comparison for size"]}, {"entity_id": "melao", "book_id": "polyanthea_medicinal", "name": "Melao", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Melao", "melao", "mela\u0151"], "contexts": ["type of fruit to avoid", "melon"]}, {"entity_id": "mel\u00e3o", "book_id": "polyanthea_medicinal", "name": "mel\u00e3o", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["mel\u00e3o"], "contexts": ["melon seeds used in a syrup", "seeds used for refreshing and cleansing kidneys"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "mel\u00f3n", "target_book": "coloquios_da_orta_1563", "target_name": "mel\u00e3o", "similarity": 0.901}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "mel\u00f3n", "target_book": "polyanthea_medicinal", "target_name": "mel\u00e3o", "similarity": 0.901}, {"source_book": "coloquios_da_orta_1563", "source_name": "mel\u00e3o", "target_book": "polyanthea_medicinal", "target_name": "Melao", "similarity": 0.55}, {"source_book": "coloquios_da_orta_1563", "source_name": "mel\u00e3o", "target_book": "polyanthea_medicinal", "target_name": "mel\u00e3o", "similarity": 1.0}], "id": 1531, "stable_key": "clu_fcd7b6c2f3812c8c", "ground_truth": {"modern_name": "Melon", "confidence": "high", "type": "plant", "linnaean": "Cucumis melo L.", "family": "Cucurbitaceae"}}, {"canonical_name": "Liverpool", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "liverpool", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Liverpool", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Liverpool"], "contexts": ["city in England", "port for voyages"]}, {"entity_id": "liverpool", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Liverpool", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Liverpool"], "contexts": ["home of Mr. Lassell"]}, {"entity_id": "liverpool", "book_id": "first_principles_spencer_1862", "name": "Liverpool", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Liverpool"], "contexts": ["Liverpool has assumed the office of importing cotton"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Liverpool", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Liverpool", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Liverpool", "target_book": "first_principles_spencer_1862", "target_name": "Liverpool", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Liverpool", "target_book": "first_principles_spencer_1862", "target_name": "Liverpool", "similarity": 1.0}], "id": 1532, "stable_key": "clu_c2b4a49597ef3f70", "ground_truth": {"modern_name": "Liverpool", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q24826", "wikidata_description": "city in Merseyside, England, United Kingdom", "wikipedia_url": "https://en.wikipedia.org/wiki/Liverpool", "wikipedia_extract": "Liverpool is a port city and metropolitan borough in Merseyside, England. It is situated on the eastern side of the Mersey Estuary, near the Irish Sea, 178 miles (286 km) north-west of London. It had a population of 508,961 in 2024 and is the administrative, cultural and economic centre of the Liverpool City Region, a combined authority area with a population of over 1.5 million. Established as a borough in Lancashire in 1207, Liverpool became significant in the late 17th century when the Port of Liverpool was heavily involved in the Atlantic slave trade. The port also imported cotton for the Lancashire textile mills, and became a major departure point for English and Irish emigrants to North America. Liverpool rose to global economic importance at the forefront of the Industrial Revolution in the 19th century and was home to the first inter-city railway, the first non-combustible warehouse system (the Royal Albert Dock), and a pioneering elevated electrical railway; it was granted city status in 1880 and was moved from Lancashire to the newly created county of Merseyside in 1974."}}, {"canonical_name": "steppes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "steppes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "steppes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["steppes"], "contexts": ["grassy plains", "plains"]}, {"entity_id": "steppes", "book_id": "kosmos_humboldt_1845", "name": "steppes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["steppes"], "contexts": ["dreary barrenness of the steppes", "grasslands in Northern Asia"]}, {"entity_id": "steppes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "steppes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["steppes"], "contexts": ["large areas of flat grassland"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "steppes", "target_book": "kosmos_humboldt_1845", "target_name": "steppes", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "steppes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "steppes", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "steppes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "steppes", "similarity": 1.0}], "id": 1533, "stable_key": "clu_5252bc7ce0d79301", "ground_truth": {"modern_name": "steppe", "confidence": "high", "type": "place", "country": "Various (Eurasia)"}}, {"canonical_name": "Montpellier", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "montpellier", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Montpellier", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Montpellier"], "contexts": ["city for temperature comparison", "location of oscillation extent observations"]}, {"entity_id": "montpellier", "book_id": "kosmos_humboldt_1845", "name": "Montpellier", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Montpellier"], "contexts": ["city with mild winter temperature", "city with mean winter temperature"]}, {"entity_id": "montpellier", "book_id": "coloquios_da_orta_1563", "name": "Montpellier", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Montpellier"], "contexts": ["city in France"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Montpellier", "target_book": "kosmos_humboldt_1845", "target_name": "Montpellier", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Montpellier", "target_book": "coloquios_da_orta_1563", "target_name": "Montpellier", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Montpellier", "target_book": "coloquios_da_orta_1563", "target_name": "Montpellier", "similarity": 1.0}], "id": 1534, "stable_key": "clu_420c5296b05af1ab", "ground_truth": {"modern_name": "Montpellier", "confidence": "high", "type": "place", "description": "City in southern France known for its university and climate.", "wikipedia_extract": "Montpellier (UK: ; US: ) is a city in southern France near the Mediterranean Sea. One of the largest urban centres in the region of Occitania, Montpellier is the prefecture of the department of H\u00e9rault. As of 2023, 310,240 people live in the city proper, while its metropolitan area has a population of 813,272 as of 2020. Montpellier is the third-largest French city near the Mediterranean coast, behind Marseille and Nice, and the seventh-largest city of France overall. The inhabitants are called Montpelli\u00e9rains. In the Middle Ages, Montpellier was an important city of the Crown of Aragon (and was the birthplace of James I), and then of Majorca, before its sale to France in 1349."}}, {"canonical_name": "Louis XIV", "category": "PERSON", "subcategory": "PATRON", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "louis_xiv", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Louis XIV", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["Louis XIV"], "contexts": ["commissioned canal construction", "Lorsque Louis XIV voulut embellir"]}, {"entity_id": "luiz_xiv", "book_id": "coloquios_da_orta_1563", "name": "Luiz XIV", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Luiz XIV"], "contexts": ["king of France, received ambassadors"]}, {"entity_id": "luis_xiv_", "book_id": "polyanthea_medicinal", "name": "Luis XIV.", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["Luis XIV.", "Luis XIV"], "contexts": ["King of France", "King of France who rewarded scholars"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Louis XIV", "target_book": "coloquios_da_orta_1563", "target_name": "Luiz XIV", "similarity": 0.915}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Louis XIV", "target_book": "polyanthea_medicinal", "target_name": "Luis XIV.", "similarity": 0.942}, {"source_book": "coloquios_da_orta_1563", "source_name": "Luiz XIV", "target_book": "polyanthea_medicinal", "target_name": "Luis XIV.", "similarity": 0.927}], "id": 1535, "stable_key": "clu_d3dee68e749318ce", "ground_truth": {"modern_name": "Louis XIV", "confidence": "high", "type": "person", "description": "King of France, patron of arts and sciences and ambitious builder.", "wikipedia_extract": "Louis XIV (Louis-Dieudonn\u00e9; 5 September 1638 \u2013 1 September 1715), also known as Louis the Great (Louis le Grand [lwi l\u0259 \u0261\u0281\u0251\u0303]) or the Sun King (le Roi Soleil [l\u0259 \u0281wa s\u0254l\u025bj]), was King of France from 1643 until his death in 1715. His reign lasted 72 years and 110 days, which is the longest of any monarch in history. An emblem of the age of absolutism in Europe, Louis XIV's legacy includes French colonial expansion, the conclusion of the Thirty Years' War involving the Habsburgs, and a controlling influence on the style of fine arts and architecture in France, including the transformation of the Palace of Versailles into a center of royal power and politics. Louis XIV's pageantry and opulence helped define the French Baroque style of art and architecture and promoted his image as supreme leader of France in the early modern period. Louis XIV began his personal rule of France in 1661 after the death of his chief minister Cardinal Mazarin. A believer in the divine right of kings, Louis XIV continued Louis XIII's work of creating a centralized state governed from a capital."}}, {"canonical_name": "electrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "\u00e9lectrom\u00e8tre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "\u00e9lectrom\u00e8tre", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["\u00e9lectrom\u00e8tre", "\u00e9lectrom\u00e8tre de Volta"], "contexts": ["instrument for measuring electricity", "instrument used to measure atmospheric electricity"]}, {"entity_id": "electrometer", "book_id": "kosmos_humboldt_1845", "name": "electrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["electrometer"], "contexts": ["device for measuring electric charge", "instrument for measuring electric charge"]}, {"entity_id": "electrometers", "book_id": "kosmos_humboldt_1845", "name": "electrometers", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["electrometers"], "contexts": ["instrument for measuring electricity"]}, {"entity_id": "electrometer", "book_id": "first_principles_spencer_1862", "name": "electrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["electrometer"], "contexts": ["instrument for measuring electric potential"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "\u00e9lectrom\u00e8tre", "target_book": "kosmos_humboldt_1845", "target_name": "electrometer", "similarity": 0.976}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "\u00e9lectrom\u00e8tre", "target_book": "kosmos_humboldt_1845", "target_name": "electrometers", "similarity": 0.941}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "\u00e9lectrom\u00e8tre", "target_book": "first_principles_spencer_1862", "target_name": "electrometer", "similarity": 0.976}, {"source_book": "kosmos_humboldt_1845", "source_name": "electrometer", "target_book": "first_principles_spencer_1862", "target_name": "electrometer", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "electrometers", "target_book": "first_principles_spencer_1862", "target_name": "electrometer", "similarity": 0.964}], "id": 1536, "stable_key": "clu_65c91cb4ebc96fcb", "ground_truth": {"modern_name": "Electrometer", "confidence": "high", "type": "object", "note": "The presence of '\u00e9lectrom\u00e8tre' and the description 'device for measuring electric charge' confirm this identification. 'Electrodes' are related but distinct; however, the dominant term is electrometer.", "wikidata_id": "Q1982706", "wikidata_description": "instrument for measuring electric charge", "wikipedia_url": "https://en.wikipedia.org/wiki/Electrometer", "wikipedia_extract": "An electrometer is an electrical instrument for measuring electric charge or electrical potential difference. There are many different types, ranging from historical handmade mechanical instruments to high-precision electronic devices. Modern electrometers based on vacuum tube or solid-state technology can be used to make voltage and charge measurements with very low leakage currents, down to 1 femtoampere. A simpler but related instrument, the electroscope, works on similar principles but only indicates the relative magnitudes of voltages or charges. The gold-leaf electroscope was one of the instruments used to indicate electric charge. It is still used for science demonstrations but has been superseded in most applications by electronic measuring instruments."}}, {"canonical_name": "electric explosions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "explosions_\u00e9lectriques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "explosions \u00e9lectriques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["explosions \u00e9lectriques"], "contexts": ["electrical discharge phenomenon", "electrical phenomena"]}, {"entity_id": "electric_explosions", "book_id": "kosmos_humboldt_1845", "name": "electric explosions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["electric explosions"], "contexts": ["phenomenon of lightning", "sudden release of electrical energy"]}, {"entity_id": "electric_explosions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "electric explosions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["electric explosions"], "contexts": ["violent phenomena produced by storms"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "explosions \u00e9lectriques", "target_book": "kosmos_humboldt_1845", "target_name": "electric explosions", "similarity": 0.98}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "explosions \u00e9lectriques", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electric explosions", "similarity": 0.98}, {"source_book": "kosmos_humboldt_1845", "source_name": "electric explosions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electric explosions", "similarity": 1.0}], "id": 1537, "stable_key": "clu_0f3afea025d1618a", "ground_truth": {"modern_name": "Electrical discharge", "confidence": "high", "type": "concept", "wikidata_id": "Q577484", "wikidata_description": "metal fabrication process whereby a desired shape is obtained by using electrical discharges to remove material", "wikipedia_url": "https://en.wikipedia.org/wiki/Electrical%20discharge%20machining", "wikipedia_extract": "Electrical discharge machining (EDM), also known as spark machining, spark eroding, die sinking, wire burning or wire erosion, is a metal fabrication process whereby a desired shape is obtained by using electrical discharges (sparks). Material is removed from the work piece by a series of rapidly recurring current discharges between two electrodes, separated by a dielectric liquid and subject to an electric voltage. One of the electrodes is called the tool-electrode(simply the tool or electrode), while the other is called the workpiece-electrode, or work piece. The process depends upon the tool and work piece not making physical contact. Extremely hard materials like carbides, ceramics, titanium alloys and heat treated tool steels that are very difficult to machine using conventional machining can be precisely machined by EDM. When the voltage between the two electrodes is increased, the intensity of the electric field in the volume between the electrodes becomes greater, causing dielectric break down of the liquid, and produces an electric arc."}}, {"canonical_name": "Indus", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "indus", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Indus", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Indus"], "contexts": ["river forming a limit", "river in Asia"]}, {"entity_id": "indus", "book_id": "coloquios_da_orta_1563", "name": "Indus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Indus"], "contexts": ["river called Milan or Sinteu", "Latin name for a river"]}, {"entity_id": "indus", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Indus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Indus"], "contexts": ["river delta where land was raised", "constellation traversed by comet"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Indus", "target_book": "coloquios_da_orta_1563", "target_name": "Indus", "similarity": 0.86}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Indus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Indus", "similarity": 0.86}, {"source_book": "coloquios_da_orta_1563", "source_name": "Indus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Indus", "similarity": 1.0}], "id": 1538, "stable_key": "clu_ab212d492d67deaf", "ground_truth": {"modern_name": "Indus River", "confidence": "high", "type": "place", "country": "Pakistan", "wikidata_id": "Q260018", "wikidata_description": "species of mammal"}}, {"canonical_name": "Abel R\u00e9musat", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "mm__abel_remusat", "book_id": "relation_historique_humboldt_vol3_1825", "name": "MM. Abel Remusat", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["MM. Abel Remusat"], "contexts": ["savante researcher of languages"]}, {"entity_id": "abel_r\u00e9musat", "book_id": "kosmos_humboldt_1845", "name": "Abel R\u00e9musat", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Abel R\u00e9musat"], "contexts": ["translator and scholar of Chinese", "author of scientific text"]}, {"entity_id": "abel_remusat", "book_id": "kosmos_humboldt_1845", "name": "Abel Remusat", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Abel Remusat"], "contexts": ["made known Thianschan mountains", "author of 'Lettre a M. Cordier'"]}, {"entity_id": "abel_ro\u017fio", "book_id": "polyanthea_medicinal", "name": "Abel Ro\u017fio", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Abel Ro\u017fio", "Abel Rofio"], "contexts": ["author of observations on hydropsy"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "MM. Abel Remusat", "target_book": "kosmos_humboldt_1845", "target_name": "Abel R\u00e9musat", "similarity": 0.896}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "MM. Abel Remusat", "target_book": "kosmos_humboldt_1845", "target_name": "Abel Remusat", "similarity": 0.856}, {"source_book": "kosmos_humboldt_1845", "source_name": "Abel R\u00e9musat", "target_book": "polyanthea_medicinal", "target_name": "Abel Ro\u017fio", "similarity": 0.855}, {"source_book": "kosmos_humboldt_1845", "source_name": "Abel Remusat", "target_book": "polyanthea_medicinal", "target_name": "Abel Ro\u017fio", "similarity": 0.856}], "id": 1539, "stable_key": "clu_03c0835810d3581d", "ground_truth": {"modern_name": "Abel R\u00e9musat", "confidence": "high", "type": "person", "birth_year": 1788, "death_year": 1832, "description": "French sinologist, orientalist, and linguist.", "wikidata_id": "Q716743", "wikidata_description": "French sinologist (1788-1832)", "wikipedia_url": "https://en.wikipedia.org/wiki/Jean-Pierre%20Abel-R%C3%A9musat", "wikipedia_extract": "Jean-Pierre Abel-R\u00e9musat (French pronunciation: [\u0292\u0251\u0303 pj\u025b\u0281 ab\u025bl \u0281emyza]; 5 September 1788 \u2013 2 June 1832) was a French sinologist best known as the first Chair of Sinology at the Coll\u00e8ge de France. R\u00e9musat studied medicine as a young man, but his discovery of a Chinese herbal treatise enamored him with the Chinese language, and he spent five years teaching himself to read it. After publishing several well-received articles on Chinese topics, a chair in Chinese was created at the Coll\u00e8ge de France in 1814 and R\u00e9musat was placed in it. R\u00e9musat was born in Paris on 5 September 1788 and was educated for the medical profession, earning a doctorate in medicine in 1813. While studying medicine, R\u00e9musat discovered a Chinese herbal treatise in the collection of the Abb\u00e9 Tersan and was immediately fascinated by it. He taught himself to read it by tirelessly studying the traditional Chinese dictionary Zhengzitong."}}, {"canonical_name": "fever", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "fever", "book_id": "relation_historique_humboldt_vol3_1825", "name": "fever", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["fever"], "contexts": ["implied by burning of effigies"]}, {"entity_id": "fever", "book_id": "principles_of_psychology_james_1890", "name": "fever", "category": "DISEASE", "subcategory": "ACUTE", "count": 5, "variants": ["fever"], "contexts": ["elevated body temperature", "condition causing delirium"]}, {"entity_id": "fever", "book_id": "ricettario_fiorentino_1597", "name": "Fever", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["Fever"], "contexts": ["elevated body temperature"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "fever", "target_book": "principles_of_psychology_james_1890", "target_name": "fever", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "fever", "target_book": "ricettario_fiorentino_1597", "target_name": "Fever", "similarity": 0.995}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fever", "target_book": "ricettario_fiorentino_1597", "target_name": "Fever", "similarity": 0.995}], "id": 1540, "stable_key": "clu_6223dcf2803ef3cf-2", "ground_truth": {"modern_name": "Fever", "confidence": "high", "type": "disease", "modern_term": "Fever", "wikidata_id": "Q38933", "wikidata_description": "common medical sign characterized by elevated body temperature", "wikipedia_url": "https://en.wikipedia.org/wiki/Fever", "wikipedia_extract": "Fever or pyrexia in humans is a symptom of an anti-infection defense mechanism that appears with body temperature exceeding the normal range caused by an increase in the body's temperature set point in the hypothalamus. There is no single agreed-upon upper limit for normal temperature: sources use values ranging between 37.2 and 38.3 \u00b0C (99.0 and 100.9 \u00b0F) in humans. The increase in set point triggers increased muscle contractions and causes a feeling of cold or chills. This results in greater heat production and efforts to conserve heat. When the set point temperature returns to normal, a person feels hot, becomes flushed, and may begin to sweat. Rarely a fever may trigger a febrile seizure, with this being more common in young children.", "description": "An acute illness characterized by elevated body temperature and potential delirium."}}, {"canonical_name": "understanding", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "understanding", "book_id": "principles_of_psychology_james_1890", "name": "understanding", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["understanding", "Understanding"], "contexts": ["ability to comprehend speech", "faculty of logical thought and judgment"]}, {"entity_id": "understanding", "book_id": "kosmos_humboldt_1845", "name": "understanding", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["understanding"], "contexts": ["faculty for comprehension"]}, {"entity_id": "understanding", "book_id": "first_principles_spencer_1862", "name": "understanding", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["understanding"], "contexts": ["faculty for reasoning and comprehension"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "understanding", "target_book": "kosmos_humboldt_1845", "target_name": "understanding", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "understanding", "target_book": "first_principles_spencer_1862", "target_name": "understanding", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "understanding", "target_book": "first_principles_spencer_1862", "target_name": "understanding", "similarity": 1.0}], "id": 1541, "stable_key": "clu_ff211a0e4bfeed12", "ground_truth": {"modern_name": "Understanding", "confidence": "high", "type": "concept", "wikidata_id": "Q46744", "wikidata_description": "ability to think about and use concepts to deal adequately with an object", "wikipedia_url": "https://en.wikipedia.org/wiki/Understanding", "wikipedia_extract": "Understanding is a cognitive process related to an abstract or physical object, such as a person, situation, or message whereby one is able to use concepts to model that object. Understanding is a relation between the knower and an object of understanding. Understanding implies abilities and dispositions with respect to an object of knowledge that are sufficient to support intelligent behavior. Understanding is often, though not always, related to learning concepts, and sometimes also the theory or theories associated with those concepts. However, a person may have a good ability to predict the behavior of an object, animal or system\u2014and therefore may, in some sense, understand it\u2014without necessarily being familiar with the concepts or theories associated with that object, animal, or system in their culture. They may have developed their own distinct concepts and theories, which may be equivalent, better or worse than the recognized standard concepts and theories of their culture."}}, {"canonical_name": "position", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "position", "book_id": "principles_of_psychology_james_1890", "name": "position", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["position"], "contexts": ["location of an entity", "location of the soul"]}, {"entity_id": "position", "book_id": "connexion_physical_sciences_somerville_1858", "name": "position", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["position"], "contexts": ["location in space"]}, {"entity_id": "position", "book_id": "first_principles_spencer_1862", "name": "position", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["position"], "contexts": ["changes effect of gravity"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "position", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "position", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "position", "target_book": "first_principles_spencer_1862", "target_name": "position", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "position", "target_book": "first_principles_spencer_1862", "target_name": "position", "similarity": 1.0}], "id": 1542, "stable_key": "clu_cab47f6823c3019f", "ground_truth": {"modern_name": "Position", "confidence": "high", "type": "concept", "wikidata_id": "Q480319", "wikidata_description": "official designation of a position held in an organization associated with certain duties of authority"}}, {"canonical_name": "chloroform", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "chloroform", "book_id": "principles_of_psychology_james_1890", "name": "chloroform", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["chloroform"], "contexts": ["chemical that can affect consciousness", "lengthens reaction time"]}, {"entity_id": "chlorine", "book_id": "kosmos_humboldt_1845", "name": "chlorine", "category": "S