 "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["asm\u00e1ticos"], "contexts": ["sufferers of asthma", "people suffering from asthma"]}, {"entity_id": "asma", "book_id": "coloquios_da_orta_1563", "name": "asma", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["asma"], "contexts": ["respiratory illness treated with anacardo"]}, {"entity_id": "asthma", "book_id": "polyanthea_medicinal", "name": "Asthma", "category": "DISEASE", "subcategory": "CHRONIC", "count": 90, "variants": ["Asthma", "Afma", "Afthma", "Afthmas", "Afthmaticos", "Asma", "Asthimas", "Asthm.", "Asthmas", "Asthmati", "afma", "asma", "asmas", "asthma", "asthmas", "a\u017fthmas"], "contexts": ["condition treated by bloodletting", "respiratory condition causing difficulty breathing"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Astmatick", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "asma", "similarity": 0.902}, {"source_book": "english_physician_1652", "source_name": "Astmatick", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "asm\u00e1ticos", "similarity": 0.906}, {"source_book": "english_physician_1652", "source_name": "Astmatick", "target_book": "coloquios_da_orta_1563", "target_name": "asma", "similarity": 0.902}, {"source_book": "english_physician_1652", "source_name": "Astmatick", "target_book": "polyanthea_medicinal", "target_name": "Asthma", "similarity": 0.906}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "asma", "target_book": "coloquios_da_orta_1563", "target_name": "asma", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "asma", "target_book": "polyanthea_medicinal", "target_name": "Asthma", "similarity": 0.958}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "asm\u00e1ticos", "target_book": "coloquios_da_orta_1563", "target_name": "asma", "similarity": 0.909}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "asm\u00e1ticos", "target_book": "polyanthea_medicinal", "target_name": "Asthma", "similarity": 0.904}, {"source_book": "coloquios_da_orta_1563", "source_name": "asma", "target_book": "polyanthea_medicinal", "target_name": "Asthma", "similarity": 0.958}], "id": 343, "stable_key": "clu_89feddc5e8848723", "ground_truth": {"modern_name": "Asthma", "confidence": "high", "type": "disease", "description": "A chronic respiratory condition causing difficulty in breathing.", "wikipedia_extract": "Asthma is a common long-term inflammatory disease of the airways. It is characterized by variable and recurring symptoms and reduced lung function. Symptoms include episodes of wheezing, coughing, chest tightness, and shortness of breath. A sudden worsening of asthma symptoms sometimes called an 'asthma attack' or an 'asthma exacerbation' can occur when allergens, pollen, dust, or other particles, are inhaled into the lungs, causing the bronchioles to constrict and produce mucus, which then restricts oxygen flow to the alveoli. These may occur a few times a day or a few times per week. Depending on the person, asthma symptoms may become worse at night or with exercise."}}, {"canonical_name": "Espagne", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 4, "total_mentions": 107, "members": [{"entity_id": "espagne", "book_id": "epoques_nature_buffon_1778", "name": "Espagne", "category": "PLACE", "subcategory": "COUNTRY", "count": 7, "variants": ["Espagne"], "contexts": ["western start of European mountain chain", "landmass potentially joined to Canada"]}, {"entity_id": "espagne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Espagne", "category": "PLACE", "subcategory": "COUNTRY", "count": 94, "variants": ["Espagne", "Espagn", "Espana", "Espa\u00eeia", "espagnol", "espagnoles", "l'Espagne"], "contexts": ["country where Iberians were established", "country with cistes and lentisques"]}, {"entity_id": "spagna", "book_id": "coloquios_da_orta_1563", "name": "Spagna", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Spagna"], "contexts": ["country visited by some physicians", "place where people would know things"]}, {"entity_id": "spagna", "book_id": "ricettario_fiorentino_1597", "name": "Spagna", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Spagna"], "contexts": ["country with good river waters", "country where Cassia is imported"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Espagne", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Espagne", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Espagne", "target_book": "coloquios_da_orta_1563", "target_name": "Spagna", "similarity": 0.975}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Espagne", "target_book": "ricettario_fiorentino_1597", "target_name": "Spagna", "similarity": 0.975}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Espagne", "target_book": "coloquios_da_orta_1563", "target_name": "Spagna", "similarity": 0.975}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Espagne", "target_book": "ricettario_fiorentino_1597", "target_name": "Spagna", "similarity": 0.975}, {"source_book": "coloquios_da_orta_1563", "source_name": "Spagna", "target_book": "ricettario_fiorentino_1597", "target_name": "Spagna", "similarity": 1.0}], "id": 344, "stable_key": "clu_16feb9df060d385d-2", "ground_truth": {"modern_name": "Spain", "confidence": "high", "type": "place", "country": "Spain", "wikidata_id": "Q29", "wikidata_description": "country in southwestern Europe with territories in Africa", "wikipedia_url": "https://en.wikipedia.org/wiki/Spain", "wikipedia_extract": "Spain, officially the Kingdom of Spain, is a country in Southern and Western Europe with territories in North Africa. Featuring the southernmost point of continental Europe, it is the largest country in Southern Europe and the fourth-most populous European Union (EU) member state. Spanning the majority of the Iberian Peninsula, its territory also includes the Canary Islands, in the Eastern Atlantic Ocean; the Balearic Islands, in the Western Mediterranean Sea; and the autonomous cities of Ceuta and Melilla, in mainland Africa. Peninsular Spain is bordered to the north by France, Andorra, and the Bay of Biscay; to the east and south by the Mediterranean Sea and Gibraltar; and to the west by Portugal and the Atlantic Ocean. Spain's capital and largest city is Madrid; other major urban areas include Barcelona, Valencia, Seville, Zaragoza, M\u00e1laga, Murcia, and Palma de Mallorca. In early antiquity, the Iberian Peninsula was inhabited by Celts, Iberians, and other pre-Roman peoples."}}, {"canonical_name": "Mexico", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 102, "members": [{"entity_id": "m\u00e9xico", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "M\u00e9xico", "category": "PLACE", "subcategory": "CITY", "count": 41, "variants": ["M\u00e9xico"], "contexts": ["location near Mexico City", "city where the resin was experimented"]}, {"entity_id": "mexico", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "mexico", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["mexico", "Mexico"], "contexts": ["place where a plant grows", "city where epazotl is cultivated"]}, {"entity_id": "mexicp", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Mexicp", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Mexicp"], "contexts": ["city in Mexico"]}, {"entity_id": "mexico", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mexico", "category": "PLACE", "subcategory": "CITY", "count": 50, "variants": ["Mexico", "IMexico"], "contexts": ["market where Uguautle is sold", "city and former viceroyalty"]}, {"entity_id": "mexico", "book_id": "historia_medicinal_monardes_1574", "name": "Mexico", "category": "PLACE", "subcategory": "COUNTRY", "count": 5, "variants": ["Mexico"], "contexts": ["city where the provincial was", "city where a plant is used as a purgative"]}, {"entity_id": "mexico", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mexico", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Mexico"], "contexts": ["country of Guanaxato silver-mine", "North American country"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "M\u00e9xico", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Mexico", "similarity": 0.958}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "mexico", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Mexico", "similarity": 0.939}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Mexicp", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Mexico", "similarity": 0.886}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Mexico", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mexico", "similarity": 1.0}], "id": 345, "stable_key": "clu_9f8d729962fb8284", "ground_truth": {"modern_name": "Mexico", "confidence": "high", "type": "place", "country": "Mexico", "wikidata_id": "Q6826187", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Mexico", "wikipedia_extract": "Mexico, officially the United Mexican States, is a country in North America. It is the northernmost country in Latin America and borders the United States to the north, and Guatemala and Belize to the southeast; while having maritime boundaries with the Pacific Ocean to the west, the Caribbean Sea to the southeast, and the Gulf of Mexico to the east. Mexico covers 1,972,550 km2 (761,610 sq mi), and is the thirteenth-largest country in the world by land area. With a population exceeding 130 million, Mexico is the tenth-most populous country in the world and is home to the largest number of native Spanish speakers as of 2020. Mexico City is the capital and largest city, which ranks among the most populous metropolitan areas in the world. Human presence in Mexico dates back to at least 8,000 BC."}}, {"canonical_name": "cerebro", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 99, "members": [{"entity_id": "cerveau", "book_id": "medecine_experimentale_bernard_1865", "name": "cerveau", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["cerveau"], "contexts": ["organ of thought and sensation", "brain"]}, {"entity_id": "cerveaux", "book_id": "relation_historique_humboldt_vol3_1825", "name": "cerveaux", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["cerveaux"], "contexts": ["brain of birds"]}, {"entity_id": "c\u00e9rebro", "book_id": "coloquios_da_orta_1563", "name": "c\u00e9rebro", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 6, "variants": ["c\u00e9rebro"], "contexts": ["body part that amber benefits", "organ of the nervous system"]}, {"entity_id": "cerebro", "book_id": "polyanthea_medicinal", "name": "cerebro", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 89, "variants": ["cerebro", "Cerebri", "Cerebro", "Cerebropelos", "cerebeldes", "cerebri", "cerebrum"], "contexts": ["brain", "organ of the body"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "cerveau", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "cerveaux", "similarity": 0.965}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "cerveau", "target_book": "coloquios_da_orta_1563", "target_name": "c\u00e9rebro", "similarity": 0.976}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "cerveau", "target_book": "polyanthea_medicinal", "target_name": "cerebro", "similarity": 0.962}, {"source_book": "coloquios_da_orta_1563", "source_name": "c\u00e9rebro", "target_book": "polyanthea_medicinal", "target_name": "cerebro", "similarity": 0.98}], "id": 346, "stable_key": "clu_6a5b94657380a917-2", "ground_truth": {"modern_name": "Brain", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Brain", "note": "While 'cerebro' directly translates to brain, in early modern texts it often referred to the concept of the seat of intellect and memory, as well as the physical organ.", "wikipedia_extract": "The brain is an organ that serves as the center of the nervous system in all vertebrate and most invertebrate animals. It consists of nervous tissue and is typically located in the head (cephalization), usually near organs for special senses such as vision, hearing, and olfaction. Being the most specialized organ, it is responsible for receiving information from the sensory nervous system, processing that information (thought, cognition, and intelligence) and the coordination of motor control (muscle activity and endocrine system). While invertebrate brains arise from paired segmental ganglia (each of which is only responsible for the respective body segment) of the ventral nerve cord, vertebrate brains develop axially from the midline dorsal nerve cord as a vesicular enlargement at the rostral end of the neural tube, with centralized control over all body segments. All vertebrate brains can be embryonically divided into three parts: the forebrain (prosencephalon, subdivided into telencephalon and diencephalon), midbrain (mesencephalon) and hindbrain (rhombencephalon, subdivided into metencephalon and myelencephalon). The spinal cord, which directly interacts with somatic functions below the head, can be considered a caudal extension of the myelencephalon enclosed inside the vertebral column."}}, {"canonical_name": "Arago", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 92, "members": [{"entity_id": "arago", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Arago", "category": "PERSON", "subcategory": "SCHOLAR", "count": 21, "variants": ["Arago"], "contexts": ["author of Ann. du Bur. des Long.", "co-author of a list of volcanoes"]}, {"entity_id": "arago", "book_id": "kosmos_humboldt_1845", "name": "Arago", "category": "PERSON", "subcategory": "SCHOLAR", "count": 52, "variants": ["Arago"], "contexts": ["inventor of ocular micrometer", "great philosopher Arago"]}, {"entity_id": "arana", "book_id": "coloquios_da_orta_1563", "name": "Arana", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Arana"], "contexts": ["author of biography of Magellan"]}, {"entity_id": "arago", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Arago", "category": "PERSON", "subcategory": "SCHOLAR", "count": 18, "variants": ["Arago"], "contexts": ["final proof of undulatory theory", "scientist who proved undulatory theory"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Arago", "target_book": "kosmos_humboldt_1845", "target_name": "Arago", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Arago", "target_book": "coloquios_da_orta_1563", "target_name": "Arana", "similarity": 0.861}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Arago", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Arago", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Arago", "target_book": "coloquios_da_orta_1563", "target_name": "Arana", "similarity": 0.861}, {"source_book": "kosmos_humboldt_1845", "source_name": "Arago", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Arago", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Arana", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Arago", "similarity": 0.861}], "id": 347, "stable_key": "clu_e574c4a1250296dd", "ground_truth": {"modern_name": "Fran\u00e7ois Arago", "confidence": "high", "type": "person", "birth_year": 1786, "death_year": 1853, "description": "French scientist, astronomer, and politician, known for optics and magnetism.", "wikidata_id": "Q87748365", "wikidata_description": "street of Montreuil in Seine-Saint-Denis, France"}}, {"canonical_name": "Authores", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 4, "total_mentions": 87, "members": [{"entity_id": "autor", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Autor", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Autor"], "contexts": ["author of the translated text", "cited authority"]}, {"entity_id": "autores", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Autores", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Autores"], "contexts": ["mentioned authors on turbith", "serious authors"]}, {"entity_id": "auctores", "book_id": "historia_medicinal_monardes_1574", "name": "auctores", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["auctores", "Auctuario", "au\u00e9tores"], "contexts": ["learned authors who wrote about medicine", "Greek author who mentioned Ambar"]}, {"entity_id": "autori", "book_id": "ricettario_fiorentino_1597", "name": "autori", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["autori"], "contexts": ["authors who wrote about plants"]}, {"entity_id": "authores", "book_id": "polyanthea_medicinal", "name": "Authores", "category": "PERSON", "subcategory": "AUTHORITY", "count": 79, "variants": ["Authores", "Authores antigos", "authores"], "contexts": ["authors", "authors who praise vomiting"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernande