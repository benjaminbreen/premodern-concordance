oria_medicinal_monardes_1574", "source_name": "Piloto", "target_book": "coloquios_da_orta_1563", "target_name": "pilotos", "similarity": 0.907}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Piloto", "target_book": "polyanthea_medicinal", "target_name": "Piloto", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "pilotos", "target_book": "polyanthea_medicinal", "target_name": "Piloto", "similarity": 0.907}], "id": 2088, "stable_key": "clu_375c4d6508d27a65", "ground_truth": {"modern_name": "pilot", "confidence": "high", "type": "person", "description": "A person who navigates a ship or aircraft.", "note": "The term 'Piloto' refers to a profession. While some individuals might be named Piloto, the context suggests the occupation.", "wikidata_id": "Q2095549", "wikidata_description": "person controlling an aircraft in flight", "wikipedia_extract": "Jonathan Nolan (born 6 June 1976) is a British and American screenwriter and producer. He is the creator of the CBS science fiction series Person of Interest (2011\u20132016) and co-creator of the HBO science fiction/Western series Westworld (2016\u20132022). Nolan has collaborated on several films with his brother, film director Christopher Nolan, who adapted Jonathan's short story \"Memento Mori\" into the neo-noir thriller film Memento (2000). Together, the brothers co-wrote the mystery-thriller film The Prestige (2006), the superhero films The Dark Knight (2008) and The Dark Knight Rises (2012), and the science-fiction film Interstellar (2014). In 2024, he executive produced and directed the first three episodes of the television series adaptation of Fallout. Nolan was nominated for the Academy Award for Best Original Screenplay for Memento, and for the Primetime Emmy Award for Outstanding Writing for a Drama Series and Outstanding Directing for a Drama Series for Westworld.", "wikipedia_url": "https://en.wikipedia.org/wiki/Jonathan_Nolan"}}, {"canonical_name": "Ca\u017fs\u00eda", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "ca\u017fs\u00eda", "book_id": "historia_medicinal_monardes_1574", "name": "Ca\u017fs\u00eda", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Ca\u017fs\u00eda"], "contexts": ["type of cinnamon"]}, {"entity_id": "casia", "book_id": "coloquios_da_orta_1563", "name": "casia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["casia"], "contexts": ["name applied to bark and trunks of Cinnamomum"]}, {"entity_id": "casia", "book_id": "polyanthea_medicinal", "name": "Casia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Casia"], "contexts": ["cassia"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Ca\u017fs\u00eda", "target_book": "coloquios_da_orta_1563", "target_name": "casia", "similarity": 0.806}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Ca\u017fs\u00eda", "target_book": "polyanthea_medicinal", "target_name": "Casia", "similarity": 0.784}, {"source_book": "coloquios_da_orta_1563", "source_name": "casia", "target_book": "polyanthea_medicinal", "target_name": "Casia", "similarity": 0.894}], "id": 2089, "stable_key": "clu_8eeac31f00fa8de6-2", "ground_truth": {"modern_name": "Cassia", "confidence": "high", "type": "plant", "linnaean": "Cinnamomum aromaticum Nees", "family": "Lauraceae", "note": "The term 'casia' in early modern Portuguese and Spanish medical texts often referred to the bark of the cinnamon tree, specifically the species now known as Cinnamomum aromaticum or Cinnamomum verum. The context of bark and trunks confirms this identification.", "wikidata_id": "Q162882", "wikidata_description": "genus of plants", "wikipedia_extract": "Cassia, Kezia or Keziah, a female surname of Biblical origin the female gentilicium name of the Cassia gens in ancient Rome Cassia or Kassia, Byzantine abbess and music scholar C\u00e1ssia Eller (1962\u20132001), Brazilian musician C\u00e1ssia Kiss (born 1958), Brazilian actress Cassi\u00e0 Maria Just (1926\u20132008), Catalan abbot Cassia O'Reilly (born 1996), Irish singer-songwriter Cassia, a fictional playable character in Heroes of the Storm Cassia Maria Reyes, the protagonist of the Matched trilogy by Ally Condie", "wikipedia_url": "https://en.wikipedia.org/wiki/Cassia_%28genus%29"}}, {"canonical_name": "febre", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 2, "total_mentions": 785, "members": [{"entity_id": "febre", "book_id": "coloquios_da_orta_1563", "name": "febre", "category": "DISEASE", "subcategory": "ACUTE", "count": 17, "variants": ["febre", "febr", "febres", "febres col\u00e9ricas", "febrs", "fevers", "fevres"], "contexts": ["a medical condition", "condition diagnosed by pulse"]}, {"entity_id": "febre", "book_id": "polyanthea_medicinal", "name": "febre", "category": "DISEASE", "subcategory": "ACUTE", "count": 768, "variants": ["febre", "Febr", "Febr.", "Febre Lipyria", "Febre maligna", "Febre syncopali", "Febre vermelha", "Febrediurna", "Febres", "Febres Hecticas", "Febres Malignas", "Febres antigas", "Febres intermittentes", "Febresintermittentes", "Febris", "Febrium", "Lipyriafebre", "Pe\u017ftilenti febre", "afebre maligna", "afebril", "ardentefebre", "calorda febre", "contagiodas febres malignas", "febr", "febr.", "febra", "febra pe\u017fti", "febre Epiala", "febre Lipiria", "febre Lipyria", "febre Lypiria", "febre Lypiriade", "febre Lyp\u0131ria", "febre Sinoco", "febre aguda", "febre ardente", "febre ardentiffima", "febre continua", "febre hectica", "febre hemaligna", "febre intermitente", "febre maligna", "febre malignissima", "febre maligni\u017f\u017fima", "febre peftilentis", "febre pe\u017ftil", "febre podre", "febre quarta", "febre quartaa", "febre sincopali humorosa", "febre sincopali minuta", "febre tam maligna", "febre tao maligna", "febre taoveneno\u017fa", "febre tertiana", "febre te