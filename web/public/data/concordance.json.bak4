 "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "voltaic_arc", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Voltaic arc", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 8, "variants": ["voltaic arc", "Voltaic arc"], "contexts": ["electrical discharge between battery terminals", "electrical discharge between poles of battery"]}, {"entity_id": "voltaic_arc", "book_id": "first_principles_spencer_1862", "name": "voltaic arc", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["voltaic arc"], "contexts": ["produces light"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Voltaic arc", "target_book": "first_principles_spencer_1862", "target_name": "voltaic arc", "similarity": 0.967}], "id": 2978, "stable_key": "clu_742d2c2c4108c84b", "ground_truth": {"modern_name": "Voltaic arc", "confidence": "high", "type": "object", "note": "The voltaic arc is an electric arc produced between two electrodes, typically from a voltaic pile (battery). Its description as an electrical discharge producing light is consistent."}}, {"canonical_name": "Sir William Hamilton", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "sir_william_hamilton", "book_id": "principles_of_psychology_james_1890", "name": "Sir William Hamilton", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Sir William Hamilton"], "contexts": ["philosopher who related an anecdote"]}, {"entity_id": "sir_william_hamilton", "book_id": "first_principles_spencer_1862", "name": "Sir William Hamilton", "category": "PERSON", "subcategory": "SCHOLAR", "count": 8, "variants": ["Sir William Hamilton"], "contexts": ["doctrine of religious thought limits", "philosopher on consciousness and logic"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Sir William Hamilton", "target_book": "first_principles_spencer_1862", "target_name": "Sir William Hamilton", "similarity": 1.0}], "id": 2979, "stable_key": "clu_7091b30cab033e4e", "ground_truth": {"modern_name": "William Hamilton", "confidence": "medium", "type": "person", "birth_year": 1730, "death_year": 1796, "description": "Scottish geologist and diplomat, influential in vulcanology and archaeology.", "note": "The context mentions 'philosopher defending soul's presence in body' and 'doctrine of religious thought limits', which aligns with Sir William Hamilton (1730-1796), a Scottish philosopher and diplomat known for his writings on metaphysics and theology, rather than the geologist. However, some associations could also be with the scientist William Rowan Hamilton (1805-1865). Given the provided texts are from the 19th century, and one mentions 'first principles', it leans towards the philosopher Sir William Hamilton for his metaphysical work.", "wikidata_id": "Q15443", "wikidata_description": "Irish physician and botanist (1783-1856)"}}, {"canonical_name": "lightning", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "lightning", "book_id": "kosmos_humboldt_1845", "name": "lightning", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 8, "variants": ["lightning"], "contexts": ["electrical discharge in atmosphere", "electrical discharge"]}, {"entity_id": "lightning_flash", "book_id": "connexion_physical_sciences_somerville_1858", "name": "lightning flash", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["lightning flash"], "contexts": ["course ascertained"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "lightning", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lightning flash", "similarity": 0.957}], "id": 2980, "stable_key": "clu_fe189e34668c8280", "ground_truth": {"modern_name": "Lightning", "confidence": "high", "ty