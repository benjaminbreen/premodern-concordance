": "western coast", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "western_coast", "book_id": "kosmos_humboldt_1845", "name": "western coast", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["western coast"], "contexts": ["coastline on the west"]}, {"entity_id": "eastern_coasts", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Eastern coasts", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Eastern coasts"], "contexts": ["location of colder climates"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "western coast", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Eastern coasts", "similarity": 0.897}], "id": 5943, "stable_key": "clu_2444471a592bc340", "ground_truth": {"modern_name": "Western coast", "confidence": "medium", "type": "place", "country": "various", "note": "The term 'western coast' is too general to pinpoint a specific modern country without further context. However, the concept itself is clear."}}, {"canonical_name": "swamps", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "swamps", "book_id": "kosmos_humboldt_1845", "name": "swamps", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["swamps"], "contexts": ["wet, marshy land"]}, {"entity_id": "swamps", "book_id": "first_principles_spencer_1862", "name": "swamps", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["swamps"], "contexts": ["wet, marshy land"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "swamps", "target_book": "first_principles_spencer_1862", "target_name": "swamps", "similarity": 1.0}], "id": 5944, "stable_key": "clu_b6cb1651894ff683", "ground_truth": {"modern_name": "swamp", "confidence": "high", "type": "place", "country": "Various", "wikidata_id": "Q19000458", "wikidata_description": "horse disease caused by a retrovirus and transmitted by bloodsucking insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Equine_infectious_anemia", "wikipedia_extract": "Equine infectious anemia or equine infectious anaemia (EIA), also known by horsemen as swamp fever, is a horse disease caused by a retrovirus (Equine infectious anemia virus) and transmitted by bloodsucking insects. The virus (EIAV) is endemic in the Americas, parts of Europe, the Middle and Far East, Russia, and South Africa. The virus is a lentivirus, like human immunodeficiency virus (HIV). Like HIV, EIA can be transmitted through blood, milk, and body secretions. Transmission is primarily through biting flies, such as the horse-fly and deer-fly. The virus survives up to 4 hours in the vector."}}, {"canonical_name": "Gay-Lussacii", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "gay-lussacii", "book_id": "kosmos_humboldt_1845", "name": "Gay-Lussacii", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Gay-Lussacii"], "contexts": ["scientist, friend of Humboldt"]}, {"entity_id": "m__gay-lussac", "book_id": "connexion_physical_sciences_somerville_1858", "name": "M. Gay-Lussac", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["M. Gay-Lussac"], "contexts": ["ascended in balloon, suffered from air rarity"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Gay-Lussacii", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "M. Gay-Lussac", "similarity": 0.853}], "id": 5945, "stable_key": "clu_695d70b553896a57-2", "ground_truth": {"modern_name": "Joseph Louis Gay-Lussac", "confidence": "high", "type": "person", "birth_year": 1778, "death_year": 1850, "description": "French chemist and physicist, known for studies on gas behavior and atomic weights.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "sugar-cane", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sugar-cane", "book_id": "kosmos_humboldt_1845", "name": "sugar-cane", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["sugar-cane"], "contexts": ["plant requiring hot climate"]}, {"entity_id": "sugar-cane", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sugar-cane", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["sugar-cane"], "contexts": ["plant source of sugar"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "sugar-cane", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sugar-cane", "similarity": 1.0}], "id": 5946, "stable_key": "clu_b65c58357d1e8b6b", "ground_truth": {"modern_name": "Sugar", "confidence": "high", "type": "plant", "linnaean": "Saccharum officinarum", "family": "Poaceae", "description": "Sweet crystalline substance obtained from various plants, especially sugarcane.", "note": "Refers to the plant source and the substance derived from it.", "wikipedia_extract": "Saccharum officinarum is a large, strong-growing species of grass in the sugarcane genus. Its stout stalks are rich in sucrose, a disaccharide sugar which accumulates in the stalk internodes. It originated in New Guinea, and is now cultivated in tropical and subtropical countries worldwide for the production of sugar, ethanol and other products. It is one of the most productive and most intensively cultivated kinds of sugarcane. Saccharum officinarum, a perennial plant, grows in clumps consisting of a number of strong unbranched stems. A network of rhizomes forms under the soil which sends up secondary shoots near the parent plant."}}, {"canonical_name": "Poland", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "poland", "book_id": "kosmos_humboldt_1845", "name": "Poland", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Poland"], "contexts": ["Eastern European country"]}, {"entity_id": "polonia", "book_id": "polyanthea_medicinal", "name": "Polonia", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Polonia"], "contexts": ["country mentioned with an illness"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Poland", "target_book": "polyanthea_medicinal", "target_name": "Polonia", "similarity": 0.973}], "id": 5947, "stable_key": "clu_21bfdd7dba5124ea-2", "ground_truth": {"modern_name": "Poland", "confidence": "high", "type": "place", "description": "European country, historical kingdom and later part of Russian Empire.", "wikipedia_extract": "Poland, officially the Republic of Poland, is a country in Central Europe. It extends from the Baltic Sea in the north to the Sudetes and Carpathian Mountains in the south. Poland borders Kaliningrad Oblast and Lithuania to the north; Belarus and Ukraine to the east; Slovakia and the Czech Republic to the south; and Germany to the west. The territory has a varied landscape, diverse ecosystems, and a temperate climate. Poland is composed of sixteen voivodeships and is the fifth most populous member state of the European Union (EU), with over 38 million people, and the fifth largest EU country by land area, covering 312,696 km2 (120,733 sq mi). The capital and largest city is Warsaw; other major cities include Krak\u00f3w, Wroc\u0142aw, \u0141\u00f3d\u017a, Pozna\u0144, and Gda\u0144sk."}}, {"canonical_name": "theory of terrestrial refraction", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "theory_of_terrestrial_refraction", "book_id": "kosmos_humboldt_1845", "name": "theory of terrestrial refraction", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["theory of terrestrial refraction"], "contexts": ["theory about light bending in atmosphere"]}, {"entity_id": "terrestrial_refraction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Terrestrial Refraction", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["Terrestrial Refraction"], "contexts": ["bending of light by atmosphere near earth"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "theory of terrestrial refraction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Terrestrial Refraction", "similarity": 0.899}], "id": 5948, "stable_key": "clu_555501f911422cec", "ground_truth": {"modern_name": "terrestrial refraction", "confidence": "high", "type": "concept", "wikidata_id": "Q254634", "wikidata_description": "deviation of light or other electromagnetic wave from a straight line as it passes through the atmosphere", "wikipedia_url": "https://en.wikipedia.org/wiki/Atmospheric_refraction", "wikipedia_extract": "The sunrise equation or sunset equation can be used to derive the time of sunrise or sunset for any solar declination and latitude in terms of local solar time when sunrise and sunset actually occur. {\\displaystyle \\cos \\omega _{\\circ }=-\\tan \\phi \\times \\tan \\delta } is the solar hour angle at either sunrise (when negative value is taken) or sunset (when positive value is taken); is the latitude of the observer on the Earth; The Earth rotates at an angular velocity of 15\u00b0/hour. Therefore, the expression {\\displaystyle \\omega _{\\circ }/\\mathrm {15} ^{\\circ }} is in degree, gives the interval of time in hours from sunrise to local solar noon or from local solar noon to sunset. The sign convention is typically that the observer latitude is 0 at the equator, positive for the Northern Hemisphere and negative for the Southern Hemisphere, and the solar declination is 0 at the vernal and autumnal equinoxes when the sun is exactly above the equator, positive during the Northern Hemisphere summer and negative during the Northern Hemisphere winter. The expression above is always applicable for latitudes between the Arctic Circle and Antarctic Circle. North of the Arctic Circle or south of the Antarctic Circle, there is at least one day of the year with no sunrise or sunset."}}, {"canonical_name": "Neetee", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "neetee", "book_id": "kosmos_humboldt_1845", "name": "Neetee", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Neetee"], "contexts": ["village and pass in Uttarakhand, India"]}, {"entity_id": "neetee", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Neetee", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Neetee"], "contexts": ["location on Moorcroft's route"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Neetee", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Neetee", "similarity": 1.0}], "id": 5949, "stable_key": "clu_097bbea6316b7f9d", "ground_truth": {"modern_name": "Niti Pass", "confidence": "high", "type": "place", "country": "India", "wikidata_id": "Q2982089", "wikidata_description": "", "wikipedia_extract": "The 1954 Sino-Indian Agreement, also called the Panchsheel Agreement, officially the Agreement on Trade and Intercourse Between Tibet Region and India, was signed by China and India in Peking on 29 April 1954. The preamble of the agreement stated the panchsheel, or  the five principles of peaceful coexistence, that China proposed and India favoured. The agreement reflected the adjustment of the previously existing trade relations between Tibet and India to the changed context of India's decolonisation and China's assertion of suzerainty over Tibet. Bertil Lintner writes that in the agreement, \"Tibet was referred to, for the first time in history, as 'the Tibet Region of China'\". The agreement expired on 6 June 1962, as per the original term limit, in the midst of the Sino-Indian border tensions. It was not renewed.", "wikipedia_url": "https://fr.wikipedia.org/wiki/Col_de_Niti"}}, {"canonical_name": "drops of water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "drops_of_water", "book_id": "kosmos_humboldt_1845", "name": "drops of water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["drops of water"], "contexts": ["liquid water in small spheres"]}, {"entity_id": "drops_of_water", "book_id": "connexion_physical_sciences_somerville_1858", "name": "drops of water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["drops of water"], "contexts": ["small spheres of liquid water"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "drops of water", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "drops of water", "similarity": 1.0}], "id": 5950, "stable_key": "clu_264f85d1c074cfd0", "ground_truth": {"modern_name": "Water droplets", "confidence": "high", "type": "object"}}, {"canonical_name": "Ross", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ross", "book_id": "kosmos_humboldt_1845", "name": "Ross", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Ross"], "contexts": ["navigator, provided testimony on storms"]}, {"entity_id": "ross", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Ross", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Ross"], "contexts": ["observed barometer depression in Antarctic Ocean"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Ross", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Ross", "similarity": 1.0}], "id": 5951, "stable_key": "clu_71faf0488ad4715e-2", "ground_truth": {"modern_name": "James Clark Ross", "confidence": "high", "type": "person", "birth_year": 1800, "death_year": 1862, "description": "British naval officer and explorer, studied storms and Antarctic meteorology.", "wikidata_id": "Q200564", "wikidata_description": "British explorer and naval officer (1800\u20131862)"}}, {"canonical_name": "Von Baer", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "von_baer", "book_id": "kosmos_humboldt_1845", "name": "Von Baer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Von Baer"], "contexts": ["academician, studied meteorology of Northern Asia"]}, {"entity_id": "von_baer", "book_id": "first_principles_spencer_1862", "name": "Von Baer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Von Baer"], "contexts": ["established truth of organismal development"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Von Baer", "target_book": "first_principles_spencer_1862", "target_name": "Von Baer", "similarity": 1.0}], "id": 5952, "stable_key": "clu_b1fdddcf0c9eabf2", "ground_truth": {"modern_name": "Karl Ernst von Baer", "confidence": "high", "type": "person", "birth_year": 1792, "death_year": 1876, "description": "Baltic German scientist, founder of embryology, studied organismal development.", "wikidata_id": "Q57190", "wikidata_description": "Baltic German scientist (1792-1876)"}}, {"canonical_name": "history of organisms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "history_of_organisms", "book_id": "kosmos_humboldt_1845", "name": "history of organisms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["history of organisms"], "contexts": ["study of the development of organisms"]}, {"entity_id": "biological_history", "book_id": "first_principles_spencer_1862", "name": "biological history", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["biological history"], "contexts": ["development of life on Earth"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "history of organisms", "target_book": "first_principles_spencer_1862", "target_name": "biological history", "similarity": 0.888}], "id": 5953, "stable_key": "clu_1db7b7e3aa904497", "ground_truth": {"modern_name": "Evolutionary History", "confidence": "high", "type": "concept", "note": "The context 'study of the development of organisms' and 'development of life on Earth' strongly points to the history of life and its evolutionary processes.", "wikidata_id": "Q1098275", "wikidata_description": "processes by which organisms evolved on Earth"}}, {"canonical_name": "arborescent ferns", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "arborescent_ferns", "book_id": "kosmos_humboldt_1845", "name": "arborescent ferns", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["arborescent ferns"], "contexts": ["plants found in equatorial regions"]}, {"entity_id": "arborescent_ferns", "book_id": "connexion_physical_sciences_somerville_1858", "name": "arborescent ferns", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["arborescent ferns"], "contexts": ["tree-like fern species"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "arborescent ferns", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "arborescent ferns", "similarity": 1.0}], "id": 5954, "stable_key": "clu_28ebbaa29b3dbaa1", "ground_truth": {"modern_name": "Tree ferns", "confidence": "high", "type": "plant", "family": "Cyatheaceae, Dicksoniaceae", "wikidata_id": "Q623232", "wikidata_description": "order of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Cyatheales", "wikipedia_extract": "The order Cyatheales, which includes most tree ferns, is a taxonomic order of the fern class, Polypodiopsida. No clear morphological features characterize all of the Cyatheales, but DNA sequence data indicate the order is monophyletic. Some species in the Cyatheales have tree-like growth forms from a vertical rhizome, others have shorter or horizontal expanding rhizomes. Some species have scales on the stems and leaves, while others have hairs. However, most plants in the Cyatheales are tree ferns and have trunk-like stems up to 10 metres (33 ft) tall. It is unclear how many times the tree form has evolved and been lost in the order."}}, {"canonical_name": "South-Indian archipelago", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "south-indian_archipelago", "book_id": "kosmos_humboldt_1845", "name": "South-Indian archipelago", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["South-Indian archipelago"], "contexts": ["islands inhabited by races"]}, {"entity_id": "archipelago_indiano", "book_id": "coloquios_da_orta_1563", "name": "archipelago Indiano", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["archipelago Indiano"], "contexts": ["geographic region"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "South-Indian archipelago", "target_book": "coloquios_da_orta_1563", "target_name": "archipelago Indiano", "similarity": 0.901}], "id": 5955, "stable_key": "clu_52e0ea07484884cf", "ground_truth": {"modern_name": "Indian Ocean islands", "confidence": "high", "type": "place", "note": "The term 'South-Indian archipelago' is vague and could encompass various island groups in the Indian Ocean. 'archipelago Indiano' is more direct but still requires interpretation within the historical context."}}, {"canonical_name": "human thought", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "human_thought", "book_id": "kosmos_humboldt_1845", "name": "human thought", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human thought"], "contexts": ["mental processes of humans"]}, {"entity_id": "human_thought", "book_id": "first_principles_spencer_1862", "name": "human thought", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human thought"], "contexts": ["mental processes and ideas"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "human thought", "target_book": "first_principles_spencer_1862", "target_name": "human thought", "similarity": 1.0}], "id": 5956, "stable_key": "clu_2deccffb9da4d316-4", "ground_truth": {"modern_name": "cognition", "confidence": "high", "type": "concept", "wikidata_id": "Q3065932", "wikidata_description": "disease of mental health that affects cognitive functions including memory processing, perception and problem solving", "wikipedia_url": "https://en.wikipedia.org/wiki/Neurocognitive%20disorder", "note": "Early modern concepts of 'intellectual powers' encompassed reasoning, memory, perception, and understanding, aligning with modern cognitive science.", "wikipedia_extract": "Neurocognitive disorders (NCDs), also known as cognitive disorders (CDs), are a category of mental health disorders that primarily affect cognitive abilities including learning, memory, perception, and problem-solving. Neurocognitive disorders include delirium, mild neurocognitive disorders, and major neurocognitive disorder (also known as dementia). They are defined by deficits in cognitive ability that are acquired (as opposed to developmental), typically represent decline, and may have an underlying brain pathology. The DSM-5 defines six key domains of cognitive function: executive function, learning and memory, perceptual-motor function, language, complex attention, and social cognition. Although Alzheimer's disease accounts for the majority of cases of neurocognitive disorders, there are various medical conditions that affect mental functions such as memory, thinking, and the ability to reason, including frontotemporal degeneration, Huntington's disease, dementia with Lewy bodies, traumatic brain injury (TBI), Parkinson's disease, prion disease, and dementia/neurocognitive issues due to HIV infection. Neurocognitive disorders are diagnosed as mild and major based on the severity of their symptoms."}}, {"canonical_name": "shingle", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "shingle", "book_id": "kosmos_humboldt_1845", "name": "shingle", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["shingle"], "contexts": ["deposit of small stones"]}, {"entity_id": "shingle", "book_id": "first_principles_spencer_1862", "name": "shingle", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["shingle"], "contexts": ["small stones worn by waves"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "shingle", "target_book": "first_principles_spencer_1862", "target_name": "shingle", "similarity": 0.805}], "id": 5957, "stable_key": "clu_1b9742f90191c660", "ground_truth": {"modern_name": "Gravel", "confidence": "high", "type": "mineral", "note": "In a geological context, 'shingle' refers to a deposit of small, smooth stones, which is equivalent to gravel.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "rainbows", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "rainbows", "book_id": "kosmos_humboldt_1845", "name": "rainbows", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["rainbows"], "contexts": ["optical phenomenon observed by Arago"]}, {"entity_id": "rainbows", "book_id": "first_principles_spencer_1862", "name": "Rainbows", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Rainbows"], "contexts": ["optical and meteorological phenomenon"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "rainbows", "target_book": "first_principles_spencer_1862", "target_name": "Rainbows", "similarity": 0.92}], "id": 5958, "stable_key": "clu_13832eb4044b6b42", "ground_truth": {"modern_name": "Rainbow", "confidence": "high", "type": "object"}}, {"canonical_name": "Bacon, Lord", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bacon,_lord", "book_id": "kosmos_humboldt_1845", "name": "Bacon, Lord", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bacon, Lord"], "contexts": ["philosopher and author of Novum Organon"]}, {"entity_id": "bacon,_francis", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bacon, Francis", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bacon, Francis"], "contexts": ["anticipated scientific discovery"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Bacon, Lord", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bacon, Francis", "similarity": 0.85}], "id": 5959, "stable_key": "clu_199b99a4a8765014-2", "ground_truth": {"modern_name": "Francis Bacon", "confidence": "high", "type": "person", "birth_year": 1561, "death_year": 1626, "description": "Philosopher, statesman, scientist, lawyer, jurist, author and orator", "wikidata_id": "Q37388", "wikidata_description": "English philosopher and statesman (1561\u20131626)", "wikipedia_url": "https://en.wikipedia.org/wiki/Francis%20Bacon", "wikipedia_extract": "Francis Bacon, 1st Viscount St Alban  (; 22 January 1561 \u2013 9 April 1626) was an English philosopher and statesman who served as Attorney General and Lord Chancellor of England under King James I. Bacon argued for the importance of natural philosophy, guided by the scientific method, and his works remained influential throughout the Scientific Revolution. Bacon has been called the father of empiricism. He argued for the possibility of scientific knowledge based only upon inductive reasoning and careful observation of events in nature. He believed that science could be achieved by the use of a sceptical and methodical approach whereby scientists aim to avoid misleading themselves. Although his most specific proposals about such a method, the Baconian method, did not have long-lasting influence, the general idea of the importance and possibility of a sceptical methodology makes Bacon one of the founders of the scientific method."}}, {"canonical_name": "atmospheric", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "atmospheric", "book_id": "kosmos_humboldt_1845", "name": "atmospheric", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["atmospheric"], "contexts": ["relating to the atmosphere"]}, {"entity_id": "atmospheric", "book_id": "first_principles_spencer_1862", "name": "atmospheric", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["atmospheric"], "contexts": ["geological agency related to air"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "atmospheric", "target_book": "first_principles_spencer_1862", "target_name": "atmospheric", "similarity": 1.0}], "id": 5960, "stable_key": "clu_014f1d87a4495cd4", "ground_truth": {"modern_name": "Atmospheric", "confidence": "high", "type": "concept", "wikidata_id": "Q8104", "wikidata_description": "layer of gases surrounding a material body"}}, {"canonical_name": "showers of meteors", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "showers_of_meteors", "book_id": "kosmos_humboldt_1845", "name": "showers of meteors", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["showers of meteors"], "contexts": ["meteorological events"]}, {"entity_id": "meteoros", "book_id": "polyanthea_medicinal", "name": "meteoros", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["meteoros"], "contexts": ["meteors"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "showers of meteors", "target_book": "polyanthea_medicinal", "target_name": "meteoros", "similarity": 0.901}], "id": 5961, "stable_key": "clu_71494b0712be7db0-2", "ground_truth": {"modern_name": "Meteor shower", "confidence": "high", "type": "concept", "wikidata_id": "Q105000", "wikidata_description": "celestial event caused by streams of meteoroids entering Earth's atmosphere", "note": "The term 'meteoros' in 'polyanthea_medicinal' likely refers to atmospheric phenomena or meteors, aligning with 'showers of meteors'."}}, {"canonical_name": "Eruptions", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "eruptions", "book_id": "kosmos_humboldt_1845", "name": "Eruptions", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Eruptions"], "contexts": ["volcanic phenomena"]}, {"entity_id": "eruptions,_volcanic", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Eruptions, volcanic", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Eruptions, volcanic"], "contexts": ["recorded geological events"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Eruptions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Eruptions, volcanic", "similarity": 0.921}], "id": 5962, "stable_key": "clu_e2f71fcebe11a80d-2", "ground_truth": {"modern_name": "Volcanic eruption", "confidence": "high", "type": "concept", "note": "The term 'volcanic' in early modern texts, especially when referring to physical phenomena like eruptions and vents, aligns with the modern concept of volcanic activity. While not a disease, it was often discussed in natural philosophy alongside geological processes that could have perceived impacts on the 'health' of the planet.", "wikidata_id": "Q7692360", "wikidata_description": "natural phenomenon where lava, hot gases or other substances are emitted suddenly from a geological feature", "wikipedia_url": "https://en.wikipedia.org/wiki/Volcanic%20eruption", "modern_term": "Volcanic eruptions", "wikipedia_extract": "A volcanic eruption occurs when material is expelled from a volcanic vent or fissure. Several types of volcanic eruptions have been distinguished by volcanologists. These are often named after famous volcanoes where that type of behavior has been observed. Some volcanoes may exhibit only one characteristic type of eruption during a period of activity, while others may display an entire sequence of types all in one eruptive series. There are three main types of volcanic eruptions. Magmatic eruptions involve the decompression of gas within magma that propels it forward."}}, {"canonical_name": "starry clusters", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "starry_clusters", "book_id": "kosmos_humboldt_1845", "name": "starry clusters", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["starry clusters"], "contexts": ["groups of stars"]}, {"entity_id": "cluster_of_stars", "book_id": "connexion_physical_sciences_somerville_1858", "name": "cluster of stars", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["cluster of stars"], "contexts": ["group of stars bound by gravity"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "starry clusters", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "cluster of stars", "similarity": 0.908}], "id": 5963, "stable_key": "clu_8e2264d00d04a24d", "ground_truth": {"modern_name": "Star cluster", "confidence": "high", "type": "object"}}, {"canonical_name": "scenery", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "scenery", "book_id": "kosmos_humboldt_1845", "name": "scenery", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["scenery"], "contexts": ["visual appearance of landscape"]}, {"entity_id": "landscapes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Landscapes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Landscapes"], "contexts": ["scenic views produced by photography"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "scenery", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Landscapes", "similarity": 0.901}], "id": 5964, "stable_key": "clu_6975e2e4f5a8891d", "ground_truth": {"modern_name": "Scene", "confidence": "high", "type": "concept", "wikidata_id": "Q28431605", "wikidata_description": "species of green algae", "wikipedia_url": "https://en.wikipedia.org/wiki/Scene_(subculture)", "wikipedia_extract": "The scene subculture is a youth subculture that emerged during the early 2000s in the United States from the pre-existing emo subculture. The subculture became popular with adolescents from the mid 2000s to the early 2010s. Members of the scene subculture are referred to as scene kids, trendies, or scenesters. Scene fashion consists of skinny jeans, bright-colored clothing, a signature hairstyle consisting of straight, flat hair with long bangs covering the forehead, and bright-colored hair dye. Music genres associated with the scene subculture include metalcore, crunkcore, deathcore, electronic music, and pop punk. From the mid-2000s to early 2010s, scene fashion gained popularity among teens and the music associated with the subculture achieved commercial success in both the underground and the mainstream."}}, {"canonical_name": "radiations of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "radiations_of_heat", "book_id": "kosmos_humboldt_1845", "name": "radiations of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["radiations of heat"], "contexts": ["emission of thermal energy"]}, {"entity_id": "thermal_radiations", "book_id": "first_principles_spencer_1862", "name": "thermal radiations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["thermal radiations"], "contexts": ["radiations associated with heat"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "radiations of heat", "target_book": "first_principles_spencer_1862", "target_name": "thermal radiations", "similarity": 0.923}], "id": 5965, "stable_key": "clu_64c41c0b0bc4ad37-3", "ground_truth": {"modern_name": "Thermal radiation", "confidence": "high", "type": "concept", "wikidata_id": "Q58469017", "wikidata_description": "scholarly article in Physical Review B, vol. 75 no. 20, May 2007"}}, {"canonical_name": "Lyell, Charles", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "lyell,_charles", "book_id": "kosmos_humboldt_1845", "name": "Lyell, Charles", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Lyell, Charles"], "contexts": ["investigated extinct life and rocks"]}, {"entity_id": "lyell,_sir_charles", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Lyell, Sir Charles", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Lyell, Sir Charles"], "contexts": ["theory of temperature changes"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Lyell, Charles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Lyell, Sir Charles", "similarity": 0.961}], "id": 5966, "stable_key": "clu_9f197b248e0a368d-4", "ground_truth": {"modern_name": "Charles Lyell", "confidence": "high", "type": "person", "birth_year": 1797, "death_year": 1875, "description": "Scottish geologist, author of 'Principles of Geology'", "wikidata_id": "Q76126037", "wikidata_description": "Peerage person ID=549048", "note": "The text mentions both 'Mr. Lyell' and 'Mr. Lassell'. 'Mr. Lyell' is strongly associated with 'Principles of Geology', identifying Charles Lyell. 'Mr. Lassell' is likely William Lassell, an astronomer, as mentioned in the context of astronomy."}}, {"canonical_name": "social condition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "social_condition", "book_id": "kosmos_humboldt_1845", "name": "social condition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["social condition"], "contexts": ["state of society"]}, {"entity_id": "social_conditions", "book_id": "first_principles_spencer_1862", "name": "social conditions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["social conditions"], "contexts": ["environmental factors influencing society"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "social condition", "target_book": "first_principles_spencer_1862", "target_name": "social conditions", "similarity": 0.919}], "id": 5967, "stable_key": "clu_0a01f7fb7ad77b90", "ground_truth": {"modern_name": "Social conditions", "confidence": "high", "type": "concept", "wikidata_id": "Q1261842", "wikidata_description": "quality of life and opportunities of a group as determined by occupation, income, education, neighbourhood, etc."}}, {"canonical_name": "tropical scenery", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "tropical_scenery", "book_id": "kosmos_humboldt_1845", "name": "tropical scenery", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["tropical scenery"], "contexts": ["magnificent natural scenes"]}, {"entity_id": "tropical_wildernesses", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tropical wildernesses", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["tropical wildernesses"], "contexts": ["untamed regions in tropics"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "tropical scenery", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tropical wildernesses", "similarity": 0.891}], "id": 5968, "stable_key": "clu_e4f5231350c5de13", "ground_truth": {"modern_name": "Tropical landscapes", "confidence": "high", "type": "place", "note": "While 'tropical scenery' is descriptive, 'landscapes' encompasses the broader concept of natural regions."}}, {"canonical_name": "Peters, Dr.", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "peters,_dr_", "book_id": "kosmos_humboldt_1845", "name": "Peters, Dr.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Peters, Dr."], "contexts": ["velocity of stones from Aetna"]}, {"entity_id": "peters,_mr_", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Peters, Mr.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Peters, Mr."], "contexts": ["discovered comet, calculated star distances"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Peters, Dr.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Peters, Mr.", "similarity": 0.859}], "id": 5969, "stable_key": "clu_94e265b4399748f7", "ground_truth": {"modern_name": "Christian August Peters", "confidence": "high", "type": "person", "birth_year": 1752, "death_year": 1828, "description": "Astronomer who observed comets and calculated star distances.", "note": "There were multiple individuals named Peters. This identification is based on the described astronomical contributions."}}, {"canonical_name": "star dust", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "star_dust", "book_id": "kosmos_humboldt_1845", "name": "star dust", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["star dust"], "contexts": ["interstellar material"]}, {"entity_id": "star_dust", "book_id": "connexion_physical_sciences_somerville_1858", "name": "star dust", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["star dust"], "contexts": ["material in Milky Way"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "star dust", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "star dust", "similarity": 1.0}], "id": 5970, "stable_key": "clu_45684ed2b17efdb5", "ground_truth": {"modern_name": "stardust", "confidence": "high", "type": "concept", "note": "The mention of 'star' alone in 'first_principles_spencer_1862' might be ambiguous, but the context of 'stardust' in other sources strongly suggests this referent.", "wikidata_id": "Q93717770", "wikidata_description": "vocal track by Willie Nelson; 1978 studio recording; cover version"}}, {"canonical_name": "New Bedford", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "new_bedford", "book_id": "kosmos_humboldt_1845", "name": "New Bedford", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["New Bedford"], "contexts": ["location where comet was observed"]}, {"entity_id": "bedford", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bedford", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bedford"], "contexts": ["location of Admiral Smyth's observatory"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "New Bedford", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bedford", "similarity": 0.918}], "id": 5971, "stable_key": "clu_3b70a65c9c265212", "ground_truth": {"modern_name": "New Bedford", "confidence": "high", "type": "place", "country": "United States", "wikidata_id": "Q49147", "wikidata_description": "city in Bristol County, Massachusetts, United States", "wikipedia_extract": "New Bedford is a city in Bristol County, Massachusetts, United States. It is located on the Acushnet River in what is known as the South Coast region, abutting Buzzards Bay. At the 2020 census, New Bedford had a population of 101,079, making it the state's ninth-largest city and the largest of the South Coast region. It is the second-largest city in the Providence metropolitan area and included in the greater Boston combined statistical area. Up through the 17th century, the area was the territory of the Wampanoag Indians. English colonists bought the land on which New Bedford would later be built from the Wampanoag in 1652, and the original colonial settlement that would later become the city was founded by English Quakers in the late 17th century.", "wikipedia_url": "https://en.wikipedia.org/wiki/New_Bedford,_Massachusetts"}}, {"canonical_name": "Lana", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "lana", "book_id": "historia_medicinal_monardes_1574", "name": "Lana", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Lana"], "contexts": ["material brought from the Indies"]}, {"entity_id": "lani", "book_id": "ricettario_fiorentino_1597", "name": "lani", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["lani"], "contexts": ["ingredient in a syrup"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Lana", "target_book": "ricettario_fiorentino_1597", "target_name": "lani", "similarity": 0.881}], "id": 5972, "stable_key": "clu_b222fef89ac3716b", "ground_truth": {"modern_name": "Wool", "confidence": "high", "type": "concept", "note": "The context 'material brought from the Indies' suggests a specific type of wool, possibly from South America (like alpaca or vicu\u00f1a), but the term 'Lana' itself broadly refers to wool.", "wikidata_id": "Q42329", "wikidata_description": "natural fibre from the soft hair of sheep or other mammals"}}, {"canonical_name": "piedra de Sangre", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "piedra_de_sangre", "book_id": "historia_medicinal_monardes_1574", "name": "piedra de Sangre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["piedra de Sangre"], "contexts": ["stone with red spots like blood"]}, {"entity_id": "pedra_sanguinha", "book_id": "coloquios_da_orta_1563", "name": "pedra sanguinha", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["pedra sanguinha"], "contexts": ["ingredient in falcon plaster"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "piedra de Sangre", "target_book": "coloquios_da_orta_1563", "target_name": "pedra sanguinha", "similarity": 0.918}], "id": 5973, "stable_key": "clu_003967f1a80a3638", "ground_truth": {"modern_name": "Haematite", "confidence": "high", "type": "mineral", "note": "The description 'stone with red spots like blood' strongly points to haematite, a mineral known for its reddish-brown streak and often having blood-like inclusions."}}, {"canonical_name": "bracelete", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bracelete", "book_id": "historia_medicinal_monardes_1574", "name": "bracelete", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["bracelete"], "contexts": ["amulet worn on the arm"]}, {"entity_id": "braceletes_de_alambres", "book_id": "polyanthea_medicinal", "name": "braceletes de alambres", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["braceletes de alambres"], "contexts": ["bracelets made of wire"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "bracelete", "target_book": "polyanthea_medicinal", "target_name": "braceletes de alambres", "similarity": 0.882}], "id": 5974, "stable_key": "clu_18b68e08b22320ae", "ground_truth": {"modern_name": "Bracelet", "confidence": "high", "type": "object", "note": "The terms refer to adornments worn on the arm, fitting the definition of a bracelet. The specific materials (wire) provide further detail."}}, {"canonical_name": "reales", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "reales", "book_id": "historia_medicinal_monardes_1574", "name": "reales", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["reales"], "contexts": ["unit of weight"]}, {"entity_id": "reales", "book_id": "coloquios_da_orta_1563", "name": "reales", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["reales"], "contexts": ["currency unit"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "reales", "target_book": "coloquios_da_orta_1563", "target_name": "reales", "similarity": 1.0}], "id": 5975, "stable_key": "clu_fd4f1ee5c5b48d1b", "ground_truth": {"modern_name": "Real (currency)", "confidence": "high", "type": "concept", "note": "The context 'currency unit' definitively identifies 'reales' as a form of money. The mention of a 'unit of weight' is likely a secondary or archaic usage, or a misinterpretation in translation, as 'real' as a unit of weight is not common."}}, {"canonical_name": "Solatro", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "solatro", "book_id": "historia_medicinal_monardes_1574", "name": "Solatro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Solatro"], "contexts": ["plant root used to induce dreams"]}, {"entity_id": "solatro", "book_id": "ricettario_fiorentino_1597", "name": "solatro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["solatro"], "contexts": ["herb with high moisture content"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Solatro", "target_book": "ricettario_fiorentino_1597", "target_name": "solatro", "similarity": 0.792}], "id": 5976, "stable_key": "clu_0461d3b06ff8ba39", "ground_truth": {"modern_name": "Solanum", "confidence": "high", "type": "plant", "linnaean": "Solanum", "family": "Solanaceae", "note": "Refers to plants in the Solanum genus, which includes species like nightshade. Context suggests medicinal uses, potentially narcotic or dream-inducing.", "wikidata_id": "Q146555", "wikidata_description": "genus of plants"}}, {"canonical_name": "dia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dia", "book_id": "historia_medicinal_monardes_1574", "name": "dia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dia"], "contexts": ["time of day for drinking"]}, {"entity_id": "dia", "book_id": "polyanthea_medicinal", "name": "dia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dia"], "contexts": ["time of day"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "dia", "target_book": "polyanthea_medicinal", "target_name": "dia", "similarity": 1.0}], "id": 5977, "stable_key": "clu_e2871960ae5ff1f4-3", "ground_truth": {"modern_name": "day", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Day", "wikipedia_extract": "A day is the time period of a full rotation of the Earth with respect to the Sun. On average, this is 24 hours (86,400 seconds). As a day passes at a given location it experiences morning, afternoon, evening, and night. This daily cycle drives circadian rhythms in many organisms, which are vital to many life processes. A collection of sequential days is organized into calendars as dates, almost always into weeks, months and years. A solar calendar organizes dates based on the Sun's annual cycle, giving consistent start dates for the four seasons from year to year."}}, {"canonical_name": "partes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "partes", "book_id": "historia_medicinal_monardes_1574", "name": "partes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["partes"], "contexts": ["regions from which people come"]}, {"entity_id": "outras_muytas_partes", "book_id": "coloquios_da_orta_1563", "name": "outras muytas partes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["outras muytas partes"], "contexts": ["many other places"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "partes", "target_book": "coloquios_da_orta_1563", "target_name": "outras muytas partes", "similarity": 0.892}], "id": 5978, "stable_key": "clu_3f64b411cabaa88a", "ground_truth": {"wikipedia_extract": "Parte\u0161 (Serbian Cyrillic: \u041f\u0430\u0440\u0442\u0435\u0448) or Partesh (Albanian definite form: Parteshi), is a town and municipality located in the Gjilan District of Kosovo. The municipality was established on 19 August 2010. It is inhabited by Serbs, and as of 2013, it has an estimated population of 5,300 inhabitants. The municipality consists of town of Parte\u0161 and two villages: Pasjane and Donja Budriga. The settlements of Parte\u0161, Donja Budriga and Pasjane are inhabited by ethnic Serbs. There are four Serbian Orthodox churches within the municipality."}}, {"canonical_name": "agua caliente", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "agua_caliente", "book_id": "historia_medicinal_monardes_1574", "name": "agua caliente", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["agua caliente"], "contexts": ["hot water for treatment"]}, {"entity_id": "hot_water", "book_id": "connexion_physical_sciences_somerville_1858", "name": "hot water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["hot water"], "contexts": ["source of calorific rays"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "agua caliente", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "hot water", "similarity": 0.974}], "id": 5979, "stable_key": "clu_12867b3213c57313", "ground_truth": {"modern_name": "Hot water", "confidence": "high", "type": "concept", "note": "The contexts clearly indicate the common substance 'hot water' used for various purposes, including medical treatment and as a medium for heat."}}, {"canonical_name": "marido", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "marido", "book_id": "historia_medicinal_monardes_1574", "name": "marido", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["marido"], "contexts": ["husband"]}, {"entity_id": "marido", "book_id": "coloquios_da_orta_1563", "name": "marido", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["marido"], "contexts": ["husband"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "marido", "target_book": "coloquios_da_orta_1563", "target_name": "marido", "similarity": 1.0}], "id": 5980, "stable_key": "clu_54625d893ed6ccbb", "ground_truth": {"modern_name": "husband", "confidence": "high", "type": "concept", "note": "This refers to the role of husband, not a specific individual.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Lim\u00f3", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "lim\u00f3", "book_id": "historia_medicinal_monardes_1574", "name": "Lim\u00f3", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Lim\u00f3"], "contexts": ["fruit consumed for preservation"]}, {"entity_id": "limoeiro", "book_id": "coloquios_da_orta_1563", "name": "limoeiro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["limoeiro"], "contexts": ["tree with similar leaves"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Lim\u00f3", "target_book": "coloquios_da_orta_1563", "target_name": "limoeiro", "similarity": 0.887}], "id": 5981, "stable_key": "clu_1e4fcd8b583255a1", "ground_truth": {"modern_name": "Lemon", "confidence": "high", "type": "plant", "linnaean": "Citrus limon", "family": "Rutaceae"}}, {"canonical_name": "do\u00f1a Catalina de Viera", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "do\u00f1a_catalina_de_viera", "book_id": "historia_medicinal_monardes_1574", "name": "do\u00f1a Catalina de Viera", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["do\u00f1a Catalina de Viera"], "contexts": ["a lady, sister of the President"]}, {"entity_id": "dona_antonia_de_vilhena", "book_id": "polyanthea_medicinal", "name": "Dona Antonia de Vilhena", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Dona Antonia de Vilhena"], "contexts": ["woman in difficult labor"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "do\u00f1a Catalina de Viera", "target_book": "polyanthea_medicinal", "target_name": "Dona Antonia de Vilhena", "similarity": 0.874}], "id": 5982, "stable_key": "clu_24cb317a18923d07", "ground_truth": {"modern_name": "Catalina de Viera", "confidence": "medium", "type": "person", "description": "A noblewoman mentioned in a medical context.", "note": "Identified as 'do\u00f1a Catalina de Viera' and 'Dona Antonia de Vilhena', suggesting a possible conflation of names or a similar social standing."}}, {"canonical_name": "E\u017fcamonca", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "e\u017fcamonca", "book_id": "historia_medicinal_monardes_1574", "name": "E\u017fcamonca", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["E\u017fcamonca"], "contexts": ["plant with a leaf like Mechoacan"]}, {"entity_id": "e\u017fcamonea", "book_id": "polyanthea_medicinal", "name": "E\u017fcamonea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["E\u017fcamonea"], "contexts": ["potent purgative herb"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "E\u017fcamonca", "target_book": "polyanthea_medicinal", "target_name": "E\u017fcamonea", "similarity": 0.927}], "id": 5983, "stable_key": "clu_b4a1311ad4767211", "ground_truth": {"modern_name": "Jalap", "confidence": "high", "type": "plant", "linnaean": "Ipomoea purga Benth.", "family": "Convolvulaceae", "note": "The description 'leaf like Mechoacan' and 'potent purgative herb' strongly points to Jalap, often confused with Mechoacan (another purgative plant from the same genus). Escamonea is an older or variant name for jalap."}}, {"canonical_name": "cordial", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cordial", "book_id": "historia_medicinal_monardes_1574", "name": "cordial", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cordial"], "contexts": ["substance that strengthens the heart"]}, {"entity_id": "cordial", "book_id": "coloquios_da_orta_1563", "name": "cordial", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cordial"], "contexts": ["medicinal property of sandalwood"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "cordial", "target_book": "coloquios_da_orta_1563", "target_name": "cordial", "similarity": 1.0}], "id": 5984, "stable_key": "clu_4d460ab02ccf648a", "ground_truth": {"modern_name": "heart tonic", "confidence": "high", "type": "concept"}}, {"canonical_name": "medicinas venenosas", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "medicinas_venenosas", "book_id": "historia_medicinal_monardes_1574", "name": "medicinas venenosas", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["medicinas venenosas"], "contexts": ["harmful medicinal preparations"]}, {"entity_id": "remedio_veneno\u017fo", "book_id": "polyanthea_medicinal", "name": "remedio veneno\u017fo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["remedio veneno\u017fo"], "contexts": ["poisonous remedy"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "medicinas venenosas", "target_book": "polyanthea_medicinal", "target_name": "remedio veneno\u017fo", "similarity": 0.888}], "id": 5985, "stable_key": "clu_9f2ca95be9ec3180", "ground_truth": {"modern_name": "Poisonous medicines", "confidence": "high", "type": "concept", "note": "Medicinal substances that are toxic or can cause harm if not used carefully."}}, {"canonical_name": "vinagre E\u017fquilitico", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "vinagre_e\u017fquilitico", "book_id": "historia_medicinal_monardes_1574", "name": "vinagre E\u017fquilitico", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["vinagre E\u017fquilitico"], "contexts": ["squill vinegar"]}, {"entity_id": "vinagre_efquilitico", "book_id": "polyanthea_medicinal", "name": "vinagre efquilitico", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["vinagre efquilitico"], "contexts": ["vinegar used in remedy"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "vinagre E\u017fquilitico", "target_book": "polyanthea_medicinal", "target_name": "vinagre efquilitico", "similarity": 0.94}], "id": 5986, "stable_key": "clu_3bcee425371bc553", "ground_truth": {"modern_name": "Squill vinegar", "confidence": "high", "type": "preparation", "note": "Vinegar infused with squill, a medicinal plant."}}, {"canonical_name": "pulso desordenado", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pulso_desordenado", "book_id": "historia_medicinal_monardes_1574", "name": "pulso desordenado", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["pulso desordenado"], "contexts": ["disordered pulse"]}, {"entity_id": "accelerated_pulse", "book_id": "first_principles_spencer_1862", "name": "accelerated pulse", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["accelerated pulse"], "contexts": ["rapid heartbeat"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "pulso desordenado", "target_book": "first_principles_spencer_1862", "target_name": "accelerated pulse", "similarity": 0.907}], "id": 5987, "stable_key": "clu_0d33eae79c8b151f", "ground_truth": {"modern_name": "Pulse", "confidence": "high", "type": "disease", "description": "Rhythmic expansion and contraction of arteries, indicative of health or illness.", "note": "Refers to the physical symptom of pulse, and its variations.", "wikipedia_extract": "In medicine, pulse is the rhythmic expansion and contraction of an artery in response to the cardiac cycle (heartbeat). The pulse may be felt (palpated) in any place that allows an artery to be compressed near the surface of the body, such as at the neck (carotid artery), wrist (radial artery or ulnar artery), at the groin (femoral artery), behind the knee (popliteal artery), near the ankle joint (posterior tibial artery), and on foot (dorsalis pedis artery). The pulse is most commonly measured at the wrist or neck for adults and at the brachial artery (inner upper arm between the shoulder and elbow) for infants and very young children. A sphygmograph is an instrument for measuring the pulse. Claudius Galen was perhaps the first physiologist to describe the pulse. The pulse is an expedient tactile method of determination of systolic blood pressure to a trained observer."}}, {"canonical_name": "remedios que den calor", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "remedios_que_den_calor", "book_id": "historia_medicinal_monardes_1574", "name": "remedios que den calor", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["remedios que den calor"], "contexts": ["remedies that give heat"]}, {"entity_id": "remedios_quentes", "book_id": "polyanthea_medicinal", "name": "remedios quentes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["remedios quentes"], "contexts": ["hot medicinal substances"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "remedios que den calor", "target_book": "polyanthea_medicinal", "target_name": "remedios quentes", "similarity": 0.936}], "id": 5988, "stable_key": "clu_3163804c1706dfac", "ground_truth": {"modern_name": "Therapeutic heat", "confidence": "high", "type": "concept", "note": "Refers to the concept of medicines having warming properties within the humoral system.", "wikidata_id": "Q39870405", "wikidata_description": "scientific article published on March 1974", "wikipedia_extract": "A psychoactive drug, psychopharmaceutical, mind-altering drug, consciousness-altering drug, psychoactive substance, or psychotropic substance is a chemical substance that alters psychological functioning by modulating central nervous system (CNS) activity. Psychoactive and psychotropic drugs both affect the brain, with psychotropics sometimes referring to psychiatric drugs or high-abuse substances, while \u201cdrug\u201d can have negative connotations. Novel psychoactive substances are designer drugs made to mimic illegal ones and bypass laws. Psychoactive drug use dates back to prehistory for medicinal and consciousness-altering purposes, with evidence of widespread cultural use. Many animals intentionally consume psychoactive substances, and some traditional legends suggest animals first introduced humans to their use. Psychoactive substances are used across cultures for purposes ranging from medicinal and therapeutic treatment of mental disorders and pain, to performance enhancement.", "wikipedia_url": "https://en.wikipedia.org/wiki/Psychoactive_drug"}}, {"canonical_name": "Andromacho", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "andromacho", "book_id": "historia_medicinal_monardes_1574", "name": "Andromacho", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Andromacho"], "contexts": ["author of Theriaca"]}, {"entity_id": "andromaco", "book_id": "ricettario_fiorentino_1597", "name": "Andromaco", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Andromaco"], "contexts": ["ancient medical authority"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Andromacho", "target_book": "ricettario_fiorentino_1597", "target_name": "Andromaco", "similarity": 0.882}], "id": 5989, "stable_key": "clu_c3927d8b27af9967", "ground_truth": {"modern_name": "Andromachus the Elder", "confidence": "high", "type": "person", "description": "Ancient physician, author of Theriaca, medical authority", "wikidata_id": "Q891741", "wikidata_description": "Greek physician of the 1st century"}}, {"canonical_name": "dominus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dominus", "book_id": "historia_medicinal_monardes_1574", "name": "dominus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dominus"], "contexts": ["Hebrew word for lord"]}, {"entity_id": "dominus", "book_id": "coloquios_da_orta_1563", "name": "dominus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dominus"], "contexts": ["Latin for lord"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "dominus", "target_book": "coloquios_da_orta_1563", "target_name": "dominus", "similarity": 1.0}], "id": 5990, "stable_key": "clu_0f7f2fea13a157bb", "ground_truth": {"modern_name": "Lord", "confidence": "high", "type": "concept", "note": "The contexts indicate it's a translation or a term of respect in different languages, not a specific scientific or medical concept.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Bocara", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bocara", "book_id": "historia_medicinal_monardes_1574", "name": "Bocara", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bocara"], "contexts": ["city of Avi's origin"]}, {"entity_id": "bokara", "book_id": "coloquios_da_orta_1563", "name": "Bokara", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bokara"], "contexts": ["principal city of Uzbeks"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Bocara", "target_book": "coloquios_da_orta_1563", "target_name": "Bokara", "similarity": 0.89}], "id": 5991, "stable_key": "clu_5a82aaf1160bad91-2", "ground_truth": {"modern_name": "Bukhara", "confidence": "high", "type": "place", "description": "Historic city in Uzbekistan, a Silk Road hub.", "wikipedia_extract": "Bukhara ( buu-KHAR-\u0259) is the seventh-largest city in Uzbekistan by population, with 280,187 residents as of 1 January 2020. It is the capital of Bukhara Region. The Bukhara region has been inhabited for at least five millennia, and the city has existed for half that time. Located on the Silk Road, the city has long served as a center of trade, scholarship, culture, and religion. Bukhara served as the capital of the Uzbek states such as the Khanate of Bukhara, the Emirate of Bukhara and later the Bukhara People\u2019s Soviet Republic. It was the birthplace of the scholar Imam Bukhari.", "country": "Uzbekistan", "wikidata_id": "Q5764", "wikidata_description": "city in Bukhara Province of Uzbekistan"}}, {"canonical_name": "Melue", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "melue", "book_id": "historia_medicinal_monardes_1574", "name": "Melue", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Melue"], "contexts": ["author of antidotes"]}, {"entity_id": "melu\u00e8", "book_id": "ricettario_fiorentino_1597", "name": "Melu\u00e8", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Melu\u00e8"], "contexts": ["Medieval medical authority"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Melue", "target_book": "ricettario_fiorentino_1597", "target_name": "Melu\u00e8", "similarity": 0.684}], "id": 5992, "stable_key": "clu_ed1451a5fc5d3b8d", "ground_truth": {"modern_name": "Melue", "confidence": "high", "type": "person", "description": "Medieval medical authority cited by Monardes"}}, {"canonical_name": "paroxismo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "paroxismo", "book_id": "historia_medicinal_monardes_1574", "name": "paroxismo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["paroxismo"], "contexts": ["sudden onset of disease symptoms"]}, {"entity_id": "paroxismum", "book_id": "polyanthea_medicinal", "name": "paroxismum", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["paroxismum"], "contexts": ["paroxysm of illness"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "paroxismo", "target_book": "polyanthea_medicinal", "target_name": "paroxismum", "similarity": 0.909}], "id": 5993, "stable_key": "clu_b7ff87b099dfb817", "ground_truth": {"modern_name": "Paroxysm", "confidence": "high", "type": "disease", "modern_term": "Paroxysm", "wikidata_id": "Q1479494", "wikidata_description": "disease of the blood characterized by destruction of red blood cells by the complement system, a part of the body's innate immune system", "wikipedia_url": "https://en.wikipedia.org/wiki/Paroxysmal%20nocturnal%20hemoglobinuria", "wikipedia_extract": "Paroxysmal nocturnal hemoglobinuria (PNH) is a rare, acquired, life-threatening disease of the blood characterized by destruction of red blood cells by the complement system, a part of the body's innate immune system. This destructive process occurs due to deficiency of the red blood cell surface protein DAF, which normally inhibits such immune reactions. Since the complement cascade attacks the red blood cells within the blood vessels of the circulatory system, the red blood cell destruction (hemolysis) is considered an intravascular hemolytic anemia. There is ongoing research into other key features of the disease, such as the high incidence of venous blood clot formation. Research suggests that PNH thrombosis (a blood clot) is caused by both the absence of GPI-anchored complement regulatory proteins (CD55 and CD59) on PNH platelets and the excessive consumption of nitric oxide (NO). PNH is the only hemolytic anemia caused by an acquired (rather than inherited) intrinsic defect in the cell membrane (deficiency of glycophosphatidylinositol or GPI) leading to the absence of protective exterior surface proteins that normally attach via a GPI anchor."}}, {"canonical_name": "Alquimia", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "alquimia", "book_id": "historia_medicinal_monardes_1574", "name": "Alquimia", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Alquimia"], "contexts": ["field of study concerning metal generation"]}, {"entity_id": "alchemy", "book_id": "first_principles_spencer_1862", "name": "alchemy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["alchemy"], "contexts": ["hope of private benefit disclosure"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Alquimia", "target_book": "first_principles_spencer_1862", "target_name": "alchemy", "similarity": 0.948}], "id": 5994, "stable_key": "clu_79be077d6be38fdc-3", "ground_truth": {"modern_name": "alchemy", "confidence": "high", "type": "concept", "description": "Ancient practice involving chemical transformation and medicine.", "note": "Also encompasses the chemical art and practice.", "wikipedia_extract": "Alchemy (from the Arabic word al-k\u012bm\u012b\u0101, \u0627\u0644\u0643\u06cc\u0645\u06cc\u0627\u0621) is an ancient branch of natural philosophy, a philosophical and protoscientific tradition that was historically practised in China, India, the Muslim world, and Europe. In its Western form, alchemy is first attested in a number of pseudepigraphical texts written in Greco-Roman Egypt during the first few centuries AD. Greek-speaking alchemists often referred to their craft as \"the Art\" (\u03c4\u03ad\u03c7\u03bd\u03b7) or \"Knowledge\" (\u1f10\u03c0\u03b9\u03c3\u03c4\u03ae\u03bc\u03b7), and it was often characterised as mystic (\u03bc\u03c5\u03c3\u03c4\u03b9\u03ba\u03ae), sacred (\u1f31\u025b\u03c1\u03ac), or divine (\u03b8\u025b\u00ed\u03b1). Alchemists attempted to purify, mature, and perfect certain materials. Common aims were chrysopoeia, the transmutation of \"base metals\" (e.g., lead) into \"noble metals\" (particularly gold); the creation of an elixir of immortality; and the creation of panaceas able to cure any disease. The perfection of the human body and soul was thought to result from the alchemical magnum opus (\"Great Work\")."}}, {"canonical_name": "naoVictoria", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "naovictoria", "book_id": "historia_medicinal_monardes_1574", "name": "naoVictoria", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["naoVictoria"], "contexts": ["The ship Victoria, circumnavigated the world"]}, {"entity_id": "nau_victoria", "book_id": "coloquios_da_orta_1563", "name": "nau Victoria", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["nau Victoria"], "contexts": ["Ship that returned from voyage"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "naoVictoria", "target_book": "coloquios_da_orta_1563", "target_name": "nau Victoria", "similarity": 0.89}], "id": 5995, "stable_key": "clu_b388fadab3cee03b", "ground_truth": {"modern_name": "Victoria (ship)", "confidence": "high", "type": "object", "wikidata_id": "Q86573224", "wikidata_description": "researcher"}}, {"canonical_name": "Herculano", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "herculano", "book_id": "historia_medicinal_monardes_1574", "name": "Herculano", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Herculano"], "contexts": ["authority on vomiting and iron"]}, {"entity_id": "herculano", "book_id": "coloquios_da_orta_1563", "name": "Herculano", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Herculano"], "contexts": ["published historical documents"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Herculano", "target_book": "coloquios_da_orta_1563", "target_name": "Herculano", "similarity": 0.689}], "id": 5996, "stable_key": "clu_d7781f7e657ae787", "ground_truth": {"modern_name": "Herculano", "confidence": "high", "type": "person", "description": "Medical authority on vomiting and iron", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Coliget", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "coliget", "book_id": "historia_medicinal_monardes_1574", "name": "Coliget", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Coliget"], "contexts": ["a work by Auerois"]}, {"entity_id": "coliget", "book_id": "coloquios_da_orta_1563", "name": "Coliget", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Coliget"], "contexts": ["work by Avenrrois"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Coliget", "target_book": "coloquios_da_orta_1563", "target_name": "Coliget", "similarity": 1.0}], "id": 5997, "stable_key": "clu_6406a70815d18611", "ground_truth": {"modern_name": "Coliget", "confidence": "high", "type": "text", "note": "Likely a variant spelling of 'Colliget', a work by Averroes.", "wikidata_id": "Q18643682", "wikidata_description": "arab medical encyclopedia by Averroes"}}, {"canonical_name": "Chri\u017fto", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "chri\u017fto", "book_id": "historia_medicinal_monardes_1574", "name": "Chri\u017fto", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Chri\u017fto"], "contexts": ["mentioned in relation to preparation"]}, {"entity_id": "chri\u017fto", "book_id": "polyanthea_medicinal", "name": "Chri\u017fto", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Chri\u017fto"], "contexts": ["religious figure"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Chri\u017fto", "target_book": "polyanthea_medicinal", "target_name": "Chri\u017fto", "similarity": 1.0}], "id": 5998, "stable_key": "clu_3600b49e2756ae09", "ground_truth": {"modern_name": "Christ", "confidence": "low", "type": "person", "description": "Central figure of Christianity; historical/religious reference.", "note": "This is a religious figure, not a historical medical person. The context suggests a devotional or symbolic reference rather than a scientific or medical one.", "wikidata_id": "Q302", "wikidata_description": "central figure of Christianity (6 or 4 BC \u2013 AD 30 or 33)"}}, {"canonical_name": "inftrumentos", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "inftrumentos", "book_id": "historia_medicinal_monardes_1574", "name": "inftrumentos", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["inftrumentos"], "contexts": ["tools for surgery and barbering"]}, {"entity_id": "inftrument", "book_id": "polyanthea_medicinal", "name": "inftrument", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["inftrument"], "contexts": ["instrument used in experiment"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "inftrumentos", "target_book": "polyanthea_medicinal", "target_name": "inftrument", "similarity": 0.896}], "id": 5999, "stable_key": "clu_18ed147dc260442b", "ground_truth": {"modern_name": "instrument", "confidence": "high", "type": "object", "wikidata_id": "Q6554101", "wikidata_description": "any device intended to be used for medical purposes"}}, {"canonical_name": "di\u017finter\u00edas", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "di\u017finter\u00edas", "book_id": "historia_medicinal_monardes_1574", "name": "di\u017finter\u00edas", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["di\u017finter\u00edas"], "contexts": ["intestinal inflammation"]}, {"entity_id": "di\u017fenterias", "book_id": "polyanthea_medicinal", "name": "di\u017fenterias", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["di\u017fenterias"], "contexts": ["condition treated with remedies"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "di\u017finter\u00edas", "target_book": "polyanthea_medicinal", "target_name": "di\u017fenterias", "similarity": 0.921}], "id": 6000, "stable_key": "clu_8e12f99dbc85442f", "ground_truth": {"modern_name": "Dysentery", "confidence": "high", "type": "disease", "description": "An intestinal inflammation causing severe diarrhea with blood and mucus.", "wikipedia_extract": "Dysentery (UK: , US: ), historically known as the bloody flux, is a type of gastroenteritis that results in bloody diarrhea. Other symptoms may include fever, abdominal pain, and a feeling of incomplete defecation. Complications may include dehydration. The cause of dysentery is usually the bacteria from genus Shigella, in which case it is known as shigellosis, or the amoeba Entamoeba histolytica; then it is called amoebiasis. Other causes may include certain chemicals, other bacteria, other protozoa, or parasitic worms. It may spread between people."}}, {"canonical_name": "Philofofos", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "philofofos", "book_id": "historia_medicinal_monardes_1574", "name": "Philofofos", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Philofofos"], "contexts": ["ancient philosophers"]}, {"entity_id": "philofophos", "book_id": "polyanthea_medicinal", "name": "Philofophos", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Philofophos"], "contexts": ["ancient thinkers"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Philofofos", "target_book": "polyanthea_medicinal", "target_name": "Philofophos", "similarity": 0.867}], "id": 6001, "stable_key": "clu_dc6ec678707a2ae0-2", "ground_truth": {"modern_name": "philologists", "confidence": "high", "type": "person", "description": "Scholars of language, literature, and ancient texts."}}, {"canonical_name": "Expulfiva", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "expulfiva", "book_id": "historia_medicinal_monardes_1574", "name": "Expulfiva", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Expulfiva"], "contexts": ["expulsive virtue"]}, {"entity_id": "expulfiva", "book_id": "polyanthea_medicinal", "name": "expulfiva", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["expulfiva"], "contexts": ["expulsive faculty of kidneys"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Expulfiva", "target_book": "polyanthea_medicinal", "target_name": "expulfiva", "similarity": 0.978}], "id": 6002, "stable_key": "clu_6fdedf165324a036", "ground_truth": {"modern_name": "expulsive faculty", "confidence": "high", "type": "concept"}}, {"canonical_name": "pan", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pan", "book_id": "historia_medicinal_monardes_1574", "name": "pan", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["pan"], "contexts": ["food made from grain"]}, {"entity_id": "pan", "book_id": "coloquios_da_orta_1563", "name": "pan", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["pan"], "contexts": ["another name for betle leaf"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "pan", "target_book": "coloquios_da_orta_1563", "target_name": "pan", "similarity": 1.0}], "id": 6003, "stable_key": "clu_99ad2ab9551fd3b6", "ground_truth": {"modern_name": "Betel leaf", "confidence": "low", "type": "plant", "note": "The term 'pan' is ambiguous. In the context of the Monardes text, it likely refers to bread or food from grain. However, one mention in the 'Coloquios da Orta' suggests 'pan' might be a misspelling or colloquialism for 'betel' or a similar plant leaf used for chewing, especially given the geographical context of the text (Asia/Americas). Further context from the original texts is needed for certainty.", "wikidata_id": "Q130149531", "wikidata_description": "scholarly article published on 25 January 2018", "wikipedia_extract": "The areca nut ( or ) or betel nut () is the fruit of the areca palm (Areca catechu). The palm is originally native to the Philippines, but was carried widely through the tropics by the Austronesian migrations and trade since at least 1500 BCE due to its use in betel nut chewing. It is widespread in cultivation and is considered naturalized in much of the tropical Pacific (Melanesia and Micronesia), South Asia, Southeast Asia, and parts of east Africa. It is not to be confused with betel (Piper betle) leaves that are often used to wrap it. The practice of betel nut chewing, often together with other herbs as a stimulant drug, dates back thousands of years, and continues to the present day in many countries. Betel nut chewing is addictive due to the presence of the stimulant arecoline and causes adverse health effects\u2014mainly oral and esophageal cancers, as well as cardiovascular disease.", "wikipedia_url": "https://en.wikipedia.org/wiki/Areca_nut"}}, {"canonical_name": "cubilece", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cubilece", "book_id": "historia_medicinal_monardes_1574", "name": "cubilece", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["cubilece"], "contexts": ["container where snow floats for cooling"]}, {"entity_id": "cube", "book_id": "connexion_physical_sciences_somerville_1858", "name": "cube", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["cube"], "contexts": ["solid contained by six plane square surfaces"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "cubilece", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "cube", "similarity": 0.901}], "id": 6004, "stable_key": "clu_2cc384aeecd554d4", "ground_truth": {"modern_name": "cube", "confidence": "high", "type": "object"}}, {"canonical_name": "bola", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bola", "book_id": "coloquios_da_orta_1563", "name": "bola", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["bola"], "contexts": ["Arabic name for mocebar"]}, {"entity_id": "bolas", "book_id": "polyanthea_medicinal", "name": "bolas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["bolas"], "contexts": ["balls found in stomachs"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "bola", "target_book": "polyanthea_medicinal", "target_name": "bolas", "similarity": 0.923}], "id": 6005, "stable_key": "clu_0c4aa0111f771c6b-3", "ground_truth": {"modern_name": "Bezoar", "confidence": "high", "type": "mineral", "note": "'Bola' is the Arabic word for bezoar, a medicinal concretion found in the stomach of some animals. 'Bolas' in the second source likely refers to the same.", "wikidata_id": "Q897514", "wikidata_description": "subspecies of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Bezoar%20ibex", "wikipedia_extract": "The bezoar ibex (Capra aegagrus aegagrus) is a wild goat subspecies that is native to the montane forested areas in the Anatolia, Caucasus and the Zagros Mountains. The bezoar ibex, which weighs around 60 kg (130 lb) is known particularly for the size of its horns; it possesses the world's longest horns in relation to body weight, and can exceed 1.4 m (4 ft 7 in) high, those in the south and east desert ranges are typically smaller by 30 percent. Females are slightly smaller and their horns tend to grow to 0.2 m (7.9 in). Males have a dark brown summer coat, while the females have a more reddish-gold, and both sexes shift to a gray-colored coat in winter. Both sexes also have a tuft of hair extending from the chin. The ibexes have a black stripe from the spine that extends over the shoulder, limbs, and neck.", "description": "Calculus found in the stomach of animals, used as an antidote."}}, {"canonical_name": "moderno doctor", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "moderno_doctor", "book_id": "coloquios_da_orta_1563", "name": "moderno doctor", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["moderno doctor"], "contexts": ["Contemporary physician"]}, {"entity_id": "doutores_modernos", "book_id": "polyanthea_medicinal", "name": "Doutores modernos", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Doutores modernos"], "contexts": ["modern scholars who discovered blood circulation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "moderno doctor", "target_book": "polyanthea_medicinal", "target_name": "Doutores modernos", "similarity": 0.883}], "id": 6006, "stable_key": "clu_bea76f58a4ed17d0", "ground_truth": {"modern_name": "modern physicians", "confidence": "high", "type": "concept", "note": "Refers to physicians practicing in contemporary times relative to the texts' publication.", "wikidata_id": "Q15924224", "wikidata_description": "physician with medical specialty internal medicine; is skilled in the management of patients who have undifferentiated or multi-system disease processes; cares for hospitalized and ambulatory patients"}}, {"canonical_name": "socotorino", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "socotorino", "book_id": "coloquios_da_orta_1563", "name": "socotorino", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["socotorino"], "contexts": ["aloes from Socotora island"]}, {"entity_id": "socotorino", "book_id": "ricettario_fiorentino_1597", "name": "Socotorino", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Socotorino"], "contexts": ["type of aloe juice"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "socotorino", "target_book": "ricettario_fiorentino_1597", "target_name": "Socotorino", "similarity": 0.851}], "id": 6007, "stable_key": "clu_44bc0e29d59e0a78", "ground_truth": {"modern_name": "Socotrine Aloe", "confidence": "high", "type": "plant", "linnaean": "Aloe perryi Baker", "family": "Asphodelaceae", "note": "The specific species can vary, but 'Socotrine' refers to aloe from the island of Socotra.", "wikidata_id": "Q140942", "wikidata_description": "species of plant"}}, {"canonical_name": "Ghins", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ghins", "book_id": "coloquios_da_orta_1563", "name": "Ghins", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Ghins"], "contexts": ["people who buy amber as medicine"]}, {"entity_id": "giges", "book_id": "polyanthea_medicinal", "name": "Giges", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Giges"], "contexts": ["King, ministered to someone"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Ghins", "target_book": "polyanthea_medicinal", "target_name": "Giges", "similarity": 0.897}], "id": 6008, "stable_key": "clu_7fdd6bb09f903ea0", "ground_truth": {"modern_name": "Giges", "confidence": "medium", "type": "person", "description": "Historical or legendary figure, possibly a king or minister", "note": "The spelling variation 'Ghins' suggests a potential corruption or phonetic transcription. 'Giges' refers to a Lydian king.", "wikidata_id": "Q312537", "wikidata_description": "king of Lydia, 7th century BC"}}, {"canonical_name": "forma\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "forma\u00e7\u00e3o", "book_id": "coloquios_da_orta_1563", "name": "forma\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["forma\u00e7\u00e3o"], "contexts": ["process of amber creation"]}, {"entity_id": "forma\u00e7a\u00f3", "book_id": "polyanthea_medicinal", "name": "forma\u00e7a\u00f3", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["forma\u00e7a\u00f3"], "contexts": ["formation, the process of creation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "forma\u00e7\u00e3o", "target_book": "polyanthea_medicinal", "target_name": "forma\u00e7a\u00f3", "similarity": 0.806}], "id": 6009, "stable_key": "clu_df8c3a295cee3088", "ground_truth": {"modern_name": "Formation", "confidence": "high", "type": "concept", "wikidata_id": "Q176799", "wikidata_description": "organization formed as part of an armed force"}}, {"canonical_name": "corollas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "corollas", "book_id": "coloquios_da_orta_1563", "name": "corollas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["corollas"], "contexts": ["part of flowers with long tubes"]}, {"entity_id": "corolla", "book_id": "first_principles_spencer_1862", "name": "corolla", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["corolla"], "contexts": ["part of a flower"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "corollas", "target_book": "first_principles_spencer_1862", "target_name": "corolla", "similarity": 0.918}], "id": 6010, "stable_key": "clu_02ad7f2a5f43fc43", "ground_truth": {"modern_name": "Corolla", "confidence": "high", "type": "plant", "note": "This refers to the collective petals of a flower, a botanical term."}}, {"canonical_name": "mal de rayva", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mal_de_rayva", "book_id": "coloquios_da_orta_1563", "name": "mal de rayva", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["mal de rayva"], "contexts": ["rabies"]}, {"entity_id": "rayva", "book_id": "polyanthea_medicinal", "name": "rayva", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["rayva"], "contexts": ["rabies"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "mal de rayva", "target_book": "polyanthea_medicinal", "target_name": "rayva", "similarity": 0.909}], "id": 6011, "stable_key": "clu_e2719ab7a24e5bea", "ground_truth": {"modern_name": "Rabies", "confidence": "high", "type": "disease", "modern_term": "Rabies", "note": "The term 'mal de rayva' directly translates to 'sickness of rayva', and context points to rabies."}}, {"canonical_name": "assassino", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "assassino", "book_id": "coloquios_da_orta_1563", "name": "assassino", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["assassino"], "contexts": ["word derived from HasHschi"]}, {"entity_id": "homicida", "book_id": "polyanthea_medicinal", "name": "homicida", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["homicida"], "contexts": ["person who commits homicide"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "assassino", "target_book": "polyanthea_medicinal", "target_name": "homicida", "similarity": 0.938}], "id": 6012, "stable_key": "clu_792f5fd3f227f46d", "ground_truth": {"modern_name": "Assassin", "confidence": "high", "type": "concept", "note": "Both 'assassino' and 'homicida' refer to a murderer, with 'assassino' having a specific etymological origin mentioned.", "wikidata_id": "Q768510", "wikidata_description": "family of insects"}}, {"canonical_name": "boli", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "boli", "book_id": "coloquios_da_orta_1563", "name": "boli", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["boli"], "contexts": ["substance described by Averrois"]}, {"entity_id": "boli", "book_id": "ricettario_fiorentino_1597", "name": "boli", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["boli"], "contexts": ["boluses, a type of compound medicine"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "boli", "target_book": "ricettario_fiorentino_1597", "target_name": "boli", "similarity": 1.0}], "id": 6013, "stable_key": "clu_ffbfa43a91aa4e07", "ground_truth": {"modern_name": "Bolus (medicine)", "confidence": "high", "type": "object", "note": "The term 'boli' in medicinal contexts, especially when described as a 'type of compound medicine,' refers to a bolus."}}, {"canonical_name": "petro", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "petro", "book_id": "coloquios_da_orta_1563", "name": "petro", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["petro"], "contexts": ["substance described by Averrois"]}, {"entity_id": "petro", "book_id": "polyanthea_medicinal", "name": "petro", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["petro"], "contexts": ["ingredient in a suffumigation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "petro", "target_book": "polyanthea_medicinal", "target_name": "petro", "similarity": 0.787}], "id": 6014, "stable_key": "clu_150b0b4a83af6d80-2", "ground_truth": {"modern_name": "Petroleum", "confidence": "high", "type": "chemical", "wikidata_id": "Q50812134", "wikidata_description": "Academic journal published by Elsevier , covering the subjects: Technology: Chemical technology: Oils, fats, and waxes: Petroleum refining. Petroleum products | Technology: Engineering (General). Civil engineering (General): Engineering ge", "note": "The term 'petro' in early modern texts often referred to naphtha or bitumen, which are types of petroleum products, particularly in alchemical contexts."}}, {"canonical_name": "velho", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "velho", "book_id": "coloquios_da_orta_1563", "name": "velho", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["velho"], "contexts": ["old"]}, {"entity_id": "velho", "book_id": "polyanthea_medicinal", "name": "velho", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["velho"], "contexts": ["age of the subject"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "velho", "target_book": "polyanthea_medicinal", "target_name": "velho", "similarity": 1.0}], "id": 6015, "stable_key": "clu_f5d8bbb91066446f-2", "ground_truth": {"modern_name": "Age", "confidence": "high", "type": "concept", "wikidata_id": "Q4691836", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Age%20%28moth%29", "wikipedia_extract": "Age is a genus of moths belonging to the subfamily Olethreutinae of the family Tortricidae."}}, {"canonical_name": "MuU\u00fa", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "muu\u00fa", "book_id": "coloquios_da_orta_1563", "name": "MuU\u00fa", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["MuU\u00fa"], "contexts": ["successor of Ismael"]}, {"entity_id": "mu\u