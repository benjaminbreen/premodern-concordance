ok": "polyanthea_medicinal", "target_name": "liberdade", "similarity": 0.99}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "libert\u00e9", "target_book": "principles_of_psychology_james_1890", "target_name": "freedom", "similarity": 0.979}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "libert\u00e9", "target_book": "kosmos_humboldt_1845", "target_name": "libertatem", "similarity": 0.952}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "libert\u00e9", "target_book": "polyanthea_medicinal", "target_name": "liberdade", "similarity": 0.99}, {"source_book": "principles_of_psychology_james_1890", "source_name": "freedom", "target_book": "kosmos_humboldt_1845", "target_name": "libertatem", "similarity": 0.946}, {"source_book": "principles_of_psychology_james_1890", "source_name": "freedom", "target_book": "polyanthea_medicinal", "target_name": "liberdade", "similarity": 0.978}, {"source_book": "kosmos_humboldt_1845", "source_name": "libertatem", "target_book": "polyanthea_medicinal", "target_name": "liberdade", "similarity": 0.949}], "id": 284, "stable_key": "clu_70603f3f3ea0de39", "ground_truth": {"modern_name": "Liberty", "confidence": "high", "type": "concept", "note": "The cluster includes terms in French, English, Latin, and Portuguese, all referring to the concept of liberty or freedom.", "wikidata_id": "Q981297", "wikidata_description": "city in Texas, United States, part of the Houston metro area", "wikipedia_url": "https://en.wikipedia.org/wiki/Liberty%2C%20Texas", "wikipedia_extract": "Liberty is a city in the U.S. state of Texas, within Liberty County. The population was 8,279 at the 2020 census. It serves as the county seat of Liberty County. Liberty is the third oldest city in the state\u2014established in 1831 on the banks of the Trinity River. The city also has a twin of the Liberty Bell from Philadelphia, Pennsylvania."}}, {"canonical_name": "microscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 5, "total_mentions": 8, "members": [{"entity_id": "microscope", "book_id": "medecine_experimentale_bernard_1865", "name": "microscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["microscope"], "contexts": ["instrument for viewing small objects"]}, {"entity_id": "microscope", "book_id": "principles_of_psychology_james_1890", "name": "microscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["microscope"], "contexts": ["Instrument for viewing small objects"]}, {"entity_id": "microscope", "book_id": "kosmos_humboldt_1845", "name": "microscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["microscope"], "contexts": ["instrument for viewing small objects", "instrument for observing small life"]}, {"entity_id": "microscope", "book_id": "connexion_physical_sciences_somerville_1858", "name": "microscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["microscope"], "contexts": ["reveals new beauties in depicted objects"]}, {"entity_id": "microscope", "book_id": "first_principles_spencer_1862", "name": "microscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["microscope"], "contexts": ["instrument for viewing small objects", "instrument for viewing minute forms"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "microscope", "target_book": "principles_of_psychology_james_1890", "target_name": "microscope", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "microscope", "target_book": "kosmos_humboldt_1845", "target_name": "microscope", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "microscope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "microscope", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "microscope", "target_book": "first_principles_spencer_1862", "target_name": "microscope", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "microscope", "target_book": "kosmos_humboldt_1845", "target_name": "microscope", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "microscope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "microscope", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "microscope", "target_book": "first_principles_spencer_1862", "target_name": "microscope", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "microscope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "microscope", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "microscope", "target_book": "first_principles_spencer_1862", "target_name": "microscope", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "microscope", "target_book": "first_principles_spencer_1862", "target_name": "microscope", "similarity": 1.0}], "id": 285, "stable_key": "clu_36787e7194fabdf5", "ground_truth": {"wikipedia_extract": "A microscope (from Ancient Greek  \u03bc\u03b9\u03ba\u03c1\u03cc\u03c2 (mikr\u00f3s) 'small' and  \u03c3\u03ba\u03bf\u03c0\u03ad\u03c9 (skop\u00e9\u014d) 'to look (at); examine, inspect') is a laboratory instrument used to examine objects that are too small to be seen by the naked eye. Microscopy is the science of investigating small objects and structures using a microscope. Microscopic means being invisible to the eye unless aided by a microscope. There are many types of microscopes, and they may be grouped in different ways. One way is to describe the method an instrument uses to interact with a sample and produce images, either by sending a beam of light or electrons through a sample in its optical path, by detecting photon emissions from a sample, or by scanning across and a short distance from the surface of a sample using a probe. The most common microscope (and the first to be invented) is the optical microscope, which uses lenses to refract visible light that passed through a thinly sectioned sample to produce an observable image."}}, {"canonical_name": "history", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 8, "members": [{"entity_id": "history", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "History", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["History"], "contexts": ["study of past events", "source of dragon story"]}, {"entity_id": "history", "book_id": "kosmos_humboldt_1845", "name": "history", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["history"], "contexts": ["study of past events", "term used by Aristotle"]}, {"entity_id": "historia", "book_id": "historia_medicinal_monardes_1574", "name": "Historia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Historia"], "contexts": ["historical account"]}, {"entity_id": "historia", "book_id": "polyanthea_medicinal", "name": "historia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["historia"], "contexts": ["section of a medical work"]}, {"entity_id": "history", "book_id": "connexion_physical_sciences_somerville_1858", "name": "History", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["History"], "contexts": ["record of past events"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "History", "target_book": "kosmos_humboldt_1845", "target_name": "history", "similarity": 0.977}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "History", "target_book": "historia_medicinal_monardes_1574", "target_name": "Historia", "similarity": 0.924}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "History", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "History", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "history", "target_book": "historia_medicinal_monardes_1574", "target_name": "Historia", "similarity": 0.928}, {"source_book": "kosmos_humboldt_1845", "source_name": "history", "target_book": "polyanthea_medicinal", "target_name": "historia", "similarity": 0.905}, {"source_book": "kosmos_humboldt_1845", "source_name": "history", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "History", "similarity": 0.977}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Historia", "target_book": "polyanthea_medicinal", "target_name": "historia", "similarity": 0.956}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Historia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "History", "similarity": 0.924}], "id": 286, "stable_key": "clu_016f2c531e2c009a", "ground_truth": {"modern_name": "History", "confidence": "high", "type": "concept", "wikidata_id": "Q309", "wikidata_description": "past events and their tracks or records", "wikipedia_url": "https://en.wikipedia.org/wiki/History", "wikipedia_extract": "History is the systematic study of the past, focusing primarily on the human past. As an academic discipline, it analyses and interprets evidence to construct narratives about what happened and explain why it happened. Some theorists categorize history as a social science, while others see it as part of the humanities or consider it a hybrid discipline. Similar debates surround the purpose of history\u2014for example, whether its main aim is theoretical, to uncover the truth, or practical, to learn lessons from the past. In a more general sense, the term history refers not to an academic field but to the past itself, times in the past, or to individual texts about the past. Historical research relies on primary and secondary sources to reconstruct past events and validate interpretations."}}, {"canonical_name": "calorique", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 5, "total_mentions": 8, "members": [{"entity_id": "calorique", "book_id": "epoques_nature_buffon_1778", "name": "calorique", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["calorique"], "contexts": ["historical term for heat", "related to heat"]}, {"entity_id": "calorique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "calorique", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["calorique"], "contexts": ["heat energy"]}, {"entity_id": "caloric", "book_id": "principles_of_psychology_james_1890", "name": "caloric", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["caloric"], "contexts": ["hypothetical substance of heat"]}, {"entity_id": "caloric", "book_id": "kosmos_humboldt_1845", "name": "caloric", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["caloric"], "contexts": ["historical term for heat"]}, {"entity_id": "caloric", "book_id": "connexion_physical_sciences_somerville_1858", "name": "caloric", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["caloric"], "contexts": ["heat substance absorbed and radiated", "substance absorbed by elements, related to heat"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "calorique", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "calorique", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "calorique", "target_book": "principles_of_psychology_james_1890", "target_name": "caloric", "similarity": 0.996}, {"source_book": "epoques_nature_buffon_1778", "source_name": "calorique", "target_book": "kosmos_humboldt_1845", "target_name": "caloric", "similarity": 0.996}, {"source_book": "epoques_nature_buffon_1778", "source_name": "calorique", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "caloric", "similarity": 0.996}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "calorique", "target_book": "principles_of_psychology_james_1890", "target_name": "caloric", "similarity": 0.996}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "calorique", "target_book": "kosmos_humboldt_1845", "target_name": "caloric", "similarity": 0.996}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "calorique", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "caloric", "similarity": 0.996}, {"source_book": "principles_of_psychology_james_1890", "source_name": "caloric", "target_book": "kosmos_humboldt_1845", "target_name": "caloric", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "caloric", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "caloric", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "caloric", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "caloric", "similarity": 1.0}], "id": 287, "stable_key": "clu_36833d98fe33220e", "ground_truth": {"modern_name": "Caloric Theory", "confidence": "high", "type": "concept", "note": "The caloric theory was an early modern scientific concept that heat was a fluid substance.", "wikidata_id": "Q845261", "wikidata_description": "obsolete scientific theory of heat flow", "wikipedia_url": "https://en.wikipedia.org/wiki/Caloric%20theory", "wikipedia_extract": "The caloric theory is a superseded scientific theory that heat consists of a self-repellent fluid called \"caloric\" that flows from hotter bodies to colder bodies. Caloric was also thought of as a weightless gas that could pass in and out of pores in solids and liquids. The caloric theory was superseded by the mid-19th century in favor of the mechanical theory of heat, but nevertheless persisted in some scientific literature\u2014particularly in more popular treatments\u2014until the end of the 19th century. Phlogiston theory is replaced by combustion in oxygen In the history of thermodynamics, the initial explanations of heat were thoroughly confused with explanations of combustion. After J. J."}}, {"canonical_name": "Colima", "category": "PLACE", "subcategory": "CITY", "book_count": 5, "total_mentions": 8, "members": [{"entity_id": "kolima", "book_id": "epoques_nature_buffon_1778", "name": "Kolima", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Kolima"], "contexts": ["river in Siberia"]}, {"entity_id": "colima", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Colima", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Colima"], "contexts": ["hot region where tree grows", "Colima"]}, {"entity_id": "colima", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Colima", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Colima"], "contexts": ["volcanoes of Colima"]}, {"entity_id": "colima", "book_id": "kosmos_humboldt_1845", "name": "Colima", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Colima"], "contexts": ["volcanic mountain in Mexico"]}, {"entity_id": "colima", "book_id": "historia_medicinal_monardes_1574", "name": "Colima", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Colima"], "contexts": ["land near Mechoacan"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Kolima", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Colima", "similarity": 0.914}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Kolima", "target_book": "kosmos_humboldt_1845", "target_name": "Colima", "similarity": 0.914}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Colima", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Colima", "similarity": 0.831}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Colima", "target_book": "kosmos_humboldt_1845", "target_name": "Colima", "similarity": 0.831}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Colima", "target_book": "historia_medicinal_monardes_1574", "target_name": "Colima", "similarity": 0.799}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Colima", "target_book": "kosmos_humboldt_1845", "target_name": "Colima", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Colima", "target_book": "historia_medicinal_monardes_1574", "target_name": "Colima", "similarity": 0.813}, {"source_book": "kosmos_humboldt_1845", "source_name": "Colima", "target_book": "historia_medicinal_monardes_1574", "target_name": "Colima", "similarity": 0.813}], "id": 288, "stable_key": "clu_32340f536691d2d3", "ground_truth": {"modern_name": "Colima", "confidence": "high", "type": "place", "country": "Mexico", "wikidata_id": "Q825347", "wikidata_description": "mountain", "wikipedia_url": "https://en.wikipedia.org/wiki/Volc%C3%A1n%20de%20Colima", "wikipedia_extract": "The Volc\u00e1n de Colima, 3,820 m (12,530 ft), also known as Volc\u00e1n de Fuego, is part of the Colima Volcanic Complex (CVC) consisting of Volc\u00e1n de Colima, Nevado de Colima (Spanish pronunciation: [ne\u02c8\u03b2a\u00f0o \u00f0e ko\u02c8lima] ) and the eroded El C\u00e1ntaro (listed as extinct). It is the youngest of the three and as of 2015 is one of the most active volcanoes in Mexico and in North America. Having been active for nearly 5 million years, and with frequent eruptions, the Volc\u00e1n de Colima is considered a stratovolcano. \"Volc\u00e1n de Fuego is an active stratovolcano, the most explosive and dangerous of all of Mexico\" (Colima). It has erupted more than 40 times since 1576. One of the largest eruptions was on January 20\u201324, 1913."}}, {"canonical_name": "human voice", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 8, "members": [{"entity_id": "voice", "book_id": "english_physician_1652", "name": "voice", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["voice"], "contexts": ["lost their voice", "faculty of speech"]}, {"entity_id": "human_voice", "book_id": "principles_of_psychology_james_1890", "name": "human voice", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["human voice"], "contexts": ["production of sound for singing"]}, {"entity_id": "voz", "book_id": "polyanthea_medicinal", "name": "voz", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["voz"], "contexts": ["human voice"]}, {"entity_id": "human_voice", "book_id": "connexion_physical_sciences_somerville_1858", "name": "human voice", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["human voice"], "contexts": ["human voice produces sound", "mechanism for producing speech and sound"]}, {"entity_id": "voice-parts", "book_id": "first_principles_spencer_1862", "name": "voice-parts", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["voice-parts"], "contexts": ["musical components"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "voice", "target_book": "principles_of_psychology_james_1890", "target_name": "human voice", "similarity": 0.965}, {"source_book": "english_physician_1652", "source_name": "voice", "target_book": "polyanthea_medicinal", "target_name": "voz", "similarity": 0.973}, {"source_book": "english_physician_1652", "source_name": "voice", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "human voice", "similarity": 0.965}, {"source_book": "english_physician_1652", "source_name": "voice", "target_book": "first_principles_spencer_1862", "target_name": "voice-parts", "similarity": 0.929}, {"source_book": "principles_of_psychology_james_1890", "source_name": "human voice", "target_book": "polyanthea_medicinal", "target_name": "voz", "similarity": 0.937}, {"source_book": "principles_of_psychology_james_1890", "source_name": "human voice", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "human voice", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "human voice", "target_book": "first_principles_spencer_1862", "target_name": "voice-parts", "similarity": 0.926}, {"source_book": "polyanthea_medicinal", "source_name": "voz", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "human voice", "similarity": 0.937}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "human voice", "target_book": "first_principles_spencer_1862", "target_name": "voice-parts", "similarity": 0.926}], "id": 289, "stable_key": "clu_e7a960611f246a39", "ground_truth": {"wikipedia_extract": "The human voice consists of sound made by a human being using the vocal tract, including talking, singing, laughing, crying, screaming, shouting, humming or yelling. The human voice  is specifically a part of human sound production in which the vocal folds (vocal cords) are the primary sound source. (Other sound production mechanisms produced from the same general area of the body involve the production of unvoiced consonants, clicks, whistling and whispering.) Generally speaking, the mechanism for generating the human voice can be subdivided into three parts; the lungs, the vocal folds within the larynx (voice box), and the articulators. The lungs, the \"pump\" must produce adequate airflow and air pressure to vibrate vocal folds. The vocal folds (vocal cords) then vibrate to use airflow from the lungs to create audible pulses that form the laryngeal sound source. The muscles of the larynx adjust the length and tension of the vocal folds to 'fine-tune' pitch and tone. The articulators (the parts of the vocal tract above the larynx consisting of tongue, palate, cheek, lips, etc.) articulate and filter the sound emanating from the larynx and to some degree can interact with the laryngeal airflow to strengthen or weaken it as a sound source."}}, {"canonical_name": "wood", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 5, "total_mentions": 8, "members": [{"entity_id": "timber", "book_id": "english_physician_1652", "name": "Timber", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Timber"], "contexts": ["wood from trees"]}, {"entity_id": "wood", "book_id": "origin_of_species_darwin_1859", "name": "wood", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["wood"], "contexts": ["hard fibrous material of trees"]}, {"entity_id": "bois_fossile", "book_id": "relation_historique_humboldt_vol3_1825", "name": "bois fossile", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["bois fossile"], "contexts": ["fossilized wood fragments"]}, {"entity_id": "wood", "book_id": "principles_of_psychology_james_1890", "name": "wood", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["wood"], "contexts": ["material of the violin", "material from trees"]}, {"entity_id": "wood", "book_id": "first_principles_spencer_1862", "name": "wood", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["wood"], "contexts": ["material that burns", "material used by an artizan"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Timber", "target_book": "origin_of_species_darwin_1859", "target_name": "wood", "similarity": 0.947}, {"source_book": "english_physician_1652", "source_name": "Timber", "target_book": "principles_of_psychology_james_1890", "target_name": "wood", "similarity": 0.947}, {"source_book": "english_physician_1652", "source_name": "Timber", "target_book": "first_principles_spencer_1862", "target_name": "wood", "similarity": 0.947}, {"source_book": "origin_of_species_darwin_1859", "source_name": "wood", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "bois fossile", "similarity": 0.899}, {"source_book": "origin_of_species_darwin_1859", "source_name": "wood", "target_book": "principles_of_psychology_james_1890", "target_name": "wood", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "wood", "target_book": "first_principles_spencer_1862", "target_name": "wood", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "bois fossile", "target_book": "principles_of_psychology_james_1890", "target_name": "wood", "similarity": 0.899}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "bois fossile", "target_book": "first_principles_spencer_1862", "target_name": "wood", "similarity": 0.899}, {"source_book": "principles_of_psychology_james_1890", "source_name": "wood", "target_book": "first_principles_spencer_1862", "target_name": "wood", "similarity": 1.0}], "id": 290, "stable_key": "clu_f4d7047a334bf429", "ground_truth": {"modern_name": "Wood", "confidence": "high", "type": "mineral", "note": "While 'wood' is organic, the early modern texts refer to its material properties and sometimes fossilized forms, aligning with a substance classification. The context of 'bois fossile' further supports this.", "wikidata_id": "Q287", "wikidata_description": "fibrous material from trees or other plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Wood", "wikipedia_extract": "Wood is a structural tissue/material found as xylem in the stems and roots of trees and other woody plants. Being a natural material, it is characterized as an organic material \u2013 a natural composite of cellulosic fibers that are strong in tension and embedded in a matrix of lignin and hemicelluloses that resists compression. Wood is sometimes defined as only the secondary xylem in the stems of trees, or more broadly to include the same type of tissue elsewhere, such as in the roots of trees or shrubs. In a living tree, it performs a mechanical-support function, enabling woody plants to grow large or to stand up by themselves. It also conveys water and nutrients among the leaves, other growing tissues, and the roots. Wood may also refer to other plant materials with comparable properties, and to material engineered from wood, woodchips, or fibers.", "description": "Organic material from trees, used for various purposes including medicine."}}, {"canonical_name": "demonio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 8, "members": [{"entity_id": "demonios", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "demonios", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["demonios"], "contexts": ["demons"]}, {"entity_id": "devil", "book_id": "principles_of_psychology_james_1890", "name": "devil", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["devil"], "contexts": ["religious explanation for woman's behavior"]}, {"entity_id": "demonio", "book_id": "historia_medicinal_monardes_1574", "name": "demonio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Demonio", "demonio"], "contexts": ["entity that advises and deceives", "demon"]}, {"entity_id": "demonio", "book_id": "polyanthea_medicinal", "name": "demonio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["demonio"], "contexts": ["demon", "cause of demonic diseases"]}, {"entity_id": "devil", "book_id": "first_principles_spencer_1862", "name": "devil", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["devil"], "contexts": ["concept name in Pawnee language"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "demonios", "target_book": "historia_medicinal_monardes_1574", "target_name": "demonio", "similarity": 0.906}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "demonios", "target_book": "polyanthea_medicinal", "target_name": "demonio", "similarity": 0.906}, {"source_book": "principles_of_psychology_james_1890", "source_name": "devil", "target_book": "historia_medicinal_monardes_1574", "target_name": "demonio", "similarity": 0.921}, {"source_book": "principles_of_psychology_james_1890", "source_name": "devil", "target_book": "polyanthea_medicinal", "target_name": "demonio", "similarity": 0.921}, {"source_book": "principles_of_psychology_james_1890", "source_name": "devil", "target_book": "first_principles_spencer_1862", "target_name": "devil", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "demonio", "target_book": "polyanthea_medicinal", "target_name": "demonio", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "demonio", "target_book": "first_principles_spencer_1862", "target_name": "devil", "similarity": 0.921}, {"source_book": "polyanthea_medicinal", "source_name": "demonio", "target_book": "first_principles_spencer_1862", "target_name": "devil", "similarity": 0.921}], "id": 291, "stable_key": "clu_7e188e7b204f8e62", "ground_truth": {"modern_name": "Demon", "confidence": "high", "type": "concept", "note": "Encompasses both religious and folkloric entities that cause harm or deception, in Spanish and English.", "wikidata_id": "Q177413", "wikidata_description": "collective action (e.g. march) by people who are supporting or protesting against a cause of concern", "wikipedia_url": "https://en.wikipedia.org/wiki/Demon", "wikipedia_extract": "A demon is an evil or malevolent supernatural entity. Historically, belief in demons, or stories about demons, occurs in folklore, mythology, religion, occultism, and literature; these beliefs are reflected in media including fiction, comics, film, television, and video games. Belief in demons probably goes back to the Paleolithic age, stemming from humanity's fear of the unknown, the strange and the horrific. In ancient Near Eastern religions and in the Abrahamic religions, including early Judaism and ancient-medieval Christian demonology, a demon is considered a harmful spiritual entity that may cause demonic possession, calling for an exorcism. Large portions of Jewish demonology, a key influence on Christianity and Islam, originated from a later form of Zoroastrianism, and was transferred to Judaism during the Persian era. Demons may or may not be considered to be devils: minions of the Devil."}}, {"canonical_name": "connaissances humaines", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 7, "members": [{"entity_id": "connaissances_humaines", "book_id": "medecine_experimentale_bernard_1865", "name": "connaissances humaines", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["connaissances humaines"], "contexts": ["all human understanding", "human knowledge"]}, {"entity_id": "connaissances_humaines", "book_id": "epoques_nature_buffon_1778", "name": "connaissances humaines", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["connaissances humaines"], "contexts": ["collective human knowledge"]}, {"entity_id": "human_knowledge", "book_id": "principles_of_psychology_james_1890", "name": "human knowledge", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human knowledge"], "contexts": ["accumulated understanding of the world"]}, {"entity_id": "human_knowledge", "book_id": "connexion_physical_sciences_somerville_1858", "name": "human knowledge", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human knowledge"], "contexts": ["limited nature of"]}, {"entity_id": "human_knowledge", "book_id": "first_principles_spencer_1862", "name": "human knowledge", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human knowledge"], "contexts": ["understanding gained by people"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "connaissances humaines", "target_book": "epoques_nature_buffon_1778", "target_name": "connaissances humaines", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "connaissances humaines", "target_book": "principles_of_psychology_james_1890", "target_name": "human knowledge", "similarity": 0.912}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "connaissances humaines", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "human knowledge", "similarity": 0.912}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "connaissances humaines", "target_book": "first_principles_spencer_1862", "target_name": "human knowledge", "similarity": 0.912}, {"source_book": "epoques_nature_buffon_1778", "source_name": "connaissances humaines", "target_book": "principles_of_psychology_james_1890", "target_name": "human knowledge", "similarity": 0.912}, {"source_book": "epoques_nature_buffon_1778", "source_name": "connaissances humaines", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "human knowledge", "similarity": 0.912}, {"source_book": "epoques_nature_buffon_1778", "source_name": "connaissances humaines", "target_book": "first_principles_spencer_1862", "target_name": "human knowledge", "similarity": 0.912}, {"source_book": "principles_of_psychology_james_1890", "source_name": "human knowledge", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "human knowledge", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "human knowledge", "target_book": "first_principles_spencer_1862", "target_name": "human knowledge", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "human knowledge", "target_book": "first_principles_spencer_1862", "target_name": "human knowledge", "similarity": 1.0}], "id": 292, "stable_key": "clu_0d97281584f0fa21", "ground_truth": {"modern_name": "human knowledge", "confidence": "high", "type": "concept", "wikidata_id": "Q23593464", "wikidata_description": "artwork by Raymond Delamarre in Paris, France"}}, {"canonical_name": "senses", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 7, "members": [{"entity_id": "senses", "book_id": "medecine_experimentale_bernard_1865", "name": "senses", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["senses"], "contexts": ["organs of perception"]}, {"entity_id": "senses", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "senses", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["senses"], "contexts": ["organs for perceiving stimuli"]}, {"entity_id": "senses", "book_id": "english_physician_1652", "name": "senses", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["senses"], "contexts": ["faculty of perception", "affected by dulness"]}, {"entity_id": "senses", "book_id": "origin_of_species_darwin_1859", "name": "senses", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["senses"], "contexts": ["body parts for perception"]}, {"entity_id": "senses", "book_id": "first_principles_spencer_1862", "name": "senses", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["senses"], "contexts": ["for finding and securing materials", "sensory organs for perception"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "senses", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "senses", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "senses", "target_book": "english_physician_1652", "target_name": "senses", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "senses", "target_book": "origin_of_species_darwin_1859", "target_name": "senses", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "senses", "target_book": "first_principles_spencer_1862", "target_name": "senses", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "senses", "target_book": "english_physician_1652", "target_name": "senses", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "senses", "target_book": "origin_of_species_darwin_1859", "target_name": "senses", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "senses", "target_book": "first_principles_spencer_1862", "target_name": "senses", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "senses", "target_book": "origin_of_species_darwin_1859", "target_name": "senses", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "senses", "target_book": "first_principles_spencer_1862", "target_name": "senses", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "senses", "target_book": "first_principles_spencer_1862", "target_name": "senses", "similarity": 1.0}], "id": 293, "stable_key": "clu_2e2e0a554a03041e", "ground_truth": {"wikipedia_extract": "A sense is a biological system used by an organism for sensation, the process of  gathering information about the surroundings through the detection of stimuli. Although, in some cultures, five human senses were traditionally identified as such (namely sight, smell, touch, taste, and hearing), many more are now recognized. Senses used by non-human organisms are even greater in variety and number. During sensation, sense organs collect various stimuli (such as a sound or smell) for transduction, meaning transformation into a form that can be understood by the brain. Sensation and perception are fundamental to nearly every aspect of an organism's cognition, behavior and thought. In organisms, a sensory organ consists of a group of interrelated sensory cells that respond to a specific type of physical stimulus."}}, {"canonical_name": "Power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 7, "members": [{"entity_id": "puissance", "book_id": "medecine_experimentale_bernard_1865", "name": "puissance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["puissance"], "contexts": ["increased by scientific knowledge"]}, {"entity_id": "power", "book_id": "origin_of_species_darwin_1859", "name": "Power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Power"], "contexts": ["force or influence"]}, {"entity_id": "power", "book_id": "principles_of_psychology_james_1890", "name": "power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["power"], "contexts": ["ability to control or command"]}, {"entity_id": "power", "book_id": "connexion_physical_sciences_somerville_1858", "name": "power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["power"], "contexts": ["ability to do work"]}, {"entity_id": "power", "book_id": "first_principles_spencer_1862", "name": "Power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Power"], "contexts": ["force or influence acting upon us", "entity towards which feelings are directed"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "puissance", "target_book": "origin_of_species_darwin_1859", "target_name": "Power", "similarity": 0.898}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "puissance", "target_book": "principles_of_psychology_james_1890", "target_name": "power", "similarity": 0.913}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "puissance", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "power", "similarity": 0.913}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "puissance", "target_book": "first_principles_spencer_1862", "target_name": "Power", "similarity": 0.898}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Power", "target_book": "principles_of_psychology_james_1890", "target_name": "power", "similarity": 0.984}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Power", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "power", "similarity": 0.984}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Power", "target_book": "first_principles_spencer_1862", "target_name": "Power", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "power", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "power", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "power", "target_book": "first_principles_spencer_1862", "target_name": "Power", "similarity": 0.984}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "power", "target_book": "first_principles_spencer_1862", "target_name": "Power", "similarity": 0.984}], "id": 294, "stable_key": "clu_bee12d7167d6b6dd", "ground_truth": {"modern_name": "Power", "confidence": "high", "type": "concept"}}, {"canonical_name": "old age", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 7, "members": [{"entity_id": "vieillesse", "book_id": "medecine_experimentale_bernard_1865", "name": "vieillesse", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vieillesse"], "contexts": ["stage of life"]}, {"entity_id": "old_age", "book_id": "principles_of_psychology_james_1890", "name": "old age", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["old age"], "contexts": ["natural decline with aging", "later stage of life"]}, {"entity_id": "velhice", "book_id": "coloquios_da_orta_1563", "name": "velhice", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["velhice"], "contexts": ["state of being old"]}, {"entity_id": "velhice", "book_id": "polyanthea_medicinal", "name": "velhice", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["velhice"], "contexts": ["stage of life"]}, {"entity_id": "old_age", "book_id": "first_principles_spencer_1862", "name": "old age", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["old age"], "contexts": ["later stage of life"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "vieillesse", "target_book": "principles_of_psychology_james_1890", "target_name": "old age", "similarity": 0.919}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "vieillesse", "target_book": "coloquios_da_orta_1563", "target_name": "velhice", "similarity": 0.94}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "vieillesse", "target_book": "polyanthea_medicinal", "target_name": "velhice", "similarity": 0.94}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "vieillesse", "target_book": "first_principles_spencer_1862", "target_name": "old age", "similarity": 0.919}, {"source_book": "principles_of_psychology_james_1890", "source_name": "old age", "target_book": "coloquios_da_orta_1563", "target_name": "velhice", "similarity": 0.939}, {"source_book": "principles_of_psychology_james_1890", "source_name": "old age", "target_book": "polyanthea_medicinal", "target_name": "velhice", "similarity": 0.939}, {"source_book": "principles_of_psychology_james_1890", "source_name": "old age", "target_book": "first_principles_spencer_1862", "target_name": "old age", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "velhice", "target_book": "polyanthea_medicinal", "target_name": "velhice", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "velhice", "target_book": "first_principles_spencer_1862", "target_name": "old age", "similarity": 0.939}, {"source_book": "polyanthea_medicinal", "source_name": "velhice", "target_book": "first_principles_spencer_1862", "target_name": "old age", "similarity": 0.939}], "id": 295, "stable_key": "clu_a41c76f6a3ea4d2f", "ground_truth": {"modern_name": "Old age", "confidence": "high", "type": "concept", "wikidata_id": "Q191089", "wikidata_description": "consists of ages nearing or surpassing the life expectancy of human beings", "wikipedia_url": "https://en.wikipedia.org/wiki/Old_age", "wikipedia_extract": "Old age is the range of ages for people nearing and surpassing life expectancy. People of old age are called old people, old-timers, the elderly, elders, senior citizens, seniors, or older adults. Old age is not a definite biological stage: the chronological age denoted as \"old age\" varies culturally and historically. Some disciplines and domains focus on the aging and the aged, such as the organic processes of aging (senescence), medical studies of the aging process (gerontology), diseases that afflict older adults (geriatrics), technology to support the aging society (gerontechnology), and leisure and sport activities adapted to older people (such as senior sport). Old people often have limited regenerative abilities and are more susceptible to illness and injury than younger adults. They face social problems related to retirement, loneliness, and ageism."}}, {"canonical_name": "meat", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 5, "total_mentions": 7, "members": [{"entity_id": "flesh", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "flesh", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["flesh"], "contexts": ["soft tissue of the body"]}, {"entity_id": "meat", "book_id": "english_physician_1652", "name": "meat", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["meat"], "contexts": ["food", "food, chickweed not useful for"]}, {"entity_id": "carnes", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "carnes", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["carnes"], "contexts": ["gained by those who are thin"]}, {"entity_id": "carne_humana", "book_id": "relation_historique_humboldt_vol3_1825", "name": "carne humana", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["carne humana"], "contexts": ["human flesh"]}, {"entity_id": "carne_humana", "book_id": "historia_medicinal_monardes_1574", "name": "carne humana", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["carne humana"], "contexts": ["food source for indigenous people"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "flesh", "target_book": "english_physician_1652", "target_name": "meat", "similarity": 0.898}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "flesh", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "carnes", "similarity": 0.895}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "flesh", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "carne humana", "similarity": 0.9}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "flesh", "target_book": "historia_medicinal_monardes_1574", "target_name": "carne humana", "similarity": 0.9}, {"source_book": "english_physician_1652", "source_name": "meat", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "carnes", "similarity": 0.947}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "carne humana", "target_book": "historia_medicinal_monardes_1574", "target_name": "carne humana", "similarity": 1.0}], "id": 296, "stable_key": "clu_e22fdaf165d1bf67", "ground_truth": {"modern_name": "Meat", "confidence": "high", "type": "animal", "wikidata_id": "Q10990", "wikidata_description": "culinary name for animal flesh eaten as food", "wikipedia_url": "https://en.wikipedia.org/wiki/Meat", "note": "Refers to the muscular tissue of animals, both as food ('meat') and in an anatomical context.", "wikipedia_extract": "Meat is animal tissue, mostly muscle, that is eaten as food. Humans have hunted and farmed other animals for meat since prehistory. The Neolithic Revolution allowed the domestication of vertebrates, including chickens, sheep, goats, pigs, horses, and cattle, starting around 11,000 years ago. Since then, selective breeding has enabled farmers to produce meat with the qualities desired by producers and consumers. Meat is important to economies and cultures around the world. Meat is mainly composed of water, protein, and fat."}}, {"canonical_name": "metamorphosis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 7, "members": [{"entity_id": "metamorphosis", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Metamorphosis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Metamorphosis"], "contexts": ["work by Ovid"]}, {"entity_id": "metamorphosis", "book_id": "origin_of_species_darwin_1859", "name": "metamorphosis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["metamorphosis"], "contexts": ["transformation from larva to adult", "transformation during development"]}, {"entity_id": "metamorphosis", "book_id": "principles_of_psychology_james_1890", "name": "metamorphosis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["metamorphosis"], "contexts": ["complete change in form or appearance"]}, {"entity_id": "metamorphosis", "book_id": "kosmos_humboldt_1845", "name": "metamorphosis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["metamorphosis"], "contexts": ["transformation of rock types", "transformation of forms"]}, {"entity_id": "metamorphosis", "book_id": "first_principles_spencer_1862", "name": "metamorphosis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["metamorphosis"], "contexts": ["transformation of form"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Metamorphosis", "target_book": "origin_of_species_darwin_1859", "target_name": "metamorphosis", "similarity": 0.986}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Metamorphosis", "target_book": "principles_of_psychology_james_1890", "target_name": "metamorphosis", "similarity": 0.986}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Metamorphosis", "target_book": "kosmos_humboldt_1845", "target_name": "metamorphosis", "similarity": 0.986}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Metamorphosis", "target_book": "first_principles_spencer_1862", "target_name": "metamorphosis", "similarity": 0.986}, {"source_book": "origin_of_species_darwin_1859", "source_name": "metamorphosis", "target_book": "principles_of_psychology_james_1890", "target_name": "metamorphosis", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "metamorphosis", "target_book": "kosmos_humboldt_1845", "target_name": "metamorphosis", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "metamorphosis", "target_book": "first_principles_spencer_1862", "target_name": "metamorphosis", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "metamorphosis", "target_book": "kosmos_humboldt_1845", "target_name": "metamorphosis", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "metamorphosis", "target_book": "first_principles_spencer_1862", "target_name": "metamorphosis", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "metamorphosis", "target_book": "first_principles_spencer_1862", "target_name": "metamorphosis", "similarity": 1.0}], "id": 297, "stable_key": "clu_5c4fe5c70e17a642", "ground_truth": {"modern_name": "Metamorphosis", "confidence": "high", "type": "concept", "wikidata_id": "Q33753", "wikidata_description": "profound change in body structure during the postembryonic development of an organism", "wikipedia_url": "https://en.wikipedia.org/wiki/Metamorphosis", "wikipedia_extract": "Metamorphosis is a biological process by which an animal physically develops  including  birth transformation or hatching, involving a conspicuous and relatively abrupt change in the animal's body structure through cell growth and differentiation. Some insects, fish, amphibians, mollusks, crustaceans, cnidarians, echinoderms, and tunicates undergo metamorphosis, which is often accompanied by a change of nutrition source or behavior. Animals can be divided into species that undergo complete metamorphosis (\"holometaboly\"), incomplete metamorphosis (\"hemimetaboly\"), or no metamorphosis (\"ametaboly\"). Generally organisms with a larval stage undergo metamorphosis, and during metamorphosis the organism loses larval characteristics. The word metamorphosis derives from Ancient Greek \u03bc\u03b5\u03c4\u03b1\u03bc\u03cc\u03c1\u03c6\u03c9\u03c3\u03b9\u03c2, \"transformation, transforming\", from \u03bc\u03b5\u03c4\u03b1- (meta-), \"after\" and \u03bc\u03bf\u03c1\u03c6\u03ae (morphe), \"form\". In insects, growth and metamorphosis are controlled by hormones synthesized by endocrine glands near the front of the body (anterior)."}}, {"canonical_name": "Cartas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 5, "total_mentions": 7, "members": [{"entity_id": "card", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Card", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Card"], "contexts": ["compass card"]}, {"entity_id": "card", "book_id": "principles_of_psychology_james_1890", "name": "card", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["card"], "contexts": ["flat piece of material"]}, {"entity_id": "cartas", "book_id": "coloquios_da_orta_1563", "name": "Cartas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Cartas", "cartas"], "contexts": ["maps used for navigation", "cited work by Affonso de Albuquerque"]}, {"entity_id": "carta", "book_id": "ricettario_fiorentino_1597", "name": "carta", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["carta"], "contexts": ["material for covering", "paper for wrapping pills"]}, {"entity_id": "card", "book_id": "connexion_physical_sciences_somerville_1858", "name": "card", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["card"], "contexts": ["material with slits for light experiment"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Card", "target_book": "principles_of_psychology_james_1890", "target_name": "card", "similarity": 0.99}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Card", "target_book": "ricettario_fiorentino_1597", "target_name": "carta", "similarity": 0.907}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Card", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "card", "similarity": 0.99}, {"source_book": "principles_of_psychology_james_1890", "source_name": "card", "target_book": "ricettario_fiorentino_1597", "target_name": "carta", "similarity": 0.893}, {"source_book": "principles_of_psychology_james_1890", "source_name": "card", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "card", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Cartas", "target_book": "ricettario_fiorentino_1597", "target_name": "carta", "similarity": 0.896}, {"source_book": "ricettario_fiorentino_1597", "source_name": "carta", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "card", "similarity": 0.893}], "id": 298, "stable_key": "clu_e575f8a677c086ab", "ground_truth": {"modern_name": "Card", "confidence": "high", "type": "object", "note": "The cluster includes references to 'compass card', 'Cartas' (which could be maps or playing cards, but in the context of scientific/medical texts, likely navigational charts or similar), and 'carta' (in Italian ricettario, possibly referring to a card or recipe sheet). 'Card' is the most encompassing modern term.", "wikidata_id": "Q10690", "wikidata_description": "capital city of Wales, United Kingdom", "wikipedia_url": "https://en.wikipedia.org/wiki/Cardiff", "wikipedia_extract": "Cardiff ( ; Welsh: Caerdydd [kair\u02c8di\u02d0\u00f0, ka\u02d0\u0268r\u02c8d\u0268\u02d0\u00f0] ) is the capital and largest city of Wales. Cardiff had a population of 383,919 in 2024 and forms a principal area officially known as the City and County of Cardiff (Welsh: Dinas a Sir Caerdydd). The city is the eleventh largest in the United Kingdom. Located in the southeast of Wales and in the Cardiff Capital Region, Cardiff is the county town of the historic county of Glamorgan and in 1974\u20131996 of South Glamorgan. It belongs to the Eurocities network of the largest European cities. A small town until the early 19th century, its prominence as a port for coal when mining began in the region helped its expansion."}}, {"canonical_name": "Borneo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 5, "total_mentions": 7, "members": [{"entity_id": "borneo", "book_id": "origin_of_species_darwin_1859", "name": "Borneo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Borneo"], "contexts": ["island in Southeast Asia", "location with southern vegetable forms"]}, {"entity_id": "borneo", "book_id": "kosmos_humboldt_1845", "name": "Borneo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Borneo"], "contexts": ["island with a certain areal surface"]}, {"entity_id": "borneo", "book_id": "coloquios_da_orta_1563", "name": "Borneo", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Borneo"], "contexts": ["island where elephants were found in small quantity", "island with fine diamonds"]}, {"entity_id": "borneo", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Borneo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Borneo"], "contexts": ["island affected by eruption"]}, {"entity_id": "borneo", "book_id": "first_principles_spencer_1862", "name": "Borneo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Borneo"], "contexts": ["island in Southeast Asia"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Borneo", "target_book": "kosmos_humboldt_1845", "target_name": "Borneo", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Borneo", "target_book": "coloquios_da_orta_1563", "target_name": "Borneo", "similarity": 0.898}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Borneo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Borneo", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Borneo", "target_book": "first_principles_spencer_1862", "target_name": "Borneo", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Borneo", "target_book": "coloquios_da_orta_1563", "target_name": "Borneo", "similarity": 0.898}, {"source_book": "kosmos_humboldt_1845", "source_name": "Borneo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Borneo", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Borneo", "target_book": "first_principles_spencer_1862", "target_name": "Borneo", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Borneo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Borneo", "similarity": 0.898}, {"source_book": "coloquios_da_orta_1563", "source_name": "Borneo", "target_book": "first_principles_spencer_1862", "target_name": "Borneo", "similarity": 0.898}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Borneo", "target_book": "first_principles_spencer_1862", "target_name": "Borneo", "similarity": 1.0}], "id": 299, "stable_key": "clu_94e737a029843415", "ground_truth": {"modern_name": "Borneo", "confidence": "high", "type": "place", "description": "Island in Southeast Asia, a source of camphor.", "note": "References to 'Bumeo' and 'Uembo' likely refer to Borneo and its camphor production.", "wikipedia_extract": "Borneo () is the third-largest island in the world, with an area of 748,168 km2 (288,869 sq mi), and population of 23,053,723 (2020 national censuses). Situated at the geographic centre of Maritime Southeast Asia, it is one of the Greater Sunda Islands, located north of Java, west of Sulawesi, and east of Sumatra. The island is crossed by the equator, which divides it roughly in half. In Indonesia, the island is also known as Kalimantan, which is also the name of the Indonesian region located on the island. The geology of Borneo was formed beginning in the Mesozoic. It formed part of Sundaland, a region connected to mainland Asia, until it became isolated by sea level rise at the end of the last ice age."}}, {"canonical_name": "barro", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 5, "total_mentions": 7, "members": [{"entity_id": "barro", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "barro", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["barro"], "contexts": ["clay used for vessels"]}, {"entity_id": "barro", "book_id": "relation_historique_humboldt_vol3_1825", "name": "barro", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["barro"], "contexts": ["moistened clay"]}, {"entity_id": "barro", "book_id": "historia_medicinal_monardes_1574", "name": "barro", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["barro"], "contexts": ["mud", "clay material for vessels"]}, {"entity_id": "barro", "book_id": "coloquios_da_orta_1563", "name": "barro", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["barro"], "contexts": ["used to cover ginger"]}, {"entity_id": "de_barro", "book_id": "polyanthea_medicinal", "name": "de barro", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["de barro"], "contexts": ["made of clay"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "barro", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "barro", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "barro", "target_book": "historia_medicinal_monardes_1574", "target_name": "barro", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "barro", "target_book": "coloquios_da_orta_1563", "target_name": "barro", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "barro", "target_book": "polyanthea_medicinal", "target_name": "de barro", "similarity": 0.936}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "barro", "target_book": "historia_medicinal_monardes_1574", "target_name": "barro", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "barro", "target_book": "coloquios_da_orta_1563", "target_name": "barro", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "barro", "target_book": "polyanthea_medicinal", "target_name": "de barro", "similarity": 0.936}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "barro", "target_book": "coloquios_da_orta_1563", "target_name": "barro", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "barro", "target_book": "polyanthea_medicinal", "target_name": "de barro", "similarity": 0.936}, {"source_book": "coloquios_da_orta_1563", "source_name": "barro", "target_book": "polyanthea_medicinal", "target_name": "de barro", "similarity": 0.936}], "id": 300, "stable_key": "clu_7ff1143f6fac33cf-2", "ground_truth": {"modern_name": "Clay", "confidence": "high", "type": "mineral", "wikidata_id": "Q164192", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Claytonia", "note": "Argile and argilla are historical terms for clay.", "wikipedia_extract": "Claytonia (spring beauty) is a genus of flowering plants native to Asia, North America, and Central America. The vitamin-rich leaves can be eaten raw or cooked, and the tubers can be prepared like potatoes. The plants are somewhat fleshy and only a few centimeters in height. The flower heads are about 2.5 cm (1 inch) in diameter. The genus was formerly included in the purslane family (Portulacaceae), but with the adoption of the APG IV system, in 2009 it was moved to the family Montiaceae. A number of the species were formerly treated in the related genus Montia."}}, {"canonical_name": "Ignorance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 6, "members": [{"entity_id": "ignorance", "book_id": "medecine_experimentale_bernard_1865", "name": "ignorance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ignorance"], "contexts": ["lack of knowledge"]}, {"entity_id": "ignorance", "book_id": "epoques_nature_buffon_1778", "name": "ignorance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ignorance"], "contexts": ["lack of knowledge"]}, {"entity_id": "ignorance", "book_id": "english_physician_1652", "name": "Ignorance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Ignorance"], "contexts": ["linked to devotion in naming", "brother of Madness"]}, {"entity_id": "ignorance", "book_id": "kosmos_humboldt_1845", "name": "ignorance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ignorance"], "contexts": ["lack of knowledge"]}, {"entity_id": "ignorance", "book_id": "first_principles_spencer_1862", "name": "ignorance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ignorance"], "contexts": ["lack of knowledge or information"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "ignorance", "target_book": "epoques_nature_buffon_1778", "target_name": "ignorance", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "ignorance", "target_book": "english_physician_1652", "target_name": "Ignorance", "similarity": 0.963}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "ignorance", "target_book": "kosmos_humboldt_1845", "target_name": "ignorance", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "ignorance", "target_book": "first_principles_spencer_1862", "target_name": "ignorance", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "ignorance", "target_book": "english_physician_1652", "target_name": "Ignorance", "similarity": 0.963}, {"source_book": "epoques_nature_buffon_1778", "source_name": "ignorance", "target_book": "kosmos_humboldt_1845", "target_name": "ignorance", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "ignorance", "target_book": "first_principles_spencer_1862", "target_name": "ignorance", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Ignorance", "target_book": "kosmos_humboldt_1845", "target_name": "ignorance", "similarity": 0.963}, {"source_book": "english_physician_1652", "source_name": "Ignorance", "target_book": "first_principles_spencer_1862", "target_name": "ignorance", "similarity": 0.963}, {"source_book": "kosmos_humboldt_1845", "source_name": "ignorance", "target_book": "first_principles_spencer_1862", "target_name": "ignorance", "similarity": 1.0}], "id": 301, "stable_key": "clu_7cd581f03e6929ef", "ground_truth": {"modern_name": "Ignorance", "confidence": "high", "type": "concept", "description": "A lack of knowledge, understanding, or information.", "wikipedia_extract": "Ignorance is a lack of knowledge, information and understanding. Deliberate ignorance is a culturally-induced phenomenon, the study of which is called agnotology. The word \"ignorant\" is an adjective that describes a person in the state of being unaware, or even cognitive dissonance and other cognitive relation, and can describe individuals who are unaware of important information or facts. Ignorance can appear in three different types: factual ignorance (absence of knowledge of some fact), object ignorance (unacquaintance with some object), and technical ignorance (absence of knowledge of how to do something). Ignorance can have negative effects on individuals and societies, but can also benefit them by creating within them the desire to know more. For example, ignorance within science opens the opportunity to seek knowledge and make discoveries by asking new questions."}}, {"canonical_name": "Anatomy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 6, "members": [{"entity_id": "anatomy", "book_id": "medecine_experimentale_bernard_1865", "name": "anatomy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["anatomy"], "contexts": ["study of the structure of the body"]}, {"entity_id": "anatomy", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Anatomy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Anatomy"], "contexts": ["study of bodily structure"]}, {"entity_id": "anatomy", "book_id": "principles_of_psychology_james_1890", "name": "Anatomy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Anatomy", "anatomy"], "contexts": ["study of the structure of living things", "Study of the body's structure"]}, {"entity_id": "anatomica", "book_id": "polyanthea_medicinal", "name": "Anatomica", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["Anatomica"], "contexts": ["study of anatomy"]}, {"entity_id": "anatomy", "book_id": "first_principles_spencer_1862", "name": "Anatomy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Anatomy"], "contexts": ["science affecting medicine and hygiene"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "anatomy", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Anatomy", "similarity": 0.949}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "anatomy", "target_book": "principles_of_psychology_james_1890", "target_name": "Anatomy", "similarity": 0.949}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "anatomy", "target_book": "polyanthea_medicinal", "target_name": "Anatomica", "similarity": 0.941}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "anatomy", "target_book": "first_principles_spencer_1862", "target_name": "Anatomy", "similarity": 0.949}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Anatomy", "target_book": "principles_of_psychology_james_1890", "target_name": "Anatomy", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Anatomy", "target_book": "polyanthea_medicinal", "target_name": "Anatomica", "similarity": 0.951}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Anatomy", "target_book": "first_principles_spencer_1862", "target_name": "Anatomy", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Anatomy", "target_book": "polyanthea_medicinal", "target_name": "Anatomica", "similarity": 0.951}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Anatomy", "target_book": "first_principles_spencer_1862", "target_name": "Anatomy", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Anatomica", "target_book": "first_principles_spencer_1862", "target_name": "Anatomy", "similarity": 0.951}], "id": 302, "stable_key": "clu_4b12b43c7b1388e3", "ground_truth": {"modern_name": "Anatomy", "confidence": "high", "type": "concept", "wikidata_id": "Q514", "wikidata_description": "study of the internal structure of organisms and their parts", "wikipedia_url": "https://en.wikipedia.org/wiki/Anatomy", "wikipedia_extract": "Anatomy (from Ancient Greek  \u1f00\u03bd\u03b1\u03c4\u03bf\u03bc\u03ae (anatom\u1e17) 'dissection') is the branch of morphology concerned with the study of the internal and external structure of organisms and their parts. Anatomy is a branch of natural science that deals with the structural organization of living things. It is an old science, having its beginnings in prehistoric times. Anatomy is inherently tied to developmental biology, embryology, comparative anatomy, evolutionary biology, and phylogeny, as these are the processes by which anatomy is generated, both over immediate and long-term timescales. Anatomy and physiology, which study the structure and function of organisms and their parts respectively, make a natural pair of related disciplines, and are often studied together. Human anatomy is one of the essential basic sciences that are applied in medicine, and is often studied alongside physiology."}}, {"canonical_name": "cavernes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 5, "total_mentions": 6, "members": [{"entity_id": "caverns", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Caverns", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Caverns"], "contexts": ["natural underground spaces"]}, {"entity_id": "cavernes", "book_id": "epoques_nature_buffon_1778", "name": "cavernes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["cavernes"], "contexts": ["hollow spaces formed by cooling", "underground hollows causing collapses"]}, {"entity_id": "caves", "book_id": "origin_of_species_darwin_1859", "name": "caves", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["caves"], "contexts": ["blind animals in"]}, {"entity_id": "cavernes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "cavernes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["cavernes"], "contexts": ["great caverns"]}, {"entity_id": "caves", "book_id": "kosmos_humboldt_1845", "name": "caves", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["caves"], "contexts": ["natural underground cavities"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Caverns", "target_book": "epoques_nature_buffon_1778", "target_name": "cavernes", "similarity": 0.974}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Caverns", "target_book": "origin_of_species_darwin_1859", "target_name": "caves", "similarity": 0.93}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Caverns", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "cavernes", "similarity": 0.974}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Caverns", "target_book": 