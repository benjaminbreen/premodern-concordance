mblance"]}, {"entity_id": "appearances", "book_id": "first_principles_spencer_1862", "name": "appearances", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["appearances"], "contexts": ["outward or superficial aspect"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "appearances", "target_book": "first_principles_spencer_1862", "target_name": "appearance", "similarity": 0.894}, {"source_book": "principles_of_psychology_james_1890", "source_name": "appearances", "target_book": "first_principles_spencer_1862", "target_name": "appearances", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "appearance", "target_book": "first_principles_spencer_1862", "target_name": "appearance", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "appearance", "target_book": "first_principles_spencer_1862", "target_name": "appearances", "similarity": 0.894}], "id": 3266, "stable_key": "clu_8ed6eacc18235136", "ground_truth": {"modern_name": "appearance", "confidence": "high", "type": "concept", "wikidata_id": "Q57199699", "wikidata_description": "manifestation of a divine or supernatural entity"}}, {"canonical_name": "acidez", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "acidity", "book_id": "principles_of_psychology_james_1890", "name": "acidity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["acidity"], "contexts": ["quality of fruits"]}, {"entity_id": "acidez", "book_id": "polyanthea_medicinal", "name": "acidez", "category": "CONCEPT", "subcategory": "QUALITY", "count": 5, "variants": ["acidez"], "contexts": ["quality", "quality of being acidic"]}, {"entity_id": "acidity", "book_id": "polyanthea_medicinal", "name": "acidity", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["acidity"], "contexts": ["implied by 'acido-falinos'"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "acidity", "target_book": "polyanthea_medicinal", "target_name": "acidez", "similarity": 0.97}, {"source_book": "principles_of_psychology_james_1890", "source_name": "acidity", "target_book": "polyanthea_medicinal", "target_name": "acidity", "similarity": 1.0}], "id": 3267, "stable_key": "clu_5a6c8b1da812c9ea", "ground_truth": {"wikipedia_extract": "An acid is a molecule or ion capable of either donating a proton (i.e. hydrogen cation, H+), known as a Br\u00f8nsted\u2013Lowry acid, or forming a covalent bond with an electron pair, known as a Lewis acid. The first category of acids are the proton donors, or Br\u00f8nsted\u2013Lowry acids. In the special case of aqueous solutions, proton donors form the hydronium ion H3O+ and are known as Arrhenius acids. Br\u00f8nsted and Lowry generalized the Arrhenius theory to include non-aqueous solvents. A Br\u00f8nsted\u2013Lowry or Arrhenius acid usually contains a hydrogen atom bonded to a chemical structure that is still energetically favorable after loss of H+. Aqueous Arrhenius acids have characteristic properties that provide a practical description of an acid."}}, {"canonical_name": "Plin.", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "plin_", "book_id": "kosmos_humboldt_1845", "name": "Plin.", "category": "PERSON", "subcategory": "AUTHORITY", "count": 6, "variants": ["Plin."], "contexts": ["ancient authority cited", "ancient Roman author"]}, {"entity_id": "pl\u00ed_", "book_id": "coloquios_da_orta_1563", "name": "Pl\u00ed.", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Pl\u00ed."], "contexts": ["authority cited in a note"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Plin.", "target_book": "coloquios_da_orta_1563", "target_name": "Pl\u00ed.", "similarity": 0.895}], "id": 3268, "stable_key": "clu_75041dcbcc428b45-3", "ground_truth": {"modern_name": "Pliny the Elder", "confidence": "high", "type": "person", "birth_year": 23, "death_year": 79, "description": "Roman author and naturalist, known for Naturalis Historia.", "wikidata_id": "Q58340224", "wikidata_description": "scholarly article by John F. Healy published January 1981 in Interdisciplinary Science Reviews"}}, {"canonical_name": "Magnetic storms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "magnetic_storms", "book_id": "kosmos_humboldt_1845", "name": "Magnetic storms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["magnetic storms", "Magnetic storms"], "contexts": ["disturbances in Earth's magnetic field", "phenomena related to magnetic field fluctuations"]}, {"entity_id": "storms,_magnetic", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Storms, magnetic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Storms, magnetic"], "contexts": ["magnetic phenomena related to weather"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Magnetic storms", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Storms, magnetic", "similarity": 0.924}], "id": 3269, "stable_key": "clu_e02d4323c0a3c26d", "ground_truth": {"modern_name": "Geomagnetic storm", "confidence": "high", "type": "concept"}}, {"canonical_name": "Nebulae", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "nebulae", "book_id": "kosmos_humboldt_1845", "name": "Nebulae", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 6, "variants": ["Nebulae", "nebulae"], "contexts": ["celestial objects in the sky", "celestial objects in space"]}, {"entity_id": "nebulous_bodies", "book_id": "connexion_physical_sciences_somerville_1858", "name": "nebulous bodies", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["nebulous bodies"], "contexts": ["celestial objects with a hazy appearance"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Nebulae", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nebulous bodies", "similarity": 0.885}], "id": 3270, "stable_key": "clu_12d93b3e8f43760d", "ground_truth": {"modern_name": "Nebula", "confidence": "high", "type": "object", "wikidata_id": "Q6985278", "wikidata_description": "genus of insects"}}, {"canonical_name": "John Herschel", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "john_herschel", "book_id": "kosmos_humboldt_1845", "name": "John Herschel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["John Herschel"], "contexts": ["saw satellites again at Cape of Good Hope", "author in 'Memoirs of the Astronom. Soc.'"]}, {"entity_id": "william_herschel", "book_id": "connexion_physical_sciences_somerville_1858", "name": "William Herschel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["William Herschel"], "contexts": ["applied method to binary groups"]}, {"entity_id": "john_herschel", "book_id": "connexion_physical_sciences_somerville_1858", "name": "John Herschel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["John Herschel"], "contexts": ["telescope used to view nebul\u00e6"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "John Herschel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "William Herschel", "similarity": 0.944}, {"source_book": "kosmos_humboldt_1845", "source_name": "John Herschel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "John Herschel", "similarity": 1.0}], "id": 3271, "stable_key": "clu_c230f2003d268560-2", "ground_truth": {"modern_name": "William Herschel", "confidence": "high", "type": "person", "birth_year": 1738, "death_year": 1822, "description": "Astronomer who discovered Uranus and infrared radiation.", "wikidata_id": "Q3369709", "wikidata_description": "museum in Bath, England, United Kingdom", "wikipedia_url": "https://en.wikipedia.org/wiki/Herschel%20Museum%20of%20Astronomy", "note": "The cluster also mentions 'John Herschel', who was William's son and also an astronomer. Given the context of astronomical discoveries, William is the more prominent figure for general scientific discourse.", "wikipedia_extract": "The Herschel Museum of Astronomy at 19 New King Street, Bath, England, is a museum that was inaugurated in 1981. It is located in a town house that was formerly the home of William Herschel and his sister Caroline. The museum is situated in the former home of the Herschels at 19 New King Street (south side) in Bath, England. The building is a particularly well-preserved small town house of the period. The modest town-house covers five floors, and includes two reception rooms on the ground and first floor. The town house is part of a terrace that was built around 1764-1770."}}, {"canonical_name": "Cassiopeia", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "cassiopeia", "book_id": "kosmos_humboldt_1845", "name": "Cassiopeia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Cassiopeia"], "contexts": ["constellation with a star", "constellation region in the Milky Way"]}, {"entity_id": "cassiopeia", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cassiopeia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Cassiopeia"], "contexts": ["constellation where a star appeared", "astronomical constellation"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Cassiopeia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cassiopeia", "similarity": 1.0}], "id": 3272, "stable_key": "clu_edaaa2680390a09e", "ground_truth": {"modern_name": "Cassiquiare River", "confidence": "medium", "type": "place", "country": "Venezuela", "note": "Most mentions refer to the Cassiquiare River, but 'Cassiopeia' is a constellation, suggesting a mix of entities or OCR errors.", "wikipedia_extract": "The Casiquiare river or canal (Spanish pronunciation: [kasi\u02c8kja\u027ee]) is a natural distributary of the upper Orinoco flowing southward into the Rio Negro in Venezuela. As such, it forms a unique natural canal between the Orinoco and Amazon river systems. It is the world's largest river of the kind that links two major river systems, a so-called bifurcation. The area forms a water divide, more dramatically at regional flood stage. The name Casiquiare, first used in that form by Manuel Rom\u00e1n, likely derives from the Ye'kuana language name of the river, Kashishiwadi. The first European to describe it was Spanish Jesuit missionary and explorer Crist\u00f3bal Diatrist\u00e1n de Acu\u00f1a in 1639.", "wikipedia_url": "https://en.wikipedia.org/wiki/Casiquiare_canal"}}, {"canonical_name": "telescopes", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "telescopes", "book_id": "kosmos_humboldt_1845", "name": "telescopes", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 4, "variants": ["telescopes"], "contexts": ["instruments for astronomical observation", "instruments for viewing distant objects"]}, {"entity_id": "telescopes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "telescopes", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["telescopes"], "contexts": ["instruments for observing distant objects", "instruments for viewing distant objects"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "telescopes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "telescopes", "similarity": 1.0}], "id": 3273, "stable_key": "clu_b1ec5296f66df11b-2", "ground_truth": {"modern_name": "Telescope", "confidence": "high", "type": "object", "wikidata_id": "Q4213", "wikidata_description": "instrument that aids in the observation of remote objects", "wikipedia_url": "https://en.wikipedia.org/wiki/Telescope", "wikipedia_extract": "A telescope is a device used to observe distant objects by their emission, absorption, or reflection of electromagnetic radiation. Originally, it was an optical instrument using lenses, curved mirrors, or a combination of both to observe distant objects \u2013 an optical telescope. Nowadays, the word \"telescope\" is defined as a wide range of instruments capable of detecting different regions of the electromagnetic spectrum, and in some cases other types of detectors. The first known practical telescopes were refracting telescopes with glass lenses and were invented in the Netherlands at the beginning of the 17th century. They were used for both terrestrial applications and astronomy. The reflecting telescope, which uses mirrors to collect and focus light, was invented within a few decades of the first refracting telescope."}}, {"canonical_name": "voltaic pile", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "voltaic_pile", "book_id": "kosmos_humboldt_1845", "name": "voltaic pile", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 4, "variants": ["voltaic pile"], "contexts": ["early electric battery", "device demonstrating electric phenomena"]}, {"entity_id": "voltaic_pile", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Voltaic pile", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["Voltaic pile"], "contexts": ["construction of the Voltaic pile", "apparatus analogous to electrical production"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "voltaic pile", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Voltaic pile", "similarity": 0.968}], "id": 3274, "stable_key": "clu_1b8f26082f76c51a", "ground_truth": {"modern_name": "Voltaic pile", "confidence": "high", "type": "object", "wikidata_id": "Q663273", "wikidata_description": "first electrical battery that could continuously provide an electric current to a circuit"}}, {"canonical_name": "Maclear", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "maclear", "book_id": "kosmos_humboldt_1845", "name": "Maclear", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Maclear"], "contexts": ["author of 'Results from 1839 to 1840'", "scholar measuring star parallaxes"]}, {"entity_id": "maclear", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Maclear", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Maclear"], "contexts": ["observer of stellar parallax and motion", "associated with Sirius and Henderson"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Maclear", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Maclear", "similarity": 1.0}], "id": 3275, "stable_key": "clu_175ba8867f658be9", "ground_truth": {"modern_name": "Thomas Maclear", "confidence": "high", "type": "person", "birth_year": 1794, "death_year": 1879, "description": "Astronomer, Superintendent of the Cape Observatory.", "wikidata_id": "Q2617295", "wikidata_description": "South African astronomer (1794\u20131879)"}}, {"canonical_name": "Dalton", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "dalton", "book_id": "kosmos_humboldt_1845", "name": "Dalton", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Dalton"], "contexts": ["observer of southern lights in England", "views on atmospheric moisture measurement"]}, {"entity_id": "dalton", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Dalton", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Dalton"], "contexts": ["established law of definite proportion", "proposed atomic theory based on weight"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Dalton", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Dalton", "similarity": 1.0}], "id": 3276, "stable_key": "clu_e39ef57b840ca7b3", "ground_truth": {"modern_name": "John Dalton", "confidence": "high", "type": "person", "birth_year": 1766, "death_year": 1844, "description": "Chemist and physicist, father of atomic theory.", "wikidata_id": "Q41284", "wikidata_description": "British chemist and physicist (1766\u20131844)"}}, {"canonical_name": "Elba", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "elba", "book_id": "kosmos_humboldt_1845", "name": "Elba", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Elba"], "contexts": ["island location of Monte Serrato", "island where Monte Serrato is located"]}, {"entity_id": "elba", "book_id": "ricettario_fiorentino_1597", "name": "Elba", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Elba"], "contexts": ["island where white earth is found", "place associated with refined bolo"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Elba", "target_book": "ricettario_fiorentino_1597", "target_name": "Elba", "similarity": 1.0}], "id": 3277, "stable_key": "clu_bc4517064ded7c27", "ground_truth": {"modern_name": "Elba", "confidence": "high", "type": "place", "description": "Island in Italy and a river in Europe.", "note": "Contexts differentiate between the island and the river.", "wikipedia_extract": "Elba (Italian: isola d'Elba, pronounced [\u02c8i\u02d0zola \u02c8delba]; Latin: Ilva) is a Mediterranean island in Tuscany, Italy, 10 km (6.2 mi) from the coastal town of Piombino on the Italian mainland, and the largest island of the Tuscan Archipelago. It is also part of the Arcipelago Toscano National Park, and the third largest island in Italy, after Sicily and Sardinia. It is located in the Tyrrhenian Sea about 50 km (30 mi) east of the French island of Corsica. The island is part of the province of Livorno and is divided into seven municipalities, with a total population of about 30,000 inhabitants which increases considerably during the summer. The municipalities are Portoferraio (which is also the island's principal town), Campo nell'Elba, Capoliveri, Marciana, Marciana Marina, Porto Azzurro, and Rio. It is famous for being the site of Napoleon's first exile, from 1814 to 1815."}}, {"canonical_name": "volcanic", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "volcanic", "book_id": "kosmos_humboldt_1845", "name": "volcanic", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["volcanic"], "contexts": ["action by planet's interior on external crust", "classification of rocks based on origin"]}, {"entity_id": "volcanoes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "volcanoes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["volcanoes"], "contexts": ["vents from which lava erupts", "natural phenomena involving fire and eruption"]}, {"entity_id": "volcanic_eruption", "book_id": "connexion_physical_sciences_somerville_1858", "name": "volcanic eruption", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["volcanic eruption"], "contexts": ["sudden release of lava and ash"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "volcanic", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "volcanoes", "similarity": 0.965}, {"source_book": "kosmos_humboldt_1845", "source_name": "volcanic", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "volcanic eruption", "similarity": 0.947}], "id": 3278, "stable_key": "clu_e2f71fcebe11a80d", "ground_truth": {"modern_name": "Volcanic eruption", "confidence": "high", "type": "concept", "note": "The term 'volcanic' in early modern texts, especially when referring to physical phenomena like eruptions and vents, aligns with the modern concept of volcanic activity. While not a disease, it was often discussed in natural philosophy alongside geological processes that could have perceived impacts on the 'health' of the planet.", "wikidata_id": "Q7692360", "wikidata_description": "natural phenomenon where lava, hot gases or other substances are emitted suddenly from a geological feature", "wikipedia_url": "https://en.wikipedia.org/wiki/Volcanic%20eruption", "modern_term": "Volcanic eruptions", "wikipedia_extract": "A volcanic eruption occurs when material is expelled from a volcanic vent or fissure. Several types of volcanic eruptions have been distinguished by volcanologists. These are often named after famous volcanoes where that type of behavior has been observed. Some volcanoes may exhibit only one characteristic type of eruption during a period of activity, while others may display an entire sequence of types all in one eruptive series. There are three main types of volcanic eruptions. Magmatic eruptions involve the decompression of gas within magma that propels it forward."}}, {"canonical_name": "Melloni", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "melloni", "book_id": "kosmos_humboldt_1845", "name": "Melloni", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Melloni"], "contexts": ["scientist known for discoveries in heat radiation", "scientist mentioned with Faraday"]}, {"entity_id": "melloni", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Melloni", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Melloni"], "contexts": ["experimenter with heat radiation", "performed experiments on heat radiation"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Melloni", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Melloni", "similarity": 1.0}], "id": 3279, "stable_key": "clu_8e5a1f6843b2b5a0", "ground_truth": {"modern_name": "Macedonio Melloni", "confidence": "high", "type": "person", "birth_year": 1798, "death_year": 1854, "description": "Italian physicist, researched heat radiation and thermopile."}}, {"canonical_name": "planetary system", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "planetary_system", "book_id": "kosmos_humboldt_1845", "name": "planetary system", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["planetary system"], "contexts": ["system of planets orbiting a star", "celestial bodies orbiting a star"]}, {"entity_id": "stellar_systems", "book_id": "connexion_physical_sciences_somerville_1858", "name": "stellar systems", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["stellar systems"], "contexts": ["subject to gravitation", "groups of stars"]}, {"entity_id": "stellar_system", "book_id": "connexion_physical_sciences_somerville_1858", "name": "stellar system", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["stellar system"], "contexts": ["system of stars"]}, {"entity_id": "planetary_systems", "book_id": "connexion_physical_sciences_somerville_1858", "name": "planetary systems", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["planetary systems"], "contexts": ["systems of planets around stars"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "planetary system", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ste